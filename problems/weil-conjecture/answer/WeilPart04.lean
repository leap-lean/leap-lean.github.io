        rw [← map_mul, ← map_sub, hgen_zero, map_zero]
      let pi_r : Mbar₀ →+* R_r := Ideal.Quotient.lift Ibar_a pi_hat hpi_hat_ker
      refine ⟨pi_r, ?_, ?_⟩
      · apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro v
          change pi_hat (MvPolynomial.map κ_Q (MvPolynomial.C v)) = κ_r (c₀ v)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact hικ v
        · intro i
          change pi_hat (MvPolynomial.map κ_Q (MvPolynomial.X i)) =
            κ_r (Ideal.Quotient.mk I_a (MvPolynomial.X i))
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · apply RingHom.ext
        intro z
        change pi_hat (MvPolynomial.C z) = ι_r z
        exact MvPolynomial.eval₂Hom_C ι_r _ z
    · intro f
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
      have hClearMv : ∃ s : ↥V, s ∉ Q.asIdeal ∧
          ∃ G : MvPolynomial (Fin 2) ↥V,
            MvPolynomial.C (κ_Q s) * F = MvPolynomial.map κ_Q G := by
        induction F using MvPolynomial.induction_on with
        | C z =>
          obtain ⟨u, s, hs, hus⟩ := hClearConst z
          refine ⟨s, hs, MvPolynomial.C u, ?_⟩
          rw [← MvPolynomial.C_mul, hus, MvPolynomial.map_C]
        | add p q ihp ihq =>
          obtain ⟨s₁, hs₁, G₁, h₁⟩ := ihp
          obtain ⟨s₂, hs₂, G₂, h₂⟩ := ihq
          refine ⟨s₁ * s₂, Q.asIdeal.primeCompl.mul_mem hs₁ hs₂,
            MvPolynomial.C s₂ * G₁ + MvPolynomial.C s₁ * G₂, ?_⟩
          rw [map_mul, MvPolynomial.C_mul, map_add, map_mul, map_mul,
            MvPolynomial.map_C, MvPolynomial.map_C, ← h₁, ← h₂]
          ring
        | mul_X p i ihp =>
          obtain ⟨s, hs, G, hG⟩ := ihp
          refine ⟨s, hs, G * MvPolynomial.X i, ?_⟩
          rw [← mul_assoc, hG, map_mul, MvPolynomial.map_X]
      obtain ⟨s, hs, G, hG⟩ := hClearMv
      refine ⟨s, hs, Ideal.Quotient.mk I_a G, ?_⟩
      change Ideal.Quotient.mk Ibar_a (MvPolynomial.C (κ_Q s)) * Ideal.Quotient.mk Ibar_a F =
        Ideal.Quotient.mk Ibar_a (MvPolynomial.map κ_Q G)
      rw [← map_mul, hG]
  
  have hPart1 : ∀ q : PrimeSpectrum F_Q,
      q.asIdeal ∈ minimalPrimes F_Q ∨ q.asIdeal.IsMaximal := by
    intro q
    by_contra hNot
    obtain ⟨hNotMin, hNotMax⟩ := not_or.mp hNot
    obtain ⟨I₀, hI₀_min, hI₀_le⟩ :=
      @Ideal.exists_minimalPrimes_le F_Q _ ⊥ q.asIdeal q.isPrime bot_le
    let q₀ : PrimeSpectrum F_Q := ⟨I₀, hI₀_min.1.1⟩
    have hq₀₁ : q₀ < q := lt_of_le_of_ne hI₀_le (fun h => hNotMin (h ▸ hI₀_min))
    obtain ⟨M₂, hM₂_max, hq_le⟩ := Ideal.exists_le_maximal q.asIdeal q.isPrime.ne_top
    let q₂ : PrimeSpectrum F_Q := ⟨M₂, hM₂_max.isPrime⟩
    have hq₁₂ : q < q₂ := lt_of_le_of_ne hq_le (fun h => hNotMax (h ▸ hM₂_max))
    let e := PrimeSpectrum.preimageOrderIsoFiber ↥V B Q
    let x₀ := e.symm q₀
    let x₁ := e.symm q
    let x₂ := e.symm q₂
    have hx₀₁ : x₀.1 < x₁.1 := e.symm.strictMono hq₀₁
    have hx₁₂ : x₁.1 < x₂.1 := e.symm.strictMono hq₁₂
    obtain ⟨b, hb₂, ⟨ψ, hEt, hψ_comp⟩ | ⟨a, ψ, _ha, hEt, hψ_comp⟩⟩ := hCharts x₂.1
    · obtain ⟨r₀, r₁, r₂, hr₀₁, hr₁₂, hr₀, hr₁, hr₂⟩ :=
        hContractChain Polynomial.C b ψ hEt hψ_comp x₀.1 x₁.1 x₂.1 hx₀₁ hx₁₂ x₀.2 x₁.2 x₂.2 hb₂
      exact hNoChainSmooth r₀ r₁ r₂ hr₀₁ hr₁₂ hr₀ hr₁ hr₂
    · obtain ⟨r₀, r₁, r₂, hr₀₁, hr₁₂, hr₀, hr₁, hr₂⟩ :=
        hContractChain ((Ideal.Quotient.mk _).comp MvPolynomial.C) b ψ hEt hψ_comp
          x₀.1 x₁.1 x₂.1 hx₀₁ hx₁₂ x₀.2 x₁.2 x₂.2 hb₂
      exact hNoChainNodal a r₀ r₁ r₂ hr₀₁ hr₁₂ hr₀ hr₁ hr₂
  
  have hPart2 : ∀ Z : Set (PrimeSpectrum F_Q),
      IsClosed Z → (∀ q ∈ Z, q.asIdeal ∉ minimalPrimes F_Q) → Z.Finite := by
    have _ : IsNoetherianRing F_Q := Algebra.FiniteType.isNoetherianRing k_Q F_Q
    intro Z hZ_cl hZ_notMin
    let I : Ideal F_Q := PrimeSpectrum.vanishingIdeal Z
    have hZ_eq : PrimeSpectrum.zeroLocus (I : Set F_Q) = Z :=
      (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure Z).trans hZ_cl.closure_eq
    have hSub : PrimeSpectrum.asIdeal '' Z ⊆ I.minimalPrimes := by
      rintro _ ⟨q, hqZ, rfl⟩
      have hIq : I ≤ q.asIdeal :=
        (PrimeSpectrum.mem_zeroLocus q (I : Set F_Q)).mp (hZ_eq.symm ▸ hqZ)
      refine ⟨⟨q.isPrime, hIq⟩, ?_⟩
      rintro J ⟨hJ_prime, hIJ⟩ hle
      let q' : PrimeSpectrum F_Q := ⟨J, hJ_prime⟩
      have hq'Z : q' ∈ Z := hZ_eq ▸ (PrimeSpectrum.mem_zeroLocus q' (I : Set F_Q)).mpr hIJ
      have hq'_max : J.IsMaximal := (hPart1 q').resolve_left (hZ_notMin q' hq'Z)
      exact (hq'_max.eq_of_le q.isPrime.ne_top hle).ge
    exact Set.Finite.of_finite_image
      ((Ideal.finite_minimalPrimes_of_isNoetherianRing F_Q I).subset hSub)
      (fun q₁ _ q₂ _ h => PrimeSpectrum.ext h)
  
  have hPart3 : ∀ (p : PrimeSpectrum B) (hp : PrimeSpectrum.comap (algebraMap ↥V B) p = Q),
      (PrimeSpectrum.preimageHomeomorphFiber ↥V B Q ⟨p, hp⟩).asIdeal ∉ minimalPrimes F_Q →
      ∀ x : p.asIdeal.ResidueField,
        @IsAlgebraic k_Q p.asIdeal.ResidueField _ _
          (Ideal.ResidueField.map Q.asIdeal p.asIdeal (algebraMap ↥V B)
            (congrArg PrimeSpectrum.asIdeal hp.symm)).toAlgebra x := by
    intro p hp hNotMin x
    let k_p := p.asIdeal.ResidueField
    let q := PrimeSpectrum.preimageHomeomorphFiber ↥V B Q ⟨p, hp⟩
    let φ_Qp : k_Q →+* k_p :=
      Ideal.ResidueField.map Q.asIdeal p.asIdeal (algebraMap ↥V B)
        (congrArg PrimeSpectrum.asIdeal hp.symm)
    have hq_max : q.asIdeal.IsMaximal := (hPart1 q).resolve_left hNotMin
    let incR : B →+* F_Q := (Algebra.TensorProduct.includeRight : B →ₐ[↥V] F_Q).toRingHom
    have hpq : p.asIdeal = Ideal.comap incR q.asIdeal := by
      apply SetLike.coe_injective
      have hsymm : (PrimeSpectrum.preimageHomeomorphFiber ↥V B Q).symm q = ⟨p, hp⟩ :=
        (PrimeSpectrum.preimageHomeomorphFiber ↥V B Q).symm_apply_apply ⟨p, hp⟩
      have hcoe := PrimeSpectrum.coe_preimageHomeomorphFiber_symm_apply_coe_asIdeal ↥V B Q q
      rw [hsymm] at hcoe
      exact hcoe
    have hSurjStalks : incR.SurjectiveOnStalks :=
      RingHom.SurjectiveOnStalks.baseChange' (Ideal.surjectiveOnStalks_residueField Q.asIdeal)
    have hBij : Function.Bijective (Ideal.ResidueField.map p.asIdeal q.asIdeal incR hpq) :=
      hSurjStalks.residueFieldMap_bijective p.asIdeal q.asIdeal hpq
    let e_kp : k_p ≃+* q.asIdeal.ResidueField :=
      RingEquiv.ofBijective (Ideal.ResidueField.map p.asIdeal q.asIdeal incR hpq) hBij
    let σ : F_Q →+* k_p := e_kp.symm.toRingHom.comp (algebraMap F_Q q.asIdeal.ResidueField)
    have hσ_surj : Function.Surjective σ :=
      e_kp.symm.surjective.comp (Ideal.algebraMap_residueField_surjective q.asIdeal)
    have hσ_comp : σ.comp (algebraMap k_Q F_Q) = φ_Qp := by
      have hEqFwd : (algebraMap F_Q q.asIdeal.ResidueField).comp (algebraMap k_Q F_Q) =
          (Ideal.ResidueField.map p.asIdeal q.asIdeal incR hpq).comp φ_Qp := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors (↥V ⧸ Q.asIdeal))
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro v
        change algebraMap F_Q q.asIdeal.ResidueField
            (algebraMap k_Q F_Q (algebraMap (↥V ⧸ Q.asIdeal) k_Q (algebraMap ↥V (↥V ⧸ Q.asIdeal) v))) =
          Ideal.ResidueField.map p.asIdeal q.asIdeal incR hpq
            (φ_Qp (algebraMap (↥V ⧸ Q.asIdeal) k_Q (algebraMap ↥V (↥V ⧸ Q.asIdeal) v)))
        rw [← IsScalarTower.algebraMap_apply ↥V (↥V ⧸ Q.asIdeal) k_Q v]
        have hφv : φ_Qp (algebraMap ↥V k_Q v) = algebraMap B k_p (algebraMap ↥V B v) :=
          Ideal.ResidueField.map_algebraMap Q.asIdeal p.asIdeal (algebraMap ↥V B) _ v
        rw [hφv]
        have hincv : Ideal.ResidueField.map p.asIdeal q.asIdeal incR hpq
            (algebraMap B k_p (algebraMap ↥V B v)) =
            algebraMap F_Q q.asIdeal.ResidueField (incR (algebraMap ↥V B v)) :=
          Ideal.ResidueField.map_algebraMap p.asIdeal q.asIdeal incR hpq (algebraMap ↥V B v)
        rw [hincv]
        have hcomm : incR (algebraMap ↥V B v) = algebraMap ↥V F_Q v :=
          (Algebra.TensorProduct.includeRight : B →ₐ[↥V] F_Q).commutes v
        rw [hcomm, IsScalarTower.algebraMap_apply ↥V k_Q F_Q v]
      apply RingHom.ext
      intro z
      apply e_kp.injective
      change e_kp (e_kp.symm (algebraMap F_Q q.asIdeal.ResidueField (algebraMap k_Q F_Q z))) =
        Ideal.ResidueField.map p.asIdeal q.asIdeal incR hpq (φ_Qp z)
      rw [e_kp.apply_symm_apply]
      exact congrArg (fun g => g z) hEqFwd
    have hFT_F : (algebraMap k_Q F_Q).FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
    have hFT_σ : σ.FiniteType := RingHom.FiniteType.of_surjective σ hσ_surj
    have hFT_φ : φ_Qp.FiniteType := by
      rw [← hσ_comp]
      exact hFT_σ.comp hFT_F
    have hFin_φ : φ_Qp.Finite := RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hFT_φ
    let _ : Algebra k_Q k_p := φ_Qp.toAlgebra
    have _ : Module.Finite k_Q k_p := hFin_φ
    exact IsAlgebraic.of_finite k_Q x
  exact ⟨hPart1, hPart2, hPart3⟩

theorem weil_semistable_algebra_minimal_fiber_generalization_transcendental (K : Type u) [Field K] (V : ValuationSubring K)
    (A : Type u) [CommRing A] [Algebra ↥V A] [Algebra.FiniteType ↥V A]
    (Q : PrimeSpectrum ↥V) (p_x : PrimeSpectrum A)
    (hx : PrimeSpectrum.comap (algebraMap ↥V A) p_x = Q)
    (hMin : (PrimeSpectrum.preimageHomeomorphFiber ↥V A Q ⟨p_x, hx⟩).asIdeal ∈
      minimalPrimes (Q.asIdeal.Fiber A))
    (hCharts : ∀ p : PrimeSpectrum A, ∃ b : A, b ∉ p.asIdeal ∧
      ((∃ ψ : Polynomial ↥V →+* Localization.Away b,
          ψ.Etale ∧ ψ.comp Polynomial.C = (algebraMap A (Localization.Away b)).comp (algebraMap ↥V A)) ∨
       (∃ (a : ↥V) (ψ : (MvPolynomial (Fin 2) ↥V ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* Localization.Away b),
          a ≠ 0 ∧ ψ.Etale ∧
          ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            (algebraMap A (Localization.Away b)).comp (algebraMap ↥V A))))
    (p_y : PrimeSpectrum A) (hyx : p_y ≤ p_x) :
    let Q' : PrimeSpectrum ↥V := PrimeSpectrum.comap (algebraMap ↥V A) p_y
    ∃ t_y : p_y.asIdeal.ResidueField,
      @Transcendental Q'.asIdeal.ResidueField p_y.asIdeal.ResidueField _ _
        (Ideal.ResidueField.map Q'.asIdeal p_y.asIdeal (algebraMap ↥V A) rfl).toAlgebra t_y :=
by
  classical
  
  have hMinA : ∀ p' : PrimeSpectrum A,
      PrimeSpectrum.comap (algebraMap ↥V A) p' = Q → p' ≤ p_x → p' = p_x := by
    intro p' hp' hle
    let e := PrimeSpectrum.preimageOrderIsoFiber ↥V A Q
    have hMin' : Minimal (fun J : Ideal (Q.asIdeal.Fiber A) => J.IsPrime ∧ ⊥ ≤ J)
        (e ⟨p_x, hx⟩).asIdeal := hMin
    have hsub_le : (⟨p', hp'⟩ : PrimeSpectrum.comap (algebraMap ↥V A) ⁻¹' {Q}) ≤ ⟨p_x, hx⟩ := hle
    have he_le : e ⟨p', hp'⟩ ≤ e ⟨p_x, hx⟩ := e.monotone hsub_le
    have he_ge : e ⟨p_x, hx⟩ ≤ e ⟨p', hp'⟩ :=
      hMin'.2 ⟨(e ⟨p', hp'⟩).isPrime, bot_le⟩ he_le
    have hsub_eq : (⟨p', hp'⟩ : PrimeSpectrum.comap (algebraMap ↥V A) ⁻¹' {Q}) = ⟨p_x, hx⟩ :=
      e.injective (le_antisymm he_le he_ge)
    exact congrArg Subtype.val hsub_eq
  
  have hEtaleMin : ∀ (b : A) (_ : b ∉ p_x.asIdeal) (M₀ : Type u) [CommRing M₀]
      (c₀ : ↥V →+* M₀) (ψ : M₀ →+* Localization.Away b),
      ψ.Etale →
      ψ.comp c₀ = (algebraMap A (Localization.Away b)).comp (algebraMap ↥V A) →
      ∃ (ρ_x : Localization.Away b →+* p_x.asIdeal.ResidueField)
        (r_x : PrimeSpectrum M₀),
        ρ_x.comp (algebraMap A (Localization.Away b)) = algebraMap A p_x.asIdeal.ResidueField ∧
        (∀ m : M₀, m ∈ r_x.asIdeal ↔ ρ_x (ψ m) = 0) ∧
        PrimeSpectrum.comap c₀ r_x = Q ∧
        ∀ r' : PrimeSpectrum M₀, PrimeSpectrum.comap c₀ r' = Q → r' ≤ r_x → r' = r_x := by
    intro b hb M₀ _ c₀ ψ hEt hψ_comp
    have _ : p_x.asIdeal.IsPrime := p_x.isPrime
    have hb_ne : algebraMap A p_x.asIdeal.ResidueField b ≠ 0 := by
      intro h0
      apply hb
      rw [← Ideal.ker_algebraMap_residueField p_x.asIdeal, RingHom.mem_ker]
      exact h0
    have hu_x : IsUnit (algebraMap A p_x.asIdeal.ResidueField b) := Ne.isUnit hb_ne
    have hρ_ex : ∃ ρ_x : Localization.Away b →+* p_x.asIdeal.ResidueField,
        ρ_x.comp (algebraMap A (Localization.Away b)) = algebraMap A p_x.asIdeal.ResidueField := by
      refine ⟨IsLocalization.Away.lift (S := Localization.Away b) b hu_x, ?_⟩
      ext a₀
      simp only [RingHom.comp_apply]
      exact IsLocalization.Away.lift_eq (S := Localization.Away b) b
        (g := algebraMap A p_x.asIdeal.ResidueField) hu_x a₀
    obtain ⟨ρ_x, hρ_x_eq⟩ := hρ_ex
    let ptil_x : PrimeSpectrum (Localization.Away b) :=
      ⟨RingHom.ker ρ_x, RingHom.ker_isPrime ρ_x⟩
    let r_x : PrimeSpectrum M₀ := PrimeSpectrum.comap ψ ptil_x
    have hptil_comap : PrimeSpectrum.comap (algebraMap A (Localization.Away b)) ptil_x = p_x := by
      apply PrimeSpectrum.ext
      ext a₀
      change ρ_x (algebraMap A (Localization.Away b) a₀) = 0 ↔ a₀ ∈ p_x.asIdeal
      have h_eq : ρ_x (algebraMap A (Localization.Away b) a₀) =
          algebraMap A p_x.asIdeal.ResidueField a₀ :=
        RingHom.congr_fun hρ_x_eq a₀
      rw [h_eq, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    have hr_x_Q : PrimeSpectrum.comap c₀ r_x = Q := by
      apply PrimeSpectrum.ext
      ext v
      have hv1 : ψ (c₀ v) = algebraMap A (Localization.Away b) (algebraMap ↥V A v) :=
        RingHom.congr_fun hψ_comp v
      have hv2 : algebraMap A (Localization.Away b) (algebraMap ↥V A v) ∈ ptil_x.asIdeal ↔
          algebraMap ↥V A v ∈ p_x.asIdeal := by
        rw [← hptil_comap]; rfl
      have hv3 : algebraMap ↥V A v ∈ p_x.asIdeal ↔ v ∈ Q.asIdeal := by
        rw [← hx]; rfl
      change ψ (c₀ v) ∈ ptil_x.asIdeal ↔ v ∈ Q.asIdeal
      rw [hv1, hv2, hv3]
    refine ⟨ρ_x, r_x, hρ_x_eq, fun _ => Iff.rfl, hr_x_Q, ?_⟩
    intro r' hr'_Q hr'_le
    by_contra hr'_ne
    have hr'_lt : r'.asIdeal < r_x.asIdeal :=
      lt_of_le_of_ne hr'_le (fun h => hr'_ne (PrimeSpectrum.ext h))
    let _ : Algebra M₀ (Localization.Away b) := ψ.toAlgebra
    have _ : Algebra.Smooth M₀ (Localization.Away b) :=
      ((RingHom.etale_iff_formallyUnramified_and_smooth ψ).mp hEt).2
    have _ : Module.Flat M₀ (Localization.Away b) := Algebra.Smooth.flat M₀ (Localization.Away b)
    have _ : Algebra.HasGoingDown M₀ (Localization.Away b) := Algebra.HasGoingDown.of_flat
    have _ : r'.asIdeal.IsPrime := r'.isPrime
    have _ : ptil_x.asIdeal.IsPrime := ptil_x.isPrime
    have hr'_lt' : r'.asIdeal < Ideal.under M₀ ptil_x.asIdeal := hr'_lt
    obtain ⟨P', hP'_le, hP'_prime, hP'_over⟩ :=
      Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt ptil_x.asIdeal hr'_lt'
    let ptil' : PrimeSpectrum (Localization.Away b) := ⟨P', hP'_prime⟩
    have hr'_eq : PrimeSpectrum.comap ψ ptil' = r' :=
      PrimeSpectrum.ext hP'_over.over.symm
    let p' : PrimeSpectrum A := PrimeSpectrum.comap (algebraMap A (Localization.Away b)) ptil'
    have hp'_Q : PrimeSpectrum.comap (algebraMap ↥V A) p' = Q := by
      apply PrimeSpectrum.ext
      ext v
      have hv1 : algebraMap A (Localization.Away b) (algebraMap ↥V A v) = ψ (c₀ v) :=
        (RingHom.congr_fun hψ_comp v).symm
      have hv2 : ψ (c₀ v) ∈ P' ↔ c₀ v ∈ r'.asIdeal := by
        rw [← hr'_eq]; rfl
      have hv3 : c₀ v ∈ r'.asIdeal ↔ v ∈ Q.asIdeal := by
        rw [← hr'_Q]; rfl
      change algebraMap A (Localization.Away b) (algebraMap ↥V A v) ∈ P' ↔ v ∈ Q.asIdeal
      rw [hv1, hv2, hv3]
    have hp'_le : p' ≤ p_x := by
      rw [← hptil_comap]
      intro a₀ ha₀
      exact hP'_le ha₀
    have hp'_eq : p' = p_x := hMinA p' hp'_Q hp'_le
    have hptil_x_le : ptil_x.asIdeal ≤ P' := by
      intro z hz
      have hz0 : ρ_x z = 0 := hz
      obtain ⟨k, a_z, hza⟩ := IsLocalization.Away.surj (S := Localization.Away b) b z
      have ha_z0 : algebraMap A p_x.asIdeal.ResidueField a_z = 0 := by
        calc
          algebraMap A p_x.asIdeal.ResidueField a_z
              = ρ_x (algebraMap A (Localization.Away b) a_z) :=
                (RingHom.congr_fun hρ_x_eq a_z).symm
          _ = ρ_x (z * algebraMap A (Localization.Away b) b ^ k) := by rw [hza]
          _ = ρ_x z * ρ_x (algebraMap A (Localization.Away b) b) ^ k := by rw [map_mul, map_pow]
          _ = 0 := by rw [hz0, zero_mul]
      have ha_z_px : a_z ∈ p_x.asIdeal := by
        rwa [← Ideal.ker_algebraMap_residueField p_x.asIdeal, RingHom.mem_ker]
      have ha_z_p' : a_z ∈ p'.asIdeal := by rwa [hp'_eq]
      have hzk_mem : z * algebraMap A (Localization.Away b) b ^ k ∈ P' := by
        rw [hza]
        exact ha_z_p'
      have hu_bk : IsUnit (algebraMap A (Localization.Away b) b ^ k) :=
        (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away b) b).pow k
      obtain ⟨u, hu⟩ := hu_bk
      have hzu : z * (u : Localization.Away b) ∈ P' := by rw [hu]; exact hzk_mem
      have hz_mem : (z * (u : Localization.Away b)) * (↑u⁻¹ : Localization.Away b) ∈ P' :=
        P'.mul_mem_right _ hzu
      rwa [mul_assoc, Units.mul_inv, mul_one] at hz_mem
    have hP'_eq : P' = ptil_x.asIdeal := le_antisymm hP'_le hptil_x_le
    have hr'_ideal_eq : r'.asIdeal = r_x.asIdeal := by
      calc
        r'.asIdeal = Ideal.under M₀ P' := hP'_over.over
        _ = Ideal.under M₀ ptil_x.asIdeal := by rw [hP'_eq]
        _ = r_x.asIdeal := rfl
    exact ne_of_lt hr'_lt hr'_ideal_eq
  
  have hPolyChart : ∃ (b : A) (_ : b ∉ p_x.asIdeal)
      (ρ_x : Localization.Away b →+* p_x.asIdeal.ResidueField)
      (φ : Polynomial ↥V →+* Localization.Away b),
      ρ_x.comp (algebraMap A (Localization.Away b)) = algebraMap A p_x.asIdeal.ResidueField ∧
      φ.comp Polynomial.C = (algebraMap A (Localization.Away b)).comp (algebraMap ↥V A) ∧
      (∀ P : Polynomial ↥V, ρ_x (φ P) = 0 → ∀ n : ℕ, P.coeff n ∈ Q.asIdeal) := by
    obtain ⟨b, hb, hSm | hNod⟩ := hCharts p_x
    · 
      obtain ⟨ψ, hEt, hψ_comp⟩ := hSm
      obtain ⟨ρ_x, r_x, hρ_x_eq, hr_x_mem, hr_x_Q, hMinM⟩ :=
        hEtaleMin b hb (Polynomial ↥V) Polynomial.C ψ hEt hψ_comp
      have _ : Q.asIdeal.IsPrime := Q.isPrime
      have _ : IsDomain (↥V ⧸ Q.asIdeal) := Ideal.Quotient.isDomain Q.asIdeal
      let pi_Q : Polynomial ↥V →+* Polynomial (↥V ⧸ Q.asIdeal) :=
        Polynomial.mapRingHom (Ideal.Quotient.mk Q.asIdeal)
      let r₀ : PrimeSpectrum (Polynomial ↥V) := ⟨RingHom.ker pi_Q, RingHom.ker_isPrime pi_Q⟩
      have hr₀_Q : PrimeSpectrum.comap Polynomial.C r₀ = Q := by
        apply PrimeSpectrum.ext
        ext v
        change Polynomial.map (Ideal.Quotient.mk Q.asIdeal) (Polynomial.C v) = 0 ↔ v ∈ Q.asIdeal
        rw [Polynomial.map_C, Polynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem]
      have hr₀_le : r₀ ≤ r_x := by
        intro P hP
        have hP0 : Polynomial.map (Ideal.Quotient.mk Q.asIdeal) P = 0 := hP
        have hcoeff_mem : ∀ i : ℕ, Polynomial.C (P.coeff i) ∈ r_x.asIdeal := by
          intro i
