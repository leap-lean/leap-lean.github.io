  have hq_comp : q_R.comp ι_VP = algebraMap ↥V κ_P :=
    IsLocalization.lift_comp h_units
  have hq_surj : Function.Surjective q_R := by
    intro z
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective (R := Localization.AtPrime P.asIdeal) z
    obtain ⟨⟨a, s⟩, hws⟩ := IsLocalization.surj P.asIdeal.primeCompl w
    refine ⟨IsLocalization.mk' R_P a s, ?_⟩
    have hs_ne : algebraMap ↥V κ_P s.1 ≠ 0 := (h_units s).ne_zero
    apply mul_right_cancel₀ hs_ne
    have h1 : q_R (IsLocalization.mk' R_P a s) * algebraMap ↥V κ_P s.1 = algebraMap ↥V κ_P a := by
      have hmk : IsLocalization.mk' R_P a s * algebraMap ↥V R_P s.1 = algebraMap ↥V R_P a :=
