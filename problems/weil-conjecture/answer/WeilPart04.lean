      have hBij_ψK : Function.Bijective ψ_K :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      intro w
      obtain ⟨z, hz⟩ := hBij_ψK.2 (Ideal.Quotient.mk (⊥ : Ideal D_y) w)
      refine ⟨z, ?_⟩
      have hsub_zero : Ideal.Quotient.mk (⊥ : Ideal D_y) (φ_K z - w) = 0 := by
        rw [map_sub, sub_eq_zero]
        exact hz
      exact sub_eq_zero.mp (Ideal.mem_bot.mp (Ideal.Quotient.eq_zero_iff_mem.mp hsub_zero))
    refine hTransfer q_y hq_y_le ?_
    intro t ht
    obtain ⟨z, hz⟩ := hSurj_φK (ψ_BD (ψ₁ t))
    obtain ⟨c_bar, s_bar, hs_nzd, hdiv⟩ :=
      IsFractionRing.div_surjective (A := ↥V_P ⧸ P₀) z
