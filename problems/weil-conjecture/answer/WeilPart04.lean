      haveI : (⊥ : Ideal D_y).IsMaximal := hMaxBot
      let K_D : Type u := D_y ⧸ (⊥ : Ideal D_y)
      letI : Field K_D := Ideal.Quotient.field (⊥ : Ideal D_y)
      let ψ_K : P₀.ResidueField →+* K_D := (Ideal.Quotient.mk (⊥ : Ideal D_y)).comp φ_K
      have hFT_ψK : ψ_K.FiniteType :=
        (RingHom.FiniteType.of_surjective (Ideal.Quotient.mk (⊥ : Ideal D_y))
          Ideal.Quotient.mk_surjective).comp hFT_φ
      letI : Algebra P₀.ResidueField K_D := ψ_K.toAlgebra
      haveI : Algebra.FiniteType P₀.ResidueField K_D := hFT_ψK
      haveI : Module.Finite P₀.ResidueField K_D :=
        finite_of_finite_type_of_isJacobsonRing P₀.ResidueField K_D
      haveI : Algebra.IsIntegral P₀.ResidueField K_D :=
