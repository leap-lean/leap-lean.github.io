        have hf_ne : f ≠ 0 := fun hf0 => hp₀_f (hf0 ▸ p₀.asIdeal.zero_mem)
        obtain ⟨c, hc_not⟩ := Infinite.exists_notMem_finset f.roots.toFinset
        have hfc_ne : Polynomial.eval c f ≠ 0 := by
          intro hfc0
          apply hc_not
