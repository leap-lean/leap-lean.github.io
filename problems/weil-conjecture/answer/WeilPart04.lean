    obtain ⟨φ_U, hFrac_U, hφ_U⟩ := hFunc_Pk0 U hU hUne
    letI : Algebra R_U K_Z := φ_U.hom.toAlgebra
    haveI : IsFractionRing R_U K_Z := hFrac_U
    rw [isIntegrallyClosed_iff K_Z]
    intro x hx
    obtain ⟨P_int, hP_monic, hP_eval⟩ := hx
    let J : Ideal R_U :=
      { carrier := {s : R_U | ∃ r : R_U, φ_U.hom s * x = φ_U.hom r}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := fun ⟨r₁, hr₁⟩ ⟨r₂, hr₂⟩ =>
          ⟨r₁ + r₂, by rw [map_add, add_mul, hr₁, hr₂, map_add]⟩
        smul_mem' := fun c _ ⟨r, hr⟩ =>
          ⟨c * r, by
            change φ_U.hom (c * _) * x = φ_U.hom (c * r)
            rw [map_mul, mul_assoc, hr, map_mul]⟩ }
    have hJ_top : J = ⊤ := by
      by_contra hJ_ne
      obtain ⟨p, hp_max, hJp⟩ := Ideal.exists_le_maximal J hJ_ne
      haveI : p.IsPrime := hp_max.isPrime
      let z₀ : AlgebraicGeometry.Spec (P_k0.presheaf.obj (Opposite.op U)) := ⟨p, hp_max.isPrime⟩
      let y : ↥P_k0 := hU.fromSpec.base z₀
      have hy_U : y ∈ U := by
        change y ∈ (U : Set ↥P_k0)
        rw [← hU.range_fromSpec]
        exact ⟨z₀, rfl⟩
      obtain ⟨a, hy_Da⟩ := hMemChart y
      let D_a := weilProjBasicOpen k₀ 1 a
      let Γ_a := ↑(P_k0.presheaf.obj (Opposite.op D_a))
      haveI : IsDomain Γ_a := hDom_chart a
      haveI hIC_Γa : IsIntegrallyClosed Γ_a := IsIntegrallyClosed.of_equiv (e_k0 a)
      obtain ⟨g, hg_le, hy_Wg⟩ :=
        @AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le P_k0 D_a (hAff k₀ 1 a) U
          ⟨y, hy_U⟩ hy_Da
      have hg_ne : g ≠ 0 := by
        intro hg0
        rw [hg0, AlgebraicGeometry.Scheme.basicOpen_zero] at hy_Wg
        exact hy_Wg
      let W_g : P_k0.Opens := P_k0.basicOpen g
      have hWg : AlgebraicGeometry.IsAffineOpen W_g := (hAff k₀ 1 a).basicOpen g
      have hWg_ne : Nonempty ↥W_g := ⟨⟨y, hy_Wg⟩⟩
      let B_g := ↑(P_k0.presheaf.obj (Opposite.op W_g))
      haveI : IsDomain B_g :=
        @AlgebraicGeometry.IsIntegral.component_integral P_k0 hInt_Pk0 W_g hWg_ne
      haveI hLoc_Bg : IsLocalization.Away g B_g := (hAff k₀ 1 a).isLocalization_basicOpen g
      have hpow_g : Submonoid.powers g ≤ nonZeroDivisors Γ_a :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg_ne)
      have hIC_Bg : IsIntegrallyClosed B_g :=
        isIntegrallyClosed_of_isLocalization (M := Submonoid.powers g) (S := B_g) hpow_g
      obtain ⟨φ_Wg, hFrac_Wg, hφ_Wg⟩ := hFunc_Pk0 W_g hWg hWg_ne
      let res_Ug : R_U →+* B_g :=
        (P_k0.presheaf.map (CategoryTheory.homOfLE hg_le).op).hom
      have hcomp_Ug : φ_Wg.hom.comp res_Ug = φ_U.hom := by
        have hSpec_eq :
            AlgebraicGeometry.Spec.map (P_k0.presheaf.map (CategoryTheory.homOfLE hg_le).op ≫ φ_Wg) ≫
              hU.fromSpec =
            AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hU.map_fromSpec hWg (CategoryTheory.homOfLE hg_le).op, hφ_Wg, hφ_U]
        have hMap_eq := (CategoryTheory.cancel_mono hU.fromSpec).mp hSpec_eq
        exact congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective hMap_eq)
      letI : Algebra B_g K_Z := φ_Wg.hom.toAlgebra
      haveI : IsFractionRing B_g K_Z := hFrac_Wg
      have hx_Bg : _root_.IsIntegral B_g x := by
        refine ⟨P_int.map res_Ug, hP_monic.map res_Ug, ?_⟩
        change Polynomial.eval₂ φ_Wg.hom x (P_int.map res_Ug) = 0
        rw [Polynomial.eval₂_map, hcomp_Ug]
        exact hP_eval
      obtain ⟨w_g, hw_g⟩ := (isIntegrallyClosed_iff K_Z).mp hIC_Bg hx_Bg
      change φ_Wg.hom w_g = x at hw_g
      obtain ⟨f, hf_le, hy_Wf⟩ :=
        @AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le P_k0 U hU W_g
          ⟨y, hy_Wg⟩ hy_U
      have hf_not_p : f ∉ p := by
        have hz_pre : z₀ ∈ hU.fromSpec ⁻¹ᵁ P_k0.basicOpen f := hy_Wf
        rw [hU.fromSpec_preimage_basicOpen f] at hz_pre
        exact hz_pre
      let W_f : P_k0.Opens := P_k0.basicOpen f
      have hWf : AlgebraicGeometry.IsAffineOpen W_f := hU.basicOpen f
      have hWf_ne : Nonempty ↥W_f := ⟨⟨y, hy_Wf⟩⟩
      let B_f := ↑(P_k0.presheaf.obj (Opposite.op W_f))
      obtain ⟨φ_Wf, _, hφ_Wf⟩ := hFunc_Pk0 W_f hWf hWf_ne
      let res_gf : B_g →+* B_f :=
        (P_k0.presheaf.map (CategoryTheory.homOfLE hf_le).op).hom
      let res_Uf : R_U →+* B_f :=
        (P_k0.presheaf.map (CategoryTheory.homOfLE (P_k0.basicOpen_le f)).op).hom
      have hcomp_gf : ∀ c : B_g, φ_Wf.hom (res_gf c) = φ_Wg.hom c := by
        have hSpec_eq :
            AlgebraicGeometry.Spec.map (P_k0.presheaf.map (CategoryTheory.homOfLE hf_le).op ≫ φ_Wf) ≫
              hWg.fromSpec =
            AlgebraicGeometry.Spec.map φ_Wg ≫ hWg.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hWg.map_fromSpec hWf (CategoryTheory.homOfLE hf_le).op, hφ_Wf, hφ_Wg]
        have hMap_eq := (CategoryTheory.cancel_mono hWg.fromSpec).mp hSpec_eq
        have hHom_eq := congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective hMap_eq)
        intro c
        exact RingHom.congr_fun hHom_eq c
      have hcomp_Uf : ∀ c : R_U, φ_Wf.hom (res_Uf c) = φ_U.hom c := by
        have hSpec_eq :
            AlgebraicGeometry.Spec.map
              (P_k0.presheaf.map (CategoryTheory.homOfLE (P_k0.basicOpen_le f)).op ≫ φ_Wf) ≫
                hU.fromSpec =
            AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hU.map_fromSpec hWf (CategoryTheory.homOfLE (P_k0.basicOpen_le f)).op, hφ_Wf, hφ_U]
        have hMap_eq := (CategoryTheory.cancel_mono hU.fromSpec).mp hSpec_eq
        have hHom_eq := congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective hMap_eq)
        intro c
        exact RingHom.congr_fun hHom_eq c
      haveI hLoc_Bf : IsLocalization.Away f B_f := hU.isLocalization_basicOpen f
      obtain ⟨k_exp, r₀, hr₀⟩ := IsLocalization.Away.surj f (res_gf w_g)
      have hr₀_val : φ_U.hom (f ^ k_exp) * x = φ_U.hom r₀ := by
        have h1 := congrArg φ_Wf.hom hr₀
        have halg_Bf : ∀ c : R_U, algebraMap R_U B_f c = res_Uf c := fun _ => rfl
        rw [map_mul, ← map_pow, halg_Bf, halg_Bf, hcomp_gf, hw_g, hcomp_Uf, hcomp_Uf,
          mul_comm] at h1
        exact h1
      have hfk_J : f ^ k_exp ∈ J := ⟨r₀, hr₀_val⟩
      exact hf_not_p (hp_max.isPrime.mem_of_pow_mem k_exp (hJp hfk_J))
    have h1_J : (1 : R_U) ∈ J := by
      rw [hJ_top]
      exact Submodule.mem_top
    obtain ⟨r, hr⟩ := h1_J
    rw [map_one, one_mul] at hr
    exact ⟨r, hr.symm⟩

  
  let f_Z : Z_sch ⟶ P_k0 := ιZ ≫ Φ_bar
  haveI : AlgebraicGeometry.IsClosedImmersion ιZ := hCl_Z
  haveI : AlgebraicGeometry.IsProper g_ℰ := hProp_ℰ
  haveI : AlgebraicGeometry.IsProper snd₀ := inferInstance
  haveI : AlgebraicGeometry.IsProper (ιZ ≫ snd₀) := inferInstance
  haveI hProp_gPk0 : AlgebraicGeometry.IsProper g_Pk0 := (hCoord k₀ 1).1
  haveI hSep_gPk0 : AlgebraicGeometry.IsSeparated g_Pk0 := inferInstance
  haveI hProp_comp : AlgebraicGeometry.IsProper (f_Z ≫ g_Pk0) := by
