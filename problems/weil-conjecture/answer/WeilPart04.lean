        rw [← hcomap_resX, Ideal.mem_comap, ← ha_Q_eq]
        exact q_r₂.asIdeal.mul_mem_right _ hQ_in
    have hMaster : φ_X.hom (a_Q * r₂ ^ k_P) * u = φ_X.hom (a_P * r₂ ^ k_Q) := by
      have hP_val : φ_X.hom a_P = ψ_b b P' * φ_X.hom (r₂ ^ k_P) := by
        calc
          φ_X.hom a_P = φ_r₂.hom (res_X a_P) := (hφ_resX a_P).symm
          _ = φ_r₂.hom (τ_b P' * res_X (r₂ ^ k_P)) := by rw [← ha_P_eq]
          _ = φ_r₂.hom (τ_b P') * φ_r₂.hom (res_X (r₂ ^ k_P)) := map_mul _ _ _
          _ = ψ_b b P' * φ_X.hom (r₂ ^ k_P) := by rw [hφ_τ P', hφ_resX (r₂ ^ k_P)]
      have hQ_val : φ_X.hom a_Q = ψ_b b Q' * φ_X.hom (r₂ ^ k_Q) := by
        calc
          φ_X.hom a_Q = φ_r₂.hom (res_X a_Q) := (hφ_resX a_Q).symm
          _ = φ_r₂.hom (τ_b Q' * res_X (r₂ ^ k_Q)) := by rw [← ha_Q_eq]
          _ = φ_r₂.hom (τ_b Q') * φ_r₂.hom (res_X (r₂ ^ k_Q)) := map_mul _ _ _
          _ = ψ_b b Q' * φ_X.hom (r₂ ^ k_Q) := by rw [hφ_τ Q', hφ_resX (r₂ ^ k_Q)]
      rw [map_mul, map_mul, hQ_val, hP_val]
      calc
        (ψ_b b Q' * φ_X.hom (r₂ ^ k_Q) * φ_X.hom (r₂ ^ k_P)) * u
            = (ψ_b b Q' * u) * φ_X.hom (r₂ ^ k_P) * φ_X.hom (r₂ ^ k_Q) := by ring
        _ = ψ_b b P' * φ_X.hom (r₂ ^ k_P) * φ_X.hom (r₂ ^ k_Q) := by rw [hu_cop]
    by_cases hQ_in : Q' ∈ q_L
    · right
      have ha_Q_in : a_Q ∈ p := ha_Q_iff.mpr hQ_in
      have hP_not : P' ∉ q_L := fun hP_in => hNotBoth ⟨hP_in, hQ_in⟩
      have ha_P_not : a_P ∉ p := mt ha_P_iff.mp hP_not
      refine ⟨a_Q * r₂ ^ k_P, a_P * r₂ ^ k_Q, p.mul_mem_right _ ha_Q_in, ?_, hMaster⟩
      intro hm
      rcases hp.mem_or_mem hm with h1 | h2
      · exact ha_P_not h1
      · exact hr₂_not_p (hp.mem_of_pow_mem k_Q h2)
    · left
      have ha_Q_not : a_Q ∉ p := mt ha_Q_iff.mp hQ_in
      refine ⟨a_P * r₂ ^ k_Q, a_Q * r₂ ^ k_P, ?_, hMaster⟩
      intro hm
      rcases hp.mem_or_mem hm with h1 | h2
      · exact ha_Q_not h1
      · exact hr₂_not_p (hp.mem_of_pow_mem k_P h2)

theorem weil_projLine_graph_closure_and_val_center_eval (W_base : Type u) [CommRing W_base]
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of W_base))
    (hInt_ℰ : AlgebraicGeometry.IsIntegral ℰ)
    (F : Type u) [Field F]
    (η_ℰ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ ℰ)
    (hFunc_ℰ : IsSchemeFunctionField ℰ F η_ℰ)
    (φ_WF : W_base →+* F)
    (hη_g : η_ℰ ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_WF))
    (u_Z : F) (hu_ne : u_Z ≠ 0)
    (hAff_W : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen W_base 1 a))
    (c_W : ∀ a : Fin (1 + 1),
      W_base →+* ↑((weilProjectiveSpaceOver W_base 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen W_base 1 a))))
    (t_W : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver W_base 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen W_base 1 a))))
    (hCoord_W : IsCommRingProjCoordSystem W_base 1 hAff_W c_W t_W) :
    let P_W := (weilProjectiveSpaceOver W_base 1).left
    let g_PW := (weilProjectiveSpaceOver W_base 1).hom
    ∃ (Γ_Z : AlgebraicGeometry.Scheme.{u})
      (p_1 : Γ_Z ⟶ ℰ)
      (p_2 : Γ_Z ⟶ P_W)
      (η_Γ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Γ_Z),
      AlgebraicGeometry.IsIntegral Γ_Z ∧
      AlgebraicGeometry.IsDominant η_Γ ∧
      IsSchemeFunctionField Γ_Z F η_Γ ∧
      AlgebraicGeometry.IsProper p_1 ∧
      p_1 ≫ g_ℰ = p_2 ≫ g_PW ∧
      η_Γ ≫ p_1 = η_ℰ ∧
      (∀ z : Γ_Z,
        ∃ (a : Fin 2)
          (U_X : ℰ.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : Γ_Z.Opens) (hVC : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map p_1.base).obj U_X)
          (φ_X : ℰ.presheaf.obj (Opposite.op U_X) ⟶ CommRingCat.of F)
          (φ_C : Γ_Z.presheaf.obj (Opposite.op V_C) ⟶ CommRingCat.of F)
          (y_a : ↑(Γ_Z.presheaf.obj (Opposite.op V_C))),
          z ∈ V_C ∧
          AlgebraicGeometry.Spec.map φ_X ≫ hUX.fromSpec = η_ℰ ∧
          AlgebraicGeometry.Spec.map φ_C ≫ hVC.fromSpec = η_Γ ∧
          Function.Injective φ_C.hom ∧
          φ_C.hom.comp (p_1.appLE U_X V_C e_X).hom = φ_X.hom ∧
          (p_1.appLE U_X V_C e_X).hom.FiniteType ∧
          Subring.closure (Set.range (p_1.appLE U_X V_C e_X).hom ∪ {y_a}) = ⊤ ∧
          ((a = 0 ∧ φ_C.hom y_a = u_Z) ∨ (a = 1 ∧ φ_C.hom y_a = u_Z⁻¹))) ∧
      (∀ (Φ_Z : ℰ ⟶ P_W),
        Φ_Z ≫ g_PW = g_ℰ →
        η_ℰ ≫ Φ_Z = η_Γ ≫ p_2 →
        ∀ (W : ValuationSubring F)
          (hW_sub : ∀ r : W_base, φ_WF r ∈ W)
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ ℰ)
          (a : Fin 2) (v_W : Fin 2 → ↥W),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_W = η_ℰ →
          v_W a = 1 →
          ((a = 0 ∧ W.subtype (v_W 1) = u_Z) ∨ (a = 1 ∧ W.subtype (v_W 0) = u_Z⁻¹)) →
          ∃ (χ_W : ↑(P_W.presheaf.obj (Opposite.op (weilProjBasicOpen W_base 1 a))) →+* ↥W),
            χ_W.comp (c_W a) = φ_WF.codRestrict W.toSubring hW_sub ∧
            (∀ b : Fin 2, χ_W (t_W a b) = v_W b) ∧
            ψ_W ≫ Φ_Z =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_W) ≫ (hAff_W a).fromSpec) :=
by
  intro P_W g_PW
  let _ := hInt_ℰ
  obtain ⟨hProp_PW, hCov_PW, hBase_PW, _hPoly_PW, ht_diag, hGen_PW, hEval_PW,
    hInter_PW, hCocyc_c, hCocyc_t⟩ := hCoord_W
  have : AlgebraicGeometry.IsProper g_PW := hProp_PW
  
  let D_W : Fin 2 → P_W.Opens := weilProjBasicOpen W_base 1
  let v_F : Fin 2 → Fin 2 → F :=
    fun a b => if a = 0 then (if b = 0 then 1 else u_Z) else (if b = 0 then u_Z⁻¹ else 1)
  have hv_F_diag : ∀ a : Fin 2, v_F a a = 1 := by
    intro a
    fin_cases a <;> rfl
  choose χ hχ_c hχ_t using fun a : Fin 2 => hEval_PW a F φ_WF (v_F a) (hv_F_diag a)
  let η_PW : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_W :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ 0)) ≫ (hAff_W 0).fromSpec
  have hη_PW_g : η_PW ≫ g_PW = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_WF) := by
    dsimp only [η_PW, g_PW]
    rw [CategoryTheory.Category.assoc, ← hBase_PW 0, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hχ_c 0]
  have hη_PW_chart : ∀ a : Fin 2,
      η_PW = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ a)) ≫ (hAff_W a).fromSpec := by
    let D_01 : P_W.Opens := P_W.basicOpen (t_W 0 1)
    have hAff_01 : AlgebraicGeometry.IsAffineOpen D_01 := (hAff_W 0).basicOpen (t_W 0 1)
    have i_0 : D_01 ≤ D_W 0 := P_W.basicOpen_le (t_W 0 1)
    have e_eq : D_01 ≤ D_W 0 ⊓ D_W 1 := le_of_eq (hInter_PW 0 1)
    have i_1 : D_01 ≤ D_W 1 := e_eq.trans inf_le_right
    let Γ_01 : Type u := ↑(P_W.presheaf.obj (Opposite.op D_01))
    let res_0 := (P_W.presheaf.map (CategoryTheory.homOfLE i_0).op).hom
    let res_1 := (P_W.presheaf.map (CategoryTheory.homOfLE i_1).op).hom
    let res_eq := (P_W.presheaf.map (CategoryTheory.homOfLE e_eq).op).hom
    have hLoc_01 : IsLocalization.Away (t_W 0 1) Γ_01 :=
      (hAff_W 0).isLocalization_basicOpen (t_W 0 1)
    have hres0_alg : ∀ x, algebraMap _ Γ_01 x = res_0 x := fun _ => rfl
    have hχ0_t01 : χ 0 (t_W 0 1) = u_Z := hχ_t 0 1
    have hu_unit : IsUnit (χ 0 (t_W 0 1)) := by
      rw [hχ0_t01]
      exact IsUnit.mk0 u_Z hu_ne
    let χ_01 : Γ_01 →+* F := IsLocalization.Away.lift (t_W 0 1) hu_unit
    have hχ01_res0 : ∀ x, χ_01 (res_0 x) = χ 0 x := by
      intro x
      rw [← hres0_alg x]
      exact IsLocalization.Away.lift_eq (t_W 0 1) hu_unit x
    have hres_left : ∀ x,
        res_eq ((P_W.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : D_W 0 ⊓ D_W 1 ≤ D_W 0)).op).hom x) =
          res_0 x := by
      intro x
      have hcomp :
          (CategoryTheory.homOfLE (inf_le_left : D_W 0 ⊓ D_W 1 ≤ D_W 0)).op ≫
            (CategoryTheory.homOfLE e_eq).op =
          (CategoryTheory.homOfLE i_0).op := by
        rw [← op_comp]
        exact congrArg Quiver.Hom.op (Subsingleton.elim _ _)
      change (P_W.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫
        P_W.presheaf.map (CategoryTheory.homOfLE e_eq).op).hom x = res_0 x
      rw [← P_W.presheaf.map_comp, hcomp]
    have hres_right : ∀ y,
        res_eq ((P_W.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : D_W 0 ⊓ D_W 1 ≤ D_W 1)).op).hom y) =
          res_1 y := by
      intro y
      have hcomp :
          (CategoryTheory.homOfLE (inf_le_right : D_W 0 ⊓ D_W 1 ≤ D_W 1)).op ≫
            (CategoryTheory.homOfLE e_eq).op =
          (CategoryTheory.homOfLE i_1).op := by
        rw [← op_comp]
        exact congrArg Quiver.Hom.op (Subsingleton.elim _ _)
      change (P_W.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫
        P_W.presheaf.map (CategoryTheory.homOfLE e_eq).op).hom y = res_1 y
      rw [← P_W.presheaf.map_comp, hcomp]
    have hχ01_comp_res1 : χ_01.comp res_1 = χ 1 := by
      have hsub : Set.range (c_W 1) ∪ Set.range (t_W 1) ⊆
          (RingHom.eqLocus (χ_01.comp res_1) (χ 1) : Set _) := by
        rintro _ (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change χ_01 (res_1 (c_W 1 r)) = χ 1 (c_W 1 r)
          have hc := congrArg res_eq (hCocyc_c 0 1 r)
          rw [hres_right, hres_left] at hc
          rw [hc, hχ01_res0]
          calc
            χ 0 (c_W 0 r) = ((χ 0).comp (c_W 0)) r := rfl
            _ = φ_WF r := by rw [hχ_c 0]
            _ = ((χ 1).comp (c_W 1)) r := by rw [hχ_c 1]
            _ = χ 1 (c_W 1 r) := rfl
        · change χ_01 (res_1 (t_W 1 b)) = χ 1 (t_W 1 b)
          apply mul_right_cancel₀ hu_ne
          have ht := congrArg res_eq (hCocyc_t 0 1 b)
          rw [map_mul, hres_right, hres_left, hres_left] at ht
          have ht' := congrArg χ_01 ht
          rw [map_mul, hχ01_res0, hχ01_res0, hχ0_t01] at ht'
          rw [ht', hχ_t 0 b, hχ_t 1 b]
          fin_cases b
          · dsimp [v_F]
            exact (inv_mul_cancel₀ hu_ne).symm
          · dsimp [v_F]
            exact (one_mul u_Z).symm
      have htop : (⊤ : Subring _) ≤ RingHom.eqLocus (χ_01.comp res_1) (χ 1) := by
        rw [← hGen_PW 1]
        exact Subring.closure_le.mpr hsub
      ext y
      exact htop trivial
    have hχ01_comp_res0 : χ_01.comp res_0 = χ 0 := RingHom.ext hχ01_res0
    intro a
    fin_cases a
    · rfl
    · change η_PW = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ 1)) ≫ (hAff_W 1).fromSpec
      dsimp only [η_PW]
      rw [← hχ01_comp_res0, ← hχ01_comp_res1,
        CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      have hm0 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_0) ≫ (hAff_W 0).fromSpec =
          hAff_01.fromSpec := by
        dsimp only [res_0]
        rw [CommRingCat.ofHom_hom]
        exact (hAff_W 0).map_fromSpec hAff_01 (CategoryTheory.homOfLE i_0).op
      have hm1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_1) ≫ (hAff_W 1).fromSpec =
          hAff_01.fromSpec := by
        dsimp only [res_1]
        rw [CommRingCat.ofHom_hom]
        exact (hAff_W 1).map_fromSpec hAff_01 (CategoryTheory.homOfLE i_1).op
      rw [hm0, hm1]
  
  let Q := CategoryTheory.Limits.pullback g_ℰ g_PW
  let fst_Q : Q ⟶ ℰ := CategoryTheory.Limits.pullback.fst g_ℰ g_PW
  let snd_Q : Q ⟶ P_W := CategoryTheory.Limits.pullback.snd g_ℰ g_PW
  let δ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Q :=
    CategoryTheory.Limits.pullback.lift η_ℰ η_PW (hη_g.trans hη_PW_g.symm)
  have : AlgebraicGeometry.QuasiCompact δ :=
    AlgebraicGeometry.QuasiCompact.mk
      (fun _ _ _ => Set.Subsingleton.isCompact fun _ _ _ _ => Subsingleton.elim _ _)
  let Γ_Z : AlgebraicGeometry.Scheme.{u} := δ.image
  let ι_Γ : Γ_Z ⟶ Q := δ.imageι
  let η_Γ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Γ_Z := δ.toImage
  let p_1 : Γ_Z ⟶ ℰ := ι_Γ ≫ fst_Q
  let p_2 : Γ_Z ⟶ P_W := ι_Γ ≫ snd_Q
  have hDom_Γ : AlgebraicGeometry.IsDominant η_Γ := inferInstance
  have hProp_p1 : AlgebraicGeometry.IsProper p_1 := inferInstance
  have hp_comm : p_1 ≫ g_ℰ = p_2 ≫ g_PW := by
    dsimp only [p_1, p_2, fst_Q, snd_Q]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc]
  have hη_p1 : η_Γ ≫ p_1 = η_ℰ := by
    dsimp only [p_1, η_Γ, ι_Γ, δ, fst_Q]
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_fst]
  have hη_p2 : η_Γ ≫ p_2 = η_PW := by
    dsimp only [p_2, η_Γ, ι_Γ, δ, snd_Q]
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_snd]
  have hInt_Γ : AlgebraicGeometry.IsIntegral Γ_Z := by
    have hIrredF : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral _
    obtain ⟨z₀⟩ := hIrredF.toNonempty
    have hDense : DenseRange η_Γ.base := hDom_Γ.denseRange
    have hPreΓ : IsPreirreducible (Set.univ : Set ↥Γ_Z) := by
      rw [← hDense.closure_eq, ← Set.image_univ]
      exact (hIrredF.isPreirreducible_univ.image η_Γ.base η_Γ.continuous.continuousOn).closure
    have : IrreducibleSpace ↥Γ_Z :=
      { isPreirreducible_univ := hPreΓ, toNonempty := ⟨η_Γ.base z₀⟩ }
    have : ∀ w : ↥Γ_Z, _root_.IsReduced ↑(Γ_Z.presheaf.stalk w) := by
      intro w
      obtain ⟨U, hU, hwU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := ι_Γ.base w) (U := ⊤) trivial
      let V : Γ_Z.Opens := (TopologicalSpace.Opens.map ι_Γ.base).obj U
      have hV : AlgebraicGeometry.IsAffineOpen V := hU.preimage ι_Γ
      have hwV : w ∈ V := hwU
      let e_sub := (δ.ker.subschemeObjIso ⟨U, hU⟩).commRingCatIsoToRingEquiv
      let lift_hom :
          (↑(Q.presheaf.obj (Opposite.op U)) ⧸ δ.ker.ideal ⟨U, hU⟩) →+*
            ↑((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map δ.base).obj U))) :=
        Ideal.Quotient.lift (δ.ker.ideal ⟨U, hU⟩) (δ.app U).hom (fun r hr => by
          rw [AlgebraicGeometry.Scheme.Hom.ker_apply δ ⟨U, hU⟩] at hr
          exact hr)
      have hInj_lift : Function.Injective lift_hom := by
        intro q₁ q₂ hq
        induction q₁ using Quotient.inductionOn with | h r₁ =>
        induction q₂ using Quotient.inductionOn with | h r₂ =>
        apply Ideal.Quotient.eq.mpr
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply δ ⟨U, hU⟩]
        change (δ.app U).hom (r₁ - r₂) = 0
        rw [map_sub, sub_eq_zero]
        exact hq
      have : _root_.IsReduced
          ↑((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map δ.base).obj U))) :=
        AlgebraicGeometry.IsReduced.component_reduced _
      have : _root_.IsReduced ↑(Γ_Z.presheaf.obj (Opposite.op V)) :=
        isReduced_of_injective (lift_hom.comp e_sub.toRingHom)
          (hInj_lift.comp e_sub.injective)
      have : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (Γ_Z.presheaf.obj (Opposite.op V))) :=
        (AlgebraicGeometry.affine_isReduced_iff _).mpr inferInstance
      have : AlgebraicGeometry.IsReduced V.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion hV.isoSpec.hom
      have : _root_.IsReduced ↑(V.toScheme.presheaf.stalk ⟨w, hwV⟩) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced V.toScheme ⟨w, hwV⟩
      exact isReduced_of_injective
        (V.stalkIso ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.toRingHom
        (V.stalkIso ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.injective
    have : AlgebraicGeometry.IsReduced Γ_Z :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk Γ_Z
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Γ_Z
  have hToField : ∀ (V : Γ_Z.Opens) (hV : AlgebraicGeometry.IsAffineOpen V),
      Nonempty ↥V →
      ∃ (φ_V : Γ_Z.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of F),
        AlgebraicGeometry.Spec.map φ_V ≫ hV.fromSpec = η_Γ ∧
        Function.Injective φ_V.hom := by
    intro V hV hV_ne
    let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
    let R_V : Type u := ↑(Γ_Z.presheaf.obj (Opposite.op V))
    have : IsDomain R_V :=
      @AlgebraicGeometry.IsIntegral.component_integral Γ_Z hInt_Γ V hV_ne
    obtain ⟨⟨z₀, hz₀⟩⟩ := hV_ne
    obtain ⟨pt₀, hpt₀⟩ := hDom_Γ.denseRange.exists_mem_open V.isOpen ⟨z₀, hz₀⟩
    have i_top : (⊤ : S_F.Opens) ≤ (TopologicalSpace.Opens.map η_Γ.base).obj V := by
      intro pt _
      have h_eq : pt = pt₀ := Subsingleton.elim pt pt₀
      rw [h_eq]
      exact hpt₀
    have h_top : AlgebraicGeometry.IsAffineOpen (⊤ : S_F.Opens) :=
      AlgebraicGeometry.isAffineOpen_top S_F
    have : CategoryTheory.IsIso h_top.fromSpec :=
      AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top
        h_top.fromSpec h_top.opensRange_fromSpec
    let e_inv : S_F.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of F :=
      AlgebraicGeometry.Spec.preimage (CategoryTheory.inv h_top.fromSpec)
    let φ_V : Γ_Z.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of F :=
      η_Γ.appLE V ⊤ i_top ≫ e_inv
    have hSpec_V : AlgebraicGeometry.Spec.map φ_V ≫ hV.fromSpec = η_Γ := by
      dsimp only [φ_V, e_inv]
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec η_Γ hV h_top i_top,
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.Spec.map_preimage,
        CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
    refine ⟨φ_V, hSpec_V, ?_⟩
    rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
    intro x hx_ker
    rw [Ideal.mem_bot]
