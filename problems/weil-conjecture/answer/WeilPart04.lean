      apply hunit_den.mul_left_inj.mp
      calc
        evbar_L (u_num * u_den⁻¹) * evbar_L u_den = evbar_L (u_num * (u_den⁻¹ * u_den)) := by
          rw [← map_mul, mul_assoc]
        _ = evbar_L u_num := by rw [inv_mul_cancel₀ hu_den_ne, mul_one]
        _ = ι_E x_z.1 := hu_num
        _ = ι_E (b_z * s_z.1.1) := by rw [hbs']
        _ = (z * ι_E m_e.1) * ι_E s_z.1.1 := by rw [map_mul, hzm']
        _ = z * evbar_L u_den := by rw [mul_assoc, hu_den_eq]
    let e_field : F_θ ≃+* E_m :=
      RingEquiv.ofBijective evbar_L ⟨RingHom.kerLift_injective ev_L.toRingHom, hevbar_surj⟩
    haveI : IsDomain E_m :=
      Function.Injective.isDomain e_field.symm.toRingHom e_field.symm.injective
    exact Function.Injective.isDomain ι_E hinj_E
  have h_step5 : ∀ (B : Type u) [CommRing B], _root_.IsReduced B → (minimalPrimes B).Finite →
      ∀ (m : Ideal B) [m.IsPrime], IsDomain (Localization.AtPrime m) →
      ∃ s : B, s ∉ m ∧ IsDomain (Localization.Away s) := by
    clear! A₀ B
    intro B _ hRed hFinMin m _ hDom_m
    haveI : _root_.IsReduced B := hRed
    let B_m : Type u := Localization.AtPrime m
    haveI : IsDomain B_m := hDom_m
    let q_bot : Ideal B := Ideal.comap (algebraMap B B_m) (⊥ : Ideal B_m)
    have hq_bot_prime : q_bot.IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨fun htop => ?_, fun {x y} hxy => ?_⟩
      · have h1 : (1 : B) ∈ q_bot := htop ▸ Submodule.mem_top
        have h10 : algebraMap B B_m 1 = 0 := h1
        rw [map_one] at h10
        obtain ⟨u_ne, v_ne, huv_ne⟩ := hDom_m.exists_pair_ne
        apply huv_ne
        calc
          u_ne = u_ne * 1 := (mul_one u_ne).symm
          _ = u_ne * 0 := by rw [h10]
          _ = 0 := mul_zero u_ne
          _ = v_ne * 0 := (mul_zero v_ne).symm
          _ = v_ne * 1 := by rw [← h10]
          _ = v_ne := mul_one v_ne
      · have hmul0 : algebraMap B B_m x * algebraMap B B_m y = 0 := by
          rw [← map_mul]; exact hxy
        by_cases hx0 : algebraMap B B_m x = 0
        · exact Or.inl hx0
        · have hreg : algebraMap B B_m x * algebraMap B B_m y =
              algebraMap B B_m x * 0 := by
            rw [mul_zero]; exact hmul0
          exact Or.inr (hDom_m.mul_left_cancel_of_ne_zero hx0 hreg)
    haveI : q_bot.IsPrime := hq_bot_prime
    have hq_bot_le : ∀ (p : Ideal B) [p.IsPrime], p ≤ m → q_bot ≤ p := by
      intro p _ hpm x hx
      have hx_zero : algebraMap B B_m x = 0 := hx
      have hx0 : algebraMap B B_m x = algebraMap B B_m 0 := by rw [hx_zero, map_zero]
      obtain ⟨c, hcx⟩ := (IsLocalization.eq_iff_exists m.primeCompl B_m).mp hx0
      have hcx0 : c.1 * x = 0 := by
        change c.1 * x = c.1 * 0 at hcx
        rwa [mul_zero] at hcx
      have hc_not_p : c.1 ∉ p := fun hcp => c.2 (hpm hcp)
      exact (‹p.IsPrime›.mem_or_mem (hcx0 ▸ p.zero_mem)).resolve_left hc_not_p
    have hq_bot_le_m : q_bot ≤ m := hq_bot_le m le_rfl
    have hmin_unique : ∀ p ∈ minimalPrimes B, p ≤ m → p = q_bot := by
      intro p hp hpm
      haveI : p.IsPrime := hp.1.1
      have hle : q_bot ≤ p := hq_bot_le p hpm
      exact le_antisymm (hp.2 ⟨hq_bot_prime, bot_le⟩ hle) hle
    let S_other : Set (Ideal B) := minimalPrimes B \ {q_bot}
    have hFin_other : S_other.Finite := hFinMin.sdiff
    let F : Finset (Ideal B) := hFin_other.toFinset
    classical
    let f : Ideal B → B := fun p =>
      if hp : ∃ b ∈ p, b ∉ m then Classical.choose hp else 1
    have hf_spec : ∀ p ∈ F, f p ∈ p ∧ f p ∉ m := by
      intro p hpF
      have hpS : p ∈ S_other := hFin_other.mem_toFinset.mp hpF
      have hp_not_le : ¬ (p ≤ m) := fun hpm => hpS.2 (hmin_unique p hpS.1 hpm)
      have hex : ∃ b ∈ p, b ∉ m := SetLike.not_le_iff_exists.mp hp_not_le
      simp only [f, hex, ↓reduceDIte]
      exact Classical.choose_spec hex
    let s : B := ∏ p ∈ F, f p
    have hs_not_m : s ∉ m := by
      suffices ∀ (G : Finset (Ideal B)), (∀ p ∈ G, f p ∉ m) → (∏ p ∈ G, f p) ∉ m from
        this F (fun p hp => (hf_spec p hp).2)
      intro G
      refine Finset.induction_on G ?_ ?_
      · intro _ h1m
        exact ‹m.IsPrime›.ne_top (m.eq_top_iff_one.mpr (by simpa only [Finset.prod_empty] using h1m))
      · intro p G' hpG' ih hG
        rw [Finset.prod_insert hpG']
        exact ‹m.IsPrime›.mul_notMem (hG p (Finset.mem_insert_self p G'))
          (ih fun q hq => hG q (Finset.mem_insert_of_mem hq))
    have hs_mem_other : ∀ p ∈ F, s ∈ p := by
      intro p hpF
      obtain ⟨w, hw⟩ := Finset.dvd_prod_of_mem f hpF
      change (∏ i ∈ F, f i) ∈ p
      rw [hw]
      exact p.mul_mem_right w (hf_spec p hpF).1
    have hsa_zero : ∀ a ∈ q_bot, s * a = 0 := by
      intro a ha
      have hmem_sInf : s * a ∈ sInf {Q : Ideal B | Q.IsPrime} := by
        rw [Ideal.mem_sInf]
        intro Q hQ
        haveI : Q.IsPrime := hQ
        obtain ⟨p, hp_min, hp_le_Q⟩ := @Ideal.exists_minimalPrimes_le B _ ⊥ Q _ bot_le
        by_cases hp_eq : p = q_bot
        · subst hp_eq
          exact Q.mul_mem_left s (hp_le_Q ha)
        · have hpF : p ∈ F := hFin_other.mem_toFinset.mpr ⟨hp_min, hp_eq⟩
          exact Q.mul_mem_right a (hp_le_Q (hs_mem_other p hpF))
      rw [← nilradical_eq_sInf B, mem_nilradical] at hmem_sInf
      exact hmem_sInf.eq_zero
    let B_s : Type u := Localization.Away s
    let ι_s : B →+* B_s := algebraMap B B_s
    have hbot_prime : (⊥ : Ideal B_s).IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨?_, ?_⟩
      · intro htop
        have h1_bot : (1 : B_s) ∈ (⊥ : Ideal B_s) := htop ▸ Submodule.mem_top
        have h1_eq_0 : (1 : B_s) = 0 := Ideal.mem_bot.mp h1_bot
        have h10 : ι_s 1 = ι_s 0 := by rw [map_one, map_zero, h1_eq_0]
        obtain ⟨⟨_, k, rfl⟩, hsk⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers s) B_s).mp h10
        have hsk0 : s ^ k = 0 := by
          change s ^ k * 1 = s ^ k * 0 at hsk
          rwa [mul_one, mul_zero] at hsk
        have hsk_m : s ^ k ∈ m := hsk0 ▸ m.zero_mem
        exact hs_not_m (‹m.IsPrime›.mem_of_pow_mem k hsk_m)
      · intro x y hxy
        rw [Ideal.mem_bot] at hxy ⊢
        rw [Ideal.mem_bot]
        obtain ⟨⟨a, c_x⟩, hax⟩ := IsLocalization.surj (Submonoid.powers s) x
        obtain ⟨⟨b, c_y⟩, hby⟩ := IsLocalization.surj (Submonoid.powers s) y
        have hab0 : ι_s (a * b) = ι_s 0 := by
          rw [map_mul, map_zero, ← hax, ← hby]
          calc
            (x * ι_s c_x.1) * (y * ι_s c_y.1) = (x * y) * (ι_s c_x.1 * ι_s c_y.1) := by ring
            _ = 0 := by rw [hxy, zero_mul]
        obtain ⟨⟨_, k, rfl⟩, hsk_ab⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers s) B_s).mp hab0
        have hsk_ab0 : s ^ k * (a * b) = 0 := by
          change s ^ k * (a * b) = s ^ k * 0 at hsk_ab
          rwa [mul_zero] at hsk_ab
        have hsk_not_q : s ^ k ∉ q_bot :=
          fun hmem => hs_not_m (hq_bot_le_m (hq_bot_prime.mem_of_pow_mem k hmem))
        have hab_q : a * b ∈ q_bot :=
          (hq_bot_prime.mem_or_mem (hsk_ab0 ▸ q_bot.zero_mem)).resolve_left hsk_not_q
        rcases hq_bot_prime.mem_or_mem hab_q with ha_q | hb_q
        · left
          have hsa : s * a = 0 := hsa_zero a ha_q
          have hunit_cx : IsUnit (ι_s c_x.1 * ι_s s) :=
            (IsLocalization.map_units B_s c_x).mul
              (IsLocalization.map_units B_s ⟨s, Submonoid.mem_powers s⟩)
          apply hunit_cx.mul_left_eq_zero.mp
          calc
            x * (ι_s c_x.1 * ι_s s) = (x * ι_s c_x.1) * ι_s s := by ring
            _ = ι_s a * ι_s s := by rw [hax]
            _ = ι_s (s * a) := by rw [← map_mul, mul_comm]
            _ = 0 := by rw [hsa, map_zero]
        · right
          have hsb : s * b = 0 := hsa_zero b hb_q
          have hunit_cy : IsUnit (ι_s c_y.1 * ι_s s) :=
            (IsLocalization.map_units B_s c_y).mul
              (IsLocalization.map_units B_s ⟨s, Submonoid.mem_powers s⟩)
          apply hunit_cy.mul_left_eq_zero.mp
          calc
            y * (ι_s c_y.1 * ι_s s) = (y * ι_s c_y.1) * ι_s s := by ring
            _ = ι_s b * ι_s s := by rw [hby]
            _ = ι_s (s * b) := by rw [← map_mul, mul_comm]
            _ = 0 := by rw [hsb, map_zero]
    exact ⟨s, hs_not_m, @IsDomain.of_bot_isPrime B_s _ hbot_prime⟩
  obtain ⟨hRed, hFinMin⟩ :=
    @h_step1 A₀ B instCommA₀ instDomA₀ instCommB instAlgA₀B instEtA₀B
  have hn_le_nzd : n.primeCompl ≤ nonZeroDivisors A₀ := by
    intro a ha
    rw [mem_nonZeroDivisors_iff_right]
    intro x hxa
    have ha0 : a ≠ 0 := fun h0 => ha (h0 ▸ n.zero_mem)
    have hreg : x * a = 0 * a := by rw [zero_mul]; exact hxa
    exact instDomA₀.mul_right_cancel_of_ne_zero ha0 hreg
  have hDomA₁ : IsDomain A₁ :=
    @IsLocalization.isDomain_localization A₀ _ instDomA₀ n.primeCompl hn_le_nzd
  have hICA₁ : IsIntegrallyClosed A₁ :=
    @isIntegrallyClosed_of_isLocalization A₀ A₁ instCommA₀ _ _ hICA₀
      instDomA₀ n.primeCompl hn_le_nzd _
  obtain ⟨hUnram, hLocHom, hTF₁, hSep, hMax, R₁, hFinR₁, hIntR₁, hLocR₁⟩ := h_step2
  obtain ⟨θ, hIntθ, hLocθ⟩ :=
    @h_step3 A₁ B_q _ _ _ _ _ hLocHom hSep hMax R₁ hFinR₁ hIntR₁ hLocR₁
  have hDom_q : IsDomain B_q :=
    @h_step4 A₁ B_q _ hDomA₁ hICA₁ _ _ _ hTF₁ hUnram θ hIntθ hLocθ
  exact @h_step5 B instCommB hRed hFinMin q instPrimeQ hDom_q

theorem weil_rankOne_degenerate_nodal_etale_branch_and_goingDown_lift (L : Type u) [Field L] [IsAlgClosed L]
    (W₀ : ValuationSubring L)
    (hMax_W₀ : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (B : Type u) [CommRing B]
    (ψ : (MvPolynomial (Fin 2) ↥W₀ ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : ↥W₀)}) →+* B)
    (hEt : ψ.Etale) :
    let I₀ : Ideal (MvPolynomial (Fin 2) ↥W₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : ↥W₀)}
    let x₀ : B := ψ (Ideal.Quotient.mk I₀ (MvPolynomial.X 0))
    let x₁ : B := ψ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1))
    let c_W : ↥W₀ →+* B := ψ.comp ((Ideal.Quotient.mk I₀).comp MvPolynomial.C)
    ((∀ i : Fin 2,
      ∃ γ_i : Polynomial ↥W₀ →+* Localization.Away (ψ (Ideal.Quotient.mk I₀ (MvPolynomial.X i))),
        γ_i.Etale ∧
        γ_i.comp Polynomial.C =
          (algebraMap B (Localization.Away (ψ (Ideal.Quotient.mk I₀ (MvPolynomial.X i))))).comp c_W) ∧
     (∀ i : Fin 2,
      ∃ δ_i : Polynomial ↥W₀ →+* (B ⧸ Ideal.span {ψ (Ideal.Quotient.mk I₀ (MvPolynomial.X i))}),
        δ_i.Etale)) ∧
    (IsDomain (B ⧸ Ideal.span {x₀}) →
      IsDomain (B ⧸ Ideal.span {x₁}) →
      ∀ (𝔓 𝔔 : Ideal B) [𝔓.IsPrime] [𝔔.IsPrime],
        x₀ ∈ 𝔓 →
        𝔓 < 𝔔 →
        𝔓.comap c_W = ⊥ →
        𝔔.comap c_W = ⊥ →
        (𝔓 = Ideal.span {x₀} ∧
          ∃ γ_br : Polynomial ↥W₀ →+* (B ⧸ 𝔓),
            γ_br.Etale ∧ γ_br.comp Polynomial.C = (Ideal.Quotient.mk 𝔓).comp c_W) ∧
        (∀ (𝔮 : Ideal B) [𝔮.IsPrime],
          x₀ ∈ 𝔮 →
          x₁ ∈ 𝔮 →
          𝔮.comap c_W = IsLocalRing.maximalIdeal ↥W₀ →
          ∃ (𝔭_b 𝔮₁ : Ideal B) (_ : 𝔭_b.IsPrime) (_ : 𝔮₁.IsPrime) (β_L : B →+* L),
            𝔓 ≤ 𝔭_b ∧
            𝔭_b ≤ 𝔮 ∧
            𝔭_b.comap c_W = ⊥ ∧
            β_L.comp c_W = W₀.subtype ∧
            RingHom.ker β_L = 𝔭_b ∧
            𝔮₁ ≤ 𝔭_b ∧
            𝔮₁.comap c_W = ⊥ ∧
            x₀ ∉ 𝔮₁)) :=
by
  have hEtaleComp : ∀ {C₁ C₂ C₃ : Type u} [CommRing C₁] [CommRing C₂] [CommRing C₃]
      {f : C₁ →+* C₂} {g : C₂ →+* C₃}, f.Etale → g.Etale → (g.comp f).Etale :=
    fun {_ _ _ _ _ _ f g} hf hg => RingHom.Etale.stableUnderComposition f g hf hg
  have hEtaleEquiv : ∀ {C₁ C₂ : Type u} [CommRing C₁] [CommRing C₂] (e : C₁ ≃+* C₂),
      e.toRingHom.Etale :=
    fun e => RingHom.Etale.of_bijective (f := e.toRingHom) e.bijective

  
  have hQuotEtale : ∀ {A B' P : Type u} [CommRing A] [CommRing B'] [CommRing P]
      (φ : A →+* B') (hφ : φ.Etale) (I : Ideal A) (J : Ideal B')
      (hIJ : Ideal.map φ I = J) (e : P ≃+* (A ⧸ I))
      (hI_le : ∀ a ∈ I, ((Ideal.Quotient.mk J).comp φ) a = 0),
      ((Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp φ) hI_le).comp e.toRingHom).Etale := by
    intro A B' P _ _ _ φ hφ I J hIJ e hI_le
    letI : Algebra A B' := φ.toAlgebra
    haveI : Algebra.Etale A B' := RingHom.Etale.toAlgebra hφ
    haveI : Algebra.Etale (A ⧸ I) (TensorProduct A (A ⧸ I) B') :=
      Algebra.Etale.baseChange A B' (A ⧸ I)
    have hEt_base : (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B')).Etale :=
      (RingHom.etale_algebraMap).mpr inferInstance
    let e1 : TensorProduct A (A ⧸ I) B' ≃+* TensorProduct A B' (A ⧸ I) :=
      (Algebra.TensorProduct.comm A (A ⧸ I) B').toRingEquiv
    let e2 : TensorProduct A B' (A ⧸ I) ≃+* (B' ⧸ Ideal.map (algebraMap A B') I) :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' I).symm.toRingEquiv
    let e3 : (B' ⧸ Ideal.map (algebraMap A B') I) ≃+* (B' ⧸ J) :=
      Ideal.quotEquivOfEq hIJ
    let Θ : TensorProduct A (A ⧸ I) B' ≃+* (B' ⧸ J) := (e1.trans e2).trans e3
    have hΘ_et : Θ.toRingHom.Etale := hEtaleEquiv Θ
    let φ_bar : (A ⧸ I) →+* (B' ⧸ J) :=
      Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp φ) hI_le
    have hφ_bar_eq : φ_bar = Θ.toRingHom.comp (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B')) := by
      apply Ideal.Quotient.ringHom_ext
      ext a
      change Ideal.Quotient.mk J (φ a) =
        e3 (e2 (e1 (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B') (Ideal.Quotient.mk I a))))
      have h1 : algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B') (Ideal.Quotient.mk I a) =
          (Ideal.Quotient.mk I a) ⊗ₜ[A] (1 : B') := rfl
      have h2 : e1 ((Ideal.Quotient.mk I a) ⊗ₜ[A] (1 : B')) =
          (1 : B') ⊗ₜ[A] (Ideal.Quotient.mk I a) := rfl
      have h3 : (1 : B') ⊗ₜ[A] (Ideal.Quotient.mk I a) = (φ a) ⊗ₜ[A] (1 : A ⧸ I) := by
        have hmk : Ideal.Quotient.mk I a = a • (1 : A ⧸ I) :=
          Algebra.algebraMap_eq_smul_one a
        have hφa : φ a = a • (1 : B') :=
          Algebra.algebraMap_eq_smul_one a
        rw [hmk, hφa, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      have h4 : e2 ((φ a) ⊗ₜ[A] (1 : A ⧸ I)) =
          Ideal.Quotient.mk (Ideal.map (algebraMap A B') I) (φ a) := by
        apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' I).injective
        change (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' I)
            ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' I).symm ((φ a) ⊗ₜ[A] 1)) = _
        rw [AlgEquiv.apply_symm_apply, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
      rw [h1, h2, h3, h4]
      rfl
    have hφ_bar_et : φ_bar.Etale := by
      rw [hφ_bar_eq]
      exact hEtaleComp hEt_base hΘ_et
    exact hEtaleComp (hEtaleEquiv e) hφ_bar_et

  
  have hTransfers : ∀ (R B' : Type u) [CommRing R] [CommRing B']
      (ψ' : (MvPolynomial (Fin 2) R ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : R)}) →+* B'),
      ψ'.Etale →
      let I_R : Ideal (MvPolynomial (Fin 2) R) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : R)}
      let x₀' : B' := ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X 0))
      let x₁' : B' := ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X 1))
      let c_R : R →+* B' := ψ'.comp ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)
      (∀ i : Fin 2,
        ∃ γ_i : Polynomial R →+* Localization.Away (ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X i))),
          γ_i.Etale ∧
          γ_i.comp Polynomial.C =
            (algebraMap B' (Localization.Away (ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X i))))).comp c_R) ∧
      (∀ i : Fin 2,
        ∃ δ_i : Polynomial R →+* (B' ⧸ Ideal.span {ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X i))}),
          δ_i.Etale ∧
          δ_i.comp Polynomial.C =
            (Ideal.Quotient.mk (Ideal.span {ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X i))})).comp c_R ∧
          δ_i Polynomial.X =
            Ideal.Quotient.mk (Ideal.span {ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X i))})
              (ψ' (Ideal.Quotient.mk I_R (MvPolynomial.X (1 - i))))) ∧
      ((Ideal.Quotient.mk (Ideal.span {x₀', x₁'})).comp c_R).Etale := by
    intro R B' _ _ ψ' hEt' I_R x₀' x₁' c_R
    let A_deg := MvPolynomial (Fin 2) R ⧸ I_R
    let π₀ : MvPolynomial (Fin 2) R →+* A_deg := Ideal.Quotient.mk I_R
    let Xbar : Fin 2 → A_deg := fun k => π₀ (MvPolynomial.X k)
    let c_A : R →+* A_deg := π₀.comp MvPolynomial.C
    have hX01 : Xbar 0 * Xbar 1 = 0 := by
      change π₀ (MvPolynomial.X 0) * π₀ (MvPolynomial.X 1) = 0
      rw [← map_mul]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : R) ∈ I_R :=
        Ideal.subset_span rfl
      rw [MvPolynomial.C_0, sub_zero] at hmem
      exact hmem
    have hXij : ∀ i : Fin 2, Xbar i * Xbar (1 - i) = 0 := by
      intro i
      fin_cases i
      · exact hX01
      · change Xbar 1 * Xbar 0 = 0
        rw [mul_comm]
        exact hX01
    have hFin2Other : ∀ (i k : Fin 2), k ≠ i → k = 1 - i := by
      intro i k hki
      fin_cases i <;> fin_cases k <;> first | exact absurd rfl hki | rfl
    refine ⟨?_, ?_, ?_⟩
    · 
      intro i
      let j : Fin 2 := 1 - i
      let S_A := Localization.Away (Xbar i)
      let S_B := Localization.Away (ψ' (Xbar i))
      let P_T := Localization.Away (Polynomial.X : Polynomial R)
      let f_i : Polynomial R →+* S_A :=
        Polynomial.eval₂RingHom ((algebraMap A_deg S_A).comp c_A) (algebraMap A_deg S_A (Xbar i))
      have hfC : ∀ r : R, f_i (Polynomial.C r) = algebraMap A_deg S_A (c_A r) := fun _ =>
        Polynomial.eval₂_C ((algebraMap A_deg S_A).comp c_A) (algebraMap A_deg S_A (Xbar i))
      have hfX : f_i Polynomial.X = algebraMap A_deg S_A (Xbar i) :=
        Polynomial.eval₂_X ((algebraMap A_deg S_A).comp c_A) (algebraMap A_deg S_A (Xbar i))
      have hu_Xi : IsUnit (f_i Polynomial.X) := by
        rw [hfX]
        exact IsLocalization.Away.algebraMap_isUnit (Xbar i)
      let Φ_i : P_T →+* S_A := IsLocalization.Away.lift Polynomial.X hu_Xi
      let g_mv : MvPolynomial (Fin 2) R →+* P_T :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial R) P_T).comp Polynomial.C)
          (fun k : Fin 2 => if k = i then algebraMap (Polynomial R) P_T Polynomial.X else 0)
      have hg_mv_C : ∀ r : R, g_mv (MvPolynomial.C r) = algebraMap (Polynomial R) P_T (Polynomial.C r) :=
        fun r => MvPolynomial.eval₂Hom_C _ _ r
      have hg_mv_X : ∀ k : Fin 2,
          g_mv (MvPolynomial.X k) = if k = i then algebraMap (Polynomial R) P_T Polynomial.X else 0 :=
        fun k => MvPolynomial.eval₂Hom_X' _ _ k
      have hg_mv : ∀ p ∈ I_R, g_mv p = 0 := by
        intro p hp
        rw [Ideal.mem_span_singleton] at hp
        rcases hp with ⟨q, rfl⟩
        rw [map_mul, map_sub, map_mul, MvPolynomial.C_0, map_zero, sub_zero, hg_mv_X 0, hg_mv_X 1]
        by_cases hi0 : (0 : Fin 2) = i
        · have h1i : (1 : Fin 2) ≠ i := fun h => absurd (hi0.trans h.symm) (by decide)
          rw [if_neg h1i, mul_zero, zero_mul]
        · rw [if_neg hi0, zero_mul, zero_mul]
      let g_i : A_deg →+* P_T := Ideal.Quotient.lift I_R g_mv hg_mv
      have hu_X_PT : IsUnit (g_i (Xbar i)) := by
        have hgi : g_i (Xbar i) = algebraMap (Polynomial R) P_T Polynomial.X := by
          change g_mv (MvPolynomial.X i) = _
          rw [hg_mv_X i, if_pos rfl]
        rw [hgi]
        exact IsLocalization.Away.algebraMap_isUnit Polynomial.X
      let Ψ_i : S_A →+* P_T := IsLocalization.Away.lift (Xbar i) hu_X_PT
      have hΨΦ : Ψ_i.comp Φ_i = RingHom.id P_T := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R))
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun r => ?_
          change Ψ_i (Φ_i (algebraMap (Polynomial R) P_T (Polynomial.C r))) =
            algebraMap (Polynomial R) P_T (Polynomial.C r)
          rw [IsLocalization.Away.lift_eq (S := P_T) (x := Polynomial.X) hu_Xi (Polynomial.C r),
            hfC r, IsLocalization.Away.lift_eq (S := S_A) (x := Xbar i) hu_X_PT (c_A r)]
          exact hg_mv_C r
        · change Ψ_i (Φ_i (algebraMap (Polynomial R) P_T Polynomial.X)) =
            algebraMap (Polynomial R) P_T Polynomial.X
          rw [IsLocalization.Away.lift_eq (S := P_T) (x := Polynomial.X) hu_Xi Polynomial.X,
            hfX, IsLocalization.Away.lift_eq (S := S_A) (x := Xbar i) hu_X_PT (Xbar i)]
          change g_mv (MvPolynomial.X i) = _
          rw [hg_mv_X i, if_pos rfl]
      have hXj_zero : algebraMap A_deg S_A (Xbar j) = 0 := by
        have hmul0 : algebraMap A_deg S_A (Xbar i) * algebraMap A_deg S_A (Xbar j) = 0 := by
          rw [← map_mul, hXij i, map_zero]
        exact (IsLocalization.Away.algebraMap_isUnit (S := S_A) (Xbar i)).mul_right_eq_zero.mp hmul0
      have hΦΨ : Φ_i.comp Ψ_i = RingHom.id S_A := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (Xbar i))
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change Φ_i (Ψ_i (algebraMap A_deg S_A (c_A r))) = algebraMap A_deg S_A (c_A r)
          rw [IsLocalization.Away.lift_eq (S := S_A) (x := Xbar i) hu_X_PT (c_A r)]
          have hgC : g_i (c_A r) = algebraMap (Polynomial R) P_T (Polynomial.C r) := hg_mv_C r
          rw [hgC, IsLocalization.Away.lift_eq (S := P_T) (x := Polynomial.X) hu_Xi (Polynomial.C r)]
          exact hfC r
        · intro k
          change Φ_i (Ψ_i (algebraMap A_deg S_A (Xbar k))) = algebraMap A_deg S_A (Xbar k)
          rw [IsLocalization.Away.lift_eq (S := S_A) (x := Xbar i) hu_X_PT (Xbar k)]
          by_cases hki : k = i
          · subst hki
            have hgX : g_i (Xbar k) = algebraMap (Polynomial R) P_T Polynomial.X := by
              change g_mv (MvPolynomial.X k) = _
              rw [hg_mv_X k, if_pos rfl]
            rw [hgX, IsLocalization.Away.lift_eq (S := P_T) (x := Polynomial.X) hu_Xi Polynomial.X]
            exact hfX
          · have hkj : k = j := hFin2Other i k hki
            subst hkj
            have hgX0 : g_i (Xbar j) = 0 := by
              change g_mv (MvPolynomial.X j) = 0
              rw [hg_mv_X j, if_neg hki]
            rw [hgX0, map_zero, hXj_zero]
      let e_PT : P_T ≃+* S_A :=
        { toFun := Φ_i
          invFun := Ψ_i
          left_inv := fun z => RingHom.congr_fun hΨΦ z
          right_inv := fun z => RingHom.congr_fun hΦΨ z
          map_mul' := Φ_i.map_mul
          map_add' := Φ_i.map_add }
      have hEt_PT : (algebraMap (Polynomial R) P_T).Etale :=
        (RingHom.etale_algebraMap).mpr (Algebra.Etale.of_isLocalizationAway Polynomial.X)
      have hEt_Φ : Φ_i.Etale := hEtaleEquiv e_PT
      have hfi_eq : Φ_i.comp (algebraMap (Polynomial R) P_T) = f_i :=
        RingHom.ext fun p => IsLocalization.Away.lift_eq (S := P_T) (x := Polynomial.X) hu_Xi p
      have hEt_fi : f_i.Etale := by
        rw [← hfi_eq]
        exact hEtaleComp hEt_PT hEt_Φ
      have hu_ψXi : IsUnit (((algebraMap B' S_B).comp ψ') (Xbar i)) :=
        IsLocalization.Away.algebraMap_isUnit (ψ' (Xbar i))
      let ψ_loc : S_A →+* S_B := IsLocalization.Away.lift (Xbar i) hu_ψXi
      have hψ_loc_comp : ψ_loc.comp (algebraMap A_deg S_A) = (algebraMap B' S_B).comp ψ' :=
        RingHom.ext fun a => IsLocalization.Away.lift_eq (S := S_A) (x := Xbar i) hu_ψXi a
      have hEt_algA : (algebraMap A_deg S_A).Etale :=
        (RingHom.etale_algebraMap).mpr (Algebra.Etale.of_isLocalizationAway (Xbar i))
      have hEt_algB : (algebraMap B' S_B).Etale :=
        (RingHom.etale_algebraMap).mpr (Algebra.Etale.of_isLocalizationAway (ψ' (Xbar i)))
      have hEt_rhs : ((algebraMap B' S_B).comp ψ').Etale :=
        hEtaleComp hEt' hEt_algB
      let f_Spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc)
      let g_Spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_deg S_A))
      haveI : AlgebraicGeometry.Etale g_Spec :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_algA
      have hcomp_Spec : f_Spec ≫ g_Spec =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap B' S_B).comp ψ')) := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_deg S_A)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap B' S_B).comp ψ'))
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        exact (CommRingCat.ofHom_comp (algebraMap A_deg S_A) ψ_loc).symm.trans
          (congrArg CommRingCat.ofHom hψ_loc_comp)
      haveI : AlgebraicGeometry.Etale (f_Spec ≫ g_Spec) := by
        rw [hcomp_Spec]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_rhs
      have hEt_fSpec : AlgebraicGeometry.Etale f_Spec :=
        AlgebraicGeometry.Etale.of_comp f_Spec g_Spec
      have hEt_ψloc : ψ_loc.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_fSpec
      refine ⟨ψ_loc.comp f_i, hEtaleComp hEt_fi hEt_ψloc, ?_⟩
      ext r
      change ψ_loc (f_i (Polynomial.C r)) = algebraMap B' S_B (ψ' (c_A r))
      rw [hfC r, IsLocalization.Away.lift_eq (S := S_A) (x := Xbar i) hu_ψXi (c_A r)]
      rfl
    · 
      intro i
      let j : Fin 2 := 1 - i
      let I_i : Ideal A_deg := Ideal.span {Xbar i}
      let J_i : Ideal B' := Ideal.span {ψ' (Xbar i)}
      have hIJ_i : Ideal.map ψ' I_i = J_i := by
        rw [Ideal.map_span, Set.image_singleton]
      let u_i : Polynomial R →+* (A_deg ⧸ I_i) :=
        Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_i).comp c_A) (Ideal.Quotient.mk I_i (Xbar j))
      have hu_i_C : ∀ r : R, u_i (Polynomial.C r) = Ideal.Quotient.mk I_i (c_A r) := fun _ =>
        Polynomial.eval₂_C ((Ideal.Quotient.mk I_i).comp c_A) (Ideal.Quotient.mk I_i (Xbar j))
      have hu_i_X : u_i Polynomial.X = Ideal.Quotient.mk I_i (Xbar j) :=
        Polynomial.eval₂_X ((Ideal.Quotient.mk I_i).comp c_A) (Ideal.Quotient.mk I_i (Xbar j))
      let v_mv : MvPolynomial (Fin 2) R →+* Polynomial R :=
        MvPolynomial.eval₂Hom Polynomial.C (fun k : Fin 2 => if k = i then 0 else Polynomial.X)
      have hv_mv_C : ∀ r : R, v_mv (MvPolynomial.C r) = Polynomial.C r :=
        fun r => MvPolynomial.eval₂Hom_C _ _ r
      have hv_mv_X : ∀ k : Fin 2, v_mv (MvPolynomial.X k) = if k = i then 0 else Polynomial.X :=
        fun k => MvPolynomial.eval₂Hom_X' _ _ k
      have hv_mv : ∀ p ∈ I_R, v_mv p = 0 := by
        intro p hp
        rw [Ideal.mem_span_singleton] at hp
        rcases hp with ⟨q, rfl⟩
        rw [map_mul, map_sub, map_mul, MvPolynomial.C_0, map_zero, sub_zero, hv_mv_X 0, hv_mv_X 1]
        by_cases hi0 : (0 : Fin 2) = i
        · rw [if_pos hi0, zero_mul, zero_mul]
        · have h1i : (1 : Fin 2) = i := (hFin2Other 0 i (Ne.symm hi0)).symm
          rw [if_pos h1i, mul_zero, zero_mul]
      let v_0 : A_deg →+* Polynomial R := Ideal.Quotient.lift I_R v_mv hv_mv
      have hv_0 : ∀ a ∈ I_i, v_0 a = 0 := by
        intro a ha
        rw [Ideal.mem_span_singleton] at ha
        rcases ha with ⟨q, rfl⟩
        rw [map_mul]
        have hXi : v_0 (Xbar i) = 0 := by
          change v_mv (MvPolynomial.X i) = 0
          rw [hv_mv_X i, if_pos rfl]
        rw [hXi, zero_mul]
      let v_i : (A_deg ⧸ I_i) →+* Polynomial R := Ideal.Quotient.lift I_i v_0 hv_0
      have hji : j ≠ i := by fin_cases i <;> decide
      have hvu : v_i.comp u_i = RingHom.id (Polynomial R) := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun r => ?_
          change v_i (u_i (Polynomial.C r)) = Polynomial.C r
          rw [hu_i_C r]
          exact hv_mv_C r
        · change v_i (u_i Polynomial.X) = Polynomial.X
          rw [hu_i_X]
          change v_mv (MvPolynomial.X j) = Polynomial.X
          rw [hv_mv_X j, if_neg hji]
      have huv : u_i.comp v_i = RingHom.id (A_deg ⧸ I_i) := by
        apply Ideal.Quotient.ringHom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change u_i (v_mv (MvPolynomial.C r)) = Ideal.Quotient.mk I_i (c_A r)
          rw [hv_mv_C r, hu_i_C r]
        · intro k
          change u_i (v_mv (MvPolynomial.X k)) = Ideal.Quotient.mk I_i (Xbar k)
          by_cases hki : k = i
          · subst hki
            rw [hv_mv_X k, if_pos rfl, map_zero]
            symm
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          · have hkj : k = j := hFin2Other i k hki
            subst hkj
            rw [hv_mv_X j, if_neg hki, hu_i_X]
      let e_i : Polynomial R ≃+* (A_deg ⧸ I_i) :=
        { toFun := u_i
          invFun := v_i
          left_inv := fun z => RingHom.congr_fun hvu z
          right_inv := fun z => RingHom.congr_fun huv z
          map_mul' := u_i.map_mul
          map_add' := u_i.map_add }
      have hI_le_i : ∀ a ∈ I_i, ((Ideal.Quotient.mk J_i).comp ψ') a = 0 := by
        intro a ha
        rw [Ideal.mem_span_singleton] at ha
        rcases ha with ⟨q, rfl⟩
        simp only [RingHom.comp_apply, map_mul]
        have h0 : Ideal.Quotient.mk J_i (ψ' (Xbar i)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [h0, zero_mul]
      let δ_i : Polynomial R →+* (B' ⧸ J_i) :=
        (Ideal.Quotient.lift I_i ((Ideal.Quotient.mk J_i).comp ψ') hI_le_i).comp e_i.toRingHom
      have hEt_δi : δ_i.Etale := hQuotEtale ψ' hEt' I_i J_i hIJ_i e_i hI_le_i
      refine ⟨δ_i, hEt_δi, ?_, ?_⟩
      · ext r
        change (Ideal.Quotient.lift I_i ((Ideal.Quotient.mk J_i).comp ψ') hI_le_i)
          (u_i (Polynomial.C r)) = Ideal.Quotient.mk J_i (c_R r)
        rw [hu_i_C r]
        rfl
      · change (Ideal.Quotient.lift I_i ((Ideal.Quotient.mk J_i).comp ψ') hI_le_i)
          (u_i Polynomial.X) = Ideal.Quotient.mk J_i (ψ' (Xbar j))
        rw [hu_i_X]
        rfl
    · 
      let I_node : Ideal A_deg := Ideal.span {Xbar 0, Xbar 1}
      let J_node : Ideal B' := Ideal.span {x₀', x₁'}
      have hIJ_node : Ideal.map ψ' I_node = J_node := by
        rw [Ideal.map_span, Set.image_pair]
      let u_node : R →+* (A_deg ⧸ I_node) := (Ideal.Quotient.mk I_node).comp c_A
      let v_node_mv : MvPolynomial (Fin 2) R →+* R := MvPolynomial.eval₂Hom (RingHom.id R) 0
      have hv_node_C : ∀ r : R, v_node_mv (MvPolynomial.C r) = r :=
        fun r => MvPolynomial.eval₂Hom_C (RingHom.id R) 0 r
      have hv_node_X : ∀ k : Fin 2, v_node_mv (MvPolynomial.X k) = 0 :=
        fun k => MvPolynomial.eval₂Hom_X' (RingHom.id R) 0 k
      have hv_node_mv : ∀ p ∈ I_R, v_node_mv p = 0 := by
        intro p hp
        rw [Ideal.mem_span_singleton] at hp
        rcases hp with ⟨q, rfl⟩
        rw [map_mul, map_sub, map_mul, MvPolynomial.C_0, map_zero, sub_zero, hv_node_X 0, zero_mul, zero_mul]
      let v_node_0 : A_deg →+* R := Ideal.Quotient.lift I_R v_node_mv hv_node_mv
      have hv_node_ker : I_node ≤ RingHom.ker v_node_0 := by
        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · exact hv_node_X 0
        · exact hv_node_X 1
      have hv_node_0 : ∀ a ∈ I_node, v_node_0 a = 0 := fun a ha => hv_node_ker ha
      let v_node : (A_deg ⧸ I_node) →+* R := Ideal.Quotient.lift I_node v_node_0 hv_node_0
      have hvu_node : v_node.comp u_node = RingHom.id R :=
        RingHom.ext hv_node_C
      have huv_node : u_node.comp v_node = RingHom.id (A_deg ⧸ I_node) := by
        apply Ideal.Quotient.ringHom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change u_node (v_node_mv (MvPolynomial.C r)) = Ideal.Quotient.mk I_node (c_A r)
          rw [hv_node_C r]
          rfl
        · intro k
          change u_node (v_node_mv (MvPolynomial.X k)) = Ideal.Quotient.mk I_node (Xbar k)
          rw [hv_node_X k, map_zero]
          symm
          apply Ideal.Quotient.eq_zero_iff_mem.mpr
          apply Ideal.subset_span
          fin_cases k
          · exact Set.mem_insert _ _
          · exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
      let e_node : R ≃+* (A_deg ⧸ I_node) :=
        { toFun := u_node
          invFun := v_node
          left_inv := fun z => RingHom.congr_fun hvu_node z
          right_inv := fun z => RingHom.congr_fun huv_node z
          map_mul' := u_node.map_mul
          map_add' := u_node.map_add }
      have hI_le_node_ker : I_node ≤ RingHom.ker ((Ideal.Quotient.mk J_node).comp ψ') := by
        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · change Ideal.Quotient.mk J_node x₀' = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
        · change Ideal.Quotient.mk J_node x₁' = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      have hI_le_node : ∀ a ∈ I_node, ((Ideal.Quotient.mk J_node).comp ψ') a = 0 :=
        fun a ha => hI_le_node_ker ha
      have hEt_comp := hQuotEtale ψ' hEt' I_node J_node hIJ_node e_node hI_le_node
      have heq_node : (Ideal.Quotient.lift I_node ((Ideal.Quotient.mk J_node).comp ψ') hI_le_node).comp
          e_node.toRingHom = (Ideal.Quotient.mk J_node).comp c_R := by
        ext r
        rfl
      rwa [heq_node] at hEt_comp

  
  have hPrimeBot : ∀ (R D : Type u) [CommRing R] [IsDomain R] [CommRing D] [IsDomain D]
      (δ : Polynomial R →+* D),
      δ.Etale →
      ∀ (p q : Ideal D) [p.IsPrime] [q.IsPrime],
        p < q →
        p.comap (δ.comp Polynomial.C) = ⊥ →
        q.comap (δ.comp Polynomial.C) = ⊥ →
        p = ⊥ := by
    intro R D _ _ _ _ δ hEt_δ p q _ _ hp_lt_q hp_cR hq_cR
    let A := Polynomial R
    letI : Algebra A D := δ.toAlgebra
    haveI : Algebra.Etale A D := RingHom.Etale.toAlgebra hEt_δ
    have hInj_δ : Function.Injective δ := FaithfulSMul.algebraMap_injective A D
    have hFiberIncomp : ∀ (p₁ p₂ : Ideal D) [p₁.IsPrime] [p₂.IsPrime],
        p₁ ≤ p₂ → p₁.comap δ = p₂.comap δ → p₁ = p₂ := by
      intro p₁ p₂ _ _ hp₁₂ hcomap
      let r : Ideal A := p₂.comap δ
      haveI : r.IsPrime := Ideal.IsPrime.comap δ
      haveI : p₂.LiesOver r := ⟨rfl⟩
      let A_r := Localization.AtPrime r
      let D_p₂ := Localization.AtPrime p₂
      letI : Algebra A_r D_p₂ := Localization.AtPrime.algebraOfLiesOver r p₂
      haveI : Algebra.FormallyUnramified A D_p₂ :=
        Algebra.FormallyUnramified.instLocalization p₂.primeCompl
      haveI : Algebra.FormallyUnramified A_r D_p₂ :=
        Algebra.FormallyUnramified.localization_base r.primeCompl
      haveI : Algebra.EssFiniteType D D_p₂ :=
        Algebra.EssFiniteType.of_isLocalization D_p₂ p₂.primeCompl
      haveI : Algebra.EssFiniteType A D_p₂ :=
        Algebra.EssFiniteType.comp A D D_p₂
      have hEss_AD : (algebraMap A D_p₂).EssFiniteType :=
        (RingHom.essFiniteType_algebraMap).mpr inferInstance
      rw [IsScalarTower.algebraMap_eq A A_r D_p₂] at hEss_AD
      have hEss_ArD : (algebraMap A_r D_p₂).EssFiniteType :=
        RingHom.EssFiniteType.of_comp (algebraMap A A_r) hEss_AD
      haveI : Algebra.EssFiniteType A_r D_p₂ :=
        (RingHom.essFiniteType_algebraMap).mp hEss_ArD
      have hmax_map : Ideal.map (algebraMap A_r D_p₂) (IsLocalRing.maximalIdeal A_r) =
          IsLocalRing.maximalIdeal D_p₂ :=
        Algebra.FormallyUnramified.map_maximalIdeal
      have hr_max : Ideal.map (algebraMap A A_r) r = IsLocalRing.maximalIdeal A_r :=
        IsLocalization.AtPrime.map_eq_maximalIdeal r A_r
      have hp₂_max : Ideal.map (algebraMap D D_p₂) p₂ = IsLocalRing.maximalIdeal D_p₂ :=
        IsLocalization.AtPrime.map_eq_maximalIdeal p₂ D_p₂
      have hmap_r : Ideal.map (algebraMap D D_p₂) (Ideal.map δ r) = IsLocalRing.maximalIdeal D_p₂ := by
        have h1 : Ideal.map (algebraMap A_r D_p₂) (Ideal.map (algebraMap A A_r) r) =
            IsLocalRing.maximalIdeal D_p₂ := by
          rw [hr_max, hmax_map]
        rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq A A_r D_p₂,
          IsScalarTower.algebraMap_eq A D D_p₂, ← Ideal.map_map] at h1
        exact h1
      have hr_le_p₁ : Ideal.map δ r ≤ p₁ := by
        have hr_eq : r = p₁.comap δ := hcomap.symm
        rw [hr_eq]
        exact Ideal.map_comap_le
      have hp₁_max : Ideal.map (algebraMap D D_p₂) p₁ = IsLocalRing.maximalIdeal D_p₂ := by
        apply le_antisymm
        · rw [← hp₂_max]
          exact Ideal.map_mono hp₁₂
        · rw [← hmap_r]
          exact Ideal.map_mono hr_le_p₁
      apply le_antisymm hp₁₂
      intro x hx
      have hx_mem : algebraMap D D_p₂ x ∈ Ideal.map (algebraMap D D_p₂) p₁ := by
        rw [hp₁_max, ← hp₂_max]
        exact Ideal.mem_map_of_mem (algebraMap D D_p₂) hx
      rw [IsLocalization.algebraMap_mem_map_algebraMap_iff p₂.primeCompl D_p₂ p₁ x] at hx_mem
      rcases hx_mem with ⟨m, hm_not_p₂, hmx⟩
      have hm_not_p₁ : m ∉ p₁ := fun hm => hm_not_p₂ (hp₁₂ hm)
      exact ( ‹p₁.IsPrime›.mul_mem_iff_mem_or_mem.mp hmx ).resolve_left hm_not_p₁
    by_contra hp_ne_bot
    haveI : (⊥ : Ideal D).IsPrime :=
      ⟨bot_ne_top, fun {x y} hxy => by
        simp only [Ideal.mem_bot] at hxy ⊢
        exact mul_eq_zero.mp hxy⟩
    have hbot_comap : (⊥ : Ideal D).comap δ = ⊥ := by
      rw [← RingHom.ker_eq_comap_bot]
      exact (RingHom.injective_iff_ker_eq_bot δ).mp hInj_δ
    let r₁ : Ideal A := p.comap δ
    let r₂ : Ideal A := q.comap δ
    haveI : r₁.IsPrime := Ideal.IsPrime.comap δ
    haveI : r₂.IsPrime := Ideal.IsPrime.comap δ
    have hr₁_ne_bot : r₁ ≠ ⊥ := by
      intro hr₁_bot
      have := hFiberIncomp ⊥ p bot_le (hbot_comap.trans hr₁_bot.symm)
      exact hp_ne_bot this.symm
    have hr₁_lt_r₂ : r₁ < r₂ := by
      refine lt_of_le_of_ne (Ideal.comap_mono hp_lt_q.le) ?_
      intro hr₁₂
      exact hp_lt_q.ne (hFiberIncomp p q hp_lt_q.le hr₁₂)
    let M : Submonoid A := Submonoid.map Polynomial.C (nonZeroDivisors R)
    have hDisj₁ : Disjoint (M : Set A) (r₁ : Set A) := by
      rw [Set.disjoint_left]
      rintro _ ⟨a, ha_nzd, rfl⟩ ha_r₁
      have ha_ne : a ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha_nzd
      have ha_bot : a ∈ p.comap (δ.comp Polynomial.C) := ha_r₁
      rw [hp_cR, Ideal.mem_bot] at ha_bot
      exact ha_ne ha_bot
    have hDisj₂ : Disjoint (M : Set A) (r₂ : Set A) := by
      rw [Set.disjoint_left]
      rintro _ ⟨a, ha_nzd, rfl⟩ ha_r₂
      have ha_ne : a ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha_nzd
      have ha_bot : a ∈ q.comap (δ.comp Polynomial.C) := ha_r₂
      rw [hq_cR, Ideal.mem_bot] at ha_bot
      exact ha_ne ha_bot
    let K := FractionRing R
    letI : Algebra A (Polynomial K) :=
      (Polynomial.mapRingHom (algebraMap R K)).toAlgebra
    haveI : IsLocalization M (Polynomial K) :=
      Polynomial.isLocalization (nonZeroDivisors R) K
    let R₁ : Ideal (Polynomial K) := Ideal.map (algebraMap A (Polynomial K)) r₁
    let R₂ : Ideal (Polynomial K) := Ideal.map (algebraMap A (Polynomial K)) r₂
    haveI : R₁.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M (Polynomial K) r₁ ‹_› hDisj₁
    haveI : R₂.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M (Polynomial K) r₂ ‹_› hDisj₂
    have hR₁_comap : R₁.comap (algebraMap A (Polynomial K)) = r₁ :=
      IsLocalization.comap_map_of_isPrime_disjoint M (Polynomial K) ‹_› hDisj₁
    have hR₂_comap : R₂.comap (algebraMap A (Polynomial K)) = r₂ :=
      IsLocalization.comap_map_of_isPrime_disjoint M (Polynomial K) ‹_› hDisj₂
    have hR₁_ne_bot : R₁ ≠ ⊥ := by
      intro hR₁_bot
      apply hr₁_ne_bot
      rw [← hR₁_comap, hR₁_bot, ← RingHom.ker_eq_comap_bot]
      exact (RingHom.injective_iff_ker_eq_bot _).mp
        (Polynomial.map_injective (algebraMap R K) (IsFractionRing.injective R K))
    have hR₁_max : R₁.IsMaximal := _root_.IsPrime.to_maximal_ideal hR₁_ne_bot
    have hR₁_eq_R₂ : R₁ = R₂ :=
      hR₁_max.eq_of_le ( ‹R₂.IsPrime›.ne_top ) (Ideal.map_mono hr₁_lt_r₂.le)
    have hr₁_eq_r₂ : r₁ = r₂ := by
      rw [← hR₁_comap, hR₁_eq_R₂, hR₂_comap]
    exact hr₁_lt_r₂.ne hr₁_eq_r₂

  
  have hGoingDownLift : ∀ (C : Type u) [CommRing C] (φ : ↥W₀ →+* C),
      φ.Etale →
      ∀ (q : Ideal C) [q.IsPrime],
        q.comap φ = IsLocalRing.maximalIdeal ↥W₀ →
        ∃ (p : Ideal C) (_ : p.IsPrime) (α_L : C →+* L),
          p ≤ q ∧
          p.comap φ = ⊥ ∧
          α_L.comp φ = W₀.subtype ∧
          RingHom.ker α_L = p := by
    intro C _ φ hEt_φ q _ hq_comap
    letI : Algebra ↥W₀ C := φ.toAlgebra
    haveI : Algebra.Etale ↥W₀ C := RingHom.Etale.toAlgebra hEt_φ
    haveI : Algebra.HasGoingDown ↥W₀ C := Algebra.HasGoingDown.of_flat
    haveI : (⊥ : Ideal ↥W₀).IsPrime :=
      ⟨bot_ne_top, fun {x y} hxy => by
        simp only [Ideal.mem_bot] at hxy ⊢
        exact mul_eq_zero.mp hxy⟩
    have hlt_under : (⊥ : Ideal ↥W₀) < Ideal.under ↥W₀ q := by
      change (⊥ : Ideal ↥W₀) < q.comap φ
      rw [hq_comap]
      exact bot_lt_iff_ne_bot.mpr hMax_W₀
    obtain ⟨p, hp_le_q, hp_prime, hp_over⟩ :=
      Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt (p := (⊥ : Ideal ↥W₀)) q hlt_under
    haveI : p.IsPrime := hp_prime
    have hp_comap : p.comap φ = ⊥ := hp_over.over.symm
    let K_p := p.ResidueField
    let π_p : C →+* K_p := algebraMap C K_p
    have hker_π : RingHom.ker π_p = p := Ideal.ker_algebraMap_residueField p
    let φ_K : ↥W₀ →+* K_p := π_p.comp φ
    have hu_nzd : ∀ y : nonZeroDivisors ↥W₀, IsUnit (φ_K y) := by
      intro y
      have hy_ne : (y : ↥W₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      refine IsUnit.mk0 (φ_K y) ?_
      intro h0
      have hmem_p : φ y ∈ p := by
        rw [← hker_π, RingHom.mem_ker]
        exact h0
      have hmem_bot : (y : ↥W₀) ∈ p.comap φ := hmem_p
      rw [hp_comap, Ideal.mem_bot] at hmem_bot
      exact hy_ne hmem_bot
    let ι_L : L →+* K_p := IsLocalization.lift (M := nonZeroDivisors ↥W₀) (S := L) hu_nzd
    have hι_comp : ι_L.comp W₀.subtype = φ_K :=
      RingHom.ext fun w => IsLocalization.lift_eq (M := nonZeroDivisors ↥W₀) (S := L) hu_nzd w
    letI : Algebra L K_p := ι_L.toAlgebra
    haveI : IsScalarTower ↥W₀ L K_p :=
      IsScalarTower.of_algebraMap_eq' hι_comp.symm
    let C_p := Localization.AtPrime p
    haveI : Algebra.FormallyUnramified ↥W₀ C_p :=
      Algebra.FormallyUnramified.instLocalization p.primeCompl
    let res_alg : C_p →ₐ[↥W₀] K_p := IsScalarTower.toAlgHom ↥W₀ C_p K_p
    have hres_surj : Function.Surjective res_alg := IsLocalRing.residue_surjective
    haveI : Algebra.FormallyUnramified ↥W₀ K_p :=
      Algebra.FormallyUnramified.of_surjective res_alg hres_surj
    haveI : Algebra.FormallyUnramified L K_p :=
      Algebra.FormallyUnramified.localization_base (nonZeroDivisors ↥W₀)
    haveI : Algebra.EssFiniteType C C_p :=
      Algebra.EssFiniteType.of_isLocalization C_p p.primeCompl
    haveI : Algebra.EssFiniteType ↥W₀ C_p :=
      Algebra.EssFiniteType.comp ↥W₀ C C_p
    have hEss_WCp : (algebraMap ↥W₀ C_p).EssFiniteType :=
      (RingHom.essFiniteType_algebraMap).mpr inferInstance
    have hEss_CpKp : (algebraMap C_p K_p).EssFiniteType :=
      (RingHom.FiniteType.of_surjective (algebraMap C_p K_p) IsLocalRing.residue_surjective).essFiniteType
    have hEss_WKp : (algebraMap ↥W₀ K_p).EssFiniteType := by
      rw [IsScalarTower.algebraMap_eq ↥W₀ C_p K_p]
      exact RingHom.EssFiniteType.comp hEss_WCp hEss_CpKp
    rw [IsScalarTower.algebraMap_eq ↥W₀ L K_p] at hEss_WKp
    have hEss_LKp : (algebraMap L K_p).EssFiniteType :=
      RingHom.EssFiniteType.of_comp (algebraMap ↥W₀ L) hEss_WKp
    haveI : Algebra.EssFiniteType L K_p :=
      (RingHom.essFiniteType_algebraMap).mp hEss_LKp
    have hBij_ι : Function.Bijective ι_L :=
      Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing L K_p
    let e_L : L ≃+* K_p := RingEquiv.ofBijective ι_L hBij_ι
    let α_L : C →+* L := e_L.symm.toRingHom.comp π_p
    refine ⟨p, hp_prime, α_L, hp_le_q, hp_comap, ?_, ?_⟩
    · ext w
      change e_L.symm (φ_K w) = W₀.subtype w
      have hw : φ_K w = e_L (W₀.subtype w) := (RingHom.congr_fun hι_comp w).symm
      rw [hw, e_L.symm_apply_apply]
    · ext c
      simp only [RingHom.mem_ker, ← hker_π, α_L, RingHom.comp_apply]
      exact ⟨fun h => by
        have := congrArg e_L h
        simpa using this,
        fun h => by simp [h]⟩

  
  intro I₀ x₀ x₁ c_W
  obtain ⟨hAway, hQuot, hNodeEt⟩ := hTransfers ↥W₀ B ψ hEt
  refine ⟨⟨hAway, fun i => let ⟨δ_i, hEt_δi, _, _⟩ := hQuot i; ⟨δ_i, hEt_δi⟩⟩, ?_⟩
  intro hDom₀ hDom₁ 𝔓 𝔔 _ _ hx₀_𝔓 h𝔓_lt_𝔔 h𝔓_cW h𝔔_cW
  
  let D₀ := B ⧸ Ideal.span {x₀}
  let mk₀ : B →+* D₀ := Ideal.Quotient.mk (Ideal.span {x₀})
  obtain ⟨δ₀, hEt_δ₀, hδ₀_C, _⟩ := hQuot 0
  have hker₀_le_𝔓 : RingHom.ker mk₀ ≤ 𝔓 := by
    rw [Ideal.mk_ker]
    exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx₀_𝔓)
  have hker₀_le_𝔔 : RingHom.ker mk₀ ≤ 𝔔 := hker₀_le_𝔓.trans h𝔓_lt_𝔔.le
  let p_bar : Ideal D₀ := 𝔓.map mk₀
  let q_bar : Ideal D₀ := 𝔔.map mk₀
  haveI : p_bar.IsPrime := 𝔓.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker₀_le_𝔓
  haveI : q_bar.IsPrime := 𝔔.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker₀_le_𝔔
  have hp_bar_comap : p_bar.comap mk₀ = 𝔓 := by
    rw [Ideal.comap_map_of_surjective' mk₀ Ideal.Quotient.mk_surjective]
    exact sup_eq_left.mpr hker₀_le_𝔓
  have hq_bar_comap : q_bar.comap mk₀ = 𝔔 := by
    rw [Ideal.comap_map_of_surjective' mk₀ Ideal.Quotient.mk_surjective]
    exact sup_eq_left.mpr hker₀_le_𝔔
  have hp_lt_q_bar : p_bar < q_bar := by
    refine lt_of_le_of_ne (Ideal.map_mono h𝔓_lt_𝔔.le) ?_
    intro heq
    have : 𝔓 = 𝔔 := by rw [← hp_bar_comap, heq, hq_bar_comap]
    exact h𝔓_lt_𝔔.ne this
  have hp_bar_cW : p_bar.comap (δ₀.comp Polynomial.C) = ⊥ := by
    rw [hδ₀_C, ← Ideal.comap_comap, hp_bar_comap, h𝔓_cW]
  have hq_bar_cW : q_bar.comap (δ₀.comp Polynomial.C) = ⊥ := by
    rw [hδ₀_C, ← Ideal.comap_comap, hq_bar_comap, h𝔔_cW]
  have hp_bar_bot : p_bar = ⊥ :=
    hPrimeBot ↥W₀ D₀ δ₀ hEt_δ₀ p_bar q_bar hp_lt_q_bar hp_bar_cW hq_bar_cW
  have h𝔓_eq : 𝔓 = Ideal.span {x₀} := by
    rw [← hp_bar_comap, hp_bar_bot, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  let e_br : D₀ ≃+* (B ⧸ 𝔓) := Ideal.quotEquivOfEq h𝔓_eq.symm
  let γ_br : Polynomial ↥W₀ →+* (B ⧸ 𝔓) := e_br.toRingHom.comp δ₀
  have hEt_γbr : γ_br.Etale := hEtaleComp hEt_δ₀ (hEtaleEquiv e_br)
  have hγbr_C : γ_br.comp Polynomial.C = (Ideal.Quotient.mk 𝔓).comp c_W := by
    rw [RingHom.comp_assoc, hδ₀_C]
    ext w
    rfl
  refine ⟨⟨h𝔓_eq, γ_br, hEt_γbr, hγbr_C⟩, ?_⟩
  
  intro 𝔮 _ hx₀_𝔮 hx₁_𝔮 h𝔮_cW
  let J_node : Ideal B := Ideal.span {x₀, x₁}
  let C_node := B ⧸ J_node
  let mk_node : B →+* C_node := Ideal.Quotient.mk J_node
  let c_node : ↥W₀ →+* C_node := mk_node.comp c_W
  have hker_node_le_𝔮 : RingHom.ker mk_node ≤ 𝔮 := by
    rw [Ideal.mk_ker, Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact hx₀_𝔮
    · exact hx₁_𝔮
  let q_node : Ideal C_node := 𝔮.map mk_node
  haveI : q_node.IsPrime := 𝔮.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_node_le_𝔮
  have hq_node_comap : q_node.comap mk_node = 𝔮 := by
    rw [Ideal.comap_map_of_surjective' mk_node Ideal.Quotient.mk_surjective]
    exact sup_eq_left.mpr hker_node_le_𝔮
  have hq_node_cnode : q_node.comap c_node = IsLocalRing.maximalIdeal ↥W₀ := by
    change q_node.comap (mk_node.comp c_W) = _
    rw [← Ideal.comap_comap, hq_node_comap, h𝔮_cW]
  obtain ⟨p_node, hp_node_prime, α_L, hp_le_qnode, hp_cnode, hα_cnode, hker_α⟩ :=
    hGoingDownLift C_node c_node hNodeEt q_node hq_node_cnode
  haveI : p_node.IsPrime := hp_node_prime
  let 𝔭_b : Ideal B := p_node.comap mk_node
  have h𝔭b_prime : 𝔭_b.IsPrime := Ideal.IsPrime.comap mk_node
  let β_L : B →+* L := α_L.comp mk_node
  have hJ_le_𝔭b : J_node ≤ 𝔭_b := by
    intro b hb
    change mk_node b ∈ p_node
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb]
    exact p_node.zero_mem
  have h𝔓_le_𝔭b : 𝔓 ≤ 𝔭_b := by
    rw [h𝔓_eq]
    exact (Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))).trans hJ_le_𝔭b
  have h𝔭b_le_𝔮 : 𝔭_b ≤ 𝔮 := by
    rw [← hq_node_comap]
    exact Ideal.comap_mono hp_le_qnode
  have h𝔭b_cW : 𝔭_b.comap c_W = ⊥ := by
    change (p_node.comap mk_node).comap c_W = ⊥
    rw [Ideal.comap_comap]
    exact hp_cnode
  have hβ_cW : β_L.comp c_W = W₀.subtype := by
    change (α_L.comp mk_node).comp c_W = W₀.subtype
    rw [RingHom.comp_assoc]
    exact hα_cnode
  have hker_β : RingHom.ker β_L = 𝔭_b := by
    ext b
    change α_L (mk_node b) = 0 ↔ mk_node b ∈ p_node
    rw [← RingHom.mem_ker, hker_α]
  let 𝔮₁ : Ideal B := Ideal.span {x₁}
  let D₁ := B ⧸ 𝔮₁
  let mk₁ : B →+* D₁ := Ideal.Quotient.mk 𝔮₁
  have h𝔮₁_prime : 𝔮₁.IsPrime := (Ideal.Quotient.isDomain_iff_prime 𝔮₁).mp hDom₁
  have h𝔮₁_le_𝔭b : 𝔮₁ ≤ 𝔭_b :=
    (Ideal.span_mono (Set.singleton_subset_iff.mpr
      (Set.mem_insert_of_mem _ (Set.mem_singleton _)))).trans hJ_le_𝔭b
  obtain ⟨δ₁, hEt_δ₁, hδ₁_C, hδ₁_X⟩ := hQuot 1
  letI : Algebra (Polynomial ↥W₀) D₁ := δ₁.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W₀) D₁ := RingHom.Etale.toAlgebra hEt_δ₁
  have hInj_δ₁ : Function.Injective δ₁ :=
    FaithfulSMul.algebraMap_injective (Polynomial ↥W₀) D₁
  have h𝔮₁_cW : 𝔮₁.comap c_W = ⊥ := by
    rw [eq_bot_iff]
    intro w hw
    rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem] at hw
    have hCw : δ₁ (Polynomial.C w) = 0 := by
      have h1 : δ₁ (Polynomial.C w) = mk₁ (c_W w) := RingHom.congr_fun hδ₁_C w
      rw [h1, hw]
    rw [← map_zero δ₁] at hCw
    have hCw0 : (Polynomial.C w : Polynomial ↥W₀) = 0 := hInj_δ₁ hCw
    exact Ideal.mem_bot.mpr (Polynomial.C_eq_zero.mp hCw0)
  have hx₀_not_𝔮₁ : x₀ ∉ 𝔮₁ := by
    intro hx₀_in
    have hmk0 : mk₁ x₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hx₀_in
    have hδX : δ₁ Polynomial.X = 0 := by
      have hX_eq : δ₁ Polynomial.X = mk₁ x₀ := hδ₁_X
      rw [hX_eq, hmk0]
    rw [← map_zero δ₁] at hδX
    exact Polynomial.X_ne_zero (hInj_δ₁ hδX)
  exact ⟨𝔭_b, 𝔮₁, h𝔭b_prime, h𝔮₁_prime, β_L,
    h𝔓_le_𝔭b, h𝔭b_le_𝔮, h𝔭b_cW, hβ_cW, hker_β,
    h𝔮₁_le_𝔭b, h𝔮₁_cW, hx₀_not_𝔮₁⟩

theorem weil_rankOne_schematic_image_integral_and_generic_affine_dichotomy (K : Type u) [Field K] (V : ValuationSubring K)
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (Q_b : PrimeSpectrum ↥V)
    (hAlg_L : IsAlgClosed Q_b.asIdeal.ResidueField)
    (W₀ : ValuationSubring Q_b.asIdeal.ResidueField)
    (hMax_W₀ : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1_W₀ : ∀ P' : PrimeSpectrum ↥W₀,
      P'.asIdeal = ⊥ ∨ P'.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (ρ_V : ↥V →+* ↥W₀)
    (hρ_sub : W₀.subtype.comp ρ_V = algebraMap ↥V Q_b.asIdeal.ResidueField)
    (E_cur : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))))
    (hE_irred : E_cur ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))))
    (E_sch : AlgebraicGeometry.Scheme.{u})
    (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).left)
    (hCl_E : AlgebraicGeometry.IsClosedImmersion ιE)
    (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
    (hRange_E : Set.range ιE.base = E_cur)
    (u_gen : CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ⟶
      CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)))
    (hu_fst : u_gen ≫ CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (hu_snd : u_gen ≫ CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) :
    let s_b := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))
    let ι_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)
    let X_W0 := CategoryTheory.Limits.pullback g_cur ι_W0
    let ℰ := AlgebraicGeometry.Scheme.Hom.image (ιE ≫ u_gen)
    let ι_ℰ := AlgebraicGeometry.Scheme.Hom.imageι (ιE ≫ u_gen)
    AlgebraicGeometry.IsIntegral ℰ ∧
    AlgebraicGeometry.IsOpenImmersion u_gen ∧
    Set.range u_gen.base =
      {x : ↥X_W0 | ((CategoryTheory.Limits.pullback.snd g_cur ι_W0).base x).asIdeal = ⊥} ∧
    (∀ q_b : ↥(CategoryTheory.Limits.pullback g_cur s_b),
      u_gen.base q_b ∈ Set.range ι_ℰ.base ↔ q_b ∈ E_cur) ∧
    (∀ (U_X : X_W0.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
        (z : ↥ℰ) (hz : ι_ℰ.base z ∈ U_X),
      let B := ↑(X_W0.presheaf.obj (Opposite.op U_X))
      let 𝔓 : Ideal B := ((ιE ≫ u_gen).ker).ideal ⟨U_X, hUX⟩
      let W_ℰ : ℰ.Opens := (TopologicalSpace.Opens.map ι_ℰ.base).obj U_X
      (IsDomain B →
        (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base ∧
        ∃ iso_W : W_ℰ.toScheme ≅ U_X.toScheme,
          iso_W.hom ≫ U_X.ι = W_ℰ.ι ≫ ι_ℰ) ∧
      (𝔓 ≤ (hUX.primeIdealOf ⟨ι_ℰ.base z, hz⟩).asIdeal ∧
        𝔓.IsPrime ∧
        (∀ c_W : ↥W₀ →+* B,
          hUX.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) →
          𝔓.comap c_W = ⊥ ∧
          ∃ 𝔔 : Ideal B, 𝔔.IsPrime ∧ 𝔓 < 𝔔 ∧ 𝔔.comap c_W = ⊥) ∧
        (∀ p : PrimeSpectrum B, hUX.fromSpec.base p ∈ Set.range ι_ℰ.base ↔ 𝔓 ≤ p.asIdeal) ∧
        ∃ iso_sub : W_ℰ.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ 𝔓)),
          W_ℰ.ι ≫ ι_ℰ =
            iso_sub.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓)) ≫
                hUX.fromSpec)) :=
by
  classical
  intro s_b ι_W0 X_W0 ℰ ι_ℰ
  let L := Q_b.asIdeal.ResidueField
  have _ : IsAlgClosed L := hAlg_L
  let Y_b := CategoryTheory.Limits.pullback g_cur s_b
  let η_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)
  have _ : AlgebraicGeometry.IsClosedImmersion ιE := hCl_E
  have _ : AlgebraicGeometry.IsIntegral E_sch := hInt_E
  have _ : AlgebraicGeometry.IsReduced E_sch := inferInstance

  
  have hex_π : ∃ π₀ : ↥W₀, π₀ ∈ IsLocalRing.maximalIdeal ↥W₀ ∧ π₀ ≠ 0 := by
    by_contra! hall0
    apply hMax_W₀
    rw [eq_bot_iff]
    intro x hx
    rw [Ideal.mem_bot]
    exact hall0 x hx
  obtain ⟨π₀, hπ₀_mem, hπ₀_ne⟩ := hex_π
  have hOpen_η : AlgebraicGeometry.IsOpenImmersion η_W0 := by
    let _ : Algebra ↥W₀ L := W₀.subtype.toAlgebra
    have _ : IsLocalization.Away π₀ L := by
      refine IsLocalization.Away.mk π₀ ?_ ?_ ?_
      · exact IsUnit.mk0 (W₀.subtype π₀) (fun h => hπ₀_ne (Subtype.val_injective h))
      · intro z
        by_cases hzW : z ∈ W₀
        · exact ⟨0, ⟨z, hzW⟩, by simp; rfl⟩
        · have hz0 : z ≠ 0 := fun h => hzW (h ▸ W₀.zero_mem)
          have hz_inv : z⁻¹ ∈ W₀ := (ValuationSubring.mem_or_inv_mem W₀ z).resolve_left hzW
          let w : ↥W₀ := ⟨z⁻¹, hz_inv⟩
          have hw_ne : w ≠ 0 := fun h => inv_ne_zero hz0 (congrArg Subtype.val h)
          have hπ₀_rad : π₀ ∈ (Ideal.span ({w} : Set ↥W₀)).radical := by
            rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
            rintro I ⟨hwI, hI_prime⟩
            rw [Ideal.span_singleton_le_iff_mem] at hwI
            rcases hRank1_W₀ ⟨I, hI_prime⟩ with hbot | hmax
            · exfalso
              change I = ⊥ at hbot
              rw [hbot, Ideal.mem_bot] at hwI
              exact hw_ne hwI
            · change I = IsLocalRing.maximalIdeal ↥W₀ at hmax
              rw [hmax]
              exact hπ₀_mem
          rw [Ideal.mem_radical_iff] at hπ₀_rad
          obtain ⟨r_exp, hr_exp⟩ := hπ₀_rad
          rw [Ideal.mem_span_singleton] at hr_exp
          obtain ⟨c, hc⟩ := hr_exp
          refine ⟨r_exp, c, ?_⟩
          have hval : (π₀ : L) ^ r_exp = z⁻¹ * (c : L) := by
            have := congrArg Subtype.val hc
            simpa [w] using this
          calc z * W₀.subtype π₀ ^ r_exp
              = z * (z⁻¹ * (c : L)) := by
                change z * (π₀ : L) ^ r_exp = z * (z⁻¹ * (c : L))
                rw [hval]
            _ = W₀.subtype c := by
                rw [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
                rfl
      · intro x y hxy
        exact ⟨0, by simp [Subtype.val_injective hxy]⟩
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := L) π₀
  have _ : AlgebraicGeometry.IsOpenImmersion η_W0 := hOpen_η
  have hAff_η : AlgebraicGeometry.IsAffineHom η_W0 :=
    AlgebraicGeometry.isAffineHom_of_isAffine η_W0

  
  have hη_ι : η_W0 ≫ ι_W0 = s_b := by
    dsimp [η_W0, ι_W0, s_b, L]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hρ_sub]
  have hPb_outer : CategoryTheory.IsPullback
      (u_gen ≫ CategoryTheory.Limits.pullback.fst g_cur ι_W0)
      (CategoryTheory.Limits.pullback.snd g_cur s_b)
      g_cur
      (η_W0 ≫ ι_W0) := by
    rw [hu_fst, hη_ι]
    exact CategoryTheory.IsPullback.of_hasPullback g_cur s_b
  have hPb_bot : CategoryTheory.IsPullback
      u_gen
      (CategoryTheory.Limits.pullback.snd g_cur s_b)
      (CategoryTheory.Limits.pullback.snd g_cur ι_W0)
      η_W0 :=
    CategoryTheory.IsPullback.of_right hPb_outer hu_snd
      (CategoryTheory.IsPullback.of_hasPullback g_cur ι_W0)
  have hOpen_ugen : AlgebraicGeometry.IsOpenImmersion u_gen :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot.flip hOpen_η
  have hAff_ugen : AlgebraicGeometry.IsAffineHom u_gen :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot.flip hAff_η
  have _ : AlgebraicGeometry.IsOpenImmersion u_gen := hOpen_ugen
  have _ : AlgebraicGeometry.IsAffineHom u_gen := hAff_ugen
  have _ : AlgebraicGeometry.IsAffineHom (ιE ≫ u_gen) := inferInstance
  have _ : AlgebraicGeometry.QuasiCompact (ιE ≫ u_gen) := inferInstance

  have hRange_ugen : Set.range u_gen.base =
      {x : ↥X_W0 | ((CategoryTheory.Limits.pullback.snd g_cur ι_W0).base x).asIdeal = ⊥} := by
    have hker_sub : RingHom.ker W₀.subtype = ⊥ :=
      (RingHom.injective_iff_ker_eq_bot W₀.subtype).mp Subtype.val_injective
    ext x
    constructor
    · rintro ⟨q_b, rfl⟩
      change ((u_gen ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0).base q_b).asIdeal = ⊥
      rw [hu_snd]
      let pt : PrimeSpectrum L := (CategoryTheory.Limits.pullback.snd g_cur s_b).base q_b
      have hpt_bot : pt.asIdeal = ⊥ := by
        rw [eq_bot_iff]
        intro a ha
        rw [Ideal.mem_bot]
        by_contra ha0
        exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem pt.asIdeal ha (IsUnit.mk0 a ha0))
      change pt.asIdeal.comap W₀.subtype = ⊥
      rw [hpt_bot, ← RingHom.ker_eq_comap_bot, hker_sub]
    · intro hx
      change ((CategoryTheory.Limits.pullback.snd g_cur ι_W0).base x).asIdeal = ⊥ at hx
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := (⊥ : PrimeSpectrum L)
      have h_eq : (CategoryTheory.Limits.pullback.snd g_cur ι_W0).base x = η_W0.base pt₀ := by
        apply PrimeSpectrum.ext
        rw [hx]
        change (⊥ : Ideal ↥W₀) = (⊥ : Ideal L).comap W₀.subtype
        rw [← RingHom.ker_eq_comap_bot, hker_sub]
      obtain ⟨q_b, hq_b, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_bot x pt₀ h_eq
      exact ⟨q_b, hq_b⟩

  
  have hPb_mono : CategoryTheory.IsPullback ιE (𝟙 E_sch) u_gen (ιE ≫ u_gen) := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk
        (by rw [CategoryTheory.Category.id_comp])
        (fun s => s.snd)
        (fun s => (CategoryTheory.cancel_mono u_gen).mp ?_)
        (fun s => CategoryTheory.Category.comp_id s.snd)
        (fun s m _ hm => by simpa using hm))
    rw [CategoryTheory.Category.assoc]
    exact s.condition.symm
  have hker_comap : (ι_ℰ.ker).comap u_gen = ιE.ker := by
    have h1 : ((ιE ≫ u_gen).ker).comap u_gen = ιE.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ext_iff]
      ext W : 1
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
        AlgebraicGeometry.Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
          (ιE ≫ u_gen) ιE (𝟙 E_sch) u_gen hPb_mono W]
    have h2 : ι_ℰ.ker = (ιE ≫ u_gen).ker :=
      AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι (ιE ≫ u_gen).ker
    rw [h2, h1]
  have hPb_top : CategoryTheory.IsPullback
      ιE (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)) u_gen ι_ℰ :=
    AlgebraicGeometry.isPullback_of_isClosedImmersion
      ιE ι_ℰ (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)) u_gen
      (AlgebraicGeometry.Scheme.Hom.toImage_imageι (ιE ≫ u_gen)).symm
      hker_comap
  have hGen_iff : ∀ q_b : ↥(CategoryTheory.Limits.pullback g_cur s_b),
      u_gen.base q_b ∈ Set.range ι_ℰ.base ↔ q_b ∈ E_cur := by
    intro q_b
    constructor
    · rintro ⟨z, hz⟩
      obtain ⟨w, hw, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_top q_b z hz.symm
      rw [← hRange_E]
      exact ⟨w, hw⟩
    · intro hq
      rw [← hRange_E] at hq
      rcases hq with ⟨w, rfl⟩
      refine ⟨(AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).base w, ?_⟩
      exact congrArg (fun φ => φ.base w)
        (AlgebraicGeometry.Scheme.Hom.toImage_imageι (ιE ≫ u_gen))

  
  have hDom_toImg : AlgebraicGeometry.IsDominant
      (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)) := inferInstance
  have hDense : DenseRange (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).base :=
    hDom_toImg.denseRange

  have hSubChart : ∀ (U_X : X_W0.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X),
      let B := ↑(X_W0.presheaf.obj (Opposite.op U_X))
      let 𝔓 : Ideal B := ((ιE ≫ u_gen).ker).ideal ⟨U_X, hUX⟩
      let W_ℰ : ℰ.Opens := (TopologicalSpace.Opens.map ι_ℰ.base).obj U_X
      𝔓 = RingHom.ker ((ιE ≫ u_gen).app U_X).hom ∧
      (∀ p : PrimeSpectrum B, hUX.fromSpec.base p ∈ Set.range ι_ℰ.base ↔ 𝔓 ≤ p.asIdeal) ∧
      (∃ iso_sub : W_ℰ.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ 𝔓)),
        W_ℰ.ι ≫ ι_ℰ =
          iso_sub.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓)) ≫
              hUX.fromSpec) ∧
      (∀ z : ↥ℰ, ι_ℰ.base z ∈ U_X →
        Nonempty ↥((TopologicalSpace.Opens.map (ιE ≫ u_gen).base).obj U_X)) := by
    intro U_X hUX B 𝔓 W_ℰ
    have h𝔓_ker : 𝔓 = RingHom.ker ((ιE ≫ u_gen).app U_X).hom :=
      AlgebraicGeometry.Scheme.Hom.ker_apply (ιE ≫ u_gen) ⟨U_X, hUX⟩
    let I := (ιE ≫ u_gen).ker
    have hWℰ : AlgebraicGeometry.IsAffineOpen W_ℰ := hUX.preimage ι_ℰ
    have hSpec := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_ℰ hUX hWℰ (le_refl W_ℰ)
    have happ : ι_ℰ.appLE U_X W_ℰ (le_refl W_ℰ) =
        CommRingCat.ofHom (Ideal.Quotient.mk 𝔓) ≫ (I.subschemeObjIso ⟨U_X, hUX⟩).inv := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact I.subschemeι_app ⟨U_X, hUX⟩
    let iso_obj : AlgebraicGeometry.Spec ↑(ℰ.presheaf.obj (Opposite.op W_ℰ)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ 𝔓)) :=
      { hom := AlgebraicGeometry.Spec.map (I.subschemeObjIso ⟨U_X, hUX⟩).inv
        inv := AlgebraicGeometry.Spec.map (I.subschemeObjIso ⟨U_X, hUX⟩).hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.hom_inv_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
            AlgebraicGeometry.Spec.map_id] }
    let iso_sub : W_ℰ.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ 𝔓)) :=
      hWℰ.isoSpec ≪≫ iso_obj
    have hiso_sub : W_ℰ.ι ≫ ι_ℰ =
        iso_sub.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓)) ≫
            hUX.fromSpec := by
      calc W_ℰ.ι ≫ ι_ℰ
          = (hWℰ.isoSpec.hom ≫ hWℰ.fromSpec) ≫ ι_ℰ := by rw [hWℰ.isoSpec_hom_fromSpec]
        _ = hWℰ.isoSpec.hom ≫ (hWℰ.fromSpec ≫ ι_ℰ) := by rw [CategoryTheory.Category.assoc]
        _ = hWℰ.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (ι_ℰ.appLE U_X W_ℰ (le_refl W_ℰ)) ≫ hUX.fromSpec := by
              rw [← hSpec]
        _ = iso_sub.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓)) ≫
                hUX.fromSpec := by
              rw [happ, AlgebraicGeometry.Spec.map_comp]
              simp [iso_sub, iso_obj, CategoryTheory.Category.assoc]
    have hMem_iff : ∀ p : PrimeSpectrum B,
        hUX.fromSpec.base p ∈ Set.range ι_ℰ.base ↔ 𝔓 ≤ p.asIdeal := by
      intro p
      constructor
      · rintro ⟨w, hw_eq⟩
        have hp_UX : hUX.fromSpec.base p ∈ U_X := by
          have h_inv_ι : hUX.fromSpec.base p = U_X.ι.base (hUX.isoSpec.inv.base p) :=
            congrArg (fun φ => φ.base p) hUX.isoSpec_inv_ι.symm
          rw [h_inv_ι]
          exact (hUX.isoSpec.inv.base p).2
        have hw_W : w ∈ W_ℰ := by
          change ι_ℰ.base w ∈ U_X
          rw [hw_eq]
          exact hp_UX
        let q : PrimeSpectrum (B ⧸ 𝔓) := iso_sub.hom.base ⟨w, hw_W⟩
        have hcomm_pt := congrArg (fun φ => φ.base ⟨w, hw_W⟩) hiso_sub
        change ι_ℰ.base w = hUX.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓))).base q) at hcomm_pt
        rw [hw_eq] at hcomm_pt
        have hp_eq := hUX.fromSpec.isOpenEmbedding.injective hcomm_pt
        have hp_ideal : p.asIdeal = q.asIdeal.comap (Ideal.Quotient.mk 𝔓) :=
          congrArg PrimeSpectrum.asIdeal hp_eq
        rw [hp_ideal]
        intro b hb
        change Ideal.Quotient.mk 𝔓 b ∈ q.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb]
        exact q.asIdeal.zero_mem
      · intro hle
        let mk𝔓 : B →+* (B ⧸ 𝔓) := Ideal.Quotient.mk 𝔓
        have hker_le : RingHom.ker mk𝔓 ≤ p.asIdeal := by
          rw [Ideal.mk_ker]
          exact hle
        have _ : p.asIdeal.IsPrime := p.isPrime
        have hq_prime : (p.asIdeal.map mk𝔓).IsPrime :=
          p.asIdeal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_le
        let q : PrimeSpectrum (B ⧸ 𝔓) := ⟨p.asIdeal.map mk𝔓, hq_prime⟩
        have hq_map : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk𝔓)).base q = p := by
          apply PrimeSpectrum.ext
          change Ideal.comap mk𝔓 (Ideal.map mk𝔓 p.asIdeal) = p.asIdeal
          rw [Ideal.comap_map_of_surjective' mk𝔓 Ideal.Quotient.mk_surjective p.asIdeal,
            Ideal.mk_ker, sup_eq_left.mpr hle]
        let w_sub : ↥W_ℰ.toScheme := iso_sub.inv.base q
        refine ⟨W_ℰ.ι.base w_sub, ?_⟩
        have hcomm_pt := congrArg (fun φ => φ.base w_sub) hiso_sub
        change ι_ℰ.base (W_ℰ.ι.base w_sub) =
          (iso_sub.inv ≫ iso_sub.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk𝔓) ≫ hUX.fromSpec).base q at hcomm_pt
        rw [iso_sub.inv_hom_id_assoc] at hcomm_pt
        change ι_ℰ.base (W_ℰ.ι.base w_sub) =
          hUX.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk𝔓)).base q) at hcomm_pt
        rw [hq_map] at hcomm_pt
        exact hcomm_pt
    have hVE_nonempty : ∀ z : ↥ℰ, ι_ℰ.base z ∈ U_X →
        Nonempty ↥((TopologicalSpace.Opens.map (ιE ≫ u_gen).base).obj U_X) := by
      intro z hz
      have hcl : z ∈ closure
          (Set.range (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).base) := by
        rw [hDense.closure_range]
        trivial
      obtain ⟨_, hw_W, w, rfl⟩ := mem_closure_iff.mp hcl (W_ℰ : Set ↥ℰ) W_ℰ.isOpen hz
      have hw_UX : (ιE ≫ u_gen).base w ∈ U_X := by
        have hfac := congrArg (fun φ => φ.base w)
          (AlgebraicGeometry.Scheme.Hom.toImage_imageι (ιE ≫ u_gen))
        change (ιE ≫ u_gen).base w ∈ U_X
        rw [← hfac]
        exact hw_W
      exact ⟨⟨w, hw_UX⟩⟩
    exact ⟨h𝔓_ker, hMem_iff, ⟨iso_sub, hiso_sub⟩, hVE_nonempty⟩

  have hInt_ℰ : AlgebraicGeometry.IsIntegral ℰ := by
    have hIrredE : IrreducibleSpace ↥E_sch :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral E_sch hInt_E
    obtain ⟨w₀⟩ := hIrredE.toNonempty
    have hPre_range : IsPreirreducible
        (Set.range (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).base) := by
      rw [← Set.image_univ]
      exact hIrredE.isPreirreducible_univ.image _
        (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).continuous.continuousOn
    have hPre_univ : IsPreirreducible (Set.univ : Set ↥ℰ) := by
      rw [← hDense.closure_range]
      exact hPre_range.closure
    have _ : IrreducibleSpace ↥ℰ :=
      { isPreirreducible_univ := hPre_univ
        toNonempty := ⟨(AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).base w₀⟩ }
    choose U_x hUx hx_mem _ using fun x : ↥ℰ =>
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := ι_ℰ.base x) trivial
    let W_x : ↥ℰ → ℰ.Opens := fun x => (TopologicalSpace.Opens.map ι_ℰ.base).obj (U_x x)
    have hRed_Wx : ∀ x : ↥ℰ, AlgebraicGeometry.IsReduced (W_x x).toScheme := by
      intro x
      obtain ⟨h𝔓x_ker, _, ⟨iso_sub_x, _⟩, _⟩ := hSubChart (U_x x) (hUx x)
      let B_x := ↑(X_W0.presheaf.obj (Opposite.op (U_x x)))
      let 𝔓_x : Ideal B_x := ((ιE ≫ u_gen).ker).ideal ⟨U_x x, hUx x⟩
      let V_x : E_sch.Opens := (TopologicalSpace.Opens.map (ιE ≫ u_gen).base).obj (U_x x)
      have _ : IsReduced ↑(E_sch.presheaf.obj (Opposite.op V_x)) :=
        AlgebraicGeometry.IsReduced.component_reduced V_x
      let e_ker : (B_x ⧸ 𝔓_x) ≃+* (B_x ⧸ RingHom.ker ((ιE ≫ u_gen).app (U_x x)).hom) :=
        Ideal.quotEquivOfEq h𝔓x_ker
      let inj_hom : (B_x ⧸ 𝔓_x) →+* ↑(E_sch.presheaf.obj (Opposite.op V_x)) :=
        (RingHom.kerLift ((ιE ≫ u_gen).app (U_x x)).hom).comp e_ker.toRingHom
      have hinj : Function.Injective inj_hom :=
        (RingHom.kerLift_injective _).comp e_ker.injective
      have _ : IsReduced (B_x ⧸ 𝔓_x) := isReduced_of_injective inj_hom hinj
      have _ : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of (B_x ⧸ 𝔓_x))) :=
        (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of (B_x ⧸ 𝔓_x))).mpr inferInstance
      exact AlgebraicGeometry.isReduced_of_isOpenImmersion iso_sub_x.hom
    have hcov : TopologicalSpace.IsOpenCover W_x :=
      TopologicalSpace.IsOpenCover.mk
        (eq_top_iff.mpr fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hx_mem x⟩)
    let 𝒰 := ℰ.openCoverOfIsOpenCover W_x hcov
    have _ : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := hRed_Wx
    have _ : AlgebraicGeometry.IsReduced ℰ := AlgebraicGeometry.IsReduced.of_openCover ℰ 𝒰
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced ℰ

  
  have hP1TwoPts : ∀ (U_P : (weilProjectiveSpaceOver L 1).left.Opens),
      Nonempty ↥U_P →
      ∃ p₁ p₂ : ↥(weilProjectiveSpaceOver L 1).left, p₁ ∈ U_P ∧ p₂ ∈ U_P ∧ p₁ ≠ p₂ := by
    intro U_P hUP
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) L
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let ev : L → (MvPolynomial (Fin 2) L →+* Polynomial L) :=
      fun c => (MvPolynomial.aeval ![Polynomial.X, Polynomial.C c * Polynomial.X]).toRingHom
    have hdeg : ∀ (c : L) (n : ℕ) (g : MvPolynomial (Fin 2) L),
        g ∈ 𝒜 n → ev c g = Polynomial.C (MvPolynomial.eval ![1, c] g) * Polynomial.X ^ n := by
      intro c n g hg
      rw [MvPolynomial.mem_homogeneousSubmodule] at hg
      conv_lhs => rw [g.as_sum]
      conv_rhs => rw [g.as_sum]
      rw [map_sum, map_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hm_sum : m 0 + m 1 = n := by
        have := hg (MvPolynomial.mem_support_iff.mp hm)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using this
      rw [MvPolynomial.monomial_eq, map_mul, map_mul,
        Finsupp.prod_fintype _ _ (fun _ => pow_zero _), map_prod, map_prod]
      simp only [ev, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_pow, MvPolynomial.aeval_C,
        Polynomial.algebraMap_eq, Fin.prod_univ_two, MvPolynomial.aeval_X,
        Matrix.cons_val_zero, Matrix.cons_val_one,
        MvPolynomial.eval_C, MvPolynomial.eval_X, one_pow, one_mul, mul_pow, Polynomial.C_mul]
      calc Polynomial.C (g.coeff m) *
            (Polynomial.X ^ m 0 * (Polynomial.C c ^ m 1 * Polynomial.X ^ m 1))
          = Polynomial.C (g.coeff m) * Polynomial.C c ^ m 1 *
              (Polynomial.X ^ m 0 * Polynomial.X ^ m 1) := by ring
        _ = Polynomial.C (g.coeff m) * Polynomial.C c ^ m 1 * Polynomial.X ^ n := by
              rw [← pow_add, hm_sum]
    have hHom : ∀ c : L, (RingHom.ker (ev c)).IsHomogeneous 𝒜 := by
      intro c d f hf
      rw [RingHom.mem_ker] at hf ⊢
      have hsum : f = ∑ n ∈ (DirectSum.decompose 𝒜 f).support,
          (DirectSum.decompose 𝒜 f n : MvPolynomial (Fin 2) L) :=
        (DirectSum.sum_support_decompose 𝒜 f).symm
      by_cases hd : d ∈ (DirectSum.decompose 𝒜 f).support
      · rw [hdeg c d (DirectSum.decompose 𝒜 f d) (DirectSum.decompose 𝒜 f d).2]
        have hcoeff : Polynomial.coeff (ev c f) d = 0 := by rw [hf, Polynomial.coeff_zero]
        rw [hsum, map_sum, Polynomial.finsetSum_coeff] at hcoeff
        have hterm : (∑ n ∈ (DirectSum.decompose 𝒜 f).support,
            Polynomial.coeff (ev c (DirectSum.decompose 𝒜 f n)) d) =
            MvPolynomial.eval ![1, c] (DirectSum.decompose 𝒜 f d) := by
          rw [Finset.sum_eq_single d]
          · rw [hdeg c d _ (DirectSum.decompose 𝒜 f d).2, Polynomial.coeff_C_mul_X_pow]
            simp
          · intro n _ hnd
            rw [hdeg c n _ (DirectSum.decompose 𝒜 f n).2, Polynomial.coeff_C_mul_X_pow]
            simp [hnd.symm]
          · intro hnot; exact absurd hd hnot
        rw [hterm] at hcoeff
        simp [hcoeff]
      · have hzero : DirectSum.decompose 𝒜 f d = 0 := DFinsupp.notMem_support_iff.mp hd
        simp [hzero]
    let mkPt : L → ProjectiveSpectrum 𝒜 := fun c =>
      { asHomogeneousIdeal := ⟨RingHom.ker (ev c), hHom c⟩
        isPrime := RingHom.ker_isPrime (ev c)
        not_irrelevant_le := by
          intro hle
          have hX0_irrel : (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) L) ∈
              HomogeneousIdeal.irrelevant 𝒜 := by
            rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
            exact DirectSum.decompose_of_mem_ne 𝒜 (MvPolynomial.isHomogeneous_X L 0) (by decide)
          have hX0_ker : ev c (MvPolynomial.X (0 : Fin 2)) = 0 := hle hX0_irrel
          have hX0_eval : ev c (MvPolynomial.X (0 : Fin 2)) = Polynomial.X := by simp [ev]
          exact Polynomial.X_ne_zero (hX0_eval.symm.trans hX0_ker) }
    have hInj : Function.Injective mkPt := by
      intro c₁ c₂ heq
      let hlin : MvPolynomial (Fin 2) L :=
        MvPolynomial.X 1 - MvPolynomial.C c₁ * MvPolynomial.X 0
      have hmem1 : hlin ∈ (mkPt c₁).asHomogeneousIdeal := by
        change ev c₁ hlin = 0
        simp [ev, hlin]
      rw [heq] at hmem1
      have hmem2 : ev c₂ hlin = 0 := hmem1
      have hval2 : ev c₂ hlin = Polynomial.C (c₂ - c₁) * Polynomial.X := by
        simp [ev, hlin, Polynomial.C_sub, sub_mul]
      rw [hval2] at hmem2
      have hc : Polynomial.coeff (Polynomial.C (c₂ - c₁) * Polynomial.X) 1 = 0 := by
        rw [hmem2, Polynomial.coeff_zero]
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_one, mul_one] at hc
      exact (sub_eq_zero.mp hc).symm
    obtain ⟨⟨q₀, hq₀⟩⟩ := hUP
    let q₀' : ProjectiveSpectrum 𝒜 := q₀
    let U_set : Set (ProjectiveSpectrum 𝒜) := U_P.carrier
    have hOpen_U : IsOpen U_set := U_P.is_open'
    obtain ⟨S, hS⟩ :=
      (ProjectiveSpectrum.isClosed_iff_zeroLocus (𝒜 := 𝒜) U_setᶜ).mp hOpen_U.isClosed_compl
    have hq₀_not_zero : q₀' ∉ ProjectiveSpectrum.zeroLocus 𝒜 S := by
      rw [← hS]
      exact fun h => h hq₀
    rw [ProjectiveSpectrum.mem_zeroLocus, Set.not_subset] at hq₀_not_zero
    obtain ⟨f, hfS, hf_not_q₀⟩ := hq₀_not_zero
    have hex_d : ∃ d : ℕ,
        (DirectSum.decompose 𝒜 f d : MvPolynomial (Fin 2) L) ∉ q₀'.asHomogeneousIdeal := by
      by_contra! hall
      apply hf_not_q₀
      have hsum : f = ∑ n ∈ (DirectSum.decompose 𝒜 f).support,
          (DirectSum.decompose 𝒜 f n : MvPolynomial (Fin 2) L) :=
        (DirectSum.sum_support_decompose 𝒜 f).symm
      rw [hsum]
      exact Ideal.sum_mem q₀'.asHomogeneousIdeal.toIdeal (fun n _ => hall n)
    obtain ⟨d, hfd_not_q₀⟩ := hex_d
    let f_d : MvPolynomial (Fin 2) L := DirectSum.decompose 𝒜 f d
    have hfd_hom : f_d ∈ 𝒜 d := (DirectSum.decompose 𝒜 f d).2
    have hfd_ne : f_d ≠ 0 := by
      intro h0
      apply hfd_not_q₀
      change f_d ∈ q₀'.asHomogeneousIdeal.toIdeal
      rw [h0]
      exact q₀'.asHomogeneousIdeal.toIdeal.zero_mem
    let P : Polynomial L := MvPolynomial.aeval ![1, Polynomial.X] f_d
    have hP_ne : P ≠ 0 := by
      have hex_m : ∃ m₀ : Fin 2 →₀ ℕ, f_d.coeff m₀ ≠ 0 := by
        by_contra! h0
        exact hfd_ne (MvPolynomial.ext f_d 0 fun m => by simp [h0 m])
      obtain ⟨m₀, hm₀⟩ := hex_m
      have hm₀_supp : m₀ ∈ f_d.support := MvPolynomial.mem_support_iff.mpr hm₀
      have hfd_hom' := (MvPolynomial.mem_homogeneousSubmodule d f_d).mp hfd_hom
      have hcoeffP : Polynomial.coeff P (m₀ 1) = f_d.coeff m₀ := by
        dsimp [P]
        conv_lhs => rw [f_d.as_sum]
        rw [map_sum, Polynomial.finsetSum_coeff, Finset.sum_eq_single m₀]
        · rw [MvPolynomial.monomial_eq, map_mul,
            Finsupp.prod_fintype _ _ (fun _ => pow_zero _), map_prod]
          simp [Fin.prod_univ_two]
        · intro m hm hne
          have hm1_ne : m 1 ≠ m₀ 1 := by
            intro heq1
            apply hne
            have hs1 : m 0 + m 1 = d := by
              simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using
                hfd_hom' (MvPolynomial.mem_support_iff.mp hm)
            have hs2 : m₀ 0 + m₀ 1 = d := by
              simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using
                hfd_hom' hm₀
            have heq0 : m 0 = m₀ 0 := by omega
            exact Finsupp.ext (Fin.forall_fin_two.mpr ⟨heq0, heq1⟩)
          rw [MvPolynomial.monomial_eq, map_mul,
            Finsupp.prod_fintype _ _ (fun _ => pow_zero _), map_prod]
          simp [Fin.prod_univ_two, hm1_ne.symm]
        · intro hnot; exact absurd hm₀_supp hnot
      intro hP0
      rw [hP0, Polynomial.coeff_zero] at hcoeffP
      exact hm₀ hcoeffP.symm
    have hP_eval : ∀ c : L, Polynomial.eval c P = MvPolynomial.eval ![1, c] f_d := by
      intro c
      have hhom : (Polynomial.evalRingHom c).comp
          (MvPolynomial.aeval (R := L) ![1, Polynomial.X]).toRingHom =
          MvPolynomial.eval ![1, c] := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp
        · intro i; fin_cases i <;> simp
      exact RingHom.congr_fun hhom f_d
    have _ : Infinite L := @IsAlgClosed.instInfinite L _ hAlg_L
    obtain ⟨c₁, hc₁⟩ := Infinite.exists_notMem_finset P.roots.toFinset
    obtain ⟨c₂, hc₂⟩ := Infinite.exists_notMem_finset (insert c₁ P.roots.toFinset)
    have hc₂_ne_c₁ : c₂ ≠ c₁ := by
      intro h
      subst h
      exact hc₂ (Finset.mem_insert_self _ _)
    have hc₂_not_roots : c₂ ∉ P.roots.toFinset :=
      fun h => hc₂ (Finset.mem_insert_of_mem h)
    have hMemUP : ∀ c : L, c ∉ P.roots.toFinset → mkPt c ∈ U_set := by
      intro c hc_not
      have heval_ne : Polynomial.eval c P ≠ 0 := by
        intro hev0
        apply hc_not
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne]
        exact hev0
      have hev_fd_ne : ev c f_d ≠ 0 := by
        rw [hdeg c d f_d hfd_hom, ← hP_eval c]
        intro h0
        have hcoeff0 : Polynomial.coeff
            (Polynomial.C (Polynomial.eval c P) * Polynomial.X ^ d) d = 0 := by
          rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_C_mul_X_pow] at hcoeff0
        simp only [↓reduceIte] at hcoeff0
        exact heval_ne hcoeff0
      have hf_not_ker : f ∉ (mkPt c).asHomogeneousIdeal := by
        intro hf_ker
        have hproj := (mkPt c).asHomogeneousIdeal.isHomogeneous d hf_ker
        exact hev_fd_ne hproj
      have hnot_compl : mkPt c ∉ U_setᶜ := by
        rw [hS, ProjectiveSpectrum.mem_zeroLocus]
        exact fun hsub => hf_not_ker (hsub hfS)
      exact Classical.not_not.mp hnot_compl
    exact ⟨mkPt c₁, mkPt c₂, hMemUP c₁ hc₁, hMemUP c₂ hc₂_not_roots,
      fun heq => hc₂_ne_c₁ (hInj heq).symm⟩

  
  have hMemBasic : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens)
      (hU : AlgebraicGeometry.IsAffineOpen U) (s : ↑Γ(X, U)) (x : ↥U),
      (x : ↥X) ∈ X.basicOpen s ↔ s ∉ (hU.primeIdealOf x).asIdeal := by
    intro X U hU s x
    let p : ↥(AlgebraicGeometry.Spec Γ(X, U)) := hU.primeIdealOf x
    have hp : hU.fromSpec.base p = (x : ↥X) := hU.fromSpec_primeIdealOf x
    change (x : ↥X) ∈ (X.basicOpen s : Set ↥X) ↔ _
    rw [← hp]
    change p ∈ ((TopologicalSpace.Opens.map hU.fromSpec.base).obj (X.basicOpen s) : Set _) ↔ _
    rw [hU.fromSpec_preimage_basicOpen]
    exact @PrimeSpectrum.mem_basicOpen ↑Γ(X, U) _ s p

  have hLoc_ugen : ∀ (U_X : X_W0.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
      (c_W : ↥W₀ →+* ↑(X_W0.presheaf.obj (Opposite.op U_X))),
      hUX.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) →
      let U_b : Y_b.Opens := (TopologicalSpace.Opens.map u_gen.base).obj U_X
      AlgebraicGeometry.IsAffineOpen U_b ∧
      ∃ e_Ub : Localization.Away (c_W π₀) ≃+* ↑(Y_b.presheaf.obj (Opposite.op U_b)),
        e_Ub.toRingHom.comp
          (algebraMap ↑(X_W0.presheaf.obj (Opposite.op U_X)) (Localization.Away (c_W π₀))) =
          (u_gen.app U_X).hom := by
    intro U_X hUX c_W hc_W U_b
    let B := ↑(X_W0.presheaf.obj (Opposite.op U_X))
    let π_X : B := c_W π₀
    let U_π : X_W0.Opens := X_W0.basicOpen π_X
    have hOpenEq : (u_gen.opensFunctor).obj U_b = U_π := by
      ext x
      change x ∈ u_gen.base '' (u_gen.base ⁻¹' (U_X : Set ↥X_W0)) ↔ x ∈ (U_π : Set ↥X_W0)
      rw [Set.image_preimage_eq_inter_range]
      constructor
      · rintro ⟨hx_UX, hx_range⟩
        rw [hRange_ugen] at hx_range
        change ((CategoryTheory.Limits.pullback.snd g_cur ι_W0).base x).asIdeal = ⊥ at hx_range
        let p := hUX.primeIdealOf ⟨x, hx_UX⟩
        have hp_x : hUX.fromSpec.base p = x := hUX.fromSpec_primeIdealOf ⟨x, hx_UX⟩
        have hcW_pt := congrArg (fun φ => (φ.base p).asIdeal) hc_W
        change ((CategoryTheory.Limits.pullback.snd g_cur ι_W0).base
          (hUX.fromSpec.base p)).asIdeal = p.asIdeal.comap c_W at hcW_pt
        rw [hp_x, hx_range] at hcW_pt
        refine (hMemBasic U_X hUX π_X ⟨x, hx_UX⟩).mpr ?_
        intro hπ_mem
        have hπ₀_bot : π₀ ∈ (⊥ : Ideal ↥W₀) := by
          rw [hcW_pt]
          exact hπ_mem
        rw [Ideal.mem_bot] at hπ₀_bot
        exact hπ₀_ne hπ₀_bot
      · intro hx_Uπ
        have hx_UX : x ∈ U_X := X_W0.basicOpen_le π_X hx_Uπ
        have hπ_not : π_X ∉ (hUX.primeIdealOf ⟨x, hx_UX⟩).asIdeal :=
          (hMemBasic U_X hUX π_X ⟨x, hx_UX⟩).mp hx_Uπ
        let p := hUX.primeIdealOf ⟨x, hx_UX⟩
        have hp_x : hUX.fromSpec.base p = x := hUX.fromSpec_primeIdealOf ⟨x, hx_UX⟩
        have hcW_pt := congrArg (fun φ => (φ.base p).asIdeal) hc_W
        change ((CategoryTheory.Limits.pullback.snd g_cur ι_W0).base
          (hUX.fromSpec.base p)).asIdeal = p.asIdeal.comap c_W at hcW_pt
        rw [hp_x] at hcW_pt
        have hP'_prime : (p.asIdeal.comap c_W).IsPrime := p.isPrime.comap c_W
        have hcomap_bot : p.asIdeal.comap c_W = ⊥ := by
          rcases hRank1_W₀ ⟨p.asIdeal.comap c_W, hP'_prime⟩ with hbot | hmax
          · exact hbot
          · exfalso
            change p.asIdeal.comap c_W = IsLocalRing.maximalIdeal ↥W₀ at hmax
            have hmem : π₀ ∈ p.asIdeal.comap c_W := hmax ▸ hπ₀_mem
            exact hπ_not hmem
        refine ⟨hx_UX, ?_⟩
        rw [hRange_ugen]
        exact hcW_pt.trans hcomap_bot
    have hRangeEq : Set.range (U_b.ι ≫ u_gen).base = Set.range U_π.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      change Set.range (u_gen.base ∘ U_b.ι.base) = (U_π : Set ↥X_W0)
      rw [Set.range_comp, AlgebraicGeometry.Scheme.Opens.range_ι]
      exact congrArg (fun W : X_W0.Opens => (W : Set ↥X_W0)) hOpenEq
    let iso_Ub_Uπ : U_b.toScheme ≅ U_π.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (U_b.ι ≫ u_gen) U_π.ι hRangeEq
    have _ : AlgebraicGeometry.IsAffine U_π.toScheme := hUX.basicOpen π_X
    have hUb : AlgebraicGeometry.IsAffineOpen U_b :=
      AlgebraicGeometry.isAffine_of_isAffineHom iso_Ub_Uπ.hom
    let B_π := ↑(X_W0.presheaf.obj (Opposite.op U_π))
    let res_π := X_W0.presheaf.map (CategoryTheory.homOfLE (X_W0.basicOpen_le π_X)).op
    let _ : Algebra B B_π := res_π.hom.toAlgebra
    have _ : IsLocalization.Away π_X B_π := hUX.isLocalization_basicOpen π_X
    let e_loc : Localization.Away π_X ≃ₐ[B] B_π :=
      IsLocalization.algEquiv (Submonoid.powers π_X) (Localization.Away π_X) B_π
    let iso_app : X_W0.presheaf.obj (Opposite.op U_π) ≅ Y_b.presheaf.obj (Opposite.op U_b) :=
      X_W0.presheaf.mapIso (CategoryTheory.eqToIso hOpenEq).op ≪≫ u_gen.appIso U_b
    have hres_iso : res_π ≫ iso_app.hom = u_gen.app U_X := by
      dsimp [iso_app, res_π]
      rw [← CategoryTheory.Category.assoc, ← X_W0.presheaf.map_comp,
        AlgebraicGeometry.Scheme.Hom.appIso_hom',
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      have hmor : (CategoryTheory.homOfLE (X_W0.basicOpen_le π_X)).op ≫
          (CategoryTheory.eqToHom hOpenEq).op =
          (CategoryTheory.homOfLE (hOpenEq.symm ▸ X_W0.basicOpen_le π_X)).op :=
        Subsingleton.elim _ _
      change X_W0.presheaf.map
          ((CategoryTheory.homOfLE (X_W0.basicOpen_le π_X)).op ≫
            (CategoryTheory.eqToHom hOpenEq).op) ≫
          u_gen.appLE _ U_b _ = u_gen.appLE U_X U_b _
      rw [hmor, AlgebraicGeometry.Scheme.Hom.map_appLE]
    let e_Ub : Localization.Away π_X ≃+* ↑(Y_b.presheaf.obj (Opposite.op U_b)) :=
      e_loc.toRingEquiv.trans iso_app.commRingCatIsoToRingEquiv
    refine ⟨hUb, e_Ub, ?_⟩
    ext b
    change iso_app.hom.hom (e_loc (algebraMap B (Localization.Away π_X) b)) =
      (u_gen.app U_X).hom b
    rw [e_loc.commutes]
    change (res_π ≫ iso_app.hom).hom b = (u_gen.app U_X).hom b
    rw [hres_iso]

  
  refine ⟨hInt_ℰ, hOpen_ugen, hRange_ugen, hGen_iff, ?_⟩
  intro U_X hUX z hz
  let B := ↑(X_W0.presheaf.obj (Opposite.op U_X))
  let 𝔓 : Ideal B := ((ιE ≫ u_gen).ker).ideal ⟨U_X, hUX⟩
  let W_ℰ : ℰ.Opens := (TopologicalSpace.Opens.map ι_ℰ.base).obj U_X
  let U_b : Y_b.Opens := (TopologicalSpace.Opens.map u_gen.base).obj U_X
  let V_E : E_sch.Opens := (TopologicalSpace.Opens.map (ιE ≫ u_gen).base).obj U_X
  let R_E := ↑(E_sch.presheaf.obj (Opposite.op V_E))

  obtain ⟨h𝔓_ker, hMem_iff, ⟨iso_sub, hiso_sub⟩, hVE_nonempty⟩ := hSubChart U_X hUX
  have h𝔓_ker' : 𝔓 = RingHom.ker ((ιE ≫ u_gen).app U_X).hom := h𝔓_ker
  have hVE_ne : Nonempty ↥V_E := hVE_nonempty z hz
  have _ : IsDomain R_E :=
    @AlgebraicGeometry.IsIntegral.component_integral E_sch hInt_E V_E hVE_ne
  have h𝔓_le_pz : 𝔓 ≤ (hUX.primeIdealOf ⟨ι_ℰ.base z, hz⟩).asIdeal :=
    (hMem_iff (hUX.primeIdealOf ⟨ι_ℰ.base z, hz⟩)).mp
      ⟨z, (hUX.fromSpec_primeIdealOf ⟨ι_ℰ.base z, hz⟩).symm⟩
  have h𝔓_prime : 𝔓.IsPrime := by
    rw [h𝔓_ker']
    exact RingHom.ker_isPrime ((ιE ≫ u_gen).app U_X).hom

  
  have hVE_aff : AlgebraicGeometry.IsAffineOpen V_E := hUX.preimage (ιE ≫ u_gen)
  let U_P : (weilProjectiveSpaceOver L 1).left.Opens :=
    (TopologicalSpace.Opens.map isoP1.inv.base).obj V_E
  have hUP_ne : Nonempty ↥U_P := by
    obtain ⟨w₀, hw₀⟩ := hVE_ne
    refine ⟨⟨isoP1.hom.base w₀, ?_⟩⟩
    change isoP1.inv.base (isoP1.hom.base w₀) ∈ V_E
    have h_id : (isoP1.hom ≫ isoP1.inv).base w₀ = w₀ := by
      rw [isoP1.hom_inv_id]
      rfl
    rw [← h_id] at hw₀
    exact hw₀
  obtain ⟨p₁_P, p₂_P, hp₁_UP, hp₂_UP, hp_ne⟩ := hP1TwoPts U_P hUP_ne
  let w₁ : ↥V_E := ⟨isoP1.inv.base p₁_P, hp₁_UP⟩
  let w₂ : ↥V_E := ⟨isoP1.inv.base p₂_P, hp₂_UP⟩
  let q₁_RE : PrimeSpectrum R_E := hVE_aff.primeIdealOf w₁
  let q₂_RE : PrimeSpectrum R_E := hVE_aff.primeIdealOf w₂
  have hq_RE_ne : q₁_RE ≠ q₂_RE := by
    intro heq
    have hbase := congrArg hVE_aff.fromSpec.base heq
    rw [hVE_aff.fromSpec_primeIdealOf w₁, hVE_aff.fromSpec_primeIdealOf w₂] at hbase
    have hp_eq := congrArg isoP1.hom.base hbase
    have hid1 : (isoP1.inv ≫ isoP1.hom).base p₁_P = p₁_P := by
      rw [isoP1.inv_hom_id]; rfl
    have hid2 : (isoP1.inv ≫ isoP1.hom).base p₂_P = p₂_P := by
      rw [isoP1.inv_hom_id]; rfl
    exact hp_ne (hid1.symm.trans (hp_eq.trans hid2))
  have hex_qstar : ∃ q_star : PrimeSpectrum R_E, ∃ r_star : R_E,
      r_star ∈ q_star.asIdeal ∧ r_star ≠ 0 := by
    have hnot_both_bot : q₁_RE.asIdeal ≠ ⊥ ∨ q₂_RE.asIdeal ≠ ⊥ := by
      by_contra! hboth
      exact hq_RE_ne (PrimeSpectrum.ext (hboth.1.trans hboth.2.symm))
    have pick_nz : ∀ q : PrimeSpectrum R_E, q.asIdeal ≠ ⊥ →
        ∃ r : R_E, r ∈ q.asIdeal ∧ r ≠ 0 := by
      intro q hne
      by_contra! hall0
      apply hne
      rw [eq_bot_iff]
      intro r hr
      rw [Ideal.mem_bot]
      exact hall0 r hr
    rcases hnot_both_bot with h1 | h2
    · obtain ⟨r, hr, hr0⟩ := pick_nz q₁_RE h1
      exact ⟨q₁_RE, r, hr, hr0⟩
    · obtain ⟨r, hr, hr0⟩ := pick_nz q₂_RE h2
      exact ⟨q₂_RE, r, hr, hr0⟩
  obtain ⟨q_star, r_star, hr_mem, hr_ne⟩ := hex_qstar

  
  have hcW_helper : ∀ c_W : ↥W₀ →+* B,
      hUX.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) →
      c_W π₀ ∉ 𝔓 ∧
      𝔓.comap c_W = ⊥ ∧
      (∃ 𝔔 : Ideal B, 𝔔.IsPrime ∧ 𝔓 < 𝔔 ∧ 𝔔.comap c_W = ⊥) ∧
      (IsDomain B → RingHom.ker (ιE.app U_b).hom = ⊥ → 𝔓 = ⊥) := by
    intro c_W hc_W
    obtain ⟨hUb, e_Ub, he_Ub⟩ := hLoc_ugen U_X hUX c_W hc_W
    let B' := ↑(Y_b.presheaf.obj (Opposite.op U_b))
    let α : B →+* B' := (u_gen.app U_X).hom
    let β : B' →+* R_E := (ιE.app U_b).hom
    have hcomp_app : ((ιE ≫ u_gen).app U_X).hom = β.comp α := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_app]
      rfl
    have h𝔓_comp : 𝔓 = RingHom.ker (β.comp α) := h𝔓_ker'.trans (congrArg RingHom.ker hcomp_app)
    have hSurj_β : Function.Surjective β :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ιE U_b hUb
    let u_E : R_E := (β.comp α) (c_W π₀)
    have hu_E : IsUnit u_E := by
      have hu_loc : IsUnit (algebraMap B (Localization.Away (c_W π₀)) (c_W π₀)) :=
        IsLocalization.Away.algebraMap_isUnit (c_W π₀)
      have hu_B' : IsUnit (α (c_W π₀)) := by
        have hα_eq : α (c_W π₀) =
            e_Ub.toRingHom (algebraMap B (Localization.Away (c_W π₀)) (c_W π₀)) :=
          (RingHom.congr_fun he_Ub (c_W π₀)).symm
        rw [hα_eq]
        exact hu_loc.map e_Ub.toRingHom
      exact hu_B'.map β
    have hcW_not_𝔓 : c_W π₀ ∉ 𝔓 := by
      rw [h𝔓_comp, RingHom.mem_ker]
      exact hu_E.ne_zero
    have h𝔓_comap : 𝔓.comap c_W = ⊥ := by
      have hP_prime : (𝔓.comap c_W).IsPrime := h𝔓_prime.comap c_W
      rcases hRank1_W₀ ⟨𝔓.comap c_W, hP_prime⟩ with hbot | hmax
      · exact hbot
      · exfalso
        change 𝔓.comap c_W = IsLocalRing.maximalIdeal ↥W₀ at hmax
        exact hcW_not_𝔓 (show π₀ ∈ 𝔓.comap c_W from hmax ▸ hπ₀_mem)
    let 𝔔 : Ideal B := q_star.asIdeal.comap (β.comp α)
    have h𝔔_prime : 𝔔.IsPrime := q_star.isPrime.comap (β.comp α)
    have h𝔓_le_𝔔 : 𝔓 ≤ 𝔔 := by
      rw [h𝔓_comp]
      intro b hb
      rw [RingHom.mem_ker] at hb
      change (β.comp α) b ∈ q_star.asIdeal
      rw [hb]
      exact q_star.asIdeal.zero_mem
    obtain ⟨b', hb'_eq⟩ := hSurj_β r_star
    obtain ⟨⟨b_lift, ⟨_, k_exp, rfl⟩⟩, hsurj_eq⟩ :=
      IsLocalization.surj (Submonoid.powers (c_W π₀)) (e_Ub.symm b')
    have hb_eval : (β.comp α) b_lift = r_star * u_E ^ k_exp := by
      have h1 := congrArg e_Ub.toRingHom hsurj_eq
      rw [map_mul] at h1
      have he_b' : e_Ub.toRingHom (e_Ub.symm b') = b' := e_Ub.apply_symm_apply b'
      have hα_pow : e_Ub.toRingHom
          (algebraMap B (Localization.Away (c_W π₀)) ((c_W π₀) ^ k_exp)) =
          α ((c_W π₀) ^ k_exp) :=
        RingHom.congr_fun he_Ub ((c_W π₀) ^ k_exp)
      have hα_b : e_Ub.toRingHom (algebraMap B (Localization.Away (c_W π₀)) b_lift) =
          α b_lift :=
        RingHom.congr_fun he_Ub b_lift
      rw [he_b', hα_pow, hα_b] at h1
      have h2 := congrArg β h1.symm
      rw [map_mul, hb'_eq, map_pow, map_pow] at h2
      exact h2
    have hb_in_𝔔 : b_lift ∈ 𝔔 := by
      change (β.comp α) b_lift ∈ q_star.asIdeal
      rw [hb_eval]
      exact Ideal.mul_mem_right (u_E ^ k_exp) q_star.asIdeal hr_mem
    have hb_not_𝔓 : b_lift ∉ 𝔓 := by
      rw [h𝔓_comp, RingHom.mem_ker, hb_eval]
      exact mul_ne_zero hr_ne (hu_E.pow k_exp).ne_zero
    have h𝔓_lt_𝔔 : 𝔓 < 𝔔 :=
      lt_of_le_not_ge h𝔓_le_𝔔 (fun hge => hb_not_𝔓 (hge hb_in_𝔔))
    have h𝔔_comap : 𝔔.comap c_W = ⊥ := by
      have hcW_not_𝔔 : c_W π₀ ∉ 𝔔 := by
        intro hmem
        exact q_star.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q_star.asIdeal hmem hu_E)
      rcases hRank1_W₀ ⟨𝔔.comap c_W, h𝔔_prime.comap c_W⟩ with hbot | hmax
      · exact hbot
      · exfalso
        change 𝔔.comap c_W = IsLocalRing.maximalIdeal ↥W₀ at hmax
        exact hcW_not_𝔔 (show π₀ ∈ 𝔔.comap c_W from hmax ▸ hπ₀_mem)
    have hDom_bot : IsDomain B → RingHom.ker β = ⊥ → 𝔓 = ⊥ := by
      intro hDomB hker_β
      have hcW_ne0 : c_W π₀ ≠ 0 := fun h0 => hcW_not_𝔓 (h0 ▸ 𝔓.zero_mem)
      have hSub_nzd : Submonoid.powers (c_W π₀) ≤ nonZeroDivisors B := by
        rintro _ ⟨n, rfl⟩
        rw [mem_nonZeroDivisors_iff_ne_zero]
        exact pow_ne_zero n hcW_ne0
      have hinj_loc : Function.Injective
          (algebraMap B (Localization.Away (c_W π₀))) :=
        IsLocalization.injective (Localization.Away (c_W π₀)) hSub_nzd
      have hinj_α : Function.Injective α := by
        have hα_fn : (α : B → B') =
            e_Ub.toRingHom ∘ algebraMap B (Localization.Away (c_W π₀)) := by
          ext b
          exact (RingHom.congr_fun he_Ub b).symm
        rw [hα_fn]
        exact e_Ub.injective.comp hinj_loc
      have hinj_β : Function.Injective β :=
        (RingHom.injective_iff_ker_eq_bot β).mpr hker_β
      rw [h𝔓_comp, ← RingHom.injective_iff_ker_eq_bot (β.comp α)]
      exact hinj_β.comp hinj_α
    exact ⟨hcW_not_𝔓, h𝔓_comap, ⟨𝔔, h𝔔_prime, h𝔓_lt_𝔔, h𝔔_comap⟩, hDom_bot⟩

  refine ⟨?_, ⟨h𝔓_le_pz, h𝔓_prime,
    fun c_W hc_W => ⟨(hcW_helper c_W hc_W).2.1, (hcW_helper c_W hc_W).2.2.1⟩,
    hMem_iff, ⟨iso_sub, hiso_sub⟩⟩⟩

  
  intro hDomB
  let c_W₀ : ↥W₀ →+* B :=
    (AlgebraicGeometry.Spec.preimage
      (hUX.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0)).hom
  have hc_W₀ : hUX.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W₀) :=
    (AlgebraicGeometry.Spec.map_preimage
      (hUX.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0)).symm
  obtain ⟨hUb, e_Ub, _⟩ := hLoc_ugen U_X hUX c_W₀ hc_W₀
  obtain ⟨hcW₀_not_𝔓, _, _, hDom_bot⟩ := hcW_helper c_W₀ hc_W₀
  have hcW₀_ne0 : c_W₀ π₀ ≠ 0 := fun h0 => hcW₀_not_𝔓 (h0 ▸ 𝔓.zero_mem)
  have hSub_nzd : Submonoid.powers (c_W₀ π₀) ≤ nonZeroDivisors B := by
    rintro _ ⟨n, rfl⟩
    rw [mem_nonZeroDivisors_iff_ne_zero]
    exact pow_ne_zero n hcW₀_ne0
  have _ : IsDomain (Localization.Away (c_W₀ π₀)) :=
    @IsLocalization.isDomain_of_le_nonZeroDivisors B _ (Submonoid.powers (c_W₀ π₀))
      (Localization.Away (c_W₀ π₀)) _ _ _ hDomB hSub_nzd
  let B' := ↑(Y_b.presheaf.obj (Opposite.op U_b))
  have _ : IsDomain B' := e_Ub.symm.toMulEquiv.isDomain (Localization.Away (c_W₀ π₀))

  
  have hker_ιE_bot : RingHom.ker (ιE.app U_b).hom = ⊥ := by
    have hSpec_irred : IrreducibleSpace
        ↥(AlgebraicGeometry.Spec (Y_b.presheaf.obj (Opposite.op U_b))) :=
      inferInstance
    obtain ⟨pt_spec⟩ := hSpec_irred.toNonempty
    have hSpec_univ_irred : IsIrreducible
        (Set.univ : Set ↥(AlgebraicGeometry.Spec (Y_b.presheaf.obj (Opposite.op U_b)))) :=
      ⟨⟨pt_spec, trivial⟩, hSpec_irred.isPreirreducible_univ⟩
    have hUb_irred : IsIrreducible (U_b : Set ↥Y_b) := by
      rw [← hUb.range_fromSpec, ← Set.image_univ]
      exact hSpec_univ_irred.image hUb.fromSpec.base hUb.fromSpec.continuous.continuousOn
    obtain ⟨E₁, hE₁_mem, hUb_sub_E₁⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible (U_b : Set ↥Y_b) hUb_irred
    have hCl_E₁ : IsClosed E₁ := isClosed_of_mem_irreducibleComponents E₁ hE₁_mem
    have hSub_union : E_cur ⊆ E₁ ∪ (U_b : Set ↥Y_b)ᶜ := by
      intro y hy
      by_cases hy_Ub : y ∈ (U_b : Set ↥Y_b)
      · exact Or.inl (hUb_sub_E₁ hy_Ub)
      · exact Or.inr hy_Ub
    have hDisj_or := isPreirreducible_iff_isClosed_union_isClosed.mp hE_irred.1.2
      E₁ (U_b : Set ↥Y_b)ᶜ hCl_E₁ U_b.isOpen.isClosed_compl hSub_union
    have hE_sub_E₁ : E_cur ⊆ E₁ := by
      rcases hDisj_or with h1 | h2
      · exact h1
      · exfalso
        obtain ⟨w₀, hw₀⟩ := hVE_ne
        have hw₀_E : ιE.base w₀ ∈ E_cur := by
          rw [← hRange_E]
          exact ⟨w₀, rfl⟩
        have hw₀_Ub : ιE.base w₀ ∈ (U_b : Set ↥Y_b) := hw₀
        exact h2 hw₀_E hw₀_Ub
    have hE₁_sub_E : E₁ ⊆ E_cur := hE_irred.2 hE₁_mem.1 hE_sub_E₁
    have hUb_sub_range : (U_b : Set ↥Y_b) ⊆ Set.range ιE.base := by
      rw [hRange_E]
      exact hUb_sub_E₁.trans hE₁_sub_E
    rw [eq_bot_iff]
    intro s' hs'
    rw [RingHom.mem_ker] at hs'
    have hpre_bot : (TopologicalSpace.Opens.map ιE.base).obj (Y_b.basicOpen s') = ⊥ := by
      rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hs',
        AlgebraicGeometry.Scheme.basicOpen_zero]
    have hYb_basic_bot : Y_b.basicOpen s' = ⊥ := by
      rw [eq_bot_iff]
      intro y hy
      exfalso
      have hy_Ub : y ∈ (U_b : Set ↥Y_b) := Y_b.basicOpen_le s' hy
      obtain ⟨w, hw⟩ := hUb_sub_range hy_Ub
      have hw_pre : w ∈ (TopologicalSpace.Opens.map ιE.base).obj (Y_b.basicOpen s') := by
        change ιE.base w ∈ Y_b.basicOpen s'
        rw [hw]
        exact hy
      rw [hpre_bot] at hw_pre
      exact hw_pre
    have hSpec_basic_bot : PrimeSpectrum.basicOpen s' = ⊥ := by
      rw [← hUb.fromSpec_preimage_basicOpen, hYb_basic_bot]
      rfl
    have hnil : IsNilpotent s' := (PrimeSpectrum.basicOpen_eq_bot_iff s').mp hSpec_basic_bot
    rw [Ideal.mem_bot]
    exact hnil.eq_zero

  have h𝔓_bot : 𝔓 = ⊥ := hDom_bot hDomB hker_ιE_bot
  have hUX_sub_range : (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base := by
    intro x hx
    let p := hUX.primeIdealOf ⟨x, hx⟩
    have hp_mem : hUX.fromSpec.base p ∈ Set.range ι_ℰ.base :=
      (hMem_iff p).mpr (by
        change 𝔓 ≤ p.asIdeal
        rw [h𝔓_bot]
        exact bot_le)
    rwa [hUX.fromSpec_primeIdealOf ⟨x, hx⟩] at hp_mem

  let e_bot : (B ⧸ 𝔓) ≃+* B := (Ideal.quotEquivOfEq h𝔓_bot).trans (RingEquiv.quotientBot B)
  have he_bot_mk : ∀ b : B, e_bot (Ideal.Quotient.mk 𝔓 b) = b := fun _ => rfl
  have hmk_e_bot : ∀ q : B ⧸ 𝔓, Ideal.Quotient.mk 𝔓 (e_bot q) = q := by
    intro q
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
    rw [he_bot_mk]
  let iso_quot_B : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ 𝔓)) ≅
      AlgebraicGeometry.Spec (CommRingCat.of B) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓))
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_bot.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h2 : (Ideal.Quotient.mk 𝔓).comp e_bot.toRingHom = RingHom.id (B ⧸ 𝔓) := by
          ext q; exact hmk_e_bot q
        rw [h2]
        exact AlgebraicGeometry.Spec.map_id _
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h1 : e_bot.toRingHom.comp (Ideal.Quotient.mk 𝔓) = RingHom.id B := by
          ext b; exact he_bot_mk b
        rw [h1]
        exact AlgebraicGeometry.Spec.map_id _ }
  let iso_W : W_ℰ.toScheme ≅ U_X.toScheme :=
    iso_sub ≪≫ iso_quot_B ≪≫ hUX.isoSpec.symm
  refine ⟨hUX_sub_range, iso_W, ?_⟩
  calc iso_W.hom ≫ U_X.ι
      = iso_sub.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓)) ≫
            (hUX.isoSpec.inv ≫ U_X.ι) := by
          simp [iso_W, iso_quot_B, CategoryTheory.Category.assoc]
    _ = iso_sub.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔓)) ≫
            hUX.fromSpec := by
          rw [hUX.isoSpec_inv_ι]
    _ = W_ℰ.ι ≫ ι_ℰ := hiso_sub.symm

theorem weil_smooth_and_semistable_chart_baseChange_and_curve_assembly : (∀ (R : Type u) [CommRing R]
        (X : AlgebraicGeometry.Scheme.{u})
        (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      (∀ (V_sm : X.Opens)
          (_ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g)) (x : ↥X),
        x ∈ V_sm →
        ∃ (W : X.Opens)
            (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
          x ∈ W ∧ W ≤ V_sm ∧ AlgebraicGeometry.Etale e ∧
          W.ι ≫ g = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∧
      (∀ (S : Type u) [CommRing S]
          (s : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R))
          (W : X.Opens)
          (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
        AlgebraicGeometry.Etale e →
        W.ι ≫ g = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        ∀ y : ↥(CategoryTheory.Limits.pullback g s),
          (CategoryTheory.Limits.pullback.fst g s).base y ∈ W →
          ∃ (U : (CategoryTheory.Limits.pullback g s).Opens)
            (hU : AlgebraicGeometry.IsAffineOpen U) (_ : y ∈ U)
            (ψ : Polynomial S →+*
              ↑((CategoryTheory.Limits.pullback g s).presheaf.obj (Opposite.op U))),
            ψ.Etale ∧
            hU.fromSpec ≫ CategoryTheory.Limits.pullback.snd g s =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp Polynomial.C))) ∧
      (∀ (S : Type u) [CommRing S] (φ : R →+* S)
          (W : X.Opens) (a : R)
          (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) R ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
        AlgebraicGeometry.Etale e →
        W.ι ≫ g = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk (Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp
              MvPolynomial.C)) →
        ∀ y : ↥(CategoryTheory.Limits.pullback g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))),
          (CategoryTheory.Limits.pullback.fst g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))).base y ∈ W →
          ∃ (U : (CategoryTheory.Limits.pullback g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))).Opens)
            (hU : AlgebraicGeometry.IsAffineOpen U) (_ : y ∈ U)
            (ψ : (MvPolynomial (Fin 2) S ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a)}) →+*
              ↑((CategoryTheory.Limits.pullback g
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))).presheaf.obj
                  (Opposite.op U))),
            ψ.Etale ∧
