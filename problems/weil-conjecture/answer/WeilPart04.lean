        obtain ⟨m_exp, hm⟩ := h_pow_int b
        obtain ⟨b₀, hb₀⟩ := hIntDesc (r ^ m_exp * b) hm
        exact ⟨m_exp, b₀, hb₀⟩
      let W_z : C_bar.Opens := C_bar.basicOpen r
      have hWz : AlgebraicGeometry.IsAffineOpen W_z := hVC.basicOpen r
      have e_Wz : W_z ≤ (TopologicalSpace.Opens.map f'.base).obj U_X :=
        le_trans (C_bar.basicOpen_le r) e_X
      have hz_Wz : z ∈ W_z := by
        have hzq : hVC.fromSpec.base q = z := hVC.fromSpec_primeIdealOf ⟨z, hz⟩
        rw [← hzq]
        change q ∈ (TopologicalSpace.Opens.map hVC.fromSpec.base).obj (C_bar.basicOpen r)
        rw [hVC.fromSpec_preimage_basicOpen r]
        exact hr_not_q
      let B_r := ↑(C_bar.presheaf.obj (Opposite.op W_z))
      let α_r : B_X →+* B_r := (f'.appLE U_X W_z e_Wz).hom
      have hα_r_eq : ∀ x : B_X, α_r x = algebraMap B_C B_r (α x) := by
        intro x
        have hmap := f'.appLE_map e_X (CategoryTheory.homOfLE (C_bar.basicOpen_le r)).op
        exact (congrArg (fun g => g.hom x) hmap).symm
      have hLoc_r : IsLocalization.Away r B_r := hVC.isLocalization_basicOpen r
      have hInj_Br : Function.Injective (algebraMap B_C B_r) := by
        have hSub : Submonoid.powers r ≤ nonZeroDivisors B_C :=
          Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hr_ne_zero)
        exact @IsLocalization.injective B_C _ (Submonoid.powers r) B_r _ _ hLoc_r hSub
      let : Algebra B_X B_r := α_r.toAlgebra
      have hLoc_r₀ : @IsLocalization.Away B_X _ r₀ B_r _ α_r.toAlgebra := by
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · rintro ⟨_, k, rfl⟩
          change IsUnit (α_r (r₀ ^ k))
          rw [hα_r_eq, map_pow, hr₀]
          exact @IsLocalization.map_units B_C _ (Submonoid.powers r) B_r _ _ hLoc_r ⟨r ^ k, k, rfl⟩
        · intro w
          obtain ⟨k, b, hwb⟩ := @IsLocalization.Away.surj B_C _ B_r _ _ r hLoc_r w
          obtain ⟨m_exp, b₀, hb₀⟩ := h_num b
          refine ⟨⟨b₀, ⟨r₀ ^ (k + m_exp), k + m_exp, rfl⟩⟩, ?_⟩
          change w * α_r (r₀ ^ (k + m_exp)) = α_r b₀
          rw [hα_r_eq (r₀ ^ (k + m_exp)), map_pow, hr₀, pow_add, map_mul, map_pow,
            ← mul_assoc, hwb, ← map_mul, mul_comm b (r ^ m_exp), ← hb₀, ← hα_r_eq b₀]
        · intro x₁ x₂ hx
          change α_r x₁ = α_r x₂ at hx
          rw [hα_r_eq x₁, hα_r_eq x₂] at hx
          have hx' : x₁ = x₂ := hInj_α (hInj_Br hx)
          exact ⟨⟨1, 0, pow_zero r₀⟩, by simp [hx']⟩
      have : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (f'.appLE U_X W_z e_Wz)) :=
        @AlgebraicGeometry.IsOpenImmersion.of_isLocalization B_X B_r _ _ α_r.toAlgebra r₀ hLoc_r₀
      have : AlgebraicGeometry.IsOpenImmersion (hWz.fromSpec ≫ f') := by
        rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hWz e_Wz]
        exact AlgebraicGeometry.IsOpenImmersion.comp
          (AlgebraicGeometry.Spec.map (f'.appLE U_X W_z e_Wz)) hUX.fromSpec
      have hOpen_ι : AlgebraicGeometry.IsOpenImmersion (W_z.ι ≫ f') := by
        have hIso_open : AlgebraicGeometry.IsOpenImmersion (hWz.isoSpec.hom ≫ (hWz.fromSpec ≫ f')) :=
          AlgebraicGeometry.IsOpenImmersion.comp hWz.isoSpec.hom (hWz.fromSpec ≫ f')
        rwa [← CategoryTheory.Category.assoc, hWz.isoSpec_hom, hWz.toSpecΓ_fromSpec] at hIso_open
      exact ⟨W_z, hz_Wz, hOpen_ι⟩
    choose W hzW hOpenW using hLocal
    have hInj_f' : Function.Injective ⇑f'.base := by
      intro z₁ z₂ hfz
      have : AlgebraicGeometry.IsOpenImmersion ((W z₁).ι ≫ f') := hOpenW z₁
      have : AlgebraicGeometry.IsOpenImmersion ((W z₂).ι ≫ f') := hOpenW z₂
      let O₁ : C_bar.Opens :=
        W z₁ ⊓ (TopologicalSpace.Opens.map f'.base).obj (((W z₂).ι ≫ f').opensRange)
      have hz₁_O₁ : z₁ ∈ O₁ := by
        refine ⟨hzW z₁, ?_⟩
        change f'.base z₁ ∈ (((W z₂).ι ≫ f').opensRange : Set ↥X)
        rw [((W z₂).ι ≫ f').coe_opensRange]
        exact ⟨⟨z₂, hzW z₂⟩, hfz.symm⟩
      have hO₁_ne : Nonempty ↥O₁ := ⟨⟨z₁, hz₁_O₁⟩⟩
      have hW₂_ne : Nonempty ↥(W z₂) := ⟨⟨z₂, hzW z₂⟩⟩
      have hRange_O₁ : Set.range ⇑(O₁.ι ≫ f').base ⊆ Set.range ⇑((W z₂).ι ≫ f').base := by
        rintro _ ⟨⟨w, _, hwPre⟩, rfl⟩
        change f'.base w ∈ (((W z₂).ι ≫ f').opensRange : Set ↥X) at hwPre
        rw [((W z₂).ι ≫ f').coe_opensRange] at hwPre
        exact hwPre
      let τ : O₁.toScheme ⟶ (W z₂).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift ((W z₂).ι ≫ f') (O₁.ι ≫ f') hRange_O₁
      have hτ_fac : τ ≫ ((W z₂).ι ≫ f') = O₁.ι ≫ f' :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ((W z₂).ι ≫ f') (O₁.ι ≫ f') hRange_O₁
      let η₁ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ O₁.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift O₁.ι η_C (hη_mem O₁ hO₁_ne)
      have hη₁_fac : η₁ ≫ O₁.ι = η_C :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι η_C (hη_mem O₁ hO₁_ne)
      let η₂ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ (W z₂).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (W z₂).ι η_C (hη_mem (W z₂) hW₂_ne)
      have hη₂_fac : η₂ ≫ (W z₂).ι = η_C :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W z₂).ι η_C (hη_mem (W z₂) hW₂_ne)
      have : AlgebraicGeometry.IsDominant η₁ := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
        intro u
        rw [mem_closure_iff]
        intro V_nb hV_open huV
        let V'_op : C_bar.Opens := ⟨⇑O₁.ι.base '' V_nb, O₁.ι.isOpenEmbedding.isOpenMap V_nb hV_open⟩
        have hV'_ne : Nonempty ↥V'_op := ⟨⟨O₁.ι.base u, u, huV, rfl⟩⟩
        let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := default
        have hmem : η_C.base pt₀ ∈ Set.range ⇑V'_op.ι.base :=
          hη_mem V'_op hV'_ne ⟨pt₀, rfl⟩
        rw [V'_op.range_ι] at hmem
        obtain ⟨v, hvV, hv_eq⟩ := hmem
        have hv_η₁ : O₁.ι.base v = O₁.ι.base (η₁.base pt₀) := by rw [hv_eq, ← hη₁_fac]; rfl
        have hv_eq' : v = η₁.base pt₀ := O₁.ι.isOpenEmbedding.injective hv_η₁
        exact ⟨η₁.base pt₀, hv_eq' ▸ hvV, pt₀, rfl⟩
      have hη_τ_eq : η₁ ≫ τ = η₂ := by
        apply (CategoryTheory.cancel_mono ((W z₂).ι ≫ f')).mp
        calc (η₁ ≫ τ) ≫ ((W z₂).ι ≫ f')
            = η₁ ≫ (τ ≫ ((W z₂).ι ≫ f')) := CategoryTheory.Category.assoc _ _ _
          _ = η₁ ≫ (O₁.ι ≫ f') := by rw [hτ_fac]
          _ = (η₁ ≫ O₁.ι) ≫ f' := (CategoryTheory.Category.assoc _ _ _).symm
          _ = η_C ≫ f' := by rw [hη₁_fac]
          _ = (η₂ ≫ (W z₂).ι) ≫ f' := by rw [hη₂_fac]
          _ = η₂ ≫ ((W z₂).ι ≫ f') := CategoryTheory.Category.assoc _ _ _
      have h_eq_ι : τ ≫ (W z₂).ι = O₁.ι :=
        AlgebraicGeometry.ext_of_isDominant_of_isSeparated f'
          (by rw [CategoryTheory.Category.assoc, hτ_fac]) η₁
          (by rw [← CategoryTheory.Category.assoc, hη_τ_eq, hη₂_fac, hη₁_fac])
      let u₁ : ↥O₁.toScheme := ⟨z₁, hz₁_O₁⟩
      let u₂ : ↥(W z₂).toScheme := ⟨z₂, hzW z₂⟩
      have hτ_u : τ.base u₁ = u₂ := by
        apply ((W z₂).ι ≫ f').isOpenEmbedding.injective
        calc ((W z₂).ι ≫ f').base (τ.base u₁)
            = (τ ≫ ((W z₂).ι ≫ f')).base u₁ := rfl
          _ = (O₁.ι ≫ f').base u₁ := by rw [hτ_fac]
          _ = f'.base z₁ := rfl
          _ = f'.base z₂ := hfz
          _ = ((W z₂).ι ≫ f').base u₂ := rfl
      have h_eval : (τ ≫ (W z₂).ι).base u₁ = O₁.ι.base u₁ :=
        congrArg (fun g : O₁.toScheme ⟶ C_bar => g.base u₁) h_eq_ι
      change (W z₂).ι.base (τ.base u₁) = z₁ at h_eval
      rw [hτ_u] at h_eval
      exact h_eval.symm
    have hSup : iSup W = (⊤ : C_bar.Opens) :=
      eq_top_iff.mpr fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzW z⟩
    have : AlgebraicGeometry.IsOpenImmersion f' :=
      AlgebraicGeometry.IsOpenImmersion.of_openCover_source f'
        (C_bar.openCoverOfIsOpenCover W (TopologicalSpace.IsOpenCover.mk hSup)) hInj_f'
        fun i => hOpenW i
    have : AlgebraicGeometry.IsDominant f' := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
      intro x
      rw [mem_closure_iff]
      intro o ho_open hxo
      let U_op : X.Opens := ⟨o, ho_open⟩
      have hxU : x ∈ U_op := hxo
      obtain ⟨U₀, hU₀_mem, hxU₀, hU₀_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens X)) hxU
      have hU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hU₀_mem
      obtain ⟨φ₀, _, hφ₀⟩ := hFuncX U₀ hU₀ ⟨⟨x, hxU₀⟩⟩
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := default
      have hfx_eq : f'.base (η_C.base pt₀) =
          hU₀.fromSpec.base ((AlgebraicGeometry.Spec.map φ₀).base pt₀) := by
        change (η_C ≫ f').base pt₀ = (AlgebraicGeometry.Spec.map φ₀ ≫ hU₀.fromSpec).base pt₀
        rw [hη, hφ₀]
      have hfx_mem_U₀ : f'.base (η_C.base pt₀) ∈ (U₀ : Set ↥X) := by
        rw [hfx_eq, ← hU₀.range_fromSpec]
        exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt₀, rfl⟩
      exact ⟨f'.base (η_C.base pt₀), hU₀_le hfx_mem_U₀, ⟨η_C.base pt₀, rfl⟩⟩
    have : AlgebraicGeometry.Surjective f' :=
      AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant f'
    exact (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective f').mpr
      ⟨inferInstance, inferInstance⟩
  
  have : CategoryTheory.IsIso π_1 := hIso_π1
  let f_dom_next : C_next ⟶ U'.toScheme := CategoryTheory.inv π_1 ≫ π_2
  have hq_fnext : q_contr ≫ f_dom_next = f_dom_cur := by
    dsimp only [f_dom_next]
    rw [← hτ_1, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc, hτ_2]
  have hfnext_g : f_dom_next ≫ (U'.ι ≫ g') = g_next := by
    dsimp only [f_dom_next]
    rw [CategoryTheory.Category.assoc, ← hComm_bar, CategoryTheory.IsIso.inv_hom_id_assoc]
  have hProp_next : AlgebraicGeometry.IsProper f_dom_next := by
    rw [AlgebraicGeometry.isProper_iff]
    have : AlgebraicGeometry.IsSeparated (f_dom_next ≫ (U'.ι ≫ g')) := by
      rw [hfnext_g]; exact hSS_next.2.2.1
    have : AlgebraicGeometry.LocallyOfFinitePresentation g_next := hSS_next.2.2.2.1
    have : AlgebraicGeometry.LocallyOfFiniteType (f_dom_next ≫ (U'.ι ≫ g')) := by
      rw [hfnext_g]; exact inferInstance
    have : AlgebraicGeometry.IsProper f_dom_cur := hProp_fdom
    have : AlgebraicGeometry.Surjective q_contr := hSurj_q
    have : AlgebraicGeometry.UniversallyClosed (q_contr ≫ f_dom_next) := by
      rw [hq_fnext]; exact inferInstance
    exact ⟨AlgebraicGeometry.IsSeparated.of_comp f_dom_next (U'.ι ≫ g'),
      AlgebraicGeometry.UniversallyClosed.of_comp_surjective q_contr f_dom_next,
      AlgebraicGeometry.locallyOfFiniteType_of_comp f_dom_next (U'.ι ≫ g')⟩
  exact ⟨f_dom_next, hq_fnext, hProp_next⟩

theorem weil_semistable_algebra_fiber_dichotomy_and_finiteness (K : Type u) [Field K] (V : ValuationSubring K)
    (B : Type u) [CommRing B] [Algebra ↥V B] [Algebra.FiniteType ↥V B]
    (Q : PrimeSpectrum ↥V)
    (hCharts : ∀ p : PrimeSpectrum B, ∃ b : B, b ∉ p.asIdeal ∧
      ((∃ ψ : Polynomial ↥V →+* Localization.Away b,
          ψ.Etale ∧ ψ.comp Polynomial.C = (algebraMap B (Localization.Away b)).comp (algebraMap ↥V B)) ∨
       (∃ (a : ↥V) (ψ : (MvPolynomial (Fin 2) ↥V ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* Localization.Away b),
          a ≠ 0 ∧ ψ.Etale ∧
          ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            (algebraMap B (Localization.Away b)).comp (algebraMap ↥V B)))) :
    (∀ q : PrimeSpectrum (Q.asIdeal.Fiber B),
      q.asIdeal ∈ minimalPrimes (Q.asIdeal.Fiber B) ∨ q.asIdeal.IsMaximal) ∧
    (∀ Z : Set (PrimeSpectrum (Q.asIdeal.Fiber B)),
      IsClosed Z → (∀ q ∈ Z, q.asIdeal ∉ minimalPrimes (Q.asIdeal.Fiber B)) → Z.Finite) ∧
    (∀ (p : PrimeSpectrum B) (hp : PrimeSpectrum.comap (algebraMap ↥V B) p = Q),
      (PrimeSpectrum.preimageHomeomorphFiber ↥V B Q ⟨p, hp⟩).asIdeal ∉
        minimalPrimes (Q.asIdeal.Fiber B) →
      ∀ x : p.asIdeal.ResidueField,
        @IsAlgebraic Q.asIdeal.ResidueField p.asIdeal.ResidueField _ _
          (Ideal.ResidueField.map Q.asIdeal p.asIdeal (algebraMap ↥V B)
            (congrArg PrimeSpectrum.asIdeal hp.symm)).toAlgebra x) :=
by
  let k_Q := Q.asIdeal.ResidueField
  let κ_Q : ↥V →+* k_Q := algebraMap ↥V k_Q
  let F_Q := Q.asIdeal.Fiber B
  
  have hNoChainOfDimLE1 : ∀ {R : Type u} [CommRing R] [Ring.KrullDimLE 1 R]
      (r₀ r₁ r₂ : PrimeSpectrum R), ¬ (r₀ < r₁ ∧ r₁ < r₂) := by
    intro R _ hDim r₀ r₁ r₂ ⟨hr₀₁, hr₁₂⟩
    have hDich : r₁.asIdeal ∈ minimalPrimes R ∨ r₁.asIdeal.IsMaximal :=
      @Ring.krullDimLE_one_iff R _ |>.mp hDim r₁.asIdeal r₁.isPrime
    rcases hDich with hMin | hMax
    · exact not_le_of_gt hr₀₁ (hMin.2 ⟨r₀.isPrime, bot_le⟩ (le_of_lt hr₀₁))
    · exact ne_of_lt hr₁₂ (PrimeSpectrum.ext (hMax.eq_of_le r₂.isPrime.ne_top (le_of_lt hr₁₂)))
  have hDimNod : ∀ abar : k_Q,
      Ring.KrullDimLE 1 (MvPolynomial (Fin 2) k_Q ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C abar}) := by
    intro abar
    let g : MvPolynomial (Fin 2) k_Q :=
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C abar
    have hg_ne : g ≠ 0 := by
      intro hg0
      have h0 : MvPolynomial.eval ![1, 0] g = 0 := by rw [hg0, map_zero]
      simp only [g, map_sub, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, mul_zero, zero_sub, neg_eq_zero] at h0
      have h1 : MvPolynomial.eval ![1, 1] g = 0 := by rw [hg0, map_zero]
      simp only [g, h0, map_mul, MvPolynomial.eval_X,
        Matrix.cons_val_zero, Matrix.cons_val_one, mul_one, map_zero, sub_zero] at h1
      exact one_ne_zero h1
    have hg_nzd : g ∈ nonZeroDivisors (MvPolynomial (Fin 2) k_Q) :=
      mem_nonZeroDivisors_of_ne_zero hg_ne
    have hdim := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hg_nzd
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add] at hdim
    refine Ring.krullDimLE_iff.mpr ?_
    rcases d : ringKrullDim (MvPolynomial (Fin 2) k_Q ⧸ Ideal.span {g}) with _ | (_ | n)
    · exact bot_le
    · exfalso
      rw [d] at hdim
      change ((⊤ : ℕ∞) : WithBot ℕ∞) + 1 ≤ ((2 : ℕ) : WithBot ℕ∞) at hdim
      have htop : (⊤ : ℕ∞) + 1 ≤ (2 : ℕ) := WithBot.coe_le_coe.mp hdim
      rw [top_add] at htop
      exact ENat.natCast_ne_top 2 (top_unique htop)
    · change ((n : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞)
      rw [d] at hdim
      change (((n + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ (((2 : ℕ) : ℕ∞) : WithBot ℕ∞) at hdim
      have hn : n + 1 ≤ 2 := Nat.cast_le.mp (WithBot.coe_le_coe.mp hdim)
      have hn1 : n ≤ 1 := by omega
      exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hn1)
  
  have hContractChain : ∀ {M₀ : Type u} [CommRing M₀] (c₀ : ↥V →+* M₀) (b : B)
      (ψ : M₀ →+* Localization.Away b),
      ψ.Etale →
      ψ.comp c₀ = (algebraMap B (Localization.Away b)).comp (algebraMap ↥V B) →
      ∀ (p₀ p₁ p₂ : PrimeSpectrum B),
        p₀ < p₁ → p₁ < p₂ →
        PrimeSpectrum.comap (algebraMap ↥V B) p₀ = Q →
        PrimeSpectrum.comap (algebraMap ↥V B) p₁ = Q →
        PrimeSpectrum.comap (algebraMap ↥V B) p₂ = Q →
        b ∉ p₂.asIdeal →
        ∃ (r₀ r₁ r₂ : PrimeSpectrum M₀),
          r₀ < r₁ ∧ r₁ < r₂ ∧
          PrimeSpectrum.comap c₀ r₀ = Q ∧
          PrimeSpectrum.comap c₀ r₁ = Q ∧
          PrimeSpectrum.comap c₀ r₂ = Q := by
    intro M₀ _ c₀ b ψ hEt hψ_comp p₀ p₁ p₂ hp₀₁ hp₁₂ hp₀ hp₁ hp₂ hb₂
    have hb₁ : b ∉ p₁.asIdeal := fun h => hb₂ (le_of_lt hp₁₂ h)
    have hb₀ : b ∉ p₀.asIdeal := fun h => hb₁ (le_of_lt hp₀₁ h)
    let hu : ∀ (p : PrimeSpectrum B), b ∉ p.asIdeal → IsUnit (algebraMap B p.asIdeal.ResidueField b) :=
      fun p hb => Ne.isUnit fun h0 => hb ((Ideal.ker_algebraMap_residueField p.asIdeal).le h0)
    let ρ : ∀ (p : PrimeSpectrum B), b ∉ p.asIdeal → Localization.Away b →+* p.asIdeal.ResidueField :=
      fun p hb => IsLocalization.Away.lift b (hu p hb)
    have hρ_eq : ∀ (p : PrimeSpectrum B) (hb : b ∉ p.asIdeal) (x : B),
        ρ p hb (algebraMap B (Localization.Away b) x) = algebraMap B p.asIdeal.ResidueField x :=
      fun p hb x => IsLocalization.Away.lift_eq b (hu p hb) x
    let pLift : ∀ (p : PrimeSpectrum B), b ∉ p.asIdeal → PrimeSpectrum (Localization.Away b) :=
      fun p hb => ⟨RingHom.ker (ρ p hb), RingHom.ker_isPrime (ρ p hb)⟩
    have hLift_comap : ∀ (p : PrimeSpectrum B) (hb : b ∉ p.asIdeal),
        PrimeSpectrum.comap (algebraMap B (Localization.Away b)) (pLift p hb) = p := by
      intro p hb
      ext x
      change ρ p hb (algebraMap B (Localization.Away b) x) = 0 ↔ x ∈ p.asIdeal
      rw [hρ_eq p hb x, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    have hLift_le : ∀ {p p' : PrimeSpectrum B} (hb : b ∉ p.asIdeal) (hb' : b ∉ p'.asIdeal),
        p ≤ p' → pLift p hb ≤ pLift p' hb' := by
      intro p p' hb hb' hle z hz
      change ρ p hb z = 0 at hz
      change ρ p' hb' z = 0
      obtain ⟨k, a_z, hza⟩ := IsLocalization.Away.surj b z
      have ha_zero : algebraMap B p.asIdeal.ResidueField a_z = 0 := by
        rw [← hρ_eq p hb a_z, ← hza, map_mul, hz, zero_mul]
      have ha_mem : a_z ∈ p'.asIdeal :=
        hle ((Ideal.ker_algebraMap_residueField p.asIdeal).le ha_zero)
      have ha'_zero : algebraMap B p'.asIdeal.ResidueField a_z = 0 :=
        (Ideal.ker_algebraMap_residueField p'.asIdeal).ge ha_mem
      have hmul : ρ p' hb' z * (algebraMap B p'.asIdeal.ResidueField b) ^ k = 0 := by
        calc
          ρ p' hb' z * (algebraMap B p'.asIdeal.ResidueField b) ^ k
              = ρ p' hb' z * (ρ p' hb' (algebraMap B (Localization.Away b) b)) ^ k := by
                rw [hρ_eq p' hb' b]
          _ = ρ p' hb' (z * algebraMap B (Localization.Away b) b ^ k) := by
                rw [← map_pow, ← map_mul]
          _ = ρ p' hb' (algebraMap B (Localization.Away b) a_z) := by rw [hza]
          _ = algebraMap B p'.asIdeal.ResidueField a_z := hρ_eq p' hb' a_z
          _ = 0 := ha'_zero
      have hb'_ne : algebraMap B p'.asIdeal.ResidueField b ≠ 0 :=
        fun h0 => hb' ((Ideal.ker_algebraMap_residueField p'.asIdeal).le h0)
      exact (mul_eq_zero.mp hmul).resolve_right (pow_ne_zero k hb'_ne)
    let p0_loc := pLift p₀ hb₀
    let p1_loc := pLift p₁ hb₁
    let p2_loc := pLift p₂ hb₂
    have hp01_loc : p0_loc < p1_loc := lt_of_le_of_ne (hLift_le hb₀ hb₁ (le_of_lt hp₀₁))
      (fun heq => ne_of_lt hp₀₁ (by
        rw [← hLift_comap p₀ hb₀, ← hLift_comap p₁ hb₁]
        exact congrArg (PrimeSpectrum.comap (algebraMap B (Localization.Away b))) heq))
    have hp12_loc : p1_loc < p2_loc := lt_of_le_of_ne (hLift_le hb₁ hb₂ (le_of_lt hp₁₂))
      (fun heq => ne_of_lt hp₁₂ (by
        rw [← hLift_comap p₁ hb₁, ← hLift_comap p₂ hb₂]
        exact congrArg (PrimeSpectrum.comap (algebraMap B (Localization.Away b))) heq))
    let _ : Algebra M₀ (Localization.Away b) := ψ.toAlgebra
    have _ : Algebra.Etale M₀ (Localization.Away b) := hEt.toAlgebra
    have _ : Algebra.QuasiFinite M₀ (Localization.Away b) := inferInstance
    have hIncomp : ∀ (q q' : PrimeSpectrum (Localization.Away b)),
        q ≤ q' → PrimeSpectrum.comap ψ q = PrimeSpectrum.comap ψ q' → q = q' := by
      intro q q' hqq' h_eq
      let r : PrimeSpectrum M₀ := PrimeSpectrum.comap ψ q
      let e_r := PrimeSpectrum.preimageOrderIsoFiber M₀ (Localization.Away b) r
      have hq_r : PrimeSpectrum.comap (algebraMap M₀ (Localization.Away b)) q = r := rfl
      have hq'_r : PrimeSpectrum.comap (algebraMap M₀ (Localization.Away b)) q' = r := h_eq.symm
      let w := e_r ⟨q, hq_r⟩
      let w' := e_r ⟨q', hq'_r⟩
      have hw_le : w.asIdeal ≤ w'.asIdeal := e_r.monotone hqq'
      let k_r := r.asIdeal.ResidueField
      let F_r := r.asIdeal.Fiber (Localization.Away b)
      have _ : Module.Finite k_r F_r := Algebra.QuasiFinite.finite_fiber r.asIdeal
      have _ : Algebra.IsIntegral k_r F_r := inferInstance
      have _ : (Ideal.under k_r w.asIdeal).IsPrime := w.isPrime.comap (algebraMap k_r F_r)
      have hbot : Ideal.under k_r w.asIdeal = (⊥ : Ideal k_r) :=
        Ideal.eq_bot_of_prime (Ideal.under k_r w.asIdeal)
      have _ : w.asIdeal.LiesOver (⊥ : Ideal k_r) := Ideal.LiesOver.mk hbot.symm
      have _ : (⊥ : Ideal k_r).IsMaximal := Ideal.bot_isMaximal
      have _ : w.asIdeal.IsPrime := w.isPrime
      have hw_max : w.asIdeal.IsMaximal :=
        Ideal.IsMaximal.of_liesOver_isMaximal w.asIdeal (⊥ : Ideal k_r)
      have hw_eq : w = w' := PrimeSpectrum.ext (hw_max.eq_of_le w'.isPrime.ne_top hw_le)
      exact congrArg Subtype.val (e_r.injective hw_eq)
    let r₀ : PrimeSpectrum M₀ := PrimeSpectrum.comap ψ p0_loc
    let r₁ : PrimeSpectrum M₀ := PrimeSpectrum.comap ψ p1_loc
    let r₂ : PrimeSpectrum M₀ := PrimeSpectrum.comap ψ p2_loc
    have hr_comap : ∀ (p : PrimeSpectrum B) (hb : b ∉ p.asIdeal),
        PrimeSpectrum.comap (algebraMap ↥V B) p = Q →
        PrimeSpectrum.comap c₀ (PrimeSpectrum.comap ψ (pLift p hb)) = Q := by
      intro p hb hp
      ext v
      change (ψ.comp c₀) v ∈ (pLift p hb).asIdeal ↔ v ∈ Q.asIdeal
      rw [hψ_comp]
      change algebraMap ↥V B v ∈
        (PrimeSpectrum.comap (algebraMap B (Localization.Away b)) (pLift p hb)).asIdeal ↔
        v ∈ Q.asIdeal
      rw [hLift_comap p hb, ← hp]
      rfl
    have hr₀₁ : r₀ < r₁ := lt_of_le_of_ne (Ideal.comap_mono (le_of_lt hp01_loc))
      (fun heq => ne_of_lt hp01_loc (hIncomp p0_loc p1_loc (le_of_lt hp01_loc) heq))
    have hr₁₂ : r₁ < r₂ := lt_of_le_of_ne (Ideal.comap_mono (le_of_lt hp12_loc))
      (fun heq => ne_of_lt hp12_loc (hIncomp p1_loc p2_loc (le_of_lt hp12_loc) heq))
    exact ⟨r₀, r₁, r₂, hr₀₁, hr₁₂, hr_comap p₀ hb₀ hp₀, hr_comap p₁ hb₁ hp₁, hr_comap p₂ hb₂ hp₂⟩
  
  have hClearConst : ∀ z : k_Q, ∃ u s : ↥V, s ∉ Q.asIdeal ∧ κ_Q s * z = κ_Q u := by
    intro z
    have _ : IsDomain (↥V ⧸ Q.asIdeal) := Ideal.Quotient.isDomain Q.asIdeal
    obtain ⟨⟨ubar, sbar⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors (↥V ⧸ Q.asIdeal)) z
    obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective ubar
    obtain ⟨s, hs_eq⟩ := Ideal.Quotient.mk_surjective sbar.1
    have hs : s ∉ Q.asIdeal := by
      intro hsQ
      apply mem_nonZeroDivisors_iff_ne_zero.mp sbar.2
      rw [← hs_eq, Ideal.Quotient.eq_zero_iff_mem]
      exact hsQ
    refine ⟨u, s, hs, ?_⟩
    have hzs' : z * algebraMap (↥V ⧸ Q.asIdeal) k_Q (algebraMap ↥V (↥V ⧸ Q.asIdeal) s) =
        algebraMap (↥V ⧸ Q.asIdeal) k_Q (algebraMap ↥V (↥V ⧸ Q.asIdeal) u) := by
      change z * algebraMap (↥V ⧸ Q.asIdeal) k_Q (Ideal.Quotient.mk Q.asIdeal s) =
        algebraMap (↥V ⧸ Q.asIdeal) k_Q (Ideal.Quotient.mk Q.asIdeal u)
      simpa [hs_eq] using hzs
    rw [← IsScalarTower.algebraMap_apply ↥V (↥V ⧸ Q.asIdeal) k_Q s,
      ← IsScalarTower.algebraMap_apply ↥V (↥V ⧸ Q.asIdeal) k_Q u] at hzs'
    rw [mul_comm]
    exact hzs'
  have hNoChainModel : ∀ {M₀ : Type u} [CommRing M₀] (c₀ : ↥V →+* M₀)
      {Mbar₀ : Type u} [CommRing Mbar₀] [Algebra k_Q Mbar₀] [Ring.KrullDimLE 1 Mbar₀]
      (Φ : M₀ →+* Mbar₀),
      (∀ (R_r : Type u) [Field R_r] (κ_r : M₀ →+* R_r) (ι_r : k_Q →+* R_r),
        (∀ v : ↥V, ι_r (κ_Q v) = κ_r (c₀ v)) →
        ∃ pi_r : Mbar₀ →+* R_r,
          pi_r.comp Φ = κ_r ∧
          pi_r.comp (algebraMap k_Q Mbar₀) = ι_r) →
      (∀ f : Mbar₀, ∃ s : ↥V, s ∉ Q.asIdeal ∧ ∃ m : M₀, algebraMap k_Q Mbar₀ (κ_Q s) * f = Φ m) →
      ∀ (r₀ r₁ r₂ : PrimeSpectrum M₀),
        r₀ < r₁ → r₁ < r₂ →
        PrimeSpectrum.comap c₀ r₀ = Q →
        PrimeSpectrum.comap c₀ r₁ = Q →
        PrimeSpectrum.comap c₀ r₂ = Q → False := by
    intro M₀ _ c₀ Mbar₀ _ _ _ Φ hLiftRes hClear r₀ r₁ r₂ hr₀₁ hr₁₂ hr₀ hr₁ hr₂
    have hPush : ∀ (r : PrimeSpectrum M₀) (hr : PrimeSpectrum.comap c₀ r = Q),
        ∃ rbar : PrimeSpectrum Mbar₀, PrimeSpectrum.comap Φ rbar = r ∧
          ∃ pi_r : Mbar₀ →+* r.asIdeal.ResidueField,
            rbar.asIdeal = RingHom.ker pi_r ∧
            pi_r.comp Φ = algebraMap M₀ r.asIdeal.ResidueField ∧
            pi_r.comp (algebraMap k_Q Mbar₀) =
              Ideal.ResidueField.map Q.asIdeal r.asIdeal c₀
                (congrArg PrimeSpectrum.asIdeal hr.symm) := by
      intro r hr
      let ι_r : k_Q →+* r.asIdeal.ResidueField :=
        Ideal.ResidueField.map Q.asIdeal r.asIdeal c₀ (congrArg PrimeSpectrum.asIdeal hr.symm)
      have hικ : ∀ v : ↥V, ι_r (κ_Q v) = algebraMap M₀ r.asIdeal.ResidueField (c₀ v) :=
        fun v => Ideal.ResidueField.map_algebraMap Q.asIdeal r.asIdeal c₀ _ v
      obtain ⟨pi_r, hπΦ, hπk⟩ :=
        hLiftRes r.asIdeal.ResidueField (algebraMap M₀ r.asIdeal.ResidueField) ι_r hικ
      let rbar : PrimeSpectrum Mbar₀ := ⟨RingHom.ker pi_r, RingHom.ker_isPrime pi_r⟩
      refine ⟨rbar, ?_, pi_r, rfl, hπΦ, hπk⟩
      ext m
      change (pi_r.comp Φ) m = 0 ↔ m ∈ r.asIdeal
      rw [hπΦ, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    obtain ⟨rbar₀, hcomap₀, pi₀, hrbar₀_ker, hπΦ₀, _⟩ := hPush r₀ hr₀
    obtain ⟨rbar₁, hcomap₁, pi₁, hrbar₁_ker, hπΦ₁, hπk₁⟩ := hPush r₁ hr₁
    obtain ⟨rbar₂, hcomap₂, pi₂, hrbar₂_ker, hπΦ₂, hπk₂⟩ := hPush r₂ hr₂
    have hMono : ∀ {ra rb : PrimeSpectrum M₀} {rbara rbarb : PrimeSpectrum Mbar₀}
        (hrb : PrimeSpectrum.comap c₀ rb = Q)
        (pia : Mbar₀ →+* ra.asIdeal.ResidueField) (pib : Mbar₀ →+* rb.asIdeal.ResidueField),
        rbara.asIdeal = RingHom.ker pia →
        rbarb.asIdeal = RingHom.ker pib →
        pia.comp Φ = algebraMap M₀ ra.asIdeal.ResidueField →
        pib.comp Φ = algebraMap M₀ rb.asIdeal.ResidueField →
        pib.comp (algebraMap k_Q Mbar₀) =
          Ideal.ResidueField.map Q.asIdeal rb.asIdeal c₀
            (congrArg PrimeSpectrum.asIdeal hrb.symm) →
        ra ≤ rb → rbara ≤ rbarb := by
      intro ra rb rbara rbarb _ pia pib hka hkb hΦa hΦb _ hle f hf
      rw [hka, RingHom.mem_ker] at hf
      rw [hkb, RingHom.mem_ker]
      obtain ⟨s, hs, m, hsm⟩ := hClear f
      have hm_zero_a : algebraMap M₀ ra.asIdeal.ResidueField m = 0 := by
        calc
          algebraMap M₀ ra.asIdeal.ResidueField m = (pia.comp Φ) m := by rw [hΦa]
          _ = pia (Φ m) := rfl
          _ = pia (algebraMap k_Q Mbar₀ (κ_Q s) * f) := by rw [← hsm]
          _ = pia (algebraMap k_Q Mbar₀ (κ_Q s)) * pia f := map_mul _ _ _
          _ = 0 := by rw [hf, mul_zero]
      have hm_b : m ∈ rb.asIdeal :=
        hle ((Ideal.ker_algebraMap_residueField ra.asIdeal).le hm_zero_a)
      have hm_zero_b : algebraMap M₀ rb.asIdeal.ResidueField m = 0 :=
        (Ideal.ker_algebraMap_residueField rb.asIdeal).ge hm_b
      have hmul_b : (pib.comp (algebraMap k_Q Mbar₀)) (κ_Q s) * pib f = 0 := by
        calc
          (pib.comp (algebraMap k_Q Mbar₀)) (κ_Q s) * pib f
              = pib (algebraMap k_Q Mbar₀ (κ_Q s) * f) := by rw [RingHom.comp_apply, map_mul]
          _ = pib (Φ m) := by rw [hsm]
          _ = (pib.comp Φ) m := rfl
          _ = algebraMap M₀ rb.asIdeal.ResidueField m := by rw [hΦb]
          _ = 0 := hm_zero_b
      have hκs_ne : κ_Q s ≠ 0 :=
        fun h0 => hs ((Ideal.ker_algebraMap_residueField Q.asIdeal).le h0)
      have hfactor_ne : (pib.comp (algebraMap k_Q Mbar₀)) (κ_Q s) ≠ 0 :=
        (map_ne_zero_iff _ (RingHom.injective _)).mpr hκs_ne
      exact (mul_eq_zero.mp hmul_b).resolve_left hfactor_ne
    have hrbar₀₁_le : rbar₀ ≤ rbar₁ :=
      hMono hr₁ pi₀ pi₁ hrbar₀_ker hrbar₁_ker hπΦ₀ hπΦ₁ hπk₁ (le_of_lt hr₀₁)
    have hrbar₁₂_le : rbar₁ ≤ rbar₂ :=
      hMono hr₂ pi₁ pi₂ hrbar₁_ker hrbar₂_ker hπΦ₁ hπΦ₂ hπk₂ (le_of_lt hr₁₂)
    have hrbar₀₁ : rbar₀ < rbar₁ :=
      lt_of_le_of_ne hrbar₀₁_le (fun heq => ne_of_lt hr₀₁ (by rw [← hcomap₀, ← hcomap₁, heq]))
    have hrbar₁₂ : rbar₁ < rbar₂ :=
      lt_of_le_of_ne hrbar₁₂_le (fun heq => ne_of_lt hr₁₂ (by rw [← hcomap₁, ← hcomap₂, heq]))
    exact hNoChainOfDimLE1 rbar₀ rbar₁ rbar₂ ⟨hrbar₀₁, hrbar₁₂⟩
  have hNoChainSmooth : ∀ (r₀ r₁ r₂ : PrimeSpectrum (Polynomial ↥V)),
      r₀ < r₁ → r₁ < r₂ →
      PrimeSpectrum.comap Polynomial.C r₀ = Q →
      PrimeSpectrum.comap Polynomial.C r₁ = Q →
      PrimeSpectrum.comap Polynomial.C r₂ = Q → False := by
    refine hNoChainModel (M₀ := Polynomial ↥V) (Mbar₀ := Polynomial k_Q)
      Polynomial.C (Polynomial.mapRingHom κ_Q) ?_ ?_
    · intro R_r _ κ_r ι_r hικ
      refine ⟨Polynomial.eval₂RingHom ι_r (κ_r Polynomial.X), ?_, ?_⟩
      · apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro v
          simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact hικ v
        · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
