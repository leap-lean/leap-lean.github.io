        obtain ⟨s₁, hs₁, m₁, h₁⟩ := ihp
        obtain ⟨s₂, hs₂, m₂, h₂⟩ := ihq
        refine ⟨s₁ * s₂, Q.asIdeal.primeCompl.mul_mem hs₁ hs₂,
          Polynomial.C s₂ * m₁ + Polynomial.C s₁ * m₂, ?_⟩
        change Polynomial.C (κ_Q (s₁ * s₂)) * (p + q) =
