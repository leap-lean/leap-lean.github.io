        _ = ι_z.comp (algebraMap D_V O_z) := by rw [hφ_alg]
        _ = algebraMap D_V F_Q := hιz_alg
        _ = ι_val.comp (algebraMap D_V O_y) := hι_alg.symm
    let μ_z : ↥V →+* O_z := (algebraMap D_V O_z).comp mkQ
    have hιz_μz : ι_z.comp μ_z = ν_Q := by
      calc ι_z.comp ((algebraMap D_V O_z).comp mkQ)
        _ = (ι_z.comp (algebraMap D_V O_z)).comp mkQ := rfl
        _ = (algebraMap D_V F_Q).comp mkQ := by rw [hιz_alg]
    have hφ_μy : φ_yz.comp μ_y = μ_z := by
      calc φ_yz.comp ((algebraMap D_V O_y).comp mkQ)
        _ = (φ_yz.comp (algebraMap D_V O_y)).comp mkQ := rfl
        _ = (algebraMap D_V O_z).comp mkQ := by rw [hφ_alg]
    have htz_bar_z_not : mkQ t_z ∉ P_bar_z := by
      intro hmem
      apply ht_z
      rw [← hPbar_z_comap]
      exact hmem
    have hμz_unit : IsUnit (μ_z t_z) :=
      IsLocalization.map_units O_z (⟨mkQ t_z, htz_bar_z_not⟩ : P_bar_z.primeCompl)
    have hμz_ker : RingHom.ker μ_z = Q := by
      rw [← hνQ_ker, ← hιz_μz]
      ext v
      change μ_z v = 0 ↔ ι_z (μ_z v) = 0
      exact (map_eq_zero_iff ι_z hInj_z).symm
    obtain ⟨τ_z, hτz_comp, _⟩ := hDomainLift q O_z μ_z hμz_unit hμz_ker
    have hιz_τz : ι_z.comp τ_z = ν_Z := by
      apply hLiftUnique F_Q ν_Q
      · calc (ι_z.comp τ_z).comp φ_Z
          _ = ι_z.comp (τ_z.comp φ_Z) := rfl
          _ = ι_z.comp μ_z := by rw [hτz_comp]
          _ = ν_Q := hιz_μz
      · exact hνZ_comp
    let η_z : AlgebraicGeometry.Spec (CommRingCat.of F_Q) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of O_z) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_z)
    have : AlgebraicGeometry.IsDominant η_z := hIsDomOfInj O_z F_Q ι_z hInj_z
    let α_z1 : AlgebraicGeometry.Spec (CommRingCat.of O_z) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_yz) ≫ α_y
    let α_z2 : AlgebraicGeometry.Spec (CommRingCat.of O_z) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z) ≫ σ_Z
    have hαz_comm : α_z1 ≫ g_X = α_z2 ≫ g_X := by
      calc α_z1 ≫ g_X
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_yz) ≫ (α_y ≫ g_X) :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_yz) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_y) := by rw [hαy_comm]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_y ≫ CommRingCat.ofHom φ_yz) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_yz.comp μ_y)) := by
          rw [← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_z) := by rw [hφ_μy]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_z.comp φ_Z)) := by rw [hτz_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z ≫ CommRingCat.ofHom τ_z) := by
          rw [CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z) :=
          AlgebraicGeometry.Spec.map_comp _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z) ≫ (σ_Z ≫ g_X) := by
          rw [← hσ_comm]
        _ = α_z2 ≫ g_X := (CategoryTheory.Category.assoc _ _ _).symm
    have hηz_eq : η_z ≫ α_z1 = η_z ≫ α_z2 := by
      have hηz_1 : η_z ≫ α_z1 = ψ_F := by
        calc η_z ≫ α_z1
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_z) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_yz)) ≫ α_y :=
            (CategoryTheory.Category.assoc _ _ _).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_yz ≫ CommRingCat.ofHom ι_z) ≫ α_y := by
            rw [← AlgebraicGeometry.Spec.map_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_z.comp φ_yz)) ≫ α_y := by
            rw [← CommRingCat.ofHom_comp]
          _ = η_y ≫ α_y := by rw [hιz_φ]
          _ = ψ_F := hηy_αy
      have hηz_2 : η_z ≫ α_z2 = ψ_F := by
        calc η_z ≫ α_z2
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_z) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z)) ≫ σ_Z :=
            (CategoryTheory.Category.assoc _ _ _).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z ≫ CommRingCat.ofHom ι_z) ≫ σ_Z := by
            rw [← AlgebraicGeometry.Spec.map_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_z.comp τ_z)) ≫ σ_Z := by
            rw [← CommRingCat.ofHom_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Z) ≫ σ_Z := by rw [hιz_τz]
          _ = ψ_F := rfl
      exact hηz_1.trans hηz_2.symm
    have hαz_eq : α_z1 = α_z2 :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_X hαz_comm η_z hηz_eq
    let m_z : ↥(AlgebraicGeometry.Spec (CommRingCat.of O_z)) :=
      ⟨IsLocalRing.maximalIdeal O_z, (IsLocalRing.maximalIdeal.isMaximal O_z).isPrime⟩
    have hτz_mz : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z)).base m_z = m_Z := by
      apply hComap_inj
      apply PrimeSpectrum.ext
      change Ideal.comap φ_Z
          (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z)).base m_z).asIdeal :
            Ideal (R_z ⧸ I_zc)) =
        Ideal.comap φ_Z m_Z.asIdeal
      rw [AlgebraicGeometry.Spec.map_base, hmZ_comap]
      calc Ideal.comap φ_Z (Ideal.comap τ_z (IsLocalRing.maximalIdeal O_z))
        _ = Ideal.comap (τ_z.comp φ_Z) (IsLocalRing.maximalIdeal O_z) := rfl
        _ = Ideal.comap μ_z (IsLocalRing.maximalIdeal O_z) := by rw [hτz_comp]
        _ = P_z := by
          ext v
          change algebraMap D_V O_z (mkQ v) ∈ IsLocalRing.maximalIdeal O_z ↔
            v ∈ P_z
          rw [IsLocalization.AtPrime.to_map_mem_maximal_iff O_z P_bar_z]
          change v ∈ Ideal.comap mkQ P_bar_z ↔ v ∈ P_z
          rw [hPbar_z_comap]
    let ξ_z : ↥(AlgebraicGeometry.Spec (CommRingCat.of O_y)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_yz)).base m_z
    have hαy_ξz : α_y.base ξ_z = z := by
      calc α_y.base ξ_z
        _ = α_z1.base m_z := rfl
        _ = α_z2.base m_z := congrArg (fun h => h.base m_z) hαz_eq
        _ = σ_Z.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_z)).base m_z) := rfl
        _ = σ_Z.base m_Z := by rw [hτz_mz]
        _ = z := hm_Z
    have hmy_cl_ξz : m_y ∈ closure ({ξ_z} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of O_y))) := by
      let my' : PrimeSpectrum O_y := m_y
      let ξz' : PrimeSpectrum O_y := ξ_z
      have hcl' : my' ∈ closure ({ξz'} : Set (PrimeSpectrum O_y)) := by
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
        exact SetLike.coe_subset_coe.mpr (IsLocalRing.le_maximalIdeal ξz'.isPrime.ne_top)
      exact hcl'
    have hPre_cl : IsClosed (α_y.base ⁻¹' ({z} : Set X)) := hz_cl.preimage α_y.continuous
    have hξz_pre : ({ξ_z} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of O_y))) ⊆
        α_y.base ⁻¹' ({z} : Set X) :=
      Set.singleton_subset_iff.mpr hαy_ξz
    have hmy_pre : m_y ∈ α_y.base ⁻¹' ({z} : Set X) :=
      (hPre_cl.closure_subset_iff.mpr hξz_pre) hmy_cl_ξz
    have hy_eq_z : y = z := by
      rw [← hαy_my]
      exact hmy_pre
    rw [hy_eq_z]
    exact ⟨m_Z, hm_Z⟩

theorem weil_etale_chart_two_open_pullback_gluing {X M Y_sm S_0 : AlgebraicGeometry.Scheme.{u}}
    (W : X.Opens)
    {A_global A_loc : CommRingCat.{u}}
    (φ_glob_loc : A_global ⟶ A_loc)
    (e : W.toScheme ⟶ AlgebraicGeometry.Spec A_global)
    (j_W : S_0 ⟶ W.toScheme)
    (hOpen_jW : AlgebraicGeometry.IsOpenImmersion j_W)
    (e_0 : S_0 ⟶ AlgebraicGeometry.Spec A_loc)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he_0 : e_0 ≫ AlgebraicGeometry.Spec.map φ_glob_loc = j_W ≫ e)
    (p_M : M ⟶ AlgebraicGeometry.Spec A_loc)
    (hProp_M : AlgebraicGeometry.IsProper p_M)
    (U_loc_iso : (AlgebraicGeometry.Spec A_loc).Opens)
    (hIso_M : CategoryTheory.IsIso (p_M ∣_ U_loc_iso))
    (U_iso : X.Opens)
    (hCompl : (U_iso : Set X)ᶜ =
      (j_W ≫ W.ι).base '' ((e_0.base) ⁻¹' (U_loc_iso : Set ↥(AlgebraicGeometry.Spec A_loc))ᶜ))
    (U_M : M.Opens)
    (e_M : U_M.toScheme ⟶ Y_sm)
    (hEt_M : AlgebraicGeometry.Etale e_M) :
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (f_bl : X' ⟶ X)
      (V_sm' : X'.Opens)
      (e' : V_sm'.toScheme ⟶ Y_sm)
      (α_M : V_sm'.toScheme ⟶ U_M.toScheme)
      (ι_W : CategoryTheory.Limits.pullback e_0 p_M ⟶ X')
      (ι_U : U_iso.toScheme ⟶ X'),
      AlgebraicGeometry.IsOpenImmersion ι_W ∧
      AlgebraicGeometry.IsOpenImmersion ι_U ∧
      (∀ y : X', y ∈ Set.range ι_W.base ∨ y ∈ Set.range ι_U.base) ∧
      ι_W ≫ f_bl = CategoryTheory.Limits.pullback.fst e_0 p_M ≫ j_W ≫ W.ι ∧
      ι_U ≫ f_bl = U_iso.ι ∧
      V_sm' ≤ (TopologicalSpace.Opens.map f_bl.base).obj W ∧
      AlgebraicGeometry.IsProper f_bl ∧
      CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
      AlgebraicGeometry.Etale α_M ∧
      AlgebraicGeometry.Etale e' ∧
      e' = α_M ≫ e_M ∧
      (∃ β_W : V_sm'.toScheme ⟶ S_0,
        V_sm'.ι ≫ f_bl = β_W ≫ j_W ≫ W.ι ∧
        β_W ≫ e_0 = α_M ≫ U_M.ι ≫ p_M) ∧
      (∀ (R : Type u) [CommRing R] [IsLocalRing R]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X')
          (mR : AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W.toScheme),
        mR.asIdeal = IsLocalRing.maximalIdeal R →
        (ψ ≫ f_bl).base mR ∉ U_iso →
        ψ_W ≫ W.ι = ψ ≫ f_bl →
        ∃ (ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M)
          (ψ_S0 : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ S_0),
          ψ_M ≫ p_M ≫ AlgebraicGeometry.Spec.map φ_glob_loc = ψ_W ≫ e ∧
          ψ_M ≫ p_M = ψ_S0 ≫ e_0 ∧
          ψ_S0 ≫ j_W ≫ W.ι = ψ ≫ f_bl ∧
          (∀ ψ_UM : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U_M.toScheme,
            ψ_UM ≫ U_M.ι = ψ_M →
            ∃ ψ_V : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ V_sm'.toScheme,
              ψ_V ≫ V_sm'.ι = ψ ∧
              ψ_V ≫ e' = ψ_UM ≫ e_M) ∧
          (Set.range ψ_M.base ⊆ (U_M : Set M) →
            Set.range ψ.base ⊆ (V_sm' : Set X'))) :=
by
  
  let ι_0 : S_0 ⟶ X := j_W ≫ W.ι
  have : AlgebraicGeometry.IsOpenImmersion j_W := hOpen_jW
  have : AlgebraicGeometry.IsOpenImmersion ι_0 := inferInstance
  have hInj_0 : Function.Injective ι_0.base := ι_0.isOpenEmbedding.injective
  let W_tilde : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback e_0 p_M
  let π_0 : W_tilde ⟶ S_0 := CategoryTheory.Limits.pullback.fst e_0 p_M
  let π_M : W_tilde ⟶ M := CategoryTheory.Limits.pullback.snd e_0 p_M
  have : AlgebraicGeometry.IsProper p_M := hProp_M
  have : AlgebraicGeometry.Etale e_0 := hEt_e0
  have : AlgebraicGeometry.Etale e_M := hEt_M
  have : AlgebraicGeometry.IsProper π_0 := inferInstance
  have : AlgebraicGeometry.Etale π_M := inferInstance
  let S_01 : S_0.Opens := (TopologicalSpace.Opens.map ι_0.base).obj U_iso
  let S_tilde_01 : W_tilde.Opens := (TopologicalSpace.Opens.map π_0.base).obj S_01
  have hS01_iff : ∀ p : S_0, p ∈ S_01 ↔ e_0.base p ∈ U_loc_iso := by
    intro p
    rw [← not_iff_not]
    change ι_0.base p ∈ (U_iso : Set X)ᶜ ↔
      e_0.base p ∈ (U_loc_iso : Set ↥(AlgebraicGeometry.Spec A_loc))ᶜ
    rw [hCompl]
    change ι_0.base p ∈
      ι_0.base '' (e_0.base ⁻¹' (U_loc_iso : Set ↥(AlgebraicGeometry.Spec A_loc))ᶜ) ↔ _
    constructor
    · rintro ⟨p', hp', hp'_eq⟩
      have hp_eq : p' = p := hInj_0 hp'_eq
      rwa [hp_eq] at hp'
    · intro hp
      exact ⟨p, hp, rfl⟩
  let W_0 : X.Opens := ι_0.opensRange
  have hTop_X : (⨆ b : Bool, cond b W_0 U_iso) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hx : x ∈ U_iso
    · exact ⟨false, hx⟩
    · have hx_c : x ∈ (U_iso : Set X)ᶜ := hx
      rw [hCompl] at hx_c
      rcases hx_c with ⟨p, _, hp_eq⟩
      exact ⟨true, ⟨p, hp_eq⟩⟩

  
  let M_01 : M.Opens := (TopologicalSpace.Opens.map p_M.base).obj U_loc_iso
  have hSub_0 : Set.range (S_01.ι ≫ e_0).base ⊆ Set.range U_loc_iso.ι.base := by
    rintro _ ⟨q, rfl⟩
    have hq : e_0.base q.1 ∈ U_loc_iso := (hS01_iff q.1).mp q.2
    exact ⟨⟨e_0.base q.1, hq⟩, rfl⟩
  let g_0 : S_01.toScheme ⟶ U_loc_iso.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_loc_iso.ι (S_01.ι ≫ e_0) hSub_0
  have hg_0 : g_0 ≫ U_loc_iso.ι = S_01.ι ≫ e_0 :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_loc_iso.ι (S_01.ι ≫ e_0) hSub_0
  have hSub_M : Set.range (S_tilde_01.ι ≫ π_M).base ⊆ Set.range M_01.ι.base := by
    rintro _ ⟨w, rfl⟩
    have hw0 : e_0.base (π_0.base w.1) ∈ U_loc_iso := (hS01_iff (π_0.base w.1)).mp w.2
    have hcond : e_0.base (π_0.base w.1) = p_M.base (π_M.base w.1) :=
      congrArg (fun h => h.base w.1) (CategoryTheory.Limits.pullback.condition (f := e_0) (g := p_M))
    have hwM : π_M.base w.1 ∈ M_01 := by
      change p_M.base (π_M.base w.1) ∈ U_loc_iso
      rwa [← hcond]
    exact ⟨⟨π_M.base w.1, hwM⟩, rfl⟩
  let g_M : S_tilde_01.toScheme ⟶ M_01.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift M_01.ι (S_tilde_01.ι ≫ π_M) hSub_M
  have hg_M : g_M ≫ M_01.ι = S_tilde_01.ι ≫ π_M :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac M_01.ι (S_tilde_01.ι ≫ π_M) hSub_M
  have hPb_outer : CategoryTheory.IsPullback (π_0 ∣_ S_01)
      (g_M ≫ M_01.ι) (g_0 ≫ U_loc_iso.ι) p_M := by
    rw [hg_M, hg_0]
    exact (AlgebraicGeometry.isPullback_morphismRestrict π_0 S_01).paste_vert
      (CategoryTheory.IsPullback.of_hasPullback e_0 p_M)
  have hTop_comm : (π_0 ∣_ S_01) ≫ g_0 = g_M ≫ (p_M ∣_ U_loc_iso) := by
    apply (cancel_mono U_loc_iso.ι).mp
    calc ((π_0 ∣_ S_01) ≫ g_0) ≫ U_loc_iso.ι
      _ = (π_0 ∣_ S_01) ≫ (g_0 ≫ U_loc_iso.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (π_0 ∣_ S_01) ≫ S_01.ι ≫ e_0 := by rw [hg_0]
      _ = ((π_0 ∣_ S_01) ≫ S_01.ι) ≫ e_0 := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (S_tilde_01.ι ≫ π_0) ≫ e_0 := by rw [AlgebraicGeometry.morphismRestrict_ι π_0 S_01]
      _ = S_tilde_01.ι ≫ (π_0 ≫ e_0) := CategoryTheory.Category.assoc _ _ _
      _ = S_tilde_01.ι ≫ (π_M ≫ p_M) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = (S_tilde_01.ι ≫ π_M) ≫ p_M := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (g_M ≫ M_01.ι) ≫ p_M := by rw [← hg_M]
      _ = g_M ≫ (M_01.ι ≫ p_M) := CategoryTheory.Category.assoc _ _ _
      _ = g_M ≫ ((p_M ∣_ U_loc_iso) ≫ U_loc_iso.ι) := by
        rw [← AlgebraicGeometry.morphismRestrict_ι p_M U_loc_iso]
      _ = (g_M ≫ (p_M ∣_ U_loc_iso)) ≫ U_loc_iso.ι := (CategoryTheory.Category.assoc _ _ _).symm
  have hPb_top : CategoryTheory.IsPullback (π_0 ∣_ S_01) g_M g_0 (p_M ∣_ U_loc_iso) :=
    CategoryTheory.IsPullback.of_bot hPb_outer hTop_comm
      (AlgebraicGeometry.isPullback_morphismRestrict p_M U_loc_iso)
  have : CategoryTheory.IsIso (p_M ∣_ U_loc_iso) := hIso_M
  have hIso_01 : CategoryTheory.IsIso (π_0 ∣_ S_01) := hPb_top.isIso_fst_of_isIso

  
  let V_01 : AlgebraicGeometry.Scheme.{u} := S_tilde_01.toScheme
  let f_0 : V_01 ⟶ W_tilde := S_tilde_01.ι
  have : AlgebraicGeometry.IsOpenImmersion (π_0 ∣_ S_01) :=
    AlgebraicGeometry.IsOpenImmersion.of_isIso (π_0 ∣_ S_01)
  let f_1 : V_01 ⟶ U_iso.toScheme := (π_0 ∣_ S_01) ≫ (ι_0 ∣_ U_iso)
  have : AlgebraicGeometry.IsOpenImmersion f_1 := inferInstance
  have hOver_X : f_0 ≫ (π_0 ≫ ι_0) = f_1 ≫ U_iso.ι := by
    symm
    calc f_1 ≫ U_iso.ι
      _ = (π_0 ∣_ S_01) ≫ ((ι_0 ∣_ U_iso) ≫ U_iso.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (π_0 ∣_ S_01) ≫ (S_01.ι ≫ ι_0) := by
        rw [AlgebraicGeometry.morphismRestrict_ι ι_0 U_iso]
      _ = ((π_0 ∣_ S_01) ≫ S_01.ι) ≫ ι_0 := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (S_tilde_01.ι ≫ π_0) ≫ ι_0 := by
        rw [AlgebraicGeometry.morphismRestrict_ι π_0 S_01]
      _ = f_0 ≫ (π_0 ≫ ι_0) := CategoryTheory.Category.assoc _ _ _
  have hGlued : ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (ι_W : W_tilde ⟶ X')
      (ι_U : U_iso.toScheme ⟶ X')
      (f_bl : X' ⟶ X),
      AlgebraicGeometry.IsOpenImmersion ι_W ∧
      AlgebraicGeometry.IsOpenImmersion ι_U ∧
      (∀ y : X', y ∈ Set.range ι_W.base ∨ y ∈ Set.range ι_U.base) ∧
      f_1 ≫ ι_U = f_0 ≫ ι_W ∧
      ι_W ≫ f_bl = π_0 ≫ j_W ≫ W.ι ∧
      ι_U ≫ f_bl = U_iso.ι := by
    let J : Type u := ULift.{u} Bool
    let i_W : J := ULift.up false
    let i_U : J := ULift.up true
    have hi_WU : i_W ≠ i_U := by decide
    have hNo3 : ∀ (i j k : J), i ≠ j → i ≠ k → j ≠ k → False := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk
      all_goals first | exact hij rfl | exact hik rfl | exact hjk rfl
    let D'_U : J → AlgebraicGeometry.Scheme.{u}
      | ⟨false⟩ => W_tilde
      | ⟨true⟩ => U_iso.toScheme
    let D'_f : ∀ (i j : J), i ≠ j → (V_01 ⟶ D'_U i)
      | ⟨false⟩, ⟨true⟩, _ => f_0
      | ⟨true⟩, ⟨false⟩, _ => f_1
      | ⟨false⟩, ⟨false⟩, h => False.elim (h rfl)
      | ⟨true⟩, ⟨true⟩, h => False.elim (h rfl)
    have hD'_open : ∀ (i j : J) (h : i ≠ j), AlgebraicGeometry.IsOpenImmersion (D'_f i j h) := by
      intro i j h
      rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
      · exact False.elim (h rfl)
      · exact inferInstanceAs (AlgebraicGeometry.IsOpenImmersion f_0)
      · exact inferInstanceAs (AlgebraicGeometry.IsOpenImmersion f_1)
      · exact False.elim (h rfl)
    let D' : CategoryTheory.GlueData' AlgebraicGeometry.Scheme.{u} :=
      { J := J
        U := D'_U
        V := fun _ _ _ => V_01
        f := D'_f
        f_mono := fun _ _ _ => inferInstance
        f_hasPullback := fun _ _ _ _ _ => inferInstance
        t := fun _ _ _ => 𝟙 V_01
        t_inv := fun _ _ _ => CategoryTheory.Category.id_comp (𝟙 V_01)
        t' := fun i j k hij hik hjk => (hNo3 i j k hij hik hjk).elim
        t_fac := fun i j k hij hik hjk => (hNo3 i j k hij hik hjk).elim
        cocycle := fun i j k hij hik hjk => (hNo3 i j k hij hik hjk).elim }
    let D₀ : CategoryTheory.GlueData AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.GlueData.ofGlueData' D'
    have hD₀_V_ne : ∀ (i j : J), i ≠ j → D₀.V (i, j) = V_01 :=
      fun i j h => @dite_cond_eq_false _ (i = j) (Classical.propDecidable (i = j)) _ _ (eq_false h)
    have hD₀_f_ne : ∀ (i j : J) (h : i ≠ j),
        D₀.f i j = eqToHom (hD₀_V_ne i j h) ≫ D'_f i j h :=
      fun i j h => @dite_cond_eq_false _ (i = j) (Classical.propDecidable (i = j)) _ _ (eq_false h)
    have hD₀_t_ne : ∀ (i j : J) (h : i ≠ j),
        D₀.t i j = eqToHom (hD₀_V_ne i j h) ≫ 𝟙 V_01 ≫ eqToHom (hD₀_V_ne j i h.symm).symm :=
      fun i j h => @dite_cond_eq_false _ (i = j) (Classical.propDecidable (i = j)) _ _ (eq_false h)
    have hD₀_tf_ne : ∀ (i j : J) (h : i ≠ j),
        D₀.t i j ≫ D₀.f j i = eqToHom (hD₀_V_ne i j h) ≫ D'_f j i h.symm := by
      intro i j h
      rw [hD₀_t_ne i j h, hD₀_f_ne j i h.symm]
      calc (eqToHom (hD₀_V_ne i j h) ≫ 𝟙 V_01 ≫ eqToHom (hD₀_V_ne j i h.symm).symm) ≫
            (eqToHom (hD₀_V_ne j i h.symm) ≫ D'_f j i h.symm)
        _ = eqToHom (hD₀_V_ne i j h) ≫
            (eqToHom (hD₀_V_ne j i h.symm).symm ≫ eqToHom (hD₀_V_ne j i h.symm)) ≫
            D'_f j i h.symm := by
          simp only [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
        _ = eqToHom (hD₀_V_ne i j h) ≫ D'_f j i h.symm := by
          rw [CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_refl,
            CategoryTheory.Category.id_comp]
    have hD₀_open : ∀ (i j : J), AlgebraicGeometry.IsOpenImmersion (D₀.f i j) := by
      intro i j
      by_cases h : i = j
      · subst h
        have : CategoryTheory.IsIso (D₀.f i i) := D₀.f_id i
        exact AlgebraicGeometry.IsOpenImmersion.of_isIso (D₀.f i i)
      · rw [hD₀_f_ne i j h]
        have : AlgebraicGeometry.IsOpenImmersion (eqToHom (hD₀_V_ne i j h)) :=
          AlgebraicGeometry.IsOpenImmersion.of_isIso _
        exact AlgebraicGeometry.IsOpenImmersion.comp (eqToHom (hD₀_V_ne i j h)) (D'_f i j h)
    let D_X : AlgebraicGeometry.Scheme.GlueData :=
      { toGlueData := D₀
        f_open := hD₀_open }
    have : CategoryTheory.Limits.HasMulticoequalizer D_X.diagram :=
      AlgebraicGeometry.Scheme.GlueData.instHasMulticoequalizerDiagram D_X
    let X' : AlgebraicGeometry.Scheme.{u} := D_X.glued
    let ι_W : W_tilde ⟶ X' := D_X.ι i_W
    let ι_U : U_iso.toScheme ⟶ X' := D_X.ι i_U
    have hCov_X' : ∀ y : X', y ∈ Set.range ι_W.base ∨ y ∈ Set.range ι_U.base := by
      intro y
      have hy : y ∈ Set.range (D_X.ι (D_X.openCover.idx y)).base := D_X.openCover.covers y
      rcases h_idx : D_X.openCover.idx y with ⟨_ | _⟩
      · rw [h_idx] at hy
        exact Or.inl hy
      · rw [h_idx] at hy
        exact Or.inr hy
    have hGlue : f_1 ≫ ι_U = f_0 ≫ ι_W := by
      have hgc : (D₀.t i_W i_U ≫ D₀.f i_U i_W) ≫ ι_U = D₀.f i_W i_U ≫ ι_W := by
        rw [CategoryTheory.Category.assoc]
        exact D_X.glue_condition i_W i_U
      rw [hD₀_tf_ne i_W i_U hi_WU, hD₀_f_ne i_W i_U hi_WU] at hgc
      have hgc' : eqToHom (hD₀_V_ne i_W i_U hi_WU) ≫ (f_1 ≫ ι_U) =
          eqToHom (hD₀_V_ne i_W i_U hi_WU) ≫ (f_0 ≫ ι_W) :=
        (CategoryTheory.Category.assoc _ f_1 ι_U).symm.trans
          (hgc.trans (CategoryTheory.Category.assoc _ f_0 ι_W))
      exact (cancel_epi (eqToHom (hD₀_V_ne i_W i_U hi_WU))).mp hgc'
    let k_desc : ∀ (i : J), D'_U i ⟶ X
      | ⟨false⟩ => π_0 ≫ ι_0
      | ⟨true⟩ => U_iso.ι
    have hk_desc : ∀ (a : D_X.J × D_X.J),
        D_X.diagram.fst a ≫ k_desc a.1 = D_X.diagram.snd a ≫ k_desc a.2 := by
      change ∀ (a : J × J),
        D₀.f a.1 a.2 ≫ k_desc a.1 = (D₀.t a.1 a.2 ≫ D₀.f a.2 a.1) ≫ k_desc a.2
      rintro ⟨i, j⟩
      by_cases h : i = j
      · subst h
        have htf_id : D₀.t i i ≫ D₀.f i i = D₀.f i i :=
          (congrArg (· ≫ D₀.f i i) (D₀.t_id i)).trans (CategoryTheory.Category.id_comp (D₀.f i i))
        exact (congrArg (· ≫ k_desc i) htf_id).symm
      · rw [hD₀_f_ne i j h, hD₀_tf_ne i j h]
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
        · exact False.elim (h rfl)
        · exact (CategoryTheory.Category.assoc _ f_0 (π_0 ≫ ι_0)).trans
            ((congrArg (eqToHom _ ≫ ·) hOver_X).trans
              (CategoryTheory.Category.assoc _ f_1 U_iso.ι).symm)
        · exact (CategoryTheory.Category.assoc _ f_1 U_iso.ι).trans
            ((congrArg (eqToHom _ ≫ ·) hOver_X.symm).trans
              (CategoryTheory.Category.assoc _ f_0 (π_0 ≫ ι_0)).symm)
        · exact False.elim (h rfl)
    let f_bl : X' ⟶ X :=
      CategoryTheory.Limits.Multicoequalizer.desc D_X.diagram X k_desc hk_desc
    exact ⟨X', ι_W, ι_U, f_bl,
      D_X.ι_isOpenImmersion i_W,
      D_X.ι_isOpenImmersion i_U,
      hCov_X',
      hGlue,
      CategoryTheory.Limits.Multicoequalizer.π_desc D_X.diagram X k_desc hk_desc i_W,
      CategoryTheory.Limits.Multicoequalizer.π_desc D_X.diagram X k_desc hk_desc i_U⟩
  obtain ⟨X', ι_W, ι_U, f_bl, hOpen_ιW, hOpen_ιU, hCov_X', hGlue, hιW_f, hιU_f⟩ := hGlued
  have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpen_ιW
  have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_ιU

  
  have hPre_U : (TopologicalSpace.Opens.map f_bl.base).obj U_iso.ι.opensRange = ι_U.opensRange := by
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    ext y
    change f_bl.base y ∈ U_iso ↔ y ∈ Set.range ι_U.base
    constructor
    · intro hy_U
      rcases hCov_X' y with ⟨w, rfl⟩ | hy_range
      · have hw : w ∈ S_tilde_01 := by
          change ι_0.base (π_0.base w) ∈ U_iso
          have hcomm_w : (ι_W ≫ f_bl).base w = (π_0 ≫ ι_0).base w :=
            congrArg (fun h => h.base w) hιW_f
          change (π_0 ≫ ι_0).base w ∈ U_iso
          rw [← hcomm_w]
          exact hy_U
        let v : V_01 := ⟨w, hw⟩
        have hv_eq : ι_W.base (f_0.base v) = ι_U.base (f_1.base v) :=
          congrArg (fun h => h.base v) hGlue.symm
        change ι_W.base (f_0.base v) ∈ Set.range ι_U.base
        rw [hv_eq]
        exact ⟨f_1.base v, rfl⟩
      · exact hy_range
    · rintro ⟨u, rfl⟩
      have hcomm_u : f_bl.base (ι_U.base u) = U_iso.ι.base u :=
        congrArg (fun h => h.base u) hιU_f
      rw [hcomm_u]
      exact u.2
  have hPb_U2 : CategoryTheory.IsPullback (𝟙 U_iso.toScheme) ι_U U_iso.ι f_bl :=
    AlgebraicGeometry.IsOpenImmersion.isPullback (𝟙 U_iso.toScheme) ι_U U_iso.ι f_bl
      (by rw [hιU_f, CategoryTheory.Category.id_comp]) hPre_U
  have hPb_U1 := AlgebraicGeometry.isPullback_morphismRestrict f_bl U_iso
  let e_U := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_U1 hPb_U2
  have he_U : e_U.hom = f_bl ∣_ U_iso := by
    have hfst := CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_U1 hPb_U2
    rwa [CategoryTheory.Category.comp_id] at hfst
  have hIso_fU : CategoryTheory.IsIso (f_bl ∣_ U_iso) := by
    rw [← he_U]
    infer_instance
  have hProp_fU : AlgebraicGeometry.IsProper (f_bl ∣_ U_iso) := inferInstance

  have hPre_W : (TopologicalSpace.Opens.map f_bl.base).obj W_0.ι.opensRange = ι_W.opensRange := by
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    ext y
    change f_bl.base y ∈ Set.range ι_0.base ↔ y ∈ Set.range ι_W.base
    constructor
    · rintro ⟨p, hp_eq⟩
      rcases hCov_X' y with hy_range | ⟨u, rfl⟩
      · exact hy_range
      · have hu_eq : U_iso.ι.base u = ι_0.base p := by
          have hcomm_u : f_bl.base (ι_U.base u) = U_iso.ι.base u :=
            congrArg (fun h => h.base u) hιU_f
          rw [← hcomm_u, hp_eq]
        have hp_S01 : p ∈ S_01 := by
          change ι_0.base p ∈ U_iso
          rw [← hu_eq]
          exact u.2
        let s : S_01.toScheme := ⟨p, hp_S01⟩
        have hs_u : (ι_0 ∣_ U_iso).base s = u := by
          apply Subtype.ext
          have hcomm_s : U_iso.ι.base ((ι_0 ∣_ U_iso).base s) = ι_0.base (S_01.ι.base s) :=
            congrArg (fun h => h.base s) (AlgebraicGeometry.morphismRestrict_ι ι_0 U_iso)
          exact hcomm_s.trans hu_eq.symm
        let v : V_01 := (CategoryTheory.inv (π_0 ∣_ S_01)).base s
        have hv_s : (π_0 ∣_ S_01).base v = s :=
          congrArg (fun h => h.base s) (CategoryTheory.IsIso.inv_hom_id (π_0 ∣_ S_01))
        have hf1_v : f_1.base v = u := by
          change (ι_0 ∣_ U_iso).base ((π_0 ∣_ S_01).base v) = u
          rw [hv_s, hs_u]
        have hv_glue : ι_U.base (f_1.base v) = ι_W.base (f_0.base v) :=
          congrArg (fun h => h.base v) hGlue
        rw [← hf1_v, hv_glue]
        exact ⟨f_0.base v, rfl⟩
    · rintro ⟨w, rfl⟩
      have hcomm_w : f_bl.base (ι_W.base w) = ι_0.base (π_0.base w) :=
        congrArg (fun h => h.base w) hιW_f
      rw [hcomm_w]
      exact ⟨π_0.base w, rfl⟩
  have hPb_W2 : CategoryTheory.IsPullback (π_0 ≫ ι_0.isoOpensRange.hom) ι_W W_0.ι f_bl := by
    refine AlgebraicGeometry.IsOpenImmersion.isPullback
      (π_0 ≫ ι_0.isoOpensRange.hom) ι_W W_0.ι f_bl ?_ hPre_W
    rw [CategoryTheory.Category.assoc, ι_0.isoOpensRange_hom_ι, hιW_f]
  have hPb_W1 := AlgebraicGeometry.isPullback_morphismRestrict f_bl W_0
  let e_W := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_W1 hPb_W2
  have he_W : e_W.hom ≫ π_0 ≫ ι_0.isoOpensRange.hom = f_bl ∣_ W_0 :=
    CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_W1 hPb_W2
  have hProp_fW : AlgebraicGeometry.IsProper (f_bl ∣_ W_0) := by
    rw [← he_W]
    infer_instance

  
  have hProp_f : AlgebraicGeometry.IsProper f_bl := by
    refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.IsProper) (fun b : Bool => cond b W_0 U_iso) hTop_X).mpr ?_
    intro b
    cases b
    · exact hProp_fU
    · exact hProp_fW

  
  let U_tilde_M : W_tilde.Opens := (TopologicalSpace.Opens.map π_M.base).obj U_M
  let j_V : U_tilde_M.toScheme ⟶ X' := U_tilde_M.ι ≫ ι_W
  have : AlgebraicGeometry.IsOpenImmersion j_V := inferInstance
  let V_sm' : X'.Opens := j_V.opensRange
  let α_V : V_sm'.toScheme ⟶ U_tilde_M.toScheme := j_V.isoOpensRange.inv
  let α_M : V_sm'.toScheme ⟶ U_M.toScheme := α_V ≫ (π_M ∣_ U_M)
  let e' : V_sm'.toScheme ⟶ Y_sm := α_M ≫ e_M
  let β_W : V_sm'.toScheme ⟶ S_0 := α_V ≫ U_tilde_M.ι ≫ π_0
  have hαV_jV : α_V ≫ j_V = V_sm'.ι :=
    (CategoryTheory.Iso.inv_comp_eq j_V.isoOpensRange).mpr j_V.isoOpensRange_hom_ι.symm
  have hV_le : V_sm' ≤ (TopologicalSpace.Opens.map f_bl.base).obj W := by
    rintro y ⟨w, rfl⟩
    change f_bl.base (ι_W.base (U_tilde_M.ι.base w)) ∈ W
    have hcomm_w : f_bl.base (ι_W.base (U_tilde_M.ι.base w)) =
        W.ι.base (j_W.base (π_0.base (U_tilde_M.ι.base w))) :=
      congrArg (fun h => h.base (U_tilde_M.ι.base w)) hιW_f
    rw [hcomm_w]
    exact (j_W.base (π_0.base (U_tilde_M.ι.base w))).2
  have hEt_αM : AlgebraicGeometry.Etale α_M := inferInstance
  have hEt_e' : AlgebraicGeometry.Etale e' := inferInstance
  have hβW_f : V_sm'.ι ≫ f_bl = β_W ≫ j_W ≫ W.ι := by
    calc V_sm'.ι ≫ f_bl
      _ = (α_V ≫ U_tilde_M.ι ≫ ι_W) ≫ f_bl := by rw [← hαV_jV]
      _ = α_V ≫ U_tilde_M.ι ≫ (ι_W ≫ f_bl) := by simp only [CategoryTheory.Category.assoc]
      _ = α_V ≫ U_tilde_M.ι ≫ (π_0 ≫ j_W ≫ W.ι) := by rw [hιW_f]
      _ = β_W ≫ j_W ≫ W.ι := by simp only [β_W, CategoryTheory.Category.assoc]
  have hβW_e : β_W ≫ e_0 = α_M ≫ U_M.ι ≫ p_M := by
    have hcond_pb : π_0 ≫ e_0 = π_M ≫ p_M := CategoryTheory.Limits.pullback.condition
    calc β_W ≫ e_0
      _ = α_V ≫ U_tilde_M.ι ≫ (π_0 ≫ e_0) := by simp only [β_W, CategoryTheory.Category.assoc]
      _ = α_V ≫ (U_tilde_M.ι ≫ π_M) ≫ p_M := by
        rw [hcond_pb, ← CategoryTheory.Category.assoc (f := U_tilde_M.ι)]
      _ = α_V ≫ ((π_M ∣_ U_M) ≫ U_M.ι) ≫ p_M := by
        rw [← AlgebraicGeometry.morphismRestrict_ι π_M U_M]
      _ = α_M ≫ U_M.ι ≫ p_M := by simp only [α_M, CategoryTheory.Category.assoc]

  
  refine ⟨X', f_bl, V_sm', e', α_M, ι_W, ι_U,
    hOpen_ιW, hOpen_ιU, hCov_X', hιW_f, hιU_f,
    hV_le, hProp_f, hIso_fU, hEt_αM, hEt_e', rfl,
    ⟨β_W, hβW_f, hβW_e⟩, ?_⟩
  intro R _ _ ψ mR ψ_W hmR hmR_not_U hψ_W
  have hmR_W : ψ.base mR ∈ Set.range ι_W.base := by
    rcases hCov_X' (ψ.base mR) with h_in_W | ⟨u, hu⟩
    · exact h_in_W
    · exfalso
      apply hmR_not_U
      change f_bl.base (ψ.base mR) ∈ U_iso
      rw [← hu]
      have hcomm_u : f_bl.base (ι_U.base u) = U_iso.ι.base u :=
        congrArg (fun h => h.base u) hιU_f
      rw [hcomm_u]
      exact u.2
  have hRange_ψW : Set.range ψ.base ⊆ Set.range ι_W.base := by
    rintro _ ⟨q, rfl⟩
    let q' : PrimeSpectrum R := q
    let mR' : PrimeSpectrum R := mR
    have hq_le : q' ≤ mR' := by
      change q'.asIdeal ≤ mR'.asIdeal
      rw [hmR]
      exact IsLocalRing.le_maximalIdeal_of_isPrime q'.asIdeal
    have hq_spec : q ⤳ mR := (PrimeSpectrum.le_iff_specializes q' mR').mp hq_le
    have hψ_spec : ψ.base q ⤳ ψ.base mR := hq_spec.map ψ.continuous
    exact hψ_spec.mem_open ι_W.isOpenEmbedding.isOpen_range hmR_W
  let ψ_tilde : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W_tilde :=
    AlgebraicGeometry.IsOpenImmersion.lift ι_W ψ hRange_ψW
  have hψ_tilde : ψ_tilde ≫ ι_W = ψ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac ι_W ψ hRange_ψW
  let ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M := ψ_tilde ≫ π_M
  let ψ_S0 : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ S_0 := ψ_tilde ≫ π_0
  have hClause3 : ψ_S0 ≫ j_W ≫ W.ι = ψ ≫ f_bl := by
    calc ψ_S0 ≫ j_W ≫ W.ι
      _ = ψ_tilde ≫ (π_0 ≫ j_W ≫ W.ι) := by simp only [ψ_S0, CategoryTheory.Category.assoc]
      _ = (ψ_tilde ≫ ι_W) ≫ f_bl := by rw [← hιW_f, CategoryTheory.Category.assoc]
      _ = ψ ≫ f_bl := by rw [hψ_tilde]
  have hClause2 : ψ_M ≫ p_M = ψ_S0 ≫ e_0 := by
    calc ψ_M ≫ p_M
      _ = ψ_tilde ≫ (π_M ≫ p_M) := CategoryTheory.Category.assoc _ _ _
      _ = ψ_tilde ≫ (π_0 ≫ e_0) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = ψ_S0 ≫ e_0 := (CategoryTheory.Category.assoc _ _ _).symm
  have hψ_S0_W : ψ_S0 ≫ j_W = ψ_W := by
    apply (cancel_mono W.ι).mp
    rw [CategoryTheory.Category.assoc, hClause3, hψ_W]
  have hClause1 : ψ_M ≫ p_M ≫ AlgebraicGeometry.Spec.map φ_glob_loc = ψ_W ≫ e := by
    calc ψ_M ≫ p_M ≫ AlgebraicGeometry.Spec.map φ_glob_loc
      _ = (ψ_M ≫ p_M) ≫ AlgebraicGeometry.Spec.map φ_glob_loc :=
        (CategoryTheory.Category.assoc _ _ _).symm
      _ = ψ_S0 ≫ (e_0 ≫ AlgebraicGeometry.Spec.map φ_glob_loc) := by
        rw [hClause2, CategoryTheory.Category.assoc]
      _ = (ψ_S0 ≫ j_W) ≫ e := by rw [he_0, ← CategoryTheory.Category.assoc]
      _ = ψ_W ≫ e := by rw [hψ_S0_W]
  refine ⟨ψ_M, ψ_S0, hClause1, hClause2, hClause3, ?_, ?_⟩
  · intro ψ_UM hψ_UM
    have hSub_UM : Set.range ψ_tilde.base ⊆ Set.range U_tilde_M.ι.base := by
      rintro _ ⟨q, rfl⟩
      have hq_M : π_M.base (ψ_tilde.base q) ∈ U_M := by
        have hq_eq : π_M.base (ψ_tilde.base q) = U_M.ι.base (ψ_UM.base q) :=
          congrArg (fun h => h.base q) hψ_UM.symm
        rw [hq_eq]
        exact (ψ_UM.base q).2
      exact ⟨⟨ψ_tilde.base q, hq_M⟩, rfl⟩
    let ψ_Utilde : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U_tilde_M.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_tilde_M.ι ψ_tilde hSub_UM
    have hψ_Utilde : ψ_Utilde ≫ U_tilde_M.ι = ψ_tilde :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_tilde_M.ι ψ_tilde hSub_UM
    let ψ_V : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ V_sm'.toScheme :=
      ψ_Utilde ≫ j_V.isoOpensRange.hom
    have hψV_ι : ψ_V ≫ V_sm'.ι = ψ := by
      calc ψ_V ≫ V_sm'.ι
        _ = ψ_Utilde ≫ (j_V.isoOpensRange.hom ≫ V_sm'.ι) := CategoryTheory.Category.assoc _ _ _
        _ = (ψ_Utilde ≫ U_tilde_M.ι) ≫ ι_W := by
          rw [j_V.isoOpensRange_hom_ι]; exact (CategoryTheory.Category.assoc _ _ _).symm
        _ = ψ := by rw [hψ_Utilde, hψ_tilde]
    have hψUtilde_UM : ψ_Utilde ≫ (π_M ∣_ U_M) = ψ_UM := by
      apply (cancel_mono U_M.ι).mp
      calc (ψ_Utilde ≫ (π_M ∣_ U_M)) ≫ U_M.ι
        _ = ψ_Utilde ≫ ((π_M ∣_ U_M) ≫ U_M.ι) := CategoryTheory.Category.assoc _ _ _
        _ = (ψ_Utilde ≫ U_tilde_M.ι) ≫ π_M := by
          rw [AlgebraicGeometry.morphismRestrict_ι π_M U_M]
          exact (CategoryTheory.Category.assoc _ _ _).symm
        _ = ψ_M := by rw [hψ_Utilde]
        _ = ψ_UM ≫ U_M.ι := hψ_UM.symm
    have hψV_e' : ψ_V ≫ e' = ψ_UM ≫ e_M := by
      calc ψ_V ≫ e'
        _ = ψ_Utilde ≫ (j_V.isoOpensRange.hom ≫ α_V) ≫ (π_M ∣_ U_M) ≫ e_M := by
          simp only [ψ_V, e', α_M, CategoryTheory.Category.assoc]
        _ = (ψ_Utilde ≫ (π_M ∣_ U_M)) ≫ e_M := by
          rw [j_V.isoOpensRange.hom_inv_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc]
        _ = ψ_UM ≫ e_M := by rw [hψUtilde_UM]
    exact ⟨ψ_V, hψV_ι, hψV_e'⟩
  · intro hRange_M y hy
    rcases hy with ⟨q, rfl⟩
    have hq_UM : π_M.base (ψ_tilde.base q) ∈ U_M :=
      hRange_M ⟨q, rfl⟩
    let w : U_tilde_M.toScheme := ⟨ψ_tilde.base q, hq_UM⟩
    have hw_eq : j_V.base w = ψ.base q :=
      congrArg (fun h => h.base q) hψ_tilde
    exact ⟨w, hw_eq⟩

theorem weil_strictlySemistable_modification_of_etale_charts (K : Type u) [Field K]
    (V : ValuationSubring K)
    (t₀ : ↥V)
    (ht₀_ne : t₀ ≠ 0)
    (ht₀_gen : ∀ (Q : Ideal ↥V) [Q.IsPrime], t₀ ∉ Q ↔ Q = ⊥)
    {X X' : AlgebraicGeometry.Scheme.{u}}
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_bl : X' ⟶ X)
    (U_iso : X.Opens)
    (hSS : IsStrictlySemistableCurveOverValuation V g_X)
    (hProp : AlgebraicGeometry.IsProper f_bl)
    (hf_comm : f_bl ≫ g_X = g_X')
    (hIso_U : CategoryTheory.IsIso (f_bl ∣_ U_iso))
    (hGen_U : ∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso)
    (hCharts : ∀ y : X',
      (∃ (U : X'.Opens)
          (e : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
        y ∈ U ∧
        AlgebraicGeometry.Etale e ∧
        U.ι ≫ g_X' = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
      (∃ (U : X'.Opens) (b : ↥V)
          (e : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))),
        y ∈ U ∧
        b ≠ 0 ∧
        AlgebraicGeometry.Etale e ∧
        U.ι ≫ g_X' = e ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) :
    IsStrictlySemistableCurveOverValuation V g_X' :=
by
  let f_sm : CommRingCat.of ↥V ⟶ CommRingCat.of (Polynomial ↥V) :=
    CommRingCat.ofHom Polynomial.C
  have hf_sm_alg : f_sm.hom = algebraMap ↥V (Polynomial ↥V) := by
    ext v
    simp [f_sm, Polynomial.algebraMap_eq]
  have hSm_mor :
      AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map f_sm) ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map f_sm) :=
    ⟨(AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
        (hf_sm_alg ▸ RingHom.flat_algebraMap_iff.mpr inferInstance),
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr
        (hf_sm_alg ▸ RingHom.finitePresentation_algebraMap.mpr inferInstance)⟩
  have hNod_mor : ∀ (b : ↥V),
      let A_b := MvPolynomial (Fin 2) ↥V ⧸
        Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C b}
      let f_nod : CommRingCat.of ↥V ⟶ CommRingCat.of A_b :=
        CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
      AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map f_nod) ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (AlgebraicGeometry.Spec.map f_nod) := by
    intro b
    dsimp only
    set g_b : MvPolynomial (Fin 2) ↥V :=
      MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C b
    set I_b : Ideal (MvPolynomial (Fin 2) ↥V) := Ideal.span {g_b}
    let A_b := MvPolynomial (Fin 2) ↥V ⧸ I_b
    let f_nod : CommRingCat.of ↥V ⟶ CommRingCat.of A_b :=
      CommRingCat.ofHom ((Ideal.Quotient.mk I_b).comp MvPolynomial.C)
    have halg_eq : f_nod.hom = algebraMap ↥V A_b := by
      ext v
      rw [IsScalarTower.algebraMap_apply ↥V (MvPolynomial (Fin 2) ↥V) A_b,
        MvPolynomial.algebraMap_eq]
      rfl
    have : Algebra.FinitePresentation ↥V A_b :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton g_b)
    let redMonom (d : Fin 2 →₀ ℕ) : Polynomial ↥V × Polynomial ↥V :=
      if d 1 ≤ d 0 then
        (Polynomial.C (b ^ d 1) * Polynomial.X ^ (d 0 - d 1), 0)
      else
        (0, Polynomial.C (b ^ d 0) * Polynomial.X ^ (d 1 - 1 - d 0))
    let θ_tilde : MvPolynomial (Fin 2) ↥V →ₗ[↥V] Polynomial ↥V × Polynomial ↥V :=
      (MvPolynomial.basisMonomials (Fin 2) ↥V).constr ↥V redMonom
    have hθ_monom : ∀ (d : Fin 2 →₀ ℕ) (r : ↥V),
        θ_tilde (MvPolynomial.monomial d r) = r • redMonom d := by
      intro d r
      have hsm : MvPolynomial.monomial d r =
          r • (MvPolynomial.basisMonomials (Fin 2) ↥V) d := by
        rw [MvPolynomial.coe_basisMonomials, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      rw [hsm, map_smul, Module.Basis.constr_basis]
    let e₁₁ : Fin 2 →₀ ℕ := Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1
    have hred_step : ∀ d : Fin 2 →₀ ℕ, redMonom (d + e₁₁) = b • redMonom d := by
      intro d
      have hd0 : (d + e₁₁) 0 = d 0 + 1 := by simp [e₁₁]
      have hd1 : (d + e₁₁) 1 = d 1 + 1 := by simp [e₁₁]
      dsimp only [redMonom]
      rw [hd0, hd1]
      by_cases hle : d 1 ≤ d 0
      · have hle' : d 1 + 1 ≤ d 0 + 1 := by omega
        have hsub : d 0 + 1 - (d 1 + 1) = d 0 - d 1 := by omega
        simp only [hle, hle', ↓reduceIte, hsub]
        ext <;> simp [pow_succ', Algebra.smul_def, Polynomial.algebraMap_eq, mul_assoc]
      · have hle' : ¬ (d 1 + 1 ≤ d 0 + 1) := by omega
        have hsub : d 1 + 1 - 1 - (d 0 + 1) = d 1 - 1 - d 0 := by omega
        simp only [hle, hle', ↓reduceIte, hsub]
        ext <;> simp [pow_succ', Algebra.smul_def, Polynomial.algebraMap_eq, mul_assoc]
    have hgb_eq : g_b = MvPolynomial.monomial e₁₁ 1 - MvPolynomial.monomial 0 b := by
      change MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b = _
      rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one,
        MvPolynomial.C_apply]
    have hθ_ker : ∀ p ∈ I_b, θ_tilde p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      clear hp
      rw [mul_comm]
      induction q using MvPolynomial.induction_on' with
      | monomial d r =>
        rw [hgb_eq, mul_sub, MvPolynomial.monomial_mul_monomial,
          MvPolynomial.monomial_mul_monomial, mul_one, add_zero, map_sub, hθ_monom, hθ_monom,
          hred_step, ← mul_smul, mul_comm r b, sub_self]
      | add q₁ q₂ ih₁ ih₂ =>
        rw [add_mul, map_add, ih₁, ih₂, add_zero]
    let Θ : A_b →ₗ[↥V] Polynomial ↥V × Polynomial ↥V :=
      { toFun := Quotient.lift θ_tilde (fun p q h => by
          have hsub : p - q ∈ I_b := (Submodule.quotientRel_def I_b).mp h
          exact sub_eq_zero.mp (by rw [← map_sub]; exact hθ_ker (p - q) hsub))
        map_add' := by
          intro x y
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
          exact map_add θ_tilde p q
        map_smul' := by
          intro c x
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact map_smul θ_tilde c p }
    have hΘ_mk : ∀ p : MvPolynomial (Fin 2) ↥V, Θ (Ideal.Quotient.mk I_b p) = θ_tilde p :=
      fun _ => rfl
    let u : A_b := Ideal.Quotient.mk I_b (MvPolynomial.X 0)
    let v : A_b := Ideal.Quotient.mk I_b (MvPolynomial.X 1)
    let ψ₀ : Polynomial ↥V →ₗ[↥V] A_b := (Polynomial.aeval u).toLinearMap
    let ψ₁ : Polynomial ↥V →ₗ[↥V] A_b :=
      (LinearMap.mulLeft ↥V v).comp (Polynomial.aeval v).toLinearMap
    let Ψ : Polynomial ↥V × Polynomial ↥V →ₗ[↥V] A_b := ψ₀.coprod ψ₁
    have huv : u * v = algebraMap ↥V A_b b := by
      have hg0 : Ideal.Quotient.mk I_b g_b = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g_b)
      change Ideal.Quotient.mk I_b (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b) = 0
        at hg0
      rw [map_sub, map_mul, sub_eq_zero] at hg0
      rw [IsScalarTower.algebraMap_apply ↥V (MvPolynomial (Fin 2) ↥V) A_b,
        MvPolynomial.algebraMap_eq]
      exact hg0
    have hX_pow : ∀ (i : Fin 2) (k : ℕ),
        (MvPolynomial.X i : MvPolynomial (Fin 2) ↥V) ^ k =
          MvPolynomial.monomial (Finsupp.single i k) 1 := by
      intro i k
      rw [MvPolynomial.monomial_eq, Finsupp.prod_single_index (by simp), map_one, one_mul]
    have hmonom_C_X : ∀ (k : ℕ) (r : ↥V),
        Polynomial.monomial k r = Polynomial.C r * Polynomial.X ^ k := by
      intro k r
      ext j
      rw [Polynomial.coeff_monomial, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      by_cases hkj : k = j
      · subst hkj; simp
      · have hjk : j ≠ k := Ne.symm hkj
        simp [hkj, hjk]
    have hΘ_ψ₀ : ∀ P : Polynomial ↥V, Θ (ψ₀ P) = (P, 0) := by
      intro P
      induction P using Polynomial.induction_on' with
      | add P₁ P₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂]
        ext <;> simp
      | monomial k r =>
        have hψ₀ : ψ₀ (Polynomial.monomial k r) =
            Ideal.Quotient.mk I_b (MvPolynomial.monomial (Finsupp.single 0 k) r) := by
          have hm0 : MvPolynomial.monomial (Finsupp.single (0 : Fin 2) k) r =
              MvPolynomial.C r * MvPolynomial.X 0 ^ k := by
            rw [hX_pow, MvPolynomial.C_apply, MvPolynomial.monomial_mul_monomial,
              zero_add, mul_one]
          change (Polynomial.aeval u) (Polynomial.monomial k r) = _
          rw [hmonom_C_X, hm0, map_mul, map_pow, map_mul, map_pow]
          simp only [Polynomial.aeval_C, Polynomial.aeval_X, u,
            IsScalarTower.algebraMap_apply ↥V (MvPolynomial (Fin 2) ↥V) A_b,
            MvPolynomial.algebraMap_eq]
          rfl
        rw [hψ₀, hΘ_mk, hθ_monom]
        dsimp only [redMonom]
        simp [hmonom_C_X, Algebra.smul_def, Polynomial.algebraMap_eq]
    have hΘ_ψ₁ : ∀ Q : Polynomial ↥V, Θ (ψ₁ Q) = (0, Q) := by
      intro Q
      induction Q using Polynomial.induction_on' with
      | add Q₁ Q₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂]
        ext <;> simp
      | monomial m r =>
        have hψ₁ : ψ₁ (Polynomial.monomial m r) =
            Ideal.Quotient.mk I_b (MvPolynomial.monomial (Finsupp.single 1 (m + 1)) r) := by
          have hm1 : MvPolynomial.monomial (Finsupp.single (1 : Fin 2) (m + 1)) r =
              MvPolynomial.C r * (MvPolynomial.X 1 * MvPolynomial.X 1 ^ m) := by
            rw [← pow_succ', hX_pow, MvPolynomial.C_apply, MvPolynomial.monomial_mul_monomial,
              zero_add, mul_one]
          change v * (Polynomial.aeval v) (Polynomial.monomial m r) = _
          rw [hmonom_C_X, hm1, map_mul, map_pow, map_mul, map_mul, map_pow]
          simp only [Polynomial.aeval_C, Polynomial.aeval_X,
            IsScalarTower.algebraMap_apply ↥V (MvPolynomial (Fin 2) ↥V) A_b,
            MvPolynomial.algebraMap_eq]
          change v * ((Ideal.Quotient.mk I_b) (MvPolynomial.C r) * v ^ m) =
            (Ideal.Quotient.mk I_b) (MvPolynomial.C r) * (v * v ^ m)
          ring
        rw [hψ₁, hΘ_mk, hθ_monom]
        dsimp only [redMonom]
        have hnot : ¬ (m + 1 ≤ 0) := by omega
        simp [hnot, hmonom_C_X, Algebra.smul_def, Polynomial.algebraMap_eq]
    have hΘΨ : ∀ z : Polynomial ↥V × Polynomial ↥V, Θ (Ψ z) = z := by
      rintro ⟨P, Q⟩
      change Θ (ψ₀ P + ψ₁ Q) = (P, Q)
      rw [map_add, hΘ_ψ₀, hΘ_ψ₁]
      ext <;> simp
    have huv_pow : ∀ k : ℕ, (u * v) ^ k = u ^ k * v ^ k := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ, pow_succ, pow_succ, ih]
        ring
    have hΨΘ : ∀ x : A_b, Ψ (Θ x) = x := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      induction p using MvPolynomial.induction_on' with
      | monomial d r =>
        have hmk : Ideal.Quotient.mk I_b (MvPolynomial.monomial d r) =
            r • (u ^ d 0 * v ^ d 1) := by
          have hd_eq :
              Finsupp.single (0 : Fin 2) (d 0) + Finsupp.single (1 : Fin 2) (d 1) = d := by
            ext i; fin_cases i <;> simp
          have hmd : MvPolynomial.monomial d r =
              r • (MvPolynomial.X (0 : Fin 2) ^ d 0 * MvPolynomial.X 1 ^ d 1) := by
            rw [Algebra.smul_def, MvPolynomial.algebraMap_eq, hX_pow, hX_pow,
              MvPolynomial.C_apply, MvPolynomial.monomial_mul_monomial,
              MvPolynomial.monomial_mul_monomial, zero_add, mul_one, mul_one, hd_eq]
          change (Ideal.Quotient.mkₐ ↥V I_b) (MvPolynomial.monomial d r) =
            r • (u ^ d 0 * v ^ d 1)
          rw [hmd, map_smul, map_mul, map_pow, map_pow]
          rfl
        rw [hΘ_mk, hθ_monom, map_smul, hmk]
        congr 1
        dsimp only [redMonom]
        by_cases hle : d 1 ≤ d 0
        · simp only [hle, ↓reduceIte, Ψ, LinearMap.coprod_apply, map_zero, add_zero, ψ₀,
            AlgHom.toLinearMap_apply, map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
          rw [← huv, huv_pow]
          have hadd : d 1 + (d 0 - d 1) = d 0 := by omega
          calc (u ^ d 1 * v ^ d 1) * u ^ (d 0 - d 1)
            _ = (u ^ d 1 * u ^ (d 0 - d 1)) * v ^ d 1 := by ring
            _ = u ^ d 0 * v ^ d 1 := by rw [← pow_add, hadd]
        · simp only [hle, ↓reduceIte, Ψ, LinearMap.coprod_apply, map_zero, zero_add, ψ₁,
            LinearMap.comp_apply, LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply, map_mul,
            Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
          rw [← huv, huv_pow]
          have hadd : d 0 + (1 + (d 1 - 1 - d 0)) = d 1 := by omega
          calc v * ((u ^ d 0 * v ^ d 0) * v ^ (d 1 - 1 - d 0))
            _ = u ^ d 0 * (v ^ d 0 * (v ^ 1 * v ^ (d 1 - 1 - d 0))) := by ring
            _ = u ^ d 0 * v ^ d 1 := by rw [← pow_add, ← pow_add, hadd]
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add, map_add, map_add]
        exact congrArg₂ (· + ·) ih₁ ih₂
    let e_lin : A_b ≃ₗ[↥V] Polynomial ↥V × Polynomial ↥V :=
      { Θ with
        invFun := Ψ
        left_inv := hΨΘ
        right_inv := hΘΨ }
    have : Module.Flat ↥V A_b := Module.Flat.of_linearEquiv e_lin
    exact ⟨(AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
        (halg_eq ▸ RingHom.flat_algebraMap_iff.mpr inferInstance),
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr
        (halg_eq ▸ RingHom.finitePresentation_algebraMap.mpr inferInstance)⟩
  have hLocalCharts : ∀ y : X', ∃ U : X'.Opens,
      y ∈ U ∧
      AlgebraicGeometry.Flat (U.ι ≫ g_X') ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (U.ι ≫ g_X') := by
    intro y
    rcases hCharts y with ⟨U, e, hy, hEt, hcomm⟩ | ⟨U, b, e, hy, _hb, hEt, hcomm⟩
    · have : AlgebraicGeometry.Etale e := hEt
      have : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map f_sm) := hSm_mor.1
      have : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map f_sm) := hSm_mor.2
      refine ⟨U, hy, ?_, ?_⟩
      · rw [hcomm]; exact inferInstance
      · rw [hcomm]; exact inferInstance
    · have : AlgebraicGeometry.Etale e := hEt
      obtain ⟨hF_b, hFP_b⟩ := hNod_mor b
      have : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk (Ideal.span
            {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C b})).comp
              MvPolynomial.C) :
          CommRingCat.of ↥V ⟶ CommRingCat.of
            (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
              {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C b}))) := hF_b
      have : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk (Ideal.span
            {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C b})).comp
              MvPolynomial.C) :
          CommRingCat.of ↥V ⟶ CommRingCat.of
            (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
              {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C b}))) := hFP_b
      refine ⟨U, hy, ?_, ?_⟩
      · rw [hcomm]; exact inferInstance
      · rw [hcomm]; exact inferInstance
  choose U_cov hy_cov hFlat_cov hLFP_cov using hLocalCharts
  have hSup_cov : iSup U_cov = ⊤ := by
    rw [eq_top_iff]
    intro y _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hy_cov y⟩
  have hZ_Flat : AlgebraicGeometry.IsZariskiLocalAtSource @AlgebraicGeometry.Flat :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
      (P := @AlgebraicGeometry.Flat)
      (Q := fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.Flat)
  have hZ_LFP : AlgebraicGeometry.IsZariskiLocalAtSource
      @AlgebraicGeometry.LocallyOfFinitePresentation :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
      (P := @AlgebraicGeometry.LocallyOfFinitePresentation)
      (Q := fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.FinitePresentation)
  have hFlat_X' : AlgebraicGeometry.Flat g_X' :=
    @AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
      (@AlgebraicGeometry.Flat) hZ_Flat _ _ g_X' _ U_cov hSup_cov hFlat_cov
  have hLFP_X' : AlgebraicGeometry.LocallyOfFinitePresentation g_X' :=
    @AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
      (@AlgebraicGeometry.LocallyOfFinitePresentation) hZ_LFP _ _ g_X' _ U_cov
      hSup_cov hLFP_cov
  let D₀ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
    PrimeSpectrum.basicOpen t₀
  have hAffLoc : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      [AlgebraicGeometry.Flat g_Z]
      (C : CommRingCat.{u})
      (h : AlgebraicGeometry.Spec C ⟶ Z)
      [AlgebraicGeometry.IsOpenImmersion h],
      let φ := AlgebraicGeometry.Spec.preimage (h ≫ g_Z)
      let L := Localization.Away (φ.hom t₀)
      let lam : ↑C →+* L := algebraMap (↑C) L
      let j : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Z :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ h
      Function.Injective lam ∧
      AlgebraicGeometry.IsOpenImmersion j ∧
      Set.range ⇑j ⊆ Set.range ⇑h ∩ ↑(g_Z ⁻¹ᵁ D₀) := by
    intro Z g_Z _ C h _
    dsimp only
    let φ := AlgebraicGeometry.Spec.preimage (h ≫ g_Z)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ = h ≫ g_Z :=
      AlgebraicGeometry.Spec.map_preimage (h ≫ g_Z)
    have hFlat_hg : AlgebraicGeometry.Flat (h ≫ g_Z) := inferInstance
    rw [← hSpec_φ] at hFlat_hg
    have hFlat_φ : φ.hom.Flat :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hFlat_hg
    let _ : Algebra ↥V ↑C := φ.hom.toAlgebra
    have hAlg_φ : algebraMap ↥V (↑C) = φ.hom := rfl
    have : Module.Flat ↥V ↑C := by
      rw [← RingHom.flat_algebraMap_iff, hAlg_φ]
      exact hFlat_φ
    have hTorsC : Submodule.torsion ↥V (↑C) = ⊥ := Module.Flat.torsion_eq_bot
    have ht₀_nzd_C : φ.hom t₀ ∈ nonZeroDivisors (↑C) := by
      rw [mem_nonZeroDivisors_iff_right]
      intro c hc
      have hsmul : (⟨t₀, mem_nonZeroDivisors_of_ne_zero ht₀_ne⟩ : nonZeroDivisors ↥V) • c = 0 := by
        rw [Submonoid.smul_def, Algebra.smul_def, hAlg_φ, mul_comm]
        exact hc
      have hc_mem : c ∈ Submodule.torsion ↥V (↑C) :=
        (Submodule.mem_torsion_iff c).mpr ⟨⟨t₀, mem_nonZeroDivisors_of_ne_zero ht₀_ne⟩, hsmul⟩
      rwa [hTorsC, Submodule.mem_bot] at hc_mem
    have hInj_lam : Function.Injective (algebraMap (↑C) (Localization.Away (φ.hom t₀))) :=
      IsLocalization.injective (Localization.Away (φ.hom t₀))
        (Submonoid.powers_le.mpr ht₀_nzd_C)
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (↑C) (Localization.Away (φ.hom t₀))))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (φ.hom t₀)
    let j : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (φ.hom t₀))) ⟶ Z :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑C) (Localization.Away (φ.hom t₀)))) ≫ h
    have hOpen_j : AlgebraicGeometry.IsOpenImmersion j := inferInstance
    refine ⟨hInj_lam, hOpen_j, ?_⟩
    rintro _ ⟨q, rfl⟩
    refine ⟨⟨(AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑C) (Localization.Away (φ.hom t₀))))).base q, rfl⟩, ?_⟩
    change t₀ ∉ (g_Z.base (j.base q)).asIdeal
    have hgj : g_Z.base (j.base q) =
        (AlgebraicGeometry.Spec.map φ).base
          ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑C) (Localization.Away (φ.hom t₀))))).base q) := by
      have hcomp_eq : j ≫ g_Z =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑C) (Localization.Away (φ.hom t₀)))) ≫
              AlgebraicGeometry.Spec.map φ := by
        simp only [j, CategoryTheory.Category.assoc, hSpec_φ]
      exact congrArg (fun m => m.base q) hcomp_eq
    rw [hgj, AlgebraicGeometry.Spec.map_base, AlgebraicGeometry.Spec.map_base]
    intro ht₀_mem
    have hUnit : IsUnit
        (algebraMap (↑C) (Localization.Away (φ.hom t₀)) (φ.hom t₀)) :=
      IsLocalization.Away.algebraMap_isUnit (φ.hom t₀)
    exact q.isPrime.ne_top (q.asIdeal.eq_top_of_isUnit_mem ht₀_mem hUnit)
  have hDenseGen : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      [AlgebraicGeometry.Flat g_Z],
      Dense (↑(g_Z ⁻¹ᵁ D₀) : Set Z) := by
    intro Z g_Z _
    rw [dense_iff_inter_open]
    intro O hO ⟨z, hz⟩
    obtain ⟨W, hW, hzW, hWO⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⟨O, hO⟩) hz
    obtain ⟨hInj_W, _, hRange_W⟩ := hAffLoc g_Z Γ(Z, W) hW.fromSpec
    have hSpec_ne : Nonempty ↥(AlgebraicGeometry.Spec Γ(Z, W)) := by
      have hz_range : z ∈ Set.range ⇑hW.fromSpec := by
        rw [hW.range_fromSpec]
        exact hzW
      obtain ⟨p₀, _⟩ := hz_range
      exact ⟨p₀⟩
    have : Nontrivial ↑Γ(Z, W) :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp hSpec_ne
    let φ_W := AlgebraicGeometry.Spec.preimage (hW.fromSpec ≫ g_Z)
    let L_W := Localization.Away (φ_W.hom t₀)
    have : Nontrivial L_W :=
      ⟨⟨algebraMap (↑Γ(Z, W)) L_W 0, algebraMap (↑Γ(Z, W)) L_W 1,
        fun h01 => zero_ne_one (hInj_W h01)⟩⟩
    obtain ⟨q₀⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr (inferInstance : Nontrivial L_W)
    let j_W := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (↑Γ(Z, W)) L_W)) ≫ hW.fromSpec
    have hq₀_mem := hRange_W ⟨q₀, rfl⟩
    rw [hW.range_fromSpec] at hq₀_mem
    exact ⟨j_W q₀, hWO hq₀_mem.1, hq₀_mem.2⟩
  have : AlgebraicGeometry.IsIntegral X := hSS.1
  have : AlgebraicGeometry.Flat g_X := hSS.2.1
  have : AlgebraicGeometry.Flat g_X' := hFlat_X'
  let U_gen : X.Opens := g_X ⁻¹ᵁ D₀
  let U_gen' : X'.Opens := g_X' ⁻¹ᵁ D₀
  have hIrred_X : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  have : Nonempty ↥X := hIrred_X.toNonempty
  obtain ⟨x₀, _, hx₀_gen⟩ :=
    (dense_iff_inter_open.mp (hDenseGen g_X)) Set.univ isOpen_univ Set.univ_nonempty
  have : Nonempty ↥U_gen.toScheme := ⟨⟨x₀, hx₀_gen⟩⟩
  have : AlgebraicGeometry.IsIntegral U_gen.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_gen.ι
  have h_le : U_gen ≤ U_iso := by
    intro x hx
    have ht₀_x : t₀ ∉ (g_X.base x).asIdeal := hx
    have : ((g_X.base x).asIdeal).IsPrime := (g_X.base x).isPrime
    have hbot_x : (g_X.base x).asIdeal = ⊥ := (ht₀_gen (g_X.base x).asIdeal).mp ht₀_x
    exact hGen_U x hbot_x
  have h_le' : f_bl ⁻¹ᵁ U_gen ≤ f_bl ⁻¹ᵁ U_iso := fun y hy => h_le hy
  have hPb_outer : CategoryTheory.IsPullback (f_bl ∣_ U_gen)
      (X'.homOfLE h_le' ≫ (f_bl ⁻¹ᵁ U_iso).ι)
      (X.homOfLE h_le ≫ U_iso.ι) f_bl := by
    rw [X'.homOfLE_ι h_le', X.homOfLE_ι h_le]
    exact AlgebraicGeometry.isPullback_morphismRestrict f_bl U_gen
  have hTop_comm : (f_bl ∣_ U_gen) ≫ X.homOfLE h_le =
      X'.homOfLE h_le' ≫ (f_bl ∣_ U_iso) := by
    rw [← CategoryTheory.cancel_mono U_iso.ι]
    calc ((f_bl ∣_ U_gen) ≫ X.homOfLE h_le) ≫ U_iso.ι
      _ = (f_bl ∣_ U_gen) ≫ (X.homOfLE h_le ≫ U_iso.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (f_bl ∣_ U_gen) ≫ U_gen.ι := by rw [X.homOfLE_ι h_le]
      _ = (f_bl ⁻¹ᵁ U_gen).ι ≫ f_bl := AlgebraicGeometry.morphismRestrict_ι f_bl U_gen
      _ = (X'.homOfLE h_le' ≫ (f_bl ⁻¹ᵁ U_iso).ι) ≫ f_bl := by rw [X'.homOfLE_ι h_le']
      _ = X'.homOfLE h_le' ≫ ((f_bl ⁻¹ᵁ U_iso).ι ≫ f_bl) := CategoryTheory.Category.assoc _ _ _
      _ = X'.homOfLE h_le' ≫ ((f_bl ∣_ U_iso) ≫ U_iso.ι) := by
        rw [AlgebraicGeometry.morphismRestrict_ι f_bl U_iso]
      _ = (X'.homOfLE h_le' ≫ (f_bl ∣_ U_iso)) ≫ U_iso.ι :=
        (CategoryTheory.Category.assoc _ _ _).symm
  have hPb_top : CategoryTheory.IsPullback (f_bl ∣_ U_gen)
      (X'.homOfLE h_le') (X.homOfLE h_le) (f_bl ∣_ U_iso) :=
    CategoryTheory.IsPullback.of_bot hPb_outer hTop_comm
      (AlgebraicGeometry.isPullback_morphismRestrict f_bl U_iso)
  have : CategoryTheory.IsIso (f_bl ∣_ U_iso) := hIso_U
  have : CategoryTheory.IsIso (f_bl ∣_ U_gen) := hPb_top.isIso_fst_of_isIso
  have h_eq : U_gen' = f_bl ⁻¹ᵁ U_gen := by
    ext y
    change g_X'.base y ∈ D₀ ↔ g_X.base (f_bl.base y) ∈ D₀
    rw [← hf_comm]
    rfl
  let e_gen : U_gen'.toScheme ⟶ U_gen.toScheme :=
    (X'.isoOfEq h_eq).hom ≫ (f_bl ∣_ U_gen)
  have : CategoryTheory.IsIso e_gen := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion e_gen := inferInstance
  have : Nonempty ↥U_gen'.toScheme :=
    ⟨(CategoryTheory.asIso e_gen).inv ⟨x₀, hx₀_gen⟩⟩
  have : AlgebraicGeometry.IsIntegral U_gen'.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion e_gen
  have : AlgebraicGeometry.IsReduced U_gen'.toScheme :=
    AlgebraicGeometry.isReduced_of_isIntegral U_gen'.toScheme
  have hIrred_Ugen' : IrreducibleSpace ↥U_gen'.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral U_gen'.toScheme
  have : ∀ i : X'.affineCover.I₀, AlgebraicGeometry.IsReduced (X'.affineCover.X i) := by
    intro i
    let Z_i := X'.affineCover.X i
    let h_i : AlgebraicGeometry.Spec Γ(Z_i, ⊤) ⟶ X' :=
      Z_i.isoSpec.inv ≫ X'.affineCover.f i
    obtain ⟨hInj_i, hOpen_ji, hRange_ji⟩ := hAffLoc g_X' Γ(Z_i, ⊤) h_i
    let φ_i := AlgebraicGeometry.Spec.preimage (h_i ≫ g_X')
    let L_i := Localization.Away (φ_i.hom t₀)
    let j_i : AlgebraicGeometry.Spec (CommRingCat.of L_i) ⟶ X' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑Γ(Z_i, ⊤)) L_i)) ≫ h_i
    have : AlgebraicGeometry.IsOpenImmersion j_i := hOpen_ji
    have hSub_Ugen' : Set.range ⇑j_i ⊆ Set.range ⇑U_gen'.ι := by
      rw [U_gen'.range_ι]
      exact fun y hy => (hRange_ji hy).2
    let j_lift : AlgebraicGeometry.Spec (CommRingCat.of L_i) ⟶ U_gen'.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_gen'.ι j_i hSub_Ugen'
    have hj_fac : j_lift ≫ U_gen'.ι = j_i :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_gen'.ι j_i hSub_Ugen'
    have : AlgebraicGeometry.IsOpenImmersion (j_lift ≫ U_gen'.ι) := by
      rw [hj_fac]; exact hOpen_ji
    have : AlgebraicGeometry.IsOpenImmersion j_lift :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j_lift U_gen'.ι
    have hRed_SpecLi : AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of L_i)) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion j_lift
    have : _root_.IsReduced L_i :=
      (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of L_i)).mp hRed_SpecLi
    have : _root_.IsReduced ↑Γ(Z_i, ⊤) :=
      isReduced_of_injective (algebraMap (↑Γ(Z_i, ⊤)) L_i) hInj_i
    have : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec Γ(Z_i, ⊤)) :=
      (AlgebraicGeometry.affine_isReduced_iff Γ(Z_i, ⊤)).mpr inferInstance
    exact AlgebraicGeometry.isReduced_of_isOpenImmersion Z_i.isoSpec.hom
  have : AlgebraicGeometry.IsReduced X' :=
    AlgebraicGeometry.IsReduced.of_openCover X' X'.affineCover
  have hIrred_top_U : IsIrreducible (Set.univ : Set ↥U_gen'.toScheme) :=
    (irreducibleSpace_def ↥U_gen'.toScheme).mp hIrred_Ugen'
  have hIrred_img : IsIrreducible ((⇑U_gen'.ι) '' Set.univ) :=
    hIrred_top_U.image (⇑U_gen'.ι) U_gen'.ι.continuous.continuousOn
  rw [Set.image_univ, U_gen'.range_ι] at hIrred_img
  have hIrred_cl : IsIrreducible (closure (↑U_gen' : Set X')) := hIrred_img.closure
  rw [(hDenseGen g_X').closure_eq] at hIrred_cl
  have : IrreducibleSpace ↥X' := (irreducibleSpace_def ↥X').mpr hIrred_cl
  have hInt_X' : AlgebraicGeometry.IsIntegral X' :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X'
  have : AlgebraicGeometry.IsProper f_bl := hProp
  have : AlgebraicGeometry.IsSeparated g_X := hSS.2.2.1
  have hSep_X' : AlgebraicGeometry.IsSeparated g_X' := by
    rw [← hf_comm]
    exact inferInstance
  exact ⟨hInt_X', hFlat_X', hSep_X', hLFP_X', hCharts⟩

theorem weil_strictlySemistable_etale_chart_blowup_gluing (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hFinSpec : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)))
    (t₀ : ↥V)
    (ht₀_ne : t₀ ≠ 0)
    (ht₀_gen : ∀ (Q : Ideal ↥V) [Q.IsPrime], t₀ ∉ Q ↔ Q = ⊥)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_X)
    (z : X)
    (hz_cl : IsClosed ({z} : Set X))
    (P_z : Ideal ↥V) [P_z.IsPrime]
    (hPz_eq : (g_X.base z).asIdeal = P_z)
    (hz_ne : P_z ≠ ⊥)
    (t_z π₁ : ↥V)
    (ht_z : t_z ∉ P_z)
    (ht_z_iff : ∀ (Q : Ideal ↥V) [Q.IsPrime], t_z ∉ Q ↔ Q ≤ P_z)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z]
    [IsLocalization.Away t_z R_z] [IsLocalization.AtPrime R_z P_z]
    (hπ₁_mem : π₁ ∈ P_z)
    (hπ₁_ne : π₁ ≠ 0)
    (W : X.Opens) (hz_W : z ∈ W)
    {A_global : CommRingCat.{u}}
    {φ_V : CommRingCat.of ↥V ⟶ A_global}
    (e : W.toScheme ⟶ AlgebraicGeometry.Spec A_global)
    (hEt_e : AlgebraicGeometry.Etale e)
    (he_comm : W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map φ_V)
    (A_loc : CommRingCat.{u})
    (φ_Rz : CommRingCat.of R_z ⟶ A_loc)
    (φ_glob_loc : A_global ⟶ A_loc)
    (hOpen_j : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map φ_glob_loc))
    (hj_range : Set.range (AlgebraicGeometry.Spec.map φ_glob_loc).base =
      {q : ↥(AlgebraicGeometry.Spec A_global) | φ_V.hom t_z ∉ q.asIdeal})
    (hj_comm : φ_V ≫ φ_glob_loc = CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)
    (I_sec : Ideal ↑A_loc)
    (I_base : Ideal R_z)
    (hIBase_ne : I_base ≠ ⊤)
    (hSurj_sec : Function.Surjective ((Ideal.Quotient.mk I_sec).comp φ_Rz.hom))
    (hKer_sec : RingHom.ker ((Ideal.Quotient.mk I_sec).comp φ_Rz.hom) = I_base)
    (hz_sec : ∀ f ∈ I_sec, ∀ q_z : ↥(AlgebraicGeometry.Spec A_loc),
      (AlgebraicGeometry.Spec.map φ_glob_loc).base q_z =
        e.base ⟨z, hz_W⟩ →
      f ∈ q_z.asIdeal)
    (hSecIso : ∀ (C₀ : Type u) [CommRing C₀]
        [Algebra (R_z ⧸ I_base) C₀]
        [Algebra.Etale (R_z ⧸ I_base) C₀]
        (q_z : Ideal C₀) [q_z.IsPrime],
      Ideal.comap (algebraMap ↥V R_z)
        (Ideal.comap (algebraMap R_z (R_z ⧸ I_base))
          (Ideal.comap (algebraMap (R_z ⧸ I_base) C₀) q_z)) = P_z →
      ∃ h : C₀, h ∉ q_z ∧
        Function.Bijective (algebraMap (R_z ⧸ I_base) (Localization.Away h)))
    (M : AlgebraicGeometry.Scheme.{u})
    (p_M : M ⟶ AlgebraicGeometry.Spec A_loc)
    (U_M : M.Opens)
    (e_M : U_M.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
    (hMod : IsLocalSemistableBlowupModel V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))
      (I_sec ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)}) p_M)
    (hEt_M : AlgebraicGeometry.Etale e_M)
    (heM_comm : U_M.ι ≫ p_M ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) =
      e_M ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (hSm_M : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (U_M.ι ≫ p_M ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))) :
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bl : X' ⟶ X)
      (U_iso : X.Opens)
      (V_sm' : X'.Opens)
      (e' : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsStrictlySemistableCurveOverValuation V g_X' ∧
      V_sm' ≤ (TopologicalSpace.Opens.map f_bl.base).obj W ∧
      AlgebraicGeometry.IsProper f_bl ∧
      f_bl ≫ g_X = g_X' ∧
      CategoryTheory.IsIso (f_bl ∣_ U_iso) ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso) ∧
      (∀ x : X, x ∉ U_iso →
        ∃ (hxW : x ∈ W) (q_x : ↥(AlgebraicGeometry.Spec A_loc)),
          (AlgebraicGeometry.Spec.map φ_glob_loc).base q_x =
            e.base ⟨x, hxW⟩ ∧
          I_sec ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)} ≤ q_x.asIdeal) ∧
      AlgebraicGeometry.Etale e' ∧
      V_sm'.ι ≫ g_X' = e' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X') ∧
      (∀ (R : Type u) [CommRing R] [IsLocalRing R]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X')
          (mR : AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W.toScheme),
        mR.asIdeal = IsLocalRing.maximalIdeal R →
        (ψ ≫ f_bl).base mR = z →
        ψ_W ≫ W.ι = ψ ≫ f_bl →
        ∃ (ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M),
          ψ_M ≫ p_M ≫ AlgebraicGeometry.Spec.map φ_glob_loc =
            ψ_W ≫ e ∧
          ψ_M ≫ p_M ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) =
            ψ ≫ g_X' ∧
          (∀ ψ_UM : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U_M.toScheme,
            ψ_UM ≫ U_M.ι = ψ_M →
            ∃ ψ_V : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ V_sm'.toScheme,
              ψ_V ≫ V_sm'.ι = ψ ∧
              ψ_V ≫ e' = ψ_UM ≫ e_M) ∧
          (Set.range ψ_M.base ⊆ (U_M : Set M) →
            Set.range ψ.base ⊆ (V_sm' : Set X'))) :=
by
  let g_loc : AlgebraicGeometry.Spec A_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)
  let I_center : Ideal ↑A_loc := I_sec ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)}
  let I_zc : Ideal R_z := I_base ⊔ Ideal.span {algebraMap ↥V R_z π₁}
  obtain ⟨B', j_W, e_0, π_ZB, m_Z,
      hOpen_jW, hEt_e0, he_0_glob, he_0_gX, hSurj_ZB, hRange_ZB, hZ_comm, hm_Z⟩ :=
    weil_etale_chart_shrinking_and_center_quotient K V X g_X z P_z hPz_eq t_z π₁ ht_z R_z
      hπ₁_mem W hz_W e hEt_e he_comm A_loc φ_Rz φ_glob_loc hOpen_j hj_range hj_comm
      I_sec I_base hIBase_ne hSurj_sec hKer_sec hz_sec hSecIso
  have : AlgebraicGeometry.IsOpenImmersion j_W := hOpen_jW
  have : AlgebraicGeometry.Etale e_0 := hEt_e0
  let ι_0 : AlgebraicGeometry.Spec B' ⟶ X := j_W ≫ W.ι
  have hOpen_0 : AlgebraicGeometry.IsOpenImmersion ι_0 := inferInstance
  have hZ_comm' : AlgebraicGeometry.Spec.map π_ZB ≫ ι_0 ≫ g_X =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_zc).comp (algebraMap ↥V R_z))) := by
    simpa only [ι_0, CategoryTheory.Category.assoc] using hZ_comm
  have hm_Z' : (AlgebraicGeometry.Spec.map π_ZB ≫ ι_0).base m_Z = z := hm_Z
  have hClosed_Z : IsClosed (Set.range (AlgebraicGeometry.Spec.map π_ZB ≫ ι_0).base) :=
    weil_valuation_closed_point_center_isClosed K V hFinSpec X g_X hSS.2.2.1 z hz_cl
      P_z hPz_eq t_z ht_z R_z I_zc B' ι_0 hOpen_0 π_ZB hSurj_ZB hZ_comm' m_Z hm_Z'
  let Z_mod : Set X := Set.range (AlgebraicGeometry.Spec.map π_ZB ≫ ι_0).base
  let U_iso : X.Opens := ⟨Z_modᶜ, hClosed_Z.isOpen_compl⟩
  have hz_not_U : z ∉ U_iso := fun hz_in => hz_in ⟨m_Z, hm_Z'⟩
  have hGen_U : ∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso := by
    intro x hx_bot
    by_contra hx_not_U
    have hx_Z : x ∈ Z_mod := Classical.not_not.mp hx_not_U
    obtain ⟨q, hq⟩ := hx_Z
    let p : ↥(AlgebraicGeometry.Spec B') := (AlgebraicGeometry.Spec.map π_ZB).base q
    have hp_x : ι_0.base p = x := hq
    have hp_mem : p ∈ Set.range (AlgebraicGeometry.Spec.map π_ZB).base := ⟨q, rfl⟩
    rw [hRange_ZB] at hp_mem
    have hp_le : I_center ≤ (e_0.base p).asIdeal := hp_mem
    have hπ_e0 : φ_Rz.hom (algebraMap ↥V R_z π₁) ∈ (e_0.base p).asIdeal :=
      (le_sup_right.trans hp_le) (Ideal.mem_span_singleton_self _)
    have hgx_eq : g_X.base x = g_loc.base (e_0.base p) := by
      rw [← hp_x]
      exact congrArg (fun h => h.base p) he_0_gX
    have hπ_gx : π₁ ∈ (g_X.base x).asIdeal := by
      rw [hgx_eq, AlgebraicGeometry.Spec.map_base]
      exact hπ_e0
    rw [hx_bot, Ideal.mem_bot] at hπ_gx
    exact hπ₁_ne hπ_gx
  have hNotU : ∀ x : X, x ∉ U_iso →
      ∃ (hxW : x ∈ W) (q_x : ↥(AlgebraicGeometry.Spec A_loc)),
        (AlgebraicGeometry.Spec.map φ_glob_loc).base q_x = e.base ⟨x, hxW⟩ ∧
        I_center ≤ q_x.asIdeal := by
    intro x hx_not_U
    have hx_Z : x ∈ Z_mod := Classical.not_not.mp hx_not_U
    obtain ⟨q, hq⟩ := hx_Z
    let p : ↥(AlgebraicGeometry.Spec B') := (AlgebraicGeometry.Spec.map π_ZB).base q
    have hp_x : W.ι.base (j_W.base p) = x := hq
    have hxW : x ∈ W := hp_x ▸ (j_W.base p).2
    have hjW_eq : (⟨x, hxW⟩ : W.toScheme) = j_W.base p := Subtype.ext hp_x.symm
    have hp_mem : p ∈ Set.range (AlgebraicGeometry.Spec.map π_ZB).base := ⟨q, rfl⟩
    rw [hRange_ZB] at hp_mem
    refine ⟨hxW, e_0.base p, ?_, hp_mem⟩
    rw [hjW_eq]
    exact congrArg (fun h => h.base p) he_0_glob
  obtain ⟨hProp_M, hIso_M, hCharts_M⟩ := hMod
  let U_loc_iso : (AlgebraicGeometry.Spec A_loc).Opens :=
    ⟨(PrimeSpectrum.zeroLocus (I_center : Set ↑A_loc))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus (I_center : Set ↑A_loc)).isOpen_compl⟩
  have hCompl : (U_iso : Set X)ᶜ =
      ι_0.base '' ((e_0.base) ⁻¹' (U_loc_iso : Set ↥(AlgebraicGeometry.Spec A_loc))ᶜ) := by
    have hPre_eq : (e_0.base) ⁻¹' (U_loc_iso : Set ↥(AlgebraicGeometry.Spec A_loc))ᶜ =
        Set.range (AlgebraicGeometry.Spec.map π_ZB).base := by
      rw [hRange_ZB]
      ext p
      exact Classical.not_not.trans
        ((PrimeSpectrum.mem_zeroLocus (e_0.base p : PrimeSpectrum ↑A_loc)
          (I_center : Set ↑A_loc)).trans SetLike.coe_subset_coe)
    change (Z_modᶜ)ᶜ =
      ι_0.base '' ((e_0.base) ⁻¹' (U_loc_iso : Set ↥(AlgebraicGeometry.Spec A_loc))ᶜ)
    rw [compl_compl, hPre_eq]
    ext x
    simp only [Z_mod, Set.mem_range, Set.mem_image]
    constructor
    · rintro ⟨q, rfl⟩
      exact ⟨(AlgebraicGeometry.Spec.map π_ZB).base q, ⟨q, rfl⟩, rfl⟩
    · rintro ⟨p, ⟨q, rfl⟩, rfl⟩
      exact ⟨q, rfl⟩
  obtain ⟨X', f_bl, V_sm', e', α_M, ι_W, ι_U,
      hOpen_ιW, hOpen_ιU, hCov_X', hιW_f, hιU_f,
      hV_le, hProp_f, hIso_f, hEt_αM, hEt_e', he'_eq,
      ⟨β_W, hβW_f, hβW_e⟩, hBridge_raw⟩ :=
    weil_etale_chart_two_open_pullback_gluing W φ_glob_loc e j_W hOpen_jW e_0 hEt_e0 he_0_glob
      p_M hProp_M U_loc_iso hIso_M U_iso hCompl U_M e_M hEt_M
  have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpen_ιW
  have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_ιU
  have : AlgebraicGeometry.Etale α_M := hEt_αM
  let g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) := f_bl ≫ g_X
  have hVsm_fac : V_sm'.ι ≫ g_X' = α_M ≫ (U_M.ι ≫ p_M ≫ g_loc) := by
    calc V_sm'.ι ≫ g_X'
      _ = (V_sm'.ι ≫ f_bl) ≫ g_X := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (β_W ≫ j_W ≫ W.ι) ≫ g_X := by rw [hβW_f]
      _ = β_W ≫ (j_W ≫ W.ι ≫ g_X) := by simp only [CategoryTheory.Category.assoc]
      _ = β_W ≫ (e_0 ≫ g_loc) := by rw [he_0_gX]
      _ = (β_W ≫ e_0) ≫ g_loc := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (α_M ≫ U_M.ι ≫ p_M) ≫ g_loc := by rw [hβW_e]
      _ = α_M ≫ (U_M.ι ≫ p_M ≫ g_loc) := by simp only [CategoryTheory.Category.assoc]
  have he'_comm : V_sm'.ι ≫ g_X' =
      e' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    rw [hVsm_fac, heM_comm, ← CategoryTheory.Category.assoc, ← he'_eq]
  have hSm_Vsm' : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X') := by
    rw [hVsm_fac]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_M.ι ≫ p_M ≫ g_loc) := hSm_M
    have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (α_M ≫ (U_M.ι ≫ p_M ≫ g_loc)) := inferInstance
    simpa using h01
  have hTransport : ∀ {Z T Y : AlgebraicGeometry.Scheme.{u}}
      (ι_Z : Z ⟶ X') [AlgebraicGeometry.IsOpenImmersion ι_Z]
      (p_T : Z ⟶ T) [AlgebraicGeometry.Etale p_T]
      (g_T : T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      ι_Z ≫ g_X' = p_T ≫ g_T →
      ∀ (y : X') (z₀ : Z), ι_Z.base z₀ = y →
      ∀ (U_T : T.Opens), p_T.base z₀ ∈ U_T →
      ∀ (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (e_T : U_T.toScheme ⟶ Y) [AlgebraicGeometry.Etale e_T],
        U_T.ι ≫ g_T = e_T ≫ p_Y →
        ∃ (U' : X'.Opens) (e_U' : U'.toScheme ⟶ Y),
          y ∈ U' ∧ AlgebraicGeometry.Etale e_U' ∧ U'.ι ≫ g_X' = e_U' ≫ p_Y := by
    intro Z T Y ι_Z _ p_T _ g_T hcomm_Z y z₀ hz₀ U_T hz₀_U p_Y e_T _ he_T
    let U_Z : Z.Opens := (TopologicalSpace.Opens.map p_T.base).obj U_T
    have hz₀_UZ : z₀ ∈ U_Z := hz₀_U
    let j : U_Z.toScheme ⟶ X' := U_Z.ι ≫ ι_Z
    let U' : X'.Opens := j.opensRange
    have hy_U' : y ∈ U' := ⟨⟨z₀, hz₀_UZ⟩, by
      change ι_Z.base (U_Z.ι.base ⟨z₀, hz₀_UZ⟩) = y
      exact hz₀⟩
    let e_U' : U'.toScheme ⟶ Y := j.isoOpensRange.inv ≫ (p_T ∣_ U_T) ≫ e_T
    have hEt_eU' : AlgebraicGeometry.Etale e_U' := inferInstance
    refine ⟨U', e_U', hy_U', hEt_eU', ?_⟩
    have hj_ι : j.isoOpensRange.inv ≫ j = U'.ι :=
      (CategoryTheory.Iso.inv_comp_eq j.isoOpensRange).mpr j.isoOpensRange_hom_ι.symm
    calc U'.ι ≫ g_X'
      _ = (j.isoOpensRange.inv ≫ (U_Z.ι ≫ ι_Z)) ≫ g_X' := by rw [← hj_ι]
      _ = j.isoOpensRange.inv ≫ U_Z.ι ≫ (ι_Z ≫ g_X') := by
        simp only [CategoryTheory.Category.assoc]
      _ = j.isoOpensRange.inv ≫ (U_Z.ι ≫ p_T) ≫ g_T := by
        rw [hcomm_Z]; simp only [CategoryTheory.Category.assoc]
      _ = j.isoOpensRange.inv ≫ ((p_T ∣_ U_T) ≫ U_T.ι) ≫ g_T := by
        rw [← AlgebraicGeometry.morphismRestrict_ι p_T U_T]
      _ = j.isoOpensRange.inv ≫ (p_T ∣_ U_T) ≫ (U_T.ι ≫ g_T) := by
        simp only [CategoryTheory.Category.assoc]
      _ = e_U' ≫ p_Y := by
        rw [he_T]; simp only [e_U', CategoryTheory.Category.assoc]
  have hCharts_X' : ∀ y : X',
      (∃ (U : X'.Opens)
          (e_c : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
        y ∈ U ∧
        AlgebraicGeometry.Etale e_c ∧
        U.ι ≫ g_X' = e_c ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
      (∃ (U : X'.Opens) (b : ↥V)
          (e_c : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))),
        y ∈ U ∧
        b ≠ 0 ∧
        AlgebraicGeometry.Etale e_c ∧
        U.ι ≫ g_X' = e_c ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
    intro y
    rcases hCov_X' y with ⟨w, hw⟩ | ⟨u, hu⟩
    · let π_0 := CategoryTheory.Limits.pullback.fst e_0 p_M
      let π_M := CategoryTheory.Limits.pullback.snd e_0 p_M
      have hcomm_W : ι_W ≫ g_X' = π_M ≫ (p_M ≫ g_loc) := by
        calc ι_W ≫ g_X'
          _ = (ι_W ≫ f_bl) ≫ g_X := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (π_0 ≫ j_W ≫ W.ι) ≫ g_X := by rw [hιW_f]
          _ = π_0 ≫ (j_W ≫ W.ι ≫ g_X) := by simp only [CategoryTheory.Category.assoc]
          _ = (π_0 ≫ e_0) ≫ g_loc := by
            rw [he_0_gX]; simp only [g_loc, CategoryTheory.Category.assoc]
          _ = (π_M ≫ p_M) ≫ g_loc := by rw [CategoryTheory.Limits.pullback.condition]
          _ = π_M ≫ (p_M ≫ g_loc) := CategoryTheory.Category.assoc _ _ _
      rcases hCharts_M (π_M.base w) with
        ⟨U_y, e_y, hw_U, hEt_ey, he_y⟩ | ⟨U_y, b, e_y, hw_U, hb_ne, hEt_ey, he_y⟩
      · left
        have : AlgebraicGeometry.Etale e_y := hEt_ey
        exact hTransport ι_W π_M (p_M ≫ g_loc) hcomm_W y w hw U_y hw_U _ e_y he_y
      · right
        have : AlgebraicGeometry.Etale e_y := hEt_ey
        obtain ⟨U', e_U', hy_U', hEt_eU', he_U'⟩ :=
          hTransport ι_W π_M (p_M ≫ g_loc) hcomm_W y w hw U_y hw_U _ e_y he_y
        exact ⟨U', b, e_U', hy_U', hb_ne, hEt_eU', he_U'⟩
    · have hcomm_U : ι_U ≫ g_X' = U_iso.ι ≫ g_X := by
        rw [← CategoryTheory.Category.assoc, hιU_f]
      rcases hSS.2.2.2.2 (U_iso.ι.base u) with
        ⟨W_y, e_y, hu_W, hEt_ey, he_y⟩ | ⟨W_y, b, e_y, hu_W, hb_ne, hEt_ey, he_y⟩
      · left
        have : AlgebraicGeometry.Etale e_y := hEt_ey
        exact hTransport ι_U U_iso.ι g_X hcomm_U y u hu W_y hu_W _ e_y he_y
      · right
        have : AlgebraicGeometry.Etale e_y := hEt_ey
        obtain ⟨U', e_U', hy_U', hEt_eU', he_U'⟩ :=
          hTransport ι_U U_iso.ι g_X hcomm_U y u hu W_y hu_W _ e_y he_y
        exact ⟨U', b, e_U', hy_U', hb_ne, hEt_eU', he_U'⟩
  have hSS' : IsStrictlySemistableCurveOverValuation V g_X' :=
    weil_strictlySemistable_modification_of_etale_charts K V t₀ ht₀_ne ht₀_gen
      g_X g_X' f_bl U_iso hSS hProp_f rfl hIso_f hGen_U hCharts_X'
  refine ⟨X', g_X', f_bl, U_iso, V_sm', e',
    hSS', hV_le, hProp_f, rfl, hIso_f, hGen_U, hNotU, hEt_e', he'_comm, hSm_Vsm', ?_⟩
  intro R _ _ ψ mR ψ_W hmR hψ_z hψ_W
  have hmR_not_U : (ψ ≫ f_bl).base mR ∉ U_iso := hψ_z.symm ▸ hz_not_U
  obtain ⟨ψ_M, ψ_S0, hψM_glob, hψM_e0, hψS0_f, hψM_lift, hψM_range⟩ :=
    hBridge_raw R ψ mR ψ_W hmR hmR_not_U hψ_W
  refine ⟨ψ_M, hψM_glob, ?_, hψM_lift, hψM_range⟩
  calc ψ_M ≫ p_M ≫ g_loc
    _ = (ψ_M ≫ p_M) ≫ g_loc := (CategoryTheory.Category.assoc _ _ _).symm
    _ = (ψ_S0 ≫ e_0) ≫ g_loc := by rw [hψM_e0]
    _ = ψ_S0 ≫ (e_0 ≫ g_loc) := CategoryTheory.Category.assoc _ _ _
    _ = ψ_S0 ≫ (j_W ≫ W.ι ≫ g_X) := by rw [← he_0_gX]
    _ = (ψ_S0 ≫ j_W ≫ W.ι) ≫ g_X := by simp only [CategoryTheory.Category.assoc]
    _ = (ψ ≫ f_bl) ≫ g_X := by rw [hψS0_f]
    _ = ψ ≫ g_X' := CategoryTheory.Category.assoc _ _ _

theorem weil_strictlySemistable_elementary_point_blowups (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V) :
    HasStrictlySemistablePointBlowups V :=
by
  obtain ⟨⟨t₀, ht₀_ne, ht₀_gen⟩, hLocSec, hNodalNonSm⟩ :=
    weil_valuation_henselian_etale_section_and_nodal_nonsmooth K m V hPkg
  refine ⟨?_, ?_⟩
  · intro X g_X z W hz e s₁ c₁ π₁ hSS hz_cl hz_ne hEt_e he_comm hs₁ hπ₁_mem hπ₁_ne hz_lin
    have hExPz : ∃ (P_z : Ideal ↥V) (_ : P_z.IsPrime), (g_X.base z).asIdeal = P_z :=
      ⟨(g_X.base z : PrimeSpectrum ↥V).asIdeal, (g_X.base z : PrimeSpectrum ↥V).isPrime, rfl⟩
    obtain ⟨P_z, instPrimePz, hPz_eq⟩ := hExPz
    haveI : P_z.IsPrime := instPrimePz
    have hz_ne' : P_z ≠ ⊥ := hPz_eq ▸ hz_ne
    have hs₁' : s₁ ∉ P_z := hPz_eq ▸ hs₁
    have hπ₁_mem' : π₁ ∈ P_z := hPz_eq ▸ hπ₁_mem
    obtain ⟨⟨t_z, ht_z, ht_z_iff⟩, hLocRz⟩ := hLocSec P_z hz_ne'
    have hExRz :
        ∃ (R_z : Type u) (instCR : CommRing R_z) (instAlg : Algebra ↥V R_z),
          @IsLocalization.Away ↥V _ t_z R_z _ instAlg :=
      ⟨Localization.Away t_z, inferInstance, inferInstance, inferInstance⟩
    obtain ⟨R_z, instCR, instAlg, instAway⟩ := hExRz
    letI : CommRing R_z := instCR
    letI : Algebra ↥V R_z := instAlg
    haveI : IsLocalization.Away t_z R_z := instAway
    obtain ⟨hAtPrime, hSecIsoAll⟩ := hLocRz t_z ht_z ht_z_iff R_z
    haveI : IsLocalization.AtPrime R_z P_z := hAtPrime
    obtain ⟨⟨hBotNeTop, hOpen_j, hj_range, hSurj_sec, hKer_sec⟩,
        M_sm, p_sm, U_sm1, e_sm1, hMod_sm, hEt_sm1, he_sm1_comm, hSm_sm1, hLift_sm⟩ :=
      weil_local_linear_p1_smooth_blowup_model K V P_z t_z s₁ c₁ π₁ ht_z R_z
        hs₁' hπ₁_mem' hπ₁_ne
    have hj_comm :
        CommRingCat.ofHom (Polynomial.C : ↥V →+* Polynomial ↥V) ≫
            CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)) =
          CommRingCat.ofHom (algebraMap ↥V R_z) ≫
            CommRingCat.ofHom (Polynomial.C : R_z →+* Polynomial R_z) := by
      ext x
      simp
    have hz_sec :
        ∀ f ∈ Ideal.span
            {(Polynomial.mapRingHom (algebraMap ↥V R_z))
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)},
          ∀ q_z : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_z))),
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))).base q_z =
              e.base ⟨z, hz⟩ →
            f ∈ q_z.asIdeal := by
      intro f hf q_z hqz
      have hlin_qz :
          (Polynomial.mapRingHom (algebraMap ↥V R_z))
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) ∈ q_z.asIdeal := by
        have hmem :
            Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁ ∈
              ((AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))).base
                  q_z).asIdeal := by
          rw [hqz]
          exact hz_lin
        rw [AlgebraicGeometry.Spec.map_base] at hmem
        exact hmem
      exact (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hlin_qz)) hf
    obtain ⟨X', g_X', f_bl, U_iso, V_sm', e',
        hSS', hV_le, hProp, hf_comm, hIso_U, hGen_U, _hNotU,
        hEt', he'_comm, hSm', hBridge⟩ :=
      weil_strictlySemistable_etale_chart_blowup_gluing K V hPkg.1 t₀ ht₀_ne ht₀_gen
        X g_X hSS z hz_cl P_z hPz_eq hz_ne' t_z π₁ ht_z ht_z_iff R_z hπ₁_mem' hπ₁_ne W hz
        e hEt_e he_comm
        (CommRingCat.of (Polynomial R_z))
        (CommRingCat.ofHom Polynomial.C)
        (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))
        hOpen_j hj_range hj_comm
        (Ideal.span
          {(Polynomial.mapRingHom (algebraMap ↥V R_z))
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)})
        ⊥ hBotNeTop hSurj_sec hKer_sec hz_sec
        (hSecIsoAll ⊥ hBotNeTop)
        M_sm p_sm U_sm1 e_sm1 hMod_sm hEt_sm1 he_sm1_comm hSm_sm1
    refine ⟨X', g_X', f_bl, U_iso, V_sm', e',
      hSS', hV_le, hProp, hf_comm, hIso_U, hGen_U, hEt', he'_comm, hSm', ?_⟩
    intro R _ _ _ ψ mR ψ_W hmR hψ_z hψ_W q hπ₁_R_ne hlin_R
    obtain ⟨ψ_M, hψM_j, hψM_g, hψM_lift, _⟩ :=
      hBridge R ψ mR ψ_W hmR hψ_z hψ_W
    have hπ₁_M_ne :
        (AlgebraicGeometry.Spec.preimage
          (ψ_M ≫ p_sm ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                CommRingCat.ofHom Polynomial.C))).hom π₁ ≠ 0 := by
      rw [hψM_g]
      exact hπ₁_R_ne
    have hlin_M :
        (AlgebraicGeometry.Spec.preimage
          (ψ_M ≫ p_sm ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z))))).hom
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_sm ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                  CommRingCat.ofHom Polynomial.C))).hom π₁ * q := by
      rw [hψM_j, hψM_g]
      exact hlin_R
    obtain ⟨ψ_U, hψU_ι, hψU_eq⟩ := hLift_sm R ψ_M q hπ₁_M_ne hlin_M
    obtain ⟨ψ_V, hψV_ι, hψV_e⟩ := hψM_lift ψ_U hψU_ι
    refine ⟨ψ_V, hψV_ι, ?_⟩
    rw [← hψM_g, hψV_e]
    exact hψU_eq
  · intro X g_X z W hz a e s₁ π₁ a' hSS hz_cl hz_ne ha_ne hEt_e he_comm ha_eq hs₁ hπ₁_mem hz_axes
