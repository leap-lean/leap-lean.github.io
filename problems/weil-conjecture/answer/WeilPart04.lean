        have hb_smul : a • (1 : ↑B₀) = ψ₀.hom a := by
          rw [Algebra.smul_def, mul_one]; rfl
        rw [hmk_smul, TensorProduct.tmul_smul, TensorProduct.smul_tmul', hb_smul,
