        apply eq_top_iff.mpr
        rw [← hα₀_prim]
        exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr (zero_mem _))
      · exact hα₀_prim
    have : Algebra.IsAlgebraic κ κ' := Algebra.IsAlgebraic.of_finite κ κ'
    have hα_alg_gen : Algebra.adjoin κ ({α_bar} : Set κ') = ⊤ := by
      rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
        (fun x _ => Algebra.IsAlgebraic.isAlgebraic (R := κ) x), hα_bar_gen]
      rfl
    obtain ⟨x_α_bar, hx_α_bar⟩ := hπ_R₁_surj α_bar
    obtain ⟨a_lift, rfl⟩ := Ideal.Quotient.mk_surjective x_α_bar
    obtain ⟨e_lift, he_lift⟩ := Ideal.Quotient.mk_surjective e₀
    let θ₀ : ↥R₁ := a_lift * e_lift
    have hθ₀_qF : q_F θ₀ = q_F a_lift * e₀ := by
      dsimp only [θ₀]
      rw [map_mul, he_lift]
    let θ : ↥R_Z := θ₀.1
    have hθ_int_G : _root_.IsIntegral ↥G θ := hR₁_le_ic θ₀.2
    have hπ_θ : π_res θ = α_bar := by
      have hdiff_qbar : q_F a_lift - q_F θ₀ ∈ q_bar₀ := by
        rw [hθ₀_qF]
        have heq : q_F a_lift - q_F a_lift * e₀ = q_F a_lift * (1 - e₀) := by ring
        rw [heq]
        exact q_bar₀.mul_mem_left _ h1_sub_e₀
      have hdiff_q₀ : a_lift - θ₀ ∈ q₀ := by rwa [← hcomap_qbar₀]
      have hres_eq : π_res a_lift.1 - π_res θ = 0 :=
        (IsLocalRing.residue_eq_zero_iff (a_lift.1 - θ)).mpr hdiff_q₀
      have ha_res : π_res a_lift.1 = α_bar := hx_α_bar
      exact (sub_eq_zero.mp hres_eq).symm.trans ha_res
    have hθ₀_not_q₀ : θ₀ ∉ q₀ := fun h =>
      hα_bar_ne (hπ_θ.symm.trans ((IsLocalRing.residue_eq_zero_iff θ).mpr h))
    let S_θ : Subalgebra ↥G ↥R_Z := Algebra.adjoin ↥G ({θ} : Set ↥R_Z)
    let p_θ : Ideal ↥S_θ := Ideal.comap (algebraMap ↥S_θ ↥R_Z) m_RZ
    have : p_θ.IsPrime := Ideal.IsPrime.comap _
    let S₀ : Subalgebra ↥G ↥R₁ := Algebra.adjoin ↥G ({θ₀} : Set ↥R₁)
    have hS₀_sub : ∀ x : ↥S₀, x.1.1 ∈ S_θ := by
      rintro ⟨x, hx⟩
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
      · rintro _ rfl; exact Algebra.self_mem_adjoin_singleton ↥G θ
      · intro g; exact S_θ.algebraMap_mem g
      · intro u v _ _ hu hv; exact S_θ.add_mem hu hv
      · intro u v _ _ hu hv; exact S_θ.mul_mem hu hv
    let p₀_S : Ideal ↥S₀ := Ideal.comap (algebraMap ↥S₀ ↥R₁) q₀
    have hp₀_S_prime : p₀_S.IsPrime := Ideal.IsPrime.comap _
    have hGoingUp_uniq : ∀ (Q' : Ideal ↥R₁), Q'.IsPrime →
        Ideal.under ↥S₀ Q' ≤ p₀_S → Q' ≤ q₀ := by
      intro Q' hQ'_prime hle_p₀
      have hInt_S₀_R₁ : Algebra.IsIntegral ↥S₀ ↥R₁ :=
        ⟨fun x => (Algebra.IsIntegral.isIntegral (R := ↥G) x).tower_top⟩
      obtain ⟨Q'', hQ'_le_Q'', hQ''_prime, hQ''_under⟩ :=
        @Ideal.exists_ideal_over_prime_of_isIntegral ↥S₀ _ ↥R₁ _ _ hInt_S₀_R₁
          p₀_S hp₀_S_prime Q' hle_p₀
      have hmG_Q'' : m_G ≤ Ideal.comap (algebraMap ↥G ↥R₁) Q'' := by
        intro g hg
        have hg_p₀ : algebraMap ↥G ↥S₀ g ∈ p₀_S := hmG_le hg
        rw [← hQ''_under] at hg_p₀
        exact hg_p₀
      have hI₁_Q'' : I₁ ≤ Q'' := Ideal.map_le_iff_le_comap.mpr hmG_Q''
      have hQ''_eq : Q'' = q₀ := by
        by_contra hne_Q''
        have hnot_le : ¬ q₀ ≤ Q'' := fun hle =>
          hQ''_prime.ne_top ((Ideal.isMaximal_def.mp hq₀_max).2 Q''
            (lt_of_le_of_ne hle (Ne.symm hne_Q'')))
        obtain ⟨z, hz_q₀, hz_not_Q''⟩ := Set.not_subset.mp hnot_le
        have hez_I₁ : e_lift * z ∈ I₁ := by
          apply Ideal.Quotient.eq_zero_iff_mem.mp
          change q_F (e_lift * z) = 0
          rw [map_mul, he_lift]
          exact he₀_ann (q_F z) (Ideal.mem_map_of_mem q_F hz_q₀)
        have he_in_Q'' : e_lift ∈ Q'' :=
          (hQ''_prime.mem_or_mem (hI₁_Q'' hez_I₁)).resolve_right hz_not_Q''
        have hθ₀_Q'' : θ₀ ∈ Q'' := Q''.mul_mem_left a_lift he_in_Q''
        have hθ₀_S₀ : (⟨θ₀, Algebra.self_mem_adjoin_singleton ↥G θ₀⟩ : ↥S₀) ∈
            Ideal.under ↥S₀ Q'' := hθ₀_Q''
        rw [hQ''_under] at hθ₀_S₀
        exact hθ₀_not_q₀ hθ₀_S₀
      exact hQ''_eq ▸ hQ'_le_Q''
    have hDiv_Sθ : ∀ t : q₀.primeCompl, ∃ (u : ↥R₁) (s_θ : p_θ.primeCompl),
        t.1.1 * u.1 = s_θ.1.1 := by
      intro t
      let M₀ : Submonoid ↥R₁ := p₀_S.primeCompl.map (algebraMap ↥S₀ ↥R₁)
      let T₀ := Localization M₀
      have ht_unit_T₀ : IsUnit (algebraMap ↥R₁ T₀ t.1) := by
        by_contra hnot_u
        obtain ⟨M_max, hM_max, ht_M⟩ := Ideal.exists_le_maximal
          (Ideal.span ({algebraMap ↥R₁ T₀ t.1} : Set T₀))
          (Ideal.span_singleton_ne_top hnot_u)
        have : M_max.IsPrime := hM_max.isPrime
        let Q' : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ T₀) M_max
        have : Q'.IsPrime := Ideal.IsPrime.comap _
        have hQ'_sub : Ideal.comap (algebraMap ↥S₀ ↥R₁) Q' ≤ p₀_S := by
          intro s hs
          by_contra hs_not
          have hs_M₀ : algebraMap ↥S₀ ↥R₁ s ∈ M₀ := ⟨s, hs_not, rfl⟩
          have hs_unit : IsUnit (algebraMap ↥R₁ T₀ (algebraMap ↥S₀ ↥R₁ s)) :=
            IsLocalization.map_units T₀ ⟨_, hs_M₀⟩
          exact hM_max.ne_top (Ideal.eq_top_of_isUnit_mem M_max hs hs_unit)
        have ht_Q' : t.1 ∈ Q' := ht_M (Ideal.mem_span_singleton_self _)
        exact t.2 (hGoingUp_uniq Q' inferInstance hQ'_sub ht_Q')
      obtain ⟨v_inv, hv_inv⟩ := ht_unit_T₀.exists_right_inv
      obtain ⟨⟨u, s_M₀⟩, hus⟩ := IsLocalization.surj M₀ v_inv
      obtain ⟨s₀, hs₀_not, hs₀_eq⟩ := s_M₀.2
      have hM₀_nzd : M₀ ≤ nonZeroDivisors ↥R₁ := by
        rintro _ ⟨s', hs'_not, rfl⟩
        apply mem_nonZeroDivisors_of_ne_zero
        intro h0
        have hs'0 : s' = 0 := Subtype.ext h0
        exact hs'_not (hs'0 ▸ p₀_S.zero_mem)
      have hinj_T₀ : Function.Injective (algebraMap ↥R₁ T₀) :=
        IsLocalization.injective T₀ hM₀_nzd
      have htu_eq : t.1 * u = algebraMap ↥S₀ ↥R₁ s₀ := by
        apply hinj_T₀
        have hus' : v_inv * algebraMap ↥R₁ T₀ s_M₀.1 = algebraMap ↥R₁ T₀ u := hus
        rw [map_mul, hs₀_eq]
        calc
          algebraMap ↥R₁ T₀ t.1 * algebraMap ↥R₁ T₀ u
              = algebraMap ↥R₁ T₀ t.1 * (v_inv * algebraMap ↥R₁ T₀ s_M₀.1) := by rw [← hus']
          _ = (algebraMap ↥R₁ T₀ t.1 * v_inv) * algebraMap ↥R₁ T₀ s_M₀.1 := by ring
          _ = algebraMap ↥R₁ T₀ s_M₀.1 := by rw [hv_inv, one_mul]
      let s_θ_el : ↥S_θ := ⟨s₀.1.1, hS₀_sub s₀⟩
      have hs_θ_not : s_θ_el ∉ p_θ := hs₀_not
      refine ⟨u, ⟨s_θ_el, hs_θ_not⟩, ?_⟩
      exact congrArg Subtype.val htu_eq
    have hSθ_units : ∀ s : p_θ.primeCompl, IsUnit (algebraMap ↥S_θ ↥R_Z s.1) :=
      fun s => IsLocalRing.notMem_maximalIdeal.mp s.2
    let ψ_C : Localization.AtPrime p_θ →+* ↥R_Z := IsLocalization.lift (M := p_θ.primeCompl) hSθ_units
    have hψ_C_eq : ∀ x : ↥S_θ, ψ_C (algebraMap ↥S_θ (Localization.AtPrime p_θ) x) = x.1 :=
      IsLocalization.lift_eq hSθ_units
    let _ : Algebra (Localization.AtPrime p_θ) ↥R_Z := ψ_C.toAlgebra
    have : Module.Finite (Localization.AtPrime p_θ) ↥R_Z := by
      obtain ⟨V_fin, hV_span⟩ := hFin_R₁.fg_top
      refine ⟨⟨V_fin.image Subtype.val, eq_top_iff.mpr ?_⟩⟩
      intro z _
      obtain ⟨⟨x₀, t⟩, hzt⟩ := @IsLocalization.surj _ _ q₀.primeCompl ↥R_Z _ _ hLoc_R₁ z
      obtain ⟨u, s_θ, htu⟩ := hDiv_Sθ t
      have hxu_mem : x₀ * u ∈ Submodule.span ↥G (↑V_fin : Set ↥R₁) := hV_span.symm ▸ Submodule.mem_top
      obtain ⟨c_fn, _, hc_sum⟩ := Submodule.mem_span_finset.mp hxu_mem
      have hzs : z * s_θ.1.1 = (x₀ * u).1 := by
        have hzt' : z * t.1.1 = x₀.1 := hzt
        calc
          z * s_θ.1.1 = z * (t.1.1 * u.1) := by rw [← htu]
          _ = (z * t.1.1) * u.1 := by ring
          _ = x₀.1 * u.1 := by rw [hzt']
      have hs_unit : IsUnit s_θ.1.1 := hSθ_units s_θ
      obtain ⟨s_inv, hs_inv⟩ := hs_unit.exists_right_inv
      have hz_eq : z = ∑ v ∈ V_fin,
          ψ_C (IsLocalization.mk' (Localization.AtPrime p_θ)
            (algebraMap ↥G ↥S_θ (c_fn v)) s_θ) * v.1 := by
        have hmk_val : ∀ g : ↥G,
            ψ_C (IsLocalization.mk' (Localization.AtPrime p_θ)
              (algebraMap ↥G ↥S_θ g) s_θ) =
              algebraMap ↥G ↥R_Z g * s_inv := by
          intro g
          apply hs_unit.mul_right_cancel
          calc
            ψ_C (IsLocalization.mk' (Localization.AtPrime p_θ)
                (algebraMap ↥G ↥S_θ g) s_θ) * s_θ.1.1
                = ψ_C (IsLocalization.mk' (Localization.AtPrime p_θ)
                    (algebraMap ↥G ↥S_θ g) s_θ *
                    algebraMap ↥S_θ (Localization.AtPrime p_θ) s_θ.1) := by
                  rw [map_mul, hψ_C_eq]
            _ = ψ_C (algebraMap ↥S_θ (Localization.AtPrime p_θ)
                  (algebraMap ↥G ↥S_θ g)) := by
                  rw [IsLocalization.mk'_spec]
            _ = algebraMap ↥G ↥R_Z g := hψ_C_eq (algebraMap ↥G ↥S_θ g)
            _ = (algebraMap ↥G ↥R_Z g * s_inv) * s_θ.1.1 := by
                  rw [mul_assoc, mul_comm s_inv, hs_inv, mul_one]
        have hxu_val : (x₀ * u).1 = ∑ v ∈ V_fin, algebraMap ↥G ↥R_Z (c_fn v) * v.1 := by
          have := congrArg (Subtype.val : ↥R₁ → ↥R_Z) hc_sum.symm
          simpa [AddSubmonoidClass.coe_finsetSum, Algebra.smul_def] using this
        calc
          z = z * (s_θ.1.1 * s_inv) := by rw [hs_inv, mul_one]
          _ = (z * s_θ.1.1) * s_inv := by ring
          _ = (∑ v ∈ V_fin, algebraMap ↥G ↥R_Z (c_fn v) * v.1) * s_inv := by rw [hzs, hxu_val]
          _ = ∑ v ∈ V_fin, (algebraMap ↥G ↥R_Z (c_fn v) * s_inv) * v.1 := by
                rw [Finset.sum_mul]
                exact Finset.sum_congr rfl (fun _ _ => by ring)
          _ = ∑ v ∈ V_fin,
                ψ_C (IsLocalization.mk' (Localization.AtPrime p_θ)
                  (algebraMap ↥G ↥S_θ (c_fn v)) s_θ) * v.1 := by
                refine Finset.sum_congr rfl (fun v _ => by rw [hmk_val])
      rw [hz_eq]
      refine Submodule.sum_mem _ (fun v hv => ?_)
      change ψ_C _ • v.1 ∈ _
      exact Submodule.smul_mem _ _
        (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hv)))
    have hMap_mC : Ideal.map ψ_C (IsLocalRing.maximalIdeal (Localization.AtPrime p_θ)) = m_RZ := by
      apply le_antisymm
      · rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_θ (Localization.AtPrime p_θ),
          Ideal.map_map, Ideal.map_le_iff_le_comap]
        intro x hx
        change ψ_C (algebraMap ↥S_θ (Localization.AtPrime p_θ) x) ∈ m_RZ
        rw [hψ_C_eq]
        exact hx
      · dsimp only [m_RZ]
        rw [← hMap_max, Ideal.map_le_iff_le_comap]
        intro g hg
        have hg_pθ : algebraMap ↥G ↥S_θ g ∈ p_θ := hι_GR_max g hg
        have hg_mC : algebraMap ↥S_θ (Localization.AtPrime p_θ) (algebraMap ↥G ↥S_θ g) ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime p_θ) := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_θ (Localization.AtPrime p_θ)]
          exact Ideal.mem_map_of_mem _ hg_pθ
        have heq : algebraMap ↥G ↥R_Z g =
            ψ_C (algebraMap ↥S_θ (Localization.AtPrime p_θ) (algebraMap ↥G ↥S_θ g)) :=
          (hψ_C_eq (algebraMap ↥G ↥S_θ g)).symm
        rw [Ideal.mem_comap, heq]
        exact Ideal.mem_map_of_mem ψ_C hg_mC
    have hπ_C_surj : Function.Surjective (π_res.comp ψ_C) := by
      intro y
      have hy_top : y ∈ Algebra.adjoin κ ({α_bar} : Set κ') := hα_alg_gen.symm ▸ trivial
      have hsub_range : (Algebra.adjoin κ ({α_bar} : Set κ') : Set κ') ⊆
          Set.range (π_res.comp ψ_C) := by
        intro w hw
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hw
        · rintro _ rfl
          refine ⟨algebraMap ↥S_θ (Localization.AtPrime p_θ)
            ⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩, ?_⟩
          change π_res (ψ_C _) = α_bar
          rw [hψ_C_eq]
          exact hπ_θ
        · intro c_k
          obtain ⟨g, rfl⟩ := IsLocalRing.residue_surjective c_k
          refine ⟨algebraMap ↥S_θ (Localization.AtPrime p_θ) (algebraMap ↥G ↥S_θ g), ?_⟩
          change π_res (ψ_C _) = algebraMap ↥G κ' g
          rw [hψ_C_eq]
          rfl
        · rintro w₁ w₂ _ _ ⟨c₁, rfl⟩ ⟨c₂, rfl⟩
          exact ⟨c₁ + c₂, map_add _ _ _⟩
        · rintro w₁ w₂ _ _ ⟨c₁, rfl⟩ ⟨c₂, rfl⟩
          exact ⟨c₁ * c₂, map_mul _ _ _⟩
      exact hsub_range hy_top
    have hSpan1_top : Submodule.span (Localization.AtPrime p_θ) ({1} : Set ↥R_Z) = ⊤ := by
      apply top_unique
      refine @Submodule.le_of_le_smul_of_le_jacobson_bot
        (Localization.AtPrime p_θ) ↥R_Z _ _ _
        (IsLocalRing.maximalIdeal (Localization.AtPrime p_θ))
        (Submodule.span (Localization.AtPrime p_θ) ({1} : Set ↥R_Z))
        ⊤ Module.Finite.fg_top
        (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]) ?_
      intro z _
      obtain ⟨c, hc⟩ := hπ_C_surj (π_res z)
      have hdiff_m : z - ψ_C c ∈
          Ideal.map ψ_C (IsLocalRing.maximalIdeal (Localization.AtPrime p_θ)) := by
        rw [hMap_mC]
        exact (IsLocalRing.residue_eq_zero_iff _).mp (by rw [map_sub, sub_eq_zero]; exact hc.symm)
      have hmap_le_smul : ∀ y ∈ Ideal.map ψ_C (IsLocalRing.maximalIdeal (Localization.AtPrime p_θ)),
          y ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime p_θ) •
            (⊤ : Submodule (Localization.AtPrime p_θ) ↥R_Z)) := by
        intro y hy
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
        · rintro _ ⟨m, hm, rfl⟩
          have hm_eq : ψ_C m = m • (1 : ↥R_Z) := by rw [Algebra.smul_def, mul_one]; rfl
          rw [hm_eq]
          exact Submodule.smul_mem_smul hm Submodule.mem_top
        · exact Submodule.zero_mem _
        · intro y₁ y₂ _ _ hy₁ hy₂
          exact Submodule.add_mem _ hy₁ hy₂
        · intro r y₁ _ hy₁
          change r * y₁ ∈ _
          refine Submodule.smul_induction_on hy₁ ?_ ?_
          · intro m hm w _
            have heq : r * (m • w) = m • (r * w) := by
              change r * (ψ_C m * w) = ψ_C m * (r * w)
              ring
            rw [heq]
            exact Submodule.smul_mem_smul hm Submodule.mem_top
          · intro w₁ w₂ hw₁ hw₂
            rw [mul_add]
            exact Submodule.add_mem _ hw₁ hw₂
      have h_eq_z : z = c • (1 : ↥R_Z) + (z - ψ_C c) := by
        change z = ψ_C c * 1 + (z - ψ_C c)
        ring
      rw [h_eq_z]
      exact Submodule.add_mem_sup
        (Submodule.smul_mem _ c (Submodule.subset_span (Set.mem_singleton _)))
        (hmap_le_smul _ hdiff_m)
    have hψ_C_surj : Function.Surjective ψ_C := by
      intro z
      have hz_mem : z ∈ Submodule.span (Localization.AtPrime p_θ) ({1} : Set ↥R_Z) :=
        hSpan1_top.symm ▸ Submodule.mem_top
      rw [Submodule.mem_span_singleton] at hz_mem
      obtain ⟨c, rfl⟩ := hz_mem
      exact ⟨c, by rw [Algebra.smul_def, mul_one]; rfl⟩
    have hLoc_Sθ : IsLocalization p_θ.primeCompl ↥R_Z := by
      refine { map_units := hSθ_units, surj := ?_, exists_of_eq := ?_ }
      · intro z
        obtain ⟨w, rfl⟩ := hψ_C_surj z
        obtain ⟨⟨x, s⟩, hws⟩ := IsLocalization.surj p_θ.primeCompl w
        refine ⟨⟨x, s⟩, ?_⟩
        have := congrArg ψ_C hws
        rw [map_mul, hψ_C_eq, hψ_C_eq] at this
        exact this
      · intro x₁ x₂ h
        exact ⟨1, by simpa using Subtype.ext h⟩
    have : IsLocalization p_θ.primeCompl ↥R_Z := hLoc_Sθ
    let P_min : Polynomial ↥G := minpoly ↥G θ
    let d_θ : ↥R_Z := Polynomial.aeval θ (Polynomial.derivative P_min)
    have hd_θ_unit : IsUnit d_θ := by
      by_contra hnot_u
      have hd_m : d_θ ∈ m_RZ := by
        by_contra hd_not_m
        exact hnot_u (IsLocalRing.notMem_maximalIdeal.mp hd_not_m)
      have hπ_d : π_res d_θ = 0 := (IsLocalRing.residue_eq_zero_iff d_θ).mpr hd_m
      have hπ_P : π_res (Polynomial.aeval θ P_min) = 0 := by
        rw [minpoly.aeval ↥G θ, map_zero]
      let toD_base : ↥R_Z →+* TrivSqZeroExt κ' κ' := (TrivSqZeroExt.inlHom κ' κ').comp π_res
      let _ : Algebra ↥G (TrivSqZeroExt κ' κ') := (toD_base.comp (algebraMap ↥G ↥R_Z)).toAlgebra
      let eps : TrivSqZeroExt κ' κ' := TrivSqZeroExt.inr (1 : κ')
      have heps_sq : eps ^ 2 = 0 := by
        rw [sq, TrivSqZeroExt.inr_mul_inr]
      let Φ₀ : Polynomial ↥G →ₐ[↥G] TrivSqZeroExt κ' κ' :=
        Polynomial.aeval (TrivSqZeroExt.inl (π_res θ) + eps)
      have hΦ₀_P : Φ₀ P_min = 0 := by
        dsimp only [Φ₀]
        rw [Polynomial.aeval_add_of_sq_eq_zero P_min _ eps heps_sq]
        let baseAlg : ↥R_Z →ₐ[↥G] TrivSqZeroExt κ' κ' :=
          { toRingHom := toD_base, commutes' := fun _ => rfl }
        have hev1 : Polynomial.aeval (TrivSqZeroExt.inl (π_res θ) : TrivSqZeroExt κ' κ') P_min =
            baseAlg (Polynomial.aeval θ P_min) := by
          change Polynomial.aeval (baseAlg θ) P_min = baseAlg (Polynomial.aeval θ P_min)
          exact Polynomial.aeval_algHom_apply baseAlg θ P_min
        have hev2 : Polynomial.aeval (TrivSqZeroExt.inl (π_res θ) : TrivSqZeroExt κ' κ')
            (Polynomial.derivative P_min) = baseAlg d_θ := by
          change Polynomial.aeval (baseAlg θ) (Polynomial.derivative P_min) =
            baseAlg (Polynomial.aeval θ (Polynomial.derivative P_min))
          exact Polynomial.aeval_algHom_apply baseAlg θ (Polynomial.derivative P_min)
        rw [hev1, hev2]
        have hb1 : baseAlg (Polynomial.aeval θ P_min) = 0 := by
          change TrivSqZeroExt.inl (π_res (Polynomial.aeval θ P_min)) = 0
          rw [hπ_P, TrivSqZeroExt.inl_zero]
        have hb2 : baseAlg d_θ = 0 := by
          change TrivSqZeroExt.inl (π_res d_θ) = 0
          rw [hπ_d, TrivSqZeroExt.inl_zero]
        rw [hb1, hb2, zero_mul, add_zero]
      let ev_S : Polynomial ↥G →ₐ[↥G] ↥S_θ :=
        Polynomial.aeval ⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩
      have hev_S_surj : Function.Surjective ev_S := by
        intro x
        have hx : x.1 ∈ (Polynomial.aeval (R := ↥G) θ).range := by
          rw [← Algebra.adjoin_singleton_eq_range_aeval]
          exact x.2
        obtain ⟨p, hp⟩ := hx
        refine ⟨p, Subtype.ext ?_⟩
        change S_θ.val (ev_S p) = x.1
        rw [← Polynomial.aeval_algHom_apply]
        exact hp
      have hker_le : ∀ f ∈ RingHom.ker ev_S, Φ₀ f = 0 := by
        intro f hf
        have hf_θ : Polynomial.aeval θ f = 0 := by
          change Polynomial.aeval (S_θ.val ⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩) f = 0
          rw [Polynomial.aeval_algHom_apply, show ev_S f = 0 from hf, map_zero]
        obtain ⟨q_div, hq_div⟩ := minpoly.isIntegrallyClosed_dvd hθ_int_G hf_θ
        rw [hq_div, map_mul, hΦ₀_P, zero_mul]
      let e_quot := (Ideal.quotientKerAlgEquivOfSurjective hev_S_surj).symm
      let Φ₁_alg : ↥S_θ →ₐ[↥G] TrivSqZeroExt κ' κ' :=
        (Ideal.Quotient.liftₐ (RingHom.ker ev_S) Φ₀ hker_le).comp e_quot.toAlgHom
      have hΦ₁_ev : ∀ p : Polynomial ↥G, Φ₁_alg (ev_S p) = Φ₀ p := by
        intro p
        have heq_q : e_quot (ev_S p) = Ideal.Quotient.mk (RingHom.ker ev_S) p := by
          apply (Ideal.quotientKerAlgEquivOfSurjective hev_S_surj).injective
          change (Ideal.quotientKerAlgEquivOfSurjective hev_S_surj) (e_quot (ev_S p)) = ev_S p
          exact (Ideal.quotientKerAlgEquivOfSurjective hev_S_surj).apply_symm_apply (ev_S p)
        change Ideal.Quotient.liftₐ (RingHom.ker ev_S) Φ₀ hker_le (e_quot (ev_S p)) = Φ₀ p
        rw [heq_q]
        rfl
      have hΦ₁_θ : Φ₁_alg ⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩ =
          TrivSqZeroExt.inl (π_res θ) + eps := by
        have hX : ev_S Polynomial.X = ⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩ :=
          Polynomial.aeval_X _
        rw [← hX, hΦ₁_ev, Polynomial.aeval_X]
      have hΦ₁_fst : ∀ x : ↥S_θ, (Φ₁_alg x).fst = π_res x.1 := by
        intro x
        obtain ⟨p, rfl⟩ := hev_S_surj x
        rw [hΦ₁_ev]
        induction p using Polynomial.induction_on' with
        | add p₁ p₂ hp₁ hp₂ =>
          rw [map_add, map_add, TrivSqZeroExt.fst_add, AddMemClass.coe_add, map_add, hp₁, hp₂]
        | monomial n g =>
          dsimp only [Φ₀, ev_S]
          rw [Polynomial.aeval_monomial, Polynomial.aeval_monomial,
            TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_pow, MulMemClass.coe_mul, map_mul]
          have hfst_g : (algebraMap ↥G (TrivSqZeroExt κ' κ') g).fst =
              π_res (algebraMap ↥G ↥R_Z g) := rfl
          have hfst_θ : (TrivSqZeroExt.inl (π_res θ) + eps).fst = π_res θ := by
            simp [eps]
          have hpow_coe : ((⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩ : ↥S_θ) ^ n).1 = θ ^ n :=
            SubmonoidClass.coe_pow _ n
          rw [hfst_g, hfst_θ, hpow_coe, map_pow]
          rfl
      have hΦ₁_units : ∀ s : p_θ.primeCompl, IsUnit (Φ₁_alg.toRingHom s.1) := by
        intro s
        let u_s : κ' := π_res s.1.1
        have hu_s_ne : u_s ≠ 0 := fun h0 =>
          s.2 ((IsLocalRing.residue_eq_zero_iff s.1.1).mp h0)
        let m_s : κ' := (Φ₁_alg s.1).snd
        have hs_decomp : Φ₁_alg s.1 = TrivSqZeroExt.inl u_s + TrivSqZeroExt.inr m_s := by
          ext
          · simp [u_s, hΦ₁_fst s.1]
          · simp [m_s]
        let v_s : TrivSqZeroExt κ' κ' :=
          TrivSqZeroExt.inl u_s⁻¹ + TrivSqZeroExt.inr (-(u_s⁻¹ * u_s⁻¹ * m_s))
        refine isUnit_iff_exists_inv.mpr ⟨v_s, ?_⟩
        change Φ₁_alg s.1 * v_s = 1
        rw [hs_decomp]
        ext
        · simp [v_s, mul_inv_cancel₀ hu_s_ne]
        · simp only [v_s, TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl,
            TrivSqZeroExt.fst_inr, add_zero, TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl,
            zero_add, TrivSqZeroExt.snd_inr, TrivSqZeroExt.snd_one]
          calc
            u_s * -(u_s⁻¹ * u_s⁻¹ * m_s) + m_s * u_s⁻¹
                = -(u_s * u_s⁻¹) * (u_s⁻¹ * m_s) + m_s * u_s⁻¹ := by ring
            _ = -(1 : κ') * (u_s⁻¹ * m_s) + m_s * u_s⁻¹ := by rw [mul_inv_cancel₀ hu_s_ne]
            _ = 0 := by ring
      let Φ₂_ring : ↥R_Z →+* TrivSqZeroExt κ' κ' :=
        IsLocalization.lift (M := p_θ.primeCompl) hΦ₁_units
      have hΦ₂_eq : ∀ x : ↥S_θ, Φ₂_ring x.1 = Φ₁_alg x :=
        IsLocalization.lift_eq (M := p_θ.primeCompl) hΦ₁_units
      let Φ₂ : ↥R_Z →ₐ[↥G] TrivSqZeroExt κ' κ' :=
        { toRingHom := Φ₂_ring
          commutes' := fun g => by
            change Φ₂_ring (algebraMap ↥G ↥S_θ g).1 = algebraMap ↥G (TrivSqZeroExt κ' κ') g
            rw [hΦ₂_eq]
            exact Φ₁_alg.commutes g }
      let Φ₁_base : ↥R_Z →ₐ[↥G] TrivSqZeroExt κ' κ' :=
        { toRingHom := toD_base, commutes' := fun _ => rfl }
      let fst_ring : TrivSqZeroExt κ' κ' →+* κ' := (TrivSqZeroExt.fstHom κ' κ' κ').toRingHom
      let I_sq : Ideal (TrivSqZeroExt κ' κ') := RingHom.ker fst_ring
      have hI_sq_zero : I_sq ^ 2 = ⊥ := by
        rw [sq, eq_bot_iff, Submodule.mul_le]
        intro x hx y hy
        rw [Ideal.mem_bot]
        have hxf : x.fst = 0 := hx
        have hyf : y.fst = 0 := hy
        ext
        · simp [hxf]
        · simp [hxf, hyf]
      have hfst_agree : fst_ring.comp Φ₂_ring = fst_ring.comp toD_base := by
        apply IsLocalization.ringHom_ext p_θ.primeCompl
        ext x
        change (Φ₂_ring x.1).fst = (toD_base x.1).fst
        rw [hΦ₂_eq, hΦ₁_fst]
        rfl
      have hquot_eq : (Ideal.Quotient.mkₐ ↥G I_sq).comp Φ₂ =
          (Ideal.Quotient.mkₐ ↥G I_sq).comp Φ₁_base := by
        ext z
        apply Ideal.Quotient.eq.mpr
        change (Φ₂_ring z - toD_base z).fst = 0
        rw [TrivSqZeroExt.fst_sub, sub_eq_zero]
        exact RingHom.congr_fun hfst_agree z
      have hΦ_eq : Φ₂ = Φ₁_base :=
        ((Algebra.FormallyUnramified.iff_comp_injective (R := ↥G) (A := ↥R_Z)).mp inferInstance
          I_sq hI_sq_zero) hquot_eq
      have hsnd_eq : (Φ₂ θ).snd = (Φ₁_base θ).snd :=
        congrArg TrivSqZeroExt.snd (AlgHom.congr_fun hΦ_eq θ)
      have hsnd_2 : (Φ₂ θ).snd = 1 := by
        change (Φ₂_ring (⟨θ, Algebra.self_mem_adjoin_singleton ↥G θ⟩ : ↥S_θ).1).snd = 1
        rw [hΦ₂_eq, hΦ₁_θ]
        simp [eps]
      have hsnd_1 : (Φ₁_base θ).snd = 0 := rfl
      exact one_ne_zero (hsnd_2.symm.trans (hsnd_eq.trans hsnd_1))
    have : IsFractionRing ↥G F₀ := inferInstance
    let θ_F : F := θ.1
    have hθ_F_int_G : _root_.IsIntegral ↥G θ_F :=
      hθ_int_G.map (IsScalarTower.toAlgHom ↥G ↥R_Z F)
    have hθ_F_int_F₀ : _root_.IsIntegral F₀ θ_F := hθ_F_int_G.tower_top
    let E_θ : IntermediateField F₀ F := IntermediateField.adjoin F₀ ({θ_F} : Set F)
    have hE_θ_subalg : E_θ.toSubalgebra = Algebra.adjoin F₀ ({θ_F} : Set F) :=
      IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
        (fun x hx => by rw [Set.mem_singleton_iff.mp hx]; exact hθ_F_int_F₀.isAlgebraic)
    have hSθ_in_E : ∀ x : ↥S_θ, (x.1 : F) ∈ E_θ := by
      rintro ⟨x, hx⟩
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
      · rintro _ rfl
        exact IntermediateField.mem_adjoin_simple_self F₀ θ_F
      · intro g
        rw [show ((algebraMap ↥G ↥R_Z g) : F) = algebraMap F₀ F g.1 from hι_val g]
        exact E_θ.algebraMap_mem g.1
      · intro u v _ _ hu hv
        exact E_θ.add_mem hu hv
      · intro u v _ _ hu hv
        exact E_θ.mul_mem hu hv
    have hRZ_in_E : ∀ z : ↥R_Z, z.1 ∈ E_θ := by
      intro z
      obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.surj p_θ.primeCompl z
      have hs_ne : (s.1.1 : F) ≠ 0 := by
        obtain ⟨v, hv⟩ := (hSθ_units s).exists_right_inv
        exact left_ne_zero_of_mul_eq_one (congrArg Subtype.val hv)
      have hz_eq : z.1 = (x.1 : F) * (s.1.1 : F)⁻¹ := by
        have hzs_F : z.1 * (s.1.1 : F) = (x.1 : F) := congrArg Subtype.val hzs
        rw [← hzs_F, mul_inv_cancel_right₀ hs_ne]
      rw [hz_eq]
      exact E_θ.mul_mem (hSθ_in_E x) (E_θ.inv_mem (hSθ_in_E s.1))
    have hE_θ_top : E_θ = ⊤ := by
      rw [eq_top_iff]
      intro f _
      obtain ⟨b, s, hs_ne, hbs⟩ := hFrac f
      have hψs_ne : ψ_BF s ≠ 0 := fun h0 => hs_ne (hInj (h0.trans (map_zero ψ_BF).symm))
      have hf_eq : f = (ψ_BRZ b).1 * ((ψ_BRZ s).1)⁻¹ := by
        rw [hBRZ_val b, hBRZ_val s, ← hbs, mul_comm (ψ_BF s) f, mul_inv_cancel_right₀ hψs_ne]
      rw [hf_eq]
      exact E_θ.mul_mem (hRZ_in_E (ψ_BRZ b)) (E_θ.inv_mem (hRZ_in_E (ψ_BRZ s)))
    have hF₀_θ_top : Algebra.adjoin F₀ ({θ_F} : Set F) = ⊤ := by
      rw [← hE_θ_subalg, hE_θ_top]
      rfl
    have : FiniteDimensional F₀ ↥E_θ := IntermediateField.adjoin.finiteDimensional hθ_F_int_F₀
    have : FiniteDimensional F₀ F :=
      LinearEquiv.finiteDimensional (hE_θ_top ▸ IntermediateField.topEquiv).toLinearEquiv
    have hmin_eq : minpoly ↥G θ_F = P_min :=
      minpoly.algHom_eq (IsScalarTower.toAlgHom ↥G ↥R_Z F) Subtype.val_injective θ
    have hmin_F₀ : minpoly F₀ θ_F = Polynomial.map (algebraMap ↥G F₀) P_min := by
      rw [← hmin_eq]
      exact minpoly.isIntegrallyClosed_eq_field_fractions' F₀ hθ_F_int_G
    let δ₀ : F := Polynomial.aeval θ_F (Polynomial.derivative (minpoly F₀ θ_F))
    have hδ₀_eq : δ₀ = d_θ.1 := by
      dsimp only [δ₀, d_θ]
      rw [hmin_F₀, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap]
      exact (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom ↥G ↥R_Z F) θ
        (Polynomial.derivative P_min))
    have hδ₀_ne : δ₀ ≠ 0 := by
      rw [hδ₀_eq]
      obtain ⟨v, hv⟩ := hd_θ_unit.exists_right_inv
      exact left_ne_zero_of_mul_eq_one (congrArg Subtype.val hv)
    have hderiv_ne : Polynomial.derivative (minpoly F₀ θ_F) ≠ 0 :=
      fun h0 => hδ₀_ne (by dsimp only [δ₀]; rw [h0, map_zero])
    have hsep_θ : IsSeparable F₀ θ_F :=
      (Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hθ_F_int_F₀)).mpr hderiv_ne
    have : Algebra.IsSeparable F₀ ↥E_θ :=
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable (F := F₀) (x := θ_F)).mpr hsep_θ
    have : Algebra.IsSeparable F₀ F :=
      Algebra.IsSeparable.of_algHom F₀ ↥E_θ (hE_θ_top ▸ IntermediateField.topEquiv.symm).toAlgHom
    let A_θ : Subalgebra ↥G F := Algebra.adjoin ↥G ({θ_F} : Set F)
    intro w hw_int_G
    have hw_dual : w ∈ (Algebra.traceForm F₀ F).dualSubmodule (Subalgebra.toSubmodule A_θ) := by
      rw [LinearMap.BilinForm.mem_dualSubmodule]
      intro z hz
      have hz_int : _root_.IsIntegral ↥G z := by
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
        · rintro _ rfl; exact hθ_F_int_G
        · intro g; exact isIntegral_algebraMap
        · intro u₁ u₂ _ _ h₁ h₂; exact h₁.add h₂
        · intro u₁ u₂ _ _ h₁ h₂; exact h₁.mul h₂
      have hwz_int : _root_.IsIntegral ↥G (w * z) := hw_int_G.mul hz_int
      have htr_int : _root_.IsIntegral ↥G (Algebra.trace F₀ F (w * z)) :=
        Algebra.isIntegral_trace hwz_int
      rw [Algebra.traceForm_apply]
      obtain ⟨y_tr, hy_tr⟩ := IsIntegrallyClosed.isIntegral_iff.mp htr_int
      have htr_smul : Algebra.trace F₀ F (w * z) = y_tr • (1 : F₀) := by
        rw [Algebra.smul_def, mul_one]
        exact hy_tr.symm
      rw [htr_smul, Submodule.one_eq_span]
      exact Submodule.smul_mem _ y_tr (Submodule.subset_span (Set.mem_singleton (1 : F₀)))
    rw [traceForm_dualSubmodule_adjoin ↥G F₀ hF₀_θ_top hθ_F_int_G] at hw_dual
    rw [Submodule.mem_smul_pointwise_iff_exists] at hw_dual
    obtain ⟨y_A, hy_A, hy_eq⟩ := hw_dual
    have hy_RZ : y_A ∈ R_Z := by
      have hA_le_RZ : (A_θ : Set F) ⊆ R_Z := by
        intro u hu
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hu
        · rintro _ rfl; exact θ.2
        · intro g
          rw [show algebraMap ↥G F g = (ι_GR g : F) from (hι_val g).symm]
          exact (ι_GR g).2
        · intro u₁ u₂ _ _ h₁ h₂; exact R_Z.add_mem h₁ h₂
        · intro u₁ u₂ _ _ h₁ h₂; exact R_Z.mul_mem h₁ h₂
      exact hA_le_RZ hy_A
    obtain ⟨d_inv, hd_inv⟩ := hd_θ_unit.exists_right_inv
    have hw_eq : w = y_A * d_inv.1 := by
      have h1 : δ₀⁻¹ * y_A = w := hy_eq
      have h2 : d_θ.1 * d_inv.1 = 1 := congrArg Subtype.val hd_inv
      rw [← h1, hδ₀_eq]
      calc
        (d_θ.1)⁻¹ * y_A = ((d_θ.1)⁻¹ * y_A) * (d_θ.1 * d_inv.1) := by rw [h2, mul_one]
        _ = ((d_θ.1)⁻¹ * d_θ.1) * (y_A * d_inv.1) := by ring
        _ = y_A * d_inv.1 := by rw [inv_mul_cancel₀ (hδ₀_eq ▸ hδ₀_ne), one_mul]
    rw [hw_eq]
    exact R_Z.mul_mem hy_RZ d_inv.2

  
  refine ⟨?_, ?_⟩
  · 
    intro B _ _ ψ_BF γ 𝔓 _ hInj hFrac hEt hCompat hComap
    have hIC_polyW₀ : IsIntegrallyClosed (Polynomial ↥W₀) :=
      @instIsIntegrallyClosedPolynomialOfIsDomain ↥W₀ _ _ inferInstance
    
    have h1_not_P : (1 : B) ∉ 𝔓 := fun h1 =>
      (Ideal.IsPrime.ne_top inferInstance) (Ideal.eq_top_of_isUnit_mem 𝔓 h1 isUnit_one)
    let R_Z : Subring F :=
      { carrier := {x : F | ∃ b s : B, s ∉ 𝔓 ∧ ψ_BF s * x = ψ_BF b}
        mul_mem' := by
          rintro x₁ x₂ ⟨b₁, s₁, hs₁, he₁⟩ ⟨b₂, s₂, hs₂, he₂⟩
          refine ⟨b₁ * b₂, s₁ * s₂, Ideal.IsPrime.mul_notMem inferInstance hs₁ hs₂, ?_⟩
          rw [map_mul, map_mul]
          calc
            (ψ_BF s₁ * ψ_BF s₂) * (x₁ * x₂) = (ψ_BF s₁ * x₁) * (ψ_BF s₂ * x₂) := by ring
            _ = ψ_BF b₁ * ψ_BF b₂ := by rw [he₁, he₂]
        one_mem' := ⟨1, 1, h1_not_P, by simp⟩
        add_mem' := by
          rintro x₁ x₂ ⟨b₁, s₁, hs₁, he₁⟩ ⟨b₂, s₂, hs₂, he₂⟩
          refine ⟨s₂ * b₁ + s₁ * b₂, s₁ * s₂, Ideal.IsPrime.mul_notMem inferInstance hs₁ hs₂, ?_⟩
          rw [map_mul, map_add, map_mul, map_mul]
          calc
            (ψ_BF s₁ * ψ_BF s₂) * (x₁ + x₂)
                = ψ_BF s₂ * (ψ_BF s₁ * x₁) + ψ_BF s₁ * (ψ_BF s₂ * x₂) := by ring
            _ = ψ_BF s₂ * ψ_BF b₁ + ψ_BF s₁ * ψ_BF b₂ := by rw [he₁, he₂]
        zero_mem' := ⟨0, 1, h1_not_P, by simp⟩
        neg_mem' := by
          rintro x ⟨b, s, hs, he⟩
          refine ⟨-b, s, hs, ?_⟩
          rw [map_neg, mul_neg, he] }
    have hB_RZ : ∀ b : B, ψ_BF b ∈ R_Z := fun b => ⟨b, 1, h1_not_P, by simp⟩
    have hUnit_RZ : ∀ (u : ↥R_Z) (b s : B),
        s ∉ 𝔓 → ψ_BF s * u.1 = ψ_BF b → (IsUnit u ↔ b ∉ 𝔓) := by
      intro u b s hs hu_eq
      constructor
      · intro hu_unit hb_in
        obtain ⟨v, hv⟩ := hu_unit.exists_right_inv
        obtain ⟨b', s', hs', hv_eq⟩ := v.2
        have huv1 : u.1 * v.1 = 1 := congrArg Subtype.val hv
        have hbb : ψ_BF (b * b') = ψ_BF (s * s') := by
          rw [map_mul, map_mul, ← hu_eq, ← hv_eq]
          calc
            (ψ_BF s * u.1) * (ψ_BF s' * v.1) = (ψ_BF s * ψ_BF s') * (u.1 * v.1) := by ring
            _ = ψ_BF s * ψ_BF s' := by rw [huv1, mul_one]
        have h_eq_B : b * b' = s * s' := hInj hbb
        exact Ideal.IsPrime.mul_notMem inferInstance hs hs'
          (h_eq_B ▸ Ideal.mul_mem_right b' 𝔓 hb_in)
      · intro hb_not
        have hb_ne : b ≠ 0 := fun h0 => hb_not (h0 ▸ 𝔓.zero_mem)
        have hψb_ne : ψ_BF b ≠ 0 := fun h0 => hb_ne (hInj (h0.trans (map_zero ψ_BF).symm))
        let v_val : F := (ψ_BF b)⁻¹ * ψ_BF s
        have hv_mem : v_val ∈ R_Z :=
          ⟨s, b, hb_not, by dsimp only [v_val]; rw [← mul_assoc, mul_inv_cancel₀ hψb_ne, one_mul]⟩
        refine isUnit_iff_exists_inv.mpr ⟨⟨v_val, hv_mem⟩, Subtype.ext ?_⟩
        change u.1 * ((ψ_BF b)⁻¹ * ψ_BF s) = 1
        calc
          u.1 * ((ψ_BF b)⁻¹ * ψ_BF s) = (ψ_BF s * u.1) * (ψ_BF b)⁻¹ := by ring
          _ = ψ_BF b * (ψ_BF b)⁻¹ := by rw [hu_eq]
          _ = 1 := mul_inv_cancel₀ hψb_ne
    have : IsLocalRing ↥R_Z := by
      apply IsLocalRing.of_nonunits_add
      intro u₁ u₂ hu₁ hu₂
      rw [mem_nonunits_iff] at hu₁ hu₂ ⊢
      obtain ⟨b₁, s₁, hs₁, he₁⟩ := u₁.2
      obtain ⟨b₂, s₂, hs₂, he₂⟩ := u₂.2
      have hb₁ : b₁ ∈ 𝔓 := by
        by_contra hb₁_not
        exact hu₁ ((hUnit_RZ u₁ b₁ s₁ hs₁ he₁).mpr hb₁_not)
      have hb₂ : b₂ ∈ 𝔓 := by
        by_contra hb₂_not
        exact hu₂ ((hUnit_RZ u₂ b₂ s₂ hs₂ he₂).mpr hb₂_not)
      have hsum_eq : ψ_BF (s₁ * s₂) * (u₁ + u₂).1 = ψ_BF (s₂ * b₁ + s₁ * b₂) := by
        change ψ_BF (s₁ * s₂) * (u₁.1 + u₂.1) = ψ_BF (s₂ * b₁ + s₁ * b₂)
        rw [map_mul, map_add, map_mul, map_mul]
        calc
          (ψ_BF s₁ * ψ_BF s₂) * (u₁.1 + u₂.1)
              = ψ_BF s₂ * (ψ_BF s₁ * u₁.1) + ψ_BF s₁ * (ψ_BF s₂ * u₂.1) := by ring
          _ = ψ_BF s₂ * ψ_BF b₁ + ψ_BF s₁ * ψ_BF b₂ := by rw [he₁, he₂]
      intro hu_add
      have hnot := (hUnit_RZ (u₁ + u₂) (s₂ * b₁ + s₁ * b₂) (s₁ * s₂)
        (Ideal.IsPrime.mul_notMem inferInstance hs₁ hs₂) hsum_eq).mp hu_add
      exact hnot (Ideal.add_mem 𝔓 (Ideal.mul_mem_left 𝔓 s₂ hb₁) (Ideal.mul_mem_left 𝔓 s₁ hb₂))
    
    let _ : Algebra L F := φ_LF.toAlgebra
    let T_B : F := ψ_BF (γ Polynomial.X)
    have hTB_not_L : ∀ a : L, T_B ≠ φ_LF a := by
      intro a h_eq
      by_cases ha : a ∈ W₀
      · let Q₁ : Polynomial ↥W₀ := Polynomial.X - Polynomial.C ⟨a, ha⟩
        have hγ0 : γ Q₁ = 0 := hInj (by
          rw [map_zero, map_sub, map_sub, hCompat ⟨a, ha⟩]
          exact sub_eq_zero.mpr h_eq)
        have hmem_map : Q₁ ∈ Ideal.map Polynomial.C m₀ := by
          rw [← hComap, Ideal.mem_comap, hγ0]
          exact 𝔓.zero_mem
        have hc1 := Ideal.mem_map_C_iff.mp hmem_map 1
        simp only [Q₁, Polynomial.coeff_sub, Polynomial.coeff_X_one,
          Polynomial.coeff_C_of_ne_zero one_ne_zero, sub_zero] at hc1
        exact h1_not_m₀ hc1
      · have ha0 : a ≠ 0 := fun h0 => ha (h0 ▸ W₀.zero_mem)
        have ha_inv : a⁻¹ ∈ W₀ := (ValuationSubring.mem_or_inv_mem W₀ a).resolve_left ha
        let Q₂ : Polynomial ↥W₀ := 1 - Polynomial.C ⟨a⁻¹, ha_inv⟩ * Polynomial.X
        have hγ0 : γ Q₂ = 0 := hInj (by
          rw [map_zero, map_sub, map_one, map_mul, map_sub, map_one, map_mul,
            hCompat ⟨a⁻¹, ha_inv⟩]
          change 1 - φ_LF a⁻¹ * T_B = 0
          rw [h_eq, ← map_mul, inv_mul_cancel₀ ha0, map_one, sub_self])
        have hmem_map : Q₂ ∈ Ideal.map Polynomial.C m₀ := by
          rw [← hComap, Ideal.mem_comap, hγ0]
          exact 𝔓.zero_mem
        have hc0 := Ideal.mem_map_C_iff.mp hmem_map 0
        simp only [Q₂, Polynomial.coeff_sub, Polynomial.coeff_one_zero, Polynomial.coeff_C_mul,
          Polynomial.coeff_X_zero, mul_zero, sub_zero] at hc0
        exact h1_not_m₀ hc0
    let F₀ : IntermediateField L F := IntermediateField.adjoin L ({T_B} : Set F)
    have hTB_F₀ : T_B ∈ F₀ := IntermediateField.mem_adjoin_simple_self L T_B
    have hAlg_F₀_F : ∀ x : F, ∃ P_x : Polynomial ↥F₀, P_x ≠ 0 ∧ Polynomial.aeval x P_x = 0 := by
      obtain ⟨P_T, Q_T, hQT, hTB_QT⟩ := ht_gen T_B
      have hex_i₀ : ∃ i₀ : ℕ, Q_T.coeff i₀ ≠ 0 := by
        by_contra! hall
        apply hQT
        ext i
        rw [Polynomial.coeff_zero]
        exact hall i
      obtain ⟨i₀, hi₀⟩ := hex_i₀
      let H : Polynomial ↥F₀ :=
        Polynomial.map (algebraMap L ↥F₀) P_T -
          Polynomial.C ⟨T_B, hTB_F₀⟩ * Polynomial.map (algebraMap L ↥F₀) Q_T
      have hH_ne : H ≠ 0 := by
        intro hH0
        have hc0 : (H.coeff i₀ : F) = 0 := by
          rw [hH0, Polynomial.coeff_zero, ZeroMemClass.coe_zero]
        have hc_eq : (H.coeff i₀ : F) = φ_LF (P_T.coeff i₀) - T_B * φ_LF (Q_T.coeff i₀) := by
          change F₀.val (H.coeff i₀) = φ_LF (P_T.coeff i₀) - T_B * φ_LF (Q_T.coeff i₀)
          dsimp only [H]
          rw [Polynomial.coeff_sub, Polynomial.coeff_map, Polynomial.coeff_C_mul,
            Polynomial.coeff_map, map_sub, map_mul]
          rfl
        rw [hc_eq] at hc0
        have hφ_ne : φ_LF (Q_T.coeff i₀) ≠ 0 :=
          (map_ne_zero_iff φ_LF φ_LF.injective).mpr hi₀
        have hTB_eq : T_B = φ_LF (P_T.coeff i₀ * (Q_T.coeff i₀)⁻¹) := by
          rw [map_mul, map_inv₀]
          apply mul_right_cancel₀ hφ_ne
          rw [inv_mul_cancel_right₀ hφ_ne]
          exact (sub_eq_zero.mp hc0).symm
        exact hTB_not_L _ hTB_eq
      have hH_eval : Polynomial.aeval t H = 0 := by
        dsimp only [H]
        rw [map_sub, map_mul, Polynomial.aeval_C]
        have hmap_eval : ∀ R : Polynomial L,
            Polynomial.aeval t (Polynomial.map (algebraMap L ↥F₀) R) =
              Polynomial.eval₂ φ_LF t R := fun R => by
          rw [Polynomial.aeval_def, Polynomial.eval₂_map]
          rfl
        rw [hmap_eval P_T, hmap_eval Q_T]
        change Polynomial.eval₂ φ_LF t P_T - T_B * Polynomial.eval₂ φ_LF t Q_T = 0
        exact sub_eq_zero.mpr hTB_QT.symm
      have ht_int : _root_.IsIntegral ↥F₀ t :=
        isAlgebraic_iff_isIntegral.mp ⟨H, hH_ne, hH_eval⟩
      let F₁ : IntermediateField ↥F₀ F := IntermediateField.adjoin ↥F₀ ({t} : Set F)
      have : FiniteDimensional ↥F₀ ↥F₁ := IntermediateField.adjoin.finiteDimensional ht_int
      have : Algebra.IsAlgebraic ↥F₀ ↥F₁ := Algebra.IsAlgebraic.of_finite ↥F₀ ↥F₁
      intro x
      have hx_F₁ : x ∈ F₁ := by
        obtain ⟨P, Q, hQ, hx_PQ⟩ := ht_gen x
        have heval_F₁ : ∀ R : Polynomial L, Polynomial.eval₂ φ_LF t R ∈ F₁ := by
          intro R
          induction R using Polynomial.induction_on' with
          | add p q hp hq =>
            rw [Polynomial.eval₂_add]
            exact F₁.add_mem hp hq
          | monomial n c =>
            rw [Polynomial.eval₂_monomial]
            exact F₁.toSubring.mul_mem
              (F₁.algebraMap_mem (algebraMap L ↥F₀ c))
              (F₁.toSubring.pow_mem (IntermediateField.mem_adjoin_simple_self ↥F₀ t) n)
        have hQ_ne0 : Polynomial.eval₂ φ_LF t Q ≠ 0 := ht_tr Q hQ
        have hx_eq : x = Polynomial.eval₂ φ_LF t P * (Polynomial.eval₂ φ_LF t Q)⁻¹ := by
          rw [← hx_PQ, mul_inv_cancel_right₀ hQ_ne0]
        rw [hx_eq]
        exact F₁.mul_mem (heval_F₁ P) (F₁.inv_mem (heval_F₁ Q))
      obtain ⟨P_x, hPx_ne, hPx_eval⟩ :=
        Algebra.IsAlgebraic.isAlgebraic (R := ↥F₀) (⟨x, hx_F₁⟩ : ↥F₁)
      refine ⟨P_x, hPx_ne, ?_⟩
      have hval := congrArg (F₁.val : ↥F₁ →ₐ[↥F₀] F) hPx_eval
      rw [map_zero, ← Polynomial.aeval_algHom_apply] at hval
      exact hval
    let p₀ : Ideal (Polynomial ↥W₀) := Ideal.map Polynomial.C m₀
    have hp₀_eq : Ideal.comap γ 𝔓 = p₀ := hComap
    have hp₀_prime : p₀.IsPrime := by
      rw [← hp₀_eq]
      exact Ideal.IsPrime.comap γ
    have h1_not_p₀ : (1 : Polynomial ↥W₀) ∉ p₀ := fun h1 =>
      (Ideal.IsPrime.ne_top hp₀_prime) (Ideal.eq_top_of_isUnit_mem p₀ h1 isUnit_one)
    let ψ_A : Polynomial ↥W₀ →+* F := ψ_BF.comp γ
    have hψ_A_eval : ∀ R₀ : Polynomial ↥W₀,
        ψ_A R₀ = Polynomial.eval₂ (φ_LF.comp W₀.subtype) T_B R₀ := by
      intro R₀
      induction R₀ using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add, Polynomial.eval₂_add, hp, hq]
      | monomial n r =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        change ψ_BF (γ (Polynomial.C r)) * T_B ^ n = φ_LF (W₀.subtype r) * T_B ^ n
        rw [hCompat r]
    have hψ_A_F₀ : ∀ R₀ : Polynomial ↥W₀, ψ_A R₀ ∈ F₀ := by
      intro R₀
      rw [hψ_A_eval R₀]
      induction R₀ using Polynomial.induction_on' with
      | add p q hp hq =>
        rw [Polynomial.eval₂_add]
        exact F₀.add_mem hp hq
      | monomial n r =>
        rw [Polynomial.eval₂_monomial]
        exact F₀.toSubring.mul_mem (F₀.algebraMap_mem r.1) (F₀.toSubring.pow_mem hTB_F₀ n)
    let ψ_A0 : Polynomial ↥W₀ →+* ↥F₀ := ψ_A.codRestrict F₀.toSubring hψ_A_F₀
    let G : ValuationSubring ↥F₀ :=
      { carrier := {z : ↥F₀ | ∃ P Q : Polynomial ↥W₀, Q ∉ p₀ ∧ ψ_A0 Q * z = ψ_A0 P}
        mul_mem' := by
          rintro z₁ z₂ ⟨P₁, Q₁, hQ₁, he₁⟩ ⟨P₂, Q₂, hQ₂, he₂⟩
          refine ⟨P₁ * P₂, Q₁ * Q₂, Ideal.IsPrime.mul_notMem hp₀_prime hQ₁ hQ₂, ?_⟩
          rw [map_mul, map_mul]
          calc
            (ψ_A0 Q₁ * ψ_A0 Q₂) * (z₁ * z₂) = (ψ_A0 Q₁ * z₁) * (ψ_A0 Q₂ * z₂) := by ring
            _ = ψ_A0 P₁ * ψ_A0 P₂ := by rw [he₁, he₂]
        one_mem' := ⟨1, 1, h1_not_p₀, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨P₁, Q₁, hQ₁, he₁⟩ ⟨P₂, Q₂, hQ₂, he₂⟩
          refine ⟨Q₂ * P₁ + Q₁ * P₂, Q₁ * Q₂, Ideal.IsPrime.mul_notMem hp₀_prime hQ₁ hQ₂, ?_⟩
          rw [map_mul, map_add, map_mul, map_mul]
          calc
            (ψ_A0 Q₁ * ψ_A0 Q₂) * (z₁ + z₂)
                = ψ_A0 Q₂ * (ψ_A0 Q₁ * z₁) + ψ_A0 Q₁ * (ψ_A0 Q₂ * z₂) := by ring
            _ = ψ_A0 Q₂ * ψ_A0 P₁ + ψ_A0 Q₁ * ψ_A0 P₂ := by rw [he₁, he₂]
        zero_mem' := ⟨0, 1, h1_not_p₀, by simp⟩
        neg_mem' := by
          rintro z ⟨P, Q, hQ, he⟩
          refine ⟨-P, Q, hQ, ?_⟩
          rw [map_neg, mul_neg, he]
        mem_or_inv_mem' := by
          intro z
          by_cases hz0 : z = 0
          · subst hz0
            exact Or.inl ⟨0, 1, h1_not_p₀, by simp⟩
          · have hz_val_ne : z.1 ≠ 0 := fun h0 => hz0 (Subtype.ext h0)
            obtain ⟨P_L, Q_L, hPQ_div⟩ := (IntermediateField.mem_adjoin_simple_iff L z.1).mp z.2
            have hPL_eval_ne : Polynomial.aeval T_B P_L ≠ 0 := fun h0 =>
              hz_val_ne (by rw [hPQ_div, h0, zero_div])
            have hQL_eval_ne : Polynomial.aeval T_B Q_L ≠ 0 := fun h0 =>
              hz_val_ne (by rw [hPQ_div, h0, div_zero])
            have hPL_ne : P_L ≠ 0 := fun h0 => hPL_eval_ne (by rw [h0, map_zero])
            have hQL_ne : Q_L ≠ 0 := fun h0 => hQL_eval_ne (by rw [h0, map_zero])
            obtain ⟨c_P, P₀, hc_P_ne, ⟨iP, hiP⟩, _, hP₀_eval⟩ := hNormPoly P_L hPL_ne
            obtain ⟨c_Q, Q₀, hc_Q_ne, ⟨iQ, hiQ⟩, _, hQ₀_eval⟩ := hNormPoly Q_L hQL_ne
            have hP₀_not_p₀ : P₀ ∉ p₀ := fun hp => hiP (Ideal.mem_map_C_iff.mp hp iP)
            have hQ₀_not_p₀ : Q₀ ∉ p₀ := fun hq => hiQ (Ideal.mem_map_C_iff.mp hq iQ)
            have hcross : z.1 * (φ_LF c_Q * (ψ_A0 Q₀).1) = φ_LF c_P * (ψ_A0 P₀).1 := by
              have h1 : Polynomial.aeval T_B P_L = φ_LF c_P * (ψ_A0 P₀).1 := by
                rw [Polynomial.aeval_def]
                change Polynomial.eval₂ φ_LF T_B P_L = φ_LF c_P * (ψ_A0 P₀).1
                rw [hP₀_eval T_B, ← hψ_A_eval P₀]
                rfl
              have h2 : Polynomial.aeval T_B Q_L = φ_LF c_Q * (ψ_A0 Q₀).1 := by
                rw [Polynomial.aeval_def]
                change Polynomial.eval₂ φ_LF T_B Q_L = φ_LF c_Q * (ψ_A0 Q₀).1
                rw [hQ₀_eval T_B, ← hψ_A_eval Q₀]
                rfl
              rw [← h1, ← h2]
              exact ((div_eq_iff hQL_eval_ne).mp hPQ_div.symm).symm
            rcases ValuationSubring.mem_or_inv_mem W₀ (c_P * c_Q⁻¹) with hc_in | hc_inv_in
            · left
              let r : ↥W₀ := ⟨c_P * c_Q⁻¹, hc_in⟩
              refine ⟨Polynomial.C r * P₀, Q₀, hQ₀_not_p₀, Subtype.ext ?_⟩
              have hφ_cQ_ne : φ_LF c_Q ≠ 0 :=
                (map_ne_zero_iff φ_LF φ_LF.injective).mpr hc_Q_ne
              apply mul_left_cancel₀ hφ_cQ_ne
              change φ_LF c_Q * ((ψ_A0 Q₀).1 * z.1) = φ_LF c_Q * (ψ_A0 (Polynomial.C r * P₀)).1
              have hr_val : (ψ_A0 (Polynomial.C r * P₀)).1 = φ_LF (c_P * c_Q⁻¹) * (ψ_A0 P₀).1 := by
                change ψ_BF (γ (Polynomial.C r * P₀)) = φ_LF (c_P * c_Q⁻¹) * (ψ_A0 P₀).1
                rw [map_mul, map_mul, hCompat r]
                rfl
              rw [hr_val, map_mul, map_inv₀]
              calc
                φ_LF c_Q * ((ψ_A0 Q₀).1 * z.1) = z.1 * (φ_LF c_Q * (ψ_A0 Q₀).1) := by ring
                _ = φ_LF c_P * (ψ_A0 P₀).1 := hcross
                _ = (φ_LF c_Q * (φ_LF c_Q)⁻¹) * φ_LF c_P * (ψ_A0 P₀).1 := by
                      rw [mul_inv_cancel₀ hφ_cQ_ne, one_mul]
                _ = φ_LF c_Q * (φ_LF c_P * (φ_LF c_Q)⁻¹ * (ψ_A0 P₀).1) := by ring
            · right
              have h_inv_eq : (c_P * c_Q⁻¹)⁻¹ = c_Q * c_P⁻¹ := by
                rw [mul_inv_rev, inv_inv, mul_comm]
              let r' : ↥W₀ := ⟨c_Q * c_P⁻¹, h_inv_eq ▸ hc_inv_in⟩
              refine ⟨Polynomial.C r' * Q₀, P₀, hP₀_not_p₀, Subtype.ext ?_⟩
              have hφ_cP_ne : φ_LF c_P ≠ 0 :=
                (map_ne_zero_iff φ_LF φ_LF.injective).mpr hc_P_ne
              apply mul_left_cancel₀ (mul_ne_zero hz_val_ne hφ_cP_ne)
              change (z.1 * φ_LF c_P) * ((ψ_A0 P₀).1 * (z⁻¹).1) =
                (z.1 * φ_LF c_P) * (ψ_A0 (Polynomial.C r' * Q₀)).1
              have hr'_val : (ψ_A0 (Polynomial.C r' * Q₀)).1 = φ_LF (c_Q * c_P⁻¹) * (ψ_A0 Q₀).1 := by
                change ψ_BF (γ (Polynomial.C r' * Q₀)) = φ_LF (c_Q * c_P⁻¹) * (ψ_A0 Q₀).1
                rw [map_mul, map_mul, hCompat r']
                rfl
              have hz_inv_coe : (z⁻¹).1 = z.1⁻¹ := rfl
              rw [hr'_val, hz_inv_coe, map_mul, map_inv₀]
              calc
                (z.1 * φ_LF c_P) * ((ψ_A0 P₀).1 * z.1⁻¹)
                    = (z.1 * z.1⁻¹) * (φ_LF c_P * (ψ_A0 P₀).1) := by ring
                _ = φ_LF c_P * (ψ_A0 P₀).1 := by rw [mul_inv_cancel₀ hz_val_ne, one_mul]
                _ = z.1 * (φ_LF c_Q * (ψ_A0 Q₀).1) := hcross.symm
                _ = z.1 * ((φ_LF c_P * (φ_LF c_P)⁻¹) * φ_LF c_Q * (ψ_A0 Q₀).1) := by
                      rw [mul_inv_cancel₀ hφ_cP_ne, one_mul]
                _ = (z.1 * φ_LF c_P) * (φ_LF c_Q * (φ_LF c_P)⁻¹ * (ψ_A0 Q₀).1) := by ring }
    have hG_RZ : ∀ g : ↥G, g.1.1 ∈ R_Z := by
      intro g
      obtain ⟨P, Q, hQ_not_p₀, hg_eq⟩ := g.2
      have hγQ_not_P : γ Q ∉ 𝔓 := by
        intro hγQ
        apply hQ_not_p₀
        rw [← hp₀_eq, Ideal.mem_comap]
        exact hγQ
      refine ⟨γ P, γ Q, hγQ_not_P, ?_⟩
      exact congrArg Subtype.val hg_eq
    let ι_GR : ↥G →+* ↥R_Z := ((F₀.val.toRingHom).comp G.subtype).codRestrict R_Z hG_RZ
    have hι_GR_max : ∀ g : ↥G, g ∈ IsLocalRing.maximalIdeal ↥G →
        ι_GR g ∈ IsLocalRing.maximalIdeal ↥R_Z := by
      intro g hg_m
      obtain ⟨P, Q, hQ_not_p₀, hg_eq⟩ := g.2
      have hP_in_p₀ : P ∈ p₀ := by
        by_contra hP_not_p₀
        have hg_ne0 : g.1 ≠ 0 := by
          intro hg0
          rw [hg0, mul_zero] at hg_eq
          have hψP0 : ψ_BF (γ P) = 0 := congrArg Subtype.val hg_eq.symm
          have hγP0 : γ P = 0 := hInj (hψP0.trans (map_zero ψ_BF).symm)
          apply hP_not_p₀
          rw [← hp₀_eq, Ideal.mem_comap, hγP0]
          exact 𝔓.zero_mem
        have hg_inv_G : (g.1)⁻¹ ∈ G := by
          refine ⟨Q, P, hP_not_p₀, ?_⟩
          calc
            ψ_A0 P * (g.1)⁻¹ = (ψ_A0 Q * g.1) * (g.1)⁻¹ := by rw [hg_eq]
            _ = ψ_A0 Q := mul_inv_cancel_right₀ hg_ne0 (ψ_A0 Q)
        have hg_unit : IsUnit g :=
          isUnit_iff_exists_inv.mpr ⟨⟨(g.1)⁻¹, hg_inv_G⟩, Subtype.ext (mul_inv_cancel₀ hg_ne0)⟩
        exact (IsLocalRing.mem_maximalIdeal g).mp hg_m hg_unit
      have hγP_in : γ P ∈ 𝔓 := by
        rw [← hp₀_eq] at hP_in_p₀
        exact hP_in_p₀
      have hγQ_not : γ Q ∉ 𝔓 := by
        intro h
        apply hQ_not_p₀
        rw [← hp₀_eq]
        exact h
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu_GR
      exact ((hUnit_RZ (ι_GR g) (γ P) (γ Q) hγQ_not (congrArg Subtype.val hg_eq)).mp hu_GR) hγP_in
    
    have hψA_inj : Function.Injective ψ_A := by
      intro Q₁ Q₂ h_eq
      by_contra hQ_ne
      let Q_diff : Polynomial ↥W₀ := Q₁ - Q₂
      have hQd_ne : Q_diff ≠ 0 := sub_ne_zero.mpr hQ_ne
      have hQd_eval0 : ψ_A Q_diff = 0 := by rw [map_sub, h_eq, sub_self]
      have hex_i₀ : ∃ i₀ : ℕ, Q_diff.coeff i₀ ≠ 0 := by
        by_contra! hall
        apply hQd_ne
        apply Polynomial.ext
        intro i
        rw [Polynomial.coeff_zero]
        exact hall i
      obtain ⟨i₀, hi₀⟩ := hex_i₀
      let Q_L : Polynomial L := Polynomial.map W₀.subtype Q_diff
      have hQL_ne : Q_L ≠ 0 := by
        intro h0
        have hc0 : Q_L.coeff i₀ = 0 := by rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_map] at hc0
        exact hi₀ (Subtype.ext hc0)
      have hQL_eval : Polynomial.aeval T_B Q_L = 0 := by
        rw [Polynomial.aeval_def]
        change Polynomial.eval₂ φ_LF T_B Q_L = 0
        rw [Polynomial.eval₂_map, ← hψ_A_eval Q_diff, hQd_eval0]
      have hTB_int_L : _root_.IsIntegral L T_B :=
        isAlgebraic_iff_isIntegral.mp ⟨Q_L, hQL_ne, hQL_eval⟩
      have : FiniteDimensional L ↥F₀ := IntermediateField.adjoin.finiteDimensional hTB_int_L
      have : Algebra.IsIntegral L ↥F₀ := Algebra.IsIntegral.of_finite L ↥F₀
      obtain ⟨P_t0, hPt0_ne, hPt0_eval⟩ := hAlg_F₀_F t
      have ht_int_F₀ : _root_.IsIntegral ↥F₀ t :=
        isAlgebraic_iff_isIntegral.mp ⟨P_t0, hPt0_ne, hPt0_eval⟩
      obtain ⟨P_tL, hPtL_monic, hPtL_eval⟩ := isIntegral_trans (R := L) (A := ↥F₀) t ht_int_F₀
      exact ht_tr P_tL hPtL_monic.ne_zero hPtL_eval
    have hψA0_inj : Function.Injective ψ_A0 := fun P₁ P₂ h => hψA_inj (congrArg Subtype.val h)
    let ψ_AG : Polynomial ↥W₀ →+* ↥G :=
      ψ_A0.codRestrict G.toSubring (fun P => ⟨P, 1, h1_not_p₀, by simp⟩)
    have hLocG : @IsLocalization (Polynomial ↥W₀) _ p₀.primeCompl ↥G _ ψ_AG.toAlgebra := by
      let _ : Algebra (Polynomial ↥W₀) ↥G := ψ_AG.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · intro Q
        have hQ_ne : Q.1 ≠ 0 := fun h0 => Q.2 (h0 ▸ p₀.zero_mem)
        have hψQ_ne : ψ_A0 Q.1 ≠ 0 :=
          fun h0 => hQ_ne (hψA0_inj (h0.trans (map_zero ψ_A0).symm))
        have hinv_G : (ψ_A0 Q.1)⁻¹ ∈ G :=
          ⟨1, Q.1, Q.2, by rw [map_one, mul_inv_cancel₀ hψQ_ne]⟩
        exact isUnit_iff_exists_inv.mpr
          ⟨⟨(ψ_A0 Q.1)⁻¹, hinv_G⟩, Subtype.ext (mul_inv_cancel₀ hψQ_ne)⟩
      · intro g
        obtain ⟨P, Q, hQ, hg_eq⟩ := g.2
        refine ⟨⟨P, ⟨Q, hQ⟩⟩, Subtype.ext ?_⟩
        change g.1 * ψ_A0 Q = ψ_A0 P
        rw [mul_comm]
        exact hg_eq
      · intro P₁ P₂ h
        exact ⟨1, by simpa using hψA0_inj (congrArg Subtype.val h)⟩
    let ψ_BRZ : B →+* ↥R_Z := ψ_BF.codRestrict R_Z hB_RZ
    have hLocRZ : @IsLocalization B _ 𝔓.primeCompl ↥R_Z _ ψ_BRZ.toAlgebra := by
      let _ : Algebra B ↥R_Z := ψ_BRZ.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · intro s
        exact (hUnit_RZ (ψ_BRZ s.1) s.1 1 h1_not_P (by rw [map_one, one_mul]; rfl)).mpr s.2
      · intro u
        obtain ⟨b, s, hs, hu_eq⟩ := u.2
        refine ⟨⟨b, ⟨s, hs⟩⟩, Subtype.ext ?_⟩
        change u.1 * ψ_BF s = ψ_BF b
        rw [mul_comm]
        exact hu_eq
      · intro b₁ b₂ h
        exact ⟨1, by simpa using hInj (congrArg Subtype.val h)⟩
    have hComm_GR : ψ_BRZ.comp γ = ι_GR.comp ψ_AG := RingHom.ext (fun _ => Subtype.ext rfl)
    
    obtain ⟨W_Z, hR_WZ, hLoc_RW⟩ := IsLocalRing.exists_factor_valuationRing R_Z.subtype
    let ρ_RW : ↥R_Z →+* ↥W_Z := R_Z.subtype.codRestrict W_Z.toSubring hR_WZ
    have : IsLocalHom ρ_RW := hLoc_RW
    have hWZ_le_RZ : ∀ x : F, x ∈ W_Z → x ∈ R_Z := by
      let _ : Algebra ↥G F := ((F₀.val.toRingHom).comp G.subtype).toAlgebra
      have : IsScalarTower ↥G F F := IsScalarTower.right
      intro x hx_WZ
      obtain ⟨P_x, hPx_ne, hPx_eval⟩ := hAlg_F₀_F x
      let n : ℕ := P_x.natDegree
      have hn_pos : 0 < n := by
        by_contra hn0
        have hn_eq0 : n = 0 := Nat.eq_zero_of_not_pos hn0
        have hPx_C : P_x = Polynomial.C (P_x.coeff 0) :=
          Polynomial.eq_C_of_natDegree_eq_zero hn_eq0
        have hc0_ne : P_x.coeff 0 ≠ 0 := fun h0 =>
          hPx_ne (by rw [hPx_C, h0, map_zero])
        rw [hPx_C, Polynomial.aeval_C] at hPx_eval
        exact hc0_ne (Subtype.ext hPx_eval)
      let I_deg : Finset ℕ := Finset.range (n + 1)
      have hn_mem : n ∈ I_deg := Finset.mem_range.mpr (Nat.lt_succ_self n)
      obtain ⟨j₀, hj₀_mem, hj₀_max⟩ :=
        Finset.exists_max_image I_deg (fun j => G.valuation (P_x.coeff j)) ⟨n, hn_mem⟩
      let v_max := G.valuation (P_x.coeff j₀)
      have hvn_ne : G.valuation (P_x.coeff n) ≠ 0 :=
        (Valuation.ne_zero_iff G.valuation).mpr (Polynomial.leadingCoeff_ne_zero.mpr hPx_ne)
      have hv_max_ne : v_max ≠ 0 := fun h0 =>
        hvn_ne (le_antisymm (h0 ▸ hj₀_max n hn_mem) zero_le)
      let M_set : Finset ℕ := I_deg.filter (fun j => G.valuation (P_x.coeff j) = v_max)
      have hM_ne : M_set.Nonempty := ⟨j₀, Finset.mem_filter.mpr ⟨hj₀_mem, rfl⟩⟩
      let m : ℕ := M_set.max' hM_ne
      have hm_mem : m ∈ M_set := Finset.max'_mem M_set hM_ne
      have hm_le_n : m ≤ n :=
        Nat.lt_succ_iff.mp (Finset.mem_range.mp (Finset.mem_filter.mp hm_mem).1)
      have hvm_eq : G.valuation (P_x.coeff m) = v_max := (Finset.mem_filter.mp hm_mem).2
      have hcm_ne : P_x.coeff m ≠ 0 :=
        (Valuation.ne_zero_iff G.valuation).mp (hvm_eq ▸ hv_max_ne)
      have ha_mem : ∀ j : ℕ, j ≤ n → P_x.coeff j * (P_x.coeff m)⁻¹ ∈ G := by
        intro j hj
        rw [← ValuationSubring.valuation_le_one_iff, map_mul, map_inv₀, hvm_eq]
        calc
          G.valuation (P_x.coeff j) * v_max⁻¹
              ≤ v_max * v_max⁻¹ :=
                mul_le_mul_of_nonneg_right
                  (hj₀_max j (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))) zero_le
          _ = 1 := mul_inv_cancel₀ hv_max_ne
      let a_coeff : ℕ → ↥G := fun j =>
        if hj : j ≤ n then ⟨P_x.coeff j * (P_x.coeff m)⁻¹, ha_mem j hj⟩ else 0
      have ha_m : a_coeff m = 1 := by
        dsimp only [a_coeff]
        simp only [hm_le_n, ↓reduceDIte]
        exact Subtype.ext (mul_inv_cancel₀ hcm_ne)
      have ha_gt_m : ∀ j : ℕ, m < j → j ≤ n → a_coeff j ∈ IsLocalRing.maximalIdeal ↥G := by
        intro j hmj hjn
        rw [ValuationSubring.valuation_lt_one_iff]
        dsimp only [a_coeff]
        simp only [hjn, ↓reduceDIte]
        rw [map_mul, map_inv₀, hvm_eq]
        have hj_not_M : j ∉ M_set := fun hjM =>
          not_le_of_gt hmj (Finset.le_max' M_set j hjM)
        have hj_in_I : j ∈ I_deg := Finset.mem_range.mpr (Nat.lt_succ_of_le hjn)
        have hv_ne : G.valuation (P_x.coeff j) ≠ v_max := fun heq =>
          hj_not_M (Finset.mem_filter.mpr ⟨hj_in_I, heq⟩)
        have hv_lt : G.valuation (P_x.coeff j) < v_max :=
          lt_of_le_of_ne (hj₀_max j hj_in_I) hv_ne
        have hv_pos : 0 < v_max⁻¹ := inv_pos.mpr (pos_iff_ne_zero.mpr hv_max_ne)
        calc
          G.valuation (P_x.coeff j) * v_max⁻¹ < v_max * v_max⁻¹ :=
            mul_lt_mul_of_pos_right hv_lt hv_pos
          _ = 1 := mul_inv_cancel₀ hv_max_ne
      have hSum_a : (∑ j ∈ Finset.range (n + 1), algebraMap ↥G F (a_coeff j) * x ^ j) = 0 := by
        have hcm_F_ne : (P_x.coeff m : F) ≠ 0 := fun h0 => hcm_ne (Subtype.ext h0)
        apply mul_left_cancel₀ hcm_F_ne
        rw [mul_zero, Finset.mul_sum]
        have hcongr : (∑ j ∈ Finset.range (n + 1),
            (P_x.coeff m : F) * (algebraMap ↥G F (a_coeff j) * x ^ j)) =
            ∑ j ∈ Finset.range (n + 1), (P_x.coeff j) • x ^ j := by
          refine Finset.sum_congr rfl (fun j hj => ?_)
          have hjn : j ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
          dsimp only [a_coeff]
          simp only [hjn, ↓reduceDIte]
          change (P_x.coeff m : F) * (((P_x.coeff j : F) * (P_x.coeff m : F)⁻¹) * x ^ j) =
            (P_x.coeff j : F) * x ^ j
          calc
            (P_x.coeff m : F) * (((P_x.coeff j : F) * (P_x.coeff m : F)⁻¹) * x ^ j)
                = ((P_x.coeff m : F) * (P_x.coeff m : F)⁻¹) * (P_x.coeff j : F) * x ^ j := by
                  ring
            _ = (P_x.coeff j : F) * x ^ j := by rw [mul_inv_cancel₀ hcm_F_ne, one_mul]
        rw [hcongr, ← Polynomial.aeval_eq_sum_range]
        exact hPx_eval
      let y : F := ∑ t_idx ∈ Finset.range (n - m + 1),
        algebraMap ↥G F (a_coeff (m + t_idx)) * x ^ t_idx
      have hy_split : y =
          (∑ s ∈ Finset.range (n - m),
            algebraMap ↥G F (a_coeff (m + (s + 1))) * x ^ (s + 1)) + 1 := by
        dsimp only [y]
        rw [Finset.sum_range_succ', Nat.add_zero, pow_zero, ha_m, map_one, one_mul]
      have hy_WZ_and_not_m : ∃ hy_WZ : y ∈ W_Z,
          (⟨y, hy_WZ⟩ : ↥W_Z) ∉ IsLocalRing.maximalIdeal ↥W_Z := by
        have hterm_WZ : ∀ s : ℕ,
            algebraMap ↥G F (a_coeff (m + (s + 1))) * x ^ (s + 1) ∈ W_Z := fun s =>
          W_Z.toSubring.mul_mem
            (ρ_RW (ι_GR (a_coeff (m + (s + 1))))).2
            (W_Z.toSubring.pow_mem hx_WZ (s + 1))
        have hterm_m : ∀ s ∈ Finset.range (n - m),
            (⟨algebraMap ↥G F (a_coeff (m + (s + 1))) * x ^ (s + 1), hterm_WZ s⟩ : ↥W_Z) ∈
              IsLocalRing.maximalIdeal ↥W_Z := by
          intro s hs
          have hs_lt : s < n - m := Finset.mem_range.mp hs
          have hgt : m < m + (s + 1) := by omega
          have hle : m + (s + 1) ≤ n := by omega
          have ha_mG := ha_gt_m (m + (s + 1)) hgt hle
          have ha_mRZ := hι_GR_max (a_coeff (m + (s + 1))) ha_mG
          have ha_mWZ : ρ_RW (ι_GR (a_coeff (m + (s + 1)))) ∈ IsLocalRing.maximalIdeal ↥W_Z := by
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha_mRZ ⊢
            intro hu_W
            exact ha_mRZ (isUnit_of_map_unit ρ_RW _ hu_W)
          have heq : (⟨algebraMap ↥G F (a_coeff (m + (s + 1))) * x ^ (s + 1), hterm_WZ s⟩ : ↥W_Z) =
              ρ_RW (ι_GR (a_coeff (m + (s + 1)))) * (⟨x, hx_WZ⟩ : ↥W_Z) ^ (s + 1) :=
            Subtype.ext rfl
          rw [heq]
          exact Ideal.mul_mem_right _ _ ha_mWZ
        have hsum_WZ : (∑ s ∈ Finset.range (n - m),
            algebraMap ↥G F (a_coeff (m + (s + 1))) * x ^ (s + 1)) ∈ W_Z :=
          W_Z.toSubring.sum_mem (fun s _ => hterm_WZ s)
        have hy_WZ : y ∈ W_Z := by
          rw [hy_split]
          exact W_Z.toSubring.add_mem hsum_WZ W_Z.toSubring.one_mem
        refine ⟨hy_WZ, fun hy_m => ?_⟩
        have hsum_mWZ : (⟨_, hsum_WZ⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z := by
          have heq_sum : (⟨_, hsum_WZ⟩ : ↥W_Z) =
              ∑ s ∈ Finset.range (n - m),
                (⟨algebraMap ↥G F (a_coeff (m + (s + 1))) * x ^ (s + 1), hterm_WZ s⟩ : ↥W_Z) := by
            apply Subtype.ext
            simp only [AddSubmonoidClass.coe_finsetSum]
          rw [heq_sum]
          exact Ideal.sum_mem _ hterm_m
        have h1_mWZ : (1 : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z := by
          have hsub := Ideal.sub_mem (IsLocalRing.maximalIdeal ↥W_Z) hy_m hsum_mWZ
          have heq1 : (⟨y, hy_WZ⟩ : ↥W_Z) - ⟨_, hsum_WZ⟩ = 1 := by
            apply Subtype.ext
            change y - _ = 1
            rw [hy_split, add_sub_cancel_left]
          rwa [heq1] at hsub
        exact (IsLocalRing.maximalIdeal.isMaximal ↥W_Z).ne_top
          (Ideal.eq_top_of_isUnit_mem _ h1_mWZ isUnit_one)
      obtain ⟨hy_WZ, hy_not_mWZ⟩ := hy_WZ_and_not_m
      have hy_xm : y * x ^ m =
          - ∑ i ∈ Finset.range m, algebraMap ↥G F (a_coeff i) * x ^ i := by
        have hsplit_n : n + 1 = m + (n - m + 1) := by omega
        rw [hsplit_n, Finset.sum_range_add] at hSum_a
        have hsecond : (∑ t_idx ∈ Finset.range (n - m + 1),
            algebraMap ↥G F (a_coeff (m + t_idx)) * x ^ (m + t_idx)) = y * x ^ m := by
          dsimp only [y]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl (fun t_idx _ => ?_)
          rw [pow_add]
          ring
        rw [hsecond] at hSum_a
        exact eq_neg_of_add_eq_zero_right hSum_a
      have hm_pos : 1 ≤ m := by
        by_contra hm0
        have hm_eq0 : m = 0 := Nat.eq_zero_of_not_pos hm0
        have hy0 : y = 0 := by
          have := hy_xm
          rw [hm_eq0, pow_zero, mul_one, Finset.range_zero, Finset.sum_empty, neg_zero] at this
          exact this
        have hy_zero_sub : (⟨y, hy_WZ⟩ : ↥W_Z) = 0 := Subtype.ext hy0
        exact hy_not_mWZ (hy_zero_sub ▸ Ideal.zero_mem _)
      let S_gen : Finset F := (Finset.range n).image (fun k => x ^ k)
      let N : Submodule ↥G F := Submodule.span ↥G (↑S_gen : Set F)
      have hN_fg : N.FG := Submodule.fg_span (Finset.finite_toSet S_gen)
      have hpow_N : ∀ e : ℕ, e < n → x ^ e ∈ N := fun e he =>
        Submodule.subset_span
          (Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨e, Finset.mem_range.mpr he, rfl⟩))
      have hN_ne_bot : N ≠ ⊥ := by
        rw [Submodule.ne_bot_iff]
        exact ⟨1, pow_zero x ▸ hpow_N 0 hn_pos, one_ne_zero⟩
      have hy_xpow_N : ∀ k : ℕ, k ≤ n → y * x ^ k ∈ N := by
        intro k hkn
        by_cases hkm : k < m
        · dsimp only [y]
          rw [Finset.sum_mul]
          refine N.sum_mem (fun t_idx ht => ?_)
          have ht_lt : t_idx < n - m + 1 := Finset.mem_range.mp ht
          have hexp_lt : t_idx + k < n := by omega
          have heq : algebraMap ↥G F (a_coeff (m + t_idx)) * x ^ t_idx * x ^ k =
              (a_coeff (m + t_idx)) • x ^ (t_idx + k) := by
            rw [Algebra.smul_def, pow_add, mul_assoc]
          rw [heq]
          exact N.smul_mem _ (hpow_N (t_idx + k) hexp_lt)
        · have hmk : m ≤ k := le_of_not_gt hkm
          have hk_split : k = m + (k - m) := (Nat.add_sub_of_le hmk).symm
          have hx_pow : y * x ^ k = (y * x ^ m) * x ^ (k - m) := by
            conv_lhs => rw [hk_split, pow_add, ← mul_assoc]
          rw [hx_pow, hy_xm, neg_mul, Finset.sum_mul]
          refine N.neg_mem (N.sum_mem (fun i hi => ?_))
          have hi_lt : i < m := Finset.mem_range.mp hi
          have hexp_lt : i + (k - m) < n := by omega
          have heq : algebraMap ↥G F (a_coeff i) * x ^ i * x ^ (k - m) =
              (a_coeff i) • x ^ (i + (k - m)) := by
            rw [Algebra.smul_def, pow_add, mul_assoc]
          rw [heq]
          exact N.smul_mem _ (hpow_N (i + (k - m)) hexp_lt)
      have hStab : ∀ w : F, (∀ k : ℕ, k < n → w * x ^ k ∈ N) → ∀ z ∈ N, w • z ∈ N := by
        intro w hw z hz
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
        · intro u hu
          obtain ⟨k, hk_range, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hu)
          change w * x ^ k ∈ N
          exact hw k (Finset.mem_range.mp hk_range)
        · simp only [smul_zero, N.zero_mem]
        · intro u₁ u₂ _ _ hu₁ hu₂
          rw [smul_add]
          exact N.add_mem hu₁ hu₂
        · intro g u _ hu
          change w * (algebraMap ↥G F g * u) ∈ N
          have heq : w * (algebraMap ↥G F g * u) = g • (w • u) := by
            change w * (algebraMap ↥G F g * u) = algebraMap ↥G F g * (w * u)
            ring
          rw [heq]
          exact N.smul_mem g hu
      have hy_int_G : _root_.IsIntegral ↥G y :=
        isIntegral_of_smul_mem_submodule N hN_ne_bot hN_fg y
          (hStab y (fun k hk => hy_xpow_N k (le_of_lt hk)))
      have hyx_int_G : _root_.IsIntegral ↥G (y * x) :=
        isIntegral_of_smul_mem_submodule N hN_ne_bot hN_fg (y * x)
          (hStab (y * x) (fun k hk => by
            have heq : (y * x) * x ^ k = y * x ^ (k + 1) := by rw [mul_assoc, ← pow_succ']
            rw [heq]
            exact hy_xpow_N (k + 1) hk))
      have hG_to_RZ : ∀ z : F, _root_.IsIntegral ↥G z → z ∈ R_Z :=
        @hEtaleStalkIntegral (Polynomial ↥W₀) B _ _ hIC_polyW₀ _ _
          ↥F₀ F _ _ _ G R_Z _ γ hEt ψ_BF hInj hFrac 𝔓 _ p₀ hp₀_prime
          ψ_AG ψ_BRZ ι_GR (fun _ => rfl) (fun _ => rfl) hComm_GR hLocG hLocRZ hι_GR_max
      have hy_RZ : y ∈ R_Z := hG_to_RZ y hy_int_G
      have hyx_RZ : y * x ∈ R_Z := hG_to_RZ (y * x) hyx_int_G
      have hu_y_WZ : IsUnit (ρ_RW ⟨y, hy_RZ⟩) :=
        IsLocalRing.notMem_maximalIdeal.mp hy_not_mWZ
      have hu_y_RZ : IsUnit (⟨y, hy_RZ⟩ : ↥R_Z) :=
        isUnit_of_map_unit ρ_RW ⟨y, hy_RZ⟩ hu_y_WZ
      obtain ⟨y_inv_RZ, hy_inv_RZ⟩ := hu_y_RZ.exists_right_inv
      have hy_mul1 : y * y_inv_RZ.1 = 1 := congrArg Subtype.val hy_inv_RZ
      have hx_eq : x = (y * x) * y_inv_RZ.1 := by
        calc
          x = x * (y * y_inv_RZ.1) := by rw [hy_mul1, mul_one]
          _ = (y * x) * y_inv_RZ.1 := by ring
      rw [hx_eq]
      exact R_Z.mul_mem hyx_RZ y_inv_RZ.2
    have hWZ_iff_RZ : ∀ x : F, x ∈ W_Z ↔ x ∈ R_Z :=
      fun x => ⟨hWZ_le_RZ x, fun hx => hR_WZ ⟨x, hx⟩⟩
    have hB_WZ : ∀ b : B, ψ_BF b ∈ W_Z := fun b => (hWZ_iff_RZ (ψ_BF b)).mpr (hB_RZ b)
    have hLoc_WZ : ∀ x : F, x ∈ W_Z ↔ ∃ (b s : B), s ∉ 𝔓 ∧ ψ_BF s * x = ψ_BF b :=
      hWZ_iff_RZ
    have hPrime_WZ : ∀ b : B,
        (⟨ψ_BF b, hB_WZ b⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z ↔ b ∈ 𝔓 := by
      intro b
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      have hunit_iff : IsUnit (⟨ψ_BF b, hB_WZ b⟩ : ↥W_Z) ↔
          IsUnit (⟨ψ_BF b, hB_RZ b⟩ : ↥R_Z) := by
        constructor
        · intro hu_W
          exact isUnit_of_map_unit ρ_RW ⟨ψ_BF b, hB_RZ b⟩ hu_W
        · intro hu_R
          exact hu_R.map ρ_RW
      rw [hunit_iff, hUnit_RZ ⟨ψ_BF b, hB_RZ b⟩ b 1 h1_not_P (by simp), not_not]
    
    have hW₀_WZ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W_Z :=
      fun r => hCompat r ▸ hB_WZ (γ (Polynomial.C r))
    have hMaxCompat_WZ : ∀ r : ↥W₀,
        (⟨φ_LF (W₀.subtype r), hW₀_WZ r⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z ↔ r ∈ m₀ := by
      intro r
      have heq_sub : (⟨φ_LF (W₀.subtype r), hW₀_WZ r⟩ : ↥W_Z) =
          ⟨ψ_BF (γ (Polynomial.C r)), hB_WZ (γ (Polynomial.C r))⟩ :=
        Subtype.ext (hCompat r).symm
      rw [heq_sub, hPrime_WZ (γ (Polynomial.C r)), ← Ideal.mem_comap, hComap, Ideal.mem_map_C_iff]
      constructor
      · intro hall
        have h0 := hall 0
        rwa [Polynomial.coeff_C_zero] at h0
      · intro hr n
        by_cases hn0 : n = 0
        · subst hn0
          rwa [Polynomial.coeff_C_zero]
        · rw [Polynomial.coeff_C_of_ne_zero hn0]
          exact m₀.zero_mem
    have hTB_WZ : T_B ∈ W_Z := hB_WZ (γ Polynomial.X)
    have hNotRes_TB : ∀ c₀ : ↥W₀,
        (⟨T_B, hTB_WZ⟩ : ↥W_Z) - ⟨φ_LF (W₀.subtype c₀), hW₀_WZ c₀⟩ ∉
          IsLocalRing.maximalIdeal ↥W_Z := by
      intro c₀ hmem
      have heq_sub : (⟨T_B, hTB_WZ⟩ : ↥W_Z) - ⟨φ_LF (W₀.subtype c₀), hW₀_WZ c₀⟩ =
          ⟨ψ_BF (γ (Polynomial.X - Polynomial.C c₀)), hB_WZ _⟩ := by
        apply Subtype.ext
        change T_B - φ_LF (W₀.subtype c₀) = ψ_BF (γ (Polynomial.X - Polynomial.C c₀))
        rw [map_sub, map_sub, hCompat c₀]
      rw [heq_sub, hPrime_WZ, ← Ideal.mem_comap, hComap, Ideal.mem_map_C_iff] at hmem
      have hc1 := hmem 1
      simp only [Polynomial.coeff_sub, Polynomial.coeff_X_one,
        Polynomial.coeff_C_of_ne_zero one_ne_zero, sub_zero] at hc1
      exact h1_not_m₀ hc1
    obtain ⟨α_Z, π_Z, hu_Z, hπ_Z, hNotRes_u⟩ :=
      hLinearParam W_Z hW₀_WZ hMaxCompat_WZ T_B hTB_WZ hNotRes_TB
    obtain ⟨hGauss_Z, _⟩ :=
      hGaussValPkg α_Z π_Z hπ_Z W_Z hW₀_WZ hu_Z hMaxCompat_WZ hNotRes_u
    exact ⟨W_Z, hB_WZ, α_Z, π_Z, hGauss_Z, hLoc_WZ, hPrime_WZ⟩
  · 
    intro W_Z W' hW₀_W' α_Z π_Z hGauss_Z hMaxCompat' hNe
    obtain ⟨hπ_Z, _, hW₀_Z, hu_Z, _, hMaxCompat_Z, hGaussQ_Z, _⟩ := hGauss_Z
    have hNotRes_Z : ∀ c₀ : ↥W₀,
        (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu_Z⟩ : ↥W_Z) -
          ⟨φ_LF (W₀.subtype c₀), hW₀_Z c₀⟩ ∉ IsLocalRing.maximalIdeal ↥W_Z := by
      intro c₀
      have hQ_prim : ∃ i : ℕ, (Polynomial.X - Polynomial.C c₀ : Polynomial ↥W₀).coeff i ∉ m₀ := by
        refine ⟨1, ?_⟩
        simp only [Polynomial.coeff_sub, Polynomial.coeff_X_one,
          Polynomial.coeff_C_of_ne_zero one_ne_zero, sub_zero]
        exact h1_not_m₀
      have hnot := hGaussQ_Z (Polynomial.X - Polynomial.C c₀) hQ_prim
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at hnot
      exact hnot
    by_cases hu_W' : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W'
    · refine Or.inr ⟨hu_W', ?_⟩
      by_contra! hNotRes'
      have hEq := (hGaussValPkg α_Z π_Z hπ_Z W_Z hW₀_Z hu_Z hMaxCompat_Z hNotRes_Z).2
        W' hW₀_W' hu_W' hMaxCompat' hNotRes'
      exact hNe hEq
    · exact Or.inl hu_W'

theorem weil_strictlySemistable_closed_fiber_components_and_double_branch (L : Type u) [Field L]
    (W₀ : ValuationSubring L)
    (hMax : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1 : ∀ P : PrimeSpectrum ↥W₀,
      P.asIdeal = ⊥ ∨ P.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (hAlgK₀ : IsAlgClosed (IsLocalRing.maximalIdeal ↥W₀).ResidueField)
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀))
    (hSS_ℰ : IsStrictlySemistableCurveOverValuation W₀ g_ℰ)
    (hProp_ℰ : AlgebraicGeometry.IsProper g_ℰ)
    (F : Type u) [Field F]
    (η_ℰ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ ℰ)
    (hFunc_ℰ : IsSchemeFunctionField ℰ F η_ℰ)
    (φ_LF : L →+* F)
    (hη_g : η_ℰ ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_LF.comp W₀.subtype))) :
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
    (irreducibleComponents ↥T₀).Nonempty ∧
    (irreducibleComponents ↥T₀).Finite ∧
    (∀ (q : ↥T₀) (Z₁ Z₂ Z₃ : Set ↥T₀),
      Z₁ ∈ irreducibleComponents ↥T₀ →
      Z₂ ∈ irreducibleComponents ↥T₀ →
      Z₃ ∈ irreducibleComponents ↥T₀ →
      q ∈ Z₁ → q ∈ Z₂ → q ∈ Z₃ →
      Z₁ = Z₂ ∨ Z₁ = Z₃ ∨ Z₂ = Z₃) ∧
    (∀ Z ∈ irreducibleComponents ↥T₀,
      ∃ (Z_sch : AlgebraicGeometry.Scheme.{u})
        (ιZ : Z_sch ⟶ T₀)
        (K_Z : Type u) (_ : Field K_Z)
        (η_Z : AlgebraicGeometry.Spec (CommRingCat.of K_Z) ⟶ Z_sch)
        (pt_Z : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_Z)))
        (U_Z : ℰ.Opens) (hUZ : AlgebraicGeometry.IsAffineOpen U_Z)
        (hη_mem : (CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
          (ιZ.base (η_Z.base pt_Z)) ∈ U_Z)
        (φ_UZ : CommRingCat.of ↑(ℰ.presheaf.obj (Opposite.op U_Z)) ⟶ CommRingCat.of F)
        (γ : Polynomial ↥W₀ →+* ↑(ℰ.presheaf.obj (Opposite.op U_Z)))
        (e_res : (hUZ.primeIdealOf
          ⟨(CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
            (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal.ResidueField ≃+* K_Z),
        AlgebraicGeometry.IsClosedImmersion ιZ ∧
        AlgebraicGeometry.IsIntegral Z_sch ∧
        Set.range ιZ.base = Z ∧
        AlgebraicGeometry.IsDominant η_Z ∧
        IsSchemeFunctionField Z_sch K_Z η_Z ∧
        AlgebraicGeometry.Spec.map φ_UZ ≫ hUZ.fromSpec = η_ℰ ∧
        Function.Injective φ_UZ.hom ∧
        (∀ x : F, ∃ b s : ↑(ℰ.presheaf.obj (Opposite.op U_Z)),
          s ≠ 0 ∧ φ_UZ.hom s * x = φ_UZ.hom b) ∧
        RingHom.Etale γ ∧
        (∀ r : ↥W₀, φ_UZ.hom (γ (Polynomial.C r)) = φ_LF (W₀.subtype r)) ∧
        Ideal.comap γ (hUZ.primeIdealOf
          ⟨(CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
            (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal =
          Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W₀) ∧
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (e_res.toRingHom.comp
              (algebraMap ↑(ℰ.presheaf.obj (Opposite.op U_Z)) (hUZ.primeIdealOf
                ⟨(CategoryTheory.Limits.pullback.fst g_ℰ s₀).base
                  (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal.ResidueField))) ≫
          hUZ.fromSpec =
          η_Z ≫ ιZ ≫ CategoryTheory.Limits.pullback.fst g_ℰ s₀) :=
by
  
  have h_s1 :
      (∀ (k₀ : Type u) [Field k₀] (B₀ : Type u) [CommRing B₀]
         (ψ₀ : Polynomial k₀ →+* B₀),
         RingHom.Etale ψ₀ →
         ∀ (q : Ideal B₀) [q.IsPrime] (p₁ p₂ : Ideal B₀),
           p₁ ∈ minimalPrimes B₀ → p₂ ∈ minimalPrimes B₀ →
           p₁ ≤ q → p₂ ≤ q → p₁ = p₂) ∧
      (∀ (k₀ : Type u) [Field k₀] (a_bar : k₀) (B₀ : Type u) [CommRing B₀]
         (ψ_mod : (MvPolynomial (Fin 2) k₀ ⧸
           Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_bar}) →+* B₀),
         RingHom.Etale ψ_mod →
         (∀ (q : Ideal B₀) [q.IsPrime] (p₁ p₂ p₃ : Ideal B₀),
           p₁ ∈ minimalPrimes B₀ → p₂ ∈ minimalPrimes B₀ → p₃ ∈ minimalPrimes B₀ →
           p₁ ≤ q → p₂ ≤ q → p₃ ≤ q →
           p₁ = p₂ ∨ p₁ = p₃ ∨ p₂ = p₃) ∧
         (∀ q₀ : Ideal B₀, q₀ ∈ minimalPrimes B₀ →
           ∃ i : Fin 2,
             ψ_mod (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∉ q₀)) ∧
      (∀ (R A₀ B_Z : Type u) [CommRing R] [CommRing A₀] [CommRing B_Z]
         (a : R)
         (φ₀ : (MvPolynomial (Fin 2) R ⧸
           Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* A₀)
         (i : Fin 2) [Algebra A₀ B_Z],
         RingHom.Etale φ₀ →
         IsLocalization.Away (φ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i))) B_Z →
         RingHom.Etale (Polynomial.eval₂RingHom
           ((algebraMap A₀ B_Z).comp (φ₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
           (algebraMap A₀ B_Z (φ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i)))))) := by
    have hEtaleComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
        {f : A →+* B} {g : B →+* C},
        RingHom.Etale f → RingHom.Etale g → RingHom.Etale (g.comp f) := by
      intro A B C _ _ _ f g hf hg
      letI : Algebra A B := f.toAlgebra
      letI : Algebra B C := g.toAlgebra
      letI : Algebra A C := (g.comp f).toAlgebra
      haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.Etale A B := RingHom.Etale.toAlgebra hf
      haveI : Algebra.Etale B C := RingHom.Etale.toAlgebra hg
      haveI : Algebra.Etale A C := Algebra.Etale.comp A B C
      exact RingHom.etale_algebraMap.mpr inferInstance
    have hAwayEtale : ∀ (R A₀ B_Z : Type u) [CommRing R] [CommRing A₀] [CommRing B_Z]
        (a : R)
        (φ₀ : (MvPolynomial (Fin 2) R ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* A₀)
        (i : Fin 2) [Algebra A₀ B_Z],
        RingHom.Etale φ₀ →
        IsLocalization.Away (φ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i))) B_Z →
        RingHom.Etale (Polynomial.eval₂RingHom
          ((algebraMap A₀ B_Z).comp (φ₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
          (algebraMap A₀ B_Z (φ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i))))) := by
      intro R A₀ B_Z _ _ _ a φ₀ i _ hEt_φ₀ hLoc
      let I_a : Ideal (MvPolynomial (Fin 2) R) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
      let Q_a := MvPolynomial (Fin 2) R ⧸ I_a
      let X_bar : Fin 2 → Q_a := fun k => Ideal.Quotient.mk I_a (MvPolynomial.X k)
      have hrel_Qa : X_bar 0 * X_bar 1 = Ideal.Quotient.mk I_a (MvPolynomial.C a) := by
        rw [← sub_eq_zero]
        change Ideal.Quotient.mk I_a (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      let L_i := Localization.Away (X_bar i)
      let L_T := Localization.Away (Polynomial.X : Polynomial R)
      let θ₀ : Polynomial R →+* L_i :=
        Polynomial.eval₂RingHom
          ((algebraMap Q_a L_i).comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C))
          (algebraMap Q_a L_i (X_bar i))
      have hθ₀_C : ∀ r : R, θ₀ (Polynomial.C r) =
          algebraMap Q_a L_i (Ideal.Quotient.mk I_a (MvPolynomial.C r)) := by
        intro r
        dsimp only [θ₀]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.comp_apply, RingHom.comp_apply]
      have hθ₀_X : θ₀ Polynomial.X = algebraMap Q_a L_i (X_bar i) := by
        dsimp only [θ₀]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      have hu_Xi : letI : Algebra (Polynomial R) L_i := θ₀.toAlgebra
          IsUnit (algebraMap (Polynomial R) L_i Polynomial.X) := by
        letI : Algebra (Polynomial R) L_i := θ₀.toAlgebra
        change IsUnit (θ₀ Polynomial.X)
        rw [hθ₀_X]
        exact IsLocalization.Away.algebraMap_isUnit (X_bar i)
      let θ : L_T →+* L_i :=
        letI : Algebra (Polynomial R) L_i := θ₀.toAlgebra
        IsLocalization.Away.lift (S := L_T) Polynomial.X hu_Xi
      have hθ_eq : ∀ P : Polynomial R, θ (algebraMap (Polynomial R) L_T P) = θ₀ P := by
        intro P
        letI : Algebra (Polynomial R) L_i := θ₀.toAlgebra
        exact IsLocalization.Away.lift_eq (S := L_T) Polynomial.X hu_Xi P
      let u_T : L_T := algebraMap (Polynomial R) L_T Polynomial.X
      let v_T : L_T :=
        algebraMap (Polynomial R) L_T (Polynomial.C a) *
          IsLocalization.Away.invSelf (S := L_T) (Polynomial.X : Polynomial R)
      have huv_T : u_T * v_T = algebraMap (Polynomial R) L_T (Polynomial.C a) := by
        dsimp only [u_T, v_T]
        rw [mul_left_comm,
          IsLocalization.Away.mul_invSelf (S := L_T) (Polynomial.X : Polynomial R), mul_one]
      let w_vec : Fin 2 → L_T := fun k => if k = i then u_T else v_T
      let ψ_mv : MvPolynomial (Fin 2) R →+* L_T :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial R) L_T).comp Polynomial.C) w_vec
      have hψ_ker : I_a ≤ RingHom.ker ψ_mv := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        dsimp only [ψ_mv]
        rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        fin_cases i
        · dsimp only [w_vec, Fin.isValue]
          simp only [↓reduceIte, Fin.zero_eta, one_ne_zero]
          exact sub_eq_zero.mpr huv_T
        · dsimp only [w_vec, Fin.isValue]
          simp only [↓reduceIte, Fin.mk_one, zero_ne_one]
          rw [mul_comm]
          exact sub_eq_zero.mpr huv_T
      let ψ₀_Q : Q_a →+* L_T := Ideal.Quotient.lift I_a ψ_mv hψ_ker
      have hψ₀_C : ∀ r : R, ψ₀_Q (Ideal.Quotient.mk I_a (MvPolynomial.C r)) =
          algebraMap (Polynomial R) L_T (Polynomial.C r) := by
        intro r
        change ψ_mv (MvPolynomial.C r) = _
        dsimp only [ψ_mv]
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      have hψ₀_X : ∀ k : Fin 2, ψ₀_Q (X_bar k) = w_vec k := by
        intro k
        change ψ_mv (MvPolynomial.X k) = w_vec k
        dsimp only [ψ_mv]
        rw [MvPolynomial.eval₂Hom_X']
      have hu_XT : letI : Algebra Q_a L_T := ψ₀_Q.toAlgebra
          IsUnit (algebraMap Q_a L_T (X_bar i)) := by
        letI : Algebra Q_a L_T := ψ₀_Q.toAlgebra
        change IsUnit (ψ₀_Q (X_bar i))
        rw [hψ₀_X i]
        dsimp only [w_vec]
        rw [if_pos rfl]
        exact IsLocalization.Away.algebraMap_isUnit Polynomial.X
      let ψ : L_i →+* L_T :=
        letI : Algebra Q_a L_T := ψ₀_Q.toAlgebra
        IsLocalization.Away.lift (S := L_i) (X_bar i) hu_XT
      have hψ_eq : ∀ q : Q_a, ψ (algebraMap Q_a L_i q) = ψ₀_Q q := by
        intro q
        letI : Algebra Q_a L_T := ψ₀_Q.toAlgebra
        exact IsLocalization.Away.lift_eq (S := L_i) (X_bar i) hu_XT q
      have hψθ : ψ.comp θ = RingHom.id L_T := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R))
        apply Polynomial.ringHom_ext
        · intro r
          simp only [RingHom.comp_apply, RingHom.id_apply, hθ_eq, hθ₀_C, hψ_eq, hψ₀_C]
        · simp only [RingHom.comp_apply, RingHom.id_apply, hθ_eq, hθ₀_X, hψ_eq, hψ₀_X,
            w_vec, ↓reduceIte, u_T]
      have hθψ : θ.comp ψ = RingHom.id L_i := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (X_bar i))
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change θ (ψ (algebraMap Q_a L_i (Ideal.Quotient.mk I_a (MvPolynomial.C r)))) =
            algebraMap Q_a L_i (Ideal.Quotient.mk I_a (MvPolynomial.C r))
          rw [hψ_eq, hψ₀_C, hθ_eq, hθ₀_C]
        · intro k
          change θ (ψ (algebraMap Q_a L_i (X_bar k))) = algebraMap Q_a L_i (X_bar k)
          rw [hψ_eq, hψ₀_X]
          by_cases hki : k = i
          · subst hki
            dsimp only [w_vec]
            rw [if_pos rfl]
            dsimp only [u_T]
            rw [hθ_eq, hθ₀_X]
          · dsimp only [w_vec]
            rw [if_neg hki]
            apply (IsLocalization.Away.algebraMap_isUnit (S := L_i) (X_bar i)).mul_left_inj.mp
            have hθ_u : θ u_T = algebraMap Q_a L_i (X_bar i) := by
              dsimp only [u_T]
              rw [hθ_eq, hθ₀_X]
            have h1 : θ v_T * algebraMap Q_a L_i (X_bar i) =
                algebraMap Q_a L_i (Ideal.Quotient.mk I_a (MvPolynomial.C a)) := by
              rw [← hθ_u, ← map_mul]
              have hv_mul : v_T * u_T = algebraMap (Polynomial R) L_T (Polynomial.C a) := by
                rw [mul_comm, huv_T]
              rw [hv_mul, hθ_eq, hθ₀_C]
            rw [h1, ← map_mul]
            have hprod_ki : X_bar k * X_bar i = Ideal.Quotient.mk I_a (MvPolynomial.C a) := by
              fin_cases i <;> fin_cases k
              · exact (hki rfl).elim
              · rw [mul_comm]; exact hrel_Qa
              · exact hrel_Qa
              · exact (hki rfl).elim
            rw [hprod_ki]
      have hBij_θ : Function.Bijective θ :=
        ⟨Function.LeftInverse.injective (fun z => by
           simpa only [RingHom.comp_apply, RingHom.id_apply] using DFunLike.congr_fun hψθ z),
         Function.RightInverse.surjective (fun z => by
           simpa only [RingHom.comp_apply, RingHom.id_apply] using DFunLike.congr_fun hθψ z)⟩
      have hEt_θ : RingHom.Etale θ := RingHom.Etale.of_bijective hBij_θ
      let f : A₀ := φ₀ (X_bar i)
      let g_QB : Q_a →+* B_Z := (algebraMap A₀ B_Z).comp φ₀
      have hu_f : letI : Algebra Q_a B_Z := g_QB.toAlgebra
          IsUnit (algebraMap Q_a B_Z (X_bar i)) := by
        letI : Algebra Q_a B_Z := g_QB.toAlgebra
        exact IsLocalization.Away.algebraMap_isUnit f
      let φ_tilde : L_i →+* B_Z :=
        letI : Algebra Q_a B_Z := g_QB.toAlgebra
        IsLocalization.Away.lift (S := L_i) (X_bar i) hu_f
      have hφ_tilde_eq : φ_tilde.comp (algebraMap Q_a L_i) = g_QB := by
        apply RingHom.ext
        intro q
        letI : Algebra Q_a B_Z := g_QB.toAlgebra
        exact IsLocalization.Away.lift_eq (S := L_i) (X_bar i) hu_f q
      have : Algebra.Etale A₀ B_Z := Algebra.Etale.of_isLocalizationAway f
      have hEt_gQB : RingHom.Etale g_QB :=
        hEtaleComp hEt_φ₀ (RingHom.etale_algebraMap.mpr inferInstance)
      have : Algebra.Etale Q_a L_i := Algebra.Etale.of_isLocalizationAway (X_bar i)
      have hEt_locQi : RingHom.Etale (algebraMap Q_a L_i) :=
        RingHom.etale_algebraMap.mpr inferInstance
      have hEt_φ_tilde : RingHom.Etale φ_tilde := by
        let u₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde)
        let u₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Q_a L_i))
        have : AlgebraicGeometry.Etale u₂ :=
          AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_locQi
        have hcomp_u : u₁ ≫ u₂ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_QB) := by
          dsimp only [u₁, u₂]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_tilde_eq]
        have : AlgebraicGeometry.Etale (u₁ ≫ u₂) := by
          rw [hcomp_u]
          exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_gQB
        have hEt_u₁ : AlgebraicGeometry.Etale u₁ := AlgebraicGeometry.Etale.of_comp u₁ u₂
        exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_u₁
      have : Algebra.Etale (Polynomial R) L_T := Algebra.Etale.of_isLocalizationAway Polynomial.X
      have hEt_locT : RingHom.Etale (algebraMap (Polynomial R) L_T) :=
        RingHom.etale_algebraMap.mpr inferInstance
      let γ := Polynomial.eval₂RingHom
        ((algebraMap A₀ B_Z).comp (φ₀.comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C)))
        (algebraMap A₀ B_Z (φ₀ (X_bar i)))
      have hγ_eq : γ = φ_tilde.comp (θ.comp (algebraMap (Polynomial R) L_T)) := by
        apply Polynomial.ringHom_ext
        · intro r
          change γ (Polynomial.C r) = φ_tilde (θ (algebraMap (Polynomial R) L_T (Polynomial.C r)))
          dsimp only [γ]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hθ_eq, hθ₀_C]
          exact (DFunLike.congr_fun hφ_tilde_eq (Ideal.Quotient.mk I_a (MvPolynomial.C r))).symm
        · change γ Polynomial.X = φ_tilde (θ (algebraMap (Polynomial R) L_T Polynomial.X))
          dsimp only [γ]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hθ_eq, hθ₀_X]
          exact (DFunLike.congr_fun hφ_tilde_eq (X_bar i)).symm
      change RingHom.Etale γ
      rw [hγ_eq]
      exact hEtaleComp (hEtaleComp hEt_locT hEt_θ) hEt_φ_tilde
    have hEtaleFieldZero : ∀ (E C R_loc : Type u) [Field E] [CommRing C] [Algebra E C]
        [Algebra.Etale E C] [CommRing R_loc] [IsLocalRing R_loc]
        (Φ : C →+* R_loc) (z : C),
        Φ z ∈ IsLocalRing.maximalIdeal R_loc → Φ z = 0 := by
      intro E C R_loc _ _ _ _ _ _ Φ z hz
      classical
      obtain ⟨I, _, Ai, instFieldAi, instAlgAi, ev, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod E C).mp inferInstance
      letI : ∀ j : I, Field (Ai j) := instFieldAi
      letI : ∀ j : I, Algebra E (Ai j) := instAlgAi
      let e_coord : ∀ j : I, Ai j := fun j => if ev z j = 0 then 1 else 0
      let e : C := ev.symm e_coord
      have hze : z * e = 0 := by
        apply ev.injective
        rw [map_mul, map_zero, ev.apply_symm_apply]
        ext j
        dsimp only [Pi.mul_apply, Pi.zero_apply, e_coord]
        split_ifs with hzj
        · rw [hzj, zero_mul]
        · rw [mul_zero]
      let w_coord : ∀ j : I, Ai j := fun j => (ev z j + e_coord j)⁻¹
      let w : C := ev.symm w_coord
      have hzew : (z + e) * w = 1 := by
        apply ev.injective
        rw [map_mul, map_add, map_one, ev.apply_symm_apply, ev.apply_symm_apply]
        ext j
        dsimp only [Pi.mul_apply, Pi.add_apply, Pi.one_apply, e_coord, w_coord]
        have hne : ev z j + (if ev z j = 0 then (1 : Ai j) else 0) ≠ 0 := by
          split_ifs with hzj
          · rw [hzj, zero_add]; exact one_ne_zero
          · rw [add_zero]; exact hzj
        exact mul_inv_cancel₀ hne
      have hu_ze : IsUnit (z + e) := ⟨⟨z + e, w, hzew, mul_comm (z + e) w ▸ hzew⟩, rfl⟩
      have hu_Φze : IsUnit (Φ z + Φ e) := by
        rw [← map_add]
        exact Φ.isUnit_map hu_ze
      have he_not_m : Φ e ∉ IsLocalRing.maximalIdeal R_loc := by
        intro he_m
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu_Φze) (Ideal.add_mem _ hz he_m)
      have hu_Φe : IsUnit (Φ e) := IsLocalRing.notMem_maximalIdeal.mp he_not_m
      have hprod0 : Φ z * Φ e = 0 := by
        rw [← map_mul, hze, map_zero]
      exact hu_Φe.mul_left_eq_zero.mp hprod0
    have hPidUniqueMin : ∀ (P₀ B₀ : Type u) [CommRing P₀] [IsDomain P₀] [IsPrincipalIdealRing P₀]
        [CommRing B₀] (ψ₀ : P₀ →+* B₀),
        RingHom.Etale ψ₀ →
        ∀ (q : Ideal B₀) [q.IsPrime] (p₁ p₂ : Ideal B₀),
          p₁ ∈ minimalPrimes B₀ → p₂ ∈ minimalPrimes B₀ →
          p₁ ≤ q → p₂ ≤ q → p₁ = p₂ := by
      intro P₀ B₀ _ _ _ _ ψ₀ hEt_ψ₀ q _ p₁ p₂ hp₁ hp₂ hle₁ hle₂
      letI : Algebra P₀ B₀ := ψ₀.toAlgebra
      haveI : Algebra.Etale P₀ B₀ := RingHom.Etale.toAlgebra hEt_ψ₀
      let R_loc : Type u := Localization.AtPrime q
      let m_loc : Ideal R_loc := IsLocalRing.maximalIdeal R_loc
      haveI : IsNoetherianRing B₀ := Algebra.FiniteType.isNoetherianRing P₀ B₀
      haveI : IsNoetherianRing R_loc := IsLocalization.isNoetherianRing q.primeCompl R_loc inferInstance
      haveI : Module.Flat P₀ R_loc := Module.Flat.trans P₀ B₀ R_loc
      haveI : Module.IsTorsionFree P₀ R_loc := Module.Flat.isTorsionFree
      let p : Ideal P₀ := Ideal.comap ψ₀ q
      haveI : p.IsPrime := Ideal.IsPrime.comap ψ₀
      have hDom_loc : IsDomain R_loc := by
        by_cases hp : p = ⊥
        · let K₀ : Type u := FractionRing P₀
          have hu_nzd : ∀ y : nonZeroDivisors P₀, IsUnit (algebraMap P₀ R_loc y.1) := by
            intro y
            have hy0 : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
            have hynot : ψ₀ y.1 ∉ q := by
              intro hmem
              have hp_mem : y.1 ∈ p := hmem
              rw [hp, Ideal.mem_bot] at hp_mem
              exact hy0 hp_mem
            change IsUnit (algebraMap B₀ R_loc (ψ₀ y.1))
            exact IsLocalization.map_units R_loc (⟨ψ₀ y.1, hynot⟩ : q.primeCompl)
          let α_K : K₀ →+* R_loc := IsLocalization.lift hu_nzd
          let f_K : K₀ →ₐ[P₀] R_loc :=
            { toRingHom := α_K
              commutes' := fun r => IsLocalization.lift_eq hu_nzd r }
          let f_B : B₀ →ₐ[P₀] R_loc := IsScalarTower.toAlgHom P₀ B₀ R_loc
          let T_K : Type u := TensorProduct P₀ K₀ B₀
          haveI : Algebra.Etale K₀ T_K := Algebra.Etale.baseChange P₀ B₀ K₀
          let Φ : T_K →+* R_loc := (Algebra.TensorProduct.productMap f_K f_B).toRingHom
          have hm0 : ∀ x ∈ m_loc, x = 0 := by
            intro x hx
            obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl x
            have hs_eq : Φ ((1 : K₀) ⊗ₜ[P₀] s) = algebraMap B₀ R_loc s := by
              dsimp only [Φ, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
              rw [Algebra.TensorProduct.productMap_apply_tmul]
              change α_K 1 * algebraMap B₀ R_loc s = _
              rw [map_one, one_mul]
            have hs_m : Φ ((1 : K₀) ⊗ₜ[P₀] s) ∈ m_loc := by
              rw [hs_eq, ← hst]
              exact Ideal.mul_mem_right _ m_loc hx
            have hs0 : algebraMap B₀ R_loc s = 0 := by
              rw [← hs_eq]
              exact hEtaleFieldZero K₀ T_K R_loc Φ ((1 : K₀) ⊗ₜ[P₀] s) hs_m
            have hu_t : IsUnit (algebraMap B₀ R_loc t.1) := IsLocalization.map_units R_loc t
            exact hu_t.mul_left_eq_zero.mp (hst.trans hs0)
          refine @NoZeroDivisors.to_isDomain R_loc _ _ ⟨fun {x y} hxy => ?_⟩
          by_cases hx0 : x = 0
          · exact Or.inl hx0
          · have hx_not_m : x ∉ m_loc := fun hxm => hx0 (hm0 x hxm)
            exact Or.inr ((IsLocalRing.notMem_maximalIdeal.mp hx_not_m).mul_right_eq_zero.mp hxy)
        · have hp_max : p.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hp
          let E_p : Type u := P₀ ⧸ p
          letI : Field E_p := Ideal.Quotient.field p
          let π₀ : P₀ := Submodule.IsPrincipal.generator p
          have hp_span : Ideal.span ({π₀} : Set P₀) = p :=
            Submodule.IsPrincipal.span_singleton_generator p
          have hπ₀_ne : π₀ ≠ 0 := by
            intro h0
            apply hp
            rw [← hp_span, h0, Set.singleton_zero, Ideal.span_zero]
          have hπ₀_mem : π₀ ∈ p := by
            rw [← hp_span]
            exact Ideal.subset_span rfl
          let π_loc : R_loc := algebraMap P₀ R_loc π₀
          have hπ_loc_m : π_loc ∈ m_loc :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc q (ψ₀ π₀)).mpr hπ₀_mem
          let I_π : Ideal R_loc := Ideal.span ({π_loc} : Set R_loc)
          have hI_le_m : I_π ≤ m_loc := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_loc_m)
          let Q_loc : Type u := R_loc ⧸ I_π
          let mk_π : R_loc →+* Q_loc := Ideal.Quotient.mk I_π
          have h_nonunit : ∀ r : R_loc, ¬ IsUnit (mk_π r) ↔ r ∈ m_loc := by
            intro r
            constructor
            · intro hnu
              by_contra hr_not
              exact hnu (mk_π.isUnit_map (IsLocalRing.notMem_maximalIdeal.mp hr_not))
            · intro hr_m hu_q
              obtain ⟨y_q, hy_q⟩ := hu_q.exists_right_inv
              obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y_q
              have h1 : mk_π (1 - r * s) = 0 := by
                rw [map_sub, map_one, map_mul, hy_q, sub_self]
              have hmem_I : 1 - r * s ∈ I_π := Ideal.Quotient.eq_zero_iff_mem.mp h1
              have h1_m : (1 : R_loc) ∈ m_loc := by
                have hsum : (1 - r * s) + r * s = 1 := sub_add_cancel 1 (r * s)
                rw [← hsum]
                exact m_loc.add_mem (hI_le_m hmem_I) (Ideal.mul_mem_right s m_loc hr_m)
              exact (Ideal.ne_top_iff_one m_loc).mp
                (IsLocalRing.maximalIdeal.isMaximal R_loc).ne_top h1_m
          haveI : Nontrivial Q_loc :=
            Ideal.Quotient.nontrivial_iff.mpr
              (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R_loc).ne_top hI_le_m)
          haveI : IsLocalRing Q_loc := by
            apply IsLocalRing.of_nonunits_add
            intro a b ha hb
            obtain ⟨ra, rfl⟩ := Ideal.Quotient.mk_surjective a
            obtain ⟨rb, rfl⟩ := Ideal.Quotient.mk_surjective b
            rw [mem_nonunits_iff, h_nonunit] at ha hb
            rw [← map_add, mem_nonunits_iff, h_nonunit]
            exact m_loc.add_mem ha hb
          have hker_p : p ≤ RingHom.ker (mk_π.comp (algebraMap P₀ R_loc)) := by
            rw [← hp_span, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
              RingHom.mem_ker, RingHom.comp_apply]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          let α_p : E_p →+* Q_loc := Ideal.Quotient.lift p (mk_π.comp (algebraMap P₀ R_loc)) hker_p
          letI : Algebra P₀ Q_loc := (mk_π.comp (algebraMap P₀ R_loc)).toAlgebra
          let g_E : E_p →ₐ[P₀] Q_loc :=
            { toRingHom := α_p
              commutes' := fun _ => rfl }
          let g_B : B₀ →ₐ[P₀] Q_loc :=
            { toRingHom := mk_π.comp (algebraMap B₀ R_loc)
              commutes' := fun _ => rfl }
          let T_p : Type u := TensorProduct P₀ E_p B₀
          haveI : Algebra.Etale E_p T_p := Algebra.Etale.baseChange P₀ B₀ E_p
          let Φ_Q : T_p →+* Q_loc := (Algebra.TensorProduct.productMap g_E g_B).toRingHom
          have hm_le_I : m_loc ≤ I_π := by
            intro x hx
            obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl x
            have hs_eq : Φ_Q ((1 : E_p) ⊗ₜ[P₀] s) = mk_π (algebraMap B₀ R_loc s) := by
              dsimp only [Φ_Q, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
              rw [Algebra.TensorProduct.productMap_apply_tmul]
              change α_p 1 * mk_π (algebraMap B₀ R_loc s) = _
              rw [map_one, one_mul]
            have hs_mQ : Φ_Q ((1 : E_p) ⊗ₜ[P₀] s) ∈ IsLocalRing.maximalIdeal Q_loc := by
              rw [hs_eq, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, h_nonunit, ← hst]
              exact Ideal.mul_mem_right _ m_loc hx
            have hs0 : mk_π (algebraMap B₀ R_loc s) = 0 := by
              rw [← hs_eq]
              exact hEtaleFieldZero E_p T_p Q_loc Φ_Q ((1 : E_p) ⊗ₜ[P₀] s) hs_mQ
            have hs_I : algebraMap B₀ R_loc s ∈ I_π := Ideal.Quotient.eq_zero_iff_mem.mp hs0
            have hu_t : IsUnit (algebraMap B₀ R_loc t.1) := IsLocalization.map_units R_loc t
            obtain ⟨t_inv, ht_inv⟩ := hu_t.exists_right_inv
            have hx_eq : x = algebraMap B₀ R_loc s * t_inv := by
              calc
                x = x * (algebraMap B₀ R_loc t.1 * t_inv) := by rw [ht_inv, mul_one]
                _ = (x * algebraMap B₀ R_loc t.1) * t_inv := (mul_assoc _ _ _).symm
                _ = algebraMap B₀ R_loc s * t_inv := by rw [hst]
            rw [hx_eq]
            exact Ideal.mul_mem_right t_inv I_π hs_I
          have hm_eq : m_loc = I_π := le_antisymm hm_le_I hI_le_m
          refine @NoZeroDivisors.to_isDomain R_loc _ _ ⟨fun {x y} hxy => ?_⟩
          by_contra! hne
          obtain ⟨hx, hy⟩ := hne
          have hKrull : (⨅ n : ℕ, m_loc ^ n) = ⊥ :=
            Ideal.iInf_pow_eq_bot_of_isLocalRing m_loc
              (IsLocalRing.maximalIdeal.isMaximal R_loc).ne_top
          have hex_n : ∃ n : ℕ, y ∉ m_loc ^ (n + 1) := by
            by_contra! hall
            apply hy
            rw [← Ideal.mem_bot, ← hKrull, Ideal.mem_iInf]
            intro k
            cases k with
            | zero => rw [pow_zero, Ideal.one_eq_top]; trivial
            | succ n => exact hall n
          classical
          let b : ℕ := Nat.find hex_n
          have hy_not : y ∉ m_loc ^ (b + 1) := Nat.find_spec hex_n
          have hy_in : y ∈ m_loc ^ b := by
            cases hb : b with
            | zero => rw [pow_zero, Ideal.one_eq_top]; trivial
            | succ k =>
              have hk : k < b := by omega
              exact not_not.mp (Nat.find_min hex_n hk)
          rw [hm_eq, Ideal.span_singleton_pow] at hy_in hy_not
          obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hy_in
          have hu_not_m : u ∉ m_loc := by
            intro hu_m
            rw [hm_eq] at hu_m
            obtain ⟨v, hv⟩ := Ideal.mem_span_singleton.mp hu_m
            apply hy_not
            rw [Ideal.mem_span_singleton]
            exact ⟨v, by rw [hu_eq, hv, pow_succ, mul_assoc]⟩
          have hu_unit : IsUnit u := IsLocalRing.notMem_maximalIdeal.mp hu_not_m
          have hπx : π_loc ^ b * x = 0 := by
            apply hu_unit.mul_left_eq_zero.mp
            calc
              (π_loc ^ b * x) * u = x * (π_loc ^ b * u) := by ring
              _ = x * y := by rw [← hu_eq]
              _ = 0 := hxy
          have hsmul : (π₀ ^ b) • x = 0 := by
            rw [Algebra.smul_def, map_pow]
            exact hπx
          rcases smul_eq_zero.mp hsmul with hπb0 | hx0
          · exact pow_ne_zero b hπ₀_ne hπb0
          · exact hx hx0
      let p_bot : Ideal B₀ := Ideal.comap (algebraMap B₀ R_loc) ⊥
      have hp_bot_prime : p_bot.IsPrime := Ideal.IsPrime.comap (algebraMap B₀ R_loc)
      have hp_bot_le : ∀ (p' : Ideal B₀), p'.IsPrime → p' ≤ q → p_bot ≤ p' := by
        intro p' hp'_prime hp'_le s hs
        have hs0 : algebraMap B₀ R_loc s = algebraMap B₀ R_loc 0 := by
          rw [map_zero]; exact hs
        obtain ⟨t, ht_eq⟩ := (IsLocalization.eq_iff_exists q.primeCompl R_loc).mp hs0
        have hts : t.1 * s ∈ p' := by
          have h0 : t.1 * s = 0 := by simpa only [mul_zero] using ht_eq
          rw [h0]; exact p'.zero_mem
        rcases hp'_prime.mem_or_mem hts with ht_p' | hs_p'
        · exact (t.2 (hp'_le ht_p')).elim
        · exact hs_p'
      have h1 : p₁ = p_bot :=
        le_antisymm (hp₁.2 ⟨hp_bot_prime, bot_le⟩ (hp_bot_le p₁ hp₁.1.1 hle₁))
          (hp_bot_le p₁ hp₁.1.1 hle₁)
      have h2 : p₂ = p_bot :=
        le_antisymm (hp₂.2 ⟨hp_bot_prime, bot_le⟩ (hp_bot_le p₂ hp₂.1.1 hle₂))
          (hp_bot_le p₂ hp₂.1.1 hle₂)
      exact h1.trans h2.symm
    have hQuotEtale : ∀ (R_mod P₀ B₀ : Type u) [CommRing R_mod] [CommRing P₀] [CommRing B₀]
        (ψ_mod : R_mod →+* B₀) (σ : R_mod →+* P₀) (r_gen : R_mod),
        RingHom.Etale ψ_mod →
        σ r_gen = 0 →
        ∀ (γ : P₀ →+* (B₀ ⧸ Ideal.span ({ψ_mod r_gen} : Set B₀))),
          γ.comp σ = (Ideal.Quotient.mk (Ideal.span ({ψ_mod r_gen} : Set B₀))).comp ψ_mod →
          (∀ (S : Type u) [CommRing S] (g₁ g₂ : P₀ →+* S),
            g₁.comp σ = g₂.comp σ → g₁ = g₂) →
          RingHom.Etale γ := by
      intro R_mod P₀ B₀ _ _ _ ψ_mod σ r_gen hEt_ψ hσ0 γ hγ_σ hEpi_σ
      let J : Ideal B₀ := Ideal.span ({ψ_mod r_gen} : Set B₀)
      let Q := B₀ ⧸ J
      let π_J : B₀ →+* Q := Ideal.Quotient.mk J
      letI : Algebra R_mod B₀ := ψ_mod.toAlgebra
      haveI : Algebra.Etale R_mod B₀ := RingHom.Etale.toAlgebra hEt_ψ
      letI : Algebra R_mod P₀ := σ.toAlgebra
      let T : Type u := TensorProduct R_mod P₀ B₀
      haveI : Algebra.Etale P₀ T := Algebra.Etale.baseChange R_mod B₀ P₀
      let j_L : P₀ →+* T := Algebra.TensorProduct.includeLeftRingHom
      let j_R : B₀ →+* T :=
        (Algebra.TensorProduct.includeRight (R := R_mod) (A := P₀) (B := B₀)).toRingHom
      have hEt_jL : RingHom.Etale j_L := RingHom.etale_algebraMap.mpr inferInstance
      letI : Algebra R_mod Q := (π_J.comp ψ_mod).toAlgebra
      let f_L : P₀ →ₐ[R_mod] Q :=
        { toRingHom := γ
          commutes' := fun r => DFunLike.congr_fun hγ_σ r }
      let f_R : B₀ →ₐ[R_mod] Q :=
        { toRingHom := π_J
          commutes' := fun _ => rfl }
      let fwd : T →+* Q := (Algebra.TensorProduct.productMap f_L f_R).toRingHom
      have hR_comm : ∀ r : R_mod, j_R (ψ_mod r) = j_L (σ r) := by
        intro r
        dsimp only [j_R, j_L]
        rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.includeLeftRingHom_apply]
        have hr : ψ_mod r = r • (1 : B₀) := by
          change ψ_mod r = ψ_mod r * 1
          exact (mul_one _).symm
        rw [hr, ← TensorProduct.smul_tmul]
        change (σ r * 1) ⊗ₜ[R_mod] (1 : B₀) = _
        rw [mul_one]
      have hJ_ker : J ≤ RingHom.ker j_R := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
          hR_comm r_gen, hσ0, map_zero]
      let bwd : Q →+* T := Ideal.Quotient.lift J j_R hJ_ker
      have hbwd_π : bwd.comp π_J = j_R := by ext b; rfl
      have hbwd_γ : bwd.comp γ = j_L := by
        apply hEpi_σ T (bwd.comp γ) j_L
        rw [RingHom.comp_assoc, hγ_σ, ← RingHom.comp_assoc, hbwd_π]
        ext r
        exact hR_comm r
      have h_fb : ∀ z : Q, fwd (bwd z) = z := by
        intro z
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
        change fwd (j_R b) = π_J b
        dsimp only [fwd, j_R, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.productMap_apply_tmul]
        change γ 1 * π_J b = π_J b
        rw [map_one, one_mul]
      have h_bf : ∀ z : T, bwd (fwd z) = z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul P b =>
          dsimp only [fwd, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_mul]
          have h1 : bwd (γ P) = j_L P := DFunLike.congr_fun hbwd_γ P
          have h2 : bwd (π_J b) = j_R b := DFunLike.congr_fun hbwd_π b
          change bwd (γ P) * bwd (π_J b) = P ⊗ₜ[R_mod] b
          rw [h1, h2]
          dsimp only [j_L, j_R]
          rw [Algebra.TensorProduct.includeLeftRingHom_apply, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add u v hu hv => rw [map_add, map_add, hu, hv]
      have hBij_fwd : Function.Bijective fwd :=
        ⟨Function.LeftInverse.injective h_bf, Function.RightInverse.surjective h_fb⟩
      have hγ_eq : γ = fwd.comp j_L := by
        ext P
        dsimp only [fwd, j_L, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [Algebra.TensorProduct.includeLeftRingHom_apply,
          Algebra.TensorProduct.productMap_apply_tmul]
        change γ P = γ P * π_J 1
        rw [map_one, mul_one]
      rw [hγ_eq]
      exact hEtaleComp hEt_jL (RingHom.Etale.of_bijective hBij_fwd)
    refine ⟨fun k₀ _ B₀ _ ψ₀ hEt => hPidUniqueMin (Polynomial k₀) B₀ ψ₀ hEt, ?_, hAwayEtale⟩
    intro k₀ _ a_bar B₀ _ ψ_mod hEt_ψ
    let I_a : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_bar}
    let R_mod := MvPolynomial (Fin 2) k₀ ⧸ I_a
    let X_bar : Fin 2 → R_mod := fun k => Ideal.Quotient.mk I_a (MvPolynomial.X k)
    by_cases ha_bar : a_bar = 0
    · subst ha_bar
      have hrel0 : X_bar 0 * X_bar 1 = 0 := by
        have h1 : Ideal.Quotient.mk I_a
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : k₀)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        simpa only [map_zero, sub_zero, map_mul, X_bar] using h1
      constructor
      · intro q _ p₁ p₂ p₃ hp₁ hp₂ hp₃ hle₁ hle₂ hle₃
        have hBranchUniq : ∀ (i : Fin 2) (p p' : Ideal B₀),
            p ∈ minimalPrimes B₀ → p' ∈ minimalPrimes B₀ →
            p ≤ q → p' ≤ q → ψ_mod (X_bar i) ∈ p → ψ_mod (X_bar i) ∈ p' → p = p' := by
          intro i p p' hp hp' hple hp'le hxi_p hxi_p'
          let x_i : B₀ := ψ_mod (X_bar i)
          let J_i : Ideal B₀ := Ideal.span ({x_i} : Set B₀)
          let Q_i := B₀ ⧸ J_i
          let π_i : B₀ →+* Q_i := Ideal.Quotient.mk J_i
          have hker_π : RingHom.ker π_i = J_i := Ideal.mk_ker
          have hJ_p : J_i ≤ p := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxi_p)
          have hJ_p' : J_i ≤ p' := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxi_p')
          have hJ_q : J_i ≤ q := hJ_p.trans hple
          let q_bar : Ideal Q_i := Ideal.map π_i q
          let p_bar : Ideal Q_i := Ideal.map π_i p
          let p'_bar : Ideal Q_i := Ideal.map π_i p'
          haveI : q_bar.IsPrime :=
            Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
              (by rw [hker_π]; exact hJ_q)
          have hp_bar_comap : Ideal.comap π_i p_bar = p := by
            rw [Ideal.comap_map_of_surjective π_i Ideal.Quotient.mk_surjective]
            change p ⊔ RingHom.ker π_i = p
            rw [hker_π, sup_eq_left.mpr hJ_p]
          have hp'_bar_comap : Ideal.comap π_i p'_bar = p' := by
            rw [Ideal.comap_map_of_surjective π_i Ideal.Quotient.mk_surjective]
            change p' ⊔ RingHom.ker π_i = p'
            rw [hker_π, sup_eq_left.mpr hJ_p']
          have hp_bar_prime : p_bar.IsPrime := by
            haveI : p.IsPrime := hp.1.1
            exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
              (by rw [hker_π]; exact hJ_p)
          have hp'_bar_prime : p'_bar.IsPrime := by
            haveI : p'.IsPrime := hp'.1.1
            exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
              (by rw [hker_π]; exact hJ_p')
          have hp_bar_min : p_bar ∈ minimalPrimes Q_i := by
            refine ⟨⟨hp_bar_prime, bot_le⟩, fun u hu hle_u => ?_⟩
            haveI : u.IsPrime := hu.1
            have hu_comap_prime : (Ideal.comap π_i u).IsPrime := Ideal.IsPrime.comap π_i
            have hu_le_p : Ideal.comap π_i u ≤ p := by
              rw [← hp_bar_comap]
              exact Ideal.comap_mono hle_u
            have hp_le_u : p ≤ Ideal.comap π_i u := hp.2 ⟨hu_comap_prime, bot_le⟩ hu_le_p
            have hmap_u : Ideal.map π_i (Ideal.comap π_i u) = u :=
              Ideal.map_comap_of_surjective π_i Ideal.Quotient.mk_surjective u
            rw [← hmap_u]
            exact Ideal.map_mono hp_le_u
          have hp'_bar_min : p'_bar ∈ minimalPrimes Q_i := by
            refine ⟨⟨hp'_bar_prime, bot_le⟩, fun u hu hle_u => ?_⟩
            haveI : u.IsPrime := hu.1
            have hu_comap_prime : (Ideal.comap π_i u).IsPrime := Ideal.IsPrime.comap π_i
            have hu_le_p' : Ideal.comap π_i u ≤ p' := by
              rw [← hp'_bar_comap]
              exact Ideal.comap_mono hle_u
            have hp'_le_u : p' ≤ Ideal.comap π_i u := hp'.2 ⟨hu_comap_prime, bot_le⟩ hu_le_p'
            have hmap_u : Ideal.map π_i (Ideal.comap π_i u) = u :=
              Ideal.map_comap_of_surjective π_i Ideal.Quotient.mk_surjective u
            rw [← hmap_u]
            exact Ideal.map_mono hp'_le_u
          let v_i : Fin 2 → Polynomial k₀ := fun k => if k = i then 0 else Polynomial.X
          let σ_mv : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
            MvPolynomial.eval₂Hom Polynomial.C v_i
          have hσ_ker : I_a ≤ RingHom.ker σ_mv := by
            rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
            dsimp only [σ_mv]
            rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
              MvPolynomial.eval₂Hom_C, map_zero, sub_zero]
            dsimp only [v_i]
            fin_cases i <;> simp
          let σ_i : R_mod →+* Polynomial k₀ := Ideal.Quotient.lift I_a σ_mv hσ_ker
          have hσ_C : ∀ c : k₀, σ_i (Ideal.Quotient.mk I_a (MvPolynomial.C c)) = Polynomial.C c := by
            intro c
            change σ_mv (MvPolynomial.C c) = Polynomial.C c
            dsimp only [σ_mv]
            rw [MvPolynomial.eval₂Hom_C]
          have hσ_X : ∀ k : Fin 2, σ_i (X_bar k) = v_i k := by
            intro k
            change σ_mv (MvPolynomial.X k) = v_i k
            dsimp only [σ_mv]
            rw [MvPolynomial.eval₂Hom_X']
          let γ_i : Polynomial k₀ →+* Q_i :=
            Polynomial.eval₂RingHom
              ((π_i.comp ψ_mod).comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C))
              (π_i (ψ_mod (X_bar (1 - i))))
          have hγ_σ : γ_i.comp σ_i = π_i.comp ψ_mod := by
            apply Ideal.Quotient.ringHom_ext
            apply MvPolynomial.ringHom_ext
            · intro c
              change γ_i (σ_i (Ideal.Quotient.mk I_a (MvPolynomial.C c))) =
                π_i (ψ_mod (Ideal.Quotient.mk I_a (MvPolynomial.C c)))
              rw [hσ_C c]
              dsimp only [γ_i]
              rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
              rfl
            · intro k
              change γ_i (σ_i (X_bar k)) = π_i (ψ_mod (X_bar k))
              rw [hσ_X k]
              dsimp only [v_i]
              by_cases hki : k = i
              · rw [if_pos hki, map_zero, hki]
                symm
                exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
              · rw [if_neg hki]
                dsimp only [γ_i]
                rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
                have hk1 : 1 - i = k := by
                  fin_cases i <;> fin_cases k
                  · exact (hki rfl).elim
                  · rfl
                  · rfl
                  · exact (hki rfl).elim
                rw [hk1]
          have hEt_γ : RingHom.Etale γ_i := by
            apply hQuotEtale R_mod (Polynomial k₀) B₀ ψ_mod σ_i (X_bar i) hEt_ψ
              (by rw [hσ_X i]; dsimp only [v_i]; rw [if_pos rfl])
              γ_i hγ_σ
            intro S _ g₁ g₂ hg
            apply Polynomial.ringHom_ext
            · intro c
              have hc := DFunLike.congr_fun hg (Ideal.Quotient.mk I_a (MvPolynomial.C c))
              change g₁ (σ_i (Ideal.Quotient.mk I_a (MvPolynomial.C c))) =
                g₂ (σ_i (Ideal.Quotient.mk I_a (MvPolynomial.C c))) at hc
              rwa [hσ_C c] at hc
            · have hX := DFunLike.congr_fun hg (X_bar (1 - i))
              change g₁ (σ_i (X_bar (1 - i))) = g₂ (σ_i (X_bar (1 - i))) at hX
              have h1i : (1 - i : Fin 2) ≠ i := by fin_cases i <;> decide
              rw [hσ_X (1 - i)] at hX
              dsimp only [v_i] at hX
              rwa [if_neg h1i] at hX
          have hp_bar_eq : p_bar = p'_bar :=
            hPidUniqueMin (Polynomial k₀) Q_i γ_i hEt_γ q_bar p_bar p'_bar hp_bar_min hp'_bar_min
              (Ideal.map_mono hple) (Ideal.map_mono hp'le)
          rw [← hp_bar_comap, ← hp'_bar_comap, hp_bar_eq]
        have hprod_zero : ψ_mod (X_bar 0) * ψ_mod (X_bar 1) = 0 := by
          rw [← map_mul, hrel0, map_zero]
        have hor₁ : ψ_mod (X_bar 0) ∈ p₁ ∨ ψ_mod (X_bar 1) ∈ p₁ :=
          hp₁.1.1.mem_or_mem (hprod_zero ▸ p₁.zero_mem)
        have hor₂ : ψ_mod (X_bar 0) ∈ p₂ ∨ ψ_mod (X_bar 1) ∈ p₂ :=
          hp₂.1.1.mem_or_mem (hprod_zero ▸ p₂.zero_mem)
        have hor₃ : ψ_mod (X_bar 0) ∈ p₃ ∨ ψ_mod (X_bar 1) ∈ p₃ :=
          hp₃.1.1.mem_or_mem (hprod_zero ▸ p₃.zero_mem)
        rcases hor₁ with h1 | h1 <;> rcases hor₂ with h2 | h2 <;> rcases hor₃ with h3 | h3
        · exact Or.inl (hBranchUniq 0 p₁ p₂ hp₁ hp₂ hle₁ hle₂ h1 h2)
        · exact Or.inl (hBranchUniq 0 p₁ p₂ hp₁ hp₂ hle₁ hle₂ h1 h2)
        · exact Or.inr (Or.inl (hBranchUniq 0 p₁ p₃ hp₁ hp₃ hle₁ hle₃ h1 h3))
        · exact Or.inr (Or.inr (hBranchUniq 1 p₂ p₃ hp₂ hp₃ hle₂ hle₃ h2 h3))
        · exact Or.inr (Or.inr (hBranchUniq 0 p₂ p₃ hp₂ hp₃ hle₂ hle₃ h2 h3))
        · exact Or.inr (Or.inl (hBranchUniq 1 p₁ p₃ hp₁ hp₃ hle₁ hle₃ h1 h3))
        · exact Or.inl (hBranchUniq 1 p₁ p₂ hp₁ hp₂ hle₁ hle₂ h1 h2)
        · exact Or.inl (hBranchUniq 1 p₁ p₂ hp₁ hp₂ hle₁ hle₂ h1 h2)
      · intro q₀ hq₀
        letI : Algebra R_mod B₀ := ψ_mod.toAlgebra
        haveI : Algebra.Etale R_mod B₀ := RingHom.Etale.toAlgebra hEt_ψ
        haveI : Algebra.HasGoingDown R_mod B₀ := Algebra.HasGoingDown.of_flat
        haveI : q₀.IsPrime := hq₀.1.1
        let r₀ : Ideal R_mod := Ideal.comap ψ_mod q₀
        have hr₀_prime : r₀.IsPrime := Ideal.IsPrime.comap ψ_mod
        haveI : r₀.IsPrime := hr₀_prime
        have hr₀_min : r₀ ∈ minimalPrimes R_mod := by
          refine ⟨⟨hr₀_prime, bot_le⟩, fun r' hr' hle_r' => ?_⟩
          haveI : r'.IsPrime := hr'.1
          haveI : q₀.LiesOver r₀ := ⟨rfl⟩
          obtain ⟨q', hq'_le, hq'_prime, hq'_over⟩ :=
            Ideal.exists_ideal_le_liesOver_of_le (R := R_mod) (S := B₀) q₀ hle_r'
          have hq'_eq : q' = q₀ := le_antisymm hq'_le (hq₀.2 ⟨hq'_prime, bot_le⟩ hq'_le)
          have hr'_eq : r' = r₀ := by
            have hover := hq'_over.over
            rw [hq'_eq] at hover
            exact hover
          exact hr'_eq.symm.le
        by_contra! hall_mem
        have hX0_r₀ : X_bar 0 ∈ r₀ := hall_mem 0
        have hX1_r₀ : X_bar 1 ∈ r₀ := hall_mem 1
        let ev₀ : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
          MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
        have hev₀_ker : I_a ≤ RingHom.ker ev₀ := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          dsimp only [ev₀]
          rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C, map_zero, sub_zero]
          simp
        let ev_bar₀ : R_mod →+* Polynomial k₀ := Ideal.Quotient.lift I_a ev₀ hev₀_ker
        let r' : Ideal R_mod := RingHom.ker ev_bar₀
        have hr'_prime : r'.IsPrime := RingHom.ker_isPrime ev_bar₀
        have hr'_le : r' ≤ r₀ := by
          intro y hy
          obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective y
          have hevP : ev₀ P = 0 := hy
          let ι₁ : Polynomial k₀ →+* MvPolynomial (Fin 2) k₀ :=
            Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
          let J₀ : Ideal (MvPolynomial (Fin 2) k₀) := Ideal.span {MvPolynomial.X 0}
          have h_id_J₀ : (Ideal.Quotient.mk J₀).comp (ι₁.comp ev₀) = Ideal.Quotient.mk J₀ := by
            apply MvPolynomial.ringHom_ext
            · intro c
              dsimp only [RingHom.comp_apply, ev₀, ι₁]
              rw [MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
            · intro i
              fin_cases i
              · dsimp only [Fin.zero_eta, Fin.isValue, RingHom.comp_apply, ev₀, ι₁]
                rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero, map_zero, map_zero]
                symm
                exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
              · dsimp only [Fin.mk_one, Fin.isValue, RingHom.comp_apply, ev₀, ι₁]
                rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero,
                  Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          have hP_J₀ : P ∈ J₀ := by
            apply Ideal.Quotient.eq_zero_iff_mem.mp
            rw [← DFunLike.congr_fun h_id_J₀ P, RingHom.comp_apply, RingHom.comp_apply,
              hevP, map_zero, map_zero]
          obtain ⟨Q, rfl⟩ := Ideal.mem_span_singleton.mp hP_J₀
          rw [map_mul]
          exact Ideal.mul_mem_right _ r₀ hX0_r₀
        have hr₀_le : r₀ ≤ r' := hr₀_min.2 ⟨hr'_prime, bot_le⟩ hr'_le
        have hX1_ker : ev_bar₀ (X_bar 1) = 0 := hr₀_le hX1_r₀
        have hX_eq : ev_bar₀ (X_bar 1) = Polynomial.X := by
          change ev₀ (MvPolynomial.X 1) = Polynomial.X
          dsimp only [ev₀]
          rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero]
        exact Polynomial.X_ne_zero (hX_eq ▸ hX1_ker)
    · have hX0_unit : IsUnit (X_bar 0) := by
        let u_inv : R_mod :=
          Ideal.Quotient.mk I_a (MvPolynomial.C a_bar⁻¹ * MvPolynomial.X 1)
        have hmul1 : X_bar 0 * u_inv = 1 := by
          let one_mv : MvPolynomial (Fin 2) k₀ := 1
          have hpoly : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) *
                (MvPolynomial.C a_bar⁻¹ * MvPolynomial.X 1) - one_mv =
              MvPolynomial.C a_bar⁻¹ * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_bar) := by
            have h1 : (MvPolynomial.C a_bar⁻¹ : MvPolynomial (Fin 2) k₀) * MvPolynomial.C a_bar =
                one_mv := by
              rw [← map_mul, inv_mul_cancel₀ ha_bar, map_one]
            calc
              (MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) *
                  (MvPolynomial.C a_bar⁻¹ * MvPolynomial.X 1) - one_mv
                  = MvPolynomial.C a_bar⁻¹ * (MvPolynomial.X 0 * MvPolynomial.X 1) - one_mv := by
                      dsimp only [one_mv]; ring
              _ = MvPolynomial.C a_bar⁻¹ * (MvPolynomial.X 0 * MvPolynomial.X 1) -
                    MvPolynomial.C a_bar⁻¹ * MvPolynomial.C a_bar := by rw [← h1]
              _ = MvPolynomial.C a_bar⁻¹ *
                    (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_bar) := (mul_sub _ _ _).symm
          have hmk : X_bar 0 * u_inv - 1 =
              Ideal.Quotient.mk I_a
                ((MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) *
                  (MvPolynomial.C a_bar⁻¹ * MvPolynomial.X 1) - one_mv) := by
            rw [map_sub, map_mul]; rfl
          rw [← sub_eq_zero, hmk, hpoly]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))
        exact ⟨⟨X_bar 0, u_inv, hmul1, mul_comm (X_bar 0) u_inv ▸ hmul1⟩, rfl⟩
      have hψX0_unit : IsUnit (ψ_mod (X_bar 0)) := ψ_mod.isUnit_map hX0_unit
      constructor
      · intro q _ p₁ p₂ _ hp₁ hp₂ _ hle₁ hle₂ _
        letI : Algebra B₀ B₀ := Algebra.id B₀
        have hLoc_id : IsLocalization.Away (ψ_mod (X_bar 0)) B₀ :=
          { map_units := by
              rintro ⟨_, n, rfl⟩
              exact hψX0_unit.pow n
            surj := fun z => ⟨(z, ⟨1, 0, pow_zero _⟩), by simp⟩
            exists_of_eq := fun h => ⟨⟨1, 0, pow_zero _⟩, by simpa using h⟩ }
        have hEt_γ₀ := hAwayEtale k₀ B₀ B₀ a_bar ψ_mod 0 hEt_ψ hLoc_id
        exact Or.inl (hPidUniqueMin (Polynomial k₀) B₀ _ hEt_γ₀ q p₁ p₂ hp₁ hp₂ hle₁ hle₂)
      · intro q₀ hq₀
        refine ⟨0, fun hmem => ?_⟩
        exact hq₀.1.1.ne_top (Ideal.eq_top_of_isUnit_mem q₀ hmem hψX0_unit)

  
  have h_s2 :
      ∀ (T₀' ℰ' : AlgebraicGeometry.Scheme.{u})
        (fst₀ : T₀' ⟶ ℰ') [AlgebraicGeometry.IsClosedImmersion fst₀]
        (Z : Set ↥T₀'),
        Z ∈ irreducibleComponents ↥T₀' →
        ∃ (Z_sch : AlgebraicGeometry.Scheme.{u})
          (ιZ : Z_sch ⟶ T₀')
          (K_Z : Type u) (_ : Field K_Z)
          (η_Z : AlgebraicGeometry.Spec (CommRingCat.of K_Z) ⟶ Z_sch)
          (pt_Z : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_Z))),
          AlgebraicGeometry.IsClosedImmersion ιZ ∧
          AlgebraicGeometry.IsIntegral Z_sch ∧
          Set.range ιZ.base = Z ∧
          AlgebraicGeometry.IsDominant η_Z ∧
          IsSchemeFunctionField Z_sch K_Z η_Z ∧
          closure ({ιZ.base (η_Z.base pt_Z)} : Set ↥T₀') = Z ∧
          (∀ (U_Z : ℰ'.Opens) (hUZ : AlgebraicGeometry.IsAffineOpen U_Z)
             (hη_mem : fst₀.base (ιZ.base (η_Z.base pt_Z)) ∈ U_Z),
            ∃ (e_res : (hUZ.primeIdealOf
                 ⟨fst₀.base (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal.ResidueField ≃+* K_Z),
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (e_res.toRingHom.comp
                  (algebraMap ↑(ℰ'.presheaf.obj (Opposite.op U_Z))
                    (hUZ.primeIdealOf
                      ⟨fst₀.base (ιZ.base (η_Z.base pt_Z)), hη_mem⟩).asIdeal.ResidueField))) ≫
                hUZ.fromSpec =
                η_Z ≫ ιZ ≫ fst₀) := by
    intro T₀' ℰ' fst₀ _ Z hZ
    have hZ_irred : IsIrreducible Z := hZ.1
    have hZ_cl : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
    let ξ_Z : ↥T₀' := hZ_irred.genericPoint
    have hξ_cl : closure ({ξ_Z} : Set ↥T₀') = Z := hZ_irred.closure_genericPoint hZ_cl
    let f_ξ := T₀'.fromSpecResidueField ξ_Z
    have hSub_res : Subsingleton ↥(AlgebraicGeometry.Spec (T₀'.residueField ξ_Z)) := by
      change Subsingleton (PrimeSpectrum ↑(T₀'.residueField ξ_Z))
      infer_instance
    have : Finite ↥(AlgebraicGeometry.Spec (T₀'.residueField ξ_Z)) := Finite.of_subsingleton
    have : AlgebraicGeometry.QuasiCompact f_ξ :=
      ⟨fun _ _ _ => (Set.toFinite _).isCompact⟩
    let Z_sch : AlgebraicGeometry.Scheme.{u} := f_ξ.image
    let ιZ : Z_sch ⟶ T₀' := f_ξ.imageι
    have hClZ : AlgebraicGeometry.IsClosedImmersion ιZ := inferInstance
    have hRangeZ : Set.range ιZ.base = Z := by
      change Set.range f_ξ.ker.subschemeι.base = Z
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.Hom.support_ker,
        AlgebraicGeometry.Scheme.range_fromSpecResidueField, hξ_cl]
    have : AlgebraicGeometry.IsDominant f_ξ.toImage := inferInstance
    have hDense_toImg : DenseRange f_ξ.toImage.base := AlgebraicGeometry.IsDominant.denseRange
    have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (T₀'.residueField ξ_Z)) := by
      change IrreducibleSpace (PrimeSpectrum ↑(T₀'.residueField ξ_Z))
      infer_instance
    have hUniv_irred : IsIrreducible (Set.univ : Set ↥Z_sch) := by
      have h1 : IsIrreducible (Set.range f_ξ.toImage.base) := by
        rw [← Set.image_univ]
        exact (IrreducibleSpace.isIrreducible_univ _).image f_ξ.toImage.base
          f_ξ.toImage.base.hom.continuous.continuousOn
