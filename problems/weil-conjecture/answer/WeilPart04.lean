        refine ⟨fun hm => ?_, fun hm => Ideal.mul_mem_left _ _ hm⟩
        rcases (inferInstance : 𝔪_fib.IsPrime).mem_or_mem hm with hrm | hxm
        · exact False.elim (hr_not_𝔪 ((inferInstance : 𝔪_fib.IsPrime).mem_of_pow_mem m hrm))
        · exact hxm
      rw [h1, h_mul_eq, h_C_iff rx_C]
      exact h2
    have hq_α_fib : ∀ x : A_fib, q_W (α_fib x) = ēv x := by
      intro x
      obtain ⟨w, hw⟩ := hq_surj (ēv x)
      have h_ker : x - algebraMap ↥W A_fib w ∈ 𝔪_fib := by
        change ēv (x - algebraMap ↥W A_fib w) = 0
        rw [map_sub, hēv_left, hw, sub_self]
      have h_max : α_fib (x - algebraMap ↥W A_fib w) ∈ IsLocalRing.maximalIdeal ↥W :=
        (hα_fib_iff _).mpr h_ker
      have h_q0 : q_W (α_fib (x - algebraMap ↥W A_fib w)) = 0 :=
        RingHom.mem_ker.mp (hq_ker.symm ▸ h_max)
      rw [map_sub, hα_fib_W, map_sub, sub_eq_zero] at h_q0
      exact h_q0.trans hw
    let α : B →+* ↥W := α_fib.comp ι_BA
    refine ⟨α, ?_, ?_⟩
    · exact RingHom.ext hα_fib_W
    · exact RingHom.ext fun b => (hq_α_fib (ι_BA b)).trans (hēv_right b)
  
  obtain ⟨hFin_Δ, ⟨σ_Z, hσZ_sec, hσZ_in_Z⟩⟩ :=
    step_s2 κ_P Y_P snd_P hFin_P Z hZ_mem hZ_P1
  
  have _ : IsLocalization.AtPrime R_P P.asIdeal :=
    ValuationSubring.ofPrime_localization V P.asIdeal
  have h_units : ∀ y : P.asIdeal.primeCompl, IsUnit (algebraMap ↥V κ_P y.1) := by
    intro y
    refine IsUnit.mk0 _ ?_
    intro h0
    have hmem : y.1 ∈ RingHom.ker (algebraMap ↥V κ_P) := h0
    rw [Ideal.ker_algebraMap_residueField P.asIdeal] at hmem
    exact y.2 hmem
