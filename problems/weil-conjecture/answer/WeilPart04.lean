          · intro k
            fin_cases k
            · change f_inv (f_to (algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X0_bar)) =
                algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X0_bar
              rw [IsLocalization.Away.lift_eq, hg_X0_eq, IsLocalization.Away.lift_eq]
              simp [h_pol, T_pol]
            · change f_inv (f_to (algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X1_bar)) =
                algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X1_bar
              rw [IsLocalization.Away.lift_eq]
              have hg_X₁ : g_nod X1_bar = algebraMap (Polynomial ↥V) L_pol (Polynomial.C a) *
                  IsLocalization.Away.invSelf (S := L_pol) T_pol := by
                change g_mv_alg (MvPolynomial.X 1) = _
                simp [g_mv_alg]
              rw [hg_X₁, map_mul]
              have hf_Ca : f_inv (algebraMap (Polynomial ↥V) L_pol (Polynomial.C a)) =
                  algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod
                    (Ideal.Quotient.mk I_nod (MvPolynomial.C a)) := by
                rw [IsLocalization.Away.lift_eq]
                simp only [h_pol, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
