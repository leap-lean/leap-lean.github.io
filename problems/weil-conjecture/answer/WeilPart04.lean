          CategoryTheory.Category.assoc _ _ _
      _ = j_loc ≫ (j_W₀ ≫ e) := by rw [he_ψ₀_glob]
      _ = j_W ≫ e := (CategoryTheory.Category.assoc _ _ _).symm
  · calc j_W ≫ W.ι ≫ g_X
      _ = j_loc ≫ (j_W₀ ≫ W.ι ≫ g_X) := CategoryTheory.Category.assoc _ _ _
      _ = j_loc ≫ (AlgebraicGeometry.Spec.map ψ₀ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)) := by
          rw [hjW₀_gX]
      _ = e_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) :=
          (CategoryTheory.Category.assoc _ _ _).symm
  · calc AlgebraicGeometry.Spec.map π_ZB ≫ j_W ≫ W.ι ≫ g_X
      _ = AlgebraicGeometry.Spec.map π_ZB ≫
            (j_loc ≫ (j_W₀ ≫ W.ι ≫ g_X)) := by simp only [j_W, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map π_ZB ≫
            (e_0 ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)) := by
          rw [hjW₀_gX, ← CategoryTheory.Category.assoc j_loc]
      _ = AlgebraicGeometry.Spec.map
            ((CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) ≫
              (ψ₀ ≫ CommRingCat.ofHom lam) ≫ π_ZB) := by
          rw [he_0_spec, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk I_zc).comp (algebraMap ↥V R_z))) := by
          congr 1
          ext v
          exact congrArg (fun f : R_z →+* R_z ⧸ I_zc => f (algebraMap ↥V R_z v)) hComm_π
  · change (j_loc ≫ j_W₀ ≫ W.ι).base ((AlgebraicGeometry.Spec.map π_ZB).base m_Z) = z
    rw [hm_Z_eq]
    change (j_W₀ ≫ W.ι).base (j_loc.base p_z') = z
    rw [hp_z']
    exact hp_z_W

theorem weil_valuation_closed_point_center_isClosed (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hFinSpec : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)))
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSep : AlgebraicGeometry.IsSeparated g_X)
    (z : X)
    (hz_cl : IsClosed ({z} : Set X))
    (P_z : Ideal ↥V) [P_z.IsPrime]
    (hPz_eq : (g_X.base z).asIdeal = P_z)
    (t_z : ↥V)
    (ht_z : t_z ∉ P_z)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z]
    [IsLocalization.Away t_z R_z] [IsLocalization.AtPrime R_z P_z]
    (I_zc : Ideal R_z)
    (B' : CommRingCat.{u})
    (ι_0 : AlgebraicGeometry.Spec B' ⟶ X)
    (hOpen_0 : AlgebraicGeometry.IsOpenImmersion ι_0)
    (π_ZB : B' ⟶ CommRingCat.of (R_z ⧸ I_zc))
    (hSurj_ZB : Function.Surjective π_ZB.hom)
    (hZ_comm : AlgebraicGeometry.Spec.map π_ZB ≫ ι_0 ≫ g_X =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_zc).comp (algebraMap ↥V R_z))))
    (m_Z : ↥(AlgebraicGeometry.Spec (CommRingCat.of (R_z ⧸ I_zc))))
    (hm_Z : (AlgebraicGeometry.Spec.map π_ZB ≫ ι_0).base m_Z = z) :
    IsClosed (Set.range (AlgebraicGeometry.Spec.map π_ZB ≫ ι_0).base) :=
by
  have _ : AlgebraicGeometry.IsOpenImmersion ι_0 ∧ Function.Surjective π_ZB.hom :=
    ⟨hOpen_0, hSurj_ZB⟩
  have : AlgebraicGeometry.IsSeparated g_X := hSep
  let σ_Z : AlgebraicGeometry.Spec (CommRingCat.of (R_z ⧸ I_zc)) ⟶ X :=
    AlgebraicGeometry.Spec.map π_ZB ≫ ι_0
  let φ_Z : ↥V →+* R_z ⧸ I_zc := (Ideal.Quotient.mk I_zc).comp (algebraMap ↥V R_z)
  have hσ_comm : σ_Z ≫ g_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z) :=
    (CategoryTheory.Category.assoc _ _ _).trans hZ_comm
  have hσ_base_ideal : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (R_z ⧸ I_zc))),
      (g_X.base (σ_Z.base q)).asIdeal = Ideal.comap φ_Z q.asIdeal := by
    intro q
    have hpt : g_X.base (σ_Z.base q) =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z)).base q :=
      congrArg (fun h => h.base q) hσ_comm
    rw [hpt, AlgebraicGeometry.Spec.map_base]
    rfl
  
  have hOrderInj : ∀ (q₁ q₂ : Ideal R_z) [q₁.IsPrime] [q₂.IsPrime],
      Ideal.comap (algebraMap ↥V R_z) q₁ = Ideal.comap (algebraMap ↥V R_z) q₂ → q₁ = q₂ := by
    intro q₁ q₂ hq₁ hq₂ hcomap
    have himg : IsLocalization.orderIsoOfPrime (Submonoid.powers t_z) R_z ⟨q₁, hq₁⟩ =
        IsLocalization.orderIsoOfPrime (Submonoid.powers t_z) R_z ⟨q₂, hq₂⟩ :=
      Subtype.ext hcomap
    exact congrArg Subtype.val
      ((IsLocalization.orderIsoOfPrime (Submonoid.powers t_z) R_z).injective himg)
  have hComap_inj : Function.Injective (PrimeSpectrum.comap φ_Z) := by
    intro q₁ q₂ hq
    let q₁₀ : Ideal R_z := Ideal.comap (Ideal.Quotient.mk I_zc) q₁.asIdeal
    let q₂₀ : Ideal R_z := Ideal.comap (Ideal.Quotient.mk I_zc) q₂.asIdeal
    have : q₁₀.IsPrime := q₁.isPrime.comap _
    have : q₂₀.IsPrime := q₂.isPrime.comap _
    have hq0_eq : q₁₀ = q₂₀ := by
      apply hOrderInj
      exact congrArg PrimeSpectrum.asIdeal hq
    exact PrimeSpectrum.ext (Ideal.comap_injective_of_surjective (Ideal.Quotient.mk I_zc)
      Ideal.Quotient.mk_surjective hq0_eq)
  have hQ_le_Pz : ∀ q : PrimeSpectrum (R_z ⧸ I_zc), Ideal.comap φ_Z q.asIdeal ≤ P_z := by
    intro q v hv
    let q₀ : Ideal R_z := Ideal.comap (Ideal.Quotient.mk I_zc) q.asIdeal
    have hq₀ : q₀.IsPrime := q.isPrime.comap _
    have hv_q0 : algebraMap ↥V R_z v ∈ q₀ := hv
    by_contra hv_not_Pz
    have hUnit_v : IsUnit (algebraMap ↥V R_z v) :=
      IsLocalization.map_units R_z (⟨v, hv_not_Pz⟩ : P_z.primeCompl)
    exact hq₀.ne_top (q₀.eq_top_of_isUnit_mem hv_q0 hUnit_v)
  have hDomainLift : ∀ (q : PrimeSpectrum (R_z ⧸ I_zc))
      (S : Type u) [CommRing S] [IsDomain S] (μ : ↥V →+* S),
      IsUnit (μ t_z) →
      RingHom.ker μ = Ideal.comap φ_Z q.asIdeal →
      ∃ (τ : R_z ⧸ I_zc →+* S), τ.comp φ_Z = μ ∧ RingHom.ker τ = q.asIdeal := by
    intro q S _ _ μ hUnit hKer
    obtain ⟨τ_tilde, hτ_comp⟩ : ∃ τ_tilde : R_z →+* S,
        τ_tilde.comp (algebraMap ↥V R_z) = μ :=
      ⟨IsLocalization.Away.lift t_z hUnit,
        RingHom.ext (IsLocalization.Away.lift_eq t_z hUnit)⟩
    let q₀ : Ideal R_z := Ideal.comap (Ideal.Quotient.mk I_zc) q.asIdeal
    have : q₀.IsPrime := q.isPrime.comap _
    have : (RingHom.ker τ_tilde).IsPrime := RingHom.ker_isPrime τ_tilde
    have hKer_tilde : RingHom.ker τ_tilde = q₀ := by
      apply hOrderInj
      calc Ideal.comap (algebraMap ↥V R_z) (RingHom.ker τ_tilde)
        _ = RingHom.ker (τ_tilde.comp (algebraMap ↥V R_z)) := rfl
        _ = RingHom.ker μ := by rw [hτ_comp]
        _ = Ideal.comap φ_Z q.asIdeal := hKer
        _ = Ideal.comap (algebraMap ↥V R_z) q₀ := rfl
    have hIzc_ker : ∀ a ∈ I_zc, τ_tilde a = 0 := by
      intro a ha
      have hmk0 : Ideal.Quotient.mk I_zc a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
      have ha_q0 : a ∈ q₀ := by
        change Ideal.Quotient.mk I_zc a ∈ q.asIdeal
        rw [hmk0]
        exact q.asIdeal.zero_mem
      rw [← hKer_tilde] at ha_q0
      exact ha_q0
    refine ⟨Ideal.Quotient.lift I_zc τ_tilde hIzc_ker, ?_, ?_⟩
    · ext v
      exact congrFun (congrArg DFunLike.coe hτ_comp) v
    · ext bar_r
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective bar_r
      change τ_tilde r = 0 ↔ Ideal.Quotient.mk I_zc r ∈ q.asIdeal
      change r ∈ RingHom.ker τ_tilde ↔ Ideal.Quotient.mk I_zc r ∈ q.asIdeal
      rw [hKer_tilde]
      rfl
  have hLiftUnique : ∀ (S : Type u) [CommRing S] (μ : ↥V →+* S)
      (τ₁ τ₂ : R_z ⧸ I_zc →+* S),
      τ₁.comp φ_Z = μ → τ₂.comp φ_Z = μ → τ₁ = τ₂ := by
    intro S _ μ τ₁ τ₂ h₁ h₂
    apply Ideal.Quotient.ringHom_ext
    apply IsLocalization.ringHom_ext (Submonoid.powers t_z)
    exact h₁.trans h₂.symm
  have hmZ_comap : Ideal.comap φ_Z m_Z.asIdeal = P_z := by
    rw [← hσ_base_ideal m_Z, hm_Z, hPz_eq]
  
  have hIsDomOfInj : ∀ (O F : Type u) [CommRing O] [IsDomain O] [Field F] (ι : O →+* F),
      Function.Injective ι →
      AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)) := by
    intro O F _ _ _ ι hInj
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    apply Set.Subset.antisymm (Set.subset_univ _)
    intro p _
    let bot_F : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := ⟨⊥, inferInstance⟩
    have hmem : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)).base bot_F ∈
        Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)).base := ⟨bot_F, rfl⟩
    have hsub : closure ({(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)).base bot_F} :
        Set ↥(AlgebraicGeometry.Spec (CommRingCat.of O))) ⊆
        closure (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)).base) :=
      closure_mono (Set.singleton_subset_iff.mpr hmem)
    apply hsub
    let p' : PrimeSpectrum O := p
    let q' : PrimeSpectrum O := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)).base bot_F
    have hcl : p' ∈ closure ({q'} : Set (PrimeSpectrum O)) := by
      rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus]
      have hbot : q'.asIdeal = ⊥ := by
        change (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι)).base bot_F).asIdeal : Ideal O) = ⊥
        rw [AlgebraicGeometry.Spec.map_base]
        exact (RingHom.injective_iff_ker_eq_bot ι).mp hInj
      rw [hbot]
      exact SetLike.coe_subset_coe.mpr bot_le
    exact hcl
  
  have : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinSpec
  have : Finite ↥(AlgebraicGeometry.Spec (CommRingCat.of (R_z ⧸ I_zc))) :=
    Finite.of_injective
      (fun q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (R_z ⧸ I_zc))) =>
        PrimeSpectrum.comap φ_Z q)
      (fun q₁ q₂ h => hComap_inj h)
  change IsClosed (Set.range σ_Z.base)
  rw [← closure_subset_iff_isClosed]
  have hRange_union : Set.range σ_Z.base =
      ⋃ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (R_z ⧸ I_zc))), ({σ_Z.base q} : Set X) := by
    ext y
    simp [Set.mem_range]
  rw [hRange_union, closure_iUnion_of_finite, ← hRange_union]
  intro y hy
  rw [Set.mem_iUnion] at hy
  obtain ⟨q, hy_cl⟩ := hy
  
  let x_q : X := σ_Z.base q
  let Q : Ideal ↥V := Ideal.comap φ_Z q.asIdeal
  have : Q.IsPrime := q.isPrime.comap φ_Z
  have hQ_Pz : Q ≤ P_z := hQ_le_Pz q
  have hxq_Q : (g_X.base x_q).asIdeal = Q := hσ_base_ideal q
  have htz_not_Q : t_z ∉ Q := fun h => ht_z (hQ_Pz h)
  
  suffices hMain : ∀ (D_V : Type u) [CommRing D_V] [IsDomain D_V] (mkQ : ↥V →+* D_V),
      Function.Surjective mkQ →
      RingHom.ker mkQ = Q →
      ∀ (F_Q : Type u) [Field F_Q] [Algebra D_V F_Q] [IsFractionRing D_V F_Q],
      y ∈ Set.range σ_Z.base by
    exact hMain (↥V ⧸ Q) (Ideal.Quotient.mk Q) Ideal.Quotient.mk_surjective Ideal.mk_ker
      (FractionRing (↥V ⧸ Q))
  intro D_V _ _ mkQ hSurj_mkQ hKer_mkQ F_Q _ _ _
  have hWithLoc : ∀ (P' : Ideal D_V) [P'.IsPrime] {Goal : Prop},
      (∀ (O : Type u) [CommRing O] [IsDomain O] [IsLocalRing O]
        [Algebra D_V O] [IsLocalization.AtPrime O P'], Goal) → Goal :=
    fun P' _ _ H => H (Localization.AtPrime P')
  have hLocToFrac : ∀ (P' : Ideal D_V) [P'.IsPrime]
      (O : Type u) [CommRing O] [Algebra D_V O] [IsLocalization.AtPrime O P'],
      ∃ (ι_P : O →+* F_Q),
        Function.Injective ι_P ∧
        ι_P.comp (algebraMap D_V O) = algebraMap D_V F_Q := by
    intro P' _ O _ _ _
    have hUnits : ∀ s : P'.primeCompl, IsUnit (algebraMap D_V F_Q s.1) := by
      intro s
      have hs_ne : s.1 ≠ 0 := fun h0 => s.2 (h0 ▸ P'.zero_mem)
      exact Ne.isUnit ((map_ne_zero_iff (algebraMap D_V F_Q)
        (IsFractionRing.injective D_V F_Q)).mpr hs_ne)
    refine ⟨IsLocalization.lift (M := P'.primeCompl) (S := O) hUnits, ?_, ?_⟩
    · intro x₁ x₂ hx
      have hz : IsLocalization.lift (M := P'.primeCompl) (S := O) hUnits (x₁ - x₂) = 0 := by
        rw [map_sub, hx, sub_self]
      obtain ⟨⟨d, s⟩, hzs⟩ := IsLocalization.surj P'.primeCompl (x₁ - x₂)
      have hds : algebraMap D_V F_Q d = 0 := by
        calc algebraMap D_V F_Q d
          _ = IsLocalization.lift (M := P'.primeCompl) (S := O) hUnits (algebraMap D_V O d) :=
            (IsLocalization.lift_eq (M := P'.primeCompl) (S := O) hUnits d).symm
          _ = IsLocalization.lift (M := P'.primeCompl) (S := O) hUnits
                ((x₁ - x₂) * algebraMap D_V O s.1) := by rw [← hzs]
          _ = IsLocalization.lift (M := P'.primeCompl) (S := O) hUnits (x₁ - x₂) *
                IsLocalization.lift (M := P'.primeCompl) (S := O) hUnits (algebraMap D_V O s.1) :=
            map_mul _ _ _
          _ = 0 := by rw [hz, zero_mul]
      have hd0 : d = 0 :=
        (map_eq_zero_iff (algebraMap D_V F_Q) (IsFractionRing.injective D_V F_Q)).mp hds
      have hzs0 : (x₁ - x₂) * algebraMap D_V O s.1 = 0 := by
        rw [hzs, hd0, map_zero]
      exact sub_eq_zero.mp ((IsLocalization.map_units O s).mul_left_eq_zero.mp hzs0)
    · ext x
      exact IsLocalization.lift_eq (M := P'.primeCompl) (S := O) hUnits x
  let ν_Q : ↥V →+* F_Q := (algebraMap D_V F_Q).comp mkQ
  have hνQ_ker : RingHom.ker ν_Q = Q := by
    ext v
    change algebraMap D_V F_Q (mkQ v) = 0 ↔ v ∈ Q
    rw [map_eq_zero_iff (algebraMap D_V F_Q) (IsFractionRing.injective D_V F_Q)]
    change v ∈ RingHom.ker mkQ ↔ v ∈ Q
    rw [hKer_mkQ]
  have hνQ_tz_ne : ν_Q t_z ≠ 0 := by
    intro h0
    apply htz_not_Q
    rw [← hνQ_ker]
    exact h0
  have hνQ_unit : IsUnit (ν_Q t_z) := Ne.isUnit hνQ_tz_ne
  obtain ⟨ν_Z, hνZ_comp, hνZ_ker⟩ := hDomainLift q F_Q ν_Q hνQ_unit hνQ_ker
  
  let ψ_F : AlgebraicGeometry.Spec (CommRingCat.of F_Q) ⟶ X :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Z) ≫ σ_Z
  have hψF_pt : ∀ w : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_Q)), ψ_F.base w = x_q := by
    intro w
    have hw_bot : w.asIdeal = ⊥ := by
      have hw_eq : (w : PrimeSpectrum F_Q) = (⟨⊥, inferInstance⟩ : PrimeSpectrum F_Q) :=
        Subsingleton.elim _ _
      exact congrArg PrimeSpectrum.asIdeal hw_eq
    have hmap_w : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Z)).base w = q := by
      apply PrimeSpectrum.ext
      rw [AlgebraicGeometry.Spec.map_base]
      change Ideal.comap ν_Z w.asIdeal = q.asIdeal
      rw [hw_bot]
      exact hνZ_ker
    change σ_Z.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Z)).base w) = x_q
    rw [hmap_w]
  have hψF_comm : ψ_F ≫ g_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Q) := by
    calc ψ_F ≫ g_X
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Z) ≫ (σ_Z ≫ g_X) :=
        CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Z) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z) := by rw [hσ_comm]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z ≫ CommRingCat.ofHom ν_Z) :=
        (AlgebraicGeometry.Spec.map_comp _ _).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ν_Z.comp φ_Z)) := by
        rw [← CommRingCat.ofHom_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ν_Q) := by rw [hνZ_comp]
  
  let P_y : Ideal ↥V := (g_X.base y).asIdeal
  have : P_y.IsPrime := (g_X.base y).isPrime
  have hQ_Py : Q ≤ P_y := by
    let gy' : PrimeSpectrum ↥V := g_X.base y
    let gx' : PrimeSpectrum ↥V := g_X.base x_q
    have hgy_cl : gy' ∈ closure ({gx'} : Set (PrimeSpectrum ↥V)) := by
      have himg : g_X.base y ∈ g_X.base '' closure ({x_q} : Set X) := ⟨y, hy_cl, rfl⟩
      have hsub := image_closure_subset_closure_image g_X.continuous (s := ({x_q} : Set X))
      rw [Set.image_singleton] at hsub
      exact hsub himg
    rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus] at hgy_cl
    rw [← hxq_Q]
    exact SetLike.coe_subset_coe.mp hgy_cl
  obtain ⟨U_y, hUy_aff, hy_Uy, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens))
      (by trivial : y ∈ (⊤ : X.Opens))
  have hx_Uy : x_q ∈ U_y := by
    obtain ⟨w, hw_U, hw_sing⟩ := mem_closure_iff.mp hy_cl (U_y : Set X) U_y.isOpen hy_Uy
    rwa [Set.mem_singleton_iff.mp hw_sing] at hw_U
  obtain ⟨A, ι_A, hOpen_ιA, hRange_ιA⟩ :
      ∃ (A : CommRingCat.{u}) (ι_A : AlgebraicGeometry.Spec A ⟶ X),
        AlgebraicGeometry.IsOpenImmersion ι_A ∧ Set.range ι_A.base = (U_y : Set X) :=
    ⟨X.presheaf.obj (Opposite.op U_y), hUy_aff.fromSpec, inferInstance, hUy_aff.range_fromSpec⟩
  have : AlgebraicGeometry.IsOpenImmersion ι_A := hOpen_ιA
  have hx_rangeA : x_q ∈ Set.range ι_A.base := hRange_ιA.symm ▸ hx_Uy
  have hy_rangeA : y ∈ Set.range ι_A.base := hRange_ιA.symm ▸ hy_Uy
  have ⟨p_x, hpx_eq⟩ := hx_rangeA
  have ⟨p_y, hpy_eq⟩ := hy_rangeA
  have hp_le : p_x.asIdeal ≤ p_y.asIdeal := by
    have hpre_sing : ι_A.base ⁻¹' ({x_q} : Set X) = ({p_x} : Set ↥(AlgebraicGeometry.Spec A)) := by
      ext p
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun hp => ι_A.isOpenEmbedding.injective (hp.trans hpx_eq.symm),
        fun hp => hp.symm ▸ hpx_eq⟩
    have hpy_pre : p_y ∈ ι_A.base ⁻¹' closure ({x_q} : Set X) := by
      change ι_A.base p_y ∈ closure ({x_q} : Set X)
      rwa [hpy_eq]
    rw [IsOpenMap.preimage_closure_eq_closure_preimage ι_A.isOpenEmbedding.isOpenMap
      ι_A.continuous ({x_q} : Set X), hpre_sing] at hpy_pre
    let px' : PrimeSpectrum ↑A := p_x
    let py' : PrimeSpectrum ↑A := p_y
    have hpy_cl' : py' ∈ closure ({px'} : Set (PrimeSpectrum ↑A)) := hpy_pre
    rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus] at hpy_cl'
    exact SetLike.coe_subset_coe.mp hpy_cl'
  obtain ⟨γ, hιA_comm⟩ : ∃ γ : ↥V →+* ↑A,
      ι_A ≫ g_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ) :=
    ⟨(AlgebraicGeometry.Spec.preimage (ι_A ≫ g_X)).hom,
      (AlgebraicGeometry.Spec.map_preimage (ι_A ≫ g_X)).symm⟩
  have hpx_Q : Ideal.comap γ p_x.asIdeal = Q := by
    calc Ideal.comap γ p_x.asIdeal
      _ = ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)).base p_x).asIdeal := by
        rw [AlgebraicGeometry.Spec.map_base]; rfl
      _ = ((ι_A ≫ g_X).base p_x).asIdeal := by rw [← hιA_comm]
