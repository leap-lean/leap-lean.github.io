          · exact Or.inr (map_dvd (Ideal.Quotient.mk Q) hyx)
        letI instAlgCQ : Algebra (Polynomial R_Q) C_Q := ψ_Q.toAlgebra
        haveI : Algebra.Etale (Polynomial R_Q) C_Q := RingHom.etale_algebraMap.mp hψ_Q
        exact weil_etale_stalk_over_integrallyClosed_domain_isDomain (Polynomial R_Q) C_Q q
      have hZMT :=
        weil_etale_quotient_zmt_witness_of_not_mem_special_prime K R B ψ hψ h𝔔 hStalkDom
          𝔪 h𝔪 h𝔔_le s hs𝔪 hs
      exact weil_sepClosed_zmt_weierstrass_monic_flat_div K R B ψ hψ 𝔪 h𝔪 h𝔔_le
        π_b s b w hs𝔪 hsb hZMT
    · exact ⟨s, w, hs𝔪, hsb⟩

theorem weil_base_chart_section_vanishing_nonZero_pullback (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (U_K : C_K.Opens) (hUK : Nonempty ↥U_K)
    (U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_ss_cur : C_cur ⟶ U_ss)
    (ι_ss : U_K.toScheme ⟶ U_ss)
    (ι_cur : U_K.toScheme ⟶ C_cur)
    (hSS_base : IsStrictlySemistableCurveOverValuation V g_ss)
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hComm_fss : f_ss_cur ≫ g_ss = g_cur)
    (hι_fss : ι_cur ≫ f_ss_cur = ι_ss)
    (hPb_ss : CategoryTheory.IsPullback ι_ss (U_K.ι ≫ p_K) g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_cur : CategoryTheory.IsPullback ι_cur (U_K.ι ≫ p_K) g_cur
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥) (u₀ : ↥U_ss)
    (ϖ : ↥V) (hϖ_P : ϖ ∉ P.asIdeal)
    (hϖ_le : ∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal)
    (hϖ_mem : ∀ x : K, x ∈ V.ofPrime P.asIdeal ↔
      ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a)
    (hOpen_VP : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))))
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_ne : Z.Nonempty)
    (hZ_contr : ∀ q ∈ Z,
      f_ss_cur.base ((CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base q) = u₀) :
    let s_P := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
    let R_P := ↥(V.ofPrime P.asIdeal)
    let ι_VP : ↥V →+* R_P := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
    ∃ (X_0 : C_cur.Opens)
      (g_X0 : X_0.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_P)),
      AlgebraicGeometry.IsIntegral X_0.toScheme ∧
      AlgebraicGeometry.Flat g_X0 ∧
      (∀ q ∈ Z, (CategoryTheory.Limits.pullback.fst g_cur s_P).base q ∈ X_0) ∧
      g_X0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) = X_0.ι ≫ g_cur ∧
      ∀ (q_0 : ↥(CategoryTheory.Limits.pullback g_cur s_P))
        (σ_0 : AlgebraicGeometry.Spec (CommRingCat.of R_P) ⟶ X_0.toScheme),
        q_0 ∈ Z →
        σ_0 ≫ g_X0 = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_P)) →
        (σ_0 ≫ X_0.ι).base
            ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩ =
          (CategoryTheory.Limits.pullback.fst g_cur s_P).base q_0 →
        ∃ (b : ↑(X_0.toScheme.presheaf.obj (Opposite.op ⊤))),
          (σ_0.appTop).hom b = 0 ∧
          (∀ (V_sub : X_0.toScheme.Opens), Nonempty ↥V_sub →
            (X_0.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b ≠
              (0 : ↑(X_0.toScheme.presheaf.obj (Opposite.op V_sub)))) ∧
          (∀ (V_sub : X_0.toScheme.Opens) (hV_aff : AlgebraicGeometry.IsAffineOpen V_sub)
              (x : ↥V_sub),
            (V_sub.ι ≫ g_X0).base x =
              ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩ →
            (∃ q' ∈ Z, (V_sub.ι ≫ X_0.ι).base x =
              (CategoryTheory.Limits.pullback.fst g_cur s_P).base q') →
            (X_0.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b ∈
              (hV_aff.isoSpec.hom.base x).asIdeal) :=
by
  classical
  have _ := hPb_cur
  have _ := hP
  let s_P := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
  let R_P := ↥(V.ofPrime P.asIdeal)
  let ι_VP : ↥V →+* R_P := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  let j_VP := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)
  have _ : AlgebraicGeometry.IsOpenImmersion j_VP := hOpen_VP
  let 𝔪_RP : PrimeSpectrum R_P :=
    ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩
  have hϖ_ne : ϖ ≠ 0 := fun h => hϖ_P (h ▸ P.asIdeal.zero_mem)

  
  have hComap_max : Ideal.comap ι_VP (IsLocalRing.maximalIdeal R_P) = P.asIdeal := by
    ext x
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
    constructor
    · intro hnot_unit
      by_contra hxP
      apply hnot_unit
      have hx0 : x ≠ 0 := fun h => hxP (h ▸ P.asIdeal.zero_mem)
      have hxK_ne : V.subtype x ≠ 0 := fun h => hx0 (Subtype.val_injective h)
      have hϖ_rad : ϖ ∈ (Ideal.span ({x} : Set ↥V)).radical := by
        rw [Ideal.radical_eq_sInf]
        simp only [Ideal.mem_sInf, Set.mem_ofPred_eq, Ideal.span_singleton_le_iff_mem]
        rintro J ⟨hxJ, hJ_prime⟩
        by_contra hϖJ
        exact hxP (((hϖ_le ⟨J, hJ_prime⟩).mp hϖJ) hxJ)
      rw [Ideal.mem_radical_iff] at hϖ_rad
      rcases hϖ_rad with ⟨k, hk⟩
      rw [Ideal.mem_span_singleton] at hk
      rcases hk with ⟨a, hka⟩
      have h_eq_K : (V.subtype ϖ) ^ k = V.subtype x * V.subtype a := by
        rw [← map_pow, ← map_mul, hka]
      have hx_inv_mem : (V.subtype x)⁻¹ ∈ V.ofPrime P.asIdeal := by
        refine (hϖ_mem (V.subtype x)⁻¹).mpr ⟨a, k, ?_⟩
        rw [h_eq_K, inv_mul_cancel_left₀ hxK_ne]
      let y : R_P := ⟨(V.subtype x)⁻¹, hx_inv_mem⟩
      exact ⟨⟨ι_VP x, y, Subtype.ext (mul_inv_cancel₀ hxK_ne),
        Subtype.ext (inv_mul_cancel₀ hxK_ne)⟩, rfl⟩
    · intro hxP hu
      rcases hu.exists_right_inv with ⟨y, hy⟩
      have hyK : V.subtype x * y.1 = 1 := congrArg Subtype.val hy
      obtain ⟨a, k, hya⟩ := (hϖ_mem y.1).mp y.2
      have h_pow_K : V.subtype (ϖ ^ k) = V.subtype (x * a) := by
        rw [map_pow, map_mul, ← hya, ← mul_assoc, hyK, one_mul]
      have h_pow_V : ϖ ^ k = x * a := Subtype.val_injective h_pow_K
      have h_mem_P : ϖ ^ k ∈ P.asIdeal := by
        rw [h_pow_V]
        exact Ideal.mul_mem_right a P.asIdeal hxP
      exact hϖ_P (P.isPrime.mem_of_pow_mem k h_mem_P)

  have hj_max : j_VP.base 𝔪_RP = P := PrimeSpectrum.ext hComap_max

  obtain ⟨q_init, hq_init⟩ := hZ_ne
  have hu₀_P : g_ss.base u₀ = P := by
    have h1 : g_ss.base u₀ =
        (CategoryTheory.Limits.pullback.fst g_cur s_P ≫ g_cur).base q_init := by
      calc
        g_ss.base u₀
            = g_ss.base (f_ss_cur.base
                ((CategoryTheory.Limits.pullback.fst g_cur s_P).base q_init)) := by
              rw [hZ_contr q_init hq_init]
        _ = ((CategoryTheory.Limits.pullback.fst g_cur s_P) ≫
              (f_ss_cur ≫ g_ss)).base q_init := rfl
        _ = (CategoryTheory.Limits.pullback.fst g_cur s_P ≫ g_cur).base q_init := by
              rw [hComm_fss]
    rw [CategoryTheory.Limits.pullback.condition] at h1
    let pt_κ : PrimeSpectrum P.asIdeal.ResidueField :=
      (CategoryTheory.Limits.pullback.snd g_cur s_P).base q_init
    have hpt_bot : pt_κ.asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top pt_κ.asIdeal).resolve_right pt_κ.isPrime.ne_top
    have hsP_pt : s_P.base pt_κ = P := by
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap ↥V P.asIdeal.ResidueField) pt_κ.asIdeal = P.asIdeal
      rw [hpt_bot, ← RingHom.ker_eq_comap_bot]
      exact Ideal.ker_algebraMap_residueField P.asIdeal
    exact h1.trans hsP_pt

  
  have hChart_pkg :
      ∃ (W_ss : U_ss.Opens) (A_V : Type u) (_ : CommRing A_V) (_ : IsDomain A_V)
        (c_A : ↥V →+* A_V)
        (e_0 : W_ss.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_V)),
        u₀ ∈ W_ss ∧
        AlgebraicGeometry.Etale e_0 ∧
        W_ss.ι ≫ g_ss = e_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_A) ∧
        (∀ φ : A_V →+* R_P, φ.comp c_A = ι_VP → ∃ h_V : A_V, h_V ≠ 0 ∧ φ h_V = 0) := by
    rcases hSS_base.2.2.2.2 u₀ with
      ⟨W_ss, e_0, hu₀_W, hEt_e0, he0_comm⟩ | ⟨W_ss, a_0, e_0, hu₀_W, ha_0, hEt_e0, he0_comm⟩
    · refine ⟨W_ss, Polynomial ↥V, inferInstance, inferInstance, Polynomial.C, e_0,
        hu₀_W, hEt_e0, he0_comm, ?_⟩
      intro φ hφC
      let r_0 : R_P := φ Polynomial.X
      obtain ⟨a_r, k, hr_eq⟩ := (hϖ_mem r_0.1).mp r_0.2
      have hr_RP : ι_VP (ϖ ^ k) * r_0 = ι_VP a_r := by
        apply Subtype.ext
        change V.subtype (ϖ ^ k) * r_0.1 = V.subtype a_r
        rw [map_pow, mul_comm, hr_eq]
      let h_V : Polynomial ↥V :=
        Polynomial.C (ϖ ^ k) * Polynomial.X - Polynomial.C a_r
      refine ⟨h_V, ?_, ?_⟩
      · intro hh0
        have hc1 : h_V.coeff 1 = 0 := by rw [hh0, Polynomial.coeff_zero]
        have hc1_eq : h_V.coeff 1 = ϖ ^ k := by
          simp only [h_V, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
            mul_one]
          have hc0 : (Polynomial.C a_r).coeff 1 = 0 := by simp
          rw [hc0, sub_zero]
        exact pow_ne_zero k hϖ_ne (hc1_eq ▸ hc1)
      · have hφ_c : ∀ v : ↥V, φ (Polynomial.C v) = ι_VP v :=
          fun v => RingHom.congr_fun hφC v
        simp only [h_V, map_sub, map_mul, hφ_c, sub_eq_zero]
        exact hr_RP
    · let I_0 : Ideal (MvPolynomial (Fin 2) ↥V) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_0}
      let A_nod := MvPolynomial (Fin 2) ↥V ⧸ I_0
      let q_0 : MvPolynomial (Fin 2) ↥V →+* A_nod := Ideal.Quotient.mk I_0
      let ev_L : MvPolynomial (Fin 2) ↥V →+* LaurentPolynomial ↥V :=
        MvPolynomial.eval₂Hom LaurentPolynomial.C
          ![LaurentPolynomial.T 1, LaurentPolynomial.C a_0 * LaurentPolynomial.T (-1)]
      have h_evL_ker : ∀ p ∈ I_0, ev_L p = 0 := by
        intro p hp
        rw [Ideal.mem_span_singleton] at hp
        rcases hp with ⟨r, rfl⟩
        have h_gen : ev_L (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_0) = 0 := by
          simp only [ev_L, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
            Matrix.cons_val_zero, Matrix.cons_val_one]
          rw [mul_left_comm (LaurentPolynomial.T 1), ← LaurentPolynomial.T_add,
            add_neg_cancel, LaurentPolynomial.T_zero, mul_one, sub_self]
        rw [map_mul, h_gen, zero_mul]
      let ev_Q : A_nod →+* LaurentPolynomial ↥V := Ideal.Quotient.lift I_0 ev_L h_evL_ker
      have hev_C : ∀ v : ↥V, ev_Q (q_0 (MvPolynomial.C v)) = LaurentPolynomial.C v :=
        fun v => MvPolynomial.eval₂Hom_C _ _ v
      have hev_X0 : ev_Q (q_0 (MvPolynomial.X 0)) = LaurentPolynomial.T 1 :=
        MvPolynomial.eval₂Hom_X' _ _ 0
      have hev_X1 :
          ev_Q (q_0 (MvPolynomial.X 1)) =
            LaurentPolynomial.C a_0 * LaurentPolynomial.T (-1) :=
        MvPolynomial.eval₂Hom_X' _ _ 1
      have h_rel : q_0 (MvPolynomial.X 0) * q_0 (MvPolynomial.X 1) = q_0 (MvPolynomial.C a_0) := by
        rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span rfl
      have h_rel_pow : ∀ n : ℕ,
          q_0 (MvPolynomial.C a_0) ^ n =
            q_0 (MvPolynomial.X 0) ^ n * q_0 (MvPolynomial.X 1) ^ n := by
        intro n
        rw [← h_rel, ← map_mul, ← map_pow, mul_pow, map_mul, map_pow, map_pow]
      let term : ℤ → ↥V → A_nod := fun k c =>
        if 0 ≤ k then q_0 (MvPolynomial.C c) * q_0 (MvPolynomial.X 0) ^ k.toNat
        else q_0 (MvPolynomial.C c) * q_0 (MvPolynomial.X 1) ^ (-k).toNat
      have hterm_zero : ∀ k : ℤ, term k 0 = 0 := by
        intro k; dsimp [term]; split_ifs <;> simp
      have hterm_add : ∀ (k : ℤ) (c₁ c₂ : ↥V), term k (c₁ + c₂) = term k c₁ + term k c₂ := by
        intro k c₁ c₂; dsimp [term]; split_ifs <;> simp [map_add, add_mul]
      let Φ : (ℤ →₀ ↥V) → A_nod := fun g => g.sum term
      have hΦ_add : ∀ g₁ g₂ : ℤ →₀ ↥V, Φ (g₁ + g₂) = Φ g₁ + Φ g₂ :=
        fun g₁ g₂ => Finsupp.sum_add_index' hterm_zero hterm_add
      have hΦ_surj : ∀ p : MvPolynomial (Fin 2) ↥V, ∃ g : ℤ →₀ ↥V, Φ g = q_0 p := by
        intro p
        refine MvPolynomial.induction_on' p (fun d c => ?_) (fun p₁ p₂ ⟨g₁, hg₁⟩ ⟨g₂, hg₂⟩ => ?_)
        · rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fin.prod_univ_two, ← mul_assoc]
          let k : ℤ := (d 0 : ℤ) - (d 1 : ℤ)
          by_cases hle : d 1 ≤ d 0
          · refine ⟨Finsupp.single k (c * a_0 ^ (d 1)), ?_⟩
            have hk_nonneg : 0 ≤ k := by omega
            have hk_nat : k.toNat = d 0 - d 1 := by omega
            have hd0 : d 0 = (d 0 - d 1) + d 1 := by omega
            change (Finsupp.single k (c * a_0 ^ d 1)).sum term = _
            rw [Finsupp.sum_single_index (hterm_zero k)]
            dsimp [term]
            rw [ite_eq_left_iff.mpr (fun h => absurd hk_nonneg h), hk_nat]
            conv_rhs => rw [hd0, pow_add]
            simp only [map_mul, map_pow]
            rw [h_rel_pow]
            ring
          · refine ⟨Finsupp.single k (c * a_0 ^ (d 0)), ?_⟩
            have hk_neg : ¬ 0 ≤ k := by omega
            have hk_nat : (-k).toNat = d 1 - d 0 := by omega
            have hd1 : d 1 = d 0 + (d 1 - d 0) := by omega
            change (Finsupp.single k (c * a_0 ^ d 0)).sum term = _
            rw [Finsupp.sum_single_index (hterm_zero k)]
            dsimp [term]
            rw [ite_eq_right_iff.mpr (fun h => absurd h hk_neg), hk_nat]
            conv_rhs => rw [hd1, pow_add]
            simp only [map_mul, map_pow]
            rw [h_rel_pow]
            ring
        · exact ⟨g₁ + g₂, by rw [hΦ_add, hg₁, hg₂, map_add]⟩
      have hev_term : ∀ (k : ℤ) (c : ↥V),
          ev_Q (term k c) =
            AddMonoidAlgebra.single k (if 0 ≤ k then c else c * a_0 ^ (-k).toNat) := by
        intro k c
        dsimp [term]
        split_ifs with hk
        · have hk_eq : (k.toNat : ℤ) * 1 = k := by omega
          rw [map_mul, map_pow, hev_C, hev_X0, LaurentPolynomial.T_pow, hk_eq,
            ← LaurentPolynomial.single_eq_C_mul_T]
        · have hk_eq : ((-k).toNat : ℤ) * (-1) = k := by omega
          rw [map_mul, map_pow, hev_C, hev_X1, mul_pow, ← mul_assoc, ← map_pow, ← map_mul,
            LaurentPolynomial.T_pow, hk_eq, ← LaurentPolynomial.single_eq_C_mul_T]
      have hev_inj : Function.Injective ev_Q := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro x hx
        rw [RingHom.mem_ker] at hx
        rcases Ideal.Quotient.mk_surjective x with ⟨p, rfl⟩
        obtain ⟨g, hg⟩ := hΦ_surj p
        rw [← hg] at hx ⊢
        have hg_zero : g = 0 := by
          refine Finsupp.ext fun k => ?_
          rw [Finsupp.coe_zero, Pi.zero_apply]
          have hsum_eq : ev_Q (Φ g) =
              ∑ m ∈ g.support,
                AddMonoidAlgebra.single m
                  (if 0 ≤ m then g m else g m * a_0 ^ (-m).toNat) := by
            change ev_Q (∑ m ∈ g.support, term m (g m)) = _
            rw [map_sum]
            exact Finset.sum_congr rfl (fun m _ => hev_term m (g m))
          rw [hx] at hsum_eq
          have hcoeff_sum : ∀ (S : Finset ℤ) (F : ℤ → LaurentPolynomial ↥V) (n : ℤ),
              AddMonoidAlgebra.coeff (∑ m ∈ S, F m) n =
                ∑ m ∈ S, AddMonoidAlgebra.coeff (F m) n := by
            intro S F n
            induction S using Finset.induction_on with
            | empty => simp
            | insert a s ha ih =>
              rw [Finset.sum_insert ha, Finset.sum_insert ha, ← ih]
              simp
          have hk_coeff : (0 : ↥V) =
              ∑ m ∈ g.support,
                Finsupp.single m
                  (if 0 ≤ m then g m else g m * a_0 ^ (-m).toNat) k := by
            have h0 := congrArg (fun f : LaurentPolynomial ↥V => AddMonoidAlgebra.coeff f k) hsum_eq
            rw [AddMonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply,
              hcoeff_sum] at h0
            exact h0
          by_cases hk_mem : k ∈ g.support
          · rw [Finset.sum_eq_single k
              (fun m _ hmk => Finsupp.single_eq_of_ne hmk.symm)
              (fun hnot => absurd hk_mem hnot),
              Finsupp.single_eq_same] at hk_coeff
            split_ifs at hk_coeff with hk0
            · exact hk_coeff.symm
            · exact (mul_eq_zero.mp hk_coeff.symm).resolve_right (pow_ne_zero _ ha_0)
          · exact Finsupp.notMem_support_iff.mp hk_mem
        rw [hg_zero]
        exact Finsupp.sum_zero_index
      have hDom_nod : IsDomain A_nod := Function.Injective.isDomain ev_Q hev_inj
      refine ⟨W_ss, A_nod, inferInstance, hDom_nod, q_0.comp MvPolynomial.C, e_0,
        hu₀_W, hEt_e0, he0_comm, ?_⟩
      intro φ hφC
      let r_0 : R_P := φ (q_0 (MvPolynomial.X 0))
      obtain ⟨a_r, k, hr_eq⟩ := (hϖ_mem r_0.1).mp r_0.2
      have hr_RP : ι_VP (ϖ ^ k) * r_0 = ι_VP a_r := by
        apply Subtype.ext
        change V.subtype (ϖ ^ k) * r_0.1 = V.subtype a_r
        rw [map_pow, mul_comm, hr_eq]
      let h_V : A_nod :=
        q_0 (MvPolynomial.C (ϖ ^ k) * MvPolynomial.X 0 - MvPolynomial.C a_r)
      refine ⟨h_V, ?_, ?_⟩
      · intro hh0
        have hev_h : ev_Q h_V = 0 := by rw [hh0, map_zero]
        have hev_calc : ev_Q h_V =
            AddMonoidAlgebra.single (1 : ℤ) (ϖ ^ k) -
