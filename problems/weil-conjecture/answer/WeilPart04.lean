          (PrimeSpectrum.asIdeal '' {p : PrimeSpectrum (Polynomial κ) | f_a ∈ p.asIdeal}).Finite :=
        S_fac.finite_toSet.subset h_sub_img
      exact Set.Finite.of_finite_image h_fin_ideals (fun p₁ _ p₂ _ h12 => PrimeSpectrum.ext h12)
    exact h_chart_fin 0 |>.union (h_chart_fin 1)
  
