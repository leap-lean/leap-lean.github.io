          (p.isPrime.multiset_prod_mem_iff_exists_mem _).mp h_prod_mem
        have hg_irr : Irreducible g := UniqueFactorizationMonoid.irreducible_of_factor g hg_mem
        have hg_max : (Ideal.span ({g} : Set (Polynomial κ))).IsMaximal :=
          PrincipalIdealRing.isMaximal_of_irreducible hg_irr
        have h_span_eq : Ideal.span ({g} : Set (Polynomial κ)) = p.asIdeal :=
