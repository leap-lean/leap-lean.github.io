        let q11 : ProjectiveSpectrum 𝒜 := ⟨J11, RingHom.ker_isPrime ev11, hNotIrrel11⟩
        exact ⟨q11, (ProjectiveSpectrum.mem_basicOpen 𝒜 _ q11).mpr hX0,
          (ProjectiveSpectrum.mem_basicOpen 𝒜 _ q11).mpr hX1⟩
      have hIrred_chart : ∀ a : Fin 2,
          IsIrreducible (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) : Set ↥P_F) := by
        intro a
        rw [← hj_range a, ← Set.image_univ]
        have hIrredSpec : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
          inferInstance
        exact ⟨⟨(j_a a).base ⟨⊥, inferInstance⟩, ⟨⟨⊥, inferInstance⟩, trivial, rfl⟩⟩,
          hIrredSpec.isPreirreducible_univ.image (j_a a).base (j_a a).continuous.continuousOn⟩
      have hIrredPF : IrreducibleSpace ↥P_F := by
        obtain ⟨q_ov, hq0, hq1⟩ := hOverlap_ne
        refine { toNonempty := ⟨q_ov⟩, isPreirreducible_univ := ?_ }
        intro O₁ O₂ hO₁ hO₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
        let U₀ := (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥P_F)
        let U₁ := (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) : Set ↥P_F)
        have hU₀_open : IsOpen U₀ := (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)).isOpen
        have hU₁_open : IsOpen U₁ := (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)).isOpen
        have hit_U₀ : ∀ O : Set ↥P_F, IsOpen O → O.Nonempty → (U₀ ∩ O).Nonempty := by
