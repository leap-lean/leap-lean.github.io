    let _ : Fintype I := Fintype.ofFinite I
    have h_sum_one : (∑ i : I, Pi.single i (1 : ↥W)) = (1 : I → ↥W) := by
      ext j
      simp
    have h_not_all : ¬ ∀ i : I, Pi.single i (1 : ↥W) ∈ 𝔓 := by
      intro hall
      have h1 : (1 : I → ↥W) ∈ 𝔓 := by
