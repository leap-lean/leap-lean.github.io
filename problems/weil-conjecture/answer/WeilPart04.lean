          intro x hx
          show ψ_BD x ∈ A_sub
          exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem ψ_BD hx))
        rw [hFB] at hle
        intro x
        have hxB : x ∈ B_sub := hle (Algebra.mem_top : x ∈ (⊤ : Subalgebra ↥V_P B₁))
