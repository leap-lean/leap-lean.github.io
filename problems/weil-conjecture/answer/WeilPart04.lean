        rw [mul_comm (ι_K b), mul_assoc, inv_mul_cancel₀ hιb_ne, mul_one]
      exact ⟨ι_K, hφ_ξ_inj, hι_V, hK_mW, hK_W, ⟨g_W, hg_mem, hg_unit, hg_trans⟩, hValEq⟩
