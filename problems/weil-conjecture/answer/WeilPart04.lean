        exact hEtaleComp hEt_jL (RingHom.Etale.of_bijective hBij_fwd)
      let f_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_base A))
      have hf_A_eq : f_A = hV.fromSpec ≫ g_R := hComm
      let m_0 : CategoryTheory.Limits.pullback f_A s₀ ⟶ T₀ :=
