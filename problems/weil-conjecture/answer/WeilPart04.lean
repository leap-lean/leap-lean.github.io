      intro j
      rw [← hQ_comap_π₀, Ideal.mem_comap, hq_gen_mk j]
      exact hw_mem_WQ j
    have hClear_qgen : ∀ j : Fin r_Q, ∃ L : ℕ, t₁ ^ L * (y₀ * q_gen j) ∈ I₀ := by
      intro j
      obtain ⟨L, w, hw, hLw⟩ := hClear_Ifib (y₀ * q_gen j).1 (hy₀_ann_S (q_gen j) (hq_gen_mem j))
      refine ⟨L, ?_⟩
      have heq : t₁ ^ L * (y₀ * q_gen j) = w := Subtype.ext hLw
      rw [heq]
      exact hw
    let L_fn : Fin r_Q → ℕ := fun j => (hClear_qgen j).choose
    have hL_fn : ∀ j : Fin r_Q, t₁ ^ L_fn j * (y₀ * q_gen j) ∈ I₀ :=
      fun j => (hClear_qgen j).choose_spec
    let L_max : ℕ := Finset.univ.sup L_fn
    let c₀ : ↥R₀ := t₁ ^ L_max * y₀
    have ht₁_notQ : t₁ ∉ Q := ht₁_notP
    have hc₀_notQ : c₀ ∉ Q :=
      hQ_prime.mul_notMem (hpow_notMem hQ_prime L_max ht₁_notQ) hy₀_notQ
    have hc₀_wbar : ∀ j : Fin r_Q, π₀ c₀ * w_bar j = 0 := by
      intro j
      rw [← hq_gen_mk j, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      have hle : L_fn j ≤ L_max := Finset.le_sup (Finset.mem_univ j)
      have hexp : (L_max - L_fn j) + L_fn j = L_max := Nat.sub_add_cancel hle
      have heq : c₀ * q_gen j = t₁ ^ (L_max - L_fn j) * (t₁ ^ L_fn j * (y₀ * q_gen j)) := by
        calc
          c₀ * q_gen j = t₁ ^ ((L_max - L_fn j) + L_fn j) * y₀ * q_gen j := by
                dsimp only [c₀]; rw [hexp]
          _ = t₁ ^ (L_max - L_fn j) * (t₁ ^ L_fn j * (y₀ * q_gen j)) := by
                rw [pow_add]; ring
      rw [heq]
      exact I₀.mul_mem_left _ (hL_fn j)
    have hc₀_WQ : ∀ z ∈ W_Q, π₀ c₀ * z = 0 := by
      intro z hz
      rw [← hw_span] at hz
      refine @Submodule.span_induction ((A₀ ⧸ q) ⧸ m_R) (↥R₀ ⧸ I₀) _ _ _
        (Set.range w_bar) (fun z _ => π₀ c₀ * z = 0) ?_ ?_ ?_ ?_ z hz
      · rintro _ ⟨j, rfl⟩
        exact hc₀_wbar j
      · exact mul_zero _
      · intro z₁ z₂ _ _ hz₁ hz₂
        rw [mul_add, hz₁, hz₂, add_zero]
      · intro k z₁ _ hz₁
        rw [@Algebra.smul_def ((A₀ ⧸ q) ⧸ m_R) (↥R₀ ⧸ I₀) _ _ _ k z₁,
          ← mul_assoc, mul_comm (π₀ c₀), mul_assoc, hz₁, mul_zero]
    have hc₀_ann : ∀ q' ∈ Q, c₀ * q' ∈ I₀ := by
      intro q' hq'
      rw [← hker_π₀, RingHom.mem_ker, map_mul]
      exact hc₀_WQ (π₀ q') (Ideal.mem_map_of_mem π₀ hq')
    obtain ⟨r₀, hr₀_Q⟩ := hRes_A c₀
    have hr₀_notm : r₀ ∉ m_R := by
      rw [← hQ_comap, Ideal.mem_comap]
      intro hr₀Q
      apply hc₀_notQ
      have heq : c₀ = (c₀ - algebraMap (A₀ ⧸ q) ↥R₀ r₀) + algebraMap (A₀ ⧸ q) ↥R₀ r₀ :=
        (sub_add_cancel _ _).symm
      rw [heq]
      exact Q.add_mem hr₀_Q hr₀Q
    obtain ⟨u₀, hu₀⟩ := IsLocalRing.notMem_maximalIdeal.mp hr₀_notm
    let m₀ : ↥R₀ := algebraMap (A₀ ⧸ q) ↥R₀ (↑u₀⁻¹ : A₀ ⧸ q) * c₀
    have hm₀_Q : 1 - m₀ ∈ Q := by
      have hu₀_inv : (↑u₀⁻¹ : A₀ ⧸ q) * r₀ = 1 := by rw [← hu₀]; exact Units.inv_mul u₀
      have heq : 1 - m₀ =
          algebraMap (A₀ ⧸ q) ↥R₀ (↑u₀⁻¹ : A₀ ⧸ q) * (algebraMap (A₀ ⧸ q) ↥R₀ r₀ - c₀) := by
        dsimp only [m₀]
        rw [mul_sub, ← map_mul, hu₀_inv, map_one]
      rw [heq]
      exact Q.mul_mem_left _ (by simpa only [neg_sub] using Q.neg_mem hr₀_Q)
    have hm₀_ann : ∀ q' ∈ Q, m₀ * q' ∈ I₀ := by
      intro q' hq'
      dsimp only [m₀]
      rw [mul_assoc]
      exact I₀.mul_mem_left _ (hc₀_ann q' hq')
    exact ⟨R₀, hFin_R₀, t₁, m₀, ht₁_notP, ht₁_sat, hm₀_Q, hm₀_ann⟩
  obtain ⟨R₀, hFin_R₀, t₁, m₀, ht₁_notP, ht₁_sat, hm₀_Q, hm₀_ann⟩ := hStep2
  haveI : Module.Finite (A₀ ⧸ q) ↥R₀ := hFin_R₀
  let Q : Ideal ↥R₀ := Ideal.comap R₀.val.toRingHom P
  haveI hQ_prime : Q.IsPrime := Ideal.comap_isPrime R₀.val.toRingHom P
  have hQ_comap : Ideal.comap (algebraMap (A₀ ⧸ q) ↥R₀) Q = IsLocalRing.maximalIdeal (A₀ ⧸ q) := by
    rw [← hP_comap_φ]; rfl
  have hRes_A : ∀ x : ↥R₀, ∃ r : A₀ ⧸ q, x - algebraMap (A₀ ⧸ q) ↥R₀ r ∈ Q := by
    intro x
    obtain ⟨r, hr⟩ := hRes_P x.1
    exact ⟨r, hr⟩
  
  have hStep3 : ∃ (e : ↥R₀),
      e * e = e ∧
      e ∉ Q ∧
      (∀ x : ↥R₀, ∃ c : A₀ ⧸ q, e * x = algebraMap (A₀ ⧸ q) ↥R₀ c * e) := by
    let m_R : Ideal (A₀ ⧸ q) := IsLocalRing.maximalIdeal (A₀ ⧸ q)
    let I₀ : Ideal ↥R₀ := Ideal.map (algebraMap (A₀ ⧸ q) ↥R₀) m_R
    have hI₀_smul : ∀ z ∈ I₀, z ∈ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) := by
      intro z hz
      change z ∈ Submodule.span ↥R₀ (algebraMap (A₀ ⧸ q) ↥R₀ '' (m_R : Set (A₀ ⧸ q))) at hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨μ, hμ, rfl⟩
        have heq : algebraMap (A₀ ⧸ q) ↥R₀ μ = μ • (1 : ↥R₀) := by rw [Algebra.smul_def, mul_one]
        rw [heq]
        exact Submodule.smul_mem_smul hμ trivial
      · exact (m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀)).zero_mem
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact (m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀)).add_mem hz₁ hz₂
      · intro a z₁ _ hz₁
        rw [smul_eq_mul]
        refine Submodule.smul_induction_on hz₁ ?_ ?_
        · intro μ hμ u _
          rw [mul_smul_comm]
          exact Submodule.smul_mem_smul hμ trivial
        · intro u₁ u₂ hu₁ hu₂
          rw [mul_add]
          exact (m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀)).add_mem hu₁ hu₂
    obtain ⟨d, y_gen, hy_span⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp
        (Module.Finite.fg_top : (⊤ : Submodule (A₀ ⧸ q) ↥R₀).FG)
    let v : Fin (d + 1) → ↥R₀ := Fin.cons m₀ (fun j : Fin d => (1 - m₀) * y_gen j)
    let S_v : Submodule (A₀ ⧸ q) ↥R₀ := Submodule.span (A₀ ⧸ q) (Set.range v)
    have h1m₀_Sv : ∀ x : ↥R₀, (1 - m₀) * x ∈ S_v := by
      intro x
      have hx_top : x ∈ Submodule.span (A₀ ⧸ q) (Set.range y_gen) := by rw [hy_span]; trivial
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx_top
      · rintro _ ⟨j, rfl⟩
        exact Submodule.subset_span ⟨j.succ, rfl⟩
      · simp only [mul_zero, Submodule.zero_mem]
      · intro x₁ x₂ _ _ hx₁ hx₂
        rw [mul_add]
        exact S_v.add_mem hx₁ hx₂
      · intro r x₁ _ hx₁
        rw [mul_smul_comm]
        exact S_v.smul_mem r hx₁
    have htop_le_sup :
        (⊤ : Submodule (A₀ ⧸ q) ↥R₀) ≤ S_v ⊔ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) := by
      intro x _
      obtain ⟨r_x, hr_x⟩ := hRes_A x
      have hm₀_rx : r_x • v 0 ∈ S_v := S_v.smul_mem r_x (Submodule.subset_span ⟨0, rfl⟩)
      have hm₀_diff : m₀ * (x - algebraMap (A₀ ⧸ q) ↥R₀ r_x) ∈
          m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) :=
        hI₀_smul _ (hm₀_ann _ hr_x)
      have hm₀_x : m₀ * x ∈ S_v ⊔ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) := by
        have heq : m₀ * x = r_x • v 0 + m₀ * (x - algebraMap (A₀ ⧸ q) ↥R₀ r_x) := by
          change m₀ * x = r_x • m₀ + m₀ * (x - algebraMap (A₀ ⧸ q) ↥R₀ r_x)
          rw [Algebra.smul_def]
          ring
        rw [heq]
        exact Submodule.add_mem_sup hm₀_rx hm₀_diff
      have h1m₀_x : (1 - m₀) * x ∈ S_v ⊔ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) :=
        Submodule.mem_sup_left (h1m₀_Sv x)
      have hx_eq : x = m₀ * x + (1 - m₀) * x := by ring
      rw [hx_eq]
      exact (S_v ⊔ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀)).add_mem hm₀_x h1m₀_x
    have htop_le_Sv : (⊤ : Submodule (A₀ ⧸ q) ↥R₀) ≤ S_v :=
      Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
        (IsLocalRing.maximalIdeal_le_jacobson ⊥) htop_le_sup
    have hv_coords : ∀ u : ↥R₀, ∃ c : Fin (d + 1) → A₀ ⧸ q, u = ∑ j : Fin (d + 1), c j • v j := by
      intro u
      have hu : u ∈ S_v := htop_le_Sv trivial
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hu
      · rintro _ ⟨j₀, rfl⟩
        refine ⟨Pi.single j₀ 1, ?_⟩
        rw [Finset.sum_eq_single j₀]
        · simp only [Pi.single_eq_same, one_smul]
        · intro j _ hj
          simp only [Pi.single_eq_of_ne hj, zero_smul]
        · intro hj
          exact False.elim (hj (Finset.mem_univ j₀))
      · exact ⟨0, by simp⟩
      · rintro u₁ u₂ _ _ ⟨c₁, rfl⟩ ⟨c₂, rfl⟩
        refine ⟨c₁ + c₂, ?_⟩
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      · rintro r u₁ _ ⟨c₁, rfl⟩
        refine ⟨r • c₁, ?_⟩
        simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum]
    have hm_coords : ∀ z ∈ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀),
        ∃ μ : Fin (d + 1) → A₀ ⧸ q, (∀ j, μ j ∈ m_R) ∧ z = ∑ j : Fin (d + 1), μ j • v j := by
      intro z hz
      refine Submodule.smul_induction_on hz ?_ ?_
      · intro μ₀ hμ₀ u _
        obtain ⟨c, rfl⟩ := hv_coords u
        refine ⟨fun j => μ₀ * c j, fun j => m_R.mul_mem_right (c j) hμ₀, ?_⟩
        simp only [mul_smul, Finset.smul_sum]
      · rintro z₁ z₂ ⟨μ₁, hμ₁, rfl⟩ ⟨μ₂, hμ₂, rfl⟩
        refine ⟨fun j => μ₁ j + μ₂ j, fun j => m_R.add_mem (hμ₁ j) (hμ₂ j), ?_⟩
        simp only [add_smul, Finset.sum_add_distrib]
    have hv_step_mem : ∀ i : Fin (d + 1),
        m₀ * v i - (if i = 0 then v 0 else 0) ∈ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) := by
      intro i
      apply hI₀_smul
      refine Fin.cases ?_ ?_ i
      · simp only [↓reduceIte, Fin.cons_zero, v]
        have heq : m₀ * m₀ - m₀ = -(m₀ * (1 - m₀)) := by ring
        rw [heq]
        exact I₀.neg_mem (hm₀_ann (1 - m₀) hm₀_Q)
      · intro j
        simp only [Fin.succ_ne_zero, ↓reduceIte, sub_zero, Fin.cons_succ, v]
        exact hm₀_ann ((1 - m₀) * y_gen j) (Q.mul_mem_right (y_gen j) hm₀_Q)
    let d_mat : Fin (d + 1) → Fin (d + 1) → A₀ ⧸ q := fun i => (hm_coords _ (hv_step_mem i)).choose
    have hd_mem : ∀ i j : Fin (d + 1), d_mat i j ∈ m_R :=
      fun i => (hm_coords _ (hv_step_mem i)).choose_spec.1
    have hd_eq : ∀ i : Fin (d + 1),
        m₀ * v i - (if i = 0 then v 0 else 0) = ∑ j : Fin (d + 1), d_mat i j • v j :=
      fun i => (hm_coords _ (hv_step_mem i)).choose_spec.2
    let M : Matrix (Fin (d + 1)) (Fin (d + 1)) (A₀ ⧸ q) :=
      Matrix.of fun i j => (if i = 0 ∧ j = 0 then (1 : A₀ ⧸ q) else 0) + d_mat i j
    have hM_mul_v : ∀ i : Fin (d + 1),
        m₀ * v i = ∑ j : Fin (d + 1), algebraMap (A₀ ⧸ q) ↥R₀ (M i j) * v j := by
      intro i
      have hdiag_sum : (∑ j : Fin (d + 1),
          (if i = 0 ∧ j = 0 then (1 : A₀ ⧸ q) else 0) • v j) =
            (if i = 0 then v 0 else 0) := by
        rw [Finset.sum_eq_single 0]
        · by_cases hi : i = 0 <;> simp [hi]
        · intro j _ hj
          simp [hj]
        · intro h0
          exact False.elim (h0 (Finset.mem_univ 0))
      calc
        m₀ * v i = (if i = 0 then v 0 else 0) + (m₀ * v i - (if i = 0 then v 0 else 0)) := by ring
        _ = (∑ j : Fin (d + 1), (if i = 0 ∧ j = 0 then (1 : A₀ ⧸ q) else 0) • v j) +
              ∑ j : Fin (d + 1), d_mat i j • v j := by rw [hdiag_sum, hd_eq i]
        _ = ∑ j : Fin (d + 1), M i j • v j := by
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl fun j _ => ?_
              simp only [M, Matrix.of_apply, add_smul]
        _ = ∑ j : Fin (d + 1), algebraMap (A₀ ⧸ q) ↥R₀ (M i j) * v j := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Algebra.smul_def]
    let ev_m₀ : Polynomial (A₀ ⧸ q) →+* ↥R₀ := (Polynomial.aeval m₀).toRingHom
    let B_mat : Matrix (Fin (d + 1)) (Fin (d + 1)) ↥R₀ := ev_m₀.mapMatrix M.charmatrix
    have hB_mulVec : B_mat.mulVec v = 0 := by
      ext i
      simp only [Matrix.mulVec, dotProduct, Pi.zero_apply, B_mat, RingHom.mapMatrix_apply,
        Matrix.map_apply, Matrix.charmatrix_apply, map_sub]
      have hev_C : ∀ r : A₀ ⧸ q, ev_m₀ (Polynomial.C r) = algebraMap (A₀ ⧸ q) ↥R₀ r :=
        fun r => Polynomial.aeval_C m₀ r
      have hev_diag : ∀ j : Fin (d + 1),
          ev_m₀ (Matrix.diagonal (fun _ : Fin (d + 1) => (Polynomial.X : Polynomial (A₀ ⧸ q))) i j) =
            if i = j then m₀ else 0 := by
        intro j
        by_cases hij : i = j
        · subst hij
          rw [Matrix.diagonal_apply_eq, if_pos rfl]
          exact Polynomial.aeval_X m₀
        · rw [Matrix.diagonal_apply_ne _ hij, if_neg hij, map_zero]
      simp_rw [hev_diag, hev_C, sub_mul, Finset.sum_sub_distrib, ← hM_mul_v i]
      have hsum_m₀ : (∑ j : Fin (d + 1), (if i = j then m₀ else 0) * v j) = m₀ * v i := by
        rw [Finset.sum_eq_single i]
        · simp
        · intro j _ hij
          simp [hij.symm]
        · intro hi
          exact False.elim (hi (Finset.mem_univ i))
      rw [hsum_m₀, sub_self]
    have hB_det_v : ∀ j : Fin (d + 1), B_mat.det * v j = 0 := by
      intro j
      have h1 : ((B_mat.adjugate * B_mat).mulVec v) j = 0 := by
        rw [← Matrix.mulVec_mulVec, hB_mulVec, Matrix.mulVec_zero, Pi.zero_apply]
      rw [Matrix.adjugate_mul] at h1
      simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, Matrix.one_apply,
        smul_eq_mul] at h1
      rw [Finset.sum_eq_single j] at h1
      · simpa using h1
      · intro k _ hkj
        simp [hkj.symm]
      · intro hj
        exact False.elim (hj (Finset.mem_univ j))
    have hB_det : B_mat.det = 0 := by
      obtain ⟨c₁, hc₁⟩ := hv_coords 1
      calc
        B_mat.det = B_mat.det * 1 := (mul_one _).symm
        _ = B_mat.det * ∑ j : Fin (d + 1), c₁ j • v j := by rw [← hc₁]
        _ = ∑ j : Fin (d + 1), c₁ j • (B_mat.det * v j) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [mul_smul_comm]
        _ = 0 := by simp [hB_det_v]
    let χ : Polynomial (A₀ ⧸ q) := M.charpoly
    have hχ_m₀ : Polynomial.aeval m₀ χ = 0 := by
      change ev_m₀ M.charmatrix.det = 0
      rw [RingHom.map_det, hB_det]
    let res : (A₀ ⧸ q) →+* IsLocalRing.ResidueField (A₀ ⧸ q) := IsLocalRing.residue (A₀ ⧸ q)
    have hM_res : M.map res =
        Matrix.diagonal (Fin.cons (1 : IsLocalRing.ResidueField (A₀ ⧸ q))
          (fun _ : Fin d => (0 : IsLocalRing.ResidueField (A₀ ⧸ q)))) := by
      ext i j
      have hd0 : res (d_mat i j) = 0 :=
        (IsLocalRing.residue_eq_zero_iff (d_mat i j)).mpr (hd_mem i j)
      simp only [Matrix.map_apply, M, Matrix.of_apply, map_add, hd0, add_zero]
      by_cases hij : i = j
      · subst hij
        refine Fin.cases ?_ ?_ i
        · simp
        · intro k
          simp [Fin.succ_ne_zero]
      · rw [Matrix.diagonal_apply_ne _ hij]
        have hnot : ¬ (i = 0 ∧ j = 0) := fun ⟨hi, hj⟩ => hij (hi.trans hj.symm)
        simp [hnot]
    have hχ_res : Polynomial.map res χ = (Polynomial.X - 1) * Polynomial.X ^ d := by
      dsimp only [χ]
      rw [← Matrix.charpoly_map, hM_res, Matrix.charpoly_diagonal, Fin.prod_univ_succ]
      simp
    have hχ_eval1_mem : χ.eval 1 ∈ m_R := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      change res (χ.eval 1) = 0
      rw [← Polynomial.eval_map_apply, map_one, hχ_res]
      simp
    have hχ_deriv_res : ∀ x : IsLocalRing.ResidueField (A₀ ⧸ q),
        ((Polynomial.map res χ).derivative).eval x =
          x ^ d + (x - 1) *
            ((Polynomial.X ^ d : Polynomial (IsLocalRing.ResidueField (A₀ ⧸ q))).derivative.eval x) := by
      intro x
      rw [hχ_res, Polynomial.derivative_mul, Polynomial.derivative_sub,
        Polynomial.derivative_X, Polynomial.derivative_one, sub_zero, one_mul]
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_one]
    have hχ_deriv1_unit : IsUnit (χ.derivative.eval 1) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff]
      change res (χ.derivative.eval 1) ≠ 0
      rw [← Polynomial.eval_map_apply, ← Polynomial.derivative_map, map_one, hχ_deriv_res 1]
      simp
    obtain ⟨a_rt, ha_rt_root, ha_rt_mem⟩ :=
      HenselianLocalRing.is_henselian χ M.charpoly_monic 1 hχ_eval1_mem hχ_deriv1_unit
    have ha_rt_res : res a_rt = 1 := by
      have h0 : res (a_rt - 1) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr ha_rt_mem
      rw [map_sub, map_one, sub_eq_zero] at h0
      exact h0
    have ha_rt_unit : IsUnit a_rt := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff]
      change res a_rt ≠ 0
      rw [ha_rt_res]
      exact one_ne_zero
    obtain ⟨u_rt, hu_rt⟩ := ha_rt_unit
    obtain ⟨Q_χ, hχ_fac⟩ := Polynomial.dvd_iff_isRoot.mpr ha_rt_root
    have hQχ_deriv : Q_χ.eval a_rt = χ.derivative.eval a_rt := by
      have hd := congrArg Polynomial.derivative hχ_fac
      rw [Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X,
        Polynomial.derivative_C, sub_zero, one_mul] at hd
      have hev := congrArg (Polynomial.eval a_rt) hd
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul, add_zero] at hev
      exact hev.symm
    have hQχ_unit : IsUnit (Q_χ.eval a_rt) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff]
      change res (Q_χ.eval a_rt) ≠ 0
      rw [hQχ_deriv, ← Polynomial.eval_map_apply, ← Polynomial.derivative_map,
        ha_rt_res, hχ_deriv_res 1]
      simp
    obtain ⟨u_Q, hu_Q⟩ := hQχ_unit
    let e : ↥R₀ := algebraMap (A₀ ⧸ q) ↥R₀ (↑u_Q⁻¹ : A₀ ⧸ q) * Polynomial.aeval m₀ Q_χ
    have hm₀_e : m₀ * e = algebraMap (A₀ ⧸ q) ↥R₀ a_rt * e := by
      have hsub : (m₀ - algebraMap (A₀ ⧸ q) ↥R₀ a_rt) * e = 0 := by
        dsimp only [e]
        calc
          (m₀ - algebraMap (A₀ ⧸ q) ↥R₀ a_rt) *
              (algebraMap (A₀ ⧸ q) ↥R₀ (↑u_Q⁻¹ : A₀ ⧸ q) * Polynomial.aeval m₀ Q_χ)
              = algebraMap (A₀ ⧸ q) ↥R₀ (↑u_Q⁻¹ : A₀ ⧸ q) *
                  ((m₀ - algebraMap (A₀ ⧸ q) ↥R₀ a_rt) * Polynomial.aeval m₀ Q_χ) := by ring
          _ = algebraMap (A₀ ⧸ q) ↥R₀ (↑u_Q⁻¹ : A₀ ⧸ q) * Polynomial.aeval m₀ χ := by
                congr 1
                rw [hχ_fac, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
          _ = 0 := by rw [hχ_m₀, mul_zero]
      rwa [sub_mul, sub_eq_zero] at hsub
    have hpow_e : ∀ n : ℕ, m₀ ^ n * e = (algebraMap (A₀ ⧸ q) ↥R₀ a_rt) ^ n * e := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        calc
          m₀ ^ (n + 1) * e = m₀ * (m₀ ^ n * e) := by rw [pow_succ']; ring
          _ = m₀ * ((algebraMap (A₀ ⧸ q) ↥R₀ a_rt) ^ n * e) := by rw [ih]
          _ = (algebraMap (A₀ ⧸ q) ↥R₀ a_rt) ^ n * (m₀ * e) := by ring
          _ = (algebraMap (A₀ ⧸ q) ↥R₀ a_rt) ^ n *
                (algebraMap (A₀ ⧸ q) ↥R₀ a_rt * e) := by rw [hm₀_e]
          _ = (algebraMap (A₀ ⧸ q) ↥R₀ a_rt) ^ (n + 1) * e := by rw [pow_succ']; ring
    have hpoly_e : ∀ P_poly : Polynomial (A₀ ⧸ q),
        (Polynomial.aeval m₀ P_poly) * e = algebraMap (A₀ ⧸ q) ↥R₀ (P_poly.eval a_rt) * e := by
      intro P_poly
      induction P_poly using Polynomial.induction_on' with
      | add p₁ p₂ hp₁ hp₂ =>
        rw [map_add, add_mul, hp₁, hp₂, Polynomial.eval_add, map_add, add_mul]
      | monomial n r =>
        rw [Polynomial.aeval_monomial, Polynomial.eval_monomial, map_mul, map_pow, mul_assoc,
          hpow_e n, ← mul_assoc]
    have he_idem : e * e = e := by
      calc
        e * e = algebraMap (A₀ ⧸ q) ↥R₀ (↑u_Q⁻¹ : A₀ ⧸ q) *
              ((Polynomial.aeval m₀ Q_χ) * e) := by
              dsimp only [e]; ring
        _ = algebraMap (A₀ ⧸ q) ↥R₀ (↑u_Q⁻¹ : A₀ ⧸ q) *
              (algebraMap (A₀ ⧸ q) ↥R₀ (Q_χ.eval a_rt) * e) := by
              rw [hpoly_e Q_χ]
        _ = algebraMap (A₀ ⧸ q) ↥R₀ ((↑u_Q⁻¹ : A₀ ⧸ q) * ↑u_Q) * e := by
              rw [← hu_Q, ← mul_assoc, ← map_mul]
        _ = e := by rw [Units.inv_mul, map_one, one_mul]
    have he_notQ : e ∉ Q := by
      let π_Q : ↥R₀ →+* (↥R₀ ⧸ Q) := Ideal.Quotient.mk Q
      have h1_ne_0 : (1 : ↥R₀ ⧸ Q) ≠ 0 := by
        intro h10
        exact hQ_prime.ne_top (Ideal.eq_top_of_isUnit_mem Q
          (Ideal.Quotient.eq_zero_iff_mem.mp h10) isUnit_one)
      intro heQ
      have hπ_e_zero : π_Q e = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr heQ
      have hπ_m₀ : π_Q m₀ = 1 := by
        have h0 : π_Q (1 - m₀) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hm₀_Q
        rw [RingHom.map_sub, RingHom.map_one, sub_eq_zero] at h0
        exact h0.symm
      have hπ_art : π_Q (algebraMap (A₀ ⧸ q) ↥R₀ a_rt) = 1 := by
        have ha_Q : algebraMap (A₀ ⧸ q) ↥R₀ a_rt - 1 ∈ Q := by
          rw [← map_one (algebraMap (A₀ ⧸ q) ↥R₀), ← map_sub]
          have hmem : a_rt - 1 ∈ Ideal.comap (algebraMap (A₀ ⧸ q) ↥R₀) Q := by
            rw [hQ_comap]; exact ha_rt_mem
          exact hmem
        have h0 : π_Q (algebraMap (A₀ ⧸ q) ↥R₀ a_rt - 1) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr ha_Q
        rw [RingHom.map_sub, RingHom.map_one, sub_eq_zero] at h0
        exact h0
      have hπ_Qχ : π_Q (Polynomial.aeval m₀ Q_χ) =
          π_Q (algebraMap (A₀ ⧸ q) ↥R₀ (Q_χ.eval a_rt)) := by
        change π_Q (Polynomial.eval₂ (algebraMap (A₀ ⧸ q) ↥R₀) m₀ Q_χ) =
          (π_Q.comp (algebraMap (A₀ ⧸ q) ↥R₀))
            (Polynomial.eval₂ (RingHom.id (A₀ ⧸ q)) a_rt Q_χ)
        rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂, RingHom.comp_id, hπ_m₀,
          RingHom.comp_apply, hπ_art]
      have hπ_e_one : π_Q e = 1 := by
        dsimp only [e]
        rw [RingHom.map_mul, hπ_Qχ, ← RingHom.map_mul, ← map_mul, ← hu_Q,
          Units.inv_mul, map_one, RingHom.map_one]
      exact h1_ne_0 (hπ_e_one.symm.trans hπ_e_zero)
    let M_e : Submodule (A₀ ⧸ q) ↥R₀ := Submodule.map (LinearMap.mulLeft (A₀ ⧸ q) e) ⊤
    have hMe_fg : M_e.FG := Module.Finite.fg_top.map (LinearMap.mulLeft (A₀ ⧸ q) e)
    have he_smul_Me : ∀ z ∈ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀), e * z ∈ m_R • M_e := by
      intro z hz
      refine Submodule.smul_induction_on hz ?_ ?_
      · intro μ hμ u _
        rw [mul_smul_comm]
        exact Submodule.smul_mem_smul hμ ⟨u, trivial, rfl⟩
      · intro z₁ z₂ hz₁ hz₂
        rw [mul_add]
        exact (m_R • M_e).add_mem hz₁ hz₂
    have hMe_le_sup : M_e ≤ Submodule.span (A₀ ⧸ q) ({e} : Set ↥R₀) ⊔ m_R • M_e := by
      rintro _ ⟨x, _, rfl⟩
      change e * x ∈ Submodule.span (A₀ ⧸ q) ({e} : Set ↥R₀) ⊔ m_R • M_e
      obtain ⟨c, hc⟩ := hRes_A x
      let w_x : ↥R₀ :=
        algebraMap (A₀ ⧸ q) ↥R₀ (↑u_rt⁻¹ : A₀ ⧸ q) * (m₀ * (x - algebraMap (A₀ ⧸ q) ↥R₀ c))
      have hw_x_mem : w_x ∈ m_R • (⊤ : Submodule (A₀ ⧸ q) ↥R₀) :=
        hI₀_smul w_x (I₀.mul_mem_left _ (hm₀_ann _ hc))
      have hex_eq : e * x = c • e + e * w_x := by
        have hurt_inv : (↑u_rt⁻¹ : A₀ ⧸ q) * a_rt = 1 := by rw [← hu_rt]; exact Units.inv_mul u_rt
        have he_wx : e * w_x = e * (x - algebraMap (A₀ ⧸ q) ↥R₀ c) := by
          calc
            e * w_x = algebraMap (A₀ ⧸ q) ↥R₀ (↑u_rt⁻¹ : A₀ ⧸ q) * (m₀ * e) *
                  (x - algebraMap (A₀ ⧸ q) ↥R₀ c) := by
                  dsimp only [w_x]; ring
            _ = algebraMap (A₀ ⧸ q) ↥R₀ ((↑u_rt⁻¹ : A₀ ⧸ q) * a_rt) * e *
                  (x - algebraMap (A₀ ⧸ q) ↥R₀ c) := by
                  rw [hm₀_e, ← mul_assoc, ← map_mul]
            _ = e * (x - algebraMap (A₀ ⧸ q) ↥R₀ c) := by rw [hurt_inv, map_one, one_mul]
        rw [he_wx, Algebra.smul_def]
        ring
      rw [hex_eq]
      exact Submodule.add_mem_sup
        ((Submodule.span (A₀ ⧸ q) ({e} : Set ↥R₀)).smul_mem c (Submodule.subset_span rfl))
        (he_smul_Me w_x hw_x_mem)
    have hMe_le_span : M_e ≤ Submodule.span (A₀ ⧸ q) ({e} : Set ↥R₀) :=
      Submodule.le_of_le_smul_of_le_jacobson_bot hMe_fg
        (IsLocalRing.maximalIdeal_le_jacobson ⊥) hMe_le_sup
    have he_span : ∀ x : ↥R₀, ∃ c : A₀ ⧸ q, e * x = algebraMap (A₀ ⧸ q) ↥R₀ c * e := by
      intro x
      have hmem : e * x ∈ Submodule.span (A₀ ⧸ q) ({e} : Set ↥R₀) :=
        hMe_le_span ⟨x, trivial, rfl⟩
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
      refine ⟨c, ?_⟩
      rw [← hc, Algebra.smul_def]
    exact ⟨e, he_idem, he_notQ, he_span⟩
  obtain ⟨e, he_idem, he_notQ, he_span⟩ := hStep3
  
  let π_B : B₁ →+* (B₁ ⧸ Ideal.map ψ q) := Ideal.Quotient.mk (Ideal.map ψ q)
  have hker_πB : RingHom.ker π_B = Ideal.map ψ q := Ideal.mk_ker
  let h_bar : B₁ ⧸ Ideal.map ψ q := t₁.1 * e.1
  have he_notP : e.1 ∉ P := he_notQ
  have hhbar_notP : h_bar ∉ P := hP_prime.mul_notMem ht₁_notP he_notP
  obtain ⟨h, hh_mk⟩ := Ideal.Quotient.mk_surjective (I := Ideal.map ψ q) h_bar
  have hh_mk' : π_B h = h_bar := hh_mk
  have hh_not_p₀ : h ∉ p₀ := by
    rw [← hP_comap_πB, Ideal.mem_comap, hh_mk']
    exact hhbar_notP
  obtain ⟨u_t, hu_t⟩ := he_span t₁
  have hut_S : e.1 * t₁.1 = φ_RS u_t * e.1 := congrArg Subtype.val hu_t
  have hut_notm : u_t ∉ IsLocalRing.maximalIdeal (A₀ ⧸ q) := by
    rw [← hP_comap_φ, Ideal.mem_comap]
    intro hutP
    apply hhbar_notP
    have heq : h_bar = φ_RS u_t * e.1 := by
      dsimp only [h_bar]; rw [mul_comm, hut_S]
    rw [heq]
    exact P.mul_mem_right e.1 hutP
  obtain ⟨v_t, hv_t⟩ := IsLocalRing.notMem_maximalIdeal.mp hut_notm
  have he_pow : ∀ k : ℕ, e.1 ^ (k + 1) = e.1 := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, ih]
      exact congrArg Subtype.val he_idem
  have hhbar_pow1 : ∀ k : ℕ, h_bar ^ (k + 1) = t₁.1 ^ (k + 1) * e.1 := by
    intro k
    dsimp only [h_bar]
    rw [mul_pow, he_pow k]
  have ht₁_pow_e : ∀ k : ℕ, t₁.1 ^ k * e.1 = φ_RS (u_t ^ k) * e.1 := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      calc
        t₁.1 ^ (k + 1) * e.1 = t₁.1 * (t₁.1 ^ k * e.1) := by rw [pow_succ']; ring
        _ = t₁.1 * (φ_RS (u_t ^ k) * e.1) := by rw [ih]
        _ = φ_RS (u_t ^ k) * (e.1 * t₁.1) := by ring
        _ = φ_RS (u_t ^ k) * (φ_RS u_t * e.1) := by rw [hut_S]
        _ = φ_RS (u_t ^ (k + 1)) * e.1 := by rw [pow_succ, map_mul, mul_assoc]
  have hhbar_pow2 : ∀ k : ℕ, h_bar ^ (k + 1) = φ_RS (u_t ^ k) * h_bar := by
    intro k
    calc
      h_bar ^ (k + 1) = t₁.1 * (t₁.1 ^ k * e.1) := by
            rw [hhbar_pow1 k, pow_succ']; ring
      _ = t₁.1 * (φ_RS (u_t ^ k) * e.1) := by rw [ht₁_pow_e k]
      _ = φ_RS (u_t ^ k) * h_bar := by dsimp only [h_bar]; ring
  have hAnn_B₁ : ∀ b : B₁, ∃ (a_b : A₀) (k : ℕ),
      h ^ (k + 1) * (b - ψ a_b) ∈ Ideal.map ψ q := by
    intro b
    let s : B₁ ⧸ Ideal.map ψ q := π_B b
    obtain ⟨k, hs_R₀⟩ := ht₁_sat s
    obtain ⟨c_s, hc_s⟩ := he_span ⟨t₁.1 ^ k * s, hs_R₀⟩
    have hcs_S : e.1 * (t₁.1 ^ k * s) = φ_RS c_s * e.1 := congrArg Subtype.val hc_s
    let r_s : A₀ ⧸ q := c_s * (↑v_t⁻¹ : A₀ ⧸ q) ^ k
    obtain ⟨a_b, ha_b⟩ := Ideal.Quotient.mk_surjective (I := q) r_s
    refine ⟨a_b, k, ?_⟩
    rw [← hker_πB, RingHom.mem_ker, RingHom.map_mul, RingHom.map_pow, hh_mk',
      RingHom.map_sub]
    change h_bar ^ (k + 1) * (s - π_B (ψ a_b)) = 0
    rw [← hφ_RS_mk a_b, ha_b]
    have hvt_mul : u_t * (↑v_t⁻¹ : A₀ ⧸ q) = 1 := by rw [← hv_t]; exact Units.mul_inv v_t
    have h1 : h_bar ^ (k + 1) * s = φ_RS c_s * h_bar := by
      calc
        h_bar ^ (k + 1) * s = (t₁.1 ^ (k + 1) * e.1) * s := by rw [hhbar_pow1 k]
        _ = t₁.1 * (e.1 * (t₁.1 ^ k * s)) := by rw [pow_succ']; ring
        _ = t₁.1 * (φ_RS c_s * e.1) := by rw [hcs_S]
        _ = φ_RS c_s * h_bar := by dsimp only [h_bar]; ring
    have h2 : h_bar ^ (k + 1) * φ_RS r_s = φ_RS c_s * h_bar := by
      calc
        h_bar ^ (k + 1) * φ_RS r_s
            = (φ_RS (u_t ^ k) * h_bar) * φ_RS (c_s * (↑v_t⁻¹ : A₀ ⧸ q) ^ k) := by
              rw [hhbar_pow2 k]
        _ = (φ_RS (u_t ^ k) * φ_RS (c_s * (↑v_t⁻¹ : A₀ ⧸ q) ^ k)) * h_bar := by ring
        _ = φ_RS (c_s * (u_t * (↑v_t⁻¹ : A₀ ⧸ q)) ^ k) * h_bar := by
              rw [← RingHom.map_mul]
              congr 2
              rw [mul_pow]
              ring
        _ = φ_RS c_s * h_bar := by rw [hvt_mul, one_pow, mul_one]
    rw [mul_sub, h1, h2, sub_self]
  refine ⟨h, hh_not_p₀, ?_⟩
  intro g _ p₁ p₂ hhg₁ hhg₂ hcom₁ hcom₂
  have hmem_iff : ∀ (p : PrimeSpectrum B₁),
      h * g ∉ p.asIdeal → Ideal.comap ψ p.asIdeal = q →
      ∀ (b : B₁) (a_b : A₀) (k : ℕ), h ^ (k + 1) * (b - ψ a_b) ∈ Ideal.map ψ q →
      (b ∈ p.asIdeal ↔ a_b ∈ q) := by
    intro p hhg hcom b a_b k hmem_IB
    have hh_not : h ∉ p.asIdeal := fun hh => hhg (p.asIdeal.mul_mem_right g hh)
    have hh_pow_not : h ^ (k + 1) ∉ p.asIdeal := hpow_notMem p.isPrime (k + 1) hh_not
    have hIB_le : Ideal.map ψ q ≤ p.asIdeal := Ideal.map_le_iff_le_comap.mpr hcom.ge
    have hprod_p : h ^ (k + 1) * (b - ψ a_b) ∈ p.asIdeal := hIB_le hmem_IB
    have hdiff_p : b - ψ a_b ∈ p.asIdeal :=
      (p.isPrime.mem_or_mem hprod_p).resolve_left hh_pow_not
    rw [← hcom, Ideal.mem_comap]
    constructor
    · intro hb
      have heq : ψ a_b = b - (b - ψ a_b) := by ring
      rw [heq]
      exact p.asIdeal.sub_mem hb hdiff_p
    · intro hψa
      have heq : b = (b - ψ a_b) + ψ a_b := by ring
      rw [heq]
      exact p.asIdeal.add_mem hdiff_p hψa
  apply PrimeSpectrum.ext
  ext b
  obtain ⟨a_b, k, hk⟩ := hAnn_B₁ b
  exact (hmem_iff p₁ hhg₁ hcom₁ b a_b k hk).trans (hmem_iff p₂ hhg₂ hcom₂ b a_b k hk).symm

theorem weil_henselian_strictlySemistable_etale_chart_isolation (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K)
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥)
    (hPkg_VP : IsValuationRingAlgPackage m (V.ofPrime P.asIdeal))
    (hMax_VP : IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥)
    (ϖ : ↥V)
    (hϖ_P : ϖ ∉ P.asIdeal)
    (hϖ_le : ∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal)
    (hϖ_mem : ∀ x : K, x ∈ V.ofPrime P.asIdeal ↔
      ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a)
    (hOpen_VP : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))))
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (hNorm_ss : IsAffineNormalScheme U_ss)
    (u₀ : ↥U_ss)
    (hu₀_cl : IsClosed ({u₀} : Set ↥U_ss))
    (hu₀_P : g_ss.base u₀ = P)
    (M_all : Set ↥U_ss)
    (hM_cl : IsClosed M_all)
    (hM_fin : M_all.Finite)
    (hM_ne_bot : ∀ y ∈ M_all, (g_ss.base y).asIdeal ≠ ⊥) :
    ∃ (W_B : U_ss.Opens) (hu₀ : u₀ ∈ W_B)
      (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal))),
      let u₀_WB : ↥W_B.toScheme := ⟨u₀, hu₀⟩
      let Z_mod : Set ↥W_B.toScheme := W_B.ι.base ⁻¹' M_all
      let ι_VP : ↥V →+* ↥(V.ofPrime P.asIdeal) :=
        Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
      AlgebraicGeometry.IsAffineOpen W_B ∧
      g_WB ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) = W_B.ι ≫ g_ss ∧
      (∀ y ∈ Z_mod, u₀_WB ∈ closure ({y} : Set ↥W_B.toScheme)) ∧
      ((∃ (e₀ : W_B.toScheme ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥(V.ofPrime P.asIdeal))))
          (m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥(V.ofPrime P.asIdeal))))),
          AlgebraicGeometry.Etale e₀ ∧
          e₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = g_WB ∧
          Polynomial.X ∈ m₀.asIdeal ∧
          (∀ r : ↥(V.ofPrime P.asIdeal), r ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) →
            Polynomial.C r ∈ m₀.asIdeal) ∧
          e₀.base ⁻¹' {m₀} = {u₀_WB} ∧
          ∀ y ∈ Z_mod, e₀.base ⁻¹' {e₀.base y} = {y}) ∨
       (∃ (a₀ : ↥(V.ofPrime P.asIdeal))
          (e₀ : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥(V.ofPrime P.asIdeal) ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})))
          (m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥(V.ofPrime P.asIdeal) ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})))),
          a₀ ≠ 0 ∧
          a₀ ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ∧
          AlgebraicGeometry.Etale e₀ ∧
          e₀ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = g_WB ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ m₀.asIdeal) ∧
          (∀ r : ↥(V.ofPrime P.asIdeal), r ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) →
            Ideal.Quotient.mk _ (MvPolynomial.C r) ∈ m₀.asIdeal) ∧
          e₀.base ⁻¹' {m₀} = {u₀_WB} ∧
          ∀ y ∈ Z_mod, e₀.base ⁻¹' {e₀.base y} = {y})) :=
by
  classical
  let V_P : ValuationSubring K := V.ofPrime P.asIdeal
  let ι_VP : ↥V →+* ↥V_P := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  obtain ⟨W₁, hW₁, hu₀₁, g_W₁, hg_W₁, _hu₀_max, hChart₁⟩ :=
