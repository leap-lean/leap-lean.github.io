        have ha_le : a₀ ≤ a₁ := Subtype.mk_le_mk.mpr bot_le
        have he_le : (e_ord a₀).asIdeal ≤ (e_ord a₁).asIdeal := e_ord.monotone ha_le
        have hMax_a₀ : (e_ord a₀).asIdeal.IsMaximal :=
          (Ring.krullDimLE_zero_iff.mp inferInstance) (e_ord a₀).asIdeal (e_ord a₀).isPrime
        have he_eq : e_ord a₀ = e_ord a₁ :=
          PrimeSpectrum.ext (hMax_a₀.eq_of_le (e_ord a₁).isPrime.ne_top he_le)
        have ha_eq : a₀ = a₁ := e_ord.injective he_eq
        have hbot_eq_𝔭 : bot_Eloc = 𝔭 := congrArg Subtype.val ha_eq
        rw [← hbot_eq_𝔭] at hs_𝔭
        exact hsE_ne (Ideal.mem_bot.mp hs_𝔭)
      choose f_P hf_P using hex_poly
      have hFin_min : M_min.Finite :=
        Ideal.finite_minimalPrimes_of_isNoetherianRing E_loc I_sE
      let P_prod : Polynomial L_Q :=
        ∏ x ∈ hFin_min.toFinset.attach, f_P x.1 (hFin_min.mem_toFinset.mp x.2)
      have hP_prod_ne : P_prod ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr fun x _ => (hf_P x.1 (hFin_min.mem_toFinset.mp x.2)).1
      have hP_prod_rad : algebraMap (Polynomial L_Q) E_loc P_prod ∈ I_sE.radical := by
        rw [← @Ideal.sInf_minimalPrimes E_loc _ I_sE, Ideal.mem_sInf]
        intro 𝔭₀ h𝔭₀
        have hx₀ : (⟨𝔭₀, hFin_min.mem_toFinset.mpr h𝔭₀⟩ : {q // q ∈ hFin_min.toFinset}) ∈
            hFin_min.toFinset.attach := Finset.mem_attach _ _
        have hdvd : f_P 𝔭₀ h𝔭₀ ∣ P_prod := Finset.dvd_prod_of_mem _ hx₀
        rcases hdvd with ⟨q_mul, hq_mul⟩
        rw [hq_mul, map_mul]
        exact Ideal.mul_mem_right _ 𝔭₀ (hf_P 𝔭₀ h𝔭₀).2
      obtain ⟨n_exp, hn_exp⟩ := Ideal.mem_radical_iff.mp hP_prod_rad
      let P₀ : Polynomial L_Q := P_prod ^ n_exp
      have hP₀_ne : P₀ ≠ 0 := pow_ne_zero n_exp hP_prod_ne
      have hP₀_mem : algebraMap (Polynomial L_Q) E_loc P₀ ∈ I_sE := by
        dsimp only [P₀]
        rw [map_pow]
        exact hn_exp
      have hα_P₀ : α_poly P₀ = 0 := by
        obtain ⟨q_E, hq_E⟩ := Ideal.mem_span_singleton.mp hP₀_mem
        have h_eval : Φ_E (algebraMap (Polynomial L_Q) E_loc P₀) = α_poly P₀ := by
          change (IsLocalization.lift hΦ_units)
            (algebraMap F_Q E_loc (algebraMap (Polynomial L_Q) F_Q P₀)) = α_poly P₀
          rw [IsLocalization.lift_eq hΦ_units, hΦ_FQ_poly]
        rw [← h_eval, hq_E, map_mul, hΦ_sE, zero_mul]
      have hΦ_P₀ : Φ_FQ (algebraMap (Polynomial L_Q) F_Q P₀) = 0 := by
        rw [hΦ_FQ_poly, hα_P₀]
      have hΦ_C : ∀ c : L_Q,
          Φ_FQ (algebraMap (Polynomial L_Q) F_Q (Polynomial.C c)) = ι_L c := by
        intro c
        rw [hΦ_FQ_poly]
        exact Polynomial.eval₂_C ι_L (β_B (ψ Polynomial.X))
      let B₀ := Polynomial L_Q ⧸ Ideal.span {P₀}
      haveI : Module.Finite L_Q B₀ := PowerBasis.finite (AdjoinRoot.powerBasis hP₀_ne)
      haveI : IsArtinianRing B₀ := IsArtinianRing.of_finite L_Q B₀
      let I_P₀ : Ideal F_Q := Ideal.span {algebraMap (Polynomial L_Q) F_Q P₀}
      let F_quot := F_Q ⧸ I_P₀
      let mk_Fquot : F_Q →+* F_quot := Ideal.Quotient.mk I_P₀
      haveI : Algebra.QuasiFinite (Polynomial L_Q) F_quot :=
        Algebra.QuasiFinite.of_surjective_algHom
          (Ideal.Quotient.mkₐ (Polynomial L_Q) I_P₀) Ideal.Quotient.mk_surjective
      let β₀ : B₀ →+* F_quot :=
        Ideal.Quotient.lift (Ideal.span {P₀}) (mk_Fquot.comp (algebraMap (Polynomial L_Q) F_Q))
          (by
            intro p hp
            rw [← RingHom.mem_ker]
            refine (Ideal.span_singleton_le_iff_mem _).mpr ?_ hp
            change mk_Fquot (algebraMap (Polynomial L_Q) F_Q P₀) = 0
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl))
      have h_smul_FQ : ∀ (c : L_Q) (f : F_Q),
          c • f = algebraMap (Polynomial L_Q) F_Q (Polynomial.C c) * f := by
        intro c f
        induction f using TensorProduct.induction_on with
        | zero => simp only [smul_zero, mul_zero]
        | tmul p b =>
          change (c • p) ⊗ₜ[Polynomial ↥R] b =
            ((Polynomial.C c) ⊗ₜ[Polynomial ↥R] (1 : B)) * (p ⊗ₜ[Polynomial ↥R] b)
          rw [Polynomial.smul_eq_C_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        | add x y hx hy => rw [smul_add, mul_add, hx, hy]
      letI : Algebra B₀ F_quot := β₀.toAlgebra' (fun c x => mul_comm (β₀ c) x)
      haveI : IsScalarTower (Polynomial L_Q) B₀ F_quot := ⟨fun p b₀ x => by
        obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b₀
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        change β₀ (p • Ideal.Quotient.mk (Ideal.span {P₀}) q) * mk_Fquot f =
          p • (β₀ (Ideal.Quotient.mk (Ideal.span {P₀}) q) * mk_Fquot f)
        have hpq : p • Ideal.Quotient.mk (Ideal.span {P₀}) q =
            Ideal.Quotient.mk (Ideal.span {P₀}) (p * q) := rfl
        rw [hpq]
        change mk_Fquot (algebraMap (Polynomial L_Q) F_Q (p * q)) * mk_Fquot f =
          mk_Fquot (p • (algebraMap (Polynomial L_Q) F_Q q * f))
        rw [Algebra.smul_def, map_mul, map_mul, map_mul, map_mul, mul_assoc]⟩
      haveI : IsScalarTower L_Q B₀ F_quot := ⟨fun c b₀ x => by
        obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b₀
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        change β₀ (c • Ideal.Quotient.mk (Ideal.span {P₀}) q) * mk_Fquot f =
          c • (β₀ (Ideal.Quotient.mk (Ideal.span {P₀}) q) * mk_Fquot f)
        have hcq : c • Ideal.Quotient.mk (Ideal.span {P₀}) q =
            Ideal.Quotient.mk (Ideal.span {P₀}) (Polynomial.C c * q) := by
          change Ideal.Quotient.mk (Ideal.span {P₀}) (c • q) = _
          rw [Polynomial.smul_eq_C_mul]
        rw [hcq]
        change mk_Fquot (algebraMap (Polynomial L_Q) F_Q (Polynomial.C c * q)) * mk_Fquot f =
          mk_Fquot (c • (algebraMap (Polynomial L_Q) F_Q q * f))
        rw [h_smul_FQ, map_mul, map_mul, map_mul, map_mul, mul_assoc]⟩
      haveI : Algebra.QuasiFinite B₀ F_quot :=
        Algebra.QuasiFinite.of_restrictScalars (Polynomial L_Q) B₀ F_quot
      haveI : Module.Finite B₀ F_quot := Module.Finite.of_quasiFinite (R := B₀) (S := F_quot)
      haveI : Module.Finite L_Q F_quot := Module.Finite.trans B₀ F_quot
      haveI : IsArtinianRing F_quot := IsArtinianRing.of_finite B₀ F_quot
      let Θ_ring : F_quot →+* T_fib :=
        Ideal.Quotient.lift I_P₀ Φ_FQ (by
          intro f hf
          rw [← RingHom.mem_ker]
          exact (Ideal.span_singleton_le_iff_mem (RingHom.ker Φ_FQ)).mpr hΦ_P₀ hf)
      let Θ_lin : F_quot →ₗ[L_Q] T_fib :=
        { toFun := Θ_ring
          map_add' := map_add Θ_ring
          map_smul' := fun c x => by
            obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
            change Θ_ring (mk_Fquot (c • f)) = c • Θ_ring (mk_Fquot f)
            change Φ_FQ (c • f) = c • Φ_FQ f
            rw [h_smul_FQ, map_mul, hΦ_C, ← Algebra.smul_def] }
      let S_quot :
          @Submonoid F_quot (@Semiring.toMonoid F_quot CommSemiring.toSemiring).toMulOneClass :=
        Submonoid.map mk_Fquot.toMonoidHom S_𝔪
      have hΘ_units : ∀ y : S_quot, IsUnit (Θ_ring y.1) := by
        rintro ⟨_, m, hm, rfl⟩
        exact hΦ_units ⟨m, hm⟩
      have hΘ_surj : Function.Surjective Θ_lin := by
        intro t
        obtain ⟨w, rfl⟩ := hΦ_surj t
        obtain ⟨⟨f, m⟩, hw_eq⟩ := IsLocalization.surj S_𝔪 w
        let m_quot : S_quot := ⟨mk_Fquot m.1, m.1, m.2, rfl⟩
        rcases (IsLocalization.map_units (M := S_quot) (Localization S_quot) m_quot).exists_right_inv
          with ⟨inv_m, hinv_m⟩
        obtain ⟨v_quot, hv_quot⟩ :=
          IsArtinianRing.localization_surjective S_quot (Localization S_quot) inv_m
        have h_diff_zero :
            algebraMap F_quot (Localization S_quot) (m_quot.1 * v_quot - 1) = 0 := by
          rw [map_sub, map_mul, map_one, hv_quot, hinv_m, sub_self]
        obtain ⟨c_quot, hc_quot⟩ :=
          (IsLocalization.map_eq_zero_iff S_quot (Localization S_quot) (m_quot.1 * v_quot - 1)).mp
            h_diff_zero
        have hΘ_mv : Θ_ring m_quot.1 * Θ_ring v_quot = 1 := by
          rcases (hΘ_units c_quot).exists_left_inv with ⟨u_inv, hu_inv⟩
          have h0 : Θ_ring (c_quot.1 * (m_quot.1 * v_quot - 1)) = 0 := by
            rw [hc_quot, map_zero]
          rw [map_mul, map_sub, map_mul, map_one] at h0
          have h1 := congrArg (u_inv * ·) h0
          change u_inv * (Θ_ring c_quot.1 * (Θ_ring m_quot.1 * Θ_ring v_quot - 1)) =
            u_inv * 0 at h1
          rw [mul_zero, ← mul_assoc, hu_inv, one_mul, sub_eq_zero] at h1
          exact h1
        have h_app : Φ_E w * Φ_FQ m.1 = Φ_FQ f := by
          have h1 := congrArg Φ_E hw_eq
          have hm_eq : Φ_E (algebraMap F_Q E_loc m.1) = Φ_FQ m.1 :=
            IsLocalization.lift_eq hΦ_units m.1
          have hf_eq : Φ_E (algebraMap F_Q E_loc f) = Φ_FQ f :=
            IsLocalization.lift_eq hΦ_units f
          rw [map_mul, hm_eq, hf_eq] at h1
          exact h1
        refine ⟨mk_Fquot f * v_quot, ?_⟩
        change Θ_ring (mk_Fquot f * v_quot) = Φ_E w
        have hΘ_m : Θ_ring m_quot.1 = Φ_FQ m.1 := rfl
        have hΘ_f : Θ_ring (mk_Fquot f) = Φ_FQ f := rfl
        rw [map_mul, hΘ_f, ← h_app, mul_assoc, ← hΘ_m, hΘ_mv, mul_one]
      exact Module.Finite.of_surjective Θ_lin hΘ_surj
  obtain ⟨r_bar, hr_bar_not_𝔮, hr_bar_int, h_pow_int⟩ :=
    (Algebra.zariskisMainProperty_iff (R := ↥R) (p := 𝔮_s)).mp
      (Algebra.ZariskisMainProperty.of_finiteType (R := ↥R) 𝔮_s)
  obtain ⟨r_B, hr_B_mk⟩ := Ideal.Quotient.mk_surjective r_bar
  have hr_B_not_𝔪 : r_B ∉ 𝔪 := fun hm => hr_bar_not_𝔮 (hr_B_mk ▸ (h𝔮_mem r_B).mpr hm)
  obtain ⟨m_X, hrx_int⟩ := h_pow_int (mk_s (ψ Polynomial.X))
  obtain ⟨f_r, hf_r_monic, hf_r_eval⟩ := hr_bar_int
  obtain ⟨P_rx, hP_rx_monic, hP_rx_eval⟩ := hrx_int
  have hf_r_mem : Polynomial.eval₂ φ_R r_B f_r ∈ I_s := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change mk_s (Polynomial.eval₂ φ_R r_B f_r) = 0
    rw [Polynomial.hom_eval₂ f_r φ_R mk_s r_B]
    have h_alg : mk_s.comp φ_R = algebraMap ↥R D_s := rfl
    rw [h_alg, hr_B_mk]
    exact hf_r_eval
  have hP_rx_mem : Polynomial.eval₂ φ_R (r_B ^ m_X * ψ Polynomial.X) P_rx ∈ I_s := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change mk_s (Polynomial.eval₂ φ_R (r_B ^ m_X * ψ Polynomial.X) P_rx) = 0
    rw [Polynomial.hom_eval₂ P_rx φ_R mk_s (r_B ^ m_X * ψ Polynomial.X)]
    have h_alg : mk_s.comp φ_R = algebraMap ↥R D_s := rfl
    have h_arg : mk_s (r_B ^ m_X * ψ Polynomial.X) = r_bar ^ m_X * mk_s (ψ Polynomial.X) := by
      rw [map_mul, map_pow, hr_B_mk]
    rw [h_alg, h_arg]
    exact hP_rx_eval
  exact ⟨r_B, m_X, f_r, P_rx, hr_B_not_𝔪, hf_r_monic, hP_rx_monic, hf_r_mem, hP_rx_mem⟩

theorem weil_sepClosed_zmt_weierstrass_monic_flat_div (K : Type u) [Field K] [IsSepClosed K]
    (R : ValuationSubring K)
    (B : Type u) [CommRing B]
    (ψ : Polynomial ↥R →+* B)
    (hψ : ψ.Etale)
    (𝔪 : Ideal B) (h𝔪 : 𝔪.IsPrime)
    (h𝔔_le : Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R) ≤ 𝔪)
    (π_b : ↥R) (s b w : B)
    (hs_mem : s ∈ 𝔪)
    (hsb : s * b = ψ (Polynomial.C π_b) * w)
    (hZMT : ∃ (r_B : B) (m_X : ℕ) (f_r P_rx : Polynomial ↥R),
      r_B ∉ 𝔪 ∧
      f_r.Monic ∧
      P_rx.Monic ∧
      Polynomial.eval₂ (ψ.comp Polynomial.C) r_B f_r ∈ Ideal.span {s} ∧
      Polynomial.eval₂ (ψ.comp Polynomial.C) (r_B ^ m_X * ψ Polynomial.X) P_rx ∈ Ideal.span {s}) :
    ∃ (u q_b : B), u ∉ 𝔪 ∧ u * b = ψ (Polynomial.C π_b) * q_b :=
by
  obtain ⟨r_B, m_X, f_r, P_rx, hr_B, hf_r, hP_rx, hf_mem, hPrx_mem⟩ := hZMT
  let α : ↥R →+* B := ψ.comp Polynomial.C
  have hmax : ∀ c ∈ IsLocalRing.maximalIdeal ↥R, α c ∈ 𝔪 :=
    fun c hc => h𝔔_le (Ideal.mem_map_of_mem α hc)
  have hBinomK : ∀ (p_K : Polynomial K), p_K.Monic → Irreducible p_K →
      ∃ q : ℕ, 1 ≤ q ∧ p_K = Polynomial.X ^ q + Polynomial.C (p_K.coeff 0) := by
    intro p_K hp_monic hp_irred
    obtain ⟨p, hp_char⟩ := CharP.exists K
    rcases CharP.char_is_prime_or_zero K p with hp_prime | rfl
    · obtain ⟨n, g, hg_sep, hg_exp⟩ :=
        Polynomial.exists_separable_of_irreducible p hp_irred hp_prime.ne_zero
      have hg_irred : Irreducible g :=
        Polynomial.of_irreducible_expand_pow hp_prime.ne_zero (hg_exp ▸ hp_irred)
      have hqn_pos : 0 < p ^ n := pow_pos hp_prime.pos n
      have hg_monic : g.Monic := by
        have hlc : (Polynomial.expand K (p ^ n) g).leadingCoeff = g.leadingCoeff :=
          Polynomial.leadingCoeff_expand hqn_pos
        rw [Polynomial.Monic, ← hlc, hg_exp]
        exact hp_monic.leadingCoeff
      have hg_deg : g.degree = 1 :=
        IsSepClosed.degree_eq_one_of_irreducible K hg_irred hg_sep
      have hg_eq : g = Polynomial.X + Polynomial.C (g.coeff 0) := by
        conv_lhs => rw [Polynomial.eq_X_add_C_of_degree_eq_one hg_deg]
        rw [hg_monic.leadingCoeff, Polynomial.C_1, one_mul]
      have hp_eq : p_K = Polynomial.X ^ (p ^ n) + Polynomial.C (g.coeff 0) := by
        conv_lhs => rw [← hg_exp, hg_eq]
        rw [map_add, Polynomial.expand_X, Polynomial.expand_C]
      have hq_ge : 1 ≤ p ^ n := Nat.one_le_pow n p hp_prime.pos
      have hq_ne : p ^ n ≠ 0 := Nat.one_le_iff_ne_zero.mp hq_ge
      have hcoeff : p_K.coeff 0 = g.coeff 0 := by
        rw [hp_eq, Polynomial.coeff_add, Polynomial.coeff_X_pow]
        simp [hq_ne.symm]
      exact ⟨p ^ n, hq_ge, hcoeff ▸ hp_eq⟩
    · have : CharZero K := CharP.charP_to_charZero K
      have hp_deg : p_K.degree = 1 :=
        IsSepClosed.degree_eq_one_of_irreducible K hp_irred hp_irred.separable
      refine ⟨1, le_rfl, ?_⟩
      conv_lhs => rw [Polynomial.eq_X_add_C_of_degree_eq_one hp_deg]
      rw [hp_monic.leadingCoeff, Polynomial.C_1, one_mul, pow_one]
  have hinj_RK : Function.Injective (algebraMap ↥R K) := Subtype.val_injective
  let down_ic : ↥(integralClosure ↥R K) →+* ↥R :=
    { toFun := fun z => ⟨z.1, by
        obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp z.2
        exact hr ▸ r.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hcomp_ic : (algebraMap ↥R K).comp down_ic = algebraMap ↥(integralClosure ↥R K) K :=
    RingHom.ext fun _ => rfl
  have hSplit : ∀ (d : ℕ) (f : Polynomial ↥R), f.Monic → f.natDegree = d →
      ∃ (g_in g_out : Polynomial ↥R),
        f = g_in * g_out ∧
        g_in.Monic ∧
        g_out.Monic ∧
        IsUnit (g_in.coeff 0) ∧
        Polynomial.eval₂ α r_B g_out ∉ 𝔪 := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro f hf hdeg
      by_cases hf_mem_m : Polynomial.eval₂ α r_B f ∈ 𝔪
      · let f_K : Polynomial K := f.map (algebraMap ↥R K)
        have hfK_not_unit : ¬ IsUnit f_K := by
          intro hu
          have hdeg0 : f_K.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hu
          have hf_deg0 : f.natDegree = 0 := by
            rwa [Polynomial.natDegree_map_eq_of_injective hinj_RK f] at hdeg0
          have hf1 : f = 1 := by
            ext n
            cases n with
            | zero =>
              have h0 : f.coeff 0 = f.leadingCoeff := by
                rw [Polynomial.leadingCoeff, hf_deg0]
              rw [h0, hf.leadingCoeff, Polynomial.coeff_one_zero]
            | succ n =>
              have hlt : f.natDegree < n + 1 := by omega
              rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt,
                ← Polynomial.C_1, Polynomial.coeff_C_ne_zero (Nat.succ_ne_zero n)]
          rw [hf1, Polynomial.eval₂_one] at hf_mem_m
          exact h𝔪.one_notMem hf_mem_m
        obtain ⟨p_K, hp_monic, hp_irred, hp_dvd⟩ :=
          Polynomial.exists_monic_irreducible_factor f_K hfK_not_unit
        have hlifts : p_K ∈ Polynomial.lifts (algebraMap ↥(integralClosure ↥R K) K) :=
          integralClosure.mem_lifts_of_monic_of_dvd_map K hf hp_monic hp_dvd
        obtain ⟨h_ic, hh_ic_map, _, hh_ic_monic⟩ :=
          Polynomial.lifts_and_degree_eq_and_monic hlifts hp_monic
        let h : Polynomial ↥R := h_ic.map down_ic
        have hh_monic : h.Monic := hh_ic_monic.map down_ic
        have hh_map : h.map (algebraMap ↥R K) = p_K := by
          rw [Polynomial.map_map, hcomp_ic, hh_ic_map]
        have hdvd : h ∣ f :=
          Polynomial.Monic.dvd_of_fraction_map_dvd_fraction_map hf hh_monic (hh_map.symm ▸ hp_dvd)
        obtain ⟨f₁, hf_eq⟩ := hdvd
        have hf₁_monic : f₁.Monic :=
          Polynomial.Monic.of_mul_monic_left hh_monic (hf_eq ▸ hf)
        have hdeg_mul : f.natDegree = h.natDegree + f₁.natDegree := by
          rw [hf_eq, Polynomial.Monic.natDegree_mul hh_monic hf₁_monic]
        have hh_deg_pos : 0 < h.natDegree := by
          have hp_pos : 0 < p_K.natDegree := Irreducible.natDegree_pos hp_irred
          rwa [← hh_map, Polynomial.natDegree_map_eq_of_injective hinj_RK h] at hp_pos
        have hf₁_lt : f₁.natDegree < d := by omega
        obtain ⟨g₁_in, g₁_out, hf₁_eq, hg₁_in, hg₁_out, hunit₁, hout₁⟩ :=
          ih f₁.natDegree hf₁_lt f₁ hf₁_monic rfl
        by_cases hh_mem : Polynomial.eval₂ α r_B h ∈ 𝔪
        · obtain ⟨q, hq_ge, hp_binom⟩ := hBinomK p_K hp_monic hp_irred
          have hh_binom : h = Polynomial.X ^ q + Polynomial.C (h.coeff 0) := by
            apply Polynomial.map_injective (algebraMap ↥R K) hinj_RK
            rw [hh_map, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X,
              Polynomial.map_C, ← Polynomial.coeff_map, hh_map]
            exact hp_binom
          have hh_eval : Polynomial.eval₂ α r_B h = r_B ^ q + α (h.coeff 0) := by
            conv_lhs => rw [hh_binom]
            rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
          have hh_unit : IsUnit (h.coeff 0) := by
            by_contra hnu
            have hc_max : h.coeff 0 ∈ IsLocalRing.maximalIdeal ↥R :=
              (IsLocalRing.mem_maximalIdeal (h.coeff 0)).mpr hnu
            have hαc_mem : α (h.coeff 0) ∈ 𝔪 := hmax (h.coeff 0) hc_max
            have hrq_mem : r_B ^ q ∈ 𝔪 := by
              have hsum_mem : r_B ^ q + α (h.coeff 0) ∈ 𝔪 := hh_eval ▸ hh_mem
              have hsub := 𝔪.sub_mem hsum_mem hαc_mem
              rwa [add_sub_cancel_right] at hsub
            exact hr_B (h𝔪.mem_of_pow_mem q hrq_mem)
          refine ⟨h * g₁_in, g₁_out, ?_, hh_monic.mul hg₁_in, hg₁_out, ?_, hout₁⟩
          · rw [hf_eq, hf₁_eq, mul_assoc]
          · rw [Polynomial.mul_coeff_zero]
            exact hh_unit.mul hunit₁
        · refine ⟨g₁_in, h * g₁_out, ?_, hg₁_in, hh_monic.mul hg₁_out, hunit₁, ?_⟩
          · rw [hf_eq, hf₁_eq]
            ring
          · rw [Polynomial.eval₂_mul]
            intro hprod_mem
            rcases h𝔪.mem_or_mem hprod_mem with hh_in | hout_in
            · exact hh_mem hh_in
            · exact hout₁ hout_in
      · refine ⟨1, f, (one_mul f).symm, Polynomial.monic_one, hf, ?_, hf_mem_m⟩
        rw [Polynomial.coeff_one_zero]
        exact isUnit_one
  obtain ⟨g_in, g_out, hfg_eq, hg_in, hg_out, hunit, hu₀_not_mem⟩ :=
    hSplit f_r.natDegree f_r hf_r rfl
  let u₀ : B := Polynomial.eval₂ α r_B g_out
  have hAnnW : ∃ (d_W : ℕ) (P_W : Polynomial ↥R),
      P_W.Monic ∧ u₀ ^ d_W * ψ P_W ∈ Ideal.span {s} := by
    let I_s : Ideal B := Ideal.span {s}
    let D_s := B ⧸ I_s
    let mk_s : B →+* D_s := Ideal.Quotient.mk I_s
    letI : Algebra ↥R D_s := (mk_s.comp α).toAlgebra
    have h_aeval_mk : ∀ (P : Polynomial ↥R) (z : B),
        Polynomial.aeval (mk_s z) P = mk_s (Polynomial.eval₂ α z P) := by
      intro P z
      change Polynomial.eval₂ (mk_s.comp α) (mk_s z) P = mk_s (Polynomial.eval₂ α z P)
      exact (Polynomial.hom_eval₂ P α mk_s z).symm
    let r_bar : D_s := mk_s r_B
    let x_bar : D_s := mk_s (ψ Polynomial.X)
    let u_out : D_s := mk_s u₀
    have hu_out_eq : u_out = Polynomial.aeval r_bar g_out :=
      (h_aeval_mk g_out r_B).symm
    have h_aeval_fg : Polynomial.aeval r_bar (g_in * g_out) = 0 := by
      rw [h_aeval_mk, ← hfg_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hf_mem
    have hr_int : IsIntegral ↥R r_bar :=
      ⟨g_in * g_out, hg_in.mul hg_out, h_aeval_fg⟩
    have h_ann_gin : Polynomial.aeval r_bar g_in * u_out = 0 := by
      rw [hu_out_eq, ← map_mul]
      exact h_aeval_fg
    have h_aeval_Prx : Polynomial.aeval (r_bar ^ m_X * x_bar) P_rx = 0 := by
      have hmk_rx : r_bar ^ m_X * x_bar = mk_s (r_B ^ m_X * ψ Polynomial.X) := by
        simp only [r_bar, x_bar, map_mul, map_pow]
      rw [hmk_rx, h_aeval_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hPrx_mem
    have hrx_int : IsIntegral ↥R (r_bar ^ m_X * x_bar) :=
      ⟨P_rx, hP_rx, h_aeval_Prx⟩
    rcases hunit.exists_right_inv with ⟨c_inv, hc_inv⟩
    let r_inv : D_s := -algebraMap ↥R D_s c_inv * Polynomial.aeval r_bar g_in.divX
    have hr_ic : r_bar ∈ integralClosure ↥R D_s := by
      rw [mem_integralClosure_iff]
      exact hr_int
    have hrx_ic : r_bar ^ m_X * x_bar ∈ integralClosure ↥R D_s := by
      rw [mem_integralClosure_iff]
      exact hrx_int
    have hdiv_ic : Polynomial.aeval r_bar g_in.divX ∈ integralClosure ↥R D_s := by
      rw [Polynomial.aeval_eq_sum_range]
      exact (integralClosure ↥R D_s).sum_mem fun i _ =>
        (integralClosure ↥R D_s).smul_mem ((integralClosure ↥R D_s).pow_mem hr_ic i) _
    have hrinv_ic : r_inv ∈ integralClosure ↥R D_s :=
      (integralClosure ↥R D_s).mul_mem
        ((integralClosure ↥R D_s).neg_mem ((integralClosure ↥R D_s).algebraMap_mem c_inv))
        hdiv_ic
    let y_int : D_s := (r_bar ^ m_X * x_bar) * r_inv ^ m_X
    have hy_int : IsIntegral ↥R y_int := by
      rw [← mem_integralClosure_iff]
      exact (integralClosure ↥R D_s).mul_mem hrx_ic
        ((integralClosure ↥R D_s).pow_mem hrinv_ic m_X)
    have h_div_id : r_bar * Polynomial.aeval r_bar g_in.divX +
        algebraMap ↥R D_s (g_in.coeff 0) = Polynomial.aeval r_bar g_in := by
      have h1 := congrArg (Polynomial.aeval r_bar) (Polynomial.X_mul_divX_add g_in)
      simpa only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] using h1
    have h_cinv_one : algebraMap ↥R D_s (g_in.coeff 0) * algebraMap ↥R D_s c_inv = 1 := by
      rw [← map_mul, hc_inv, map_one]
    have h_one_sub : 1 - r_bar * r_inv =
        Polynomial.aeval r_bar g_in * algebraMap ↥R D_s c_inv := by
      dsimp only [r_inv]
      calc 1 - r_bar * (-algebraMap ↥R D_s c_inv * Polynomial.aeval r_bar g_in.divX)
          = algebraMap ↥R D_s (g_in.coeff 0) * algebraMap ↥R D_s c_inv +
              r_bar * Polynomial.aeval r_bar g_in.divX * algebraMap ↥R D_s c_inv := by
            rw [h_cinv_one]; ring
        _ = (r_bar * Polynomial.aeval r_bar g_in.divX + algebraMap ↥R D_s (g_in.coeff 0)) *
              algebraMap ↥R D_s c_inv := by ring
        _ = Polynomial.aeval r_bar g_in * algebraMap ↥R D_s c_inv := by rw [h_div_id]
    have h_ur : u_out * r_bar * r_inv = u_out := by
      have h0 : u_out * (1 - r_bar * r_inv) = 0 := by
        calc u_out * (1 - r_bar * r_inv)
            = (Polynomial.aeval r_bar g_in * u_out) * algebraMap ↥R D_s c_inv := by
              rw [h_one_sub]; ring
          _ = 0 := by rw [h_ann_gin, zero_mul]
      calc u_out * r_bar * r_inv
          = u_out - u_out * (1 - r_bar * r_inv) := by ring
        _ = u_out := by rw [h0, sub_zero]
    have h_ur_pow : ∀ m : ℕ, u_out * r_bar ^ m * r_inv ^ m = u_out := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        calc u_out * r_bar ^ (m + 1) * r_inv ^ (m + 1)
            = (u_out * r_bar * r_inv) * r_bar ^ m * r_inv ^ m := by ring
          _ = u_out * r_bar ^ m * r_inv ^ m := by rw [h_ur]
          _ = u_out := ih
    have h_ux : u_out * x_bar = u_out * y_int := by
      dsimp only [y_int]
      calc u_out * x_bar
          = (u_out * r_bar ^ m_X * r_inv ^ m_X) * x_bar := by rw [h_ur_pow m_X]
        _ = u_out * (r_bar ^ m_X * x_bar * r_inv ^ m_X) := by ring
    obtain ⟨P_W, hPW_monic, hPW_eval⟩ := hy_int
    have hPW_aeval : Polynomial.aeval y_int P_W = 0 := hPW_eval
    let d_W : ℕ := P_W.natDegree
    have h_pow_j : ∀ j ≤ d_W, u_out ^ d_W * x_bar ^ j = u_out ^ d_W * y_int ^ j := by
      intro j hj
      have hdj : d_W - j + j = d_W := Nat.sub_add_cancel hj
      calc u_out ^ d_W * x_bar ^ j
          = u_out ^ (d_W - j + j) * x_bar ^ j := by rw [hdj]
        _ = u_out ^ (d_W - j) * (u_out * x_bar) ^ j := by ring
        _ = u_out ^ (d_W - j) * (u_out * y_int) ^ j := by rw [h_ux]
        _ = u_out ^ (d_W - j + j) * y_int ^ j := by ring
        _ = u_out ^ d_W * y_int ^ j := by rw [hdj]
    have h_u_aeval : u_out ^ d_W * Polynomial.aeval x_bar P_W = 0 := by
      have h_sum_eq : u_out ^ d_W * Polynomial.aeval x_bar P_W =
          u_out ^ d_W * Polynomial.aeval y_int P_W := by
        rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range,
          Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j hj => ?_
        have hj_le : j ≤ d_W := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        rw [Algebra.smul_def, Algebra.smul_def]
        calc u_out ^ d_W * (algebraMap ↥R D_s (P_W.coeff j) * x_bar ^ j)
            = algebraMap ↥R D_s (P_W.coeff j) * (u_out ^ d_W * x_bar ^ j) := by ring
          _ = algebraMap ↥R D_s (P_W.coeff j) * (u_out ^ d_W * y_int ^ j) := by
              rw [h_pow_j j hj_le]
          _ = u_out ^ d_W * (algebraMap ↥R D_s (P_W.coeff j) * y_int ^ j) := by ring
      rw [h_sum_eq, hPW_aeval, mul_zero]
    have h_aeval_x : Polynomial.aeval x_bar P_W = mk_s (ψ P_W) := by
      dsimp only [x_bar]
      rw [h_aeval_mk]
      dsimp only [α]
      rw [← Polynomial.hom_eval₂ P_W Polynomial.C ψ Polynomial.X, Polynomial.eval₂_C_X]
    refine ⟨d_W, P_W, hPW_monic, Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
    change mk_s (u₀ ^ d_W * ψ P_W) = 0
    rw [map_mul, map_pow, ← h_aeval_x]
    exact h_u_aeval
  have hFlatCancel : ∀ {S₀ : Type u} [CommRing S₀]
      (f₀ : ↥R →+* S₀) (_hf₀ : Function.Surjective f₀)
      (Q : Ideal ↥R) (_hQ : RingHom.ker f₀ = Q)
      (α_Q : S₀ →+* B ⧸ Ideal.map α Q),
      (∀ r : ↥R, α_Q (f₀ r) = Ideal.Quotient.mk (Ideal.map α Q) (α r)) →
      ∀ (P : Polynomial ↥R), P.Monic →
      ∀ y : B, ψ P * y ∈ Ideal.map α Q → y ∈ Ideal.map α Q := by
    intro S₀ _ f₀ hf₀ Q hQ α_Q hα_comp P hP_monic y hy_mem
    let I_Q : Ideal B := Ideal.map α Q
    let C_Q := B ⧸ I_Q
    let mk_CQ : B →+* C_Q := Ideal.Quotient.mk I_Q
    let ψ_S : Polynomial S₀ →+* C_Q :=
      Polynomial.eval₂RingHom α_Q (mk_CQ (ψ Polynomial.X))
    let π_poly : Polynomial ↥R →+* Polynomial S₀ :=
      Polynomial.mapRingHom f₀
    have hψS_comp : ψ_S.comp π_poly = mk_CQ.comp ψ := by
      apply Polynomial.ringHom_ext'
      · ext r
        dsimp only [ψ_S, π_poly]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact hα_comp r
      · dsimp only [ψ_S, π_poly]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    letI : Algebra (Polynomial ↥R) B := ψ.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥R) B := RingHom.etale_algebraMap.mp hψ
    letI := π_poly.toAlgebra
    letI := π_poly.toAlgebra' (fun _ _ => mul_comm _ _)
    letI : Algebra (Polynomial S₀) C_Q := ψ_S.toAlgebra
    let T_S := TensorProduct (Polynomial ↥R) (Polynomial S₀) B
    haveI : Module.Flat (Polynomial S₀) T_S :=
      Module.Flat.baseChange (Polynomial ↥R) (Polynomial S₀) B
    let f_fwd : T_S →ₐ[Polynomial ↥R] C_Q :=
      Algebra.TensorProduct.lift
        { toRingHom := ψ_S
          commutes' := fun p => RingHom.congr_fun hψS_comp p }
        (Ideal.Quotient.mkₐ (Polynomial ↥R) I_Q)
        (fun _ _ => Commute.all _ _)
    let inc_B : B →+* T_S :=
      (Algebra.TensorProduct.includeRight : B →ₐ[Polynomial ↥R] T_S).toRingHom
    let f_bwd : C_Q →+* T_S :=
      Ideal.Quotient.lift I_Q inc_B (by
        intro x hx
        rw [← RingHom.mem_ker]
        revert x hx
        rw [← SetLike.le_def, Ideal.map_le_iff_le_comap]
        intro r hr
        change (1 : Polynomial S₀) ⊗ₜ[Polynomial ↥R] (ψ (Polynomial.C r)) = 0
        have h_cr : ψ (Polynomial.C r) = (Polynomial.C r : Polynomial ↥R) • (1 : B) := by
          rw [Algebra.smul_def, mul_one]
          rfl
        rw [h_cr, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        have hr0 : f₀ r = 0 := by rw [← RingHom.mem_ker, hQ]; exact hr
        have h0 : (algebraMap (Polynomial ↥R) (Polynomial S₀)) (Polynomial.C r) = 0 := by
          change Polynomial.map f₀ (Polynomial.C r) = 0
          rw [Polynomial.map_C, hr0, map_zero]
        rw [h0, TensorProduct.zero_tmul])
    have h_left_inv : Function.LeftInverse f_bwd f_fwd := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul p_bar b_elem =>
        obtain ⟨p_orig, rfl⟩ := Polynomial.map_surjective f₀ hf₀ p_bar
        have hp_eq : Polynomial.map f₀ p_orig =
            (algebraMap (Polynomial ↥R) (Polynomial S₀)) p_orig := rfl
        rw [hp_eq]
        have h_tmul :
            ((algebraMap (Polynomial ↥R) (Polynomial S₀)) p_orig) ⊗ₜ[Polynomial ↥R] b_elem =
            (1 : Polynomial S₀) ⊗ₜ[Polynomial ↥R] (ψ p_orig * b_elem) := by
          calc ((algebraMap (Polynomial ↥R) (Polynomial S₀)) p_orig) ⊗ₜ[Polynomial ↥R] b_elem
              = (p_orig • (1 : Polynomial S₀)) ⊗ₜ[Polynomial ↥R] b_elem := by
                  rw [Algebra.smul_def, mul_one]
            _ = (1 : Polynomial S₀) ⊗ₜ[Polynomial ↥R] (p_orig • b_elem) :=
                  TensorProduct.smul_tmul p_orig (1 : Polynomial S₀) b_elem
            _ = (1 : Polynomial S₀) ⊗ₜ[Polynomial ↥R] (ψ p_orig * b_elem) := by
                  rw [Algebra.smul_def]
                  rfl
        rw [h_tmul]
        have h_fwd_tmul : f_fwd ((1 : Polynomial S₀) ⊗ₜ[Polynomial ↥R] (ψ p_orig * b_elem)) =
            mk_CQ (ψ p_orig * b_elem) := by
          dsimp only [f_fwd]
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        rw [h_fwd_tmul]
        rfl
      | add x₁ x₂ hx₁ hx₂ =>
        simp only [map_add, hx₁, hx₂]
    have h_right_inv : Function.RightInverse f_bwd f_fwd := by
      intro z
      obtain ⟨b_elem, rfl⟩ := Ideal.Quotient.mk_surjective z
      have h1 : f_bwd (mk_CQ b_elem) = (1 : Polynomial S₀) ⊗ₜ[Polynomial ↥R] b_elem := rfl
      change f_fwd (f_bwd (mk_CQ b_elem)) = mk_CQ b_elem
      rw [h1]
      dsimp only [f_fwd]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have h_fwd_one : ∀ p_bar : Polynomial S₀, f_fwd (p_bar ⊗ₜ[Polynomial ↥R] 1) = ψ_S p_bar := by
      intro p_bar
      dsimp only [f_fwd]
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    have h_smul_fwd : ∀ (p_bar : Polynomial S₀) (t : T_S),
        f_fwd (p_bar • t) = p_bar • f_fwd t := by
      intro p_bar t
      have ht : p_bar • t = (p_bar ⊗ₜ[Polynomial ↥R] (1 : B)) * t := by
        induction t using TensorProduct.induction_on with
        | zero => simp only [smul_zero, mul_zero]
        | tmul a b_elem =>
          rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul,
            smul_eq_mul, one_mul]
        | add x₁ x₂ hx₁ hx₂ =>
          rw [smul_add, mul_add, hx₁, hx₂]
      rw [ht, map_mul, h_fwd_one p_bar]
      rfl
    let e_lin : T_S ≃ₗ[Polynomial S₀] C_Q :=
      LinearEquiv.ofBijective
        { toFun := f_fwd
          map_add' := map_add f_fwd
          map_smul' := h_smul_fwd }
        ⟨h_left_inv.injective, h_right_inv.surjective⟩
    haveI : Module.Flat (Polynomial S₀) C_Q := Module.Flat.of_linearEquiv e_lin.symm
    let P_bar : Polynomial S₀ := P.map f₀
    have hPbar_monic : P_bar.Monic := hP_monic.map f₀
    have hReg : IsSMulRegular C_Q P_bar :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors
        (Polynomial.Monic.mem_nonZeroDivisors hPbar_monic)
    have h_smul_zero : P_bar • mk_CQ y = P_bar • (0 : C_Q) := by
      rw [smul_zero]
      change ψ_S (π_poly P) * mk_CQ y = 0
      have hψP : ψ_S (π_poly P) = mk_CQ (ψ P) := RingHom.congr_fun hψS_comp P
      rw [hψP, ← map_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hy_mem
    exact Ideal.Quotient.eq_zero_iff_mem.mp (hReg h_smul_zero)
  obtain ⟨d_W, P_W, hPW_monic, h_ann⟩ := hAnnW
  let u : B := u₀ ^ d_W
  have hu_not_mem : u ∉ 𝔪 := fun h => hu₀_not_mem (h𝔪.mem_of_pow_mem d_W h)
  rcases Ideal.mem_span_singleton.mp h_ann with ⟨h_mul, hh_mul⟩
  have hyz : ψ P_W * (u * b) = ψ (Polynomial.C π_b) * (w * h_mul) := by
    calc ψ P_W * (u * b)
        = (u₀ ^ d_W * ψ P_W) * b := by ring
      _ = (s * h_mul) * b := by rw [hh_mul]
      _ = (s * b) * h_mul := by ring
      _ = (ψ (Polynomial.C π_b) * w) * h_mul := by rw [hsb]
      _ = ψ (Polynomial.C π_b) * (w * h_mul) := by ring
  let Q_π : Ideal ↥R := Ideal.span {π_b}
  have hI_eq : Ideal.map α Q_π = Ideal.span {ψ (Polynomial.C π_b)} := by
    dsimp only [Q_π, α]
    rw [Ideal.map_span, Set.image_singleton, RingHom.comp_apply]
  let α_Q : (↥R ⧸ Q_π) →+* B ⧸ Ideal.map α Q_π :=
    Ideal.Quotient.lift Q_π ((Ideal.Quotient.mk (Ideal.map α Q_π)).comp α) (by
      intro r hr
      change Ideal.Quotient.mk (Ideal.map α Q_π) (α r) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem α hr))
  have hy_mem_IQ : ψ P_W * (u * b) ∈ Ideal.map α Q_π := by
    rw [hI_eq, Ideal.mem_span_singleton]
    exact ⟨w * h_mul, hyz⟩
  have hub_mem : u * b ∈ Ideal.span {ψ (Polynomial.C π_b)} := by
    rw [← hI_eq]
    exact hFlatCancel (Ideal.Quotient.mk Q_π) Ideal.Quotient.mk_surjective
      Q_π (Ideal.mk_ker (I := Q_π)) α_Q (fun _ => rfl) P_W hPW_monic (u * b) hy_mem_IQ
  rcases Ideal.mem_span_singleton.mp hub_mem with ⟨q_b, hqb⟩
  exact ⟨u, q_b, hu_not_mem, hqb⟩

theorem weil_etale_curve_gauss_stalk_and_weierstrass_regularity (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K)
    (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax : IsLocalRing.maximalIdeal ↥R ≠ ⊥) :
    (∀ (B F : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [Field F]
        (ψ : Polynomial ↥R →+* B) (φ : B →+* F),
      ψ.Etale →
      @IsFractionRing B _ F _ φ.toAlgebra →
      let 𝔔 : Ideal B := Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R)
      𝔔.IsPrime →
      (∀ r : ↥R, r ≠ 0 → ψ (Polynomial.C r) ≠ 0) ∧
      ∃ (W : ValuationSubring F) (hB : ∀ x : B, φ x ∈ W),
        (∀ x : B, (⟨φ x, hB x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ x ∈ 𝔔) ∧
