    AlgebraicGeometry.Spec.map_preimage (hUtop.fromSpec ≫ g_ss)
  have hMinInUiso : ∀ (Q : PrimeSpectrum ↥V) (p_x : PrimeSpectrum A_ss)
      (hx : PrimeSpectrum.comap (algebraMap ↥V A_ss) p_x = Q),
      (PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q ⟨p_x, hx⟩).asIdeal ∈
        minimalPrimes (Q.asIdeal.Fiber A_ss) →
      hUtop.fromSpec.base p_x ∈ U_iso := by
    intro Q p_x hx hMin_x
    let x : ↥U_ss := hUtop.fromSpec.base p_x
    have hp_x_eq : hUtop.primeIdealOf ⟨x, trivial⟩ = p_x := by
      apply hUtop.fromSpec.isOpenEmbedding.injective
      rw [hUtop.fromSpec_primeIdealOf]
    have hFinGen : ∀ y : ↥U_ss, x ∈ closure ({y} : Set ↥U_ss) →
        (f_ss_cur.base ⁻¹' {y}).Finite := by
      intro y hxy
      let p_y : PrimeSpectrum A_ss := hUtop.primeIdealOf ⟨y, trivial⟩
      have hp_yx : p_y ≤ p_x := by
        rw [← hp_x_eq, PrimeSpectrum.le_iff_mem_closure, mem_closure_iff]
        intro O hO hxO
        have hPre_open : IsOpen (hUtop.isoSpec.hom.base ⁻¹' O) :=
          hO.preimage hUtop.isoSpec.hom.continuous
        let W_op : U_ss.Opens :=
          U_top.ι.opensFunctor.obj ⟨hUtop.isoSpec.hom.base ⁻¹' O, hPre_open⟩
        have hIso_pt : ∀ w : ↥U_ss,
            hUtop.isoSpec.hom.base ⟨w, trivial⟩ = hUtop.primeIdealOf ⟨w, trivial⟩ := by
          intro w
          apply hUtop.fromSpec.isOpenEmbedding.injective
          rw [hUtop.fromSpec_primeIdealOf]
          change (hUtop.isoSpec.hom ≫ hUtop.fromSpec).base ⟨w, trivial⟩ = w
          rw [hUtop.isoSpec_hom, hUtop.toSpecΓ_fromSpec]
          rfl
        have hxW : x ∈ (W_op : Set ↥U_ss) := by
          refine ⟨⟨x, trivial⟩, ?_, rfl⟩
          change hUtop.isoSpec.hom.base ⟨x, trivial⟩ ∈ O
          rwa [hIso_pt x]
        obtain ⟨z_pt, hzW, hz_eq⟩ := mem_closure_iff.mp hxy (W_op : Set ↥U_ss) W_op.isOpen hxW
        rw [Set.mem_singleton_iff] at hz_eq
        rw [hz_eq] at hzW
        rcases hzW with ⟨u_y, hyO, hu_eq⟩
        have hu_y : u_y = ⟨y, trivial⟩ := Subtype.ext hu_eq
        rw [hu_y] at hyO
        change hUtop.isoSpec.hom.base ⟨y, trivial⟩ ∈ O at hyO
        rw [hIso_pt y] at hyO
        exact ⟨p_y, hyO, rfl⟩
      let Q' : PrimeSpectrum ↥V := PrimeSpectrum.comap (algebraMap ↥V A_ss) p_y
      obtain ⟨t_y, ht_y⟩ :=
        weil_semistable_algebra_minimal_fiber_generalization_transcendental
          K V A_ss Q p_x hx hMin_x hCharts_A p_y hp_yx
      have hChartFin : ∀ w₀ : ↥C_cur,
          ((f_ss_cur.base ⁻¹' {y}) ∩ (V_pt w₀ : Set ↥C_cur)).Finite := by
        intro w₀
        let V_w := V_pt w₀
        have hVw : AlgebraicGeometry.IsAffineOpen V_w := hVpt_aff w₀
        let B_w_cat := C_cur.presheaf.obj (Opposite.op V_w)
        let B_w : Type u := ↑B_w_cat
        let γ_Bw : CommRingCat.of ↥V ⟶ B_w_cat :=
          AlgebraicGeometry.Spec.preimage (hVw.fromSpec ≫ g_cur)
        let _ : Algebra ↥V B_w := γ_Bw.hom.toAlgebra
        obtain ⟨hFT_Bw, hCharts_Bw⟩ := hAffBridge C_cur g_cur hSS_cur V_w hVw
        have _ : Algebra.FiniteType ↥V B_w := hFT_Bw
        let α_w : A_ss_cat ⟶ B_w_cat := f_ss_cur.appLE U_top V_w le_top
        have hcomp_w : α_w.hom.comp γ_A.hom = γ_Bw.hom := by
          have hcat : γ_A ≫ α_w = γ_Bw := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, hSpec_γA,
              AlgebraicGeometry.Spec.map_preimage, ← CategoryTheory.Category.assoc,
              AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_ss_cur hUtop hVw le_top,
              CategoryTheory.Category.assoc, hComm_fss]
          exact congrArg CommRingCat.Hom.hom hcat
        have _ : Algebra.FiniteType Q'.asIdeal.ResidueField (Q'.asIdeal.Fiber B_w) :=
          Algebra.FiniteType.baseChange Q'.asIdeal.ResidueField
        have _ : IsNoetherianRing (Q'.asIdeal.Fiber B_w) :=
          Algebra.FiniteType.isNoetherianRing Q'.asIdeal.ResidueField (Q'.asIdeal.Fiber B_w)
        have hMinFin_w :
            {q : PrimeSpectrum (Q'.asIdeal.Fiber B_w) |
              q.asIdeal ∈ minimalPrimes (Q'.asIdeal.Fiber B_w)}.Finite := by
          have hfin_id : (minimalPrimes (Q'.asIdeal.Fiber B_w)).Finite :=
            minimalPrimes.finite_of_isNoetherianRing (Q'.asIdeal.Fiber B_w)
          exact hfin_id.preimage (fun q₁ _ q₂ _ h => PrimeSpectrum.ext h)
        let S_py : Set (PrimeSpectrum B_w) :=
          {p_z : PrimeSpectrum B_w | PrimeSpectrum.comap α_w.hom p_z = p_y}
        have hSpy_fin : S_py.Finite := by
          have hSub_min : ∀ p_z ∈ S_py,
              ∃ hpz : PrimeSpectrum.comap (algebraMap ↥V B_w) p_z = Q',
                (PrimeSpectrum.preimageHomeomorphFiber ↥V B_w Q' ⟨p_z, hpz⟩).asIdeal ∈
                  minimalPrimes (Q'.asIdeal.Fiber B_w) := by
            intro p_z hpz_y
            have hpz_Q : PrimeSpectrum.comap (algebraMap ↥V B_w) p_z = Q' := by
              apply PrimeSpectrum.ext
              ext t
              have ht : α_w.hom (γ_A.hom t) = γ_Bw.hom t :=
                congrArg (fun g => g t) hcomp_w
              change γ_Bw.hom t ∈ p_z.asIdeal ↔ γ_A.hom t ∈ p_y.asIdeal
              rw [← ht, ← congrArg PrimeSpectrum.asIdeal hpz_y]
              rfl
            refine ⟨hpz_Q, ?_⟩
            by_contra hNotMin
            have hAlg :=
              (weil_semistable_algebra_fiber_dichotomy_and_finiteness
                K V B_w Q' hCharts_Bw).2.2 p_z hpz_Q hNotMin
            let φ_Qy := Ideal.ResidueField.map Q'.asIdeal p_y.asIdeal γ_A.hom rfl
            let φ_Qz := Ideal.ResidueField.map Q'.asIdeal p_z.asIdeal γ_Bw.hom
              (congrArg PrimeSpectrum.asIdeal hpz_Q.symm)
            let φ_yz := Ideal.ResidueField.map p_y.asIdeal p_z.asIdeal α_w.hom
              (congrArg PrimeSpectrum.asIdeal hpz_y.symm)
            let _ : Algebra Q'.asIdeal.ResidueField p_y.asIdeal.ResidueField := φ_Qy.toAlgebra
            let _ : Algebra Q'.asIdeal.ResidueField p_z.asIdeal.ResidueField := φ_Qz.toAlgebra
            let _ : Algebra p_y.asIdeal.ResidueField p_z.asIdeal.ResidueField := φ_yz.toAlgebra
            have hTower_eq : φ_yz.comp φ_Qy = φ_Qz := by
              apply IsLocalization.ringHom_ext (nonZeroDivisors (↥V ⧸ Q'.asIdeal))
              apply Ideal.Quotient.ringHom_ext
              ext r
              change φ_yz (φ_Qy ((algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField)
                  (Ideal.Quotient.mk Q'.asIdeal r))) =
                φ_Qz ((algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField)
                  (Ideal.Quotient.mk Q'.asIdeal r))
              calc
                φ_yz (φ_Qy ((algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField)
                    (Ideal.Quotient.mk Q'.asIdeal r)))
                    = φ_yz (φ_Qy (algebraMap ↥V Q'.asIdeal.ResidueField r)) := rfl
                _ = φ_yz (algebraMap A_ss p_y.asIdeal.ResidueField (γ_A.hom r)) :=
                      congrArg φ_yz (Ideal.ResidueField.map_algebraMap _ _ _ _ r)
                _ = algebraMap B_w p_z.asIdeal.ResidueField (α_w.hom (γ_A.hom r)) :=
                      Ideal.ResidueField.map_algebraMap _ _ _ _ (γ_A.hom r)
                _ = algebraMap B_w p_z.asIdeal.ResidueField (γ_Bw.hom r) :=
                      congrArg (algebraMap B_w p_z.asIdeal.ResidueField)
                        (congrArg (fun g => g r) hcomp_w)
                _ = φ_Qz ((algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField)
                      (Ideal.Quotient.mk Q'.asIdeal r)) :=
                      (Ideal.ResidueField.map_algebraMap _ _ _ _ r).symm
            have _ : IsScalarTower Q'.asIdeal.ResidueField
                p_y.asIdeal.ResidueField p_z.asIdeal.ResidueField :=
              IsScalarTower.of_algebraMap_eq' hTower_eq.symm
            have hTr_z : Transcendental Q'.asIdeal.ResidueField (φ_yz t_y) :=
              (transcendental_algebraMap_iff (RingHom.injective φ_yz)).mpr ht_y
            exact hTr_z (hAlg (φ_yz t_y))
          have _ : Finite ↥{q : PrimeSpectrum (Q'.asIdeal.Fiber B_w) |
              q.asIdeal ∈ minimalPrimes (Q'.asIdeal.Fiber B_w)} := hMinFin_w.to_subtype
          let emb : ↥S_py → PrimeSpectrum (Q'.asIdeal.Fiber B_w) :=
            fun pz => PrimeSpectrum.preimageHomeomorphFiber ↥V B_w Q'
              ⟨pz.1, (hSub_min pz.1 pz.2).1⟩
          have hEmb_inj : Function.Injective emb := by
            intro a b hab
            have hsub := (PrimeSpectrum.preimageHomeomorphFiber ↥V B_w Q').injective hab
            exact Subtype.ext (congrArg (fun x => x.1) hsub)
          have hRange_sub : Set.range emb ⊆
              {q : PrimeSpectrum (Q'.asIdeal.Fiber B_w) |
                q.asIdeal ∈ minimalPrimes (Q'.asIdeal.Fiber B_w)} := by
            rintro _ ⟨pz, rfl⟩
            exact (hSub_min pz.1 pz.2).2
          have _ : Finite ↥S_py :=
            Finite.of_injective (Set.codRestrict emb _ (fun pz => hRange_sub ⟨pz, rfl⟩))
              (fun a b h => hEmb_inj (congrArg Subtype.val h))
          exact Set.toFinite S_py
        have hSub_img : (f_ss_cur.base ⁻¹' {y}) ∩ (V_w : Set ↥C_cur) ⊆
            hVw.fromSpec.base '' S_py := by
          rintro z ⟨hzy, hz_Vw⟩
          change f_ss_cur.base z = y at hzy
          let pz : PrimeSpectrum B_w := hVw.primeIdealOf ⟨z, hz_Vw⟩
          refine ⟨pz, ?_, hVw.fromSpec_primeIdealOf ⟨z, hz_Vw⟩⟩
          apply hUtop.fromSpec.isOpenEmbedding.injective
          have h1 : hUtop.fromSpec.base (PrimeSpectrum.comap α_w.hom pz) =
              (hVw.fromSpec ≫ f_ss_cur).base pz := by
            rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
              f_ss_cur hUtop hVw le_top]
            rfl
          rw [h1, hUtop.fromSpec_primeIdealOf]
          change f_ss_cur.base (hVw.fromSpec.base pz) = y
          rw [hVw.fromSpec_primeIdealOf]
          exact hzy
        exact (hSpy_fin.image hVw.fromSpec.base).subset hSub_img
      have hCover_y : f_ss_cur.base ⁻¹' {y} ⊆
          ⋃ w₀ ∈ (S_cov : Set ↥C_cur), ((f_ss_cur.base ⁻¹' {y}) ∩ (V_pt w₀ : Set ↥C_cur)) := by
        intro z hzy
        obtain ⟨w₀, hw₀_S, hz_Vw₀⟩ := Set.mem_iUnion₂.mp (hS_cov (Set.mem_univ z))
        exact Set.mem_iUnion₂.mpr ⟨w₀, hw₀_S, hzy, hz_Vw₀⟩
      exact (S_cov.finite_toSet.biUnion fun w₀ _ => hChartFin w₀).subset hCover_y
    obtain ⟨U_x, hx_Ux, hIso_Ux⟩ :=
      weil_stalk_quasiFinite_proper_birational_iso_nhd
        C_cur U_ss F_ss f_ss_cur η_cur η_ss
        hAff_ss hSS_cur.1 hSS.1 hNorm_ss hProp_fss hη_cur hFunc_cur hFunc_ss x hFinGen
    exact le_iSup (fun i : ι_cov => i.1) ⟨U_x, hIso_Ux⟩ hx_Ux
  
  let M_all : Set ↥U_ss := (U_iso : Set ↥U_ss)ᶜ
  have hM_cl : IsClosed M_all := U_iso.isOpen.isClosed_compl
  have hFibFin : ∀ Q : PrimeSpectrum ↥V, (M_all ∩ g_ss.base ⁻¹' {Q}).Finite := by
    intro Q
    let e_fib := (PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q).symm
    let Φ_Q : PrimeSpectrum (Q.asIdeal.Fiber A_ss) → ↥U_ss :=
      fun q => hUtop.fromSpec.base (e_fib q).1
    have hTopSpec : Continuous (fun p : PrimeSpectrum A_ss => (p : ↥(AlgebraicGeometry.Spec A_ss_cat))) :=
      continuous_id
    have hΦ_cont : Continuous Φ_Q :=
      hUtop.fromSpec.continuous.comp
        (hTopSpec.comp ((@continuous_subtype_val (PrimeSpectrum A_ss) _ _).comp e_fib.continuous))
    let Z_Q : Set (PrimeSpectrum (Q.asIdeal.Fiber A_ss)) := Φ_Q ⁻¹' M_all
    have hZQ_cl : IsClosed Z_Q := hM_cl.preimage hΦ_cont
    have hZQ_notMin : ∀ q ∈ Z_Q, q.asIdeal ∉ minimalPrimes (Q.asIdeal.Fiber A_ss) := by
      intro q hq_Z hq_min
      apply hq_Z
      let px_sub := e_fib q
      have hq_eq : PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q px_sub = q :=
        (PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q).apply_symm_apply q
      have hpx_min : (PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q px_sub).asIdeal ∈
          minimalPrimes (Q.asIdeal.Fiber A_ss) := by
        rw [hq_eq]; exact hq_min
      exact hMinInUiso Q px_sub.1 px_sub.2 hpx_min
    have hZQ_fin : Z_Q.Finite :=
      (weil_semistable_algebra_fiber_dichotomy_and_finiteness
        K V A_ss Q hCharts_A).2.1 Z_Q hZQ_cl hZQ_notMin
    have hSub_Q : M_all ∩ g_ss.base ⁻¹' {Q} ⊆ Φ_Q '' Z_Q := by
      rintro u ⟨hu_M, hu_Q⟩
      change g_ss.base u = Q at hu_Q
      let pu : PrimeSpectrum A_ss := hUtop.primeIdealOf ⟨u, trivial⟩
      have hpu_u : hUtop.fromSpec.base pu = u := hUtop.fromSpec_primeIdealOf ⟨u, trivial⟩
      have hpu_Q : PrimeSpectrum.comap (algebraMap ↥V A_ss) pu = Q := by
        change (AlgebraicGeometry.Spec.map γ_A).base pu = Q
        rw [hSpec_γA]
        change g_ss.base (hUtop.fromSpec.base pu) = Q
        rw [hpu_u]
        exact hu_Q
      let q : PrimeSpectrum (Q.asIdeal.Fiber A_ss) :=
        PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q ⟨pu, hpu_Q⟩
      have he_q : e_fib q = ⟨pu, hpu_Q⟩ :=
        (PrimeSpectrum.preimageHomeomorphFiber ↥V A_ss Q).symm_apply_apply ⟨pu, hpu_Q⟩
      have hΦ_q : Φ_Q q = u := by
        change hUtop.fromSpec.base (e_fib q).1 = u
        rw [he_q]
        exact hpu_u
      have hq_Z : q ∈ Z_Q := by
        change Φ_Q q ∈ M_all
        rwa [hΦ_q]
      exact ⟨q, hq_Z, hΦ_q⟩
    exact (hZQ_fin.image Φ_Q).subset hSub_Q
  have hMall_fin : M_all.Finite := by
    have hCover_Q : M_all ⊆ ⋃ Q ∈ (Set.univ : Set (PrimeSpectrum ↥V)),
        (M_all ∩ g_ss.base ⁻¹' {Q}) := by
      intro u hu
      exact Set.mem_iUnion₂.mpr ⟨g_ss.base u, trivial, hu, rfl⟩
    exact (hPkg.1.biUnion fun Q _ => hFibFin Q).subset hCover_Q
  exact ⟨U_iso, hIso_Uiso, hMall_fin, hBot_Mall⟩

theorem weil_strictlySemistable_centered_affine_etale_chart_over_ofPrime (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K)
    (P : PrimeSpectrum ↥V)
    (hPkg_VP : IsValuationRingAlgPackage m (V.ofPrime P.asIdeal))
    (hMax_VP : IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥)
    (ϖ : ↥V)
    (hϖ_P : ϖ ∉ P.asIdeal)
    (hϖ_mem : ∀ x : K, x ∈ V.ofPrime P.asIdeal ↔
      ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a)
    (hOpen_VP : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))))
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (u₀ : ↥U_ss)
    (hu₀_cl : IsClosed ({u₀} : Set ↥U_ss))
    (hu₀_P : g_ss.base u₀ = P) :
    ∃ (W₁ : U_ss.Opens) (hW₁ : AlgebraicGeometry.IsAffineOpen W₁) (hu₀₁ : u₀ ∈ W₁)
      (g_W₁ : W₁.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal))),
      let ι_VP : ↥V →+* ↥(V.ofPrime P.asIdeal) :=
        Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
      let p₀ : PrimeSpectrum ↑(U_ss.presheaf.obj (Opposite.op W₁)) :=
        hW₁.primeIdealOf ⟨u₀, hu₀₁⟩
      g_W₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) = W₁.ι ≫ g_ss ∧
      (g_W₁.base ⟨u₀, hu₀₁⟩).asIdeal = IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ∧
      ((∃ (ψ₁ : CommRingCat.of (Polynomial ↥(V.ofPrime P.asIdeal)) ⟶
            U_ss.presheaf.obj (Opposite.op W₁))
          (m₀ : PrimeSpectrum (Polynomial ↥(V.ofPrime P.asIdeal))),
          ψ₁.hom.Etale ∧
          W₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ₁ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = g_W₁ ∧
          Polynomial.X ∈ m₀.asIdeal ∧
          (∀ r : ↥(V.ofPrime P.asIdeal), r ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) →
            Polynomial.C r ∈ m₀.asIdeal) ∧
          Ideal.comap ψ₁.hom p₀.asIdeal = m₀.asIdeal ∧
          ∀ b : ↑(U_ss.presheaf.obj (Opposite.op W₁)),
            ∃ r : ↥(V.ofPrime P.asIdeal), b - ψ₁.hom (Polynomial.C r) ∈ p₀.asIdeal) ∨
       (∃ (a₀ : ↥(V.ofPrime P.asIdeal))
          (ψ₁ : CommRingCat.of
            (MvPolynomial (Fin 2) ↥(V.ofPrime P.asIdeal) ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) ⟶
            U_ss.presheaf.obj (Opposite.op W₁))
          (m₀ : PrimeSpectrum
            (MvPolynomial (Fin 2) ↥(V.ofPrime P.asIdeal) ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})),
          a₀ ≠ 0 ∧
          a₀ ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ∧
          ψ₁.hom.Etale ∧
          W₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ₁ ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = g_W₁ ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ m₀.asIdeal) ∧
          (∀ r : ↥(V.ofPrime P.asIdeal), r ∈ IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) →
            Ideal.Quotient.mk _ (MvPolynomial.C r) ∈ m₀.asIdeal) ∧
          Ideal.comap ψ₁.hom p₀.asIdeal = m₀.asIdeal ∧
          ∀ b : ↑(U_ss.presheaf.obj (Opposite.op W₁)),
            ∃ r : ↥(V.ofPrime P.asIdeal),
              b - ψ₁.hom (Ideal.Quotient.mk _ (MvPolynomial.C r)) ∈ p₀.asIdeal)) :=
by
  classical
  
  have hEtaleOfComp : ∀ {A₀ A₁ B : Type u} [CommRing A₀] [CommRing A₁] [CommRing B]
      (lam : A₀ →+* A₁) (ψ₁ : A₁ →+* B),
      lam.Etale → (ψ₁.comp lam).Etale → ψ₁.Etale := by
    intro A₀ A₁ B _ _ _ lam ψ₁ hlam hcomp
    let f := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)
    let g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam)
    have hfg : f ≫ g = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁.comp lam)) := by
      dsimp [f, g]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have _ : AlgebraicGeometry.Etale g :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hlam
    have _ : AlgebraicGeometry.Etale (f ≫ g) := by
      rw [hfg]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hcomp
    have hf : AlgebraicGeometry.Etale f := AlgebraicGeometry.Etale.of_comp f g
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hf
  
  have hS1Smooth : ∀ {R₀ R₁ B : Type u} [CommRing R₀] [CommRing R₁] [CommRing B]
      [Algebra R₀ R₁] (w : R₀) [IsLocalization.Away w R₁] (γ₁ : R₁ →+* B)
      (ψ₀ : Polynomial R₀ →+* B),
      ψ₀.Etale → ψ₀.comp Polynomial.C = γ₁.comp (algebraMap R₀ R₁) →
      ∃ ψ₁ : Polynomial R₁ →+* B, ψ₁.Etale ∧ ψ₁.comp Polynomial.C = γ₁ := by
    intro R₀ R₁ B _ _ _ _ w _ γ₁ ψ₀ hEt₀ hComm₀
    letI : Algebra (Polynomial R₀) (Polynomial R₁) := Polynomial.algebra R₀ R₁
    let lam_sm : Polynomial R₀ →+* Polynomial R₁ := algebraMap (Polynomial R₀) (Polynomial R₁)
    have hLoc_poly :
        IsLocalization (Submonoid.map Polynomial.C (Submonoid.powers w)) (Polynomial R₁) :=
      Polynomial.isLocalization (Submonoid.powers w) R₁
    rw [Submonoid.map_powers] at hLoc_poly
    have _ : IsLocalization.Away (Polynomial.C w : Polynomial R₀) (Polynomial R₁) := hLoc_poly
    have _ : Algebra.Etale (Polynomial R₀) (Polynomial R₁) :=
      Algebra.Etale.of_isLocalizationAway (Polynomial.C w : Polynomial R₀)
    have hlam_et : lam_sm.Etale := RingHom.etale_algebraMap.mpr inferInstance
    let ψ₁ : Polynomial R₁ →+* B := Polynomial.eval₂RingHom γ₁ (ψ₀ Polynomial.X)
    have hψ₁_C : ψ₁.comp Polynomial.C = γ₁ := by
      ext r
      simp [ψ₁]
    have hψ₁_comp : ψ₁.comp lam_sm = ψ₀ := by
      apply Polynomial.ringHom_ext'
      · ext r₀
        have hlam_C : lam_sm (Polynomial.C r₀) = Polynomial.C (algebraMap R₀ R₁ r₀) := by
          change (Polynomial.mapRingHom (algebraMap R₀ R₁)) (Polynomial.C r₀) = _
          simp
        calc (ψ₁.comp lam_sm) (Polynomial.C r₀)
            = ψ₁ (Polynomial.C (algebraMap R₀ R₁ r₀)) := by simp [hlam_C]
          _ = γ₁ (algebraMap R₀ R₁ r₀) := by simp [ψ₁]
          _ = (ψ₀.comp Polynomial.C) r₀ := by rw [hComm₀]; rfl
          _ = ψ₀ (Polynomial.C r₀) := rfl
      · have hlam_X : lam_sm Polynomial.X = Polynomial.X := by
          change (Polynomial.mapRingHom (algebraMap R₀ R₁)) Polynomial.X = _
          simp
        simp [ψ₁, hlam_X]
    have hcomp_et : (ψ₁.comp lam_sm).Etale := by
      rw [hψ₁_comp]
      exact hEt₀
    exact ⟨ψ₁, hEtaleOfComp lam_sm ψ₁ hlam_et hcomp_et, hψ₁_C⟩
  
  have hS1Nodal : ∀ {R₀ R₁ B : Type u} [CommRing R₀] [CommRing R₁] [CommRing B]
      [Algebra R₀ R₁] (w : R₀) [IsLocalization.Away w R₁] (γ₁ : R₁ →+* B) (a : R₀)
      (ψ₀ : (MvPolynomial (Fin 2) R₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* B),
      ψ₀.Etale →
      ψ₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = γ₁.comp (algebraMap R₀ R₁) →
      ∃ ψ₁ : (MvPolynomial (Fin 2) R₁ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (algebraMap R₀ R₁ a)}) →+* B,
        ψ₁.Etale ∧ ψ₁.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = γ₁ := by
    intro R₀ R₁ B _ _ _ _ w _ γ₁ a ψ₀ hEt₀ hComm₀
    letI : Algebra (MvPolynomial (Fin 2) R₀) (MvPolynomial (Fin 2) R₁) :=
      MvPolynomial.algebraMvPolynomial
    let f₀ : MvPolynomial (Fin 2) R₀ := MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a
    let f₁ : MvPolynomial (Fin 2) R₁ :=
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (algebraMap R₀ R₁ a)
    let I₀ : Ideal (MvPolynomial (Fin 2) R₀) := Ideal.span {f₀}
    let I₁ : Ideal (MvPolynomial (Fin 2) R₁) := Ideal.span {f₁}
    let A₀ := MvPolynomial (Fin 2) R₀ ⧸ I₀
    let A₁ := MvPolynomial (Fin 2) R₁ ⧸ I₁
    let μ : MvPolynomial (Fin 2) R₀ →+* MvPolynomial (Fin 2) R₁ :=
      MvPolynomial.map (algebraMap R₀ R₁)
    have hAlg_mv : algebraMap (MvPolynomial (Fin 2) R₀) (MvPolynomial (Fin 2) R₁) = μ := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [μ]
      · intro i; simp [μ]
    have hLoc_mv : IsLocalization
        (Submonoid.map MvPolynomial.C (Submonoid.powers w)) (MvPolynomial (Fin 2) R₁) :=
      MvPolynomial.isLocalization (Submonoid.powers w) R₁
    rw [Submonoid.map_powers] at hLoc_mv
    have _ : IsLocalization.Away (MvPolynomial.C w : MvPolynomial (Fin 2) R₀)
        (MvPolynomial (Fin 2) R₁) := hLoc_mv
    have hμ_f₀ : μ f₀ = f₁ := by simp [μ, f₀, f₁]
    have hI₀_ker : ∀ p ∈ I₀, ((Ideal.Quotient.mk I₁).comp μ) p = 0 := by
      intro p hp
      rcases Ideal.mem_span_singleton.mp hp with ⟨q, rfl⟩
      simp only [RingHom.comp_apply, map_mul, hμ_f₀]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨μ q, rfl⟩)
    let lam_nod : A₀ →+* A₁ := Ideal.Quotient.lift I₀ ((Ideal.Quotient.mk I₁).comp μ) hI₀_ker
    letI : Algebra A₀ A₁ := lam_nod.toAlgebra
    have hAlg_A : algebraMap A₀ A₁ = lam_nod := rfl
    let w_A₀ : A₀ := Ideal.Quotient.mk I₀ (MvPolynomial.C w)
    have _ : IsLocalization.Away w_A₀ A₁ := by
      rw [IsLocalization.Away, isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, k, rfl⟩
        rw [hAlg_A, map_pow]
        apply IsUnit.pow
        change IsUnit (Ideal.Quotient.mk I₁ (μ (MvPolynomial.C w)))
        rw [← hAlg_mv]
        have hw_mem : (MvPolynomial.C w : MvPolynomial (Fin 2) R₀) ∈
            Submonoid.powers (MvPolynomial.C w : MvPolynomial (Fin 2) R₀) := ⟨1, pow_one _⟩
        exact (IsLocalization.map_units (MvPolynomial (Fin 2) R₁) ⟨MvPolynomial.C w, hw_mem⟩).map
          (Ideal.Quotient.mk I₁)
      · intro z_bar
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z_bar
        obtain ⟨⟨x, ⟨_, k, rfl⟩⟩, hzx⟩ :=
          IsLocalization.surj (Submonoid.powers (MvPolynomial.C w : MvPolynomial (Fin 2) R₀)) z
        dsimp only at hzx
        rw [hAlg_mv] at hzx
        refine ⟨(Ideal.Quotient.mk I₀ x, ⟨w_A₀ ^ k, k, rfl⟩), ?_⟩
        dsimp only
        rw [hAlg_A]
        change Ideal.Quotient.mk I₁ z * Ideal.Quotient.mk I₁ (μ (MvPolynomial.C w ^ k)) =
          Ideal.Quotient.mk I₁ (μ x)
        rw [← map_mul, hzx]
      · intro x_bar y_bar hxy
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
        rw [hAlg_A] at hxy
        have hsub_mem : μ (x - y) ∈ I₁ := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub]
          exact sub_eq_zero.mpr hxy
        rcases Ideal.mem_span_singleton.mp hsub_mem with ⟨g, hg⟩
        obtain ⟨⟨h, ⟨_, k, rfl⟩⟩, hgk⟩ :=
          IsLocalization.surj (Submonoid.powers (MvPolynomial.C w : MvPolynomial (Fin 2) R₀)) g
        dsimp only at hgk
        rw [hAlg_mv] at hgk
        have hμ_eq : algebraMap (MvPolynomial (Fin 2) R₀) (MvPolynomial (Fin 2) R₁)
              ((x - y) * MvPolynomial.C w ^ k) =
            algebraMap (MvPolynomial (Fin 2) R₀) (MvPolynomial (Fin 2) R₁) (f₀ * h) := by
          rw [hAlg_mv, map_mul, hg, ← hμ_f₀, mul_assoc, hgk, ← map_mul]
        rcases (IsLocalization.eq_iff_exists
            (Submonoid.powers (MvPolynomial.C w : MvPolynomial (Fin 2) R₀))
            (MvPolynomial (Fin 2) R₁)).mp hμ_eq
          with ⟨⟨_, n, rfl⟩, hclear⟩
        dsimp only at hclear
        refine ⟨⟨w_A₀ ^ (n + k), n + k, rfl⟩, ?_⟩
        dsimp only
        have hmem_I₀ : MvPolynomial.C w ^ (n + k) * x - MvPolynomial.C w ^ (n + k) * y ∈ I₀ := by
          refine Ideal.mem_span_singleton.mpr ⟨MvPolynomial.C w ^ n * h, ?_⟩
          calc MvPolynomial.C w ^ (n + k) * x - MvPolynomial.C w ^ (n + k) * y
              = MvPolynomial.C w ^ n * ((x - y) * MvPolynomial.C w ^ k) := by
                rw [pow_add]; ring
            _ = MvPolynomial.C w ^ n * (f₀ * h) := hclear
            _ = f₀ * (MvPolynomial.C w ^ n * h) := by ring
        change Ideal.Quotient.mk I₀ (MvPolynomial.C w) ^ (n + k) * Ideal.Quotient.mk I₀ x =
          Ideal.Quotient.mk I₀ (MvPolynomial.C w) ^ (n + k) * Ideal.Quotient.mk I₀ y
        rw [← map_pow, ← map_mul, ← map_mul]
        exact sub_eq_zero.mp (by rw [← map_sub]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem_I₀)
    have hlam_et : lam_nod.Etale := by
      change Algebra.Etale A₀ A₁
      exact Algebra.Etale.of_isLocalizationAway w_A₀
    let ψ₁_tilde : MvPolynomial (Fin 2) R₁ →+* B :=
      MvPolynomial.eval₂Hom γ₁ (fun i => ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X i)))
    have hI₁_ker : ∀ p ∈ I₁, ψ₁_tilde p = 0 := by
      intro p hp
      rcases Ideal.mem_span_singleton.mp hp with ⟨q, rfl⟩
      rw [map_mul]
      suffices hf₁ : ψ₁_tilde f₁ = 0 by rw [hf₁, zero_mul]
      have ha_eq : γ₁ (algebraMap R₀ R₁ a) = ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C a)) :=
        (RingHom.congr_fun hComm₀ a).symm
      have hf₀_zero : Ideal.Quotient.mk I₀ f₀ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      calc ψ₁_tilde f₁
          = ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 0)) *
              ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) - γ₁ (algebraMap R₀ R₁ a) := by
            simp [ψ₁_tilde, f₁]
        _ = ψ₀ (Ideal.Quotient.mk I₀ f₀) := by rw [ha_eq]; simp [f₀]
        _ = 0 := by rw [hf₀_zero, map_zero]
    let ψ₁ : A₁ →+* B := Ideal.Quotient.lift I₁ ψ₁_tilde hI₁_ker
    have hψ₁_C : ψ₁.comp ((Ideal.Quotient.mk I₁).comp MvPolynomial.C) = γ₁ := by
      ext r
      change ψ₁_tilde (MvPolynomial.C r) = γ₁ r
      simp [ψ₁_tilde]
    have hψ₁_comp : ψ₁.comp lam_nod = ψ₀ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r₀
        change ψ₁_tilde (μ (MvPolynomial.C r₀)) = ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C r₀))
        simp only [μ, MvPolynomial.map_C, ψ₁_tilde, MvPolynomial.eval₂Hom_C]
        exact (RingHom.congr_fun hComm₀ r₀).symm
      · intro i
        change ψ₁_tilde (μ (MvPolynomial.X i)) = ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X i))
        simp [μ, ψ₁_tilde]
    have hcomp_et : (ψ₁.comp lam_nod).Etale := by
      rw [hψ₁_comp]
      exact hEt₀
    exact ⟨ψ₁, hEtaleOfComp lam_nod ψ₁ hlam_et hcomp_et, hψ₁_C⟩
  
  have hS2NodalToSmooth : ∀ {R B : Type u} [CommRing R] [CommRing B] (a₀ : R)
      (ψ_nod : (MvPolynomial (Fin 2) R ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) →+* B),
      ψ_nod.Etale → ∀ i : Fin 2, IsUnit (ψ_nod (Ideal.Quotient.mk _ (MvPolynomial.X i))) →
      ∃ ψ_sm : Polynomial R →+* B,
        ψ_sm.Etale ∧
        ψ_sm.comp Polynomial.C = ψ_nod.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) := by
    intro R B _ _ a₀ ψ_nod hEt i hUnit
    let I : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
    let A_nod := MvPolynomial (Fin 2) R ⧸ I
    let C_nod : R →+* A_nod := (Ideal.Quotient.mk I).comp MvPolynomial.C
    let xbar : Fin 2 → A_nod := fun j => Ideal.Quotient.mk I (MvPolynomial.X j)
    have hxbar_rel : xbar 0 * xbar 1 = C_nod a₀ := by
      have h0 : Ideal.Quotient.mk I (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, map_mul] at h0
      exact sub_eq_zero.mp h0
    let L_T := Localization.Away (Polynomial.X : Polynomial R)
    let loc_T : Polynomial R →+* L_T := algebraMap (Polynomial R) L_T
    let t_inv : L_T := IsLocalization.Away.invSelf (S := L_T) (Polynomial.X : Polynomial R)
    have ht_mul : loc_T Polynomial.X * t_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_T) (Polynomial.X : Polynomial R)
    have hUnit_LT : IsUnit (loc_T Polynomial.X) :=
      ⟨⟨loc_T Polynomial.X, t_inv, ht_mul, by rw [mul_comm, ht_mul]⟩, rfl⟩
    let L_X := Localization.Away (xbar i)
    let loc_X : A_nod →+* L_X := algebraMap A_nod L_X
    let u_inv : L_X := IsLocalization.Away.invSelf (S := L_X) (xbar i)
    have hu_mul : loc_X (xbar i) * u_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_X) (xbar i)
    have hUnit_LX : IsUnit (loc_X (xbar i)) :=
      ⟨⟨loc_X (xbar i), u_inv, hu_mul, by rw [mul_comm, hu_mul]⟩, rfl⟩
    let θ_i : Polynomial R →+* A_nod := Polynomial.eval₂RingHom C_nod (xbar i)
    have hθ_X : θ_i Polynomial.X = xbar i := by simp [θ_i]
    have hθ_C : ∀ r : R, θ_i (Polynomial.C r) = C_nod r := fun r => by simp [θ_i]
    have hθ_unit : IsUnit ((loc_X.comp θ_i) Polynomial.X) := by
      change IsUnit (loc_X (θ_i Polynomial.X))
      rw [hθ_X]
      exact hUnit_LX
    let Φ_i : L_T →+* L_X := IsLocalization.Away.lift (Polynomial.X : Polynomial R) hθ_unit
    have hΦ_loc : ∀ p : Polynomial R, Φ_i (loc_T p) = loc_X (θ_i p) :=
      IsLocalization.Away.lift_eq (Polynomial.X : Polynomial R) hθ_unit
    have hΦ_tinv : Φ_i t_inv = u_inv := by
      apply hUnit_LX.mul_left_cancel
      have hX : loc_X (xbar i) = Φ_i (loc_T Polynomial.X) := by rw [hΦ_loc, hθ_X]
      calc loc_X (xbar i) * Φ_i t_inv
          = Φ_i (loc_T Polynomial.X) * Φ_i t_inv := by rw [hX]
        _ = Φ_i (loc_T Polynomial.X * t_inv) := (map_mul Φ_i _ _).symm
        _ = 1 := by rw [ht_mul, map_one]
        _ = loc_X (xbar i) * u_inv := hu_mul.symm
    let w_i : Fin 2 → L_T := fun j =>
      if j = i then loc_T Polynomial.X else loc_T (Polynomial.C a₀) * t_inv
    let α_tilde : MvPolynomial (Fin 2) R →+* L_T :=
      MvPolynomial.eval₂Hom (loc_T.comp Polynomial.C) w_i
    have hI_α : ∀ p ∈ I, α_tilde p = 0 := by
      intro p hp
      rcases Ideal.mem_span_singleton.mp hp with ⟨q, rfl⟩
      rw [map_mul]
      suffices hrel : α_tilde (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 by
        rw [hrel, zero_mul]
      simp only [α_tilde, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        RingHom.comp_apply]
      fin_cases i
      · dsimp [w_i]
        calc loc_T Polynomial.X * (loc_T (Polynomial.C a₀) * t_inv) - loc_T (Polynomial.C a₀)
            = loc_T (Polynomial.C a₀) * (loc_T Polynomial.X * t_inv) - loc_T (Polynomial.C a₀) := by
              ring
          _ = 0 := by rw [ht_mul, mul_one, sub_self]
      · dsimp [w_i]
        calc (loc_T (Polynomial.C a₀) * t_inv) * loc_T Polynomial.X - loc_T (Polynomial.C a₀)
            = loc_T (Polynomial.C a₀) * (loc_T Polynomial.X * t_inv) - loc_T (Polynomial.C a₀) := by
              ring
          _ = 0 := by rw [ht_mul, mul_one, sub_self]
    let α_i : A_nod →+* L_T := Ideal.Quotient.lift I α_tilde hI_α
    have hα_C : ∀ r : R, α_i (C_nod r) = loc_T (Polynomial.C r) := by
      intro r
      change α_tilde (MvPolynomial.C r) = loc_T (Polynomial.C r)
      simp [α_tilde]
    have hα_X : ∀ j : Fin 2, α_i (xbar j) = w_i j := by
      intro j
      change α_tilde (MvPolynomial.X j) = w_i j
      simp [α_tilde]
    have hα_unit : IsUnit (α_i (xbar i)) := by
      rw [hα_X, show w_i i = loc_T Polynomial.X by simp [w_i]]
      exact hUnit_LT
    let Ψ_i : L_X →+* L_T := IsLocalization.Away.lift (xbar i) hα_unit
    have hΨ_loc : ∀ z : A_nod, Ψ_i (loc_X z) = α_i z :=
      IsLocalization.Away.lift_eq (xbar i) hα_unit
    have hΨΦ : Ψ_i.comp Φ_i = RingHom.id L_T := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R))
      apply Polynomial.ringHom_ext'
      · ext r
        change Ψ_i (Φ_i (loc_T (Polynomial.C r))) = loc_T (Polynomial.C r)
        rw [hΦ_loc, hθ_C, hΨ_loc, hα_C]
      · change Ψ_i (Φ_i (loc_T Polynomial.X)) = loc_T Polynomial.X
        rw [hΦ_loc, hθ_X, hΨ_loc, hα_X]
        simp [w_i]
    have hΦΨ : Φ_i.comp Ψ_i = RingHom.id L_X := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (xbar i))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change Φ_i (Ψ_i (loc_X (C_nod r))) = loc_X (C_nod r)
        rw [hΨ_loc, hα_C, hΦ_loc, hθ_C]
      · intro j
        change Φ_i (Ψ_i (loc_X (xbar j))) = loc_X (xbar j)
        rw [hΨ_loc, hα_X]
        by_cases hji : j = i
        · subst hji
          simp only [w_i, ↓reduceIte]
          rw [hΦ_loc, hθ_X]
        · simp only [w_i, hji, ↓reduceIte, map_mul]
          rw [hΦ_loc, hθ_C, hΦ_tinv]
          apply hUnit_LX.mul_left_cancel
          have hprod_ij : xbar i * xbar j = C_nod a₀ := by
            fin_cases i <;> fin_cases j
            · exact absurd rfl hji
            · exact hxbar_rel
            · exact (mul_comm _ _).trans hxbar_rel
            · exact absurd rfl hji
          calc loc_X (xbar i) * (loc_X (C_nod a₀) * u_inv)
              = loc_X (C_nod a₀) * (loc_X (xbar i) * u_inv) := by ring
            _ = loc_X (C_nod a₀) := by rw [hu_mul, mul_one]
            _ = loc_X (xbar i * xbar j) := by rw [hprod_ij]
            _ = loc_X (xbar i) * loc_X (xbar j) := map_mul loc_X _ _
    have hΦ_bij : Function.Bijective Φ_i :=
      ⟨(show Function.LeftInverse Ψ_i Φ_i from fun x => RingHom.congr_fun hΨΦ x).injective,
       (show Function.RightInverse Ψ_i Φ_i from fun y => RingHom.congr_fun hΦΨ y).surjective⟩
    have hΦ_et : Φ_i.Etale := RingHom.Etale.of_bijective hΦ_bij
    have _ : Algebra.Etale (Polynomial R) L_T :=
      Algebra.Etale.of_isLocalizationAway (Polynomial.X : Polynomial R)
    have hlocT_et : loc_T.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have _ : Algebra.Etale A_nod L_X := Algebra.Etale.of_isLocalizationAway (xbar i)
    have hlocX_et : loc_X.Etale := RingHom.etale_algebraMap.mpr inferInstance
    let χ₁ : L_X →+* B := IsLocalization.Away.lift (xbar i) hUnit
    have hχ₁_comp : χ₁.comp loc_X = ψ_nod :=
      RingHom.ext fun z => IsLocalization.Away.lift_eq (xbar i) hUnit z
    have hχ₁_et : χ₁.Etale := by
