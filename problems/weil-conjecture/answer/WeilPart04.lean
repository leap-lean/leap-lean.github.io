        e₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C₀) = g_WB ∧
        e₀.base ⁻¹' {(m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀)))} = {u₀_WB} ∧
        ∀ y ∈ Z_mod, e₀.base ⁻¹' {e₀.base y} = {y} := by
    intro A₀ _ C₀ G₀ ψ₁ m₀ hFT_C₀ hG₀_m₀ hG₀_gen hEt hComm₁ hm₀_C₀ hp₀_m₀ hRes_p₀
    have hFT_ψ₁ : ψ₁.hom.FiniteType := by
      let _ : Algebra A₀ B₁ := ψ₁.hom.toAlgebra
      have _ : Algebra.Etale A₀ B₁ := hEt
      change Algebra.FiniteType A₀ B₁
      infer_instance
    have hFT_B₁ : (ψ₁.hom.comp C₀).FiniteType := hFT_ψ₁.comp hFT_C₀
    have hm₀_comap : Ideal.comap C₀ m₀.asIdeal = IsLocalRing.maximalIdeal ↥V_P := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
      · exact hm₀_C₀
    let M₁ : Set (PrimeSpectrum B₁) := hW₁.fromSpec.base ⁻¹' M_all
    have hM₁_cl : IsClosed M₁ := hM_cl.preimage hW₁.fromSpec.continuous
    have hM₁_fin : M₁.Finite := hM_fin.preimage hW₁.fromSpec.isOpenEmbedding.injective.injOn
    have hFromSpec_gss : hW₁.fromSpec ≫ g_ss =
        AlgebraicGeometry.Spec.map ψ₁ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom C₀) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) := by
      have h1 : hW₁.fromSpec ≫ g_ss = hW₁.isoSpec.inv ≫ W₁.ι ≫ g_ss := by
        rw [← CategoryTheory.Category.assoc, hW₁.isoSpec_inv_ι]
      rw [h1, ← hg_W₁, ← hComm₁, ← hW₁.isoSpec_hom]
      simp only [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id]
      simp only [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
    have hM₁_ne_bot : ∀ y ∈ M₁, Ideal.comap (ψ₁.hom.comp C₀) y.asIdeal ≠ ⊥ := by
      intro y hy hbot
      have hy_gss : (g_ss.base (hW₁.fromSpec.base y)).asIdeal ≠ ⊥ := hM_ne_bot _ hy
      apply hy_gss
      have hIdeal : (g_ss.base (hW₁.fromSpec.base y)).asIdeal =
