    let h_good : PrimeSpectrum B₁ → B₁ := fun y =>
      if hy : y ∈ M₁ ∧ y.asIdeal ≤ p₀.asIdeal then (hex_good y hy).choose else 1
    have hh_good_notMem : ∀ y ∈ F_good, h_good y ∉ p₀.asIdeal := by
