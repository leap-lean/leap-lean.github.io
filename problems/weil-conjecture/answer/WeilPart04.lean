      rwa [← Ideal.ker_algebraMap_residueField p_y.asIdeal, RingHom.mem_ker]
    have haP_px : a_P ∈ p_x.asIdeal := hyx haP_py
    have haP_x0 : algebraMap A p_x.asIdeal.ResidueField a_P = 0 := by
      rwa [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    have hprod_x0 : ρ_x (φ P) * algebraMap A p_x.asIdeal.ResidueField b ^ k = 0 := by
      have hbx : ρ_x (algebraMap A (Localization.Away b) b) =
          algebraMap A p_x.asIdeal.ResidueField b :=
        RingHom.congr_fun hρ_x_eq b
      calc
        ρ_x (φ P) * algebraMap A p_x.asIdeal.ResidueField b ^ k
            = ρ_x (φ P) * ρ_x (algebraMap A (Localization.Away b) b) ^ k := by rw [hbx]
        _ = ρ_x (φ P * algebraMap A (Localization.Away b) b ^ k) := by rw [map_mul, map_pow]
        _ = ρ_x (algebraMap A (Localization.Away b) a_P) := by rw [hk]
        _ = algebraMap A p_x.asIdeal.ResidueField a_P := RingHom.congr_fun hρ_x_eq a_P
        _ = 0 := haP_x0
    have hφP_x0 : ρ_x (φ P) = 0 :=
      (mul_eq_zero.mp hprod_x0).resolve_right (pow_ne_zero k hbx_ne)
    exact hφ_Q P hφP_x0 n
  have hMinDvd : ∀ (S : Finset ℕ), S.Nonempty → ∀ (f : ℕ → ↥V),
      ∃ i₀ ∈ S, ∀ j ∈ S, f i₀ ∣ f j := by
    intro S hS
    refine Finset.Nonempty.cons_induction (motive := fun s _ =>
      ∀ f : ℕ → ↥V, ∃ i₀ ∈ s, ∀ j ∈ s, f i₀ ∣ f j) ?_ ?_ hS
    · intro a₀ f
      refine ⟨a₀, Finset.mem_singleton_self a₀, ?_⟩
      intro j hj
      rw [Finset.mem_singleton.mp hj]
    · intro a₀ s ha₀ _ ih f
      obtain ⟨i₁, hi₁, hdvd₁⟩ := ih f
      rcases ValuationRing.dvd_total (f a₀) (f i₁) with h_a_i₁ | h_i₁_a
      · refine ⟨a₀, Finset.mem_cons_self a₀ s, ?_⟩
        intro j hj
        rcases Finset.mem_cons.mp hj with rfl | hjs
        · exact dvd_rfl
        · exact dvd_trans h_a_i₁ (hdvd₁ j hjs)
      · refine ⟨i₁, Finset.mem_cons.mpr (Or.inr hi₁), ?_⟩
        intro j hj
        rcases Finset.mem_cons.mp hj with rfl | hjs
        · exact h_i₁_a
        · exact hdvd₁ j hjs
  have hr_y_Q' : ∀ P : Polynomial ↥V, P ∈ r_y → ∀ n : ℕ, P.coeff n ∈ Q'.asIdeal := by
    intro P hP j₁
    by_contra hj₁
    have hj₁_ne : P.coeff j₁ ≠ 0 := fun h0 => hj₁ (h0 ▸ Q'.asIdeal.zero_mem)
    have hj₁_supp : j₁ ∈ P.support := Polynomial.mem_support_iff.mpr hj₁_ne
    obtain ⟨i₀, hi₀_supp, hdvd⟩ := hMinDvd P.support ⟨j₁, hj₁_supp⟩ (fun j => P.coeff j)
    let c₀ : ↥V := P.coeff i₀
    have hc₀_ne : c₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀_supp
    have hc₀_not_Q' : c₀ ∉ Q'.asIdeal := by
      intro hc₀_in
      obtain ⟨u, hu⟩ := hdvd j₁ hj₁_supp
      apply hj₁
      rw [hu]
      exact Q'.asIdeal.mul_mem_right u hc₀_in
    have hCc₀_not_ry : Polynomial.C c₀ ∉ r_y := fun hmem => hc₀_not_Q' ((hr_y_C c₀).mp hmem)
    have hDvdAll : ∀ j : ℕ, ∃ d : ↥V, P.coeff j = c₀ * d := by
      intro j
      by_cases hj : j ∈ P.support
      · exact hdvd j hj
      · rw [Polynomial.notMem_support_iff.mp hj]
        exact ⟨0, (mul_zero c₀).symm⟩
    choose d hd using hDvdAll
    have hd_i₀ : d i₀ = 1 := by
      apply mul_left_cancel₀ hc₀_ne
      rw [← hd i₀, mul_one]
    let P₁ : Polynomial ↥V := ∑ j ∈ P.support, Polynomial.monomial j (d j)
    have hP_fac : Polynomial.C c₀ * P₁ = P := by
      calc
        Polynomial.C c₀ * (∑ j ∈ P.support, Polynomial.monomial j (d j))
            = ∑ j ∈ P.support, Polynomial.C c₀ * Polynomial.monomial j (d j) := Finset.mul_sum _ _ _
        _ = ∑ j ∈ P.support, Polynomial.monomial j (c₀ * d j) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Polynomial.C_mul_monomial]
        _ = ∑ j ∈ P.support, Polynomial.monomial j (P.coeff j) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← hd j]
        _ = P := P.as_sum_support.symm
    have hP₁_i₀ : P₁.coeff i₀ = 1 := by
      dsimp [P₁]
      rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single i₀]
      · simp [hd_i₀]
      · intro j _ hji₀
        simp [Polynomial.coeff_monomial, hji₀]
      · intro hnot
        exact absurd hi₀_supp hnot
    have hprod_ry : Polynomial.C c₀ * P₁ ∈ r_y := by rwa [hP_fac]
    have hP₁_ry : P₁ ∈ r_y := (hr_y_prime.mem_or_mem hprod_ry).resolve_left hCc₀_not_ry
    have h1_Q : (1 : ↥V) ∈ Q.asIdeal := by
      rw [← hP₁_i₀]
      exact hr_y_le_Q P₁ hP₁_ry i₀
    exact Q.isPrime.one_notMem h1_Q
  
  let φ_Qy : Q'.asIdeal.ResidueField →+* p_y.asIdeal.ResidueField :=
    Ideal.ResidueField.map Q'.asIdeal p_y.asIdeal (algebraMap ↥V A) rfl
  let _ : Algebra Q'.asIdeal.ResidueField p_y.asIdeal.ResidueField := φ_Qy.toAlgebra
  let _ : Algebra (↥V ⧸ Q'.asIdeal) p_y.asIdeal.ResidueField :=
    (φ_Qy.comp (algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField)).toAlgebra
  have _ : IsScalarTower (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField p_y.asIdeal.ResidueField :=
    IsScalarTower.of_algebraMap_eq' rfl
  let t_y : p_y.asIdeal.ResidueField := ev_y Polynomial.X
  refine ⟨t_y, ?_⟩
  have hComp_C : (algebraMap (↥V ⧸ Q'.asIdeal) p_y.asIdeal.ResidueField).comp
      (Ideal.Quotient.mk Q'.asIdeal) = ev_y.comp Polynomial.C := by
    ext v
    change φ_Qy (algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField
      (Ideal.Quotient.mk Q'.asIdeal v)) = ev_y (Polynomial.C v)
    rw [hev_y_apply]
    have hst : algebraMap (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField
        (Ideal.Quotient.mk Q'.asIdeal v) = algebraMap ↥V Q'.asIdeal.ResidueField v :=
      (IsScalarTower.algebraMap_apply ↥V (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField v).symm
    rw [hst, Ideal.ResidueField.map_algebraMap Q'.asIdeal p_y.asIdeal (algebraMap ↥V A) rfl v]
    have h1 : φ (Polynomial.C v) = algebraMap A (Localization.Away b) (algebraMap ↥V A v) :=
      RingHom.congr_fun hφ_comp v
    have h2 : ρ_y (algebraMap A (Localization.Away b) (algebraMap ↥V A v)) =
        algebraMap A p_y.asIdeal.ResidueField (algebraMap ↥V A v) :=
      RingHom.congr_fun hρ_y_eq (algebraMap ↥V A v)
    rw [h1, h2]
  have ht_R0 : Transcendental (↥V ⧸ Q'.asIdeal) t_y := by
    rintro ⟨P₀, hP₀_ne, hP₀⟩
    apply hP₀_ne
    obtain ⟨P_lift, rfl⟩ :=
      Polynomial.map_surjective (Ideal.Quotient.mk Q'.asIdeal) Ideal.Quotient.mk_surjective P₀
    have hev_Plift : ev_y P_lift = 0 := by
      have h1 : Polynomial.aeval t_y (Polynomial.map (Ideal.Quotient.mk Q'.asIdeal) P_lift) =
          ev_y P_lift := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, hComp_C]
        change Polynomial.eval₂ (ev_y.comp Polynomial.C) (ev_y Polynomial.X) P_lift = ev_y P_lift
        rw [← Polynomial.hom_eval₂, Polynomial.eval₂_C_X]
      rw [← h1]
      exact hP₀
    ext n
    rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact hr_y_Q' P_lift hev_Plift n
  have _ : IsDomain (↥V ⧸ Q'.asIdeal) := Ideal.Quotient.isDomain Q'.asIdeal
  have _ : Algebra.IsAlgebraic (↥V ⧸ Q'.asIdeal) Q'.asIdeal.ResidueField :=
    IsLocalization.isAlgebraic Q'.asIdeal.ResidueField (nonZeroDivisors (↥V ⧸ Q'.asIdeal))
  exact Transcendental.extendScalars Q'.asIdeal.ResidueField ht_R0

theorem weil_stalk_quasiFinite_proper_birational_iso_nhd (C U_ss : AlgebraicGeometry.Scheme.{u})
    (F_ss : Type u) [Field F_ss]
    (f : C ⟶ U_ss)
    (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C)
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hInt_C : AlgebraicGeometry.IsIntegral C)
    (hInt_ss : AlgebraicGeometry.IsIntegral U_ss)
    (hNorm_ss : IsAffineNormalScheme U_ss)
    (hProp_f : AlgebraicGeometry.IsProper f)
    (hη : η_C ≫ f = η_ss)
    (hFunc_C : IsSchemeFunctionField C F_ss η_C)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss)
    (x : ↥U_ss)
    (hFinGen : ∀ y : ↥U_ss, x ∈ closure ({y} : Set ↥U_ss) → (f.base ⁻¹' {y}).Finite) :
    ∃ U_x : U_ss.Opens, x ∈ U_x ∧ CategoryTheory.IsIso (f ∣_ U_x) :=
by
  classical
  have : AlgebraicGeometry.IsAffine U_ss := hAff_ss
  have : AlgebraicGeometry.IsIntegral C := hInt_C
  have _ : AlgebraicGeometry.IsIntegral U_ss := hInt_ss
  have : AlgebraicGeometry.IsProper f := hProp_f
  have : AlgebraicGeometry.IsSeparated f := hProp_f.toIsSeparated
  have : AlgebraicGeometry.UniversallyClosed f := hProp_f.toUniversallyClosed
  have : AlgebraicGeometry.LocallyOfFiniteType f := inferInstance
  have : Unique ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := PrimeSpectrum.instUnique
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := default
  have hη_in_open : ∀ (O : C.Opens), Nonempty ↥O → η_C.base pt₀ ∈ O := by
    intro O ⟨⟨y₀, hy₀⟩⟩
    obtain ⟨V₀, hV₀_aff, hy₀_V₀, hV₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens C)) hy₀
    have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hV₀_aff
    obtain ⟨φ₀, _, hφ₀⟩ := hFunc_C V₀ hV₀ ⟨⟨y₀, hy₀_V₀⟩⟩
    have hpt_eq : η_C.base pt₀ =
        hV₀.fromSpec.base ((AlgebraicGeometry.Spec.map φ₀).base pt₀) := by
      change η_C.base pt₀ = (AlgebraicGeometry.Spec.map φ₀ ≫ hV₀.fromSpec).base pt₀
      rw [hφ₀]
    have hmem_V₀ : η_C.base pt₀ ∈ (V₀ : Set ↥C) := by
      rw [hpt_eq, ← hV₀.range_fromSpec]
      exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt₀, rfl⟩
    exact hV₀_le hmem_V₀
  have hη_mem : ∀ (O : C.Opens), Nonempty ↥O →
      Set.range ⇑η_C.base ⊆ Set.range ⇑O.ι.base := by
    intro O hOne
    rw [O.range_ι]
    rintro _ ⟨pt, rfl⟩
    rw [Subsingleton.elim pt pt₀]
    exact hη_in_open O hOne
  have : AlgebraicGeometry.IsDominant η_C := by
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
    intro y
    rw [mem_closure_iff]
    intro o ho_open hyo
    exact ⟨η_C.base pt₀, hη_in_open ⟨o, ho_open⟩ ⟨⟨y, hyo⟩⟩, pt₀, rfl⟩
  have : AlgebraicGeometry.IsDominant f := by
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
    intro u
    rw [mem_closure_iff]
    intro o ho_open huo
    let U_op : U_ss.Opens := ⟨o, ho_open⟩
    have huU : u ∈ U_op := huo
    obtain ⟨W₀, hW₀_aff, huW₀, hW₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens U_ss)) huU
    have hW₀ : AlgebraicGeometry.IsAffineOpen W₀ := hW₀_aff
    obtain ⟨φ₀, _, hφ₀⟩ := hFunc_ss W₀ hW₀ ⟨⟨u, huW₀⟩⟩
    have hfu_eq : f.base (η_C.base pt₀) =
        hW₀.fromSpec.base ((AlgebraicGeometry.Spec.map φ₀).base pt₀) := by
      change (η_C ≫ f).base pt₀ = (AlgebraicGeometry.Spec.map φ₀ ≫ hW₀.fromSpec).base pt₀
      rw [hη, hφ₀]
    have hfu_mem_W₀ : f.base (η_C.base pt₀) ∈ (W₀ : Set ↥U_ss) := by
      rw [hfu_eq, ← hW₀.range_fromSpec]
      exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt₀, rfl⟩
    exact ⟨f.base (η_C.base pt₀), hW₀_le hfu_mem_W₀, ⟨η_C.base pt₀, rfl⟩⟩
  have : AlgebraicGeometry.Surjective f :=
    AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant f
  obtain ⟨z₀, hfz₀⟩ : ∃ z₀ : ↥C, f.base z₀ = x := f.surjective x
  let U_top : U_ss.Opens := ⊤
  have hUtop : AlgebraicGeometry.IsAffineOpen U_top := AlgebraicGeometry.isAffineOpen_top U_ss
  have hUtop_ne : Nonempty ↥U_top := ⟨⟨x, trivial⟩⟩
  let A_cat := U_ss.presheaf.obj (Opposite.op U_top)
  let A : Type u := ↑A_cat
  obtain ⟨hDom_A, hIC_A⟩ := hNorm_ss U_top hUtop hUtop_ne
  have : IsDomain A := hDom_A
  have : IsIntegrallyClosed A := hIC_A
  obtain ⟨φ_A, hFrac_A, hφ_A⟩ := hFunc_ss U_top hUtop hUtop_ne
  have hInj_A : Function.Injective φ_A.hom := by
    let : Algebra A F_ss := φ_A.hom.toAlgebra
    exact @IsFractionRing.injective A _ F_ss _ _ hFrac_A
  let p_x : PrimeSpectrum A := hUtop.primeIdealOf ⟨x, trivial⟩
  have hp_x_base : hUtop.fromSpec.base p_x = x := hUtop.fromSpec_primeIdealOf ⟨x, trivial⟩
  have hLocal : ∀ (z : ↥C), f.base z = x →
      ∃ W : C.Opens, z ∈ W ∧ AlgebraicGeometry.IsOpenImmersion (W.ι ≫ f) := by
    intro z hfz
    obtain ⟨V_z, hVz_aff, hz, _⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens C))
        (show z ∈ (⊤ : C.Opens) from trivial)
    have hVz : AlgebraicGeometry.IsAffineOpen V_z := hVz_aff
    have hVz_ne : Nonempty ↥V_z := ⟨⟨z, hz⟩⟩
    let B : Type u := ↑(C.presheaf.obj (Opposite.op V_z))
    have : IsDomain B := @AlgebraicGeometry.IsIntegral.component_integral C hInt_C V_z hVz_ne
    have e_top : V_z ≤ (TopologicalSpace.Opens.map f.base).obj U_top := le_top
    let α : A →+* B := (f.appLE U_top V_z e_top).hom
    have hFT_α : α.FiniteType :=
      (AlgebraicGeometry.locallyOfFiniteType_iff f).mp inferInstance hUtop hVz e_top
    obtain ⟨φ_B, hFrac_B, hφ_B⟩ := hFunc_C V_z hVz hVz_ne
    have hInj_B : Function.Injective φ_B.hom := by
      let : Algebra B F_ss := φ_B.hom.toAlgebra
      exact @IsFractionRing.injective B _ F_ss _ _ hFrac_B
    have hCompat_φ : φ_B.hom.comp α = φ_A.hom := by
      have hSpec_comp :
          AlgebraicGeometry.Spec.map (f.appLE U_top V_z e_top ≫ φ_B) ≫ hUtop.fromSpec =
            AlgebraicGeometry.Spec.map φ_A ≫ hUtop.fromSpec := by
        calc
          AlgebraicGeometry.Spec.map (f.appLE U_top V_z e_top ≫ φ_B) ≫ hUtop.fromSpec
            = (AlgebraicGeometry.Spec.map φ_B ≫
                AlgebraicGeometry.Spec.map (f.appLE U_top V_z e_top)) ≫ hUtop.fromSpec := by
              rw [AlgebraicGeometry.Spec.map_comp]
          _ = AlgebraicGeometry.Spec.map φ_B ≫
                (AlgebraicGeometry.Spec.map (f.appLE U_top V_z e_top) ≫ hUtop.fromSpec) := by
              rw [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_B ≫ (hVz.fromSpec ≫ f) := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hUtop hVz e_top]
          _ = (AlgebraicGeometry.Spec.map φ_B ≫ hVz.fromSpec) ≫ f := by
              rw [CategoryTheory.Category.assoc]
          _ = η_C ≫ f := by rw [hφ_B]
          _ = η_ss := hη
          _ = AlgebraicGeometry.Spec.map φ_A ≫ hUtop.fromSpec := hφ_A.symm
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (f.appLE U_top V_z e_top ≫ φ_B) =
            AlgebraicGeometry.Spec.map φ_A :=
        (CategoryTheory.cancel_mono hUtop.fromSpec).mp hSpec_comp
      have hHom := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hHom
      exact congrArg CommRingCat.Hom.hom hHom
    have hInj_α : Function.Injective α := by
      have h : Function.Injective (φ_B.hom.comp α) := by
        rw [hCompat_φ]
        exact hInj_A
      exact Function.Injective.of_comp h
    let q_z : PrimeSpectrum B := hVz.primeIdealOf ⟨z, hz⟩
    have hq_comap : PrimeSpectrum.comap α q_z = p_x := by
      apply hUtop.fromSpec.isOpenEmbedding.injective
      have h1 : hUtop.fromSpec.base (PrimeSpectrum.comap α q_z) =
          (hVz.fromSpec ≫ f).base q_z := by
        rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hUtop hVz e_top]
        rfl
      rw [h1]
      change f.base (hVz.fromSpec.base q_z) = hUtop.fromSpec.base p_x
      rw [hVz.fromSpec_primeIdealOf ⟨z, hz⟩, hfz, hp_x_base]
    have hFibFin : ∀ p_y : PrimeSpectrum A, p_y ≤ p_x →
        (PrimeSpectrum.comap α ⁻¹' {p_y}).Finite := by
      intro p_y hp_yx
      let y : ↥U_ss := hUtop.fromSpec.base p_y
      have hpx_cl : p_x ∈ closure ({p_y} : Set (PrimeSpectrum A)) :=
        (PrimeSpectrum.le_iff_mem_closure p_y p_x).mp hp_yx
      have hTopSpecA : Continuous (fun p : PrimeSpectrum A =>
          (p : ↥(AlgebraicGeometry.Spec A_cat))) := continuous_id
      have hCont_fromSpec : Continuous (fun p : PrimeSpectrum A => hUtop.fromSpec.base p) :=
        hUtop.fromSpec.continuous.comp hTopSpecA
      have hx_cl : x ∈ closure ({y} : Set ↥U_ss) := by
        have himg : x ∈ (fun p : PrimeSpectrum A => hUtop.fromSpec.base p) ''
            closure ({p_y} : Set (PrimeSpectrum A)) :=
          ⟨p_x, hpx_cl, hp_x_base⟩
        have hsub := image_closure_subset_closure_image
          (s := ({p_y} : Set (PrimeSpectrum A))) hCont_fromSpec
        simpa only [Set.image_singleton] using hsub himg
      have hFin_y : (f.base ⁻¹' {y}).Finite := hFinGen y hx_cl
      have hSub_pre : PrimeSpectrum.comap α ⁻¹' {p_y} ⊆
          (fun q : PrimeSpectrum B => hVz.fromSpec.base q) ⁻¹' (f.base ⁻¹' {y}) := by
        intro q hq
        rw [Set.mem_preimage, Set.mem_singleton_iff] at hq
        rw [Set.mem_preimage, Set.mem_preimage, Set.mem_singleton_iff]
        change (hVz.fromSpec ≫ f).base q = y
        rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hUtop hVz e_top]
        change hUtop.fromSpec.base (PrimeSpectrum.comap α q) = y
        rw [hq]
      have hInj_fromVz : Function.Injective (fun q : PrimeSpectrum B => hVz.fromSpec.base q) :=
        hVz.fromSpec.isOpenEmbedding.injective
      exact (hFin_y.preimage hInj_fromVz.injOn).subset hSub_pre
    let : Algebra A B := α.toAlgebra
    have : Algebra.FiniteType A B := hFT_α
    let M : Submonoid A := p_x.asIdeal.primeCompl
    let R_x := Localization M
    let M_B : Submonoid B := Algebra.algebraMapSubmonoid B M
    let S_x := Localization M_B
    have hM_nzd : M ≤ nonZeroDivisors A := by
      intro s hs
      refine mem_nonZeroDivisors_of_ne_zero ?_
      rintro rfl
      exact hs p_x.asIdeal.zero_mem
    have : IsDomain R_x := IsLocalization.isDomain_localization hM_nzd
    have : IsIntegrallyClosed R_x := isIntegrallyClosed_of_isLocalization R_x M hM_nzd
    have hMB_nzd : M_B ≤ nonZeroDivisors B := by
      rintro _ ⟨s, hs, rfl⟩
      refine mem_nonZeroDivisors_of_ne_zero ?_
      intro h0
      have hs0 : s = 0 := hInj_α (h0.trans (map_zero α).symm)
      exact hs (hs0 ▸ p_x.asIdeal.zero_mem)
    have : IsDomain S_x := IsLocalization.isDomain_localization hMB_nzd
    have hInj_BSx : Function.Injective (algebraMap B S_x) :=
