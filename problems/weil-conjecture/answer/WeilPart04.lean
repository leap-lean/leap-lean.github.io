            intro i hi
            rw [Polynomial.eval₂_monomial]
            have hV_map : ∀ v : ↥V, (W.subtype.comp θ_V) v = ι_K (V.subtype v) :=
              fun v => (hι_V v).symm
            rw [hV_map, map_mul, map_mul, ← hp_eq i, map_mul]
            have hS_eq : (p i).2 * c_den i = S_den :=
              Finset.mul_prod_erase P.support (fun j => (p j).2) hi
            calc ((ι_K (P.coeff i) * ι_K (V.subtype (p i).2)) * ι_K (V.subtype (c_den i))) *
                  (W.subtype ξ) ^ i
                = (ι_K (V.subtype (p i).2) * ι_K (V.subtype (c_den i))) *
                  (ι_K (P.coeff i) * (W.subtype ξ) ^ i) := by ring
              _ = ι_K (V.subtype S_den) * (ι_K (P.coeff i) * (W.subtype ξ) ^ i) := by
                  rw [← map_mul, ← map_mul, hS_eq]
          rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
          have hφ_sum : (∑ i ∈ P.support, ι_K (P.coeff i) * (W.subtype ξ) ^ i) = φ_ξ P := by
            change _ = Polynomial.eval₂ ι_K (W.subtype ξ) P
            rw [Polynomial.eval₂_def, Polynomial.sum_def]
          rw [hφ_sum]
        have hP₀_zero : Polynomial.eval₂ (W.subtype.comp θ_V) (W.subtype ξ) P₀ = 0 := by
          rw [hP₀_eval, hP_eval, mul_zero]
        exact hTrans_ξ P₀ hP₀_ne hP₀_zero
      let K₀ : Subfield F_ss := s1_fracSubfield φ_ξ hφ_ξ_inj
      have hmem_K₀_poly : ∀ P : Polynomial K, φ_ξ P ∈ K₀ :=
        fun P => ⟨P, 1, one_ne_zero, by simp⟩
      have hmem_K₀_K : ∀ x : K, ι_K x ∈ K₀ := by
        intro x
        have hx_eq : ι_K x = φ_ξ (Polynomial.C x) := by simp [φ_ξ]
        rw [hx_eq]
        exact hmem_K₀_poly (Polynomial.C x)
      let k_W₀ : Subfield κ_W :=
        { carrier := {z : κ_W | ∃ w : ↥W, W.subtype w ∈ K₀ ∧ res_W w = z}
          mul_mem' := by
            rintro _ _ ⟨w₁, hw₁, rfl⟩ ⟨w₂, hw₂, rfl⟩
            exact ⟨w₁ * w₂, K₀.mul_mem hw₁ hw₂, map_mul res_W w₁ w₂⟩
          one_mem' := ⟨1, K₀.one_mem, map_one res_W⟩
          add_mem' := by
            rintro _ _ ⟨w₁, hw₁, rfl⟩ ⟨w₂, hw₂, rfl⟩
            exact ⟨w₁ + w₂, K₀.add_mem hw₁ hw₂, map_add res_W w₁ w₂⟩
          zero_mem' := ⟨0, K₀.zero_mem, map_zero res_W⟩
          neg_mem' := by
            rintro _ ⟨w, hw, rfl⟩
            exact ⟨-w, K₀.neg_mem hw, map_neg res_W w⟩
          inv_mem' := by
            rintro z ⟨w, hw, rfl⟩
            by_cases hz : res_W w = 0
            · rw [hz, inv_zero]
              exact ⟨0, K₀.zero_mem, map_zero res_W⟩
            · have hw_not : w ∉ IsLocalRing.maximalIdeal ↥W :=
                fun hm => hz ((IsLocalRing.residue_eq_zero_iff w).mpr hm)
              have hw_unit : IsUnit w := IsLocalRing.notMem_maximalIdeal.mp hw_not
              obtain ⟨u, rfl⟩ := hw_unit
              refine ⟨↑u⁻¹, ?_, ?_⟩
              · have hinv : W.subtype (↑u⁻¹ : ↥W) = (W.subtype (↑u : ↥W))⁻¹ := by
                  apply eq_inv_of_mul_eq_one_right
                  rw [← map_mul, Units.mul_inv, map_one]
                rw [hinv]
                exact K₀.inv_mem hw
              · apply eq_inv_of_mul_eq_one_right
                rw [← map_mul, Units.mul_inv, map_one] }
      have hk₀_le : k₀ ≤ k_W₀ := by
        rintro z ⟨abar, sbar, hsbar, hz⟩
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective sbar
        have hs : s ∉ P_z := fun hm => hsbar ((Ideal.Quotient.eq_zero_iff_mem).mpr hm)
        have hs_not : θ_V s ∉ IsLocalRing.maximalIdeal ↥W := by rwa [← Ideal.mem_comap, hComap]
        obtain ⟨u_s, hu_s⟩ := IsLocalRing.notMem_maximalIdeal.mp hs_not
        let w : ↥W := θ_V a * ↑u_s⁻¹
        refine ⟨w, ?_, ?_⟩
        · have hw_K : W.subtype w = ι_K (V.subtype a * (V.subtype s)⁻¹) := by
            have h_us : W.subtype (↑u_s⁻¹ : ↥W) = (W.subtype (θ_V s))⁻¹ := by
              apply eq_inv_of_mul_eq_one_left
              rw [← hu_s, ← map_mul, Units.inv_mul, map_one]
            change W.subtype (θ_V a * ↑u_s⁻¹) = _
            rw [map_mul, map_mul, map_inv₀, hι_V a, hι_V s, h_us]
          rw [hw_K]
          exact hmem_K₀_K _
        · have hs_res : res_W (θ_V s) ≠ 0 := fun h0 => hs ((hker_resθ s).mpr h0)
          apply mul_right_cancel₀ hs_res
          calc res_W w * res_W (θ_V s)
              = res_W (θ_V a * (↑u_s⁻¹ * θ_V s)) := by
                  simp only [w, map_mul, mul_assoc]
            _ = res_W (θ_V a) := by rw [← hu_s, Units.inv_mul, mul_one]
            _ = z * res_W (θ_V s) := hz.symm
      obtain ⟨g_W, hg_mem, hg_unit, hg_trans⟩ :
          ∃ g_W : ↥W, W.subtype g_W ∈ K₀ ∧ IsUnit g_W ∧ Transcendental ↥k₀ (res_W g_W) := by
        obtain ⟨Q, hQ_ne, hQ_eval⟩ := hAlg_t
        classical
        let c_Q : ℕ → F_ss :=
          fun j => Polynomial.eval₂ (W.subtype.comp θ_V) (W.subtype ξ) (Q.coeff j)
        have hc_mem : ∀ j : ℕ, c_Q j ∈ K₀ := by
          intro j
          have heq : c_Q j = φ_ξ ((Q.coeff j).map V.subtype) := by
            dsimp [c_Q, φ_ξ]
            rw [Polynomial.eval₂_map]
            congr 1
            ext v
            exact (hι_V v).symm
          rw [heq]
          exact hmem_K₀_poly _
        have hc_ne : ∀ j ∈ Q.support, c_Q j ≠ 0 :=
          fun j hj => hTrans_ξ (Q.coeff j) (Polynomial.mem_support_iff.mp hj)
        obtain ⟨j₀, hj₀_mem, hj₀_max⟩ :=
          Finset.exists_max_image Q.support (fun j => W.valuation (c_Q j))
            (Polynomial.support_nonempty.mpr hQ_ne)
        have hcj₀_ne : c_Q j₀ ≠ 0 := hc_ne j₀ hj₀_mem
        have hv_ne : W.valuation (c_Q j₀) ≠ 0 := (Valuation.ne_zero_iff W.valuation).mpr hcj₀_ne
        have ha_memW : ∀ j : ℕ, c_Q j * (c_Q j₀)⁻¹ ∈ W := by
          intro j
          rw [← ValuationSubring.valuation_le_one_iff, map_mul, map_inv₀]
          by_cases hj : j ∈ Q.support
          · exact (div_le_one₀ (lt_of_le_of_ne zero_le hv_ne.symm)).mpr (hj₀_max j hj)
          · have h0 : Q.coeff j = 0 := Polynomial.notMem_support_iff.mp hj
            simp [c_Q, h0]
        let a_Q : ℕ → ↥W := fun j => ⟨c_Q j * (c_Q j₀)⁻¹, ha_memW j⟩
        have ha_res_mem : ∀ j : ℕ, res_W (a_Q j) ∈ k_W₀ :=
          fun j => ⟨a_Q j, K₀.mul_mem (hc_mem j) (K₀.inv_mem (hc_mem j₀)), rfl⟩
        let R_t : Polynomial ↥k_W₀ :=
          ∑ j ∈ Q.support, Polynomial.monomial j ⟨res_W (a_Q j), ha_res_mem j⟩
        have hRt_ne : R_t ≠ 0 := by
          intro h0
          have hc0 : (R_t.coeff j₀ : κ_W) = 0 := by rw [h0, Polynomial.coeff_zero]; rfl
          rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single j₀
            (fun b _ hb => Polynomial.coeff_monomial_of_ne _ hb.symm)
            (fun hnot => absurd hj₀_mem hnot), Polynomial.coeff_monomial_same] at hc0
          have haj₀ : a_Q j₀ = 1 := Subtype.ext (mul_inv_cancel₀ hcj₀_ne)
          change res_W (a_Q j₀) = 0 at hc0
          rw [haj₀, map_one] at hc0
          exact one_ne_zero hc0
        have hRt_eval : Polynomial.aeval (res_W t_div) R_t = 0 := by
          have hsumW : (∑ j ∈ Q.support, a_Q j * t_div ^ j) = 0 := by
            apply W.subtype_injective
            rw [map_zero, map_sum]
            have hmul : ∀ j ∈ Q.support,
                W.subtype (a_Q j * t_div ^ j) = (c_Q j₀)⁻¹ * (c_Q j * (W.subtype t_div) ^ j) := by
              intro j _
              rw [map_mul, map_pow]
              change (c_Q j * (c_Q j₀)⁻¹) * (W.subtype t_div) ^ j = _
              ring
            rw [Finset.sum_congr rfl hmul, ← Finset.mul_sum]
            have hQ_sum : (∑ j ∈ Q.support, c_Q j * (W.subtype t_div) ^ j) =
                Polynomial.eval₂ (Polynomial.eval₂RingHom (W.subtype.comp θ_V) (W.subtype ξ))
                  (W.subtype t_div) Q := by
              rw [Polynomial.eval₂_def, Polynomial.sum_def]
              rfl
            rw [hQ_sum, hQ_eval, mul_zero]
          rw [Polynomial.aeval_def, Polynomial.eval₂_finsetSum]
          have hcongr : ∀ j ∈ Q.support,
              Polynomial.eval₂ (algebraMap ↥k_W₀ κ_W) (res_W t_div)
                (Polynomial.monomial j ⟨res_W (a_Q j), ha_res_mem j⟩) =
                res_W (a_Q j * t_div ^ j) := by
            intro j _
            rw [Polynomial.eval₂_monomial, map_mul, map_pow]
            rfl
          rw [Finset.sum_congr rfl hcongr, ← map_sum, hsumW, map_zero]
        have hAlg_t_W₀ : IsAlgebraic ↥k_W₀ (res_W t_div) := ⟨R_t, hRt_ne, hRt_eval⟩
        let _ : Algebra ↥k₀ ↥k_W₀ := (Subfield.inclusion hk₀_le).toAlgebra
        have _ : IsScalarTower ↥k₀ ↥k_W₀ κ_W := IsScalarTower.of_algebraMap_eq' rfl
        have hNotAllAlg : ¬ ∀ y : ↥k_W₀, IsAlgebraic ↥k₀ y := by
          intro hAll
          have _ : Algebra.IsIntegral ↥k₀ ↥k_W₀ := ⟨fun y => (hAll y).isIntegral⟩
          have hInt_t : IsIntegral ↥k₀ (res_W t_div) :=
            isIntegral_trans (A := ↥k_W₀) (res_W t_div) hAlg_t_W₀.isIntegral
          exact (hResTrans_iff t_div).mp ht_div hInt_t.isAlgebraic
        obtain ⟨y, hy_notAlg⟩ := not_forall.mp hNotAllAlg
        obtain ⟨g_W, hg_mem, hg_res⟩ := y.2
        have hg_tr : Transcendental ↥k₀ (res_W g_W) := by
          intro ⟨R, hR_ne, hR_ev⟩
          apply hy_notAlg
          refine ⟨R, hR_ne, ?_⟩
          apply Subtype.ext
          change k_W₀.subtype (Polynomial.aeval y R) = 0
          rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
          have hcomp_k : k_W₀.subtype.comp (algebraMap ↥k₀ ↥k_W₀) = algebraMap ↥k₀ κ_W := by
            ext x
            rfl
          rw [hcomp_k]
          change Polynomial.eval₂ (algebraMap ↥k₀ κ_W) (y : κ_W) R = 0
          rw [← hg_res]
          exact hR_ev
        have hg_res_ne : res_W g_W ≠ 0 := by
          intro h0
          apply hg_tr
          refine ⟨Polynomial.X, Polynomial.X_ne_zero, ?_⟩
          rw [h0]
          simp
        have hg_unit : IsUnit g_W :=
          IsLocalRing.notMem_maximalIdeal.mp
            (fun hm => hg_res_ne ((IsLocalRing.residue_eq_zero_iff _).mpr hm))
        exact ⟨g_W, hg_mem, hg_unit, hg_tr⟩
      let ψ_g : Polynomial K →+* F_ss := Polynomial.eval₂RingHom ι_K (W.subtype g_W)
      have hGauss : ∀ R : Polynomial K, R ≠ 0 →
          ∃ β : K, β ≠ 0 ∧ W.valuation (ψ_g R) = W.valuation (ι_K β) := by
        intro R hR_ne
        classical
        obtain ⟨r₀, hr₀_mem, hr₀_max⟩ :=
          Finset.exists_max_image R.support (fun r => W.valuation (ι_K (R.coeff r)))
            (Polynomial.support_nonempty.mpr hR_ne)
        let β : K := R.coeff r₀
        have hβ_ne : β ≠ 0 := Polynomial.mem_support_iff.mp hr₀_mem
        have hιβ_ne : ι_K β ≠ 0 := fun h0 => hβ_ne (ι_K.injective (by simpa using h0))
        have hvβ_ne : W.valuation (ι_K β) ≠ 0 := (Valuation.ne_zero_iff W.valuation).mpr hιβ_ne
        have hd_memW : ∀ r : ℕ, ι_K (R.coeff r * β⁻¹) ∈ W := by
          intro r
          rw [← ValuationSubring.valuation_le_one_iff, map_mul, map_inv₀, map_mul, map_inv₀]
          by_cases hr : r ∈ R.support
          · exact (div_le_one₀ (lt_of_le_of_ne zero_le hvβ_ne.symm)).mpr (hr₀_max r hr)
          · have h0 : R.coeff r = 0 := Polynomial.notMem_support_iff.mp hr
            simp [h0]
        let d_W : ℕ → ↥W := fun r => ⟨ι_K (R.coeff r * β⁻¹), hd_memW r⟩
        have hd_k₀ : ∀ r : ℕ, res_W (d_W r) ∈ k₀ :=
          fun r => (hK_W (R.coeff r * β⁻¹) (hd_memW r)).choose_spec.choose_spec.2.2.2
        let w_sum : ↥W := ∑ r ∈ R.support, d_W r * g_W ^ r
        let R_res : Polynomial ↥k₀ :=
          ∑ r ∈ R.support, Polynomial.monomial r ⟨res_W (d_W r), hd_k₀ r⟩
        have hRres_ne : R_res ≠ 0 := by
          intro h0
          have hc0 : (R_res.coeff r₀ : κ_W) = 0 := by rw [h0, Polynomial.coeff_zero]; rfl
          rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single r₀
            (fun b _ hb => Polynomial.coeff_monomial_of_ne _ hb.symm)
            (fun hnot => absurd hr₀_mem hnot), Polynomial.coeff_monomial_same] at hc0
          have hdr₀ : d_W r₀ = 1 := by
            apply Subtype.ext
            change ι_K (β * β⁻¹) = 1
            rw [mul_inv_cancel₀ hβ_ne, map_one]
          change res_W (d_W r₀) = 0 at hc0
          rw [hdr₀, map_one] at hc0
          exact one_ne_zero hc0
        have hres_wsum : res_W w_sum = Polynomial.aeval (res_W g_W) R_res := by
          rw [Polynomial.aeval_def, Polynomial.eval₂_finsetSum]
          dsimp [w_sum]
          rw [map_sum]
          apply Finset.sum_congr rfl
          intro r _
          rw [Polynomial.eval₂_monomial, map_mul, map_pow]
          rfl
        have hw_res_ne : res_W w_sum ≠ 0 := by
          rw [hres_wsum]
          intro h0
          exact hg_trans ⟨R_res, hRres_ne, h0⟩
        have hw_unit : IsUnit w_sum :=
          IsLocalRing.notMem_maximalIdeal.mp
            (fun hm => hw_res_ne ((IsLocalRing.residue_eq_zero_iff _).mpr hm))
        have hw_val1 : W.valuation (W.subtype w_sum) = 1 :=
          (ValuationSubring.valuation_eq_one_iff W w_sum).mp hw_unit
        have hψ_eq : ψ_g R = ι_K β * W.subtype w_sum := by
          symm
          change ι_K β * W.subtype (∑ r ∈ R.support, d_W r * g_W ^ r) = ψ_g R
          rw [map_sum, Finset.mul_sum]
          have hterm : ∀ r ∈ R.support,
              ι_K β * W.subtype (d_W r * g_W ^ r) = ι_K (R.coeff r) * (W.subtype g_W) ^ r := by
            intro r _
            rw [map_mul, map_pow]
            change ι_K β * (ι_K (R.coeff r * β⁻¹) * (W.subtype g_W) ^ r) = _
            rw [map_mul, map_inv₀]
            calc ι_K β * ((ι_K (R.coeff r) * (ι_K β)⁻¹) * (W.subtype g_W) ^ r)
                = (ι_K β * (ι_K β)⁻¹) * (ι_K (R.coeff r) * (W.subtype g_W) ^ r) := by ring
              _ = ι_K (R.coeff r) * (W.subtype g_W) ^ r := by rw [mul_inv_cancel₀ hιβ_ne, one_mul]
          rw [Finset.sum_congr rfl hterm]
          change _ = Polynomial.eval₂ ι_K (W.subtype g_W) R
          rw [Polynomial.eval₂_def, Polynomial.sum_def]
        refine ⟨β, hβ_ne, ?_⟩
        rw [hψ_eq, map_mul, hw_val1, mul_one]
      have hψ_g_inj : Function.Injective ψ_g := by
        rw [injective_iff_map_eq_zero]
        intro R hR0
        by_contra hR_ne
        obtain ⟨β, hβ_ne, hv_eq⟩ := hGauss R hR_ne
        rw [hR0, map_zero] at hv_eq
        have hιβ0 : ι_K β = 0 := (Valuation.zero_iff W.valuation).mp hv_eq.symm
        exact hβ_ne (ι_K.injective (by simpa using hιβ0))
      let E_g : Subfield F_ss := s1_fracSubfield ψ_g hψ_g_inj
      have hg_mem_Eg : W.subtype g_W ∈ E_g :=
        ⟨Polynomial.X, 1, one_ne_zero, by simp [ψ_g]⟩
      have hK_mem_Eg : ∀ x : K, ι_K x ∈ E_g :=
        fun x => ⟨Polynomial.C x, 1, one_ne_zero, by simp [ψ_g]⟩
      have hK₀_alg : ∀ z ∈ K₀, IsAlgebraic ↥E_g z := by
        obtain ⟨A_g, B_g, hBg_ne, hg_AB⟩ := hg_mem
        let toEg : K →+* ↥E_g := RingHom.codRestrict ι_K E_g hK_mem_Eg
        let M_ξ : Polynomial ↥E_g :=
          A_g.map toEg - Polynomial.C ⟨W.subtype g_W, hg_mem_Eg⟩ * B_g.map toEg
        have hM_ne : M_ξ ≠ 0 := by
          obtain ⟨d, hd⟩ := Polynomial.support_nonempty.mpr hBg_ne
          have hBd_ne : B_g.coeff d ≠ 0 := Polynomial.mem_support_iff.mp hd
          intro hM0
          have hc0 : (M_ξ.coeff d : F_ss) = 0 := by rw [hM0, Polynomial.coeff_zero]; rfl
          simp only [M_ξ, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_map] at hc0
          change ι_K (A_g.coeff d) - W.subtype g_W * ι_K (B_g.coeff d) = 0 at hc0
          have hιB_ne : ι_K (B_g.coeff d) ≠ 0 :=
            fun h0 => hBd_ne (ι_K.injective (by simpa using h0))
          have hg_in_K : W.subtype g_W = ι_K (A_g.coeff d * (B_g.coeff d)⁻¹) := by
            rw [map_mul, map_inv₀]
            apply mul_right_cancel₀ hιB_ne
            rw [mul_assoc, inv_mul_cancel₀ hιB_ne, mul_one]
            exact (sub_eq_zero.mp hc0).symm
          have hxW : ι_K (A_g.coeff d * (B_g.coeff d)⁻¹) ∈ W := by
            rw [← hg_in_K]
            exact g_W.2
          have hres_eq : res_W g_W = res_W ⟨ι_K (A_g.coeff d * (B_g.coeff d)⁻¹), hxW⟩ := by
            congr 1
            exact Subtype.ext hg_in_K
          have h_in_k₀ : res_W g_W ∈ k₀ := by
            rw [hres_eq]
            exact (hK_W _ hxW).choose_spec.choose_spec.2.2.2
          apply hg_trans
          refine ⟨Polynomial.X - Polynomial.C ⟨res_W g_W, h_in_k₀⟩, ?_, ?_⟩
          · exact Polynomial.X_sub_C_ne_zero _
          · rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
            exact sub_self _
        have hM_eval : Polynomial.aeval (W.subtype ξ) M_ξ = 0 := by
          have hmap : ∀ P : Polynomial K,
              Polynomial.aeval (W.subtype ξ) (P.map toEg) = φ_ξ P := by
            intro P
            rw [Polynomial.aeval_def, Polynomial.eval₂_map]
            have hcomp : (algebraMap ↥E_g F_ss).comp toEg = ι_K := by ext c; rfl
            rw [hcomp]
            rfl
          simp only [M_ξ, map_sub, map_mul, Polynomial.aeval_C, hmap]
          exact sub_eq_zero.mpr hg_AB.symm
        have hξ_int : W.subtype ξ ∈ integralClosure ↥E_g F_ss :=
          (IsAlgebraic.isIntegral ⟨M_ξ, hM_ne, hM_eval⟩)
        have hPoly_int : ∀ P : Polynomial K, φ_ξ P ∈ integralClosure ↥E_g F_ss := by
          intro P
          rw [show φ_ξ P = Polynomial.eval₂ ι_K (W.subtype ξ) P from rfl,
            Polynomial.eval₂_eq_sum_range]
          refine Subalgebra.sum_mem _ (fun i _ => Subalgebra.mul_mem _ ?_ (Subalgebra.pow_mem _ hξ_int i))
          have hc_eq : ι_K (P.coeff i) = algebraMap ↥E_g F_ss (toEg (P.coeff i)) := rfl
          rw [hc_eq]
          exact (integralClosure ↥E_g F_ss).algebraMap_mem _
        rintro z ⟨A, B, hB_ne, hz_eq⟩
        have hφB_ne : φ_ξ B ≠ 0 := fun h0 => hB_ne (hφ_ξ_inj (by simpa using h0))
        have hz_div : z = φ_ξ A * (φ_ξ B)⁻¹ := by
          apply mul_right_cancel₀ hφB_ne
