      refine ⟨hPropPF, hIntPF, hNormPF, j_a 0, hj_open 0, hj_comm 0, ?_, ?_⟩
      · intro hAlgF O ⟨x_O⟩
        have : IrreducibleSpace ↥(weilProjectiveSpaceOver F 1).left := hIrredPF
        have : IsOpenImmersion (j_a 0) := hj_open 0
        have : Infinite F := @IsAlgClosed.instInfinite F _ hAlgF
        let pt_PF : PrimeSpectrum (Polynomial F) := ⟨⊥, inferInstance⟩
        obtain ⟨w, hwO, p₀, hp₀_eq⟩ :=
