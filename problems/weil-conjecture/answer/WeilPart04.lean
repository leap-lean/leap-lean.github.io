              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hcomp : βbar_L.comp mk𝔓 = β_L := by ext b; rfl
            rw [hcomp]
          have hzb_ugen : ι_ℰ.base z_b = u_gen.base q_b := by
            change (ξ_b ≫ ι_ℰ).base pt_L = u_gen.base q_b
            rw [hξ_ιℰ]
            have hpt_β : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_L)).base pt_L =
                ⟨𝔭_b, h𝔭b_prime⟩ := by
              apply PrimeSpectrum.ext
              change Ideal.comap β_L (⊥ : Ideal Q_b.asIdeal.ResidueField) = 𝔭_b
              rw [← RingHom.ker_eq_comap_bot, hker_β]
            change hUs.fromSpec.base
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_L)).base pt_L) = u_gen.base q_b
            rw [hpt_β, hqb_eq]
          
          have hξ_gℰ : ξ_b ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) := by
            change ξ_b ≫ ι_ℰ ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 = _
            rw [← CategoryTheory.Category.assoc, hξ_ιℰ, CategoryTheory.Category.assoc,
              hComm_Ws, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hβ_cW']
          
          have hξ_const : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField)),
              ξ_b.base pt = z_b := by
            intro pt
            rw [Subsingleton.elim pt pt_L]
          
          have hz_cl : z ∈ closure ({z_b} : Set ↥ℰ) := by
            let p_sub : PrimeSpectrum (B_s ⧸ 𝔓) :=
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom βbar_L)).base pt_L
            let q_sub : PrimeSpectrum (B_s ⧸ 𝔓) := iso_sub.hom.base ⟨z, hz_s⟩
            let φ_top : PrimeSpectrum (B_s ⧸ 𝔓) → ↥ℰ := fun r => W_ℰ.ι.base (iso_sub.inv.base r)
            have hcont_φ : Continuous φ_top := W_ℰ.ι.continuous.comp iso_sub.inv.continuous
            have hz_qsub : φ_top q_sub = z := by
              change W_ℰ.ι.base ((iso_sub.hom ≫ iso_sub.inv).base ⟨z, hz_s⟩) = z
              rw [iso_sub.hom_inv_id]
              rfl
            have hzb_psub : φ_top p_sub = z_b := rfl
            have hqsub_comap : Ideal.comap mk𝔓 q_sub.asIdeal = 𝔮_s := by
              have h1 : ι_ℰ.base (W_ℰ.ι.base ⟨z, hz_s⟩) =
                  hUs.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk𝔓)).base q_sub) :=
                congrArg (fun f => f.base ⟨z, hz_s⟩) hiso_sub
              have hinj : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk𝔓)).base q_sub =
                  hUs.primeIdealOf ⟨z_X, hz_s⟩ := by
                apply hUs.fromSpec.isOpenEmbedding.injective
                rw [hUs.fromSpec_primeIdealOf]
                exact h1.symm
              exact congrArg PrimeSpectrum.asIdeal hinj
            have hle_sub : p_sub ≤ q_sub := by
              intro y hy
              obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
              have hx_𝔭b : x ∈ 𝔭_b := by
                rw [← hker_β, RingHom.mem_ker]
                change βbar_L (mk𝔓 x) = 0
                rw [← Ideal.mem_bot]
                exact hy
              have hx_𝔮s : x ∈ 𝔮_s := h𝔭b_le_𝔮s hx_𝔭b
              rw [← hqsub_comap] at hx_𝔮s
              exact hx_𝔮s
            have hcl_sub : q_sub ∈ closure ({p_sub} : Set (PrimeSpectrum (B_s ⧸ 𝔓))) :=
              (PrimeSpectrum.le_iff_mem_closure p_sub q_sub).mp hle_sub
            have himg := image_closure_subset_closure_image hcont_φ
              (Set.mem_image_of_mem φ_top hcl_sub)
            rw [Set.image_singleton, hz_qsub, hzb_psub] at himg
            exact himg
          
          have hContClosure : ∀ {α β : Type u} [TopologicalSpace α] [TopologicalSpace β]
              (f : α → β), Continuous f → ∀ a b : α,
              a ∈ closure ({b} : Set α) → f a ∈ closure ({f b} : Set β) := by
            intro α β _ _ f hf a b hab
            have himg := image_closure_subset_closure_image hf (Set.mem_image_of_mem f hab)
            rwa [Set.image_singleton] at himg
          have hOpenImmClosure : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y)
              [AlgebraicGeometry.IsOpenImmersion u] (q_pt y_pt : ↥X) (x₁ x₂ : ↥Y),
              u.base q_pt = x₁ → u.base y_pt = x₂ →
              x₁ ∈ closure ({x₂} : Set ↥Y) → q_pt ∈ closure ({y_pt} : Set ↥X) := by
            intro X Y u _ q_pt y_pt x₁ x₂ hq hy hx
            subst hq hy
            have hemb := u.isOpenEmbedding.isInducing
            rw [hemb.closure_eq_preimage_closure_image, Set.image_singleton]
            exact hx
          have hqb_Δ : q_b ∈ Δ_E := by
            have hqb_E : q_b ∈ E_cur := by
              have h1 : hUs.fromSpec.base ⟨𝔭_b, h𝔭b_prime⟩ ∈ Set.range ι_ℰ.base :=
                (hMem_iff ⟨𝔭_b, h𝔭b_prime⟩).mpr h𝔓_le_𝔭b
              rw [← hqb_eq] at h1
              exact (hGen_iff q_b).mp h1
            have hy1_not_E : y₁ ∉ E_cur := by
              intro hy1_E
              have h1 : u_gen.base y₁ ∈ Set.range ι_ℰ.base := (hGen_iff y₁).mpr hy1_E
              rw [hy1_eq] at h1
              have hle : 𝔓 ≤ 𝔮₁ := (hMem_iff ⟨𝔮₁, h𝔮1_prime⟩).mp h1
              exact hx'0_not_𝔮1 (hle hx'0_𝔓)
            have hcl_Spec : (⟨𝔭_b, h𝔭b_prime⟩ : PrimeSpectrum B_s) ∈
                closure ({(⟨𝔮₁, h𝔮1_prime⟩ : PrimeSpectrum B_s)} : Set (PrimeSpectrum B_s)) :=
              (PrimeSpectrum.le_iff_mem_closure _ _).mp h𝔮1_le_𝔭b
            have hcl_Yb : q_b ∈ closure ({y₁} : Set ↥Y_b) := by
              have _ : AlgebraicGeometry.IsOpenImmersion u_gen := hOpen_ugen
              exact hOpenImmClosure u_gen q_b y₁
                (hUs.fromSpec.base ⟨𝔭_b, h𝔭b_prime⟩)
                (hUs.fromSpec.base ⟨𝔮₁, h𝔮1_prime⟩)
                hqb_eq hy1_eq
                (hContClosure (fun r : PrimeSpectrum B_s => hUs.fromSpec.base r)
                  hUs.fromSpec.continuous ⟨𝔭_b, h𝔭b_prime⟩ ⟨𝔮₁, h𝔮1_prime⟩ hcl_Spec)
            have hSetNe : ∀ {α : Type u} {A B : Set α} {y : α},
                y ∈ A → y ∉ B → A ≠ B := by
              intro α A B y hyA hyB hAB
              rw [hAB] at hyA
              exact hyB hyA
            obtain ⟨E', hE'_mem, hE'_sub⟩ :=
              exists_mem_irreducibleComponents_subset_of_isIrreducible
                (closure ({y₁} : Set ↥Y_b)) (isIrreducible_singleton (x := y₁)).closure
            have hqb_E' : q_b ∈ E' := hE'_sub hcl_Yb
            have hy1_E' : y₁ ∈ E' := hE'_sub (subset_closure (Set.mem_singleton y₁))
            have hE'_ne : E' ≠ E_cur := hSetNe hy1_E' hy1_not_E
            exact ⟨hqb_E, E', hE'_mem, hE'_ne, hqb_E'⟩
          exact ⟨q_b, z_b, ξ_b, hqb_Δ, hzb_ugen, hz_cl, hξ_gℰ, hξ_const⟩
  
  have hSS_gcur : AlgebraicGeometry.IsSeparated g_cur := hSS_cur.2.2.1
  have hSep_gℰ : AlgebraicGeometry.IsSeparated g_ℰ := inferInstance
  have hSS_ℰ : IsStrictlySemistableCurveOverValuation W₀ g_ℰ :=
    hAssembleSS Q_b.asIdeal.ResidueField W₀ ℰ g_ℰ hInt_ℰ hSep_gℰ (fun z => (hLocalAt z).1)
  exact ⟨hSS_ℰ, hConj2, hConj3, fun q => (hLocalAt ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q)).2 q rfl⟩

theorem weil_step_closedFiber_boundary_and_marking_transfer (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K C' U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (hτ'_sec : ∀ j : Fin n, τ' j ≫ g' = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)))
    (ι' : C_K ⟶ C')
    (U' : C'.Opens)
    (h_mod : U'.toScheme ⟶ U_ss)
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (ι_cur : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_cur)
    (hRes_cur : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C_cur g_cur f_dom_cur τ_cur ι_cur)
    (Q_b Q_s : PrimeSpectrum ↥V)
    (hQ_le : Q_b.asIdeal ≤ Q_s.asIdeal)
    (hQs_ne : Q_s.asIdeal ≠ ⊥)
    (hFin_Ys : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_s.asIdeal.ResidueField))))).Finite)
    (x_b x_s : ↥U'.toScheme)
    (hxs_over : (U'.ι ≫ g').base x_s = Q_s)
    (E_cur : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))))
    (hExc_cur : IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur Q_b x_b E_cur)
    (W₀ : ValuationSubring Q_b.asIdeal.ResidueField)
    (hMax_W₀ : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1_W₀ : ∀ P' : PrimeSpectrum ↥W₀,
      P'.asIdeal = ⊥ ∨ P'.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (ρ_V : ↥V →+* ↥W₀)
    (ψ_s : Q_s.asIdeal.ResidueField ≃+* (IsLocalRing.maximalIdeal ↥W₀).ResidueField)
    (hρ_sub : W₀.subtype.comp ρ_V = algebraMap ↥V Q_b.asIdeal.ResidueField)
    (hρ_ker : RingHom.ker ρ_V = Q_b.asIdeal)
    (hρ_comap : (IsLocalRing.maximalIdeal ↥W₀).comap ρ_V = Q_s.asIdeal)
    (hPre_W0 : AlgebraicGeometry.IsPreimmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)))
    (hψ_comm : (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField).comp ρ_V =
      ψ_s.toRingHom.comp (algebraMap ↥V Q_s.asIdeal.ResidueField))
    (u_gen : CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ⟶
      CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)))
    (hu_fst : u_gen ≫ CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (hu_snd : u_gen ≫ CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype))
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (ι_ℰ : ℰ ⟶ CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)))
    (hCl_ℰ : AlgebraicGeometry.IsClosedImmersion ι_ℰ) :
    let s_b := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))
    let Y_b := CategoryTheory.Limits.pullback g_cur s_b
    let Δ_E : Set ↥Y_b :=
      {q' ∈ E_cur | ∃ E' ∈ irreducibleComponents ↥Y_b, E' ≠ E_cur ∧ q' ∈ E'}
    let ι_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)
    let X_W0 := CategoryTheory.Limits.pullback g_cur ι_W0
    let g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) :=
      ι_ℰ ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
    AlgebraicGeometry.IsProper g_ℰ →
    (∀ q_b : ↥Y_b, u_gen.base q_b ∈ Set.range ι_ℰ.base ↔ q_b ∈ E_cur) →
    (∀ q : ↥T₀,
      f_dom_cur.base ((CategoryTheory.Limits.pullback.fst g_cur ι_W0).base
        (ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q))) = x_s) →
    (∀ (κ : Type u) [Field κ]
        (s_κ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (y : ↥(CategoryTheory.Limits.pullback g_cur s_κ))
        (V_sm : C_cur.Opens),
      (CategoryTheory.Limits.pullback.fst g_cur s_κ).base y ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_cur) →
      ∃ W_y : (CategoryTheory.Limits.pullback g_cur s_κ).Opens,
        y ∈ W_y ∧ IsPreirreducible (W_y : Set ↥(CategoryTheory.Limits.pullback g_cur s_κ))) →
    (∀ (q : ↥T₀) (V_sm : C_cur.Opens),
      (CategoryTheory.Limits.pullback.fst g_cur ι_W0).base
        (ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q)) ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_cur) →
      (∃ U_X : X_W0.Opens,
        ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q) ∈ U_X ∧
        (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base) ∧
      (∃ V_T : T₀.Opens, q ∈ V_T ∧ IsPreirreducible (V_T : Set ↥T₀))) →
    (∀ q : ↥T₀,
      (∃ U_X : X_W0.Opens,
        ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q) ∈ U_X ∧
        (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base) ∨
      ((∃ V_T : T₀.Opens, q ∈ V_T ∧ IsPreirreducible (V_T : Set ↥T₀)) ∧
        ∃ (q_b : ↥Y_b) (z_b : ↥ℰ)
          (ξ_b : AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField) ⟶ ℰ),
          q_b ∈ Δ_E ∧
          ι_ℰ.base z_b = u_gen.base q_b ∧
          (CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q ∈ closure ({z_b} : Set ↥ℰ) ∧
          ξ_b ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ∧
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField)),
            ξ_b.base pt = z_b))) →
    ∃ (S_ext : Set ↥T₀),
      S_ext.Finite ∧
      S_ext.ncard ≤ 2 ∧
      (∀ q ∈ S_ext, ∀ Z₁ ∈ irreducibleComponents ↥T₀, ∀ Z₂ ∈ irreducibleComponents ↥T₀,
        q ∈ Z₁ → q ∈ Z₂ → Z₁ = Z₂) ∧
      (∀ Z ∈ irreducibleComponents ↥T₀,
        (∃ (Z_sch : AlgebraicGeometry.Scheme.{u}) (ιZ : Z_sch ⟶ T₀)
            (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left),
          AlgebraicGeometry.IsClosedImmersion ιZ ∧
          AlgebraicGeometry.IsIntegral Z_sch ∧
          Set.range ιZ.base = Z ∧
          ιZ ≫ CategoryTheory.Limits.pullback.snd g_ℰ s₀ =
            isoP1.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom) →
        {q ∈ Z | ∃ Z' ∈ irreducibleComponents ↥T₀, Z' ≠ Z ∧ q ∈ Z'}.Finite →
        {q ∈ Z | ∃ Z' ∈ irreducibleComponents ↥T₀, Z' ≠ Z ∧ q ∈ Z'}.ncard +
          (Z ∩ S_ext).ncard ≤ 2 →
        ∃ (E_next : Set ↥(CategoryTheory.Limits.pullback g_cur
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V Q_s.asIdeal.ResidueField))))),
          IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur Q_s x_s E_next) :=
by
  have hFieldSpec : ∀ {F : Type u} [Field F] (u : PrimeSpectrum F), u.asIdeal = ⊥ := by
    intro F _ u
    rw [eq_bot_iff]
    intro x hx
    rw [Ideal.mem_bot]
    by_contra hx0
    exact u.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem u.asIdeal hx (IsUnit.mk0 x hx0))
  have hSpecRes : ∀ {R : Type u} [CommRing R] (P : Ideal R) [P.IsPrime]
      (u : ↥(AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField))),
      ((AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R P.ResidueField))).base u).asIdeal = P := by
    intro R _ P _ u
    change Ideal.comap (algebraMap R P.ResidueField) u.asIdeal = P
    rw [hFieldSpec u]
    ext x
    simp only [Ideal.mem_comap, Ideal.mem_bot]
    rw [IsScalarTower.algebraMap_apply R (R ⧸ P) P.ResidueField x,
      map_eq_zero_iff _ (IsFractionRing.injective (R ⧸ P) P.ResidueField),
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
  have hClMax : ∀ {R : Type u} [CommRing R] [IsLocalRing R],
      AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField))) := by
    intro R _ _
    apply AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
    intro y
    have hbij := Ideal.bijective_algebraMap_quotient_residueField (IsLocalRing.maximalIdeal R)
    obtain ⟨q, rfl⟩ := hbij.2 y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
    exact ⟨r, (IsScalarTower.algebraMap_apply R (R ⧸ IsLocalRing.maximalIdeal R) _ r).symm⟩
  have hUniqPre : ∀ {X : Type u} [TopologicalSpace X]
      {x : X} (U : TopologicalSpace.Opens X),
      x ∈ U → IsPreirreducible (U : Set X) →
      ∀ {Z₁ Z₂ : Set X}, Z₁ ∈ irreducibleComponents X → Z₂ ∈ irreducibleComponents X →
        x ∈ Z₁ → x ∈ Z₂ → Z₁ = Z₂ := by
    intro X _ x U hxU hPre Z₁ Z₂ hZ₁ hZ₂ hx₁ hx₂
    have hIrredU : IsIrreducible (U : Set X) := ⟨⟨x, hxU⟩, hPre⟩
    obtain ⟨Z₀, hZ₀, hU_sub⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible (U : Set X) hIrredU
    have hCl₀ : IsClosed Z₀ := isClosed_of_mem_irreducibleComponents Z₀ hZ₀
    have hClCompl : IsClosed (U : Set X)ᶜ := U.isOpen.isClosed_compl
    have heq : ∀ {Z : Set X}, Z ∈ irreducibleComponents X → x ∈ Z → Z = Z₀ := by
      intro Z hZ hxZ
      have hSubUnion : Z ⊆ Z₀ ∪ (U : Set X)ᶜ := by
        intro y _
        by_cases hyU : y ∈ (U : Set X)
        · exact Or.inl (hU_sub hyU)
        · exact Or.inr hyU
      rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hZ.1.isPreirreducible)
          Z₀ (U : Set X)ᶜ hCl₀ hClCompl hSubUnion with hSub₀ | hSubC
      · exact le_antisymm hSub₀ (hZ.2 hZ₀.1 hSub₀)
      · exact False.elim (hSubC hxZ hxU)
    exact (heq hZ₁ hx₁).trans (heq hZ₂ hx₂).symm
  have hProjIso : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R ≃+* S),
      ∃ (Φ : (weilProjectiveSpaceOver S 1).left ≅ (weilProjectiveSpaceOver R 1).left),
        Φ.hom ≫ (weilProjectiveSpaceOver R 1).hom =
          (weilProjectiveSpaceOver S 1).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) := by
    intro R S _ _ ψ
    let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) R
    let 𝒜_S := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) S
    let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜_S := MvPolynomial.gradedAlgebra
    let mkGrad : ∀ {T₁ T₂ : Type u} [CommRing T₁] [CommRing T₂] (φ : T₁ →+* T₂),
