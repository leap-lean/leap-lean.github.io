    let σ_jb : AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField) ⟶ Y_b :=
      CategoryTheory.Limits.pullback.lift (η_W0 ≫ ι_W0_j ≫ τ_cur j) (𝟙 _)
        (by rw [Category.assoc, Category.assoc, hτ_sec j,
          hι_W0_j, hη_ιW0, Category.id_comp])
    have hσ_ugen : σ_jb ≫ u_gen = η_W0 ≫ τ_tilde := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hu_fst, CategoryTheory.Limits.pullback.lift_fst,
          Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · rw [Category.assoc, hu_snd, ← Category.assoc σ_jb,
          CategoryTheory.Limits.pullback.lift_snd, Category.id_comp,
          Category.assoc, CategoryTheory.Limits.pullback.lift_snd, Category.comp_id]
    have hqb_E : σ_jb.base pt_L ∈ E_cur := by
      apply (hGenRange (σ_jb.base pt_L)).mp
      change (σ_jb ≫ u_gen).base pt_L ∈ Set.range ι_ℰ.base
      rw [hσ_ugen]
      change τ_tilde.base (η_W0.base pt_L) ∈ Set.range ι_ℰ.base
      rw [hη_bot]; exact hbot_range
    refine ⟨σ_jb.base pt_L, hqb_E, (η_W0 ≫ ι_W0_j).base pt_L, ?_⟩
    change (η_W0 ≫ ι_W0_j ≫ τ_cur j).base pt_L =
      (σ_jb ≫ CategoryTheory.Limits.pullback.fst g_cur s_b).base pt_L
    rw [CategoryTheory.Limits.pullback.lift_fst]
  have hMark_fin_le : S_mark.Finite ∧ S_mark.ncard ≤ M_E.ncard := by
    by_cases hNe : S_mark.Nonempty
    · obtain ⟨q_def, j_def, hj_def⟩ := hNe
      have hex_mark : ∀ q : ↥T₀, ∃ j : Fin n, j ∈ M_E ∧
          (q ∈ S_mark →
            (CategoryTheory.Limits.pullback.fst g_cur s_s).base (ι_T.base q) ∈
              Set.range (τ_cur j).base) := by
        intro q
        by_cases hq : q ∈ S_mark
        · obtain ⟨j, hj⟩ := hq
          exact ⟨j, (hMark_data q j hj).1, fun _ => hj⟩
        · exact ⟨j_def, (hMark_data q_def j_def hj_def).1, fun h => False.elim (hq h)⟩
      choose pick_j hMaps_all hSpec_mark using hex_mark
      have hMaps : ∀ q ∈ S_mark, pick_j q ∈ M_E := fun q _ => hMaps_all q
      have hInj : Set.InjOn pick_j S_mark := by
        intro q₁ hq₁ q₂ hq₂ heq
        obtain ⟨b₁, hb₁⟩ := hSpec_mark q₁ hq₁
        have hspec₂ : (CategoryTheory.Limits.pullback.fst g_cur s_s).base (ι_T.base q₂) ∈
            Set.range (τ_cur (pick_j q₁)).base := by
          rw [heq]; exact hSpec_mark q₂ hq₂
        obtain ⟨b₂, hb₂⟩ := hspec₂
        have hb_eq : b₁ = b₂ := by
          apply (S_dom (pick_j q₁)).ι.isOpenEmbedding.injective
          have hQ : ∀ (q : ↥T₀) (b : ↥(S_dom (pick_j q₁)).toScheme),
              (τ_cur (pick_j q₁)).base b =
                (CategoryTheory.Limits.pullback.fst g_cur s_s).base (ι_T.base q) →
              (S_dom (pick_j q₁)).ι.base b = Q_s := by
            intro q b hb
            rw [← hτ_sec (pick_j q₁)]
            change g_cur.base ((τ_cur (pick_j q₁)).base b) = Q_s
            rw [hb]
            change (CategoryTheory.Limits.pullback.fst g_cur s_s ≫ g_cur).base (ι_T.base q) = Q_s
            rw [CategoryTheory.Limits.pullback.condition]
            exact PrimeSpectrum.ext (hSpecRes Q_s.asIdeal _)
          rw [hQ q₁ b₁ hb₁, hQ q₂ b₂ hb₂]
        have hz_eq : (CategoryTheory.Limits.pullback.fst g_cur s_s).base (ι_T.base q₁) =
            (CategoryTheory.Limits.pullback.fst g_cur s_s).base (ι_T.base q₂) := by
          rw [← hb₁, hb_eq, hb₂]
        change (ι_T ≫ CategoryTheory.Limits.pullback.fst g_cur s_s).base q₁ =
          (ι_T ≫ CategoryTheory.Limits.pullback.fst g_cur s_s).base q₂ at hz_eq
        rw [hιT_fst] at hz_eq
        exact (CategoryTheory.Limits.pullback.fst g_ℰ s₀).isClosedEmbedding.injective
          (ι_ℰ.isClosedEmbedding.injective
            ((CategoryTheory.Limits.pullback.fst g_cur ι_W0).isEmbedding.injective hz_eq))
      exact ⟨Set.Finite.of_injOn hMaps hInj M_E.toFinite,
        Set.ncard_le_ncard_of_injOn pick_j hMaps hInj M_E.toFinite⟩
    · rw [Set.not_nonempty_iff_eq_empty] at hNe
      rw [hNe]
      exact ⟨Set.finite_empty, by simp⟩
  let S_ext : Set ↥T₀ := S_bdry ∪ S_mark
  have hS_fin : S_ext.Finite := hBdry_fin_le.1.union hMark_fin_le.1
  have hS_le2 : S_ext.ncard ≤ 2 := by
    change (S_bdry ∪ S_mark).ncard ≤ 2
    have h1 := Set.ncard_union_le S_bdry S_mark
    have h2 := hBdry_fin_le.2
    have h3 := hMark_fin_le.2
    omega
  have hS_uniq : ∀ q ∈ S_ext, ∀ Z₁ ∈ irreducibleComponents ↥T₀,
      ∀ Z₂ ∈ irreducibleComponents ↥T₀, q ∈ Z₁ → q ∈ Z₂ → Z₁ = Z₂ := by
    intro q hq Z₁ hZ₁ Z₂ hZ₂ hq₁ hq₂
    rcases hq with hq_b | ⟨j, hj⟩
    · obtain ⟨V_T, hqV, hPreV⟩ := (hBdry_right q hq_b).1
      exact hUniqPre V_T hqV hPreV hZ₁ hZ₂ hq₁ hq₂
    · obtain ⟨V_T, hqV, hPreV⟩ := (hMark_data q j hj).2
      exact hUniqPre V_T hqV hPreV hZ₁ hZ₂ hq₁ hq₂
  refine ⟨S_ext, hS_fin, hS_le2, hS_uniq, ?_⟩
  
  intro Z hZ ⟨Z_sch, ιZ, isoP1, hCl_Z, hInt_Z, hRange_Z, hIso_Z⟩ hΔint_fin hDeg_Z
  have _ : AlgebraicGeometry.IsClosedImmersion ιZ := hCl_Z
  have _ : AlgebraicGeometry.IsClosedImmersion ι_T := hCl_T
  obtain ⟨Φ_P1, hΦ_comm⟩ := hProjIso Q_s.asIdeal.ResidueField k₀ ψ_s
  obtain ⟨p₀, p₁, p₂, hp01, hp02, hp12⟩ := hProj3Pts k₀
  have hInj_α : Function.Injective (isoP1.inv ≫ ιZ).base := by
    intro x y hxy
    have hZ_eq : isoP1.inv.base x = isoP1.inv.base y := ιZ.isClosedEmbedding.injective hxy
    have hx : (isoP1.inv ≫ isoP1.hom).base x = x := by rw [isoP1.inv_hom_id]; rfl
    have hy : (isoP1.inv ≫ isoP1.hom).base y = y := by rw [isoP1.inv_hom_id]; rfl
    rw [← hx, ← hy]
    exact congrArg isoP1.hom.base hZ_eq
  let q₀ : ↥T₀ := (isoP1.inv ≫ ιZ).base p₀
  let q₁ : ↥T₀ := (isoP1.inv ≫ ιZ).base p₁
  let q₂ : ↥T₀ := (isoP1.inv ≫ ιZ).base p₂
  have hq₀Z : q₀ ∈ Z := by rw [← hRange_Z]; exact ⟨isoP1.inv.base p₀, rfl⟩
  have hq₁Z : q₁ ∈ Z := by rw [← hRange_Z]; exact ⟨isoP1.inv.base p₁, rfl⟩
  have hq₂Z : q₂ ∈ Z := by rw [← hRange_Z]; exact ⟨isoP1.inv.base p₂, rfl⟩
  have h01 : q₀ ≠ q₁ := fun h => hp01 (hInj_α h)
  have h02 : q₀ ≠ q₂ := fun h => hp02 (hInj_α h)
  have h12 : q₁ ≠ q₂ := fun h => hp12 (hInj_α h)
  let f_T : ↥T₀ → ↥Y_s := ι_T.base
  have hf_T : Topology.IsClosedEmbedding f_T := ι_T.isClosedEmbedding
  let E_next : Set ↥Y_s := f_T '' Z
  have hPreimIrred : ∀ {E : Set ↥Y_s}, IsIrreducible E → E ⊆ Set.range f_T →
      IsIrreducible (f_T ⁻¹' E) := by
    intro E hE hSub
    obtain ⟨y₀, hy₀⟩ := hE.nonempty
    obtain ⟨x₀, rfl⟩ := hSub hy₀
    refine ⟨⟨x₀, hy₀⟩, ?_⟩
    intro U₁ U₂ hU₁ hU₂ ⟨x₁, hx₁E, hx₁U⟩ ⟨x₂, hx₂E, hx₂U⟩
    rw [hf_T.isInducing.isOpen_iff] at hU₁ hU₂
    obtain ⟨W₁, hW₁, hEq₁⟩ := hU₁
    obtain ⟨W₂, hW₂, hEq₂⟩ := hU₂
    rw [← hEq₁] at hx₁U ⊢
    rw [← hEq₂] at hx₂U ⊢
    obtain ⟨y, hyE, hyW₁, hyW₂⟩ :=
      hE.isPreirreducible W₁ W₂ hW₁ hW₂ ⟨f_T x₁, hx₁E, hx₁U⟩ ⟨f_T x₂, hx₂E, hx₂U⟩
    obtain ⟨x, rfl⟩ := hSub hyE
    exact ⟨x, hyE, hyW₁, hyW₂⟩
  have hEnext_irred_set : IsIrreducible E_next :=
    hZ.1.image f_T hf_T.continuous.continuousOn
  obtain ⟨E_big, hEbig_mem, hEnext_sub⟩ :=
    exists_mem_irreducibleComponents_subset_of_isIrreducible E_next hEnext_irred_set
  have hEbig_sub_range : E_big ⊆ Set.range f_T := by
    by_contra hNotSub
    have hZ_sub_S : Z ⊆ S_ext := by
      intro q hq
      exact Or.inl ⟨E_big, hEbig_mem, hEnext_sub ⟨q, hq, rfl⟩, hNotSub⟩
    have hZ_fin : Z.Finite := hS_fin.subset hZ_sub_S
    let S₃ : Set ↥T₀ := {q₀, q₁, q₂}
    have hS3_sub : S₃ ⊆ Z := by
      rintro x (rfl | rfl | rfl)
      · exact hq₀Z
      · exact hq₁Z
      · exact hq₂Z
    have h0_not : q₀ ∉ ({q₁, q₂} : Set ↥T₀) := by simp [h01, h02]
    have h1_not : q₁ ∉ ({q₂} : Set ↥T₀) := by simp [h12]
    have hS3_card : S₃.ncard = 3 := by
      change (insert q₀ (insert q₁ ({q₂} : Set ↥T₀))).ncard = 3
      rw [Set.ncard_insert_of_notMem h0_not ((Set.finite_singleton q₂).insert q₁),
        Set.ncard_insert_of_notMem h1_not (Set.finite_singleton q₂),
        Set.ncard_singleton]
    have hle1 : S₃.ncard ≤ Z.ncard := Set.ncard_le_ncard hS3_sub hZ_fin
    have hle2 : Z.ncard ≤ S_ext.ncard := Set.ncard_le_ncard hZ_sub_S hS_fin
    omega
  have hPre_eq_Z : f_T ⁻¹' E_big = Z := by
    have hZ_sub_pre : Z ⊆ f_T ⁻¹' E_big := fun q hq => hEnext_sub ⟨q, hq, rfl⟩
    exact le_antisymm (hZ.2 (hPreimIrred hEbig_mem.1 hEbig_sub_range) hZ_sub_pre) hZ_sub_pre
  have hEnext_eq_big : E_next = E_big := by
    change f_T '' Z = E_big
    rw [← hPre_eq_Z, Set.image_preimage_eq_iff.mpr hEbig_sub_range]
  have hEnext_mem : E_next ∈ irreducibleComponents ↥Y_s := hEnext_eq_big ▸ hEbig_mem
  let Δ_int : Set ↥T₀ := {q ∈ Z | ∃ Z' ∈ irreducibleComponents ↥T₀, Z' ≠ Z ∧ q ∈ Z'}
  let Δ_next : Set ↥Y_s := {y ∈ E_next | ∃ E' ∈ irreducibleComponents ↥Y_s, E' ≠ E_next ∧ y ∈ E'}
  let M_next : Set (Fin n) :=
    {j : Fin n | ∃ y ∈ E_next,
      (CategoryTheory.Limits.pullback.fst g_cur s_s).base y ∈ Set.range (τ_cur j).base}
  let Δ_tilde : Set ↥T₀ := f_T ⁻¹' Δ_next
  have hΔ_img : f_T '' Δ_tilde = Δ_next := by
    apply Set.image_preimage_eq_iff.mpr
    rintro y ⟨⟨q, _, rfl⟩, _⟩
    exact ⟨q, rfl⟩
  have hΔ_sub : Δ_tilde ⊆ Δ_int ∪ (Z ∩ S_ext) := by
    rintro q ⟨⟨q', hq'Z, hfq'⟩, E', hE'_mem, hE'_ne, hfqE'⟩
    have hqZ : q ∈ Z := hf_T.injective hfq' ▸ hq'Z
    by_cases hSub : E' ⊆ Set.range f_T
    · obtain ⟨Z', hZ'_mem, hPre_sub_Z'⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible
          (f_T ⁻¹' E') (hPreimIrred hE'_mem.1 hSub)
      have hZ'_ne : Z' ≠ Z := by
        intro hEqZ
        rw [hEqZ] at hPre_sub_Z'
        have hE'_sub_Enext : E' ⊆ E_next := by
          rw [← Set.image_preimage_eq_iff.mpr hSub]
          exact Set.image_mono hPre_sub_Z'
        exact hE'_ne (le_antisymm hE'_sub_Enext (hE'_mem.2 hEnext_mem.1 hE'_sub_Enext))
      exact Or.inl ⟨hqZ, Z', hZ'_mem, hZ'_ne, hPre_sub_Z' hfqE'⟩
    · exact Or.inr ⟨hqZ, Or.inl ⟨E', hE'_mem, hfqE', hSub⟩⟩
  have hUnion_fin : (Δ_int ∪ (Z ∩ S_ext)).Finite :=
    hΔint_fin.union (hS_fin.subset Set.inter_subset_right)
  have hΔtilde_fin : Δ_tilde.Finite := hUnion_fin.subset hΔ_sub
  have hΔnext_fin : Δ_next.Finite := by
    rw [← hΔ_img]; exact hΔtilde_fin.image f_T
  have hΔ_card : Δ_next.ncard = Δ_tilde.ncard := by
    rw [← hΔ_img]
    exact Set.ncard_image_of_injective Δ_tilde hf_T.injective
  have hex_mark_all : ∀ j : Fin n, ∃ q : ↥T₀,
      (j ∈ M_next → q ∈ Z ∧
        (CategoryTheory.Limits.pullback.fst g_cur s_s).base (f_T q) ∈
          Set.range (τ_cur j).base) := by
    intro j
    by_cases hj : j ∈ M_next
    · obtain ⟨y, ⟨q, hqZ, rfl⟩, hy⟩ := hj
      exact ⟨q, fun _ => ⟨hqZ, hy⟩⟩
    · exact ⟨q₀, fun h => False.elim (hj h)⟩
  choose g_fn hg_spec using hex_mark_all
  let M_tilde : Set ↥T₀ := g_fn '' M_next
  have hMtilde_fin : M_tilde.Finite := M_next.toFinite.image g_fn
  have hM_sub : M_tilde ⊆ Δ_int ∪ (Z ∩ S_ext) := by
    rintro _ ⟨j, hj, rfl⟩
    obtain ⟨hqZ, hfst⟩ := hg_spec j hj
    exact Or.inr ⟨hqZ, Or.inr ⟨j, hfst⟩⟩
  have hg_inj : Set.InjOn g_fn M_next := by
    intro j₁ hj₁ j₂ hj₂ heq
    by_contra hne
    have hs₁ := (hg_spec j₁ hj₁).2
    have hs₂ := (hg_spec j₂ hj₂).2
    rw [heq] at hs₁
    exact Set.disjoint_left.mp (hDisj_τ hne) hs₁ hs₂
  have hM_card_le : M_next.ncard ≤ M_tilde.ncard :=
    Set.ncard_le_ncard_of_injOn g_fn (fun j hj => ⟨j, hj, rfl⟩) hg_inj hMtilde_fin
  have hDisj_ΔM : Disjoint Δ_tilde M_tilde := by
    rw [Set.disjoint_left]
    rintro q ⟨hqE, E', hE'_mem, hE'_ne, hqE'⟩ ⟨j, hj, rfl⟩
    obtain ⟨b_s, hb_s⟩ := (hg_spec j hj).2
    obtain ⟨V_sm, hb_sm, hSm_V⟩ := hτ_sm j b_s
    rw [hb_s] at hb_sm
    obtain ⟨W_y, hWy_mem, hWy_pre⟩ :=
      hSm_preirred Q_s.asIdeal.ResidueField s_s (f_T (g_fn j)) V_sm hb_sm hSm_V
    exact hE'_ne (hUniqPre W_y hWy_mem hWy_pre hE'_mem hEnext_mem hqE' hqE)
  have hSum_le : Δ_next.ncard + M_next.ncard ≤ 2 := by
    change Δ_int.ncard + (Z ∩ S_ext).ncard ≤ 2 at hDeg_Z
    rw [hΔ_card]
    have h1 : (Δ_tilde ∪ M_tilde).ncard = Δ_tilde.ncard + M_tilde.ncard :=
      Set.ncard_union_eq hDisj_ΔM hΔtilde_fin hMtilde_fin
    have h2 : (Δ_tilde ∪ M_tilde).ncard ≤ (Δ_int ∪ (Z ∩ S_ext)).ncard :=
      Set.ncard_le_ncard (Set.union_subset hΔ_sub hM_sub) hUnion_fin
    have h3 : (Δ_int ∪ (Z ∩ S_ext)).ncard ≤ Δ_int.ncard + (Z ∩ S_ext).ncard :=
      Set.ncard_union_le Δ_int (Z ∩ S_ext)
    omega
  refine ⟨E_next, hQs_ne, hxs_over, hEnext_mem,
    ⟨Z_sch, ιZ ≫ ι_T, isoP1.trans Φ_P1, inferInstance, hInt_Z, ?_, ?_⟩,
    ?_, hΔnext_fin, hSum_le⟩
  · change Set.range (ι_T.base ∘ ιZ.base) = ι_T.base '' Z
    rw [Set.range_comp, hRange_Z]
  · rw [Category.assoc, hιT_snd, ← Category.assoc ιZ, hIso_Z,
      Category.assoc, ← hΦ_comm, ← Category.assoc]
    rfl
  · rintro _ ⟨q, _, rfl⟩
    have hz : (CategoryTheory.Limits.pullback.fst g_cur s_s).base (ι_T.base q) =
        (CategoryTheory.Limits.pullback.fst g_cur ι_W0).base
          (ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q)) := by
      change (ι_T ≫ CategoryTheory.Limits.pullback.fst g_cur s_s).base q = _
      rw [hιT_fst]; rfl
    rw [hz]
    exact hClContr q

theorem weil_valuation_model_section_closedPoint_and_step_closure (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (h_mod : U'.toScheme ⟶ U_ss)
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (ι_cur : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_cur)
    (hRes_cur : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C_cur g_cur f_dom_cur τ_cur ι_cur)
    (hFinFib : ∀ Q' : PrimeSpectrum ↥V,
      (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q'.asIdeal.ResidueField))))).Finite)
    (Q : PrimeSpectrum ↥V) (x_Q : ↥U'.toScheme)
    (E_Q : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField)))))
    (hExc_Q : IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur Q x_Q E_Q) :
    ∃ (P : PrimeSpectrum ↥V) (x₀ : ↥U'.toScheme) (k : ℕ)
      (Q_seq : Fin (k + 1) → PrimeSpectrum ↥V)
      (x_seq : Fin (k + 1) → ↥U'.toScheme),
      P.asIdeal ≠ ⊥ ∧
      IsClosed ({x₀} : Set ↥U'.toScheme) ∧
      (U'.ι ≫ g').base x₀ = P ∧
      Q_seq 0 = Q ∧
      x_seq 0 = x_Q ∧
      Q_seq (Fin.last k) = P ∧
      x_seq (Fin.last k) = x₀ ∧
      (∀ (ν : Fin k)
          (E_cur : Set ↥(CategoryTheory.Limits.pullback g_cur
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V (Q_seq ν.castSucc).asIdeal.ResidueField))))),
        IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur
          (Q_seq ν.castSucc) (x_seq ν.castSucc) E_cur →
        let L_ν := (Q_seq ν.castSucc).asIdeal.ResidueField
        ∃ (W₀ : ValuationSubring L_ν)
          (ℰ : AlgebraicGeometry.Scheme.{u})
          (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀)),
          (Q_seq ν.castSucc).asIdeal ≠ ⊥ ∧
          IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥ ∧
          (∀ P' : PrimeSpectrum ↥W₀,
            P'.asIdeal = ⊥ ∨ P'.asIdeal = IsLocalRing.maximalIdeal ↥W₀) ∧
          IsStrictlySemistableCurveOverValuation W₀ g_ℰ ∧
          AlgebraicGeometry.IsProper g_ℰ ∧
          (∃ isoGen : CategoryTheory.Limits.pullback g_ℰ
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ≅
                (weilProjectiveSpaceOver L_ν 1).left,
            CategoryTheory.Limits.pullback.snd g_ℰ
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) =
              isoGen.hom ≫ (weilProjectiveSpaceOver L_ν 1).hom) ∧
          let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
          let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
          let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
          ∃ (S_ext : Set ↥T₀),
            S_ext.Finite ∧
            S_ext.ncard ≤ 2 ∧
            (∀ q ∈ S_ext, ∀ Z₁ ∈ irreducibleComponents ↥T₀, ∀ Z₂ ∈ irreducibleComponents ↥T₀,
              q ∈ Z₁ → q ∈ Z₂ → Z₁ = Z₂) ∧
            (∀ Z ∈ irreducibleComponents ↥T₀,
              (∃ (Z_sch : AlgebraicGeometry.Scheme.{u}) (ιZ : Z_sch ⟶ T₀)
                  (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left),
                AlgebraicGeometry.IsClosedImmersion ιZ ∧
                AlgebraicGeometry.IsIntegral Z_sch ∧
                Set.range ιZ.base = Z ∧
                ιZ ≫ CategoryTheory.Limits.pullback.snd g_ℰ s₀ =
                  isoP1.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom) →
              {q ∈ Z | ∃ Z' ∈ irreducibleComponents ↥T₀, Z' ≠ Z ∧ q ∈ Z'}.Finite →
              {q ∈ Z | ∃ Z' ∈ irreducibleComponents ↥T₀, Z' ≠ Z ∧ q ∈ Z'}.ncard +
                (Z ∩ S_ext).ncard ≤ 2 →
              ∃ (E_next : Set ↥(CategoryTheory.Limits.pullback g_cur
                  (AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom (algebraMap ↥V (Q_seq ν.succ).asIdeal.ResidueField))))),
                IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur
                  (Q_seq ν.succ) (x_seq ν.succ) E_next)) :=
by
  obtain ⟨P, x₀, k, Q_seq, x_seq, hP_ne, hx₀_cl, hx₀_P, hQ0, hx0, hQk, hxk, hChain_i, hStepChain⟩ :=
    weil_valuation_section_closedPoint_and_rankOne_step_chain K m V hPkg C_K p_K n σ_K
      C' g' τ' ι' hMod' U' C_cur g_cur f_dom_cur hRes_cur.2.2.1 τ_cur Q x_Q E_Q hExc_Q
  refine ⟨P, x₀, k, Q_seq, x_seq, hP_ne, hx₀_cl, hx₀_P, hQ0, hx0, hQk, hxk, ?_⟩
  intro ν E_cur hExc_cur
  obtain ⟨W₀, ρ_V, ψ_s, σ_ν, hMax_W₀, hRank1_W₀, hρ_sub, hρ_ker, hρ_comap,
      hPre_W0, hψ_comm, hσ_comm, hσ_gen, hσ_cl⟩ :=
    hStepChain ν
  let Q_b := Q_seq ν.castSucc
  let Q_s := Q_seq ν.succ
  let L_ν := Q_b.asIdeal.ResidueField
  let s_b := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V L_ν))
  let ι_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)
  have ⟨hQb_ne, _hxb_over, hE_irred, ⟨E_sch, ιE, isoP1, hCl_E, hInt_E, hRange_E, hIso_E⟩,
      hContr_E, _hΔ_fin, _hSum_E⟩ :=
    hExc_cur
  have hu_comm : CategoryTheory.Limits.pullback.fst g_cur s_b ≫ g_cur =
      (CategoryTheory.Limits.pullback.snd g_cur s_b ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ≫ ι_W0 := by
    rw [CategoryTheory.Category.assoc]
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ ι_W0 = s_b := by
      dsimp [ι_W0, s_b, L_ν]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hρ_sub]
    rw [hmap]
    exact CategoryTheory.Limits.pullback.condition
  let u_gen : CategoryTheory.Limits.pullback g_cur s_b ⟶
      CategoryTheory.Limits.pullback g_cur ι_W0 :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst g_cur s_b)
      (CategoryTheory.Limits.pullback.snd g_cur s_b ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype))
      hu_comm
  have hu_fst : u_gen ≫ CategoryTheory.Limits.pullback.fst g_cur ι_W0 =
      CategoryTheory.Limits.pullback.fst g_cur s_b :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hu_snd : u_gen ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 =
      CategoryTheory.Limits.pullback.snd g_cur s_b ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  let ℰ := AlgebraicGeometry.Scheme.Hom.image (ιE ≫ u_gen)
  let ι_ℰ := AlgebraicGeometry.Scheme.Hom.imageι (ιE ≫ u_gen)
  let g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) :=
    ι_ℰ ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0
  obtain ⟨hProp_ℰ, hIsoGen, hGenRange, hClContr⟩ :=
    weil_schematic_image_proper_and_generic_p1_iso K V C' C_cur g' hMod'.2.2.1 U'
      g_cur f_dom_cur hRes_cur.2.1 hRes_cur.2.2.1 Q_b (x_seq ν.castSucc) (x_seq ν.succ)
      W₀ hMax_W₀ hRank1_W₀ ρ_V hρ_sub σ_ν hσ_comm hσ_gen hσ_cl
      E_cur E_sch ιE isoP1 hCl_E hInt_E hRange_E hIso_E hContr_E u_gen hu_fst hu_snd
  have hAlg_L : IsAlgClosed Q_b.asIdeal.ResidueField :=
    hPkg.2.2.2.2.1 Q_b.asIdeal hQb_ne
  obtain ⟨hSS_ℰ, hSm_preirred, hSm_open, hBdry_dich⟩ :=
    weil_rankOne_schematic_image_strictlySemistable_and_local_branches K V C_cur g_cur
      hRes_cur.1 Q_b hAlg_L W₀ hMax_W₀ hRank1_W₀ ρ_V hρ_sub hρ_ker
      E_cur hE_irred E_sch ιE isoP1 hCl_E hInt_E hRange_E hIso_E u_gen hu_fst hu_snd
  have hQ_le : Q_b.asIdeal ≤ Q_s.asIdeal := by
    rw [← hρ_ker, ← hρ_comap]
    exact Ideal.comap_mono bot_le
  obtain ⟨S_ext, hS_fin, hS_le2, hS_uniq, hLift⟩ :=
    weil_step_closedFiber_boundary_and_marking_transfer K V C_K C' U_ss C_cur p_K g' n τ'
      hMod'.2.2.2.2.2.2.1 ι' U' h_mod ι_U' g_cur f_dom_cur τ_cur ι_cur hRes_cur
      Q_b Q_s hQ_le (hChain_i ν.succ).1 (hFinFib Q_s)
      (x_seq ν.castSucc) (x_seq ν.succ) (hChain_i ν.succ).2
      E_cur hExc_cur W₀ hMax_W₀ hRank1_W₀ ρ_V ψ_s hρ_sub hρ_ker hρ_comap hPre_W0 hψ_comm
      u_gen hu_fst hu_snd ℰ ι_ℰ inferInstance
      hProp_ℰ hGenRange hClContr hSm_preirred hSm_open hBdry_dich
  exact ⟨W₀, ℰ, g_ℰ, hQb_ne, hMax_W₀, hRank1_W₀, hSS_ℰ, hProp_ℰ, hIsoGen,
    S_ext, hS_fin, hS_le2, hS_uniq, hLift⟩

theorem weil_rankOne_algClosed_gauss_parameter_and_dichotomy (L : Type u) [Field L] [IsAlgClosed L]
    (W₀ : ValuationSubring L)
    (hMax : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1 : ∀ P : PrimeSpectrum ↥W₀,
      P.asIdeal = ⊥ ∨ P.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (F : Type u) [Field F] (φ_LF : L →+* F) (t : F)
    (ht_tr : ∀ P : Polynomial L, P ≠ 0 → Polynomial.eval₂ φ_LF t P ≠ 0)
    (ht_gen : ∀ f : F, ∃ P Q : Polynomial L, Q ≠ 0 ∧
      f * Polynomial.eval₂ φ_LF t Q = Polynomial.eval₂ φ_LF t P) :
    (∀ (B : Type u) [CommRing B] [IsDomain B]
        (ψ_BF : B →+* F) (γ : Polynomial ↥W₀ →+* B)
        (𝔓 : Ideal B) [𝔓.IsPrime],
      Function.Injective ψ_BF →
      (∀ x : F, ∃ b s : B, s ≠ 0 ∧ ψ_BF s * x = ψ_BF b) →
      RingHom.Etale γ →
      (∀ r : ↥W₀, ψ_BF (γ (Polynomial.C r)) = φ_LF (W₀.subtype r)) →
      Ideal.comap γ 𝔓 = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W₀) →
      ∃ (W_Z : ValuationSubring F)
        (hB_WZ : ∀ b : B, ψ_BF b ∈ W_Z)
        (α_Z π_Z : L),
        IsRankOneGaussLinearVal W₀ φ_LF t W_Z α_Z π_Z ∧
        (∀ x : F, x ∈ W_Z ↔ ∃ (b s : B), s ∉ 𝔓 ∧ ψ_BF s * x = ψ_BF b) ∧
        (∀ b : B, (⟨ψ_BF b, hB_WZ b⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z ↔ b ∈ 𝔓)) ∧
    (∀ (W_Z W' : ValuationSubring F)
        (hW₀_W' : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W')
        (α_Z π_Z : L),
      IsRankOneGaussLinearVal W₀ φ_LF t W_Z α_Z π_Z →
      (∀ r : ↥W₀,
        (⟨φ_LF (W₀.subtype r), hW₀_W' r⟩ : ↥W') ∈ IsLocalRing.maximalIdeal ↥W' ↔
          r ∈ IsLocalRing.maximalIdeal ↥W₀) →
      W' ≠ W_Z →
      (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∉ W' ∨
        ∃ (hu_W' : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W') (c₀ : ↥W₀),
          (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu_W'⟩ : ↥W') -
            ⟨φ_LF (W₀.subtype c₀), hW₀_W' c₀⟩ ∈ IsLocalRing.maximalIdeal ↥W') :=
by
  classical
  let _ := hMax
  let m₀ : Ideal ↥W₀ := IsLocalRing.maximalIdeal ↥W₀
  have hm₀_max : m₀.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥W₀
  have hm₀_ne_top : m₀ ≠ ⊤ := hm₀_max.ne_top
  have h1_not_m₀ : (1 : ↥W₀) ∉ m₀ := fun h1 =>
    hm₀_ne_top (Ideal.eq_top_of_isUnit_mem m₀ h1 isUnit_one)
  have : IsIntegrallyClosed ↥W₀ := instIsIntegrallyClosedSubtypeMemValuationSubring W₀

  
  have hNormPoly : ∀ (R : Polynomial L), R ≠ 0 →
      ∃ (c_R : L) (R₀ : Polynomial ↥W₀),
        c_R ≠ 0 ∧
        (∃ i : ℕ, R₀.coeff i ∉ m₀) ∧
        Polynomial.C c_R * Polynomial.map W₀.subtype R₀ = R ∧
        ∀ x_eval : F,
          Polynomial.eval₂ φ_LF x_eval R =
            φ_LF c_R * Polynomial.eval₂ (φ_LF.comp W₀.subtype) x_eval R₀ := by
    intro R hR
    have hsupp : R.support.Nonempty := Polynomial.support_nonempty.mpr hR
    obtain ⟨i_max, hi_max_mem, hi_max_le⟩ :=
      Finset.exists_max_image R.support (fun i => W₀.valuation (R.coeff i)) hsupp
    let c_R : L := R.coeff i_max
    have hc_R_ne : c_R ≠ 0 := Polynomial.mem_support_iff.mp hi_max_mem
    have hvc_ne : W₀.valuation c_R ≠ 0 := (Valuation.ne_zero_iff W₀.valuation).mpr hc_R_ne
    have hr_mem : ∀ i : ℕ, R.coeff i * c_R⁻¹ ∈ W₀ := by
      intro i
      by_cases hi : i ∈ R.support
      · rw [← ValuationSubring.valuation_le_one_iff, map_mul, map_inv₀]
        calc
          W₀.valuation (R.coeff i) * (W₀.valuation c_R)⁻¹
              ≤ W₀.valuation c_R * (W₀.valuation c_R)⁻¹ :=
                mul_le_mul_of_nonneg_right (hi_max_le i hi) zero_le
          _ = 1 := mul_inv_cancel₀ hvc_ne
      · have h0 : R.coeff i = 0 := Polynomial.notMem_support_iff.mp hi
        rw [h0, zero_mul]
        exact W₀.zero_mem
    let R₀ : Polynomial ↥W₀ :=
      ∑ i ∈ R.support, Polynomial.monomial i ⟨R.coeff i * c_R⁻¹, hr_mem i⟩
    have hR₀_coeff : ∀ j : ℕ,
        R₀.coeff j = if j ∈ R.support then ⟨R.coeff j * c_R⁻¹, hr_mem j⟩ else 0 := by
      intro j
      simp only [R₀, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Finset.sum_ite_eq']
    have hR₀_imax : R₀.coeff i_max = 1 := by
      rw [hR₀_coeff i_max]
      simp only [hi_max_mem, ↓reduceIte]
      exact Subtype.ext (mul_inv_cancel₀ hc_R_ne)
    have hR_eq : Polynomial.C c_R * Polynomial.map W₀.subtype R₀ = R := by
      ext j
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, hR₀_coeff j]
      by_cases hj : j ∈ R.support
      · simp only [hj, ↓reduceIte]
        change c_R * (R.coeff j * c_R⁻¹) = R.coeff j
        rw [mul_comm (R.coeff j), ← mul_assoc, mul_inv_cancel₀ hc_R_ne, one_mul]
      · simp only [hj, ↓reduceIte, map_zero, mul_zero, Polynomial.notMem_support_iff.mp hj]
    refine ⟨c_R, R₀, hc_R_ne, ⟨i_max, hR₀_imax ▸ h1_not_m₀⟩, hR_eq, fun x_eval => ?_⟩
    conv_lhs => rw [← hR_eq]
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]

  
  have hL_mem : ∀ (W : ValuationSubring F)
      (hW₀ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W)
      (_ : ∀ r : ↥W₀,
        (⟨φ_LF (W₀.subtype r), hW₀ r⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ r ∈ m₀)
      (a : L),
      φ_LF a ∈ W ↔ a ∈ W₀ := by
    intro W hW₀ hMaxCompat a
    refine ⟨fun hφa => ?_, fun ha => hW₀ ⟨a, ha⟩⟩
    by_contra ha_not
    have ha0 : a ≠ 0 := fun h0 => ha_not (h0 ▸ W₀.zero_mem)
    have ha_inv : a⁻¹ ∈ W₀ := (ValuationSubring.mem_or_inv_mem W₀ a).resolve_left ha_not
    let r_inv : ↥W₀ := ⟨a⁻¹, ha_inv⟩
    have hr_max : r_inv ∈ m₀ := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have hval : a⁻¹ * v.1 = 1 := congrArg Subtype.val hv
      have hv_eq : v.1 = a := by
        calc
          v.1 = a * (a⁻¹ * v.1) := by rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
          _ = a := by rw [hval, mul_one]
      exact ha_not (hv_eq ▸ v.2)
    have hW_max : (⟨φ_LF (W₀.subtype r_inv), hW₀ r_inv⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
      (hMaxCompat r_inv).mpr hr_max
    have hprod := Ideal.mul_mem_left (IsLocalRing.maximalIdeal ↥W) (⟨φ_LF a, hφa⟩ : ↥W) hW_max
    have heq1 : (⟨φ_LF a, hφa⟩ : ↥W) * ⟨φ_LF (W₀.subtype r_inv), hW₀ r_inv⟩ = 1 := by
      apply Subtype.ext
      change φ_LF a * φ_LF a⁻¹ = 1
      rw [← map_mul, mul_inv_cancel₀ ha0, map_one]
    rw [heq1] at hprod
    exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top
      (Ideal.eq_top_of_isUnit_mem _ hprod isUnit_one)

  
  let _ : Field (↥W₀ ⧸ m₀) := Ideal.Quotient.field m₀
  have hAlgClosed_k0 : IsAlgClosed (↥W₀ ⧸ m₀) := by
    apply IsAlgClosed.of_exists_root
    intro pbar hp_monic hp_irred
    choose lift_fn hlift_fn using Ideal.Quotient.mk_surjective (I := m₀)
    let d := pbar.natDegree
    have hd_pos : 0 < d := hp_irred.natDegree_pos
    let q_tail : Polynomial ↥W₀ :=
      ∑ i ∈ Finset.range d, Polynomial.C (lift_fn (pbar.coeff i)) * Polynomial.X ^ i
    have htail_coeff : ∀ j : ℕ, q_tail.coeff j = if j < d then lift_fn (pbar.coeff j) else 0 := by
      intro j
      simp only [q_tail, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_range]
    let p : Polynomial ↥W₀ := Polynomial.X ^ d + q_tail
    have hp_map : Polynomial.map (Ideal.Quotient.mk m₀) p = pbar := by
      ext j
      rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_X_pow, htail_coeff]
      by_cases hjd : j = d
      · subst hjd
        have hnot : ¬ (d < d) := lt_irrefl d
        simp only [ite_true, hnot, ite_false, add_zero, map_one]
        exact hp_monic.coeff_natDegree.symm
      · simp only [hjd, ite_false, zero_add]
        by_cases hjlt : j < d
        · simp only [hjlt, ite_true, hlift_fn]
        · simp only [hjlt, ite_false, map_zero]
          exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
    have htail_deg : q_tail.degree < (d : WithBot ℕ) := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [htail_coeff, ite_eq_right_iff]
      omega
    have hp_monic_W : p.Monic := Polynomial.monic_X_pow_add htail_deg
    let pL : Polynomial L := Polynomial.map (algebraMap ↥W₀ L) p
    have hpL_deg : pL.degree ≠ 0 := by
      intro hdeg0
      have heqC := Polynomial.eq_C_of_degree_eq_zero hdeg0
      have hcoeff_d : pL.coeff d = 0 := by
        rw [heqC, Polynomial.coeff_C, ite_eq_right_iff]
        omega
      rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_X_pow, htail_coeff] at hcoeff_d
      have hnot : ¬ (d < d) := lt_irrefl d
      simp only [ite_true, hnot, ite_false, add_zero, map_one, one_ne_zero] at hcoeff_d
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root pL hpL_deg
    have hα_int : _root_.IsIntegral ↥W₀ α := by
      refine ⟨p, hp_monic_W, ?_⟩
      rw [Polynomial.eval₂_eq_eval_map]
      exact hα.eq_zero
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp hα_int
    have hpr : Polynomial.eval r p = 0 := by
      apply Subtype.val_injective
      change (algebraMap ↥W₀ L) (Polynomial.eval r p) = (algebraMap ↥W₀ L) 0
      rw [map_zero, ← Polynomial.eval_map_apply (algebraMap ↥W₀ L)]
      change Polynomial.eval ((algebraMap ↥W₀ L) r) pL = 0
      rw [hr]
      exact hα.eq_zero
    refine ⟨Ideal.Quotient.mk m₀ r, ?_⟩
    rw [← hp_map, Polynomial.eval_map_apply, hpr, map_zero]

  
  have hGaussValPkg : ∀ (α_Z π_Z : L) (hπ_Z : π_Z ≠ 0)
      (W : ValuationSubring F)
      (hW₀ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W)
      (hu : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W)
      (hMaxCompat : ∀ r : ↥W₀,
        (⟨φ_LF (W₀.subtype r), hW₀ r⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ r ∈ m₀)
      (hNotRes : ∀ c₀ : ↥W₀,
        (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu⟩ : ↥W) -
          ⟨φ_LF (W₀.subtype c₀), hW₀ c₀⟩ ∉ IsLocalRing.maximalIdeal ↥W),
      IsRankOneGaussLinearVal W₀ φ_LF t W α_Z π_Z ∧
      (∀ (W' : ValuationSubring F)
          (hW₀' : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W')
          (hu' : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W'),
        (∀ r : ↥W₀,
          (⟨φ_LF (W₀.subtype r), hW₀' r⟩ : ↥W') ∈ IsLocalRing.maximalIdeal ↥W' ↔ r ∈ m₀) →
        (∀ c₀ : ↥W₀,
          (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu'⟩ : ↥W') -
            ⟨φ_LF (W₀.subtype c₀), hW₀' c₀⟩ ∉ IsLocalRing.maximalIdeal ↥W') →
        W' = W) := by
    intro α_Z π_Z hπ_Z W hW₀ hu hMaxCompat hNotRes
    let u_raw : F := (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹
    have hφπ_ne : φ_LF π_Z ≠ 0 := (map_ne_zero_iff φ_LF φ_LF.injective).mpr hπ_Z
    have ht_lin : Polynomial.eval₂ φ_LF u_raw (Polynomial.C π_Z * Polynomial.X + Polynomial.C α_Z) = t := by
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X,
        Polynomial.eval₂_C]
      dsimp only [u_raw]
      rw [mul_comm (φ_LF π_Z), mul_assoc, inv_mul_cancel₀ hφπ_ne, mul_one, sub_add_cancel]
    have hGaussNonvanish : ∀ (W₁ : ValuationSubring F)
        (hW₀₁ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W₁)
        (hu₁ : u_raw ∈ W₁)
        (_ : ∀ r : ↥W₀,
          (⟨φ_LF (W₀.subtype r), hW₀₁ r⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ r ∈ m₀)
        (_ : ∀ c₀ : ↥W₀,
          (⟨u_raw, hu₁⟩ : ↥W₁) - ⟨φ_LF (W₀.subtype c₀), hW₀₁ c₀⟩ ∉
            IsLocalRing.maximalIdeal ↥W₁)
        (Q : Polynomial ↥W₀),
        (∃ i : ℕ, Q.coeff i ∉ m₀) →
        Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W₁.toSubring hW₀₁)
          ⟨u_raw, hu₁⟩ Q ∉ IsLocalRing.maximalIdeal ↥W₁ := by
      intro W₁ hW₀₁ hu₁ hMaxCompat₁ hNotRes₁ Q ⟨i₀, hi₀⟩
      let m₁ : Ideal ↥W₁ := IsLocalRing.maximalIdeal ↥W₁
      let _ : Field (↥W₁ ⧸ m₁) := Ideal.Quotient.field m₁
      let ι₀₁ : ↥W₀ →+* ↥W₁ := (φ_LF.comp W₀.subtype).codRestrict W₁.toSubring hW₀₁
      let u₁ : ↥W₁ := ⟨u_raw, hu₁⟩
      let q₀ : ↥W₀ →+* ↥W₀ ⧸ m₀ := Ideal.Quotient.mk m₀
      let q₁ : ↥W₁ →+* ↥W₁ ⧸ m₁ := Ideal.Quotient.mk m₁
      let ι_bar : ↥W₀ ⧸ m₀ →+* ↥W₁ ⧸ m₁ :=
        Ideal.Quotient.lift m₀ (q₁.comp ι₀₁) (fun r hr =>
          Ideal.Quotient.eq_zero_iff_mem.mpr ((hMaxCompat₁ r).mpr hr))
      have hι_comp : ι_bar.comp q₀ = q₁.comp ι₀₁ := RingHom.ext (fun _ => rfl)
      let Q_bar : Polynomial (↥W₀ ⧸ m₀) := Q.map q₀
      have hQ_bar_ne : Q_bar ≠ 0 := by
        intro h0
        have hc0 : Q_bar.coeff i₀ = 0 := by rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_map] at hc0
        exact hi₀ (Ideal.Quotient.eq_zero_iff_mem.mp hc0)
      have : IsAlgClosed (↥W₀ ⧸ m₀) := hAlgClosed_k0
      obtain ⟨M, hM_eq⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits Q_bar)
      have heval_eq : q₁ (Polynomial.eval₂ ι₀₁ u₁ Q) =
          Polynomial.eval₂ ι_bar (q₁ u₁) Q_bar := by
        rw [Polynomial.eval₂_map, hι_comp, ← Polynomial.hom_eval₂]
      have heval_ne : Polynomial.eval₂ ι_bar (q₁ u₁) Q_bar ≠ 0 := by
        rw [hM_eq, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
          Multiset.map_map]
        apply mul_ne_zero
        · exact (map_ne_zero_iff ι_bar ι_bar.injective).mpr
            (Polynomial.leadingCoeff_ne_zero.mpr hQ_bar_ne)
        · apply Multiset.prod_ne_zero
          intro hzero_mem
          rw [Multiset.mem_map] at hzero_mem
          obtain ⟨a, _, ha_eq⟩ := hzero_mem
          obtain ⟨c₀, rfl⟩ := Ideal.Quotient.mk_surjective a
          simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
            Polynomial.eval₂_C] at ha_eq
          have hq_sub : q₁ (u₁ - ι₀₁ c₀) = 0 := by
            rw [map_sub]
            exact ha_eq
          exact hNotRes₁ c₀ (Ideal.Quotient.eq_zero_iff_mem.mp hq_sub)
      intro hmem
      exact heval_ne (heval_eq.symm.trans (Ideal.Quotient.eq_zero_iff_mem.mpr hmem))
    have hRepF : ∀ (f : F), f ≠ 0 →
        ∃ (a_f : L) (P₀ Q₀ : Polynomial ↥W₀),
          a_f ≠ 0 ∧
          (∃ i : ℕ, P₀.coeff i ∉ m₀) ∧
          (∃ i : ℕ, Q₀.coeff i ∉ m₀) ∧
          f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀ =
            φ_LF a_f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀ := by
      intro f hf
      obtain ⟨P, Q, hQ, hf_PQ⟩ := ht_gen f
      have hevalQ_ne : Polynomial.eval₂ φ_LF t Q ≠ 0 := ht_tr Q hQ
      have hevalP_ne : Polynomial.eval₂ φ_LF t P ≠ 0 := by
        rw [← hf_PQ]
        exact mul_ne_zero hf hevalQ_ne
      let linPoly : Polynomial L := Polynomial.C π_Z * Polynomial.X + Polynomial.C α_Z
      let P₁ : Polynomial L := P.comp linPoly
      let Q₁ : Polynomial L := Q.comp linPoly
      have hP₁_eval : Polynomial.eval₂ φ_LF u_raw P₁ = Polynomial.eval₂ φ_LF t P := by
        dsimp only [P₁, linPoly]
        rw [Polynomial.eval₂_comp, ht_lin]
      have hQ₁_eval : Polynomial.eval₂ φ_LF u_raw Q₁ = Polynomial.eval₂ φ_LF t Q := by
        dsimp only [Q₁, linPoly]
        rw [Polynomial.eval₂_comp, ht_lin]
      have hP₁_ne : P₁ ≠ 0 := fun h0 => hevalP_ne (by rw [← hP₁_eval, h0, Polynomial.eval₂_zero])
      have hQ₁_ne : Q₁ ≠ 0 := fun h0 => hevalQ_ne (by rw [← hQ₁_eval, h0, Polynomial.eval₂_zero])
      obtain ⟨c_P, P₀, hc_P_ne, hP₀_prim, _, hP₀_eval⟩ := hNormPoly P₁ hP₁_ne
      obtain ⟨c_Q, Q₀, hc_Q_ne, hQ₀_prim, _, hQ₀_eval⟩ := hNormPoly Q₁ hQ₁_ne
      have hφ_cQ_ne : φ_LF c_Q ≠ 0 := (map_ne_zero_iff φ_LF φ_LF.injective).mpr hc_Q_ne
      refine ⟨c_P * c_Q⁻¹, P₀, Q₀, mul_ne_zero hc_P_ne (inv_ne_zero hc_Q_ne),
        hP₀_prim, hQ₀_prim, ?_⟩
      have hrel : f * (φ_LF c_Q * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀) =
          φ_LF c_P * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀ := by
        rw [← hQ₀_eval u_raw, ← hP₀_eval u_raw, hQ₁_eval, hP₁_eval]
        exact hf_PQ
      apply mul_left_cancel₀ hφ_cQ_ne
      calc
        φ_LF c_Q * (f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀)
            = f * (φ_LF c_Q * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀) := by ring
        _ = φ_LF c_P * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀ := hrel
        _ = φ_LF c_Q * (φ_LF (c_P * c_Q⁻¹) *
              Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀) := by
            rw [map_mul, map_inv₀]
            calc
              φ_LF c_P * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀
                  = (φ_LF c_Q * (φ_LF c_Q)⁻¹) * φ_LF c_P *
                      Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀ := by
                    rw [mul_inv_cancel₀ hφ_cQ_ne, one_mul]
              _ = φ_LF c_Q * (φ_LF c_P * (φ_LF c_Q)⁻¹ *
                    Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀) := by ring
    have hSubEval : ∀ (W₁ : ValuationSubring F)
        (hW₀₁ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W₁)
        (hu₁ : u_raw ∈ W₁) (R₀ : Polynomial ↥W₀),
        ((Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W₁.toSubring hW₀₁)
          (⟨u_raw, hu₁⟩ : ↥W₁) R₀ : ↥W₁) : F) =
          Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ := by
      intro W₁ hW₀₁ hu₁ R₀
      have hcomp : W₁.subtype.comp ((φ_LF.comp W₀.subtype).codRestrict W₁.toSubring hW₀₁) =
          φ_LF.comp W₀.subtype := RingHom.ext (fun _ => rfl)
      have hhom :=
        Polynomial.hom_eval₂ R₀ ((φ_LF.comp W₀.subtype).codRestrict W₁.toSubring hW₀₁)
          W₁.subtype ⟨u_raw, hu₁⟩
      rw [hcomp] at hhom
      exact hhom
    have hUnitEval : ∀ (W₁ : ValuationSubring F)
        (hW₀₁ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W₁)
        (hu₁ : u_raw ∈ W₁)
        (hMaxCompat₁ : ∀ r : ↥W₀,
          (⟨φ_LF (W₀.subtype r), hW₀₁ r⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ r ∈ m₀)
        (hNotRes₁ : ∀ c₀ : ↥W₀,
          (⟨u_raw, hu₁⟩ : ↥W₁) - ⟨φ_LF (W₀.subtype c₀), hW₀₁ c₀⟩ ∉
            IsLocalRing.maximalIdeal ↥W₁)
        (R₀ : Polynomial ↥W₀),
        (∃ i : ℕ, R₀.coeff i ∉ m₀) →
        Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ ≠ 0 ∧
        Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ ∈ W₁ ∧
        (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀)⁻¹ ∈ W₁ := by
      intro W₁ hW₀₁ hu₁ hMaxCompat₁ hNotRes₁ R₀ hprim
      have hnot_m := hGaussNonvanish W₁ hW₀₁ hu₁ hMaxCompat₁ hNotRes₁ R₀ hprim
      let e_R : ↥W₁ :=
        Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W₁.toSubring hW₀₁)
          ⟨u_raw, hu₁⟩ R₀
      have hu_R : IsUnit e_R := IsLocalRing.notMem_maximalIdeal.mp hnot_m
      obtain ⟨v, hv⟩ := hu_R.exists_right_inv
      have hval_eq : (e_R : F) = Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ :=
        hSubEval W₁ hW₀₁ hu₁ R₀
      have hmul1 : Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ * v.1 = 1 := by
        rw [← hval_eq]
        exact congrArg Subtype.val hv
      have hne0 : Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ ≠ 0 :=
        left_ne_zero_of_mul_eq_one hmul1
      have hinv_eq : (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀)⁻¹ = v.1 := by
        calc
          (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀)⁻¹
              = (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀)⁻¹ *
                  (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw R₀ * v.1) := by
                rw [hmul1, mul_one]
          _ = v.1 := by rw [← mul_assoc, inv_mul_cancel₀ hne0, one_mul]
      exact ⟨hne0, hval_eq ▸ e_R.2, hinv_eq ▸ v.2⟩
    have hMemIff : ∀ (W₁ : ValuationSubring F)
        (hW₀₁ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W₁)
        (hu₁ : u_raw ∈ W₁)
        (hMaxCompat₁ : ∀ r : ↥W₀,
          (⟨φ_LF (W₀.subtype r), hW₀₁ r⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ r ∈ m₀)
        (hNotRes₁ : ∀ c₀ : ↥W₀,
          (⟨u_raw, hu₁⟩ : ↥W₁) - ⟨φ_LF (W₀.subtype c₀), hW₀₁ c₀⟩ ∉
            IsLocalRing.maximalIdeal ↥W₁)
        (f : F) (a_f : L) (P₀ Q₀ : Polynomial ↥W₀),
        (∃ i : ℕ, P₀.coeff i ∉ m₀) →
        (∃ i : ℕ, Q₀.coeff i ∉ m₀) →
        f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀ =
          φ_LF a_f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀ →
        (f ∈ W₁ ↔ a_f ∈ W₀) := by
      intro W₁ hW₀₁ hu₁ hMaxCompat₁ hNotRes₁ f a_f P₀ Q₀ hP₀_prim hQ₀_prim hf_eq
      obtain ⟨hP_ne, hP_mem, hP_inv⟩ := hUnitEval W₁ hW₀₁ hu₁ hMaxCompat₁ hNotRes₁ P₀ hP₀_prim
      obtain ⟨hQ_ne, hQ_mem, hQ_inv⟩ := hUnitEval W₁ hW₀₁ hu₁ hMaxCompat₁ hNotRes₁ Q₀ hQ₀_prim
      rw [← hL_mem W₁ hW₀₁ hMaxCompat₁ a_f]
      constructor
      · intro hf_mem
        have heq_a : φ_LF a_f =
            f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀ *
              (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀)⁻¹ := by
          rw [hf_eq, mul_inv_cancel_right₀ hP_ne]
        rw [heq_a]
        exact W₁.toSubring.mul_mem (W₁.toSubring.mul_mem hf_mem hQ_mem) hP_inv
      · intro ha_mem
        have heq_f : f =
            φ_LF a_f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P₀ *
              (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q₀)⁻¹ := by
          rw [← hf_eq, mul_inv_cancel_right₀ hQ_ne]
        rw [heq_f]
        exact W₁.toSubring.mul_mem (W₁.toSubring.mul_mem ha_mem hP_mem) hQ_inv
    refine ⟨⟨hπ_Z, ?_, hW₀, hu, ?_, hMaxCompat,
      hGaussNonvanish W hW₀ hu hMaxCompat hNotRes, ?_⟩, ?_⟩
    · 
      intro V' hWV' hV'_ne_top
      by_contra hne
      have hex : ∃ x : F, x ∈ V' ∧ x ∉ W := by
        by_contra! hall
        exact hne (le_antisymm hall hWV')
      obtain ⟨x, hxV', hxW⟩ := hex
      have hx0 : x ≠ 0 := fun h0 => hxW (h0 ▸ W.zero_mem)
      obtain ⟨a_x, P_x, Q_x, ha_x_ne, hPx_prim, hQx_prim, hx_eq⟩ := hRepF x hx0
      have ha_x_not : a_x ∉ W₀ :=
        fun hax => hxW ((hMemIff W hW₀ hu hMaxCompat hNotRes x a_x P_x Q_x
          hPx_prim hQx_prim hx_eq).mpr hax)
      obtain ⟨hPx_ne, _, hPx_inv⟩ := hUnitEval W hW₀ hu hMaxCompat hNotRes P_x hPx_prim
      obtain ⟨_, hQx_mem, _⟩ := hUnitEval W hW₀ hu hMaxCompat hNotRes Q_x hQx_prim
      have hφax_V' : φ_LF a_x ∈ V' := by
        have heq_ax : φ_LF a_x =
            x * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q_x *
              (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P_x)⁻¹ := by
          rw [hx_eq, mul_inv_cancel_right₀ hPx_ne]
        rw [heq_ax]
        exact V'.toSubring.mul_mem (V'.toSubring.mul_mem hxV' (hWV' hQx_mem)) (hWV' hPx_inv)
      let u₀ : ↥W₀ := ⟨a_x⁻¹, (ValuationSubring.mem_or_inv_mem W₀ a_x).resolve_left ha_x_not⟩
      have hu₀_m₀ : u₀ ∈ m₀ := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu_unit
        obtain ⟨v, hv⟩ := hu_unit.exists_right_inv
        have hval : a_x⁻¹ * v.1 = 1 := congrArg Subtype.val hv
        have hv_eq : v.1 = a_x := by
          calc
            v.1 = a_x * (a_x⁻¹ * v.1) := by rw [← mul_assoc, mul_inv_cancel₀ ha_x_ne, one_mul]
            _ = a_x := by rw [hval, mul_one]
        exact ha_x_not (hv_eq ▸ v.2)
      apply hV'_ne_top
      ext f
      simp only [ValuationSubring.mem_top, iff_true]
      by_cases hf0 : f = 0
      · exact hf0 ▸ V'.zero_mem
      · obtain ⟨a_f, P_f, Q_f, ha_f_ne, hPf_prim, hQf_prim, hf_eq⟩ := hRepF f hf0
        obtain ⟨_, hPf_mem, _⟩ := hUnitEval W hW₀ hu hMaxCompat hNotRes P_f hPf_prim
        obtain ⟨hQf_ne, _, hQf_inv⟩ := hUnitEval W hW₀ hu hMaxCompat hNotRes Q_f hQf_prim
        have hφaf_V' : φ_LF a_f ∈ V' := by
          by_cases haf : a_f ∈ W₀
          · exact hWV' (hW₀ ⟨a_f, haf⟩)
          · let w₀ : ↥W₀ := ⟨a_f⁻¹, (ValuationSubring.mem_or_inv_mem W₀ a_f).resolve_left haf⟩
            have hw₀_ne : w₀ ≠ 0 := fun h0 => inv_ne_zero ha_f_ne (congrArg Subtype.val h0)
            have hu₀_rad : u₀ ∈ (Ideal.span ({w₀} : Set ↥W₀)).radical := by
              rw [Ideal.radical_eq_sInf]
              simp only [Ideal.mem_sInf, Set.mem_ofPred_eq, Ideal.span_singleton_le_iff_mem]
              rintro I ⟨hwI, hI_prime⟩
              have hI_ne : I ≠ ⊥ := fun hbot => hw₀_ne (by rwa [hbot, Ideal.mem_bot] at hwI)
              rcases hRank1 ⟨I, hI_prime⟩ with hbot | hmax
              · exact (hI_ne hbot).elim
              · change u₀ ∈ (⟨I, hI_prime⟩ : PrimeSpectrum ↥W₀).asIdeal
                rw [hmax]
                exact hu₀_m₀
            rw [Ideal.mem_radical_iff] at hu₀_rad
            obtain ⟨k_exp, hk_exp⟩ := hu₀_rad
            rw [Ideal.mem_span_singleton] at hk_exp
            obtain ⟨c, hc⟩ := hk_exp
            have hc_val : (a_x⁻¹) ^ k_exp = a_f⁻¹ * c.1 := by
              have := congrArg Subtype.val hc
              simpa [u₀, w₀] using this
            have haf_eq : a_f = c.1 * a_x ^ k_exp := by
              calc
                a_f = a_f * ((a_x⁻¹) ^ k_exp * a_x ^ k_exp) := by
                      rw [inv_pow, inv_mul_cancel₀ (pow_ne_zero k_exp ha_x_ne), mul_one]
                _ = a_f * (a_f⁻¹ * c.1 * a_x ^ k_exp) := by rw [hc_val]
                _ = (a_f * a_f⁻¹) * (c.1 * a_x ^ k_exp) := by ring
                _ = c.1 * a_x ^ k_exp := by rw [mul_inv_cancel₀ ha_f_ne, one_mul]
            rw [haf_eq, map_mul, map_pow]
            exact V'.toSubring.mul_mem (hWV' (hW₀ c)) (V'.toSubring.pow_mem hφax_V' k_exp)
        have heq_f : f =
            φ_LF a_f * Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw P_f *
              (Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_raw Q_f)⁻¹ := by
          rw [← hf_eq, mul_inv_cancel_right₀ hQf_ne]
        rw [heq_f]
        exact V'.toSubring.mul_mem (V'.toSubring.mul_mem hφaf_V' (hWV' hPf_mem)) (hWV' hQf_inv)
    · 
      apply IsLocalRing.notMem_maximalIdeal.mp
      have h0 := hNotRes 0
      have heq0 : (⟨φ_LF (W₀.subtype 0), hW₀ 0⟩ : ↥W) = 0 := Subtype.ext (by simp)
      rwa [heq0, sub_zero] at h0
    · 
      intro w
      by_cases hw0 : w.1 = 0
      · refine ⟨0, 1, ⟨0, ?_⟩, ?_⟩
        · rw [Polynomial.coeff_one_zero]
          exact h1_not_m₀
        · have hw_eq : w = 0 := Subtype.ext hw0
          simp [hw_eq]
      · obtain ⟨a_w, P₀, Q₀, _, hP₀_prim, hQ₀_prim, hw_eq⟩ := hRepF w.1 hw0
        have haw_mem : a_w ∈ W₀ :=
          (hMemIff W hW₀ hu hMaxCompat hNotRes w.1 a_w P₀ Q₀ hP₀_prim hQ₀_prim hw_eq).mp w.2
        refine ⟨Polynomial.C ⟨a_w, haw_mem⟩ * P₀, Q₀, hQ₀_prim, ?_⟩
        let ι₀ : ↥W₀ →+* ↥W := (φ_LF.comp W₀.subtype).codRestrict W.toSubring hW₀
        have hzero : w * Polynomial.eval₂ ι₀ ⟨u_raw, hu⟩ Q₀ -
            Polynomial.eval₂ ι₀ ⟨u_raw, hu⟩ (Polynomial.C ⟨a_w, haw_mem⟩ * P₀) = 0 := by
          apply Subtype.ext
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C]
          change w.1 * ((Polynomial.eval₂ ι₀ ⟨u_raw, hu⟩ Q₀ : ↥W) : F) -
            φ_LF a_w * ((Polynomial.eval₂ ι₀ ⟨u_raw, hu⟩ P₀ : ↥W) : F) = 0
          rw [hSubEval W hW₀ hu Q₀, hSubEval W hW₀ hu P₀, sub_eq_zero]
          exact hw_eq
        rw [hzero]
        exact Ideal.zero_mem _
    · 
      intro W' hW₀' hu' hMaxCompat' hNotRes'
      ext f
      by_cases hf0 : f = 0
      · subst hf0
        simp only [ValuationSubring.zero_mem]
      · obtain ⟨a_f, P₀, Q₀, _, hP₀_prim, hQ₀_prim, hf_eq⟩ := hRepF f hf0
        rw [hMemIff W' hW₀' hu' hMaxCompat' hNotRes' f a_f P₀ Q₀ hP₀_prim hQ₀_prim hf_eq,
          hMemIff W hW₀ hu hMaxCompat hNotRes f a_f P₀ Q₀ hP₀_prim hQ₀_prim hf_eq]

  
  have hLinearParam : ∀ (W_Z : ValuationSubring F)
      (hW₀ : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W_Z)
      (hMaxCompat : ∀ r : ↥W₀,
        (⟨φ_LF (W₀.subtype r), hW₀ r⟩ : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z ↔ r ∈ m₀)
      (T_B : F) (hTB : T_B ∈ W_Z),
      (∀ c₀ : ↥W₀,
        (⟨T_B, hTB⟩ : ↥W_Z) - ⟨φ_LF (W₀.subtype c₀), hW₀ c₀⟩ ∉
          IsLocalRing.maximalIdeal ↥W_Z) →
      ∃ (α_Z π_Z : L) (hu : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W_Z),
        π_Z ≠ 0 ∧
        ∀ c₀ : ↥W₀,
          (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu⟩ : ↥W_Z) -
            ⟨φ_LF (W₀.subtype c₀), hW₀ c₀⟩ ∉ IsLocalRing.maximalIdeal ↥W_Z := by
    intro W_Z hW₀ hMaxCompat T_B hTB hNotRes
    let m_WZ : Ideal ↥W_Z := IsLocalRing.maximalIdeal ↥W_Z
    have hm_WZ_ne_top : m_WZ ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal ↥W_Z).ne_top
    let U₀_val : Subgroup Fˣ :=
      { carrier := {u : Fˣ | (u : F) ∈ W_Z ∧ ((u⁻¹ : Fˣ) : F) ∈ W_Z}
        one_mem' := ⟨W_Z.one_mem, by simp only [inv_one, Units.val_one, W_Z.one_mem]⟩
        mul_mem' := fun {u₁ u₂} h₁ h₂ =>
          ⟨W_Z.toSubring.mul_mem h₁.1 h₂.1, by
            rw [mul_inv_rev, Units.val_mul]
            exact W_Z.toSubring.mul_mem h₂.2 h₁.2⟩
        inv_mem' := fun {u} h => ⟨h.2, by simpa using h.1⟩ }
    let U₁ : Subgroup Fˣ :=
      { carrier := {u : Fˣ | ∃ hu : (u : F) ∈ W_Z, (⟨(u : F), hu⟩ : ↥W_Z) - 1 ∈ m_WZ}
        one_mem' := by
          refine ⟨W_Z.one_mem, ?_⟩
          have heq : (⟨((1 : Fˣ) : F), W_Z.one_mem⟩ : ↥W_Z) - 1 = 0 :=
            Subtype.ext (by simp)
          rw [heq]
          exact m_WZ.zero_mem
        mul_mem' := by
          rintro u₁ u₂ ⟨hu₁, hm₁⟩ ⟨hu₂, hm₂⟩
          refine ⟨W_Z.toSubring.mul_mem hu₁ hu₂, ?_⟩
          have heq : (⟨((u₁ * u₂ : Fˣ) : F), W_Z.toSubring.mul_mem hu₁ hu₂⟩ : ↥W_Z) - 1 =
              (⟨(u₁ : F), hu₁⟩ - 1) * ⟨(u₂ : F), hu₂⟩ + (⟨(u₂ : F), hu₂⟩ - 1) := by
            apply Subtype.ext
            change (u₁ : F) * (u₂ : F) - 1 = ((u₁ : F) - 1) * (u₂ : F) + ((u₂ : F) - 1)
            ring
          rw [heq]
          exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hm₁) hm₂
        inv_mem' := by
          rintro u ⟨hu, hm⟩
          let w : ↥W_Z := ⟨(u : F), hu⟩
          have hw_not_m : w ∉ m_WZ := by
            intro hwm
            have h1 : (1 : ↥W_Z) ∈ m_WZ := by
              have hsub := Ideal.sub_mem m_WZ hwm hm
              have heq : w - (w - 1) = 1 := by ring
              rwa [heq] at hsub
            exact hm_WZ_ne_top (Ideal.eq_top_of_isUnit_mem m_WZ h1 isUnit_one)
          obtain ⟨w_inv, hw_inv⟩ := (IsLocalRing.notMem_maximalIdeal.mp hw_not_m).exists_right_inv
          have hval : (u : F) * w_inv.1 = 1 := congrArg Subtype.val hw_inv
          have hu_inv_eq : ((u⁻¹ : Fˣ) : F) = w_inv.1 := by
            calc
              ((u⁻¹ : Fˣ) : F) = ((u⁻¹ : Fˣ) : F) * ((u : F) * w_inv.1) := by
                rw [hval, mul_one]
              _ = (((u⁻¹ * u : Fˣ) : F)) * w_inv.1 := by rw [Units.val_mul, mul_assoc]
              _ = w_inv.1 := by simp
          refine ⟨hu_inv_eq ▸ w_inv.2, ?_⟩
          have hw_eq : (⟨((u⁻¹ : Fˣ) : F), hu_inv_eq ▸ w_inv.2⟩ : ↥W_Z) = w_inv :=
            Subtype.ext hu_inv_eq
          rw [hw_eq]
          have heq : w_inv - 1 = -(w - 1) * w_inv := by
            calc
              w_inv - 1 = w_inv - w * w_inv := by rw [hw_inv]
              _ = -(w - 1) * w_inv := by ring
          rw [heq]
          exact Ideal.mul_mem_right _ _ (m_WZ.neg_mem hm) }
    have hU₁_le : U₁ ≤ U₀_val := fun u hu => ⟨hu.choose, (U₁.inv_mem hu).choose⟩
    have hu_pow_mem : ∀ (u : Fˣ) (k : ℕ), 0 < k → u ^ k ∈ U₀_val → u ∈ U₀_val := by
      have hhalf : ∀ (w : Fˣ) (k : ℕ), 0 < k → w ^ k ∈ U₀_val → (w : F) ∈ W_Z := by
        intro w k hk hwk
        by_contra hw_not
        have hw_inv : ((w⁻¹ : Fˣ) : F) ∈ W_Z := by
          rw [Units.val_inv_eq_inv_val]
          exact (ValuationSubring.mem_or_inv_mem W_Z (w : F)).resolve_left hw_not
        let y : ↥W_Z := ⟨((w⁻¹ : Fˣ) : F), hw_inv⟩
        have hy_m : y ∈ m_WZ := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hy_u
          obtain ⟨z, hz⟩ := hy_u.exists_right_inv
          have hval : (w : F)⁻¹ * z.1 = 1 := by
            simpa [y, Units.val_inv_eq_inv_val] using congrArg Subtype.val hz
          have hz_eq : z.1 = (w : F) := by
            calc
              z.1 = (w : F) * ((w : F)⁻¹ * z.1) := by
                rw [← mul_assoc, mul_inv_cancel₀ w.ne_zero, one_mul]
              _ = (w : F) := by rw [hval, mul_one]
          exact hw_not (hz_eq ▸ z.2)
        have hypow_m : y ^ k ∈ m_WZ := by
          obtain ⟨k', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
          rw [pow_succ']
          exact Ideal.mul_mem_right _ m_WZ hy_m
        have hprod := Ideal.mul_mem_left m_WZ ⟨((w ^ k : Fˣ) : F), hwk.1⟩ hypow_m
        have heq1 : (⟨((w ^ k : Fˣ) : F), hwk.1⟩ : ↥W_Z) * y ^ k = 1 := by
          apply Subtype.ext
          change ((w ^ k : Fˣ) : F) * (((w⁻¹ : Fˣ) : F) ^ k) = 1
          rw [Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val, ← mul_pow,
            mul_inv_cancel₀ w.ne_zero, one_pow]
        rw [heq1] at hprod
        exact hm_WZ_ne_top (Ideal.eq_top_of_isUnit_mem m_WZ hprod isUnit_one)
      intro u k hk huk
      refine ⟨hhalf u k hk huk, hhalf u⁻¹ k hk ?_⟩
      rw [inv_pow]
      exact U₀_val.inv_mem huk
    have hTB_not_m : (⟨T_B, hTB⟩ : ↥W_Z) ∉ m_WZ := by
      have h0 := hNotRes 0
      have heq0 : (⟨φ_LF (W₀.subtype 0), hW₀ 0⟩ : ↥W_Z) = 0 := Subtype.ext (by simp)
      rwa [heq0, sub_zero] at h0
    obtain ⟨w_TB_inv, hw_TB_inv⟩ :=
      (IsLocalRing.notMem_maximalIdeal.mp hTB_not_m).exists_right_inv
    have hTB_mul1 : T_B * w_TB_inv.1 = 1 := congrArg Subtype.val hw_TB_inv
    have hTB_ne : T_B ≠ 0 := left_ne_zero_of_mul_eq_one hTB_mul1
    have hTB_inv_mem : T_B⁻¹ ∈ W_Z := by
      have heq : T_B⁻¹ = w_TB_inv.1 := by
        calc
          T_B⁻¹ = T_B⁻¹ * (T_B * w_TB_inv.1) := by rw [hTB_mul1, mul_one]
          _ = w_TB_inv.1 := by rw [← mul_assoc, inv_mul_cancel₀ hTB_ne, one_mul]
      exact heq ▸ w_TB_inv.2
    let u_TB : Fˣ := Units.mk0 T_B hTB_ne
    have hu_TB_U₀ : u_TB ∈ U₀_val := by
      refine ⟨hTB, ?_⟩
      rw [Units.val_inv_eq_inv_val]
      exact hTB_inv_mem
    let φU : Lˣ →* Fˣ := Units.map φ_LF.toMonoidHom
    have ht_sub_ne : ∀ α : L, t - φ_LF α ≠ 0 := fun α => by
      have h := ht_tr (Polynomial.X - Polynomial.C α) (Polynomial.X_sub_C_ne_zero α)
      rwa [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at h
    let linUnit : L → Fˣ := fun α => Units.mk0 (t - φ_LF α) (ht_sub_ne α)
    obtain ⟨P, Q, hQ, hTB_PQ⟩ := ht_gen T_B
    have hevalQ_ne : Polynomial.eval₂ φ_LF t Q ≠ 0 := ht_tr Q hQ
    have hevalP_ne : Polynomial.eval₂ φ_LF t P ≠ 0 := by
      rw [← hTB_PQ]
      exact mul_ne_zero hTB_ne hevalQ_ne
    have hP : P ≠ 0 := fun h0 => hevalP_ne (by rw [h0, Polynomial.eval₂_zero])
    obtain ⟨M_P, hMP⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits P)
    obtain ⟨M_Q, hMQ⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits Q)
    let S : Finset L := M_P.toFinset ∪ M_Q.toFinset
    have hSplitEval : ∀ (R : Polynomial L) (hR : R ≠ 0) (M : Multiset L),
        R = Polynomial.C R.leadingCoeff *
          (M.map (fun α => Polynomial.X - Polynomial.C α)).prod →
        M.toFinset ⊆ S →
        Polynomial.eval₂ φ_LF t R =
          ((φU (Units.mk0 R.leadingCoeff (Polynomial.leadingCoeff_ne_zero.mpr hR)) *
            ∏ α ∈ S, (linUnit α) ^ (M.count α) : Fˣ) : F) := by
      intro R hR M hRM hM_sub
      conv_lhs => rw [hRM]
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
        Multiset.map_map]
      have hmap_eq : (Polynomial.eval₂ φ_LF t ∘ fun α : L => Polynomial.X - Polynomial.C α) =
          fun α : L => t - φ_LF α := by
        ext α
        simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
          Polynomial.eval₂_C]
      rw [hmap_eq, Finset.prod_multiset_map_count]
      have hprod_sub : (∏ α ∈ M.toFinset, (t - φ_LF α) ^ (M.count α)) =
          ∏ α ∈ S, (t - φ_LF α) ^ (M.count α) := by
        refine Finset.prod_subset hM_sub (fun α _ hnot => ?_)
        have hc0 : M.count α = 0 := Multiset.count_eq_zero.mpr (Multiset.mem_toFinset.not.mp hnot)
        rw [hc0, pow_zero]
      have hval_prod : ∀ (T_s : Finset L),
          ((∏ α ∈ T_s, (linUnit α) ^ (M.count α) : Fˣ) : F) =
            ∏ α ∈ T_s, (t - φ_LF α) ^ (M.count α) := by
        intro T_s
        induction T_s using Finset.induction_on with
        | empty => simp
        | insert a s has ih =>
          rw [Finset.prod_insert has, Finset.prod_insert has, Units.val_mul,
            Units.val_pow_eq_pow_val, ih]
          rfl
      rw [hprod_sub, Units.val_mul, hval_prod S]
      simp only [φU, Units.coe_map, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe,
        Units.val_mk0]
    let c_P_u : Lˣ := Units.mk0 P.leadingCoeff (Polynomial.leadingCoeff_ne_zero.mpr hP)
    let c_Q_u : Lˣ := Units.mk0 Q.leadingCoeff (Polynomial.leadingCoeff_ne_zero.mpr hQ)
    let c₀ : Lˣ := c_P_u * c_Q_u⁻¹
    let e_exp : L → ℤ := fun α => (M_P.count α : ℤ) - (M_Q.count α : ℤ)
    have hu_TB_prod : u_TB = φU c₀ * ∏ α ∈ S, (linUnit α) ^ (e_exp α) := by
      have h_unit_eq : u_TB * (φU c_Q_u * ∏ α ∈ S, (linUnit α) ^ (M_Q.count α)) =
          φU c_P_u * ∏ α ∈ S, (linUnit α) ^ (M_P.count α) := by
        apply Units.ext
        rw [Units.val_mul, ← hSplitEval Q hQ M_Q hMQ Finset.subset_union_right,
          ← hSplitEval P hP M_P hMP Finset.subset_union_left]
        exact hTB_PQ
      calc
        u_TB = (u_TB * (φU c_Q_u * ∏ α ∈ S, (linUnit α) ^ (M_Q.count α))) *
            (φU c_Q_u * ∏ α ∈ S, (linUnit α) ^ (M_Q.count α))⁻¹ := by
          rw [mul_inv_cancel_right]
        _ = (φU c_P_u * ∏ α ∈ S, (linUnit α) ^ (M_P.count α)) *
            ((φU c_Q_u)⁻¹ * (∏ α ∈ S, (linUnit α) ^ (M_Q.count α))⁻¹) := by
          rw [h_unit_eq, mul_inv_rev, mul_comm ((φU c_Q_u)⁻¹)]
        _ = (φU c_P_u * (φU c_Q_u)⁻¹) *
            ((∏ α ∈ S, (linUnit α) ^ (M_P.count α)) *
              ∏ α ∈ S, ((linUnit α) ^ (M_Q.count α))⁻¹) := by
          rw [Finset.prod_inv_distrib]
          ac_rfl
        _ = φU c₀ * ∏ α ∈ S, (linUnit α) ^ (e_exp α) := by
          rw [← map_inv, ← map_mul, ← Finset.prod_mul_distrib]
          congr 1
          refine Finset.prod_congr rfl (fun α _ => ?_)
          dsimp only [e_exp]
          rw [sub_eq_add_neg, zpow_add, zpow_neg, zpow_natCast, zpow_natCast]
    by_contra! hContra
    let InValGroup : L → Prop := fun α => ∃ d : Lˣ, linUnit α * (φU d)⁻¹ ∈ U₀_val
    have hIn_U₁ : ∀ α : L, InValGroup α → ∃ d' : Lˣ, linUnit α * (φU d')⁻¹ ∈ U₁ := by
      rintro α ⟨d, hd⟩
      have hu_d : (t - φ_LF α) * (φ_LF (d : L))⁻¹ ∈ W_Z := by
        have h1 : ((linUnit α * (φU d)⁻¹ : Fˣ) : F) ∈ W_Z := hd.1
        simpa [linUnit, φU, Units.val_mul, Units.val_inv_eq_inv_val] using h1
      obtain ⟨r₀, hr₀⟩ := hContra α (d : L) hu_d d.ne_zero
      have hr₀_not_m₀ : r₀ ∉ m₀ := by
        intro hr_m
        have hr_mW : (⟨φ_LF (W₀.subtype r₀), hW₀ r₀⟩ : ↥W_Z) ∈ m_WZ :=
          (hMaxCompat r₀).mpr hr_m
        have hu_mW : (⟨(t - φ_LF α) * (φ_LF (d : L))⁻¹, hu_d⟩ : ↥W_Z) ∈ m_WZ := by
          have hadd := Ideal.add_mem m_WZ hr₀ hr_mW
          have heq : (⟨(t - φ_LF α) * (φ_LF (d : L))⁻¹, hu_d⟩ : ↥W_Z) -
              ⟨φ_LF (W₀.subtype r₀), hW₀ r₀⟩ + ⟨φ_LF (W₀.subtype r₀), hW₀ r₀⟩ =
              ⟨(t - φ_LF α) * (φ_LF (d : L))⁻¹, hu_d⟩ := by ring
          rwa [heq] at hadd
        have hprod := Ideal.mul_mem_right
          (⟨(((linUnit α * (φU d)⁻¹)⁻¹ : Fˣ) : F), hd.2⟩ : ↥W_Z) m_WZ hu_mW
        have heq1 : (⟨(t - φ_LF α) * (φ_LF (d : L))⁻¹, hu_d⟩ : ↥W_Z) *
            ⟨(((linUnit α * (φU d)⁻¹)⁻¹ : Fˣ) : F), hd.2⟩ = 1 := by
          apply Subtype.ext
          have hval : ((linUnit α * (φU d)⁻¹ : Fˣ) : F) = (t - φ_LF α) * (φ_LF (d : L))⁻¹ := by
            simp [linUnit, φU, Units.val_mul, Units.val_inv_eq_inv_val]
          change (t - φ_LF α) * (φ_LF (d : L))⁻¹ *
            (((linUnit α * (φU d)⁻¹)⁻¹ : Fˣ) : F) = 1
          rw [← hval, ← Units.val_mul, mul_inv_cancel, Units.val_one]
        rw [heq1] at hprod
        exact hm_WZ_ne_top (Ideal.eq_top_of_isUnit_mem m_WZ hprod isUnit_one)
      obtain ⟨r_inv, hr_inv⟩ := (IsLocalRing.notMem_maximalIdeal.mp hr₀_not_m₀).exists_right_inv
      have hr₀_mul1 : r₀.1 * r_inv.1 = 1 := congrArg Subtype.val hr_inv
      have hr₀_ne : r₀.1 ≠ 0 := left_ne_zero_of_mul_eq_one hr₀_mul1
      let d' : Lˣ := d * Units.mk0 r₀.1 hr₀_ne
      refine ⟨d', ?_⟩
      have hrinv_eq : (r₀.1)⁻¹ = r_inv.1 := by
        calc
          (r₀.1)⁻¹ = (r₀.1)⁻¹ * (r₀.1 * r_inv.1) := by rw [hr₀_mul1, mul_one]
          _ = r_inv.1 := by rw [← mul_assoc, inv_mul_cancel₀ hr₀_ne, one_mul]
      have hval_d' : ((linUnit α * (φU d')⁻¹ : Fˣ) : F) =
          ((t - φ_LF α) * (φ_LF (d : L))⁻¹) * φ_LF (W₀.subtype r_inv) := by
        simp only [d', map_mul, mul_inv_rev, linUnit, φU, Units.val_mul,
          Units.val_inv_eq_inv_val, Units.coe_map, RingHom.toMonoidHom_eq_coe,
          MonoidHom.coe_coe, Units.val_mk0]
        rw [← map_inv₀, hrinv_eq]
        change (t - φ_LF α) * (φ_LF r_inv.1 * (φ_LF (d : L))⁻¹) =
          (t - φ_LF α) * (φ_LF (d : L))⁻¹ * φ_LF r_inv.1
        ring
      have hu_d' : ((linUnit α * (φU d')⁻¹ : Fˣ) : F) ∈ W_Z := by
        rw [hval_d']
        exact W_Z.toSubring.mul_mem hu_d (hW₀ r_inv)
      refine ⟨hu_d', ?_⟩
      have heq_m : (⟨((linUnit α * (φU d')⁻¹ : Fˣ) : F), hu_d'⟩ : ↥W_Z) - 1 =
          (⟨(t - φ_LF α) * (φ_LF (d : L))⁻¹, hu_d⟩ - ⟨φ_LF (W₀.subtype r₀), hW₀ r₀⟩) *
            ⟨φ_LF (W₀.subtype r_inv), hW₀ r_inv⟩ := by
        apply Subtype.ext
        change ((linUnit α * (φU d')⁻¹ : Fˣ) : F) - 1 =
          ((t - φ_LF α) * (φ_LF (d : L))⁻¹ - φ_LF r₀.1) * φ_LF r_inv.1
        rw [hval_d']
        have h1 : φ_LF r₀.1 * φ_LF r_inv.1 = 1 := by
          rw [← map_mul, hr₀_mul1, map_one]
        calc
          (t - φ_LF α) * (φ_LF (d : L))⁻¹ * φ_LF (W₀.subtype r_inv) - 1
              = (t - φ_LF α) * (φ_LF (d : L))⁻¹ * φ_LF r_inv.1 -
                  φ_LF r₀.1 * φ_LF r_inv.1 := by rw [h1]; rfl
          _ = ((t - φ_LF α) * (φ_LF (d : L))⁻¹ - φ_LF r₀.1) * φ_LF r_inv.1 := by ring
      rw [heq_m]
      exact Ideal.mul_mem_right _ _ hr₀
    have hContraConst : ∀ (c_tilde : Lˣ) (v_tot : Fˣ),
        v_tot ∈ U₁ → u_TB = φU c_tilde * v_tot → False := by
      intro c_tilde v_tot hv_tot h_eq
      have hc_U₀ : φU c_tilde ∈ U₀_val := by
        have h1 : φU c_tilde = u_TB * v_tot⁻¹ := by rw [h_eq, mul_inv_cancel_right]
        rw [h1]
        exact U₀_val.mul_mem hu_TB_U₀ (U₀_val.inv_mem (hU₁_le hv_tot))
      have hc_W₀ : (c_tilde : L) ∈ W₀ :=
        (hL_mem W_Z hW₀ hMaxCompat (c_tilde : L)).mp hc_U₀.1
      let r_c : ↥W₀ := ⟨(c_tilde : L), hc_W₀⟩
      obtain ⟨hv_WZ, hv_m⟩ := hv_tot
      have hdiff_m : (⟨T_B, hTB⟩ : ↥W_Z) - ⟨φ_LF (W₀.subtype r_c), hW₀ r_c⟩ ∈ m_WZ := by
        have heq : (⟨T_B, hTB⟩ : ↥W_Z) - ⟨φ_LF (W₀.subtype r_c), hW₀ r_c⟩ =
            ⟨φ_LF (W₀.subtype r_c), hW₀ r_c⟩ * (⟨(v_tot : F), hv_WZ⟩ - 1) := by
          apply Subtype.ext
          have hval : T_B = φ_LF (c_tilde : L) * (v_tot : F) := by
            have := congrArg (Units.val : Fˣ → F) h_eq
            simpa [u_TB, φU] using this
          change T_B - φ_LF (c_tilde : L) = φ_LF (c_tilde : L) * ((v_tot : F) - 1)
          rw [hval]
          ring
        rw [heq]
        exact Ideal.mul_mem_left m_WZ _ hv_m
      exact hNotRes r_c hdiff_m
    let S_in : Finset L := S.filter InValGroup
    let S_out : Finset L := S.filter (fun α => ¬ InValGroup α)
    let d_in : L → Lˣ := fun α => if h : InValGroup α then (hIn_U₁ α h).choose else 1
    let v_in : L → Fˣ := fun α => linUnit α * (φU (d_in α))⁻¹
    have hv_in_U₁ : ∀ α ∈ S_in, v_in α ∈ U₁ := by
      intro α hα
      have h : InValGroup α := (Finset.mem_filter.mp hα).2
      dsimp only [v_in, d_in]
      simp only [h, ↓reduceDIte]
      exact (hIn_U₁ α h).choose_spec
    have hprod_Sin : (∏ α ∈ S_in, (linUnit α) ^ (e_exp α)) =
        φU (∏ α ∈ S_in, (d_in α) ^ (e_exp α)) * ∏ α ∈ S_in, (v_in α) ^ (e_exp α) := by
      have hlin : ∀ α : L, linUnit α = φU (d_in α) * v_in α := fun α => by
        dsimp only [v_in]
        rw [mul_comm (φU (d_in α)), inv_mul_cancel_right]
      calc
        (∏ α ∈ S_in, (linUnit α) ^ (e_exp α))
            = ∏ α ∈ S_in, (φU (d_in α) ^ (e_exp α) * (v_in α) ^ (e_exp α)) := by
              refine Finset.prod_congr rfl (fun α _ => ?_)
              rw [hlin α, mul_zpow]
        _ = (∏ α ∈ S_in, φU ((d_in α) ^ (e_exp α))) * ∏ α ∈ S_in, (v_in α) ^ (e_exp α) := by
              rw [Finset.prod_mul_distrib]
              congr 1
              exact Finset.prod_congr rfl (fun α _ => (map_zpow φU _ _).symm)
        _ = φU (∏ α ∈ S_in, (d_in α) ^ (e_exp α)) * ∏ α ∈ S_in, (v_in α) ^ (e_exp α) := by
              rw [map_prod]
    have hS_split : (∏ α ∈ S, (linUnit α) ^ (e_exp α)) =
        (∏ α ∈ S_in, (linUnit α) ^ (e_exp α)) * ∏ α ∈ S_out, (linUnit α) ^ (e_exp α) :=
      (Finset.prod_filter_mul_prod_filter_not S InValGroup _).symm
    let c_tilde : Lˣ := c₀ * ∏ α ∈ S_in, (d_in α) ^ (e_exp α)
    let v_Sin : Fˣ := ∏ α ∈ S_in, (v_in α) ^ (e_exp α)
    have hv_Sin_U₁ : v_Sin ∈ U₁ :=
      U₁.prod_mem (fun α hα => U₁.zpow_mem (hv_in_U₁ α hα) (e_exp α))
    by_cases hSout : S_out.Nonempty
    · obtain ⟨α₀, hα₀⟩ := hSout
      have hα₀_out : ¬ InValGroup α₀ := (Finset.mem_filter.mp hα₀).2
      let w_out : L → Fˣ := fun μ => linUnit μ * (linUnit α₀)⁻¹
      have hw_out_U₁ : ∀ μ ∈ S_out, w_out μ ∈ U₁ := by
        intro μ hμ
        have hμ_out : ¬ InValGroup μ := (Finset.mem_filter.mp hμ).2
        by_cases hμα : μ = α₀
        · subst hμα
          dsimp only [w_out]
          rw [mul_inv_cancel]
          exact U₁.one_mem
        · let δ : Lˣ := Units.mk0 (α₀ - μ) (sub_ne_zero.mpr (Ne.symm hμα))
          let q : Fˣ := φU δ * (linUnit α₀)⁻¹
          have hw_val : ((w_out μ : Fˣ) : F) = 1 + (q : F) := by
            dsimp only [w_out, q, linUnit, φU, δ]
            simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.coe_map,
              RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe, Units.val_mk0, map_sub]
            have h1 : (t - φ_LF α₀) * (t - φ_LF α₀)⁻¹ = 1 := mul_inv_cancel₀ (ht_sub_ne α₀)
            calc
              (t - φ_LF μ) * (t - φ_LF α₀)⁻¹
                  = (t - φ_LF α₀) * (t - φ_LF α₀)⁻¹ +
                      (φ_LF α₀ - φ_LF μ) * (t - φ_LF α₀)⁻¹ := by ring
              _ = 1 + (φ_LF α₀ - φ_LF μ) * (t - φ_LF α₀)⁻¹ := by rw [h1]
          rcases ValuationSubring.mem_or_inv_mem W_Z (q : F) with hq_in | hq_inv_in
          · by_cases hq_m : (⟨(q : F), hq_in⟩ : ↥W_Z) ∈ m_WZ
            · have hw_in : ((w_out μ : Fˣ) : F) ∈ W_Z := by
                rw [hw_val]
                exact W_Z.toSubring.add_mem W_Z.toSubring.one_mem hq_in
              refine ⟨hw_in, ?_⟩
              have heq : (⟨((w_out μ : Fˣ) : F), hw_in⟩ : ↥W_Z) - 1 = ⟨(q : F), hq_in⟩ := by
                apply Subtype.ext
                change ((w_out μ : Fˣ) : F) - 1 = (q : F)
                rw [hw_val, add_sub_cancel_left]
              rwa [heq]
            · obtain ⟨q_inv_w, hq_inv_w⟩ :=
                (IsLocalRing.notMem_maximalIdeal.mp hq_m).exists_right_inv
              have hq_mul1 : (q : F) * q_inv_w.1 = 1 := congrArg Subtype.val hq_inv_w
              have hq_inv_mem : ((q⁻¹ : Fˣ) : F) ∈ W_Z := by
                rw [Units.val_inv_eq_inv_val]
                have heq : (q : F)⁻¹ = q_inv_w.1 := by
                  calc
                    (q : F)⁻¹ = (q : F)⁻¹ * ((q : F) * q_inv_w.1) := by rw [hq_mul1, mul_one]
                    _ = q_inv_w.1 := by rw [← mul_assoc, inv_mul_cancel₀ q.ne_zero, one_mul]
                exact heq ▸ q_inv_w.2
              have hq_U₀ : q ∈ U₀_val := ⟨hq_in, hq_inv_mem⟩
              have hq_inv_eq : q⁻¹ = linUnit α₀ * (φU δ)⁻¹ := by
                dsimp only [q]
                rw [mul_inv_rev, inv_inv]
              exact (hα₀_out ⟨δ, hq_inv_eq ▸ U₀_val.inv_mem hq_U₀⟩).elim
          · have hq_not_W : (q : F) ∉ W_Z := by
              intro hq_in
              have hq_U₀ : q ∈ U₀_val := ⟨hq_in, by rwa [Units.val_inv_eq_inv_val]⟩
              have hq_inv_eq : q⁻¹ = linUnit α₀ * (φU δ)⁻¹ := by
                dsimp only [q]
                rw [mul_inv_rev, inv_inv]
              exact hα₀_out ⟨δ, hq_inv_eq ▸ U₀_val.inv_mem hq_U₀⟩
            have hqinv_W : ((q⁻¹ : Fˣ) : F) ∈ W_Z := by
              rwa [Units.val_inv_eq_inv_val]
            have hμ_val : ((linUnit μ * (φU δ)⁻¹ : Fˣ) : F) = ((q⁻¹ : Fˣ) : F) + 1 := by
              dsimp only [q, linUnit, φU, δ]
              simp only [mul_inv_rev, inv_inv, Units.val_mul, Units.val_inv_eq_inv_val,
                Units.coe_map, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe, Units.val_mk0]
              have hδ_ne : φ_LF (α₀ - μ) ≠ 0 :=
                (map_ne_zero_iff φ_LF φ_LF.injective).mpr (sub_ne_zero.mpr (Ne.symm hμα))
              have h1 : φ_LF (α₀ - μ) * (φ_LF (α₀ - μ))⁻¹ = 1 := mul_inv_cancel₀ hδ_ne
              rw [map_sub] at h1 ⊢
              calc
                (t - φ_LF μ) * (φ_LF α₀ - φ_LF μ)⁻¹
                    = (t - φ_LF α₀) * (φ_LF α₀ - φ_LF μ)⁻¹ +
                        (φ_LF α₀ - φ_LF μ) * (φ_LF α₀ - φ_LF μ)⁻¹ := by ring
                _ = (t - φ_LF α₀) * (φ_LF α₀ - φ_LF μ)⁻¹ + 1 := by rw [h1]
            have hqinv_m : (⟨((q⁻¹ : Fˣ) : F), hqinv_W⟩ : ↥W_Z) ∈ m_WZ := by
              rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
              intro hu_qinv
              obtain ⟨z, hz⟩ := hu_qinv.exists_right_inv
              have hval : (q : F)⁻¹ * z.1 = 1 := by
                simpa [Units.val_inv_eq_inv_val] using congrArg Subtype.val hz
              have hz_eq : z.1 = (q : F) := by
                calc
                  z.1 = (q : F) * ((q : F)⁻¹ * z.1) := by
                    rw [← mul_assoc, mul_inv_cancel₀ q.ne_zero, one_mul]
                  _ = (q : F) := by rw [hval, mul_one]
              exact hq_not_W (hz_eq ▸ z.2)
            have hμ_in : ((linUnit μ * (φU δ)⁻¹ : Fˣ) : F) ∈ W_Z := by
              rw [hμ_val]
              exact W_Z.toSubring.add_mem hqinv_W W_Z.toSubring.one_mem
            have hμ_U₁ : linUnit μ * (φU δ)⁻¹ ∈ U₁ := by
              refine ⟨hμ_in, ?_⟩
              have heq : (⟨((linUnit μ * (φU δ)⁻¹ : Fˣ) : F), hμ_in⟩ : ↥W_Z) - 1 =
                  ⟨((q⁻¹ : Fˣ) : F), hqinv_W⟩ := by
                apply Subtype.ext
                change ((linUnit μ * (φU δ)⁻¹ : Fˣ) : F) - 1 = ((q⁻¹ : Fˣ) : F)
                rw [hμ_val, add_sub_cancel_right]
              rwa [heq]
            exact (hμ_out ⟨δ, hU₁_le hμ_U₁⟩).elim
      let m_sum : ℤ := ∑ μ ∈ S_out, e_exp μ
      have hzpow_sum : (∏ μ ∈ S_out, (linUnit α₀) ^ (e_exp μ)) = (linUnit α₀) ^ m_sum := by
        dsimp only [m_sum]
        induction S_out using Finset.induction_on with
        | empty => simp
        | insert x s hxs ih => rw [Finset.prod_insert hxs, Finset.sum_insert hxs, zpow_add, ih]
      have hprod_Sout : (∏ μ ∈ S_out, (linUnit μ) ^ (e_exp μ)) =
          (linUnit α₀) ^ m_sum * ∏ μ ∈ S_out, (w_out μ) ^ (e_exp μ) := by
        have hlin : ∀ μ : L, linUnit μ = linUnit α₀ * w_out μ := fun μ => by
          dsimp only [w_out]
          rw [mul_comm (linUnit α₀), inv_mul_cancel_right]
        calc
          (∏ μ ∈ S_out, (linUnit μ) ^ (e_exp μ))
              = ∏ μ ∈ S_out, ((linUnit α₀) ^ (e_exp μ) * (w_out μ) ^ (e_exp μ)) := by
                refine Finset.prod_congr rfl (fun μ _ => ?_)
                rw [hlin μ, mul_zpow]
          _ = (∏ μ ∈ S_out, (linUnit α₀) ^ (e_exp μ)) * ∏ μ ∈ S_out, (w_out μ) ^ (e_exp μ) :=
                Finset.prod_mul_distrib
          _ = (linUnit α₀) ^ m_sum * ∏ μ ∈ S_out, (w_out μ) ^ (e_exp μ) := by rw [hzpow_sum]
      let v_tot : Fˣ := v_Sin * ∏ μ ∈ S_out, (w_out μ) ^ (e_exp μ)
      have hv_tot_U₁ : v_tot ∈ U₁ :=
        U₁.mul_mem hv_Sin_U₁
          (U₁.prod_mem (fun μ hμ => U₁.zpow_mem (hw_out_U₁ μ hμ) (e_exp μ)))
      have hu_TB_tot : u_TB = φU c_tilde * (linUnit α₀) ^ m_sum * v_tot := by
        rw [hu_TB_prod, hS_split, hprod_Sin, hprod_Sout]
        have hc_map : φU c_tilde = φU c₀ * φU (∏ α ∈ S_in, (d_in α) ^ (e_exp α)) :=
          map_mul φU c₀ _
        rw [hc_map]
        dsimp only [v_tot, v_Sin]
        ac_rfl
      by_cases hm0 : m_sum = 0
      · rw [hm0, zpow_zero, mul_one] at hu_TB_tot
        exact hContraConst c_tilde v_tot hv_tot_U₁ hu_TB_tot
      · let k : ℕ := m_sum.natAbs
        have hk_pos : 0 < k := Int.natAbs_pos.mpr hm0
        let target_c : Lˣ := if 0 < m_sum then c_tilde⁻¹ else c_tilde
        have hdeg_ne : (Polynomial.X ^ k - Polynomial.C (target_c : L) : Polynomial L).degree ≠ 0 := by
          rw [Polynomial.degree_X_pow_sub_C hk_pos (target_c : L)]
          exact Nat.cast_ne_zero.mpr hk_pos.ne'
        obtain ⟨π, hπ_root⟩ := IsAlgClosed.exists_root _ hdeg_ne
        have hπ_pow : π ^ k = (target_c : L) := by
          have h0 := hπ_root.eq_zero
          rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
            Polynomial.eval_C, sub_eq_zero] at h0
          exact h0
        have hπ_ne : π ≠ 0 := fun h0 =>
          target_c.ne_zero (by rw [← hπ_pow, h0, zero_pow hk_pos.ne'])
        let d₀ : Lˣ := Units.mk0 π hπ_ne
        have hd₀_pow : d₀ ^ k = target_c := by
          apply Units.ext
          rw [Units.val_pow_eq_pow_val]
          exact hπ_pow
        have hu_base_U₀ : u_TB * v_tot⁻¹ ∈ U₀_val :=
          U₀_val.mul_mem hu_TB_U₀ (U₀_val.inv_mem (hU₁_le hv_tot_U₁))
        have hu_v_eq : u_TB * v_tot⁻¹ = φU c_tilde * (linUnit α₀) ^ m_sum := by
          rw [hu_TB_tot, mul_inv_cancel_right]
        have hpow_U₀ : (linUnit α₀ * (φU d₀)⁻¹) ^ k ∈ U₀_val := by
          rcases lt_trichotomy m_sum 0 with hm_neg | hm_zero | hm_pos
          · have hm_eq : m_sum = -(k : ℤ) := by
              have h_abs := Int.ofNat_natAbs_of_nonpos hm_neg.le
              dsimp only [k]
              omega
            have htc : target_c = c_tilde := by
              dsimp only [target_c]
              simp only [not_lt.mpr hm_neg.le, ↓reduceIte]
            have heq_inv : ((linUnit α₀ * (φU d₀)⁻¹) ^ k)⁻¹ = u_TB * v_tot⁻¹ := by
              rw [hu_v_eq, hm_eq, zpow_neg, zpow_natCast, mul_pow, inv_pow, ← map_pow,
                hd₀_pow, htc, mul_inv_rev, inv_inv, mul_comm]
            rw [← inv_inv ((linUnit α₀ * (φU d₀)⁻¹) ^ k), heq_inv]
            exact U₀_val.inv_mem hu_base_U₀
          · exact (hm0 hm_zero).elim
          · have hm_eq : m_sum = (k : ℤ) := (Int.natAbs_of_nonneg hm_pos.le).symm
            have htc : target_c = c_tilde⁻¹ := by
              dsimp only [target_c]
              simp only [hm_pos, ↓reduceIte]
            have heq_pos : (linUnit α₀ * (φU d₀)⁻¹) ^ k = u_TB * v_tot⁻¹ := by
              rw [hu_v_eq, hm_eq, zpow_natCast, mul_pow, inv_pow, ← map_pow,
                hd₀_pow, htc, map_inv, inv_inv, mul_comm]
            rw [heq_pos]
            exact hu_base_U₀
        exact hα₀_out ⟨d₀, hu_pow_mem _ k hk_pos hpow_U₀⟩
    · have hSout_empty : S_out = ∅ := Finset.not_nonempty_iff_eq_empty.mp hSout
      rw [hSout_empty, Finset.prod_empty, mul_one] at hS_split
      have hu_TB_Sin : u_TB = φU c_tilde * v_Sin := by
        rw [hu_TB_prod, hS_split, hprod_Sin]
        have hc_map : φU c_tilde = φU c₀ * φU (∏ α ∈ S_in, (d_in α) ^ (e_exp α)) :=
          map_mul φU c₀ _
        rw [hc_map]
        dsimp only [v_Sin]
        ac_rfl
      exact hContraConst c_tilde v_Sin hv_Sin_U₁ hu_TB_Sin

  
  have hEtaleStalkIntegral : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
      [CommRing B] [IsDomain B]
      (F₀_ty F_ty : Type u) [Field F₀_ty] [Field F_ty] [Algebra F₀_ty F_ty]
      (G : ValuationSubring F₀_ty)
      (R_Z : Subring F_ty) [IsLocalRing ↥R_Z]
      (γ : A₀ →+* B), RingHom.Etale γ →
      ∀ (ψ_BF : B →+* F_ty), Function.Injective ψ_BF →
      (∀ x : F_ty, ∃ b s : B, s ≠ 0 ∧ ψ_BF s * x = ψ_BF b) →
      ∀ (𝔓 : Ideal B) [𝔓.IsPrime]
        (p₀ : Ideal A₀) [p₀.IsPrime]
        (ψ_AG : A₀ →+* ↥G)
        (ψ_BRZ : B →+* ↥R_Z)
        (ι_GR : ↥G →+* ↥R_Z),
      (∀ b : B, (ψ_BRZ b : F_ty) = ψ_BF b) →
      (∀ g : ↥G, (ι_GR g : F_ty) = algebraMap F₀_ty F_ty g.1) →
      ψ_BRZ.comp γ = ι_GR.comp ψ_AG →
      @IsLocalization A₀ _ p₀.primeCompl ↥G _ ψ_AG.toAlgebra →
      @IsLocalization B _ 𝔓.primeCompl ↥R_Z _ ψ_BRZ.toAlgebra →
      (∀ g : ↥G, g ∈ IsLocalRing.maximalIdeal ↥G →
        ι_GR g ∈ IsLocalRing.maximalIdeal ↥R_Z) →
      ∀ w : F_ty,
        @IsIntegral ↥G F_ty _ _ ((algebraMap F₀_ty F_ty).comp G.subtype).toAlgebra w →
        w ∈ R_Z := by
    intro A₀ B _ _ _ _ _ F₀ F _ _ _ G R_Z _ γ hEt ψ_BF hInj hFrac 𝔓 _ p₀ _
      ψ_AG ψ_BRZ ι_GR hBRZ_val hι_val hComm hLocG hLocRZ hι_GR_max
    let _ : Algebra A₀ B := γ.toAlgebra
    have : Algebra.Etale A₀ B := RingHom.Etale.toAlgebra hEt
    let _ : Algebra A₀ ↥G := ψ_AG.toAlgebra
    let _ : Algebra B ↥R_Z := ψ_BRZ.toAlgebra
    let _ : Algebra A₀ ↥R_Z := (ψ_BRZ.comp γ).toAlgebra
    let _ : Algebra ↥G ↥R_Z := ι_GR.toAlgebra
    let _ : Algebra ↥G F := ((algebraMap F₀ F).comp G.subtype).toAlgebra
    have : IsLocalization p₀.primeCompl ↥G := hLocG
    have : IsLocalization 𝔓.primeCompl ↥R_Z := hLocRZ
    have : IsScalarTower A₀ B ↥R_Z := IsScalarTower.of_algebraMap_eq' rfl
    have : IsScalarTower A₀ ↥G ↥R_Z := IsScalarTower.of_algebraMap_eq' hComm
    have : IsScalarTower ↥G F₀ F := IsScalarTower.of_algebraMap_eq' rfl
    have : IsScalarTower ↥G ↥R_Z F :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun g => (hι_val g).symm)
    have hIC_G : IsIntegrallyClosed ↥G := instIsIntegrallyClosedSubtypeMemValuationSubring G
    have hι_GR_inj : Function.Injective ι_GR := by
      intro g₁ g₂ h
      have hval : algebraMap F₀ F g₁.1 = algebraMap F₀ F g₂.1 := by
        rw [← hι_val g₁, ← hι_val g₂, h]
      exact Subtype.ext ((algebraMap F₀ F).injective hval)
    have : Module.IsTorsionFree ↥G ↥R_Z :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr hι_GR_inj
    have : IsLocalHom (algebraMap ↥G ↥R_Z) :=
      ⟨fun a hu => by
        by_contra hna
        exact ((IsLocalRing.mem_maximalIdeal _).mp
          (hι_GR_max a ((IsLocalRing.mem_maximalIdeal a).mpr hna))) hu⟩
    have : Algebra.FormallyUnramified B ↥R_Z :=
      Algebra.FormallyUnramified.of_isLocalization 𝔓.primeCompl
    have : Algebra.FormallyUnramified A₀ ↥R_Z :=
      Algebra.FormallyUnramified.comp A₀ B ↥R_Z
    have : Algebra.FormallyUnramified ↥G ↥R_Z :=
      Algebra.FormallyUnramified.localization_base p₀.primeCompl
    have : Algebra.EssFiniteType B ↥R_Z :=
      Algebra.EssFiniteType.of_isLocalization ↥R_Z 𝔓.primeCompl
    have : Algebra.EssFiniteType A₀ ↥R_Z :=
      Algebra.EssFiniteType.comp A₀ B ↥R_Z
    have : Algebra.EssFiniteType ↥G ↥R_Z :=
      Algebra.EssFiniteType.of_comp A₀ ↥G ↥R_Z
    obtain ⟨hSep_res, hMap_max⟩ :=
      (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := ↥G) (S := ↥R_Z)).mp inferInstance
    let m_G : Ideal ↥G := IsLocalRing.maximalIdeal ↥G
    let m_RZ : Ideal ↥R_Z := IsLocalRing.maximalIdeal ↥R_Z
    have hStep1 : ∃ R₁ : Subalgebra ↥G ↥R_Z,
        R₁ ≤ integralClosure ↥G ↥R_Z ∧
        Algebra.IsIntegral ↥G ↥R₁ ∧
        Module.Finite ↥G ↥R₁ ∧
        IsLocalization (Ideal.comap (algebraMap ↥R₁ ↥R_Z) m_RZ).primeCompl ↥R_Z := by
      obtain ⟨r_zmt, hr_not_P, hr_int_A₀, h_zmt_all⟩ :=
        (Algebra.zariskisMainProperty_iff (R := A₀) (p := 𝔓)).mp
          (Algebra.ZariskisMainProperty.of_finiteType (R := A₀) 𝔓)
      obtain ⟨G_fin, hG_adjoin⟩ := (inferInstance : Algebra.FiniteType A₀ B).out
      choose m_zmt hm_zmt using h_zmt_all
      let r_bar : ↥R_Z := ψ_BRZ r_zmt
      have hr_bar_unit : IsUnit r_bar :=
        IsLocalization.map_units ↥R_Z (⟨r_zmt, hr_not_P⟩ : 𝔓.primeCompl)
      let S_zmt : Finset ↥R_Z :=
        insert r_bar (G_fin.image (fun b => ψ_BRZ (r_zmt ^ (m_zmt b) * b)))
      let R₁ : Subalgebra ↥G ↥R_Z := Algebra.adjoin ↥G (↑S_zmt : Set ↥R_Z)
      have hS_zmt_int : ∀ w ∈ S_zmt, _root_.IsIntegral ↥G w := by
