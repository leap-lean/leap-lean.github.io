      have hcomp_img : fst₁.base '' (α_R.base '' E₂) = α.base '' (fst₂.base '' E₂) := by
        rw [← Set.image_comp, ← Set.image_comp]
        have hbase : fst₁.base ∘ α_R.base = α.base ∘ fst₂.base := by
          ext q
          exact congrArg (fun f : CategoryTheory.Limits.pullback g₂ s_R ⟶ Y₁ => f.base q) hfst_comm
        rw [hbase]
      rw [hcomp_img, hE₂_cl, hClImg α.base α.continuous α.isClosedMap y₂, ← hy₁_eq]
    have hfst₁_img_x₁ : fst₁.base '' (α_R.base '' E₂) = fst₁.base '' closure ({x₁} : Set ↥F₁) := by
      rw [hfst₁_img_y₁, ← hx₁_fst,
        ← hClImg fst₁.base fst₁.continuous fst₁.isClosedEmbedding.isClosedMap x₁]
    have hImg_eq_cl : α_R.base '' E₂ = closure ({x₁} : Set ↥F₁) :=
      (Set.image_eq_image fst₁.isClosedEmbedding.injective).mp hfst₁_img_x₁
    refine ⟨?_, ?_⟩
    · by_cases hx₁_cl : IsClosed ({x₁} : Set ↥F₁)
      · exact Or.inl ⟨x₁, hx₁_cl, hImg_eq_cl.trans hx₁_cl.closure_eq⟩
      · have hIrr_cl : closure ({x₁} : Set ↥F₁) ∈ irreducibleComponents ↥F₁ :=
          (hPt₁ x₁ hx₁_cl).1
        have hImg_irr : α_R.base '' E₂ ∈ irreducibleComponents ↥F₁ :=
          hImg_eq_cl.symm ▸ hIrr_cl
        have hImg_stalk : IsComponentStalkVal R g₁ η₁ (α_R.base '' E₂) W :=
          ⟨ψ₁, mW, hmW, hψ₁_η, hfst₁_img_y₁⟩
        refine Or.inr ⟨hImg_irr, hImg_stalk, fun x => ?_⟩
        obtain ⟨q', ⟨q, hqE₂, rfl⟩, hne⟩ := (hComp₁ (α_R.base '' E₂) hImg_irr).1 x
        exact ⟨q, hqE₂, hne⟩
    · intro E₁ hE₁ ⟨ψ'₁, m'W, hm'W, hψ'₁_η, hE₁_cl⟩
      have _ : AlgebraicGeometry.IsDominant
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)) := by
        rw [AlgebraicGeometry.isDominant_iff, DenseRange]
        intro q
        let p₀ : PrimeSpectrum ↥W :=
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)).base (⊥ : PrimeSpectrum F)
        have hle : p₀ ≤ (q : PrimeSpectrum ↥W) := by
          change Ideal.comap W.subtype (⊥ : PrimeSpectrum F).asIdeal ≤ (q : PrimeSpectrum ↥W).asIdeal
          have hbot : (⊥ : PrimeSpectrum F).asIdeal = ⊥ := rfl
          rw [hbot, Ideal.comap_bot_of_injective W.subtype Subtype.val_injective]
          exact bot_le
        have hcl : (q : PrimeSpectrum ↥W) ∈ closure ({p₀} : Set (PrimeSpectrum ↥W)) :=
          (PrimeSpectrum.le_iff_mem_closure p₀ q).mp hle
        have hmem : p₀ ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)).base :=
          ⟨(⊥ : PrimeSpectrum F), rfl⟩
        exact closure_mono (Set.singleton_subset_iff.mpr hmem) hcl
      have hg_eq : ψ₁ ≫ g₁ = ψ'₁ ≫ g₁ := by
        refine AlgebraicGeometry.ext_of_isDominant
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)) ?_
        rw [← CategoryTheory.Category.assoc, hψ₁_η, ← CategoryTheory.Category.assoc, hψ'₁_η]
      have hψ_eq : ψ₁ = ψ'₁ :=
        AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₁ hg_eq
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)) (hψ₁_η.trans hψ'₁_η.symm)
      have hm_eq : mW = m'W := PrimeSpectrum.ext (hmW.trans hm'W.symm)
      have hy₁_eq' : y₁ = ψ'₁.base m'W := by
        dsimp only [y₁]; rw [hψ_eq, hm_eq]
      have hfst_eq_E₁ : fst₁.base '' (α_R.base '' E₂) = fst₁.base '' E₁ := by
        rw [hfst₁_img_y₁, hy₁_eq', hE₁_cl]
      have hImg_E₁ : α_R.base '' E₂ = E₁ :=
        (Set.image_eq_image fst₁.isClosedEmbedding.injective).mp hfst_eq_E₁
      refine ⟨hImg_E₁, fun x => ?_⟩
      obtain ⟨q', hq'E₁, hne⟩ := (hComp₁ E₁ hE₁).1 x
      rw [← hImg_E₁] at hq'E₁
      obtain ⟨q, hqE₂, rfl⟩ := hq'E₁
      exact ⟨q, hqE₂, hne⟩

