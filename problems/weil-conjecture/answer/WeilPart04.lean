theorem weil_polynomial_away_smoothChart_and_localDomain_chartLift : (∀ (B₀ : Type u) [CommRing B₀] (t : B₀)
        (R_z : Type u) [CommRing R_z] [Algebra B₀ R_z] [IsLocalization.Away t R_z],
      let C₀₁ := Localization.Away (Polynomial.X : Polynomial R_z)
      let φ_sm : Polynomial B₀ →+* C₀₁ :=
        (algebraMap (Polynomial R_z) C₀₁).comp (Polynomial.mapRingHom (algebraMap B₀ R_z))
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm)) ∧
      φ_sm.comp Polynomial.C =
        ((algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C).comp (algebraMap B₀ R_z) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))) ∧
    (∀ (R_z : Type u) [CommRing R_z] (π₁' b₁' : R_z)
        (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
        (q : R),
      IsUnit q →
      (∀ (θ₀ : (MvPolynomial (Fin 2) R_z ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π₁'}) →+* R),
        θ₀ (Ideal.Quotient.mk _ (MvPolynomial.C π₁')) ≠ 0 →
        θ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
          θ₀ (Ideal.Quotient.mk _ (MvPolynomial.C π₁')) * q →
        IsUnit (θ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) ∧
      (∀ (θ₁ : (MvPolynomial (Fin 2) R_z ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₁'}) →+* R),
        θ₁ (Ideal.Quotient.mk _ (MvPolynomial.C π₁')) ≠ 0 →
        θ₁ (Ideal.Quotient.mk _ (MvPolynomial.C π₁' * MvPolynomial.X 1)) =
          θ₁ (Ideal.Quotient.mk _ (MvPolynomial.C π₁')) * q →
        IsUnit (θ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) ∧
      (∀ (M : AlgebraicGeometry.Scheme.{u}) (U : M.Opens)
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M),
        ψ.base (IsLocalRing.closedPoint R) ∈ U →
        Set.range ψ.base ⊆ (U : Set M))) :=
by
  refine ⟨?_, ?_⟩
  · intro B₀ _ t R_z _ _ _ C₀₁ φ_sm
    let _ : Algebra (Polynomial B₀) (Polynomial R_z) := Polynomial.algebra B₀ R_z
    have hLocPoly : IsLocalization.Away (Polynomial.C t) (Polynomial R_z) := by
      have h1 : IsLocalization (Submonoid.map Polynomial.C (Submonoid.powers t)) (Polynomial R_z) :=
        Polynomial.isLocalization (Submonoid.powers t) R_z
      rwa [Submonoid.map_powers] at h1
    have hOpen₁ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap B₀ R_z)))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.C t)
    have hOpen₂ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial R_z) C₀₁))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial R_z)
    have hOpen_φ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm)) := by
      have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial R_z) C₀₁)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap B₀ R_z))) := by
        dsimp only [φ_sm]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hfac]
      exact inferInstance
    refine ⟨hOpen_φ, ?_, ?_⟩
    · ext b
      dsimp only [φ_sm]
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
    · have _ : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin 1)) B₀ (MvPolynomial (Fin 1) B₀) :=
        Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial B₀ (Fin 1)
      have hStdPoly : Algebra.IsStandardSmoothOfRelativeDimension 1 B₀ (Polynomial B₀) := by
        have h := Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv
          (Nat.card (Fin 1)) (MvPolynomial.uniqueAlgEquiv B₀ (Fin 1))
        rwa [Nat.card_fin] at h
      have hStdHom : RingHom.IsStandardSmoothOfRelativeDimension 1 (Polynomial.C : B₀ →+* Polynomial B₀) :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap (n := 1)).mpr hStdPoly
      have hLocHom : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1)
          (Polynomial.C : B₀ →+* Polynomial B₀) :=
        RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso Polynomial.C hStdHom
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B₀ →+* Polynomial B₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr hLocHom
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm)) :=
        inferInstance
      have hsm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) :=
        inferInstance
      simpa using hsm01
  · intro R_z _ π₁' b₁' R _ _ _ q hq
    refine ⟨?_, ?_, ?_⟩
    · intro θ₀ hπ₀ hrel₀
      let I₀ : Ideal (MvPolynomial (Fin 2) R_z) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π₁'}
      have hmk_zero : Ideal.Quotient.mk I₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π₁') = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      have hmk_eq : Ideal.Quotient.mk I₀ (MvPolynomial.X 0) * Ideal.Quotient.mk I₀ (MvPolynomial.X 1) =
          Ideal.Quotient.mk I₀ (MvPolynomial.C π₁') := by
        rw [map_sub, map_mul] at hmk_zero
        exact sub_eq_zero.mp hmk_zero
      have hθ_eq : θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 0)) * θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) =
          θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) := by
        rw [← map_mul, hmk_eq]
      have hmul : θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) * (q * θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1))) =
          θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) * 1 := by
        calc θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) * (q * θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)))
            = (θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) * q) * θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) :=
              (mul_assoc _ _ _).symm
          _ = θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 0)) * θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) := by
              rw [← hrel₀]
          _ = θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) := hθ_eq
          _ = θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.C π₁')) * 1 := (mul_one _).symm
      have hqX1 : q * θ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) = 1 :=
        mul_left_cancel₀ hπ₀ hmul
      exact IsUnit.of_mul_eq_one_right q hqX1
    · intro θ₁ hπ₁ hrel₁
      let I₁ : Ideal (MvPolynomial (Fin 2) R_z) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₁'}
      have hmul : θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.C π₁')) * θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.X 1)) =
          θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.C π₁')) * q := by
        calc θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.C π₁')) * θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.X 1))
            = θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.C π₁' * MvPolynomial.X 1)) := by
              rw [map_mul, map_mul]
          _ = θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.C π₁')) * q := hrel₁
      have hX1_eq : θ₁ (Ideal.Quotient.mk I₁ (MvPolynomial.X 1)) = q :=
        mul_left_cancel₀ hπ₁ hmul
      rwa [hX1_eq]
    · intro M U ψ hm y hy
      rcases hy with ⟨x, rfl⟩
      exact ((IsLocalRing.specializes_closedPoint x).map ψ.base.hom.continuous).mem_open U.isOpen hm

theorem weil_local_linear_p1_nodal_blowup_model (K : Type u) [Field K]
    (V : ValuationSubring K)
    (P : Ideal ↥V) [P.IsPrime]
    (t_z a s₁ π₁ a' : ↥V)
    (ht_z : t_z ∉ P)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z]
    [IsLocalization.Away t_z R_z] [IsLocalization.AtPrime R_z P]
    (ha_ne : a ≠ 0)
    (ha_eq : a = π₁ * a')
    (hs₁ : s₁ ∉ P)
    (hπ₁_mem : π₁ ∈ P) :
    ∃ (A_loc : CommRingCat.{u})
      (φ_Rz : CommRingCat.of R_z ⟶ A_loc)
      (φ_glob_loc :
        CommRingCat.of
          (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ⟶
        A_loc)
      (u₀ u₁ : ↑A_loc),
      CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫ φ_glob_loc =
        CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz ∧
      φ_glob_loc.hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = u₀ ∧
      φ_glob_loc.hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = u₁ ∧
      (Ideal.span {algebraMap ↥V R_z a} : Ideal R_z) ≠ ⊤ ∧
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map φ_glob_loc) ∧
      Set.range (AlgebraicGeometry.Spec.map φ_glob_loc).base =
        {q : ↥(AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))) |
          Ideal.Quotient.mk _ (MvPolynomial.C t_z) ∉ q.asIdeal} ∧
      Function.Surjective
        ((Ideal.Quotient.mk (Ideal.span {u₀, u₁})).comp φ_Rz.hom) ∧
      RingHom.ker
        ((Ideal.Quotient.mk (Ideal.span {u₀, u₁})).comp φ_Rz.hom) =
        Ideal.span {algebraMap ↥V R_z a} ∧
      ∃ (M_nod : AlgebraicGeometry.Scheme.{u})
        (p_nod : M_nod ⟶ AlgebraicGeometry.Spec A_loc)
        (U_nod_sm : M_nod.Opens)
        (e_nod_sm : U_nod_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
        IsLocalSemistableBlowupModel V
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))
          (Ideal.span {u₀, u₁} ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)})
          p_nod ∧
        AlgebraicGeometry.Etale e_nod_sm ∧
        U_nod_sm.ι ≫ p_nod ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) =
          e_nod_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (U_nod_sm.ι ≫ p_nod ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)) ∧
        (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
            (ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M_nod)
            (q : R),
          IsUnit q →
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_nod ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))).hom π₁ ≠ 0 →
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_nod ≫ AlgebraicGeometry.Spec.map φ_glob_loc)).hom
              (Ideal.Quotient.mk _ (MvPolynomial.C s₁ * MvPolynomial.X 0)) =
            (AlgebraicGeometry.Spec.preimage
              (ψ_M ≫ p_nod ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))).hom π₁ * q →
          Set.range ψ_M.base ⊆ (U_nod_sm : Set M_nod)) :=
by
  have hπ₁_ne : π₁ ≠ 0 := by
    intro h0
    apply ha_ne
    rw [ha_eq, h0, zero_mul]
  have ha'_ne : a' ≠ 0 := by
    intro h0
    apply ha_ne
    rw [ha_eq, h0, mul_zero]
  have hs₁_ne : s₁ ≠ 0 := by
    intro h0
    apply hs₁
    rw [h0]
    exact P.zero_mem
  let b₁ : ↥V := s₁ * a'
  have hb₁_ne : b₁ ≠ 0 := mul_ne_zero hs₁_ne ha'_ne
  let s₁' : R_z := algebraMap ↥V R_z s₁
  let π₁' : R_z := algebraMap ↥V R_z π₁
  let a'_Rz : R_z := algebraMap ↥V R_z a'
  let b₁' : R_z := algebraMap ↥V R_z b₁
  let a_Rz : R_z := algebraMap ↥V R_z a
  have hs₁_unit : IsUnit s₁' :=
    (IsLocalization.AtPrime.isUnit_to_map_iff R_z P s₁).mpr hs₁
  have hb₁'_eq : b₁' = s₁' * a'_Rz :=
    map_mul (algebraMap ↥V R_z) s₁ a'
  have ha_Rz_eq : a_Rz = π₁' * a'_Rz := by
    change algebraMap ↥V R_z a = algebraMap ↥V R_z π₁ * algebraMap ↥V R_z a'
    rw [ha_eq, map_mul]
  haveI : IsLocalRing R_z := IsLocalization.AtPrime.isLocalRing R_z P
  have ha_mem : a ∈ P := by
    rw [ha_eq]
    exact Ideal.mul_mem_right a' P hπ₁_mem
  have ha_max : a_Rz ∈ IsLocalRing.maximalIdeal R_z :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R_z P a).mpr ha_mem
  have hIBaseNeTop : (Ideal.span {a_Rz} : Ideal R_z) ≠ ⊤ := by
    intro htop
    have hle : Ideal.span ({a_Rz} : Set R_z) ≤ IsLocalRing.maximalIdeal R_z :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha_max)
    rw [htop] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal R_z).ne_top (top_unique hle)
  obtain ⟨Φ_a, hΦa_C, hΦa_X0, hΦa_X1, hOpen_Φa, hRange_Φa, hSurj_a, hKer_a⟩ :=
    weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer ↥V t_z a R_z
  obtain ⟨Φ_π₁, hΦπ₁_C, _, _, hOpen_Φπ₁, _, _, _⟩ :=
    weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer ↥V t_z π₁ R_z
  obtain ⟨Φ_b₁, hΦb₁_C, _, _, hOpen_Φb₁, _, _, _⟩ :=
    weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer ↥V t_z b₁ R_z
  let A_loc_ring := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
    {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_Rz}
  let C₀ := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
    {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π₁'}
  let C₁ := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
    {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₁'}
  let C₀₁ := Localization.Away (Polynomial.X : Polynomial R_z)
  let A_loc : CommRingCat.{u} := CommRingCat.of A_loc_ring
  let φ_Rz : CommRingCat.of R_z ⟶ A_loc :=
    CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
  let φ_glob_loc :
      CommRingCat.of
        (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ⟶
      A_loc :=
    CommRingCat.ofHom Φ_a
  let u₀ : ↑A_loc := Ideal.Quotient.mk _ (MvPolynomial.X 0)
  let u₁ : ↑A_loc := Ideal.Quotient.mk _ (MvPolynomial.X 1)
  have hj_comm :
      CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫ φ_glob_loc =
        CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz := by
    dsimp only [φ_glob_loc, φ_Rz]
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hΦa_C]
  obtain ⟨p₀_hom, p₁_hom, f₀₁_hom, f₁₀_hom,
      ⟨hp₀_C, hp₁_C, _hf₀₁_C, hf₁₀_C⟩,
      ⟨hp₀_sX0, hp₁_sX0⟩,
      ⟨hloc₀₁, hloc₁₀, hcomp₀₁, hgen₀, hgen₁, hinv₀₁⟩,
      ⟨⟨hd₀_mem, hd₀_loc⟩, ⟨hd₁_mem, hd₁_loc⟩, ⟨hd₂_mem, hd₂_loc⟩⟩⟩ :=
    weil_nodal_blowup_chart_overlap_and_centerCompl_algebra
      R_z s₁' π₁' a'_Rz b₁' a_Rz hs₁_unit hb₁'_eq ha_Rz_eq
  let I_center : Ideal ↑A_loc :=
    Ideal.span {u₀, u₁} ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)}
  obtain ⟨M_nod, p_nod, ι₀, ι₁,
      hOpen_ι₀, hOpen_ι₁, hCov_M, hGlue₀₁, hι₀_p, hι₁_p, hProp_pnod, hIso_pnod⟩ :=
    weil_twoChart_affine_gluing_proper_and_openIso
      A_loc_ring C₀ C₁ C₀₁ p₀_hom p₁_hom
      (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      f₀₁_hom f₁₀_hom hloc₀₁ hloc₁₀ hcomp₀₁ hgen₀ hgen₁ hinv₀₁
      I_center u₀ u₁ (φ_Rz.hom (algebraMap ↥V R_z π₁)) rfl
      hd₀_mem hd₀_loc hd₁_mem hd₁_loc hd₂_mem hd₂_loc
  obtain ⟨hSmPkg, hLiftPkg⟩ :=
    weil_polynomial_away_smoothChart_and_localDomain_chartLift.{u}
  obtain ⟨hOpen_φsm, hφsm_C, hSm_φsm⟩ := hSmPkg ↥V t_z R_z
  let φ_sm : Polynomial ↥V →+* C₀₁ :=
    (algebraMap (Polynomial R_z) C₀₁).comp (Polynomial.mapRingHom (algebraMap ↥V R_z))
  haveI : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen_ι₀
  haveI : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen_ι₁
  haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_π₁)) :=
    hOpen_Φπ₁
  haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_b₁)) :=
    hOpen_Φb₁
  haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm)) :=
    hOpen_φsm
  let f₁₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀₁) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of C₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀_hom)
  haveI hOpen_f₁₀ : AlgebraicGeometry.IsOpenImmersion f₁₀ := by
    letI : Algebra C₁ C₀₁ := f₁₀_hom.toAlgebra
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization
      (Ideal.Quotient.mk _ (MvPolynomial.X 1))
  let j_sm : AlgebraicGeometry.Spec (CommRingCat.of C₀₁) ⟶ M_nod := f₁₀ ≫ ι₁
  haveI hOpen_jsm : AlgebraicGeometry.IsOpenImmersion j_sm := inferInstance
  let U_nod_sm : M_nod.Opens := j_sm.opensRange
  let e_nod_sm : U_nod_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)) :=
    j_sm.isoOpensRange.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sm)
  let g_loc : AlgebraicGeometry.Spec A_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)
  have he_nod_comm :
      U_nod_sm.ι ≫ p_nod ≫ g_loc =
        e_nod_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    apply (CategoryTheory.cancel_epi j_sm.isoOpensRange.hom).mp
    have hL :
        j_sm.isoOpensRange.hom ≫ U_nod_sm.ι ≫ p_nod ≫ g_loc =
          f₁₀ ≫ (ι₁ ≫ p_nod) ≫ g_loc := by
      rw [← CategoryTheory.Category.assoc, j_sm.isoOpensRange_hom_ι]
      simp only [j_sm, CategoryTheory.Category.assoc]
    rw [hL, hι₁_p]
    dsimp only [e_nod_sm, f₁₀, g_loc, φ_Rz]
    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
    rw [← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext x
    change f₁₀_hom ((p₁_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) (algebraMap ↥V R_z x)) =
      (φ_sm.comp Polynomial.C) x
    rw [hp₁_C]
    change ((f₁₀_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (algebraMap ↥V R_z)) x =
      (φ_sm.comp Polynomial.C) x
    rw [hf₁₀_C, hφsm_C]
  refine ⟨A_loc, φ_Rz, φ_glob_loc, u₀, u₁,
    hj_comm, hΦa_X0, hΦa_X1, hIBaseNeTop, hOpen_Φa, hRange_Φa, hSurj_a, hKer_a,
    M_nod, p_nod, U_nod_sm, e_nod_sm, ?_, ?_, he_nod_comm, ?_, ?_⟩
  · refine ⟨hProp_pnod, hIso_pnod, ?_⟩
    intro y
    rcases hCov_M y with hy₀ | hy₁
    · right
      refine ⟨ι₀.opensRange, π₁,
        ι₀.isoOpensRange.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_π₁),
        hy₀, hπ₁_ne, inferInstance, ?_⟩
      apply (CategoryTheory.cancel_epi ι₀.isoOpensRange.hom).mp
      have hL :
          ι₀.isoOpensRange.hom ≫ ι₀.opensRange.ι ≫ p_nod ≫ g_loc =
            (ι₀ ≫ p_nod) ≫ g_loc := by
        rw [← CategoryTheory.Category.assoc, ι₀.isoOpensRange_hom_ι,
          CategoryTheory.Category.assoc]
      rw [hL, hι₀_p]
      dsimp only [g_loc, φ_Rz]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      rw [← RingHom.comp_assoc, hp₀_C, hΦπ₁_C]
    · right
      refine ⟨ι₁.opensRange, b₁,
        ι₁.isoOpensRange.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_b₁),
        hy₁, hb₁_ne, inferInstance, ?_⟩
      apply (CategoryTheory.cancel_epi ι₁.isoOpensRange.hom).mp
      have hL :
          ι₁.isoOpensRange.hom ≫ ι₁.opensRange.ι ≫ p_nod ≫ g_loc =
