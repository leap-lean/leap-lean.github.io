      intro y
      let u : κ' := π y.1.1
      have hu_ne0 : u ≠ 0 := by
        intro h0
        have hy_mq : y.1.1 ∈ m_q := (Ideal.Quotient.eq_zero_iff_mem).mp h0
        exact y.2 hy_mq
      let d_y : D := Φ₁ y.1
      have hdy_fst : d_y.fst = u := hΦ₁_fst y.1
      let d_inv : D :=
        TrivSqZeroExt.inl u⁻¹ + TrivSqZeroExt.inr (-(u⁻¹ * (u⁻¹ * d_y.snd)))
      refine isUnit_iff_exists_inv.mpr ⟨d_inv, ?_⟩
      apply TrivSqZeroExt.ext
      · rw [TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_one]
        dsimp only [d_inv]
        rw [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr,
          add_zero, hdy_fst]
        exact mul_inv_cancel₀ hu_ne0
      · rw [TrivSqZeroExt.snd_mul, TrivSqZeroExt.snd_one]
        dsimp only [d_inv]
        rw [TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add, TrivSqZeroExt.fst_inl,
          TrivSqZeroExt.snd_inl, TrivSqZeroExt.fst_inr, TrivSqZeroExt.snd_inr,
          zero_add, add_zero, hdy_fst, smul_eq_mul,
          MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
        calc u * -(u⁻¹ * (u⁻¹ * d_y.snd)) + d_y.snd * u⁻¹
            = -((u * u⁻¹) * (u⁻¹ * d_y.snd)) + d_y.snd * u⁻¹ := by ring
          _ = -(1 * (u⁻¹ * d_y.snd)) + d_y.snd * u⁻¹ := by rw [mul_inv_cancel₀ hu_ne0]
          _ = 0 := by ring
    let g_Φ₁ : @RingHom ↥S_θ D _ (@Semiring.toNonAssocSemiring D CommSemiring.toSemiring) :=
      { toFun := fun x => Φ₁ x
        map_one' := Φ₁.map_one
        map_mul' := Φ₁.map_mul
        map_zero' := Φ₁.map_zero
        map_add' := Φ₁.map_add }
    have : IsLocalization p_θ.primeCompl C_q := hLoc_θ
    let φ₂_raw :=
      IsLocalization.lift (M := p_θ.primeCompl) (S := C_q) (g := g_Φ₁) hΦ₁_units
    let φ₂_ring : C_q →+* D :=
      { toFun := φ₂_raw
        map_one' := φ₂_raw.map_one
        map_mul' := φ₂_raw.map_mul
        map_zero' := φ₂_raw.map_zero
        map_add' := φ₂_raw.map_add }
    have hφ₂_apply : ∀ x : ↥S_θ, φ₂_ring (algebraMap ↥S_θ C_q x) = Φ₁ x :=
      fun x => IsLocalization.lift_eq (M := p_θ.primeCompl) (S := C_q) (g := g_Φ₁) hΦ₁_units x
    let Φ₂ : C_q →ₐ[A₁] D :=
      { toRingHom := φ₂_ring
        commutes' := fun a => by
          change φ₂_ring (algebraMap ↥S_θ C_q (algebraMap A₁ ↥S_θ a)) = algebraMap A₁ D a
          rw [hφ₂_apply]
          exact Φ₁.commutes a }
    have hfst_eq : fst_D.comp Φ₂.toRingHom = fst_D.comp Φ_base.toRingHom := by
      apply IsLocalization.ringHom_ext p_θ.primeCompl
      ext x
      change (φ₂_ring (algebraMap ↥S_θ C_q x)).fst = (Φ_base x.1).fst
      rw [hφ₂_apply x, hΦ₁_fst x]
      rfl
    let I_sq : Ideal D := RingHom.ker fst_D
    have hI_sq_pow : I_sq ^ 2 = ⊥ := by
      rw [sq, eq_bot_iff, Ideal.mul_le]
      intro x hx y hy
      rw [Ideal.mem_bot]
      have hxf : x.fst = 0 := hx
      have hyf : y.fst = 0 := hy
      apply TrivSqZeroExt.ext
      · rw [TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_zero, hxf, zero_mul]
      · rw [TrivSqZeroExt.snd_mul, TrivSqZeroExt.snd_zero, hxf, hyf,
          zero_smul, MulOpposite.op_zero, zero_smul, add_zero]
    have hQuot_eq : (Ideal.Quotient.mkₐ A₁ I_sq).comp Φ₂ =
        (Ideal.Quotient.mkₐ A₁ I_sq).comp Φ_base := by
      ext z
      change Ideal.Quotient.mk I_sq (Φ₂ z) = Ideal.Quotient.mk I_sq (Φ_base z)
      rw [Ideal.Quotient.eq]
      change fst_D (Φ₂ z - Φ_base z) = 0
      rw [map_sub, sub_eq_zero]
      exact RingHom.congr_fun hfst_eq z
    have hΦ_eq : Φ₂ = Φ_base :=
      Algebra.FormallyUnramified.comp_injective I_sq hI_sq_pow hQuot_eq
    have hθ_eq : Φ₂ θ = Φ_base θ := congrArg (fun f : C_q →ₐ[A₁] D => f θ) hΦ_eq
    have hθ_lhs : Φ₂ θ = Φ_base θ + ε := by
      change φ₂_ring (algebraMap ↥S_θ C_q θ_S) = Φ_base θ + ε
      rw [hφ₂_apply θ_S, hΦ₁_θ]
    rw [hθ_lhs] at hθ_eq
    have hsnd_eq := congrArg TrivSqZeroExt.snd hθ_eq
    rw [TrivSqZeroExt.snd_add] at hsnd_eq
    change (0 : κ') + (1 : κ') = 0 at hsnd_eq
    rw [zero_add] at hsnd_eq
    exact one_ne_zero hsnd_eq
  have hPK_irred : Irreducible P_K := by
    have hPK_not_unit : ¬ IsUnit P_K := by
      intro hu
      have hdeg0 : P_K.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hu
      omega
    refine ⟨hPK_not_unit, ?_⟩
    intro A B hAB
    by_contra h_not_or
    obtain ⟨hA_nu, hB_nu⟩ := not_or.mp h_not_or
    have hA_ne0 : A ≠ 0 := by
      intro h0; rw [h0, zero_mul] at hAB; exact hPK_monic.ne_zero hAB
    have hB_ne0 : B ≠ 0 := by
      intro h0; rw [h0, mul_zero] at hAB; exact hPK_monic.ne_zero hAB
    let c_A : K₀ := A.leadingCoeff
    have hc_A_ne0 : c_A ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hA_ne0
    let G_K : Polynomial K₀ := A * Polynomial.C c_A⁻¹
    let H_K : Polynomial K₀ := Polynomial.C c_A * B
    have hGH_eq : G_K * H_K = P_K := by
      dsimp only [G_K, H_K]
      calc (A * Polynomial.C c_A⁻¹) * (Polynomial.C c_A * B)
          = A * (Polynomial.C c_A⁻¹ * Polynomial.C c_A) * B := by ring
        _ = A * 1 * B := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_A_ne0, Polynomial.C_1]
        _ = P_K := by rw [mul_one, ← hAB]
    have hGK_monic : G_K.Monic := Polynomial.monic_mul_leadingCoeff_inv hA_ne0
    have hHK_monic : H_K.Monic :=
      Polynomial.Monic.of_mul_monic_left hGK_monic (hGH_eq.symm ▸ hPK_monic)
    have hGK_deg_pos : 1 ≤ G_K.natDegree := by
      by_contra hlt
      have h0 : G_K.natDegree = 0 := Nat.eq_zero_of_not_pos hlt
      have hGK1 : G_K = 1 := Polynomial.eq_one_of_monic_natDegree_zero hGK_monic h0
      have hA_eq : A = Polynomial.C c_A := by
        calc A = A * (Polynomial.C c_A⁻¹ * Polynomial.C c_A) := by
              rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_A_ne0, Polynomial.C_1, mul_one]
          _ = G_K * Polynomial.C c_A := by rw [← mul_assoc]
          _ = Polynomial.C c_A := by rw [hGK1, one_mul]
      rw [hA_eq] at hA_nu
      exact hA_nu (Polynomial.isUnit_C.mpr (IsUnit.mk0 c_A hc_A_ne0))
    have hHK_deg_pos : 1 ≤ H_K.natDegree := by
      by_contra hlt
      have h0 : H_K.natDegree = 0 := Nat.eq_zero_of_not_pos hlt
      have hHK1 : H_K = 1 := Polynomial.eq_one_of_monic_natDegree_zero hHK_monic h0
      have hB_eq : B = Polynomial.C c_A⁻¹ := by
        calc B = (Polynomial.C c_A⁻¹ * Polynomial.C c_A) * B := by
              rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_A_ne0, Polynomial.C_1, one_mul]
          _ = Polynomial.C c_A⁻¹ * H_K := by rw [mul_assoc]
          _ = Polynomial.C c_A⁻¹ := by rw [hHK1, mul_one]
      rw [hB_eq] at hB_nu
      exact hB_nu (Polynomial.isUnit_C.mpr (IsUnit.mk0 _ (inv_ne_zero hc_A_ne0)))
    have hdeg_sum : P_K.natDegree = G_K.natDegree + H_K.natDegree := by
      rw [← hGH_eq, Polynomial.natDegree_mul hGK_monic.ne_zero hHK_monic.ne_zero]
    have hGK_lt : G_K.natDegree < P_K.natDegree := by omega
    have hHK_lt : H_K.natDegree < P_K.natDegree := by omega
    have hGK_dvd_MK : G_K ∣ M_K := dvd_trans ⟨H_K, hGH_eq.symm⟩ hPK_dvd_MK
    have hHK_dvd_MK : H_K ∣ M_K := dvd_trans ⟨G_K, by rw [mul_comm, hGH_eq]⟩ hPK_dvd_MK
    obtain ⟨G₀, hG₀_monic, hG₀_map⟩ := hLiftMonic G_K hGK_monic hGK_dvd_MK
    obtain ⟨H₀, hH₀_monic, hH₀_map⟩ := hLiftMonic H_K hHK_monic hHK_dvd_MK
    have hP₀_eq_GH : P₀ = G₀ * H₀ := by
      apply Polynomial.map_injective (algebraMap A₁ K₀) hInj_A₁K₀
      rw [Polynomial.map_mul, hP₀_map, hG₀_map, hH₀_map, hGH_eq]
    let g_θ : C_q := Polynomial.aeval θ G₀
    let h_θ : C_q := Polynomial.aeval θ H₀
    have hg_θ_ne0 : g_θ ≠ 0 := by
      intro hg0
      change Polynomial.aeval θ G₀ = 0 at hg0
      have hev_GK : ev G_K = 0 := by
        rw [← hG₀_map, hev_map G₀, hg0, map_zero]
      have hdvd : P_K ∣ G_K := (hPK_dvd_iff G_K).mp hev_GK
      have hle : P_K.natDegree ≤ G_K.natDegree :=
        Polynomial.natDegree_le_of_dvd hdvd hGK_monic.ne_zero
      omega
    have hh_θ_ne0 : h_θ ≠ 0 := by
      intro hh0
      change Polynomial.aeval θ H₀ = 0 at hh0
      have hev_HK : ev H_K = 0 := by
        rw [← hH₀_map, hev_map H₀, hh0, map_zero]
      have hdvd : P_K ∣ H_K := (hPK_dvd_iff H_K).mp hev_HK
      have hle : P_K.natDegree ≤ H_K.natDegree :=
        Polynomial.natDegree_le_of_dvd hdvd hHK_monic.ne_zero
      omega
    have hgh_mul0 : g_θ * h_θ = 0 := by
      change Polynomial.aeval θ G₀ * Polynomial.aeval θ H₀ = 0
      rw [← map_mul, ← hP₀_eq_GH, hP₀_eval0]
    have hg_θ_mq : g_θ ∈ m_q := by
      rw [IsLocalRing.mem_maximalIdeal]
      intro hu
      exact hh_θ_ne0 (hu.mul_right_eq_zero.mp hgh_mul0)
    have hh_θ_mq : h_θ ∈ m_q := by
      rw [IsLocalRing.mem_maximalIdeal]
      intro hu
      exact hg_θ_ne0 (hu.mul_left_eq_zero.mp hgh_mul0)
    have hd_θ_mq : d_θ ∈ m_q := by
      have hd_eq : d_θ =
          Polynomial.aeval θ (Polynomial.derivative G₀) * h_θ +
          g_θ * Polynomial.aeval θ (Polynomial.derivative H₀) := by
        dsimp only [d_θ, g_θ, h_θ]
        rw [hP₀_eq_GH, Polynomial.derivative_mul, map_add, map_mul, map_mul]
      rw [hd_eq]
      exact m_q.add_mem (m_q.mul_mem_left _ hh_θ_mq) (m_q.mul_mem_right _ hg_θ_mq)
    exact (IsLocalRing.mem_maximalIdeal d_θ).mp hd_θ_mq hd_θ_unit
  have hPK_prime : Prime P_K :=
    UniqueFactorizationMonoid.irreducible_iff_prime.mp hPK_irred
  have hJK_prime : J_K.IsPrime := by
    rw [← hPK_span]
    exact (Ideal.span_singleton_prime hPK_monic.ne_zero).mpr hPK_prime
  let ev_θ : Polynomial K₀ →+* ↥L_θ := ev.rangeRestrict.toRingHom
  have hker_evθ : RingHom.ker ev_θ = J_K := by
    ext Q
    simp only [RingHom.mem_ker, Subtype.ext_iff]
    rfl
  have : (RingHom.ker ev_θ).IsPrime := by
    rw [hker_evθ]
    exact hJK_prime
  have : IsDomain (Polynomial K₀ ⧸ RingHom.ker ev_θ) :=
    (Ideal.Quotient.isDomain_iff_prime (RingHom.ker ev_θ)).mpr inferInstance
  let e_quot : (Polynomial K₀ ⧸ RingHom.ker ev_θ) ≃+* ↥L_θ :=
    RingHom.quotientKerEquivOfSurjective ev.rangeRestrict_surjective
  have : IsDomain ↥L_θ :=
    Function.Injective.isDomain e_quot.symm.toRingHom e_quot.symm.injective
  let ι_θ : C_q →+* ↥L_θ :=
    { toFun := fun z => ⟨ι z, hι_mem z⟩
      map_one' := Subtype.ext ι.map_one
      map_mul' := fun x y => Subtype.ext (ι.map_mul x y)
      map_zero' := Subtype.ext ι.map_zero
      map_add' := fun x y => Subtype.ext (ι.map_add x y) }
  have hι_θ_inj : Function.Injective ι_θ :=
    fun z₁ z₂ h => hι_inj (congrArg Subtype.val h)
  exact Function.Injective.isDomain ι_θ hι_θ_inj

theorem weil_etale_quotient_zmt_witness_of_not_mem_special_prime (K : Type u) [Field K]
    (R : ValuationSubring K)
    (B : Type u) [CommRing B]
    (ψ : Polynomial ↥R →+* B)
    (hψ : ψ.Etale)
    (h𝔔 : (Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R)).IsPrime)
    (hStalkDom : ∀ (Q : Ideal ↥R) [Q.IsPrime],
      let C_Q := B ⧸ Ideal.map (ψ.comp Polynomial.C) Q
      ∀ (q : Ideal C_Q) [q.IsPrime], IsDomain (Localization.AtPrime q))
    (𝔪 : Ideal B) (h𝔪 : 𝔪.IsPrime)
    (h𝔔_le : Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R) ≤ 𝔪)
    (s : B) (hs_mem : s ∈ 𝔪)
    (hs_not_𝔔 : s ∉ Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R)) :
    ∃ (r_B : B) (m_X : ℕ) (f_r P_rx : Polynomial ↥R),
      r_B ∉ 𝔪 ∧
      f_r.Monic ∧
      P_rx.Monic ∧
      Polynomial.eval₂ (ψ.comp Polynomial.C) r_B f_r ∈ Ideal.span {s} ∧
      Polynomial.eval₂ (ψ.comp Polynomial.C) (r_B ^ m_X * ψ Polynomial.X) P_rx ∈ Ideal.span {s} :=
by
  let φ_R : ↥R →+* B := ψ.comp Polynomial.C
  let 𝔔 : Ideal B := Ideal.map φ_R (IsLocalRing.maximalIdeal ↥R)
  let I_s : Ideal B := Ideal.span {s}
  let D_s := B ⧸ I_s
  let mk_s : B →+* D_s := Ideal.Quotient.mk I_s
  letI : Algebra ↥R B := φ_R.toAlgebra
  letI : Algebra (Polynomial ↥R) B := ψ.toAlgebra
  haveI : IsScalarTower ↥R (Polynomial ↥R) B := ⟨fun r p b => by
    rw [Polynomial.smul_eq_C_mul, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
      map_mul, mul_assoc]
    rfl⟩
  haveI : 𝔪.IsPrime := h𝔪
  have hIs_le : I_s ≤ 𝔪 := (Ideal.span_singleton_le_iff_mem 𝔪).mpr hs_mem
  let 𝔮_s : Ideal D_s := Ideal.map mk_s 𝔪
  haveI : 𝔮_s.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hIs_le
  have h𝔮_mem : ∀ u : B, mk_s u ∈ 𝔮_s ↔ u ∈ 𝔪 := by
    intro u
    refine ⟨fun hu => ?_, fun hu => Ideal.mem_map_of_mem mk_s hu⟩
    have hcomap : u ∈ Ideal.comap mk_s (Ideal.map mk_s 𝔪) := hu
    rw [Ideal.comap_map_of_surjective mk_s Ideal.Quotient.mk_surjective 𝔪] at hcomap
    have hker : Ideal.comap mk_s ⊥ = I_s := by
      rw [← RingHom.ker_eq_comap_bot]
      exact Ideal.mk_ker
    rw [hker, sup_eq_left.mpr hIs_le] at hcomap
    exact hcomap
  haveI : Algebra.Etale (Polynomial ↥R) B := RingHom.etale_algebraMap.mp hψ
  haveI : Algebra.FiniteType ↥R B :=
    @Algebra.FiniteType.trans ↥R (Polynomial ↥R) B _ _ _ _ _ _ _ inferInstance inferInstance
  haveI : Algebra.FiniteType ↥R D_s :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ↥R I_s) Ideal.Quotient.mk_surjective
  haveI : Algebra.QuasiFiniteAt ↥R 𝔮_s := by
    change Algebra.QuasiFinite ↥R (Localization.AtPrime 𝔮_s)
    refine Algebra.QuasiFinite.mk (fun Q hQ_prime => ?_)
    haveI : Q.IsPrime := hQ_prime
    have hQ_le_max : Q ≤ IsLocalRing.maximalIdeal ↥R :=
      IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top hQ_prime)
    let I_Q : Ideal B := Ideal.map φ_R Q
    let C_Q := B ⧸ I_Q
    let mk_CQ : B →+* C_Q := Ideal.Quotient.mk I_Q
    have hIQ_le_𝔔 : I_Q ≤ 𝔔 := Ideal.map_mono hQ_le_max
    have hIQ_le_𝔪 : I_Q ≤ 𝔪 := hIQ_le_𝔔.trans h𝔔_le
    let 𝔪_Q : Ideal C_Q := Ideal.map mk_CQ 𝔪
    haveI : 𝔪_Q.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hIQ_le_𝔪
    have h𝔪Q_mem : ∀ u : B, mk_CQ u ∈ 𝔪_Q ↔ u ∈ 𝔪 := by
      intro u
      refine ⟨fun hu => ?_, fun hu => Ideal.mem_map_of_mem mk_CQ hu⟩
      have hcomap : u ∈ Ideal.comap mk_CQ (Ideal.map mk_CQ 𝔪) := hu
      rw [Ideal.comap_map_of_surjective mk_CQ Ideal.Quotient.mk_surjective 𝔪] at hcomap
      have hker : Ideal.comap mk_CQ ⊥ = I_Q := by
        rw [← RingHom.ker_eq_comap_bot]
        exact Ideal.mk_ker
      rw [hker, sup_eq_left.mpr hIQ_le_𝔪] at hcomap
      exact hcomap
    let C_loc := Localization.AtPrime 𝔪_Q
    haveI : IsDomain C_loc := hStalkDom Q 𝔪_Q
    let s_Q : C_loc := algebraMap C_Q C_loc (mk_CQ s)
    have hsQ_ne : s_Q ≠ 0 := by
      intro hsQ0
      obtain ⟨⟨c, hc_not_𝔪Q⟩, hc_mul⟩ :=
        (IsLocalization.map_eq_zero_iff 𝔪_Q.primeCompl C_loc (mk_CQ s)).mp hsQ0
      obtain ⟨u₀, rfl⟩ := Ideal.Quotient.mk_surjective c
      have hu₀_not_𝔪 : u₀ ∉ 𝔪 := fun hm => hc_not_𝔪Q ((h𝔪Q_mem u₀).mpr hm)
      have hu₀_not_𝔔 : u₀ ∉ 𝔔 := fun hq => hu₀_not_𝔪 (h𝔔_le hq)
      have hus_IQ : u₀ * s ∈ I_Q := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change mk_CQ (u₀ * s) = 0
        rw [map_mul]
        exact hc_mul
      rcases h𝔔.mem_or_mem (hIQ_le_𝔔 hus_IQ) with hu₀_𝔔 | hs_𝔔
      · exact hu₀_not_𝔔 hu₀_𝔔
      · exact hs_not_𝔔 hs_𝔔
    let L_Q := Q.ResidueField
    let π_poly : Polynomial ↥R →+* Polynomial L_Q :=
      Polynomial.mapRingHom (algebraMap ↥R L_Q)
    letI : Algebra (Polynomial ↥R) (Polynomial L_Q) := π_poly.toAlgebra
    let F_Q := TensorProduct (Polynomial ↥R) (Polynomial L_Q) B
    haveI : Algebra.Etale (Polynomial L_Q) F_Q :=
      Algebra.Etale.baseChange (Polynomial ↥R) B (Polynomial L_Q)
    haveI : IsNoetherianRing F_Q :=
      Algebra.FiniteType.isNoetherianRing (Polynomial L_Q) F_Q
    let inc_B : B →+* F_Q :=
      (Algebra.TensorProduct.includeRight : B →ₐ[Polynomial ↥R] F_Q).toRingHom
    let S_𝔪 : Submonoid F_Q := Submonoid.map inc_B.toMonoidHom 𝔪.primeCompl
    let E_loc := Localization S_𝔪
    let s_E : E_loc := algebraMap F_Q E_loc (inc_B s)
    let D_loc := Localization.AtPrime 𝔮_s
    let T_fib := Q.Fiber D_loc
    let ι_L : L_Q →+* T_fib := algebraMap L_Q T_fib
    let inc_Dloc : D_loc →+* T_fib :=
      (Algebra.TensorProduct.includeRight : D_loc →ₐ[↥R] T_fib).toRingHom
    let β_B : B →+* T_fib := inc_Dloc.comp ((algebraMap D_s D_loc).comp mk_s)
    let α_poly : Polynomial L_Q →+* T_fib :=
      Polynomial.eval₂RingHom ι_L (β_B (ψ Polynomial.X))
    have hα_comp : α_poly.comp π_poly = β_B.comp ψ := by
      apply Polynomial.ringHom_ext'
      · ext r
        dsimp only [α_poly, π_poly, β_B, inc_Dloc, ι_L]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change (algebraMap ↥R L_Q r) ⊗ₜ[↥R] (1 : D_loc) =
