    let κ_W' := m_W'.ResidueField
    let ρ_W' : ↥W₀ →+* ↥W' := (φ_LF.comp W₀.subtype).codRestrict W'.toSubring hW₀_W'
    let h_comap' : IsLocalRing.maximalIdeal ↥W₀ = Ideal.comap ρ_W' m_W' :=
      Ideal.ext fun r => (hm_W' r).symm
    let f_res' : k₀ →+* κ_W' :=
      Ideal.ResidueField.map (IsLocalRing.maximalIdeal ↥W₀) m_W' ρ_W' h_comap'
    let ρ_bar' : k₀ →+* K' := e_W'.toRingHom.comp f_res'
    have hChoice :
        ∃ (a : Fin 2) (v_W' : Fin 2 → ↥W') (v₀ : Fin 2 → k₀),
          v_W' a = 1 ∧
          v₀ a = 1 ∧
          ((a = 0 ∧ W'.subtype (v_W' 1) = u_Z) ∨
            (a = 1 ∧ W'.subtype (v_W' 0) = u_Z⁻¹)) ∧
          ∀ b : Fin 2, e_W' (algebraMap ↥W' κ_W' (v_W' b)) = ρ_bar' (v₀ b) := by
      rcases hDic with hu_not | ⟨hu_W', c₀, hc₀_mem⟩
      · have hu_inv : u_Z⁻¹ ∈ W' :=
          (ValuationSubring.mem_or_inv_mem W' u_Z).resolve_left hu_not
        let w_inv : ↥W' := ⟨u_Z⁻¹, hu_inv⟩
        have hw_nonunit : ¬ IsUnit w_inv := by
          intro hunit
          obtain ⟨y, hy⟩ := hunit.exists_right_inv
          have hval : u_Z⁻¹ * y.1 = 1 := congrArg Subtype.val hy
          have hy_eq : y.1 = u_Z := by
            calc
              y.1 = u_Z * (u_Z⁻¹ * y.1) := by rw [← mul_assoc, mul_inv_cancel₀ hu_ne, one_mul]
              _ = u_Z := by rw [hval, mul_one]
          exact hu_not (hy_eq ▸ y.2)
        have hw_max : w_inv ∈ m_W' := (IsLocalRing.mem_maximalIdeal w_inv).mpr hw_nonunit
        have hw_res0 : algebraMap ↥W' κ_W' w_inv = 0 := by
          rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField m_W']
          exact hw_max
        refine ⟨1, ![w_inv, 1], ![0, 1], rfl, rfl, Or.inr ⟨rfl, rfl⟩, ?_⟩
        intro b
        fin_cases b
        · simp [hw_res0]
        · simp
      · have hc₀_res :
            algebraMap ↥W' κ_W' ⟨u_Z, hu_W'⟩ = f_res' (algebraMap ↥W₀ k₀ c₀) := by
          have hdiff0 : algebraMap ↥W' κ_W' (⟨u_Z, hu_W'⟩ - ρ_W' c₀) = 0 := by
            rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField m_W']
            exact hc₀_mem
          rw [map_sub, sub_eq_zero] at hdiff0
          rw [hdiff0]
          dsimp only [f_res']
          exact (Ideal.ResidueField.map_algebraMap _ _ _ _ c₀).symm
        refine ⟨0, ![1, ⟨u_Z, hu_W'⟩], ![1, algebraMap ↥W₀ k₀ c₀], rfl, rfl,
          Or.inl ⟨rfl, rfl⟩, ?_⟩
        intro b
        fin_cases b
        · simp
        · simp [ρ_bar', hc₀_res]
    obtain ⟨a, v_W', v₀, hv_W'_a, hv₀_a, hv_or', hv_compat⟩ := hChoice
    obtain ⟨ψ₀, hψ₀_c, hψ₀_t⟩ :=
      (hCoord k₀ 1).2.2.2.2.2.2.1 a k₀ (RingHom.id k₀) v₀ hv₀_a
    let σ_star : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ P_k0 :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ (hAff k₀ 1 a).fromSpec
    have hσ_sec : σ_star ≫ g_Pk0 = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) := by
      dsimp only [σ_star]
      rw [CategoryTheory.Category.assoc, ← (hCoord k₀ 1).2.2.1 a,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ₀_c,
        CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    obtain ⟨χ_bar', hχ'_c, hχ'_t, hη'_Φ, hη'_snd⟩ :=
      hEvalCenter Z'_sch ιZ' K' η' W' hW₀_W' hm_W' U' hU' φ_U' hB_W' e_W'
        hφ_U' hComm' a v_W' hv_W'_a hv_or'
    have hχ'_eq : χ_bar' = ρ_bar'.comp ψ₀ := by
      let Γ_a := ↑(P_k0.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a)))
      have hsub_gen :
          Set.range (c_proj k₀ 1 a) ∪ Set.range (t_proj k₀ 1 a) ⊆
            (RingHom.eqLocus χ_bar' (ρ_bar'.comp ψ₀) : Set Γ_a) := by
        rintro _ (⟨c, rfl⟩ | ⟨b, rfl⟩)
        · change χ_bar' (c_proj k₀ 1 a c) = ρ_bar' (ψ₀ (c_proj k₀ 1 a c))
          have hc1 : χ_bar' (c_proj k₀ 1 a c) = ρ_bar' c :=
            RingHom.congr_fun hχ'_c c
          have hc2 : ψ₀ (c_proj k₀ 1 a c) = c :=
            RingHom.congr_fun hψ₀_c c
          rw [hc1, hc2]
        · change χ_bar' (t_proj k₀ 1 a b) = ρ_bar' (ψ₀ (t_proj k₀ 1 a b))
          rw [hχ'_t b, hψ₀_t b]
          exact hv_compat b
      have htop : (⊤ : Subring Γ_a) ≤ RingHom.eqLocus χ_bar' (ρ_bar'.comp ψ₀) := by
        rw [← (hCoord k₀ 1).2.2.2.2.2.1 a]
        exact Subring.closure_le.mpr hsub_gen
      ext x
      exact htop trivial
    have h_gen : η' ≫ (ιZ' ≫ Φ_bar) = η' ≫ (ιZ' ≫ snd₀ ≫ σ_star) := by
      calc
        η' ≫ (ιZ' ≫ Φ_bar)
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_bar') ≫
                (hAff k₀ 1 a).fromSpec := hη'_Φ
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar') ≫ σ_star := by
              dsimp only [σ_star]
              rw [hχ'_eq, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
                CategoryTheory.Category.assoc]
        _ = (η' ≫ ιZ' ≫ snd₀) ≫ σ_star := by rw [hη'_snd]
        _ = η' ≫ (ιZ' ≫ snd₀ ≫ σ_star) := by simp only [CategoryTheory.Category.assoc]
    have h_base : (ιZ' ≫ Φ_bar) ≫ g_Pk0 = (ιZ' ≫ snd₀ ≫ σ_star) ≫ g_Pk0 := by
      simp only [CategoryTheory.Category.assoc, hΦ_bar_snd, hσ_sec,
        CategoryTheory.Category.comp_id]
    have h_const_hom : ιZ' ≫ Φ_bar = ιZ' ≫ snd₀ ≫ σ_star :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_Pk0 h_base η' h_gen
    let pt_k0 : PrimeSpectrum k₀ := ⊥
    refine ⟨σ_star.base pt_k0, fun q hq => ?_⟩
    rw [← hRange'] at hq
    obtain ⟨w, rfl⟩ := hq
    change (ιZ' ≫ Φ_bar).base w = σ_star.base pt_k0
    rw [h_const_hom]
    have hpt_eq : (ιZ' ≫ snd₀).base w = pt_k0 := Subsingleton.elim _ _
    change σ_star.base ((ιZ' ≫ snd₀).base w) = σ_star.base pt_k0
    rw [hpt_eq]

  exact ⟨Φ_bar, hΦ_bar_snd, hInt_Pk0, hNorm_Pk0, hProp_fZ,
    ⟨K_Z, instKZ, η_Z, hDom_Z, hFunc_Z, hFunc_Pk0, hLocQF_Z⟩, hCollapse⟩

theorem weil_rankOne_p1_generic_coord_retraction_and_component_iso (L : Type u) [Field L] [IsAlgClosed L]
    (W₀ : ValuationSubring L)
    (hMax : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1 : ∀ P : PrimeSpectrum ↥W₀,
      P.asIdeal = ⊥ ∨ P.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀))
    (hSS_ℰ : IsStrictlySemistableCurveOverValuation W₀ g_ℰ)
    (hProp_ℰ : AlgebraicGeometry.IsProper g_ℰ)
    (hNorm_ℰ : IsAffineNormalScheme ℰ)
    (hOpen_η : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)))
    (F : Type u) [Field F]
    (η_ℰ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ ℰ)
    (hFunc_ℰ : IsSchemeFunctionField ℰ F η_ℰ)
    (hGenP1 : ∃ isoGen : CategoryTheory.Limits.pullback g_ℰ
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ≅
          (weilProjectiveSpaceOver L 1).left,
      CategoryTheory.Limits.pullback.snd g_ℰ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) =
        isoGen.hom ≫ (weilProjectiveSpaceOver L 1).hom) :
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
    ∃ (φ_LF : L →+* F) (t : F),
      η_ℰ ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_LF.comp W₀.subtype)) ∧
      (∀ P : Polynomial L, P ≠ 0 → Polynomial.eval₂ φ_LF t P ≠ 0) ∧
      (∀ f : F, ∃ P Q : Polynomial L, Q ≠ 0 ∧
        f * Polynomial.eval₂ φ_LF t Q = Polynomial.eval₂ φ_LF t P) ∧
      (∀ (Z : Set ↥T₀) (Z_sch : AlgebraicGeometry.Scheme.{u}) (ιZ : Z_sch ⟶ T₀)
          (W_Z : ValuationSubring F) (α_Z π_Z : L),
        IsRankOneGaussLinearVal W₀ φ_LF t W_Z α_Z π_Z →
        IsRankOneComponentStalkCenter W₀ g_ℰ η_ℰ Z Z_sch ιZ W_Z →
        ∃ (Φ_bar : T₀ ⟶ (weilProjectiveSpaceOver k₀ 1).left)
          (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left),
          Φ_bar ≫ (weilProjectiveSpaceOver k₀ 1).hom =
            CategoryTheory.Limits.pullback.snd g_ℰ s₀ ∧
          isoP1.hom = ιZ ≫ Φ_bar ∧
          (∀ (Z' : Set ↥T₀) (Z'_sch : AlgebraicGeometry.Scheme.{u}) (ιZ' : Z'_sch ⟶ T₀)
              (W' : ValuationSubring F)
              (hW₀_W' : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W'),
            IsRankOneComponentStalkCenter W₀ g_ℰ η_ℰ Z' Z'_sch ιZ' W' →
            (∀ r : ↥W₀,
              (⟨φ_LF (W₀.subtype r), hW₀_W' r⟩ : ↥W') ∈ IsLocalRing.maximalIdeal ↥W' ↔
                r ∈ IsLocalRing.maximalIdeal ↥W₀) →
            ((t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∉ W' ∨
              ∃ (hu_W' : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W') (c₀ : ↥W₀),
                (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu_W'⟩ : ↥W') -
                  ⟨φ_LF (W₀.subtype c₀), hW₀_W' c₀⟩ ∈ IsLocalRing.maximalIdeal ↥W') →
            ∃ p_star : ↥(weilProjectiveSpaceOver k₀ 1).left,
              ∀ q ∈ Z', Φ_bar.base q = p_star)) :=
by
  intro k₀ s₀ T₀
  obtain ⟨hAff, c_proj, t_proj, hCoord, hBase⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg
  obtain ⟨φ_LF, t, hη_g, ht_tr, ht_gen, hGenFibFrac⟩ :=
    weil_p1_generic_coord_and_genFiber_prime_dichotomy L W₀ ℰ g_ℰ hSS_ℰ.1 hOpen_η
      F η_ℰ hFunc_ℰ hGenP1 (hAff L 1) (c_proj L 1) (t_proj L 1) (hCoord L 1)
  refine ⟨φ_LF, t, hη_g, ht_tr, ht_gen, ?_⟩
  intro Z Z_sch ιZ W_Z α_Z π_Z hGauss_Z hCenter_Z
  let u_Z : F := (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹
  obtain ⟨_hW₀_WZ, hu_WZ, hu_unit, _hm_WZ, _hPoly_WZ, _hRes_WZ⟩ := hGauss_Z.2.2
  obtain ⟨w_inv, hw_inv⟩ := hu_unit.exists_right_inv
  have hval_inv : u_Z * w_inv.1 = 1 := congrArg Subtype.val hw_inv
  have hu_ne : u_Z ≠ 0 := fun h0 => zero_ne_one (by rw [← hval_inv, h0, zero_mul])
  have hw_eq : w_inv.1 = u_Z⁻¹ := by
    calc
      w_inv.1 = u_Z⁻¹ * (u_Z * w_inv.1) := by rw [← mul_assoc, inv_mul_cancel₀ hu_ne, one_mul]
      _ = u_Z⁻¹ := by rw [hval_inv, mul_one]
  have hu_inv_WZ : u_Z⁻¹ ∈ W_Z := hw_eq ▸ w_inv.2
  obtain ⟨Γ_Z, p_1, p_2, η_Γ, hInt_Γ, hDom_Γ, hFunc_Γ, hProp_p1, hp_comm, hη_p1,
      hChartCov, hValEval⟩ :=
    weil_projLine_graph_closure_and_val_center_eval ↥W₀ ℰ g_ℰ hSS_ℰ.1 F η_ℰ hFunc_ℰ
      (φ_LF.comp W₀.subtype) hη_g u_Z hu_ne (hAff ↥W₀ 1) (c_proj ↥W₀ 1) (t_proj ↥W₀ 1)
      (hCoord ↥W₀ 1)
  have hLocQF : ∀ z : Γ_Z,
      ∃ (U_X : ℰ.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : Γ_Z.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map p_1.base).obj U_X),
        z ∈ V_C ∧
        (p_1.appLE U_X V_C e_X).hom.FiniteType ∧
        (p_1.appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    obtain ⟨_a, U_X, hUX, V_C, hVC, e_X, φ_X, φ_C, y_a,
        hz_VC, hφ_X, _hφ_C, hInj_C, hφ_comp, hFT, hGen, hya_val⟩ := hChartCov z
    refine ⟨U_X, hUX, V_C, hVC, e_X, hz_VC, hFT, ?_⟩
    let B_X := ↑(ℰ.presheaf.obj (Opposite.op U_X))
    let B_C := ↑(Γ_Z.presheaf.obj (Opposite.op V_C))
    let α : B_X →+* B_C := (p_1.appLE U_X V_C e_X).hom
    have hVC_ne : Nonempty ↥V_C := ⟨⟨z, hz_VC⟩⟩
    haveI : IsDomain B_C :=
      @AlgebraicGeometry.IsIntegral.component_integral Γ_Z hInt_Γ V_C hVC_ne
    letI : Algebra B_X B_C := α.toAlgebra
    haveI : Algebra.FiniteType B_X B_C := hFT
    change Algebra.QuasiFinite B_X B_C
    rw [Algebra.QuasiFinite.iff_finite_primesOver]
    intro p hp
    haveI : p.IsPrime := hp
    let γ_X : ↥W₀ →+* B_X := (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_ℰ)).hom
    have hCompat : ∀ r : ↥W₀, φ_X.hom (γ_X r) = φ_LF (W₀.subtype r) := by
      have hSpec :
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_ℰ) ≫ φ_X) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_LF.comp W₀.subtype)) := by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          ← CategoryTheory.Category.assoc, hφ_X, hη_g]
      have hHom := congrArg AlgebraicGeometry.Spec.preimage hSpec
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hHom
      intro r
      exact congrArg (fun f : CommRingCat.of ↥W₀ ⟶ CommRingCat.of F => f.hom r) hHom
    have hya_or : φ_C.hom y_a = u_Z ∨ φ_C.hom y_a = u_Z⁻¹ :=
      hya_val.imp (fun h => h.2) (fun h => h.2)
    have hya_ne : φ_C.hom y_a ≠ 0 := by
      rcases hya_or with h | h <;> rw [h]
      · exact hu_ne
      · exact inv_ne_zero hu_ne
    have hya_WZ : φ_C.hom y_a ∈ W_Z := by
      rcases hya_or with h | h <;> rw [h]
      · exact hu_WZ
      · exact hu_inv_WZ
    have hSandwich :=
      weil_gauss_linear_val_fiber_quasiFinite_sandwich L W₀ hMax F φ_LF t ht_tr ht_gen
        W_Z α_Z π_Z hGauss_Z B_X B_C α γ_X φ_X.hom φ_C.hom y_a p
        hFT hInj_C hφ_comp hCompat hGen
    rcases hRank1 ⟨Ideal.comap γ_X p, Ideal.IsPrime.comap γ_X⟩ with hbot | hmax
    · exact hSandwich.1 (hGenFibFrac U_X hUX φ_X p hφ_X hbot (φ_C.hom y_a) hya_ne)
    · by_contra hInf
      obtain ⟨ρ_X, hρ_X_sub, hρ_X_comap⟩ := hSandwich.2 hmax hya_or hInf
      obtain ⟨_hCl_Z, _hInt_Z, _hRange_Z, K_Z, _instKZ, η_Z, pt_Z, U_Z, hUZ, hη_mem,
          φ_UZ, hB_WZ, _e_W, _hDom_Z, _hFunc_Z, hφ_UZ, hLoc_WZ, hPrime_WZ, _hComm_Z⟩ :=
        hCenter_Z
      let j_WZ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥W_Z) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_Z.subtype)
      haveI : AlgebraicGeometry.IsDominant j_WZ := by
        constructor
        have hbot_mem : (⊥ : PrimeSpectrum ↥W_Z) ∈ Set.range j_WZ.base := by
          refine ⟨(⊥ : PrimeSpectrum F), ?_⟩
          apply PrimeSpectrum.ext
          change Ideal.comap W_Z.subtype ⊥ = ⊥
          ext x_w
          rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
          exact map_eq_zero_iff W_Z.subtype Subtype.val_injective
        have hcl : closure ({(⊥ : PrimeSpectrum ↥W_Z)} : Set (PrimeSpectrum ↥W_Z)) ⊆
            closure (Set.range j_WZ.base) :=
          closure_mono (Set.singleton_subset_iff.mpr hbot_mem)
        intro q_w
        apply hcl
        rw [PrimeSpectrum.closure_singleton]
        change (⊥ : Ideal ↥W_Z) ≤ q_w.asIdeal
        exact bot_le
      let ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W_Z) ⟶ ℰ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_X) ≫ hUX.fromSpec
      let ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W_Z) ⟶ ℰ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_UZ.hom.codRestrict W_Z.toSubring hB_WZ)) ≫
          hUZ.fromSpec
      have hjψ_X : j_WZ ≫ ψ_X = η_ℰ := by
        dsimp only [j_WZ, ψ_X]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hρ_X_sub]
        exact hφ_X
      have hjψ_Z : j_WZ ≫ ψ_Z = η_ℰ := by
        dsimp only [j_WZ, ψ_Z]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        have heq_sub : W_Z.subtype.comp (φ_UZ.hom.codRestrict W_Z.toSubring hB_WZ) = φ_UZ.hom :=
          RingHom.ext (fun _ => rfl)
        rw [heq_sub]
        exact hφ_UZ
      have hg_eq : ψ_X ≫ g_ℰ = ψ_Z ≫ g_ℰ := by
        rw [← AlgebraicGeometry.Spec.map_preimage (ψ_X ≫ g_ℰ),
          ← AlgebraicGeometry.Spec.map_preimage (ψ_Z ≫ g_ℰ)]
        congr 1
        have hpre : W_Z.subtype.comp (AlgebraicGeometry.Spec.preimage (ψ_X ≫ g_ℰ)).hom =
            W_Z.subtype.comp (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_ℰ)).hom := by
          have h1 : AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (W_Z.subtype.comp (AlgebraicGeometry.Spec.preimage (ψ_X ≫ g_ℰ)).hom)) =
              j_WZ ≫ (ψ_X ≫ g_ℰ) := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
          have h2 : AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (W_Z.subtype.comp (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_ℰ)).hom)) =
              j_WZ ≫ (ψ_Z ≫ g_ℰ) := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
          have heq_map : j_WZ ≫ (ψ_X ≫ g_ℰ) = j_WZ ≫ (ψ_Z ≫ g_ℰ) := by
            rw [← CategoryTheory.Category.assoc, hjψ_X, ← CategoryTheory.Category.assoc, hjψ_Z]
          rw [← h1, ← h2] at heq_map
          exact congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective heq_map)
        apply CommRingCat.hom_ext
        ext r_w
        exact RingHom.congr_fun hpre r_w
      haveI : AlgebraicGeometry.IsSeparated g_ℰ := hSS_ℰ.2.2.1
      have hψ_eq : ψ_X = ψ_Z :=
        AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_ℰ hg_eq j_WZ (hjψ_X.trans hjψ_Z.symm)
      let mWZ_pt : PrimeSpectrum ↥W_Z :=
        ⟨IsLocalRing.maximalIdeal ↥W_Z, (IsLocalRing.maximalIdeal.isMaximal ↥W_Z).isPrime⟩
      have hm_eq : ψ_X.base mWZ_pt = ψ_Z.base mWZ_pt :=
        congrArg (fun f => f.base mWZ_pt) hψ_eq
      let p_pt : PrimeSpectrum B_X := ⟨p, hp⟩
      let q_UZ := hUZ.primeIdealOf
        ⟨(CategoryTheory.Limits.pullback.fst g_ℰ s₀).base (ιZ.base (η_Z.base pt_Z)), hη_mem⟩
      have hmap_ρX :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_X)).base mWZ_pt = p_pt := by
        rw [AlgebraicGeometry.Spec.map_base]
        exact PrimeSpectrum.ext hρ_X_comap
      have hmap_UZ :
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ_UZ.hom.codRestrict W_Z.toSubring hB_WZ))).base mWZ_pt = q_UZ := by
        rw [AlgebraicGeometry.Spec.map_base]
        apply PrimeSpectrum.ext
        ext b
        exact hPrime_WZ b
      let x : ℰ := hUX.fromSpec.base p_pt
      have hx_eq_Z : x = hUZ.fromSpec.base q_UZ := by
        have h1 : ψ_X.base mWZ_pt = x := by
          change hUX.fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_X)).base mWZ_pt) =
            hUX.fromSpec.base p_pt
          rw [hmap_ρX]
        have h2 : ψ_Z.base mWZ_pt = hUZ.fromSpec.base q_UZ := by
          change hUZ.fromSpec.base
            ((AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (φ_UZ.hom.codRestrict W_Z.toSubring hB_WZ))).base mWZ_pt) =
            hUZ.fromSpec.base q_UZ
          rw [hmap_UZ]
        exact h1.symm.trans (hm_eq.trans h2)
      have hx_UX : x ∈ U_X := by
        change x ∈ (U_X : Set ℰ)
        rw [← hUX.range_fromSpec]
        exact ⟨p_pt, rfl⟩
      have hx_UZ : x ∈ U_Z := by
        change x ∈ (U_Z : Set ℰ)
        rw [hx_eq_Z, ← hUZ.range_fromSpec]
        exact ⟨q_UZ, rfl⟩
      obtain ⟨r₀, hr₀_UZ, hx_r₀⟩ :=
        @AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le ℰ U_X hUX U_Z ⟨x, hx_UZ⟩ hx_UX
      have hr₀_not_p : r₀ ∉ p := by
        have hz_pre : p_pt ∈ hUX.fromSpec ⁻¹ᵁ ℰ.basicOpen r₀ := hx_r₀
        rw [hUX.fromSpec_preimage_basicOpen r₀] at hz_pre
        exact hz_pre
      let W_r₀ : ℰ.Opens := ℰ.basicOpen r₀
      have hWr₀ : AlgebraicGeometry.IsAffineOpen W_r₀ := hUX.basicOpen r₀
      have hWr₀_ne : Nonempty ↥W_r₀ := ⟨⟨x, hx_r₀⟩⟩
      let B_r₀ : Type u := ↑(ℰ.presheaf.obj (Opposite.op W_r₀))
      let res_X : B_X →+* B_r₀ :=
        (ℰ.presheaf.map (CategoryTheory.homOfLE (ℰ.basicOpen_le r₀)).op).hom
      let res_Z : ↑(ℰ.presheaf.obj (Opposite.op U_Z)) →+* B_r₀ :=
        (ℰ.presheaf.map (CategoryTheory.homOfLE hr₀_UZ).op).hom
      obtain ⟨φ_r₀, _hFrac_r₀, hφ_r₀⟩ := hFunc_ℰ W_r₀ hWr₀ hWr₀_ne
      have hφ_resX : ∀ c : B_X, φ_r₀.hom (res_X c) = φ_X.hom c := by
        have hSpec_eq : AlgebraicGeometry.Spec.map
            (ℰ.presheaf.map (CategoryTheory.homOfLE (ℰ.basicOpen_le r₀)).op ≫ φ_r₀) ≫
              hUX.fromSpec =
            AlgebraicGeometry.Spec.map φ_X ≫ hUX.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hUX.map_fromSpec hWr₀ (CategoryTheory.homOfLE (ℰ.basicOpen_le r₀)).op,
            hφ_r₀, hφ_X]
        have hMap_eq := (CategoryTheory.cancel_mono hUX.fromSpec).mp hSpec_eq
        have hHom_eq := congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective hMap_eq)
        intro c
        exact RingHom.congr_fun hHom_eq c
      have hφ_resZ : ∀ c : ↑(ℰ.presheaf.obj (Opposite.op U_Z)), φ_r₀.hom (res_Z c) = φ_UZ.hom c := by
        have hSpec_eq : AlgebraicGeometry.Spec.map
            (ℰ.presheaf.map (CategoryTheory.homOfLE hr₀_UZ).op ≫ φ_r₀) ≫ hUZ.fromSpec =
            AlgebraicGeometry.Spec.map φ_UZ ≫ hUZ.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hUZ.map_fromSpec hWr₀ (CategoryTheory.homOfLE hr₀_UZ).op,
            hφ_r₀, hφ_UZ]
        have hMap_eq := (CategoryTheory.cancel_mono hUZ.fromSpec).mp hSpec_eq
        have hHom_eq := congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective hMap_eq)
        intro c
        exact RingHom.congr_fun hHom_eq c
      have hx_Wr₀_range : x ∈ Set.range hWr₀.fromSpec.base := by
        rw [hWr₀.range_fromSpec]
        exact hx_r₀
      obtain ⟨q_r₀, hq_r₀⟩ := hx_Wr₀_range
      have hcomap_resX : Ideal.comap res_X q_r₀.asIdeal = p := by
        have hbase : hUX.fromSpec.base
            ((AlgebraicGeometry.Spec.map
              (ℰ.presheaf.map (CategoryTheory.homOfLE (ℰ.basicOpen_le r₀)).op)).base q_r₀) =
            hUX.fromSpec.base p_pt := by
          change (AlgebraicGeometry.Spec.map
            (ℰ.presheaf.map (CategoryTheory.homOfLE (ℰ.basicOpen_le r₀)).op) ≫
              hUX.fromSpec).base q_r₀ = x
          rw [hUX.map_fromSpec hWr₀ (CategoryTheory.homOfLE (ℰ.basicOpen_le r₀)).op]
          exact hq_r₀
        have hpt_eq := hUX.fromSpec.isOpenEmbedding.injective hbase
        rw [AlgebraicGeometry.Spec.map_base] at hpt_eq
        exact congrArg PrimeSpectrum.asIdeal hpt_eq
      have hcomap_resZ : Ideal.comap res_Z q_r₀.asIdeal = q_UZ.asIdeal := by
        have hbase : hUZ.fromSpec.base
            ((AlgebraicGeometry.Spec.map
              (ℰ.presheaf.map (CategoryTheory.homOfLE hr₀_UZ).op)).base q_r₀) =
            hUZ.fromSpec.base q_UZ := by
          change (AlgebraicGeometry.Spec.map
            (ℰ.presheaf.map (CategoryTheory.homOfLE hr₀_UZ).op) ≫
              hUZ.fromSpec).base q_r₀ = hUZ.fromSpec.base q_UZ
          rw [hUZ.map_fromSpec hWr₀ (CategoryTheory.homOfLE hr₀_UZ).op, hq_r₀, hx_eq_Z]
        have hpt_eq := hUZ.fromSpec.isOpenEmbedding.injective hbase
        rw [AlgebraicGeometry.Spec.map_base] at hpt_eq
        exact congrArg PrimeSpectrum.asIdeal hpt_eq
      obtain ⟨b_Z, s_Z, hs_Z, hbs_Z⟩ := (hLoc_WZ (φ_C.hom y_a)).mp hya_WZ
      have hresZ_s : res_Z s_Z ∉ q_r₀.asIdeal := by
        intro hm
        apply hs_Z
        rw [← hcomap_resZ]
        exact hm
      have hresX_r₀ : res_X r₀ ∉ q_r₀.asIdeal := by
        intro hm
        apply hr₀_not_p
        rw [← hcomap_resX]
        exact hm
      haveI : IsLocalization.Away r₀ B_r₀ := hUX.isLocalization_basicOpen r₀
      have hresX_alg : ∀ c : B_X, algebraMap B_X B_r₀ c = res_X c := fun _ => rfl
      obtain ⟨⟨a_s, pow_s⟩, ha_s⟩ := IsLocalization.surj (Submonoid.powers r₀) (res_Z s_Z)
      obtain ⟨k_s, hk_s⟩ := pow_s.2
      dsimp at hk_s
      have ha_s_eq : res_Z s_Z * res_X (r₀ ^ k_s) = res_X a_s := by
        have h1 : res_Z s_Z * algebraMap B_X B_r₀ pow_s.1 = algebraMap B_X B_r₀ a_s := ha_s
        rw [← hk_s, hresX_alg, hresX_alg] at h1
        exact h1
      obtain ⟨⟨a_b, pow_b⟩, ha_b⟩ := IsLocalization.surj (Submonoid.powers r₀) (res_Z b_Z)
      obtain ⟨k_b, hk_b⟩ := pow_b.2
      dsimp at hk_b
      have ha_b_eq : res_Z b_Z * res_X (r₀ ^ k_b) = res_X a_b := by
        have h1 : res_Z b_Z * algebraMap B_X B_r₀ pow_b.1 = algebraMap B_X B_r₀ a_b := ha_b
        rw [← hk_b, hresX_alg, hresX_alg] at h1
        exact h1
      have ha_s_not_p : a_s ∉ p := by
        intro ha_mem
        have hprod_mem : res_Z s_Z * res_X (r₀ ^ k_s) ∈ q_r₀.asIdeal := by
          rw [ha_s_eq]
          rw [← hcomap_resX] at ha_mem
          exact ha_mem
        rcases q_r₀.isPrime.mem_or_mem hprod_mem with h1 | h2
        · exact hresZ_s h1
        · rw [map_pow] at h2
          exact hresX_r₀ (q_r₀.isPrime.mem_of_pow_mem k_s h2)
      let s₀_X : B_X := a_s * r₀ ^ k_b
      let b₀_X : B_X := a_b * r₀ ^ k_s
      have hs₀_not_p : s₀_X ∉ p := by
        intro hm
        rcases hp.mem_or_mem hm with h1 | h2
        · exact ha_s_not_p h1
        · exact hr₀_not_p (hp.mem_of_pow_mem k_b h2)
      have hbs₀_eq : φ_X.hom s₀_X * φ_C.hom y_a = φ_X.hom b₀_X := by
        have hs_val : φ_X.hom a_s = φ_UZ.hom s_Z * φ_X.hom (r₀ ^ k_s) := by
          calc
            φ_X.hom a_s = φ_r₀.hom (res_X a_s) := (hφ_resX a_s).symm
            _ = φ_r₀.hom (res_Z s_Z * res_X (r₀ ^ k_s)) := by rw [← ha_s_eq]
            _ = φ_r₀.hom (res_Z s_Z) * φ_r₀.hom (res_X (r₀ ^ k_s)) := map_mul _ _ _
            _ = φ_UZ.hom s_Z * φ_X.hom (r₀ ^ k_s) := by
                  rw [hφ_resZ s_Z, hφ_resX (r₀ ^ k_s)]
        have hb_val : φ_X.hom a_b = φ_UZ.hom b_Z * φ_X.hom (r₀ ^ k_b) := by
          calc
            φ_X.hom a_b = φ_r₀.hom (res_X a_b) := (hφ_resX a_b).symm
            _ = φ_r₀.hom (res_Z b_Z * res_X (r₀ ^ k_b)) := by rw [← ha_b_eq]
            _ = φ_r₀.hom (res_Z b_Z) * φ_r₀.hom (res_X (r₀ ^ k_b)) := map_mul _ _ _
            _ = φ_UZ.hom b_Z * φ_X.hom (r₀ ^ k_b) := by
                  rw [hφ_resZ b_Z, hφ_resX (r₀ ^ k_b)]
        dsimp only [s₀_X, b₀_X]
        rw [map_mul, map_mul, hs_val, hb_val]
        calc
          (φ_UZ.hom s_Z * φ_X.hom (r₀ ^ k_s) * φ_X.hom (r₀ ^ k_b)) * φ_C.hom y_a
              = (φ_UZ.hom s_Z * φ_C.hom y_a) * φ_X.hom (r₀ ^ k_b) * φ_X.hom (r₀ ^ k_s) := by ring
          _ = φ_UZ.hom b_Z * φ_X.hom (r₀ ^ k_b) * φ_X.hom (r₀ ^ k_s) := by rw [hbs_Z]
      exact hInf (hSandwich.1 (Or.inl ⟨b₀_X, s₀_X, hs₀_not_p, hbs₀_eq⟩))
  haveI : CategoryTheory.IsIso p_1 :=
    weil_birational_proper_iso_of_locallyQuasiFinite_normal
      Γ_Z ℰ F p_1 η_Γ η_ℰ hInt_Γ hSS_ℰ.1 hNorm_ℰ hProp_p1 hDom_Γ hη_p1 hFunc_Γ hFunc_ℰ hLocQF
  let Φ_Z : ℰ ⟶ (weilProjectiveSpaceOver ↥W₀ 1).left := CategoryTheory.inv p_1 ≫ p_2
  have hΦ_Z_comm : Φ_Z ≫ (weilProjectiveSpaceOver ↥W₀ 1).hom = g_ℰ := by
    dsimp only [Φ_Z]
    rw [CategoryTheory.Category.assoc, ← hp_comm, CategoryTheory.IsIso.inv_hom_id_assoc]
  have hη_Φ_Z : η_ℰ ≫ Φ_Z = η_Γ ≫ p_2 := by
    dsimp only [Φ_Z]
    rw [← hη_p1, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc]
  obtain ⟨Φ_bar, hΦ_hom, hInt_Pk0, hNorm_Pk0, hProp_fZ,
      ⟨K_Z, instKZ, η_Z, hDom_Z, hFunc_Z, hFunc_Pk0, hLocQF_Z⟩, hCollapse⟩ :=
    weil_projLine_closedFiber_retraction_iso_and_collapse L W₀ ℰ g_ℰ hProp_ℰ F η_ℰ φ_LF t
      hAff c_proj t_proj hCoord hBase Z Z_sch ιZ W_Z α_Z π_Z hGauss_Z hCenter_Z
      Φ_Z hΦ_Z_comm (hValEval Φ_Z hΦ_Z_comm hη_Φ_Z)
  letI : Field K_Z := instKZ
  haveI : CategoryTheory.IsIso (ιZ ≫ Φ_bar) :=
    weil_birational_proper_iso_of_locallyQuasiFinite_normal
      Z_sch (weilProjectiveSpaceOver k₀ 1).left K_Z (ιZ ≫ Φ_bar) η_Z (η_Z ≫ ιZ ≫ Φ_bar)
      hCenter_Z.2.1 hInt_Pk0 hNorm_Pk0 hProp_fZ hDom_Z
      (CategoryTheory.Category.assoc η_Z ιZ Φ_bar).symm hFunc_Z hFunc_Pk0 hLocQF_Z
  exact ⟨Φ_bar, CategoryTheory.asIso (ιZ ≫ Φ_bar), hΦ_hom, rfl, hCollapse⟩

theorem weil_rankOne_algClosed_p1_semistable_model_is_tree (L : Type u) [Field L] [IsAlgClosed L]
    (W₀ : ValuationSubring L)
    (hMax : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1 : ∀ P : PrimeSpectrum ↥W₀,
      P.asIdeal = ⊥ ∨ P.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀))
    (hSS_ℰ : IsStrictlySemistableCurveOverValuation W₀ g_ℰ)
    (hProp_ℰ : AlgebraicGeometry.IsProper g_ℰ)
    (hGenP1 : ∃ isoGen : CategoryTheory.Limits.pullback g_ℰ
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ≅
          (weilProjectiveSpaceOver L 1).left,
      CategoryTheory.Limits.pullback.snd g_ℰ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) =
        isoGen.hom ≫ (weilProjectiveSpaceOver L 1).hom) :
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
    (irreducibleComponents ↥T₀).Nonempty ∧
    (irreducibleComponents ↥T₀).Finite ∧
    (∀ Z ∈ irreducibleComponents ↥T₀,
      ∃ (Z_sch : AlgebraicGeometry.Scheme.{u}) (ιZ : Z_sch ⟶ T₀)
          (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver k₀ 1).left),
        AlgebraicGeometry.IsClosedImmersion ιZ ∧
        AlgebraicGeometry.IsIntegral Z_sch ∧
        Set.range ιZ.base = Z ∧
        ιZ ≫ CategoryTheory.Limits.pullback.snd g_ℰ s₀ =
          isoP1.hom ≫ (weilProjectiveSpaceOver k₀ 1).hom) ∧
    (∀ (S_ext : Set ↥T₀),
      S_ext.Finite →
      S_ext.ncard ≤ 2 →
      (∀ q ∈ S_ext, ∀ Z₁ ∈ irreducibleComponents ↥T₀, ∀ Z₂ ∈ irreducibleComponents ↥T₀,
        q ∈ Z₁ → q ∈ Z₂ → Z₁ = Z₂) →
      ∃ Z ∈ irreducibleComponents ↥T₀,
        let Δ_int : Set ↥T₀ :=
          {q ∈ Z | ∃ Z' ∈ irreducibleComponents ↥T₀, Z' ≠ Z ∧ q ∈ Z'}
        Δ_int.Finite ∧
        Δ_int.ncard + (Z ∩ S_ext).ncard ≤ 2) :=
by
  intro k₀ s₀ T₀
  classical
  
  let m₀ : Ideal ↥W₀ := IsLocalRing.maximalIdeal ↥W₀
  have hm₀_max : m₀.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥W₀
  have hbij_quot : Function.Bijective (algebraMap (↥W₀ ⧸ m₀) k₀) :=
    Ideal.bijective_algebraMap_quotient_residueField m₀
  have hSurj_k₀ : Function.Surjective (algebraMap ↥W₀ k₀) := by
    have heq : algebraMap ↥W₀ k₀ = (algebraMap (↥W₀ ⧸ m₀) k₀).comp (Ideal.Quotient.mk m₀) :=
      IsScalarTower.algebraMap_eq ↥W₀ (↥W₀ ⧸ m₀) k₀
    rw [heq]
    exact hbij_quot.2.comp Ideal.Quotient.mk_surjective
  have hAlgK₀ : IsAlgClosed k₀ := by
    apply IsAlgClosed.of_exists_root
    intro pbar hp_monic hp_irred
    choose lift_fn hlift_fn using hSurj_k₀
    let d := pbar.natDegree
    have hd_pos : 0 < d := hp_irred.natDegree_pos
    let q_tail : Polynomial ↥W₀ :=
      ∑ i ∈ Finset.range d, Polynomial.C (lift_fn (pbar.coeff i)) * Polynomial.X ^ i
    have htail_coeff : ∀ j : ℕ, q_tail.coeff j = if j < d then lift_fn (pbar.coeff j) else 0 := by
      intro j
      simp only [q_tail, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_range]
    let p : Polynomial ↥W₀ := Polynomial.X ^ d + q_tail
    have hp_map : Polynomial.map (algebraMap ↥W₀ k₀) p = pbar := by
      ext j
      rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_X_pow, htail_coeff]
      by_cases hjd : j = d
      · subst hjd
        have hnot : ¬ (d < d) := lt_irrefl d
        simp only [ite_true, hnot, ite_false, add_zero, map_one]
        exact hp_monic.coeff_natDegree.symm
      · simp only [hjd, ite_false, zero_add]
        by_cases hjlt : j < d
        · simp only [hjlt, ite_true, hlift_fn]
        · simp only [hjlt, ite_false, map_zero]
          exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
    have htail_deg : q_tail.degree < (d : WithBot ℕ) := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [htail_coeff, ite_eq_right_iff]
      intro hlt
      omega
    have hp_monic_W : p.Monic := Polynomial.monic_X_pow_add htail_deg
    let pL : Polynomial L := Polynomial.map (algebraMap ↥W₀ L) p
    have hpL_deg : pL.degree ≠ 0 := by
      intro hdeg0
      have heqC := Polynomial.eq_C_of_degree_eq_zero hdeg0
      have hcoeff_d : pL.coeff d = 0 := by
        rw [heqC, Polynomial.coeff_C, ite_eq_right_iff]
        intro hd0
        omega
      rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_X_pow, htail_coeff] at hcoeff_d
      have hnot : ¬ (d < d) := lt_irrefl d
      simp only [ite_true, hnot, ite_false, add_zero, map_one, one_ne_zero] at hcoeff_d
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root pL hpL_deg
    have hα_int : _root_.IsIntegral ↥W₀ α := by
      refine ⟨p, hp_monic_W, ?_⟩
      rw [Polynomial.eval₂_eq_eval_map]
      exact hα.eq_zero
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp hα_int
    have hpr : Polynomial.eval r p = 0 := by
      apply Subtype.val_injective
      change (algebraMap ↥W₀ L) (Polynomial.eval r p) = (algebraMap ↥W₀ L) 0
      rw [map_zero, ← Polynomial.eval_map_apply (algebraMap ↥W₀ L)]
      change Polynomial.eval ((algebraMap ↥W₀ L) r) pL = 0
      rw [hr]
      exact hα.eq_zero
    refine ⟨algebraMap ↥W₀ k₀ r, ?_⟩
    rw [← hp_map, Polynomial.eval_map_apply, hpr, map_zero]
  
  have hex_pi : ∃ π₀ : ↥W₀, π₀ ∈ m₀ ∧ π₀ ≠ 0 := by
    by_contra! hall0
    apply hMax
    rw [eq_bot_iff]
    intro x hx
    rw [Ideal.mem_bot]
    exact hall0 x hx
  obtain ⟨π₀, hπ₀_mem, hπ₀_ne⟩ := hex_pi
  have hOpen_η : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) := by
    let _ : Algebra ↥W₀ L := W₀.subtype.toAlgebra
    have hLoc : IsLocalization.Away π₀ L := by
      refine IsLocalization.Away.mk π₀ ?_ ?_ ?_
      · exact IsUnit.mk0 (W₀.subtype π₀) (fun h => hπ₀_ne (Subtype.val_injective h))
      · intro z
        by_cases hzW : z ∈ W₀
        · exact ⟨0, ⟨z, hzW⟩, by simp; rfl⟩
        · have hz0 : z ≠ 0 := fun h => hzW (h ▸ W₀.zero_mem)
          have hz_inv : z⁻¹ ∈ W₀ := (ValuationSubring.mem_or_inv_mem W₀ z).resolve_left hzW
          let w : ↥W₀ := ⟨z⁻¹, hz_inv⟩
          have hw_ne : w ≠ 0 := fun h => inv_ne_zero hz0 (congrArg Subtype.val h)
          have hπ_rad : π₀ ∈ (Ideal.span ({w} : Set ↥W₀)).radical := by
            rw [Ideal.radical_eq_sInf]
            simp only [Ideal.mem_sInf, Set.mem_ofPred_eq, Ideal.span_singleton_le_iff_mem]
            rintro I ⟨hwI, hI_prime⟩
            have hI_ne : I ≠ ⊥ := by
              intro hbot
              rw [hbot, Ideal.mem_bot] at hwI
              exact hw_ne hwI
            rcases hRank1 ⟨I, hI_prime⟩ with hbot | hmax
            · exact (hI_ne hbot).elim
            · change π₀ ∈ (⟨I, hI_prime⟩ : PrimeSpectrum ↥W₀).asIdeal
              rw [hmax]
