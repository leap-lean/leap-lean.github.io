          exact (MvPolynomial.mem_support_iff.mp hm) hc0
        have hm_pos : 0 < m 0 ∨ 0 < m 1 := by
          by_contra h00
          rw [not_or, Nat.not_lt, Nat.le_zero, Nat.not_lt, Nat.le_zero] at h00
          apply hm_ne0
          ext i; fin_cases i <;> simp [h00.1, h00.2]
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_two]
        rcases hm_pos with hm0 | hm1
        · obtain ⟨k₀, hk₀⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hm0)
          rw [hk₀, pow_succ]
          exact p'.asHomogeneousIdeal.toIdeal.mul_mem_left _
            (p'.asHomogeneousIdeal.toIdeal.mul_mem_right _
              (p'.asHomogeneousIdeal.toIdeal.mul_mem_left _ h0))
        · obtain ⟨k₁, hk₁⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hm1)
          rw [hk₁, pow_succ]
          exact p'.asHomogeneousIdeal.toIdeal.mul_mem_left _
            (p'.asHomogeneousIdeal.toIdeal.mul_mem_left _
              (p'.asHomogeneousIdeal.toIdeal.mul_mem_left _ h1))
      have hOverlap_ne : ((AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥P_F) ∩
