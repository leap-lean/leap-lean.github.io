    have h_nodal_swap_iso : ∀ (a : ↥V),
        ∃ sw : (MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a) ≃+* (MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a),
          (∀ c : ↥V,
            sw (Ideal.Quotient.mk (s3NodalIdeal a) (MvPolynomial.C c)) =
              Ideal.Quotient.mk (s3NodalIdeal a) (MvPolynomial.C c)) ∧
          sw (Ideal.Quotient.mk (s3NodalIdeal a) (MvPolynomial.X 0)) =
            Ideal.Quotient.mk (s3NodalIdeal a) (MvPolynomial.X 1) := by
      intro a
      let qmk : MvPolynomial (Fin 2) ↥V →+* (MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a) := Ideal.Quotient.mk (s3NodalIdeal a)
      let sw_mv : MvPolynomial (Fin 2) ↥V →+* (MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a) :=
        qmk.comp (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1)).toRingHom
      have hker : s3NodalIdeal a ≤ RingHom.ker sw_mv := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change qmk ((MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1))
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a)) = 0
        simp only [map_sub, map_mul, MvPolynomial.rename_X, MvPolynomial.rename_C]
        have h01 : Equiv.swap (0 : Fin 2) 1 0 = 1 := Equiv.swap_apply_left 0 1
        have h10 : Equiv.swap (0 : Fin 2) 1 1 = 0 := Equiv.swap_apply_right 0 1
        rw [h01, h10, mul_comm (qmk (MvPolynomial.X 1)) (qmk (MvPolynomial.X 0)),
          ← map_mul, ← map_sub]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton _))
      let swNodal : (MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a) →+* (MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a) :=
        Ideal.Quotient.lift (s3NodalIdeal a) sw_mv (fun _ hf => RingHom.mem_ker.mp (hker hf))
      have hinv : swNodal.comp swNodal = RingHom.id ((MvPolynomial (Fin 2) ↥V ⧸ s3NodalIdeal a)) := by
        apply RingHom.ext
        intro x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        revert P
        suffices hMv : (swNodal.comp swNodal).comp qmk = qmk by
          intro P
          exact RingHom.congr_fun hMv P
        apply MvPolynomial.ringHom_ext
        · intro c
          simp [swNodal, sw_mv, qmk]
        · intro i
          simp [swNodal, sw_mv, qmk, Equiv.swap_apply_self]
