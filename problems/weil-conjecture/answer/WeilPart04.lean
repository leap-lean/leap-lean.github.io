        { toFun := swNodal
          invFun := swNodal
          left_inv := RingHom.congr_fun hinv
          right_inv := RingHom.congr_fun hinv
          map_mul' := map_mul swNodal
          map_add' := map_add swNodal }
      refine ⟨sw, ?_, ?_⟩
      · intro c
        change swNodal (qmk (MvPolynomial.C c)) = qmk (MvPolynomial.C c)
        simp [swNodal, sw_mv, qmk]
      · change swNodal (qmk (MvPolynomial.X 0)) = qmk (MvPolynomial.X 1)
        simp [swNodal, sw_mv, qmk]
