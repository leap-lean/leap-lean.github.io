      apply hInj_loc
      simpa only [f_RD, ψ_BD, γ_bar, RingHom.comp_apply, map_mul] using hφ_rel
    have hrel_A : C₀ s * t - C₀ c ∈ q_y := by
      change ψ₁ (C₀ s * t - C₀ c) ∈ y.asIdeal
      rw [map_sub, map_mul, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
      exact hBy_eq
    rcases ValuationRing.dvd_total s c with ⟨d, rfl⟩ | ⟨u, rfl⟩
    · refine ⟨d, ?_⟩
      have hprod : C₀ s * (t - C₀ d) ∈ q_y := by
        have heq : C₀ s * (t - C₀ d) = C₀ s * t - C₀ (s * d) := by
          rw [map_mul]
          ring
