      change f * φ_X.hom s₁.1 = φ_X.hom b₁ at hfs₁
      have hφX_s₁_ne : φ_X.hom s₁.1 ≠ 0 := (IsLocalization.map_units F s₁).ne_zero
      let α := (p_1.appLE U_X V_C e_X).hom
      let a' : R_Br := res_VC (α b₁)
      let s' : R_Br := res_VC (α s₁.1)
      have hφBr_a' : φ_Br.hom a' = φ_X.hom b₁ := by
        dsimp only [a']
        rw [hφ_resVC]
        exact RingHom.congr_fun hφ_comp b₁
      have hφBr_s' : φ_Br.hom s' = φ_X.hom s₁.1 := by
        dsimp only [s']
        rw [hφ_resVC]
        exact RingHom.congr_fun hφ_comp s₁.1
      have hLoc_r : IsLocalization.Away r R_Br := hV.isLocalization_basicOpen r
      obtain ⟨k, a₀, hk⟩ := @IsLocalization.Away.surj _ _ _ _ _ r hLoc_r a'
      obtain ⟨l, b₀, hl⟩ := @IsLocalization.Away.surj _ _ _ _ _ r hLoc_r s'
      have hk' : a' * res_V r ^ k = res_V a₀ := hk
      have hl' : s' * res_V r ^ l = res_V b₀ := hl
      have hφV_r_ne : φ_V.hom r ≠ 0 :=
        fun h0 => hr_ne (hInj_V (h0.trans (map_zero φ_V.hom).symm))
      have hφV_b₀ : φ_V.hom b₀ = φ_X.hom s₁.1 * φ_V.hom r ^ l := by
        calc
          φ_V.hom b₀ = φ_Br.hom (res_V b₀) := (hφ_resV b₀).symm
          _ = φ_Br.hom (s' * res_V r ^ l) := by rw [← hl']
          _ = φ_Br.hom s' * φ_Br.hom (res_V r) ^ l := by rw [map_mul, map_pow]
          _ = φ_X.hom s₁.1 * φ_V.hom r ^ l := by rw [hφBr_s', hφ_resV r]
      have hφV_a₀ : φ_V.hom a₀ = φ_X.hom b₁ * φ_V.hom r ^ k := by
        calc
          φ_V.hom a₀ = φ_Br.hom (res_V a₀) := (hφ_resV a₀).symm
          _ = φ_Br.hom (a' * res_V r ^ k) := by rw [← hk']
          _ = φ_Br.hom a' * φ_Br.hom (res_V r) ^ k := by rw [map_mul, map_pow]
          _ = φ_X.hom b₁ * φ_V.hom r ^ k := by rw [hφBr_a', hφ_resV r]
      have hb₀_ne : b₀ ≠ 0 := by
        intro hb0
        have h0 : φ_V.hom b₀ = 0 := by rw [hb0, map_zero]
        rw [hφV_b₀] at h0
        exact mul_ne_zero hφX_s₁_ne (pow_ne_zero l hφV_r_ne) h0
      have hden_ne : b₀ * r ^ k ≠ 0 := mul_ne_zero hb₀_ne (pow_ne_zero k hr_ne)
      refine ⟨⟨a₀ * r ^ l, ⟨b₀ * r ^ k, mem_nonZeroDivisors_of_ne_zero hden_ne⟩⟩, ?_⟩
      change f * φ_V.hom (b₀ * r ^ k) = φ_V.hom (a₀ * r ^ l)
      rw [map_mul, map_pow, map_mul, map_pow, hφV_b₀, hφV_a₀]
      calc
        f * (φ_X.hom s₁.1 * φ_V.hom r ^ l * φ_V.hom r ^ k)
            = (f * φ_X.hom s₁.1) * φ_V.hom r ^ k * φ_V.hom r ^ l := by ring
        _ = φ_X.hom b₁ * φ_V.hom r ^ k * φ_V.hom r ^ l := by rw [hfs₁]
    · intro x y hxy
      exact ⟨1, by simp [hInj_V hxy]⟩
  
  refine ⟨Γ_Z, p_1, p_2, η_Γ, hInt_Γ, hDom_Γ, hFunc_Γ, hProp_p1, hp_comm, hη_p1, ?_, ?_⟩
  · intro z
    obtain ⟨a, U_X, hUX, V_C, hVC, e_X, φ_X, φ_C, y_a, _hFrac_X,
      hz_VC, hSpec_X, hSpec_C, hInj_C, hφ_comp, hFT, hGen, hya_val⟩ := hChartFull z
    exact ⟨a, U_X, hUX, V_C, hVC, e_X, φ_X, φ_C, y_a,
      hz_VC, hSpec_X, hSpec_C, hInj_C, hφ_comp, hFT, hGen, hya_val⟩
  · intro Φ_Z _hΦ_g hη_Φ W hW_sub ψ_W a v_W hψ_η hv_diag hv_coord
    obtain ⟨χ_W, hχW_c, hχW_t⟩ :=
      hEval_PW a ↥W (φ_WF.codRestrict W.toSubring hW_sub) v_W hv_diag
    refine ⟨χ_W, hχW_c, hχW_t, ?_⟩
    let ψ_tilde : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ P_W :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_W) ≫ (hAff_W a).fromSpec
    let j_W : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥W) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)
    have : AlgebraicGeometry.IsDominant j_W := by
      constructor
      have hbot_mem : (⊥ : PrimeSpectrum ↥W) ∈ Set.range j_W.base := by
        refine ⟨(⊥ : PrimeSpectrum F), ?_⟩
        apply PrimeSpectrum.ext
        change Ideal.comap W.subtype ⊥ = ⊥
        ext w
        rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
        exact map_eq_zero_iff W.subtype Subtype.val_injective
      have hcl : closure ({(⊥ : PrimeSpectrum ↥W)} : Set (PrimeSpectrum ↥W)) ⊆
          closure (Set.range j_W.base) :=
        closure_mono (Set.singleton_subset_iff.mpr hbot_mem)
      intro q
      apply hcl
      rw [PrimeSpectrum.closure_singleton]
      change (⊥ : Ideal ↥W) ≤ q.asIdeal
      exact bot_le
    have hχW_sub : W.subtype.comp χ_W = χ a := by
      have hsub : Set.range (c_W a) ∪ Set.range (t_W a) ⊆
          (RingHom.eqLocus (W.subtype.comp χ_W) (χ a) : Set _) := by
        rintro _ (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change W.subtype (χ_W (c_W a r)) = χ a (c_W a r)
          have hc1 : χ_W (c_W a r) = (φ_WF.codRestrict W.toSubring hW_sub) r :=
            RingHom.congr_fun hχW_c r
          have hc2 : χ a (c_W a r) = φ_WF r :=
            RingHom.congr_fun (hχ_c a) r
          rw [hc1, hc2]
          rfl
        · change W.subtype (χ_W (t_W a b)) = χ a (t_W a b)
          rw [hχW_t b, hχ_t a b]
          rcases hv_coord with ⟨rfl, hv1⟩ | ⟨rfl, hv0⟩
          · fin_cases b
            · change W.subtype (v_W 0) = v_F 0 0
              rw [hv_diag]
              rfl
            · change W.subtype (v_W 1) = v_F 0 1
              exact hv1
          · fin_cases b
            · change W.subtype (v_W 0) = v_F 1 0
              exact hv0
            · change W.subtype (v_W 1) = v_F 1 1
              rw [hv_diag]
              rfl
      have htop : (⊤ : Subring _) ≤ RingHom.eqLocus (W.subtype.comp χ_W) (χ a) := by
        rw [← hGen_PW a]
        exact Subring.closure_le.mpr hsub
      ext g
      exact htop trivial
    have hj_tilde : j_W ≫ ψ_tilde = η_PW := by
      dsimp only [j_W, ψ_tilde]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hχW_sub, ← hη_PW_chart a]
    have hj_lhs : j_W ≫ (ψ_W ≫ Φ_Z) = η_PW := by
      rw [← CategoryTheory.Category.assoc, hψ_η, hη_Φ, hη_p2]
    have hj_eq : j_W ≫ (ψ_W ≫ Φ_Z) = j_W ≫ ψ_tilde := hj_lhs.trans hj_tilde.symm
    have hg_eq : (ψ_W ≫ Φ_Z) ≫ g_PW = ψ_tilde ≫ g_PW := by
      rw [← AlgebraicGeometry.Spec.map_preimage ((ψ_W ≫ Φ_Z) ≫ g_PW),
        ← AlgebraicGeometry.Spec.map_preimage (ψ_tilde ≫ g_PW)]
      congr 1
      have hpre : W.subtype.comp (AlgebraicGeometry.Spec.preimage ((ψ_W ≫ Φ_Z) ≫ g_PW)).hom =
          W.subtype.comp (AlgebraicGeometry.Spec.preimage (ψ_tilde ≫ g_PW)).hom := by
        have h1 : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (W.subtype.comp (AlgebraicGeometry.Spec.preimage ((ψ_W ≫ Φ_Z) ≫ g_PW)).hom)) =
            j_W ≫ ((ψ_W ≫ Φ_Z) ≫ g_PW) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
        have h2 : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (W.subtype.comp (AlgebraicGeometry.Spec.preimage (ψ_tilde ≫ g_PW)).hom)) =
            j_W ≫ (ψ_tilde ≫ g_PW) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
        have heq_map : j_W ≫ ((ψ_W ≫ Φ_Z) ≫ g_PW) = j_W ≫ (ψ_tilde ≫ g_PW) := by
          rw [← CategoryTheory.Category.assoc, hj_eq, CategoryTheory.Category.assoc]
        rw [← h1, ← h2] at heq_map
        exact congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective heq_map)
      apply CommRingCat.hom_ext
      ext r
      exact RingHom.congr_fun hpre r
    exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_PW hg_eq j_W hj_eq

theorem weil_gauss_linear_val_fiber_quasiFinite_sandwich (L : Type u) [Field L]
    (W₀ : ValuationSubring L)
    (hMax : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (F : Type u) [Field F] (φ_LF : L →+* F) (t : F)
    (ht_tr : ∀ P : Polynomial L, P ≠ 0 → Polynomial.eval₂ φ_LF t P ≠ 0)
    (ht_gen : ∀ f : F, ∃ P Q : Polynomial L, Q ≠ 0 ∧
      f * Polynomial.eval₂ φ_LF t Q = Polynomial.eval₂ φ_LF t P)
    (W_Z : ValuationSubring F) (α_Z π_Z : L)
    (hGauss_Z : IsRankOneGaussLinearVal W₀ φ_LF t W_Z α_Z π_Z)
    (B_X B_C : Type u) [CommRing B_X] [CommRing B_C] [IsDomain B_C]
    (α : B_X →+* B_C) (γ_X : ↥W₀ →+* B_X)
    (φ_X : B_X →+* F) (φ_C : B_C →+* F) (y_a : B_C)
    (p : Ideal B_X) [p.IsPrime]
    (hFT : α.FiniteType)
    (hInjC : Function.Injective φ_C)
    (hφ_comp : φ_C.comp α = φ_X)
    (hCompat : ∀ r : ↥W₀, φ_X (γ_X r) = φ_LF (W₀.subtype r))
    (hGen : Subring.closure (Set.range α ∪ {y_a}) = ⊤) :
    (((∃ b₀ s₀ : B_X, s₀ ∉ p ∧ φ_X s₀ * φ_C y_a = φ_X b₀) ∨
      (∃ b₀ s₀ : B_X, b₀ ∈ p ∧ s₀ ∉ p ∧ φ_X b₀ * φ_C y_a = φ_X s₀)) →
      (letI : Algebra B_X B_C := α.toAlgebra; (p.primesOver B_C).Finite)) ∧
    (Ideal.comap γ_X p = IsLocalRing.maximalIdeal ↥W₀ →
      (φ_C y_a = (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∨
        φ_C y_a = ((t - φ_LF α_Z) * (φ_LF π_Z)⁻¹)⁻¹) →
      ¬ (letI : Algebra B_X B_C := α.toAlgebra; (p.primesOver B_C).Finite) →
      ∃ ρ_X : B_X →+* ↥W_Z,
        W_Z.subtype.comp ρ_X = φ_X ∧
        Ideal.comap ρ_X (IsLocalRing.maximalIdeal ↥W_Z) = p) :=
by
  classical
  have hφ_apply : ∀ b : B_X, φ_X b = φ_C (α b) := fun b =>
    (RingHom.congr_fun hφ_comp b).symm
  have hOver : ∀ (q : Ideal B_C),
      (letI : Algebra B_X B_C := α.toAlgebra; q ∈ p.primesOver B_C) →
      q.IsPrime ∧ Ideal.comap α q = p := by
    let _ : Algebra B_X B_C := α.toAlgebra
    intro q hq
    refine ⟨Ideal.primesOver.isPrime p ⟨q, hq⟩, ?_⟩
    change Ideal.under B_X q = p
    exact (@Ideal.LiesOver.over B_X _ B_C _ _ q p (Ideal.primesOver.liesOver p ⟨q, hq⟩)).symm
  constructor
  · 
    let _ : Algebra B_X B_C := α.toAlgebra
    intro hFrac
    apply Set.Subsingleton.finite
    rcases hFrac with ⟨b₀, s₀, hs₀, heq⟩ | ⟨b₀, s₀, hb₀, hs₀, heq⟩
    · 
      have hrel : α s₀ * y_a = α b₀ := by
        apply hInjC
        rw [map_mul, ← hφ_apply s₀, ← hφ_apply b₀, heq]
      let S_clear : Subring B_C :=
        { carrier := {z : B_C | ∃ (d : ℕ) (b : B_X), (α s₀) ^ d * z = α b}
          one_mem' := ⟨0, 1, by simp⟩
          mul_mem' := by
            rintro z₁ z₂ ⟨d₁, b₁, h₁⟩ ⟨d₂, b₂, h₂⟩
            refine ⟨d₁ + d₂, b₁ * b₂, ?_⟩
            calc
              (α s₀) ^ (d₁ + d₂) * (z₁ * z₂)
                  = ((α s₀) ^ d₁ * z₁) * ((α s₀) ^ d₂ * z₂) := by rw [pow_add]; ring
              _ = α b₁ * α b₂ := by rw [h₁, h₂]
              _ = α (b₁ * b₂) := (map_mul α b₁ b₂).symm
          zero_mem' := ⟨0, 0, by simp⟩
          add_mem' := by
            rintro z₁ z₂ ⟨d₁, b₁, h₁⟩ ⟨d₂, b₂, h₂⟩
            refine ⟨d₁ + d₂, s₀ ^ d₂ * b₁ + s₀ ^ d₁ * b₂, ?_⟩
            calc
              (α s₀) ^ (d₁ + d₂) * (z₁ + z₂)
                  = (α s₀) ^ d₂ * ((α s₀) ^ d₁ * z₁) +
                      (α s₀) ^ d₁ * ((α s₀) ^ d₂ * z₂) := by rw [pow_add]; ring
              _ = (α s₀) ^ d₂ * α b₁ + (α s₀) ^ d₁ * α b₂ := by rw [h₁, h₂]
              _ = α (s₀ ^ d₂ * b₁ + s₀ ^ d₁ * b₂) := by
                    simp [map_add, map_mul, map_pow]
          neg_mem' := by
            rintro z ⟨d, b, h⟩
            refine ⟨d, -b, ?_⟩
            rw [mul_neg, h, map_neg] }
      have hsub_clear : Set.range α ∪ {y_a} ⊆ (S_clear : Set B_C) := by
        rintro z (⟨b, rfl⟩ | hzy)
        · exact ⟨0, b, by simp⟩
        · rw [Set.mem_singleton_iff.mp hzy]
          exact ⟨1, b₀, by simpa using hrel⟩
      have htop_clear : (⊤ : Subring B_C) ≤ S_clear :=
        hGen ▸ Subring.closure_le.mpr hsub_clear
      intro q₁ hq₁ q₂ hq₂
      obtain ⟨hq₁_p, hq₁_c⟩ := hOver q₁ hq₁
      obtain ⟨hq₂_p, hq₂_c⟩ := hOver q₂ hq₂
      ext z
      obtain ⟨d, b, hdb⟩ : z ∈ S_clear := htop_clear (Subring.mem_top z)
      have hs_pow_not : ∀ (q : Ideal B_C), q.IsPrime → Ideal.comap α q = p →
          (α s₀) ^ d ∉ q := by
        intro q hqp hqc hmem
        have hs_in : s₀ ∈ Ideal.comap α q := hqp.mem_of_pow_mem d hmem
        rw [hqc] at hs_in
        exact hs₀ hs_in
      have hmem_iff : ∀ (q : Ideal B_C), q.IsPrime → Ideal.comap α q = p →
          (z ∈ q ↔ b ∈ p) := by
        intro q hqp hqc
        constructor
        · intro hz
          have hmul : α b ∈ q := hdb ▸ q.mul_mem_left ((α s₀) ^ d) hz
          have hmul' : b ∈ Ideal.comap α q := hmul
          rwa [hqc] at hmul'
        · intro hb
          have hmul : (α s₀) ^ d * z ∈ q := by
            rw [hdb]
            change b ∈ Ideal.comap α q
            rwa [hqc]
          exact (hqp.mem_or_mem hmul).resolve_left (hs_pow_not q hqp hqc)
      rw [hmem_iff q₁ hq₁_p hq₁_c, hmem_iff q₂ hq₂_p hq₂_c]
    · 
      have hrel : α b₀ * y_a = α s₀ := by
        apply hInjC
        rw [map_mul, ← hφ_apply b₀, ← hφ_apply s₀, heq]
      intro q₁ hq₁ _ _
      exfalso
      obtain ⟨_, hq₁_c⟩ := hOver q₁ hq₁
      have hb_in : α b₀ ∈ q₁ := by
        change b₀ ∈ Ideal.comap α q₁
        rwa [hq₁_c]
      have hs_in : α s₀ ∈ q₁ := hrel ▸ q₁.mul_mem_right y_a hb_in
      have hs_in' : s₀ ∈ Ideal.comap α q₁ := hs_in
      rw [hq₁_c] at hs_in'
      exact hs₀ hs_in'
  · 
    intro hp_comap hya_or hInf
    obtain ⟨hπ_Z, hMax_WZ, hW₀_WZ, hu_WZ, hu_unit, hm_WZ, hPoly_WZ, _⟩ := hGauss_Z
    let u_Z : F := (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹
    obtain ⟨w_inv, hw_inv⟩ := hu_unit.exists_right_inv
    have hu_ne : u_Z ≠ 0 := by
      intro h0
      have hval : u_Z * w_inv.1 = 1 := congrArg Subtype.val hw_inv
      rw [h0, zero_mul] at hval
      exact zero_ne_one hval
    
    have hStepA : ∃ q₀ : Ideal B_C,
        q₀.IsPrime ∧ Ideal.comap α q₀ = p ∧
        ∀ P : Polynomial B_X, (∃ j : ℕ, P.coeff j ∉ p) →
          Polynomial.eval₂ α y_a P ∉ q₀ := by
      let _ : Algebra B_X B_C := α.toAlgebra
      have _ : Algebra.FiniteType B_X B_C := hFT
      have _ : Algebra.FiniteType p.ResidueField (p.Fiber B_C) :=
        Algebra.FiniteType.baseChange p.ResidueField
      have _ : IsNoetherianRing (p.Fiber B_C) :=
        Algebra.FiniteType.isNoetherianRing p.ResidueField (p.Fiber B_C)
      have _ : Infinite ↑(p.primesOver B_C) := Set.infinite_coe_iff.mpr hInf
      let e_fib := PrimeSpectrum.primesOverOrderIsoFiber B_X B_C p
      have _ : Infinite (PrimeSpectrum (p.Fiber B_C)) :=
        Infinite.of_injective e_fib e_fib.injective
      have hFinMin : {y : PrimeSpectrum (p.Fiber B_C) | IsMin y}.Finite :=
        PrimeSpectrum.finite_setOfPred_isMin (p.Fiber B_C)
      obtain ⟨y₁, hy₁⟩ := hFinMin.exists_notMem
      rw [Set.mem_ofPred_eq, not_isMin_iff] at hy₁
      obtain ⟨y₀, hy₀_lt⟩ := hy₁
      let Q₀ := e_fib.symm y₀
      let Q₁ := e_fib.symm y₁
      have hQ_lt : Q₀ < Q₁ := e_fib.symm.lt_iff_lt.mpr hy₀_lt
      let q₀ : Ideal B_C := Q₀.1
      let q₁ : Ideal B_C := Q₁.1
      have hq_lt : q₀ < q₁ := hQ_lt
      obtain ⟨hq₀_prime, hq₀_comap⟩ := hOver q₀ Q₀.2
      obtain ⟨_, hq₁_comap⟩ := hOver q₁ Q₁.2
      obtain ⟨b_tr, hb_q₁, hb_q₀⟩ := SetLike.exists_of_lt hq_lt
      have hDecomp : ∀ P : Polynomial B_X,
          Polynomial.eval₂ α b_tr P =
            Polynomial.eval₂ α b_tr P.divX * b_tr + α (P.coeff 0) := by
        intro P
        conv_lhs => rw [← Polynomial.divX_mul_X_add P]
        simp [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
      have hCoeff0 : ∀ P : Polynomial B_X,
          P.coeff 0 ∉ p → Polynomial.eval₂ α b_tr P ∉ q₀ := by
        intro P hP0 heval
        have heval_q1 : Polynomial.eval₂ α b_tr P ∈ q₁ := hq_lt.le heval
        rw [hDecomp P] at heval_q1
        have hc0_q1 : P.coeff 0 ∈ Ideal.comap α q₁ := by
          change α (P.coeff 0) ∈ q₁
          simpa using q₁.sub_mem heval_q1
            (q₁.mul_mem_left (Polynomial.eval₂ α b_tr P.divX) hb_q₁)
        rw [hq₁_comap] at hc0_q1
        exact hP0 hc0_q1
      have hPolyBtr : ∀ (k : ℕ) (P : Polynomial B_X),
          P.coeff k ∉ p → Polynomial.eval₂ α b_tr P ∉ q₀ := by
        intro k
        induction k with
        | zero => exact hCoeff0
        | succ k ih =>
          intro P hPk heval
          have hP0 : P.coeff 0 ∈ p := by
            by_contra h0
            exact hCoeff0 P h0 heval
          have hc0_q0 : α (P.coeff 0) ∈ q₀ := by
            change P.coeff 0 ∈ Ideal.comap α q₀
            rwa [hq₀_comap]
          rw [hDecomp P] at heval
          have hmul_q0 : Polynomial.eval₂ α b_tr P.divX * b_tr ∈ q₀ := by
            simpa using q₀.sub_mem heval hc0_q0
          have hdiv_q0 : Polynomial.eval₂ α b_tr P.divX ∈ q₀ :=
            (hq₀_prime.mem_or_mem hmul_q0).resolve_right hb_q₀
          have hdiv_coeff : P.divX.coeff k ∉ p := by
            rw [Polynomial.coeff_divX]
            exact hPk
          exact ih P.divX hdiv_coeff hdiv_q0
      refine ⟨q₀, hq₀_prime, hq₀_comap, ?_⟩
      rintro P₀ ⟨j₀, hj₀⟩ heval_y
      let _ : q₀.IsPrime := hq₀_prime
      let κ_p := p.ResidueField
      let κ_q := q₀.ResidueField
      let π_p : B_X →+* κ_p := algebraMap B_X κ_p
      let π_q : B_C →+* κ_q := algebraMap B_C κ_q
      have hker_p : ∀ b : B_X, π_p b = 0 ↔ b ∈ p := fun b => by
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
      have hker_q : ∀ c : B_C, π_q c = 0 ↔ c ∈ q₀ := fun c => by
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
      let i_pq : κ_p →+* κ_q := Ideal.ResidueField.map p q₀ α hq₀_comap.symm
      have hi_comp : i_pq.comp π_p = π_q.comp α :=
        RingHom.ext (Ideal.ResidueField.map_algebraMap p q₀ α hq₀_comap.symm)
      let _ : Algebra κ_p κ_q := i_pq.toAlgebra
      have heval_res : ∀ (z : B_C) (R_BX : Polynomial B_X),
          Polynomial.aeval (R := κ_p) (π_q z) (R_BX.map π_p) =
            π_q (Polynomial.eval₂ α z R_BX) := by
        intro z R_BX
        change Polynomial.eval₂ i_pq (π_q z) (R_BX.map π_p) = π_q (Polynomial.eval₂ α z R_BX)
        rw [Polynomial.eval₂_map, hi_comp, ← Polynomial.hom_eval₂]
      let P_bar : Polynomial κ_p := P₀.map π_p
      have hP_bar_ne : P_bar ≠ 0 := by
        intro h0
        have hc : P_bar.coeff j₀ = 0 := by rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_map, hker_p] at hc
        exact hj₀ hc
      have haeval_y : Polynomial.aeval (R := κ_p) (π_q y_a) P_bar = 0 := by
        rw [heval_res, hker_q]
        exact heval_y
      have hAlg_y : IsAlgebraic κ_p (π_q y_a) := ⟨P_bar, hP_bar_ne, haeval_y⟩
      have hInt_y : IsIntegral κ_p (π_q y_a) := hAlg_y.isIntegral
      let S_int : Subring B_C := (integralClosure κ_p κ_q).toSubring.comap π_q
      have hsub_int : Set.range α ∪ {y_a} ⊆ (S_int : Set B_C) := by
        rintro z (⟨b, rfl⟩ | hzy)
        · change π_q (α b) ∈ integralClosure κ_p κ_q
          have heq_alg : π_q (α b) = algebraMap κ_p κ_q (π_p b) :=
            (RingHom.congr_fun hi_comp b).symm
          rw [heq_alg, mem_integralClosure_iff]
          exact isIntegral_algebraMap
        · rw [Set.mem_singleton_iff.mp hzy]
          change π_q y_a ∈ integralClosure κ_p κ_q
          rw [mem_integralClosure_iff]
          exact hInt_y
      have hb_int : IsIntegral κ_p (π_q b_tr) := by
        have htop_int : (⊤ : Subring B_C) ≤ S_int :=
          hGen ▸ Subring.closure_le.mpr hsub_int
        have hmem : b_tr ∈ S_int := htop_int (Subring.mem_top b_tr)
        change π_q b_tr ∈ integralClosure κ_p κ_q at hmem
        rwa [mem_integralClosure_iff] at hmem
      obtain ⟨Q_bar, hQ_bar_ne, haeval_b⟩ := hb_int.isAlgebraic
      have hex_frac : ∀ c : κ_p, ∃ a s : B_X, π_p s ≠ 0 ∧ π_p a = c * π_p s := by
        intro c
        obtain ⟨x, y, hy_nzd, hxy⟩ := IsFractionRing.div_surjective (A := B_X ⧸ p) c
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hs_ne : π_p s ≠ 0 := by
          intro hs0
          have hs_p : s ∈ p := (hker_p s).mp hs0
          have hy0 : Ideal.Quotient.mk p s = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hs_p
          exact nonZeroDivisors.ne_zero hy_nzd hy0
        have ha_alg : algebraMap (B_X ⧸ p) κ_p (Ideal.Quotient.mk p a) = π_p a :=
          Ideal.algebraMap_quotient_residueField_mk p a
        have hs_alg : algebraMap (B_X ⧸ p) κ_p (Ideal.Quotient.mk p s) = π_p s :=
          Ideal.algebraMap_quotient_residueField_mk p s
        rw [ha_alg, hs_alg] at hxy
        exact ⟨a, s, hs_ne, (div_eq_iff hs_ne).mp hxy⟩
      choose a_fn s_fn hs_ne ha_eq using fun k => hex_frac (Q_bar.coeff k)
      let D := Q_bar.natDegree
      let S_prod : B_X := ∏ k ∈ Finset.range (D + 1), s_fn k
      have hS_ne : π_p S_prod ≠ 0 := by
        rw [map_prod]
        exact Finset.prod_ne_zero_iff.mpr fun k _ => hs_ne k
      let t_fn : ℕ → B_X := fun k => ∏ j ∈ (Finset.range (D + 1)).erase k, s_fn j
      have ht_eq : ∀ k ∈ Finset.range (D + 1),
          π_p (a_fn k * t_fn k) = π_p S_prod * Q_bar.coeff k := by
        intro k hk
        have hprod : s_fn k * t_fn k = S_prod :=
          Finset.mul_prod_erase (Finset.range (D + 1)) s_fn hk
        calc
          π_p (a_fn k * t_fn k) = π_p (a_fn k) * π_p (t_fn k) := map_mul π_p _ _
          _ = (Q_bar.coeff k * π_p (s_fn k)) * π_p (t_fn k) := by rw [ha_eq k]
          _ = Q_bar.coeff k * π_p (s_fn k * t_fn k) := by rw [map_mul, mul_assoc]
          _ = π_p S_prod * Q_bar.coeff k := by rw [hprod, mul_comm]
      let Q_lift : Polynomial B_X :=
        ∑ k ∈ Finset.range (D + 1), Polynomial.monomial k (a_fn k * t_fn k)
      have hQ_lift_D : Q_lift.coeff D ∉ p := by
        rw [← hker_p]
        have hcD : Q_lift.coeff D = a_fn D * t_fn D := by
          rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single D]
          · simp
          · intro k _ hkD
            simp [Polynomial.coeff_monomial, hkD]
          · intro hnot
            exact absurd (Finset.mem_range.mpr (Nat.lt_succ_self D)) hnot
        rw [hcD, ht_eq D (Finset.mem_range.mpr (Nat.lt_succ_self D))]
        have hlead : Q_bar.coeff D ≠ 0 :=
          Polynomial.leadingCoeff_ne_zero.mpr hQ_bar_ne
        exact mul_ne_zero hS_ne hlead
      have hQ_lift_map : Q_lift.map π_p = Polynomial.C (π_p S_prod) * Q_bar := by
        dsimp only [Q_lift]
        rw [Polynomial.map_sum]
        calc
          (∑ k ∈ Finset.range (D + 1),
              (Polynomial.monomial k (a_fn k * t_fn k)).map π_p)
              = ∑ k ∈ Finset.range (D + 1),
                  Polynomial.C (π_p S_prod) *
                    (Polynomial.C (Q_bar.coeff k) * Polynomial.X ^ k) := by
                refine Finset.sum_congr rfl fun k hk => ?_
                rw [Polynomial.map_monomial, ht_eq k hk,
                  ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, mul_assoc]
          _ = Polynomial.C (π_p S_prod) *
                ∑ k ∈ Finset.range (D + 1),
                  Polynomial.C (Q_bar.coeff k) * Polynomial.X ^ k :=
                (Finset.mul_sum _ _ _).symm
          _ = Polynomial.C (π_p S_prod) * Q_bar := by
                rw [← Q_bar.as_sum_range_C_mul_X_pow]
      have heval_b_q0 : Polynomial.eval₂ α b_tr Q_lift ∈ q₀ := by
        rw [← hker_q, ← heval_res, hQ_lift_map, map_mul, haeval_b, mul_zero]
      exact hPolyBtr D Q_lift hQ_lift_D heval_b_q0
    obtain ⟨q₀, hq₀_prime, hq₀_comap, hPolyY⟩ := hStepA
    let _ : q₀.IsPrime := hq₀_prime
    
    have hStepB : ∃ (V' : ValuationSubring F)
        (ρ_X : B_X →+* ↥V')
        (hW₀_V' : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ V')
        (hu_V' : u_Z ∈ V'),
        V' ≠ ⊤ ∧
        V'.subtype.comp ρ_X = φ_X ∧
        Ideal.comap ρ_X (IsLocalRing.maximalIdeal ↥V') = p ∧
        ∀ Q : Polynomial ↥W₀,
          (∃ i : ℕ, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W₀) →
          Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict V'.toSubring hW₀_V')
            ⟨u_Z, hu_V'⟩ Q ∉ IsLocalRing.maximalIdeal ↥V' := by
      have hUnit_C : ∀ s : q₀.primeCompl, IsUnit (φ_C s.1) := by
        intro s
        have hs0 : s.1 ≠ 0 := fun h0 => s.2 (h0 ▸ q₀.zero_mem)
        have hφs0 : φ_C s.1 ≠ 0 := fun h => hs0 (hInjC (h.trans (map_zero φ_C).symm))
        exact IsUnit.mk0 (φ_C s.1) hφs0
      let ψ_loc : Localization.AtPrime q₀ →+* F :=
        IsLocalization.lift (M := q₀.primeCompl) hUnit_C
      obtain ⟨V', hV'_loc, hLocal_V'⟩ := IsLocalRing.exists_factor_valuationRing ψ_loc
      let ψ_V' : Localization.AtPrime q₀ →+* ↥V' :=
        ψ_loc.codRestrict V'.toSubring hV'_loc
      let ρ_C : B_C →+* ↥V' :=
        ψ_V'.comp (algebraMap B_C (Localization.AtPrime q₀))
      let ρ_X : B_X →+* ↥V' := ρ_C.comp α
      have hρ_C_sub : V'.subtype.comp ρ_C = φ_C := by
        ext c
        change ψ_loc (algebraMap B_C (Localization.AtPrime q₀) c) = φ_C c
        exact IsLocalization.lift_eq (M := q₀.primeCompl) hUnit_C c
      have hρ_X_sub : V'.subtype.comp ρ_X = φ_X := by
        change (V'.subtype.comp ρ_C).comp α = φ_X
        rw [hρ_C_sub, hφ_comp]
      have _ : IsLocalHom ψ_V' := hLocal_V'
      have hcomap_ψ : Ideal.comap ψ_V' (IsLocalRing.maximalIdeal ↥V') =
          IsLocalRing.maximalIdeal (Localization.AtPrime q₀) := by
        ext x
        rw [← not_iff_not, Ideal.mem_comap, IsLocalRing.notMem_maximalIdeal,
          IsLocalRing.notMem_maximalIdeal]
        exact ⟨fun hu => IsLocalHom.map_nonunit x hu, IsUnit.map ψ_V'⟩
      have hq₀_V' : Ideal.comap ρ_C (IsLocalRing.maximalIdeal ↥V') = q₀ := by
        change Ideal.comap (algebraMap B_C (Localization.AtPrime q₀))
          (Ideal.comap ψ_V' (IsLocalRing.maximalIdeal ↥V')) = q₀
        rw [hcomap_ψ]
        exact Localization.AtPrime.under_maximalIdeal
      have hρ_X_comap : Ideal.comap ρ_X (IsLocalRing.maximalIdeal ↥V') = p := by
        change Ideal.comap α (Ideal.comap ρ_C (IsLocalRing.maximalIdeal ↥V')) = p
        rw [hq₀_V', hq₀_comap]
      let ρ_W₀ : ↥W₀ →+* ↥V' := ρ_X.comp γ_X
      have hρ_W₀_val : ∀ r : ↥W₀, (ρ_W₀ r : F) = φ_LF (W₀.subtype r) := by
        intro r
        calc
          (ρ_W₀ r : F) = (V'.subtype.comp ρ_X) (γ_X r) := rfl
          _ = φ_X (γ_X r) := RingHom.congr_fun hρ_X_sub (γ_X r)
          _ = φ_LF (W₀.subtype r) := hCompat r
      have hW₀_V' : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ V' := fun r =>
        (hρ_W₀_val r) ▸ (ρ_W₀ r).2
      have hρ_W₀_eq : ρ_W₀ = (φ_LF.comp W₀.subtype).codRestrict V'.toSubring hW₀_V' :=
        RingHom.ext fun r => Subtype.ext (hρ_W₀_val r)
      have hρ_W₀_comap : Ideal.comap ρ_W₀ (IsLocalRing.maximalIdeal ↥V') =
          IsLocalRing.maximalIdeal ↥W₀ := by
        change Ideal.comap γ_X (Ideal.comap ρ_X (IsLocalRing.maximalIdeal ↥V')) =
          IsLocalRing.maximalIdeal ↥W₀
        rw [hρ_X_comap, hp_comap]
      have hV'_ne_top : V' ≠ ⊤ := by
        intro htop
        have hex_pi0 : ∃ π₀ : ↥W₀, π₀ ∈ IsLocalRing.maximalIdeal ↥W₀ ∧ π₀ ≠ 0 := by
          by_contra! hall0
          apply hMax
          rw [eq_bot_iff]
          intro x hx
          exact Ideal.mem_bot.mpr (hall0 x hx)
        obtain ⟨π₀, hπ₀_mem, hπ₀_ne⟩ := hex_pi0
        have hz₀_ne : φ_LF (W₀.subtype π₀) ≠ 0 := by
          intro hz0
          have hL0 : W₀.subtype π₀ = 0 :=
            φ_LF.injective (hz0.trans (map_zero φ_LF).symm)
          exact hπ₀_ne (Subtype.val_injective hL0)
        have hπ₀_V' : ρ_W₀ π₀ ∈ IsLocalRing.maximalIdeal ↥V' := by
          rw [← hρ_W₀_comap] at hπ₀_mem
          exact hπ₀_mem
        have hinv_mem : (φ_LF (W₀.subtype π₀))⁻¹ ∈ V' :=
          htop.symm ▸ ValuationSubring.mem_top _
        have hone_eq : ρ_W₀ π₀ * ⟨(φ_LF (W₀.subtype π₀))⁻¹, hinv_mem⟩ = (1 : ↥V') := by
          apply Subtype.ext
          change (ρ_W₀ π₀ : F) * (φ_LF (W₀.subtype π₀))⁻¹ = 1
          rw [hρ_W₀_val π₀, mul_inv_cancel₀ hz₀_ne]
        have hone_mem : (1 : ↥V') ∈ IsLocalRing.maximalIdeal ↥V' :=
          hone_eq ▸ (IsLocalRing.maximalIdeal ↥V').mul_mem_right _ hπ₀_V'
        exact (IsLocalRing.maximalIdeal.isMaximal ↥V').ne_top
          (Ideal.eq_top_iff_one _ |>.mpr hone_mem)
      let y_tilde : ↥V' := ρ_C y_a
      have hy_val : (y_tilde : F) = φ_C y_a := RingHom.congr_fun hρ_C_sub y_a
      have hStar : ∀ Q : Polynomial ↥W₀,
          (∃ i : ℕ, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W₀) →
          Polynomial.eval₂ ρ_W₀ y_tilde Q ∉ IsLocalRing.maximalIdeal ↥V' := by
        rintro Q ⟨i, hi⟩ heval_in
        let P : Polynomial B_X := Q.map γ_X
        have hPi : P.coeff i ∉ p := by
          rw [Polynomial.coeff_map]
          intro hmem
          have hmem' : Q.coeff i ∈ Ideal.comap γ_X p := hmem
          rw [hp_comap] at hmem'
          exact hi hmem'
        have heval_eq : Polynomial.eval₂ ρ_W₀ y_tilde Q =
            ρ_C (Polynomial.eval₂ α y_a P) := by
          dsimp only [P, ρ_W₀, ρ_X, y_tilde]
          rw [Polynomial.hom_eval₂, Polynomial.eval₂_map]
        rw [heval_eq] at heval_in
        have hq0_in : Polynomial.eval₂ α y_a P ∈ q₀ := by
          rw [← hq₀_V']
          exact heval_in
        exact hPolyY P ⟨i, hPi⟩ hq0_in
      rcases hya_or with hy_eq | hy_inv
      · 
        have hu_V' : u_Z ∈ V' := by
          have : (y_tilde : F) = u_Z := hy_val.trans hy_eq
          exact this ▸ y_tilde.2
        refine ⟨V', ρ_X, hW₀_V', hu_V', hV'_ne_top, hρ_X_sub, hρ_X_comap, ?_⟩
        intro Q hQ
        have hu_eq : (⟨u_Z, hu_V'⟩ : ↥V') = y_tilde :=
          Subtype.ext (hy_val.trans hy_eq).symm
        rw [← hρ_W₀_eq, hu_eq]
        exact hStar Q hQ
      · 
        have h1_notMem : (1 : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ := fun h1 =>
          (IsLocalRing.maximalIdeal.isMaximal ↥W₀).ne_top
            (Ideal.eq_top_iff_one _ |>.mpr h1)
        have hy_notMem : y_tilde ∉ IsLocalRing.maximalIdeal ↥V' := by
          have hX : Polynomial.eval₂ ρ_W₀ y_tilde Polynomial.X ∉
              IsLocalRing.maximalIdeal ↥V' :=
            hStar Polynomial.X ⟨1, by simp [h1_notMem]⟩
          simpa using hX
        have hy_unit : IsUnit y_tilde := IsLocalRing.notMem_maximalIdeal.mp hy_notMem
        obtain ⟨w, hw⟩ := hy_unit.exists_right_inv
        have hw_val : u_Z⁻¹ * w.1 = 1 := by
          have h1 : (y_tilde : F) * w.1 = 1 := congrArg Subtype.val hw
          rwa [hy_val, hy_inv] at h1
        have hw_eq : w.1 = u_Z := by
          calc
            w.1 = u_Z * (u_Z⁻¹ * w.1) := by rw [← mul_assoc, mul_inv_cancel₀ hu_ne, one_mul]
            _ = u_Z := by rw [hw_val, mul_one]
        have hu_V' : u_Z ∈ V' := hw_eq ▸ w.2
        let u_V' : ↥V' := ⟨u_Z, hu_V'⟩
        have hyu : y_tilde * u_V' = 1 := by
          have huw : u_V' = w := Subtype.ext hw_eq.symm
          rw [huw]
          exact hw
        refine ⟨V', ρ_X, hW₀_V', hu_V', hV'_ne_top, hρ_X_sub, hρ_X_comap, ?_⟩
        rintro Q ⟨i₀, hi₀⟩ heval_u
        rw [← hρ_W₀_eq] at heval_u
        have hci₀_ne : Q.coeff i₀ ≠ 0 := fun h0 =>
          hi₀ (h0 ▸ (IsLocalRing.maximalIdeal ↥W₀).zero_mem)
        have hi₀_le : i₀ ≤ Q.natDegree := Polynomial.le_natDegree_of_ne_zero hci₀_ne
        let N := Q.natDegree
        let Q_rev : Polynomial ↥W₀ :=
          ∑ k ∈ Finset.range (N + 1), Polynomial.monomial (N - k) (Q.coeff k)
        have hQ_rev_coeff : Q_rev.coeff (N - i₀) ∉ IsLocalRing.maximalIdeal ↥W₀ := by
          have heq_c : Q_rev.coeff (N - i₀) = Q.coeff i₀ := by
            rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single i₀]
            · simp
            · intro k hk hki
              have hk_le : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
              have hne_sub : N - k ≠ N - i₀ := by omega
              simp [Polynomial.coeff_monomial, hne_sub]
            · intro hnot
              exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hi₀_le)) hnot
          rwa [heq_c]
        have hrev_eq : y_tilde ^ N * Polynomial.eval₂ ρ_W₀ u_V' Q =
            Polynomial.eval₂ ρ_W₀ y_tilde Q_rev := by
          conv_lhs => rw [Q.as_sum_range_C_mul_X_pow]
          dsimp only [Q_rev]
          rw [Polynomial.eval₂_finsetSum, Polynomial.eval₂_finsetSum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun k hk => ?_
          have hk_le : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hN_split : N = (N - k) + k := (Nat.sub_add_cancel hk_le).symm
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
            Polynomial.eval₂_monomial]
          calc
            y_tilde ^ N * (ρ_W₀ (Q.coeff k) * u_V' ^ k)
                = ρ_W₀ (Q.coeff k) * (y_tilde ^ ((N - k) + k) * u_V' ^ k) := by
                  rw [← hN_split]; ring
            _ = ρ_W₀ (Q.coeff k) * (y_tilde ^ (N - k) * (y_tilde * u_V') ^ k) := by
                  rw [pow_add, mul_assoc, ← mul_pow]
            _ = ρ_W₀ (Q.coeff k) * y_tilde ^ (N - k) := by rw [hyu, one_pow, mul_one]
        have hrev_in : Polynomial.eval₂ ρ_W₀ y_tilde Q_rev ∈
            IsLocalRing.maximalIdeal ↥V' := by
          rw [← hrev_eq]
          exact (IsLocalRing.maximalIdeal ↥V').mul_mem_left (y_tilde ^ N) heval_u
        exact hStar Q_rev ⟨N - i₀, hQ_rev_coeff⟩ hrev_in
    obtain ⟨V', ρ_X, hW₀_V', hu_V', hV'_ne_top, hρ_X_sub, hρ_X_comap, hPoly_V'⟩ := hStepB
    
    have hle : W_Z ≤ V' := by
      let E : Polynomial ↥W₀ → F :=
        fun R₀ => Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_Z R₀
      have hNorm : ∀ R : Polynomial L, R ≠ 0 →
          ∃ (c_R : L) (R₀ : Polynomial ↥W₀),
            c_R ≠ 0 ∧
            (∃ i : ℕ, R₀.coeff i ∉ IsLocalRing.maximalIdeal ↥W₀) ∧
            Polynomial.eval₂ φ_LF u_Z R = φ_LF c_R * E R₀ := by
        intro R hR
        obtain ⟨i_R, hi_R, hmax_R⟩ :=
          Finset.exists_max_image R.support (fun i => W₀.valuation (R.coeff i))
            (Polynomial.support_nonempty.mpr hR)
        let c_R : L := R.coeff i_R
        have hc_R : c_R ≠ 0 := Polynomial.mem_support_iff.mp hi_R
        have hmem_W₀ : ∀ i : ℕ, R.coeff i * c_R⁻¹ ∈ W₀ := by
          intro i
          by_cases hi : i ∈ R.support
          · rw [← ValuationSubring.valuation_le_one_iff]
            rw [map_mul, map_inv₀]
            have h1 : W₀.valuation (R.coeff i) ≤ W₀.valuation c_R := hmax_R i hi
            calc
              W₀.valuation (R.coeff i) * (W₀.valuation c_R)⁻¹
                  ≤ W₀.valuation c_R * (W₀.valuation c_R)⁻¹ := by gcongr
              _ ≤ 1 := mul_inv_le_one
          · have h0 : R.coeff i = 0 := Polynomial.notMem_support_iff.mp hi
            rw [h0, zero_mul]
            exact W₀.zero_mem
        let R₀ : Polynomial ↥W₀ :=
          ∑ i ∈ R.support, Polynomial.monomial i ⟨R.coeff i * c_R⁻¹, hmem_W₀ i⟩
        have hR₀_iR : R₀.coeff i_R = 1 := by
          rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single i_R]
          · simp only [Polynomial.coeff_monomial, ↓reduceIte]
            exact Subtype.ext (mul_inv_cancel₀ hc_R)
          · intro i _ hii
            simp [Polynomial.coeff_monomial, hii]
          · intro hnot
            exact absurd hi_R hnot
        have h1_notMem : (1 : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ := fun h1 =>
          (IsLocalRing.maximalIdeal.isMaximal ↥W₀).ne_top
            (Ideal.eq_top_iff_one _ |>.mpr h1)
        refine ⟨c_R, R₀, hc_R, ⟨i_R, hR₀_iR.symm ▸ h1_notMem⟩, ?_⟩
        dsimp only [E, R₀]
        rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def, Polynomial.eval₂_finsetSum,
          Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.eval₂_monomial]
        change φ_LF (R.coeff i) * u_Z ^ i =
          φ_LF c_R * (φ_LF (R.coeff i * c_R⁻¹) * u_Z ^ i)
        rw [← mul_assoc, ← map_mul]
        have hcancel : c_R * (R.coeff i * c_R⁻¹) = R.coeff i := by
          calc
            c_R * (R.coeff i * c_R⁻¹) = R.coeff i * (c_R * c_R⁻¹) := by ring
            _ = R.coeff i := by rw [mul_inv_cancel₀ hc_R, mul_one]
        rw [hcancel]
      have hPullback : ∀ a : L, φ_LF a ∈ W_Z → a ∈ W₀ := by
        intro a ha_WZ
        by_contra ha_not
        have ha0 : a ≠ 0 := fun h0 => ha_not (h0 ▸ W₀.zero_mem)
        have ha_inv : a⁻¹ ∈ W₀ :=
          (ValuationSubring.mem_or_inv_mem W₀ a).resolve_left ha_not
        let r : ↥W₀ := ⟨a⁻¹, ha_inv⟩
        have hr_nonunit : ¬ IsUnit r := by
          intro hu
          obtain ⟨s, hs⟩ := hu.exists_right_inv
          have hval : a⁻¹ * s.1 = 1 := congrArg Subtype.val hs
          have hs_eq : s.1 = a := by
            calc
              s.1 = a * (a⁻¹ * s.1) := by rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
              _ = a := by rw [hval, mul_one]
          exact ha_not (hs_eq ▸ s.2)
        have hr_max : r ∈ IsLocalRing.maximalIdeal ↥W₀ :=
          (IsLocalRing.mem_maximalIdeal r).mpr hr_nonunit
        have hr_WZ : (⟨φ_LF (W₀.subtype r), hW₀_WZ r⟩ : ↥W_Z) ∈
            IsLocalRing.maximalIdeal ↥W_Z := (hm_WZ r).mpr hr_max
        have hone_eq : (⟨φ_LF a, ha_WZ⟩ : ↥W_Z) *
            ⟨φ_LF (W₀.subtype r), hW₀_WZ r⟩ = (1 : ↥W_Z) := by
          apply Subtype.ext
          change φ_LF a * φ_LF a⁻¹ = 1
          rw [← map_mul, mul_inv_cancel₀ ha0, map_one]
        have hone_mem : (1 : ↥W_Z) ∈ IsLocalRing.maximalIdeal ↥W_Z :=
          hone_eq ▸ (IsLocalRing.maximalIdeal ↥W_Z).mul_mem_left _ hr_WZ
        exact (IsLocalRing.maximalIdeal.isMaximal ↥W_Z).ne_top
          (Ideal.eq_top_iff_one _ |>.mpr hone_mem)
      have hEvalMemAndUnit : ∀ (W : ValuationSubring F)
          (hW₀_W : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W)
          (hu_W : u_Z ∈ W) (R₀ : Polynomial ↥W₀),
          E R₀ ∈ W ∧
          (Polynomial.eval₂ ((φ_LF.comp W₀.subtype).codRestrict W.toSubring hW₀_W)
              ⟨u_Z, hu_W⟩ R₀ ∉ IsLocalRing.maximalIdeal ↥W →
            E R₀ ≠ 0 ∧ (E R₀)⁻¹ ∈ W) := by
        intro W hW₀_W hu_W R₀
        let ι_W := (φ_LF.comp W₀.subtype).codRestrict W.toSubring hW₀_W
        let ev_W : ↥W := Polynomial.eval₂ ι_W ⟨u_Z, hu_W⟩ R₀
        have hev_val : (ev_W : F) = E R₀ := by
          change W.subtype (Polynomial.eval₂ ι_W ⟨u_Z, hu_W⟩ R₀) =
            Polynomial.eval₂ (φ_LF.comp W₀.subtype) u_Z R₀
          rw [Polynomial.hom_eval₂]
          rfl
        refine ⟨hev_val ▸ ev_W.2, fun hnot => ?_⟩
        have hu_ev : IsUnit ev_W := IsLocalRing.notMem_maximalIdeal.mp hnot
        obtain ⟨v, hv⟩ := hu_ev.exists_right_inv
        have hmul1 : E R₀ * v.1 = 1 := by
          rw [← hev_val]
          exact congrArg Subtype.val hv
        have hne0 : E R₀ ≠ 0 := fun h0 =>
          zero_ne_one (by rw [← hmul1, h0, zero_mul])
        have hv_eq : v.1 = (E R₀)⁻¹ := by
          calc
            v.1 = (E R₀)⁻¹ * (E R₀ * v.1) := by
              rw [← mul_assoc, inv_mul_cancel₀ hne0, one_mul]
            _ = (E R₀)⁻¹ := by rw [hmul1, mul_one]
        exact ⟨hne0, hv_eq ▸ v.2⟩
      have hφπ : φ_LF π_Z ≠ 0 := fun h0 =>
        hπ_Z (φ_LF.injective (h0.trans (map_zero φ_LF).symm))
      let X_lin : Polynomial L := Polynomial.C α_Z + Polynomial.C π_Z * Polynomial.X
      have hX_lin_eval : Polynomial.eval₂ φ_LF u_Z X_lin = t := by
        dsimp only [X_lin, u_Z]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_C, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X]
        calc
          φ_LF α_Z + φ_LF π_Z * ((t - φ_LF α_Z) * (φ_LF π_Z)⁻¹)
              = φ_LF α_Z + (t - φ_LF α_Z) * (φ_LF π_Z * (φ_LF π_Z)⁻¹) := by ring
          _ = t := by rw [mul_inv_cancel₀ hφπ, mul_one, add_sub_cancel]
      intro w hw_WZ
      by_cases hw0 : w = 0
      · exact hw0 ▸ V'.zero_mem
      · obtain ⟨P_raw, Q_raw, hQ_raw, hw_eq⟩ := ht_gen w
        have hq_t_ne : Polynomial.eval₂ φ_LF t Q_raw ≠ 0 := ht_tr Q_raw hQ_raw
        have hp_t_ne : Polynomial.eval₂ φ_LF t P_raw ≠ 0 := by
          rw [← hw_eq]
          exact mul_ne_zero hw0 hq_t_ne
        let P_t : Polynomial L := P_raw.comp X_lin
        let Q_t : Polynomial L := Q_raw.comp X_lin
        have hP_t_eval : Polynomial.eval₂ φ_LF u_Z P_t = Polynomial.eval₂ φ_LF t P_raw := by
          dsimp only [P_t]
          rw [Polynomial.eval₂_comp, hX_lin_eval]
        have hQ_t_eval : Polynomial.eval₂ φ_LF u_Z Q_t = Polynomial.eval₂ φ_LF t Q_raw := by
          dsimp only [Q_t]
          rw [Polynomial.eval₂_comp, hX_lin_eval]
        have hP_t_ne : P_t ≠ 0 := fun h0 =>
          hp_t_ne (by rw [← hP_t_eval, h0, Polynomial.eval₂_zero])
        have hQ_t_ne : Q_t ≠ 0 := fun h0 =>
          hq_t_ne (by rw [← hQ_t_eval, h0, Polynomial.eval₂_zero])
        obtain ⟨c_P, P₀, _, hP₀_prim, hP₀_eq⟩ := hNorm P_t hP_t_ne
        obtain ⟨c_Q, Q₀, hc_Q, hQ₀_prim, hQ₀_eq⟩ := hNorm Q_t hQ_t_ne
        obtain ⟨_, hEP₀_ne, hEP₀_inv_WZ⟩ :=
          hEvalMemAndUnit W_Z hW₀_WZ hu_WZ P₀ |>.imp_right (fun h => h (hPoly_WZ P₀ hP₀_prim))
        obtain ⟨hEQ₀_WZ, _, _⟩ :=
          hEvalMemAndUnit W_Z hW₀_WZ hu_WZ Q₀ |>.imp_right (fun h => h (hPoly_WZ Q₀ hQ₀_prim))
        have hEP₀_V' : E P₀ ∈ V' := (hEvalMemAndUnit V' hW₀_V' hu_V' P₀).1
        obtain ⟨hEQ₀_ne, hEQ₀_inv_V'⟩ :=
          (hEvalMemAndUnit V' hW₀_V' hu_V' Q₀).2 (hPoly_V' Q₀ hQ₀_prim)
        have hφcQ : φ_LF c_Q ≠ 0 := fun h0 =>
          hc_Q (φ_LF.injective (h0.trans (map_zero φ_LF).symm))
        have hw_norm : w * (φ_LF c_Q * E Q₀) = φ_LF c_P * E P₀ := by
          rw [← hQ₀_eq, hQ_t_eval, ← hP₀_eq, hP_t_eval]
          exact hw_eq
        have hc_ratio_eq : φ_LF (c_P * c_Q⁻¹) = w * E Q₀ * (E P₀)⁻¹ := by
          apply mul_right_cancel₀ (mul_ne_zero hφcQ hEP₀_ne)
          calc
            φ_LF (c_P * c_Q⁻¹) * (φ_LF c_Q * E P₀)
                = φ_LF (c_P * (c_Q⁻¹ * c_Q)) * E P₀ := by
                  rw [← mul_assoc, ← map_mul, mul_assoc]
            _ = φ_LF c_P * E P₀ := by rw [inv_mul_cancel₀ hc_Q, mul_one]
            _ = (w * (φ_LF c_Q * E Q₀)) * ((E P₀)⁻¹ * E P₀) := by
                  rw [hw_norm, inv_mul_cancel₀ hEP₀_ne, mul_one]
            _ = w * E Q₀ * (E P₀)⁻¹ * (φ_LF c_Q * E P₀) := by ring
        have hc_ratio_WZ : φ_LF (c_P * c_Q⁻¹) ∈ W_Z := by
          rw [hc_ratio_eq]
          exact mul_mem (mul_mem hw_WZ hEQ₀_WZ) hEP₀_inv_WZ
        have hc_ratio_W₀ : c_P * c_Q⁻¹ ∈ W₀ := hPullback _ hc_ratio_WZ
        have hc_ratio_V' : φ_LF (c_P * c_Q⁻¹) ∈ V' :=
          hW₀_V' ⟨c_P * c_Q⁻¹, hc_ratio_W₀⟩
        have hw_rep : w = φ_LF (c_P * c_Q⁻¹) * E P₀ * (E Q₀)⁻¹ := by
          symm
          calc
            φ_LF (c_P * c_Q⁻¹) * E P₀ * (E Q₀)⁻¹
                = w * E Q₀ * (E P₀)⁻¹ * E P₀ * (E Q₀)⁻¹ := by rw [hc_ratio_eq]
            _ = w * ((E P₀)⁻¹ * E P₀) * (E Q₀ * (E Q₀)⁻¹) := by ring
            _ = w := by
                  rw [inv_mul_cancel₀ hEP₀_ne, mul_inv_cancel₀ hEQ₀_ne, mul_one, mul_one]
        rw [hw_rep]
        exact mul_mem (mul_mem hc_ratio_V' hEP₀_V') hEQ₀_inv_V'
    have hV'_eq : V' = W_Z := hMax_WZ V' hle hV'_ne_top
    subst hV'_eq
    exact ⟨ρ_X, hρ_X_sub, hρ_X_comap⟩

theorem weil_projLine_closedFiber_retraction_iso_and_collapse (L : Type u) [Field L]
    (W₀ : ValuationSubring L)
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀))
    (hProp_ℰ : AlgebraicGeometry.IsProper g_ℰ)
    (F : Type u) [Field F]
    (η_ℰ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ ℰ)
    (φ_LF : L →+* F) (t : F)
    (hAff : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff R N) (c_proj R N) (t_proj R N))
    (hBase : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ_RS : R →+* S) (N : ℕ),
      ∃ (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left),
        IsCommRingProjBaseChange R S φ_RS N
          (c_proj R N) (t_proj R N) (c_proj S N) (t_proj S N) Φ)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_ℰ
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g_ℰ
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField))))
    (W_Z : ValuationSubring F) (α_Z π_Z : L)
    (hGauss_Z : IsRankOneGaussLinearVal W₀ φ_LF t W_Z α_Z π_Z)
    (hCenter_Z : IsRankOneComponentStalkCenter W₀ g_ℰ η_ℰ Z Z_sch ιZ W_Z)
    (Φ_Z : ℰ ⟶ (weilProjectiveSpaceOver ↥W₀ 1).left)
    (hΦ_comm : Φ_Z ≫ (weilProjectiveSpaceOver ↥W₀ 1).hom = g_ℰ)
    (hValEval : ∀ (W : ValuationSubring F)
        (hW_sub : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W)
        (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ ℰ)
        (a : Fin 2) (v_W : Fin 2 → ↥W),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_W = η_ℰ →
        v_W a = 1 →
        ((a = 0 ∧ W.subtype (v_W 1) = (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹) ∨
          (a = 1 ∧ W.subtype (v_W 0) = ((t - φ_LF α_Z) * (φ_LF π_Z)⁻¹)⁻¹)) →
        ∃ (χ_W : ↑((weilProjectiveSpaceOver ↥W₀ 1).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen ↥W₀ 1 a))) →+* ↥W),
          χ_W.comp (c_proj ↥W₀ 1 a) = (φ_LF.comp W₀.subtype).codRestrict W.toSubring hW_sub ∧
          (∀ b : Fin 2, χ_W (t_proj ↥W₀ 1 a b) = v_W b) ∧
          ψ_W ≫ Φ_Z =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_W) ≫ (hAff ↥W₀ 1 a).fromSpec) :
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
    ∃ (Φ_bar : T₀ ⟶ (weilProjectiveSpaceOver k₀ 1).left),
      Φ_bar ≫ (weilProjectiveSpaceOver k₀ 1).hom =
        CategoryTheory.Limits.pullback.snd g_ℰ s₀ ∧
      AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k₀ 1).left ∧
      IsAffineNormalScheme (weilProjectiveSpaceOver k₀ 1).left ∧
      AlgebraicGeometry.IsProper (ιZ ≫ Φ_bar) ∧
      (∃ (K_Z : Type u) (_ : Field K_Z)
          (η_Z : AlgebraicGeometry.Spec (CommRingCat.of K_Z) ⟶ Z_sch),
        AlgebraicGeometry.IsDominant η_Z ∧
        IsSchemeFunctionField Z_sch K_Z η_Z ∧
        IsSchemeFunctionField (weilProjectiveSpaceOver k₀ 1).left K_Z (η_Z ≫ ιZ ≫ Φ_bar) ∧
        ∀ z : Z_sch,
          ∃ (U_X : (weilProjectiveSpaceOver k₀ 1).left.Opens)
            (_ : AlgebraicGeometry.IsAffineOpen U_X)
            (V_C : Z_sch.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
            (e_X : V_C ≤ (TopologicalSpace.Opens.map (ιZ ≫ Φ_bar).base).obj U_X),
            z ∈ V_C ∧
            ((ιZ ≫ Φ_bar).appLE U_X V_C e_X).hom.FiniteType ∧
            ((ιZ ≫ Φ_bar).appLE U_X V_C e_X).hom.QuasiFinite) ∧
      (∀ (Z' : Set ↥T₀) (Z'_sch : AlgebraicGeometry.Scheme.{u}) (ιZ' : Z'_sch ⟶ T₀)
          (W' : ValuationSubring F)
          (hW₀_W' : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W'),
        IsRankOneComponentStalkCenter W₀ g_ℰ η_ℰ Z' Z'_sch ιZ' W' →
        (∀ r : ↥W₀,
          (⟨φ_LF (W₀.subtype r), hW₀_W' r⟩ : ↥W') ∈ IsLocalRing.maximalIdeal ↥W' ↔
            r ∈ IsLocalRing.maximalIdeal ↥W₀) →
        ((t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∉ W' ∨
          ∃ (hu_W' : (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹ ∈ W') (c₀ : ↥W₀),
            (⟨(t - φ_LF α_Z) * (φ_LF π_Z)⁻¹, hu_W'⟩ : ↥W') -
              ⟨φ_LF (W₀.subtype c₀), hW₀_W' c₀⟩ ∈ IsLocalRing.maximalIdeal ↥W') →
        ∃ p_star : ↥(weilProjectiveSpaceOver k₀ 1).left,
          ∀ q ∈ Z', Φ_bar.base q = p_star) :=
by
  intro k₀ s₀ T₀
  classical
  
  let m₀ : Ideal ↥W₀ := IsLocalRing.maximalIdeal ↥W₀
  haveI hm₀_max : (IsLocalRing.maximalIdeal ↥W₀).IsMaximal :=
    IsLocalRing.maximalIdeal.isMaximal ↥W₀
  haveI hm₀_prime : (IsLocalRing.maximalIdeal ↥W₀).IsPrime := hm₀_max.isPrime
  have hbij_quot : Function.Bijective (algebraMap (↥W₀ ⧸ m₀) k₀) :=
    Ideal.bijective_algebraMap_quotient_residueField m₀
  have hs₀_surj : Function.Surjective (algebraMap ↥W₀ k₀) := by
    have heq : algebraMap ↥W₀ k₀ = (algebraMap (↥W₀ ⧸ m₀) k₀).comp (Ideal.Quotient.mk m₀) :=
      IsScalarTower.algebraMap_eq ↥W₀ (↥W₀ ⧸ m₀) k₀
    rw [heq]
    exact hbij_quot.2.comp Ideal.Quotient.mk_surjective
  haveI hCl_s₀ : AlgebraicGeometry.IsClosedImmersion s₀ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (algebraMap ↥W₀ k₀)) hs₀_surj
  haveI hMono_s₀ : CategoryTheory.Mono s₀ := inferInstance

  
  let fst₀ := CategoryTheory.Limits.pullback.fst g_ℰ s₀
  let snd₀ := CategoryTheory.Limits.pullback.snd g_ℰ s₀
  let P_W := (weilProjectiveSpaceOver ↥W₀ 1).left
  let g_PW := (weilProjectiveSpaceOver ↥W₀ 1).hom
  let P_k0 := (weilProjectiveSpaceOver k₀ 1).left
  let g_Pk0 := (weilProjectiveSpaceOver k₀ 1).hom
  obtain ⟨Φ_BC, hComm_BC, hPb_BC, hSec_BC⟩ := hBase ↥W₀ k₀ (algebraMap ↥W₀ k₀) 1
  have h_sq : (fst₀ ≫ Φ_Z) ≫ g_PW = snd₀ ≫ s₀ := by
    rw [CategoryTheory.Category.assoc, hΦ_comm]
    exact CategoryTheory.Limits.pullback.condition
  let Φ_bar : T₀ ⟶ P_k0 := hPb_BC.lift (fst₀ ≫ Φ_Z) snd₀ h_sq
  have hΦ_bar_fst : Φ_bar ≫ Φ_BC = fst₀ ≫ Φ_Z := hPb_BC.lift_fst _ _ _
  have hΦ_bar_snd : Φ_bar ≫ g_Pk0 = snd₀ := hPb_BC.lift_snd _ _ _

  
  have hEvalCenter :
      ∀ (Z_star_sch : AlgebraicGeometry.Scheme.{u})
        (ιZ_star : Z_star_sch ⟶ T₀)
        (K_star : Type u) [Field K_star]
        (η_star : AlgebraicGeometry.Spec (CommRingCat.of K_star) ⟶ Z_star_sch)
        (W : ValuationSubring F)
        (hW_sub : ∀ r : ↥W₀, φ_LF (W₀.subtype r) ∈ W)
        (hm_W : ∀ r : ↥W₀,
          (⟨φ_LF (W₀.subtype r), hW_sub r⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔
            r ∈ IsLocalRing.maximalIdeal ↥W₀)
        (U_star : ℰ.Opens) (hU_star : AlgebraicGeometry.IsAffineOpen U_star)
        (φ_U_star : CommRingCat.of ↑(ℰ.presheaf.obj (Opposite.op U_star)) ⟶ CommRingCat.of F)
        (hB_W : ∀ b : ↑(ℰ.presheaf.obj (Opposite.op U_star)), φ_U_star.hom b ∈ W)
        (e_W : (IsLocalRing.maximalIdeal ↥W).ResidueField ≃+* K_star),
        AlgebraicGeometry.Spec.map φ_U_star ≫ hU_star.fromSpec = η_ℰ →
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.maximalIdeal ↥W).ResidueField)) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ_U_star.hom.codRestrict W.toSubring hB_W)) ≫
          hU_star.fromSpec =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_W.symm.toRingHom) ≫
            η_star ≫ ιZ_star ≫ fst₀ →
        ∀ (a : Fin 2) (v_W : Fin 2 → ↥W),
          v_W a = 1 →
          ((a = 0 ∧ W.subtype (v_W 1) = (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹) ∨
            (a = 1 ∧ W.subtype (v_W 0) = ((t - φ_LF α_Z) * (φ_LF π_Z)⁻¹)⁻¹)) →
          haveI : (IsLocalRing.maximalIdeal ↥W).IsPrime :=
            (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime
          let ρ_W : ↥W₀ →+* ↥W := (φ_LF.comp W₀.subtype).codRestrict W.toSubring hW_sub
          let h_comap : IsLocalRing.maximalIdeal ↥W₀ =
              Ideal.comap ρ_W (IsLocalRing.maximalIdeal ↥W) :=
            Ideal.ext fun r => (hm_W r).symm
          let ρ_bar : k₀ →+* K_star :=
            e_W.toRingHom.comp
              (Ideal.ResidueField.map (IsLocalRing.maximalIdeal ↥W₀)
                (IsLocalRing.maximalIdeal ↥W) ρ_W h_comap)
          ∃ (χ_bar : ↑(P_k0.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))) →+* K_star),
            χ_bar.comp (c_proj k₀ 1 a) = ρ_bar ∧
            (∀ b : Fin 2,
              χ_bar (t_proj k₀ 1 a b) =
                e_W (algebraMap ↥W (IsLocalRing.maximalIdeal ↥W).ResidueField (v_W b))) ∧
            η_star ≫ ιZ_star ≫ Φ_bar =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_bar) ≫ (hAff k₀ 1 a).fromSpec ∧
            η_star ≫ ιZ_star ≫ snd₀ =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar) := by
    intro Z_star_sch ιZ_star K_star _ η_star W hW_sub hm_W U_star hU_star φ_U_star hB_W e_W
      hφ_U_star hComm_star a v_W hv_a hv_or
    haveI hmW_max : (IsLocalRing.maximalIdeal ↥W).IsMaximal :=
      IsLocalRing.maximalIdeal.isMaximal ↥W
    haveI hmW_prime : (IsLocalRing.maximalIdeal ↥W).IsPrime := hmW_max.isPrime
    let m_W : Ideal ↥W := IsLocalRing.maximalIdeal ↥W
    let κ_W := m_W.ResidueField
    let ψ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ ℰ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_U_star.hom.codRestrict W.toSubring hB_W)) ≫
        hU_star.fromSpec
    have hjψ_W : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_W = η_ℰ := by
      dsimp only [ψ_W]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have heq_sub : W.subtype.comp (φ_U_star.hom.codRestrict W.toSubring hB_W) = φ_U_star.hom :=
        RingHom.ext fun _ => rfl
      rw [heq_sub]
      exact hφ_U_star
    obtain ⟨χ_W, hχ_c, hχ_t, hψ_Φ⟩ := hValEval W hW_sub ψ_W a v_W hjψ_W hv_a hv_or
    let ρ_W : ↥W₀ →+* ↥W := (φ_LF.comp W₀.subtype).codRestrict W.toSubring hW_sub
    let h_comap : IsLocalRing.maximalIdeal ↥W₀ = Ideal.comap ρ_W m_W :=
      Ideal.ext fun r => (hm_W r).symm
    let f_res : k₀ →+* κ_W :=
      Ideal.ResidueField.map (IsLocalRing.maximalIdeal ↥W₀) m_W ρ_W h_comap
    let ρ_bar : k₀ →+* K_star := e_W.toRingHom.comp f_res
    let v_bar : Fin 2 → K_star := fun b => e_W (algebraMap ↥W κ_W (v_W b))
    have hv_bar_a : v_bar a = 1 := by
      dsimp only [v_bar]
      rw [hv_a, map_one, map_one]
    obtain ⟨χ_bar, hχ_bar_c, hχ_bar_t⟩ :=
      (hCoord k₀ 1).2.2.2.2.2.2.1 a K_star ρ_bar v_bar hv_bar_a
    let η_bar : AlgebraicGeometry.Spec (CommRingCat.of K_star) ⟶ P_k0 :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_bar) ≫ (hAff k₀ 1 a).fromSpec
    obtain ⟨heq, hBC_c, hBC_t⟩ := hSec_BC a
    have hle : weilProjBasicOpen k₀ 1 a ≤
        (TopologicalSpace.Opens.map Φ_BC.base).obj (weilProjBasicOpen ↥W₀ 1 a) :=
      le_of_eq heq.symm
    have heq_appLE :
        Φ_BC.app (weilProjBasicOpen ↥W₀ 1 a) ≫
          P_k0.presheaf.map (CategoryTheory.eqToHom heq.symm).op =
        Φ_BC.appLE (weilProjBasicOpen ↥W₀ 1 a) (weilProjBasicOpen k₀ 1 a) hle := by
      have hsub : CategoryTheory.eqToHom heq.symm = CategoryTheory.homOfLE hle :=
        Subsingleton.elim _ _
      rw [hsub, Φ_BC.app_eq_appLE, Φ_BC.appLE_map]
    have h_ring :
        e_W.toRingHom.comp ((algebraMap ↥W κ_W).comp χ_W) =
          χ_bar.comp (Φ_BC.appLE (weilProjBasicOpen ↥W₀ 1 a) (weilProjBasicOpen k₀ 1 a) hle).hom := by
      let lhs := e_W.toRingHom.comp ((algebraMap ↥W κ_W).comp χ_W)
      let rhs :=
        χ_bar.comp (Φ_BC.appLE (weilProjBasicOpen ↥W₀ 1 a) (weilProjBasicOpen k₀ 1 a) hle).hom
      have hsub_gen :
          Set.range (c_proj ↥W₀ 1 a) ∪ Set.range (t_proj ↥W₀ 1 a) ⊆
            (RingHom.eqLocus lhs rhs : Set _) := by
        rintro _ (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change e_W (algebraMap ↥W κ_W (χ_W (c_proj ↥W₀ 1 a r))) =
            χ_bar ((Φ_BC.appLE _ _ hle).hom (c_proj ↥W₀ 1 a r))
          have hc1 : χ_W (c_proj ↥W₀ 1 a r) = ρ_W r :=
            RingHom.congr_fun hχ_c r
          have hc2 : (Φ_BC.appLE _ _ hle).hom (c_proj ↥W₀ 1 a r) =
              c_proj k₀ 1 a (algebraMap ↥W₀ k₀ r) := by
            rw [← heq_appLE]
            exact hBC_c r
          have hc3 : χ_bar (c_proj k₀ 1 a (algebraMap ↥W₀ k₀ r)) =
              ρ_bar (algebraMap ↥W₀ k₀ r) :=
            RingHom.congr_fun hχ_bar_c (algebraMap ↥W₀ k₀ r)
          rw [hc1, hc2, hc3]
          dsimp only [ρ_bar, f_res, RingHom.comp_apply]
          rw [Ideal.ResidueField.map_algebraMap]
          rfl
        · change e_W (algebraMap ↥W κ_W (χ_W (t_proj ↥W₀ 1 a b))) =
            χ_bar ((Φ_BC.appLE _ _ hle).hom (t_proj ↥W₀ 1 a b))
          have ht2 : (Φ_BC.appLE _ _ hle).hom (t_proj ↥W₀ 1 a b) = t_proj k₀ 1 a b := by
            rw [← heq_appLE]
            exact hBC_t b
          rw [hχ_t b, ht2, hχ_bar_t b]
      have htop : (⊤ : Subring _) ≤ RingHom.eqLocus lhs rhs := by
        rw [← (hCoord ↥W₀ 1).2.2.2.2.2.1 a]
        exact Subring.closure_le.mpr hsub_gen
      ext x
      exact htop trivial
    have hη_bar_BC :
        η_bar ≫ Φ_BC =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (e_W.toRingHom.comp ((algebraMap ↥W κ_W).comp χ_W))) ≫
          (hAff ↥W₀ 1 a).fromSpec := by
      dsimp only [η_bar]
      rw [CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ_BC
          (hAff ↥W₀ 1 a) (hAff k₀ 1 a) hle,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      apply CommRingCat.hom_ext
      exact h_ring.symm
    have hη_star_fst :
        η_star ≫ ιZ_star ≫ fst₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_W.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W κ_W)) ≫ ψ_W := by
      have hpre :=
        congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_W.toRingHom) ≫ ·) hComm_star
      dsimp only [ψ_W]
      rw [hpre, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_W.toRingHom)),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hid : e_W.toRingHom.comp e_W.symm.toRingHom = RingHom.id K_star :=
        RingHom.ext fun x => e_W.apply_symm_apply x
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
    have hCheckA : (η_star ≫ ιZ_star ≫ Φ_bar) ≫ Φ_BC = η_bar ≫ Φ_BC := by
      calc
        (η_star ≫ ιZ_star ≫ Φ_bar) ≫ Φ_BC
            = (η_star ≫ ιZ_star ≫ fst₀) ≫ Φ_Z := by
                simp only [CategoryTheory.Category.assoc, hΦ_bar_fst]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_W.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W κ_W)) ≫
              (ψ_W ≫ Φ_Z) := by
                rw [hη_star_fst]
                simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (e_W.toRingHom.comp ((algebraMap ↥W κ_W).comp χ_W))) ≫
            (hAff ↥W₀ 1 a).fromSpec := by
                rw [hψ_Φ]
                simp only [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                  ← CommRingCat.ofHom_comp]
        _ = η_bar ≫ Φ_BC := hη_bar_BC.symm
    have hCheckB : (η_star ≫ ιZ_star ≫ Φ_bar) ≫ g_Pk0 = η_bar ≫ g_Pk0 := by
      apply (CategoryTheory.cancel_mono s₀).mp
      calc
        ((η_star ≫ ιZ_star ≫ Φ_bar) ≫ g_Pk0) ≫ s₀
            = ((η_star ≫ ιZ_star ≫ Φ_bar) ≫ Φ_BC) ≫ g_PW := by
                rw [CategoryTheory.Category.assoc, ← hComm_BC, ← CategoryTheory.Category.assoc]
        _ = (η_bar ≫ Φ_BC) ≫ g_PW := by rw [hCheckA]
        _ = (η_bar ≫ g_Pk0) ≫ s₀ := by
                rw [CategoryTheory.Category.assoc, hComm_BC, ← CategoryTheory.Category.assoc]
    have hMain : η_star ≫ ιZ_star ≫ Φ_bar = η_bar :=
      hPb_BC.hom_ext hCheckA hCheckB
    have hSnd : η_star ≫ ιZ_star ≫ snd₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar) := by
      calc
        η_star ≫ ιZ_star ≫ snd₀
            = (η_star ≫ ιZ_star ≫ Φ_bar) ≫ g_Pk0 := by
                simp only [CategoryTheory.Category.assoc, hΦ_bar_snd]
        _ = η_bar ≫ g_Pk0 := by rw [hMain]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_bar) ≫
              ((hAff k₀ 1 a).fromSpec ≫ g_Pk0) := by
                dsimp only [η_bar]
                rw [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar) := by
                rw [← (hCoord k₀ 1).2.2.1 a, ← AlgebraicGeometry.Spec.map_comp,
                  ← CommRingCat.ofHom_comp, hχ_bar_c]
    exact ⟨χ_bar, hχ_bar_c, hχ_bar_t, hMain, hSnd⟩

  
  have hChartEquiv :
      ∀ a : Fin 2,
        ∃ e_a : Polynomial k₀ ≃+* ↑(P_k0.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))),
          (∀ c : k₀, e_a (Polynomial.C c) = c_proj k₀ 1 a c) ∧
          e_a Polynomial.X = t_proj k₀ 1 a (1 - a) := by
    intro a
    let D_a := weilProjBasicOpen k₀ 1 a
    let Γ_a := ↑(P_k0.presheaf.obj (Opposite.op D_a))
    let a' : Fin 2 := 1 - a
    have ha' : a' ≠ a := by fin_cases a <;> decide
    let f_to : Polynomial k₀ →+* Γ_a :=
      Polynomial.eval₂RingHom (c_proj k₀ 1 a) (t_proj k₀ 1 a a')
    let v_poly : Fin 2 → Polynomial k₀ := fun b => if b = a then 1 else Polynomial.X
    have hv_poly_a : v_poly a = 1 := if_pos rfl
    obtain ⟨ψ_back, hψ_c, hψ_t⟩ :=
      (hCoord k₀ 1).2.2.2.2.2.2.1 a (Polynomial k₀) Polynomial.C v_poly hv_poly_a
    have h_left : ψ_back.comp f_to = RingHom.id (Polynomial k₀) := by
      apply Polynomial.ringHom_ext
      · intro c
        change ψ_back (Polynomial.eval₂ (c_proj k₀ 1 a) (t_proj k₀ 1 a a') (Polynomial.C c)) =
          Polynomial.C c
        rw [Polynomial.eval₂_C]
        exact RingHom.congr_fun hψ_c c
      · change ψ_back (Polynomial.eval₂ (c_proj k₀ 1 a) (t_proj k₀ 1 a a') Polynomial.X) =
          Polynomial.X
        rw [Polynomial.eval₂_X, hψ_t a']
        exact if_neg ha'
    have h_right : f_to.comp ψ_back = RingHom.id Γ_a := by
      have hsub_gen :
          Set.range (c_proj k₀ 1 a) ∪ Set.range (t_proj k₀ 1 a) ⊆
            (RingHom.eqLocus (f_to.comp ψ_back) (RingHom.id Γ_a) : Set Γ_a) := by
        rintro _ (⟨c, rfl⟩ | ⟨b, rfl⟩)
        · change f_to (ψ_back (c_proj k₀ 1 a c)) = c_proj k₀ 1 a c
          have hc : ψ_back (c_proj k₀ 1 a c) = Polynomial.C c :=
            RingHom.congr_fun hψ_c c
          rw [hc]
          exact Polynomial.eval₂_C (c_proj k₀ 1 a) (t_proj k₀ 1 a a')
        · change f_to (ψ_back (t_proj k₀ 1 a b)) = t_proj k₀ 1 a b
          rw [hψ_t b]
          by_cases hba : b = a
          · subst hba
            dsimp only [v_poly]
            rw [if_pos rfl, map_one, (hCoord k₀ 1).2.2.2.2.1 b]
          · have hb_eq : b = a' := by
              fin_cases a <;> fin_cases b <;> first | contradiction | rfl
            dsimp only [v_poly]
            rw [if_neg hba, hb_eq]
            exact Polynomial.eval₂_X (c_proj k₀ 1 a) (t_proj k₀ 1 a a')
      have htop : (⊤ : Subring Γ_a) ≤ RingHom.eqLocus (f_to.comp ψ_back) (RingHom.id Γ_a) := by
        rw [← (hCoord k₀ 1).2.2.2.2.2.1 a]
        exact Subring.closure_le.mpr hsub_gen
      ext x
      exact htop trivial
    refine ⟨RingEquiv.ofRingHom f_to ψ_back h_right h_left, ?_, ?_⟩
    · intro c
      exact Polynomial.eval₂_C (c_proj k₀ 1 a) (t_proj k₀ 1 a a')
    · exact Polynomial.eval₂_X (c_proj k₀ 1 a) (t_proj k₀ 1 a a')
  choose e_k0 he_k0_C he_k0_X using hChartEquiv

  
  have hDom_chart : ∀ a : Fin 2,
      IsDomain ↑(P_k0.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a))) := fun a =>
    @MulEquiv.isDomain _ (Polynomial k₀) _ _ _ (e_k0 a).symm.toMulEquiv
  haveI hRed_Pk0 : AlgebraicGeometry.IsReduced P_k0 := by
    let hCov : TopologicalSpace.IsOpenCover (weilProjBasicOpen k₀ 1) :=
      TopologicalSpace.IsOpenCover.mk (hCoord k₀ 1).2.1
    let 𝒰 := P_k0.openCoverOfIsOpenCover (weilProjBasicOpen k₀ 1) hCov
    haveI : ∀ a : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X a) := by
      intro a
      change AlgebraicGeometry.IsReduced (weilProjBasicOpen k₀ 1 a).toScheme
      let Γ_a := ↑(P_k0.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a)))
      haveI : IsDomain Γ_a := hDom_chart a
      haveI : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of Γ_a)) :=
        inferInstance
      exact AlgebraicGeometry.isReduced_of_isOpenImmersion (hAff k₀ 1 a).isoSpec.hom
    exact AlgebraicGeometry.IsReduced.of_openCover P_k0 𝒰
  let D_0 := weilProjBasicOpen k₀ 1 0
  let D_1 := weilProjBasicOpen k₀ 1 1
  let Γ_0 := ↑(P_k0.presheaf.obj (Opposite.op D_0))
  haveI hDom_Γ0 : IsDomain Γ_0 := hDom_chart 0
  have hOverlap_ne : ((D_0 : Set ↥P_k0) ∩ (D_1 : Set ↥P_k0)).Nonempty := by
    let t01 : Γ_0 := t_proj k₀ 1 0 1
    have ht01_eq : t01 = e_k0 0 Polynomial.X := (he_k0_X 0).symm
    have ht01_ne : t01 ≠ 0 := by
      rw [ht01_eq]
      intro h0
      exact Polynomial.X_ne_zero ((e_k0 0).injective (h0.trans (map_zero (e_k0 0)).symm))
    let W_01 : P_k0.Opens := P_k0.basicOpen t01
    have hW01_eq : W_01 = D_0 ⊓ D_1 := (hCoord k₀ 1).2.2.2.2.2.2.2.1 0 1
    have hW01_aff : AlgebraicGeometry.IsAffineOpen W_01 := (hAff k₀ 1 0).basicOpen t01
    let Γ_01 := ↑(P_k0.presheaf.obj (Opposite.op W_01))
    haveI hLoc01 : IsLocalization.Away t01 Γ_01 := (hAff k₀ 1 0).isLocalization_basicOpen t01
    haveI hNontriv01 : Nontrivial Γ_01 := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have halg : algebraMap Γ_0 Γ_01 0 = algebraMap Γ_0 Γ_01 1 := by
        simpa using h01
      obtain ⟨⟨c, n, rfl⟩, hc⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers t01) Γ_01).mp halg
      dsimp at hc
      rw [mul_zero, mul_one] at hc
      exact pow_ne_zero n ht01_ne hc.symm
    obtain ⟨z_01⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNontriv01
    let x_01 : ↥P_k0 := hW01_aff.fromSpec.base z_01
    have hx_W01 : x_01 ∈ (W_01 : Set ↥P_k0) := by
      rw [← hW01_aff.range_fromSpec]
      exact ⟨z_01, rfl⟩
    rw [hW01_eq] at hx_W01
    exact ⟨x_01, hx_W01⟩
  obtain ⟨x_01, hx_01_0, hx_01_1⟩ := hOverlap_ne
  have hPre_chart : ∀ a : Fin 2, IsPreirreducible (weilProjBasicOpen k₀ 1 a : Set ↥P_k0) := by
    intro a
    let Γ_a := ↑(P_k0.presheaf.obj (Opposite.op (weilProjBasicOpen k₀ 1 a)))
    haveI : IsDomain Γ_a := hDom_chart a
    haveI : IrreducibleSpace (PrimeSpectrum Γ_a) := PrimeSpectrum.irreducibleSpace
    have hrange : (weilProjBasicOpen k₀ 1 a : Set ↥P_k0) =
        (hAff k₀ 1 a).fromSpec.base '' Set.univ := by
      rw [Set.image_univ, (hAff k₀ 1 a).range_fromSpec]
    rw [hrange]
    exact PreirreducibleSpace.isPreirreducible_univ.image _
      (hAff k₀ 1 a).fromSpec.continuous.continuousOn
  have hMemChart : ∀ y : ↥P_k0, ∃ a : Fin 2, y ∈ weilProjBasicOpen k₀ 1 a := by
    intro y
    have hy_top : y ∈ (⊤ : P_k0.Opens) := trivial
    rw [← (hCoord k₀ 1).2.1, TopologicalSpace.Opens.mem_iSup] at hy_top
    exact hy_top
  haveI hIrred_Pk0 : IrreducibleSpace ↥P_k0 := by
    have hMeet0 : ∀ u : Set ↥P_k0, IsOpen u → u.Nonempty → ((D_0 : Set ↥P_k0) ∩ u).Nonempty := by
      intro u hu ⟨y, hy_u⟩
      obtain ⟨a, hy_a⟩ := hMemChart y
      fin_cases a
      · exact ⟨y, hy_a, hy_u⟩
      · obtain ⟨w, _hw1, hw0, hwu⟩ :=
          hPre_chart 1 (D_0 : Set ↥P_k0) u D_0.isOpen hu
            ⟨x_01, hx_01_1, hx_01_0⟩ ⟨y, hy_a, hy_u⟩
        exact ⟨w, hw0, hwu⟩
    refine { isPreirreducible_univ := ?_, toNonempty := ⟨x_01⟩ }
    intro u v hu hv hne_u hne_v
    rw [Set.univ_inter] at hne_u hne_v ⊢
    obtain ⟨w, _hw0, hwu, hwv⟩ :=
      hPre_chart 0 u v hu hv (hMeet0 u hu hne_u) (hMeet0 v hv hne_v)
    exact ⟨w, hwu, hwv⟩
  haveI hInt_Pk0 : AlgebraicGeometry.IsIntegral P_k0 :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P_k0

  
  let u_Z : F := (t - φ_LF α_Z) * (φ_LF π_Z)⁻¹
