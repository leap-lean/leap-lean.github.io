              exact ⟨w, hwU, hwO₂⟩
            · exact ⟨x, hxU, hxO₂⟩
          obtain ⟨w, hwU, hwO₁, hwO₂⟩ := hIrred_Uq.isPreirreducible O₁ O₂ hO₁ hO₂ hUq_O₁ hUq_O₂
          exact ⟨w, Or.inr hwU, hwO₁, hwO₂⟩
        have hSub_E : U_q ⊆ E₀ := by
          intro x hxU
          exact hE₀.2 hIrred_union Set.subset_union_left (Or.inr hxU)
        have hCl_sub : closure U_q ⊆ E₀ := closure_minimal hSub_E hClosedE
        apply Set.Subset.antisymm _ hCl_sub
        intro x hxE
        by_contra hx_not_cl
        obtain ⟨w, _hwE, hwU, hwNotCl⟩ :=
          hE₀.1.isPreirreducible U_q (closure U_q)ᶜ hOpen_Uq isClosed_closure.isOpen_compl
            ⟨q, hqE₀, hq_in_Uq⟩ ⟨x, hxE, hx_not_cl⟩
        exact hwNotCl (subset_closure hwU)
      rw [hEq_closure E₁ hE₁ hq₁, hEq_closure E₂ hE₂ hq₂]
    
    let Δ_EQ : Set ↥Y_Q :=
      {q ∈ E_Q | ∃ E' ∈ irreducibleComponents ↥Y_Q, E' ≠ E_Q ∧ q ∈ E'}
    let M_EQ : Set (Fin n) :=
      {j : Fin n | ∃ q ∈ E_Q, fst_Q.base q ∈ Set.range (τ_cur j).base}
    have hNotDelta : ∀ (j : Fin n) (q : ↥Y_Q),
        q ∈ E_Q → fst_Q.base q ∈ Set.range (τ_cur j).base → q ∉ Δ_EQ := by
      rintro j q hqE ⟨b_j, hb_j⟩ ⟨_, E_oth, hE_oth_mem, hE_oth_ne, hq_oth⟩
      obtain ⟨V_sm, hmem_Vsm, hSm_V⟩ := hSm_τ j b_j
      let W_sm : Y_Q.Opens := (TopologicalSpace.Opens.map fst_Q.base).obj V_sm
      have hq_Wsm : q ∈ W_sm := by
        change fst_Q.base q ∈ V_sm
        rw [← hb_j]
        exact hmem_Vsm
      have hPb_sm : CategoryTheory.IsPullback
          (fst_Q ∣_ V_sm) (W_sm.ι ≫ p_Q) (V_sm.ι ≫ g_cur) s_Q :=
        (AlgebraicGeometry.isPullback_morphismRestrict fst_Q V_sm).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback g_cur s_Q)
      have hSm_W : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ p_Q) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hPb_sm hSm_V
      exact hE_oth_ne (hSmoothUniq q W_sm hq_Wsm hSm_W E_oth E_Q hE_oth_mem hEQ_mem hq_oth hqE)
    let IsSpecK' : ↥Y_K' → Prop := fun y =>
      (∃ E_c ∈ irreducibleComponents ↥Y_K', E_c ≠ E ∧ y ∈ E_c) ∨
      (∃ j : Fin n, fst_s.base y ∈ Set.range (τ_cur j).base)
    have hNo3' : ∀ y₁ y₂ y₃ : ↥Y_K',
        y₁ ≠ y₂ → y₁ ≠ y₃ → y₂ ≠ y₃ →
        y₁ ∈ E → y₂ ∈ E → y₃ ∈ E →
        IsSpecK' y₁ → IsSpecK' y₂ → IsSpecK' y₃ → False := by
      intro y₁ y₂ y₃ h12 h13 h23 hy₁E hy₂E hy₃E hs₁ hs₂ hs₃
      apply hNo3
      refine ⟨y₁, y₂, y₃, h12, h13, h23, hy₁E, hy₂E, hy₃E, ?_⟩
      intro q hq
      rcases hq with rfl | rfl | hq3
      · exact hs₁
      · exact hs₂
      · rw [Set.mem_singleton_iff.mp hq3]; exact hs₃
    let liftPt : ↥Y_Q → ↥Y_K' := Function.surjInv hSurj_π
    have hπ_lift : ∀ q : ↥Y_Q, π.base (liftPt q) = q := Function.surjInv_eq hSurj_π
    have hInj_lift : Function.Injective liftPt := Function.injective_surjInv hSurj_π
    have hLift_E : ∀ q ∈ E_Q, liftPt q ∈ E := by
      intro q hq
      rw [← hPre_EQ]
      change π.base (liftPt q) ∈ E_Q
      rw [hπ_lift q]
      exact hq
    have hLift_Δ_spec : ∀ q ∈ Δ_EQ, IsSpecK' (liftPt q) := by
      rintro q ⟨_hqE, E_oth, hE_oth, hne_oth, hq_oth⟩
      exact Or.inl (hLiftOther E_oth hE_oth hne_oth q hq_oth (liftPt q) (hπ_lift q))
    choose q_sec hq_sec_E hq_sec_range using fun j : ↥M_EQ => j.2
    let secPt : ↥M_EQ → ↥Y_K' := fun j => liftPt (q_sec j)
    have hSec_E : ∀ j : ↥M_EQ, secPt j ∈ E := fun j => hLift_E (q_sec j) (hq_sec_E j)
    have hSec_spec : ∀ j : ↥M_EQ, IsSpecK' (secPt j) := by
      intro j
      refine Or.inr ⟨j.1, ?_⟩
      change fst_s.base (liftPt (q_sec j)) ∈ Set.range (τ_cur j.1).base
      rw [← hfst_π]
      change fst_Q.base (π.base (liftPt (q_sec j))) ∈ Set.range (τ_cur j.1).base
      rw [hπ_lift]
      exact hq_sec_range j
    have hSec_ne_Δ : ∀ (j : ↥M_EQ) (q : ↥Y_Q), q ∈ Δ_EQ → secPt j ≠ liftPt q := by
      intro j q hq heq
      have hq_eq : q_sec j = q := hInj_lift heq
      exact hNotDelta j.1 (q_sec j) (hq_sec_E j) (hq_sec_range j) (hq_eq ▸ hq)
    have hSec_inj : ∀ j₁ j₂ : ↥M_EQ, j₁.1 ≠ j₂.1 → secPt j₁ ≠ secPt j₂ := by
      intro j₁ j₂ hj12 heq
      have hq_eq : q_sec j₁ = q_sec j₂ := hInj_lift heq
      have hmem1 : fst_Q.base (q_sec j₁) ∈ Set.range (τ_cur j₁.1).base := hq_sec_range j₁
      have hmem2 : fst_Q.base (q_sec j₁) ∈ Set.range (τ_cur j₂.1).base := by
        rw [hq_eq]; exact hq_sec_range j₂
      exact Set.disjoint_left.mp (hDisj_τ hj12) hmem1 hmem2
    have hCardFin : Δ_EQ.Finite ∧ Δ_EQ.ncard + M_EQ.ncard ≤ 2 := by
      by_cases hΔ_ne : Δ_EQ.Nonempty
      · rcases hΔ_ne with ⟨a₁, ha₁⟩
        by_cases hΔ_sub1 : Δ_EQ ⊆ {a₁}
        · have hΔ_eq : Δ_EQ = {a₁} :=
            Set.Subset.antisymm hΔ_sub1 (Set.singleton_subset_iff.mpr ha₁)
          refine ⟨hΔ_eq ▸ Set.finite_singleton a₁, ?_⟩
          rw [hΔ_eq, Set.ncard_singleton]
          have hM_le1 : M_EQ.ncard ≤ 1 := by
            by_contra hgt
            have h1lt : 1 < M_EQ.ncard := by omega
            obtain ⟨j₁, j₂, hj₁, hj₂, hj12⟩ := (Set.one_lt_ncard_iff M_EQ.toFinite).mp h1lt
            exact hNo3' (liftPt a₁) (secPt ⟨j₁, hj₁⟩) (secPt ⟨j₂, hj₂⟩)
              (hSec_ne_Δ ⟨j₁, hj₁⟩ a₁ ha₁).symm
              (hSec_ne_Δ ⟨j₂, hj₂⟩ a₁ ha₁).symm
              (hSec_inj ⟨j₁, hj₁⟩ ⟨j₂, hj₂⟩ hj12)
              (hLift_E a₁ ha₁.1) (hSec_E ⟨j₁, hj₁⟩) (hSec_E ⟨j₂, hj₂⟩)
              (hLift_Δ_spec a₁ ha₁) (hSec_spec ⟨j₁, hj₁⟩) (hSec_spec ⟨j₂, hj₂⟩)
          omega
        · obtain ⟨a₂, ha₂, ha21⟩ := Set.not_subset.mp hΔ_sub1
          have ha12 : a₁ ≠ a₂ := fun h => ha21 (Set.mem_singleton_iff.mpr h.symm)
          have hΔ_eq : Δ_EQ = {a₁, a₂} := by
            apply Set.Subset.antisymm
            · intro a₃ ha₃
              by_contra hnot
              simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] at hnot
              exact hNo3' (liftPt a₁) (liftPt a₂) (liftPt a₃)
                (fun h => ha12 (hInj_lift h))
                (fun h => hnot.1 (hInj_lift h).symm)
                (fun h => hnot.2 (hInj_lift h).symm)
                (hLift_E a₁ ha₁.1) (hLift_E a₂ ha₂.1) (hLift_E a₃ ha₃.1)
                (hLift_Δ_spec a₁ ha₁) (hLift_Δ_spec a₂ ha₂) (hLift_Δ_spec a₃ ha₃)
            · intro x hx
              rcases hx with rfl | h2
              · exact ha₁
              · rw [Set.mem_singleton_iff.mp h2]; exact ha₂
          refine ⟨hΔ_eq ▸ ((Set.finite_singleton a₂).insert a₁), ?_⟩
          rw [hΔ_eq, Set.ncard_pair ha12]
          have hM_empty : M_EQ = ∅ := by
            ext j
            simp only [Set.mem_empty_iff_false, iff_false]
            intro hj
            exact hNo3' (liftPt a₁) (liftPt a₂) (secPt ⟨j, hj⟩)
              (fun h => ha12 (hInj_lift h))
              (hSec_ne_Δ ⟨j, hj⟩ a₁ ha₁).symm
              (hSec_ne_Δ ⟨j, hj⟩ a₂ ha₂).symm
              (hLift_E a₁ ha₁.1) (hLift_E a₂ ha₂.1) (hSec_E ⟨j, hj⟩)
              (hLift_Δ_spec a₁ ha₁) (hLift_Δ_spec a₂ ha₂) (hSec_spec ⟨j, hj⟩)
          rw [hM_empty, Set.ncard_empty]
      · have hΔ_eq : Δ_EQ = ∅ := Set.not_nonempty_iff_eq_empty.mp hΔ_ne
        refine ⟨hΔ_eq ▸ Set.finite_empty, ?_⟩
        rw [hΔ_eq, Set.ncard_empty, zero_add]
        by_contra hgt
        have h1lt : 1 < M_EQ.ncard := by omega
        obtain ⟨j₁, j₂, hj₁, hj₂, hj12⟩ := (Set.one_lt_ncard_iff M_EQ.toFinite).mp h1lt
        have hnot_sub : ¬ M_EQ ⊆ {j₁, j₂} := by
          intro hsub
          have hle2 : M_EQ.ncard ≤ 2 := by
            calc M_EQ.ncard ≤ ({j₁, j₂} : Set (Fin n)).ncard :=
                  Set.ncard_le_ncard hsub (Set.toFinite _)
              _ = 2 := Set.ncard_pair hj12
          omega
        obtain ⟨j₃, hj₃, hj₃_not⟩ := Set.not_subset.mp hnot_sub
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] at hj₃_not
        exact hNo3' (secPt ⟨j₁, hj₁⟩) (secPt ⟨j₂, hj₂⟩) (secPt ⟨j₃, hj₃⟩)
          (hSec_inj ⟨j₁, hj₁⟩ ⟨j₂, hj₂⟩ hj12)
          (hSec_inj ⟨j₁, hj₁⟩ ⟨j₃, hj₃⟩ (Ne.symm hj₃_not.1))
          (hSec_inj ⟨j₂, hj₂⟩ ⟨j₃, hj₃⟩ (Ne.symm hj₃_not.2))
          (hSec_E ⟨j₁, hj₁⟩) (hSec_E ⟨j₂, hj₂⟩) (hSec_E ⟨j₃, hj₃⟩)
          (hSec_spec ⟨j₁, hj₁⟩) (hSec_spec ⟨j₂, hj₂⟩) (hSec_spec ⟨j₃, hj₃⟩)
    exact ⟨Q, x_Q, E_Q, hQ_ne, hx_Q_pt, hEQ_mem,
      ⟨E_Q_sch, ιE_Q, isoP1_Q, hClEQ, hIntEQ, hRangeEQ, hIsoP1_Q⟩,
      hContr_EQ, hCardFin.1, hCardFin.2⟩

theorem weil_valuation_section_closedPoint_and_rankOne_step_chain (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (hfdom_g : f_dom_cur ≫ U'.ι ≫ g' = g_cur)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (Q : PrimeSpectrum ↥V) (x_Q : ↥U'.toScheme)
    (E_Q : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField)))))
    (hExc_Q : IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur Q x_Q E_Q) :
    ∃ (P : PrimeSpectrum ↥V) (x₀ : ↥U'.toScheme) (k : ℕ)
      (Q_seq : Fin (k + 1) → PrimeSpectrum ↥V)
      (x_seq : Fin (k + 1) → ↥U'.toScheme),
      P.asIdeal ≠ ⊥ ∧
      IsClosed ({x₀} : Set ↥U'.toScheme) ∧
      (U'.ι ≫ g').base x₀ = P ∧
      Q_seq 0 = Q ∧
      x_seq 0 = x_Q ∧
      Q_seq (Fin.last k) = P ∧
      x_seq (Fin.last k) = x₀ ∧
      (∀ i : Fin (k + 1),
        (Q_seq i).asIdeal ≠ ⊥ ∧ (U'.ι ≫ g').base (x_seq i) = Q_seq i) ∧
      (∀ ν : Fin k,
        let Q_b := Q_seq ν.castSucc
        let Q_s := Q_seq ν.succ
        let L_ν := Q_b.asIdeal.ResidueField
        let κ_s := Q_s.asIdeal.ResidueField
        ∃ (W₀ : ValuationSubring L_ν)
          (ρ_V : ↥V →+* ↥W₀)
          (ψ_s : κ_s ≃+* (IsLocalRing.maximalIdeal ↥W₀).ResidueField)
          (σ_ν : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ U'.toScheme),
          IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥ ∧
          (∀ P' : PrimeSpectrum ↥W₀,
            P'.asIdeal = ⊥ ∨ P'.asIdeal = IsLocalRing.maximalIdeal ↥W₀) ∧
          W₀.subtype.comp ρ_V = algebraMap ↥V L_ν ∧
          RingHom.ker ρ_V = Q_b.asIdeal ∧
          (IsLocalRing.maximalIdeal ↥W₀).comap ρ_V = Q_s.asIdeal ∧
          AlgebraicGeometry.IsPreimmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) ∧
          (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField).comp ρ_V =
            ψ_s.toRingHom.comp (algebraMap ↥V κ_s) ∧
          σ_ν ≫ U'.ι ≫ g' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V) ∧
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L_ν)),
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ σ_ν).base pt =
              x_seq ν.castSucc) ∧
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥W₀).ResidueField)),
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField)) ≫
                σ_ν).base pt = x_seq ν.succ)) :=
by
  classical
  have : AlgebraicGeometry.IsProper g' := hMod'.2.2.1
  have : Q.asIdeal.IsPrime := Q.isPrime
  
  let κ_Q := Q.asIdeal.ResidueField
  let s_Q := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ_Q))
  have hξ₀_ex : ∃ ξ₀ : AlgebraicGeometry.Spec (CommRingCat.of κ_Q) ⟶
      (weilProjectiveSpaceOver κ_Q 1).left,
      ξ₀ ≫ (weilProjectiveSpaceOver κ_Q 1).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ_Q)) := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) κ_Q
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let X_κ := AlgebraicGeometry.Spec (CommRingCat.of κ_Q)
    let ev : MvPolynomial (Fin (1 + 1)) κ_Q →+* κ_Q :=
      MvPolynomial.eval₂Hom (RingHom.id κ_Q) ![1, 0]
    let f_glob : MvPolynomial (Fin (1 + 1)) κ_Q →+* ↑Γ(X_κ, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of κ_Q)).inv.hom.comp ev
    have hf_glob : Ideal.map f_glob (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤ := by
      rw [Ideal.eq_top_iff_one]
      have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) κ_Q) ∈
          HomogeneousIdeal.irrelevant 𝒜 := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne 𝒜 (MvPolynomial.isHomogeneous_X κ_Q 0) (by decide)
      have hfX0 : f_glob (MvPolynomial.X 0) = 1 := by simp [f_glob, ev]
      rw [← hfX0]
      exact Ideal.mem_map_of_mem f_glob hX0
    refine ⟨AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_glob hf_glob, ?_⟩
    change AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_glob hf_glob ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ_Q ↥(𝒜 0)))) = 𝟙 X_κ
    rw [AlgebraicGeometry.Proj.fromOfGlobalSections_toSpecZero_assoc 𝒜 f_glob hf_glob,
      ← AlgebraicGeometry.Spec.map_comp]
    have hcomp : CommRingCat.ofHom (algebraMap κ_Q ↥(𝒜 0)) ≫
        CommRingCat.ofHom (f_glob.comp (algebraMap ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) κ_Q))) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of κ_Q)).inv := by
      refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
      change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of κ_Q)).inv.hom
        (ev (MvPolynomial.C r)) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of κ_Q)).inv.hom r
      simp [ev]
    rw [hcomp]
    have hiso_inv : X_κ.isoSpec.inv =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of κ_Q)).inv := by
      rw [AlgebraicGeometry.Scheme.isoSpec_Spec]
      rfl
    rw [← hiso_inv]
    have hleft := AlgebraicGeometry.Scheme.isoSpec_inv_toSpecΓ X_κ
    calc X_κ.toSpecΓ ≫ X_κ.isoSpec.inv
        = (X_κ.isoSpec.hom ≫ X_κ.isoSpec.inv) ≫ X_κ.toSpecΓ ≫ X_κ.isoSpec.inv := by
          rw [X_κ.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp]
      _ = X_κ.isoSpec.hom ≫ (X_κ.isoSpec.inv ≫ X_κ.toSpecΓ) ≫ X_κ.isoSpec.inv := by
          simp only [CategoryTheory.Category.assoc]
      _ = 𝟙 X_κ := by
          rw [hleft, CategoryTheory.Category.id_comp, X_κ.isoSpec.hom_inv_id]
  obtain ⟨ξ₀, hξ₀⟩ := hξ₀_ex
  obtain ⟨hQ_ne, _hxQ_over, _hEQ_irred, ⟨E_sch, ιE, isoP1, _hCl_E, _hInt_E, hRange_E, hIso_E⟩,
      hContr_E, _hΔ_fin, _hSum_E⟩ := hExc_Q
  let x_tilde : AlgebraicGeometry.Spec (CommRingCat.of κ_Q) ⟶ U'.toScheme :=
    ξ₀ ≫ isoP1.inv ≫ ιE ≫ CategoryTheory.Limits.pullback.fst g_cur s_Q ≫ f_dom_cur
  have hx_tilde_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ_Q)),
      x_tilde.base pt = x_Q := by
    intro pt
    change f_dom_cur.base
      ((CategoryTheory.Limits.pullback.fst g_cur s_Q).base
        (ιE.base (isoP1.inv.base (ξ₀.base pt)))) = x_Q
    apply hContr_E
    rw [← hRange_E]
    exact ⟨isoP1.inv.base (ξ₀.base pt), rfl⟩
  have hx_tilde_comm : (x_tilde ≫ U'.ι) ≫ g' = s_Q := by
    dsimp only [x_tilde]
    simp only [CategoryTheory.Category.assoc]
    rw [hfdom_g, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc ιE, hIso_E,
      CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
      ← CategoryTheory.Category.assoc ξ₀, hξ₀, CategoryTheory.Category.id_comp]
  let A_Q := ↥V ⧸ Q.asIdeal
  let π_Q : ↥V →+* A_Q := Ideal.Quotient.mk Q.asIdeal
  let ι_AQ : AlgebraicGeometry.Spec (CommRingCat.of A_Q) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_Q)
  have : ValuationRing A_Q := by
    rw [ValuationRing.iff_dvd_total]
    refine ⟨fun abar bbar => ?_⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective bbar
    rcases ValuationRing.dvd_total a b with ⟨c, rfl⟩ | ⟨c, rfl⟩
    · exact Or.inl ⟨π_Q c, map_mul π_Q a c⟩
    · exact Or.inr ⟨π_Q c, map_mul π_Q b c⟩
  have hsQ_fac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_Q κ_Q)) ≫ ι_AQ = s_Q := by
    dsimp only [ι_AQ, s_Q]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  have hEx_g' : AlgebraicGeometry.ValuativeCriterion.Existence g' :=
    AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap g'
      (CategoryTheory.MorphismProperty.universally_mono
        (fun _ _ f hf => IsClosedMap.specializingMap hf) g'
        ((AlgebraicGeometry.universallyClosed_iff g').mp inferInstance))
  let sq : AlgebraicGeometry.ValuativeCommSq g' :=
    AlgebraicGeometry.ValuativeCommSq.mk A_Q κ_Q (x_tilde ≫ U'.ι) ι_AQ
      ⟨hx_tilde_comm.trans hsQ_fac.symm⟩
  have : sq.commSq.HasLift := hEx_g' sq
  let σ_Q : AlgebraicGeometry.Spec (CommRingCat.of A_Q) ⟶ C' := sq.commSq.lift
  have hσQ_left : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_Q κ_Q)) ≫ σ_Q =
      x_tilde ≫ U'.ι := sq.commSq.fac_left
  have hσQ_right : σ_Q ≫ g' = ι_AQ := sq.commSq.fac_right
  have hCl_ιAQ : AlgebraicGeometry.IsClosedImmersion ι_AQ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_Q)
      Ideal.Quotient.mk_surjective
  have : AlgebraicGeometry.IsClosedImmersion (σ_Q ≫ g') := by
    rw [hσQ_right]; exact hCl_ιAQ
  have hCl_σQ : AlgebraicGeometry.IsClosedImmersion σ_Q :=
    AlgebraicGeometry.IsClosedImmersion.of_comp σ_Q g'
  let pt₀_Q : PrimeSpectrum κ_Q := ⊥
  let q₀ : PrimeSpectrum A_Q :=
    PrimeSpectrum.comap (algebraMap A_Q κ_Q) pt₀_Q
  have hq₀_bot : q₀.asIdeal = ⊥ := by
    change ((⊥ : PrimeSpectrum κ_Q).asIdeal).comap (algebraMap A_Q κ_Q) = ⊥
    rw [PrimeSpectrum.asIdeal_bot, ← RingHom.ker_eq_comap_bot]
    exact (RingHom.injective_iff_ker_eq_bot _).mp
      (Ideal.injective_algebraMap_quotient_residueField Q.asIdeal)
  have hq₀_img : σ_Q.base q₀ = U'.ι.base x_Q := by
    have happ := congrArg (fun f => f.base pt₀_Q) hσQ_left
    change σ_Q.base q₀ = U'.ι.base (x_tilde.base pt₀_Q) at happ
    rw [hx_tilde_pt pt₀_Q] at happ
    exact happ

  
  have htot_V : ∀ R₁ R₂ : PrimeSpectrum ↥V, R₁ ≤ R₂ ∨ R₂ ≤ R₁ := by
    intro R₁ R₂
    by_contra! hnot
    obtain ⟨h12, h21⟩ := hnot
    rw [← PrimeSpectrum.asIdeal_le_asIdeal, SetLike.not_le_iff_exists] at h12 h21
    obtain ⟨a, ha1, ha2⟩ := h12
    obtain ⟨b, hb2, hb1⟩ := h21
    rcases ValuationRing.dvd_total a b with ⟨c, rfl⟩ | ⟨c, rfl⟩
    · exact hb1 (R₁.asIdeal.mul_mem_right c ha1)
    · exact ha2 (R₂.asIdeal.mul_mem_right c hb2)
  let _ : LinearOrder (PrimeSpectrum ↥V) :=
    { (inferInstance : PartialOrder (PrimeSpectrum ↥V)) with
      le_total := htot_V
      toDecidableLE := Classical.decRel _
      toDecidableEq := Classical.decEq _
      toDecidableLT := Classical.decRel _ }
  let j_Q : PrimeSpectrum A_Q → PrimeSpectrum ↥V := PrimeSpectrum.comap π_Q
  have hjQ_inj : Function.Injective j_Q := by
    intro q₁ q₂ hq
    exact PrimeSpectrum.ext
      (Ideal.comap_injective_of_surjective π_Q Ideal.Quotient.mk_surjective
        (congrArg PrimeSpectrum.asIdeal hq))
  have hjQ_le_iff : ∀ q₁ q₂ : PrimeSpectrum A_Q,
      q₁ ≤ q₂ ↔ j_Q q₁ ≤ j_Q q₂ := by
    intro q₁ q₂
    change q₁.asIdeal ≤ q₂.asIdeal ↔ q₁.asIdeal.comap π_Q ≤ q₂.asIdeal.comap π_Q
    refine ⟨Ideal.comap_mono, fun hle => ?_⟩
    rw [← Ideal.map_comap_of_surjective π_Q Ideal.Quotient.mk_surjective q₁.asIdeal,
      ← Ideal.map_comap_of_surjective π_Q Ideal.Quotient.mk_surjective q₂.asIdeal]
    exact Ideal.map_mono hle
  have hjQ_ge_Q : ∀ qbar : PrimeSpectrum A_Q, Q ≤ j_Q qbar := by
    intro qbar v hv
    change π_Q v ∈ qbar.asIdeal
    have hv0 : π_Q v = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hv
    rw [hv0]
    exact qbar.asIdeal.zero_mem
  have hjQ_surj_ge : ∀ Q' : PrimeSpectrum ↥V, Q.asIdeal ≤ Q'.asIdeal →
      ∃ qbar : PrimeSpectrum A_Q, j_Q qbar = Q' := by
    intro Q' hle
    have : Q'.asIdeal.IsPrime := Q'.isPrime
    have hPrime : (Ideal.map π_Q Q'.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by simpa [Ideal.mk_ker] using hle)
    refine ⟨⟨Ideal.map π_Q Q'.asIdeal, hPrime⟩, PrimeSpectrum.ext ?_⟩
    change (Ideal.map π_Q Q'.asIdeal).comap π_Q = Q'.asIdeal
    rw [Ideal.comap_map_of_surjective' π_Q Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr hle]
  have hq₀_proj : j_Q q₀ = Q := by
    refine PrimeSpectrum.ext ?_
    change q₀.asIdeal.comap π_Q = Q.asIdeal
    rw [hq₀_bot, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  let U_AQ : (AlgebraicGeometry.Spec (CommRingCat.of A_Q)).Opens :=
    (TopologicalSpace.Opens.map σ_Q.base).obj U'
  let U_AQ_set : Set (PrimeSpectrum A_Q) := {qbar : PrimeSpectrum A_Q | σ_Q.base qbar ∈ U'}
  have hq₀_mem_UAQ : q₀ ∈ U_AQ_set := by
    change σ_Q.base q₀ ∈ (U' : Set ↥C')
    rw [hq₀_img, ← AlgebraicGeometry.Scheme.Opens.range_ι U']
    exact ⟨x_Q, rfl⟩
  let C_set : Set (PrimeSpectrum ↥V) := j_Q '' U_AQ_set
  have hQ_mem_C : Q ∈ C_set := ⟨q₀, hq₀_mem_UAQ, hq₀_proj⟩
  have hFin_C : C_set.Finite := hPkg.1.subset (Set.subset_univ _)
  let S_Q : Finset (PrimeSpectrum ↥V) := hFin_C.toFinset
  have hQ_mem_S : Q ∈ S_Q := hFin_C.mem_toFinset.mpr hQ_mem_C
  have hS_ne : S_Q.Nonempty := ⟨Q, hQ_mem_S⟩
  have hS_pos : 1 ≤ S_Q.card := Finset.card_pos.mpr hS_ne
  let k : ℕ := S_Q.card - 1
  have hk_card : S_Q.card = k + 1 := (Nat.sub_add_cancel hS_pos).symm
  let Q_emb : Fin (k + 1) ↪o PrimeSpectrum ↥V := S_Q.orderEmbOfFin hk_card
  let Q_seq : Fin (k + 1) → PrimeSpectrum ↥V := Q_emb
  have hQseq_mem_C : ∀ i : Fin (k + 1), Q_seq i ∈ C_set := by
    intro i
    exact hFin_C.mem_toFinset.mp (Finset.orderEmbOfFin_mem S_Q hk_card i)
  choose qbar_seq hqbar_mem hqbar_proj using hQseq_mem_C
  have hxseq_ex : ∀ i : Fin (k + 1), ∃ x : ↥U'.toScheme,
      U'.ι.base x = σ_Q.base (qbar_seq i) := by
    intro i
    have hmem : σ_Q.base (qbar_seq i) ∈ (U' : Set ↥C') := hqbar_mem i
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι U'] at hmem
    exact hmem
  choose x_seq hx_seq_img using hxseq_ex
  let P : PrimeSpectrum ↥V := Q_seq (Fin.last k)
  let x₀ : ↥U'.toScheme := x_seq (Fin.last k)
  have hQ0 : Q_seq 0 = Q := by
    change (S_Q.orderEmbOfFin hk_card) ⟨0, Nat.succ_pos k⟩ = Q
    rw [Finset.orderEmbOfFin_zero hk_card (Nat.succ_pos k)]
    refine le_antisymm (Finset.min'_le S_Q Q hQ_mem_S) (Finset.le_min' S_Q _ Q ?_)
    intro Q' hQ'
    obtain ⟨qbar, _, rfl⟩ := hFin_C.mem_toFinset.mp hQ'
    exact hjQ_ge_Q qbar
  have hUι_inj : Function.Injective U'.ι.base := U'.ι.isOpenEmbedding.injective
  have hx0 : x_seq 0 = x_Q := by
    apply hUι_inj
    rw [hx_seq_img 0]
    have hqbar0 : qbar_seq 0 = q₀ := by
      apply hjQ_inj
      rw [hqbar_proj 0, hQ0, hq₀_proj]
    rw [hqbar0, hq₀_img]
  have hChain_prop : ∀ i : Fin (k + 1),
      (Q_seq i).asIdeal ≠ ⊥ ∧
      (U'.ι ≫ g').base (x_seq i) = Q_seq i ∧
      Q.asIdeal ≤ (Q_seq i).asIdeal := by
    intro i
    have hQ_le_i : Q.asIdeal ≤ (Q_seq i).asIdeal := by
      change Q ≤ Q_emb i
      rw [← hQ0]
      exact Q_emb.monotone (Fin.zero_le i)
    have hne_i : (Q_seq i).asIdeal ≠ ⊥ := by
      intro hbot
      rw [hbot, le_bot_iff] at hQ_le_i
      exact hQ_ne hQ_le_i
    have hover_i : (U'.ι ≫ g').base (x_seq i) = Q_seq i := by
      change g'.base (U'.ι.base (x_seq i)) = Q_seq i
      rw [hx_seq_img i]
      change (σ_Q ≫ g').base (qbar_seq i) = Q_seq i
      rw [hσQ_right]
      exact hqbar_proj i
    exact ⟨hne_i, hover_i, hQ_le_i⟩
  have hx₀_cl : IsClosed ({x₀} : Set ↥U'.toScheme) := by
    let P_bar : PrimeSpectrum A_Q := qbar_seq (Fin.last k)
    let F_P : Set ↥C' := σ_Q.base '' closure ({P_bar} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of A_Q)))
    have hFP_cl : IsClosed F_P :=
      σ_Q.isClosedEmbedding.isClosedMap _ isClosed_closure
    have hpre_cl : IsClosed (U'.ι.base ⁻¹' F_P) :=
      hFP_cl.preimage U'.ι.base.hom.continuous
    have hset_eq : ({x₀} : Set ↥U'.toScheme) = U'.ι.base ⁻¹' F_P := by
      ext x
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        exact ⟨P_bar, subset_closure rfl, (hx_seq_img (Fin.last k)).symm⟩
      · rintro ⟨qbar, hqbar_cl, hσq_eq⟩
        let qbar' : PrimeSpectrum A_Q := qbar
        have hqbar'_cl : qbar' ∈ closure ({P_bar} : Set (PrimeSpectrum A_Q)) := hqbar_cl
        have hPbar_le : P_bar ≤ qbar' :=
          (PrimeSpectrum.le_iff_mem_closure P_bar qbar').mpr hqbar'_cl
        have hP_le : P ≤ j_Q qbar' := by
          change Q_seq (Fin.last k) ≤ j_Q qbar'
          rw [← hqbar_proj (Fin.last k)]
          exact (hjQ_le_iff P_bar qbar').mp hPbar_le
        have hqbar_UAQ : qbar' ∈ U_AQ_set := by
          change σ_Q.base qbar' ∈ (U' : Set ↥C')
          rw [hσq_eq, ← AlgebraicGeometry.Scheme.Opens.range_ι U']
          exact ⟨x, rfl⟩
        have h_mem_S : j_Q qbar' ∈ S_Q :=
          hFin_C.mem_toFinset.mpr ⟨qbar', hqbar_UAQ, rfl⟩
        have hP_max : P = S_Q.max' (by rw [Finset.nonempty_iff_ne_empty]; intro he; simp [he] at hk_card) :=
          Finset.orderEmbOfFin_last hk_card (Nat.succ_pos k)
        have h_le_P : j_Q qbar' ≤ P := by
          rw [hP_max]
          exact Finset.le_max' S_Q (j_Q qbar') h_mem_S
        have hqbar_eq : qbar' = P_bar := by
          apply hjQ_inj
          rw [hqbar_proj (Fin.last k)]
          exact le_antisymm h_le_P hP_le
        apply hUι_inj
        rw [← hσq_eq]
        change σ_Q.base qbar' = U'.ι.base (x_seq (Fin.last k))
        rw [hqbar_eq, ← hx_seq_img (Fin.last k)]
    rw [hset_eq]
    exact hpre_cl
  have hUAQ_open : IsOpen U_AQ_set := U_AQ.isOpen
  have hCov_step : ∀ ν : Fin k,
      (Q_seq ν.castSucc).asIdeal < (Q_seq ν.succ).asIdeal ∧
      ∀ Q' : PrimeSpectrum ↥V,
        (Q_seq ν.castSucc).asIdeal ≤ Q'.asIdeal →
        Q'.asIdeal ≤ (Q_seq ν.succ).asIdeal →
        Q' = Q_seq ν.castSucc ∨ Q' = Q_seq ν.succ := by
    intro ν
    have hlt_ν : (Q_seq ν.castSucc).asIdeal < (Q_seq ν.succ).asIdeal := by
      change Q_emb ν.castSucc < Q_emb ν.succ
      exact Q_emb.strictMono Fin.castSucc_lt_succ
    refine ⟨hlt_ν, fun Q' hle1 hle2 => ?_⟩
    have hQ_le_Q' : Q.asIdeal ≤ Q'.asIdeal := (hChain_prop ν.castSucc).2.2.trans hle1
    obtain ⟨qbar', hqbar'_proj⟩ := hjQ_surj_ge Q' hQ_le_Q'
    have hqbar'_le : qbar' ≤ qbar_seq ν.succ := by
      rw [hjQ_le_iff, hqbar'_proj, hqbar_proj ν.succ]
      exact hle2
    have hspec : Specializes qbar' (qbar_seq ν.succ) :=
      (PrimeSpectrum.le_iff_specializes qbar' (qbar_seq ν.succ)).mp hqbar'_le
    have hqbar'_UAQ : qbar' ∈ U_AQ_set :=
      hspec.mem_open hUAQ_open (hqbar_mem ν.succ)
    have hQ'_mem_S : Q' ∈ (S_Q : Set (PrimeSpectrum ↥V)) := by
      rw [Finset.mem_coe]
      exact hFin_C.mem_toFinset.mpr ⟨qbar', hqbar'_UAQ, hqbar'_proj⟩
    rw [← Finset.range_orderEmbOfFin S_Q hk_card] at hQ'_mem_S
    obtain ⟨j, hj⟩ := hQ'_mem_S
    have hj1 : ν.castSucc ≤ j := by
      rw [← Q_emb.le_iff_le, hj]
      exact hle1
    have hj2 : j ≤ ν.succ := by
      rw [← Q_emb.le_iff_le, hj]
      exact hle2
    have hj_cases : j = ν.castSucc ∨ j = ν.succ := by
      have h1 : (ν : ℕ) ≤ (j : ℕ) := hj1
      have h2 : (j : ℕ) ≤ (ν : ℕ) + 1 := hj2
      rcases Nat.eq_or_lt_of_le h1 with h_eq | h_lt
      · left; apply Fin.ext; simp only [Fin.val_castSucc]; omega
      · right; apply Fin.ext; simp only [Fin.val_succ]; omega
    rcases hj_cases with rfl | rfl
    · exact Or.inl hj.symm
    · exact Or.inr hj.symm

  
  refine ⟨P, x₀, k, Q_seq, x_seq,
    (hChain_prop (Fin.last k)).1, hx₀_cl, (hChain_prop (Fin.last k)).2.1,
    hQ0, hx0, rfl, rfl,
    fun i => ⟨(hChain_prop i).1, (hChain_prop i).2.1⟩, ?_⟩
  intro ν
  let Q_b := Q_seq ν.castSucc
  let Q_s := Q_seq ν.succ
  let L_ν := Q_b.asIdeal.ResidueField
  let κ_s := Q_s.asIdeal.ResidueField
  have : Q_b.asIdeal.IsPrime := Q_b.isPrime
  have : Q_s.asIdeal.IsPrime := Q_s.isPrime
  obtain ⟨hLt, hCov⟩ := hCov_step ν
  let A_b := ↥V ⧸ Q_b.asIdeal
  let π_b : ↥V →+* A_b := Ideal.Quotient.mk Q_b.asIdeal
  let φ : ↥V →+* L_ν := algebraMap ↥V L_ν
  have hφ_fac : φ = (algebraMap A_b L_ν).comp π_b := by
    ext v
    exact (Ideal.algebraMap_quotient_residueField_mk Q_b.asIdeal v).symm
  have hφ_eq_zero : ∀ v : ↥V, φ v = 0 ↔ v ∈ Q_b.asIdeal := by
    intro v
    rw [hφ_fac, RingHom.comp_apply]
    have hinj : Function.Injective (algebraMap A_b L_ν) :=
      Ideal.injective_algebraMap_quotient_residueField Q_b.asIdeal
    rw [← map_zero (algebraMap A_b L_ν), hinj.eq_iff]
    exact Ideal.Quotient.eq_zero_iff_mem
  have hφ_ne_of_notMem_Qs : ∀ s : ↥V, s ∉ Q_s.asIdeal → φ s ≠ 0 := by
    intro s hs h0
    exact hs (hLt.le ((hφ_eq_zero s).mp h0))
  let W₀ : ValuationSubring L_ν :=
    { carrier := {x : L_ν | ∃ a s : ↥V, s ∉ Q_s.asIdeal ∧ x * φ s = φ a}
      mul_mem' := by
        rintro x₁ x₂ ⟨a₁, s₁, hs₁, hx₁⟩ ⟨a₂, s₂, hs₂, hx₂⟩
        refine ⟨a₁ * a₂, s₁ * s₂, Q_s.isPrime.mul_notMem hs₁ hs₂, ?_⟩
        calc (x₁ * x₂) * φ (s₁ * s₂)
            = (x₁ * φ s₁) * (x₂ * φ s₂) := by rw [map_mul]; ring
          _ = φ (a₁ * a₂) := by rw [hx₁, hx₂, map_mul]
      one_mem' := ⟨1, 1, Q_s.isPrime.one_notMem, by simp⟩
      add_mem' := by
        rintro x₁ x₂ ⟨a₁, s₁, hs₁, hx₁⟩ ⟨a₂, s₂, hs₂, hx₂⟩
        refine ⟨a₁ * s₂ + a₂ * s₁, s₁ * s₂, Q_s.isPrime.mul_notMem hs₁ hs₂, ?_⟩
        calc (x₁ + x₂) * φ (s₁ * s₂)
            = (x₁ * φ s₁) * φ s₂ + (x₂ * φ s₂) * φ s₁ := by rw [map_mul]; ring
          _ = φ (a₁ * s₂ + a₂ * s₁) := by rw [hx₁, hx₂, map_add, map_mul, map_mul]
      zero_mem' := ⟨0, 1, Q_s.isPrime.one_notMem, by simp⟩
      neg_mem' := by
        rintro x ⟨a, s, hs, hx⟩
        refine ⟨-a, s, hs, ?_⟩
        rw [neg_mul, hx, map_neg]
      mem_or_inv_mem' := by
        intro z
        obtain ⟨⟨abar, bbar⟩, hzb⟩ := IsLocalization.surj (nonZeroDivisors A_b) z
        dsimp only at hzb
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
        obtain ⟨b, hb_eq⟩ := Ideal.Quotient.mk_surjective bbar.1
        have hb_nzd : π_b b ≠ 0 := by
          rw [hb_eq]
          exact mem_nonZeroDivisors_iff_ne_zero.mp bbar.2
        have hφb_ne : φ b ≠ 0 := by
          rw [ne_eq, hφ_eq_zero, ← Ideal.Quotient.eq_zero_iff_mem]
          exact hb_nzd
        have hzb' : z * φ b = φ a := by
          rw [hφ_fac, RingHom.comp_apply, RingHom.comp_apply, hb_eq]
          exact hzb
        rcases ValuationRing.dvd_total b a with ⟨c, rfl⟩ | ⟨d, rfl⟩
        · left
          have hzc : z = φ c := by
            apply mul_right_cancel₀ hφb_ne
            rw [hzb', map_mul, mul_comm]
          exact ⟨c, 1, Q_s.isPrime.one_notMem, by simp [hzc]⟩
        · by_cases ha_mem : a ∈ Q_b.asIdeal
          · left
            have hφa0 : φ a = 0 := (hφ_eq_zero a).mpr ha_mem
            have hz0 : z = 0 := by
              apply mul_right_cancel₀ hφb_ne
              rw [hzb', hφa0, zero_mul]
            exact ⟨0, 1, Q_s.isPrime.one_notMem, by simp [hz0]⟩
          · right
            have hφa_ne : φ a ≠ 0 := by
              rw [ne_eq, hφ_eq_zero]; exact ha_mem
            have hzd : z * φ d = 1 := by
              apply mul_right_cancel₀ hφa_ne
              calc (z * φ d) * φ a = z * φ (a * d) := by rw [map_mul]; ring
                _ = φ a := hzb'
                _ = 1 * φ a := (one_mul _).symm
            have hz_ne : z ≠ 0 := fun h => by simp [h] at hzd
            have hz_inv : z⁻¹ = φ d := by
              calc z⁻¹ = z⁻¹ * (z * φ d) := by rw [hzd, mul_one]
                _ = φ d := by rw [← mul_assoc, inv_mul_cancel₀ hz_ne, one_mul]
            exact ⟨d, 1, Q_s.isPrime.one_notMem, by simp [hz_inv]⟩ }
  let ρ_V : ↥V →+* ↥W₀ :=
    { toFun := fun v => ⟨φ v, ⟨v, 1, Q_s.isPrime.one_notMem, by simp⟩⟩
      map_one' := Subtype.ext (map_one φ)
      map_mul' := fun x y => Subtype.ext (map_mul φ x y)
      map_zero' := Subtype.ext (map_zero φ)
      map_add' := fun x y => Subtype.ext (map_add φ x y) }
  have hρ_sub : W₀.subtype.comp ρ_V = algebraMap ↥V L_ν := rfl
  have hρ_ker : RingHom.ker ρ_V = Q_b.asIdeal := by
    ext v
    rw [RingHom.mem_ker, Subtype.ext_iff]
    exact hφ_eq_zero v
  let bar_ρ_b : A_b →+* ↥W₀ :=
    Ideal.Quotient.lift Q_b.asIdeal ρ_V (fun v hv => RingHom.mem_ker.mp (hρ_ker.symm ▸ hv))
  have hbar_ρ_comp : bar_ρ_b.comp π_b = ρ_V := RingHom.ext fun _ => rfl
  have hbar_ρ_inj : Function.Injective bar_ρ_b := by
    intro xbar ybar hxy
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xbar
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective ybar
    have hsub : φ x = φ y := congrArg Subtype.val hxy
    have hdiff : x - y ∈ Q_b.asIdeal :=
      (hφ_eq_zero (x - y)).mp (by rw [map_sub, sub_eq_zero]; exact hsub)
    exact Ideal.Quotient.eq.mpr hdiff
  let Qbar_s : Ideal A_b := Ideal.map π_b Q_s.asIdeal
  have hQbar_s_comap : Qbar_s.comap π_b = Q_s.asIdeal := by
    dsimp only [Qbar_s]
    rw [Ideal.comap_map_of_surjective' π_b Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr hLt.le]
  have : Qbar_s.IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by simpa [Ideal.mk_ker] using hLt.le)
  have hLoc_props :
      (IsLocalRing.maximalIdeal ↥W₀).comap ρ_V = Q_s.asIdeal ∧
      AlgebraicGeometry.IsPreimmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) ∧
      Function.Injective (PrimeSpectrum.comap ρ_V) := by
    let _ : Algebra A_b ↥W₀ := bar_ρ_b.toAlgebra
    have halg_eq : algebraMap A_b ↥W₀ = bar_ρ_b := rfl
    have hIsLoc : IsLocalization Qbar_s.primeCompl ↥W₀ := by
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨sbar, hsbar⟩
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective sbar
        have hs_notMem : s ∉ Q_s.asIdeal := by
          rw [← hQbar_s_comap]; exact hsbar
        have hφs : φ s ≠ 0 := hφ_ne_of_notMem_Qs s hs_notMem
        let u_inv : ↥W₀ := ⟨(φ s)⁻¹, ⟨1, s, hs_notMem, by rw [inv_mul_cancel₀ hφs, map_one]⟩⟩
        refine ⟨⟨bar_ρ_b (π_b s), u_inv, ?_, ?_⟩, rfl⟩
        · exact Subtype.ext (mul_inv_cancel₀ hφs)
        · exact Subtype.ext (inv_mul_cancel₀ hφs)
      · intro w
        obtain ⟨a, s, hs_notMem, hws⟩ := w.2
        have hsbar : π_b s ∈ Qbar_s.primeCompl := by
          change π_b s ∉ Qbar_s
          rw [← Ideal.mem_comap, hQbar_s_comap]
          exact hs_notMem
        refine ⟨⟨π_b a, ⟨π_b s, hsbar⟩⟩, ?_⟩
        exact Subtype.ext hws
      · intro xbar ybar hxy
        exact ⟨1, by simp [hbar_ρ_inj hxy]⟩
    have hcomap_max : (IsLocalRing.maximalIdeal ↥W₀).comap ρ_V = Q_s.asIdeal := by
      ext v
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hbar_ρ_comp,
        RingHom.comp_apply, ← halg_eq, IsLocalization.AtPrime.isUnit_to_map_iff ↥W₀ Qbar_s (π_b v)]
      change ¬ (π_b v ∉ Qbar_s) ↔ v ∈ Q_s.asIdeal
      rw [not_not, ← Ideal.mem_comap, hQbar_s_comap]
    have hPre : AlgebraicGeometry.IsPreimmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) := by
      have hfac_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_b ↥W₀)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_b) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, halg_eq, hbar_ρ_comp]
      rw [hfac_spec]
      have : AlgebraicGeometry.IsPreimmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_b ↥W₀))) :=
        AlgebraicGeometry.IsPreimmersion.of_isLocalization Qbar_s.primeCompl
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_b)) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_b)
          Ideal.Quotient.mk_surjective
      infer_instance
    have hinj_comap : Function.Injective (PrimeSpectrum.comap ρ_V) := by
      intro P₁ P₂ hP
      have h1 : (P₁.asIdeal.comap bar_ρ_b).comap π_b = (P₂.asIdeal.comap bar_ρ_b).comap π_b := by
        rw [Ideal.comap_comap, Ideal.comap_comap, hbar_ρ_comp]
        exact congrArg PrimeSpectrum.asIdeal hP
      have h2 : P₁.asIdeal.comap bar_ρ_b = P₂.asIdeal.comap bar_ρ_b :=
        Ideal.comap_injective_of_surjective π_b Ideal.Quotient.mk_surjective h1
      exact PrimeSpectrum.localization_comap_injective ↥W₀ Qbar_s.primeCompl
        (PrimeSpectrum.ext h2)
    exact ⟨hcomap_max, hPre, hinj_comap⟩
  obtain ⟨hρ_comap, hPre_W0, hinj_comap⟩ := hLoc_props
  let m₀ : Ideal ↥W₀ := IsLocalRing.maximalIdeal ↥W₀
  have hm₀_max : m₀.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥W₀
  have : m₀.IsPrime := hm₀_max.isPrime
  have hMax_W₀ : m₀ ≠ ⊥ := by
    obtain ⟨v₀, hv₀_s, hv₀_b⟩ := SetLike.exists_of_lt hLt
    have hv₀_mem : ρ_V v₀ ∈ m₀ := by
      change v₀ ∈ m₀.comap ρ_V
      rw [hρ_comap]
      exact hv₀_s
    have hv₀_ne : ρ_V v₀ ≠ 0 := by
      rw [ne_eq, ← RingHom.mem_ker, hρ_ker]
      exact hv₀_b
    intro hbot
    rw [hbot, Ideal.mem_bot] at hv₀_mem
    exact hv₀_ne hv₀_mem
  have hRank1_W₀ : ∀ P' : PrimeSpectrum ↥W₀, P'.asIdeal = ⊥ ∨ P'.asIdeal = m₀ := by
    intro P'
    let Q' : PrimeSpectrum ↥V := PrimeSpectrum.comap ρ_V P'
    have hle_max : P'.asIdeal ≤ m₀ := IsLocalRing.le_maximalIdeal P'.isPrime.ne_top
    have hQb_le : Q_b.asIdeal ≤ Q'.asIdeal := by
      intro v hv
      have hv0 : ρ_V v = 0 := RingHom.mem_ker.mp (hρ_ker.symm ▸ hv)
      change ρ_V v ∈ P'.asIdeal
      rw [hv0]
      exact P'.asIdeal.zero_mem
    have hQ'_le : Q'.asIdeal ≤ Q_s.asIdeal := by
      change P'.asIdeal.comap ρ_V ≤ Q_s.asIdeal
      rw [← hρ_comap]
      exact Ideal.comap_mono hle_max
    rcases hCov Q' hQb_le hQ'_le with h_eq_b | h_eq_s
    · left
      let P_bot : PrimeSpectrum ↥W₀ := ⊥
      have hcomap_bot : PrimeSpectrum.comap ρ_V P_bot = Q_b :=
        PrimeSpectrum.ext (by
          change ((⊥ : PrimeSpectrum ↥W₀).asIdeal).comap ρ_V = Q_b.asIdeal
          rw [PrimeSpectrum.asIdeal_bot, ← RingHom.ker_eq_comap_bot, hρ_ker])
      exact (congrArg PrimeSpectrum.asIdeal (hinj_comap (h_eq_b.trans hcomap_bot.symm))).trans
        PrimeSpectrum.asIdeal_bot
    · right
      let P_max : PrimeSpectrum ↥W₀ := ⟨m₀, hm₀_max.isPrime⟩
      have hcomap_max' : PrimeSpectrum.comap ρ_V P_max = Q_s :=
        PrimeSpectrum.ext hρ_comap
      exact congrArg PrimeSpectrum.asIdeal (hinj_comap (h_eq_s.trans hcomap_max'.symm))
  
  let k₀ := m₀.ResidueField
  let θ : ↥V →+* k₀ := (algebraMap ↥W₀ k₀).comp ρ_V
  have hbij_quot_k₀ : Function.Bijective (algebraMap (↥W₀ ⧸ m₀) k₀) :=
    Ideal.bijective_algebraMap_quotient_residueField m₀
  have halg_k₀_surj : Function.Surjective (algebraMap ↥W₀ k₀) := by
    intro y
    obtain ⟨wbar, rfl⟩ := hbij_quot_k₀.surjective y
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective wbar
    exact ⟨w, (Ideal.algebraMap_quotient_residueField_mk m₀ w).symm⟩
  have halg_k₀_ker : RingHom.ker (algebraMap ↥W₀ k₀) = m₀ := by
    ext w
    rw [RingHom.mem_ker, ← Ideal.algebraMap_quotient_residueField_mk m₀ w,
      ← map_zero (algebraMap (↥W₀ ⧸ m₀) k₀), hbij_quot_k₀.injective.eq_iff,
      Ideal.Quotient.eq_zero_iff_mem]
  have hθ_ker : RingHom.ker θ = Q_s.asIdeal := by
    ext v
    rw [RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, halg_k₀_ker,
      ← Ideal.mem_comap, hρ_comap]
  let A_s := ↥V ⧸ Q_s.asIdeal
  let bar_θ : A_s →+* k₀ :=
    Ideal.Quotient.lift Q_s.asIdeal θ (fun v hv => RingHom.mem_ker.mp (hθ_ker.symm ▸ hv))
  have hbar_θ_inj : Function.Injective bar_θ := by
    intro xbar ybar hxy
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xbar
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective ybar
    have hdiff : x - y ∈ Q_s.asIdeal := by
      rw [← hθ_ker, RingHom.mem_ker, map_sub, sub_eq_zero]
      exact hxy
    exact Ideal.Quotient.eq.mpr hdiff
  have hunits_s : ∀ y : nonZeroDivisors A_s, IsUnit (bar_θ y.1) := by
    intro y
    refine IsUnit.mk0 (bar_θ y.1) ?_
    rw [ne_eq, ← map_zero bar_θ, hbar_θ_inj.eq_iff]
    exact mem_nonZeroDivisors_iff_ne_zero.mp y.2
  let ψ₀ : κ_s →+* k₀ := IsLocalization.lift (M := nonZeroDivisors A_s) (S := κ_s) hunits_s
  have hψ₀_comm : θ = ψ₀.comp (algebraMap ↥V κ_s) := by
    ext v
    change θ v = ψ₀ (algebraMap ↥V κ_s v)
    rw [← Ideal.algebraMap_quotient_residueField_mk Q_s.asIdeal v, IsLocalization.lift_eq]
    rfl
  have hψ₀_surj : Function.Surjective ψ₀ := by
    intro y
    obtain ⟨w, rfl⟩ := halg_k₀_surj y
    obtain ⟨a, s, hs_notMem, hws⟩ := w.2
    have hw_eq : w * ρ_V s = ρ_V a := Subtype.ext hws
    have hy_eq : algebraMap ↥W₀ k₀ w * θ s = θ a := by
      simpa [θ, map_mul] using congrArg (algebraMap ↥W₀ k₀) hw_eq
    have hθs_ne : θ s ≠ 0 := by
      rw [ne_eq, ← RingHom.mem_ker, hθ_ker]
      exact hs_notMem
    have hκs_ne : algebraMap ↥V κ_s s ≠ 0 := by
      rw [← Ideal.algebraMap_quotient_residueField_mk Q_s.asIdeal s, ne_eq,
        ← map_zero (algebraMap A_s κ_s),
        (Ideal.injective_algebraMap_quotient_residueField Q_s.asIdeal).eq_iff,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hs_notMem
    refine ⟨algebraMap ↥V κ_s a * (algebraMap ↥V κ_s s)⁻¹, ?_⟩
    apply mul_right_cancel₀ hθs_ne
    have hψs : θ s = ψ₀ (algebraMap ↥V κ_s s) :=
      congrFun (congrArg DFunLike.coe hψ₀_comm) s
    have hψa : θ a = ψ₀ (algebraMap ↥V κ_s a) :=
      congrFun (congrArg DFunLike.coe hψ₀_comm) a
    rw [hy_eq, hψs, hψa, ← map_mul, mul_assoc, inv_mul_cancel₀ hκs_ne, mul_one]
  let ψ_s : κ_s ≃+* k₀ := RingEquiv.ofBijective ψ₀ ⟨ψ₀.injective, hψ₀_surj⟩
  have hψ_comm : (algebraMap ↥W₀ k₀).comp ρ_V = ψ_s.toRingHom.comp (algebraMap ↥V κ_s) := by
    ext v
    exact congrFun (congrArg DFunLike.coe hψ₀_comm) v
  
  have hQ_le_Qb : Q.asIdeal ≤ Q_b.asIdeal := (hChain_prop ν.castSucc).2.2
  let ρ_Q : A_Q →+* ↥W₀ :=
    Ideal.Quotient.lift Q.asIdeal ρ_V
      (fun v hv => RingHom.mem_ker.mp (hρ_ker.symm ▸ hQ_le_Qb hv))
  have hρQ_comp : ρ_Q.comp π_Q = ρ_V := RingHom.ext fun _ => rfl
  let f_W0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ C' :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Q) ≫ σ_Q
  have hf_bot : ∀ P' : PrimeSpectrum ↥W₀, P'.asIdeal = ⊥ →
      f_W0.base P' = U'.ι.base (x_seq ν.castSucc) := by
    intro P' hbot
    let q_P' : PrimeSpectrum A_Q := PrimeSpectrum.comap ρ_Q P'
    have hq_eq : q_P' = qbar_seq ν.castSucc := by
      apply hjQ_inj
      rw [hqbar_proj ν.castSucc]
      refine PrimeSpectrum.ext ?_
      change (P'.asIdeal.comap ρ_Q).comap π_Q = Q_b.asIdeal
      rw [Ideal.comap_comap, hρQ_comp, hbot, ← RingHom.ker_eq_comap_bot, hρ_ker]
    change σ_Q.base q_P' = U'.ι.base (x_seq ν.castSucc)
    rw [hq_eq, ← hx_seq_img ν.castSucc]
  have hf_max : ∀ P' : PrimeSpectrum ↥W₀, P'.asIdeal = m₀ →
      f_W0.base P' = U'.ι.base (x_seq ν.succ) := by
    intro P' hmax
    let q_P' : PrimeSpectrum A_Q := PrimeSpectrum.comap ρ_Q P'
    have hq_eq : q_P' = qbar_seq ν.succ := by
      apply hjQ_inj
      rw [hqbar_proj ν.succ]
      refine PrimeSpectrum.ext ?_
      change (P'.asIdeal.comap ρ_Q).comap π_Q = Q_s.asIdeal
      rw [Ideal.comap_comap, hρQ_comp, hmax, hρ_comap]
    change σ_Q.base q_P' = U'.ι.base (x_seq ν.succ)
    rw [hq_eq, ← hx_seq_img ν.succ]
  have hRange_fW0 : Set.range f_W0.base ⊆ Set.range U'.ι.base := by
    rintro _ ⟨P', rfl⟩
    let P'' : PrimeSpectrum ↥W₀ := P'
    rcases hRank1_W₀ P'' with hbot | hmax
    · exact ⟨x_seq ν.castSucc, (hf_bot P'' hbot).symm⟩
    · exact ⟨x_seq ν.succ, (hf_max P'' hmax).symm⟩
  let σ_ν : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ U'.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U'.ι f_W0 hRange_fW0
  have hσν_fac : σ_ν ≫ U'.ι = f_W0 :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U'.ι f_W0 hRange_fW0
  refine ⟨W₀, ρ_V, ψ_s, σ_ν, hMax_W₀, hRank1_W₀, hρ_sub, hρ_ker, hρ_comap,
    hPre_W0, hψ_comm, ?_, ?_, ?_⟩
  · rw [← CategoryTheory.Category.assoc, hσν_fac]
    dsimp only [f_W0]
    rw [CategoryTheory.Category.assoc, hσQ_right]
    dsimp only [ι_AQ]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hρQ_comp]
  · intro pt
    let pt' : PrimeSpectrum L_ν := pt
    have hpt_bot : pt'.asIdeal = ⊥ :=
      Or.resolve_right (Ideal.eq_bot_or_top pt'.asIdeal) pt'.isPrime.ne_top
    let P' : PrimeSpectrum ↥W₀ := PrimeSpectrum.comap W₀.subtype pt'
    have hP'_bot : P'.asIdeal = ⊥ := by
      change pt'.asIdeal.comap W₀.subtype = ⊥
      rw [hpt_bot, ← RingHom.ker_eq_comap_bot]
      exact (RingHom.injective_iff_ker_eq_bot _).mp Subtype.val_injective
    apply hUι_inj
    have happ := congrArg (fun h => h.base P') hσν_fac
    exact happ.trans (hf_bot P' hP'_bot)
  · intro pt
    let pt' : PrimeSpectrum k₀ := pt
    have hpt_bot : pt'.asIdeal = ⊥ :=
      Or.resolve_right (Ideal.eq_bot_or_top pt'.asIdeal) pt'.isPrime.ne_top
    let P' : PrimeSpectrum ↥W₀ := PrimeSpectrum.comap (algebraMap ↥W₀ k₀) pt'
    have hP'_max : P'.asIdeal = m₀ := by
      change pt'.asIdeal.comap (algebraMap ↥W₀ k₀) = m₀
      rw [hpt_bot, ← RingHom.ker_eq_comap_bot, halg_k₀_ker]
    apply hUι_inj
    have happ := congrArg (fun h => h.base P') hσν_fac
    exact happ.trans (hf_max P' hP'_max)

theorem weil_schematic_image_proper_and_generic_p1_iso (K : Type u) [Field K] (V : ValuationSubring K)
    (C' C_cur : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hProp_g' : AlgebraicGeometry.IsProper g')
    (U' : C'.Opens)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (hProp_fdom : AlgebraicGeometry.IsProper f_dom_cur)
    (hfdom_g : f_dom_cur ≫ U'.ι ≫ g' = g_cur)
    (Q_b : PrimeSpectrum ↥V) (x_b x_s : ↥U'.toScheme)
    (W₀ : ValuationSubring Q_b.asIdeal.ResidueField)
    (hMax_W₀ : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1_W₀ : ∀ P' : PrimeSpectrum ↥W₀,
      P'.asIdeal = ⊥ ∨ P'.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (ρ_V : ↥V →+* ↥W₀)
    (hρ_sub : W₀.subtype.comp ρ_V = algebraMap ↥V Q_b.asIdeal.ResidueField)
    (σ_ν : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ U'.toScheme)
    (hσ_comm : σ_ν ≫ U'.ι ≫ g' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V))
    (hσ_gen : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField)),
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ σ_ν).base pt = x_b)
    (hσ_cl : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥W₀).ResidueField)),
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥W₀ (IsLocalRing.maximalIdeal ↥W₀).ResidueField)) ≫
          σ_ν).base pt = x_s)
    (E_cur : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))))
    (E_sch : AlgebraicGeometry.Scheme.{u})
    (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).left)
    (hCl_E : AlgebraicGeometry.IsClosedImmersion ιE)
    (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
    (hRange_E : Set.range ιE.base = E_cur)
    (hIso_E : ιE ≫ CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) =
      isoP1.hom ≫ (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).hom)
    (hContr_E : ∀ q ∈ E_cur,
      f_dom_cur.base ((CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))).base q) = x_b)
    (u_gen : CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ⟶
      CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)))
    (hu_fst : u_gen ≫ CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (hu_snd : u_gen ≫ CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) :
    let ι_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)
    let ℰ := AlgebraicGeometry.Scheme.Hom.image (ιE ≫ u_gen)
    let ι_ℰ := AlgebraicGeometry.Scheme.Hom.imageι (ιE ≫ u_gen)
    let g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) :=
      ι_ℰ ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    AlgebraicGeometry.IsProper g_ℰ ∧
    (∃ isoGen : CategoryTheory.Limits.pullback g_ℰ
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ≅
          (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).left,
      CategoryTheory.Limits.pullback.snd g_ℰ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) =
        isoGen.hom ≫ (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).hom) ∧
    (∀ q_b : ↥(CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))),
      u_gen.base q_b ∈ Set.range ι_ℰ.base ↔ q_b ∈ E_cur) ∧
    (∀ q : ↥(CategoryTheory.Limits.pullback g_ℰ s₀),
      f_dom_cur.base ((CategoryTheory.Limits.pullback.fst g_cur ι_W0).base
        (ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q))) = x_s) :=
by
  intro ι_W0 ℰ ι_ℰ g_ℰ k₀ s₀
  let L := Q_b.asIdeal.ResidueField
  let s_b := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V L))
  let η_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)
  have hη_ι : η_W0 ≫ ι_W0 = s_b := by
    dsimp [η_W0, ι_W0, s_b, L]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hρ_sub]
  have hOpen_η : AlgebraicGeometry.IsOpenImmersion η_W0 := by
    have hex_π : ∃ π₀ : ↥W₀, π₀ ∈ IsLocalRing.maximalIdeal ↥W₀ ∧ π₀ ≠ 0 := by
      by_contra! hall0
      apply hMax_W₀
      rw [eq_bot_iff]
      intro x hx
      rw [Ideal.mem_bot]
      exact hall0 x hx
    obtain ⟨π₀, hπ₀_mem, hπ₀_ne⟩ := hex_π
