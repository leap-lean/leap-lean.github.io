theorem weil_etale_chart_shrinking_and_center_quotient (K : Type u) [Field K]
    (V : ValuationSubring K)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (z : X)
    (P_z : Ideal ↥V) [P_z.IsPrime]
    (hPz_eq : (g_X.base z).asIdeal = P_z)
    (t_z π₁ : ↥V)
    (ht_z : t_z ∉ P_z)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z] [IsLocalization.AtPrime R_z P_z]
    (hπ₁_mem : π₁ ∈ P_z)
    (W : X.Opens) (hz_W : z ∈ W)
    {A_global : CommRingCat.{u}}
    {φ_V : CommRingCat.of ↥V ⟶ A_global}
    (e : W.toScheme ⟶ AlgebraicGeometry.Spec A_global)
    (hEt_e : AlgebraicGeometry.Etale e)
    (he_comm : W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map φ_V)
    (A_loc : CommRingCat.{u})
    (φ_Rz : CommRingCat.of R_z ⟶ A_loc)
    (φ_glob_loc : A_global ⟶ A_loc)
    (hOpen_j : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map φ_glob_loc))
    (hj_range : Set.range (AlgebraicGeometry.Spec.map φ_glob_loc).base =
      {q : ↥(AlgebraicGeometry.Spec A_global) | φ_V.hom t_z ∉ q.asIdeal})
    (hj_comm : φ_V ≫ φ_glob_loc = CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)
    (I_sec : Ideal ↑A_loc)
    (I_base : Ideal R_z)
    (hIBase_ne : I_base ≠ ⊤)
    (hSurj_sec : Function.Surjective ((Ideal.Quotient.mk I_sec).comp φ_Rz.hom))
    (hKer_sec : RingHom.ker ((Ideal.Quotient.mk I_sec).comp φ_Rz.hom) = I_base)
    (hz_sec : ∀ f ∈ I_sec, ∀ q_z : ↥(AlgebraicGeometry.Spec A_loc),
      (AlgebraicGeometry.Spec.map φ_glob_loc).base q_z =
        e.base ⟨z, hz_W⟩ →
      f ∈ q_z.asIdeal)
    (hSecIso : ∀ (C₀ : Type u) [CommRing C₀]
        [Algebra (R_z ⧸ I_base) C₀]
        [Algebra.Etale (R_z ⧸ I_base) C₀]
        (q_z : Ideal C₀) [q_z.IsPrime],
      Ideal.comap (algebraMap ↥V R_z)
        (Ideal.comap (algebraMap R_z (R_z ⧸ I_base))
          (Ideal.comap (algebraMap (R_z ⧸ I_base) C₀) q_z)) = P_z →
      ∃ h : C₀, h ∉ q_z ∧
        Function.Bijective (algebraMap (R_z ⧸ I_base) (Localization.Away h))) :
    ∃ (B' : CommRingCat.{u})
      (j_W : AlgebraicGeometry.Spec B' ⟶ W.toScheme)
      (e_0 : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec A_loc)
      (π_ZB : B' ⟶ CommRingCat.of (R_z ⧸ (I_base ⊔ Ideal.span {algebraMap ↥V R_z π₁})))
      (m_Z : ↥(AlgebraicGeometry.Spec (CommRingCat.of
        (R_z ⧸ (I_base ⊔ Ideal.span {algebraMap ↥V R_z π₁}))))),
      AlgebraicGeometry.IsOpenImmersion j_W ∧
      AlgebraicGeometry.Etale e_0 ∧
      e_0 ≫ AlgebraicGeometry.Spec.map φ_glob_loc = j_W ≫ e ∧
      j_W ≫ W.ι ≫ g_X =
        e_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) ∧
      Function.Surjective π_ZB.hom ∧
      Set.range (AlgebraicGeometry.Spec.map π_ZB).base =
        {p : ↥(AlgebraicGeometry.Spec B') |
          I_sec ⊔ Ideal.span {φ_Rz.hom (algebraMap ↥V R_z π₁)} ≤ (e_0.base p).asIdeal} ∧
      AlgebraicGeometry.Spec.map π_ZB ≫ j_W ≫ W.ι ≫ g_X =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            ((Ideal.Quotient.mk (I_base ⊔ Ideal.span {algebraMap ↥V R_z π₁})).comp
              (algebraMap ↥V R_z))) ∧
      (AlgebraicGeometry.Spec.map π_ZB ≫ j_W ≫ W.ι).base m_Z = z :=
by
  have ht_z_gx : t_z ∉ (g_X.base z).asIdeal := by
