    let β_0 : A_fib →ₐ[↥W] K :=
      ((Pi.evalAlgHom K (fun _ : I => K) i_0).restrictScalars ↥W).comp
        ((e_split.toAlgHom.restrictScalars ↥W).comp ι_AK)
    have hβ_on_C : ∀ c : ↥C, β_0 c.1 = W.subtype (ρ c i_0) := fun _ => rfl
