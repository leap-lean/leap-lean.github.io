        have hX1 : MvPolynomial.X 1 ∉ J11 := by
          change ev11 (MvPolynomial.X 1) ≠ 0
          simp [ev11, Polynomial.X_ne_zero]
        have hNotIrrel11 : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ J11 := by
          intro hle
          apply hX0
          apply hle
          rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
