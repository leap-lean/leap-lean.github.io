      let q_eq := Algebra.TensorProduct.quotIdealMapEquivTensorQuot (↑B₀) I_sec
      have h1 : (Algebra.TensorProduct.comm (↑A_loc) (↑A_loc ⧸ I_sec) (↑B₀))
