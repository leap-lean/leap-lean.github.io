      intro y hy
      have hy_M₁ : φ.base y ∈ M₁ := by
        change hW₁.fromSpec.base (φ.base y) ∈ M_all
        rw [hφ_eq y, hW₁.fromSpec_primeIdealOf (i_WB.base y), hi_WB_val y]
