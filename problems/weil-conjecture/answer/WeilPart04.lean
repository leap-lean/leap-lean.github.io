theorem weil_strictlySemistable_pointed_section_resolution (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (hBl : HasStrictlySemistablePointBlowups V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hι_comm : ι_U' ≫ U'.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ ι')
    (C''_0 : AlgebraicGeometry.Scheme.{u})
    (g''_0 : C''_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_0 : C''_0 ⟶ U'.toScheme)
    (ι_0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C''_0)
    (hSS_0 : IsStrictlySemistableCurveOverValuation V g''_0)
    (hProp_f0 : AlgebraicGeometry.IsProper f_0)
    (hf0_g' : f_0 ≫ U'.ι ≫ g' = g''_0)
    (hι0_f0 : ι_0 ≫ f_0 = ι_U')
    (hPb_0 : CategoryTheory.IsPullback ι_0
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g''_0
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype))) :
    ∃ (C'' : AlgebraicGeometry.Scheme.{u})
      (g'' : C'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_pt : C'' ⟶ C''_0)
      (τ'' : ∀ j : Fin n,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C'')
      (ι_C'' : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C''),
      IsStrictlySemistableCurveOverValuation V g'' ∧
      AlgebraicGeometry.IsProper f_pt ∧
      f_pt ≫ g''_0 = g'' ∧
      ι_C'' ≫ f_pt = ι_0 ∧
      CategoryTheory.IsPullback ι_C''
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
        g''
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      (∀ j : Fin n,
        let S_j : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
          (TopologicalSpace.Opens.map (τ' j).base).obj U'
        (τ'' j ≫ f_pt ≫ f_0) ≫ U'.ι = S_j.ι ≫ τ' j) ∧
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ'' i).base) (Set.range (τ'' j).base)) ∧
      (∀ (j : Fin n)
          (b : AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map (τ' j).base).obj U')),
        ∃ V_sm : C''.Opens,
          (τ'' j).base b ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g'')) :=
by
  
  have hS1 :
      let S_open : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
        fun j => (TopologicalSpace.Opens.map (τ' j).base).obj U'
      (∀ j : Fin n,
        Nonempty ↥(S_open j).toScheme →
        ∃ (P : Ideal ↥V) (_ : P.IsPrime)
          (α : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) ≅ (S_open j).toScheme)
          (m_P : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P))),
