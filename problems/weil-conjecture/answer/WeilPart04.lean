import WeilPart03
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer (B₀ : Type u) [CommRing B₀]
    (t c : B₀)
    (R : Type u) [CommRing R] [Algebra B₀ R] [IsLocalization.Away t R] :
    let Q_B := MvPolynomial (Fin 2) B₀ ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}
    let Q_R := MvPolynomial (Fin 2) R ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (algebraMap B₀ R c)}
    ∃ (Φ : Q_B →+* Q_R),
      Φ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
        ((Ideal.Quotient.mk _).comp MvPolynomial.C).comp (algebraMap B₀ R) ∧
      Φ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = Ideal.Quotient.mk _ (MvPolynomial.X 0) ∧
      Φ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Ideal.Quotient.mk _ (MvPolynomial.X 1) ∧
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ)) ∧
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ)).base =
        {q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Q_B)) |
          Ideal.Quotient.mk _ (MvPolynomial.C t) ∉ q.asIdeal} ∧
      Function.Surjective
        ((Ideal.Quotient.mk
          (Ideal.span
            {(Ideal.Quotient.mk _ (MvPolynomial.X 0) : Q_R),
             (Ideal.Quotient.mk _ (MvPolynomial.X 1) : Q_R)})).comp
          (((Ideal.Quotient.mk _).comp MvPolynomial.C : R →+* Q_R))) ∧
      RingHom.ker
        ((Ideal.Quotient.mk
          (Ideal.span
            {(Ideal.Quotient.mk _ (MvPolynomial.X 0) : Q_R),
             (Ideal.Quotient.mk _ (MvPolynomial.X 1) : Q_R)})).comp
          (((Ideal.Quotient.mk _).comp MvPolynomial.C : R →+* Q_R))) =
        Ideal.span {algebraMap B₀ R c} :=
by
  intro Q_B Q_R
  let ι : B₀ →+* R := algebraMap B₀ R
  let c' : R := ι c
  let F_B : MvPolynomial (Fin 2) B₀ :=
    MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c
  let F_R : MvPolynomial (Fin 2) R :=
    MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c'
  let I_B : Ideal (MvPolynomial (Fin 2) B₀) := Ideal.span {F_B}
  let I_R : Ideal (MvPolynomial (Fin 2) R) := Ideal.span {F_R}
  let f_map : MvPolynomial (Fin 2) B₀ →+* MvPolynomial (Fin 2) R := MvPolynomial.map ι
  have hf_gen : f_map F_B = F_R := by
    dsimp only [f_map, F_B, F_R, c']
    rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C]
  have h_le : I_B ≤ Ideal.comap f_map I_R := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    change f_map F_B ∈ I_R
    rw [hf_gen]
    exact Ideal.mem_span_singleton_self F_R
  let Φ : Q_B →+* Q_R := Ideal.quotientMap I_R f_map h_le
  have hΦ_C :
      Φ.comp ((Ideal.Quotient.mk I_B).comp MvPolynomial.C) =
        ((Ideal.Quotient.mk I_R).comp MvPolynomial.C).comp ι := by
    ext b
    change Ideal.quotientMap I_R f_map h_le (Ideal.Quotient.mk I_B (MvPolynomial.C b)) =
      Ideal.Quotient.mk I_R (MvPolynomial.C (ι b))
    rw [Ideal.quotientMap_mk]
    dsimp only [f_map]
    rw [MvPolynomial.map_C]
  have hΦ_X0 :
      Φ (Ideal.Quotient.mk I_B (MvPolynomial.X 0)) =
        Ideal.Quotient.mk I_R (MvPolynomial.X 0) := by
    change Ideal.quotientMap I_R f_map h_le (Ideal.Quotient.mk I_B (MvPolynomial.X 0)) =
      Ideal.Quotient.mk I_R (MvPolynomial.X 0)
    rw [Ideal.quotientMap_mk]
    dsimp only [f_map]
    rw [MvPolynomial.map_X]
  have hΦ_X1 :
      Φ (Ideal.Quotient.mk I_B (MvPolynomial.X 1)) =
        Ideal.Quotient.mk I_R (MvPolynomial.X 1) := by
    change Ideal.quotientMap I_R f_map h_le (Ideal.Quotient.mk I_B (MvPolynomial.X 1)) =
      Ideal.Quotient.mk I_R (MvPolynomial.X 1)
    rw [Ideal.quotientMap_mk]
    dsimp only [f_map]
    rw [MvPolynomial.map_X]
  letI : Algebra (MvPolynomial (Fin 2) B₀) (MvPolynomial (Fin 2) R) :=
    MvPolynomial.algebraMvPolynomial
  letI : Algebra Q_B Q_R := Φ.toAlgebra
  let M_P : Submonoid (MvPolynomial (Fin 2) B₀) :=
    Submonoid.map MvPolynomial.C (Submonoid.powers t)
  haveI hLocP : IsLocalization M_P (MvPolynomial (Fin 2) R) :=
    MvPolynomial.isLocalization (Submonoid.powers t) R
  have hLocQ_sub : IsLocalization (Submonoid.map (Ideal.Quotient.mk I_B) M_P) Q_R := by
    refine IsLocalization.of_surjective M_P (MvPolynomial (Fin 2) R)
      (Ideal.Quotient.mk I_B) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk I_R) Ideal.Quotient.mk_surjective ?_ ?_
    · rw [MvPolynomial.algebraMap_def]
      exact (Ideal.quotientMap_comp_mk h_le).symm
    · rw [Ideal.mk_ker, Ideal.mk_ker, MvPolynomial.algebraMap_def]
      change I_R ≤ Ideal.map f_map (Ideal.span {F_B})
      rw [Ideal.map_span, Set.image_singleton, hf_gen]
  let d_t : Q_B := Ideal.Quotient.mk I_B (MvPolynomial.C t)
  have hM_eq : Submonoid.map (Ideal.Quotient.mk I_B) M_P = Submonoid.powers d_t := by
    dsimp only [M_P, d_t]
    rw [Submonoid.map_powers, Submonoid.map_powers]
  haveI hLocQ : IsLocalization.Away d_t Q_R := by
    change IsLocalization (Submonoid.powers d_t) Q_R
    rwa [← hM_eq]
  have hOpen_Φ :
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ)) :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization d_t
  have hRange_Φ :
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ)).base =
        {q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Q_B)) | d_t ∉ q.asIdeal} := by
    have hrng : Set.range (PrimeSpectrum.comap (algebraMap Q_B Q_R)) =
        (PrimeSpectrum.basicOpen d_t : Set (PrimeSpectrum Q_B)) :=
      PrimeSpectrum.localization_away_comap_range Q_R d_t
    change Set.range (PrimeSpectrum.comap (algebraMap Q_B Q_R)) =
      {q : PrimeSpectrum Q_B | d_t ∉ q.asIdeal}
    rw [hrng]
    ext q
    exact PrimeSpectrum.mem_basicOpen d_t q
  let J_axes : Ideal Q_R :=
    Ideal.span
      {(Ideal.Quotient.mk I_R (MvPolynomial.X 0) : Q_R),
       (Ideal.Quotient.mk I_R (MvPolynomial.X 1) : Q_R)}
  let π : MvPolynomial (Fin 2) R →+* Q_R ⧸ J_axes :=
    (Ideal.Quotient.mk J_axes).comp (Ideal.Quotient.mk I_R)
  let ψ : R →+* Q_R ⧸ J_axes :=
    (Ideal.Quotient.mk J_axes).comp (((Ideal.Quotient.mk I_R).comp MvPolynomial.C : R →+* Q_R))
  have hπ_X : ∀ i : Fin 2, π (MvPolynomial.X i) = 0 := by
    intro i
    change Ideal.Quotient.mk J_axes (Ideal.Quotient.mk I_R (MvPolynomial.X i)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    fin_cases i
    · exact Ideal.subset_span (Or.inl rfl)
    · exact Ideal.subset_span (Or.inr (Set.mem_singleton _))
  have hπ_eq : π = ψ.comp (MvPolynomial.eval 0) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [π, ψ, RingHom.comp_apply, MvPolynomial.eval_C]
    · intro i
      rw [hπ_X i, RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply, map_zero]
  have hSurj_ψ : Function.Surjective ψ := by
    intro z
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
    refine ⟨MvPolynomial.eval 0 P, ?_⟩
    exact (RingHom.congr_fun hπ_eq P).symm
  have hKer_ψ : RingHom.ker ψ = Ideal.span {c'} := by
    apply le_antisymm
    · intro r hr
      rw [RingHom.mem_ker] at hr
      let K_c : Ideal R := Ideal.span {c'}
      let ε₀ : MvPolynomial (Fin 2) R →+* R ⧸ K_c :=
        (Ideal.Quotient.mk K_c).comp (MvPolynomial.eval 0)
      have hε₀_IR : ∀ p ∈ I_R, ε₀ p = 0 := by
        intro p hp
        rw [← RingHom.mem_ker]
        refine (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)) hp
        change ε₀ F_R = 0
        dsimp only [ε₀, F_R]
        simp only [RingHom.comp_apply, map_sub, map_mul, MvPolynomial.eval_X,
          Pi.zero_apply, map_zero, mul_zero, zero_sub, MvPolynomial.eval_C, neg_eq_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self c')
      let ε₁ : Q_R →+* R ⧸ K_c := Ideal.Quotient.lift I_R ε₀ hε₀_IR
      have hε₁_J : ∀ q ∈ J_axes, ε₁ q = 0 := by
        intro q hq
        rw [← RingHom.mem_ker]
        refine (Ideal.span_le.mpr ?_) hq
        intro y hy
        rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
        rcases hy with rfl | rfl
        · change Ideal.Quotient.lift I_R ε₀ hε₀_IR (Ideal.Quotient.mk I_R (MvPolynomial.X 0)) = 0
          rw [Ideal.Quotient.lift_mk]
          simp only [ε₀, RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply, map_zero]
        · change Ideal.Quotient.lift I_R ε₀ hε₀_IR (Ideal.Quotient.mk I_R (MvPolynomial.X 1)) = 0
          rw [Ideal.Quotient.lift_mk]
          simp only [ε₀, RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply, map_zero]
      let ε₂ : Q_R ⧸ J_axes →+* R ⧸ K_c := Ideal.Quotient.lift J_axes ε₁ hε₁_J
      have h0 : Ideal.Quotient.mk K_c r = 0 := by
        have hε₂_ψ : ε₂ (ψ r) = Ideal.Quotient.mk K_c r := by
          change Ideal.Quotient.lift J_axes ε₁ hε₁_J
            (Ideal.Quotient.mk J_axes (Ideal.Quotient.mk I_R (MvPolynomial.C r))) =
            Ideal.Quotient.mk K_c r
          rw [Ideal.Quotient.lift_mk]
          change Ideal.Quotient.lift I_R ε₀ hε₀_IR (Ideal.Quotient.mk I_R (MvPolynomial.C r)) =
            Ideal.Quotient.mk K_c r
          rw [Ideal.Quotient.lift_mk]
          simp only [ε₀, RingHom.comp_apply, MvPolynomial.eval_C]
        rw [← hε₂_ψ, hr, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp h0
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      have heval_FR : MvPolynomial.eval (0 : Fin 2 → R) F_R = -c' := by
        dsimp only [F_R]
        rw [map_sub, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, MvPolynomial.eval_C]
        simp only [Pi.zero_apply, mul_zero, zero_sub]
      have hπ_FR : π F_R = ψ (-c') := by
        rw [← heval_FR]
        exact RingHom.congr_fun hπ_eq F_R
      calc ψ c'
          = ψ (-(-c')) := by rw [neg_neg]
        _ = -ψ (-c') := map_neg ψ (-c')
        _ = -π F_R := by rw [hπ_FR]
        _ = -(Ideal.Quotient.mk J_axes (Ideal.Quotient.mk I_R F_R)) := rfl
        _ = -(Ideal.Quotient.mk J_axes 0) := by
              rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self F_R)]
        _ = -0 := by rw [map_zero]
        _ = 0 := neg_zero
  exact ⟨Φ, hΦ_C, hΦ_X0, hΦ_X1, hOpen_Φ, hRange_Φ, hSurj_ψ, hKer_ψ⟩

theorem weil_nodal_blowup_chart_overlap_and_centerCompl_algebra (R_z : Type u) [CommRing R_z]
    (s₁' π₁' a'_Rz b₁' a_Rz : R_z)
    (hs₁' : IsUnit s₁')
    (hb₁' : b₁' = s₁' * a'_Rz)
    (ha_Rz : a_Rz = π₁' * a'_Rz) :
    let A_loc := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_Rz}
    let C₀ := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π₁'}
    let C₁ := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₁'}
    let C₀₁ := Localization.Away (Polynomial.X : Polynomial R_z)
    ∃ (p₀_hom : A_loc →+* C₀)
      (p₁_hom : A_loc →+* C₁)
      (f₀₁_hom : C₀ →+* C₀₁)
      (f₁₀_hom : C₁ →+* C₀₁),
      (p₀_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
        p₁_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
        f₀₁_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C ∧
        f₁₀_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C) ∧
      (p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.C s₁' * MvPolynomial.X 0)) =
          Ideal.Quotient.mk _ (MvPolynomial.X 0) ∧
        p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.C s₁' * MvPolynomial.X 0)) =
          Ideal.Quotient.mk _ (MvPolynomial.C π₁' * MvPolynomial.X 1)) ∧
      (@IsLocalization.Away C₀ _ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) C₀₁ _
          f₀₁_hom.toAlgebra ∧
        @IsLocalization.Away C₁ _ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) C₀₁ _
          f₁₀_hom.toAlgebra ∧
        f₀₁_hom.comp p₀_hom = f₁₀_hom.comp p₁_hom ∧
        Subring.closure (Set.range p₀_hom ∪ {Ideal.Quotient.mk _ (MvPolynomial.X 1)}) = ⊤ ∧
        Subring.closure (Set.range p₁_hom ∪ {Ideal.Quotient.mk _ (MvPolynomial.X 1)}) = ⊤ ∧
        f₁₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) *
          f₀₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = 1) ∧
      (((∀ q : PrimeSpectrum C₁,
          p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
          (Localization.Away (p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) _
          ((algebraMap C₀ _).comp p₀_hom).toAlgebra) ∧
       ((∀ q : PrimeSpectrum C₀,
          p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
          (Localization.Away (p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) _
          ((algebraMap C₁ _).comp p₁_hom).toAlgebra) ∧
       ((∀ q : PrimeSpectrum C₀,
          p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.C π₁')) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.C π₁'))
          (Localization.Away (p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.C π₁')))) _
          ((algebraMap C₁ _).comp p₁_hom).toAlgebra)) :=
by
  intro A_loc C₀ C₁ C₀₁
  
  obtain ⟨u_s, hu_s⟩ := hs₁'
  let t_s : R_z := ↑(u_s⁻¹)
  have hst : s₁' * t_s = 1 := by
    rw [← hu_s, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hts : t_s * s₁' = 1 := by
    rw [mul_comm, hst]
  have htb₁ : t_s * b₁' = a'_Rz := by
    rw [hb₁', ← mul_assoc, hts, one_mul]
  have htb₁π₁ : t_s * b₁' * π₁' = a_Rz := by
    rw [htb₁, ha_Rz, mul_comm]
  have hs₁a : s₁' * a_Rz = b₁' * π₁' := by
    rw [ha_Rz, hb₁']
    ring
  have hs₁tπ₁ : s₁' * (t_s * π₁') = π₁' := by
    rw [← mul_assoc, hst, one_mul]
  
  let I_nod (c : R_z) : Ideal (MvPolynomial (Fin 2) R_z) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}
  let mk_nod (c : R_z) : MvPolynomial (Fin 2) R_z →+* (MvPolynomial (Fin 2) R_z ⧸ I_nod c) :=
    Ideal.Quotient.mk (I_nod c)
  let ι_nod (c : R_z) : R_z →+* (MvPolynomial (Fin 2) R_z ⧸ I_nod c) :=
    (mk_nod c).comp MvPolynomial.C
  have nodal_rel : ∀ c : R_z,
      mk_nod c (MvPolynomial.X 0) * mk_nod c (MvPolynomial.X 1) = ι_nod c c := by
    intro c
    have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c ∈ I_nod c :=
      Ideal.mem_span_singleton_self _
    have hzero : mk_nod c (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
    rw [map_sub, map_mul] at hzero
    exact sub_eq_zero.mp hzero
  have nodal_lift_pkg : ∀ {B : Type u} [CommRing B] (c : R_z) (φ₀ : R_z →+* B) (x₀ x₁ : B),
      x₀ * x₁ = φ₀ c →
      ∃ (g : (MvPolynomial (Fin 2) R_z ⧸ I_nod c) →+* B),
        g.comp (ι_nod c) = φ₀ ∧
        (∀ r : R_z, g (ι_nod c r) = φ₀ r) ∧
        g (mk_nod c (MvPolynomial.X 0)) = x₀ ∧
        g (mk_nod c (MvPolynomial.X 1)) = x₁ := by
    intro B _ c φ₀ x₀ x₁ hrel
    let ev : MvPolynomial (Fin 2) R_z →+* B := MvPolynomial.eval₂Hom φ₀ ![x₀, x₁]
    have hker : ∀ f ∈ I_nod c, ev f = 0 := by
      intro f hf
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hf
      have hgen : ev (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
        dsimp only [ev]
        rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.cons_val_zero, hrel, sub_self]
      rw [map_mul, hgen, zero_mul]
    let g : (MvPolynomial (Fin 2) R_z ⧸ I_nod c) →+* B := Ideal.Quotient.lift (I_nod c) ev hker
    have hg_C : ∀ r : R_z, g (ι_nod c r) = φ₀ r := by
      intro r
      change Ideal.Quotient.lift (I_nod c) ev hker (Ideal.Quotient.mk (I_nod c) (MvPolynomial.C r)) = φ₀ r
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.eval₂Hom_C φ₀ ![x₀, x₁] r
    have hg_X0 : g (mk_nod c (MvPolynomial.X 0)) = x₀ := by
      change Ideal.Quotient.lift (I_nod c) ev hker (Ideal.Quotient.mk (I_nod c) (MvPolynomial.X 0)) = x₀
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
    have hg_X1 : g (mk_nod c (MvPolynomial.X 1)) = x₁ := by
      change Ideal.Quotient.lift (I_nod c) ev hker (Ideal.Quotient.mk (I_nod c) (MvPolynomial.X 1)) = x₁
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero]
    refine ⟨g, ?_, hg_C, hg_X0, hg_X1⟩
    exact RingHom.ext hg_C
  have nodalHom_ext : ∀ {B : Type u} [CommRing B] (c : R_z)
      {g₁ g₂ : (MvPolynomial (Fin 2) R_z ⧸ I_nod c) →+* B},
      (∀ r : R_z, g₁ (ι_nod c r) = g₂ (ι_nod c r)) →
      g₁ (mk_nod c (MvPolynomial.X 0)) = g₂ (mk_nod c (MvPolynomial.X 0)) →
      g₁ (mk_nod c (MvPolynomial.X 1)) = g₂ (mk_nod c (MvPolynomial.X 1)) →
      g₁ = g₂ := by
    intro B _ c g₁ g₂ hC hX0 hX1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      exact hC r
    · intro i
      fin_cases i
      · exact hX0
      · exact hX1
  have nodal_subring_eq_top : ∀ (c : R_z)
      (S : Subring (MvPolynomial (Fin 2) R_z ⧸ I_nod c)),
      (∀ r : R_z, ι_nod c r ∈ S) →
      mk_nod c (MvPolynomial.X 0) ∈ S →
      mk_nod c (MvPolynomial.X 1) ∈ S →
      S = ⊤ := by
    intro c S hC hX0 hX1
    rw [eq_top_iff]
    intro z _
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine @MvPolynomial.induction_on R_z (Fin 2) _ (fun P => mk_nod c P ∈ S) F ?_ ?_ ?_
    · intro r
      exact hC r
    · intro p q hp hq
      rw [map_add]
      exact S.add_mem hp hq
    · intro p i hp
      rw [map_mul]
      refine S.mul_mem hp ?_
      fin_cases i
      · exact hX0
      · exact hX1
  
  have away_lift_pkg : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (f : A →+* B) (x : A) (v : B),
      f x * v = 1 →
      ∃ (α : Localization.Away x →+* B),
        (∀ a : A, α (algebraMap A (Localization.Away x) a) = f a) ∧
        α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
    intro A B _ _ f x v hfv
    letI : Algebra A B := f.toAlgebra
    have hfx : IsUnit (algebraMap A B x) :=
      isUnit_iff_exists.mpr ⟨v, hfv, by rw [mul_comm]; exact hfv⟩
    let α : Localization.Away x →+* B :=
      IsLocalization.Away.lift (S := Localization.Away x) x hfx
    have hα_alg : ∀ a : A, α (algebraMap A (Localization.Away x) a) = f a := by
      intro a
      exact IsLocalization.Away.lift_eq (S := Localization.Away x) x hfx a
    have hα_inv : α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
      have h1 : f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = 1 := by
        rw [← hα_alg x, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      calc α (IsLocalization.Away.invSelf (S := Localization.Away x) x)
          = 1 * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := (one_mul _).symm
        _ = (v * f x) * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := by
            rw [mul_comm v (f x), hfv]
        _ = v * (f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x)) :=
            mul_assoc _ _ _
        _ = v * 1 := by rw [h1]
        _ = v := mul_one v
    exact ⟨α, hα_alg, hα_inv⟩
  have isLoc_of_ret : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (x : A) (f : A →+* B)
      (α : Localization.Away x →+* B)
      (β : B →+* Localization.Away x),
      (∀ a : A, α (algebraMap A (Localization.Away x) a) = f a) →
      (∀ a : A, β (f a) = algebraMap A (Localization.Away x) a) →
      α.comp β = RingHom.id B →
      @IsLocalization.Away A _ x B _ f.toAlgebra := by
    intro A B _ _ x f α β hα_alg hβ_f hαβ
    have hβα : β.comp α = RingHom.id (Localization.Away x) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x)
      exact RingHom.ext fun a => by
        simp only [RingHom.comp_apply, RingHom.id_apply, hα_alg, hβ_f]
    letI : Algebra A B := f.toAlgebra
    let e_ring : Localization.Away x ≃+* B := RingEquiv.ofRingHom α β hαβ hβα
    let e_alg : Localization.Away x ≃ₐ[A] B :=
      AlgEquiv.ofRingEquiv (f := e_ring) (fun a => hα_alg a)
    exact (IsLocalization.isLocalization_iff_of_algEquiv (Submonoid.powers x) e_alg).mp
      inferInstance
  
  let ι_a : R_z →+* A_loc := ι_nod a_Rz
  let ι_0 : R_z →+* C₀ := ι_nod π₁'
  let ι_1 : R_z →+* C₁ := ι_nod b₁'
  let κ : R_z →+* C₀₁ := (algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C
  let u₀ : A_loc := mk_nod a_Rz (MvPolynomial.X 0)
  let u₁ : A_loc := mk_nod a_Rz (MvPolynomial.X 1)
  let u_tilde : C₀ := mk_nod π₁' (MvPolynomial.X 0)
  let π' : C₀ := mk_nod π₁' (MvPolynomial.X 1)
  let v₁ : C₁ := mk_nod b₁' (MvPolynomial.X 0)
  let u' : C₁ := mk_nod b₁' (MvPolynomial.X 1)
  let T : C₀₁ := algebraMap (Polynomial R_z) C₀₁ Polynomial.X
  let T_inv : C₀₁ := IsLocalization.Away.invSelf (S := C₀₁) (Polynomial.X : Polynomial R_z)
  have hTT_inv : T * T_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := C₀₁) (Polynomial.X : Polynomial R_z)
  have hT_invT : T_inv * T = 1 := by
    rw [mul_comm, hTT_inv]
  have hu₀u₁ : u₀ * u₁ = ι_a a_Rz := nodal_rel a_Rz
  have hu_tilde_π' : u_tilde * π' = ι_0 π₁' := nodal_rel π₁'
  have hv₁u' : v₁ * u' = ι_1 b₁' := nodal_rel b₁'
  
  have hp₀_rel : (ι_0 t_s * u_tilde) * (ι_0 b₁' * π') = ι_0 a_Rz := by
    calc (ι_0 t_s * u_tilde) * (ι_0 b₁' * π')
        = (ι_0 t_s * ι_0 b₁') * (u_tilde * π') := by ring
      _ = (ι_0 t_s * ι_0 b₁') * ι_0 π₁' := by rw [hu_tilde_π']
      _ = ι_0 (t_s * b₁' * π₁') := by rw [← map_mul, ← map_mul]
      _ = ι_0 a_Rz := by rw [htb₁π₁]
  obtain ⟨p₀_hom, hp₀_comp, hp₀_C, hp₀_X0, hp₀_X1⟩ :=
    nodal_lift_pkg a_Rz ι_0 (ι_0 t_s * u_tilde) (ι_0 b₁' * π') hp₀_rel
  
  have hp₁_rel : (ι_1 (t_s * π₁') * u') * v₁ = ι_1 a_Rz := by
    calc (ι_1 (t_s * π₁') * u') * v₁
        = ι_1 (t_s * π₁') * (v₁ * u') := by ring
      _ = ι_1 (t_s * π₁') * ι_1 b₁' := by rw [hv₁u']
      _ = ι_1 (t_s * π₁' * b₁') := by rw [← map_mul]
      _ = ι_1 (t_s * b₁' * π₁') := by congr 1; ring
      _ = ι_1 a_Rz := by rw [htb₁π₁]
  obtain ⟨p₁_hom, hp₁_comp, hp₁_C, hp₁_X0, hp₁_X1⟩ :=
    nodal_lift_pkg a_Rz ι_1 (ι_1 (t_s * π₁') * u') v₁ hp₁_rel
  
  have hf₀₁_rel : (κ π₁' * T) * T_inv = κ π₁' := by
    rw [mul_assoc, hTT_inv, mul_one]
  obtain ⟨f₀₁_hom, hf₀₁_comp, hf₀₁_C, hf₀₁_X0, hf₀₁_X1⟩ :=
    nodal_lift_pkg π₁' κ (κ π₁' * T) T_inv hf₀₁_rel
  
  have hf₁₀_rel : (κ b₁' * T_inv) * T = κ b₁' := by
    rw [mul_assoc, hT_invT, mul_one]
  obtain ⟨f₁₀_hom, hf₁₀_comp, hf₁₀_C, hf₁₀_X0, hf₁₀_X1⟩ :=
    nodal_lift_pkg b₁' κ (κ b₁' * T_inv) T hf₁₀_rel
  
  have hp₀_sX0 :
      p₀_hom (mk_nod a_Rz (MvPolynomial.C s₁' * MvPolynomial.X 0)) = u_tilde := by
    change p₀_hom (ι_a s₁' * u₀) = u_tilde
    rw [map_mul p₀_hom, hp₀_C s₁', hp₀_X0]
    calc ι_0 s₁' * (ι_0 t_s * u_tilde)
        = (ι_0 s₁' * ι_0 t_s) * u_tilde := (mul_assoc _ _ _).symm
      _ = ι_0 (s₁' * t_s) * u_tilde := by rw [← map_mul]
      _ = ι_0 1 * u_tilde := by rw [hst]
      _ = u_tilde := by rw [map_one, one_mul]
  have hp₁_sX0 :
      p₁_hom (mk_nod a_Rz (MvPolynomial.C s₁' * MvPolynomial.X 0)) =
        mk_nod b₁' (MvPolynomial.C π₁' * MvPolynomial.X 1) := by
    change p₁_hom (ι_a s₁' * u₀) = ι_1 π₁' * u'
    rw [map_mul p₁_hom, hp₁_C s₁', hp₁_X0]
    calc ι_1 s₁' * (ι_1 (t_s * π₁') * u')
        = (ι_1 s₁' * ι_1 (t_s * π₁')) * u' := (mul_assoc _ _ _).symm
      _ = ι_1 (s₁' * (t_s * π₁')) * u' := by rw [← map_mul]
      _ = ι_1 π₁' * u' := by rw [hs₁tπ₁]
  
  have laurent_lift_pkg : ∀ {L : Type u} [CommRing L] (φ₀ : R_z →+* L) (w w_inv : L),
      w * w_inv = 1 →
      ∃ (β : C₀₁ →+* L),
        (∀ r : R_z, β (κ r) = φ₀ r) ∧
        β T = w ∧
        β T_inv = w_inv := by
    intro L _ φ₀ w w_inv hww
    let φ_poly : Polynomial R_z →+* L := Polynomial.eval₂RingHom φ₀ w
    have hφ_C : ∀ r : R_z, φ_poly (Polynomial.C r) = φ₀ r := fun r => Polynomial.eval₂_C φ₀ w
    have hφ_X : φ_poly Polynomial.X = w := Polynomial.eval₂_X φ₀ w
    have hφ_unit : φ_poly Polynomial.X * w_inv = 1 := by
      rw [hφ_X, hww]
    obtain ⟨β, hβ_alg, hβ_inv⟩ := away_lift_pkg φ_poly Polynomial.X w_inv hφ_unit
    refine ⟨β, ?_, ?_, hβ_inv⟩
    · intro r
      change β (algebraMap (Polynomial R_z) C₀₁ (Polynomial.C r)) = φ₀ r
      rw [hβ_alg, hφ_C]
    · change β (algebraMap (Polynomial R_z) C₀₁ Polynomial.X) = w
      rw [hβ_alg, hφ_X]
  have laurent_hom_ext : ∀ {g₁ g₂ : C₀₁ →+* C₀₁},
      (∀ r : R_z, g₁ (κ r) = g₂ (κ r)) →
      g₁ T = g₂ T →
      g₁ = g₂ := by
    intro g₁ g₂ hC hT
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R_z))
    apply Polynomial.ringHom_ext
    · intro r
      exact hC r
    · exact hT
  
  have hloc₀₁ : @IsLocalization.Away C₀ _ π' C₀₁ _ f₀₁_hom.toAlgebra := by
    have hf₀₁_inv : f₀₁_hom π' * T = 1 := by
      rw [hf₀₁_X1, hT_invT]
    obtain ⟨α₀, hα₀_alg, hα₀_inv⟩ := away_lift_pkg f₀₁_hom π' T hf₀₁_inv
    let L₀ := Localization.Away π'
    let η₀ : C₀ →+* L₀ := algebraMap C₀ L₀
    let inv_π' : L₀ := IsLocalization.Away.invSelf (S := L₀) π'
    have hη₀_inv : inv_π' * η₀ π' = 1 := by
      rw [mul_comm]
      exact IsLocalization.Away.mul_invSelf (S := L₀) π'
    obtain ⟨β₀, hβ₀_C, hβ₀_T, hβ₀_Tinv⟩ :=
      laurent_lift_pkg (η₀.comp ι_0) inv_π' (η₀ π') hη₀_inv
    have hβ₀_f₀₁ : β₀.comp f₀₁_hom = η₀ := by
      apply nodalHom_ext π₁'
      · intro r
        rw [RingHom.comp_apply, hf₀₁_C r, hβ₀_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hf₀₁_X0, map_mul β₀, hβ₀_C π₁', hβ₀_T, RingHom.comp_apply]
        rw [← hu_tilde_π', map_mul η₀, mul_assoc,
          IsLocalization.Away.mul_invSelf (S := L₀) π', mul_one]
      · rw [RingHom.comp_apply, hf₀₁_X1, hβ₀_Tinv]
    have hα₀β₀ : α₀.comp β₀ = RingHom.id C₀₁ := by
      apply laurent_hom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.id_apply, hβ₀_C r, RingHom.comp_apply,
          hα₀_alg (ι_0 r), hf₀₁_C r]
      · rw [RingHom.comp_apply, RingHom.id_apply, hβ₀_T, hα₀_inv]
    exact isLoc_of_ret π' f₀₁_hom α₀ β₀ hα₀_alg
      (fun x => RingHom.congr_fun hβ₀_f₀₁ x) hα₀β₀
  
  have hloc₁₀ : @IsLocalization.Away C₁ _ u' C₀₁ _ f₁₀_hom.toAlgebra := by
    have hf₁₀_inv : f₁₀_hom u' * T_inv = 1 := by
      rw [hf₁₀_X1, hTT_inv]
    obtain ⟨α₁, hα₁_alg, hα₁_inv⟩ := away_lift_pkg f₁₀_hom u' T_inv hf₁₀_inv
    let L₁ := Localization.Away u'
    let η₁ : C₁ →+* L₁ := algebraMap C₁ L₁
    let inv_u' : L₁ := IsLocalization.Away.invSelf (S := L₁) u'
    have hη₁_inv : η₁ u' * inv_u' = 1 :=
      IsLocalization.Away.mul_invSelf (S := L₁) u'
    obtain ⟨β₁, hβ₁_C, hβ₁_T, hβ₁_Tinv⟩ :=
      laurent_lift_pkg (η₁.comp ι_1) (η₁ u') inv_u' hη₁_inv
    have hβ₁_f₁₀ : β₁.comp f₁₀_hom = η₁ := by
      apply nodalHom_ext b₁'
      · intro r
        rw [RingHom.comp_apply, hf₁₀_C r, hβ₁_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hf₁₀_X0, map_mul β₁, hβ₁_C b₁', hβ₁_Tinv, RingHom.comp_apply]
        rw [← hv₁u', map_mul η₁, mul_assoc, hη₁_inv, mul_one]
      · rw [RingHom.comp_apply, hf₁₀_X1, hβ₁_T]
    have hα₁β₁ : α₁.comp β₁ = RingHom.id C₀₁ := by
      apply laurent_hom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.id_apply, hβ₁_C r, RingHom.comp_apply,
          hα₁_alg (ι_1 r), hf₁₀_C r]
      · rw [RingHom.comp_apply, RingHom.id_apply, hβ₁_T, hα₁_alg u', hf₁₀_X1]
    exact isLoc_of_ret u' f₁₀_hom α₁ β₁ hα₁_alg
      (fun x => RingHom.congr_fun hβ₁_f₁₀ x) hα₁β₁
  
  have hcomp₀₁ : f₀₁_hom.comp p₀_hom = f₁₀_hom.comp p₁_hom := by
    apply nodalHom_ext a_Rz
    · intro r
      change f₀₁_hom (p₀_hom (ι_a r)) = f₁₀_hom (p₁_hom (ι_a r))
      rw [hp₀_C r, hp₁_C r, hf₀₁_C r, hf₁₀_C r]
    · rw [RingHom.comp_apply, RingHom.comp_apply, hp₀_X0, hp₁_X0,
        map_mul f₀₁_hom, map_mul f₁₀_hom,
        hf₀₁_C t_s, hf₀₁_X0, hf₁₀_C (t_s * π₁'), hf₁₀_X1,
        ← mul_assoc, ← map_mul κ]
    · rw [RingHom.comp_apply, RingHom.comp_apply, hp₀_X1, hp₁_X1,
        map_mul f₀₁_hom, hf₀₁_C b₁', hf₀₁_X1, hf₁₀_X0]
  have hgen₀ : Subring.closure (Set.range p₀_hom ∪ {π'}) = ⊤ := by
    apply nodal_subring_eq_top π₁'
    · intro r
      exact Subring.subset_closure (Or.inl ⟨ι_a r, hp₀_C r⟩)
    · exact Subring.subset_closure
        (Or.inl ⟨mk_nod a_Rz (MvPolynomial.C s₁' * MvPolynomial.X 0), hp₀_sX0⟩)
    · exact Subring.subset_closure (Or.inr rfl)
  have hgen₁ : Subring.closure (Set.range p₁_hom ∪ {u'}) = ⊤ := by
    apply nodal_subring_eq_top b₁'
    · intro r
      exact Subring.subset_closure (Or.inl ⟨ι_a r, hp₁_C r⟩)
    · exact Subring.subset_closure (Or.inl ⟨u₁, hp₁_X1⟩)
    · exact Subring.subset_closure (Or.inr rfl)
  have hinv₀₁ : f₁₀_hom u' * f₀₁_hom π' = 1 := by
    rw [hf₁₀_X1, hf₀₁_X1, hTT_inv]
  
  have hd₀_mem : ∀ q : PrimeSpectrum C₁, p₁_hom u₀ ∉ q.asIdeal → u' ∉ q.asIdeal := by
    intro q hnot hu'
    apply hnot
    rw [hp₁_X0]
    exact q.asIdeal.mul_mem_left _ hu'
  have hd₁_mem : ∀ q : PrimeSpectrum C₀, p₀_hom u₁ ∉ q.asIdeal → π' ∉ q.asIdeal := by
    intro q hnot hπ'
    apply hnot
    rw [hp₀_X1]
    exact q.asIdeal.mul_mem_left _ hπ'
  let d₂ : A_loc := ι_a π₁'
  have hd₂_mem : ∀ q : PrimeSpectrum C₀, p₀_hom d₂ ∉ q.asIdeal → π' ∉ q.asIdeal := by
    intro q hnot hπ'
    apply hnot
    rw [hp₀_C π₁', ← hu_tilde_π']
    exact q.asIdeal.mul_mem_left _ hπ'
  
  have hd₀_loc :
      @IsLocalization.Away A_loc _ u₀ (Localization.Away (p₀_hom u₀)) _
        ((algebraMap C₀ _).comp p₀_hom).toAlgebra := by
    let M₀ := Localization.Away (p₀_hom u₀)
    let η_C₀ : C₀ →+* M₀ := algebraMap C₀ M₀
    let w₀_inv : M₀ := IsLocalization.Away.invSelf (S := M₀) (p₀_hom u₀)
    let f_d0 : A_loc →+* M₀ := η_C₀.comp p₀_hom
    have hf_d0_inv : f_d0 u₀ * w₀_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := M₀) (p₀_hom u₀)
    obtain ⟨α_d0, hα_d0_alg, hα_d0_inv⟩ := away_lift_pkg f_d0 u₀ w₀_inv hf_d0_inv
    let L_u₀ := Localization.Away u₀
    let η_A0 : A_loc →+* L_u₀ := algebraMap A_loc L_u₀
    let u₀_inv : L_u₀ := IsLocalization.Away.invSelf (S := L_u₀) u₀
    have hu₀_inv : η_A0 u₀ * u₀_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_u₀) u₀
    have hψ₀_rel :
        η_A0 (ι_a s₁' * u₀) * (η_A0 (ι_a (t_s * π₁')) * u₀_inv) = η_A0 (ι_a π₁') := by
      calc η_A0 (ι_a s₁' * u₀) * (η_A0 (ι_a (t_s * π₁')) * u₀_inv)
          = (η_A0 (ι_a s₁') * η_A0 (ι_a (t_s * π₁'))) * (η_A0 u₀ * u₀_inv) := by
              rw [map_mul η_A0]; ring
        _ = η_A0 (ι_a (s₁' * (t_s * π₁'))) * 1 := by
              rw [← map_mul η_A0, ← map_mul ι_a, hu₀_inv]
        _ = η_A0 (ι_a π₁') := by rw [hs₁tπ₁, mul_one]
    obtain ⟨ψ₀, _, hψ₀_C, hψ₀_X0, hψ₀_X1⟩ :=
      nodal_lift_pkg π₁' (η_A0.comp ι_a)
        (η_A0 (ι_a s₁' * u₀)) (η_A0 (ι_a (t_s * π₁')) * u₀_inv) hψ₀_rel
    have hψ₀_p₀u₀ : ψ₀ (p₀_hom u₀) = η_A0 u₀ := by
      rw [hp₀_X0, map_mul ψ₀, hψ₀_C t_s, hψ₀_X0, RingHom.comp_apply,
        ← map_mul η_A0, ← mul_assoc, ← map_mul ι_a, hts, map_one, one_mul]
    have hψ₀_unit : ψ₀ (p₀_hom u₀) * u₀_inv = 1 := by
      rw [hψ₀_p₀u₀, hu₀_inv]
    obtain ⟨β_d0, hβ_d0_alg, _⟩ := away_lift_pkg ψ₀ (p₀_hom u₀) u₀_inv hψ₀_unit
    have hψ₀_p₀ : ψ₀.comp p₀_hom = η_A0 := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₀_C r, hψ₀_C r, RingHom.comp_apply]
      · exact hψ₀_p₀u₀
      · rw [RingHom.comp_apply, hp₀_X1, map_mul ψ₀, hψ₀_C b₁', hψ₀_X1, RingHom.comp_apply]
        have hb_eq : b₁' * (t_s * π₁') = a_Rz := by
          calc b₁' * (t_s * π₁') = t_s * b₁' * π₁' := by ring
            _ = a_Rz := htb₁π₁
        calc η_A0 (ι_a b₁') * (η_A0 (ι_a (t_s * π₁')) * u₀_inv)
            = (η_A0 (ι_a b₁') * η_A0 (ι_a (t_s * π₁'))) * u₀_inv := (mul_assoc _ _ _).symm
          _ = η_A0 (ι_a (b₁' * (t_s * π₁'))) * u₀_inv := by
                rw [← map_mul η_A0, ← map_mul ι_a]
          _ = η_A0 (ι_a a_Rz) * u₀_inv := by rw [hb_eq]
          _ = η_A0 (u₀ * u₁) * u₀_inv := by rw [← hu₀u₁]
          _ = η_A0 u₁ * (η_A0 u₀ * u₀_inv) := by rw [map_mul η_A0]; ring
          _ = η_A0 u₁ := by rw [hu₀_inv, mul_one]
    have hα_d0_β_d0 : α_d0.comp β_d0 = RingHom.id M₀ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (p₀_hom u₀))
      have hα_ψ₀ : α_d0.comp ψ₀ = η_C₀ := by
        apply nodalHom_ext π₁'
        · intro r
          rw [RingHom.comp_apply, hψ₀_C r, RingHom.comp_apply, hα_d0_alg (ι_a r)]
          exact congrArg η_C₀ (hp₀_C r)
        · rw [RingHom.comp_apply, hψ₀_X0, hα_d0_alg (ι_a s₁' * u₀)]
          exact congrArg η_C₀ hp₀_sX0
        · rw [RingHom.comp_apply, hψ₀_X1, map_mul α_d0,
            hα_d0_alg (ι_a (t_s * π₁')), hα_d0_inv]
          have hp₀_tsπ : f_d0 (ι_a (t_s * π₁')) = η_C₀ (ι_0 (t_s * π₁')) :=
            congrArg η_C₀ (hp₀_C (t_s * π₁'))
          have hp₀u₀_π' : p₀_hom u₀ * π' = ι_0 (t_s * π₁') := by
            rw [hp₀_X0, mul_assoc, hu_tilde_π', ← map_mul ι_0]
          rw [hp₀_tsπ, ← hp₀u₀_π', map_mul η_C₀,
            mul_comm (η_C₀ (p₀_hom u₀)) (η_C₀ π'), mul_assoc,
            IsLocalization.Away.mul_invSelf (S := M₀) (p₀_hom u₀), mul_one]
      exact RingHom.ext fun c => by
        have hc : β_d0 (η_C₀ c) = ψ₀ c := hβ_d0_alg c
        change α_d0 (β_d0 (η_C₀ c)) = η_C₀ c
        rw [hc]
        exact RingHom.congr_fun hα_ψ₀ c
    refine isLoc_of_ret u₀ f_d0 α_d0 β_d0 hα_d0_alg ?_ hα_d0_β_d0
    intro a
    change β_d0 (η_C₀ (p₀_hom a)) = η_A0 a
    rw [hβ_d0_alg]
    exact RingHom.congr_fun hψ₀_p₀ a
  
  have hd₁_loc :
      @IsLocalization.Away A_loc _ u₁ (Localization.Away (p₁_hom u₁)) _
        ((algebraMap C₁ _).comp p₁_hom).toAlgebra := by
    let M₁ := Localization.Away (p₁_hom u₁)
    let η_C₁ : C₁ →+* M₁ := algebraMap C₁ M₁
    let w₁_inv : M₁ := IsLocalization.Away.invSelf (S := M₁) (p₁_hom u₁)
    let f_d1 : A_loc →+* M₁ := η_C₁.comp p₁_hom
    have hf_d1_inv : f_d1 u₁ * w₁_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := M₁) (p₁_hom u₁)
    obtain ⟨α_d1, hα_d1_alg, hα_d1_inv⟩ := away_lift_pkg f_d1 u₁ w₁_inv hf_d1_inv
    let L_u₁ := Localization.Away u₁
    let η_A1 : A_loc →+* L_u₁ := algebraMap A_loc L_u₁
    let u₁_inv : L_u₁ := IsLocalization.Away.invSelf (S := L_u₁) u₁
    have hu₁_inv : η_A1 u₁ * u₁_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_u₁) u₁
    have hψ₁_rel : η_A1 u₁ * (η_A1 (ι_a b₁') * u₁_inv) = η_A1 (ι_a b₁') := by
      calc η_A1 u₁ * (η_A1 (ι_a b₁') * u₁_inv)
          = η_A1 (ι_a b₁') * (η_A1 u₁ * u₁_inv) := by ring
        _ = η_A1 (ι_a b₁') := by rw [hu₁_inv, mul_one]
    obtain ⟨ψ₁, _, hψ₁_C, hψ₁_X0, hψ₁_X1⟩ :=
      nodal_lift_pkg b₁' (η_A1.comp ι_a) (η_A1 u₁) (η_A1 (ι_a b₁') * u₁_inv) hψ₁_rel
    have hψ₁_p₁u₁ : ψ₁ (p₁_hom u₁) = η_A1 u₁ := by
      rw [hp₁_X1, hψ₁_X0]
    have hψ₁_unit : ψ₁ (p₁_hom u₁) * u₁_inv = 1 := by
      rw [hψ₁_p₁u₁, hu₁_inv]
    obtain ⟨β_d1, hβ_d1_alg, _⟩ := away_lift_pkg ψ₁ (p₁_hom u₁) u₁_inv hψ₁_unit
    have hψ₁_p₁ : ψ₁.comp p₁_hom = η_A1 := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₁_C r, hψ₁_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hp₁_X0, map_mul ψ₁, hψ₁_C (t_s * π₁'), hψ₁_X1,
          RingHom.comp_apply]
        have ht_eq : (t_s * π₁') * b₁' = a_Rz := by
          calc (t_s * π₁') * b₁' = t_s * b₁' * π₁' := by ring
            _ = a_Rz := htb₁π₁
        calc η_A1 (ι_a (t_s * π₁')) * (η_A1 (ι_a b₁') * u₁_inv)
            = (η_A1 (ι_a (t_s * π₁')) * η_A1 (ι_a b₁')) * u₁_inv := (mul_assoc _ _ _).symm
          _ = η_A1 (ι_a ((t_s * π₁') * b₁')) * u₁_inv := by
                rw [← map_mul η_A1, ← map_mul ι_a]
          _ = η_A1 (ι_a a_Rz) * u₁_inv := by rw [ht_eq]
          _ = η_A1 (u₀ * u₁) * u₁_inv := by rw [← hu₀u₁]
          _ = η_A1 u₀ * (η_A1 u₁ * u₁_inv) := by rw [map_mul η_A1, mul_assoc]
          _ = η_A1 u₀ := by rw [hu₁_inv, mul_one]
      · exact hψ₁_p₁u₁
    have hα_d1_β_d1 : α_d1.comp β_d1 = RingHom.id M₁ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (p₁_hom u₁))
      have hα_ψ₁ : α_d1.comp ψ₁ = η_C₁ := by
        apply nodalHom_ext b₁'
        · intro r
          rw [RingHom.comp_apply, hψ₁_C r, RingHom.comp_apply, hα_d1_alg (ι_a r)]
          exact congrArg η_C₁ (hp₁_C r)
        · rw [RingHom.comp_apply, hψ₁_X0, hα_d1_alg u₁]
          exact congrArg η_C₁ hp₁_X1
        · rw [RingHom.comp_apply, hψ₁_X1, map_mul α_d1, hα_d1_alg (ι_a b₁'), hα_d1_inv]
          have hp₁_b1 : f_d1 (ι_a b₁') = η_C₁ (ι_1 b₁') :=
            congrArg η_C₁ (hp₁_C b₁')
          have hp₁u₁_u' : p₁_hom u₁ * u' = ι_1 b₁' := by
            rw [hp₁_X1, hv₁u']
          rw [hp₁_b1, ← hp₁u₁_u', map_mul η_C₁,
            mul_comm (η_C₁ (p₁_hom u₁)) (η_C₁ u'), mul_assoc,
            IsLocalization.Away.mul_invSelf (S := M₁) (p₁_hom u₁), mul_one]
      exact RingHom.ext fun c => by
        have hc : β_d1 (η_C₁ c) = ψ₁ c := hβ_d1_alg c
        change α_d1 (β_d1 (η_C₁ c)) = η_C₁ c
        rw [hc]
        exact RingHom.congr_fun hα_ψ₁ c
    refine isLoc_of_ret u₁ f_d1 α_d1 β_d1 hα_d1_alg ?_ hα_d1_β_d1
    intro a
    change β_d1 (η_C₁ (p₁_hom a)) = η_A1 a
    rw [hβ_d1_alg]
    exact RingHom.congr_fun hψ₁_p₁ a
  
  have hd₂_loc :
      @IsLocalization.Away A_loc _ d₂ (Localization.Away (p₁_hom d₂)) _
        ((algebraMap C₁ _).comp p₁_hom).toAlgebra := by
    let M₂ := Localization.Away (p₁_hom d₂)
    let η_C₁' : C₁ →+* M₂ := algebraMap C₁ M₂
    let w₂_inv : M₂ := IsLocalization.Away.invSelf (S := M₂) (p₁_hom d₂)
    let f_d2 : A_loc →+* M₂ := η_C₁'.comp p₁_hom
    have hf_d2_inv : f_d2 d₂ * w₂_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := M₂) (p₁_hom d₂)
    obtain ⟨α_d2, hα_d2_alg, hα_d2_inv⟩ := away_lift_pkg f_d2 d₂ w₂_inv hf_d2_inv
    let L_d₂ := Localization.Away d₂
    let η_A2 : A_loc →+* L_d₂ := algebraMap A_loc L_d₂
    let d₂_inv : L_d₂ := IsLocalization.Away.invSelf (S := L_d₂) d₂
    have hd₂_inv : η_A2 d₂ * d₂_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_d₂) d₂
    have hψ₂_rel : η_A2 u₁ * (η_A2 (ι_a s₁' * u₀) * d₂_inv) = η_A2 (ι_a b₁') := by
      calc η_A2 u₁ * (η_A2 (ι_a s₁' * u₀) * d₂_inv)
          = η_A2 (ι_a s₁' * (u₀ * u₁)) * d₂_inv := by
              rw [← mul_assoc, ← map_mul η_A2]
              congr 2
              ring
        _ = η_A2 (ι_a s₁' * ι_a a_Rz) * d₂_inv := by rw [hu₀u₁]
        _ = η_A2 (ι_a (s₁' * a_Rz)) * d₂_inv := by rw [← map_mul ι_a]
        _ = η_A2 (ι_a (b₁' * π₁')) * d₂_inv := by rw [hs₁a]
        _ = η_A2 (ι_a b₁' * d₂) * d₂_inv := by rw [map_mul ι_a]
        _ = η_A2 (ι_a b₁') * (η_A2 d₂ * d₂_inv) := by rw [map_mul η_A2, mul_assoc]
        _ = η_A2 (ι_a b₁') := by rw [hd₂_inv, mul_one]
    obtain ⟨ψ₂, _, hψ₂_C, hψ₂_X0, hψ₂_X1⟩ :=
      nodal_lift_pkg b₁' (η_A2.comp ι_a) (η_A2 u₁) (η_A2 (ι_a s₁' * u₀) * d₂_inv) hψ₂_rel
    have hψ₂_p₁d₂ : ψ₂ (p₁_hom d₂) = η_A2 d₂ := by
      change ψ₂ (p₁_hom (ι_a π₁')) = η_A2 (ι_a π₁')
      rw [hp₁_C π₁', hψ₂_C π₁', RingHom.comp_apply]
    have hψ₂_unit : ψ₂ (p₁_hom d₂) * d₂_inv = 1 := by
      rw [hψ₂_p₁d₂, hd₂_inv]
    obtain ⟨β_d2, hβ_d2_alg, _⟩ := away_lift_pkg ψ₂ (p₁_hom d₂) d₂_inv hψ₂_unit
    have hψ₂_p₁ : ψ₂.comp p₁_hom = η_A2 := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₁_C r, hψ₂_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hp₁_X0, map_mul ψ₂, hψ₂_C (t_s * π₁'), hψ₂_X1,
          RingHom.comp_apply]
        have ht_s_eq : ι_a (t_s * π₁') * (ι_a s₁' * u₀) = u₀ * d₂ := by
          calc ι_a (t_s * π₁') * (ι_a s₁' * u₀)
              = (ι_a t_s * ι_a π₁') * (ι_a s₁' * u₀) := by rw [map_mul ι_a]
            _ = (ι_a t_s * ι_a s₁') * u₀ * ι_a π₁' := by ring
            _ = ι_a (t_s * s₁') * u₀ * d₂ := by rw [← map_mul ι_a]
            _ = u₀ * d₂ := by rw [hts, map_one, one_mul]
        calc η_A2 (ι_a (t_s * π₁')) * (η_A2 (ι_a s₁' * u₀) * d₂_inv)
            = η_A2 (ι_a (t_s * π₁') * (ι_a s₁' * u₀)) * d₂_inv := by
                rw [← mul_assoc, ← map_mul η_A2]
          _ = η_A2 (u₀ * d₂) * d₂_inv := by rw [ht_s_eq]
          _ = η_A2 u₀ * (η_A2 d₂ * d₂_inv) := by rw [map_mul η_A2, mul_assoc]
          _ = η_A2 u₀ := by rw [hd₂_inv, mul_one]
      · rw [RingHom.comp_apply, hp₁_X1, hψ₂_X0]
    have hα_d2_β_d2 : α_d2.comp β_d2 = RingHom.id M₂ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (p₁_hom d₂))
      have hα_ψ₂ : α_d2.comp ψ₂ = η_C₁' := by
        apply nodalHom_ext b₁'
        · intro r
          rw [RingHom.comp_apply, hψ₂_C r, RingHom.comp_apply, hα_d2_alg (ι_a r)]
          exact congrArg η_C₁' (hp₁_C r)
        · rw [RingHom.comp_apply, hψ₂_X0, hα_d2_alg u₁]
          exact congrArg η_C₁' hp₁_X1
        · rw [RingHom.comp_apply, hψ₂_X1, map_mul α_d2,
            hα_d2_alg (ι_a s₁' * u₀), hα_d2_inv]
          have hp₁_sX0' : f_d2 (ι_a s₁' * u₀) = η_C₁' (p₁_hom d₂ * u') := by
            have h1 : p₁_hom (ι_a s₁' * u₀) = ι_1 π₁' * u' := by
              have h := hp₁_sX0
              rwa [map_mul (mk_nod a_Rz), map_mul (mk_nod b₁')] at h
            have h2 : p₁_hom d₂ = ι_1 π₁' := hp₁_C π₁'
            exact congrArg η_C₁' (h1.trans (by rw [← h2]))
          rw [hp₁_sX0', map_mul η_C₁',
            mul_comm (η_C₁' (p₁_hom d₂)) (η_C₁' u'), mul_assoc,
            IsLocalization.Away.mul_invSelf (S := M₂) (p₁_hom d₂), mul_one]
      exact RingHom.ext fun c => by
        have hc : β_d2 (η_C₁' c) = ψ₂ c := hβ_d2_alg c
        change α_d2 (β_d2 (η_C₁' c)) = η_C₁' c
        rw [hc]
        exact RingHom.congr_fun hα_ψ₂ c
    refine isLoc_of_ret d₂ f_d2 α_d2 β_d2 hα_d2_alg ?_ hα_d2_β_d2
    intro a
    change β_d2 (η_C₁' (p₁_hom a)) = η_A2 a
    rw [hβ_d2_alg]
    exact RingHom.congr_fun hψ₂_p₁ a
  exact ⟨p₀_hom, p₁_hom, f₀₁_hom, f₁₀_hom,
    ⟨hp₀_comp, hp₁_comp, hf₀₁_comp, hf₁₀_comp⟩,
    ⟨hp₀_sX0, hp₁_sX0⟩,
    ⟨hloc₀₁, hloc₁₀, hcomp₀₁, hgen₀, hgen₁, hinv₀₁⟩,
    ⟨⟨hd₀_mem, hd₀_loc⟩, ⟨hd₁_mem, hd₁_loc⟩, ⟨hd₂_mem, hd₂_loc⟩⟩⟩

theorem weil_twoChart_affine_gluing_proper_and_openIso (A C₀ C₁ C₀₁ : Type u) [CommRing A] [CommRing C₀] [CommRing C₁] [CommRing C₀₁]
    (p₀_hom : A →+* C₀)
    (p₁_hom : A →+* C₁)
    (g₀ : C₀)
    (g₁ : C₁)
    (f₀₁_hom : C₀ →+* C₀₁)
    (f₁₀_hom : C₁ →+* C₀₁)
    (hloc₀ : @IsLocalization.Away C₀ _ g₀ C₀₁ _ f₀₁_hom.toAlgebra)
    (hloc₁ : @IsLocalization.Away C₁ _ g₁ C₀₁ _ f₁₀_hom.toAlgebra)
    (hcomp : f₀₁_hom.comp p₀_hom = f₁₀_hom.comp p₁_hom)
    (hgen₀ : Subring.closure (Set.range p₀_hom ∪ {g₀}) = ⊤)
    (hgen₁ : Subring.closure (Set.range p₁_hom ∪ {g₁}) = ⊤)
    (hinv : f₁₀_hom g₁ * f₀₁_hom g₀ = 1)
    (I_center : Ideal A)
    (d₀ d₁ d₂ : A)
    (hI : I_center = Ideal.span {d₀, d₁} ⊔ Ideal.span {d₂})
    (hd₀_mem : ∀ q : PrimeSpectrum C₁, p₁_hom d₀ ∉ q.asIdeal → g₁ ∉ q.asIdeal)
    (hd₀_loc : @IsLocalization.Away A _ d₀ (Localization.Away (p₀_hom d₀)) _
      ((algebraMap C₀ _).comp p₀_hom).toAlgebra)
    (hd₁_mem : ∀ q : PrimeSpectrum C₀, p₀_hom d₁ ∉ q.asIdeal → g₀ ∉ q.asIdeal)
    (hd₁_loc : @IsLocalization.Away A _ d₁ (Localization.Away (p₁_hom d₁)) _
      ((algebraMap C₁ _).comp p₁_hom).toAlgebra)
    (hd₂_mem : ∀ q : PrimeSpectrum C₀, p₀_hom d₂ ∉ q.asIdeal → g₀ ∉ q.asIdeal)
    (hd₂_loc : @IsLocalization.Away A _ d₂ (Localization.Away (p₁_hom d₂)) _
      ((algebraMap C₁ _).comp p₁_hom).toAlgebra) :
    ∃ (M : AlgebraicGeometry.Scheme.{u})
      (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ M)
      (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ M),
      AlgebraicGeometry.IsOpenImmersion ι₀ ∧
      AlgebraicGeometry.IsOpenImmersion ι₁ ∧
      (∀ y : M, y ∈ Set.range ι₀.base ∨ y ∈ Set.range ι₁.base) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁_hom) ≫ ι₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀_hom) ≫ ι₁ ∧
      ι₀ ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀_hom) ∧
      ι₁ ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁_hom) ∧
      AlgebraicGeometry.IsProper p_M ∧
      CategoryTheory.IsIso
        (p_M ∣_ ⟨(PrimeSpectrum.zeroLocus (I_center : Set A))ᶜ,
          (PrimeSpectrum.isClosed_zeroLocus (I_center : Set A)).isOpen_compl⟩) :=
by
  let U₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₀)
  let U₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₁)
  let W : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₀₁)
  let f₀₁ : W ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁_hom)
  let f₁₀ : W ⟶ U₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀_hom)
  have hOpen_f₀₁ : AlgebraicGeometry.IsOpenImmersion f₀₁ := by
    letI : Algebra C₀ C₀₁ := f₀₁_hom.toAlgebra
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization C₀ C₀₁ _ _ f₀₁_hom.toAlgebra g₀ hloc₀
  have hOpen_f₁₀ : AlgebraicGeometry.IsOpenImmersion f₁₀ := by
    letI : Algebra C₁ C₀₁ := f₁₀_hom.toAlgebra
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization C₁ C₀₁ _ _ f₁₀_hom.toAlgebra g₁ hloc₁
  
  have hGluePkg :
      ∃ (M : AlgebraicGeometry.Scheme.{u})
        (ι₀ : U₀ ⟶ M)
        (ι₁ : U₁ ⟶ M),
        AlgebraicGeometry.IsOpenImmersion ι₀ ∧
        AlgebraicGeometry.IsOpenImmersion ι₁ ∧
        (∀ y : M, y ∈ Set.range ι₀.base ∨ y ∈ Set.range ι₁.base) ∧
        f₀₁ ≫ ι₀ = f₁₀ ≫ ι₁ ∧
        (∀ (Z : AlgebraicGeometry.Scheme.{u}) (h₀ : U₀ ⟶ Z) (h₁ : U₁ ⟶ Z),
          f₀₁ ≫ h₀ = f₁₀ ≫ h₁ → ∃ h : M ⟶ Z, ι₀ ≫ h = h₀ ∧ ι₁ ≫ h = h₁) ∧
        (∀ (Z : AlgebraicGeometry.Scheme.{u}) (h h' : M ⟶ Z),
          ι₀ ≫ h = ι₀ ≫ h' → ι₁ ≫ h = ι₁ ≫ h' → h = h') := by
    have hHasMC : ∀ (D_gen : AlgebraicGeometry.Scheme.GlueData.{u}),
        CategoryTheory.Limits.HasMulticoequalizer D_gen.diagram := fun _ => inferInstance
    haveI : AlgebraicGeometry.IsOpenImmersion f₀₁ := hOpen_f₀₁
    haveI : AlgebraicGeometry.IsOpenImmersion f₁₀ := hOpen_f₁₀
    let J := ULift.{u} Bool
