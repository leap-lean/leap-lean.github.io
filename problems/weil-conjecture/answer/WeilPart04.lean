          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.IsOpenImmersion.lift_fac,
            AlgebraicGeometry.IsOpenImmersion.lift_fac, CategoryTheory.Category.id_comp]
        let iso_Wa_cat : CommRingCat.of (Polynomial F) ≅ P_F.presheaf.obj (Opposite.op W_a) :=
          { hom := AlgebraicGeometry.Spec.preimage u_fwd
            inv := AlgebraicGeometry.Spec.preimage u_bwd
