    let S_θ : Subalgebra A₁ B_m := Algebra.adjoin A₁ ({θ} : Set B_m)
    let p_θ : Ideal ↥S_θ := Ideal.comap (algebraMap ↥S_θ B_m) (IsLocalRing.maximalIdeal B_m)
