          Ideal.comap ψ₁.hom p₂.asIdeal = Ideal.comap ψ₁.hom y.asIdeal →
          p₁ = p₂ := by
      intro y hy
      obtain ⟨hyF, hyle⟩ := Finset.mem_filter.mp hy
      have hy' : y ∈ M₁ ∧ y.asIdeal ≤ p₀.asIdeal := ⟨hM₁_fin.mem_toFinset.mp hyF, hyle⟩
      dsimp only [h_good]
      rw [dite_eq_left_of_eq_true (eq_true hy')]
      exact (hex_good y hy').choose_spec.2
    have hprod_notMem : ∀ {α : Type u} (s : Finset α) (f : α → B₁),
