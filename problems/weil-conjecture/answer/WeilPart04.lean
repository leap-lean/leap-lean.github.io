  obtain ⟨h₀, hh₀_not_pz, hBij_comp⟩ := h_sec_iso
  let π₁' : R_z := algebraMap ↥V R_z π₁
  let B₁ : Type u := Localization.Away h₀
  let lam : ↑B₀ →+* B₁ := algebraMap (↑B₀) B₁
