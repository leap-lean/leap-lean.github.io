      exact ⟨Z₀, hFin.mem_toFinset.mpr hZ₀⟩
    have hF₀_sub : (↑F₀ : Set (Set ↥T₀)) ⊆ 𝒞 := fun _ hZ => hFin.mem_toFinset.mp hZ
    let Δ_fn : Set ↥T₀ → Set ↥T₀ := fun Z => {q ∈ Z | ∃ Z' ∈ 𝒞, Z' ≠ Z ∧ q ∈ Z'}
    have hΔ_props : ∀ Z ∈ F₀, (Δ_fn Z).Finite ∧ (Δ_fn Z).ncard = (nbhd F₀ Z).card := by
      intro Z hZ_F₀
      have hZ : Z ∈ 𝒞 := hF₀_sub hZ_F₀
      have hΔ_eq : Δ_fn Z = ⋃ Z' ∈ nbhd F₀ Z, (Z ∩ Z') := by
        ext q
        simp only [Δ_fn, Set.mem_ofPred_eq, Set.mem_iUnion, nbhd, Finset.mem_filter,
          Finset.mem_erase, Set.mem_inter_iff]
        constructor
        · rintro ⟨hqZ, Z', hZ', hne, hqZ'⟩
          exact ⟨Z', ⟨⟨hne, hFin.mem_toFinset.mpr hZ'⟩, ⟨q, hqZ, hqZ'⟩⟩, hqZ, hqZ'⟩
        · rintro ⟨Z', ⟨⟨hne, hZ'_F₀⟩, _⟩, hqZ, hqZ'⟩
          exact ⟨hqZ, Z', hF₀_sub hZ'_F₀, hne, hqZ'⟩
      have hInterFin : ∀ Z' : Set ↥T₀, Z' ∈ nbhd F₀ Z → (Z ∩ Z').Finite := by
        intro Z' hZ'
        have h1 := Finset.mem_erase.mp (Finset.mem_filter.mp hZ').1
        exact (hSub Z hZ Z' (hF₀_sub h1.2) h1.1).finite
      have hΔ_fin : (Δ_fn Z).Finite := by
        rw [hΔ_eq]
        exact Finset.finite_toSet (nbhd F₀ Z) |>.biUnion (fun Z' hZ' => hInterFin Z' hZ')
      refine ⟨hΔ_fin, ?_⟩
      let t_fin : Set ↥T₀ → Finset ↥T₀ := fun Z' =>
        if h : Z' ∈ nbhd F₀ Z then (hInterFin Z' h).toFinset else ∅
      have ht_fin_eq : ∀ Z' (h : Z' ∈ nbhd F₀ Z), t_fin Z' = (hInterFin Z' h).toFinset := by
        intro Z' h
        dsimp only [t_fin]
        split_ifs
        rfl
      have hbiU : hΔ_fin.toFinset = (nbhd F₀ Z).biUnion t_fin := by
        ext q
        simp only [Set.Finite.mem_toFinset, Finset.mem_biUnion]
        rw [hΔ_eq]
        simp only [Set.mem_iUnion]
        constructor
        · rintro ⟨Z', hZ', hq⟩
          refine ⟨Z', hZ', ?_⟩
          rw [ht_fin_eq Z' hZ', Set.Finite.mem_toFinset]
          exact hq
        · rintro ⟨Z', hZ', hq⟩
          refine ⟨Z', hZ', ?_⟩
          rw [ht_fin_eq Z' hZ', Set.Finite.mem_toFinset] at hq
          exact hq
      have hpdisj : (↑(nbhd F₀ Z) : Set (Set ↥T₀)).PairwiseDisjoint t_fin := by
        intro Z₁ hZ₁ Z₂ hZ₂ hne12
        have hZ₁_m : Z₁ ∈ nbhd F₀ Z := Finset.mem_coe.mp hZ₁
        have hZ₂_m : Z₂ ∈ nbhd F₀ Z := Finset.mem_coe.mp hZ₂
        change Disjoint (t_fin Z₁) (t_fin Z₂)
        rw [ht_fin_eq Z₁ hZ₁_m, ht_fin_eq Z₂ hZ₂_m, Finset.disjoint_left]
        intro q hq₁ hq₂
        have hq₁' : q ∈ Z ∩ Z₁ := (Set.Finite.mem_toFinset _).mp hq₁
        have hq₂' : q ∈ Z ∩ Z₂ := (Set.Finite.mem_toFinset _).mp hq₂
        have he1 := Finset.mem_erase.mp (Finset.mem_filter.mp hZ₁_m).1
        have he2 := Finset.mem_erase.mp (Finset.mem_filter.mp hZ₂_m).1
        rcases hAtMost2 q Z Z₁ Z₂ hZ (hF₀_sub he1.2) (hF₀_sub he2.2) hq₁'.1 hq₁'.2 hq₂'.2 with
          rfl | rfl | h12
        · exact he1.1 rfl
        · exact he2.1 rfl
        · exact hne12 h12
      have hcard1 : ∀ Z' ∈ nbhd F₀ Z, (t_fin Z').card = 1 := by
        intro Z' hZ'
        have hne_inter : (Z ∩ Z').Nonempty := (Finset.mem_filter.mp hZ').2
        have he := Finset.mem_erase.mp (Finset.mem_filter.mp hZ').1
        have hsub_inter : (Z ∩ Z').Subsingleton := hSub Z hZ Z' (hF₀_sub he.2) he.1
        obtain ⟨q₀, hq₀⟩ := hne_inter
        have ht_eq : t_fin Z' = {q₀} := by
          rw [ht_fin_eq Z' hZ']
          ext q
          simp only [Set.Finite.mem_toFinset, Finset.mem_singleton]
          exact ⟨fun hq => hsub_inter hq hq₀, fun h => h ▸ hq₀⟩
        rw [ht_eq, Finset.card_singleton]
      rw [Set.ncard_eq_toFinset_card _ hΔ_fin, hbiU, Finset.card_biUnion hpdisj,
        Finset.sum_congr rfl hcard1, Finset.sum_const, smul_eq_mul, mul_one]
    have hSumS : (∑ Z ∈ F₀, (Z ∩ S_ext).ncard) ≤ 2 := by
      let s_fin : Set ↥T₀ → Finset ↥T₀ := fun Z => (hS_fin.inter_of_right Z).toFinset
      have hpdisj_S : (↑F₀ : Set (Set ↥T₀)).PairwiseDisjoint s_fin := by
        intro Z₁ hZ₁ Z₂ hZ₂ hne12
        change Disjoint (s_fin Z₁) (s_fin Z₂)
        rw [Finset.disjoint_left]
        intro q hq₁ hq₂
        have hq₁' : q ∈ Z₁ ∩ S_ext := (Set.Finite.mem_toFinset _).mp hq₁
        have hq₂' : q ∈ Z₂ ∩ S_ext := (Set.Finite.mem_toFinset _).mp hq₂
        exact hne12 (hS_uniq q hq₁'.2 Z₁ (hF₀_sub hZ₁) Z₂ (hF₀_sub hZ₂) hq₁'.1 hq₂'.1)
      have hsub_S : F₀.biUnion s_fin ⊆ hS_fin.toFinset := by
        intro q hq
        rw [Finset.mem_biUnion] at hq
        obtain ⟨Z, _, hqZ⟩ := hq
        exact hS_fin.mem_toFinset.mpr ((Set.Finite.mem_toFinset _).mp hqZ).2
      have hcard_eq : ∀ Z ∈ F₀, (Z ∩ S_ext).ncard = (s_fin Z).card := fun Z _ =>
        Set.ncard_eq_toFinset_card _ (hS_fin.inter_of_right Z)
      calc
        (∑ Z ∈ F₀, (Z ∩ S_ext).ncard)
            = ∑ Z ∈ F₀, (s_fin Z).card := Finset.sum_congr rfl hcard_eq
        _ = (F₀.biUnion s_fin).card := (Finset.card_biUnion hpdisj_S).symm
        _ ≤ hS_fin.toFinset.card := Finset.card_le_card hsub_S
        _ = S_ext.ncard := (Set.ncard_eq_toFinset_card S_ext hS_fin).symm
        _ ≤ 2 := hS_le2
    have hCardPos : 1 ≤ F₀.card := Finset.card_pos.mpr hF₀_ne
    have hSumTot : (∑ Z ∈ F₀, ((Δ_fn Z).ncard + (Z ∩ S_ext).ncard)) ≤ ∑ _Z ∈ F₀, 2 := by
      rw [Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul]
      have h1 : (∑ Z ∈ F₀, (Δ_fn Z).ncard) = ∑ Z ∈ F₀, (nbhd F₀ Z).card :=
        Finset.sum_congr rfl (fun Z hZ => (hΔ_props Z hZ).2)
      have h2 := hSumDeg F₀.card F₀ rfl hF₀_ne hF₀_sub
      omega
    obtain ⟨Z, hZ_F₀, hZ_le⟩ := Finset.exists_le_of_sum_le hF₀_ne hSumTot
    exact ⟨Z, hF₀_sub hZ_F₀, (hΔ_props Z hZ_F₀).1, hZ_le⟩

theorem weil_valuationSubring_ofPrime_algPackage_and_away (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥) :
    IsValuationRingAlgPackage m (V.ofPrime P.asIdeal) ∧
    IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥ ∧
    ∃ (ϖ : ↥V),
      ϖ ∉ P.asIdeal ∧
      (∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal) ∧
      (∀ x : K, x ∈ V.ofPrime P.asIdeal ↔
        ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a) ∧
      AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))) :=
by
  have _ : P.asIdeal.IsPrime := P.isPrime
  let W : ValuationSubring K := V.ofPrime P.asIdeal
  let ι_VP : ↥V →+* ↥W := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  have h_alg : algebraMap ↥V ↥W = ι_VP := rfl
  have hInj_VP : Function.Injective (algebraMap ↥V ↥W) := by
    intro x y hxy
    exact Subtype.ext (congrArg (Subtype.val : ↥W → K) hxy)
  have hAway : ∃ (ϖ : ↥V),
      ϖ ∉ P.asIdeal ∧
      (∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal) ∧
      (∀ x : K, x ∈ V.ofPrime P.asIdeal ↔
        ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a) := by
    let S_gt : Set (PrimeSpectrum ↥V) := {Q | ¬ Q.asIdeal ≤ P.asIdeal}
    have hFin_S : S_gt.Finite := hPkg.1.subset (Set.subset_univ _)
    have hTotal : ∀ I₁ I₂ : Ideal ↥V, I₁ ≤ I₂ ∨ I₂ ≤ I₁ := by
      intro I₁ I₂
      rw [or_iff_not_imp_left]
      intro hnot y hy₂
      obtain ⟨x, hx₁, hx₂⟩ := SetLike.not_le_iff_exists.mp hnot
      by_cases hy0 : y = 0
      · exact hy0 ▸ I₁.zero_mem
      · have hx0 : (x : K) ≠ 0 := fun h0 => hx₂ ((@Subtype.ext _ _ x 0 h0) ▸ I₂.zero_mem)
        have hy0' : (y : K) ≠ 0 := fun h0 => hy0 (@Subtype.ext _ _ y 0 h0)
        rcases ValuationSubring.mem_or_inv_mem V ((y : K) / (x : K)) with hdiv | hinv
        · have hy_eq : y = (⟨(y : K) / (x : K), hdiv⟩ : ↥V) * x :=
            Subtype.ext (div_mul_cancel₀ (y : K) hx0).symm
          exact hy_eq ▸ I₁.mul_mem_left _ hx₁
        · exfalso
          rw [inv_div] at hinv
          have hx_eq : x = (⟨(x : K) / (y : K), hinv⟩ : ↥V) * y :=
            Subtype.ext (div_mul_cancel₀ (x : K) hy0').symm
          exact hx₂ (hx_eq ▸ I₂.mul_mem_left _ hy₂)
    have hϖ_ex : ∃ (ϖ : ↥V),
        ϖ ∉ P.asIdeal ∧ ∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal := by
      by_cases hNe : S_gt.Nonempty
      · obtain ⟨P_next, hPn_mem, hPn_min⟩ :=
          Set.Finite.exists_minimalFor PrimeSpectrum.asIdeal S_gt hFin_S hNe
        obtain ⟨ϖ, hϖ_in, hϖ_notin⟩ := SetLike.not_le_iff_exists.mp hPn_mem
        refine ⟨ϖ, hϖ_notin, fun Q => ⟨fun hQ => ?_, fun hle hQ => hϖ_notin (hle hQ)⟩⟩
        by_contra hnot_le
        have hle_next : P_next.asIdeal ≤ Q.asIdeal := by
          rcases hTotal P_next.asIdeal Q.asIdeal with h1 | h2
          · exact h1
          · exact hPn_min hnot_le h2
        exact hQ (hle_next hϖ_in)
      · refine ⟨1, fun h1 => P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one),
          fun Q => ⟨fun _ => ?_, fun _ h1 => Q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)⟩⟩
        by_contra hnot_le
        exact hNe ⟨Q, hnot_le⟩
    obtain ⟨ϖ, hϖ_P, hϖ_le⟩ := hϖ_ex
    refine ⟨ϖ, hϖ_P, hϖ_le, fun x => ⟨fun hx => ?_, ?_⟩⟩
    · obtain ⟨⟨a₀, s⟩, hs_eq⟩ := IsLocalization.surj P.asIdeal.primeCompl (⟨x, hx⟩ : ↥W)
      have hs_val : x * V.subtype s.1 = V.subtype a₀ := congrArg Subtype.val hs_eq
      have hϖ_rad : ϖ ∈ (Ideal.span ({s.1} : Set ↥V)).radical := by
        rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
        rintro J ⟨hsJ, hJ_prime⟩
        let Q : PrimeSpectrum ↥V := ⟨J, hJ_prime⟩
        by_contra hϖ_not_J
        have hQ_le : Q.asIdeal ≤ P.asIdeal := (hϖ_le Q).mp hϖ_not_J
        exact s.2 (hQ_le (hsJ (Ideal.subset_span rfl)))
      obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hϖ_rad
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hk
      refine ⟨a₀ * c, k, ?_⟩
      calc
        x * (V.subtype ϖ) ^ k = x * V.subtype (ϖ ^ k) := by rw [map_pow]
        _ = x * V.subtype (s.1 * c) := by rw [hc]
        _ = (x * V.subtype s.1) * V.subtype c := by rw [map_mul, mul_assoc]
        _ = V.subtype a₀ * V.subtype c := by rw [hs_val]
        _ = V.subtype (a₀ * c) := (map_mul V.subtype a₀ c).symm
    · rintro ⟨a, k, hak⟩
      have hϖ_ne : ϖ ≠ 0 := fun h0 => hϖ_P (h0 ▸ P.asIdeal.zero_mem)
      have hϖK_ne : V.subtype ϖ ≠ 0 := fun h0 => hϖ_ne (Subtype.ext h0)
      have hpow_ne : (V.subtype ϖ) ^ k ≠ 0 := pow_ne_zero k hϖK_ne
      have hϖk_compl : ϖ ^ k ∈ P.asIdeal.primeCompl :=
        Submonoid.pow_mem P.asIdeal.primeCompl hϖ_P k
      obtain ⟨u_k, hu_k⟩ := IsLocalization.map_units ↥W ⟨ϖ ^ k, hϖk_compl⟩
      let z : ↥W := algebraMap ↥V ↥W a * ↑u_k⁻¹
      have hz_mul : z * algebraMap ↥V ↥W (ϖ ^ k) = algebraMap ↥V ↥W a := by
        change algebraMap ↥V ↥W a * ↑u_k⁻¹ * algebraMap ↥V ↥W (ϖ ^ k) = algebraMap ↥V ↥W a
        rw [← hu_k, mul_assoc, Units.inv_mul, mul_one]
      have hz_K : z.1 * (V.subtype ϖ) ^ k = x * (V.subtype ϖ) ^ k := by
        have h1 : z.1 * V.subtype (ϖ ^ k) = V.subtype a := congrArg Subtype.val hz_mul
        rw [map_pow] at h1
        exact h1.trans hak.symm
      have hzx : z.1 = x := mul_right_cancel₀ hpow_ne hz_K
      exact hzx ▸ z.2
  obtain ⟨ϖ, hϖ_P, hϖ_le, hϖ_mem⟩ := hAway
  have hUnit_ϖ : IsUnit (algebraMap ↥V ↥W ϖ) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff ↥W P.asIdeal ϖ).mpr hϖ_P
  have hLocAway : IsLocalization.Away ϖ ↥W := by
    refine IsLocalization.Away.mk ϖ hUnit_ϖ ?_ ?_
    · intro s
      obtain ⟨a, k, hak⟩ := (hϖ_mem s.1).mp s.2
      refine ⟨k, a, Subtype.ext ?_⟩
      change W.subtype (s * (algebraMap ↥V ↥W ϖ) ^ k) = W.subtype (algebraMap ↥V ↥W a)
      rw [map_mul, map_pow]
      exact hak
    · intro a b hab
      exact ⟨0, by rw [hInj_VP hab]⟩
  have hOpen_VP : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))) := by
    change AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥W)))
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization ϖ
  have hMax_ne_bot : IsLocalRing.maximalIdeal ↥W ≠ ⊥ := by
    rw [Submodule.ne_bot_iff] at hP ⊢
    obtain ⟨p₀, hp₀_mem, hp₀_ne⟩ := hP
    refine ⟨algebraMap ↥V ↥W p₀, ?_, ?_⟩
    · rw [IsLocalRing.mem_maximalIdeal]
      intro hu
      exact ((IsLocalization.AtPrime.isUnit_to_map_iff ↥W P.asIdeal p₀).mp hu) hp₀_mem
    · intro h0
      exact hp₀_ne (hInj_VP (h0.trans (map_zero _).symm))
  have hHens : HenselianLocalRing ↥W := by
    let 𝔪 : Ideal ↥W := IsLocalRing.maximalIdeal ↥W
    have h𝔪_prime : 𝔪.IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime
    have hGauss : ∀ (g : Polynomial ↥W) (p₁ : Polynomial K),
        g.Monic → p₁.Monic → p₁ ∣ g.map (algebraMap ↥W K) →
        ∃ h q : Polynomial ↥W,
          h.Monic ∧ q.Monic ∧ h.map (algebraMap ↥W K) = p₁ ∧ h.degree = p₁.degree ∧ g = h * q := by
      intro g p₁ hg hp₁ hp₁_dvd
      have h_lifts_ic : p₁ ∈ Polynomial.lifts (algebraMap ↥(integralClosure ↥W K) K) :=
        integralClosure.mem_lifts_of_monic_of_dvd_map K hg hp₁ hp₁_dvd
      rcases h_lifts_ic with ⟨h_ic, hh_ic⟩
      simp only [Polynomial.coe_mapRingHom] at hh_ic
      have hxW : ∀ x : ↥(integralClosure ↥W K), x.1 ∈ W := by
        intro x
        rcases (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := K)).mp x.2 with ⟨y, hy⟩
        exact hy ▸ y.2
      let ρ : ↥(integralClosure ↥W K) →+* ↥W :=
        (integralClosure ↥W K).val.toRingHom.codRestrict W.toSubring hxW
      have hρ_comp : (algebraMap ↥W K).comp ρ = algebraMap ↥(integralClosure ↥W K) K := by
        ext x; rfl
      have h_lifts_W : p₁ ∈ Polynomial.lifts (algebraMap ↥W K) := by
        refine ⟨h_ic.map ρ, ?_⟩
        simp only [Polynomial.coe_mapRingHom]
        rw [Polynomial.map_map, hρ_comp, hh_ic]
      obtain ⟨h, hh_map, hh_deg, hh_monic⟩ :=
        Polynomial.lifts_and_degree_eq_and_monic h_lifts_W hp₁
      have hh_dvd : h ∣ g :=
        Polynomial.Monic.dvd_of_fraction_map_dvd_fraction_map hg hh_monic (hh_map.symm ▸ hp₁_dvd)
      rcases hh_dvd with ⟨q, hg_eq⟩
      have hq_monic : q.Monic := Polynomial.Monic.of_mul_monic_left hh_monic (hg_eq ▸ hg)
      exact ⟨h, q, hh_monic, hq_monic, hh_map, hh_deg, hg_eq⟩
    have hZero : ∀ (n : ℕ) (g : Polynomial ↥W),
        g.natDegree = n → g.Monic → g.eval 0 ∈ 𝔪 → IsUnit (g.derivative.eval 0) →
        ∃ b : ↥W, g.IsRoot b ∧ b ∈ 𝔪 := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro g hn hg hg0 hg'
        have hg'_notMem : g.derivative.eval 0 ∉ 𝔪 :=
          fun hmem => (IsLocalRing.mem_maximalIdeal _).mp hmem hg'
        by_cases hn0 : n = 0
        · exfalso
          have hg1 : g = 1 := Polynomial.eq_one_of_monic_natDegree_zero hg (hn.trans hn0)
          rw [hg1, Polynomial.eval_one] at hg0
          exact h𝔪_prime.ne_top (Ideal.eq_top_of_isUnit_mem _ hg0 isUnit_one)
        · have hn_pos : 0 < n := Nat.pos_of_ne_zero hn0
          let gK : Polynomial K := g.map (algebraMap ↥W K)
          have hgK_monic : gK.Monic := hg.map (algebraMap ↥W K)
          have hgK_deg : gK.natDegree = n := (hg.natDegree_map (algebraMap ↥W K)).trans hn
          have hgK_not_unit : ¬ IsUnit gK :=
            Polynomial.not_isUnit_of_natDegree_pos gK (hgK_deg.symm ▸ hn_pos)
          obtain ⟨p₀, hp₀_irr, hp₀_dvd⟩ :=
            WfDvdMonoid.exists_irreducible_factor hgK_not_unit hgK_monic.ne_zero
          have hp₀_lc_ne : p₀.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp₀_irr.ne_zero
          let p₁ : Polynomial K := p₀ * Polynomial.C p₀.leadingCoeff⁻¹
          have hu_C : IsUnit (Polynomial.C p₀.leadingCoeff⁻¹) :=
            Polynomial.isUnit_C.mpr (Ne.isUnit (inv_ne_zero hp₀_lc_ne))
          have h_assoc : Associated p₀ p₁ := associated_mul_unit_right p₀ _ hu_C
          have hp₁_irr : Irreducible p₁ := h_assoc.irreducible hp₀_irr
          have hp₁_monic : p₁.Monic := Polynomial.monic_mul_leadingCoeff_inv hp₀_irr.ne_zero
          have hp₁_dvd : p₁ ∣ gK := h_assoc.symm.dvd.trans hp₀_dvd
          obtain ⟨h, q, hh_monic, hq_monic, hh_map, hh_deg, hg_eq⟩ :=
            hGauss g p₁ hg hp₁_monic hp₁_dvd
          have h_eval_mul : h.eval 0 * q.eval 0 ∈ 𝔪 := by
            have hev : g.eval 0 = h.eval 0 * q.eval 0 := by rw [hg_eq, Polynomial.eval_mul]
            exact hev ▸ hg0
          have h_deriv_eq :
              g.derivative.eval 0 =
                h.derivative.eval 0 * q.eval 0 + h.eval 0 * q.derivative.eval 0 := by
            rw [hg_eq, Polynomial.derivative_mul, Polynomial.eval_add,
              Polynomial.eval_mul, Polynomial.eval_mul]
          by_cases hh0 : h.eval 0 ∈ 𝔪
          · have hh'_ne : h.derivative.eval 0 ≠ 0 := by
              intro hh'0
              apply hg'_notMem
              rw [h_deriv_eq, hh'0, zero_mul, zero_add]
              exact 𝔪.mul_mem_right _ hh0
            have hh_deriv_ne : h.derivative ≠ 0 := by
              intro hd0
              rw [hd0, Polynomial.eval_zero] at hh'_ne
              exact hh'_ne rfl
            have hp₁_deriv_ne : p₁.derivative ≠ 0 := by
              rw [← hh_map, Polynomial.derivative_map]
              intro hmap0
              exact hh_deriv_ne
                (Polynomial.map_injective (algebraMap ↥W K) Subtype.val_injective
                  (hmap0.trans (Polynomial.map_zero _).symm))
            have hp₁_sep : p₁.Separable := by
              rcases Irreducible.isCoprime_or_dvd hp₁_irr p₁.derivative with hcop | hdvd
              · exact hcop
              · exfalso
                have hle := Polynomial.natDegree_le_of_dvd hdvd hp₁_deriv_ne
                have hlt := Polynomial.natDegree_derivative_lt (Irreducible.natDegree_pos hp₁_irr).ne'
                omega
            have hp₁_deg1 : p₁.degree = 1 :=
              IsSepClosed.degree_eq_one_of_irreducible K hp₁_irr hp₁_sep
            have hh_ndeg1 : h.natDegree = 1 :=
              Polynomial.natDegree_eq_of_degree_eq_some (hh_deg.trans hp₁_deg1)
            have hh_lin : h = Polynomial.X + Polynomial.C (h.coeff 0) :=
              Polynomial.Monic.eq_X_add_C hh_monic hh_ndeg1
            have hc0_mem : h.coeff 0 ∈ 𝔪 := by
              have hev : h.eval 0 = h.coeff 0 := by
                conv_lhs => rw [hh_lin]
                simp
              exact hev ▸ hh0
            refine ⟨-h.coeff 0, ?_, 𝔪.neg_mem hc0_mem⟩
            rw [Polynomial.IsRoot.def, hg_eq, Polynomial.eval_mul]
            have hroot_h : h.eval (-h.coeff 0) = 0 := by
              conv_lhs => rw [hh_lin]
              simp
            rw [hroot_h, zero_mul]
          · have hq0 : q.eval 0 ∈ 𝔪 :=
               (h𝔪_prime.mem_or_mem h_eval_mul).resolve_left hh0
            have hq' : IsUnit (q.derivative.eval 0) := by
              by_contra hnot_u
              have hq'_mem : q.derivative.eval 0 ∈ 𝔪 :=
                (IsLocalRing.mem_maximalIdeal _).mpr hnot_u
              apply hg'_notMem
              rw [h_deriv_eq]
              exact 𝔪.add_mem (𝔪.mul_mem_left _ hq0) (𝔪.mul_mem_left _ hq'_mem)
            have hh_pos : 0 < h.natDegree := by
              have hh_ndeg_eq : p₁.natDegree = h.natDegree := by
                rw [← hh_map]
                exact hh_monic.natDegree_map (algebraMap ↥W K)
              rw [← hh_ndeg_eq]
              exact Irreducible.natDegree_pos hp₁_irr
            have hsum_deg : h.natDegree + q.natDegree = n := by
              rw [← hh_monic.natDegree_mul hq_monic, ← hg_eq, hn]
            obtain ⟨b, hb_root, hb_mem⟩ :=
              ih q.natDegree (by omega) q rfl hq_monic hq0 hq'
            refine ⟨b, ?_, hb_mem⟩
            rw [Polynomial.IsRoot.def, hg_eq, Polynomial.eval_mul, hb_root.eq_zero, mul_zero]
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ hf0 hf'
    let shift : Polynomial ↥W := Polynomial.X + Polynomial.C a₀
    have hshift_monic : shift.Monic := Polynomial.monic_X_add_C a₀
    have hshift_deg : shift.natDegree ≠ 0 := by
      rw [Polynomial.natDegree_X_add_C]
      exact one_ne_zero
    let g : Polynomial ↥W := f.comp shift
    have hg_monic : g.Monic := hf.comp hshift_monic hshift_deg
    have hg0 : g.eval 0 ∈ 𝔪 := by
      have hev : g.eval 0 = f.eval a₀ := by
        simp [g, shift, Polynomial.eval_comp]
      exact hev.symm ▸ hf0
    have hg' : IsUnit (g.derivative.eval 0) := by
      have hderiv : g.derivative.eval 0 = f.derivative.eval a₀ := by
        simp [g, shift, Polynomial.derivative_comp, Polynomial.eval_comp]
      exact hderiv ▸ hf'
    obtain ⟨b, hb_root, hb_mem⟩ := hZero g.natDegree g rfl hg_monic hg0 hg'
    refine ⟨b + a₀, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def]
      have hev : g.eval b = f.eval (b + a₀) := by
        simp [g, shift, Polynomial.eval_comp]
      exact hev ▸ hb_root.eq_zero
    · change b + a₀ - a₀ ∈ 𝔪
      rwa [add_sub_cancel_right]
  have hSatFG_W : ∀ (r : ℕ) (J : Ideal (MvPolynomial (Fin r) ↥W)),
      (∀ (c : ↥W) (f : MvPolynomial (Fin r) ↥W),
        c ≠ 0 → MvPolynomial.C c * f ∈ J → f ∈ J) → J.FG := by
    intro r J hSat
    classical
    let Φ : MvPolynomial (Fin r) ↥V →+* MvPolynomial (Fin r) ↥W :=
      MvPolynomial.map (algebraMap ↥V ↥W)
    let J₀ : Ideal (MvPolynomial (Fin r) ↥V) := Ideal.comap Φ J
    have hSat₀ : ∀ (c : ↥V) (f₀ : MvPolynomial (Fin r) ↥V),
        c ≠ 0 → MvPolynomial.C c * f₀ ∈ J₀ → f₀ ∈ J₀ := by
      intro c f₀ hc hcf
      have hcW : algebraMap ↥V ↥W c ≠ 0 :=
        fun h0 => hc (hInj_VP (h0.trans (map_zero _).symm))
      have hmem : MvPolynomial.C (algebraMap ↥V ↥W c) * Φ f₀ ∈ J := by
        have hmap : Φ (MvPolynomial.C c * f₀) = MvPolynomial.C (algebraMap ↥V ↥W c) * Φ f₀ := by
          simp [Φ]
        exact hmap ▸ hcf
      exact hSat (algebraMap ↥V ↥W c) (Φ f₀) hcW hmem
    obtain ⟨S₀, hS₀⟩ := hPkg.2.2.2.2.2 r J₀ hSat₀
    refine ⟨S₀.image Φ, le_antisymm ?_ ?_⟩
    · rw [Finset.coe_image, Ideal.span_le]
      rintro _ ⟨f₀, hf₀, rfl⟩
      have hf₀_J₀ : f₀ ∈ J₀ := hS₀ ▸ Ideal.subset_span hf₀
      exact hf₀_J₀
    · intro f hf
      let N : ℕ := f.support.sup fun d => (IsLocalization.Away.sec ϖ (f.coeff d)).2
      let f₀ : MvPolynomial (Fin r) ↥V :=
        ∑ d ∈ f.support,
          MvPolynomial.monomial d
            ((IsLocalization.Away.sec ϖ (f.coeff d)).1 *
              ϖ ^ (N - (IsLocalization.Away.sec ϖ (f.coeff d)).2))
      have hΦ_f₀ : Φ f₀ = MvPolynomial.C ((algebraMap ↥V ↥W ϖ) ^ N) * f := by
        simp only [f₀, Φ, map_sum, MvPolynomial.map_monomial]
        conv_rhs => rw [MvPolynomial.as_sum f, Finset.mul_sum]
        refine Finset.sum_congr rfl fun d hd => ?_
        rw [MvPolynomial.C_mul_monomial]
        congr 1
        have hle : (IsLocalization.Away.sec ϖ (f.coeff d)).2 ≤ N :=
          Finset.le_sup (f := fun d => (IsLocalization.Away.sec ϖ (f.coeff d)).2) hd
        have hsec := IsLocalization.Away.sec_spec ϖ (f.coeff d)
        calc
          algebraMap ↥V ↥W
              ((IsLocalization.Away.sec ϖ (f.coeff d)).1 *
                ϖ ^ (N - (IsLocalization.Away.sec ϖ (f.coeff d)).2))
              = algebraMap ↥V ↥W (IsLocalization.Away.sec ϖ (f.coeff d)).1 *
                  algebraMap ↥V ↥W (ϖ ^ (N - (IsLocalization.Away.sec ϖ (f.coeff d)).2)) :=
            map_mul _ _ _
          _ = (f.coeff d * algebraMap ↥V ↥W (ϖ ^ (IsLocalization.Away.sec ϖ (f.coeff d)).2)) *
                algebraMap ↥V ↥W (ϖ ^ (N - (IsLocalization.Away.sec ϖ (f.coeff d)).2)) := by
            rw [← hsec]
          _ = f.coeff d *
                algebraMap ↥V ↥W
                  (ϖ ^ (IsLocalization.Away.sec ϖ (f.coeff d)).2 *
                    ϖ ^ (N - (IsLocalization.Away.sec ϖ (f.coeff d)).2)) := by
            rw [mul_assoc, ← map_mul]
          _ = f.coeff d * algebraMap ↥V ↥W (ϖ ^ N) := by
            rw [← pow_add, Nat.add_sub_of_le hle]
          _ = (algebraMap ↥V ↥W ϖ) ^ N * f.coeff d := by
            rw [map_pow, mul_comm]
      have hf₀_J₀ : f₀ ∈ J₀ := by
        change Φ f₀ ∈ J
        rw [hΦ_f₀]
        exact J.mul_mem_left _ hf
      have hΦ_span : Φ f₀ ∈ Ideal.span ((S₀.image Φ : Finset _) : Set _) := by
        rw [Finset.coe_image, ← Ideal.map_span]
        exact Ideal.mem_map_of_mem Φ (hS₀.symm ▸ hf₀_J₀)
      obtain ⟨u_N, hu_N⟩ := hUnit_ϖ.pow N
      have hmul_inv :
          MvPolynomial.C (↑u_N⁻¹ : ↥W) * Φ f₀ ∈ Ideal.span ((S₀.image Φ : Finset _) : Set _) :=
        Ideal.mul_mem_left _ _ hΦ_span
      have h_cancel : MvPolynomial.C (↑u_N⁻¹ : ↥W) * Φ f₀ = f := by
        rw [hΦ_f₀, ← hu_N, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
      exact h_cancel ▸ hmul_inv
  have hFinSpecV : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hPkg.1
  have hInjSpec : Function.Injective (PrimeSpectrum.comap (algebraMap ↥V ↥W)) :=
    PrimeSpectrum.localization_comap_injective ↥W P.asIdeal.primeCompl
  have hFinSpecW : Finite (PrimeSpectrum ↥W) := Finite.of_injective _ hInjSpec
  have hPkg_W : IsValuationRingAlgPackage m W := by
    refine ⟨Set.finite_univ, (Nat.card_le_card_of_injective _ hInjSpec).trans hPkg.2.1,
      hHens, ?_, ?_, hSatFG_W⟩
    · intro a ha d hd
      obtain ⟨b, u, hu, hbu⟩ := hPkg.2.2.2.1 a ha d hd
      exact ⟨b, algebraMap ↥V ↥W u, hu.map (algebraMap ↥V ↥W), hbu⟩
    · intro Q_P hQP_prime hQP_ne
      let Q : Ideal ↥V := Ideal.comap (algebraMap ↥V ↥W) Q_P
      have _ : Q.IsPrime := hQP_prime.comap (algebraMap ↥V ↥W)
      have hQ_ne : Q ≠ ⊥ := by
        rw [Submodule.ne_bot_iff] at hQP_ne ⊢
        obtain ⟨z, hz_mem, hz_ne⟩ := hQP_ne
        obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj P.asIdeal.primeCompl z
        have ha_Q : a ∈ Q := by
          change algebraMap ↥V ↥W a ∈ Q_P
          rw [← hzs]
          exact Q_P.mul_mem_right _ hz_mem
        have ha_ne : a ≠ 0 := by
          intro ha0
          rw [ha0, map_zero] at hzs
          have hs_ne : algebraMap ↥V ↥W s.1 ≠ 0 := by
            intro hs0
            have hs1_eq : s.1 = 0 := hInj_VP (hs0.trans (map_zero _).symm)
            exact s.2 (hs1_eq ▸ P.asIdeal.zero_mem)
          exact hz_ne ((mul_eq_zero.mp hzs).resolve_right hs_ne)
        exact ⟨a, ha_Q, ha_ne⟩
      have _ : IsAlgClosed Q.ResidueField := hPkg.2.2.2.2.1 Q hQ_ne
      have hBij : Function.Bijective (Ideal.ResidueField.map Q Q_P (algebraMap ↥V ↥W) rfl) :=
        (RingHom.surjectiveOnStalks_of_isLocalization P.asIdeal.primeCompl ↥W).residueFieldMap_bijective
          Q Q_P rfl
      exact IsAlgClosed.of_ringEquiv Q.ResidueField Q_P.ResidueField
        (RingEquiv.ofBijective (Ideal.ResidueField.map Q Q_P (algebraMap ↥V ↥W) rfl) hBij)
  exact ⟨hPkg_W, hMax_ne_bot, ϖ, hϖ_P, hϖ_le, hϖ_mem, hOpen_VP⟩

theorem weil_clopen_p1_component_smooth_charts_and_henselian_section (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K)
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥)
    (hPkg_VP : IsValuationRingAlgPackage m (V.ofPrime P.asIdeal))
    (hMax_VP : IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥)
    (ϖ : ↥V) (hϖ_P : ϖ ∉ P.asIdeal)
    (hϖ_le : ∀ Q : PrimeSpectrum ↥V, ϖ ∉ Q.asIdeal ↔ Q.asIdeal ≤ P.asIdeal)
    (hϖ_mem : ∀ x : K, x ∈ V.ofPrime P.asIdeal ↔
      ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a)
    (hOpen_VP : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))))
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hNorm_cur : IsAffineNormalScheme C_cur)
    (hFin_P : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))).Finite)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_mem : Z ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_P1 : ∃ (Z_sch : AlgebraicGeometry.Scheme.{u})
        (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))
        (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver P.asIdeal.ResidueField 1).left),
      AlgebraicGeometry.IsClosedImmersion ιZ ∧
      AlgebraicGeometry.IsIntegral Z_sch ∧
      Set.range ιZ.base = Z ∧
      ιZ ≫ CategoryTheory.Limits.pullback.snd g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver P.asIdeal.ResidueField 1).hom) :
    let s_P := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
    let Y_P := CategoryTheory.Limits.pullback g_cur s_P
    let Δ_Z : Set ↥Y_P :=
      {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}
    let R_P := ↥(V.ofPrime P.asIdeal)
    let ι_VP : ↥V →+* R_P := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
    Δ_Z.Finite ∧
    (∃ (q_R : R_P →+* P.asIdeal.ResidueField),
      Function.Surjective q_R ∧
      RingHom.ker q_R = IsLocalRing.maximalIdeal R_P ∧
      q_R.comp ι_VP = algebraMap ↥V P.asIdeal.ResidueField) ∧
    (Δ_Z = ∅ →
      ∀ (X_0 : C_cur.Opens)
        (g_X0 : X_0.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_P)),
        (∀ q ∈ Z, (CategoryTheory.Limits.pullback.fst g_cur s_P).base q ∈ X_0) →
        g_X0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) = X_0.ι ≫ g_cur →
        (∀ q ∈ Z,
          ∃ (V_q : X_0.toScheme.Opens) (hVq_aff : AlgebraicGeometry.IsAffineOpen V_q)
            (ψ_q : Polynomial R_P →+* ↑(X_0.toScheme.presheaf.obj (Opposite.op V_q))),
            (∃ hx : (CategoryTheory.Limits.pullback.fst g_cur s_P).base q ∈ X_0,
              (⟨(CategoryTheory.Limits.pullback.fst g_cur s_P).base q, hx⟩ : ↥X_0.toScheme) ∈ V_q) ∧
            (∀ q' : ↥Y_P, ∀ hx' : (CategoryTheory.Limits.pullback.fst g_cur s_P).base q' ∈ X_0,
              (⟨(CategoryTheory.Limits.pullback.fst g_cur s_P).base q', hx'⟩ : ↥X_0.toScheme) ∈ V_q →
              q' ∈ Z) ∧
            ψ_q.Etale ∧
            (V_q.ι ≫ g_X0 =
              hVq_aff.isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_q.comp Polynomial.C))) ∧
            (Ideal.map (ψ_q.comp Polynomial.C) (IsLocalRing.maximalIdeal R_P)).IsPrime) ∧
        (∃ (q_0 : ↥Y_P) (σ_0 : AlgebraicGeometry.Spec (CommRingCat.of R_P) ⟶ X_0.toScheme),
          q_0 ∈ Z ∧
          σ_0 ≫ g_X0 = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_P)) ∧
          (σ_0 ≫ X_0.ι).base
              ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩ =
            (CategoryTheory.Limits.pullback.fst g_cur s_P).base q_0)) :=
by
  classical
  intro s_P Y_P Δ_Z R_P ι_VP
  let κ_P := P.asIdeal.ResidueField
  let fst_P := CategoryTheory.Limits.pullback.fst g_cur s_P
  let snd_P := CategoryTheory.Limits.pullback.snd g_cur s_P
  
  have step_s2 : ∀ (κ : Type u) [Field κ]
      (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of κ)),
      (irreducibleComponents ↥Y).Finite →
      ∀ (Z : Set ↥Y),
        Z ∈ irreducibleComponents ↥Y →
        (∃ (Z_sch : AlgebraicGeometry.Scheme.{u})
            (ιZ : Z_sch ⟶ Y)
            (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver κ 1).left),
          AlgebraicGeometry.IsClosedImmersion ιZ ∧
          AlgebraicGeometry.IsIntegral Z_sch ∧
          Set.range ιZ.base = Z ∧
          ιZ ≫ p_Y = isoP1.hom ≫ (weilProjectiveSpaceOver κ 1).hom) →
        {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y, E' ≠ Z ∧ q ∈ E'}.Finite ∧
        ∃ (σ_Z : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ Y),
          σ_Z ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
          ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)), σ_Z.base x ∈ Z := by
    intro κ _ Y p_Y hFin Z hZ_mem hZ_P1
    obtain ⟨Z_sch, ιZ, isoP1, _hClZ, hIntZ, hRangeZ, hCommZ⟩ := hZ_P1
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) κ
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hX_mem : ∀ a : Fin (1 + 1),
        (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) ∈ 𝒜 1 :=
      fun a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X κ a)
    have hDehom : ∀ a : Fin (1 + 1),
        ∃ (e_a : Polynomial κ ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)),
          e_a.toRingHom.comp Polynomial.C =
            (algebraMap ↥(𝒜 0) (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))).comp
              (algebraMap κ ↥(𝒜 0)) := by
      intro a
      have hXa : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) ∈ 𝒜 1 := hX_mem a
      let b_a : Fin (1 + 1) := if a = 0 then 1 else 0
      have hba_ne : b_a ≠ a := by fin_cases a <;> decide
      have hXba : (MvPolynomial.X b_a : MvPolynomial (Fin (1 + 1)) κ) ∈ 𝒜 (1 • 1) := by
        rw [one_smul]; exact hX_mem b_a
      let c_0 : κ →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
        (algebraMap ↥(𝒜 0) (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))).comp
          (algebraMap κ ↥(𝒜 0))
      let t_a : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
        HomogeneousLocalization.Away.mk 𝒜 hXa 1 (MvPolynomial.X b_a) hXba
      let toHL : Polynomial κ →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
        Polynomial.eval₂RingHom c_0 t_a
      let val_hom : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let ev_a : MvPolynomial (Fin (1 + 1)) κ →+* Polynomial κ :=
        MvPolynomial.eval₂Hom Polynomial.C (fun j : Fin (1 + 1) => if j = a then 1 else Polynomial.X)
      have hev_Xa : IsUnit (ev_a (MvPolynomial.X a)) := by
        simp [ev_a]
      let lift_a : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) →+*
          Polynomial κ :=
        IsLocalization.Away.lift (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) hev_Xa
      let fromHL : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) →+* Polynomial κ :=
        lift_a.comp val_hom
      have hc0_val : ∀ c : κ,
          val_hom (c_0 c) = algebraMap (MvPolynomial (Fin (1 + 1)) κ)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
            (MvPolynomial.C c) := by
        intro c
        change HomogeneousLocalization.val
          ((algebraMap ↥(𝒜 0) (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)))
            (algebraMap κ ↥(𝒜 0) c)) = _
        rw [HomogeneousLocalization.algebraMap_eq]
        change Localization.mk (algebraMap κ ↥(𝒜 0) c).1 1 = _
        rw [Localization.mk_one_eq_algebraMap]
        rfl
      have hta_mul : val_hom t_a *
          algebraMap (MvPolynomial (Fin (1 + 1)) κ)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
            (MvPolynomial.X a) =
          algebraMap (MvPolynomial (Fin (1 + 1)) κ)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
            (MvPolynomial.X b_a) := by
        change HomogeneousLocalization.val t_a * _ = _
        rw [HomogeneousLocalization.Away.val_mk,
          congrFun (congrFun Localization.mk_eq_mk' (MvPolynomial.X b_a)) _]
        let s_1 : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) :=
          ⟨MvPolynomial.X a, 1, pow_one _⟩
        have hpow1 : (⟨(MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) ^ 1, 1, rfl⟩ :
            Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) = s_1 :=
          Subtype.ext (pow_one _)
        rw [hpow1]
        exact IsLocalization.mk'_spec _ (MvPolynomial.X b_a) s_1
      have h_left : fromHL.comp toHL = RingHom.id (Polynomial κ) := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [fromHL, toHL, RingHom.comp_apply, RingHom.id_apply]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hc0_val c,
            IsLocalization.Away.lift_eq
              (x := (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) hev_Xa,
            MvPolynomial.eval₂Hom_C]
        · simp only [fromHL, toHL, RingHom.comp_apply, RingHom.id_apply]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          have h_one : lift_a (algebraMap (MvPolynomial (Fin (1 + 1)) κ)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
              (MvPolynomial.X a)) = 1 := by
            rw [IsLocalization.Away.lift_eq
              (x := (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) hev_Xa]
            simp [ev_a]
          calc
            lift_a (val_hom t_a)
                = lift_a (val_hom t_a) * 1 := (mul_one _).symm
            _ = lift_a (val_hom t_a) *
                  lift_a (algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ (MvPolynomial.X a)) := by
                  rw [h_one]
            _ = lift_a (val_hom t_a *
                  algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ (MvPolynomial.X a)) :=
                  (map_mul _ _ _).symm
            _ = lift_a (algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ (MvPolynomial.X b_a)) := by
                  rw [hta_mul]
            _ = ev_a (MvPolynomial.X b_a) :=
                  IsLocalization.Away.lift_eq
                    (x := (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) hev_Xa _
            _ = Polynomial.X := by simp [ev_a, hba_ne]
      have h_right : ∀ z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a),
          toHL (fromHL z) = z := by
        intro z
        apply HomogeneousLocalization.val_injective
          (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
        induction z using Quotient.inductionOn' with
        | h nd =>
          change val_hom (toHL (lift_a (val_hom (HomogeneousLocalization.mk nd)))) =
            val_hom (HomogeneousLocalization.mk nd)
          have h_mk_val : val_hom (HomogeneousLocalization.mk nd) =
              IsLocalization.mk'
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
                nd.num.1 ⟨nd.den.1, nd.den_mem⟩ :=
            congrFun (congrFun Localization.mk_eq_mk' nd.num.1) ⟨nd.den.1, nd.den_mem⟩
          obtain ⟨n, hn⟩ := nd.den_mem
          by_cases hnum0 : nd.num.1 = 0
          · have hz0 : val_hom (HomogeneousLocalization.mk nd) = 0 := by
              rw [h_mk_val, hnum0, IsLocalization.mk'_zero]
            rw [hz0, map_zero, map_zero, map_zero]
          · have h_deg_eq : nd.deg = n := by
              have hden_hom : MvPolynomial.IsHomogeneous
                  ((MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) ^ n) nd.deg := by
                have h := (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
                rwa [← hn] at h
              have hpow_hom : MvPolynomial.IsHomogeneous
                  ((MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) ^ n) n := by
                simpa using (MvPolynomial.isHomogeneous_X κ a).pow n
              have hpow_ne : ((MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) ^ n) ≠ 0 :=
                pow_ne_zero n (MvPolynomial.X_ne_zero a)
              obtain ⟨d_0, hd_0⟩ := MvPolynomial.support_nonempty.mpr hpow_ne
              have h1 := hden_hom (MvPolynomial.mem_support_iff.mp hd_0)
              have h2 := hpow_hom (MvPolynomial.mem_support_iff.mp hd_0)
              exact h1.symm.trans h2
            have hnum_hom : MvPolynomial.IsHomogeneous nd.num.1 n := by
              rw [← h_deg_eq]
              exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
            let s_n : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ) :=
              ⟨(MvPolynomial.X a) ^ n, n, rfl⟩
            have h_z_mul : val_hom (HomogeneousLocalization.mk nd) *
                algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ ((MvPolynomial.X a) ^ n) =
                algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ nd.num.1 := by
              rw [h_mk_val]
              have hsub_eq : (⟨nd.den.1, nd.den_mem⟩ :
                  Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) = s_n :=
                Subtype.ext hn.symm
              rw [hsub_eq]
              exact IsLocalization.mk'_spec _ nd.num.1 s_n
            have h_lift_eq : lift_a (val_hom (HomogeneousLocalization.mk nd)) = ev_a nd.num.1 := by
              have h_pow_one : lift_a (algebraMap (MvPolynomial (Fin (1 + 1)) κ) _
                  ((MvPolynomial.X a) ^ n)) = 1 := by
                rw [map_pow, map_pow, IsLocalization.Away.lift_eq
                  (x := (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) hev_Xa]
                simp [ev_a]
              calc
                lift_a (val_hom (HomogeneousLocalization.mk nd))
                    = lift_a (val_hom (HomogeneousLocalization.mk nd)) * 1 := (mul_one _).symm
                _ = lift_a (val_hom (HomogeneousLocalization.mk nd)) *
                      lift_a (algebraMap _ _ ((MvPolynomial.X a) ^ n)) := by rw [h_pow_one]
                _ = lift_a (val_hom (HomogeneousLocalization.mk nd) *
                      algebraMap _ _ ((MvPolynomial.X a) ^ n)) := (map_mul _ _ _).symm
                _ = lift_a (algebraMap _ _ nd.num.1) := by rw [h_z_mul]
                _ = ev_a nd.num.1 :=
                      IsLocalization.Away.lift_eq
                        (x := (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)) hev_Xa nd.num.1
            rw [h_lift_eq]
            have hXa_pow_unit : IsUnit (algebraMap (MvPolynomial (Fin (1 + 1)) κ)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ))
                ((MvPolynomial.X a) ^ n)) := by
              rw [map_pow]
              exact (IsLocalization.Away.algebraMap_isUnit
                (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) κ)).pow n
            apply hXa_pow_unit.mul_right_cancel
            rw [h_z_mul]
            conv_lhs => rw [nd.num.1.as_sum]
            conv_rhs => rw [nd.num.1.as_sum]
            rw [map_sum, map_sum, map_sum, Finset.sum_mul, map_sum]
            refine Finset.sum_congr rfl fun d hd => ?_
            have hd_01 : d 0 + d 1 = n := by
              have hw := hnum_hom (MvPolynomial.mem_support_iff.mp hd)
              simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
            have hd_sum : d a + d b_a = n := by
              fin_cases a
              · change d 0 + d 1 = n; exact hd_01
              · change d 1 + d 0 = n; omega
            have h_mon : (MvPolynomial.monomial d) (nd.num.1.coeff d) =
                MvPolynomial.C (nd.num.1.coeff d) *
                  (MvPolynomial.X a) ^ (d a) * (MvPolynomial.X b_a) ^ (d b_a) := by
              rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
                Fin.prod_univ_two]
              fin_cases a
              · change MvPolynomial.C (nd.num.1.coeff d) * (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
                  MvPolynomial.C (nd.num.1.coeff d) * MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1
                ring
              · change MvPolynomial.C (nd.num.1.coeff d) * (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
                  MvPolynomial.C (nd.num.1.coeff d) * MvPolynomial.X 1 ^ d 1 * MvPolynomial.X 0 ^ d 0
                ring
            rw [h_mon]
            simp only [ev_a, map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
              ↓reduceIte, hba_ne, one_pow, mul_one]
            simp only [toHL, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval₂_X]
            rw [hc0_val, ← hd_sum, pow_add]
            have h_ta_pow : (val_hom t_a) ^ (d b_a) *
                (algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ (MvPolynomial.X a)) ^ (d b_a) =
                (algebraMap (MvPolynomial (Fin (1 + 1)) κ) _ (MvPolynomial.X b_a)) ^ (d b_a) := by
              rw [← mul_pow, hta_mul]
            calc
              algebraMap _ _ (MvPolynomial.C (nd.num.1.coeff d)) * (val_hom t_a) ^ (d b_a) *
                  ((algebraMap _ _ (MvPolynomial.X a)) ^ (d a) *
                    (algebraMap _ _ (MvPolynomial.X a)) ^ (d b_a))
                  = algebraMap _ _ (MvPolynomial.C (nd.num.1.coeff d)) *
                      (algebraMap _ _ (MvPolynomial.X a)) ^ (d a) *
                      ((val_hom t_a) ^ (d b_a) *
                        (algebraMap _ _ (MvPolynomial.X a)) ^ (d b_a)) := by ring
              _ = algebraMap _ _ (MvPolynomial.C (nd.num.1.coeff d)) *
                    (algebraMap _ _ (MvPolynomial.X a)) ^ (d a) *
                    (algebraMap _ _ (MvPolynomial.X b_a)) ^ (d b_a) := by rw [h_ta_pow]
      refine ⟨{ toFun := toHL
                invFun := fromHL
                left_inv := RingHom.congr_fun h_left
                right_inv := h_right
                map_mul' := map_mul toHL
                map_add' := map_add toHL }, ?_⟩
      exact RingHom.ext fun c => Polynomial.eval₂_C _ _
    choose e_dehom he_dehom_C using hDehom
    let ψ_0 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X (0 : Fin (1 + 1))) →+* κ :=
      (Polynomial.evalRingHom 0).comp (e_dehom 0).symm.toRingHom
    have hψ0_comp :
        (ψ_0.comp (algebraMap ↥(𝒜 0) _)).comp (algebraMap κ ↥(𝒜 0)) = RingHom.id κ := by
      ext c
      have h1 : (algebraMap ↥(𝒜 0)
            (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X (0 : Fin (1 + 1)))))
          (algebraMap κ ↥(𝒜 0) c) = e_dehom 0 (Polynomial.C c) :=
        (RingHom.congr_fun (he_dehom_C 0) c).symm
      change ψ_0 ((algebraMap ↥(𝒜 0) _) (algebraMap κ ↥(𝒜 0) c)) = c
      rw [h1]
      simp [ψ_0]
    let ι_away_proj : ∀ a : Fin (1 + 1),
        AlgebraicGeometry.Spec (CommRingCat.of
          (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) ⟶
        AlgebraicGeometry.Proj 𝒜 :=
      fun a => AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX_mem a) zero_lt_one
    let ι_away : ∀ a : Fin (1 + 1),
        AlgebraicGeometry.Spec (CommRingCat.of
          (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) ⟶
        (weilProjectiveSpaceOver κ 1).left := ι_away_proj
    let σ_Z : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ Y :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ≫ ι_away 0 ≫ isoP1.inv ≫ ιZ
    have hσZ_sec : σ_Z ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
      dsimp only [σ_Z]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hCommZ, CategoryTheory.Iso.inv_hom_id_assoc]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ≫
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X (0 : Fin (1 + 1)))
            (hX_mem 0) zero_lt_one ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ ↥(𝒜 0))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(𝒜 0) _)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ ↥(𝒜 0))) = _
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        hψ0_comp]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of κ)
    have hσZ_in_Z : ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)), σ_Z.base x ∈ Z := by
      intro x
      rw [← hRangeZ]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ≫ ι_away 0 ≫ isoP1.inv).base x, rfl⟩
    refine ⟨?_, ⟨σ_Z, hσZ_sec, hσZ_in_Z⟩⟩
    have h_eq_biUnion :
        {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y, E' ≠ Z ∧ q ∈ E'} =
          ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, Z ∩ E' := by
      ext q
      simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_sdiff, Set.mem_singleton_iff,
        Set.mem_inter_iff]
      exact ⟨fun ⟨hqZ, E', hE', hne, hqE'⟩ => ⟨E', ⟨hE', hne⟩, hqZ, hqE'⟩,
        fun ⟨E', ⟨hE', hne⟩, hqZ, hqE'⟩ => ⟨hqZ, E', hE', hne, hqE'⟩⟩
    rw [h_eq_biUnion]
    refine hFin.sdiff.biUnion fun E' hE' => ?_
    rcases hE' with ⟨hE'_mem, hE'_ne⟩
    have hE'_closed : IsClosed E' := isClosed_of_mem_irreducibleComponents E' hE'_mem
    have h_not_sub : ¬ (Z ⊆ E') := by
      intro hsub
      exact hE'_ne (le_antisymm (hZ_mem.2 hE'_mem.1 hsub) hsub)
    rw [Set.not_subset] at h_not_sub
    obtain ⟨q_out, hq_out_Z, hq_out_not_E'⟩ := h_not_sub
    let P1 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
    let f_P1 : P1 ⟶ Y := isoP1.inv ≫ ιZ
    have hf_P1_range : Set.range f_P1.base = Z := by
      have h_surj_inv : Function.Surjective isoP1.inv.base :=
        (ConcreteCategory.bijective_of_isIso isoP1.inv.base).2
      change Set.range (ιZ.base ∘ isoP1.inv.base) = Z
      rw [Set.range_comp, Set.range_eq_univ.mpr h_surj_inv, Set.image_univ, hRangeZ]
    have h_inter_img : Z ∩ E' = f_P1.base '' (f_P1.base ⁻¹' E') := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_image, Set.mem_preimage]
      refine ⟨fun ⟨hyZ, hyE'⟩ => ?_, ?_⟩
      · rw [← hf_P1_range] at hyZ
        rcases hyZ with ⟨x, rfl⟩
        exact ⟨x, hyE', rfl⟩
      · rintro ⟨x, hxE', rfl⟩
        rw [← hf_P1_range]
        exact ⟨⟨x, rfl⟩, hxE'⟩
    rw [h_inter_img]
    apply Set.Finite.image
    let K_cl : Set ↥P1 := f_P1.base ⁻¹' E'
    have hK_closed : IsClosed K_cl := hE'_closed.preimage f_P1.continuous
    have hK_compl_ne : (K_clᶜ).Nonempty := by
      rw [← hf_P1_range] at hq_out_Z
      rcases hq_out_Z with ⟨x_out, rfl⟩
      exact ⟨x_out, hq_out_not_E'⟩
    have hIrred_Z : IrreducibleSpace ↥Z_sch :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral Z_sch hIntZ
    have h_surj_hom : Function.Surjective isoP1.hom.base :=
      (ConcreteCategory.bijective_of_isIso isoP1.hom.base).2
    have h_univ_P1_irr : IsIrreducible (Set.univ : Set ↥P1) := by
      have h_img_eq : isoP1.hom.base '' (Set.univ : Set ↥Z_sch) = (Set.univ : Set ↥P1) :=
        Set.image_univ_of_surjective h_surj_hom
      rw [← h_img_eq]
      exact (IrreducibleSpace.isIrreducible_univ (X := ↥Z_sch)).image
        isoP1.hom.base isoP1.hom.continuous.continuousOn
    have _ : PreirreducibleSpace ↥P1 := ⟨h_univ_P1_irr.isPreirreducible⟩
    let U_chart : Fin (1 + 1) → P1.Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    have h_cover_P1 : ∀ y : ↥P1, y ∈ U_chart 0 ∨ y ∈ U_chart 1 := by
      intro y
      by_contra h_neither
      have hy0 : y ∉ U_chart 0 := fun h0 => h_neither (Or.inl h0)
      have hy1 : y ∉ U_chart 1 := fun h1 => h_neither (Or.inr h1)
      let y_ps : ProjectiveSpectrum 𝒜 := y
      let I_y : Ideal (MvPolynomial (Fin (1 + 1)) κ) := y_ps.asHomogeneousIdeal.toIdeal
      have hx0_mem : (MvPolynomial.X (0 : Fin (1 + 1)) : MvPolynomial (Fin (1 + 1)) κ) ∈ I_y := by
        have hm :=
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X (0 : Fin (1 + 1))) y).not.mp hy0
        exact not_not.mp hm
      have hx1_mem : (MvPolynomial.X (1 : Fin (1 + 1)) : MvPolynomial (Fin (1 + 1)) κ) ∈ I_y := by
        have hm :=
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X (1 : Fin (1 + 1))) y).not.mp hy1
        exact not_not.mp hm
      apply y_ps.not_irrelevant_le
      intro P hP
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hP
      change P ∈ I_y
      rw [← DirectSum.sum_support_decompose 𝒜 P]
      refine I_y.sum_mem fun d _ => ?_
      by_cases hd0 : d = 0
      · subst hd0
        have h0 : (DirectSum.decompose 𝒜 P 0 : MvPolynomial (Fin (1 + 1)) κ) = 0 := by
          change (GradedRing.proj 𝒜 0 P) = 0
          exact hP
        rw [h0]
        exact I_y.zero_mem
      · let Q : MvPolynomial (Fin (1 + 1)) κ := DirectSum.decompose 𝒜 P d
        have hQ_hom : MvPolynomial.IsHomogeneous Q d :=
          (MvPolynomial.mem_homogeneousSubmodule d Q).mp (DirectSum.decompose 𝒜 P d).2
        change Q ∈ I_y
        rw [Q.as_sum]
        refine I_y.sum_mem fun m hm => ?_
        have hm_sum : m 0 + m 1 = d := by
          have hw := hQ_hom (MvPolynomial.mem_support_iff.mp hm)
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_two]
        by_cases hm0 : 1 ≤ m 0
        · obtain ⟨k₀, hk₀⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : m 0 ≠ 0)
          rw [hk₀, pow_succ]
          have h_prod : MvPolynomial.C (Q.coeff m) *
              (MvPolynomial.X (0 : Fin (1 + 1)) ^ k₀ * MvPolynomial.X (0 : Fin (1 + 1)) *
                MvPolynomial.X (1 : Fin (1 + 1)) ^ m 1) =
              (MvPolynomial.C (Q.coeff m) * MvPolynomial.X 0 ^ k₀ * MvPolynomial.X 1 ^ m 1) *
                MvPolynomial.X 0 := by ring
          rw [h_prod]
          exact I_y.mul_mem_left _ hx0_mem
        · have hm1_ne : m 1 ≠ 0 := by omega
          obtain ⟨k₁, hk₁⟩ := Nat.exists_eq_succ_of_ne_zero hm1_ne
          rw [hk₁, pow_succ]
          have h_prod : MvPolynomial.C (Q.coeff m) *
              (MvPolynomial.X (0 : Fin (1 + 1)) ^ m 0 *
                (MvPolynomial.X (1 : Fin (1 + 1)) ^ k₁ * MvPolynomial.X (1 : Fin (1 + 1)))) =
              (MvPolynomial.C (Q.coeff m) * MvPolynomial.X 0 ^ m 0 * MvPolynomial.X 1 ^ k₁) *
                MvPolynomial.X 1 := by ring
          rw [h_prod]
          exact I_y.mul_mem_left _ hx1_mem
    have hK_union : K_cl = (K_cl ∩ (U_chart 0 : Set ↥P1)) ∪ (K_cl ∩ (U_chart 1 : Set ↥P1)) := by
      ext y
