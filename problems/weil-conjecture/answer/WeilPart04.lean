    AlgebraicGeometry.Spec.map_preimage (τ_V0 ≫ hV0_aff.isoSpec.hom)
  have hev0 : ev_0.comp (ψ_0.comp Polynomial.C) = q_R := by
    suffices h_hom : CommRingCat.ofHom (ev_0.comp (ψ_0.comp Polynomial.C)) = CommRingCat.ofHom q_R from
      congrArg CommRingCat.Hom.hom h_hom
    apply AlgebraicGeometry.Spec.map_injective
    rw [← CategoryTheory.cancel_mono (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP))]
    have h_ev_lhs :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_0.comp (ψ_0.comp Polynomial.C))) =
          (τ_V0 ≫ hV0_aff.isoSpec.hom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_0.comp Polynomial.C)) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      exact congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_0.comp Polynomial.C)))
        hev_spec
    rw [h_ev_lhs]
    calc
      ((τ_V0 ≫ hV0_aff.isoSpec.hom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_0.comp Polynomial.C))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)
          = (τ_V0 ≫ (hV0_aff.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_0.comp Polynomial.C)))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) := by
            rw [CategoryTheory.Category.assoc τ_V0]
      _ = (τ_V0 ≫ (V_0.ι ≫ g_X0)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) := by
            rw [← hV0_g]
      _ = τ_V0 ≫ V_0.ι ≫ (g_X0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)) := by
            simp only [CategoryTheory.Category.assoc]
      _ = τ_V0 ≫ V_0.ι ≫ (X_0.ι ≫ g_cur) := by rw [hg_X0_comm]
      _ = (τ_V0 ≫ V_0.ι ≫ X_0.ι) ≫ g_cur := by
            simp only [CategoryTheory.Category.assoc]
      _ = (σ_Z ≫ fst_P) ≫ g_cur := by rw [hτ_fac]
      _ = σ_Z ≫ (fst_P ≫ g_cur) := CategoryTheory.Category.assoc _ _ _
      _ = σ_Z ≫ (snd_P ≫ s_P) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = (σ_Z ≫ snd_P) ≫ s_P := (CategoryTheory.Category.assoc _ _ _).symm
      _ = 𝟙 _ ≫ s_P := by rw [hσZ_sec]
      _ = s_P := CategoryTheory.Category.id_comp _
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) := by
            rw [hs_P, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
  obtain ⟨α_0, hα0_id, hα0_ev⟩ :=
    step_s5 (V.ofPrime P.asIdeal) κ_P q_R hq_surj hq_ker B_0 ψ_0 hψ0_etale ev_0 hev0
  let σ_0 : AlgebraicGeometry.Spec (CommRingCat.of R_P) ⟶ X_0.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0) ≫ hV0_aff.fromSpec
  have hσ0_sec : σ_0 ≫ g_X0 = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_P)) := by
    have hV0_from_g : hV0_aff.fromSpec ≫ g_X0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_0.comp Polynomial.C)) := by
      rw [← hV0_aff.isoSpec_inv_ι, CategoryTheory.Category.assoc, hV0_g,
        CategoryTheory.Iso.inv_hom_id_assoc]
      rfl
    calc
      σ_0 ≫ g_X0
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0) ≫ (hV0_aff.fromSpec ≫ g_X0) :=
            CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_0.comp Polynomial.C)) := by
            rw [hV0_from_g]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_0.comp (ψ_0.comp Polynomial.C))) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id R_P)) := by
            rw [hα0_id]
      _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_P)) :=
            AlgebraicGeometry.Spec.map_id (CommRingCat.of R_P)
  have hσ0_pt :
      (σ_0 ≫ X_0.ι).base
          ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩ =
        fst_P.base q_0 := by
    have h_m_eq :
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)).base pt_κ =
          ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩ :=
      PrimeSpectrum.ext hq_ker
    have h_ev_step :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_R.comp α_0)) =
          τ_V0 ≫ hV0_aff.isoSpec.hom := by
      rw [hα0_ev]
      exact hev_spec
    have h_comp_pt :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R) ≫ (σ_0 ≫ X_0.ι) =
          σ_Z ≫ fst_P := by
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R) ≫ (σ_0 ≫ X_0.ι)
            = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0)) ≫
                hV0_aff.fromSpec ≫ X_0.ι := by
              simp only [σ_0, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_R.comp α_0)) ≫
              hV0_aff.fromSpec ≫ X_0.ι := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = (τ_V0 ≫ hV0_aff.isoSpec.hom) ≫ hV0_aff.fromSpec ≫ X_0.ι :=
              congrArg (· ≫ hV0_aff.fromSpec ≫ X_0.ι) h_ev_step
        _ = τ_V0 ≫ (hV0_aff.isoSpec.hom ≫ hV0_aff.fromSpec) ≫ X_0.ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = τ_V0 ≫ V_0.ι ≫ X_0.ι := by
              rw [← hV0_aff.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
        _ = σ_Z ≫ fst_P := hτ_fac
    rw [← h_m_eq]
    exact congrArg (fun f => f.base pt_κ) h_comp_pt
  exact ⟨q_0, σ_0, hq0_Z, hσ0_sec, hσ0_pt⟩

theorem weil_etale_polynomial_gauss_valuation_stalk (K : Type u) [Field K]
    (R : ValuationSubring K)
    (B F : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [Field F]
    (ψ : Polynomial ↥R →+* B) (φ : B →+* F)
    (hψ : ψ.Etale)
    (hFrac : @IsFractionRing B _ F _ φ.toAlgebra)
    (h𝔔 : (Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R)).IsPrime) :
    let 𝔔 : Ideal B := Ideal.map (ψ.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥R)
    (∀ r : ↥R, r ≠ 0 → ψ (Polynomial.C r) ≠ 0) ∧
    ∃ (W : ValuationSubring F) (hB : ∀ x : B, φ x ∈ W),
      (∀ x : B, (⟨φ x, hB x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ x ∈ 𝔔) ∧
      (∀ y ∈ W, ∃ (s w : B), s ∉ 𝔔 ∧ y * φ s = φ w) ∧
      (∀ b₀ : B, b₀ ≠ 0 →
        ∃ (r : ℕ) (c₁ c₂ : ↥R) (u_W : ↥W),
          1 ≤ r ∧
          c₁ ≠ 0 ∧
          c₂ ≠ 0 ∧
          IsUnit u_W ∧
          (φ b₀) ^ r * φ (ψ (Polynomial.C c₂)) = φ (ψ (Polynomial.C c₁)) * u_W.1) :=
by
  intro 𝔔
  classical
  let A₀ := Polynomial ↥R
  let E := FractionRing A₀
  let 𝔪_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  let I_G : Ideal A₀ := Ideal.map Polynomial.C 𝔪_R
  have h𝔔_eq : 𝔔 = Ideal.map ψ I_G := (Ideal.map_map Polynomial.C ψ).symm

  
  have hMinVal : ∀ {K' : Type u} [Field K'] (V' : ValuationSubring K')
      (S : Finset ℕ), S.Nonempty → ∀ (f : ℕ → K'), (∀ i ∈ S, f i ≠ 0) →
      ∃ i₀ ∈ S, ∀ i ∈ S, f i / f i₀ ∈ V' := by
    intro K' _ V' S hS
    refine Finset.Nonempty.cons_induction
      (motive := fun s _ => ∀ (f : ℕ → K'), (∀ i ∈ s, f i ≠ 0) →
        ∃ i₀ ∈ s, ∀ i ∈ s, f i / f i₀ ∈ V')
      ?_ ?_ hS
    · intro a f hf
      refine ⟨a, Finset.mem_singleton_self a, fun i hi => ?_⟩
      rw [Finset.mem_singleton.mp hi, div_self (hf a (Finset.mem_singleton_self a))]
      exact V'.toSubring.one_mem
    · intro a s _ _ ih f hf
      have hfa : f a ≠ 0 := hf a (Finset.mem_cons_self a s)
      obtain ⟨i₁, hi₁, hdiv₁⟩ := ih f (fun i hi => hf i (Finset.mem_cons_of_mem hi))
      have hfi₁ : f i₁ ≠ 0 := hf i₁ (Finset.mem_cons_of_mem hi₁)
      rcases ValuationSubring.mem_or_inv_mem V' (f a / f i₁) with h_ai₁ | h_inv
      · refine ⟨i₁, Finset.mem_cons_of_mem hi₁, fun i hi => ?_⟩
        rcases Finset.mem_cons.mp hi with rfl | hi_s
        · exact h_ai₁
        · exact hdiv₁ i hi_s
      · rw [inv_div] at h_inv
        refine ⟨a, Finset.mem_cons_self a s, fun i hi => ?_⟩
        rcases Finset.mem_cons.mp hi with rfl | hi_s
        · rw [div_self hfa]
          exact V'.toSubring.one_mem
        · have heq : f i / f a = (f i / f i₁) * (f i₁ / f a) := by
            field_simp [hfi₁, hfa]
          rw [heq]
          exact V'.toSubring.mul_mem (hdiv₁ i hi_s) h_inv

  
  have hIG_prime : I_G.IsPrime := by
    haveI : 𝔪_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
    letI : Field (↥R ⧸ 𝔪_R) := Ideal.Quotient.field 𝔪_R
    let pi_G : A₀ →+* Polynomial (↥R ⧸ 𝔪_R) := Polynomial.mapRingHom (Ideal.Quotient.mk 𝔪_R)
    have hIG_ker : I_G = RingHom.ker pi_G := by
      ext P
      rw [Ideal.mem_map_C_iff, RingHom.mem_ker, Polynomial.ext_iff]
      refine ⟨fun h n => ?_, fun h n => ?_⟩
      · change (Polynomial.map (Ideal.Quotient.mk 𝔪_R) P).coeff n = 0
        rw [Polynomial.coeff_map, Ideal.Quotient.eq_zero_iff_mem]
        exact h n
      · have hn : (Polynomial.map (Ideal.Quotient.mk 𝔪_R) P).coeff n = 0 := by
          change (pi_G P).coeff n = 0
          rw [h n, Polynomial.coeff_zero]
        rw [Polynomial.coeff_map, Ideal.Quotient.eq_zero_iff_mem] at hn
        exact hn
    rw [hIG_ker]
    exact RingHom.ker_isPrime pi_G

  have hMinDvd : ∀ (S : Finset ℕ), S.Nonempty → ∀ (f : ℕ → ↥R),
      ∃ i₀ ∈ S, ∀ i ∈ S, f i₀ ∣ f i := by
    intro S hS
    refine Finset.Nonempty.cons_induction
      (motive := fun s _ => ∀ (f : ℕ → ↥R), ∃ i₀ ∈ s, ∀ i ∈ s, f i₀ ∣ f i)
      ?_ ?_ hS
    · intro a f
      exact ⟨a, Finset.mem_singleton_self a, fun i hi => by rw [Finset.mem_singleton.mp hi]⟩
    · intro a s _ _ ih f
      obtain ⟨i₁, hi₁, hdvd₁⟩ := ih f
      rcases ValuationRing.dvd_total (f a) (f i₁) with ha_i₁ | hi₁_a
      · refine ⟨a, Finset.mem_cons_self a s, fun i hi => ?_⟩
        rcases Finset.mem_cons.mp hi with rfl | hi_s
        · exact dvd_refl _
        · exact dvd_trans ha_i₁ (hdvd₁ i hi_s)
      · refine ⟨i₁, Finset.mem_cons_of_mem hi₁, fun i hi => ?_⟩
        rcases Finset.mem_cons.mp hi with rfl | hi_s
        · exact hi₁_a
        · exact hdvd₁ i hi_s

  have hContent : ∀ P : A₀, P ≠ 0 →
      ∃ (c : ↥R) (P₀ : A₀), c ≠ 0 ∧ P₀ ∉ I_G ∧ P = Polynomial.C c * P₀ := by
    intro P hP
    obtain ⟨i₀, hi₀, hdvd⟩ := hMinDvd P.support (Polynomial.support_nonempty.mpr hP) P.coeff
    let c : ↥R := P.coeff i₀
    have hc_ne : c ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hdvd_all : ∀ n : ℕ, ∃ q : ↥R, P.coeff n = c * q := by
      intro n
      by_cases hn : n ∈ P.support
      · exact hdvd n hn
      · exact ⟨0, by rw [Polynomial.notMem_support_iff.mp hn, mul_zero]⟩
    choose q hq using hdvd_all
    let P₀ : A₀ := ∑ i ∈ P.support, Polynomial.monomial i (q i)
    have hP₀_coeff : ∀ n : ℕ, P₀.coeff n = if n ∈ P.support then q n else 0 := by
      intro n
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial]
      by_cases hn : n ∈ P.support
      · rw [if_pos hn, Finset.sum_ite_eq' P.support n q, if_pos hn]
      · rw [if_neg hn, Finset.sum_eq_zero]
        intro i hi
        rw [if_neg (fun h : i = n => hn (h ▸ hi))]
    have hP_eq : P = Polynomial.C c * P₀ := by
      ext n
      rw [Polynomial.coeff_C_mul, hP₀_coeff n]
      by_cases hn : n ∈ P.support
      · rw [if_pos hn, ← hq n]
      · rw [if_neg hn, mul_zero, Polynomial.notMem_support_iff.mp hn]
    have hqi₀ : q i₀ = 1 := by
      apply mul_left_cancel₀ hc_ne
      rw [← hq i₀, mul_one]
    have hP₀_not_IG : P₀ ∉ I_G := by
      intro hmem
      have h1 : P₀.coeff i₀ ∈ 𝔪_R := (Ideal.mem_map_C_iff.mp hmem) i₀
      rw [hP₀_coeff i₀, if_pos hi₀, hqi₀] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal ↥R).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    exact ⟨c, P₀, hc_ne, hP₀_not_IG, hP_eq⟩

  have h1_not_IG : (1 : A₀) ∉ I_G :=
    fun h1 => hIG_prime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hA₀E_inj : Function.Injective (algebraMap A₀ E) := IsFractionRing.injective A₀ E

  let subring_G : Subring E :=
    { carrier := {z : E | ∃ P Q : A₀, Q ∉ I_G ∧ z * algebraMap A₀ E Q = algebraMap A₀ E P}
      one_mem' := ⟨1, 1, h1_not_IG, by simp⟩
      zero_mem' := ⟨0, 1, h1_not_IG, by simp⟩
      mul_mem' := by
        rintro a b ⟨P₁, Q₁, hQ₁, heq₁⟩ ⟨P₂, Q₂, hQ₂, heq₂⟩
        refine ⟨P₁ * P₂, Q₁ * Q₂, hIG_prime.mul_notMem hQ₁ hQ₂, ?_⟩
        simp only [map_mul]
        calc (a * b) * (algebraMap A₀ E Q₁ * algebraMap A₀ E Q₂)
            = (a * algebraMap A₀ E Q₁) * (b * algebraMap A₀ E Q₂) := by ring
          _ = algebraMap A₀ E P₁ * algebraMap A₀ E P₂ := by rw [heq₁, heq₂]
      add_mem' := by
        rintro a b ⟨P₁, Q₁, hQ₁, heq₁⟩ ⟨P₂, Q₂, hQ₂, heq₂⟩
        refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, hIG_prime.mul_notMem hQ₁ hQ₂, ?_⟩
        simp only [map_add, map_mul]
        calc (a + b) * (algebraMap A₀ E Q₁ * algebraMap A₀ E Q₂)
            = (a * algebraMap A₀ E Q₁) * algebraMap A₀ E Q₂ +
              (b * algebraMap A₀ E Q₂) * algebraMap A₀ E Q₁ := by ring
          _ = algebraMap A₀ E P₁ * algebraMap A₀ E Q₂ +
              algebraMap A₀ E P₂ * algebraMap A₀ E Q₁ := by rw [heq₁, heq₂]
      neg_mem' := by
        rintro a ⟨P, Q, hQ, heq⟩
        refine ⟨-P, Q, hQ, ?_⟩
        rw [map_neg, neg_mul, heq] }

  let G : ValuationSubring E :=
    { toSubring := subring_G
      mem_or_inv_mem' := by
        intro z
        by_cases hz : z = 0
        · exact Or.inl (hz ▸ subring_G.zero_mem)
        · obtain ⟨⟨P, Q_nz⟩, hPQ⟩ := IsLocalization.surj (nonZeroDivisors A₀) z
          have hQ_ne : Q_nz.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp Q_nz.2
          have hmapQ_ne : algebraMap A₀ E Q_nz.1 ≠ 0 :=
            fun h0 => hQ_ne (hA₀E_inj (h0.trans (map_zero _).symm))
          have hP_ne : P ≠ 0 := by
            intro h0
            rw [h0, map_zero] at hPQ
            exact mul_ne_zero hz hmapQ_ne hPQ
          obtain ⟨cP, P₀, hcP_ne, hP₀, hP_eq⟩ := hContent P hP_ne
          obtain ⟨cQ, Q₀, hcQ_ne, hQ₀, hQ_eq⟩ := hContent Q_nz.1 hQ_ne
          have hCcP_ne : algebraMap A₀ E (Polynomial.C cP) ≠ 0 :=
            fun h0 => hcP_ne (Polynomial.C_injective
              ((hA₀E_inj (h0.trans (map_zero _).symm)).trans Polynomial.C_0.symm))
          have hCcQ_ne : algebraMap A₀ E (Polynomial.C cQ) ≠ 0 :=
            fun h0 => hcQ_ne (Polynomial.C_injective
              ((hA₀E_inj (h0.trans (map_zero _).symm)).trans Polynomial.C_0.symm))
          rcases ValuationRing.dvd_total cQ cP with ⟨r, hr⟩ | ⟨r', hr'⟩
          · left
            refine ⟨Polynomial.C r * P₀, Q₀, hQ₀, ?_⟩
            apply mul_left_cancel₀ hCcQ_ne
            calc algebraMap A₀ E (Polynomial.C cQ) * (z * algebraMap A₀ E Q₀)
                = z * algebraMap A₀ E (Polynomial.C cQ * Q₀) := by rw [map_mul]; ring
              _ = z * algebraMap A₀ E Q_nz.1 := by rw [← hQ_eq]
              _ = algebraMap A₀ E P := hPQ
              _ = algebraMap A₀ E (Polynomial.C (cQ * r) * P₀) := by rw [hP_eq, hr]
              _ = algebraMap A₀ E (Polynomial.C cQ) *
                    algebraMap A₀ E (Polynomial.C r * P₀) := by
                  simp only [Polynomial.C_mul, map_mul, mul_assoc]
          · right
            refine ⟨Polynomial.C r' * Q₀, P₀, hP₀, ?_⟩
            have hcancel : z * algebraMap A₀ E (Polynomial.C r' * Q₀) = algebraMap A₀ E P₀ := by
              apply mul_left_cancel₀ hCcP_ne
              calc algebraMap A₀ E (Polynomial.C cP) *
                    (z * algebraMap A₀ E (Polynomial.C r' * Q₀))
                  = z * algebraMap A₀ E (Polynomial.C (cP * r') * Q₀) := by
                      simp only [Polynomial.C_mul, map_mul]; ring
                _ = z * algebraMap A₀ E Q_nz.1 := by rw [← hr', ← hQ_eq]
                _ = algebraMap A₀ E P := hPQ
                _ = algebraMap A₀ E (Polynomial.C cP) * algebraMap A₀ E P₀ := by
                      rw [hP_eq, map_mul]
            calc z⁻¹ * algebraMap A₀ E P₀
                = z⁻¹ * (z * algebraMap A₀ E (Polynomial.C r' * Q₀)) := by rw [← hcancel]
              _ = (z⁻¹ * z) * algebraMap A₀ E (Polynomial.C r' * Q₀) := (mul_assoc _ _ _).symm
              _ = algebraMap A₀ E (Polynomial.C r' * Q₀) := by rw [inv_mul_cancel₀ hz, one_mul] }

  have hG_max_imp : ∀ z : ↥G, z ∈ IsLocalRing.maximalIdeal ↥G →
      ∃ (P Q : A₀), P ∈ I_G ∧ Q ∉ I_G ∧
        z.1 * algebraMap A₀ E Q = algebraMap A₀ E P := by
    intro z hz
    obtain ⟨P, Q, hQ, heq⟩ := z.2
    refine ⟨P, Q, ?_, hQ, heq⟩
    by_contra hP_not
    have hz1 : z.1 ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at heq
      have hP0 : P = 0 := hA₀E_inj (heq.symm.trans (map_zero _).symm)
      exact hP_not (hP0 ▸ I_G.zero_mem)
    have hz_inv_mem : z.1⁻¹ ∈ G := by
      refine ⟨Q, P, hP_not, ?_⟩
      calc z.1⁻¹ * algebraMap A₀ E P
          = z.1⁻¹ * (z.1 * algebraMap A₀ E Q) := by rw [← heq]
        _ = (z.1⁻¹ * z.1) * algebraMap A₀ E Q := (mul_assoc _ _ _).symm
        _ = algebraMap A₀ E Q := by rw [inv_mul_cancel₀ hz1, one_mul]
    have hu : IsUnit z :=
      ⟨⟨z, ⟨z.1⁻¹, hz_inv_mem⟩, Subtype.ext (mul_inv_cancel₀ hz1),
        Subtype.ext (inv_mul_cancel₀ hz1)⟩, rfl⟩
    exact (IsLocalRing.mem_maximalIdeal z).mp hz hu

  
  have hGoingDown : Function.Injective ψ ∧ Ideal.comap ψ 𝔔 = I_G := by
    letI : Algebra A₀ B := ψ.toAlgebra
    haveI : Algebra.Etale A₀ B := RingHom.etale_algebraMap.mp hψ
    haveI : Algebra.HasGoingDown A₀ B := Algebra.HasGoingDown.of_flat
    refine ⟨?_, ?_⟩
    · rw [RingHom.injective_iff_ker_eq_bot]
      let q₀ : Ideal A₀ := (⊥ : Ideal B).under A₀
      haveI : q₀.IsPrime := Ideal.comap_isPrime ψ (⊥ : Ideal B)
      haveI : (⊥ : Ideal B).LiesOver q₀ := ⟨rfl⟩
      obtain ⟨P, hP_le, _, hP_over⟩ :=
        Ideal.exists_ideal_le_liesOver_of_le (p := (⊥ : Ideal A₀)) (q := q₀) (⊥ : Ideal B) bot_le
      have hP_bot : P = ⊥ := le_bot_iff.mp hP_le
      have h_under : P.under A₀ = ⊥ := hP_over.over.symm
      rw [hP_bot] at h_under
      exact h_under
    · let q₁ : Ideal A₀ := 𝔔.under A₀
      haveI : 𝔔.IsPrime := h𝔔
      haveI : q₁.IsPrime := Ideal.comap_isPrime ψ 𝔔
      haveI : 𝔔.LiesOver q₁ := ⟨rfl⟩
      haveI : I_G.IsPrime := hIG_prime
      have hIG_le : I_G ≤ q₁ := by
        change I_G ≤ Ideal.comap ψ 𝔔
        rw [h𝔔_eq]
        exact Ideal.le_comap_map
      obtain ⟨P₁, hP₁_le, _, hP₁_over⟩ :=
        Ideal.exists_ideal_le_liesOver_of_le (p := I_G) (q := q₁) 𝔔 hIG_le
      have h_comap_P₁ : Ideal.comap ψ P₁ = I_G := hP₁_over.over.symm
      have h𝔔_le_P₁ : 𝔔 ≤ P₁ := by
        rw [h𝔔_eq, Ideal.map_le_iff_le_comap, h_comap_P₁]
      have hP₁_eq : P₁ = 𝔔 := le_antisymm hP₁_le h𝔔_le_P₁
      rw [← hP₁_eq]
      exact h_comap_P₁

  obtain ⟨hψ_inj, h_comap_𝔔⟩ := hGoingDown
  have hψ_𝔔 : ∀ P : A₀, ψ P ∈ 𝔔 ↔ P ∈ I_G := by
    intro P
    rw [← h_comap_𝔔, Ideal.mem_comap]

  have hψC_ne : ∀ r : ↥R, r ≠ 0 → ψ (Polynomial.C r) ≠ 0 := by
    intro r hr h0
    apply hr
    apply Polynomial.C_injective
    rw [Polynomial.C_0]
    exact hψ_inj (h0.trans (map_zero ψ).symm)

  letI : Algebra B F := φ.toAlgebra
  haveI : IsFractionRing B F := hFrac
  have hφ_inj : Function.Injective φ := IsFractionRing.injective B F

  have hφψ_unit : ∀ s : nonZeroDivisors A₀, IsUnit ((φ.comp ψ) s) := by
    intro s
    have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    have hψs_ne : ψ s.1 ≠ 0 := fun h0 => hs_ne (hψ_inj (h0.trans (map_zero ψ).symm))
    have hφψs_ne : φ (ψ s.1) ≠ 0 := fun h0 => hψs_ne (hφ_inj (h0.trans (map_zero φ).symm))
    exact IsUnit.mk0 (φ (ψ s.1)) hφψs_ne

  let ι_EF : E →+* F := IsLocalization.lift (M := nonZeroDivisors A₀) hφψ_unit
  have hι_EF : ∀ P : A₀, ι_EF (algebraMap A₀ E P) = φ (ψ P) := by
    intro P
    exact IsLocalization.lift_eq (M := nonZeroDivisors A₀) hφψ_unit P

  have hAlg : ∀ y : F, ∃ P : Polynomial E, P ≠ 0 ∧ Polynomial.eval₂ ι_EF y P = 0 := by
    letI : Algebra A₀ B := ψ.toAlgebra
    haveI : Algebra.Etale A₀ B := RingHom.etale_algebraMap.mp hψ
    letI : Algebra E F := ι_EF.toAlgebra
    letI : Algebra A₀ F := (φ.comp ψ).toAlgebra
    haveI : IsScalarTower A₀ E F := ⟨fun a e x => by
      rw [Algebra.smul_def a e]
      change ι_EF (algebraMap A₀ E a * e) * x = φ (ψ a) * (ι_EF e * x)
      rw [map_mul, hι_EF a, mul_assoc]⟩
    let L := TensorProduct A₀ E B
    haveI : Algebra.Etale E L := Algebra.Etale.baseChange A₀ B E
    have hFinL : Module.Finite E L := by
      obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, e_prod, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod E L).mp inferInstance
      haveI : Finite I := hFinI
      haveI : ∀ i : I, Module.Finite E (Ai i) := fun i => (hFinSep i).1
      exact Module.Finite.equiv e_prod.symm.toLinearEquiv
    haveI : Module.Finite E L := hFinL
    haveI : Algebra.IsIntegral E L := Algebra.IsIntegral.of_finite E L
    let φ_alg : B →ₐ[A₀] F := ⟨φ, fun _ => rfl⟩
    let ι_LF : L →ₐ[E] F :=
      Algebra.TensorProduct.lift (Algebra.ofId E F) φ_alg (fun _ _ => Commute.all _ _)
    have h_clear : ∀ z : L, ∃ (s : nonZeroDivisors A₀) (b : B),
        (algebraMap A₀ E s.1) • z = (1 : E) ⊗ₜ[A₀] b := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact ⟨1, 0, by simp⟩
      | tmul e b =>
        obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors A₀) e
        refine ⟨s, ψ a * b, ?_⟩
        have hs' : algebraMap A₀ E s.1 * e = algebraMap A₀ E a := by
          rw [mul_comm]; exact hs
        calc (algebraMap A₀ E s.1) • (e ⊗ₜ[A₀] b)
            = (algebraMap A₀ E s.1 * e) ⊗ₜ[A₀] b := by
                rw [TensorProduct.smul_tmul', smul_eq_mul]
          _ = (algebraMap A₀ E a) ⊗ₜ[A₀] b := by rw [hs']
          _ = (a • (1 : E)) ⊗ₜ[A₀] b := by rw [Algebra.smul_def, mul_one]
          _ = (1 : E) ⊗ₜ[A₀] (a • b) := TensorProduct.smul_tmul a (1 : E) b
          _ = (1 : E) ⊗ₜ[A₀] (ψ a * b) := rfl
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨s₁, b₁, h₁⟩ := ih₁
        obtain ⟨s₂, b₂, h₂⟩ := ih₂
        refine ⟨s₁ * s₂, ψ s₂.1 * b₁ + ψ s₁.1 * b₂, ?_⟩
        have hs_mul : algebraMap A₀ E (s₁ * s₂).1 = algebraMap A₀ E s₂.1 * algebraMap A₀ E s₁.1 := by
          change algebraMap A₀ E (s₁.1 * s₂.1) = _
          rw [map_mul, mul_comm]
        have h_smul_tmul : ∀ (c : A₀) (b : B),
            (algebraMap A₀ E c) • ((1 : E) ⊗ₜ[A₀] b) = (1 : E) ⊗ₜ[A₀] (ψ c * b) := by
          intro c b
          calc (algebraMap A₀ E c) • ((1 : E) ⊗ₜ[A₀] b)
              = (algebraMap A₀ E c * 1) ⊗ₜ[A₀] b := by
                  rw [TensorProduct.smul_tmul', smul_eq_mul]
            _ = (c • (1 : E)) ⊗ₜ[A₀] b := by rw [Algebra.smul_def]
            _ = (1 : E) ⊗ₜ[A₀] (c • b) := TensorProduct.smul_tmul c (1 : E) b
            _ = (1 : E) ⊗ₜ[A₀] (ψ c * b) := rfl
        rw [smul_add, hs_mul, mul_smul, h₁, h_smul_tmul,
          mul_comm (algebraMap A₀ E s₂.1), mul_smul, h₂, h_smul_tmul, TensorProduct.tmul_add]
    have hι_LF_inj : Function.Injective ι_LF := by
      rw [RingHom.injective_iff_ker_eq_bot]
      ext z
      rw [RingHom.mem_ker, Ideal.mem_bot]
      refine ⟨fun hz => ?_, fun hz => by rw [hz, map_zero]⟩
      obtain ⟨s, b, hsb⟩ := h_clear z
      have hmap_b : φ b = 0 := by
        have h1 : ι_LF ((algebraMap A₀ E s.1) • z) = ι_LF ((1 : E) ⊗ₜ[A₀] b) :=
          congrArg ι_LF hsb
        rw [map_smul, hz, smul_zero, Algebra.TensorProduct.lift_tmul, map_one, one_mul] at h1
        exact h1.symm
      have hb0 : b = 0 := hφ_inj (hmap_b.trans (map_zero φ).symm)
      rw [hb0, TensorProduct.tmul_zero] at hsb
      have hs_ne : algebraMap A₀ E s.1 ≠ 0 :=
        fun h0 => (mem_nonZeroDivisors_iff_ne_zero.mp s.2) (hA₀E_inj (h0.trans (map_zero _).symm))
      calc z = (algebraMap A₀ E s.1)⁻¹ • ((algebraMap A₀ E s.1) • z) := by
            rw [inv_smul_smul₀ hs_ne]
        _ = 0 := by rw [hsb, smul_zero]
    haveI : IsDomain L := Function.Injective.isDomain ι_LF.toRingHom hι_LF_inj
    have hIsFieldL : IsField L :=
      (Algebra.IsIntegral.isField_iff_isField (RingHom.injective (algebraMap E L))).mp
        (Field.toIsField E)
    have hι_LF_surj : Function.Surjective ι_LF := by
      intro y
      obtain ⟨⟨b₁, b₂⟩, hb⟩ := IsLocalization.surj (nonZeroDivisors B) y
      have hb₂_ne : φ b₂.1 ≠ 0 :=
        fun h0 => (mem_nonZeroDivisors_iff_ne_zero.mp b₂.2)
          (hφ_inj (h0.trans (map_zero φ).symm))
      let z₂ : L := (1 : E) ⊗ₜ[A₀] b₂.1
      have hz₂_map : ι_LF z₂ = φ b₂.1 := by
        dsimp only [z₂, ι_LF]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have hz₂_ne : z₂ ≠ 0 := fun h0 => hb₂_ne (hz₂_map.symm.trans (by rw [h0, map_zero]))
      obtain ⟨w_L, hw_L⟩ := hIsFieldL.mul_inv_cancel hz₂_ne
      refine ⟨((1 : E) ⊗ₜ[A₀] b₁) * w_L, ?_⟩
      apply mul_right_cancel₀ hb₂_ne
      calc ι_LF (((1 : E) ⊗ₜ[A₀] b₁) * w_L) * φ b₂.1
          = ι_LF ((1 : E) ⊗ₜ[A₀] b₁) * (ι_LF w_L * ι_LF z₂) := by
              rw [← hz₂_map, map_mul, mul_assoc]
        _ = φ b₁ * ι_LF (z₂ * w_L) := by
              rw [← map_mul, mul_comm w_L z₂]
              dsimp only [ι_LF]
              rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
              rfl
        _ = φ b₁ := by rw [hw_L, map_one, mul_one]
        _ = y * φ b₂.1 := hb.symm
    let e_LF : L ≃ₐ[E] F := AlgEquiv.ofBijective ι_LF ⟨hι_LF_inj, hι_LF_surj⟩
    haveI : Module.Finite E F := Module.Finite.equiv e_LF.toLinearEquiv
    haveI : Algebra.IsIntegral E F := Algebra.IsIntegral.of_finite E F
    intro y
    obtain ⟨P, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := E) y
    exact ⟨P, hP_monic.ne_zero, hP_eval⟩

  
  let e_rng : B ≃+* ↥φ.range :=
    RingEquiv.ofBijective φ.rangeRestrict
      ⟨fun x y hxy => hφ_inj (congrArg Subtype.val hxy), φ.rangeRestrict_surjective⟩
  have he_val : ∀ b : B, (e_rng b : F) = φ b := fun _ => rfl
  let P_rng : Ideal ↥φ.range := Ideal.comap e_rng.symm.toRingHom 𝔔
  haveI : 𝔔.IsPrime := h𝔔
  haveI : P_rng.IsPrime := Ideal.comap_isPrime e_rng.symm.toRingHom 𝔔
  have hP_rng_mem : ∀ b : B, e_rng b ∈ P_rng ↔ b ∈ 𝔔 := by
    intro b
    change e_rng.symm (e_rng b) ∈ 𝔔 ↔ b ∈ 𝔔
    rw [e_rng.symm_apply_apply]

  let A_loc : LocalSubring F := LocalSubring.ofPrime φ.range P_rng
  have h_to_A_val : ∀ b : B,
      ((algebraMap ↥φ.range ↥A_loc.toSubring (e_rng b) : ↥A_loc.toSubring) : F) = φ b :=
    fun b => he_val b

  have hA_mem_iff : ∀ y : F, y ∈ A_loc.toSubring ↔ ∃ (s w : B), s ∉ 𝔔 ∧ y * φ s = φ w := by
    intro y
    refine ⟨fun hy => ?_, fun ⟨s, w, hs, h_ysw⟩ => ?_⟩
    · obtain ⟨⟨w_r, s_r⟩, h_eq⟩ :=
        IsLocalization.surj P_rng.primeCompl (⟨y, hy⟩ : ↥A_loc.toSubring)
      let s : B := e_rng.symm s_r.1
      let w : B := e_rng.symm w_r
      have hs_not : s ∉ 𝔔 := s_r.2
      have h_val : y * φ s = φ w := by
        have h1 := congrArg Subtype.val h_eq
        have hs_eq : e_rng s = s_r.1 := e_rng.apply_symm_apply s_r.1
        have hw_eq : e_rng w = w_r := e_rng.apply_symm_apply w_r
        change y * ((algebraMap ↥φ.range ↥A_loc.toSubring s_r.1 : ↥A_loc.toSubring) : F) =
          ((algebraMap ↥φ.range ↥A_loc.toSubring w_r : ↥A_loc.toSubring) : F) at h1
        rw [← hs_eq, ← hw_eq, h_to_A_val s, h_to_A_val w] at h1
        exact h1
      exact ⟨s, w, hs_not, h_val⟩
    · have hs_unit : IsUnit (algebraMap ↥φ.range ↥A_loc.toSubring (e_rng s)) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff ↥A_loc.toSubring P_rng (e_rng s)).mpr
          (fun hm => hs ((hP_rng_mem s).mp hm))
      obtain ⟨s_inv, hs_inv⟩ := hs_unit.exists_right_inv
      have hs_val : φ s * (s_inv : F) = 1 := by
        rw [← h_to_A_val s]
        exact congrArg Subtype.val hs_inv
      have hy_eq : y = φ w * (s_inv : F) := by
        calc y = y * (φ s * (s_inv : F)) := by rw [hs_val, mul_one]
          _ = (y * φ s) * (s_inv : F) := (mul_assoc _ _ _).symm
          _ = φ w * (s_inv : F) := by rw [h_ysw]
      rw [hy_eq, ← h_to_A_val w]
      exact A_loc.toSubring.mul_mem
        (algebraMap ↥φ.range ↥A_loc.toSubring (e_rng w)).2 s_inv.2

  have hIC : IsIntegrallyClosedIn ↥A_loc.toSubring F := by
    rw [Subring.isIntegrallyClosedIn_iff]
    intro x hx
    haveI : IsScalarTower ↥φ.range ↥A_loc.toSubring F := ⟨fun r a z => mul_assoc r.1 a.1 z⟩
    obtain ⟨m, hm_int⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization P_rng.primeCompl x hx
    let s_m : B := e_rng.symm m.1
    have hs_m : s_m ∉ 𝔔 := m.2
    have hm_val : m • x = φ s_m * x := by
      have hm_eq : e_rng s_m = m.1 := e_rng.apply_symm_apply m.1
      change (m.1 : F) * x = φ s_m * x
      rw [← hm_eq, he_val s_m]
    rw [hm_val] at hm_int
    have hcomp : (algebraMap B F).comp e_rng.symm.toRingHom =
        (RingHom.id F).comp (algebraMap ↥φ.range F) := by
      ext u
      have hu : e_rng (e_rng.symm u) = u := e_rng.apply_symm_apply u
      change φ (e_rng.symm u) = u.1
      rw [← he_val (e_rng.symm u), hu]
    have hInt_B : IsIntegral B (φ s_m * x) :=
      IsIntegral.map_of_comp_eq e_rng.symm.toRingHom (RingHom.id F) hcomp hm_int
    obtain ⟨w_m, hw_m⟩ := (isIntegrallyClosed_iff F).mp ‹IsIntegrallyClosed B› hInt_B
    have hx_eq : x * φ s_m = φ w_m := by
      rw [mul_comm]
      exact hw_m.symm
    exact (hA_mem_iff x).mpr ⟨s_m, w_m, hs_m, hx_eq⟩

  
  obtain ⟨W, hAW⟩ := LocalSubring.exists_le_valuationSubring A_loc
  obtain ⟨hA_sub, hA_loc⟩ := LocalSubring.le_def.mp hAW
  let inc_AW : ↥A_loc.toSubring →+* ↥W := Subring.inclusion hA_sub
  haveI : IsLocalHom inc_AW := hA_loc

  have hG_mem : ∀ g : E, g ∈ G → ι_EF g ∈ A_loc.toSubring := by
    intro g hg
    obtain ⟨P, Q, hQ, heq⟩ := hg
    have hψQ : ψ Q ∉ 𝔔 := fun hm => hQ ((hψ_𝔔 Q).mp hm)
    refine (hA_mem_iff (ι_EF g)).mpr ⟨ψ Q, ψ P, hψQ, ?_⟩
    rw [← hι_EF Q, ← hι_EF P, ← map_mul, heq]

  let ι_GA : ↥G →+* ↥A_loc.toSubring :=
    (ι_EF.comp G.subtype).codRestrict A_loc.toSubring (fun g => hG_mem g.1 g.2)

  have hG_max : ∀ g : ↥G, g ∈ IsLocalRing.maximalIdeal ↥G →
      ι_GA g ∈ IsLocalRing.maximalIdeal ↥A_loc.toSubring := by
    intro g hg
    obtain ⟨P, Q, hP, hQ, heq⟩ := hG_max_imp g hg
    have hψP : ψ P ∈ 𝔔 := (hψ_𝔔 P).mpr hP
    have hψQ : ψ Q ∉ 𝔔 := fun hm => hQ ((hψ_𝔔 Q).mp hm)
    have hQ_unit : IsUnit (algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ Q))) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff ↥A_loc.toSubring P_rng (e_rng (ψ Q))).mpr
        (fun hm => hψQ ((hP_rng_mem (ψ Q)).mp hm))
    have hP_max : algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ P)) ∈
        IsLocalRing.maximalIdeal ↥A_loc.toSubring :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff ↥A_loc.toSubring P_rng (e_rng (ψ P))).mpr
        ((hP_rng_mem (ψ P)).mpr hψP)
    have h_prod : ι_GA g * algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ Q)) =
        algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ P)) := by
      apply Subtype.ext
      change ι_EF g.1 * ((algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ Q)) :
        ↥A_loc.toSubring) : F) =
        ((algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ P)) : ↥A_loc.toSubring) : F)
      rw [h_to_A_val (ψ Q), h_to_A_val (ψ P), ← hι_EF Q, ← hι_EF P, ← map_mul, heq]
    by_contra hg_not_max
    have hg_unit : IsUnit (ι_GA g) := by
      by_contra hnu
      exact hg_not_max ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
    have hP_unit : IsUnit (algebraMap ↥φ.range ↥A_loc.toSubring (e_rng (ψ P))) := by
      rw [← h_prod]
      exact hg_unit.mul hQ_unit
    exact (IsLocalRing.mem_maximalIdeal _).mp hP_max hP_unit

  
  have hWA : ∀ y : F, y ∈ W → y ∈ A_loc.toSubring := by
    intro y hy
    by_cases hy0 : y = 0
    · exact hy0 ▸ A_loc.toSubring.zero_mem
    · obtain ⟨P, hP_ne, hP_eval⟩ := hAlg y
      let d : ℕ := P.natDegree
      obtain ⟨i₀, hi₀, h_min⟩ :=
        hMinVal G P.support (Polynomial.support_nonempty.mpr hP_ne) P.coeff
          (fun _ hi => Polynomial.mem_support_iff.mp hi)
      let p₀ : E := P.coeff i₀
      have hp₀_ne : p₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
      have hιp₀_ne : ι_EF p₀ ≠ 0 :=
        fun h0 => hp₀_ne ((RingHom.injective ι_EF) (h0.trans (map_zero ι_EF).symm))
      let a : ℕ → E := fun i => P.coeff i / p₀
      have ha_G : ∀ i : ℕ, a i ∈ G := by
        intro i
        by_cases hi : i ∈ P.support
        · exact h_min i hi
        · dsimp only [a]
          rw [Polynomial.notMem_support_iff.mp hi, zero_div]
          exact G.zero_mem
      let α : ℕ → ↥G := fun i => ⟨a i, ha_G i⟩
      let c : ℕ → F := fun i => ι_EF (a i)
      let cW : ℕ → ↥W := fun i => inc_AW (ι_GA (α i))
      let yW : ↥W := ⟨y, hy⟩
      have hcW_val : ∀ i : ℕ, (cW i : F) = c i := fun _ => rfl

      have h_sum_zero : ∑ i ∈ Finset.range (d + 1), c i * y ^ i = 0 := by
        have h1 : ∑ i ∈ Finset.range (d + 1), ι_EF (P.coeff i) * y ^ i = 0 := by
          rw [← Polynomial.eval₂_eq_sum_range]
          exact hP_eval
        have h2 : ∀ i : ℕ, c i * y ^ i = (ι_EF (P.coeff i) * y ^ i) / ι_EF p₀ := by
          intro i
          dsimp only [c, a]
          rw [map_div₀, div_mul_eq_mul_div]
        simp_rw [h2]
        rw [← Finset.sum_div, h1, zero_div]

      have h_sum_W : ∑ i ∈ Finset.range (d + 1), cW i * yW ^ i = 0 := by
        apply Subtype.ext
        push_cast
        simp only [hcW_val]
        exact h_sum_zero

      let S_unit : Finset ℕ := (Finset.range (d + 1)).filter (fun i => IsUnit (α i))
      have hi₀_mem : i₀ ∈ S_unit := by
        rw [Finset.mem_filter]
        refine ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le (Polynomial.le_natDegree_of_mem_supp _ hi₀)), ?_⟩
        have hαi₀ : α i₀ = 1 := Subtype.ext (div_self hp₀_ne)
        rw [hαi₀]
        exact isUnit_one
      have hS_ne : S_unit.Nonempty := ⟨i₀, hi₀_mem⟩
      let k : ℕ := S_unit.max' hS_ne
      have hk_mem : k ∈ S_unit := Finset.max'_mem S_unit hS_ne
      have hk_le : k ≤ d :=
        Nat.lt_succ_iff.mp (Finset.mem_range.mp (Finset.mem_filter.mp hk_mem).1)
      have hk_unit : IsUnit (α k) := (Finset.mem_filter.mp hk_mem).2
      have hk_unit_W : IsUnit (cW k) := (hk_unit.map ι_GA).map inc_AW

      have hcW_gt_max : ∀ j : ℕ, k < j → j ≤ d → cW j ∈ IsLocalRing.maximalIdeal ↥W := by
        intro j hkj hjd
        have hj_not_unit : ¬ IsUnit (α j) := by
          intro hu
          have hj_in : j ∈ S_unit :=
            Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le hjd), hu⟩
          exact not_lt_of_ge (Finset.le_max' S_unit j hj_in) hkj
        have hαj_max : α j ∈ IsLocalRing.maximalIdeal ↥G :=
          (IsLocalRing.mem_maximalIdeal (α j)).mpr hj_not_unit
        have hcAj_max : ι_GA (α j) ∈ IsLocalRing.maximalIdeal ↥A_loc.toSubring :=
          hG_max (α j) hαj_max
        have hcAj_nu : ¬ IsUnit (ι_GA (α j)) :=
          (IsLocalRing.mem_maximalIdeal _).mp hcAj_max
        have hcWj_nu : ¬ IsUnit (cW j) :=
          fun hu => hcAj_nu (IsLocalHom.map_nonunit _ hu)
        exact (IsLocalRing.mem_maximalIdeal (cW j)).mpr hcWj_nu

      have hk_pos : 1 ≤ k := by
        apply Nat.one_le_iff_ne_zero.mpr
        intro hk0
        have h_split := Finset.sum_range_succ' (fun i => cW i * yW ^ i) d
        rw [h_sum_W, pow_zero, mul_one] at h_split
        have hcW0_eq : cW 0 = - ∑ m ∈ Finset.range d, cW (m + 1) * yW ^ (m + 1) := by
          exact eq_neg_of_add_eq_zero_right h_split.symm
        have h_sum_max : (∑ m ∈ Finset.range d, cW (m + 1) * yW ^ (m + 1)) ∈
            IsLocalRing.maximalIdeal ↥W := by
          refine Ideal.sum_mem _ fun m hm => ?_
          have hm_lt : m < d := Finset.mem_range.mp hm
          exact Ideal.mul_mem_right _ _
            (hcW_gt_max (m + 1) (by omega) (by omega))
        have hcW0_max : cW 0 ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [hcW0_eq]
          exact (IsLocalRing.maximalIdeal ↥W).neg_mem h_sum_max
        rw [← hk0] at hcW0_max
        exact (IsLocalRing.mem_maximalIdeal (cW k)).mp hcW0_max hk_unit_W

      
      let eW : ↥W := ∑ m ∈ Finset.range (d + 1 - k), cW (k + m) * yW ^ m
      let e : F := (eW : F)
      have he_def : e = ∑ m ∈ Finset.range (d + 1 - k), c (k + m) * y ^ m := by
        dsimp only [e, eW]
        push_cast
        simp only [hcW_val]
        rfl

      have heW_unit : IsUnit eW := by
        have h_sub : d + 1 - k = (d - k) + 1 := Nat.succ_sub hk_le
        have h_split : eW =
            (∑ m ∈ Finset.range (d - k), cW (k + (m + 1)) * yW ^ (m + 1)) + cW k := by
          dsimp only [eW]
          rw [h_sub, Finset.sum_range_succ' (fun m => cW (k + m) * yW ^ m) (d - k),
            add_zero, pow_zero, mul_one]
        let s_tail : ↥W := ∑ m ∈ Finset.range (d - k), cW (k + (m + 1)) * yW ^ (m + 1)
        have h_tail_max : s_tail ∈ IsLocalRing.maximalIdeal ↥W := by
          refine Ideal.sum_mem _ fun m hm => ?_
          have hm_lt : m < d - k := Finset.mem_range.mp hm
          exact Ideal.mul_mem_right _ _
            (hcW_gt_max (k + (m + 1)) (by omega) (by omega))
        by_contra heW_nu
        have heW_max : eW ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal eW).mpr heW_nu
        have hcWk_eq : cW k = eW - s_tail := by
          dsimp only [s_tail]
          rw [h_split, add_sub_cancel_left]
        have hcWk_max : cW k ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [hcWk_eq]
          exact Ideal.sub_mem _ heW_max h_tail_max
        exact (IsLocalRing.mem_maximalIdeal (cW k)).mp hcWk_max hk_unit_W

      have he_rel : (∑ j ∈ Finset.range k, c j * y ^ j) + e * y ^ k = 0 := by
        have h_add : k + (d + 1 - k) = d + 1 := Nat.add_sub_of_le (Nat.le_succ_of_le hk_le)
        have h_split := Finset.sum_range_add (fun i => c i * y ^ i) k (d + 1 - k)
        rw [h_add, h_sum_zero] at h_split
        have h_rhs : (∑ m ∈ Finset.range (d + 1 - k), c (k + m) * y ^ (k + m)) = e * y ^ k := by
          rw [he_def, Finset.sum_mul]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [pow_add, mul_comm (y ^ k) (y ^ m), mul_assoc]
        rw [← h_rhs]
        exact h_split.symm

      have he_dual : e = - ∑ j ∈ Finset.range k, c j * (y⁻¹) ^ (k - j) := by
        apply mul_right_cancel₀ (pow_ne_zero k hy0)
        rw [neg_mul]
        have h_prod : (∑ j ∈ Finset.range k, c j * (y⁻¹) ^ (k - j)) * y ^ k =
            ∑ j ∈ Finset.range k, c j * y ^ j := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun j hj => ?_
          have hj_le : j ≤ k := le_of_lt (Finset.mem_range.mp hj)
          have hk_split : y ^ k = y ^ (k - j) * y ^ j := by
            rw [← pow_add, Nat.sub_add_cancel hj_le]
          rw [hk_split, mul_assoc, ← mul_assoc ((y⁻¹) ^ (k - j)), ← mul_pow,
            inv_mul_cancel₀ hy0, one_pow, one_mul]
        rw [h_prod]
        exact eq_neg_of_add_eq_zero_right he_rel

      have he_A : e ∈ A_loc.toSubring := by
        by_contra he_not_A
        obtain ⟨V, hAV, he_not_V⟩ :=
          @LocalSubring.exists_le_valuationSubring_of_isIntegrallyClosedIn
            F _ e A_loc he_not_A hIC
        have hAV_sub : A_loc.toSubring ≤ V.toSubring := (LocalSubring.le_def.mp hAV).1
        have hc_V : ∀ i : ℕ, c i ∈ V := fun i => hAV_sub (ι_GA (α i)).2
        rcases ValuationSubring.mem_or_inv_mem V y with hyV | hy_inv_V
        · apply he_not_V
          rw [he_def]
          exact V.toSubring.sum_mem fun m _ =>
            V.toSubring.mul_mem (hc_V (k + m)) (V.toSubring.pow_mem hyV m)
        · apply he_not_V
          rw [he_dual]
          exact V.toSubring.neg_mem (V.toSubring.sum_mem fun j _ =>
            V.toSubring.mul_mem (hc_V j) (V.toSubring.pow_mem hy_inv_V (k - j)))

      let eA : ↥A_loc.toSubring := ⟨e, he_A⟩
      have heA_map : inc_AW eA = eW := Subtype.ext rfl
      have heA_unit : IsUnit eA := IsLocalHom.map_nonunit eA (heA_map ▸ heW_unit)
      obtain ⟨u_inv, hu_inv⟩ := heA_unit.exists_right_inv
      have hu_inv_val : u_inv.1 * e = 1 := by
        rw [mul_comm]
        exact congrArg Subtype.val hu_inv

      let d_j : Fin k → ↥A_loc.toSubring := fun j => u_inv * ι_GA (α j.1)
      let P_y : Polynomial ↥A_loc.toSubring :=
        Polynomial.X ^ k + ∑ j : Fin k, Polynomial.C (d_j j) * Polynomial.X ^ (j : ℕ)
      have hPy_monic : P_y.Monic :=
        Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt d_j)
      have hPy_eval : Polynomial.eval₂ (algebraMap ↥A_loc.toSubring F) y P_y = 0 := by
        dsimp only [P_y]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum]
        have h_fin : (∑ j : Fin k,
            Polynomial.eval₂ (algebraMap ↥A_loc.toSubring F) y
              (Polynomial.C (d_j j) * Polynomial.X ^ (j : ℕ))) =
            u_inv.1 * ∑ j ∈ Finset.range k, c j * y ^ j := by
          have h_term : ∀ j : Fin k,
              Polynomial.eval₂ (algebraMap ↥A_loc.toSubring F) y
                (Polynomial.C (d_j j) * Polynomial.X ^ (j : ℕ)) =
              u_inv.1 * (c j.1 * y ^ j.1) := by
            intro j
            rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
            exact mul_assoc u_inv.1 (c j.1) (y ^ j.1)
          simp_rw [h_term]
          rw [Fin.sum_univ_eq_sum_range (fun j => u_inv.1 * (c j * y ^ j)) k,
            ← Finset.mul_sum]
        rw [h_fin]
        calc y ^ k + u_inv.1 * ∑ j ∈ Finset.range k, c j * y ^ j
            = (u_inv.1 * e) * y ^ k + u_inv.1 * ∑ j ∈ Finset.range k, c j * y ^ j := by
                rw [hu_inv_val, one_mul]
          _ = u_inv.1 * ((∑ j ∈ Finset.range k, c j * y ^ j) + e * y ^ k) := by ring
          _ = 0 := by rw [he_rel, mul_zero]
      exact (Subring.isIntegrallyClosedIn_iff.mp hIC) ⟨P_y, hPy_monic, hPy_eval⟩

  
  have hB : ∀ x : B, φ x ∈ W := fun x =>
    hA_sub (algebraMap ↥φ.range ↥A_loc.toSubring (e_rng x)).2

  have hMax_W : ∀ x : B, (⟨φ x, hB x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ x ∈ 𝔔 := by
    intro x
    let xA : ↥A_loc.toSubring := algebraMap ↥φ.range ↥A_loc.toSubring (e_rng x)
    have hx_map : inc_AW xA = ⟨φ x, hB x⟩ := Subtype.ext (h_to_A_val x)
    rw [← hx_map, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    have h_unit_iff : IsUnit (inc_AW xA) ↔ IsUnit xA :=
      ⟨fun hu => IsLocalHom.map_nonunit xA hu, fun hu => hu.map inc_AW⟩
    rw [h_unit_iff, ← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal]
    change xA ∈ IsLocalRing.maximalIdeal ↥A_loc.toSubring ↔ x ∈ 𝔔
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff ↥A_loc.toSubring P_rng (e_rng x)]
    exact hP_rng_mem x

  have hFrac_W : ∀ y ∈ W, ∃ (s w : B), s ∉ 𝔔 ∧ y * φ s = φ w :=
    fun y hy => (hA_mem_iff y).mp (hWA y hy)

  
  have hScale : ∀ b₀ : B, b₀ ≠ 0 →
      ∃ (r : ℕ) (c₁ c₂ : ↥R) (u_W : ↥W),
        1 ≤ r ∧ c₁ ≠ 0 ∧ c₂ ≠ 0 ∧ IsUnit u_W ∧
        (φ b₀) ^ r * φ (ψ (Polynomial.C c₂)) = φ (ψ (Polynomial.C c₁)) * u_W.1 := by
    intro b₀ hb₀_ne
    let y₀ : F := φ b₀
    have hy₀_ne : y₀ ≠ 0 := fun h0 => hb₀_ne (hφ_inj (h0.trans (map_zero φ).symm))
    obtain ⟨P, hP_ne, hP_eval⟩ := hAlg y₀
    let t : ℕ → F := fun i => ι_EF (P.coeff i) * y₀ ^ i
    have ht_sum : ∑ i ∈ P.support, t i = 0 := by
      rw [Polynomial.eval₂_def, Polynomial.sum_def] at hP_eval
      exact hP_eval
    have ht_ne : ∀ i ∈ P.support, t i ≠ 0 := by
      intro i hi
      have hpi : P.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hi
      have hιpi : ι_EF (P.coeff i) ≠ 0 :=
        fun h0 => hpi ((RingHom.injective ι_EF) (h0.trans (map_zero ι_EF).symm))
      exact mul_ne_zero hιpi (pow_ne_zero i hy₀_ne)
    obtain ⟨i₁, hi₁, h_minW⟩ :=
      hMinVal W P.support (Polynomial.support_nonempty.mpr hP_ne) t ht_ne
    have h_div_sum : (1 : F) + ∑ i ∈ P.support.erase i₁, t i / t i₁ = 0 := by
      have h1 : ∑ i ∈ P.support, t i / t i₁ = 0 := by
        rw [← Finset.sum_div, ht_sum, zero_div]
      rw [← Finset.add_sum_erase _ _ hi₁, div_self (ht_ne i₁ hi₁)] at h1
      exact h1
    let termW : {i // i ∈ P.support.erase i₁} → ↥W :=
      fun x => ⟨t x.1 / t i₁, h_minW x.1 (Finset.mem_of_mem_erase x.2)⟩
    have h_one_W : (1 : ↥W) = - ∑ x ∈ (P.support.erase i₁).attach, termW x := by
      apply Subtype.ext
      push_cast
      dsimp only [termW]
      rw [Finset.sum_attach (P.support.erase i₁) (fun i => t i / t i₁)]
      exact eq_neg_of_add_eq_zero_left h_div_sum
    have h_exists_i₂ : ∃ x ∈ (P.support.erase i₁).attach,
        termW x ∉ IsLocalRing.maximalIdeal ↥W := by
      by_contra h_all
      push_neg at h_all
      have h1_max : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [h_one_W]
        exact (IsLocalRing.maximalIdeal ↥W).neg_mem (Ideal.sum_mem _ h_all)
      exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h1_max)
    obtain ⟨⟨i₂, hi₂_erase⟩, _, hq₀_not_max⟩ := h_exists_i₂
    obtain ⟨hi₂_ne_i₁, hi₂⟩ := Finset.mem_erase.mp hi₂_erase
    let q₀ : ↥W := termW ⟨i₂, hi₂_erase⟩
    have hq₀_unit : IsUnit q₀ := by
      by_contra hnu
      exact hq₀_not_max ((IsLocalRing.mem_maximalIdeal q₀).mpr hnu)

    have hEqualVal : ∃ (r : ℕ) (e : E) (v_W : ↥W),
        1 ≤ r ∧ e ≠ 0 ∧ IsUnit v_W ∧ v_W.1 = y₀ ^ r * ι_EF e := by
      have hp₁_ne : P.coeff i₁ ≠ 0 := Polynomial.mem_support_iff.mp hi₁
      have hp₂_ne : P.coeff i₂ ≠ 0 := Polynomial.mem_support_iff.mp hi₂
      have hιp₁_ne : ι_EF (P.coeff i₁) ≠ 0 :=
        fun h0 => hp₁_ne ((RingHom.injective ι_EF) (h0.trans (map_zero ι_EF).symm))
      have hιp₂_ne : ι_EF (P.coeff i₂) ≠ 0 :=
        fun h0 => hp₂_ne ((RingHom.injective ι_EF) (h0.trans (map_zero ι_EF).symm))
      rcases Nat.lt_or_gt_of_ne hi₂_ne_i₁ with h_lt | h_gt
      · 
        let r : ℕ := i₁ - i₂
        have hr : 1 ≤ r := Nat.sub_pos_of_lt h_lt
        let e : E := P.coeff i₁ / P.coeff i₂
        have he_ne : e ≠ 0 := div_ne_zero hp₁_ne hp₂_ne
        obtain ⟨v_W, hv_inv⟩ := hq₀_unit.exists_right_inv
        have hv_unit : IsUnit v_W := ⟨⟨v_W, q₀, mul_comm v_W q₀ ▸ hv_inv, hv_inv⟩, rfl⟩
        have hv_eq : v_W.1 = y₀ ^ r * ι_EF e := by
          have hq_ne : (q₀ : F) ≠ 0 := div_ne_zero (ht_ne i₂ hi₂) (ht_ne i₁ hi₁)
          apply mul_left_cancel₀ hq_ne
          have hv_val : (q₀ : F) * v_W.1 = 1 := by exact_mod_cast hv_inv
          rw [hv_val]
          dsimp only [q₀, termW, t, e]
          have hi_add : y₀ ^ i₁ = y₀ ^ i₂ * y₀ ^ r := by
            rw [← pow_add, Nat.add_sub_of_le (le_of_lt h_lt)]
          rw [hi_add, map_div₀]
          have hy_i₂_ne : y₀ ^ i₂ ≠ 0 := pow_ne_zero i₂ hy₀_ne
          have hy_r_ne : y₀ ^ r ≠ 0 := pow_ne_zero r hy₀_ne
          field_simp [hιp₁_ne, hιp₂_ne, hy_i₂_ne, hy_r_ne]
        exact ⟨r, e, v_W, hr, he_ne, hv_unit, hv_eq⟩
      · 
        let r : ℕ := i₂ - i₁
        have hr : 1 ≤ r := Nat.sub_pos_of_lt h_gt
        let e : E := P.coeff i₂ / P.coeff i₁
        have he_ne : e ≠ 0 := div_ne_zero hp₂_ne hp₁_ne
        refine ⟨r, e, q₀, hr, he_ne, hq₀_unit, ?_⟩
        dsimp only [q₀, termW, t, e]
        have hi_add : y₀ ^ i₂ = y₀ ^ i₁ * y₀ ^ r := by
          rw [← pow_add, Nat.add_sub_of_le (le_of_lt h_gt)]
        rw [hi_add, map_div₀]
        have hy_i₁_ne : y₀ ^ i₁ ≠ 0 := pow_ne_zero i₁ hy₀_ne
        field_simp [hιp₁_ne, hy_i₁_ne]

    obtain ⟨r, e, v_W, hr, he_ne, hv_W, hv_eq⟩ := hEqualVal
    obtain ⟨⟨N, D⟩, heND⟩ := IsLocalization.surj (nonZeroDivisors A₀) e
    have hD_ne : D.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp D.2
    have hmapD_ne : algebraMap A₀ E D.1 ≠ 0 :=
      fun h0 => hD_ne (hA₀E_inj (h0.trans (map_zero _).symm))
    have hN_ne : N ≠ 0 := by
      intro h0
      rw [h0, map_zero] at heND
      exact mul_ne_zero he_ne hmapD_ne heND
    obtain ⟨c₂, N₀, hc₂_ne, hN₀, hN_eq⟩ := hContent N hN_ne
    obtain ⟨c₁, D₀, hc₁_ne, hD₀, hD_eq⟩ := hContent D.1 hD_ne
    have hψN₀ : ψ N₀ ∉ 𝔔 := fun hm => hN₀ ((hψ_𝔔 N₀).mp hm)
    have hψD₀ : ψ D₀ ∉ 𝔔 := fun hm => hD₀ ((hψ_𝔔 D₀).mp hm)
    let u_N : ↥W := ⟨φ (ψ N₀), hB (ψ N₀)⟩
    let u_D : ↥W := ⟨φ (ψ D₀), hB (ψ D₀)⟩
    have hu_N : IsUnit u_N := by
      by_contra hnu
      exact hψN₀ ((hMax_W (ψ N₀)).mp ((IsLocalRing.mem_maximalIdeal u_N).mpr hnu))
    have hu_D : IsUnit u_D := by
      by_contra hnu
      exact hψD₀ ((hMax_W (ψ D₀)).mp ((IsLocalRing.mem_maximalIdeal u_D).mpr hnu))
    obtain ⟨u_N_inv, hu_N_inv_eq⟩ := hu_N.exists_right_inv
    have hu_N_inv : IsUnit u_N_inv :=
      ⟨⟨u_N_inv, u_N, mul_comm u_N_inv u_N ▸ hu_N_inv_eq, hu_N_inv_eq⟩, rfl⟩
    have hu_N_val : u_N.1 * u_N_inv.1 = 1 := by exact_mod_cast hu_N_inv_eq
    let u_W : ↥W := v_W * u_D * u_N_inv
    have hu_W : IsUnit u_W := (hv_W.mul hu_D).mul hu_N_inv
    have h_eF : ι_EF e * (φ (ψ (Polynomial.C c₁)) * u_D.1) =
        φ (ψ (Polynomial.C c₂)) * u_N.1 := by
      have h1 := congrArg ι_EF heND
      rw [hD_eq, hN_eq] at h1
      simp only [map_mul, hι_EF] at h1
      exact h1
    refine ⟨r, c₁, c₂, u_W, hr, hc₁_ne, hc₂_ne, hu_W, ?_⟩
    calc (φ b₀) ^ r * φ (ψ (Polynomial.C c₂))
        = (φ b₀) ^ r * (φ (ψ (Polynomial.C c₂)) * (u_N.1 * u_N_inv.1)) := by
            rw [hu_N_val, mul_one]
      _ = y₀ ^ r * (φ (ψ (Polynomial.C c₂)) * u_N.1) * u_N_inv.1 := by
            dsimp only [y₀]; ring
      _ = (y₀ ^ r * ι_EF e) * (φ (ψ (Polynomial.C c₁)) * u_D.1) * u_N_inv.1 := by
            rw [← h_eF]; ring
      _ = v_W.1 * (φ (ψ (Polynomial.C c₁)) * u_D.1) * u_N_inv.1 := by
            rw [← hv_eq]
      _ = φ (ψ (Polynomial.C c₁)) * u_W.1 := by
            dsimp only [u_W]
            push_cast
            ring

  exact ⟨hψC_ne, W, hB, hMax_W, hFrac_W, hScale⟩

theorem weil_etale_stalk_over_integrallyClosed_domain_isDomain (A₀ C : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
    [CommRing C] [Algebra A₀ C] [Algebra.Etale A₀ C]
    (q : Ideal C) [q.IsPrime] :
    IsDomain (Localization.AtPrime q) :=
by
  classical
  
  
  
  let C_q : Type u := Localization.AtPrime q
  let K₀ : Type u := FractionRing A₀
  let L_glob : Type u := TensorProduct A₀ K₀ C
  have : Algebra.Etale K₀ L_glob := Algebra.Etale.baseChange A₀ C K₀
  have hFin_Lglob : Module.Finite K₀ L_glob := by
    obtain ⟨I, hFinI, Ai, instRingAi, instAlgAi, e_prod, hAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ L_glob).mp inferInstance
    have : Finite I := hFinI
    have : ∀ i : I, Module.Finite K₀ (Ai i) := fun i => (hAi i).1
    exact Module.Finite.equiv e_prod.symm.toLinearEquiv
  have : IsArtinianRing L_glob := IsArtinianRing.of_finite K₀ L_glob
  let inc_C : C →ₐ[A₀] L_glob := Algebra.TensorProduct.includeRight
  have hinc_C_inj : Function.Injective inc_C := by
    let f₀ : A₀ →ₗ[A₀] K₀ := Algebra.linearMap A₀ K₀
    have hf₀_inj : Function.Injective f₀ := IsFractionRing.injective A₀ K₀
    have hrT_inj : Function.Injective (LinearMap.rTensor C f₀) :=
      Module.Flat.rTensor_preserves_injective_linearMap f₀ hf₀_inj
    intro c₁ c₂ hc
    apply (TensorProduct.lid A₀ C).symm.injective
    apply hrT_inj
    change (1 : K₀) ⊗ₜ[A₀] c₁ = (1 : K₀) ⊗ₜ[A₀] c₂ at hc
    simpa [f₀] using hc
  let M_q : Submonoid L_glob := q.primeCompl.map inc_C.toMonoidHom
  let L : Type u := Localization M_q
  have hL_surj : Function.Surjective (algebraMap L_glob L) :=
    IsArtinianRing.localization_surjective M_q L
  have hFin_L : Module.Finite K₀ L :=
    Module.Finite.of_surjective
      ((Algebra.linearMap L_glob L).restrictScalars K₀) hL_surj
  let g_C : @RingHom C L _ (@Semiring.toNonAssocSemiring L CommSemiring.toSemiring) :=
    { toFun := fun c => algebraMap L_glob L (inc_C c)
      map_one' := by simp
      map_mul' := fun x y => by simp
      map_zero' := by simp
      map_add' := fun x y => by simp }
  have hg_C_units : ∀ y : q.primeCompl, IsUnit (g_C y.1) := by
    intro y
    exact IsLocalization.map_units L
      (⟨inc_C y.1, Submonoid.mem_map_of_mem inc_C.toMonoidHom y.2⟩ : M_q)
  let ι := IsLocalization.lift (M := q.primeCompl) (S := C_q) (g := g_C) hg_C_units
  have hι_apply : ∀ c : C, ι (algebraMap C C_q c) = algebraMap L_glob L (inc_C c) :=
    fun c => IsLocalization.lift_eq (M := q.primeCompl) hg_C_units c
  have hι_inj : Function.Injective ι := by
    rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
    intro z hz
    rw [RingHom.mem_ker] at hz
    obtain ⟨⟨c, s⟩, hzs⟩ := IsLocalization.surj q.primeCompl z
    have h_img0 : algebraMap L_glob L (inc_C c) = 0 := by
      rw [← hι_apply c, ← hzs, map_mul, hz, zero_mul]
    obtain ⟨⟨_, s', hs', rfl⟩, hm0⟩ :=
      (IsLocalization.map_eq_zero_iff M_q L (inc_C c)).mp h_img0
    have hm0' : inc_C (s' * c) = inc_C 0 := by
      rw [map_mul, map_zero]
      exact hm0
    have hsc0 : s' * c = 0 := hinc_C_inj hm0'
    have hc_eq0 : algebraMap C C_q c = 0 := by
      have h1 : algebraMap C C_q s' * algebraMap C C_q c = 0 := by
        rw [← map_mul, hsc0, map_zero]
      exact (IsLocalization.map_units C_q ⟨s', hs'⟩).mul_right_eq_zero.mp h1
    have hz_mul0 : z * algebraMap C C_q s.1 = 0 := hzs.trans hc_eq0
    exact (IsLocalization.map_units C_q s).mul_left_eq_zero.mp hz_mul0
  have hι_A₀ : ∀ a : A₀,
      ι (algebraMap C C_q (algebraMap A₀ C a)) =
        algebraMap K₀ L (algebraMap A₀ K₀ a) := by
    intro a
    rw [hι_apply]
    have htmul : inc_C (algebraMap A₀ C a) = algebraMap K₀ L_glob (algebraMap A₀ K₀ a) := by
      change (1 : K₀) ⊗ₜ[A₀] (algebraMap A₀ C a) = (algebraMap A₀ K₀ a) ⊗ₜ[A₀] (1 : C)
      have h1 : algebraMap A₀ C a = a • (1 : C) := by rw [Algebra.smul_def, mul_one]
      have h2 : algebraMap A₀ K₀ a = a • (1 : K₀) := by rw [Algebra.smul_def, mul_one]
      rw [h1, h2, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
    rw [htmul]
    rfl

  
  
  
  let p : Ideal A₀ := q.under A₀
  haveI : p.IsPrime := Ideal.comap_isPrime (algebraMap A₀ C) q
  let A₁ : Type u := Localization.AtPrime p
  haveI : q.LiesOver p := ⟨rfl⟩
  letI : Algebra A₁ C_q := Localization.AtPrime.algebraOfLiesOver p q
  have hICA₁ : IsIntegrallyClosed A₁ :=
    @isIntegrallyClosed_of_isLocalization A₀ A₁ _ _ _ ‹IsIntegrallyClosed A₀› ‹IsDomain A₀›
      p.primeCompl p.primeCompl_le_nonZeroDivisors inferInstance
  have hp_units_K₀ : ∀ s : p.primeCompl, IsUnit (algebraMap A₀ K₀ s.1) := by
    intro s
    have hs0 : s.1 ≠ 0 := fun h0 => s.2 (h0 ▸ p.zero_mem)
    exact IsUnit.mk0 _ (fun h => hs0 ((IsFractionRing.injective A₀ K₀) (h.trans (map_zero _).symm)))
  let φ_A₁K₀ : A₁ →+* K₀ := IsLocalization.lift (M := p.primeCompl) hp_units_K₀
  letI : Algebra A₁ K₀ :=
    { smul := fun a x => φ_A₁K₀ a * x
      algebraMap := φ_A₁K₀
      commutes' := fun _ _ => mul_comm _ _
      smul_def' := fun _ _ => rfl }
  have : IsScalarTower A₀ A₁ K₀ := IsScalarTower.of_algebraMap_eq fun a =>
    (IsLocalization.lift_eq (M := p.primeCompl) hp_units_K₀ a).symm
  have : IsFractionRing A₁ K₀ :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization p.primeCompl A₁ K₀
  have hι_A₁ : ∀ a : A₁, ι (algebraMap A₁ C_q a) = algebraMap K₀ L (algebraMap A₁ K₀ a) := by
    have h_ext : ι.comp (algebraMap A₁ C_q) = (algebraMap K₀ L).comp (algebraMap A₁ K₀) := by
      apply IsLocalization.ringHom_ext p.primeCompl
      ext a
      simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A₀ A₁ C_q,
        IsScalarTower.algebraMap_apply A₀ C C_q, ← IsScalarTower.algebraMap_apply A₀ A₁ K₀]
      exact hι_A₀ a
    exact fun a => RingHom.congr_fun h_ext a

  
  
  
  haveI : Algebra.FormallyUnramified C C_q :=
    Algebra.FormallyUnramified.of_isLocalization q.primeCompl
  haveI : Algebra.FormallyUnramified A₀ C_q :=
    Algebra.FormallyUnramified.comp A₀ C C_q
  haveI : Algebra.FormallyUnramified A₁ C_q :=
    Algebra.FormallyUnramified.localization_base p.primeCompl
  haveI : Algebra.EssFiniteType A₁ C_q :=
    Algebra.EssFiniteType.of_comp A₀ A₁ C_q
  obtain ⟨hSep, hMax⟩ :=
    (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A₁) (S := C_q)).mp inferInstance
  have hZMP : Algebra.ZariskisMainProperty A₀ q :=
    Algebra.ZariskisMainProperty.of_finiteType q
  obtain ⟨r, hr_not_q, hr_int, hr_mul_int⟩ :=
    Algebra.zariskisMainProperty_iff.mp hZMP
  choose m_exp hm_exp using hr_mul_int
  obtain ⟨G, hG_top⟩ := (inferInstance : Algebra.FiniteType A₀ C).out
  let ι_C : C →+* C_q := algebraMap C C_q
  let S_gen : Finset C_q :=
    insert (ι_C r) (G.image fun c => ι_C (r ^ (m_exp c) * c))
  let R₁ : Subalgebra A₁ C_q := Algebra.adjoin A₁ (S_gen : Set C_q)
  have hR₁_le_int : R₁ ≤ integralClosure A₁ C_q := by
    rw [Algebra.adjoin_le_iff]
    intro z hz
    change IsIntegral A₁ z
    have hz_fin : z ∈ S_gen := hz
    rcases Finset.mem_insert.mp hz_fin with rfl | hz_img
    · exact IsIntegral.tower_top (R := A₀)
        (IsIntegral.map (IsScalarTower.toAlgHom A₀ C C_q) hr_int)
    · obtain ⟨c, _, rfl⟩ := Finset.mem_image.mp hz_img
      exact IsIntegral.tower_top (R := A₀)
        (IsIntegral.map (IsScalarTower.toAlgHom A₀ C C_q) (hm_exp c))
  haveI hInt_R₁ : Algebra.IsIntegral A₁ ↥R₁ := by
    refine ⟨fun x => ?_⟩
    have hx_int : IsIntegral A₁ (algebraMap ↥R₁ C_q x) := hR₁_le_int x.2
    haveI : FaithfulSMul ↥R₁ C_q :=
      (faithfulSMul_iff_algebraMap_injective ↥R₁ C_q).mpr Subtype.val_injective
    exact (isIntegral_algebraMap_iff (R := A₁) (A := ↥R₁) (B := C_q)).mp hx_int
  haveI : Algebra.FiniteType A₁ ↥R₁ :=
    Algebra.FiniteType.adjoin_of_finite S_gen.finite_toSet
  haveI hFin_R₁ : Module.Finite A₁ ↥R₁ := Algebra.IsIntegral.finite
  have h_clear_C : ∀ x : C, ∃ M : ℕ, (ι_C r) ^ M * ι_C x ∈ R₁ := by
    have hr_mem : ι_C r ∈ R₁ :=
      Algebra.subset_adjoin (Finset.mem_insert_self (ι_C r) _)
    intro x
    have hx_top : x ∈ Algebra.adjoin A₀ (G : Set C) := by rw [hG_top]; trivial
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx_top
    · intro c hc
      refine ⟨m_exp c, ?_⟩
      have h_eq : (ι_C r) ^ (m_exp c) * ι_C c = ι_C (r ^ (m_exp c) * c) := by
        rw [map_mul, map_pow]
      rw [h_eq]
      exact Algebra.subset_adjoin
        (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hc))
    · intro a
      refine ⟨0, ?_⟩
      rw [pow_zero, one_mul]
      change algebraMap A₀ C_q a ∈ R₁
      rw [IsScalarTower.algebraMap_apply A₀ A₁ C_q]
      exact R₁.algebraMap_mem _
    · rintro x₁ x₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
      refine ⟨M₁ + M₂, ?_⟩
      have h_eq : (ι_C r) ^ (M₁ + M₂) * ι_C (x₁ + x₂) =
          (ι_C r) ^ M₂ * ((ι_C r) ^ M₁ * ι_C x₁) +
          (ι_C r) ^ M₁ * ((ι_C r) ^ M₂ * ι_C x₂) := by
        rw [map_add, pow_add]; ring
      rw [h_eq]
      exact R₁.add_mem (R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁)
        (R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂)
    · rintro x₁ x₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
      refine ⟨M₁ + M₂, ?_⟩
      have h_eq : (ι_C r) ^ (M₁ + M₂) * ι_C (x₁ * x₂) =
          ((ι_C r) ^ M₁ * ι_C x₁) * ((ι_C r) ^ M₂ * ι_C x₂) := by
        rw [map_mul, pow_add]; ring
      rw [h_eq]
      exact R₁.mul_mem hM₁ hM₂
  let m_q : Ideal C_q := IsLocalRing.maximalIdeal C_q
  let q₀ : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ C_q) m_q
  haveI : q₀.IsPrime := Ideal.comap_isPrime (algebraMap ↥R₁ C_q) m_q
  have hLoc_R₁ : IsLocalization q₀.primeCompl C_q := by
    refine ⟨?_, ?_, ?_⟩
    · intro y
      exact IsLocalRing.notMem_maximalIdeal.mp y.2
    · intro z
      obtain ⟨⟨u, v⟩, hzv⟩ := IsLocalization.surj q.primeCompl z
      obtain ⟨M₁, hM₁⟩ := h_clear_C u
      obtain ⟨M₂, hM₂⟩ := h_clear_C v.1
      have hr_mem : ι_C r ∈ R₁ :=
        Algebra.subset_adjoin (Finset.mem_insert_self (ι_C r) _)
      let x₀ : ↥R₁ := ⟨(ι_C r) ^ M₂ * ((ι_C r) ^ M₁ * ι_C u),
        R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁⟩
      let t₀ : ↥R₁ := ⟨(ι_C r) ^ M₁ * ((ι_C r) ^ M₂ * ι_C v.1),
        R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂⟩
      have ht₀_unit : IsUnit (t₀ : C_q) := by
        have hr_u : IsUnit (ι_C r) :=
          IsLocalization.map_units C_q (⟨r, hr_not_q⟩ : q.primeCompl)
        have hv_u : IsUnit (ι_C v.1) := IsLocalization.map_units C_q v
        exact (hr_u.pow M₁).mul ((hr_u.pow M₂).mul hv_u)
      have ht₀_not_q₀ : t₀ ∉ q₀ :=
        IsLocalRing.notMem_maximalIdeal.mpr ht₀_unit
      refine ⟨⟨x₀, ⟨t₀, ht₀_not_q₀⟩⟩, ?_⟩
      change z * ((ι_C r) ^ M₁ * ((ι_C r) ^ M₂ * ι_C v.1)) =
        (ι_C r) ^ M₂ * ((ι_C r) ^ M₁ * ι_C u)
      calc z * ((ι_C r) ^ M₁ * ((ι_C r) ^ M₂ * ι_C v.1))
          = (ι_C r) ^ M₂ * ((ι_C r) ^ M₁ * (z * ι_C v.1)) := by ring
        _ = (ι_C r) ^ M₂ * ((ι_C r) ^ M₁ * ι_C u) := by rw [hzv]
    · intro x₁ x₂ hx
      exact ⟨1, by simp [Subtype.ext hx]⟩

  
  
  
  let m₁ : Ideal A₁ := IsLocalRing.maximalIdeal A₁
  let κ : Type u := IsLocalRing.ResidueField A₁
  let κ' : Type u := IsLocalRing.ResidueField C_q
  let π : C_q →+* κ' := IsLocalRing.residue C_q
  have hcomap_q₀ : Ideal.comap (algebraMap A₁ ↥R₁) q₀ = m₁ := by
    have h_le : m₁ ≤ Ideal.comap (algebraMap A₁ ↥R₁) q₀ := by
      intro a ha
      change algebraMap A₁ C_q a ∈ m_q
      rw [IsLocalRing.mem_maximalIdeal] at ha ⊢
      exact fun hu => ha (isUnit_of_map_unit (algebraMap A₁ C_q) a hu)
    have h_prime : (Ideal.comap (algebraMap A₁ ↥R₁) q₀).IsPrime :=
      Ideal.comap_isPrime (algebraMap A₁ ↥R₁) q₀
    exact ((IsLocalRing.maximalIdeal.isMaximal A₁).eq_of_le h_prime.ne_top h_le).symm
  have hq₀_max : q₀.IsMaximal := by
    refine Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A₁ ↥R₁)
      (fun x => Algebra.IsIntegral.isIntegral (R := A₁) x) q₀ ?_
    rw [hcomap_q₀]
    exact IsLocalRing.maximalIdeal.isMaximal A₁
  have hField_R₁q₀ : IsField (↥R₁ ⧸ q₀) :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient q₀).mp hq₀_max
  let π_alg : ↥R₁ →ₐ[A₁] κ' := (IsScalarTower.toAlgHom A₁ C_q κ').comp R₁.val
  have hπ_alg_surj : Function.Surjective π_alg := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨⟨x, t⟩, hzt⟩ := @IsLocalization.surj _ _ q₀.primeCompl _ _ _ hLoc_R₁ z
    have hzt' : z * t.1.1 = x.1 := hzt
    have ht_ne0 : Ideal.Quotient.mk q₀ t.1 ≠ 0 := by
      intro h0
      exact t.2 ((Ideal.Quotient.eq_zero_iff_mem).mp h0)
    obtain ⟨w_bar, hw_bar⟩ := hField_R₁q₀.mul_inv_cancel ht_ne0
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w_bar
    have htw_mem : t.1 * w - 1 ∈ q₀ := by
      apply (Ideal.Quotient.eq_zero_iff_mem).mp
      rw [map_sub, map_mul, map_one, hw_bar, sub_self]
    have hπ_tw : π (t.1.1 * w.1) = 1 := by
      have h_sub0 : π (t.1.1 * w.1 - 1) = 0 :=
        (Ideal.Quotient.eq_zero_iff_mem).mpr htw_mem
      rw [map_sub, sub_eq_zero, map_one] at h_sub0
      exact h_sub0
    refine ⟨x * w, ?_⟩
    change π (x.1 * w.1) = π z
    calc π (x.1 * w.1)
        = π ((z * t.1.1) * w.1) := by rw [← hzt']
      _ = π z * π (t.1.1 * w.1) := by rw [mul_assoc, map_mul]
      _ = π z := by rw [hπ_tw, mul_one]
  have : Module.Finite A₁ κ' :=
    Module.Finite.of_surjective π_alg.toLinearMap hπ_alg_surj
  have : Module.Finite κ κ' :=
    Module.Finite.of_restrictScalars_finite A₁ κ κ'
  let I₁ : Ideal ↥R₁ := Ideal.map (algebraMap A₁ ↥R₁) m₁
  have hI₁_le_q₀ : I₁ ≤ q₀ := by
    rw [Ideal.map_le_iff_le_comap, hcomap_q₀]
  let F₀ : Type u := ↥R₁ ⧸ I₁
  let q_F : ↥R₁ →+* F₀ := Ideal.Quotient.mk I₁
  let φ_κF₀ : κ →+* F₀ :=
    Ideal.Quotient.lift m₁ (q_F.comp (algebraMap A₁ ↥R₁)) (by
      intro a ha
      change q_F (algebraMap A₁ ↥R₁ a) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem (algebraMap A₁ ↥R₁) ha)
  letI : Algebra κ F₀ :=
    { smul := fun c x => φ_κF₀ c * x
      algebraMap := φ_κF₀
      commutes' := fun c x => mul_comm (φ_κF₀ c) x
      smul_def' := fun _ _ => rfl }
  have : IsScalarTower A₁ κ F₀ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let q_F_alg : ↥R₁ →ₐ[A₁] F₀ :=
    { toRingHom := q_F, commutes' := fun _ => rfl }
  have : Module.Finite A₁ F₀ :=
    Module.Finite.of_surjective q_F_alg.toLinearMap Ideal.Quotient.mk_surjective
  have : Module.Finite κ F₀ :=
    Module.Finite.of_restrictScalars_finite A₁ κ F₀
  have : IsNoetherian κ F₀ := inferInstance
  let q0_bar : Ideal F₀ := Ideal.map q_F q₀
  have hcomap_q0_bar : Ideal.comap q_F q0_bar = q₀ := by
    rw [Ideal.comap_map_of_surjective q_F Ideal.Quotient.mk_surjective q₀]
    have hker : Ideal.comap q_F ⊥ = I₁ := Ideal.mk_ker
    rw [hker, sup_eq_left.mpr hI₁_le_q₀]
  have hq0_bar_max : q0_bar.IsMaximal := by
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : F₀) ∈ q0_bar := htop ▸ Submodule.mem_top
      have h1' : (1 : ↥R₁) ∈ Ideal.comap q_F q0_bar := h1
      rw [hcomap_q0_bar] at h1'
      exact hq₀_max.ne_top ((Ideal.eq_top_iff_one q₀).mpr h1')
    · intro J hlt
      have hle_J : q₀ ≤ Ideal.comap q_F J := by
        rw [← hcomap_q0_bar]
        exact Ideal.comap_mono hlt.le
      have hne_J : q₀ ≠ Ideal.comap q_F J := by
        intro heq
        obtain ⟨y, hyJ, hy_not⟩ := SetLike.exists_of_lt hlt
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hx_q₀ : x ∈ q₀ := by rw [heq]; exact hyJ
        exact hy_not (Ideal.mem_map_of_mem q_F hx_q₀)
      have htop_J : Ideal.comap q_F J = ⊤ := by
        by_contra h_ne_top
        exact hne_J (hq₀_max.eq_of_le h_ne_top hle_J)
      rw [Ideal.eq_top_iff_one] at htop_J ⊢
      exact htop_J
  have : q0_bar.IsPrime := by
    refine ⟨hq0_bar_max.ne_top, ?_⟩
    intro x y hxy
    obtain ⟨rx, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨ry, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul] at hxy
    have hrxy : rx * ry ∈ q₀ := by rw [← hcomap_q0_bar]; exact hxy
    rcases (inferInstance : q₀.IsPrime).mem_or_mem hrxy with hrx | hry
    · exact Or.inl (Ideal.mem_map_of_mem q_F hrx)
    · exact Or.inr (Ideal.mem_map_of_mem q_F hry)
  have h_ann_m₁ : ∀ y ∈ Ideal.map (algebraMap A₁ C_q) m₁,
      ∃ (t : q₀.primeCompl) (u : ↥R₁), u ∈ I₁ ∧ y * t.1.1 = u.1 := by
    intro y hy
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
    · rintro _ ⟨a, ha, rfl⟩
      refine ⟨1, algebraMap A₁ ↥R₁ a, Ideal.mem_map_of_mem _ ha, ?_⟩
      change algebraMap A₁ C_q a * 1 = algebraMap A₁ C_q a
      exact mul_one _
    · exact ⟨1, 0, I₁.zero_mem, zero_mul _⟩
    · rintro y₁ y₂ _ _ ⟨t₁, u₁, hu₁, hy₁⟩ ⟨t₂, u₂, hu₂, hy₂⟩
      refine ⟨t₁ * t₂, t₂.1 * u₁ + t₁.1 * u₂,
        I₁.add_mem (I₁.mul_mem_left _ hu₁) (I₁.mul_mem_left _ hu₂), ?_⟩
      change (y₁ + y₂) * (t₁.1.1 * t₂.1.1) = t₂.1.1 * u₁.1 + t₁.1.1 * u₂.1
      calc (y₁ + y₂) * (t₁.1.1 * t₂.1.1)
          = t₂.1.1 * (y₁ * t₁.1.1) + t₁.1.1 * (y₂ * t₂.1.1) := by ring
        _ = t₂.1.1 * u₁.1 + t₁.1.1 * u₂.1 := by rw [hy₁, hy₂]
    · rintro c y₁ _ ⟨t₁, u₁, hu₁, hy₁⟩
      obtain ⟨⟨x_c, t_c⟩, hcz⟩ := @IsLocalization.surj _ _ q₀.primeCompl _ _ _ hLoc_R₁ c
