          _ = hW₀.isoSpec.inv ≫ (i_init ≫ W_init.ι) ≫ g_ss := by
              rw [← hComm_init]
              simp only [CategoryTheory.Category.assoc]
          _ = hW₀.isoSpec.inv ≫ W₀.ι ≫ g_ss := by rw [U_ss.homOfLE_ι hW₀_init]
          _ = (hW₀.isoSpec.inv ≫ g_W₀) ≫ f_VP := by
              rw [← hg_W₀, CategoryTheory.Category.assoc]
      exact congrArg CommRingCat.Hom.hom hcat
    obtain ⟨ψ_sm₀, hEt_sm₀, hψ_sm₀_C⟩ := hS1Smooth ϖ γ₀ ψ_init.hom hEt_ψinit hComm_ψinit
    have hComm_sm₀ : W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm₀) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = g_W₀ := by
      have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm₀) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
          AlgebraicGeometry.Spec.map γ₀_hom := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_sm₀_C]
        rfl
      rw [hmap]
      exact hγ₀_spec
    exact hFinishSmooth W₀ hW₀ hu₀₀ g_W₀ hg_W₀ hg_W₀_max ψ_sm₀ hEt_sm₀ hComm_sm₀
  · 
    obtain ⟨W₀, hW₀, hu₀₀, hW₀_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := W_init ⊓ U_VP) (x := u₀) ⟨hu₀_init, hu₀_UVP⟩
    have hW₀_init : W₀ ≤ W_init := fun y hy => (hW₀_sub hy).1
    have hRange_W₀ : Set.range (W₀.ι ≫ g_ss).base ⊆ Set.range f_VP.base := by
      rintro _ ⟨w, rfl⟩
      have hw_UVP : w.1 ∈ U_VP := (hW₀_sub w.2).2
      change g_ss.base w.1 ∈ Set.range f_VP.base
      rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange]
      exact hw_UVP
    let g_W₀ : W₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V_P) :=
      AlgebraicGeometry.IsOpenImmersion.lift f_VP (W₀.ι ≫ g_ss) hRange_W₀
    have hg_W₀ : g_W₀ ≫ f_VP = W₀.ι ≫ g_ss :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac f_VP (W₀.ι ≫ g_ss) hRange_W₀
    have hg_W₀_max : (g_W₀.base ⟨u₀, hu₀₀⟩).asIdeal = IsLocalRing.maximalIdeal ↥V_P := by
      have hpt : g_W₀.base ⟨u₀, hu₀₀⟩ = m_VP_pt := by
        apply f_VP.isOpenEmbedding.injective
        change (g_W₀ ≫ f_VP).base ⟨u₀, hu₀₀⟩ = f_VP.base m_VP_pt
        rw [hg_W₀, hf_VP_pt]
        exact hu₀_P
      rw [hpt]
    let R₀ : CommRingCat.{u} := U_ss.presheaf.obj (Opposite.op W₀)
    let B₀ : Type u := ↑R₀
    let γ₀_hom : CommRingCat.of ↥V_P ⟶ R₀ :=
      AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ g_W₀)
    let γ₀ : ↥V_P →+* B₀ := γ₀_hom.hom
    have hγ₀_map : AlgebraicGeometry.Spec.map γ₀_hom = hW₀.isoSpec.inv ≫ g_W₀ :=
      AlgebraicGeometry.Spec.map_preimage _
    have hγ₀_spec : W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map γ₀_hom = g_W₀ := by
      rw [hγ₀_map, ← hW₀.isoSpec_hom, CategoryTheory.Iso.hom_inv_id_assoc]
    let i_init : W₀.toScheme ⟶ W_init.toScheme := U_ss.homOfLE hW₀_init
    let ψ_init : CommRingCat.of
        (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ⟶ R₀ :=
      AlgebraicGeometry.Spec.preimage (hW₀.isoSpec.inv ≫ i_init ≫ e_init)
    have hψ_init_map : AlgebraicGeometry.Spec.map ψ_init = hW₀.isoSpec.inv ≫ i_init ≫ e_init :=
      AlgebraicGeometry.Spec.map_preimage _
    have _ : AlgebraicGeometry.Etale e_init := hEt_init
    have hEt_ψinit : ψ_init.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rw [hψ_init_map]
      infer_instance
    let C_nodV : ↥V →+*
        (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
      (Ideal.Quotient.mk _).comp MvPolynomial.C
    have hComm_ψinit : ψ_init.hom.comp C_nodV = γ₀.comp (algebraMap ↥V ↥V_P) := by
      rw [hAlg_VP]
      have hcat : CommRingCat.ofHom C_nodV ≫ ψ_init =
          CommRingCat.ofHom ι_VP ≫ γ₀_hom := by
        rw [← AlgebraicGeometry.Spec.preimage_map (CommRingCat.ofHom C_nodV ≫ ψ_init),
            ← AlgebraicGeometry.Spec.preimage_map (CommRingCat.ofHom ι_VP ≫ γ₀_hom)]
        congr 1
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            hψ_init_map, hγ₀_map]
        calc (hW₀.isoSpec.inv ≫ i_init ≫ e_init) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodV)
            = hW₀.isoSpec.inv ≫ i_init ≫
                (e_init ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodV)) := by
              simp only [CategoryTheory.Category.assoc]
          _ = hW₀.isoSpec.inv ≫ (i_init ≫ W_init.ι) ≫ g_ss := by
              rw [← hComm_init]
              simp only [CategoryTheory.Category.assoc]
          _ = hW₀.isoSpec.inv ≫ W₀.ι ≫ g_ss := by rw [U_ss.homOfLE_ι hW₀_init]
          _ = (hW₀.isoSpec.inv ≫ g_W₀) ≫ f_VP := by
              rw [← hg_W₀, CategoryTheory.Category.assoc]
      exact congrArg CommRingCat.Hom.hom hcat
    let a₀ : ↥V_P := algebraMap ↥V ↥V_P a
    have ha₀_ne : a₀ ≠ 0 := by
      dsimp [a₀]
      rw [hAlg_VP]
      exact (map_ne_zero_iff ι_VP (Subring.inclusion_injective _)).mpr ha_ne
    obtain ⟨ψ_nod₀, hEt_nod₀, hψ_nod₀_C⟩ :=
      hS1Nodal ϖ γ₀ a ψ_init.hom hEt_ψinit hComm_ψinit
    let I_VP : Ideal (MvPolynomial (Fin 2) ↥V_P) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
    let A_VP := MvPolynomial (Fin 2) ↥V_P ⧸ I_VP
    let C_nodVP : ↥V_P →+* A_VP := (Ideal.Quotient.mk I_VP).comp MvPolynomial.C
    let p₀₀ : PrimeSpectrum B₀ := hW₀.primeIdealOf ⟨u₀, hu₀₀⟩
    let q₀ : Ideal A_VP := Ideal.comap ψ_nod₀ p₀₀.asIdeal
    have hγ₀_comap : Ideal.comap γ₀ p₀₀.asIdeal = IsLocalRing.maximalIdeal ↥V_P := by
      have hbase : ((W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map γ₀_hom).base ⟨u₀, hu₀₀⟩).asIdeal =
          IsLocalRing.maximalIdeal ↥V_P := by
        rw [hγ₀_spec]
        exact hg_W₀_max
      dsimp [p₀₀]
      rw [← hToSpecΓ W₀ hW₀ ⟨u₀, hu₀₀⟩]
      exact hbase
    by_cases hAll : ∀ i : Fin 2, Ideal.Quotient.mk I_VP (MvPolynomial.X i) ∈ q₀
    · 
      have ha₀_max : a₀ ∈ IsLocalRing.maximalIdeal ↥V_P := by
        have hrel : C_nodVP a₀ =
            Ideal.Quotient.mk I_VP (MvPolynomial.X 0) *
              Ideal.Quotient.mk I_VP (MvPolynomial.X 1) := by
          have h0 : Ideal.Quotient.mk I_VP
              (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [map_sub, map_mul] at h0
          exact (sub_eq_zero.mp h0).symm
        have hCa₀_q₀ : C_nodVP a₀ ∈ q₀ := by
          rw [hrel]
          exact Ideal.mul_mem_right _ q₀ (hAll 0)
        have hγa₀ : γ₀ a₀ ∈ p₀₀.asIdeal := by
          have heq : ψ_nod₀ (C_nodVP a₀) = γ₀ a₀ := RingHom.congr_fun hψ_nod₀_C a₀
          rw [← heq]
          exact hCa₀_q₀
        rw [← hγ₀_comap]
        exact hγa₀
      have hp₀₀_max : p₀₀.asIdeal.IsMaximal :=
        hW₀.primeIdealOf_isMaximal_of_isClosed ⟨u₀, hu₀₀⟩ hu₀_cl
      have hFT_ψnod : ψ_nod₀.FiniteType := by
        letI := ψ_nod₀.toAlgebra
        have _ : Algebra.Etale _ B₀ := hEt_nod₀
        change Algebra.FiniteType _ B₀
        infer_instance
      have hFT_γ₀ : γ₀.FiniteType := by
        let f_nod_ft : CommRingCat.of ↥V_P ⟶ CommRingCat.of A_VP :=
          CommRingCat.ofHom C_nodVP
        have hFT_C : f_nod_ft.hom.FiniteType := by
          have hAlgC : algebraMap ↥V_P A_VP = f_nod_ft.hom := RingHom.ext fun _ => rfl
          rw [← hAlgC, RingHom.finiteType_algebraMap]
          infer_instance
        have hEq : ψ_nod₀.comp f_nod_ft.hom = γ₀ :=
          RingHom.ext fun r => RingHom.congr_fun hψ_nod₀_C r
        rw [← hEq]
        exact hFT_ψnod.comp hFT_C
      obtain ⟨hRes₀, _⟩ :=
        hS3ResidueAndCenter γ₀ hFT_γ₀ p₀₀.asIdeal hp₀₀_max hγ₀_comap
      let ψ₁ : CommRingCat.of A_VP ⟶ R₀ := CommRingCat.ofHom ψ_nod₀
      let m₀ : PrimeSpectrum A_VP := ⟨q₀, Ideal.comap_isPrime ψ_nod₀ p₀₀.asIdeal⟩
      have hComm₁ : W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ₁ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodVP) = g_W₀ := by
        have hmap : AlgebraicGeometry.Spec.map ψ₁ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodVP) =
            AlgebraicGeometry.Spec.map γ₀_hom := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_nod₀_C]
          rfl
        rw [hmap]
        exact hγ₀_spec
      refine ⟨W₀, hW₀, hu₀₀, g_W₀, hg_W₀, hg_W₀_max,
        Or.inr ⟨a₀, ψ₁, m₀, ha₀_ne, ha₀_max, hEt_nod₀, hComm₁, hAll, ?_, rfl, ?_⟩⟩
      · intro r hr
        change ψ_nod₀ (C_nodVP r) ∈ p₀₀.asIdeal
        have hCr : ψ_nod₀ (C_nodVP r) = γ₀ r := RingHom.congr_fun hψ_nod₀_C r
        rw [hCr]
        change r ∈ Ideal.comap γ₀ p₀₀.asIdeal
        rw [hγ₀_comap]
        exact hr
      · intro b
        obtain ⟨r, hr⟩ := hRes₀ b
        refine ⟨r, ?_⟩
        have hCr : ψ₁.hom
            (Ideal.Quotient.mk (Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) (MvPolynomial.C r)) =
            γ₀ r := RingHom.congr_fun hψ_nod₀_C r
        rw [hCr]
        exact hr
    · 
      rw [not_forall] at hAll
      rcases hAll with ⟨i, hi_notMem⟩
      let x_i : B₀ := ψ_nod₀ (Ideal.Quotient.mk I_VP (MvPolynomial.X i))
      have hxi_notMem : x_i ∉ p₀₀.asIdeal := hi_notMem
      let W₁ : U_ss.Opens := U_ss.basicOpen x_i
      have hW₁ : AlgebraicGeometry.IsAffineOpen W₁ := hW₀.basicOpen x_i
      have hLE : W₁ ≤ W₀ := U_ss.basicOpen_le x_i
      have hu₀₁ : u₀ ∈ W₁ := by
        have hu₀_eq : u₀ = hW₀.fromSpec.base p₀₀ :=
          (hW₀.fromSpec_primeIdealOf ⟨u₀, hu₀₀⟩).symm
        change u₀ ∈ U_ss.basicOpen x_i
        rw [hu₀_eq]
        change p₀₀ ∈ (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj (U_ss.basicOpen x_i)
        rw [hW₀.fromSpec_preimage_basicOpen x_i]
        exact (PrimeSpectrum.mem_basicOpen x_i p₀₀).mpr hxi_notMem
      let i_W₁ : W₁.toScheme ⟶ W₀.toScheme := U_ss.homOfLE hLE
      have hi_W₁_ι : i_W₁ ≫ W₀.ι = W₁.ι := U_ss.homOfLE_ι hLE
      let g_W₁ : W₁.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V_P) := i_W₁ ≫ g_W₀
      have hg_W₁ : g_W₁ ≫ f_VP = W₁.ι ≫ g_ss := by
        dsimp [g_W₁]
        rw [CategoryTheory.Category.assoc, hg_W₀, ← CategoryTheory.Category.assoc, hi_W₁_ι]
      have hi_W₁_u₀ : i_W₁.base ⟨u₀, hu₀₁⟩ = ⟨u₀, hu₀₀⟩ := by
        apply Subtype.ext
        change (i_W₁ ≫ W₀.ι).base ⟨u₀, hu₀₁⟩ = u₀
        rw [hi_W₁_ι]
        rfl
      have hg_W₁_max : (g_W₁.base ⟨u₀, hu₀₁⟩).asIdeal = IsLocalRing.maximalIdeal ↥V_P := by
        change (g_W₀.base (i_W₁.base ⟨u₀, hu₀₁⟩)).asIdeal = _
        rw [hi_W₁_u₀]
        exact hg_W₀_max
      let R₁ : CommRingCat.{u} := U_ss.presheaf.obj (Opposite.op W₁)
      let B₁ : Type u := ↑R₁
      have _ : CategoryTheory.IsIso W₀.toSpecΓ := by
        rw [← hW₀.isoSpec_hom]
        infer_instance
      have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_nod₀
      let φ_spec : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec R₀ :=
        hW₁.isoSpec.inv ≫ i_W₁ ≫ W₀.toSpecΓ
      let ψ_nod₁ : CommRingCat.of A_VP ⟶ R₁ :=
        AlgebraicGeometry.Spec.preimage
          (φ_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀))
      have hψ_nod₁_map : AlgebraicGeometry.Spec.map ψ_nod₁ =
          φ_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀) :=
        AlgebraicGeometry.Spec.map_preimage _
      have hEt_nod₁ : ψ_nod₁.hom.Etale := by
        apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        rw [hψ_nod₁_map]
        dsimp [φ_spec]
        infer_instance
      have hUnit₁ : IsUnit (ψ_nod₁.hom (Ideal.Quotient.mk I_VP (MvPolynomial.X i))) := by
        by_contra hNotUnit
        let y_i : B₁ := ψ_nod₁.hom (Ideal.Quotient.mk I_VP (MvPolynomial.X i))
        have hne_top : Ideal.span ({y_i} : Set B₁) ≠ ⊤ := by
          intro htop
          exact hNotUnit (Ideal.span_singleton_eq_top.mp htop)
        obtain ⟨m_p, hm_max, h_le⟩ := Ideal.exists_le_maximal _ hne_top
        let p : PrimeSpectrum B₁ := ⟨m_p, hm_max.isPrime⟩
        have hy_p : y_i ∈ p.asIdeal := h_le (Ideal.subset_span rfl)
        let q : PrimeSpectrum B₀ := φ_spec.base p
        have hcomap_pq : Ideal.comap ψ_nod₁.hom p.asIdeal = Ideal.comap ψ_nod₀ q.asIdeal := by
          change ((AlgebraicGeometry.Spec.map ψ_nod₁).base p).asIdeal =
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀)).base q).asIdeal
          rw [hψ_nod₁_map]
          rfl
        have hxi_q : x_i ∈ q.asIdeal := by
          have hmem : Ideal.Quotient.mk I_VP (MvPolynomial.X i) ∈
              Ideal.comap ψ_nod₁.hom p.asIdeal := hy_p
          rw [hcomap_pq] at hmem
          exact hmem
        have hfrom_eq : φ_spec ≫ hW₀.fromSpec = hW₁.fromSpec := by
          dsimp [φ_spec]
          rw [← hW₀.isoSpec_hom, ← hW₀.isoSpec_inv_ι]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          rw [hi_W₁_ι, hW₁.isoSpec_inv_ι]
        have hq_W₁ : hW₀.fromSpec.base q ∈ W₁ := by
          have heq : hW₀.fromSpec.base q = hW₁.fromSpec.base p := by
            change (φ_spec ≫ hW₀.fromSpec).base p = hW₁.fromSpec.base p
            rw [hfrom_eq]
          rw [heq, ← hW₁.isoSpec_inv_ι]
          exact (hW₁.isoSpec.inv.base p).2
        have hq_pre : q ∈ (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj W₁ := hq_W₁
        dsimp [W₁] at hq_pre
        rw [hW₀.fromSpec_preimage_basicOpen x_i] at hq_pre
        exact (PrimeSpectrum.mem_basicOpen x_i q).mp hq_pre hxi_q
      obtain ⟨ψ_sm₁, hEt_sm₁, hψ_sm₁_C⟩ :=
        hS2NodalToSmooth a₀ ψ_nod₁.hom hEt_nod₁ i hUnit₁
      have hComm_sm₁ : W₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = g_W₁ := by
        have hmap1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
            AlgebraicGeometry.Spec.map ψ_nod₁ ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodVP) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, hψ_sm₁_C, CommRingCat.ofHom_comp]
          rfl
        have hmap2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodVP) =
            AlgebraicGeometry.Spec.map γ₀_hom := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_nod₀_C]
          rfl
        rw [hmap1, hψ_nod₁_map]
        dsimp [φ_spec]
        rw [← hW₁.isoSpec_hom]
        calc hW₁.isoSpec.hom ≫ (hW₁.isoSpec.inv ≫ i_W₁ ≫ W₀.toSpecΓ) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodVP)
            = i_W₁ ≫ W₀.toSpecΓ ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_nod₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_nodVP)) := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          _ = i_W₁ ≫ (W₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map γ₀_hom) := by rw [hmap2]
          _ = g_W₁ := by rw [hγ₀_spec]
      exact hFinishSmooth W₁ hW₁ hu₀₁ g_W₁ hg_W₁ hg_W₁_max ψ_sm₁ hEt_sm₁ hComm_sm₁

theorem weil_finite_closed_locus_quotient_henselian_and_maximal (K : Type u) [Field K]
    (m : ℕ) (V_P : ValuationSubring K)
    (hPkg_VP : IsValuationRingAlgPackage m V_P)
    (A₀ B₁ : Type u) [CommRing A₀] [CommRing B₁]
    (C₀ : ↥V_P →+* A₀)
    (ψ₁ : A₀ →+* B₁)
    (hFT_B₁ : (ψ₁.comp C₀).FiniteType)
    (m₀ : Ideal A₀) [m₀.IsPrime]
    (hm₀_comap : Ideal.comap C₀ m₀ = IsLocalRing.maximalIdeal ↥V_P)
    (G₀ : Set A₀)
    (hG₀_m₀ : G₀ ⊆ m₀)
    (hG₀_gen : Subring.closure (Set.range C₀ ∪ G₀) = ⊤)
    (p₀ : PrimeSpectrum B₁)
    (hp₀_m₀ : Ideal.comap ψ₁ p₀.asIdeal = m₀)
    (M₁ : Set (PrimeSpectrum B₁))
    (hM₁_cl : IsClosed M₁)
    (hM₁_fin : M₁.Finite)
    (hM₁_ne_bot : ∀ y ∈ M₁, Ideal.comap (ψ₁.comp C₀) y.asIdeal ≠ ⊥) :
    (∃ (hHens : HenselianLocalRing (A₀ ⧸ m₀)),
      letI := hHens
      Ideal.comap (Ideal.Quotient.mk m₀) (IsLocalRing.maximalIdeal (A₀ ⧸ m₀)) = m₀) ∧
    (∀ y ∈ M₁, y.asIdeal ≤ p₀.asIdeal →
      let q_y : Ideal A₀ := Ideal.comap ψ₁ y.asIdeal
      ∃ (hHens : HenselianLocalRing (A₀ ⧸ q_y)),
        letI := hHens
        Ideal.comap (Ideal.Quotient.mk q_y) (IsLocalRing.maximalIdeal (A₀ ⧸ q_y)) = m₀) :=
by
  haveI hHensVP : HenselianLocalRing ↥V_P := hPkg_VP.2.2.1
  have hTransfer : ∀ (q : Ideal A₀) [q.IsPrime],
      q ≤ m₀ →
      (∀ t ∈ G₀, ∃ d : ↥V_P, t - C₀ d ∈ q) →
      ∃ (hHens : HenselianLocalRing (A₀ ⧸ q)),
        letI := hHens
        Ideal.comap (Ideal.Quotient.mk q) (IsLocalRing.maximalIdeal (A₀ ⧸ q)) = m₀ := by
    intro q hqPrime hq_le hG₀_mod
    let π_q : ↥V_P →+* (A₀ ⧸ q) := (Ideal.Quotient.mk q).comp C₀
    have hSurj : Function.Surjective π_q := by
      let T : Subring A₀ := π_q.range.comap (Ideal.Quotient.mk q)
      have hSub : Set.range C₀ ∪ G₀ ⊆ (T : Set A₀) := by
        rintro x (⟨r, rfl⟩ | hxG)
        · exact ⟨r, rfl⟩
        · obtain ⟨d, hd⟩ := hG₀_mod x hxG
          have hzero : Ideal.Quotient.mk q x - Ideal.Quotient.mk q (C₀ d) = 0 := by
            rw [← map_sub, Ideal.Quotient.eq_zero_iff_mem]
            exact hd
          exact ⟨d, (sub_eq_zero.mp hzero).symm⟩
      have hTop : (⊤ : Subring A₀) ≤ T := by
        rw [← hG₀_gen]
        exact Subring.closure_le.mpr hSub
      intro y_bar
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
      exact hTop (Subring.mem_top a)
    haveI : IsDomain (A₀ ⧸ q) := Ideal.Quotient.isDomain q
    letI hLoc : IsLocalRing (A₀ ⧸ q) := IsLocalRing.of_surjective' π_q hSurj
    haveI hLocHom : IsLocalHom π_q := IsLocalHom.of_surjective π_q hSurj
    have hMax_iff : ∀ r : ↥V_P,
        π_q r ∈ IsLocalRing.maximalIdeal (A₀ ⧸ q) ↔ r ∈ IsLocalRing.maximalIdeal ↥V_P := by
      intro r
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, mem_nonunits_iff, not_iff_not]
      exact ⟨fun hu => IsLocalHom.map_nonunit r hu, fun hu => hu.map π_q⟩
    have hHens : HenselianLocalRing (A₀ ⧸ q) := by
      refine @HenselianLocalRing.mk (A₀ ⧸ q) _ hLoc ?_
      intro f_bar hf_monic a₀_bar hf_eval hf_deriv
      obtain ⟨a₀, rfl⟩ := hSurj a₀_bar
      have hf_lifts : f_bar ∈ Polynomial.lifts π_q :=
        (Polynomial.mem_lifts f_bar).mpr (Polynomial.map_surjective π_q hSurj f_bar)
      obtain ⟨f, rfl, _, hf_mon⟩ :=
        Polynomial.lifts_and_degree_eq_and_monic hf_lifts hf_monic
      have heval_eq : Polynomial.eval (π_q a₀) (Polynomial.map π_q f) =
          π_q (Polynomial.eval a₀ f) := by
        rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
      have hf_eval_R : Polynomial.eval a₀ f ∈ IsLocalRing.maximalIdeal ↥V_P :=
        (hMax_iff _).mp (heval_eq ▸ hf_eval)
      have hderiv_eq : Polynomial.eval (π_q a₀) (Polynomial.derivative (Polynomial.map π_q f)) =
          π_q (Polynomial.eval a₀ (Polynomial.derivative f)) := by
        rw [Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
      have hf_deriv_R : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) :=
        IsLocalHom.map_nonunit _ (hderiv_eq ▸ hf_deriv)
      obtain ⟨a, ha_root, ha_mem⟩ :=
        HenselianLocalRing.is_henselian f hf_mon a₀ hf_eval_R hf_deriv_R
      refine ⟨π_q a, ?_, ?_⟩
      · change Polynomial.eval (π_q a) (Polynomial.map π_q f) = 0
        rw [Polynomial.eval_map, Polynomial.eval₂_at_apply, ha_root.eq_zero, map_zero]
      · have hsub : π_q a - π_q a₀ = π_q (a - a₀) := (map_sub π_q a a₀).symm
        rw [hsub]
        exact (hMax_iff (a - a₀)).mpr ha_mem
    refine ⟨hHens, ?_⟩
    ext x
    rw [Ideal.mem_comap]
    obtain ⟨r, hr⟩ := hSurj (Ideal.Quotient.mk q x)
    have hx_sub : x - C₀ r ∈ m₀ := by
      apply hq_le
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
      exact sub_eq_zero.mpr hr.symm
    have hCr_iff : C₀ r ∈ m₀ ↔ x ∈ m₀ := by
      constructor
      · intro hCr
        have hadd := m₀.add_mem hx_sub hCr
        simpa only [sub_add_cancel] using hadd
      · intro hx
        have hsub := m₀.sub_mem hx hx_sub
        simpa only [sub_sub_cancel] using hsub
    rw [← hr, hMax_iff r, ← hm₀_comap, Ideal.mem_comap, hCr_iff]
  refine ⟨?_, ?_⟩
  · refine hTransfer m₀ le_rfl ?_
    intro t ht
    refine ⟨0, ?_⟩
    rw [map_zero, sub_zero]
    exact hG₀_m₀ ht
  · intro y hy hyle
    let q_y : Ideal A₀ := Ideal.comap ψ₁ y.asIdeal
    haveI : q_y.IsPrime := Ideal.comap_isPrime ψ₁ y.asIdeal
    have hq_y_le : q_y ≤ m₀ := hp₀_m₀ ▸ Ideal.comap_mono hyle
    let γ₁ : ↥V_P →+* B₁ := ψ₁.comp C₀
    let P₀ : Ideal ↥V_P := Ideal.comap γ₁ y.asIdeal
    haveI : P₀.IsPrime := Ideal.comap_isPrime γ₁ y.asIdeal
    have hP₀_ne_bot : P₀ ≠ ⊥ := hM₁_ne_bot y hy
    haveI hAlgCl : IsAlgClosed P₀.ResidueField := hPkg_VP.2.2.2.2.1 P₀ hP₀_ne_bot
    have hSpec_fin : {z : PrimeSpectrum B₁ | y.asIdeal ≤ z.asIdeal}.Finite := by
      refine hM₁_fin.subset ?_
      intro z hz
      have hz_cl : z ∈ closure ({y} : Set (PrimeSpectrum B₁)) :=
        (PrimeSpectrum.le_iff_mem_closure y z).mp hz
      exact (hM₁_cl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hy)) hz_cl
    let B_y : Type u := B₁ ⧸ y.asIdeal
    haveI : IsDomain B_y := Ideal.Quotient.isDomain y.asIdeal
    let γ_bar : ↥V_P →+* B_y := (Ideal.Quotient.mk y.asIdeal).comp γ₁
    let S_y : Submonoid B_y := P₀.primeCompl.map γ_bar
    have hS_le : S_y ≤ nonZeroDivisors B_y := by
      rintro _ ⟨s, hs, rfl⟩
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro hzero
      apply hs
      change γ₁ s ∈ y.asIdeal
      exact Ideal.Quotient.eq_zero_iff_mem.mp hzero
    let D_y : Type u := Localization S_y
    haveI : IsDomain D_y := IsLocalization.isDomain_localization hS_le
    have hInj_loc : Function.Injective (algebraMap B_y D_y) :=
      IsLocalization.injective D_y hS_le
    let f_RD : ↥V_P →+* D_y := (algebraMap B_y D_y).comp γ_bar
    have hf₁ : P₀ ≤ RingHom.ker f_RD := by
      intro r hr
      rw [RingHom.mem_ker]
      have h0 : γ_bar r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
      simp [f_RD, h0]
    have hf₂ : P₀.primeCompl ≤ Submonoid.comap f_RD (IsUnit.submonoid D_y) := by
      intro s hs
      rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      exact IsLocalization.map_units D_y (⟨γ_bar s, ⟨s, hs, rfl⟩⟩ : ↥S_y)
    let φ_K : P₀.ResidueField →+* D_y := Ideal.ResidueField.lift P₀ f_RD hf₁ hf₂
    let ψ_BD : B₁ →+* D_y := (algebraMap B_y D_y).comp (Ideal.Quotient.mk y.asIdeal)
    have hFT_φ : φ_K.FiniteType := by
      classical
      letI : Algebra ↥V_P B₁ := γ₁.toAlgebra
      haveI : Algebra.FiniteType ↥V_P B₁ := hFT_B₁
      obtain ⟨F_B, hFB⟩ := Algebra.FiniteType.out (R := ↥V_P) (A := B₁)
      letI : Algebra P₀.ResidueField D_y := φ_K.toAlgebra
      change Algebra.FiniteType P₀.ResidueField D_y
      refine ⟨⟨F_B.image ψ_BD, ?_⟩⟩
      let A_sub : Subalgebra P₀.ResidueField D_y :=
        Algebra.adjoin P₀.ResidueField (↑(F_B.image ψ_BD) : Set D_y)
      change A_sub = ⊤
      have hB_in : ∀ x : B₁, ψ_BD x ∈ A_sub := by
        let B_sub : Subalgebra ↥V_P B₁ :=
          { A_sub.toSubring.comap ψ_BD with
            algebraMap_mem' := fun r => by
              change ψ_BD (γ₁ r) ∈ A_sub
              have heq : ψ_BD (γ₁ r) = φ_K (algebraMap ↥V_P P₀.ResidueField r) :=
                (Ideal.ResidueField.lift_algebraMap P₀ f_RD hf₁ hf₂ r).symm
