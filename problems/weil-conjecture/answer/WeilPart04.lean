        exact ⟨z, trivial, hzO₁, hzO₂⟩
      have hStalk : ∀ x : ↥P_F,
          IsDomain ↑(P_F.presheaf.stalk x) ∧ IsIntegrallyClosed ↑(P_F.presheaf.stalk x) := by
        intro x
        have hx_cov : x ∈ (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥P_F) ∪
