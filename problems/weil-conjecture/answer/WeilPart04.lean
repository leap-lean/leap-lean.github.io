      exact ⟨Finset.mem_filter.mpr ⟨hy_FM, hyle⟩, hyle⟩
    refine ⟨W_B, hu₀, g_WB, e₀, hW₁.basicOpen g_tot, hg_WB_comm, ?_, hEt_e₀, he₀_comm, ?_, ?_⟩
    · intro y hy
      change u₀_WB ∈ closure ({y} : Set ↥W_B.toScheme)
      have hyle : (φ.base y).asIdeal ≤ p₀.asIdeal := (hZ_good y hy).2
      have hp₀_cl : p₀ ∈ closure ({φ.base y} : Set (PrimeSpectrum B₁)) :=
        (PrimeSpectrum.le_iff_mem_closure (φ.base y) p₀).mp hyle
      rw [mem_closure_iff]
      intro U hU hu₀U
      have hp₀_img : p₀ ∈ φ.base '' U := ⟨u₀_WB, hu₀U, hφ_u₀⟩
      obtain ⟨_, ⟨w, hwU, rfl⟩, hweq⟩ :=
        mem_closure_iff.mp hp₀_cl (φ.base '' U) (hφ_open U hU) hp₀_img
      have hweq' : φ.base w = φ.base y := hweq
      have hwy : w = y := hφ_inj hweq'
      exact ⟨y, hwy ▸ hwU, rfl⟩
    · ext w
      simp only [Set.mem_preimage]
      change e₀.base w = (m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀))) ↔ w = u₀_WB
      constructor
      · intro hw
        let g_rest : B₁ := (∏ z ∈ F_bad, g_bad z) * (∏ y ∈ F_good, h_good y)
        have hgtot_eq : h₀ * g_rest = g_tot := by
          dsimp only [g_tot, g_rest]
          ring
        have hg_rest_notMem : g_rest ∉ p₀.asIdeal := by
          intro hmem
          apply hg_tot_notMem
          rw [← hgtot_eq]
          exact Ideal.mul_mem_left _ h₀ hmem
        have hcomap_w : Ideal.comap ψ₁.hom (φ.base w).asIdeal = m₀.asIdeal := by
          rw [← he₀_ideal w, hw]
        have hφ_eq_p₀ : φ.base w = p₀ :=
          hh₀_uniq g_rest hg_rest_notMem (φ.base w) p₀
            (hgtot_eq.symm ▸ hφ_notMem w) (hgtot_eq.symm ▸ hg_tot_notMem)
            hcomap_w hp₀_m₀
        exact hφ_inj (hφ_eq_p₀.trans hφ_u₀.symm)
      · rintro rfl
        exact he₀_u₀
    · intro y hy
      obtain ⟨hy_good, _⟩ := hZ_good y hy
      ext w
      simp only [Set.mem_preimage]
      change e₀.base w = e₀.base y ↔ w = y
      constructor
      · intro hw
        let g_rest_y : B₁ :=
          h₀ * (∏ z ∈ F_bad, g_bad z) * (∏ y' ∈ F_good.erase (φ.base y), h_good y')
        have hgtot_eq_y : h_good (φ.base y) * g_rest_y = g_tot := by
          have hmul := Finset.mul_prod_erase F_good h_good hy_good
          calc
            h_good (φ.base y) * g_rest_y
                = h₀ * (∏ z ∈ F_bad, g_bad z) *
                    (h_good (φ.base y) * ∏ y' ∈ F_good.erase (φ.base y), h_good y') := by
                  dsimp only [g_rest_y]
                  ring
            _ = g_tot := by
                  rw [hmul]
        have hg_rest_y_notMem : g_rest_y ∉ p₀.asIdeal := by
          intro hmem
          apply hg_tot_notMem
          rw [← hgtot_eq_y]
          exact Ideal.mul_mem_left _ (h_good (φ.base y)) hmem
        have hcomap_wy : Ideal.comap ψ₁.hom (φ.base w).asIdeal =
            Ideal.comap ψ₁.hom (φ.base y).asIdeal := by
          rw [← he₀_ideal w, ← he₀_ideal y, hw]
        have hφ_wy : φ.base w = φ.base y :=
          hh_good_uniq (φ.base y) hy_good g_rest_y hg_rest_y_notMem (φ.base w) (φ.base y)
            (hgtot_eq_y.symm ▸ hφ_notMem w) (hgtot_eq_y.symm ▸ hφ_notMem y)
            hcomap_wy rfl
        exact hφ_inj hφ_wy
      · rintro rfl
        rfl
  rcases hChart₁ with ⟨ψ₁, m₀, hEt, hComm₁, hX_m₀, hm₀_C₀, hp₀_m₀, hRes_p₀⟩ |
      ⟨a₀, ψ₁, m₀, ha₀_ne, ha₀_max, hEt, hComm₁, hX_m₀, hm₀_C₀, hp₀_m₀, hRes_p₀⟩
  · have hFT_C : (Polynomial.C : ↥V_P →+* Polynomial ↥V_P).FiniteType := by
      have hAlg : (algebraMap ↥V_P (Polynomial ↥V_P)) = Polynomial.C := rfl
      rw [← hAlg, RingHom.finiteType_algebraMap]
      infer_instance
    have hG₀_m₀ : ({Polynomial.X} : Set (Polynomial ↥V_P)) ⊆ m₀.asIdeal := by
      rintro _ rfl
      exact hX_m₀
    have hG₀_gen : Subring.closure
        (Set.range (Polynomial.C : ↥V_P →+* Polynomial ↥V_P) ∪ {Polynomial.X}) = ⊤ := by
      rw [Subring.eq_top_iff']
      intro p
      induction p using Polynomial.induction_on' with
      | add f g hf hg => exact add_mem hf hg
      | monomial n r =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        have hC : (Polynomial.C r : Polynomial ↥V_P) ∈ Subring.closure
            (Set.range (Polynomial.C : ↥V_P →+* Polynomial ↥V_P) ∪ {Polynomial.X}) :=
          Subring.subset_closure (Or.inl ⟨r, rfl⟩)
        have hX : (Polynomial.X : Polynomial ↥V_P) ∈ Subring.closure
            (Set.range (Polynomial.C : ↥V_P →+* Polynomial ↥V_P) ∪ {Polynomial.X}) :=
          Subring.subset_closure (Or.inr rfl)
        exact mul_mem hC (pow_mem hX n)
    obtain ⟨W_B, hu₀, g_WB, e₀, hAff_WB, hg_WB_comm, hCl, hEt_e₀, he₀_comm, hPre_m₀, hPre_y⟩ :=
      hCore (Polynomial ↥V_P) Polynomial.C {Polynomial.X} ψ₁ m₀
        hFT_C hG₀_m₀ hG₀_gen hEt hComm₁ hm₀_C₀ hp₀_m₀ hRes_p₀
    exact ⟨W_B, hu₀, g_WB, hAff_WB, hg_WB_comm, hCl,
      Or.inl ⟨e₀, m₀, hEt_e₀, he₀_comm, hX_m₀, hm₀_C₀, hPre_m₀, hPre_y⟩⟩
  · let f_nod : CommRingCat.of ↥V_P ⟶
        CommRingCat.of (MvPolynomial (Fin 2) ↥V_P ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) :=
      CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
    let C₀ := f_nod.hom
    let G₀ : Set (MvPolynomial (Fin 2) ↥V_P ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) :=
      Set.range (fun i : Fin 2 => Ideal.Quotient.mk _ (MvPolynomial.X i))
    have hFT_C₀ : C₀.FiniteType := by
      have hAlg : algebraMap ↥V_P (MvPolynomial (Fin 2) ↥V_P ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) = C₀ :=
        RingHom.ext fun _ => rfl
      rw [← hAlg, RingHom.finiteType_algebraMap]
      infer_instance
    have hG₀_m₀ : G₀ ⊆ m₀.asIdeal := by
      rintro _ ⟨i, rfl⟩
      exact hX_m₀ i
    have hG₀_gen : Subring.closure (Set.range C₀ ∪ G₀) = ⊤ := by
      rw [Subring.eq_top_iff']
      intro q
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
      induction f using MvPolynomial.induction_on with
      | C r => exact Subring.subset_closure (Or.inl ⟨r, rfl⟩)
      | add p₁ p₂ h₁ h₂ =>
        rw [map_add]
        exact add_mem h₁ h₂
      | mul_X p i hp =>
        rw [map_mul]
        exact mul_mem hp (Subring.subset_closure (Or.inr ⟨i, rfl⟩))
    obtain ⟨W_B, hu₀, g_WB, e₀, hAff_WB, hg_WB_comm, hCl, hEt_e₀, he₀_comm, hPre_m₀, hPre_y⟩ :=
      hCore (MvPolynomial (Fin 2) ↥V_P ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) C₀ G₀ ψ₁ m₀
        hFT_C₀ hG₀_m₀ hG₀_gen hEt hComm₁ hm₀_C₀ hp₀_m₀ hRes_p₀
    exact ⟨W_B, hu₀, g_WB, hAff_WB, hg_WB_comm, hCl,
      Or.inr ⟨a₀, e₀, m₀, ha₀_ne, ha₀_max, hEt_e₀, he₀_comm, hX_m₀, hm₀_C₀, hPre_m₀, hPre_y⟩⟩

theorem weil_strictlySemistable_affine_normality_and_mod_isolation (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens) (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (ι_cur : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_cur)
    (hRes_cur : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C_cur g_cur f_dom_cur τ_cur ι_cur)
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥)
    (x₀ : ↥U'.toScheme)
    (hx₀_cl : IsClosed ({x₀} : Set ↥U'.toScheme))
    (hx₀_P : (U'.ι ≫ g').base x₀ = P) :
    (IsValuationRingAlgPackage m (V.ofPrime P.asIdeal) ∧
      IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥ ∧
      ∃ (ϖ : ↥V) (W_B : U_ss.Opens) (hu₀ : h_mod.base x₀ ∈ W_B)
        (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
        (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod),
        IsIsolatedStrictlySemistableModChart V g_ss (f_dom_cur ≫ h_mod) P (h_mod.base x₀)
          ϖ W_B hu₀ g_WB Z_mod hZ_closed) ∧
    (∀ (C_next : AlgebraicGeometry.Scheme.{u})
        (g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_ss_next : C_next ⟶ U_ss)
        (q_contr : C_cur ⟶ C_next)
        (M_contr : Set ↥C_next)
        (hM_cl : IsClosed M_contr),
      IsStrictlySemistableCurveOverValuation V g_next →
      AlgebraicGeometry.IsProper q_contr →
      AlgebraicGeometry.Surjective q_contr →
      q_contr ≫ g_next = g_cur →
      q_contr ≫ f_ss_next = f_dom_cur ≫ h_mod →
      CategoryTheory.IsIso (q_contr ∣_ (⟨M_contrᶜ, hM_cl.isOpen_compl⟩ : C_next.Opens)) →
      (∀ Q : PrimeSpectrum ↥V,
        (f_dom_cur.base '' (q_contr.base ⁻¹' M_contr ∩ g_cur.base ⁻¹' {Q})).Subsingleton) →
      ∃ f_dom_next : C_next ⟶ U'.toScheme,
        q_contr ≫ f_dom_next = f_dom_cur ∧
        AlgebraicGeometry.IsProper f_dom_next) :=
by
  obtain ⟨hOpenη, hNorm, hFuncEx⟩ :=
    weil_strictlySemistable_isAffineNormal_and_funcField K m V hPkg
  obtain ⟨hPkg_VP, hMax_VP, ϖ, hϖ_P, hϖ_le, hϖ_mem, hOpen_VP⟩ :=
    weil_valuationSubring_ofPrime_algPackage_and_away K m V hPkg P hP
  obtain ⟨hSS_cur, hProp_fdom, hfdom_g, ⟨f_ss, hf_ss, hProp_f_ss⟩,
    hι_fdom, hPb_cur, _hτ_fdom, _hDisj_τ, _hSm_τ⟩ := hRes_cur
  let f_ss_cur : C_cur ⟶ U_ss := f_dom_cur ≫ h_mod
  have hProp_fss_cur : AlgebraicGeometry.IsProper f_ss_cur := by
    change AlgebraicGeometry.IsProper (f_dom_cur ≫ h_mod)
    rw [hf_ss]
    exact hProp_f_ss
  have hComm_fss_cur : f_ss_cur ≫ g_ss = g_cur := by
    change (f_dom_cur ≫ h_mod) ≫ g_ss = g_cur
    rw [CategoryTheory.Category.assoc, hComm_mod]
    exact hfdom_g
  have hNorm_ss : IsAffineNormalScheme U_ss := hNorm U_ss g_ss hSS
  have hNorm_cur : IsAffineNormalScheme C_cur := hNorm C_cur g_cur hSS_cur
  refine ⟨⟨hPkg_VP, hMax_VP, ?_⟩, ?_⟩
  · let u₀ : ↥U_ss := h_mod.base x₀
    have hu₀_cl : IsClosed ({u₀} : Set ↥U_ss) := by
      haveI : AlgebraicGeometry.IsProper h_mod := hProp_mod
      simpa only [Set.image_singleton] using h_mod.isClosedMap ({x₀} : Set ↥U'.toScheme) hx₀_cl
    have hu₀_P : g_ss.base u₀ = P := by
      change (h_mod ≫ g_ss).base x₀ = P
      rw [hComm_mod]
      exact hx₀_P
    let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
    let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    let j_gen : U_K.toScheme ⟶ U_ss := ι_U' ≫ h_mod
    have hOpen_j : AlgebraicGeometry.IsOpenImmersion j_gen :=
      CategoryTheory.MorphismProperty.of_isPullback hPb_ss.flip hOpenη
    letI : AlgebraicGeometry.IsOpenImmersion j_gen := hOpen_j
    let U_gen : U_ss.Opens := j_gen.opensRange
    have hU_gen_nonempty : Nonempty ↥U_gen := by
      have hIntC' : AlgebraicGeometry.IsIntegral C' := hMod'.1
      have hIrredC' : IrreducibleSpace ↥C' :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hIntC'
      have hPb_C' := hMod'.2.2.2.2.2.2.2.1
      have hOpen_ι' : AlgebraicGeometry.IsOpenImmersion ι' :=
        CategoryTheory.MorphismProperty.of_isPullback hPb_C'.flip hOpenη
      letI : AlgebraicGeometry.IsOpenImmersion ι' := hOpen_ι'
      obtain ⟨z_CK⟩ := hIntCK.nonempty
      obtain ⟨u_pt, hu_pt⟩ := hU'
      have hInter : (Set.univ ∩ ((U' : Set ↥C') ∩ (ι'.opensRange : Set ↥C'))).Nonempty :=
        (@IrreducibleSpace.isIrreducible_univ ↥C' _ hIrredC').2
          (U' : Set ↥C') (ι'.opensRange : Set ↥C') U'.isOpen ι'.opensRange.isOpen
          ⟨u_pt, trivial, hu_pt⟩ ⟨ι'.base z_CK, trivial, ⟨z_CK, rfl⟩⟩
      rw [Set.univ_inter] at hInter
      rcases hInter with ⟨_, hc_U', z₀, rfl⟩
      have hz₀_UK : z₀ ∈ U_K := hc_U'
      exact ⟨⟨j_gen.base ⟨z₀, hz₀_UK⟩, ⟨⟨z₀, hz₀_UK⟩, rfl⟩⟩⟩
    have hU_gen_bot : ∀ y : ↥U_ss, (g_ss.base y).asIdeal = ⊥ → y ∈ U_gen := by
      intro y hy
      change y ∈ Set.range j_gen.base
      have hr : Set.range j_gen.base = g_ss.base ⁻¹' Set.range η_V.base := by
        rw [← AlgebraicGeometry.Scheme.Pullback.range_fst g_ss η_V]
        dsimp only [j_gen]
        rw [← hPb_ss.isoPullback_hom_fst]
        change Set.range ((CategoryTheory.Limits.pullback.fst g_ss η_V).base ∘
          hPb_ss.isoPullback.hom.base) = _
        rw [Set.range_comp,
          (ConcreteCategory.bijective_of_isIso hPb_ss.isoPullback.hom.base).2.range_eq,
          Set.image_univ]
      rw [hr, Set.mem_preimage]
      refine ⟨(⊥ : PrimeSpectrum K), ?_⟩
      apply PrimeSpectrum.ext
      rw [hy]
      change Ideal.comap V.subtype ⊥ = ⊥
      ext x
      rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
      exact map_eq_zero_iff V.subtype Subtype.val_injective
    have hPb_left : CategoryTheory.IsPullback ι_cur (𝟙 U_K.toScheme) f_ss_cur j_gen := by
      refine (CategoryTheory.IsPullback.of_right ?_ ?_ hPb_ss.flip).flip
      · rw [CategoryTheory.Category.id_comp, hComm_fss_cur]
        exact hPb_cur.flip
      · rw [CategoryTheory.Category.id_comp]
        change j_gen = (ι_cur ≫ f_dom_cur) ≫ h_mod
        rw [hι_fdom]
    have hIso_gen : CategoryTheory.IsIso (f_ss_cur ∣_ U_gen) := by
      have hIsoSnd : CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd f_ss_cur j_gen) :=
        CategoryTheory.IsIso.of_isIso_fac_left hPb_left.isoPullback_hom_snd
      exact ((CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme).arrow_mk_iso_iff
        (AlgebraicGeometry.morphismRestrictOpensRange f_ss_cur j_gen)).mpr hIsoSnd
    obtain ⟨F_ss, instFieldFss, η_ss, hFunc_ss⟩ := hFuncEx U_ss g_ss hSS
    letI : Field F_ss := instFieldFss
    obtain ⟨U_iso, hIso_Uiso, hFin_Mall, hBot_Mall⟩ :=
      weil_strictlySemistable_modification_locus_finite K m V hPkg U_ss C_cur g_ss
        hAff_ss hSS hNorm_ss F_ss η_ss hFunc_ss g_cur hSS_cur hNorm_cur
        f_ss_cur hProp_fss_cur hComm_fss_cur U_gen hU_gen_nonempty hU_gen_bot hIso_gen
    let M_all : Set ↥U_ss := (U_iso : Set ↥U_ss)ᶜ
    have hM_cl : IsClosed M_all := U_iso.isOpen.isClosed_compl
    obtain ⟨W_B, hu₀, g_WB, hAff_WB, hg_WB, hGen_Z, hEtChart⟩ :=
      weil_henselian_strictlySemistable_etale_chart_isolation K m V P hP hPkg_VP hMax_VP
        ϖ hϖ_P hϖ_le hϖ_mem hOpen_VP U_ss g_ss hAff_ss hSS hNorm_ss
        u₀ hu₀_cl hu₀_P M_all hM_cl hFin_Mall hBot_Mall
    let Z_mod : Set ↥W_B.toScheme := W_B.ι.base ⁻¹' M_all
    have hZ_closed : IsClosed Z_mod := hM_cl.preimage W_B.ι.continuous
    have hZ_fin : Z_mod.Finite :=
      hFin_Mall.preimage W_B.ι.isOpenEmbedding.injective.injOn
    have hZ_ne_bot : ∀ y ∈ Z_mod, ((W_B.ι ≫ g_ss).base y).asIdeal ≠ ⊥ := by
      intro y hy
      exact hBot_Mall (W_B.ι.base y) hy
    have hIso_f0 : CategoryTheory.IsIso
        ((f_ss_cur ∣_ W_B) ∣_ (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B.toScheme.Opens)) := by
      let V_WB : W_B.toScheme.Opens := ⟨Z_modᶜ, hZ_closed.isOpen_compl⟩
      let U_sub : U_ss.Opens := W_B.ι.opensFunctor.obj V_WB
      have hU_le : U_sub ≤ U_iso := by
        intro u hu
        rcases hu with ⟨y, hy, rfl⟩
        have hy' : y ∉ Z_mod := hy
        change y ∉ W_B.ι.base ⁻¹' (U_iso : Set ↥U_ss)ᶜ at hy'
        rw [Set.mem_preimage, Set.mem_compl_iff, not_not] at hy'
        exact hy'
      have pb_sub := AlgebraicGeometry.isPullback_morphismRestrict f_ss_cur U_sub
      have pb_Uiso := AlgebraicGeometry.isPullback_morphismRestrict f_ss_cur U_iso
      let i_sub : U_sub.toScheme ⟶ U_iso.toScheme := U_ss.homOfLE hU_le
      let i_top :
          AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map f_ss_cur.base).obj U_sub) ⟶
          AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map f_ss_cur.base).obj U_iso) :=
        C_cur.homOfLE ((TopologicalSpace.Opens.map f_ss_cur.base).monotone hU_le)
      have htop_fac :
          i_top ≫ AlgebraicGeometry.Scheme.Opens.ι
            ((TopologicalSpace.Opens.map f_ss_cur.base).obj U_iso) =
          AlgebraicGeometry.Scheme.Opens.ι
            ((TopologicalSpace.Opens.map f_ss_cur.base).obj U_sub) :=
        C_cur.homOfLE_ι _
      have hbot_fac : i_sub ≫ U_iso.ι = U_sub.ι :=
        U_ss.homOfLE_ι _
      have hcomm_sub : (f_ss_cur ∣_ U_sub) ≫ i_sub = i_top ≫ (f_ss_cur ∣_ U_iso) := by
        rw [← CategoryTheory.cancel_mono U_iso.ι]
        calc
          ((f_ss_cur ∣_ U_sub) ≫ i_sub) ≫ U_iso.ι
              = (f_ss_cur ∣_ U_sub) ≫ (i_sub ≫ U_iso.ι) := CategoryTheory.Category.assoc _ _ _
          _ = (f_ss_cur ∣_ U_sub) ≫ U_sub.ι := by rw [hbot_fac]
          _ = (f_ss_cur ⁻¹ᵁ U_sub).ι ≫ f_ss_cur := pb_sub.w
          _ = (i_top ≫ (f_ss_cur ⁻¹ᵁ U_iso).ι) ≫ f_ss_cur := by
                congr 1
                exact htop_fac.symm
          _ = i_top ≫ ((f_ss_cur ⁻¹ᵁ U_iso).ι ≫ f_ss_cur) := CategoryTheory.Category.assoc _ _ _
          _ = i_top ≫ ((f_ss_cur ∣_ U_iso) ≫ U_iso.ι) := by rw [pb_Uiso.w]
          _ = (i_top ≫ (f_ss_cur ∣_ U_iso)) ≫ U_iso.ι :=
                (CategoryTheory.Category.assoc _ _ _).symm
      have pb_top : CategoryTheory.IsPullback (f_ss_cur ∣_ U_sub) i_top i_sub (f_ss_cur ∣_ U_iso) := by
        refine CategoryTheory.IsPullback.of_bot ?_ hcomm_sub pb_Uiso
        simpa only [htop_fac, hbot_fac] using pb_sub
      have hIso_sub : CategoryTheory.IsIso (f_ss_cur ∣_ U_sub) :=
        @CategoryTheory.IsPullback.isIso_fst_of_isIso _ _ _ _ _ _ _ _ _ _ pb_top hIso_Uiso
      exact ((CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme).arrow_mk_iso_iff
        (AlgebraicGeometry.morphismRestrictRestrict f_ss_cur W_B V_WB)).mpr hIso_sub
    exact ⟨ϖ, W_B, hu₀, g_WB, Z_mod, hZ_closed,
      hϖ_P, hϖ_le, hϖ_mem, hOpen_VP, hAff_WB, hg_WB,
      hZ_fin, hZ_ne_bot, hIso_f0, hGen_Z, hEtChart⟩
  · obtain ⟨F_cur, instFieldFcur, η_cur, hFunc_cur⟩ := hFuncEx C_cur g_cur hSS_cur
    letI : Field F_cur := instFieldFcur
    intro C_next g_next f_ss_next q_contr M_contr hM_cl
      hSS_next hProp_q hSurj_q hq_g hq_fss hIso_q hSub_fib
    exact weil_normal_contraction_domination_factorization K m V hPkg hOpenη
      C_K p_K n σ_K hIntCK hSmCK C' g' τ' ι' hMod' U' hU' U_ss g_ss hAff_ss hSS
      h_mod hProp_mod hComm_mod ι_U' hPb_U'
      C_cur g_cur f_dom_cur ι_cur hSS_cur hNorm_cur hProp_fdom hfdom_g hι_fdom hPb_cur
      F_cur η_cur hFunc_cur C_next g_next f_ss_next q_contr M_contr hM_cl
      hSS_next (hNorm C_next g_next hSS_next) hProp_q hSurj_q hq_g hq_fss hIso_q hSub_fib

theorem weil_strictlySemistable_fiber_component_stalk_val_and_dichotomy (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (F : Type u) [Field F] :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    (∀ (Y : AlgebraicGeometry.Scheme.{u})
       (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y),
      IsStrictlySemistableCurveOverValuation R g_Y →
      IsSchemeFunctionField Y F η_Y →
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R),
        (∃ W : ValuationSubring F, IsComponentStalkVal R g_Y η_Y E W) ∧
        (∀ W₁ W₂ : ValuationSubring F,
          IsComponentStalkVal R g_Y η_Y E W₁ →
          IsComponentStalkVal R g_Y η_Y E W₂ →
          W₁ = W₂)) ∧
    (∀ (Y₁ Y₂ : AlgebraicGeometry.Scheme.{u})
       (g₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (g₂ : Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₁)
       (η₂ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₂)
       (α : Y₂ ⟶ Y₁)
       (hα_g : α ≫ g₁ = g₂),
      IsStrictlySemistableCurveOverValuation R g₁ →
      IsStrictlySemistableCurveOverValuation R g₂ →
      IsSchemeFunctionField Y₁ F η₁ →
      IsSchemeFunctionField Y₂ F η₂ →
      η₂ ≫ α = η₁ →
      AlgebraicGeometry.IsProper α →
