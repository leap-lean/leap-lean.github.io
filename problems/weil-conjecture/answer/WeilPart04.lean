      _ = AlgebraicGeometry.Spec.map ψ₀ ≫
            (AlgebraicGeometry.Spec.map φ_glob_loc ≫ AlgebraicGeometry.Spec.map φ_V) :=
          CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map ψ₀ ≫
            AlgebraicGeometry.Spec.map (φ_V ≫ φ_glob_loc) := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map ψ₀ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) := by
