    have hb_cop : φ_BZ.hom b * ψ_a Q' = ψ_a P' := by
      have hψd_ne : ψ_a d ≠ 0 := fun h0 => hd_ne (hψa_inj (h0.trans (map_zero _).symm))
      exact mul_left_cancel₀ hψd_ne (by
        calc
          ψ_a d * (φ_BZ.hom b * ψ_a Q')
              = φ_BZ.hom b * ψ_a (d * Q') := by rw [map_mul]; ring
          _ = φ_BZ.hom b * ψ_a Q₁ := by rw [← hQ₁]
          _ = ψ_a P₁ := hb_poly
          _ = ψ_a (d * P') := by rw [hP₁]
          _ = ψ_a d * ψ_a P' := map_mul ψ_a d P')
    let p' : A_a := e_k0 a P'
    let q' : A_a := e_k0 a Q'
    let u' : A_a := e_k0 a u_bez
    let v' : A_a := e_k0 a v_bez
    have hbez_A : u' * p' + v' * q' = 1 := by
      dsimp only [p', q', u', v']
      rw [← map_mul, ← map_mul, ← map_add, hbez, map_one]
    have hrel_B : α_a q' * b = α_a p' := by
      apply hφ_BZ_inj
      rw [map_mul, hφ_comp, hφ_comp]
      change ψ_a Q' * φ_BZ.hom b = ψ_a P'
      rw [mul_comm]
      exact hb_cop
    have hq'_not_p : q' ∉ p := by
      intro hq_mem
      have hq_q1 : α_a q' ∈ q₁ := by
        rw [← hq₁_over] at hq_mem
        exact hq_mem
      have hp_q1 : α_a p' ∈ q₁ := by
        rw [← hrel_B]
        exact Ideal.mul_mem_right b q₁ hq_q1
      have hp_mem : p' ∈ p := by
        rw [← hq₁_over]
        exact hp_q1
      have h1_p : (1 : A_a) ∈ p := by
        rw [← hbez_A]
        exact Ideal.add_mem p (Ideal.mul_mem_left p u' hp_mem) (Ideal.mul_mem_left p v' hq_mem)
      exact hp.ne_top ((Ideal.eq_top_iff_one p).mpr h1_p)
    have hq'_not_q1 : α_a q' ∉ q₁ := fun hm => hq'_not_p (hq₁_over ▸ hm)
    have hq'_not_q2 : α_a q' ∉ q₂ := fun hm => hq'_not_p (hq₂_over ▸ hm)
    have hiff1 : b ∈ q₁ ↔ p' ∈ p := by
      constructor
      · intro hb1
        rw [← hq₁_over]
        change α_a p' ∈ q₁
        rw [← hrel_B]
        exact Ideal.mul_mem_left q₁ (α_a q') hb1
      · intro hp_mem
        rw [← hq₁_over] at hp_mem
        change α_a p' ∈ q₁ at hp_mem
        rw [← hrel_B] at hp_mem
        exact (hq₁_prime.mem_or_mem hp_mem).resolve_left hq'_not_q1
    have hiff2 : b ∈ q₂ ↔ p' ∈ p := by
      constructor
      · intro hb2
        rw [← hq₂_over]
        change α_a p' ∈ q₂
        rw [← hrel_B]
        exact Ideal.mul_mem_left q₂ (α_a q') hb2
      · intro hp_mem
        rw [← hq₂_over] at hp_mem
        change α_a p' ∈ q₂ at hp_mem
        rw [← hrel_B] at hp_mem
        exact (hq₂_prime.mem_or_mem hp_mem).resolve_left hq'_not_q2
    exact hiff1.trans hiff2.symm

  
