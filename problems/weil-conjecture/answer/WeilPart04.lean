            hCompToMin B₀ j₀ q₀ Z ξ_Z hZ hCl_ξ (hq₀_eq.symm ▸ hξ_in_Z)
          have hp_eq_q₀ : p_Z = q₀ :=
            j₀.isOpenEmbedding.injective (hp_Z_eq.trans hq₀_eq.symm)
          have hq₀_min : q₀.asIdeal ∈ minimalPrimes B₀ := hp_eq_q₀ ▸ hp_Z_min
          obtain ⟨i, hi_not_q₀⟩ :=
            (hNodalMinAndAvoid K₀ (algebraMap ↥W₀ K₀ a) B₀ ψ_mod hEt_ψ).2 q₀.asIdeal hq₀_min
          let I_a : Ideal (MvPolynomial (Fin 2) ↥W₀) :=
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
          let f : ↑(ℰ.presheaf.obj (Opposite.op V₀)) :=
            φ₀ (Ideal.Quotient.mk I_a (MvPolynomial.X i))
          have hf_not_PV : f ∉ (hV₀.primeIdealOf ⟨x_star, hq_V₀⟩).asIdeal := by
            rw [← hcomap_inc, Ideal.mem_comap, hinc_X i]
            exact hi_not_q₀
          let U_Z : ℰ.Opens := ℰ.basicOpen f
          have hUZ : AlgebraicGeometry.IsAffineOpen U_Z := hV₀.basicOpen f
          have hη_mem : x_star ∈ U_Z := by
            let P_V := hV₀.primeIdealOf ⟨x_star, hq_V₀⟩
            have hP_bo : P_V ∈ PrimeSpectrum.basicOpen f := hf_not_PV
            rw [← hV₀.fromSpec_preimage_basicOpen f] at hP_bo
            have hfrom_eq : hV₀.fromSpec.base P_V = x_star :=
              hV₀.fromSpec_primeIdealOf ⟨x_star, hq_V₀⟩
            change x_star ∈ ℰ.basicOpen f
            rw [← hfrom_eq]
            exact hP_bo
          let res_f := ℰ.presheaf.map (homOfLE (ℰ.basicOpen_le f)).op
          letI : Algebra ↑(ℰ.presheaf.obj (Opposite.op V₀))
              ↑(ℰ.presheaf.obj (Opposite.op U_Z)) := res_f.hom.toAlgebra
          haveI : IsLocalization.Away f ↑(ℰ.presheaf.obj (Opposite.op U_Z)) :=
            hV₀.isLocalization_basicOpen f
          let γ : Polynomial ↥W₀ →+* ↑(ℰ.presheaf.obj (Opposite.op U_Z)) :=
            Polynomial.eval₂RingHom
              (res_f.hom.comp (φ₀.comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C)))
              (res_f.hom f)
          have hEt_γ : RingHom.Etale γ :=
            hAwayEtale ↥W₀ ↑(ℰ.presheaf.obj (Opposite.op V₀))
              ↑(ℰ.presheaf.obj (Opposite.op U_Z)) a φ₀ i hEt_φ₀ inferInstance
          have hγ_C : γ.comp Polynomial.C =
              res_f.hom.comp (φ₀.comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C)) := by
            apply RingHom.ext
            intro w
            dsimp only [γ]
            rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          have hComm_γ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (γ.comp Polynomial.C)) =
              hUZ.fromSpec ≫ g_ℰ := by
            rw [hγ_C]
            change AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (φ₀.comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C)) ≫
                  res_f) = hUZ.fromSpec ≫ g_ℰ
            rw [AlgebraicGeometry.Spec.map_comp, hComm_φ₀,
              ← Category.assoc, hV₀.map_fromSpec hUZ (homOfLE (ℰ.basicOpen_le f)).op]
          exact ⟨U_Z, hUZ, hη_mem, γ, hEt_γ, hComm_γ⟩
      obtain ⟨U_Z, hUZ, hη_mem, γ, hEt_γ, hComm_γ⟩ := hex_smooth_chart
      obtain ⟨B₀, ψ₀, j₀, q₀, inc, hEt_ψ₀, hOpen_j₀, hq₀_eq, hcomap_inc, hinc_γ⟩ :=
        hSmoothBC U_Z hUZ γ ξ_Z hη_mem hEt_γ hComm_γ
      have : AlgebraicGeometry.IsOpenImmersion j₀ := hOpen_j₀
      obtain ⟨p_Z, hp_Z_eq, _, hp_Z_min⟩ :=
        hCompToMin B₀ j₀ q₀ Z ξ_Z hZ hCl_ξ (hq₀_eq.symm ▸ hξ_in_Z)
      have hp_eq_q₀ : p_Z = q₀ :=
        j₀.isOpenEmbedding.injective (hp_Z_eq.trans hq₀_eq.symm)
      have hq₀_min : q₀.asIdeal ∈ minimalPrimes B₀ := hp_eq_q₀ ▸ hp_Z_min
      have hcomap_ψ₀ : Ideal.comap ψ₀ q₀.asIdeal = ⊥ := by
        letI : Algebra (Polynomial K₀) B₀ := ψ₀.toAlgebra
        haveI : Algebra.Etale (Polynomial K₀) B₀ := RingHom.Etale.toAlgebra hEt_ψ₀
        haveI : Algebra.HasGoingDown (Polynomial K₀) B₀ := Algebra.HasGoingDown.of_flat
        haveI : q₀.asIdeal.IsPrime := q₀.isPrime
        let r₀ : Ideal (Polynomial K₀) := Ideal.comap ψ₀ q₀.asIdeal
        haveI : r₀.IsPrime := Ideal.IsPrime.comap ψ₀
        haveI : q₀.asIdeal.LiesOver r₀ := ⟨rfl⟩
        haveI : (⊥ : Ideal (Polynomial K₀)).IsPrime := inferInstance
        obtain ⟨q', hq'_le, hq'_prime, hq'_over⟩ :=
          Ideal.exists_ideal_le_liesOver_of_le (R := Polynomial K₀) (S := B₀)
            q₀.asIdeal (bot_le : (⊥ : Ideal (Polynomial K₀)) ≤ r₀)
        have hq'_eq : q' = q₀.asIdeal := le_antisymm hq'_le (hq₀_min.2 ⟨hq'_prime, bot_le⟩ hq'_le)
        have hover := hq'_over.over
        rw [hq'_eq] at hover
        exact hover.symm
      have hcomap_γ : Ideal.comap γ (hUZ.primeIdealOf ⟨x_star, hη_mem⟩).asIdeal =
          Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W₀) := by
        rw [← hcomap_inc]
        have h1 : Ideal.comap γ (Ideal.comap inc q₀.asIdeal) =
            Ideal.comap (inc.comp γ) q₀.asIdeal := (Ideal.comap_comap γ inc).symm
        rw [h1, hinc_γ, ← Ideal.comap_comap, hcomap_ψ₀]
        ext P
        rw [Ideal.mem_comap, Ideal.mem_bot, Polynomial.coe_mapRingHom, Polynomial.ext_iff,
          Ideal.mem_map_C_iff]
        refine forall_congr' fun n => ?_
        rw [Polynomial.coeff_map, Polynomial.coeff_zero, ← RingHom.mem_ker, hKer_K₀]
      have hInt_ℰ : AlgebraicGeometry.IsIntegral ℰ := hSS_ℰ.1
      have hUZ_ne : Nonempty ↥U_Z := ⟨⟨x_star, hη_mem⟩⟩
      obtain ⟨φ_UZ, hFrac_UZ, hSpec_UZ⟩ := hFunc_ℰ U_Z hUZ hUZ_ne
      let A_Z : Type u := ↑(ℰ.presheaf.obj (Opposite.op U_Z))
      letI : Algebra A_Z F := φ_UZ.hom.toAlgebra
      haveI : IsDomain A_Z :=
        @AlgebraicGeometry.IsIntegral.component_integral ℰ hInt_ℰ U_Z hUZ_ne
      have hInj_UZ : Function.Injective φ_UZ.hom :=
        @IsFractionRing.injective A_Z _ F _ _ hFrac_UZ
      have hFrac_rep : ∀ x : F, ∃ b s : A_Z, s ≠ 0 ∧ φ_UZ.hom s * x = φ_UZ.hom b := by
        intro x
        obtain ⟨⟨b, s⟩, hbs⟩ := @IsLocalization.surj A_Z _ (nonZeroDivisors A_Z) F _ _ hFrac_UZ x
        refine ⟨b, s.1, mem_nonZeroDivisors_iff_ne_zero.mp s.2, ?_⟩
        rw [mul_comm]
        exact hbs
      have hγ_LF : ∀ r : ↥W₀, φ_UZ.hom (γ (Polynomial.C r)) = φ_LF (W₀.subtype r) := by
        have hSpec_eq : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ_UZ.hom.comp (γ.comp Polynomial.C))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_LF.comp W₀.subtype)) := by
          change AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (γ.comp Polynomial.C) ≫ φ_UZ) = _
          rw [AlgebraicGeometry.Spec.map_comp, hComm_γ,
            ← Category.assoc, hSpec_UZ, hη_g]
        have hHom_eq : CommRingCat.ofHom (φ_UZ.hom.comp (γ.comp Polynomial.C)) =
            CommRingCat.ofHom (φ_LF.comp W₀.subtype) :=
          AlgebraicGeometry.Spec.map_injective hSpec_eq
        intro r
        exact congrArg (fun f : CommRingCat.of ↥W₀ ⟶ CommRingCat.of F => f.hom r) hHom_eq
      obtain ⟨e_res, hComm_res⟩ := hMakeRes U_Z hUZ hη_mem
      exact ⟨Z_sch, ιZ, K_Z, instFieldKZ, η_Z, pt_Z, U_Z, hUZ, hη_mem, φ_UZ, γ, e_res,
        hClZ, hIntZ, hRangeZ, hDomZ, hFuncZ, hSpec_UZ, hInj_UZ, hFrac_rep, hEt_γ,
        hγ_LF, hcomap_γ, hComm_res⟩

  
  let m₀ : Ideal ↥W₀ := IsLocalRing.maximalIdeal ↥W₀
  have hSurj_k₀ : Function.Surjective (algebraMap ↥W₀ m₀.ResidueField) := by
    rw [IsScalarTower.algebraMap_eq ↥W₀ (↥W₀ ⧸ m₀) m₀.ResidueField]
    exact (Ideal.bijective_algebraMap_quotient_residueField m₀).2.comp Ideal.Quotient.mk_surjective
  have hKer_k₀ : RingHom.ker (algebraMap ↥W₀ m₀.ResidueField) = m₀ :=
    Ideal.ker_algebraMap_residueField m₀
  exact hGenS4 m₀.ResidueField hKer_k₀
    (hGenS3 ↥W₀ m₀.ResidueField g_ℰ hSS_ℰ.1 hProp_ℰ hSS_ℰ.2.2.2.2 hSurj_k₀ hKer_k₀)

theorem weil_p1_generic_coord_and_genFiber_prime_dichotomy (L : Type u) [Field L]
    (W₀ : ValuationSubring L)
    (ℰ : AlgebraicGeometry.Scheme.{u})
    (g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀))
    (hInt_ℰ : AlgebraicGeometry.IsIntegral ℰ)
    (hOpen_η : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)))
    (F : Type u) [Field F]
    (η_ℰ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ ℰ)
    (hFunc_ℰ : IsSchemeFunctionField ℰ F η_ℰ)
    (hGenP1 : ∃ isoGen : CategoryTheory.Limits.pullback g_ℰ
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ≅
          (weilProjectiveSpaceOver L 1).left,
      CategoryTheory.Limits.pullback.snd g_ℰ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) =
        isoGen.hom ≫ (weilProjectiveSpaceOver L 1).hom)
    (hAff_L : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen L 1 a))
    (c_L : ∀ a : Fin (1 + 1),
      L →+* ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a))))
    (t_L : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a))))
    (hCoord_L : IsCommRingProjCoordSystem L 1 hAff_L c_L t_L) :
    ∃ (φ_LF : L →+* F) (t : F),
      η_ℰ ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_LF.comp W₀.subtype)) ∧
      (∀ P : Polynomial L, P ≠ 0 → Polynomial.eval₂ φ_LF t P ≠ 0) ∧
      (∀ f : F, ∃ P Q : Polynomial L, Q ≠ 0 ∧
        f * Polynomial.eval₂ φ_LF t Q = Polynomial.eval₂ φ_LF t P) ∧
      (∀ (U_X : ℰ.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
          (φ_X : ℰ.presheaf.obj (Opposite.op U_X) ⟶ CommRingCat.of F)
          (p : Ideal ↑(ℰ.presheaf.obj (Opposite.op U_X))) [p.IsPrime],
        AlgebraicGeometry.Spec.map φ_X ≫ hUX.fromSpec = η_ℰ →
        Ideal.comap (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_ℰ)).hom p = ⊥ →
        ∀ u : F, u ≠ 0 →
          (∃ b₀ s₀ : ↑(ℰ.presheaf.obj (Opposite.op U_X)),
            s₀ ∉ p ∧ φ_X.hom s₀ * u = φ_X.hom b₀) ∨
          (∃ b₀ s₀ : ↑(ℰ.presheaf.obj (Opposite.op U_X)),
            b₀ ∈ p ∧ s₀ ∉ p ∧ φ_X.hom b₀ * u = φ_X.hom s₀)) :=
by
  classical
  
  have hCov_L : (⨆ a : Fin (1 + 1), weilProjBasicOpen L 1 a) = ⊤ := hCoord_L.2.1
  have hSpec_cL : ∀ a : Fin (1 + 1),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_L a)) =
        (hAff_L a).fromSpec ≫ (weilProjectiveSpaceOver L 1).hom := hCoord_L.2.2.1
  have ht_diag : ∀ a : Fin (1 + 1), t_L a a = 1 := hCoord_L.2.2.2.2.1
  have hGen_L : ∀ a : Fin (1 + 1),
      Subring.closure (Set.range (c_L a) ∪ Set.range (t_L a)) = ⊤ := hCoord_L.2.2.2.2.2.1
  have hUniv_L := hCoord_L.2.2.2.2.2.2.1
  let a_opp : Fin (1 + 1) → Fin (1 + 1) := fun a => if a = 0 then 1 else 0
  have ha_opp_ne : ∀ a : Fin (1 + 1), a_opp a ≠ a := by
    intro a; fin_cases a <;> decide
  let f_to : ∀ a : Fin (1 + 1),
      Polynomial L →+* ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a))) :=
    fun a => Polynomial.eval₂RingHom (c_L a) (t_L a (a_opp a))
  have hex_back : ∀ a : Fin (1 + 1),
      ∃ ψ : ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen L 1 a))) →+* Polynomial L,
        ψ.comp (c_L a) = Polynomial.C ∧
        ∀ b : Fin (1 + 1), ψ (t_L a b) = (if b = a then 1 else Polynomial.X) :=
    fun a => hUniv_L a (Polynomial L) Polynomial.C
      (fun b => if b = a then 1 else Polynomial.X) (by simp)
  choose ψ_back hψ_c hψ_t using hex_back
  have h_back_to : ∀ a : Fin (1 + 1),
      (ψ_back a).comp (f_to a) = RingHom.id (Polynomial L) := by
    intro a
    apply Polynomial.ringHom_ext'
    · apply RingHom.ext
      intro r
      change ψ_back a (f_to a (Polynomial.C r)) = Polynomial.C r
      dsimp only [f_to]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      exact RingHom.congr_fun (hψ_c a) r
    · change ψ_back a (f_to a Polynomial.X) = Polynomial.X
      dsimp only [f_to]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hψ_t a (a_opp a),
        ite_eq_right_iff.mpr (fun h => (ha_opp_ne a h).elim)]
  have h_to_back : ∀ a : Fin (1 + 1),
      (f_to a).comp (ψ_back a) = RingHom.id ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a))) := by
    intro a
    let S_eq : Subring ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a))) :=
      RingHom.eqLocus ((f_to a).comp (ψ_back a)) (RingHom.id _)
    have hsub : Set.range (c_L a) ∪ Set.range (t_L a) ⊆ (S_eq : Set _) := by
      rintro _ (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · change f_to a (ψ_back a (c_L a r)) = c_L a r
        have hc : ψ_back a (c_L a r) = Polynomial.C r := RingHom.congr_fun (hψ_c a) r
        rw [hc]
        dsimp only [f_to]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      · change f_to a (ψ_back a (t_L a b)) = t_L a b
        by_cases hba : b = a
        · subst hba
          rw [ht_diag b, map_one, map_one]
        · have hb_eq : b = a_opp a := by
            fin_cases a <;> fin_cases b <;> simp_all [a_opp]
          rw [hb_eq, hψ_t a (a_opp a), ite_eq_right_iff.mpr (fun h => (ha_opp_ne a h).elim)]
          dsimp only [f_to]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have htop : (⊤ : Subring ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a)))) ≤ S_eq := by
      rw [← hGen_L a]
      exact Subring.closure_le.mpr hsub
    apply RingHom.ext
    intro x
    exact htop (Subring.mem_top x)
  let e_L : ∀ a : Fin (1 + 1),
      Polynomial L ≃+* ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 a))) :=
    fun a => RingEquiv.ofRingHom (f_to a) (ψ_back a) (h_to_back a) (h_back_to a)
  
  let η_W₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)
  have : AlgebraicGeometry.IsOpenImmersion η_W₀ := hOpen_η
  obtain ⟨isoGen, hIsoGen⟩ := hGenP1
  let fst_η := CategoryTheory.Limits.pullback.fst g_ℰ η_W₀
  let snd_η := CategoryTheory.Limits.pullback.snd g_ℰ η_W₀
  have hIsoGen_inv : isoGen.inv ≫ snd_η = (weilProjectiveSpaceOver L 1).hom := by
    dsimp only [snd_η, η_W₀]
    rw [hIsoGen, isoGen.inv_hom_id_assoc]
  have : AlgebraicGeometry.IsOpenImmersion fst_η := inferInstance
  let j_L : ∀ b : Fin (1 + 1),
      AlgebraicGeometry.Spec ((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 b))) ⟶ ℰ :=
    fun b => (hAff_L b).fromSpec ≫ isoGen.inv ≫ fst_η
  have hj_open : ∀ b : Fin (1 + 1), AlgebraicGeometry.IsOpenImmersion (j_L b) := by
    intro b; dsimp only [j_L]; infer_instance
  let W_L : Fin (1 + 1) → ℰ.Opens := fun b => (j_L b).opensRange
  have hWLb : ∀ b : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (W_L b) := by
    intro b
    have := hj_open b
    exact AlgebraicGeometry.isAffineOpen_opensRange (j_L b)
  have hWLb_ne : ∀ b : Fin (1 + 1), Nonempty ↥(W_L b) := by
    intro b
    have hNontriv : Nontrivial ↑((weilProjectiveSpaceOver L 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen L 1 b))) :=
      (e_L b).symm.toEquiv.nontrivial
    obtain ⟨z₀⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr hNontriv
    refine ⟨⟨(j_L b).base z₀, ?_⟩⟩
    change (j_L b).base z₀ ∈ ((j_L b).opensRange : Set ℰ)
    rw [AlgebraicGeometry.Scheme.Hom.coe_opensRange]
    exact ⟨z₀, rfl⟩
  have h_sub1 : ∀ b : Fin (1 + 1),
      Set.range (j_L b).base ⊆ Set.range (hWLb b).fromSpec.base := by
    intro b
    rw [(hWLb b).range_fromSpec]
    exact le_of_eq (AlgebraicGeometry.Scheme.Hom.coe_opensRange (j_L b)).symm
  have h_sub2 : ∀ b : Fin (1 + 1),
      Set.range (hWLb b).fromSpec.base ⊆ Set.range (j_L b).base := by
    intro b
    rw [(hWLb b).range_fromSpec]
    exact le_of_eq (AlgebraicGeometry.Scheme.Hom.coe_opensRange (j_L b))
  let α_spec : ∀ b : Fin (1 + 1),
      AlgebraicGeometry.Spec ((weilProjectiveSpaceOver L 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen L 1 b))) ⟶
        AlgebraicGeometry.Spec (ℰ.presheaf.obj (Opposite.op (W_L b))) :=
    fun b => AlgebraicGeometry.IsOpenImmersion.lift (hWLb b).fromSpec (j_L b) (h_sub1 b)
  let β_spec : ∀ b : Fin (1 + 1),
      AlgebraicGeometry.Spec (ℰ.presheaf.obj (Opposite.op (W_L b))) ⟶
        AlgebraicGeometry.Spec ((weilProjectiveSpaceOver L 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen L 1 b))) :=
    fun b =>
      letI := hj_open b
      AlgebraicGeometry.IsOpenImmersion.lift (j_L b) (hWLb b).fromSpec (h_sub2 b)
  have hα_fac : ∀ b : Fin (1 + 1), α_spec b ≫ (hWLb b).fromSpec = j_L b :=
    fun b => AlgebraicGeometry.IsOpenImmersion.lift_fac (hWLb b).fromSpec (j_L b) (h_sub1 b)
  have hβ_fac : ∀ b : Fin (1 + 1), β_spec b ≫ j_L b = (hWLb b).fromSpec := by
    intro b
    have := hj_open b
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac (j_L b) (hWLb b).fromSpec (h_sub2 b)
  let θ_to : ∀ b : Fin (1 + 1),
      (weilProjectiveSpaceOver L 1).left.presheaf.obj (Opposite.op (weilProjBasicOpen L 1 b)) ⟶
        ℰ.presheaf.obj (Opposite.op (W_L b)) :=
    fun b => AlgebraicGeometry.Spec.preimage (β_spec b)
  let θ_from : ∀ b : Fin (1 + 1),
      ℰ.presheaf.obj (Opposite.op (W_L b)) ⟶
        (weilProjectiveSpaceOver L 1).left.presheaf.obj (Opposite.op (weilProjBasicOpen L 1 b)) :=
    fun b => AlgebraicGeometry.Spec.preimage (α_spec b)
  have hθ_fromSpec : ∀ b : Fin (1 + 1),
      AlgebraicGeometry.Spec.map (θ_to b) ≫ j_L b = (hWLb b).fromSpec := by
    intro b
    rw [AlgebraicGeometry.Spec.map_preimage]
    exact hβ_fac b
  have hθ_to_from : ∀ b : Fin (1 + 1),
      (θ_to b).hom.comp (θ_from b).hom =
        RingHom.id ↑(ℰ.presheaf.obj (Opposite.op (W_L b))) := by
    intro b
    have hSpec_id : β_spec b ≫ α_spec b = 𝟙 _ := by
      apply (CategoryTheory.cancel_mono (hWLb b).fromSpec).mp
      rw [CategoryTheory.Category.assoc, hα_fac b, hβ_fac b, CategoryTheory.Category.id_comp]
    have hCat_id : θ_from b ≫ θ_to b = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
