    obtain ⟨η_V0, hηV0_fac, hPushFunc⟩ := hRestPush
    have hFunc_next : IsSchemeFunctionField C_next F_cur (η_cur ≫ q_contr) := by
      let ι_next : V_0.toScheme ⟶ C_next := (q_contr ∣_ W_compl) ≫ W_compl.ι
      have hOpen_ιnext : AlgebraicGeometry.IsOpenImmersion ι_next :=
        AlgebraicGeometry.IsOpenImmersion.comp (q_contr ∣_ W_compl) W_compl.ι
      have hη_ιnext : η_V0 ≫ ι_next = η_cur ≫ q_contr := by
        dsimp only [ι_next]
        rw [AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc, hηV0_fac]
      exact hη_ιnext ▸ hPushFunc C_next hInt_next ι_next hOpen_ιnext
    have hFunc_bar : IsSchemeFunctionField C_bar F_cur η_C := by
      let V_Γ : C_bar.Opens := (TopologicalSpace.Opens.map π_1.base).obj W_compl
      have hrng_u : Set.range (V_0.ι ≫ τ_Γ).base ⊆ Set.range V_Γ.ι.base := by
        rw [V_Γ.range_ι]
        rintro _ ⟨x, rfl⟩
        change (V_0.ι ≫ τ_Γ ≫ π_1).base x ∈ W_compl
        rw [hτ_1]
        exact x.2
      let u_Γ : V_0.toScheme ⟶ V_Γ.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_Γ.ι (V_0.ι ≫ τ_Γ) hrng_u
      have hu_fac : u_Γ ≫ V_Γ.ι = V_0.ι ≫ τ_Γ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_Γ.ι (V_0.ι ≫ τ_Γ) hrng_u
      let v_Γ : V_Γ.toScheme ⟶ W_compl.toScheme := π_1 ∣_ W_compl
      have huv_eq : u_Γ ≫ v_Γ = q_contr ∣_ W_compl := by
        apply (cancel_mono W_compl.ι).mp
        dsimp only [v_Γ]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc, hu_fac, CategoryTheory.Category.assoc, hτ_1,
          AlgebraicGeometry.morphismRestrict_ι]
      let w_Γ : W_compl.toScheme ⟶ V_0.toScheme := CategoryTheory.inv (q_contr ∣_ W_compl)
      have hu_left : u_Γ ≫ (v_Γ ≫ w_Γ) = 𝟙 V_0.toScheme := by
        rw [← CategoryTheory.Category.assoc, huv_eq, CategoryTheory.IsIso.hom_inv_id]
      have hu_right : (v_Γ ≫ w_Γ) ≫ u_Γ = 𝟙 V_Γ.toScheme := by
        have : AlgebraicGeometry.IsIntegral C_bar := hInt_bar
        have : AlgebraicGeometry.IsReduced V_Γ.toScheme :=
          AlgebraicGeometry.isReduced_of_isOpenImmersion V_Γ.ι
        have : AlgebraicGeometry.IsProper π_1 := hProp_π1
        have : AlgebraicGeometry.IsSeparated π_1 := hProp_π1.toIsSeparated
        have : AlgebraicGeometry.IsSeparated v_Γ := by dsimp only [v_Γ]; infer_instance
        let η_VΓ : AlgebraicGeometry.Spec (CommRingCat.of F_cur) ⟶ V_Γ.toScheme := η_V0 ≫ u_Γ
        have hηVΓ_fac : η_VΓ ≫ V_Γ.ι = η_C := by
          dsimp only [η_VΓ]
          rw [CategoryTheory.Category.assoc, hu_fac, ← CategoryTheory.Category.assoc,
            hηV0_fac, hη_τ]
        have : AlgebraicGeometry.IsDominant η_VΓ := by
          have : AlgebraicGeometry.IsDominant η_C := hDomC
          rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
          intro y
          rw [mem_closure_iff]
          intro o ho hyo
          let O_bar : C_bar.Opens := ⟨V_Γ.ι.base '' o, V_Γ.ι.isOpenEmbedding.isOpenMap o ho⟩
          obtain ⟨_, ⟨y', hy'o, h_eq⟩, pt₀, hpt₀⟩ :=
            hDomC.denseRange.inter_open_nonempty (O_bar : Set ↥C_bar) O_bar.isOpen
              ⟨V_Γ.ι.base y, y, hyo, rfl⟩
          have h_inj : V_Γ.ι.base (η_VΓ.base pt₀) = V_Γ.ι.base y' := by
            change (η_VΓ ≫ V_Γ.ι).base pt₀ = V_Γ.ι.base y'
            rw [hηVΓ_fac, hpt₀, h_eq]
          have hy'_pt : y' = η_VΓ.base pt₀ := (V_Γ.ι.isOpenEmbedding.injective h_inj).symm
          exact ⟨η_VΓ.base pt₀, hy'_pt ▸ hy'o, pt₀, rfl⟩
        exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated v_Γ
          (by
            calc ((v_Γ ≫ w_Γ) ≫ u_Γ) ≫ v_Γ
                = v_Γ ≫ w_Γ ≫ (u_Γ ≫ v_Γ) := by simp only [CategoryTheory.Category.assoc]
              _ = v_Γ ≫ (w_Γ ≫ (q_contr ∣_ W_compl)) := by rw [huv_eq]
              _ = v_Γ := by
                  dsimp only [w_Γ]
                  rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.comp_id]
              _ = 𝟙 V_Γ.toScheme ≫ v_Γ := (CategoryTheory.Category.id_comp v_Γ).symm)
          η_VΓ
          (by
            dsimp only [η_VΓ]
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc u_Γ,
              hu_left, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      have : CategoryTheory.IsIso u_Γ := ⟨⟨v_Γ ≫ w_Γ, hu_left, hu_right⟩⟩
      let ι_bar : V_0.toScheme ⟶ C_bar := u_Γ ≫ V_Γ.ι
      have hOpen_ιbar : AlgebraicGeometry.IsOpenImmersion ι_bar :=
        AlgebraicGeometry.IsOpenImmersion.comp u_Γ V_Γ.ι
      have hη_ιbar : η_V0 ≫ ι_bar = η_C := by
        dsimp only [ι_bar]
        rw [hu_fac, ← CategoryTheory.Category.assoc, hηV0_fac, hη_τ]
      exact hη_ιbar ▸ hPushFunc C_bar hInt_bar ι_bar hOpen_ιbar
    have hCover : ∀ (U_X : C_next.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (U_Y : Y.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Y),
        ∃ (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map π_1.base).obj U_X)
          (e_Y : V_C ≤ (TopologicalSpace.Opens.map π_2.base).obj U_Y),
          (V_C : Set ↥C_bar) = π_1.base ⁻¹' (U_X : Set ↥C_next) ∩ π_2.base ⁻¹' (U_Y : Set ↥Y) ∧
          (π_1.appLE U_X V_C e_X).hom.FiniteType ∧
          Subring.closure
            (Set.range (π_1.appLE U_X V_C e_X).hom ∪
              Set.range (π_2.appLE U_Y V_C e_Y).hom) = ⊤ := by
      subst hπ1_def hπ2_def
      have : AlgebraicGeometry.IsClosedImmersion j_Γ := hCl_jΓ
      let P := CategoryTheory.Limits.pullback f_ss_next h_mod
      let fst_P : P ⟶ C_next := CategoryTheory.Limits.pullback.fst f_ss_next h_mod
      let snd_P : P ⟶ Y := CategoryTheory.Limits.pullback.snd f_ss_next h_mod
      let π_1' : C_bar ⟶ C_next := j_Γ ≫ fst_P
      let π_2' : C_bar ⟶ Y := j_Γ ≫ snd_P
      intro U_X hUX U_Y hUY
      have : AlgebraicGeometry.IsAffine U_ss := hAff_ss
      have : AlgebraicGeometry.IsProper π_1' := hProp_π1
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType π_1' := inferInstance
      let A_ss : Type u := ↑(U_ss.presheaf.obj (Opposite.op ⊤))
      let B_X : Type u := ↑(C_next.presheaf.obj (Opposite.op U_X))
      let B_Y : Type u := ↑(Y.presheaf.obj (Opposite.op U_Y))
      let ψ_X : U_ss.presheaf.obj (Opposite.op ⊤) ⟶ C_next.presheaf.obj (Opposite.op U_X) :=
        AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ f_ss_next ≫ U_ss.isoSpec.hom)
      let ψ_Y : U_ss.presheaf.obj (Opposite.op ⊤) ⟶ Y.presheaf.obj (Opposite.op U_Y) :=
        AlgebraicGeometry.Spec.preimage (hUY.fromSpec ≫ h_mod ≫ U_ss.isoSpec.hom)
      let : Algebra A_ss B_X := ψ_X.hom.toAlgebra
      let : Algebra A_ss B_Y := ψ_Y.hom.toAlgebra
      let f_X := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_ss B_X))
      let f_Y := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_ss B_Y))
      have esq_X : f_X ≫ U_ss.isoSpec.inv = hUX.fromSpec ≫ f_ss_next := by
        have hfX : f_X = AlgebraicGeometry.Spec.map ψ_X := rfl
        rw [hfX, AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      have esq_Y : f_Y ≫ U_ss.isoSpec.inv = hUY.fromSpec ≫ h_mod := by
        have hfY : f_Y = AlgebraicGeometry.Spec.map ψ_Y := rfl
        rw [hfY, AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      let Q_pb := CategoryTheory.Limits.pullback f_X f_Y
      let ι_Q : Q_pb ⟶ P :=
        CategoryTheory.Limits.pullback.map f_X f_Y f_ss_next h_mod
          hUX.fromSpec hUY.fromSpec U_ss.isoSpec.inv esq_X esq_Y
      have : AlgebraicGeometry.IsOpenImmersion ι_Q :=
        AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion f_X f_Y f_ss_next h_mod
          hUX.fromSpec hUY.fromSpec U_ss.isoSpec.inv esq_X esq_Y
      let e_T := AlgebraicGeometry.pullbackSpecIso A_ss B_X B_Y
      let j_T : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A_ss B_X B_Y)) ⟶ P :=
        e_T.inv ≫ ι_Q
      have : AlgebraicGeometry.IsOpenImmersion j_T := inferInstance
      let W_P : P.Opens := j_T.opensRange
      have hWP : AlgebraicGeometry.IsAffineOpen W_P :=
        AlgebraicGeometry.isAffineOpen_opensRange j_T
      have hrng_jT : Set.range j_T.base =
          fst_P.base ⁻¹' (U_X : Set ↥C_next) ∩ snd_P.base ⁻¹' (U_Y : Set ↥Y) := by
        dsimp only [j_T]
        change Set.range (ι_Q.base ∘ e_T.inv.base) = _
        rw [Set.range_comp,
          (CategoryTheory.ConcreteCategory.bijective_of_isIso e_T.inv.base).2.range_eq,
          Set.image_univ,
          AlgebraicGeometry.Scheme.Pullback.range_map f_X f_Y f_ss_next h_mod
            hUX.fromSpec hUY.fromSpec U_ss.isoSpec.inv esq_X esq_Y,
          show Set.range hUX.fromSpec.base = (U_X : Set ↥C_next) from
            congrArg SetLike.coe hUX.opensRange_fromSpec,
          show Set.range hUY.fromSpec.base = (U_Y : Set ↥Y) from
            congrArg SetLike.coe hUY.opensRange_fromSpec]
      have hWP_coe : (W_P : Set ↥P) =
          fst_P.base ⁻¹' (U_X : Set ↥C_next) ∩ snd_P.base ⁻¹' (U_Y : Set ↥Y) :=
        hrng_jT
      have w_X : W_P ≤ (TopologicalSpace.Opens.map fst_P.base).obj U_X := by
        intro p hp
        have hp' : p ∈ (W_P : Set ↥P) := hp
        rw [hWP_coe] at hp'
        exact hp'.1
      have w_Y : W_P ≤ (TopologicalSpace.Opens.map snd_P.base).obj U_Y := by
        intro p hp
        have hp' : p ∈ (W_P : Set ↥P) := hp
        rw [hWP_coe] at hp'
        exact hp'.2
      let V_C : C_bar.Opens := (TopologicalSpace.Opens.map j_Γ.base).obj W_P
      have hVC : AlgebraicGeometry.IsAffineOpen V_C := hWP.preimage j_Γ
      have e_X : V_C ≤ (TopologicalSpace.Opens.map π_1'.base).obj U_X :=
        fun x hx => w_X hx
      have e_Y : V_C ≤ (TopologicalSpace.Opens.map π_2'.base).obj U_Y :=
        fun x hx => w_Y hx
      have hVC_set : (V_C : Set ↥C_bar) =
          π_1'.base ⁻¹' (U_X : Set ↥C_next) ∩ π_2'.base ⁻¹' (U_Y : Set ↥Y) := by
        ext z
        change j_Γ.base z ∈ (W_P : Set ↥P) ↔ _
        rw [hWP_coe]
        rfl
      refine ⟨V_C, hVC, e_X, e_Y, hVC_set, hLFT.finiteType_appLE hUX hVC e_X, ?_⟩
      have hrng_WP : Set.range hWP.fromSpec.base = Set.range j_T.base :=
        congrArg SetLike.coe hWP.opensRange_fromSpec
      let g_hom := AlgebraicGeometry.IsOpenImmersion.lift j_T hWP.fromSpec (le_of_eq hrng_WP)
      let g_inv := AlgebraicGeometry.IsOpenImmersion.lift hWP.fromSpec j_T (le_of_eq hrng_WP.symm)
      have hg_hom : g_hom ≫ j_T = hWP.fromSpec :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_T hWP.fromSpec _
      have hg_inv : g_inv ≫ hWP.fromSpec = j_T :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hWP.fromSpec j_T _
      have hg_id : g_hom ≫ g_inv = 𝟙 _ := by
        apply (cancel_mono hWP.fromSpec).mp
        rw [CategoryTheory.Category.assoc, hg_inv, hg_hom, CategoryTheory.Category.id_comp]
      let θ_hom : CommRingCat.of (TensorProduct A_ss B_X B_Y) ⟶ P.presheaf.obj (Opposite.op W_P) :=
        AlgebraicGeometry.Spec.preimage g_hom
      let θ_inv : P.presheaf.obj (Opposite.op W_P) ⟶ CommRingCat.of (TensorProduct A_ss B_X B_Y) :=
        AlgebraicGeometry.Spec.preimage g_inv
      have hθ_id : θ_inv ≫ θ_hom = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id,
          AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage, hg_id]
      have hSpec_θ : AlgebraicGeometry.Spec.map θ_hom ≫ j_T = hWP.fromSpec := by
        rw [AlgebraicGeometry.Spec.map_preimage]
        exact hg_hom
      have hfst_appLE : fst_P.appLE U_X W_P w_X =
          CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ θ_hom := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hUX.fromSpec).mp
        rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec fst_P hUX hWP w_X,
          ← hSpec_θ]
        dsimp only [j_T, ι_Q, fst_P, e_T, f_X, f_Y]
        simp only [CategoryTheory.Category.assoc]
        rw [CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso A_ss B_X B_Y).inv,
          AlgebraicGeometry.pullbackSpecIso_inv_fst A_ss B_X B_Y,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hsnd_appLE : snd_P.appLE U_Y W_P w_Y =
          CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ θ_hom := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hUY.fromSpec).mp
        rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec snd_P hUY hWP w_Y,
          ← hSpec_θ]
        dsimp only [j_T, ι_Q, snd_P, e_T, f_X, f_Y]
        simp only [CategoryTheory.Category.assoc]
        rw [CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso A_ss B_X B_Y).inv,
          AlgebraicGeometry.pullbackSpecIso_inv_snd A_ss B_X B_Y,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        rfl
      have hπ1_appLE : π_1'.appLE U_X V_C e_X = fst_P.appLE U_X W_P w_X ≫ j_Γ.app W_P := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j_Γ fst_P U_X W_P V_C w_X (le_refl V_C)]
      have hπ2_appLE : π_2'.appLE U_Y V_C e_Y = snd_P.appLE U_Y W_P w_Y ≫ j_Γ.app W_P := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j_Γ snd_P U_Y W_P V_C w_Y (le_refl V_C)]
      let Ψ : TensorProduct A_ss B_X B_Y →+* ↑(C_bar.presheaf.obj (Opposite.op V_C)) :=
        (θ_hom ≫ j_Γ.app W_P).hom
      have hSurj_jΓ : Function.Surjective (j_Γ.app W_P).hom :=
        AlgebraicGeometry.Scheme.Hom.app_surjective j_Γ W_P hWP
      have hSurj_θ : Function.Surjective θ_hom.hom :=
        fun y => ⟨θ_inv.hom y, congrArg (fun f => f.hom y) hθ_id⟩
      have hSurj_Ψ : Function.Surjective Ψ := hSurj_jΓ.comp hSurj_θ
      let α := (π_1'.appLE U_X V_C e_X).hom
      let β := (π_2'.appLE U_Y V_C e_Y).hom
      have hα_eq : ∀ b_X : B_X, α b_X = Ψ (b_X ⊗ₜ[A_ss] (1 : B_Y)) := by
        intro b_X
        change (π_1'.appLE U_X V_C e_X).hom b_X = _
        rw [hπ1_appLE, hfst_appLE]
        rfl
      have hβ_eq : ∀ b_Y : B_Y, β b_Y = Ψ ((1 : B_X) ⊗ₜ[A_ss] b_Y) := by
        intro b_Y
        change (π_2'.appLE U_Y V_C e_Y).hom b_Y = _
        rw [hπ2_appLE, hsnd_appLE]
        rfl
      let S := Subring.closure (Set.range α ∪ Set.range β)
      have hΨ_mem : ∀ t : TensorProduct A_ss B_X B_Y, Ψ t ∈ S := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero =>
          rw [map_zero]
          exact S.zero_mem
        | tmul b_X b_Y =>
          have hmul : (b_X ⊗ₜ[A_ss] b_Y) = (b_X ⊗ₜ[A_ss] (1 : B_Y)) * ((1 : B_X) ⊗ₜ[A_ss] b_Y) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hmul, map_mul, ← hα_eq, ← hβ_eq]
          exact S.mul_mem
            (Subring.subset_closure (Or.inl ⟨b_X, rfl⟩))
            (Subring.subset_closure (Or.inr ⟨b_Y, rfl⟩))
        | add x y hx hy =>
          rw [map_add]
          exact S.add_mem hx hy
      rw [eq_top_iff]
      intro c _
      obtain ⟨t, rfl⟩ := hSurj_Ψ c
      exact hΨ_mem t
    exact ⟨C_bar, π_1, π_2, τ_Γ, η_C, hInt_bar, hDomC, hProp_π1,
      hτ_1, hτ_2, hSurj_τ, hη_π1, hFunc_bar, hFunc_next, hCover⟩
  obtain ⟨C_bar, π_1, π_2, τ_Γ, η_C, hInt_bar, hDomC, hProp_π1,
    hτ_1, hτ_2, hSurj_τ, hη_π1, hFunc_bar, hFunc_next, hCover⟩ := hStep2
  
  have hComm_bar : π_1 ≫ g_next = π_2 ≫ (U'.ι ≫ g') := by
    have : AlgebraicGeometry.IsIntegral C_bar := hInt_bar
    have : AlgebraicGeometry.IsDominant τ_Γ := ⟨hSurj_τ.denseRange⟩
    exact AlgebraicGeometry.ext_of_isDominant τ_Γ
      (by
        calc τ_Γ ≫ (π_1 ≫ g_next)
            = (τ_Γ ≫ π_1) ≫ g_next := (CategoryTheory.Category.assoc _ _ _).symm
          _ = q_contr ≫ g_next := by rw [hτ_1]
          _ = g_cur := hq_g
          _ = f_dom_cur ≫ U'.ι ≫ g' := hfdom_g.symm
          _ = (τ_Γ ≫ π_2) ≫ (U'.ι ≫ g') := by rw [hτ_2]
          _ = τ_Γ ≫ (π_2 ≫ (U'.ι ≫ g')) := CategoryTheory.Category.assoc _ _ _)
  have hLFT_Y : AlgebraicGeometry.LocallyOfFiniteType (U'.ι ≫ g') := by
    have : AlgebraicGeometry.LocallyOfFinitePresentation g' := hMod'.2.2.2.1
    exact inferInstance
  have hLocQF : ∀ z : C_bar,
      ∃ (U_X : C_next.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map π_1.base).obj U_X),
        z ∈ V_C ∧
        (π_1.appLE U_X V_C e_X).hom.FiniteType ∧
        (π_1.appLE U_X V_C e_X).hom.QuasiFinite := by
    classical
    let R := ↥V
    let Y := U'.toScheme
    let g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) := U'.ι ≫ g'
    have hFinFib : ∀ x : ↥C_next, (π_1.base ⁻¹' {x}).Finite := by
      intro x
      by_cases hxM : x ∈ M_contr
      · by_cases hFib_ne : (π_1.base ⁻¹' {x}).Nonempty
        · obtain ⟨w₀, hw₀⟩ := hFib_ne
          let Q : PrimeSpectrum R := g_next.base x
          let F_pre : Set ↥C_cur := q_contr.base ⁻¹' M_contr
          let Y_im : Set ↥Y := f_dom_cur.base '' F_pre
          have hF_cl : IsClosed F_pre := hM_cl.preimage q_contr.continuous
          have : AlgebraicGeometry.IsProper f_dom_cur := hProp_fdom
          have hYim_cl : IsClosed Y_im := f_dom_cur.isClosedMap F_pre hF_cl
          have hFib_mem : ∀ w ∈ π_1.base ⁻¹' {x},
              π_2.base w ∈ f_dom_cur.base '' (F_pre ∩ g_cur.base ⁻¹' {Q}) := by
            intro w hw
            obtain ⟨c, rfl⟩ := hSurj_τ w
            have hqc : q_contr.base c = x := by rw [← hτ_1]; exact hw
            have hgc : g_cur.base c = Q := by
              rw [← hq_g]
              change g_next.base (q_contr.base c) = Q
              rw [hqc]
            have hπ2 : π_2.base (τ_Γ.base c) = f_dom_cur.base c := by
              change (τ_Γ ≫ π_2).base c = f_dom_cur.base c
              rw [hτ_2]
            rw [hπ2]
