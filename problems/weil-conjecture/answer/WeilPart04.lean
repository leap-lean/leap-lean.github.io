          have h0 : ψ_bar (u 0) * ψ_bar (u 1) ∈ p.asIdeal := by
            rw [← map_mul, hu_mul, map_zero]; exact p.asIdeal.zero_mem
          exact p.isPrime.mem_or_mem h0
        have h_univ_irr : IsIrreducible (Set.univ : Set (PrimeSpectrum B_bar)) :=
          IrreducibleSpace.isIrreducible_univ (X := PrimeSpectrum B_bar)
        have h_branch :=
          (isPreirreducible_iff_isClosed_union_isClosed.mp h_univ_irr.isPreirreducible)
            _ _ (PrimeSpectrum.isClosed_zeroLocus _) (PrimeSpectrum.isClosed_zeroLocus _) h_cov_u
        obtain ⟨j, hj_all⟩ : ∃ j : Fin 2,
            ∀ p : PrimeSpectrum B_bar, ψ_bar (u j) ∈ p.asIdeal := by
          rcases h_branch with h0 | h1
          · refine ⟨0, fun p => ?_⟩
            have hm := h0 (Set.mem_univ p)
            rwa [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at hm
          · refine ⟨1, fun p => ?_⟩
            have hm := h1 (Set.mem_univ p)
            rwa [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at hm
        have h𝔔_le_𝔭 : 𝔔 ≤ 𝔭 := Ideal.map_le_iff_le_comap.mpr h𝔭_comap.ge
        let 𝔭_bar : Ideal B_bar := Ideal.map (Ideal.Quotient.mk 𝔔) 𝔭
        have _ : 𝔭_bar.IsPrime :=
          Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
        have h_u_mem_𝔭bar : ∀ i : Fin 2, ψ_bar (u i) ∈ 𝔭_bar := by
          intro i
          rw [hψ_bar_u i]
          exact Ideal.mem_map_of_mem (Ideal.Quotient.mk 𝔔) (h_both i)
        let ev_j_raw : MvPolynomial (Fin 2) κ →+* Polynomial κ :=
          MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = j then Polynomial.X else 0)
        have hev_j_Iκ_le : I_κ ≤ RingHom.ker ev_j_raw := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          fin_cases j <;> simp [ev_j_raw]
        let ev_j : A_nod_κ →+* Polynomial κ :=
          Ideal.Quotient.lift I_κ ev_j_raw (fun p hp => hev_j_Iκ_le hp)
        have hev_j_mk : ∀ p : MvPolynomial (Fin 2) κ, ev_j (Ideal.Quotient.mk I_κ p) = ev_j_raw p :=
          fun _ => rfl
        let 𝔮_base : Ideal A_nod_κ := RingHom.ker ev_j
        have _ : 𝔮_base.IsPrime := RingHom.ker_isPrime ev_j
        let 𝔪_base : Ideal A_nod_κ := Ideal.under A_nod_κ 𝔭_bar
        have _ : 𝔪_base.IsPrime := Ideal.comap_isPrime (algebraMap A_nod_κ B_bar) 𝔭_bar
        have _ : 𝔭_bar.LiesOver 𝔪_base := ⟨rfl⟩
        have h𝔮_le_𝔪 : 𝔮_base ≤ 𝔪_base := by
          let ev_zero : Polynomial κ →+* (B_bar ⧸ 𝔭_bar) :=
            Polynomial.eval₂RingHom
              (((Ideal.Quotient.mk 𝔭_bar).comp ψ_bar).comp
                ((Ideal.Quotient.mk I_κ).comp MvPolynomial.C)) 0
          have h_tri : ev_zero.comp ev_j = (Ideal.Quotient.mk 𝔭_bar).comp ψ_bar := by
            apply Ideal.Quotient.ringHom_ext
            apply MvPolynomial.ringHom_ext
            · intro c
              change ev_zero (ev_j (Ideal.Quotient.mk I_κ (MvPolynomial.C c))) =
                Ideal.Quotient.mk 𝔭_bar (ψ_bar (Ideal.Quotient.mk I_κ (MvPolynomial.C c)))
              rw [hev_j_mk, MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
              rfl
            · intro i
              change ev_zero (ev_j (Ideal.Quotient.mk I_κ (MvPolynomial.X i))) =
                Ideal.Quotient.mk 𝔭_bar (ψ_bar (u i))
              rw [hev_j_mk, MvPolynomial.eval₂Hom_X']
              have h_rhs0 : Ideal.Quotient.mk 𝔭_bar (ψ_bar (u i)) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (h_u_mem_𝔭bar i)
              rw [h_rhs0]
              by_cases hij : i = j <;> simp [hij, ev_zero]
          intro x hx
          change ψ_bar x ∈ 𝔭_bar
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          change ((Ideal.Quotient.mk 𝔭_bar).comp ψ_bar) x = 0
          rw [← h_tri, RingHom.comp_apply]
          have hx0 : ev_j x = 0 := hx
          rw [hx0, map_zero]
        obtain ⟨𝔮_D, _, h𝔮D_prime, h𝔮D_over⟩ :=
          Ideal.exists_ideal_le_liesOver_of_le (p := 𝔮_base) (q := 𝔪_base) 𝔭_bar h𝔮_le_𝔪
        have huj_𝔮D : ψ_bar (u j) ∈ 𝔮_D := hj_all ⟨𝔮_D, h𝔮D_prime⟩
        have huj_under : u j ∈ Ideal.under A_nod_κ 𝔮_D := huj_𝔮D
        rw [← h𝔮D_over.over] at huj_under
        have hX_zero : ev_j (u j) = 0 := huj_under
        have hX_eq : ev_j (u j) = Polynomial.X := by
          rw [hev_j_mk, MvPolynomial.eval₂Hom_X']
          simp
        exact Polynomial.X_ne_zero (hX_eq.symm.trans hX_zero)
      · intro i hi_unit
        let x_i : A_nod := Ideal.Quotient.mk I_V0 (MvPolynomial.X i)
        let φ_loc : Localization.Away x_i →+* B := IsLocalization.Away.lift x_i hi_unit
        have hφ_loc_comp : φ_loc.comp (algebraMap A_nod (Localization.Away x_i)) = φ_0 :=
          RingHom.ext (IsLocalization.Away.lift_eq x_i hi_unit)
        have hLnod_unit : IsUnit (algebraMap A_nod (Localization.Away x_i) x_i) :=
          IsLocalization.Away.algebraMap_isUnit x_i
        have hLnod_span : ∀ z : Localization.Away x_i,
            ∃ (z_0 : A_nod) (k : ℕ),
              z * (algebraMap A_nod (Localization.Away x_i) x_i) ^ k =
                algebraMap A_nod (Localization.Away x_i) z_0 := by
          intro z
          obtain ⟨k, z_0, hzk⟩ := IsLocalization.Away.surj x_i z
          exact ⟨z_0, k, hzk⟩
        have hφ_loc_et : φ_loc.Etale :=
          hClearEtale (algebraMap A_nod (Localization.Away x_i)) x_i
            hLnod_unit hLnod_span φ_0 hφ0_et φ_loc hφ_loc_comp
        let x_dir : Localization.Away (Polynomial.X : Polynomial V₀) :=
          algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) Polynomial.X
        let x_inv : Localization.Away (Polynomial.X : Polynomial V₀) :=
          algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) *
            IsLocalization.Away.invSelf (S := Localization.Away (Polynomial.X : Polynomial V₀))
              (Polynomial.X : Polynomial V₀)
        let α_raw : MvPolynomial (Fin 2) V₀ →+* Localization.Away (Polynomial.X : Polynomial V₀) :=
          MvPolynomial.eval₂Hom
            ((algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀))).comp Polynomial.C)
            (fun j : Fin 2 => if j = i then x_dir else x_inv)
        have hα_IV0_le : I_V0 ≤ RingHom.ker α_raw := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          have hX_inv : x_dir *
              IsLocalization.Away.invSelf (S := Localization.Away (Polynomial.X : Polynomial V₀))
                (Polynomial.X : Polynomial V₀) = 1 :=
            IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial V₀)
          fin_cases i
          · simp only [α_raw, x_dir, x_inv, Fin.isValue,
              map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
            calc
              algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) Polynomial.X *
                  (algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) *
                    IsLocalization.Away.invSelf (S := Localization.Away (Polynomial.X : Polynomial V₀))
                      (Polynomial.X : Polynomial V₀)) -
                  algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a)
                  = algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) *
                      (x_dir * IsLocalization.Away.invSelf
                        (S := Localization.Away (Polynomial.X : Polynomial V₀))
                        (Polynomial.X : Polynomial V₀)) -
                      algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) := by
                    dsimp only [x_dir]; ring
              _ = 0 := by rw [hX_inv, mul_one, sub_self]
          · simp only [α_raw, x_dir, x_inv, Fin.isValue,
              map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
            calc
              (algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) *
                  IsLocalization.Away.invSelf (S := Localization.Away (Polynomial.X : Polynomial V₀))
                    (Polynomial.X : Polynomial V₀)) *
                  algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) Polynomial.X -
                  algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a)
                  = algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) *
                      (x_dir * IsLocalization.Away.invSelf
                        (S := Localization.Away (Polynomial.X : Polynomial V₀))
                        (Polynomial.X : Polynomial V₀)) -
                      algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)) (Polynomial.C a) := by
                    dsimp only [x_dir]; ring
              _ = 0 := by rw [hX_inv, mul_one, sub_self]
        let α_nod : A_nod →+* Localization.Away (Polynomial.X : Polynomial V₀) :=
          Ideal.Quotient.lift I_V0 α_raw (fun p hp => RingHom.mem_ker.mp (hα_IV0_le hp))
        have hα_xi_unit : IsUnit (α_nod x_i) := by
          have h_eq : α_nod x_i = x_dir := by
            change α_raw (MvPolynomial.X i) = _
            simp [α_raw]
          rw [h_eq]
          exact IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial V₀)
        let α_loc : Localization.Away x_i →+* Localization.Away (Polynomial.X : Polynomial V₀) :=
          IsLocalization.Away.lift x_i hα_xi_unit
        let β_poly : Polynomial V₀ →+* Localization.Away x_i :=
          Polynomial.eval₂RingHom
            ((algebraMap A_nod (Localization.Away x_i)).comp ((Ideal.Quotient.mk I_V0).comp MvPolynomial.C))
            (algebraMap A_nod (Localization.Away x_i) x_i)
        have hβ_X_unit : IsUnit (β_poly Polynomial.X) := by
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          exact hLnod_unit
        let β_loc : Localization.Away (Polynomial.X : Polynomial V₀) →+* Localization.Away x_i :=
          IsLocalization.Away.lift (Polynomial.X : Polynomial V₀) hβ_X_unit
        have hαβ : α_loc.comp β_loc = RingHom.id (Localization.Away (Polynomial.X : Polynomial V₀)) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial V₀))
          apply Polynomial.ringHom_ext'
          · ext v
            simp only [RingHom.comp_apply, RingHom.id_apply]
            rw [IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit,
              Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
            dsimp only [RingHom.comp_apply]
            rw [IsLocalization.Away.lift_eq (x := x_i) hα_xi_unit]
            exact MvPolynomial.eval₂Hom_C _ _ v
          · simp only [RingHom.comp_apply, RingHom.id_apply]
            rw [IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit,
              Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
              IsLocalization.Away.lift_eq (x := x_i) hα_xi_unit]
            change α_raw (MvPolynomial.X i) = _
            simp [α_raw, x_dir]
        have hβα : β_loc.comp α_loc = RingHom.id (Localization.Away x_i) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers x_i)
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext
          · intro v
            simp only [RingHom.comp_apply, RingHom.id_apply]
            change β_loc (α_loc (algebraMap A_nod (Localization.Away x_i)
              (Ideal.Quotient.mk I_V0 (MvPolynomial.C v)))) = _
            rw [IsLocalization.Away.lift_eq (x := x_i) hα_xi_unit]
            dsimp only [α_nod]
            rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
              IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit,
              Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
            rfl
          · intro j
            simp only [RingHom.comp_apply, RingHom.id_apply]
            change β_loc (α_loc (algebraMap A_nod (Localization.Away x_i)
              (Ideal.Quotient.mk I_V0 (MvPolynomial.X j)))) = _
            rw [IsLocalization.Away.lift_eq (x := x_i) hα_xi_unit]
            by_cases hij : j = i
            · rw [hij]
              have h_xi : α_nod x_i = x_dir := by
                change α_raw (MvPolynomial.X i) = _
                simp [α_raw]
              change β_loc (α_nod x_i) = algebraMap A_nod (Localization.Away x_i) x_i
              rw [h_xi]
              dsimp only [x_dir]
              rw [IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit,
                Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
            · have h_raw : α_nod (Ideal.Quotient.mk I_V0 (MvPolynomial.X j)) = x_inv := by
                change α_raw (MvPolynomial.X j) = _
                simp [α_raw, hij]
              rw [h_raw]
              dsimp only [x_inv]
              rw [map_mul, IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit]
              have h_ca : β_poly (Polynomial.C a) =
                  algebraMap A_nod (Localization.Away x_i) (Ideal.Quotient.mk I_V0 (MvPolynomial.C a)) :=
                Polynomial.eval₂_C _ _
              rw [h_ca]
              apply hLnod_unit.mul_right_cancel
              have h_inv_mul : β_loc (IsLocalization.Away.invSelf
                  (S := Localization.Away (Polynomial.X : Polynomial V₀))
                  (Polynomial.X : Polynomial V₀)) *
                  algebraMap A_nod (Localization.Away x_i) x_i = 1 := by
                have h1 : algebraMap A_nod (Localization.Away x_i) x_i =
                    β_loc (algebraMap (Polynomial V₀)
                      (Localization.Away (Polynomial.X : Polynomial V₀)) Polynomial.X) := by
                  rw [IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit]
                  exact (Polynomial.eval₂_X _ _).symm
                rw [h1, ← map_mul, mul_comm,
                  IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial V₀), map_one]
              calc
                algebraMap A_nod (Localization.Away x_i) (Ideal.Quotient.mk I_V0 (MvPolynomial.C a)) *
                    β_loc (IsLocalization.Away.invSelf
                      (S := Localization.Away (Polynomial.X : Polynomial V₀))
                      (Polynomial.X : Polynomial V₀)) *
                    algebraMap A_nod (Localization.Away x_i) x_i
                    = algebraMap A_nod (Localization.Away x_i) (Ideal.Quotient.mk I_V0 (MvPolynomial.C a)) *
                        (β_loc (IsLocalization.Away.invSelf
                          (S := Localization.Away (Polynomial.X : Polynomial V₀))
                          (Polynomial.X : Polynomial V₀)) *
                          algebraMap A_nod (Localization.Away x_i) x_i) := mul_assoc _ _ _
                _ = algebraMap A_nod (Localization.Away x_i) (Ideal.Quotient.mk I_V0 (MvPolynomial.C a)) := by
                      rw [h_inv_mul, mul_one]
                _ = algebraMap A_nod (Localization.Away x_i) (Ideal.Quotient.mk I_V0 (MvPolynomial.X j)) *
                      algebraMap A_nod (Localization.Away x_i) x_i := by
                      rw [← map_mul, ← hX0X1_eq]
                      fin_cases i <;> fin_cases j <;> first | contradiction | simp [x_i, mul_comm]
        let e_loc : Localization.Away (Polynomial.X : Polynomial V₀) ≃+* Localization.Away x_i :=
          { toFun := β_loc
            invFun := α_loc
            left_inv := RingHom.congr_fun hαβ
            right_inv := RingHom.congr_fun hβα
            map_mul' := map_mul β_loc
            map_add' := map_add β_loc }
        let ψ_V : Polynomial V₀ →+* B :=
          Polynomial.eval₂RingHom (γ_R.comp ι_VR) (φ_0 x_i)
        have hψV_eq : ψ_V = (φ_loc.comp e_loc.toRingHom).comp
            (algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀))) := by
          apply Polynomial.ringHom_ext'
          · ext v
            simp only [ψ_V, e_loc, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.coe_mk,
              Equiv.coe_fn_mk, RingHom.comp_apply]
            rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
              IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit,
              Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
            dsimp only [RingHom.comp_apply]
            rw [IsLocalization.Away.lift_eq (x := x_i) hi_unit]
            exact (RingHom.congr_fun hφ0_comp v).symm
          · simp only [ψ_V, e_loc, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.coe_mk,
              Equiv.coe_fn_mk, RingHom.comp_apply]
            rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
              IsLocalization.Away.lift_eq (x := (Polynomial.X : Polynomial V₀)) hβ_X_unit,
              Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
              IsLocalization.Away.lift_eq (x := x_i) hi_unit]
        change ψ_V.Etale
        rw [hψV_eq]
        have h_loc_poly_et : (φ_loc.comp e_loc.toRingHom).Etale :=
          RingHom.Etale.respectsIso.right φ_loc e_loc hφ_loc_et
        let _ : Algebra (Localization.Away (Polynomial.X : Polynomial V₀)) B :=
          (φ_loc.comp e_loc.toRingHom).toAlgebra
        let _ : Algebra (Polynomial V₀) B :=
          ((φ_loc.comp e_loc.toRingHom).comp
            (algebraMap (Polynomial V₀) (Localization.Away (Polynomial.X : Polynomial V₀)))).toAlgebra
        have _ : IsScalarTower (Polynomial V₀)
            (Localization.Away (Polynomial.X : Polynomial V₀)) B :=
          IsScalarTower.of_algebraMap_eq' rfl
        have _ : Algebra.Etale (Polynomial V₀)
            (Localization.Away (Polynomial.X : Polynomial V₀)) :=
          Algebra.Etale.of_isLocalizationAway (Polynomial.X : Polynomial V₀)
        have _ : Algebra.Etale (Localization.Away (Polynomial.X : Polynomial V₀)) B :=
          RingHom.etale_algebraMap.mp h_loc_poly_et
        have _ : Algebra.Etale (Polynomial V₀) B :=
          Algebra.Etale.comp (Polynomial V₀)
            (Localization.Away (Polynomial.X : Polynomial V₀)) B
        exact RingHom.etale_algebraMap.mpr inferInstance
  
  have step_s5 : ∀ (W : ValuationSubring K) (κ : Type u) [Field κ]
      (q_W : ↥W →+* κ),
      Function.Surjective q_W →
      RingHom.ker q_W = IsLocalRing.maximalIdeal ↥W →
      ∀ (B : Type u) [CommRing B]
        (ψ : Polynomial ↥W →+* B),
        ψ.Etale →
        ∀ (ev : B →+* κ),
          ev.comp (ψ.comp Polynomial.C) = q_W →
          ∃ (α : B →+* ↥W),
            α.comp (ψ.comp Polynomial.C) = RingHom.id ↥W ∧
            q_W.comp α = ev := by
    intro W κ _ q_W hq_surj hq_ker B _ ψ hψ_etale ev hev
    obtain ⟨c_T, hc_T⟩ := hq_surj (ev (ψ Polynomial.X))
    let I_slice : Ideal B := Ideal.span {ψ (Polynomial.X - Polynomial.C c_T)}
    let A_fib : Type u := B ⧸ I_slice
    let ι_BA : B →+* A_fib := Ideal.Quotient.mk I_slice
    let ψ_W : ↥W →+* A_fib := ι_BA.comp (ψ.comp Polynomial.C)
    have hψW_etale : ψ_W.Etale := by
      let ev_PW : Polynomial ↥W →+* ↥W := Polynomial.evalRingHom c_T
      have hev_PW_C : ∀ w : ↥W, ev_PW (Polynomial.C w) = w := fun _ => Polynomial.eval_C
      let _ : Algebra (Polynomial ↥W) ↥W := ev_PW.toAlgebra
      let _ : Algebra (Polynomial ↥W) B := ψ.toAlgebra
      have _ : Algebra.Etale (Polynomial ↥W) B := RingHom.etale_algebraMap.mp hψ_etale
      let T_slice : Type u := TensorProduct (Polynomial ↥W) ↥W B
      have _ : Algebra.Etale ↥W T_slice := inferInstance
      have h_ev_psi : ∀ P : Polynomial ↥W, ψ_W (ev_PW P) = ι_BA (ψ P) := by
        intro P
        have hdvd : Polynomial.X - Polynomial.C c_T ∣ P - Polynomial.C (Polynomial.eval c_T P) :=
          Polynomial.X_sub_C_dvd_sub_C_eval
        rcases hdvd with ⟨Q, hQ⟩
        have hP_eq : P = (Polynomial.X - Polynomial.C c_T) * Q + Polynomial.C (ev_PW P) :=
          eq_add_of_sub_eq hQ
        conv_rhs => rw [hP_eq]
        rw [map_add, map_mul, map_add, map_mul]
        have h_zero : ι_BA (ψ (Polynomial.X - Polynomial.C c_T)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [h_zero, zero_mul, zero_add]
        rfl
      let f_alg : ↥W →ₐ[Polynomial ↥W] A_fib :=
        { toRingHom := ψ_W
          commutes' := h_ev_psi }
      let g_alg : B →ₐ[Polynomial ↥W] A_fib :=
        { toRingHom := ι_BA
          commutes' := fun _ => rfl }
      let F_hom : T_slice →+* A_fib :=
        (@Algebra.TensorProduct.lift (Polynomial ↥W) (Polynomial ↥W) ↥W B A_fib
          _ _ (Algebra.id _) _ _ _ (IsScalarTower.left _) _ _ _ _ _ (IsScalarTower.left _)
          f_alg g_alg (fun _ _ => mul_comm _ _)).toRingHom
      let ι_right : B →+* T_slice := Algebra.TensorProduct.includeRight.toRingHom
      have hI_ker : I_slice ≤ RingHom.ker ι_right := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        change (1 : ↥W) ⊗ₜ[Polynomial ↥W] ψ (Polynomial.X - Polynomial.C c_T) = 0
        have hsmul : ψ (Polynomial.X - Polynomial.C c_T) =
            (Polynomial.X - Polynomial.C c_T) • (1 : B) := by
          change ψ _ = ψ _ * 1
          rw [mul_one]
        rw [hsmul, ← TensorProduct.smul_tmul]
        change (ev_PW (Polynomial.X - Polynomial.C c_T) * 1) ⊗ₜ[Polynomial ↥W] (1 : B) = 0
        have hev0 : ev_PW (Polynomial.X - Polynomial.C c_T) = 0 := by
          simp [ev_PW, Polynomial.evalRingHom]
        rw [hev0, zero_mul, TensorProduct.zero_tmul]
      let G_hom : A_fib →+* T_slice := Ideal.Quotient.lift I_slice ι_right (fun b hb => hI_ker hb)
      have hFG : ∀ q : A_fib, F_hom (G_hom q) = q := by
        intro q
        induction q using Quotient.inductionOn' with
        | h b =>
          change ψ_W 1 * ι_BA b = ι_BA b
          rw [map_one, one_mul]
      have hGF : ∀ t : T_slice, G_hom (F_hom t) = t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul w b =>
          have h_eval : F_hom (w ⊗ₜ[Polynomial ↥W] b) = ι_BA (ψ (Polynomial.C w) * b) := by
            change ι_BA (ψ (Polynomial.C w)) * ι_BA b = _
            rw [← map_mul]
          rw [h_eval]
          change (1 : ↥W) ⊗ₜ[Polynomial ↥W] (ψ (Polynomial.C w) * b) = w ⊗ₜ[Polynomial ↥W] b
          change (1 : ↥W) ⊗ₜ[Polynomial ↥W] (Polynomial.C w • b) = _
          rw [← TensorProduct.smul_tmul]
          change (ev_PW (Polynomial.C w) * 1) ⊗ₜ[Polynomial ↥W] b = _
          rw [hev_PW_C w, mul_one]
        | add t₁ t₂ ih₁ ih₂ =>
          rw [map_add, map_add, ih₁, ih₂]
      let e_T : T_slice ≃+* A_fib :=
        { toFun := F_hom
          invFun := G_hom
          left_inv := hGF
          right_inv := hFG
          map_mul' := map_mul F_hom
          map_add' := map_add F_hom }
      have h_comp_W : e_T.toRingHom.comp (algebraMap ↥W T_slice) = ψ_W := by
        ext w
        change ψ_W w * 1 = ψ_W w
        rw [mul_one]
      rw [← h_comp_W]
      exact RingHom.Etale.respectsIso.left (algebraMap ↥W T_slice) e_T
        (RingHom.etale_algebraMap.mpr inferInstance)
    let _ : Algebra ↥W A_fib := ψ_W.toAlgebra
    have _ : Algebra.Etale ↥W A_fib := RingHom.etale_algebraMap.mp hψW_etale
    have _ : Module.Flat ↥W A_fib := inferInstance
    have _ : Algebra.FiniteType ↥W A_fib := inferInstance
    have _ : Algebra.QuasiFinite ↥W A_fib := by
      refine ⟨fun P _ => ?_⟩
      have _ : Algebra.Etale P.ResidueField (P.Fiber A_fib) := by
        dsimp [Ideal.Fiber]
        infer_instance
      obtain ⟨I_P, _, Ai_P, _, _, e_P, hFinSep_P⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod P.ResidueField (P.Fiber A_fib)).mp inferInstance
      let _ : ∀ i : I_P, Module.Finite P.ResidueField (Ai_P i) := fun i => (hFinSep_P i).1
      have _ : Module.Finite P.ResidueField ((i : I_P) → Ai_P i) := Module.Finite.pi
      exact Module.Finite.equiv e_P.symm.toLinearEquiv
    have hev_Islice : I_slice ≤ RingHom.ker ev := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        map_sub, map_sub, ← hc_T]
      have hc : ev (ψ (Polynomial.C c_T)) = q_W c_T := RingHom.congr_fun hev c_T
      rw [hc, sub_self]
    let ēv : A_fib →+* κ := Ideal.Quotient.lift I_slice ev (fun b hb => hev_Islice hb)
    have hēv_left : ∀ w : ↥W, ēv (algebraMap ↥W A_fib w) = q_W w :=
      fun w => RingHom.congr_fun hev w
    have hēv_right : ∀ b : B, ēv (ι_BA b) = ev b := fun _ => rfl
    let 𝔪_fib : Ideal A_fib := RingHom.ker ēv
    have _ : 𝔪_fib.IsPrime := RingHom.ker_isPrime ēv
    have h_comap_𝔪 : Ideal.comap (algebraMap ↥W A_fib) 𝔪_fib = IsLocalRing.maximalIdeal ↥W := by
      rw [← hq_ker]
      ext w
      change ēv (algebraMap ↥W A_fib w) = 0 ↔ q_W w = 0
      rw [hēv_left w]
    have _ : Algebra.QuasiFiniteAt ↥W 𝔪_fib := inferInstance
    have hZMP : Algebra.ZariskisMainProperty ↥W 𝔪_fib :=
      Algebra.ZariskisMainProperty.of_finiteType 𝔪_fib
    obtain ⟨r, hr_not_𝔪, hr_int, h_int_mul⟩ := Algebra.zariskisMainProperty_iff.mp hZMP
    let E_K : Type u := TensorProduct ↥W K A_fib
    let ι_AK : A_fib →ₐ[↥W] E_K := Algebra.TensorProduct.includeRight
    have h_inj_WK : Function.Injective (Algebra.linearMap ↥W K) := Subtype.val_injective
    have h_inj_AK : Function.Injective ι_AK := by
      intro x y hxy
      have h_lin : LinearMap.rTensor A_fib (Algebra.linearMap ↥W K)
          ((TensorProduct.lid ↥W A_fib).symm x) =
          LinearMap.rTensor A_fib (Algebra.linearMap ↥W K)
          ((TensorProduct.lid ↥W A_fib).symm y) := by
        simp only [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, Algebra.linearMap_apply,
          map_one]
        exact hxy
      have h_inj_r := Module.Flat.rTensor_preserves_injective_linearMap
        (M := A_fib) (Algebra.linearMap ↥W K) h_inj_WK
      exact (TensorProduct.lid ↥W A_fib).symm.injective (h_inj_r h_lin)
    have _ : Algebra.Etale K E_K := inferInstance
    obtain ⟨I, _, Ai, _, _, e_prod, hFinSep_K⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K E_K).mp inferInstance
    let _ : ∀ i : I, Module.Finite K (Ai i) := fun i => (hFinSep_K i).1
    let _ : ∀ i : I, Algebra.IsSeparable K (Ai i) := fun i => (hFinSep_K i).2
    have h_bij_Ai : ∀ i : I, Function.Bijective (algebraMap K (Ai i)) := by
      intro i
      refine ⟨RingHom.injective _, fun y => ?_⟩
      have hy_int : IsIntegral K y := Algebra.IsIntegral.isIntegral y
      have hy_sep : (minpoly K y).Separable := Algebra.IsSeparable.isSeparable K y
      have hy_irr : Irreducible (minpoly K y) := minpoly.irreducible hy_int
      have h_deg1 : (minpoly K y).degree = 1 :=
        IsSepClosed.degree_eq_one_of_irreducible K hy_irr hy_sep
      have h_monic : (minpoly K y).Monic := minpoly.monic hy_int
      have h_aeval : Polynomial.aeval y (minpoly K y) = 0 := minpoly.aeval K y
      have h_form := Polynomial.eq_X_add_C_of_degree_eq_one h_deg1
      rw [h_monic.leadingCoeff, map_one, one_mul] at h_form
      rw [h_form, map_add, Polynomial.aeval_X, Polynomial.aeval_C] at h_aeval
      exact ⟨-(minpoly K y).coeff 0, by
        rw [map_neg]
        exact (eq_neg_of_add_eq_zero_left h_aeval).symm⟩
    let e_Ai : ∀ i : I, Ai i ≃ₐ[K] K := fun i =>
      (AlgEquiv.ofBijective (Algebra.ofId K (Ai i)) (h_bij_Ai i)).symm
    let e_pi : ((i : I) → Ai i) ≃ₐ[K] (I → K) :=
      { toFun := fun f i => e_Ai i (f i)
        invFun := fun g i => (e_Ai i).symm (g i)
        left_inv := fun f => funext fun i => (e_Ai i).symm_apply_apply (f i)
        right_inv := fun g => funext fun i => (e_Ai i).apply_symm_apply (g i)
        map_mul' := fun f₁ f₂ => funext fun i => map_mul (e_Ai i) (f₁ i) (f₂ i)
        map_add' := fun f₁ f₂ => funext fun i => map_add (e_Ai i) (f₁ i) (f₂ i)
        commutes' := fun c => funext fun i => (e_Ai i).commutes c }
    let e_split : E_K ≃ₐ[K] (I → K) := e_prod.trans e_pi
    let C : Subalgebra ↥W A_fib := integralClosure ↥W A_fib
    let Φ_K : ↥C →ₐ[↥W] (I → K) :=
      (e_split.toAlgHom.restrictScalars ↥W).comp (ι_AK.comp C.val)
    have hΦ_inj : Function.Injective Φ_K :=
      e_split.injective.comp (h_inj_AK.comp Subtype.val_injective)
    have hΦ_mem : ∀ (c : ↥C) (i : I), Φ_K c i ∈ W := by
      intro c i
      have hc_C : IsIntegral ↥W c := Algebra.IsIntegral.isIntegral c
      let proj_i : (I → K) →ₐ[↥W] K := (Pi.evalAlgHom K (fun _ : I => K) i).restrictScalars ↥W
      have h_int_K : IsIntegral ↥W (Φ_K c i) := IsIntegral.map (proj_i.comp Φ_K) hc_C
      obtain ⟨w, hw⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := K)).mp h_int_K
      rw [← hw]
