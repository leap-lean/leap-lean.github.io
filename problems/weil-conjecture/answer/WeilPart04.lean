        have : IsDomain (Localization.AtPrime p_x.asIdeal) :=
          IsLocalization.isDomain_localization hp_nzd
        let e_loc := (IsLocalization.algEquiv p_x.asIdeal.primeCompl
          (Localization.AtPrime p_x.asIdeal) ↑(P_F.presheaf.stalk x)).toRingEquiv
        exact ⟨MulEquiv.isDomain _ e_loc.symm.toMulEquiv,
          isIntegrallyClosed_of_isLocalization ↑(P_F.presheaf.stalk x)
