      have : ∀ x : ↥P_F, _root_.IsReduced ↑(P_F.presheaf.stalk x) := fun x =>
        let _ := (hStalk x).1; inferInstance
      have : AlgebraicGeometry.IsReduced P_F := AlgebraicGeometry.isReduced_of_isReduced_stalk P_F
      have hIntPF : AlgebraicGeometry.IsIntegral P_F :=
        AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P_F
      have hNormPF : IsAffineNormalScheme P_F := by
        intro U hU hUne
        have : IsDomain ↑Γ(P_F, U) := @AlgebraicGeometry.IsIntegral.component_integral P_F hIntPF U hUne
        refine ⟨inferInstance, ?_⟩
        refine IsIntegrallyClosed.of_isLocalization_maximal
          (fun (P : Ideal ↑Γ(P_F, U)) (_ : P.IsMaximal) => Localization.AtPrime P) ?_
