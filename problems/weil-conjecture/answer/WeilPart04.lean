      ∀ r : R_z, θ₀ (Ideal.Quotient.mk I_base r) =
        Ideal.Quotient.mk (Ideal.map ψ₀.hom I_sec) (ψ₀.hom (φ_Rz.hom r)) := by
    letI : Algebra ↑A_loc ↑B₀ := ψ₀.hom.toAlgebra
    have : Algebra.Etale ↑A_loc ↑B₀ := hEt_ψ₀.toAlgebra
    have : Algebra.Etale (↑A_loc ⧸ I_sec)
        (TensorProduct ↑A_loc (↑A_loc ⧸ I_sec) ↑B₀) :=
      Algebra.Etale.baseChange (↑A_loc) (↑B₀) (↑A_loc ⧸ I_sec)
    let f₁ : ↑A_loc ⧸ I_sec →+* TensorProduct ↑A_loc (↑A_loc ⧸ I_sec) ↑B₀ :=
      algebraMap (↑A_loc ⧸ I_sec) (TensorProduct ↑A_loc (↑A_loc ⧸ I_sec) ↑B₀)
    have hEt_f₁ : RingHom.Etale f₁ := RingHom.etale_algebraMap.mpr inferInstance
    let e_TB : TensorProduct ↑A_loc (↑A_loc ⧸ I_sec) ↑B₀ ≃+*
        ↑B₀ ⧸ Ideal.map (algebraMap ↑A_loc ↑B₀) I_sec :=
      (Algebra.TensorProduct.comm (↑A_loc) (↑A_loc ⧸ I_sec) (↑B₀)).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (↑B₀) I_sec).symm.toRingEquiv
    let f₂ : ↑A_loc ⧸ I_sec →+* ↑B₀ ⧸ Ideal.map ψ₀.hom I_sec :=
