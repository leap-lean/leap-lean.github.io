theorem weil_strictlySemistable_single_valuation_resolution (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (hBl : HasStrictlySemistablePointBlowups V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (U_K : C_K.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ U_ss)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (ι_X : U_K.toScheme ⟶ X)
    (W_target : ValuationSubring F_ss)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_ss = g_X)
    (hη_pX : η_X ≫ p_X = η_ss)
    (hPb_X : CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hDiv : IsDivisorialClosedVal V g_ss η_ss W_target) :
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_step : X' ⟶ X)
      (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X')
      (ι_X' : U_K.toScheme ⟶ X'),
      IsStrictlySemistableCurveOverValuation V g_X' ∧
      AlgebraicGeometry.IsProper f_step ∧
      f_step ≫ g_X = g_X' ∧
      η_X' ≫ f_step = η_X ∧
      ι_X' ≫ f_step = ι_X ∧
      CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      IsValResolvedOnMod V g_ss (f_step ≫ p_X) η_X' W_target ∧
      (∀ W : ValuationSubring F_ss,
        IsValResolvedOnMod V g_ss p_X η_X W →
        IsValResolvedOnMod V g_ss (f_step ≫ p_X) η_X' W) :=
by
  have h_s1 : ∀ (P_z : Ideal ↥V) [P_z.IsPrime], P_z ≠ ⊥ →
      ∀ (θ_V : ↥V →+* ↥W_target) (t_div : ↥W_target),
        Ideal.comap θ_V (IsLocalRing.maximalIdeal ↥W_target) = P_z →
        (∀ P : Polynomial ↥V,
          (∃ i : ℕ, P.coeff i ∉ P_z) →
          Polynomial.eval₂ θ_V t_div P ∉ IsLocalRing.maximalIdeal ↥W_target) →
        (∀ (a : ↥V) (u_W v_W : ↥W_target),
          a ≠ 0 →
          u_W * v_W = θ_V a →
          u_W ∈ IsLocalRing.maximalIdeal ↥W_target →
          v_W ∈ IsLocalRing.maximalIdeal ↥W_target →
          (∀ P : Polynomial ↥V, P ≠ 0 →
            Polynomial.eval₂ (W_target.subtype.comp θ_V) (W_target.subtype u_W) P ≠ 0) →
          (∃ Q : Polynomial (Polynomial ↥V), Q ≠ 0 ∧
            Polynomial.eval₂
              (Polynomial.eval₂RingHom (W_target.subtype.comp θ_V) (W_target.subtype u_W))
              (W_target.subtype t_div) Q = 0) →
          ∃ (π₁ a' : ↥V) (q : ↥W_target),
            π₁ ∈ P_z ∧ π₁ ≠ 0 ∧ a = π₁ * a' ∧ IsUnit q ∧ u_W = θ_V π₁ * q) ∧
        (∀ (T_W : ↥W_target),
          (∀ P : Polynomial ↥V, P ≠ 0 →
            Polynomial.eval₂ (W_target.subtype.comp θ_V) (W_target.subtype T_W) P ≠ 0) →
          (∃ Q : Polynomial (Polynomial ↥V), Q ≠ 0 ∧
            Polynomial.eval₂
              (Polynomial.eval₂RingHom (W_target.subtype.comp θ_V) (W_target.subtype T_W))
              (W_target.subtype t_div) Q = 0) →
          ¬ (∀ P : Polynomial ↥V,
            (∃ i : ℕ, P.coeff i ∉ P_z) →
            Polynomial.eval₂ θ_V T_W P ∉ IsLocalRing.maximalIdeal ↥W_target) →
          ∃ (s₁ c₁ π₁ : ↥V) (q : ↥W_target),
            s₁ ∉ P_z ∧ π₁ ∈ P_z ∧ π₁ ≠ 0 ∧
            θ_V s₁ * T_W - θ_V c₁ = θ_V π₁ * q ∧
            (∀ P : Polynomial ↥V,
              (∃ i : ℕ, P.coeff i ∉ P_z) →
              Polynomial.eval₂ θ_V q P ∉ IsLocalRing.maximalIdeal ↥W_target)) := by
    let s1_fracSubfield : ∀ {A F : Type u} [CommRing A] [IsDomain A] [Field F]
        (φ : A →+* F), Function.Injective φ → Subfield F :=
      fun {A F _ _ _} φ hφ =>
        { carrier := {z : F | ∃ a b : A, b ≠ 0 ∧ z * φ b = φ a}
          mul_mem' := by
            rintro x y ⟨a₁, b₁, hb₁, hx⟩ ⟨a₂, b₂, hb₂, hy⟩
            refine ⟨a₁ * a₂, b₁ * b₂, mul_ne_zero hb₁ hb₂, ?_⟩
            rw [map_mul, map_mul]
            calc (x * y) * (φ b₁ * φ b₂) = (x * φ b₁) * (y * φ b₂) := by ring
              _ = φ a₁ * φ a₂ := by rw [hx, hy]
          one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
          add_mem' := by
            rintro x y ⟨a₁, b₁, hb₁, hx⟩ ⟨a₂, b₂, hb₂, hy⟩
            refine ⟨a₁ * b₂ + a₂ * b₁, b₁ * b₂, mul_ne_zero hb₁ hb₂, ?_⟩
            rw [map_add, map_mul, map_mul, map_mul]
            calc (x + y) * (φ b₁ * φ b₂) = (x * φ b₁) * φ b₂ + (y * φ b₂) * φ b₁ := by ring
              _ = φ a₁ * φ b₂ + φ a₂ * φ b₁ := by rw [hx, hy]
          zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
          neg_mem' := by
            rintro x ⟨a, b, hb, hx⟩
            exact ⟨-a, b, hb, by rw [map_neg, neg_mul, hx]⟩
          inv_mem' := by
            rintro z ⟨a, b, hb, hz⟩
            by_cases ha : a = 0
            · have hφb : φ b ≠ 0 := fun h0 => hb (hφ (by simpa using h0))
              have hz0 : z = 0 := (mul_eq_zero.mp (by rw [hz, ha, map_zero])).resolve_right hφb
              subst hz0
              exact ⟨0, 1, one_ne_zero, by simp⟩
            · have hφa : φ a ≠ 0 := fun h0 => ha (hφ (by simpa using h0))
              have hz0 : z ≠ 0 := fun h0 => hφa (by rw [← hz, h0, zero_mul])
              refine ⟨b, a, ha, ?_⟩
              apply mul_left_cancel₀ hz0
              calc z * (z⁻¹ * φ a) = (z * z⁻¹) * φ a := by ring
                _ = φ a := by rw [mul_inv_cancel₀ hz0, one_mul]
                _ = z * φ b := hz.symm }
    have s1_clear_poly_denoms : ∀ {A F : Type u} [CommRing A] [IsDomain A] [Field F]
        (φ : A →+* F) (hφ : Function.Injective φ) (z : F),
        IsAlgebraic ↥(s1_fracSubfield φ hφ) z →
        ∃ P : Polynomial A, P ≠ 0 ∧ Polynomial.eval₂ φ z P = 0 := by
      intro A F _ _ _ φ hφ z ⟨R, hR_ne, hR_eval⟩
      classical
      have hPair : ∀ i : ℕ, ∃ p : A × A, p.2 ≠ 0 ∧
          (if i ∈ R.support then p.1 ≠ 0 else p.1 = 0) ∧
          (R.coeff i : F) * φ p.2 = φ p.1 := by
        intro i
        by_cases hi : i ∈ R.support
        · have hci : R.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hi
          obtain ⟨a, b, hb, hab⟩ := (R.coeff i).2
          have ha : a ≠ 0 := by
            intro ha0
            rw [ha0, map_zero] at hab
            have hφb : φ b ≠ 0 := fun h0 => hb (hφ (by simpa using h0))
            have hc0 : (R.coeff i : F) = 0 := (mul_eq_zero.mp hab).resolve_right hφb
            exact hci (Subtype.ext hc0)
          exact ⟨(a, b), hb, by simp [hi, ha], hab⟩
        · have hci : R.coeff i = 0 := Polynomial.notMem_support_iff.mp hi
          refine ⟨(0, 1), one_ne_zero, by simp [hi], ?_⟩
          rw [hci]
          simp
      choose p hp_ne hp_a hp_eq using hPair
      let c : ℕ → A := fun i => ∏ j ∈ R.support.erase i, (p j).2
      let S : A := ∏ j ∈ R.support, (p j).2
      let P : Polynomial A := ∑ i ∈ R.support, Polynomial.monomial i ((p i).1 * c i)
      refine ⟨P, ?_, ?_⟩
      · obtain ⟨i₀, hi₀⟩ := Polynomial.support_nonempty.mpr hR_ne
        intro hP0
        have hcoeff : P.coeff i₀ = 0 := by rw [hP0, Polynomial.coeff_zero]
        rw [Polynomial.finsetSum_coeff] at hcoeff
        have hsum_eq : (∑ x ∈ R.support, (Polynomial.monomial x ((p x).1 * c x)).coeff i₀) =
            (p i₀).1 * c i₀ := by
          rw [Finset.sum_eq_single i₀]
          · simp
          · intro b _ hbi₀
            rw [Polynomial.coeff_monomial_of_ne _ hbi₀.symm]
          · intro hi₀_not
            exact absurd hi₀ hi₀_not
        rw [hsum_eq] at hcoeff
        have ha_ne : (p i₀).1 ≠ 0 := by simpa [hi₀] using hp_a i₀
        have hc_ne : c i₀ ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hp_ne j)
        exact mul_ne_zero ha_ne hc_ne hcoeff
      · rw [Polynomial.eval₂_finsetSum]
        have hterm : ∀ i ∈ R.support,
            Polynomial.eval₂ φ z (Polynomial.monomial i ((p i).1 * c i)) =
              φ S * ((R.coeff i : F) * z ^ i) := by
          intro i hi
          rw [Polynomial.eval₂_monomial, map_mul]
          have hS_eq : (p i).2 * c i = S := Finset.mul_prod_erase R.support (fun j => (p j).2) hi
          calc (φ (p i).1 * φ (c i)) * z ^ i
              = (((R.coeff i : F) * φ (p i).2) * φ (c i)) * z ^ i := by rw [hp_eq i]
            _ = (φ (p i).2 * φ (c i)) * ((R.coeff i : F) * z ^ i) := by ring
            _ = φ S * ((R.coeff i : F) * z ^ i) := by rw [← map_mul, hS_eq]
        rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
        have haeval : (∑ i ∈ R.support, (R.coeff i : F) * z ^ i) = Polynomial.aeval z R := by
          rw [Polynomial.aeval_def, Polynomial.eval₂_def, Polynomial.sum_def]
          rfl
        rw [haeval, hR_eval, mul_zero]
    have s1_sepClosed_monic_irred_form : ∀ (p : ℕ) [CharP K p]
        (f : Polynomial K), f.Monic → Irreducible f →
        (∃ c : K, f = Polynomial.X - Polynomial.C c) ∨
          (p.Prime ∧ ∃ (e : ℕ) (β : K), 1 ≤ e ∧ f = Polynomial.X ^ (p ^ e) - Polynomial.C β) := by
      intro p _ f hf_monic hf_irred
      suffices hInd : ∀ n : ℕ, ∀ g : Polynomial K, g.natDegree = n → g.Monic → Irreducible g →
          (∃ c : K, g = Polynomial.X - Polynomial.C c) ∨
            (p.Prime ∧ ∃ (e : ℕ) (β : K), 1 ≤ e ∧ g = Polynomial.X ^ (p ^ e) - Polynomial.C β) from
        hInd f.natDegree f rfl hf_monic hf_irred
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro g hdeg hg_monic hg_irred
        rcases Polynomial.separable_or p hg_irred with hsep | ⟨_, g₁, hg₁_irred, hg₁_exp⟩
        · left
          have hsp : g.Splits := IsSepClosed.splits_of_separable g hsep
          obtain ⟨m_ms, hm_eq⟩ := Polynomial.splits_iff_exists_multiset.mp hsp
          rw [hg_monic.leadingCoeff, map_one, one_mul] at hm_eq
          rcases Multiset.empty_or_exists_mem m_ms with rfl | ⟨c, hc_mem⟩
          · exfalso
            rw [Multiset.map_zero, Multiset.prod_zero] at hm_eq
            exact hg_irred.not_isUnit (hm_eq ▸ isUnit_one)
          · obtain ⟨m', rfl⟩ := Multiset.exists_cons_of_mem hc_mem
            rw [Multiset.map_cons, Multiset.prod_cons] at hm_eq
