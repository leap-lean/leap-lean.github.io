              · exact ⟨m_P, rfl⟩
            by_cases hDisj₁ : Disjoint (Set.range (τ_X₁ i_cur).base) (Set.range (τ_X₁ j_cur).base)
            · refine ⟨X₁, g_X₁, f_bl₁ ≫ f_X, τ_X₁, ι_X₁, hSS₁, hProp_fX₁, hfX₁_g0, hιX₁_f0,
                hPb_X₁, hτ_X₁, hClPt_X₁, hColl_X₁,
                (fun i₁ i₂ hi₁ hne => h_disj_pres₁ i₁ i₂ (hDisj_I i₁ i₂ hi₁ hne)), ?_⟩
              intro j hj hne
              rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
              · exact h_disj_pres₁ i_cur j (hDisj_J j hlt hne)
              · have hj_eq : j = j_cur := Fin.ext heq
                subst hj_eq
                exact hDisj₁
            · obtain ⟨hP_ne, α_j, hα_j, h_mP_eq₁, hψ_ne₁⟩ :=
                (hColl_X₁ i_cur j_cur hne_ij hDisj₁).2 P α_i m_P hmP hα_i
              obtain ⟨X₂, g_X₂, f_bl₂, U_iso₂, hSS₂, hProp_bl₂, hf₂_comm,
                  hIso₂, hGen₂, hSep₂⟩ :=
                hS4 X₁ g_X₁ hSS₁ W_sm₁ e_sm₁ hEt_sm₁ he_sm₁_comm P hP_ne
                  (α_i.hom ≫ τ_X₁ i_cur) (α_j.hom ≫ τ_X₁ j_cur) m_P hmP
                  (by rw [CategoryTheory.Category.assoc, (hτ_X₁ i_cur).2.1, hα_i])
                  (by rw [CategoryTheory.Category.assoc, (hτ_X₁ j_cur).2.1, hα_j])
                  (hClPt_X₁ i_cur P α_i m_P hmP) hmP_W₁ h_mP_eq₁ hψ_ne₁
              obtain ⟨ι_X₂, τ_X₂, hProp_fX₂, hfX₂_g0, hιX₂_f0, hPb_X₂,
                  hτ_X₂, hClPt_X₂, hColl_X₂, h_step₂, h_disj_pres₂⟩ :=
                hStepLift X₁ X₂ g_X₁ g_X₂ (f_bl₁ ≫ f_X) f_bl₂ ι_X₁ U_iso₂ τ_X₁
                  hProp_fX₁ hProp_bl₂ hfX₁_g0 hf₂_comm hιX₁_f0 hPb_X₁ hIso₂ hGen₂
                  (fun k => (hτ_X₁ k).2.2.2)
              have hDisj_ij₂ : Disjoint (Set.range (τ_X₂ i_cur).base)
                  (Set.range (τ_X₂ j_cur).base) := by
                have hDisj_ψ := hSep₂ (α_i.hom ≫ τ_X₂ i_cur) (α_j.hom ≫ τ_X₂ j_cur)
                  (by rw [CategoryTheory.Category.assoc, h_step₂ i_cur])
                  (by rw [CategoryTheory.Category.assoc, h_step₂ j_cur])
                rw [Set.disjoint_left]
                rintro _ ⟨b₁, rfl⟩ ⟨b₂, hb_eq⟩
                apply Set.disjoint_left.mp hDisj_ψ ⟨α_i.inv.base b₁, by
                  change (α_i.inv ≫ α_i.hom ≫ τ_X₂ i_cur).base b₁ = _
                  rw [CategoryTheory.Iso.inv_hom_id_assoc]⟩
                refine ⟨α_j.inv.base b₂, ?_⟩
                change (α_j.inv ≫ α_j.hom ≫ τ_X₂ j_cur).base b₂ = _
                rw [CategoryTheory.Iso.inv_hom_id_assoc]
                exact hb_eq
              refine ⟨X₂, g_X₂, f_bl₂ ≫ f_bl₁ ≫ f_X, τ_X₂, ι_X₂, hSS₂, hProp_fX₂, hfX₂_g0,
                hιX₂_f0, hPb_X₂, hτ_X₂, hClPt_X₂, hColl_X₂,
                (fun i₁ i₂ hi₁ hne =>
                  h_disj_pres₂ i₁ i₂ (h_disj_pres₁ i₁ i₂ (hDisj_I i₁ i₂ hi₁ hne))), ?_⟩
              intro j hj hne
              rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
              · exact h_disj_pres₂ i_cur j (h_disj_pres₁ i_cur j (hDisj_J j hlt hne))
              · have hj_eq : j = j_cur := Fin.ext heq
                subst hj_eq
                exact hDisj_ij₂
      obtain ⟨X_end, g_end, f_end, τ_end, ι_end, hSS_end, hProp_end, hf_end, hι_end,
          hPb_end, hτ_end, hClPt_end, hColl_end, hDisj_I_end, hDisj_J_end⟩ :=
        hInner n (le_refl n)
      refine ⟨X_end, g_end, f_end, τ_end, ι_end, hSS_end, hProp_end, hf_end, hι_end,
        hPb_end, hτ_end, hClPt_end, hColl_end, ?_⟩
      intro i₁ i₂ hi₁ hne
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi₁ with hlt | heq
      · exact hDisj_I_end i₁ i₂ hlt hne
      · have hi₁_eq : i₁ = i_cur := Fin.ext heq
        subst hi₁_eq
        exact hDisj_J_end i₂ i₂.isLt hne
  obtain ⟨C''_1, g''_1, f_1, τ_1, ι_1, hSS_1, hProp_1, hf_1, hι_1, hPb_1,
      hτ_1, hClPt_1, _, hDisj_all_1⟩ :=
    hLoop1 n (le_refl n)
  have hPairwise_1 : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_1 i).base) (Set.range (τ_1 j).base) :=
    fun i j hne => hDisj_all_1 i j i.isLt hne
  have hLoop2 : ∀ J : ℕ, J ≤ n →
      ∃ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_X : X ⟶ C''_0)
        (τ_X : ∀ j : Fin n, (S_open j).toScheme ⟶ X)
        (ι_X : U_K.toScheme ⟶ X),
        IsStrictlySemistableCurveOverValuation V g_X ∧
        AlgebraicGeometry.IsProper f_X ∧
        f_X ≫ g''_0 = g_X ∧
        ι_X ≫ f_X = ι_0 ∧
        CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X η_V ∧
        (∀ j : Fin n,
          (τ_X j ≫ (f_X ≫ f_0)) ≫ U'.ι = (S_open j).ι ≫ τ' j ∧
          τ_X j ≫ g_X = (S_open j).ι ∧
          AlgebraicGeometry.IsClosedImmersion (τ_X j) ∧
          (∀ τ_alt : (S_open j).toScheme ⟶ X,
            (τ_alt ≫ (f_X ≫ f_0)) ≫ U'.ι = (S_open j).ι ≫ τ' j → τ_alt = τ_X j)) ∧
        (∀ (j : Fin n) (P : Ideal ↥V) [P.IsPrime]
            (α : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) ≅ (S_open j).toScheme)
            (m_P : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P))),
          m_P.asIdeal = IsLocalRing.maximalIdeal ↥(V.ofPrime P) →
          IsClosed ({(α.hom ≫ τ_X j).base m_P} : Set X)) ∧
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ_X i).base) (Set.range (τ_X j).base)) ∧
        (∀ (j : Fin n), j.1 < J →
          ∀ (b : ↥(S_open j).toScheme),
            ∃ V_sm : X.Opens,
              (τ_X j).base b ∈ V_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X)) := by
    intro J
    induction J with
    | zero =>
      intro _
      refine ⟨C''_1, g''_1, f_1, τ_1, ι_1, hSS_1, hProp_1, hf_1, hι_1, hPb_1,
        hτ_1, hClPt_1, hPairwise_1, ?_⟩
      intro j hj; omega
    | succ J ihJ =>
      intro hJ_succ
      obtain ⟨X, g_X, f_X, τ_X, ι_X, hSS_X, hProp_X, hf_X, hι_X, hPb_X,
          hτ_X, hClPt_X, hPair_X, hSm_prev⟩ :=
        ihJ (Nat.le_of_succ_le hJ_succ)
      let j_cur : Fin n := ⟨J, hJ_succ⟩
      by_cases hEmp : IsEmpty ↥(S_open j_cur).toScheme
      · refine ⟨X, g_X, f_X, τ_X, ι_X, hSS_X, hProp_X, hf_X, hι_X, hPb_X,
          hτ_X, hClPt_X, hPair_X, ?_⟩
        intro j hj b
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
        · exact hSm_prev j hlt b
        · have hj_eq : j = j_cur := Fin.ext heq
          subst hj_eq
          exact IsEmpty.elim hEmp b
      · have hNe : Nonempty ↥(S_open j_cur).toScheme := not_isEmpty_iff.mp hEmp
        obtain ⟨P, instP, α, m_P, hmP, hα⟩ := hChart j_cur hNe
        obtain ⟨X', g_X', f_bl, U_iso, W_sm', e_sm', hSS', hProp_bl, hf_comm,
            hIso, hGen, hSm_in_iso, _, _, hSm_W', hRange_W'⟩ :=
          hS3 X g_X hSS_X P (α.hom ≫ τ_X j_cur) m_P hmP
            (by rw [CategoryTheory.Category.assoc, (hτ_X j_cur).2.1, hα])
            (hClPt_X j_cur P α m_P hmP)
        obtain ⟨ι_X', τ_X', hProp_fX', hfX'_g0, hιX'_f0, hPb_X',
            hτ_X', hClPt_X', _, h_step, h_disj_pres⟩ :=
          hStepLift X X' g_X g_X' f_X f_bl ι_X U_iso τ_X
            hProp_X hProp_bl hf_X hf_comm hι_X hPb_X hIso hGen
            (fun k => (hτ_X k).2.2.2)
        refine ⟨X', g_X', f_bl ≫ f_X, τ_X', ι_X', hSS', hProp_fX', hfX'_g0, hιX'_f0, hPb_X',
          hτ_X', hClPt_X', (fun i₁ i₂ hne => h_disj_pres i₁ i₂ (hPair_X hne)), ?_⟩
        intro j hj b
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
        · obtain ⟨V_sm, hb_Vsm, hSm_Vsm⟩ := hSm_prev j hlt b
          have hfb_eq : f_bl.base ((τ_X' j).base b) = (τ_X j).base b := by
            change (τ_X' j ≫ f_bl).base b = _
            rw [h_step j]
          have hfb_Vsm : f_bl.base ((τ_X' j).base b) ∈ V_sm := hfb_eq ▸ hb_Vsm
          have hfb_Uiso : f_bl.base ((τ_X' j).base b) ∈ U_iso :=
            hSm_in_iso _ V_sm hfb_Vsm hSm_Vsm
          exact (hS2 X X' g_X g_X' f_bl U_iso hf_comm hIso).2 ((τ_X' j).base b) V_sm
            hfb_Vsm hfb_Uiso hSm_Vsm
        · have hj_eq : j = j_cur := Fin.ext heq
          subst hj_eq
          refine ⟨W_sm', ?_, hSm_W'⟩
          apply hRange_W' (α.hom ≫ τ_X' j_cur)
          · rw [CategoryTheory.Category.assoc, h_step j_cur]
          · refine ⟨α.inv.base b, ?_⟩
            change (α.inv ≫ α.hom ≫ τ_X' j_cur).base b = _
            rw [CategoryTheory.Iso.inv_hom_id_assoc]
  obtain ⟨C'', g'', f_pt, τ'', ι_C'', hSS_C'', hProp_fpt, hfpt_g0, hιC''_fpt, hPb_C'',
      hτ'', _, hPair_C'', hSm_all⟩ :=
    hLoop2 n (le_refl n)
  refine ⟨C'', g'', f_pt, τ'', ι_C'', hSS_C'', hProp_fpt, hfpt_g0, hιC''_fpt, hPb_C'',
    (fun j => (hτ'' j).1), hPair_C'', (fun j b => hSm_all j j.isLt b)⟩

theorem weil_strictlySemistable_blowup_pointed_domination (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hι_comm : ι_U' ≫ U'.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ ι')
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype))) :
    ∃ (C'' : AlgebraicGeometry.Scheme.{u})
      (g'' : C'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_dom : C'' ⟶ U'.toScheme)
      (τ'' : ∀ j : Fin n,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C'')
      (ι_C'' : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C''),
      IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
        C'' g'' f_dom τ'' ι_C'' :=
by
  obtain ⟨hOpenη, hNorm, hFuncEx⟩ :=
    weil_strictlySemistable_isAffineNormal_and_funcField K m V hPkg
  obtain ⟨F_ss, instFieldFss, η_ss, hFunc_ss⟩ := hFuncEx U_ss g_ss hSS
  letI : Field F_ss := instFieldFss
  have hBl : HasStrictlySemistablePointBlowups V :=
    weil_strictlySemistable_elementary_point_blowups K m V hPkg
  obtain ⟨r_val, W_list, hW_div, hDomCrit⟩ :=
    weil_strictlySemistable_gammaZero_domination_criterion K m V hPkg C_K p_K n σ_K
      hIntCK hSmCK hStabCK C' g' τ' ι' hMod' U' hU' U_ss g_ss hAff_ss hSS
      h_mod hProp_mod hComm_mod ι_U' hPb_U' hPb_ss hOpenη F_ss η_ss hFunc_ss
  let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
  have hResolveLoop : ∀ k : ℕ, k ≤ r_val →
      ∃ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (p_X : X ⟶ U_ss)
        (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
        (ι_X : U_K.toScheme ⟶ X),
        IsStrictlySemistableCurveOverValuation V g_X ∧
        AlgebraicGeometry.IsProper p_X ∧
        p_X ≫ g_ss = g_X ∧
        η_X ≫ p_X = η_ss ∧
        ι_X ≫ p_X = ι_U' ≫ h_mod ∧
        CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        (∀ i : Fin r_val, i.1 < k → IsValResolvedOnMod V g_ss p_X η_X (W_list i)) := by
    intro k
    induction k with
    | zero =>
      intro _
      refine ⟨U_ss, g_ss, 𝟙 U_ss, η_ss, ι_U' ≫ h_mod, hSS, inferInstance,
        CategoryTheory.Category.id_comp g_ss,
        CategoryTheory.Category.comp_id η_ss,
        CategoryTheory.Category.comp_id (ι_U' ≫ h_mod),
        hPb_ss, ?_⟩
      intro i hi
      omega
    | succ k ih =>
      intro hk
      obtain ⟨X, g_X, p_X, η_X, ι_X, hSS_X, hProp_pX, hComm_pX, hη_pX, hι_pX, hPb_X, hRes_prev⟩ :=
        ih (Nat.le_of_succ_le hk)
      obtain ⟨X', g_X', f_step, η_X', ι_X', hSS_X', hProp_step, hComm_step,
          hη_step, hι_step, hPb_X', hRes_k, hRes_pres⟩ :=
        weil_strictlySemistable_single_valuation_resolution K m V hPkg hBl hOpenη
          C_K p_K U_K U_ss g_ss hSS F_ss η_ss hFunc_ss
          X g_X p_X η_X ι_X (W_list ⟨k, hk⟩) hSS_X hProp_pX hComm_pX hη_pX hPb_X (hW_div ⟨k, hk⟩)
      have hProp_comp : AlgebraicGeometry.IsProper (f_step ≫ p_X) :=
        @AlgebraicGeometry.IsProper.instCompScheme _ _ _ f_step p_X hProp_step hProp_pX
      refine ⟨X', g_X', f_step ≫ p_X, η_X', ι_X', hSS_X', hProp_comp, ?_, ?_, ?_, hPb_X', ?_⟩
      · rw [CategoryTheory.Category.assoc, hComm_pX, hComm_step]
      · rw [← CategoryTheory.Category.assoc, hη_step, hη_pX]
      · rw [← CategoryTheory.Category.assoc, hι_step, hι_pX]
      · intro i hi
        rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
        · exact hRes_pres (W_list i) (hRes_prev i hlt)
        · have hi_eq : i = ⟨k, hk⟩ := Fin.ext heq
          rw [hi_eq]
          exact hRes_k
  obtain ⟨C''_0, g''_0, p_0, η_0, ι_0, hSS_0, hProp_0, hComm_0, hη_0, hι_0, hPb_0, hRes_all⟩ :=
    hResolveLoop r_val (le_refl r_val)
  obtain ⟨f_0, hProp_f0, hf0_hmod, hf0_g', hι0_f0⟩ :=
    hDomCrit C''_0 g''_0 p_0 η_0 ι_0 hSS_0 (hNorm C''_0 g''_0 hSS_0)
      hProp_0 hComm_0 hη_0 hι_0 hPb_0 (fun i => hRes_all i i.isLt)
  obtain ⟨C'', g'', f_pt, τ'', ι_C'', hSS_C'', hProp_fpt, hfpt_g0,
      hιC''_fpt, hPb_C'', hτ''_comm, hτ''_disj, hτ''_sm⟩ :=
    weil_strictlySemistable_pointed_section_resolution K m V hPkg hBl hOpenη
      C_K p_K n σ_K hSmCK hStabCK C' g' τ' ι' hMod' U' ι_U' hι_comm
      C''_0 g''_0 f_0 ι_0 hSS_0 hProp_f0 hf0_g' hι0_f0 hPb_0
  have hProp_dom : AlgebraicGeometry.IsProper (f_pt ≫ f_0) :=
    @AlgebraicGeometry.IsProper.instCompScheme _ _ _ f_pt f_0 hProp_fpt hProp_f0
  have hProp_ss : AlgebraicGeometry.IsProper ((f_pt ≫ f_0) ≫ h_mod) :=
    @AlgebraicGeometry.IsProper.instCompScheme _ _ _ (f_pt ≫ f_0) h_mod hProp_dom hProp_mod
  refine ⟨C'', g'', f_pt ≫ f_0, τ'', ι_C'',
    hSS_C'', hProp_dom, ?_, ⟨(f_pt ≫ f_0) ≫ h_mod, rfl, hProp_ss⟩, ?_, hPb_C'', ?_, hτ''_disj, hτ''_sm⟩
  · rw [CategoryTheory.Category.assoc, hf0_g', hfpt_g0]
  · rw [← CategoryTheory.Category.assoc, hιC''_fpt, hι0_f0]
  · intro j
    simpa only [CategoryTheory.Category.assoc] using hτ''_comm j

theorem weil_algClosed_fieldExt_fiber_irred_and_subscheme_descent (k K' : Type u) [Field k] [IsAlgClosed k] [Field K'] [Algebra k K']
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    [AlgebraicGeometry.LocallyOfFiniteType p_Y] :
    let s_ψ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K'))
    let Y_K' := CategoryTheory.Limits.pullback p_Y s_ψ
    let π := CategoryTheory.Limits.pullback.fst p_Y s_ψ
    Function.Surjective π.base ∧
    (∀ C : Set ↥Y, IsClosed C → IsIrreducible C → IsIrreducible (π.base ⁻¹' C)) ∧
    (∀ (E : Set ↥Y_K') (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y_K'),
      E ∈ irreducibleComponents ↥Y_K' →
      AlgebraicGeometry.IsClosedImmersion ιE →
      AlgebraicGeometry.IsIntegral E_sch →
      Set.range ιE.base = E →
      ∃ (E₀ : Set ↥Y) (E₀_sch : AlgebraicGeometry.Scheme.{u}) (ιE₀ : E₀_sch ⟶ Y),
        E₀ ∈ irreducibleComponents ↥Y ∧
        π.base ⁻¹' E₀ = E ∧
        (∀ E' ∈ irreducibleComponents ↥Y, E' ≠ E₀ →
          ∀ q ∈ E', ∀ q_lift : ↥Y_K', π.base q_lift = q →
            ∃ C' ∈ irreducibleComponents ↥Y_K', C' ≠ E ∧ q_lift ∈ C') ∧
        AlgebraicGeometry.IsClosedImmersion ιE₀ ∧
        AlgebraicGeometry.IsIntegral E₀_sch ∧
        Set.range ιE₀.base = E₀ ∧
        ∃ (iso_bc : CategoryTheory.Limits.pullback (ιE₀ ≫ p_Y) s_ψ ≅ E_sch),
          CategoryTheory.Limits.pullback.snd (ιE₀ ≫ p_Y) s_ψ =
            iso_bc.hom ≫ ιE ≫ CategoryTheory.Limits.pullback.snd p_Y s_ψ) :=
by
  intro s_ψ Y_K' π
  
  have hs_surj : AlgebraicGeometry.Surjective s_ψ :=
    AlgebraicGeometry.Surjective.mk (fun q => ⟨(⊥ : PrimeSpectrum K'), Subsingleton.elim _ _⟩)
  have hSurj_fst : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)),
      Function.Surjective (CategoryTheory.Limits.pullback.fst p_Z s_ψ).base := by
    intro Z p_Z
    have : AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst p_Z s_ψ) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective)
        (CategoryTheory.IsPullback.of_hasPullback p_Z s_ψ).flip hs_surj
    exact (CategoryTheory.Limits.pullback.fst p_Z s_ψ).surjective
  have hSurj_π : Function.Surjective π.base := hSurj_fst Y p_Y

  
  have hTensorDom : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra k D]
      [Algebra.FiniteType k D], IsDomain (TensorProduct k D K') := by
    intro D _ _ _ _
    have hEval : ∀ (g : D), g ≠ 0 → ∃ χ : D →ₐ[k] k, χ g ≠ 0 := by
      intro g hg
      let D_g := Localization.Away g
      have hDom_Dg : IsDomain D_g :=
        IsLocalization.isDomain_of_le_nonZeroDivisors D_g
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg))
      have : Nontrivial D_g := hDom_Dg.toNontrivial
      have : Algebra.FiniteType k D_g :=
        Algebra.FiniteType.trans (R := k) (S := D) (A := D_g) inferInstance inferInstance
      obtain ⟨N, f_mv, hf_surj⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := D_g)).mp inferInstance
      let I_mv : Ideal (MvPolynomial (Fin N) k) := RingHom.ker f_mv
      have hI_ne_top : I_mv ≠ ⊤ := by
        intro htop
        have h1 : (1 : MvPolynomial (Fin N) k) ∈ I_mv := by rw [htop]; trivial
        have hf1 : f_mv 1 = 0 := h1
        rw [map_one] at hf1
        exact one_ne_zero hf1
      obtain ⟨M, hM_max, hI_le_M⟩ := Ideal.exists_le_maximal I_mv hI_ne_top
      obtain ⟨pt, hM_eq⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton
          (K := k) (σ := Fin N) (I := M)).mp hM_max
      have h_kill : ∀ p ∈ I_mv, (MvPolynomial.aeval pt) p = 0 := by
        intro p hp
        have hpM : p ∈ MvPolynomial.vanishingIdeal k {pt} := hM_eq ▸ hI_le_M hp
        exact (MvPolynomial.mem_vanishingIdeal_singleton_iff pt p).mp hpM
      let e_quot : (MvPolynomial (Fin N) k ⧸ I_mv) ≃ₐ[k] D_g :=
        Ideal.quotientKerAlgEquivOfSurjective hf_surj
      let ev_quot : (MvPolynomial (Fin N) k ⧸ I_mv) →ₐ[k] k :=
        Ideal.Quotient.liftₐ I_mv (MvPolynomial.aeval pt) h_kill
      let ev_g : D_g →ₐ[k] k := ev_quot.comp e_quot.symm.toAlgHom
      let χ : D →ₐ[k] k := ev_g.comp (IsScalarTower.toAlgHom k D D_g)
      have hu : IsUnit (algebraMap D D_g g) := IsLocalization.Away.algebraMap_isUnit g
      have hχ_unit : IsUnit (χ g) := hu.map ev_g.toRingHom
      exact ⟨χ, hχ_unit.ne_zero⟩
    obtain ⟨χ₁, _⟩ := hEval 1 one_ne_zero
    let Ψ₁ : TensorProduct k D K' →ₐ[k] K' :=
      Algebra.TensorProduct.productMap ((Algebra.ofId k K').comp χ₁) (AlgHom.id k K')
    have : Nontrivial (TensorProduct k D K') := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have hΨ01 : Ψ₁ 0 = Ψ₁ 1 := congrArg Ψ₁ h01
      rw [map_zero, map_one] at hΨ01
      exact zero_ne_one hΨ01
    let b_K := Module.Basis.ofVectorSpace k K'
    let B_D := Algebra.TensorProduct.basis D b_K
    have hNZD : NoZeroDivisors (TensorProduct k D K') := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra! hne
      rcases hne with ⟨hx0, hy0⟩
      have hrx : B_D.repr x ≠ 0 := fun h => hx0 (B_D.repr.injective (by simpa using h))
      have hry : B_D.repr y ≠ 0 := fun h => hy0 (B_D.repr.injective (by simpa using h))
      obtain ⟨i₀, hi₀⟩ : ∃ i, B_D.repr x i ≠ 0 := by
        by_contra! hall
        exact hrx (Finsupp.ext hall)
      obtain ⟨j₀, hj₀⟩ : ∃ j, B_D.repr y j ≠ 0 := by
        by_contra! hall
        exact hry (Finsupp.ext hall)
      obtain ⟨χ, hχ_prod⟩ := hEval (B_D.repr x i₀ * B_D.repr y j₀) (mul_ne_zero hi₀ hj₀)
      rw [map_mul] at hχ_prod
      have hχx : χ (B_D.repr x i₀) ≠ 0 := left_ne_zero_of_mul hχ_prod
      have hχy : χ (B_D.repr y j₀) ≠ 0 := right_ne_zero_of_mul hχ_prod
      let Ψ : TensorProduct k D K' →ₐ[k] K' :=
        Algebra.TensorProduct.productMap ((Algebra.ofId k K').comp χ) (AlgHom.id k K')
      have hCoord : ∀ (z : TensorProduct k D K') (i : Module.Basis.ofVectorSpaceIndex k K'),
          b_K.repr (Ψ z) i = χ (B_D.repr z i) := by
        intro z i
        refine TensorProduct.induction_on
          (motive := fun z => b_K.repr (Ψ z) i = χ (B_D.repr z i)) z ?_ ?_ ?_
        · simp
        · intro d c
          have hΨ_tmul : Ψ (d ⊗ₜ[k] c) = χ d • c := by
            change ((Algebra.ofId k K').comp χ) d * c = χ d • c
            rw [AlgHom.comp_apply, Algebra.ofId_apply, Algebra.smul_def]
          rw [hΨ_tmul, LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul]
          change χ d * b_K.repr c i = χ ((Algebra.TensorProduct.basis D b_K).repr (d ⊗ₜ[k] c) i)
          rw [Algebra.TensorProduct.basis_repr_tmul]
          simp [AlgHom.commutes]
        · intro z₁ z₂ ih₁ ih₂
          simp [map_add, ih₁, ih₂]
      have hΨx : Ψ x ≠ 0 := by
        intro h0
        apply hχx
        rw [← hCoord x i₀, h0]
        simp
      have hΨy : Ψ y ≠ 0 := by
        intro h0
        apply hχy
        rw [← hCoord y j₀, h0]
        simp
      have hΨxy : Ψ (x * y) = 0 := by rw [hxy, map_zero]
      rw [map_mul] at hΨxy
      exact mul_ne_zero hΨx hΨy hΨxy
    exact NoZeroDivisors.to_isDomain (TensorProduct k D K')

  
  have hChartBC : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      [AlgebraicGeometry.LocallyOfFiniteType p_Z]
      (U : Z.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      let π_Z := CategoryTheory.Limits.pullback.fst p_Z s_ψ
      let W_U : (CategoryTheory.Limits.pullback p_Z s_ψ).Opens :=
        (TopologicalSpace.Opens.map π_Z.base).obj U
      let A : Type u := ↑(Z.presheaf.obj (Opposite.op U))
      ∃ (instAlg : Algebra k A),
        letI : Algebra k A := instAlg
        Algebra.FiniteType k A ∧
        ∃ (e_WU : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K')) ≅ W_U.toScheme),
          (e_WU.hom ≫ W_U.ι) ≫ π_Z =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := A) (B := K'))) ≫
              hU.fromSpec ∧
          Set.range (e_WU.hom ≫ W_U.ι).base = π_Z.base ⁻¹' (U : Set ↥Z) := by
    intro Z p_Z _ U hU π_Z W_U A
    let snd_Z := CategoryTheory.Limits.pullback.snd p_Z s_ψ
    let φ_cat : CommRingCat.of k ⟶ Z.presheaf.obj (Opposite.op U) :=
      AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ p_Z)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_cat = hU.fromSpec ≫ p_Z :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ p_Z)
    have hLft_comp : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_cat) := by
      rw [hSpec_φ]
      infer_instance
    have hFT_φ : φ_cat.hom.FiniteType :=
      (@AlgebraicGeometry.HasRingHomProperty.Spec_iff (@AlgebraicGeometry.LocallyOfFiniteType)
        _ _ _ _ φ_cat).mp hLft_comp
    let : Algebra k A := φ_cat.hom.toAlgebra
    refine ⟨φ_cat.hom.toAlgebra, hFT_φ, ?_⟩
    let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
    have hs_A : s_A = hU.fromSpec ≫ p_Z := hSpec_φ
    have hPb1 : CategoryTheory.IsPullback (π_Z ∣_ U) (W_U.ι ≫ snd_Z) (U.ι ≫ p_Z) s_ψ :=
      (AlgebraicGeometry.isPullback_morphismRestrict π_Z U).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback p_Z s_ψ)
    have hComm_iso : hU.isoSpec.hom ≫ s_A = (U.ι ≫ p_Z) ≫ 𝟙 _ := by
      rw [Category.comp_id, hs_A, ← hU.isoSpec_inv_ι]
      simp
    have hPb_iso : CategoryTheory.IsPullback hU.isoSpec.hom (U.ι ≫ p_Z) s_A (𝟙 _) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨hComm_iso⟩
    have hPb_U : CategoryTheory.IsPullback ((π_Z ∣_ U) ≫ hU.isoSpec.hom)
        (W_U.ι ≫ snd_Z) s_A s_ψ := by
      simpa only [Category.comp_id] using hPb1.paste_horiz hPb_iso
    let e_WU : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K')) ≅ W_U.toScheme :=
      (AlgebraicGeometry.pullbackSpecIso k A K').symm ≪≫ hPb_U.isoPullback.symm
    refine ⟨e_WU, ?_, ?_⟩
    · have h1 : e_WU.hom ≫ ((π_Z ∣_ U) ≫ hU.isoSpec.hom) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := A) (B := K'))) := by
        dsimp [e_WU]
        rw [Category.assoc, hPb_U.isoPullback_inv_fst, AlgebraicGeometry.pullbackSpecIso_inv_fst]
      have h2 := congrArg (· ≫ hU.fromSpec) h1
      rw [← hU.isoSpec_inv_ι] at h2
      have h2' : e_WU.hom ≫ (π_Z ∣_ U) ≫ U.ι =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := A) (B := K'))) ≫
            hU.fromSpec := by
        simpa [Category.assoc] using h2
      rwa [AlgebraicGeometry.morphismRestrict_ι] at h2'
    · have hSurj_e : Function.Surjective e_WU.hom.base :=
        (ConcreteCategory.bijective_of_isIso e_WU.hom.base).2
      change Set.range (W_U.ι.base ∘ e_WU.hom.base) = π_Z.base ⁻¹' (U : Set ↥Z)
      rw [Set.range_comp, hSurj_e.range_eq, Set.image_univ, AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl

  
  have hIrredPre : ∀ C : Set ↥Y, IsClosed C → IsIrreducible C → IsIrreducible (π.base ⁻¹' C) := by
    intro C hC_cl hC_irr
    obtain ⟨y₀, hy₀⟩ := hC_irr.1
    obtain ⟨z₀, hz₀⟩ := hSurj_π y₀
    have hPre_ne : (π.base ⁻¹' C).Nonempty := ⟨z₀, by rw [Set.mem_preimage, hz₀]; exact hy₀⟩
    have hChartIrred : ∀ (U : Y.Opens), AlgebraicGeometry.IsAffineOpen U →
        (C ∩ (U : Set ↥Y)).Nonempty →
        IsIrreducible ((π.base ⁻¹' C) ∩ (π.base ⁻¹' (U : Set ↥Y))) := by
      intro U hU hCU
      obtain ⟨instAlgA, hFT_A, e_WU, hψ_π, hRange_ψ⟩ := hChartBC Y p_Y U hU
      let A : Type u := ↑(Y.presheaf.obj (Opposite.op U))
      let : Algebra k A := instAlgA
      have : Algebra.FiniteType k A := hFT_A
      let W_U : Y_K'.Opens := (TopologicalSpace.Opens.map π.base).obj U
      let ψ_U : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K')) ⟶ Y_K' :=
        e_WU.hom ≫ W_U.ι
      let f_U := hU.fromSpec
      let Z_U : Set (PrimeSpectrum A) := f_U.base ⁻¹' C
      have hZU_cl : IsClosed Z_U := hC_cl.preimage f_U.continuous
      have hZU_ne : Z_U.Nonempty := by
        rcases hCU with ⟨y, hyC, hyU⟩
        rw [← hU.range_fromSpec] at hyU
        rcases hyU with ⟨p, rfl⟩
        exact ⟨p, hyC⟩
      have hZU_irr : IsIrreducible Z_U := by
        refine ⟨hZU_ne, fun G₁ G₂ hG₁ hG₂ ⟨p₁, hp₁Z, hp₁G⟩ ⟨p₂, hp₂Z, hp₂G⟩ => ?_⟩
        have hO₁ : IsOpen (f_U.base '' G₁) := f_U.isOpenEmbedding.isOpenMap G₁ hG₁
        have hO₂ : IsOpen (f_U.base '' G₂) := f_U.isOpenEmbedding.isOpenMap G₂ hG₂
        obtain ⟨y, hyC, ⟨q₁, hq₁G, rfl⟩, ⟨q₂, hq₂G, hqq⟩⟩ :=
          hC_irr.isPreirreducible (f_U.base '' G₁) (f_U.base '' G₂) hO₁ hO₂
            ⟨f_U.base p₁, hp₁Z, p₁, hp₁G, rfl⟩
            ⟨f_U.base p₂, hp₂Z, p₂, hp₂G, rfl⟩
        have hq12 : q₁ = q₂ := f_U.isOpenEmbedding.injective hqq.symm
        subst hq12
        exact ⟨q₁, hyC, hq₁G, hq₂G⟩
      let I_U : Ideal A := PrimeSpectrum.vanishingIdeal Z_U
      have hZero_IU : PrimeSpectrum.zeroLocus (I_U : Set A) = Z_U := by
        rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hZU_cl.closure_eq]
      have hIU_prime : I_U.IsPrime :=
        (PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime (s := Z_U)).mp hZU_irr
      have : IsDomain (A ⧸ I_U) := Ideal.Quotient.isDomain I_U
      have : Algebra.FiniteType k (A ⧸ I_U) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k I_U) Ideal.Quotient.mk_surjective
      have : IsDomain (TensorProduct k (A ⧸ I_U) K') := hTensorDom (A ⧸ I_U)
      let ι_L : A →+* TensorProduct k A K' :=
        Algebra.TensorProduct.includeLeftRingHom (R := k) (A := A) (B := K')
      let J_U : Ideal (TensorProduct k A K') := Ideal.map ι_L I_U
      let q_U : TensorProduct k A K' →ₐ[k] TensorProduct k (A ⧸ I_U) K' :=
        Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k I_U) (AlgHom.id k K')
      have hKer_qU : RingHom.ker q_U.toRingHom = J_U := by
        apply le_antisymm
        · have h_le : I_U ≤ RingHom.ker (((Ideal.Quotient.mkₐ k J_U).comp
              (Algebra.TensorProduct.includeLeft : A →ₐ[k] TensorProduct k A K')).toRingHom) := by
            intro a ha
            change Ideal.Quotient.mk J_U (ι_L a) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mem_map_of_mem ι_L ha
          let ρ₁ : (A ⧸ I_U) →ₐ[k] (TensorProduct k A K' ⧸ J_U) :=
            Ideal.Quotient.liftₐ I_U
              ((Ideal.Quotient.mkₐ k J_U).comp Algebra.TensorProduct.includeLeft) h_le
          let ρ₂ : K' →ₐ[k] (TensorProduct k A K' ⧸ J_U) :=
            (Ideal.Quotient.mkₐ k J_U).comp Algebra.TensorProduct.includeRight
          let ρ : TensorProduct k (A ⧸ I_U) K' →ₐ[k] (TensorProduct k A K' ⧸ J_U) :=
            Algebra.TensorProduct.productMap ρ₁ ρ₂
          have hρ_comp : ρ.comp q_U = Ideal.Quotient.mkₐ k J_U := by
            apply Algebra.TensorProduct.ext
            · ext a
              simp [ρ, ρ₁, q_U]
              rfl
            · ext c
              simp [ρ, ρ₂, q_U]
          intro w hw
          have h0 : q_U w = 0 := hw
          have hmk : Ideal.Quotient.mk J_U w = 0 := by
            change (Ideal.Quotient.mkₐ k J_U) w = 0
            rw [← hρ_comp, AlgHom.comp_apply, h0, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mp hmk
        · rw [Ideal.map_le_iff_le_comap]
          intro a ha
          change q_U (a ⊗ₜ[k] 1) = 0
          have ha0 : Ideal.Quotient.mk I_U a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
          change (Ideal.Quotient.mk I_U a) ⊗ₜ[k] (1 : K') = 0
          rw [ha0, TensorProduct.zero_tmul]
      have hJU_prime : J_U.IsPrime := by
        rw [← hKer_qU]
        exact RingHom.ker_isPrime q_U.toRingHom
      have hIrred_JU : IsIrreducible (PrimeSpectrum.zeroLocus (J_U : Set (TensorProduct k A K'))) := by
        rw [PrimeSpectrum.isIrreducible_zeroLocus_iff, hJU_prime.radical]
        exact hJU_prime
      have hPre_ψ : ψ_U.base ⁻¹' (π.base ⁻¹' C) =
          PrimeSpectrum.zeroLocus (J_U : Set (TensorProduct k A K')) := by
        ext q
        have hcomp_q : π.base (ψ_U.base q) =
            f_U.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L)).base q) := by
          change (ψ_U ≫ π).base q = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ f_U).base q
          rw [hψ_π]
        have h1 : q ∈ ψ_U.base ⁻¹' (π.base ⁻¹' C) ↔
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L)).base q : PrimeSpectrum A) ∈ Z_U := by
          change π.base (ψ_U.base q) ∈ C ↔
            f_U.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L)).base q) ∈ C
          rw [hcomp_q]
        have h2 : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L)).base q : PrimeSpectrum A) ∈ Z_U ↔
            PrimeSpectrum.comap ι_L (q : PrimeSpectrum (TensorProduct k A K')) ∈
              PrimeSpectrum.zeroLocus (I_U : Set A) := by
          rw [← hZero_IU]
          exact Eq.to_iff (congrArg (· ∈ PrimeSpectrum.zeroLocus (I_U : Set A))
            (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ι_L) q))
        have h3_gen : ∀ q' : PrimeSpectrum (TensorProduct k A K'),
            PrimeSpectrum.comap ι_L q' ∈ PrimeSpectrum.zeroLocus (I_U : Set A) ↔
              q' ∈ PrimeSpectrum.zeroLocus (J_U : Set (TensorProduct k A K')) := by
          intro q'
          rw [PrimeSpectrum.mem_zeroLocus, PrimeSpectrum.mem_zeroLocus,
            SetLike.coe_subset_coe, SetLike.coe_subset_coe, Ideal.map_le_iff_le_comap]
          rfl
        exact h1.trans (h2.trans (h3_gen q))
      have hImg : ψ_U.base '' (PrimeSpectrum.zeroLocus (J_U : Set (TensorProduct k A K'))) =
          (π.base ⁻¹' C) ∩ (π.base ⁻¹' (U : Set ↥Y)) := by
        rw [← hPre_ψ, Set.image_preimage_eq_inter_range, hRange_ψ]
      rw [← hImg]
      exact hIrred_JU.image ψ_U.base ψ_U.continuous.continuousOn
    refine ⟨hPre_ne, fun O₁ O₂ hO₁ hO₂ ⟨x₁, hx₁C, hx₁O₁⟩ ⟨x₂, hx₂C, hx₂O₂⟩ => ?_⟩
    obtain ⟨U₁, hU₁, hx₁U₁, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π.base x₁) trivial
    obtain ⟨U₂, hU₂, hx₂U₂, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π.base x₂) trivial
    obtain ⟨y₁₂, hy₁₂C, hy₁₂U₁, hy₁₂U₂⟩ :=
      hC_irr.isPreirreducible (U₁ : Set ↥Y) (U₂ : Set ↥Y) U₁.isOpen U₂.isOpen
        ⟨π.base x₁, hx₁C, hx₁U₁⟩ ⟨π.base x₂, hx₂C, hx₂U₂⟩
    obtain ⟨z₁₂, hz₁₂⟩ := hSurj_π y₁₂
    have hV₁_irr := hChartIrred U₁ hU₁ ⟨π.base x₁, hx₁C, hx₁U₁⟩
    have hV₂_irr := hChartIrred U₂ hU₂ ⟨π.base x₂, hx₂C, hx₂U₂⟩
    obtain ⟨w, ⟨hwC, _hwU₁⟩, hwO₁, hwU₂⟩ :=
      hV₁_irr.isPreirreducible O₁ (π.base ⁻¹' (U₂ : Set ↥Y)) hO₁
        (U₂.isOpen.preimage π.continuous)
        ⟨x₁, ⟨hx₁C, hx₁U₁⟩, hx₁O₁⟩
        ⟨z₁₂, ⟨by rw [Set.mem_preimage, hz₁₂]; exact hy₁₂C,
               by rw [Set.mem_preimage, hz₁₂]; exact hy₁₂U₁⟩,
         by rw [Set.mem_preimage, hz₁₂]; exact hy₁₂U₂⟩
    obtain ⟨u, ⟨huC, _huU₂⟩, huO₁, huO₂⟩ :=
      hV₂_irr.isPreirreducible O₁ O₂ hO₁ hO₂
        ⟨w, ⟨hwC, hwU₂⟩, hwO₁⟩
        ⟨x₂, ⟨hx₂C, hx₂U₂⟩, hx₂O₂⟩
    exact ⟨u, huC, huO₁, huO₂⟩

  
  have hRedBC : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      [AlgebraicGeometry.IsIntegral X]
      [AlgebraicGeometry.LocallyOfFiniteType p_X],
      AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback p_X s_ψ) := by
    intro X p_X hIntX _
    let X_pb := CategoryTheory.Limits.pullback p_X s_ψ
    let π_X := CategoryTheory.Limits.pullback.fst p_X s_ψ
    have hStalkRed : ∀ z : ↥X_pb, _root_.IsReduced ↑(X_pb.presheaf.stalk z) := by
      intro z
      obtain ⟨U, hU, hxU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π_X.base z) trivial
      obtain ⟨instAlgA, hFT_A, e_WU, _, _⟩ := hChartBC X p_X U hU
      let A : Type u := ↑(X.presheaf.obj (Opposite.op U))
      let : Algebra k A := instAlgA
      have : Algebra.FiniteType k A := hFT_A
      have hNonemptyU : Nonempty ↥U := ⟨⟨π_X.base z, hxU⟩⟩
      have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral X hIntX U hNonemptyU
      have : IsDomain (TensorProduct k A K') := hTensorDom A
      have : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K'))) :=
        (AlgebraicGeometry.affine_isReduced_iff
          (CommRingCat.of (TensorProduct k A K'))).mpr inferInstance
      let W_U : X_pb.Opens := (TopologicalSpace.Opens.map π_X.base).obj U
      have : AlgebraicGeometry.IsReduced W_U.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion e_WU.inv
      have : _root_.IsReduced ↑((↑W_U : AlgebraicGeometry.Scheme.{u}).presheaf.stalk ⟨z, hxU⟩) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced W_U.toScheme ⟨z, hxU⟩
      let isoStalk := AlgebraicGeometry.Scheme.Opens.stalkIso W_U ⟨z, hxU⟩
      exact isReduced_of_injective isoStalk.inv.hom
        (ConcreteCategory.bijective_of_isIso isoStalk.inv).1
    exact AlgebraicGeometry.isReduced_of_isReduced_stalk X_pb

  
  refine ⟨hSurj_π, hIrredPre, ?_⟩
  intro E E_sch ιE hE_mem hClE hIntE hRangeE
  have : AlgebraicGeometry.IsClosedImmersion ιE := hClE
  have : AlgebraicGeometry.IsIntegral E_sch := hIntE

  
  let E₀ : Set ↥Y := closure (π.base '' E)
  have hIrred_E₀ : IsIrreducible E₀ := (hE_mem.1.image π.base π.continuous.continuousOn).closure
  obtain ⟨C₀, hC₀_mem, hE₀_sub_C₀⟩ :=
    exists_mem_irreducibleComponents_subset_of_isIrreducible E₀ hIrred_E₀
  have hIrred_preC₀ : IsIrreducible (π.base ⁻¹' C₀) :=
    hIrredPre C₀ (isClosed_of_mem_irreducibleComponents C₀ hC₀_mem) hC₀_mem.1
  have hE_sub_preE₀ : E ⊆ π.base ⁻¹' E₀ :=
    (Set.subset_preimage_image π.base E).trans (Set.preimage_mono subset_closure)
  have hPreC₀_sub_E : π.base ⁻¹' C₀ ⊆ E :=
    hE_mem.2 hIrred_preC₀ (hE_sub_preE₀.trans (Set.preimage_mono hE₀_sub_C₀))
  have hPre_E₀ : π.base ⁻¹' E₀ = E :=
    Set.Subset.antisymm ((Set.preimage_mono hE₀_sub_C₀).trans hPreC₀_sub_E) hE_sub_preE₀
  have hPre_eq_C₀ : π.base ⁻¹' E₀ = π.base ⁻¹' C₀ :=
    Set.Subset.antisymm (Set.preimage_mono hE₀_sub_C₀) (hPreC₀_sub_E.trans hE_sub_preE₀)
  have hE₀_eq_C₀ : E₀ = C₀ := by
    calc E₀ = π.base '' (π.base ⁻¹' E₀) := (Set.image_preimage_eq E₀ hSurj_π).symm
      _ = π.base '' (π.base ⁻¹' C₀) := by rw [hPre_eq_C₀]
      _ = C₀ := Set.image_preimage_eq C₀ hSurj_π
  have hE₀_mem : E₀ ∈ irreducibleComponents ↥Y := hE₀_eq_C₀.symm ▸ hC₀_mem
  have hLiftOther : ∀ E' ∈ irreducibleComponents ↥Y, E' ≠ E₀ →
      ∀ q ∈ E', ∀ q_lift : ↥Y_K', π.base q_lift = q →
        ∃ C' ∈ irreducibleComponents ↥Y_K', C' ≠ E ∧ q_lift ∈ C' := by
    intro E' hE'_mem hE'_ne q hq q_lift hq_lift
    have hIrred_preE' : IsIrreducible (π.base ⁻¹' E') :=
      hIrredPre E' (isClosed_of_mem_irreducibleComponents E' hE'_mem) hE'_mem.1
    obtain ⟨C', hC'_mem, hPreE'_sub_C'⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible (π.base ⁻¹' E') hIrred_preE'
    have hq_in_C' : q_lift ∈ C' := hPreE'_sub_C' (by rw [Set.mem_preimage, hq_lift]; exact hq)
    refine ⟨C', hC'_mem, ?_, hq_in_C'⟩
    intro hC'_eq
    apply hE'_ne
    have hPre_sub : π.base ⁻¹' E' ⊆ π.base ⁻¹' E₀ := by
      rw [hPre_E₀, ← hC'_eq]
      exact hPreE'_sub_C'
    have hE'_sub_E₀ : E' ⊆ E₀ := by
      calc E' = π.base '' (π.base ⁻¹' E') := (Set.image_preimage_eq E' hSurj_π).symm
        _ ⊆ π.base '' (π.base ⁻¹' E₀) := Set.image_mono hPre_sub
        _ = E₀ := Set.image_preimage_eq E₀ hSurj_π
    exact Set.Subset.antisymm hE'_sub_E₀ (hE'_mem.2 hIrred_E₀ hE'_sub_E₀)

  
  have : AlgebraicGeometry.IsAffineHom s_ψ := AlgebraicGeometry.isAffineHom_of_isAffine s_ψ
  let j : E_sch ⟶ Y := ιE ≫ π
  let E₀_sch : AlgebraicGeometry.Scheme.{u} := j.image
  let ιE₀ : E₀_sch ⟶ Y := j.imageι
  have hCl_ιE₀ : AlgebraicGeometry.IsClosedImmersion ιE₀ := inferInstance
  have hRange_ιE₀ : Set.range ιE₀.base = E₀ := by
    change Set.range j.ker.subschemeι.base = E₀
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.Hom.support_ker]
    dsimp [E₀, j]
    rw [Set.range_comp, hRangeE]
  have hInt_E₀ : AlgebraicGeometry.IsIntegral E₀_sch := by
    have : IrreducibleSpace ↥E_sch := AlgebraicGeometry.irreducibleSpace_of_isIntegral E_sch
    have hDense : DenseRange j.toImage.base := AlgebraicGeometry.IsDominant.denseRange
    have hIrred_univ : IsIrreducible (Set.univ : Set ↥E₀_sch) := by
      rw [← hDense.closure_range, ← Set.image_univ]
      exact ((IrreducibleSpace.isIrreducible_univ ↥E_sch).image j.toImage.base
        j.toImage.continuous.continuousOn).closure
    obtain ⟨⟨z_e0, _⟩, hPre_e0⟩ := hIrred_univ
    have : PreirreducibleSpace ↥E₀_sch := ⟨hPre_e0⟩
    have : IrreducibleSpace ↥E₀_sch := ⟨⟨z_e0⟩⟩
    have : AlgebraicGeometry.IsReduced E_sch := inferInstance
    have hStalk_E₀ : ∀ z : ↥E₀_sch, _root_.IsReduced ↑(E₀_sch.presheaf.stalk z) := by
      intro z
      obtain ⟨U_op, hU_aff, hzU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := ιE₀.base z) trivial
      let U : Y.affineOpens := ⟨U_op, hU_aff⟩
      let V : E₀_sch.Opens := (TopologicalSpace.Opens.map ιE₀.base).obj U.1
      have hV_aff : AlgebraicGeometry.IsAffineOpen V := hU_aff.preimage ιE₀
      let isoObj := j.ker.subschemeObjIso U
      have hRed_quot : _root_.IsReduced (↑(Y.presheaf.obj (Opposite.op U.1)) ⧸ j.ker.ideal U) := by
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply j U]
        exact isReduced_of_injective (RingHom.kerLift (j.app U.1).hom)
          (RingHom.kerLift_injective (j.app U.1).hom)
      have : _root_.IsReduced ↑(E₀_sch.presheaf.obj (Opposite.op V)) :=
        isReduced_of_injective isoObj.hom.hom
          (ConcreteCategory.bijective_of_isIso isoObj.hom).1
      have : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (E₀_sch.presheaf.obj (Opposite.op V))) :=
        (AlgebraicGeometry.affine_isReduced_iff
          (E₀_sch.presheaf.obj (Opposite.op V))).mpr inferInstance
      have : AlgebraicGeometry.IsReduced V.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion hV_aff.isoSpec.hom
      have : _root_.IsReduced ↑((↑V : AlgebraicGeometry.Scheme.{u}).presheaf.stalk ⟨z, hzU⟩) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced V.toScheme ⟨z, hzU⟩
      let isoStalk := AlgebraicGeometry.Scheme.Opens.stalkIso V ⟨z, hzU⟩
      exact isReduced_of_injective isoStalk.inv.hom
        (ConcreteCategory.bijective_of_isIso isoStalk.inv).1
    have : AlgebraicGeometry.IsReduced E₀_sch :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk E₀_sch
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced E₀_sch

  
  have : AlgebraicGeometry.IsIntegral E₀_sch := hInt_E₀
  let P_bc := CategoryTheory.Limits.pullback (ιE₀ ≫ p_Y) s_ψ
  let fst_bc := CategoryTheory.Limits.pullback.fst (ιE₀ ≫ p_Y) s_ψ
  let snd_bc := CategoryTheory.Limits.pullback.snd (ιE₀ ≫ p_Y) s_ψ
  let snd_Y := CategoryTheory.Limits.pullback.snd p_Y s_ψ
  let i_bc : P_bc ⟶ Y_K' :=
    CategoryTheory.Limits.pullback.lift (fst_bc ≫ ιE₀) snd_bc
      (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
  have hi_π : i_bc ≫ π = fst_bc ≫ ιE₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hi_snd : i_bc ≫ snd_Y = snd_bc := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_outer : CategoryTheory.IsPullback (i_bc ≫ snd_Y) fst_bc s_ψ (ιE₀ ≫ p_Y) := by
    rw [hi_snd]
    exact (CategoryTheory.IsPullback.of_hasPullback (ιE₀ ≫ p_Y) s_ψ).flip
  have hPb_bc : CategoryTheory.IsPullback i_bc fst_bc π ιE₀ :=
    CategoryTheory.IsPullback.of_right hPb_outer hi_π
      (CategoryTheory.IsPullback.of_hasPullback p_Y s_ψ).flip
  have : AlgebraicGeometry.IsClosedImmersion i_bc :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPb_bc.flip hCl_ιE₀
  let φ₁ : E_sch ⟶ P_bc :=
    CategoryTheory.Limits.pullback.lift j.toImage (ιE ≫ snd_Y) (by
      rw [← Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι]
      change (ιE ≫ π) ≫ p_Y = (ιE ≫ snd_Y) ≫ s_ψ
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition])
  have hφ₁_i : φ₁ ≫ i_bc = ιE := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, hi_π, ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      exact AlgebraicGeometry.Scheme.Hom.toImage_imageι j
    · rw [Category.assoc, hi_snd, CategoryTheory.Limits.pullback.lift_snd]
  have : AlgebraicGeometry.IsClosedImmersion (φ₁ ≫ i_bc) := by
    rw [hφ₁_i]; exact hClE
  have : AlgebraicGeometry.IsClosedImmersion φ₁ :=
    AlgebraicGeometry.IsClosedImmersion.of_comp φ₁ i_bc
  have hφ₁_surj : Function.Surjective φ₁.base := by
    intro z
    have hz_E₀ : π.base (i_bc.base z) ∈ E₀ := by
      have h_eq : π.base (i_bc.base z) = ιE₀.base (fst_bc.base z) := by
        change (i_bc ≫ π).base z = (fst_bc ≫ ιE₀).base z
        rw [hi_π]
      rw [h_eq, ← hRange_ιE₀]
      exact ⟨fst_bc.base z, rfl⟩
    have hz_E : i_bc.base z ∈ E := by
      rw [← hPre_E₀]
      exact hz_E₀
    rw [← hRangeE] at hz_E
    rcases hz_E with ⟨w, hw⟩
    refine ⟨w, i_bc.isClosedEmbedding.injective ?_⟩
    change (φ₁ ≫ i_bc).base w = i_bc.base z
    rw [hφ₁_i]
    exact hw
  have : AlgebraicGeometry.Surjective φ₁ := ⟨hφ₁_surj⟩
  have : AlgebraicGeometry.IsReduced P_bc := hRedBC E₀_sch (ιE₀ ≫ p_Y)
  have : CategoryTheory.IsIso φ₁ :=
    AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective φ₁
  let iso_bc : P_bc ≅ E_sch := (CategoryTheory.asIso φ₁).symm
  refine ⟨E₀, E₀_sch, ιE₀, hE₀_mem, hPre_E₀, hLiftOther, hCl_ιE₀, hInt_E₀, hRange_ιE₀,
    iso_bc, ?_⟩
  have hφ₁_snd : φ₁ ≫ snd_bc = ιE ≫ snd_Y := CategoryTheory.Limits.pullback.lift_snd _ _ _
  calc snd_bc = (iso_bc.hom ≫ φ₁) ≫ snd_bc := by
        change snd_bc = (iso_bc.hom ≫ iso_bc.inv) ≫ snd_bc
        rw [iso_bc.hom_inv_id, Category.id_comp]
    _ = iso_bc.hom ≫ ιE ≫ snd_Y := by rw [Category.assoc, hφ₁_snd]

theorem weil_algClosed_geom_projLine_curve_descent (k K' : Type u) [Field k] [IsAlgClosed k] [Field K'] [IsAlgClosed K'] [Algebra k K']
    (X : AlgebraicGeometry.Scheme.{u})
    (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)) :
    AlgebraicGeometry.IsIntegral X →
    AlgebraicGeometry.IsSeparated p_X →
    AlgebraicGeometry.LocallyOfFiniteType p_X →
    (∃ iso_K' : CategoryTheory.Limits.pullback p_X
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K'))) ≅
          (weilProjectiveSpaceOver K' 1).left,
      CategoryTheory.Limits.pullback.snd p_X
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K'))) =
        iso_K'.hom ≫ (weilProjectiveSpaceOver K' 1).hom) →
    ∃ iso_k : X ≅ (weilProjectiveSpaceOver k 1).left,
      p_X = iso_k.hom ≫ (weilProjectiveSpaceOver k 1).hom :=
by
  intro hIntX hSepX hLftX ⟨iso_K', hiso_K'⟩
  classical
  have hFirstHalf :
      AlgebraicGeometry.IsProper p_X ∧
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom ∧
      AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left ∧
      IsAffineNormalScheme (weilProjectiveSpaceOver k 1).left ∧
      (∀ (L : Type u) [Field L] [Algebra k L] (t : L),
        Transcendental k t →
        IntermediateField.adjoin k ({t} : Set L) = ⊤ →
        ∃ (η_P : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ (weilProjectiveSpaceOver k 1).left),
          η_P ≫ (weilProjectiveSpaceOver k 1).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k L)) ∧
          IsSchemeFunctionField (weilProjectiveSpaceOver k 1).left L η_P) ∧
      IsAffineNormalScheme X ∧
      ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : IsDomain A₀)
        (_ : Algebra k A₀) (_ : Algebra.FiniteType k A₀),
        IsDomain (TensorProduct k A₀ K') ∧
        (∃ a₀ : A₀, a₀ ∉ Set.range (algebraMap k A₀)) ∧
        (∃ (η_X : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing A₀)) ⟶ X),
          η_X ≫ p_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (FractionRing A₀))) ∧
          IsSchemeFunctionField X (FractionRing A₀) η_X) ∧
        ∃ (h₁ h₂ : TensorProduct k A₀ K') (q : Polynomial K'),
          h₂ ≠ 0 ∧
          ∃ (φ₁ : Localization.Away h₁ →+* Localization.Away q)
            (φ₂ : Localization.Away q →+* Localization.Away h₂),
            (∀ c : K',
              φ₂ (algebraMap (Polynomial K') (Localization.Away q) (Polynomial.C c)) =
                algebraMap (TensorProduct k A₀ K') (Localization.Away h₂) (1 ⊗ₜ[k] c)) ∧
            (∀ w : TensorProduct k A₀ K',
              φ₂ (φ₁ (algebraMap (TensorProduct k A₀ K') (Localization.Away h₁) w)) =
                algebraMap (TensorProduct k A₀ K') (Localization.Away h₂) w) := by
    
    have hFuncOfOpenImm : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
        (R₀ L : Type u) [CommRing R₀] [IsDomain R₀] [Field L]
        (φ₀ : R₀ →+* L) (_ : @IsFractionRing R₀ _ L _ φ₀.toAlgebra)
        (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion ι₀],
        IsSchemeFunctionField Z L (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι₀) := by
      intro Z _ R₀ L _ _ _ φ₀ hFrac₀ ι₀ _
      let η := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι₀
      let pt_L : PrimeSpectrum L := ⟨⊥, inferInstance⟩
      let pt_R₀ : PrimeSpectrum R₀ := ⟨⊥, inferInstance⟩
      have hSubL : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := by
        change Subsingleton (PrimeSpectrum L); infer_instance
      have hInj_φ₀ : Function.Injective φ₀ :=
        fun _ _ h => @IsFractionRing.injective R₀ _ L _ φ₀.toAlgebra hFrac₀ _ _ h
      have hSpec_bot :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).base pt_L = pt_R₀ := by
        apply PrimeSpectrum.ext
        ext r
        change φ₀ r ∈ (⊥ : Ideal L) ↔ r ∈ (⊥ : Ideal R₀)
        simp only [Ideal.mem_bot, map_eq_zero_iff φ₀ hInj_φ₀]
      have hη_bot : η.base pt_L = ι₀.base pt_R₀ := by
        change ι₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).base pt_L) = _
        rw [hSpec_bot]
      have hIrredZ : IrreducibleSpace ↥Z :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral Z inferInstance
      have hη_in_open : ∀ (O : Z.Opens), Nonempty ↥O → η.base pt_L ∈ O := by
        intro O ⟨x_O⟩
        obtain ⟨w, hwO, p_R, rfl⟩ :=
          nonempty_preirreducible_inter O.isOpen ι₀.opensRange.isOpen
            ⟨x_O.1, x_O.2⟩ ⟨ι₀.base pt_R₀, ⟨pt_R₀, rfl⟩⟩
        have hp_cl : p_R ∈ closure ({pt_R₀} : Set (PrimeSpectrum R₀)) :=
          (PrimeSpectrum.le_iff_mem_closure (x := pt_R₀) (y := p_R)).mp bot_le
        obtain ⟨y, hyO, hy_eq⟩ :=
          mem_closure_iff.mp hp_cl (ι₀.base ⁻¹' (O : Set ↥Z))
            (O.isOpen.preimage ι₀.continuous) hwO
        rw [Set.mem_singleton_iff.mp hy_eq] at hyO
        rw [hη_bot]
        exact hyO
      intro U hU hUne
      let A_U : Type u := ↑(Z.presheaf.obj (Opposite.op U))
      have : IsDomain A_U := @AlgebraicGeometry.IsIntegral.component_integral Z inferInstance U hUne
      let pt_AU : PrimeSpectrum A_U := ⟨⊥, inferInstance⟩
      have hRange : Set.range η.base ⊆ Set.range hU.fromSpec.base := by
        rw [show Set.range hU.fromSpec.base = (U : Set ↥Z) from
          congrArg SetLike.coe hU.opensRange_fromSpec]
        rintro _ ⟨q, rfl⟩
        rw [@Subsingleton.elim _ hSubL q pt_L]
        exact hη_in_open U hUne
      let u_U := AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec η hRange
      have hu_U : u_U ≫ hU.fromSpec = η :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec η hRange
      let φ_U : Z.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of L :=
        AlgebraicGeometry.Spec.preimage u_U
      have hSpec_φU : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = η := by
        rw [AlgebraicGeometry.Spec.map_preimage]; exact hu_U
      let q_U : PrimeSpectrum A_U := (AlgebraicGeometry.Spec.map φ_U).base pt_L
      have hqU_eq : hU.fromSpec.base q_U = η.base pt_L := by
        change (AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec).base pt_L = η.base pt_L
        rw [hSpec_φU]
      have hInj_φU : Function.Injective φ_U.hom := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro a ha
        rw [RingHom.mem_ker] at ha
        rw [Ideal.mem_bot]
        by_contra ha_ne
        have hbot_mem : pt_AU ∈ PrimeSpectrum.basicOpen a := by
          rw [PrimeSpectrum.mem_basicOpen]
          change a ∉ (⊥ : Ideal A_U)
          rw [Ideal.mem_bot]; exact ha_ne
        let O_a : Z.Opens := hU.fromSpec ''ᵁ PrimeSpectrum.basicOpen a
        have hOa_ne : Nonempty ↥O_a := ⟨⟨hU.fromSpec.base pt_AU, pt_AU, hbot_mem, rfl⟩⟩
        have hmem_Oa : η.base pt_L ∈ (O_a : Set ↥Z) := hη_in_open O_a hOa_ne
        rcases hmem_Oa with ⟨p', hp', hp'_eq⟩
        have hq_eq_p' : q_U = p' :=
          hU.fromSpec.isOpenEmbedding.injective (hqU_eq.trans hp'_eq.symm)
        rw [← hq_eq_p'] at hp'
        have ha_not : a ∉ q_U.asIdeal := hp'
        apply ha_not
        change φ_U.hom a ∈ (⊥ : Ideal L)
        rw [ha]; exact Ideal.zero_mem _
      have hqU_in_pre : q_U ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj ι₀.opensRange := by
        change hU.fromSpec.base q_U ∈ Set.range ι₀.base
        rw [hqU_eq, hη_bot]; exact ⟨pt_R₀, rfl⟩
      obtain ⟨_, ⟨g, rfl⟩, hqU_g, hg_sub⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hqU_in_pre
      have hφg_ne : φ_U.hom g ≠ 0 := by
        intro hg0
        have hg_in : g ∈ q_U.asIdeal := by
          change φ_U.hom g ∈ (⊥ : Ideal L); rw [hg0]; exact Ideal.zero_mem _
        exact hqU_g hg_in
      let loc_g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_U (Localization.Away g)))
      have : AlgebraicGeometry.IsOpenImmersion loc_g :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
      have hRange_g : Set.range (loc_g ≫ hU.fromSpec).base ⊆ Set.range ι₀.base := by
        rintro _ ⟨p_loc, rfl⟩
        have hp_basic : loc_g.base p_loc ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum A_U)) := by
          rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
          exact ⟨p_loc, rfl⟩
        exact hg_sub hp_basic
      let ψ_sch := AlgebraicGeometry.IsOpenImmersion.lift ι₀ (loc_g ≫ hU.fromSpec) hRange_g
      have hψ_fac : ψ_sch ≫ ι₀ = loc_g ≫ hU.fromSpec :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι₀ (loc_g ≫ hU.fromSpec) hRange_g
      let α_R : R₀ →+* Localization.Away g := (AlgebraicGeometry.Spec.preimage ψ_sch).hom
      have hSpec_α : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_R) = ψ_sch :=
        AlgebraicGeometry.Spec.map_preimage ψ_sch
      let _ : Algebra A_U L := φ_U.hom.toAlgebra
      let φ_loc : Localization.Away g →+* L :=
        IsLocalization.Away.lift g (IsUnit.mk0 (φ_U.hom g) hφg_ne)
      have hφ_loc_eq : ∀ x : A_U, φ_loc (algebraMap A_U (Localization.Away g) x) = φ_U.hom x :=
        fun x => IsLocalization.Away.lift_eq g (IsUnit.mk0 (φ_U.hom g) hφg_ne) x
      have hφ_loc_comp : φ_loc.comp (algebraMap A_U (Localization.Away g)) = φ_U.hom :=
        RingHom.ext hφ_loc_eq
      have hφ_α_eq : ∀ r : R₀, φ_loc (α_R r) = φ₀ r := by
        have hSpec_eq :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_loc.comp α_R)) ≫ ι₀ =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι₀ := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_α,
            CategoryTheory.Category.assoc, hψ_fac, ← CategoryTheory.Category.assoc,
            show AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ loc_g =
              AlgebraicGeometry.Spec.map φ_U by
              dsimp only [loc_g]
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_loc_comp]
              rfl,
            hSpec_φU]
        have hMap_eq := (cancel_mono ι₀).mp hSpec_eq
        have hHom_eq := CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hMap_eq)
        exact fun r => congrArg (fun f : R₀ →+* L => f r) hHom_eq
      refine ⟨φ_U, ?_, hSpec_φU⟩
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨s, hs⟩
        have hs0 : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
        exact IsUnit.mk0 (φ_U.hom s) (fun h0 => hs0 (hInj_φU (h0.trans (map_zero _).symm)))
      · intro z
        let _ : Algebra R₀ L := φ₀.toAlgebra
        obtain ⟨⟨r₁, s_r⟩, hzr⟩ :=
          @IsLocalization.surj R₀ _ (nonZeroDivisors R₀) L _ φ₀.toAlgebra hFrac₀ z
        rcases s_r with ⟨r₂, hr₂⟩
        have hzr' : z * φ₀ r₂ = φ₀ r₁ := hzr
        have hr₂_ne : r₂ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hr₂
        have hφr₂_ne : φ₀ r₂ ≠ 0 := fun h0 => hr₂_ne (hInj_φ₀ (h0.trans (map_zero _).symm))
        obtain ⟨⟨a₁, s₁⟩, hm₁⟩ := IsLocalization.surj (Submonoid.powers g) (α_R r₁)
        rcases s₁ with ⟨_, m₁, rfl⟩
        obtain ⟨⟨a₂, s₂⟩, hm₂⟩ := IsLocalization.surj (Submonoid.powers g) (α_R r₂)
        rcases s₂ with ⟨_, m₂, rfl⟩
        have eq₁ : φ₀ r₁ * φ_U.hom (g ^ m₁) = φ_U.hom a₁ := by
          have h := congrArg φ_loc hm₁
          change φ_loc (α_R r₁ * algebraMap A_U (Localization.Away g) (g ^ m₁)) =
            φ_loc (algebraMap A_U (Localization.Away g) a₁) at h
          rwa [map_mul, hφ_α_eq r₁, hφ_loc_eq (g ^ m₁), hφ_loc_eq a₁] at h
        have eq₂ : φ₀ r₂ * φ_U.hom (g ^ m₂) = φ_U.hom a₂ := by
          have h := congrArg φ_loc hm₂
          change φ_loc (α_R r₂ * algebraMap A_U (Localization.Away g) (g ^ m₂)) =
            φ_loc (algebraMap A_U (Localization.Away g) a₂) at h
          rwa [map_mul, hφ_α_eq r₂, hφ_loc_eq (g ^ m₂), hφ_loc_eq a₂] at h
        have hgm₁_ne : φ_U.hom (g ^ m₁) ≠ 0 := by rw [map_pow]; exact pow_ne_zero m₁ hφg_ne
        have hgm₂_ne : φ_U.hom (g ^ m₂) ≠ 0 := by rw [map_pow]; exact pow_ne_zero m₂ hφg_ne
        have ha₂_ne : a₂ ≠ 0 := by
          intro ha₂0
          apply mul_ne_zero hφr₂_ne hgm₂_ne
          rw [eq₂, ha₂0, map_zero]
        have hden_nzd : a₂ * g ^ m₁ ∈ nonZeroDivisors A_U :=
          mem_nonZeroDivisors_of_ne_zero (mul_ne_zero ha₂_ne
            (fun hg0 => hgm₁_ne (by rw [hg0, map_zero])))
        refine ⟨(a₁ * g ^ m₂, ⟨a₂ * g ^ m₁, hden_nzd⟩), ?_⟩
        change z * φ_U.hom (a₂ * g ^ m₁) = φ_U.hom (a₁ * g ^ m₂)
        rw [map_mul, map_mul, ← eq₂, ← eq₁]
        calc z * (φ₀ r₂ * φ_U.hom (g ^ m₂) * φ_U.hom (g ^ m₁))
            = (z * φ₀ r₂) * φ_U.hom (g ^ m₁) * φ_U.hom (g ^ m₂) := by ring
          _ = φ₀ r₁ * φ_U.hom (g ^ m₁) * φ_U.hom (g ^ m₂) := by rw [hzr']
      · intro x y hxy
        exact ⟨1, by simp [hInj_φU hxy]⟩

    
    have hProjLine : ∀ (F : Type u) [Field F],
        AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom ∧
        AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver F 1).left ∧
        IsAffineNormalScheme (weilProjectiveSpaceOver F 1).left ∧
        (∃ j₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
            (weilProjectiveSpaceOver F 1).left,
          AlgebraicGeometry.IsOpenImmersion j₀ ∧
          j₀ ≫ (weilProjectiveSpaceOver F 1).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
          (IsAlgClosed F → ∀ (O : (weilProjectiveSpaceOver F 1).left.Opens),
            Nonempty ↥O → ∃ x₁ x₂ : ↥O, x₁ ≠ x₂) ∧
          (∀ (L : Type u) [Field L] [Algebra F L] (t : L),
            Transcendental F t →
            IntermediateField.adjoin F ({t} : Set L) = ⊤ →
            ∃ (η_P : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ (weilProjectiveSpaceOver F 1).left),
              η_P ≫ (weilProjectiveSpaceOver F 1).hom =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F L)) ∧
              IsSchemeFunctionField (weilProjectiveSpaceOver F 1).left L η_P)) := by
      intro F _
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let P_F : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
      let π_F : P_F ⟶ AlgebraicGeometry.Spec (CommRingCat.of F) :=
        AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥(𝒜 0)))
      have : IsScalarTower F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) :=
        ⟨fun c y z => smul_mul_assoc c y.1 z⟩
      have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) :=
        Algebra.FiniteType.of_restrictScalars_finiteType F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F)
      have hBij0 : Function.Bijective (algebraMap F ↥(𝒜 0)) := by
        refine ⟨(RingHom.injective_iff_ker_eq_bot _).2 ?_, fun y => ?_⟩
        · ext c
          simp only [RingHom.mem_ker, Ideal.mem_bot, Subtype.ext_iff]
          exact MvPolynomial.C_eq_zero
        · have hy : MvPolynomial.IsHomogeneous y.1 0 :=
            (MvPolynomial.mem_homogeneousSubmodule 0 y.1).1 y.2
          have htd : y.1.totalDegree = 0 := by
            rw [MvPolynomial.totalDegree]
            refine Finset.sup_eq_zero.2 fun d hd => ?_
            have hw := hy (MvPolynomial.mem_support_iff.1 hd)
            simpa [Finsupp.weight_apply, Finsupp.sum] using hw
          exact ⟨y.1.coeff 0, Subtype.ext (MvPolynomial.totalDegree_eq_zero_iff_eq_C.1 htd).symm⟩
      let e0 : F ≃+* ↥(𝒜 0) := RingEquiv.ofBijective _ hBij0
      have : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap F ↥(𝒜 0))) :=
        ⟨⟨CommRingCat.ofHom e0.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext fun x => e0.symm_apply_apply x),
          CommRingCat.hom_ext (RingHom.ext fun x => e0.apply_symm_apply x)⟩⟩
      have hPropPF : AlgebraicGeometry.IsProper π_F := inferInstance
      have hChart : ∀ a : Fin 2,
          ∃ j_a : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ P_F,
            AlgebraicGeometry.IsOpenImmersion j_a ∧
            Set.range j_a.base = (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) : Set ↥P_F) ∧
            j_a ≫ π_F = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
        intro a
        let x_a : MvPolynomial (Fin 2) F := MvPolynomial.X a
        have hx_a : x_a ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X F a
        let C_a := HomogeneousLocalization.Away 𝒜 x_a
        let ι_a : AlgebraicGeometry.Spec (CommRingCat.of C_a) ⟶ P_F :=
          AlgebraicGeometry.Proj.awayι 𝒜 x_a hx_a zero_lt_one
        let other : Fin 2 := 1 - a
        have h_other_ne : other ≠ a := by fin_cases a <;> decide
        let valHom : C_a →+* Localization.Away x_a :=
          { toFun := HomogeneousLocalization.val
            map_one' := HomogeneousLocalization.val_one
            map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
            map_zero' := HomogeneousLocalization.val_zero
            map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
        let c_map : F →+* C_a :=
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x_a)).comp
            (algebraMap F ↥(𝒜 0))
        have hx_other : MvPolynomial.X other ∈ 𝒜 (1 • 1) := by
          rw [one_smul]; exact MvPolynomial.isHomogeneous_X F other
        let t_el : C_a := HomogeneousLocalization.Away.mk 𝒜 hx_a 1 (MvPolynomial.X other) hx_other
        let φ_a : Polynomial F →+* C_a := Polynomial.eval₂RingHom c_map t_el
        let v_a : Fin 2 → Polynomial F := fun i => if i = a then 1 else Polynomial.X
        let ev_mv : MvPolynomial (Fin 2) F →+* Polynomial F := (MvPolynomial.aeval v_a).toRingHom
        have hev_xa : ev_mv x_a = 1 := by simp [ev_mv, x_a, v_a]
        have hev_units : ∀ y : Submonoid.powers x_a, IsUnit (ev_mv y.1) := by
          rintro ⟨_, n, rfl⟩
          rw [map_pow, hev_xa, one_pow]
          exact isUnit_one
        let ψ_loc : Localization.Away x_a →+* Polynomial F := IsLocalization.lift hev_units
        let ψ_a : C_a →+* Polynomial F := ψ_loc.comp valHom
        have h_val_cmap : ∀ r : F,
            valHom (c_map r) = algebraMap (MvPolynomial (Fin 2) F) (Localization.Away x_a)
              (MvPolynomial.C r) := by
          intro r
          change (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x_a)
            (algebraMap F ↥(𝒜 0) r)).val = _
          have h1 : (algebraMap F ↥(𝒜 0) r).1 = MvPolynomial.C r := by
            rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul_of_tower,
              SetLike.GradeZero.coe_one, Algebra.smul_def, mul_one]
            rfl
          change Localization.mk (algebraMap F ↥(𝒜 0) r).1 (1 : Submonoid.powers x_a) = _
          rw [h1, Localization.mk_eq_mk', IsLocalization.mk'_one]
        have h_ψ_φ : ψ_a.comp φ_a = RingHom.id (Polynomial F) := by
          apply Polynomial.ringHom_ext
          · intro r
            change ψ_loc (valHom (φ_a (Polynomial.C r))) = Polynomial.C r
            have hφC : φ_a (Polynomial.C r) = c_map r := Polynomial.eval₂_C c_map t_el
            rw [hφC, h_val_cmap, IsLocalization.lift_eq]
            simp [ev_mv, Polynomial.algebraMap_eq]
          · change ψ_loc (valHom (φ_a Polynomial.X)) = Polynomial.X
            have hφX : φ_a Polynomial.X = t_el := Polynomial.eval₂_X c_map t_el
            rw [hφX]
            change ψ_loc (HomogeneousLocalization.Away.mk 𝒜 hx_a 1 (MvPolynomial.X other) hx_other).val = _
            rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
            apply (IsLocalization.lift_mk'_spec _ _ _ _).mpr
            change ev_mv (MvPolynomial.X other) = ev_mv (x_a ^ 1) * Polynomial.X
            rw [pow_one, hev_xa, one_mul]
            simp [ev_mv, v_a, h_other_ne]
        have h_φ_ψ : φ_a.comp ψ_a = RingHom.id C_a := by
          apply RingHom.ext
          intro z
          apply HomogeneousLocalization.val_injective (Submonoid.powers x_a)
          change valHom (φ_a (ψ_a z)) = valHom z
          let h_loc : MvPolynomial (Fin 2) F →+* Localization.Away x_a :=
            (valHom.comp φ_a).comp ev_mv
          let u_inv : Localization.Away x_a := IsLocalization.Away.invSelf x_a
          have hh_C : ∀ r : F, h_loc (MvPolynomial.C r) =
              algebraMap (MvPolynomial (Fin 2) F) (Localization.Away x_a) (MvPolynomial.C r) := by
            intro r
            change valHom (φ_a (ev_mv (MvPolynomial.C r))) = _
            have hevC : ev_mv (MvPolynomial.C r) = Polynomial.C r := by
              simp [ev_mv, Polynomial.algebraMap_eq]
            rw [hevC, show φ_a (Polynomial.C r) = c_map r from Polynomial.eval₂_C c_map t_el, h_val_cmap]
          have hh_X : ∀ i : Fin 2, h_loc (MvPolynomial.X i) =
              algebraMap (MvPolynomial (Fin 2) F) (Localization.Away x_a) (MvPolynomial.X i) * u_inv := by
            intro i
            by_cases hia : i = a
            · subst hia
              change valHom (φ_a (ev_mv x_a)) = _
              rw [hev_xa, map_one, map_one]
              exact (IsLocalization.Away.mul_invSelf x_a).symm
            · have hi_oth : i = other := by fin_cases a <;> fin_cases i <;> first | contradiction | rfl
              subst hi_oth
              change valHom (φ_a (ev_mv (MvPolynomial.X other))) = _
              have hevO : ev_mv (MvPolynomial.X other) = Polynomial.X := by simp [ev_mv, v_a, h_other_ne]
              rw [hevO, show φ_a Polynomial.X = t_el from Polynomial.eval₂_X c_map t_el]
              change (HomogeneousLocalization.Away.mk 𝒜 hx_a 1 (MvPolynomial.X other) hx_other).val = _
              rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
                IsLocalization.mk'_eq_iff_eq_mul]
              change algebraMap _ (Localization.Away x_a) (MvPolynomial.X other) =
                algebraMap _ (Localization.Away x_a) (MvPolynomial.X other) * u_inv *
                  algebraMap _ (Localization.Away x_a) (x_a ^ 1)
              rw [pow_one, mul_assoc, mul_comm u_inv _, IsLocalization.Away.mul_invSelf x_a, mul_one]
          have hh_homog : ∀ (d : ℕ) (f : MvPolynomial (Fin 2) F), f ∈ 𝒜 d →
              h_loc f = algebraMap _ (Localization.Away x_a) f * u_inv ^ d := by
            intro d f hf
            rw [MvPolynomial.mem_homogeneousSubmodule] at hf
            conv_lhs => rw [f.as_sum]
            conv_rhs => rw [f.as_sum]
            rw [map_sum, map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl fun m hm => ?_
            have hm_deg : m 0 + m 1 = d := by
              have := hf (MvPolynomial.mem_support_iff.mp hm)
              simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using this
            rw [MvPolynomial.monomial_eq, map_mul, map_mul, hh_C,
              Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two,
              map_mul, map_mul, map_pow, map_pow, map_pow, map_pow, hh_X 0, hh_X 1,
              mul_pow, mul_pow, ← hm_deg, pow_add]
            ring
          obtain ⟨w, rfl⟩ :
              ∃ w : HomogeneousLocalization.NumDenSameDeg 𝒜 (Submonoid.powers x_a),
                HomogeneousLocalization.mk w = z :=
            Quotient.exists_rep z
          obtain ⟨n, hn⟩ := w.den_mem
          have hn' : x_a ^ n = w.den.1 := hn
          have hψ_mk : ψ_a (HomogeneousLocalization.mk w) = ev_mv w.num.1 := by
            change ψ_loc (HomogeneousLocalization.mk w).val = ev_mv w.num.1
            rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
            apply (IsLocalization.lift_mk'_spec _ _ _ _).mpr
            change ev_mv w.num.1 = ev_mv w.den.1 * ev_mv w.num.1
            have hev_g : ev_mv w.den.1 = 1 := by rw [← hn', map_pow, hev_xa, one_pow]
            rw [hev_g, one_mul]
          change valHom (φ_a (ψ_a (HomogeneousLocalization.mk w))) = _
          rw [hψ_mk]
          change h_loc w.num.1 = (HomogeneousLocalization.mk w).val
          rw [hh_homog w.deg w.num.1 w.num.2, HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
          have hg_unit_eq : algebraMap _ (Localization.Away x_a) w.den.1 * u_inv ^ w.deg = 1 := by
            rw [← hh_homog w.deg w.den.1 w.den.2, ← hn', map_pow]
            have hh_xa : h_loc x_a = 1 := by
              change valHom (φ_a (ev_mv x_a)) = 1
              rw [hev_xa, map_one, map_one]
            rw [hh_xa, one_pow]
          symm
          rw [IsLocalization.mk'_eq_iff_eq_mul]
          change algebraMap _ (Localization.Away x_a) w.num.1 =
            algebraMap _ (Localization.Away x_a) w.num.1 * u_inv ^ w.deg *
              algebraMap _ (Localization.Away x_a) w.den.1
          rw [mul_assoc, mul_comm (u_inv ^ w.deg) _, hg_unit_eq, mul_one]
        let e_a : Polynomial F ≃+* C_a :=
          { toFun := φ_a
            invFun := ψ_a
            left_inv := fun x => congrArg (fun f : Polynomial F →+* Polynomial F => f x) h_ψ_φ
            right_inv := fun x => congrArg (fun f : C_a →+* C_a => f x) h_φ_ψ
            map_mul' := φ_a.map_mul
            map_add' := φ_a.map_add }
        have : CategoryTheory.IsIso (CommRingCat.ofHom e_a.symm.toRingHom) :=
          ⟨⟨CommRingCat.ofHom e_a.toRingHom,
            CommRingCat.hom_ext (RingHom.ext fun x => e_a.apply_symm_apply x),
            CommRingCat.hom_ext (RingHom.ext fun x => e_a.symm_apply_apply x)⟩⟩
        let spec_ea := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_a.symm.toRingHom)
        have : CategoryTheory.IsIso spec_ea := inferInstance
        let j_a : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ P_F := spec_ea ≫ ι_a
        have hOpen_ja : AlgebraicGeometry.IsOpenImmersion j_a :=
          AlgebraicGeometry.IsOpenImmersion.comp spec_ea ι_a
        have hRange_ja :
            Set.range j_a.base = (AlgebraicGeometry.Proj.basicOpen 𝒜 x_a : Set ↥P_F) := by
          dsimp only [j_a]
          change Set.range (ι_a.base ∘ spec_ea.base) = _
          rw [Set.range_comp,
            (ConcreteCategory.bijective_of_isIso spec_ea.base).2.range_eq,
            Set.image_univ]
          exact congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 x_a hx_a zero_lt_one)
        have hComm_ja : j_a ≫ π_F = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
          dsimp only [j_a, spec_ea, ι_a, π_F]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
            (AlgebraicGeometry.Proj.awayι 𝒜 x_a hx_a zero_lt_one),
            AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 x_a hx_a zero_lt_one,
            ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          congr 2
          apply RingHom.ext
          intro r
          change ψ_a (c_map r) = Polynomial.C r
          have hc : c_map r = φ_a (Polynomial.C r) := (Polynomial.eval₂_C c_map t_el).symm
          rw [hc]
          exact congrArg (fun f : Polynomial F →+* Polynomial F => f (Polynomial.C r)) h_ψ_φ
        exact ⟨j_a, hOpen_ja, hRange_ja, hComm_ja⟩
      choose j_a hj_open hj_range hj_comm using hChart
      have hCover : (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥P_F) ∪
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) : Set ↥P_F) = Set.univ := by
        rw [Set.eq_univ_iff_forall]
        intro p
        by_contra hnot
        rw [Set.mem_union, not_or] at hnot
        let p' : ProjectiveSpectrum 𝒜 := p
        have h0 : MvPolynomial.X (0 : Fin 2) ∈ p'.asHomogeneousIdeal :=
          not_not.mp ((ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X 0) p').not.mp hnot.1)
        have h1 : MvPolynomial.X (1 : Fin 2) ∈ p'.asHomogeneousIdeal :=
          not_not.mp ((ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X 1) p').not.mp hnot.2)
        apply p'.not_irrelevant_le
        intro g hg
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hg
        rw [g.as_sum]
        refine Ideal.sum_mem p'.asHomogeneousIdeal.toIdeal fun m hm => ?_
        have hm_ne0 : m ≠ 0 := by
          intro hm0
          subst hm0
          have hc0 : (DirectSum.decompose 𝒜 g 0 : MvPolynomial (Fin 2) F).coeff 0 = 0 := by
            rw [hg]; simp
          have hdecomp_coeff :
              (DirectSum.decompose 𝒜 g 0 : MvPolynomial (Fin 2) F).coeff 0 = g.coeff 0 := by
            have hsum := (DirectSum.sum_support_decompose 𝒜 g).symm
            conv_rhs => rw [hsum]
            rw [MvPolynomial.coeff_sum]
            rw [Finset.sum_eq_single 0]
            · intro n _ hn0
              have hn_hom := (MvPolynomial.mem_homogeneousSubmodule n _).mp
