      K m V P hPkg_VP hMax_VP ϖ hϖ_P hϖ_mem hOpen_VP U_ss g_ss hSS u₀ hu₀_cl hu₀_P
  let R₁ : CommRingCat.{u} := U_ss.presheaf.obj (Opposite.op W₁)
  let B₁ : Type u := ↑R₁
  let p₀ : PrimeSpectrum B₁ := hW₁.primeIdealOf ⟨u₀, hu₀₁⟩
  have hCore : ∀ (A₀ : Type u) [CommRing A₀]
