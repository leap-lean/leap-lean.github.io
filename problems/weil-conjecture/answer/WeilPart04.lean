theorem weil_p1_regular_quotient_gluing_section_contradiction (R κ : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [Field κ]
    (q_R : R →+* κ)
    (hq_surj : Function.Surjective q_R)
    (hq_ker : RingHom.ker q_R = IsLocalRing.maximalIdeal R)
    (X_0 Z_sch : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X_0] [AlgebraicGeometry.IsIntegral Z_sch]
    (g_X0 : X_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [AlgebraicGeometry.Flat g_X0]
    (p_Z : Z_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of κ))
    (hp_bij : Function.Bijective (p_Z.appTop).hom)
    (j_Z : Z_sch ⟶ X_0)
    (hj_comm : j_Z ≫ g_X0 = p_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R))
    (σ_0 : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X_0)
    (hσ_sec : σ_0 ≫ g_X0 = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)))
    (z_0 : ↥Z_sch)
    (hz0_eq : j_Z.base z_0 =
      σ_0.base ⟨IsLocalRing.maximalIdeal R, (IsLocalRing.maximalIdeal.isMaximal R).isPrime⟩)
    (π_b : R) (hπ_max : π_b ∈ IsLocalRing.maximalIdeal R) (hπ_ne : π_b ≠ 0)
    (b : ↑(X_0.presheaf.obj (Opposite.op ⊤)))
    (hb_σ0 : (σ_0.appTop).hom b = 0)
    (V_0 : X_0.Opens) (hV0_aff : AlgebraicGeometry.IsAffineOpen V_0)
    (z_η : ↥Z_sch) (hzη_mem : j_Z.base z_η ∈ V_0)
    (s_0 w_0 : ↑(X_0.presheaf.obj (Opposite.op V_0)))
    (hs0 : s_0 ∉ (hV0_aff.isoSpec.hom.base ⟨j_Z.base z_η, hzη_mem⟩).asIdeal)
    (hw0 : w_0 ∉ (hV0_aff.isoSpec.hom.base ⟨j_Z.base z_η, hzη_mem⟩).asIdeal)
    (h_gen : s_0 * (X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b =
      (g_X0.appLE ⊤ V_0 le_top).hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom π_b) * w_0)
    (h_reg : ∀ z : ↥Z_sch, ∃ (V_z : X_0.Opens) (hVz_aff : AlgebraicGeometry.IsAffineOpen V_z)
        (hz_mem : j_Z.base z ∈ V_z)
        (u_z q_z : ↑(X_0.presheaf.obj (Opposite.op V_z))),
      u_z ∉ (hVz_aff.isoSpec.hom.base ⟨j_Z.base z, hz_mem⟩).asIdeal ∧
      u_z * (X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b =
        (g_X0.appLE ⊤ V_z le_top).hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom π_b) * q_z) :
    False :=
by
  classical
  
  have hMemBasic : ∀ {V_sub : X_0.Opens} (hV : AlgebraicGeometry.IsAffineOpen V_sub)
      (x : ↥V_sub) (f : ↑(X_0.presheaf.obj (Opposite.op V_sub))),
      x.1 ∈ X_0.basicOpen f ↔ f ∉ (hV.isoSpec.hom.base x).asIdeal := by
    intro V_sub hV x f
    let p := hV.isoSpec.hom.base x
    have hp_base : hV.fromSpec.base p = x.1 := by
      change (hV.isoSpec.hom ≫ hV.fromSpec).base x = x.1
      rw [← hV.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
      rfl
    change x.1 ∈ X_0.basicOpen f ↔ f ∉ p.asIdeal
    rw [← hp_base, ← PrimeSpectrum.mem_basicOpen f p, ← hV.fromSpec_preimage_basicOpen f]
    rfl

  
  let e_R := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)
  let R_top := ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op ⊤))
  let π_top : R_top := e_R.inv.hom π_b
  have heR_inj : Function.Injective e_R.hom.hom :=
    (ConcreteCategory.bijective_of_isIso e_R.hom).1
  have hDom_Rtop : IsDomain R_top :=
    Function.Injective.isDomain e_R.hom.hom heR_inj
  have hπ_top_ne : π_top ≠ 0 := by
    intro h0
    apply hπ_ne
    have h1 : (e_R.inv ≫ e_R.hom).hom π_b = 0 := by
      change e_R.hom.hom π_top = 0
      rw [h0, map_zero]
    rw [e_R.inv_hom_id] at h1
    exact h1
  have hπ_nzd : π_top ∈ nonZeroDivisors R_top := by
    let _ : IsDomain R_top := hDom_Rtop
    exact mem_nonZeroDivisors_iff_ne_zero.mpr hπ_top_ne

  have hCross : ∀ (V_1 V_2 : X_0.Opens) (h_ne : Nonempty ↥(V_1 ⊓ V_2))
      (u_1 q_1 : ↑(X_0.presheaf.obj (Opposite.op V_1)))
      (u_2 q_2 : ↑(X_0.presheaf.obj (Opposite.op V_2))),
      u_1 * (X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b =
        (g_X0.appLE ⊤ V_1 le_top).hom π_top * q_1 →
      u_2 * (X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b =
        (g_X0.appLE ⊤ V_2 le_top).hom π_top * q_2 →
      (X_0.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom u_2 *
          (X_0.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom q_1 =
        (X_0.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom u_1 *
          (X_0.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom q_2 := by
    intro V_1 V_2 h_ne u_1 q_1 u_2 q_2 h_eq1 h_eq2
    let V_12 : X_0.Opens := V_1 ⊓ V_2
    let A_12 := ↑(X_0.presheaf.obj (Opposite.op V_12))
    have hDom_12 : IsDomain A_12 :=
      @AlgebraicGeometry.IsIntegral.component_integral X_0 _ V_12 h_ne
    obtain ⟨⟨x, hx⟩⟩ := h_ne
    obtain ⟨W, hW_aff, hxW, hW_le⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := V_12) (x := x) hx
    have hW_ne : Nonempty ↥W := ⟨⟨x, hxW⟩⟩
    let A_W := ↑(X_0.presheaf.obj (Opposite.op W))
    have hDom_W : IsDomain A_W :=
      @AlgebraicGeometry.IsIntegral.component_integral X_0 _ W hW_ne
    have hAff_SpecR : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of R))
    have hFlat_W : ((g_X0.appLE ⊤ W le_top).hom).Flat :=
      AlgebraicGeometry.Flat.flat_appLE g_X0 hAff_SpecR hW_aff le_top
    have hρW_ne : (g_X0.appLE ⊤ W le_top).hom π_top ≠ 0 := by
      let _ : Algebra R_top A_W := ((g_X0.appLE ⊤ W le_top).hom).toAlgebra
      have _ : Module.Flat R_top A_W := RingHom.flat_algebraMap_iff.mp hFlat_W
      have hReg : IsSMulRegular A_W π_top :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors hπ_nzd
      intro h0
      have h_smul : π_top • (1 : A_W) = π_top • (0 : A_W) := by
        rw [Algebra.smul_def, mul_one, smul_zero]
        exact h0
      exact one_ne_zero (hReg h_smul)
    let π_12 : A_12 := (g_X0.appLE ⊤ V_12 le_top).hom π_top
    have hπ12_ne : π_12 ≠ 0 := by
      intro h0
      apply hρW_ne
      have h_res := AlgebraicGeometry.Scheme.Hom.appLE_map g_X0 (U := ⊤) (V := V_12)
        (V' := W) le_top (CategoryTheory.homOfLE hW_le).op
      have h_eval : ((g_X0.appLE ⊤ V_12 le_top ≫
          X_0.presheaf.map (CategoryTheory.homOfLE hW_le).op).hom) π_top =
          (g_X0.appLE ⊤ W le_top).hom π_top := by
        rw [h_res]
      rw [← h_eval]
      change (X_0.presheaf.map (CategoryTheory.homOfLE hW_le).op).hom π_12 = 0
      rw [h0, map_zero]
    let res_1 := (X_0.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_12 ≤ V_1)).op).hom
    let res_2 := (X_0.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_12 ≤ V_2)).op).hom
    let b_12 : A_12 := (X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V_12 ≤ ⊤)).op).hom b
    have hb1 : res_1 ((X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b) = b_12 := by
      change (X_0.presheaf.map (CategoryTheory.homOfLE le_top).op ≫
        X_0.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom b = b_12
      rw [← CategoryTheory.Functor.map_comp]
      rfl
    have hb2 : res_2 ((X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b) = b_12 := by
      change (X_0.presheaf.map (CategoryTheory.homOfLE le_top).op ≫
        X_0.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom b = b_12
      rw [← CategoryTheory.Functor.map_comp]
      rfl
    have hπ1 : res_1 ((g_X0.appLE ⊤ V_1 le_top).hom π_top) = π_12 := by
      have h_res := AlgebraicGeometry.Scheme.Hom.appLE_map g_X0 (U := ⊤) (V := V_1)
        (V' := V_12) le_top (CategoryTheory.homOfLE inf_le_left).op
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_res) π_top
    have hπ2 : res_2 ((g_X0.appLE ⊤ V_2 le_top).hom π_top) = π_12 := by
      have h_res := AlgebraicGeometry.Scheme.Hom.appLE_map g_X0 (U := ⊤) (V := V_2)
        (V' := V_12) le_top (CategoryTheory.homOfLE inf_le_right).op
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_res) π_top
    have h1' : res_1 u_1 * b_12 = π_12 * res_1 q_1 := by
      have := congrArg res_1 h_eq1
      simp only [map_mul, hb1, hπ1] at this
      exact this
    have h2' : res_2 u_2 * b_12 = π_12 * res_2 q_2 := by
      have := congrArg res_2 h_eq2
      simp only [map_mul, hb2, hπ2] at this
      exact this
    apply mul_left_cancel₀ hπ12_ne
    calc
      π_12 * (res_2 u_2 * res_1 q_1) = res_2 u_2 * (π_12 * res_1 q_1) := by ring
      _ = res_2 u_2 * (res_1 u_1 * b_12) := by rw [← h1']
      _ = res_1 u_1 * (res_2 u_2 * b_12) := by ring
      _ = res_1 u_1 * (π_12 * res_2 q_2) := by rw [h2']
      _ = π_12 * (res_1 u_1 * res_2 q_2) := by ring

  
  choose V hV_aff hz_mem u q hu h_eq using h_reg
  let Ω : ↥Z_sch → Z_sch.Opens :=
    fun z => Z_sch.basicOpen ((j_Z.app (V z)).hom (u z))
  have hΩ_le : ∀ z : ↥Z_sch, Ω z ≤ (TopologicalSpace.Opens.map j_Z.base).obj (V z) :=
    fun z => Z_sch.basicOpen_le ((j_Z.app (V z)).hom (u z))
  have hz_Ω : ∀ z : ↥Z_sch, z ∈ Ω z := by
    intro z
    change z ∈ Z_sch.basicOpen ((j_Z.app (V z)).hom (u z))
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen j_Z (u z)]
    change j_Z.base z ∈ X_0.basicOpen (u z)
    exact (hMemBasic (hV_aff z) ⟨j_Z.base z, hz_mem z⟩ (u z)).mpr (hu z)
  have h_cov : (⊤ : Z_sch.Opens) ≤ iSup Ω := by
    intro z _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hz_Ω z⟩
  let u_tilde : ∀ z : ↥Z_sch, ↑(Z_sch.presheaf.obj (Opposite.op (Ω z))) :=
    fun z => (j_Z.appLE (V z) (Ω z) (hΩ_le z)).hom (u z)
  let q_tilde : ∀ z : ↥Z_sch, ↑(Z_sch.presheaf.obj (Opposite.op (Ω z))) :=
    fun z => (j_Z.appLE (V z) (Ω z) (hΩ_le z)).hom (q z)
  have hu_unit : ∀ z : ↥Z_sch, IsUnit (u_tilde z) := by
    intro z
    have h_eq_u : u_tilde z =
        (Z_sch.presheaf.map (CategoryTheory.homOfLE (hΩ_le z)).op).hom
          ((j_Z.app (V z)).hom (u z)) := by
      change (j_Z.appLE (V z) (Ω z) (hΩ_le z)).hom (u z) =
        (j_Z.app (V z) ≫ Z_sch.presheaf.map (CategoryTheory.homOfLE (hΩ_le z)).op).hom (u z)
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
    rw [h_eq_u]
    exact AlgebraicGeometry.RingedSpace.isUnit_res_basicOpen Z_sch.toRingedSpace
      ((j_Z.app (V z)).hom (u z))
  let φ : ∀ z : ↥Z_sch, ↑(Z_sch.presheaf.obj (Opposite.op (Ω z))) :=
    fun z => ↑(hu_unit z).unit⁻¹ * q_tilde z
  have hφ_mul : ∀ z : ↥Z_sch, u_tilde z * φ z = q_tilde z := by
    intro z
    change u_tilde z * (↑(hu_unit z).unit⁻¹ * q_tilde z) = q_tilde z
    rw [← mul_assoc, IsUnit.mul_val_inv, one_mul]
  have hφ_compat : TopCat.Presheaf.IsCompatible Z_sch.sheaf.obj Ω φ := by
    intro z_1 z_2
    let Ω_12 : Z_sch.Opens := Ω z_1 ⊓ Ω z_2
    by_cases h_ne12 : Nonempty ↥Ω_12
    · obtain ⟨⟨w, hw1, hw2⟩⟩ := h_ne12
      have hV12_ne : Nonempty ↥(V z_1 ⊓ V z_2) :=
        ⟨⟨j_Z.base w, hΩ_le z_1 hw1, hΩ_le z_2 hw2⟩⟩
      have h_cross_12 :=
        hCross (V z_1) (V z_2) hV12_ne (u z_1) (q z_1) (u z_2) (q z_2) (h_eq z_1) (h_eq z_2)
      have e_12 : Ω_12 ≤ (TopologicalSpace.Opens.map j_Z.base).obj (V z_1 ⊓ V z_2) :=
        fun y hy => ⟨hΩ_le z_1 hy.1, hΩ_le z_2 hy.2⟩
      have h_pull := congrArg (j_Z.appLE (V z_1 ⊓ V z_2) Ω_12 e_12).hom h_cross_12
      simp only [map_mul] at h_pull
      let resΩ_1 :=
        (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Ω_12 ≤ Ω z_1)).op).hom
      let resΩ_2 :=
        (Z_sch.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Ω_12 ≤ Ω z_2)).op).hom
      have hp_left : ∀ s : ↑(X_0.presheaf.obj (Opposite.op (V z_1))),
          (j_Z.appLE (V z_1 ⊓ V z_2) Ω_12 e_12).hom
            ((X_0.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom s) =
          resΩ_1 ((j_Z.appLE (V z_1) (Ω z_1) (hΩ_le z_1)).hom s) := by
        intro s
        change (X_0.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫
            j_Z.appLE (V z_1 ⊓ V z_2) Ω_12 e_12).hom s =
          (j_Z.appLE (V z_1) (Ω z_1) (hΩ_le z_1) ≫
            Z_sch.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom s
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      have hp_right : ∀ s : ↑(X_0.presheaf.obj (Opposite.op (V z_2))),
          (j_Z.appLE (V z_1 ⊓ V z_2) Ω_12 e_12).hom
            ((X_0.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom s) =
          resΩ_2 ((j_Z.appLE (V z_2) (Ω z_2) (hΩ_le z_2)).hom s) := by
        intro s
        change (X_0.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫
            j_Z.appLE (V z_1 ⊓ V z_2) Ω_12 e_12).hom s =
          (j_Z.appLE (V z_2) (Ω z_2) (hΩ_le z_2) ≫
            Z_sch.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom s
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      rw [hp_right (u z_2), hp_left (q z_1), hp_left (u z_1), hp_right (q z_2)] at h_pull
      change resΩ_2 (u_tilde z_2) * resΩ_1 (q_tilde z_1) =
        resΩ_1 (u_tilde z_1) * resΩ_2 (q_tilde z_2) at h_pull
      have hq1_Ω : resΩ_1 (q_tilde z_1) = resΩ_1 (u_tilde z_1) * resΩ_1 (φ z_1) := by
        rw [← hφ_mul z_1, map_mul]
      have hq2_Ω : resΩ_2 (q_tilde z_2) = resΩ_2 (u_tilde z_2) * resΩ_2 (φ z_2) := by
        rw [← hφ_mul z_2, map_mul]
      rw [hq1_Ω, hq2_Ω] at h_pull
      have h_unit_prod : IsUnit (resΩ_1 (u_tilde z_1) * resΩ_2 (u_tilde z_2)) :=
        ((hu_unit z_1).map resΩ_1).mul ((hu_unit z_2).map resΩ_2)
      apply h_unit_prod.mul_left_cancel
      calc
        (resΩ_1 (u_tilde z_1) * resΩ_2 (u_tilde z_2)) * resΩ_1 (φ z_1)
            = resΩ_2 (u_tilde z_2) * (resΩ_1 (u_tilde z_1) * resΩ_1 (φ z_1)) := by ring
        _ = resΩ_1 (u_tilde z_1) * (resΩ_2 (u_tilde z_2) * resΩ_2 (φ z_2)) := h_pull
        _ = (resΩ_1 (u_tilde z_1) * resΩ_2 (u_tilde z_2)) * resΩ_2 (φ z_2) := by ring
    · have h_le_bot : Ω_12 ≤ ⊥ := by
        intro w hw
        exact False.elim (h_ne12 ⟨w, hw⟩)
      let r_to_bot := (Z_sch.presheaf.map (CategoryTheory.homOfLE (bot_le : ⊥ ≤ Ω_12)).op).hom
      let r_from_bot := (Z_sch.presheaf.map (CategoryTheory.homOfLE h_le_bot).op).hom
      have h_id : ∀ x : ↑(Z_sch.presheaf.obj (Opposite.op Ω_12)),
          r_from_bot (r_to_bot x) = x := by
        intro x
        change (Z_sch.presheaf.map (CategoryTheory.homOfLE bot_le).op ≫
          Z_sch.presheaf.map (CategoryTheory.homOfLE h_le_bot).op).hom x = x
        rw [← CategoryTheory.Functor.map_comp]
        have h_op_id : (CategoryTheory.homOfLE bot_le).op ≫ (CategoryTheory.homOfLE h_le_bot).op =
            𝟙 (Opposite.op Ω_12) := Subsingleton.elim _ _
        rw [h_op_id, CategoryTheory.Functor.map_id]
        rfl
      exact (h_id _).symm.trans ((congrArg r_from_bot (Subsingleton.elim _ _)).trans (h_id _))

  obtain ⟨φ_glob, hφ_glob, _⟩ :=
    Z_sch.sheaf.existsUnique_gluing' Ω ⊤ (fun _ => CategoryTheory.homOfLE le_top) h_cov φ hφ_compat
  obtain ⟨κ_top, hκ_top⟩ := hp_bij.2 φ_glob
  let e_κ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of κ)
  let c : κ := e_κ.hom.hom κ_top
  have hc_inv : e_κ.inv.hom c = κ_top := by
    change (e_κ.hom ≫ e_κ.inv).hom κ_top = κ_top
    rw [e_κ.hom_inv_id]
    rfl
  have hc_vanish : ∀ (r : R), q_R r = c → ∀ z : ↥Z_sch,
      q z - u z * (g_X0.appLE ⊤ (V z) le_top).hom (e_R.inv.hom r) ∈
        ((hV_aff z).isoSpec.hom.base ⟨j_Z.base z, hz_mem z⟩).asIdeal := by
    intro r hr z
    have h_nat_q : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)).appTop).hom
        (e_R.inv.hom r) = e_κ.inv.hom c := by
      have h_nat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom q_R)
      have h_inv : e_R.inv ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)).appTop =
          CommRingCat.ofHom q_R ≫ e_κ.inv := by
        rw [← CategoryTheory.cancel_mono e_κ.hom, CategoryTheory.Category.assoc, h_nat,
          e_R.inv_hom_id_assoc, CategoryTheory.Category.assoc, e_κ.inv_hom_id,
          CategoryTheory.Category.comp_id]
      have h_eval := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_inv) r
      change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)).appTop).hom (e_R.inv.hom r) =
        e_κ.inv.hom (q_R r) at h_eval
      rw [hr] at h_eval
      exact h_eval
    have hφ_eq_r : φ_glob = (j_Z.appTop).hom ((g_X0.appTop).hom (e_R.inv.hom r)) := by
      have h_comm_top := congrArg AlgebraicGeometry.Scheme.Hom.appTop hj_comm
      simp only [AlgebraicGeometry.Scheme.Hom.comp_appTop] at h_comm_top
      have h_eval := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_comm_top) (e_R.inv.hom r)
      change (j_Z.appTop).hom ((g_X0.appTop).hom (e_R.inv.hom r)) =
        (p_Z.appTop).hom (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)).appTop).hom
          (e_R.inv.hom r)) at h_eval
      rw [h_nat_q, hc_inv, hκ_top] at h_eval
      exact h_eval.symm
    let r_Vz := (g_X0.appLE ⊤ (V z) le_top).hom (e_R.inv.hom r)
    have hr_Ω : (j_Z.appLE (V z) (Ω z) (hΩ_le z)).hom r_Vz = φ z := by
      rw [← hφ_glob z, hφ_eq_r]
      change (g_X0.appLE ⊤ (V z) le_top ≫ j_Z.appLE (V z) (Ω z) (hΩ_le z)).hom (e_R.inv.hom r) =
        (g_X0.appTop ≫ j_Z.appTop ≫
          Z_sch.presheaf.map (CategoryTheory.homOfLE le_top).op).hom (e_R.inv.hom r)
      have h1 : g_X0.appLE ⊤ (V z) le_top ≫ j_Z.appLE (V z) (Ω z) (hΩ_le z) =
          g_X0.appTop ≫ j_Z.appLE ⊤ (Ω z) le_top := by
        change (g_X0.appTop ≫ X_0.presheaf.map (CategoryTheory.homOfLE le_top).op) ≫
          j_Z.appLE (V z) (Ω z) (hΩ_le z) = _
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.map_appLE]
      have h2 : j_Z.appTop ≫ Z_sch.presheaf.map (CategoryTheory.homOfLE le_top).op =
          j_Z.appLE ⊤ (Ω z) le_top := rfl
      rw [h1, h2]
    let d_z := q z - u z * r_Vz
    have hd_zero : (j_Z.appLE (V z) (Ω z) (hΩ_le z)).hom d_z = 0 := by
      simp only [d_z, map_sub, map_mul, hr_Ω]
      change q_tilde z - u_tilde z * φ z = 0
      rw [hφ_mul z, sub_self]
    have h_bo := AlgebraicGeometry.Scheme.basicOpen_appLE j_Z (Ω z) (V z) (hΩ_le z) d_z
    rw [hd_zero, Z_sch.basicOpen_zero] at h_bo
    have hz_not_bo : j_Z.base z ∉ X_0.basicOpen d_z := by
      intro hz_in
      have hz_bot : z ∈ (⊥ : Z_sch.Opens) := by
        rw [h_bo]
        exact ⟨hz_Ω z, hz_in⟩
      exact hz_bot
    exact not_not.mp ((hMemBasic (hV_aff z) ⟨j_Z.base z, hz_mem z⟩ d_z).not.mp hz_not_bo)

  
  by_cases hc0 : c = 0
  · have hq_η : q z_η ∈ ((hV_aff z_η).isoSpec.hom.base ⟨j_Z.base z_η, hz_mem z_η⟩).asIdeal := by
      have h0 := hc_vanish 0 (by rw [map_zero, hc0]) z_η
      simpa only [map_zero, mul_zero, sub_zero] using h0
    let V_0η : X_0.Opens := V_0 ⊓ V z_η
    have hzη_0η : j_Z.base z_η ∈ V_0η := ⟨hzη_mem, hz_mem z_η⟩
    have h_ne_0η : Nonempty ↥V_0η := ⟨⟨j_Z.base z_η, hzη_0η⟩⟩
    have h_eq_0η :=
      hCross V_0 (V z_η) h_ne_0η s_0 w_0 (u z_η) (q z_η) h_gen (h_eq z_η)
    have hu_bo : j_Z.base z_η ∈ X_0.basicOpen (u z_η) :=
      (hMemBasic (hV_aff z_η) ⟨j_Z.base z_η, hz_mem z_η⟩ (u z_η)).mpr (hu z_η)
    have hw_bo : j_Z.base z_η ∈ X_0.basicOpen w_0 :=
      (hMemBasic hV0_aff ⟨j_Z.base z_η, hzη_mem⟩ w_0).mpr hw0
    have hq_not_bo : j_Z.base z_η ∉ X_0.basicOpen (q z_η) :=
      fun h => (hMemBasic (hV_aff z_η) ⟨j_Z.base z_η, hz_mem z_η⟩ (q z_η)).mp h hq_η
    have h_lhs_bo : j_Z.base z_η ∈
        X_0.basicOpen
          ((X_0.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_0η ≤ V z_η)).op).hom (u z_η) *
            (X_0.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_0η ≤ V_0)).op).hom w_0) := by
      rw [X_0.basicOpen_mul, X_0.basicOpen_res, X_0.basicOpen_res]
      exact ⟨⟨hzη_0η, hu_bo⟩, ⟨hzη_0η, hw_bo⟩⟩
    rw [h_eq_0η, X_0.basicOpen_mul, X_0.basicOpen_res, X_0.basicOpen_res] at h_lhs_bo
    exact hq_not_bo h_lhs_bo.2.2
  · obtain ⟨r_c, hr_c⟩ := hq_surj c
    have hrc_not_max : r_c ∉ IsLocalRing.maximalIdeal R := by
      intro hm
      rw [← hq_ker, RingHom.mem_ker, hr_c] at hm
      exact hc0 hm
    let m_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      ⟨IsLocalRing.maximalIdeal R, (IsLocalRing.maximalIdeal.isMaximal R).isPrime⟩
    have hσ_mem : σ_0.base m_pt ∈ V z_0 := hz0_eq ▸ hz_mem z_0
    have h_range : Set.range σ_0.base ⊆ Set.range (V z_0).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨p, rfl⟩
      by_contra hp_not
      let S : Set (PrimeSpectrum R) := (σ_0.base ⁻¹' (V z_0 : Set X_0))ᶜ
      have hS_cl : IsClosed S := ((V z_0).isOpen.preimage σ_0.continuous).isClosed_compl
      obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal S).mp hS_cl
      let p' : PrimeSpectrum R := p
      let m_pt' : PrimeSpectrum R := m_pt
      have hp_S : p' ∈ S := hp_not
      rw [hI, PrimeSpectrum.mem_zeroLocus] at hp_S
      have hp_le_max : p'.asIdeal ≤ IsLocalRing.maximalIdeal R :=
        IsLocalRing.le_maximalIdeal p'.isPrime.ne_top
      have hm_zl : m_pt' ∈ PrimeSpectrum.zeroLocus (I : Set R) := by
        rw [PrimeSpectrum.mem_zeroLocus]
        exact Set.Subset.trans hp_S hp_le_max
      rw [← hI] at hm_zl
      exact hm_zl hσ_mem
    let σ_V : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ (V z_0).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (V z_0).ι σ_0 h_range
    have hσV_fac : σ_V ≫ (V z_0).ι = σ_0 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (V z_0).ι σ_0 h_range
    let B_V0 := X_0.presheaf.obj (Opposite.op (V z_0))
    let σ_aff : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ AlgebraicGeometry.Spec B_V0 :=
      σ_V ≫ (hV_aff z_0).isoSpec.hom
    have hσ_aff_from : σ_aff ≫ (hV_aff z_0).fromSpec = σ_0 := by
      change (σ_V ≫ (hV_aff z_0).isoSpec.hom) ≫ (hV_aff z_0).fromSpec = σ_0
      rw [CategoryTheory.Category.assoc, ← (hV_aff z_0).isoSpec_inv_ι,
        CategoryTheory.Iso.hom_inv_id_assoc, hσV_fac]
    let α_cat : B_V0 ⟶ CommRingCat.of R :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage σ_aff).unop
    have hSpec_α : AlgebraicGeometry.Spec.map α_cat = σ_aff :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage σ_aff
    let α : ↑B_V0 →+* R := α_cat.hom
    have hσV_pt : σ_V.base m_pt = ⟨j_Z.base z_0, hz_mem z_0⟩ := by
      apply Subtype.ext
      change (σ_V ≫ (V z_0).ι).base m_pt = j_Z.base z_0
      rw [hσV_fac, hz0_eq]
    have hα_ideal : ∀ f : ↑B_V0,
        α f ∈ IsLocalRing.maximalIdeal R ↔
          f ∈ ((hV_aff z_0).isoSpec.hom.base ⟨j_Z.base z_0, hz_mem z_0⟩).asIdeal := by
      intro f
      have h_pt : ((AlgebraicGeometry.Spec.map α_cat).base m_pt).asIdeal =
          ((hV_aff z_0).isoSpec.hom.base ⟨j_Z.base z_0, hz_mem z_0⟩).asIdeal := by
        rw [hSpec_α]
        change ((hV_aff z_0).isoSpec.hom.base (σ_V.base m_pt)).asIdeal = _
        rw [hσV_pt]
      rw [← h_pt]
      rfl
    have h_from_top : (hV_aff z_0).fromSpec.appTop =
        X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso B_V0).inv := by
      have h_nat_V :=
        AlgebraicGeometry.Scheme.Hom.naturality (hV_aff z_0).fromSpec
          (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op
      rw [(hV_aff z_0).fromSpec_app_self] at h_nat_V
      have h_hom_eq :
          ((TopologicalSpace.Opens.map (hV_aff z_0).fromSpec.base).map
            (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op.unop).op =
          (CategoryTheory.eqToHom (hV_aff z_0).fromSpec_preimage_self).op :=
        Subsingleton.elim _ _
      rw [h_hom_eq] at h_nat_V
      apply (CategoryTheory.cancel_mono
        ((AlgebraicGeometry.Spec B_V0).presheaf.map
          (CategoryTheory.eqToHom (hV_aff z_0).fromSpec_preimage_self).op)).mp
      rw [CategoryTheory.Category.assoc]
      exact h_nat_V.symm
    have hα_cat_top :
        X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op ≫ α_cat =
        σ_0.appTop ≫ e_R.hom := by
      have h_nat_α := AlgebraicGeometry.Scheme.ΓSpecIso_naturality α_cat
      rw [hSpec_α] at h_nat_α
      have hα_eq : α_cat =
          (AlgebraicGeometry.Scheme.ΓSpecIso B_V0).inv ≫ σ_aff.appTop ≫ e_R.hom := by
        rw [h_nat_α, CategoryTheory.Iso.inv_hom_id_assoc]
      calc
        X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op ≫ α_cat
            = (X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso B_V0).inv) ≫ σ_aff.appTop ≫ e_R.hom := by
              rw [hα_eq, CategoryTheory.Category.assoc]
        _ = (hV_aff z_0).fromSpec.appTop ≫ σ_aff.appTop ≫ e_R.hom := by
              rw [← h_from_top]
        _ = (σ_aff ≫ (hV_aff z_0).fromSpec).appTop ≫ e_R.hom := by
              rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
        _ = σ_0.appTop ≫ e_R.hom := by
              rw [hσ_aff_from]
    have hα_b : α ((X_0.presheaf.map (CategoryTheory.homOfLE le_top).op).hom b) = 0 := by
      change (X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op ≫ α_cat).hom b = 0
      rw [hα_cat_top]
      change e_R.hom.hom ((σ_0.appTop).hom b) = 0
      rw [hb_σ0, map_zero]
    have hα_base : ∀ r : R, α ((g_X0.appLE ⊤ (V z_0) le_top).hom (e_R.inv.hom r)) = r := by
      intro r
      have h_comp : e_R.inv ≫ g_X0.appLE ⊤ (V z_0) le_top ≫ α_cat = 𝟙 (CommRingCat.of R) := by
        have h_appLE : g_X0.appLE ⊤ (V z_0) le_top =
            g_X0.appTop ≫ X_0.presheaf.map (CategoryTheory.homOfLE (le_top : V z_0 ≤ ⊤)).op := rfl
        rw [h_appLE, CategoryTheory.Category.assoc g_X0.appTop, hα_cat_top,
          ← CategoryTheory.Category.assoc g_X0.appTop, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
          hσ_sec, AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
          e_R.inv_hom_id]
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_comp) r
    have hα_q0 : α (q z_0) = 0 := by
      have h_eval := congrArg α (h_eq z_0)
      simp only [map_mul, hα_b, mul_zero] at h_eval
      change 0 = α ((g_X0.appLE ⊤ (V z_0) le_top).hom (e_R.inv.hom π_b)) * α (q z_0) at h_eval
      rw [hα_base π_b] at h_eval
      exact (mul_eq_zero.mp h_eval.symm).resolve_left hπ_ne
    have h_diff_mem := (hα_ideal _).mpr (hc_vanish r_c hr_c z_0)
    simp only [map_sub, map_mul, hα_q0, hα_base r_c, zero_sub, Ideal.neg_mem_iff] at h_diff_mem
    have hα_u_not_max : α (u z_0) ∉ IsLocalRing.maximalIdeal R :=
      fun hm => hu z_0 ((hα_ideal (u z_0)).mp hm)
    rcases (IsLocalRing.maximalIdeal.isMaximal R).isPrime.mul_mem_iff_mem_or_mem.mp h_diff_mem with
      hu_m | hr_m
    · exact hα_u_not_max hu_m
    · exact hrc_not_max hr_m

theorem weil_strictlySemistable_contracted_p1_boundary_nonempty (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (U_K : C_K.Opens) (hUK : Nonempty ↥U_K)
    (U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_ss_cur : C_cur ⟶ U_ss)
    (ι_ss : U_K.toScheme ⟶ U_ss)
    (ι_cur : U_K.toScheme ⟶ C_cur)
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS_base : IsStrictlySemistableCurveOverValuation V g_ss)
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hProp_fss : AlgebraicGeometry.IsProper f_ss_cur)
    (hComm_fss : f_ss_cur ≫ g_ss = g_cur)
    (hι_fss : ι_cur ≫ f_ss_cur = ι_ss)
    (hPb_ss : CategoryTheory.IsPullback ι_ss (U_K.ι ≫ p_K) g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_cur : CategoryTheory.IsPullback ι_cur (U_K.ι ≫ p_K) g_cur
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥) (u₀ : ↥U_ss)
    (hFin_P : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))).Finite)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_mem : Z ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_P1 : ∃ (Z_sch : AlgebraicGeometry.Scheme.{u})
        (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))
        (isoP1 : Z_sch ≅ (weilProjectiveSpaceOver P.asIdeal.ResidueField 1).left),
      AlgebraicGeometry.IsClosedImmersion ιZ ∧
      AlgebraicGeometry.IsIntegral Z_sch ∧
      Set.range ιZ.base = Z ∧
      ιZ ≫ CategoryTheory.Limits.pullback.snd g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver P.asIdeal.ResidueField 1).hom)
    (hZ_contr : ∀ q ∈ Z,
      f_ss_cur.base ((CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base q) = u₀) :
    1 ≤ {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))),
      E' ≠ Z ∧ q ∈ E'}.ncard :=
by
  classical
  let κ_P := P.asIdeal.ResidueField
  let s_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ_P))
  let Y_P := CategoryTheory.Limits.pullback g_cur s_P
  let fst_P := CategoryTheory.Limits.pullback.fst g_cur s_P
  let snd_P := CategoryTheory.Limits.pullback.snd g_cur s_P
  let Δ_Z : Set ↥Y_P := {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}
  let R_P := ↥(V.ofPrime P.asIdeal)
  let ι_VP : ↥V →+* R_P := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  obtain ⟨hOpenη, hNorm, hFuncEx⟩ :=
    weil_strictlySemistable_isAffineNormal_and_funcField K m V hPkg
  have hNorm_cur : IsAffineNormalScheme C_cur := hNorm C_cur g_cur hSS_cur
  obtain ⟨F_cur, instFieldFcur, η_cur, hFunc_cur⟩ := hFuncEx C_cur g_cur hSS_cur
  let _ : Field F_cur := instFieldFcur
  obtain ⟨hAff_proj, c_proj, t_proj, hCoord, _⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg
  obtain ⟨hPkg_VP, hMax_VP, ϖ, hϖ_P, hϖ_le, hϖ_mem, hOpen_VP⟩ :=
    weil_valuationSubring_ofPrime_algPackage_and_away K m V hPkg P hP
  have _ : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)) :=
    hOpen_VP
  obtain ⟨hFin_Δ, ⟨q_R, hq_surj, hq_ker, hq_comp⟩, hClopen⟩ :=
    weil_clopen_p1_component_smooth_charts_and_henselian_section K m V P hP hPkg_VP hMax_VP
      ϖ hϖ_P hϖ_le hϖ_mem hOpen_VP C_cur g_cur hSS_cur hNorm_cur hFin_P Z hZ_mem hZ_P1
  suffices hne_Δ : Δ_Z.Nonempty from Set.Nonempty.ncard_pos hFin_Δ hne_Δ
  by_contra hnot_Δ
  have hΔ_empty : Δ_Z = ∅ := Set.not_nonempty_iff_eq_empty.mp hnot_Δ
  obtain ⟨Z_sch, ιZ, isoP1, _hClZ, hIntZ, hRangeZ, hCommZ⟩ := hZ_P1
  have _ : AlgebraicGeometry.IsIntegral Z_sch := hIntZ
  obtain ⟨z_init⟩ := hIntZ.nonempty
  have hZ_ne : Z.Nonempty := ⟨ιZ.base z_init, by rw [← hRangeZ]; exact ⟨z_init, rfl⟩⟩
  obtain ⟨X_0, g_X0, hInt_X0, hFlat_X0, hZ_in_X0, hg_X0_comm, hMake_b⟩ :=
    weil_base_chart_section_vanishing_nonZero_pullback K V hOpenη C_K p_K U_K hUK
      U_ss C_cur g_ss g_cur f_ss_cur ι_ss ι_cur hSS_base hSS_cur hComm_fss hι_fss
      hPb_ss hPb_cur P hP u₀ ϖ hϖ_P hϖ_le hϖ_mem hOpen_VP Z hZ_ne hZ_contr
  have _ : AlgebraicGeometry.IsIntegral X_0.toScheme := hInt_X0
  have _ : AlgebraicGeometry.Flat g_X0 := hFlat_X0
  obtain ⟨hCharts, ⟨q_0, σ_0, hq0_Z, hσ0_sec, hσ0_pt⟩⟩ :=
    hClopen hΔ_empty X_0 g_X0 hZ_in_X0 hg_X0_comm
  obtain ⟨b, hb_σ0, hb_ne0, hb_vanish⟩ := hMake_b q_0 σ_0 hq0_Z hσ0_sec hσ0_pt
  
  have hRange_jZ : Set.range (ιZ ≫ fst_P).base ⊆ Set.range X_0.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    apply hZ_in_X0 (ιZ.base z)
    rw [← hRangeZ]
    exact ⟨z, rfl⟩
  let j_Z : Z_sch ⟶ X_0.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift X_0.ι (ιZ ≫ fst_P) hRange_jZ
  have hjZ_fac : j_Z ≫ X_0.ι = ιZ ≫ fst_P :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac X_0.ι (ιZ ≫ fst_P) hRange_jZ
  let p_Z : Z_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of κ_P) := ιZ ≫ snd_P
  have hj_comm : j_Z ≫ g_X0 = p_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R) := by
    rw [← CategoryTheory.cancel_mono (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP))]
    calc
      (j_Z ≫ g_X0) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)
          = j_Z ≫ (g_X0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)) :=
            CategoryTheory.Category.assoc _ _ _
      _ = j_Z ≫ (X_0.ι ≫ g_cur) := by rw [hg_X0_comm]
      _ = (j_Z ≫ X_0.ι) ≫ g_cur := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (ιZ ≫ fst_P) ≫ g_cur := by rw [hjZ_fac]
      _ = ιZ ≫ (fst_P ≫ g_cur) := CategoryTheory.Category.assoc _ _ _
      _ = ιZ ≫ (snd_P ≫ s_P) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = p_Z ≫ s_P := (CategoryTheory.Category.assoc _ _ _).symm
      _ = p_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_R.comp ι_VP)) := by
            change p_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ_P)) = _
            rw [← hq_comp]
      _ = p_Z ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = (p_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) :=
            (CategoryTheory.Category.assoc _ _ _).symm
  
  have hq0_range : q_0 ∈ Set.range ιZ.base := by rw [hRangeZ]; exact hq0_Z
  obtain ⟨z_0, hz_0⟩ := hq0_range
  let 𝔪_RP : PrimeSpectrum R_P :=
    ⟨IsLocalRing.maximalIdeal R_P, (IsLocalRing.maximalIdeal.isMaximal R_P).isPrime⟩
  have hz0_eq : j_Z.base z_0 = σ_0.base 𝔪_RP := by
    apply X_0.ι.isOpenEmbedding.injective
    change (j_Z ≫ X_0.ι).base z_0 = (σ_0 ≫ X_0.ι).base 𝔪_RP
    rw [hjZ_fac, hσ0_pt]
    change fst_P.base (ιZ.base z_0) = fst_P.base q_0
    rw [hz_0]
  
  have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver κ_P 1).hom := (hCoord κ_P 1).1
  have _ : AlgebraicGeometry.IsProper p_Z := by
    change AlgebraicGeometry.IsProper (ιZ ≫ snd_P)
    rw [hCommZ]
    infer_instance
  obtain ⟨ψ_proj0, hψ_proj0_c, _⟩ :=
    (hCoord κ_P 1).2.2.2.2.2.2.1 0 κ_P (RingHom.id κ_P) ![1, 0] rfl
  let ξ_Z : AlgebraicGeometry.Spec (CommRingCat.of κ_P) ⟶ Z_sch :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_proj0) ≫
      (hAff_proj κ_P 1 0).fromSpec ≫ isoP1.inv
  have hξ_sec : ξ_Z ≫ p_Z = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ_P)) := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_proj0) ≫
        (hAff_proj κ_P 1 0).fromSpec ≫ isoP1.inv) ≫ (ιZ ≫ snd_P) = _
    rw [hCommZ]
    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
    rw [← (hCoord κ_P 1).2.2.1 0, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hψ_proj0_c]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of κ_P)
  have hp_bij : Function.Bijective (p_Z.appTop).hom :=
    weil_integral_proper_section_appTop_bijective κ_P Z_sch p_Z ξ_Z hξ_sec
  
  obtain ⟨W_init, hW_init_aff, hx_W_init, hW_init_le⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
      (U := X_0) (x := fst_P.base q_0) (hZ_in_X0 q_0 hq0_Z)
  have hW_init_ne : Nonempty ↥W_init := ⟨⟨fst_P.base q_0, hx_W_init⟩⟩
  obtain ⟨φ_init, _, hφ_init_spec⟩ := hFunc_cur W_init hW_init_aff hW_init_ne
