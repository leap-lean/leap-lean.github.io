      rcases hCharts y with ⟨W, e, hy, hEt, hComm⟩ | ⟨W, a, e, hy, ha, hEt, hComm⟩
      · haveI : AlgebraicGeometry.Etale e := hEt
        have hFlat_C : (Polynomial.C : ↥W₀ →+* Polynomial ↥W₀).Flat :=
          RingHom.flat_algebraMap_iff.mpr inferInstance
        have hFp_C : (Polynomial.C : ↥W₀ →+* Polynomial ↥W₀).FinitePresentation :=
          RingHom.finitePresentation_algebraMap.mpr inferInstance
        haveI : AlgebraicGeometry.Flat
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.C : ↥W₀ →+* Polynomial ↥W₀))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)
            (φ := CommRingCat.ofHom (Polynomial.C : ↥W₀ →+* Polynomial ↥W₀))).mpr hFlat_C
        haveI : AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.C : ↥W₀ →+* Polynomial ↥W₀))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFinitePresentation)
            (φ := CommRingCat.ofHom (Polynomial.C : ↥W₀ →+* Polynomial ↥W₀))).mpr hFp_C
        refine ⟨W, hy, ?_, ?_⟩
        · rw [hComm]; infer_instance
        · rw [hComm]; infer_instance
      · haveI : AlgebraicGeometry.Etale e := hEt
        have hDomA := hNodalDom ↥W₀ a ha
        obtain ⟨hFp_N, hFlat_N_imp⟩ := hNodalFlatFp ↥W₀ a
        have hFlat_N := hFlat_N_imp inferInstance inferInstance hDomA
        let i_W₀ : @RingHom ↥W₀
            (MvPolynomial (Fin 2) ↥W₀ ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
            CommRing.toCommSemiring.toSemiring.toNonAssocSemiring
            CommRing.toCommSemiring.toSemiring.toNonAssocSemiring :=
          (Ideal.Quotient.mk (Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp MvPolynomial.C
        haveI : AlgebraicGeometry.Flat
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_W₀)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)
            (φ := CommRingCat.ofHom i_W₀)).mpr hFlat_N
        haveI : AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_W₀)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFinitePresentation)
            (φ := CommRingCat.ofHom i_W₀)).mpr hFp_N
        refine ⟨W, hy, ?_, ?_⟩
        · rw [hComm]; infer_instance
        · rw [hComm]; infer_instance
    classical
    choose W_fam hW_mem hW_flat hW_lfp using hLoc
    have hTop : iSup W_fam = ⊤ :=
      eq_top_iff.mpr (fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hW_mem y⟩)
    letI : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Flat.{u}) :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource.{u}
        (@AlgebraicGeometry.Flat.{u}) (@RingHom.Flat.{u, u}) inferInstance
    letI : AlgebraicGeometry.IsZariskiLocalAtSource
        (@AlgebraicGeometry.LocallyOfFinitePresentation.{u}) :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource.{u}
        (@AlgebraicGeometry.LocallyOfFinitePresentation.{u})
        (@RingHom.FinitePresentation.{u, u}) inferInstance
    have hFlat_g : AlgebraicGeometry.Flat g_ℰ :=
      AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top W_fam hTop hW_flat
    have hLfp_g : AlgebraicGeometry.LocallyOfFinitePresentation g_ℰ :=
      AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top W_fam hTop hW_lfp
    exact ⟨hInt, hFlat_g, hSep, hLfp_g, hCharts⟩

theorem weil_rankOne_schematic_image_strictlySemistable_and_local_branches (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (Q_b : PrimeSpectrum ↥V)
    (hAlg_L : IsAlgClosed Q_b.asIdeal.ResidueField)
    (W₀ : ValuationSubring Q_b.asIdeal.ResidueField)
    (hMax_W₀ : IsLocalRing.maximalIdeal ↥W₀ ≠ ⊥)
    (hRank1_W₀ : ∀ P' : PrimeSpectrum ↥W₀,
      P'.asIdeal = ⊥ ∨ P'.asIdeal = IsLocalRing.maximalIdeal ↥W₀)
    (ρ_V : ↥V →+* ↥W₀)
    (hρ_sub : W₀.subtype.comp ρ_V = algebraMap ↥V Q_b.asIdeal.ResidueField)
    (hρ_ker : RingHom.ker ρ_V = Q_b.asIdeal)
    (E_cur : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))))
    (hE_irred : E_cur ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField)))))
    (E_sch : AlgebraicGeometry.Scheme.{u})
    (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).left)
    (hCl_E : AlgebraicGeometry.IsClosedImmersion ιE)
    (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
    (hRange_E : Set.range ιE.base = E_cur)
    (hIso_E : ιE ≫ CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) =
      isoP1.hom ≫ (weilProjectiveSpaceOver Q_b.asIdeal.ResidueField 1).hom)
    (u_gen : CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ⟶
      CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)))
    (hu_fst : u_gen ≫ CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))))
    (hu_snd : u_gen ≫ CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)) =
      CategoryTheory.Limits.pullback.snd g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) :
    let s_b := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V Q_b.asIdeal.ResidueField))
    let Y_b := CategoryTheory.Limits.pullback g_cur s_b
    let Δ_E : Set ↥Y_b :=
      {q ∈ E_cur | ∃ E' ∈ irreducibleComponents ↥Y_b, E' ≠ E_cur ∧ q ∈ E'}
    let ι_W0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)
    let X_W0 := CategoryTheory.Limits.pullback g_cur ι_W0
    let ℰ := AlgebraicGeometry.Scheme.Hom.image (ιE ≫ u_gen)
    let ι_ℰ := AlgebraicGeometry.Scheme.Hom.imageι (ιE ≫ u_gen)
    let g_ℰ : ℰ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) :=
      ι_ℰ ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0
    let k₀ := (IsLocalRing.maximalIdeal ↥W₀).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ k₀))
    let T₀ := CategoryTheory.Limits.pullback g_ℰ s₀
    IsStrictlySemistableCurveOverValuation W₀ g_ℰ ∧
    (∀ (κ : Type u) [Field κ]
        (s_κ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (y : ↥(CategoryTheory.Limits.pullback g_cur s_κ))
        (V_sm : C_cur.Opens),
      (CategoryTheory.Limits.pullback.fst g_cur s_κ).base y ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_cur) →
      ∃ W_y : (CategoryTheory.Limits.pullback g_cur s_κ).Opens,
        y ∈ W_y ∧ IsPreirreducible (W_y : Set ↥(CategoryTheory.Limits.pullback g_cur s_κ))) ∧
    (∀ (q : ↥T₀) (V_sm : C_cur.Opens),
      (CategoryTheory.Limits.pullback.fst g_cur ι_W0).base
        (ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q)) ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_cur) →
      (∃ U_X : X_W0.Opens,
        ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q) ∈ U_X ∧
        (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base) ∧
      (∃ V_T : T₀.Opens, q ∈ V_T ∧ IsPreirreducible (V_T : Set ↥T₀))) ∧
    (∀ q : ↥T₀,
      (∃ U_X : X_W0.Opens,
        ι_ℰ.base ((CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q) ∈ U_X ∧
        (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base) ∨
      ((∃ V_T : T₀.Opens, q ∈ V_T ∧ IsPreirreducible (V_T : Set ↥T₀)) ∧
        ∃ (q_b : ↥Y_b) (z_b : ↥ℰ)
          (ξ_b : AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField) ⟶ ℰ),
          q_b ∈ Δ_E ∧
          ι_ℰ.base z_b = u_gen.base q_b ∧
          (CategoryTheory.Limits.pullback.fst g_ℰ s₀).base q ∈ closure ({z_b} : Set ↥ℰ) ∧
          ξ_b ≫ g_ℰ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ∧
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Q_b.asIdeal.ResidueField)),
            ξ_b.base pt = z_b))) :=
by
  clear hρ_ker hIso_E
  intro s_b Y_b Δ_E ι_W0 X_W0 ℰ ι_ℰ g_ℰ k₀ s₀ T₀
  have _ : IsAlgClosed Q_b.asIdeal.ResidueField := hAlg_L
  obtain ⟨hChartPkg, hAssembleSS⟩ := weil_smooth_and_semistable_chart_baseChange_and_curve_assembly
  obtain ⟨hInt_ℰ, hOpen_ugen, hRange_ugen, hGen_iff, hAffDich⟩ :=
    weil_rankOne_schematic_image_integral_and_generic_affine_dichotomy
      K V C_cur g_cur Q_b hAlg_L W₀ hMax_W₀ hRank1_W₀ ρ_V hρ_sub
      E_cur hE_irred E_sch ιE isoP1 hCl_E hInt_E hRange_E u_gen hu_fst hu_snd
  
  have hMemBasic : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens)
      (hU : AlgebraicGeometry.IsAffineOpen U) (s : ↑Γ(X, U)) (x : ↥U),
      (x : ↥X) ∈ X.basicOpen s ↔ s ∉ (hU.primeIdealOf x).asIdeal := by
    intro X U hU s x
    let p : ↥(AlgebraicGeometry.Spec Γ(X, U)) := hU.primeIdealOf x
    have hp : hU.fromSpec.base p = (x : ↥X) := hU.fromSpec_primeIdealOf x
    change (x : ↥X) ∈ (X.basicOpen s : Set ↥X) ↔ _
    rw [← hp]
    change p ∈
      ((TopologicalSpace.Opens.map hU.fromSpec.base).obj (X.basicOpen s) : Set _) ↔ _
    rw [hU.fromSpec_preimage_basicOpen]
    exact @PrimeSpectrum.mem_basicOpen ↑Γ(X, U) _ s p
  
  have hBasicIsDomain : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens)
      (hU : AlgebraicGeometry.IsAffineOpen U) (s : ↑Γ(X, U)),
      IsDomain (Localization.Away s) → IsDomain ↑Γ(X, X.basicOpen s) := by
    intro X U hU s hDom
    let _ : Algebra ↑Γ(X, U) ↑Γ(X, X.basicOpen s) :=
      (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le s)).op).hom.toAlgebra
    have _ : IsLocalization.Away s ↑Γ(X, X.basicOpen s) := hU.isLocalization_basicOpen s
    let e := IsLocalization.algEquiv (Submonoid.powers s) (Localization.Away s) ↑Γ(X, X.basicOpen s)
    exact e.symm.toRingEquiv.toMulEquiv.isDomain (Localization.Away s)
  
  have hAffPreirred : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens)
      (hU : AlgebraicGeometry.IsAffineOpen U),
      IsDomain ↑Γ(X, U) → IsPreirreducible (U : Set ↥X) := by
    intro X U hU hDom
    have _ : IsDomain ↑Γ(X, U) := hDom
    have _ : IrreducibleSpace ↥(AlgebraicGeometry.Spec Γ(X, U)) := inferInstance
    have h1 : IsPreirreducible (Set.univ : Set ↥(AlgebraicGeometry.Spec Γ(X, U))) :=
      PreirreducibleSpace.isPreirreducible_univ
    rw [← hU.range_fromSpec, ← Set.image_univ]
    exact h1.image _ hU.fromSpec.continuous.continuousOn
  
  have hEtaleComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (f : A →+* B) (g : B →+* C), f.Etale → g.Etale → (g.comp f).Etale := by
    intro A B C _ _ _ f g hf hg
    have hf' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
    have hg' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg
    have hfg : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) := inferInstance
    rw [← AlgebraicGeometry.Spec.map_comp] at hfg
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hfg
  
  have hEtaleResBasic : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens)
      (hU : AlgebraicGeometry.IsAffineOpen U) (s : ↑Γ(X, U)),
      (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le s)).op).hom.Etale := by
    intro X U hU s
    let res := (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le s)).op).hom
    let _ : Algebra ↑Γ(X, U) ↑Γ(X, X.basicOpen s) := res.toAlgebra
    have _ : IsLocalization.Away s ↑Γ(X, X.basicOpen s) := hU.isLocalization_basicOpen s
    change (algebraMap ↑Γ(X, U) ↑Γ(X, X.basicOpen s)).Etale
    rw [RingHom.etale_algebraMap]
    exact Algebra.Etale.of_isLocalizationAway s
  
  have hFieldSmoothPreirred : ∀ {R : Type u} [CommRing R]
      {X : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (κ : Type u) [Field κ]
      (s_κ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (W : X.Opens)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
      AlgebraicGeometry.Etale e →
      W.ι ≫ g = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      ∀ y : ↥(CategoryTheory.Limits.pullback g s_κ),
        (CategoryTheory.Limits.pullback.fst g s_κ).base y ∈ W →
        ∃ W_y : (CategoryTheory.Limits.pullback g s_κ).Opens,
          y ∈ W_y ∧ IsPreirreducible (W_y : Set ↥(CategoryTheory.Limits.pullback g s_κ)) := by
    intro R _ X g κ _ s_κ W e hEt_e hComm_e y hy_W
    obtain ⟨U, hU, hy_U, ψ, hEt_ψ, _⟩ := (hChartPkg R X g).2.1 κ s_κ W e hEt_e hComm_e y hy_W
    let q_y : Ideal ↑Γ(CategoryTheory.Limits.pullback g s_κ, U) :=
      (hU.primeIdealOf ⟨y, hy_U⟩).asIdeal
    obtain ⟨s, hs_not_mem, hDom_s⟩ :=
      weil_etale_over_integrallyClosed_exists_away_isDomain
        (Polynomial κ) ↑Γ(CategoryTheory.Limits.pullback g s_κ, U) ψ hEt_ψ q_y
    refine ⟨(CategoryTheory.Limits.pullback g s_κ).basicOpen s, ?_, ?_⟩
    · exact (hMemBasic U hU s ⟨y, hy_U⟩).mpr hs_not_mem
    · exact hAffPreirred _ (hU.basicOpen s) (hBasicIsDomain U hU s hDom_s)
  
  have hConj2 : ∀ (κ : Type u) [Field κ]
      (s_κ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (y : ↥(CategoryTheory.Limits.pullback g_cur s_κ))
      (V_sm : C_cur.Opens),
      (CategoryTheory.Limits.pullback.fst g_cur s_κ).base y ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_cur) →
      ∃ W_y : (CategoryTheory.Limits.pullback g_cur s_κ).Opens,
        y ∈ W_y ∧ IsPreirreducible (W_y : Set ↥(CategoryTheory.Limits.pullback g_cur s_κ)) := by
    intro κ _ s_κ y V_sm hy_V hSm
    obtain ⟨W, e, hy_W, _, hEt_e, hComm_e⟩ :=
      (hChartPkg ↥V C_cur g_cur).1 V_sm hSm _ hy_V
    exact hFieldSmoothPreirred g_cur κ s_κ W e hEt_e hComm_e y hy_W
  
  have hSmoothAt : ∀ (z : ↥ℰ) (U₀ : X_W0.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
      (hz_U₀ : ι_ℰ.base z ∈ U₀)
      (ψ : Polynomial ↥W₀ →+* ↑Γ(X_W0, U₀)),
      ψ.Etale →
      hU₀.fromSpec ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp Polynomial.C)) →
      (∃ U_X : X_W0.Opens, ι_ℰ.base z ∈ U_X ∧ (U_X : Set ↥X_W0) ⊆ Set.range ι_ℰ.base) ∧
      (∃ (W_ℰ : ℰ.Opens)
          (e_ℰ : W_ℰ.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥W₀))),
        z ∈ W_ℰ ∧
        AlgebraicGeometry.Etale e_ℰ ∧
        W_ℰ.ι ≫ g_ℰ = e_ℰ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) := by
    intro z U₀ hU₀ hz_U₀ ψ hEt_ψ hComm_ψ
    let q_z : Ideal ↑Γ(X_W0, U₀) := (hU₀.primeIdealOf ⟨ι_ℰ.base z, hz_U₀⟩).asIdeal
    obtain ⟨s, hs_not_mem, hDom_s⟩ :=
      weil_etale_over_integrallyClosed_exists_away_isDomain
        (Polynomial ↥W₀) ↑Γ(X_W0, U₀) ψ hEt_ψ q_z
    let U_X : X_W0.Opens := X_W0.basicOpen s
    have hUX : AlgebraicGeometry.IsAffineOpen U_X := hU₀.basicOpen s
    have hz_UX : ι_ℰ.base z ∈ U_X := (hMemBasic U₀ hU₀ s ⟨ι_ℰ.base z, hz_U₀⟩).mpr hs_not_mem
    have hDom_UX : IsDomain ↑Γ(X_W0, U_X) := hBasicIsDomain U₀ hU₀ s hDom_s
    obtain ⟨hUX_sub, iso_W, hiso_W⟩ := (hAffDich U_X hUX z hz_UX).1 hDom_UX
    refine ⟨⟨U_X, hz_UX, hUX_sub⟩, ?_⟩
    let W_ℰ : ℰ.Opens := (TopologicalSpace.Opens.map ι_ℰ.base).obj U_X
    let res_s := X_W0.presheaf.map (CategoryTheory.homOfLE (X_W0.basicOpen_le s)).op
    let ψ_s : Polynomial ↥W₀ →+* ↑Γ(X_W0, U_X) := res_s.hom.comp ψ
    have hEt_ψs : ψ_s.Etale := hEtaleComp ψ res_s.hom hEt_ψ (hEtaleResBasic U₀ hU₀ s)
    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψs
    let e_ℰ : W_ℰ.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥W₀)) :=
      iso_W.hom ≫ hUX.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s)
    have hEt_eℰ : AlgebraicGeometry.Etale e_ℰ := inferInstance
    refine ⟨W_ℰ, e_ℰ, hz_UX, hEt_eℰ, ?_⟩
    have hfrom_UX : hUX.fromSpec = AlgebraicGeometry.Spec.map res_s ≫ hU₀.fromSpec :=
      (hU₀.map_fromSpec hUX (CategoryTheory.homOfLE (X_W0.basicOpen_le s)).op).symm
    have hSpec_comp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
        AlgebraicGeometry.Spec.map res_s ≫ hU₀.fromSpec ≫
          CategoryTheory.Limits.pullback.snd g_cur ι_W0 := by
      rw [hComm_ψ, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    calc W_ℰ.ι ≫ g_ℰ
        = (W_ℰ.ι ≫ ι_ℰ) ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 := by
            rw [CategoryTheory.Category.assoc]
      _ = (iso_W.hom ≫ U_X.ι) ≫ CategoryTheory.Limits.pullback.snd g_cur ι_W0 := by
            rw [hiso_W]
      _ = iso_W.hom ≫ hUX.isoSpec.hom ≫ hUX.fromSpec ≫
            CategoryTheory.Limits.pullback.snd g_cur ι_W0 := by
            rw [CategoryTheory.Category.assoc, ← IsAffineOpen.isoSpec_hom_fromSpec hUX,
              CategoryTheory.Category.assoc]
      _ = e_ℰ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
            simp only [e_ℰ, CategoryTheory.Category.assoc, hSpec_comp, hfrom_UX]
  
