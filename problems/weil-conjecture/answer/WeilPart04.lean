            (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥W₀))),
          y ∈ W ∧
          AlgebraicGeometry.Etale e ∧
          W.ι ≫ g_ℰ = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
        (∃ (W : ℰ.Opens) (a : ↥W₀)
            (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) ↥W₀ ⧸ Ideal.span
                {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
          y ∈ W ∧
          a ≠ 0 ∧
