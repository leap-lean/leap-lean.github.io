        change Polynomial.C (κ_Q s₁) * p = Polynomial.mapRingHom κ_Q m₁ at h₁
        change Polynomial.C (κ_Q s₂) * q = Polynomial.mapRingHom κ_Q m₂ at h₂
        rw [map_mul, Polynomial.C_mul, map_add, map_mul, map_mul,
          Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.map_C,
