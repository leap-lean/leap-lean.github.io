                AlgebraicGeometry.Spec.map_preimage, hu_bf, AlgebraicGeometry.Spec.map_id])
            inv_hom_id := AlgebraicGeometry.Spec.map_injective (by
              rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
                AlgebraicGeometry.Spec.map_preimage, hu_fb, AlgebraicGeometry.Spec.map_id]) }
        let e_Wa := iso_Wa_cat.commRingCatIsoToRingEquiv
        have : IsDomain ↑Γ(P_F, W_a) := MulEquiv.isDomain (Polynomial F) e_Wa.symm.toMulEquiv
        have : IsIntegrallyClosed ↑Γ(P_F, W_a) := IsIntegrallyClosed.of_equiv e_Wa
        let p_x := hAff_Wa.primeIdealOf ⟨x, hx_Wa⟩
        let _ := TopCat.Presheaf.algebra_section_stalk P_F.presheaf ⟨x, hx_Wa⟩
        have : IsLocalization.AtPrime ↑(P_F.presheaf.stalk x) p_x.asIdeal :=
