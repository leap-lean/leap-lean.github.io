      RingHom.Etale.respectsIso.left f₁ e_TB hEt_f₁
    let α_sec : R_z ⧸ I_base ≃+* ↑A_loc ⧸ I_sec :=
      (Ideal.quotEquivOfEq hKer_sec.symm).trans
        (RingHom.quotientKerEquivOfSurjective hSurj_sec)
    let θ₀ : R_z ⧸ I_base →+* ↑B₀ ⧸ Ideal.map ψ₀.hom I_sec :=
      f₂.comp α_sec.toRingHom
    have hEt_θ₀ : RingHom.Etale θ₀ :=
      RingHom.Etale.respectsIso.right f₂ α_sec hEt_f₂
