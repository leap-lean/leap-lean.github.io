        refine ⟨⟨(j_a 0).base q₁, hf_sub hq₁_mem⟩, ⟨(j_a 0).base q₂, hf_sub hq₂_mem⟩, ?_⟩
        intro heq_O
        exact hq_ne ((j_a 0).isOpenEmbedding.injective (congrArg Subtype.val heq_O))
      · intro L _ _ t ht ht_gen
        have : IsOpenImmersion (j_a 0) := hj_open 0
        let ev_t : Polynomial F →ₐ[F] L := Polynomial.aeval t
        have hInj_ev : Function.Injective ev_t := transcendental_iff_injective.mp ht
        let K_sub : IntermediateField F L :=
          { carrier := {z : L | ∃ f g : Polynomial F, g ≠ 0 ∧ ev_t g * z = ev_t f}
            mul_mem' := by
              rintro z₁ z₂ ⟨f₁, g₁, hg₁, h₁⟩ ⟨f₂, g₂, hg₂, h₂⟩
              refine ⟨f₁ * f₂, g₁ * g₂, mul_ne_zero hg₁ hg₂, ?_⟩
              rw [map_mul, map_mul]
              calc (ev_t g₁ * ev_t g₂) * (z₁ * z₂) = (ev_t g₁ * z₁) * (ev_t g₂ * z₂) := by ring
                _ = ev_t f₁ * ev_t f₂ := by rw [h₁, h₂]
            one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
            add_mem' := by
              rintro z₁ z₂ ⟨f₁, g₁, hg₁, h₁⟩ ⟨f₂, g₂, hg₂, h₂⟩
              refine ⟨f₁ * g₂ + g₁ * f₂, g₁ * g₂, mul_ne_zero hg₁ hg₂, ?_⟩
              rw [map_add, map_mul, map_mul, map_mul]
              calc (ev_t g₁ * ev_t g₂) * (z₁ + z₂)
                  = (ev_t g₁ * z₁) * ev_t g₂ + ev_t g₁ * (ev_t g₂ * z₂) := by ring
                _ = ev_t f₁ * ev_t g₂ + ev_t g₁ * ev_t f₂ := by rw [h₁, h₂]
