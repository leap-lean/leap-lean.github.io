  have hJ₀_le : J₀ ≤ p_z.asIdeal := Ideal.map_le_iff_le_comap.mpr hI_sec_pz
  have hpz_comap_V : ∀ v : ↥V,
      ψ₀.hom (φ_Rz.hom (algebraMap ↥V R_z v)) ∈ p_z.asIdeal ↔ v ∈ P_z := by
    intro v
    have hpt := congrArg (fun f => (f.base p_z).asIdeal) hjW₀_gX
    change (g_X.base ((j_W₀ ≫ W.ι).base p_z)).asIdeal =
      Ideal.comap ((CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz).hom)
        (Ideal.comap ψ₀.hom p_z.asIdeal) at hpt
    rw [hp_z_W, hPz_eq] at hpt
    exact Ideal.ext_iff.mp hpt.symm v
  have h_sec_iso : ∃ h₀ : ↑B₀, h₀ ∉ p_z.asIdeal ∧
      Function.Bijective
        ((algebraMap (↑B₀ ⧸ J₀) (Localization.Away (Ideal.Quotient.mk J₀ h₀))).comp θ₀) := by
    let C₀ : Type u := ↑B₀ ⧸ J₀
    letI : Algebra (R_z ⧸ I_base) C₀ := θ₀.toAlgebra
    have : Algebra.Etale (R_z ⧸ I_base) C₀ := hEt_θ₀.toAlgebra
    have : p_z.asIdeal.IsPrime := (p_z : PrimeSpectrum ↑B₀).isPrime
    let q_z : Ideal C₀ := Ideal.map (Ideal.Quotient.mk J₀) p_z.asIdeal
    have hker_J₀ : RingHom.ker (Ideal.Quotient.mk J₀) ≤ p_z.asIdeal := by
      rw [Ideal.mk_ker]
      exact hJ₀_le
    have : q_z.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_J₀
    have hqz_comap : Ideal.comap (Ideal.Quotient.mk J₀) q_z = p_z.asIdeal := by
      rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk J₀) Ideal.Quotient.mk_surjective]
      have hbot : Ideal.comap (Ideal.Quotient.mk J₀) ⊥ = J₀ := Ideal.mk_ker
      rw [hbot, sup_eq_left.mpr hJ₀_le]
    have hComap_eq :
