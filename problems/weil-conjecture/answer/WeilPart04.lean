                rw [IsLocalization.Away.lift_eq]
                simp [h_pol, T_pol]
              have h_unit_X₀ : IsUnit (algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X0_bar) :=
                IsLocalization.map_units L_nod ⟨X0_bar, Submonoid.mem_powers X0_bar⟩
              apply h_unit_X₀.mul_right_cancel
              calc
                f_inv (algebraMap (Polynomial ↥V) L_pol (Polynomial.C a)) *
                    f_inv (IsLocalization.Away.invSelf (S := L_pol) T_pol) *
                    algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X0_bar
                    = f_inv (algebraMap (Polynomial ↥V) L_pol (Polynomial.C a)) *
