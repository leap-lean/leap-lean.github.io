      · have hr0 : r.comp hSE_S2.extClass (rfl : 1 + 1 = 2) = 0 := Subsingleton.elim _ _
        obtain ⟨q, hq⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ U₀ hSE_S2 r rfl hr0
        exact ⟨q, hq⟩
    exact ⟨hSurj_δ0, ⟨bdry₀, hSurj_bdry0, hKer_bdry0⟩, hBij_δ1⟩

  
  obtain ⟨hCont_f, Θ, _⟩ := weil_zero_ext_direct_image_zero_functor_iso X S f
  obtain ⟨G₀, η₀, ⟨hAdd_G₀, _, _⟩, hMono_η₀, hAcyc_X, hAcyc_S⟩ :=
    weil_leray_p1_filt_functorial_godement_step X S f hCont_f

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ

  
  have hULift1 : ∀ n : ULift.{u} ℤ, n = n.down • ULift.up (1 : ℤ) :=
    fun n => ULift.ext _ _ (mul_one n.down).symm
  have h_ae_mk₀ : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞] {U V : 𝒞} (g : U ⟶ V),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
    intro 𝒞 _ _ _ U V g
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
