          congrArg (fun k => k.app (Opposite.op U)) hr
        dsimp [homEquiv_X, freeAdjPSh, CategoryTheory.yonedaEquiv]
        rw [hr_app]
        exact CategoryTheory.ConcreteCategory.congr_hom
          (AddCommGrpCat.adj.homEquiv_naturality_right _ (φ.hom.app (Opposite.op U))) (𝟙 U)
      have hEquivV_comp : ∀ (U' : V_U.Etale) {G₁ G₂ : CategoryTheory.Sheaf J_V AddCommGrpCat.{u}}
          (u : L_V.obj U' ⟶ G₁) (φ : G₁ ⟶ G₂),
          homEquiv_V U' G₂ (u ≫ φ) = (φ.hom.app (Opposite.op U')).hom (homEquiv_V U' G₁ u) := by
        intro U' G₁ G₂ u φ
        have hr := adj_shV.homEquiv_naturality_right u φ
        have hr_app : ((adj_shV.homEquiv (CategoryTheory.yoneda.obj U' ⋙ AddCommGrpCat.free) G₂) (u ≫ φ)).app
            (Opposite.op U') =
            ((adj_shV.homEquiv (CategoryTheory.yoneda.obj U' ⋙ AddCommGrpCat.free) G₁) u).app (Opposite.op U') ≫
              φ.hom.app (Opposite.op U') :=
          congrArg (fun k => k.app (Opposite.op U')) hr
        dsimp [homEquiv_V, freeAdjPSh, CategoryTheory.yonedaEquiv]
        rw [hr_app]
        exact CategoryTheory.ConcreteCategory.congr_hom
          (AddCommGrpCat.adj.homEquiv_naturality_right _ (φ.hom.app (Opposite.op U'))) (𝟙 U')
      have hEquivX_map : ∀ {U₁ U₂ : X_U.Etale} (g : U₁ ⟶ U₂)
          (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (u : L_X.obj U₂ ⟶ F),
          homEquiv_X U₁ F (L_X.map g ≫ u) = (F.obj.map g.op).hom (homEquiv_X U₂ F u) := by
        intro U₁ U₂ g F u
        let β := freeAdjPSh (CategoryTheory.yoneda.obj U₂) F.obj
          (adj_shX.homEquiv (CategoryTheory.yoneda.obj U₂ ⋙ AddCommGrpCat.free) F u)
        have hnat := CategoryTheory.ConcreteCategory.congr_hom (β.naturality g.op) (𝟙 U₂)
        have hl_sh := congrArg (fun k => k.app (Opposite.op U₁))
          (adj_shX.homEquiv_naturality_left
            (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map g) AddCommGrpCat.free) u)
        dsimp [homEquiv_X, L_X, freeAdjPSh, CategoryTheory.yonedaEquiv, β] at hnat hl_sh ⊢
        rw [Category.comp_id] at hnat
        rw [hl_sh]
        have hl := CategoryTheory.ConcreteCategory.congr_hom
          (AddCommGrpCat.adj.homEquiv_naturality_left
            ((CategoryTheory.yoneda.map g).app (Opposite.op U₁))
            ((adj_shX.homEquiv (CategoryTheory.yoneda.obj U₂ ⋙ AddCommGrpCat.free) F u).app
              (Opposite.op U₁))) (𝟙 U₁)
        dsimp at hl
        rw [Category.id_comp] at hl
        exact hl.trans hnat
      have hEquivV_map : ∀ {U₁' U₂' : V_U.Etale} (g : U₁' ⟶ U₂')
