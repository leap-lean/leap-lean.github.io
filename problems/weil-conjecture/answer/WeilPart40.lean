    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (hMem V E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (m : ↥c.pt),
          LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj w.obj.left).left ↥A :=
        fun c w m => (c.π.app (Opposite.op w)).hom m
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
          (y₁ : ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj w₁.obj.left).left)
          (y₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj w₂.obj.left).left),
          ((AlgebraicGeometry.Scheme.Etale.forget V).map w₁.obj.hom).left.base y₁ =
            ((AlgebraicGeometry.Scheme.Etale.forget V).map w₂.obj.hom).left.base y₂ →
          eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
        intro c w₁ w₂ m y₁ y₂ hy_eq
        let Y₁ : V.Etale := w₁.obj.left
        let Y₂ : V.Etale := w₂.obj.left
        let u₁ : Y₁ ⟶ E := w₁.obj.hom
        let u₂ : Y₂ ⟶ E := w₂.obj.hom
        let u₁_left : Y₁.left ⟶ E.left :=
          ((AlgebraicGeometry.Scheme.Etale.forget V).map u₁).left
        let u₂_left : Y₂.left ⟶ E.left :=
          ((AlgebraicGeometry.Scheme.Etale.forget V).map u₂).left
        let Z_sch := CategoryTheory.Limits.pullback u₁_left u₂_left
        let p₁ : Z_sch ⟶ Y₁.left := CategoryTheory.Limits.pullback.fst u₁_left u₂_left
        let p₂ : Z_sch ⟶ Y₂.left := CategoryTheory.Limits.pullback.snd u₁_left u₂_left
        have hu₂_et : AlgebraicGeometry.Etale u₂_left := hMorEtale V u₂
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
