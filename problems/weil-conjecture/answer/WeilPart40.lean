        change u_hom.base (e_U.base x_A) = i_s.base z₀
        rw [hx_A, hz₀]
      obtain ⟨v₀, hv₀_p₁, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x_A z₀ hcomm_xA
      let s₀ : ↑(𝒢.obj.obj (Opposite.op V₀)) :=
        (𝒢.obj.map (Opposite.op (B_is.map g₀))).hom s
      have hs₀_mem := (hMem_etale V₀ _).mp (hLoc_Z.imageSieve_mem s₀)
      obtain ⟨Y_Z, h_Z, y_Z, hh_sieve, hh_et, hh_pt⟩ := hs₀_mem v₀
      let X_YZ : AlgebraicGeometry.Scheme.{u} := Y_Z.left
      let h_Z_left : X_YZ ⟶ X_V₀ := h_Z.left
      haveI hh_Z_et : AlgebraicGeometry.Etale h_Z_left := hh_et
      obtain ⟨O_Z, hAff_OZ, hy_OZ, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : X_YZ.Opens))
          (x := y_Z) trivial
      let B_Z := X_YZ.presheaf.obj (Opposite.op O_Z)
      let e_OZ : AlgebraicGeometry.Spec B_Z ⟶ X_YZ := hAff_OZ.fromSpec
      let p_bar : ↥(AlgebraicGeometry.Spec B_Z) := hAff_OZ.isoSpec.hom.base ⟨y_Z, hy_OZ⟩
      have hp_bar : e_OZ.base p_bar = y_Z := by
        change (hAff_OZ.isoSpec.hom ≫ hAff_OZ.fromSpec).base ⟨y_Z, hy_OZ⟩ = y_Z
        have hcomp : hAff_OZ.isoSpec.hom ≫ hAff_OZ.fromSpec = O_Z.ι := by
          rw [AlgebraicGeometry.IsAffineOpen.fromSpec, CategoryTheory.Iso.hom_inv_id_assoc]
