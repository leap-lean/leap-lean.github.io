      @Ideal.eq_bot_of_prime k _ pt_k.asIdeal pt_k.isPrime
    have hpt_K_bot : pt_K.asIdeal = ⊥ :=
      @Ideal.eq_bot_of_prime K _ pt_K.asIdeal pt_K.isPrime
    have hker_eq : RingHom.ker α.hom = RingHom.ker β.hom := by
      have h1 : ((AlgebraicGeometry.Spec.map α).base pt_k).asIdeal =
          Ideal.comap α.hom pt_k.asIdeal := rfl
      have h2 : ((AlgebraicGeometry.Spec.map β).base pt_K).asIdeal =
          Ideal.comap β.hom pt_K.asIdeal := rfl
      rw [AlgebraicGeometry.Spec.map_preimage] at h1 h2
      rw [RingHom.ker_eq_comap_bot, RingHom.ker_eq_comap_bot, ← hpt_k_bot, ← hpt_K_bot,
