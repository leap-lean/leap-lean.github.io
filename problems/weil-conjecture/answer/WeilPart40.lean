      apply hU.fromSpec.isOpenEmbedding.injective
      have h1 : hU.fromSpec.base (g_aff.base pt_K) = g.base pt_K := by
        rw [← hg_fac]; rfl
      have h2 : hU.fromSpec.base (s_aff.base pt_k) = x_Rbar.base pt_k := by
        rw [← hs_fac]; rfl
      rw [h1, h2, h_pt]
