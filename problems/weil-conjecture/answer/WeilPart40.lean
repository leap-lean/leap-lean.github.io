          · change (x.comp (CategoryTheory.Abelian.Ext.mk₀ δ_iso) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv δ_iso)) (Nat.add_zero 1) = x
            rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _
                (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
          · change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv δ_iso)) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ δ_iso) (Nat.add_zero 1) = y
            rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _
                (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
      have hSurj_e : Function.Surjective e := by
        intro y
        obtain ⟨s, hs⟩ := hBij_δdirT.2 y
        obtain ⟨q, hq⟩ := hSurj_eQ s
        refine ⟨δ_glob q, ?_⟩
        have hc := hNat_conn SC hSE (k + 1) q
        change δ_dir_app.hom (e_Q q) = e (δ_glob q) at hc
        rw [← hc, hq, hs]
      let e_glob := AddEquiv.ofBijective δ_glob hBij_δglob
      have hker_fwd : ∀ z : ↥(AddMonoidHom.ker e_Q), δ_glob z.1 ∈ AddMonoidHom.ker e := by
        intro z
        rw [AddMonoidHom.mem_ker]
        have hc := hNat_conn SC hSE (k + 1) z.1
        change δ_dir_app.hom (e_Q z.1) = e (δ_glob z.1) at hc
        rw [← hc]
        have hz : e_Q z.1 = 0 := z.2
        rw [hz, map_zero]
      have hker_bwd : ∀ w : ↥(AddMonoidHom.ker e), e_glob.symm w.1 ∈ AddMonoidHom.ker e_Q := by
        intro w
        rw [AddMonoidHom.mem_ker]
        apply hBij_δdirT.1
        rw [map_zero]
        have hc := hNat_conn SC hSE (k + 1) (e_glob.symm w.1)
        change δ_dir_app.hom (e_Q (e_glob.symm w.1)) = e (δ_glob (e_glob.symm w.1)) at hc
        have hew : δ_glob (e_glob.symm w.1) = w.1 := e_glob.apply_symm_apply w.1
        rw [hc, hew]
        exact w.2
      let e_glob_ker : ↥(AddMonoidHom.ker e_Q) ≃+ ↥(AddMonoidHom.ker e) :=
        { toFun := fun z => ⟨δ_glob z.1, hker_fwd z⟩
          invFun := fun w => ⟨e_glob.symm w.1, hker_bwd w⟩
          left_inv := fun z => Subtype.ext (e_glob.symm_apply_apply z.1)
          right_inv := fun w => Subtype.ext (e_glob.apply_symm_apply w.1)
          map_add' := fun a b => Subtype.ext (map_add δ_glob a.1 b.1) }
      exact ⟨hSurj_e,
        ⟨e_glob_ker.symm.trans (e_ker_Q.trans (AddEquiv.ofBijective δ_k_1 hBij_δk1))⟩⟩
  exact hMain q₀ ℱ hTor

theorem weil_henselian_dvr_prime_kummer_h1_card (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (R_s : Type u) [CommRing R_s] [IsDomain R_s] [IsLocalRing R_s]
    [HenselianLocalRing R_s] [IsDiscreteValuationRing R_s]
    (π_s : R_s →+* k) (p_k : k →+* R_s)
    (h_res_sec : π_s.comp p_k = RingHom.id k)
    (h_ker_π : RingHom.ker π_s = IsLocalRing.maximalIdeal R_s)
    (t_s : R_s) (ht_ne : t_s ≠ 0)
    (hmax_t : IsLocalRing.maximalIdeal R_s = Ideal.span {t_s})
    (K_s : Type u) [Field K_s] (ι_RK : R_s →+* K_s)
    (hLoc_K : @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra) :
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K_s)
    Finite (weilEtaleTorsionH S_K ℓ 1) ∧
    Nat.card (weilEtaleTorsionH S_K ℓ 1) = ℓ :=
by
  intro S_K
  have hPrime : Nat.Prime ℓ := Fact.out
  
  have hPartA : (∃ ζ₀ : k, ζ₀ ^ ℓ = 1 ∧ ζ₀ ≠ 1) ∧ (∀ u : R_sˣ, ∃ w : R_sˣ, w ^ ℓ = u) := by
    refine ⟨?_, ?_⟩
    · let P₁ : Polynomial k := ∑ i ∈ Finset.range ℓ, (Polynomial.X : Polynomial k) ^ i
      have h_geom : P₁ * (Polynomial.X - 1) = Polynomial.X ^ ℓ - 1 :=
        geom_sum_mul (Polynomial.X : Polynomial k) ℓ
      have hdeg_ne : P₁.degree ≠ 0 := by
        intro hd
        have hC : P₁ = Polynomial.C (P₁.coeff 0) := Polynomial.eq_C_of_degree_le_zero hd.le
        have hcoeff := congrArg (fun q : Polynomial k => q.coeff ℓ) h_geom
        rw [hC, Polynomial.coeff_C_mul, Polynomial.coeff_sub, Polynomial.coeff_sub,
          Polynomial.coeff_X_pow, ite_eq_left_iff.mpr (fun h => absurd rfl h),
          Polynomial.coeff_one] at hcoeff
        have hX0 : (Polynomial.X : Polynomial k).coeff ℓ = 0 := by
          rw [Polynomial.coeff_X]
          exact ite_eq_right_iff.mpr fun h => absurd h.symm hPrime.ne_one
        have h10 : (if ℓ = 0 then (1 : k) else 0) = 0 :=
          ite_eq_right_iff.mpr fun h => absurd h hPrime.ne_zero
        rw [hX0, h10, sub_zero, mul_zero, sub_zero] at hcoeff
        exact zero_ne_one hcoeff
      obtain ⟨ζ₀, hζ₀_root⟩ := IsAlgClosed.exists_root P₁ hdeg_ne
      have hζ₀_eval : Polynomial.eval ζ₀ P₁ = 0 := hζ₀_root
      have h_eval_geom := congrArg (Polynomial.eval ζ₀) h_geom
      simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_one,
        Polynomial.eval_pow, hζ₀_eval, zero_mul] at h_eval_geom
      have hζ₀_pow : ζ₀ ^ ℓ = 1 := sub_eq_zero.mp h_eval_geom.symm
      have hζ₀_ne : ζ₀ ≠ 1 := by
        intro h1
        subst h1
        simp only [P₁, Polynomial.eval_finsetSum, Polynomial.eval_pow, Polynomial.eval_X,
          one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one] at hζ₀_eval
        exact hℓ hζ₀_eval
      exact ⟨ζ₀, hζ₀_pow, hζ₀_ne⟩
    · intro u
      have hc₀_ne : π_s (u : R_s) ≠ 0 := by
        intro hc0
        have h1 : π_s ((u : R_s) * ↑(u⁻¹)) = 1 := by rw [Units.mul_inv, map_one]
        rw [map_mul, hc0, zero_mul] at h1
        exact zero_ne_one h1
      obtain ⟨b₀, hb₀_pow⟩ := IsAlgClosed.exists_pow_nat_eq (π_s (u : R_s)) hPrime.pos
      have hb₀_ne : b₀ ≠ 0 := by
        intro hb0
        rw [hb0, zero_pow hPrime.ne_zero] at hb₀_pow
        exact hc₀_ne hb₀_pow.symm
      let a₀ : R_s := p_k b₀
      have hπ_a₀ : π_s a₀ = b₀ := congrArg (fun φ : k →+* k => φ b₀) h_res_sec
      let f : Polynomial R_s := Polynomial.X ^ ℓ - Polynomial.C (u : R_s)
      have hf_mon : f.Monic := Polynomial.monic_X_pow_sub_C (u : R_s) hPrime.ne_zero
      have hf_eval_mem : Polynomial.eval a₀ f ∈ IsLocalRing.maximalIdeal R_s := by
        rw [← h_ker_π, RingHom.mem_ker]
        simp only [f, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
          Polynomial.eval_C, map_sub, map_pow, hπ_a₀, hb₀_pow, sub_self]
      have hf_deriv_unit : IsUnit (Polynomial.eval a₀ f.derivative) := by
        rw [← IsLocalRing.notMem_maximalIdeal, ← h_ker_π, RingHom.mem_ker]
        have hder : Polynomial.eval a₀ f.derivative = (ℓ : R_s) * a₀ ^ (ℓ - 1) := by
          simp [f, Polynomial.derivative_X_pow]
        rw [hder, map_mul, map_natCast, map_pow, hπ_a₀]
        exact mul_ne_zero hℓ (pow_ne_zero (ℓ - 1) hb₀_ne)
      obtain ⟨a, ha_root, -⟩ :=
        HenselianLocalRing.is_henselian f hf_mon a₀ hf_eval_mem hf_deriv_unit
      have ha_pow : a ^ ℓ = (u : R_s) := by
        rw [Polynomial.IsRoot.def] at ha_root
        simp only [f, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
          Polynomial.eval_C] at ha_root
        exact sub_eq_zero.mp ha_root
      have ha_inv : a * (a ^ (ℓ - 1) * ↑(u⁻¹)) = 1 := by
        calc
          a * (a ^ (ℓ - 1) * ↑(u⁻¹)) = (a ^ 1 * a ^ (ℓ - 1)) * ↑(u⁻¹) := by rw [pow_one, mul_assoc]
          _ = a ^ (1 + (ℓ - 1)) * ↑(u⁻¹) := by rw [← pow_add]
          _ = a ^ ℓ * ↑(u⁻¹) := by rw [Nat.add_sub_of_le hPrime.pos]
          _ = (u : R_s) * ↑(u⁻¹) := by rw [ha_pow]
          _ = 1 := Units.mul_inv u
      let w : R_sˣ := Units.mkOfMulEqOne a (a ^ (ℓ - 1) * ↑(u⁻¹)) ha_inv
      refine ⟨w, Units.ext ?_⟩
      change a ^ ℓ = (u : R_s)
      exact ha_pow
  obtain ⟨⟨ζ₀, hζ₀_pow, hζ₀_ne⟩, hUnitPow⟩ := hPartA
  
  have hPartB : ∃ v_bar : Additive (K_sˣ) →+ ZMod ℓ,
      Function.Surjective v_bar ∧
      ∀ z : Additive (K_sˣ), v_bar z = 0 ↔ ∃ w : Additive (K_sˣ), ℓ • w = z := by
    let _ : Algebra R_s K_s := ι_RK.toAlgebra
    have _ : IsLocalization.Away t_s K_s := hLoc_K
    have h_le_nzd : Submonoid.powers t_s ≤ nonZeroDivisors R_s := by
      intro y hy
      rw [Submonoid.mem_powers_iff] at hy
      obtain ⟨m, rfl⟩ := hy
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m ht_ne)
    have hinj_RK : Function.Injective ι_RK := IsLocalization.injective K_s h_le_nzd
    have h_ιt : ι_RK t_s ≠ 0 := fun h => ht_ne (hinj_RK (h.trans (map_zero ι_RK).symm))
    let τ : K_sˣ := Units.mk0 (ι_RK t_s) h_ιt
    let ι_u : Additive (R_sˣ) →+ Additive (K_sˣ) :=
      MonoidHom.toAdditive (Units.map ι_RK.toMonoidHom)
    let Φ : Additive (R_sˣ) × ℤ →+ Additive (K_sˣ) :=
      { toFun := fun p => ι_u p.1 + p.2 • Additive.ofMul τ
        map_zero' := by simp
        map_add' := fun p₁ p₂ => by
          simp only [Prod.fst_add, Prod.snd_add, map_add, add_zsmul]
          exact add_add_add_comm _ _ _ _ }
    have hInj_Φ : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      rintro ⟨u, d⟩ h0
      let u₀ : R_sˣ := Additive.toMul u
      have hmul : (Units.map ι_RK.toMonoidHom u₀) * τ ^ d = 1 := by
        have h1 := congrArg Additive.toMul h0
        simpa [Φ, ι_u, u₀, toMul_add, toMul_zsmul] using h1
      cases d with
      | ofNat n =>
        cases n with
        | zero =>
          simp only [Int.ofNat_eq_natCast, Nat.cast_zero, zpow_zero, mul_one] at hmul
          have hu_val : ι_RK (u₀ : R_s) = ι_RK 1 := by
            simpa [map_one] using congrArg Units.val hmul
          have hu₀_one : u₀ = 1 := Units.ext (hinj_RK hu_val)
          have hu_zero : u = 0 := by
            change Additive.ofMul u₀ = 0
            rw [hu₀_one, ofMul_one]
          exact Prod.ext hu_zero rfl
        | succ n =>
          exfalso
          simp only [Int.ofNat_eq_natCast, zpow_natCast] at hmul
          have hval : ι_RK ((u₀ : R_s) * t_s ^ (n + 1)) = ι_RK 1 := by
            have hv := congrArg Units.val hmul
            simpa [τ, map_mul, map_pow, map_one] using hv
          have hR1 : (u₀ : R_s) * t_s ^ (n + 1) = 1 := hinj_RK hval
          have hmem : (1 : R_s) ∈ IsLocalRing.maximalIdeal R_s := by
            rw [hmax_t, Ideal.mem_span_singleton]
            exact ⟨(u₀ : R_s) * t_s ^ n, by rw [← hR1]; ring⟩
          exact (IsLocalRing.maximalIdeal.isMaximal R_s).ne_top
            ((Ideal.eq_top_iff_one _).mpr hmem)
      | negSucc n =>
        exfalso
        rw [zpow_negSucc, mul_inv_eq_one] at hmul
        have hval : ι_RK (u₀ : R_s) = ι_RK (t_s ^ (n + 1)) := by
          have hv := congrArg Units.val hmul
          simpa [τ, map_pow] using hv
        have hu_eq : (u₀ : R_s) = t_s ^ (n + 1) := hinj_RK hval
        have hmem : (u₀ : R_s) ∈ IsLocalRing.maximalIdeal R_s := by
          rw [hmax_t, Ideal.mem_span_singleton]
          exact ⟨t_s ^ n, by rw [hu_eq]; ring⟩
        exact (IsLocalRing.notMem_maximalIdeal.mpr u₀.isUnit) hmem
    have hSurj_Φ : Function.Surjective Φ := by
      have hprime_max : (IsLocalRing.maximalIdeal R_s).IsPrime :=
        (IsLocalRing.maximalIdeal.isMaximal R_s).isPrime
      rw [hmax_t] at hprime_max
      have ht_irr : Irreducible t_s :=
        ((Ideal.span_singleton_prime ht_ne).mp hprime_max).irreducible
      intro z
      let x : K_sˣ := Additive.toMul z
      obtain ⟨⟨a, s⟩, hsurj_s⟩ := IsLocalization.surj (Submonoid.powers t_s) (x : K_s)
      have hs_mem : s.1 ∈ Submonoid.powers t_s := s.2
      rw [Submonoid.mem_powers_iff] at hs_mem
      obtain ⟨m, hm⟩ := hs_mem
      have h_eq_K : (x : K_s) * (ι_RK t_s) ^ m = ι_RK a := by
        change (x : K_s) * ι_RK s.1 = ι_RK a at hsurj_s
        rw [← hm, map_pow] at hsurj_s
        exact hsurj_s
      have ha_ne : a ≠ 0 := by
        intro ha0
        rw [ha0, map_zero] at h_eq_K
        exact mul_ne_zero x.ne_zero (pow_ne_zero m h_ιt) h_eq_K
      obtain ⟨n, v₀, hv₀⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha_ne ht_irr
      let u₀ : R_sˣ := v₀⁻¹
      have ha_fac : a = (u₀ : R_s) * t_s ^ n := by
        calc
          a = (a * (v₀ : R_s)) * (u₀ : R_s) := by
            dsimp [u₀]; rw [mul_assoc, Units.mul_inv, mul_one]
          _ = t_s ^ n * (u₀ : R_s) := by rw [hv₀]
          _ = (u₀ : R_s) * t_s ^ n := mul_comm _ _
      have hx_units : x * τ ^ m = (Units.map ι_RK.toMonoidHom u₀) * τ ^ n := by
        apply Units.ext
        simpa [τ, ha_fac, map_mul, map_pow] using h_eq_K
      have hx_eq : x = (Units.map ι_RK.toMonoidHom u₀) * τ ^ ((n : ℤ) - (m : ℤ)) := by
        rw [zpow_sub, zpow_natCast, zpow_natCast, ← mul_assoc, ← hx_units, mul_inv_cancel_right]
      refine ⟨(Additive.ofMul u₀, (n : ℤ) - (m : ℤ)), ?_⟩
      have h_ofMul := congrArg Additive.ofMul hx_eq
      simpa [Φ, ι_u, x, ofMul_mul, ofMul_zpow] using h_ofMul.symm
    let e_val : (Additive (R_sˣ) × ℤ) ≃+ Additive (K_sˣ) :=
      AddEquiv.ofBijective Φ ⟨hInj_Φ, hSurj_Φ⟩
    let v_bar : Additive (K_sˣ) →+ ZMod ℓ :=
      (Int.castAddHom (ZMod ℓ)).comp
        ((AddMonoidHom.snd (Additive (R_sˣ)) ℤ).comp e_val.symm.toAddMonoidHom)
    refine ⟨v_bar, ?_, ?_⟩
    · intro c
      obtain ⟨d, rfl⟩ := ZMod.intCast_surjective c
      refine ⟨e_val (0, d), ?_⟩
      simp [v_bar]
    · intro z
      constructor
      · intro hz
        have hd_zero : (((e_val.symm z).2 : ℤ) : ZMod ℓ) = 0 := hz
        obtain ⟨q, hq⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd ((e_val.symm z).2) ℓ).mp hd_zero
        obtain ⟨w₀, hw₀⟩ := hUnitPow (Additive.toMul (e_val.symm z).1)
        have hu_nsmul : ℓ • Additive.ofMul w₀ = (e_val.symm z).1 := by
          have h1 := congrArg Additive.ofMul hw₀
          simpa [ofMul_pow] using h1
        have hd_nsmul : ℓ • q = (e_val.symm z).2 := by
          rw [nsmul_eq_mul, hq.symm]
        refine ⟨e_val (Additive.ofMul w₀, q), ?_⟩
        calc
          ℓ • e_val (Additive.ofMul w₀, q)
              = e_val (ℓ • (Additive.ofMul w₀, q)) := (map_nsmul e_val _ _).symm
          _ = e_val (ℓ • Additive.ofMul w₀, ℓ • q) := rfl
          _ = e_val ((e_val.symm z).1, (e_val.symm z).2) := by rw [hu_nsmul, hd_nsmul]
          _ = z := e_val.apply_symm_apply z
      · rintro ⟨w, rfl⟩
        change (((e_val.symm (ℓ • w)).2 : ℤ) : ZMod ℓ) = 0
        rw [map_nsmul]
        change ((ℓ • (e_val.symm w).2 : ℤ) : ZMod ℓ) = 0
        rw [nsmul_eq_mul, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, zero_mul]
  
  let φ_kK : k →+* K_s := ι_RK.comp p_k
  have hζ_pow : (φ_kK ζ₀) ^ ℓ = 1 := by
    rw [← map_pow, hζ₀_pow, map_one]
  have hζ_ne : φ_kK ζ₀ ≠ 1 := fun h =>
    hζ₀_ne (φ_kK.injective (h.trans (map_one φ_kK).symm))
  have hGm : ∀ (F : Type u) [Field F],
      CategoryTheory.Presheaf.IsSheaf (weilC1AffEtTop F) (weilC1AffEtGmPresheaf F) :=
    fun F _ => weil_c1_affEt_gm_isSheaf F
  have hH1 : Subsingleton ((weilC1AffEtGmSheaf K_s (hGm K_s)).H 1) :=
    weil_c1_affEt_hilbert90_gm_H1_vanishing hGm K_s
  obtain ⟨ι_kum, h0_kum, hSE⟩ :=
    weil_c1_affEt_kummer_short_exact hGm K_s ℓ ⟨φ_kK ζ₀, hζ_pow, hζ_ne⟩
  
  have hPartC : ∃ δ_et : Additive (K_sˣ) →+ weilEtaleTorsionH S_K ℓ 1,
      Function.Surjective δ_et ∧
      ∀ z : Additive (K_sˣ), δ_et z = 0 ↔ ∃ w : Additive (K_sˣ), ℓ • w = z := by
    let J_aff := weilC1AffEtTop K_s
    let C_aff := CategoryTheory.constantSheaf J_aff AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Aℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let Gm_K := weilC1AffEtGmSheaf K_s (hGm K_s)
    let Const_ℓ := C_aff.obj Aℓ
    let T_aff : S_K.AffineEtale :=
      AlgebraicGeometry.Scheme.AffineEtale.mk (CategoryTheory.CategoryStruct.id S_K)
    have hT_aff : CategoryTheory.Limits.IsTerminal T_aff :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W => CategoryTheory.MorphismProperty.CostructuredArrow.homMk
          (AlgebraicGeometry.Scheme.Spec.preimage W.hom) trivial
          ((CategoryTheory.Category.comp_id _).trans
            (AlgebraicGeometry.Scheme.Spec.map_preimage W.hom)))
        (fun W m => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.Spec.map_injective
            ((((CategoryTheory.Category.comp_id
                (AlgebraicGeometry.Scheme.Spec.map m.left)).symm.trans m.w).trans
              ((congrArg (W.hom ≫ ·) (CategoryTheory.Functor.map_id _ _)).trans
                (CategoryTheory.Category.comp_id W.hom))).trans
              (AlgebraicGeometry.Scheme.Spec.map_preimage W.hom).symm))
          (Subsingleton.elim _ _))
    let adj_aff := CategoryTheory.constantSheafAdj J_aff AddCommGrpCat.{u} hT_aff
    let eval_ℤ : (Aℤ ⟶ AddCommGrpCat.of (Additive (K_sˣ))) ≃+ Additive (K_sˣ) :=
      { toFun := fun φ => φ.hom (ULift.up (1 : ℤ))
        invFun := fun z => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • z
            map_zero' := zero_zsmul z
            map_add' := fun a b => add_zsmul z a.down b.down }
        left_inv := fun φ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun n => by
          change n.down • φ.hom (ULift.up 1) = φ.hom n
          have hn : n.down • (ULift.up (1 : ℤ) : ULift.{u} ℤ) = n :=
            ULift.ext _ _ (mul_one n.down)
          rw [← map_zsmul, hn])
        right_inv := fun z => one_zsmul z
        map_add' := fun _ _ => rfl }
    let e₀ : Gm_K.H 0 ≃+ Additive (K_sˣ) :=
      CategoryTheory.Abelian.Ext.addEquiv₀.trans ((adj_aff.homAddEquiv Aℤ Gm_K).trans eval_ℤ)
    let δ₀ : Gm_K.H 0 →+ Const_ℓ.H 1 :=
      (hSE.extClass).postcomp (C_aff.obj Aℤ) (Nat.zero_add 1)
    have hnsmul_comp : ∀ (n : ℕ) (x₂ : Gm_K.H 0),
        x₂.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id Gm_K))
          (Nat.add_zero 0) = n • x₂ := by
      intro n x₂
      induction n with
      | zero =>
        rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih,
          CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hSurj_δ₀ : Function.Surjective δ₀ := by
      intro w
      have hw : w.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1) = 0 :=
        @Subsingleton.elim _ hH1 _ 0
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
        (C_aff.obj Aℤ) hSE w hw (Nat.zero_add 1)
    have hKer_δ₀ : ∀ x₃ : Gm_K.H 0, δ₀ x₃ = 0 ↔ ∃ x₂ : Gm_K.H 0, ℓ • x₂ = x₃ := by
      intro x₃
      constructor
      · intro hx₃
        obtain ⟨x₂, hx₂⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
          (C_aff.obj Aℤ) hSE x₃ (Nat.zero_add 1) hx₃
        exact ⟨x₂, (hnsmul_comp ℓ x₂).symm.trans hx₂⟩
      · rintro ⟨x₂, rfl⟩
        change (ℓ • x₂).comp hSE.extClass (Nat.zero_add 1) = 0
        rw [← hnsmul_comp ℓ x₂,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero]
        have hcomp0 : (CategoryTheory.Abelian.Ext.mk₀
            (ℓ • CategoryTheory.CategoryStruct.id Gm_K)).comp hSE.extClass (Nat.zero_add 1) = 0 :=
          hSE.comp_extClass
        rw [hcomp0, CategoryTheory.Abelian.Ext.comp_zero]
    let J_et := S_K.smallEtaleTopology
    let C_et := CategoryTheory.constantSheaf J_et AddCommGrpCat.{u}
    let eqv := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S_K AddCommGrpCat.{u}
    have hEqvExtLeft : ∀ {𝒞₁ 𝒞₂ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} 𝒞₁] [CategoryTheory.Abelian 𝒞₁]
        [CategoryTheory.HasExt.{u} 𝒞₁]
        [CategoryTheory.Category.{u + 1, u + 1} 𝒞₂] [CategoryTheory.Abelian 𝒞₂]
        [CategoryTheory.HasExt.{u} 𝒞₂]
        (E : 𝒞₁ ≌ 𝒞₂)
        [E.functor.Additive] [CategoryTheory.Limits.PreservesFiniteLimits E.functor]
        [CategoryTheory.Limits.PreservesFiniteColimits E.functor]
        [E.inverse.Additive] [CategoryTheory.Limits.PreservesFiniteLimits E.inverse]
        [CategoryTheory.Limits.PreservesFiniteColimits E.inverse]
        (X Y : 𝒞₁) (w : CategoryTheory.Abelian.Ext.{u} X Y 1),
        ((CategoryTheory.Abelian.Ext.mk₀ (E.unitIso.hom.app X)).comp
          (E.inverse.mapExtAddHom (E.functor.obj X) (E.functor.obj Y) 1
            (E.functor.mapExtAddHom X Y 1 w))
          (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (E.unitIso.inv.app Y)) (Nat.add_zero 1) = w := by
      intro 𝒞₁ 𝒞₂ _ _ _ _ _ _ E _ _ _ _ _ _ X Y w
      change ((CategoryTheory.Abelian.Ext.mk₀ (E.unitIso.hom.app X)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor E.inverse
          (CategoryTheory.Abelian.Ext.mapExactFunctor E.functor w))
        (Nat.zero_add 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (E.unitIso.inv.app Y)) (Nat.add_zero 1) = w
      rw [← CategoryTheory.Abelian.Ext.comp_mapExactFunctor,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp w E.unitIso.inv,
        CategoryTheory.Abelian.Ext.id_mapExactFunctor,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
        E.unitIso.hom_inv_id_app X,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts eqv.functor :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts eqv.functor
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts eqv.inverse :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts eqv.inverse
    let hAddF : eqv.functor.Additive :=
      CategoryTheory.Functor.additive_of_preservesBinaryBiproducts eqv.functor
    let hAddG : eqv.inverse.Additive :=
      CategoryTheory.Functor.additive_of_preservesBinaryBiproducts eqv.inverse
    let X_aff := C_aff.obj Aℤ
    let Y_aff := Const_ℓ
    let fwd_ext : CategoryTheory.Abelian.Ext.{u} X_aff Y_aff 1 →+
        CategoryTheory.Abelian.Ext.{u} (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) 1 :=
      eqv.functor.mapExtAddHom X_aff Y_aff 1
    let bwd_ext : CategoryTheory.Abelian.Ext.{u} (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) 1 →+
        CategoryTheory.Abelian.Ext.{u} X_aff Y_aff 1 :=
      ((CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.inv.app Y_aff)).postcomp X_aff
        (Nat.add_zero 1)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.hom.app X_aff)).precomp
          (eqv.inverse.obj (eqv.functor.obj Y_aff)) (Nat.zero_add 1)).comp
          (eqv.inverse.mapExtAddHom (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) 1))
    have hbwd_fwd : ∀ w : CategoryTheory.Abelian.Ext.{u} X_aff Y_aff 1, bwd_ext (fwd_ext w) = w :=
      fun w => hEqvExtLeft eqv X_aff Y_aff w
    have hbwd_inj : Function.Injective bwd_ext := by
      rw [injective_iff_map_eq_zero]
      intro v hv
      let u := eqv.inverse.mapExtAddHom (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) 1 v
      have hu_conj : ((CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.hom.app X_aff)).comp u
          (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.inv.app Y_aff)) (Nat.add_zero 1) = 0 := hv
      have hu_zero : u = 0 := by
        have h1 : (((CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.inv.app X_aff)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.hom.app X_aff)).comp u
              (Nat.zero_add 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.inv.app Y_aff)) (Nat.add_zero 1))
            (Nat.zero_add 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (eqv.unitIso.hom.app Y_aff)) (Nat.add_zero 1) :
            CategoryTheory.Abelian.Ext.{u} _ _ 1) = 0 := by
          rw [hu_conj, CategoryTheory.Abelian.Ext.comp_zero, CategoryTheory.Abelian.Ext.zero_comp]
        have hidY : eqv.unitIso.inv.app Y_aff ≫ eqv.unitIso.hom.app Y_aff =
            𝟙 (eqv.inverse.obj (eqv.functor.obj Y_aff)) :=
          eqv.unitIso.inv_hom_id_app Y_aff
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          hidY,
          CategoryTheory.Abelian.Ext.comp_mk₀_id,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
          eqv.unitIso.inv_hom_id_app X_aff] at h1
        exact (CategoryTheory.Abelian.Ext.mk₀_id_comp u).symm.trans h1
      let _ : eqv.symm.functor.Additive := hAddG
      let _ : eqv.symm.inverse.Additive := hAddF
      have hleft_symm := hEqvExtLeft eqv.symm (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) v
      change ((CategoryTheory.Abelian.Ext.mk₀
          (eqv.symm.unitIso.hom.app (eqv.functor.obj X_aff))).comp
        (eqv.functor.mapExtAddHom _ _ 1 u) (Nat.zero_add 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (eqv.symm.unitIso.inv.app (eqv.functor.obj Y_aff)))
        (Nat.add_zero 1) = v at hleft_symm
      rw [hu_zero, map_zero, CategoryTheory.Abelian.Ext.comp_zero,
        CategoryTheory.Abelian.Ext.zero_comp] at hleft_symm
      exact hleft_symm.symm
    let e_ext_raw : CategoryTheory.Abelian.Ext.{u} X_aff Y_aff 1 ≃+
        CategoryTheory.Abelian.Ext.{u} (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) 1 :=
      { toFun := fwd_ext
        invFun := bwd_ext
        left_inv := hbwd_fwd
        right_inv := fun v => hbwd_inj (hbwd_fwd (bwd_ext v))
        map_add' := fwd_ext.map_add }
    let T_et : S_K.Etale := (AlgebraicGeometry.Scheme.AffineEtale.Spec S_K).obj T_aff
    have hT_et : CategoryTheory.Limits.IsTerminal T_et :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
          (CategoryTheory.Category.comp_id W.hom))
        (fun W m => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (((CategoryTheory.Category.comp_id m.left).symm.trans m.w).trans
            ((congrArg (W.hom ≫ ·) (CategoryTheory.Functor.map_id _ _)).trans
              (CategoryTheory.Category.comp_id W.hom)))
          (Subsingleton.elim _ _))
    let adj_et := CategoryTheory.constantSheafAdj J_et AddCommGrpCat.{u} hT_et
    let secIso : eqv.inverse ⋙ (CategoryTheory.sheafSections J_aff AddCommGrpCat.{u}).obj
        (Opposite.op T_aff) ≅
        (CategoryTheory.sheafSections J_et AddCommGrpCat.{u}).obj (Opposite.op T_et) :=
      CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
        (fun f => (CategoryTheory.Category.comp_id (f.hom.app (Opposite.op T_et))).trans
          (CategoryTheory.Category.id_comp (f.hom.app (Opposite.op T_et))).symm)
    let constIso : C_aff ⋙ eqv.functor ≅ C_et :=
      CategoryTheory.Adjunction.leftAdjointUniq
        ((adj_aff.comp eqv.toAdjunction).ofNatIsoRight secIso) adj_et
    let isoℤ : eqv.functor.obj X_aff ≅ C_et.obj Aℤ := constIso.app Aℤ
    let isoℓ : eqv.functor.obj Y_aff ≅ C_et.obj Aℓ := constIso.app Aℓ
    let e_conj : CategoryTheory.Abelian.Ext.{u} (eqv.functor.obj X_aff) (eqv.functor.obj Y_aff) 1 ≃+
        weilEtaleTorsionH S_K ℓ 1 :=
      { toFun := fun v => ((CategoryTheory.Abelian.Ext.mk₀ isoℤ.inv).comp v (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ isoℓ.hom) (Nat.add_zero 1)
        invFun := fun v => ((CategoryTheory.Abelian.Ext.mk₀ isoℤ.hom).comp v (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ isoℓ.inv) (Nat.add_zero 1)
        left_inv := fun v => by
          dsimp only
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, isoℓ.hom_inv_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, isoℤ.hom_inv_id,
            CategoryTheory.Abelian.Ext.mk₀_id_comp]
        right_inv := fun v => by
          dsimp only
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, isoℓ.inv_hom_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, isoℤ.inv_hom_id,
            CategoryTheory.Abelian.Ext.mk₀_id_comp]
        map_add' := fun u v => by
          rw [CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.add_comp] }
    let e_site : Const_ℓ.H 1 ≃+ weilEtaleTorsionH S_K ℓ 1 := e_ext_raw.trans e_conj
    let δ_et : Additive (K_sˣ) →+ weilEtaleTorsionH S_K ℓ 1 :=
      e_site.toAddMonoidHom.comp (δ₀.comp e₀.symm.toAddMonoidHom)
    refine ⟨δ_et, e_site.surjective.comp (hSurj_δ₀.comp e₀.symm.surjective), fun z => ?_⟩
    constructor
    · intro hz
      have hδ0 : δ₀ (e₀.symm z) = 0 :=
        e_site.injective (hz.trans (map_zero e_site).symm)
      obtain ⟨x₂, hx₂⟩ := (hKer_δ₀ (e₀.symm z)).mp hδ0
      refine ⟨e₀ x₂, ?_⟩
      rw [← map_nsmul, hx₂, e₀.apply_symm_apply]
    · rintro ⟨w, rfl⟩
      have hδ0 : δ₀ (e₀.symm (ℓ • w)) = 0 :=
        (hKer_δ₀ (e₀.symm (ℓ • w))).mpr ⟨e₀.symm w, (map_nsmul e₀.symm _ _).symm⟩
      change e_site (δ₀ (e₀.symm (ℓ • w))) = 0
      rw [hδ0, map_zero]
  
  obtain ⟨δ_et, hSurj_δ, hKer_δ⟩ := hPartC
  obtain ⟨v_bar, hSurj_v, hKer_v⟩ := hPartB
  let f_to : (Additive (K_sˣ) ⧸ δ_et.ker) →+ ZMod ℓ :=
    QuotientAddGroup.lift δ_et.ker v_bar
      (fun z hz => (hKer_v z).mpr ((hKer_δ z).mp hz))
  have hSurj_fto : Function.Surjective f_to := by
    intro c
    obtain ⟨z, rfl⟩ := hSurj_v c
    exact ⟨QuotientAddGroup.mk z, rfl⟩
  have hInj_fto : Function.Injective f_to := by
    rw [injective_iff_map_eq_zero]
    intro q hq
    obtain ⟨z, rfl⟩ := QuotientAddGroup.mk_surjective q
    rw [QuotientAddGroup.eq_zero_iff]
    exact (hKer_δ z).mpr ((hKer_v z).mp hq)
  let e_card : weilEtaleTorsionH S_K ℓ 1 ≃+ ZMod ℓ :=
    (QuotientAddGroup.quotientKerEquivOfSurjective δ_et hSurj_δ).symm.trans
      (AddEquiv.ofBijective f_to ⟨hInj_fto, hSurj_fto⟩)
  exact ⟨Finite.of_equiv (ZMod ℓ) e_card.symm.toEquiv,
    (Nat.card_congr e_card.toEquiv).trans (Nat.card_zmod ℓ)⟩

theorem weil_trdeg_one_field_torsion_cd_and_const_h1_card (k K_s : Type u) [Field k] [IsAlgClosed k] [Field K_s] [Algebra k K_s]
    (ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hTrdeg : Algebra.trdeg k K_s ≤ 1) :
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K_s)
    let M := ℓ ^ (r + 1)
    (∀ (𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}),
      M • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
      ∀ (s : ℕ), 2 ≤ s → Subsingleton (𝒢.H s)) ∧
    (Finite (weilEtaleTorsionH S_K ℓ 1) →
      Nat.card (weilEtaleTorsionH S_K ℓ 1) = ℓ →
      ∀ (A₀ : Type u) [AddCommGroup A₀] [Finite A₀],
        (∀ a : A₀, M • a = 0) →
        let 𝒞_A₀ := (CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of A₀)
        Finite (𝒞_A₀.H 1) ∧ Nat.card (𝒞_A₀.H 1) = Nat.card A₀) :=
by
  intro S_K M
  let J := S_K.smallEtaleTopology
  let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let ℤ_u := AddCommGrpCat.of (ULift.{u} ℤ)
  let Z_S_K := C.obj ℤ_u
  have hPrime : Nat.Prime ℓ := Fact.out
  have : IsSepClosed k := inferInstance
  have hTrdeg1 : Algebra.trdeg k K_s ≤ ((1 : ℕ) : Cardinal.{u}) := by
    rwa [Nat.cast_one]

  
  have hPowVanish : ∀ (n : ℕ) (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      (ℓ ^ n) • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
      ∀ (s : ℕ), 2 ≤ s → Subsingleton (𝒢.H s) := by
    intro n
    induction n with
    | zero =>
      intro 𝒢 hTor s _
      rw [pow_zero, one_nsmul] at hTor
      let E_s := CategoryTheory.Abelian.extFunctorObj Z_S_K s
      have hId0 : CategoryTheory.CategoryStruct.id (E_s.obj 𝒢) = 0 := by
        rw [← E_s.map_id, hTor, E_s.map_zero]
      have hx0 : ∀ x : 𝒢.H s, x = 0 := fun x =>
        congrArg (fun φ : E_s.obj 𝒢 ⟶ E_s.obj 𝒢 => φ.hom x) hId0
      exact Subsingleton.intro fun x y => (hx0 x).trans (hx0 y).symm
    | succ n ih =>
      intro 𝒢 hTor s hs
      have hs1 : 1 < s := by omega
      let μ : 𝒢 ⟶ 𝒢 := ℓ • CategoryTheory.CategoryStruct.id 𝒢
      let K₁ := CategoryTheory.Limits.kernel μ
      let ι : K₁ ⟶ 𝒢 := CategoryTheory.Limits.kernel.ι μ
      let I₁ := CategoryTheory.Limits.image μ
      let p : 𝒢 ⟶ I₁ := CategoryTheory.Limits.factorThruImage μ
      let j : I₁ ⟶ 𝒢 := CategoryTheory.Limits.image.ι μ
      have hpj : p ≫ j = μ := CategoryTheory.Limits.image.fac μ
      have hιp : ι ≫ p = 0 := by
        apply (CategoryTheory.cancel_mono j).mp
        rw [CategoryTheory.Category.assoc, hpj, CategoryTheory.Limits.kernel.condition μ,
          CategoryTheory.Limits.zero_comp]
      let SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk ι p hιp
      have hIsKer : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι SC.f SC.zero) :=
        CategoryTheory.Limits.KernelFork.IsLimit.ofι SC.f SC.zero
          (fun {W} g hg =>
            CategoryTheory.Limits.kernel.lift μ g (by
              rw [← hpj, ← CategoryTheory.Category.assoc, hg,
                CategoryTheory.Limits.zero_comp]))
          (fun {W} g hg => CategoryTheory.Limits.kernel.lift_ι μ g _)
          (fun {W} g hg m hm => (CategoryTheory.cancel_mono ι).mp
            (hm.trans (CategoryTheory.Limits.kernel.lift_ι μ g _).symm))
      have hSE : SC.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_f_is_kernel SC hIsKer)
          inferInstance inferInstance
      have hK₁ : ℓ • CategoryTheory.CategoryStruct.id K₁ = 0 := by
        apply (CategoryTheory.cancel_mono ι).mp
        calc
          (ℓ • CategoryTheory.CategoryStruct.id K₁) ≫ ι
              = ℓ • (CategoryTheory.CategoryStruct.id K₁ ≫ ι) :=
                CategoryTheory.Preadditive.nsmul_comp _ _ _
          _ = ℓ • (ι ≫ CategoryTheory.CategoryStruct.id 𝒢) := by
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          _ = ι ≫ μ := (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
          _ = 0 := CategoryTheory.Limits.kernel.condition μ
          _ = 0 ≫ ι := CategoryTheory.Limits.zero_comp.symm
      have hSub_K₁ : Subsingleton (K₁.H s) :=
        weil_alt_cd_tsen_tate_field_vanishing k K_s 1 ℓ s hℓ hTrdeg1 hs1 K₁ hK₁
      have hI₁ : (ℓ ^ n) • CategoryTheory.CategoryStruct.id I₁ = 0 := by
        apply (CategoryTheory.cancel_epi p).mp
        apply (CategoryTheory.cancel_mono j).mp
        calc
          (p ≫ ((ℓ ^ n) • CategoryTheory.CategoryStruct.id I₁)) ≫ j
              = ((ℓ ^ n) • (p ≫ CategoryTheory.CategoryStruct.id I₁)) ≫ j := by
                rw [CategoryTheory.Preadditive.comp_nsmul]
          _ = ((ℓ ^ n) • p) ≫ j := by rw [CategoryTheory.Category.comp_id]
          _ = (ℓ ^ n) • (p ≫ j) := CategoryTheory.Preadditive.nsmul_comp _ _ _
          _ = (ℓ ^ n) • (ℓ • CategoryTheory.CategoryStruct.id 𝒢) := by rw [hpj]
          _ = (ℓ ^ n * ℓ) • CategoryTheory.CategoryStruct.id 𝒢 := (mul_nsmul' _ _ _).symm
          _ = (ℓ ^ (n + 1)) • CategoryTheory.CategoryStruct.id 𝒢 := by rw [← pow_succ]
          _ = 0 := hTor
          _ = (p ≫ 0) ≫ j := by
                rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
      have hSub_I₁ : Subsingleton (I₁.H s) := ih I₁ hI₁ s hs
      have hx0 : ∀ x : 𝒢.H s, x = 0 := by
        intro x
        have hxp : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero s) = 0 :=
          @Subsingleton.elim (I₁.H s) hSub_I₁ _ 0
        obtain ⟨y, hy⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Z_S_K hSE x hxp
        have hy0 : y = 0 := @Subsingleton.elim (K₁.H s) hSub_K₁ y 0
        rw [← hy, hy0, CategoryTheory.Abelian.Ext.zero_comp]
      exact Subsingleton.intro fun x y => (hx0 x).trans (hx0 y).symm

  have hCd1 : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      M • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
      ∀ (s : ℕ), 2 ≤ s → Subsingleton (𝒢.H s) :=
    fun 𝒢 hTor s hs => hPowVanish (r + 1) 𝒢 hTor s hs

  refine ⟨hCd1, ?_⟩
  intro hFin_H1 hCard_H1

  
  obtain ⟨hMemTop, _, hLocConstPkg⟩ :=
    weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S_K
  let T_K : S_K.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S_K)
  let hT_K : CategoryTheory.Limits.IsTerminal T_K :=
    (hLocConstPkg S_K (AddCommGrpCat.of PUnit)).choose
  let adj_K := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_K
  let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
  have hAdjUnitEq : ∀ (hT' : CategoryTheory.Limits.IsTerminal T_K) (B : AddCommGrpCat.{u}),
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app B =
        adj_K.unit.app B := by
    intro hT' B
    let P_B := (CategoryTheory.Functor.const (Opposite S_K.Etale)).obj B
    have h1 : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app B =
        (adj_sh.unit.app P_B).app (Opposite.op T_K) := by
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT').comp adj_sh).unit.app B = _
      rw [CategoryTheory.Adjunction.comp_unit_app]
      exact CategoryTheory.Category.id_comp _
    have h2 : adj_K.unit.app B = (adj_sh.unit.app P_B).app (Opposite.op T_K) := by
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_K).comp adj_sh).unit.app B = _
      rw [CategoryTheory.Adjunction.comp_unit_app]
      exact CategoryTheory.Category.id_comp _
    exact h1.trans h2.symm

  let θ : ∀ (B : AddCommGrpCat.{u}) (Y : S_K.Etale),
      LocallyConstant ↥(Fgt.obj Y).left ↥B →+ ↑((C.obj B).obj.obj (Opposite.op Y)) :=
    fun B => (hLocConstPkg S_K B).choose_spec.choose
  have hθ_bij : ∀ (B : AddCommGrpCat.{u}) (Y : S_K.Etale), Function.Bijective (θ B Y) :=
    fun B => (hLocConstPkg S_K B).choose_spec.choose_spec.1
  have hθ_comap : ∀ (B : AddCommGrpCat.{u}) {Y₁ Y₂ : S_K.Etale} (f : Y₁ ⟶ Y₂)
      (g : LocallyConstant ↥(Fgt.obj Y₂).left ↥B),
      ((C.obj B).obj.map (Opposite.op f)).hom (θ B Y₂ g) =
        θ B Y₁ (g.comap (Fgt.map f).left.base.hom) :=
    fun B {Y₁ Y₂} f g => (hLocConstPkg S_K B).choose_spec.choose_spec.2.1 f g
  have hθ_unit : ∀ (B : AddCommGrpCat.{u}) (b : ↥B),
      θ B T_K (LocallyConstant.const _ b) = (adj_K.unit.app B).hom b := by
    intro B b
    exact ((hLocConstPkg S_K B).choose_spec.choose_spec.2.2 b).trans
      (congrArg (fun u => u.hom b) (hAdjUnitEq (hLocConstPkg S_K B).choose B))

  have hθ_const : ∀ (B : AddCommGrpCat.{u}) (Y : S_K.Etale) (b : ↥B),
      θ B Y (LocallyConstant.const _ b) =
        ((C.obj B).obj.map (Opposite.op (hT_K.from Y))).hom ((adj_K.unit.app B).hom b) := by
    intro B Y b
    have hcom : (LocallyConstant.const ↥(Fgt.obj T_K).left b).comap
        (Fgt.map (hT_K.from Y)).left.base.hom = LocallyConstant.const _ b := by
      ext y
      rfl
    exact (congrArg (θ B Y) hcom.symm).trans
      ((hθ_comap B (hT_K.from Y) (LocallyConstant.const _ b)).symm.trans
        (congrArg (((C.obj B).obj.map (Opposite.op (hT_K.from Y))).hom) (hθ_unit B b)))

  have hThetaMap : ∀ {A B : AddCommGrpCat.{u}} (φ : A ⟶ B) (Y : S_K.Etale)
      (g : LocallyConstant ↥(Fgt.obj Y).left ↥A),
      ((C.map φ).hom.app (Opposite.op Y)).hom (θ A Y g) =
        θ B Y (LocallyConstant.map φ.hom g) := by
    intro A B φ Y g
    let lhs : ↑((C.obj B).obj.obj (Opposite.op Y)) :=
      ((C.map φ).hom.app (Opposite.op Y)).hom (θ A Y g)
    let rhs : ↑((C.obj B).obj.obj (Opposite.op Y)) :=
      θ B Y (LocallyConstant.map φ.hom g)
    let δ : ↑((C.obj B).obj.obj (Opposite.op Y)) := lhs - rhs
    let R : CategoryTheory.Sieve Y :=
      { arrows := fun _ u => ((C.obj B).obj.map (Opposite.op u)).hom δ = 0
        downward_closed := by
          intro W₁ W₂ u hu h
          change ((C.obj B).obj.map (Opposite.op u ≫ Opposite.op h)).hom δ = 0
          rw [(C.obj B).obj.map_comp]
          change ((C.obj B).obj.map (Opposite.op h)).hom
            (((C.obj B).obj.map (Opposite.op u)).hom δ) = 0
          rw [hu, map_zero] }
    have hR_mem : R ∈ J Y := by
      rw [hMemTop S_K Y R]
      intro x
      let a : ↥A := g x
      let Y_sch : AlgebraicGeometry.Scheme.{u} := Y.left
      let U_x : Y_sch.Opens := ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
      have hx : x ∈ U_x := rfl
      have _ : AlgebraicGeometry.Etale Y.hom := Y.prop
      have _ : AlgebraicGeometry.Etale (U_x.ι ≫ Y.hom) := inferInstance
      let Y_x : S_K.Etale := AlgebraicGeometry.Scheme.Etale.mk (U_x.ι ≫ Y.hom)
      let f_x : Y_x ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk U_x.ι rfl trivial
      have hf_et : AlgebraicGeometry.Etale (Fgt.map f_x).left := by
        change AlgebraicGeometry.Etale U_x.ι
        infer_instance
      refine ⟨Y_x, f_x, ⟨x, hx⟩, ?_, hf_et, rfl⟩
      change ((C.obj B).obj.map (Opposite.op f_x)).hom (lhs - rhs) = 0
      rw [map_sub]
      apply sub_eq_zero.mpr
      have hg_fx : g.comap (Fgt.map f_x).left.base.hom = LocallyConstant.const _ a := by
        ext z
        exact z.2
      have hgφ_fx : (LocallyConstant.map φ.hom g).comap (Fgt.map f_x).left.base.hom =
          LocallyConstant.const _ (φ.hom a) := by
        ext z
        change φ.hom (g z.1) = φ.hom a
        rw [z.2]
      have hlhs_fx : ((C.obj B).obj.map (Opposite.op f_x)).hom lhs =
          ((C.obj B).obj.map (Opposite.op (hT_K.from Y_x))).hom
            ((adj_K.unit.app B).hom (φ.hom a)) := by
        have hnat1 : ((C.obj B).obj.map (Opposite.op f_x)).hom lhs =
            ((C.map φ).hom.app (Opposite.op Y_x)).hom
              (((C.obj A).obj.map (Opposite.op f_x)).hom (θ A Y g)) :=
          congrArg (fun m => m.hom (θ A Y g))
            ((C.map φ).hom.naturality (Opposite.op f_x)).symm
        have hstep2 : ((C.obj A).obj.map (Opposite.op f_x)).hom (θ A Y g) =
            ((C.obj A).obj.map (Opposite.op (hT_K.from Y_x))).hom
              ((adj_K.unit.app A).hom a) :=
          (hθ_comap A f_x g).trans ((congrArg (θ A Y_x) hg_fx).trans (hθ_const A Y_x a))
        have hnat2 : ((C.map φ).hom.app (Opposite.op Y_x)).hom
            (((C.obj A).obj.map (Opposite.op (hT_K.from Y_x))).hom ((adj_K.unit.app A).hom a)) =
          ((C.obj B).obj.map (Opposite.op (hT_K.from Y_x))).hom
            (((C.map φ).hom.app (Opposite.op T_K)).hom ((adj_K.unit.app A).hom a)) :=
          congrArg (fun m => m.hom ((adj_K.unit.app A).hom a))
            ((C.map φ).hom.naturality (Opposite.op (hT_K.from Y_x)))
        have hunit_nat : ((C.map φ).hom.app (Opposite.op T_K)).hom ((adj_K.unit.app A).hom a) =
            (adj_K.unit.app B).hom (φ.hom a) :=
          (congrArg (fun m : A ⟶ (C.obj B).obj.obj (Opposite.op T_K) => m.hom a)
            (adj_K.unit.naturality φ)).symm
        exact hnat1.trans
          ((congrArg (((C.map φ).hom.app (Opposite.op Y_x)).hom) hstep2).trans
            (hnat2.trans (congrArg (((C.obj B).obj.map (Opposite.op (hT_K.from Y_x))).hom)
              hunit_nat)))
      have hrhs_fx : ((C.obj B).obj.map (Opposite.op f_x)).hom rhs =
          ((C.obj B).obj.map (Opposite.op (hT_K.from Y_x))).hom
            ((adj_K.unit.app B).hom (φ.hom a)) :=
        (hθ_comap B f_x (LocallyConstant.map φ.hom g)).trans
          ((congrArg (θ B Y_x) hgφ_fx).trans (hθ_const B Y_x (φ.hom a)))
      exact hlhs_fx.trans hrhs_fx.symm
    let z_hom : ℤ_u ⟶ (C.obj B).obj.obj (Opposite.op Y) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • δ
          map_zero' := zero_zsmul _
          map_add' := fun n₁ n₂ => add_zsmul _ n₁.down n₂.down }
    have hSheafFor := (C.obj B).property ℤ_u R hR_mem
    have hz0 : z_hom = 0 := by
      apply hSheafFor.isSeparatedFor.ext
      intro W u hu
      change z_hom ≫ (C.obj B).obj.map (Opposite.op u) = 0 ≫ (C.obj B).obj.map (Opposite.op u)
      rw [CategoryTheory.Limits.zero_comp]
      apply AddCommGrpCat.ext
      intro n
      change ((C.obj B).obj.map (Opposite.op u)).hom (n.down • δ) = 0
      rw [map_zsmul, hu, zsmul_zero]
    have hδ0 : δ = 0 := by
      have hval := congrArg
        (fun m : ℤ_u ⟶ (C.obj B).obj.obj (Opposite.op Y) => m.hom (ULift.up 1)) hz0
      simpa [z_hom] using hval
    exact sub_eq_zero.mp hδ0

  have hConstSE : ∀ (A₀ : Type u) [AddCommGroup A₀] (S₀ : AddSubgroup A₀),
      let ι₀ : AddCommGrpCat.of ↥S₀ ⟶ AddCommGrpCat.of A₀ := AddCommGrpCat.ofHom S₀.subtype
      let π₀ : AddCommGrpCat.of A₀ ⟶ AddCommGrpCat.of (A₀ ⧸ S₀) :=
        AddCommGrpCat.ofHom (QuotientAddGroup.mk' S₀)
      ∃ h0 : C.map ι₀ ≫ C.map π₀ = 0,
        (CategoryTheory.ShortComplex.mk (C.map ι₀) (C.map π₀) h0).ShortExact := by
    intro A₀ _ S₀ ι₀ π₀
    let AS := AddCommGrpCat.of ↥S₀
    let AA := AddCommGrpCat.of A₀
    let AQ := AddCommGrpCat.of (A₀ ⧸ S₀)
    have hιπ₀ : ι₀ ≫ π₀ = 0 := by
      apply AddCommGrpCat.ext
      intro x
      exact (QuotientAddGroup.eq_zero_iff x.1).mpr x.2
    have h0 : C.map ι₀ ≫ C.map π₀ = 0 := by
      rw [← C.map_comp, hιπ₀, C.map_zero]
    refine ⟨h0, ?_⟩
    have hInj_ι : ∀ Y : S_K.Etale,
        Function.Injective (((C.map ι₀).hom.app (Opposite.op Y)).hom) := by
      intro Y
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨g, rfl⟩ := (hθ_bij AS Y).2 z
      rw [hThetaMap ι₀ Y g] at hz
      have hg_map : LocallyConstant.map ι₀.hom g = 0 :=
        (hθ_bij AA Y).1 (hz.trans (map_zero (θ AA Y)).symm)
      have hg0 : g = 0 := by
        ext y
        exact congrArg (fun f : LocallyConstant _ A₀ => f y) hg_map
      rw [hg0, map_zero]
    have hMono : CategoryTheory.Mono (C.map ι₀) :=
      ⟨fun {W} α₁ α₂ hα => by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext Y_op
        induction Y_op with
        | op Y =>
          apply AddCommGrpCat.ext
          intro w
          exact hInj_ι Y (congrArg (fun m => (m.hom.app (Opposite.op Y)).hom w) hα)⟩
    have : CategoryTheory.Epi π₀ :=
      (AddCommGrpCat.epi_iff_surjective π₀).mpr (QuotientAddGroup.mk'_surjective S₀)
    have hEpi : CategoryTheory.Epi (C.map π₀) := C.map_epi π₀
    let SC := CategoryTheory.ShortComplex.mk (C.map ι₀) (C.map π₀) h0
    let e_AA : ∀ Y : S_K.Etale,
        LocallyConstant ↥(Fgt.obj Y).left A₀ ≃ ↑((C.obj AA).obj.obj (Opposite.op Y)) :=
      fun Y => Equiv.ofBijective (θ AA Y) (hθ_bij AA Y)
    have hLiftExist : ∀ {W : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (k : W ⟶ SC.X₂), k ≫ SC.g = 0 →
        ∃ l : W ⟶ SC.X₁, l ≫ SC.f = k := by
      intro W k hk
      let g_of : ∀ (Y : S_K.Etale), ↑(W.obj.obj (Opposite.op Y)) →
          LocallyConstant ↥(Fgt.obj Y).left A₀ :=
        fun Y w => (e_AA Y).symm ((k.hom.app (Opposite.op Y)).hom w)
      have hg_theta : ∀ (Y : S_K.Etale) (w : ↑(W.obj.obj (Opposite.op Y))),
          θ AA Y (g_of Y w) = (k.hom.app (Opposite.op Y)).hom w :=
        fun Y w => (e_AA Y).apply_symm_apply _
      have hg_mem : ∀ (Y : S_K.Etale) (w : ↑(W.obj.obj (Opposite.op Y)))
          (y : ↥(Fgt.obj Y).left), g_of Y w y ∈ S₀ := by
        intro Y w y
        have hkw0 : ((C.map π₀).hom.app (Opposite.op Y)).hom
            ((k.hom.app (Opposite.op Y)).hom w) = 0 :=
          congrArg (fun m : W ⟶ C.obj AQ => (m.hom.app (Opposite.op Y)).hom w) hk
        rw [← hg_theta Y w, hThetaMap π₀ Y (g_of Y w)] at hkw0
        have hmap0 : LocallyConstant.map π₀.hom (g_of Y w) = 0 :=
          (hθ_bij AQ Y).1 (hkw0.trans (map_zero (θ AQ Y)).symm)
        have hy0 : QuotientAddGroup.mk' S₀ (g_of Y w y) = 0 :=
          congrArg (fun f : LocallyConstant _ (A₀ ⧸ S₀) => f y) hmap0
        exact (QuotientAddGroup.eq_zero_iff _).mp hy0
      let gS_of : ∀ (Y : S_K.Etale), ↑(W.obj.obj (Opposite.op Y)) →
          LocallyConstant ↥(Fgt.obj Y).left ↥S₀ :=
        fun Y w =>
          { toFun := fun y => ⟨g_of Y w y, hg_mem Y w y⟩
            isLocallyConstant := fun T => by
              have hpre : (fun y => (⟨g_of Y w y, hg_mem Y w y⟩ : ↥S₀)) ⁻¹' T =
                  (g_of Y w) ⁻¹' (Subtype.val '' T) := by
                ext y
                simp only [Set.mem_preimage, Set.mem_image]
                refine ⟨fun hT => ⟨⟨g_of Y w y, hg_mem Y w y⟩, hT, rfl⟩, ?_⟩
                rintro ⟨s, hsT, hs_eq⟩
                have hsub : s = ⟨g_of Y w y, hg_mem Y w y⟩ := Subtype.ext hs_eq
                exact hsub ▸ hsT
              rw [hpre]
              exact (g_of Y w).isLocallyConstant (Subtype.val '' T) }
      let l_fn : ∀ (Y : S_K.Etale),
          ↑(W.obj.obj (Opposite.op Y)) → ↑((C.obj AS).obj.obj (Opposite.op Y)) :=
        fun Y w => θ AS Y (gS_of Y w)
      have hl_eq : ∀ (Y : S_K.Etale) (w : ↑(W.obj.obj (Opposite.op Y))),
          ((C.map ι₀).hom.app (Opposite.op Y)).hom (l_fn Y w) =
            (k.hom.app (Opposite.op Y)).hom w := by
        intro Y w
        dsimp [l_fn]
        rw [hThetaMap ι₀ Y (gS_of Y w)]
        have hmap_eq : LocallyConstant.map ι₀.hom (gS_of Y w) = g_of Y w := by
          ext y
          rfl
        rw [hmap_eq, hg_theta Y w]
      refine ⟨{ hom :=
        { app := fun Y_op =>
            AddCommGrpCat.ofHom
              { toFun := l_fn Y_op.unop
                map_zero' := hInj_ι Y_op.unop (by
                  rw [hl_eq, map_zero, map_zero])
                map_add' := fun w₁ w₂ => hInj_ι Y_op.unop (by
                  rw [hl_eq, map_add, map_add, hl_eq, hl_eq]) }
          naturality := fun {Y₁_op Y₂_op} f_op => by
            apply AddCommGrpCat.ext
            intro w
            apply hInj_ι Y₂_op.unop
            have hnat_ι := congrArg (fun m => m.hom (l_fn Y₁_op.unop w))
              ((C.map ι₀).hom.naturality f_op)
            change ((C.map ι₀).hom.app Y₂_op).hom
                (((C.obj AS).obj.map f_op).hom (l_fn Y₁_op.unop w)) =
              ((C.obj AA).obj.map f_op).hom
                (((C.map ι₀).hom.app Y₁_op).hom (l_fn Y₁_op.unop w)) at hnat_ι
            have hnat_k := congrArg (fun m => m.hom w) (k.hom.naturality f_op)
            change (k.hom.app Y₂_op).hom ((W.obj.map f_op).hom w) =
              ((C.obj AA).obj.map f_op).hom ((k.hom.app Y₁_op).hom w) at hnat_k
            change ((C.map ι₀).hom.app Y₂_op).hom (l_fn Y₂_op.unop ((W.obj.map f_op).hom w)) =
              ((C.map ι₀).hom.app Y₂_op).hom
                (((C.obj AS).obj.map f_op).hom (l_fn Y₁_op.unop w))
            rw [hl_eq Y₂_op.unop, hnat_k, hnat_ι, hl_eq Y₁_op.unop] } }, ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext Y_op
      induction Y_op with
      | op Y =>
        apply AddCommGrpCat.ext
        intro w
        exact hl_eq Y w
    have hIsKer : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι SC.f SC.zero) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι SC.f SC.zero
        (fun {W} k hk => (hLiftExist k hk).choose)
        (fun {W} k hk => (hLiftExist k hk).choose_spec)
        (fun {W} k hk m hm => (CategoryTheory.cancel_mono (C.map ι₀)).mp
          (hm.trans (hLiftExist k hk).choose_spec.symm))
    exact CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_f_is_kernel SC hIsKer) hMono hEpi

  have hH0Surj : ∀ (A₀ : Type u) [AddCommGroup A₀] (S₀ : AddSubgroup A₀),
      let π₀ : AddCommGrpCat.of A₀ ⟶ AddCommGrpCat.of (A₀ ⧸ S₀) :=
        AddCommGrpCat.ofHom (QuotientAddGroup.mk' S₀)
      ∀ x₃ : (C.obj (AddCommGrpCat.of (A₀ ⧸ S₀))).H 0,
        ∃ x₂ : (C.obj (AddCommGrpCat.of A₀)).H 0,
          x₂.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map π₀)) (Nat.add_zero 0) = x₃ := by
    intro A₀ _ S₀ π₀ x₃
    let AA := AddCommGrpCat.of A₀
    let AQ := AddCommGrpCat.of (A₀ ⧸ S₀)
    let u_TK : Unique ↥(Fgt.obj T_K).left :=
      (inferInstance : Unique ↥(AlgebraicGeometry.Spec (CommRingCat.of K_s)))
    have hUnitQ_surj : Function.Surjective (adj_K.unit.app AQ).hom := by
      intro sec
      obtain ⟨g, rfl⟩ := (hθ_bij AQ T_K).2 sec
      let q₀ : A₀ ⧸ S₀ := g u_TK.default
      have hg_const : g = LocallyConstant.const _ q₀ := by
        ext pt
        change g pt = g u_TK.default
        rw [u_TK.uniq pt]
      refine ⟨q₀, ?_⟩
      rw [← hθ_unit AQ q₀, hg_const]
    obtain ⟨φ, rfl⟩ :=
      (CategoryTheory.Abelian.Ext.mk₀_bijective Z_S_K (C.obj AQ)).2 x₃
    let ψ : ℤ_u ⟶ (C.obj AQ).obj.obj (Opposite.op T_K) :=
      (adj_K.homEquiv ℤ_u (C.obj AQ)) φ
    obtain ⟨q, hq⟩ := hUnitQ_surj (ψ.hom (ULift.up 1))
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective S₀ q
    let g_a : ℤ_u ⟶ AA :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • a
          map_zero' := zero_zsmul a
          map_add' := fun n₁ n₂ => add_zsmul a n₁.down n₂.down }
    have hmap_eq : C.map g_a ≫ C.map π₀ = φ := by
      rw [← C.map_comp]
      apply (adj_K.homEquiv ℤ_u (C.obj AQ)).injective
      change (adj_K.homEquiv ℤ_u (C.obj AQ)) (C.map (g_a ≫ π₀)) = ψ
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      have hnat := (adj_K.unit.naturality (g_a ≫ π₀)).symm
      change adj_K.unit.app ℤ_u ≫
          ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_K)).map
            (C.map (g_a ≫ π₀)) =
        (g_a ≫ π₀) ≫ adj_K.unit.app AQ at hnat
      rw [hnat]
      apply AddCommGrpCat.ext
      intro n
      have hn : n = n.down • (ULift.up (1 : ℤ) : ↥ℤ_u) := by
        ext
        change n.down = n.down • (1 : ℤ)
        simp
      rw [hn, map_zsmul, map_zsmul]
      congr 1
      change (adj_K.unit.app AQ).hom (QuotientAddGroup.mk' S₀ ((1 : ℤ) • a)) =
        ψ.hom (ULift.up 1)
      rwa [one_zsmul]
    refine ⟨CategoryTheory.Abelian.Ext.mk₀ (C.map g_a), ?_⟩
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hmap_eq]

  
  have hOrderEll : ∀ {G : Type u} [AddCommGroup G] (k_exp : ℕ) (b : G),
      b ≠ 0 → (ℓ ^ (k_exp + 1)) • b = 0 → ∃ a₀ : G, a₀ ≠ 0 ∧ ℓ • a₀ = 0 := by
    intro G _ k_exp
    induction k_exp with
    | zero =>
      intro b hb_ne hb_tor
      rw [pow_one] at hb_tor
      exact ⟨b, hb_ne, hb_tor⟩
    | succ k_exp ih =>
      intro b hb_ne hb_tor
      by_cases hlb : ℓ • b = 0
      · exact ⟨b, hb_ne, hlb⟩
      · apply ih (ℓ • b) hlb
        rw [← mul_nsmul', ← pow_succ]
        exact hb_tor

  have : NeZero ℓ := ⟨hPrime.ne_zero⟩

  have hPrimeSubgroupH1 : ∀ (A₀ : Type u) [AddCommGroup A₀] (a₀ : A₀),
      a₀ ≠ 0 → ℓ • a₀ = 0 →
      let S₀ := AddSubgroup.zmultiples a₀
      let 𝒞_S₀ := C.obj (AddCommGrpCat.of ↥S₀)
      Nat.card ↥S₀ = ℓ ∧
      Finite (𝒞_S₀.H 1) ∧
      Nat.card (𝒞_S₀.H 1) = ℓ ∧
      M • CategoryTheory.CategoryStruct.id 𝒞_S₀ = 0 := by
    intro A₀ _ a₀ ha₀_ne ha₀_tor S₀ 𝒞_S₀
    let s₀ : ↥S₀ := ⟨a₀, AddSubgroup.mem_zmultiples a₀⟩
    have hs₀_ne : s₀ ≠ 0 := fun h => ha₀_ne (congrArg Subtype.val h)
    have hs₀_tor : ℓ • s₀ = 0 := Subtype.ext ha₀_tor
    let f_Z : ℤ →+ ↥S₀ := zmultiplesHom ↥S₀ s₀
    have hf_Z_ell : f_Z (ℓ : ℤ) = 0 := by
      rw [zmultiplesHom_apply, natCast_zsmul]
      exact hs₀_tor
    let φ_S : ZMod ℓ →+ ↥S₀ := ZMod.lift ℓ ⟨f_Z, hf_Z_ell⟩
    have hsurj_S : Function.Surjective φ_S := by
      intro y
      obtain ⟨z, hz⟩ := AddSubgroup.mem_zmultiples_iff.mp y.2
      refine ⟨(z : ZMod ℓ), ?_⟩
      dsimp [φ_S]
      rw [ZMod.lift_coe]
      apply Subtype.ext
      simpa [f_Z] using hz
    have hinj_S : Function.Injective φ_S := by
      rw [injective_iff_map_eq_zero]
      intro c hc
      have hc_cast : ((c.val : ℤ) : ZMod ℓ) = c := by
        rw [Int.cast_natCast, ZMod.natCast_zmod_val]
      have hlift_val : φ_S ((c.val : ℤ) : ZMod ℓ) = f_Z (c.val : ℤ) :=
        ZMod.lift_coe ℓ ⟨f_Z, hf_Z_ell⟩ (c.val : ℤ)
      rw [hc_cast] at hlift_val
      have hf0 : f_Z (c.val : ℤ) = 0 := hlift_val.symm.trans hc
      have hval_tor : c.val • s₀ = 0 := by
        rwa [zmultiplesHom_apply, natCast_zsmul] at hf0
      have hord : addOrderOf s₀ = ℓ := addOrderOf_eq_prime hs₀_tor hs₀_ne
      have hdvd : addOrderOf s₀ ∣ c.val := addOrderOf_dvd_of_nsmul_eq_zero hval_tor
      rw [hord] at hdvd
      have hval0 : c.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt c)
      exact (ZMod.val_eq_zero c).mp hval0
    let e_S : ZMod ℓ ≃+ ↥S₀ := AddEquiv.ofBijective φ_S ⟨hinj_S, hsurj_S⟩
    have hCard_S₀ : Nat.card ↥S₀ = ℓ :=
      (Nat.card_congr e_S.symm.toEquiv).trans (Nat.card_zmod ℓ)
    let iso_S₀ : AddCommGrpCat.of ↥S₀ ≅
        AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ)) :=
      { hom := AddCommGrpCat.ofHom
          { toFun := fun y => ULift.up (e_S.symm y)
            map_zero' := by ext; simp
            map_add' := fun x y => by ext; simp }
        inv := AddCommGrpCat.ofHom
          { toFun := fun u => e_S u.down
            map_zero' := e_S.map_zero
            map_add' := fun u v => e_S.map_add u.down v.down }
        hom_inv_id := by
          apply AddCommGrpCat.ext
          intro y
          exact e_S.apply_symm_apply y
        inv_hom_id := by
          apply AddCommGrpCat.ext
          intro u
          exact ULift.ext _ _ (e_S.symm_apply_apply u.down) }
    let E₁ := CategoryTheory.Abelian.extFunctorObj Z_S_K 1
    let iso_H1 := E₁.mapIso (C.mapIso iso_S₀)
    let equiv_H1 : 𝒞_S₀.H 1 ≃ weilEtaleTorsionH S_K ℓ 1 :=
      { toFun := iso_H1.hom.hom
        invFun := iso_H1.inv.hom
        left_inv := fun x => congrArg (fun ψ => ψ.hom x) iso_H1.hom_inv_id
        right_inv := fun y => congrArg (fun ψ => ψ.hom y) iso_H1.inv_hom_id }
    have hFin_CS : Finite (𝒞_S₀.H 1) := @Finite.of_equiv _ _ hFin_H1 equiv_H1.symm
    have hCard_CS : Nat.card (𝒞_S₀.H 1) = ℓ := (Nat.card_congr equiv_H1).trans hCard_H1
    have hTor_S₀_id : M • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of ↥S₀) = 0 := by
      apply AddCommGrpCat.ext
      intro y
      change M • y = 0
      have hly : ℓ • y = 0 := by
        have h1 : ℓ • e_S.symm y = 0 := by simp [nsmul_eq_mul]
        calc
          ℓ • y = ℓ • e_S (e_S.symm y) := by rw [e_S.apply_symm_apply]
          _ = e_S (ℓ • e_S.symm y) := (map_nsmul e_S _ _).symm
          _ = 0 := by rw [h1, map_zero]
      dsimp [M]
      rw [pow_succ, mul_nsmul', hly, smul_zero]
    have hTor_CS : M • CategoryTheory.CategoryStruct.id 𝒞_S₀ = 0 := by
      dsimp [𝒞_S₀]
      rw [← C.map_id, ← CategoryTheory.Functor.map_nsmul, hTor_S₀_id, C.map_zero]
    exact ⟨hCard_S₀, hFin_CS, hCard_CS, hTor_CS⟩

  have hCosetEquiv : ∀ {G : Type u} [AddCommGroup G] (H : AddSubgroup G),
      Finite (G ⧸ H) → Finite ↥H →
      Finite G ∧ Nat.card G = Nat.card (G ⧸ H) * Nat.card ↥H := by
    intro G _ H hFinQ hFinH
    let mkH := QuotientAddGroup.mk' H
    let sec : G ⧸ H → G := Function.surjInv (QuotientAddGroup.mk'_surjective H)
    have hsec : ∀ q : G ⧸ H, mkH (sec q) = q :=
      Function.surjInv_eq (QuotientAddGroup.mk'_surjective H)
    have hsub_mem : ∀ g : G, g - sec (mkH g) ∈ H := by
      intro g
      rw [← QuotientAddGroup.eq_zero_iff]
      change mkH (g - sec (mkH g)) = 0
      rw [map_sub, hsec (mkH g), sub_self]
    let e_coset : G ≃ (G ⧸ H) × ↥H :=
      { toFun := fun g => (mkH g, ⟨g - sec (mkH g), hsub_mem g⟩)
        invFun := fun p => sec p.1 + p.2.1
        left_inv := fun g => add_sub_cancel (sec (mkH g)) g
        right_inv := by
          rintro ⟨q, h⟩
          have hh0 : mkH h.1 = 0 := (QuotientAddGroup.eq_zero_iff h.1).mpr h.2
          have hmk : mkH (sec q + h.1) = q := by
            rw [map_add, hsec q, hh0, add_zero]
          refine Prod.ext hmk (Subtype.ext ?_)
          change (sec q + h.1) - sec (mkH (sec q + h.1)) = h.1
          rw [hmk, add_sub_cancel_left] }
    have : Finite (G ⧸ H) := hFinQ
    have : Finite ↥H := hFinH
    exact ⟨Finite.of_equiv _ e_coset.symm,
      (Nat.card_congr e_coset).trans (Nat.card_prod _ _)⟩

  have hMain : ∀ (n : ℕ) (A₀ : Type u) [AddCommGroup A₀] [Finite A₀],
      Nat.card A₀ = n →
      (∀ a : A₀, M • a = 0) →
      let 𝒞_A₀ := C.obj (AddCommGrpCat.of A₀)
      Finite (𝒞_A₀.H 1) ∧ Nat.card (𝒞_A₀.H 1) = n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro A₀ _ _ hCard hTor 𝒞_A₀
      let E₁ := CategoryTheory.Abelian.extFunctorObj Z_S_K 1
      by_cases hAllZero : ∀ a : A₀, a = 0
      · let e_A_unit : A₀ ≃ PUnit.{u + 1} :=
          { toFun := fun _ => PUnit.unit
            invFun := fun _ => 0
            left_inv := fun x => (hAllZero x).symm
            right_inv := fun u => Subsingleton.elim _ u }
        have hn1 : n = 1 :=
          hCard.symm.trans ((Nat.card_congr e_A_unit).trans Nat.card_unique)
        have hIdA : CategoryTheory.CategoryStruct.id (AddCommGrpCat.of A₀) = 0 :=
          AddCommGrpCat.ext fun x => hAllZero x
        have hIdH1 : CategoryTheory.CategoryStruct.id (E₁.obj 𝒞_A₀) = 0 := by
          dsimp [𝒞_A₀]
          rw [← E₁.map_id, ← C.map_id, hIdA, C.map_zero, E₁.map_zero]
        have hx0 : ∀ x : 𝒞_A₀.H 1, x = 0 := fun x =>
          congrArg (fun φ : E₁.obj 𝒞_A₀ ⟶ E₁.obj 𝒞_A₀ => φ.hom x) hIdH1
        let e_H1_unit : 𝒞_A₀.H 1 ≃ PUnit.{u + 1} :=
          { toFun := fun _ => PUnit.unit
            invFun := fun _ => 0
            left_inv := fun x => (hx0 x).symm
            right_inv := fun u => Subsingleton.elim _ u }
        exact ⟨Finite.of_equiv PUnit.{u + 1} e_H1_unit.symm,
          (Nat.card_congr e_H1_unit).trans (Nat.card_unique.trans hn1.symm)⟩
      · obtain ⟨a, ha_ne⟩ := Classical.not_forall.mp hAllZero
        obtain ⟨a₀, ha₀_ne, ha₀_tor⟩ := hOrderEll r a ha_ne (hTor a)
        let S₀ : AddSubgroup A₀ := AddSubgroup.zmultiples a₀
        let Q₀ := A₀ ⧸ S₀
        have : Finite Q₀ :=
          Finite.of_surjective (QuotientAddGroup.mk' S₀) (QuotientAddGroup.mk'_surjective S₀)
        have hTor_Q₀ : ∀ q : Q₀, M • q = 0 := by
          intro q
          obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective S₀ q
          rw [← map_nsmul, hTor x, map_zero]
        obtain ⟨hCard_S₀, hFin_CS, hCard_CS, hTor_CS⟩ :=
          hPrimeSubgroupH1 A₀ a₀ ha₀_ne ha₀_tor
        have hn_prod : n = Nat.card Q₀ * ℓ := by
          have hlag := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup S₀
          rw [hCard, hCard_S₀] at hlag
          exact hlag
        have hq_pos : 0 < Nat.card Q₀ := Nat.card_pos
        have hq_lt : Nat.card Q₀ < n := by
          rw [hn_prod]
          exact lt_mul_of_one_lt_right hq_pos hPrime.one_lt
        obtain ⟨hFin_CQ, hCard_CQ⟩ := ih (Nat.card Q₀) hq_lt Q₀ rfl hTor_Q₀
        let 𝒞_S₀ := C.obj (AddCommGrpCat.of ↥S₀)
        let 𝒞_Q₀ := C.obj (AddCommGrpCat.of Q₀)
        have hSub_CS2 : Subsingleton (𝒞_S₀.H 2) := hCd1 𝒞_S₀ hTor_CS 2 (le_refl 2)
        let ι₀ : AddCommGrpCat.of ↥S₀ ⟶ AddCommGrpCat.of A₀ := AddCommGrpCat.ofHom S₀.subtype
        let π₀ : AddCommGrpCat.of A₀ ⟶ AddCommGrpCat.of Q₀ :=
          AddCommGrpCat.ofHom (QuotientAddGroup.mk' S₀)
        obtain ⟨h0_const, hSE_const⟩ := hConstSE A₀ S₀
        let ι₁ : 𝒞_S₀.H 1 →+ 𝒞_A₀.H 1 :=
          (CategoryTheory.Abelian.Ext.mk₀ (C.map ι₀)).postcomp Z_S_K (Nat.add_zero 1)
        let π₁ : 𝒞_A₀.H 1 →+ 𝒞_Q₀.H 1 :=
          (CategoryTheory.Abelian.Ext.mk₀ (C.map π₀)).postcomp Z_S_K (Nat.add_zero 1)
        have hinj_ι₁ : Function.Injective ι₁ := by
          rw [injective_iff_map_eq_zero]
          intro x₁ hx₁
          obtain ⟨x₃, hx₃⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z_S_K hSE_const x₁ hx₁
              (Nat.zero_add 1)
          obtain ⟨x₂, rfl⟩ := hH0Surj A₀ S₀ x₃
          rw [← hx₃, CategoryTheory.Abelian.Ext.comp_assoc x₂
            (CategoryTheory.Abelian.Ext.mk₀ (C.map π₀)) hSE_const.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1)]
          have hzero_ext :
              (CategoryTheory.Abelian.Ext.mk₀ (C.map π₀)).comp hSE_const.extClass
                (Nat.zero_add 1) = 0 :=
            hSE_const.comp_extClass
          rw [hzero_ext, CategoryTheory.Abelian.Ext.comp_zero]
        have hsurj_π₁ : Function.Surjective π₁ := by
          intro y₃
          have hy₃_ext : y₃.comp hSE_const.extClass (rfl : 1 + 1 = 2) = 0 :=
            @Subsingleton.elim (𝒞_S₀.H 2) hSub_CS2 _ 0
          exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z_S_K hSE_const y₃
            (rfl : 1 + 1 = 2) hy₃_ext
        have hker_eq : ∀ y₂ : 𝒞_A₀.H 1, y₂ ∈ π₁.ker ↔ ∃ x₁ : 𝒞_S₀.H 1, ι₁ x₁ = y₂ := by
          intro y₂
          constructor
          · intro hy₂
            exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Z_S_K hSE_const y₂ hy₂
          · rintro ⟨x₁, rfl⟩
            change (x₁.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map ι₀)) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (C.map π₀)) (Nat.add_zero 1) = 0
            rw [CategoryTheory.Abelian.Ext.comp_assoc x₁
              (CategoryTheory.Abelian.Ext.mk₀ (C.map ι₀))
              (CategoryTheory.Abelian.Ext.mk₀ (C.map π₀))
              (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h0_const,
              CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        let e_quot : (𝒞_A₀.H 1 ⧸ π₁.ker) ≃+ 𝒞_Q₀.H 1 :=
          QuotientAddGroup.quotientKerEquivOfSurjective π₁ hsurj_π₁
        have hFin_quot : Finite (𝒞_A₀.H 1 ⧸ π₁.ker) :=
          @Finite.of_equiv _ _ hFin_CQ e_quot.symm.toEquiv
        have hCard_quot : Nat.card (𝒞_A₀.H 1 ⧸ π₁.ker) = Nat.card Q₀ :=
          (Nat.card_congr e_quot.toEquiv).trans hCard_CQ
        let f_ker : 𝒞_S₀.H 1 → ↥π₁.ker :=
          fun x₁ => ⟨ι₁ x₁, (hker_eq (ι₁ x₁)).mpr ⟨x₁, rfl⟩⟩
        have hbij_ker : Function.Bijective f_ker := by
          refine ⟨fun x₁ x₂ h => hinj_ι₁ (congrArg Subtype.val h), ?_⟩
          rintro ⟨y₂, hy₂⟩
          obtain ⟨x₁, rfl⟩ := (hker_eq y₂).mp hy₂
          exact ⟨x₁, rfl⟩
        let e_ker : 𝒞_S₀.H 1 ≃ ↥π₁.ker := Equiv.ofBijective f_ker hbij_ker
        have hFin_ker : Finite ↥π₁.ker := @Finite.of_equiv _ _ hFin_CS e_ker
        have hCard_ker : Nat.card ↥π₁.ker = ℓ :=
          (Nat.card_congr e_ker.symm).trans hCard_CS
        obtain ⟨hFin_CA, hCard_CA⟩ := hCosetEquiv π₁.ker hFin_quot hFin_ker
        refine ⟨hFin_CA, ?_⟩
        rw [hCard_CA, hCard_quot, hCard_ker, hn_prod]

  intro A₀ _ _ hTor
  exact hMain (Nat.card A₀) A₀ rfl hTor

theorem weil_trait_verdier_kummer_leray_coker_bounds (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ q₀ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (Z_bar D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType D_bar.hom]
    (f_bar : Z_bar ⟶ D_bar) [AlgebraicGeometry.IsProper f_bar.left]
    (R_s : Type u) [CommRing R_s] [IsDomain R_s] [IsLocalRing R_s]
    [HenselianLocalRing R_s] [IsDiscreteValuationRing R_s]
    (π_s : R_s →+* k) (p_k : k →+* R_s)
    (h_res_sec : π_s.comp p_k = RingHom.id k)
    (h_ker_π : RingHom.ker π_s = IsLocalRing.maximalIdeal R_s)
    (t_s : R_s) (ht_ne : t_s ≠ 0)
    (hmax_t : IsLocalRing.maximalIdeal R_s = Ideal.span {t_s})
    (K_s : Type u) [Field K_s] (ι_RK : R_s →+* K_s)
    (hLoc_K : @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ι_KΩ : K_s →+* Ω)
    (hAlg_tr :
      letI : Algebra k K_s := (ι_RK.comp p_k).toAlgebra
      letI : Algebra K_s Ω := ι_KΩ.toAlgebra
      Algebra.trdeg k K_s ≤ 1 ∧ Algebra.IsAlgebraic K_s Ω)
    (g_Rs : AlgebraicGeometry.Spec (CommRingCat.of R_s) ⟶ D_bar.left) :
    let M := ℓ ^ (r + 1)
    let Z_Rs := CategoryTheory.Limits.pullback f_bar.left g_Rs
    let g_Ks := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs
    let Z_Ks := CategoryTheory.Limits.pullback f_bar.left g_Ks
    let f_Ks := CategoryTheory.Limits.pullback.snd f_bar.left g_Ks
    let s_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_KΩ.comp ι_RK)) ≫ g_Rs
    let Z_Ω := CategoryTheory.Limits.pullback f_bar.left s_Ω
    let T_Ks := weilEtaleIdTerminal (AlgebraicGeometry.Spec (CommRingCat.of K_s))
    let Cod := ↑((weilEtaleHigherDirectImage f_Ks (q₀ + 1)
      (weilEtaleTorsionSheaf Z_Ks M)).obj.obj (Opposite.op T_Ks))
    (∀ y : Cod, M • y = 0) ∧
    (∀ (hT_ZKs : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f_Ks).obj T_Ks))
        (j_Z_K : Z_Ks ⟶ Z_Rs) (j_Z_Rs : Z_Ω ⟶ Z_Rs),
      j_Z_K ≫ CategoryTheory.Limits.pullback.fst f_bar.left g_Rs =
        CategoryTheory.Limits.pullback.fst f_bar.left g_Ks →
      j_Z_K ≫ CategoryTheory.Limits.pullback.snd f_bar.left g_Rs =
        CategoryTheory.Limits.pullback.snd f_bar.left g_Ks ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) →
      j_Z_Rs ≫ CategoryTheory.Limits.pullback.fst f_bar.left g_Rs =
        CategoryTheory.Limits.pullback.fst f_bar.left s_Ω →
      j_Z_Rs ≫ CategoryTheory.Limits.pullback.snd f_bar.left g_Rs =
        CategoryTheory.Limits.pullback.snd f_bar.left s_Ω ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_KΩ.comp ι_RK)) →
      ∀ (p_K_R : weilEtaleTorsionH Z_Rs M (q₀ + 1) →+ weilEtaleTorsionH Z_Ks M (q₀ + 1))
        (p_low : weilEtaleTorsionH Z_Rs M q₀ →+ weilEtaleTorsionH Z_Ω M q₀)
        (p_mid : weilEtaleTorsionH Z_Rs M (q₀ + 1) →+ weilEtaleTorsionH Z_Ω M (q₀ + 1)),
        WeilIsTorsionEtalePullback j_Z_K M (q₀ + 1) p_K_R →
        WeilIsTorsionEtalePullback j_Z_Rs M q₀ p_low →
        Function.Bijective p_low →
        WeilIsTorsionEtalePullback j_Z_Rs M (q₀ + 1) p_mid →
        Function.Injective p_mid →
        Finite (weilEtaleTorsionH Z_Ω M q₀) →
        Finite (weilEtaleTorsionH Z_Ω M (q₀ + 1)) →
        Finite (weilEtaleTorsionH Z_Ks M (q₀ + 1) ⧸ AddMonoidHom.range p_K_R) →
        let sp := (weilOuterTrFibEdgeHom f_Ks T_Ks hT_ZKs
          (weilEtaleTorsionSheaf Z_Ks M) (q₀ + 1)).comp p_K_R
        Finite (Cod ⧸ AddMonoidHom.range sp) ∧
        Nat.card (Cod ⧸ AddMonoidHom.range sp) ≤
          Nat.card (weilEtaleTorsionH Z_Ω M (q₀ + 1) ⧸ AddMonoidHom.range p_mid) ∧
        Nat.card (Cod ⧸ AddMonoidHom.range sp) * Nat.card (weilEtaleTorsionH Z_Ω M q₀) =
          Nat.card (weilEtaleTorsionH Z_Ks M (q₀ + 1) ⧸ AddMonoidHom.range p_K_R)) :=
by
  intro M Z_Rs g_Ks Z_Ks f_Ks s_Ω Z_Ω T_Ks Cod
  have hM_pos : 1 ≤ M := Nat.one_le_pow (r + 1) ℓ (Fact.out : Nat.Prime ℓ).pos
  have hTor_sh : ∀ X : AlgebraicGeometry.Scheme.{u},
      M • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X M) = 0 := by
    intro X
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod M))
    have hAM : M • CategoryTheory.CategoryStruct.id AM = 0 := by
      ext ⟨x⟩
      change ULift.up (M • x) = ULift.up 0
      simp
    have hmap := CategoryTheory.Functor.map_nsmul
      (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (f := CategoryTheory.CategoryStruct.id AM) (n := M)
    rw [CategoryTheory.Functor.map_id] at hmap
    dsimp [weilEtaleTorsionSheaf]
    rw [← hmap, hAM, CategoryTheory.Functor.map_zero]
  have hTor_ext : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (X₀ F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      M • CategoryTheory.CategoryStruct.id F = 0 →
      ∀ a : CategoryTheory.Abelian.Ext X₀ F q, M • a = 0 := by
    intro X X₀ F q hF a
