      haveI hSpec_fA_et : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf_A_et
      let w_A_hom : AlgebraicGeometry.Spec (CommRingCat.of B_A) ⟶ S :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A) ≫ w₀_hom
      haveI hw_A_et : AlgebraicGeometry.Etale w_A_hom := inferInstance
      let W_A : S.Etale := @AlgebraicGeometry.Scheme.Etale.mk _ _ w_A_hom hw_A_et
      let g_A₀ : W_A ⟶ W₀ := CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A)) rfl trivial
      let g_A : W_A ⟶ U := g_A₀ ≫ g₀
      have hg_A_et : AlgebraicGeometry.Etale g_A.left := by
        change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A) ≫ e_U)
