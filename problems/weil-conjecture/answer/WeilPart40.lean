      rw [h_q_snd, CategoryTheory.Category.id_comp] at hp_aff0
      let Y_V := (weilEtaleSitePullback π_δ).obj (U_aff_et δ)
      let u_rel : (weilAffineSpaceOver K (δ + 1)).left ⟶ Y_V.left :=
        CategoryTheory.Limits.pullback.lift pr_head (ι_aff (δ + 1))
          (hPoly_all δ).2.2.2.1.symm
      have hu_rel_fst : u_rel ≫ CategoryTheory.Limits.pullback.fst (ι_aff δ) π_δ = pr_head :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_rel_snd : u_rel ≫ Y_V.hom = ι_aff (δ + 1) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hp_bot : CategoryTheory.IsPullback
          (Y_V.hom ≫ ρ_δ) (CategoryTheory.Limits.pullback.fst (ι_aff δ) π_δ)
          P_1.hom (ι_aff δ ≫ P_δ.hom) :=
        ((CategoryTheory.IsPullback.of_hasPullback (ι_aff δ) π_δ).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback P_δ.hom P_1.hom)).flip
      have hCastPb : ∀ {X Y₁ Y₂ Z : AlgebraicGeometry.Scheme.{u}}
          {a : X ⟶ Y₁} {b b' : X ⟶ Y₂} {c c' : Y₁ ⟶ Z} {d d' : Y₂ ⟶ Z},
          b = b' → c = c' → d = d' →
          CategoryTheory.IsPullback a b' c' d' →
          CategoryTheory.IsPullback a b c d := by
        rintro _ _ _ _ _ _ _ _ _ _ _ rfl rfl rfl h
        exact h
      have hp_outer : CategoryTheory.IsPullback t_U
          (u_rel ≫ CategoryTheory.Limits.pullback.fst (ι_aff δ) π_δ)
          (ι_P1 ≫ P_1.hom) (ι_aff δ ≫ P_δ.hom) :=
        hCastPb hu_rel_fst hι_P1_hom (hPoly_all δ).2.2.1 hp_aff0
      have hSq_rel : t_U ≫ ι_P1 = u_rel ≫ (Y_V.hom ≫ ρ_δ) := by
        rw [← CategoryTheory.Category.assoc u_rel, hu_rel_snd]
        exact (hPoly_all δ).2.2.2.2.symm
      have hPb_rel : CategoryTheory.IsPullback t_U u_rel ι_P1 (Y_V.hom ≫ ρ_δ) :=
        CategoryTheory.IsPullback.of_bot hp_outer hSq_rel hp_bot
      obtain ⟨hSub0, hSub1, hShift⟩ :=
        weil_polyP1_rel_a1_localTorsion_cohomology_shift K ℓ hℓ hPBC δ ι_P1 hι_P1_hom
          s_inf hs_inf_hom hDisj_inf hCov_inf (U_aff_et δ) (U_aff_et (δ + 1))
          u_rel t_U hu_rel_snd hPb_rel
      refine ⟨?_, ?_, ?_⟩
      · intro r_deg hr_ne
        rcases r_deg with _ | _ | q_shift
        · exact hSub0
        · exact hSub1
        · obtain ⟨e_shift⟩ := hShift q_shift
          have hSub_ih : Subsingleton
              (weilEtaleLocalTorsionH (weilPolyP1Over K δ).left ℓ (U_aff_et δ) q_shift) :=
            hVan_ih q_shift (by omega)
          exact ⟨fun a b => e_shift.injective (hSub_ih.elim _ _)⟩
      · obtain ⟨e_top⟩ := hShift (2 * δ)
        exact @Finite.of_equiv _ _ hFin_ih e_top.symm.toEquiv
      · obtain ⟨e_top⟩ := hShift (2 * δ)
        exact (Nat.card_congr e_top.toEquiv).trans hCard_ih

  
  have hℓ_charK : ℓ ≠ ringChar K := by
    rintro rfl
    exact hℓ ringChar.Nat.cast_ringChar
  obtain ⟨Ψ_roof, _⟩ := weil_etale_pinned_compact_support_roof_transfer K ℓ hℓ_charK
  obtain ⟨hP1_van, hP1_fin, hP1_card⟩ := hPolyP1All d
  have : AlgebraicGeometry.IsAffine (weilAffineSpaceOver K d).left := by
    change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec _)
    infer_instance
  have hAffU0 : AlgebraicGeometry.IsAffine U.toScheme :=
    AlgebraicGeometry.IsAffine.of_isIso e_U.hom
  have hAffU : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_et).left :=
    hAffU0
  have hRoof : WeilIsAffineRoofIso K Y (weilPolyP1Over K d) U_et (U_aff_et d) e_U := by
    refine ⟨inferInstance, (hPoly_all d).1, hAffU, ?_⟩
    change e_U.hom ≫ (ι_aff d ≫ (weilPolyP1Over K d).hom) = U.ι ≫ Y.hom
    rw [(hPoly_all d).2.2.1]
    exact he_U
  refine ⟨?_, ?_, ?_⟩
  · intro r_deg hr_ne
    let e_loc := Ψ_roof Y (weilPolyP1Over K d) U_et (U_aff_et d) e_U hRoof 1 r_deg
    have hSub_pow1 :
        Subsingleton
          (weilEtaleLocalTorsionH (weilPolyP1Over K d).left (ℓ ^ 1) (U_aff_et d) r_deg) := by
      rw [pow_one]
      exact hP1_van r_deg hr_ne
    have hSub_Y1 : Subsingleton (weilEtaleLocalTorsionH Y.left (ℓ ^ 1) U_et r_deg) :=
      ⟨fun a b => e_loc.injective (hSub_pow1.elim _ _)⟩
    rwa [pow_one] at hSub_Y1
  · let e_loc2d := Ψ_roof Y (weilPolyP1Over K d) U_et (U_aff_et d) e_U hRoof 1 (2 * d)
    have hFin_pow1 :
        Finite
          (weilEtaleLocalTorsionH (weilPolyP1Over K d).left (ℓ ^ 1) (U_aff_et d) (2 * d)) := by
      rwa [pow_one]
    have hFin_Y1 : Finite (weilEtaleLocalTorsionH Y.left (ℓ ^ 1) U_et (2 * d)) :=
      @Finite.of_equiv _ _ hFin_pow1 e_loc2d.symm.toEquiv
    rwa [pow_one] at hFin_Y1
  · let e_loc2d := Ψ_roof Y (weilPolyP1Over K d) U_et (U_aff_et d) e_U hRoof 1 (2 * d)
    have hCard1 :
        Nat.card (weilEtaleLocalTorsionH Y.left (ℓ ^ 1) U_et (2 * d)) =
          Nat.card (weilEtaleLocalTorsionH (weilPolyP1Over K d).left (ℓ ^ 1)
            (U_aff_et d) (2 * d)) :=
      Nat.card_congr e_loc2d.toEquiv
    rw [pow_one] at hCard1
    exact hCard1.trans hP1_card

theorem weil_proj_quadric_prime_pow_closed_compl_excision_card_mul (K : Type u) [Field K] [IsAlgClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds K ℓ)
    (Y Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (ι : Z ⟶ Y)
    [AlgebraicGeometry.IsClosedImmersion ι.left]
    (U : Y.left.Opens)
    (hCompl : Set.range ι.left.base = (U : Set ↥Y.left)ᶜ)
    (q : ℕ) :
    let U_et : Y.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι (inferInstance : AlgebraicGeometry.Etale U.ι)
    Subsingleton (weilEtaleTorsionH Z.left ℓ q) →
    Subsingleton (weilEtaleLocalTorsionH Y.left ℓ U_et (q + 2)) →
    Finite (weilEtaleTorsionH Y.left ℓ (q + 1)) →
    Finite (weilEtaleLocalTorsionH Y.left ℓ U_et (q + 1)) →
    Finite (weilEtaleTorsionH Z.left ℓ (q + 1)) →
    Nat.card (weilEtaleTorsionH Y.left ℓ (q + 1)) =
      Nat.card (weilEtaleLocalTorsionH Y.left ℓ U_et (q + 1)) *
        Nat.card (weilEtaleTorsionH Z.left ℓ (q + 1)) :=
by
  let _ := hℓ
  intro U_et hSubZ_q hSubU_q2 _hFinY _hFinU _hFinZ
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

  
  have hExtZero :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        (X G : 𝒞) (r : ℕ),
        CategoryTheory.Limits.IsZero G →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X G r) := by
    intro 𝒞 _ _ _ X G r hG
    have hid : 𝟙 G = 0 := (CategoryTheory.Limits.IsZero.iff_id_eq_zero G).mp hG
    have hzero : ∀ x : CategoryTheory.Abelian.Ext.{u} X G r, x = 0 := by
      intro x
      calc
        x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 G)) (Nat.add_zero r) :=
            (x.comp_mk₀_id).symm
        _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : G ⟶ G)) (Nat.add_zero r) := by
            rw [hid]
        _ = 0 := by
            rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    exact ⟨fun a b => (hzero a).trans (hzero b).symm⟩

  have hExtIsoEquiv :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        (X G₁ G₂ : 𝒞) (_e : G₁ ≅ G₂) (r : ℕ),
        CategoryTheory.Abelian.Ext.{u} X G₁ r ≃ CategoryTheory.Abelian.Ext.{u} X G₂ r := by
    intro 𝒞 _ _ _ X G₁ G₂ e r
    refine
      { toFun := fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero r)
        invFun := fun y => y.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero r)
        left_inv := fun x => by
          dsimp only
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            e.hom_inv_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          dsimp only
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            e.inv_hom_id, CategoryTheory.Abelian.Ext.comp_mk₀_id] }

  have hExtSESCardMul :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        (X : 𝒞) {S : CategoryTheory.ShortComplex 𝒞}
        (_hS : S.ShortExact) (q_deg : ℕ),
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X S.X₃ q_deg) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X S.X₁ (q_deg + 2)) →
        Nat.card (CategoryTheory.Abelian.Ext.{u} X S.X₂ (q_deg + 1)) =
          Nat.card (CategoryTheory.Abelian.Ext.{u} X S.X₁ (q_deg + 1)) *
            Nat.card (CategoryTheory.Abelian.Ext.{u} X S.X₃ (q_deg + 1)) := by
    intro 𝒞 _ _ _ X S hS q_deg hSub₃ hSub₁
    let f_hom : CategoryTheory.Abelian.Ext.{u} X S.X₁ (q_deg + 1) →+
        CategoryTheory.Abelian.Ext.{u} X S.X₂ (q_deg + 1) :=
      (CategoryTheory.Abelian.Ext.mk₀ S.f).postcomp X (Nat.add_zero (q_deg + 1))
    let g_hom : CategoryTheory.Abelian.Ext.{u} X S.X₂ (q_deg + 1) →+
        CategoryTheory.Abelian.Ext.{u} X S.X₃ (q_deg + 1) :=
      (CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp X (Nat.add_zero (q_deg + 1))
    have hInj_f : Function.Injective f_hom := by
      rw [injective_iff_map_eq_zero]
      intro x₁ hx₁
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x₁ hx₁
          (rfl : q_deg + 1 = q_deg + 1)
      have hx₃_zero : x₃ = 0 := hSub₃.elim x₃ 0
      rw [hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp] at hx₃
      exact hx₃.symm
    have hRangeKer : f_hom.range = g_hom.ker := by
      ext x₂
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨x₁, rfl⟩
        change (x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q_deg + 1))).comp
          (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero (q_deg + 1)) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, S.zero,
          CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      · intro hx₂
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X hS x₂ hx₂
    have hSurj_g : Function.Surjective g_hom := by
      intro x₃
      have hbdry : x₃.comp hS.extClass (rfl : (q_deg + 1) + 1 = q_deg + 2) = 0 :=
        hSub₁.elim _ 0
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X hS x₃
        (rfl : (q_deg + 1) + 1 = q_deg + 2) hbdry
    have hCard_quot :
        Nat.card (CategoryTheory.Abelian.Ext.{u} X S.X₂ (q_deg + 1) ⧸ g_hom.ker) =
          Nat.card (CategoryTheory.Abelian.Ext.{u} X S.X₃ (q_deg + 1)) :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective g_hom hSurj_g).toEquiv
    have hBij_range : Function.Bijective f_hom.rangeRestrict :=
      ⟨fun a b h => hInj_f (congrArg Subtype.val h), f_hom.rangeRestrict_surjective⟩
    have hCard_ker :
        Nat.card ↥g_hom.ker =
          Nat.card (CategoryTheory.Abelian.Ext.{u} X S.X₁ (q_deg + 1)) := by
      rw [← hRangeKer]
      exact (Nat.card_eq_of_bijective f_hom.rangeRestrict hBij_range).symm
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup g_hom.ker,
      hCard_quot, hCard_ker, Nat.mul_comm]

  
  have hCoyonedaSheafIso :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        {J : CategoryTheory.GrothendieckTopology C}
        (X₁ X₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (V₁ V₂ : C) (e_V : V₁ ≅ V₂)
        (e₁ : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
          (X₁ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op V₁)))
        (e₂ : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
          (X₂ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op V₂))),
        (∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (α : X₁ ⟶ F) (g : F ⟶ G),
          e₁ G (α ≫ g) = e₁ F α ≫ g.hom.app (Opposite.op V₁)) →
        (∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (β : X₂ ⟶ F) (g : F ⟶ G),
          e₂ G (β ≫ g) = e₂ F β ≫ g.hom.app (Opposite.op V₂)) →
        Nonempty (X₁ ≅ X₂) :=
    fun X₁ X₂ _ _ _ e_V e₁ e₂ he₁_nat he₂_nat =>
      ⟨CategoryTheory.Coyoneda.ext X₁ X₂
        (fun {F} α => (e₂ F).symm (e₁ F α ≫ F.obj.map e_V.inv.op))
        (fun {F} β => (e₁ F).symm (e₂ F β ≫ F.obj.map e_V.hom.op))
        (fun {F} α => by
          rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, ← F.obj.map_comp,
            ← CategoryTheory.op_comp, e_V.hom_inv_id, CategoryTheory.op_id,
            F.obj.map_id, CategoryTheory.Category.comp_id, Equiv.symm_apply_apply])
        (fun {F} β => by
          rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, ← F.obj.map_comp,
            ← CategoryTheory.op_comp, e_V.inv_hom_id, CategoryTheory.op_id,
            F.obj.map_id, CategoryTheory.Category.comp_id, Equiv.symm_apply_apply])
        (fun {F G} β g => by
          apply (e₁ G).injective
          rw [Equiv.apply_symm_apply, he₁_nat, Equiv.apply_symm_apply,
            he₂_nat β g, CategoryTheory.Category.assoc,
            ← g.hom.naturality e_V.hom.op, ← CategoryTheory.Category.assoc])⟩

  have hShriekConstNat :
      ∀ {C₁ : Type (u + 1)} [CategoryTheory.Category.{u} C₁]
        {C₂ : Type (u + 1)} [CategoryTheory.Category.{u} C₂]
        (J₁ : CategoryTheory.GrothendieckTopology C₁)
        (J₂ : CategoryTheory.GrothendieckTopology C₂)
        [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
        (F_site : C₁ ⥤ C₂) [F_site.IsContinuous J₁ J₂]
        [(F_site.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂).IsRightAdjoint]
        {T₁ : C₁} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (M : AddCommGrpCat.{u}),
        let j_shriek := F_site.sheafPullback AddCommGrpCat.{u} J₁ J₂
        let B₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj M
        ∃ e₁ : ∀ F : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u},
            (j_shriek.obj B₁ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op (F_site.obj T₁))),
          ∀ {F G : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
            (α : j_shriek.obj B₁ ⟶ F) (g : F ⟶ G),
            e₁ G (α ≫ g) = e₁ F α ≫ g.hom.app (Opposite.op (F_site.obj T₁)) := by
    intro C₁ _ C₂ _ J₁ J₂ _ F_site _ _ T₁ hT₁ M j_shriek B₁
    let j_star := F_site.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
    let adj_j := F_site.sheafAdjunctionContinuous AddCommGrpCat.{u} J₁ J₂
    let adj_c := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    refine ⟨fun F => (adj_j.homEquiv B₁ F).trans (adj_c.homEquiv M (j_star.obj F)), ?_⟩
    intro F G α g
    change (adj_c.homEquiv M (j_star.obj G)) ((adj_j.homEquiv B₁ G) (α ≫ g)) =
      (adj_c.homEquiv M (j_star.obj F)) ((adj_j.homEquiv B₁ F) α) ≫
        g.hom.app (Opposite.op (F_site.obj T₁))
    have h1 : (adj_j.homEquiv B₁ G) (α ≫ g) = (adj_j.homEquiv B₁ F) α ≫ j_star.map g :=
      adj_j.homEquiv_naturality_right α g
    have h2 : (adj_c.homEquiv M (j_star.obj G))
        ((adj_j.homEquiv B₁ F) α ≫ j_star.map g) =
        (adj_c.homEquiv M (j_star.obj F)) ((adj_j.homEquiv B₁ F) α) ≫
          ((CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj
            (Opposite.op T₁)).map (j_star.map g) :=
      adj_c.homEquiv_naturality_right ((adj_j.homEquiv B₁ F) α) (j_star.map g)
    exact (congrArg (adj_c.homEquiv M (j_star.obj G)) h1).trans h2

  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let J_U : CategoryTheory.Functor U.toScheme.Etale Y.left.Etale :=
    CategoryTheory.MorphismProperty.Over.map ⊤ (inferInstance : AlgebraicGeometry.Etale U.ι)
  obtain ⟨hc_U, hr_U, _, _, _, hConstRes_U⟩ :=
    (weil_etale_open_extensionByZero_excision_and_birational_invariance K ℓ hPBC).1 Y.left U
  have : J_U.IsContinuous U.toScheme.smallEtaleTopology Y.left.smallEtaleTopology := hc_U
  have : (J_U.sheafPushforwardContinuous AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology Y.left.smallEtaleTopology).IsRightAdjoint := hr_U
  let j_star_U := J_U.sheafPushforwardContinuous AddCommGrpCat.{u}
    U.toScheme.smallEtaleTopology Y.left.smallEtaleTopology
  let j_shriek_U := J_U.sheafPullback AddCommGrpCat.{u}
    U.toScheme.smallEtaleTopology Y.left.smallEtaleTopology

  let T₀_U : U.toScheme.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 U.toScheme)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 U.toScheme))
  have hT₀_U : CategoryTheory.Limits.IsTerminal T₀_U :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom))
      (fun W m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))
  let e_TU : J_U.obj T₀_U ≅ U_et :=
    CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl U.toScheme)
      (CategoryTheory.Category.id_comp U.ι)
  obtain ⟨e₁_U, he₁_U_nat⟩ := hShriekConstNat
    U.toScheme.smallEtaleTopology Y.left.smallEtaleTopology J_U hT₀_U AM
  obtain ⟨e_shriek⟩ :
      Nonempty (j_shriek_U.obj (weilEtaleTorsionSheaf U.toScheme ℓ) ≅
        weilEtaleLocalTorsionSheaf Y.left ℓ U_et) :=
    hCoyonedaSheafIso
      (j_shriek_U.obj (weilEtaleTorsionSheaf U.toScheme ℓ))
      (weilEtaleLocalTorsionSheaf Y.left ℓ U_et)
      AM (J_U.obj T₀_U) U_et e_TU e₁_U
      (fun _ => CategoryTheory.Sheaf.freeYonedaHomEquiv)
      he₁_U_nat
      (fun {_ _} β g =>
        (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
          ((CategoryTheory.sheafificationAdjunction
            Y.left.smallEtaleTopology AddCommGrpCat.{u}).homEquiv_naturality_right β g)).trans
          (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ g.hom))

  obtain ⟨e_res⟩ := hConstRes_U AM
  let e_KU : j_shriek_U.obj (j_star_U.obj (weilEtaleTorsionSheaf Y.left ℓ)) ≅
      weilEtaleLocalTorsionSheaf Y.left ℓ U_et :=
    (j_shriek_U.mapIso e_res).trans e_shriek
  let Fℤ_Y := (CategoryTheory.constantSheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let e_H1 : ∀ r : ℕ,
      (j_shriek_U.obj (j_star_U.obj (weilEtaleTorsionSheaf Y.left ℓ))).H r ≃
        weilEtaleLocalTorsionH Y.left ℓ U_et r :=
    fun r => hExtIsoEquiv Fℤ_Y _ _ e_KU r
  have hSub_X1_q2 :
      Subsingleton
        ((j_shriek_U.obj (j_star_U.obj (weilEtaleTorsionSheaf Y.left ℓ))).H (q + 2)) :=
    ⟨fun a b => (e_H1 (q + 2)).injective (hSubU_q2.elim _ _)⟩
  have hCard_X1_q1 :
      Nat.card ((j_shriek_U.obj (j_star_U.obj (weilEtaleTorsionSheaf Y.left ℓ))).H (q + 1)) =
        Nat.card (weilEtaleLocalTorsionH Y.left ℓ U_et (q + 1)) :=
    Nat.card_congr (e_H1 (q + 1))

  
  obtain ⟨_p_ι0, hp0⟩ := weil_etale_torsion_pullback_functoriality.{u}.1 ι.left ℓ 0
  obtain ⟨hc_ι, hr_ι, hAdd_pb, hLim_pb, hColim_pb, T_Z, hT_Z, T_Y, hT_Y, ιℤ, hιπ, hπι, _⟩ := hp0
  have : (weilEtaleSitePullback ι.left).IsContinuous
      Y.left.smallEtaleTopology Z.left.smallEtaleTopology := hc_ι
  have : ((weilEtaleSitePullback ι.left).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.left.smallEtaleTopology Z.left.smallEtaleTopology).IsRightAdjoint := hr_ι
  let pf_ι := (weilEtaleSitePullback ι.left).sheafPushforwardContinuous AddCommGrpCat.{u}
    Y.left.smallEtaleTopology Z.left.smallEtaleTopology
  let pb_ι := (weilEtaleSitePullback ι.left).sheafPullback AddCommGrpCat.{u}
    Y.left.smallEtaleTopology Z.left.smallEtaleTopology
  have : pb_ι.Additive := hAdd_pb
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_ι := hLim_pb
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_ι := hColim_pb

  obtain ⟨_, _, ⟨e_pb'⟩⟩ :=
    (weil_etale_pullback_exact_and_pseudofunctor ℓ).2.2.2.1 ι.left AM
  let e_pb : pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ) ≅ weilEtaleTorsionSheaf Z.left ℓ := e_pb'
  let α_ι : pf_ι.obj (pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ)) ⟶
      pf_ι.obj (weilEtaleTorsionSheaf Z.left ℓ) :=
    (pf_ι.mapIso e_pb).hom

  have hEmptyVanish :
      ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} [IsEmpty ↥W₁] (h : W₁ ⟶ W₂)
        (H : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) (r_deg : ℕ),
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h r_deg H) := by
    intro W₁ W₂ _ h H r_deg
    have hZH : CategoryTheory.Limits.IsZero H :=
      weil_etale_geometric_point_stalk_conservativity W₁ H
        (fun Ω _ _ x => False.elim (IsEmpty.false (x.base (⊥ : PrimeSpectrum Ω))))
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp_bc hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_bc hg)
    let B_h : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let P_h : CategoryTheory.Functor (Opposite W₁.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf H r_deg
    have hZP : CategoryTheory.Limits.IsZero (CategoryTheory.Functor.comp B_h.op P_h) := by
      apply CategoryTheory.Functor.isZero
      intro V
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext x
      have hSub : Subsingleton ↑((CategoryTheory.Functor.comp B_h.op P_h).obj V) :=
        hExtZero _ H r_deg hZH
      exact hSub.elim _ _
    let shf := CategoryTheory.presheafToSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
    have : shf.Additive :=
      CategoryTheory.Adjunction.left_adjoint_additive
        (CategoryTheory.sheafificationAdjunction W₂.smallEtaleTopology AddCommGrpCat.{u})
    exact shf.map_isZero hZP

  have hSerre : WeilConstructibleModPrimeSerreHolds K ℓ :=
    weil_etale_constructible_mod_prime_serre_and_local K ℓ
  have hConstZ : WeilIsConstructibleModPrimeSheaf ℓ Z.left (weilEtaleTorsionSheaf Z.left ℓ) :=
    (weil_etale_constructible_mod_prime_extraction_over_algClosed K Z ℓ 0).1
  have hAcyc_b :=
    (weil_etale_closed_immersion_pushforward_constructible_and_acyclic
      K ℓ hPBC hSerre
      (fun {X₁ X₂} h F r_deg hF =>
        (weil_etale_closed_immersion_and_modification_excision K ℓ hPBC hSerre).1 h F r_deg hF)
      (fun W G h => weil_etale_geometric_point_stalk_conservativity W G h)
      (weil_etale_higherDirectImage_idVanish_isoPush_and_shortExact K ℓ hSerre).1
      hEmptyVanish
      Z Y ι inferInstance (weilEtaleTorsionSheaf Z.left ℓ) hConstZ).2
  have hAcyc : ∀ p : ℕ, 1 ≤ p →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage ι.left p (weilEtaleTorsionSheaf Z.left ℓ)) := by
    intro p hp_ge
    obtain ⟨b, rfl⟩ : ∃ b : ℕ, p = b + 1 := ⟨p - 1, (Nat.sub_add_cancel hp_ge).symm⟩
    exact hAcyc_b b

  have hLeray_ex :
      ∀ r : ℕ,
        ∃ f : (pf_ι.obj (pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ))).H r →
            weilEtaleTorsionH Z.left ℓ r,
          Function.Bijective f :=
    fun r =>
      ⟨_, (weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}.2.2.1
            ι.left hT_Z hT_Y ιℤ hιπ hπι).1
            (pf_ι.obj (pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ)))
            (weilEtaleTorsionSheaf Z.left ℓ)
            α_ι inferInstance hAcyc r⟩

  obtain ⟨e_leray_q, hBij_leray_q⟩ := hLeray_ex q
  obtain ⟨e_leray_q1, hBij_leray_q1⟩ := hLeray_ex (q + 1)
  have hSub_X3_q :
      Subsingleton ((pf_ι.obj (pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ))).H q) :=
    ⟨fun a b => hBij_leray_q.1 (hSubZ_q.elim _ _)⟩
  have hCard_X3_q1 :
      Nat.card ((pf_ι.obj (pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ))).H (q + 1)) =
        Nat.card (weilEtaleTorsionH Z.left ℓ (q + 1)) :=
    Nat.card_eq_of_bijective e_leray_q1 hBij_leray_q1

  
  have hConstY : WeilIsConstructibleModPrimeSheaf ℓ Y.left (weilEtaleTorsionSheaf Y.left ℓ) :=
    (weil_etale_constructible_mod_prime_extraction_over_algClosed K Y ℓ 0).1
  obtain ⟨u, v, huv, hSES⟩ :=
    ((weil_etale_open_extensionByZero_excision_and_birational_invariance K ℓ hPBC).2.1
      Y U (weilEtaleTorsionSheaf Y.left ℓ) hConstY).1 Z ι hCompl
  have hCard_SES :
      Nat.card (weilEtaleTorsionH Y.left ℓ (q + 1)) =
        Nat.card ((j_shriek_U.obj (j_star_U.obj (weilEtaleTorsionSheaf Y.left ℓ))).H (q + 1)) *
          Nat.card ((pf_ι.obj (pb_ι.obj (weilEtaleTorsionSheaf Y.left ℓ))).H (q + 1)) :=
    hExtSESCardMul Fℤ_Y hSES q hSub_X3_q hSub_X1_q2
  rw [hCard_SES, hCard_X1_q1, hCard_X3_q1]

theorem weil_proj_quadric_prime_pow_fiber_paving_and_mid_card (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hAff_R0 : ∀ a : Fin (2 * m + 2 + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))
    (c_R0 : ∀ a : Fin (2 * m + 2 + 1),
      Polynomial k →+* ↑((weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))))
    (t_R0 : ∀ a : Fin (2 * m + 2 + 1), Fin (2 * m + 2 + 1) →
      ↑((weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))))
    (θ_R0 : ∀ a : Fin (2 * m + 2 + 1),
      MvPolynomial (Fin (2 * m + 2)) (Polynomial k) ≃+*
        ↑((weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen (Polynomial k) (2 * m + 2) a))))
    (hCoord_R0 : IsCommRingProjCoordSystem (Polynomial k) (2 * m + 2) hAff_R0 c_R0 t_R0)
    (hθ_R0 : ∀ a : Fin (2 * m + 2 + 1),
      (θ_R0 a).toRingHom.comp MvPolynomial.C = c_R0 a ∧
      ∀ i : Fin (2 * m + 2), θ_R0 a (MvPolynomial.X i) = t_R0 a (a.succAbove i))
    (hAff_Pmk : ∀ a : Fin (m + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k m a))
    (c_Pmk : ∀ a : Fin (m + 1),
      k →+* ↑((weilProjectiveSpaceOver k m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k m a))))
    (t_Pmk : ∀ a : Fin (m + 1), Fin (m + 1) →
      ↑((weilProjectiveSpaceOver k m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k m a))))
    (hCoord_Pmk : IsCommRingProjCoordSystem k m hAff_Pmk c_Pmk t_Pmk)
    (hAff_PmR0 : ∀ a : Fin (m + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen (Polynomial k) m a))
    (c_PmR0 : ∀ a : Fin (m + 1),
      Polynomial k →+* ↑((weilProjectiveSpaceOver (Polynomial k) m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) m a))))
    (t_PmR0 : ∀ a : Fin (m + 1), Fin (m + 1) →
      ↑((weilProjectiveSpaceOver (Polynomial k) m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen (Polynomial k) m a))))
    (θ_PmR0 : ∀ a : Fin (m + 1),
      MvPolynomial (Fin m) (Polynomial k) ≃+*
        ↑((weilProjectiveSpaceOver (Polynomial k) m).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen (Polynomial k) m a))))
    (hCoord_PmR0 : IsCommRingProjCoordSystem (Polynomial k) m hAff_PmR0 c_PmR0 t_PmR0)
    (hθ_PmR0 : ∀ a : Fin (m + 1),
      (θ_PmR0 a).toRingHom.comp MvPolynomial.C = c_PmR0 a ∧
      ∀ i : Fin m, θ_PmR0 a (MvPolynomial.X i) = t_PmR0 a (a.succAbove i))
    (Φ_Pm_R0 : (weilProjectiveSpaceOver (Polynomial k) m).left ⟶
      (weilProjectiveSpaceOver k m).left)
    (hBC_Pm_R0 : IsCommRingProjBaseChange k (Polynomial k) Polynomial.C m
      c_Pmk t_Pmk c_PmR0 t_PmR0 Φ_Pm_R0)
    (Z_Q : AlgebraicGeometry.Scheme.{u})
    (ι_Q : Z_Q ⟶ (weilProjectiveSpaceOver (Polynomial k) (2 * m + 2)).left)
    [AlgebraicGeometry.IsClosedImmersion ι_Q]
    (hPres_Q :
      let N := 2 * m + 2
      let u_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let v_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1 + 1, Nat.succ_lt_succ (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let w_idx : Fin (N + 1) := Fin.last N
      let g_Q0 : ∀ a : Fin (N + 1), Fin 1 →
          ↑((weilProjectiveSpaceOver (Polynomial k) N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen (Polynomial k) N a))) :=
        fun a _ =>
          (∑ j : Fin (m + 1), t_R0 a (u_idx j) * t_R0 a (v_idx j)) -
            c_R0 a Polynomial.X * (t_R0 a w_idx) ^ 2
      ∀ a : Fin (N + 1),
        let O_a : Z_Q.Opens :=
          (TopologicalSpace.Opens.map ι_Q.base).obj (weilProjBasicOpen (Polynomial k) N a)
        ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑((weilProjectiveSpaceOver (Polynomial k) N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen (Polynomial k) N a))) ⧸
              Ideal.span (Set.range (g_Q0 a)))),
          O_a.ι ≫ ι_Q =
            e_a.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
              (hAff_R0 a).fromSpec)
    (hProp_gQ :
      let R₀ := Polynomial k
      let N := 2 * m + 2
      let U_line := AlgebraicGeometry.Spec (CommRingCat.of R₀)
      let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* R₀))
      let Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk ((ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom) ≫ p_A1)
      let g_Q : Q_fam ⟶ CategoryTheory.Over.mk p_A1 :=
        CategoryTheory.Over.homMk (ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom) rfl
      AlgebraicGeometry.IsProper g_Q.left)
    (ι_Pi :
      let R₀ := Polynomial k
      let U_line := AlgebraicGeometry.Spec (CommRingCat.of R₀)
      let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* R₀))
      CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom ⟶ Z_Q)
    [AlgebraicGeometry.IsClosedImmersion ι_Pi]
    (hPi_hom :
      let R₀ := Polynomial k
      let N := 2 * m + 2
      let U_line := AlgebraicGeometry.Spec (CommRingCat.of R₀)
      let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* R₀))
      ι_Pi ≫ (ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom) =
        CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
    (hOddSub :
      let R₀ := Polynomial k
      let N := 2 * m + 2
      let U_line := AlgebraicGeometry.Spec (CommRingCat.of R₀)
      let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* R₀))
      let u_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let w_idx : Fin (N + 1) := Fin.last N
      ∀ (K : Type u) [CommRing K] (φ_s : R₀ →+* K)
        (hAff_NK : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K N a))
        (c_NK : ∀ a : Fin (N + 1),
          K →+* ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K N a))))
        (t_NK : ∀ a : Fin (N + 1), Fin (N + 1) →
          ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K N a))))
        (θ_NK : ∀ a : Fin (N + 1),
          MvPolynomial (Fin N) K ≃+*
            ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K N a))))
        (hAff_PmK : ∀ a : Fin (m + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K m a))
        (c_PmK : ∀ a : Fin (m + 1),
          K →+* ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K m a))))
        (t_PmK : ∀ a : Fin (m + 1), Fin (m + 1) →
          ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K m a))))
        (θ_PmK : ∀ a : Fin (m + 1),
          MvPolynomial (Fin m) K ≃+*
            ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K m a))))
        (Φ_N : (weilProjectiveSpaceOver K N).left ⟶ (weilProjectiveSpaceOver R₀ N).left)
        (Φ_m : (weilProjectiveSpaceOver K m).left ⟶ (weilProjectiveSpaceOver R₀ m).left),
        IsCommRingProjCoordSystem K N hAff_NK c_NK t_NK →
        (∀ a : Fin (N + 1),
          (θ_NK a).toRingHom.comp MvPolynomial.C = c_NK a ∧
          ∀ i : Fin N, θ_NK a (MvPolynomial.X i) = t_NK a (a.succAbove i)) →
        IsCommRingProjCoordSystem K m hAff_PmK c_PmK t_PmK →
        (∀ a : Fin (m + 1),
          (θ_PmK a).toRingHom.comp MvPolynomial.C = c_PmK a ∧
          ∀ i : Fin m, θ_PmK a (MvPolynomial.X i) = t_PmK a (a.succAbove i)) →
        IsCommRingProjBaseChange R₀ K φ_s N c_R0 t_R0 c_NK t_NK Φ_N →
        IsCommRingProjBaseChange R₀ K φ_s m c_PmR0 t_PmR0 c_PmK t_PmK Φ_m →
        ∃ ι_Pi_amb_K : (weilProjectiveSpaceOver K m).left ⟶ (weilProjectiveSpaceOver K N).left,
          AlgebraicGeometry.IsClosedImmersion ι_Pi_amb_K ∧
          ι_Pi_amb_K ≫ (weilProjectiveSpaceOver K N).hom = (weilProjectiveSpaceOver K m).hom ∧
          (∀ a : Fin (N + 1),
            let g_Pi_K : Fin (m + 2) →
                ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
                  (Opposite.op (weilProjBasicOpen K N a))) :=
              fun ν => Fin.lastCases (t_NK a w_idx) (fun j => t_NK a (u_idx j)) ν
            let O_Pi : (weilProjectiveSpaceOver K m).left.Opens :=
              (TopologicalSpace.Opens.map ι_Pi_amb_K.base).obj (weilProjBasicOpen K N a)
            ∃ e_Pi : O_Pi.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
                (↑((weilProjectiveSpaceOver K N).left.presheaf.obj
                  (Opposite.op (weilProjBasicOpen K N a))) ⧸
                  Ideal.span (Set.range g_Pi_K))),
              O_Pi.ι ≫ ι_Pi_amb_K =
                e_Pi.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
                  (hAff_NK a).fromSpec) ∧
          (∀ q_Pm : (weilProjectiveSpaceOver R₀ m).left ⟶
              CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom,
            q_Pm ≫ CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom =
              (weilProjectiveSpaceOver R₀ m).hom →
            q_Pm ≫ CategoryTheory.Limits.pullback.snd p_A1 (weilProjectiveSpaceOver k m).hom =
              Φ_Pm_R0 →
            ι_Pi_amb_K ≫ Φ_N = Φ_m ≫ q_Pm ≫ ι_Pi ≫ ι_Q))
    (K : Type u) [Field K] [IsAlgClosed K]
    (φ_K : Polynomial k →+* K) :
    let R₀ := Polynomial k
    let N := 2 * m + 2
    let U_line := AlgebraicGeometry.Spec (CommRingCat.of R₀)
    let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* R₀))
    let g_Q_hom : Z_Q ⟶ U_line := ι_Q ≫ (weilProjectiveSpaceOver R₀ N).hom
    let s_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_K)
    Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q_hom s_K) ℓ (2 * m + 1)) ∧
    (∀ (i : ℕ), i ≤ 2 * m →
      ∀ (h_Pi_K :
          CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K ⟶
          CategoryTheory.Limits.pullback g_Q_hom s_K),
        h_Pi_K ≫ CategoryTheory.Limits.pullback.fst g_Q_hom s_K =
          CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K ≫
            ι_Pi →
        h_Pi_K ≫ CategoryTheory.Limits.pullback.snd g_Q_hom s_K =
          CategoryTheory.Limits.pullback.snd
            (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K →
        ∀ (p_i :
            weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q_hom s_K) ℓ i →+
            weilEtaleTorsionH
              (CategoryTheory.Limits.pullback
                (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K)
              ℓ i),
          WeilIsTorsionEtalePullback h_Pi_K ℓ i p_i →
          Function.Bijective p_i) ∧
    (Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q_hom s_K) ℓ (2 * m + 2)) ∧
      (φ_K Polynomial.X = 0 →
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q_hom s_K) ℓ (2 * m + 2)) =
          ℓ ^ 2) ∧
      (φ_K Polynomial.X ≠ 0 →
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q_hom s_K) ℓ (2 * m + 2)) =
          ℓ)) :=
by
  classical
  intro R₀ N U_line p_A1 g_Q_hom s_K
  have _ := hPBC
  have _ := hAff_Pmk
  have _ := hCoord_Pmk
  have _ := hCoord_R0
  have _ := hθ_R0
  have _ := hCoord_PmR0
  have _ := hθ_PmR0
  have _ := hProp_gQ
  have _ := hPi_hom

  
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hIsoPullBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (r_deg : ℕ)
      (p_e : weilEtaleTorsionH S₂ ℓ r_deg →+ weilEtaleTorsionH S₁ ℓ r_deg),
      WeilIsTorsionEtalePullback e.hom ℓ r_deg p_e → Function.Bijective p_e := by
    intro S₁ S₂ e r_deg p_e hp_e
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv ℓ r_deg
    obtain ⟨p_id1, hp_id1⟩ := hPullEx (𝟙 S₁) ℓ r_deg
    obtain ⟨p_id2, hp_id2⟩ := hPullEx (𝟙 S₂) ℓ r_deg
    have hid1 : p_id1 = AddMonoidHom.id _ := hPullId ℓ r_deg p_id1 hp_id1
    have hid2 : p_id2 = AddMonoidHom.id _ := hPullId ℓ r_deg p_id2 hp_id2
    have hc1 : WeilIsTorsionEtalePullback (e.hom ≫ e.inv) ℓ r_deg p_id1 := by
      rwa [e.hom_inv_id]
    have hc2 : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) ℓ r_deg p_id2 := by
      rwa [e.inv_hom_id]
    have h1 : p_e.comp p_inv = AddMonoidHom.id _ :=
      (hPullComp e.hom e.inv ℓ r_deg p_e p_inv p_id1 hp_e hp_inv hc1).symm.trans hid1
    have h2 : p_inv.comp p_e = AddMonoidHom.id _ :=
      (hPullComp e.inv e.hom ℓ r_deg p_inv p_e p_id2 hp_inv hp_e hc2).symm.trans hid2
    exact Function.bijective_iff_has_inverse.mpr
      ⟨p_inv, fun x => DFunLike.congr_fun h2 x, fun y => DFunLike.congr_fun h1 y⟩

  let ι_kK : k →+* K := φ_K.comp Polynomial.C
  have hℓ_K : (ℓ : K) ≠ 0 := by
    intro h0
    apply hℓ
    apply RingHom.injective ι_kK
    rw [map_natCast, h0, map_zero]
  have hPBC_K : WeilProperModPrimeBaseChangeHolds K ℓ :=
    weil_etale_proper_base_change_mod_prime K ℓ hℓ_K
  have hP1_K : WeilP1ConstructiblePushforwardHolds K ℓ :=
    weil_etale_p1_constructible_pushforward K ℓ hℓ_K
      (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
        weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀)
      hPBC_K

  let S_K_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))
  have : AlgebraicGeometry.LocallyOfFiniteType S_K_ov.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (𝟙 _)
    infer_instance
  have : AlgebraicGeometry.QuasiCompact S_K_ov.hom := by
    change AlgebraicGeometry.QuasiCompact (𝟙 _)
    infer_instance
  have : AlgebraicGeometry.IsSeparated S_K_ov.hom := by
    change AlgebraicGeometry.IsSeparated (𝟙 _)
    infer_instance

  have hFinProper : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.IsProper W.hom] (r_deg : ℕ),
      Finite (weilEtaleTorsionH W.left ℓ r_deg) := by
    intro W _ r_deg
    let f_W : W ⟶ S_K_ov :=
      CategoryTheory.Over.homMk W.hom (CategoryTheory.Category.comp_id W.hom)
    have hConstW : WeilIsConstructibleModPrimeSheaf ℓ W.left (weilEtaleTorsionSheaf W.left ℓ) :=
      (weil_etale_constructible_mod_prime_extraction_over_algClosed K W ℓ 0).1
    have hPushW : WeilIsConstructibleModPrimeSheaf ℓ
        (AlgebraicGeometry.Spec (CommRingCat.of K))
        (weilEtaleHigherDirectImage W.hom r_deg (weilEtaleTorsionSheaf W.left ℓ)) :=
      weil_etale_proper_constructible_pushforward K ℓ hℓ_K hPBC_K hP1_K W S_K_ov f_W
        (inferInstance : AlgebraicGeometry.IsProper W.hom)
        (weilEtaleTorsionSheaf W.left ℓ) hConstW r_deg
    exact (weil_etale_constructible_mod_prime_extraction_over_algClosed K W ℓ r_deg).2 hPushW

  have hDimSpecK :
      topologicalKrullDim (AlgebraicGeometry.Spec (CommRingCat.of K)) ≤
        (0 : WithBot ℕ∞) := by
    have : Subsingleton (TopologicalSpace.IrreducibleCloseds
        (AlgebraicGeometry.Spec (CommRingCat.of K))) := by
      refine ⟨fun A B => ?_⟩
      ext x
      obtain ⟨a, ha⟩ := A.isIrreducible.nonempty
      obtain ⟨b, hb⟩ := B.isIrreducible.nonempty
      exact ⟨fun _ => Subsingleton.elim x b ▸ hb, fun _ => Subsingleton.elim x a ▸ ha⟩
    have : Nonempty (TopologicalSpace.IrreducibleCloseds
        (AlgebraicGeometry.Spec (CommRingCat.of K))) :=
      ⟨⟨Set.univ,
        ⟨⟨(⊥ : PrimeSpectrum K), trivial⟩,
          fun u v _ _ ⟨x_u, _, hxu⟩ ⟨x_v, _, hyv⟩ =>
            ⟨(⊥ : PrimeSpectrum K), trivial,
              by rwa [Subsingleton.elim (⊥ : PrimeSpectrum K) x_u],
              by rwa [Subsingleton.elim (⊥ : PrimeSpectrum K) x_v]⟩⟩,
        isClosed_univ⟩⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds
        (AlgebraicGeometry.Spec (CommRingCat.of K))) ≤ 0
    rw [Order.krullDim_eq_zero]

  
  let u_idx : Fin (m + 1) → Fin (N + 1) :=
    fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
  let v_idx : Fin (m + 1) → Fin (N + 1) :=
    fun j => ⟨2 * j.1 + 1, Nat.succ_lt_succ (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
  let w_idx : Fin (N + 1) := Fin.last N

  have hQuadOv : ∀ (R : Type u) [CommRing R]
      (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
      (c_R : ∀ a : Fin (N + 1),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))))
      (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a)))),
      IsCommRingProjCoordSystem R N hAff c_R t_R →
      ∀ (t_val : R) (a a' : Fin (N + 1)) (_ : Fin 1),
        ((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_right).op).hom
            ((∑ j : Fin (m + 1), t_R a' (u_idx j) * t_R a' (v_idx j)) -
              c_R a' t_val * (t_R a' w_idx) ^ 2) *
        (((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a a')) ^ 2 =
        ((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_left).op).hom
            ((∑ j : Fin (m + 1), t_R a (u_idx j) * t_R a (v_idx j)) -
              c_R a t_val * (t_R a w_idx) ^ 2) := by
    intro R _ hAff c_R t_R hCoord t_val a a' _
    rcases hCoord with ⟨_, _, _, _, _, _, _, _, hC_ov, hT_ov⟩
    set resL := ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom
    set resR := ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom
    rw [map_sub, map_sum, map_mul, map_pow, map_sub, map_sum, map_mul, map_pow,
      sub_mul, Finset.sum_mul]
    congr 1
    · refine Finset.sum_congr rfl fun j _ => ?_
      calc
        resR (t_R a' (u_idx j) * t_R a' (v_idx j)) * resL (t_R a a') ^ 2 =
            (resR (t_R a' (u_idx j)) * resL (t_R a a')) *
              (resR (t_R a' (v_idx j)) * resL (t_R a a')) := by
          rw [map_mul]; ring
        _ = resL (t_R a (u_idx j)) * resL (t_R a (v_idx j)) := by
          rw [hT_ov a a' (u_idx j), hT_ov a a' (v_idx j)]
        _ = resL (t_R a (u_idx j) * t_R a (v_idx j)) := (map_mul _ _ _).symm
    · calc
        resR (c_R a' t_val) * resR (t_R a' w_idx) ^ 2 * resL (t_R a a') ^ 2 =
            resR (c_R a' t_val) * (resR (t_R a' w_idx) * resL (t_R a a')) ^ 2 := by ring
        _ = resL (c_R a t_val) * resL (t_R a w_idx) ^ 2 := by
          rw [hC_ov a a' t_val, hT_ov a a' w_idx]

  obtain ⟨hAtlas, hProjBC, hSubEx, hSubIncl, hSubBC⟩ :=
    weil_proj_quadric_paving_commRing_proj_atlas.{u}
  let t_K_val : K := φ_K Polynomial.X
  obtain ⟨hAff_NK, c_NK, t_NK, θ_NK, hCoord_NK, hθ_NK⟩ := hAtlas K N
  obtain ⟨hAff_PmK, c_PmK, t_PmK, θ_PmK, hCoord_PmK, hθ_PmK⟩ := hAtlas K m
  obtain ⟨Φ_N, hBC_N⟩ :=
    hProjBC R₀ K φ_K N hAff_R0 c_R0 t_R0 hAff_NK c_NK t_NK hCoord_R0 hCoord_NK
  obtain ⟨Φ_m, hBC_m⟩ :=
    hProjBC R₀ K φ_K m hAff_PmR0 c_PmR0 t_PmR0 hAff_PmK c_PmK t_PmK hCoord_PmR0 hCoord_PmK

  let g_Q0 : ∀ a : Fin (N + 1), Fin 1 →
      ↑((weilProjectiveSpaceOver R₀ N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R₀ N a))) :=
    fun a _ =>
      (∑ j : Fin (m + 1), t_R0 a (u_idx j) * t_R0 a (v_idx j)) -
        c_R0 a Polynomial.X * (t_R0 a w_idx) ^ 2
  let g_Qt : ∀ a : Fin (N + 1), Fin 1 →
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a _ =>
      (∑ j : Fin (m + 1), t_NK a (u_idx j) * t_NK a (v_idx j)) -
        c_NK a t_K_val * (t_NK a w_idx) ^ 2
  obtain ⟨Q_t, ι_Qt, hCl_Qt, hPres_Qt⟩ :=
    hSubEx K N hAff_NK c_NK t_NK hCoord_NK 1 (fun _ => 2) g_Qt
      (hQuadOv K hAff_NK c_NK t_NK hCoord_NK t_K_val)
  have : AlgebraicGeometry.IsClosedImmersion ι_Qt := hCl_Qt

  have hg_compat : ∀ a : Fin (N + 1),
      ∃ heq : (TopologicalSpace.Opens.map Φ_N.base).obj (weilProjBasicOpen R₀ N a) =
          weilProjBasicOpen K N a,
        ∀ ν : Fin 1,
          (Φ_N.app (weilProjBasicOpen R₀ N a) ≫
            (weilProjectiveSpaceOver K N).left.presheaf.map
              (CategoryTheory.eqToHom heq.symm).op).hom (g_Q0 a ν) = g_Qt a ν := by
    intro a
    obtain ⟨heq, hc_map, ht_map⟩ := hBC_N.2.2 a
    refine ⟨heq, fun _ => ?_⟩
    dsimp only [g_Q0, g_Qt, t_K_val]
    rw [map_sub, map_sum, map_mul, map_pow, hc_map, ht_map]
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, ht_map, ht_map]

  obtain ⟨ψ_Qt, hPb_Qt⟩ :=
    hSubBC R₀ K φ_K N hAff_R0 c_R0 t_R0 hAff_NK c_NK t_NK Φ_N
      hCoord_R0 hCoord_NK hBC_N 1 Z_Q ι_Q g_Q0 Q_t ι_Qt g_Qt hPres_Q hPres_Qt hg_compat

  have hPb_PN : CategoryTheory.IsPullback Φ_N
      (weilProjectiveSpaceOver K N).hom (weilProjectiveSpaceOver R₀ N).hom s_K :=
    hBC_N.2.1
  have hPb_Qt_fib : CategoryTheory.IsPullback ψ_Qt
      (ι_Qt ≫ (weilProjectiveSpaceOver K N).hom) g_Q_hom s_K :=
    hPb_Qt.paste_vert hPb_PN
  let e_QK : Q_t ≅ CategoryTheory.Limits.pullback g_Q_hom s_K := hPb_Qt_fib.isoPullback

  have hPb_PmR0 : CategoryTheory.IsPullback
      (weilProjectiveSpaceOver R₀ m).hom Φ_Pm_R0 p_A1 (weilProjectiveSpaceOver k m).hom :=
    hBC_Pm_R0.2.1.flip
  let e_PmR0 : (weilProjectiveSpaceOver R₀ m).left ≅
      CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom :=
    hPb_PmR0.isoPullback
  have hPb_PmK : CategoryTheory.IsPullback Φ_m
      (weilProjectiveSpaceOver K m).hom (weilProjectiveSpaceOver R₀ m).hom s_K :=
    hBC_m.2.1
  have hp_ePm : CategoryTheory.IsPullback e_PmR0.hom (weilProjectiveSpaceOver R₀ m).hom
      (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) (𝟙 U_line) :=
    CategoryTheory.IsPullback.of_horiz_isIso
      ⟨by rw [hPb_PmR0.isoPullback_hom_fst, CategoryTheory.Category.comp_id]⟩
  have hPb_PiK : CategoryTheory.IsPullback (Φ_m ≫ e_PmR0.hom)
      (weilProjectiveSpaceOver K m).hom
      (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K := by
    have h0 := hPb_PmK.paste_horiz hp_ePm
    rwa [CategoryTheory.Category.comp_id] at h0
  let e_PiK : (weilProjectiveSpaceOver K m).left ≅
      CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom) s_K :=
    hPb_PiK.isoPullback

  obtain ⟨ι_Pi_amb_K, hCl_PiK, hPiK_hom, hPres_PiK, hPiK_compat⟩ :=
    hOddSub K φ_K hAff_NK c_NK t_NK θ_NK hAff_PmK c_PmK t_PmK θ_PmK Φ_N Φ_m
      hCoord_NK hθ_NK hCoord_PmK hθ_PmK hBC_N hBC_m
  have : AlgebraicGeometry.IsClosedImmersion ι_Pi_amb_K := hCl_PiK

  obtain ⟨⟨Z, ι_step, U_step, ι_tot, e_bot, hProp_Z, hCl_Z, hCompl_Z,
      hCell_Z_mid, hCell_Z_top_ne, hCell_Z_top_eq, hIso_Z0, hTot_Z, hBot_Qt⟩,
    ⟨P_step, κ_step, V_step, κ_tot, hProp_P, hCl_P, hIso_Pm_last, hCompl_P, hCell_P,
      hIso_P0, hTot_P⟩⟩ :=
    weil_proj_quadric_prime_pow_exact_fiber_cellular_towers K m t_K_val
      hAff_NK c_NK t_NK θ_NK hCoord_NK hθ_NK
      hAff_PmK c_PmK t_PmK θ_PmK hCoord_PmK hθ_PmK
      (hSubEx K) (hSubIncl K)
      Q_t ι_Qt hPres_Qt ι_Pi_amb_K hPres_PiK

  
  have hSub_Zbot : ∀ (q_hi : ℕ), 2 * m + 1 ≤ q_hi →
      Subsingleton (weilEtaleTorsionH (Z (Fin.last (m + 2))).left ℓ q_hi) := by
    intro q_hi hq_hi
    have hTowerB_inj : ∀ (n : ℕ) (hn : n < m + 1)
        (p_n : weilEtaleTorsionH (weilProjectiveSpaceOver K m).left ℓ q_hi →+
          weilEtaleTorsionH (P_step ⟨n, hn⟩).left ℓ q_hi),
        WeilIsTorsionEtalePullback (κ_tot ⟨n, hn⟩) ℓ q_hi p_n →
        Function.Injective p_n := by
      intro n
      induction n with
      | zero =>
        intro hn p_0 hp_0
        have : CategoryTheory.IsIso (κ_tot ⟨0, hn⟩) := hIso_P0
        exact (hIsoPullBij (CategoryTheory.asIso (κ_tot ⟨0, hn⟩)) q_hi p_0 hp_0).1
      | succ n ih =>
        intro hn p_succ hp_succ
        let s : Fin m := ⟨n, Nat.lt_of_succ_lt_succ hn⟩
        have : AlgebraicGeometry.IsProper (P_step s.castSucc).hom := hProp_P s.castSucc
        have : AlgebraicGeometry.IsProper (P_step s.succ).hom := hProp_P s.succ
        have : AlgebraicGeometry.IsClosedImmersion (κ_step s).left := hCl_P s
        obtain ⟨p_prev, hp_prev⟩ := hPullEx (κ_tot s.castSucc) ℓ q_hi
        obtain ⟨p_st, hp_st⟩ := hPullEx (κ_step s).left ℓ q_hi
        have hcomp_hp : WeilIsTorsionEtalePullback (κ_tot s.succ) ℓ q_hi p_succ := hp_succ
        rw [hTot_P s] at hcomp_hp
        have hp_eq : p_succ = p_st.comp p_prev :=
          hPullComp (κ_step s).left (κ_tot s.castSucc) ℓ q_hi
            p_st p_prev p_succ hp_st hp_prev hcomp_hp
        obtain ⟨e_V, he_V⟩ := hCell_P s
        have hs_lt : s.1 < m := s.isLt
        have hSub_V : Subsingleton
            (weilEtaleLocalTorsionH (P_step s.castSucc).left ℓ
              (CategoryTheory.MorphismProperty.Over.mk ⊤ (V_step s).ι
                (inferInstance : AlgebraicGeometry.Etale (V_step s).ι))
              q_hi) :=
          (weil_proj_quadric_prime_pow_affine_cell_local_cohomology K ℓ hℓ_K hPBC_K
            (P_step s.castSucc) (V_step s) (m - s.1) e_V he_V).1 q_hi (by omega)
        have hInj_st : Function.Injective p_st :=
          (weil_proj_quadric_paving_closed_compl_excision_step K ℓ hℓ_K hPBC_K
            (P_step s.castSucc) (P_step s.succ) (κ_step s) (V_step s) (hCompl_P s)
            q_hi p_st hp_st).2.1 hSub_V
        have hInj_prev : Function.Injective p_prev :=
          ih (Nat.lt_trans (Nat.lt_succ_self n) hn) p_prev hp_prev
        rw [hp_eq]
        exact hInj_st.comp hInj_prev
    have hSub_SpecK :
        Subsingleton
          (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K)) ℓ q_hi) :=
      weil_etale_dim_zero_algClosed_cohomology_subsingleton K S_K_ov hDimSpecK
        (weilEtaleTorsionSheaf (AlgebraicGeometry.Spec (CommRingCat.of K)) ℓ)
        q_hi (by omega)
    have : CategoryTheory.IsIso (P_step (Fin.last m)).hom := hIso_Pm_last
    let e_Plast := CategoryTheory.asIso (P_step (Fin.last m)).hom
    obtain ⟨p_Plast_inv, hp_Plast_inv⟩ := hPullEx e_Plast.inv ℓ q_hi
    have hBij_Plast : Function.Bijective p_Plast_inv :=
      hIsoPullBij e_Plast.symm q_hi p_Plast_inv hp_Plast_inv
    have hSub_Plast : Subsingleton (weilEtaleTorsionH (P_step (Fin.last m)).left ℓ q_hi) :=
      ⟨fun a b => hBij_Plast.1 (hSub_SpecK.elim _ _)⟩
    obtain ⟨p_κ_last, hp_κ_last⟩ := hPullEx (κ_tot (Fin.last m)) ℓ q_hi
    have hInj_κ_last : Function.Injective p_κ_last :=
      hTowerB_inj m (Nat.lt_succ_self m) p_κ_last hp_κ_last
    have hSub_PmK :
        Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver K m).left ℓ q_hi) :=
      ⟨fun a b => hInj_κ_last (hSub_Plast.elim _ _)⟩
    obtain ⟨p_ebot, hp_ebot⟩ := hPullEx e_bot.hom ℓ q_hi
    have hBij_ebot : Function.Bijective p_ebot :=
      hIsoPullBij e_bot q_hi p_ebot hp_ebot
    exact ⟨fun a b => hBij_ebot.1 (hSub_PmK.elim _ _)⟩

  have hSub_Zbot_2m1 :
      Subsingleton (weilEtaleTorsionH (Z (Fin.last (m + 2))).left ℓ (2 * m + 1)) :=
    hSub_Zbot (2 * m + 1) (le_refl _)
  have hSub_Zbot_2m2 :
      Subsingleton (weilEtaleTorsionH (Z (Fin.last (m + 2))).left ℓ (2 * m + 2)) :=
    hSub_Zbot (2 * m + 2) (by omega)
  have hCard_Zbot_2m2 :
      Nat.card (weilEtaleTorsionH (Z (Fin.last (m + 2))).left ℓ (2 * m + 2)) = 1 :=
    Nat.card_eq_one_iff_unique.mpr ⟨hSub_Zbot_2m2, ⟨0⟩⟩

  
  have hTowerA_low_local_vanish : ∀ (s : Fin (m + 2)) (r_low : ℕ),
      r_low ≤ 2 * m + 1 →
      Subsingleton
        (weilEtaleLocalTorsionH (Z s.castSucc).left ℓ
          (CategoryTheory.MorphismProperty.Over.mk ⊤ (U_step s).ι
            (inferInstance : AlgebraicGeometry.Etale (U_step s).ι))
