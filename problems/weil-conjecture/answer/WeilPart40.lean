  · intro r z
    have htr_i := DFunLike.congr_fun
      (hPullTrans i_Z_Rbar ℓ (r + 1) (2 * m + 2)
        (p_iRbar_top (r + 1)) (p_iRbar_top r)
        (hp_iRbar_top (r + 1)) (hp_iRbar_top r))
      (β_raw (r + 1) ((θ_Z (r + 1)).symm z))
    dsimp only [β, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
    change weilEtaleTorsionTransition Z_s ℓ (r + 1) (2 * m + 2)
        (p_iRbar_top (r + 1) (β_raw (r + 1) ((θ_Z (r + 1)).symm z))) =
      p_iRbar_top r
        (β_raw r ((θ_Z r).symm
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) z)))
    have htr_i' : weilEtaleTorsionTransition Z_s ℓ (r + 1) (2 * m + 2)
        (p_iRbar_top (r + 1) (β_raw (r + 1) ((θ_Z (r + 1)).symm z))) =
      p_iRbar_top r
        (weilEtaleTorsionTransition Z_Rbar ℓ (r + 1) (2 * m + 2)
          (β_raw (r + 1) ((θ_Z (r + 1)).symm z))) := htr_i
    rw [htr_i', hLeray_nat r ((θ_Z (r + 1)).symm z)]
    congr 2
    apply (θ_Z r).injective
    rw [hθ_Z_nat r ((θ_Z (r + 1)).symm z), AddEquiv.apply_symm_apply,
      AddEquiv.apply_symm_apply]
  · intro r
    obtain ⟨p_j2m1, hp_j2m1⟩ := hPullEx j_Z_Rbar (ℓ ^ (r + 1)) (2 * m + 1)
    obtain ⟨p_q2m1, hp_q2m1⟩ := hPullEx q_Rbar_Rs (ℓ ^ (r + 1)) (2 * m + 1)
    have hcomp_2m1 : p_2m1 r = p_j2m1.comp p_q2m1 :=
      hPullComp j_Z_Rbar q_Rbar_Rs (ℓ ^ (r + 1)) (2 * m + 1) p_j2m1 p_q2m1 (p_2m1 r)
        hp_j2m1 hp_q2m1 (hp_2m1 r)
    have hbij_q := hBij_qRs r (2 * m + 1) p_q2m1 hp_q2m1
    obtain ⟨_, hex1, hex2, hex3, hsurj_j2m2⟩ :=
      hLeray_ex r p_j2m1 (p_jRbar_top r) hp_j2m1 (hp_jRbar_top r)
    refine ⟨?_, ?_, ?_, ?_⟩
    · ext x
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker, ν, AddMonoidHom.comp_apply,
        AddEquiv.coe_toAddMonoidHom]
      have hrng : (∃ y, p_2m1 r y = x) ↔ x ∈ AddMonoidHom.range p_j2m1 := by
        rw [hcomp_2m1]
        simp only [AddMonoidHom.mem_range, AddMonoidHom.comp_apply]
        exact ⟨fun ⟨y, hy⟩ => ⟨p_q2m1 y, hy⟩,
          fun ⟨w, hw⟩ => let ⟨y, hy⟩ := hbij_q.2 w; ⟨y, hy.symm ▸ hw⟩⟩
      rw [hrng, hex1, AddMonoidHom.mem_ker]
      exact ⟨fun h => by rw [h, map_zero],
        fun h => (θ_Z r).injective (h.trans (map_zero (θ_Z r)).symm)⟩
    · ext z
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker, ν, β, AddMonoidHom.comp_apply,
        AddEquiv.coe_toAddMonoidHom]
      have hlhs : (∃ u, θ_Z r (ν_raw r u) = z) ↔
          (θ_Z r).symm z ∈ AddMonoidHom.range (ν_raw r) := by
        simp only [AddMonoidHom.mem_range]
        constructor
        · rintro ⟨u, hu⟩
          refine ⟨u, ?_⟩
          rw [← hu, AddEquiv.symm_apply_apply]
        · rintro ⟨u, hu⟩
          refine ⟨u, ?_⟩
          rw [hu, AddEquiv.apply_symm_apply]
      rw [hlhs, hex2, AddMonoidHom.mem_ker]
      have hinj_i := (e_iRbar_top r).injective
      exact ⟨fun h => by rw [h, map_zero],
        fun h => hinj_i (h.trans (map_zero (e_iRbar_top r)).symm)⟩
    · ext w
      simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker, β, sp_2m2,
        AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      have hlhs : (∃ z, p_iRbar_top r (β_raw r ((θ_Z r).symm z)) = w) ↔
          (e_iRbar_top r).symm w ∈ AddMonoidHom.range (β_raw r) := by
        simp only [AddMonoidHom.mem_range]
        constructor
        · rintro ⟨z, hz⟩
          refine ⟨(θ_Z r).symm z, ?_⟩
          have hz' : e_iRbar_top r (β_raw r ((θ_Z r).symm z)) = w := hz
          rw [← hz', AddEquiv.symm_apply_apply]
        · rintro ⟨y, hy⟩
          refine ⟨θ_Z r y, ?_⟩
          rw [AddEquiv.symm_apply_apply, hy]
          exact (e_iRbar_top r).apply_symm_apply w
      rw [hlhs, hex3, AddMonoidHom.mem_ker]
    · dsimp only [sp_2m2]
      rw [AddMonoidHom.coe_comp]
      exact hsurj_j2m2.comp (e_iRbar_top r).symm.surjective

theorem weil_mid_dev_odp_open_spec_and_coker_bound (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (hProj_Zu₀ : IsProjectiveOverField F Z_u₀)
    (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
    (hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) :
    let D₀ := weilProjectiveSpaceOver F 1
    let pr_D : Quiver.Hom (weilGeomScheme F D₀) D₀.left :=
      CategoryTheory.Limits.pullback.fst D₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    ∃ (η_sp : ∀ r : ℕ, Quiver.Hom
        (weilSingDevPencilHigherDirectImage F f₀ ℓ (2 * m + 1) r)
        (weilEtaleHigherDirectImage U₀.ι 0
          (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r)))
      (C_sp : ℕ),
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp
          (weilSingDevPencilHigherDirectImageMap F f₀ ℓ (2 * m + 1) r) (η_sp r) =
        CategoryTheory.CategoryStruct.comp (η_sp (r + 1))
          (weilEtaleHigherDirectImageMap U₀.ι 0
            (weilMidDevOpenHigherDirectImageMap F f₀ U₀ ℓ (2 * m + 1) r))) ∧
      (∀ (r : ℕ) (W : D₀.left.Etale),
        Set.range ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W).hom.base ⊆
          (U₀ : Set D₀.left) →
        Function.Bijective ((η_sp r).hom.app (Opposite.op W))) ∧
      (∀ (r : ℕ)
          (hCont_pr : (weilEtaleSitePullback pr_D).IsContinuous
            D₀.left.smallEtaleTopology (weilGeomScheme F D₀).smallEtaleTopology)
          (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
            D₀.left.smallEtaleTopology (weilGeomScheme F D₀).smallEtaleTopology
            hCont_pr).IsRightAdjoint),
        (ℓ ^ C_sp) • CategoryTheory.CategoryStruct.id
          ((@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
            D₀.left.smallEtaleTopology (weilGeomScheme F D₀).smallEtaleTopology
            hCont_pr hAdj_pr).obj (CategoryTheory.Limits.cokernel (η_sp r))) = 0) :=
by
  classical
  have _ : True := by
    let _ := Z_u₀
    let _ := ι_Zu₀
    have _ := hProj_Ztilde
    have _ := hProj_Zu₀
    have _ := hPb_Zu₀
    trivial
  have hPrime : Nat.Prime ℓ := Fact.out

  have hℓ_cast : ∀ (K₀ : Type u) [Field K₀] (_ : F →+* K₀), (ℓ : K₀) ≠ 0 := by
    intro K₀ _ φ h0
    have hF0 : (ℓ : F) = 0 := φ.injective (by rw [map_natCast, h0, map_zero])
    have hdvd : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff F (ringChar F) ℓ).mp hF0
    rcases hPrime.eq_one_or_self_of_dvd (ringChar F) hdvd with h1 | heq
    · exact CharP.char_ne_one F (ringChar F) h1
    · exact hℓ heq.symm

  have hℓ_ringChar : ∀ (K₀ : Type u) [Field K₀], (ℓ : K₀) ≠ 0 → ℓ ≠ ringChar K₀ := by
    intro K₀ _ hne heq
    apply hne
    rw [heq]
    exact ringChar.Nat.cast_ringChar

  have hModPrimeLadderAndFin : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      ((∀ i : ℕ, Finite (weilEtaleTorsionH X ℓ i)) →
        ∀ (n i : ℕ), Finite (weilEtaleTorsionH X (ℓ ^ n) i)) ∧
      (∀ q : ℕ,
        let M : ℕ → AddCommGrpCat.{u} := fun n => AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ n) q)
        let M' : ℕ → AddCommGrpCat.{u} :=
          fun n => AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ n) (q + 1))
        ∃ (j_M : ∀ m_idx n : ℕ, m_idx ≤ n → Quiver.Hom (M m_idx) (M n))
          (τ_M : ∀ m_idx n : ℕ, m_idx ≤ n → Quiver.Hom (M n) (M m_idx))
          (δ_M : ∀ a b c : ℕ, a + c = b → Quiver.Hom (M c) (M' a)),
          (∀ n : ℕ, (ℓ ^ n) • CategoryTheory.CategoryStruct.id (M n) = 0) ∧
          (∀ (n : ℕ) (h : n ≤ n),
            j_M n n h = CategoryTheory.CategoryStruct.id (M n) ∧
            τ_M n n h = CategoryTheory.CategoryStruct.id (M n)) ∧
          (∀ (k_idx m_idx n : ℕ) (h₁ : k_idx ≤ m_idx) (h₂ : m_idx ≤ n),
            CategoryTheory.CategoryStruct.comp (j_M k_idx m_idx h₁) (j_M m_idx n h₂) =
              j_M k_idx n (le_trans h₁ h₂) ∧
            CategoryTheory.CategoryStruct.comp (τ_M m_idx n h₂) (τ_M k_idx m_idx h₁) =
              τ_M k_idx n (le_trans h₁ h₂)) ∧
          (∀ (m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
              (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
            m₁ + d = n₁ → m₂ + d = n₂ →
            CategoryTheory.CategoryStruct.comp (j_M m₁ n₁ h₁) (τ_M n₂ n₁ hn) =
              CategoryTheory.CategoryStruct.comp (τ_M m₂ m₁ hm) (j_M m₂ n₂ h₂)) ∧
          (∀ (m_idx n d : ℕ) (h : m_idx ≤ n),
            m_idx + d = n →
            CategoryTheory.CategoryStruct.comp (j_M m_idx n h) (τ_M m_idx n h) =
              (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M m_idx) ∧
            CategoryTheory.CategoryStruct.comp (τ_M m_idx n h) (j_M m_idx n h) =
              (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M n)) ∧
          (∀ (a b c : ℕ) (habc : a + c = b),
            ∃ h₁ : CategoryTheory.CategoryStruct.comp
                (j_M a b (Nat.le.intro habc))
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) = 0,
              (CategoryTheory.ShortComplex.mk
                (j_M a b (Nat.le.intro habc))
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) h₁).Exact) ∧
          (∀ (a b c : ℕ) (habc : a + c = b),
            ∃ h₂ : CategoryTheory.CategoryStruct.comp
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
                (δ_M a b c habc) = 0,
              (CategoryTheory.ShortComplex.mk
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
                (δ_M a b c habc) h₂).Exact) ∧
          (∀ (c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
            CategoryTheory.CategoryStruct.comp (j_M c₁ c₂ hc) (δ_M 1 (1 + c₂) c₂ rfl) =
              δ_M 1 (1 + c₁) c₁ rfl) ∧
          (∀ (r : ℕ) (x : weilEtaleTorsionH X (ℓ ^ (r + 1)) q),
            (τ_M r (r + 1) (Nat.le_succ r)).hom x =
              weilEtaleTorsionTransition X ℓ r q x)) := by
    intro X
    let _ : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hPrime.ne_zero⟩
    let A : ℕ → AddCommGrpCat.{u} := fun n =>
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ n)))
    let red : ∀ (m_idx n : ℕ), m_idx ≤ n → (A n ⟶ A m_idx) := fun m_idx _n h =>
      AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m_idx))).toAddMonoidHom)
    let inc0 : ∀ (m_idx n : ℕ), m_idx ≤ n → (ZMod (ℓ ^ m_idx) →+ ZMod (ℓ ^ n)) :=
      fun m_idx n h =>
        { toFun := fun x => ((x.val * ℓ ^ (n - m_idx) : ℕ) : ZMod (ℓ ^ n))
          map_zero' := by simp
          map_add' := fun x y => by
            have hxy : (x + y).val + ℓ ^ m_idx * ((x.val + y.val) / ℓ ^ m_idx) =
                x.val + y.val := by
              rw [ZMod.val_add]
              have h1 := Nat.mod_add_div (x.val + y.val) (ℓ ^ m_idx)
              omega
            have hmul := congrArg (· * ℓ ^ (n - m_idx)) hxy
            rw [Nat.add_mul, Nat.add_mul] at hmul
            have hpow : ℓ ^ m_idx * ((x.val + y.val) / ℓ ^ m_idx) * ℓ ^ (n - m_idx) =
                ℓ ^ n * ((x.val + y.val) / ℓ ^ m_idx) := by
              calc ℓ ^ m_idx * ((x.val + y.val) / ℓ ^ m_idx) * ℓ ^ (n - m_idx)
                  = (ℓ ^ m_idx * ℓ ^ (n - m_idx)) * ((x.val + y.val) / ℓ ^ m_idx) := by ring
                _ = ℓ ^ n * ((x.val + y.val) / ℓ ^ m_idx) := by
                    rw [← pow_add, Nat.add_sub_of_le h]
            rw [hpow] at hmul
            have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ n)) hmul
            rw [Nat.cast_add, Nat.cast_add, Nat.cast_mul (ℓ ^ n), ZMod.natCast_self,
              zero_mul, add_zero] at hcast
            exact hcast }
    let inc : ∀ (m_idx n : ℕ), m_idx ≤ n → (A m_idx ⟶ A n) := fun m_idx n h =>
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (inc0 m_idx n h))
    have h_eval : ∀ (n t : ℕ) (x : ↑(A n)),
        ((t • CategoryTheory.CategoryStruct.id (A n)).hom x).down = t • x.down := by
      intro n t x
      induction t with
      | zero => rfl
      | succ t ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((t • CategoryTheory.CategoryStruct.id (A n)).hom x).down + x.down =
          t • x.down + x.down
        rw [ih]
    have hTor_A : ∀ n : ℕ, (ℓ ^ n) • CategoryTheory.CategoryStruct.id (A n) = 0 := by
      intro n; apply AddCommGrpCat.ext; intro x; apply ULift.ext
      rw [h_eval n (ℓ ^ n) x, nsmul_eq_mul, ZMod.natCast_self, zero_mul]; rfl
    have hId_A : ∀ (n : ℕ) (h : n ≤ n),
        inc n n h = CategoryTheory.CategoryStruct.id (A n) ∧
        red n n h = CategoryTheory.CategoryStruct.id (A n) := by
      intro n h
      refine ⟨?_, ?_⟩
      · apply AddCommGrpCat.ext; intro x; apply ULift.ext
        change ((x.down.val * ℓ ^ (n - n) : ℕ) : ZMod (ℓ ^ n)) = x.down
        rw [Nat.sub_self, pow_zero, mul_one, ZMod.natCast_zmod_val]
      · apply AddCommGrpCat.ext; intro x; apply ULift.ext
        change ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ n)) x.down = x.down
        rw [ZMod.castHom_self, RingHom.id_apply]
    have hComp_A : ∀ (k_idx m_idx n : ℕ) (h₁ : k_idx ≤ m_idx) (h₂ : m_idx ≤ n),
        CategoryTheory.CategoryStruct.comp (inc k_idx m_idx h₁) (inc m_idx n h₂) =
          inc k_idx n (le_trans h₁ h₂) ∧
        CategoryTheory.CategoryStruct.comp (red m_idx n h₂) (red k_idx m_idx h₁) =
          red k_idx n (le_trans h₁ h₂) := by
      intro k_idx m_idx n h₁ h₂
      refine ⟨?_, ?_⟩
      · apply AddCommGrpCat.ext; intro x; apply ULift.ext
        change ((((x.down.val * ℓ ^ (m_idx - k_idx) : ℕ) : ZMod (ℓ ^ m_idx)).val *
          ℓ ^ (n - m_idx) : ℕ) : ZMod (ℓ ^ n)) =
          ((x.down.val * ℓ ^ (n - k_idx) : ℕ) : ZMod (ℓ ^ n))
        have hlt : x.down.val * ℓ ^ (m_idx - k_idx) < ℓ ^ m_idx := by
          calc x.down.val * ℓ ^ (m_idx - k_idx)
              < ℓ ^ k_idx * ℓ ^ (m_idx - k_idx) :=
                Nat.mul_lt_mul_of_pos_right x.down.val_lt (pow_pos hPrime.pos _)
            _ = ℓ ^ m_idx := by rw [← pow_add, Nat.add_sub_of_le h₁]
        rw [ZMod.val_natCast_of_lt hlt, mul_assoc, ← pow_add]
        have hsub : m_idx - k_idx + (n - m_idx) = n - k_idx := by omega
        rw [hsub]
      · apply AddCommGrpCat.ext; intro x; apply ULift.ext
        exact RingHom.congr_fun (Subsingleton.elim
          ((ZMod.castHom (pow_dvd_pow ℓ h₁) (ZMod (ℓ ^ k_idx))).comp
            (ZMod.castHom (pow_dvd_pow ℓ h₂) (ZMod (ℓ ^ m_idx))))
          (ZMod.castHom (pow_dvd_pow ℓ (le_trans h₁ h₂)) (ZMod (ℓ ^ k_idx)))) x.down
    have hMixed_A : ∀ (m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
        (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
        m₁ + d = n₁ → m₂ + d = n₂ →
        CategoryTheory.CategoryStruct.comp (inc m₁ n₁ h₁) (red n₂ n₁ hn) =
          CategoryTheory.CategoryStruct.comp (red m₂ m₁ hm) (inc m₂ n₂ h₂) := by
      intro m₁ n₁ m₂ n₂ d h₁ h₂ hm hn hd₁ hd₂
      apply AddCommGrpCat.ext; intro x; apply ULift.ext
      have hsub₁ : n₁ - m₁ = d := by omega
      have hsub₂ : n₂ - m₂ = d := by omega
      change ZMod.castHom (pow_dvd_pow ℓ hn) (ZMod (ℓ ^ n₂))
        ((x.down.val * ℓ ^ (n₁ - m₁) : ℕ) : ZMod (ℓ ^ n₁)) =
        (((ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m₂)) x.down).val *
          ℓ ^ (n₂ - m₂) : ℕ) : ZMod (ℓ ^ n₂))
      rw [hsub₁, hsub₂, map_natCast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
      have hdiv : x.down.val = ℓ ^ m₂ * (x.down.val / ℓ ^ m₂) + x.down.val % ℓ ^ m₂ :=
        (Nat.div_add_mod x.down.val (ℓ ^ m₂)).symm
      conv_lhs => rw [hdiv]
      have hmul : (ℓ ^ m₂ * (x.down.val / ℓ ^ m₂) + x.down.val % ℓ ^ m₂) * ℓ ^ d =
          ℓ ^ n₂ * (x.down.val / ℓ ^ m₂) + (x.down.val % ℓ ^ m₂) * ℓ ^ d := by
        rw [Nat.add_mul, mul_right_comm, ← pow_add, hd₂]
      rw [hmul, Nat.cast_add, Nat.cast_mul (ℓ ^ n₂), ZMod.natCast_self, zero_mul, zero_add]
    have hMul_A : ∀ (m_idx n d : ℕ) (h : m_idx ≤ n), m_idx + d = n →
