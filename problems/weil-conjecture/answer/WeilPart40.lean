            ((hθ₂_nat v₀ g).trans (congrArg (θ₂ V₀) ha))).trans
          (hConst_eval V₀ a))
    have hrhs : ((pf_h.obj C₁).obj.map (Opposite.op v₀)).hom
        (θ₁ (B_h.obj U) (g.comap (CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget S₂).obj U).hom h).base.hom)) =
        θ₁ (B_h.obj V₀) (LocallyConstant.const _ a) := by
      change (C₁.obj.map (Opposite.op (B_h.map v₀))).hom _ = _
      rw [hθ₁_nat (B_h.map v₀)]
      congr 1
      ext y
      have hfst : ((AlgebraicGeometry.Scheme.Etale.forget S₁).map (B_h.map v₀)).left ≫
          CategoryTheory.Limits.pullback.fst U.hom h =
          CategoryTheory.Limits.pullback.fst V₀.hom h ≫
            ((AlgebraicGeometry.Scheme.Etale.forget S₂).map v₀).left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hpt : (CategoryTheory.Limits.pullback.fst U.hom h).base
          (((AlgebraicGeometry.Scheme.Etale.forget S₁).map (B_h.map v₀)).left.base y) =
          (((AlgebraicGeometry.Scheme.Etale.forget S₂).map v₀).left).base
            ((CategoryTheory.Limits.pullback.fst V₀.hom h).base y) :=
        congrArg (fun m : (B_h.obj V₀).left ⟶ U.left => m.base y) hfst
      change g ((CategoryTheory.Limits.pullback.fst U.hom h).base
          (((AlgebraicGeometry.Scheme.Etale.forget S₁).map (B_h.map v₀)).left.base y)) = a
      rw [hpt]
      exact congrArg (fun f : LocallyConstant _ ↥M => f
        ((CategoryTheory.Limits.pullback.fst V₀.hom h).base y)) ha
    exact hlhs.trans hrhs.symm

  
  
  
  
  let AM : ℕ → AddCommGrpCat.{u} := fun k =>
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod k))
  let lcIsoEquiv : ∀ {A₁ A₂ : AlgebraicGeometry.Scheme.{u} } {M₀ : AddCommGrpCat.{u} },
      (A₁ ≅ A₂) → (LocallyConstant ↥A₂ ↥M₀ ≃ LocallyConstant ↥A₁ ↥M₀) :=
    fun {A₁ A₂ M₀} e =>
      { toFun := fun g => g.comap e.hom.base.hom
        invFun := fun g => g.comap e.inv.base.hom
        left_inv := fun g => by
          ext x
          change g ((e.inv ≫ e.hom).base x) = g x
          rw [e.inv_hom_id]; rfl
        right_inv := fun g => by
          ext x
          change g ((e.hom ≫ e.inv).base x) = g x
          rw [e.hom_inv_id]; rfl }

  have hDegZeroComapIff : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h' : Z₁ ⟶ Z₂)
      (N_m : ℕ) (p₀ : weilEtaleTorsionH Z₂ N_m 0 →+ weilEtaleTorsionH Z₁ N_m 0),
      WeilIsTorsionEtalePullback h' N_m 0 p₀ →
      (Function.Bijective p₀ ↔
        Function.Bijective (fun g : LocallyConstant ↥Z₂ ↥(AM N_m) => g.comap h'.base.hom)) := by
    intro Z₁ Z₂ h' N_m p₀ hp₀
    let M_m := AM N_m
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    rcases hp₀ with ⟨hc', hr', hAdd', hLim', hColim', T₁, hT₁, T₂, hT₂, ιℤ, _, hπι, hp_eq⟩
    have := hc'; have := hr'; have := hAdd'; have := hLim'; have := hColim'
    let B_h' := weilEtaleSitePullback h'
    let pf_h' := B_h'.sheafPushforwardContinuous
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let pb_h' := B_h'.sheafPullback
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let adj_pull := B_h'.sheafAdjunctionContinuous
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let F_Z₂ := weilEtaleTorsionSheaf Z₂ N_m
    let F_Z₁ := weilEtaleTorsionSheaf Z₁ N_m
    let Fℤ_Z₂ := (CategoryTheory.constantSheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_Z₁ := (CategoryTheory.constantSheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let adj₁ := CategoryTheory.constantSheafAdj Z₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj Z₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
    let τ₁₂ := hT₁.from (B_h'.obj T₂)
    let α'_ℤ : Fℤ_Z₂ ⟶ pf_h'.obj Fℤ_Z₁ :=
      (adj₂.homEquiv Aℤ (pf_h'.obj Fℤ_Z₁)).symm
        (adj₁.unit.app Aℤ ≫ Fℤ_Z₁.obj.map (Opposite.op τ₁₂))
    let β_h' : F_Z₂ ⟶ pf_h'.obj F_Z₁ :=
      (adj₂.homEquiv M_m (pf_h'.obj F_Z₁)).symm
        (adj₁.unit.app M_m ≫ F_Z₁.obj.map (Opposite.op τ₁₂))
    let πℤ : pb_h'.obj Fℤ_Z₂ ⟶ Fℤ_Z₁ := (adj_pull.homEquiv Fℤ_Z₂ Fℤ_Z₁).symm α'_ℤ
    let πM : pb_h'.obj F_Z₂ ⟶ F_Z₁ := (adj_pull.homEquiv F_Z₂ F_Z₁).symm β_h'
    let evZ : ∀ (G : AddCommGrpCat.{u}), (Aℤ ⟶ G) ≃ ↥G := fun G =>
      { toFun := fun u => u.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
        left_inv := fun u => by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change z • u.hom (ULift.up (1 : ℤ)) = u.hom (ULift.up z)
          have hz : z • (ULift.up (1 : ℤ) : ↥Aℤ) = ULift.up z :=
            ULift.ext _ _ (by change z • (1 : ℤ) = z; simp)
          rw [← map_zsmul u.hom z (ULift.up (1 : ℤ)), hz]
        right_inv := fun m => one_zsmul m }
    let termEt : ∀ S : AlgebraicGeometry.Scheme.{u}, S.Etale :=
      fun S => AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
    have hT_BT₀ : CategoryTheory.Limits.IsTerminal (B_h'.obj (termEt Z₂)) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (U₀.hom ≫ h') U₀.hom (Category.comp_id _))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial)
        (fun U₀ m => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (Category.comp_id
                (m.left ≫ CategoryTheory.Limits.pullback.fst (termEt Z₂).hom h')).symm.trans
              ((Category.assoc m.left
                  (CategoryTheory.Limits.pullback.fst (termEt Z₂).hom h') (𝟙 Z₂)).trans
                ((congrArg (m.left ≫ ·)
                    (CategoryTheory.Limits.pullback.condition (f := (termEt Z₂).hom) (g := h'))).trans
                  ((Category.assoc m.left
                      (CategoryTheory.Limits.pullback.snd (termEt Z₂).hom h') h').symm.trans
                    ((congrArg (· ≫ h') (CategoryTheory.MorphismProperty.Over.w m)).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
          · exact (CategoryTheory.MorphismProperty.Over.w m).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    let e_τ : B_h'.obj T₂ ≅ T₁ :=
      B_h'.mapIso (hT₂.uniqueUpToIso (hTermOf Z₂)) ≪≫ hT_BT₀.uniqueUpToIso hT₁
    have he_τ_hom : e_τ.hom = τ₁₂ := hT₁.hom_ext e_τ.hom τ₁₂
    let M_T₁ := F_Z₁.obj.obj (Opposite.op T₁)
    let M_BT₂ := F_Z₁.obj.obj (Opposite.op (B_h'.obj T₂))
    let map_τ_equiv : ↥M_T₁ ≃ ↥M_BT₂ :=
      { toFun := fun x => (F_Z₁.obj.map (Opposite.op e_τ.hom)).hom x
        invFun := fun y => (F_Z₁.obj.map (Opposite.op e_τ.inv)).hom y
        left_inv := fun x => by
          have h1 : F_Z₁.obj.map (Opposite.op e_τ.hom) ≫ F_Z₁.obj.map (Opposite.op e_τ.inv) = 𝟙 M_T₁ := by
            rw [← F_Z₁.obj.map_comp]
            change F_Z₁.obj.map (Opposite.op (e_τ.inv ≫ e_τ.hom)) = 𝟙 M_T₁
            rw [e_τ.inv_hom_id]; exact F_Z₁.obj.map_id (Opposite.op T₁)
          exact congrArg (fun k : M_T₁ ⟶ M_T₁ => k.hom x) h1
        right_inv := fun y => by
          have h1 : F_Z₁.obj.map (Opposite.op e_τ.inv) ≫ F_Z₁.obj.map (Opposite.op e_τ.hom) = 𝟙 M_BT₂ := by
            rw [← F_Z₁.obj.map_comp]
            change F_Z₁.obj.map (Opposite.op (e_τ.hom ≫ e_τ.inv)) = 𝟙 M_BT₂
            rw [e_τ.hom_inv_id]; exact F_Z₁.obj.map_id (Opposite.op (B_h'.obj T₂))
          exact congrArg (fun k : M_BT₂ ⟶ M_BT₂ => k.hom y) h1 }
    let e_ext_Z₂ : weilEtaleTorsionH Z₂ N_m 0 ≃ (Fℤ_Z₂ ⟶ F_Z₂) :=
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv
    let e_ext_Z₁ : weilEtaleTorsionH Z₁ N_m 0 ≃ (Fℤ_Z₁ ⟶ F_Z₁) :=
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv
    let e₁ : weilEtaleTorsionH Z₂ N_m 0 ≃ ↥(F_Z₂.obj.obj (Opposite.op T₂)) :=
      (e_ext_Z₂.trans (adj₂.homEquiv Aℤ F_Z₂)).trans (evZ _)
    let e₂ : weilEtaleTorsionH Z₁ N_m 0 ≃ ↥((pf_h'.obj F_Z₁).obj.obj (Opposite.op T₂)) :=
      ((e_ext_Z₁.trans (adj₁.homEquiv Aℤ F_Z₁)).trans (evZ M_T₁)).trans map_τ_equiv
    have hp_conj : ∀ x : weilEtaleTorsionH Z₂ N_m 0,
        e₂ (p₀ x) = (β_h'.hom.app (Opposite.op T₂)).hom (e₁ x) := by
      intro x
      let f_x : Fℤ_Z₂ ⟶ F_Z₂ := e_ext_Z₂ x
      have hx_mk : x = CategoryTheory.Abelian.Ext.mk₀ f_x :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
      let g_y : Fℤ_Z₁ ⟶ F_Z₁ := ιℤ ≫ pb_h'.map f_x ≫ πM
      have hp_hom : e_ext_Z₁ (p₀ x) = g_y := by
        change CategoryTheory.Abelian.Ext.addEquiv₀ (p₀ x) = g_y
        rw [hp_eq x, hx_mk]
        change CategoryTheory.Abelian.Ext.addEquiv₀
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((pb_h'.mapExtAddHom Fℤ_Z₂ F_Z₂ 0) (CategoryTheory.Abelian.Ext.mk₀ f_x))
            (Nat.zero_add 0)).comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = _
        rw [CategoryTheory.Functor.mapExtAddHom_apply pb_h' Fℤ_Z₂ F_Z₂ 0,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          AddEquiv.apply_symm_apply, Category.assoc]
      have hπg : πℤ ≫ g_y = pb_h'.map f_x ≫ πM :=
        (Category.assoc πℤ ιℤ (pb_h'.map f_x ≫ πM)).symm.trans
          ((congrArg (· ≫ (pb_h'.map f_x ≫ πM)) hπι).trans (Category.id_comp _))
      have hmate₁ : α'_ℤ ≫ pf_h'.map g_y = f_x ≫ β_h' := by
        have hl' : (adj_pull.homEquiv Fℤ_Z₂ F_Z₁) (πℤ ≫ g_y) = α'_ℤ ≫ pf_h'.map g_y :=
          (adj_pull.homEquiv_naturality_right πℤ g_y).trans
            (congrArg (· ≫ pf_h'.map g_y) ((adj_pull.homEquiv Fℤ_Z₂ Fℤ_Z₁).apply_symm_apply α'_ℤ))
        have hr : (adj_pull.homEquiv Fℤ_Z₂ F_Z₁) (pb_h'.map f_x ≫ πM) = f_x ≫ β_h' :=
          (adj_pull.homEquiv_naturality_left f_x πM).trans
            (congrArg (f_x ≫ ·) ((adj_pull.homEquiv F_Z₂ F_Z₁).apply_symm_apply β_h'))
        exact hl'.symm.trans ((congrArg (adj_pull.homEquiv Fℤ_Z₂ F_Z₁) hπg).trans hr)
      have hmate₂ : ((adj₁.homEquiv Aℤ F_Z₁) g_y) ≫ F_Z₁.obj.map (Opposite.op τ₁₂) =
          ((adj₂.homEquiv Aℤ F_Z₂) f_x) ≫ β_h'.hom.app (Opposite.op T₂) := by
        have hl : (adj₂.homEquiv Aℤ (pf_h'.obj F_Z₁)) (α'_ℤ ≫ pf_h'.map g_y) =
            ((adj₁.homEquiv Aℤ F_Z₁) g_y) ≫ F_Z₁.obj.map (Opposite.op τ₁₂) :=
          (adj₂.homEquiv_naturality_right α'_ℤ (pf_h'.map g_y)).trans
            ((congrArg (· ≫ g_y.hom.app (Opposite.op (B_h'.obj T₂)))
                ((adj₂.homEquiv Aℤ (pf_h'.obj Fℤ_Z₁)).apply_symm_apply _)).trans
              ((Category.assoc _ _ _).trans
                ((congrArg (adj₁.unit.app Aℤ ≫ ·) (g_y.hom.naturality (Opposite.op τ₁₂))).trans
                  (Category.assoc _ _ _).symm)))
        have hr : (adj₂.homEquiv Aℤ (pf_h'.obj F_Z₁)) (f_x ≫ β_h') =
            ((adj₂.homEquiv Aℤ F_Z₂) f_x) ≫ β_h'.hom.app (Opposite.op T₂) :=
          adj₂.homEquiv_naturality_right f_x β_h'
        exact hl.symm.trans ((congrArg (adj₂.homEquiv Aℤ (pf_h'.obj F_Z₁)) hmate₁).trans hr)
      have h1 : e₂ (p₀ x) =
          (F_Z₁.obj.map (Opposite.op τ₁₂)).hom (((adj₁.homEquiv Aℤ F_Z₁) g_y).hom (ULift.up (1 : ℤ))) :=
        (congrArg (fun k : B_h'.obj T₂ ⟶ T₁ =>
            (F_Z₁.obj.map (Opposite.op k)).hom
              (((adj₁.homEquiv Aℤ F_Z₁) (e_ext_Z₁ (p₀ x))).hom (ULift.up (1 : ℤ))))
          he_τ_hom).trans
          (congrArg (fun m : Fℤ_Z₁ ⟶ F_Z₁ =>
              (F_Z₁.obj.map (Opposite.op τ₁₂)).hom (((adj₁.homEquiv Aℤ F_Z₁) m).hom (ULift.up (1 : ℤ))))
            hp_hom)
      exact h1.trans (congrArg (fun m : Aℤ ⟶ M_BT₂ => m.hom (ULift.up (1 : ℤ))) hmate₂)
    obtain ⟨θ_Z₁, θ_Z₂, hθ₁_bij, hθ₂_bij, hEval_h'⟩ := hClopenEval h' hT₁ hT₂ M_m
    let e_T2_term : T₂ ≅ termEt Z₂ := hT₂.uniqueUpToIso (hTermOf Z₂)
    let iso_T2_left : T₂.left ≅ Z₂ :=
      { hom := T₂.hom
        inv := e_T2_term.inv.left
        hom_inv_id := by
          have hw : e_T2_term.hom.left = T₂.hom :=
            (Category.comp_id e_T2_term.hom.left).symm.trans
              (CategoryTheory.MorphismProperty.Over.w e_T2_term.hom)
          rw [← hw]
          exact congrArg (fun k => k.left) e_T2_term.hom_inv_id
        inv_hom_id := by
          have hw : e_T2_term.hom.left = T₂.hom :=
            (Category.comp_id e_T2_term.hom.left).symm.trans
              (CategoryTheory.MorphismProperty.Over.w e_T2_term.hom)
          rw [← hw]
          exact congrArg (fun k => k.left) e_T2_term.inv_hom_id }
    have : CategoryTheory.IsIso T₂.hom := iso_T2_left.isIso_hom
    let snd_T2 : (B_h'.obj T₂).left ⟶ Z₁ := CategoryTheory.Limits.pullback.snd T₂.hom h'
    have hIso_snd_T2 : CategoryTheory.IsIso snd_T2 :=
      (inferInstance : CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd T₂.hom h'))
    let iso_BT2_left : (B_h'.obj T₂).left ≅ Z₁ :=
      @CategoryTheory.asIso _ _ (B_h'.obj T₂).left Z₁ snd_T2 hIso_snd_T2
    let eqv_dom := lcIsoEquiv (M₀ := M_m) iso_T2_left
    let eqv_cod := lcIsoEquiv (M₀ := M_m) iso_BT2_left
    let eqv_Z₂ := Equiv.ofBijective (θ_Z₂ T₂) (hθ₂_bij T₂)
    let eqv_Z₁ := Equiv.ofBijective (θ_Z₁ (B_h'.obj T₂)) (hθ₁_bij (B_h'.obj T₂))
    let E_dom : LocallyConstant ↥Z₂ ↥M_m ≃ weilEtaleTorsionH Z₂ N_m 0 :=
      (eqv_dom.trans eqv_Z₂).trans e₁.symm
    let E_cod : LocallyConstant ↥Z₁ ↥M_m ≃ weilEtaleTorsionH Z₁ N_m 0 :=
      (eqv_cod.trans eqv_Z₁).trans e₂.symm
    let comap_base : LocallyConstant ↥Z₂ ↥M_m → LocallyConstant ↥Z₁ ↥M_m :=
      fun g => g.comap h'.base.hom
    let F_T2 : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Z₂).obj T₂).left ↥M_m →
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Z₁).obj (B_h'.obj T₂)).left ↥M_m :=
      fun g => g.comap (CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget Z₂).obj T₂).hom h').base.hom
    have hsq : ∀ g : LocallyConstant ↥Z₂ ↥M_m, F_T2 (eqv_dom g) = eqv_cod (comap_base g) := by
      intro g
      ext z
      have hcond := congrArg (fun m : (B_h'.obj T₂).left ⟶ Z₂ => m.base z)
        (CategoryTheory.Limits.pullback.condition (f := T₂.hom) (g := h'))
      change g ((CategoryTheory.Limits.pullback.fst T₂.hom h' ≫ T₂.hom).base z) =
        g ((CategoryTheory.Limits.pullback.snd T₂.hom h' ≫ h').base z)
      exact congrArg g hcond
    have hE_rel : ∀ g : LocallyConstant ↥Z₂ ↥M_m,
        p₀ (E_dom g) = E_cod (comap_base g) := by
      intro g
      apply e₂.injective
      have hL : e₂ (p₀ (E_dom g)) = eqv_Z₁ (eqv_cod (comap_base g)) :=
        (hp_conj (E_dom g)).trans
          ((congrArg (β_h'.hom.app (Opposite.op T₂)).hom (e₁.apply_symm_apply _)).trans
            ((hEval_h' T₂ (eqv_dom g)).trans (congrArg eqv_Z₁ (hsq g))))
      exact hL.trans (e₂.apply_symm_apply _).symm
    have hfun_p₀ : (⇑p₀ : weilEtaleTorsionH Z₂ N_m 0 → weilEtaleTorsionH Z₁ N_m 0) =
        ⇑E_cod ∘ comap_base ∘ ⇑E_dom.symm :=
      funext fun x =>
        (congrArg p₀ (E_dom.apply_symm_apply x).symm).trans (hE_rel (E_dom.symm x))
    have hfun_cb : comap_base = ⇑E_cod.symm ∘ ⇑p₀ ∘ ⇑E_dom :=
      funext fun g =>
        E_cod.injective ((hE_rel g).symm.trans (E_cod.apply_symm_apply (p₀ (E_dom g))).symm)
    exact ⟨fun hBij => Eq.mp (congrArg Function.Bijective hfun_cb.symm)
        (E_cod.symm.bijective.comp (hBij.comp E_dom.bijective)),
      fun hBij => Eq.mp (congrArg Function.Bijective hfun_p₀.symm)
        (E_cod.bijective.comp (hBij.comp E_dom.symm.bijective))⟩

  
  
  
  let B_j := weilEtaleSitePullback j
