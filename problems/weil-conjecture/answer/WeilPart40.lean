        · exact (hSnd3 _).trans (hSnd3 _).symm
      · exact (hSnd2 _).trans (hSnd2 _).symm
    · exact (hSnd1 _).trans (hSnd1 _).symm

  
  have hExtIntertwine : ∀ {C₀ C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C₀] [CategoryTheory.Abelian C₀]
      [CategoryTheory.HasExt.{u} C₀] [CategoryTheory.EnoughInjectives C₀]
      [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
      [CategoryTheory.HasExt.{u} C₁]
      [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
      [CategoryTheory.HasExt.{u} C₂]
      (F : CategoryTheory.Functor C₀ C₁)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (G : CategoryTheory.Functor C₁ C₂)
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (H : CategoryTheory.Functor C₀ C₂)
      [H.Additive] [CategoryTheory.Limits.PreservesFiniteLimits H]
      [CategoryTheory.Limits.PreservesFiniteColimits H]
      (η : H ⟶ CategoryTheory.Functor.comp F G)
      (q₀ : ℕ) (A B : C₀) (x : CategoryTheory.Abelian.Ext.{u} A B q₀),
      ((H.mapExtAddHom A B q₀) x).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app B)) (Nat.add_zero q₀) =
        (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app A)).comp
          ((G.mapExtAddHom (F.obj A) (F.obj B) q₀) ((F.mapExtAddHom A B q₀) x))
          (Nat.zero_add q₀) := by
    intro C₀ C₁ C₂ _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ H _ _ _ η q₀
    induction q₀ with
    | zero =>
      intro A B x
      let u : A ⟶ B := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hu : CategoryTheory.Abelian.Ext.mk₀.{u} u = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      rw [← hu,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀.{u} (η.naturality u)
    | succ k ih =>
      intro A B x
      let I : C₀ := CategoryTheory.Injective.under B
      let ι : B ⟶ I := CategoryTheory.Injective.ι B
      let Q : C₀ := CategoryTheory.Limits.cokernel ι
      let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S₀ : CategoryTheory.ShortComplex C₀ :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hEx₀ : S₀.Exact :=
        CategoryTheory.ShortComplex.exact_of_g_is_cokernel S₀ (CategoryTheory.Limits.cokernelIsCokernel ι)
      have hSE₀ : S₀.ShortExact := CategoryTheory.ShortComplex.ShortExact.mk' hEx₀ inferInstance inferInstance
      have hxI : x.comp (CategoryTheory.Abelian.Ext.mk₀.{u} S₀.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hSE₀ x hxI rfl
      rw [← hy]
      have hFG_add : (CategoryTheory.Functor.comp F G).Additive := inferInstance
      have hFG_lim : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Functor.comp F G) :=
        CategoryTheory.Limits.comp_preservesFiniteLimits F G
      have hFG_colim : CategoryTheory.Limits.PreservesFiniteColimits (CategoryTheory.Functor.comp F G) :=
        CategoryTheory.Limits.comp_preservesFiniteColimits F G
      have hSE_H : (S₀.map H).ShortExact := hSE₀.map_of_exact H
      have hSE_FG : (S₀.map (CategoryTheory.Functor.comp F G)).ShortExact :=
        hSE₀.map_of_exact (CategoryTheory.Functor.comp F G)
      have hNatExt :
          hSE_H.extClass.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app B)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app Q)).comp hSE_FG.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_H hSE_FG (S₀.mapNatTrans η)
      have hLHS :
          ((H.mapExtAddHom A B (k + 1)) (y.comp hSE₀.extClass rfl)).comp
              (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app B)) (Nat.add_zero (k + 1)) =
            ((CategoryTheory.Abelian.Ext.mk₀.{u} (η.app A)).comp
              ((G.mapExtAddHom (F.obj A) (F.obj Q) k) ((F.mapExtAddHom A Q k) y))
              (Nat.zero_add k)).comp hSE_FG.extClass rfl := by
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ← CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
          hNatExt,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _,
          ih A Q y]
      have hRHS :
          (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app A)).comp
              ((G.mapExtAddHom (F.obj A) (F.obj B) (k + 1))
                ((F.mapExtAddHom A B (k + 1)) (y.comp hSE₀.extClass rfl)))
              (Nat.zero_add (k + 1)) =
            ((CategoryTheory.Abelian.Ext.mk₀.{u} (η.app A)).comp
              ((G.mapExtAddHom (F.obj A) (F.obj Q) k) ((F.mapExtAddHom A Q k) y))
              (Nat.zero_add k)).comp hSE_FG.extClass rfl := by
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ← CategoryTheory.Functor.mapExtAddHom_apply,
          ← CategoryTheory.Functor.mapExtAddHom_apply]
        have hExtEq : ((hSE₀.map_of_exact F).map_of_exact G).extClass = hSE_FG.extClass := rfl
        rw [hExtEq]
        exact (CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀.{u} (η.app A))
          ((G.mapExtAddHom (F.obj A) (F.obj Q) k) ((F.mapExtAddHom A Q k) y))
          hSE_FG.extClass
          (Nat.zero_add k) rfl (Nat.zero_add (k + 1))).symm
      exact hLHS.trans hRHS.symm

  
