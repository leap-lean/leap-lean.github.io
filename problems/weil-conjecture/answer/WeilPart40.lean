    (Y_inf : AlgebraicGeometry.Scheme.{u})
    (f_infY : Y_inf ⟶ AlgebraicGeometry.Spec c.pt)
    (π_inf : Y_inf ⟶ Y₀)
    (hpb_inf : CategoryTheory.IsPullback f_infY π_inf (AlgebraicGeometry.Spec.map f_inf) f₀)
