          LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y).left ↥A →+
            ↑(C_V.obj.obj (Opposite.op Y))),
        (∀ Y : V.Etale, Function.Bijective (θ_V Y)) ∧
        (∀ {Y₁ Y₂ : V.Etale} (f : Y₁ ⟶ Y₂)
          (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y₂).left ↥A),
          (C_V.obj.map (Opposite.op f)).hom (θ_V Y₂ g) =
            θ_V Y₁ (g.comap ((AlgebraicGeometry.Scheme.Etale.forget V).map f).left.base.hom)) ∧
        (∀ a : ↥A,
          θ_V T_V (LocallyConstant.const _ a) =
            ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
              hT_V).unit.app A).hom a) := by
    intro V A
    let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    have hT_V : CategoryTheory.Limits.IsTerminal T_V := hTermOf V
    let P_A : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of
          (LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj E.unop).left ↥A)
        map := fun f => AddCommGrpCat.ofHom
          (LocallyConstant.comapAddMonoidHom
            (((AlgebraicGeometry.Scheme.Etale.forget V).map f.unop).left.base.hom))
        map_id := fun E => by
