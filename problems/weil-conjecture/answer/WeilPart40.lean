      | zero =>
        intro b hb
        simpa only [Nat.zero_add, pow_one] using hVanMod b hb
      | succ n ih =>
        intro b hb
        obtain ⟨u₀, v₀, huv, hSE₀⟩ := hZModSE n
        let SC₀ := CategoryTheory.ShortComplex.mk u₀ v₀ huv
        let UL := AddCommGrpCat.uliftFunctor.{u, 0}
        let C_U := CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}
