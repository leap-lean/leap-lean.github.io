            ((if hk_lt : k.1 < j.1 then
                MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) +
              (if k = j then MvPolynomial.X i_star else 0) +
              (if hk_gt : j.1 < k.1 then
                MvPolynomial.X (iu_gt k hk_gt) * MvPolynomial.X (iv_gt k hk_gt) else 0))
          · refine Finset.sum_congr rfl fun k _ => ?_
            rw [map_mul, h_term_pull k]
          · rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
            simp [Finset.sum_ite_eq']
