            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ e_I.hom e_I.inv]
            exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero w
              (CategoryTheory.Abelian.Ext.mk₀ e_I.hom)
              (CategoryTheory.Abelian.Ext.mk₀ e_I.inv) (Nat.add_zero m)).symm
        _ = 0 := by rw [hw', CategoryTheory.Abelian.Ext.zero_comp]
    exact Subsingleton.intro fun w₁ w₂ => (hw_zero w₁).trans (hw_zero w₂).symm
  
  let pb_i := @CategoryTheory.Functor.sheafPullback _ _ _ _
    (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
    X.smallEtaleTopology S_k.smallEtaleTopology hCont_i hAdj_i
  let adj_i := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
    X.smallEtaleTopology S_k.smallEtaleTopology hCont_i hAdj_i
  have hConstPb := (weil_etale_pullback_exact_and_pseudofunctor.{u} 0).2.2.2.1 i₀ Aℤ
  rcases hConstPb with ⟨hc', hr', ⟨iso'⟩⟩
  have hhc_eq : hCont_i = hc' := Subsingleton.elim _ _
  subst hhc_eq
  let adj_i' := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
    X.smallEtaleTopology S_k.smallEtaleTopology hCont_i hr'
  let α_pb := adj_i.leftAdjointUniq adj_i'
  let eℤ : pb_i.obj Fℤ_X ≅ Fℤ_k := α_pb.app Fℤ_X ≪≫ iso'
  let Φ₀ : ∀ E : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u},
      (pf_i.obj E).H 0 ≃ E.H 0 := fun E =>
    CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
      (((adj_i.homEquiv Fℤ_X E).symm).trans
        (({ toFun := fun h => eℤ.inv ≫ h
            invFun := fun k_hom => eℤ.hom ≫ k_hom
            left_inv := fun h => by
              dsimp only []
              rw [← CategoryTheory.Category.assoc, eℤ.hom_inv_id,
                CategoryTheory.Category.id_comp]
            right_inv := fun k_hom => by
              dsimp only []
              rw [← CategoryTheory.Category.assoc, eℤ.inv_hom_id,
                CategoryTheory.Category.id_comp] } :
          (pb_i.obj Fℤ_X ⟶ E) ≃ (Fℤ_k ⟶ E)).trans
          CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.symm))
  have hmk_X : ∀ {A B : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (g : A ⟶ B),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
    intro A B g
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply g
  have hΦ₀_nat : ∀ {E₁ E₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
      (v : E₁ ⟶ E₂) (z : (pf_i.obj E₁).H 0),
      Φ₀ E₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_i.map v)) (Nat.add_zero 0)) =
        (Φ₀ E₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ v) (Nat.add_zero 0) := by
    intro E₁ E₂ v z
    let g : Fℤ_X ⟶ pf_i.obj E₁ := CategoryTheory.Abelian.Ext.addEquiv₀ z
    have hz : z = CategoryTheory.Abelian.Ext.mk₀ g := by
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      exact (CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply z).symm
    rw [hz]
    change CategoryTheory.Abelian.Ext.addEquiv₀.symm
        (eℤ.inv ≫ (adj_i.homEquiv Fℤ_X E₂).symm
          (CategoryTheory.Abelian.Ext.addEquiv₀
            ((CategoryTheory.Abelian.Ext.mk₀ g).comp
              (CategoryTheory.Abelian.Ext.mk₀ (pf_i.map v)) (Nat.add_zero 0)))) =
      (CategoryTheory.Abelian.Ext.addEquiv₀.symm
        (eℤ.inv ≫ (adj_i.homEquiv Fℤ_X E₁).symm
          (CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀ g)))).comp
        (CategoryTheory.Abelian.Ext.mk₀ v) (Nat.add_zero 0)
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hmk_X, hmk_X,
      CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    congr 1
    have h1 : (adj_i.homEquiv Fℤ_X E₂).symm (g ≫ pf_i.map v) =
        pb_i.map g ≫ (pb_i.map (pf_i.map v) ≫ adj_i.counit.app E₂) := by
      rw [CategoryTheory.Adjunction.homEquiv_counit, pb_i.map_comp,
        CategoryTheory.Category.assoc]
    have h2 : pb_i.map (pf_i.map v) ≫ adj_i.counit.app E₂ = adj_i.counit.app E₁ ≫ v :=
      adj_i.counit.naturality v
    have h3 : (adj_i.homEquiv Fℤ_X E₁).symm g = pb_i.map g ≫ adj_i.counit.app E₁ := by
      rw [CategoryTheory.Adjunction.homEquiv_counit]
    calc eℤ.inv ≫ (adj_i.homEquiv Fℤ_X E₂).symm (g ≫ pf_i.map v)
        = eℤ.inv ≫ (pb_i.map g ≫ (pb_i.map (pf_i.map v) ≫ adj_i.counit.app E₂)) :=
          congrArg (eℤ.inv ≫ ·) h1
      _ = eℤ.inv ≫ (pb_i.map g ≫ (adj_i.counit.app E₁ ≫ v)) :=
          congrArg (fun t => eℤ.inv ≫ (pb_i.map g ≫ t)) h2
      _ = (eℤ.inv ≫ (pb_i.map g ≫ adj_i.counit.app E₁)) ≫ v := by
          simp only [CategoryTheory.Category.assoc]
      _ = (eℤ.inv ≫ (adj_i.homEquiv Fℤ_X E₁).symm g) ≫ v :=
          congrArg (fun t => (eℤ.inv ≫ t) ≫ v) h3.symm
  
  have hMain : ∀ (d : ℕ)
      (G₀ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G₀ = 0 →
      Subsingleton ((pf_i.obj G₀).H (d + 1)) := by
    intro d
    induction d with
    | zero =>
      intro G₀ hG₀
      obtain ⟨I, hInjI, Q, u, v, huv, _, hSC⟩ :=
        (weil_etale_site_pullback_exact_and_mod_prime_resolution ℓ).2.2.2.1 S_k G₀ hG₀
      letI : CategoryTheory.Injective I := hInjI
      let M := (U_sh S_k).obj I
      let SC := CategoryTheory.ShortComplex.mk u v huv
      have hSC_X : (SC.map pf_i).ShortExact := hExact_mod SC hSC hG₀
      have hSubM1 : Subsingleton ((pf_i.obj M).H 1) := hInjVan I 1 le_rfl
      have hSubG1 : Subsingleton (G₀.H 1) := hBaseH1 G₀
      have h_zero : ∀ x : (pf_i.obj G₀).H 1, x = 0 := by
        intro x
        have hx_u : x.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).f)
            (Nat.add_zero 1) = 0 :=
          @Subsingleton.elim ((pf_i.obj M).H 1) hSubM1 _ _
        obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          Fℤ_X hSC_X x hx_u (Nat.zero_add 1)
        let y₀ : Q.H 0 := Φ₀ Q y
        have hy₀_ext : y₀.comp hSC.extClass (Nat.zero_add 1) = 0 :=
          @Subsingleton.elim (G₀.H 1) hSubG1 _ _
        obtain ⟨w₀, hw₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
          Fℤ_k hSC y₀ (Nat.zero_add 1) hy₀_ext
        let z : (pf_i.obj M).H 0 := (Φ₀ M).symm w₀
        have hz_v : z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).g)
            (Nat.add_zero 0) = y := by
          apply (Φ₀ Q).injective
          have hstep1 : Φ₀ Q (z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).g)
              (Nat.add_zero 0)) =
              (Φ₀ M z).comp (CategoryTheory.Abelian.Ext.mk₀ (v : M ⟶ Q)) (Nat.add_zero 0) :=
            hΦ₀_nat (v : M ⟶ Q) z
          have hstep2 : Φ₀ M z = w₀ := (Φ₀ M).apply_symm_apply w₀
          exact hstep1.trans
            ((congrArg (fun t : M.H 0 =>
              t.comp (CategoryTheory.Abelian.Ext.mk₀ (v : M ⟶ Q)) (Nat.add_zero 0)) hstep2).trans
              hw₀)
        calc x = y.comp hSC_X.extClass (Nat.zero_add 1) := hy.symm
          _ = (z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).g)
                (Nat.add_zero 0)).comp hSC_X.extClass (Nat.zero_add 1) := by
              rw [hz_v]
          _ = z.comp ((CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).g).comp
                hSC_X.extClass (Nat.zero_add 1)) (Nat.zero_add 1) :=
              CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero z
                (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).g)
                hSC_X.extClass (Nat.zero_add 1)
          _ = 0 := by
              rw [hSC_X.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      exact Subsingleton.intro fun x₁ x₂ => (h_zero x₁).trans (h_zero x₂).symm
    | succ d ih =>
      intro G₀ hG₀
      obtain ⟨I, hInjI, Q, u, v, huv, hQ_tor, hSC⟩ :=
        (weil_etale_site_pullback_exact_and_mod_prime_resolution ℓ).2.2.2.1 S_k G₀ hG₀
      letI : CategoryTheory.Injective I := hInjI
      let M := (U_sh S_k).obj I
      let SC := CategoryTheory.ShortComplex.mk u v huv
      have hSC_X : (SC.map pf_i).ShortExact := hExact_mod SC hSC hG₀
      have hSubM : Subsingleton ((pf_i.obj M).H (d + 2)) := hInjVan I (d + 2) (by omega)
      have hSubQ : Subsingleton ((pf_i.obj Q).H (d + 1)) := ih Q hQ_tor
      have h_zero : ∀ x : (pf_i.obj G₀).H (d + 2), x = 0 := by
        intro x
        have hx_u : x.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_i).f)
            (Nat.add_zero (d + 2)) = 0 :=
          @Subsingleton.elim ((pf_i.obj M).H (d + 2)) hSubM _ _
        obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          Fℤ_X hSC_X x hx_u (rfl : (d + 1) + 1 = d + 2)
        have hy0 : y = 0 := @Subsingleton.elim ((pf_i.obj Q).H (d + 1)) hSubQ y 0
        rw [← hy, hy0, CategoryTheory.Abelian.Ext.zero_comp]
      exact Subsingleton.intro fun x₁ x₂ => (h_zero x₁).trans (h_zero x₂).symm
  have hq_eq : (q - 1) + 1 = q := Nat.sub_add_cancel hq
  exact hq_eq ▸ hMain (q - 1) G hG

theorem weil_odp_sky_const_unit_locallyConstant_intertwining {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
    (hCont_j : (weilEtaleSitePullback j).IsContinuous
      X.smallEtaleTopology X_U.smallEtaleTopology)
    (hAdj_j : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).IsRightAdjoint)
    (T_U : X_U.Etale) (hT_U : CategoryTheory.Limits.IsTerminal T_U)
    (T_X : X.Etale) (hT_X : CategoryTheory.Limits.IsTerminal T_X)
    (m_mod : ℕ) :
    let adj_j := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
    let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m_mod))
    let η_j := (adj_j.homEquiv (weilEtaleTorsionSheaf X m_mod) (weilEtaleTorsionSheaf X_U m_mod))
      (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A_m)
    (∀ Y : X.Etale,
      Function.Bijective (η_j.hom.app (Opposite.op Y)) ↔
        Function.Bijective
          (fun g : LocallyConstant
              ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj Y).left ↥A_m =>
            g.comap
              (CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget X).obj Y).hom j).base.hom)) ∧
    (∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂)
        (p : weilEtaleTorsionH Z₂ m_mod 0 →+ weilEtaleTorsionH Z₁ m_mod 0),
      WeilIsTorsionEtalePullback h m_mod 0 p →
      (Function.Bijective p ↔
        Function.Bijective (fun g : LocallyConstant ↥Z₂ ↥A_m => g.comap h.base.hom))) :=
by
  intro adj_j A_m η_j
  
  have hMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left,
          ∃ (Y : S.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left),
            R.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left.base y = x := by
    intro S W R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEqTop : S.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_rfl : P_et ≤ P_et)
    exact (iff_of_eq (congrArg (fun (J : CategoryTheory.GrothendieckTopology S.Etale) => R ∈ J W)
      hEqTop)).trans (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R)

  
  have hSh_LC : ∀ (V : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology (weilAltLocConstPresheaf V m_mod) := by
    intro V
    let FgtV := AlgebraicGeometry.Scheme.Etale.forget V
    let P := weilAltLocConstPresheaf V m_mod
    rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
    intro W R hR
    have hCov : ∀ x : ↥(FgtV.obj W).left,
        ∃ (Y : V.Etale) (f : Y ⟶ W) (y : ↥(FgtV.obj Y).left),
          R.arrows f ∧ AlgebraicGeometry.Etale (FgtV.map f).left ∧
          (FgtV.map f).left.base y = x := (hMem V W R).mp hR
    have hEtArrow : ∀ {Z : V.Etale} (f : Z ⟶ W), AlgebraicGeometry.Etale (FgtV.map f).left := by
      intro Z f
      have _ : AlgebraicGeometry.Etale (FgtV.obj W).hom := W.prop
      have hZ : AlgebraicGeometry.Etale (FgtV.obj Z).hom := Z.prop
      have hw : (FgtV.map f).left ≫ (FgtV.obj W).hom = (FgtV.obj Z).hom :=
        CategoryTheory.MorphismProperty.Over.w f
      exact CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        (FgtV.map f).left (FgtV.obj W).hom inferInstance (hw.symm ▸ hZ)
    let mkIdx : ∀ {Z : V.Etale} (f : Z ⟶ W), R.arrows f →
        (CategoryTheory.ObjectProperty.FullSubcategory
          (fun g : CategoryTheory.Over W => R.arrows g.hom))ᵒᵖ :=
      fun {_} f hf => Opposite.op ⟨CategoryTheory.Over.mk f, hf⟩
    let secIdx : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P))
        (j : CategoryTheory.ObjectProperty.FullSubcategory
          (fun g : CategoryTheory.Over W => R.arrows g.hom)),
        ↥s.pt → LocallyConstant ↥(FgtV.obj j.obj.left).left (ULift.{u} (ZMod m_mod)) :=
      fun s j m => (s.π.app (Opposite.op j)).hom m
    let secOf : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P))
        {Z : V.Etale} (f : Z ⟶ W) (hf : R.arrows f),
        ↥s.pt → LocallyConstant ↥(FgtV.obj Z).left (ULift.{u} (ZMod m_mod)) :=
      fun s {_} f hf m => secIdx s ⟨CategoryTheory.Over.mk f, hf⟩ m
    have hCompat : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P))
        (m : ↥s.pt) {Z₁ Z₂ : V.Etale} (f₁ : Z₁ ⟶ W) (hf₁ : R.arrows f₁)
        (f₂ : Z₂ ⟶ W) (hf₂ : R.arrows f₂)
        (z₁ : ↥(FgtV.obj Z₁).left) (z₂ : ↥(FgtV.obj Z₂).left),
        (FgtV.map f₁).left.base z₁ = (FgtV.map f₂).left.base z₂ →
        secOf s f₁ hf₁ m z₁ = secOf s f₂ hf₂ m z₂ := by
      intro s m Z₁ Z₂ f₁ hf₁ f₂ hf₂ z₁ z₂ h_eq
      let g₁ := (FgtV.map f₁).left
      let g₂ := (FgtV.map f₂).left
      have _ : AlgebraicGeometry.Etale g₁ := hEtArrow f₁
      have _ : AlgebraicGeometry.Etale g₂ := hEtArrow f₂
      have _ : AlgebraicGeometry.Etale (FgtV.obj Z₁).hom := Z₁.prop
      let pr₁ := CategoryTheory.Limits.pullback.fst g₁ g₂
      let pr₂ := CategoryTheory.Limits.pullback.snd g₁ g₂
      let Z₁₂ : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (pr₁ ≫ (FgtV.obj Z₁).hom)
      let u₁ : Z₁₂ ⟶ Z₁ := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl
      have hu₂_w : pr₂ ≫ (FgtV.obj Z₂).hom = pr₁ ≫ (FgtV.obj Z₁).hom := by
        have hw₁ : g₁ ≫ (FgtV.obj W).hom = (FgtV.obj Z₁).hom :=
          CategoryTheory.MorphismProperty.Over.w f₁
        have hw₂ : g₂ ≫ (FgtV.obj W).hom = (FgtV.obj Z₂).hom :=
          CategoryTheory.MorphismProperty.Over.w f₂
        exact (congrArg (pr₂ ≫ ·) hw₂.symm).trans
          ((CategoryTheory.Category.assoc pr₂ g₂ (FgtV.obj W).hom).symm.trans
            ((congrArg (· ≫ (FgtV.obj W).hom) CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc pr₁ g₁ (FgtV.obj W).hom).trans
                (congrArg (pr₁ ≫ ·) hw₁))))
      let u₂ : Z₁₂ ⟶ Z₂ := CategoryTheory.MorphismProperty.Over.homMk pr₂ hu₂_w
      let f₁₂ : Z₁₂ ⟶ W := u₁ ≫ f₁
      have hf₁₂ : R.arrows f₁₂ := R.downward_closed hf₁ u₁
      have hf₁₂_eq₂ : u₂ ≫ f₂ = f₁₂ := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact CategoryTheory.Limits.pullback.condition.symm
        · exact Subsingleton.elim _ _
      obtain ⟨q, hq₁, hq₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁ z₂ h_eq
      let mor₁ : (mkIdx f₁₂ hf₁₂).unop ⟶ (mkIdx f₁ hf₁).unop :=
        CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk u₁ rfl)
      let mor₂ : (mkIdx f₁₂ hf₁₂).unop ⟶ (mkIdx f₂ hf₂).unop :=
        CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk u₂ hf₁₂_eq₂)
      have hw₁ := CategoryTheory.ConcreteCategory.congr_hom (s.w mor₁.op) m
      have hw₂ := CategoryTheory.ConcreteCategory.congr_hom (s.w mor₂.op) m
      have hq_left : secOf s f₁ hf₁ m (pr₁.base q) = secOf s f₁₂ hf₁₂ m q :=
        congrArg (fun (lc : LocallyConstant ↥(FgtV.obj Z₁₂).left (ULift.{u} (ZMod m_mod))) => lc q) hw₁
      have hq_right : secOf s f₂ hf₂ m (pr₂.base q) = secOf s f₁₂ hf₁₂ m q :=
        congrArg (fun (lc : LocallyConstant ↥(FgtV.obj Z₁₂).left (ULift.{u} (ZMod m_mod))) => lc q) hw₂
      exact (congrArg (secOf s f₁ hf₁ m) hq₁.symm).trans
        (hq_left.trans (hq_right.symm.trans (congrArg (secOf s f₂ hf₂ m) hq₂)))
    refine ⟨{
      lift := fun s => AddCommGrpCat.ofHom {
        toFun := fun m => {
          toFun := fun x =>
            let Y_x := (hCov x).choose
            let f_x := (hCov x).choose_spec.choose
            let y_x := (hCov x).choose_spec.choose_spec.choose
            let hf_x := (hCov x).choose_spec.choose_spec.choose_spec.1
            secOf s (Z := Y_x) f_x hf_x m y_x
          isLocallyConstant := by
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            have hSetEq : (fun x : ↥(FgtV.obj W).left =>
                let Y_x := (hCov x).choose
                let f_x := (hCov x).choose_spec.choose
                let y_x := (hCov x).choose_spec.choose_spec.choose
                let hf_x := (hCov x).choose_spec.choose_spec.choose_spec.1
                secOf s (Z := Y_x) f_x hf_x m y_x) ⁻¹' {a} =
              ⋃ (j : (CategoryTheory.ObjectProperty.FullSubcategory
                  (fun g : CategoryTheory.Over W => R.arrows g.hom))),
                (FgtV.map j.obj.hom).left.base ''
                  (secIdx s j m ⁻¹' {a}) := by
              ext x
              simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_image]
              constructor
              · intro hx
                let Y_x := (hCov x).choose
                let f_x := (hCov x).choose_spec.choose
                let y_x := (hCov x).choose_spec.choose_spec.choose
                let hspec := (hCov x).choose_spec.choose_spec.choose_spec
                exact ⟨⟨CategoryTheory.Over.mk f_x, hspec.1⟩, y_x, hx, hspec.2.2⟩
              · rintro ⟨⟨⟨Z, ⟨⟨⟩⟩, f⟩, hf⟩, z, hz, hfz⟩
                let Y_x := (hCov x).choose
                let f_x := (hCov x).choose_spec.choose
                let y_x := (hCov x).choose_spec.choose_spec.choose
                let hspec := (hCov x).choose_spec.choose_spec.choose_spec
                exact (hCompat s m f_x hspec.1 f hf y_x z (hspec.2.2.trans hfz.symm)).trans hz
            refine Eq.mpr (congrArg IsOpen hSetEq) (isOpen_iUnion fun j => ?_)
            have _ : AlgebraicGeometry.Etale (FgtV.map j.obj.hom).left := hEtArrow j.obj.hom
            exact AlgebraicGeometry.Scheme.Hom.isOpenMap (FgtV.map j.obj.hom).left _
              ((secIdx s j m).isLocallyConstant {a})
        }
        map_zero' := by
          apply LocallyConstant.ext
          intro x
          let Y_x := (hCov x).choose
          let f_x := (hCov x).choose_spec.choose
          let y_x := (hCov x).choose_spec.choose_spec.choose
          let hf_x := (hCov x).choose_spec.choose_spec.choose_spec.1
          exact congrArg
            (fun (lc : LocallyConstant ↥(FgtV.obj Y_x).left (ULift.{u} (ZMod m_mod))) => lc y_x)
            (map_zero (s.π.app (mkIdx f_x hf_x)).hom)
        map_add' := fun m₁ m₂ => by
          apply LocallyConstant.ext
          intro x
          let Y_x := (hCov x).choose
          let f_x := (hCov x).choose_spec.choose
          let y_x := (hCov x).choose_spec.choose_spec.choose
          let hf_x := (hCov x).choose_spec.choose_spec.choose_spec.1
          exact congrArg
            (fun (lc : LocallyConstant ↥(FgtV.obj Y_x).left (ULift.{u} (ZMod m_mod))) => lc y_x)
            (map_add (s.π.app (mkIdx f_x hf_x)).hom m₁ m₂)
      }
      fac := fun s j => by
        rcases j with ⟨⟨⟨Z, ⟨⟨⟩⟩, f⟩, hf⟩⟩
        apply AddCommGrpCat.ext
        intro m
        change (_ : LocallyConstant ↥(FgtV.obj Z).left (ULift.{u} (ZMod m_mod))) = secOf s f hf m
        apply LocallyConstant.ext
        intro z
        let x := (FgtV.map f).left.base z
        let Y_x := (hCov x).choose
        let f_x := (hCov x).choose_spec.choose
        let y_x := (hCov x).choose_spec.choose_spec.choose
        let hspec := (hCov x).choose_spec.choose_spec.choose_spec
        exact hCompat s m f_x hspec.1 f hf y_x z hspec.2.2
      uniq := fun s l hl => by
        apply AddCommGrpCat.ext
        intro m
        change (l.hom m : LocallyConstant ↥(FgtV.obj W).left (ULift.{u} (ZMod m_mod))) = _
        apply LocallyConstant.ext
        intro x
        let Y_x := (hCov x).choose
        let f_x := (hCov x).choose_spec.choose
        let y_x := (hCov x).choose_spec.choose_spec.choose
        let hspec := (hCov x).choose_spec.choose_spec.choose_spec
        let g_l : LocallyConstant ↥(FgtV.obj W).left (ULift.{u} (ZMod m_mod)) := l.hom m
        have hl_app := CategoryTheory.ConcreteCategory.congr_hom (hl (mkIdx (Z := Y_x) f_x hspec.1)) m
        have hl_pt : g_l ((FgtV.map f_x).left.base y_x) = secOf s f_x hspec.1 m y_x :=
          congrArg
            (fun (lc : LocallyConstant ↥(FgtV.obj Y_x).left (ULift.{u} (ZMod m_mod))) => lc y_x) hl_app
        exact (congrArg g_l hspec.2.2.symm).trans hl_pt
    }⟩

  
  have hIso_LC : ∀ (V : AlgebraicGeometry.Scheme.{u}),
      let J_V := V.smallEtaleTopology
      let L_V : CategoryTheory.Sheaf J_V AddCommGrpCat.{u} :=
        ⟨weilAltLocConstPresheaf V m_mod, hSh_LC V⟩
      let P_const := (CategoryTheory.Functor.const (Opposite V.Etale)).obj A_m
      let κ_V : P_const ⟶ L_V.obj :=
        { app := fun U => weilAltLocConstConstHom V (Opposite.unop U) m_mod
          naturality := fun {_ _} _ =>
            AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
      let shAdj_V := CategoryTheory.sheafificationAdjunction J_V AddCommGrpCat.{u}
      let Φ_V : weilEtaleTorsionSheaf V m_mod ⟶ L_V :=
        (shAdj_V.homEquiv P_const L_V).symm κ_V
      CategoryTheory.IsIso Φ_V ∧
      ∀ (T : V.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
        (CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT).unit.app A_m ≫
          Φ_V.hom.app (Opposite.op T) = weilAltLocConstConstHom V T m_mod := by
    intro V J_V L_V P_const κ_V shAdj_V Φ_V
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective J_V κ_V := by
      refine ⟨fun {U} a₁ a₂ h_eq => ?_⟩
      rw [hMem V U.unop]
      intro y
      have ha : a₁ = a₂ := by
        have h_lc : LocallyConstant.const
            ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj U.unop).left a₁ =
          LocallyConstant.const
            ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj U.unop).left a₂ := h_eq
        exact congrArg (fun g : LocallyConstant _ _ => g y) h_lc
      refine ⟨U.unop, 𝟙 U.unop, y, ?_, ?_, rfl⟩
      · change (P_const.map (Opposite.op (𝟙 U.unop))).hom a₁ =
          (P_const.map (Opposite.op (𝟙 U.unop))).hom a₂
        exact congrArg _ ha
      · change AlgebraicGeometry.Etale (𝟙 ((AlgebraicGeometry.Scheme.Etale.forget V).obj U.unop).left)
        infer_instance
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J_V κ_V := by
      refine ⟨fun {Y} g => ?_⟩
      rw [hMem V Y]
      intro y
      let FgtV := AlgebraicGeometry.Scheme.Etale.forget V
      let g_lc : LocallyConstant ↥(FgtV.obj Y).left (ULift.{u} (ZMod m_mod)) := g
      let O_y : ((FgtV.obj Y).left).Opens := ⟨g_lc ⁻¹' {g_lc y}, g_lc.isLocallyConstant {g_lc y}⟩
      have _ : AlgebraicGeometry.Etale (FgtV.obj Y).hom := Y.prop
      let Z_y : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_y.ι ≫ (FgtV.obj Y).hom)
      let u_y : Z_y ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk O_y.ι rfl
      refine ⟨Z_y, u_y, ⟨y, rfl⟩, ?_, ?_, rfl⟩
      · refine ⟨g_lc y, LocallyConstant.ext fun z => ?_⟩
        exact z.2.symm
      · change AlgebraicGeometry.Etale O_y.ι
        infer_instance
    have hW : J_V.W κ_V := (J_V.W_iff_isLocallyBijective κ_V).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf J_V AddCommGrpCat.{u}).map κ_V) :=
      (J_V.W_iff κ_V).mp hW
    have hIso_counit : CategoryTheory.IsIso (shAdj_V.counit.app L_V) := inferInstance
    have hΦ_eq : Φ_V =
        (CategoryTheory.presheafToSheaf J_V AddCommGrpCat.{u}).map κ_V ≫
          shAdj_V.counit.app L_V :=
      CategoryTheory.Adjunction.homEquiv_counit shAdj_V P_const L_V κ_V
    refine ⟨?_, ?_⟩
    · rw [hΦ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _
        ((CategoryTheory.presheafToSheaf J_V AddCommGrpCat.{u}).map κ_V)
        (shAdj_V.counit.app L_V) hIso_map hIso_counit
    · intro T hT
      have h_unit : (CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT).unit.app A_m =
          (shAdj_V.unit.app P_const).app (Opposite.op T) := by
        change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT).comp shAdj_V).unit.app A_m = _
        rw [CategoryTheory.Adjunction.comp_unit_app]
        exact CategoryTheory.Category.id_comp _
      have h_sh : shAdj_V.unit.app P_const ≫ Φ_V.hom = κ_V := by
        have h1 : shAdj_V.homEquiv P_const L_V Φ_V = κ_V :=
          (shAdj_V.homEquiv P_const L_V).apply_symm_apply κ_V
        rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
      rw [h_unit]
      exact CategoryTheory.NatTrans.congr_app h_sh (Opposite.op T)

  
  have hIntertwine : ∀ {S_U S_X : AlgebraicGeometry.Scheme.{u}} (j' : S_U ⟶ S_X)
      (hc : (weilEtaleSitePullback j').IsContinuous
        S_X.smallEtaleTopology S_U.smallEtaleTopology)
      (hr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback j') AddCommGrpCat.{u} _
        S_X.smallEtaleTopology S_U.smallEtaleTopology hc).IsRightAdjoint)
      (TU : S_U.Etale) (hTU : CategoryTheory.Limits.IsTerminal TU)
      (TX : S_X.Etale) (hTX : CategoryTheory.Limits.IsTerminal TX)
      (Y : S_X.Etale),
      let adj_j' := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback j') AddCommGrpCat.{u} _
        S_X.smallEtaleTopology S_U.smallEtaleTopology hc hr
      let η_j' := (adj_j'.homEquiv (weilEtaleTorsionSheaf S_X m_mod) (weilEtaleTorsionSheaf S_U m_mod))
        (@weilEtaleConstPullbackHom S_U S_X j' hc hr TU hTU TX hTX A_m)
      Function.Bijective (η_j'.hom.app (Opposite.op Y)) ↔
        Function.Bijective
          (fun g : LocallyConstant
              ↥((AlgebraicGeometry.Scheme.Etale.forget S_X).obj Y).left ↥A_m =>
            g.comap
              (CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget S_X).obj Y).hom j').base.hom) := by
    intro S_U S_X j' hc hr TU hTU TX hTX Y adj_j' η_j'
    let _ := hc
    let _ := hr
    let B_j' := weilEtaleSitePullback j'
    let pf_j' := B_j'.sheafPushforwardContinuous AddCommGrpCat.{u}
      S_X.smallEtaleTopology S_U.smallEtaleTopology
    let C_X := weilEtaleTorsionSheaf S_X m_mod
    let C_U := weilEtaleTorsionSheaf S_U m_mod
    let L_X : CategoryTheory.Sheaf S_X.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf S_X m_mod, hSh_LC S_X⟩
    let L_U : CategoryTheory.Sheaf S_U.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf S_U m_mod, hSh_LC S_U⟩
    let Φ_X : C_X ⟶ L_X :=
      ((CategoryTheory.sheafificationAdjunction S_X.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        ((CategoryTheory.Functor.const (Opposite S_X.Etale)).obj A_m) L_X).symm
        { app := fun U => weilAltLocConstConstHom S_X (Opposite.unop U) m_mod
          naturality := fun {_ _} _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    let Φ_U : C_U ⟶ L_U :=
      ((CategoryTheory.sheafificationAdjunction S_U.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        ((CategoryTheory.Functor.const (Opposite S_U.Etale)).obj A_m) L_U).symm
        { app := fun U => weilAltLocConstConstHom S_U (Opposite.unop U) m_mod
          naturality := fun {_ _} _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    obtain ⟨hIso_X, hUnit_X⟩ := hIso_LC S_X
    obtain ⟨hIso_U, hUnit_U⟩ := hIso_LC S_U
    let e_X : C_X ≅ L_X := @CategoryTheory.asIso _ _ _ _ Φ_X hIso_X
    let e_U : C_U ≅ L_U := @CategoryTheory.asIso _ _ _ _ Φ_U hIso_U
    let pull_LC : L_X ⟶ pf_j'.obj L_U := { hom := weilAltLocConstPullbackNat j' m_mod }
    let adj_X := CategoryTheory.constantSheafAdj S_X.smallEtaleTopology AddCommGrpCat.{u} hTX
    let adj_U := CategoryTheory.constantSheafAdj S_U.smallEtaleTopology AddCommGrpCat.{u} hTU
    let τ := hTU.from (B_j'.obj TX)
    have hη_simp : η_j' =
        (adj_X.homEquiv A_m (pf_j'.obj C_U)).symm
          (adj_U.unit.app A_m ≫ C_U.obj.map τ.op) := by
      dsimp only [η_j', weilEtaleConstPullbackHom]
      exact (adj_j'.homEquiv C_X C_U).apply_symm_apply _
    have hComm : η_j' ≫ pf_j'.map Φ_U = Φ_X ≫ pull_LC := by
      apply (adj_X.homEquiv A_m (pf_j'.obj L_U)).injective
      have hLHS : adj_X.homEquiv A_m (pf_j'.obj L_U) (η_j' ≫ pf_j'.map Φ_U) =
          weilAltLocConstConstHom S_U TU m_mod ≫ L_U.obj.map τ.op := by
        have h1 : adj_X.homEquiv A_m (pf_j'.obj L_U) (η_j' ≫ pf_j'.map Φ_U) =
            (adj_U.unit.app A_m ≫ C_U.obj.map τ.op) ≫
              Φ_U.hom.app (Opposite.op (B_j'.obj TX)) := by
          rw [CategoryTheory.Adjunction.homEquiv_naturality_right, hη_simp,
            (adj_X.homEquiv A_m (pf_j'.obj C_U)).apply_symm_apply]
          rfl
        have h2 : (adj_U.unit.app A_m ≫ C_U.obj.map τ.op) ≫
            Φ_U.hom.app (Opposite.op (B_j'.obj TX)) =
            weilAltLocConstConstHom S_U TU m_mod ≫ L_U.obj.map τ.op :=
          (CategoryTheory.Category.assoc (adj_U.unit.app A_m) (C_U.obj.map τ.op)
            (Φ_U.hom.app (Opposite.op (B_j'.obj TX)))).trans
            ((congrArg (adj_U.unit.app A_m ≫ ·) (Φ_U.hom.naturality τ.op)).trans
              ((CategoryTheory.Category.assoc (adj_U.unit.app A_m)
                (Φ_U.hom.app (Opposite.op TU)) (L_U.obj.map τ.op)).symm.trans
                (congrArg (· ≫ L_U.obj.map τ.op) (hUnit_U TU hTU))))
        exact h1.trans h2
      have hRHS : adj_X.homEquiv A_m (pf_j'.obj L_U) (Φ_X ≫ pull_LC) =
          weilAltLocConstConstHom S_X TX m_mod ≫
            (weilAltLocConstPullbackNat j' m_mod).app (Opposite.op TX) := by
        have h1 : adj_X.homEquiv A_m (pf_j'.obj L_U) (Φ_X ≫ pull_LC) =
            adj_X.unit.app A_m ≫
              (Φ_X.hom.app (Opposite.op TX) ≫
                (weilAltLocConstPullbackNat j' m_mod).app (Opposite.op TX)) := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        exact h1.trans
          ((CategoryTheory.Category.assoc (adj_X.unit.app A_m)
            (Φ_X.hom.app (Opposite.op TX))
            ((weilAltLocConstPullbackNat j' m_mod).app (Opposite.op TX))).symm.trans
            (congrArg (· ≫ (weilAltLocConstPullbackNat j' m_mod).app (Opposite.op TX))
              (hUnit_X TX hTX)))
      rw [hLHS, hRHS]
      exact AddCommGrpCat.ext fun a => LocallyConstant.ext fun _ => rfl
    have hApp : η_j'.hom.app (Opposite.op Y) ≫
        Φ_U.hom.app (Opposite.op (B_j'.obj Y)) =
        Φ_X.hom.app (Opposite.op Y) ≫
          (weilAltLocConstPullbackNat j' m_mod).app (Opposite.op Y) :=
      congrArg (fun (φ : C_X ⟶ pf_j'.obj L_U) => φ.hom.app (Opposite.op Y)) hComm
    let E_X : ↥(C_X.obj.obj (Opposite.op Y)) ≃
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S_X).obj Y).left ↥A_m :=
      { toFun := (e_X.hom.hom.app (Opposite.op Y)).hom
        invFun := (e_X.inv.hom.app (Opposite.op Y)).hom
        left_inv := fun s => CategoryTheory.ConcreteCategory.congr_hom
          (congrArg (fun (φ : C_X ⟶ C_X) => φ.hom.app (Opposite.op Y)) e_X.hom_inv_id) s
        right_inv := fun g => CategoryTheory.ConcreteCategory.congr_hom
          (congrArg (fun (φ : L_X ⟶ L_X) => φ.hom.app (Opposite.op Y)) e_X.inv_hom_id) g }
    let E_U : ↥(C_U.obj.obj (Opposite.op (B_j'.obj Y))) ≃
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S_U).obj (B_j'.obj Y)).left ↥A_m :=
      { toFun := (e_U.hom.hom.app (Opposite.op (B_j'.obj Y))).hom
        invFun := (e_U.inv.hom.app (Opposite.op (B_j'.obj Y))).hom
        left_inv := fun s => CategoryTheory.ConcreteCategory.congr_hom
          (congrArg (fun (φ : C_U ⟶ C_U) => φ.hom.app (Opposite.op (B_j'.obj Y))) e_U.hom_inv_id) s
        right_inv := fun g => CategoryTheory.ConcreteCategory.congr_hom
          (congrArg (fun (φ : L_U ⟶ L_U) => φ.hom.app (Opposite.op (B_j'.obj Y))) e_U.inv_hom_id) g }
    let comapFn := fun g : LocallyConstant
        ↥((AlgebraicGeometry.Scheme.Etale.forget S_X).obj Y).left ↥A_m =>
      g.comap
        (CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget S_X).obj Y).hom j').base.hom
    have hFnEq : ⇑E_U ∘ ⇑(η_j'.hom.app (Opposite.op Y)) = comapFn ∘ ⇑E_X := by
      funext s
      have hs := CategoryTheory.ConcreteCategory.congr_hom hApp s
      exact hs.trans (LocallyConstant.ext fun _ => rfl)
    constructor
    · intro hBij_η
      have h1 : Function.Bijective (comapFn ∘ ⇑E_X) := by
        rw [← hFnEq]
        exact E_U.bijective.comp hBij_η
      have h2 : comapFn = (comapFn ∘ ⇑E_X) ∘ ⇑E_X.symm := by
        funext g
        exact congrArg comapFn (E_X.apply_symm_apply g).symm
      change Function.Bijective comapFn
      rw [h2]
      exact h1.comp E_X.symm.bijective
    · intro hBij_c
      have h1 : Function.Bijective (⇑E_U ∘ ⇑(η_j'.hom.app (Opposite.op Y))) := by
        rw [hFnEq]
        exact hBij_c.comp E_X.bijective
      have h2 : ⇑(η_j'.hom.app (Opposite.op Y)) =
          ⇑E_U.symm ∘ (⇑E_U ∘ ⇑(η_j'.hom.app (Opposite.op Y))) := by
        funext s
        exact (E_U.symm_apply_apply _).symm
      rw [h2]
      exact E_U.symm.bijective.comp h1

  refine ⟨fun Y => hIntertwine j hCont_j hAdj_j T_U hT_U T_X hT_X Y, ?_⟩

  
  intro Z₁ Z₂ h p hp
  rcases hp with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hι₁, hι₂, hp_eq⟩
