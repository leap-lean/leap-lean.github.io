        (CategoryTheory.Abelian.Ext.mk₀ i_v) (Nat.add_zero 0) =
        a.comp (CategoryTheory.Abelian.Ext.mk₀ g₀) (Nat.add_zero 0)
      rw [CategoryTheory.Abelian.Ext.comp_assoc a _ _
          (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hfac]
