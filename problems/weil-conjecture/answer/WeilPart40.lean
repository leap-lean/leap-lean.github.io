  have hQuotCard : ∀ {G₁ G₂ D : Type u} [AddCommGroup G₁] [AddCommGroup G₂]
      [AddCommGroup D] [Finite D] (p : G₁ →+ G₂) (δ : G₂ →+ D),
      (∀ b : G₂, δ b = 0 ↔ b ∈ AddMonoidHom.range p) →
      Finite (G₂ ⧸ AddMonoidHom.range p) ∧
        Nat.card (G₂ ⧸ AddMonoidHom.range p) ≤ Nat.card D := by
    intro G₁ G₂ D _ _ _ _ p δ hker
    let f_Q : (G₂ ⧸ AddMonoidHom.range p) →+ D :=
      QuotientAddGroup.lift (AddMonoidHom.range p) δ (fun b hb => (hker b).mpr hb)
    have hf_Q_inj : Function.Injective f_Q := by
      rw [injective_iff_map_eq_zero]
      intro q hq
      induction q using QuotientAddGroup.induction_on with
      | H b => exact (QuotientAddGroup.eq_zero_iff b).mpr ((hker b).mp hq)
    exact ⟨Finite.of_injective f_Q hf_Q_inj, Nat.card_le_card_of_injective f_Q hf_Q_inj⟩

