        let SC_U := (SC₀.map UL).map C_U
        have hSE_U : SC_U.ShortExact := hSE_ul.map_of_exact C_U
        let coh_U := CategoryTheory.Sheaf.cohomologyPresheafFunctor U.smallEtaleTopology b
        let f_pre : coh_U.obj SC_U.X₁ ⟶ coh_U.obj SC_U.X₂ := coh_U.map SC_U.f
        let g_pre : coh_U.obj SC_U.X₂ ⟶ coh_U.obj SC_U.X₃ := coh_U.map SC_U.g
        have hfg_pre : f_pre ≫ g_pre = 0 := by
          apply CategoryTheory.NatTrans.ext; funext W_op
          change ((coh_U.map SC_U.f) ≫ (coh_U.map SC_U.g)).app W_op = 0
          rw [← coh_U.map_comp, SC_U.zero]
          exact (CategoryTheory.Abelian.extFunctorObj _ b).map_zero _ _
        let S_pre := CategoryTheory.ShortComplex.mk f_pre g_pre hfg_pre
        have hZ_pre : CategoryTheory.Limits.IsZero S_pre.leftHomology := by
          rw [CategoryTheory.Functor.isZero_iff]
          intro W_op
          let evW := (CategoryTheory.evaluation (Opposite U.Etale) AddCommGrpCat.{u}).obj W_op
          have hIso := S_pre.mapLeftHomologyIso evW
          have hExW : (S_pre.map evW).Exact :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' _ hSE_U b
