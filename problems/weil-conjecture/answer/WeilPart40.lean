    have h_S1 : f₀ ≫ q_v = 0 := by
      apply (CategoryTheory.cancel_mono i_v).mp
      rw [CategoryTheory.Category.assoc, hfac, h₁, CategoryTheory.Limits.zero_comp]
    have hex_S1 : (CategoryTheory.ShortComplex.mk f₀ q_v h_S1).Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
      have hk : CategoryTheory.Limits.kernel.ι q_v ≫ g₀ = 0 := by
        rw [← hfac, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.condition,
          CategoryTheory.Limits.zero_comp]
      let l := CategoryTheory.Limits.kernel.lift g₀ (CategoryTheory.Limits.kernel.ι q_v) hk
      have hl : l ≫ CategoryTheory.Limits.kernel.ι g₀ = CategoryTheory.Limits.kernel.ι q_v :=
        CategoryTheory.Limits.kernel.lift_ι g₀ (CategoryTheory.Limits.kernel.ι q_v) hk
      have hex₁' : CategoryTheory.Limits.kernel.ι g₀ ≫ CategoryTheory.Limits.cokernel.π f₀ = 0 :=
        (CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero _).mp hex₁
      change CategoryTheory.Limits.kernel.ι q_v ≫ CategoryTheory.Limits.cokernel.π f₀ = 0
      rw [← hl, CategoryTheory.Category.assoc, hex₁', CategoryTheory.Limits.comp_zero]
    have hSE_S1 : (CategoryTheory.ShortComplex.mk f₀ q_v h_S1).ShortExact :=
      { exact := hex_S1, mono_f := hf₀, epi_g := inferInstance }
    have h_S2 : i_v ≫ δ₀ = 0 := by
      apply (CategoryTheory.cancel_epi q_v).mp
      rw [← CategoryTheory.Category.assoc, hfac, h₂, CategoryTheory.Limits.comp_zero]
    have hex_S2 : (CategoryTheory.ShortComplex.mk i_v δ₀ h_S2).Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
      have hc : g₀ ≫ CategoryTheory.Limits.cokernel.π i_v = 0 := by
        rw [← hfac, CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.condition,
          CategoryTheory.Limits.comp_zero]
      let d := CategoryTheory.Limits.cokernel.desc g₀ (CategoryTheory.Limits.cokernel.π i_v) hc
      have hd : CategoryTheory.Limits.cokernel.π g₀ ≫ d = CategoryTheory.Limits.cokernel.π i_v :=
        CategoryTheory.Limits.cokernel.π_desc g₀ (CategoryTheory.Limits.cokernel.π i_v) hc
      have hex₂' : CategoryTheory.Limits.kernel.ι δ₀ ≫ CategoryTheory.Limits.cokernel.π g₀ = 0 :=
        (CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero _).mp hex₂
      change CategoryTheory.Limits.kernel.ι δ₀ ≫ CategoryTheory.Limits.cokernel.π i_v = 0
