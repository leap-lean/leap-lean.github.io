            ← AlgebraicGeometry.Spec.map_comp,
            (hStage_props j).2.2.2.2.2.1, ← hg_Ks_eq])

    have hpb_Zop : ∀ j : 𝒥, CategoryTheory.IsPullback (π_op j)
        (CategoryTheory.Limits.pullback.snd f_bar.left (g_op j))
        p₀_op (AlgebraicGeometry.Spec.map (α_op.app j)) := by
      intro j
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback f_bar.left j_open)
      rw [CategoryTheory.Limits.pullback.lift_fst, ← hg_op_eq j]
      exact CategoryTheory.IsPullback.of_hasPullback f_bar.left (g_op j)

    have hpb_ZKs : CategoryTheory.IsPullback π_Ks
        (CategoryTheory.Limits.pullback.snd f_bar.left g_Ks)
        p₀_op (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_Ks_loc)) := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback f_bar.left j_open)
      rw [CategoryTheory.Limits.pullback.lift_fst, ← hg_Ks_eq]
      exact CategoryTheory.IsPullback.of_hasPullback f_bar.left g_Ks

    have hu_op_comm : ∀ j : 𝒥,
        u_op j ≫ π_op j = π_Ks ∧
        u_op j ≫ CategoryTheory.Limits.pullback.snd f_bar.left (g_op j) =
          CategoryTheory.Limits.pullback.snd f_bar.left g_Ks ≫
            AlgebraicGeometry.Spec.map ((c_op.ι.app j) ≫ e_Ks.hom) := by
      intro j
      refine ⟨?_, by dsimp [u_op]; rw [CategoryTheory.Limits.pullback.lift_snd]⟩
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [u_op, π_op, π_Ks]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.comp_id]
      · dsimp [u_op, π_op, π_Ks]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, (hStage_props j).2.2.2.2.2.1]

    have hm_op_comm : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂),
        m_op_left θ ≫ π_op j₁ = π_op j₂ ∧
        m_op_left θ ≫ CategoryTheory.Limits.pullback.snd f_bar.left (g_op j₁) =
          CategoryTheory.Limits.pullback.snd f_bar.left (g_op j₂) ≫
            AlgebraicGeometry.Spec.map (B_open.map θ) := by
      intro j₁ j₂ θ
      refine ⟨?_, by dsimp [m_op_left]; rw [CategoryTheory.Limits.pullback.lift_snd]⟩
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [m_op_left, π_op]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.comp_id]
      · dsimp [m_op_left, π_op]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp]
        have hnat : α_op.app j₁ ≫ B_open.map θ = α_op.app j₂ := by
          simpa using (α_op.naturality θ).symm
        rw [hnat]

    obtain ⟨hSurj_op, hInj_op⟩ :=
      hColim_qc_sep 𝒥 B₀_op (CommRingCat.of K_s) B_open α_op c_op hc_op e_Ks
        (CommRingCat.ofHom p_Ks_loc) (fun j => (hStage_props j).2.2.2.2.2.1)
        Z₀_op p₀_op Z_op π_op
        (fun j => CategoryTheory.Limits.pullback.snd f_bar.left (g_op j))
        Z_Ks π_Ks (CategoryTheory.Limits.pullback.snd f_bar.left g_Ks)
        u_op (@m_op_left) hpb_Zop hpb_ZKs hu_op_comm (@hm_op_comm)
        M_mod (2 * m + 1)

    let p_u_op : ∀ j : 𝒥,
        weilEtaleTorsionH (Z_op j) M_mod (2 * m + 1) →+
          weilEtaleTorsionH Z_Ks M_mod (2 * m + 1) :=
      fun j => Classical.choose (hPb_ex (u_op j) M_mod (2 * m + 1))
    have hp_u_op : ∀ j : 𝒥,
        WeilIsTorsionEtalePullback (u_op j) M_mod (2 * m + 1) (p_u_op j) :=
      fun j => Classical.choose_spec (hPb_ex (u_op j) M_mod (2 * m + 1))

    let p_u_st : ∀ j : 𝒥,
        weilEtaleTorsionH (Z_st j) M_mod (2 * m + 1) →+
          weilEtaleTorsionH Z_Rs M_mod (2 * m + 1) :=
      fun j => Classical.choose (hPb_ex (u_st j) M_mod (2 * m + 1))
    have hp_u_st : ∀ j : 𝒥,
        WeilIsTorsionEtalePullback (u_st j) M_mod (2 * m + 1) (p_u_st j) :=
      fun j => Classical.choose_spec (hPb_ex (u_st j) M_mod (2 * m + 1))

    let p_v : ∀ j : 𝒥,
        weilEtaleTorsionH (Z_st j) M_mod (2 * m + 1) →+
          weilEtaleTorsionH (Z_op j) M_mod (2 * m + 1) :=
      fun j => Classical.choose (hPb_ex (v_open_left j) M_mod (2 * m + 1))
    have hp_v : ∀ j : 𝒥,
        WeilIsTorsionEtalePullback (v_open_left j) M_mod (2 * m + 1) (p_v j) :=
      fun j => Classical.choose_spec (hPb_ex (v_open_left j) M_mod (2 * m + 1))

    let p_θ_op : ∀ {j₁ j₂ : 𝒥} (_ : j₁ ⟶ j₂),
        weilEtaleTorsionH (Z_op j₁) M_mod (2 * m + 1) →+
          weilEtaleTorsionH (Z_op j₂) M_mod (2 * m + 1) :=
      fun θ => Classical.choose (hPb_ex (m_op_left θ) M_mod (2 * m + 1))
    have hp_θ_op : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂),
        WeilIsTorsionEtalePullback (m_op_left θ) M_mod (2 * m + 1) (p_θ_op θ) :=
      fun θ => Classical.choose_spec (hPb_ex (m_op_left θ) M_mod (2 * m + 1))

    have hp_u_θ : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂),
        (p_u_op j₂).comp (p_θ_op θ) = p_u_op j₁ := by
      intro j₁ j₂ θ
      have hsch : u_op j₂ ≫ m_op_left θ = u_op j₁ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [u_op, m_op_left]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.comp_id]
        · dsimp [u_op, m_op_left]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc, c_op.w θ]
      have hcomp_pb : WeilIsTorsionEtalePullback (u_op j₂ ≫ m_op_left θ) M_mod (2 * m + 1)
          (p_u_op j₁) := by
        rw [hsch]
        exact hp_u_op j₁
      exact (hPb_comp (u_op j₂) (m_op_left θ) M_mod (2 * m + 1)
        (p_u_op j₂) (p_θ_op θ) (p_u_op j₁) (hp_u_op j₂) (hp_θ_op θ) hcomp_pb).symm

    have hp_u_v : ∀ j : 𝒥,
        (p_u_op j).comp (p_v j) = (p_KR r).comp (p_u_st j) := by
      intro j
      have hsch : u_op j ≫ v_open_left j = j_Z_K ≫ u_st j := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [u_op, v_open_left, j_Z_K, u_st]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.comp_id]
        · dsimp [u_op, v_open_left, j_Z_K, u_st]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          simp only [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          simp only [CategoryTheory.Category.assoc]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          congr 2
          exact ((hStage_props j).2.2.2.2.2.2.1).symm
      obtain ⟨p_mid_uv, hp_mid_uv⟩ := hPb_ex (u_op j ≫ v_open_left j) M_mod (2 * m + 1)
      have hL := hPb_comp (u_op j) (v_open_left j) M_mod (2 * m + 1)
        (p_u_op j) (p_v j) p_mid_uv (hp_u_op j) (hp_v j) hp_mid_uv
      have hp_mid_uv' : WeilIsTorsionEtalePullback (j_Z_K ≫ u_st j) M_mod (2 * m + 1) p_mid_uv := by
        rwa [← hsch]
      have hR := hPb_comp j_Z_K (u_st j) M_mod (2 * m + 1)
        (p_KR r) (p_u_st j) p_mid_uv (hp_KR r) (hp_u_st j) hp_mid_uv'
      exact hL.symm.trans hR

    have hSurj_op' : ∀ ξ : weilEtaleTorsionH Z_Ks M_mod (2 * m + 1),
        ∃ (j : 𝒥) (ξ_j : weilEtaleTorsionH (Z_op j) M_mod (2 * m + 1)),
          p_u_op j ξ_j = ξ := by
      intro ξ
      obtain ⟨j, ξ_j, p_uj, hp_uj, heq⟩ := hSurj_op ξ
      have hp_eq := hPb_uniq (u_op j) M_mod (2 * m + 1) p_uj (p_u_op j) hp_uj (hp_u_op j)
      rw [hp_eq] at heq
      exact ⟨j, ξ_j, heq⟩

    have hδ_wd : ∀ (j₁ j₂ : 𝒥)
        (x₁ : weilEtaleTorsionH (Z_op j₁) M_mod (2 * m + 1))
        (x₂ : weilEtaleTorsionH (Z_op j₂) M_mod (2 * m + 1)),
        p_u_op j₁ x₁ = p_u_op j₂ x₂ → δ_op j₁ x₁ = δ_op j₂ x₂ := by
      intro j₁ j₂ x₁ x₂ heq
      let j₃ := CategoryTheory.IsFiltered.max j₁ j₂
      let α₁ : j₁ ⟶ j₃ := CategoryTheory.IsFiltered.leftToMax j₁ j₂
      let α₂ : j₂ ⟶ j₃ := CategoryTheory.IsFiltered.rightToMax j₁ j₂
      let d₃ := p_θ_op α₁ x₁ - p_θ_op α₂ x₂
      have hd₃_zero : p_u_op j₃ d₃ = 0 := by
        dsimp [d₃]
        rw [map_sub]
        have h1 : p_u_op j₃ (p_θ_op α₁ x₁) = p_u_op j₁ x₁ :=
          congrArg (fun f => f x₁) (hp_u_θ α₁)
        have h2 : p_u_op j₃ (p_θ_op α₂ x₂) = p_u_op j₂ x₂ :=
          congrArg (fun f => f x₂) (hp_u_θ α₂)
        rw [h1, h2, heq, sub_self]
      obtain ⟨j₄, β, p_β, hp_β, hβ_zero⟩ := hInj_op j₃ d₃ (p_u_op j₃) (hp_u_op j₃) hd₃_zero
      have hpβ_eq := hPb_uniq (m_op_left β) M_mod (2 * m + 1) p_β (p_θ_op β) hp_β (hp_θ_op β)
      rw [hpβ_eq] at hβ_zero
      dsimp [d₃] at hβ_zero
      rw [map_sub] at hβ_zero
      have hβ_eq : p_θ_op β (p_θ_op α₁ x₁) = p_θ_op β (p_θ_op α₂ x₂) :=
        sub_eq_zero.mp hβ_zero
      have hδ1 := congrArg (fun f => f x₁) (hδ_θ α₁ (p_θ_op α₁) (hp_θ_op α₁))
      have hδ2 := congrArg (fun f => f x₂) (hδ_θ α₂ (p_θ_op α₂) (hp_θ_op α₂))
      have hδβ1 := congrArg (fun f => f (p_θ_op α₁ x₁)) (hδ_θ β (p_θ_op β) (hp_θ_op β))
      have hδβ2 := congrArg (fun f => f (p_θ_op α₂ x₂)) (hδ_θ β (p_θ_op β) (hp_θ_op β))
      change δ_op j₃ (p_θ_op α₁ x₁) = δ_op j₁ x₁ at hδ1
      change δ_op j₃ (p_θ_op α₂ x₂) = δ_op j₂ x₂ at hδ2
      change δ_op j₄ (p_θ_op β (p_θ_op α₁ x₁)) = δ_op j₃ (p_θ_op α₁ x₁) at hδβ1
      change δ_op j₄ (p_θ_op β (p_θ_op α₂ x₂)) = δ_op j₃ (p_θ_op α₂ x₂) at hδβ2
      rw [← hδ1, ← hδβ1, hβ_eq, hδβ2, hδ2]

    let δ_inf_fun : weilEtaleTorsionH Z_Ks M_mod (2 * m + 1) → D_dual :=
      fun ξ =>
        let j := Classical.choose (hSurj_op' ξ)
        let ξ_j := Classical.choose (Classical.choose_spec (hSurj_op' ξ))
        δ_op j ξ_j

    have hδ_inf_eval : ∀ (j : 𝒥) (ξ_j : weilEtaleTorsionH (Z_op j) M_mod (2 * m + 1)),
        δ_inf_fun (p_u_op j ξ_j) = δ_op j ξ_j := by
      intro j ξ_j
      let ξ := p_u_op j ξ_j
      let j' := Classical.choose (hSurj_op' ξ)
      let ξ_j' := Classical.choose (Classical.choose_spec (hSurj_op' ξ))
      have hspec : p_u_op j' ξ_j' = ξ :=
        Classical.choose_spec (Classical.choose_spec (hSurj_op' ξ))
      exact hδ_wd j' j ξ_j' ξ_j hspec

    let δ_inf : weilEtaleTorsionH Z_Ks M_mod (2 * m + 1) →+ D_dual :=
      { toFun := δ_inf_fun
        map_zero' := by
          obtain ⟨j₀⟩ := CategoryTheory.IsFiltered.nonempty (C := 𝒥)
          have h0 : p_u_op j₀ 0 = 0 := map_zero _
          rw [← h0, hδ_inf_eval j₀ 0, map_zero]
        map_add' := fun x y => by
          obtain ⟨j₁, x₁, rfl⟩ := hSurj_op' x
          obtain ⟨j₂, y₂, rfl⟩ := hSurj_op' y
          let j₃ := CategoryTheory.IsFiltered.max j₁ j₂
          let α₁ : j₁ ⟶ j₃ := CategoryTheory.IsFiltered.leftToMax j₁ j₂
          let α₂ : j₂ ⟶ j₃ := CategoryTheory.IsFiltered.rightToMax j₁ j₂
          have hx₁ : p_u_op j₁ x₁ = p_u_op j₃ (p_θ_op α₁ x₁) :=
            (congrArg (fun f => f x₁) (hp_u_θ α₁)).symm
          have hy₂ : p_u_op j₂ y₂ = p_u_op j₃ (p_θ_op α₂ y₂) :=
            (congrArg (fun f => f y₂) (hp_u_θ α₂)).symm
          rw [hx₁, hy₂, ← map_add, hδ_inf_eval, hδ_inf_eval, hδ_inf_eval, map_add] }

    have hker_δ_inf : ∀ b : weilEtaleTorsionH Z_Ks M_mod (2 * m + 1),
        δ_inf b = 0 ↔ b ∈ AddMonoidHom.range (p_KR r) := by
      intro b
      constructor
      · intro hb0
        obtain ⟨j, b_j, rfl⟩ := hSurj_op' b
        have hbj0 : δ_op j b_j = 0 := by
          change δ_inf_fun (p_u_op j b_j) = 0 at hb0
          rwa [hδ_inf_eval j b_j] at hb0
        have hker_j : AddMonoidHom.ker (δ_op j) = AddMonoidHom.range (p_v j) :=
          hδ_ker j (p_v j) (hp_v j)
        have hmem_ker : b_j ∈ AddMonoidHom.ker (δ_op j) := hbj0
        rw [hker_j] at hmem_ker
        rcases hmem_ker with ⟨z_j, rfl⟩
        refine ⟨p_u_st j z_j, ?_⟩
        exact (congrArg (fun f => f z_j) (hp_u_v j)).symm
      · rintro ⟨z, rfl⟩
        obtain ⟨j, z_j, p_uj_st, hp_uj_st, hzj_eq⟩ := hSurj_st z
        have hp_st_eq := hPb_uniq (u_st j) M_mod (2 * m + 1) p_uj_st (p_u_st j)
          hp_uj_st (hp_u_st j)
        rw [hp_st_eq] at hzj_eq
        rw [← hzj_eq]
        have huv := congrArg (fun f => f z_j) (hp_u_v j)
        change p_u_op j (p_v j z_j) = p_KR r (p_u_st j z_j) at huv
        rw [← huv]
        change δ_inf_fun (p_u_op j (p_v j z_j)) = 0
        rw [hδ_inf_eval j (p_v j z_j)]
        have hker_j : AddMonoidHom.ker (δ_op j) = AddMonoidHom.range (p_v j) :=
          hδ_ker j (p_v j) (hp_v j)
        have hmem_rng : p_v j z_j ∈ AddMonoidHom.range (p_v j) := ⟨z_j, rfl⟩
        rw [← hker_j] at hmem_rng
        exact hmem_rng

    obtain ⟨hFin_coker_KR, hCard_le_D⟩ :=
      @hQuotCard _ _ _ inferInstance inferInstance hGrp_D hFin_D (p_KR r) δ_inf hker_δ_inf
    have hCard_coker_KR :
        Nat.card (weilEtaleTorsionH Z_Ks M_mod (2 * m + 1) ⧸ AddMonoidHom.range (p_KR r)) ≤
          Nat.card (weilEtaleTorsionH Z_s M_mod (2 * m + 2)) :=
      hCard_le_D.trans hCard_D

    obtain ⟨hFin_sp, hBd1_sp, hEq_sp⟩ :=
      (hLeray_all r).2 j_Z_Rs hj_fst hj_snd p_2m p_2m1 hp2m hbij2m hp2m1 hinj2m1
        (hFin_all (2 * m)).2 (hFin_all (2 * m + 1)).2 hFin_coker_KR
    refine ⟨hFin_sp, hBd1_sp, ?_⟩
    rw [hEq_sp]
    exact hCard_coker_KR

theorem weil_proj_quadric_prime_pow_stage_val_ring_henselian_and_rank_one (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (φ_R_Ω : R_bar →+* Ω)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D_col : ℐ ⥤ CommRingCat.{u})
    (α_col : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D_col)
    (c_col : CategoryTheory.Limits.Cocone D_col) (hc_col : CategoryTheory.Limits.IsColimit c_col)
    (e_pt : c_col.pt ≅ CommRingCat.of R_bar)
    (ht_eq : p_R Polynomial.X = t_bar)
    (hπ_comp : π_cl.comp p_R = Polynomial.evalRingHom 0)
    (hφ_inj : Function.Injective φ_R_Ω)
    (hLoc_Ω : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra)
    (hCocone : ∀ i : ℐ,
      (α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
      Function.Injective ((c_col.ι.app i) ≫ e_pt.hom).hom)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D_col.obj i)) (u : (↑(D_col.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial k →+* ↑(D_col.obj i)),
        1 ≤ e ∧
        ((c_col.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α_col.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α_col.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D_col.obj i₁))
          (ψ₁ : Polynomial k →+* ↑(D_col.obj i₁)),
          (D_col.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α_col.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale) :
    (t_bar ≠ 0 ∧ t_bar ∈ IsLocalRing.maximalIdeal R_bar) ∧
    (Function.Surjective π_cl ∧
      RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar ∧
      ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)).base pt =
          IsLocalRing.closedPoint R_bar) ∧
    ((∀ P_id : Ideal R_bar, P_id.IsPrime →
        P_id = ⊥ ∨ P_id = IsLocalRing.maximalIdeal R_bar) ∧
      ∀ p : PrimeSpectrum R_bar, t_bar ∈ p.asIdeal → p = IsLocalRing.closedPoint R_bar) ∧
    (HenselianLocalRing R_bar ∧ IsAlgClosed (IsLocalRing.ResidueField R_bar)) ∧
    (AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)) ∧
      AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl))) :=
by
  let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
  have _ : IsLocalization.Away t_bar Ω := hLoc_Ω
  let ι : ∀ i : ℐ, ↑(D_col.obj i) →+* R_bar := fun i => ((c_col.ι.app i) ≫ e_pt.hom).hom

  
  have hι_t : ∀ i : ℐ, ι i ((α_col.app i).hom Polynomial.X) = t_bar := by
    intro i
    have h1 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hCocone i).1) Polynomial.X
    change ι i ((α_col.app i).hom Polynomial.X) = p_R Polynomial.X at h1
    exact h1.trans ht_eq
  have ht_unit_Ω : IsUnit (φ_R_Ω t_bar) :=
    IsLocalization.Away.algebraMap_isUnit (R := R_bar) (S := Ω) t_bar
  have ht_φ_ne : φ_R_Ω t_bar ≠ 0 := ht_unit_Ω.ne_zero
  have ht_ne : t_bar ≠ 0 := by
    intro h0
    apply ht_φ_ne
    rw [h0, map_zero]
  have ht_mem : t_bar ∈ IsLocalRing.maximalIdeal R_bar := by
    obtain ⟨i₀⟩ := @CategoryTheory.IsFiltered.nonempty ℐ _ _
    obtain ⟨ϖ, u, e, _, he, hϖ_mem, hX_eq, _⟩ := hStage i₀
    have ht_fac : t_bar = ι i₀ ↑u * (ι i₀ ϖ) ^ e := by
      rw [← hι_t i₀, hX_eq, map_mul, map_pow]
    have he_eq : e = (e - 1) + 1 := (Nat.sub_add_cancel he).symm
    rw [ht_fac, he_eq, pow_succ]
    exact (IsLocalRing.maximalIdeal R_bar).mul_mem_left _
      ((IsLocalRing.maximalIdeal R_bar).mul_mem_left _ hϖ_mem)

  
  have hSurj_π : Function.Surjective π_cl := by
    intro c
    refine ⟨p_R (Polynomial.C c), ?_⟩
    have h1 := DFunLike.congr_fun hπ_comp (Polynomial.C c)
    simpa [RingHom.comp_apply] using h1
  let e_k : (R_bar ⧸ RingHom.ker π_cl) ≃+* k := RingHom.quotientKerEquivOfSurjective hSurj_π
  have hField_quot : IsField (R_bar ⧸ RingHom.ker π_cl) :=
    MulEquiv.isField (Field.toIsField k) e_k.toMulEquiv
  have hMax_ker : (RingHom.ker π_cl).IsMaximal :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient (RingHom.ker π_cl)).mpr hField_quot
  have hKer_π : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar :=
    IsLocalRing.eq_maximalIdeal hMax_ker
  have hClosedPt_π : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)).base pt =
        IsLocalRing.closedPoint R_bar := by
    intro pt
    let pt' : PrimeSpectrum k := pt
    have hpt_bot : pt'.asIdeal = ⊥ := by
      rw [eq_bot_iff]
      intro c hc
      rw [Ideal.mem_bot]
      by_contra hc_ne
      apply pt'.isPrime.ne_top
      rw [Ideal.eq_top_iff_one, ← mul_inv_cancel₀ hc_ne]
      exact pt'.asIdeal.mul_mem_right c⁻¹ hc
    have hmap_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)).base pt =
        PrimeSpectrum.comap π_cl pt' := by
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    rw [hmap_pt]
    apply PrimeSpectrum.ext
    change Ideal.comap π_cl pt'.asIdeal = IsLocalRing.maximalIdeal R_bar
    rw [hpt_bot]
    exact hKer_π
  have hAlgCl_res : IsAlgClosed (IsLocalRing.ResidueField R_bar) := by
    let e_res : (R_bar ⧸ RingHom.ker (IsLocalRing.residue R_bar)) ≃+*
        IsLocalRing.ResidueField R_bar :=
      RingHom.quotientKerEquivOfSurjective IsLocalRing.residue_surjective
    have hKer_eq : RingHom.ker π_cl = RingHom.ker (IsLocalRing.residue R_bar) :=
      hKer_π.trans (IsLocalRing.ker_residue (R := R_bar)).symm
    let e_tot : k ≃+* IsLocalRing.ResidueField R_bar :=
      e_k.symm.trans ((Ideal.quotEquivOfEq hKer_eq).trans e_res)
    exact IsAlgClosed.of_ringEquiv k (IsLocalRing.ResidueField R_bar) e_tot
  have hOpen_φ : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)) :=
    @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R_bar Ω _ _ φ_R_Ω.toAlgebra t_bar hLoc_Ω
  have hClosed_π : AlgebraicGeometry.IsClosedImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)) :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_cl) hSurj_π

  
  have hι_map : ∀ {i j : ℐ} (θ : i ⟶ j) (y : ↑(D_col.obj i)),
      ι j ((D_col.map θ).hom y) = ι i y := by
    intro i j θ y
    have hw : (D_col.map θ ≫ c_col.ι.app j) ≫ e_pt.hom = c_col.ι.app i ≫ e_pt.hom :=
      congrArg (· ≫ e_pt.hom) (c_col.w θ)
    rw [CategoryTheory.Category.assoc] at hw
    exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hw) y
  have hLiftSingle : ∀ x : R_bar, ∃ (i : ℐ) (y : ↑(D_col.obj i)), ι i y = x := by
    intro x
    let F_fgt := CategoryTheory.forget CommRingCat.{u}
    have _ : CategoryTheory.Limits.PreservesFilteredColimits F_fgt :=
      CommRingCat.FilteredColimits.forget_preservesFilteredColimits
    have hc_set : CategoryTheory.Limits.IsColimit (F_fgt.mapCocone c_col) :=
      Classical.choice (CategoryTheory.Limits.PreservesColimit.preserves hc_col)
    obtain ⟨i, y, hy⟩ :=
      CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_set (e_pt.inv.hom x)
    refine ⟨i, y, ?_⟩
    change e_pt.hom.hom ((c_col.ι.app i).hom y) = x
    have hy' : (c_col.ι.app i).hom y = e_pt.inv.hom x := hy
    rw [hy']
    change (e_pt.inv ≫ e_pt.hom).hom x = x
    rw [e_pt.inv_hom_id]
    rfl
  have hLiftFin : ∀ (n : ℕ) (g : Fin n → R_bar),
      ∃ (i : ℐ) (g₀ : Fin n → ↑(D_col.obj i)), ∀ m : Fin n, ι i (g₀ m) = g m := by
    intro n
    induction n with
    | zero =>
      intro _
      obtain ⟨i₀⟩ := @CategoryTheory.IsFiltered.nonempty ℐ _ _
      exact ⟨i₀, Fin.elim0, fun m => Fin.elim0 m⟩
    | succ n ih =>
      intro g
      obtain ⟨i₁, y₀, hy₀⟩ := hLiftSingle (g 0)
      obtain ⟨i₂, g', hg'⟩ := ih (fun m => g m.succ)
      let k_m := CategoryTheory.IsFiltered.max i₁ i₂
      let θ₁ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
      let θ₂ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
      refine ⟨k_m, Fin.cases ((D_col.map θ₁).hom y₀) (fun m => (D_col.map θ₂).hom (g' m)), ?_⟩
      intro m
      refine Fin.cases ?_ ?_ m
      · dsimp
        rw [hι_map θ₁ y₀, hy₀]
      · intro m'
        dsimp
        rw [hι_map θ₂ (g' m'), hg' m']

  
  have hStageDVR : ∀ i : ℐ,
      let D_i := ↑(D_col.obj i)
      letI : IsDomain D_i := Function.Injective.isDomain (ι i) (hCocone i).2
      IsIntegrallyClosed D_i ∧ ∀ q : Ideal D_i, q.IsPrime → q ≠ ⊥ → q.IsMaximal := by
    intro i
    let D_i : Type u := ↑(D_col.obj i)
    let _ : IsDomain D_i := Function.Injective.isDomain (ι i) (hCocone i).2
    obtain ⟨_, _, _, ψ_i, _, _, _, _, _, hψ_et, _⟩ := hStage i
    let _ : Algebra (Polynomial k) D_i := ψ_i.toAlgebra
    have _ : Algebra.Etale (Polynomial k) D_i := hψ_et.toAlgebra
    have _ : Algebra.FinitePresentation (Polynomial k) D_i := Algebra.Etale.finitePresentation
    have _ : Algebra.FiniteType (Polynomial k) D_i := Algebra.FiniteType.of_finitePresentation
    have _ : IsNoetherianRing (Polynomial k) := Polynomial.isNoetherianRing
    have _ : IsNoetherianRing D_i := Algebra.FiniteType.isNoetherianRing (Polynomial k) D_i
    have hDVR_loc : ∀ (q : Ideal D_i) [q.IsPrime], q ≠ ⊥ →
        IsIntegrallyClosed (Localization.AtPrime q) ∧
        ∃! P : Ideal (Localization.AtPrime q), P ≠ ⊥ ∧ P.IsPrime := by
      intro q hq_p hq_ne
      let V := Localization.AtPrime q
      have _ : IsNoetherianRing V :=
        IsLocalization.isNoetherianRing q.primeCompl V ‹IsNoetherianRing D_i›
      let p : Ideal (Polynomial k) := Ideal.comap ψ_i q
      have _ : p.IsPrime := Ideal.IsPrime.comap ψ_i
      let R₀ := Localization.AtPrime p
      let φ_loc : R₀ →+* V := Localization.localRingHom p q ψ_i rfl
      let _ : Algebra R₀ V := φ_loc.toAlgebra
      have _ : IsScalarTower (Polynomial k) R₀ V :=
        IsScalarTower.of_algebraMap_eq fun r =>
          (Localization.localRingHom_to_map p q ψ_i rfl r).symm
      have _ : IsLocalHom (algebraMap R₀ V) := Localization.isLocalHom_localRingHom p q ψ_i rfl
      have _ : Algebra.FormallyUnramified R₀ V :=
        Algebra.FormallyUnramified.localization_base p.primeCompl
      have _ : Algebra.EssFiniteType R₀ V :=
        Algebra.EssFiniteType.of_comp (Polynomial k) R₀ V
      have hMapMax : Ideal.map (algebraMap R₀ V) (IsLocalRing.maximalIdeal R₀) =
          IsLocalRing.maximalIdeal V :=
        Algebra.FormallyUnramified.map_maximalIdeal (R := R₀) (S := V)
      obtain ⟨π₀, hπ₀⟩ := (IsPrincipalIdealRing.principal p).principal
      have hMaxR₀ : IsLocalRing.maximalIdeal R₀ =
          Ideal.span {algebraMap (Polynomial k) R₀ π₀} := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p R₀]
        have hp_span : p = Ideal.span {π₀} := hπ₀
        exact (congrArg (Ideal.map (algebraMap (Polynomial k) R₀)) hp_span).trans
          ((Ideal.map_span (algebraMap (Polynomial k) R₀) {π₀}).trans
            (by rw [Set.image_singleton]))
      have hPrin : Submodule.IsPrincipal (IsLocalRing.maximalIdeal V) := by
        refine ⟨⟨algebraMap R₀ V (algebraMap (Polynomial k) R₀ π₀), ?_⟩⟩
        change IsLocalRing.maximalIdeal V =
          Ideal.span {algebraMap R₀ V (algebraMap (Polynomial k) R₀ π₀)}
        rw [← hMapMax, hMaxR₀, Ideal.map_span, Set.image_singleton]
      have h_nzd : q.primeCompl ≤ nonZeroDivisors D_i := by
        intro s hs
        exact mem_nonZeroDivisors_of_ne_zero fun hs0 => hs (hs0 ▸ q.zero_mem)
      have hInj_V : Function.Injective (algebraMap D_i V) :=
        IsLocalization.injective V h_nzd
      obtain ⟨x, hx_q, hx_ne⟩ := (Submodule.ne_bot_iff q).mp hq_ne
      have hxV_ne : algebraMap D_i V x ≠ 0 := fun h0 =>
        hx_ne (hInj_V (h0.trans (map_zero _).symm))
      have hxV_mem : algebraMap D_i V x ∈ IsLocalRing.maximalIdeal V :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff V q x).mpr hx_q
      have hNotField : ¬ IsField V := by
        intro hF
        obtain ⟨y, hy⟩ := hF.mul_inv_cancel hxV_ne
        apply (IsLocalRing.maximalIdeal.isMaximal V).ne_top
        rw [Ideal.eq_top_iff_one, ← hy]
        exact (IsLocalRing.maximalIdeal V).mul_mem_right y hxV_mem
      exact ((IsDiscreteValuationRing.TFAE V hNotField).out 5 4).mp hPrin
    refine ⟨?_, ?_⟩
    · exact IsIntegrallyClosed.of_localization_maximal fun m hm_ne hm_max => by
        have _ : m.IsPrime := hm_max.isPrime
        exact (hDVR_loc m hm_ne).1
    · intro q hq_p hq_ne
      have _ : q.IsPrime := hq_p
      obtain ⟨m, hm_max, hq_le⟩ := Ideal.exists_le_maximal q hq_p.ne_top
      have _ : m.IsPrime := hm_max.isPrime
      have hm_ne : m ≠ ⊥ := fun hm0 => hq_ne (le_bot_iff.mp (hm0 ▸ hq_le))
      let V_m := Localization.AtPrime m
      have h_nzd : m.primeCompl ≤ nonZeroDivisors D_i := by
        intro s hs
        exact mem_nonZeroDivisors_of_ne_zero fun hs0 => hs (hs0 ▸ m.zero_mem)
      have hInj_Vm : Function.Injective (algebraMap D_i V_m) :=
        IsLocalization.injective V_m h_nzd
      have h_disj : Disjoint (m.primeCompl : Set D_i) (q : Set D_i) :=
        Set.disjoint_left.mpr fun z hz_mc hz_q => hz_mc (hq_le hz_q)
      let P_q : Ideal V_m := Ideal.map (algebraMap D_i V_m) q
      let M_V : Ideal V_m := IsLocalRing.maximalIdeal V_m
      obtain ⟨x, hx_q, hx_ne⟩ := (Submodule.ne_bot_iff q).mp hq_ne
      have hxVm_ne : algebraMap D_i V_m x ≠ 0 := fun h0 =>
        hx_ne (hInj_Vm (h0.trans (map_zero _).symm))
      have hPq_ne : P_q ≠ ⊥ := by
        intro h0
        apply hxVm_ne
        rw [← Ideal.mem_bot, ← h0]
        exact Ideal.mem_map_of_mem (algebraMap D_i V_m) hx_q
      have hPq_p : P_q.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint m.primeCompl V_m q hq_p h_disj
      have hMV_ne : M_V ≠ ⊥ := by
        intro h0
        apply hxVm_ne
        rw [← Ideal.mem_bot, ← h0]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff V_m m x).mpr (hq_le hx_q)
      have hMV_p : M_V.IsPrime := (IsLocalRing.maximalIdeal.isMaximal V_m).isPrime
      obtain ⟨_, _, hUniq⟩ := (hDVR_loc m hm_ne).2
      have hPq_eq_MV : P_q = M_V :=
        (hUniq P_q ⟨hPq_ne, hPq_p⟩).trans (hUniq M_V ⟨hMV_ne, hMV_p⟩).symm
      have hq_eq_m : q = m := by
        calc q
          _ = Ideal.under D_i P_q :=
              (IsLocalization.under_map_of_isPrime_disjoint m.primeCompl V_m hq_p h_disj).symm
          _ = Ideal.under D_i M_V := by rw [hPq_eq_MV]
          _ = m := IsLocalization.AtPrime.under_maximalIdeal V_m m
      rwa [hq_eq_m]

  
  have hMax_of_t_mem : ∀ P_id : Ideal R_bar, P_id.IsPrime →
      t_bar ∈ P_id → P_id = IsLocalRing.maximalIdeal R_bar := by
    intro P_id hP ht_P
    apply le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top)
    intro x hx_m
    obtain ⟨i, x₀, hx₀⟩ := hLiftSingle x
    obtain ⟨ϖ, u, e, _, he, _, hX_eq, _⟩ := hStage i
    let D_i : Type u := ↑(D_col.obj i)
    let q : Ideal D_i := Ideal.comap (ι i) P_id
    let m_i : Ideal D_i := Ideal.comap (ι i) (IsLocalRing.maximalIdeal R_bar)
    have hq_p : q.IsPrime := Ideal.IsPrime.comap (ι i)
    have hm_i_p : m_i.IsPrime := Ideal.IsPrime.comap (ι i)
    have hq_le : q ≤ m_i := Ideal.comap_mono (IsLocalRing.le_maximalIdeal hP.ne_top)
    have ht_q : ↑u * ϖ ^ e ∈ q := by
      change ι i (↑u * ϖ ^ e) ∈ P_id
      rw [← hX_eq, hι_t i]
      exact ht_P
    have hϖe_q : ϖ ^ e ∈ q := by
      have hmul := q.mul_mem_left (↑(u⁻¹) : D_i) ht_q
      rwa [← mul_assoc, Units.inv_mul, one_mul] at hmul
    have hϖ_q : ϖ ∈ q := hq_p.mem_of_pow_mem e hϖe_q
    have hϖ_ne : ϖ ≠ 0 := by
      intro h0
      apply ht_ne
      rw [← hι_t i, hX_eq, h0, zero_pow (by omega), mul_zero, map_zero]
    have hq_ne : q ≠ ⊥ := by
      intro h0
      apply hϖ_ne
      rw [← Ideal.mem_bot, ← h0]
      exact hϖ_q
    have hq_max : q.IsMaximal := (hStageDVR i).2 q hq_p hq_ne
    have hq_eq : q = m_i := Ideal.IsMaximal.eq_of_le hq_max hm_i_p.ne_top hq_le
    have hx₀_mi : x₀ ∈ m_i := by
      change ι i x₀ ∈ IsLocalRing.maximalIdeal R_bar
      rwa [hx₀]
    have hx₀_q : x₀ ∈ q := hq_eq.symm ▸ hx₀_mi
    rw [← hx₀]
    exact hx₀_q
  have hPrimeDichot : ∀ P_id : Ideal R_bar, P_id.IsPrime →
      P_id = ⊥ ∨ P_id = IsLocalRing.maximalIdeal R_bar := by
    intro P_id hP
    by_cases ht_P : t_bar ∈ P_id
    · exact Or.inr (hMax_of_t_mem P_id hP ht_P)
    · left
      rw [eq_bot_iff]
      intro x hx
      rw [Ideal.mem_bot]
      by_contra hx_ne
      have hx_φ_ne : φ_R_Ω x ≠ 0 := fun h0 => hx_ne (hφ_inj (h0.trans (map_zero _).symm))
      obtain ⟨n, r, hr⟩ :=
        IsLocalization.Away.surj (R := R_bar) (S := Ω) t_bar ((φ_R_Ω x)⁻¹)
      have hr' : (φ_R_Ω x)⁻¹ * (φ_R_Ω t_bar) ^ n = φ_R_Ω r := hr
      have htn_eq : φ_R_Ω (t_bar ^ n) = φ_R_Ω (x * r) := by
        calc φ_R_Ω (t_bar ^ n)
          _ = 1 * (φ_R_Ω t_bar) ^ n := by rw [one_mul, map_pow]
          _ = (φ_R_Ω x * (φ_R_Ω x)⁻¹) * (φ_R_Ω t_bar) ^ n := by rw [mul_inv_cancel₀ hx_φ_ne]
          _ = φ_R_Ω x * ((φ_R_Ω x)⁻¹ * (φ_R_Ω t_bar) ^ n) := by rw [mul_assoc]
          _ = φ_R_Ω x * φ_R_Ω r := by rw [hr']
          _ = φ_R_Ω (x * r) := (map_mul _ _ _).symm
      have htn_P : t_bar ^ n ∈ P_id := by
        rw [hφ_inj htn_eq]
        exact P_id.mul_mem_right r hx
      exact ht_P (hP.mem_of_pow_mem n htn_P)
  have hClosedPt_of_t : ∀ p : PrimeSpectrum R_bar,
      t_bar ∈ p.asIdeal → p = IsLocalRing.closedPoint R_bar := by
    intro p ht
    exact PrimeSpectrum.ext (hMax_of_t_mem p.asIdeal p.isPrime ht)

  
  have hRootDescent : ∀ (f : Polynomial R_bar), f.Monic →
      ∀ γ : Ω, (f.map φ_R_Ω).IsRoot γ → ∃ a : R_bar, f.IsRoot a := by
    intro f hf γ hγ
    let d := f.natDegree
    obtain ⟨N, r, hr⟩ := IsLocalization.Away.surj (R := R_bar) (S := Ω) t_bar γ
    obtain ⟨i, g₀, hg₀⟩ := hLiftFin (d + 1) (Fin.cons r (fun m : Fin d => f.coeff m.1))
    let D_i : Type u := ↑(D_col.obj i)
    let _ : IsDomain D_i := Function.Injective.isDomain (ι i) (hCocone i).2
    have _ : IsIntegrallyClosed D_i := (hStageDVR i).1
    let r₀ : D_i := g₀ 0
    let b : Fin d → D_i := fun m => g₀ m.succ
    have hr₀ : ι i r₀ = r := by simpa [r₀] using hg₀ 0
    have hb : ∀ m : Fin d, ι i (b m) = f.coeff m.1 := fun m => by
      simpa [b] using hg₀ m.succ
    let t_i : D_i := (α_col.app i).hom Polynomial.X
    have ht_i_ne : t_i ≠ 0 := by
      intro h0
      apply ht_ne
      rw [← hι_t i]
      change ι i t_i = 0
      rw [h0, map_zero]
    let K_i := FractionRing D_i
    let θ_i : D_i →+* Ω := φ_R_Ω.comp (ι i)
    have hθ_inj : Function.Injective θ_i := hφ_inj.comp (hCocone i).2
    let θ_tilde : K_i →+* Ω := IsFractionRing.lift (K := K_i) hθ_inj
    have hθ_alg : ∀ y : D_i, θ_tilde (algebraMap D_i K_i y) = φ_R_Ω (ι i y) :=
      IsFractionRing.lift_algebraMap hθ_inj
    have hti_K_ne : algebraMap D_i K_i t_i ≠ 0 := fun h0 =>
      ht_i_ne (IsFractionRing.injective D_i K_i (h0.trans (map_zero _).symm))
    let z : K_i := algebraMap D_i K_i r₀ * ((algebraMap D_i K_i t_i) ^ N)⁻¹
    have hz_θ : θ_tilde z = γ := by
      apply mul_right_cancel₀ (pow_ne_zero N ht_φ_ne)
      calc θ_tilde z * (φ_R_Ω t_bar) ^ N
        _ = θ_tilde z * (θ_tilde (algebraMap D_i K_i t_i)) ^ N := by
            rw [hθ_alg t_i, hι_t i]
        _ = θ_tilde (z * (algebraMap D_i K_i t_i) ^ N) := by
            rw [← map_pow, ← map_mul]
        _ = θ_tilde (algebraMap D_i K_i r₀) := by
            dsimp [z]
            rw [mul_assoc, inv_mul_cancel₀ (pow_ne_zero N hti_K_ne), mul_one]
        _ = φ_R_Ω r := by rw [hθ_alg r₀, hr₀]
        _ = γ * (φ_R_Ω t_bar) ^ N := hr.symm
    let p_low : Polynomial D_i := ∑ m : Fin d, Polynomial.monomial m.1 (b m)
    have hp_deg : p_low.degree < (d : WithBot ℕ) := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro k_deg hk_deg
      dsimp [p_low]
      rw [Polynomial.finsetSum_coeff]
      apply Finset.sum_eq_zero
      intro m _
      rw [Polynomial.coeff_monomial, ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
    let g : Polynomial D_i := Polynomial.X ^ d + p_low
    have hg_monic : g.Monic := Polynomial.monic_X_pow_add hp_deg
    have hg_map : g.map (ι i) = f := by
      ext k_deg
      dsimp [g, p_low]
      rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_X_pow,
        Polynomial.finsetSum_coeff]
      rcases lt_trichotomy k_deg d with hk_lt | rfl | hk_gt
      · rw [ite_eq_right_iff.mpr (fun h => absurd h (by omega)), zero_add, map_sum,
          Finset.sum_eq_single ⟨k_deg, hk_lt⟩]
        · simp [hb ⟨k_deg, hk_lt⟩]
        · intro m _ hm_ne
          have hm_val : m.1 ≠ k_deg := fun hv => hm_ne (Fin.ext hv)
          rw [Polynomial.coeff_monomial, ite_eq_right_iff.mpr (fun h => absurd h hm_val), map_zero]
        · intro h_abs
          exact absurd (Finset.mem_univ _) h_abs
      · rw [ite_eq_left_iff.mpr (fun h => absurd rfl h), Finset.sum_eq_zero]
        · rw [add_zero, map_one]
          exact hf.coeff_natDegree.symm
        · intro m _
          rw [Polynomial.coeff_monomial, ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
      · rw [ite_eq_right_iff.mpr (fun h => absurd h (by omega)), Finset.sum_eq_zero]
        · rw [add_zero, map_zero]
          exact (Polynomial.coeff_eq_zero_of_natDegree_lt hk_gt).symm
        · intro m _
          rw [Polynomial.coeff_monomial, ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
    have hz_eval : Polynomial.aeval z g = 0 := by
      apply RingHom.injective θ_tilde
      rw [map_zero, Polynomial.aeval_def, Polynomial.hom_eval₂, hz_θ]
      have h_comp : θ_tilde.comp (algebraMap D_i K_i) = φ_R_Ω.comp (ι i) :=
        RingHom.ext hθ_alg
      rw [h_comp, ← Polynomial.eval_map, ← Polynomial.map_map, hg_map]
      exact hγ.eq_zero
    have hz_int : IsIntegral D_i z := ⟨g, hg_monic, hz_eval⟩
    obtain ⟨y₀, hy₀⟩ := (IsIntegrallyClosed.isIntegral_iff (R := D_i) (K := K_i)).mp hz_int
    refine ⟨ι i y₀, ?_⟩
    rw [Polynomial.IsRoot.def]
    apply hφ_inj
    rw [map_zero, ← Polynomial.eval_map_apply, ← hθ_alg y₀, hy₀, hz_θ]
    exact hγ.eq_zero

  have hHenselInd : ∀ (d : ℕ) (f : Polynomial R_bar), f.Monic → f.natDegree = d →
      ∀ a₀ : R_bar, f.eval a₀ ∈ IsLocalRing.maximalIdeal R_bar →
      ∃ a : R_bar, f.IsRoot a ∧ a - a₀ ∈ IsLocalRing.maximalIdeal R_bar := by
    intro d
    induction d with
    | zero =>
      intro f hf hd a₀ hev
      exfalso
      have hf1 : f = 1 := Polynomial.eq_one_of_monic_natDegree_zero hf hd
      rw [hf1, Polynomial.eval_one] at hev
      exact (IsLocalRing.maximalIdeal.isMaximal R_bar).ne_top
        ((Ideal.eq_top_iff_one _).mpr hev)
    | succ d ih =>
      intro f hf hd a₀ hev
      have hf_map_monic : (f.map φ_R_Ω).Monic := hf.map φ_R_Ω
      have hf_map_deg : (f.map φ_R_Ω).natDegree = d + 1 := by
        rw [hf.natDegree_map φ_R_Ω, hd]
      have hf_deg_ne : (f.map φ_R_Ω).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hf_map_monic.ne_zero, hf_map_deg]
        exact fun h => Nat.succ_ne_zero d (WithBot.coe_eq_zero.mp h)
      obtain ⟨γ, hγ⟩ := IsAlgClosed.exists_root (f.map φ_R_Ω) hf_deg_ne
      obtain ⟨a₁, ha₁⟩ := hRootDescent f hf γ hγ
      obtain ⟨q, hfac⟩ := Polynomial.dvd_iff_isRoot.mpr ha₁
      have hX_monic : (Polynomial.X - Polynomial.C a₁).Monic := Polynomial.monic_X_sub_C a₁
      have hq_monic : q.Monic := by
        apply Polynomial.Monic.of_mul_monic_left hX_monic
        rwa [← hfac]
      have hq_deg : q.natDegree = d := by
        have hmul_deg := Polynomial.Monic.natDegree_mul hX_monic hq_monic
        rw [← hfac, hd, Polynomial.natDegree_X_sub_C] at hmul_deg
        omega
      have hev_prod : (a₀ - a₁) * q.eval a₀ ∈ IsLocalRing.maximalIdeal R_bar := by
        have hev' := hev
        rwa [hfac, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X,
          Polynomial.eval_C] at hev'
      rcases (IsLocalRing.maximalIdeal.isMaximal R_bar).isPrime.mem_or_mem hev_prod with h_left | h_right
      · refine ⟨a₁, ha₁, ?_⟩
        have hneg := (IsLocalRing.maximalIdeal R_bar).neg_mem h_left
        rwa [neg_sub] at hneg
      · obtain ⟨a, ha_q, ha_mem⟩ := ih q hq_monic hq_deg a₀ h_right
        refine ⟨a, ?_, ha_mem⟩
        rw [Polynomial.IsRoot.def, hfac, Polynomial.eval_mul, ha_q.eq_zero, mul_zero]

  have hHensel : HenselianLocalRing R_bar :=
    HenselianLocalRing.mk fun f hf a₀ hev _ => hHenselInd f.natDegree f hf rfl a₀ hev

  exact ⟨⟨ht_ne, ht_mem⟩, ⟨hSurj_π, hKer_π, hClosedPt_π⟩,
    ⟨hPrimeDichot, hClosedPt_of_t⟩, ⟨hHensel, hAlgCl_res⟩, ⟨hOpen_φ, hClosed_π⟩⟩

theorem weil_proj_quadric_prime_pow_exact_fiber_cellular_towers (K : Type u) [Field K] (m : ℕ) (t : K)
    (hAff_K : ∀ a : Fin (2 * m + 2 + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K (2 * m + 2) a))
    (c_K : ∀ a : Fin (2 * m + 2 + 1),
      K →+* ↑((weilProjectiveSpaceOver K (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K (2 * m + 2) a))))
    (t_K : ∀ a : Fin (2 * m + 2 + 1), Fin (2 * m + 2 + 1) →
      ↑((weilProjectiveSpaceOver K (2 * m + 2)).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K (2 * m + 2) a))))
    (θ_K : ∀ a : Fin (2 * m + 2 + 1),
