    rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
    rfl
  have hRepEval : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (g : weilPolyP1CohomologyRepSheaf Z V ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V G g =
        (g.hom.app (Opposite.op V)).hom
          (weilPolyP1CohomologyRepHomEquiv Z V _ (𝟙 (weilPolyP1CohomologyRepSheaf Z V))) := by
    intro Z V G g
    have h := hRepNatRight Z V (𝟙 _) g
    rwa [CategoryTheory.Category.id_comp] at h
  have hRepAdd : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (g₁ g₂ : weilPolyP1CohomologyRepSheaf Z V ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V G (g₁ + g₂) =
        weilPolyP1CohomologyRepHomEquiv Z V G g₁ +
          weilPolyP1CohomologyRepHomEquiv Z V G g₂ := by
    intro Z V G g₁ g₂
    rw [hRepEval Z V (g₁ + g₂), hRepEval Z V g₁, hRepEval Z V g₂]
    rfl
  have hRepNatLeft : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale} (w : V₁ ⟶ V₂)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (g : weilPolyP1CohomologyRepSheaf Z V₂ ⟶ G),
      let φ_w : weilPolyP1CohomologyRepSheaf Z V₁ ⟶ weilPolyP1CohomologyRepSheaf Z V₂ :=
