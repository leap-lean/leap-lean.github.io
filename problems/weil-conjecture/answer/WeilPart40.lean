      rw [AddMonoidHom.mem_ker] at hz
      obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ U₀ hSE_S2 z hz
      exact ⟨x, Subtype.ext hx⟩
    let e_I : CategoryTheory.Abelian.Ext.{u} U₀ I₀ 0 ≃+ ↥(AddMonoidHom.ker δ₀_0) :=
      AddEquiv.ofBijective i_ker hbij_iker
    let bdry₁ : CategoryTheory.Abelian.Ext.{u} U₀ I₀ 0 →+ CategoryTheory.Abelian.Ext.{u} U₀ R₀ 1 :=
      hSE_S1.extClass.postcomp U₀ (Nat.zero_add 1)
