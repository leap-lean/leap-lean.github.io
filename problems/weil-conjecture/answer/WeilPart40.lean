      have hPB_mid : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map π_A) (e_VZ.inv ≫ p₂) w₀_hom i_s := by
        rw [← he_VZ_p₁]
        have htop_iso : CategoryTheory.IsPullback
