        rfl
      have hπℤ_cancel : adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))
          (adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ) πℤ) =
          adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op :=
        (congrArg (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ)))
          ((adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).apply_symm_apply _)).trans
          ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).apply_symm_apply _)
      have h2 : (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op) ≫
          (Φ f).hom.app (Opposite.op (B.obj T₂)) =
          (adj₁.homEquiv Aℤ (C₁.obj A_m) (Φ f)) ≫ (C₁.obj A_m).obj.map τ.op :=
        (CategoryTheory.Category.assoc (adj₁.unit.app Aℤ)
          ((C₁.obj Aℤ).obj.map τ.op) ((Φ f).hom.app (Opposite.op (B.obj T₂)))).trans
          ((congrArg (adj₁.unit.app Aℤ ≫ ·) ((Φ f).hom.naturality τ.op)).trans
            ((CategoryTheory.Category.assoc (adj₁.unit.app Aℤ)
              ((Φ f).hom.app (Opposite.op T₁)) ((C₁.obj A_m).obj.map τ.op)).symm.trans
              (congrArg (· ≫ (C₁.obj A_m).obj.map τ.op)
                (CategoryTheory.Adjunction.homEquiv_unit adj₁ Aℤ (C₁.obj A_m) (Φ f)).symm)))
      exact h1.trans ((congrArg (· ≫ (Φ f).hom.app (Opposite.op (B.obj T₂))) hπℤ_cancel).trans h2)
    exact hLHS.symm.trans (h_step.trans hRHS)
  let ev₁ : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃ ↥M := fun M =>
    { toFun := fun φ => φ.hom (ULift.up 1)
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
      left_inv := fun φ => by
        apply AddCommGrpCat.ext
        intro ⟨n⟩
        change n • φ.hom (ULift.up 1) = φ.hom (ULift.up n)
        have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up 1 :=
          ULift.ext _ _ (mul_one n).symm
        rw [hn, map_zsmul]
      right_inv := fun m => one_zsmul m }
  have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have _ : CategoryTheory.Limits.PreservesFiniteLimits B :=
    CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
      (@AlgebraicGeometry.Etale) h
  have hBT₂ : CategoryTheory.Limits.IsTerminal (B.obj T₂) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂ hT₂
  let e_τ : B.obj T₂ ≅ T₁ := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hBT₂ hT₁
  have he_τ_hom : e_τ.hom = τ := hT₁.hom_ext e_τ.hom τ
  let E_τ : ↥((C₁.obj A_m).obj.obj (Opposite.op T₁)) ≃
      ↥((C₁.obj A_m).obj.obj (Opposite.op (B.obj T₂))) :=
    { toFun := ((C₁.obj A_m).obj.map τ.op).hom
      invFun := ((C₁.obj A_m).obj.map e_τ.inv.op).hom
      left_inv := fun s => by
        rw [← he_τ_hom]
        have hc : (C₁.obj A_m).obj.map e_τ.hom.op ≫ (C₁.obj A_m).obj.map e_τ.inv.op = 𝟙 _ := by
          rw [← (C₁.obj A_m).obj.map_comp, ← CategoryTheory.op_comp, e_τ.inv_hom_id,
            CategoryTheory.op_id, (C₁.obj A_m).obj.map_id]
        exact CategoryTheory.ConcreteCategory.congr_hom hc s
      right_inv := fun s => by
        rw [← he_τ_hom]
        have hc : (C₁.obj A_m).obj.map e_τ.inv.op ≫ (C₁.obj A_m).obj.map e_τ.hom.op = 𝟙 _ := by
          rw [← (C₁.obj A_m).obj.map_comp, ← CategoryTheory.op_comp, e_τ.hom_inv_id,
            CategoryTheory.op_id, (C₁.obj A_m).obj.map_id]
