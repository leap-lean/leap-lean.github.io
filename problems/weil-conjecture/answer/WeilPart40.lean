      have h2 : weilPolyP1CohomologyRepHomEquiv Z T Fℤ_Z c_Z =
          (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
        (weilPolyP1CohomologyRepHomEquiv Z T Fℤ_Z).apply_symm_apply _
      rw [h2]
      have h3 := congrArg (fun k : Aℤ ⟶ R_T.obj.obj (Opposite.op T) => k.hom (ULift.up (1 : ℤ))) hψ_unit
      exact h3.trans (one_zsmul ι_T)
    have hψc : ψ ≫ c_Z = 𝟙 Fℤ_Z := by
      apply (adj_c.homEquiv Aℤ Fℤ_Z).injective
      rw [adj_c.homEquiv_naturality_right ψ c_Z, (adj_c.homEquiv Aℤ R_T).apply_symm_apply g_T]
      have hid : (adj_c.homEquiv Aℤ Fℤ_Z) (𝟙 Fℤ_Z) = adj_c.unit.app Aℤ := by
        rw [adj_c.homEquiv_unit, CategoryTheory.Functor.map_id]
        exact CategoryTheory.Category.comp_id (adj_c.unit.app Aℤ)
      rw [hid]
      apply AddCommGrpCat.ext
      intro n
      change (c_Z.hom.app (Opposite.op T)).hom (n.down • ι_T) = (adj_c.unit.app Aℤ).hom n
      rw [map_zsmul, hc_eval, ← map_zsmul (adj_c.unit.app Aℤ).hom n.down (ULift.up (1 : ℤ)),
        ← hULift1 n]
    let inv_term := (CategoryTheory.Abelian.Ext.mk₀ ψ).precomp ℰ (Nat.zero_add q)
    refine Function.bijective_iff_has_inverse.mpr
      ⟨inv_term, fun x => ?_, fun (y : CategoryTheory.Abelian.Ext R_T ℰ q) => ?_⟩
    · change (CategoryTheory.Abelian.Ext.mk₀ ψ).comp
        ((CategoryTheory.Abelian.Ext.mk₀ c_Z).comp x (Nat.zero_add q)) (Nat.zero_add q) = x
      rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ψ)
          (CategoryTheory.Abelian.Ext.mk₀ c_Z) x (Nat.add_zero 0) (Nat.zero_add q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hψc]
      exact CategoryTheory.Abelian.Ext.mk₀_id_comp x
    · change (CategoryTheory.Abelian.Ext.mk₀ c_Z).comp
        ((CategoryTheory.Abelian.Ext.mk₀ ψ).comp y (Nat.zero_add q)) (Nat.zero_add q) = y
      rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ c_Z)
          (CategoryTheory.Abelian.Ext.mk₀ ψ) y (Nat.add_zero 0) (Nat.zero_add q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcψ]
      exact CategoryTheory.Abelian.Ext.mk₀_id_comp y

  let adj_cS := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
  let u₁_S : ↑(Fℤ_S.obj.obj (Opposite.op T_S)) := (adj_cS.unit.app Aℤ).hom (ULift.up (1 : ℤ))
  let homToSec_S : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (Fℤ_S ⟶ 𝒢) ≃+ ↑(𝒢.obj.obj (Opposite.op T_S)) := fun 𝒢 =>
    { toFun := fun g => (g.hom.app (Opposite.op T_S)).hom u₁_S
      invFun := fun s => (adj_cS.homEquiv Aℤ 𝒢).symm (AddCommGrpCat.ofHom
        { toFun := fun n => n.down • s
          map_zero' := zero_zsmul s
          map_add' := fun a b => add_zsmul s a.down b.down })
      left_inv := fun g => by
        apply (adj_cS.homEquiv Aℤ 𝒢).injective
        rw [(adj_cS.homEquiv Aℤ 𝒢).apply_symm_apply, adj_cS.homEquiv_unit]
        apply AddCommGrpCat.ext
        intro n
        change n.down • (g.hom.app (Opposite.op T_S)).hom u₁_S =
          (g.hom.app (Opposite.op T_S)).hom ((adj_cS.unit.app Aℤ).hom n)
        rw [← map_zsmul (g.hom.app (Opposite.op T_S)).hom,
          ← map_zsmul (adj_cS.unit.app Aℤ).hom, ← hULift1 n]
      right_inv := fun s => by
        have h1 := adj_cS.homEquiv_unit Aℤ 𝒢
          ((adj_cS.homEquiv Aℤ 𝒢).symm (AddCommGrpCat.ofHom
            { toFun := fun n => n.down • s
              map_zero' := zero_zsmul s
              map_add' := fun a b => add_zsmul s a.down b.down }))
        have h2 := h1.symm.trans ((adj_cS.homEquiv Aℤ 𝒢).apply_symm_apply _)
        have h3 := congrArg (fun k : Aℤ ⟶ 𝒢.obj.obj (Opposite.op T_S) => k.hom (ULift.up (1 : ℤ))) h2
        exact h3.trans (one_zsmul s)
      map_add' := fun _ _ => rfl }
  let eval_S : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      𝒢.H 0 ≃+ ↑(𝒢.obj.obj (Opposite.op T_S)) :=
    fun 𝒢 => CategoryTheory.Abelian.Ext.addEquiv₀.trans (homToSec_S 𝒢)
  have heval_nat : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : 𝒢₁ ⟶ 𝒢₂) (x : 𝒢₁.H 0),
      eval_S 𝒢₂ ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp Fℤ_S (Nat.add_zero 0) x) =
        (ψ.hom.app (Opposite.op T_S)).hom (eval_S 𝒢₁ x) := by
    intro 𝒢₁ 𝒢₂ ψ x
    obtain ⟨g, rfl⟩ := CategoryTheory.Abelian.Ext.addEquiv₀.symm.surjective x
    rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    change homToSec_S 𝒢₂ (CategoryTheory.Abelian.Ext.addEquiv₀
        ((CategoryTheory.Abelian.Ext.mk₀ g).comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero 0))) =
      (ψ.hom.app (Opposite.op T_S)).hom (homToSec_S 𝒢₁ (CategoryTheory.Abelian.Ext.addEquiv₀
        (CategoryTheory.Abelian.Ext.mk₀ g)))
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_ae_mk₀, h_ae_mk₀]
    rfl

  have hBij_edge0 : ∀ (ℰ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      Function.Bijective (weilOuterTrFibEdgeHom f T_S hT_X ℰ 0) := by
    intro ℰ
    let B_f := weilEtaleSitePullback f
    let shAdj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    let S_S := CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}
    let shf_S := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    let P_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_f AddCommGrpCat.{u} _ S.smallEtaleTopology X.smallEtaleTopology hCont_f
    let repAddEquiv : ∀ V : X.Etale,
        (weilPolyP1CohomologyRepSheaf X V ⟶ ℰ) ≃+ ↑(ℰ.obj.obj (Opposite.op V)) :=
      fun V =>
        { toEquiv := weilPolyP1CohomologyRepHomEquiv X V ℰ
          map_add' := hRepAdd X V ℰ }
    let compIso : ∀ W : Opposite X.Etale,
        (CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0).obj W ≅ ℰ.obj.obj W :=
      fun W =>
        (CategoryTheory.Abelian.Ext.addEquiv₀.trans (repAddEquiv W.unop)).toAddCommGrpIso
    have hcomp_nat : ∀ {W₁ W₂ : Opposite X.Etale} (ω : W₁ ⟶ W₂),
        (CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0).map ω ≫ (compIso W₂).hom =
          (compIso W₁).hom ≫ ℰ.obj.map ω := by
      intro W₁ W₂ ω
      let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
        (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
      let Z_fun : CategoryTheory.Functor X.Etale
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
        CategoryTheory.yoneda ⋙ Free_PSh ⋙
          CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}
      have hmap : (CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0).map ω =
          ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app ℰ := rfl
      rw [hmap, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) ℰ]
      apply AddCommGrpCat.ext
      intro α
      obtain ⟨g, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective _ ℰ).2 α
      change repAddEquiv W₂.unop (CategoryTheory.Abelian.Ext.addEquiv₀
        ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp
          (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.zero_add 0))) =
        (ℰ.obj.map (Opposite.op ω.unop)).hom
          (repAddEquiv W₁.unop (CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g)))
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_ae_mk₀, h_ae_mk₀]
      exact hRepNatLeft X ω.unop ℰ g
    let iso₀ : CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0 ≅ ℰ.obj :=
      CategoryTheory.NatIso.ofComponents compIso @hcomp_nat
    let e_P : (B_f.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0) ≅ S_S.obj (P_f.obj ℰ) :=
      CategoryTheory.Functor.isoWhiskerLeft B_f.op iso₀
    have _ : CategoryTheory.IsIso shAdj_S.counit := CategoryTheory.sheafification_reflective
    have _ : CategoryTheory.IsIso (shAdj_S.counit.app (P_f.obj ℰ)) := inferInstance
    let v_counit := S_S.map (shAdj_S.counit.app (P_f.obj ℰ))
    have _ : CategoryTheory.IsIso v_counit := inferInstance
    have h_tri : shAdj_S.unit.app (S_S.obj (P_f.obj ℰ)) ≫ v_counit = 𝟙 _ :=
      shAdj_S.right_triangle_components (P_f.obj ℰ)
    have hu_eq_inv : shAdj_S.unit.app (S_S.obj (P_f.obj ℰ)) = CategoryTheory.inv v_counit := by
      calc shAdj_S.unit.app (S_S.obj (P_f.obj ℰ))
        _ = shAdj_S.unit.app (S_S.obj (P_f.obj ℰ)) ≫ 𝟙 _ := (CategoryTheory.Category.comp_id _).symm
        _ = shAdj_S.unit.app (S_S.obj (P_f.obj ℰ)) ≫ (v_counit ≫ CategoryTheory.inv v_counit) := by
            rw [CategoryTheory.IsIso.hom_inv_id]
        _ = (shAdj_S.unit.app (S_S.obj (P_f.obj ℰ)) ≫ v_counit) ≫ CategoryTheory.inv v_counit := by
            rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.inv v_counit := by rw [h_tri, CategoryTheory.Category.id_comp]
    have _ : CategoryTheory.IsIso (shAdj_S.unit.app (S_S.obj (P_f.obj ℰ))) := by
      rw [hu_eq_inv]; infer_instance
    let w_map := S_S.map (shf_S.map e_P.hom)
    have _ : CategoryTheory.IsIso w_map := inferInstance
    have h_nat' : shAdj_S.unit.app (B_f.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0) ≫ w_map =
        e_P.hom ≫ shAdj_S.unit.app (S_S.obj (P_f.obj ℰ)) :=
      (shAdj_S.unit.naturality e_P.hom).symm
    have h_unit_eq : shAdj_S.unit.app (B_f.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0) =
        (e_P.hom ≫ shAdj_S.unit.app (S_S.obj (P_f.obj ℰ))) ≫ CategoryTheory.inv w_map := by
      calc shAdj_S.unit.app (B_f.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0)
        _ = shAdj_S.unit.app _ ≫ 𝟙 _ := (CategoryTheory.Category.comp_id _).symm
        _ = shAdj_S.unit.app _ ≫ (w_map ≫ CategoryTheory.inv w_map) := by
            rw [CategoryTheory.IsIso.hom_inv_id]
        _ = (shAdj_S.unit.app _ ≫ w_map) ≫ CategoryTheory.inv w_map := by
            rw [CategoryTheory.Category.assoc]
        _ = (e_P.hom ≫ shAdj_S.unit.app (S_S.obj (P_f.obj ℰ))) ≫ CategoryTheory.inv w_map := by
            rw [h_nat']
    have _ : CategoryTheory.IsIso
        (shAdj_S.unit.app (B_f.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0)) := by
      rw [h_unit_eq]; infer_instance
    let u_TS := (shAdj_S.unit.app (B_f.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ 0)).app
      (Opposite.op T_S)
    have _ : CategoryTheory.IsIso u_TS := inferInstance
    have hBij_unit_TS : Function.Bijective u_TS.hom :=
      Function.bijective_iff_has_inverse.mpr
        ⟨(CategoryTheory.inv u_TS).hom,
         fun x => congrArg (fun k => AddCommGrpCat.Hom.hom k x) (CategoryTheory.IsIso.hom_inv_id u_TS),
         fun y => congrArg (fun k => AddCommGrpCat.Hom.hom k y) (CategoryTheory.IsIso.inv_hom_id u_TS)⟩
    exact hBij_unit_TS.comp (hBij_term X (B_f.obj T_S) hT_X ℰ 0)

  have hSheafifyNat : ∀ {P₁ P₂ : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}}
      (α : P₁ ⟶ P₂)
      (y : ↑(P₁.obj (Opposite.op ((weilEtaleSitePullback f).obj T_S)))),
      ((((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op α)).hom.app
          (Opposite.op T_S)).hom)
        ((((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((weilEtaleSitePullback f).op ⋙ P₁)).app (Opposite.op T_S)).hom y) =
      ((((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((weilEtaleSitePullback f).op ⋙ P₂)).app (Opposite.op T_S)).hom)
        ((α.app (Opposite.op ((weilEtaleSitePullback f).obj T_S))).hom y) := by
    intro P₁ P₂ α y
    have hnat := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      AddCommGrpCat.{u}).unit.naturality
      (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op α)
    exact congrArg (fun τ : _ ⟶ _ => (τ.app (Opposite.op T_S)).hom y) hnat.symm

  have hNat_hom0 : ∀ {ℰ₁ ℰ₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : ℰ₁ ⟶ ℰ₂) (x : ℰ₁.H 0),
      ((weilEtaleHigherDirectImageMap f 0 φ).hom.app (Opposite.op T_S)).hom
          (weilOuterTrFibEdgeHom f T_S hT_X ℰ₁ 0 x) =
        weilOuterTrFibEdgeHom f T_S hT_X ℰ₂ 0
          ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_X (Nat.add_zero 0) x) := by
    intro ℰ₁ ℰ₂ φ x
    dsimp only [weilOuterTrFibEdgeHom, weilEtaleHigherDirectImageMap, AddMonoidHom.comp_apply]
    refine (hSheafifyNat
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology 0).map φ) _).trans ?_
    exact congrArg
      ((((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        ((weilEtaleSitePullback f).op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ₂ 0)).app
        (Opposite.op T_S)).hom)
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀
          (weilPolyP1CohomologyRepToConst X ((weilEtaleSitePullback f).obj T_S) hT_X))
        x (CategoryTheory.Abelian.Ext.mk₀ φ)
        (Nat.zero_add 0) (Nat.add_zero 0) (Nat.zero_add 0))

  have hNat_conn : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ) (z : SC.X₃.H q),
      ((weilSingDevAlgBCConnHom f SC hSE q).hom.app (Opposite.op T_S)).hom
          (weilOuterTrFibEdgeHom f T_S hT_X SC.X₃ q z) =
        weilOuterTrFibEdgeHom f T_S hT_X SC.X₁ (q + 1)
          (hSE.extClass.postcomp Fℤ_X rfl z) := by
    intro SC hSE q z
    dsimp only [weilOuterTrFibEdgeHom, weilSingDevAlgBCConnHom, AddMonoidHom.comp_apply]
    refine (hSheafifyNat _ _).trans ?_
    exact congrArg
      ((((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        ((weilEtaleSitePullback f).op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1))).app
        (Opposite.op T_S)).hom)
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀
          (weilPolyP1CohomologyRepToConst X ((weilEtaleSitePullback f).obj T_S) hT_X))
        z hSE.extClass
        (Nat.zero_add q) rfl (Nat.zero_add (q + 1)))

  
  have hTor_R : ∀ (ℰ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      M • CategoryTheory.CategoryStruct.id ℰ = 0 →
      ∀ (q : ℕ), M • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f q ℰ) = 0 := by
    intro ℰ hE q
    have hExt_tor : ∀ (V : X.Etale)
        (z : CategoryTheory.Abelian.Ext.{u} (weilPolyP1CohomologyRepSheaf X V) ℰ q),
        M • z = 0 := by
      intro V z
      have hz1 : z = (z.precomp ℰ (Nat.add_zero q))
          (CategoryTheory.Abelian.Ext.addEquiv₀.symm (𝟙 ℰ)) := by
        rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
      rw [hz1, ← map_nsmul, ← map_nsmul, hE, map_zero, map_zero]
    let P := (weilEtaleSitePullback f).op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf ℰ q
    have hnsmul_app : ∀ (n : ℕ) (W : Opposite S.Etale) (z : ↑(P.obj W)),
        ((n • CategoryTheory.CategoryStruct.id P).app W).hom z = n • z := by
      intro n W z
      induction n with
      | zero => rw [zero_nsmul, zero_nsmul]; rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul]
        exact congrArg (· + z) ih
    have hP : M • CategoryTheory.CategoryStruct.id P = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.ext
      intro z
      rw [hnsmul_app M W z]
      exact hExt_tor ((weilEtaleSitePullback f).obj W.unop) z
    let shf_S := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have hmap := CategoryTheory.Functor.map_nsmul shf_S
      (f := CategoryTheory.CategoryStruct.id P) (n := M)
    rw [CategoryTheory.Functor.map_id] at hmap
    change M • CategoryTheory.CategoryStruct.id (shf_S.obj P) = 0
    rw [← hmap, hP, CategoryTheory.Functor.map_zero]

  have hEquivOfSameKer : ∀ {G H₁ H₂ : Type u} [AddCommGroup G] [AddCommGroup H₁] [AddCommGroup H₂]
      (f₁ : G →+ H₁) (f₂ : G →+ H₂),
      Function.Surjective f₁ → Function.Surjective f₂ →
      (∀ g : G, f₁ g = 0 ↔ f₂ g = 0) → Nonempty (H₁ ≃+ H₂) := by
    intro G H₁ H₂ _ _ _ f₁ f₂ hf₁ hf₂ hiff
    let e₁ := QuotientAddGroup.quotientKerEquivOfSurjective f₁ hf₁
    let L : G ⧸ f₁.ker →+ H₂ :=
      QuotientAddGroup.lift f₁.ker f₂ (fun g hg => (hiff g).mp hg)
    have hinj_L : Function.Injective L := by
      apply (AddMonoidHom.ker_eq_bot_iff L).mp
      rw [eq_bot_iff]
      intro x hx
      rw [AddMonoidHom.mem_ker] at hx
      obtain ⟨g, rfl⟩ := QuotientAddGroup.mk'_surjective f₁.ker x
      have hg2 : f₂ g = 0 := hx
      have hg1 : g ∈ f₁.ker := (hiff g).mpr hg2
      have hmk0 : (QuotientAddGroup.mk' f₁.ker) g = 0 := (QuotientAddGroup.eq_zero_iff g).mpr hg1
      rw [hmk0]
      exact AddSubgroup.zero_mem ⊥
    have hsurj_L : Function.Surjective L := by
      intro y
      obtain ⟨g, rfl⟩ := hf₂ y
      exact ⟨QuotientAddGroup.mk' f₁.ker g, rfl⟩
    exact ⟨e₁.symm.trans (AddEquiv.ofBijective L ⟨hinj_L, hsurj_L⟩)⟩

  have hMain : ∀ (q : ℕ) (ℱ₀ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      M • CategoryTheory.CategoryStruct.id ℱ₀ = 0 →
      let e := weilOuterTrFibEdgeHom f T_S hT_X ℱ₀ (q + 1)
      Function.Surjective e ∧
      Nonempty (↥(AddMonoidHom.ker e) ≃+ (weilEtaleHigherDirectImage f q ℱ₀).H 1) := by
    intro q
    induction q with
    | zero =>
      intro ℱ₀ hTor₀
      let _ : G₀.Additive := hAdd_G₀
      let A := G₀.obj ℱ₀
      let u : ℱ₀ ⟶ A := η₀.app ℱ₀
      have _ : CategoryTheory.Mono u := hMono_η₀ ℱ₀
      let 𝒬 := CategoryTheory.Limits.cokernel u
      let v : A ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π u
      let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
      have hSE : SC.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel u
          mono_f := hMono_η₀ ℱ₀
          epi_g := inferInstance }
      have hTor_A : M • CategoryTheory.CategoryStruct.id A = 0 := by
        have hm := G₀.map_nsmul (f := CategoryTheory.CategoryStruct.id ℱ₀) (n := M)
        rw [G₀.map_id] at hm
        change M • CategoryTheory.CategoryStruct.id (G₀.obj ℱ₀) = 0
        rw [← hm, hTor₀, G₀.map_zero]
