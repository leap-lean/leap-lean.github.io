              ((pf_j.obj Λ_U).obj.map g₂.op).hom (((pf_j.obj Λ_U).obj.map u₂.op).hom t) := by
            have hc1 : (pf_j.obj Λ_U).obj.map (u₁.op ≫ g₁.op) =
                (pf_j.obj Λ_U).obj.map u₁.op ≫ (pf_j.obj Λ_U).obj.map g₁.op :=
              (pf_j.obj Λ_U).obj.map_comp u₁.op g₁.op
            have hc2 : (pf_j.obj Λ_U).obj.map (u₂.op ≫ g₂.op) =
                (pf_j.obj Λ_U).obj.map u₂.op ≫ (pf_j.obj Λ_U).obj.map g₂.op :=
              (pf_j.obj Λ_U).obj.map_comp u₂.op g₂.op
            have hop : u₁.op ≫ g₁.op = u₂.op ≫ g₂.op := by
              rw [← CategoryTheory.op_comp, ← CategoryTheory.op_comp, hg]
            exact (CategoryTheory.ConcreteCategory.congr_hom hc1 t).symm.trans
              ((CategoryTheory.ConcreteCategory.congr_hom
                (congrArg (pf_j.obj Λ_U).obj.map hop) t).trans
                (CategoryTheory.ConcreteCategory.congr_hom hc2 t))
          exact h1.trans
            ((congrArg ((pf_j.obj Λ_U).obj.map g₁.op).hom (hfam_spec u₁ hu₁)).trans
              (hmap_eq.trans
                ((congrArg ((pf_j.obj Λ_U).obj.map g₂.op).hom (hfam_spec u₂ hu₂)).symm.trans h2.symm)))
        let φ := hShX.amalgamate fam hcompat
        refine ⟨φ.hom (ULift.up 1), ?_⟩
        have h_res : toHom ((η_j.hom.app (Opposite.op Y)).hom (φ.hom (ULift.up 1))) = toHom t := by
          refine hShU.isSeparatedFor.ext fun Z u hu => ?_
          change toHom ((η_j.hom.app (Opposite.op Y)).hom (φ.hom (ULift.up 1))) ≫
              (pf_j.obj Λ_U).obj.map u.op =
            toHom t ≫ (pf_j.obj Λ_U).obj.map u.op
          rw [h_comp, h_comp]
          have hglue := hShX.valid_glue hcompat u hu
          change φ ≫ Λ_X.obj.map u.op = fam u hu at hglue
          rw [← h_eval φ, h_comp] at hglue
          have hs_eq : (Λ_X.obj.map u.op).hom (φ.hom (ULift.up 1)) =
              Classical.choose ((hu (𝟙 Z)).2 (((pf_j.obj Λ_U).obj.map u.op) t)) := by
            calc (Λ_X.obj.map u.op).hom (φ.hom (ULift.up 1))
                = (toHom ((Λ_X.obj.map u.op).hom (φ.hom (ULift.up 1)))).hom (ULift.up 1) :=
                    (h_apply _).symm
              _ = (fam u hu).hom (ULift.up 1) := by rw [hglue]
              _ = _ := h_apply _
          have hnat := CategoryTheory.ConcreteCategory.congr_hom
            (η_j.hom.naturality u.op) (φ.hom (ULift.up 1))
          dsimp at hnat
          congr 1
          exact hnat.symm.trans
            ((congrArg (η_j.hom.app (Opposite.op Z)).hom hs_eq).trans (hfam_spec u hu))
        calc (η_j.hom.app (Opposite.op Y)) (φ.hom (ULift.up 1))
            = (toHom ((η_j.hom.app (Opposite.op Y)).hom (φ.hom (ULift.up 1)))).hom (ULift.up 1) :=
                (h_apply _).symm
          _ = (toHom t).hom (ULift.up 1) := by rw [h_res]
          _ = t := h_apply t
    let e_app : ∀ U : (X.Etale)ᵒᵖ,
        ↥(Λ_X.obj.obj U) ≃+ ↥((pf_j.obj Λ_U).obj.obj U) :=
      fun U => AddEquiv.ofBijective (η_j.hom.app U).hom (hBij U.unop)
    let inv_pre : (pf_j.obj Λ_U).obj ⟶ Λ_X.obj :=
      { app := fun U => AddCommGrpCat.ofHom (e_app U).symm.toAddMonoidHom
        naturality := fun {U₁ U₂} f => by
          apply AddCommGrpCat.ext
          intro y
          apply (e_app U₂).injective
          change (η_j.hom.app U₂).hom ((e_app U₂).symm (((pf_j.obj Λ_U).obj.map f).hom y)) =
            (η_j.hom.app U₂).hom ((Λ_X.obj.map f).hom ((e_app U₁).symm y))
          have h_lhs : (η_j.hom.app U₂).hom ((e_app U₂).symm (((pf_j.obj Λ_U).obj.map f).hom y)) =
              ((pf_j.obj Λ_U).obj.map f).hom y :=
            (e_app U₂).apply_symm_apply _
          have hnat := CategoryTheory.ConcreteCategory.congr_hom
            (η_j.hom.naturality f) ((e_app U₁).symm y)
          dsimp at hnat
          have h_app_symm : (η_j.hom.app U₁).hom ((e_app U₁).symm y) = y :=
            (e_app U₁).apply_symm_apply y
          have h_rhs : (η_j.hom.app U₂).hom ((Λ_X.obj.map f).hom ((e_app U₁).symm y)) =
              ((pf_j.obj Λ_U).obj.map f).hom y :=
            hnat.trans (congrArg ((pf_j.obj Λ_U).obj.map f).hom h_app_symm)
          exact h_lhs.trans h_rhs.symm }
    exact ⟨⟨{ hom := inv_pre },
      CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U =>
        AddCommGrpCat.ext fun x => (e_app U).symm_apply_apply x)),
      CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U =>
        AddCommGrpCat.ext fun y => (e_app U).apply_symm_apply y))⟩⟩

theorem weil_leray_five_term_const_pullback_and_edge_bridge {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
    (hCont_j : (weilEtaleSitePullback j).IsContinuous
      X.smallEtaleTopology X_U.smallEtaleTopology)
    (hAdj_j : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).IsRightAdjoint)
    (T_U : X_U.Etale) (hT_U : CategoryTheory.Limits.IsTerminal T_U)
    (T_X : X.Etale) (hT_X : CategoryTheory.Limits.IsTerminal T_X)
    [(@CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j).Additive]
    [CategoryTheory.Limits.PreservesFiniteLimits
      (@CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback j) AddCommGrpCat.{u} _
        X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j)]
    [CategoryTheory.Limits.PreservesFiniteColimits
      (@CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback j) AddCommGrpCat.{u} _
        X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j)] :
    let pf_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j
    let pb_j := @CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
    let adj_j := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
    let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let C_U := CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_X := C_X.obj Aℤ
    let Fℤ_U := C_U.obj Aℤ
    ((∀ A : AddCommGrpCat.{u},
        CategoryTheory.IsIso
          (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A)) ∧
      (∀ {A₁ A₂ : AddCommGrpCat.{u}} (c : A₁ ⟶ A₂),
        let η₁ := (adj_j.homEquiv (C_X.obj A₁) (C_U.obj A₁))
          (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A₁)
        let η₂ := (adj_j.homEquiv (C_X.obj A₂) (C_U.obj A₂))
          (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A₂)
        C_X.map c ≫ η₂ = η₁ ≫ pf_j.map (C_U.map c))) ∧
    (∃ (ιℤ : Fℤ_U ⟶ pb_j.obj Fℤ_X)
        (edge : ∀ (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
          (pf_j.obj F).H q →+ F.H q),
      ιℤ ≫ @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X Aℤ = 𝟙 Fℤ_U ∧
      @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X Aℤ ≫ ιℤ =
        𝟙 (pb_j.obj Fℤ_X) ∧
      (∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
        Function.Bijective (edge F 0)) ∧
      (∀ {F₁ F₂ : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : F₁ ⟶ F₂) (q : ℕ) (w : (pf_j.obj F₁).H q),
        edge F₂ q
          ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map ψ)).postcomp Fℤ_X (Nat.add_zero q) w) =
          (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp Fℤ_U (Nat.add_zero q) (edge F₁ q w)) ∧
      (∀ (SC_X : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE_X : SC_X.ShortExact)
          (SC_U : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE_U : SC_U.ShortExact)
          (f₁ : SC_X.X₁ ⟶ pf_j.obj SC_U.X₁)
          (f₂ : SC_X.X₂ ⟶ pf_j.obj SC_U.X₂)
          (f₃ : SC_X.X₃ ⟶ pf_j.obj SC_U.X₃),
        SC_X.f ≫ f₂ = f₁ ≫ pf_j.map SC_U.f →
        SC_X.g ≫ f₃ = f₂ ≫ pf_j.map SC_U.g →
        ∀ (k : ℕ) (w : SC_X.X₃.H k),
          edge SC_U.X₁ (k + 1)
            ((CategoryTheory.Abelian.Ext.mk₀ f₁).postcomp Fℤ_X (Nat.add_zero (k + 1))
              ((hSE_X.extClass.postcomp Fℤ_X (rfl : k + 1 = k + 1)) w)) =
          (hSE_U.extClass.postcomp Fℤ_U (rfl : k + 1 = k + 1))
            (edge SC_U.X₃ k
              ((CategoryTheory.Abelian.Ext.mk₀ f₃).postcomp Fℤ_X (Nat.add_zero k) w))) ∧
      (∀ (m q : ℕ),
        let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
        let π_m := @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A_m
        let η_m := (adj_j.homEquiv (weilEtaleTorsionSheaf X m) (weilEtaleTorsionSheaf X_U m)) π_m
        ∃ p_can : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X_U m q,
          WeilIsTorsionEtalePullback j m q p_can ∧
          ∀ z : weilEtaleTorsionH X m q,
            p_can z =
              edge (weilEtaleTorsionSheaf X_U m) q
                ((CategoryTheory.Abelian.Ext.mk₀ η_m).postcomp Fℤ_X (Nat.add_zero q) z))) :=
by
  intro pf_j pb_j adj_j C_X C_U Aℤ Fℤ_X Fℤ_U
  have : pb_j.Additive := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_j := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_j := inferInstance
  
  let B_j := weilEtaleSitePullback j
  let J_X := X.smallEtaleTopology
  let J_U := X_U.smallEtaleTopology
  have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} (CategoryTheory.Over.pullback j) :=
    (CategoryTheory.Over.mapPullbackAdj j).rightAdjoint_preservesLimits
  have : CategoryTheory.Limits.PreservesFiniteLimits
      (B_j ⋙ AlgebraicGeometry.Scheme.Etale.forget X_U) :=
    show CategoryTheory.Limits.PreservesFiniteLimits
      (AlgebraicGeometry.Scheme.Etale.forget X ⋙ CategoryTheory.Over.pullback j) from
      CategoryTheory.Limits.comp_preservesFiniteLimits _ _
  have : CategoryTheory.Limits.PreservesFiniteLimits B_j :=
    CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
      B_j (AlgebraicGeometry.Scheme.Etale.forget X_U)
  have hBT_X : CategoryTheory.Limits.IsTerminal (B_j.obj T_X) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B_j T_X hT_X
  let τ : B_j.obj T_X ⟶ T_U := hT_U.from (B_j.obj T_X)
  let τ_inv : T_U ⟶ B_j.obj T_X := hBT_X.from T_U
  have hτ₁ : τ ≫ τ_inv = 𝟙 (B_j.obj T_X) := hBT_X.hom_ext _ _
  have hτ₂ : τ_inv ≫ τ = 𝟙 T_U := hT_U.hom_ext _ _
  let Γ_X := (CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj (Opposite.op T_X)
  let Γ_U := (CategoryTheory.sheafSections J_U AddCommGrpCat.{u}).obj (Opposite.op T_U)
  let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
  let adj_U := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
  let θ : Γ_U ≅ pf_j ⋙ Γ_X :=
    CategoryTheory.NatIso.ofComponents
      (fun F =>
        { hom := F.obj.map τ.op
          inv := F.obj.map τ_inv.op
          hom_inv_id :=
            (F.obj.map_comp τ.op τ_inv.op).symm.trans
              ((congrArg F.obj.map (congrArg Quiver.Hom.op hτ₂)).trans
                (F.obj.map_id (Opposite.op T_U)))
          inv_hom_id :=
            (F.obj.map_comp τ_inv.op τ.op).symm.trans
              ((congrArg F.obj.map (congrArg Quiver.Hom.op hτ₁)).trans
                (F.obj.map_id (Opposite.op (B_j.obj T_X)))) })
      (fun ψ => (ψ.hom.naturality τ.op).symm)
  let core₂ : CategoryTheory.Adjunction.CoreHomEquiv C_U (pf_j ⋙ Γ_X) :=
    { homEquiv := fun A G =>
        { toFun := fun f => (adj_U.homEquiv A G) f ≫ θ.hom.app G
          invFun := fun g => (adj_U.homEquiv A G).symm (g ≫ θ.inv.app G)
          left_inv := fun f => by
            dsimp only
            rw [Category.assoc, θ.hom_inv_id_app G, Category.comp_id,
              Equiv.symm_apply_apply]
          right_inv := fun g => by
            dsimp only
            rw [Equiv.apply_symm_apply, Category.assoc, θ.inv_hom_id_app G,
              Category.comp_id] }
      homEquiv_naturality_left_symm := fun {A' A G} f g =>
        (congrArg (adj_U.homEquiv A' G).symm (Category.assoc f g (θ.inv.app G))).trans
          (adj_U.homEquiv_naturality_left_symm f (g ≫ θ.inv.app G))
      homEquiv_naturality_right := fun {A G G'} f g =>
        ((congrArg (· ≫ θ.hom.app G') (adj_U.homEquiv_naturality_right f g)).trans
          (Category.assoc _ _ _)).trans
          ((congrArg ((adj_U.homEquiv A G) f ≫ ·) (θ.hom.naturality g)).trans
            (Category.assoc _ _ _).symm) }
  let adj₁ : C_X ⋙ pb_j ⊣ pf_j ⋙ Γ_X := adj_X.comp adj_j
  let adj₂ : C_U ⊣ pf_j ⋙ Γ_X := CategoryTheory.Adjunction.mkOfHomEquiv core₂
  let α_iso : C_X ⋙ pb_j ≅ C_U := adj₁.leftAdjointUniq adj₂
  have h_eq_α : ∀ A : AddCommGrpCat.{u},
      @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A =
        α_iso.hom.app A := by
    intro A
    have h₁ := CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app adj₁ adj₂ A
    have h_u : (adj_U.homEquiv A (C_U.obj A)) (𝟙 (C_U.obj A)) = adj_U.unit.app A :=
      (adj_U.homEquiv_unit A (C_U.obj A) (𝟙 (C_U.obj A))).trans
        ((congrArg (adj_U.unit.app A ≫ ·) (CategoryTheory.Functor.map_id _ (C_U.obj A))).trans
          (Category.comp_id (adj_U.unit.app A)))
    have h₂ : adj₂.unit.app A = adj_U.unit.app A ≫ θ.hom.app (C_U.obj A) :=
      (CategoryTheory.Adjunction.mkOfHomEquiv_unit_app core₂ A).trans
        (congrArg (· ≫ θ.hom.app (C_U.obj A)) h_u)
    have h₃ : α_iso.hom.app A = (adj₁.homEquiv A (C_U.obj A)).symm (adj₂.unit.app A) := by
      rw [← h₁, Equiv.symm_apply_apply]
    rw [h₃, h₂]
    have hcomp := congrFun (congrFun (CategoryTheory.Adjunction.comp_homEquiv adj_X adj_j) A)
      (C_U.obj A)
    dsimp only [adj₁]
    rw [hcomp]
    rfl
  have h1a : ∀ A : AddCommGrpCat.{u},
      CategoryTheory.IsIso
        (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A) := by
    intro A
    rw [h_eq_α A]
    infer_instance
  have h1b : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (c : A₁ ⟶ A₂),
      let η₁ := (adj_j.homEquiv (C_X.obj A₁) (C_U.obj A₁))
        (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A₁)
      let η₂ := (adj_j.homEquiv (C_X.obj A₂) (C_U.obj A₂))
        (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A₂)
      C_X.map c ≫ η₂ = η₁ ≫ pf_j.map (C_U.map c) := by
    intro A₁ A₂ c η₁ η₂
    have hnat := α_iso.hom.naturality c
    dsimp only [CategoryTheory.Functor.comp_map] at hnat
    rw [← h_eq_α A₁, ← h_eq_α A₂] at hnat
    have hnat' := congrArg (adj_j.homEquiv (C_X.obj A₁) (C_U.obj A₂)) hnat
    rw [adj_j.homEquiv_naturality_left, adj_j.homEquiv_naturality_right] at hnat'
    exact hnat'
  let πℤ : pb_j.obj Fℤ_X ⟶ Fℤ_U :=
    @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X Aℤ
  let ιℤ : Fℤ_U ⟶ pb_j.obj Fℤ_X := α_iso.inv.app Aℤ
  have h2a : ιℤ ≫ πℤ = 𝟙 Fℤ_U := by
    dsimp only [ιℤ, πℤ]
    rw [h_eq_α Aℤ]
    exact α_iso.inv_hom_id_app Aℤ
  have h2b : πℤ ≫ ιℤ = 𝟙 (pb_j.obj Fℤ_X) := by
    dsimp only [ιℤ, πℤ]
    rw [h_eq_α Aℤ]
    exact α_iso.hom_inv_id_app Aℤ
  
  let edge : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) (q : ℕ),
      (pf_j.obj F).H q →+ F.H q := fun F q =>
    ((CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F)).postcomp Fℤ_U (Nat.add_zero q)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp
          (pb_j.obj (pf_j.obj F)) (Nat.zero_add q)).comp
        (pb_j.mapExtAddHom Fℤ_X (pf_j.obj F) q))
  have hEdge_adj : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      (f : G ⟶ pf_j.obj F) (q : ℕ) (z : G.H q),
      edge F q ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ_X (Nat.add_zero q) z) =
        (CategoryTheory.Abelian.Ext.mk₀ ((adj_j.homEquiv G F).symm f)).postcomp Fℤ_U
          (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((pb_j.mapExtAddHom Fℤ_X G q) z) (Nat.zero_add q)) := by
    intro G F f q z
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_j.mapExtAddHom Fℤ_X (pf_j.obj F) q)
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F)) (Nat.add_zero q) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_j.mapExtAddHom Fℤ_X G q) z) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ((adj_j.homEquiv G F).symm f)) (Nat.add_zero q)
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_j z)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map f)) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← adj_j.homEquiv_counit G F f]
  have h2c : ∀ F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u},
      Function.Bijective (edge F 0) := by
    intro F
    let eX : (pf_j.obj F).H 0 ≃+ (Fℤ_X ⟶ pf_j.obj F) := CategoryTheory.Abelian.Ext.addEquiv₀
    let eU : F.H 0 ≃+ (Fℤ_U ⟶ F) := CategoryTheory.Abelian.Ext.addEquiv₀
    have hEdge0 : ∀ g : Fℤ_X ⟶ pf_j.obj F,
        edge F 0 (eX.symm g) = eU.symm (ιℤ ≫ (adj_j.homEquiv Fℤ_X F).symm g) := by
      intro g
      dsimp only [eX, eU]
      rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
        CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_j.mapExtAddHom Fℤ_X (pf_j.obj F) 0) (CategoryTheory.Abelian.Ext.mk₀ g))
          (Nat.zero_add 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F)) (Nat.add_zero 0) = _
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        Category.assoc]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀
        (congrArg (ιℤ ≫ ·) (adj_j.homEquiv_counit Fℤ_X F g).symm)
    let inv_edge : F.H 0 → (pf_j.obj F).H 0 :=
      fun u => eX.symm ((adj_j.homEquiv Fℤ_X F) (πℤ ≫ eU u))
    refine Function.bijective_iff_has_inverse.mpr ⟨inv_edge, ?_, ?_⟩
    · intro w
      have hw : eX.symm (eX w) = w := eX.symm_apply_apply w
      conv_lhs => rw [← hw]
      rw [hEdge0]
      dsimp only [inv_edge]
      rw [eU.apply_symm_apply, ← Category.assoc, h2b, Category.id_comp,
        Equiv.apply_symm_apply, hw]
    · intro u
      dsimp only [inv_edge]
      rw [hEdge0, Equiv.symm_apply_apply, ← Category.assoc, h2a, Category.id_comp,
        eU.symm_apply_apply]
  have h2d : ∀ {F₁ F₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
      (ψ : F₁ ⟶ F₂) (q : ℕ) (w : (pf_j.obj F₁).H q),
      edge F₂ q
        ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map ψ)).postcomp Fℤ_X (Nat.add_zero q) w) =
        (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp Fℤ_U (Nat.add_zero q) (edge F₁ q w) := by
    intro F₁ F₂ ψ q w
    rw [hEdge_adj (pf_j.obj F₁) F₂ (pf_j.map ψ) q w]
    have hmate : (adj_j.homEquiv (pf_j.obj F₁) F₂).symm (pf_j.map ψ) =
        adj_j.counit.app F₁ ≫ ψ := by
      rw [adj_j.homEquiv_counit]
      exact adj_j.counit.naturality ψ
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_j.mapExtAddHom Fℤ_X (pf_j.obj F₁) q) w) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀
          ((adj_j.homEquiv (pf_j.obj F₁) F₂).symm (pf_j.map ψ))) (Nat.add_zero q) =
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_j.mapExtAddHom Fℤ_X (pf_j.obj F₁) q) w) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F₁)) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero q)
    rw [hmate, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (adj_j.counit.app F₁) ψ,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.add_zero q)]
  have h2e : ∀ (SC_X : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (hSE_X : SC_X.ShortExact)
      (SC_U : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u}))
      (hSE_U : SC_U.ShortExact)
      (f₁ : SC_X.X₁ ⟶ pf_j.obj SC_U.X₁)
      (f₂ : SC_X.X₂ ⟶ pf_j.obj SC_U.X₂)
      (f₃ : SC_X.X₃ ⟶ pf_j.obj SC_U.X₃),
      SC_X.f ≫ f₂ = f₁ ≫ pf_j.map SC_U.f →
      SC_X.g ≫ f₃ = f₂ ≫ pf_j.map SC_U.g →
      ∀ (k : ℕ) (w : SC_X.X₃.H k),
        edge SC_U.X₁ (k + 1)
          ((CategoryTheory.Abelian.Ext.mk₀ f₁).postcomp Fℤ_X (Nat.add_zero (k + 1))
            ((hSE_X.extClass.postcomp Fℤ_X (rfl : k + 1 = k + 1)) w)) =
        (hSE_U.extClass.postcomp Fℤ_U (rfl : k + 1 = k + 1))
          (edge SC_U.X₃ k
            ((CategoryTheory.Abelian.Ext.mk₀ f₃).postcomp Fℤ_X (Nat.add_zero k) w)) := by
    intro SC_X hSE_X SC_U hSE_U f₁ f₂ f₃ hf hg k w
    let g₁ : pb_j.obj SC_X.X₁ ⟶ SC_U.X₁ := (adj_j.homEquiv SC_X.X₁ SC_U.X₁).symm f₁
    let g₂ : pb_j.obj SC_X.X₂ ⟶ SC_U.X₂ := (adj_j.homEquiv SC_X.X₂ SC_U.X₂).symm f₂
    let g₃ : pb_j.obj SC_X.X₃ ⟶ SC_U.X₃ := (adj_j.homEquiv SC_X.X₃ SC_U.X₃).symm f₃
    have hsq₁ : (SC_X.map pb_j).f ≫ g₂ = g₁ ≫ SC_U.f :=
      adj_j.homEquiv_naturality_right_square SC_X.f f₂ f₁ SC_U.f hf
    have hsq₂ : (SC_X.map pb_j).g ≫ g₃ = g₂ ≫ SC_U.g :=
      adj_j.homEquiv_naturality_right_square SC_X.g f₃ f₂ SC_U.g hg
    let Φ : SC_X.map pb_j ⟶ SC_U :=
      { τ₁ := g₁
        τ₂ := g₂
        τ₃ := g₃
        comm₁₂ := by first | exact hsq₁ | exact hsq₁.symm
        comm₂₃ := by first | exact hsq₂ | exact hsq₂.symm }
    have hSE_pb : (SC_X.map pb_j).ShortExact := hSE_X.map_of_exact pb_j
    have h_ext_eq : CategoryTheory.Abelian.Ext.mapExactFunctor pb_j hSE_X.extClass =
        hSE_pb.extClass :=
      (CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_j hSE_X).trans
        (congrArg CategoryTheory.ShortComplex.ShortExact.extClass (Subsingleton.elim _ hSE_pb))
    rw [hEdge_adj SC_X.X₁ SC_U.X₁ f₁ (k + 1)
        ((hSE_X.extClass.postcomp Fℤ_X (rfl : k + 1 = k + 1)) w),
      hEdge_adj SC_X.X₃ SC_U.X₃ f₃ k w]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_j.mapExtAddHom Fℤ_X SC_X.X₁ (k + 1))
          (w.comp hSE_X.extClass (rfl : k + 1 = k + 1)))
        (Nat.zero_add (k + 1))).comp
        (CategoryTheory.Abelian.Ext.mk₀ g₁) (Nat.add_zero (k + 1)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_j.mapExtAddHom Fℤ_X SC_X.X₃ k) w) (Nat.zero_add k)).comp
        (CategoryTheory.Abelian.Ext.mk₀ g₃) (Nat.add_zero k)).comp
        hSE_U.extClass (rfl : k + 1 = k + 1)
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp, h_ext_eq,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_j w)
        hSE_pb.extClass (Nat.zero_add k) (rfl : k + 1 = k + 1) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ hSE_pb.extClass
        (CategoryTheory.Abelian.Ext.mk₀ g₁) (rfl : k + 1 = k + 1),
      show g₁ = Φ.τ₁ from rfl,
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_U Φ,
      show Φ.τ₃ = g₃ from rfl,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ g₃) hSE_U.extClass (rfl : k + 1 = k + 1)]
  have h2f : ∀ (m q : ℕ),
      let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let π_m := @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A_m
      let η_m := (adj_j.homEquiv (weilEtaleTorsionSheaf X m) (weilEtaleTorsionSheaf X_U m)) π_m
      ∃ p_can : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X_U m q,
        WeilIsTorsionEtalePullback j m q p_can ∧
        ∀ z : weilEtaleTorsionH X m q,
          p_can z =
            edge (weilEtaleTorsionSheaf X_U m) q
              ((CategoryTheory.Abelian.Ext.mk₀ η_m).postcomp Fℤ_X (Nat.add_zero q) z) := by
    intro m q A_m π_m η_m
    let G_m := weilEtaleTorsionSheaf X m
    let F_m := weilEtaleTorsionSheaf X_U m
    let p_can : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X_U m q :=
      ((CategoryTheory.Abelian.Ext.mk₀ π_m).postcomp Fℤ_U (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_j.obj G_m) (Nat.zero_add q)).comp
          (pb_j.mapExtAddHom Fℤ_X G_m q))
    refine ⟨p_can, ?_, ?_⟩
    · exact ⟨hCont_j, hAdj_j, inferInstance, inferInstance, inferInstance,
        T_U, hT_U, T_X, hT_X, ιℤ, h2a, h2b, fun x => rfl⟩
    · intro z
      rw [hEdge_adj G_m F_m η_m q z]
      dsimp only [η_m]
      rw [(adj_j.homEquiv G_m F_m).symm_apply_apply π_m]
      rfl
  exact ⟨⟨h1a, h1b⟩, ⟨ιℤ, edge, h2a, h2b, h2c, h2d, h2e, h2f⟩⟩

theorem weil_leray_five_term_natural_hdi_connecting_package {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
    (hCont_j : (weilEtaleSitePullback j).IsContinuous
      X.smallEtaleTopology X_U.smallEtaleTopology)
    (hAdj_j : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).IsRightAdjoint)
    [(@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).Additive] :
    let pf_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j
    let pb_j := @CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
    (∀ (I : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective I],
      (pb_j.PreservesMonomorphisms → CategoryTheory.Injective (pf_j.obj I)) ∧
      (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j p I))) ∧
    (∃ (δ₀ : ∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})),
          SC.ShortExact → (pf_j.obj SC.X₃ ⟶ weilEtaleHigherDirectImage j 1 SC.X₁))
        (Δ : ∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})),
          SC.ShortExact → ∀ q : ℕ,
            (weilEtaleHigherDirectImage j q SC.X₃ ⟶
              weilEtaleHigherDirectImage j (q + 1) SC.X₁)),
      (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE : SC.ShortExact),
        ((SC.map pf_j).Exact ∧ CategoryTheory.Mono (pf_j.map SC.f)) ∧
        (∃ hcomp₀ : pf_j.map SC.g ≫ δ₀ SC hSE = 0,
          (CategoryTheory.ShortComplex.mk (pf_j.map SC.g) (δ₀ SC hSE) hcomp₀).Exact) ∧
        (CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 SC.X₁) →
          (SC.map pf_j).ShortExact) ∧
        (CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 SC.X₂) →
          CategoryTheory.Epi (δ₀ SC hSE)) ∧
        (∀ q : ℕ, 1 ≤ q →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j q SC.X₂) →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (q + 1) SC.X₂) →
          CategoryTheory.IsIso (Δ SC hSE q))) ∧
      (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂),
        δ₀ SC₁ hSE₁ ≫ weilEtaleHigherDirectImageMap j 1 Ψ.τ₁ =
          pf_j.map Ψ.τ₃ ≫ δ₀ SC₂ hSE₂) ∧
      (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂) (q : ℕ),
        Δ SC₁ hSE₁ q ≫ weilEtaleHigherDirectImageMap j (q + 1) Ψ.τ₁ =
          weilEtaleHigherDirectImageMap j q Ψ.τ₃ ≫ Δ SC₂ hSE₂ q)) :=
by
  
  have hSiteDeg0 : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasSheafify J AddCommGrpCat.{u}]
      [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})],
      Nonempty (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ≅
        CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0) := by
    clear! X X_U
    intro C _ J _ _
    let CF0 := CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0
    let S_pre := CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}
    let L_sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite C)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Z_fun : CategoryTheory.Functor C (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
      CategoryTheory.yoneda ⋙ (Free_PSh ⋙ L_sh)
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    have : S_pre.Additive := adj_sh.right_adjoint_additive
    let adj_ab := CategoryTheory.Adjunction.whiskerRight (Opposite C) AddCommGrpCat.adj
    let P_E : C → CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u} :=
      fun E => Free_PSh.obj (CategoryTheory.yoneda.obj E)
    let F_E : C → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun E => L_sh.obj (P_E E)
    let e₁ : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : C),
        CategoryTheory.Abelian.Ext (F_E E) 𝒢 0 ≃ (F_E E ⟶ 𝒢) :=
      fun 𝒢 E => (CategoryTheory.Abelian.Ext.addEquiv₀ (X := F_E E) (Y := 𝒢)).toEquiv
    let e₂ : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : C),
        (F_E E ⟶ 𝒢) ≃ (P_E E ⟶ S_pre.obj 𝒢) :=
      fun 𝒢 E => adj_sh.homEquiv (P_E E) 𝒢
    let e₃ : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : C),
        (P_E E ⟶ S_pre.obj 𝒢) ≃
          (CategoryTheory.yoneda.obj E ⟶ (S_pre.obj 𝒢).comp (CategoryTheory.forget AddCommGrpCat.{u})) :=
      fun 𝒢 E => adj_ab.homEquiv (CategoryTheory.yoneda.obj E) (S_pre.obj 𝒢)
    let e₄ : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : C),
        (CategoryTheory.yoneda.obj E ⟶ (S_pre.obj 𝒢).comp (CategoryTheory.forget AddCommGrpCat.{u})) ≃
          ↥((S_pre.obj 𝒢).obj (Opposite.op E)) :=
      fun _ _ => CategoryTheory.yonedaEquiv
    let evHom : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : C),
        (F_E E ⟶ 𝒢) ≃ ↥((S_pre.obj 𝒢).obj (Opposite.op E)) :=
      fun 𝒢 E => (e₂ 𝒢 E).trans ((e₃ 𝒢 E).trans (e₄ 𝒢 E))
    let u₀ : ∀ E : C, ↥((P_E E).obj (Opposite.op E)) :=
      fun E => CategoryTheory.ConcreteCategory.hom
        ((adj_ab.unit.app (CategoryTheory.yoneda.obj E)).app (Opposite.op E)) (𝟙 E)
    let gen_E : ∀ E : C, ↥((S_pre.obj (F_E E)).obj (Opposite.op E)) :=
      fun E => CategoryTheory.ConcreteCategory.hom
        ((adj_sh.unit.app (P_E E)).app (Opposite.op E)) (u₀ E)
    have hevHom : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (E : C) (g : F_E E ⟶ 𝒢),
        evHom 𝒢 E g = CategoryTheory.ConcreteCategory.hom
          ((S_pre.map g).app (Opposite.op E)) (gen_E E) := by
      intro 𝒢 E g
      dsimp only [evHom, e₂, e₃, e₄, Equiv.trans_apply]
      rw [CategoryTheory.yonedaEquiv_apply, adj_ab.homEquiv_unit, adj_sh.homEquiv_unit]
      rfl
    let addEquivObj : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : C),
        CategoryTheory.Abelian.Ext (F_E E) 𝒢 0 ≃+ ↥((S_pre.obj 𝒢).obj (Opposite.op E)) :=
      fun 𝒢 E => AddEquiv.mk' ((e₁ 𝒢 E).trans (evHom 𝒢 E)) (fun α β => by
        change evHom 𝒢 E (CategoryTheory.Abelian.Ext.addEquiv₀ (α + β)) =
          evHom 𝒢 E (CategoryTheory.Abelian.Ext.addEquiv₀ α) +
            evHom 𝒢 E (CategoryTheory.Abelian.Ext.addEquiv₀ β)
        rw [map_add, hevHom, hevHom, hevHom, S_pre.map_add]
        rfl)
    let isoShRev : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        CF0.obj 𝒢 ≅ S_pre.obj 𝒢 :=
      fun 𝒢 => CategoryTheory.NatIso.ofComponents
        (fun W => (addEquivObj 𝒢 W.unop).toAddCommGrpIso)
        (fun {W₁ W₂} v => by
          have hmap : ((CF0.obj 𝒢).map v) =
              ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map v)).app 𝒢 := rfl
          rw [hmap, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map v) 𝒢]
          apply AddCommGrpCat.ext
          intro (α : CategoryTheory.Abelian.Ext (F_E W₁.unop) 𝒢 0)
          let g : F_E W₁.unop ⟶ 𝒢 := CategoryTheory.Abelian.Ext.addEquiv₀ α
          let φ_v : F_E W₂.unop ⟶ F_E W₁.unop := (Z_fun.op.map v).unop
          have hlhs_ext : (CategoryTheory.Abelian.Ext.mk₀ φ_v).comp α (Nat.zero_add 0) =
              CategoryTheory.Abelian.Ext.mk₀ (φ_v ≫ g) := by
            conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α]
            exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_v g
          change (addEquivObj 𝒢 W₂.unop)
              ((CategoryTheory.Abelian.Ext.mk₀ φ_v).comp α (Nat.zero_add 0)) =
            CategoryTheory.ConcreteCategory.hom ((S_pre.obj 𝒢).map v)
              ((addEquivObj 𝒢 W₁.unop) α)
          rw [hlhs_ext]
          change evHom 𝒢 W₂.unop
              (CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (φ_v ≫ g))) =
            CategoryTheory.ConcreteCategory.hom ((S_pre.obj 𝒢).map v) (evHom 𝒢 W₁.unop g)
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          dsimp only [evHom, e₂, e₃, e₄, Equiv.trans_apply, φ_v, Z_fun]
          change CategoryTheory.yonedaEquiv
              (adj_ab.homEquiv (CategoryTheory.yoneda.obj W₂.unop) (S_pre.obj 𝒢)
                (adj_sh.homEquiv (P_E W₂.unop) 𝒢
                  (L_sh.map (Free_PSh.map (CategoryTheory.yoneda.map v.unop)) ≫ g))) =
            CategoryTheory.ConcreteCategory.hom ((S_pre.obj 𝒢).map v)
              (CategoryTheory.yonedaEquiv
                (adj_ab.homEquiv (CategoryTheory.yoneda.obj W₁.unop) (S_pre.obj 𝒢)
                  (adj_sh.homEquiv (P_E W₁.unop) 𝒢 g)))
          rw [adj_sh.homEquiv_naturality_left, adj_ab.homEquiv_naturality_left,
            ← CategoryTheory.yonedaEquiv_naturality']
          rfl)
    let isoRev : CF0 ≅ S_pre :=
      CategoryTheory.NatIso.ofComponents isoShRev
        (fun {𝒢₁ 𝒢₂} ψ => by
          apply CategoryTheory.NatTrans.ext
          funext W
          have hmap : ((CF0.map ψ).app W) =
              (CategoryTheory.Abelian.extFunctorObj (F_E W.unop) 0).map ψ := rfl
          rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.comp_app,
            hmap, CategoryTheory.Abelian.extFunctorObj_map (F_E W.unop) 0 ψ]
          apply AddCommGrpCat.ext
          intro (α : CategoryTheory.Abelian.Ext (F_E W.unop) 𝒢₁ 0)
          let g : F_E W.unop ⟶ 𝒢₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
          have hcomp_ext : α.comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero 0) =
              CategoryTheory.Abelian.Ext.mk₀ (g ≫ ψ) := by
            conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α]
            exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ g ψ
          change (addEquivObj 𝒢₂ W.unop)
              (α.comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero 0)) =
            CategoryTheory.ConcreteCategory.hom ((S_pre.map ψ).app (Opposite.op W.unop))
              ((addEquivObj 𝒢₁ W.unop) α)
          rw [hcomp_ext]
          change evHom 𝒢₂ W.unop
              (CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (g ≫ ψ))) =
            CategoryTheory.ConcreteCategory.hom ((S_pre.map ψ).app (Opposite.op W.unop))
              (evHom 𝒢₁ W.unop g)
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
            hevHom 𝒢₂ W.unop (g ≫ ψ), hevHom 𝒢₁ W.unop g, S_pre.map_comp]
          rfl)
    exact ⟨isoRev.symm⟩

  
  have hSiteConn : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasSheafify J AddCommGrpCat.{u}]
      [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})],
      (∀ (I : CategoryTheory.Sheaf J AddCommGrpCat.{u}) [CategoryTheory.Injective I]
          (p : ℕ), 1 ≤ p →
        CategoryTheory.Limits.IsZero ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J p).obj I)) ∧
      (∃ (δ_pre : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
            SC.ShortExact → ∀ q : ℕ,
              ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J q).obj SC.X₃ ⟶
                (CategoryTheory.Sheaf.cohomologyPresheafFunctor J (q + 1)).obj SC.X₁)),
        (∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}))
            (hSE : SC.ShortExact) (q : ℕ),
          (∃ hcomp₁ : (CategoryTheory.Sheaf.cohomologyPresheafFunctor J q).map SC.g ≫
                δ_pre SC hSE q = 0,
            (CategoryTheory.ShortComplex.mk
              ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J q).map SC.g)
              (δ_pre SC hSE q) hcomp₁).Exact) ∧
          (∃ hcomp₂ : δ_pre SC hSE q ≫
                (CategoryTheory.Sheaf.cohomologyPresheafFunctor J (q + 1)).map SC.f = 0,
            (CategoryTheory.ShortComplex.mk
              (δ_pre SC hSE q)
              ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J (q + 1)).map SC.f) hcomp₂).Exact)) ∧
        (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})}
            (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact)
            (Ψ : SC₁ ⟶ SC₂) (q : ℕ),
          δ_pre SC₁ hSE₁ q ≫
              (CategoryTheory.Sheaf.cohomologyPresheafFunctor J (q + 1)).map Ψ.τ₁ =
            (CategoryTheory.Sheaf.cohomologyPresheafFunctor J q).map Ψ.τ₃ ≫
              δ_pre SC₂ hSE₂ q)) := by
    clear! X X_U
    intro C _ J _ _
    let CF := CategoryTheory.Sheaf.cohomologyPresheafFunctor J
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite C)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let L_sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let Z_fun : CategoryTheory.Functor C (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
      CategoryTheory.yoneda ⋙ (Free_PSh ⋙ L_sh)
    let Z_obj : Opposite C → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    have hInjPre : ∀ (I : CategoryTheory.Sheaf J AddCommGrpCat.{u}) [CategoryTheory.Injective I]
        (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero ((CF p).obj I) := by
      intro I _ p hp
      obtain ⟨n, rfl⟩ : ∃ n : ℕ, p = n + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.ext
      intro (e : CategoryTheory.Abelian.Ext (Z_obj W) I (n + 1))
      change e = 0
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective e
    let δ_pre : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
        SC.ShortExact → ∀ q : ℕ, ((CF q).obj SC.X₃ ⟶ (CF (q + 1)).obj SC.X₁) :=
      fun SC hSE q =>
        { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
          naturality := fun {W₁ W₂} ω => by
            have hL : (((CF q).obj SC.X₃).map ω) =
                ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
            have hR : (((CF (q + 1)).obj SC.X₁).map ω) =
                ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
            rw [hL, hR,
              CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
              CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
            apply AddCommGrpCat.ext
            intro α
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1)) }
    have hExact_of_eval : ∀ (S_pre : CategoryTheory.ShortComplex
        (CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u})),
        (∀ W : Opposite C,
          (S_pre.map ((CategoryTheory.evaluation (Opposite C) AddCommGrpCat.{u}).obj W)).Exact) →
        S_pre.Exact := by
      intro S_pre hEval
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
        CategoryTheory.Functor.isZero_iff]
      intro W
      let ev_W := (CategoryTheory.evaluation (Opposite C) AddCommGrpCat.{u}).obj W
      have hZ_map : CategoryTheory.Limits.IsZero (S_pre.map ev_W).leftHomology :=
        (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (S_pre.map ev_W)).mp (hEval W)
      exact hZ_map.of_iso (S_pre.mapLeftHomologyIso ev_W).symm
    refine ⟨hInjPre, δ_pre, ?_, ?_⟩
    · intro SC hSE q
      have hcomp₁ : (CF q).map SC.g ≫ δ_pre SC hSE q = 0 := by
        apply CategoryTheory.NatTrans.ext
        funext W
        have hmap_g : (((CF q).map SC.g).app W) =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) q).map SC.g := rfl
        rw [CategoryTheory.NatTrans.comp_app, hmap_g,
          CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g]
        have hEx₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hz₃ := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hEx₃
        apply AddCommGrpCat.ext
        intro x
        exact congrArg
          (fun φ => (CategoryTheory.ConcreteCategory.hom (C := AddCommGrpCat.{u}) φ) x) hz₃
      have hcomp₂ : δ_pre SC hSE q ≫ (CF (q + 1)).map SC.f = 0 := by
        apply CategoryTheory.NatTrans.ext
        funext W
        have hmap_f : (((CF (q + 1)).map SC.f).app W) =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) (q + 1)).map SC.f := rfl
        rw [CategoryTheory.NatTrans.comp_app, hmap_f,
          CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f]
        have hEx₁ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hz₁ := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hEx₁
        apply AddCommGrpCat.ext
        intro x
        exact congrArg
          (fun φ => (CategoryTheory.ConcreteCategory.hom (C := AddCommGrpCat.{u}) φ) x) hz₁
      refine ⟨⟨hcomp₁, hExact_of_eval _ fun W => ?_⟩, ⟨hcomp₂, hExact_of_eval _ fun W => ?_⟩⟩
      · have hEx₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hmap_g : (((CF q).map SC.g).app W) =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) q).map SC.g := rfl
        let e_iso := @CategoryTheory.ShortComplex.isoMk AddCommGrpCat.{u} _ _
          ((CategoryTheory.ShortComplex.mk ((CF q).map SC.g) (δ_pre SC hSE q) hcomp₁).map
            ((CategoryTheory.evaluation (Opposite C) AddCommGrpCat.{u}).obj W))
          ((fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K) hEx₃)
          (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _)
          (by
            apply AddCommGrpCat.ext
            intro x
            change (((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) x) =
              CategoryTheory.ConcreteCategory.hom (((CF q).map SC.g).app W) x
            rw [hmap_g, CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g]
            rfl)
          (by
            apply AddCommGrpCat.ext
            intro x
            rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_iso).mpr hEx₃
      · have hEx₁ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hmap_f : (((CF (q + 1)).map SC.f).app W) =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) (q + 1)).map SC.f := rfl
        let e_iso := @CategoryTheory.ShortComplex.isoMk AddCommGrpCat.{u} _ _
          ((CategoryTheory.ShortComplex.mk (δ_pre SC hSE q) ((CF (q + 1)).map SC.f) hcomp₂).map
            ((CategoryTheory.evaluation (Opposite C) AddCommGrpCat.{u}).obj W))
          ((fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K) hEx₁)
          (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _)
          (by
            apply AddCommGrpCat.ext
            intro x
            rfl)
          (by
            apply AddCommGrpCat.ext
            intro x
            change (((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W)
                (Nat.add_zero (q + 1))) x) =
              CategoryTheory.ConcreteCategory.hom (((CF (q + 1)).map SC.f).app W) x
            rw [hmap_f, CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f]
            rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_iso).mpr hEx₁
    · intro SC₁ SC₂ hSE₁ hSE₂ Ψ q
      apply CategoryTheory.NatTrans.ext
      funext W
      have hm1 : (((CF (q + 1)).map Ψ.τ₁).app W) =
          (CategoryTheory.Abelian.extFunctorObj (Z_obj W) (q + 1)).map Ψ.τ₁ := rfl
      have hm3 : (((CF q).map Ψ.τ₃).app W) =
          (CategoryTheory.Abelian.extFunctorObj (Z_obj W) q).map Ψ.τ₃ := rfl
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.comp_app,
        hm1, hm3,
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) Ψ.τ₁,
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q Ψ.τ₃]
      apply AddCommGrpCat.ext
      intro (α : CategoryTheory.Abelian.Ext (Z_obj W) SC₁.X₃ q)
      change (α.comp hSE₁.extClass (rfl : q + 1 = q + 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₁) (Nat.add_zero (q + 1)) =
        (α.comp (CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₃) (Nat.add_zero q)).comp
          hSE₂.extClass (rfl : q + 1 = q + 1)
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero α hSE₁.extClass
            (CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₁) (rfl : q + 1 = q + 1),
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₁ hSE₂ Ψ,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero α
            (CategoryTheory.Abelian.Ext.mk₀ Ψ.τ₃) hSE₂.extClass (rfl : q + 1 = q + 1)]

  
  have hAbstractStep :
      ∀ {C_X C_U : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} C_X]
        [CategoryTheory.Category.{u, u + 1} C_U]
        (J_X : CategoryTheory.GrothendieckTopology C_X)
        (J_U : CategoryTheory.GrothendieckTopology C_U)
        [CategoryTheory.HasSheafify J_X AddCommGrpCat.{u}]
        [CategoryTheory.HasSheafify J_U AddCommGrpCat.{u}]
        [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})]
        (B : CategoryTheory.Functor C_X C_U)
        (hCont : B.IsContinuous J_X J_U)
        (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          B AddCommGrpCat.{u} _ J_X J_U hCont).IsRightAdjoint)
        [(@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          B AddCommGrpCat.{u} _ J_X J_U hCont).Additive],
      let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ J_X J_U hCont
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        B AddCommGrpCat.{u} _ J_X J_U hCont hAdj
      let HDI := fun (q : ℕ) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) =>
        (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).obj
          (CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf F q))
      let HDIMap := fun (q : ℕ) {F₁ F₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂) =>
        (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerLeft B.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).map φ))
      (∀ (I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) [CategoryTheory.Injective I],
        (pb.PreservesMonomorphisms → CategoryTheory.Injective (pf.obj I)) ∧
        (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (HDI p I))) ∧
      (∃ (δ₀ : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})),
            SC.ShortExact → (pf.obj SC.X₃ ⟶ HDI 1 SC.X₁))
          (Δ : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})),
            SC.ShortExact → ∀ q : ℕ, (HDI q SC.X₃ ⟶ HDI (q + 1) SC.X₁)),
        (∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u}))
            (hSE : SC.ShortExact),
          ((SC.map pf).Exact ∧ CategoryTheory.Mono (pf.map SC.f)) ∧
          (∃ hcomp₀ : pf.map SC.g ≫ δ₀ SC hSE = 0,
            (CategoryTheory.ShortComplex.mk (pf.map SC.g) (δ₀ SC hSE) hcomp₀).Exact) ∧
          (CategoryTheory.Limits.IsZero (HDI 1 SC.X₁) → (SC.map pf).ShortExact) ∧
          (CategoryTheory.Limits.IsZero (HDI 1 SC.X₂) → CategoryTheory.Epi (δ₀ SC hSE)) ∧
          (∀ q : ℕ, 1 ≤ q →
            CategoryTheory.Limits.IsZero (HDI q SC.X₂) →
            CategoryTheory.Limits.IsZero (HDI (q + 1) SC.X₂) →
            CategoryTheory.IsIso (Δ SC hSE q))) ∧
        (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})}
            (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂),
          δ₀ SC₁ hSE₁ ≫ HDIMap 1 Ψ.τ₁ = pf.map Ψ.τ₃ ≫ δ₀ SC₂ hSE₂) ∧
        (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})}
            (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂) (q : ℕ),
          Δ SC₁ hSE₁ q ≫ HDIMap (q + 1) Ψ.τ₁ = HDIMap q Ψ.τ₃ ≫ Δ SC₂ hSE₂ q)) := by
    clear! X X_U
    intro C_X C_U _ _ J_X J_U _ _ _ B hCont hAdj _
    let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B AddCommGrpCat.{u} _ J_X J_U hCont
    let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B AddCommGrpCat.{u} _ J_X J_U hCont hAdj
    have : B.IsContinuous J_X J_U := hCont
    have : pf.IsRightAdjoint := hAdj
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite C_X) (Opposite C_U)
      AddCommGrpCat.{u}).obj B.op
    let S_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
    let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let S_U := CategoryTheory.sheafToPresheaf J_U AddCommGrpCat.{u}
    let E_X := W_B.comp Sh_X
    let CF := CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U
    let Φ : ℕ → CategoryTheory.Functor
        (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
      fun q => (CF q).comp E_X

    have hDeg0_B : ∃ Θ : ∀ ℱ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u},
        pf.obj ℱ ≅ (Φ 0).obj ℱ,
        ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}} (φ : ℱ₁ ⟶ ℱ₂),
          pf.map φ ≫ (Θ ℱ₂).hom = (Θ ℱ₁).hom ≫ (Φ 0).map φ := by
      obtain ⟨e₀⟩ := hSiteDeg0 J_U
      have : CategoryTheory.IsIso
          (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).counit :=
        CategoryTheory.sheafification_reflective
      let ε_X : S_X.comp Sh_X ≅ CategoryTheory.Functor.id _ :=
        CategoryTheory.asIso (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).counit
      let e_pf_pre : pf.comp S_X ≅ S_U.comp W_B :=
        CategoryTheory.NatIso.ofComponents
          (fun _ => CategoryTheory.Iso.refl _)
          (fun _ => by
            apply CategoryTheory.NatTrans.ext
            funext W
            apply AddCommGrpCat.ext
            intro x
            rfl)
      let Θ_nat : pf ≅ Φ 0 :=
        (CategoryTheory.Functor.rightUnitor pf).symm ≪≫
          (CategoryTheory.Functor.isoWhiskerLeft pf ε_X).symm ≪≫
          (CategoryTheory.Functor.associator pf S_X Sh_X).symm ≪≫
          CategoryTheory.Functor.isoWhiskerRight e_pf_pre Sh_X ≪≫
          CategoryTheory.Functor.associator S_U W_B Sh_X ≪≫
          CategoryTheory.Functor.isoWhiskerRight e₀ E_X
      exact ⟨fun ℱ => Θ_nat.app ℱ, fun φ => Θ_nat.hom.naturality φ⟩

    obtain ⟨Θ, hΘ⟩ := hDeg0_B
    obtain ⟨hInjPre, δ_pre, hδ_pre_ex, hδ_pre_nat⟩ := hSiteConn J_U

    let Δ_raw : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})),
        SC.ShortExact → ∀ q : ℕ, ((Φ q).obj SC.X₃ ⟶ (Φ (q + 1)).obj SC.X₁) :=
      fun SC hSE q => E_X.map (δ_pre SC hSE q)
    let δ₀_raw : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})),
        SC.ShortExact → (pf.obj SC.X₃ ⟶ (Φ 1).obj SC.X₁) :=
      fun SC hSE => (Θ SC.X₃).hom ≫ Δ_raw SC hSE 0

    have hΔ_nat : ∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})}
        (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂) (q : ℕ),
        Δ_raw SC₁ hSE₁ q ≫ (Φ (q + 1)).map Ψ.τ₁ =
          (Φ q).map Ψ.τ₃ ≫ Δ_raw SC₂ hSE₂ q := by
      intro SC₁ SC₂ hSE₁ hSE₂ Ψ q
      dsimp only [Δ_raw, Φ, CategoryTheory.Functor.comp_map]
      rw [← E_X.map_comp, hδ_pre_nat hSE₁ hSE₂ Ψ q, E_X.map_comp]

    have hδ₀_nat : ∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})}
        (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂),
        δ₀_raw SC₁ hSE₁ ≫ (Φ 1).map Ψ.τ₁ =
          pf.map Ψ.τ₃ ≫ δ₀_raw SC₂ hSE₂ := by
      intro SC₁ SC₂ hSE₁ hSE₂ Ψ
      dsimp only [δ₀_raw]
      rw [CategoryTheory.Category.assoc, hΔ_nat hSE₁ hSE₂ Ψ 0,
        ← CategoryTheory.Category.assoc, ← hΘ Ψ.τ₃, CategoryTheory.Category.assoc]

    refine ⟨?_, ⟨δ₀_raw, Δ_raw, ?_, @hδ₀_nat, @hΔ_nat⟩⟩
    · intro I _
      refine ⟨?_, fun p hp => Sh_X.map_isZero (W_B.map_isZero (hInjPre I p hp))⟩
      intro hMono
      have : pb.PreservesMonomorphisms := hMono
      let adj_B := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        B AddCommGrpCat.{u} _ J_X J_U hCont hAdj
      exact CategoryTheory.Injective.injective_of_adjoint adj_B I
    · intro SC hSE
      have hPush_ex : ∀ q : ℕ,
          (∃ h₁_X : (Φ q).map SC.g ≫ Δ_raw SC hSE q = 0,
            (CategoryTheory.ShortComplex.mk ((Φ q).map SC.g) (Δ_raw SC hSE q) h₁_X).Exact) ∧
          (∃ h₂_X : Δ_raw SC hSE q ≫ (Φ (q + 1)).map SC.f = 0,
            (CategoryTheory.ShortComplex.mk (Δ_raw SC hSE q) ((Φ (q + 1)).map SC.f) h₂_X).Exact) := by
        intro q
        obtain ⟨⟨hcomp₁, hEx₁⟩, ⟨hcomp₂, hEx₂⟩⟩ := hδ_pre_ex SC hSE q
        let S₁ := ((CategoryTheory.ShortComplex.mk ((CF q).map SC.g) (δ_pre SC hSE q) hcomp₁).map W_B).map Sh_X
        let S₂ := ((CategoryTheory.ShortComplex.mk (δ_pre SC hSE q) ((CF (q + 1)).map SC.f) hcomp₂).map W_B).map Sh_X
        exact ⟨⟨S₁.zero, (hEx₁.map W_B).map Sh_X⟩, ⟨S₂.zero, (hEx₂.map W_B).map Sh_X⟩⟩
      have hMono_f : CategoryTheory.Mono (pf.map SC.f) := by
        have : CategoryTheory.Mono SC.f := hSE.mono_f
        exact pf.map_mono SC.f
      have hEx_pf : (SC.map pf).Exact :=
        hSE.exact.map_of_mono_of_preservesKernel pf hSE.mono_f inferInstance
      obtain ⟨⟨h₁_0, hEx₁_0⟩, ⟨h₂_0, hEx₂_0⟩⟩ := hPush_ex 0
      have hcomp₀ : pf.map SC.g ≫ δ₀_raw SC hSE = 0 := by
        dsimp only [δ₀_raw]
        rw [← CategoryTheory.Category.assoc, hΘ SC.g, CategoryTheory.Category.assoc,
          h₁_0, CategoryTheory.Limits.comp_zero]
      have hEx₀ : (CategoryTheory.ShortComplex.mk (pf.map SC.g) (δ₀_raw SC hSE) hcomp₀).Exact := by
        let e_SC : CategoryTheory.ShortComplex.mk (pf.map SC.g) (δ₀_raw SC hSE) hcomp₀ ≅
            CategoryTheory.ShortComplex.mk ((Φ 0).map SC.g) (Δ_raw SC hSE 0) h₁_0 :=
          @CategoryTheory.ShortComplex.isoMk _ _ _
            (CategoryTheory.ShortComplex.mk (pf.map SC.g) (δ₀_raw SC hSE) hcomp₀)
            (CategoryTheory.ShortComplex.mk ((Φ 0).map SC.g) (Δ_raw SC hSE 0) h₁_0)
            (Θ SC.X₂) (Θ SC.X₃)
            (CategoryTheory.Iso.refl ((Φ 1).obj SC.X₁))
            (hΘ SC.g).symm (CategoryTheory.Category.comp_id (δ₀_raw SC hSE)).symm
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mpr hEx₁_0
      refine ⟨⟨hEx_pf, hMono_f⟩, ⟨hcomp₀, hEx₀⟩, ?_, ?_, ?_⟩
      · intro hZ₁
        have hδ₀_zero : δ₀_raw SC hSE = 0 := hZ₁.eq_of_tgt (δ₀_raw SC hSE) 0
        exact CategoryTheory.ShortComplex.ShortExact.mk' hEx_pf hMono_f (hEx₀.epi_f hδ₀_zero)
      · intro hZ₂
        have hf_zero : (Φ 1).map SC.f = 0 := hZ₂.eq_of_tgt ((Φ 1).map SC.f) 0
        have : CategoryTheory.Epi (Δ_raw SC hSE 0) := hEx₂_0.epi_f hf_zero
        exact CategoryTheory.epi_comp (Θ SC.X₃).hom (Δ_raw SC hSE 0)
      · intro q _hq hZq hZq1
        obtain ⟨⟨h₁_q, hEx₁_q⟩, ⟨h₂_q, hEx₂_q⟩⟩ := hPush_ex q
        have hg_zero : (Φ q).map SC.g = 0 := hZq.eq_of_src ((Φ q).map SC.g) 0
        have hf_zero : (Φ (q + 1)).map SC.f = 0 := hZq1.eq_of_tgt ((Φ (q + 1)).map SC.f) 0
        have : CategoryTheory.Mono (Δ_raw SC hSE q) := hEx₁_q.mono_g hg_zero
        have : CategoryTheory.Epi (Δ_raw SC hSE q) := hEx₂_q.epi_f hf_zero
        exact CategoryTheory.isIso_of_mono_of_epi (Δ_raw SC hSE q)

  
