  have hZero_ker_pbu : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel (pb_i.map u_S)) :=
    (CategoryTheory.Preadditive.mono_iff_isZero_kernel' _
      (CategoryTheory.Limits.kernelIsKernel (pb_i.map u_S))).mp inferInstance
  have hZero_cok_pbu : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel (pb_i.map u_S)) :=
    (CategoryTheory.Preadditive.epi_iff_isZero_cokernel' _
      (CategoryTheory.Limits.cokernelIsCokernel (pb_i.map u_S))).mp inferInstance
  have hZero_pbK : CategoryTheory.Limits.IsZero (pb_i.obj K_u) :=
    hZero_ker_pbu.of_iso (CategoryTheory.Limits.PreservesKernel.iso pb_i u_S)
  have hZero_pbC : CategoryTheory.Limits.IsZero (pb_i.obj C_u) :=
    hZero_cok_pbu.of_iso (CategoryTheory.Limits.PreservesCokernel.iso pb_i u_S)
  obtain ⟨hPbEx, -, hPbComp, -, hPbKerCok, -⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} 0
  have hMeetZero : ∀ (K : Type u) [Field K]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
