      rw [RingHom.comp_assoc, hFK_comp, hcomp_PΩ, IsScalarTower.algebraMap_eq P F_P Ω]
    have hAlg_KΩ : Algebra.IsAlgebraic K_s Ω := by
      constructor
      intro ω
      obtain ⟨Q, hQ_ne, hQ_ev⟩ := (AlgebraicClosure.isAlgebraic F_P).isAlgebraic ω
