      have hu₁_nat : ((adj_g''.unit.app (pb_g'.obj A₀)).hom.app (Opposite.op U')).hom
            (((pb_g'.obj A₀).obj.map u₁.op).hom s_pull₁) =
          (M.obj.map ((weilEtaleSitePullback g'').map u₁).op).hom s_comp :=
        congrArg (fun m₀ => m₀.hom s_pull₁)
          ((adj_g''.unit.app (pb_g'.obj A₀)).hom.naturality u₁.op)
      exact hu_nat.trans
        ((congrArg ((adj_g''.unit.app (pb_g'.obj A₀)).hom.app (Opposite.op U')).hom hρ₁_app).trans
