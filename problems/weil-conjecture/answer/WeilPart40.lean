    have hs_fac : s_aff ≫ hU.fromSpec = x_Rbar :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec x_Rbar hsub_s
    have hg_fac : g_aff ≫ hU.fromSpec = g :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec g hsub_g
