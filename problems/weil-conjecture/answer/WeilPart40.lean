    (hΔ_nat : ∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Ψ : SC₁ ⟶ SC₂) (q : ℕ),
      Δ SC₁ hSE₁ q ≫ weilEtaleHigherDirectImageMap j (q + 1) Ψ.τ₁ =
        weilEtaleHigherDirectImageMap j q Ψ.τ₃ ≫ Δ SC₂ hSE₂ q)
    (n : ℕ)
    (ih :
      let pf_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback j) AddCommGrpCat.{u} _
        X.smallEtaleTopology X_U.smallEtaleTopology hCont_j
      let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      ∃ (ν_n : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
            F.H (n + 1) →+ (weilEtaleHigherDirectImage j (n + 1) F).H 0)
        (β_n : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
            (weilEtaleHigherDirectImage j (n + 1) F).H 0 →+ (pf_j.obj F).H (n + 2)),
        ∀ (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ b : ℕ, 1 ≤ b → b ≤ n →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b F)) →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 2) F) →
          Subsingleton ((weilEtaleHigherDirectImage j (n + 1) F).H 1) →
          (∀ q : ℕ, q ≤ n → Function.Bijective (edge F q)) ∧
          (Function.Injective (edge F (n + 1)) ∧
            AddMonoidHom.range (edge F (n + 1)) = AddMonoidHom.ker (ν_n F) ∧
            AddMonoidHom.range (ν_n F) = AddMonoidHom.ker (β_n F) ∧
            AddMonoidHom.range (β_n F) = AddMonoidHom.ker (edge F (n + 2)) ∧
            Function.Surjective (edge F (n + 2))) ∧
          (∀ (F₂ : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
            (∀ b : ℕ, 1 ≤ b → b ≤ n →
              CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b F₂)) →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 2) F₂) →
            Subsingleton ((weilEtaleHigherDirectImage j (n + 1) F₂).H 1) →
            ∀ (φ : F₂ ⟶ F) (y : (weilEtaleHigherDirectImage j (n + 1) F₂).H 0),
              (CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp Fℤ_X
                (Nat.add_zero (n + 2)) (β_n F₂ y) =
              β_n F ((CategoryTheory.Abelian.Ext.mk₀
                (weilEtaleHigherDirectImageMap j (n + 1) φ)).postcomp Fℤ_X
                (Nat.add_zero 0) y))) :
    let pf_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j
    let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∃ (ν_succ : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
          F.H (n + 1 + 1) →+ (weilEtaleHigherDirectImage j (n + 1 + 1) F).H 0)
      (β_succ : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
          (weilEtaleHigherDirectImage j (n + 1 + 1) F).H 0 →+ (pf_j.obj F).H (n + 1 + 2)),
      ∀ (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ b : ℕ, 1 ≤ b → b ≤ n + 1 →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b F)) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 1 + 2) F) →
        Subsingleton ((weilEtaleHigherDirectImage j (n + 1 + 1) F).H 1) →
        (∀ q : ℕ, q ≤ n + 1 → Function.Bijective (edge F q)) ∧
        (Function.Injective (edge F (n + 1 + 1)) ∧
          AddMonoidHom.range (edge F (n + 1 + 1)) = AddMonoidHom.ker (ν_succ F) ∧
          AddMonoidHom.range (ν_succ F) = AddMonoidHom.ker (β_succ F) ∧
          AddMonoidHom.range (β_succ F) = AddMonoidHom.ker (edge F (n + 1 + 2)) ∧
          Function.Surjective (edge F (n + 1 + 2))) ∧
        (∀ (F₂ : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
