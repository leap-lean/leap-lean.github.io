        exact (congrArg (eval_c c w₁ m) hz₁.symm).trans (hev₁.trans
          (hev₂.symm.trans (congrArg (eval_c c w₂ m) hz₂)))
      let g_fn : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A)) (m : ↥c.pt),
