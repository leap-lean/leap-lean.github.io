        ((θ_Z (B_is.obj V)).hom).hom
          (LocallyConstant.const ↥(Fgt_Z.obj (B_is.obj V)).left (c.sum (fun _ r => r))) := by
    intro V c
    have hq_app : (Ξ W_st).hom.app (Opposite.op V) ≫ q_pt.app (Opposite.op V) ≫
        bar_π.app (Opposite.op V) =
        (Ξ W_st).hom.app (Opposite.op V) ≫ π_tilde.app (Opposite.op V) :=
      congrArg ((Ξ W_st).hom.app (Opposite.op V) ≫ ·)
        (congrArg (fun τ => τ.app (Opposite.op V)) hq_bar_π)
    dsimp [q_pt] at hq_app
    rw [← CategoryTheory.Category.assoc ((Ξ W_st).hom.app (Opposite.op V)),
      CategoryTheory.Iso.hom_inv_id_app_assoc] at hq_app
    have heval := congrArg (fun φ => φ.hom c) hq_app
    change (bar_π.app (Opposite.op V)).hom (Submodule.Quotient.mk c) =
      (((Ξ W_st).hom.app (Opposite.op V) ≫ π_tilde.app (Opposite.op V)).hom) c at heval
    rw [heval, hΞ_eval W_st 𝒬_s (η_Z.app (Opposite.op (B_is.obj W_st))) V c]
    let f_lin : R →ₗ[R] ↑(𝒬_s.obj.obj (Opposite.op V)) :=
      ((θ_Z (B_is.obj V)).hom).hom.comp (LocallyConstant.constₗ R)
    have hterm : ∀ (g : V ⟶ W_st) (r : R),
        r • (𝒬_s.obj.map (Opposite.op g)).hom
          ((η_Z.app (Opposite.op (B_is.obj W_st))).hom (1 : R)) = f_lin r := by
      intro g r
      have hnat := congrArg (fun φ : R_mod ⟶ C_Z.obj.obj (Opposite.op (B_is.obj V)) =>
        φ.hom (1 : R)) (η_Z.naturality (Opposite.op (B_is.map g))).symm
      change (𝒬_s.obj.map (Opposite.op g)).hom
          ((η_Z.app (Opposite.op (B_is.obj W_st))).hom (1 : R)) =
        (η_Z.app (Opposite.op (B_is.obj V))).hom (1 : R) at hnat
      rw [hnat, hθ_Z_unit (B_is.obj V)]
      change r • f_lin (1 : R) = f_lin r
      rw [← map_smul, smul_eq_mul, mul_one]
    change (∑ g ∈ c.support, c g • (𝒬_s.obj.map (Opposite.op g)).hom
      ((η_Z.app (Opposite.op (B_is.obj W_st))).hom (1 : R))) = f_lin (c.sum (fun _ r => r))
    have hsum_eq : (∑ g ∈ c.support, c g • (𝒬_s.obj.map (Opposite.op g)).hom
        ((η_Z.app (Opposite.op (B_is.obj W_st))).hom (1 : R))) =
        ∑ g ∈ c.support, f_lin (c g) :=
      Finset.sum_congr rfl fun g _ => hterm g (c g)
    rw [hsum_eq, ← map_sum]
    rfl

  have hbar_π_inj : CategoryTheory.Presheaf.IsLocallyInjective J_S bar_π := by
    refine CategoryTheory.Presheaf.IsLocallyInjective.mk fun {V_op} cbar₁ cbar₂ heq => ?_
    let V := V_op.unop
    obtain ⟨c₁, rfl⟩ := Submodule.Quotient.mk_surjective (K_sub V) cbar₁
    obtain ⟨c₂, rfl⟩ := Submodule.Quotient.mk_surjective (K_sub V) cbar₂
    have hsub0 : (bar_π.app (Opposite.op V)).hom (Submodule.Quotient.mk (c₁ - c₂)) = 0 := by
      rw [Submodule.Quotient.mk_sub, map_sub]
      exact sub_eq_zero.mpr heq
    rw [hbar_π_mk V (c₁ - c₂)] at hsub0
    have hconst0 : LocallyConstant.const ↥(Fgt_Z.obj (B_is.obj V)).left
        ((c₁ - c₂).sum (fun _ r => r)) = 0 := by
      have hinv := congrArg (fun x => ((θ_Z (B_is.obj V)).inv).hom x) hsub0
      change (((θ_Z (B_is.obj V)).hom ≫ (θ_Z (B_is.obj V)).inv).hom)
          (LocallyConstant.const _ ((c₁ - c₂).sum (fun _ r => r))) =
        ((θ_Z (B_is.obj V)).inv).hom 0 at hinv
      rw [(θ_Z (B_is.obj V)).hom_inv_id, LinearMap.map_zero] at hinv
      exact hinv
    rw [hMem S V]
    intro x
    obtain ⟨Y, u, y, hy, hmem_K⟩ := hLocKer V (c₁ - c₂) hconst0 x
    refine ⟨Y, u, y, ?_, hMorEtale u, hy⟩
    change (Q_pt.map (Opposite.op u)).hom (Submodule.Quotient.mk c₁) =
      (Q_pt.map (Opposite.op u)).hom (Submodule.Quotient.mk c₂)
    apply sub_eq_zero.mp
    rw [← map_sub, ← Submodule.Quotient.mk_sub]
    change Submodule.Quotient.mk (p := K_sub Y)
      (Finsupp.lmapDomain R R (fun g : V ⟶ W_st => u ≫ g) (c₁ - c₂)) = 0
    exact (Submodule.Quotient.mk_eq_zero (K_sub Y)).mpr hmem_K

  have hbar_π_surj : CategoryTheory.Presheaf.IsLocallySurjective J_S bar_π := by
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {V} s => ?_
    rw [hMem S V]
    intro x
    let f_lc := ((θ_Z (B_is.obj V)).inv).hom s
    obtain ⟨Y, u, y, c_Y, hy, hconst_eq⟩ := hLocSurj V f_lc x
    refine ⟨Y, u, y, ?_, hMorEtale u, hy⟩
    refine ⟨Submodule.Quotient.mk c_Y, ?_⟩
    change (bar_π.app (Opposite.op Y)).hom (Submodule.Quotient.mk c_Y) =
      (𝒬_s.obj.map (Opposite.op u)).hom s
    rw [hbar_π_mk Y c_Y, hconst_eq]
    have hnat := congrArg (fun φ => φ.hom f_lc) (hθ_Z_nat (B_is.map u)).symm
    change ((θ_Z (B_is.obj Y)).hom).hom (f_lc.comap (Fgt_Z.map (B_is.map u)).left.base.hom) =
      (𝒬_s.obj.map (Opposite.op u)).hom (((θ_Z (B_is.obj V)).inv ≫ (θ_Z (B_is.obj V)).hom).hom s)
      at hnat
    rw [(θ_Z (B_is.obj V)).inv_hom_id] at hnat
    exact hnat

  have hbar_π_W : J_S.W bar_π :=
    (J_S.W_iff_isLocallyBijective bar_π).mpr ⟨hbar_π_inj, hbar_π_surj⟩
  haveI : CategoryTheory.IsIso (L_sh.map bar_π) := (J_S.W_iff bar_π).mp hbar_π_W
  let ψ_Q : L_sh.obj Q_pt ⟶ 𝒬_s := L_sh.map bar_π ≫ adj_S.counit.app 𝒬_s
  haveI : CategoryTheory.IsIso ψ_Q := by
    dsimp [ψ_Q]
    infer_instance
  have hq_ψ : L_sh.map q_pt ≫ ψ_Q = π W_st := by
    dsimp [ψ_Q]
    rw [← CategoryTheory.Category.assoc, ← L_sh.map_comp, hq_bar_π]
    exact (CategoryTheory.Adjunction.homEquiv_counit adj_S P₂ 𝒬_s π_tilde).symm.trans
      ((adj_S.homEquiv P₂ 𝒬_s).symm_apply_apply (π W_st))
  let e_SC : SC_pre.map L_sh ≅
      CategoryTheory.ShortComplex.mk (weilEtaleLocalFreeMap S m v) (π W_st) h0 :=
    CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
      (CategoryTheory.asIso ψ_Q)
      ((CategoryTheory.Category.id_comp _).trans
        ((hμ_map_sh v).symm.trans (CategoryTheory.Category.comp_id _).symm))
      ((CategoryTheory.Category.id_comp _).trans hq_ψ.symm)
  exact CategoryTheory.ShortComplex.shortExact_of_iso e_SC hSE_sh

theorem weil_slice_freeYoneda_torsion_ext_iso_any_mod (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
    ∃ ψ_slice : ∀ (W : S.Etale) (q : ℕ),
        CategoryTheory.Abelian.Ext.{u}
          (weilEtaleLocalFreeSheaf S m W) (weilEtaleModuleUnit S m) q →+
          weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left m q,
      (∀ (W : S.Etale) (q : ℕ), Function.Bijective (ψ_slice W q)) ∧
      (∀ {W₁ W₂ : S.Etale} (v : Quiver.Hom W₁ W₂) (q : ℕ)
          (p_q : weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left m q →+
            weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left m q),
        WeilIsTorsionEtalePullback
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left m q p_q →
        ∀ ξ : CategoryTheory.Abelian.Ext.{u}
            (weilEtaleLocalFreeSheaf S m W₂) (weilEtaleModuleUnit S m) q,
          ψ_slice W₁ q
            ((CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S m v)).comp ξ
              (Nat.zero_add q)) =
            p_q (ψ_slice W₂ q ξ)) :=
by
  classical
  obtain ⟨hAbstractExtBij, hMapExact_comp, hMapExact_iso⟩ :=
    weil_etale_abstract_exact_functor_ext_package.{u}

  have hop_eq : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀] {X Y : C₀}
      (f : X ⟶ Y),
      (Opposite.op f : Opposite.op Y ⟶ Opposite.op X) = f.op := by
    intro C₀ _ X Y f
    calc
      (Opposite.op f : Opposite.op Y ⟶ Opposite.op X)
        = (Opposite.op f : Opposite.op Y ⟶ Opposite.op X).unop.op := (Quiver.Hom.op_unop _).symm
      _ = f.op := congrArg Quiver.Hom.op Quiver.Hom.unop_op'
  have hop_comp : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀] {X Y Z : C₀}
      (f : X ⟶ Y) (g : Y ⟶ Z),
      @CategoryTheory.CategoryStruct.comp C₀ᵒᵖ _
        (Opposite.op Z) (Opposite.op Y) (Opposite.op X)
        (Opposite.op g) (Opposite.op f) =
        Opposite.op (f ≫ g) := by
    intro C₀ _ X Y Z f g
    rw [hop_eq f, hop_eq g, hop_eq (f ≫ g), ← CategoryTheory.op_comp]
  have hop_id : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀] (X : C₀),
      (Opposite.op (𝟙 X) : Opposite.op X ⟶ Opposite.op X) = 𝟙 (Opposite.op X) := by
    intro C₀ _ X
    rw [hop_eq, CategoryTheory.op_id]

  have hMap3_op :
      ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
        {D₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D₀]
        (F : C₀ᵒᵖ ⥤ D₀) {X₀ X₁ X₂ X₃ : C₀}
        (f₁ : X₀ ⟶ X₁) (f₂ : X₁ ⟶ X₂) (f₃ : X₂ ⟶ X₃),
        (F.map (Opposite.op f₃) ≫ F.map (Opposite.op f₂)) ≫ F.map f₁.op =
          F.map (Opposite.op (f₁ ≫ f₂ ≫ f₃)) := by
    intro C₀ _ D₀ _ F X₀ X₁ X₂ X₃ f₁ f₂ f₃
    have hf₁ : f₁.op = Opposite.op f₁ := (hop_eq f₁).symm
    rw [hf₁, ← F.map_comp, hop_comp, ← F.map_comp, hop_comp]

  have hNatComp :
      ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
        {D₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D₀]
        {F G : C₀ᵒᵖ ⥤ D₀} {M : D₀} {U V : C₀}
        (c : M ⟶ F.obj (Opposite.op V)) (u : U ⟶ V) (η : F ⟶ G),
        (c ≫ F.map (Opposite.op u)) ≫ η.app (Opposite.op U) =
          (c ≫ η.app (Opposite.op V)) ≫ G.map (Opposite.op u) := by
    intro C₀ _ D₀ _ F G M U V c u η
    rw [CategoryTheory.Category.assoc, η.naturality (Opposite.op u),
      ← CategoryTheory.Category.assoc]

  have hPostMapIsoBij :
      ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
        {D₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D₀]
        (F : C₀ᵒᵖ ⥤ D₀) (M : D₀) {X Y : C₀} (e : X ≅ Y),
        Function.Bijective
          (fun ψ : M ⟶ F.obj (Opposite.op Y) => ψ ≫ F.map (Opposite.op e.hom)) := by
    intro C₀ _ D₀ _ F M X Y e
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun ψ => ψ ≫ F.map (Opposite.op e.inv), fun ψ => ?_, fun ψ => ?_⟩
    · dsimp only
      rw [CategoryTheory.Category.assoc, ← F.map_comp, hop_comp,
        e.inv_hom_id, hop_id, F.map_id, CategoryTheory.Category.comp_id]
    · dsimp only
      rw [CategoryTheory.Category.assoc, ← F.map_comp, hop_comp,
        e.hom_inv_id, hop_id, F.map_id, CategoryTheory.Category.comp_id]

  have hPostcomp_apply :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
        [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
        {Y Z : C} {n : ℕ} (b : CategoryTheory.Abelian.Ext.{u} Y Z n)
        (X : C) {p r : ℕ} (h : p + n = r) (a : CategoryTheory.Abelian.Ext.{u} X Y p),
        b.postcomp X h a = a.comp b h := by
    intro C _ _ _ Y Z n b X p r h a
    rfl

  have hPrecomp_apply :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
        [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
        {X Y : C} {n : ℕ} (a : CategoryTheory.Abelian.Ext.{u} X Y n)
        (Z : C) {p r : ℕ} (h : n + p = r) (b : CategoryTheory.Abelian.Ext.{u} Y Z p),
        a.precomp Z h b = a.comp b h := by
    intro C _ _ _ X Y n a Z p r h b
    rfl

  have hChain4 :
      ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
        {M₀ M₁ M₂ M₃ M₄ M'₂ N : D}
        (u : M₀ ⟶ M₁) (m₁ : M₁ ⟶ M₂) (d₁ : M₂ ⟶ M₃) (e : M₃ ⟶ M₄)
        (d₀ : M₁ ⟶ M'₂) (m₂ : M'₂ ⟶ M₃) (q₀ : M₀ ⟶ N) (t₀ : N ⟶ M'₂) (res : N ⟶ M₄),
        m₁ ≫ d₁ = d₀ ≫ m₂ →
        u ≫ d₀ = q₀ ≫ t₀ →
        (t₀ ≫ m₂) ≫ e = res →
        (u ≫ m₁) ≫ d₁ ≫ e = q₀ ≫ res := by
    intro D _ M₀ M₁ M₂ M₃ M₄ M'₂ N u m₁ d₁ e d₀ m₂ q₀ t₀ res h_nat h_unit h_tail
    calc
      (u ≫ m₁) ≫ d₁ ≫ e = u ≫ (m₁ ≫ d₁) ≫ e := by simp only [CategoryTheory.Category.assoc]
      _ = (u ≫ d₀) ≫ m₂ ≫ e := by rw [h_nat]; simp only [CategoryTheory.Category.assoc]
      _ = q₀ ≫ ((t₀ ≫ m₂) ≫ e) := by rw [h_unit]; simp only [CategoryTheory.Category.assoc]
      _ = q₀ ≫ res := by rw [h_tail]

  have hPostcompIsoBij :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
        [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
        {Y₁ Y₂ : C} (α : Y₁ ⟶ Y₂) (β : Y₂ ⟶ Y₁),
        α ≫ β = 𝟙 Y₁ → β ≫ α = 𝟙 Y₂ →
        ∀ (X : C) (q : ℕ),
          Function.Bijective
            ((CategoryTheory.Abelian.Ext.mk₀ β).postcomp X (Nat.add_zero q)) := by
    intro C _ _ _ Y₁ Y₂ α β hαβ hβα X q
    refine Function.bijective_iff_has_inverse.mpr
      ⟨(CategoryTheory.Abelian.Ext.mk₀ α).postcomp X (Nat.add_zero q), fun u => ?_, fun v => ?_⟩
    · change (u.comp (CategoryTheory.Abelian.Ext.mk₀ β) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero q) = u
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβα,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · change (v.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β) (Nat.add_zero q) = v
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]

  have hExtSquare :
      ∀ {C_S C₁ C₂ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C_S] [CategoryTheory.Abelian C_S]
        [CategoryTheory.HasExt.{u} C_S] [CategoryTheory.EnoughInjectives C_S]
        [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
        [CategoryTheory.HasExt.{u} C₁]
        [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
        [CategoryTheory.HasExt.{u} C₂] [CategoryTheory.EnoughInjectives C₂]
        (G₁ : C_S ⥤ C₁) [G₁.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G₁]
        [CategoryTheory.Limits.PreservesFiniteColimits G₁]
        (G₂ : C_S ⥤ C₂) [G₂.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G₂]
        [CategoryTheory.Limits.PreservesFiniteColimits G₂]
        (H : C₂ ⥤ C₁) [H.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits H]
        [CategoryTheory.Limits.PreservesFiniteColimits H]
        (ζ : G₂ ⋙ H ≅ G₁)
        {X₁ X₂ U_S : C_S} {U₁ : C₁} {U₂ : C₂}
        (f : X₁ ⟶ X₂)
        (δ₁ : U₁ ⟶ G₁.obj X₁) (δ₂ : U₂ ⟶ G₂.obj X₂)
        (α₁ : U₁ ⟶ G₁.obj U_S) (β₁ : G₁.obj U_S ⟶ U₁)
        (α₂ : U₂ ⟶ G₂.obj U_S) (β₂ : G₂.obj U_S ⟶ U₂)
        (α_h : U₁ ⟶ H.obj U₂) (β_h : H.obj U₂ ⟶ U₁)
        (hLeft : δ₁ ≫ G₁.map f = α_h ≫ H.map δ₂ ≫ ζ.hom.app X₂)
        (hRight : α_h ≫ H.map α₂ ≫ ζ.hom.app U_S = α₁)
        (hαβ₁ : α₁ ≫ β₁ = 𝟙 U₁)
        (hβα₂ : β₂ ≫ α₂ = 𝟙 (G₂.obj U_S))
        (hβα_h : β_h ≫ α_h = 𝟙 (H.obj U₂))
        (q : ℕ) (ξ : CategoryTheory.Abelian.Ext.{u} X₂ U_S q),
        (((CategoryTheory.Abelian.Ext.mk₀ β₁).postcomp U₁ (Nat.add_zero q)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ δ₁).precomp (G₁.obj U_S) (Nat.zero_add q)).comp
            (G₁.mapExtAddHom X₁ U_S q)))
          ((CategoryTheory.Abelian.Ext.mk₀ f).comp ξ (Nat.zero_add q)) =
        (((CategoryTheory.Abelian.Ext.mk₀ β_h).postcomp U₁ (Nat.add_zero q)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ α_h).precomp (H.obj U₂) (Nat.zero_add q)).comp
            (H.mapExtAddHom U₂ U₂ q)))
          ((((CategoryTheory.Abelian.Ext.mk₀ β₂).postcomp U₂ (Nat.add_zero q)).comp
            (((CategoryTheory.Abelian.Ext.mk₀ δ₂).precomp (G₂.obj U_S) (Nat.zero_add q)).comp
              (G₂.mapExtAddHom X₂ U_S q))) ξ) := by
    intro C_S _ _ _ _ C₁ _ _ _ C₂ _ _ _ _ G₁ _ _ _ G₂ _ _ _ H _ _ _ ζ
      X₁ X₂ U_S U₁ U₂ f δ₁ δ₂ α₁ β₁ α₂ β₂ α_h β_h hLeft hRight hαβ₁ hβα₂ hβα_h q ξ
    have h_top : δ₁ ≫ G₁.map f ≫ ζ.inv.app X₂ = α_h ≫ H.map δ₂ := by
      calc
        δ₁ ≫ G₁.map f ≫ ζ.inv.app X₂
          = (δ₁ ≫ G₁.map f) ≫ ζ.inv.app X₂ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (α_h ≫ H.map δ₂ ≫ ζ.hom.app X₂) ≫ ζ.inv.app X₂ := by rw [hLeft]
        _ = α_h ≫ H.map δ₂ ≫ (ζ.hom.app X₂ ≫ ζ.inv.app X₂) := by
            simp only [CategoryTheory.Category.assoc]
        _ = α_h ≫ H.map δ₂ := by
            rw [ζ.hom_inv_id_app]
            exact congrArg (α_h ≫ ·) (CategoryTheory.Category.comp_id (H.map δ₂))
    have h_bot : ζ.hom.app U_S ≫ β₁ = H.map β₂ ≫ β_h := by
      calc
        ζ.hom.app U_S ≫ β₁
          = 𝟙 (H.obj (G₂.obj U_S)) ≫ ζ.hom.app U_S ≫ β₁ :=
            (CategoryTheory.Category.id_comp _).symm
        _ = H.map (β₂ ≫ α₂) ≫ ζ.hom.app U_S ≫ β₁ := by
            rw [hβα₂, H.map_id]
        _ = H.map β₂ ≫ 𝟙 (H.obj U₂) ≫ H.map α₂ ≫ ζ.hom.app U_S ≫ β₁ := by
            rw [H.map_comp, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
        _ = H.map β₂ ≫ β_h ≫ (α_h ≫ H.map α₂ ≫ ζ.hom.app U_S) ≫ β₁ := by
