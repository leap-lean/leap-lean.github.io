                MvPolynomial.X (iu_gt k hk_gt) * MvPolynomial.X (iv_gt k hk_gt) else 0 := by
          dsimp [P₀]
          rw [map_sub, map_mul, map_pow, MvPolynomial.rename_C, MvPolynomial.rename_X,
            h_emb_rw, map_sum]
          congr 1
          refine Finset.sum_congr rfl fun k _ => ?_
          split_ifs with hk_gt
          · rw [map_mul, MvPolynomial.rename_X, MvPolynomial.rename_X,
              h_emb_ru k hk_gt, h_emb_rv k hk_gt]
          · exact map_zero _
        rw [hsum_split, h_ren_P0]
        ring
      have h_vanish : ∀ x ∈ J_j, MvPolynomial.aeval ψ_fn x = 0 := by
        intro x hx
        have hker : J_j ≤ RingHom.ker (MvPolynomial.aeval ψ_fn).toRingHom := by
          rw [Ideal.span_le]
          rintro _ ⟨ν, rfl⟩
          change MvPolynomial.aeval ψ_fn (θ.symm (g_quad j.castSucc ν)) = 0
          refine Fin.lastCases ?_ (fun μ => ?_) ν
          · dsimp only [g_quad]
            rw [Fin.lastCases_last, h_qA_pull, map_add, map_sum, map_sub, MvPolynomial.aeval_X]
            have h1 : (∑ k : Fin (m + 1),
                (MvPolynomial.aeval (R := K) ψ_fn)
                  (if hk_lt : k.1 < j.1 then
                    MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0)) = 0 := by
              refine Finset.sum_eq_zero fun k _ => ?_
              split_ifs with hk_lt
              · rw [map_mul, MvPolynomial.aeval_X]
                have h0 : ψ_fn (iu_lt k hk_lt) = 0 := by
                  dsimp only [ψ_fn, iu_lt]
                  have hlt2 : 2 * k.1 < 2 * j.1 := by omega
                  have hmod2 : (2 * k.1) % 2 = 0 := by omega
                  simp [hlt2, hmod2]
                rw [h0, zero_mul]
              · exact map_zero _
