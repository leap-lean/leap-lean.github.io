          CategoryTheory.IsGrothendieckAbelian.locallySmall
        
        have hCover : ∀ E : 𝒞, ∃ (P : 𝒞) (π_E : P ⟶ E),
            CategoryTheory.Epi π_E ∧
            CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id P) := by
          intro E
          let J_E : Type u := Σ x : Idx, Shrink.{u} (F_gen x ⟶ E)
          let fam : J_E → 𝒞 := fun j => F_gen j.1
          let P : 𝒞 := ∐ fam
          let π_E : P ⟶ E := CategoryTheory.Limits.Sigma.desc
            (fun j => (equivShrink.{u} (F_gen j.1 ⟶ E)).symm j.2)
          have hEpi : CategoryTheory.Epi π_E := by
            refine ⟨fun {T} g₁ g₂ h => sub_eq_zero.mp (hSep (g₁ - g₂) fun x f => ?_)⟩
            let j₀ : J_E := ⟨x, equivShrink.{u} (F_gen x ⟶ E) f⟩
            have hj := congrArg (CategoryTheory.Limits.Sigma.ι fam j₀ ≫ ·)
              (by rw [CategoryTheory.Preadditive.comp_sub, sub_eq_zero]; exact h :
                π_E ≫ (g₁ - g₂) = 0)
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Limits.comp_zero] at hj
            simpa [j₀] using hj
          have hMonoP : CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id P) := by
            haveI := CategoryTheory.AB4OfSize.ofShape (C := 𝒞) J_E
            let nat_m : CategoryTheory.Discrete.functor fam ⟶ CategoryTheory.Discrete.functor fam :=
              CategoryTheory.Discrete.natTrans (fun ⟨j⟩ => m • CategoryTheory.CategoryStruct.id (fam j))
            haveI : ∀ d : CategoryTheory.Discrete J_E, CategoryTheory.Mono (nat_m.app d) :=
              fun ⟨j⟩ => hF_mono j.1
            haveI := CategoryTheory.NatTrans.mono_of_mono_app nat_m
            exact CategoryTheory.Limits.colim.map_mono' nat_m
              (CategoryTheory.Limits.colimit.isColimit _)
              (CategoryTheory.Limits.colimit.isColimit _)
              (m • CategoryTheory.CategoryStruct.id P)
              (fun ⟨j⟩ => by
                change CategoryTheory.Limits.Sigma.ι fam j ≫ (m • CategoryTheory.CategoryStruct.id P) =
                  (m • CategoryTheory.CategoryStruct.id (fam j)) ≫ CategoryTheory.Limits.Sigma.ι fam j
                rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
                  CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
          exact ⟨P, π_E, hEpi, hMonoP⟩

        
        have hEfface : ∀ (n : ℕ) (K Y : 𝒞) (α : CategoryTheory.Abelian.Ext.{u} K Y (n + 1)),
            ∃ (P : 𝒞) (v : P ⟶ K), CategoryTheory.Epi v ∧
              CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id P) ∧
              (CategoryTheory.Abelian.Ext.mk₀ v).comp α (Nat.zero_add (n + 1)) = 0 := by
          intro n
          induction n with
          | zero =>
            intro K Y α
            let J_Y : 𝒞 := CategoryTheory.Injective.under Y
            let ι_Y : Y ⟶ J_Y := CategoryTheory.Injective.ι Y
            let Q_Y : 𝒞 := CategoryTheory.Limits.cokernel ι_Y
            let π_Y : J_Y ⟶ Q_Y := CategoryTheory.Limits.cokernel.π ι_Y
            have hSE_Y : (CategoryTheory.ShortComplex.mk ι_Y π_Y
                (CategoryTheory.Limits.cokernel.condition ι_Y)).ShortExact :=
              CategoryTheory.ShortComplex.ShortExact.mk'
                (CategoryTheory.ShortComplex.exact_cokernel ι_Y) inferInstance inferInstance
            have hα_ι : α.comp (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero 1) = 0 :=
              CategoryTheory.Abelian.Ext.eq_zero_of_injective _
            obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hSE_Y α
              hα_ι (Nat.zero_add 1)
            obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective K Q_Y).2 x₃
            let W : 𝒞 := CategoryTheory.Limits.pullback f π_Y
            let p₁ : W ⟶ K := CategoryTheory.Limits.pullback.fst f π_Y
            let p₂ : W ⟶ J_Y := CategoryTheory.Limits.pullback.snd f π_Y
            have hEpi_p₁ : CategoryTheory.Epi
                (CategoryTheory.Limits.PullbackCone.mk p₁ p₂
                  CategoryTheory.Limits.pullback.condition).fst :=
              CategoryTheory.Abelian.epi_fst_of_isLimit f π_Y
                (CategoryTheory.Limits.pullbackIsPullback f π_Y)
            haveI : CategoryTheory.Epi p₁ := hEpi_p₁
            obtain ⟨P, π_W, hEpi_W, hMono_P⟩ := hCover W
            haveI : CategoryTheory.Epi π_W := hEpi_W
            let v : P ⟶ K := π_W ≫ p₁
            refine ⟨P, v, CategoryTheory.epi_comp π_W p₁, hMono_P, ?_⟩
            rw [← CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ v) (CategoryTheory.Abelian.Ext.mk₀ f)
              hSE_Y.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            have hvf : v ≫ f = (π_W ≫ p₂) ≫ π_Y := by
              dsimp [v]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                CategoryTheory.Category.assoc]
            rw [hvf, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc
                (CategoryTheory.Abelian.Ext.mk₀ (π_W ≫ p₂))
                (CategoryTheory.Abelian.Ext.mk₀ π_Y) hSE_Y.extClass
                (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
              hSE_Y.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
          | succ n ih =>
            intro K Y α
            let J_Y : 𝒞 := CategoryTheory.Injective.under Y
            let ι_Y : Y ⟶ J_Y := CategoryTheory.Injective.ι Y
            let Q_Y : 𝒞 := CategoryTheory.Limits.cokernel ι_Y
            let π_Y : J_Y ⟶ Q_Y := CategoryTheory.Limits.cokernel.π ι_Y
            have hSE_Y : (CategoryTheory.ShortComplex.mk ι_Y π_Y
                (CategoryTheory.Limits.cokernel.condition ι_Y)).ShortExact :=
              CategoryTheory.ShortComplex.ShortExact.mk'
                (CategoryTheory.ShortComplex.exact_cokernel ι_Y) inferInstance inferInstance
            have hα_ι : α.comp (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero (n + 2)) = 0 :=
              CategoryTheory.Abelian.Ext.eq_zero_of_injective _
            obtain ⟨β, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hSE_Y α
              hα_ι (rfl : (n + 1) + 1 = n + 2)
            obtain ⟨P, v, hEpi_v, hMono_P, hv_β⟩ := ih K Q_Y β
            refine ⟨P, v, hEpi_v, hMono_P, ?_⟩
            rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ v) β
              hSE_Y.extClass (Nat.zero_add (n + 1)) rfl (Nat.zero_add (n + 2)),
              hv_β, CategoryTheory.Abelian.Ext.zero_comp]

        
        have hKerEpiSE : ∀ {P K : 𝒞} (v : P ⟶ K) [CategoryTheory.Epi v],
            (CategoryTheory.ShortComplex.mk (CategoryTheory.Limits.kernel.ι v) v
              (CategoryTheory.Limits.kernel.condition v)).ShortExact := by
          intro P K v _
          let u := CategoryTheory.Limits.kernel.ι v
          let e := CategoryTheory.Abelian.coimageIsoImage' v
          haveI : CategoryTheory.Epi (CategoryTheory.Limits.image.ι v) := by
            have hfv : CategoryTheory.Limits.factorThruImage v ≫ CategoryTheory.Limits.image.ι v = v :=
              CategoryTheory.Limits.image.fac v
            haveI : CategoryTheory.Epi
                (CategoryTheory.Limits.factorThruImage v ≫ CategoryTheory.Limits.image.ι v) := by
              rwa [hfv]
            exact CategoryTheory.epi_of_epi (CategoryTheory.Limits.factorThruImage v)
              (CategoryTheory.Limits.image.ι v)
          haveI : CategoryTheory.IsIso (CategoryTheory.Limits.image.ι v) :=
            CategoryTheory.isIso_of_mono_of_epi (CategoryTheory.Limits.image.ι v)
          have hfac : v = CategoryTheory.Limits.cokernel.π u ≫ e.hom ≫
              CategoryTheory.Limits.image.ι v := by
            dsimp [u, e]
            conv_lhs => rw [← CategoryTheory.Limits.image.fac v]
            rw [← CategoryTheory.Abelian.factorThruImage_comp_coimageIsoImage'_inv v]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
          let cf := CategoryTheory.Limits.CokernelCofork.ofπ v
            (CategoryTheory.Limits.kernel.condition v)
          have hColim : CategoryTheory.Limits.IsColimit cf :=
            CategoryTheory.Limits.Cofork.IsColimit.mk cf
              (fun s => CategoryTheory.inv (CategoryTheory.Limits.image.ι v) ≫ e.inv ≫
                CategoryTheory.Limits.cokernel.desc u s.π
                  (s.condition.trans CategoryTheory.Limits.zero_comp))
              (fun s => by
                let m_s := CategoryTheory.inv (CategoryTheory.Limits.image.ι v) ≫ e.inv ≫
                  CategoryTheory.Limits.cokernel.desc u s.π
                    (s.condition.trans CategoryTheory.Limits.zero_comp)
                change v ≫ m_s = s.π
                have h1 : v ≫ m_s =
                    (CategoryTheory.Limits.cokernel.π u ≫ e.hom ≫ CategoryTheory.Limits.image.ι v) ≫
                      m_s := congrArg (· ≫ m_s) hfac
                rw [h1]
                dsimp [m_s]
                simp only [CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc,
                  CategoryTheory.Iso.hom_inv_id_assoc, CategoryTheory.Limits.cokernel.π_desc])
              (fun s m_hom hm => by
                apply (CategoryTheory.cancel_epi v).mp
                refine hm.trans ?_; symm
                let m_s := CategoryTheory.inv (CategoryTheory.Limits.image.ι v) ≫ e.inv ≫
                  CategoryTheory.Limits.cokernel.desc u s.π
                    (s.condition.trans CategoryTheory.Limits.zero_comp)
                change v ≫ m_s = s.π
                have h1 : v ≫ m_s =
                    (CategoryTheory.Limits.cokernel.π u ≫ e.hom ≫ CategoryTheory.Limits.image.ι v) ≫
                      m_s := congrArg (· ≫ m_s) hfac
                rw [h1]
                dsimp [m_s]
                simp only [CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc,
                  CategoryTheory.Iso.hom_inv_id_assoc, CategoryTheory.Limits.cokernel.π_desc])
          exact CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _ hColim)
            inferInstance inferInstance

        
        intro q₀
        induction q₀ with
        | zero =>
          intro K hMonoK ω₀
          let J_B : 𝒞 := CategoryTheory.Injective.under B
          let ι_B : B ⟶ J_B := CategoryTheory.Injective.ι B
          let Q_B : 𝒞 := CategoryTheory.Limits.cokernel ι_B
          let π_B : J_B ⟶ Q_B := CategoryTheory.Limits.cokernel.π ι_B
          have hSE_B : (CategoryTheory.ShortComplex.mk ι_B π_B
              (CategoryTheory.Limits.cokernel.condition ι_B)).ShortExact :=
            CategoryTheory.ShortComplex.ShortExact.mk'
              (CategoryTheory.ShortComplex.exact_cokernel ι_B) inferInstance inferInstance
          have hω_ι : ω₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 1) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hSE_B ω₀
            hω_ι (Nat.zero_add 1)
          obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective K Q_B).2 x₃
          let W : 𝒞 := CategoryTheory.Limits.pullback f π_B
          let p₁ : W ⟶ K := CategoryTheory.Limits.pullback.fst f π_B
          let p₂ : W ⟶ J_B := CategoryTheory.Limits.pullback.snd f π_B
          have hEpi_p₁ : CategoryTheory.Epi
              (CategoryTheory.Limits.PullbackCone.mk p₁ p₂
                CategoryTheory.Limits.pullback.condition).fst :=
            CategoryTheory.Abelian.epi_fst_of_isLimit f π_B
              (CategoryTheory.Limits.pullbackIsPullback f π_B)
          haveI : CategoryTheory.Epi p₁ := hEpi_p₁
          obtain ⟨P, π_W, hEpi_W, _⟩ := hCover W
          haveI : CategoryTheory.Epi π_W := hEpi_W
          let v : P ⟶ K := π_W ≫ p₁
          haveI : CategoryTheory.Epi v := CategoryTheory.epi_comp π_W p₁
          let g_P : P ⟶ J_B := π_W ≫ p₂
          have hvf : v ≫ f = g_P ≫ π_B := by
            dsimp [v, g_P]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              CategoryTheory.Category.assoc]
          let u : CategoryTheory.Limits.kernel v ⟶ P := CategoryTheory.Limits.kernel.ι v
          have hSE_P := hKerEpiSE v
          have hug_zero : (u ≫ g_P) ≫ π_B = 0 := by
            rw [CategoryTheory.Category.assoc, ← hvf, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
          let kf_B := hSE_B.fIsKernel
          let φ : CategoryTheory.Limits.kernel v ⟶ B :=
            CategoryTheory.Limits.Fork.IsLimit.lift kf_B (u ≫ g_P)
              (hug_zero.trans CategoryTheory.Limits.comp_zero.symm)
          have hφ_fac : φ ≫ ι_B = u ≫ g_P :=
            CategoryTheory.Limits.Fork.IsLimit.lift_ι kf_B
          obtain ⟨ψ, hψ⟩ := hExtProp u v (CategoryTheory.Limits.kernel.condition v) hSE_P hMonoK φ
          let h_P : P ⟶ J_B := g_P - ψ ≫ ι_B
          have huh_zero : u ≫ h_P = 0 := by
            dsimp [h_P]
            rw [CategoryTheory.Preadditive.comp_sub, ← CategoryTheory.Category.assoc u ψ ι_B,
              hψ, hφ_fac, sub_self]
          let cf_K := hSE_P.gIsCokernel
          let f_lift : K ⟶ J_B :=
            CategoryTheory.Limits.Cofork.IsColimit.desc cf_K h_P
              (huh_zero.trans CategoryTheory.Limits.zero_comp.symm)
          have hf_lift : v ≫ f_lift = h_P :=
            CategoryTheory.Limits.Cofork.IsColimit.π_desc cf_K
          have hf_eq : f_lift ≫ π_B = f := by
            apply (CategoryTheory.cancel_epi v).mp
            rw [← CategoryTheory.Category.assoc, hf_lift]
            dsimp [h_P, π_B]
            rw [CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc ψ ι_B,
              CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero,
              sub_zero]
            exact hvf.symm
          rw [← hf_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ f_lift)
              (CategoryTheory.Abelian.Ext.mk₀ π_B) hSE_B.extClass
              (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
            hSE_B.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        | succ q₀ ih =>
          intro K hMonoK ω₀
          obtain ⟨P, v, hEpi_v, hMono_P, hv_ω⟩ := hEfface (q₀ + 1) K B ω₀
          haveI : CategoryTheory.Epi v := hEpi_v
          let u : CategoryTheory.Limits.kernel v ⟶ P := CategoryTheory.Limits.kernel.ι v
          have hSE_P := hKerEpiSE v
          obtain ⟨x₁, rfl⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSE_P B ω₀
            hv_ω (Nat.one_add (q₀ + 1))
          have hMonoK' : CategoryTheory.Mono
              (m • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel v)) := by
            have hcomm : (m • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel v)) ≫ u =
                u ≫ (m • CategoryTheory.CategoryStruct.id P) := by
              rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
                CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
            haveI := hMono_P
            haveI : CategoryTheory.Mono (u ≫ (m • CategoryTheory.CategoryStruct.id P)) :=
              CategoryTheory.mono_comp u (m • CategoryTheory.CategoryStruct.id P)
            haveI : CategoryTheory.Mono
                ((m • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel v)) ≫ u) := by
              rwa [hcomm]
            exact CategoryTheory.mono_of_mono _ u
          rw [ih (CategoryTheory.Limits.kernel v) hMonoK' x₁,
            CategoryTheory.Abelian.Ext.comp_zero]

      
      have hExtProp_UZ : ∀ {K' P K : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}}
          (u : K' ⟶ P) (v : P ⟶ K) (huv : u ≫ v = 0),
          (CategoryTheory.ShortComplex.mk u v huv).ShortExact →
          CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id K) →
          ∀ φ : K' ⟶ U_Z.obj ℐ, ∃ ψ : P ⟶ U_Z.obj ℐ, u ≫ ψ = φ := by
        intro K' P K u v huv hSE_u hMonoK φ
        let u_cok : CategoryTheory.Limits.cokernel (m • CategoryTheory.CategoryStruct.id K') ⟶
            CategoryTheory.Limits.cokernel (m • CategoryTheory.CategoryStruct.id P) :=
          CategoryTheory.Limits.cokernel.desc (m • CategoryTheory.CategoryStruct.id K')
            (u ≫ CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P))
            (by
              have hcond : (m • CategoryTheory.CategoryStruct.id P) ≫
                  CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P) = 0 :=
                CategoryTheory.Limits.cokernel.condition _
              calc (m • CategoryTheory.CategoryStruct.id K') ≫
                    (u ≫ CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P))
                  = u ≫ ((m • CategoryTheory.CategoryStruct.id P) ≫
                      CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P)) := by
                    rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
                      CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
                      CategoryTheory.Preadditive.comp_nsmul]
                _ = 0 := by rw [hcond, CategoryTheory.Limits.comp_zero])
        haveI hMono_ucok : CategoryTheory.Mono u_cok := by
          apply CategoryTheory.Abelian.Pseudoelement.mono_of_zero_of_map_zero
          intro q_bar hq_bar
          let π_K' := CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id K')
          let π_P := CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P)
          obtain ⟨x, rfl⟩ :=
            CategoryTheory.Abelian.Pseudoelement.pseudo_surjective_of_epi π_K' q_bar
          have hx_P : CategoryTheory.Abelian.Pseudoelement.pseudoApply π_P
              (CategoryTheory.Abelian.Pseudoelement.pseudoApply u x) = 0 := by
            rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply]
            have hfac : u ≫ π_P = π_K' ≫ u_cok :=
              (CategoryTheory.Limits.cokernel.π_desc _ _ _).symm
            rw [hfac, CategoryTheory.Abelian.Pseudoelement.comp_apply]
            exact hq_bar
          have hEx_P : (CategoryTheory.ShortComplex.mk (m • CategoryTheory.CategoryStruct.id P)
              π_P (CategoryTheory.Limits.cokernel.condition _)).Exact :=
            CategoryTheory.ShortComplex.exact_cokernel _
          obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact hEx_P _ hx_P
          have hvy_m : CategoryTheory.Abelian.Pseudoelement.pseudoApply
              (m • CategoryTheory.CategoryStruct.id K)
              (CategoryTheory.Abelian.Pseudoelement.pseudoApply v y) = 0 := by
            rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply]
            have hcomm : v ≫ (m • CategoryTheory.CategoryStruct.id K) =
                (m • CategoryTheory.CategoryStruct.id P) ≫ v := by
              rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            rw [hcomm, CategoryTheory.Abelian.Pseudoelement.comp_apply, hy,
              ← CategoryTheory.Abelian.Pseudoelement.comp_apply, huv,
              CategoryTheory.Abelian.Pseudoelement.zero_apply]
          have hvy_zero : CategoryTheory.Abelian.Pseudoelement.pseudoApply v y = 0 :=
            @CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero _ _ _ _ _
              (m • CategoryTheory.CategoryStruct.id K)
              (@CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono _ _ _ _ _ _ hMonoK)
              _ hvy_m
          obtain ⟨x₀, hx₀⟩ :=
            CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact hSE_u.exact y hvy_zero
          haveI : CategoryTheory.Mono u := hSE_u.mono_f
          have hx_eq : CategoryTheory.Abelian.Pseudoelement.pseudoApply
              (m • CategoryTheory.CategoryStruct.id K') x₀ = x := by
            apply CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono u
            rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply]
            have hcomm : (m • CategoryTheory.CategoryStruct.id K') ≫ u =
                u ≫ (m • CategoryTheory.CategoryStruct.id P) := by
              rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
                CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
            rw [hcomm, CategoryTheory.Abelian.Pseudoelement.comp_apply, hx₀, hy]
          rw [← hx_eq, ← CategoryTheory.Abelian.Pseudoelement.comp_apply,
            CategoryTheory.Limits.cokernel.condition,
            CategoryTheory.Abelian.Pseudoelement.zero_apply]
        let iso_UL : ∀ (𝒜 : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})
            (h𝒜 : m • CategoryTheory.CategoryStruct.id 𝒜 = 0),
            U_Z.obj (L_tors_obj Z_s 𝒜 h𝒜) ≅ 𝒜 := fun 𝒜 h𝒜 =>
          { hom := { hom := { app := fun _ => 𝟙 _ } }
            inv := { hom := { app := fun _ => 𝟙 _ } } }
        have hU_eUL : ∀ {ℳ : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R)}
            (α : L_tors_obj Z_s (Cok_m K') (hCok_m_tors K') ⟶ ℳ),
            U_Z.map α = (iso_UL (Cok_m K') (hCok_m_tors K')).hom ≫
              eUL_hom Z_s (Cok_m K') (hCok_m_tors K') ℳ α :=
          fun _ => CategoryTheory.Sheaf.hom_ext
            (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
        have heUL_id_iso : eUL_hom Z_s (Cok_m P) (hCok_m_tors P) _
            (CategoryTheory.CategoryStruct.id _) =
            (iso_UL (Cok_m P) (hCok_m_tors P)).inv :=
          CategoryTheory.Sheaf.hom_ext
            (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
        have hLm_fac : U_Z.map ((L_m_fun Z_s).map u) =
            (iso_UL (Cok_m K') (hCok_m_tors K')).hom ≫ u_cok ≫
              (iso_UL (Cok_m P) (hCok_m_tors P)).inv := by
          rw [hU_eUL]
          dsimp [L_m_fun]
          rw [Equiv.apply_symm_apply, heUL_id_iso]
        haveI : CategoryTheory.IsIso (iso_UL (Cok_m K') (hCok_m_tors K')).hom :=
          CategoryTheory.Iso.isIso_hom _
        haveI : CategoryTheory.IsIso (iso_UL (Cok_m P) (hCok_m_tors P)).inv :=
          CategoryTheory.Iso.isIso_inv _
        haveI : CategoryTheory.Mono
            ((iso_UL (Cok_m K') (hCok_m_tors K')).hom ≫ u_cok ≫
              (iso_UL (Cok_m P) (hCok_m_tors P)).inv) :=
          CategoryTheory.mono_comp _ (u_cok ≫ _)
        have hMono_UZ_u : CategoryTheory.Mono (U_Z.map ((L_m_fun Z_s).map u)) := by rwa [hLm_fac]
        haveI : U_Z.ReflectsMonomorphisms :=
          CategoryTheory.Functor.reflectsMonomorphisms_of_faithful U_Z
        haveI : CategoryTheory.Mono ((L_m_fun Z_s).map u) :=
          CategoryTheory.Functor.mono_of_mono_map U_Z hMono_UZ_u
        let φ_mod : (L_m_fun Z_s).obj K' ⟶ ℐ := (eLm_hom Z_s K' ℐ).symm φ
        let ψ_mod : (L_m_fun Z_s).obj P ⟶ ℐ :=
          CategoryTheory.Injective.factorThru φ_mod ((L_m_fun Z_s).map u)
        have hfac_mod : (L_m_fun Z_s).map u ≫ ψ_mod = φ_mod :=
          CategoryTheory.Injective.comp_factorThru φ_mod ((L_m_fun Z_s).map u)
        refine ⟨eLm_hom Z_s P ℐ ψ_mod, ?_⟩
        have hstep : eUL_hom Z_s (Cok_m K') (hCok_m_tors K') ℐ ((L_m_fun Z_s).map u ≫ ψ_mod) =
            u_cok ≫ eUL_hom Z_s (Cok_m P) (hCok_m_tors P) ℐ ψ_mod := by
          rw [heUL_comp Z_s (Cok_m K') (hCok_m_tors K')]
          dsimp [L_m_fun]
          rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc,
            heUL_id_comp Z_s (Cok_m P) (hCok_m_tors P)]
        calc u ≫ eLm_hom Z_s P ℐ ψ_mod
            = (u ≫ CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P)) ≫
                eUL_hom Z_s (Cok_m P) (hCok_m_tors P) ℐ ψ_mod :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = (CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id K') ≫ u_cok) ≫
                eUL_hom Z_s (Cok_m P) (hCok_m_tors P) ℐ ψ_mod := by
              rw [CategoryTheory.Limits.cokernel.π_desc]
          _ = CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id K') ≫
                (u_cok ≫ eUL_hom Z_s (Cok_m P) (hCok_m_tors P) ℐ ψ_mod) :=
              CategoryTheory.Category.assoc _ _ _
          _ = eLm_hom Z_s K' ℐ ((L_m_fun Z_s).map u ≫ ψ_mod) := by rw [← hstep]; rfl
          _ = eLm_hom Z_s K' ℐ φ_mod := by rw [hfac_mod]
          _ = φ := (eLm_hom Z_s K' ℐ).apply_symm_apply φ

      
      let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology Z_s
      let e_aff := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv Z_s AddCommGrpCat.{u}
      let e_sm := CategoryTheory.equivSmallModel.{u} Z_s.AffineEtale
      let Idx : Type u := CategoryTheory.SmallModel.{u} Z_s.AffineEtale
      let P_free : Idx → ((Z_s.AffineEtale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
        fun x => CategoryTheory.yoneda.obj (e_sm.inverse.obj x) ⋙ AddCommGrpCat.free
      let F_aff : Idx → CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} :=
        fun x => (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}).obj (P_free x)
      let F_gen : Idx → CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} :=
        fun x => e_aff.functor.obj (F_aff x)

      haveI : CategoryTheory.Limits.PreservesFiniteLimits e_aff.functor :=
        (CategoryTheory.Adjunction.rightAdjoint_preservesLimits.{0, 0}
          e_aff.symm.toAdjunction).preservesFiniteLimits
      haveI : e_aff.functor.Additive :=
        CategoryTheory.Functor.additive_of_preserves_binary_products e_aff.functor
      haveI : (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}).Additive :=
        CategoryTheory.Functor.additive_of_preserves_binary_products _

      have hF_mono : ∀ x : Idx,
          CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id (F_gen x)) := by
        intro x
        have hMono_pre : CategoryTheory.Mono
            (m • CategoryTheory.CategoryStruct.id (P_free x)) := by
          haveI : ∀ U : (Z_s.AffineEtale)ᵒᵖ,
              CategoryTheory.Mono ((m • CategoryTheory.CategoryStruct.id (P_free x)).app U) := by
            intro U
            apply (AddCommGrpCat.mono_iff_injective _).mpr
            rw [injective_iff_map_eq_zero]
            intro s hs
            have happ : ∀ (k : ℕ) (t : ↑((P_free x).obj U)),
                ((k • CategoryTheory.CategoryStruct.id (P_free x)).app U).hom t = k • t := by
              intro k t
              induction k with
              | zero => rw [zero_nsmul, zero_nsmul]; rfl
              | succ k ih =>
                rw [succ_nsmul, succ_nsmul]
                change (((k • CategoryTheory.CategoryStruct.id (P_free x)).app U).hom t) + t =
                  k • t + t
                rw [ih]
            rw [happ m s] at hs
            let α_set := (CategoryTheory.yoneda.obj (e_sm.inverse.obj x)).obj U
            let s₀ : FreeAbelianGroup α_set := s
            have hs₀ : m • s₀ = 0 := hs
            have hfs : FreeAbelianGroup.toFinsupp s₀ = 0 := by
              ext a₀
              have ha₀ : ((FreeAbelianGroup.toFinsupp (m • s₀)) a₀ : ℤ) = 0 := by
                rw [hs₀, map_zero]; rfl
              rw [map_nsmul, Finsupp.nsmul_apply, nsmul_eq_mul] at ha₀
              exact (mul_eq_zero.mp ha₀).resolve_left (Nat.cast_ne_zero.mpr hm_pos.ne')
            exact (FreeAbelianGroup.equivFinsupp α_set).injective
              (hfs.trans (map_zero FreeAbelianGroup.toFinsupp).symm)
          exact CategoryTheory.NatTrans.mono_of_mono_app _
        let shf := CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}
        have h1 : m • CategoryTheory.CategoryStruct.id (F_aff x) =
            shf.map (m • CategoryTheory.CategoryStruct.id (P_free x)) := by
          rw [shf.map_nsmul, shf.map_id]
        haveI : CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id (F_aff x)) := by
          rw [h1]; infer_instance
        have h2 : m • CategoryTheory.CategoryStruct.id (F_gen x) =
            e_aff.functor.map (m • CategoryTheory.CategoryStruct.id (F_aff x)) := by
          rw [e_aff.functor.map_nsmul, e_aff.functor.map_id]
        rw [h2]; infer_instance

      have hSep : ∀ {E T : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}} (g : E ⟶ T),
          (∀ (x : Idx) (h : F_gen x ⟶ E), h ≫ g = 0) → g = 0 := by
        intro E T g hAll
        haveI : e_aff.inverse.Additive :=
          CategoryTheory.Functor.additive_of_preserves_binary_products e_aff.inverse
        suffices hg₀ : e_aff.inverse.map g = 0 by
          apply e_aff.inverse.map_injective
          rw [hg₀, e_aff.inverse.map_zero]
        let E₀ := e_aff.inverse.obj E
        let T₀ := e_aff.inverse.obj T
        let g₀ : E₀ ⟶ T₀ := e_aff.inverse.map g
        apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext U_op
        induction U_op with
        | op U =>
          apply AddCommGrpCat.ext; intro s
          let x : Idx := e_sm.functor.obj U
          let W_x : Z_s.AffineEtale := e_sm.inverse.obj x
          let iso_U : W_x ≅ U := (e_sm.unitIso.app U).symm
          let s' : ↑(E₀.obj.obj (Opposite.op W_x)) := (E₀.obj.map (Opposite.op iso_U.hom)).hom s
          have hs_back : (E₀.obj.map (Opposite.op iso_U.inv)).hom s' = s := by
            dsimp [s']
            have hcomp := congrArg (fun φ => φ.hom s)
              (E₀.obj.map_comp (Opposite.op iso_U.hom) (Opposite.op iso_U.inv)).symm
            dsimp at hcomp
            rw [hcomp]
            change (E₀.obj.map (Opposite.op (iso_U.inv ≫ iso_U.hom))).hom s = s
            rw [iso_U.inv_hom_id]
            change (E₀.obj.map (𝟙 (Opposite.op U))).hom s = s
            rw [E₀.obj.map_id]; rfl
          change (g₀.hom.app (Opposite.op U)).hom s = 0
          rw [← hs_back]
          have hnat_U := congrArg (fun φ => φ.hom s') (g₀.hom.naturality (Opposite.op iso_U.inv))
          dsimp at hnat_U
          rw [hnat_U]
          suffices hs'_zero : (g₀.hom.app (Opposite.op W_x)).hom s' = 0 by
            change (T₀.obj.map (Opposite.op iso_U.inv)).hom
              ((g₀.hom.app (Opposite.op W_x)).hom s') = 0
            rw [hs'_zero, map_zero]
          let adj_sh := CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}
          let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z_s.AffineEtale)
          let eqv_0 : ∀ (𝒢₀ : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}),
              (F_aff x ⟶ 𝒢₀) ≃ ↑(𝒢₀.obj.obj (Opposite.op W_x)) :=
            fun 𝒢₀ => (adj_sh.homEquiv (P_free x) 𝒢₀).trans
              ((adj_fr.homEquiv (CategoryTheory.yoneda.obj W_x) 𝒢₀.obj).trans
                CategoryTheory.yonedaEquiv)
          let h₀ : F_aff x ⟶ E₀ := (eqv_0 E₀).symm s'
          let h_Z : F_gen x ⟶ E := e_aff.functor.map h₀ ≫ e_aff.counitIso.hom.app E
          have hh_zero : h_Z ≫ g = 0 := hAll x h_Z
          have hh₀_zero : h₀ ≫ g₀ = 0 := by
            have hnat_c : e_aff.counitIso.hom.app E ≫ g =
                e_aff.functor.map g₀ ≫ e_aff.counitIso.hom.app T :=
              (e_aff.counitIso.hom.naturality g).symm
            have h1 : e_aff.functor.map (h₀ ≫ g₀) ≫ e_aff.counitIso.hom.app T = 0 := by
              rw [e_aff.functor.map_comp, CategoryTheory.Category.assoc, ← hnat_c,
                ← CategoryTheory.Category.assoc]
              exact hh_zero
            have h2 : e_aff.functor.map (h₀ ≫ g₀) = 0 :=
              (CategoryTheory.cancel_mono (e_aff.counitIso.hom.app T)).mp
                (h1.trans CategoryTheory.Limits.zero_comp.symm)
            exact e_aff.functor.map_injective (h2.trans (e_aff.functor.map_zero _ _).symm)
          have heval : eqv_0 T₀ (h₀ ≫ g₀) = (g₀.hom.app (Opposite.op W_x)).hom s' := by
            dsimp [eqv_0]
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_sh h₀ g₀]
            have hfr_nat := CategoryTheory.Adjunction.homEquiv_naturality_right adj_fr
              ((adj_sh.homEquiv (P_free x) E₀) h₀) g₀.hom
            change CategoryTheory.yonedaEquiv
              ((adj_fr.homEquiv (yoneda.obj W_x) T₀.obj)
                ((adj_sh.homEquiv (P_free x) E₀) h₀ ≫ g₀.hom)) = _
            rw [hfr_nat, CategoryTheory.yonedaEquiv_comp]
            exact congrArg (g₀.hom.app (Opposite.op W_x)).hom ((eqv_0 E₀).apply_symm_apply s')
          have hzero_eval : eqv_0 T₀ 0 = 0 := by
            dsimp [eqv_0]
            rw [CategoryTheory.Adjunction.homEquiv_unit adj_sh,
              CategoryTheory.Functor.map_zero, CategoryTheory.Limits.comp_zero,
              CategoryTheory.Adjunction.homEquiv_unit adj_fr]
            rfl
          rw [← heval, hh₀_zero, hzero_eval]

      
      have hMono_Fℤ : CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id Fℤ_Z) := by
        have hMono_Aℤ : CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id Aℤ) := by
          apply (AddCommGrpCat.mono_iff_injective _).mpr
          rw [injective_iff_map_eq_zero]
          intro z hz
          have happ : ∀ (k : ℕ) (a : ↑Aℤ),
              ((k • CategoryTheory.CategoryStruct.id Aℤ).hom a).down = k • a.down := by
            intro k a
            induction k with
            | zero => rw [zero_nsmul, zero_nsmul]; rfl
            | succ k ih =>
              rw [succ_nsmul, succ_nsmul]
              change ((k • CategoryTheory.CategoryStruct.id Aℤ).hom a).down + a.down =
                k • a.down + a.down
              rw [ih]
          have hd : m • z.down = 0 := by
            rw [← happ m z, hz]; rfl
          rw [nsmul_eq_mul] at hd
          apply ULift.ext
          exact (mul_eq_zero.mp hd).resolve_left (Nat.cast_ne_zero.mpr hm_pos.ne')
        let C_Z := CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}
        haveI : CategoryTheory.Limits.PreservesFiniteColimits C_Z :=
          (CategoryTheory.Adjunction.leftAdjoint_preservesColimits.{0, 0} adjℤ).preservesFiniteColimits
        haveI : C_Z.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C_Z
        haveI : CategoryTheory.Limits.PreservesFiniteLimits C_Z :=
          inferInstanceAs (CategoryTheory.Limits.PreservesFiniteLimits
            (CategoryTheory.Functor.const _ ⋙ CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u}))
        have hmap : m • CategoryTheory.CategoryStruct.id Fℤ_Z =
            C_Z.map (m • CategoryTheory.CategoryStruct.id Aℤ) := by
          change m • CategoryTheory.CategoryStruct.id (C_Z.obj Aℤ) = _
          rw [C_Z.map_nsmul, C_Z.map_id]
        haveI := hMono_Aℤ
        rw [hmap]; infer_instance

      exact hAbstractTorsFreeVan (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})
        Idx F_gen hF_mono (@hSep) (U_Z.obj ℐ) (@hExtProp_UZ) q Fℤ_Z hMono_Fℤ ω

  have hUZBij :=
    @hExactExtBij _ _ _ _ _ _ _ _ _ U_Z (hU_add Z_s) (hU_lim Z_s) (hU_colim Z_s)
      (weilEtaleModuleUnit Z_s m) Fℤ_Z η₂ hBij0_UZ hVan_UZ p
      (weilEtaleModuleUnit Z_s m)
  let e_UZ : CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit Z_s m)
        (weilEtaleModuleUnit Z_s m) p ≃+
      CategoryTheory.Abelian.Ext.{u} Fℤ_Z (U_Z.obj (weilEtaleModuleUnit Z_s m)) p :=
    AddEquiv.ofBijective _ hUZBij
  let e_sh_ext : CategoryTheory.Abelian.Ext.{u} Fℤ_Z (U_Z.obj (weilEtaleModuleUnit Z_s m)) p ≃+
      weilEtaleTorsionH Z_s m p :=
    { toFun := (CategoryTheory.Abelian.Ext.mk₀ e_sh.hom).postcomp Fℤ_Z (Nat.add_zero p)
      invFun := (CategoryTheory.Abelian.Ext.mk₀ e_sh.inv).postcomp Fℤ_Z (Nat.add_zero p)
      left_inv := fun x => by
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀ e_sh.hom) (Nat.add_zero p)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_sh.inv) (Nat.add_zero p) = x
        rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero p) (Nat.add_zero 0)
          (Nat.add_zero p), CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_sh.hom_inv_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        change (y.comp (CategoryTheory.Abelian.Ext.mk₀ e_sh.inv) (Nat.add_zero p)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_sh.hom) (Nat.add_zero p) = y
        rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero p) (Nat.add_zero 0)
          (Nat.add_zero p), CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_sh.inv_hom_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      map_add' := map_add _ }
  exact ⟨e_push.trans (e_UZ.trans e_sh_ext)⟩

theorem weil_smooth_proper_verdier_sheaf_ext_dual_equiv (k : Type u) [Field k] [IsAlgClosed k]
    (d ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt_Z : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d Z_bar.hom] :
    let M := ℓ ^ (r + 1)
    let R := ULift.{u, 0} (ZMod M)
    let one_Z := weilEtaleModuleUnit Z_bar.left M
    ∀ (G : CategoryTheory.Sheaf Z_bar.left.smallEtaleTopology (ModuleCat.{u, u} R))
      (q : ℕ),
      q ≤ 2 * d →
      Nonempty (CategoryTheory.Abelian.Ext.{u} G one_Z q ≃+
        (CategoryTheory.Abelian.Ext.{u} one_Z G (2 * d - q) →+ ZMod M)) :=
by
  classical
  intro M R one_Z
  let S := Z_bar.left
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  have hPrime : Nat.Prime ℓ := Fact.out
  have hM_gt1 : 1 < M := calc
    1 < ℓ := hPrime.one_lt
    _ = ℓ ^ 1 := (pow_one ℓ).symm
    _ ≤ ℓ ^ (r + 1) := Nat.pow_le_pow_right hPrime.pos (Nat.le_add_left 1 r)
  have hM : 1 ≤ M := le_of_lt hM_gt1
  haveI : NeZero M := ⟨Nat.ne_of_gt (lt_trans Nat.zero_lt_one hM_gt1)⟩
  haveI : Fact (1 < M) := ⟨hM_gt1⟩
  have hℓ_char : ℓ ≠ ringChar k := by
    intro heq
    apply hℓ
    rw [heq]
    exact ringChar.Nat.cast_ringChar
  have hUnit_M : IsUnit (M : k) := by
    dsimp [M]
    rw [Nat.cast_pow]
    exact Ne.isUnit (pow_ne_zero (r + 1) hℓ)
  haveI : AlgebraicGeometry.IsIntegral S := hInt_Z
  haveI : IrreducibleSpace ↥S := AlgebraicGeometry.irreducibleSpace_of_isIntegral S
  haveI : ConnectedSpace ↥S := IrreducibleSpace.connectedSpace ↥S
  
  haveI : NeZero (ℓ : k) := ⟨hℓ⟩
  have hdeg_cyc : (Polynomial.cyclotomic ℓ k).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]
    have htot : Nat.totient ℓ = ℓ - 1 := Nat.totient_prime hPrime
    have h2 : 2 ≤ ℓ := hPrime.two_le
    have hpos : 0 < Nat.totient ℓ := by omega
    exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hpos)
  obtain ⟨z₁, hz₁_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ k) hdeg_cyc
  have hz₁_prim : IsPrimitiveRoot z₁ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff (R := k) (n := ℓ)).mp hz₁_root
  have hz₁_pow : z₁ ^ ℓ = 1 := hz₁_prim.pow_eq_one
  have hz₁_ne : z₁ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hPrime.ne_zero] at hz₁_pow
    exact zero_ne_one hz₁_pow
  let u₁ : kˣ := Units.mk0 z₁ hz₁_ne
  have hu₁_prim : IsPrimitiveRoot ((u₁ : kˣ) : k) (ℓ ^ 1) := by
    simpa [u₁, pow_one] using hz₁_prim
  have hu₁_pow : u₁ ^ ℓ = 1 := by
    ext
    simpa [u₁, Units.val_pow_eq_pow_val] using hz₁_pow
  have hStep : ∀ (s : ℕ) (u : kˣ),
      IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (s + 1)) →
      ∃ v : kˣ, IsPrimitiveRoot ((v : kˣ) : k) (ℓ ^ (s + 2)) ∧ v ^ ℓ = u := by
    intro s u hu
    let Q_poly : Polynomial k := Polynomial.X ^ ℓ - Polynomial.C ((u : kˣ) : k)
    have hdegQ : Q_poly.degree ≠ 0 := by
      dsimp [Q_poly]
      rw [Polynomial.degree_X_pow_sub_C hPrime.pos ((u : kˣ) : k)]
      exact Nat.cast_ne_zero.mpr hPrime.ne_zero
    obtain ⟨w, hw_root⟩ := IsAlgClosed.exists_root Q_poly hdegQ
    have hw_pow : w ^ ℓ = ((u : kˣ) : k) := by
      have hev : Polynomial.eval w Q_poly = 0 := hw_root
      simp only [Q_poly, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C, sub_eq_zero] at hev
      exact hev
    have hw_ne : w ≠ 0 := by
      intro hw0
      rw [hw0, zero_pow hPrime.ne_zero] at hw_pow
      exact u.ne_zero hw_pow.symm
    let v : kˣ := Units.mk0 w hw_ne
    have hv_pow : v ^ ℓ = u := by
      ext
      simpa [v, Units.val_pow_eq_pow_val] using hw_pow
    have hw_prim : IsPrimitiveRoot w (ℓ ^ (s + 2)) := by
      refine IsPrimitiveRoot.mk ?_ ?_
      · have hexp : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
        rw [hexp, pow_mul, hw_pow]
        exact hu.pow_eq_one
      · intro m_exp hm_exp
        have hexp2 : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
        have hw_top : w ^ (ℓ ^ (s + 2)) = 1 := by
          rw [hexp2, pow_mul, hw_pow]
          exact hu.pow_eq_one
        have hord_top : orderOf w ∣ ℓ ^ (s + 2) := orderOf_dvd_of_pow_eq_one hw_top
        have hord_m : orderOf w ∣ m_exp := orderOf_dvd_of_pow_eq_one hm_exp
