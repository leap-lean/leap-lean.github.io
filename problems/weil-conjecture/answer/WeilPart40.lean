theorem weil_clean_slice_freeYoneda_short_exact_and_naturality (S Z_s : AlgebraicGeometry.Scheme.{u})
    (i_s : Z_s ⟶ S) [AlgebraicGeometry.IsClosedImmersion i_s]
    (m : ℕ)
    (hc_is : (weilEtaleSitePullback i_s).IsContinuous
      S.smallEtaleTopology Z_s.smallEtaleTopology) :
    let R := ULift.{u, 0} (ZMod m)
    letI := hc_is
