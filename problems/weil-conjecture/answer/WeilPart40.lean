        apply (CategoryTheory.cancel_epi X_V₀.isoSpec.hom).mp
        rw [CategoryTheory.Iso.hom_inv_id_assoc,
          AlgebraicGeometry.Scheme.isoSpec_hom_naturality_assoc p₁,
