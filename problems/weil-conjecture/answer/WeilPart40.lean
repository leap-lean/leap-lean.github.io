theorem weil_proj_quadric_prime_pow_const_push_iso_and_etale_deg_zero_bij (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X X_U : AlgebraicGeometry.Scheme.{u}}
    (j : X_U ⟶ X)
