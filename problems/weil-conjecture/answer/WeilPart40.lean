      funext g
      apply eqv_S.injective
      dsimp [tot_push]
      rw [Equiv.apply_symm_apply]
      change adj_cS.homEquiv R_mod (P_push.obj Y) (η₁ ≫ P_push.map g) =
        eqv_sec_push Y (adj_cZ.homEquiv R_mod Y g)
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_cS η₁,
        Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit adj_cZ]
      rfl
    rw [hEqv]
    exact tot_push.bijective

  
  have hEpi_push : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R)}
      (α : ℱ ⟶ 𝒢) [CategoryTheory.Epi α], CategoryTheory.Epi (P_push.map α) := by
    intro ℱ 𝒢 α _
    have hMem_etale : ∀ {X_sch : AlgebraicGeometry.Scheme.{u}} (W : X_sch.Etale)
        (R_s : CategoryTheory.Sieve W),
        R_s ∈ X_sch.smallEtaleTopology W ↔
          ∀ (x : ↥W.left), ∃ (Y : X_sch.Etale) (f : Y ⟶ W) (y : ↥Y.left),
