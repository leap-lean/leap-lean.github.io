      intro X_sch W R_s
      haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
          (@AlgebraicGeometry.Etale) :=
        ⟨fun f g hf hg => by haveI := hf; haveI := hg; infer_instance⟩
      have hEqTop :=
        X_sch.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (fun _ _ _ h => h)
      exact (Eq.to_iff (congrArg (fun J => R_s ∈ J W) hEqTop)).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R_s)
    have hLoc_Z : CategoryTheory.Sheaf.IsLocallySurjective α :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (ModuleCat.{u, u} R) α).mpr inferInstance
    apply (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (ModuleCat.{u, u} R)
      (P_push.map α)).mp
    refine ⟨fun {U : S.Etale} s => ?_⟩
    let R_sieve : CategoryTheory.Sieve U :=
      CategoryTheory.Presheaf.imageSieve (P_push.map α).hom s
    show R_sieve ∈ S.smallEtaleTopology U
    rw [hMem_etale]
    intro x
    let X_U : AlgebraicGeometry.Scheme.{u} := U.left
    let u_hom : X_U ⟶ S := U.hom
    haveI hu_et : AlgebraicGeometry.Etale u_hom := U.prop
    by_cases hx_mem : u_hom.base x ∈ Set.range i_s.base
    · 
      rcases hx_mem with ⟨z₀, hz₀⟩
      obtain ⟨U_aff, hAff_U, hx_U, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : X_U.Opens))
          (x := x) trivial
      let A_ring := X_U.presheaf.obj (Opposite.op U_aff)
      let e_U : AlgebraicGeometry.Spec A_ring ⟶ X_U := hAff_U.fromSpec
      haveI he_U_et : AlgebraicGeometry.Etale e_U := inferInstance
      let w₀_hom : AlgebraicGeometry.Spec A_ring ⟶ S := e_U ≫ u_hom
      haveI hw₀_et : AlgebraicGeometry.Etale w₀_hom := inferInstance
      let W₀ : S.Etale := @AlgebraicGeometry.Scheme.Etale.mk _ _ w₀_hom hw₀_et
      let g₀ : W₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk e_U rfl trivial
      let x_A : ↥(AlgebraicGeometry.Spec A_ring) := hAff_U.isoSpec.hom.base ⟨x, hx_U⟩
      have hx_A : e_U.base x_A = x := by
        change (hAff_U.isoSpec.hom ≫ hAff_U.fromSpec).base ⟨x, hx_U⟩ = x
        have hcomp : hAff_U.isoSpec.hom ≫ hAff_U.fromSpec = U_aff.ι := by
          rw [AlgebraicGeometry.IsAffineOpen.fromSpec, CategoryTheory.Iso.hom_inv_id_assoc]
        rw [hcomp]; rfl
      let V₀ : Z_s.Etale := B_is.obj W₀
      let X_V₀ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback w₀_hom i_s
      let p₁ : X_V₀ ⟶ AlgebraicGeometry.Spec A_ring :=
        CategoryTheory.Limits.pullback.fst w₀_hom i_s
      let p₂ : X_V₀ ⟶ Z_s :=
        CategoryTheory.Limits.pullback.snd w₀_hom i_s
      haveI : AlgebraicGeometry.IsClosedImmersion p₁ :=
        AlgebraicGeometry.instIsClosedImmersionFstScheme w₀_hom i_s
      obtain ⟨hAff_V₀, hSurj_appTop⟩ :=
        AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine p₁
      letI : AlgebraicGeometry.IsAffine X_V₀ := hAff_V₀
      let A_Z := X_V₀.presheaf.obj (Opposite.op ⊤)
      let e_VZ : X_V₀ ≅ AlgebraicGeometry.Spec A_Z := X_V₀.isoSpec
      let π_A : A_ring ⟶ A_Z :=
        (AlgebraicGeometry.Scheme.ΓSpecIso A_ring).inv ≫ AlgebraicGeometry.Scheme.Hom.appTop p₁
      have hinv_surj : Function.Surjective (AlgebraicGeometry.Scheme.ΓSpecIso A_ring).inv.hom :=
        fun b => ⟨(AlgebraicGeometry.Scheme.ΓSpecIso A_ring).hom.hom b,
