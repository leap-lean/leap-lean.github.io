      have hβ₀_vanish : ∀ x ∈ J_last, β₀ x = 0 := by
        intro x hx
        have hker : J_last ≤ RingHom.ker β₀.toRingHom := by
          rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          change β₀ (θ.symm (g_lin (Fin.last m) i)) = 0
          rw [h_gen_X i]
          exact MvPolynomial.aeval_X _ i
