        Ideal.Quotient.liftₐ J_last β₀ hβ₀_vanish
      have h_left : ∀ k : K, β_alg (α k) = k := by
        intro k
        change β₀ (MvPolynomial.C k) = k
        exact β₀.commutes k
      have h_right : ∀ q : MvPolynomial (Fin m) K ⧸ J_last, α (β_alg q) = q := by
        have h_alg_eq : (Algebra.ofId K (MvPolynomial (Fin m) K ⧸ J_last)).comp β_alg =
            AlgHom.id K _ := by
          apply Ideal.Quotient.algHom_ext
          apply MvPolynomial.algHom_ext
          intro i
          change α (β₀ (MvPolynomial.X i)) = Ideal.Quotient.mk J_last (MvPolynomial.X i)
          have h0 : β₀ (MvPolynomial.X i) = 0 := MvPolynomial.aeval_X _ i
          rw [h0, map_zero]
          symm
          rw [Ideal.Quotient.eq_zero_iff_mem, ← h_gen_X i]
          exact Ideal.subset_span ⟨i, rfl⟩
        intro q
        exact AlgHom.congr_fun h_alg_eq q
      exact ⟨{ toFun := α
               invFun := β_alg
               left_inv := h_left
               right_inv := h_right
               map_mul' := map_mul α
               map_add' := map_add α }, rfl⟩

  
  
  
  let q_K : ∀ a : Fin (N + 1),
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a => (∑ j : Fin (m + 1), t_K a (u_idx j) * t_K a (v_idx j)) - c_K a t * (t_K a w_idx) ^ 2
  let g_quad_K : ∀ (a : Fin (N + 1)) (r : Fin (m + 2)), Fin (r.1 + 1) →
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a r => Fin.lastCases (q_K a)
      (fun ν => t_K a (u_idx ⟨ν.1, Nat.lt_of_lt_of_le ν.isLt (Nat.le_of_lt_succ r.isLt)⟩))
  let g_Pi_K : ∀ a : Fin (N + 1), Fin (m + 2) →
      ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a))) :=
    fun a ν => Fin.lastCases (t_K a w_idx) (fun j => t_K a (u_idx j)) ν

