                    (hBCInvFst f' g₂ f'' g'' hgf₂ ((weilEtaleSitePullback g₁).obj W))).trans
                    (CategoryTheory.Category.assoc _ _ r₃)))
            exact hR0.trans ((congrArg (b_w₂ ≫ ·) hR1).trans hR2)
