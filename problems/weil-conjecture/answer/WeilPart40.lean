        · rw [Ideal.span_singleton_le_iff_mem]
          apply Ideal.subset_span
          exact ⟨Fin.last (m + 1), by dsimp [g_Pi]; rw [Fin.lastCases_last]⟩
    · intro j θ hτ_uj hθ_c hθ_X J_j
      let d_j := 2 * m + 1 - j.1
      have hθ_symm_c : ∀ x : K, θ.symm (c x) = MvPolynomial.C x := by
        intro x
        apply θ.injective
        rw [θ.apply_symm_apply]
        exact (RingHom.congr_fun hθ_c x).symm
      have hθ_symm_succ : ∀ i : Fin N, θ.symm (τ ((u_idx j).succAbove i)) = MvPolynomial.X i := by
        intro i
        apply θ.injective
        rw [θ.apply_symm_apply, hθ_X i]
