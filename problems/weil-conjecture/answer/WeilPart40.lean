          (AddCommGrpCat.adj.homEquiv_naturality_left
            ((CategoryTheory.yoneda.map g).app (Opposite.op U₁'))
            ((adj_shV.homEquiv (CategoryTheory.yoneda.obj U₂' ⋙ AddCommGrpCat.free) G u).app
