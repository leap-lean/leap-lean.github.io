    haveI : ((weilEtaleSitePullback i_s).sheafPushforwardContinuous
        AddCommGrpCat.{u} S.smallEtaleTopology Z_s.smallEtaleTopology).IsRightAdjoint := hr_is
    let pf_ab := (weilEtaleSitePullback i_s).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology Z_s.smallEtaleTopology
    let pb_ab := (weilEtaleSitePullback i_s).sheafPullback
