        rcases hd_range with ⟨y, hy⟩
        have hk_zero : ((C_X.obj (AM ℓ)).obj.map k_d.op).hom s = 0 := by
          apply (hAffBij W_d w_d hw_d).1
          have hnat : (α_ℓ.hom.app (Opposite.op E_d)).hom
