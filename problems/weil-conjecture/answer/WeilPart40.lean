      ext r
      have hmem : r - γ.hom (α.hom r) ∈ RingHom.ker α.hom := by
        rw [RingHom.mem_ker, map_sub]
        have h3 : α.hom (γ.hom (α.hom r)) = α.hom r :=
          congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom (α.hom r)) hγα
