        have hnat := CategoryTheory.ConcreteCategory.congr_hom (β.naturality g.op) (𝟙 U₂')
        have hl_sh := congrArg (fun k => k.app (Opposite.op U₁'))
          (adj_shV.homEquiv_naturality_left
            (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map g) AddCommGrpCat.free) u)
        dsimp [homEquiv_V, L_V, freeAdjPSh, CategoryTheory.yonedaEquiv, β] at hnat hl_sh ⊢
        rw [Category.comp_id] at hnat
        rw [hl_sh]
