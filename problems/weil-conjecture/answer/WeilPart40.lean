        let R_T : Subalgebra L_r Ω :=
          { carrier := Set.range f_Ψ
            mul_mem' := by rintro _ _ ⟨t₁, rfl⟩ ⟨t₂, rfl⟩; exact ⟨t₁ * t₂, hfΨ_mul t₁ t₂⟩
            one_mem' := ⟨1, hfΨ_one⟩
            add_mem' := by rintro _ _ ⟨t₁, rfl⟩ ⟨t₂, rfl⟩; exact ⟨t₁ + t₂, hfΨ_add t₁ t₂⟩
            zero_mem' := ⟨0, hfΨ_zero⟩
