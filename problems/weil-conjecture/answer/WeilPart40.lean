      fun Z Θ =>
        let skyPre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
          fun M =>
            { obj := fun X => AddCommGrpCat.of (Θ.fiber.obj X.unop → ↥M)
              map := fun {X₁ X₂} u => AddCommGrpCat.ofHom
                { toFun := fun g x₂ => g (Θ.fiber.map u.unop x₂)
