  have : C_U.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C_U
  have : CategoryTheory.Limits.PreservesFiniteLimits C_X :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const _) (CategoryTheory.presheafToSheaf _ _)
  have : CategoryTheory.Limits.PreservesFiniteColimits C_X :=
    CategoryTheory.Limits.comp_preservesFiniteColimits
      (CategoryTheory.Functor.const _) (CategoryTheory.presheafToSheaf _ _)
  have : C_X.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C_X

  let T_U : X_U.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 X_U)
  let T_X : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)
  have hT_U : CategoryTheory.Limits.IsTerminal T_U := hTermOf X_U
  have hT_X : CategoryTheory.Limits.IsTerminal T_X := hTermOf X
  let adj_U := CategoryTheory.constantSheafAdj X_U.smallEtaleTopology AddCommGrpCat.{u} hT_U
  let adj_X := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X
  let τ := hT_U.from (B_j.obj T_X)
  let α_M : ∀ M : AddCommGrpCat.{u}, C_X.obj M ⟶ pf_j.obj (C_U.obj M) := fun M =>
    (adj_X.homEquiv M (pf_j.obj (C_U.obj M))).symm
      (adj_U.unit.app M ≫ (C_U.obj M).obj.map (Opposite.op τ))

  have hα_nat : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (φ : M₁ ⟶ M₂),
      C_X.map φ ≫ α_M M₂ = α_M M₁ ≫ pf_j.map (C_U.map φ) := by
    intro M₁ M₂ φ
    apply (adj_X.homEquiv M₁ (pf_j.obj (C_U.obj M₂))).injective
    have hlhs : (adj_X.homEquiv M₁ (pf_j.obj (C_U.obj M₂))) (C_X.map φ ≫ α_M M₂) =
        φ ≫ adj_U.unit.app M₂ ≫ (C_U.obj M₂).obj.map (Opposite.op τ) :=
      (adj_X.homEquiv_naturality_left φ (α_M M₂)).trans
        (congrArg (φ ≫ ·) ((adj_X.homEquiv M₂ (pf_j.obj (C_U.obj M₂))).apply_symm_apply _))
    have hrhs : (adj_X.homEquiv M₁ (pf_j.obj (C_U.obj M₂))) (α_M M₁ ≫ pf_j.map (C_U.map φ)) =
        (adj_U.unit.app M₁ ≫ (C_U.obj M₁).obj.map (Opposite.op τ)) ≫
          (C_U.map φ).hom.app (Opposite.op (B_j.obj T_X)) :=
      (adj_X.homEquiv_naturality_right (α_M M₁) (pf_j.map (C_U.map φ))).trans
        (congrArg (· ≫ (C_U.map φ).hom.app (Opposite.op (B_j.obj T_X)))
          ((adj_X.homEquiv M₁ (pf_j.obj (C_U.obj M₁))).apply_symm_apply _))
    have hunit : φ ≫ adj_U.unit.app M₂ =
        adj_U.unit.app M₁ ≫ (C_U.map φ).hom.app (Opposite.op T_U) :=
      adj_U.unit.naturality φ
    have htau : (C_U.map φ).hom.app (Opposite.op T_U) ≫ (C_U.obj M₂).obj.map (Opposite.op τ) =
        (C_U.obj M₁).obj.map (Opposite.op τ) ≫ (C_U.map φ).hom.app (Opposite.op (B_j.obj T_X)) :=
      ((C_U.map φ).hom.naturality (Opposite.op τ)).symm
    exact hlhs.trans ((Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ (C_U.obj M₂).obj.map (Opposite.op τ)) hunit).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (adj_U.unit.app M₁ ≫ ·) htau).trans
            ((Category.assoc _ _ _).symm.trans hrhs.symm)))))

  have hExistsTorsionPullback : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (m i : ℕ),
      ∃ p : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i,
        WeilIsTorsionEtalePullback h m i p := by
    have exists_affine_spec_point : ∀ {S : AlgebraicGeometry.Scheme.{u}} (U : S.Etale)
        (y : ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left),
        ∃ (R : CommRingCat.{u}) (f : AlgebraicGeometry.Spec R ⟶ ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left)
          (z₀ : AlgebraicGeometry.Spec R),
          AlgebraicGeometry.Etale f ∧ f z₀ = y := by
      intro S U y
      let X₀ := ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left
      obtain ⟨_, ⟨V, hV, rfl⟩, hyV, -⟩ :=
        (AlgebraicGeometry.Scheme.isBasis_affineOpens X₀).exists_subset_of_mem_open
          (Set.mem_univ y) isOpen_univ
      have : AlgebraicGeometry.IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
      refine ⟨X₀.presheaf.obj (Opposite.op V), hV.fromSpec, hV.isoSpec.hom ⟨y, hyV⟩, inferInstance, ?_⟩
      have hcomp : hV.isoSpec.hom ≫ hV.fromSpec = AlgebraicGeometry.Scheme.Opens.ι V := by
        simp [AlgebraicGeometry.IsAffineOpen.fromSpec]
      change (hV.isoSpec.hom ≫ hV.fromSpec) ⟨y, hyV⟩ = y
      rw [hcomp]
      rfl
    have exists_structuredOpEquiv : ∀ {D : Type u} [CategoryTheory.SmallCategory D]
        {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E] (F : D ⥤ E) (U : E),
        Nonempty ((CategoryTheory.StructuredArrow U F)ᵒᵖ ≌
          CategoryTheory.CostructuredArrow F.op (Opposite.op U)) := by
      intro D _ E _ F U
      exact ⟨{
        functor :=
          { obj := fun X₀ => CategoryTheory.CostructuredArrow.mk
              (Y := Opposite.op (Opposite.unop X₀).right) (Opposite.unop X₀).hom.op
            map := fun {X₁ X₂} f =>
              CategoryTheory.CostructuredArrow.homMk f.unop.right.op (by
                dsimp
                rw [← op_comp, CategoryTheory.StructuredArrow.w f.unop]) }
        inverse :=
          { obj := fun Y => Opposite.op
              (CategoryTheory.StructuredArrow.mk (Y := Opposite.unop Y.left) Y.hom.unop)
            map := fun {Y₁ Y₂} g =>
              (CategoryTheory.StructuredArrow.homMk g.left.unop (by
                dsimp
                exact Quiver.Hom.op_inj (CategoryTheory.CostructuredArrow.w g))).op }
        unitIso :=
          CategoryTheory.NatIso.ofComponents
            (fun X₀ => CategoryTheory.Iso.op
              (CategoryTheory.StructuredArrow.isoMk (CategoryTheory.Iso.refl _) (by dsimp; simp)))
            (fun {X₁ X₂} f => Quiver.Hom.unop_inj (by ext; simp))
        counitIso :=
          CategoryTheory.NatIso.ofComponents
            (fun Y => CategoryTheory.CostructuredArrow.isoMk
              (CategoryTheory.Iso.refl _) (by dsimp; simp))
            (fun {Y₁ Y₂} g => by ext; simp)
        functor_unitIso_comp := fun X₀ => by ext; simp }⟩
    have exists_lanEvalNatIso : ∀ {D : Type u} [CategoryTheory.SmallCategory D]
        {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E] (L : Dᵒᵖ ⥤ Eᵒᵖ) (Y : Eᵒᵖ),
        Nonempty (L.lan ⋙ (CategoryTheory.evaluation Eᵒᵖ AddCommGrpCat.{u}).obj Y ≅
          (CategoryTheory.Functor.whiskeringLeft
            (CategoryTheory.CostructuredArrow L Y) Dᵒᵖ AddCommGrpCat.{u}).obj
            (CategoryTheory.CostructuredArrow.proj L Y) ⋙ CategoryTheory.Limits.colim) := by
      intro D _ E _ L Y
      let isoP : ∀ P : Dᵒᵖ ⥤ AddCommGrpCat.{u},
          (L.lan ⋙ (CategoryTheory.evaluation Eᵒᵖ AddCommGrpCat.{u}).obj Y).obj P ≅
            ((CategoryTheory.Functor.whiskeringLeft
              (CategoryTheory.CostructuredArrow L Y) Dᵒᵖ AddCommGrpCat.{u}).obj
              (CategoryTheory.CostructuredArrow.proj L Y) ⋙ CategoryTheory.Limits.colim).obj P :=
        fun P => L.leftKanExtensionObjIsoColimit P Y
      exact ⟨CategoryTheory.NatIso.ofComponents isoP
        (fun {P₁ P₂} α => by
          apply (CategoryTheory.Iso.cancel_iso_inv_left (isoP P₁) _ _).mp
          rw [CategoryTheory.Iso.inv_hom_id_assoc]
          apply CategoryTheory.Limits.colimit.hom_ext
          intro j
          let f_lan : ∀ Z : Eᵒᵖ, (L.leftKanExtension P₁).obj Z ⟶ (L.leftKanExtension P₂).obj Z :=
            fun Z => (L.lan.map α).app Z
          have hf_nat : ∀ {Z₁ Z₂ : Eᵒᵖ} (u : Z₁ ⟶ Z₂),
              (L.leftKanExtension P₁).map u ≫ f_lan Z₂ = f_lan Z₁ ≫ (L.leftKanExtension P₂).map u :=
            fun u => (L.lan.map α).naturality u
          have hunit : α.app j.left ≫ (L.leftKanExtensionUnit P₂).app j.left =
              (L.leftKanExtensionUnit P₁).app j.left ≫ f_lan (L.obj j.left) :=
            CategoryTheory.NatTrans.congr_app (L.lanUnit.naturality α) j.left
          change CategoryTheory.Limits.colimit.ι
              (CategoryTheory.CostructuredArrow.proj L Y ⋙ P₁) j ≫
              ((L.leftKanExtensionObjIsoColimit P₁ Y).inv ≫
                (f_lan Y ≫ (L.leftKanExtensionObjIsoColimit P₂ Y).hom)) =
            CategoryTheory.Limits.colimit.ι
              (CategoryTheory.CostructuredArrow.proj L Y ⋙ P₁) j ≫
              CategoryTheory.Limits.colim.map
                (CategoryTheory.Functor.whiskerLeft (CategoryTheory.CostructuredArrow.proj L Y) α)
          rw [CategoryTheory.Limits.colimit.ι_map, ← Category.assoc,
            L.ι_leftKanExtensionObjIsoColimit_inv P₁ Y j,
            Category.assoc ((L.leftKanExtensionUnit P₁).app j.left),
            ← Category.assoc ((L.leftKanExtension P₁).map j.hom), hf_nat j.hom,
            Category.assoc (f_lan (L.obj j.left)),
            ← Category.assoc ((L.leftKanExtensionUnit P₁).app j.left),
            ← hunit, Category.assoc (α.app j.left),
            L.leftKanExtensionUnit_leftKanExtension_map_leftKanExtensionObjIsoColimit_hom P₂ Y j]
          rfl)⟩
    have preservesFiniteLimits_lan_of_flat : ∀ {D : Type u} [CategoryTheory.SmallCategory D]
        {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E]
        (F₀ : D ⥤ E) [CategoryTheory.RepresentablyFlat F₀],
        CategoryTheory.Limits.PreservesFiniteLimits
          (F₀.op.lan : (Dᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Eᵒᵖ ⥤ AddCommGrpCat.{u})) := by
      intro D _ E _ F₀ _
      refine ⟨fun J _ _ => ?_⟩
      apply CategoryTheory.Limits.preservesLimitsOfShape_of_evaluation
      intro Y
      let U : E := Opposite.unop Y
      have hCof : CategoryTheory.IsCofiltered (CategoryTheory.StructuredArrow U F₀) :=
        CategoryTheory.RepresentablyFlat.cofiltered U
      have hFil_op : CategoryTheory.IsFiltered (CategoryTheory.StructuredArrow U F₀)ᵒᵖ :=
        CategoryTheory.isFiltered_op_of_isCofiltered _
      obtain ⟨e_arrow⟩ := exists_structuredOpEquiv F₀ U
      have hFil : CategoryTheory.IsFiltered (CategoryTheory.CostructuredArrow F₀.op Y) :=
        CategoryTheory.IsFiltered.of_equivalence e_arrow
      have hColimLim : CategoryTheory.Limits.PreservesLimitsOfShape J
          (CategoryTheory.Limits.colim
            (J := CategoryTheory.CostructuredArrow F₀.op Y) (C := AddCommGrpCat.{u})) :=
        CategoryTheory.Limits.filtered_colim_preservesFiniteLimits
      have hComp : CategoryTheory.Limits.PreservesLimitsOfShape J
          ((CategoryTheory.Functor.whiskeringLeft
            (CategoryTheory.CostructuredArrow F₀.op Y) Dᵒᵖ AddCommGrpCat.{u}).obj
            (CategoryTheory.CostructuredArrow.proj F₀.op Y) ⋙ CategoryTheory.Limits.colim) :=
        CategoryTheory.Limits.comp_preservesLimitsOfShape _ _
      obtain ⟨iso_lan⟩ := exists_lanEvalNatIso F₀.op Y
      exact CategoryTheory.Limits.preservesLimitsOfShape_of_natIso iso_lan.symm
    intro S₁ S₂ h m i
    have : CategoryTheory.Limits.HasTerminal S₁.Etale := (hTermOf S₁).hasTerminal
    have : CategoryTheory.Limits.HasTerminal S₂.Etale := (hTermOf S₂).hasTerminal
    let B := weilEtaleSitePullback h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget S₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget S₂
    have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
      (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have : CategoryTheory.Limits.PreservesFiniteLimits (B ⋙ Fgt₁) := by
      change CategoryTheory.Limits.PreservesFiniteLimits (Fgt₂ ⋙ CategoryTheory.Over.pullback h)
      infer_instance
    have hLimB : CategoryTheory.Limits.PreservesFiniteLimits B :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B Fgt₁
    have hFlatB : CategoryTheory.RepresentablyFlat B :=
      CategoryTheory.flat_of_preservesFiniteLimits B
    have hCont : B.IsContinuous J₂ J₁ := by
      apply CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.compatiblePreservingOfFlat J₁ B)
      refine ⟨fun {V} {R} hR => ?_⟩
      rw [hMem S₁ (B.obj V) (R.functorPushforward B)]
      intro x
      let v_hom : (Fgt₂.obj V).left ⟶ S₂ := (Fgt₂.obj V).hom
      let fst_V : CategoryTheory.Limits.pullback v_hom h ⟶ (Fgt₂.obj V).left :=
        CategoryTheory.Limits.pullback.fst v_hom h
      let snd_V : CategoryTheory.Limits.pullback v_hom h ⟶ S₁ :=
        CategoryTheory.Limits.pullback.snd v_hom h
      obtain ⟨Y_et, f_et, w, hRf, hf_et, hw⟩ := (hMem S₂ V R).mp hR (fst_V.base x)
      let y_hom : (Fgt₂.obj Y_et).left ⟶ S₂ := (Fgt₂.obj Y_et).hom
      let f_sch : (Fgt₂.obj Y_et).left ⟶ (Fgt₂.obj V).left := (Fgt₂.map f_et).left
      let fst_Y : CategoryTheory.Limits.pullback y_hom h ⟶ (Fgt₂.obj Y_et).left :=
        CategoryTheory.Limits.pullback.fst y_hom h
      let snd_Y : CategoryTheory.Limits.pullback y_hom h ⟶ S₁ :=
        CategoryTheory.Limits.pullback.snd y_hom h
      let u_over : Fgt₂.obj Y_et ⟶ Fgt₂.obj V := Fgt₂.map f_et
      let bf_sch : CategoryTheory.Limits.pullback y_hom h ⟶ CategoryTheory.Limits.pullback v_hom h :=
        ((CategoryTheory.Over.pullback h).map u_over).left
      have hbf_fst : bf_sch ≫ fst_V = fst_Y ≫ f_sch :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hbf_snd : bf_sch ≫ snd_V = snd_Y :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hfy : f_sch ≫ v_hom = y_hom := CategoryTheory.Over.w u_over
      have h_outer : CategoryTheory.IsPullback (bf_sch ≫ snd_V) fst_Y h (f_sch ≫ v_hom) := by
        rw [hbf_snd, hfy]
        exact (CategoryTheory.IsPullback.of_hasPullback y_hom h).flip
      have hpb : CategoryTheory.IsPullback bf_sch fst_Y fst_V f_sch :=
        CategoryTheory.IsPullback.of_right h_outer hbf_fst
          (CategoryTheory.IsPullback.of_hasPullback v_hom h).flip
      obtain ⟨z, hz_fst, -⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x w
        (hw.symm : fst_V.base x = f_sch.base w)
      have hbf_et : P_et bf_sch :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hf_et
      have hpush_arrow : (R.functorPushforward B).arrows (B.map f_et) :=
        ⟨Y_et, f_et, 𝟙 (B.obj Y_et), hRf, (Category.id_comp _).symm⟩
      refine ⟨B.obj Y_et, B.map f_et, hpb.isoPullback.inv.base z, hpush_arrow, hbf_et, ?_⟩
      have hinv_fst : hpb.isoPullback.inv ≫ bf_sch = CategoryTheory.Limits.pullback.fst fst_V f_sch :=
        hpb.isoPullback_inv_fst
      change (hpb.isoPullback.inv ≫ bf_sch).base z = x
      rw [hinv_fst]
      exact hz_fst
    let e_small := CategoryTheory.equivSmallModel.{u} S₂.AffineEtale
    let g₀ : CategoryTheory.SmallModel.{u} S₂.AffineEtale → S₂.Etale := fun idx =>
      let W₀ := e_small.inverse.obj idx
      CategoryTheory.MorphismProperty.Over.mk ⊤ W₀.hom W₀.prop
    let Stage₂_data : ℕ → Σ (X₀ : Type u), (X₀ → S₂.Etale) :=
      Nat.rec
        ⟨PUnit.{u + 1} ⊕ CategoryTheory.SmallModel.{u} S₂.AffineEtale,
          Sum.elim (fun _ => ⊤_ S₂.Etale) g₀⟩
        (fun _ prev =>
          ⟨prev.1 ⊕ Σ (a b c : prev.1) (f₁ : prev.2 a ⟶ prev.2 c) (f₂ : prev.2 b ⟶ prev.2 c),
            PUnit.{1},
           Sum.elim prev.2 (fun p => CategoryTheory.Limits.pullback p.2.2.2.1 p.2.2.2.2.1)⟩)
    let Idx₂ : Type u := Σ n : ℕ, (Stage₂_data n).1
    let eval₂ : Idx₂ → S₂.Etale := fun p => (Stage₂_data p.1).2 p.2
    let D₂ : Type u := CategoryTheory.InducedCategory S₂.Etale eval₂
    let G₂ : D₂ ⥤ S₂.Etale := CategoryTheory.inducedFunctor eval₂
    have lift_add : ∀ (n d : ℕ) (x : (Stage₂_data n).1),
        ∃ y : (Stage₂_data (n + d)).1, (Stage₂_data (n + d)).2 y = (Stage₂_data n).2 x := by
      intro n d x
      induction d with
      | zero => exact ⟨x, rfl⟩
      | succ d ih =>
        obtain ⟨y, hy⟩ := ih
        exact ⟨Sum.inl y, hy⟩
    have lift_le : ∀ {n N : ℕ} (hle : n ≤ N) (x : (Stage₂_data n).1),
        ∃ y : (Stage₂_data N).1, (Stage₂_data N).2 y = eval₂ ⟨n, x⟩ := by
      intro n N hle x
      obtain ⟨y, hy⟩ := lift_add n (N - n) x
      have hN : n + (N - n) = N := Nat.add_sub_of_le hle
      revert y
      rw [hN]
      exact fun y hy => ⟨y, hy⟩
    let t₀ : D₂ := (⟨0, Sum.inl PUnit.unit⟩ : Idx₂)
    have ht₀ : CategoryTheory.Limits.IsTerminal t₀ :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun d => CategoryTheory.InducedCategory.homMk (CategoryTheory.Limits.terminal.from (eval₂ d)))
        (fun d m_hom => CategoryTheory.InducedCategory.hom_ext
          (CategoryTheory.Limits.terminal.hom_ext m_hom.hom _))
    have : CategoryTheory.Limits.HasTerminal D₂ := ht₀.hasTerminal
    have hPresTerm : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Functor.empty.{0} D₂) G₂ := by
      have hmap_term : CategoryTheory.Limits.IsLimit
          (G₂.mapCone (CategoryTheory.Limits.asEmptyCone t₀)) :=
        { lift := fun s => (CategoryTheory.Limits.terminal.from s.pt : s.pt ⟶ ⊤_ S₂.Etale)
          fac := fun s j_idx => j_idx.as.elim
          uniq := fun s m_hom _ =>
            CategoryTheory.Limits.terminal.hom_ext (m_hom : s.pt ⟶ ⊤_ S₂.Etale) _ }
      exact CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone ht₀ hmap_term
    have : CategoryTheory.Limits.PreservesLimitsOfShape (Discrete PEmpty.{1}) G₂ :=
      CategoryTheory.Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G₂
    have hCospan : ∀ (K : CategoryTheory.Limits.WalkingCospan ⥤ D₂),
        ∃ (c : CategoryTheory.Limits.Cone K),
          Nonempty (CategoryTheory.Limits.IsLimit (G₂.mapCone c)) := by
      intro K
      let d₁ : Idx₂ := K.obj CategoryTheory.Limits.WalkingCospan.left
      let d₂ : Idx₂ := K.obj CategoryTheory.Limits.WalkingCospan.right
      let d₃ : Idx₂ := K.obj CategoryTheory.Limits.WalkingCospan.one
      let u : K.obj CategoryTheory.Limits.WalkingCospan.left ⟶
          K.obj CategoryTheory.Limits.WalkingCospan.one :=
        K.map CategoryTheory.Limits.WalkingCospan.Hom.inl
      let v : K.obj CategoryTheory.Limits.WalkingCospan.right ⟶
          K.obj CategoryTheory.Limits.WalkingCospan.one :=
        K.map CategoryTheory.Limits.WalkingCospan.Hom.inr
      obtain ⟨N, ⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩, ⟨x₃, hx₃⟩⟩ :
          ∃ N : ℕ,
            (∃ x₁ : (Stage₂_data N).1,
              (Stage₂_data N).2 x₁ = G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.left)) ∧
            (∃ x₂ : (Stage₂_data N).1,
              (Stage₂_data N).2 x₂ = G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.right)) ∧
            (∃ x₃ : (Stage₂_data N).1,
              (Stage₂_data N).2 x₃ = G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.one)) :=
        ⟨max d₁.1 (max d₂.1 d₃.1),
          lift_le (le_max_left _ _) d₁.2,
          lift_le ((le_max_left _ _).trans (le_max_right _ _)) d₂.2,
          lift_le ((le_max_right _ _).trans (le_max_right _ _)) d₃.2⟩
      let X₁ : S₂.Etale := (Stage₂_data N).2 x₁
      let X₂ : S₂.Etale := (Stage₂_data N).2 x₂
      let X₃ : S₂.Etale := (Stage₂_data N).2 x₃
      let f₁ : X₁ ⟶ X₃ := eqToHom hx₁ ≫ G₂.map u ≫ eqToHom hx₃.symm
      let f₂ : X₂ ⟶ X₃ := eqToHom hx₂ ≫ G₂.map v ≫ eqToHom hx₃.symm
      let P_et_pb : S₂.Etale := CategoryTheory.Limits.pullback f₁ f₂
      let pr₁_et : P_et_pb ⟶ G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.left) :=
        CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ eqToHom hx₁
      let pr₂_et : P_et_pb ⟶ G₂.obj (K.obj CategoryTheory.Limits.WalkingCospan.right) :=
        CategoryTheory.Limits.pullback.snd f₁ f₂ ≫ eqToHom hx₂
      have hcond_et : pr₁_et ≫ G₂.map u = pr₂_et ≫ G₂.map v := by
        have hpb_f : CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ f₁ =
            CategoryTheory.Limits.pullback.snd f₁ f₂ ≫ f₂ :=
          CategoryTheory.Limits.pullback.condition
