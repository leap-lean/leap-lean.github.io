  letI : AlgebraicGeometry.IsProper Z_bar_ov.hom := hProp_Zbar
  letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar_ov.hom := hSm_Zbar
  letI : AlgebraicGeometry.IsProper D_bar_ov.hom := hProp_Dbar
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 D_bar_ov.hom := hSm_Dbar

  let f_bar_left : weilGeomScheme F Z_tilde ⟶ weilGeomScheme F D₀ :=
