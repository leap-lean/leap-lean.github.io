      obtain ⟨s_d, hs_d⟩ :=
        (hAffBij W_d w_d hw_d).2 (((pf_j.obj (C_U.obj (AM ℓ))).obj.map k_d.op).hom t)
      exact ⟨E_d, k_d, y, ⟨s_d, hs_d⟩, hMorEtale X k_d, hy⟩
    have : CategoryTheory.Epi α_ℓ := CategoryTheory.Sheaf.epi_of_isLocallySurjective α_ℓ
    exact CategoryTheory.isIso_of_mono_of_epi α_ℓ

  
  
  
  let red_pow : ∀ (m n : ℕ), m ≤ n → (AM (ℓ ^ n) ⟶ AM (ℓ ^ m)) := fun m _n h =>
    AddCommGrpCat.uliftFunctor.{u, 0}.map
      (AddCommGrpCat.ofHom (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom)
  have hIso_pow : ∀ r : ℕ, CategoryTheory.IsIso (α_M (AM (ℓ ^ (r + 1)))) := by
    intro r
    induction r with
    | zero =>
      rw [Nat.zero_add, pow_one]
      exact hIso_ℓ
    | succ r ih =>
      have : NeZero (ℓ ^ 1) := ⟨pow_ne_zero 1 hPrime.ne_zero⟩
      have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
      have : NeZero (ℓ ^ (r + 2)) := ⟨pow_ne_zero (r + 2) hPrime.ne_zero⟩
      let inc0 : ZMod (ℓ ^ 1) →+ ZMod (ℓ ^ (r + 2)) :=
        { toFun := fun x => ((x.val * ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 2)))
          map_zero' := by simp
          map_add' := fun x y => by
            have hxy : (x + y).val + ℓ ^ 1 * ((x.val + y.val) / ℓ ^ 1) = x.val + y.val := by
              rw [ZMod.val_add]
              have h1 := Nat.mod_add_div (x.val + y.val) (ℓ ^ 1)
              omega
            have hmul := congrArg (· * ℓ ^ (r + 1)) hxy
            rw [Nat.add_mul, Nat.add_mul] at hmul
            have hpow : ℓ ^ 1 * ((x.val + y.val) / ℓ ^ 1) * ℓ ^ (r + 1) =
                ℓ ^ (r + 2) * ((x.val + y.val) / ℓ ^ 1) := by
              calc ℓ ^ 1 * ((x.val + y.val) / ℓ ^ 1) * ℓ ^ (r + 1)
                  = (ℓ ^ 1 * ℓ ^ (r + 1)) * ((x.val + y.val) / ℓ ^ 1) := by ring
                _ = ℓ ^ (r + 2) * ((x.val + y.val) / ℓ ^ 1) := by
                    rw [← pow_add, Nat.add_comm 1 (r + 1)]
            rw [hpow] at hmul
            have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ (r + 2))) hmul
            rw [Nat.cast_add, Nat.cast_add, Nat.cast_mul (ℓ ^ (r + 2)), ZMod.natCast_self,
              zero_mul, add_zero] at hcast
            exact hcast }
      let f_inc : AM (ℓ ^ 1) ⟶ AM (ℓ ^ (r + 2)) :=
        AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom inc0)
      let g_red : AM (ℓ ^ (r + 2)) ⟶ AM (ℓ ^ (r + 1)) :=
        red_pow (r + 1) (r + 2) (Nat.le_succ (r + 1))
      have hfg0 : f_inc ≫ g_red = 0 := by
        apply AddCommGrpCat.ext; intro x; apply ULift.ext
        change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          ((x.down.val * ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 2))) = 0
        rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, mul_zero]
      have hInj_f : Function.Injective f_inc.hom := by
        intro x y hxy
        let xd : ZMod (ℓ ^ 1) := x.down
        let yd : ZMod (ℓ ^ 1) := y.down
        have hxy' : ((xd.val * ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 2))) =
            ((yd.val * ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 2))) := congrArg ULift.down hxy
        have hlt_x : xd.val * ℓ ^ (r + 1) < ℓ ^ (r + 2) :=
          calc xd.val * ℓ ^ (r + 1)
              < ℓ ^ 1 * ℓ ^ (r + 1) :=
                Nat.mul_lt_mul_of_pos_right xd.val_lt (pow_pos hPrime.pos (r + 1))
            _ = ℓ ^ (r + 2) := by rw [← pow_add, Nat.add_comm 1 (r + 1)]
        have hlt_y : yd.val * ℓ ^ (r + 1) < ℓ ^ (r + 2) :=
          calc yd.val * ℓ ^ (r + 1)
              < ℓ ^ 1 * ℓ ^ (r + 1) :=
                Nat.mul_lt_mul_of_pos_right yd.val_lt (pow_pos hPrime.pos (r + 1))
            _ = ℓ ^ (r + 2) := by rw [← pow_add, Nat.add_comm 1 (r + 1)]
        have hval := congrArg ZMod.val hxy'
        rw [ZMod.val_natCast_of_lt hlt_x, ZMod.val_natCast_of_lt hlt_y] at hval
        exact ULift.ext _ _ (ZMod.val_injective (ℓ ^ 1)
          (Nat.eq_of_mul_eq_mul_right (pow_pos hPrime.pos (r + 1)) hval))
      have hSurj_g : Function.Surjective g_red.hom := by
        intro z
        obtain ⟨w, hw⟩ := ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) z.down
        exact ⟨ULift.up w, ULift.ext _ _ hw⟩
      have hKer : ∀ y : ↑(AM (ℓ ^ (r + 2))), g_red.hom y = 0 →
          ∃ x : ↑(AM (ℓ ^ 1)), f_inc.hom x = y := by
        intro y hy
        let yd : ZMod (ℓ ^ (r + 2)) := y.down
        have hy' : ((yd.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 := by
          have h1 : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) yd = 0 :=
            congrArg ULift.down hy
          rwa [ZMod.castHom_apply, ZMod.cast_eq_val] at h1
        obtain ⟨t, ht⟩ := (ZMod.natCast_eq_zero_iff yd.val (ℓ ^ (r + 1))).mp hy'
        have ht_lt : t < ℓ ^ 1 := by
          have hy_lt : yd.val < ℓ ^ (r + 1) * ℓ ^ 1 := by
            rw [← pow_add]; exact yd.val_lt
          rw [ht] at hy_lt
          exact lt_of_mul_lt_mul_left hy_lt (Nat.zero_le _)
        refine ⟨ULift.up (t : ZMod (ℓ ^ 1)), ULift.ext _ _ ?_⟩
        change (((t : ZMod (ℓ ^ 1)).val * ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 2))) = yd
        rw [ZMod.val_natCast_of_lt ht_lt, mul_comm t, ← ht, ZMod.natCast_zmod_val]
      let SC_r := CategoryTheory.ShortComplex.mk f_inc g_red hfg0
      have hSE_r : SC_r.ShortExact := by
        have hMono : CategoryTheory.Mono f_inc := (AddCommGrpCat.mono_iff_injective f_inc).mpr hInj_f
        have hEpi : CategoryTheory.Epi g_red := (AddCommGrpCat.epi_iff_surjective g_red).mpr hSurj_g
        let liftHom : ∀ {W : AddCommGrpCat.{u}} (k_hom : W ⟶ AM (ℓ ^ (r + 2))),
            k_hom ≫ g_red = 0 → (W ⟶ AM (ℓ ^ 1)) :=
          fun {W} k_hom hk =>
            have hk_pt : ∀ w : ↑W, g_red.hom (k_hom.hom w) = 0 := fun w =>
              congrArg (fun m : W ⟶ AM (ℓ ^ (r + 1)) => m.hom w) hk
            let l_fun : ↑W → ↑(AM (ℓ ^ 1)) := fun w => Classical.choose (hKer (k_hom.hom w) (hk_pt w))
            have hl_spec : ∀ w : ↑W, f_inc.hom (l_fun w) = k_hom.hom w := fun w =>
              Classical.choose_spec (hKer (k_hom.hom w) (hk_pt w))
            AddCommGrpCat.ofHom
              { toFun := l_fun
                map_zero' := hInj_f ((hl_spec 0).trans (k_hom.hom.map_zero.trans f_inc.hom.map_zero.symm))
                map_add' := fun w₁ w₂ => hInj_f ((hl_spec (w₁ + w₂)).trans
                  ((k_hom.hom.map_add w₁ w₂).trans
                    ((congrArg₂ (· + ·) (hl_spec w₁).symm (hl_spec w₂).symm).trans
                      (f_inc.hom.map_add (l_fun w₁) (l_fun w₂)).symm))) }
        have hlift_fac : ∀ {W : AddCommGrpCat.{u}} (k_hom : W ⟶ AM (ℓ ^ (r + 2)))
            (hk : k_hom ≫ g_red = 0), liftHom k_hom hk ≫ f_inc = k_hom :=
          fun {W} k_hom hk => AddCommGrpCat.ext fun w =>
            Classical.choose_spec (hKer (k_hom.hom w)
              (congrArg (fun m : W ⟶ AM (ℓ ^ (r + 1)) => m.hom w) hk))
        let hIsKer : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι f_inc hfg0) :=
          CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
            (fun {W} k_hom hk => liftHom k_hom hk)
            (fun {W} k_hom hk => hlift_fac k_hom hk)
            (fun {W} k_hom hk _m hm =>
              (CategoryTheory.cancel_mono f_inc).mp (hm.trans (hlift_fac k_hom hk).symm))
        exact CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_f_is_kernel SC_r hIsKer) hMono hEpi
      let SC_F := SC_r.map C_X
      let SC_G := SC_r.map C_U
      have hSE_F : SC_F.ShortExact := hSE_r.map_of_exact C_X
      have hSE_G : SC_G.ShortExact := hSE_r.map_of_exact C_U
      obtain ⟨hEx_pfG, hMono_pfG⟩ :=
        (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_j).mp
          inferInstance SC_G hSE_G
      have : CategoryTheory.IsIso (α_M (AM (ℓ ^ 1))) := by rw [pow_one]; exact hIso_ℓ
      have : CategoryTheory.Epi SC_F.g := hSE_F.epi_g
      have hfac_g : SC_F.g ≫ α_M (AM (ℓ ^ (r + 1))) =
          α_M (AM (ℓ ^ (r + 2))) ≫ (SC_G.map pf_j).g := hα_nat g_red
      have hEpi_lhs : CategoryTheory.Epi (SC_F.g ≫ α_M (AM (ℓ ^ (r + 1)))) :=
        CategoryTheory.epi_comp _ _
      have : CategoryTheory.Epi (SC_G.map pf_j).g :=
        @CategoryTheory.epi_of_epi_fac _ _ _ _ _
          (α_M (AM (ℓ ^ (r + 2)))) (SC_G.map pf_j).g _ hEpi_lhs hfac_g.symm
      let φ_SC : SC_F ⟶ SC_G.map pf_j :=
        CategoryTheory.ShortComplex.homMk
          (α_M (AM (ℓ ^ 1))) (α_M (AM (ℓ ^ (r + 2)))) (α_M (AM (ℓ ^ (r + 1))))
          (hα_nat f_inc).symm (hα_nat g_red).symm
      have : CategoryTheory.Mono SC_F.f := hSE_F.mono_f
      have : CategoryTheory.Mono (SC_G.map pf_j).f := hMono_pfG
      have : CategoryTheory.Mono φ_SC.τ₁ := (inferInstance : CategoryTheory.Mono (α_M (AM (ℓ ^ 1))))
      have : CategoryTheory.Mono φ_SC.τ₃ := (inferInstance : CategoryTheory.Mono (α_M (AM (ℓ ^ (r + 1)))))
      have : CategoryTheory.Epi φ_SC.τ₁ := (inferInstance : CategoryTheory.Epi (α_M (AM (ℓ ^ 1))))
      have : CategoryTheory.Epi φ_SC.τ₃ := (inferInstance : CategoryTheory.Epi (α_M (AM (ℓ ^ (r + 1)))))
      have : CategoryTheory.Mono (α_M (AM (ℓ ^ (r + 2)))) :=
        CategoryTheory.ShortComplex.mono_τ₂_of_exact_of_mono φ_SC hSE_F.exact
      have : CategoryTheory.Epi (α_M (AM (ℓ ^ (r + 2)))) :=
        CategoryTheory.ShortComplex.epi_τ₂_of_exact_of_epi φ_SC hEx_pfG
      exact CategoryTheory.isIso_of_mono_of_epi _

  have hEpi_cast : ∀ (m n : ℕ) (h : m ≤ n),
      CategoryTheory.Epi (pf_j.map (C_U.map (red_pow m n h))) := by
    intro m n h
    cases m with
    | zero =>
      have hZ0 : CategoryTheory.Limits.IsZero (AM (ℓ ^ 0)) := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        apply AddCommGrpCat.ext; intro x; apply ULift.ext
        have hSub : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
        exact @Subsingleton.elim _ hSub _ _
      have hZ_tgt : CategoryTheory.Limits.IsZero (pf_j.obj (C_U.obj (AM (ℓ ^ 0)))) :=
        pf_j.map_isZero (C_U.map_isZero hZ0)
      exact ⟨fun g₁ g₂ _ => hZ_tgt.eq_of_src g₁ g₂⟩
    | succ r =>
      have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
      have : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hPrime.ne_zero⟩
      have hSurj : Function.Surjective (red_pow (r + 1) n h).hom := by
        intro z
        obtain ⟨w, hw⟩ := ZMod.castHom_surjective (pow_dvd_pow ℓ h) z.down
        exact ⟨ULift.up w, ULift.ext _ _ hw⟩
      have : CategoryTheory.Epi (red_pow (r + 1) n h) :=
        (AddCommGrpCat.epi_iff_surjective _).mpr hSurj
      have : CategoryTheory.Epi (C_X.map (red_pow (r + 1) n h)) := by
        have hZ_c : CategoryTheory.Limits.IsZero
            (CategoryTheory.Limits.cokernel (red_pow (r + 1) n h)) :=
          (CategoryTheory.Preadditive.epi_iff_isZero_cokernel _).mp inferInstance
        have hZ_map : CategoryTheory.Limits.IsZero
            (CategoryTheory.Limits.cokernel (C_X.map (red_pow (r + 1) n h))) :=
          (C_X.map_isZero hZ_c).of_iso
            (CategoryTheory.Limits.PreservesCokernel.iso C_X (red_pow (r + 1) n h)).symm
        exact (CategoryTheory.Preadditive.epi_iff_isZero_cokernel _).mpr hZ_map
      have : CategoryTheory.IsIso (α_M (AM (ℓ ^ (r + 1)))) := hIso_pow r
      have hfac := hα_nat (red_pow (r + 1) n h)
      have hEpi_lhs : CategoryTheory.Epi
          (C_X.map (red_pow (r + 1) n h) ≫ α_M (AM (ℓ ^ (r + 1)))) :=
        CategoryTheory.epi_comp _ _
      exact @CategoryTheory.epi_of_epi_fac _ _ _ _ _
        (α_M (AM (ℓ ^ n))) (pf_j.map (C_U.map (red_pow (r + 1) n h))) _ hEpi_lhs hfac.symm

  
  
  
  refine ⟨⟨@CategoryTheory.asIso _ _ _ _ (α_M (AM ℓ)) hIso_ℓ⟩, hEpi_cast, ?_⟩
  intro r W p_W0 hp_W0
  let N_mod := ℓ ^ (r + 1)
  let M_mod := AM N_mod
  obtain ⟨θ_U, θ_X, hθU_bij, hθX_bij, hEval_j⟩ := hClopenEval j hT_U hT_X M_mod
  have hIso_N : CategoryTheory.IsIso (α_M M_mod) := hIso_pow r
  let G_src := (C_X.obj M_mod).obj.obj (Opposite.op W)
  let G_tgt := (pf_j.obj (C_U.obj M_mod)).obj.obj (Opposite.op W)
  have hBij_αW : Function.Bijective ((α_M M_mod).hom.app (Opposite.op W)).hom := by
    let e_app : G_src ≅ G_tgt :=
      ((CategoryTheory.sheafToPresheaf X.smallEtaleTopology AddCommGrpCat.{u}).mapIso
        (@CategoryTheory.asIso _ _ _ _ (α_M M_mod) hIso_N)).app (Opposite.op W)
    exact ⟨fun a b h => by
        have h1 := congrArg e_app.inv.hom h
        exact (congrArg (fun k : G_src ⟶ G_src => k.hom a) e_app.hom_inv_id).symm.trans
          (h1.trans (congrArg (fun k : G_src ⟶ G_src => k.hom b) e_app.hom_inv_id)),
      fun b => ⟨e_app.inv.hom b,
        congrArg (fun k : G_tgt ⟶ G_tgt => k.hom b) e_app.inv_hom_id⟩⟩
  let f_W := CategoryTheory.Limits.pullback.fst
    ((AlgebraicGeometry.Scheme.Etale.forget X).obj W).hom j
  let comap_fW : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj W).left ↥M_mod →
      LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget X_U).obj (B_j.obj W)).left ↥M_mod :=
    fun g => g.comap f_W.base.hom
  have hBij_comap_fW : Function.Bijective comap_fW := by
    let e_X_W := Equiv.ofBijective (θ_X W) (hθX_bij W)
    let e_U_WU := Equiv.ofBijective (θ_U (B_j.obj W)) (hθU_bij (B_j.obj W))
    have hcomm : e_U_WU ∘ comap_fW = ((α_M M_mod).hom.app (Opposite.op W)).hom ∘ e_X_W := by
      funext g
      exact (hEval_j W g).symm
    have hbij_comp : Function.Bijective (e_U_WU ∘ comap_fW) := by
      rw [hcomm]
      exact hBij_αW.comp e_X_W.bijective
    exact ⟨fun a b h => hbij_comp.1 (congrArg e_U_WU h),
      fun b => by
        obtain ⟨a, ha⟩ := hbij_comp.2 (e_U_WU b)
        exact ⟨a, e_U_WU.injective ha⟩⟩
  exact (hDegZeroComapIff f_W N_mod p_W0 hp_W0).mpr hBij_comap_fW

theorem weil_proj_quadric_prime_pow_skyscraper_closed_immersion_h0_and_h1 (k : Type u) [Field k] [IsAlgClosed k]
    {X : AlgebraicGeometry.Scheme.{u}}
    (i₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X) [AlgebraicGeometry.IsClosedImmersion i₀]
    (𝒮 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
    (hSupp : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
        z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
        ∃ (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback z_bar 𝒮 H_z ∧ CategoryTheory.Limits.IsZero H_z)
    (hCont_o : (weilEtaleSitePullback i₀).IsContinuous
        X.smallEtaleTopology
