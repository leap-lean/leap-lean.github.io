      (p₁ p₂ : weilEtaleTorsionH S₂ m_mod idx →+ weilEtaleTorsionH S₁ m_mod idx),
      WeilIsTorsionEtalePullback h m_mod idx p₁ →
      WeilIsTorsionEtalePullback h m_mod idx p₂ →
      p₁ = p₂ := by
    intro S₁ S₂ h m_mod idx p₁ p₂ hp₁ hp₂
    obtain ⟨p_id, hp_id⟩ := hPb_ex (CategoryTheory.CategoryStruct.id S₁) m_mod idx
    have hp_id_eq : p_id = AddMonoidHom.id _ := hPb_id m_mod idx p_id hp_id
    have hp₂_comp : WeilIsTorsionEtalePullback
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id S₁) h) m_mod idx p₂ := by
      rwa [CategoryTheory.Category.id_comp]
    have heq := hPb_comp (CategoryTheory.CategoryStruct.id S₁) h m_mod idx p_id p₁ p₂
      hp_id hp₁ hp₂_comp
    rw [hp_id_eq, AddMonoidHom.id_comp] at heq
    exact heq.symm

