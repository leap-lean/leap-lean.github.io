      obtain ⟨i₂, a₀₂, a₁₂, ha₀₂, ha₁₂⟩ := hProdSurj hSurj_A₀ hSurj_A₁ a₀_inf a₁_inf
      let i₃ : ℐ := CategoryTheory.IsFiltered.max i₁ i₂
      let τ₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
      let τ₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
      let Δ₃ : ↥(B.obj i₃) := B.map τ₁ b₁ - diffA i₃ (A₀.map τ₂ a₀₂, A₁.map τ₂ a₁₂)
      have hΔ₃_leg : B.leg i₃ Δ₃ = 0 := by
        dsimp only [Δ₃]
        rw [map_sub, B.leg_map, ← hleg_diffA, A₀.leg_map, A₁.leg_map, ha₀₂, ha₁₂, hp_inf, sub_self]
      obtain ⟨i₄, θ₃₄, hθ₃₄⟩ := hInj_B i₃ Δ₃ hΔ₃_leg
      have hb₄ : B.map θ₃₄ (B.map τ₁ b₁) =
          diffA i₄ (A₀.map θ₃₄ (A₀.map τ₂ a₀₂), A₁.map θ₃₄ (A₁.map τ₂ a₁₂)) := by
        dsimp only [Δ₃] at hθ₃₄
        rw [map_sub, ← hmap_diffA] at hθ₃₄
