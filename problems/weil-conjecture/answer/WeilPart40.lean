      let pf_G := ((CategoryTheory.equivSmallModel.{u} S.AffineEtale).inverse ⋙
        AlgebraicGeometry.Scheme.AffineEtale.Spec S).sheafPushforwardContinuous
        AddCommGrpCat.{u} J_M S.smallEtaleTopology
      haveI : pf_G.IsEquivalence := inferInstance
      let pf_is := (weilEtaleSitePullback i_s).sheafPushforwardContinuous
        AddCommGrpCat.{u} S.smallEtaleTopology Z_s.smallEtaleTopology
      let pf_comp := (((CategoryTheory.equivSmallModel.{u} S.AffineEtale).inverse ⋙
        AlgebraicGeometry.Scheme.AffineEtale.Spec S) ⋙ weilEtaleSitePullback i_s).sheafPushforwardContinuous
        AddCommGrpCat.{u} J_M Z_s.smallEtaleTopology
