        (Fin.lastCases 2 (fun _ => 1)) (fun a => g_quad_K a j.succ) (hQuadOv_K j.succ)
    exact ⟨⟨W_j, ι_j, j.succ.1 + 1, fun a => g_quad_K a j.succ⟩, rfl,
      fun _ => ⟨rfl, rfl⟩, ⟨hCl_j, hPres_j⟩⟩

  let D_Qt : PresDatum N := ⟨Q_t, ι_Qt, 1, fun a _ => q_K a⟩
  have hValid_Qt : IsValidPresDatum N hAff_K D_Qt := ⟨inferInstance, hPres_Qt⟩

  let D_Pi : PresDatum N := ⟨(weilProjectiveSpaceOver K m).left, ι_Pi_amb_K, m + 2, g_Pi_K⟩
  have hValid_Pi : IsValidPresDatum N hAff_K D_Pi := ⟨inferInstance, hPres_PiK⟩

  let D_mid : Fin (m + 1) → PresDatum N := fun j => Classical.choose (hSubMid j)
  have hD_mid_spec : ∀ j : Fin (m + 1),
      (∀ a : Fin (N + 1),
        chartIdeal N (D_mid j) a = Ideal.span (Set.range (g_quad_K a j.succ)) ∧
        polyIdeal N θ_K (D_mid j) a =
          Ideal.span (Set.range (fun ν : Fin (j.succ.1 + 1) =>
            (θ_K a).symm (g_quad_K a j.succ ν)))) ∧
      IsValidPresDatum N hAff_K (D_mid j) :=
    fun j => (Classical.choose_spec (hSubMid j)).2

  let D_A : Fin (m + 3) → PresDatum N :=
    Fin.lastCases D_Pi (Fin.cases D_Qt D_mid)

  have hDA_last : D_A (Fin.last (m + 2)) = D_Pi := Fin.lastCases_last
  have hDA_cast : ∀ r : Fin (m + 2), D_A r.castSucc = Fin.cases D_Qt D_mid r :=
    fun r => Fin.lastCases_castSucc r
  have hDA_0 : D_A 0 = D_Qt := by
    have h0 : (0 : Fin (m + 3)) = (0 : Fin (m + 2)).castSucc := rfl
    rw [h0, hDA_cast, Fin.cases_zero]

  have hValid_A : ∀ s : Fin (m + 3), IsValidPresDatum N hAff_K (D_A s) := by
    intro s
    refine Fin.lastCases ?_ (fun r => ?_) s
    · rw [hDA_last]; exact hValid_Pi
    · rw [hDA_cast]
      refine Fin.cases ?_ (fun j => ?_) r
      · rw [Fin.cases_zero]; exact hValid_Qt
      · rw [Fin.cases_succ]; exact (hD_mid_spec j).2

  have hDA_quad_ideals : ∀ (r : Fin (m + 2)) (a : Fin (N + 1)),
      chartIdeal N (D_A r.castSucc) a = Ideal.span (Set.range (g_quad_K a r)) ∧
      polyIdeal N θ_K (D_A r.castSucc) a =
        Ideal.span (Set.range (fun ν : Fin (r.1 + 1) => (θ_K a).symm (g_quad_K a r ν))) := by
    intro r a
    rw [hDA_cast]
    refine Fin.cases ?_ (fun j => ?_) r
    · rw [Fin.cases_zero]
      dsimp only [D_Qt, chartIdeal, polyIdeal]
      have h1 : Set.range (fun _ : Fin 1 => q_K a) = Set.range (g_quad_K a 0) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨_, rfl⟩
          exact ⟨Fin.last (0 : Fin (m + 2)).1, by dsimp only [g_quad_K]; rw [Fin.lastCases_last]⟩
        · rintro ⟨ν, rfl⟩
          refine Fin.lastCases ?_ (fun μ => ?_) ν
          · dsimp only [g_quad_K]; rw [Fin.lastCases_last]; exact ⟨0, rfl⟩
          · exfalso
            have h0 : (0 : Fin (m + 2)).1 = 0 := by simp
            have hμ : μ.1 < (0 : Fin (m + 2)).1 := μ.isLt
            omega
      have h2 : Set.range (fun _ : Fin 1 => (θ_K a).symm (q_K a)) =
          Set.range (fun ν : Fin ((0 : Fin (m + 2)).1 + 1) =>
            (θ_K a).symm (g_quad_K a 0 ν)) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨_, rfl⟩
          exact ⟨Fin.last (0 : Fin (m + 2)).1, by dsimp only [g_quad_K]; rw [Fin.lastCases_last]⟩
        · rintro ⟨ν, rfl⟩
          refine Fin.lastCases ?_ (fun μ => ?_) ν
          · dsimp only [g_quad_K]; rw [Fin.lastCases_last]; exact ⟨0, rfl⟩
          · exfalso
            have h0 : (0 : Fin (m + 2)).1 = 0 := by simp
            have hμ : μ.1 < (0 : Fin (m + 2)).1 := μ.isLt
            omega
      rw [h1, h2]
      exact ⟨rfl, rfl⟩
    · rw [Fin.cases_succ]; exact (hD_mid_spec j).1 a

  let c_A : Fin (m + 2) → Fin (N + 1) := Fin.lastCases w_idx (fun j => u_idx j)

  have hStepIdeal_A : ∀ (s : Fin (m + 2)) (a : Fin (N + 1)),
      chartIdeal N (D_A s.succ) a =
        chartIdeal N (D_A s.castSucc) a ⊔ Ideal.span {t_K a (c_A s)} := by
    intro s a
    obtain ⟨hStep_j, hStep_last, _, _⟩ := hSplitQuadricAlg _ (c_K a) (t_K a)
    refine Fin.lastCases ?_ (fun j => ?_) s
    · have hsucc_last : (Fin.last (m + 1)).succ = Fin.last (m + 2) := Fin.succ_last (m + 1)
      rw [hsucc_last, hDA_last, (hDA_quad_ideals (Fin.last (m + 1)) a).1]
      dsimp [c_A]
      rw [Fin.lastCases_last]
      exact hStep_last
    · have hsucc_cast : (j.castSucc).succ = (j.succ).castSucc := Fin.ext rfl
      rw [hsucc_cast, (hDA_quad_ideals j.succ a).1, (hDA_quad_ideals j.castSucc a).1]
      dsimp [c_A]
      rw [Fin.lastCases_castSucc]
      exact hStep_j j

  have hStepIncl_A : ∀ s : Fin (m + 2),
      ∃ j_s : (D_A s.succ).1 ⟶ (D_A s.castSucc).1,
        AlgebraicGeometry.IsClosedImmersion j_s ∧
        j_s ≫ (D_A s.castSucc).2.1 = (D_A s.succ).2.1 := by
    intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_A s.castSucc).2.1 := (hValid_A s.castSucc).1
    have : AlgebraicGeometry.IsClosedImmersion (D_A s.succ).2.1 := (hValid_A s.succ).1
    exact hSubIncl_K N hAff_K c_K t_K hCoord_K
      (D_A s.castSucc).1 (D_A s.castSucc).2.1 (D_A s.castSucc).2.2.1 (D_A s.castSucc).2.2.2
      (D_A s.succ).1 (D_A s.succ).2.1 (D_A s.succ).2.2.1 (D_A s.succ).2.2.2
      (hValid_A s.castSucc).2 (hValid_A s.succ).2
      (fun a => by change chartIdeal N (D_A s.castSucc) a ≤ chartIdeal N (D_A s.succ) a; rw [hStepIdeal_A s a]; exact le_sup_left)

  let Z : Fin (m + 3) → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    fun s => CategoryTheory.Over.mk ((D_A s).2.1 ≫ (weilProjectiveSpaceOver K N).hom)
  let j_A : ∀ s : Fin (m + 2), (Z s.succ).left ⟶ (Z s.castSucc).left :=
    fun s => Classical.choose (hStepIncl_A s)
  have hj_A_spec : ∀ s : Fin (m + 2),
      AlgebraicGeometry.IsClosedImmersion (j_A s) ∧
      j_A s ≫ (D_A s.castSucc).2.1 = (D_A s.succ).2.1 :=
    fun s => Classical.choose_spec (hStepIncl_A s)
  let ι_step : ∀ s : Fin (m + 2), Z s.succ ⟶ Z s.castSucc :=
    fun s => CategoryTheory.Over.homMk (j_A s) (by
      change j_A s ≫ ((D_A s.castSucc).2.1 ≫ (weilProjectiveSpaceOver K N).hom) =
        (D_A s.succ).2.1 ≫ (weilProjectiveSpaceOver K N).hom
      rw [← CategoryTheory.Category.assoc, (hj_A_spec s).2])
  let U_step : ∀ s : Fin (m + 2), (Z s.castSucc).left.Opens :=
    fun s => (TopologicalSpace.Opens.map (D_A s.castSucc).2.1.base).obj
      (weilProjBasicOpen K N (c_A s))

  have hDatumIso : ∀ {D₁ D₂ : PresDatum N},
      D₁ = D₂ → ∃ e : D₁.1 ≅ D₂.1, e.hom ≫ D₂.2.1 = D₁.2.1 := by
    rintro D _ rfl
    exact ⟨CategoryTheory.Iso.refl D.1, CategoryTheory.Category.id_comp D.2.1⟩

  obtain ⟨e_Z0, he_Z0⟩ := hDatumIso hDA_0
  obtain ⟨e_bot, he_bot⟩ := hDatumIso hDA_last.symm

  let ι_tot : ∀ s : Fin (m + 3), (Z s).left ⟶ Q_t :=
    Fin.induction e_Z0.hom (fun s ih => (ι_step s).left ≫ ih)

  have hι_tot_zero : ι_tot 0 = e_Z0.hom :=
    Fin.induction_zero (motive := fun s => (Z s).left ⟶ Q_t)
      e_Z0.hom (fun s ih => (ι_step s).left ≫ ih)

  have hTot_amb_A : ∀ s : Fin (m + 3), ι_tot s ≫ ι_Qt = (D_A s).2.1 := by
    intro s
    refine Fin.induction ?_ (fun r ih => ?_) s
    · rw [hι_tot_zero]
      exact he_Z0
    · dsimp only [ι_tot] at ih ⊢
      rw [Fin.induction_succ, CategoryTheory.Category.assoc, ih]
      exact (hj_A_spec r).2

  
  let g_lin_Pm : ∀ (a : Fin (m + 1)) (s : Fin (m + 1)), Fin s.1 →
      ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K m a))) :=
    fun a s ν => t_Pm a ⟨ν.1, Nat.lt_trans ν.isLt s.isLt⟩

  have hProp_Pm : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K m).hom := hCoord_Pm.1
  have ht_diag_Pm : ∀ a : Fin (m + 1), t_Pm a a = 1 := hCoord_Pm.2.2.2.2.1
  have hT_ov_Pm := hCoord_Pm.2.2.2.2.2.2.2.2.2

  have hLinOv_Pm : ∀ (r : Fin m) (a a' : Fin (m + 1)) (ν : Fin r.succ.1),
      ((weilProjectiveSpaceOver K m).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_right).op).hom (g_lin_Pm a' r.succ ν) *
      (((weilProjectiveSpaceOver K m).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (t_Pm a a')) ^ 1 =
      ((weilProjectiveSpaceOver K m).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (g_lin_Pm a r.succ ν) := by
    intro r a a' ν
    rw [pow_one]
    exact hT_ov_Pm a a' _

  have hSubLin : ∀ r : Fin m,
      ∃ D : PresDatum m,
        (∀ a : Fin (m + 1),
          chartIdeal m D a = Ideal.span (Set.range (g_lin_Pm a r.succ)) ∧
          polyIdeal m θ_Pm D a =
            Ideal.span (Set.range (fun ν : Fin r.succ.1 =>
              (θ_Pm a).symm (g_lin_Pm a r.succ ν)))) ∧
        IsValidPresDatum m hAff_Pm D := by
    intro r
    obtain ⟨W_r, κ_r, hCl_r, hPres_r⟩ :=
      hSubEx_K m hAff_Pm c_Pm t_Pm hCoord_Pm r.succ.1 (fun _ => 1)
        (fun a => g_lin_Pm a r.succ) (hLinOv_Pm r)
    exact ⟨⟨W_r, κ_r, r.succ.1, fun a => g_lin_Pm a r.succ⟩,
      fun _ => ⟨rfl, rfl⟩, ⟨hCl_r, hPres_r⟩⟩

  let D_B0 : PresDatum m :=
    ⟨(weilProjectiveSpaceOver K m).left, 𝟙 (weilProjectiveSpaceOver K m).left, 0, fun _ => Fin.elim0⟩
  let D_Bpos : Fin m → PresDatum m := fun r => Classical.choose (hSubLin r)
  have hD_Bpos_spec : ∀ r : Fin m,
      (∀ a : Fin (m + 1),
        chartIdeal m (D_Bpos r) a = Ideal.span (Set.range (g_lin_Pm a r.succ)) ∧
        polyIdeal m θ_Pm (D_Bpos r) a =
          Ideal.span (Set.range (fun ν : Fin r.succ.1 =>
            (θ_Pm a).symm (g_lin_Pm a r.succ ν)))) ∧
      IsValidPresDatum m hAff_Pm (D_Bpos r) :=
    fun r => Classical.choose_spec (hSubLin r)

  let D_B : Fin (m + 1) → PresDatum m := Fin.cases D_B0 D_Bpos

  have hValid_B : ∀ s : Fin (m + 1), IsValidPresDatum m hAff_Pm (D_B s) := by
    intro s
    refine Fin.cases ?_ (fun r => ?_) s
    · exact hIdPresDatum m hAff_Pm
    · exact (hD_Bpos_spec r).2

  have hDB_ideals : ∀ (s : Fin (m + 1)) (a : Fin (m + 1)),
      chartIdeal m (D_B s) a = Ideal.span (Set.range (g_lin_Pm a s)) ∧
      polyIdeal m θ_Pm (D_B s) a =
        Ideal.span (Set.range (fun ν : Fin s.1 => (θ_Pm a).symm (g_lin_Pm a s ν))) := by
    intro s a
    refine Fin.cases ?_ (fun r => ?_) s
    · dsimp only [D_B]
      rw [Fin.cases_zero]
      dsimp only [D_B0, chartIdeal, polyIdeal]
      have h1 : Set.range (Fin.elim0 : Fin 0 → _) =
          Set.range (g_lin_Pm a 0) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨ν, _⟩; exact Fin.elim0 ν
        · rintro ⟨ν, _⟩
          exfalso
          have h0 : (0 : Fin (m + 1)).1 = 0 := by simp
          have hν : ν.1 < (0 : Fin (m + 1)).1 := ν.isLt
          omega
      have h2 : Set.range (fun ν : Fin 0 => (θ_Pm a).symm (Fin.elim0 ν)) =
          Set.range (fun ν : Fin (0 : Fin (m + 1)).1 => (θ_Pm a).symm (g_lin_Pm a 0 ν)) := by
        ext x; simp only [Set.mem_range]
        constructor
        · rintro ⟨ν, _⟩; exact Fin.elim0 ν
        · rintro ⟨ν, _⟩
          exfalso
          have h0 : (0 : Fin (m + 1)).1 = 0 := by simp
          have hν : ν.1 < (0 : Fin (m + 1)).1 := ν.isLt
          omega
      rw [h1, h2]
      exact ⟨rfl, rfl⟩
    · exact (hD_Bpos_spec r).1 a

  have hStepIdeal_B : ∀ (s : Fin m) (a : Fin (m + 1)),
      chartIdeal m (D_B s.succ) a =
        chartIdeal m (D_B s.castSucc) a ⊔ Ideal.span {t_Pm a s.castSucc} := by
    intro s a
    rw [(hDB_ideals s.succ a).1, (hDB_ideals s.castSucc a).1]
    exact (hLinearSubspaceAlg _ (c_Pm a) (t_Pm a)).1 s

  have hStepIncl_B : ∀ s : Fin m,
      ∃ j_s : (D_B s.succ).1 ⟶ (D_B s.castSucc).1,
        AlgebraicGeometry.IsClosedImmersion j_s ∧
        j_s ≫ (D_B s.castSucc).2.1 = (D_B s.succ).2.1 := by
    intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_B s.castSucc).2.1 := (hValid_B s.castSucc).1
    have : AlgebraicGeometry.IsClosedImmersion (D_B s.succ).2.1 := (hValid_B s.succ).1
    exact hSubIncl_K m hAff_Pm c_Pm t_Pm hCoord_Pm
      (D_B s.castSucc).1 (D_B s.castSucc).2.1 (D_B s.castSucc).2.2.1 (D_B s.castSucc).2.2.2
      (D_B s.succ).1 (D_B s.succ).2.1 (D_B s.succ).2.2.1 (D_B s.succ).2.2.2
      (hValid_B s.castSucc).2 (hValid_B s.succ).2
      (fun a => by change chartIdeal m (D_B s.castSucc) a ≤ chartIdeal m (D_B s.succ) a; rw [hStepIdeal_B s a]; exact le_sup_left)

  let P_step : Fin (m + 1) → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    fun s => CategoryTheory.Over.mk ((D_B s).2.1 ≫ (weilProjectiveSpaceOver K m).hom)
  let j_B : ∀ s : Fin m, (P_step s.succ).left ⟶ (P_step s.castSucc).left :=
    fun s => Classical.choose (hStepIncl_B s)
  have hj_B_spec : ∀ s : Fin m,
      AlgebraicGeometry.IsClosedImmersion (j_B s) ∧
      j_B s ≫ (D_B s.castSucc).2.1 = (D_B s.succ).2.1 :=
    fun s => Classical.choose_spec (hStepIncl_B s)
  let κ_step : ∀ s : Fin m, P_step s.succ ⟶ P_step s.castSucc :=
    fun s => CategoryTheory.Over.homMk (j_B s) (by
      change j_B s ≫ ((D_B s.castSucc).2.1 ≫ (weilProjectiveSpaceOver K m).hom) =
        (D_B s.succ).2.1 ≫ (weilProjectiveSpaceOver K m).hom
      rw [← CategoryTheory.Category.assoc, (hj_B_spec s).2])
  let V_step : ∀ s : Fin m, (P_step s.castSucc).left.Opens :=
    fun s => (TopologicalSpace.Opens.map (D_B s.castSucc).2.1.base).obj
      (weilProjBasicOpen K m s.castSucc)
  let κ_tot : ∀ s : Fin (m + 1), (P_step s).left ⟶ (weilProjectiveSpaceOver K m).left :=
    fun s => (D_B s).2.1

  
  refine ⟨⟨Z, ι_step, U_step, ι_tot, e_bot, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
          ⟨P_step, κ_step, V_step, κ_tot, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩⟩
  · intro s
    have : AlgebraicGeometry.IsClosedImmersion (D_A s).2.1 := (hValid_A s).1
    change AlgebraicGeometry.IsProper ((D_A s).2.1 ≫ (weilProjectiveSpaceOver K N).hom)
    infer_instance
  · intro s
    exact (hj_A_spec s).1
  · intro s
    exact hComplBridge N hAff_K c_K t_K hCoord_K (D_A s.castSucc) (D_A s.succ)
      (hValid_A s.castSucc) (hValid_A s.succ) (j_A s) (hj_A_spec s).2 (c_A s) (hStepIdeal_A s)
  · intro j
    have hcA : c_A j.castSucc = u_idx j := Fin.lastCases_castSucc j
    have hBridge := hChartPolyBridge N hAff_K c_K t_K θ_K hCoord_K hθ_K
      (D_A j.castSucc.castSucc) (hValid_A _) (c_A j.castSucc)
    have hPolyEq : polyIdeal N θ_K (D_A j.castSucc.castSucc) (c_A j.castSucc) =
        Ideal.span (Set.range (fun ν : Fin (j.castSucc.1 + 1) =>
          (θ_K (u_idx j)).symm (g_quad_K (u_idx j) j.castSucc ν))) := by
      rw [hcA]
      exact (hDA_quad_ideals j.castSucc (u_idx j)).2
    obtain ⟨_, _, hMidAlg, _⟩ := hSplitQuadricAlg _ (c_K (u_idx j)) (t_K (u_idx j))
    obtain ⟨Φ_j, hΦ_j⟩ :=
      hMidAlg j (θ_K (u_idx j)) (ht_diag_K (u_idx j)) (hθ_K (u_idx j)).1 (hθ_K (u_idx j)).2
    let Φ' : MvPolynomial (Fin (2 * m + 1 - j.1)) K ≃+*
        (MvPolynomial (Fin N) K ⧸
          polyIdeal N θ_K (D_A j.castSucc.castSucc) (c_A j.castSucc)) :=
      Φ_j.trans (Ideal.quotEquivOfEq hPolyEq.symm)
    have hΦ'_C : Φ'.toRingHom.comp MvPolynomial.C =
        (Ideal.Quotient.mk _).comp MvPolynomial.C := by
      ext k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe, Φ', RingEquiv.trans_apply]
      have h1 := RingHom.congr_fun hΦ_j k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe] at h1
      rw [h1, Ideal.quotEquivOfEq_mk]
    exact hBridge.2.1 (2 * m + 1 - j.1) Φ' hΦ'_C
  · intro ht
    have hcA : c_A (Fin.last (m + 1)) = w_idx := Fin.lastCases_last
    have hBridge := hChartPolyBridge N hAff_K c_K t_K θ_K hCoord_K hθ_K
      (D_A (Fin.last (m + 1)).castSucc) (hValid_A _) (c_A (Fin.last (m + 1)))
    have hPolyEq : polyIdeal N θ_K (D_A (Fin.last (m + 1)).castSucc) (c_A (Fin.last (m + 1))) =
        Ideal.span (Set.range (fun ν : Fin ((Fin.last (m + 1)).1 + 1) =>
          (θ_K w_idx).symm (g_quad_K w_idx (Fin.last (m + 1)) ν))) := by
      rw [hcA]
      exact (hDA_quad_ideals (Fin.last (m + 1)) w_idx).2
    obtain ⟨_, _, _, hTopAlg⟩ := hSplitQuadricAlg _ (c_K w_idx) (t_K w_idx)
    obtain ⟨hTopNe, _⟩ :=
      hTopAlg (θ_K w_idx) (ht_diag_K w_idx) (hθ_K w_idx).1 (hθ_K w_idx).2
    apply hBridge.1
    rw [hPolyEq]
    exact hTopNe ht
  · intro ht0
    have hcA : c_A (Fin.last (m + 1)) = w_idx := Fin.lastCases_last
    have hBridge := hChartPolyBridge N hAff_K c_K t_K θ_K hCoord_K hθ_K
      (D_A (Fin.last (m + 1)).castSucc) (hValid_A _) (c_A (Fin.last (m + 1)))
    have hPolyEq : polyIdeal N θ_K (D_A (Fin.last (m + 1)).castSucc) (c_A (Fin.last (m + 1))) =
        Ideal.span (Set.range (fun ν : Fin ((Fin.last (m + 1)).1 + 1) =>
          (θ_K w_idx).symm (g_quad_K w_idx (Fin.last (m + 1)) ν))) := by
      rw [hcA]
      exact (hDA_quad_ideals (Fin.last (m + 1)) w_idx).2
    obtain ⟨_, _, _, hTopAlg⟩ := hSplitQuadricAlg _ (c_K w_idx) (t_K w_idx)
    obtain ⟨_, hTopZero⟩ :=
      hTopAlg (θ_K w_idx) (ht_diag_K w_idx) (hθ_K w_idx).1 (hθ_K w_idx).2
    obtain ⟨Φ_top, hΦ_top⟩ := hTopZero ht0
    let Φ' : MvPolynomial (Fin (m + 1)) K ≃+*
        (MvPolynomial (Fin N) K ⧸
          polyIdeal N θ_K (D_A (Fin.last (m + 1)).castSucc) (c_A (Fin.last (m + 1)))) :=
      Φ_top.trans (Ideal.quotEquivOfEq hPolyEq.symm)
    have hΦ'_C : Φ'.toRingHom.comp MvPolynomial.C =
        (Ideal.Quotient.mk _).comp MvPolynomial.C := by
      ext k
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe, Φ', RingEquiv.trans_apply]
