          ((CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map
              (AddCommGrpCat.ofHom
                (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom))))) ∧
    (∀ (r : ℕ) (W : X.Etale)
        (p_W0 : weilEtaleTorsionH
