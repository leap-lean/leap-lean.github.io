    let ρ₁ := weilPolyP1CohomologyRepPullHom g' U U' u₁
    let ρ₂ := weilPolyP1CohomologyRepPullHom g'' U' U'' u₂
    let ρ₁₂ := weilPolyP1CohomologyRepPullHom g'₁₂ U U''₁₂ u₁₂
