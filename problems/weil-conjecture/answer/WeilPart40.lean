    let s_comp : ↑(M.obj.obj (Opposite.op ((weilEtaleSitePullback g'').obj
        ((weilEtaleSitePullback g').obj U)))) :=
      ((adj_g''.unit.app (pb_g'.obj A₀)).hom.app
        (Opposite.op ((weilEtaleSitePullback g').obj U))).hom s_pull₁
    let s_pull₁₂ := ((adj_g'₁₂.unit.app A₀).hom.app (Opposite.op U)).hom ι_U
    let s_pull₂ := ((adj_g''.unit.app A'₀).hom.app (Opposite.op U')).hom ι_U'
    apply (weilPolyP1CohomologyRepHomEquiv X'' U'' M).injective
