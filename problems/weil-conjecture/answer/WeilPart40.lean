          change p₁ (h_Z_left (e_OZ p_bar)) = x_A
          rw [hp_bar, hh_pt', hv₀_p₁]
        change e_U.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫
