      ∀ (s : ℕ), 2 ≤ s → Subsingleton (𝒢.H s)) :
    let e := weilOuterTrFibEdgeHom f T_S hT_X ℱ (q₀ + 1)
    Function.Surjective e ∧
    Nonempty (↥(AddMonoidHom.ker e) ≃+ (weilEtaleHigherDirectImage f q₀ ℱ).H 1) :=
by
  have _ := hM
  
  have hCrux : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      (U₀ R₀ A₀ Q₀ R₁ : 𝒜)
      (f₀ : R₀ ⟶ A₀) (g₀ : A₀ ⟶ Q₀) (δ₀ : Q₀ ⟶ R₁)
      (h₁ : f₀ ≫ g₀ = 0) (h₂ : g₀ ≫ δ₀ = 0)
      (_hf₀ : CategoryTheory.Mono f₀) (_hδ₀ : CategoryTheory.Epi δ₀)
      (_hex₁ : (CategoryTheory.ShortComplex.mk f₀ g₀ h₁).Exact)
      (_hex₂ : (CategoryTheory.ShortComplex.mk g₀ δ₀ h₂).Exact)
      (_hA₀_1 : Subsingleton (CategoryTheory.Abelian.Ext.{u} U₀ A₀ 1))
      (_hTor_R₀ : M • CategoryTheory.CategoryStruct.id R₀ = 0)
      (_hTor_A₀ : M • CategoryTheory.CategoryStruct.id A₀ = 0)
      (_hCd1_𝒜 : ∀ (G : 𝒜), M • CategoryTheory.CategoryStruct.id G = 0 →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} U₀ G 2)),
      let g₀_0 := (CategoryTheory.Abelian.Ext.mk₀ g₀).postcomp U₀ (Nat.add_zero 0)
      let δ₀_0 := (CategoryTheory.Abelian.Ext.mk₀ δ₀).postcomp U₀ (Nat.add_zero 0)
      let δ₀_1 := (CategoryTheory.Abelian.Ext.mk₀ δ₀).postcomp U₀ (Nat.add_zero 1)
      Function.Surjective δ₀_0 ∧
      (∃ bdry₀ : ↥(AddMonoidHom.ker δ₀_0) →+ CategoryTheory.Abelian.Ext.{u} U₀ R₀ 1,
        Function.Surjective bdry₀ ∧
        ∀ z : ↥(AddMonoidHom.ker δ₀_0), bdry₀ z = 0 ↔ z.1 ∈ AddMonoidHom.range g₀_0) ∧
      Function.Bijective δ₀_1 := by
    intro 𝒜 _ _ _ U₀ R₀ A₀ Q₀ R₁ f₀ g₀ δ₀ h₁ h₂ hf₀ hδ₀ hex₁ hex₂ hA₀_1
      hTor_R₀ hTor_A₀ hCd1_𝒜 g₀_0 δ₀_0 δ₀_1
    let I₀ : 𝒜 := CategoryTheory.Abelian.image g₀
    let q_v : A₀ ⟶ I₀ := CategoryTheory.Abelian.factorThruImage g₀
    let i_v : I₀ ⟶ Q₀ := CategoryTheory.Abelian.image.ι g₀
