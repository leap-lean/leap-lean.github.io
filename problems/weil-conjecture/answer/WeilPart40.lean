      Subsingleton.intro fun x₁ x₂ =>
        e_pX.symm.injective (@Subsingleton.elim _ hSub0 (e_pX.symm x₁) (e_pX.symm x₂))
    have hw_zero : ∀ w : (pf_i.obj ((U_sh S_k).obj I)).H m, w = 0 := by
      intro w
      have hw' : w.comp (CategoryTheory.Abelian.Ext.mk₀ e_I.hom) (Nat.add_zero m) = 0 :=
        @Subsingleton.elim (((U_sh X).obj I_X).H m) hSub_IX _ _
      calc w = w.comp (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.id (pf_i.obj ((U_sh S_k).obj I))))
            (Nat.add_zero m) := (CategoryTheory.Abelian.Ext.comp_mk₀_id w).symm
        _ = w.comp (CategoryTheory.Abelian.Ext.mk₀ (e_I.hom ≫ e_I.inv)) (Nat.add_zero m) := by
            rw [e_I.hom_inv_id]
        _ = (w.comp (CategoryTheory.Abelian.Ext.mk₀ e_I.hom) (Nat.add_zero m)).comp
