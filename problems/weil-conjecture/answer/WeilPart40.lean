theorem weil_proj_quadric_prime_pow_affine_cell_local_cohomology (K : Type u) [Field K] [IsAlgClosed K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds K ℓ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Y.hom]
    (U : Y.left.Opens) (d : ℕ)
    (e_U : U.toScheme ≅ (weilAffineSpaceOver K d).left)
    (he_U : e_U.hom ≫ (weilAffineSpaceOver K d).hom = U.ι ≫ Y.hom) :
    let U_et : Y.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι (inferInstance : AlgebraicGeometry.Etale U.ι)
    (∀ r_deg : ℕ, r_deg ≠ 2 * d → Subsingleton (weilEtaleLocalTorsionH Y.left ℓ U_et r_deg)) ∧
    Finite (weilEtaleLocalTorsionH Y.left ℓ U_et (2 * d)) ∧
    Nat.card (weilEtaleLocalTorsionH Y.left ℓ U_et (2 * d)) = ℓ :=
by
  intro U_et
  obtain ⟨ι_P1, ι_aff, _, _, _, _, hOpen_P1, hι_P1_hom,
      ⟨s_inf, _, hs_inf_hom, hDisj_inf, hCov_inf, _⟩, hι_aff0, hPoly_all⟩ :=
    weil_polyP1_coord_compactification_and_properness K
  have : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen_P1
  let U_aff_et : ∀ δ : ℕ, (weilPolyP1Over K δ).left.Etale :=
    fun δ => CategoryTheory.MorphismProperty.Over.mk ⊤ (ι_aff δ)
      (by have := (hPoly_all δ).2.1; infer_instance)

  
  have hDimSpecK :
      topologicalKrullDim (AlgebraicGeometry.Spec (CommRingCat.of K)) ≤
        (0 : WithBot ℕ∞) := by
    have : Subsingleton (TopologicalSpace.IrreducibleCloseds
        (AlgebraicGeometry.Spec (CommRingCat.of K))) := by
      refine ⟨fun A B => ?_⟩
      ext x
      obtain ⟨a, ha⟩ := A.isIrreducible.nonempty
      obtain ⟨b, hb⟩ := B.isIrreducible.nonempty
      exact ⟨fun _ => Subsingleton.elim x b ▸ hb, fun _ => Subsingleton.elim x a ▸ ha⟩
    have : Nonempty (TopologicalSpace.IrreducibleCloseds
        (AlgebraicGeometry.Spec (CommRingCat.of K))) :=
      ⟨⟨Set.univ,
        ⟨⟨(⊥ : PrimeSpectrum K), trivial⟩,
          fun u v _ _ ⟨x_u, _, hxu⟩ ⟨x_v, _, hyv⟩ =>
            ⟨(⊥ : PrimeSpectrum K), trivial,
              by rwa [Subsingleton.elim (⊥ : PrimeSpectrum K) x_u],
              by rwa [Subsingleton.elim (⊥ : PrimeSpectrum K) x_v]⟩⟩,
        isClosed_univ⟩⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds
        (AlgebraicGeometry.Spec (CommRingCat.of K))) ≤ 0
    rw [Order.krullDim_eq_zero]

  
  have hPolyP1All : ∀ δ : ℕ,
      (∀ r_deg : ℕ, r_deg ≠ 2 * δ →
        Subsingleton (weilEtaleLocalTorsionH (weilPolyP1Over K δ).left ℓ (U_aff_et δ) r_deg)) ∧
      Finite (weilEtaleLocalTorsionH (weilPolyP1Over K δ).left ℓ (U_aff_et δ) (2 * δ)) ∧
      Nat.card (weilEtaleLocalTorsionH (weilPolyP1Over K δ).left ℓ (U_aff_et δ) (2 * δ)) = ℓ := by
    intro δ
    induction δ with
    | zero =>
      let Z₀ := weilPolyP1Over K 0
      have : AlgebraicGeometry.LocallyOfFiniteType Z₀.hom := by
        change AlgebraicGeometry.LocallyOfFiniteType (𝟙 _)
        infer_instance
      have : AlgebraicGeometry.QuasiCompact Z₀.hom := by
        change AlgebraicGeometry.QuasiCompact (𝟙 _)
        infer_instance
      have hVan0 : ∀ r_deg : ℕ, r_deg ≠ 2 * 0 →
