    · intro s θ _ _ hθ_X J_s
      have hθ_symm_succ : ∀ i : Fin m, θ.symm (τ (s.castSucc.succAbove i)) = MvPolynomial.X i := by
        intro i
        apply θ.injective
        rw [θ.apply_symm_apply, hθ_X i]
      have h_gen_eq : ∀ ν : Fin s.1,
          θ.symm (g_lin s.castSucc ν) = MvPolynomial.X ⟨ν.1, by omega⟩ := by
        intro ν
