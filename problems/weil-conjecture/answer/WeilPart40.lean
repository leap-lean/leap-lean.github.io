  have hLinearSubspaceAlg :
      ∀ (A : Type u) [CommRing A] (c : K →+* A) (τ : Fin (m + 1) → A),
        let g_lin : ∀ s : Fin (m + 1), Fin s.1 → A :=
          fun s ν => τ ⟨ν.1, Nat.lt_trans ν.isLt s.isLt⟩
        (∀ s : Fin m,
          Ideal.span (Set.range (g_lin s.succ)) =
            Ideal.span (Set.range (g_lin s.castSucc)) ⊔ Ideal.span {τ s.castSucc}) ∧
        (∀ (s : Fin m) (θ : MvPolynomial (Fin m) K ≃+* A),
          τ s.castSucc = 1 →
          θ.toRingHom.comp MvPolynomial.C = c →
          (∀ i : Fin m, θ (MvPolynomial.X i) = τ (s.castSucc.succAbove i)) →
          let J_s : Ideal (MvPolynomial (Fin m) K) :=
            Ideal.span (Set.range (fun ν : Fin s.castSucc.1 => θ.symm (g_lin s.castSucc ν)))
          ∃ Φ_s : MvPolynomial (Fin (m - s.1)) K ≃+* (MvPolynomial (Fin m) K ⧸ J_s),
            Φ_s.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk J_s).comp MvPolynomial.C) ∧
        (∀ (a : Fin (m + 1)) (θ : MvPolynomial (Fin m) K ≃+* A),
          a ≠ Fin.last m →
          τ a = 1 →
          (1 : MvPolynomial (Fin m) K) ∈
            Ideal.span (Set.range (fun ν : Fin (Fin.last m).1 =>
              θ.symm (g_lin (Fin.last m) ν)))) ∧
        (∀ (θ : MvPolynomial (Fin m) K ≃+* A),
          τ (Fin.last m) = 1 →
          θ.toRingHom.comp MvPolynomial.C = c →
          (∀ i : Fin m, θ (MvPolynomial.X i) = τ ((Fin.last m).succAbove i)) →
          let J_last : Ideal (MvPolynomial (Fin m) K) :=
            Ideal.span (Set.range (fun ν : Fin (Fin.last m).1 =>
              θ.symm (g_lin (Fin.last m) ν)))
          ∃ Φ_last : K ≃+* (MvPolynomial (Fin m) K ⧸ J_last),
            Φ_last.toRingHom = (Ideal.Quotient.mk J_last).comp MvPolynomial.C) := by
    clear * - hMvPolyQuotEquiv
    intro A _ c τ g_lin
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro s
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨μ, rfl⟩
        refine Fin.lastCases ?_ (fun ν => ?_) μ
        · apply Ideal.mem_sup_right
