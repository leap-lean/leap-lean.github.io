        let _ : Module.Finite L_r ↥R_T := Module.Finite.of_basis b_RT
        let _ : Algebra.IsIntegral L_r ↥R_T := Algebra.IsIntegral.of_finite L_r ↥R_T
        have hIsField_RT : IsField ↥R_T :=
          isField_of_isIntegral_of_isField' (Field.toIsField L_r)
        have hRT_inv : ∀ v ∈ R_T, v⁻¹ ∈ R_T := by
          intro v hv
          by_cases hv0 : v = 0
          · rw [hv0, inv_zero]; exact R_T.zero_mem
          · have hv_ne : (⟨v, hv⟩ : ↥R_T) ≠ 0 := fun h0 => hv0 (congrArg Subtype.val h0)
