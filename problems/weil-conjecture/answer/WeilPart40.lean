    have hSqZ : WeilEtaleSquareDegreeZeroPBC i₀ z_bar f' g'
        (CategoryTheory.IsPullback.of_hasPullback i₀ z_bar) :=
      (weil_etale_pbc_reduction_to_affine_geom_point hArtEpi hAffGeom
        i₀ z_bar f' g' (CategoryTheory.IsPullback.of_hasPullback i₀ z_bar)).2
