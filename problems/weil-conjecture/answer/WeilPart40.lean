        (weilEtaleSitePullback g'').map ((weilOuterBCFunIso f g₁ f' g' hgf₁).inv.app W) := by
    intro W
    have hInvLeft : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        {F G : CategoryTheory.Functor Y₂.Etale Y₁.Etale}
