      CategoryTheory.Functor.sheafPushforwardContinuousComp'_inv_app_hom_app
        e_B.symm AddCommGrpCat.{u} J_S J_S' J_S'' R_S'' (Opposite.op W)
    have hLHS_eq : ((β_Tor₁₂ ≫ e_pf.hom.app R_S'').hom.app (Opposite.op W)).hom s =
        (R_S''.obj.map (Opposite.op (e_B.inv.app W))).hom ((β_Tor₁₂.hom.app (Opposite.op W)).hom s) :=
