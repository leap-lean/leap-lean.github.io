      change φ ((e₀ (ψ₁ u)).comp α (Nat.add_zero 0)) = (φ α).val • ψ₁ u
      rw [he₀_comp (ψ₁ u) α, map_nsmul, nsmul_eq_mul, nsmul_eq_mul,
        hval_cast, hval_cast, mul_comm]
    change τ (α.comp (E_top G φ) (Nat.zero_add (2 * d))) = φ α * u₀
    rw [hE_nat G φ α, hpull, map_nsmul, map_nsmul, nsmul_eq_mul, hval_cast]
  obtain ⟨w₁, hw₁⟩ := hτ_bij.2 1
  let φ₁ := (E_top one_Z).symm w₁
  have hv₀_mul : φ₁ id_ext0 * u₀ = 1 := by
    have h1 := hΦ_top_eval one_Z φ₁ id_ext0
    change τ (id_ext0.comp (E_top one_Z φ₁) (Nat.zero_add (2 * d))) = φ₁ id_ext0 * u₀ at h1
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, (E_top one_Z).apply_symm_apply w₁, hw₁] at h1
    exact h1.symm
  let v₀ : ZMod M := φ₁ id_ext0
  have hu₀_mul : u₀ * v₀ = 1 := by rw [mul_comm]; exact hv₀_mul
  have hΦ_base : ∀ (q : ℕ) (hq : 0 + q = 2 * d) (G : 𝒞),
      Function.Bijective (Φ G 0 q hq) := by
    intro q hq G
    have hq_eq : q = 2 * d := by omega
    subst hq_eq
    have hhpq : hq = Nat.zero_add (2 * d) := Subsingleton.elim _ _
    rw [hhpq]
    have hscale_bij : Function.Bijective
        (fun φ : CategoryTheory.Abelian.Ext.{u} one_Z G 0 →+ ZMod M =>
          Φ G 0 (2 * d) (Nat.zero_add (2 * d)) (E_top G φ)) := by
      refine ⟨?_, ?_⟩
      · intro ψ_a ψ_b h_eq
        ext α
        have h_ap := DFunLike.congr_fun h_eq α
        rw [hΦ_top_eval G ψ_a α, hΦ_top_eval G ψ_b α] at h_ap
        calc
          ψ_a α = ψ_a α * (u₀ * v₀) := by rw [hu₀_mul, mul_one]
          _ = (ψ_a α * u₀) * v₀ := (mul_assoc _ _ _).symm
          _ = (ψ_b α * u₀) * v₀ := by rw [h_ap]
          _ = ψ_b α * (u₀ * v₀) := mul_assoc _ _ _
          _ = ψ_b α := by rw [hu₀_mul, mul_one]
      · intro χ
        let φ_pre : CategoryTheory.Abelian.Ext.{u} one_Z G 0 →+ ZMod M :=
          AddMonoidHom.mk' (fun α => χ α * v₀) (fun α₁ α₂ => by rw [map_add, add_mul])
        refine ⟨φ_pre, ?_⟩
        ext α
        rw [hΦ_top_eval G φ_pre α]
        change (χ α * v₀) * u₀ = χ α
        rw [mul_assoc, hv₀_mul, mul_one]
    exact Function.Bijective.of_comp_iff (Φ G 0 (2 * d) (Nat.zero_add (2 * d)))
      (E_top G).bijective |>.mp hscale_bij
  have hΦ_bij : ∀ (p q : ℕ) (hpq : p + q = 2 * d) (G : 𝒞),
      Function.Bijective (Φ G p q hpq) := by
    intro p
    induction p with
    | zero => exact hΦ_base
    | succ p ih =>
      intro q hpq G
      have hq_lt : q < 2 * d := by omega
      have hpq' : p + (q + 1) = 2 * d := by omega
      have h1q : 1 + q = q + 1 := Nat.one_add q
      let f_G : Quiver.Hom G ((𝒯 0).obj G) := η.app G
      let Q : 𝒞 := CategoryTheory.Limits.cokernel f_G
      let π₀ : Quiver.Hom ((𝒯 0).obj G) Q := CategoryTheory.Limits.cokernel.π f_G
      have h_epi_π₀ : CategoryTheory.Epi π₀ := CategoryTheory.Limits.coequalizer.π_epi
      let S_G : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk f_G π₀ (CategoryTheory.Limits.cokernel.condition f_G)
      have hSG : S_G.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel f_G
          mono_f := hMonoη G
          epi_g := h_epi_π₀ }
      let δ : CategoryTheory.Abelian.Ext.{u} Q G 1 := hSG.extClass
      have hSub_T0_q : Subsingleton (CategoryTheory.Abelian.Ext.{u} ((𝒯 0).obj G) one_Z q) :=
        hVan ((𝒯 0).obj G) (fun n_deg hn_deg => hAcyc 0 n_deg hn_deg G) q hq_lt
      have hSub_T0_p1 : Subsingleton (CategoryTheory.Abelian.Ext.{u} one_Z ((𝒯 0).obj G) (p + 1)) :=
        hAcyc 0 (p + 1) (by omega) G
      have hQ_bij := ih (q + 1) hpq' Q
      have hT_bij := ih (q + 1) hpq' ((𝒯 0).obj G)
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro β hβ0
        have hδβ_zero : Φ Q p (q + 1) hpq' (δ.comp β h1q) = 0 := by
          ext ξ
          change τ (ξ.comp (δ.comp β h1q) hpq') = 0
          have hassoc : (ξ.comp δ rfl).comp β hpq = ξ.comp (δ.comp β h1q) hpq' :=
            CategoryTheory.Abelian.Ext.comp_assoc ξ δ β rfl h1q (by omega)
          rw [← hassoc]
          exact DFunLike.congr_fun hβ0 (ξ.comp δ rfl)
        have hδβ : δ.comp β h1q = 0 :=
          (injective_iff_map_eq_zero _).mp hQ_bij.1 (δ.comp β h1q) hδβ_zero
        obtain ⟨γ, hγ⟩ :=
          CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hSG one_Z β h1q hδβ
        have hγ0 : γ = 0 := @Subsingleton.elim _ hSub_T0_q γ 0
        rw [← hγ, hγ0, CategoryTheory.Abelian.Ext.comp_zero]
      · intro ψ
        let ψ_Q : CategoryTheory.Abelian.Ext.{u} one_Z Q p →+ ZMod M :=
          AddMonoidHom.mk' (fun ξ => ψ (ξ.comp δ rfl))
            (fun ξ₁ ξ₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add])
        obtain ⟨x₃, hx₃⟩ := hQ_bij.2 ψ_Q
        have hπ_x₃_zero : Φ ((𝒯 0).obj G) p (q + 1) hpq'
            ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1))) = 0 := by
          ext ζ_ext
          change τ (ζ_ext.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1))) hpq') = 0
          have hassoc : (ζ_ext.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp x₃ hpq' =
              ζ_ext.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1))) hpq' :=
            CategoryTheory.Abelian.Ext.comp_assoc ζ_ext (CategoryTheory.Abelian.Ext.mk₀ π₀) x₃
              (Nat.add_zero p) (Nat.zero_add (q + 1)) (by omega)
          rw [← hassoc]
          have h1 := DFunLike.congr_fun hx₃
            (ζ_ext.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p))
          change τ ((ζ_ext.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp x₃ hpq') =
            ψ ((ζ_ext.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp δ rfl) at h1
          have hπδ : (CategoryTheory.Abelian.Ext.mk₀ π₀).comp δ (Nat.zero_add 1) = 0 :=
            hSG.comp_extClass
          have hassoc2 : (ζ_ext.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p)).comp δ rfl =
              ζ_ext.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp δ (Nat.zero_add 1)) rfl :=
            CategoryTheory.Abelian.Ext.comp_assoc ζ_ext (CategoryTheory.Abelian.Ext.mk₀ π₀) δ
              (Nat.add_zero p) (Nat.zero_add 1) (by omega)
          rw [h1, hassoc2, hπδ, CategoryTheory.Abelian.Ext.comp_zero, map_zero]
        have hπ_x₃ : (CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q + 1)) = 0 :=
          (injective_iff_map_eq_zero _).mp hT_bij.1 _ hπ_x₃_zero
        obtain ⟨β, hβ⟩ :=
          CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSG one_Z x₃ hπ_x₃ h1q
        refine ⟨β, ?_⟩
        ext α
        have hα_f : α.comp (CategoryTheory.Abelian.Ext.mk₀ f_G) (Nat.add_zero (p + 1)) = 0 :=
          @Subsingleton.elim _ hSub_T0_p1 _ 0
        obtain ⟨ξ, hξ⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one_Z hSG α hα_f rfl
        change τ (α.comp β hpq) = ψ α
        have hassoc3 : (ξ.comp δ rfl).comp β hpq = ξ.comp (δ.comp β h1q) hpq' :=
          CategoryTheory.Abelian.Ext.comp_assoc ξ δ β rfl h1q (by omega)
        rw [← hξ, hassoc3, hβ]
        exact DFunLike.congr_fun hx₃ ξ
  intro G q hq
  have hpq : (2 * d - q) + q = 2 * d := Nat.sub_add_cancel hq
  exact ⟨AddEquiv.ofBijective (Φ G (2 * d - q) q hpq) (hΦ_bij (2 * d - q) q hpq G)⟩

theorem weil_trait_verdier_clean_slice_coker_card_le (k : Type u) [Field k] [IsAlgClosed k]
    (d q₀ ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (hq₀ : q₀ + 1 ≤ 2 * d)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt_Z : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d Z_bar.hom]
    (Z_s : AlgebraicGeometry.Scheme.{u})
    (i_s : Z_s ⟶ Z_bar.left) [AlgebraicGeometry.IsClosedImmersion i_s]
    (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥]
    (W_st W_op : 𝒥 → Z_bar.left.Etale)
    (m_st : ∀ {j₁ j₂ : 𝒥}, (j₁ ⟶ j₂) → (W_st j₂ ⟶ W_st j₁))
    (m_op : ∀ {j₁ j₂ : 𝒥}, (j₁ ⟶ j₂) → (W_op j₂ ⟶ W_op j₁))
    (v_open : ∀ j : 𝒥, W_op j ⟶ W_st j)
    (hv_comm : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂), m_op θ ≫ v_open j₁ = v_open j₂ ≫ m_st θ)
    (hv_imm : ∀ j : 𝒥,
      AlgebraicGeometry.IsOpenImmersion
        ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).map (v_open j)).left)
    (hv_range : ∀ j : 𝒥,
      Set.range ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).map (v_open j)).left.base =
        { y : ↥((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_st j)).left |
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_st j)).hom.base y ∉
            Set.range i_s.base })
    (hfib_iso : ∀ j : 𝒥,
      CategoryTheory.IsIso
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_st j)).hom i_s))
    (hFin_Zs : Finite (weilEtaleTorsionH Z_s (ℓ ^ (r + 1)) (2 * d - (q₀ + 1)))) :
    let M := ℓ ^ (r + 1)
    ∃ (D_dual : Type u) (_ : AddCommGroup D_dual) (_ : Finite D_dual)
      (δ_j : ∀ j : 𝒥,
        weilEtaleTorsionH
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_op j)).left M q₀ →+
          D_dual),
      Nat.card D_dual ≤ Nat.card (weilEtaleTorsionH Z_s M (2 * d - (q₀ + 1))) ∧
      (∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂)
          (p_θ : weilEtaleTorsionH
              ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_op j₁)).left M q₀ →+
            weilEtaleTorsionH
              ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_op j₂)).left M q₀),
        WeilIsTorsionEtalePullback
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).map (m_op θ)).left M q₀ p_θ →
        (δ_j j₂).comp p_θ = δ_j j₁) ∧
      (∀ (j : 𝒥)
          (p_v : weilEtaleTorsionH
              ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_st j)).left M q₀ →+
            weilEtaleTorsionH
              ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (W_op j)).left M q₀),
        WeilIsTorsionEtalePullback
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).map (v_open j)).left M q₀ p_v →
        AddMonoidHom.ker (δ_j j) = AddMonoidHom.range p_v) :=
by
  intro M
  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hM_pos : 0 < M := by
    dsimp [M]
    exact pow_pos hℓ_pos (r + 1)
  haveI : NeZero M := ⟨hM_pos.ne'⟩
  let S := Z_bar.left
  let R := ULift.{u, 0} (ZMod M)
  obtain ⟨hc_all, _, _⟩ := weil_etale_site_pullback_rightAdjoint_and_exact_package
  letI hc_is : (weilEtaleSitePullback i_s).IsContinuous
      S.smallEtaleTopology Z_s.smallEtaleTopology := @hc_all Z_s S i_s
  let P_push := (weilEtaleSitePullback i_s).sheafPushforwardContinuous
    (ModuleCat.{u, u} R) S.smallEtaleTopology Z_s.smallEtaleTopology
  let 𝒬_s := P_push.obj (weilEtaleModuleUnit Z_s M)
  let one_S := weilEtaleModuleUnit S M
  let D_dual : Type u := CategoryTheory.Abelian.Ext.{u} 𝒬_s one_S (q₀ + 1)
  obtain ⟨hloc_comp, π, hπ_nat, hSlice_SE⟩ :=
    weil_clean_slice_freeYoneda_short_exact_and_naturality S Z_s i_s M hc_is
  have hSE_ex : ∀ j : 𝒥,
      ∃ h0 : weilEtaleLocalFreeMap S M (v_open j) ≫ π (W_st j) = 0,
        (CategoryTheory.ShortComplex.mk
          (weilEtaleLocalFreeMap S M (v_open j)) (π (W_st j)) h0).ShortExact :=
    fun j => hSlice_SE (W_st j) (W_op j) (v_open j) (hv_imm j) (hv_range j) (hfib_iso j)
  let h0_j : ∀ j : 𝒥, weilEtaleLocalFreeMap S M (v_open j) ≫ π (W_st j) = 0 :=
    fun j => Classical.choose (hSE_ex j)
  let SC_j : ∀ j : 𝒥,
      CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)) :=
    fun j => CategoryTheory.ShortComplex.mk
      (weilEtaleLocalFreeMap S M (v_open j)) (π (W_st j)) (h0_j j)
  have hSE_j : ∀ j : 𝒥, (SC_j j).ShortExact :=
    fun j => Classical.choose_spec (hSE_ex j)
  obtain ⟨ψ_slice, hψ_bij, hψ_nat⟩ :=
    weil_slice_freeYoneda_torsion_ext_iso_any_mod S M
  let E_slice : ∀ W : S.Etale,
      CategoryTheory.Abelian.Ext.{u} (weilEtaleLocalFreeSheaf S M W) one_S q₀ ≃+
        weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left M q₀ :=
    fun W => AddEquiv.ofBijective (ψ_slice W q₀) (hψ_bij W q₀)
  have h1q : 1 + q₀ = q₀ + 1 := Nat.add_comm 1 q₀
  let δ_j : ∀ j : 𝒥,
      weilEtaleTorsionH
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj (W_op j)).left M q₀ →+
        D_dual :=
    fun j =>
      { toFun := fun x => (hSE_j j).extClass.comp ((E_slice (W_op j)).symm x) h1q
        map_zero' := by
          rw [map_zero, CategoryTheory.Abelian.Ext.comp_zero]
        map_add' := fun x₁ x₂ => by
          rw [map_add, CategoryTheory.Abelian.Ext.comp_add] }
  obtain ⟨e_VD⟩ :=
    weil_smooth_proper_verdier_sheaf_ext_dual_equiv k d ℓ r hℓ Z_bar hInt_Z 𝒬_s (q₀ + 1) hq₀
  obtain ⟨e_cl⟩ :=
    weil_closed_immersion_pushforward_torsion_ext_iso S Z_s i_s M hc_is (2 * d - (q₀ + 1))
  let A_s := weilEtaleTorsionH Z_s M (2 * d - (q₀ + 1))
  haveI : Finite A_s := hFin_Zs
  let e_hom : (CategoryTheory.Abelian.Ext.{u} one_S 𝒬_s (2 * d - (q₀ + 1)) →+ ZMod M) ≃+
      (A_s →+ ZMod M) :=
    { toFun := fun φ => φ.comp e_cl.symm.toAddMonoidHom
      invFun := fun ψ => ψ.comp e_cl.toAddMonoidHom
      left_inv := fun φ => by
        ext z
        exact congrArg φ (e_cl.symm_apply_apply z)
      right_inv := fun ψ => by
        ext a
        exact congrArg ψ (e_cl.apply_symm_apply a)
      map_add' := fun φ₁ φ₂ => by
        ext a
        rfl }
  let e_tot : D_dual ≃+ (A_s →+ ZMod M) := e_VD.trans e_hom
  have hFin_all : ∀ (G : Type u) [AddCommGroup G] [Finite G], Finite (G →+ ZMod M) := by
    intro G _ _
    exact Finite.of_injective DFunLike.coe DFunLike.coe_injective
  have hCard_hom_le : ∀ (n : ℕ) (G : Type u) [AddCommGroup G] [Finite G],
      Nat.card G = n → Nat.card (G →+ ZMod M) ≤ n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro G _ _ hcard
      haveI : Finite (G →+ ZMod M) := hFin_all G
      have hpos : 0 < n := hcard ▸ Nat.card_pos
      rcases le_or_gt n 1 with hn1 | hn_gt1
      · have hG1 : Nat.card G ≤ 1 := by omega
        haveI : Subsingleton G := Finite.card_le_one_iff_subsingleton.mp hG1
        haveI : Subsingleton (G →+ ZMod M) := ⟨fun f₁ f₂ => by
          ext x
          rw [Subsingleton.elim x 0, map_zero, map_zero]⟩
        have hle1 : Nat.card (G →+ ZMod M) ≤ 1 :=
          Finite.card_le_one_iff_subsingleton.mpr inferInstance
        omega
      · have hG_gt1 : 1 < Nat.card G := by omega
        haveI : Nontrivial G := Finite.one_lt_card_iff_nontrivial.mp hG_gt1
        obtain ⟨a, ha⟩ := exists_ne (0 : G)
        let H : AddSubgroup G := AddSubgroup.zmultiples a
        let Q := G ⧸ H
        haveI : Finite ↥H := Subtype.finite
        haveI : Finite Q := Finite.of_surjective (QuotientAddGroup.mk' H)
          (QuotientAddGroup.mk'_surjective H)
        set d_H := Nat.card ↥H
        set q_Q := Nat.card Q
        have hmul_G : n = q_Q * d_H := by
          rw [← hcard]
          exact AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup H
        let g₀ : ↥H := ⟨a, AddSubgroup.mem_zmultiples a⟩
        have hg₀_ne : g₀ ≠ 0 := by
          intro h0
          exact ha (congrArg Subtype.val h0)
        haveI : Nontrivial ↥H := ⟨⟨g₀, 0, hg₀_ne⟩⟩
        have hd_gt1 : 1 < d_H := Finite.one_lt_card
        have hq_pos : 0 < q_Q := Nat.card_pos
        have hq_lt_n : q_Q < n := by
          have h2 : q_Q * 2 ≤ q_Q * d_H := Nat.mul_le_mul_left q_Q hd_gt1
          omega
        have hIH_Q : Nat.card (Q →+ ZMod M) ≤ q_Q := ih q_Q hq_lt_n Q rfl
        let res : (G →+ ZMod M) →+ (↥H →+ ZMod M) :=
          { toFun := fun f => f.comp H.subtype
            map_zero' := by ext; rfl
            map_add' := fun _ _ => by ext; rfl }
        let K := res.ker
        haveI : Finite ↥K := Subtype.finite
        haveI : Finite (↥H →+ ZMod M) := hFin_all ↥H
        have hmul_Hom : Nat.card (G →+ ZMod M) =
            Nat.card ((G →+ ZMod M) ⧸ K) * Nat.card ↥K :=
          AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup K
        have hquot_eq : Nat.card ((G →+ ZMod M) ⧸ K) = Nat.card ↥res.range :=
          Nat.card_congr (QuotientAddGroup.quotientKerEquivRange res).toEquiv
        have hrng_le : Nat.card ↥res.range ≤ Nat.card (↥H →+ ZMod M) :=
          Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
        let liftK : ↥K → (Q →+ ZMod M) := fun f =>
          QuotientAddGroup.lift H f.1 (fun x hx => by
            have hker : res f.1 = 0 := f.2
            exact congrArg (fun φ : ↥H →+ ZMod M => φ ⟨x, hx⟩) hker)
        have hliftK_inj : Function.Injective liftK := by
          intro f₁ f₂ heq
          apply Subtype.ext
          ext x
          exact congrArg (fun ψ : Q →+ ZMod M => ψ (QuotientAddGroup.mk x)) heq
        haveI : Finite (Q →+ ZMod M) := hFin_all Q
        have hK_le : Nat.card ↥K ≤ q_Q :=
          (Nat.card_le_card_of_injective liftK hliftK_inj).trans hIH_Q
        have hd_g₀ : d_H • g₀ = 0 :=
          addOrderOf_dvd_iff_nsmul_eq_zero.mp (addOrderOf_dvd_natCard g₀)
        let T := { z : ZMod M // d_H • z = 0 }
        haveI : Finite T := Subtype.finite
        let evH : (↥H →+ ZMod M) → T := fun ψ =>
          ⟨ψ g₀, by rw [← map_nsmul, hd_g₀, map_zero]⟩
        have hevH_inj : Function.Injective evH := by
          intro ψ₁ ψ₂ heq
          have hval : ψ₁ g₀ = ψ₂ g₀ := congrArg Subtype.val heq
          ext y
          obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp y.2
          have hy_eq : y = k • g₀ := Subtype.ext hk.symm
          rw [hy_eq, map_zsmul, map_zsmul, hval]
        have hH_le_T : Nat.card (↥H →+ ZMod M) ≤ Nat.card T :=
          Nat.card_le_card_of_injective evH hevH_inj
        let g := Nat.gcd M d_H
        have hg_pos : 0 < g := Nat.gcd_pos_of_pos_left d_H hM_pos
        have hg_le : g ≤ d_H := Nat.gcd_le_right M (by omega)
        let q_M := M / g
        have hqM_mul : q_M * g = M := Nat.div_mul_cancel (Nat.gcd_dvd_left M d_H)
        have hcop : Nat.Coprime q_M (d_H / g) := Nat.coprime_div_gcd_div_gcd hg_pos
        have hT_div : ∀ z : T, q_M ∣ z.1.val ∧ z.1.val / q_M < g := by
          intro ⟨z, hz⟩
          have hcast : ((d_H * z.val : ℕ) : ZMod M) = 0 := by
            rw [Nat.cast_mul, ZMod.natCast_zmod_val, ← nsmul_eq_mul]
            exact hz
          have hdvd_M : M ∣ d_H * z.val := (ZMod.natCast_eq_zero_iff (d_H * z.val) M).mp hcast
          have hd_mul : (d_H / g) * g = d_H := Nat.div_mul_cancel (Nat.gcd_dvd_right M d_H)
          have hdvd_g : q_M * g ∣ ((d_H / g) * z.val) * g := by
            rw [hqM_mul, mul_right_comm, hd_mul]
            exact hdvd_M
          have hdvd_qM : q_M ∣ (d_H / g) * z.val :=
            (Nat.mul_dvd_mul_iff_right hg_pos).mp hdvd_g
          have hz_dvd : q_M ∣ z.val := hcop.dvd_of_dvd_mul_left hdvd_qM
          refine ⟨hz_dvd, ?_⟩
          have hz_lt : q_M * (z.val / q_M) < q_M * g := by
            rw [Nat.mul_div_cancel' hz_dvd, hqM_mul]
            exact ZMod.val_lt z
          have hqM_pos : 0 < q_M := by
            by_contra h0
            simp only [not_lt, Nat.le_zero] at h0
            rw [h0, zero_mul] at hqM_mul
            omega
          exact (Nat.mul_lt_mul_left hqM_pos).mp hz_lt
        let toFin : T → Fin g := fun z => ⟨z.1.val / q_M, (hT_div z).2⟩
        have htoFin_inj : Function.Injective toFin := by
          intro z₁ z₂ heq
          apply Subtype.ext
          apply ZMod.val_injective
          have hdiv_eq : z₁.1.val / q_M = z₂.1.val / q_M := congrArg Fin.val heq
          rw [← Nat.mul_div_cancel' (hT_div z₁).1, ← Nat.mul_div_cancel' (hT_div z₂).1, hdiv_eq]
        have hT_le : Nat.card T ≤ d_H := by
          calc
            Nat.card T ≤ Nat.card (Fin g) := Nat.card_le_card_of_injective toFin htoFin_inj
            _ = g := Nat.card_fin g
            _ ≤ d_H := hg_le
        have hRng_le_d : Nat.card ((G →+ ZMod M) ⧸ K) ≤ d_H := by
          rw [hquot_eq]
          exact hrng_le.trans (hH_le_T.trans hT_le)
        calc
          Nat.card (G →+ ZMod M) = Nat.card ((G →+ ZMod M) ⧸ K) * Nat.card ↥K := hmul_Hom
          _ ≤ d_H * q_Q := Nat.mul_le_mul hRng_le_d hK_le
          _ = q_Q * d_H := Nat.mul_comm d_H q_Q
          _ = n := hmul_G.symm
  haveI : Finite (A_s →+ ZMod M) := hFin_all A_s
  have hFin_D : Finite D_dual := Finite.of_equiv (A_s →+ ZMod M) e_tot.symm.toEquiv
  have hCard_D : Nat.card D_dual ≤ Nat.card A_s :=
    (Nat.card_congr e_tot.toEquiv).trans_le (hCard_hom_le (Nat.card A_s) A_s rfl)
  refine ⟨D_dual, inferInstance, hFin_D, δ_j, hCard_D, ?_, ?_⟩
  · intro j₁ j₂ θ p_θ hp_θ
    ext x
    let F_θ : SC_j j₂ ⟶ SC_j j₁ :=
      { τ₁ := weilEtaleLocalFreeMap S M (m_op θ)
        τ₂ := weilEtaleLocalFreeMap S M (m_st θ)
        τ₃ := 𝟙 𝒬_s
        comm₁₂ := by
          change weilEtaleLocalFreeMap S M (m_op θ) ≫ weilEtaleLocalFreeMap S M (v_open j₁) =
            weilEtaleLocalFreeMap S M (v_open j₂) ≫ weilEtaleLocalFreeMap S M (m_st θ)
          rw [← hloc_comp, hv_comm θ, hloc_comp]
        comm₂₃ := by
          change weilEtaleLocalFreeMap S M (m_st θ) ≫ π (W_st j₁) = π (W_st j₂) ≫ 𝟙 𝒬_s
          rw [CategoryTheory.Category.comp_id, hπ_nat (m_st θ)] }
    have h_ext_nat :
        (hSE_j j₂).extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S M (m_op θ)))
          (Nat.add_zero 1) =
        (hSE_j j₁).extClass := by
      have hraw : (hSE_j j₂).extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S M (m_op θ)))
          (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 𝒬_s)).comp (hSE_j j₁).extClass
            (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality
          (hSE_j j₂) (hSE_j j₁) F_θ
      rwa [CategoryTheory.Abelian.Ext.mk₀_id_comp] at hraw
    let ξ₁ := (E_slice (W_op j₁)).symm x
    have hp_symm :
        (E_slice (W_op j₂)).symm (p_θ x) =
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S M (m_op θ))).comp
            ξ₁ (Nat.zero_add q₀) := by
      apply (E_slice (W_op j₂)).injective
      rw [(E_slice (W_op j₂)).apply_symm_apply]
      change p_θ x = ψ_slice (W_op j₂) q₀ _
      rw [hψ_nat (m_op θ) q₀ p_θ hp_θ ξ₁]
      exact congrArg p_θ ((E_slice (W_op j₁)).apply_symm_apply x).symm
    change (hSE_j j₂).extClass.comp ((E_slice (W_op j₂)).symm (p_θ x)) h1q =
      (hSE_j j₁).extClass.comp ξ₁ h1q
    rw [hp_symm,
      ← CategoryTheory.Abelian.Ext.comp_assoc (hSE_j j₂).extClass
        (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S M (m_op θ))) ξ₁
        (Nat.add_zero 1) (Nat.zero_add q₀) (by omega),
      h_ext_nat]
  · intro j p_v hp_v
    ext x
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    let ξ₁ := (E_slice (W_op j)).symm x
    constructor
    · intro hx0
      have hx0' : (hSE_j j).extClass.comp ξ₁ h1q = 0 := hx0
      obtain ⟨ξ₂, hξ₂⟩ :=
        CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁
          (hSE_j j) one_S ξ₁ h1q hx0'
      refine ⟨ψ_slice (W_st j) q₀ ξ₂, ?_⟩
      rw [← hψ_nat (v_open j) q₀ p_v hp_v ξ₂]
      have hξ₂' :
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S M (v_open j))).comp
            ξ₂ (Nat.zero_add q₀) = ξ₁ := hξ₂
      rw [hξ₂']
      exact (E_slice (W_op j)).apply_symm_apply x
    · rintro ⟨y, rfl⟩
      let ξ₂ := (E_slice (W_st j)).symm y
      have hξ₁_eq :
          (E_slice (W_op j)).symm (p_v y) =
            (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S M (v_open j))).comp
              ξ₂ (Nat.zero_add q₀) := by
        apply (E_slice (W_op j)).injective
        rw [(E_slice (W_op j)).apply_symm_apply]
        change p_v y = ψ_slice (W_op j) q₀ _
        rw [hψ_nat (v_open j) q₀ p_v hp_v ξ₂]
        exact congrArg p_v ((E_slice (W_st j)).apply_symm_apply y).symm
      change (hSE_j j).extClass.comp ((E_slice (W_op j)).symm (p_v y)) h1q = 0
      rw [hξ₁_eq]
      exact CategoryTheory.ShortComplex.ShortExact.extClass_comp_assoc (hSE_j j) ξ₂

theorem weil_mid_dev_open_sp_trait_stalk_and_verdier_card (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (Z_bar D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt_Z : AlgebraicGeometry.IsIntegral Z_bar.left)
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_bar.hom]
    (hInt_D : AlgebraicGeometry.IsIntegral D_bar.left)
    [AlgebraicGeometry.IsProper D_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 D_bar.hom]
    (e_P : D_bar ≅ weilProjectiveSpaceOver k 1)
    (f_bar : Z_bar ⟶ D_bar)
    [AlgebraicGeometry.IsProper f_bar.left]
    (U_bar : D_bar.left.Opens)
    (hU_ne : Nonempty ↥U_bar.toScheme)
    (hCompl_fin : Set.Finite (U_bar : Set D_bar.left)ᶜ)
    (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left)
    (hs_sec : s_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_not_U : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), s_bar.base pt ∉ U_bar)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar)
    (t_bar : R_bar)
    (π_cl : R_bar →+* k)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial k)))
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D_col : ℐ ⥤ CommRingCat.{u})
    (α_col : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D_col)
    (c_col : CategoryTheory.Limits.Cocone D_col) (hc_col : CategoryTheory.Limits.IsColimit c_col)
    (e_pt : c_col.pt ≅ CommRingCat.of R_bar)
    (hRbar_props : p_R Polynomial.X = t_bar ∧
      π_cl.comp p_R = Polynomial.evalRingHom 0 ∧
      φ_R_Ω.comp p_R = algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))) ∧
      Function.Injective φ_R_Ω ∧
      @IsLocalization.Away R_bar _ t_bar (AlgebraicClosure (FractionRing (Polynomial k))) _
        φ_R_Ω.toAlgebra)
    (hCocone : ∀ i : ℐ,
      (α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
      Function.Injective ((c_col.ι.app i) ≫ e_pt.hom).hom)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D_col.obj i)) (u : (↑(D_col.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial k →+* ↑(D_col.obj i)),
        1 ≤ e ∧
        ((c_col.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α_col.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α_col.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D_col.obj i₁))
          (ψ₁ : Polynomial k →+* ↑(D_col.obj i₁)),
          (D_col.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α_col.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale)
    (hLift_Rbar : ∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S) [AlgebraicGeometry.Etale w₀]
        (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
        (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀),
      s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
      ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
        g_tilde ≫ w₀ = g_S ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde) :
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    ∃ (R_s : Type u) (_ : CommRing R_s) (_ : IsDomain R_s) (_ : IsLocalRing R_s)
      (_ : HenselianLocalRing R_s) (_ : IsDiscreteValuationRing R_s)
      (K_s : Type u) (_ : Field K_s)
      (ι_RK : R_s →+* K_s)
      (ι_Rbar : R_s →+* R_bar)
      (ι_KΩ : K_s →+* Ω)
      (t_s : R_s)
      (g_Rs : AlgebraicGeometry.Spec (CommRingCat.of R_s) ⟶ D_bar.left)
      (Cod_sp : ℕ → Type u) (_ : ∀ r, AddCommGroup (Cod_sp r))
      (sp_S : ∀ r : ℕ,
        weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left g_Rs) (ℓ ^ (r + 1)) (2 * m + 1) →+
          Cod_sp r),
      (ι_Rbar t_s = t_bar ∧
        t_s ≠ 0 ∧
        t_s ∈ IsLocalRing.maximalIdeal R_s ∧
        @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra ∧
