              rw [← hg_fac]; simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map β ≫ AlgebraicGeometry.Spec.map γ) ≫
              AlgebraicGeometry.Spec.map α := by
              rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage,
