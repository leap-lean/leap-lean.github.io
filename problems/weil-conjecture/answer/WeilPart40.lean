          have hb := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl1) b
          change l.hom (ι_B'_BV b) = coc.inl.hom b at hb
          have hr := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl2) (mk_u (MvPolynomial.C r))
          change l.hom (φ_qu (mk_u (MvPolynomial.C r))) = coc.inr.hom (mk_u (MvPolynomial.C r)) at hr
          rw [hφ_qu_C] at hr
          have htmul : TensorProduct.tmul R'_0 b r = ι_B'_BV b * c_RV r := by
            change b ⊗ₜ[R'_0] r = (b ⊗ₜ[R'_0] (1 : R_bar)) * ((1 : B') ⊗ₜ[R'_0] r)
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [htmul, map_mul, map_mul, hb, hr, hdesc_B', hdesc_Rbar]
        | add x y ihx ihy => rw [map_add, map_add, ihx, ihy])⟩ }
  have hφ_qu_et : φ_qu.Etale := hPushoutEtaleInr _ _ _ _ hPush_φqu hφ_q_et

  have hex_σV : ∃ σ_V : B_V →+* k, σ_V.comp c_RV = π_cl ∧ σ_V.comp ι_B'_BV = τ₀ := by
    letI : Algebra R'_0 k := τ_R'.toAlgebra
    let f₁ : B' →ₐ[R'_0] k := { τ₀ with commutes' := fun _ => rfl }
    let f₂ : R_bar →ₐ[R'_0] k := { π_cl with commutes' := fun r => RingHom.congr_fun hπ_φR' r }
    refine ⟨(Algebra.TensorProduct.productMap f₁ f₂).toRingHom, ?_, ?_⟩
    · apply RingHom.ext; intro r
      change (Algebra.TensorProduct.productMap f₁ f₂) ((1 : B') ⊗ₜ[R'_0] r) = π_cl r
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]; rfl
    · apply RingHom.ext; intro b
      change (Algebra.TensorProduct.productMap f₁ f₂) (b ⊗ₜ[R'_0] (1 : R_bar)) = τ₀ b
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]; rfl
  obtain ⟨σ_V, hσ_V_cRV, hσ_V_B'⟩ := hex_σV
  have hσ_V_X : ∀ idx : Fin (m + 1) × Fin 2, σ_V (φ_qu (mk_u (MvPolynomial.X idx))) = 0 := by
    intro idx
    rw [hφ_qu_X, ← RingHom.comp_apply, hσ_V_B']
    exact hτ₀_X idx
  have hσ_V_eZR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_V) ≫ e_ZR = x_Rbar := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · apply CategoryTheory.Limits.pullback.hom_ext
      · calc ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_V) ≫ e_ZR) ≫
              CategoryTheory.Limits.pullback.fst f_bar g_Rbar) ≫ pr_Z
            = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_V) ≫
                (e_ZR ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rbar)) ≫ pr_Z := by
                rw [CategoryTheory.Category.assoc _ e_ZR]
          _ = f_ext ≫ x_s := by
                rw [he_ZR_fst, CategoryTheory.Category.assoc, he_Zbar_fst,
                  ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                  ← CommRingCat.ofHom_comp, hσ_V_B', hτ₀_eY']
          _ = (x_s_fib ≫ CategoryTheory.Limits.pullback.fst f_bar s_bar) ≫ pr_Z := by
                rw [CategoryTheory.Limits.pullback.lift_fst, hx_bar_fst]
          _ = (x_Rbar ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rbar) ≫ pr_Z := by
                dsimp only [x_Rbar]
                rw [CategoryTheory.Category.assoc x_s_fib i_Z_Rbar, hiRbar_fst]
      · calc ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_V) ≫ e_ZR) ≫
              CategoryTheory.Limits.pullback.fst f_bar g_Rbar) ≫ Z_bar_ov.hom
            = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_V) ≫
                (e_ZR ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rbar)) ≫ Z_bar_ov.hom := by
                rw [CategoryTheory.Category.assoc _ e_ZR]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_Rbar) ≫ D_bar_ov.hom := by
                rw [he_ZR_fst, CategoryTheory.Category.assoc, he_Zbar_snd,
                  ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
                  ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hσ_V_cRV]
          _ = 𝟙 _ := by rw [hπ_gRbar, hs_bar_snd]
          _ = (x_Rbar ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rbar) ≫ Z_bar_ov.hom := by
                rw [CategoryTheory.Category.assoc, hxRbar_hom]
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_V) ≫
          (e_ZR ≫ CategoryTheory.Limits.pullback.snd f_bar g_Rbar) =
        x_Rbar ≫ CategoryTheory.Limits.pullback.snd f_bar g_Rbar
      rw [he_ZR_snd, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hσ_V_cRV]
      dsimp only [x_Rbar, x_s_fib]
      rw [CategoryTheory.Category.assoc, hiRbar_snd,
        CategoryTheory.Limits.pullback.lift_snd_assoc, CategoryTheory.Category.id_comp]

  
  
  
  let gen_t : MvPolynomial (Fin (m + 1) × Fin 2) R_bar :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C t_bar
  let I_t : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R_bar) := Ideal.span {gen_t}
  let Q_t := MvPolynomial (Fin (m + 1) × Fin 2) R_bar ⧸ I_t
  let mk_t : MvPolynomial (Fin (m + 1) × Fin 2) R_bar →+* Q_t := Ideal.Quotient.mk I_t
  let u_val : R_bar := ↑u_bar
  let u_inv_val : R_bar := ↑(u_bar⁻¹)
  have hu_inv_mul : u_inv_val * u_val = 1 := Units.inv_mul u_bar
  have hu_mul_inv : u_val * u_inv_val = 1 := Units.mul_inv u_bar
  let S_inv : MvPolynomial (Fin (m + 1) × Fin 2) R_bar →+*
      MvPolynomial (Fin (m + 1) × Fin 2) R_bar :=
    MvPolynomial.eval₂Hom MvPolynomial.C fun idx =>
      if idx.2 = 0 then MvPolynomial.C u_inv_val * MvPolynomial.X idx else MvPolynomial.X idx
  let S_fwd : MvPolynomial (Fin (m + 1) × Fin 2) R_bar →+*
      MvPolynomial (Fin (m + 1) × Fin 2) R_bar :=
    MvPolynomial.eval₂Hom MvPolynomial.C fun idx =>
      if idx.2 = 0 then MvPolynomial.C u_val * MvPolynomial.X idx else MvPolynomial.X idx
  have hS_inv_gen : S_inv gen_t = MvPolynomial.C u_inv_val * gen_u := by
    have h0 : ∀ j : Fin (m + 1), (j, (0 : Fin 2)).2 = 0 := fun _ => rfl
    have h1 : ∀ j : Fin (m + 1), (j, (1 : Fin 2)).2 ≠ 0 :=
      fun _ => show (1 : Fin 2) ≠ 0 by decide
    dsimp only [gen_t, gen_u, S_inv]
    rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C]
    have hsum : (∑ x : Fin (m + 1),
        (MvPolynomial.eval₂Hom MvPolynomial.C fun idx : Fin (m + 1) × Fin 2 =>
          if idx.2 = 0 then MvPolynomial.C u_inv_val * MvPolynomial.X idx
          else MvPolynomial.X idx) (MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1))) =
        MvPolynomial.C u_inv_val *
          ∑ x : Fin (m + 1), MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp [map_mul, h0 j, h1 j, mul_assoc]
    have hC_t : (MvPolynomial.C t_bar : MvPolynomial (Fin (m + 1) × Fin 2) R_bar) =
        MvPolynomial.C u_inv_val * MvPolynomial.C (↑u_bar * t_bar) := by
      rw [← MvPolynomial.C_mul]
      change MvPolynomial.C t_bar = MvPolynomial.C (u_inv_val * (u_val * t_bar))
      rw [← mul_assoc, hu_inv_mul, one_mul]
    rw [hsum, hC_t, mul_sub]
  have hS_fwd_gen : S_fwd gen_u = MvPolynomial.C u_val * gen_t := by
    have h0 : ∀ j : Fin (m + 1), (j, (0 : Fin 2)).2 = 0 := fun _ => rfl
    have h1 : ∀ j : Fin (m + 1), (j, (1 : Fin 2)).2 ≠ 0 :=
      fun _ => show (1 : Fin 2) ≠ 0 by decide
    dsimp only [gen_t, gen_u, S_fwd]
    rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C]
    have hsum : (∑ x : Fin (m + 1),
        (MvPolynomial.eval₂Hom MvPolynomial.C fun idx : Fin (m + 1) × Fin 2 =>
          if idx.2 = 0 then MvPolynomial.C u_val * MvPolynomial.X idx
          else MvPolynomial.X idx) (MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1))) =
        MvPolynomial.C u_val *
          ∑ x : Fin (m + 1), MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp [map_mul, h0 j, h1 j, mul_assoc]
    have hC_u : (MvPolynomial.C (↑u_bar * t_bar) : MvPolynomial (Fin (m + 1) × Fin 2) R_bar) =
        MvPolynomial.C u_val * MvPolynomial.C t_bar := by
      rw [← MvPolynomial.C_mul]
    rw [hsum, hC_u, mul_sub]
  let f_Qt_Qu : Q_t →+* Q_u :=
    Ideal.Quotient.lift I_t (mk_u.comp S_inv)
      (hSpanZero _ gen_t (by
        rw [RingHom.comp_apply, hS_inv_gen, Ideal.Quotient.eq_zero_iff_mem]
        exact I_u.mul_mem_left _ (Ideal.subset_span (Set.mem_singleton _))))
  let f_Qu_Qt : Q_u →+* Q_t :=
    Ideal.Quotient.lift I_u (mk_t.comp S_fwd)
      (hSpanZero _ gen_u (by
        rw [RingHom.comp_apply, hS_fwd_gen, Ideal.Quotient.eq_zero_iff_mem]
        exact I_t.mul_mem_left _ (Ideal.subset_span (Set.mem_singleton _))))
  have hS_fwd_inv : S_fwd.comp S_inv = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext; intro r; simp [S_fwd, S_inv]
    · intro idx
      by_cases h : idx.2 = 0
      · simp [S_fwd, S_inv, h, ← mul_assoc, ← MvPolynomial.C_mul, hu_inv_mul, hu_mul_inv]
      · simp [S_fwd, S_inv, h]
  have hS_inv_fwd : S_inv.comp S_fwd = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext; intro r; simp [S_fwd, S_inv]
    · intro idx
      by_cases h : idx.2 = 0
      · simp [S_fwd, S_inv, h, ← mul_assoc, ← MvPolynomial.C_mul, hu_inv_mul, hu_mul_inv]
      · simp [S_fwd, S_inv, h]
  have hf_Qt_bij : Function.Bijective f_Qt_Qu := by
    refine ⟨fun x y hxy => ?_, fun y => ⟨f_Qu_Qt y, ?_⟩⟩
    · obtain ⟨px, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨py, rfl⟩ := Ideal.Quotient.mk_surjective y
      have h1 := congrArg f_Qu_Qt hxy
      change mk_t ((S_fwd.comp S_inv) px) = mk_t ((S_fwd.comp S_inv) py) at h1
      rwa [hS_fwd_inv, RingHom.id_apply, RingHom.id_apply] at h1
    · obtain ⟨py, rfl⟩ := Ideal.Quotient.mk_surjective y
      change mk_u ((S_inv.comp S_fwd) py) = mk_u py
      rw [hS_inv_fwd, RingHom.id_apply]
  have hf_Qt_et : f_Qt_Qu.Etale := RingHom.Etale.of_bijective hf_Qt_bij

  let gen_P : MvPolynomial (Fin (m + 1) × Fin 2) P :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
      MvPolynomial.C Polynomial.X
  let I_P : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) P) := Ideal.span {gen_P}
  let Q_P := MvPolynomial (Fin (m + 1) × Fin 2) P ⧸ I_P
  let mk_P : MvPolynomial (Fin (m + 1) × Fin 2) P →+* Q_P := Ideal.Quotient.mk I_P
  let ι_QP_Qt : Q_P →+* Q_t :=
    Ideal.Quotient.lift I_P (mk_t.comp (MvPolynomial.map p_R))
      (hSpanZero _ gen_P (by
        rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
        have hmap_P : MvPolynomial.map p_R gen_P = gen_t := by
          simp [gen_P, gen_t, map_sub, map_sum, map_mul, ht_eq]
        rw [hmap_P]
        exact Ideal.subset_span (Set.mem_singleton _)))
  have hι_QP_C : ∀ pol : P,
      ι_QP_Qt (mk_P (MvPolynomial.C pol)) = mk_t (MvPolynomial.C (p_R pol)) := by
    intro pol
    change mk_t (MvPolynomial.map p_R (MvPolynomial.C pol)) = _
    rw [MvPolynomial.map_C]
  have hι_QP_X : ∀ idx : Fin (m + 1) × Fin 2,
      ι_QP_Qt (mk_P (MvPolynomial.X idx)) = mk_t (MvPolynomial.X idx) := by
    intro idx
    change mk_t (MvPolynomial.map p_R (MvPolynomial.X idx)) = _
    rw [MvPolynomial.map_X]
  have hPush_Qt : CategoryTheory.IsPushout
      (CommRingCat.ofHom (R := P) (S := Q_P) (mk_P.comp MvPolynomial.C))
      (CommRingCat.ofHom (R := P) (S := R_bar) p_R)
      (CommRingCat.ofHom (R := Q_P) (S := Q_t) ι_QP_Qt)
      (CommRingCat.ofHom (R := R_bar) (S := Q_t) (mk_t.comp MvPolynomial.C)) := by
    have hcomm_Qt : CommRingCat.ofHom (R := P) (S := Q_P) (mk_P.comp MvPolynomial.C) ≫
        CommRingCat.ofHom (R := Q_P) (S := Q_t) ι_QP_Qt =
        CommRingCat.ofHom (R := P) (S := R_bar) p_R ≫
          CommRingCat.ofHom (R := R_bar) (S := Q_t) (mk_t.comp MvPolynomial.C) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply RingHom.ext
      intro pol
      exact hι_QP_C pol
    let desc_Qt : ∀ coc : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom (R := P) (S := Q_P) (mk_P.comp MvPolynomial.C))
        (CommRingCat.ofHom (R := P) (S := R_bar) p_R),
        Q_t →+* ↑coc.pt := fun coc =>
      Ideal.Quotient.lift I_t
        (MvPolynomial.eval₂Hom coc.inr.hom
          (fun idx => coc.inl.hom (mk_P (MvPolynomial.X idx))))
        (hSpanZero _ gen_t (by
          simp only [gen_t, map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C]
          have hX := RingHom.congr_fun (congrArg CommRingCat.Hom.hom coc.condition) Polynomial.X
          change coc.inl.hom (mk_P (MvPolynomial.C Polynomial.X)) = coc.inr.hom (p_R Polynomial.X) at hX
          rw [← ht_eq, ← hX]
          have hrel_P : coc.inl.hom (mk_P gen_P) = 0 := by
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _)), map_zero]
          dsimp only [gen_P] at hrel_P
          simpa [map_sub, map_sum, map_mul] using hrel_P))
    refine { w := hcomm_Qt, isColimit' := ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk
      hcomm_Qt
      (fun coc => CommRingCat.ofHom (desc_Qt coc))
      (fun coc => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
        change desc_Qt coc (ι_QP_Qt (mk_P p)) = coc.inl.hom (mk_P p)
        induction p using MvPolynomial.induction_on with
        | C pol =>
          have hpol := RingHom.congr_fun (congrArg CommRingCat.Hom.hom coc.condition) pol
          change coc.inl.hom (mk_P (MvPolynomial.C pol)) = coc.inr.hom (p_R pol) at hpol
          rw [hι_QP_C]
          change MvPolynomial.eval₂Hom coc.inr.hom _ (MvPolynomial.C (p_R pol)) = _
          rw [MvPolynomial.eval₂Hom_C]
          exact hpol.symm
        | add p₁ p₂ ih₁ ih₂ =>
          rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
        | mul_X p idx ih =>
          rw [map_mul, map_mul, map_mul, map_mul, ih, hι_QP_X]
          change _ * MvPolynomial.eval₂Hom coc.inr.hom _ (MvPolynomial.X idx) = _
          rw [MvPolynomial.eval₂Hom_X'])
      (fun coc => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        change MvPolynomial.eval₂Hom coc.inr.hom _ (MvPolynomial.C r) = coc.inr.hom r
        rw [MvPolynomial.eval₂Hom_C])
      (fun coc l hl1 hl2 => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
        change l.hom (mk_t p) = desc_Qt coc (mk_t p)
        induction p using MvPolynomial.induction_on with
        | C r =>
          change l.hom (mk_t (MvPolynomial.C r)) =
            MvPolynomial.eval₂Hom coc.inr.hom _ (MvPolynomial.C r)
          rw [MvPolynomial.eval₂Hom_C]
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl2) r
        | add p₁ p₂ ih₁ ih₂ =>
          rw [map_add, map_add, map_add, ih₁, ih₂]
        | mul_X p idx ih =>
          have hX := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl1) (mk_P (MvPolynomial.X idx))
          change l.hom (ι_QP_Qt (mk_P (MvPolynomial.X idx))) =
            coc.inl.hom (mk_P (MvPolynomial.X idx)) at hX
          rw [hι_QP_X] at hX
          rw [map_mul, map_mul, map_mul, ih, hX]
          change _ * coc.inl.hom (mk_P (MvPolynomial.X idx)) =
            _ * MvPolynomial.eval₂Hom coc.inr.hom _ (MvPolynomial.X idx)
          rw [MvPolynomial.eval₂Hom_X'])⟩ }
  let j_aff_QR : AlgebraicGeometry.Spec (CommRingCat.of Q_t) ⟶ Q_R :=
    CategoryTheory.Limits.pullback.lift
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_QP_Qt) ≫ e_aff.inv ≫ U_aff.ι)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (mk_t.comp MvPolynomial.C)))
      (by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hQ_geom.2.2.1,
          e_aff.inv_hom_id_assoc]
        exact (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Qt).w)
  have hj_aff_fst : j_aff_QR ≫ CategoryTheory.Limits.pullback.fst g_Q.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_QP_Qt) ≫ e_aff.inv ≫ U_aff.ι :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hj_aff_snd : j_aff_QR ≫ CategoryTheory.Limits.pullback.snd g_Q.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (mk_t.comp MvPolynomial.C)) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_j_aff_QR : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_QP_Qt)) j_aff_QR
      (e_aff.inv ≫ U_aff.ι)
      (CategoryTheory.Limits.pullback.fst g_Q.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R))) := by
    refine CategoryTheory.IsPullback.of_bot
      (v₂₁ := CategoryTheory.Limits.pullback.snd g_Q.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)))
      (v₂₂ := g_Q.left) ?_
      hj_aff_fst.symm
      (CategoryTheory.IsPullback.of_hasPullback g_Q.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)))
    rw [hj_aff_snd, CategoryTheory.Category.assoc,
      hQ_geom.2.2.1, e_aff.inv_hom_id_assoc]
    exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Qt
  haveI : CategoryTheory.IsIso e_aff.inv := CategoryTheory.Iso.isIso_inv e_aff
  have hOpen_inv_Uaff : AlgebraicGeometry.IsOpenImmersion (e_aff.inv ≫ U_aff.ι) :=
    hOpenComp _ _ (hOpenIso e_aff.inv) inferInstance
  have hOpen_jaff_QR : AlgebraicGeometry.IsOpenImmersion j_aff_QR :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_j_aff_QR hOpen_inv_Uaff
  letI : AlgebraicGeometry.IsOpenImmersion j_aff_QR := hOpen_jaff_QR
  have hEt_φqu_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_qu)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_qu_et
  have hEt_fQtQu_spec : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_Qt_Qu)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf_Qt_et
  let e_QR : AlgebraicGeometry.Spec (CommRingCat.of B_V) ⟶ Q_R :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_qu) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_Qt_Qu) ≫ j_aff_QR
  have hEt_eQR : AlgebraicGeometry.Etale e_QR :=
    hEtComp _ _ hEt_φqu_spec (hEtComp _ _ hEt_fQtQu_spec inferInstance)
  have he_QR_snd : e_QR ≫ CategoryTheory.Limits.pullback.snd g_Q.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
