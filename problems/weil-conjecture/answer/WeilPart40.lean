by
  
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pf_i := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
    X.smallEtaleTopology S_k.smallEtaleTopology hCont_i
  let U_sh := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
    CategoryTheory.Sheaf.composeAndSheafify Z.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))) AddCommGrpCat.{u})
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_k := (CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let e_res : k ≃+* IsLocalRing.ResidueField k :=
    RingEquiv.ofBijective (IsLocalRing.residue k)
      ⟨RingHom.injective (IsLocalRing.residue k), IsLocalRing.residue_surjective⟩
  letI : IsAlgClosed (IsLocalRing.ResidueField k) :=
    @IsAlgClosed.of_ringEquiv k _ (IsLocalRing.ResidueField k) _ e_res _
  have hIsZeroH0 : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      {F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}},
      CategoryTheory.Limits.IsZero F → Subsingleton (F.H 0) := by
    intro Z F hZ
    exact Subsingleton.intro fun a b =>
      CategoryTheory.Abelian.Ext.addEquiv₀.injective (hZ.eq_of_tgt _ _)
  have hSerre : WeilConstructibleModPrimeSerreHolds k ℓ :=
    weil_etale_constructible_mod_prime_serre_and_local k ℓ
  have hBaseH1 : ∀ (E : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      Subsingleton (E.H 1) := by
    intro E
    have hZeroId : CategoryTheory.Limits.IsZero
