      intro x₁ x₂ hx
      obtain ⟨α₁, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective U₀ I₀).2 x₁
      obtain ⟨α₂, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective U₀ I₀).2 x₂
      change (CategoryTheory.Abelian.Ext.mk₀ α₁).comp (CategoryTheory.Abelian.Ext.mk₀ i_v) (Nat.add_zero 0) =
        (CategoryTheory.Abelian.Ext.mk₀ α₂).comp (CategoryTheory.Abelian.Ext.mk₀ i_v) (Nat.add_zero 0) at hx
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hx
      have hα : α₁ ≫ i_v = α₂ ≫ i_v := (CategoryTheory.Abelian.Ext.mk₀_bijective U₀ Q₀).1 hx
      rw [(CategoryTheory.cancel_mono i_v).mp hα]
    have hmem_ker_iv0 : ∀ x : CategoryTheory.Abelian.Ext.{u} U₀ I₀ 0,
        i_v_0 x ∈ AddMonoidHom.ker δ₀_0 := by
      intro x
      rw [AddMonoidHom.mem_ker]
      change (x.comp (CategoryTheory.Abelian.Ext.mk₀ i_v) (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ δ₀) (Nat.add_zero 0) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _
          (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_S2,
        CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    let i_ker : CategoryTheory.Abelian.Ext.{u} U₀ I₀ 0 →+ ↥(AddMonoidHom.ker δ₀_0) :=
