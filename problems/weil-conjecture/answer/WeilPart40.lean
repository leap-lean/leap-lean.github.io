    fun K₀ _ p₁ p₂ => PrimeSpectrum.ext ((hBotPrime K₀ p₁).trans (hBotPrime K₀ p₂).symm)
  let pt_F₀ : AlgebraicGeometry.Spec (CommRingCat.of F) := Classical.arbitrary _
