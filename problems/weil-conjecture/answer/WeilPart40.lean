      refine ⟨fun {W_et} a b _ => ?_⟩
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · have hw_a : CategoryTheory.CategoryStruct.comp a.left V₁.ι = W_et.hom :=
          CategoryTheory.MorphismProperty.Over.w a
        have hw_b : CategoryTheory.CategoryStruct.comp b.left V₁.ι = W_et.hom :=
          CategoryTheory.MorphismProperty.Over.w b
        exact (CategoryTheory.cancel_mono V₁.ι).mp (hw_a.trans hw_b.symm)
      · exact Subsingleton.elim _ _
    have hOpen₀₁ : AlgebraicGeometry.IsOpenImmersion V₀₁.ι := inferInstance
    have hpb_sq : sq₀.IsPullback := by
      let liftCone : ∀ (s : CategoryTheory.Limits.PullbackCone f₂₄ f₃₄),
          Quiver.Hom s.pt.left V₀₁.toScheme := fun s =>
        let s_hom : Quiver.Hom s.pt.left Y₀ := s.pt.hom
        have hw_fst : CategoryTheory.CategoryStruct.comp s.fst.left V₀.ι = s_hom :=
          CategoryTheory.MorphismProperty.Over.w s.fst
        have hw_snd : CategoryTheory.CategoryStruct.comp s.snd.left V₁.ι = s_hom :=
          CategoryTheory.MorphismProperty.Over.w s.snd
        have hrange : Set.range s_hom.base ⊆ Set.range V₀₁.ι.base := by
          rintro _ ⟨w, rfl⟩
          have hx₀ : s_hom.base w ∈ (V₀ : Set ↥Y₀) := by
            rw [← hw_fst]
            exact (s.fst.left.base w).2
          have hx₁ : s_hom.base w ∈ (V₁ : Set ↥Y₀) := by
            rw [← hw_snd]
            exact (s.snd.left.base w).2
          exact ⟨⟨s_hom.base w, ⟨hx₀, hx₁⟩⟩, rfl⟩
        @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ V₀₁.ι s_hom hOpen₀₁ hrange
      have hlift_fac : ∀ (s : CategoryTheory.Limits.PullbackCone f₂₄ f₃₄),
          CategoryTheory.CategoryStruct.comp (liftCone s) V₀₁.ι = s.pt.hom := fun s =>
        @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ V₀₁.ι _ hOpen₀₁ _
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm_sq
          (fun s => CategoryTheory.MorphismProperty.Over.homMk (liftCone s) (hlift_fac s) trivial)
          (fun s => CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((CategoryTheory.cancel_mono V₀.ι).mp
              ((CategoryTheory.Category.assoc (liftCone s) (Y₀.homOfLE inf_le_left) V₀.ι).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (liftCone s))
                    (AlgebraicGeometry.Scheme.homOfLE_ι Y₀ inf_le_left)).trans
                  ((hlift_fac s).trans (CategoryTheory.MorphismProperty.Over.w s.fst).symm))))
            (Subsingleton.elim _ _))
          (fun s => CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((CategoryTheory.cancel_mono V₁.ι).mp
              ((CategoryTheory.Category.assoc (liftCone s) (Y₀.homOfLE inf_le_right) V₁.ι).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (liftCone s))
                    (AlgebraicGeometry.Scheme.homOfLE_ι Y₀ inf_le_right)).trans
                  ((hlift_fac s).trans (CategoryTheory.MorphismProperty.Over.w s.snd).symm))))
            (Subsingleton.elim _ _))
          (fun s m _ _ => CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((CategoryTheory.cancel_mono V₀₁.ι).mp
              ((CategoryTheory.MorphismProperty.Over.w m).trans (hlift_fac s).symm))
            (Subsingleton.elim _ _)))
    have hcov_sq : CategoryTheory.Sieve.ofTwoArrows sq₀.f₂₄ sq₀.f₃₄ ∈
        Y₀.smallEtaleTopology sq₀.X₄ := by
      let E_ov : P_et.Over ⊤ Y₀ := E_of V_sup
      let R_sieve : CategoryTheory.Sieve E_ov := CategoryTheory.Sieve.ofTwoArrows f₂₄ f₃₄
      have h_top_eq :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := Y₀) (le_refl P_et)
      refine Eq.mp (congrArg (fun J => R_sieve ∈ J E_ov) h_top_eq.symm) ?_
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology E_ov R_sieve).mpr ?_
      intro x
      rcases x.2 with hx₀ | hx₁
      · exact ⟨E_of V₀, f₂₄, ⟨x.1, hx₀⟩,
          CategoryTheory.Sieve.ofArrows_mk _ _ CategoryTheory.Limits.WalkingPair.left,
          (inferInstance : AlgebraicGeometry.Etale (Y₀.homOfLE le_sup_left)),
          Subtype.ext (Y₀.homOfLE_apply le_sup_left ⟨x.1, hx₀⟩)⟩
      · exact ⟨E_of V₁, f₃₄, ⟨x.1, hx₁⟩,
          CategoryTheory.Sieve.ofArrows_mk _ _ CategoryTheory.Limits.WalkingPair.right,
          (inferInstance : AlgebraicGeometry.Etale (Y₀.homOfLE le_sup_right)),
          Subtype.ext (Y₀.homOfLE_apply le_sup_right ⟨x.1, hx₁⟩)⟩
    let mv₀ := CategoryTheory.GrothendieckTopology.MayerVietorisSquare.mk_of_isPullback
      sq₀ hpb_sq hcov_sq
    have hmv₀_se : mv₀.shortComplex.ShortExact := mv₀.shortComplex_shortExact
    let Aℤ_Y := AddCommGrpCat.of (ULift.{u} ℤ)
    let equivZ : ∀ (M : AddCommGrpCat.{u}), (Aℤ_Y ⟶ M) ≃ ↑M := fun M =>
      { toFun := fun φ => φ.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun φ => by
          ext ⟨z⟩
          change z • φ.hom (ULift.up (1 : ℤ)) = φ.hom (ULift.up z)
          have hz : (ULift.up z : Aℤ_Y) = z • (ULift.up (1 : ℤ) : Aℤ_Y) :=
            ULift.ext _ _ (mul_one z).symm
          rw [hz, map_zsmul]
        right_inv := fun m => one_zsmul m }
    let P_rep : Y₀.Etale → CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
      fun V => (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
    let P_FY : Y₀.Etale → CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
      fun V => CategoryTheory.Presheaf.freeYoneda V Aℤ_Y
    let eq_rep : ∀ (V : Y₀.Etale)
        (F : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u}),
        (P_rep V ⟶ F) ≃ ↑(F.obj (Opposite.op V)) :=
      fun V F =>
        ((AddCommGrpCat.adj.whiskerRight (Opposite Y₀.Etale)).homEquiv
          (CategoryTheory.yoneda.obj V) F).trans CategoryTheory.yonedaEquiv
    let eq_FY : ∀ (V : Y₀.Etale)
        (F : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u}),
        (P_FY V ⟶ F) ≃ ↑(F.obj (Opposite.op V)) :=
      fun V F => CategoryTheory.Presheaf.freeYonedaHomEquiv.trans (equivZ (F.obj (Opposite.op V)))
    have heq_rep_nat : ∀ (V : Y₀.Etale)
        {F₁ F₂ : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u}}
        (α_m : P_rep V ⟶ F₁) (β_m : F₁ ⟶ F₂),
        eq_rep V F₂ (CategoryTheory.CategoryStruct.comp α_m β_m) =
          (β_m.app (Opposite.op V)).hom (eq_rep V F₁ α_m) := by
      intro V F₁ F₂ α_m β_m
      dsimp [eq_rep]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      rfl
    have heq_FY_nat : ∀ (V : Y₀.Etale)
        {F₁ F₂ : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u}}
        (α_m : P_FY V ⟶ F₁) (β_m : F₁ ⟶ F₂),
        eq_FY V F₂ (CategoryTheory.CategoryStruct.comp α_m β_m) =
          (β_m.app (Opposite.op V)).hom (eq_FY V F₁ α_m) := by
      intro V F₁ F₂ α_m β_m
      dsimp [eq_FY]
      rw [CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
      rfl
    let e_pre : ∀ (V : Y₀.Etale), CategoryTheory.Iso (P_rep V) (P_FY V) := fun V =>
      let h_hom : P_rep V ⟶ P_FY V :=
        (eq_rep V (P_FY V)).symm (eq_FY V (P_FY V) (CategoryTheory.CategoryStruct.id (P_FY V)))
      let h_inv : P_FY V ⟶ P_rep V :=
        (eq_FY V (P_rep V)).symm (eq_rep V (P_rep V) (CategoryTheory.CategoryStruct.id (P_rep V)))
      { hom := h_hom
        inv := h_inv
        hom_inv_id := (eq_rep V (P_rep V)).injective (by
          rw [heq_rep_nat V h_hom h_inv, (eq_rep V (P_FY V)).apply_symm_apply]
          change eq_FY V (P_rep V)
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id (P_FY V)) h_inv) = _
          rw [CategoryTheory.Category.id_comp, (eq_FY V (P_rep V)).apply_symm_apply])
        inv_hom_id := (eq_FY V (P_FY V)).injective (by
          rw [heq_FY_nat V h_inv h_hom, (eq_FY V (P_rep V)).apply_symm_apply]
          change eq_rep V (P_FY V)
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id (P_rep V)) h_hom) = _
          rw [CategoryTheory.Category.id_comp, (eq_rep V (P_FY V)).apply_symm_apply]) }
    let sh := CategoryTheory.presheafToSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}
    let e₁_sh : CategoryTheory.Iso mv₀.shortComplex.X₁ Z_V₀₁ := sh.mapIso (e_pre (E_of V₀₁))
    let e₂_sh : CategoryTheory.Iso mv₀.shortComplex.X₂ (CategoryTheory.Limits.biprod Z_V₀ Z_V₁) :=
      CategoryTheory.Limits.biprod.mapIso (sh.mapIso (e_pre (E_of V₀))) (sh.mapIso (e_pre (E_of V₁)))
    let e₃_sh : CategoryTheory.Iso mv₀.shortComplex.X₃ Z_Vsup := sh.mapIso (e_pre (E_of V_sup))
    let f_mv : Z_V₀₁ ⟶ CategoryTheory.Limits.biprod Z_V₀ Z_V₁ :=
      CategoryTheory.CategoryStruct.comp e₁_sh.inv
        (CategoryTheory.CategoryStruct.comp mv₀.shortComplex.f e₂_sh.hom)
    let g_mv : CategoryTheory.Limits.biprod Z_V₀ Z_V₁ ⟶ Z_Vsup :=
      CategoryTheory.CategoryStruct.comp e₂_sh.inv
        (CategoryTheory.CategoryStruct.comp mv₀.shortComplex.g e₃_sh.hom)
    have hfg_mv : f_mv ≫ g_mv = 0 := by
      dsimp [f_mv, g_mv]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e₂_sh.hom e₂_sh.inv _, e₂_sh.hom_inv_id,
        CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc mv₀.shortComplex.f _ _,
        mv₀.shortComplex.zero, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    let S_mv := CategoryTheory.ShortComplex.mk f_mv g_mv hfg_mv
    let iso_S : CategoryTheory.Iso mv₀.shortComplex S_mv :=
      CategoryTheory.ShortComplex.isoMk e₁_sh e₂_sh e₃_sh
        (by dsimp [S_mv, f_mv]; rw [← CategoryTheory.Category.assoc, e₁_sh.hom_inv_id, CategoryTheory.Category.id_comp])
        (by dsimp [S_mv, g_mv]; rw [← CategoryTheory.Category.assoc, e₂_sh.hom_inv_id, CategoryTheory.Category.id_comp])
    exact ⟨f_mv, g_mv, hfg_mv, (CategoryTheory.ShortComplex.shortExact_iff_of_iso iso_S).mp hmv₀_se⟩
  · let top_op : Y₀.Opens := ⊤
    have hOpen_top : AlgebraicGeometry.IsOpenImmersion top_op.ι := inferInstance
    have hrange : ∀ (W : Y₀.Etale), Set.range W.hom.base ⊆ Set.range top_op.ι.base := by
      rintro W _ ⟨w, rfl⟩
      exact ⟨⟨W.hom.base w, trivial⟩, rfl⟩
    let liftTop : ∀ (W : Y₀.Etale), Quiver.Hom W.left top_op.toScheme :=
      fun W => @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ top_op.ι W.hom hOpen_top (hrange W)
    have hlift_fac : ∀ (W : Y₀.Etale),
        CategoryTheory.CategoryStruct.comp (liftTop W) top_op.ι = W.hom :=
      fun W => @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ top_op.ι W.hom hOpen_top (hrange W)
    exact ⟨CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk (liftTop W) (hlift_fac W) trivial)
      (fun W m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.cancel_mono top_op.ι).mp
          ((CategoryTheory.MorphismProperty.Over.w m).trans (hlift_fac W).symm))
        (Subsingleton.elim _ _))⟩

theorem weil_proetale_abelian_biproduct_ses_contravariant_ext_exact {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
    [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
    {Z₀_obj Z₁_obj M : 𝒞}
    (S : CategoryTheory.ShortComplex 𝒞) (hS : S.ShortExact)
    (inl : Z₀_obj ⟶ S.X₂) (inr : Z₁_obj ⟶ S.X₂)
    (fst : S.X₂ ⟶ Z₀_obj) (snd : S.X₂ ⟶ Z₁_obj)
    (r₀_mor : Z₀_obj ⟶ S.X₃) (_ : r₀_mor = inl ≫ S.g)
    (r₁_mor : Z₁_obj ⟶ S.X₃) (_ : r₁_mor = inr ≫ S.g)
    (d₀_mor : S.X₁ ⟶ Z₀_obj) (_ : d₀_mor = S.f ≫ fst)
    (d₁_mor : S.X₁ ⟶ Z₁_obj) (_ : d₁_mor = S.f ≫ snd)
    (_ : inl ≫ fst = 𝟙 _)
    (_ : inr ≫ snd = 𝟙 _)
    (_ : inl ≫ snd = 0)
    (_ : inr ≫ fst = 0)
    (_ : fst ≫ inl + snd ≫ inr = 𝟙 _) :
    let res₀ : ∀ n : ℕ, CategoryTheory.Abelian.Ext S.X₃ M n →+ CategoryTheory.Abelian.Ext Z₀_obj M n :=
      fun n => (CategoryTheory.Abelian.Ext.mk₀ r₀_mor).precomp M (Nat.zero_add n)
    let res₁ : ∀ n : ℕ, CategoryTheory.Abelian.Ext S.X₃ M n →+ CategoryTheory.Abelian.Ext Z₁_obj M n :=
      fun n => (CategoryTheory.Abelian.Ext.mk₀ r₁_mor).precomp M (Nat.zero_add n)
    let diff : ∀ n : ℕ,
        (CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n) →+
          CategoryTheory.Abelian.Ext S.X₁ M n :=
      fun n =>
        ((CategoryTheory.Abelian.Ext.mk₀ d₀_mor).precomp M (Nat.zero_add n)).comp
          (AddMonoidHom.fst _ _) +
        ((CategoryTheory.Abelian.Ext.mk₀ d₁_mor).precomp M (Nat.zero_add n)).comp
          (AddMonoidHom.snd _ _)
    let δ : ∀ r : ℕ, CategoryTheory.Abelian.Ext S.X₁ M r →+ CategoryTheory.Abelian.Ext S.X₃ M (r + 1) :=
      fun r => hS.extClass.precomp M (Nat.add_comm 1 r)
    ((∀ x : CategoryTheory.Abelian.Ext S.X₃ M 0, res₀ 0 x = 0 → res₁ 0 x = 0 → x = 0) ∧
      (∀ x : CategoryTheory.Abelian.Ext S.X₃ M 0, diff 0 (res₀ 0 x, res₁ 0 x) = 0) ∧
      (∀ p : CategoryTheory.Abelian.Ext Z₀_obj M 0 × CategoryTheory.Abelian.Ext Z₁_obj M 0,
        diff 0 p = 0 → ∃ x : CategoryTheory.Abelian.Ext S.X₃ M 0, (res₀ 0 x, res₁ 0 x) = p)) ∧
    (∀ r : ℕ,
      (∀ p : CategoryTheory.Abelian.Ext Z₀_obj M r × CategoryTheory.Abelian.Ext Z₁_obj M r,
        δ r (diff r p) = 0) ∧
      (∀ c_ext : CategoryTheory.Abelian.Ext S.X₃ M (r + 1),
        res₀ (r + 1) c_ext = 0 → res₁ (r + 1) c_ext = 0 →
        ∃ b : CategoryTheory.Abelian.Ext S.X₁ M r, δ r b = c_ext) ∧
      (∀ c_ext : CategoryTheory.Abelian.Ext S.X₃ M (r + 1),
        diff (r + 1) (res₀ (r + 1) c_ext, res₁ (r + 1) c_ext) = 0) ∧
      (∀ p : CategoryTheory.Abelian.Ext Z₀_obj M (r + 1) × CategoryTheory.Abelian.Ext Z₁_obj M (r + 1),
        diff (r + 1) p = 0 →
        ∃ c_ext : CategoryTheory.Abelian.Ext S.X₃ M (r + 1),
          (res₀ (r + 1) c_ext, res₁ (r + 1) c_ext) = p) ∧
      (∀ b : CategoryTheory.Abelian.Ext S.X₁ M r,
        δ r b = 0 →
        ∃ p : CategoryTheory.Abelian.Ext Z₀_obj M r × CategoryTheory.Abelian.Ext Z₁_obj M r,
          diff r p = b)) :=
by
  have hr₀ : r₀_mor = inl ≫ S.g := ‹_›
  have hr₁ : r₁_mor = inr ≫ S.g := ‹_›
  have hd₀ : d₀_mor = S.f ≫ fst := ‹_›
  have hd₁ : d₁_mor = S.f ≫ snd := ‹_›
  have h_inl_fst : inl ≫ fst = 𝟙 Z₀_obj := ‹_›
  have h_inr_snd : inr ≫ snd = 𝟙 Z₁_obj := ‹_›
  have h_inl_snd : inl ≫ snd = 0 := ‹_›
  have h_inr_fst : inr ≫ fst = 0 := ‹_›
  have h_tot : fst ≫ inl + snd ≫ inr = 𝟙 S.X₂ := ‹_›
  subst hr₀; subst hr₁; subst hd₀; subst hd₁
  intro res₀ res₁ diff δ
  let splitExt : ∀ n : ℕ, CategoryTheory.Abelian.Ext S.X₂ M n →
      CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n :=
    fun n y =>
      ((CategoryTheory.Abelian.Ext.mk₀ inl).comp y (Nat.zero_add n),
       (CategoryTheory.Abelian.Ext.mk₀ inr).comp y (Nat.zero_add n))
  let combineExt : ∀ n : ℕ,
      (CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n) →
        CategoryTheory.Abelian.Ext S.X₂ M n :=
    fun n p =>
      (CategoryTheory.Abelian.Ext.mk₀ fst).comp p.1 (Nat.zero_add n) +
      (CategoryTheory.Abelian.Ext.mk₀ snd).comp p.2 (Nat.zero_add n)
  have h_combine_split : ∀ (n : ℕ) (y : CategoryTheory.Abelian.Ext S.X₂ M n),
      combineExt n (splitExt n y) = y := by
    intro n y
    dsimp only [combineExt, splitExt]
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← CategoryTheory.Abelian.Ext.add_comp,
      ← CategoryTheory.Abelian.Ext.mk₀_add,
      h_tot, CategoryTheory.Abelian.Ext.mk₀_id_comp]
  have h_inl_combine : ∀ (n : ℕ)
      (p : CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n),
      (CategoryTheory.Abelian.Ext.mk₀ inl).comp (combineExt n p) (Nat.zero_add n) = p.1 := by
    intro n p
    dsimp only [combineExt]
    rw [CategoryTheory.Abelian.Ext.comp_add,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      h_inl_fst, h_inl_snd,
      CategoryTheory.Abelian.Ext.mk₀_id_comp,
      CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.zero_comp, add_zero]
  have h_inr_combine : ∀ (n : ℕ)
      (p : CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n),
      (CategoryTheory.Abelian.Ext.mk₀ inr).comp (combineExt n p) (Nat.zero_add n) = p.2 := by
    intro n p
    dsimp only [combineExt]
    rw [CategoryTheory.Abelian.Ext.comp_add,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      h_inr_fst, h_inr_snd,
      CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.zero_comp,
      CategoryTheory.Abelian.Ext.mk₀_id_comp, zero_add]
  have h_diff_fac : ∀ (n : ℕ)
      (p : CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n),
      diff n p = (CategoryTheory.Abelian.Ext.mk₀ S.f).comp (combineExt n p) (Nat.zero_add n) := by
    intro n p
    change (CategoryTheory.Abelian.Ext.mk₀ (S.f ≫ fst)).comp p.1 (Nat.zero_add n) +
        (CategoryTheory.Abelian.Ext.mk₀ (S.f ≫ snd)).comp p.2 (Nat.zero_add n) =
      (CategoryTheory.Abelian.Ext.mk₀ S.f).comp (combineExt n p) (Nat.zero_add n)
    dsimp only [combineExt]
    rw [CategoryTheory.Abelian.Ext.comp_add,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
  have h_res_split : ∀ (n : ℕ) (c : CategoryTheory.Abelian.Ext S.X₃ M n),
      (res₀ n c, res₁ n c) = splitExt n ((CategoryTheory.Abelian.Ext.mk₀ S.g).comp c (Nat.zero_add n)) := by
    intro n c
    apply Prod.ext
    · change (CategoryTheory.Abelian.Ext.mk₀ (inl ≫ S.g)).comp c (Nat.zero_add n) =
        (CategoryTheory.Abelian.Ext.mk₀ inl).comp
          ((CategoryTheory.Abelian.Ext.mk₀ S.g).comp c (Nat.zero_add n)) (Nat.zero_add n)
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
    · change (CategoryTheory.Abelian.Ext.mk₀ (inr ≫ S.g)).comp c (Nat.zero_add n) =
        (CategoryTheory.Abelian.Ext.mk₀ inr).comp
          ((CategoryTheory.Abelian.Ext.mk₀ S.g).comp c (Nat.zero_add n)) (Nat.zero_add n)
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
  have h_res_zero : ∀ (n : ℕ) (c : CategoryTheory.Abelian.Ext S.X₃ M n),
      res₀ n c = 0 → res₁ n c = 0 →
      (CategoryTheory.Abelian.Ext.mk₀ S.g).comp c (Nat.zero_add n) = 0 := by
    intro n c hc₀ hc₁
    have h1 := congrArg (combineExt n) (h_res_split n c)
    rw [h_combine_split] at h1
    rw [← h1, hc₀, hc₁]
    dsimp only [combineExt]
    rw [CategoryTheory.Abelian.Ext.comp_zero, CategoryTheory.Abelian.Ext.comp_zero, add_zero]
  have h_diff_res : ∀ (n : ℕ) (c : CategoryTheory.Abelian.Ext S.X₃ M n),
      diff n (res₀ n c, res₁ n c) = 0 := by
    intro n c
    rw [h_res_split n c, h_diff_fac n, h_combine_split,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      S.zero, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.zero_comp]
  have h_mid_exact : ∀ (n : ℕ)
      (p : CategoryTheory.Abelian.Ext Z₀_obj M n × CategoryTheory.Abelian.Ext Z₁_obj M n),
      diff n p = 0 →
      ∃ c : CategoryTheory.Abelian.Ext S.X₃ M n, (res₀ n c, res₁ n c) = p := by
    intro n p hp
    rw [h_diff_fac n p] at hp
    obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₂ hS M (combineExt n p) hp
    refine ⟨c, ?_⟩
    rw [h_res_split n c, hc]
    exact Prod.ext (h_inl_combine n p) (h_inr_combine n p)
  refine ⟨⟨?_, fun x => h_diff_res 0 x, fun p hp => h_mid_exact 0 p hp⟩, fun r => ⟨?_, ?_, fun c_ext => h_diff_res (r + 1) c_ext, fun p hp => h_mid_exact (r + 1) p hp, ?_⟩⟩
  · intro x hx₀ hx₁
    have hg0 : (CategoryTheory.Abelian.Ext.mk₀ S.g).comp x (Nat.zero_add 0) = 0 :=
      h_res_zero 0 x hx₀ hx₁
    obtain ⟨φ, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective S.X₃ M).2 x
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.mk₀_zero S.X₂ M] at hg0
    have hcomp0 : S.g ≫ φ = 0 := (CategoryTheory.Abelian.Ext.mk₀_bijective S.X₂ M).1 hg0
    have : CategoryTheory.Epi S.g := hS.epi_g
    have hφ0 : φ = 0 := (CategoryTheory.cancel_epi S.g).mp (hcomp0.trans CategoryTheory.Limits.comp_zero.symm)
    rw [hφ0, CategoryTheory.Abelian.Ext.mk₀_zero]
  · intro p
    rw [h_diff_fac r p]
    exact hS.extClass_comp_assoc (combineExt r p) (h := Nat.add_comm 1 r)
  · intro c_ext hc₀ hc₁
    have hg0 : (CategoryTheory.Abelian.Ext.mk₀ S.g).comp c_ext (Nat.zero_add (r + 1)) = 0 :=
      h_res_zero (r + 1) c_ext hc₀ hc₁
    exact CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS M c_ext hg0 (Nat.add_comm 1 r)
  · intro b hb
    obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hS M b (Nat.add_comm 1 r) hb
    refine ⟨splitExt r y, ?_⟩
    rw [h_diff_fac r (splitExt r y), h_combine_split r y]
    exact hy

theorem weil_proetale_proj_bc_finite_affine_cover_filtered_colimit (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
