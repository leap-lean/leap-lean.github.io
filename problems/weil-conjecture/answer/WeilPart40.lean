        CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_std hPB_outer
      let y_Z_hom : X_YZ ⟶ Z_s := Y_Z.hom
      let u_Z : B_is.obj W_A ⟶ Y_Z := CategoryTheory.MorphismProperty.Over.homMk
        (θ_pb.hom ≫ e_OZ)
        (by
          have hw_hZ : h_Z_left ≫ p₂ = y_Z_hom := CategoryTheory.MorphismProperty.Over.w h_Z
          change (θ_pb.hom ≫ e_OZ) ≫ y_Z_hom = CategoryTheory.Limits.pullback.snd w_A_hom i_s
          rw [← hw_hZ, ← CategoryTheory.Category.assoc]
