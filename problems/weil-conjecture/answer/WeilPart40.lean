      have hD_mem_F₁ : D ∈ F₁ := by
        dsimp [D]
        rw [← hM_map, ← RingHom.map_det]
        exact (M₀.det).2
      have hD_inv_Cpt : D⁻¹ ∈ C_pt := hF₁_le_Cpt D⁻¹ (F₁.inv_mem hD_mem_F₁)
      have hadj_Cpt : ∀ b a : Fin s, M.adjugate b a ∈ C_pt := by
        intro b a
        rw [← hM_map, ← RingHom.map_adjugate]
        exact hF₁_le_Cpt _ (M₀.adjugate b a).2

      let μ : Fin s → L_r := fun a => Algebra.trace L_r ↥E' (w_E * b_E a)
      have hμ_Cpt : ∀ a : Fin s, μ a ∈ C_pt := by
        intro a
        let alg_Apt_E : Algebra ↥A_pt ↥E' :=
          ((algebraMap L_r ↥E').comp (algebraMap ↥A_pt L_r)).toAlgebra
        let _ : Algebra ↥A_pt ↥E' := alg_Apt_E
        have hST_Apt_Lr_E :=
          @IsScalarTower.of_algebraMap_eq ↥A_pt L_r ↥E' _ _ _ _ _ alg_Apt_E (fun _ => rfl)
        obtain ⟨q_w, hqw_monic, hqw_eval⟩ := hw_int
        have hwE_int : IsIntegral ↥A_pt w_E := by
          refine ⟨q_w, hqw_monic, ?_⟩
          apply Subtype.val_injective
          rw [ZeroMemClass.coe_zero]
          change E'.val.toRingHom (Polynomial.eval₂
            ((algebraMap L_r ↥E').comp (algebraMap ↥A_pt L_r)) w_E q_w) = 0
          rw [Polynomial.hom_eval₂]
          exact hqw_eval
        have hb_int : IsIntegral ↥A_pt (b_E a) := by
          obtain ⟨p_a, hpa_monic, hpa_eval⟩ := hik_int_F (b_E a) (u a) (hbE_val a)
          refine ⟨p_a.map (algebraMap F ↥A_pt), hpa_monic.map _, ?_⟩
          rw [Polynomial.eval₂_map]
          exact hpa_eval
        exact @Algebra.isIntegral_trace ↥A_pt _ L_r _ ↥E' _ _ _ alg_Apt_E hST_Apt_Lr_E _
          (w_E * b_E a) (hwE_int.mul hb_int)

      have hμ_eq : M.mulVec lam = μ := by
        ext a
        dsimp [μ, Matrix.mulVec, dotProduct, M]
        conv_rhs => rw [← b_E.sum_repr w_E]
        rw [Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [LinearMap.BilinForm.toMatrix_apply, Algebra.traceForm_apply,
          smul_mul_assoc, LinearMap.map_smul, smul_eq_mul, mul_comm (b_E b) (b_E a)]
        exact mul_comm _ _

      have hlam_Cpt : ∀ b : Fin s, lam b ∈ C_pt := by
        intro b
        have hadj_mul := congrArg (fun N => N.mulVec lam b) (Matrix.adjugate_mul M)
        rw [← Matrix.mulVec_mulVec, hμ_eq] at hadj_mul
        have hrhs : ((M.det • (1 : Matrix (Fin s) (Fin s) L_r)).mulVec lam) b = D * lam b := by
          simp [D, Matrix.mulVec, dotProduct, Matrix.one_apply]
        rw [hrhs] at hadj_mul
        have hlam_eq : lam b = D⁻¹ * ∑ a : Fin s, M.adjugate b a * μ a := by
          apply mul_left_cancel₀ hD_ne
          rw [← mul_assoc, mul_inv_cancel₀ hD_ne, one_mul]
          exact hadj_mul.symm
        rw [hlam_eq]
        exact C_pt.mul_mem hD_inv_Cpt
          (C_pt.sum_mem fun a _ => C_pt.mul_mem (hadj_Cpt b a) (hμ_Cpt a))

      exact ⟨s, u, fun b => ⟨lam b, hlam_Cpt b⟩, hw_lam⟩

  
  
  
  refine ⟨hPart1, fun σ_L hInt hInert => ?_⟩

  have hσE_ex : ∃ σ_E : ↥E_r ≃ₐ[K_k] ↥E_r,
      (∀ z : L_r, ∃ hz : ι_r z ∈ E_r, (σ_E ⟨ι_r z, hz⟩ : Ω) = ι_r (σ_L z)) ∧
      (∀ c : k, ∃ hc : i_k c ∈ E_r, (σ_E ⟨i_k c, hc⟩ : Ω) = i_k c) := by
    obtain ⟨⟨hΦ_inj, hEr_range⟩, _⟩ := hTensor_and_Trace
    let _ : Algebra ↥F₁ k := φ₁.toRingHom.toAlgebra
    let _ : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
    let f_k : k →ₐ[↥F₁] Ω := { i_k with commutes' := hφ₁ }
    let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
    let Φ : (TensorProduct ↥F₁ k L_r) →+* Ω :=
      (Algebra.TensorProduct.lift f_k f_L (fun _ _ => mul_comm _ _)).toRingHom
    let Φ_E : (TensorProduct ↥F₁ k L_r) →+* ↥E_r :=
      { toFun := fun t => ⟨Φ t, show Φ t ∈ (E_r : Set Ω) from hEr_range.symm ▸ ⟨t, rfl⟩⟩
        map_one' := Subtype.ext (map_one Φ)
        map_mul' := fun _ _ => Subtype.ext (map_mul Φ _ _)
        map_zero' := Subtype.ext (map_zero Φ)
        map_add' := fun _ _ => Subtype.ext (map_add Φ _ _) }
    have hΦE_bij : Function.Bijective Φ_E := by
      refine ⟨fun t₁ t₂ h => hΦ_inj (congrArg Subtype.val h), fun w => ?_⟩
      have hw_mem : (w : Ω) ∈ Set.range Φ := by
        rw [← hEr_range]
        exact w.2
      obtain ⟨t, ht⟩ := hw_mem
      exact ⟨t, Subtype.ext ht⟩
    let e_Φ : (TensorProduct ↥F₁ k L_r) ≃+* ↥E_r := RingEquiv.ofBijective Φ_E hΦE_bij
    let σ_L' : L_r ≃ₐ[↥F₁] L_r :=
      { σ_L.toRingEquiv with
        commutes' := fun x => hInt x.1 (hF₁_int x) }
    let θ_T : (TensorProduct ↥F₁ k L_r) ≃ₐ[↥F₁] (TensorProduct ↥F₁ k L_r) :=
      Algebra.TensorProduct.congr (AlgEquiv.refl : k ≃ₐ[↥F₁] k) σ_L'
    let σ_ring : ↥E_r ≃+* ↥E_r := e_Φ.symm.trans (θ_T.toRingEquiv.trans e_Φ)
    have hσ_app : ∀ t : TensorProduct ↥F₁ k L_r, (σ_ring (e_Φ t) : Ω) = Φ (θ_T t) := by
      intro t
      change (e_Φ (θ_T (e_Φ.symm (e_Φ t))) : Ω) = Φ (θ_T t)
      rw [e_Φ.symm_apply_apply]
      rfl
    have hσ_L_eq : ∀ z : L_r, ∃ hz : ι_r z ∈ E_r, (σ_ring ⟨ι_r z, hz⟩ : Ω) = ι_r (σ_L z) := by
      intro z
      have hz : ι_r z ∈ E_r := IntermediateField.subset_adjoin K_k (Set.range ι_r) ⟨z, rfl⟩
      refine ⟨hz, ?_⟩
      have he : e_Φ (TensorProduct.tmul ↥F₁ 1 z) = ⟨ι_r z, hz⟩ := by
        apply Subtype.ext
        change i_k 1 * ι_r z = ι_r z
        rw [map_one, one_mul]
      rw [← he, hσ_app]
      change Φ (TensorProduct.tmul ↥F₁ 1 (σ_L z)) = ι_r (σ_L z)
      change i_k 1 * ι_r (σ_L z) = ι_r (σ_L z)
      rw [map_one, one_mul]
    have hσ_k_eq : ∀ c : k, ∃ hc : i_k c ∈ E_r, (σ_ring ⟨i_k c, hc⟩ : Ω) = i_k c := by
      intro c
      have hc : i_k c ∈ E_r := by
        change algebraMap P Ω (Polynomial.C c) ∈ E_r
        rw [IsScalarTower.algebraMap_apply P K_k Ω]
        exact E_r.algebraMap_mem _
      refine ⟨hc, ?_⟩
      have he : e_Φ (TensorProduct.tmul ↥F₁ c 1) = ⟨i_k c, hc⟩ := by
        apply Subtype.ext
        change i_k c * ι_r 1 = i_k c
        rw [map_one, mul_one]
      rw [← he, hσ_app]
      change Φ (TensorProduct.tmul ↥F₁ c (σ_L 1)) = i_k c
      rw [map_one]
      change i_k c * ι_r 1 = i_k c
      rw [map_one, mul_one]
    have hσ_P : ∀ f : P, σ_ring (algebraMap P ↥E_r f) = algebraMap P ↥E_r f := by
      intro f
      refine Polynomial.induction_on' f ?_ ?_
      · intro f₁ f₂ h₁ h₂
        rw [map_add, map_add, h₁, h₂]
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
        have hC_fix : σ_ring (algebraMap P ↥E_r (Polynomial.C c)) =
            algebraMap P ↥E_r (Polynomial.C c) := by
          obtain ⟨hc, hc_eq⟩ := hσ_k_eq c
          have hsub : algebraMap P ↥E_r (Polynomial.C c) = ⟨i_k c, hc⟩ := by
            apply Subtype.ext
            rw [IsScalarTower.algebraMap_apply P K_k ↥E_r]
            change algebraMap K_k Ω (algebraMap P K_k (Polynomial.C c)) = _
            rw [← IsScalarTower.algebraMap_apply P K_k Ω]
            rfl
          apply Subtype.ext
          rw [hsub, hc_eq]
        have hX_fix : σ_ring (algebraMap P ↥E_r Polynomial.X) =
            algebraMap P ↥E_r Polynomial.X := by
          obtain ⟨hz, hz_eq⟩ := hσ_L_eq t₀
          have ht₀_fix : σ_L t₀ = t₀ := σ_L.commutes t_pt
          have hsub : algebraMap P ↥E_r Polynomial.X = ⟨ι_r t₀, hz⟩ := by
            apply Subtype.ext
            rw [IsScalarTower.algebraMap_apply P K_k ↥E_r]
            change algebraMap K_k Ω (algebraMap P K_k Polynomial.X) = ι_r t₀
            rw [← IsScalarTower.algebraMap_apply P K_k Ω]
            exact hι_t₀.symm
          apply Subtype.ext
          rw [hsub, hz_eq, ht₀_fix]
        rw [hC_fix, hX_fix]
    have hσ_Kk : ∀ q : K_k, σ_ring (algebraMap K_k ↥E_r q) = algebraMap K_k ↥E_r q := by
      intro q
      obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors P) q
      have hs_ne : algebraMap P ↥E_r s.1 ≠ 0 := by
        intro h0
        rw [IsScalarTower.algebraMap_apply P K_k ↥E_r] at h0
        have hs_K : algebraMap P K_k s.1 = 0 :=
          (algebraMap K_k ↥E_r).injective (h0.trans (map_zero _).symm)
        have hs0 : s.1 = 0 :=
          IsFractionRing.injective P K_k (hs_K.trans (map_zero _).symm)
        exact mem_nonZeroDivisors_iff_ne_zero.mp s.2 hs0
      apply mul_right_cancel₀ hs_ne
      have hmul : algebraMap K_k ↥E_r q * algebraMap P ↥E_r s.1 = algebraMap P ↥E_r a := by
        rw [IsScalarTower.algebraMap_apply P K_k ↥E_r s.1,
          IsScalarTower.algebraMap_apply P K_k ↥E_r a, ← map_mul, hsurj]
      calc
        σ_ring (algebraMap K_k ↥E_r q) * algebraMap P ↥E_r s.1
            = σ_ring (algebraMap K_k ↥E_r q) * σ_ring (algebraMap P ↥E_r s.1) := by
              rw [hσ_P s.1]
        _ = σ_ring (algebraMap K_k ↥E_r q * algebraMap P ↥E_r s.1) :=
              (map_mul σ_ring _ _).symm
        _ = σ_ring (algebraMap P ↥E_r a) := by rw [hmul]
        _ = algebraMap P ↥E_r a := hσ_P a
        _ = algebraMap K_k ↥E_r q * algebraMap P ↥E_r s.1 := hmul.symm
    let σ_E : ↥E_r ≃ₐ[K_k] ↥E_r := { σ_ring with commutes' := hσ_Kk }
    exact ⟨σ_E, hσ_L_eq, hσ_k_eq⟩

  obtain ⟨σ_E, hσE_L, hσE_k⟩ := hσE_ex
  refine ⟨σ_E, hσE_L, ?_⟩

  
  
  
  have hP_Er_val : ∀ f : P, (algebraMap P ↥E_r f : Ω) = algebraMap P Ω f := by
    intro f
    rw [IsScalarTower.algebraMap_apply P K_k ↥E_r, IsScalarTower.algebraMap_apply P K_k Ω]
    rfl

  have hCE_inert : ∀ y : ↥(integralClosure P ↥E_r),
      ∃ hy : ((σ_E y.1 : ↥E_r) - (y.1 : ↥E_r) : Ω) ∈ V_s,
        (⟨((σ_E y.1 : ↥E_r) - (y.1 : ↥E_r) : Ω), hy⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s := by
    intro y
    have hy_int_Apt : (ι_r.comp (algebraMap ↥A_pt L_r)).IsIntegralElem (y.1 : Ω) := by
      let f_A : ↥A_pt →+* Ω := ι_r.comp (algebraMap ↥A_pt L_r)
      let _ : Algebra ↥A_pt Ω := f_A.toAlgebra
      let R_int : Subalgebra ↥A_pt Ω := integralClosure ↥A_pt Ω
      have hP_mem_R : ∀ f : P, algebraMap P Ω f ∈ R_int := by
        intro f
        refine Polynomial.induction_on' f ?_ ?_
        · intro f₁ f₂ h₁ h₂
          rw [map_add]; exact R_int.add_mem h₁ h₂
        · intro n c
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
          have hc_int : algebraMap P Ω (Polynomial.C c) ∈ R_int := by
            have hc_F : IsIntegral F c :=
              isAlgebraic_iff_isIntegral.mp ((AlgebraicClosure.isAlgebraic F).isAlgebraic c)
            let p_c : Polynomial F := minpoly F c
            refine ⟨p_c.map (algebraMap F ↥A_pt), (minpoly.monic hc_F).map _, ?_⟩
            change Polynomial.eval₂ f_A (i_k c) (p_c.map (algebraMap F ↥A_pt)) = 0
            rw [Polynomial.eval₂_map]
            have hcomp : f_A.comp (algebraMap F ↥A_pt) = i_k.comp (algebraMap F k) := by
              ext a; exact hι_F a
            rw [hcomp, ← Polynomial.hom_eval₂]
            change i_k (Polynomial.aeval c p_c) = 0
            rw [minpoly.aeval F c, map_zero]
          have hX_int : algebraMap P Ω Polynomial.X ∈ R_int := by
            let gen_pt : ↥A_pt := ⟨t₀, Algebra.self_mem_adjoin_singleton F t₀⟩
            have hX_eq : algebraMap P Ω Polynomial.X = algebraMap ↥A_pt Ω gen_pt := hι_t₀.symm
            rw [hX_eq]
            exact isIntegral_algebraMap
          exact R_int.mul_mem hc_int (R_int.pow_mem hX_int n)
      let g_P : P →+* ↥R_int :=
        { toFun := fun f => ⟨algebraMap P Ω f, hP_mem_R f⟩
          map_one' := Subtype.ext (map_one _)
          map_mul' := fun _ _ => Subtype.ext (map_mul _ _ _)
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun _ _ => Subtype.ext (map_add _ _ _) }
      obtain ⟨q_y, hqy_monic, hqy_eval⟩ := y.2
      have hy_int_R : IsIntegral ↥R_int (y.1 : Ω) := by
        refine ⟨q_y.map g_P, hqy_monic.map g_P, ?_⟩
        rw [Polynomial.eval₂_map]
        have hcomp : (algebraMap ↥R_int Ω).comp g_P = E_r.val.toRingHom.comp (algebraMap P ↥E_r) :=
          RingHom.ext fun f => (hP_Er_val f).symm
        change Polynomial.eval₂ ((algebraMap ↥R_int Ω).comp g_P) (E_r.val.toRingHom y.1) q_y = 0
        rw [hcomp, ← Polynomial.hom_eval₂, hqy_eval, map_zero]
      let _ : Algebra.IsIntegral ↥A_pt ↥R_int := ⟨integralClosure.isIntegral⟩
      exact isIntegral_trans (R := ↥A_pt) (A := ↥R_int) (y.1 : Ω) hy_int_R

    obtain ⟨⟨_, hEr_range⟩, hTrace_decomp⟩ := hTensor_and_Trace
    have hy_in_Φ := by
      have hmem : (y.1 : Ω) ∈ (E_r : Set Ω) := y.1.2
      rwa [hEr_range] at hmem
    obtain ⟨t_y, hty_eq⟩ := hy_in_Φ
    have ht_fin : ∃ (m : ℕ) (c : Fin m → k) (z : Fin m → L_r),
        (y.1 : Ω) = ∑ j : Fin m, i_k (c j) * ι_r (z j) := by
      let _ : Algebra ↥F₁ k := φ₁.toRingHom.toAlgebra
      let _ : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
      let f_k : k →ₐ[↥F₁] Ω := { i_k with commutes' := hφ₁ }
      let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
      let Φ : (TensorProduct ↥F₁ k L_r) →+* Ω :=
        (Algebra.TensorProduct.lift f_k f_L (fun _ _ => mul_comm _ _)).toRingHom
      change Φ t_y = (y.1 : Ω) at hty_eq
      rw [← hty_eq]
      clear hty_eq
      induction t_y using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      | tmul x r =>
        exact ⟨1, fun _ => x, fun _ => r,
          (Fin.sum_univ_one (fun _ : Fin 1 => i_k x * ι_r r)).symm⟩
      | add s₁ s₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨m₁, c₁, z₁, h₁⟩
        rcases ih₂ with ⟨m₂, c₂, z₂, h₂⟩
        refine ⟨m₁ + m₂, Fin.addCases c₁ c₂, Fin.addCases z₁ z₂, ?_⟩
        rw [map_add, h₁, h₂, Fin.sum_univ_add]
        simp [Fin.addCases]
    obtain ⟨m, c, z, hy_sum0⟩ := ht_fin
    obtain ⟨s, u, y_pt, hy_sum⟩ := hTrace_decomp (y.1 : Ω) hy_int_Apt m c z hy_sum0

    have hy_Er_eq : y.1 =
        ∑ b : Fin s,
          (⟨i_k (u b), (hσE_k (u b)).choose⟩ : ↥E_r) *
            (⟨ι_r (y_pt b).1, (hσE_L (y_pt b).1).choose⟩ : ↥E_r) := by
      apply Subtype.ext
      rw [hy_sum, AddSubmonoidClass.coe_finsetSum]
      refine Finset.sum_congr rfl fun b _ => rfl
    have hdiff_eq : ((σ_E y.1 : ↥E_r) - (y.1 : ↥E_r) : Ω) =
        ∑ b : Fin s, i_k (u b) * ι_r (σ_L (y_pt b).1 - (y_pt b).1) := by
      change E_r.val (σ_E y.1 - y.1) = _
      rw [map_sub E_r.val, hy_Er_eq, map_sum σ_E, map_sum E_r.val, map_sum E_r.val,
        ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [map_mul, map_mul, map_mul]
      change (σ_E ⟨i_k (u b), _⟩ : Ω) * (σ_E ⟨ι_r (y_pt b).1, _⟩ : Ω) -
        i_k (u b) * ι_r (y_pt b).1 = _
      rw [(hσE_k (u b)).choose_spec, (hσE_L (y_pt b).1).choose_spec, map_sub, mul_sub]
    have hterm_max : ∀ b : Fin s,
        ∃ hb : i_k (u b) * ι_r (σ_L (y_pt b).1 - (y_pt b).1) ∈ V_s,
          (⟨i_k (u b) * ι_r (σ_L (y_pt b).1 - (y_pt b).1), hb⟩ : ↥V_s) ∈
            IsLocalRing.maximalIdeal ↥V_s := by
      intro b
      obtain ⟨q_b, hqb_mem, hqb_val⟩ := hInert (y_pt b)
      rw [← hqb_val]
      obtain ⟨hq_Vs, hq_max⟩ := (hQ_iff q_b).mp hqb_mem
      have hu_Vs : i_k (u b) ∈ V_s := hC_mem (u b)
      refine ⟨mul_mem hu_Vs hq_Vs, ?_⟩
      have hmul_sub :
          (⟨i_k (u b) * ι_r q_b.1, mul_mem hu_Vs hq_Vs⟩ : ↥V_s) =
            (⟨i_k (u b), hu_Vs⟩ : ↥V_s) * ⟨ι_r q_b.1, hq_Vs⟩ := rfl
      rw [hmul_sub]
      exact Ideal.mul_mem_left _ _ hq_max
    have hsum_Vs : (∑ b : Fin s, i_k (u b) * ι_r (σ_L (y_pt b).1 - (y_pt b).1)) ∈ V_s :=
      V_s.toSubring.sum_mem fun b _ => (hterm_max b).choose
    refine ⟨hdiff_eq.symm ▸ hsum_Vs, ?_⟩
    have hsub_eq :
        (⟨((σ_E y.1 : ↥E_r) - (y.1 : ↥E_r) : Ω), hdiff_eq.symm ▸ hsum_Vs⟩ : ↥V_s) =
        ∑ b : Fin s, ⟨i_k (u b) * ι_r (σ_L (y_pt b).1 - (y_pt b).1), (hterm_max b).choose⟩ := by
      apply Subtype.ext
      change ((σ_E y.1 : ↥E_r) - (y.1 : ↥E_r) : Ω) = _
      rw [hdiff_eq, AddSubmonoidClass.coe_finsetSum]
    rw [hsub_eq]
    exact Submodule.sum_mem _ fun b _ => (hterm_max b).choose_spec

  
  
  
  let V_E : ValuationSubring ↥E_r := V_s.comap E_r.val.toRingHom
  let ι_VE : ↥V_E →+* ↥V_s :=
    { toFun := fun z => ⟨(z.1 : Ω), z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }

  have hVE_max_iff : ∀ z : ↥V_E,
      z ∈ IsLocalRing.maximalIdeal ↥V_E ↔ ι_VE z ∈ IsLocalRing.maximalIdeal ↥V_s := by
    intro z
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
      mem_nonunits_iff, mem_nonunits_iff, not_iff_not]
    constructor
    · exact IsUnit.map ι_VE
    · rintro ⟨u, hu⟩
      have h1 : ι_VE z * (u⁻¹ : (↥V_s)ˣ) = 1 := by
        rw [← hu, Units.mul_inv]
      have hmul : (z.1 : Ω) * ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).1 = 1 := congrArg Subtype.val h1
      have hz_ne_Ω : (z.1 : Ω) ≠ 0 := left_ne_zero_of_mul_eq_one hmul
      have hz_ne : z.1 ≠ 0 := fun h0 => hz_ne_Ω (by rw [h0, ZeroMemClass.coe_zero])
      have hinv_eq : ((z.1)⁻¹ : Ω) = ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).1 := by
        apply mul_left_cancel₀ hz_ne_Ω
        rw [hmul]
        change E_r.val z.1 * E_r.val (z.1)⁻¹ = 1
        rw [← map_mul, mul_inv_cancel₀ hz_ne, map_one]
      have hinv_VE : (z.1)⁻¹ ∈ V_E := by
        change ((z.1)⁻¹ : Ω) ∈ V_s
        rw [hinv_eq]
        exact ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).2
      refine ⟨⟨z, ⟨(z.1)⁻¹, hinv_VE⟩, ?_, ?_⟩, rfl⟩
      · exact Subtype.ext (mul_inv_cancel₀ hz_ne)
      · exact Subtype.ext (inv_mul_cancel₀ hz_ne)

  have hP_mem_VE : ∀ f : P, algebraMap P ↥E_r f ∈ V_E := by
    intro f
    change (algebraMap P ↥E_r f : Ω) ∈ V_s
    rw [hP_Er_val f]
    refine Polynomial.induction_on' f ?_ ?_
    · intro f₁ f₂ h₁ h₂
      rw [map_add]; exact add_mem h₁ h₂
    · intro n c
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
      exact mul_mem (hC_mem c) (pow_mem hX_mem n)

  let g_PV : P →+* ↥V_E :=
    { toFun := fun f => ⟨algebraMap P ↥E_r f, hP_mem_VE f⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' := fun _ _ => Subtype.ext (map_mul _ _ _)
      map_zero' := Subtype.ext (map_zero _)
      map_add' := fun _ _ => Subtype.ext (map_add _ _ _) }

  let C_E := integralClosure P ↥E_r
  have hCE_mem_VE : ∀ y : ↥C_E, y.1 ∈ V_E := by
    intro y
    obtain ⟨q_y, hqy_monic, hqy_eval⟩ := y.2
    have hy_int_VE : IsIntegral ↥V_E y.1 := by
      refine ⟨q_y.map g_PV, hqy_monic.map g_PV, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp : V_E.subtype.comp g_PV = algebraMap P ↥E_r := RingHom.ext fun _ => rfl
      change Polynomial.eval₂ (V_E.subtype.comp g_PV) y.1 q_y = 0
      rw [hcomp]
      exact hqy_eval
    obtain ⟨v, hv⟩ := IsIntegrallyClosed.isIntegral_iff.mp hy_int_VE
    rw [← hv]
    exact v.2

  let j_CE : ↥C_E →+* ↥V_E :=
    { toFun := fun y => ⟨y.1, hCE_mem_VE y⟩
      map_one' := Subtype.ext rfl
      map_mul' := fun _ _ => Subtype.ext rfl
      map_zero' := Subtype.ext rfl
      map_add' := fun _ _ => Subtype.ext rfl }

  let Q_E : Ideal ↥C_E := Ideal.comap j_CE (IsLocalRing.maximalIdeal ↥V_E)
  let _ : Q_E.IsPrime := Ideal.IsPrime.comap j_CE

  let x_CE : ↥C_E := algebraMap P ↥C_E Polynomial.X
  have hx_CE_mem : x_CE ∈ Q_E := by
    change j_CE x_CE ∈ IsLocalRing.maximalIdeal ↥V_E
    rw [hVE_max_iff]
    have heq : ι_VE (j_CE x_CE) = ⟨algebraMap P Ω Polynomial.X, hX_mem⟩ :=
      Subtype.ext (hP_Er_val Polynomial.X)
    rw [heq]
    exact hX_max

  have hP_Er_inj : ∀ f : P, algebraMap P ↥E_r f = 0 → f = 0 := by
    intro f hf0
    have hΩ0 : algebraMap P Ω f = 0 := by
      rw [← hP_Er_val f, hf0, ZeroMemClass.coe_zero]
    rw [IsScalarTower.algebraMap_apply P K_k Ω] at hΩ0
    have hK0 : algebraMap P K_k f = 0 :=
      (algebraMap K_k Ω).injective (hΩ0.trans (map_zero _).symm)
    exact IsFractionRing.injective P K_k (hK0.trans (map_zero _).symm)

  have hx_CE_ne : x_CE ≠ 0 := by
    intro h0
    have hf0 : algebraMap P ↥E_r Polynomial.X = 0 := congrArg Subtype.val h0
    exact Polynomial.X_ne_zero (hP_Er_inj Polynomial.X hf0)

  have hQE_ne_bot : Q_E ≠ ⊥ := by
    intro hbot
    rw [hbot, Ideal.mem_bot] at hx_CE_mem
    exact hx_CE_ne hx_CE_mem

  let _ : IsDedekindDomain P := IsPrincipalIdealRing.isDedekindDomain P
  let _ : IsDedekindDomain ↥C_E := integralClosure.isDedekindDomain P K_k ↥E_r

  have hAlg_P_Kk : Algebra.IsAlgebraic P K_k := by
    refine ⟨fun q => ?_⟩
    obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors P) q
    let p_q : Polynomial P := Polynomial.C s.1 * Polynomial.X - Polynomial.C a
    have hpq_ne : p_q ≠ 0 := by
      intro h0
      have hc1 : p_q.coeff 1 = 0 := by rw [h0, Polynomial.coeff_zero]
      dsimp [p_q] at hc1
      simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
        mul_one, Polynomial.coeff_C_succ, sub_zero] at hc1
      exact mem_nonZeroDivisors_iff_ne_zero.mp s.2 hc1
    refine ⟨p_q, hpq_ne, ?_⟩
    dsimp [p_q]
    rw [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, Polynomial.aeval_C,
      mul_comm, hsurj, sub_self]

  have hAlg_P_Er : Algebra.IsAlgebraic P ↥E_r := by
    let _ : Algebra.IsAlgebraic P K_k := hAlg_P_Kk
    let _ : Algebra.IsAlgebraic K_k ↥E_r := Algebra.IsAlgebraic.of_finite K_k ↥E_r
    exact Algebra.IsAlgebraic.trans P K_k ↥E_r

  let _ : Algebra.IsAlgebraic P ↥E_r := hAlg_P_Er
  let _ : IsFractionRing ↥C_E ↥E_r := integralClosure.isFractionRing_of_algebraic hP_Er_inj

  have hDvd_Q : ∀ (a b : ↥C_E),
      (∃ (c : ↥C_E) (s : Q_E.primeCompl), s.1 * a = b * c) ∨
      (∃ (c : ↥C_E) (s : Q_E.primeCompl), s.1 * b = a * c) := by
    intro a b
    let R_Q := Localization.AtPrime Q_E
    have hQE_le_nzd : Q_E.primeCompl ≤ nonZeroDivisors ↥C_E := by
      intro s hs
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro hs0
      exact hs (hs0 ▸ Q_E.zero_mem)
    let _ : IsDomain R_Q := IsLocalization.isDomain_localization hQE_le_nzd
    let _ : IsDiscreteValuationRing R_Q :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥C_E hQE_ne_bot R_Q
    let _ : ValuationRing R_Q := of_isDiscreteValuationRing R_Q
    have h_inj : Function.Injective (algebraMap ↥C_E R_Q) :=
      IsLocalization.injective R_Q hQE_le_nzd
    rcases (ValuationRing.iff_dvd_total.mp (inferInstance : ValuationRing R_Q)).total
        (algebraMap ↥C_E R_Q b) (algebraMap ↥C_E R_Q a) with
      ⟨r, hr⟩ | ⟨r, hr⟩
    · left
      obtain ⟨⟨c, s⟩, hsurj⟩ := IsLocalization.surj Q_E.primeCompl r
      refine ⟨c, s, h_inj ?_⟩
      rw [map_mul, map_mul, hr, mul_left_comm, mul_comm _ r, hsurj]
    · right
      obtain ⟨⟨c, s⟩, hsurj⟩ := IsLocalization.surj Q_E.primeCompl r
      refine ⟨c, s, h_inj ?_⟩
      rw [map_mul, map_mul, hr, mul_left_comm, mul_comm _ r, hsurj]

  let S_Q : Subring ↥E_r :=
    { carrier := { w : ↥E_r | ∃ (a : ↥C_E) (s : Q_E.primeCompl), w * (s.1 : ↥E_r) = (a : ↥E_r) }
      mul_mem' := by
        rintro w₁ w₂ ⟨a₁, s₁, h₁⟩ ⟨a₂, s₂, h₂⟩
        refine ⟨a₁ * a₂, s₁ * s₂, ?_⟩
        change (w₁ * w₂) * ((s₁.1 : ↥E_r) * (s₂.1 : ↥E_r)) = (a₁ : ↥E_r) * (a₂ : ↥E_r)
        calc
          (w₁ * w₂) * ((s₁.1 : ↥E_r) * (s₂.1 : ↥E_r))
              = (w₁ * (s₁.1 : ↥E_r)) * (w₂ * (s₂.1 : ↥E_r)) := by ring
          _ = (a₁ : ↥E_r) * (a₂ : ↥E_r) := by rw [h₁, h₂]
      one_mem' := ⟨1, 1, by change (1 : ↥E_r) * 1 = 1; ring⟩
      add_mem' := by
        rintro w₁ w₂ ⟨a₁, s₁, h₁⟩ ⟨a₂, s₂, h₂⟩
        refine ⟨a₁ * s₂.1 + a₂ * s₁.1, s₁ * s₂, ?_⟩
        change (w₁ + w₂) * ((s₁.1 : ↥E_r) * (s₂.1 : ↥E_r)) =
          (a₁ : ↥E_r) * (s₂.1 : ↥E_r) + (a₂ : ↥E_r) * (s₁.1 : ↥E_r)
        calc
          (w₁ + w₂) * ((s₁.1 : ↥E_r) * (s₂.1 : ↥E_r))
              = (w₁ * (s₁.1 : ↥E_r)) * (s₂.1 : ↥E_r) +
                (w₂ * (s₂.1 : ↥E_r)) * (s₁.1 : ↥E_r) := by ring
          _ = (a₁ : ↥E_r) * (s₂.1 : ↥E_r) + (a₂ : ↥E_r) * (s₁.1 : ↥E_r) := by rw [h₁, h₂]
      zero_mem' := ⟨0, 1, by change (0 : ↥E_r) * 1 = 0; ring⟩
      neg_mem' := by
        rintro w ⟨a, s, h⟩
        refine ⟨-a, s, ?_⟩
        change (-w) * (s.1 : ↥E_r) = -(a : ↥E_r)
        rw [neg_mul, h] }

  have hTot_WQ : ∀ w : ↥E_r, w ∈ S_Q ∨ w⁻¹ ∈ S_Q := by
    intro w
    obtain ⟨⟨a, b⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors ↥C_E) w
    have hb_ne : (b.1 : ↥E_r) ≠ 0 := by
      intro h0
      exact mem_nonZeroDivisors_iff_ne_zero.mp b.2 (Subtype.ext h0)
    have hwb : w * (b.1 : ↥E_r) = (a : ↥E_r) := hsurj
    rcases hDvd_Q a b.1 with ⟨c, s, hcs⟩ | ⟨c, s, hcs⟩
    · left
      refine ⟨c, s, ?_⟩
      apply mul_left_cancel₀ hb_ne
      have hcs_E : (s.1 : ↥E_r) * (a : ↥E_r) = (b.1 : ↥E_r) * (c : ↥E_r) :=
        congrArg Subtype.val hcs
      calc
        (b.1 : ↥E_r) * (w * (s.1 : ↥E_r)) = (s.1 : ↥E_r) * (w * (b.1 : ↥E_r)) := by ring
        _ = (s.1 : ↥E_r) * (a : ↥E_r) := by rw [hwb]
        _ = (b.1 : ↥E_r) * (c : ↥E_r) := hcs_E
    · by_cases hw0 : w = 0
      · left
        rw [hw0]
        exact S_Q.zero_mem
      · right
        refine ⟨c, s, ?_⟩
        have hcs_E : (s.1 : ↥E_r) * (b.1 : ↥E_r) = (a : ↥E_r) * (c : ↥E_r) :=
          congrArg Subtype.val hcs
        have ha_ne : (a : ↥E_r) ≠ 0 := by
          rw [← hwb]
          exact mul_ne_zero hw0 hb_ne
        apply mul_left_cancel₀ ha_ne
        calc
          (a : ↥E_r) * (w⁻¹ * (s.1 : ↥E_r))
              = (w * w⁻¹) * ((s.1 : ↥E_r) * (b.1 : ↥E_r)) := by
                rw [← hwb]; ring
          _ = (s.1 : ↥E_r) * (b.1 : ↥E_r) := by rw [mul_inv_cancel₀ hw0, one_mul]
          _ = (a : ↥E_r) * (c : ↥E_r) := hcs_E

  let W_QE : ValuationSubring ↥E_r := ValuationSubring.ofSubring S_Q hTot_WQ

  have hW_le_VE : W_QE ≤ V_E := by
    rintro w ⟨a, s, hws⟩
    have hs_ne : (s.1 : ↥E_r) ≠ 0 := by
      intro h0
      exact s.2 ((Subtype.ext h0 : s.1 = 0) ▸ Q_E.zero_mem)
    have hs_not_max : j_CE s.1 ∉ IsLocalRing.maximalIdeal ↥V_E := s.2
    have hs_unit : IsUnit (j_CE s.1) := IsLocalRing.notMem_maximalIdeal.mp hs_not_max
    obtain ⟨u_s, hu_s⟩ := hs_unit
    have hu_inv_eq : ((u_s⁻¹ : (↥V_E)ˣ).val : ↥E_r) = ((s.1 : ↥E_r))⁻¹ := by
      have hmul : (s.1 : ↥E_r) * ((u_s⁻¹ : (↥V_E)ˣ).val : ↥E_r) = 1 := by
        have h2 : u_s.val * (u_s⁻¹).val = 1 := Units.mul_inv u_s
        rw [hu_s] at h2
        exact congrArg Subtype.val h2
      exact eq_inv_of_mul_eq_one_right hmul
    have hw_eq : w = (a : ↥E_r) * ((s.1 : ↥E_r))⁻¹ := by
      apply mul_right_cancel₀ hs_ne
      rw [inv_mul_cancel_right₀ hs_ne]
      exact hws
    rw [hw_eq, ← hu_inv_eq]
    exact mul_mem (hCE_mem_VE a) ((u_s⁻¹ : (↥V_E)ˣ).val).2

  have hX_mem_WQ : algebraMap P ↥E_r Polynomial.X ∈ W_QE :=
    ⟨x_CE, 1, by change algebraMap P ↥E_r Polynomial.X * 1 = x_CE.1; rw [mul_one]; rfl⟩

  have hX_max_WQ :
      (⟨algebraMap P ↥E_r Polynomial.X, hX_mem_WQ⟩ : ↥W_QE) ∈
        IsLocalRing.maximalIdeal ↥W_QE := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨u, hu⟩
    let inc_WV : ↥W_QE →+* ↥V_E :=
      { toFun := fun z => ⟨z.1, hW_le_VE z.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hu_VE : IsUnit (j_CE x_CE) := by
      have heq : inc_WV ⟨algebraMap P ↥E_r Polynomial.X, hX_mem_WQ⟩ = j_CE x_CE := rfl
      rw [← heq, ← hu]
      exact IsUnit.map inc_WV u.isUnit
    exact (IsLocalRing.mem_maximalIdeal (j_CE x_CE)).mp hx_CE_mem hu_VE

  have hC_mem_WQ : ∀ c : k, algebraMap P ↥E_r (Polynomial.C c) ∈ W_QE :=
    fun c => ⟨algebraMap P ↥C_E (Polynomial.C c), 1, by
      change algebraMap P ↥E_r (Polynomial.C c) * 1 = _; rw [mul_one]; rfl⟩

  have hWQ_eq_VE : W_QE = V_E :=
    hRank1Max E_r W_QE hX_mem_WQ hX_max_WQ hC_mem_WQ (Or.inl hW_le_VE)

  have hσ_CE_mem : ∀ (τ : ↥E_r ≃ₐ[K_k] ↥E_r) (y : ↥C_E), τ y.1 ∈ C_E := by
    intro τ y
    let τ_P : ↥E_r ≃ₐ[P] ↥E_r := τ.restrictScalars P
    exact y.2.map τ_P

  have hσ_QE_iff : ∀ y : ↥C_E, (⟨σ_E y.1, hσ_CE_mem σ_E y⟩ : ↥C_E) ∈ Q_E ↔ y ∈ Q_E := by
    intro y
    let y' : ↥C_E := ⟨σ_E y.1, hσ_CE_mem σ_E y⟩
    obtain ⟨hd_Vs, hd_max⟩ := hCE_inert y
    have hd_QE : y' - y ∈ Q_E := by
      change j_CE (y' - y) ∈ IsLocalRing.maximalIdeal ↥V_E
      rw [hVE_max_iff]
      have heq : ι_VE (j_CE (y' - y)) = ⟨((σ_E y.1 : ↥E_r) - (y.1 : ↥E_r) : Ω), hd_Vs⟩ := rfl
      rw [heq]
      exact hd_max
    constructor
    · intro hy'
      have hsub := Q_E.sub_mem hy' hd_QE
      have heq : y' - (y' - y) = y := sub_sub_cancel y' y
      rwa [heq] at hsub
    · intro hy
      have hadd := Q_E.add_mem hy hd_QE
      have heq : y + (y' - y) = y' := add_sub_cancel y y'
      rwa [heq] at hadd

  have hWQ_frac_iff : ∀ w : ↥E_r,
      w ∈ W_QE ↔ ∃ (a : ↥C_E) (s : Q_E.primeCompl), w * (s.1 : ↥E_r) = (a : ↥E_r) :=
    fun _ => Iff.rfl

  intro w
  change w ∈ V_E ↔ σ_E w ∈ V_E
  rw [← hWQ_eq_VE, hWQ_frac_iff, hWQ_frac_iff]
  constructor
  · rintro ⟨a, s, hws⟩
    let a' : ↥C_E := ⟨σ_E a.1, hσ_CE_mem σ_E a⟩
    let s' : ↥C_E := ⟨σ_E s.1.1, hσ_CE_mem σ_E s.1⟩
    have hs'_not : s' ∉ Q_E := fun hs' => s.2 ((hσ_QE_iff s.1).mp hs')
    refine ⟨a', ⟨s', hs'_not⟩, ?_⟩
    change σ_E w * σ_E s.1.1 = σ_E a.1
    rw [← map_mul, hws]
  · rintro ⟨a, s, hws⟩
    let a' : ↥C_E := ⟨σ_E.symm a.1, hσ_CE_mem σ_E.symm a⟩
    let s' : ↥C_E := ⟨σ_E.symm s.1.1, hσ_CE_mem σ_E.symm s.1⟩
    have hs'_not : s' ∉ Q_E := by
      intro hs'
      have hss' : (⟨σ_E s'.1, hσ_CE_mem σ_E s'⟩ : ↥C_E) = s.1 :=
        Subtype.ext (σ_E.apply_symm_apply s.1.1)
      have hin : (⟨σ_E s'.1, hσ_CE_mem σ_E s'⟩ : ↥C_E) ∈ Q_E := (hσ_QE_iff s').mpr hs'
      rw [hss'] at hin
      exact s.2 hin
    refine ⟨a', ⟨s', hs'_not⟩, ?_⟩
    change w * σ_E.symm s.1.1 = σ_E.symm a.1
    have h1 := congrArg σ_E.symm hws
    rw [map_mul, σ_E.symm_apply_apply] at h1
    exact h1

theorem weil_odp_wit_kummer_character_and_abhyankar_kernel (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ_k : (ℓ : k) ≠ 0) :
    let P := Polynomial k
    let K_k := FractionRing P
    let Ω := AlgebraicClosure K_k
    ∀ (V_s : ValuationSubring Ω) (π_Vs : ↥V_s →+* k)
      (hX_mem : algebraMap P Ω Polynomial.X ∈ V_s),
      RingHom.ker π_Vs = IsLocalRing.maximalIdeal ↥V_s →
      (⟨algebraMap P Ω Polynomial.X, hX_mem⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s →
      (∀ c : k, ∃ hc : algebraMap P Ω (Polynomial.C c) ∈ V_s,
        π_Vs ⟨algebraMap P Ω (Polynomial.C c), hc⟩ = c) →
      (∀ (L : IntermediateField K_k Ω) (W : ValuationSubring ↥L)
         (hXL : algebraMap P ↥L Polynomial.X ∈ W),
        (⟨algebraMap P ↥L Polynomial.X, hXL⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W →
        (∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ W) →
        (W ≤ V_s.comap L.val.toRingHom ∨ V_s.comap L.val.toRingHom ≤ W) →
        W = V_s.comap L.val.toRingHom) →
      (∀ (M : IntermediateField K_k Ω),
        M ≤ separableClosure K_k Ω →
        ∀ (σ_M : ↥M ≃ₐ[K_k] ↥M),
          (∀ x : ↥M, (x : Ω) ∈ V_s ↔ (σ_M x : Ω) ∈ V_s) →
          ∃ γ : Ω ≃ₐ[K_k] Ω,
            (∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) ∧
            (∀ x : ↥M, γ (x : Ω) = (σ_M x : Ω))) →
      ∀ (I_Vs : Subgroup (Ω ≃ₐ[K_k] Ω)),
        (∀ γ : Ω ≃ₐ[K_k] Ω, γ ∈ I_Vs ↔ ∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) →
        ∃ t_ℓ : ↥I_Vs → PadicInt ℓ,
          t_ℓ 1 = 0 ∧
          (∀ γ₁ γ₂ : ↥I_Vs, t_ℓ (γ₁ * γ₂) = t_ℓ γ₁ + t_ℓ γ₂) ∧
          Function.Surjective t_ℓ ∧
          ∀ (r : ℕ) (E : IntermediateField K_k Ω) [FiniteDimensional K_k ↥E] [IsGalois K_k ↥E],
            (∀ γ : ↥I_Vs, ∀ w : ↥E, ((γ.1 ^ (ℓ ^ (r + 1))) (w : Ω)) = (w : Ω)) →
            ∀ δ : ↥I_Vs, PadicInt.toZModPow (r + 1) (t_ℓ δ) = 0 →
              ∀ w : ↥E, δ.1 (w : Ω) = (w : Ω) :=
by
  classical
  intro P K_k Ω V_s π_Vs hX_mem hπ_ker hX_max hC_mem_π hRank1Max hLiftSep I_Vs hI_Vs
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
  have hℓ_two : 2 ≤ ℓ := hℓ_prime.two_le
  have hNeZeroPow : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hℓ_pos.ne'⟩
  have hZMod0_eq : ∀ a b : ZMod (ℓ ^ 0), a = b := fun a b => by
    let _ : NeZero (ℓ ^ 0) := hNeZeroPow 0
    apply ZMod.val_injective
    have ha : a.val < 1 := (ZMod.val_lt a).trans_eq (pow_zero ℓ)
    have hb : b.val < 1 := (ZMod.val_lt b).trans_eq (pow_zero ℓ)
    omega
  have hPK_inj : Function.Injective (algebraMap P K_k) := IsFractionRing.injective P K_k
  have hKΩ_inj : Function.Injective (algebraMap K_k Ω) := (algebraMap K_k Ω).injective
  have hPΩ_inj : Function.Injective (algebraMap P Ω) := by
    intro a b hab
    apply hPK_inj
    apply hKΩ_inj
    simpa only [← IsScalarTower.algebraMap_apply P K_k Ω] using hab
  let ι_k : k →+* Ω := (algebraMap P Ω).comp Polynomial.C
  have hι_k_inj : Function.Injective ι_k := hPΩ_inj.comp Polynomial.C_injective
  have hγ_fix_P : ∀ (γ : Ω ≃ₐ[K_k] Ω) (p : P), γ (algebraMap P Ω p) = algebraMap P Ω p := by
    intro γ p
    rw [IsScalarTower.algebraMap_apply P K_k Ω]
    exact γ.commutes _
  have hγ_fix_k : ∀ (γ : Ω ≃ₐ[K_k] Ω) (c : k), γ (ι_k c) = ι_k c :=
    fun γ c => hγ_fix_P γ (Polynomial.C c)
  let X_Ω : Ω := algebraMap P Ω Polynomial.X
  have hX_Ω_ne : X_Ω ≠ 0 :=
    fun h => Polynomial.X_ne_zero (hPΩ_inj (h.trans (map_zero _).symm))
  have hC_mem : ∀ c : k, ι_k c ∈ V_s := fun c => (hC_mem_π c).choose
  let ι_k_Vs : k →+* ↥V_s :=
    { toFun := fun c => ⟨ι_k c, hC_mem c⟩
      map_one' := Subtype.ext (map_one ι_k)
      map_mul' := fun _ _ => Subtype.ext (map_mul ι_k _ _)
      map_zero' := Subtype.ext (map_zero ι_k)
      map_add' := fun _ _ => Subtype.ext (map_add ι_k _ _) }
  have hπ_ιk : ∀ c : k, π_Vs (ι_k_Vs c) = c := fun c => (hC_mem_π c).choose_spec

  obtain ⟨τ, ζ, t_ℓ, hτ_succ, hτ_pow, hτ_ne, hτ_mem, hτ_max,
      hζ_prim, hζ_succ, ht_one, ht_mul, ht_act, ht_ker⟩ :
      ∃ (τ : ℕ → Ω) (ζ : ℕ → k) (t_ℓ : ↥I_Vs → PadicInt ℓ),
        (∀ r : ℕ, (τ (r + 1)) ^ ℓ = τ r) ∧
        (∀ r : ℕ, (τ r) ^ (ℓ ^ (r + 1)) = X_Ω) ∧
        (∀ r : ℕ, τ r ≠ 0) ∧
        (∀ r : ℕ, τ r ∈ V_s) ∧
        (∀ r : ℕ, ∀ h : τ r ∈ V_s, (⟨τ r, h⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s) ∧
        (∀ r : ℕ, IsPrimitiveRoot (ζ r) (ℓ ^ (r + 1))) ∧
        (∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r) ∧
        t_ℓ 1 = 0 ∧
        (∀ γ₁ γ₂ : ↥I_Vs, t_ℓ (γ₁ * γ₂) = t_ℓ γ₁ + t_ℓ γ₂) ∧
        (∀ (r : ℕ) (γ : ↥I_Vs),
          γ.1 (τ r) = ι_k ((ζ r) ^ (PadicInt.toZModPow (r + 1) (t_ℓ γ)).val) * τ r) ∧
        (∀ (r : ℕ) (γ : ↥I_Vs),
          PadicInt.toZModPow (r + 1) (t_ℓ γ) = 0 ↔ γ.1 (τ r) = τ r) := by
    have hτ0_ex : ∃ z : Ω, z ^ ℓ = X_Ω := IsAlgClosed.exists_pow_nat_eq X_Ω hℓ_pos
    let τ : ℕ → Ω := fun r =>
      Nat.rec (Classical.choose hτ0_ex)
        (fun _ prev => Classical.choose (IsAlgClosed.exists_pow_nat_eq prev hℓ_pos)) r
    have hτ_zero : (τ 0) ^ ℓ = X_Ω := Classical.choose_spec hτ0_ex
    have hτ_succ : ∀ r : ℕ, (τ (r + 1)) ^ ℓ = τ r :=
      fun r => Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq (τ r) hℓ_pos)
    have hτ_pow : ∀ r : ℕ, (τ r) ^ (ℓ ^ (r + 1)) = X_Ω := by
      intro r
      induction r with
      | zero => rw [pow_one]; exact hτ_zero
      | succ r ih => rw [pow_succ', pow_mul, hτ_succ r, ih]
    have hτ_ne : ∀ r : ℕ, τ r ≠ 0 :=
      fun r h0 => hX_Ω_ne (by rw [← hτ_pow r, h0, zero_pow (pow_ne_zero _ hℓ_pos.ne')])
    have hτ_mem : ∀ r : ℕ, τ r ∈ V_s := by
      intro r
      rcases ValuationSubring.mem_or_inv_mem V_s (τ r) with h | hinv
      · exact h
      · exfalso
        let u_inv : ↥V_s := ⟨(τ r)⁻¹, hinv⟩
        have hu : (⟨X_Ω, hX_mem⟩ : ↥V_s) * u_inv ^ (ℓ ^ (r + 1)) = 1 := by
          apply Subtype.ext
          change X_Ω * ((τ r)⁻¹) ^ (ℓ ^ (r + 1)) = 1
          rw [← hτ_pow r, inv_pow]
          exact mul_inv_cancel₀ (pow_ne_zero _ (hτ_ne r))
        have hX_unit : IsUnit (⟨X_Ω, hX_mem⟩ : ↥V_s) :=
          ⟨⟨_, _, hu, by rw [mul_comm, hu]⟩, rfl⟩
        exact IsLocalRing.notMem_maximalIdeal.mpr hX_unit hX_max
    have hτ_max : ∀ r : ℕ, ∀ h : τ r ∈ V_s, (⟨τ r, h⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s := by
      intro r h
      have hpow_mem : (⟨τ r, h⟩ : ↥V_s) ^ (ℓ ^ (r + 1)) ∈ IsLocalRing.maximalIdeal ↥V_s := by
        convert hX_max using 1
        apply Subtype.ext
        exact hτ_pow r
      exact Ideal.IsPrime.mem_of_pow_mem inferInstance _ hpow_mem

    let g₀ : Polynomial k := Polynomial.X ^ ℓ - 1
    have hg₀_deg : g₀.natDegree = ℓ := by
      dsimp [g₀]
      simpa using (Polynomial.natDegree_X_pow_sub_C (R := k) (n := ℓ) (r := 1))
    have hg₀_ne : g₀ ≠ 0 := by
      intro h
      have := congrArg Polynomial.natDegree h
      rw [hg₀_deg, Polynomial.natDegree_zero] at this
      omega
    have hg₀_sep : g₀.Separable := by
      change IsCoprime g₀ (Polynomial.derivative g₀)
      have hderiv : Polynomial.derivative g₀ = Polynomial.C (ℓ : k) * Polynomial.X ^ (ℓ - 1) := by
        dsimp [g₀]
        rw [map_sub, Polynomial.derivative_one, sub_zero, Polynomial.derivative_X_pow,
          Polynomial.C_eq_natCast]
      refine ⟨-1, Polynomial.C ((ℓ : k)⁻¹) * Polynomial.X, ?_⟩
      rw [hderiv]
      have hX : Polynomial.X * (Polynomial.C (ℓ : k) * Polynomial.X ^ (ℓ - 1)) =
          Polynomial.C (ℓ : k) * Polynomial.X ^ ℓ := by
        calc
          Polynomial.X * (Polynomial.C (ℓ : k) * Polynomial.X ^ (ℓ - 1)) =
              Polynomial.C (ℓ : k) * (Polynomial.X * Polynomial.X ^ (ℓ - 1)) := by ring
          _ = Polynomial.C (ℓ : k) * Polynomial.X ^ ((ℓ - 1) + 1) := by rw [← pow_succ']
          _ = Polynomial.C (ℓ : k) * Polynomial.X ^ ℓ := by congr 2; omega
      dsimp [g₀]
      calc
        (-1 : Polynomial k) * (Polynomial.X ^ ℓ - 1) +
            (Polynomial.C ((ℓ : k)⁻¹) * Polynomial.X) *
              (Polynomial.C (ℓ : k) * Polynomial.X ^ (ℓ - 1)) =
            -(Polynomial.X ^ ℓ) + 1 +
              Polynomial.C ((ℓ : k)⁻¹) *
                (Polynomial.X * (Polynomial.C (ℓ : k) * Polynomial.X ^ (ℓ - 1))) := by ring
        _ = -(Polynomial.X ^ ℓ) + 1 +
              (Polynomial.C ((ℓ : k)⁻¹) * Polynomial.C (ℓ : k)) * Polynomial.X ^ ℓ := by
            rw [hX, mul_assoc]
        _ = 1 := by
            rw [← Polynomial.C_mul, inv_mul_cancel₀ hℓ_k, Polynomial.C_1, one_mul]
            ring
    have hcard_roots : g₀.roots.toFinset.card = ℓ := by
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hg₀_sep),
        ← (IsAlgClosed.splits g₀).natDegree_eq_card_roots, hg₀_deg]
    have hex_ζ₀ : ∃ z : k, z ∈ g₀.roots.toFinset \ {1} := by
      apply Finset.nonempty_iff_ne_empty.mpr
      intro hemp
      have hsub : g₀.roots.toFinset ⊆ {1} := Finset.sdiff_eq_empty_iff_subset.mp hemp
      have hle := Finset.card_le_card hsub
      rw [hcard_roots, Finset.card_singleton] at hle
      omega
    obtain ⟨ζ₀, hζ₀_mem⟩ := hex_ζ₀
    rw [Finset.mem_sdiff, Multiset.mem_toFinset, Polynomial.mem_roots hg₀_ne,
      Polynomial.IsRoot.def, Finset.mem_singleton] at hζ₀_mem
    have hζ₀_pow : ζ₀ ^ ℓ = 1 := by
      have h0 := hζ₀_mem.1
      dsimp [g₀] at h0
      rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one] at h0
      exact sub_eq_zero.mp h0
    have hζ₀_prim : IsPrimitiveRoot ζ₀ ℓ := by
      rw [IsPrimitiveRoot.iff_def]
      refine ⟨hζ₀_pow, fun m hm => ?_⟩
      have hdvd_ℓ : orderOf ζ₀ ∣ ℓ := orderOf_dvd_of_pow_eq_one hζ₀_pow
      rcases hℓ_prime.eq_one_or_self_of_dvd (orderOf ζ₀) hdvd_ℓ with h1 | heq
      · exfalso; exact hζ₀_mem.2 (orderOf_eq_one_iff.mp h1)
      · rw [← heq]; exact orderOf_dvd_of_pow_eq_one hm
    let ζ : ℕ → k := fun r =>
      Nat.rec ζ₀ (fun _ prev => Classical.choose (IsAlgClosed.exists_pow_nat_eq prev hℓ_pos)) r
    have hζ_succ : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r :=
      fun r => Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq (ζ r) hℓ_pos)
    have hζ_prim : ∀ r : ℕ, IsPrimitiveRoot (ζ r) (ℓ ^ (r + 1)) := by
      intro r
      induction r with
      | zero =>
        change IsPrimitiveRoot ζ₀ (ℓ ^ 1)
        rwa [pow_one]
      | succ r ih =>
        rw [IsPrimitiveRoot.iff_def]
        have hpow1 : (ζ (r + 1)) ^ (ℓ ^ (r + 2)) = 1 := by
          rw [show ℓ ^ (r + 2) = ℓ * ℓ ^ (r + 1) from pow_succ' ℓ (r + 1),
            pow_mul, hζ_succ r, ih.pow_eq_one]
        have hne1 : (ζ (r + 1)) ^ (ℓ ^ (r + 1)) ≠ 1 := by
          rw [show ℓ ^ (r + 1) = ℓ * ℓ ^ r from pow_succ' ℓ r, pow_mul, hζ_succ r]
          intro h1
          have hdvd := (ih.pow_eq_one_iff_dvd (ℓ ^ r)).mp h1
          have hlt : ℓ ^ r < ℓ ^ (r + 1) :=
            Nat.pow_lt_pow_right hℓ_prime.one_lt (Nat.lt_succ_self r)
          exact Nat.not_le_of_lt hlt (Nat.le_of_dvd (pow_pos hℓ_pos r) hdvd)
        refine ⟨hpow1, fun m hm => ?_⟩
        have hord_dvd : orderOf (ζ (r + 1)) ∣ ℓ ^ (r + 2) := orderOf_dvd_of_pow_eq_one hpow1
        obtain ⟨j, _, hj_eq⟩ := (Nat.dvd_prime_pow hℓ_prime).mp hord_dvd
        have hj_eq_top : j = r + 2 := by
          by_contra hne
          have hj_le' : j ≤ r + 1 := by omega
          have hdvd_prev : orderOf (ζ (r + 1)) ∣ ℓ ^ (r + 1) := by
            rw [hj_eq]
            exact pow_dvd_pow ℓ hj_le'
          rcases hdvd_prev with ⟨q, hq⟩
          apply hne1
          rw [hq, pow_mul, pow_orderOf_eq_one, one_pow]
        rw [← hj_eq_top, ← hj_eq]
        exact orderOf_dvd_of_pow_eq_one hm

    let ω : ℕ → Ω := fun r => ι_k (ζ r)
    have hω_prim : ∀ r : ℕ, IsPrimitiveRoot (ω r) (ℓ ^ (r + 1)) :=
      fun r => (hζ_prim r).map_of_injective hι_k_inj
    have hω_succ : ∀ r : ℕ, (ω (r + 1)) ^ ℓ = ω r := by
      intro r
      dsimp [ω]
      rw [← map_pow, hζ_succ r]
    let φ : ∀ r : ℕ, ZMod (ℓ ^ (r + 1)) → Ω := fun r a => (ω r) ^ a.val
    have hφ_natCast : ∀ (r m : ℕ), (ω r) ^ m = φ r (m : ZMod (ℓ ^ (r + 1))) := by
      intro r m
      dsimp [φ]
      rw [ZMod.val_natCast]
      conv_lhs => rw [(Nat.div_add_mod m (ℓ ^ (r + 1))).symm]
      rw [pow_add, pow_mul, (hω_prim r).pow_eq_one, one_pow, one_mul]
    have hφ_zero : ∀ r : ℕ, φ r 0 = 1 := by
      intro r
      dsimp [φ]
      rw [ZMod.val_zero, pow_zero]
    have hφ_add : ∀ (r : ℕ) (a b : ZMod (ℓ ^ (r + 1))), φ r (a + b) = φ r a * φ r b := by
      intro r a b
      let _ : NeZero (ℓ ^ (r + 1)) := hNeZeroPow (r + 1)
      dsimp [φ]
      rw [← pow_add, hφ_natCast r (a.val + b.val), Nat.cast_add,
        ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    have hφ_inj : ∀ r : ℕ, Function.Injective (φ r) := by
      intro r
      let _ : NeZero (ℓ ^ (r + 1)) := hNeZeroPow (r + 1)
      have hω_ne : ω r ≠ 0 := by
        intro h0
        have h1 := (hω_prim r).pow_eq_one
        rw [h0, zero_pow (pow_ne_zero _ hℓ_pos.ne')] at h1
        exact zero_ne_one h1
      have haux : ∀ {a b : ZMod (ℓ ^ (r + 1))}, a.val ≤ b.val → φ r a = φ r b → a = b := by
        intro a b hle heq
        dsimp [φ] at heq
        have hsub : b.val = a.val + (b.val - a.val) := (Nat.add_sub_of_le hle).symm
        have heq' : (ω r) ^ a.val * 1 = (ω r) ^ a.val * (ω r) ^ (b.val - a.val) := by
          rw [mul_one, ← pow_add, ← hsub, heq]
        have hpow1 : (ω r) ^ (b.val - a.val) = 1 :=
          (mul_left_cancel₀ (pow_ne_zero a.val hω_ne) heq').symm
        have hdvd : ℓ ^ (r + 1) ∣ b.val - a.val :=
          ((hω_prim r).pow_eq_one_iff_dvd _).mp hpow1
        have hlt : b.val - a.val < ℓ ^ (r + 1) :=
          Nat.lt_of_le_of_lt (Nat.sub_le b.val a.val) (ZMod.val_lt b)
        have hdiff0 : b.val - a.val = 0 := by
          rcases Nat.eq_zero_or_pos (b.val - a.val) with h0 | hpos
          · exact h0
          · exfalso; exact Nat.not_le_of_lt hlt (Nat.le_of_dvd hpos hdvd)
        exact ZMod.val_injective _ (by omega)
      intro a b hab
      rcases le_total a.val b.val with hle | hle
      · exact haux hle hab
      · exact (haux hle hab.symm).symm
    have hφ_surj : ∀ (r : ℕ) (ξ : Ω), ξ ^ (ℓ ^ (r + 1)) = 1 → ∃ a : ZMod (ℓ ^ (r + 1)), φ r a = ξ := by
      intro r ξ hξ
      let N_r := ℓ ^ (r + 1)
      let _ : NeZero N_r := hNeZeroPow (r + 1)
      let P_Ω : Polynomial Ω := Polynomial.X ^ N_r - 1
      have hPΩ_deg : P_Ω.natDegree = N_r := by
        dsimp [P_Ω]
        simpa using (Polynomial.natDegree_X_pow_sub_C (R := Ω) (n := N_r) (r := 1))
      have hPΩ_ne : P_Ω ≠ 0 := by
        intro h
        have := congrArg Polynomial.natDegree h
        rw [hPΩ_deg, Polynomial.natDegree_zero] at this
        exact (NeZero.ne N_r) this
      let S_r : Finset Ω := Finset.univ.image (φ r)
      have hS_card : S_r.card = N_r := by
        rw [Finset.card_image_of_injective _ (hφ_inj r), Finset.card_univ, ZMod.card]
      have hS_sub : S_r ⊆ P_Ω.roots.toFinset := by
        intro z hz
        rw [Finset.mem_image] at hz
        obtain ⟨a, _, rfl⟩ := hz
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hPΩ_ne, Polynomial.IsRoot.def]
        dsimp [P_Ω, φ]
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one,
          ← pow_mul, mul_comm, pow_mul, (hω_prim r).pow_eq_one, one_pow, sub_self]
      have hR_le : P_Ω.roots.toFinset.card ≤ N_r :=
        (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' P_Ω).trans hPΩ_deg.le)
      have hSR_eq : S_r = P_Ω.roots.toFinset :=
        Finset.eq_of_subset_of_card_le hS_sub (hR_le.trans hS_card.symm.le)
      have hξ_mem : ξ ∈ P_Ω.roots.toFinset := by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hPΩ_ne, Polynomial.IsRoot.def]
        dsimp [P_Ω]
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one,
          hξ, sub_self]
      rw [← hSR_eq, Finset.mem_image] at hξ_mem
      obtain ⟨a, _, ha⟩ := hξ_mem
      exact ⟨a, ha⟩

    have hCocycle_ex : ∀ (r : ℕ) (γ : ↥I_Vs),
        ∃ a : ZMod (ℓ ^ (r + 1)), γ.1 (τ r) = φ r a * τ r := by
      intro r γ
      have hpow : (γ.1 (τ r) / τ r) ^ (ℓ ^ (r + 1)) = 1 := by
        rw [div_pow, ← map_pow, hτ_pow r, hγ_fix_P γ.1 Polynomial.X, div_self hX_Ω_ne]
      obtain ⟨a, ha⟩ := hφ_surj r (γ.1 (τ r) / τ r) hpow
      exact ⟨a, by rw [ha, div_mul_cancel₀ _ (hτ_ne r)]⟩
    let a_coc : ∀ r : ℕ, ↥I_Vs → ZMod (ℓ ^ (r + 1)) :=
      fun r γ => Classical.choose (hCocycle_ex r γ)
    have ha_spec : ∀ (r : ℕ) (γ : ↥I_Vs), γ.1 (τ r) = φ r (a_coc r γ) * τ r :=
      fun r γ => Classical.choose_spec (hCocycle_ex r γ)
    have ha_one : ∀ r : ℕ, a_coc r 1 = 0 := by
      intro r
      apply hφ_inj r
      apply mul_right_cancel₀ (hτ_ne r)
      rw [← ha_spec r 1, hφ_zero r, one_mul]
      rfl
    have ha_mul : ∀ (r : ℕ) (γ₁ γ₂ : ↥I_Vs),
        a_coc r (γ₁ * γ₂) = a_coc r γ₁ + a_coc r γ₂ := by
      intro r γ₁ γ₂
      apply hφ_inj r
      apply mul_right_cancel₀ (hτ_ne r)
      rw [← ha_spec r (γ₁ * γ₂), hφ_add]
      change γ₁.1 (γ₂.1 (τ r)) = φ r (a_coc r γ₁) * φ r (a_coc r γ₂) * τ r
      rw [ha_spec r γ₂, map_mul, ha_spec r γ₁]
      have hfix_φ : γ₁.1 (φ r (a_coc r γ₂)) = φ r (a_coc r γ₂) := by
        dsimp [φ, ω]
        rw [← map_pow]
        exact hγ_fix_k γ₁.1 _
      rw [hfix_φ]
      ring
    have ha_compat : ∀ (r : ℕ) (γ : ↥I_Vs),
        ((ℓ : ℤ) ^ (r + 1)) ∣ ((a_coc (r + 1) γ).val : ℤ) - ((a_coc r γ).val : ℤ) := by
      intro r γ
      let _ : NeZero (ℓ ^ (r + 1)) := hNeZeroPow (r + 1)
      have h1 : φ r (a_coc r γ) * τ r = φ r ((a_coc (r + 1) γ).val : ZMod (ℓ ^ (r + 1))) * τ r := by
        rw [← ha_spec r γ, ← hτ_succ r, map_pow, ha_spec (r + 1) γ, mul_pow, hτ_succ r]
        congr 1
        dsimp [φ]
        rw [← pow_mul, mul_comm, pow_mul, hω_succ r, hφ_natCast r]
      have h2 : ((a_coc (r + 1) γ).val : ZMod (ℓ ^ (r + 1))) = a_coc r γ :=
        hφ_inj r (mul_right_cancel₀ (hτ_ne r) h1.symm)
      have h3 : ((((a_coc (r + 1) γ).val : ℤ) - ((a_coc r γ).val : ℤ) : ℤ) :
          ZMod (ℓ ^ (r + 1))) = 0 := by
        push_cast
        rw [h2, ZMod.natCast_zmod_val, sub_self]
      simpa only [Nat.cast_pow] using (ZMod.intCast_zmod_eq_zero_iff_dvd _ (ℓ ^ (r + 1))).mp h3

    let f_seq : ↥I_Vs → ℕ → ℤ := fun γ n =>
      match n with
      | 0 => 0
      | r + 1 => ((a_coc r γ).val : ℤ)
    have hf_dvd : ∀ (γ : ↥I_Vs) (i : ℕ), (ℓ : ℤ) ^ i ∣ f_seq γ (i + 1) - f_seq γ i := by
      intro γ i
      cases i with
      | zero => simp [f_seq]
      | succ r => exact ha_compat r γ
    let t_ℓ : ↥I_Vs → PadicInt ℓ := fun γ =>
      PadicInt.ofIntSeq (f_seq γ) (PadicInt.isCauSeq_padicNorm_of_pow_dvd_sub (f_seq γ) ℓ (hf_dvd γ))
    have ht_proj : ∀ (r : ℕ) (γ : ↥I_Vs),
        PadicInt.toZModPow (r + 1) (t_ℓ γ) = a_coc r γ := by
      intro r γ
      let _ : NeZero (ℓ ^ (r + 1)) := hNeZeroPow (r + 1)
      have h := PadicInt.toZModPow_ofIntSeq_of_pow_dvd_sub (f_seq γ) ℓ (hf_dvd γ) (r + 1)
      dsimp [t_ℓ]
      rw [h]
      change (((a_coc r γ).val : ℤ) : ZMod (ℓ ^ (r + 1))) = a_coc r γ
      rw [Int.cast_natCast, ZMod.natCast_zmod_val]
    have ht_one : t_ℓ 1 = 0 := by
      apply PadicInt.ext_of_toZModPow.mp
      intro n
      cases n with
      | zero => exact hZMod0_eq _ _
      | succ r => rw [ht_proj r 1, ha_one r, map_zero]
    have ht_mul : ∀ γ₁ γ₂ : ↥I_Vs, t_ℓ (γ₁ * γ₂) = t_ℓ γ₁ + t_ℓ γ₂ := by
      intro γ₁ γ₂
      apply PadicInt.ext_of_toZModPow.mp
      intro n
      cases n with
      | zero => exact hZMod0_eq _ _
      | succ r => rw [map_add, ht_proj r (γ₁ * γ₂), ht_proj r γ₁, ht_proj r γ₂, ha_mul r γ₁ γ₂]
    have ht_act : ∀ (r : ℕ) (γ : ↥I_Vs),
        γ.1 (τ r) = ι_k ((ζ r) ^ (PadicInt.toZModPow (r + 1) (t_ℓ γ)).val) * τ r := by
      intro r γ
      rw [ht_proj r γ, map_pow]
      exact ha_spec r γ
    have ht_ker : ∀ (r : ℕ) (γ : ↥I_Vs),
        PadicInt.toZModPow (r + 1) (t_ℓ γ) = 0 ↔ γ.1 (τ r) = τ r := by
      intro r γ
      rw [ht_proj r γ]
      constructor
      · intro h0
        rw [ha_spec r γ, h0, hφ_zero r, one_mul]
      · intro hfix
        apply hφ_inj r
        apply mul_right_cancel₀ (hτ_ne r)
        rw [← ha_spec r γ, hfix, hφ_zero r, one_mul]
    exact ⟨τ, ζ, t_ℓ, hτ_succ, hτ_pow, hτ_ne, hτ_mem, hτ_max,
      hζ_prim, hζ_succ, ht_one, ht_mul, ht_act, ht_ker⟩

  have ht_surj : Function.Surjective t_ℓ := by
    let HasOrdAtZero : P → ℕ → Prop :=
      fun f m => ∃ q : P, f = Polynomial.X ^ m * q ∧ Polynomial.eval 0 q ≠ 0
    have hHasOrd : ∀ {f : P}, f ≠ 0 → HasOrdAtZero f f.natTrailingDegree := by
      intro f hf
      have hdvd : Polynomial.X ^ f.natTrailingDegree ∣ f :=
        Polynomial.X_pow_dvd_iff.mpr fun d hd => Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hd
      rcases hdvd with ⟨q, hfq⟩
      refine ⟨q, hfq, ?_⟩
      rw [← Polynomial.coeff_zero_eq_eval_zero,
        ← Polynomial.coeff_X_pow_mul q f.natTrailingDegree 0, zero_add, ← hfq]
      exact Polynomial.trailingCoeff_nonzero_iff_nonzero.mpr hf

    let ψ_Vs : ∀ r : ℕ, P →+* ↥V_s :=
      fun r => Polynomial.eval₂RingHom ι_k_Vs ⟨τ r, hτ_mem r⟩
    let ψ : ∀ r : ℕ, P →+* Ω :=
      fun r => V_s.subtype.comp (ψ_Vs r)
    have hψ_C : ∀ (r : ℕ) (c : k), ψ r (Polynomial.C c) = ι_k c := fun r c => by
      change V_s.subtype (Polynomial.eval₂ ι_k_Vs ⟨τ r, hτ_mem r⟩ (Polynomial.C c)) = ι_k c
      rw [Polynomial.eval₂_C]
      rfl
    have hψ_X : ∀ r : ℕ, ψ r Polynomial.X = τ r := fun r => by
      change V_s.subtype (Polynomial.eval₂ ι_k_Vs ⟨τ r, hτ_mem r⟩ Polynomial.X) = τ r
      rw [Polynomial.eval₂_X]
      rfl
    let ι_P : ∀ r : ℕ, P →+* P :=
      fun r => Polynomial.eval₂RingHom Polynomial.C (Polynomial.X ^ (ℓ ^ (r + 1)))
    have hπ_ψ : ∀ r : ℕ, π_Vs.comp (ψ_Vs r) = Polynomial.evalRingHom 0 := by
      intro r
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, ψ_Vs, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C, hπ_ιk]
      · simp only [RingHom.comp_apply, ψ_Vs, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          Polynomial.coe_evalRingHom, Polynomial.eval_X]
        rw [← RingHom.mem_ker, hπ_ker]
        exact hτ_max r (hτ_mem r)
    have hψ_ι : ∀ r : ℕ, (ψ r).comp (ι_P r) = algebraMap P Ω := by
      intro r
      apply Polynomial.ringHom_ext'
      · ext c
        change ψ r (ι_P r (Polynomial.C c)) = algebraMap P Ω (Polynomial.C c)
        have h1 : ι_P r (Polynomial.C c) = Polynomial.C c := Polynomial.eval₂_C _ _
        rw [h1, hψ_C r c]
        rfl
      · change ψ r (ι_P r Polynomial.X) = X_Ω
        have h1 : ι_P r Polynomial.X = Polynomial.X ^ (ℓ ^ (r + 1)) := Polynomial.eval₂_X _ _
        rw [h1, map_pow, hψ_X r, hτ_pow r]
    have hψ_q_unit : ∀ (r : ℕ) {q : P}, Polynomial.eval 0 q ≠ 0 → IsUnit (ψ_Vs r q) := by
      intro r q hq0
      apply IsLocalRing.notMem_maximalIdeal.mp
      rw [← hπ_ker, RingHom.mem_ker]
      have heq := RingHom.congr_fun (hπ_ψ r) q
      simpa only [RingHom.comp_apply, Polynomial.coe_evalRingHom] using fun h => hq0 (heq.symm.trans h)
    have hψ_inj : ∀ r : ℕ, Function.Injective (ψ r) := by
      intro r
      rw [injective_iff_map_eq_zero]
      intro f hf0
      by_contra hf_ne
      obtain ⟨q, hfq, hq0⟩ := hHasOrd hf_ne
      have hunit : IsUnit (ψ_Vs r q) := hψ_q_unit r hq0
      have hq_ne : ψ r q ≠ 0 := by
        intro h0
        have h0' : ψ_Vs r q = 0 := Subtype.ext h0
        exact hunit.ne_zero h0'
      rw [hfq, map_mul, map_pow, hψ_X r] at hf0
      exact mul_ne_zero (pow_ne_zero _ (hτ_ne r)) hq_ne hf0
    have hValCrit : ∀ (r : ℕ) {f g : P} {mf mg : ℕ},
        HasOrdAtZero f mf → HasOrdAtZero g mg → (ψ r f / ψ r g ∈ V_s ↔ mg ≤ mf) := by
      intro r f g mf mg ⟨qf, hfq, hqf0⟩ ⟨qg, hgq, hqg0⟩
      obtain ⟨uf, huf⟩ := hψ_q_unit r hqf0
      obtain ⟨ug, hug⟩ := hψ_q_unit r hqg0
      let u_rat : (↥V_s)ˣ := uf * ug⁻¹
      have hu_val : ((u_rat : ↥V_s) : Ω) = ψ r qf * (ψ r qg)⁻¹ := by
        have h1 : (uf : ↥V_s).1 = ψ r qf := congrArg Subtype.val huf
        have h2 : (ug : ↥V_s).1 = ψ r qg := congrArg Subtype.val hug
        have h3 : ((ug⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * (ug : ↥V_s).1 = 1 :=
          congrArg Subtype.val ug.inv_mul
        have h2_ne : ψ r qg ≠ 0 := fun h0 => by rw [h2, h0, mul_zero] at h3; exact zero_ne_one h3
        have hinv : ((ug⁻¹ : (↥V_s)ˣ) : ↥V_s).1 = (ψ r qg)⁻¹ :=
          mul_right_cancel₀ h2_ne (by rw [inv_mul_cancel₀ h2_ne, ← h2, h3])
        change (uf : ↥V_s).1 * ((ug⁻¹ : (↥V_s)ˣ) : ↥V_s).1 = _
        rw [h1, hinv]
      have hdiv_eq : ψ r f / ψ r g =
          ((τ r) ^ mf * ((τ r) ^ mg)⁻¹) * ((u_rat : ↥V_s) : Ω) := by
        rw [hfq, hgq, map_mul, map_mul, map_pow, map_pow, hψ_X r, div_eq_mul_inv, mul_inv, hu_val]
        ring
      rw [hdiv_eq]
      have hunit_iff : ∀ z : Ω, z * ((u_rat : ↥V_s) : Ω) ∈ V_s ↔ z ∈ V_s := by
        intro z
        constructor
        · intro hz
          have hmul := mul_mem hz ((u_rat⁻¹ : (↥V_s)ˣ) : ↥V_s).2
          have hcancel : ((u_rat : ↥V_s) : Ω) * (((u_rat⁻¹ : (↥V_s)ˣ) : ↥V_s) : Ω) = 1 :=
            congrArg Subtype.val u_rat.mul_inv
          rwa [mul_assoc, hcancel, mul_one] at hmul
        · intro hz
          exact mul_mem hz (u_rat : ↥V_s).2
      rw [hunit_iff]
      constructor
      · intro hmem
        by_contra hlt
        have hlt' : mf < mg := Nat.lt_of_not_ge hlt
        have hmg : mg = mf + (mg - mf) := (Nat.add_sub_of_le hlt'.le).symm
        have hpow_eq : (τ r) ^ mf * ((τ r) ^ mg)⁻¹ = (((τ r) ^ (mg - mf))⁻¹) := by
          conv_lhs => rw [hmg, pow_add, mul_inv, ← mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero mf (hτ_ne r)), one_mul]
        rw [hpow_eq] at hmem
        let w_inv : ↥V_s := ⟨((τ r) ^ (mg - mf))⁻¹, hmem⟩
        have hw1 : (⟨τ r, hτ_mem r⟩ : ↥V_s) ^ (mg - mf) * w_inv = 1 := by
          apply Subtype.ext
          exact mul_inv_cancel₀ (pow_ne_zero _ (hτ_ne r))
        have hpos : 0 < mg - mf := by omega
        have hmax_pow : (⟨τ r, hτ_mem r⟩ : ↥V_s) ^ (mg - mf) ∈ IsLocalRing.maximalIdeal ↥V_s :=
          Ideal.pow_mem_of_mem _ (hτ_max r (hτ_mem r)) _ hpos
        have hw_unit : IsUnit ((⟨τ r, hτ_mem r⟩ : ↥V_s) ^ (mg - mf)) :=
          ⟨⟨_, w_inv, hw1, by rw [mul_comm, hw1]⟩, rfl⟩
        exact IsLocalRing.notMem_maximalIdeal.mpr hw_unit hmax_pow
      · intro hle
        have hmf : mf = (mf - mg) + mg := (Nat.sub_add_cancel hle).symm
        have hpow_eq : (τ r) ^ mf * ((τ r) ^ mg)⁻¹ = (τ r) ^ (mf - mg) := by
          conv_lhs => rw [hmf, pow_add, mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero mg (hτ_ne r)), mul_one]
        rw [hpow_eq]
        exact pow_mem (hτ_mem r) (mf - mg)

    intro t
    let u : ℕ → k := fun r => (ζ r) ^ (PadicInt.toZModPow (r + 1) t).val
    have hu_pow : ∀ r : ℕ, (u r) ^ (ℓ ^ (r + 1)) = 1 := by
      intro r
      dsimp [u]
      rw [← pow_mul, mul_comm, pow_mul, (hζ_prim r).pow_eq_one, one_pow]
    have hu_ne : ∀ r : ℕ, u r ≠ 0 := by
      intro r h0
      have h1 := hu_pow r
      rw [h0, zero_pow (pow_ne_zero _ hℓ_pos.ne')] at h1
      exact zero_ne_one h1
    have hu_succ : ∀ r : ℕ, (u (r + 1)) ^ ℓ = u r := by
      intro r
      let _ : NeZero (ℓ ^ (r + 1)) := hNeZeroPow (r + 1)
      let _ : NeZero (ℓ ^ (r + 2)) := hNeZeroPow (r + 2)
      dsimp [u]
      rw [← pow_mul, mul_comm, pow_mul, hζ_succ r]
      have hcast := RingHom.congr_fun
        (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) (r + 1) (r + 2) (Nat.le_succ (r + 1))) t
      simp only [RingHom.comp_apply, ZMod.castHom_apply] at hcast
      have hcast' : (((PadicInt.toZModPow (r + 2) t).val : ℕ) : ZMod (ℓ ^ (r + 1))) =
          PadicInt.toZModPow (r + 1) t := by
        rw [← hcast]
        conv_rhs => rw [← ZMod.natCast_zmod_val (PadicInt.toZModPow (r + 2) t)]
        exact (ZMod.cast_natCast (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _).symm
      have hval_mod : (PadicInt.toZModPow (r + 2) t).val % (ℓ ^ (r + 1)) =
          (PadicInt.toZModPow (r + 1) t).val := by
        rw [← ZMod.val_natCast, hcast']
      conv_lhs => rw [(Nat.div_add_mod (PadicInt.toZModPow (r + 2) t).val (ℓ ^ (r + 1))).symm]
      rw [pow_add, pow_mul, (hζ_prim r).pow_eq_one, one_pow, one_mul, hval_mod]

    have hψ_units : ∀ (r : ℕ) (y : nonZeroDivisors P), IsUnit (ψ r y) :=
      fun r y => IsUnit.mk0 _ fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp y.2 ((hψ_inj r) (h0.trans (map_zero _).symm))
    let Ψ : ∀ r : ℕ, K_k →+* Ω := fun r => IsLocalization.lift (S := K_k) (hψ_units r)
    have hΨ_eq : ∀ (r : ℕ) (f : P), Ψ r (algebraMap P K_k f) = ψ r f :=
      fun r f => IsLocalization.lift_eq (S := K_k) (hψ_units r) f
    have hιP_inj : ∀ r : ℕ, Function.Injective (ι_P r) := fun r =>
      Function.Injective.of_comp (f := ψ r) (by
        change Function.Injective ((ψ r).comp (ι_P r))
        rw [hψ_ι r]
        exact hPΩ_inj)
    let g_ιK : ∀ r : ℕ, P →+* K_k := fun r => (algebraMap P K_k).comp (ι_P r)
    have hιK_units : ∀ (r : ℕ) (y : nonZeroDivisors P), IsUnit (g_ιK r y) :=
      fun r y => IsUnit.mk0 _ fun h0 => by
        have h0' : ι_P r y = 0 := hPK_inj (h0.trans (map_zero (algebraMap P K_k)).symm)
        exact mem_nonZeroDivisors_iff_ne_zero.mp y.2
          (hιP_inj r (h0'.trans (map_zero (ι_P r)).symm))
    let ι_K : ∀ r : ℕ, K_k →+* K_k :=
      fun r => IsLocalization.lift (S := K_k) (g := g_ιK r) (hιK_units r)
    have hΨ_ιK : ∀ r : ℕ, (Ψ r).comp (ι_K r) = algebraMap K_k Ω := by
      intro r
      refine IsLocalization.ringHom_ext (nonZeroDivisors P) ?_
      refine RingHom.ext fun f => ?_
      simp only [RingHom.comp_apply, ι_K, g_ιK, IsLocalization.lift_eq, hΨ_eq,
        ← IsScalarTower.algebraMap_apply P K_k Ω]
      exact RingHom.congr_fun (hψ_ι r) f

    let L : ℕ → IntermediateField K_k Ω := fun r => IntermediateField.adjoin K_k {τ r}
    have hψ_mem_L : ∀ (r : ℕ) (f : P), ψ r f ∈ L r := by
      intro r f
      refine Polynomial.induction_on' f ?_ ?_
      · intro p₁ p₂ h₁ h₂; rw [map_add]; exact (L r).add_mem h₁ h₂
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        have hc : ψ r (Polynomial.C c) ∈ L r := by
          rw [hψ_C r c]
          change algebraMap P Ω (Polynomial.C c) ∈ L r
          rw [IsScalarTower.algebraMap_apply P K_k Ω]
          exact (L r).algebraMap_mem _
        have hX : ψ r Polynomial.X ∈ L r := by
          rw [hψ_X r]
          exact IntermediateField.subset_adjoin K_k {τ r} (Set.mem_singleton (τ r))
        exact (L r).mul_mem hc (pow_mem hX n)
    have hΨ_mem_L : ∀ (r : ℕ) (a : K_k), Ψ r a ∈ L r := by
      intro r a
      obtain ⟨f, g, _, hfg⟩ := IsFractionRing.div_surjective (A := P) a
      rw [← hfg, map_div₀, hΨ_eq r f, hΨ_eq r g]
      exact (L r).div_mem (hψ_mem_L r f) (hψ_mem_L r g)
    have hRange_L : ∀ (r : ℕ) (z : Ω), z ∈ L r → ∃ a : K_k, Ψ r a = z := by
      intro r
      let F_Ψ : IntermediateField K_k Ω :=
        { carrier := Set.range (Ψ r)
          algebraMap_mem' := fun a => ⟨ι_K r a, RingHom.congr_fun (hΨ_ιK r) a⟩
          add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a + b, map_add _ _ _⟩
          mul_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a * b, map_mul _ _ _⟩
          inv_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨a⁻¹, map_inv₀ _ _⟩ }
      have hle : L r ≤ F_Ψ := by
        rw [IntermediateField.adjoin_simple_le_iff]
        exact ⟨algebraMap P K_k Polynomial.X, (hΨ_eq r Polynomial.X).trans (hψ_X r)⟩
      exact fun z hz => hle hz
    let e_L : ∀ r : ℕ, K_k ≃+* ↥(L r) := fun r =>
      RingEquiv.ofBijective ((Ψ r).codRestrict (L r).toSubring (hΨ_mem_L r))
        ⟨fun a b hab => (Ψ r).injective (congrArg Subtype.val hab),
         fun y => by obtain ⟨a, ha⟩ := hRange_L r y.1 y.2; exact ⟨a, Subtype.ext ha⟩⟩

    let α_hom : ∀ r : ℕ, P →+* P :=
      fun r => Polynomial.eval₂RingHom Polynomial.C (Polynomial.C (u r) * Polynomial.X)
    let α_inv : ∀ r : ℕ, P →+* P :=
      fun r => Polynomial.eval₂RingHom Polynomial.C (Polynomial.C ((u r)⁻¹) * Polynomial.X)
    have hα_C : ∀ (r : ℕ) (c : k), α_hom r (Polynomial.C c) = Polynomial.C c :=
      fun _ _ => Polynomial.eval₂_C _ _
    have hα_X : ∀ r : ℕ, α_hom r Polynomial.X = Polynomial.C (u r) * Polynomial.X :=
      fun _ => Polynomial.eval₂_X _ _
    have hαinv_C : ∀ (r : ℕ) (c : k), α_inv r (Polynomial.C c) = Polynomial.C c :=
      fun _ _ => Polynomial.eval₂_C _ _
    have hαinv_X : ∀ r : ℕ, α_inv r Polynomial.X = Polynomial.C ((u r)⁻¹) * Polynomial.X :=
      fun _ => Polynomial.eval₂_X _ _
    have hα_comp : ∀ r : ℕ, (α_hom r).comp (α_inv r) = RingHom.id P ∧
        (α_inv r).comp (α_hom r) = RingHom.id P := by
      intro r
      constructor
      · apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          change α_hom r (α_inv r (Polynomial.C c)) = Polynomial.C c
          rw [hαinv_C, hα_C]
        · change α_hom r (α_inv r Polynomial.X) = Polynomial.X
          rw [hαinv_X, map_mul, hα_C, hα_X, ← mul_assoc, ← Polynomial.C_mul,
            inv_mul_cancel₀ (hu_ne r), Polynomial.C_1, one_mul]
      · apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          change α_inv r (α_hom r (Polynomial.C c)) = Polynomial.C c
          rw [hα_C, hαinv_C]
        · change α_inv r (α_hom r Polynomial.X) = Polynomial.X
          rw [hα_X, map_mul, hαinv_C, hαinv_X, ← mul_assoc, ← Polynomial.C_mul,
            mul_inv_cancel₀ (hu_ne r), Polynomial.C_1, one_mul]
    have hα_ι : ∀ r : ℕ, (α_hom r).comp (ι_P r) = ι_P r := by
      intro r
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun c => ?_
        change α_hom r (ι_P r (Polynomial.C c)) = ι_P r (Polynomial.C c)
        have h1 : ι_P r (Polynomial.C c) = Polynomial.C c := Polynomial.eval₂_C _ _
        rw [h1, hα_C]
      · change α_hom r (ι_P r Polynomial.X) = ι_P r Polynomial.X
        have h1 : ι_P r Polynomial.X = Polynomial.X ^ (ℓ ^ (r + 1)) := Polynomial.eval₂_X _ _
        rw [h1, map_pow, hα_X, mul_pow, ← Polynomial.C_pow, hu_pow r, Polynomial.C_1, one_mul]
    have hα_ord : ∀ (r : ℕ) {f : P} {m : ℕ}, HasOrdAtZero f m → HasOrdAtZero (α_hom r f) m := by
      intro r f m ⟨q, hfq, hq0⟩
      refine ⟨Polynomial.C ((u r) ^ m) * α_hom r q, ?_, ?_⟩
      · rw [hfq, map_mul, map_pow, hα_X, mul_pow, ← Polynomial.C_pow]
        ring
      · rw [Polynomial.eval_mul, Polynomial.eval_C]
        have hev0 : Polynomial.eval 0 (α_hom r q) = Polynomial.eval 0 q := by
          have hcomp : (Polynomial.evalRingHom (0 : k)).comp (α_hom r) =
              Polynomial.evalRingHom 0 := by
            apply Polynomial.ringHom_ext'
            · refine RingHom.ext fun c => ?_
              change Polynomial.eval 0 (α_hom r (Polynomial.C c)) = Polynomial.eval 0 (Polynomial.C c)
              rw [hα_C]
            · change Polynomial.eval 0 (α_hom r Polynomial.X) = Polynomial.eval 0 Polynomial.X
              rw [hα_X, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, mul_zero]
          exact RingHom.congr_fun hcomp q
        rw [hev0]
        exact mul_ne_zero (pow_ne_zero m (hu_ne r)) hq0

    have hα_inj : ∀ r : ℕ, Function.Injective (α_hom r) := fun r a b hab => by
      have h := RingHom.congr_fun (hα_comp r).2
      simpa using (h a).symm.trans ((congrArg (α_inv r) hab).trans (h b))
    have hα_inv_inj : ∀ r : ℕ, Function.Injective (α_inv r) := fun r a b hab => by
      have h := RingHom.congr_fun (hα_comp r).1
      simpa using (h a).symm.trans ((congrArg (α_hom r) hab).trans (h b))
    let g_αK : ∀ r : ℕ, P →+* K_k := fun r => (algebraMap P K_k).comp (α_hom r)
    let g_αK_inv : ∀ r : ℕ, P →+* K_k := fun r => (algebraMap P K_k).comp (α_inv r)
    have hαK_units : ∀ (r : ℕ) (y : nonZeroDivisors P), IsUnit (g_αK r y) :=
      fun r y => IsUnit.mk0 _ fun h0 => by
        have h0' : α_hom r y = 0 := hPK_inj (h0.trans (map_zero (algebraMap P K_k)).symm)
        exact mem_nonZeroDivisors_iff_ne_zero.mp y.2
          (hα_inj r (h0'.trans (map_zero (α_hom r)).symm))
    have hαK_inv_units : ∀ (r : ℕ) (y : nonZeroDivisors P), IsUnit (g_αK_inv r y) :=
      fun r y => IsUnit.mk0 _ fun h0 => by
        have h0' : α_inv r y = 0 := hPK_inj (h0.trans (map_zero (algebraMap P K_k)).symm)
        exact mem_nonZeroDivisors_iff_ne_zero.mp y.2
          (hα_inv_inj r (h0'.trans (map_zero (α_inv r)).symm))
    let αK_hom : ∀ r : ℕ, K_k →+* K_k :=
      fun r => IsLocalization.lift (S := K_k) (g := g_αK r) (hαK_units r)
    let αK_inv : ∀ r : ℕ, K_k →+* K_k :=
      fun r => IsLocalization.lift (S := K_k) (g := g_αK_inv r) (hαK_inv_units r)
    have hαK_comp : ∀ r : ℕ, (αK_hom r).comp (αK_inv r) = RingHom.id K_k ∧
        (αK_inv r).comp (αK_hom r) = RingHom.id K_k := by
      intro r
      constructor
      · refine IsLocalization.ringHom_ext (nonZeroDivisors P) ?_
        refine RingHom.ext fun f => ?_
        simp only [RingHom.comp_apply, RingHom.id_apply, αK_hom, αK_inv, g_αK, g_αK_inv,
          IsLocalization.lift_eq]
        exact congrArg (algebraMap P K_k) (RingHom.congr_fun (hα_comp r).1 f)
      · refine IsLocalization.ringHom_ext (nonZeroDivisors P) ?_
        refine RingHom.ext fun f => ?_
        simp only [RingHom.comp_apply, RingHom.id_apply, αK_hom, αK_inv, g_αK, g_αK_inv,
          IsLocalization.lift_eq]
        exact congrArg (algebraMap P K_k) (RingHom.congr_fun (hα_comp r).2 f)
    have hαK_ιK : ∀ r : ℕ, (αK_hom r).comp (ι_K r) = ι_K r := by
      intro r
      refine IsLocalization.ringHom_ext (nonZeroDivisors P) ?_
      refine RingHom.ext fun f => ?_
      simp only [RingHom.comp_apply, αK_hom, ι_K, g_αK, g_ιK, IsLocalization.lift_eq]
      exact congrArg (algebraMap P K_k) (RingHom.congr_fun (hα_ι r) f)
    let α_K : ∀ r : ℕ, K_k ≃+* K_k := fun r =>
      { αK_hom r with
        invFun := αK_inv r
        left_inv := fun a => RingHom.congr_fun (hαK_comp r).2 a
        right_inv := fun a => RingHom.congr_fun (hαK_comp r).1 a }

    let σ_L : ∀ r : ℕ, ↥(L r) ≃ₐ[K_k] ↥(L r) := fun r =>
      { ((e_L r).symm.trans ((α_K r).trans (e_L r))) with
        commutes' := fun a => by
          apply Subtype.ext
          change Ψ r (αK_hom r ((e_L r).symm (algebraMap K_k ↥(L r) a))) = algebraMap K_k Ω a
          have hsymm : (e_L r).symm (algebraMap K_k ↥(L r) a) = ι_K r a := by
            apply (e_L r).injective
            rw [RingEquiv.apply_symm_apply]
            apply Subtype.ext
            exact (RingHom.congr_fun (hΨ_ιK r) a).symm
          rw [hsymm, show αK_hom r (ι_K r a) = ι_K r a from RingHom.congr_fun (hαK_ιK r) a]
          exact RingHom.congr_fun (hΨ_ιK r) a }
    have hσ_τ : ∀ r : ℕ,
        (σ_L r ⟨τ r, IntermediateField.subset_adjoin K_k {τ r} rfl⟩ : Ω) =
          ι_k (u r) * τ r := by
      intro r
      change Ψ r (αK_hom r ((e_L r).symm ⟨τ r, _⟩)) = ι_k (u r) * τ r
      have hsymm_X : (e_L r).symm ⟨τ r, IntermediateField.subset_adjoin K_k {τ r} rfl⟩ =
          algebraMap P K_k Polynomial.X := by
        apply (e_L r).injective
        rw [RingEquiv.apply_symm_apply]
        apply Subtype.ext
        exact ((hΨ_eq r Polynomial.X).trans (hψ_X r)).symm
      rw [hsymm_X, show αK_hom r (algebraMap P K_k Polynomial.X) =
            algebraMap P K_k (α_hom r Polynomial.X) from
            IsLocalization.lift_eq (S := K_k) (hαK_units r) Polynomial.X,
        hΨ_eq r, hα_X r, map_mul, hψ_C r, hψ_X r]
    have hσ_Vs : ∀ (r : ℕ) (x : ↥(L r)), (x : Ω) ∈ V_s ↔ (σ_L r x : Ω) ∈ V_s := by
      intro r x
      let a : K_k := (e_L r).symm x
      have hx_eq : (x : Ω) = Ψ r a := by
        have h := congrArg Subtype.val ((e_L r).apply_symm_apply x)
        exact h.symm
      have hσx_eq : (σ_L r x : Ω) = Ψ r (αK_hom r a) := rfl
      rw [hx_eq, hσx_eq]
      obtain ⟨f, g, hg_mem, hfg⟩ := IsFractionRing.div_surjective (A := P) a
      have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hg_mem
      rw [← hfg, map_div₀, map_div₀, map_div₀,
        show αK_hom r (algebraMap P K_k f) = algebraMap P K_k (α_hom r f) from
          IsLocalization.lift_eq (S := K_k) (hαK_units r) f,
        show αK_hom r (algebraMap P K_k g) = algebraMap P K_k (α_hom r g) from
          IsLocalization.lift_eq (S := K_k) (hαK_units r) g,
        hΨ_eq r f, hΨ_eq r g, hΨ_eq r (α_hom r f), hΨ_eq r (α_hom r g)]
      by_cases hf0 : f = 0
      · subst hf0
        simp only [map_zero, zero_div, V_s.zero_mem]
      · have hord_f := hHasOrd hf0
        have hord_g := hHasOrd hg_ne
        rw [hValCrit r hord_f hord_g,
          hValCrit r (hα_ord r hord_f) (hα_ord r hord_g)]

    have hL_step : ∀ r : ℕ, L r ≤ L (r + 1) := by
      intro r
      rw [IntermediateField.adjoin_simple_le_iff, ← hτ_succ r]
      exact pow_mem
        (IntermediateField.subset_adjoin K_k {τ (r + 1)} rfl) ℓ
    have hL_mono : Monotone L := monotone_nat_of_le_succ hL_step
    have hσ_step : ∀ (r : ℕ) (x : ↥(L r)),
        (σ_L (r + 1) ⟨x.1, hL_step r x.2⟩ : Ω) = (σ_L r x : Ω) := by
      intro r
      let inc : ↥(L r) →ₐ[K_k] ↥(L (r + 1)) := IntermediateField.inclusion (hL_step r)
      let f₁ : ↥(L r) →ₐ[K_k] Ω := (L (r + 1)).val.comp ((σ_L (r + 1)).toAlgHom.comp inc)
      let f₂ : ↥(L r) →ₐ[K_k] Ω := (L r).val.comp (σ_L r).toAlgHom
      let EqF : IntermediateField K_k Ω :=
        { carrier := { z : Ω | ∃ hz : z ∈ L r, f₁ ⟨z, hz⟩ = f₂ ⟨z, hz⟩ }
          algebraMap_mem' := fun a =>
            ⟨(L r).algebraMap_mem a, by
              change f₁ (algebraMap K_k ↥(L r) a) = f₂ (algebraMap K_k ↥(L r) a)
              rw [f₁.commutes a, f₂.commutes a]⟩
          add_mem' := by
            rintro _ _ ⟨h₁, e₁⟩ ⟨h₂, e₂⟩
            refine ⟨(L r).add_mem h₁ h₂, ?_⟩
            change f₁ (⟨_, h₁⟩ + ⟨_, h₂⟩) = f₂ (⟨_, h₁⟩ + ⟨_, h₂⟩)
            rw [map_add, map_add, e₁, e₂]
          mul_mem' := by
            rintro _ _ ⟨h₁, e₁⟩ ⟨h₂, e₂⟩
            refine ⟨(L r).mul_mem h₁ h₂, ?_⟩
            change f₁ (⟨_, h₁⟩ * ⟨_, h₂⟩) = f₂ (⟨_, h₁⟩ * ⟨_, h₂⟩)
            rw [map_mul, map_mul, e₁, e₂]
          inv_mem' := by
            rintro _ ⟨h₁, e₁⟩
            refine ⟨(L r).inv_mem h₁, ?_⟩
            change f₁ (⟨_, h₁⟩⁻¹) = f₂ (⟨_, h₁⟩⁻¹)
            rw [map_inv₀, map_inv₀, e₁] }
      have hτ_in : τ r ∈ EqF := by
        have hτ_r : τ r ∈ L r := IntermediateField.subset_adjoin K_k {τ r} rfl
        have hτ_r1 : τ (r + 1) ∈ L (r + 1) := IntermediateField.subset_adjoin K_k {τ (r + 1)} rfl
        refine ⟨hτ_r, ?_⟩
        change (σ_L (r + 1) ⟨τ r, hL_step r hτ_r⟩ : Ω) = (σ_L r ⟨τ r, hτ_r⟩ : Ω)
        have hpow_el : (⟨τ r, hL_step r hτ_r⟩ : ↥(L (r + 1))) =
            (⟨τ (r + 1), hτ_r1⟩ : ↥(L (r + 1))) ^ ℓ :=
          Subtype.ext (hτ_succ r).symm
        rw [hpow_el, map_pow, IntermediateField.coe_pow, hσ_τ (r + 1), mul_pow,
          ← map_pow, hu_succ r, hτ_succ r, hσ_τ r]
      have hle_eq : L r ≤ EqF := IntermediateField.adjoin_simple_le_iff.mpr hτ_in
      intro x
      obtain ⟨_, hx_eq⟩ := hle_eq x.2
      exact hx_eq
    have hσ_compat : ∀ {r s : ℕ} (hrs : r ≤ s) (x : ↥(L r)),
        (σ_L s ⟨x.1, hL_mono hrs x.2⟩ : Ω) = (σ_L r x : Ω) := by
      intro r s hrs
      induction hrs with
      | refl => intro x; rfl
      | @step m hrm ih =>
        intro x
        exact (hσ_step m ⟨x.1, hL_mono hrm x.2⟩).trans (ih x)
    have hσ_symm_compat : ∀ {r s : ℕ} (hrs : r ≤ s) (x : ↥(L r)),
        ((σ_L s).symm ⟨x.1, hL_mono hrs x.2⟩ : Ω) = ((σ_L r).symm x : Ω) := by
      intro r s hrs x
      have h := hσ_compat hrs ((σ_L r).symm x)
      rw [AlgEquiv.apply_symm_apply] at h
      have h' : σ_L s ⟨((σ_L r).symm x : Ω), hL_mono hrs ((σ_L r).symm x).2⟩ =
          ⟨x.1, hL_mono hrs x.2⟩ := Subtype.ext h
      exact congrArg Subtype.val ((σ_L s).symm_apply_eq.mpr h'.symm)

    let M : IntermediateField K_k Ω := ⨆ r : ℕ, L r
    have hM_mem : ∀ z : Ω, z ∈ M ↔ ∃ r : ℕ, z ∈ L r := by
      intro z
      change z ∈ (M : Set Ω) ↔ ∃ r : ℕ, z ∈ (L r : Set Ω)
      rw [IntermediateField.coe_iSup_of_directed hL_mono.directed_le, Set.mem_iUnion]
    let to_M : ↥M → ↥M := fun x =>
      let r := Classical.choose ((hM_mem x.1).mp x.2)
      let hr := Classical.choose_spec ((hM_mem x.1).mp x.2)
      ⟨(σ_L r ⟨x.1, hr⟩ : Ω), (le_iSup L r) (σ_L r ⟨x.1, hr⟩).2⟩
    let inv_M : ↥M → ↥M := fun x =>
      let r := Classical.choose ((hM_mem x.1).mp x.2)
      let hr := Classical.choose_spec ((hM_mem x.1).mp x.2)
      ⟨((σ_L r).symm ⟨x.1, hr⟩ : Ω), (le_iSup L r) ((σ_L r).symm ⟨x.1, hr⟩).2⟩
    have hto_M_eq : ∀ (x : ↥M) (r : ℕ) (hr : x.1 ∈ L r),
        (to_M x : Ω) = (σ_L r ⟨x.1, hr⟩ : Ω) := by
      intro x r hr
      let r₀ := Classical.choose ((hM_mem x.1).mp x.2)
      let hr₀ := Classical.choose_spec ((hM_mem x.1).mp x.2)
      change (σ_L r₀ ⟨x.1, hr₀⟩ : Ω) = (σ_L r ⟨x.1, hr⟩ : Ω)
      exact (hσ_compat (le_max_left r₀ r) ⟨x.1, hr₀⟩).symm.trans
        (hσ_compat (le_max_right r₀ r) ⟨x.1, hr⟩)
    have hinv_M_eq : ∀ (x : ↥M) (r : ℕ) (hr : x.1 ∈ L r),
        (inv_M x : Ω) = ((σ_L r).symm ⟨x.1, hr⟩ : Ω) := by
      intro x r hr
      let r₀ := Classical.choose ((hM_mem x.1).mp x.2)
      let hr₀ := Classical.choose_spec ((hM_mem x.1).mp x.2)
      change ((σ_L r₀).symm ⟨x.1, hr₀⟩ : Ω) = ((σ_L r).symm ⟨x.1, hr⟩ : Ω)
      exact (hσ_symm_compat (le_max_left r₀ r) ⟨x.1, hr₀⟩).symm.trans
        (hσ_symm_compat (le_max_right r₀ r) ⟨x.1, hr⟩)
    let σ_M : ↥M ≃ₐ[K_k] ↥M :=
      { toFun := to_M
        invFun := inv_M
        left_inv := fun x => by
          obtain ⟨r, hr⟩ := (hM_mem x.1).mp x.2
          apply Subtype.ext
          have h1 := hto_M_eq x r hr
          have hmem' : (to_M x).1 ∈ L r := by
            rw [h1]
            exact (σ_L r ⟨x.1, hr⟩).2
          rw [hinv_M_eq (to_M x) r hmem']
          have hsub : (⟨(to_M x).1, hmem'⟩ : ↥(L r)) = σ_L r ⟨x.1, hr⟩ := Subtype.ext h1
          rw [hsub, AlgEquiv.symm_apply_apply]
        right_inv := fun x => by
          obtain ⟨r, hr⟩ := (hM_mem x.1).mp x.2
          apply Subtype.ext
          have h1 := hinv_M_eq x r hr
          have hmem' : (inv_M x).1 ∈ L r := by
            rw [h1]
            exact ((σ_L r).symm ⟨x.1, hr⟩).2
          rw [hto_M_eq (inv_M x) r hmem']
          have hsub : (⟨(inv_M x).1, hmem'⟩ : ↥(L r)) = (σ_L r).symm ⟨x.1, hr⟩ := Subtype.ext h1
          rw [hsub, AlgEquiv.apply_symm_apply]
        map_mul' := fun x y => by
          obtain ⟨rx, hrx⟩ := (hM_mem x.1).mp x.2
          obtain ⟨ry, hry⟩ := (hM_mem y.1).mp y.2
          let s := max rx ry
          have hx_s : x.1 ∈ L s := hL_mono (le_max_left rx ry) hrx
          have hy_s : y.1 ∈ L s := hL_mono (le_max_right rx ry) hry
          apply Subtype.ext
          change (to_M (x * y) : Ω) = (to_M x : Ω) * (to_M y : Ω)
          rw [hto_M_eq (x * y) s ((L s).mul_mem hx_s hy_s), hto_M_eq x s hx_s, hto_M_eq y s hy_s]
          change (σ_L s (⟨x.1, hx_s⟩ * ⟨y.1, hy_s⟩) : Ω) = _
          rw [map_mul, IntermediateField.coe_mul]
        map_add' := fun x y => by
          obtain ⟨rx, hrx⟩ := (hM_mem x.1).mp x.2
          obtain ⟨ry, hry⟩ := (hM_mem y.1).mp y.2
          let s := max rx ry
          have hx_s : x.1 ∈ L s := hL_mono (le_max_left rx ry) hrx
          have hy_s : y.1 ∈ L s := hL_mono (le_max_right rx ry) hry
          apply Subtype.ext
          change (to_M (x + y) : Ω) = (to_M x : Ω) + (to_M y : Ω)
          rw [hto_M_eq (x + y) s ((L s).add_mem hx_s hy_s), hto_M_eq x s hx_s, hto_M_eq y s hy_s]
          change (σ_L s (⟨x.1, hx_s⟩ + ⟨y.1, hy_s⟩) : Ω) = _
          rw [map_add, IntermediateField.coe_add]
        commutes' := fun a => by
          apply Subtype.ext
          rw [hto_M_eq (algebraMap K_k ↥M a) 0 ((L 0).algebraMap_mem a)]
          exact congrArg Subtype.val ((σ_L 0).commutes a) }
    have hσM_Vs : ∀ x : ↥M, (x : Ω) ∈ V_s ↔ (σ_M x : Ω) ∈ V_s := by
      intro x
      obtain ⟨r, hr⟩ := (hM_mem x.1).mp x.2
      change x.1 ∈ V_s ↔ (to_M x : Ω) ∈ V_s
      rw [hto_M_eq x r hr]
      exact hσ_Vs r ⟨x.1, hr⟩

    have hM_sep : M ≤ separableClosure K_k Ω := by
      rw [iSup_le_iff]
      intro r
      rw [IntermediateField.adjoin_simple_le_iff, mem_separableClosure_iff]
      let N_r := ℓ ^ (r + 1)
      let X_K : K_k := algebraMap P K_k Polynomial.X
      have hXK_ne : X_K ≠ 0 :=
        fun h0 => Polynomial.X_ne_zero (hPK_inj (h0.trans (map_zero _).symm))
      have hNr_K_eq : (N_r : K_k) = algebraMap P K_k (Polynomial.C ((ℓ : k) ^ (r + 1))) := by
        rw [map_pow, Polynomial.C_eq_natCast, map_pow, map_natCast]
        dsimp [N_r]
        rw [Nat.cast_pow]
      have hNr_K_ne : (N_r : K_k) ≠ 0 := by
        rw [hNr_K_eq]
        intro h0
        have h1 : Polynomial.C ((ℓ : k) ^ (r + 1)) = 0 :=
          hPK_inj (h0.trans (map_zero (algebraMap P K_k)).symm)
        exact pow_ne_zero (r + 1) hℓ_k (Polynomial.C_injective (h1.trans Polynomial.C_0.symm))
      let F_r : Polynomial K_k := Polynomial.X ^ N_r - Polynomial.C X_K
      have hFr_eval : Polynomial.aeval (τ r) F_r = 0 := by
        dsimp [F_r, X_K]
        rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
          ← IsScalarTower.algebraMap_apply P K_k Ω, hτ_pow r, sub_self]
      have hFr_sep : F_r.Separable := by
        change IsCoprime F_r (Polynomial.derivative F_r)
        have hderiv : Polynomial.derivative F_r =
            Polynomial.C (N_r : K_k) * Polynomial.X ^ (N_r - 1) := by
          dsimp [F_r]
          rw [map_sub, Polynomial.derivative_C, sub_zero, Polynomial.derivative_X_pow,
            Polynomial.C_eq_natCast]
        refine ⟨Polynomial.C (-X_K⁻¹),
          Polynomial.C (((N_r : K_k) * X_K)⁻¹) * Polynomial.X, ?_⟩
        rw [hderiv]
        have hN_pos : 1 ≤ N_r := Nat.one_le_pow (r + 1) ℓ hℓ_pos
        have hX_pow : Polynomial.X * (Polynomial.C (N_r : K_k) * Polynomial.X ^ (N_r - 1)) =
            Polynomial.C (N_r : K_k) * Polynomial.X ^ N_r := by
          calc
            Polynomial.X * (Polynomial.C (N_r : K_k) * Polynomial.X ^ (N_r - 1)) =
                Polynomial.C (N_r : K_k) * (Polynomial.X * Polynomial.X ^ (N_r - 1)) := by ring
            _ = Polynomial.C (N_r : K_k) * Polynomial.X ^ ((N_r - 1) + 1) := by rw [← pow_succ']
            _ = Polynomial.C (N_r : K_k) * Polynomial.X ^ N_r := by congr 2; omega
        dsimp [F_r]
        calc
          Polynomial.C (-X_K⁻¹) * (Polynomial.X ^ N_r - Polynomial.C X_K) +
              (Polynomial.C (((N_r : K_k) * X_K)⁻¹) * Polynomial.X) *
                (Polynomial.C (N_r : K_k) * Polynomial.X ^ (N_r - 1)) =
              Polynomial.C (-X_K⁻¹) * Polynomial.X ^ N_r -
                Polynomial.C (-X_K⁻¹ * X_K) +
                (Polynomial.C (((N_r : K_k) * X_K)⁻¹ * (N_r : K_k))) * Polynomial.X ^ N_r := by
            rw [mul_sub, ← Polynomial.C_mul, mul_assoc, hX_pow, ← mul_assoc, ← Polynomial.C_mul]
          _ = 1 := by
            have hc1 : -X_K⁻¹ * X_K = -1 := by rw [neg_mul, inv_mul_cancel₀ hXK_ne]
            have hc2 : ((N_r : K_k) * X_K)⁻¹ * (N_r : K_k) = X_K⁻¹ := by
              rw [mul_inv_rev, mul_assoc, inv_mul_cancel₀ hNr_K_ne, mul_one]
            rw [hc1, hc2, Polynomial.C_neg, Polynomial.C_neg, Polynomial.C_1]
            ring
      exact hFr_sep.of_dvd (minpoly.dvd K_k (τ r) hFr_eval)

    obtain ⟨γ₀, hγ₀_Vs, hγ₀_M⟩ := hLiftSep M hM_sep σ_M hσM_Vs
    let γ : ↥I_Vs := ⟨γ₀, (hI_Vs γ₀).mpr hγ₀_Vs⟩
    refine ⟨γ, ?_⟩
    apply PadicInt.ext_of_toZModPow.mp
    intro n
    cases n with
    | zero => exact hZMod0_eq _ _
    | succ r =>
      let _ : NeZero (ℓ ^ (r + 1)) := hNeZeroPow (r + 1)
      have hτ_L : τ r ∈ L r := IntermediateField.subset_adjoin K_k {τ r} rfl
      have hτ_M : τ r ∈ M := (le_iSup L r) hτ_L
      have hγ_τ : γ.1 (τ r) = ι_k (u r) * τ r := by
        change γ₀ (τ r) = _
        rw [hγ₀_M ⟨τ r, hτ_M⟩]
        change (to_M ⟨τ r, hτ_M⟩ : Ω) = _
        rw [hto_M_eq ⟨τ r, hτ_M⟩ r hτ_L, hσ_τ r]
      have hpow_eq : (ζ r) ^ (PadicInt.toZModPow (r + 1) (t_ℓ γ)).val =
          (ζ r) ^ (PadicInt.toZModPow (r + 1) t).val := by
        apply hι_k_inj
        apply mul_right_cancel₀ (hτ_ne r)
        rw [← ht_act r γ, hγ_τ]
      have hζ_ne : ζ r ≠ 0 := fun h0 => by
        have h1 := (hζ_prim r).pow_eq_one
        rw [h0, zero_pow (pow_ne_zero _ hℓ_pos.ne')] at h1
        exact zero_ne_one h1
      have haux_val : ∀ {a b : ZMod (ℓ ^ (r + 1))},
          a.val ≤ b.val → (ζ r) ^ a.val = (ζ r) ^ b.val → a = b := by
        intro a b hle heq
        have hsub : b.val = a.val + (b.val - a.val) := (Nat.add_sub_of_le hle).symm
        have heq' : (ζ r) ^ a.val * 1 = (ζ r) ^ a.val * (ζ r) ^ (b.val - a.val) := by
          rw [mul_one, ← pow_add, ← hsub, heq]
        have hpow1 : (ζ r) ^ (b.val - a.val) = 1 :=
          (mul_left_cancel₀ (pow_ne_zero a.val hζ_ne) heq').symm
        have hdvd := ((hζ_prim r).pow_eq_one_iff_dvd _).mp hpow1
        have hlt : b.val - a.val < ℓ ^ (r + 1) :=
          Nat.lt_of_le_of_lt (Nat.sub_le b.val a.val) (ZMod.val_lt b)
        have hdiff0 : b.val - a.val = 0 := by
          rcases Nat.eq_zero_or_pos (b.val - a.val) with h0 | hpos
          · exact h0
          · exfalso; exact Nat.not_le_of_lt hlt (Nat.le_of_dvd hpos hdvd)
        exact ZMod.val_injective _ (by omega)
      rcases le_total (PadicInt.toZModPow (r + 1) (t_ℓ γ)).val
          (PadicInt.toZModPow (r + 1) t).val with hle | hle
      · exact haux_val hle hpow_eq
      · exact (haux_val hle hpow_eq.symm).symm

  have hRes_triv : ∀ (γ : Ω ≃ₐ[K_k] Ω), (∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) →
      ∀ z : ↥V_s, ∃ hz : γ z.1 ∈ V_s,
        π_Vs ⟨γ z.1, hz⟩ = π_Vs z ∧
        (⟨γ z.1, hz⟩ : ↥V_s) - z ∈ IsLocalRing.maximalIdeal ↥V_s := by
    intro γ hγ z
    have hγ_inv : ∀ w : Ω, w ∈ V_s ↔ γ.symm w ∈ V_s := fun w => by
      have h := hγ (γ.symm w)
      rw [γ.apply_symm_apply] at h
      exact h.symm
    let γ_Vs : ↥V_s ≃+* ↥V_s :=
      { toFun := fun w => ⟨γ w.1, (hγ w.1).mp w.2⟩
        invFun := fun w => ⟨γ.symm w.1, (hγ_inv w.1).mp w.2⟩
        left_inv := fun w => Subtype.ext (γ.symm_apply_apply w.1)
        right_inv := fun w => Subtype.ext (γ.apply_symm_apply w.1)
        map_mul' := fun _ _ => Subtype.ext (map_mul γ _ _)
        map_add' := fun _ _ => Subtype.ext (map_add γ _ _) }
    let c : k := π_Vs z
    have hdiff_ker : z - ι_k_Vs c ∈ IsLocalRing.maximalIdeal ↥V_s := by
      rw [← hπ_ker, RingHom.mem_ker, map_sub, hπ_ιk c, sub_self]
    have hγ_max : γ_Vs (z - ι_k_Vs c) ∈ IsLocalRing.maximalIdeal ↥V_s := by
      intro hunit
      have hpre : IsUnit (γ_Vs.symm (γ_Vs (z - ι_k_Vs c))) :=
        hunit.map γ_Vs.symm.toRingHom.toMonoidHom
      rw [γ_Vs.symm_apply_apply] at hpre
      exact IsLocalRing.notMem_maximalIdeal.mpr hpre hdiff_ker
    have hγ_c : γ_Vs (ι_k_Vs c) = ι_k_Vs c := Subtype.ext (hγ_fix_k γ c)
    have hsub_mem : γ_Vs z - z ∈ IsLocalRing.maximalIdeal ↥V_s := by
      have heq : γ_Vs z - z = γ_Vs (z - ι_k_Vs c) - (z - ι_k_Vs c) := by
        rw [map_sub, hγ_c]
        ring
      rw [heq]
      exact Ideal.sub_mem _ hγ_max hdiff_ker
    refine ⟨(hγ z.1).mp z.2, ?_, hsub_mem⟩
    apply sub_eq_zero.mp
    rw [← map_sub, ← RingHom.mem_ker, hπ_ker]
    exact hsub_mem

  refine ⟨t_ℓ, ht_one, ht_mul, ht_surj, ?_⟩
  intro r E _ _ hExp δ hδ0
  have hδ_τ : δ.1 (τ r) = τ r := (ht_ker r δ).mp hδ0
  have hKE_inj : Function.Injective (algebraMap K_k ↥E) := (algebraMap K_k ↥E).injective
  have hPE_inj : Function.Injective (algebraMap P ↥E) := by
    intro a b hab
    apply hPK_inj
    apply hKE_inj
    simpa only [← IsScalarTower.algebraMap_apply P K_k ↥E] using hab
  have hEΩ_eq_P : ∀ p : P, (algebraMap P ↥E p : Ω) = algebraMap P Ω p := by
    intro p
    rw [IsScalarTower.algebraMap_apply P K_k ↥E, IsScalarTower.algebraMap_apply P K_k Ω]
    rfl

  let V_E : ValuationSubring ↥E := V_s.comap E.val.toRingHom
  let ι_VE : ↥V_E →+* ↥V_s :=
    { toFun := fun x => ⟨(x.1 : Ω), x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hι_VE_max : ∀ x : ↥V_E,
      x ∈ IsLocalRing.maximalIdeal ↥V_E ↔ ι_VE x ∈ IsLocalRing.maximalIdeal ↥V_s := by
    intro x
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal]
    constructor
    · exact fun hx => hx.map ι_VE.toMonoidHom
    · rintro ⟨u, hu⟩
      have hx_ne : x.1 ≠ 0 := by
        intro h0
        have h1 : ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * (ι_VE x).1 = 1 := by
          rw [← hu]; exact congrArg Subtype.val u.inv_mul
        change _ * (x.1 : Ω) = 1 at h1
        rw [h0, ZeroMemClass.coe_zero, mul_zero] at h1
        exact zero_ne_one h1
      have hinv_eq : (((x.1)⁻¹ : ↥E) : Ω) = ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).1 := by
        have h1 : ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * E.val x.1 = 1 := by
          change ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * (ι_VE x).1 = 1
          rw [← hu]
          exact congrArg Subtype.val u.inv_mul
        have hxΩ_ne : E.val x.1 ≠ 0 := fun h0 => hx_ne (E.val.injective h0)
        change E.val ((x.1)⁻¹) = _
        rw [map_inv₀]
        exact (mul_right_cancel₀ hxΩ_ne (by rw [h1, inv_mul_cancel₀ hxΩ_ne])).symm
      have hinv_mem : (x.1)⁻¹ ∈ V_E := by
        change (((x.1)⁻¹ : ↥E) : Ω) ∈ V_s
        rw [hinv_eq]
        exact ((u⁻¹ : (↥V_s)ˣ) : ↥V_s).2
      have hx_inv_mul : x * ⟨(x.1)⁻¹, hinv_mem⟩ = 1 := Subtype.ext (mul_inv_cancel₀ hx_ne)
      exact ⟨⟨x, ⟨(x.1)⁻¹, hinv_mem⟩, hx_inv_mul, by rw [mul_comm, hx_inv_mul]⟩, rfl⟩
  let π_VE : ↥V_E →+* k := π_Vs.comp ι_VE
  have hπ_VE_ker : RingHom.ker π_VE = IsLocalRing.maximalIdeal ↥V_E := by
    ext x
    change π_Vs (ι_VE x) = 0 ↔ x ∈ IsLocalRing.maximalIdeal ↥V_E
    rw [← RingHom.mem_ker, hπ_ker, ← hι_VE_max]

  have hE_sep_alg : Algebra.IsSeparable K_k ↥E := IsGalois.to_isSeparable
  have hE_sep : E ≤ separableClosure K_k Ω := by
    intro z hz
    rw [mem_separableClosure_iff]
    have hsep_E : IsSeparable K_k (⟨z, hz⟩ : ↥E) := Algebra.IsSeparable.isSeparable K_k _
    have hmin_eq : minpoly K_k z = minpoly K_k (⟨z, hz⟩ : ↥E) :=
      (minpoly.algHom_eq E.val E.val.injective ⟨z, hz⟩)
    rwa [IsSeparable, hmin_eq]

  let C_E := integralClosure P ↥E
  have hP_CE_inj : Function.Injective (algebraMap P ↥C_E) := fun a b hab =>
    hPE_inj (congrArg Subtype.val hab)
  have hCE_mem_VE : ∀ y : ↥C_E, (y : ↥E) ∈ V_E := by
    have hP_mem_VE : ∀ p : P, algebraMap P ↥E p ∈ V_E := by
      intro p
      change (algebraMap P ↥E p : Ω) ∈ V_s
      rw [hEΩ_eq_P p]
      refine Polynomial.induction_on' p ?_ ?_
      · intro p₁ p₂ h₁ h₂; rw [map_add]; exact add_mem h₁ h₂
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        exact mul_mem (hC_mem c) (pow_mem hX_mem n)
    let ι_P_VE : P →+* ↥V_E :=
      { toFun := fun p => ⟨algebraMap P ↥E p, hP_mem_VE p⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun _ _ => Subtype.ext (map_mul _ _ _)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun _ _ => Subtype.ext (map_add _ _ _) }
    intro y
    obtain ⟨p, hp_monic, hp_eval⟩ := y.2
    have hInt_VE : IsIntegral ↥V_E (y : ↥E) := by
      refine ⟨p.map ι_P_VE, hp_monic.map ι_P_VE, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp : V_E.subtype.comp ι_P_VE = algebraMap P ↥E := RingHom.ext fun _ => rfl
      change Polynomial.eval₂ (V_E.subtype.comp ι_P_VE) (y : ↥E) p = 0
      rw [hcomp, hp_eval]
    obtain ⟨v, hv⟩ := IsIntegrallyClosed.isIntegral_iff.mp hInt_VE
    rw [← hv]
    exact v.2
  let ι_CE : ↥C_E →+* ↥V_E :=
    { toFun := fun y => ⟨y.1, hCE_mem_VE y⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hι_CE_inj : Function.Injective ι_CE :=
    fun x y hxy => Subtype.ext (congrArg (Subtype.val : ↥V_E → ↥E) hxy)

  let Q_E : Ideal ↥C_E := RingHom.ker (π_VE.comp ι_CE)
  have hQE_eq_comap : Q_E = Ideal.comap ι_CE (IsLocalRing.maximalIdeal ↥V_E) := by
    ext y
    change π_VE (ι_CE y) = 0 ↔ ι_CE y ∈ IsLocalRing.maximalIdeal ↥V_E
    rw [← RingHom.mem_ker, hπ_VE_ker]
  have hQE_max : Q_E.IsMaximal := by
    apply RingHom.ker_isMaximal_of_surjective
    intro c
    refine ⟨algebraMap P ↥C_E (Polynomial.C c), ?_⟩
    have heq : ι_VE (ι_CE (algebraMap P ↥C_E (Polynomial.C c))) = ι_k_Vs c :=
      Subtype.ext (hEΩ_eq_P (Polynomial.C c))
    change π_Vs (ι_VE (ι_CE (algebraMap P ↥C_E (Polynomial.C c)))) = c
    rw [heq]
    exact hπ_ιk c
  let X_CE : ↥C_E := algebraMap P ↥C_E Polynomial.X
  have hX_CE_mem : X_CE ∈ Q_E := by
    rw [hQE_eq_comap, Ideal.mem_comap, hι_VE_max]
    convert hX_max using 1
    apply Subtype.ext
    exact hEΩ_eq_P Polynomial.X
  have hX_CE_ne : X_CE ≠ 0 :=
    fun h0 => Polynomial.X_ne_zero (hP_CE_inj (h0.trans (map_zero _).symm))
  have hQE_ne_bot : Q_E ≠ ⊥ := by
    intro hbot
    have hmem : X_CE ∈ Q_E := hX_CE_mem
    rw [hbot, Ideal.mem_bot] at hmem
    exact hX_CE_ne hmem

  obtain ⟨hDVR_VE, ϖ_r, hϖ_irr, hmax_VE_span, hϖ_ne, hVE_frac_QE, hpow_QE_iff⟩ :
      ∃ (_ : IsDiscreteValuationRing ↥V_E) (ϖ_r : ↥V_E),
        Irreducible ϖ_r ∧
        IsLocalRing.maximalIdeal ↥V_E = Ideal.span {ϖ_r} ∧
        ϖ_r ≠ 0 ∧
        (∀ x : ↥E, x ∈ V_E ↔ ∃ (a s : ↥C_E), s ∉ Q_E ∧ x * (s : ↥E) = (a : ↥E)) ∧
        (∀ (m : ℕ) (z : ↥C_E), z ∈ Q_E ^ m ↔ ι_CE z ∈ Ideal.span {ϖ_r ^ m}) := by
    have hDVR_gen : ∀ (R_E : Type u) [CommRing R_E] [IsDedekindDomain R_E]
        [Algebra P R_E] [Algebra R_E ↥E] [IsScalarTower P R_E ↥E] [IsFractionRing R_E ↥E]
        (ι_RE : R_E →+* ↥V_E) (Q : Ideal R_E) [hQ_max : Q.IsMaximal],
        Function.Injective ι_RE →
        (∀ y : R_E, (ι_RE y : ↥E) = algebraMap R_E ↥E y) →
        Q = Ideal.comap ι_RE (IsLocalRing.maximalIdeal ↥V_E) →
        algebraMap P R_E Polynomial.X ∈ Q →
        Q ≠ ⊥ →
        ∃ (_ : IsDiscreteValuationRing ↥V_E) (ϖ_r : ↥V_E),
          Irreducible ϖ_r ∧
          IsLocalRing.maximalIdeal ↥V_E = Ideal.span {ϖ_r} ∧
          ϖ_r ≠ 0 ∧
          (∀ x : ↥E, x ∈ V_E ↔
            ∃ (a s : R_E), s ∉ Q ∧ x * algebraMap R_E ↥E s = algebraMap R_E ↥E a) ∧
          (∀ (m : ℕ) (z : R_E), z ∈ Q ^ m ↔ ι_RE z ∈ Ideal.span {ϖ_r ^ m}) := by
      intro R_E _ _ _ _ _ _ ι_RE Q hQ_max hι_RE_inj hι_RE_val hQ_comap hX_RE_Q hQ_ne_bot
      have _ : Q.IsPrime := hQ_max.isPrime
      have hRE_inj : Function.Injective (algebraMap R_E ↥E) := IsFractionRing.injective R_E ↥E
      let O_r := Localization.AtPrime Q
      have hs_units_VE : ∀ s : Q.primeCompl, IsUnit (ι_RE s) := by
        intro s
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hmem
        exact s.2 ((SetLike.ext_iff.mp hQ_comap (s : R_E)).mpr hmem)
      have hs_units_E : ∀ s : Q.primeCompl, IsUnit (algebraMap R_E ↥E s) :=
        fun s => by
          have hu := (hs_units_VE s).map V_E.subtype.toMonoidHom
          rwa [show V_E.subtype.toMonoidHom (ι_RE s) = algebraMap R_E ↥E s from hι_RE_val s] at hu
      let j_loc : O_r →+* ↥V_E := IsLocalization.lift (S := O_r) hs_units_VE
      let f_loc : O_r →+* ↥E := IsLocalization.lift (S := O_r) hs_units_E
      have hj_f_loc : ∀ u : O_r, (j_loc u : ↥E) = f_loc u := by
        have hhom : V_E.subtype.comp j_loc = f_loc := by
          refine IsLocalization.ringHom_ext Q.primeCompl ?_
          refine RingHom.ext fun y => ?_
          change (j_loc (algebraMap R_E O_r y) : ↥E) = f_loc (algebraMap R_E O_r y)
          dsimp [j_loc, f_loc]
          rw [IsLocalization.lift_eq, IsLocalization.lift_eq]
          exact hι_RE_val y
        exact fun u => RingHom.congr_fun hhom u
      have hf_loc_inj : Function.Injective f_loc := by
        rw [injective_iff_map_eq_zero]
        intro u hu0
        obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj Q.primeCompl u
        have ha_eq : f_loc (algebraMap R_E O_r a) = 0 := by
          have h := congrArg f_loc has
          rw [map_mul, hu0, zero_mul] at h
          exact h.symm
        dsimp [f_loc] at ha_eq
        rw [IsLocalization.lift_eq] at ha_eq
        have ha0 : a = 0 := hRE_inj (ha_eq.trans (map_zero _).symm)
        have hu_mul : u * algebraMap R_E O_r s = 0 := by rw [has, ha0, map_zero]
        have hs_u : IsUnit (algebraMap R_E O_r s) := IsLocalization.map_units O_r s
        exact (hs_u.mul_left_eq_zero).mp hu_mul
      let W_Q : ValuationSubring ↥E :=
        { carrier := Set.range f_loc
          mul_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a * b, map_mul f_loc a b⟩
          one_mem' := ⟨1, map_one f_loc⟩
          add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a + b, map_add f_loc a b⟩
          zero_mem' := ⟨0, map_zero f_loc⟩
          neg_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨-a, map_neg f_loc a⟩
          mem_or_inv_mem' := fun z => by
            obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors R_E) z
            have hb_ne : algebraMap R_E ↥E b.1 ≠ 0 :=
              fun h0 => mem_nonZeroDivisors_iff_ne_zero.mp b.2
                (hRE_inj (h0.trans (map_zero _).symm))
            have hz_div : z = algebraMap R_E ↥E a / algebraMap R_E ↥E b.1 :=
              eq_div_of_mul_eq hb_ne hab
            let a' : O_r := algebraMap R_E O_r a
            let b' : O_r := algebraMap R_E O_r b.1
            have hdvd_tot : a' ∣ b' ∨ b' ∣ a' := by
              have _ : IsDiscreteValuationRing O_r :=
                IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R_E hQ_ne_bot O_r
              let _ : ValuationRing O_r := of_isDiscreteValuationRing O_r
              exact ValuationRing.dvd_total a' b'
            rcases hdvd_tot with ⟨q, hq⟩ | ⟨q, hq⟩
            · right
              by_cases ha0 : a = 0
              · subst ha0
                rw [hz_div, map_zero, zero_div, inv_zero]
                exact ⟨0, map_zero f_loc⟩
              · have ha_ne : algebraMap R_E ↥E a ≠ 0 :=
                  fun h0 => ha0 (hRE_inj (h0.trans (map_zero _).symm))
                refine ⟨q, ?_⟩
                have hfq : f_loc b' = f_loc a' * f_loc q := by rw [hq, map_mul]
                have hfq' : algebraMap R_E ↥E b.1 = algebraMap R_E ↥E a * f_loc q := by
                  simpa only [a', b', f_loc, IsLocalization.lift_eq] using hfq
                rw [hz_div, inv_div]
                exact eq_div_of_mul_eq ha_ne (by rw [mul_comm, ← hfq'])
            · left
              refine ⟨q, ?_⟩
              have hfq : f_loc a' = f_loc b' * f_loc q := by rw [hq, map_mul]
              have hfq' : algebraMap R_E ↥E a = algebraMap R_E ↥E b.1 * f_loc q := by
                simpa only [a', b', f_loc, IsLocalization.lift_eq] using hfq
              rw [hz_div]
              exact eq_div_of_mul_eq hb_ne (by rw [mul_comm, ← hfq']) }
      have hWQ_le_VE : W_Q ≤ V_E := by
        rintro _ ⟨u, rfl⟩
        rw [← hj_f_loc u]
        exact (j_loc u).2
      let e_WQ : O_r ≃+* ↥W_Q :=
        RingEquiv.ofBijective (f_loc.codRestrict W_Q.toSubring fun u => ⟨u, rfl⟩)
          ⟨fun a b hab => hf_loc_inj (congrArg Subtype.val hab),
           fun y => by obtain ⟨u, hu⟩ := y.2; exact ⟨u, Subtype.ext hu⟩⟩
      let X_RE : R_E := algebraMap P R_E Polynomial.X
      have hXW_eq : f_loc (algebraMap R_E O_r X_RE) = algebraMap P ↥E Polynomial.X := by
        dsimp [f_loc, X_RE]
        rw [IsLocalization.lift_eq, ← IsScalarTower.algebraMap_apply P R_E ↥E]
      have hXW_mem : algebraMap P ↥E Polynomial.X ∈ W_Q :=
        ⟨algebraMap R_E O_r X_RE, hXW_eq⟩
      have hXW_max : (⟨algebraMap P ↥E Polynomial.X, hXW_mem⟩ : ↥W_Q) ∈
          IsLocalRing.maximalIdeal ↥W_Q := by
        have he_X : e_WQ (algebraMap R_E O_r X_RE) =
            (⟨algebraMap P ↥E Polynomial.X, hXW_mem⟩ : ↥W_Q) :=
          Subtype.ext hXW_eq
        rw [← he_X, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hunit
        have hunit_O : IsUnit (algebraMap R_E O_r X_RE) := by
          have h := hunit.map e_WQ.symm.toRingHom.toMonoidHom
          change IsUnit (e_WQ.symm (e_WQ (algebraMap R_E O_r X_RE))) at h
          rwa [e_WQ.symm_apply_apply] at h
        have hmax_O : algebraMap R_E O_r X_RE ∈ IsLocalRing.maximalIdeal O_r :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff O_r Q X_RE).mpr hX_RE_Q
        exact IsLocalRing.notMem_maximalIdeal.mpr hunit_O hmax_O
      have hCW_mem : ∀ c : k, algebraMap P ↥E (Polynomial.C c) ∈ W_Q := fun c =>
        ⟨algebraMap R_E O_r (algebraMap P R_E (Polynomial.C c)), by
          dsimp [f_loc]
          rw [IsLocalization.lift_eq, ← IsScalarTower.algebraMap_apply P R_E ↥E]⟩
      have hWQ_eq_VE : W_Q = V_E :=
        hRank1Max E W_Q hXW_mem hXW_max hCW_mem (Or.inl hWQ_le_VE)
      have hj_loc_bij : Function.Bijective j_loc := by
        refine ⟨fun a b hab => hf_loc_inj ?_, fun y => ?_⟩
        · rw [← hj_f_loc a, ← hj_f_loc b, hab]
        · have hy_W : y.1 ∈ W_Q := hWQ_eq_VE.symm ▸ y.2
          obtain ⟨u, hu⟩ := hy_W
          exact ⟨u, Subtype.ext ((hj_f_loc u).trans hu)⟩
      let e_VE : O_r ≃+* ↥V_E := RingEquiv.ofBijective j_loc hj_loc_bij
      have he_VE_RE : ∀ y : R_E, e_VE (algebraMap R_E O_r y) = ι_RE y :=
        fun y => IsLocalization.lift_eq (S := O_r) hs_units_VE y
      have hDVR_VE : IsDiscreteValuationRing ↥V_E := by
        have _ : IsDiscreteValuationRing O_r :=
          IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R_E hQ_ne_bot O_r
        exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e_VE
      let _ : IsDiscreteValuationRing ↥V_E := hDVR_VE
      obtain ⟨ϖ_r, hϖ_irr⟩ := IsDiscreteValuationRing.exists_irreducible ↥V_E
      have hmax_VE_span : IsLocalRing.maximalIdeal ↥V_E = Ideal.span {ϖ_r} :=
        (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ_r).mp hϖ_irr
      have hϖ_ne : ϖ_r ≠ 0 := hϖ_irr.ne_zero

      have hVE_frac_Q : ∀ x : ↥E, x ∈ V_E ↔
          ∃ (a s : R_E), s ∉ Q ∧ x * algebraMap R_E ↥E s = algebraMap R_E ↥E a := by
        intro x
        rw [← hWQ_eq_VE]
        constructor
        · rintro ⟨u, rfl⟩
          obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj Q.primeCompl u
          refine ⟨a, s.1, s.2, ?_⟩
          have h1 := congrArg f_loc has
          rw [map_mul] at h1
          simpa only [f_loc, IsLocalization.lift_eq] using h1
        · rintro ⟨a, s, hs, hxs⟩
          have hs_ne : algebraMap R_E ↥E s ≠ 0 := by
            intro h0
            exact hs (by
              rw [show s = 0 from hRE_inj (h0.trans (map_zero _).symm)]
              exact Q.zero_mem)
          let s_sub : Q.primeCompl := ⟨s, hs⟩
          refine ⟨IsLocalization.mk' O_r a s_sub, ?_⟩
          apply mul_right_cancel₀ hs_ne
          have hmk : f_loc (IsLocalization.mk' O_r a s_sub) *
              f_loc (algebraMap R_E O_r s_sub) = f_loc (algebraMap R_E O_r a) := by
            rw [← map_mul, IsLocalization.mk'_spec]
          have hmk' : f_loc (IsLocalization.mk' O_r a s_sub) * algebraMap R_E ↥E s =
              algebraMap R_E ↥E a := by
            simpa only [s_sub, f_loc, IsLocalization.lift_eq] using hmk
          exact hmk'.trans hxs.symm

      have hpow_Q_iff : ∀ (m : ℕ) (z : R_E),
          z ∈ Q ^ m ↔ ι_RE z ∈ Ideal.span {ϖ_r ^ m} := by
        intro m z
        have hmap_max_VE : Ideal.map e_VE.toRingHom (IsLocalRing.maximalIdeal O_r) =
            IsLocalRing.maximalIdeal ↥V_E := by
          ext v
          constructor
          · intro hv
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
            · rintro _ ⟨w, hw, rfl⟩
              intro hunit
              have hpre := hunit.map e_VE.symm.toRingHom.toMonoidHom
              change IsUnit (e_VE.symm (e_VE w)) at hpre
              rw [e_VE.symm_apply_apply] at hpre
              exact IsLocalRing.notMem_maximalIdeal.mpr hpre hw
            · exact (IsLocalRing.maximalIdeal ↥V_E).zero_mem
            · exact fun _ _ _ _ => (IsLocalRing.maximalIdeal ↥V_E).add_mem
            · exact fun a _ _ => (IsLocalRing.maximalIdeal ↥V_E).mul_mem_left a
          · intro hv
            have hpre : e_VE.symm v ∈ IsLocalRing.maximalIdeal O_r := by
              intro hunit
              have himg := hunit.map e_VE.toRingHom.toMonoidHom
              change IsUnit (e_VE (e_VE.symm v)) at himg
              rw [e_VE.apply_symm_apply] at himg
              exact IsLocalRing.notMem_maximalIdeal.mpr himg hv
            have hmem_v := Ideal.mem_map_of_mem e_VE.toRingHom hpre
            change e_VE (e_VE.symm v) ∈ Ideal.map e_VE.toRingHom (IsLocalRing.maximalIdeal O_r) at hmem_v
            rwa [e_VE.apply_symm_apply] at hmem_v
        constructor
        · intro hz
          have hmap : Ideal.map ι_RE Q ≤ Ideal.span {ϖ_r} := by
            rw [Ideal.map_le_iff_le_comap, ← hmax_VE_span, ← hQ_comap]
          have hpow_le : Ideal.map ι_RE (Q ^ m) ≤ Ideal.span {ϖ_r ^ m} := by
            rw [Ideal.map_pow, ← Ideal.span_singleton_pow]
            exact Ideal.pow_right_mono hmap m
          exact hpow_le (Ideal.mem_map_of_mem ι_RE hz)
        · intro hz
          rw [← Ideal.span_singleton_pow, ← hmax_VE_span, ← hmap_max_VE,
            ← IsLocalization.AtPrime.map_eq_maximalIdeal Q O_r,
            ← Ideal.map_pow, ← Ideal.map_pow, Ideal.map_map] at hz
          have hcomp_eq : e_VE.toRingHom.comp (algebraMap R_E O_r) = ι_RE :=
            RingHom.ext he_VE_RE
          have hz_O : algebraMap R_E O_r z ∈ Ideal.map (algebraMap R_E O_r) (Q ^ m) := by
            rw [← hcomp_eq, ← Ideal.map_map] at hz
            have hpre : e_VE.symm (e_VE (algebraMap R_E O_r z)) ∈
                Ideal.map e_VE.symm.toRingHom
                  (Ideal.map e_VE.toRingHom (Ideal.map (algebraMap R_E O_r) (Q ^ m))) :=
              Ideal.mem_map_of_mem e_VE.symm.toRingHom hz
            rw [e_VE.symm_apply_apply, Ideal.map_map] at hpre
            have hid : e_VE.symm.toRingHom.comp e_VE.toRingHom = RingHom.id O_r :=
              RingHom.ext e_VE.symm_apply_apply
            rwa [hid, Ideal.map_id] at hpre
          obtain ⟨⟨c_m, s⟩, hzs⟩ :=
            (IsLocalization.mem_map_algebraMap_iff Q.primeCompl O_r).mp hz_O
          have hsz_eq : z * (s : R_E) = (c_m : R_E) := by
            apply hι_RE_inj
            rw [← he_VE_RE, ← he_VE_RE, map_mul]
            exact congrArg e_VE hzs
          have hsz_mem : z * (s : R_E) ∈ Q ^ m := hsz_eq ▸ c_m.2
          have hsup_top : Q ⊔ Ideal.span {(s : R_E)} = ⊤ := by
            by_contra hne
            have heq := hQ_max.eq_of_le hne le_sup_left
            have hs_in : (s : R_E) ∈ Q ⊔ Ideal.span {(s : R_E)} :=
              Ideal.mem_sup_right (Ideal.subset_span rfl)
            rw [← heq] at hs_in
            exact s.2 hs_in
          have h1_mem : (1 : R_E) ∈ Q ⊔ Ideal.span {(s : R_E)} := by rw [hsup_top]; trivial
          rw [Submodule.mem_sup] at h1_mem
          obtain ⟨q, hq_Q, _, h_span, hq_eq⟩ := h1_mem
          rw [Ideal.mem_span_singleton] at h_span
          obtain ⟨a_s, rfl⟩ := h_span
          have h1_sub : 1 - (s : R_E) * a_s ∈ Q := by
            have h : 1 - (s : R_E) * a_s = q := by rw [← hq_eq]; ring
            rwa [h]
          have hpow_coprime : ∀ t : ℕ, ∃ b_t : R_E, 1 - (s : R_E) * b_t ∈ Q ^ t := by
            intro t
            induction t with
            | zero => exact ⟨0, by rw [pow_zero, Ideal.one_eq_top]; trivial⟩
            | succ t iht =>
              obtain ⟨b_t, hbt⟩ := iht
              refine ⟨b_t + a_s - (s : R_E) * b_t * a_s, ?_⟩
              rw [pow_succ]
              have hprod : (1 - (s : R_E) * b_t) * (1 - (s : R_E) * a_s) ∈ Q ^ t * Q :=
                Ideal.mul_mem_mul hbt h1_sub
              convert hprod using 1
              ring
          obtain ⟨b_m, hbm⟩ := hpow_coprime m
          have hz_decomp : z = z * (1 - (s : R_E) * b_m) + (z * (s : R_E)) * b_m := by ring
          rw [hz_decomp]
          exact (Q ^ m).add_mem ((Q ^ m).mul_mem_left z hbm) ((Q ^ m).mul_mem_right b_m hsz_mem)
      exact ⟨hDVR_VE, ϖ_r, hϖ_irr, hmax_VE_span, hϖ_ne, hVE_frac_Q, hpow_Q_iff⟩

    have _ : IsDedekindDomain ↥C_E := integralClosure.isDedekindDomain P K_k ↥E
    have _ : Algebra.IsAlgebraic P ↥E :=
      ⟨fun x => (IsFractionRing.isAlgebraic_iff P K_k ↥E).mpr (Algebra.IsAlgebraic.isAlgebraic x)⟩
    have _ : IsFractionRing ↥C_E ↥E :=
      integralClosure.isFractionRing_of_algebraic fun x hx => hPE_inj (hx.trans (map_zero _).symm)
    have _ : Q_E.IsMaximal := hQE_max
    exact hDVR_gen ↥C_E ι_CE Q_E hι_CE_inj (fun _ => rfl) hQE_eq_comap hX_CE_mem hQE_ne_bot

  let G := (↥E ≃ₐ[K_k] ↥E)
  let _ : MulSemiringAction G ↥C_E :=
    MulSemiringAction.compHom ↥C_E (galRestrict P K_k ↥E ↥C_E).toMonoidHom
  have hsmul_CE : ∀ (σ : G) (y : ↥C_E), ((σ • y : ↥C_E) : ↥E) = σ (y : ↥E) :=
    fun σ y => algebraMap_galRestrict_apply P σ y
  let D_Q : Subgroup G := Ideal.inertia G Q_E
  let e := Nat.card ↥D_Q
  have he_pos : 1 ≤ e := Nat.card_pos

  obtain ⟨u_DQ, χ_r, hu_DQ_spec, hχ_apply, hχ_inj, m₀, hm₀_eq⟩ :
      ∃ (u_DQ : ↥D_Q → (↥V_E)ˣ) (χ_r : ↥D_Q →* kˣ),
        (∀ σ : ↥D_Q, σ.1 (ϖ_r : ↥E) = ((u_DQ σ : ↥V_E) : ↥E) * (ϖ_r : ↥E)) ∧
        (∀ σ : ↥D_Q, (χ_r σ : k) = π_VE (u_DQ σ : ↥V_E)) ∧
        Function.Injective χ_r ∧
        ∃ m₀ : ℕ, ℓ ^ (r + 1) = e * m₀ := by
    let _ : IsDiscreteValuationRing ↥V_E := hDVR_VE
    have hDQ_pres_QE : ∀ (σ : G), σ ∈ D_Q → ∀ y : ↥C_E, y ∈ Q_E → σ • y ∈ Q_E := by
      intro σ hσ y hy
      have hmem := (Ideal.mem_inertia.mp hσ) y
      have hadd := Q_E.add_mem hmem hy
      rwa [sub_add_cancel] at hadd
    have hDQ_pres_VE : ∀ (σ : G), σ ∈ D_Q → ∀ x : ↥E, x ∈ V_E → σ x ∈ V_E := by
      intro σ hσ x hx
      rw [hVE_frac_QE] at hx ⊢
      obtain ⟨a, s, hs, hxs⟩ := hx
      have hs_not : σ • s ∉ Q_E := by
        intro hmem
        have hinv := hDQ_pres_QE σ⁻¹ (D_Q.inv_mem hσ) (σ • s) hmem
        rw [inv_smul_smul] at hinv
        exact hs hinv
      refine ⟨σ • a, σ • s, hs_not, ?_⟩
      rw [hsmul_CE, hsmul_CE, ← map_mul, hxs]
    have hDQ_Vs_iff : ∀ (σ : ↥D_Q) (x : ↥E), (x : Ω) ∈ V_s ↔ (σ.1 x : Ω) ∈ V_s := by
      intro σ x
      change x ∈ V_E ↔ σ.1 x ∈ V_E
      refine ⟨hDQ_pres_VE σ.1 σ.2 x, fun h => ?_⟩
      have h' := hDQ_pres_VE (σ.1)⁻¹ (D_Q.inv_mem σ.2) (σ.1 x) h
      have hinv_eq : (σ.1)⁻¹ (σ.1 x) = x := AlgEquiv.symm_apply_apply σ.1 x
      rwa [hinv_eq] at h'

    let act_VE : ↥D_Q → (↥V_E ≃+* ↥V_E) := fun σ =>
      { toFun := fun z => ⟨σ.1 z.1, hDQ_pres_VE σ.1 σ.2 z.1 z.2⟩
        invFun := fun z => ⟨(σ.1)⁻¹ z.1, hDQ_pres_VE (σ.1)⁻¹ (D_Q.inv_mem σ.2) z.1 z.2⟩
        left_inv := fun z => Subtype.ext (AlgEquiv.symm_apply_apply σ.1 z.1)
        right_inv := fun z => Subtype.ext (AlgEquiv.apply_symm_apply σ.1 z.1)
        map_mul' := fun _ _ => Subtype.ext (map_mul σ.1 _ _)
        map_add' := fun _ _ => Subtype.ext (map_add σ.1 _ _) }
    have hDQ_res_exp : ∀ σ : ↥D_Q,
        (∀ z : ↥V_E, π_VE (act_VE σ z) = π_VE z) ∧ σ ^ (ℓ ^ (r + 1)) = 1 := by
      intro σ
      obtain ⟨γ, hγ_Vs, hγ_E⟩ := hLiftSep E hE_sep σ.1 (hDQ_Vs_iff σ)
      refine ⟨fun z => ?_, ?_⟩
      · obtain ⟨hz_mem, hπ_eq, _⟩ := hRes_triv γ hγ_Vs (ι_VE z)
        have heq : ι_VE (act_VE σ z) = ⟨γ (ι_VE z).1, hz_mem⟩ :=
          Subtype.ext (hγ_E z.1).symm
        change π_Vs (ι_VE (act_VE σ z)) = π_Vs (ι_VE z)
        rw [heq]
        exact hπ_eq
      · apply Subtype.ext
        apply AlgEquiv.ext
        intro w
        have hpow_comm : ∀ (m : ℕ) (x : ↥E), ((σ.1 ^ m) x : Ω) = (γ ^ m) (x : Ω) := by
          intro m
          induction m with
          | zero => intro x; rfl
          | succ m ih =>
            intro x
            rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply,
              ← hγ_E ((σ.1 ^ m) x), ih x]
        apply E.val.injective
        change (((σ.1) ^ (ℓ ^ (r + 1))) w : Ω) = (w : Ω)
        rw [hpow_comm]
        exact hExp ⟨γ, (hI_Vs γ).mpr hγ_Vs⟩ w

    have hu_σ_ex : ∀ σ : ↥D_Q, ∃ u_σ : (↥V_E)ˣ, act_VE σ ϖ_r = (u_σ : ↥V_E) * ϖ_r := by
      intro σ
      have h1 : act_VE σ ϖ_r ∈ Ideal.span {ϖ_r} := by
        rw [← hmax_VE_span, ← hπ_VE_ker, RingHom.mem_ker, (hDQ_res_exp σ).1 ϖ_r]
        rw [← RingHom.mem_ker, hπ_VE_ker, hmax_VE_span]
        exact Ideal.subset_span rfl
      have h2 : (act_VE σ).symm ϖ_r ∈ Ideal.span {ϖ_r} := by
        change act_VE σ⁻¹ ϖ_r ∈ Ideal.span {ϖ_r}
        rw [← hmax_VE_span, ← hπ_VE_ker, RingHom.mem_ker, (hDQ_res_exp σ⁻¹).1 ϖ_r]
        rw [← RingHom.mem_ker, hπ_VE_ker, hmax_VE_span]
        exact Ideal.subset_span rfl
      rw [Ideal.mem_span_singleton] at h1 h2
      obtain ⟨a, ha⟩ := h1
      obtain ⟨b, hb⟩ := h2
      have hab : ϖ_r * 1 = ϖ_r * (a * act_VE σ b) := by
        rw [mul_one]
        calc
          ϖ_r = act_VE σ ((act_VE σ).symm ϖ_r) := ((act_VE σ).apply_symm_apply ϖ_r).symm
          _ = act_VE σ (ϖ_r * b) := by rw [hb]
          _ = (ϖ_r * a) * act_VE σ b := by rw [map_mul, ha]
          _ = ϖ_r * (a * act_VE σ b) := by ring
      have ha_one_mul : a * act_VE σ b = 1 := mul_left_cancel₀ hϖ_ne hab.symm
      have ha_unit : IsUnit a :=
        ⟨⟨a, act_VE σ b, ha_one_mul, by rw [mul_comm, ha_one_mul]⟩, rfl⟩
      obtain ⟨u_σ, rfl⟩ := ha_unit
      exact ⟨u_σ, by rw [ha, mul_comm]⟩
    let u_DQ : ↥D_Q → (↥V_E)ˣ := fun σ => Classical.choose (hu_σ_ex σ)
    have hu_DQ_VE : ∀ σ : ↥D_Q, act_VE σ ϖ_r = (u_DQ σ : ↥V_E) * ϖ_r :=
      fun σ => Classical.choose_spec (hu_σ_ex σ)
    let χ_r : ↥D_Q →* kˣ :=
      { toFun := fun σ => Units.map π_VE.toMonoidHom (u_DQ σ)
        map_one' := by
          apply Units.ext
          have h1 : (u_DQ 1 : ↥V_E) * ϖ_r = 1 * ϖ_r := by
            rw [← hu_DQ_VE 1, one_mul]; rfl
          have hu1 : (u_DQ 1 : ↥V_E) = 1 := mul_right_cancel₀ hϖ_ne h1
          change π_VE (u_DQ 1 : ↥V_E) = 1
          rw [hu1, map_one]
        map_mul' := fun σ τ_el => by
          apply Units.ext
          have hmul : (u_DQ (σ * τ_el) : ↥V_E) * ϖ_r =
              (act_VE σ (u_DQ τ_el : ↥V_E) * (u_DQ σ : ↥V_E)) * ϖ_r := by
            rw [← hu_DQ_VE (σ * τ_el)]
            change act_VE σ (act_VE τ_el ϖ_r) = _
            rw [hu_DQ_VE τ_el, map_mul, hu_DQ_VE σ, mul_assoc]
          have hu_mul : (u_DQ (σ * τ_el) : ↥V_E) =
              act_VE σ (u_DQ τ_el : ↥V_E) * (u_DQ σ : ↥V_E) :=
            mul_right_cancel₀ hϖ_ne hmul
          change π_VE (u_DQ (σ * τ_el) : ↥V_E) =
            π_VE (u_DQ σ : ↥V_E) * π_VE (u_DQ τ_el : ↥V_E)
          rw [hu_mul, map_mul, (hDQ_res_exp σ).1, mul_comm] }

    have hχ_inj : Function.Injective χ_r := by
      rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
      intro σ hσ_ker
      rw [MonoidHom.mem_ker] at hσ_ker
      have hπ_u1 : π_VE (u_DQ σ : ↥V_E) = 1 := congrArg Units.val hσ_ker
      by_contra hσ_ne
      have hex_VE : ∃ x : ↥V_E, act_VE σ x ≠ x := by
        by_contra hall
        have hall' : ∀ x : ↥V_E, act_VE σ x = x :=
          fun x => Classical.not_not.mp fun h => hall ⟨x, h⟩
        apply hσ_ne
        apply Subtype.ext
        apply AlgEquiv.ext
        intro w
        rcases ValuationSubring.mem_or_inv_mem V_E w with hw | hwinv
        · exact congrArg (Subtype.val : ↥V_E → ↥E) (hall' ⟨w, hw⟩)
        · have hinv := congrArg (Subtype.val : ↥V_E → ↥E) (hall' ⟨w⁻¹, hwinv⟩)
          change σ.1 (w⁻¹) = w⁻¹ at hinv
          rw [map_inv₀, inv_inj] at hinv
          exact hinv
      obtain ⟨x, hx_ne⟩ := hex_VE
      let y : ↥V_E := act_VE σ x - x
      have hy_ne : y ≠ 0 := sub_ne_zero.mpr hx_ne
      obtain ⟨d, h_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hy_ne hϖ_irr
      obtain ⟨u_y, huy_eq⟩ := h_assoc.symm
      have hy_eq : y = (u_y : ↥V_E) * ϖ_r ^ d := by rw [← huy_eq, mul_comm]
      let I_d1 : Ideal ↥V_E := Ideal.span {ϖ_r ^ (d + 1)}
      have hstep_y : act_VE σ y - y ∈ I_d1 := by
        have hdiff_ker : act_VE σ (u_y : ↥V_E) * (u_DQ σ : ↥V_E) ^ d - (u_y : ↥V_E) ∈
            Ideal.span {ϖ_r} := by
          rw [← hmax_VE_span, ← hπ_VE_ker, RingHom.mem_ker, map_sub, map_mul, map_pow,
            (hDQ_res_exp σ).1, hπ_u1, one_pow, mul_one, sub_self]
        rw [Ideal.mem_span_singleton] at hdiff_ker
        obtain ⟨q₀, hq₀⟩ := hdiff_ker
        rw [Ideal.mem_span_singleton]
        refine ⟨q₀, ?_⟩
        calc
          act_VE σ y - y =
              act_VE σ ((u_y : ↥V_E) * ϖ_r ^ d) - (u_y : ↥V_E) * ϖ_r ^ d := by rw [hy_eq]
          _ = (act_VE σ (u_y : ↥V_E) * (u_DQ σ : ↥V_E) ^ d - (u_y : ↥V_E)) * ϖ_r ^ d := by
              rw [map_mul, map_pow, hu_DQ_VE σ, mul_pow]
              ring
          _ = (ϖ_r * q₀) * ϖ_r ^ d := by rw [hq₀]
          _ = ϖ_r ^ (d + 1) * q₀ := by rw [pow_succ']; ring
      have hpres_Id1 : ∀ z ∈ I_d1, act_VE σ z ∈ I_d1 := by
        intro z hz
        rw [Ideal.mem_span_singleton] at hz ⊢
        obtain ⟨a, rfl⟩ := hz
        refine ⟨(u_DQ σ : ↥V_E) ^ (d + 1) * act_VE σ a, ?_⟩
        rw [map_mul, map_pow, hu_DQ_VE σ, mul_pow]
        ring
      let f_σ : ↥V_E →+* ↥V_E := (act_VE σ).toRingHom
      have hiter_pow : ∀ (m : ℕ) (z : ↥V_E), (f_σ^[m]) z = act_VE (σ ^ m) z := by
        intro m
        induction m with
        | zero => intro z; rfl
        | succ m ih =>
          intro z
          rw [Function.iterate_succ_apply', ih z, pow_succ' σ m]
          rfl
      have hiter_diff : ∀ j : ℕ, (f_σ^[j]) y - y ∈ I_d1 := by
        intro j
        induction j with
        | zero => simp
        | succ j ih =>
          have h1 : f_σ ((f_σ^[j]) y - y) ∈ I_d1 := hpres_Id1 _ ih
          have heq : (f_σ^[j + 1]) y - y = f_σ ((f_σ^[j]) y - y) + (f_σ y - y) := by
            rw [Function.iterate_succ_apply', map_sub]
            ring
          rw [heq]
          exact I_d1.add_mem h1 hstep_y
      let N_r := ℓ ^ (r + 1)
      have hsum_mem : (∑ j ∈ Finset.range N_r, ((f_σ^[j]) y - y)) ∈ I_d1 :=
        Submodule.sum_mem I_d1 fun j _ => hiter_diff j
      have hiter_y : ∀ j : ℕ, (f_σ^[j]) y = (f_σ^[j + 1]) x - (f_σ^[j]) x := by
        intro j
        have hcomm : (f_σ^[j]) (f_σ x) = (f_σ^[j + 1]) x :=
          (Function.iterate_succ_apply f_σ j x).symm
        dsimp [y]
        change (f_σ^[j]) (f_σ x - x) = _
        have hring : ∀ m : ℕ, ∀ a b : ↥V_E, (f_σ^[m]) (a - b) = (f_σ^[m]) a - (f_σ^[m]) b := by
          intro m
          induction m with
          | zero => intro a b; rfl
          | succ m ih => intro a b; simp only [Function.iterate_succ_apply', ih, map_sub]
        rw [hring j (f_σ x) x, hcomm]
      have htel : (∑ j ∈ Finset.range N_r, (f_σ^[j]) y) = 0 := by
        simp_rw [hiter_y]
        rw [Finset.sum_range_sub (fun j => (f_σ^[j]) x) N_r, Function.iterate_zero_apply,
          hiter_pow N_r x, (hDQ_res_exp σ).2]
        change x - x = 0
        exact sub_self x
      rw [Finset.sum_sub_distrib, htel, zero_sub, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul, Ideal.neg_mem_iff, Ideal.mem_span_singleton] at hsum_mem
      obtain ⟨q₁, hq₁⟩ := hsum_mem
      have hcancel_ϖ : (N_r : ↥V_E) * (u_y : ↥V_E) = ϖ_r * q₁ := by
        apply mul_right_cancel₀ (pow_ne_zero d hϖ_ne)
        calc
          ((N_r : ↥V_E) * (u_y : ↥V_E)) * ϖ_r ^ d = (N_r : ↥V_E) * y := by rw [hy_eq, mul_assoc]
          _ = ϖ_r ^ (d + 1) * q₁ := hq₁
          _ = (ϖ_r * q₁) * ϖ_r ^ d := by rw [pow_succ]; ring
      have hker_Ny : (N_r : ↥V_E) * (u_y : ↥V_E) ∈ RingHom.ker π_VE := by
        rw [hπ_VE_ker, hmax_VE_span, Ideal.mem_span_singleton]
        exact ⟨q₁, hcancel_ϖ⟩
      rw [RingHom.mem_ker, map_mul, map_natCast] at hker_Ny
      have hNr_k : (N_r : k) ≠ 0 := by
        dsimp [N_r]
        rw [Nat.cast_pow]
        exact pow_ne_zero (r + 1) hℓ_k
      have huy_k : π_VE (u_y : ↥V_E) ≠ 0 := (u_y.isUnit.map π_VE.toMonoidHom).ne_zero
      exact mul_ne_zero hNr_k huy_k hker_Ny

    let _ : Fintype ↥D_Q := Fintype.ofFinite ↥D_Q
    have he_eq_fin : e = Fintype.card ↥D_Q := Nat.card_eq_fintype_card
    have he_prime_pow : ∃ j : ℕ, e = ℓ ^ j := by
      have hall_p : ∀ p : ℕ, Nat.Prime p → p ∣ e → p = ℓ := by
        intro p hp hp_dvd
        let _ : Fact (Nat.Prime p) := ⟨hp⟩
        rw [he_eq_fin] at hp_dvd
        obtain ⟨σ, hσ_ord⟩ := exists_prime_orderOf_dvd_card p hp_dvd
        have hord_dvd : orderOf σ ∣ ℓ ^ (r + 1) := orderOf_dvd_of_pow_eq_one (hDQ_res_exp σ).2
        rw [hσ_ord] at hord_dvd
        rcases hℓ_prime.eq_one_or_self_of_dvd p (hp.dvd_of_dvd_pow hord_dvd) with rfl | h
        · exact absurd hp Nat.not_prime_one
        · exact h
      have hstrong : ∀ m : ℕ, 1 ≤ m → (∀ p : ℕ, Nat.Prime p → p ∣ m → p = ℓ) → ∃ j : ℕ, m = ℓ ^ j := by
        intro m
        induction m using Nat.strong_induction_on with
        | _ m ih =>
          intro hm hpm
          by_cases hm1 : m = 1
          · exact ⟨0, by rw [hm1, pow_zero]⟩
          · have hp_min : Nat.Prime m.minFac := Nat.minFac_prime hm1
            have hdvd_min : m.minFac ∣ m := Nat.minFac_dvd m
            have hmin_eq : m.minFac = ℓ := hpm m.minFac hp_min hdvd_min
            rw [hmin_eq] at hdvd_min
            obtain ⟨m', hm'_eq⟩ := hdvd_min
            have hm'_pos : 1 ≤ m' := by
              rcases Nat.eq_zero_or_pos m' with rfl | hpos
              · rw [mul_zero] at hm'_eq; omega
              · exact hpos
            have hm'_lt : m' < m := by nlinarith [hℓ_two]
            obtain ⟨j, hj⟩ := ih m' hm'_lt hm'_pos fun p hp hp_m' =>
              hpm p hp (hp_m'.trans ⟨ℓ, by rw [hm'_eq, mul_comm]⟩)
            exact ⟨j + 1, by rw [hm'_eq, hj, pow_succ']⟩
      exact hstrong e he_pos hall_p
    obtain ⟨j_e, hj_e⟩ := he_prime_pow
    have he_le_Nr : e ≤ ℓ ^ (r + 1) := by
      let N_r := ℓ ^ (r + 1)
      let _ : NeZero N_r := hNeZeroPow (r + 1)
      let P_k : Polynomial k := Polynomial.X ^ N_r - 1
      have hPk_deg : P_k.natDegree = N_r := by
        dsimp [P_k]
        simpa using (Polynomial.natDegree_X_pow_sub_C (R := k) (n := N_r) (r := 1))
      have hPk_ne : P_k ≠ 0 := by
        intro h
        have := congrArg Polynomial.natDegree h
        rw [hPk_deg, Polynomial.natDegree_zero] at this
        exact (NeZero.ne N_r) this
      let g_χ : ↥D_Q → k := fun σ => (χ_r σ : k)
      have hg_inj : Function.Injective g_χ := fun a b hab => hχ_inj (Units.ext hab)
      let S_χ : Finset k := Finset.univ.image g_χ
      have hS_sub : S_χ ⊆ P_k.roots.toFinset := by
        intro c hc
        rw [Finset.mem_image] at hc
        obtain ⟨σ, _, rfl⟩ := hc
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hPk_ne, Polynomial.IsRoot.def]
        dsimp [P_k, g_χ]
        have hpow1 : (χ_r σ : k) ^ N_r = 1 := by
          rw [← Units.val_pow_eq_pow_val, ← map_pow, (hDQ_res_exp σ).2, map_one, Units.val_one]
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one,
          hpow1, sub_self]
      calc
        e = S_χ.card := by rw [he_eq_fin, Finset.card_image_of_injective _ hg_inj, Finset.card_univ]
        _ ≤ P_k.roots.toFinset.card := Finset.card_le_card hS_sub
        _ ≤ P_k.roots.card := Multiset.toFinset_card_le _
        _ ≤ N_r := (Polynomial.card_roots' P_k).trans hPk_deg.le
    have hj_le_r1 : j_e ≤ r + 1 := by
      by_contra hgt
      have hlt : ℓ ^ (r + 1) < ℓ ^ j_e :=
        Nat.pow_lt_pow_right hℓ_prime.one_lt (Nat.lt_of_not_ge hgt)
      omega
    have he_dvd_Nr : e ∣ ℓ ^ (r + 1) := by
      rw [hj_e]
      exact pow_dvd_pow ℓ hj_le_r1
    refine ⟨u_DQ, χ_r, fun σ => congrArg Subtype.val (hu_DQ_VE σ), fun _ => rfl, hχ_inj, he_dvd_Nr⟩

  obtain ⟨u_X, hX_VE_eq⟩ : ∃ u_X : (↥V_E)ˣ, ι_CE X_CE = (u_X : ↥V_E) * ϖ_r ^ e := by
    have hRam_gen : ∀ (R₀ R_E : Type u) [CommRing R₀] [IsDedekindDomain R₀]
        [CommRing R_E] [IsDedekindDomain R_E]
        [Algebra R₀ R_E] [Module.Finite R₀ R_E] [Module.IsTorsionFree R₀ R_E]
        [Module.Flat R₀ R_E] [Algebra.IsIntegral R₀ R_E]
        [MulSemiringAction G R_E] [IsGaloisGroup G R₀ R_E]
        (p₀ : Ideal R₀) [p₀.IsMaximal] (Q : Ideal R_E) [Q.IsMaximal] [Q.LiesOver p₀]
        [PerfectField p₀.ResidueField],
        p₀ ≠ ⊥ → Nat.card ↥(Ideal.inertia G Q) = p₀.ramificationIdx' Q := by
      intro R₀ R_E _ _ _ _ _ _ _ _ _ _ _ p₀ hp₀_m Q hQ_m _ _ hp₀_ne
      have _ : p₀.IsPrime := hp₀_m.isPrime
      have _ : Q.IsPrime := hQ_m.isPrime
      have _ : Algebra.HasSeparableResidueFieldsAt R₀ R_E p₀ := by
        apply Algebra.HasSeparableResidueFieldsAt.mk
        intro q _ hqo
        let f_loc : Localization.AtPrime p₀ →+* Localization.AtPrime q :=
          Localization.localRingHom p₀ q (algebraMap R₀ R_E) hqo.over
        let _ : Algebra (Localization.AtPrime p₀) (Localization.AtPrime q) := f_loc.toAlgebra
        have _ : IsScalarTower R₀ (Localization.AtPrime p₀) (Localization.AtPrime q) :=
          IsScalarTower.of_algebraMap_eq fun x =>
            (Localization.localRingHom_to_map p₀ q (algebraMap R₀ R_E) hqo.over x).symm
        have _ : Algebra.IsAlgebraic p₀.ResidueField q.ResidueField :=
          instIsAlgebraicResidueFieldOfIsIntegral p₀ q
        exact Algebra.IsAlgebraic.isSeparable_of_perfectField
      rw [Ideal.card_inertia_eq_ramificationIdxIn (G := G) p₀ Q,
        Ideal.ramificationIdxIn_eq_ramificationIdx p₀ Q G,
        Ideal.ramificationIdx'_eq_ramificationIdx p₀ Q hp₀_ne]

    let p_X : Ideal P := Ideal.span {Polynomial.X}
    have hpX_ker : RingHom.ker (Polynomial.evalRingHom (0 : k)) = p_X := by
      ext f
      rw [RingHom.mem_ker, Polynomial.coe_evalRingHom, ← Polynomial.IsRoot.def,
        ← Polynomial.dvd_iff_isRoot, map_zero, sub_zero, Ideal.mem_span_singleton]
    have hpX_max : p_X.IsMaximal := by
      rw [← hpX_ker]
      exact RingHom.ker_isMaximal_of_surjective (Polynomial.evalRingHom 0)
        fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    have _ : p_X.IsMaximal := hpX_max
    have hpX_ne_bot : p_X ≠ ⊥ := by
      intro hbot
      have hmem : (Polynomial.X : P) ∈ p_X := Ideal.subset_span rfl
      rw [hbot, Ideal.mem_bot] at hmem
      exact Polynomial.X_ne_zero hmem
    have hPerf_pX : PerfectField p_X.ResidueField := by
      have hev_surj : Function.Surjective (Polynomial.evalRingHom (0 : k)) :=
        fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
      let eq₁ : (P ⧸ RingHom.ker (Polynomial.evalRingHom (0 : k))) ≃+* k :=
        RingHom.quotientKerEquivOfSurjective hev_surj
      let eq₀ : (P ⧸ RingHom.ker (Polynomial.evalRingHom (0 : k))) ≃+* (P ⧸ p_X) :=
        Ideal.quotEquivOfEq hpX_ker
      let eq₂ : (P ⧸ p_X) ≃+* p_X.ResidueField :=
        RingEquiv.ofBijective (algebraMap (P ⧸ p_X) p_X.ResidueField)
          (Ideal.bijective_algebraMap_quotient_residueField p_X)
      let _ : PerfectField k := IsAlgClosed.perfectField k
      exact PerfectField.of_ringEquiv (eq₁.symm.trans (eq₀.trans eq₂))

    have he_eq_ram' : e = p_X.ramificationIdx' Q_E := by
      have _ : IsDedekindDomain ↥C_E := integralClosure.isDedekindDomain P K_k ↥E
      have _ : Algebra.IsAlgebraic P ↥E :=
        ⟨fun x => (IsFractionRing.isAlgebraic_iff P K_k ↥E).mpr (Algebra.IsAlgebraic.isAlgebraic x)⟩
      have _ : IsFractionRing ↥C_E ↥E :=
        integralClosure.isFractionRing_of_algebraic fun x hx => hPE_inj (hx.trans (map_zero _).symm)
      have _ : Module.Finite P ↥C_E := IsIntegralClosure.finite P K_k ↥E ↥C_E
      have _ : Module.IsTorsionFree P ↥C_E :=
        Module.isTorsionFree_iff_algebraMap_injective.mpr hP_CE_inj
      have _ : Module.Flat P ↥C_E := inferInstance
      let _ : SMulDistribClass G ↥C_E ↥E :=
        SMulDistribClass.mk fun g a s => by
          change g (a.1 * s) = (g • a).1 * g s
          rw [map_mul, hsmul_CE g a]
      have _ : IsGaloisGroup G P ↥C_E :=
        IsGaloisGroup.of_isFractionRing G P ↥C_E K_k ↥E
      have _ : Q_E.IsMaximal := hQE_max
      have _ : Q_E.LiesOver p_X := by
        refine ⟨?_⟩
        have hcomp_P : (π_VE.comp ι_CE).comp (algebraMap P ↥C_E) = Polynomial.evalRingHom 0 := by
          apply Polynomial.ringHom_ext'
          · ext c
            simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
            have heq : ι_VE (ι_CE (algebraMap P ↥C_E (Polynomial.C c))) = ι_k_Vs c :=
              Subtype.ext (hEΩ_eq_P (Polynomial.C c))
            change π_Vs (ι_VE (ι_CE (algebraMap P ↥C_E (Polynomial.C c)))) = c
            rw [heq, hπ_ιk c]
          · simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X]
            exact hX_CE_mem
        ext f
        rw [← hpX_ker, ← hcomp_P]
        rfl
      let _ : PerfectField p_X.ResidueField := hPerf_pX
      exact hRam_gen P ↥C_E p_X Q_E hpX_ne_bot

    let _ : IsDiscreteValuationRing ↥V_E := hDVR_VE
    let X_VE : ↥V_E := ι_CE X_CE
    have hX_VE_ne : X_VE ≠ 0 := fun h0 => hX_CE_ne (hι_CE_inj (h0.trans (map_zero _).symm))
    obtain ⟨n_X, hX_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hX_VE_ne hϖ_irr
    obtain ⟨u_X, huX_eq⟩ := hX_assoc.symm
    have hX_VE_n : X_VE = (u_X : ↥V_E) * ϖ_r ^ n_X := by rw [← huX_eq, mul_comm]
    have hnX_eq_e : n_X = e := by
      rw [he_eq_ram']
      symm
      apply Ideal.ramificationIdx'_spec
      · dsimp [p_X]
        rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem, hpow_QE_iff,
          Ideal.mem_span_singleton]
        refine ⟨(u_X : ↥V_E), ?_⟩
        change X_VE = ϖ_r ^ n_X * (u_X : ↥V_E)
        rw [hX_VE_n, mul_comm]
      · intro hle
        dsimp [p_X] at hle
        rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem, hpow_QE_iff,
          Ideal.mem_span_singleton] at hle
        obtain ⟨q, hq⟩ := hle
        have hu_in_max : (u_X : ↥V_E) ∈ Ideal.span {ϖ_r} := by
          rw [Ideal.mem_span_singleton]
          refine ⟨q, ?_⟩
          apply mul_right_cancel₀ (pow_ne_zero n_X hϖ_ne)
          calc
            (u_X : ↥V_E) * ϖ_r ^ n_X = X_VE := hX_VE_n.symm
            _ = ϖ_r ^ (n_X + 1) * q := hq
            _ = (ϖ_r * q) * ϖ_r ^ n_X := by rw [pow_succ]; ring
        rw [← hmax_VE_span] at hu_in_max
        exact IsLocalRing.notMem_maximalIdeal.mpr u_X.isUnit hu_in_max
    exact ⟨u_X, hnX_eq_e ▸ hX_VE_n⟩

  let ϖ_Ω : Ω := ((ϖ_r : ↥E) : Ω)
  have hϖ_Ω_ne : ϖ_Ω ≠ 0 :=
    fun h0 => hϖ_ne (Subtype.ext (E.val.injective h0))
  let v : Ω := (τ r) ^ m₀ / ϖ_Ω
  let u_X_Vs : (↥V_s)ˣ := Units.map ι_VE.toMonoidHom u_X
  have hv_pow : v ^ e = ((u_X_Vs : ↥V_s) : Ω) := by
    dsimp [v]
    rw [div_pow, ← pow_mul, mul_comm m₀ e, ← hm₀_eq, hτ_pow r]
    have hX_Ω_eq : X_Ω = ((u_X_Vs : ↥V_s) : Ω) * ϖ_Ω ^ e := by
      have h1 := congrArg (V_s.subtype.comp ι_VE) hX_VE_eq
      simp only [RingHom.comp_apply, map_mul, map_pow] at h1
      have h2 : (ι_VE (ι_CE X_CE) : Ω) = X_Ω := hEΩ_eq_P Polynomial.X
      rwa [← h2]
    rw [hX_Ω_eq, mul_div_cancel_right₀ _ (pow_ne_zero e hϖ_Ω_ne)]
  have hv_ne : v ≠ 0 := by
    intro h0
    have h1 := hv_pow
    rw [h0, zero_pow (by omega)] at h1
    have h2 : (u_X_Vs : ↥V_s) = 0 := Subtype.ext h1.symm
    exact u_X_Vs.ne_zero h2
  have hv_mem : v ∈ V_s := by
    by_contra hnot
    have hinv_mem : v⁻¹ ∈ V_s := (ValuationSubring.mem_or_inv_mem V_s v).resolve_left hnot
    let w_inv : ↥V_s := ⟨v⁻¹, hinv_mem⟩
    have hw_max : w_inv ∈ IsLocalRing.maximalIdeal ↥V_s := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u_w, hu_w⟩
      apply hnot
      have hval : ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).1 = v := by
        have h1 : ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * v⁻¹ = 1 := by
          change ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * w_inv.1 = 1
          rw [← hu_w]
          exact congrArg Subtype.val u_w.inv_mul
        exact mul_right_cancel₀ (inv_ne_zero hv_ne) (by rw [h1, mul_inv_cancel₀ hv_ne])
      rw [← hval]
      exact ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).2
    have hpow_max : w_inv ^ e ∈ IsLocalRing.maximalIdeal ↥V_s :=
      Ideal.pow_mem_of_mem _ hw_max e he_pos
    have hpow_unit : w_inv ^ e = ((u_X_Vs⁻¹ : (↥V_s)ˣ) : ↥V_s) := by
      apply Subtype.ext
      change (v⁻¹) ^ e = _
      rw [inv_pow, hv_pow]
      have h1 : ((u_X_Vs⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * (u_X_Vs : ↥V_s).1 = 1 :=
        congrArg Subtype.val u_X_Vs.inv_mul
      have hu_ne_Ω : ((u_X_Vs : ↥V_s) : Ω) ≠ 0 :=
        fun h0 => u_X_Vs.ne_zero (Subtype.ext h0)
      exact (mul_right_cancel₀ hu_ne_Ω (by rw [h1, inv_mul_cancel₀ hu_ne_Ω])).symm
    rw [hpow_unit] at hpow_max
    exact IsLocalRing.notMem_maximalIdeal.mpr (u_X_Vs⁻¹).isUnit hpow_max
  have hvinv_mem : v⁻¹ ∈ V_s := by
    by_contra hnot
    let w_v : ↥V_s := ⟨v, hv_mem⟩
    have hw_max : w_v ∈ IsLocalRing.maximalIdeal ↥V_s := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u_w, hu_w⟩
      apply hnot
      have hval : ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).1 = v⁻¹ := by
        have h1 : ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * v = 1 := by
          change ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).1 * w_v.1 = 1
          rw [← hu_w]
          exact congrArg Subtype.val u_w.inv_mul
        exact mul_right_cancel₀ hv_ne (by rw [h1, inv_mul_cancel₀ hv_ne])
      rw [← hval]
      exact ((u_w⁻¹ : (↥V_s)ˣ) : ↥V_s).2
    have hpow_max : w_v ^ e ∈ IsLocalRing.maximalIdeal ↥V_s :=
      Ideal.pow_mem_of_mem _ hw_max e he_pos
    have hpow_unit : w_v ^ e = (u_X_Vs : ↥V_s) := Subtype.ext hv_pow
    rw [hpow_unit] at hpow_max
    exact IsLocalRing.notMem_maximalIdeal.mpr u_X_Vs.isUnit hpow_max
  let v_Vs : ↥V_s := ⟨v, hv_mem⟩
  have hv_mul_one : v_Vs * ⟨v⁻¹, hvinv_mem⟩ = 1 := Subtype.ext (mul_inv_cancel₀ hv_ne)
  have hv_Vs_unit : IsUnit v_Vs :=
    ⟨⟨v_Vs, ⟨v⁻¹, hvinv_mem⟩, hv_mul_one, by rw [mul_comm, hv_mul_one]⟩, rfl⟩

  have _ : Normal K_k ↥E := IsGalois.to_normal
  let σ_δ : G := δ.1.restrictNormal ↥E
  have hσ_δ_comm : ∀ x : ↥E, (σ_δ x : Ω) = δ.1 (x : Ω) :=
    fun x => AlgEquiv.restrictNormal_commutes δ.1 ↥E x
  have hσ_δ_mem : σ_δ ∈ D_Q := by
    rw [Ideal.mem_inertia]
    intro y
    rw [hQE_eq_comap, Ideal.mem_comap, hι_VE_max]
    obtain ⟨_, _, hdiff⟩ := hRes_triv δ.1 ((hI_Vs δ.1).mp δ.2) (ι_VE (ι_CE y))
    convert hdiff using 1
    apply Subtype.ext
    change E.val ((σ_δ • y - y : ↥C_E) : ↥E) = δ.1 (y.1 : Ω) - (y.1 : Ω)
    rw [Subalgebra.coe_sub, map_sub, hsmul_CE σ_δ y]
    change (σ_δ y.1 : Ω) - (y.1 : Ω) = δ.1 (y.1 : Ω) - (y.1 : Ω)
    rw [hσ_δ_comm y.1]
  let σ_δ_DQ : ↥D_Q := ⟨σ_δ, hσ_δ_mem⟩

  have hτ_v : (τ r) ^ m₀ = v * ϖ_Ω := (div_mul_cancel₀ _ hϖ_Ω_ne).symm
  have hδ_ϖ : δ.1 ϖ_Ω = ((u_DQ σ_δ_DQ : ↥V_E) : Ω) * ϖ_Ω := by
    dsimp [ϖ_Ω]
    rw [← hσ_δ_comm (ϖ_r : ↥E)]
    change E.val (σ_δ_DQ.1 (ϖ_r : ↥E)) = E.val ((u_DQ σ_δ_DQ : ↥V_E) : ↥E) * E.val (ϖ_r : ↥E)
    rw [← map_mul, hu_DQ_spec σ_δ_DQ]
  obtain ⟨hδv_mem, hπ_δv, _⟩ := hRes_triv δ.1 ((hI_Vs δ.1).mp δ.2) v_Vs
  have hv_eq_δ : v = δ.1 v * ((u_DQ σ_δ_DQ : ↥V_E) : Ω) := by
    apply mul_right_cancel₀ hϖ_Ω_ne
    calc
      v * ϖ_Ω = (τ r) ^ m₀ := hτ_v.symm
      _ = δ.1 ((τ r) ^ m₀) := by rw [map_pow, hδ_τ]
      _ = δ.1 (v * ϖ_Ω) := by rw [hτ_v]
      _ = (δ.1 v * ((u_DQ σ_δ_DQ : ↥V_E) : Ω)) * ϖ_Ω := by rw [map_mul, hδ_ϖ, mul_assoc]
  have hv_Vs_eq : v_Vs = ⟨δ.1 v, hδv_mem⟩ * ι_VE (u_DQ σ_δ_DQ : ↥V_E) :=
    Subtype.ext hv_eq_δ
  have hπ_eq1 : π_Vs v_Vs * 1 = π_Vs v_Vs * (χ_r σ_δ_DQ : k) := by
    rw [mul_one, hχ_apply σ_δ_DQ]
    conv_lhs => rw [hv_Vs_eq, map_mul, hπ_δv]
    rfl
  have hπ_v_ne : π_Vs v_Vs ≠ 0 := (hv_Vs_unit.map π_Vs.toMonoidHom).ne_zero
  have hχ_eq1 : χ_r σ_δ_DQ = 1 :=
    Units.ext (mul_left_cancel₀ hπ_v_ne hπ_eq1).symm
  have hσ_δ_one : σ_δ_DQ = 1 := hχ_inj (hχ_eq1.trans (map_one χ_r).symm)
  intro w
  rw [← hσ_δ_comm w]
  have hw1 : σ_δ w = w := by
    have h1 : σ_δ = 1 := congrArg Subtype.val hσ_δ_one
    rw [h1, AlgEquiv.one_apply]
  rw [hw1]

theorem weil_odp_wit_val_prime_tower_and_kummer_inertia (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let k := AlgebraicClosure F
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    ∀ (B_V L_V : ℕ → Type u)
      [∀ r, CommRing (B_V r)] [∀ r, IsDomain (B_V r)] [∀ r, Field (L_V r)]
      [∀ r, Algebra F (B_V r)] [∀ r, Algebra (Polynomial F) (B_V r)] [∀ r, Algebra R₀ (B_V r)]
      [∀ r, Algebra F (L_V r)] [∀ r, Algebra (Polynomial F) (L_V r)]
      [∀ r, Algebra (RatFunc F) (L_V r)] [∀ r, Algebra (B_V r) (L_V r)] [∀ r, Algebra R₀ (L_V r)]
      [∀ r, IsScalarTower F (Polynomial F) (B_V r)] [∀ r, IsScalarTower (Polynomial F) R₀ (B_V r)]
      [∀ r, IsScalarTower F (RatFunc F) (L_V r)]
      [∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_V r)]
      [∀ r, IsScalarTower (Polynomial F) (B_V r) (L_V r)]
      [∀ r, IsScalarTower R₀ (B_V r) (L_V r)]
      [∀ r, Module.Finite R₀ (B_V r)] [∀ r, Algebra.Etale R₀ (B_V r)]
      [∀ r, IsFractionRing (B_V r) (L_V r)] [∀ r, IsIntegralClosure (B_V r) R₀ (L_V r)]
      [∀ r, FiniteDimensional (RatFunc F) (L_V r)] [∀ r, IsGalois (RatFunc F) (L_V r)]
      (ρ_V : ∀ r : ℕ, (B_V r ≃ₐ[R₀] B_V r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
      (hρ_inj : ∀ r : ℕ, Function.Injective (ρ_V r))
      (ι_BV : ∀ r : ℕ, B_V r →ₐ[R₀] B_V (r + 1))
      (hι_inj : ∀ r : ℕ, Function.Injective (ι_BV r))
      (hι_res : ∀ (r : ℕ) (τ : B_V (r + 1) ≃ₐ[R₀] B_V (r + 1)),
        ∃ σ : B_V r ≃ₐ[R₀] B_V r, ∀ b : B_V r, τ (ι_BV r b) = ι_BV r (σ b))
      (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
      (p_R : P →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k) (φ_R_Ω : R_bar →+* Ω)
      (ht_eq : p_R Polynomial.X = t_bar)
      (hπ_pR : π_cl.comp p_R = Polynomial.evalRingHom 0)
      (hφ_pR : φ_R_Ω.comp p_R = algebraMap P Ω)
      (hφ_inj : Function.Injective φ_R_Ω)
      (hLoc_R : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra)
      (α_pt : RatFunc F ≃ₐ[F] RatFunc F)
      (t_pt : RatFunc F)
      (hα_pt : α_pt RatFunc.X = t_pt)
      (ψ_k : RatFunc F →+* FractionRing P)
      (ψ_pt : RatFunc F →+* Ω)
      (hψ_pt_eq : ψ_pt = (algebraMap (FractionRing P) Ω).comp ψ_k)
      (hψ_k_F : ψ_k.comp (algebraMap F (RatFunc F)) =
        (algebraMap P (FractionRing P)).comp (Polynomial.C.comp (algebraMap F k)))
      (hψ_k_t : ψ_k t_pt = algebraMap P (FractionRing P) Polynomial.X),
      ∃ (V_s : ValuationSubring Ω)
        (j_val : R_bar →+* ↥V_s)
        (π_Vs : ↥V_s →+* k)
        (ι_L : ∀ r : ℕ, L_V r →+* Ω)
        (Q_pt : ∀ r : ℕ,
          Ideal ↥(integralClosure
            ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r)))
            (L_V r)))
        (I_Vs : Subgroup (Ω ≃ₐ[FractionRing P] Ω))
        (res_L : ∀ r : ℕ, ↥I_Vs →* (L_V r ≃ₐ[RatFunc F] L_V r))
        (res_B : ∀ r : ℕ, ↥I_Vs →* (B_V r ≃ₐ[R₀] B_V r))
        (t_ℓ : ↥I_Vs → PadicInt ℓ),
        (IsLocalHom j_val ∧
          V_s.subtype.comp j_val = φ_R_Ω ∧
          RingHom.ker π_Vs = IsLocalRing.maximalIdeal ↥V_s ∧
          π_Vs.comp j_val = π_cl) ∧
        ((∀ γ : Ω ≃ₐ[FractionRing P] Ω, γ ∈ I_Vs ↔ ∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) ∧
          t_ℓ 1 = 0 ∧
          (∀ γ₁ γ₂ : ↥I_Vs, t_ℓ (γ₁ * γ₂) = t_ℓ γ₁ + t_ℓ γ₂) ∧
          Function.Surjective t_ℓ) ∧
        (∀ r : ℕ,
          let A_pt_r := Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))
          let gen_pt_r : ↥A_pt_r :=
            ⟨algebraMap (RatFunc F) (L_V r) t_pt, Algebra.self_mem_adjoin_singleton F _⟩
          let C_pt_r := integralClosure ↥A_pt_r (L_V r)
          let A_pt_succ :=
            Algebra.adjoin F ({algebraMap (RatFunc F) (L_V (r + 1)) t_pt} : Set (L_V (r + 1)))
          let C_pt_succ := integralClosure ↥A_pt_succ (L_V (r + 1))
          (ι_L r).comp (algebraMap (RatFunc F) (L_V r)) = ψ_pt ∧
          (∀ b : B_V r,
            ι_L (r + 1) (algebraMap (B_V (r + 1)) (L_V (r + 1)) (ι_BV r b)) =
              ι_L r (algebraMap (B_V r) (L_V r) b)) ∧
          (Q_pt r).IsPrime ∧
          Ideal.comap (algebraMap ↥A_pt_r ↥C_pt_r) (Q_pt r) = Ideal.span {gen_pt_r} ∧
          (∀ γ : ↥I_Vs,
            (∀ z : L_V r, γ.1 (ι_L r z) = ι_L r (res_L r γ z)) ∧
            (∀ x : L_V r, IsIntegral F x → res_L r γ x = x) ∧
            (∀ b : B_V r,
              res_L r γ (algebraMap (B_V r) (L_V r) b) =
                algebraMap (B_V r) (L_V r) (res_B r γ b)) ∧
            (∀ b : B_V r, res_B (r + 1) γ (ι_BV r b) = ι_BV r (res_B r γ b)) ∧
            (∀ y : ↥C_pt_r,
              res_L r γ (y : L_V r) - (y : L_V r) ∈
                Subtype.val '' (Q_pt r : Set ↥C_pt_r))) ∧
          (∀ σ_B : B_V r ≃ₐ[R₀] B_V r,
            (∃ σ_L : L_V r ≃ₐ[RatFunc F] L_V r,
              (∀ x : L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : B_V r, σ_L (algebraMap (B_V r) (L_V r) b) =
                algebraMap (B_V r) (L_V r) (σ_B b)) ∧
              (∀ y : ↥C_pt_r,
                σ_L (y : L_V r) - (y : L_V r) ∈
                  Subtype.val '' (Q_pt r : Set ↥C_pt_r))) ↔
            (∃ (τ_L : L_V (r + 1) ≃ₐ[RatFunc F] L_V (r + 1))
               (τ_B : B_V (r + 1) ≃ₐ[R₀] B_V (r + 1)),
              (∀ x : L_V (r + 1), IsIntegral F x → τ_L x = x) ∧
              (∀ b : B_V (r + 1), τ_L (algebraMap (B_V (r + 1)) (L_V (r + 1)) b) =
                algebraMap (B_V (r + 1)) (L_V (r + 1)) (τ_B b)) ∧
              (∀ y : ↥C_pt_succ,
                τ_L (y : L_V (r + 1)) - (y : L_V (r + 1)) ∈
                  Subtype.val '' (Q_pt (r + 1) : Set ↥C_pt_succ)) ∧
              (∀ b : B_V r, τ_B (ι_BV r b) = ι_BV r (σ_B b)))) ∧
          (∀ (σ_L : L_V r ≃ₐ[RatFunc F] L_V r) (σ_B : B_V r ≃ₐ[R₀] B_V r),
            (∀ x : L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : B_V r, σ_L (algebraMap (B_V r) (L_V r) b) =
              algebraMap (B_V r) (L_V r) (σ_B b)) →
            (∀ y : ↥C_pt_r,
              σ_L (y : L_V r) - (y : L_V r) ∈
                Subtype.val '' (Q_pt r : Set ↥C_pt_r)) →
            ∃ γ : ↥I_Vs, res_L r γ = σ_L ∧ res_B r γ = σ_B) ∧
          ((∀ γ : ↥I_Vs, ((ρ_V r (res_B r γ)).val - 1) ^ 2 = 0) →
            ∀ δ : ↥I_Vs, PadicInt.toZModPow (r + 1) (t_ℓ δ) = 0 → res_B r δ = 1)) :=
by
  classical
  intro R₀ k P Ω B_V L_V _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    ρ_V hρ_inj ι_BV hι_inj _hι_res
    R_bar _ _ _ p_R t_bar π_cl φ_R_Ω ht_eq hπ_pR hφ_pR _hφ_inj _hLoc_R
    α_pt t_pt hα_pt ψ_k ψ_pt hψ_pt_eq hψ_k_F hψ_k_t
  let K_k := FractionRing P

  obtain ⟨V_s, j_val, π_Vs, hX_mem, hj_loc, hj_sub, hπ_ker, hπ_comp,
    hX_max, hC_mem_π, hRes_triv, hRank1Max⟩ :=
    weil_odp_wit_val_subring_residue_and_rank1_max k R_bar p_R t_bar π_cl φ_R_Ω
      ht_eq hπ_pR hφ_pR
  have hC_mem : ∀ c : k, algebraMap P Ω (Polynomial.C c) ∈ V_s :=
    fun c => (hC_mem_π c).1

  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
    have hF0 : (ℓ : F) = 0 := by
      apply (algebraMap F k).injective
      rw [map_natCast, h0, map_zero]
    have hdvd : ringChar F ∣ ℓ := ringChar.dvd hF0
    rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd (ringChar F) hdvd with h1 | heq
    · exact CharP.char_ne_one F (ringChar F) h1
    · exact hℓ heq.symm

  let I_Vs : Subgroup (Ω ≃ₐ[K_k] Ω) :=
    { carrier := { γ | ∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s }
      one_mem' := fun _ => Iff.rfl
      mul_mem' := fun {γ₁ γ₂} h₁ h₂ z => (h₂ z).trans (h₁ (γ₂ z))
      inv_mem' := fun {γ} hγ z => by
        have h := hγ (γ⁻¹ z)
        have happ : γ (γ⁻¹ z) = z := γ.apply_symm_apply z
        rw [happ] at h
        exact h.symm }
  have hI_Vs_mem : ∀ γ : Ω ≃ₐ[K_k] Ω, γ ∈ I_Vs ↔ ∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s :=
    fun _ => Iff.rfl

  obtain ⟨t_ℓ, ht_one, ht_mul, ht_surj, hAbh⟩ :=
    weil_odp_wit_kummer_character_and_abhyankar_kernel k ℓ hℓ_k V_s π_Vs hX_mem
      hπ_ker hX_max hC_mem_π hRank1Max
      (weil_odp_wit_val_stabilizer_profinite_galois_lift k V_s hX_mem hX_max hC_mem hRank1Max)
      I_Vs hI_Vs_mem

  let P_prod : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  have hP_ne : P_prod ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun s _ => Polynomial.X_sub_C_ne_zero s
  have hle_nzd : Submonoid.powers P_prod ≤ nonZeroDivisors (Polynomial F) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hP_ne)
  let _ : IsDomain R₀ :=
    IsLocalization.isDomain_of_le_nonZeroDivisors R₀ hle_nzd
  have hR₀_units : ∀ y : Submonoid.powers P_prod,
      IsUnit (algebraMap (Polynomial F) (RatFunc F) y) := fun y =>
    IsUnit.mk0 _ fun h0 =>
      mem_nonZeroDivisors_iff_ne_zero.mp (hle_nzd y.2)
        ((IsFractionRing.injective (Polynomial F) (RatFunc F)) (h0.trans (map_zero _).symm))
  let f_R₀_RF : R₀ →+* RatFunc F := IsLocalization.lift (S := R₀) hR₀_units
  let _ : Algebra R₀ (RatFunc F) := f_R₀_RF.toAlgebra
  have hST_P_R₀_RF : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
    IsScalarTower.of_algebraMap_eq fun p => (IsLocalization.lift_eq (S := R₀) hR₀_units p).symm
  let _ : IsScalarTower (Polynomial F) R₀ (RatFunc F) := hST_P_R₀_RF
  let _ : IsFractionRing R₀ (RatFunc F) :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
      (Submonoid.powers P_prod) R₀ (RatFunc F)
  have hST_R₀_RF_L : ∀ r : ℕ, IsScalarTower R₀ (RatFunc F) (L_V r) := by
    intro r
    refine IsScalarTower.of_algebraMap_eq' ?_
    refine IsLocalization.ringHom_ext (Submonoid.powers P_prod) ?_
    refine RingHom.ext fun p => ?_
    simp only [RingHom.comp_apply]
    rw [IsScalarTower.algebraMap_apply R₀ (B_V r) (L_V r),
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B_V r) p,
      ← IsScalarTower.algebraMap_apply (Polynomial F) (B_V r) (L_V r) p,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (RatFunc F) p,
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (L_V r) p]
  let _ : ∀ r : ℕ, IsScalarTower R₀ (RatFunc F) (L_V r) := hST_R₀_RF_L

  have hStepL : ∀ r : ℕ,
      ∃ instL : Algebra (L_V r) (L_V (r + 1)),
        letI : Algebra (L_V r) (L_V (r + 1)) := instL
        FiniteDimensional (L_V r) (L_V (r + 1)) ∧
        (∀ b : B_V r,
          algebraMap (L_V r) (L_V (r + 1)) (algebraMap (B_V r) (L_V r) b) =
            algebraMap (B_V (r + 1)) (L_V (r + 1)) (ι_BV r b)) ∧
        (algebraMap (L_V r) (L_V (r + 1))).comp (algebraMap (RatFunc F) (L_V r)) =
          algebraMap (RatFunc F) (L_V (r + 1)) := by
    intro r
    let g_r : B_V r →+* L_V (r + 1) :=
      (algebraMap (B_V (r + 1)) (L_V (r + 1))).comp (ι_BV r).toRingHom
    have hg_inj : Function.Injective g_r :=
      (IsFractionRing.injective (B_V (r + 1)) (L_V (r + 1))).comp (hι_inj r)
    have hg_units : ∀ y : nonZeroDivisors (B_V r), IsUnit (g_r y) := fun y =>
      IsUnit.mk0 _ fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hg_inj (h0.trans (map_zero _).symm))
    let f_L : L_V r →+* L_V (r + 1) := IsLocalization.lift (S := L_V r) hg_units
    let instL : Algebra (L_V r) (L_V (r + 1)) := f_L.toAlgebra
    let _ : Algebra (L_V r) (L_V (r + 1)) := instL
    have hB : ∀ b : B_V r,
        algebraMap (L_V r) (L_V (r + 1)) (algebraMap (B_V r) (L_V r) b) =
          algebraMap (B_V (r + 1)) (L_V (r + 1)) (ι_BV r b) :=
      fun b => IsLocalization.lift_eq (S := L_V r) hg_units b
    have hRF : (algebraMap (L_V r) (L_V (r + 1))).comp (algebraMap (RatFunc F) (L_V r)) =
        algebraMap (RatFunc F) (L_V (r + 1)) := by
      refine IsLocalization.ringHom_ext (nonZeroDivisors R₀) ?_
      ext r₀
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply R₀ (RatFunc F) (L_V r) r₀,
        ← IsScalarTower.algebraMap_apply R₀ (RatFunc F) (L_V (r + 1)) r₀,
        IsScalarTower.algebraMap_apply R₀ (B_V r) (L_V r) r₀, hB]
      rw [(ι_BV r).commutes r₀, ← IsScalarTower.algebraMap_apply R₀ (B_V (r + 1)) (L_V (r + 1)) r₀]
    let _ : IsScalarTower (RatFunc F) (L_V r) (L_V (r + 1)) :=
      IsScalarTower.of_algebraMap_eq' hRF.symm
    exact ⟨instL, FiniteDimensional.right (RatFunc F) (L_V r) (L_V (r + 1)), hB, hRF⟩

  choose instL hStepL_spec using hStepL
  have hFD_step : ∀ r : ℕ,
      letI : Algebra (L_V r) (L_V (r + 1)) := instL r
      FiniteDimensional (L_V r) (L_V (r + 1)) := fun r => (hStepL_spec r).1
  have hB_step : ∀ (r : ℕ) (b : B_V r),
      @algebraMap (L_V r) (L_V (r + 1)) _ _ (instL r) (algebraMap (B_V r) (L_V r) b) =
        algebraMap (B_V (r + 1)) (L_V (r + 1)) (ι_BV r b) := fun r => (hStepL_spec r).2.1
  have hRF_step : ∀ r : ℕ,
      (@algebraMap (L_V r) (L_V (r + 1)) _ _ (instL r)).comp (algebraMap (RatFunc F) (L_V r)) =
        algebraMap (RatFunc F) (L_V (r + 1)) := fun r => (hStepL_spec r).2.2

  let lift0 : L_V 0 →+* Ω :=
    letI : Algebra (RatFunc F) Ω := ψ_pt.toAlgebra
    (IsAlgClosed.lift : L_V 0 →ₐ[RatFunc F] Ω).toRingHom
  have hlift0 : lift0.comp (algebraMap (RatFunc F) (L_V 0)) = ψ_pt := by
    let _ : Algebra (RatFunc F) Ω := ψ_pt.toAlgebra
    ext q
    exact (IsAlgClosed.lift : L_V 0 →ₐ[RatFunc F] Ω).commutes q

  let liftSucc : ∀ (r : ℕ) (ih : L_V r →+* Ω), L_V (r + 1) →+* Ω := fun r ih =>
    letI : Algebra (L_V r) (L_V (r + 1)) := instL r
    letI : FiniteDimensional (L_V r) (L_V (r + 1)) := hFD_step r
    letI : Algebra (L_V r) Ω := ih.toAlgebra
    (IsAlgClosed.lift : L_V (r + 1) →ₐ[L_V r] Ω).toRingHom
  have hliftSucc : ∀ (r : ℕ) (ih : L_V r →+* Ω) (z : L_V r),
      liftSucc r ih (@algebraMap (L_V r) (L_V (r + 1)) _ _ (instL r) z) = ih z := by
    intro r ih z
    let _ : Algebra (L_V r) (L_V (r + 1)) := instL r
    let _ : FiniteDimensional (L_V r) (L_V (r + 1)) := hFD_step r
    let _ : Algebra (L_V r) Ω := ih.toAlgebra
    exact (IsAlgClosed.lift : L_V (r + 1) →ₐ[L_V r] Ω).commutes z

  let ι_L : ∀ r : ℕ, L_V r →+* Ω := fun r => Nat.rec lift0 liftSucc r
  have hι_step : ∀ (r : ℕ) (z : L_V r),
      ι_L (r + 1) (@algebraMap (L_V r) (L_V (r + 1)) _ _ (instL r) z) = ι_L r z :=
    fun r z => hliftSucc r (ι_L r) z

  have hι_B_compat : ∀ (r : ℕ) (b : B_V r),
      ι_L (r + 1) (algebraMap (B_V (r + 1)) (L_V (r + 1)) (ι_BV r b)) =
        ι_L r (algebraMap (B_V r) (L_V r) b) := by
    intro r b
    rw [← hB_step r b, hι_step r]

  have hι_RF : ∀ r : ℕ, (ι_L r).comp (algebraMap (RatFunc F) (L_V r)) = ψ_pt := by
    intro r
    induction r with
    | zero => exact hlift0
    | succ r ih =>
      ext q
      simp only [RingHom.comp_apply, ← hRF_step r]
      rw [hι_step r]
      exact RingHom.congr_fun ih q

  have hψ_pt_t : ψ_pt t_pt = algebraMap P Ω Polynomial.X := by
    rw [hψ_pt_eq, RingHom.comp_apply, hψ_k_t, ← IsScalarTower.algebraMap_apply P K_k Ω]

  have hψ_pt_F : ∀ c : F,
      ψ_pt (algebraMap F (RatFunc F) c) = algebraMap P Ω (Polynomial.C (algebraMap F k c)) := by
    intro c
    have hc := RingHom.congr_fun hψ_k_F c
    simp only [RingHom.comp_apply] at hc
    rw [hψ_pt_eq, RingHom.comp_apply, hc, ← IsScalarTower.algebraMap_apply P K_k Ω]

  have hι_F : ∀ (r : ℕ) (c : F),
      ι_L r (algebraMap F (L_V r) c) = algebraMap P Ω (Polynomial.C (algebraMap F k c)) := by
    intro r c
    rw [IsScalarTower.algebraMap_apply F (RatFunc F) (L_V r) c]
    exact (RingHom.congr_fun (hι_RF r) (algebraMap F (RatFunc F) c)).trans (hψ_pt_F c)

  have hι_t : ∀ r : ℕ,
      ι_L r (algebraMap (RatFunc F) (L_V r) t_pt) = algebraMap P Ω Polynomial.X := by
    intro r
    exact (RingHom.congr_fun (hι_RF r) t_pt).trans hψ_pt_t

  have hA_mem : ∀ (r : ℕ)
      (a : ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r)))),
      ι_L r a.1 ∈ V_s := by
    intro r a
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ a.2
    · intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx, hι_t r]
      exact hX_mem
    · intro c
      rw [hι_F r c]
      exact hC_mem (algebraMap F k c)
    · intro x y _ _ hx hy
      rw [map_add]
      exact add_mem hx hy
    · intro x y _ _ hx hy
      rw [map_mul]
      exact mul_mem hx hy

  let ι_A : ∀ r : ℕ,
      ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))) →+* ↥V_s :=
    fun r =>
      { toFun := fun a => ⟨ι_L r a.1, hA_mem r a⟩
        map_one' := Subtype.ext (map_one (ι_L r))
        map_mul' := fun _ _ => Subtype.ext (map_mul (ι_L r) _ _)
        map_zero' := Subtype.ext (map_zero (ι_L r))
        map_add' := fun _ _ => Subtype.ext (map_add (ι_L r) _ _) }

  have hC_mem_Vs : ∀ (r : ℕ)
      (y : ↥(integralClosure
        ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))) (L_V r))),
      ι_L r y.1 ∈ V_s := by
    intro r y
    obtain ⟨p, hp_monic, hp_eval⟩ := y.2
    have hInt_Vs : IsIntegral ↥V_s (ι_L r y.1) := by
      refine ⟨p.map (ι_A r), hp_monic.map (ι_A r), ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp : V_s.subtype.comp (ι_A r) =
          (ι_L r).comp (algebraMap _ (L_V r)) := by
        ext a
        rfl
      change Polynomial.eval₂ (V_s.subtype.comp (ι_A r)) (ι_L r y.1) p = 0
      rw [hcomp, ← Polynomial.hom_eval₂, hp_eval, map_zero]
    obtain ⟨v, hv⟩ := IsIntegrallyClosed.isIntegral_iff.mp hInt_Vs
    rw [← hv]
    exact v.2

  let ι_C : ∀ r : ℕ,
      ↥(integralClosure
        ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))) (L_V r)) →+*
        ↥V_s :=
    fun r =>
      { toFun := fun y => ⟨ι_L r y.1, hC_mem_Vs r y⟩
        map_one' := Subtype.ext (map_one (ι_L r))
        map_mul' := fun _ _ => Subtype.ext (map_mul (ι_L r) _ _)
        map_zero' := Subtype.ext (map_zero (ι_L r))
        map_add' := fun _ _ => Subtype.ext (map_add (ι_L r) _ _) }

  let Q_pt : ∀ r : ℕ,
      Ideal ↥(integralClosure
        ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))) (L_V r)) :=
    fun r => Ideal.comap (ι_C r) (IsLocalRing.maximalIdeal ↥V_s)

  have hQ_prime : ∀ r : ℕ, (Q_pt r).IsPrime :=
    fun r => Ideal.IsPrime.comap (ι_C r)

  have hQ_iff : ∀ (r : ℕ)
      (y : ↥(integralClosure
        ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))) (L_V r))),
      y ∈ Q_pt r ↔ ∃ hy : ι_L r y.1 ∈ V_s, (⟨ι_L r y.1, hy⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s := by
    intro r y
    constructor
    · intro hy
      exact ⟨hC_mem_Vs r y, hy⟩
    · rintro ⟨hy, hmax⟩
      exact hmax

  have hQ_comap : ∀ r : ℕ,
      let A_pt_r := Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))
      let gen_pt_r : ↥A_pt_r :=
        ⟨algebraMap (RatFunc F) (L_V r) t_pt, Algebra.self_mem_adjoin_singleton F _⟩
      let C_pt_r := integralClosure ↥A_pt_r (L_V r)
      Ideal.comap (algebraMap ↥A_pt_r ↥C_pt_r) (Q_pt r) = Ideal.span {gen_pt_r} := by
    intro r A_pt_r gen_pt_r C_pt_r
    let φ_AC : ↥A_pt_r →+* ↥V_s := (ι_C r).comp (algebraMap ↥A_pt_r ↥C_pt_r)
    have hφ_gen : φ_AC gen_pt_r = ⟨algebraMap P Ω Polynomial.X, hX_mem⟩ := by
      apply Subtype.ext
      exact hι_t r
    have hgen_mem : gen_pt_r ∈ Ideal.comap (algebraMap ↥A_pt_r ↥C_pt_r) (Q_pt r) := by
      change φ_AC gen_pt_r ∈ IsLocalRing.maximalIdeal ↥V_s
      rw [hφ_gen]
      exact hX_max
    apply le_antisymm
    · intro u hu
      have hu_mem : u.1 ∈ Algebra.adjoin F ({gen_pt_r.1} : Set (L_V r)) := u.2
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hu_mem
      obtain ⟨p, hp⟩ := hu_mem
      have hu_eq : Polynomial.aeval gen_pt_r p = u := by
        apply Subtype.ext
        have hval : (Polynomial.aeval gen_pt_r p : L_V r) =
            Polynomial.aeval gen_pt_r.1 p := by
          refine Polynomial.induction_on' p ?_ ?_
          · intro p₁ p₂ h₁ h₂
            rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]
          · intro n c
            rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, Subalgebra.coe_mul,
              Subalgebra.coe_pow, Polynomial.aeval_C, Polynomial.aeval_X, map_mul, map_pow,
              Polynomial.aeval_C, Polynomial.aeval_X]
            rfl
        exact hval.trans hp
      have hp_div : p = Polynomial.X * p.divX + Polynomial.C (p.coeff 0) :=
        (Polynomial.X_mul_divX_add p).symm
      let q_u : ↥A_pt_r := Polynomial.aeval gen_pt_r p.divX
      have hu_decomp : u = gen_pt_r * q_u + algebraMap F ↥A_pt_r (p.coeff 0) := by
        rw [← hu_eq]
        conv_lhs => rw [hp_div]
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      have hπ_u : π_Vs (φ_AC u) = 0 := by
        rw [← RingHom.mem_ker, hπ_ker]
        exact hu
      have hπ_gen : π_Vs (φ_AC gen_pt_r) = 0 := by
        rw [← RingHom.mem_ker, hπ_ker]
        exact hgen_mem
      have hπ_c : ∀ c : F, π_Vs (φ_AC (algebraMap F ↥A_pt_r c)) = algebraMap F k c := by
        intro c
        obtain ⟨hc_mem, hc_eq⟩ := hC_mem_π (algebraMap F k c)
        have hsub : φ_AC (algebraMap F ↥A_pt_r c) =
            ⟨algebraMap P Ω (Polynomial.C (algebraMap F k c)), hc_mem⟩ := by
          apply Subtype.ext
          exact hι_F r c
        rw [hsub, hc_eq]
      have h0 : algebraMap F k (p.coeff 0) = 0 := by
        have h1 := congrArg (π_Vs ∘ φ_AC) hu_decomp
        simp only [Function.comp_apply, map_add, map_mul, hπ_u, hπ_gen, zero_mul, zero_add,
          hπ_c] at h1
        exact h1.symm
      have hc0 : p.coeff 0 = 0 :=
        (algebraMap F k).injective (h0.trans (map_zero _).symm)
      rw [hu_decomp, hc0, map_zero, add_zero, Ideal.mem_span_singleton]
      exact ⟨q_u, rfl⟩
    · rw [Ideal.span_singleton_le_iff_mem]
      exact hgen_mem

  have hResL_ex : ∃ res_L : ∀ r : ℕ, ↥I_Vs →* (L_V r ≃ₐ[RatFunc F] L_V r),
      ∀ (r : ℕ) (γ : ↥I_Vs) (z : L_V r), γ.1 (ι_L r z) = ι_L r (res_L r γ z) := by
    let _ : Algebra (RatFunc F) Ω := ψ_pt.toAlgebra
    let toRF : (Ω ≃ₐ[K_k] Ω) →* (Ω ≃ₐ[RatFunc F] Ω) :=
      { toFun := fun γ =>
          { γ.toRingEquiv with
            commutes' := fun q => by
              change γ (ψ_pt q) = ψ_pt q
              rw [hψ_pt_eq, RingHom.comp_apply]
              exact γ.commutes (ψ_k q) }
        map_one' := by ext z; rfl
        map_mul' := fun _ _ => by ext z; rfl }
    let mk_res : ∀ r : ℕ, ↥I_Vs →* (L_V r ≃ₐ[RatFunc F] L_V r) := fun r =>
      let ι_alg : L_V r →ₐ[RatFunc F] Ω :=
        { ι_L r with commutes' := fun q => RingHom.congr_fun (hι_RF r) q }
      let E_sub : IntermediateField (RatFunc F) Ω := ι_alg.fieldRange
      let e_Lr : L_V r ≃ₐ[RatFunc F] ↥E_sub := AlgEquiv.ofInjectiveField ι_alg
      letI : Normal (RatFunc F) ↥E_sub := Normal.of_algEquiv e_Lr
      let conjInv : (↥E_sub ≃ₐ[RatFunc F] ↥E_sub) →* (L_V r ≃ₐ[RatFunc F] L_V r) :=
        { toFun := fun τ => e_Lr.trans (τ.trans e_Lr.symm)
          map_one' := by
            ext z
            exact e_Lr.symm_apply_apply z
          map_mul' := fun τ₁ τ₂ => by
            ext z
            simp only [AlgEquiv.mul_apply, AlgEquiv.trans_apply, e_Lr.apply_symm_apply] }
      conjInv.comp ((AlgEquiv.restrictNormalHom ↥E_sub).comp (toRF.comp I_Vs.subtype))
    refine ⟨mk_res, fun r γ z => ?_⟩
    let ι_alg : L_V r →ₐ[RatFunc F] Ω :=
      { ι_L r with commutes' := fun q => RingHom.congr_fun (hι_RF r) q }
    let E_sub : IntermediateField (RatFunc F) Ω := ι_alg.fieldRange
    let e_Lr : L_V r ≃ₐ[RatFunc F] ↥E_sub := AlgEquiv.ofInjectiveField ι_alg
    let _ : Normal (RatFunc F) ↥E_sub := Normal.of_algEquiv e_Lr
    let τ := (AlgEquiv.restrictNormalHom ↥E_sub) (toRF γ.1)
    have hcomm : (τ (e_Lr z) : Ω) = (toRF γ.1) (e_Lr z : Ω) :=
      AlgEquiv.restrictNormal_commutes (toRF γ.1) ↥E_sub (e_Lr z)
    have he_val : ∀ w : L_V r, (e_Lr w : Ω) = ι_L r w := fun _ => rfl
    change γ.1 (ι_L r z) = ι_L r (e_Lr.symm (τ (e_Lr z)))
    rw [← he_val (e_Lr.symm (τ (e_Lr z))), e_Lr.apply_symm_apply, hcomm]
    rfl

  obtain ⟨res_L, hres_L_comm⟩ := hResL_ex

  let res_B : ∀ r : ℕ, ↥I_Vs →* (B_V r ≃ₐ[R₀] B_V r) :=
    fun r => (galRestrict R₀ (RatFunc F) (L_V r) (B_V r)).toMonoidHom.comp (res_L r)

  have hres_LB : ∀ (r : ℕ) (γ : ↥I_Vs) (b : B_V r),
      res_L r γ (algebraMap (B_V r) (L_V r) b) =
        algebraMap (B_V r) (L_V r) (res_B r γ b) := by
    intro r γ b
    exact (algebraMap_galRestrict_apply R₀ (K := RatFunc F) (L := L_V r) (B := B_V r)
      (res_L r γ) b).symm

  have hres_B_step : ∀ (r : ℕ) (γ : ↥I_Vs) (b : B_V r),
      res_B (r + 1) γ (ι_BV r b) = ι_BV r (res_B r γ b) := by
    intro r γ b
    apply IsFractionRing.injective (B_V (r + 1)) (L_V (r + 1))
    apply (ι_L (r + 1)).injective
    rw [← hres_LB (r + 1) γ (ι_BV r b), ← hres_L_comm (r + 1) γ,
      hι_B_compat r b, hres_L_comm r γ, hres_LB r γ b, ← hι_B_compat r (res_B r γ b)]

  have hres_L_int : ∀ (r : ℕ) (γ : ↥I_Vs) (x : L_V r),
      IsIntegral F x → res_L r γ x = x := by
    intro r γ x hx
    let p : Polynomial F := minpoly F x
    have hp_monic : p.Monic := minpoly.monic hx
    let p_k : Polynomial k := p.map (algebraMap F k)
    have hpk_monic : p_k.Monic := hp_monic.map (algebraMap F k)
    have hpk_splits : p_k.Splits := IsAlgClosed.splits p_k
    have hprod_k : p_k = (p_k.roots.map (fun a : k => Polynomial.X - Polynomial.C a)).prod :=
      hpk_splits.eq_prod_roots_of_monic hpk_monic
    let i_k : k →+* Ω := (algebraMap P Ω).comp Polynomial.C
    have hi_k_F : i_k.comp (algebraMap F k) = (ι_L r).comp (algebraMap F (L_V r)) := by
      ext c
      exact (hι_F r c).symm
    have heval0 : Polynomial.eval (ι_L r x) (p_k.map i_k) = 0 := by
      rw [Polynomial.map_map, hi_k_F, Polynomial.eval_map, ← Polynomial.hom_eval₂]
      change ι_L r (Polynomial.aeval x p) = 0
      rw [minpoly.aeval F x, map_zero]
    rw [hprod_k, Polynomial.map_multiset_prod, Multiset.map_map, Polynomial.eval_multiset_prod,
      Multiset.map_map, Multiset.prod_eq_zero_iff, Multiset.mem_map] at heval0
    obtain ⟨c, _, hc_eval⟩ := heval0
    simp only [Function.comp_apply, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
      Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hc_eval
    apply (ι_L r).injective
    rw [← hres_L_comm r γ x, hc_eval]
    change γ.1 (algebraMap P Ω (Polynomial.C c)) = algebraMap P Ω (Polynomial.C c)
    rw [IsScalarTower.algebraMap_apply P K_k Ω]
    exact γ.1.commutes (algebraMap P K_k (Polynomial.C c))

  have hres_L_inert : ∀ (r : ℕ) (γ : ↥I_Vs),
      let A_pt_r := Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))
      let C_pt_r := integralClosure ↥A_pt_r (L_V r)
      ∀ y : ↥C_pt_r,
        res_L r γ (y : L_V r) - (y : L_V r) ∈ Subtype.val '' (Q_pt r : Set ↥C_pt_r) := by
    intro r γ A_pt_r C_pt_r y
    have hfix_A : ∀ a : ↥A_pt_r, res_L r γ a.1 = a.1 := by
      intro a
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ a.2
      · intro x hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact (res_L r γ).commutes t_pt
      · intro c
        rw [IsScalarTower.algebraMap_apply F (RatFunc F) (L_V r) c]
        exact (res_L r γ).commutes (algebraMap F (RatFunc F) c)
      · intro x₁ x₂ _ _ h₁ h₂
        rw [map_add, h₁, h₂]
      · intro x₁ x₂ _ _ h₁ h₂
        rw [map_mul, h₁, h₂]
    have hγy_mem : res_L r γ y.1 ∈ C_pt_r := by
      obtain ⟨p, hp_monic, hp_eval⟩ := y.2
      refine ⟨p, hp_monic, ?_⟩
      let f_γ : L_V r →+* L_V r := (res_L r γ).toRingHom
      have hcomp : f_γ.comp (algebraMap ↥A_pt_r (L_V r)) =
          algebraMap ↥A_pt_r (L_V r) := by
        ext a
        exact hfix_A a
      rw [← hcomp]
      change Polynomial.eval₂ (f_γ.comp (algebraMap ↥A_pt_r (L_V r))) (f_γ y.1) p = 0
      rw [← Polynomial.hom_eval₂, hp_eval, map_zero]
    let d : ↥C_pt_r := ⟨res_L r γ y.1 - y.1, C_pt_r.sub_mem hγy_mem y.2⟩
    refine ⟨d, ?_, rfl⟩
    obtain ⟨hz_mem, hz_diff⟩ := hRes_triv γ.1 ((hI_Vs_mem γ.1).mp γ.2) (ι_C r y)
    have hd_eq : ι_C r d = (⟨γ.1 (ι_C r y).1, hz_mem⟩ : ↥V_s) - ι_C r y := by
      apply Subtype.ext
      change ι_L r (res_L r γ y.1 - y.1) = γ.1 (ι_L r y.1) - ι_L r y.1
      rw [map_sub, hres_L_comm r γ y.1]
    change ι_C r d ∈ IsLocalRing.maximalIdeal ↥V_s
    rw [hd_eq]
    exact hz_diff

  have hLiftInert : ∀ (r : ℕ),
      let A_pt_r := Algebra.adjoin F ({algebraMap (RatFunc F) (L_V r) t_pt} : Set (L_V r))
      let C_pt_r := integralClosure ↥A_pt_r (L_V r)
      ∀ (σ_L : L_V r ≃ₐ[RatFunc F] L_V r) (σ_B : B_V r ≃ₐ[R₀] B_V r),
        (∀ x : L_V r, IsIntegral F x → σ_L x = x) →
        (∀ b : B_V r, σ_L (algebraMap (B_V r) (L_V r) b) =
          algebraMap (B_V r) (L_V r) (σ_B b)) →
        (∀ y : ↥C_pt_r,
          σ_L (y : L_V r) - (y : L_V r) ∈ Subtype.val '' (Q_pt r : Set ↥C_pt_r)) →
        ∃ γ : ↥I_Vs, res_L r γ = σ_L ∧ res_B r γ = σ_B := by
    intro r A_pt_r C_pt_r σ_L σ_B hInt hCompat hInert
    obtain ⟨⟨hEr_sep, _, _⟩, hExt_r⟩ :=
      weil_odp_wit_geom_inertia_compositum_extend F α_pt t_pt hα_pt ψ_k ψ_pt
        hψ_pt_eq hψ_k_F hψ_k_t V_s hX_mem hX_max hC_mem hRank1Max
        (L_V r) (ι_L r) (hι_RF r) (Q_pt r) (hQ_iff r)
    obtain ⟨σ_E, hσE_ext, hσE_Vs⟩ := hExt_r σ_L hInt hInert
    obtain ⟨γ₀, hγ₀_Vs, hγ₀_E⟩ :=
      weil_odp_wit_val_stabilizer_profinite_galois_lift k V_s hX_mem hX_max hC_mem hRank1Max
        (IntermediateField.adjoin K_k (Set.range (ι_L r))) hEr_sep σ_E hσE_Vs
    let γ : ↥I_Vs := ⟨γ₀, (hI_Vs_mem γ₀).mpr hγ₀_Vs⟩
    have hL_eq : res_L r γ = σ_L := by
      ext z
      obtain ⟨hz, hEq⟩ := hσE_ext z
      apply (ι_L r).injective
      rw [← hres_L_comm r γ z]
      exact (hγ₀_E ⟨ι_L r z, hz⟩).trans hEq
    have hB_eq : res_B r γ = σ_B := by
      ext b
      apply IsFractionRing.injective (B_V r) (L_V r)
      rw [← hres_LB r γ b, hL_eq, hCompat b]
    exact ⟨γ, hL_eq, hB_eq⟩

  have hUnipPow : ∀ {R : Type} [Ring R] (M : R), M ^ 2 = 0 →
      ∀ m : ℕ, (1 + M) ^ m = 1 + m • M := by
    intro R _ M hM2
    have hMM : M * M = 0 := by rwa [sq] at hM2
    have hnsmul_mul : ∀ m : ℕ, (m • M) * M = 0 := by
      intro m
      induction m with
      | zero => simp
      | succ m ih => rw [succ_nsmul, add_mul, ih, hMM, add_zero]
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, ih, succ_nsmul]
      calc
        (1 + m • M) * (1 + M) = 1 + M + m • M + (m • M) * M := by noncomm_ring
        _ = 1 + (m • M + M) := by rw [hnsmul_mul m, add_zero, add_assoc, add_comm M (m • M)]

  refine ⟨V_s, j_val, π_Vs, ι_L, Q_pt, I_Vs, res_L, res_B, t_ℓ,
    ⟨hj_loc, hj_sub, hπ_ker, hπ_comp⟩,
    ⟨hI_Vs_mem, ht_one, ht_mul, ht_surj⟩,
    fun r => ?_⟩
  refine ⟨hι_RF r, hι_B_compat r, hQ_prime r, hQ_comap r,
    fun γ => ⟨hres_L_comm r γ, hres_L_int r γ, hres_LB r γ, hres_B_step r γ, hres_L_inert r γ⟩,
    ?_, hLiftInert r, ?_⟩
  · intro σ_B
    constructor
    · rintro ⟨σ_L, hInt, hCompat, hInert⟩
      obtain ⟨γ, _, hB_eq⟩ := hLiftInert r σ_L σ_B hInt hCompat hInert
      refine ⟨res_L (r + 1) γ, res_B (r + 1) γ,
        hres_L_int (r + 1) γ, hres_LB (r + 1) γ, hres_L_inert (r + 1) γ, fun b => ?_⟩
      rw [hres_B_step r γ b, hB_eq]
    · rintro ⟨τ_L, τ_B, hInt', hCompat', hInert', hExt⟩
      obtain ⟨γ', _, hB'_eq⟩ := hLiftInert (r + 1) τ_L τ_B hInt' hCompat' hInert'
      have hBr_eq : res_B r γ' = σ_B := by
        ext b
        apply hι_inj r
        rw [← hres_B_step r γ' b, hB'_eq, hExt b]
      refine ⟨res_L r γ', hres_L_int r γ', fun b => ?_, hres_L_inert r γ'⟩
      rw [hres_LB r γ' b, hBr_eq]
  · intro hSq δ hδ0
    obtain ⟨⟨_, hEr_fd, hEr_gal⟩, _⟩ :=
      weil_odp_wit_geom_inertia_compositum_extend F α_pt t_pt hα_pt ψ_k ψ_pt
        hψ_pt_eq hψ_k_F hψ_k_t V_s hX_mem hX_max hC_mem hRank1Max
        (L_V r) (ι_L r) (hι_RF r) (Q_pt r) (hQ_iff r)
    let E_r : IntermediateField K_k Ω := IntermediateField.adjoin K_k (Set.range (ι_L r))
    let _ : FiniteDimensional K_k ↥E_r := hEr_fd
    let _ : IsGalois K_k ↥E_r := hEr_gal
    have hExp_Er : ∀ γ : ↥I_Vs, ∀ w : ↥E_r, ((γ.1 ^ (ℓ ^ (r + 1))) (w : Ω)) = (w : Ω) := by
      intro γ
      let M := (ρ_V r (res_B r γ)).val - 1
      have h1M : 1 + M = (ρ_V r (res_B r γ)).val := add_sub_cancel 1 _
      have hpow_mat : ((ρ_V r (res_B r γ)).val) ^ (ℓ ^ (r + 1)) = 1 := by
        rw [← h1M, hUnipPow M (hSq γ) (ℓ ^ (r + 1))]
        have hsmul0 : (ℓ ^ (r + 1)) • M = 0 := by
          ext i j
          simp only [Matrix.smul_apply, Matrix.zero_apply, nsmul_eq_mul,
            CharP.cast_eq_zero (ZMod (ℓ ^ (r + 1))) (ℓ ^ (r + 1)), zero_mul]
        rw [hsmul0, add_zero]
      have hρ_pow : ρ_V r ((res_B r γ) ^ (ℓ ^ (r + 1))) = 1 := by
        rw [map_pow]
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, hpow_mat, Units.val_one]
      have hresB_pow : (res_B r γ) ^ (ℓ ^ (r + 1)) = 1 :=
        hρ_inj r (hρ_pow.trans (map_one (ρ_V r)).symm)
      have hresL_pow : (res_L r γ) ^ (ℓ ^ (r + 1)) = 1 :=
        (galRestrict R₀ (RatFunc F) (L_V r) (B_V r)).injective
          (by rw [map_pow, map_one]; exact hresB_pow)
      have hγ_pow_ι : ∀ (m : ℕ) (z : L_V r),
          (γ.1 ^ m) (ι_L r z) = ι_L r (((res_L r γ) ^ m) z) := by
        intro m
        induction m with
        | zero => intro z; rfl
        | succ m ih =>
          intro z
          rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply,
            ih z, hres_L_comm r γ (((res_L r γ) ^ m) z)]
      let θ : Ω ≃ₐ[K_k] Ω := γ.1 ^ (ℓ ^ (r + 1))
      let F_θ : IntermediateField K_k Ω :=
        { carrier := { z : Ω | θ z = z }
          algebraMap_mem' := θ.commutes
          add_mem' := fun {a b} ha hb => by change θ (a + b) = a + b; rw [map_add, ha, hb]
          mul_mem' := fun {a b} ha hb => by change θ (a * b) = a * b; rw [map_mul, ha, hb]
          inv_mem' := fun {a} ha => by change θ a⁻¹ = a⁻¹; rw [map_inv₀, ha] }
      have hle : E_r ≤ F_θ := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨z, rfl⟩
        change (γ.1 ^ (ℓ ^ (r + 1))) (ι_L r z) = ι_L r z
        rw [hγ_pow_ι (ℓ ^ (r + 1)) z, hresL_pow, AlgEquiv.one_apply]
      intro w
      exact hle w.2
    have hδ_Er := hAbh r E_r hExp_Er δ hδ0
    have hδ_L : res_L r δ = 1 := by
      ext z
      apply (ι_L r).injective
      have hz_mem : ι_L r z ∈ E_r :=
        IntermediateField.subset_adjoin K_k (Set.range (ι_L r)) ⟨z, rfl⟩
      rw [← hres_L_comm r δ z]
      exact hδ_Er ⟨ι_L r z, hz_mem⟩
    change (galRestrict R₀ (RatFunc F) (L_V r) (B_V r)) (res_L r δ) = 1
    rw [hδ_L, map_one]

theorem weil_odp_wit_stalk_galois_torsor_diag_eval (R₀ K B_r L_r : Type u)
    [CommRing R₀] [IsDomain R₀] [Field K] [Algebra R₀ K] [IsFractionRing R₀ K]
    [CommRing B_r] [IsDomain B_r] [Field L_r]
    [Algebra R₀ B_r] [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
    [Algebra B_r L_r] [IsFractionRing B_r L_r] [Algebra K L_r] [Algebra R₀ L_r]
    [IsScalarTower R₀ K L_r] [IsScalarTower R₀ B_r L_r]
    [IsIntegralClosure B_r R₀ L_r] [FiniteDimensional K L_r] [IsGalois K L_r]
    (U : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U)
    (N m_mod : ℕ)
    (ρ_r : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin N) (Fin N) (ZMod m_mod))ˣ)
    (𝒱_r : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
    (triv_r : ∀ W : U.Etale,
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
      let π_r : Quiver.Hom V_r U := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
      let W_r := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom π_r
      ↑(𝒱_r.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_r (Fin N → ZMod m_mod))
    (_htriv_r :
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
      let π_r : Quiver.Hom V_r U := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
      let A_r : AddCommGrpCat.{u} :=
        AddCommGrpCat.uliftFunctor.{u, 0}.obj
          (AddCommGrpCat.of (Fin N → ZMod m_mod))
      WeilIsEtaleSheafPullback π_r 𝒱_r
        ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
      (∀ {W₁ W₂ : U.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₂).hom
        let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
        let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
        ∀ (u_r : Quiver.Hom W₁_r W₂_r),
          CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ π_r)
              ((AlgebraicGeometry.Scheme.Etale.forget U).map u).left →
          CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
            CategoryTheory.Limits.pullback.snd h₁ π_r →
          ∀ (s : ↑(𝒱_r.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
            triv_r W₁ ((𝒱_r.obj.map (Opposite.op u)) s) y₁ =
              triv_r W₂ s (u_r.base y₁)) ∧
      ∀ (W : U.Etale),
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        let W_r := CategoryTheory.Limits.pullback h_W π_r
        Function.Injective (triv_r W) ∧
        Set.range (triv_r W) =
          { f | ∀ (σ : B_r ≃ₐ[R₀] B_r) (m_σ : Quiver.Hom W_r W_r),
            CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_r →
            CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_r)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
            ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_r σ).val).mulVec (f y) })
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ι_B : B_r →+* Ω)
    (η_U : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U)
    (hη_U : η_U = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B) ≫
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r)) ≫ e_U.hom))
    [hc_η : (weilEtaleSitePullback η_U).IsContinuous
      U.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology]
    [hr_η : ((weilEtaleSitePullback η_U).sheafPushforwardContinuous AddCommGrpCat.{u}
      U.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology).IsRightAdjoint] :
    let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
    let π_r : V_r ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r)) ≫ e_U.hom
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let η_V : S_Ω ⟶ V_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
    let T_Ω : S_Ω.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S_Ω)
    let pb_η := (weilEtaleSitePullback η_U).sheafPullback AddCommGrpCat.{u}
      U.smallEtaleTopology S_Ω.smallEtaleTopology
    let adj_η := (weilEtaleSitePullback η_U).sheafAdjunctionContinuous AddCommGrpCat.{u}
      U.smallEtaleTopology S_Ω.smallEtaleTopology
    ∃ (hπ_et : AlgebraicGeometry.Etale π_r),
      letI : AlgebraicGeometry.Etale π_r := hπ_et
      let E_V : U.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
      ∃ (σ_ηV : T_Ω ⟶ (weilEtaleSitePullback η_U).obj E_V)
        (ev_V : ↑(𝒱_r.obj.obj (Opposite.op E_V)) ≃+ (Fin N → ZMod m_mod)),
        (((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map σ_ηV).left ≫
            CategoryTheory.Limits.pullback.fst π_r η_U = η_V ∧
          ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map σ_ηV).left ≫
            CategoryTheory.Limits.pullback.snd π_r η_U = 𝟙 S_Ω) ∧
        (∀ (σ_B : B_r ≃ₐ[R₀] B_r) (s_σ : E_V ⟶ E_V),
          ((AlgebraicGeometry.Scheme.Etale.forget U).map s_σ).left =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B.toRingHom) →
          ∀ s : ↑(𝒱_r.obj.obj (Opposite.op E_V)),
            ev_V ((𝒱_r.obj.map (Opposite.op s_σ)).hom s) =
              ((ρ_r σ_B).val).mulVec (ev_V s)) ∧
        Function.Bijective (fun s : ↑(𝒱_r.obj.obj (Opposite.op E_V)) =>
          ((pb_η.obj 𝒱_r).obj.map (Opposite.op σ_ηV)).hom
            (((adj_η.unit.app 𝒱_r).hom.app (Opposite.op E_V)).hom s)) :=
by
  classical
  intro V_r π_r S_Ω η_V T_Ω pb_η adj_η
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et η_U :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et η_U :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  
  obtain ⟨hInj, m_gal, equiv_Γ, e_idemp, hIdemp, hOrth, hSum, hEval, hAbsorb⟩ :=
    weil_etale_galois_domain_idempotents_and_aut_lift.{u}.1 R₀ B_r K L_r
  obtain ⟨⟨hπ_et, _⟩, _, hSheets⟩ :=
    weil_scheme_galois_torsor_clopen_sheets.{u} R₀ B_r hInj m_gal equiv_Γ e_idemp
      hIdemp hOrth hSum hEval hAbsorb U e_U

  refine ⟨hπ_et, ?_⟩
  have _ : AlgebraicGeometry.Etale π_r := hπ_et
  let E_V : U.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
  let B_η := weilEtaleSitePullback η_U
  let FgtU := AlgebraicGeometry.Scheme.Etale.forget U
  let FgtΩ := AlgebraicGeometry.Scheme.Etale.forget S_Ω

  
  have hηV_π : η_V ≫ π_r = η_U := hη_U.symm
  have hσ_cond : η_V ≫ π_r = 𝟙 S_Ω ≫ η_U :=
    hηV_π.trans (CategoryTheory.Category.id_comp η_U).symm
  let s_ηV_left : S_Ω ⟶ CategoryTheory.Limits.pullback π_r η_U :=
    CategoryTheory.Limits.pullback.lift η_V (𝟙 S_Ω) hσ_cond
  let σ_ηV : T_Ω ⟶ B_η.obj E_V :=
    CategoryTheory.MorphismProperty.Over.homMk s_ηV_left
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
  have hσ_fst : (FgtΩ.map σ_ηV).left ≫ CategoryTheory.Limits.pullback.fst π_r η_U = η_V :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hσ_snd : (FgtΩ.map σ_ηV).left ≫ CategoryTheory.Limits.pullback.snd π_r η_U = 𝟙 S_Ω :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  
  let d_V : (B_r ≃ₐ[R₀] B_r) → (V_r ⟶ V_r) :=
    fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
  have hd_V_π : ∀ σ : B_r ≃ₐ[R₀] B_r, d_V σ ≫ π_r = π_r := by
    intro σ
    dsimp only [d_V, π_r]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R₀ B_r) ≫
        CommRingCat.ofHom σ.symm.toRingHom =
        CommRingCat.ofHom (algebraMap R₀ B_r) :=
      CommRingCat.hom_ext (RingHom.ext fun r => σ.symm.commutes r)
    rw [hcomm]
  have hd_V_one : d_V 1 = 𝟙 V_r := by
    dsimp only [d_V, V_r]
    have hid : CommRingCat.ofHom (1 : B_r ≃ₐ[R₀] B_r).symm.toRingHom =
        𝟙 (CommRingCat.of B_r) :=
      CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
    rw [hid, AlgebraicGeometry.Spec.map_id]
  have hd_V_mul : ∀ σ τ : B_r ≃ₐ[R₀] B_r, d_V σ ≫ d_V τ = d_V (τ * σ) := by
    intro σ τ
    dsimp only [d_V]
    rw [← AlgebraicGeometry.Spec.map_comp]
    rfl

  let m_can : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ U) (_ : B_r ≃ₐ[R₀] B_r),
      CategoryTheory.Limits.pullback h π_r ⟶ CategoryTheory.Limits.pullback h π_r :=
    fun h σ =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h π_r)
        (CategoryTheory.Limits.pullback.snd h π_r ≫ d_V σ)
        (by rw [CategoryTheory.Category.assoc, hd_V_π σ,
              CategoryTheory.Limits.pullback.condition])

  let V_r2 := CategoryTheory.Limits.pullback π_r π_r
  obtain ⟨δ₀, hδ₀_props, hδ₀_disj, hδ₀_cov, _⟩ := hSheets V_r (𝟙 V_r)
  let e_congr : CategoryTheory.Limits.pullback (𝟙 V_r ≫ π_r) π_r ≅ V_r2 :=
    CategoryTheory.Limits.pullback.congrHom (CategoryTheory.Category.id_comp π_r) rfl
  let δ_V : (B_r ≃ₐ[R₀] B_r) → (V_r ⟶ V_r2) :=
    fun σ => δ₀ σ ≫ e_congr.hom

  have he_congr_fst : e_congr.hom ≫ CategoryTheory.Limits.pullback.fst π_r π_r =
      CategoryTheory.Limits.pullback.fst (𝟙 V_r ≫ π_r) π_r := by
    dsimp only [e_congr]
    rw [CategoryTheory.Limits.pullback.congrHom_hom]
    exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
      (CategoryTheory.Category.comp_id _)
  have he_congr_snd : e_congr.hom ≫ CategoryTheory.Limits.pullback.snd π_r π_r =
      CategoryTheory.Limits.pullback.snd (𝟙 V_r ≫ π_r) π_r := by
    dsimp only [e_congr]
    rw [CategoryTheory.Limits.pullback.congrHom_hom]
    exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
      (CategoryTheory.Category.comp_id _)

  have hδ_V_fst : ∀ σ : B_r ≃ₐ[R₀] B_r,
      δ_V σ ≫ CategoryTheory.Limits.pullback.fst π_r π_r = 𝟙 V_r := by
    intro σ
    dsimp only [δ_V]
    rw [CategoryTheory.Category.assoc, he_congr_fst]
    exact (hδ₀_props σ).1
  have hδ_V_snd : ∀ σ : B_r ≃ₐ[R₀] B_r,
      δ_V σ ≫ CategoryTheory.Limits.pullback.snd π_r π_r = d_V σ := by
    intro σ
    dsimp only [δ_V]
    rw [CategoryTheory.Category.assoc, he_congr_snd, (hδ₀_props σ).2.1,
      CategoryTheory.Category.id_comp]
  have hδ_V_et : ∀ σ : B_r ≃ₐ[R₀] B_r, AlgebraicGeometry.Etale (δ_V σ) :=
    fun σ => CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem
      (P := P_et) (δ₀ σ) e_congr.hom (hδ₀_props σ).2.2.1
      (CategoryTheory.MorphismProperty.of_isIso P_et e_congr.hom)
  have hδ_V_open : ∀ σ : B_r ≃ₐ[R₀] B_r, IsOpen (Set.range (δ_V σ).base) := by
    intro σ
    have _ : AlgebraicGeometry.Etale (δ_V σ) := hδ_V_et σ
    exact (δ_V σ).isOpenMap.isOpen_range
  have hδ_V_disj : ∀ σ₁ σ₂ : B_r ≃ₐ[R₀] B_r, σ₁ ≠ σ₂ →
      Disjoint (Set.range (δ_V σ₁).base) (Set.range (δ_V σ₂).base) := by
    intro σ₁ σ₂ hne
    rw [Set.disjoint_left]
    rintro z ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
    have h₁ : (δ₀ σ₁).base y₁ = e_congr.inv.base z := by
      have hcomp : δ₀ σ₁ ≫ e_congr.hom ≫ e_congr.inv = δ₀ σ₁ := by
        rw [e_congr.hom_inv_id, CategoryTheory.Category.comp_id]
      exact (congrArg (fun k => k.base y₁) hcomp).symm.trans (congrArg e_congr.inv.base hy₁)
    have h₂ : (δ₀ σ₂).base y₂ = e_congr.inv.base z := by
      have hcomp : δ₀ σ₂ ≫ e_congr.hom ≫ e_congr.inv = δ₀ σ₂ := by
        rw [e_congr.hom_inv_id, CategoryTheory.Category.comp_id]
      exact (congrArg (fun k => k.base y₂) hcomp).symm.trans (congrArg e_congr.inv.base hy₂)
    exact Set.disjoint_left.mp (hδ₀_disj σ₁ σ₂ hne) ⟨y₁, h₁⟩ ⟨y₂, h₂⟩
  have hδ_V_cov : (⋃ σ : B_r ≃ₐ[R₀] B_r, Set.range (δ_V σ).base) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro z
    have hz₀ : e_congr.inv.base z ∈ ⋃ σ : B_r ≃ₐ[R₀] B_r, Set.range (δ₀ σ).base := by
      rw [hδ₀_cov]
      exact Set.mem_univ _
    obtain ⟨σ, y, hy⟩ := Set.mem_iUnion.mp hz₀
    refine Set.mem_iUnion.mpr ⟨σ, y, ?_⟩
    change e_congr.hom.base ((δ₀ σ).base y) = z
    rw [hy]
    exact congrArg (fun k : V_r2 ⟶ V_r2 => k.base z) e_congr.inv_hom_id
  have hδ_V_var : ∀ σ τ : B_r ≃ₐ[R₀] B_r, δ_V σ ≫ m_can π_r τ = δ_V (τ * σ) := by
    intro σ τ
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        hδ_V_fst σ, hδ_V_fst (τ * σ)]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, hδ_V_snd σ, hd_V_mul σ τ, hδ_V_snd (τ * σ)]

  let pt_Ω : ↥S_Ω := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω)
  have hSub_SΩ : Subsingleton ↥S_Ω := (@PrimeSpectrum.instUnique Ω _).instSubsingleton
  let v₀ : ↥V_r := η_V.base pt_Ω
  have _ : IsDomain ↑(CommRingCat.of B_r) := ‹IsDomain B_r›
  have _ : PreconnectedSpace ↥V_r := inferInstance

  have hConst_δV1 : ∀ (s : ↑(𝒱_r.obj.obj (Opposite.op E_V))) (y₁ y₂ : ↥V_r),
      triv_r E_V s ((δ_V 1).base y₁) = triv_r E_V s ((δ_V 1).base y₂) := by
    intro s y₁ y₂
    have hlc : IsLocallyConstant (fun y : ↥V_r => triv_r E_V s ((δ_V 1).base y)) :=
      fun S_set => ((triv_r E_V s).isLocallyConstant S_set).preimage (δ_V 1).continuous
    exact hlc.apply_eq_of_preconnectedSpace y₁ y₂

  
  let ev_V_hom : ↑(𝒱_r.obj.obj (Opposite.op E_V)) →+ (Fin N → ZMod m_mod) :=
    { toFun := fun s => triv_r E_V s ((δ_V 1).base v₀)
      map_zero' := by
        rw [(triv_r E_V).map_zero]
        rfl
      map_add' := fun s₁ s₂ => by
        rw [(triv_r E_V).map_add]
        rfl }

  have hInj_ev : Function.Injective ev_V_hom := by
    rw [injective_iff_map_eq_zero]
    intro s hs0
    apply (_htriv_r.2.2 E_V).1
    rw [(triv_r E_V).map_zero]
    apply LocallyConstant.ext
    intro z
    have hz_mem : z ∈ ⋃ σ : B_r ≃ₐ[R₀] B_r, Set.range (δ_V σ).base := by
      rw [hδ_V_cov]
      exact Set.mem_univ z
    obtain ⟨σ, y, rfl⟩ := Set.mem_iUnion.mp hz_mem
    have hz_deck : (δ_V σ).base y = (m_can π_r σ).base ((δ_V 1).base y) := by
      have hmul : δ_V 1 ≫ m_can π_r σ = δ_V σ := by
        rw [hδ_V_var 1 σ, mul_one]
      exact (congrArg (fun k => k.base y) hmul).symm
