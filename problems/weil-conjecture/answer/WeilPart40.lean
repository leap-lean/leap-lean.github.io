  let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
  let hT_S : CategoryTheory.Limits.IsTerminal T_S :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
        (CategoryTheory.Category.comp_id E.hom) trivial)
      (fun E g => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g))
        (Subsingleton.elim _ _))
  let T'_Z : Z_s.Etale := B_is.obj T_S
  have hIso_T'Z : CategoryTheory.IsIso T'_Z.hom := by
    change CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd (𝟙 S) i_s)
    infer_instance
  let hT'_Z : CategoryTheory.Limits.IsTerminal T'_Z :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk
        (E.hom ≫ @CategoryTheory.inv _ _ _ _ T'_Z.hom hIso_T'Z)
        (by
          haveI := hIso_T'Z
          rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
            CategoryTheory.Category.comp_id])
        trivial)
      (fun E g => CategoryTheory.MorphismProperty.Comma.Hom.ext
        (by
          haveI := hIso_T'Z
          apply (CategoryTheory.cancel_mono T'_Z.hom).mp
          change g.left ≫ T'_Z.hom =
            (E.hom ≫ @CategoryTheory.inv _ _ _ _ T'_Z.hom hIso_T'Z) ≫ T'_Z.hom
          rw [CategoryTheory.MorphismProperty.Over.w g, CategoryTheory.Category.assoc,
            CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.comp_id])
        (Subsingleton.elim _ _))

  let adj_cS := CategoryTheory.constantSheafAdj J_S (ModuleCat.{u, u} R) hT_S
  let adj_cZ := CategoryTheory.constantSheafAdj J_Z (ModuleCat.{u, u} R) hT'_Z
  let eqv_sec_push : ∀ W : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R),
      (R_mod ⟶ ((CategoryTheory.sheafSections J_Z (ModuleCat.{u, u} R)).obj
        (Opposite.op T'_Z)).obj W) ≃
      (R_mod ⟶ ((CategoryTheory.sheafSections J_S (ModuleCat.{u, u} R)).obj
        (Opposite.op T_S)).obj (P_push.obj W)) :=
    fun _ =>
      { toFun := fun f => f
        invFun := fun f => f
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
  let η₁ : weilEtaleModuleUnit S m ⟶ 𝒬_s :=
    (adj_cS.homEquiv R_mod 𝒬_s).symm (eqv_sec_push _ (adj_cZ.unit.app R_mod))

  have hBij0_push : ∀ Y : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R),
      Function.Bijective (fun g : weilEtaleModuleUnit Z_s m ⟶ Y => η₁ ≫ P_push.map g) := by
    intro Y
