        · have hj_eq : j = s + 2 := by omega
          rw [← hj_eq, ← hord_eq]
          exact hord_m
    exact ⟨v, by simpa [v] using hw_prim, hv_pow⟩
  let tower : ∀ s : ℕ, { u : kˣ // IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (s + 1)) } :=
    Nat.rec ⟨u₁, hu₁_prim⟩ (fun s prev =>
      ⟨Classical.choose (hStep s prev.1 prev.2),
       (Classical.choose_spec (hStep s prev.1 prev.2)).1⟩)
  let ζ : ℕ → kˣ := fun n =>
    match n with
    | 0 => 1
    | s + 1 => (tower s).1
  have hPrim : ∀ n : ℕ, IsPrimitiveRoot ((ζ n : kˣ) : k) (ℓ ^ n) := by
    intro n
    cases n with
    | zero => exact IsPrimitiveRoot.one
    | succ s => exact (tower s).2
  have hPow : ∀ n : ℕ, (ζ (n + 1)) ^ ℓ = ζ n := by
    intro n
    cases n with
    | zero => exact hu₁_pow
    | succ s => exact (Classical.choose_spec (hStep s (tower s).1 (tower s).2)).2
  
  have hInjR : Module.Injective R R := by
    apply Module.Baer.injective
    intro I g
    by_cases hZero : ∀ y : I, (y : R) = 0
    · refine ⟨0, fun x hx => ?_⟩
      have hx0 : (⟨x, hx⟩ : I) = 0 := Subtype.ext (hZero ⟨x, hx⟩)
      simp [hx0]
    · obtain ⟨y₀, hy₀⟩ := not_forall.mp hZero
      have hy₀_down : (y₀ : R).down ≠ 0 := fun h => hy₀ (ULift.ext _ _ h)
      have hy₀_pos : 0 < (y₀ : R).down.val :=
        Nat.pos_of_ne_zero (fun hv => hy₀_down ((ZMod.val_eq_zero _).mp hv))
      let P : ℕ → Prop := fun n_val => 0 < n_val ∧ ∃ y : I, (y : R).down.val = n_val
      have hex : ∃ n_val, P n_val := ⟨(y₀ : R).down.val, hy₀_pos, y₀, rfl⟩
      let d₀ : ℕ := Nat.find hex
      have hd₀_spec : P d₀ := Nat.find_spec hex
      have hd₀_pos : 0 < d₀ := hd₀_spec.1
      obtain ⟨e₀, he₀_val⟩ := hd₀_spec.2
      have hd₀_lt : d₀ < M := he₀_val ▸ ZMod.val_lt (e₀ : R).down
      have he₀_cast : ((d₀ : ℕ) : ZMod M) = (e₀ : R).down := by
        rw [← he₀_val, ZMod.natCast_zmod_val]
      have hd₀_dvd_M : d₀ ∣ M := by
        let q₀ := M / d₀
        let rem₀ := M % d₀
        have hdiv : d₀ * q₀ + rem₀ = M := Nat.div_add_mod M d₀
        have hrem_lt : rem₀ < d₀ := Nat.mod_lt M hd₀_pos
        let z : I := -(q₀ • e₀)
        have hz_down : (z : R).down = (rem₀ : ZMod M) := by
          change -(q₀ • (e₀ : R).down) = (rem₀ : ZMod M)
          rw [nsmul_eq_mul, ← he₀_cast]
          have hM0 : ((d₀ * q₀ + rem₀ : ℕ) : ZMod M) = 0 := by
            rw [hdiv, ZMod.natCast_self]
          push_cast at hM0
          linear_combination -hM0
        have hz_val : (z : R).down.val = rem₀ := by
          rw [hz_down]
          exact ZMod.val_natCast_of_lt (lt_trans hrem_lt hd₀_lt)
        by_cases hr0 : rem₀ = 0
        · exact Nat.dvd_of_mod_eq_zero hr0
        · exfalso
          exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hr0, z, hz_val⟩
      have hgen : ∀ y : I, y = ((y : R).down.val / d₀) • e₀ := by
        intro y
        let v := (y : R).down.val
        let k_y := v / d₀
        let rem := v % d₀
        have hdiv_v : d₀ * k_y + rem = v := Nat.div_add_mod v d₀
        have hrem_lt : rem < d₀ := Nat.mod_lt v hd₀_pos
        let z : I := y - k_y • e₀
        have hz_down : (z : R).down = (rem : ZMod M) := by
          change (y : R).down - k_y • (e₀ : R).down = (rem : ZMod M)
          have hv_cast : ((v : ℕ) : ZMod M) = (y : R).down := ZMod.natCast_zmod_val _
          rw [← hv_cast, ← hdiv_v, nsmul_eq_mul, ← he₀_cast]
          push_cast
          ring
        have hz_val : (z : R).down.val = rem := by
          rw [hz_down]
          exact ZMod.val_natCast_of_lt (lt_trans hrem_lt hd₀_lt)
        have hrem0 : rem = 0 := by
          by_contra hne
          exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hne, z, hz_val⟩
        have hz0 : z = 0 := by
          apply Subtype.ext
          apply ULift.ext
          rw [hz_down, hrem0, Nat.cast_zero]
          rfl
        exact sub_eq_zero.mp hz0
      let q₀ := M / d₀
      have hqd₀ : q₀ * d₀ = M := Nat.div_mul_cancel hd₀_dvd_M
      have hq_pos : 0 < q₀ := by
        by_contra hq0
        have hq_eq : q₀ = 0 := Nat.eq_zero_of_not_pos hq0
        rw [hq_eq, zero_mul] at hqd₀
        omega
      have hqe₀ : q₀ • e₀ = 0 := by
        apply Subtype.ext
        apply ULift.ext
        change q₀ • (e₀ : R).down = 0
        rw [nsmul_eq_mul, ← he₀_cast]
        exact_mod_cast (by rw [hqd₀, ZMod.natCast_self] : ((q₀ * d₀ : ℕ) : ZMod M) = 0)
      have hqg : q₀ • g e₀ = 0 := by
        rw [← map_nsmul, hqe₀, map_zero]
      have hdvd_prod : M ∣ q₀ * (g e₀).down.val := by
        have hcast0 : ((q₀ * (g e₀).down.val : ℕ) : ZMod M) = 0 := by
          have h1 : q₀ • (g e₀).down = 0 := congrArg ULift.down hqg
          rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val (g e₀).down] at h1
          exact_mod_cast h1
        exact (ZMod.natCast_eq_zero_iff _ _).mp hcast0
      let v_g : ℕ := (g e₀).down.val
      have hdvd_prod' : q₀ * d₀ ∣ q₀ * v_g := by
        change M ∣ q₀ * v_g at hdvd_prod
        rwa [← hqd₀] at hdvd_prod
      obtain ⟨c₀, hc₀⟩ := (Nat.mul_dvd_mul_iff_left hq_pos).mp hdvd_prod'
      have hc₀' : (g e₀).down.val = d₀ * c₀ := hc₀
      let c : R := ULift.up (c₀ : ZMod M)
      refine ⟨LinearMap.lsmul R R c, fun x hx => ?_⟩
      have hx_gen := hgen ⟨x, hx⟩
      let k_x := (x : R).down.val / d₀
      have hx_val : x = k_x • (e₀ : R) := congrArg Subtype.val hx_gen
      have hge₀ : LinearMap.lsmul R R c (e₀ : R) = g e₀ := by
        apply ULift.ext
        change ((c₀ : ZMod M) * (e₀ : R).down) = (g e₀).down
        rw [← he₀_cast, ← ZMod.natCast_zmod_val (g e₀).down, hc₀']
        push_cast
        ring
      calc
        LinearMap.lsmul R R c x = LinearMap.lsmul R R c (k_x • (e₀ : R)) := by rw [hx_val]
        _ = k_x • LinearMap.lsmul R R c (e₀ : R) := map_nsmul _ _ _
        _ = k_x • g e₀ := by rw [hge₀]
        _ = g (k_x • e₀) := (map_nsmul g k_x e₀).symm
        _ = g ⟨x, hx⟩ := by rw [← hx_gen]
  have hCog : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, M • x = 0) →
      ∀ a : A, (∀ φ : A →+ ZMod M, φ a = 0) → a = 0 := by
    intro A _ hTors a ha
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % M) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n M]
      rw [add_nsmul, mul_comm M (n / M), mul_smul, hTors x, smul_zero, zero_add]
    by_contra ha_ne
    let instSMulRA : SMul R A := ⟨fun r_el x => r_el.down.val • x⟩
    let _ := instSMulRA
    have hsmul_def : ∀ (r_el : R) (x : A), r_el • x = r_el.down.val • x := fun _ _ => rfl
    let instModRA : Module R A :=
      { one_smul := fun x => by
          rw [hsmul_def]
          change (1 : ZMod M).val • x = x
          rw [ZMod.val_one M, one_nsmul]
        mul_smul := fun r_el s_el x => by
          rw [hsmul_def, hsmul_def, hsmul_def]
          change (r_el.down * s_el.down).val • x = r_el.down.val • (s_el.down.val • x)
          rw [ZMod.val_mul, ← hrem, mul_smul]
        smul_zero := fun r_el => by rw [hsmul_def, nsmul_zero]
        smul_add := fun r_el x y => by rw [hsmul_def, hsmul_def, hsmul_def, nsmul_add]
        add_smul := fun r_el s_el x => by
          rw [hsmul_def, hsmul_def, hsmul_def]
          change (r_el.down + s_el.down).val • x = r_el.down.val • x + s_el.down.val • x
          rw [ZMod.val_add, ← hrem, add_nsmul]
        zero_smul := fun x => by
          rw [hsmul_def]
          change (0 : ZMod M).val • x = 0
          rw [ZMod.val_zero, zero_nsmul] }
    let _ := instModRA
    let P : ℕ → Prop := fun n_val => 0 < n_val ∧ n_val • a = 0
    have hex : ∃ n_val, P n_val := ⟨M, by omega, hTors a⟩
    let d₀ : ℕ := Nat.find hex
    have hd₀_spec : P d₀ := Nat.find_spec hex
    have hd₀_pos : 0 < d₀ := hd₀_spec.1
    have hd₀_ann : d₀ • a = 0 := hd₀_spec.2
    have hd₀_ge2 : 2 ≤ d₀ := by
      by_contra hlt
      have hd1 : d₀ = 1 := by omega
      rw [hd1, one_nsmul] at hd₀_ann
      exact ha_ne hd₀_ann
    have hd₀_dvd : ∀ n : ℕ, n • a = 0 → d₀ ∣ n := by
      intro n hn
      let rem := n % d₀
      have hrem_lt : rem < d₀ := Nat.mod_lt n hd₀_pos
      have hrem_ann : rem • a = 0 := by
        have hdiv : d₀ * (n / d₀) + rem = n := Nat.div_add_mod n d₀
        have h1 : (d₀ * (n / d₀)) • a + rem • a = 0 := by
          rw [← add_nsmul, hdiv, hn]
        rw [mul_comm d₀ (n / d₀), mul_smul, hd₀_ann, smul_zero, zero_add] at h1
        exact h1
      by_cases hr0 : rem = 0
      · exact Nat.dvd_of_mod_eq_zero hr0
      · exfalso
        exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hr0, hrem_ann⟩
    have hd₀_dvd_M : d₀ ∣ M := hd₀_dvd M (hTors a)
    let q₀ : ℕ := M / d₀
    have hqd₀ : q₀ * d₀ = M := Nat.div_mul_cancel hd₀_dvd_M
    have hq_pos : 0 < q₀ := by
      by_contra hq0
      have hq_eq : q₀ = 0 := Nat.eq_zero_of_not_pos hq0
      rw [hq_eq, zero_mul] at hqd₀
      omega
    have hq_lt_M : q₀ < M := by nlinarith
    have hq_cast_ne : (q₀ : ZMod M) ≠ 0 := by
      intro hq0
      have hv := congrArg ZMod.val hq0
      rw [ZMod.val_natCast_of_lt hq_lt_M, ZMod.val_zero] at hv
      omega
    let μ : R →ₗ[R] A := LinearMap.toSpanSingleton R A a
    let g_tilde : R →ₗ[R] R := LinearMap.lsmul R R (ULift.up (q₀ : ZMod M))
    have hker : LinearMap.ker μ ≤ LinearMap.ker g_tilde := by
      intro r_el hr
      rw [LinearMap.mem_ker] at hr ⊢
      change r_el.down.val • a = 0 at hr
      obtain ⟨k_mul, hk_mul⟩ := hd₀_dvd r_el.down.val hr
      apply ULift.ext
      change (q₀ : ZMod M) * r_el.down = 0
      rw [← ZMod.natCast_zmod_val r_el.down, hk_mul]
      have hqm0 : ((q₀ * d₀ : ℕ) : ZMod M) = 0 := by rw [hqd₀, ZMod.natCast_self]
      push_cast at hqm0 ⊢
      linear_combination (k_mul : ZMod M) * hqm0
    let g₀ : LinearMap.range μ →ₗ[R] R :=
      (Submodule.liftQ (LinearMap.ker μ) g_tilde hker).comp
        (LinearMap.quotKerEquivRange μ).symm.toLinearMap
    obtain ⟨lam, hlam⟩ := hInjR.out (LinearMap.range μ).subtype Subtype.val_injective g₀
    let φ : A →+ ZMod M :=
      { toFun := fun x => (lam x).down
        map_zero' := by rw [map_zero]; rfl
        map_add' := fun x y => by rw [map_add]; rfl }
    have hφa : φ a = (q₀ : ZMod M) := by
      have ha_mu : μ (1 : R) = a := one_smul R a
      have hmem : a ∈ LinearMap.range μ := ⟨1, ha_mu⟩
      have h1 : lam a = g₀ ⟨a, hmem⟩ := hlam ⟨a, hmem⟩
      have h2 : (LinearMap.quotKerEquivRange μ) (Submodule.Quotient.mk (1 : R)) = ⟨a, hmem⟩ :=
        Subtype.ext ha_mu
      have h3 : (LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩ =
          Submodule.Quotient.mk (1 : R) := by
        rw [← h2, LinearEquiv.symm_apply_apply]
      have h4 : g₀ ⟨a, hmem⟩ = g_tilde (1 : R) := by
        change Submodule.liftQ (LinearMap.ker μ) g_tilde hker
          ((LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩) = g_tilde 1
        rw [h3, Submodule.liftQ_apply]
      change (lam a).down = (q₀ : ZMod M)
      rw [h1, h4]
      change ((q₀ : ZMod M) * (1 : ZMod M)) = (q₀ : ZMod M)
      exact mul_one _
    exact hq_cast_ne (hφa.symm.trans (ha φ))
  have hTrCrit : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, M • x = 0) →
      ∀ τ₀ : A →+ ZMod M,
        (∀ φ : A →+ ZMod M, ∃! c : ZMod M, ∀ x : A, φ x = c * τ₀ x) →
        Function.Bijective τ₀ := by
    intro A _ hTors τ₀ hCrit
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % M) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n M]
      rw [add_nsmul, mul_comm M (n / M), mul_smul, hTors x, smul_zero, zero_add]
    have h1_mem : (1 : ZMod M) ∈ τ₀.range := by
      by_contra hnot
      let Q₀ := ZMod M ⧸ τ₀.range
      let B := ULift.{u, 0} Q₀
      let q_mk : ZMod M →+ B :=
        { toFun := fun z => ULift.up (QuotientAddGroup.mk' τ₀.range z)
          map_zero' := ULift.ext _ _ (map_zero _)
          map_add' := fun x y => ULift.ext _ _ (map_add _ x y) }
      have hB_tors : ∀ b : B, M • b = 0 := by
        intro b
        obtain ⟨z, hz⟩ := QuotientAddGroup.mk'_surjective τ₀.range b.down
        have hb_eq : b = q_mk z := ULift.ext _ _ hz.symm
        rw [hb_eq, ← map_nsmul]
        have hMz : M • z = 0 := by
          rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
        rw [hMz, map_zero]
      have hq1_ne : q_mk 1 ≠ 0 := by
        intro h0
        have h0' : QuotientAddGroup.mk' τ₀.range (1 : ZMod M) = 0 :=
          congrArg ULift.down h0
        exact hnot ((QuotientAddGroup.eq_zero_iff (1 : ZMod M)).mp h0')
      have hnot_all : ¬ ∀ χ : B →+ ZMod M, χ (q_mk 1) = 0 :=
        fun hall => hq1_ne (hCog B hB_tors (q_mk 1) hall)
      obtain ⟨χ, hχ⟩ := not_forall.mp hnot_all
      let c : ZMod M := χ (q_mk 1)
      have hc_ann : ∀ x : A, (0 : A →+ ZMod M) x = c * τ₀ x := by
        intro x
        have hmem : τ₀ x ∈ τ₀.range := ⟨x, rfl⟩
        have hqx0 : q_mk (τ₀ x) = 0 :=
          ULift.ext _ _ ((QuotientAddGroup.eq_zero_iff (τ₀ x)).mpr hmem)
        have hval : τ₀ x = (τ₀ x).val • (1 : ZMod M) := by
          rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
        have h0 : χ (q_mk (τ₀ x)) = 0 := by rw [hqx0, map_zero]
        rw [hval, map_nsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val] at h0
        change (0 : ZMod M) = c * τ₀ x
        rw [mul_comm]
        exact h0.symm
      obtain ⟨c₀, _, hc₀_uniq⟩ := hCrit 0
      have hc_eq : c = c₀ := hc₀_uniq c hc_ann
      have h0_eq : (0 : ZMod M) = c₀ := hc₀_uniq 0 (fun _ => by simp)
      exact hχ (hc_eq.trans h0_eq.symm)
    obtain ⟨e₀_el, he₀_el⟩ := h1_mem
    have hSurj : Function.Surjective τ₀ := by
      intro z
      refine ⟨z.val • e₀_el, ?_⟩
      rw [map_nsmul, he₀_el, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
    have hInj : Function.Injective τ₀ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      by_contra hz_ne
      let K_sub := τ₀.ker
      have hK_tors : ∀ u : ↥K_sub, M • u = 0 := fun u => Subtype.ext (hTors u.1)
      let zK : ↥K_sub := ⟨z, hz⟩
      have hzK_ne : zK ≠ 0 := fun h0 => hz_ne (congrArg Subtype.val h0)
      have hnot_all : ¬ ∀ ψ : ↥K_sub →+ ZMod M, ψ zK = 0 :=
        fun hall => hzK_ne (hCog ↥K_sub hK_tors zK hall)
      obtain ⟨ψ, hψ⟩ := not_forall.mp hnot_all
      let π_ker : A →+ ↥K_sub :=
        { toFun := fun x => ⟨x - (τ₀ x).val • e₀_el, by
            rw [AddMonoidHom.mem_ker, map_sub, map_nsmul, he₀_el, nsmul_eq_mul,
              mul_one, ZMod.natCast_zmod_val, sub_self]⟩
          map_zero' := by
            apply Subtype.ext
            simp
          map_add' := fun x y => by
            apply Subtype.ext
            change (x + y) - (τ₀ (x + y)).val • e₀_el =
              (x - (τ₀ x).val • e₀_el) + (y - (τ₀ y).val • e₀_el)
            have hval_add : (τ₀ (x + y)).val • e₀_el = (τ₀ x).val • e₀_el + (τ₀ y).val • e₀_el := by
              rw [map_add, ZMod.val_add, ← hrem, add_nsmul]
            rw [hval_add]
            abel }
      let φ : A →+ ZMod M := ψ.comp π_ker
      obtain ⟨c, hc, _⟩ := hCrit φ
      have hc0 : c = 0 := by
        have he := hc e₀_el
        have hπe₀ : π_ker e₀_el = 0 := by
          apply Subtype.ext
          change e₀_el - (τ₀ e₀_el).val • e₀_el = 0
          rw [he₀_el, ZMod.val_one M, one_nsmul, sub_self]
        have hφe₀ : φ e₀_el = 0 := by
          change ψ (π_ker e₀_el) = 0
          rw [hπe₀, map_zero]
        rw [hφe₀, he₀_el, mul_one] at he
        exact he.symm
      have hφz : φ z = 0 := by rw [hc z, hc0, zero_mul]
      have hπz : π_ker z = zK := by
        apply Subtype.ext
        change z - (τ₀ z).val • e₀_el = z
        rw [hz, ZMod.val_zero, zero_nsmul, sub_zero]
      have hφz' : φ z = ψ zK := by
        change ψ (π_ker z) = ψ zK
        rw [hπz]
      exact hψ (hφz'.symm.trans hφz)
    exact ⟨hInj, hSurj⟩
  
  have hDim : topologicalKrullDim S ≤ (d : WithBot ℕ∞) :=
    le_of_eq (weil_smooth_integral_krullDim_over_field k d Z_bar hInt_Z)
  have hMod1 := (weil_etale_module_ext_comparison.{u}.1 S M (2 * d)).1
  let θ_top : weilEtaleModuleH S M (2 * d) →+ weilEtaleTorsionH S M (2 * d) :=
    Classical.choose hMod1
  have hθ_top : WeilIsModuleToTorsionComparison S M (2 * d) θ_top :=
    (Classical.choose_spec hMod1).1
  have hGod : WeilHasTruncatedGodementComplex S d M :=
    weil_etale_truncated_godement_acyclic_complex k Z_bar d M hM hUnit_M hDim
  obtain ⟨tr, _, hEff_all⟩ :=
    weil_etale_smooth_proper_trace_and_local_effacement k Z_bar hInt_Z d ℓ hℓ_char ζ hPrim hPow
  let τ : weilEtaleModuleH S M (2 * d) →+ ZMod M := (tr (r + 1)).comp θ_top
  have hEff : WeilHasLocalEffacement S d M τ := hEff_all (r + 1) θ_top hθ_top
  obtain ⟨hEnd, hGeomLift, hLocConst⟩ :=
    weil_etale_connected_unit_end_and_geom_point_lift S M hM
  have hDualRep : WeilHasVerdierDualSheafRep S M :=
    weil_etale_colimit_preserving_dual_injective_sheaf S M hM hInjR
  have hDualExt : WeilHasVerdierDualExtPackage S d M τ :=
    weil_etale_verdier_dual_injective_resolution_of_effacement S d M hM τ hGod hEff
      hInjR hGeomLift hLocConst hDualRep
  
  have hM_id : ∀ Y : 𝒞, M • CategoryTheory.CategoryStruct.id Y = 0 := by
    intro Y
    ext U y
    change M • y = 0
    have hMR : ((M : ℕ) : R) = 0 := ULift.ext _ _ (ZMod.natCast_self M)
    rw [← Nat.cast_smul_eq_nsmul R M y, hMR, zero_smul]
  have hExt_tors : ∀ (X Y : 𝒞) (n_deg : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y n_deg),
      M • x = 0 := by
    intro X Y n_deg x
    have hmk_nsmul : ∀ (n : ℕ) (f : Quiver.Hom Y Y),
        CategoryTheory.Abelian.Ext.mk₀ (n • f) = n • CategoryTheory.Abelian.Ext.mk₀ f := by
      intro n f
      induction n with
      | zero => rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero]
      | succ n ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
    let pre_x : CategoryTheory.Abelian.Ext.{u} Y Y 0 →+
        CategoryTheory.Abelian.Ext.{u} X Y n_deg :=
      AddMonoidHom.mk' (fun u => x.comp u (Nat.add_zero n_deg))
        (fun u₁ u₂ => CategoryTheory.Abelian.Ext.comp_add x u₁ u₂ (Nat.add_zero n_deg))
    calc
      M • x = M • pre_x (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id Y)) := by
        rw [AddMonoidHom.mk'_apply, CategoryTheory.Abelian.Ext.comp_mk₀_id]
      _ = pre_x (M • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id Y)) :=
        (map_nsmul pre_x M _).symm
      _ = pre_x (CategoryTheory.Abelian.Ext.mk₀ (M • CategoryTheory.CategoryStruct.id Y)) := by
        rw [← hmk_nsmul]
