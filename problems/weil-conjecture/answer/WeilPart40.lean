  have ht_diag_K : ∀ a : Fin (N + 1), t_K a a = 1 := hCoord_K.2.2.2.2.1
  have hC_ov_K := hCoord_K.2.2.2.2.2.2.2.2.1
  have hT_ov_K := hCoord_K.2.2.2.2.2.2.2.2.2

  have hQuadOv_K : ∀ (r : Fin (m + 2)) (a a' : Fin (N + 1)) (ν : Fin (r.1 + 1)),
      ((weilProjectiveSpaceOver K N).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_right).op).hom (g_quad_K a' r ν) *
      (((weilProjectiveSpaceOver K N).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (t_K a a')) ^
        (Fin.lastCases 2 (fun _ => 1) ν : ℕ) =
      ((weilProjectiveSpaceOver K N).left.presheaf.map
        (CategoryTheory.homOfLE inf_le_left).op).hom (g_quad_K a r ν) := by
    intro r a a' ν
    set resL := ((weilProjectiveSpaceOver K N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom
    set resR := ((weilProjectiveSpaceOver K N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom
    refine Fin.lastCases ?_ (fun μ => ?_) ν
    · dsimp [g_quad_K, q_K]
      rw [Fin.lastCases_last, Fin.lastCases_last, Fin.lastCases_last]
      rw [map_sub, map_sum, map_mul, map_pow, map_sub, map_sum, map_mul, map_pow,
        sub_mul, Finset.sum_mul]
      congr 1
      · refine Finset.sum_congr rfl fun j _ => ?_
        calc
          resR (t_K a' (u_idx j) * t_K a' (v_idx j)) * resL (t_K a a') ^ 2 =
              (resR (t_K a' (u_idx j)) * resL (t_K a a')) *
                (resR (t_K a' (v_idx j)) * resL (t_K a a')) := by rw [map_mul]; ring
          _ = resL (t_K a (u_idx j)) * resL (t_K a (v_idx j)) := by
            rw [hT_ov_K a a' (u_idx j), hT_ov_K a a' (v_idx j)]
          _ = resL (t_K a (u_idx j) * t_K a (v_idx j)) := (map_mul _ _ _).symm
      · calc
          resR (c_K a' t) * resR (t_K a' w_idx) ^ 2 * resL (t_K a a') ^ 2 =
              resR (c_K a' t) * (resR (t_K a' w_idx) * resL (t_K a a')) ^ 2 := by ring
          _ = resL (c_K a t) * resL (t_K a w_idx) ^ 2 := by
            rw [hC_ov_K a a' t, hT_ov_K a a' w_idx]
    · dsimp [g_quad_K]
      rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc, Fin.lastCases_castSucc, pow_one]
      exact hT_ov_K a a' _

  
  have hSubMid : ∀ j : Fin (m + 1),
      ∃ D : PresDatum N,
        D.2.2.1 = j.succ.1 + 1 ∧
        (∀ a : Fin (N + 1),
