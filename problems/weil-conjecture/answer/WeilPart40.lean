      let emb_fn : Fin (m - s.1) → Fin m := fun r => ⟨s.1 + r.1, by omega⟩
      let ψ_fn : Fin m → MvPolynomial (Fin (m - s.1)) K := fun i =>
        if s.1 ≤ i.1 then MvPolynomial.X ⟨i.1 - s.1, by omega⟩ else 0
      have h_vanish : ∀ x ∈ J_s, MvPolynomial.aeval ψ_fn x = 0 := by
