          exact CategoryTheory.Limits.pullback.condition)
    have hι_affQR_fst : ι_affQ_R ≫ fst_QR = fst_CQR ≫ ι_affQ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_affQR_snd : ι_affQ_R ≫ f_QR = snd_CQR :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_affQR_outer :
        CategoryTheory.IsPullback (ι_affQ_R ≫ f_QR) fst_CQR g_R (ι_affQ ≫ g_Q.left) := by
      rw [hι_affQR_snd, hClause1.1]
      exact (CategoryTheory.IsPullback.of_hasPullback p_CQ g_R).flip
    have hpb_affQR : CategoryTheory.IsPullback ι_affQ_R fst_CQR fst_QR ι_affQ :=
      CategoryTheory.IsPullback.of_right hpb_affQR_outer hι_affQR_fst
        (CategoryTheory.IsPullback.of_hasPullback g_Q.left g_R).flip
    letI : AlgebraicGeometry.IsOpenImmersion ι_affQ_R :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_affQR.flip inferInstance

    let ι_affQ_Ω : C_Q_Ω ⟶ Q_Ω :=
      CategoryTheory.Limits.pullback.lift (fst_CQΩ ≫ ι_affQ) snd_CQΩ
        (by
          rw [CategoryTheory.Category.assoc, hClause1.1]
          exact CategoryTheory.Limits.pullback.condition)
    have hι_affQΩ_fst : ι_affQ_Ω ≫ fst_QΩ = fst_CQΩ ≫ ι_affQ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_affQΩ_snd : ι_affQ_Ω ≫ f_QΩ = snd_CQΩ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm_affQ_j : ι_affQ_Ω ≫ j_Q = j_CQ ≫ ι_affQ_R := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc (ι_affQ_Ω ≫ j_Q) ≫ fst_QR
          _ = ι_affQ_Ω ≫ (j_Q ≫ fst_QR) := CategoryTheory.Category.assoc _ _ _
          _ = ι_affQ_Ω ≫ fst_QΩ := congrArg (ι_affQ_Ω ≫ ·) hj_fst
          _ = fst_CQΩ ≫ ι_affQ := hι_affQΩ_fst
          _ = (j_CQ ≫ fst_CQR) ≫ ι_affQ := congrArg (· ≫ ι_affQ) hj_CQ_fst.symm
          _ = j_CQ ≫ (fst_CQR ≫ ι_affQ) := CategoryTheory.Category.assoc _ _ _
          _ = j_CQ ≫ (ι_affQ_R ≫ fst_QR) := congrArg (j_CQ ≫ ·) hι_affQR_fst.symm
          _ = (j_CQ ≫ ι_affQ_R) ≫ fst_QR := (CategoryTheory.Category.assoc _ _ _).symm
      · calc (ι_affQ_Ω ≫ j_Q) ≫ f_QR
          _ = ι_affQ_Ω ≫ (j_Q ≫ f_QR) := CategoryTheory.Category.assoc _ _ _
          _ = ι_affQ_Ω ≫ (f_QΩ ≫ j_R) := congrArg (ι_affQ_Ω ≫ ·) hj_snd
          _ = (ι_affQ_Ω ≫ f_QΩ) ≫ j_R := (CategoryTheory.Category.assoc _ _ _).symm
          _ = snd_CQΩ ≫ j_R := congrArg (· ≫ j_R) hι_affQΩ_snd
          _ = j_CQ ≫ snd_CQR := hj_CQ_snd.symm
          _ = j_CQ ≫ (ι_affQ_R ≫ f_QR) := congrArg (j_CQ ≫ ·) hι_affQR_snd.symm
          _ = (j_CQ ≫ ι_affQ_R) ≫ f_QR := (CategoryTheory.Category.assoc _ _ _).symm
    have hpb_affQ_j_outer :
        CategoryTheory.IsPullback (ι_affQ_Ω ≫ f_QΩ) j_CQ j_R (ι_affQ_R ≫ f_QR) := by
      rw [hι_affQΩ_snd, hι_affQR_snd]
      exact hpb_jCQ.flip
    have hpb_jCQ_aff : CategoryTheory.IsPullback ι_affQ_Ω j_CQ j_Q ι_affQ_R :=
      CategoryTheory.IsPullback.of_right hpb_affQ_j_outer hcomm_affQ_j hpb_jQ.flip

    let Q_R_Ω := CategoryTheory.Limits.pullback f_QR j_R
    let j_Q_std : Q_R_Ω ⟶ Q_R := CategoryTheory.Limits.pullback.fst f_QR j_R
    let e_QRΩ : Q_Ω ≅ Q_R_Ω := hpb_jQ.isoPullback
    have he_QRΩ_hom : e_QRΩ.hom ≫ j_Q_std = j_Q := hpb_jQ.isoPullback_hom_fst
    have he_QRΩ_inv : e_QRΩ.inv ≫ j_Q = j_Q_std := by
      rw [← he_QRΩ_hom, CategoryTheory.Iso.inv_hom_id_assoc]

    let S_d := weilAffineSpaceOver k (2 * m + 1)
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let A_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let j_A : A_Ω ⟶ A_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)

    have hSmoothOpenAt : ∀ (z : ↥Q_R) (W_sm : Q_fam.left.Opens),
        fst_QR.base z ∈ W_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_sm.ι ≫ g_Q.left) →
        ∃ (V : Q_R.Opens) (_ : z ∈ V)
          (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Q_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_Q V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A φ := by
      intro z W_sm hz_W hSm_W
      letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_sm.ι ≫ g_Q.left) := hSm_W
      let f_W := W_sm.ι ≫ g_Q.left
      let Q'_R := CategoryTheory.Limits.pullback f_W g_R
      let fst'_QR := CategoryTheory.Limits.pullback.fst f_W g_R
      let f'_QR := CategoryTheory.Limits.pullback.snd f_W g_R
      let Q'_R_Ω := CategoryTheory.Limits.pullback f'_QR j_R
      let j_Q' : Q'_R_Ω ⟶ Q'_R := CategoryTheory.Limits.pullback.fst f'_QR j_R
      let e_WQ : Q'_R ⟶ Q_R :=
        CategoryTheory.Limits.pullback.lift (fst'_QR ≫ W_sm.ι) f'_QR
          (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
      have he_WQ_fst : e_WQ ≫ fst_QR = fst'_QR ≫ W_sm.ι :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have he_WQ_snd : e_WQ ≫ f_QR = f'_QR :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_WQ_outer : CategoryTheory.IsPullback
          (e_WQ ≫ f_QR) fst'_QR g_R (W_sm.ι ≫ g_Q.left) := by
        rw [he_WQ_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback f_W g_R).flip
      have hpb_WQ : CategoryTheory.IsPullback e_WQ fst'_QR fst_QR W_sm.ι :=
        CategoryTheory.IsPullback.of_right hpb_WQ_outer he_WQ_fst
          (CategoryTheory.IsPullback.of_hasPullback g_Q.left g_R).flip
      letI : AlgebraicGeometry.IsOpenImmersion e_WQ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpb_WQ.flip inferInstance
      let e_WQ_Ω : Q'_R_Ω ⟶ Q_R_Ω :=
        CategoryTheory.Limits.pullback.lift (j_Q' ≫ e_WQ)
          (CategoryTheory.Limits.pullback.snd f'_QR j_R)
          (by
            rw [CategoryTheory.Category.assoc, he_WQ_snd]
            exact CategoryTheory.Limits.pullback.condition)
      have he_WQΩ_fst : e_WQ_Ω ≫ j_Q_std = j_Q' ≫ e_WQ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have he_WQΩ_snd : e_WQ_Ω ≫ CategoryTheory.Limits.pullback.snd f_QR j_R =
          CategoryTheory.Limits.pullback.snd f'_QR j_R :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_WQΩ_outer :
          CategoryTheory.IsPullback
            (e_WQ_Ω ≫ CategoryTheory.Limits.pullback.snd f_QR j_R) j_Q' j_R (e_WQ ≫ f_QR) := by
        rw [he_WQΩ_snd, he_WQ_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback f'_QR j_R).flip
      have hpb_jQ' : CategoryTheory.IsPullback e_WQ_Ω j_Q' j_Q_std e_WQ :=
        CategoryTheory.IsPullback.of_right hpb_WQΩ_outer he_WQΩ_fst
          (CategoryTheory.IsPullback.of_hasPullback f_QR j_R).flip
      obtain ⟨z', hz'_eWQ, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_WQ z ⟨fst_QR.base z, hz_W⟩ rfl
      obtain ⟨V', hz'_V', φ', hEt_φ', V'_U, ι_V'U, j_V', φ'_U, hSq1', hSq2'⟩ :=
        hAtlasGen (2 * m + 1) W_sm.toScheme A1_k p_A1 f_W R_bar Ω g_k_R g_R hg_R_pA1 j_R z'
      letI : AlgebraicGeometry.Etale φ' := hEt_φ'
      let ι_tot : V'.toScheme ⟶ Q_R := V'.ι ≫ e_WQ
      letI : AlgebraicGeometry.IsOpenImmersion ι_tot := by
        dsimp [ι_tot]
        infer_instance
      let V : Q_R.Opens := ι_tot.opensRange
      have hz_V : z ∈ V := by
        refine ⟨⟨z', hz'_V'⟩, ?_⟩
        change e_WQ.base z' = z
        exact hz'_eWQ
      let φ : V.toScheme ⟶ A_R := ι_tot.isoOpensRange.inv ≫ φ'
      have hEt_φ : AlgebraicGeometry.Etale φ := by
        dsimp [φ]
        infer_instance
      let j_V : V'_U ⟶ V.toScheme := j_V' ≫ ι_tot.isoOpensRange.hom
      have hSq1_tot : CategoryTheory.IsPullback (ι_V'U ≫ e_WQ_Ω) j_V' j_Q_std ι_tot :=
        hSq1'.paste_horiz hpb_jQ'
      have hSq1 : CategoryTheory.IsPullback ((ι_V'U ≫ e_WQ_Ω) ≫ e_QRΩ.inv) j_V j_Q V.ι :=
        CategoryTheory.IsPullback.of_iso hSq1_tot (CategoryTheory.Iso.refl _)
          e_QRΩ.symm ι_tot.isoOpensRange (CategoryTheory.Iso.refl _)
          (by simp) (by simp [j_V])
          (by simp [he_QRΩ_inv])
          (by simp [V, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι])
      have hSq2 : CategoryTheory.IsPullback φ'_U j_V j_A φ :=
        CategoryTheory.IsPullback.of_iso hSq2' (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) ι_tot.isoOpensRange (CategoryTheory.Iso.refl _)
          (by simp) (by simp [j_V]) (by simp [j_A, S_d]) (by simp [φ])
      exact ⟨V, hz_V, φ, hEt_φ, V'_U, (ι_V'U ≫ e_WQ_Ω) ≫ e_QRΩ.inv, j_V, φ'_U, hSq1, hSq2⟩

    have hSmoothAtlas : ∀ z : ↥Q_R,
        z ∉ Set.range j_Q.base →
        z ∉ Set.range o_R.base →
        ∃ (V : Q_R.Opens) (_ : z ∈ V)
          (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Q_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_Q V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A φ := by
      intro z hz_not_jQ hz_not_oR
      have hz_closed : f_QR.base z = IsLocalRing.closedPoint R_bar := by
        rcases hMax_R (f_QR.base z).asIdeal (f_QR.base z).isPrime with hbot | hmax
        · exfalso
          have hj_bot : j_R.base (⊥ : PrimeSpectrum Ω) = f_QR.base z := by
            apply PrimeSpectrum.ext
            rw [hbot]
            change Ideal.comap φ_R_Ω ⊥ = ⊥
            ext r_el
            rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
            exact ⟨fun hr0 => hφ_inj (hr0.trans (map_zero _).symm),
              fun hr => by rw [hr, map_zero]⟩
          obtain ⟨z_std, hz_std, -⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := f_QR) (g := j_R)
              z (⊥ : PrimeSpectrum Ω) hj_bot.symm
          apply hz_not_jQ
          refine ⟨e_QRΩ.inv.base z_std, ?_⟩
          change (e_QRΩ.inv ≫ j_Q).base z_std = z
          rw [he_QRΩ_inv]
          exact hz_std
        · exact PrimeSpectrum.ext hmax
      have hz_not_o₀ : fst_QR.base z ∉ Set.range (o₀_CQ ≫ ι_affQ).base := by
        intro ⟨pt, hpt⟩
        have hpt' : ι_affQ.base (o₀_CQ.base pt) = fst_QR.base z := hpt
        obtain ⟨z_CQ, hz_CQ, -⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_affQR z (o₀_CQ.base pt)
            hpt'.symm
        have hz_CQ_fst : fst_CQR.base z_CQ ∈ Set.range o₀_CQ.base := by
          refine ⟨pt, ι_affQ.isOpenEmbedding.injective ?_⟩
          rw [hpt']
          change fst_QR.base z = (fst_CQR ≫ ι_affQ).base z_CQ
          rw [← hι_affQR_fst]
          change fst_QR.base z = fst_QR.base (ι_affQ_R.base z_CQ)
          rw [hz_CQ]
        have hz_CQ_snd : snd_CQR.base z_CQ = IsLocalRing.closedPoint R_bar := by
          rw [← hz_closed]
          change snd_CQR.base z_CQ = f_QR.base z
          rw [← hι_affQR_snd]
          change f_QR.base (ι_affQ_R.base z_CQ) = f_QR.base z
          rw [hz_CQ]
        let c_o₀ : S_k ⟶ C_Q_R :=
          CategoryTheory.Limits.pullback.lift o₀_CQ u_R
            (by rw [hClause1.2.1, hu_R_gR])
        have hc_o₀_eq : c_o₀ ≫ ι_affQ_R = o_R := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (c_o₀ ≫ ι_affQ_R) ≫ fst_QR = o_R ≫ fst_QR
            rw [CategoryTheory.Category.assoc, hι_affQR_fst, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, ho_fst]
          · change (c_o₀ ≫ ι_affQ_R) ≫ f_QR = o_R ≫ f_QR
            rw [CategoryTheory.Category.assoc, hι_affQR_snd,
              CategoryTheory.Limits.pullback.lift_snd, ho_snd]
        let z₀_CQ : ↥C_Q_R := c_o₀.base (⊥ : PrimeSpectrum k)
        have hz₀_CQ_fst : fst_CQR.base z₀_CQ ∈ Set.range o₀_CQ.base := by
          refine ⟨(⊥ : PrimeSpectrum k), ?_⟩
          change o₀_CQ.base (⊥ : PrimeSpectrum k) = (c_o₀ ≫ fst_CQR).base (⊥ : PrimeSpectrum k)
          rw [CategoryTheory.Limits.pullback.lift_fst]
        have hz₀_CQ_snd : snd_CQR.base z₀_CQ = IsLocalRing.closedPoint R_bar := by
          change (c_o₀ ≫ snd_CQR).base (⊥ : PrimeSpectrum k) = IsLocalRing.closedPoint R_bar
          rw [CategoryTheory.Limits.pullback.lift_snd]
          exact hu_R_pt (⊥ : PrimeSpectrum k)
        have heq_CQ : z_CQ = z₀_CQ :=
          hOdpUnique k o₀_CQ hClause1.2.2 z_CQ z₀_CQ hz_CQ_fst hz₀_CQ_fst hz_CQ_snd hz₀_CQ_snd
        apply hz_not_oR
        refine ⟨(⊥ : PrimeSpectrum k), ?_⟩
        rw [← hc_o₀_eq]
        change ι_affQ_R.base z₀_CQ = z
        rw [← heq_CQ, hz_CQ]
      obtain ⟨W_sm, hz_W, hSm_W⟩ := hClause2 (fst_QR.base z) hz_not_o₀
      exact hSmoothOpenAt z W_sm hz_W hSm_W

    obtain ⟨hSkyscraperGen, hDegZeroInjGen⟩ :=
      weil_proj_quadric_val_ring_skyscraper_and_deg_zero_inj ℓ
    have hInj0_Q : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Q_R) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Q w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Q w) ℓ 0 ψ₀ →
        Function.Injective ψ₀ := by
      apply hDegZeroInjGen j_Q
      intro x
      by_cases hx_aff : fst_QR.base x ∈ Set.range ι_affQ.base
      · rcases hx_aff with ⟨x_CQ0, hx_CQ0⟩
        obtain ⟨x_CQR, hx_CQR, -⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_affQR x x_CQ0 hx_CQ0.symm
        let O_aff : Q_R.Opens := ι_affQ_R.opensRange
        refine ⟨O_aff, ⟨x_CQR, hx_CQR⟩, Or.inl ?_⟩
        intro W _ w _ hNe_W
        let w' : W ⟶ C_Q_R := w ≫ ι_affQ_R.isoOpensRange.inv
        letI : AlgebraicGeometry.Etale w' := by
          dsimp [w']
          infer_instance
        have hw'_eq : w' ≫ ι_affQ_R = w ≫ O_aff.ι := by
          have hinv : ι_affQ_R.isoOpensRange.inv ≫ ι_affQ_R = O_aff.ι := by
            rw [← CategoryTheory.Category.id_comp O_aff.ι,
              ← CategoryTheory.Iso.inv_hom_id ι_affQ_R.isoOpensRange,
              CategoryTheory.Category.assoc]
            exact congrArg (ι_affQ_R.isoOpensRange.inv ≫ ·)
              (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_affQ_R).symm
          exact (CategoryTheory.Category.assoc w _ _).trans (congrArg (w ≫ ·) hinv)
        have hNe_CQ := hOdpNonempty W w' hNe_W
        let j_CQ_std := CategoryTheory.Limits.pullback.fst snd_CQR j_R
        have he_CQ_inv : hpb_jCQ.isoPullback.inv ≫ j_CQ = j_CQ_std := by
          calc hpb_jCQ.isoPullback.inv ≫ j_CQ
            _ = hpb_jCQ.isoPullback.inv ≫ (hpb_jCQ.isoPullback.hom ≫ j_CQ_std) :=
                congrArg (hpb_jCQ.isoPullback.inv ≫ ·) hpb_jCQ.isoPullback_hom_fst.symm
            _ = (hpb_jCQ.isoPullback.inv ≫ hpb_jCQ.isoPullback.hom) ≫ j_CQ_std :=
                (CategoryTheory.Category.assoc _ _ _).symm
            _ = 𝟙 _ ≫ j_CQ_std :=
                congrArg (· ≫ j_CQ_std) (CategoryTheory.Iso.inv_hom_id hpb_jCQ.isoPullback)
            _ = j_CQ_std := CategoryTheory.Category.id_comp _
        let Φ_W : CategoryTheory.Limits.pullback j_CQ_std w' ⟶
            CategoryTheory.Limits.pullback j_Q (w ≫ O_aff.ι) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst j_CQ_std w' ≫
              hpb_jCQ.isoPullback.inv ≫ ι_affQ_Ω)
            (CategoryTheory.Limits.pullback.snd j_CQ_std w')
            (by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                hcomm_affQ_j, ← CategoryTheory.Category.assoc hpb_jCQ.isoPullback.inv,
                he_CQ_inv, ← CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.condition,
                CategoryTheory.Category.assoc, hw'_eq])
        exact hNe_CQ.map Φ_W.base
      · have hx_not_o₀ : fst_QR.base x ∉ Set.range (o₀_CQ ≫ ι_affQ).base := by
          intro ⟨pt, hpt⟩
          exact hx_aff ⟨o₀_CQ.base pt, hpt⟩
        obtain ⟨W_sm, hx_W, hSm_W⟩ := hClause2 (fst_QR.base x) hx_not_o₀
        obtain ⟨V, hx_V, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩ :=
          hSmoothOpenAt x W_sm hx_W hSm_W
        letI : AlgebraicGeometry.Etale φ := hEt_φ
        refine ⟨V, hx_V, Or.inr ?_⟩
        intro W _ w _ ψ₀ hψ₀
        have hpb0 : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst j_V w)
            (CategoryTheory.Limits.pullback.snd j_V w) j_V w :=
          CategoryTheory.IsPullback.of_hasPullback j_V w
        have hpb1 : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst j_V w ≫ ι_VU)
            (CategoryTheory.Limits.pullback.snd j_V w) j_Q (w ≫ V.ι) :=
          hpb0.paste_horiz hSq1
        have hpb2 : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst j_V w ≫ φ_U)
            (CategoryTheory.Limits.pullback.snd j_V w) j_A (w ≫ φ) :=
          hpb0.paste_horiz hSq2
        let e_W : CategoryTheory.Limits.pullback j_Q (w ≫ V.ι) ≅
            CategoryTheory.Limits.pullback j_A (w ≫ φ) :=
          hpb1.isoPullback.symm ≪≫ hpb2.isoPullback
        have he_W_snd : e_W.hom ≫ CategoryTheory.Limits.pullback.snd j_A (w ≫ φ) =
            CategoryTheory.Limits.pullback.snd j_Q (w ≫ V.ι) := by
          simp [e_W, CategoryTheory.Iso.trans_hom,
            CategoryTheory.IsPullback.isoPullback_hom_snd,
            CategoryTheory.IsPullback.isoPullback_inv_snd]
        have hBij_A : HasBijPull (CategoryTheory.Limits.pullback.snd j_A (w ≫ φ)) 0 :=
          fun p hp => hBij0_A W (w ≫ φ) p hp
        have hBij_Q : HasBijPull (CategoryTheory.Limits.pullback.snd j_Q (w ≫ V.ι)) 0 := by
          rw [← he_W_snd]
          exact hBij_comp e_W.hom (CategoryTheory.Limits.pullback.snd j_A (w ≫ φ)) 0
            (hBij_iso e_W 0) hBij_A
        exact (hBij_Q ψ₀ hψ₀).1

    obtain ⟨hBij0_aff, hZero_low⟩ :=
      weil_proj_quadric_val_ring_trunc_acyclic_from_punctual_roof
        ℓ R_bar Ω k f_QR f_QΩ j_Q j_A o_R (2 * m)
        (hSkyscraperGen k o_R) hInj0_Q hBij0_A (fun b hb _ => hZero_A b hb)
        hSmoothAtlas hGlobalBij

    
    have hLiftGeomPt : ∀ {K : Type u} [Field K] {V₀ : AlgebraicGeometry.Scheme.{u}}
        (v : V₀ ⟶ Q_R) [AlgebraicGeometry.IsOpenImmersion v]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Q_R),
        z_bar.base (⊥ : PrimeSpectrum K) ∈ Set.range v.base →
        ∃ (z_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ V₀), z_V ≫ v = z_bar := by
      intro K _ V₀ v _ z_bar hz_mem
      have hsub : Set.range z_bar.base ⊆ Set.range v.base := by
        rintro _ ⟨pt, rfl⟩
        rw [Subsingleton.elim pt (⊥ : PrimeSpectrum K)]
        exact hz_mem
      exact ⟨AlgebraicGeometry.IsOpenImmersion.lift v z_bar hsub,
        AlgebraicGeometry.IsOpenImmersion.lift_fac v z_bar hsub⟩

    have hIsZeroPullback : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂)
        (F₂ : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F₂ F₁ →
        CategoryTheory.Limits.IsZero F₂ →
        CategoryTheory.Limits.IsZero F₁ := by
      intro Z₁ Z₂ h F₂ F₁ hPB hZ₂
      rcases hPB with ⟨hc, hr, ⟨e_iso⟩⟩
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_h : CategoryTheory.Functor Z₂.Etale Z₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      letI := hc
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      letI := hr
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      have hid_zero : 𝟙 (pb_h.obj F₂) = 0 :=
        (adj_h.homEquiv F₂ (pb_h.obj F₂)).injective
          (hZ₂.eq_of_src
            ((adj_h.homEquiv F₂ (pb_h.obj F₂)) (𝟙 (pb_h.obj F₂)))
            ((adj_h.homEquiv F₂ (pb_h.obj F₂)) 0))
      have hZ_pb : CategoryTheory.Limits.IsZero (pb_h.obj F₂) := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        exact hid_zero
      exact hZ_pb.of_iso e_iso.symm

    obtain ⟨hPullExZero, _, hPullCompPair, _, _, _⟩ :=
      weil_etale_pullback_exact_and_pseudofunctor.{u} 0
    have hPullZeroComp : ∀ {Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}}
        (h₁ : Z₁ ⟶ Z₂) (h₂ : Z₂ ⟶ Z₃)
        (S_sh : CategoryTheory.Sheaf Z₃.smallEtaleTopology AddCommGrpCat.{u})
        (H₂ : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h₂ S_sh H₂ →
        CategoryTheory.Limits.IsZero H₂ →
        ∃ (H₁ : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback (h₁ ≫ h₂) S_sh H₁ ∧
          CategoryTheory.Limits.IsZero H₁ := by
      intro Z₁ Z₂ Z₃ h₁ h₂ S_sh H₂ hPB₂ hZ₂
      obtain ⟨H₁, hPB₁, _, hZ₁_imp⟩ := hPullExZero h₁ H₂
      exact ⟨H₁, (hPullCompPair h₁ h₂ S_sh H₂ H₁).1 hPB₂ hPB₁, hZ₁_imp hZ₂⟩

    have hSupp_mid : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Q_R),
        z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range o_R.base →
        ∃ (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback z_bar
            (weilEtaleHigherDirectImage j_Q (2 * m + 1) (weilEtaleTorsionSheaf Q_Ω ℓ)) H_z ∧
          CategoryTheory.Limits.IsZero H_z := by
      obtain ⟨hIdHDIZero, hEtaleBC_HDI⟩ :=
        weil_punctual_roof_hdi_id_isZero_and_etale_pullback.{u} ℓ
      intro K _ _ z_bar hz_not_oR
      by_cases hz_j : z_bar.base (⊥ : PrimeSpectrum K) ∈ Set.range j_Q.base
      · obtain ⟨z_U, hz_U⟩ := hLiftGeomPt j_Q z_bar hz_j
        haveI : CategoryTheory.Mono j_Q := AlgebraicGeometry.IsOpenImmersion.mono j_Q
        have hSq_id : CategoryTheory.IsPullback
            (CategoryTheory.CategoryStruct.id Q_Ω)
            (CategoryTheory.CategoryStruct.id Q_Ω) j_Q j_Q := by
          refine CategoryTheory.IsPullback.of_isLimit
            (c := CategoryTheory.Limits.PullbackCone.mk
              (CategoryTheory.CategoryStruct.id Q_Ω)
              (CategoryTheory.CategoryStruct.id Q_Ω) rfl) ?_
          refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
            (fun s => s.snd)
            (fun s => (CategoryTheory.Category.comp_id s.snd).trans
              ((CategoryTheory.cancel_mono j_Q).mp s.condition.symm))
            (fun s => CategoryTheory.Category.comp_id s.snd)
            (fun s m_hom _ hm₂ => (CategoryTheory.Category.comp_id m_hom).symm.trans hm₂)
        have hPB_j := hEtaleBC_HDI
          (CategoryTheory.CategoryStruct.id Q_Ω)
          (CategoryTheory.CategoryStruct.id Q_Ω) j_Q j_Q (2 * m + 1) hSq_id
        have hZ_id := hIdHDIZero Q_Ω (weilEtaleTorsionSheaf Q_Ω ℓ) (2 * m + 1) (by omega)
        obtain ⟨H_z, hPB_z, hZ_z⟩ := hPullZeroComp z_U j_Q
          (weilEtaleHigherDirectImage j_Q (2 * m + 1) (weilEtaleTorsionSheaf Q_Ω ℓ))
          (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id Q_Ω) (2 * m + 1)
            (weilEtaleTorsionSheaf Q_Ω ℓ))
          hPB_j hZ_id
        rw [hz_U] at hPB_z
        exact ⟨H_z, hPB_z, hZ_z⟩
      · obtain ⟨V, hz_V, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩ :=
          hSmoothAtlas (z_bar.base (⊥ : PrimeSpectrum K)) hz_j hz_not_oR
        letI : AlgebraicGeometry.Etale φ := hEt_φ
        obtain ⟨z_V, hz_V_fac⟩ := hLiftGeomPt V.ι z_bar ⟨⟨_, hz_V⟩, rfl⟩
        have hPB_φ := hEtaleBC_HDI φ_U j_V j_A φ (2 * m + 1) hSq2
        have hZ_jV : CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage j_V (2 * m + 1) (weilEtaleTorsionSheaf V_U ℓ)) :=
          hIsZeroPullback φ
            (weilEtaleHigherDirectImage j_A (2 * m + 1) (weilEtaleTorsionSheaf A_Ω ℓ))
            (weilEtaleHigherDirectImage j_V (2 * m + 1) (weilEtaleTorsionSheaf V_U ℓ))
            hPB_φ (hZero_A (2 * m + 1) (by omega))
        have hPB_V := hEtaleBC_HDI ι_VU j_V j_Q V.ι (2 * m + 1) hSq1
        obtain ⟨H_z, hPB_z, hZ_z⟩ := hPullZeroComp z_V V.ι
          (weilEtaleHigherDirectImage j_Q (2 * m + 1) (weilEtaleTorsionSheaf Q_Ω ℓ))
          (weilEtaleHigherDirectImage j_V (2 * m + 1) (weilEtaleTorsionSheaf V_U ℓ))
          hPB_V hZ_jV
        rw [hz_V_fac] at hPB_z
        exact ⟨H_z, hPB_z, hZ_z⟩

    obtain ⟨j_map_A, _, _, _, hEx_A, _⟩ :=
      weil_sing_dev_ar_torsion_pushforward_system j_A ℓ
    have hZero_A_pow : ∀ (r_idx b : ℕ), 1 ≤ b →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_A b
            (weilEtaleTorsionSheaf A_Ω (ℓ ^ (r_idx + 1)))) := by
      intro r_idx
      induction r_idx with
      | zero =>
        intro b hb
        rw [Nat.zero_add, pow_one]
        exact hZero_A b hb
      | succ r_idx ih =>
        intro b hb
        have hZ1 := hZero_A b hb
        rw [← pow_one ℓ] at hZ1
        have hZ_ih := ih b hb
        obtain ⟨h1_comp, h1_ex⟩ := ((hEx_A 1 (r_idx + 2) (r_idx + 1) (by omega)).2 b).1
        have hg0 : (CategoryTheory.ShortComplex.mk _ _ h1_comp).g = 0 :=
          hZ_ih.eq_of_tgt _ 0
        have hf0 : (CategoryTheory.ShortComplex.mk _ _ h1_comp).f = 0 :=
          hZ1.eq_of_src _ 0
        haveI : CategoryTheory.Epi (CategoryTheory.ShortComplex.mk _ _ h1_comp).f :=
          h1_ex.epi_f hg0
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        apply (CategoryTheory.cancel_epi (CategoryTheory.ShortComplex.mk _ _ h1_comp).f).mp
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero]
        exact hf0

    have ht_unit_Ω : IsUnit (φ_R_Ω t_bar) := by
      letI : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      haveI : IsLocalization.Away t_bar Ω := hLoc_Ω
      change IsUnit (algebraMap R_bar Ω t_bar)
      exact IsLocalization.Away.algebraMap_isUnit t_bar
    have hℓ_Ω_ne : (ℓ : Ω) ≠ 0 := by
      let ι_kΩ : k →+* Ω := φ_R_Ω.comp (p_R.comp Polynomial.C)
      intro h0
      apply hℓ
      apply RingHom.injective ι_kΩ
      rw [map_natCast, h0, map_zero]

    have hZero_high : ∀ r q : ℕ, 2 * m + 2 ≤ q →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_Q q (weilEtaleTorsionSheaf Q_Ω (ℓ ^ (r + 1)))) := by
      intro r q hq
      let n := ℓ ^ (r + 1)
      have hn_pos : 1 ≤ n := Nat.one_le_pow (r + 1) ℓ (Fact.out : Nat.Prime ℓ).pos
      have hn_unit : IsUnit (n : Ω) := by
        dsimp [n]
        rw [Nat.cast_pow]
        exact IsUnit.mk0 _ (pow_ne_zero (r + 1) hℓ_Ω_ne)
      have hZero_CQ : CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_CQ q (weilEtaleTorsionSheaf C_Q_Ω n)) :=
        weil_proj_quadric_prime_pow_affine_odp_high_deg_hdi_zero
          k m R_bar p_R t_bar ht_eq Ω φ_R_Ω ht_unit_Ω j_CQ hj_CQ_fst hj_CQ_snd
          n q hn_pos hn_unit hq
      obtain ⟨_, hEtaleBC_n⟩ :=
        weil_punctual_roof_hdi_id_isZero_and_etale_pullback.{u} n
      apply weil_etale_geometric_point_stalk_conservativity Q_R
      intro K _ _ x_bar
      by_cases hx_aff : fst_QR.base (x_bar.base (⊥ : PrimeSpectrum K)) ∈ Set.range ι_affQ.base
      · rcases hx_aff with ⟨x_CQ0, hx_CQ0⟩
        obtain ⟨x_CQR, hx_CQR, -⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_affQR
            (x_bar.base (⊥ : PrimeSpectrum K)) x_CQ0 hx_CQ0.symm
        obtain ⟨z_CQ, hz_CQ_fac⟩ := hLiftGeomPt ι_affQ_R x_bar ⟨x_CQR, hx_CQR⟩
        have hPB_aff := hEtaleBC_n ι_affQ_Ω j_CQ j_Q ι_affQ_R q hpb_jCQ_aff
        obtain ⟨G₀, hPB_x, hZ_x⟩ := hPullZeroComp z_CQ ι_affQ_R
          (weilEtaleHigherDirectImage j_Q q (weilEtaleTorsionSheaf Q_Ω n))
          (weilEtaleHigherDirectImage j_CQ q (weilEtaleTorsionSheaf C_Q_Ω n))
          hPB_aff hZero_CQ
        rw [hz_CQ_fac] at hPB_x
        exact ⟨G₀, hPB_x, hZ_x⟩
      · have hx_not_o₀ :
            fst_QR.base (x_bar.base (⊥ : PrimeSpectrum K)) ∉
              Set.range (o₀_CQ ≫ ι_affQ).base := by
          intro ⟨pt, hpt⟩
          exact hx_aff ⟨o₀_CQ.base pt, hpt⟩
        obtain ⟨W_sm, hx_W, hSm_W⟩ :=
          hClause2 (fst_QR.base (x_bar.base (⊥ : PrimeSpectrum K))) hx_not_o₀
        obtain ⟨V, hx_V, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩ :=
          hSmoothOpenAt (x_bar.base (⊥ : PrimeSpectrum K)) W_sm hx_W hSm_W
        letI : AlgebraicGeometry.Etale φ := hEt_φ
        obtain ⟨z_V, hz_V_fac⟩ := hLiftGeomPt V.ι x_bar ⟨⟨_, hx_V⟩, rfl⟩
        have hPB_φ := hEtaleBC_n φ_U j_V j_A φ q hSq2
        have hZ_jV : CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage j_V q (weilEtaleTorsionSheaf V_U n)) :=
          hIsZeroPullback φ
            (weilEtaleHigherDirectImage j_A q (weilEtaleTorsionSheaf A_Ω n))
            (weilEtaleHigherDirectImage j_V q (weilEtaleTorsionSheaf V_U n))
            hPB_φ (hZero_A_pow r q (by omega))
        have hPB_V := hEtaleBC_n ι_VU j_V j_Q V.ι q hSq1
        obtain ⟨G₀, hPB_x, hZ_x⟩ := hPullZeroComp z_V V.ι
          (weilEtaleHigherDirectImage j_Q q (weilEtaleTorsionSheaf Q_Ω n))
          (weilEtaleHigherDirectImage j_V q (weilEtaleTorsionSheaf V_U n))
          hPB_V hZ_jV
        rw [hz_V_fac] at hPB_x
        exact ⟨G₀, hPB_x, hZ_x⟩

    exact weil_proj_quadric_prime_pow_skyscraper_stalk_card_and_tower_iso
      k ℓ (2 * m) j_Q o_R hBij0_aff hZero_low hZero_high hSupp_mid hMid_XU hCard_top

theorem weil_odp_val_seq_henselian_spectrum_and_aligned_roof (F : Type u) [Field F]
    (m ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hSm_U₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀))
    (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hs_sec : s ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (x_s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left)
    (hx_s : x_s ≫ f₀.left = s)
    (hSm_away : ∀ z : Z_tilde.left, f₀.left.base z ∈ Set.range s.base →
      z ∉ Set.range x_s.base →
      ∃ V : Z_tilde.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
    (hOdp_s : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_s.base pt) (s.base pt))
    (f_bar : weilGeomScheme F Z_tilde ⟶ weilGeomScheme F (weilProjectiveSpaceOver F 1))
    (hf_bar_fst :
      f_bar ≫ CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      CategoryTheory.Limits.pullback.fst Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        f₀.left)
    (hf_bar_snd :
      f_bar ≫ CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      CategoryTheory.Limits.pullback.snd Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    (s_bar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶
      weilGeomScheme F (weilProjectiveSpaceOver F 1))
    (hs_bar_fst :
      s_bar ≫ CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) ≫ s)
    (hs_bar_snd :
      s_bar ≫ (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial (AlgebraicClosure F) →+* R_bar)
    (t_bar : R_bar)
    (π_cl : R_bar →+* AlgebraicClosure F)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F))))
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D_col : ℐ ⥤ CommRingCat.{u})
    (α_col : (CategoryTheory.Functor.const ℐ).obj
      (CommRingCat.of (Polynomial (AlgebraicClosure F))) ⟶ D_col)
    (c_col : CategoryTheory.Limits.Cocone D_col) (hc_col : CategoryTheory.Limits.IsColimit c_col)
    (e_pt : c_col.pt ≅ CommRingCat.of R_bar)
    (hRbar_props : p_R Polynomial.X = t_bar ∧
      π_cl.comp p_R = Polynomial.evalRingHom 0 ∧
      φ_R_Ω.comp p_R =
        algebraMap (Polynomial (AlgebraicClosure F))
          (AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F)))) ∧
      Function.Injective φ_R_Ω ∧
      @IsLocalization.Away R_bar _ t_bar
        (AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F)))) _ φ_R_Ω.toAlgebra)
    (hCocone : ∀ i : ℐ,
      (α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
      Function.Injective ((c_col.ι.app i) ≫ e_pt.hom).hom)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D_col.obj i)) (u : (↑(D_col.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial (AlgebraicClosure F) →+* ↑(D_col.obj i)),
        1 ≤ e ∧
        ((c_col.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α_col.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α_col.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D_col.obj i₁))
          (ψ₁ : Polynomial (AlgebraicClosure F) →+* ↑(D_col.obj i₁)),
          (D_col.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α_col.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale)
    (hLift_Rbar : ∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S) [AlgebraicGeometry.Etale w₀]
        (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
        (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ W₀),
      s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
      ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
        g_tilde ≫ w₀ = g_S ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde)
    (R_s : Type u) [CommRing R_s] [IsDomain R_s] [IsLocalRing R_s]
    [HenselianLocalRing R_s] [IsDiscreteValuationRing R_s]
    (K_s : Type u) [Field K_s]
    (ι_RK : R_s →+* K_s)
    (ι_Rbar : R_s →+* R_bar)
    (ι_KΩ : K_s →+* AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F))))
    (t_s : R_s)
    (g_Rs : AlgebraicGeometry.Spec (CommRingCat.of R_s) ⟶
      weilGeomScheme F (weilProjectiveSpaceOver F 1))
    (hTrait :
      let D_bar := weilGeomScheme F (weilProjectiveSpaceOver F 1)
      let pr_D : Quiver.Hom D_bar (weilProjectiveSpaceOver F 1).left :=
        CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      let U_bar : D_bar.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
      ι_Rbar t_s = t_bar ∧
      t_s ≠ 0 ∧
      t_s ∈ IsLocalRing.maximalIdeal R_s ∧
      @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra ∧
      φ_R_Ω.comp ι_Rbar = ι_KΩ.comp ι_RK ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar)) ≫ g_Rs = s_bar ∧
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs).base ⊆
        (U_bar : Set D_bar))
    (hUnif_align :
      let k := AlgebraicClosure F
      let D_bar := weilBaseChangeOver F k (weilProjectiveSpaceOver F 1)
      ∀ (B_k : Type u) [CommRing B_k]
        (e_Bk : AlgebraicGeometry.Spec (CommRingCat.of B_k) ⟶ D_bar.left)
        [AlgebraicGeometry.Etale e_Bk]
        (s_Bk : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B_k))
        (ψ_Bk : Polynomial k →+* B_k),
        s_Bk ≫ e_Bk = s_bar →
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk)) →
        e_Bk ≫ D_bar.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        (AlgebraicGeometry.Spec.preimage s_Bk).hom (ψ_Bk Polynomial.X) = 0 →
        ∃ (φ_lift : B_k →+* R_s) (u_unit : R_sˣ),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_lift) ≫ e_Bk = g_Rs ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_lift) = s_Bk ∧
          φ_lift (ψ_Bk Polynomial.X) = ↑u_unit * t_s)
    (Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (g_Q : Q_fam ⟶ CategoryTheory.Over.mk
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.C : AlgebraicClosure F →+* Polynomial (AlgebraicClosure F)))))
    (o₀ : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ Q_fam.left)
    (U_aff : Q_fam.left.Opens)
    (o₀_U : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ U_aff.toScheme)
    (e_aff : U_aff.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) (Polynomial (AlgebraicClosure F)) ⧸
        Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C Polynomial.X})))
    (hQ_geom :
      let k := AlgebraicClosure F
      let P := Polynomial k
      let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec (CommRingCat.of P) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
      o₀ ≫ g_Q.left = s₀ ∧
      o₀_U ≫ U_aff.ι = o₀ ∧
      U_aff.ι ≫ g_Q.left =
        e_aff.hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
      (∀ (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k))) (idx : Fin (m + 1) × Fin 2),
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ ((o₀_U ≫ e_aff.hom).base pt).asIdeal)) :
    let k := AlgebraicClosure F
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    let g_Rbar : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        weilGeomScheme F (weilProjectiveSpaceOver F 1) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Rbar) ≫ g_Rs
    let s_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_KΩ.comp ι_RK)) ≫ g_Rs
    let Z_s := CategoryTheory.Limits.pullback f_bar s_bar
    let Z_Rs := CategoryTheory.Limits.pullback f_bar g_Rs
    let Z_Rbar := CategoryTheory.Limits.pullback f_bar g_Rbar
    let Z_Ω := CategoryTheory.Limits.pullback f_bar s_Ω
    let Q_R := CategoryTheory.Limits.pullback g_Q.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R))
    let Q_Ω := CategoryTheory.Limits.pullback g_Q.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R)))
    let S_d := weilAffineSpaceOver k (2 * m + 1)
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let A_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let j_A : A_Ω ⟶ A_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
      (CategoryTheory.Limits.pullback.snd f_bar s_Ω) ∧
    AlgebraicGeometry.IsProper f_bar ∧
    AlgebraicGeometry.LocallyOfFiniteType
      (weilBaseChangeOver F k (weilProjectiveSpaceOver F 1)).hom ∧
    HenselianLocalRing R_bar ∧
    IsAlgClosed (IsLocalRing.ResidueField R_bar) ∧
    IsAlgClosed (IsLocalRing.ResidueField R_s) ∧
    (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)).base pt =
        IsLocalRing.closedPoint R_bar) ∧
    (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar))).base pt =
        IsLocalRing.closedPoint R_s) ∧
    AlgebraicGeometry.IsOpenImmersion j_A ∧
    ∃ (j_Z_Rbar : Z_Ω ⟶ Z_Rbar)
      (q_Rbar_Rs : Z_Rbar ⟶ Z_Rs)
      (i_Z_Rbar : Z_s ⟶ Z_Rbar)
      (i_Z_Rs : Z_s ⟶ Z_Rs)
      (j_Q : Q_Ω ⟶ Q_R)
      (o_R : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_R)
      (x_Rbar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_Rbar),
      AlgebraicGeometry.IsOpenImmersion j_Z_Rbar ∧
      AlgebraicGeometry.IsClosedImmersion x_Rbar ∧
      x_Rbar ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rbar ≫
          (weilBaseChangeOver F k Z_tilde).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      i_Z_Rbar ≫ q_Rbar_Rs = i_Z_Rs ∧
      (j_Z_Rbar ≫ q_Rbar_Rs) ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rs =
        CategoryTheory.Limits.pullback.fst f_bar s_Ω ∧
      (j_Z_Rbar ≫ q_Rbar_Rs) ≫ CategoryTheory.Limits.pullback.snd f_bar g_Rs =
        CategoryTheory.Limits.pullback.snd f_bar s_Ω ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_KΩ.comp ι_RK)) ∧
      i_Z_Rbar ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rbar =
        CategoryTheory.Limits.pullback.fst f_bar s_bar ∧
      i_Z_Rbar ≫ CategoryTheory.Limits.pullback.snd f_bar g_Rbar =
        CategoryTheory.Limits.pullback.snd f_bar s_bar ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ∧
      i_Z_Rs ≫ CategoryTheory.Limits.pullback.fst f_bar g_Rs =
        CategoryTheory.Limits.pullback.fst f_bar s_bar ∧
      i_Z_Rs ≫ CategoryTheory.Limits.pullback.snd f_bar g_Rs =
        CategoryTheory.Limits.pullback.snd f_bar s_bar ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar)) ∧
      j_Q ≫ CategoryTheory.Limits.pullback.fst g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
        CategoryTheory.Limits.pullback.fst g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))) ∧
      j_Q ≫ CategoryTheory.Limits.pullback.snd g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
        CategoryTheory.Limits.pullback.snd g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ∧
      o_R ≫ CategoryTheory.Limits.pullback.fst g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) = o₀ ∧
      o_R ≫ CategoryTheory.Limits.pullback.snd g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ∧
      (∀ z : ↥Z_Rbar,
        z ∉ Set.range j_Z_Rbar.base →
        z ∉ Set.range x_Rbar.base →
        ∃ (W_sm : Z_Rbar.Opens)
          (w_sm : W_sm.toScheme ⟶ A_R)
          (W_sm_Ω : AlgebraicGeometry.Scheme.{u})
          (ι_WΩ : W_sm_Ω ⟶ Z_Ω)
          (j_Wsm : W_sm_Ω ⟶ W_sm.toScheme)
          (w_sm_Ω : W_sm_Ω ⟶ A_Ω),
          z ∈ W_sm ∧
          AlgebraicGeometry.IsAffineOpen W_sm ∧
          AlgebraicGeometry.Etale w_sm ∧
          CategoryTheory.IsPullback ι_WΩ j_Wsm j_Z_Rbar W_sm.ι ∧
          CategoryTheory.IsPullback w_sm_Ω j_Wsm j_A w_sm) ∧
      (∃ (V_Rbar V_Ω : AlgebraicGeometry.Scheme.{u})
          (_ : AlgebraicGeometry.IsAffine V_Rbar)
          (e_ZR : V_Rbar ⟶ Z_Rbar)
          (e_QR : V_Rbar ⟶ Q_R)
          (e_ZΩ : V_Ω ⟶ Z_Ω)
          (j_VR : V_Ω ⟶ V_Rbar)
          (e_QΩ : V_Ω ⟶ Q_Ω)
          (v_Rbar_sec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ V_Rbar),
          AlgebraicGeometry.Etale e_ZR ∧
          AlgebraicGeometry.Etale e_QR ∧
          CategoryTheory.IsPullback e_ZΩ j_VR j_Z_Rbar e_ZR ∧
          CategoryTheory.IsPullback e_QΩ j_VR j_Q e_QR ∧
          v_Rbar_sec ≫ e_ZR = x_Rbar ∧
          v_Rbar_sec ≫ e_QR = o_R) :=
by
  classical
  intro k P Ω g_Rbar s_Ω Z_s Z_Rs Z_Rbar Z_Ω Q_R Q_Ω S_d g_k_R j_R A_R A_Ω j_A
  let D₀ := weilProjectiveSpaceOver F 1
  let f_ext : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of F) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let pr_D : weilGeomScheme F D₀ ⟶ D₀.left :=
    CategoryTheory.Limits.pullback.fst D₀.hom f_ext
  let pr_Z : weilGeomScheme F Z_tilde ⟶ Z_tilde.left :=
    CategoryTheory.Limits.pullback.fst Z_tilde.hom f_ext
  let D_bar_ov := weilBaseChangeOver F k D₀
  let Z_bar_ov := weilBaseChangeOver F k Z_tilde
  have hf_bar_fst' : f_bar ≫ pr_D = pr_Z ≫ f₀.left := hf_bar_fst
  have hf_bar_snd' : f_bar ≫ D_bar_ov.hom = Z_bar_ov.hom := hf_bar_snd

  
  
  
  have hBotPrime : ∀ (K₀ : Type u) [Field K₀] (p : PrimeSpectrum K₀), p.asIdeal = ⊥ := by
    intro K₀ _ p
    refine Ideal.ext fun x => ⟨fun hx => ?_, fun hx => ?_⟩
    · rw [Ideal.mem_bot]
      by_contra hx0
      exact p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr
        (mul_inv_cancel₀ hx0 ▸ p.asIdeal.mul_mem_right x⁻¹ hx))
    · rw [Ideal.mem_bot.mp hx]
      exact p.asIdeal.zero_mem

  have hSpecUnique : ∀ (K₀ : Type u) [Field K₀]
      (p₁ p₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K₀))), p₁ = p₂ :=
    fun K₀ _ p₁ p₂ => PrimeSpectrum.ext ((hBotPrime K₀ p₁).trans (hBotPrime K₀ p₂).symm)

  have hPushoutEtaleInl : ∀ {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
      (f : A →+* B) (g : A →+* C) (inl : B →+* D) (inr : C →+* D),
      CategoryTheory.IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
        (CommRingCat.ofHom inl) (CommRingCat.ofHom inr) →
      g.Etale → inl.Etale := by
    intro A B C D _ _ _ _ f g inl inr hPush hg_et
    have hPb := AlgebraicGeometry.isPullback_SpecMap_of_isPushout
      (CommRingCat.ofHom f) (CommRingCat.ofHom g)
      (CommRingCat.ofHom inl) (CommRingCat.ofHom inr) hPush
    have hg_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg_et
    have hinl_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl)) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hg_spec
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hinl_spec

  have hPushoutEtaleInr : ∀ {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
      (f : A →+* B) (g : A →+* C) (inl : B →+* D) (inr : C →+* D),
      CategoryTheory.IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
        (CommRingCat.ofHom inl) (CommRingCat.ofHom inr) →
      f.Etale → inr.Etale := by
    intro A B C D _ _ _ _ f g inl inr hPush hf_et
    have hPb := AlgebraicGeometry.isPullback_SpecMap_of_isPushout
      (CommRingCat.ofHom f) (CommRingCat.ofHom g)
      (CommRingCat.ofHom inl) (CommRingCat.ofHom inr) hPush
    have hf_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf_et
    have hinr_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr)) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hf_spec
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hinr_spec

  have hSecClosedImmersion : ∀ {X B : AlgebraicGeometry.Scheme.{u}}
      (p : X ⟶ B) [AlgebraicGeometry.IsSeparated p] (σ : B ⟶ X),
      σ ≫ p = 𝟙 B → AlgebraicGeometry.IsClosedImmersion σ := by
    intro X B p _ σ hσ
    let Δ : X ⟶ CategoryTheory.Limits.pullback p p := CategoryTheory.Limits.pullback.diagonal p
    have hCl_Δ : AlgebraicGeometry.IsClosedImmersion Δ := inferInstance
    let γ : X ⟶ CategoryTheory.Limits.pullback p p :=
      CategoryTheory.Limits.pullback.lift (𝟙 X) (p ≫ σ)
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hσ,
          CategoryTheory.Category.comp_id])
    have hcomm : σ ≫ Δ = σ ≫ γ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        dsimp only [Δ, γ]
        rw [CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        dsimp only [Δ, γ]
        rw [CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc, hσ,
          CategoryTheory.Category.id_comp]
    have hLim : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.PullbackCone.mk σ σ hcomm) :=
      CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
        (fun c => c.snd ≫ p)
        (fun c => by
          have h2 : c.fst ≫ (Δ ≫ CategoryTheory.Limits.pullback.snd p p) =
              c.snd ≫ (γ ≫ CategoryTheory.Limits.pullback.snd p p) := by
            simp only [← CategoryTheory.Category.assoc, c.condition]
          simp only [Δ, γ, CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id] at h2
          exact (CategoryTheory.Category.assoc c.snd p σ).symm.trans h2.symm)
        (fun c => by
          have h1 : c.fst ≫ (Δ ≫ CategoryTheory.Limits.pullback.fst p p) =
              c.snd ≫ (γ ≫ CategoryTheory.Limits.pullback.fst p p) := by
            simp only [← CategoryTheory.Category.assoc, c.condition]
          simp only [Δ, γ, CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id] at h1
          have h2 : c.fst ≫ (Δ ≫ CategoryTheory.Limits.pullback.snd p p) =
              c.snd ≫ (γ ≫ CategoryTheory.Limits.pullback.snd p p) := by
            simp only [← CategoryTheory.Category.assoc, c.condition]
          simp only [Δ, γ, CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id] at h2
          exact (CategoryTheory.Category.assoc c.snd p σ).symm.trans (h2.symm.trans h1))
        (fun c l _ hl2 => by
          calc l = l ≫ 𝟙 B := (CategoryTheory.Category.comp_id l).symm
            _ = l ≫ (σ ≫ p) := by rw [hσ]
            _ = (l ≫ σ) ≫ p := (CategoryTheory.Category.assoc l σ p).symm
            _ = c.snd ≫ p := by rw [hl2])
    have hPb : CategoryTheory.IsPullback σ σ Δ γ :=
      { w := hcomm, isLimit' := ⟨hLim⟩ }
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hCl_Δ

  have hSpanZero : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B) (g : A),
      f g = 0 → ∀ a ∈ Ideal.span ({g} : Set A), f a = 0 := by
    intro A B _ _ f g hg a ha
    exact RingHom.mem_ker.mp
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (RingHom.mem_ker.mpr hg)) ha)

  have hEtComp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      AlgebraicGeometry.Etale f → AlgebraicGeometry.Etale g → AlgebraicGeometry.Etale (f ≫ g) := by
    intro X Y Z f g hf hg
    haveI := hf
    haveI := hg
    infer_instance

  have hEtIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) [CategoryTheory.IsIso f],
      AlgebraicGeometry.Etale f := by
    intro X Y f _
    infer_instance

  have hOpenComp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      AlgebraicGeometry.IsOpenImmersion f → AlgebraicGeometry.IsOpenImmersion g →
      AlgebraicGeometry.IsOpenImmersion (f ≫ g) := by
    intro X Y Z f g hf hg
    haveI := hf
    haveI := hg
    infer_instance

  have hOpenIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) [CategoryTheory.IsIso f],
      AlgebraicGeometry.IsOpenImmersion f := by
    intro X Y f _
    infer_instance

  
  
  
  obtain ⟨ht_eq, hπ_pR, hφ_pR, hInj_φ, hLoc_Ω⟩ := hRbar_props
  obtain ⟨ht_s_bar, _, _, _, hφ_ι_eq, hg_Rs_sbar, hRange_RK⟩ := hTrait

  have hSurj_π : Function.Surjective π_cl := by
    intro c
    refine ⟨p_R (Polynomial.C c), ?_⟩
    change (π_cl.comp p_R) (Polynomial.C c) = c
    rw [hπ_pR]
    simp

  have hSurj_Rs : Function.Surjective (π_cl.comp ι_Rbar) := by
    let γ_k : k →+* R_s := (AlgebraicGeometry.Spec.preimage (g_Rs ≫ D_bar_ov.hom)).hom
    have hγ_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_k) = g_Rs ≫ D_bar_ov.hom :=
      AlgebraicGeometry.Spec.map_preimage (g_Rs ≫ D_bar_ov.hom)
    have hcomp_spec : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((π_cl.comp ι_Rbar).comp γ_k)) =
        AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hγ_spec,
        ← CategoryTheory.Category.assoc, hg_Rs_sbar, hs_bar_snd, AlgebraicGeometry.Spec.map_id]
    have hcomp_id : (π_cl.comp ι_Rbar).comp γ_k = RingHom.id k :=
      congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hcomp_spec)
    intro c
    exact ⟨γ_k c, RingHom.congr_fun hcomp_id c⟩

  have hLocalSurjProps : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (ρ : A →+* k),
      Function.Surjective ρ →
      RingHom.ker ρ = IsLocalRing.maximalIdeal A ∧
      IsAlgClosed (IsLocalRing.ResidueField A) ∧
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)).base pt = IsLocalRing.closedPoint A) := by
    intro A _ _ ρ hSurj
    haveI : (RingHom.ker ρ).IsMaximal := RingHom.ker_isMaximal_of_surjective ρ hSurj
    have hker : RingHom.ker ρ = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal inferInstance
    let e_res : IsLocalRing.ResidueField A ≃+* k :=
      (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hSurj)
    have hAlgCl : IsAlgClosed (IsLocalRing.ResidueField A) :=
      IsAlgClosed.of_ringEquiv k (IsLocalRing.ResidueField A) e_res.symm
    refine ⟨hker, hAlgCl, fun pt => ?_⟩
    apply PrimeSpectrum.ext
    change Ideal.comap ρ pt.asIdeal = IsLocalRing.maximalIdeal A
    rw [hBotPrime k pt, ← RingHom.ker, hker]

  obtain ⟨hker_π, hAlgCl_Rbar, hClosed_Rbar⟩ := hLocalSurjProps R_bar π_cl hSurj_π
  obtain ⟨_, hAlgCl_Rs, hClosed_Rs⟩ := hLocalSurjProps R_s (π_cl.comp ι_Rbar) hSurj_Rs

  have hCl_π : AlgebraicGeometry.IsClosedImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)) :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_cl) hSurj_π

  have hOpen_jR : AlgebraicGeometry.IsOpenImmersion j_R := by
    letI : Algebra R_bar Ω := φ_R_Ω.toAlgebra
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R_bar Ω _ _ _ t_bar hLoc_Ω

  have hOpen_jA : AlgebraicGeometry.IsOpenImmersion j_A :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
      hOpen_jR

  have hHens_Rbar : HenselianLocalRing R_bar := by
    apply HenselianLocalRing.mk
    intro f hf a₀ hf_a₀ hdf_a₀
    let P_st : StandardEtalePair R_bar :=
      StandardEtalePair.mk f hf (Polynomial.derivative f) ⟨1, 0, 1, by ring⟩
    have hEt_alg : Algebra.Etale R_bar P_st.Ring := inferInstance
    have hEt_hom : (algebraMap R_bar P_st.Ring).Etale := RingHom.etale_algebraMap.mpr hEt_alg
    let w₀ : AlgebraicGeometry.Spec (CommRingCat.of P_st.Ring) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_bar P_st.Ring))
    haveI : AlgebraicGeometry.Etale w₀ :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_hom
    letI : Algebra R_bar k := π_cl.toAlgebra
    have hπ_fa₀ : π_cl (Polynomial.eval a₀ f) = 0 := by
      rw [← RingHom.mem_ker, hker_π]
      exact hf_a₀
    have hπ_eval : ∀ p : Polynomial R_bar,
        Polynomial.eval₂ π_cl (π_cl a₀) p = π_cl (Polynomial.eval a₀ p) := by
      intro p
      induction p using Polynomial.induction_on' with
      | add p₁ p₂ ih₁ ih₂ => simp [map_add, ih₁, ih₂]
      | monomial n r => simp
    have hMap_k : P_st.HasMap (π_cl a₀) := by
      refine ⟨?_, ?_⟩
      · change Polynomial.eval₂ π_cl (π_cl a₀) f = 0
        rw [hπ_eval f]
        exact hπ_fa₀
      · change IsUnit (Polynomial.eval₂ π_cl (π_cl a₀) (Polynomial.derivative f))
        rw [hπ_eval (Polynomial.derivative f)]
        exact hdf_a₀.map π_cl
    let σ_k : P_st.Ring →ₐ[R_bar] k := P_st.homEquiv.symm ⟨π_cl a₀, hMap_k⟩
    let s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P_st.Ring) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_k.toRingHom)
    have hs_w₀ : s_tilde ≫ w₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_bar)) := by
      rw [CategoryTheory.Category.comp_id, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      congr 2
      ext r
      exact σ_k.commutes r
    obtain ⟨g_tilde, hg_w₀, hg_sec⟩ := hLift_Rbar w₀ (𝟙 _) s_tilde hs_w₀
    let φ_tilde : P_st.Ring →+* R_bar := (AlgebraicGeometry.Spec.preimage g_tilde).hom
    have hφ_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) = g_tilde :=
      AlgebraicGeometry.Spec.map_preimage g_tilde
    have hφ_id : φ_tilde.comp (algebraMap R_bar P_st.Ring) = RingHom.id R_bar := by
      have h_spec : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (φ_tilde.comp (algebraMap R_bar P_st.Ring))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id R_bar)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hφ_spec, hg_w₀,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h_spec)
    let φ_alg : P_st.Ring →ₐ[R_bar] R_bar :=
      { φ_tilde with commutes' := fun r => RingHom.congr_fun hφ_id r }
    have hπ_φ : π_cl.comp φ_tilde = σ_k.toRingHom := by
      have h_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp φ_tilde)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_k.toRingHom) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hφ_spec, hg_sec]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h_spec)
    let a : R_bar := (P_st.homEquiv φ_alg).1
    have hMap_a : P_st.HasMap a := (P_st.homEquiv φ_alg).2
    rcases hMap_a with ⟨ha_root_aeval, _⟩
    have ha_root : f.IsRoot a := by
      change Polynomial.eval a f = 0
      simpa [Polynomial.aeval_def, Polynomial.eval₂_id] using ha_root_aeval
    have ha_res : π_cl a = π_cl a₀ := by
      have ha_eq : a = φ_tilde P_st.X := P_st.homEquiv_apply_coe φ_alg
      have hσ_X : σ_k P_st.X = π_cl a₀ := by
        have h1 := (P_st.homEquiv_apply_coe σ_k).symm
        simpa [σ_k] using h1
      calc π_cl a = (π_cl.comp φ_tilde) P_st.X := by rw [ha_eq]; rfl
        _ = σ_k P_st.X := by rw [hπ_φ]; rfl
        _ = π_cl a₀ := hσ_X
    refine ⟨a, ha_root, ?_⟩
    rw [← hker_π, RingHom.mem_ker, map_sub, ha_res, sub_self]

  
  have hProdFieldPrimeEq : ∀ (I_s : Type u) (K_s' : I_s → Type u) [∀ i, Field (K_s' i)]
      (P₁ P₂ : Ideal (∀ i : I_s, K_s' i)),
      P₁.IsPrime → P₂.IsPrime → P₁ ≤ P₂ → P₁ = P₂ := by
    intro I_s K_s' _ P₁ P₂ hP₁ hP₂ hle
    refine le_antisymm hle fun z hz₂ => ?_
    let z' : ∀ i : I_s, K_s' i := fun i => (z i)⁻¹
    have hzz : z * (z * z' - 1) = 0 := by
      ext i
      simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, z']
      by_cases hzi : z i = 0
      · simp [hzi]
      · simp [mul_inv_cancel₀ hzi]
    have hmem0 : z * (z * z' - 1) ∈ P₁ := by rw [hzz]; exact P₁.zero_mem
    rcases hP₁.mem_or_mem hmem0 with hz₁ | h_unit
    · exact hz₁
    · exfalso
      have h_in_P₂ : z * z' - 1 ∈ P₂ := hle h_unit
      have hzz_P₂ : z * z' ∈ P₂ := P₂.mul_mem_right z' hz₂
      have h1_P₂ : (1 : ∀ i : I_s, K_s' i) ∈ P₂ := by
        have h_eq : (1 : ∀ i : I_s, K_s' i) = z * z' - (z * z' - 1) := by ring
        rw [h_eq]
        exact P₂.sub_mem hzz_P₂ h_in_P₂
      exact hP₂.ne_top ((Ideal.eq_top_iff_one P₂).mpr h1_P₂)

  have hTwoPoint_Rbar : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_bar)),
      p ∈ Set.range j_R.base ∨ p = IsLocalRing.closedPoint R_bar := by
    intro p
    by_cases hp_bot : p.asIdeal = ⊥
    · left
      let pt_Ω : PrimeSpectrum Ω := ⟨⊥, Ideal.isPrime_bot⟩
      refine ⟨pt_Ω, PrimeSpectrum.ext ?_⟩
      change Ideal.comap φ_R_Ω ⊥ = p.asIdeal
      rw [hp_bot, ← RingHom.ker, RingHom.ker_eq_bot_iff_eq_zero]
      intro x hx
      exact hInj_φ (hx.trans (map_zero φ_R_Ω).symm)
    · right
      have hex_a : ∃ a ∈ p.asIdeal, a ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hp_bot (Ideal.ext fun x => ⟨fun hx => Ideal.mem_bot.mpr (h_all x hx),
          fun hx => (Ideal.mem_bot.mp hx).symm ▸ p.asIdeal.zero_mem⟩)
      obtain ⟨a, ha_p, ha_ne⟩ := hex_a
      have hφa_ne : φ_R_Ω a ≠ 0 := fun h0 => ha_ne (hInj_φ (h0.trans (map_zero φ_R_Ω).symm))
      letI : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      obtain ⟨n_loc, r_loc, h_surj_eq⟩ :=
        @IsLocalization.Away.surj R_bar _ Ω _ _ t_bar hLoc_Ω ((φ_R_Ω a)⁻¹)
      have h_pow_eq : t_bar ^ n_loc = a * r_loc := by
        apply hInj_φ
        calc φ_R_Ω (t_bar ^ n_loc)
            = φ_R_Ω a * ((φ_R_Ω a)⁻¹ * φ_R_Ω t_bar ^ n_loc) := by
                rw [map_pow, ← mul_assoc, mul_inv_cancel₀ hφa_ne, one_mul]
          _ = φ_R_Ω a * φ_R_Ω r_loc := congrArg (φ_R_Ω a * ·) h_surj_eq
          _ = φ_R_Ω (a * r_loc) := (map_mul φ_R_Ω a r_loc).symm
      have ht_in_p : t_bar ∈ p.asIdeal := by
        have hpow_in_p : t_bar ^ n_loc ∈ p.asIdeal := by
          rw [h_pow_eq]
          exact p.asIdeal.mul_mem_right r_loc ha_p
        rcases Nat.eq_zero_or_pos n_loc with rfl | hn_pos
        · exfalso
          rw [pow_zero] at hpow_in_p
          exact p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hpow_in_p)
        · exact p.isPrime.mem_of_pow_mem n_loc hpow_in_p
      apply PrimeSpectrum.ext
      refine le_antisymm (IsLocalRing.le_maximalIdeal p.isPrime.ne_top) fun x hx_max => ?_
      have hc_type : CategoryTheory.Limits.IsColimit
          ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_col) :=
        CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget CommRingCat.{u}) hc_col
      obtain ⟨i, y, hy_eq⟩ :=
        CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_type (e_pt.inv.hom x)
      let ι_i : ↑(D_col.obj i) →+* R_bar := ((c_col.ι.app i) ≫ e_pt.hom).hom
      have hι_y : ι_i y = x := by
        have hy' : (c_col.ι.app i).hom y = e_pt.inv.hom x := hy_eq
        calc ι_i y = e_pt.hom.hom ((c_col.ι.app i).hom y) := rfl
          _ = (e_pt.inv ≫ e_pt.hom).hom x := by rw [hy']; rfl
          _ = x := by rw [e_pt.inv_hom_id]; rfl
      obtain ⟨ϖ, u_i, e_i, ψ_i, _, hϖ_max, hα_X, _, hψ_X, hψ_et, _⟩ := hStage i
      have hι_t : t_bar = ι_i (↑u_i) * (ι_i ϖ) ^ e_i := by
        have hc_X := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (hCocone i).1) Polynomial.X
        change ι_i ((α_col.app i).hom Polynomial.X) = p_R Polynomial.X at hc_X
        rw [ht_eq, hα_X, map_mul, map_pow] at hc_X
        exact hc_X.symm
      have hϖ_p : ι_i ϖ ∈ p.asIdeal := by
        have hpow_ϖ : (ι_i ϖ) ^ e_i = ι_i (↑u_i⁻¹) * t_bar := by
          rw [hι_t, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
        exact p.isPrime.mem_of_pow_mem e_i (hpow_ϖ ▸ p.asIdeal.mul_mem_left _ ht_in_p)
      let A_i := ↑(D_col.obj i)
      haveI : p.asIdeal.IsPrime := p.isPrime
      let q₁ : Ideal A_i := Ideal.comap ι_i p.asIdeal
      let q₂ : Ideal A_i := Ideal.comap ι_i (IsLocalRing.maximalIdeal R_bar)
      have hq₁_prime : q₁.IsPrime := Ideal.IsPrime.comap ι_i
      have hq₂_prime : q₂.IsPrime := Ideal.IsPrime.comap ι_i
      have hq_le : q₁ ≤ q₂ := Ideal.comap_mono (IsLocalRing.le_maximalIdeal p.isPrime.ne_top)
      let I_ϖ : Ideal A_i := Ideal.span {ϖ}
      have hI_le_q₁ : I_ϖ ≤ q₁ := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖ_p)
      let Q_i := A_i ⧸ I_ϖ
      let mk_i : A_i →+* Q_i := Ideal.Quotient.mk I_ϖ
      let c_Qi : k →+* Q_i := mk_i.comp (ψ_i.comp Polynomial.C)
      have hPush_Qi : CategoryTheory.IsPushout
          (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))
          (CommRingCat.ofHom ψ_i)
          (CommRingCat.ofHom c_Qi)
          (CommRingCat.ofHom mk_i) := by
        have hcomm_Qi : CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)) ≫
            CommRingCat.ofHom c_Qi =
            CommRingCat.ofHom ψ_i ≫ CommRingCat.ofHom mk_i := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          congr 1
          apply Polynomial.ringHom_ext
          · intro c
            change c_Qi (Polynomial.eval (0 : k) (Polynomial.C c)) = mk_i (ψ_i (Polynomial.C c))
            rw [Polynomial.eval_C]
            rfl
          · change c_Qi (Polynomial.eval (0 : k) Polynomial.X) = mk_i (ψ_i Polynomial.X)
            rw [Polynomial.eval_X, map_zero, hψ_X]
            symm
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton ϖ))
        refine { w := hcomm_Qi, isColimit' := ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk
          hcomm_Qi
          (fun coc => CommRingCat.ofHom (Ideal.Quotient.lift I_ϖ coc.inr.hom
            (hSpanZero coc.inr.hom ϖ (by
              have hX := RingHom.congr_fun (congrArg CommRingCat.Hom.hom coc.condition) Polynomial.X
              change coc.inl.hom (Polynomial.eval 0 Polynomial.X) =
                coc.inr.hom (ψ_i Polynomial.X) at hX
              rw [Polynomial.eval_X, map_zero, hψ_X] at hX
              exact hX.symm))))
          (fun coc => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro c
            have hC := RingHom.congr_fun (congrArg CommRingCat.Hom.hom coc.condition) (Polynomial.C c)
            change coc.inl.hom (Polynomial.eval 0 (Polynomial.C c)) =
              coc.inr.hom (ψ_i (Polynomial.C c)) at hC
            rw [Polynomial.eval_C] at hC
            exact hC.symm)
          (fun coc => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro a
            rfl)
          (fun coc l _ hl2 => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro z
            obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
            exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl2) a)⟩ }
      have hc_Qi_et : c_Qi.Etale := hPushoutEtaleInl _ _ _ _ hPush_Qi hψ_et
      letI : Algebra k Q_i := c_Qi.toAlgebra
      have hEt_Qi : Algebra.Etale k Q_i := RingHom.etale_algebraMap.mp hc_Qi_et
      obtain ⟨I_s, _, K_s', hFld_Ks', hAlg_Ks', e_prod, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k Q_i).mp hEt_Qi
      letI : ∀ s, Field (K_s' s) := hFld_Ks'
      let P₁_Q : Ideal Q_i := Ideal.map mk_i q₁
      let P₂_Q : Ideal Q_i := Ideal.map mk_i q₂
      have hker_mk : RingHom.ker mk_i ≤ q₁ := by rwa [Ideal.mk_ker]
      have hker_mk₂ : RingHom.ker mk_i ≤ q₂ := hker_mk.trans hq_le
      have hP₁_prime : P₁_Q.IsPrime :=
        q₁.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_mk
      have hP₂_prime : P₂_Q.IsPrime :=
        q₂.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_mk₂
      let P₁_prod : Ideal (∀ s : I_s, K_s' s) := Ideal.comap e_prod.symm.toRingHom P₁_Q
      let P₂_prod : Ideal (∀ s : I_s, K_s' s) := Ideal.comap e_prod.symm.toRingHom P₂_Q
      have hProd_eq : P₁_prod = P₂_prod :=
        hProdFieldPrimeEq I_s K_s' P₁_prod P₂_prod
          (Ideal.IsPrime.comap _) (Ideal.IsPrime.comap _) (Ideal.comap_mono (Ideal.map_mono hq_le))
      have hPQ_eq : P₁_Q = P₂_Q := by
        ext z
        have hz := SetLike.ext_iff.mp hProd_eq (e_prod z)
        simpa [P₁_prod, P₂_prod] using hz
      have hq_eq : q₁ = q₂ := by
        have hc1 : Ideal.comap mk_i P₁_Q = q₁ := by
          rw [Ideal.comap_map_of_surjective mk_i Ideal.Quotient.mk_surjective, ← RingHom.ker,
            sup_eq_left.mpr hker_mk]
        have hc2 : Ideal.comap mk_i P₂_Q = q₂ := by
          rw [Ideal.comap_map_of_surjective mk_i Ideal.Quotient.mk_surjective, ← RingHom.ker,
            sup_eq_left.mpr hker_mk₂]
        rw [← hc1, ← hc2, hPQ_eq]
      have hy_q₂ : y ∈ q₂ := by
        change ι_i y ∈ IsLocalRing.maximalIdeal R_bar
        rwa [hι_y]
      have hy_q₁ : y ∈ q₁ := hq_eq.symm ▸ hy_q₂
      rwa [← hι_y]

  
  
  
  have hPb_f : CategoryTheory.IsPullback pr_Z f_bar f₀.left pr_D := by
    have hOuter_flip : CategoryTheory.IsPullback (f_bar ≫ D_bar_ov.hom) pr_Z
        f_ext (f₀.left ≫ D₀.hom) := by
      change CategoryTheory.IsPullback
        (f_bar ≫ CategoryTheory.Limits.pullback.snd _ _) pr_Z f_ext (f₀.left ≫ D₀.hom)
      rw [hf_bar_snd, f₀.w]
      exact (CategoryTheory.IsPullback.of_hasPullback Z_tilde.hom f_ext).flip
    exact (CategoryTheory.IsPullback.of_right hOuter_flip hf_bar_fst
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom f_ext).flip).flip

  haveI hProp_fbar : AlgebraicGeometry.IsProper f_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_f inferInstance

  have hLFT_Dbar : AlgebraicGeometry.LocallyOfFiniteType D_bar_ov.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom f_ext) inferInstance

  have hSm_ZΩ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1)
      (CategoryTheory.Limits.pullback.snd f_bar s_Ω) := by
    have hsΩ_sub : Set.range (s_Ω ≫ pr_D).base ⊆ Set.range U₀.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨pt, rfl⟩
      have hfac : s_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_KΩ) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs) := by
        dsimp only [s_Ω]
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      have hmem : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs).base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_KΩ)).base pt) ∈
          ((TopologicalSpace.Opens.map pr_D.base).obj U₀ : Set (weilGeomScheme F D₀)) :=
        hRange_RK ⟨_, rfl⟩
      simpa [hfac] using hmem
    let s_U₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U₀.ι (s_Ω ≫ pr_D) hsΩ_sub
    have hs_U₀_fac : s_U₀ ≫ U₀.ι = s_Ω ≫ pr_D :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι (s_Ω ≫ pr_D) hsΩ_sub
    have hPb_tot : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_bar s_Ω ≫ pr_Z)
        (CategoryTheory.Limits.pullback.snd f_bar s_Ω)
        f₀.left (s_U₀ ≫ U₀.ι) := by
      rw [hs_U₀_fac]
      exact (CategoryTheory.IsPullback.of_hasPullback f_bar s_Ω).paste_horiz hPb_f
    let v_U₀ : Z_Ω ⟶ (f₀.left ⁻¹ᵁ U₀).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift ((f₀.left ⁻¹ᵁ U₀).ι)
        (CategoryTheory.Limits.pullback.fst f_bar s_Ω ≫ pr_Z) (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨z, rfl⟩
          change f₀.left.base ((CategoryTheory.Limits.pullback.fst f_bar s_Ω ≫ pr_Z).base z) ∈ U₀
          have hcond : ((CategoryTheory.Limits.pullback.fst f_bar s_Ω ≫ pr_Z) ≫ f₀.left).base z =
              (CategoryTheory.Limits.pullback.snd f_bar s_Ω ≫ s_U₀ ≫ U₀.ι).base z := by
            rw [hPb_tot.w]
          change ((CategoryTheory.Limits.pullback.fst f_bar s_Ω ≫ pr_Z) ≫ f₀.left).base z ∈ U₀
          rw [hcond]
          exact (s_U₀.base ((CategoryTheory.Limits.pullback.snd f_bar s_Ω).base z)).2)
    have hv_fac : v_U₀ ≫ (f₀.left ⁻¹ᵁ U₀).ι =
        CategoryTheory.Limits.pullback.fst f_bar s_Ω ≫ pr_Z :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have hPb_res := (AlgebraicGeometry.isPullback_morphismRestrict f₀.left U₀).flip
