          exact hExW.of_iso hIso.symm
        let W_jY := (CategoryTheory.Functor.whiskeringLeft (Opposite Y.Etale) (Opposite U.Etale)
          AddCommGrpCat.{u}).obj (weilEtaleSitePullback j_Y).op
        let Sh_Y := CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
        have hZ_WjY : CategoryTheory.Limits.IsZero (S_pre.map W_jY).leftHomology :=
          (W_jY.map_isZero hZ_pre).of_iso (S_pre.mapLeftHomologyIso W_jY)
        let S_HDI := (S_pre.map W_jY).map Sh_Y
        have hEx_ShY : S_HDI.Exact := by
          rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology]
          exact (Sh_Y.map_isZero hZ_WjY).of_iso ((S_pre.map W_jY).mapLeftHomologyIso Sh_Y)
        have hZ1 : CategoryTheory.Limits.IsZero S_HDI.X₁ := ih b hb
        have hZ3 : CategoryTheory.Limits.IsZero S_HDI.X₃ := hVanMod b hb
        have hf0 : S_HDI.f = 0 := hZ1.eq_of_src _ _
        have hg0 : S_HDI.g = 0 := hZ3.eq_of_tgt _ _
        have : CategoryTheory.Mono S_HDI.g := hEx_ShY.mono_g hf0
        change CategoryTheory.Limits.IsZero S_HDI.X₂
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        exact (cancel_mono S_HDI.g).mp
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Limits.zero_comp, hg0])

