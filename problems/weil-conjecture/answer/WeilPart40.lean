                apply AddCommGrpCat.ext; intro g; funext x
                change g ((Θ.fiber.map (v.unop ≫ u.unop)) x) =
                  g ((Θ.fiber.map u.unop) ((Θ.fiber.map v.unop) x))
                rw [Θ.fiber.map_comp]; rfl }
        have hSkyIsSheaf : ∀ (M : AddCommGrpCat.{u}),
            CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (skyPre M) := by
          intro M E X S_sieve hS s hs
          haveI : CategoryTheory.IsCofiltered Θ.fiber.Elements := Θ.isCofiltered
          have hCompatVal : ∀ {Y₁ Y₂ : Z.Etale} (f₁ : Y₁ ⟶ X) (f₂ : Y₂ ⟶ X)
              (hf₁ : S_sieve f₁) (hf₂ : S_sieve f₂) (y₁ : Θ.fiber.obj Y₁) (y₂ : Θ.fiber.obj Y₂)
              (h_eq : Θ.fiber.map f₁ y₁ = Θ.fiber.map f₂ y₂) (e : ↥E),
              ((s f₁ hf₁).hom e) y₁ = ((s f₂ hf₂).hom e) y₂ := by
            intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ h_eq e
            let x₀ : Θ.fiber.obj X := Θ.fiber.map f₁ y₁
            let el₀ : Θ.fiber.Elements := CategoryTheory.Functor.elementsMk Θ.fiber X x₀
            let el₁ : Θ.fiber.Elements := CategoryTheory.Functor.elementsMk Θ.fiber Y₁ y₁
            let el₂ : Θ.fiber.Elements := CategoryTheory.Functor.elementsMk Θ.fiber Y₂ y₂
            let m₁ : el₁ ⟶ el₀ := ⟨f₁, rfl⟩
            let m₂ : el₂ ⟶ el₀ := ⟨f₂, h_eq.symm⟩
            let el₃ := CategoryTheory.IsCofiltered.min el₁ el₂
            let p₁ : el₃ ⟶ el₁ := CategoryTheory.IsCofiltered.minToLeft el₁ el₂
            let p₂ : el₃ ⟶ el₂ := CategoryTheory.IsCofiltered.minToRight el₁ el₂
            let el₄ := CategoryTheory.IsCofiltered.eq (p₁ ≫ m₁) (p₂ ≫ m₂)
            let q : el₄ ⟶ el₃ := CategoryTheory.IsCofiltered.eqHom (p₁ ≫ m₁) (p₂ ≫ m₂)
            have hq := CategoryTheory.IsCofiltered.eq_condition (p₁ ≫ m₁) (p₂ ≫ m₂)
            let g₁ : el₄.1 ⟶ Y₁ := q.1 ≫ p₁.1
            let g₂ : el₄.1 ⟶ Y₂ := q.1 ≫ p₂.1
            have hgf : g₁ ≫ f₁ = g₂ ≫ f₂ := by
              have hval : (q ≫ p₁ ≫ m₁).1 = (q ≫ p₂ ≫ m₂).1 := congrArg (fun k => k.1) hq
              exact (CategoryTheory.Category.assoc q.1 p₁.1 f₁).trans
                (hval.trans (CategoryTheory.Category.assoc q.1 p₂.1 f₂).symm)
            have hy₁' : Θ.fiber.map g₁ el₄.2 = y₁ := by
              change Θ.fiber.map (q.1 ≫ p₁.1) el₄.2 = y₁
              rw [Θ.fiber.map_comp]
              exact (congrArg (Θ.fiber.map p₁.1) q.2).trans p₁.2
            have hy₂' : Θ.fiber.map g₂ el₄.2 = y₂ := by
              change Θ.fiber.map (q.1 ≫ p₂.1) el₄.2 = y₂
              rw [Θ.fiber.map_comp]
              exact (congrArg (Θ.fiber.map p₂.1) q.2).trans p₂.2
            have hs_eq := hs g₁ g₂ hf₁ hf₂ hgf
            have h_eval := congrArg (fun (k : E ⟶ (skyPre M).obj (Opposite.op el₄.1)) =>
              (k.hom e) el₄.2) hs_eq
            change ((s f₁ hf₁).hom e) (Θ.fiber.map g₁ el₄.2) =
              ((s f₂ hf₂).hom e) (Θ.fiber.map g₂ el₄.2) at h_eval
            rwa [hy₁', hy₂'] at h_eval
          let pickY : ∀ (x : Θ.fiber.obj X),
              Σ' (Y : Z.Etale) (u : Y ⟶ X) (_ : S_sieve u) (y : Θ.fiber.obj Y), Θ.fiber.map u y = x :=
            fun x =>
              let hEx := Θ.jointly_surjective S_sieve hS x
              ⟨hEx.choose, hEx.choose_spec.choose, hEx.choose_spec.choose_spec.choose,
                hEx.choose_spec.choose_spec.choose_spec.choose,
                hEx.choose_spec.choose_spec.choose_spec.choose_spec⟩
          let t : E ⟶ (skyPre M).obj (Opposite.op X) :=
            AddCommGrpCat.ofHom
              { toFun := fun e x =>
                  let p := pickY x
                  ((s p.2.1 p.2.2.1).hom e) p.2.2.2.1
                map_zero' := by
                  funext x
                  change ((s (pickY x).2.1 (pickY x).2.2.1).hom 0) (pickY x).2.2.2.1 = 0
                  rw [map_zero]; rfl
                map_add' := fun e₁ e₂ => by
                  funext x
                  change ((s (pickY x).2.1 (pickY x).2.2.1).hom (e₁ + e₂)) (pickY x).2.2.2.1 =
                    ((s (pickY x).2.1 (pickY x).2.2.1).hom e₁) (pickY x).2.2.2.1 +
                      ((s (pickY x).2.1 (pickY x).2.2.1).hom e₂) (pickY x).2.2.2.1
                  rw [map_add]; rfl }
          refine ⟨t, ?_, ?_⟩
          · intro Y u hu
            apply AddCommGrpCat.ext; intro e; funext y
            let p := pickY (Θ.fiber.map u y)
            exact hCompatVal p.2.1 u p.2.2.1 hu p.2.2.2.1 y p.2.2.2.2 e
          · intro t' ht'
            apply AddCommGrpCat.ext; intro e; funext x
            let p := pickY x
            have h_amalg := ht' p.2.1 p.2.2.1
            have h_ev := congrArg (fun (k : E ⟶ (skyPre M).obj (Opposite.op p.1)) =>
              (k.hom e) p.2.2.2.1) h_amalg
            change (t'.hom e) (Θ.fiber.map p.2.1 p.2.2.2.1) =
              ((s p.2.1 p.2.2.1).hom e) p.2.2.2.1 at h_ev
            rw [p.2.2.2.2] at h_ev
            exact h_ev
        { obj := fun M => ⟨skyPre M, hSkyIsSheaf M⟩
          map := fun {M₁ M₂} φ => CategoryTheory.ObjectProperty.homMk
            { app := fun X => AddCommGrpCat.ofHom
                { toFun := fun g x => φ.hom (g x)
                  map_zero' := by funext x; exact map_zero φ.hom
                  map_add' := fun g₁ g₂ => by funext x; exact map_add φ.hom (g₁ x) (g₂ x) }
              naturality := fun _ _ _ => rfl }
          map_id := fun _ => CategoryTheory.Sheaf.hom_ext rfl
          map_comp := fun _ _ => CategoryTheory.Sheaf.hom_ext rfl }

    let adjSkyOf : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (Θ : CategoryTheory.GrothendieckTopology.Point.{u} Z.smallEtaleTopology),
        Θ.sheafFiber (A := AddCommGrpCat.{u}) ⊣ skySheafOf Z Θ :=
      fun Z Θ =>
        let descArg : ∀ {ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
            {M : AddCommGrpCat.{u}} (β : ℱ ⟶ (skySheafOf Z Θ).obj M) (X : Z.Etale) (x : Θ.fiber.obj X),
            ℱ.obj.obj (Opposite.op X) ⟶ M :=
          fun β X x => AddCommGrpCat.ofHom
            { toFun := fun s => (β.hom.app (Opposite.op X)).hom s x
              map_zero' := by
                change ((β.hom.app (Opposite.op X)).hom 0) x = 0
                rw [map_zero]; rfl
              map_add' := fun s₁ s₂ => by
                change ((β.hom.app (Opposite.op X)).hom (s₁ + s₂)) x =
                  ((β.hom.app (Opposite.op X)).hom s₁) x + ((β.hom.app (Opposite.op X)).hom s₂) x
                rw [map_add]; rfl }
        have descCompat : ∀ {ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
            {M : AddCommGrpCat.{u}} (β : ℱ ⟶ (skySheafOf Z Θ).obj M)
            ⦃X Y : Z.Etale⦄ (u : X ⟶ Y) (x : Θ.fiber.obj X),
            ℱ.obj.map u.op ≫ descArg β X x = descArg β Y (Θ.fiber.map u x) := by
          intro ℱ M β X Y u x
          apply AddCommGrpCat.ext; intro s
          exact congrArg (fun k => (k.hom s) x) (β.hom.naturality u.op)
        let toSkyHom : ∀ {ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
            {M : AddCommGrpCat.{u}},
            (Θ.sheafFiber.obj ℱ ⟶ M) → (ℱ ⟶ (skySheafOf Z Θ).obj M) :=
          fun {ℱ M} α => CategoryTheory.ObjectProperty.homMk
            { app := fun X => AddCommGrpCat.ofHom
                { toFun := fun s x => (Θ.toPresheafFiber X.unop x ℱ.obj ≫ α).hom s
                  map_zero' := by
                    funext x
                    exact map_zero (Θ.toPresheafFiber X.unop x ℱ.obj ≫ α).hom
                  map_add' := fun s₁ s₂ => by
                    funext x
                    exact map_add (Θ.toPresheafFiber X.unop x ℱ.obj ≫ α).hom s₁ s₂ }
              naturality := fun {X₁ X₂} u => by
                apply AddCommGrpCat.ext; intro s; funext x₂
                have hw := Θ.toPresheafFiber_w u.unop x₂ ℱ.obj
                have hw' : (ℱ.obj.map u ≫ Θ.toPresheafFiber X₂.unop x₂ ℱ.obj) ≫ α =
                    Θ.toPresheafFiber X₁.unop (Θ.fiber.map u.unop x₂) ℱ.obj ≫ α :=
                  congrArg (· ≫ α) hw
                exact congrArg (fun k => k.hom s) hw' }
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun ℱ M =>
              { toFun := fun α => toSkyHom α
                invFun := fun β => Θ.presheafFiberDesc (descArg β) (descCompat β)
                left_inv := fun α => by
                  apply Θ.presheafFiber_hom_ext
                  intro X x
                  have hd : Θ.toPresheafFiber X x ℱ.obj ≫
                      Θ.presheafFiberDesc (descArg (toSkyHom α)) (descCompat (toSkyHom α)) =
                      descArg (toSkyHom α) X x :=
                    Θ.toPresheafFiber_presheafFiberDesc
                      (descArg (toSkyHom α)) (descCompat (toSkyHom α)) X x
                  refine hd.trans ?_
                  apply AddCommGrpCat.ext; intro s; rfl
                right_inv := fun β => by
                  dsimp only []
                  apply CategoryTheory.Sheaf.hom_ext
                  ext X : 2
                  apply AddCommGrpCat.ext; intro s; funext x
                  have hd := Θ.toPresheafFiber_presheafFiberDesc
                    (descArg β) (descCompat β) X.unop x
                  exact congrArg (fun k => k.hom s) hd }
            homEquiv_naturality_left_symm := fun {ℱ' ℱ M} u g => by
              apply Θ.presheafFiber_hom_ext
              intro X x
              have hd₁ : Θ.toPresheafFiber X x ℱ'.obj ≫
                  Θ.presheafFiberDesc (descArg (u ≫ g)) (descCompat (u ≫ g)) =
                  descArg (u ≫ g) X x :=
                Θ.toPresheafFiber_presheafFiberDesc (descArg (u ≫ g)) (descCompat (u ≫ g)) X x
              have hnat : Θ.toPresheafFiber X x ℱ'.obj ≫ Θ.presheafFiber.map u.hom =
                  u.hom.app (Opposite.op X) ≫ Θ.toPresheafFiber X x ℱ.obj :=
                Θ.toPresheafFiber_naturality u.hom X x
              have hd₂ : Θ.toPresheafFiber X x ℱ.obj ≫
                  Θ.presheafFiberDesc (descArg g) (descCompat g) =
                  descArg g X x :=
                Θ.toPresheafFiber_presheafFiberDesc (descArg g) (descCompat g) X x
              have h_rhs : Θ.toPresheafFiber X x ℱ'.obj ≫
                  (Θ.presheafFiber.map u.hom ≫ Θ.presheafFiberDesc (descArg g) (descCompat g)) =
                  u.hom.app (Opposite.op X) ≫ descArg g X x :=
                (CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ _) hnat).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      (congrArg (u.hom.app (Opposite.op X) ≫ ·) hd₂)))
              refine hd₁.trans (Eq.symm (h_rhs.trans ?_))
              apply AddCommGrpCat.ext; intro s; rfl
            homEquiv_naturality_right := fun {ℱ M M'} α v => by
              apply CategoryTheory.Sheaf.hom_ext
              ext X : 2
              apply AddCommGrpCat.ext; intro s; funext x; rfl }

    have hPointFiberPullbackIso : ∀
        (Φ : CategoryTheory.GrothendieckTopology.Point.{u} Z_s.smallEtaleTopology)
        (Ψ : CategoryTheory.GrothendieckTopology.Point.{u} S.smallEtaleTopology)
        (e_fib : weilEtaleSitePullback i_s ⋙ Φ.fiber ≅ Ψ.fiber),
        Nonempty (pb_ab ⋙ Φ.sheafFiber (A := AddCommGrpCat.{u}) ≅
          Ψ.sheafFiber (A := AddCommGrpCat.{u})) := by
      intro Φ Ψ e_fib
      let e_sky : skySheafOf Z_s Φ ⋙ pf_ab ≅ skySheafOf S Ψ :=
        CategoryTheory.NatIso.ofComponents
          (fun M =>
            { hom := CategoryTheory.ObjectProperty.homMk
                { app := fun U => AddCommGrpCat.ofHom
                    { toFun := fun g y => g (e_fib.inv.app U.unop y)
                      map_zero' := rfl
                      map_add' := fun _ _ => rfl }
                  naturality := fun {U₁ U₂} u => by
                    apply AddCommGrpCat.ext; intro g; funext y₂
                    have hnat := congrArg (fun k => k y₂) (e_fib.inv.naturality u.unop)
                    exact congrArg g hnat.symm }
              inv := CategoryTheory.ObjectProperty.homMk
                { app := fun U => AddCommGrpCat.ofHom
                    { toFun := fun g x => g (e_fib.hom.app U.unop x)
                      map_zero' := rfl
                      map_add' := fun _ _ => rfl }
                  naturality := fun {U₁ U₂} u => by
                    apply AddCommGrpCat.ext; intro g; funext x₂
                    have hnat := congrArg (fun k => k x₂) (e_fib.hom.naturality u.unop)
                    exact congrArg g hnat.symm }
              hom_inv_id := by
                apply CategoryTheory.Sheaf.hom_ext; ext U : 2
                apply AddCommGrpCat.ext; intro g; funext x
                exact congrArg g (congrArg (fun k => k x) (e_fib.hom_inv_id_app U.unop))
              inv_hom_id := by
                apply CategoryTheory.Sheaf.hom_ext; ext U : 2
                apply AddCommGrpCat.ext; intro g; funext y
                exact congrArg g (congrArg (fun k => k y) (e_fib.inv_hom_id_app U.unop)) })
          (fun _ => CategoryTheory.Sheaf.hom_ext rfl)
      exact ⟨(adj_ab.comp (adjSkyOf Z_s Φ)).leftAdjointUniq
        ((adjSkyOf S Ψ).ofNatIsoRight e_sky.symm)⟩

    let idEtale : ∀ (X : AlgebraicGeometry.Scheme.{u}), X.Etale :=
      fun X => AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)
    let geomFib : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω]
        (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z),
        CategoryTheory.Functor Z.Etale (Type u) :=
      fun Z Ω _ z =>
        weilEtaleSitePullback z ⋙
          CategoryTheory.coyoneda.obj (Opposite.op (idEtale (AlgebraicGeometry.Spec (CommRingCat.of Ω))))

    have hGeomJointSurj : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z)
        {U : Z.Etale} (R_s : CategoryTheory.Sieve U),
        R_s ∈ Z.smallEtaleTopology U →
        ∀ (x : (geomFib Z Ω z).obj U),
          ∃ (Y : Z.Etale) (u : Y ⟶ U), ∃ (_ : R_s u), ∃ y : (geomFib Z Ω z).obj Y,
            (geomFib Z Ω z).map u y = x := by
      intro Z Ω _ _ z U R_s hR x
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let u_hom : Quiver.Hom U.left Z := U.hom
      let x_left : Quiver.Hom S_Ω (CategoryTheory.Limits.pullback u_hom z) := x.left
      have hx_snd : x_left ≫ CategoryTheory.Limits.pullback.snd u_hom z = 𝟙 S_Ω :=
        CategoryTheory.MorphismProperty.Over.w x
      let g_U : Quiver.Hom S_Ω U.left := x_left ≫ CategoryTheory.Limits.pullback.fst u_hom z
      have hg_U_z : g_U ≫ u_hom = z := by
        calc
          g_U ≫ u_hom = x_left ≫ (CategoryTheory.Limits.pullback.fst u_hom z ≫ u_hom) :=
            CategoryTheory.Category.assoc _ _ _
          _ = x_left ≫ (CategoryTheory.Limits.pullback.snd u_hom z ≫ z) :=
            congrArg (x_left ≫ ·) (CategoryTheory.Limits.pullback.condition (f := u_hom) (g := z))
          _ = (x_left ≫ CategoryTheory.Limits.pullback.snd u_hom z) ≫ z :=
            (CategoryTheory.Category.assoc _ _ _).symm
          _ = z := by rw [hx_snd, CategoryTheory.Category.id_comp]
      have hEqZ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Z (le_refl P_et)
      have hR' : R_s ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U :=
        Eq.mp (congrArg (fun T => R_s ∈ T U) hEqZ) hR
      have hMemZ := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := Z) U R_s).mp hR'
      let pt_Ω : ↥S_Ω := Nonempty.some inferInstance
      obtain ⟨Y, u, y₀, huR, huEt, huy₀⟩ := hMemZ (g_U.base pt_Ω)
      let u_left : Quiver.Hom Y.left U.left := u.left
      have huEt' : P_et u_left := huEt
      let P := CategoryTheory.Limits.pullback u_left g_U
      let p_fst : Quiver.Hom P Y.left := CategoryTheory.Limits.pullback.fst u_left g_U
      let p_snd : Quiver.Hom P S_Ω := CategoryTheory.Limits.pullback.snd u_left g_U
      have hp_et : AlgebraicGeometry.Etale p_snd :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback u_left g_U) huEt'
      obtain ⟨p₀, -, hp₀_pt⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback u_left g_U) y₀ pt_Ω huy₀
      haveI : AlgebraicGeometry.Surjective p_snd :=
        ⟨fun s => ⟨p₀, hp₀_pt.trans (Subsingleton.elim pt_Ω s)⟩⟩
      let S_p : CategoryTheory.Sieve S_Ω :=
        { arrows := fun W f => ∃ g : W ⟶ P, g ≫ p_snd = f
          downward_closed := fun {W Z'} f ⟨g, hg⟩ h =>
            ⟨h ≫ g, (CategoryTheory.Category.assoc h g p_snd).trans (congrArg (h ≫ ·) hg)⟩ }
      have hMemBig : S_p ∈ AlgebraicGeometry.Scheme.etaleTopology S_Ω := by
        refine AlgebraicGeometry.Scheme.mem_grothendieckTopology_iff.mpr
          ⟨AlgebraicGeometry.Scheme.Hom.cover (P := @AlgebraicGeometry.Etale) p_snd hp_et, ?_⟩
        intro W f hf
        rcases hf with ⟨i⟩
        exact ⟨𝟙 P, CategoryTheory.Category.id_comp p_snd⟩
      let Φ_big := AlgebraicGeometry.Scheme.geometricFiber Ω
      obtain ⟨W_big, f_big, hf_singleton, s_W, hs_W⟩ :=
        Φ_big.jointly_surjective S_p hMemBig (𝟙 S_Ω)
      rcases hf_singleton with ⟨g_factor, hg_factor⟩
      let s_W' : Quiver.Hom S_Ω W_big := s_W
      let sec_P : Quiver.Hom S_Ω P := s_W' ≫ g_factor
      have hsec_snd : sec_P ≫ p_snd = 𝟙 S_Ω :=
        (CategoryTheory.Category.assoc s_W' g_factor p_snd).trans
          ((congrArg (s_W' ≫ ·) hg_factor).trans hs_W)
      let g_Y : Quiver.Hom S_Ω Y.left := sec_P ≫ p_fst
      have hg_Y_u : g_Y ≫ u_left = g_U := by
        calc
          g_Y ≫ u_left = sec_P ≫ (p_fst ≫ u_left) := CategoryTheory.Category.assoc _ _ _
          _ = sec_P ≫ (p_snd ≫ g_U) :=
            congrArg (sec_P ≫ ·) (CategoryTheory.Limits.pullback.condition (f := u_left) (g := g_U))
          _ = (sec_P ≫ p_snd) ≫ g_U := (CategoryTheory.Category.assoc _ _ _).symm
          _ = g_U := by rw [hsec_snd, CategoryTheory.Category.id_comp]
      let y_hom : Quiver.Hom Y.left Z := Y.hom
      have hu_w : u_left ≫ u_hom = y_hom := CategoryTheory.MorphismProperty.Over.w u
      have hg_Y_z : g_Y ≫ y_hom = 𝟙 S_Ω ≫ z :=
        (congrArg (g_Y ≫ ·) hu_w.symm).trans
          (((CategoryTheory.Category.assoc g_Y u_left u_hom).symm.trans
            (congrArg (· ≫ u_hom) hg_Y_u)).trans
            (hg_U_z.trans (CategoryTheory.Category.id_comp z).symm))
      let y_left : Quiver.Hom S_Ω (CategoryTheory.Limits.pullback y_hom z) :=
        CategoryTheory.Limits.pullback.lift g_Y (𝟙 S_Ω) hg_Y_z
      let y_el : (geomFib Z Ω z).obj Y :=
        CategoryTheory.MorphismProperty.Over.homMk y_left
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      refine ⟨Y, u, huR, y_el, ?_⟩
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      let map_u_left : Quiver.Hom (CategoryTheory.Limits.pullback y_hom z)
          (CategoryTheory.Limits.pullback u_hom z) := ((weilEtaleSitePullback z).map u).left
      have h_map_fst : map_u_left ≫ CategoryTheory.Limits.pullback.fst u_hom z =
          CategoryTheory.Limits.pullback.fst y_hom z ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_map_snd : map_u_left ≫ CategoryTheory.Limits.pullback.snd u_hom z =
          CategoryTheory.Limits.pullback.snd y_hom z :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hy_fst : y_left ≫ CategoryTheory.Limits.pullback.fst y_hom z = g_Y :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hy_snd : y_left ≫ CategoryTheory.Limits.pullback.snd y_hom z = 𝟙 S_Ω :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc y_left map_u_left _).trans
          ((congrArg (y_left ≫ ·) h_map_fst).trans
            (((CategoryTheory.Category.assoc y_left _ u_left).symm.trans
              (congrArg (· ≫ u_left) hy_fst)).trans hg_Y_u))
      · exact (CategoryTheory.Category.assoc y_left map_u_left _).trans
          ((congrArg (y_left ≫ ·) h_map_snd).trans (hy_snd.trans hx_snd.symm))

    let geomPt : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z),
        CategoryTheory.GrothendieckTopology.Point.{u} Z.smallEtaleTopology :=
      fun Z Ω _ _ z =>
        haveI : CategoryTheory.Limits.PreservesFiniteLimits (weilEtaleSitePullback z) := hPresLimB z
        haveI : CategoryTheory.Limits.PreservesFiniteLimits (geomFib Z Ω z) := inferInstance
        have hCof : CategoryTheory.IsCofiltered (geomFib Z Ω z).Elements :=
          CategoryTheory.Functor.isCofiltered_elements (geomFib Z Ω z)
        have hInitSmall : CategoryTheory.InitiallySmall.{u} (geomFib Z Ω z).Elements := by
          let G_Z := (CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
            AlgebraicGeometry.Scheme.AffineEtale.Spec Z
          have hCD : G_Z.IsCoverDense Z.smallEtaleTopology := hSmallAffCoverDense Z
          rcases hCD with ⟨hCovZ⟩
          let idx := Σ (m_idx : CategoryTheory.SmallModel.{u} Z.AffineEtale),
            (geomFib Z Ω z).obj (G_Z.obj m_idx)
          let emb : idx → (geomFib Z Ω z).Elements :=
            fun p => CategoryTheory.Functor.elementsMk (geomFib Z Ω z) (G_Z.obj p.1) p.2
          refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range emb) ?_
          intro el
          let U : Z.Etale := el.1
          let x : (geomFib Z Ω z).obj U := el.2
          obtain ⟨Y, u, hu, y, hy⟩ := hGeomJointSurj Z Ω z
            (CategoryTheory.Sieve.coverByImage G_Z U) (hCovZ U) x
          rcases hu with ⟨⟨m_idx, f₁, f₂, hfac⟩⟩
          let y_m : (geomFib Z Ω z).obj (G_Z.obj m_idx) := (geomFib Z Ω z).map f₁ y
          refine ⟨emb ⟨m_idx, y_m⟩, ⟨⟨m_idx, y_m⟩, rfl⟩, ⟨⟨f₂, ?_⟩⟩⟩
          change (geomFib Z Ω z).map f₂ ((geomFib Z Ω z).map f₁ y) = x
          have hcomp : ((geomFib Z Ω z).map (f₁ ≫ f₂)) y = x := by rw [hfac]; exact hy
          rwa [(geomFib Z Ω z).map_comp] at hcomp
        { fiber := geomFib Z Ω z
          isCofiltered := hCof
          initiallySmall := hInitSmall
          jointly_surjective := fun {U} R_s hR x => hGeomJointSurj Z Ω z R_s hR x }

    have hZeroOfGeomStalks : ∀
        (ℋ : CategoryTheory.Sheaf Z_s.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z_s),
          CategoryTheory.Limits.IsZero ((geomPt Z_s Ω z).sheafFiber.obj ℋ)) →
        CategoryTheory.Limits.IsZero ℋ := by
      intro ℋ hStalks
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.Sheaf.hom_ext
      ext U_op : 2
      let U : Z_s.Etale := U_op.unop
      apply AddCommGrpCat.ext
      intro (s : ↥(ℋ.obj.obj (Opposite.op U)))
      change s = 0
      have hLocalZero : ∀ (x₀ : ↥U.left),
          ∃ (V : Z_s.Etale) (v : V ⟶ U) (y₀ : ↥V.left),
            P_et v.left ∧ v.left.base y₀ = x₀ ∧ (ℋ.obj.map v.op).hom s = 0 := by
        intro x₀
        let κ := U.left.residueField x₀
        let Ω : Type u := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let g_x : Quiver.Hom S_Ω U.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)) ≫
            U.left.fromSpecResidueField x₀
        let u_hom : Quiver.Hom U.left Z_s := U.hom
        let z_x : Quiver.Hom S_Ω Z_s := g_x ≫ u_hom
        let Φ_x := geomPt Z_s Ω z_x
        let σ_left : Quiver.Hom S_Ω (CategoryTheory.Limits.pullback u_hom z_x) :=
          CategoryTheory.Limits.pullback.lift g_x (𝟙 S_Ω) (CategoryTheory.Category.id_comp z_x).symm
        let σ_x : Φ_x.fiber.obj U :=
          CategoryTheory.MorphismProperty.Over.homMk σ_left
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        have hZeroStalk : CategoryTheory.Limits.IsZero (Φ_x.presheafFiber.obj ℋ.obj) :=
          hStalks Ω z_x
        have h_id_zero : 𝟙 (Φ_x.presheafFiber.obj ℋ.obj) = 0 :=
          (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hZeroStalk
        have h_to_eq : (Φ_x.toPresheafFiber U σ_x ℋ.obj).hom s =
            (Φ_x.toPresheafFiber U σ_x ℋ.obj).hom 0 := by
          have h1 : (Φ_x.toPresheafFiber U σ_x ℋ.obj ≫ 𝟙 _).hom s =
              (Φ_x.toPresheafFiber U σ_x ℋ.obj ≫ 0).hom s :=
            congrArg (fun k => (Φ_x.toPresheafFiber U σ_x ℋ.obj ≫ k).hom s) h_id_zero
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero] at h1
          exact h1.trans (map_zero (Φ_x.toPresheafFiber U σ_x ℋ.obj).hom).symm
        obtain ⟨V, v, y_el, hy_map, hs_zero⟩ :=
          (Φ_x.toPresheafFiber_eq_iff' U σ_x s 0).mp h_to_eq
        have hs_zero' : (ℋ.obj.map v.op).hom s = 0 := hs_zero.trans (map_zero _)
        let pt_Ω : ↥S_Ω := Nonempty.some inferInstance
        let v_hom : Quiver.Hom V.left Z_s := V.hom
        let y_U : Quiver.Hom S_Ω V.left :=
          y_el.left ≫ CategoryTheory.Limits.pullback.fst v_hom z_x
        have hy_v_eq : y_U ≫ v.left = g_x := by
          let map_v_left : Quiver.Hom (CategoryTheory.Limits.pullback v_hom z_x)
              (CategoryTheory.Limits.pullback u_hom z_x) := ((weilEtaleSitePullback z_x).map v).left
          have h_left_eq : (y_el.left : Quiver.Hom S_Ω _) ≫ map_v_left = σ_left :=
            congrArg (fun m_hom => m_hom.left) hy_map
          have h_fst := congrArg (· ≫ CategoryTheory.Limits.pullback.fst u_hom z_x) h_left_eq
          have h_rhs : σ_left ≫ CategoryTheory.Limits.pullback.fst u_hom z_x = g_x :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h_map_fst : map_v_left ≫ CategoryTheory.Limits.pullback.fst u_hom z_x =
              CategoryTheory.Limits.pullback.fst v_hom z_x ≫ v.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h_lhs : ((y_el.left : Quiver.Hom S_Ω _) ≫ map_v_left) ≫
              CategoryTheory.Limits.pullback.fst u_hom z_x = y_U ≫ v.left :=
            (CategoryTheory.Category.assoc _ map_v_left _).trans
              ((congrArg (_ ≫ ·) h_map_fst).trans
                (CategoryTheory.Category.assoc _ _ v.left).symm)
          exact h_lhs.symm.trans (h_fst.trans h_rhs)
        have hv_et : P_et v.left :=
          CategoryTheory.MorphismProperty.of_postcomp P_et v.left u_hom U.prop
            ((CategoryTheory.MorphismProperty.Over.w v).symm ▸ V.prop)
        refine ⟨V, v, y_U.base pt_Ω, hv_et, ?_, hs_zero'⟩
        have h_base := congrArg (fun (k : S_Ω ⟶ U.left) => k.base pt_Ω) hy_v_eq
        change v.left.base (y_U.base pt_Ω) =
          (U.left.fromSpecResidueField x₀).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω))).base pt_Ω) at h_base
        exact h_base.trans (AlgebraicGeometry.Scheme.fromSpecResidueField_apply x₀ _)
      let R_cov : CategoryTheory.Sieve U :=
        { arrows := fun Y u => (ℋ.obj.map u.op).hom s = 0
          downward_closed := fun {Y Z'} u hu g => by
            rw [CategoryTheory.op_comp, ℋ.obj.map_comp]
            change (ℋ.obj.map g.op).hom ((ℋ.obj.map u.op).hom s) = 0
            rw [hu, map_zero] }
      have hR_mem : R_cov ∈ Z_s.smallEtaleTopology U := by
        have hEqZ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) Z_s (le_refl P_et)
        have hR' : R_cov ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U := by
          refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) (S := Z_s) U R_cov).mpr ?_
          intro x₀
          obtain ⟨V, v, y₀, hv_et, hvy₀, hs_v⟩ := hLocalZero x₀
          exact ⟨V, v, y₀, hs_v, hv_et, hvy₀⟩
        exact Eq.mpr (congrArg (fun T => R_cov ∈ T U) hEqZ) hR'
      let E_Z : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let fam : CategoryTheory.Presieve.FamilyOfElements
          (ℋ.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op E_Z)) R_cov.arrows :=
        fun Y _ _ => (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op Y))
      let φ_s : E_Z ⟶ ℋ.obj.obj (Opposite.op U) :=
        AddCommGrpCat.ofHom ((zmultiplesHom ↥(ℋ.obj.obj (Opposite.op U)) s).comp
          AddEquiv.ulift.toAddMonoidHom)
      have h_amalg_s : fam.IsAmalgamation φ_s := by
        intro Y u hu
        change φ_s ≫ ℋ.obj.map u.op = (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op Y))
        apply AddCommGrpCat.ext
        rintro ⟨n⟩
        change (ℋ.obj.map u.op).hom (n • s) = 0
        rw [map_zsmul, hu, smul_zero]
      have h_amalg_0 : fam.IsAmalgamation (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op U)) := by
        intro Y u _
        change (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op U)) ≫ ℋ.obj.map u.op =
          (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op Y))
        exact CategoryTheory.Limits.zero_comp
      have h_eq_φ : φ_s = (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op U)) :=
        (ℋ.property E_Z R_cov hR_mem).isSeparatedFor fam
          φ_s (0 : E_Z ⟶ ℋ.obj.obj (Opposite.op U)) h_amalg_s h_amalg_0
      have h_one := congrArg (fun (k : E_Z ⟶ ℋ.obj.obj (Opposite.op U)) => k.hom (ULift.up 1)) h_eq_φ
      change (1 : ℤ) • s = 0 at h_one
      exact (one_smul ℤ s).symm.trans h_one

    have hpb_mono : pb_ab.PreservesMonomorphisms := ⟨fun {𝒜₁ 𝒜₂} v hv => by
      have hKerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel (pb_ab.map v)) := by
        refine hZeroOfGeomStalks (CategoryTheory.Limits.kernel (pb_ab.map v)) (fun Ω _ _ z₁ => ?_)
        let Φ₁ := geomPt Z_s Ω z₁
        let Φ₂ := geomPt S Ω (z₁ ≫ i_s)
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let e_comp : weilEtaleSitePullback (z₁ ≫ i_s) ≅
            weilEtaleSitePullback i_s ⋙ weilEtaleSitePullback z₁ :=
          CategoryTheory.MorphismProperty.Over.pullbackComp z₁ i_s
        let e_fib : weilEtaleSitePullback i_s ⋙ Φ₁.fiber ≅ Φ₂.fiber :=
          CategoryTheory.Functor.isoWhiskerRight e_comp.symm
            (CategoryTheory.coyoneda.obj (Opposite.op (idEtale S_Ω)))
        obtain ⟨e_stalk⟩ := hPointFiberPullbackIso Φ₁ Φ₂ e_fib
        let F₁ := Φ₁.sheafFiber (A := AddCommGrpCat.{u})
        let F₂ := Φ₂.sheafFiber (A := AddCommGrpCat.{u})
        haveI : CategoryTheory.Mono (F₂.map v) := inferInstance
        have hmap_eq : F₁.map (pb_ab.map v) =
            e_stalk.hom.app 𝒜₁ ≫ F₂.map v ≫ e_stalk.inv.app 𝒜₂ := by
          have hnat : F₁.map (pb_ab.map v) ≫ e_stalk.hom.app 𝒜₂ =
              e_stalk.hom.app 𝒜₁ ≫ F₂.map v :=
            e_stalk.hom.naturality v
          apply (CategoryTheory.cancel_mono (e_stalk.hom.app 𝒜₂)).mp
          rw [hnat, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            e_stalk.inv_hom_id_app, CategoryTheory.Category.comp_id]
        haveI : CategoryTheory.Mono (e_stalk.hom.app 𝒜₁ ≫ F₂.map v ≫ e_stalk.inv.app 𝒜₂) :=
          CategoryTheory.mono_comp (e_stalk.hom.app 𝒜₁) (F₂.map v ≫ e_stalk.inv.app 𝒜₂)
        haveI : CategoryTheory.Mono (F₁.map (pb_ab.map v)) := by rwa [hmap_eq]
        let e_ker : F₁.obj (CategoryTheory.Limits.kernel (pb_ab.map v)) ≅
            CategoryTheory.Limits.kernel (F₁.map (pb_ab.map v)) :=
          CategoryTheory.Limits.PreservesKernel.iso F₁ (pb_ab.map v)
        refine CategoryTheory.Limits.IsZero.of_iso ?_ e_ker
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero,
          ← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (F₁.map (pb_ab.map v))),
          CategoryTheory.Category.id_comp, CategoryTheory.Limits.zero_comp,
          ← CategoryTheory.cancel_mono (F₁.map (pb_ab.map v)),
          CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
      exact CategoryTheory.Preadditive.mono_of_kernel_zero (hKerZero.eq_of_src _ _)⟩

    exact ⟨hr_is, hpb_add, hpb_mono⟩
  obtain ⟨hr_is, hpb_add, hpb_mono⟩ := hSite_is

  
  
  
  have hExactExtBij : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
      [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.EnoughInjectives C₁]
      [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
      [CategoryTheory.HasExt.{u} C₂]
      (G : CategoryTheory.Functor C₁ C₂) [G.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (X₁ : C₁) (X₂ : C₂) (η : X₂ ⟶ G.obj X₁),
      (∀ Y : C₁, Function.Bijective (fun f : X₁ ⟶ Y => η ≫ G.map f)) →
      (∀ (ℐ : C₁) [CategoryTheory.Injective ℐ] (q : ℕ)
        (ω : CategoryTheory.Abelian.Ext.{u} X₂ (G.obj ℐ) (q + 1)), ω = 0) →
      ∀ (q : ℕ) (Y : C₁),
        Function.Bijective
          (((CategoryTheory.Abelian.Ext.mk₀ η).precomp (G.obj Y) (Nat.zero_add q)).comp
            (G.mapExtAddHom X₁ Y q)) := by
    intro C₁ C₂ _ _ _ _ _ _ _ G _ _ _ X₁ X₂ η hBij0 hVan q
    induction q with
    | zero =>
      intro Y
      have hmk₁ : Function.Bijective
          (CategoryTheory.Abelian.Ext.mk₀ : (X₁ ⟶ Y) → CategoryTheory.Abelian.Ext.{u} X₁ Y 0) :=
        CategoryTheory.Abelian.Ext.mk₀_bijective X₁ Y
      have hmk₂ : Function.Bijective
          (CategoryTheory.Abelian.Ext.mk₀ :
            (X₂ ⟶ G.obj Y) → CategoryTheory.Abelian.Ext.{u} X₂ (G.obj Y) 0) :=
        CategoryTheory.Abelian.Ext.mk₀_bijective X₂ (G.obj Y)
      have hcomm : ∀ f : X₁ ⟶ Y,
          (((CategoryTheory.Abelian.Ext.mk₀ η).precomp (G.obj Y) (Nat.zero_add 0)).comp
            (G.mapExtAddHom X₁ Y 0)) (CategoryTheory.Abelian.Ext.mk₀ f) =
            CategoryTheory.Abelian.Ext.mk₀ (η ≫ G.map f) := by
        intro f
        change (CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G (CategoryTheory.Abelian.Ext.mk₀ f))
          (Nat.zero_add 0) = _
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ heq
        obtain ⟨f₁, rfl⟩ := hmk₁.2 a₁
        obtain ⟨f₂, rfl⟩ := hmk₁.2 a₂
        rw [hcomm f₁, hcomm f₂] at heq
        exact congrArg CategoryTheory.Abelian.Ext.mk₀ ((hBij0 Y).1 (hmk₂.1 heq))
      · intro b
        obtain ⟨g, rfl⟩ := hmk₂.2 b
        obtain ⟨f, rfl⟩ := (hBij0 Y).2 g
        exact ⟨CategoryTheory.Abelian.Ext.mk₀ f, hcomm f⟩
    | succ q ih =>
      intro Y
      let ℐ : C₁ := CategoryTheory.Injective.under Y
      let ι_Y : Y ⟶ ℐ := CategoryTheory.Injective.ι Y
      let 𝒬 : C₁ := CategoryTheory.Limits.cokernel ι_Y
      let π_Y : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π ι_Y
      let SC : CategoryTheory.ShortComplex C₁ :=
        CategoryTheory.ShortComplex.mk ι_Y π_Y (CategoryTheory.Limits.cokernel.condition ι_Y)
      have hSE : SC.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_Y) inferInstance inferInstance
      have hSE_G : (SC.map G).ShortExact := hSE.map_of_exact G
      let Φ := fun (W : C₁) (k : ℕ) =>
        ((CategoryTheory.Abelian.Ext.mk₀ η).precomp (G.obj W) (Nat.zero_add k)).comp
          (G.mapExtAddHom X₁ W k)
      have hΦ_conn : ∀ z : CategoryTheory.Abelian.Ext.{u} X₁ 𝒬 q,
          Φ Y (q + 1) (z.comp hSE.extClass (rfl : q + 1 = q + 1)) =
            (Φ 𝒬 q z).comp hSE_G.extClass (rfl : q + 1 = q + 1) := by
        intro z
        change (CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G (z.comp hSE.extClass rfl))
          (Nat.zero_add (q + 1)) = _
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hSE,
          ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ η)
            (CategoryTheory.Abelian.Ext.mapExactFunctor G z) hSE_G.extClass
            (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
        rfl
      have hΦ_post : ∀ z₀ : CategoryTheory.Abelian.Ext.{u} X₁ ℐ q,
          Φ 𝒬 q (z₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q)) =
            (Φ ℐ q z₀).comp (CategoryTheory.Abelian.Ext.mk₀ (G.map π_Y)) (Nat.add_zero q) := by
        intro z₀
        change (CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G
            (z₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q)))
          (Nat.zero_add q) = _
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ η)
            (CategoryTheory.Abelian.Ext.mapExactFunctor G z₀)
            (CategoryTheory.Abelian.Ext.mk₀ (G.map π_Y))
            (Nat.zero_add q) (Nat.add_zero q) (by omega)]
        rfl
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro u hu
        have hu_ι : u.comp (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero (q + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₁ hSE u hu_ι (rfl : q + 1 = q + 1)
        rw [hΦ_conn z] at hu
        obtain ⟨v₂, hv₂⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₂ hSE_G (Φ 𝒬 q z)
            (rfl : q + 1 = q + 1) hu
        obtain ⟨z₀, rfl⟩ := (ih ℐ).2 v₂
        have hz_eq : z = z₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q) :=
          (ih 𝒬).1 ((hΦ_post z₀).trans hv₂).symm
        rw [hz_eq, CategoryTheory.Abelian.Ext.comp_assoc z₀
          (CategoryTheory.Abelian.Ext.mk₀ π_Y) hSE.extClass (Nat.add_zero q)
          (Nat.zero_add 1) (rfl : q + 1 = q + 1),
          hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro w
        have hw_ι : w.comp (CategoryTheory.Abelian.Ext.mk₀ (G.map ι_Y)) (Nat.add_zero (q + 1)) = 0 :=
          hVan ℐ q _
        obtain ⟨x₃, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₂ hSE_G w hw_ι (rfl : q + 1 = q + 1)
        obtain ⟨z, rfl⟩ := (ih 𝒬).2 x₃
        exact ⟨z.comp hSE.extClass rfl, hΦ_conn z⟩

  
  
  
  let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
  let F_fg : ModuleCat.{u, u} R ⥤ AddCommGrpCat.{u} :=
    CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}

  have hR_zsmul : ∀ {M : Type u} [AddCommGroup M] [Module R M] (z : ℤ) (x : M),
      (ULift.up (z : ZMod m) : R) • x = z • x := by
    intro M _ _ z x
    induction z using Int.induction_on with
    | zero =>
      have h0 : (ULift.up ((0 : ℤ) : ZMod m) : R) = 0 := ULift.ext _ _ Int.cast_zero
      rw [h0, zero_smul, zero_zsmul]
    | succ k ih =>
      have hup : (ULift.up (((k : ℤ) + 1 : ℤ) : ZMod m) : R) =
          (ULift.up ((k : ℤ) : ZMod m) : R) + (1 : R) :=
        ULift.ext _ _ ((Int.cast_add (k : ℤ) 1).trans (by rw [Int.cast_one]; rfl))
      rw [hup, add_smul, one_smul, add_zsmul, one_zsmul, ih]
    | pred k ih =>
      have hup : (ULift.up ((- (k : ℤ) - 1 : ℤ) : ZMod m) : R) =
          (ULift.up ((- (k : ℤ) : ℤ) : ZMod m) : R) - (1 : R) :=
        ULift.ext _ _ ((Int.cast_sub (- (k : ℤ)) 1).trans (by rw [Int.cast_one]; rfl))
      rw [hup, sub_smul, one_smul, sub_zsmul, one_zsmul, ih, ← sub_eq_add_neg]

  have hR_smul_eq : ∀ {M : Type u} [AddCommGroup M] [Module R M] (r : R) (x : M),
      r • x = (ZMod.valMinAbs r.down) • x := by
    intro M _ _ r x
    have hr : (ULift.up ((ZMod.valMinAbs r.down : ℤ) : ZMod m) : R) = r :=
      ULift.ext _ _ (ZMod.coe_valMinAbs r.down)
    conv_lhs => rw [← hr]
    exact hR_zsmul (ZMod.valMinAbs r.down) x

  have hR_nsmul_zero : ∀ {M : Type u} [AddCommGroup M] [Module R M] (x : M), m • x = 0 := by
    intro M _ _ x
    have h0 := hR_zsmul (m : ℤ) x
    have hm0 : (ULift.up (((m : ℤ) : ZMod m)) : R) = 0 :=
      ULift.ext _ _ (by rw [Int.cast_natCast, ZMod.natCast_self]; rfl)
    rw [hm0, zero_smul, natCast_zsmul] at h0
    exact h0.symm

  have hR_auto_lin : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R M₁]
      [AddCommGroup M₂] [Module R M₂] (φ : M₁ →+ M₂) (r : R) (x : M₁),
      φ (r • x) = r • φ x := by
    intro M₁ M₂ _ _ _ _ φ r x
    rw [hR_smul_eq r x, map_zsmul, ← hR_smul_eq r (φ x)]

  let liftLin : ∀ {M₁ M₂ : ModuleCat.{u, u} R}, (F_fg.obj M₁ ⟶ F_fg.obj M₂) → (M₁ ⟶ M₂) :=
    fun {M₁ M₂} φ => ModuleCat.ofHom
      { toFun := φ.hom
        map_add' := φ.hom.map_add
        map_smul' := fun r x => @hR_auto_lin ↑M₁ ↑M₂ _ M₁.isModule _ M₂.isModule φ.hom r x }

  have hMod_hom_ext : ∀ {M₁ M₂ : ModuleCat.{u, u} R} {f g : M₁ ⟶ M₂},
      (∀ x : ↑M₁, f.hom x = g.hom x) → f = g := by
    intro M₁ M₂ f g h
    let _ : Module R ↑M₁ := M₁.isModule
    let _ : Module R ↑M₂ := M₂.isModule
    exact ModuleCat.hom_ext (LinearMap.ext h)

  let mkTorsMod : ∀ (A : Type u) [AddCommGroup A], (∀ a : A, m • a = 0) → Module R A := by
    intro A _ hA
    have hZero_of_cast : ∀ (d : ℤ) (a : A), (d : ZMod m) = 0 → d • a = 0 := by
      intro d a hd
      obtain ⟨q, rfl⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd d m).mp hd
      rw [mul_comm, mul_zsmul, natCast_zsmul, hA a, zsmul_zero]
    have hEq_of_cast : ∀ (d₁ d₂ : ℤ) (a : A), (d₁ : ZMod m) = (d₂ : ZMod m) → d₁ • a = d₂ • a := by
      intro d₁ d₂ a hd
      have hsub : ((d₁ - d₂ : ℤ) : ZMod m) = 0 := by rw [Int.cast_sub, hd, sub_self]
      have h1 := hZero_of_cast (d₁ - d₂) a hsub
      rw [sub_zsmul, ← sub_eq_add_neg] at h1
      exact eq_of_sub_eq_zero h1
    exact
      { smul := fun r a => (ZMod.valMinAbs r.down) • a
        one_smul := fun a =>
          (hEq_of_cast _ 1 a (by rw [ZMod.coe_valMinAbs]; exact Int.cast_one.symm)).trans
            (one_zsmul a)
        mul_smul := fun r₁ r₂ a => by
          change (ZMod.valMinAbs (r₁ * r₂).down) • a =
            (ZMod.valMinAbs r₁.down) • ((ZMod.valMinAbs r₂.down) • a)
          rw [← mul_zsmul]
          exact hEq_of_cast _ _ a (by
            rw [ZMod.coe_valMinAbs, Int.cast_mul, ZMod.coe_valMinAbs, ZMod.coe_valMinAbs]; rfl)
        smul_zero := fun r => zsmul_zero _
        smul_add := fun r a b => zsmul_add a b _
        add_smul := fun r₁ r₂ a => by
          change (ZMod.valMinAbs (r₁ + r₂).down) • a =
            (ZMod.valMinAbs r₁.down) • a + (ZMod.valMinAbs r₂.down) • a
          rw [← add_zsmul]
          exact hEq_of_cast _ _ a (by
            rw [ZMod.coe_valMinAbs, Int.cast_add, ZMod.coe_valMinAbs, ZMod.coe_valMinAbs]; rfl)
        zero_smul := fun a =>
          (hEq_of_cast _ 0 a (by rw [ZMod.coe_valMinAbs, Int.cast_zero]; rfl)).trans
            (zero_zsmul a) }

  let sub_m : ∀ (A : AddCommGrpCat.{u}), AddSubgroup A := fun A =>
    AddMonoidHom.range
      { toFun := fun a : A => m • a
        map_zero' := smul_zero m
        map_add' := fun x y => smul_add m x y }
  let L_ab_obj : AddCommGrpCat.{u} → ModuleCat.{u, u} R := fun A =>
    let Q := A ⧸ sub_m A
    let hQ : ∀ q : Q, m • q = 0 := fun q => by
      induction q using QuotientAddGroup.induction_on with
      | H a =>
        change QuotientAddGroup.mk (m • a) = 0
        exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨a, rfl⟩
    letI : Module R Q := mkTorsMod Q hQ
    ModuleCat.of R Q
  let L_ab : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    { obj := L_ab_obj
      map := fun {A₁ A₂} f =>
        liftLin (AddCommGrpCat.ofHom (QuotientAddGroup.map (sub_m A₁) (sub_m A₂) f.hom
          (fun x hx => by
            rcases hx with ⟨a, rfl⟩
            exact ⟨f.hom a, (map_nsmul f.hom m a).symm⟩)))
      map_id := fun A => hMod_hom_ext fun q => by
        induction q using QuotientAddGroup.induction_on with
        | H a => rfl
      map_comp := fun f g => hMod_hom_ext fun q => by
        induction q using QuotientAddGroup.induction_on with
        | H a => rfl }
  let adj_fg : L_ab ⊣ F_fg :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun A M =>
          { toFun := fun φ => AddCommGrpCat.ofHom
              (φ.hom.toAddMonoidHom.comp (QuotientAddGroup.mk' (sub_m A)))
            invFun := fun ψ => liftLin (AddCommGrpCat.ofHom
              (QuotientAddGroup.lift (sub_m A) ψ.hom (fun x hx => by
                rcases hx with ⟨a, rfl⟩
                change ψ.hom (m • a) = 0
                rw [map_nsmul]
                exact @hR_nsmul_zero ↑M _ M.isModule (ψ.hom a))))
            left_inv := fun φ => hMod_hom_ext fun q => by
              induction q using QuotientAddGroup.induction_on with
              | H a => rfl
            right_inv := fun ψ => by
              apply AddCommGrpCat.ext; intro a; rfl }
        homEquiv_naturality_left_symm := fun f ψ => hMod_hom_ext fun q => by
          induction q using QuotientAddGroup.induction_on with
          | H a => rfl
        homEquiv_naturality_right := fun φ g => by
          apply AddCommGrpCat.ext; intro a; rfl }
  have hHasSC : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      X.smallEtaleTopology.HasSheafCompose F_fg :=
    fun X => ⟨fun P hP => @CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf _ _ _ _ _ _
      X.smallEtaleTopology P F_fg (adj_fg.rightAdjoint_preservesLimits) hP⟩
  letI := hHasSC

  let U_sh : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
        CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    fun X => CategoryTheory.sheafCompose X.smallEtaleTopology F_fg

  let eU_hom : ∀ (X : AlgebraicGeometry.Scheme.{u})
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)},
      (ℱ₁ ⟶ ℱ₂) ≃ ((U_sh X).obj ℱ₁ ⟶ (U_sh X).obj ℱ₂) := fun X {ℱ₁ ℱ₂} =>
    { toFun := fun u => (U_sh X).map u
      invFun := fun v =>
        { hom :=
            { app := fun W => liftLin (v.hom.app W)
              naturality := fun {W₁ W₂} f => hMod_hom_ext fun x =>
                congrArg (fun φ => φ.hom x) (v.hom.naturality f) } }
      left_inv := fun u => CategoryTheory.Sheaf.hom_ext
        (CategoryTheory.NatTrans.ext (funext fun W => hMod_hom_ext fun _ => rfl))
      right_inv := fun v => CategoryTheory.Sheaf.hom_ext
        (CategoryTheory.NatTrans.ext (funext fun W => AddCommGrpCat.ext fun _ => rfl)) }

  have hU_faithful : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor.Faithful (U_sh X) :=
    fun X => ⟨fun h => (eU_hom X).injective h⟩
  letI := hU_faithful

  have hAb_nsmul_app : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      (𝒜 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (k : ℕ)
      (W : (X.Etale)ᵒᵖ) (a : ↑(𝒜.obj.obj W)),
      ((k • CategoryTheory.CategoryStruct.id 𝒜).hom.app W).hom a = k • a := by
    intro X 𝒜 k W a
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (((k • CategoryTheory.CategoryStruct.id 𝒜).hom.app W).hom a) + a = k • a + a
      rw [ih]

  have hMod_sheaf_tors : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)),
      m • CategoryTheory.CategoryStruct.id ((U_sh X).obj 𝒢) = 0 := by
    intro X 𝒢
    apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext W
    apply AddCommGrpCat.ext; intro x
    rw [hAb_nsmul_app ((U_sh X).obj 𝒢) m W x]
    exact @hR_nsmul_zero ↑(𝒢.obj.obj W) _ (𝒢.obj.obj W).isModule x

  let L_tors_obj : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒜 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      (m • CategoryTheory.CategoryStruct.id 𝒜 = 0) →
      CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R) := by
    intro X 𝒜 h𝒜
    have hSec : ∀ (W : (X.Etale)ᵒᵖ) (a : ↑(𝒜.obj.obj W)), m • a = 0 := by
      intro W a
      rw [← hAb_nsmul_app 𝒜 m W a, h𝒜]; rfl
    let P_mod : (X.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
      { obj := fun W =>
          letI : Module R ↑(𝒜.obj.obj W) := mkTorsMod _ (hSec W)
          ModuleCat.of R ↑(𝒜.obj.obj W)
        map := fun {W₁ W₂} f =>
          letI : Module R ↑(𝒜.obj.obj W₁) := mkTorsMod _ (hSec W₁)
          letI : Module R ↑(𝒜.obj.obj W₂) := mkTorsMod _ (hSec W₂)
          liftLin (𝒜.obj.map f)
        map_id := fun W => hMod_hom_ext fun a =>
          congrArg (fun φ => φ.hom a) (𝒜.obj.map_id W)
        map_comp := fun {W₁ W₂ W₃} f g => hMod_hom_ext fun a =>
          congrArg (fun φ => φ.hom a) (𝒜.obj.map_comp f g) }
    have hIsSheaf : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology P_mod := by
      intro M_test
      have hEq : P_mod ⋙ CategoryTheory.coyoneda.obj (Opposite.op M_test) ≅
          (P_mod ⋙ F_fg) ⋙ CategoryTheory.coyoneda.obj (Opposite.op (F_fg.obj M_test)) :=
        CategoryTheory.NatIso.ofComponents
          (fun W => Equiv.toIso
            { toFun := fun φ => F_fg.map φ
              invFun := fun ψ => liftLin ψ
              left_inv := fun φ => hMod_hom_ext fun _ => rfl
              right_inv := fun ψ => AddCommGrpCat.ext fun _ => rfl })
          (fun f => by ext φ; apply AddCommGrpCat.ext; intro x; rfl)
      exact CategoryTheory.Presieve.isSheaf_iso X.smallEtaleTopology hEq.symm
        (𝒜.property (F_fg.obj M_test))
    exact ⟨P_mod, hIsSheaf⟩

  
  let eUL_hom : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒜 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (h𝒜 : m • CategoryTheory.CategoryStruct.id 𝒜 = 0)
      (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)),
      (L_tors_obj X 𝒜 h𝒜 ⟶ 𝒢) ≃ (𝒜 ⟶ (U_sh X).obj 𝒢) := fun X 𝒜 h𝒜 𝒢 =>
    { toFun := fun u =>
        { hom :=
            { app := fun W => F_fg.map (u.hom.app W)
              naturality := fun {W₁ W₂} f => AddCommGrpCat.ext fun x =>
                congrArg (fun φ => φ.hom x) (u.hom.naturality f) } }
      invFun := fun v =>
        { hom :=
            { app := fun W => liftLin (v.hom.app W)
              naturality := fun {W₁ W₂} f => hMod_hom_ext fun x =>
                congrArg (fun φ => φ.hom x) (v.hom.naturality f) } }
      left_inv := fun u => CategoryTheory.Sheaf.hom_ext
        (CategoryTheory.NatTrans.ext (funext fun W => hMod_hom_ext fun _ => rfl))
      right_inv := fun v => CategoryTheory.Sheaf.hom_ext
        (CategoryTheory.NatTrans.ext (funext fun W => AddCommGrpCat.ext fun _ => rfl)) }

  
  let Cok_m : ∀ {X : AlgebraicGeometry.Scheme.{u}},
      CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} →
        CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    fun 𝒳 => CategoryTheory.Limits.cokernel (m • CategoryTheory.CategoryStruct.id 𝒳)
  have hCok_m_tors : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      (𝒳 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      m • CategoryTheory.CategoryStruct.id (Cok_m 𝒳) = 0 := by
    intro X 𝒳
    let π_X := CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳)
    have hcond : (m • CategoryTheory.CategoryStruct.id 𝒳) ≫ π_X = 0 :=
      CategoryTheory.Limits.cokernel.condition _
    rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp] at hcond
    rw [← CategoryTheory.cancel_epi π_X, CategoryTheory.Limits.comp_zero,
      CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
    exact hcond

  have heUL_comp : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒜 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (h𝒜 : m • CategoryTheory.CategoryStruct.id 𝒜 = 0)
      {ℳ₁ ℳ₂ : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)}
      (α : L_tors_obj X 𝒜 h𝒜 ⟶ ℳ₁) (β : ℳ₁ ⟶ ℳ₂),
      eUL_hom X 𝒜 h𝒜 ℳ₂ (α ≫ β) = eUL_hom X 𝒜 h𝒜 ℳ₁ α ≫ (U_sh X).map β := by
    intro X 𝒜 h𝒜 ℳ₁ ℳ₂ α β
    exact CategoryTheory.Sheaf.hom_ext
      (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))

  have heUL_id_comp : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒜 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (h𝒜 : m • CategoryTheory.CategoryStruct.id 𝒜 = 0)
      (ℳ : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R))
      (β : L_tors_obj X 𝒜 h𝒜 ⟶ ℳ),
      eUL_hom X 𝒜 h𝒜 _ (CategoryTheory.CategoryStruct.id _) ≫ (U_sh X).map β =
        eUL_hom X 𝒜 h𝒜 ℳ β := by
    intro X 𝒜 h𝒜 ℳ β
    exact CategoryTheory.Sheaf.hom_ext
      (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))

  let L_m_fun : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R) := fun X =>
    { obj := fun 𝒳 => L_tors_obj X (Cok_m 𝒳) (hCok_m_tors 𝒳)
      map := fun {𝒳₁ 𝒳₂} f =>
        (eUL_hom X (Cok_m 𝒳₁) (hCok_m_tors 𝒳₁) (L_tors_obj X (Cok_m 𝒳₂) (hCok_m_tors 𝒳₂))).symm
          ((CategoryTheory.Limits.cokernel.desc (m • CategoryTheory.CategoryStruct.id 𝒳₁)
            (f ≫ CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳₂))
            (by
              have hcond : (m • CategoryTheory.CategoryStruct.id 𝒳₂) ≫
                  CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳₂) = 0 :=
                CategoryTheory.Limits.cokernel.condition _
              calc (m • CategoryTheory.CategoryStruct.id 𝒳₁) ≫
                    (f ≫ CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳₂))
                  = f ≫ ((m • CategoryTheory.CategoryStruct.id 𝒳₂) ≫
                      CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳₂)) := by
                    rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
                      CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
                      CategoryTheory.Preadditive.comp_nsmul]
                _ = 0 := by rw [hcond, CategoryTheory.Limits.comp_zero])) ≫
            (eUL_hom X (Cok_m 𝒳₂) (hCok_m_tors 𝒳₂) _ (CategoryTheory.CategoryStruct.id _)))
      map_id := fun 𝒳 =>
        (eUL_hom X (Cok_m 𝒳) (hCok_m_tors 𝒳) _).injective (by
          rw [Equiv.apply_symm_apply]
          apply (CategoryTheory.cancel_epi
            (CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳))).mp
          rw [CategoryTheory.Limits.cokernel.π_desc_assoc, CategoryTheory.Category.id_comp])
      map_comp := fun {𝒳₁ 𝒳₂ 𝒳₃} f g =>
        (eUL_hom X (Cok_m 𝒳₁) (hCok_m_tors 𝒳₁) _).injective (by
          rw [Equiv.apply_symm_apply, heUL_comp X (Cok_m 𝒳₁) (hCok_m_tors 𝒳₁),
            Equiv.apply_symm_apply]
          apply (CategoryTheory.cancel_epi
            (CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳₁))).mp
          simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc_assoc]
          rw [heUL_id_comp X (Cok_m 𝒳₂) (hCok_m_tors 𝒳₂), Equiv.apply_symm_apply,
            CategoryTheory.Limits.cokernel.π_desc_assoc, CategoryTheory.Category.assoc]) }

  let eLm_hom : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒳 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)),
      ((L_m_fun X).obj 𝒳 ⟶ ℱ) ≃ (𝒳 ⟶ (U_sh X).obj ℱ) := fun X 𝒳 ℱ =>
    { toFun := fun φ =>
        CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳) ≫
          eUL_hom X (Cok_m 𝒳) (hCok_m_tors 𝒳) ℱ φ
      invFun := fun ψ => (eUL_hom X (Cok_m 𝒳) (hCok_m_tors 𝒳) ℱ).symm
        (CategoryTheory.Limits.cokernel.desc (m • CategoryTheory.CategoryStruct.id 𝒳) ψ (by
          calc (m • CategoryTheory.CategoryStruct.id 𝒳) ≫ ψ
              = ψ ≫ (m • CategoryTheory.CategoryStruct.id ((U_sh X).obj ℱ)) := by
                rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
                  CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
            _ = 0 := by rw [hMod_sheaf_tors X ℱ, CategoryTheory.Limits.comp_zero]))
      left_inv := fun φ => (eUL_hom X (Cok_m 𝒳) (hCok_m_tors 𝒳) ℱ).injective (by
        rw [Equiv.apply_symm_apply]
        apply (CategoryTheory.cancel_epi
          (CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳))).mp
        exact CategoryTheory.Limits.cokernel.π_desc _ _ _)
      right_inv := fun ψ => by
        dsimp
        rw [Equiv.apply_symm_apply]
        exact CategoryTheory.Limits.cokernel.π_desc _ _ _ }

  let adj_Lm : ∀ (X : AlgebraicGeometry.Scheme.{u}), L_m_fun X ⊣ U_sh X := fun X =>
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun 𝒳 ℱ => eLm_hom X 𝒳 ℱ
        homEquiv_naturality_left_symm := fun {𝒳₁ 𝒳₂ ℱ} f ψ =>
          (eUL_hom X (Cok_m 𝒳₁) (hCok_m_tors 𝒳₁) ℱ).injective (by
            dsimp [eLm_hom, L_m_fun]
            rw [Equiv.apply_symm_apply, heUL_comp X (Cok_m 𝒳₁) (hCok_m_tors 𝒳₁),
              Equiv.apply_symm_apply]
            apply (CategoryTheory.cancel_epi
              (CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id 𝒳₁))).mp
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc_assoc,
              CategoryTheory.Limits.cokernel.π_desc]
            rw [heUL_id_comp X (Cok_m 𝒳₂) (hCok_m_tors 𝒳₂), Equiv.apply_symm_apply,
              CategoryTheory.Limits.cokernel.π_desc])
        homEquiv_naturality_right := fun {𝒳 ℱ₁ ℱ₂} φ g => by
          dsimp [eLm_hom]
          rw [heUL_comp X (Cok_m 𝒳) (hCok_m_tors 𝒳), CategoryTheory.Category.assoc] }

  have hU_lim : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.PreservesFiniteLimits (U_sh X) :=
    fun X => (CategoryTheory.Adjunction.rightAdjoint_preservesLimits.{0, 0} (adj_Lm X)).preservesFiniteLimits
  have hU_add : ∀ (X : AlgebraicGeometry.Scheme.{u}), (U_sh X).Additive :=
    fun X => ⟨fun {_ _} {_ _} => CategoryTheory.Sheaf.hom_ext
      (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))⟩
  have hU_colim : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.PreservesFiniteColimits (U_sh X) := by
    intro X
    letI := hU_add X
    rw [CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
    intro SC hSE
    have hEx : (SC.map (U_sh X)).Exact :=
      ((CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono
        (U_sh X)).mp (hU_lim X) SC hSE).1
    have hEpi_g : CategoryTheory.Epi ((U_sh X).map SC.g) := by
      haveI : CategoryTheory.Epi SC.g := hSE.epi_g
      have hLoc : CategoryTheory.Sheaf.IsLocallySurjective SC.g :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (ModuleCat.{u, u} R) SC.g).mpr inferInstance
      apply (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u}
        ((U_sh X).map SC.g)).mp
      refine ⟨fun {U} s => ?_⟩
      have hs := hLoc.imageSieve_mem s
      have hSieveEq : CategoryTheory.Presheaf.imageSieve ((U_sh X).map SC.g).hom s =
          CategoryTheory.Presheaf.imageSieve SC.g.hom s := by
        ext V f; rfl
      rwa [hSieveEq]
    exact ⟨hEx, hEpi_g⟩

  
  
  
  have hAffLift : ∀ {A A_Z B_Z : Type u} [CommRing A] [CommRing A_Z] [CommRing B_Z]
      (π : A →+* A_Z), Function.Surjective π →
      ∀ (f_Z : A_Z →+* B_Z), f_Z.Etale →
        ∃ (B_A : Type u) (_ : CommRing B_A) (f_A : A →+* B_A) (π_B : B_A →+* B_Z),
          f_A.Etale ∧ Function.Surjective π_B ∧ π_B.comp f_A = f_Z.comp π ∧
          CategoryTheory.IsPushout (CommRingCat.ofHom π) (CommRingCat.ofHom f_A)
            (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) := by
    intro A A_Z B_Z _ _ _ π hπ f_Z hf_Z
    classical
    letI : Algebra A_Z B_Z := f_Z.toAlgebra
    have hEt_BZ : Algebra.Etale A_Z B_Z := hf_Z
    have hStd : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt_BZ
    obtain ⟨ι, σ, hFin_σ, hFin_ι, P, hdim_P⟩ := hStd.out
    haveI : Finite ι := hFin_ι
    haveI : Finite σ := hFin_σ
    letI : Fintype σ := Fintype.ofFinite σ
    have hmap_surj : Function.Surjective
        (MvPolynomial.map π : MvPolynomial ι A →+* MvPolynomial ι A_Z) :=
      MvPolynomial.map_surjective π hπ
    let g_tilde : σ → MvPolynomial ι A := fun r => Classical.choose (hmap_surj (P.relation r))
    have hg_tilde : ∀ r : σ, MvPolynomial.map π (g_tilde r) = P.relation r :=
      fun r => Classical.choose_spec (hmap_surj (P.relation r))
    let I₀ : Ideal (MvPolynomial ι A) := Ideal.span (Set.range g_tilde)
    let C₀ : Type u := MvPolynomial ι A ⧸ I₀
    let q₀ : MvPolynomial ι A →ₐ[A] C₀ := Ideal.Quotient.mkₐ A I₀
    have hq₀_surj : Function.Surjective q₀ := Ideal.Quotient.mk_surjective
    let v₀ : ι → C₀ := fun i => q₀ (MvPolynomial.X i)
    have haeval_v₀ : MvPolynomial.aeval v₀ = q₀ := by
      ext i; exact MvPolynomial.aeval_X v₀ i
    have hsurj_v₀ : Function.Surjective (MvPolynomial.aeval v₀ : MvPolynomial ι A →ₐ[A] C₀) := by
      rw [haeval_v₀]; exact hq₀_surj
    let G₀ : Algebra.Generators A C₀ ι := Algebra.Generators.ofSurjective v₀ hsurj_v₀
    have hker_G₀ : Ideal.span (Set.range g_tilde) = G₀.ker := by
      change I₀ = RingHom.ker (algebraMap G₀.Ring C₀)
      have halg : (algebraMap G₀.Ring C₀) = q₀.toRingHom := by
        apply RingHom.ext; intro q
        rw [Algebra.Generators.algebraMap_apply]
        change (MvPolynomial.aeval v₀) q = q₀ q
        rw [haeval_v₀]
      rw [halg]
      exact (Ideal.mk_ker (I := I₀)).symm
    let Pres₀ : Algebra.Presentation A C₀ ι σ :=
      { G₀ with
        relation := g_tilde
        span_range_relation_eq_ker := hker_G₀ }
    let P₀ : Algebra.PreSubmersivePresentation A C₀ ι σ :=
      { Pres₀ with
        map := P.map
        map_inj := P.map_inj }
    let J₀ : C₀ := P₀.jacobian
    let B_A : Type u := Localization.Away J₀
    let f_A : A →+* B_A := algebraMap A B_A
    let Q_loc : Algebra.PreSubmersivePresentation C₀ B_A Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_A J₀
    let P_tot : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ ι) (Unit ⊕ σ) :=
      Q_loc.comp P₀
    have hdim_P₀ : P₀.dimension = 0 := hdim_P
    have hdim_Q : Q_loc.dimension = 0 := Nat.sub_self _
    have hdim_tot : P_tot.dimension = 0 := by
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension,
        hdim_Q, hdim_P₀, add_zero]
    have hJ₀_unit : IsUnit (algebraMap C₀ B_A J₀) :=
      IsLocalization.Away.algebraMap_isUnit J₀
    have hQ_jac : Q_loc.jacobian = algebraMap C₀ B_A J₀ :=
      Algebra.PreSubmersivePresentation.localizationAway_jacobian (S := B_A) J₀
    have htot_jac_unit : IsUnit P_tot.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.smul_def, hQ_jac]
      exact hJ₀_unit.mul hJ₀_unit
    let S_tot : Algebra.SubmersivePresentation A B_A (Unit ⊕ ι) (Unit ⊕ σ) :=
      { P_tot with jacobian_isUnit := htot_jac_unit }
    have hStd_BA : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
      S_tot.isStandardSmoothOfRelativeDimension hdim_tot
    have hf_A_et : f_A.Etale :=
      RingHom.etale_algebraMap.mpr
        (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hStd_BA)

    let Φ : MvPolynomial ι A →+* B_Z :=
      (MvPolynomial.aeval P.val).toRingHom.comp (MvPolynomial.map π)
    have hI₀_le : I₀ ≤ RingHom.ker Φ := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨r, rfl⟩
      change (MvPolynomial.aeval P.val) (MvPolynomial.map π (g_tilde r)) = 0
      rw [hg_tilde r, ← Algebra.Generators.algebraMap_apply P.toGenerators]
      have hmem : P.relation r ∈ Ideal.span (Set.range P.relation) :=
        Ideal.subset_span ⟨r, rfl⟩
      rw [P.span_range_relation_eq_ker] at hmem
      exact RingHom.mem_ker.mp hmem
    let ψ₀ : C₀ →+* B_Z := Ideal.Quotient.lift I₀ Φ hI₀_le
    have hψ₀_mk : ∀ q : MvPolynomial ι A, ψ₀ (q₀ q) = Φ q := fun _ => rfl
    have hψ₀_alg : ∀ a : A, ψ₀ (algebraMap A C₀ a) = f_Z (π a) := by
      intro a
      change ψ₀ (q₀ (MvPolynomial.C a)) = f_Z (π a)
      rw [hψ₀_mk]
      dsimp [Φ]
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      rfl
    have hψ₀_aeval : ∀ q : MvPolynomial ι A,
        ψ₀ ((MvPolynomial.aeval P₀.val) q) = (MvPolynomial.aeval P.val) (MvPolynomial.map π q) := by
      intro q
      change ψ₀ ((MvPolynomial.aeval v₀) q) = Φ q
      rw [haeval_v₀]
      exact hψ₀_mk q
    have hψ₀_jac : ψ₀ J₀ = P.jacobian := by
      dsimp [J₀]
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.Generators.algebraMap_apply P₀.toGenerators,
        Algebra.Generators.algebraMap_apply P.toGenerators,
        hψ₀_aeval, RingHom.map_det (MvPolynomial.map π)]
      apply congrArg (MvPolynomial.aeval P.val)
      apply congrArg Matrix.det
      apply Matrix.ext; intro i j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      change (MvPolynomial.map π) ((MvPolynomial.pderiv (P.map i)) (g_tilde j)) =
        (MvPolynomial.pderiv (P.map i)) (P.relation j)
      rw [← hg_tilde j, MvPolynomial.pderiv_map]
    have hψ₀_J_unit : IsUnit (ψ₀ J₀) := by
      rw [hψ₀_jac]
      exact P.jacobian_isUnit
    let π_B : B_A →+* B_Z := IsLocalization.Away.lift J₀ hψ₀_J_unit
    have hπ_B_comp_C₀ : π_B.comp (algebraMap C₀ B_A) = ψ₀ :=
      RingHom.ext fun c => IsLocalization.Away.lift_eq J₀ hψ₀_J_unit c
    have hπ_B_comm : π_B.comp f_A = f_Z.comp π := by
      apply RingHom.ext; intro a
      change π_B (algebraMap C₀ B_A (algebraMap A C₀ a)) = f_Z (π a)
      rw [← RingHom.comp_apply, hπ_B_comp_C₀, hψ₀_alg]
    have hπ_B_surj : Function.Surjective π_B := by
      intro b
      obtain ⟨p_Z, rfl⟩ := P.aeval_val_surjective b
      obtain ⟨p_A, hp_A⟩ := hmap_surj p_Z
      refine ⟨algebraMap C₀ B_A (q₀ p_A), ?_⟩
      change (π_B.comp (algebraMap C₀ B_A)) (q₀ p_A) = (MvPolynomial.aeval P.val) p_Z
      rw [hπ_B_comp_C₀, hψ₀_mk]
      dsimp [Φ]
      rw [hp_A]

    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom π) (CommRingCat.ofHom f_A)
        (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) := by
      have hw : CommRingCat.ofHom π ≫ CommRingCat.ofHom f_Z =
          CommRingCat.ofHom f_A ≫ CommRingCat.ofHom π_B := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hπ_B_comm]
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.isColimitAux'
          (CategoryTheory.Limits.PushoutCocone.mk (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) hw)
          fun s => ?_)
      let α : A_Z →+* s.pt := s.inl.hom
      let β : B_A →+* s.pt := s.inr.hom
      have hαβ : ∀ a : A, α (π a) = β (f_A a) :=
        fun a => congrArg (fun φ => φ.hom a) s.condition
      let β₀ : C₀ →+* s.pt := β.comp (algebraMap C₀ B_A)
      let v_T : ι → s.pt := fun i => β₀ (q₀ (MvPolynomial.X i))
      let γ_poly : MvPolynomial ι A_Z →+* s.pt := MvPolynomial.eval₂Hom α v_T
      have hγ_map : γ_poly.comp (MvPolynomial.map π) = β₀.comp q₀.toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro a
          rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C]
          change (MvPolynomial.eval₂Hom α v_T) (MvPolynomial.C (π a)) =
            β (algebraMap C₀ B_A (q₀ (MvPolynomial.C a)))
          rw [MvPolynomial.eval₂Hom_C, hαβ]
          change β (algebraMap A B_A a) = β (algebraMap C₀ B_A (q₀ (MvPolynomial.C a)))
          rw [IsScalarTower.algebraMap_apply A C₀ B_A a]
          rfl
        · intro i
          rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_X]
          exact MvPolynomial.eval₂Hom_X' α v_T i
      let φ_Z_poly : MvPolynomial ι A_Z →+* B_Z := (MvPolynomial.aeval P.val).toRingHom
      have hKZ_le : P.ker ≤ RingHom.ker γ_poly := by
        rw [← P.span_range_relation_eq_ker]
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨r, rfl⟩
        change γ_poly (P.relation r) = 0
        rw [← hg_tilde r, ← RingHom.comp_apply, hγ_map, RingHom.comp_apply]
        have hq0 : q₀ (g_tilde r) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨r, rfl⟩)
        change β₀ (q₀ (g_tilde r)) = 0
        rw [hq0, map_zero]
      have hker_γ : ∀ q : MvPolynomial ι A_Z, φ_Z_poly q = 0 → γ_poly q = 0 := by
        intro q hq
        apply RingHom.mem_ker.mp
        apply hKZ_le
        change (algebraMap P.toGenerators.Ring B_Z) q = 0
        rw [Algebra.Generators.algebraMap_apply P.toGenerators]
        exact hq
      have hφ_surj : ∀ b : B_Z, ∃ q : MvPolynomial ι A_Z, φ_Z_poly q = b :=
        fun b => P.aeval_val_surjective b
      let sec_Z : B_Z → MvPolynomial ι A_Z := fun b => Classical.choose (hφ_surj b)
      have hsec_Z : ∀ b : B_Z, φ_Z_poly (sec_Z b) = b :=
        fun b => Classical.choose_spec (hφ_surj b)
      have hγ_sec : ∀ q : MvPolynomial ι A_Z, γ_poly (sec_Z (φ_Z_poly q)) = γ_poly q := by
        intro q
        apply sub_eq_zero.mp
        rw [← map_sub]
        apply hker_γ
        rw [map_sub, hsec_Z, sub_self]
      let γ : B_Z →+* s.pt :=
        { toFun := fun b => γ_poly (sec_Z b)
          map_one' := by
            change γ_poly (sec_Z 1) = 1
            rw [← map_one φ_Z_poly, hγ_sec, map_one]
          map_mul' := fun b₁ b₂ => by
            change γ_poly (sec_Z (b₁ * b₂)) = γ_poly (sec_Z b₁) * γ_poly (sec_Z b₂)
            conv_lhs => rw [← hsec_Z b₁, ← hsec_Z b₂, ← map_mul φ_Z_poly]
            rw [hγ_sec, map_mul]
          map_zero' := by
            change γ_poly (sec_Z 0) = 0
            rw [← map_zero φ_Z_poly, hγ_sec, map_zero]
          map_add' := fun b₁ b₂ => by
            change γ_poly (sec_Z (b₁ + b₂)) = γ_poly (sec_Z b₁) + γ_poly (sec_Z b₂)
            conv_lhs => rw [← hsec_Z b₁, ← hsec_Z b₂, ← map_add φ_Z_poly]
            rw [hγ_sec, map_add] }
      have hγ_aeval : ∀ q : MvPolynomial ι A_Z, γ ((MvPolynomial.aeval P.val) q) = γ_poly q :=
        fun q => hγ_sec q
      have hγ_fZ : CommRingCat.ofHom f_Z ≫ CommRingCat.ofHom γ = s.inl := by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro a_z
        change γ (algebraMap A_Z B_Z a_z) = α a_z
        rw [← MvPolynomial.aeval_C P.val a_z, hγ_aeval]
        exact MvPolynomial.eval₂Hom_C α v_T a_z
      have hγ_πB : CommRingCat.ofHom π_B ≫ CommRingCat.ofHom γ = s.inr := by
        apply CommRingCat.hom_ext
        have hC₀_eq : (γ.comp π_B).comp (algebraMap C₀ B_A) = β.comp (algebraMap C₀ B_A) := by
          rw [RingHom.comp_assoc, hπ_B_comp_C₀]
          apply RingHom.ext; intro c
          obtain ⟨q, rfl⟩ := hq₀_surj c
          change γ (ψ₀ (q₀ q)) = β₀ (q₀ q)
          rw [hψ₀_mk]
          dsimp [Φ]
          rw [hγ_aeval]
          exact congrArg (fun φ => φ q) hγ_map
        exact IsLocalization.ringHom_ext (Submonoid.powers J₀) hC₀_eq
      refine ⟨CommRingCat.ofHom γ, hγ_fZ, hγ_πB, ?_⟩
      intro m_hom _ hm_inr
      apply CommRingCat.hom_ext; apply RingHom.ext; intro b
      obtain ⟨b_a, rfl⟩ := hπ_B_surj b
      have h1 := congrArg (fun φ => φ.hom b_a) hm_inr
      have h2 := congrArg (fun φ => φ.hom b_a) hγ_πB
      exact h1.trans h2.symm
    exact ⟨B_A, inferInstance, f_A, π_B, hf_A_et, hπ_B_surj, hπ_B_comm, hPush⟩

  
  
  
  let B_is : S.Etale ⥤ Z_s.Etale := weilEtaleSitePullback i_s
  let J_S := S.smallEtaleTopology
  let J_Z := Z_s.smallEtaleTopology
  let pf_ab := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_is
    AddCommGrpCat.{u} _ J_S J_Z hc_is
  haveI : pf_ab.IsRightAdjoint := hr_is
  let pb_ab := @CategoryTheory.Functor.sheafPullback _ _ _ _ B_is
    AddCommGrpCat.{u} _ J_S J_Z hc_is hr_is
  let adj_ab := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B_is
    AddCommGrpCat.{u} _ J_S J_Z hc_is hr_is
  haveI : pb_ab.Additive := hpb_add
  haveI : pb_ab.PreservesMonomorphisms := hpb_mono

  have hpb_tors : ∀ (𝒢 : CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R)),
      m • CategoryTheory.CategoryStruct.id (pb_ab.obj ((U_sh S).obj 𝒢)) = 0 := by
    intro 𝒢
    rw [← pb_ab.map_id, ← pb_ab.map_nsmul, hMod_sheaf_tors S 𝒢, pb_ab.map_zero]

  let P_pull_R : CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R) ⥤
      CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R) :=
    { obj := fun 𝒢 => L_tors_obj Z_s (pb_ab.obj ((U_sh S).obj 𝒢)) (hpb_tors 𝒢)
      map := fun {𝒢₁ 𝒢₂} u =>
        { hom :=
            { app := fun W => liftLin ((pb_ab.map ((U_sh S).map u)).hom.app W)
              naturality := fun {W₁ W₂} f => hMod_hom_ext fun x =>
                congrArg (fun φ => φ.hom x) ((pb_ab.map ((U_sh S).map u)).hom.naturality f) } }
      map_id := fun 𝒢 => CategoryTheory.Sheaf.hom_ext
        (CategoryTheory.NatTrans.ext (funext fun W => hMod_hom_ext fun x => by
          change ((pb_ab.map ((U_sh S).map (CategoryTheory.CategoryStruct.id 𝒢))).hom.app W).hom x = x
          rw [(U_sh S).map_id, pb_ab.map_id]; rfl))
      map_comp := fun {𝒢₁ 𝒢₂ 𝒢₃} u v => CategoryTheory.Sheaf.hom_ext
        (CategoryTheory.NatTrans.ext (funext fun W => hMod_hom_ext fun x => by
          change ((pb_ab.map ((U_sh S).map (u ≫ v))).hom.app W).hom x = _
          rw [(U_sh S).map_comp, pb_ab.map_comp]; rfl)) }

  let ePushU_hom : ∀ (𝒢 : CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R))
      (ℱ : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R)),
      ((U_sh S).obj 𝒢 ⟶ pf_ab.obj ((U_sh Z_s).obj ℱ)) ≃ (𝒢 ⟶ P_push.obj ℱ) :=
    fun 𝒢 ℱ =>
      { toFun := fun v =>
          { hom :=
              { app := fun W => liftLin (v.hom.app W)
                naturality := fun {W₁ W₂} f => hMod_hom_ext fun x =>
                  congrArg (fun φ => φ.hom x) (v.hom.naturality f) } }
        invFun := fun u =>
          { hom :=
              { app := fun W => F_fg.map (u.hom.app W)
                naturality := fun {W₁ W₂} f => AddCommGrpCat.ext fun x =>
                  congrArg (fun φ => φ.hom x) (u.hom.naturality f) } }
        left_inv := fun v => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun W => AddCommGrpCat.ext fun _ => rfl))
        right_inv := fun u => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun W => hMod_hom_ext fun _ => rfl)) }

  let adj_R : P_pull_R ⊣ P_push :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun 𝒢 ℱ =>
          (eUL_hom Z_s (pb_ab.obj ((U_sh S).obj 𝒢)) (hpb_tors 𝒢) ℱ).trans
            ((adj_ab.homEquiv ((U_sh S).obj 𝒢) ((U_sh Z_s).obj ℱ)).trans (ePushU_hom 𝒢 ℱ))
        homEquiv_naturality_left_symm := fun {𝒢₁ 𝒢₂ ℱ} f g =>
          (eUL_hom Z_s (pb_ab.obj ((U_sh S).obj 𝒢₁)) (hpb_tors 𝒢₁) ℱ).injective (by
            dsimp
            rw [Equiv.apply_symm_apply]
            have hcomp : ∀ (β : P_pull_R.obj 𝒢₂ ⟶ ℱ),
                eUL_hom Z_s (pb_ab.obj ((U_sh S).obj 𝒢₁)) (hpb_tors 𝒢₁) ℱ (P_pull_R.map f ≫ β) =
                  pb_ab.map ((U_sh S).map f) ≫
                    eUL_hom Z_s (pb_ab.obj ((U_sh S).obj 𝒢₂)) (hpb_tors 𝒢₂) ℱ β :=
              fun _ => CategoryTheory.Sheaf.hom_ext
                (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
            have hpush : (ePushU_hom 𝒢₁ ℱ).symm (f ≫ g) =
                (U_sh S).map f ≫ (ePushU_hom 𝒢₂ ℱ).symm g :=
              CategoryTheory.Sheaf.hom_ext
                (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
            rw [hcomp, Equiv.apply_symm_apply, hpush]
            exact adj_ab.homEquiv_naturality_left_symm ((U_sh S).map f) ((ePushU_hom 𝒢₂ ℱ).symm g))
        homEquiv_naturality_right := fun {𝒢 ℱ₁ ℱ₂} f g =>
          (ePushU_hom 𝒢 ℱ₂).symm.injective (by
            dsimp
            rw [Equiv.symm_apply_apply]
            have hpush : ∀ (α : 𝒢 ⟶ P_push.obj ℱ₁),
                (ePushU_hom 𝒢 ℱ₂).symm (α ≫ P_push.map g) =
                  (ePushU_hom 𝒢 ℱ₁).symm α ≫ pf_ab.map ((U_sh Z_s).map g) :=
              fun _ => CategoryTheory.Sheaf.hom_ext
                (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
            rw [hpush, Equiv.symm_apply_apply,
              heUL_comp Z_s (pb_ab.obj ((U_sh S).obj 𝒢)) (hpb_tors 𝒢)]
            exact adj_ab.homEquiv_naturality_right _ ((U_sh Z_s).map g)) }

  have hP_lim : CategoryTheory.Limits.PreservesFiniteLimits P_push :=
    (CategoryTheory.Adjunction.rightAdjoint_preservesLimits.{0, 0} adj_R).preservesFiniteLimits
  have hP_add : P_push.Additive :=
    ⟨fun {_ _} {_ _} => CategoryTheory.Sheaf.hom_ext
      (CategoryTheory.NatTrans.ext (funext fun _ => hMod_hom_ext fun _ => rfl))⟩
  haveI : (U_sh Z_s).ReflectsMonomorphisms :=
    CategoryTheory.Functor.reflectsMonomorphisms_of_faithful (U_sh Z_s)
  haveI : P_pull_R.PreservesMonomorphisms :=
    ⟨fun {𝒢₁ 𝒢₂} u hu => by
      let iso_pb : ∀ 𝒢 : CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R),
          (U_sh Z_s).obj (P_pull_R.obj 𝒢) ≅ pb_ab.obj ((U_sh S).obj 𝒢) := fun 𝒢 =>
        { hom := { hom := { app := fun _ => 𝟙 _ } }
          inv := { hom := { app := fun _ => 𝟙 _ } } }
      have hfac : (U_sh Z_s).map (P_pull_R.map u) =
          (iso_pb 𝒢₁).hom ≫ pb_ab.map ((U_sh S).map u) ≫ (iso_pb 𝒢₂).inv :=
        CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
      haveI : CategoryTheory.Mono ((U_sh S).map u) := ⟨fun {𝒳} g₁ g₂ hg => by
        apply ((adj_Lm S).homEquiv 𝒳 𝒢₁).symm.injective
        apply (CategoryTheory.cancel_mono u).mp
        apply ((adj_Lm S).homEquiv 𝒳 𝒢₂).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right (adj_Lm S),
          CategoryTheory.Adjunction.homEquiv_naturality_right (adj_Lm S),
          Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        exact hg⟩
      haveI : CategoryTheory.Mono (pb_ab.map ((U_sh S).map u)) := inferInstance
      haveI : CategoryTheory.IsIso (iso_pb 𝒢₁).hom := CategoryTheory.Iso.isIso_hom (iso_pb 𝒢₁)
      haveI : CategoryTheory.IsIso (iso_pb 𝒢₂).inv := CategoryTheory.Iso.isIso_inv (iso_pb 𝒢₂)
      haveI : CategoryTheory.Mono
          ((iso_pb 𝒢₁).hom ≫ pb_ab.map ((U_sh S).map u) ≫ (iso_pb 𝒢₂).inv) :=
        CategoryTheory.mono_comp (iso_pb 𝒢₁).hom (pb_ab.map ((U_sh S).map u) ≫ (iso_pb 𝒢₂).inv)
      have hMono_map : CategoryTheory.Mono ((U_sh Z_s).map (P_pull_R.map u)) := by rwa [hfac]
      exact CategoryTheory.Functor.mono_of_mono_map (U_sh Z_s) hMono_map⟩

  have hVan_push : ∀ (ℐ : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R))
      [CategoryTheory.Injective ℐ] (q : ℕ)
      (ω : CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit S m) (P_push.obj ℐ) (q + 1)),
