      rw [weil_etale_torsion_pullback_functoriality.2.1 ℓ i pid₁ hpid₁] at hcomp₁
      rw [weil_etale_torsion_pullback_functoriality.2.1 ℓ i pid₂ hpid₂] at hcomp₂
      have hL : Function.LeftInverse q p := fun x => by
        simpa using DFunLike.congr_fun hcomp₂.symm x
      have hR : Function.RightInverse q p := fun y => by
