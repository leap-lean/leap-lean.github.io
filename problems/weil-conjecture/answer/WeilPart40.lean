      have hres₀_i₁ : res₀ i₁ (C.map θ₀₁ c₀) = 0 := by
        rw [(hmap_res θ₀₁ c₀).1, hd₀_0]
      have hres₁_i₁ : res₁ i₁ (C.map θ₀₁ c₀) = 0 := by
