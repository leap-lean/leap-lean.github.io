    have hTor_I₀ : M • CategoryTheory.CategoryStruct.id I₀ = 0 := by
      apply (CategoryTheory.cancel_epi q_v).mp
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
        ← CategoryTheory.Category.id_comp q_v, ← CategoryTheory.Preadditive.nsmul_comp,
        hTor_A₀, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    have hR₀_2 : Subsingleton (CategoryTheory.Abelian.Ext.{u} U₀ R₀ 2) := hCd1_𝒜 R₀ hTor_R₀
    have hI₀_2 : Subsingleton (CategoryTheory.Abelian.Ext.{u} U₀ I₀ 2) := hCd1_𝒜 I₀ hTor_I₀
    have hI₀_1 : Subsingleton (CategoryTheory.Abelian.Ext.{u} U₀ I₀ 1) := by
