      exact E₁_tot.symm.bijective.comp h1
  have hBij_η_T₂ := hIntertwine h hCont hAdj T₁ hT₁ T₂ hT₂ T₂
  
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Z₂
  let T₂_id : Z₂.Etale := weilEtaleIdTerminal.{u} Z₂
  let hT₂_id : CategoryTheory.Limits.IsTerminal T₂_id := weilEtaleIdTerminalIsTerminal.{u} Z₂
  let e₂ : T₂ ≅ T₂_id := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT₂ hT₂_id
  let φ₂ : (Fgt₂.obj T₂).left ≅ Z₂ := (Fgt₂ ⋙ CategoryTheory.Over.forget Z₂).mapIso e₂
  let g₂_hom : (Fgt₂.obj T₂).left ⟶ Z₂ := (Fgt₂.obj T₂).hom
