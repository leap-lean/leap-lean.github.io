          rw [hΨ_tmul, mul_comm]

      obtain ⟨f_Ψ, hfΨ_inj, hfΨ_tmul, hfΨ_zero, hfΨ_one, hfΨ_add, hfΨ_mul, hfΨ_smul, hfΨ_tw⟩ :=
        hΨ_pkg

      let _ : Algebra L_r Ω := ι_r.toAlgebra
      have hE'_basis :
          ∃ (E' : IntermediateField L_r Ω) (b_E : Module.Basis (Fin s) L_r ↥E'),
