    have hs_fst : s_bar ≫ pr_D = f_ext ≫ s := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hs_snd : s_bar ≫ D_bar_ov.hom = 𝟙 _ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback (s_bar ≫ D_bar_ov.hom) f_ext f_ext (s ≫ D₀.hom) := by
