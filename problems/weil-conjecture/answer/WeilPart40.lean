              dsimp only [g_quad]
              rw [Fin.lastCases_castSucc]
              rw [← h_iu_lt ⟨μ.1, by omega⟩ hμ_lt, hθ_symm_succ]
            rw [heq, MvPolynomial.aeval_X]
            dsimp only [ψ_fn, iu_lt]
            have hlt2 : 2 * μ.1 < 2 * j.1 := by omega
            have hmod2 : (2 * μ.1) % 2 = 0 := by omega
            simp [hlt2, hmod2]
        exact hker hx
      have h_istar_mem : MvPolynomial.X i_star - MvPolynomial.rename emb_fn P₀ ∈ J_j := by
        have hS_lt_mem : (∑ k : Fin (m + 1),
            if hk_lt : k.1 < j.1 then
              MvPolynomial.X (iu_lt k hk_lt) * MvPolynomial.X (iv_lt k hk_lt) else 0) ∈ J_j := by
          refine Ideal.sum_mem J_j fun k _ => ?_
          split_ifs with hk_lt
          · exact J_j.mul_mem_right _ (h_lin_mem ⟨k.1, hk_lt⟩)
          · exact J_j.zero_mem
        have hdiff : MvPolynomial.X i_star - MvPolynomial.rename emb_fn P₀ =
            θ.symm q_A - (∑ k : Fin (m + 1),
