  have hFreeMap : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
      freeEquiv (weilEtaleLocalFreeMap S m u) =
        freeEquiv (𝟙 (weilEtaleLocalFreeSheaf S m U₂)) ≫
          (weilEtaleLocalFreeSheaf S m U₂).obj.map (Opposite.op u) := by
    intro U₁ U₂ u
    exact freeEquiv.apply_symm_apply _
  have hFreeMapComp : ∀ {U₁ U₂ : S.Etale} {F : CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R)}
      (u : U₁ ⟶ U₂) (φ : weilEtaleLocalFreeSheaf S m U₂ ⟶ F),
      freeEquiv (weilEtaleLocalFreeMap S m u ≫ φ) =
        freeEquiv φ ≫ F.obj.map (Opposite.op u) := by
    intro U₁ U₂ F u φ
    rw [hFreeComp, hFreeMap, CategoryTheory.Category.assoc, φ.hom.naturality (Opposite.op u),
      ← CategoryTheory.Category.assoc, ← hFreeComp, CategoryTheory.Category.id_comp]
  have hConj1 : ∀ {U₁ U₂ U₃ : S.Etale} (u₁ : U₁ ⟶ U₂) (u₂ : U₂ ⟶ U₃),
      weilEtaleLocalFreeMap S m (u₁ ≫ u₂) =
        weilEtaleLocalFreeMap S m u₁ ≫ weilEtaleLocalFreeMap S m u₂ := by
    intro U₁ U₂ U₃ u₁ u₂
    apply freeEquiv.injective
    rw [hFreeMapComp, hFreeMap, hFreeMap, CategoryTheory.Category.assoc,
      ← (weilEtaleLocalFreeSheaf S m U₃).obj.map_comp]
    rfl

  let P_const_Z : CategoryTheory.Functor (Opposite Z_s.Etale) (ModuleCat.{u, u} R) :=
    (CategoryTheory.Functor.const (Opposite Z_s.Etale)).obj R_mod
  let C_Z : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R) := weilEtaleModuleUnit Z_s m
  let η_Z : P_const_Z ⟶ C_Z.obj := adj_Z.unit.app P_const_Z
  let η_app : ∀ U : S.Etale, R_mod ⟶ 𝒬_s.obj.obj (Opposite.op U) :=
    fun U => η_Z.app (Opposite.op (B_is.obj U))
  let π : ∀ U : S.Etale, weilEtaleLocalFreeSheaf S m U ⟶ 𝒬_s :=
    fun U => freeEquiv.symm (η_app U)
  have hπ_nat : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
      weilEtaleLocalFreeMap S m u ≫ π U₂ = π U₁ := by
    intro U₁ U₂ u
    apply freeEquiv.injective
    have hnat := (η_Z.naturality (Opposite.op (B_is.map u))).symm
    change η_app U₂ ≫ 𝒬_s.obj.map (Opposite.op u) = 𝟙 R_mod ≫ η_app U₁ at hnat
    rw [hFreeMapComp]
    dsimp only [π]
    rw [freeEquiv.apply_symm_apply, freeEquiv.apply_symm_apply, hnat,
      CategoryTheory.Category.id_comp]

  
  let P_lc : CategoryTheory.Functor (Opposite Z_s.Etale) (ModuleCat.{u, u} R) :=
    { obj := fun E =>
        ModuleCat.of R (LocallyConstant ↥(Fgt_Z.obj (Opposite.unop E)).left R)
      map := fun {_ _} φ =>
        ModuleCat.ofHom (LocallyConstant.comapₗ R (Fgt_Z.map φ.unop).left.base.hom)
      map_id := fun _ => by
        apply ModuleCat.hom_ext
        ext g x
        simp [LocallyConstant.comapₗ_apply_apply]
      map_comp := fun _ _ => by
        apply ModuleCat.hom_ext
        ext g x
        simp [LocallyConstant.comapₗ_apply_apply] }
  have hP_lc_sheaf : CategoryTheory.Presheaf.IsSheaf J_Z P_lc := by
    rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
    intro E S_sv hS_sv
    have hcov := (hMem Z_s E S_sv).mp hS_sv
    let Y_x := fun x => Classical.choose (hcov x)
    let u_x := fun x => Classical.choose (Classical.choose_spec (hcov x))
    let y_x := fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hcov x)))
    have hx_spec : ∀ x, S_sv.arrows (u_x x) ∧
        AlgebraicGeometry.Etale (Fgt_Z.map (u_x x)).left ∧
        (Fgt_Z.map (u_x x)).left.base (y_x x) = x :=
      fun x => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hcov x)))
    let w_x : ∀ x, S_sv.arrows.category :=
      fun x => CategoryTheory.Presieve.categoryMk S_sv.arrows (u_x x) (hx_spec x).1
    let sec_c : ∀ (c : CategoryTheory.Limits.Cone (S_sv.arrows.diagram.op ⋙ P_lc))
        (w : S_sv.arrows.category),
        ↑c.pt → LocallyConstant ↥(Fgt_Z.obj w.obj.left).left R :=
      fun c w m_el => (c.π.app (Opposite.op w)).hom m_el
    have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S_sv.arrows.diagram.op ⋙ P_lc))
        (w₁ w₂ : S_sv.arrows.category) (m_el : ↑c.pt)
        (y₁ : ↥(Fgt_Z.obj w₁.obj.left).left) (y₂ : ↥(Fgt_Z.obj w₂.obj.left).left),
        (Fgt_Z.map w₁.obj.hom).left.base y₁ = (Fgt_Z.map w₂.obj.hom).left.base y₂ →
        sec_c c w₁ m_el y₁ = sec_c c w₂ m_el y₂ := by
      intro c w₁ w₂ m_el y₁ y₂ heq
      let Y₁ : Z_s.Etale := w₁.obj.left
      let Y₂ : Z_s.Etale := w₂.obj.left
      let u₁ : Y₁ ⟶ E := w₁.obj.hom
      let u₂ : Y₂ ⟶ E := w₂.obj.hom
      haveI : AlgebraicGeometry.Etale (Fgt_Z.map u₂).left := hMorEtale u₂
      let p₁ := CategoryTheory.Limits.pullback.fst (Fgt_Z.map u₁).left (Fgt_Z.map u₂).left
      let p₂ := CategoryTheory.Limits.pullback.snd (Fgt_Z.map u₁).left (Fgt_Z.map u₂).left
      let W₁₂ : Z_s.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (Fgt_Z.obj Y₁).hom)
          (P_et.comp_mem p₁ (Fgt_Z.obj Y₁).hom inferInstance Y₁.prop)
      let p1_et : W₁₂ ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl
      have hw₁ : (Fgt_Z.map u₁).left ≫ (Fgt_Z.obj E).hom = (Fgt_Z.obj Y₁).hom :=
        CategoryTheory.MorphismProperty.Over.w u₁
      have hw₂ : (Fgt_Z.map u₂).left ≫ (Fgt_Z.obj E).hom = (Fgt_Z.obj Y₂).hom :=
        CategoryTheory.MorphismProperty.Over.w u₂
      have hp₂_w : p₂ ≫ Y₂.hom = W₁₂.hom := by
        change p₂ ≫ (Fgt_Z.obj Y₂).hom = p₁ ≫ (Fgt_Z.obj Y₁).hom
        rw [← hw₁, ← hw₂, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      let p2_et : W₁₂ ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ hp₂_w
      have hcomm₁₂ : p1_et ≫ u₁ = p2_et ≫ u₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext CategoryTheory.Limits.pullback.condition
          (Subsingleton.elim _ _)
      let w₁₂ : S_sv.arrows.category :=
        CategoryTheory.Presieve.categoryMk S_sv.arrows (p1_et ≫ u₁)
          (S_sv.downward_closed w₁.property p1_et)
      let α₁ : w₁₂ ⟶ w₁ :=
        CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk p1_et rfl)
      let α₂ : w₁₂ ⟶ w₂ :=
        CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk p2_et hcomm₁₂.symm)
      obtain ⟨q, hq₁, hq₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ heq
      have hc₁ := congrArg
        (fun φ : c.pt ⟶ P_lc.obj (Opposite.op W₁₂) =>
          (φ.hom m_el : LocallyConstant ↥(Fgt_Z.obj W₁₂).left R) q)
        (c.w (Opposite.op α₁))
      have hc₂ := congrArg
        (fun φ : c.pt ⟶ P_lc.obj (Opposite.op W₁₂) =>
          (φ.hom m_el : LocallyConstant ↥(Fgt_Z.obj W₁₂).left R) q)
        (c.w (Opposite.op α₂))
      change sec_c c w₁ m_el (p₁.base q) = sec_c c w₁₂ m_el q at hc₁
      change sec_c c w₂ m_el (p₂.base q) = sec_c c w₁₂ m_el q at hc₂
      rw [hq₁] at hc₁
      rw [hq₂] at hc₂
      exact hc₁.trans hc₂.symm
    let g_fn : ∀ (c : CategoryTheory.Limits.Cone (S_sv.arrows.diagram.op ⋙ P_lc))
        (m_el : ↑c.pt), ↥(Fgt_Z.obj E).left → R :=
      fun c m_el x => sec_c c (w_x x) m_el (y_x x)
    have hg_eq : ∀ (c : CategoryTheory.Limits.Cone (S_sv.arrows.diagram.op ⋙ P_lc))
        (w : S_sv.arrows.category) (m_el : ↑c.pt) (y : ↥(Fgt_Z.obj w.obj.left).left),
        g_fn c m_el ((Fgt_Z.map w.obj.hom).left.base y) = sec_c c w m_el y := by
      intro c w m_el y
      exact h_ov c (w_x ((Fgt_Z.map w.obj.hom).left.base y)) w m_el _ y
        (hx_spec ((Fgt_Z.map w.obj.hom).left.base y)).2.2
    have hg_lc : ∀ (c : CategoryTheory.Limits.Cone (S_sv.arrows.diagram.op ⋙ P_lc))
        (m_el : ↑c.pt), IsLocallyConstant (g_fn c m_el) := by
      intro c m_el s
      rw [isOpen_iff_forall_mem_open]
      intro x hx_s
      haveI : AlgebraicGeometry.Etale (Fgt_Z.map (u_x x)).left := (hx_spec x).2.1
      let f_x := sec_c c (w_x x) m_el
      let O_x : Set ↥(Fgt_Z.obj (Y_x x)).left := f_x ⁻¹' s
      have hO_x : IsOpen O_x := f_x.isLocallyConstant s
      refine ⟨(Fgt_Z.map (u_x x)).left.base '' O_x, ?_,
        (Fgt_Z.map (u_x x)).left.isOpenMap O_x hO_x, ?_⟩
      · rintro _ ⟨y, hy, rfl⟩
        change g_fn c m_el ((Fgt_Z.map (w_x x).obj.hom).left.base y) ∈ s
        rw [hg_eq c (w_x x) m_el y]
        exact hy
      · refine ⟨y_x x, ?_, (hx_spec x).2.2⟩
        have hf_eq : f_x (y_x x) = g_fn c m_el x := rfl
        change f_x (y_x x) ∈ s
        rw [hf_eq]
        exact hx_s
    let lift_c : ∀ (c : CategoryTheory.Limits.Cone (S_sv.arrows.diagram.op ⋙ P_lc)),
        c.pt ⟶ P_lc.obj (Opposite.op E) :=
      fun c => ModuleCat.ofHom
        { toFun := fun m_el => ⟨g_fn c m_el, hg_lc c m_el⟩
          map_add' := fun m₁ m₂ => LocallyConstant.ext fun x => by
            dsimp [g_fn, sec_c]
            rw [map_add]
            rfl
          map_smul' := fun r m₁ => LocallyConstant.ext fun x => by
            dsimp [g_fn, sec_c]
            rw [map_smul]
            rfl }
    refine ⟨{
      lift := lift_c
      fac := fun c w_op => by
        apply ModuleCat.hom_ext
        refine LinearMap.ext fun m_el => LocallyConstant.ext fun y => ?_
        exact hg_eq c w_op.unop m_el y
      uniq := fun c m_hom hm => by
        let m_hom' : c.pt ⟶ P_lc.obj (Opposite.op E) := m_hom
        change m_hom' = lift_c c
        apply ModuleCat.hom_ext
        refine LinearMap.ext fun m_el => LocallyConstant.ext fun x => ?_
        have hmx := congrArg
          (fun φ : c.pt ⟶ P_lc.obj (Opposite.op (Y_x x)) =>
            (φ.hom m_el : LocallyConstant ↥(Fgt_Z.obj (Y_x x)).left R) (y_x x))
          (hm (Opposite.op (w_x x)))
        change (m_hom'.hom m_el : LocallyConstant ↥(Fgt_Z.obj E).left R)
            ((Fgt_Z.map (u_x x)).left.base (y_x x)) =
          g_fn c m_el x at hmx
        rwa [(hx_spec x).2.2] at hmx }⟩
  let θ_R : P_const_Z ⟶ P_lc :=
    { app := fun _ => ModuleCat.ofHom (LocallyConstant.constₗ R)
      naturality := fun {_ _} _ => by
        apply ModuleCat.hom_ext
        refine LinearMap.ext fun r => LocallyConstant.ext fun x => rfl }
  have hθ_R_inj : CategoryTheory.Presheaf.IsLocallyInjective J_Z θ_R := by
    refine CategoryTheory.Presheaf.IsLocallyInjective.mk fun {E_op} r₁ r₂ heq => ?_
    let E := E_op.unop
    rw [hMem Z_s E]
    intro x
    have hr : r₁ = r₂ := by
      have hfn : LocallyConstant.const ↥(Fgt_Z.obj E).left (r₁ : R) =
          LocallyConstant.const ↥(Fgt_Z.obj E).left (r₂ : R) := heq
      exact congrArg (fun g : LocallyConstant ↥(Fgt_Z.obj E).left R => g x) hfn
    refine ⟨E, 𝟙 E, x, ?_, hMorEtale (𝟙 E), rfl⟩
    change (P_const_Z.map (Opposite.op (𝟙 E))).hom r₁ =
      (P_const_Z.map (Opposite.op (𝟙 E))).hom r₂
    exact congrArg _ hr
  have hθ_R_surj : CategoryTheory.Presheaf.IsLocallySurjective J_Z θ_R := by
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {E} g => ?_
    let g_lc : LocallyConstant ↥(Fgt_Z.obj E).left R := g
    rw [hMem Z_s E]
    intro x
    let r : R := g_lc x
    let O_r : (Fgt_Z.obj E).left.Opens := ⟨g_lc ⁻¹' {r}, g_lc.isLocallyConstant {r}⟩
    let Y : Z_s.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (O_r.ι ≫ (Fgt_Z.obj E).hom)
        (P_et.comp_mem O_r.ι (Fgt_Z.obj E).hom inferInstance E.prop)
    let u : Y ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_r.ι rfl
    refine ⟨Y, u, ⟨x, rfl⟩, ?_, hMorEtale u, rfl⟩
    refine ⟨r, ?_⟩
    exact LocallyConstant.ext fun z => z.2.symm
  have hθ_R_W : J_Z.W θ_R :=
    (J_Z.W_iff_isLocallyBijective θ_R).mpr ⟨hθ_R_inj, hθ_R_surj⟩
  have hIso_θ_R :
      CategoryTheory.IsIso ((CategoryTheory.presheafToSheaf J_Z (ModuleCat.{u, u} R)).map θ_R) :=
    (J_Z.W_iff θ_R).mp hθ_R_W
  let ℒ_lc : CategoryTheory.Sheaf J_Z (ModuleCat.{u, u} R) := ⟨P_lc, hP_lc_sheaf⟩
  let Υ_R : C_Z ⟶ ℒ_lc := (adj_Z.homEquiv P_const_Z ℒ_lc).symm θ_R
  have hΥ_eq : Υ_R =
      (CategoryTheory.presheafToSheaf J_Z (ModuleCat.{u, u} R)).map θ_R ≫ adj_Z.counit.app ℒ_lc :=
    CategoryTheory.Adjunction.homEquiv_counit _ _ _ _
  have hIso_counit_Z : CategoryTheory.IsIso (adj_Z.counit.app ℒ_lc) := by
    dsimp [adj_Z]
    infer_instance
  haveI : CategoryTheory.IsIso Υ_R := by
    rw [hΥ_eq]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_θ_R hIso_counit_Z
  let e_R : C_Z ≅ ℒ_lc := CategoryTheory.asIso Υ_R
  let θ_Z : ∀ Y : Z_s.Etale, P_lc.obj (Opposite.op Y) ≅ C_Z.obj.obj (Opposite.op Y) :=
    fun Y =>
      (((CategoryTheory.sheafToPresheaf J_Z (ModuleCat.{u, u} R)).mapIso e_R.symm).app
        (Opposite.op Y))
  have hθ_Z_nat : ∀ {Y₁ Y₂ : Z_s.Etale} (f : Y₁ ⟶ Y₂),
      (θ_Z Y₂).hom ≫ C_Z.obj.map (Opposite.op f) =
        P_lc.map (Opposite.op f) ≫ (θ_Z Y₁).hom :=
    fun f => (e_R.inv.hom.naturality (Opposite.op f)).symm
  have hθ_Z_unit : ∀ Y : Z_s.Etale,
      η_Z.app (Opposite.op Y) = ModuleCat.ofHom (LocallyConstant.constₗ R) ≫ (θ_Z Y).hom := by
    intro Y
    have hunit : θ_R = η_Z ≫ e_R.hom.hom :=
      ((CategoryTheory.Adjunction.homEquiv_unit adj_Z P_const_Z ℒ_lc Υ_R).symm.trans
        ((adj_Z.homEquiv P_const_Z ℒ_lc).apply_symm_apply θ_R)).symm
    have happ := congrArg (fun τ : P_const_Z ⟶ P_lc => τ.app (Opposite.op Y) ≫ (θ_Z Y).hom) hunit
    dsimp [θ_R, θ_Z] at happ
    rw [CategoryTheory.Category.assoc] at happ
    have hinv : e_R.hom.hom.app (Opposite.op Y) ≫ e_R.inv.hom.app (Opposite.op Y) = 𝟙 _ :=
      congrArg (fun φ : C_Z ⟶ C_Z => φ.hom.app (Opposite.op Y)) e_R.hom_inv_id
    rw [hinv, CategoryTheory.Category.comp_id] at happ
    exact happ.symm

  
  let F_free : ∀ U : S.Etale, CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R) :=
    fun U =>
      { obj := fun V_op => ModuleCat.of R ((V_op.unop ⟶ U) →₀ R)
        map := fun {V₁_op V₂_op} w_op =>
          ModuleCat.ofHom (Finsupp.lmapDomain R R (fun g : V₁_op.unop ⟶ U => w_op.unop ≫ g))
        map_id := fun V_op => by
          apply ModuleCat.hom_ext
          have hid : (fun g : V_op.unop ⟶ U => (𝟙 V_op).unop ≫ g) = id :=
            funext fun g => CategoryTheory.Category.id_comp g
          rw [hid, Finsupp.lmapDomain_id]
          rfl
        map_comp := fun {V₁_op V₂_op V₃_op} w₁ w₂ => by
          apply ModuleCat.hom_ext
          have hcomp : (fun g : V₁_op.unop ⟶ U => (w₁ ≫ w₂).unop ≫ g) =
              (fun g : V₂_op.unop ⟶ U => w₂.unop ≫ g) ∘
                (fun g : V₁_op.unop ⟶ U => w₁.unop ≫ g) :=
            funext fun g => CategoryTheory.Category.assoc w₂.unop w₁.unop g
          rw [hcomp, Finsupp.lmapDomain_comp]
          rfl }
  let Ψ_ext : ∀ {U : S.Etale}
      {G : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R)}
      (β : R_mod ⟶ G.obj (Opposite.op U)), F_free U ⟶ G :=
    fun {U G} β =>
      { app := fun V_op =>
          ModuleCat.ofHom (Finsupp.lsum R (fun g : V_op.unop ⟶ U =>
            LinearMap.toSpanSingleton R ↑(G.obj V_op)
              ((G.map (Opposite.op g)).hom (β.hom (1 : R)))))
        naturality := fun {V₁_op V₂_op} w_op => by
          apply ModuleCat.hom_ext
          apply Finsupp.lhom_ext
          intro g r
          change (Finsupp.lsum R _ ((Finsupp.lmapDomain R R (fun h => w_op.unop ≫ h))
            (Finsupp.single g r))) =
            (G.map w_op).hom (Finsupp.lsum R _ (Finsupp.single g r))
          rw [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, Finsupp.lsum_single,
            Finsupp.lsum_single, LinearMap.toSpanSingleton_apply,
            LinearMap.toSpanSingleton_apply, map_smul]
          have hmap : Opposite.op (w_op.unop ≫ g) = Opposite.op g ≫ w_op := rfl
          rw [hmap, G.map_comp]
          rfl }
  let ι_free : ∀ U : S.Etale, R_mod ⟶ (F_free U).obj (Opposite.op U) :=
    fun U => ModuleCat.ofHom (Finsupp.lsingle (𝟙 U))
  have hΨ_eval : ∀ {U : S.Etale}
      {G : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R)}
      (β : R_mod ⟶ G.obj (Opposite.op U)),
      ι_free U ≫ (Ψ_ext β).app (Opposite.op U) = β := by
    intro U G β
    apply ModuleCat.hom_ext
    refine LinearMap.ext fun r => ?_
    change (Finsupp.lsum R _ (Finsupp.single (𝟙 U) r)) = β.hom r
    have hid_op : Opposite.op (𝟙 U) = 𝟙 (Opposite.op U) := rfl
    rw [Finsupp.lsum_single, LinearMap.toSpanSingleton_apply, hid_op, G.map_id]
    change r • β.hom (1 : R) = β.hom r
    rw [← map_smul, smul_eq_mul, mul_one]
  have hΨ_uniq : ∀ {U : S.Etale}
      {G : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R)}
      (τ : F_free U ⟶ G),
      Ψ_ext (ι_free U ≫ τ.app (Opposite.op U)) = τ := by
    intro U G τ
    ext V_op : 2
    apply ModuleCat.hom_ext
    apply Finsupp.lhom_ext
    intro g r
    have hnat := congrArg (fun φ : (F_free U).obj (Opposite.op U) ⟶ G.obj V_op =>
      φ.hom (Finsupp.single (𝟙 U) r)) (τ.naturality (Opposite.op g))
    change (τ.app V_op).hom (Finsupp.mapDomain (fun h => g ≫ h) (Finsupp.single (𝟙 U) r)) =
      (G.map (Opposite.op g)).hom ((τ.app (Opposite.op U)).hom (Finsupp.single (𝟙 U) r)) at hnat
    rw [Finsupp.mapDomain_single, CategoryTheory.Category.comp_id] at hnat
    change (Finsupp.lsum R _ (Finsupp.single g r)) = (τ.app V_op).hom (Finsupp.single g r)
    rw [Finsupp.lsum_single, LinearMap.toSpanSingleton_apply, hnat]
    have hsmul : Finsupp.single (𝟙 U) r = r • Finsupp.single (𝟙 U) (1 : R) := by
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
    rw [hsmul, map_smul, map_smul]
    rfl
  let Ξ : ∀ U : S.Etale, F_free U ≅ CategoryTheory.Presheaf.freeYoneda U R_mod :=
    fun U =>
      { hom := Ψ_ext (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 _))
        inv := CategoryTheory.Presheaf.freeYonedaHomEquiv.symm (ι_free U)
        hom_inv_id := by
          have h1 : Ψ_ext (ι_free U ≫
