    change weilPolyP1CohomologyRepHomEquiv Z V₁ G
      (L_Z.map (CategoryTheory.yoneda.map u) ≫ φ) = _
    rw [hRepEquivEq Z V₁ G _, hRepEquivEq Z V₂ G φ,
      adj_tot.homEquiv_naturality_left (CategoryTheory.yoneda.map u) φ,
      ← CategoryTheory.yonedaEquiv_naturality]
