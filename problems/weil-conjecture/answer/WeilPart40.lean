      let B_pre := CategoryTheory.ShortComplex.mk
        δ_pre ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U (q + 1)).map SC.f) hcomp₂_pre
      have hA_pre_ex : A_pre.Exact := by
        apply hPresheafExact A_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X_U.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        let eW : A_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
            (by dsimp [A_pre, evW, δ_pre]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hB_pre_ex : B_pre.Exact := by
        apply hPresheafExact B_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X_U.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        let eW : B_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
            (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      let Δ : (Φ_HDI q).obj SC.X₃ ⟶ (Φ_HDI (q + 1)).obj SC.X₁ := E_X.map δ_pre
      have hcomp₁ : (Φ_HDI q).map SC.g ≫ Δ = 0 := by
        change E_X.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).map SC.g) ≫
          E_X.map δ_pre = 0
        rw [← E_X.map_comp, hcomp₁_pre, E_X.map_zero]
      have hcomp₂ : Δ ≫ (Φ_HDI (q + 1)).map SC.f = 0 := by
        change E_X.map δ_pre ≫
          E_X.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U (q + 1)).map SC.f) = 0
        rw [← E_X.map_comp, hcomp₂_pre, E_X.map_zero]
      have hEx₁ : (CategoryTheory.ShortComplex.mk ((Φ_HDI q).map SC.g) Δ hcomp₁).Exact :=
        (hA_pre_ex.map W_B).map Sh_X
      have hEx₂ : (CategoryTheory.ShortComplex.mk Δ ((Φ_HDI (q + 1)).map SC.f) hcomp₂).Exact :=
        (hB_pre_ex.map W_B).map Sh_X
      have hZ_succ : CategoryTheory.Limits.IsZero ((Φ_HDI (q + 1)).obj SC.X₂) :=
        hAcyc (q + 1) (Nat.le_add_left 1 q)
      have hf_zero : (Φ_HDI (q + 1)).map SC.f = 0 :=
        hZ_succ.eq_of_tgt ((Φ_HDI (q + 1)).map SC.f) 0
      have hEpi_Δ : CategoryTheory.Epi Δ := hEx₂.epi_f hf_zero
      refine ⟨Δ, hcomp₁, hcomp₂, hEx₁, hEx₂, hEpi_Δ, ?_⟩
      intro hZ_q
      have hg_zero : (Φ_HDI q).map SC.g = 0 := hZ_q.eq_of_src ((Φ_HDI q).map SC.g) 0
      have hMono_Δ : CategoryTheory.Mono Δ := hEx₁.mono_g hg_zero
      exact CategoryTheory.isIso_of_mono_of_epi Δ
    refine ⟨?_, ?_, ?_⟩
    · obtain ⟨Δ₀, hcomp₁_0, _, hEx₁_0, _, hEpi_Δ₀, _⟩ := hConn 0
      let δ₀ : pf_j.obj SC.X₃ ⟶ (Φ_HDI 1).obj SC.X₁ := ε₀.inv.app SC.X₃ ≫ Δ₀
      have hcomp₀ : pf_j.map SC.g ≫ δ₀ = 0 := by
        dsimp [δ₀]
        rw [← CategoryTheory.Category.assoc, ε₀.inv.naturality SC.g,
          CategoryTheory.Category.assoc, hcomp₁_0, CategoryTheory.Limits.comp_zero]
      have hEpi_δ₀ : CategoryTheory.Epi δ₀ := by
        dsimp [δ₀]
        exact CategoryTheory.epi_comp _ _
      have hEx_pf : (CategoryTheory.ShortComplex.mk (pf_j.map SC.g) δ₀ hcomp₀).Exact := by
        let e_SC : CategoryTheory.ShortComplex.mk ((Φ_HDI 0).map SC.g) Δ₀ hcomp₁_0 ≅
            CategoryTheory.ShortComplex.mk (pf_j.map SC.g) δ₀ hcomp₀ :=
          CategoryTheory.ShortComplex.isoMk
            (ε₀.app SC.X₂) (ε₀.app SC.X₃) (CategoryTheory.Iso.refl _)
            (ε₀.hom.naturality SC.g).symm
            (by
              dsimp [δ₀]
              rw [← CategoryTheory.Category.assoc, ε₀.hom_inv_id_app,
                CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mp hEx₁_0
      refine ⟨⟨δ₀, hcomp₀, hEpi_δ₀, hEx_pf⟩, ?_⟩
      intro hZ₁
      obtain ⟨hSC_ex, hSC_mono⟩ :=
        (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_j).mp
          inferInstance SC hSE
      have hδ₀_zero : δ₀ = 0 := hZ₁.eq_of_tgt δ₀ 0
      have hSC_epi : CategoryTheory.Epi (pf_j.map SC.g) := hEx_pf.epi_f hδ₀_zero
      exact CategoryTheory.ShortComplex.ShortExact.mk' hSC_ex hSC_mono hSC_epi
    · intro q hq
      obtain ⟨Δ, _, _, _, _, _, hIso_Δ⟩ := hConn q
      let e_Δ : (Φ_HDI q).obj SC.X₃ ≅ (Φ_HDI (q + 1)).obj SC.X₁ :=
        @CategoryTheory.asIso _ _ _ _ Δ (hIso_Δ (hAcyc q hq))
      exact ⟨e_Δ.symm⟩
    · intro p hp hZ_succ
      obtain ⟨Δ, _, _, _, _, _, hIso_Δ⟩ := hConn p
      let e_Δ : (Φ_HDI p).obj SC.X₃ ≅ (Φ_HDI (p + 1)).obj SC.X₁ :=
        @CategoryTheory.asIso _ _ _ _ Δ (hIso_Δ (hAcyc p hp))
      exact hZ_succ.of_iso e_Δ

  
  have hPushH0 :
      ∃ e_H0 : ∀ H : CategoryTheory.Sheaf J_U AddCommGrpCat.{u},
          (pf_j.obj H).H 0 ≃+ H.H 0,
        ∀ {H₁ H₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
          (φ : H₁ ⟶ H₂) (z : (pf_j.obj H₁).H 0),
          e_H0 H₂
            ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp
              ((CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (Nat.add_zero 0) z) =
          (CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
            ((CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))
            (Nat.add_zero 0) (e_H0 H₁ z) := by
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let evZ : ∀ (G₀ : AddCommGrpCat.{u}), (Aℤ ⟶ G₀) ≃+ ↥G₀ := fun G₀ =>
      AddEquiv.mk'
        { toFun := fun u => u.hom (ULift.up (1 : ℤ))
          invFun := fun m => AddCommGrpCat.ofHom
            { toFun := fun z => z.down • m
              map_zero' := zero_zsmul m
              map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
          left_inv := fun u => by
            apply AddCommGrpCat.ext
            rintro ⟨z⟩
            change z • u.hom (ULift.up (1 : ℤ)) = u.hom (ULift.up z)
            have hz : z • (ULift.up (1 : ℤ) : ↥Aℤ) = ULift.up z :=
              ULift.ext _ _ (by change z • (1 : ℤ) = z; simp)
            rw [← map_zsmul u.hom z (ULift.up (1 : ℤ)), hz]
          right_inv := fun m => one_zsmul m }
        (fun _ _ => rfl)
    let termEt : ∀ S : AlgebraicGeometry.Scheme.{u}, S.Etale :=
      fun S => CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance
    have hTermEt : ∀ S : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Limits.IsTerminal (termEt S) := fun S =>
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U₀ => CategoryTheory.MorphismProperty.Over.homMk U₀.hom (Category.comp_id U₀.hom))
        (fun U₀ m => CategoryTheory.MorphismProperty.Comma.Hom.ext
          ((Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m))
          (Subsingleton.elim _ _))
    let T₁ := termEt X_U
    let T₂ := termEt X
    let hT₁ := hTermEt X_U
    let hT₂ := hTermEt X
    have hT_BT : CategoryTheory.Limits.IsTerminal (B_j.obj T₂) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (U₀.hom ≫ j) U₀.hom (Category.comp_id _))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _))
        (fun U₀ m => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (Category.comp_id
                (m.left ≫ CategoryTheory.Limits.pullback.fst T₂.hom j)).symm.trans
              ((Category.assoc m.left
                  (CategoryTheory.Limits.pullback.fst T₂.hom j) (𝟙 X)).trans
                ((congrArg (m.left ≫ ·)
                    (CategoryTheory.Limits.pullback.condition (f := T₂.hom) (g := j))).trans
                  ((Category.assoc m.left
                      (CategoryTheory.Limits.pullback.snd T₂.hom j) j).symm.trans
                    ((congrArg (· ≫ j) (CategoryTheory.MorphismProperty.Over.w m)).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
          · exact (CategoryTheory.MorphismProperty.Over.w m).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    let e_τ : B_j.obj T₂ ≅ T₁ := hT_BT.uniqueUpToIso hT₁
    let evalH0 : ∀ (S : AlgebraicGeometry.Scheme.{u}) {T_S : S.Etale}
        (hT_S : CategoryTheory.Limits.IsTerminal T_S)
        (G₀ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        G₀.H 0 ≃+ ↥(G₀.obj.obj (Opposite.op T_S)) :=
      fun S {T_S} hT_S G₀ =>
        let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
        let e_adj : (((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ) ⟶ G₀) ≃+
            (Aℤ ⟶ G₀.obj.obj (Opposite.op T_S)) :=
          AddEquiv.mk' (adj_S.homEquiv Aℤ G₀) (fun u₁ u₂ => by
            rw [CategoryTheory.Adjunction.homEquiv_unit,
              CategoryTheory.Adjunction.homEquiv_unit,
              CategoryTheory.Adjunction.homEquiv_unit]
            change adj_S.unit.app Aℤ ≫ (u₁.hom.app (Opposite.op T_S) + u₂.hom.app (Opposite.op T_S)) =
              adj_S.unit.app Aℤ ≫ u₁.hom.app (Opposite.op T_S) +
                adj_S.unit.app Aℤ ≫ u₂.hom.app (Opposite.op T_S)
            exact AddCommGrpCat.ext fun _ => rfl)
        (CategoryTheory.Abelian.Ext.addEquiv₀.trans e_adj).trans
          (evZ (G₀.obj.obj (Opposite.op T_S)))
    have hEvalNat : ∀ (S : AlgebraicGeometry.Scheme.{u}) {T_S : S.Etale}
        (hT_S : CategoryTheory.Limits.IsTerminal T_S)
        {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (ψ : G₁ ⟶ G₂) (x : G₁.H 0),
        evalH0 S hT_S G₂
          ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp
            ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
            (Nat.add_zero 0) x) =
          (ψ.hom.app (Opposite.op T_S)).hom (evalH0 S hT_S G₁ x) := by
      intro S T_S hT_S G₁ G₂ ψ x
      let u := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : x = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
      have hpost : (CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp
          ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
          (Nat.add_zero 0) x = CategoryTheory.Abelian.Ext.mk₀ (u ≫ ψ) := by
        rw [hx]
        exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u ψ
      have hmk : CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (u ≫ ψ)) =
          u ≫ ψ := by
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
      have h1 : evalH0 S hT_S G₂
          ((CategoryTheory.Abelian.Ext.mk₀ ψ).postcomp _ (Nat.add_zero 0) x) =
          ((adj_S.homEquiv Aℤ G₂) (u ≫ ψ)).hom (ULift.up (1 : ℤ)) :=
        congrArg (fun k => ((adj_S.homEquiv Aℤ G₂) k).hom (ULift.up (1 : ℤ)))
          ((congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hpost).trans hmk)
      exact h1.trans (congrArg (fun m : Aℤ ⟶ G₂.obj.obj (Opposite.op T_S) => m.hom (ULift.up (1 : ℤ)))
        (adj_S.homEquiv_naturality_right u ψ))
    let mapIsoEquiv : ∀ (H : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
        ↥((pf_j.obj H).obj.obj (Opposite.op T₂)) ≃+ ↥(H.obj.obj (Opposite.op T₁)) :=
      fun H =>
        let M₁ := H.obj.obj (Opposite.op (B_j.obj T₂))
        let M₂ := H.obj.obj (Opposite.op T₁)
        let f_hom : M₁ ⟶ M₂ := H.obj.map (Opposite.op e_τ.inv)
        let f_inv : M₂ ⟶ M₁ := H.obj.map (Opposite.op e_τ.hom)
        have h1 : f_hom ≫ f_inv = 𝟙 M₁ :=
          (H.obj.map_comp (Opposite.op e_τ.inv) (Opposite.op e_τ.hom)).symm.trans
            ((congrArg (fun k => H.obj.map (Opposite.op k)) e_τ.hom_inv_id).trans
              (H.obj.map_id (Opposite.op (B_j.obj T₂))))
        have h2 : f_inv ≫ f_hom = 𝟙 M₂ :=
          (H.obj.map_comp (Opposite.op e_τ.hom) (Opposite.op e_τ.inv)).symm.trans
            ((congrArg (fun k => H.obj.map (Opposite.op k)) e_τ.inv_hom_id).trans
              (H.obj.map_id (Opposite.op T₁)))
        AddEquiv.mk'
          { toFun := fun x => f_hom.hom x
            invFun := fun y => f_inv.hom y
            left_inv := fun x => congrArg (fun k : M₁ ⟶ M₁ => k.hom x) h1
            right_inv := fun y => congrArg (fun k : M₂ ⟶ M₂ => k.hom y) h2 }
          (fun x y => map_add f_hom.hom x y)
    let e_H0 : ∀ H : CategoryTheory.Sheaf J_U AddCommGrpCat.{u},
        (pf_j.obj H).H 0 ≃+ H.H 0 :=
      fun H => ((evalH0 X hT₂ (pf_j.obj H)).trans (mapIsoEquiv H)).trans (evalH0 X_U hT₁ H).symm
    refine ⟨e_H0, fun {H₁ H₂} φ z => ?_⟩
    apply (evalH0 X_U hT₁ H₂).injective
    have hlhs1 : evalH0 X_U hT₁ H₂
        (e_H0 H₂ ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp _ (Nat.add_zero 0) z)) =
        (H₂.obj.map (Opposite.op e_τ.inv)).hom
          (evalH0 X hT₂ (pf_j.obj H₂)
            ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp _ (Nat.add_zero 0) z)) :=
      (evalH0 X_U hT₁ H₂).apply_symm_apply _
    have hlhs2 : (H₂.obj.map (Opposite.op e_τ.inv)).hom
          (evalH0 X hT₂ (pf_j.obj H₂)
            ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp _ (Nat.add_zero 0) z)) =
        (H₂.obj.map (Opposite.op e_τ.inv)).hom
          ((φ.hom.app (Opposite.op (B_j.obj T₂))).hom (evalH0 X hT₂ (pf_j.obj H₁) z)) :=
      congrArg (H₂.obj.map (Opposite.op e_τ.inv)).hom (hEvalNat X hT₂ (pf_j.map φ) z)
    have hrhs1 : evalH0 X_U hT₁ H₂
        ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp _ (Nat.add_zero 0) (e_H0 H₁ z)) =
        (φ.hom.app (Opposite.op T₁)).hom (evalH0 X_U hT₁ H₁ (e_H0 H₁ z)) :=
      hEvalNat X_U hT₁ φ (e_H0 H₁ z)
    have hrhs2 : (φ.hom.app (Opposite.op T₁)).hom (evalH0 X_U hT₁ H₁ (e_H0 H₁ z)) =
        (φ.hom.app (Opposite.op T₁)).hom
          ((H₁.obj.map (Opposite.op e_τ.inv)).hom (evalH0 X hT₂ (pf_j.obj H₁) z)) :=
      congrArg (φ.hom.app (Opposite.op T₁)).hom ((evalH0 X_U hT₁ H₁).apply_symm_apply _)
    have hnat := congrArg
      (fun k : H₁.obj.obj (Opposite.op (B_j.obj T₂)) ⟶ H₂.obj.obj (Opposite.op T₁) =>
        k.hom (evalH0 X hT₂ (pf_j.obj H₁) z))
      (φ.hom.naturality (Opposite.op e_τ.inv))
    exact (hlhs1.trans hlhs2).trans (hnat.symm.trans (hrhs1.trans hrhs2).symm)
  obtain ⟨e_j0, he_j0_nat⟩ := hPushH0

  
  let Fℤ_of : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun S => (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))

  let isoH : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {A B : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (e : A ≅ B) (q : ℕ), A.H q ≃+ B.H q :=
    fun S {A B} e q =>
      AddEquiv.mk'
        { toFun := (CategoryTheory.Abelian.Ext.mk₀ e.hom).postcomp (Fℤ_of S) (Nat.add_zero q)
          invFun := (CategoryTheory.Abelian.Ext.mk₀ e.inv).postcomp (Fℤ_of S) (Nat.add_zero q)
          left_inv := fun x => by
            change (x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero q) = x
            rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
          right_inv := fun y => by
            change (y.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero q) = y
            rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id] }
        (((CategoryTheory.Abelian.Ext.mk₀ e.hom).postcomp (Fℤ_of S) (Nat.add_zero q)).map_add)

  have hShiftEquiv : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
      (_hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂] (m : ℕ),
      Nonempty (SC.X₃.H (m + 1) ≃+ SC.X₁.H (m + 2)) := by
    intro S SC hSE _ m
    let dm_hom : SC.X₃.H (m + 1) →+ SC.X₁.H (m + 2) :=
      hSE.extClass.postcomp (Fℤ_of S) (rfl : (m + 1) + 1 = m + 2)
    have hInj : Function.Injective dm_hom := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨y, hy⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (Fℤ_of S) hSE z
          (rfl : (m + 1) + 1 = m + 2) hz
      have hy0 : y = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective y
      rw [← hy, hy0,
        CategoryTheory.Abelian.Ext.zero_comp (Fℤ_of S) (m + 1)
          (CategoryTheory.Abelian.Ext.mk₀ SC.g) (m + 1) (Nat.add_zero (m + 1))]
    have hSurj : Function.Surjective dm_hom := by
      intro x
      have hxf : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (m + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Fℤ_of S) hSE x hxf
        (rfl : (m + 1) + 1 = m + 2)
    exact ⟨AddEquiv.ofBijective dm_hom ⟨hInj, hSurj⟩⟩

  have hCokH1 : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
      (_hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂],
      let g0 := (CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Fℤ_of S) (Nat.add_zero 0)
      Nonempty ((SC.X₃.H 0 ⧸ g0.range) ≃+ SC.X₁.H 1) ∧
      (Subsingleton (SC.X₁.H 1) → Function.Surjective g0) := by
    intro S SC hSE _ g0
    let d0_hom : SC.X₃.H 0 →+ SC.X₁.H 1 := hSE.extClass.postcomp (Fℤ_of S) (Nat.zero_add 1)
    have hSurj_d0 : Function.Surjective d0_hom := by
      intro x
      have hxf : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Fℤ_of S) hSE x hxf (Nat.zero_add 1)
    have hRangeKer : g0.range = d0_hom.ker := by
      ext q
      constructor
      · rintro ⟨y, rfl⟩
        rw [AddMonoidHom.mem_ker]
        have hex3 := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Fℤ_of S) hSE 0 1 (Nat.zero_add 1)
        have hz_mor : AddCommGrpCat.ofHom g0 ≫ AddCommGrpCat.ofHom d0_hom = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex3
        exact congrArg (fun m => m.hom y) hz_mor
      · intro hq
        rw [AddMonoidHom.mem_ker] at hq
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (Fℤ_of S) hSE q (Nat.zero_add 1) hq
    have hSub_imp : Subsingleton (SC.X₁.H 1) → Function.Surjective g0 := by
      intro hSub q
      have hq_ker : q ∈ d0_hom.ker := by
        rw [AddMonoidHom.mem_ker]
        exact hSub.elim _ _
      rwa [← hRangeKer] at hq_ker
    let eqv_q : (SC.X₃.H 0 ⧸ g0.range) ≃+ SC.X₁.H 1 :=
      hRangeKer.symm ▸ QuotientAddGroup.quotientKerEquivOfSurjective d0_hom hSurj_d0
    exact ⟨⟨eqv_q⟩, hSub_imp⟩

  
  have hFourTermCardMul : ∀ {A₁ A₂ A₃ R₁ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (f' : A₁ ⟶ A₂) (g' : A₂ ⟶ A₃) (δ₀ : A₃ ⟶ R₁) [CategoryTheory.Epi δ₀]
      (hfg' : f' ≫ g' = 0) (hgδ : g' ≫ δ₀ = 0),
      (CategoryTheory.ShortComplex.mk f' g' hfg').Exact →
      (CategoryTheory.ShortComplex.mk g' δ₀ hgδ).Exact →
      let W := CategoryTheory.Limits.cokernel f'
      Function.Surjective
        ((CategoryTheory.Abelian.Ext.mk₀ g').postcomp (Fℤ_of X) (Nat.add_zero 0)) →
      Subsingleton (R₁.H 1) →
      Finite (W.H 1) →
      Finite (R₁.H 0) ∧ Nat.card (R₁.H 0) * Nat.card (A₃.H 1) = Nat.card (W.H 1) := by
    intro A₁ A₂ A₃ R₁ f' g' δ₀ _ hfg' hgδ hEx₁ hEx₂ W hSurj_g'0 hSub_R1 hFin_W1
    let π_W : A₂ ⟶ W := CategoryTheory.Limits.cokernel.π f'
    let i_W : W ⟶ A₃ := CategoryTheory.Limits.cokernel.desc f' g' hfg'
    have hπ_iW : π_W ≫ i_W = g' := CategoryTheory.Limits.cokernel.π_desc f' g' hfg'
    have hMono_iW : CategoryTheory.Mono i_W :=
      CategoryTheory.ShortComplex.Exact.mono_cokernelDesc hEx₁
    have hiδ : i_W ≫ δ₀ = 0 :=
      (CategoryTheory.cancel_epi π_W).mp
        ((Category.assoc π_W i_W δ₀).symm.trans
          ((congrArg (· ≫ δ₀) hπ_iW).trans
            (hgδ.trans CategoryTheory.Limits.comp_zero.symm)))
    let S₂ := CategoryTheory.ShortComplex.mk g' δ₀ hgδ
    let SC_W2 := CategoryTheory.ShortComplex.mk i_W δ₀ hiδ
    let ℓ_g : A₂ ⟶ CategoryTheory.Limits.kernel δ₀ :=
      CategoryTheory.Limits.kernel.lift δ₀ g' hgδ
    have : CategoryTheory.Epi ℓ_g :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift S₂).mp hEx₂
    let ℓ_iW : W ⟶ CategoryTheory.Limits.kernel δ₀ :=
      CategoryTheory.Limits.kernel.lift δ₀ i_W hiδ
    have hfac_k : π_W ≫ ℓ_iW = ℓ_g := by
      apply CategoryTheory.Limits.equalizer.hom_ext
      rw [Category.assoc, CategoryTheory.Limits.kernel.lift_ι, hπ_iW,
        CategoryTheory.Limits.kernel.lift_ι]
    have : CategoryTheory.Epi (π_W ≫ ℓ_iW) := by rw [hfac_k]; infer_instance
    have : CategoryTheory.Epi ℓ_iW := CategoryTheory.epi_of_epi π_W ℓ_iW
    have hSE_W2 : SC_W2.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        ((CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift SC_W2).mpr inferInstance)
        hMono_iW inferInstance
    have hSurj_iW0 : Function.Surjective
        ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp (Fℤ_of X) (Nat.add_zero 0)) := by
      intro q
      obtain ⟨z, hz⟩ := hSurj_g'0 q
      refine ⟨((CategoryTheory.Abelian.Ext.mk₀ π_W).postcomp (Fℤ_of X) (Nat.add_zero 0)) z, ?_⟩
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ π_W) (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ i_W) (Nat.add_zero 0) = q
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hπ_iW]
      exact hz
    let dW_hom : R₁.H 0 →+ W.H 1 := hSE_W2.extClass.postcomp (Fℤ_of X) (Nat.zero_add 1)
    let φ₁ : W.H 1 →+ A₃.H 1 :=
      (CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp (Fℤ_of X) (Nat.add_zero 1)
    have hInj_dW : Function.Injective dW_hom := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨q, hq⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (Fℤ_of X) hSE_W2 r (Nat.zero_add 1) hr
      obtain ⟨w, hw⟩ := hSurj_iW0 q
      have hw' : w.comp (CategoryTheory.Abelian.Ext.mk₀ i_W) (Nat.add_zero 0) = q := hw
      rw [← hq, ← hw',
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero w
          (CategoryTheory.Abelian.Ext.mk₀ i_W) (CategoryTheory.Abelian.Ext.mk₀ δ₀) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ i_W δ₀, hiδ,
        CategoryTheory.Abelian.Ext.mk₀_zero W R₁,
        CategoryTheory.Abelian.Ext.comp_zero w R₁ 0 0 rfl]
    have hSurj_φ₁ : Function.Surjective φ₁ := by
      intro z
      have hz_δ : z.comp (CategoryTheory.Abelian.Ext.mk₀ δ₀) (Nat.add_zero 1) = 0 :=
        hSub_R1.elim _ _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ (Fℤ_of X) hSE_W2 z hz_δ
    have hRangeKer_W : dW_hom.range = φ₁.ker := by
      ext w
      constructor
      · rintro ⟨r, rfl⟩
        rw [AddMonoidHom.mem_ker]
        change (r.comp hSE_W2.extClass (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC_W2.f) (Nat.add_zero 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc r hSE_W2.extClass
            (CategoryTheory.Abelian.Ext.mk₀ SC_W2.f) (Nat.zero_add 1) (Nat.add_zero 1) rfl,
          hSE_W2.extClass_comp,
          CategoryTheory.Abelian.Ext.comp_zero r A₃ 1 1 rfl]
      · intro hw
        rw [AddMonoidHom.mem_ker] at hw
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Fℤ_of X) hSE_W2 w hw (Nat.zero_add 1)
    have : Finite (W.H 1) := hFin_W1
    have hFin_R1 : Finite (R₁.H 0) := Finite.of_injective dW_hom hInj_dW
    refine ⟨hFin_R1, ?_⟩
    let K_W := φ₁.ker
    have hCard_K : Nat.card ↥K_W = Nat.card (R₁.H 0) := by
      dsimp [K_W]
      rw [← hRangeKer_W]
      exact Nat.card_congr (Equiv.ofInjective dW_hom hInj_dW).symm
    have hCard_Q : Nat.card (W.H 1 ⧸ K_W) = Nat.card (A₃.H 1) :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective φ₁ hSurj_φ₁).toEquiv
    calc Nat.card (R₁.H 0) * Nat.card (A₃.H 1)
        = Nat.card (W.H 1 ⧸ K_W) * Nat.card ↥K_W := by rw [hCard_K, hCard_Q, mul_comm]
      _ = Nat.card (W.H 1) := (AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup K_W).symm

  
  dsimp only
  induction M_deg generalizing G with
  | zero =>
    intro _ hMid_H1 hHigh hG_mid hFin_X _
    let I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
      CategoryTheory.Injective.under G
    let u : G ⟶ I := CategoryTheory.Injective.ι G
    let Q := CategoryTheory.Limits.cokernel u
    let v : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
    let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
    have hSE : SC.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel u) inferInstance inferInstance
    have hSurj_v0 : Function.Surjective
        ((CategoryTheory.Abelian.Ext.mk₀ v).postcomp (Fℤ_of X_U) (Nat.add_zero 0)) :=
      (hCokH1 X_U SC hSE).2 hG_mid
    obtain ⟨e_QG⟩ := hShiftEquiv X_U SC hSE 0
    have hCalc := hHDI_SE SC hSE (fun p hp => hInjHDIZero I p hp)
    have hZero_R1Q : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 Q) :=
      hCalc.2.2 1 (le_refl 1) hHigh

    let I' : CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
      CategoryTheory.Injective.under Q
    let u' : Q ⟶ I' := CategoryTheory.Injective.ι Q
    let Q' := CategoryTheory.Limits.cokernel u'
    let v' : I' ⟶ Q' := CategoryTheory.Limits.cokernel.π u'
    let SC' := CategoryTheory.ShortComplex.mk u' v' (CategoryTheory.Limits.cokernel.condition u')
    have hSE' : SC'.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel u') inferInstance inferInstance
    have hSE'_pf : (SC'.map pf_j).ShortExact :=
      (hHDI_SE SC' hSE' (fun p hp => hInjHDIZero I' p hp)).1.2 hZero_R1Q
    have : CategoryTheory.Injective (SC'.map pf_j).X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_j I'
    obtain ⟨⟨eqv_Q_U⟩, -⟩ := hCokH1 X_U SC' hSE'
    obtain ⟨⟨eqv_Q_X⟩, -⟩ := hCokH1 X (SC'.map pf_j) hSE'_pf
    let gU' := (CategoryTheory.Abelian.Ext.mk₀ SC'.g).postcomp (Fℤ_of X_U) (Nat.add_zero 0)
    let gX' := (CategoryTheory.Abelian.Ext.mk₀ (SC'.map pf_j).g).postcomp (Fℤ_of X) (Nat.add_zero 0)
    have hRangeMatch : ∀ x : (pf_j.obj Q').H 0, x ∈ gX'.range ↔ e_j0 Q' x ∈ gU'.range := by
      intro x
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨e_j0 I' y, (he_j0_nat v' y).symm⟩
      · rintro ⟨w, hw⟩
        refine ⟨(e_j0 I').symm w, (e_j0 Q').injective ?_⟩
        exact (he_j0_nat v' ((e_j0 I').symm w)).trans
          ((congrArg gU' ((e_j0 I').apply_symm_apply w)).trans hw)
    let lift_f : ((pf_j.obj Q').H 0 ⧸ gX'.range) →+ (Q'.H 0 ⧸ gU'.range) :=
      QuotientAddGroup.lift gX'.range
        ((QuotientAddGroup.mk' gU'.range).comp (e_j0 Q').toAddMonoidHom)
        (fun x hx => (QuotientAddGroup.eq_zero_iff _).mpr ((hRangeMatch x).mp hx))
    let lift_inv : (Q'.H 0 ⧸ gU'.range) →+ ((pf_j.obj Q').H 0 ⧸ gX'.range) :=
      QuotientAddGroup.lift gU'.range
        ((QuotientAddGroup.mk' gX'.range).comp (e_j0 Q').symm.toAddMonoidHom)
        (fun y hy => (QuotientAddGroup.eq_zero_iff _).mpr
          ((hRangeMatch _).mpr (by
            change (e_j0 Q') ((e_j0 Q').symm y) ∈ gU'.range
            rwa [(e_j0 Q').apply_symm_apply])))
    let eqv_quot : ((pf_j.obj Q').H 0 ⧸ gX'.range) ≃+ (Q'.H 0 ⧸ gU'.range) :=
      AddEquiv.mk'
        { toFun := lift_f
          invFun := lift_inv
          left_inv := fun q => by
            obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
            change QuotientAddGroup.mk' gX'.range ((e_j0 Q').symm (e_j0 Q' x)) = _
            rw [(e_j0 Q').symm_apply_apply]
            rfl
          right_inv := fun q => by
            obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective q
            change QuotientAddGroup.mk' gU'.range (e_j0 Q' ((e_j0 Q').symm y)) = _
            rw [(e_j0 Q').apply_symm_apply]
            rfl }
        lift_f.map_add
    let e_pfQ : (pf_j.obj Q).H 1 ≃+ G.H 2 :=
      ((eqv_Q_X.symm.trans eqv_quot).trans eqv_Q_U).trans e_QG

    obtain ⟨hEx_pf, hMono_f'⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_j).mp
        inferInstance SC hSE
    let f' : pf_j.obj G ⟶ pf_j.obj I := (SC.map pf_j).f
    let g' : pf_j.obj I ⟶ pf_j.obj Q := (SC.map pf_j).g
    have : CategoryTheory.Mono f' := hMono_f'
    let W := CategoryTheory.Limits.cokernel f'
    let SC_W1 := CategoryTheory.ShortComplex.mk f' (CategoryTheory.Limits.cokernel.π f')
      (CategoryTheory.Limits.cokernel.condition f')
    have hSE_W1 : SC_W1.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel f') inferInstance inferInstance
    have : CategoryTheory.Injective SC_W1.X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_j I
    obtain ⟨e_WG⟩ := hShiftEquiv X SC_W1 hSE_W1 0

    obtain ⟨δ₀, hcomp_δ, hEpi_δ₀, hEx_δ⟩ := hCalc.1.1
    have : CategoryTheory.Epi δ₀ := hEpi_δ₀
    have hSurj_g'0 : Function.Surjective
        ((CategoryTheory.Abelian.Ext.mk₀ g').postcomp (Fℤ_of X) (Nat.add_zero 0)) := by
      intro q
      obtain ⟨y, hy⟩ := hSurj_v0 (e_j0 Q q)
      refine ⟨(e_j0 I).symm y, (e_j0 Q).injective ?_⟩
      exact (he_j0_nat v ((e_j0 I).symm y)).trans
        ((congrArg _ ((e_j0 I).apply_symm_apply y)).trans hy)
    have hFin_W1 : Finite (W.H 1) := @Finite.of_equiv _ _ hFin_X e_WG.symm.toEquiv
    obtain ⟨hFin_R1, hCard_W⟩ :=
      hFourTermCardMul f' g' δ₀ (SC.map pf_j).zero hcomp_δ hEx_pf hEx_δ hSurj_g'0 hMid_H1 hFin_W1
    refine ⟨hFin_R1, ?_⟩
    calc Nat.card ((weilEtaleHigherDirectImage j 1 G).H 0) * Nat.card (G.H 2)
        = Nat.card ((weilEtaleHigherDirectImage j 1 G).H 0) * Nat.card ((pf_j.obj Q).H 1) := by
            rw [Nat.card_congr e_pfQ.toEquiv]
      _ = Nat.card (W.H 1) := hCard_W
      _ = Nat.card ((pf_j.obj G).H 2) := Nat.card_congr e_WG.toEquiv
  | succ m ih =>
    intro hLow hMid_H1 hHigh hG_mid hFin_X hFin_U
    let I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
      CategoryTheory.Injective.under G
    let u : G ⟶ I := CategoryTheory.Injective.ι G
    let Q := CategoryTheory.Limits.cokernel u
    let v : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
    let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
    have hSE : SC.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel u) inferInstance inferInstance
    have hCalc := hHDI_SE SC hSE (fun p hp => hInjHDIZero I p hp)
    have hSE_pf : (SC.map pf_j).ShortExact :=
      hCalc.1.2 (hLow 1 (le_refl 1) (Nat.le_add_left 1 m))
    have : CategoryTheory.Injective (SC.map pf_j).X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_j I
    obtain ⟨e_mid⟩ := hShiftEquiv X_U SC hSE m
    obtain ⟨e_QU⟩ := hShiftEquiv X_U SC hSE (m + 1)
    obtain ⟨e_QX⟩ := hShiftEquiv X (SC.map pf_j) hSE_pf (m + 1)
    obtain ⟨e_R⟩ := hCalc.2.1 (m + 1) (Nat.le_add_left 1 m)
    have hLow_Q : ∀ b : ℕ, 1 ≤ b → b ≤ m →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b Q) :=
      fun b hb1 hbm =>
        hCalc.2.2 b hb1 (hLow (b + 1) (Nat.le_add_left 1 b) (Nat.add_le_add_right hbm 1))
    have hMid_H1_Q : Subsingleton ((weilEtaleHigherDirectImage j (m + 1) Q).H 1) :=
      ⟨fun a b => (isoH X e_R.symm 1).injective (hMid_H1.elim _ _)⟩
    have hHigh_Q : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (m + 2) Q) :=
      hCalc.2.2 (m + 2) (Nat.le_add_left 1 (m + 1)) hHigh
    have hQ_mid : Subsingleton (Q.H (m + 1)) :=
      ⟨fun a b => e_mid.injective (hG_mid.elim _ _)⟩
    have hFin_QX : Finite ((pf_j.obj Q).H (m + 2)) := @Finite.of_equiv _ _ hFin_X e_QX.symm.toEquiv
    have hFin_QU : Finite (Q.H (m + 2)) := @Finite.of_equiv _ _ hFin_U e_QU.symm.toEquiv
    obtain ⟨hFin_RQ, hCard_RQ⟩ := ih Q hLow_Q hMid_H1_Q hHigh_Q hQ_mid hFin_QX hFin_QU
    refine ⟨@Finite.of_equiv _ _ hFin_RQ (isoH X e_R 0).symm.toEquiv, ?_⟩
    exact (congrArg₂ (· * ·)
        (Nat.card_congr (isoH X e_R 0).toEquiv)
        (Nat.card_congr e_QU.symm.toEquiv)).trans
      (hCard_RQ.trans (Nat.card_congr e_QX.toEquiv))

theorem weil_proj_quadric_prime_pow_skyscraper_stalk_card_and_tower_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ M_deg : ℕ) [Fact (Nat.Prime ℓ)]
    {X X_U : AlgebraicGeometry.Scheme.{u}}
    (j : X_U ⟶ X) [AlgebraicGeometry.IsOpenImmersion j]
    (i₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X) [AlgebraicGeometry.IsClosedImmersion i₀]
    (hBij0_aff :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ X) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j w) ℓ 0 ψ₀ →
        Function.Bijective ψ₀)
    (hZero_low :
      ∀ b : ℕ, 1 ≤ b → b ≤ M_deg →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf X_U ℓ)))
    (hZero_high :
      ∀ r q : ℕ, M_deg + 2 ≤ q →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j q (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1)))))
    (hSupp_mid :
      ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
        z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
        ∃ (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback z_bar
            (weilEtaleHigherDirectImage j (M_deg + 1) (weilEtaleTorsionSheaf X_U ℓ)) H_z ∧
          CategoryTheory.Limits.IsZero H_z)
    (hMid_XU : Subsingleton (weilEtaleTorsionH X_U ℓ (M_deg + 1)))
    (hCard_top :
      Finite (weilEtaleTorsionH X ℓ (M_deg + 2)) ∧
      Finite (weilEtaleTorsionH X_U ℓ (M_deg + 2)) ∧
      Nat.card (weilEtaleTorsionH X ℓ (M_deg + 2)) = ℓ ^ 2 ∧
      Nat.card (weilEtaleTorsionH X_U ℓ (M_deg + 2)) = ℓ) :
    (∀ (r : ℕ) (W : X.Etale)
        (p_W0 : weilEtaleTorsionH
            ((AlgebraicGeometry.Scheme.Etale.forget X).obj W).left (ℓ ^ (r + 1)) 0 →+
          weilEtaleTorsionH
            ((AlgebraicGeometry.Scheme.Etale.forget X_U).obj
              ((weilEtaleSitePullback j).obj W)).left (ℓ ^ (r + 1)) 0),
      WeilIsTorsionEtalePullback
        (CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget X).obj W).hom j)
        (ℓ ^ (r + 1)) 0 p_W0 →
      Function.Bijective p_W0) ∧
    ∀ (hCont_o : (weilEtaleSitePullback i₀).IsContinuous
        X.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
      (hAdj_o : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
        X.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        hCont_o).IsRightAdjoint),
      let pb_o := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
        X.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        hCont_o hAdj_o
      (∀ (r q : ℕ), 1 ≤ q → q ≠ M_deg + 1 →
        CategoryTheory.Limits.IsZero
          (pb_o.obj (weilEtaleHigherDirectImage j q
