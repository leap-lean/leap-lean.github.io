        intro k hk
        dsimp [emb_fn, ru, iu_gt]
        split_ifs with h
        · omega
        · apply Fin.ext; dsimp; omega
      have h_emb_rv : ∀ (k : Fin (m + 1)) (hk : j.1 < k.1), emb_fn (rv k hk) = iv_gt k hk := by
