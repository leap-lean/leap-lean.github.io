      have : Unique ↥((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj T_Z0).left :=
        (inferInstance : Unique (PrimeSpectrum K))
      let e_lc : ZMod ℓ ≃
          LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Z₀.left).obj T_Z0).left ↥A_M :=
        { toFun := fun c => LocallyConstant.const _ (ULift.up c)
