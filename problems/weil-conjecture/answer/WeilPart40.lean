  have hα_cond : (h ≫ φ₂.inv) ≫ g₂_hom = 𝟙 Z₁ ≫ h :=
    (CategoryTheory.Category.assoc h φ₂.inv g₂_hom).trans
      ((congrArg (h ≫ ·) (hφ₂_hom ▸ φ₂.inv_hom_id)).trans
        ((CategoryTheory.Category.comp_id h).trans (CategoryTheory.Category.id_comp h).symm))
  let α_inv : Z₁ ⟶ P_pb :=
    CategoryTheory.Limits.pullback.lift (h ≫ φ₂.inv) (𝟙 Z₁) hα_cond
  have hα_inv_hom : α_inv ≫ α_hom = 𝟙 Z₁ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_g₂_inv : g₂_hom ≫ φ₂.inv = 𝟙 (Fgt₂.obj T₂).left := by
    rw [← hφ₂_hom]
    exact φ₂.hom_inv_id
  have hα_hom_inv : α_hom ≫ α_inv = 𝟙 P_pb := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, h_g₂_inv, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  have hsq : (α_inv ≫ CategoryTheory.Limits.pullback.fst g₂_hom h) ≫ φ₂.hom = h := by
    rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
      φ₂.inv_hom_id, CategoryTheory.Category.comp_id]
  let L₂ : LocallyConstant ↥Z₂ ↥A_m ≃ LocallyConstant ↥(Fgt₂.obj T₂).left ↥A_m :=
    { toFun := fun g₀ => g₀.comap φ₂.hom.base.hom
      invFun := fun g => g.comap φ₂.inv.base.hom
      left_inv := fun g₀ => by
        ext z
        change g₀ ((φ₂.inv ≫ φ₂.hom).base z) = g₀ z
        rw [φ₂.inv_hom_id]
        rfl
      right_inv := fun g => by
        ext z
        change g ((φ₂.hom ≫ φ₂.inv).base z) = g z
        rw [φ₂.hom_inv_id]
        rfl }
  let L₁ : LocallyConstant ↥P_pb ↥A_m ≃ LocallyConstant ↥Z₁ ↥A_m :=
    { toFun := fun k => k.comap α_inv.base.hom
      invFun := fun k₀ => k₀.comap α_hom.base.hom
      left_inv := fun k => by
        ext z
        change k ((α_hom ≫ α_inv).base z) = k z
        rw [hα_hom_inv]
        rfl
      right_inv := fun k₀ => by
        ext z
        change k₀ ((α_inv ≫ α_hom).base z) = k₀ z
        rw [hα_inv_hom]
        rfl }
  let pbFn := fun g : LocallyConstant ↥(Fgt₂.obj T₂).left ↥A_m =>
    g.comap (CategoryTheory.Limits.pullback.fst g₂_hom h).base.hom
  let hFn := fun g₀ : LocallyConstant ↥Z₂ ↥A_m => g₀.comap h.base.hom
  have hTrans : hFn = (⇑L₁ ∘ pbFn) ∘ ⇑L₂ := by
    funext g₀
    ext z₁
    change g₀ (h.base z₁) =
      g₀ (((α_inv ≫ CategoryTheory.Limits.pullback.fst g₂_hom h) ≫ φ₂.hom).base z₁)
