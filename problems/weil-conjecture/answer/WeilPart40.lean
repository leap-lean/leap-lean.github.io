      have h2 : ((AlgebraicGeometry.Spec.map β).base pt_K).asIdeal =
          Ideal.comap β.hom pt_K.asIdeal := rfl
      rw [AlgebraicGeometry.Spec.map_preimage] at h1 h2
      rw [RingHom.ker_eq_comap_bot, RingHom.ker_eq_comap_bot, ← hpt_k_bot, ← hpt_K_bot,
        ← h1, ← h2, h_aff_pt]
