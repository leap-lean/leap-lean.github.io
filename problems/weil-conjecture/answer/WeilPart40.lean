  let U_bar : D_bar_ov.left.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  have hBotPrime : ∀ (K₀ : Type u) [Field K₀] (p : PrimeSpectrum K₀), p.asIdeal = ⊥ := by
    intro K₀ _ p
    refine Ideal.ext fun x => ⟨fun hx => ?_, fun hx => ?_⟩
    · rw [Ideal.mem_bot]
      by_contra hx0
