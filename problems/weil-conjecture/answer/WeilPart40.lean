  classical
  intro pf_j Fℤ_X
  haveI : pf_j.Additive := inferInstance
  let Fℤ_U := (CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))

  have hPostComp : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] (Z₀ : 𝒞) {A B D : 𝒞} (α : A ⟶ B) (β : B ⟶ D)
      (q : ℕ) (x : CategoryTheory.Abelian.Ext.{u} Z₀ A q),
      (CategoryTheory.Abelian.Ext.mk₀ β).postcomp Z₀ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀ α).postcomp Z₀ (Nat.add_zero q) x) =
      (CategoryTheory.Abelian.Ext.mk₀ (α ≫ β)).postcomp Z₀ (Nat.add_zero q) x := by
    intro 𝒞 _ _ _ Z₀ A B D α β q x
    change (x.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β) (Nat.add_zero q) =
      x.comp (CategoryTheory.Abelian.Ext.mk₀ (α ≫ β)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  have hPostId : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] (Z₀ A : 𝒞) (q : ℕ)
      (x : CategoryTheory.Abelian.Ext.{u} Z₀ A q),
      (CategoryTheory.Abelian.Ext.mk₀ (𝟙 A)).postcomp Z₀ (Nat.add_zero q) x = x :=
    fun _ _ _ x => CategoryTheory.Abelian.Ext.comp_mk₀_id x

  have hPostZero : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] (Z₀ A B : 𝒞) (q : ℕ)
      (x : CategoryTheory.Abelian.Ext.{u} Z₀ A q),
      (CategoryTheory.Abelian.Ext.mk₀ (0 : A ⟶ B)).postcomp Z₀ (Nat.add_zero q) x = 0 := by
    intro 𝒞 _ _ _ Z₀ A B q x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : A ⟶ B)) (Nat.add_zero q) = 0
    rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hExt0_inj_of_mono : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] (Z₀ : 𝒞) {A B : 𝒞} (f : A ⟶ B) [CategoryTheory.Mono f],
      Function.Injective ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp Z₀ (Nat.add_zero 0)) := by
    intro 𝒞 _ _ _ Z₀ A B f _
    rw [injective_iff_map_eq_zero]
    intro w hw
    change w.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero 0) = 0 at hw
    let g : Z₀ ⟶ A := CategoryTheory.Abelian.Ext.addEquiv₀ w
    have hg : CategoryTheory.Abelian.Ext.mk₀ g = w :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w
    rw [← hg, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← CategoryTheory.Abelian.Ext.mk₀_zero] at hw
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply] at hw
    have hgf : g ≫ f = 0 := CategoryTheory.Abelian.Ext.addEquiv₀.symm.injective hw
    have hg0 : g = 0 :=
      (CategoryTheory.cancel_mono f).mp (hgf.trans CategoryTheory.Limits.zero_comp.symm)
    rw [← hg, hg0, CategoryTheory.Abelian.Ext.mk₀_zero]

  have hConnInjMid : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] (Z₀ : 𝒞) {S : CategoryTheory.ShortComplex 𝒞}
      (hS : S.ShortExact) [CategoryTheory.Injective S.X₂],
      Function.Surjective (hS.extClass.postcomp Z₀ (rfl : 0 + 1 = 1)) ∧
      AddMonoidHom.ker (hS.extClass.postcomp Z₀ (rfl : 0 + 1 = 1)) =
        AddMonoidHom.range ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp Z₀ (Nat.add_zero 0)) ∧
      Function.Bijective (hS.extClass.postcomp Z₀ (rfl : 1 + 1 = 2)) := by
    intro 𝒞 _ _ _ Z₀ S hS _
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro x₁
      have h0 : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective
          (x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero 1))
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z₀ hS x₁ h0 (rfl : 0 + 1 = 1)
    · ext x₃
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
      constructor
      · intro hx₃
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z₀ hS x₃ (rfl : 0 + 1 = 1) hx₃
      · rintro ⟨x₂, rfl⟩
        change (x₂.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero 0)).comp
          hS.extClass (rfl : 0 + 1 = 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
          CategoryTheory.ShortComplex.ShortExact.comp_extClass hS,
          CategoryTheory.Abelian.Ext.comp_zero]
    · rw [injective_iff_map_eq_zero]
      intro x₃ hx₃
      obtain ⟨x₂, hx₂⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z₀ hS x₃ (rfl : 1 + 1 = 2) hx₃
      have hx₂0 : x₂ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective x₂
      rw [← hx₂, hx₂0, CategoryTheory.Abelian.Ext.zero_comp]
    · intro x₁
      have h0 : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero 2) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective
          (x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero 2))
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z₀ hS x₁ h0 (rfl : 1 + 1 = 2)

  have hEdge1_bij : ∀ (G : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 G) →
      Function.Bijective (edge G 1) := by
    intro G hZ₁
    let I_G := CategoryTheory.Injective.under G
    let ι_G : G ⟶ I_G := CategoryTheory.Injective.ι G
    let Q_G := CategoryTheory.Limits.cokernel ι_G
    let π_G : I_G ⟶ Q_G := CategoryTheory.Limits.cokernel.π ι_G
    let SC_G := CategoryTheory.ShortComplex.mk ι_G π_G (CategoryTheory.Limits.cokernel.condition ι_G)
    have hSE_G : SC_G.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel ι_G) inferInstance inferInstance
    have hSE_G_pf : (SC_G.map pf_j).ShortExact := (hδ₀_props SC_G hSE_G).2.2.1 hZ₁
    haveI : CategoryTheory.Injective (SC_G.map pf_j).X₂ := (hInjAdj I_G).1
    haveI : CategoryTheory.Injective SC_G.X₂ := inferInstance
    let d_X := hSE_G_pf.extClass.postcomp Fℤ_X (rfl : 0 + 1 = 1)
    let d_U := hSE_G.extClass.postcomp Fℤ_U (rfl : 0 + 1 = 1)
    obtain ⟨hSurj_X, hKer_X, _⟩ := hConnInjMid Fℤ_X hSE_G_pf
