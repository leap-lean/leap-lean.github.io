    (Q_t : AlgebraicGeometry.Scheme.{u})
    (ι_Qt : Q_t ⟶ (weilProjectiveSpaceOver K (2 * m + 2)).left)
    [AlgebraicGeometry.IsClosedImmersion ι_Qt]
    (hPres_Qt :
      let N := 2 * m + 2
      let u_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let v_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1 + 1, Nat.succ_lt_succ (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let w_idx : Fin (N + 1) := Fin.last N
      let g_Qt : ∀ a : Fin (N + 1), Fin 1 →
          ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K N a))) :=
        fun a _ =>
          (∑ j : Fin (m + 1), t_K a (u_idx j) * t_K a (v_idx j)) -
            c_K a t * (t_K a w_idx) ^ 2
      ∀ a : Fin (N + 1),
        let O_a : Q_t.Opens :=
          (TopologicalSpace.Opens.map ι_Qt.base).obj (weilProjBasicOpen K N a)
        ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑((weilProjectiveSpaceOver K N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K N a))) ⧸
              Ideal.span (Set.range (g_Qt a)))),
          O_a.ι ≫ ι_Qt =
            e_a.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
              (hAff_K a).fromSpec)
    (ι_Pi_amb_K : (weilProjectiveSpaceOver K m).left ⟶ (weilProjectiveSpaceOver K (2 * m + 2)).left)
    [AlgebraicGeometry.IsClosedImmersion ι_Pi_amb_K]
    (hPres_PiK :
      let N := 2 * m + 2
      let u_idx : Fin (m + 1) → Fin (N + 1) :=
        fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
      let w_idx : Fin (N + 1) := Fin.last N
      ∀ a : Fin (N + 1),
        let g_Pi_K : Fin (m + 2) →
            ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K N a))) :=
          fun ν => Fin.lastCases (t_K a w_idx) (fun j => t_K a (u_idx j)) ν
        let O_Pi : (weilProjectiveSpaceOver K m).left.Opens :=
          (TopologicalSpace.Opens.map ι_Pi_amb_K.base).obj (weilProjBasicOpen K N a)
        ∃ e_Pi : O_Pi.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑((weilProjectiveSpaceOver K N).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K N a))) ⧸
              Ideal.span (Set.range g_Pi_K))),
          O_Pi.ι ≫ ι_Pi_amb_K =
            e_Pi.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
              (hAff_K a).fromSpec) :
    (∃ (Z : Fin (m + 3) → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
       (ι_step : ∀ s : Fin (m + 2), Z s.succ ⟶ Z s.castSucc)
       (U_step : ∀ s : Fin (m + 2), (Z s.castSucc).left.Opens)
       (ι_tot : ∀ s : Fin (m + 3), (Z s).left ⟶ Q_t)
       (e_bot : (weilProjectiveSpaceOver K m).left ≅ (Z (Fin.last (m + 2))).left),
       (∀ s : Fin (m + 3), AlgebraicGeometry.IsProper (Z s).hom) ∧
       (∀ s : Fin (m + 2), AlgebraicGeometry.IsClosedImmersion (ι_step s).left) ∧
       (∀ s : Fin (m + 2),
         Set.range (ι_step s).left.base = (U_step s : Set ↥(Z s.castSucc).left)ᶜ) ∧
       (∀ j : Fin (m + 1),
         ∃ e_U : (U_step j.castSucc).toScheme ≅ (weilAffineSpaceOver K (2 * m + 1 - j.1)).left,
           e_U.hom ≫ (weilAffineSpaceOver K (2 * m + 1 - j.1)).hom =
             (U_step j.castSucc).ι ≫ (Z j.castSucc.castSucc).hom) ∧
       (t ≠ 0 → IsEmpty ↥(U_step (Fin.last (m + 1)))) ∧
       (t = 0 →
         ∃ e_top : (U_step (Fin.last (m + 1))).toScheme ≅ (weilAffineSpaceOver K (m + 1)).left,
           e_top.hom ≫ (weilAffineSpaceOver K (m + 1)).hom =
             (U_step (Fin.last (m + 1))).ι ≫ (Z (Fin.last (m + 1)).castSucc).hom) ∧
       CategoryTheory.IsIso (ι_tot 0) ∧
       (∀ s : Fin (m + 2), ι_tot s.succ = (ι_step s).left ≫ ι_tot s.castSucc) ∧
       (e_bot.hom ≫ ι_tot (Fin.last (m + 2))) ≫ ι_Qt = ι_Pi_amb_K) ∧
    (∃ (P_step : Fin (m + 1) → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
       (κ_step : ∀ s : Fin m, P_step s.succ ⟶ P_step s.castSucc)
       (V_step : ∀ s : Fin m, (P_step s.castSucc).left.Opens)
       (κ_tot : ∀ s : Fin (m + 1), (P_step s).left ⟶ (weilProjectiveSpaceOver K m).left),
       (∀ s : Fin (m + 1), AlgebraicGeometry.IsProper (P_step s).hom) ∧
       (∀ s : Fin m, AlgebraicGeometry.IsClosedImmersion (κ_step s).left) ∧
       CategoryTheory.IsIso (P_step (Fin.last m)).hom ∧
       (∀ s : Fin m,
         Set.range (κ_step s).left.base = (V_step s : Set ↥(P_step s.castSucc).left)ᶜ) ∧
       (∀ s : Fin m,
         ∃ e_V : (V_step s).toScheme ≅ (weilAffineSpaceOver K (m - s.1)).left,
           e_V.hom ≫ (weilAffineSpaceOver K (m - s.1)).hom =
             (V_step s).ι ≫ (P_step s.castSucc).hom) ∧
       CategoryTheory.IsIso (κ_tot 0) ∧
       (∀ s : Fin m, κ_tot s.succ = (κ_step s).left ≫ κ_tot s.castSucc)) :=
by
  classical

  
  
  
  have hMvPolyQuotEquiv : ∀ (M d : ℕ) (J : Ideal (MvPolynomial (Fin M) K))
      (emb_fn : Fin d → Fin M) (ψ_fn : Fin M → MvPolynomial (Fin d) K),
      (∀ x ∈ J, MvPolynomial.aeval ψ_fn x = 0) →
      (∀ r : Fin d, ψ_fn (emb_fn r) = MvPolynomial.X r) →
      (∀ i : Fin M, MvPolynomial.X i - MvPolynomial.rename emb_fn (ψ_fn i) ∈ J) →
      ∃ Φ : MvPolynomial (Fin d) K ≃+* (MvPolynomial (Fin M) K ⧸ J),
        Φ.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk J).comp MvPolynomial.C := by
    clear * -
    intro M d J emb_fn ψ_fn h_vanish h_left h_right
    let emb : MvPolynomial (Fin d) K →ₐ[K] MvPolynomial (Fin M) K := MvPolynomial.rename emb_fn
    let φ : MvPolynomial (Fin d) K →ₐ[K] (MvPolynomial (Fin M) K ⧸ J) :=
      (Ideal.Quotient.mkₐ K J).comp emb
    let ψ₀ : MvPolynomial (Fin M) K →ₐ[K] MvPolynomial (Fin d) K := MvPolynomial.aeval ψ_fn
    let ψ : (MvPolynomial (Fin M) K ⧸ J) →ₐ[K] MvPolynomial (Fin d) K :=
      Ideal.Quotient.liftₐ J ψ₀ h_vanish
    have h_ψ_mk : ∀ p : MvPolynomial (Fin M) K, ψ (Ideal.Quotient.mk J p) = ψ₀ p :=
      fun _ => rfl
    have h_ψφ : ψ.comp φ = AlgHom.id K (MvPolynomial (Fin d) K) := by
      apply MvPolynomial.algHom_ext
      intro r
      change ψ (Ideal.Quotient.mk J ((MvPolynomial.rename emb_fn) (MvPolynomial.X r))) =
        MvPolynomial.X r
      rw [h_ψ_mk]
      change MvPolynomial.aeval ψ_fn ((MvPolynomial.rename emb_fn) (MvPolynomial.X r)) =
        MvPolynomial.X r
      rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, h_left r]
    have h_φψ : φ.comp ψ = AlgHom.id K (MvPolynomial (Fin M) K ⧸ J) := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro i
      change φ (ψ (Ideal.Quotient.mk J (MvPolynomial.X i))) =
        Ideal.Quotient.mk J (MvPolynomial.X i)
      rw [h_ψ_mk]
      change Ideal.Quotient.mk J (emb (MvPolynomial.aeval ψ_fn (MvPolynomial.X i))) =
        Ideal.Quotient.mk J (MvPolynomial.X i)
      rw [MvPolynomial.aeval_X]
      symm
      rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact h_right i
    let e_alg : MvPolynomial (Fin d) K ≃ₐ[K] (MvPolynomial (Fin M) K ⧸ J) :=
      AlgEquiv.ofAlgHom φ ψ h_φψ h_ψφ
    exact ⟨e_alg.toRingEquiv, RingHom.ext fun k => e_alg.commutes k⟩

  
  
  
  let PresDatum (M : ℕ) : Type (u + 1) :=
    Σ (W : AlgebraicGeometry.Scheme.{u})
      (_ : W ⟶ (weilProjectiveSpaceOver K M).left)
      (L : ℕ),
      (∀ a : Fin (M + 1), Fin L →
        ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K M a))))

  let chartIdeal (M : ℕ) (D : PresDatum M) (a : Fin (M + 1)) :
      Ideal ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))) :=
    Ideal.span (Set.range (D.2.2.2 a))

  let polyIdeal (M : ℕ)
      (θ_M : ∀ a : Fin (M + 1),
        MvPolynomial (Fin M) K ≃+*
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))))
      (D : PresDatum M) (a : Fin (M + 1)) : Ideal (MvPolynomial (Fin M) K) :=
    Ideal.span (Set.range (fun ν : Fin D.2.2.1 => (θ_M a).symm (D.2.2.2 a ν)))

  let IsValidPresDatum (M : ℕ)
      (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
      (D : PresDatum M) : Prop :=
    AlgebraicGeometry.IsClosedImmersion D.2.1 ∧
    ∀ a : Fin (M + 1),
      let O_a : D.1.Opens :=
        (TopologicalSpace.Opens.map D.2.1.base).obj (weilProjBasicOpen K M a)
      ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
          (↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))) ⧸
            Ideal.span (Set.range (D.2.2.2 a)))),
        O_a.ι ≫ D.2.1 =
          e_a.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
            (hAff_M a).fromSpec

  
  have hIdPresDatum : ∀ (M : ℕ)
      (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a)),
      IsValidPresDatum M hAff_M
        ⟨(weilProjectiveSpaceOver K M).left,
         𝟙 (weilProjectiveSpaceOver K M).left,
         0,
         fun _ => Fin.elim0⟩ := by
    clear * -
    intro M hAff_M
    let P_M := (weilProjectiveSpaceOver K M).left
    refine ⟨by change AlgebraicGeometry.IsClosedImmersion (𝟙 P_M); infer_instance, fun a => ?_⟩
    let D_a := weilProjBasicOpen K M a
    let R_a := ↑(P_M.presheaf.obj (Opposite.op D_a))
    let g_zero : Fin 0 → R_a := Fin.elim0
    let I_0 : Ideal R_a := Ideal.span (Set.range g_zero)
    have hI0 : I_0 = ⊥ := by simp [I_0, g_zero]
    let q_mk : R_a →+* (R_a ⧸ I_0) := Ideal.Quotient.mk I_0
    have hq_inj : Function.Injective q_mk :=
      (RingHom.injective_iff_ker_eq_bot q_mk).mpr (by rw [Ideal.mk_ker, hI0])
    let e_ring : R_a ≃+* (R_a ⧸ I_0) :=
      RingEquiv.ofBijective q_mk ⟨hq_inj, Ideal.Quotient.mk_surjective⟩
    let e_spec : AlgebraicGeometry.Spec (CommRingCat.of R_a) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (R_a ⧸ I_0)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_mk)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          convert AlgebraicGeometry.Spec.map_id (CommRingCat.of R_a)
          apply CommRingCat.hom_ext
          ext x
          exact e_ring.symm_apply_apply x
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          convert AlgebraicGeometry.Spec.map_id (CommRingCat.of (R_a ⧸ I_0))
          apply CommRingCat.hom_ext
          ext y
          exact e_ring.apply_symm_apply y }
    refine ⟨(hAff_M a).isoSpec ≪≫ e_spec, ?_⟩
    change D_a.ι ≫ 𝟙 P_M =
      ((hAff_M a).isoSpec.hom ≫ e_spec.hom) ≫ e_spec.inv ≫ (hAff_M a).fromSpec
    rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc e_spec.hom, e_spec.hom_inv_id,
      CategoryTheory.Category.id_comp, (hAff_M a).isoSpec_hom, (hAff_M a).toSpecΓ_fromSpec]

  
  have hComplBridge : ∀ (M : ℕ)
      (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
      (c_M : ∀ a : Fin (M + 1),
        K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K M a))))
      (t_M : ∀ a : Fin (M + 1), Fin (M + 1) →
        ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K M a)))),
      IsCommRingProjCoordSystem K M hAff_M c_M t_M →
      ∀ (D D' : PresDatum M),
        IsValidPresDatum M hAff_M D →
        IsValidPresDatum M hAff_M D' →
        ∀ (j_sub : D'.1 ⟶ D.1),
          j_sub ≫ D.2.1 = D'.2.1 →
          ∀ (c₀ : Fin (M + 1)),
            (∀ a : Fin (M + 1),
              chartIdeal M D' a = chartIdeal M D a ⊔ Ideal.span {t_M a c₀}) →
            let U : D.1.Opens :=
              (TopologicalSpace.Opens.map D.2.1.base).obj (weilProjBasicOpen K M c₀)
            Set.range j_sub.base = (U : Set ↥D.1)ᶜ := by
    clear * -
    intro M hAff_M c_M t_M hCoord_M D D' hVD hVD' j_sub hj_sub c₀ hI_step U
    rcases hCoord_M with ⟨_, hSup_M, _, _, _, _, _, hBasic_inf, _, _⟩
    let P_M := (weilProjectiveSpaceOver K M).left
    let D_open := fun a : Fin (M + 1) => weilProjBasicOpen K M a
    let R_a := fun a : Fin (M + 1) => P_M.presheaf.obj (Opposite.op (D_open a))
    have : AlgebraicGeometry.IsClosedImmersion D.2.1 := hVD.1
    have : AlgebraicGeometry.IsClosedImmersion D'.2.1 := hVD'.1
    ext z
    simp only [Set.mem_range, Set.mem_compl_iff, SetLike.mem_coe]
    have htop : D.2.1.base z ∈ (⊤ : P_M.Opens) := trivial
    rw [← hSup_M, TopologicalSpace.Opens.mem_iSup] at htop
    obtain ⟨a, hz_Da⟩ := htop
    let O_a : D.1.Opens := (TopologicalSpace.Opens.map D.2.1.base).obj (D_open a)
    have hz_Oa : z ∈ (O_a : Set ↥D.1) := hz_Da
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hz_Oa
    obtain ⟨z₀, hz₀⟩ := hz_Oa
    obtain ⟨e_a, he_a⟩ := hVD.2 a
    obtain ⟨e'_a, he'_a⟩ := hVD'.2 a
    let I_a : Ideal ↑(R_a a) := Ideal.span (Set.range (D.2.2.2 a))
    let I'_a : Ideal ↑(R_a a) := Ideal.span (Set.range (D'.2.2.2 a))
    let q_z : PrimeSpectrum (↑(R_a a) ⧸ I_a) := e_a.hom.base z₀
    let P_z : PrimeSpectrum ↑(R_a a) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I_a))).base q_z
    have hPz_map : (hAff_M a).fromSpec.base P_z = D.2.1.base z := by
      have h1 := congrArg (fun f : O_a.toScheme ⟶ P_M => f.base z₀) he_a
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
      exact h1.symm.trans (congrArg D.2.1.base hz₀)
    have hIa_le : I_a ≤ P_z.asIdeal := by
      intro x hx
      change Ideal.Quotient.mk I_a x ∈ q_z.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact q_z.asIdeal.zero_mem
    have hz_in_U : z ∈ U ↔ t_M a c₀ ∉ P_z.asIdeal := by
      change D.2.1.base z ∈ D_open c₀ ↔ _
      have hinf : D.2.1.base z ∈ D_open c₀ ↔
          D.2.1.base z ∈ (D_open a ⊓ D_open c₀ : P_M.Opens) :=
        ⟨fun h => ⟨hz_Da, h⟩, fun h => h.2⟩
      rw [hinf, ← hBasic_inf a c₀, ← hPz_map]
      have hpre : (hAff_M a).fromSpec.base P_z ∈ P_M.basicOpen (t_M a c₀) ↔
          (P_z : ↥(AlgebraicGeometry.Spec (R_a a))) ∈
            ((TopologicalSpace.Opens.map (hAff_M a).fromSpec.base).obj
              (P_M.basicOpen (t_M a c₀))) := Iff.rfl
      rw [hpre, (hAff_M a).fromSpec_preimage_basicOpen (t_M a c₀)]
      exact PrimeSpectrum.mem_basicOpen (t_M a c₀) P_z
    rw [hz_in_U, not_not]
    constructor
    · rintro ⟨w, hw⟩
      have hw_Z' : D'.2.1.base w = D.2.1.base z := by
        rw [← hj_sub, AlgebraicGeometry.Scheme.Hom.comp_apply, hw]
      let O'_a : D'.1.Opens := (TopologicalSpace.Opens.map D'.2.1.base).obj (D_open a)
      have hw_Oa : w ∈ (O'_a : Set ↥D'.1) := by
        change D'.2.1.base w ∈ D_open a
        rw [hw_Z']
        exact hz_Da
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hw_Oa
      obtain ⟨w₀, hw₀⟩ := hw_Oa
      let q'_w : PrimeSpectrum (↑(R_a a) ⧸ I'_a) := e'_a.hom.base w₀
      let P'_w : PrimeSpectrum ↑(R_a a) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I'_a))).base q'_w
      have hP'w_map : (hAff_M a).fromSpec.base P'_w = D.2.1.base z := by
        have h1 := congrArg (fun f : O'_a.toScheme ⟶ P_M => f.base w₀) he'_a
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
          AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
        exact h1.symm.trans ((congrArg D'.2.1.base hw₀).trans hw_Z')
      have hP_eq : P'_w = P_z :=
        (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding (hAff_M a).fromSpec).injective
          (hP'w_map.trans hPz_map.symm)
      have ht_in_I' : t_M a c₀ ∈ I'_a := by
        change t_M a c₀ ∈ chartIdeal M D' a
        rw [hI_step a]
        exact Ideal.mem_sup_right (Ideal.subset_span rfl)
      rw [← hP_eq]
      change Ideal.Quotient.mk I'_a (t_M a c₀) ∈ q'_w.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ht_in_I']
      exact q'_w.asIdeal.zero_mem
    · intro ht_mem
      have hI'_le : I'_a ≤ P_z.asIdeal := by
        change chartIdeal M D' a ≤ P_z.asIdeal
        rw [hI_step a]
        exact sup_le hIa_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_mem))
      have hPz_zl :
          P_z ∈ PrimeSpectrum.zeroLocus (RingHom.ker (Ideal.Quotient.mk I'_a) : Set ↑(R_a a)) := by
        rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.mk_ker]
        exact hI'_le
      rw [← range_comap_of_surjective _ (Ideal.Quotient.mk I'_a)
        Ideal.Quotient.mk_surjective] at hPz_zl
      obtain ⟨q', hq'⟩ := hPz_zl
      have hq'_spec :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I'_a))).base q' =
            P_z :=
        PrimeSpectrum.ext (congrArg PrimeSpectrum.asIdeal hq')
      let O'_a : D'.1.Opens := (TopologicalSpace.Opens.map D'.2.1.base).obj (D_open a)
      let w₀ : ↥O'_a.toScheme := e'_a.inv.base q'
      let w : ↥D'.1 := O'_a.ι.base w₀
      have hw₀_hom : e'_a.hom.base w₀ = q' := by
        change (e'_a.inv ≫ e'_a.hom).base q' = q'
        rw [e'_a.inv_hom_id]
        rfl
      have hw_Z' : D'.2.1.base w = D.2.1.base z := by
        have h1 := congrArg (fun f : O'_a.toScheme ⟶ P_M => f.base w₀) he'_a
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
          AlgebraicGeometry.Scheme.Hom.comp_apply, hw₀_hom] at h1
        exact (h1.trans (congrArg (hAff_M a).fromSpec.base hq'_spec)).trans hPz_map
      refine ⟨w, ?_⟩
      apply (AlgebraicGeometry.Scheme.Hom.isClosedEmbedding D.2.1).injective
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hj_sub, hw_Z']

  
  have hChartPolyBridge : ∀ (M : ℕ)
      (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
      (c_M : ∀ a : Fin (M + 1),
        K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K M a))))
      (t_M : ∀ a : Fin (M + 1), Fin (M + 1) →
        ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K M a))))
      (θ_M : ∀ a : Fin (M + 1),
        MvPolynomial (Fin M) K ≃+*
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
      IsCommRingProjCoordSystem K M hAff_M c_M t_M →
      (∀ a : Fin (M + 1),
        (θ_M a).toRingHom.comp MvPolynomial.C = c_M a ∧
        ∀ i : Fin M, θ_M a (MvPolynomial.X i) = t_M a (a.succAbove i)) →
      ∀ (D : PresDatum M),
        IsValidPresDatum M hAff_M D →
        ∀ (a₀ : Fin (M + 1)),
          let O_a₀ : D.1.Opens :=
            (TopologicalSpace.Opens.map D.2.1.base).obj (weilProjBasicOpen K M a₀)
          (((1 : MvPolynomial (Fin M) K) ∈ polyIdeal M θ_M D a₀) → IsEmpty ↥O_a₀) ∧
          (∀ (d : ℕ)
             (Φ : MvPolynomial (Fin d) K ≃+* (MvPolynomial (Fin M) K ⧸ polyIdeal M θ_M D a₀)),
            Φ.toRingHom.comp MvPolynomial.C =
              (Ideal.Quotient.mk (polyIdeal M θ_M D a₀)).comp MvPolynomial.C →
            ∃ e_U : O_a₀.toScheme ≅ (weilAffineSpaceOver K d).left,
              e_U.hom ≫ (weilAffineSpaceOver K d).hom =
                O_a₀.ι ≫ (D.2.1 ≫ (weilProjectiveSpaceOver K M).hom)) ∧
          ((∀ a : Fin (M + 1), a ≠ a₀ → (1 : MvPolynomial (Fin M) K) ∈ polyIdeal M θ_M D a) →
           ∀ (Φ₀ : K ≃+* (MvPolynomial (Fin M) K ⧸ polyIdeal M θ_M D a₀)),
             Φ₀.toRingHom =
               (Ideal.Quotient.mk (polyIdeal M θ_M D a₀)).comp MvPolynomial.C →
             CategoryTheory.IsIso (D.2.1 ≫ (weilProjectiveSpaceOver K M).hom)) := by
    clear * - chartIdeal
    intro M hAff_M c_M t_M θ_M hCoord_M hθ_M D hVD a₀ O_a₀
    rcases hCoord_M with ⟨_, hSup_M, hFromSpec_hom, _, _, _, _, _, _, _⟩
    let P_M := (weilProjectiveSpaceOver K M).left
    let D_open := fun a : Fin (M + 1) => weilProjBasicOpen K M a
    let R_a := fun a : Fin (M + 1) => ↑(P_M.presheaf.obj (Opposite.op (D_open a)))
    have hMap_eq : ∀ a : Fin (M + 1),
        chartIdeal M D a = Ideal.map (θ_M a).toRingHom (polyIdeal M θ_M D a) := by
      intro a
      dsimp only [chartIdeal, polyIdeal]
      rw [Ideal.map_span, ← Set.range_comp]
      congr 1
      ext ν
      simp [(θ_M a).apply_symm_apply]
    let θ_quot : ∀ a : Fin (M + 1),
        (MvPolynomial (Fin M) K ⧸ polyIdeal M θ_M D a) ≃+* (R_a a ⧸ chartIdeal M D a) :=
      fun a => Ideal.quotientEquiv (polyIdeal M θ_M D a) (chartIdeal M D a) (θ_M a) (hMap_eq a)
    have hθ_quot_C : ∀ (a : Fin (M + 1)) (k : K),
        θ_quot a (Ideal.Quotient.mk (polyIdeal M θ_M D a) (MvPolynomial.C k)) =
          Ideal.Quotient.mk (chartIdeal M D a) (c_M a k) := by
      intro a k
      change Ideal.Quotient.mk (chartIdeal M D a) ((θ_M a) (MvPolynomial.C k)) =
        Ideal.Quotient.mk (chartIdeal M D a) (c_M a k)
      have hck : (θ_M a) (MvPolynomial.C k) = c_M a k := RingHom.congr_fun (hθ_M a).1 k
      rw [hck]
    have hEmpty_of_one : ∀ a : Fin (M + 1),
        (1 : MvPolynomial (Fin M) K) ∈ polyIdeal M θ_M D a →
        IsEmpty ↥((TopologicalSpace.Opens.map D.2.1.base).obj (D_open a)) := by
      intro a h1
      let O_a : D.1.Opens := (TopologicalSpace.Opens.map D.2.1.base).obj (D_open a)
      obtain ⟨e_a, _⟩ := hVD.2 a
      have htop : polyIdeal M θ_M D a = ⊤ := (Ideal.eq_top_iff_one _).mpr h1
      have : Subsingleton (MvPolynomial (Fin M) K ⧸ polyIdeal M θ_M D a) :=
        Ideal.Quotient.subsingleton_iff.mpr htop
      have : Subsingleton (R_a a ⧸ chartIdeal M D a) :=
        (θ_quot a).symm.toEquiv.subsingleton
      have hEmpSpec : IsEmpty (PrimeSpectrum (R_a a ⧸ chartIdeal M D a)) :=
        PrimeSpectrum.isEmpty_iff_subsingleton.mpr inferInstance
      refine ⟨fun x => ?_⟩
      have hx : x.1 ∈ (O_a : Set ↥D.1) := x.2
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hx
      obtain ⟨x₀, _⟩ := hx
      exact hEmpSpec.false (e_a.hom.base x₀)
    refine ⟨hEmpty_of_one a₀, ?_, ?_⟩
    · intro d Φ hΦ_C
      obtain ⟨e_a₀, he_a₀⟩ := hVD.2 a₀
      let Ψ : MvPolynomial (Fin d) K ≃+* (R_a a₀ ⧸ chartIdeal M D a₀) :=
        Φ.trans (θ_quot a₀)
      have hΨ_C : Ψ.toRingHom.comp MvPolynomial.C =
          (Ideal.Quotient.mk (chartIdeal M D a₀)).comp (c_M a₀) := by
        ext k
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, Ψ, RingEquiv.trans_apply]
        have h1 : Φ (MvPolynomial.C k) =
            Ideal.Quotient.mk (polyIdeal M θ_M D a₀) (MvPolynomial.C k) :=
          RingHom.congr_fun hΦ_C k
        rw [h1, hθ_quot_C]
      let e_spec0 : AlgebraicGeometry.Spec (CommRingCat.of (R_a a₀ ⧸ chartIdeal M D a₀)) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d) K)) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ.symm.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            convert AlgebraicGeometry.Spec.map_id (CommRingCat.of (R_a a₀ ⧸ chartIdeal M D a₀))
            apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact Ψ.apply_symm_apply y
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            convert AlgebraicGeometry.Spec.map_id (CommRingCat.of (MvPolynomial (Fin d) K))
            apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact Ψ.symm_apply_apply x }
      let e_spec : AlgebraicGeometry.Spec (CommRingCat.of (R_a a₀ ⧸ chartIdeal M D a₀)) ≅
          (weilAffineSpaceOver K d).left := e_spec0
      refine ⟨e_a₀ ≪≫ e_spec, ?_⟩
      change (e_a₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ.toRingHom)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        O_a₀.ι ≫ (D.2.1 ≫ (weilProjectiveSpaceOver K M).hom)
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hΨ_C, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, hFromSpec_hom a₀,
        ← CategoryTheory.Category.assoc O_a₀.ι, he_a₀]
      simp only [CategoryTheory.Category.assoc]
    · intro hOther Φ₀ hΦ₀_C
      obtain ⟨e_a₀, he_a₀⟩ := hVD.2 a₀
      have hSurj_ι : Function.Surjective O_a₀.ι.base := by
        intro z
        have htop : D.2.1.base z ∈ (⊤ : P_M.Opens) := trivial
        rw [← hSup_M, TopologicalSpace.Opens.mem_iSup] at htop
        obtain ⟨a, hz_Da⟩ := htop
        by_cases ha : a = a₀
        · subst ha
          have hz_Oa₀ : z ∈ (O_a₀ : Set ↥D.1) := hz_Da
          rwa [← AlgebraicGeometry.Scheme.Opens.range_ι] at hz_Oa₀
        · exact False.elim ((hEmpty_of_one a (hOther a ha)).false ⟨z, hz_Da⟩)
      have : CategoryTheory.Epi O_a₀.ι.base :=
        (TopCat.epi_iff_surjective O_a₀.ι.base).mpr hSurj_ι
      have : CategoryTheory.IsIso O_a₀.ι :=
        AlgebraicGeometry.IsOpenImmersion.isIso O_a₀.ι
      let Ψ₀ : K ≃+* (R_a a₀ ⧸ chartIdeal M D a₀) := Φ₀.trans (θ_quot a₀)
      have hΨ₀_C : Ψ₀.toRingHom =
          (Ideal.Quotient.mk (chartIdeal M D a₀)).comp (c_M a₀) := by
        ext k
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, Ψ₀, RingEquiv.trans_apply]
        have h1 : Φ₀ k = Ideal.Quotient.mk (polyIdeal M θ_M D a₀) (MvPolynomial.C k) :=
          RingHom.congr_fun hΦ₀_C k
        rw [h1, hθ_quot_C]
      have : CategoryTheory.IsIso (CommRingCat.ofHom Ψ₀.toRingHom) :=
        ⟨⟨CommRingCat.ofHom Ψ₀.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext Ψ₀.symm_apply_apply),
          CommRingCat.hom_ext (RingHom.ext Ψ₀.apply_symm_apply)⟩⟩
      have : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ₀.toRingHom)) :=
        inferInstance
      have hCompEq : O_a₀.ι ≫ (D.2.1 ≫ (weilProjectiveSpaceOver K M).hom) =
          e_a₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ₀.toRingHom) := by
        rw [← CategoryTheory.Category.assoc, he_a₀, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, ← hFromSpec_hom a₀,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← hΨ₀_C]
      have : CategoryTheory.IsIso (O_a₀.ι ≫ (D.2.1 ≫ (weilProjectiveSpaceOver K M).hom)) := by
        rw [hCompEq]; infer_instance
