      CategoryTheory.ShortComplex.ShortExact.mk' hEx₁ hMono_j hEpi_τ
    have hSE_pb : (SC_X.map pb_o).ShortExact := hSE_X.map_of_exact pb_o
    exact ⟨(SC_X.map pb_o).zero, hSE_pb⟩

  let Z_k := CategoryTheory.Over.mk (𝟙 S_k)
  have : AlgebraicGeometry.LocallyOfFiniteType Z_k.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (𝟙 S_k); infer_instance
  have : AlgebraicGeometry.QuasiCompact Z_k.hom := by
    change AlgebraicGeometry.QuasiCompact (𝟙 S_k); infer_instance
  have hDim_Sk : topologicalKrullDim Z_k.left ≤ (0 : WithBot ℕ∞) := by
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥S_k) ≤ 0
    have hSub : Subsingleton (TopologicalSpace.IrreducibleCloseds ↥S_k) := by
      refine ⟨fun C₁ C₂ => ?_⟩
      ext x
      obtain ⟨y₁, hy₁⟩ := C₁.isIrreducible.nonempty
      obtain ⟨y₂, hy₂⟩ := C₂.isIrreducible.nonempty
      exact ⟨fun _ => Subsingleton.elim x y₂ ▸ hy₂, fun _ => Subsingleton.elim x y₁ ▸ hy₁⟩
    refine iSup_le fun p => ?_
    cases hlen : p.length with
    | zero => exact le_refl 0
    | succ n => exfalso; exact (p.step ⟨0, hlen ▸ Nat.succ_pos n⟩).ne (hSub.elim _ _)
  have hSub_Sk_H1 : ∀ (𝒢 : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      Subsingleton (𝒢.H 1) :=
    fun 𝒢 => weil_etale_dim_zero_algClosed_cohomology_subsingleton k Z_k hDim_Sk 𝒢 1 (le_refl 1)

  let Fℤ_k := (CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let V : ℕ → Type u := fun n => (pb_o.obj (ℳ q₀ n)).H 0
  let ι_V : ∀ m n : ℕ, m ≤ n → (V m →+ V n) :=
    fun m n h => (CategoryTheory.Abelian.Ext.mk₀ (pb_o.map (j_map q₀ m n h))).postcomp Fℤ_k (Nat.add_zero 0)
  let π_V : ∀ m n : ℕ, m ≤ n → (V n →+ V m) :=
    fun m n h => (CategoryTheory.Abelian.Ext.mk₀ (pb_o.map (τ_map q₀ m n h))).postcomp Fℤ_k (Nat.add_zero 0)

  have hH0_SES : ∀ {A₁ A₂ A₃ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
      (f_k : A₁ ⟶ A₂) (g_k : A₂ ⟶ A₃) (hfg : f_k ≫ g_k = 0),
      (CategoryTheory.ShortComplex.mk f_k g_k hfg).ShortExact →
      let f0 := (CategoryTheory.Abelian.Ext.mk₀ f_k).postcomp Fℤ_k (Nat.add_zero 0)
      let g0 := (CategoryTheory.Abelian.Ext.mk₀ g_k).postcomp Fℤ_k (Nat.add_zero 0)
      Function.Injective f0 ∧ Function.Surjective g0 ∧ f0.range = g0.ker := by
    intro A₁ A₂ A₃ f_k g_k hfg hSE_k f0 g0
    have : CategoryTheory.Mono f_k := hSE_k.mono_f
    have hInj_f0 : Function.Injective f0 := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      let u := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx_u : x = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
      have hf0_u : f0 x = CategoryTheory.Abelian.Ext.mk₀ (u ≫ f_k) := by
        dsimp [f0]
        rw [hx_u]
        exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u f_k
      have hu_comp : u ≫ f_k = 0 := by
        have h1 := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ (hf0_u.symm.trans hx)
        rwa [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (u ≫ f_k),
          AddEquiv.apply_symm_apply, map_zero] at h1
      have hu0 : u = 0 :=
        (CategoryTheory.cancel_mono f_k).mp (hu_comp.trans CategoryTheory.Limits.zero_comp.symm)
      rw [hx_u, hu0, CategoryTheory.Abelian.Ext.mk₀_zero]
    have hSurj_g0 : Function.Surjective g0 := by
      intro z
      have hz0 : z.comp hSE_k.extClass (Nat.zero_add 1) = 0 := (hSub_Sk_H1 A₁).elim _ _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_k hSE_k z (Nat.zero_add 1) hz0
    have hRangeKer : f0.range = g0.ker := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        rw [AddMonoidHom.mem_ker]
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀ f_k) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ g_k) (Nat.add_zero 0) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 0),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hfg,
          CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero x A₃ 0 0 rfl]
      · intro hy
        rw [AddMonoidHom.mem_ker] at hy
        let u := CategoryTheory.Abelian.Ext.addEquiv₀ y
        have hy_u : y = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply y).symm
        have hg0_u : g0 y = CategoryTheory.Abelian.Ext.mk₀ (u ≫ g_k) := by
          dsimp [g0]
          rw [hy_u]
          exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u g_k
        have hu_g : u ≫ g_k = 0 := by
          have h1 := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ (hg0_u.symm.trans hy)
          rwa [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (u ≫ g_k),
            AddEquiv.apply_symm_apply, map_zero] at h1
        let hKer := hSE_k.exact.fIsKernel
        let v := hKer.lift (CategoryTheory.Limits.KernelFork.ofι u hu_g)
        have hv_fac : v ≫ f_k = u :=
          hKer.fac (CategoryTheory.Limits.KernelFork.ofι u hu_g)
            CategoryTheory.Limits.WalkingParallelPair.zero
        refine ⟨CategoryTheory.Abelian.Ext.mk₀ v, ?_⟩
        dsimp [f0]
        exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ v f_k).trans
          ((congrArg CategoryTheory.Abelian.Ext.mk₀ hv_fac).trans hy_u.symm)
    exact ⟨hInj_f0, hSurj_g0, hRangeKer⟩

  have hFin_V1 : Finite (V 1) := by
    dsimp [V, ℳ]
    rw [pow_one]
    exact hFin_pbS
  have hCard_V1 : Nat.card (V 1) = ℓ :=
    (congrArg (fun m => Nat.card ((pb_o.obj (weilEtaleHigherDirectImage j q₀
      (weilEtaleTorsionSheaf X_U m))).H 0)) (pow_one ℓ)).trans hCard_pbS

  have hTors : ∀ (n : ℕ) (x : V n), (ℓ ^ n) • x = 0 := by
    intro n x
    let G_n := pb_o.obj (ℳ q₀ n)
    have h_id0 : (ℓ ^ n) • (𝟙 G_n) = 0 := by
      have h1 := congrArg (fun m => pb_o.map m) (hTors_ℳ q₀ n)
      rwa [pb_o.map_nsmul, pb_o.map_id, pb_o.map_zero] at h1
    let u := CategoryTheory.Abelian.Ext.addEquiv₀ x
    have hx_eq : x = CategoryTheory.Abelian.Ext.addEquiv₀.symm u :=
      (AddEquiv.symm_apply_apply _ x).symm
    have hu_nsmul : (ℓ ^ n) • u = 0 := by
      calc (ℓ ^ n) • u
          = (ℓ ^ n) • (u ≫ 𝟙 G_n) := by rw [Category.comp_id]
        _ = u ≫ ((ℓ ^ n) • 𝟙 G_n) := (CategoryTheory.Preadditive.comp_nsmul u (𝟙 G_n) (ℓ ^ n)).symm
        _ = u ≫ 0 := by rw [h_id0]
        _ = 0 := CategoryTheory.Limits.comp_zero
    rw [hx_eq, ← map_nsmul, hu_nsmul, map_zero]

  have hInj_step : ∀ r : ℕ, Function.Injective (ι_V (r + 1) (r + 2) (Nat.le_succ (r + 1))) := by
    intro r
    obtain ⟨hcomp0, hSE_r⟩ := hSE_q0 (r + 1) (r + 2) 1 rfl
    exact (hH0_SES _ _ hcomp0 hSE_r).1

  have hSES_one : ∀ r : ℕ,
      Function.Injective (ι_V 1 (r + 2) (Nat.succ_pos (r + 1))) ∧
      Function.Surjective (π_V (r + 1) (r + 2) (Nat.le_succ (r + 1))) ∧
      AddMonoidHom.range (ι_V 1 (r + 2) (Nat.succ_pos (r + 1))) =
        AddMonoidHom.ker (π_V (r + 1) (r + 2) (Nat.le_succ (r + 1))) := by
    intro r
    have habc : 1 + (r + 1) = r + 2 := Nat.add_comm 1 (r + 1)
    obtain ⟨hcomp0, hSE_r⟩ := hSE_q0 1 (r + 2) (r + 1) habc
    exact hH0_SES _ _ hcomp0 hSE_r

  have hMul_step : ∀ (r : ℕ) (x : V (r + 2)),
      ι_V (r + 1) (r + 2) (Nat.le_succ (r + 1))
        (π_V (r + 1) (r + 2) (Nat.le_succ (r + 1)) x) = ℓ • x := by
    intro r x
    let G_r2 := pb_o.obj (ℳ q₀ (r + 2))
    have h_comp_X := (hMul_ℳ q₀ (r + 1) (r + 2) 1 (Nat.le_succ (r + 1)) rfl).2
    rw [pow_one] at h_comp_X
    have h_comp_k : pb_o.map (τ_map q₀ (r + 1) (r + 2) (Nat.le_succ (r + 1))) ≫
        pb_o.map (j_map q₀ (r + 1) (r + 2) (Nat.le_succ (r + 1))) = ℓ • 𝟙 G_r2 := by
      rw [← pb_o.map_comp, h_comp_X, pb_o.map_nsmul, pb_o.map_id]
    let u := CategoryTheory.Abelian.Ext.addEquiv₀ x
    have hx_u : x = CategoryTheory.Abelian.Ext.mk₀ u :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
    have hlhs : ι_V (r + 1) (r + 2) (Nat.le_succ (r + 1))
        (π_V (r + 1) (r + 2) (Nat.le_succ (r + 1)) x) =
        CategoryTheory.Abelian.Ext.mk₀ (u ≫ (ℓ • 𝟙 G_r2)) := by
      change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_o.map (τ_map q₀ (r + 1) (r + 2) (Nat.le_succ (r + 1)))))
          (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (pb_o.map (j_map q₀ (r + 1) (r + 2) (Nat.le_succ (r + 1)))))
        (Nat.add_zero 0) = _
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_comp_k, hx_u]
      exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u (ℓ • 𝟙 G_r2)
    have hu_mul : u ≫ (ℓ • 𝟙 G_r2) = ℓ • u := by
      rw [CategoryTheory.Preadditive.comp_nsmul, Category.comp_id]
    rw [hlhs, hu_mul, ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (ℓ • u),
      map_nsmul, CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, ← hx_u]

  exact hS9 V ι_V π_V hFin_V1 hCard_V1 hTors hInj_step hSES_one hMul_step

theorem weil_mid_dev_open_sp_proj_quadric_prime_pow_cohomology (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) :
    let P := Polynomial k
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of P)
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ A1_k :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    let R_quad := MvPolynomial (Fin (m + 1) × Fin 2) P ⧸
      Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C Polynomial.X}
    ∃ (Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (g_Q : Q_fam ⟶ CategoryTheory.Over.mk p_A1)
      (_ : AlgebraicGeometry.IsProper g_Q.left)
      (o₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_fam.left)
      (U_aff : Q_fam.left.Opens)
      (o₀_U : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_aff.toScheme)
      (e_aff : U_aff.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of R_quad)),
      o₀ ≫ g_Q.left = s₀ ∧
      o₀_U ≫ U_aff.ι = o₀ ∧
      U_aff.ι ≫ g_Q.left =
        e_aff.hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
      (∀ (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k))) (idx : Fin (m + 1) × Fin 2),
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ ((o₀_U ≫ e_aff.hom).base pt).asIdeal) ∧
      (∀ z : ↥Q_fam.left, z ∉ Set.range o₀.base →
        ∃ V : Q_fam.left.Opens, z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g_Q.left)) ∧
      (∀ (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
          (p_R : P →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k)
          (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (φ_R_Ω : R_bar →+* Ω)
          (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
          (D_col : ℐ ⥤ CommRingCat.{u})
          (α_col : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D_col)
          (c_col : CategoryTheory.Limits.Cocone D_col) (_ : CategoryTheory.Limits.IsColimit c_col)
          (e_pt : c_col.pt ≅ CommRingCat.of R_bar),
        p_R Polynomial.X = t_bar →
        π_cl.comp p_R = Polynomial.evalRingHom 0 →
        Function.Injective φ_R_Ω →
        @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra →
        (∀ i : ℐ,
          (α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
          Function.Injective ((c_col.ι.app i) ≫ e_pt.hom).hom) →
        (∀ i : ℐ,
          ∃ (ϖ : ↑(D_col.obj i)) (u : (↑(D_col.obj i))ˣ) (e : ℕ)
            (ψ_i : P →+* ↑(D_col.obj i)),
            1 ≤ e ∧
            ((c_col.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
            (α_col.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
            ψ_i.comp Polynomial.C = (α_col.app i).hom.comp Polynomial.C ∧
            ψ_i Polynomial.X = ϖ ∧
            ψ_i.Etale ∧
            ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D_col.obj i₁))
              (ψ₁ : P →+* ↑(D_col.obj i₁)),
              (D_col.map θ).hom ϖ = β ^ ℓ ∧
              ψ₁.comp Polynomial.C = (α_col.app i₁).hom.comp Polynomial.C ∧
              ψ₁ Polynomial.X = β ∧
              ψ₁.Etale) →
        let Q_R := CategoryTheory.Limits.pullback g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R))
        let Q_Ω := CategoryTheory.Limits.pullback g_Q.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R)))
        ∀ (j_Q : Q_Ω ⟶ Q_R)
          (o_R : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_R),
          j_Q ≫ CategoryTheory.Limits.pullback.fst g_Q.left
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
            CategoryTheory.Limits.pullback.fst g_Q.left
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))) →
          j_Q ≫ CategoryTheory.Limits.pullback.snd g_Q.left
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
            CategoryTheory.Limits.pullback.snd g_Q.left
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) →
          o_R ≫ CategoryTheory.Limits.pullback.fst g_Q.left
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) = o₀ →
          o_R ≫ CategoryTheory.Limits.pullback.snd g_Q.left
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) →
          (∀ (r : ℕ) (W : Q_R.Etale)
              (p_W0 : weilEtaleTorsionH
                  ((AlgebraicGeometry.Scheme.Etale.forget Q_R).obj W).left (ℓ ^ (r + 1)) 0 →+
                weilEtaleTorsionH
                  ((AlgebraicGeometry.Scheme.Etale.forget Q_Ω).obj
                    ((weilEtaleSitePullback j_Q).obj W)).left (ℓ ^ (r + 1)) 0),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget Q_R).obj W).hom j_Q)
              (ℓ ^ (r + 1)) 0 p_W0 →
            Function.Bijective p_W0) ∧
          ∀ (hCont_o : (weilEtaleSitePullback o_R).IsContinuous
              Q_R.smallEtaleTopology
              (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
            (hAdj_o : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              (weilEtaleSitePullback o_R) AddCommGrpCat.{u} _
              Q_R.smallEtaleTopology
              (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
              hCont_o).IsRightAdjoint),
            let pb_o := @CategoryTheory.Functor.sheafPullback _ _ _ _
              (weilEtaleSitePullback o_R) AddCommGrpCat.{u} _
              Q_R.smallEtaleTopology
              (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
              hCont_o hAdj_o
            (∀ (r q : ℕ), 1 ≤ q → q ≠ 2 * m + 1 →
              CategoryTheory.Limits.IsZero
                (pb_o.obj (weilEtaleHigherDirectImage j_Q q
                  (weilEtaleTorsionSheaf Q_Ω (ℓ ^ (r + 1)))))) ∧
            ∃ θ_van : ∀ r : ℕ,
                (pb_o.obj (weilEtaleHigherDirectImage j_Q (2 * m + 1)
                  (weilEtaleTorsionSheaf Q_Ω (ℓ ^ (r + 1))))).H 0 ≃+ ZMod (ℓ ^ (r + 1)),
              ∀ (r : ℕ)
                (x : (pb_o.obj (weilEtaleHigherDirectImage j_Q (2 * m + 1)
                  (weilEtaleTorsionSheaf Q_Ω (ℓ ^ (r + 2))))).H 0),
                let cast_Q :=
                  ((CategoryTheory.constantSheaf Q_Ω.smallEtaleTopology AddCommGrpCat.{u}).map
                    (AddCommGrpCat.uliftFunctor.{u, 0}.map
                      (AddCommGrpCat.ofHom
                        (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
                          (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom)))
                let τ_van := pb_o.map (weilEtaleHigherDirectImageMap j_Q (2 * m + 1) cast_Q)
                θ_van r
                  ((CategoryTheory.Abelian.Ext.mk₀ τ_van).postcomp
                    ((CategoryTheory.constantSheaf
                      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
                      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
                    (Nat.add_zero 0) x) =
                  ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                    (θ_van (r + 1) x)) :=
by
  classical
  intro P A1_k p_A1 s₀ R_quad
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let N := 2 * m + 2
  let u_idx : Fin (m + 1) → Fin (N + 1) :=
    fun j => ⟨2 * j.1, Nat.lt_succ_of_lt (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
  let v_idx : Fin (m + 1) → Fin (N + 1) :=
    fun j => ⟨2 * j.1 + 1, Nat.succ_lt_succ (Nat.mul_lt_mul_of_pos_left j.isLt (Nat.succ_pos 1))⟩
  let w_idx : Fin (N + 1) := Fin.last N

  have hQuadOv : ∀ (R : Type u) [CommRing R]
      (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
      (c_R : ∀ a : Fin (N + 1),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))))
      (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a)))),
      IsCommRingProjCoordSystem R N hAff c_R t_R →
      ∀ (t_val : R) (a a' : Fin (N + 1)) (_ : Fin 1),
        ((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_right).op).hom
            ((∑ j : Fin (m + 1), t_R a' (u_idx j) * t_R a' (v_idx j)) -
              c_R a' t_val * (t_R a' w_idx) ^ 2) *
        (((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a a')) ^ 2 =
        ((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_left).op).hom
            ((∑ j : Fin (m + 1), t_R a (u_idx j) * t_R a (v_idx j)) -
              c_R a t_val * (t_R a w_idx) ^ 2) := by
    intro R _ hAff c_R t_R hCoord t_val a a' _
    rcases hCoord with ⟨_, _, _, _, _, _, _, _, hC_ov, hT_ov⟩
    set resL := ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom
    set resR := ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom
    rw [map_sub, map_sum, map_mul, map_pow, map_sub, map_sum, map_mul, map_pow,
      sub_mul, Finset.sum_mul]
