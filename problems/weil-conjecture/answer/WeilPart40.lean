        (CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
          AddCommGrpCat.{u})),
      SC.ShortExact →
      ℓ • CategoryTheory.CategoryStruct.id SC.X₁ = 0 →
      (SC.map (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
        X.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        hCont_i)).ShortExact)
    (G : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
      AddCommGrpCat.{u})
    (hG : ℓ • CategoryTheory.CategoryStruct.id G = 0)
    (q : ℕ) (hq : 1 ≤ q) :
    Subsingleton
      (((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
        X.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
