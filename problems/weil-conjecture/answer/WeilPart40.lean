  let _ := hAdj
  let _ := hAdd
  let _ := hLim
  let _ := hColim
  let B := weilEtaleSitePullback h
  let J₁ := Z₁.smallEtaleTopology
  let J₂ := Z₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
