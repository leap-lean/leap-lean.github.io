      exact ⟨CategoryTheory.Limits.cokernel ψ, hPb_cok, hZero_pf.of_iso e_cok_zero⟩
    · exact hMeetZero K z_bar C_u hDisj hZero_pbC
  have : CategoryTheory.Mono u_S := CategoryTheory.Preadditive.mono_of_isZero_kernel u_S hZero_Ku
