          rw [← h_iu_gt k hk_gt, ← h_iv_gt k hk_gt, hθ_symm_succ, hθ_symm_succ]
      have h_qA_pull : θ.symm q_A =
          (∑ k : Fin (m + 1),
            if hk_lt : k.1 < j.1 then
