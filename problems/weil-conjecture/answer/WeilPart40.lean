        exact ⟨E_d, k_d, y, hk_zero, hMorEtale X k_d, hy⟩
      refine (C_X.obj (AM ℓ)).2.isSeparated D S₀ hS₀_mem s 0 (fun E k hk => ?_)
      exact hk.trans (map_zero ((C_X.obj (AM ℓ)).obj.map k.op).hom).symm
    have _ : ∀ D_op : (X.Etale)ᵒᵖ, CategoryTheory.Mono (α_ℓ.hom.app D_op) :=
      fun D_op => (AddCommGrpCat.mono_iff_injective _).mpr (hInjD D_op.unop)
    have hMono_hom : CategoryTheory.Mono α_ℓ.hom :=
      (CategoryTheory.NatTrans.mono_iff_mono_app α_ℓ.hom).mpr inferInstance
    have : CategoryTheory.Mono α_ℓ :=
      (CategoryTheory.sheafToPresheaf X.smallEtaleTopology AddCommGrpCat.{u}).mono_of_mono_map
        hMono_hom
    have : CategoryTheory.Sheaf.IsLocallySurjective α_ℓ := by
      refine ⟨fun {D} t => ?_⟩
      refine (hMem X D (CategoryTheory.Presheaf.imageSieve α_ℓ.hom t)).mpr (fun d => ?_)
      obtain ⟨U_d, hAff, hd_mem, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := d) (U := (⊤ : D.left.Opens)) trivial
      let W_d : AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.Spec (D.left.presheaf.obj (Opposite.op U_d))
      have : AlgebraicGeometry.IsAffine W_d := inferInstance
      let ι_d : W_d ⟶ D.left := hAff.fromSpec
      have _ : AlgebraicGeometry.IsOpenImmersion ι_d := hAff.isOpenImmersion_fromSpec
      have hEt_ι : AlgebraicGeometry.Etale ι_d := inferInstance
      let w_d : W_d ⟶ X := ι_d ≫ D.hom
      have hw_d : AlgebraicGeometry.Etale w_d :=
        CategoryTheory.MorphismProperty.comp_mem P_et ι_d D.hom hEt_ι D.prop
      let E_d : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_d hw_d
      let k_d : E_d ⟶ D := CategoryTheory.MorphismProperty.Over.homMk ι_d rfl trivial
      have hd_range : d ∈ Set.range ι_d.base :=
        Eq.mpr (congrArg (d ∈ ·) hAff.range_fromSpec) hd_mem
