        have hBij_E : Function.Bijective φ_E := by
          refine ⟨fun x y h => hfΨ_inj (congrArg Subtype.val h), ?_⟩
          rintro ⟨_, ⟨t, ht⟩⟩
          exact ⟨t, Subtype.ext ht⟩
        let e_E : T ≃ₗ[L_r] ↥E' := LinearEquiv.ofBijective φ_E hBij_E
        let b_E : Module.Basis (Fin s) L_r ↥E' := b_T.map e_E
        have hbE_val : ∀ i : Fin s, (b_E i : Ω) = i_k (u i) := by
          intro i
          change f_Ψ (b_T i) = i_k (u i)
          have hb_i : b_T i = TensorProduct.tmul ↥F₁ (1 : L_r) (b₀ i) := by
            dsimp [b_T]; rw [Module.Basis.baseChange_apply]
          rw [hb_i, hfΨ_tmul, map_one, one_mul]
        exact ⟨E', b_E, hbE_val, show w ∈ R_T from ⟨t_w, hfΨ_tw⟩⟩

      obtain ⟨E', b_E, hbE_val, hw_mem_E'⟩ := hE'_basis
      let _ : FiniteDimensional L_r ↥E' := Module.Finite.of_basis b_E

