theorem weil_trait_leray_pbc_geom_stalk_inj_and_const_r_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ q₀ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (Z_bar D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType D_bar.hom]
    (f_bar : Z_bar ⟶ D_bar) [AlgebraicGeometry.IsProper f_bar.left]
    (K_s : Type u) [Field K_s]
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ι_KΩ : K_s →+* Ω)
    (hAlg_KΩ : letI : Algebra K_s Ω := ι_KΩ.toAlgebra; Algebra.IsAlgebraic K_s Ω)
    (g_Ks : AlgebraicGeometry.Spec (CommRingCat.of K_s) ⟶ D_bar.left)
    (s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ D_bar.left)
    (hs_Ω : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_KΩ) ≫ g_Ks = s_Ω) :
    let M := ℓ ^ (r + 1)
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K_s)
    let Z_Ks := CategoryTheory.Limits.pullback f_bar.left g_Ks
    let f_Ks := CategoryTheory.Limits.pullback.snd f_bar.left g_Ks
    let Z_Ω := CategoryTheory.Limits.pullback f_bar.left s_Ω
    let T_Ks := weilEtaleIdTerminal S_K
    let Cod := ↑((weilEtaleHigherDirectImage f_Ks (q₀ + 1)
      (weilEtaleTorsionSheaf Z_Ks M)).obj.obj (Opposite.op T_Ks))
    let ℛ_low := weilEtaleHigherDirectImage f_Ks q₀ (weilEtaleTorsionSheaf Z_Ks M)
    ∀ (hT_ZKs : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f_Ks).obj T_Ks))
      (j_Z_ΩK : Z_Ω ⟶ Z_Ks),
      j_Z_ΩK ≫ CategoryTheory.Limits.pullback.fst f_bar.left g_Ks =
        CategoryTheory.Limits.pullback.fst f_bar.left s_Ω →
      j_Z_ΩK ≫ CategoryTheory.Limits.pullback.snd f_bar.left g_Ks =
        CategoryTheory.Limits.pullback.snd f_bar.left s_Ω ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_KΩ) →
      ∀ (p_Ω_K_low : weilEtaleTorsionH Z_Ks M q₀ →+ weilEtaleTorsionH Z_Ω M q₀)
        (p_Ω_K_mid : weilEtaleTorsionH Z_Ks M (q₀ + 1) →+ weilEtaleTorsionH Z_Ω M (q₀ + 1)),
        WeilIsTorsionEtalePullback j_Z_ΩK M q₀ p_Ω_K_low →
        WeilIsTorsionEtalePullback j_Z_ΩK M (q₀ + 1) p_Ω_K_mid →
        (∃ ι_cod : Cod →+ weilEtaleTorsionH Z_Ω M (q₀ + 1),
          Function.Injective ι_cod ∧
          ι_cod.comp (weilOuterTrFibEdgeHom f_Ks T_Ks hT_ZKs
            (weilEtaleTorsionSheaf Z_Ks M) (q₀ + 1)) = p_Ω_K_mid) ∧
        (∀ (A₀ : Type u) [AddCommGroup A₀]
            (α₀ : A₀ →+ weilEtaleTorsionH Z_Ks M q₀),
          Function.Bijective (p_Ω_K_low.comp α₀) →
          Nonempty (CategoryTheory.Iso
            ((CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}).obj
