      rwa [← hd_m]
    have hCard_Um_2m2 :
        Nat.card
          (weilEtaleLocalTorsionH (Z s_m.castSucc).left ℓ
            (CategoryTheory.MorphismProperty.Over.mk ⊤ (U_step s_m).ι
              (inferInstance : AlgebraicGeometry.Etale (U_step s_m).ι))
            ((2 * m + 1) + 1)) = ℓ := by
      rwa [← hd_m]
    have hCard_sm_mul :
        Nat.card (weilEtaleTorsionH (Z s_m.castSucc).left ℓ ((2 * m + 1) + 1)) =
          ℓ * Nat.card (weilEtaleTorsionH (Z s_top.castSucc).left ℓ ((2 * m + 1) + 1)) := by
      have hmul := weil_proj_quadric_prime_pow_closed_compl_excision_card_mul K ℓ hℓ_K hPBC_K
        (Z s_m.castSucc) (Z s_m.succ) (ι_step s_m) (U_step s_m) (hCompl_Z s_m) (2 * m + 1)
        hSub_sm_succ_2m1 hSub_Um_2m3
        (hFinProper (Z s_m.castSucc) ((2 * m + 1) + 1))
        hFin_Um_2m2
        (hFinProper (Z s_m.succ) ((2 * m + 1) + 1))
      rw [hCard_Um_2m2, hs_m_succ] at hmul
      exact hmul

    refine ⟨hFin_fib, ?_, ?_⟩
    · intro ht0
      obtain ⟨e_top, he_top⟩ := hCell_Z_top_eq ht0
      have hm1_eq : 2 * (m + 1) = (2 * m + 1) + 1 := by omega
      obtain ⟨hCell_top_van, hCell_top_fin, hCell_top_card⟩ :=
        weil_proj_quadric_prime_pow_affine_cell_local_cohomology K ℓ hℓ_K hPBC_K
          (Z s_top.castSucc) (U_step s_top) (m + 1) e_top he_top
      have hSub_Utop_2m3 :
          Subsingleton
            (weilEtaleLocalTorsionH (Z s_top.castSucc).left ℓ
              (CategoryTheory.MorphismProperty.Over.mk ⊤ (U_step s_top).ι
                (inferInstance : AlgebraicGeometry.Etale (U_step s_top).ι))
              ((2 * m + 1) + 2)) :=
        hCell_top_van ((2 * m + 1) + 2) (by omega)
      have hFin_Utop_2m2 :
          Finite
            (weilEtaleLocalTorsionH (Z s_top.castSucc).left ℓ
              (CategoryTheory.MorphismProperty.Over.mk ⊤ (U_step s_top).ι
                (inferInstance : AlgebraicGeometry.Etale (U_step s_top).ι))
              ((2 * m + 1) + 1)) := by
        rwa [← hm1_eq]
      have hCard_Utop_2m2 :
          Nat.card
            (weilEtaleLocalTorsionH (Z s_top.castSucc).left ℓ
              (CategoryTheory.MorphismProperty.Over.mk ⊤ (U_step s_top).ι
                (inferInstance : AlgebraicGeometry.Etale (U_step s_top).ι))
              ((2 * m + 1) + 1)) = ℓ := by
        rwa [← hm1_eq]
      have hCard_top_eq :
          Nat.card (weilEtaleTorsionH (Z s_top.castSucc).left ℓ ((2 * m + 1) + 1)) = ℓ := by
        have hmul := weil_proj_quadric_prime_pow_closed_compl_excision_card_mul K ℓ hℓ_K hPBC_K
          (Z s_top.castSucc) (Z s_top.succ) (ι_step s_top) (U_step s_top)
          (hCompl_Z s_top) (2 * m + 1)
          hSub_top_succ_2m1 hSub_Utop_2m3
          (hFinProper (Z s_top.castSucc) ((2 * m + 1) + 1))
          hFin_Utop_2m2
          (hFinProper (Z s_top.succ) ((2 * m + 1) + 1))
        rw [hCard_Utop_2m2, hs_top_succ] at hmul
        change Nat.card (weilEtaleTorsionH (Z s_top.castSucc).left ℓ ((2 * m + 1) + 1)) =
          ℓ * Nat.card (weilEtaleTorsionH (Z (Fin.last (m + 2))).left ℓ (2 * m + 2)) at hmul
        rw [hCard_Zbot_2m2, mul_one] at hmul
        exact hmul
      rw [hCard_fib_Qt, hCard_Qt_Zm]
      change Nat.card (weilEtaleTorsionH (Z s_m.castSucc).left ℓ ((2 * m + 1) + 1)) = ℓ ^ 2
      rw [hCard_sm_mul, hCard_top_eq, sq]
    · intro ht_ne
      have hEmp_top : IsEmpty ↥(U_step s_top) := hCell_Z_top_ne ht_ne
      obtain ⟨p_top_2m2, hp_top_2m2⟩ := hPullEx (ι_step s_top).left ℓ (2 * m + 2)
      have hExc_top := weil_proj_quadric_paving_closed_compl_excision_step K ℓ hℓ_K hPBC_K
        (Z s_top.castSucc) (Z s_top.succ) (ι_step s_top) (U_step s_top)
        (hCompl_Z s_top) (2 * m + 2) p_top_2m2 hp_top_2m2
      have hBij_top_2m2 : Function.Bijective p_top_2m2 :=
        hExc_top.2.2
          (hExc_top.1 hEmp_top (2 * m + 2))
          (hExc_top.1 hEmp_top (2 * m + 3))
          (hFinProper (Z s_top.succ) (2 * m + 2))
      have hCard_top_eq1 :
          Nat.card (weilEtaleTorsionH (Z s_top.castSucc).left ℓ (2 * m + 2)) = 1 := by
        rw [Nat.card_eq_of_bijective p_top_2m2 hBij_top_2m2, hs_top_succ, hCard_Zbot_2m2]
      rw [hCard_fib_Qt, hCard_Qt_Zm]
      change Nat.card (weilEtaleTorsionH (Z s_m.castSucc).left ℓ ((2 * m + 1) + 1)) = ℓ
      rw [hCard_sm_mul]
      change ℓ * Nat.card (weilEtaleTorsionH (Z s_top.castSucc).left ℓ (2 * m + 2)) = ℓ
      rw [hCard_top_eq1, mul_one]

theorem weil_proj_quadric_prime_pow_affine_odp_high_deg_hdi_zero (k : Type u) [Field k] (m : ℕ)
    (R_bar : Type u) [CommRing R_bar]
    (p_R : Polynomial k →+* R_bar) (t_bar : R_bar) (ht_eq : p_R Polynomial.X = t_bar)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (φ_R_Ω : R_bar →+* Ω) (ht_unit : IsUnit (φ_R_Ω t_bar)) :
    let P := Polynomial k
    let C_Q := AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) P ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C (Polynomial.X : P)}))
    let p_CQ : C_Q ⟶ AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (Ideal.span
          {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C (Polynomial.X : P)})).comp MvPolynomial.C))
    let C_Q_R := CategoryTheory.Limits.pullback p_CQ
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R))
    let C_Q_Ω := CategoryTheory.Limits.pullback p_CQ
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R)))
    ∀ (j_CQ : C_Q_Ω ⟶ C_Q_R),
      j_CQ ≫ CategoryTheory.Limits.pullback.fst p_CQ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
        CategoryTheory.Limits.pullback.fst p_CQ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))) →
      j_CQ ≫ CategoryTheory.Limits.pullback.snd p_CQ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)) =
        CategoryTheory.Limits.pullback.snd p_CQ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) →
      ∀ (n q : ℕ), 1 ≤ n → IsUnit (n : Ω) → 2 * m + 2 ≤ q →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_CQ q (weilEtaleTorsionSheaf C_Q_Ω n)) :=
by
  intro P C_Q p_CQ C_Q_R C_Q_Ω j_CQ _hj_fst _hj_snd n q hn hUnit_n hq
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {A B D : C}
      (g₁ : A ⟶ B) (g₂ : B ⟶ D),
      (g₁ ≫ g₂).op = g₂.op ≫ g₁.op := fun _ _ => rfl

  
  let Idx := Fin (m + 1) × Fin 2
  let Q_P : MvPolynomial Idx P :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
      MvPolynomial.C (Polynomial.X : P)
  let I_P : Ideal (MvPolynomial Idx P) := Ideal.span {Q_P}
  let A_P := MvPolynomial Idx P ⧸ I_P
  let f_P_AP : P →+* A_P := (Ideal.Quotient.mk I_P).comp MvPolynomial.C
  let g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of P) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
  let g_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of P) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Ω.comp p_R))
  let A_Ω := MvPolynomial Idx Ω
  let F_Ω : A_Ω :=
    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
      MvPolynomial.C (φ_R_Ω t_bar)
  let I_Ω : Ideal A_Ω := Ideal.span {F_Ω}
  let B_Ω := A_Ω ⧸ I_Ω
  let f_Ω_BΩ : Ω →+* B_Ω := (Ideal.Quotient.mk I_Ω).comp MvPolynomial.C

  have hQP_ker :
      ∀ a ∈ I_P, ((Ideal.Quotient.mk I_Ω).comp (MvPolynomial.map (φ_R_Ω.comp p_R))) a = 0 := by
    intro a ha
    rw [Ideal.mem_span_singleton] at ha
    rcases ha with ⟨c, rfl⟩
    rw [map_mul]
    have hmap : MvPolynomial.map (φ_R_Ω.comp p_R) Q_P = F_Ω := by
      simp [Q_P, F_Ω, ht_eq]
    have h0 : ((Ideal.Quotient.mk I_Ω).comp (MvPolynomial.map (φ_R_Ω.comp p_R))) Q_P = 0 := by
      rw [RingHom.comp_apply, hmap, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self F_Ω
    rw [h0, zero_mul]

  let ψ_AP_BΩ : A_P →+* B_Ω :=
    Ideal.Quotient.lift I_P ((Ideal.Quotient.mk I_Ω).comp (MvPolynomial.map (φ_R_Ω.comp p_R))) hQP_ker
  let f_hom : CommRingCat.of P ⟶ CommRingCat.of A_P := CommRingCat.ofHom f_P_AP
  let g_hom : CommRingCat.of P ⟶ CommRingCat.of Ω := CommRingCat.ofHom (φ_R_Ω.comp p_R)
  let inl_hom : CommRingCat.of A_P ⟶ CommRingCat.of B_Ω := CommRingCat.ofHom ψ_AP_BΩ
  let inr_hom : CommRingCat.of Ω ⟶ CommRingCat.of B_Ω := CommRingCat.ofHom f_Ω_BΩ

  have hcomm_Ω : f_hom ≫ inl_hom = g_hom ≫ inr_hom := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro p
    change ψ_AP_BΩ (Ideal.Quotient.mk I_P (MvPolynomial.C p)) =
      Ideal.Quotient.mk I_Ω (MvPolynomial.C ((φ_R_Ω.comp p_R) p))
    dsimp only [ψ_AP_BΩ]
    rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]

  have hColim_Ω : CategoryTheory.Limits.IsColimit
      (CategoryTheory.Limits.PushoutCocone.mk inl_hom inr_hom hcomm_Ω) := by
    refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_Ω
      (fun s =>
        CommRingCat.ofHom
          (Ideal.Quotient.lift I_Ω
            (MvPolynomial.eval₂Hom (s.inr.hom : Ω →+* ↑s.pt)
              (fun idx => s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.X idx))))
            (by
              intro a ha
              rw [Ideal.mem_span_singleton] at ha
              rcases ha with ⟨c, rfl⟩
              rw [map_mul]
              suffices h0 :
                  (MvPolynomial.eval₂Hom (s.inr.hom : Ω →+* ↑s.pt)
                    (fun idx => s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.X idx)))) F_Ω = 0 by
                rw [h0, zero_mul]
              dsimp only [F_Ω]
              rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C]
              have hXP : (s.inr.hom : Ω →+* ↑s.pt) (φ_R_Ω t_bar) =
                  s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.C (Polynomial.X : P))) := by
                rw [← ht_eq]
                exact (DFunLike.congr_fun
                  (congrArg CommRingCat.Hom.hom s.condition) (Polynomial.X : P)).symm
              have hsum :
                  (∑ j : Fin (m + 1),
                    (MvPolynomial.eval₂Hom (s.inr.hom : Ω →+* ↑s.pt)
                      (fun idx => s.inl.hom (Ideal.Quotient.mk I_P (MvPolynomial.X idx))))
                      (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) =
                  s.inl.hom (Ideal.Quotient.mk I_P
                    (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
                rw [map_sum, map_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
                  map_mul, map_mul]
              rw [hsum, hXP, ← map_sub, ← map_sub]
              have hQP0 : Ideal.Quotient.mk I_P Q_P = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self Q_P)
              change s.inl.hom (Ideal.Quotient.mk I_P Q_P) = 0
              rw [hQP0, map_zero])))
      ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro p
        dsimp only [inl_hom, ψ_AP_BΩ]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Ideal.Quotient.lift_mk]
        erw [MvPolynomial.map_C, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) p).symm
      · intro idx
        dsimp only [inl_hom, ψ_AP_BΩ]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Ideal.Quotient.lift_mk]
        erw [MvPolynomial.map_X, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro (c : Ω)
      dsimp only [inr_hom, f_Ω_BΩ]
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      erw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m_hom hm_l hm_r
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, Ideal.Quotient.lift_mk]
        erw [MvPolynomial.eval₂Hom_C]
        exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) c
      · intro idx
        simp only [CommRingCat.hom_ofHom, RingHom.comp_apply, Ideal.Quotient.lift_mk]
        erw [MvPolynomial.eval₂Hom_X']
        have hX := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l)
          (Ideal.Quotient.mk I_P (MvPolynomial.X idx))
        dsimp only [inl_hom, ψ_AP_BΩ] at hX
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          Ideal.Quotient.lift_mk] at hX
        erw [MvPolynomial.map_X] at hX
        exact hX

  have hPush_Ω : CategoryTheory.IsPushout f_hom g_hom inl_hom inr_hom :=
    CategoryTheory.IsPushout.of_isColimit hColim_Ω
  have hPb_Ω : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map inl_hom) (AlgebraicGeometry.Spec.map inr_hom) p_CQ g_Ω :=
    AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_hom g_hom inl_hom inr_hom hPush_Ω
  let e_CQΩ : AlgebraicGeometry.Spec (CommRingCat.of B_Ω) ≅ C_Q_Ω := hPb_Ω.isoPullback

  haveI : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map inr_hom) := by
    have halg : algebraMap Ω B_Ω = f_Ω_BΩ := RingHom.ext fun _ => rfl
    have hft : f_Ω_BΩ.FiniteType := by
      rw [← halg]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hft
  let snd_Ω : C_Q_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    CategoryTheory.Limits.pullback.snd p_CQ g_Ω
  haveI : AlgebraicGeometry.LocallyOfFiniteType snd_Ω := by
    have hsnd_eq : snd_Ω = e_CQΩ.inv ≫ AlgebraicGeometry.Spec.map inr_hom := by
      dsimp only [snd_Ω, e_CQΩ]
      rw [CategoryTheory.Iso.eq_inv_comp]
      exact hPb_Ω.isoPullback_hom_snd
    rw [hsnd_eq]
    infer_instance

  have hF_const : MvPolynomial.constantCoeff F_Ω = -φ_R_Ω t_bar := by
    dsimp only [F_Ω]
    rw [map_sub, map_sum, MvPolynomial.constantCoeff_C]
    have h0 : (∑ j : Fin (m + 1),
        (MvPolynomial.constantCoeff : A_Ω →+* Ω)
          (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) = 0 := by
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [map_mul, MvPolynomial.constantCoeff_X, zero_mul]
    rw [h0, zero_sub]
  have hF_ne : F_Ω ≠ 0 := by
    intro h0
    have hc0 : MvPolynomial.constantCoeff F_Ω = 0 := by rw [h0, map_zero]
    rw [hF_const] at hc0
    exact (neg_ne_zero.mpr ht_unit.ne_zero) hc0
  have hF_nzd : F_Ω ∈ nonZeroDivisors A_Ω := mem_nonZeroDivisors_of_ne_zero hF_ne
  have hDim_AΩ : ringKrullDim A_Ω = ((2 * m + 2 : ℕ) : WithBot ℕ∞) := by
    dsimp only [A_Ω]
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field Ω, zero_add,
      ENat.card_eq_coe_natCard]
    have hcard : Nat.card Idx = 2 * m + 2 := by
      dsimp only [Idx]
      rw [Nat.card_prod, Nat.card_fin, Nat.card_fin]
      omega
    rw [hcard]
    rfl
  have hDim_succ : ringKrullDim B_Ω + 1 ≤ ((2 * m + 2 : ℕ) : WithBot ℕ∞) := by
    rw [← hDim_AΩ]
    exact ringKrullDim_quotient_succ_le_of_nonZeroDivisor hF_nzd
  have hDim_BΩ : ringKrullDim B_Ω ≤ ((2 * m + 1 : ℕ) : WithBot ℕ∞) := by
    generalize ringKrullDim B_Ω = x at hDim_succ
    cases x using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe a =>
      cases a using ENat.recTopCoe with
      | top =>
        exfalso
        have htop : ((⊤ : ℕ∞) : WithBot ℕ∞) + 1 = ((⊤ : ℕ∞) : WithBot ℕ∞) := by
          rw [← WithBot.coe_one, ← WithBot.coe_add, top_add]
        have h2 : ((2 * m + 2 : ℕ) : WithBot ℕ∞) = (((2 * m + 2 : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
        rw [htop, h2] at hDim_succ
        have htop2 : (⊤ : ℕ∞) ≤ ((2 * m + 2 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp hDim_succ
        exact ENat.natCast_ne_top (2 * m + 2) (top_le_iff.mp htop2)
      | coe d₀ =>
        have hcoe : ((d₀ : ℕ∞) : WithBot ℕ∞) + 1 = (((d₀ + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) := by
          rw [← WithBot.coe_one, ← WithBot.coe_add]
          rfl
        have h2 : ((2 * m + 2 : ℕ) : WithBot ℕ∞) = (((2 * m + 2 : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
        rw [hcoe, h2] at hDim_succ
        have hd₀ : d₀ + 1 ≤ 2 * m + 2 :=
          ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp hDim_succ)
        have hd₀' : d₀ ≤ 2 * m + 1 := by omega
        exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr hd₀')

  
  have hEtaleKrullLe :
      ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S),
        φ.Etale → ringKrullDim S ≤ ringKrullDim R := by
    intro R S _ _ φ hφ
    letI : Algebra R S := φ.toAlgebra
    haveI : Algebra.Etale R S := RingHom.Etale.toAlgebra hφ
    haveI : Algebra.QuasiFinite R S := inferInstance
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap R S))
    intro q₁ q₂ hq_lt
    have hq_le : q₁ ≤ q₂ := hq_lt.le
    have hq_ne : q₁ ≠ q₂ := hq_lt.ne
    have hcomap_le :
        PrimeSpectrum.comap (algebraMap R S) q₁ ≤ PrimeSpectrum.comap (algebraMap R S) q₂ :=
      (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr
        (Ideal.comap_mono ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp hq_le))
    refine lt_of_le_of_ne hcomap_le fun h_eq => hq_ne ?_
    let p : PrimeSpectrum R := PrimeSpectrum.comap (algebraMap R S) q₁
