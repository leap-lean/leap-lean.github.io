            CategoryTheory.CategoryStruct.comp (τ_M m_idx n h₂) (τ_M k_idx m_idx h₁) =
              τ_M k_idx n (le_trans h₁ h₂)) ∧
          (∀ (m₁ n₁ m₂ n₂ d : ℕ) (h₁ : m₁ ≤ n₁) (h₂ : m₂ ≤ n₂)
              (hm : m₂ ≤ m₁) (hn : n₂ ≤ n₁),
            m₁ + d = n₁ → m₂ + d = n₂ →
            CategoryTheory.CategoryStruct.comp (j_M m₁ n₁ h₁) (τ_M n₂ n₁ hn) =
              CategoryTheory.CategoryStruct.comp (τ_M m₂ m₁ hm) (j_M m₂ n₂ h₂)) ∧
          (∀ (m_idx n d : ℕ) (h : m_idx ≤ n),
            m_idx + d = n →
            CategoryTheory.CategoryStruct.comp (j_M m_idx n h) (τ_M m_idx n h) =
              (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M m_idx) ∧
            CategoryTheory.CategoryStruct.comp (τ_M m_idx n h) (j_M m_idx n h) =
              (ℓ ^ d) • CategoryTheory.CategoryStruct.id (M n)) ∧
          (∀ (a b c : ℕ) (habc : a + c = b),
            ∃ h₁ : CategoryTheory.CategoryStruct.comp
                (j_M a b (Nat.le.intro habc))
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) = 0,
              (CategoryTheory.ShortComplex.mk
                (j_M a b (Nat.le.intro habc))
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc))) h₁).Exact) ∧
          (∀ (a b c : ℕ) (habc : a + c = b),
            ∃ h₂ : CategoryTheory.CategoryStruct.comp
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
                (δ_M a b c habc) = 0,
              (CategoryTheory.ShortComplex.mk
                (τ_M c b (Nat.le.intro ((Nat.add_comm c a).trans habc)))
                (δ_M a b c habc) h₂).Exact) ∧
          (∀ (c₁ c₂ : ℕ) (hc : c₁ ≤ c₂),
            CategoryTheory.CategoryStruct.comp (j_M c₁ c₂ hc) (δ_M 1 (1 + c₂) c₂ rfl) =
              δ_M 1 (1 + c₁) c₁ rfl) ∧
          (∀ (r : ℕ) (x : weilEtaleTorsionH X (ℓ ^ (r + 1)) q),
            (τ_M r (r + 1) (Nat.le_succ r)).hom x =
              weilEtaleTorsionTransition X ℓ r q x) := by
      intro q
      let τ_M : ∀ m_idx n : ℕ, m_idx ≤ n →
          (AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ n) q) ⟶
            AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ m_idx) q)) :=
        fun m_idx n h =>
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ (C_X.map (red m_idx n h))).postcomp Fℤ_X
              (Nat.add_zero q))
      have hTransfer :
          ∀ (M₀ M'₀ : ℕ → AddCommGrpCat.{u})
            (τ₀ : ∀ m_idx n : ℕ, m_idx ≤ n → Quiver.Hom (M₀ n) (M₀ m_idx)),
            M₀ = (fun n => (H_q q).obj (A n)) →
            M'₀ = (fun n => (H_q (q + 1)).obj (A n)) →
            HEq τ₀ (fun m_idx n h => (H_q q).map (red m_idx n h)) →
            LadderPred q M₀ M'₀ τ₀ := by
        intro M₀ M'₀ τ₀ hM hM' hτ
        subst hM; subst hM'; cases hτ
        exact hLadder' q
      have hLP : LadderPred q
          (fun n => AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ n) q))
          (fun n => AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ n) (q + 1)))
          τ_M := by
        refine hTransfer _ _ _ (funext (hObj_eq q)) (funext (hObj_eq (q + 1))) ?_
        refine Function.hfunext rfl fun m_idx _ hm => ?_; cases hm
        refine Function.hfunext rfl fun n _ hn => ?_; cases hn
        refine Function.hfunext rfl fun h _ hh => ?_; cases hh
        have hmap : (H_q q).map (red m_idx n h) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ (C_X.map (red m_idx n h))).postcomp Fℤ_X
                (Nat.add_zero q)) :=
          CategoryTheory.Abelian.extFunctorObj_map _ _ _
        exact heq_of_eq hmap.symm
      obtain ⟨j_M, δ_M, h1, h2, h3, h4, h5, h6, h7, h8⟩ := hLP
      exact ⟨j_M, τ_M, δ_M, h1, h2, h3, h4, h5, h6, h7, h8, fun _ _ => rfl⟩
    refine ⟨?_, hLadder⟩
    intro hFin1 n i
    induction n with
    | zero =>
      obtain ⟨_, _, _, hTor0, _⟩ := hLadder i
      have h0 := hTor0 0
      rw [pow_zero, one_nsmul] at h0
      have hSub : Subsingleton (weilEtaleTorsionH X (ℓ ^ 0) i) := by
        refine ⟨fun x y => ?_⟩
        have hx : (CategoryTheory.CategoryStruct.id
            (AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ 0) i))).hom x = 0 := by
          rw [h0]; rfl
        have hy : (CategoryTheory.CategoryStruct.id
            (AddCommGrpCat.of (weilEtaleTorsionH X (ℓ ^ 0) i))).hom y = 0 := by
          rw [h0]; rfl
        exact hx.trans hy.symm
      exact Finite.of_subsingleton
    | succ n ih =>
      obtain ⟨j_M, τ_M, _, _, _, _, _, _, hEx1, _, _, _⟩ := hLadder i
      obtain ⟨h0, hEx⟩ := hEx1 1 (n + 1) n (Nat.add_comm 1 n)
      have hKerLe := (CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range).mp hEx
      let f_in := (j_M 1 (n + 1) (Nat.le.intro (Nat.add_comm 1 n))).hom
      let g_out := (τ_M n (n + 1) (Nat.le_succ n)).hom
      have _ : Finite (weilEtaleTorsionH X (ℓ ^ 1) i) := by
        simpa only [pow_one] using hFin1 i
      have _ : Finite ↥(AddMonoidHom.range g_out) := Subtype.finite
      have h_in_ker : ∀ a : weilEtaleTorsionH X (ℓ ^ 1) i, f_in a ∈ AddMonoidHom.ker g_out := by
        intro a
        change ((j_M 1 (n + 1) (Nat.le.intro (Nat.add_comm 1 n))) ≫
          (τ_M n (n + 1) (Nat.le_succ n))).hom a = 0
        rw [h0]
        rfl
      have hSurj_ker : Function.Surjective
          (fun a : weilEtaleTorsionH X (ℓ ^ 1) i =>
            (⟨f_in a, h_in_ker a⟩ : ↥(AddMonoidHom.ker g_out))) := by
        rintro ⟨b, hb⟩
        obtain ⟨a, ha⟩ := hKerLe hb
        exact ⟨a, Subtype.ext ha⟩
      have _ : Finite ↥(AddMonoidHom.ker g_out) := Finite.of_surjective _ hSurj_ker
      let Q_step := weilEtaleTorsionH X (ℓ ^ (n + 1)) i ⧸ AddMonoidHom.ker g_out
      have _ : Finite Q_step :=
        Finite.of_equiv ↥(AddMonoidHom.range g_out)
          (QuotientAddGroup.quotientKerEquivRange g_out).symm.toEquiv
      have hmk_surj : Function.Surjective
          (QuotientAddGroup.mk' (AddMonoidHom.ker g_out)) :=
        QuotientAddGroup.mk'_surjective _
      let sec : Q_step → weilEtaleTorsionH X (ℓ ^ (n + 1)) i :=
        fun q_el => Classical.choose (hmk_surj q_el)
      have hsec : ∀ q_el : Q_step,
          QuotientAddGroup.mk' (AddMonoidHom.ker g_out) (sec q_el) = q_el :=
        fun q_el => Classical.choose_spec (hmk_surj q_el)
      have hprod_surj : Function.Surjective
          (fun p : ↥(AddMonoidHom.ker g_out) × Q_step => p.1.1 + sec p.2) := by
        intro x
        let q_el := QuotientAddGroup.mk' (AddMonoidHom.ker g_out) x
        have hmem : x - sec q_el ∈ AddMonoidHom.ker g_out := by
          rw [← QuotientAddGroup.eq_zero_iff]
          change QuotientAddGroup.mk' (AddMonoidHom.ker g_out) (x - sec q_el) = 0
          rw [map_sub, hsec q_el, sub_self]
        exact ⟨(⟨x - sec q_el, hmem⟩, q_el), sub_add_cancel x (sec q_el)⟩
      exact Finite.of_surjective _ hprod_surj

  have hFinAlgClosed : ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀],
      (ℓ : K₀) ≠ 0 →
      ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
        [AlgebraicGeometry.IsProper X.hom] (n i : ℕ),
        Finite (weilEtaleTorsionH X.left (ℓ ^ n) i) := by
    intro K₀ _ _ hℓ₀ X _
    apply (hModPrimeLadderAndFin X.left).1
    intro i
    have hPBC₀ : WeilProperModPrimeBaseChangeHolds K₀ ℓ :=
      weil_etale_proper_base_change_mod_prime K₀ ℓ hℓ₀
    have hP1₀ : WeilP1ConstructiblePushforwardHolds K₀ ℓ :=
      weil_etale_p1_constructible_pushforward K₀ ℓ hℓ₀
        (fun k₁ _ _ C _ hIntC hProjC hℓ₁ =>
          weil_etale_smooth_proj_curve_mod_prime_cohomology k₁ C hIntC hProjC ℓ hℓ₁)
        hPBC₀
    let S_K₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)) :=
      CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
    letI : AlgebraicGeometry.LocallyOfFiniteType S_K₀.hom := by dsimp [S_K₀]; infer_instance
    letI : AlgebraicGeometry.QuasiCompact S_K₀.hom := by dsimp [S_K₀]; infer_instance
    letI : AlgebraicGeometry.IsSeparated S_K₀.hom := by dsimp [S_K₀]; infer_instance
    let f_term : X ⟶ S_K₀ := CategoryTheory.Over.homMk X.hom (Category.comp_id X.hom)
    obtain ⟨hConst_X, hExtr_X⟩ :=
      weil_etale_constructible_mod_prime_extraction_over_algClosed K₀ X ℓ i
    exact hExtr_X (weil_etale_proper_constructible_pushforward K₀ ℓ hℓ₀ hPBC₀ hP1₀ X S_K₀
      f_term (inferInstance : AlgebraicGeometry.IsProper X.hom)
      (weilEtaleTorsionSheaf X.left ℓ) hConst_X i)

  have hIntegralOfSmoothIrred : ∀ (Ω : Type u) [Field Ω] (d : ℕ)
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      [AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom]
      [IrreducibleSpace ↥Y.left],
      AlgebraicGeometry.IsIntegral Y.left := by
    intro Ω _ d Y hSm _
    have hRedStalk : ∀ x : ↥Y.left, _root_.IsReduced ↑(Y.left.presheaf.stalk x) := by
      intro x
      obtain ⟨U, _hU, V, hV, hx, e, hf⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d Y.hom).mp hSm x
      have : Nonempty U := ⟨⟨Y.hom.base x, e hx⟩⟩
      obtain ⟨g_et, _, hg_et⟩ := hf.exists_etale_mvPolynomial
      let _ : Algebra
          (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
          ↑Γ(Y.left, V) := g_et.toAlgebra
      have : Algebra.Etale
          (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
          ↑Γ(Y.left, V) := hg_et.toAlgebra
      have : _root_.IsReduced
          (TensorProduct
            (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
            (FractionRing (MvPolynomial (Fin d)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U)))
            ↑Γ(Y.left, V)) :=
        Algebra.FormallyUnramified.isReduced_of_field
          (FractionRing (MvPolynomial (Fin d)
            ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))) _
      have hInjPK : Function.Injective
          (Algebra.linearMap
            (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
            (FractionRing (MvPolynomial (Fin d)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U)))) :=
        fun _ _ h => IsFractionRing.injective _ _ h
      have hInjRT : Function.Injective
          (LinearMap.rTensor ↑Γ(Y.left, V)
            (Algebra.linearMap
              (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
              (FractionRing (MvPolynomial (Fin d)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))))) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ hInjPK
      have hEq : ∀ s : ↑Γ(Y.left, V),
          LinearMap.rTensor ↑Γ(Y.left, V)
            (Algebra.linearMap
              (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
              (FractionRing (MvPolynomial (Fin d)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))))
            ((TensorProduct.lid
              (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
              ↑Γ(Y.left, V)).symm s) =
            (Algebra.TensorProduct.includeRight :
              ↑Γ(Y.left, V) →ₐ[MvPolynomial (Fin d)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U)]
                TensorProduct
                  (MvPolynomial (Fin d)
                    ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
                  (FractionRing (MvPolynomial (Fin d)
                    ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U)))
                  ↑Γ(Y.left, V)) s := by
        intro s
        rw [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, Algebra.linearMap_apply, map_one,
          Algebra.TensorProduct.includeRight_apply]
      have hInj : Function.Injective
          (Algebra.TensorProduct.includeRight :
            ↑Γ(Y.left, V) →ₐ[MvPolynomial (Fin d)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U)]
              TensorProduct
                (MvPolynomial (Fin d)
                  ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
                (FractionRing (MvPolynomial (Fin d)
                  ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U)))
                ↑Γ(Y.left, V)) := by
        intro s₁ s₂ hs
        apply (TensorProduct.lid
          (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of Ω), U))
          ↑Γ(Y.left, V)).symm.injective
        apply hInjRT
        rw [hEq, hEq, hs]
      have hRedS : _root_.IsReduced ↑Γ(Y.left, V) := isReduced_of_injective _ hInj
      let xV : ↥V := ⟨x, hx⟩
      exact @isReduced_localizationPreserves ↑Γ(Y.left, V) _
        (hV.primeIdealOf xV).asIdeal.primeCompl
        ↑(Y.left.presheaf.stalk ↑xV) _
        (TopCat.Presheaf.algebra_section_stalk Y.left.presheaf xV)
        (hV.isLocalization_stalk xV) hRedS
    have _ : AlgebraicGeometry.IsReduced Y.left :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk Y.left
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y.left

  have hFinHom : ∀ (M_mod : ℕ) [NeZero M_mod] (H : Type u) [AddCommGroup H] [Finite H],
      Finite (H →+ ZMod M_mod) :=
    fun M_mod _ H _ _ =>
      Finite.of_injective (fun f : H →+ ZMod M_mod => (f : H → ZMod M_mod)) DFunLike.coe_injective

  have hDualCardLe : ∀ (M_mod : ℕ), 1 ≤ M_mod →
      ∀ (G : Type u) [AddCommGroup G] [Finite G],
        Nat.card (G →+ ZMod M_mod) ≤ Nat.card G := by
    intro M_mod hM
    have _ : NeZero M_mod := ⟨by omega⟩
    have hAux : ∀ (n : ℕ) (G : Type u) [AddCommGroup G] [Finite G],
        Nat.card G = n → Nat.card (G →+ ZMod M_mod) ≤ n := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro G _ _ hn
        by_cases hAll0 : ∀ x : G, x = 0
        · have hSubG : Subsingleton G := ⟨fun x y => (hAll0 x).trans (hAll0 y).symm⟩
          have hSubHom : Subsingleton (G →+ ZMod M_mod) := by
            refine ⟨fun f₁ f₂ => AddMonoidHom.ext fun x => ?_⟩
            rw [hAll0 x, map_zero, map_zero]
          have hG1 : Nat.card G = 1 := Nat.card_unique
          rw [← hn, hG1]
          exact Nat.card_unique.le
        · obtain ⟨g₀, hg₀_ne⟩ := not_forall.mp hAll0
          let S : AddSubgroup G := AddSubgroup.zmultiples g₀
          let Q := G ⧸ S
          let π : G →+ Q := QuotientAddGroup.mk' S
          have _ : Finite (G →+ ZMod M_mod) := hFinHom M_mod G
          have _ : Finite (Q →+ ZMod M_mod) := hFinHom M_mod Q
          have _ : Finite (↥S →+ ZMod M_mod) := hFinHom M_mod ↥S
          have hS_nontriv : Nontrivial ↥S :=
            ⟨⟨⟨0, S.zero_mem⟩, ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩,
              fun h => hg₀_ne (congrArg Subtype.val h).symm⟩⟩
          have hS_gt1 : 1 < Nat.card ↥S := Finite.one_lt_card
          have hLag : Nat.card ↥S * Nat.card Q = Nat.card G :=
            AddSubgroup.card_mul_index S
          have hQ_pos : 0 < Nat.card Q := Nat.card_pos
          have hQ_lt : Nat.card Q < n := by
            rw [← hn, ← hLag]
            exact lt_mul_of_one_lt_left hQ_pos hS_gt1
          have hIH_Q : Nat.card (Q →+ ZMod M_mod) ≤ Nat.card Q :=
            ih (Nat.card Q) hQ_lt Q rfl
          let res : (G →+ ZMod M_mod) →+ (↥S →+ ZMod M_mod) :=
            { toFun := fun φ => φ.comp S.subtype
              map_zero' := AddMonoidHom.ext fun _ => rfl
              map_add' := fun _ _ => AddMonoidHom.ext fun _ => rfl }
          have hKer_le : Nat.card ↥(AddMonoidHom.ker res) ≤ Nat.card Q := by
            let toKer : (Q →+ ZMod M_mod) → ↥(AddMonoidHom.ker res) :=
              fun ψ => ⟨ψ.comp π, AddMonoidHom.ext fun s => by
                change ψ (QuotientAddGroup.mk s.1) = 0
                rw [(QuotientAddGroup.eq_zero_iff s.1).mpr s.2, map_zero]⟩
            have hSurj_ker : Function.Surjective toKer := by
              rintro ⟨φ, hφ⟩
              have hle : S ≤ φ.ker := by
                intro x hx
                have hx0 : φ x = 0 :=
                  DFunLike.congr_fun (AddMonoidHom.mem_ker.mp hφ) ⟨x, hx⟩
                exact AddMonoidHom.mem_ker.mpr hx0
              refine ⟨QuotientAddGroup.lift S φ hle, Subtype.ext (AddMonoidHom.ext fun _ => rfl)⟩
            let _ : Fintype (Q →+ ZMod M_mod) := Fintype.ofFinite _
            let _ : Fintype ↥(AddMonoidHom.ker res) := Fintype.ofFinite _
            have h1 : Nat.card ↥(AddMonoidHom.ker res) ≤ Nat.card (Q →+ ZMod M_mod) := by
              rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
              exact Fintype.card_le_of_surjective toKer hSurj_ker
            exact h1.trans hIH_Q
          let d := addOrderOf g₀
          have hd_pos : 0 < d := addOrderOf_pos g₀
          have hd_le_S : d ≤ Nat.card ↥S := by
            let f_ord : Fin d → ↥S :=
              fun i => ⟨i.1 • g₀, S.nsmul_mem (AddSubgroup.mem_zmultiples g₀) i.1⟩
            have hf_inj : Function.Injective f_ord := by
              intro i j hij
              have hij_val : i.1 • g₀ = j.1 • g₀ := congrArg Subtype.val hij
              apply Fin.ext
              by_contra hne
              rcases lt_or_gt_of_ne hne with hlt | hgt
              · have hsub : (j.1 - i.1) • g₀ = 0 := by
                  have h1 : (j.1 - i.1 + i.1) • g₀ = 0 + i.1 • g₀ := by
                    rw [Nat.sub_add_cancel hlt.le, zero_add, hij_val]
                  rw [add_nsmul] at h1
                  exact add_right_cancel h1
                have hle_d := Nat.le_of_dvd (by omega) (addOrderOf_dvd_iff_nsmul_eq_zero.mpr hsub)
                omega
              · have hsub : (i.1 - j.1) • g₀ = 0 := by
                  have h1 : (i.1 - j.1 + j.1) • g₀ = 0 + j.1 • g₀ := by
                    rw [Nat.sub_add_cancel hgt.le, zero_add, ← hij_val]
                  rw [add_nsmul] at h1
                  exact add_right_cancel h1
                have hle_d := Nat.le_of_dvd (by omega) (addOrderOf_dvd_iff_nsmul_eq_zero.mpr hsub)
                omega
            simpa [Nat.card_fin] using Nat.card_le_card_of_injective f_ord hf_inj
          have hSHom_le : Nat.card (↥S →+ ZMod M_mod) ≤ Nat.card ↥S := by
            let g_gcd := Nat.gcd d M_mod
            have hg_pos : 0 < g_gcd := Nat.gcd_pos_of_pos_left M_mod hd_pos
            have hg_le_d : g_gcd ≤ d := Nat.gcd_le_left M_mod hd_pos
            let d' := d / g_gcd
            let M' := M_mod / g_gcd
            have hd_eq : d = g_gcd * d' := (Nat.mul_div_cancel' (Nat.gcd_dvd_left d M_mod)).symm
            have hM_eq : M_mod = g_gcd * M' :=
              (Nat.mul_div_cancel' (Nat.gcd_dvd_right d M_mod)).symm
            have hCop : Nat.Coprime d' M' := Nat.coprime_div_gcd_div_gcd hg_pos
            let evS : (↥S →+ ZMod M_mod) → Fin g_gcd := fun χ =>
              ⟨(χ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val / M', by
                have hlt : (χ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val < g_gcd * M' := by
                  rw [← hM_eq]
                  exact ZMod.val_lt _
                rw [mul_comm] at hlt
                exact Nat.div_lt_of_lt_mul hlt⟩
            have hev_inj : Function.Injective evS := by
              intro χ₁ χ₂ hχ
              have hdiv_eq :
                  (χ₁ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val / M' =
                  (χ₂ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val / M' :=
                congrArg Fin.val hχ
              have hdvd_M' : ∀ χ : ↥S →+ ZMod M_mod,
                  M' ∣ (χ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val := by
                intro χ
                set z := χ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩
                have hdz0 : d • z = 0 := by
                  change d • χ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩ = 0
                  rw [← map_nsmul]
                  have hg0_ord : (d • ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩ : ↥S) = 0 :=
                    Subtype.ext (addOrderOf_nsmul_eq_zero g₀)
                  rw [hg0_ord, map_zero]
                have hcast0 : ((d * z.val : ℕ) : ZMod M_mod) = 0 := by
                  simpa [nsmul_eq_mul] using hdz0
                have hM_dvd : M_mod ∣ d * z.val := (ZMod.natCast_eq_zero_iff _ M_mod).mp hcast0
                have hM_dvd' : g_gcd * M' ∣ g_gcd * (d' * z.val) := by
                  have h1 : g_gcd * M' = M_mod := hM_eq.symm
                  have h2 : g_gcd * (d' * z.val) = d * z.val := by rw [← mul_assoc, ← hd_eq]
                  rwa [h1, h2]
                exact hCop.symm.dvd_of_dvd_mul_left ((mul_dvd_mul_iff_left hg_pos.ne').mp hM_dvd')
              have hval_eq :
                  (χ₁ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val =
                  (χ₂ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩).val := by
                rw [← Nat.mul_div_cancel' (hdvd_M' χ₁), hdiv_eq,
                  Nat.mul_div_cancel' (hdvd_M' χ₂)]
              have hz_eq :
                  χ₁ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩ =
                  χ₂ ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩ :=
                ZMod.val_injective M_mod hval_eq
              apply AddMonoidHom.ext
              rintro ⟨x, hx⟩
              obtain ⟨k_int, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
              have hkx : (⟨k_int • g₀, hx⟩ : ↥S) = k_int • ⟨g₀, AddSubgroup.mem_zmultiples g₀⟩ :=
                Subtype.ext rfl
              rw [hkx, map_zsmul, map_zsmul, hz_eq]
            have h1 : Nat.card (↥S →+ ZMod M_mod) ≤ g_gcd := by
              simpa [Nat.card_fin] using Nat.card_le_card_of_injective evS hev_inj
            exact h1.trans (hg_le_d.trans hd_le_S)
          have hRange_le : Nat.card ↥(AddMonoidHom.range res) ≤ Nat.card ↥S :=
            (Nat.card_le_card_of_injective Subtype.val Subtype.val_injective).trans hSHom_le
          have hHom_prod :
              Nat.card ↥(AddMonoidHom.ker res) *
                Nat.card ((G →+ ZMod M_mod) ⧸ AddMonoidHom.ker res) =
              Nat.card (G →+ ZMod M_mod) :=
            AddSubgroup.card_mul_index (AddMonoidHom.ker res)
          have hQuot_eq :
              Nat.card ((G →+ ZMod M_mod) ⧸ AddMonoidHom.ker res) =
                Nat.card ↥(AddMonoidHom.range res) :=
            Nat.card_congr (QuotientAddGroup.quotientKerEquivRange res).toEquiv
          rw [hQuot_eq] at hHom_prod
          calc
            Nat.card (G →+ ZMod M_mod) =
                Nat.card ↥(AddMonoidHom.ker res) * Nat.card ↥(AddMonoidHom.range res) :=
              hHom_prod.symm
            _ ≤ Nat.card Q * Nat.card ↥S := Nat.mul_le_mul hKer_le hRange_le
            _ = Nat.card ↥S * Nat.card Q := mul_comm _ _
            _ = n := hLag.trans hn
    exact fun G _ _ => hAux (Nat.card G) G rfl

  have hNondegPairCardEq : ∀ (M_mod : ℕ), 1 ≤ M_mod →
      ∀ (A B : Type u) [AddCommGroup A] [Finite A] [AddCommGroup B] [Finite B]
        (pair : A →+ B →+ ZMod M_mod),
        (∀ a : A, (∀ b : B, pair a b = 0) → a = 0) →
        (∀ b : B, (∀ a : A, pair a b = 0) → b = 0) →
        Nat.card A = Nat.card B := by
    intro M_mod hM A B _ _ _ _ pair hLeft hRight
    have _ : NeZero M_mod := ⟨by omega⟩
    have _ : Finite (A →+ ZMod M_mod) := hFinHom M_mod A
    have _ : Finite (B →+ ZMod M_mod) := hFinHom M_mod B
    have hInjA : Function.Injective pair := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      exact hLeft a (fun b => by rw [ha]; rfl)
    let pairFlip : B →+ A →+ ZMod M_mod := pair.flip
    have hInjB : Function.Injective pairFlip := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      exact hRight b (fun a => DFunLike.congr_fun hb a)
    exact le_antisymm
      ((Nat.card_le_card_of_injective pair hInjA).trans (hDualCardLe M_mod hM B))
      ((Nat.card_le_card_of_injective pairFlip hInjB).trans (hDualCardLe M_mod hM A))

  have hNoethOfFinite : ∀ (X : AddCommGrpCat.{u}) [Finite ↥X],
      CategoryTheory.IsNoetherianObject X := by
    intro X _
    rw [CategoryTheory.isNoetherianObject_iff_not_strictMono]
    intro f hf
    let toSet : CategoryTheory.Subobject X → Set ↥X := fun S => Set.range S.arrow.hom
    have hInj : Function.Injective toSet := by
      intro S₁ S₂ hEq
      apply le_antisymm
      · refine CategoryTheory.Subobject.le_of_comm ?_ ?_
        · let g_fun : ↑(S₁ : AddCommGrpCat.{u}) → ↑(S₂ : AddCommGrpCat.{u}) :=
            fun x => Classical.choose (by
              have hx : S₁.arrow.hom x ∈ toSet S₂ := by rw [← hEq]; exact ⟨x, rfl⟩
              exact hx)
          have hg_spec : ∀ x, S₂.arrow.hom (g_fun x) = S₁.arrow.hom x :=
            fun x => Classical.choose_spec (by
              have hx : S₁.arrow.hom x ∈ toSet S₂ := by rw [← hEq]; exact ⟨x, rfl⟩
              exact hx)
          have hMono₂ : Function.Injective S₂.arrow.hom :=
            (AddCommGrpCat.mono_iff_injective S₂.arrow).mp inferInstance
          exact AddCommGrpCat.ofHom
            { toFun := g_fun
              map_zero' := hMono₂ ((hg_spec 0).trans (map_zero _ |>.trans (map_zero _).symm))
              map_add' := fun x y => hMono₂ ((hg_spec (x + y)).trans
                ((map_add _ x y).trans ((congrArg₂ (· + ·) (hg_spec x).symm (hg_spec y).symm).trans
                  (map_add _ _ _).symm))) }
        · apply AddCommGrpCat.ext; intro x
          exact Classical.choose_spec (by
            have hx : S₁.arrow.hom x ∈ toSet S₂ := by rw [← hEq]; exact ⟨x, rfl⟩
            exact hx)
      · refine CategoryTheory.Subobject.le_of_comm ?_ ?_
        · let g_fun : ↑(S₂ : AddCommGrpCat.{u}) → ↑(S₁ : AddCommGrpCat.{u}) :=
            fun x => Classical.choose (by
              have hx : S₂.arrow.hom x ∈ toSet S₁ := by rw [hEq]; exact ⟨x, rfl⟩
              exact hx)
          have hg_spec : ∀ x, S₁.arrow.hom (g_fun x) = S₂.arrow.hom x :=
            fun x => Classical.choose_spec (by
              have hx : S₂.arrow.hom x ∈ toSet S₁ := by rw [hEq]; exact ⟨x, rfl⟩
              exact hx)
          have hMono₁ : Function.Injective S₁.arrow.hom :=
            (AddCommGrpCat.mono_iff_injective S₁.arrow).mp inferInstance
          exact AddCommGrpCat.ofHom
            { toFun := g_fun
              map_zero' := hMono₁ ((hg_spec 0).trans (map_zero _ |>.trans (map_zero _).symm))
              map_add' := fun x y => hMono₁ ((hg_spec (x + y)).trans
                ((map_add _ x y).trans ((congrArg₂ (· + ·) (hg_spec x).symm (hg_spec y).symm).trans
                  (map_add _ _ _).symm))) }
        · apply AddCommGrpCat.ext; intro x
          exact Classical.choose_spec (by
            have hx : S₂.arrow.hom x ∈ toSet S₁ := by rw [hEq]; exact ⟨x, rfl⟩
            exact hx)
    have _ : Finite (CategoryTheory.Subobject X) := Finite.of_injective toSet hInj
    let f_fin : Fin (Nat.card (CategoryTheory.Subobject X) + 1) → CategoryTheory.Subobject X :=
      fun i => f i.1
    have hcard := Nat.card_le_card_of_injective f_fin (hf.injective.comp Fin.val_injective)
    rw [Nat.card_fin] at hcard
    omega

  have hArtinReesDichotomy :
      ∀ (M : ℕ → AddCommGrpCat.{u})
        (τ_M : ∀ m_idx n : ℕ, m_idx ≤ n → Quiver.Hom (M n) (M m_idx)),
        (∀ (n : ℕ) (h : n ≤ n), τ_M n n h = CategoryTheory.CategoryStruct.id (M n)) →
        (∀ (k_idx m_idx n : ℕ) (h₁ : k_idx ≤ m_idx) (h₂ : m_idx ≤ n),
          CategoryTheory.CategoryStruct.comp (τ_M m_idx n h₂) (τ_M k_idx m_idx h₁) =
            τ_M k_idx n (le_trans h₁ h₂)) →
        ∀ (n₀ c : ℕ)
          (ℐ 𝒩 𝒦 : ℕ → AddCommGrpCat.{u})
          (π_ℐ : ∀ r : ℕ, Quiver.Hom (M (n₀ + r + 1)) (ℐ r))
          (ι_ℐ : ∀ r : ℕ, Quiver.Hom (ℐ r) (M (r + 1)))
          (τ_ℐ : ∀ r : ℕ, Quiver.Hom (ℐ (r + 1)) (ℐ r))
          (q_𝒩 : ∀ r : ℕ, Quiver.Hom (ℐ r) (𝒩 r))
          (ι_𝒦 : ∀ r : ℕ, Quiver.Hom (𝒦 r) (ℐ r))
          (τ_𝒩 : ∀ r : ℕ, Quiver.Hom (𝒩 (r + 1)) (𝒩 r))
          (ι_bock : ∀ r : ℕ, Quiver.Hom (𝒩 r) (𝒩 (r + 1)))
          (ρ_bock : ∀ r : ℕ, Quiver.Hom (𝒩 (r + 1)) (𝒩 0)),
          (∀ r : ℕ,
            (CategoryTheory.CategoryStruct.comp (π_ℐ r) (ι_ℐ r) =
                τ_M (r + 1) (n₀ + r + 1) (Nat.le_add_left (r + 1) n₀) ∧
              CategoryTheory.CategoryStruct.comp (π_ℐ (r + 1)) (τ_ℐ r) =
                CategoryTheory.CategoryStruct.comp
                  (τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ (n₀ + r + 1))) (π_ℐ r)) ∧
            (ℓ ^ c) • CategoryTheory.CategoryStruct.id (𝒦 r) = 0 ∧
            ((∃ hK : CategoryTheory.CategoryStruct.comp (ι_𝒦 r) (q_𝒩 r) = 0,
                (CategoryTheory.ShortComplex.mk (ι_𝒦 r) (q_𝒩 r) hK).ShortExact) ∧
              CategoryTheory.CategoryStruct.comp (q_𝒩 (r + 1)) (τ_𝒩 r) =
                CategoryTheory.CategoryStruct.comp (τ_ℐ r) (q_𝒩 r)) ∧
            ((∃ hB : CategoryTheory.CategoryStruct.comp (ι_bock r) (ρ_bock r) = 0,
                (CategoryTheory.ShortComplex.mk (ι_bock r) (ρ_bock r) hB).ShortExact) ∧
              CategoryTheory.CategoryStruct.comp (ι_bock r) (τ_𝒩 r) =
                ℓ • CategoryTheory.CategoryStruct.id (𝒩 r) ∧
              CategoryTheory.CategoryStruct.comp (τ_𝒩 r) (ι_bock r) =
                CategoryTheory.CategoryStruct.comp (ι_bock (r + 1)) (τ_𝒩 (r + 1)))) →
          ∀ (Dom_sp Cod_sp H_Ω_mid H_Ω_low H_Ω_high : ℕ → Type u)
            [∀ r, AddCommGroup (Dom_sp r)] [∀ r, AddCommGroup (Cod_sp r)]
            [∀ r, AddCommGroup (H_Ω_mid r)] [∀ r, AddCommGroup (H_Ω_low r)]
            [∀ r, AddCommGroup (H_Ω_high r)]
            [∀ r, Finite ↑(M (r + 1))]
            [∀ r, Finite (H_Ω_mid r)] [∀ r, Finite (H_Ω_low r)] [∀ r, Finite (H_Ω_high r)]
            (sp_S : ∀ r : ℕ, Dom_sp r →+ Cod_sp r)
            (p_2m1 : ∀ r : ℕ, Dom_sp r →+ H_Ω_mid r)
            (ν : ∀ r : ℕ, H_Ω_mid r →+ ZMod (ℓ ^ (r + 1)))
            (β : ∀ r : ℕ, ZMod (ℓ ^ (r + 1)) →+ ↑(M (r + 1)))
            (sp_2m2 : ∀ r : ℕ, ↑(M (r + 1)) →+ H_Ω_high r),
            (∀ (r : ℕ) (y : Cod_sp r), (ℓ ^ (r + 1)) • y = 0) →
            (∀ (r : ℕ) (z : ZMod (ℓ ^ (r + 2))),
              (τ_M (r + 1) (r + 2) (Nat.le_succ (r + 1))).hom (β (r + 1) z) =
                β r (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) z)) →
            (∀ r : ℕ,
              AddMonoidHom.range (p_2m1 r) = AddMonoidHom.ker (ν r) ∧
              AddMonoidHom.range (ν r) = AddMonoidHom.ker (β r) ∧
              AddMonoidHom.range (β r) = AddMonoidHom.ker (sp_2m2 r) ∧
              Function.Surjective (sp_2m2 r)) →
            (∀ r : ℕ,
              Finite (Cod_sp r ⧸ AddMonoidHom.range (sp_S r)) ∧
              Nat.card (Cod_sp r ⧸ AddMonoidHom.range (sp_S r)) ≤
                Nat.card (H_Ω_mid r ⧸ AddMonoidHom.range (p_2m1 r)) ∧
              Nat.card (Cod_sp r ⧸ AddMonoidHom.range (sp_S r)) * Nat.card (H_Ω_low r) ≤
                Nat.card ↑(M (r + 1))) →
            (∀ r : ℕ, Nat.card (H_Ω_low r) = Nat.card (H_Ω_high r)) →
            ∃ C_s : ℕ, ∀ (r : ℕ) (y : Cod_sp r),
              (ℓ ^ C_s) • y ∈ AddMonoidHom.range (sp_S r) := by
    intro M τ_M hId_M hComp_M n₀ c ℐ 𝒩 𝒦 π_ℐ ι_ℐ τ_ℐ q_𝒩 ι_𝒦 τ_𝒩 ι_bock ρ_bock hAR
      Dom_sp Cod_sp H_Ω_mid H_Ω_low H_Ω_high _ _ _ _ _ _ _ _ _
      sp_S p_2m1 ν β sp_2m2 hTor_Cod hβ_trans hEx5 hBounds hPD
    let _ : ∀ k_pow : ℕ, NeZero (ℓ ^ k_pow) := fun k_pow => ⟨pow_ne_zero k_pow hPrime.ne_zero⟩
    have hnsmul_id : ∀ {A : AddCommGrpCat.{u}} (k_pow : ℕ) (x : ↑A),
        ((k_pow • CategoryTheory.CategoryStruct.id A).hom x) = k_pow • x := by
      intro A k_pow x
      induction k_pow with
      | zero => simp
      | succ k_pow ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((k_pow • CategoryTheory.CategoryStruct.id A).hom x) + x = k_pow • x + x
        rw [ih]
    let w : ∀ r : ℕ, ↑(M (r + 1)) := fun r => β r 1
    have hw_step : ∀ r : ℕ,
        (τ_M (r + 1) (r + 2) (Nat.le_succ (r + 1))).hom (w (r + 1)) = w r := by
      intro r
      dsimp [w]
      rw [hβ_trans r 1, map_one]
    have hw_add : ∀ (d r : ℕ),
        (τ_M (r + 1) (r + d + 1) (Nat.add_le_add_right (Nat.le_add_right r d) 1)).hom
          (w (r + d)) = w r := by
      intro d
      induction d with
      | zero =>
        intro r
        change (τ_M (r + 1) (r + 1) _).hom (w r) = w r
        rw [hId_M (r + 1)]
        rfl
      | succ d ih =>
        intro r
        have hle₁ : r + 1 ≤ r + d + 1 := Nat.add_le_add_right (Nat.le_add_right r d) 1
        have hle₂ : r + d + 1 ≤ r + (d + 1) + 1 := Nat.le_succ (r + d + 1)
        have hcomp := hComp_M (r + 1) (r + d + 1) (r + (d + 1) + 1) hle₁ hle₂
        have hle_eq :
            le_trans hle₁ hle₂ = Nat.add_le_add_right (Nat.le_add_right r (d + 1)) 1 :=
          Subsingleton.elim _ _
        rw [hle_eq] at hcomp
        rw [← hcomp]
        change (τ_M (r + 1) (r + d + 1) hle₁).hom
          ((τ_M (r + d + 1) (r + d + 2) hle₂).hom (w (r + d + 1))) = w r
        rw [hw_step (r + d)]
        exact ih r
    have hw_gen : ∀ (r_a r_b : ℕ) (hab : r_a + 1 ≤ r_b + 1),
        (τ_M (r_a + 1) (r_b + 1) hab).hom (w r_b) = w r_a := by
      intro r_a r_b hab
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_succ_le_succ hab)
      have hle_eq : hab = Nat.add_le_add_right (Nat.le_add_right r_a d) 1 :=
        Subsingleton.elim _ _
      rw [hle_eq]
      exact hw_add d r_a
    let u_seq : ∀ r : ℕ, ↑(ℐ r) := fun r => (π_ℐ r).hom (w (n₀ + r))
    let w_bar : ∀ r : ℕ, ↑(𝒩 r) := fun r => (q_𝒩 r).hom (u_seq r)
    have hu_step : ∀ r : ℕ, (τ_ℐ r).hom (u_seq (r + 1)) = u_seq r := by
      intro r
      dsimp [u_seq]
      change ((π_ℐ (r + 1)) ≫ (τ_ℐ r)).hom (w (n₀ + (r + 1))) = _
      rw [(hAR r).1.2]
      change (π_ℐ r).hom
        ((τ_M (n₀ + r + 1) (n₀ + (r + 1) + 1) (Nat.le_succ (n₀ + r + 1))).hom
          (w (n₀ + (r + 1)))) = _
      rw [hw_gen (n₀ + r) (n₀ + (r + 1)) (Nat.le_succ (n₀ + r + 1))]
    have hwbar_step : ∀ r : ℕ, (τ_𝒩 r).hom (w_bar (r + 1)) = w_bar r := by
      intro r
      dsimp [w_bar]
      change ((q_𝒩 (r + 1)) ≫ (τ_𝒩 r)).hom (u_seq (r + 1)) = _
      rw [(hAR r).2.2.1.2]
      change (q_𝒩 r).hom ((τ_ℐ r).hom (u_seq (r + 1))) = _
      rw [hu_step r]
    have hLagrange : ∀ (C_s : ℕ),
        (∀ r : ℕ, Nat.card (Cod_sp r ⧸ AddMonoidHom.range (sp_S r)) ≤ ℓ ^ C_s) →
        ∀ (r : ℕ) (y : Cod_sp r), (ℓ ^ C_s) • y ∈ AddMonoidHom.range (sp_S r) := by
      intro C_s hCardBound r y
      let Q_r := Cod_sp r ⧸ AddMonoidHom.range (sp_S r)
      have _ : Finite Q_r := (hBounds r).1
      let y_bar : Q_r := QuotientAddGroup.mk y
      have hy_tor : (ℓ ^ (r + 1)) • y_bar = 0 := by
        change QuotientAddGroup.mk ((ℓ ^ (r + 1)) • y) = 0
        rw [hTor_Cod r y, QuotientAddGroup.mk_zero]
      obtain ⟨e, _, hd_eq⟩ :=
        (Nat.dvd_prime_pow hPrime).mp (addOrderOf_dvd_iff_nsmul_eq_zero.mpr hy_tor)
      let f_ord : Fin (ℓ ^ e) → Q_r := fun i => i.1 • y_bar
      have hf_inj : Function.Injective f_ord := by
        intro i j hij
        apply Fin.ext
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · have hsub : (j.1 - i.1) • y_bar = 0 := by
            have h1 : (j.1 - i.1 + i.1) • y_bar = 0 + i.1 • y_bar := by
              rw [Nat.sub_add_cancel hlt.le, zero_add]; exact hij.symm
            rw [add_nsmul] at h1
            exact add_right_cancel h1
          have hle := Nat.le_of_dvd (by omega) (addOrderOf_dvd_iff_nsmul_eq_zero.mpr hsub)
          rw [hd_eq] at hle
          omega
        · have hsub : (i.1 - j.1) • y_bar = 0 := by
            have h1 : (i.1 - j.1 + j.1) • y_bar = 0 + j.1 • y_bar := by
              rw [Nat.sub_add_cancel hgt.le, zero_add]; exact hij
            rw [add_nsmul] at h1
            exact add_right_cancel h1
          have hle := Nat.le_of_dvd (by omega) (addOrderOf_dvd_iff_nsmul_eq_zero.mpr hsub)
          rw [hd_eq] at hle
          omega
      have hpow_le1 : ℓ ^ e ≤ Nat.card Q_r := by
        simpa [Nat.card_fin] using Nat.card_le_card_of_injective f_ord hf_inj
      have he_le : e ≤ C_s :=
        (Nat.pow_le_pow_iff_right hPrime.one_lt).mp (hpow_le1.trans (hCardBound r))
      have h_ann : (ℓ ^ C_s) • y_bar = 0 := by
        apply addOrderOf_dvd_iff_nsmul_eq_zero.mp
        rw [hd_eq]
        exact pow_dvd_pow ℓ he_le
      exact (QuotientAddGroup.eq_zero_iff _).mp h_ann
    by_cases hCaseA : ∀ r : ℕ, w_bar r = 0
    · refine ⟨c, hLagrange c (fun r => ?_)⟩
      obtain ⟨hK, hSE_K⟩ := (hAR r).2.2.1.1
      have hKerLe := (CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range).mp hSE_K.exact
      obtain ⟨z_r, hz_r⟩ := hKerLe (hCaseA r)
      have hz_ann : (ℓ ^ c) • z_r = 0 := by
        rw [← hnsmul_id (ℓ ^ c) z_r, (hAR r).2.1]
        rfl
      have hu_ann : (ℓ ^ c) • u_seq r = 0 := by
        rw [← hz_r, ← map_nsmul, hz_ann, map_zero]
      have hw_ann : (ℓ ^ c) • w r = 0 := by
        have h1 : (ι_ℐ r).hom (u_seq r) = w r := by
          change ((π_ℐ r) ≫ (ι_ℐ r)).hom (w (n₀ + r)) = w r
          rw [(hAR r).1.1]
          exact hw_gen r (n₀ + r) (Nat.le_add_left (r + 1) n₀)
        rw [← h1, ← map_nsmul, hu_ann, map_zero]
      have hRange_β_le : Nat.card ↥(AddMonoidHom.range (β r)) ≤ ℓ ^ c := by
        let f_surj : Fin (ℓ ^ c) → ↥(AddMonoidHom.range (β r)) :=
          fun k_fin => ⟨k_fin.1 • w r, ⟨(k_fin.1 : ZMod (ℓ ^ (r + 1))), by
            dsimp [w]
            rw [← map_nsmul, nsmul_one]⟩⟩
        have hf_surj : Function.Surjective f_surj := by
          rintro ⟨_, ⟨z, rfl⟩⟩
          have hz_eq : β r z = z.val • w r := by
            dsimp [w]
            rw [← map_nsmul, nsmul_one, ZMod.natCast_zmod_val]
          refine ⟨⟨z.val % (ℓ ^ c), Nat.mod_lt _ (pow_pos hPrime.pos c)⟩, Subtype.ext ?_⟩
          change (z.val % (ℓ ^ c)) • w r = β r z
          rw [hz_eq]
          conv_rhs => rw [← Nat.div_add_mod z.val (ℓ ^ c)]
          rw [add_nsmul, mul_comm (ℓ ^ c) _, mul_nsmul', hw_ann, smul_zero, zero_add]
        let _ : Fintype ↥(AddMonoidHom.range (β r)) := Fintype.ofFinite _
        rw [Nat.card_eq_fintype_card]
        exact (Fintype.card_le_of_surjective f_surj hf_surj).trans_eq (Fintype.card_fin _)
      obtain ⟨_, _, hRangeEqKer, hSurj_sp2m2⟩ := hEx5 r
      have hCard_M :
          Nat.card ↑(M (r + 1)) =
            Nat.card ↥(AddMonoidHom.range (β r)) * Nat.card (H_Ω_high r) := by
        have hLag_M :
            Nat.card ↥(AddMonoidHom.ker (sp_2m2 r)) *
              Nat.card (↑(M (r + 1)) ⧸ AddMonoidHom.ker (sp_2m2 r)) =
            Nat.card ↑(M (r + 1)) :=
          AddSubgroup.card_mul_index (AddMonoidHom.ker (sp_2m2 r))
        have hQuot_M :
            Nat.card (↑(M (r + 1)) ⧸ AddMonoidHom.ker (sp_2m2 r)) = Nat.card (H_Ω_high r) :=
          Nat.card_congr
            (QuotientAddGroup.quotientKerEquivOfSurjective (sp_2m2 r) hSurj_sp2m2).toEquiv
        rw [hQuot_M, ← hRangeEqKer] at hLag_M
        exact hLag_M.symm
      have hMul_ineq :
          Nat.card (Cod_sp r ⧸ AddMonoidHom.range (sp_S r)) * Nat.card (H_Ω_low r) ≤
            (ℓ ^ c) * Nat.card (H_Ω_low r) := by
        calc
          Nat.card (Cod_sp r ⧸ AddMonoidHom.range (sp_S r)) * Nat.card (H_Ω_low r)
              ≤ Nat.card ↑(M (r + 1)) := (hBounds r).2.2
          _ = Nat.card ↥(AddMonoidHom.range (β r)) * Nat.card (H_Ω_high r) := hCard_M
          _ = Nat.card ↥(AddMonoidHom.range (β r)) * Nat.card (H_Ω_low r) := by rw [← hPD r]
          _ ≤ (ℓ ^ c) * Nat.card (H_Ω_low r) := Nat.mul_le_mul_right _ hRange_β_le
      exact Nat.le_of_mul_le_mul_right hMul_ineq Nat.card_pos
    · obtain ⟨r₀, hr₀_ne⟩ := not_forall.mp hCaseA
      let iter_bock : ∀ d : ℕ, Quiver.Hom (𝒩 r₀) (𝒩 (r₀ + d)) := fun d =>
        Nat.rec (motive := fun k_step => Quiver.Hom (𝒩 r₀) (𝒩 (r₀ + k_step)))
          (CategoryTheory.CategoryStruct.id (𝒩 r₀))
          (fun k_step prev => CategoryTheory.CategoryStruct.comp prev (ι_bock (r₀ + k_step))) d
      have hIter_inj : ∀ d : ℕ, Function.Injective (iter_bock d).hom := by
        intro d
        induction d with
        | zero => exact Function.injective_id
        | succ d ih =>
          obtain ⟨_, hSE_B⟩ := (hAR (r₀ + d)).2.2.2.1
          exact ((AddCommGrpCat.mono_iff_injective _).mp hSE_B.mono_f).comp ih
      have hIter_eq : ∀ d : ℕ, (iter_bock d).hom (w_bar r₀) = (ℓ ^ d) • w_bar (r₀ + d) := by
        intro d
        induction d with
        | zero => simp [iter_bock]
        | succ d ih =>
          change (ι_bock (r₀ + d)).hom ((iter_bock d).hom (w_bar r₀)) =
            (ℓ ^ (d + 1)) • w_bar (r₀ + d + 1)
          rw [ih, map_nsmul, ← hwbar_step (r₀ + d)]
          change (ℓ ^ d) • ((τ_𝒩 (r₀ + d)) ≫ (ι_bock (r₀ + d))).hom (w_bar (r₀ + d + 1)) = _
          rw [(hAR (r₀ + d)).2.2.2.2.2, (hAR (r₀ + d + 1)).2.2.2.2.1,
            hnsmul_id ℓ (w_bar (r₀ + d + 1)), ← mul_nsmul', ← pow_succ]
      have hwbar_ann_of_w : ∀ (d k_step m_idx : ℕ), m_idx = n₀ + k_step →
          (ℓ ^ d) • w m_idx = 0 → (ℓ ^ d) • w_bar k_step = 0 := by
        intro d k_step m_idx hm h0
        subst hm
        dsimp [w_bar, u_seq]
        rw [← map_nsmul, ← map_nsmul, h0, map_zero, map_zero]
      have hw_pow_ne : ∀ d : ℕ, (ℓ ^ d) • w (n₀ + r₀ + d) ≠ 0 := by
        intro d h0
        have hwbar_ne : (ℓ ^ d) • w_bar (r₀ + d) ≠ 0 := by
          rw [← hIter_eq d]
          intro h_it0
          exact hr₀_ne (hIter_inj d (h_it0.trans (map_zero _).symm))
        exact hwbar_ne (hwbar_ann_of_w d (r₀ + d) (n₀ + r₀ + d) (by omega) h0)
      let C_s := n₀ + r₀ + 1
      refine ⟨C_s, hLagrange C_s (fun r => ?_)⟩
      obtain ⟨hRangeP_eq_KerNu, hRangeNu_eq_KerBeta, _, _⟩ := hEx5 r
      have hCokerP_eq_KerBeta :
          Nat.card (H_Ω_mid r ⧸ AddMonoidHom.range (p_2m1 r)) =
            Nat.card ↥(AddMonoidHom.ker (β r)) := by
        rw [hRangeP_eq_KerNu, ← hRangeNu_eq_KerBeta]
        exact Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (ν r)).toEquiv
      refine ((hBounds r).2.1).trans ?_
      rw [hCokerP_eq_KerBeta]
      by_cases hr_lt : r < n₀ + r₀
      · have hle_tot : Nat.card ↥(AddMonoidHom.ker (β r)) ≤ Nat.card (ZMod (ℓ ^ (r + 1))) :=
          Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
        rw [Nat.card_zmod] at hle_tot
        exact hle_tot.trans (pow_le_pow_right₀ hPrime.one_lt.le (by omega))
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (not_lt.mp hr_lt)
        let N_exp := n₀ + r₀ + d + 1
        have hKer_div : ∀ z ∈ AddMonoidHom.ker (β (n₀ + r₀ + d)), ℓ ^ (d + 1) ∣ z.val := by
          intro z hz
          let g := Nat.gcd z.val (ℓ ^ N_exp)
          have hbez : (g : ℤ) = (z.val : ℤ) * Nat.gcdA z.val (ℓ ^ N_exp) +
              ((ℓ ^ N_exp : ℕ) : ℤ) * Nat.gcdB z.val (ℓ ^ N_exp) :=
            Nat.gcd_eq_gcd_ab z.val (ℓ ^ N_exp)
          have hg_cast : ((g : ℕ) : ZMod (ℓ ^ N_exp)) = (Nat.gcdA z.val (ℓ ^ N_exp)) • z := by
            have h1 := congrArg (Int.cast : ℤ → ZMod (ℓ ^ N_exp)) hbez
            simp only [Int.cast_natCast, Int.cast_add, Int.cast_mul, ZMod.natCast_self,
              zero_mul, add_zero, ZMod.natCast_zmod_val] at h1
            rw [h1, mul_comm, zsmul_eq_mul]
          have hg_mem : ((g : ℕ) : ZMod (ℓ ^ N_exp)) ∈ AddMonoidHom.ker (β (n₀ + r₀ + d)) := by
            rw [hg_cast]
            exact (AddMonoidHom.ker (β (n₀ + r₀ + d))).zsmul_mem hz _
          obtain ⟨e, _, hg_eq⟩ :=
            (Nat.dvd_prime_pow hPrime).mp (Nat.gcd_dvd_right z.val (ℓ ^ N_exp))
          have hd_lt_e : d + 1 ≤ e := by
            by_contra hle_d
            have he_le : e ≤ d := by omega
            have hpow_d : ((ℓ ^ d : ℕ) : ZMod (ℓ ^ N_exp)) ∈
                AddMonoidHom.ker (β (n₀ + r₀ + d)) := by
              have hmul : ℓ ^ d = ℓ ^ (d - e) * g := by
                dsimp only [g]
                rw [hg_eq, ← pow_add, Nat.sub_add_cancel he_le]
              have hns : ((ℓ ^ d : ℕ) : ZMod (ℓ ^ N_exp)) =
                  (ℓ ^ (d - e)) • ((g : ℕ) : ZMod (ℓ ^ N_exp)) := by
                rw [hmul, Nat.cast_mul, nsmul_eq_mul, Nat.cast_pow]
              rw [hns]
              exact (AddMonoidHom.ker (β (n₀ + r₀ + d))).nsmul_mem hg_mem _
            have hβ0 : β (n₀ + r₀ + d) ((ℓ ^ d : ℕ) : ZMod (ℓ ^ N_exp)) = 0 := hpow_d
            have hβ_w : β (n₀ + r₀ + d) ((ℓ ^ d : ℕ) : ZMod (ℓ ^ N_exp)) =
                (ℓ ^ d) • w (n₀ + r₀ + d) := by
              dsimp [w]
              rw [← map_nsmul, nsmul_one]
            exact hw_pow_ne d (hβ_w.symm.trans hβ0)
          exact (pow_dvd_pow ℓ hd_lt_e).trans (hg_eq ▸ Nat.gcd_dvd_left z.val (ℓ ^ N_exp))
        let f_ker : ↥(AddMonoidHom.ker (β (n₀ + r₀ + d))) → Fin (ℓ ^ (n₀ + r₀)) :=
          fun z => ⟨z.1.val / ℓ ^ (d + 1), by
            have hlt : z.1.val < ℓ ^ (n₀ + r₀) * ℓ ^ (d + 1) := by
              rw [← pow_add]
              exact z.1.val_lt
            rw [mul_comm] at hlt
            exact Nat.div_lt_of_lt_mul hlt⟩
        have hf_ker_inj : Function.Injective f_ker := by
          intro z₁ z₂ hz
          have hdiv : z₁.1.val / ℓ ^ (d + 1) = z₂.1.val / ℓ ^ (d + 1) := congrArg Fin.val hz
          have hval : z₁.1.val = z₂.1.val := by
            rw [← Nat.mul_div_cancel' (hKer_div z₁.1 z₁.2), hdiv,
              Nat.mul_div_cancel' (hKer_div z₂.1 z₂.2)]
          exact Subtype.ext (ZMod.val_injective _ hval)
        have hle1 : Nat.card ↥(AddMonoidHom.ker (β (n₀ + r₀ + d))) ≤ ℓ ^ (n₀ + r₀) := by
          simpa [Nat.card_fin] using Nat.card_le_card_of_injective f_ker hf_ker_inj
        exact hle1.trans (pow_le_pow_right₀ hPrime.one_lt.le (Nat.le_succ _))

  
  rcases h1d with ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, hu₀_mem, hSm_U₀,
    ⟨x_inf, hx_inf, hSm_inf, hOdp_inf⟩, hAff_odp⟩
  let D₀ := weilProjectiveSpaceOver F 1
  let k := AlgebraicClosure F
  let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let pr_D : Quiver.Hom (weilGeomScheme F D₀) D₀.left :=
    CategoryTheory.Limits.pullback.fst D₀.hom f_ext
  let pr_Z : Quiver.Hom (weilGeomScheme F Z_tilde) Z_tilde.left :=
    CategoryTheory.Limits.pullback.fst Z_tilde.hom f_ext
