    let e_ker := RingHom.quotientKerEquivOfSurjective hα_surj
    let ψ : k →+* K := q_hom.comp e_ker.symm.toRingHom
    have hαψ : α ≫ CommRingCat.ofHom ψ = β := by
      ext r
      change q_hom (e_ker.symm (α.hom r)) = β.hom r
      have hmk : e_ker (Ideal.Quotient.mk (RingHom.ker α.hom) r) = α.hom r :=
        RingHom.quotientKerEquivOfSurjective_apply_mk hα_surj r
      rw [← hmk, e_ker.symm_apply_apply]
      exact Ideal.Quotient.lift_mk (RingHom.ker α.hom) β.hom _
    let u : S_K ⟶ S_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
    have hu_aff : u ≫ s_aff = z_aff := by
      calc u ≫ s_aff
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ AlgebraicGeometry.Spec.map α := by
              rw [AlgebraicGeometry.Spec.map_preimage]
        _ = AlgebraicGeometry.Spec.map (α ≫ CommRingCat.ofHom ψ) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = z_aff := by
              rw [hαψ, AlgebraicGeometry.Spec.map_preimage]
    refine ⟨u, ?_⟩
    rw [← hs_fac, ← CategoryTheory.Category.assoc, hu_aff, hz_fac]
  
  have hEmptyZero : ∀ (P : AlgebraicGeometry.Scheme.{u}) [IsEmpty ↥P]
