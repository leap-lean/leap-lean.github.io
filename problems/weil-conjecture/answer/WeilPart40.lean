    (CategoryTheory.Limits.cokernel (η_sp r))
  have hconj : e_cok.inv ≫ ((ℓ ^ C_sp) • CategoryTheory.CategoryStruct.id 𝒬) ≫ e_cok.hom =
      (ℓ ^ C_sp) • CategoryTheory.CategoryStruct.id 𝒢 := by
    rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
      CategoryTheory.Category.id_comp, e_cok.inv_hom_id]
  have hzero : e_cok.inv ≫ ((ℓ ^ C_sp) • CategoryTheory.CategoryStruct.id 𝒬) ≫ e_cok.hom = 0 :=
    hconj.trans hCok_ann
  have hzero' : ((ℓ ^ C_sp) • CategoryTheory.CategoryStruct.id 𝒬) ≫ e_cok.hom = 0 :=
    (CategoryTheory.cancel_epi e_cok.inv).mp (hzero.trans CategoryTheory.Limits.comp_zero.symm)
  exact (CategoryTheory.cancel_mono e_cok.hom).mp (hzero'.trans CategoryTheory.Limits.zero_comp.symm)

theorem weil_odp_wit_p1_inf_dvr_chart_bridge (F : Type u) [Field F]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base) :
    ∃ (V_inf : Type u) (_ : CommRing V_inf)
      (j_V : Polynomial F →+* V_inf)
      (π_0 : V_inf →+* F)
      (ι_inv : V_inf →+* RatFunc F)
      (g_inf_0 : AlgebraicGeometry.Spec (CommRingCat.of V_inf) ⟶
        (weilProjectiveSpaceOver F 1).left),
      (∀ p : Polynomial F, Polynomial.eval 0 p ≠ 0 → IsUnit (j_V p)) ∧
      (∀ {A : Type u} [CommRing A] (f : Polynomial F →+* A),
        (∀ p : Polynomial F, Polynomial.eval 0 p ≠ 0 → IsUnit (f p)) →
        ∃! f_lift : V_inf →+* A, f_lift.comp j_V = f) ∧
      π_0.comp j_V = Polynomial.evalRingHom 0 ∧
      ι_inv.comp (j_V.comp Polynomial.C) = algebraMap F (RatFunc F) ∧
      ι_inv (j_V Polynomial.X) = (RatFunc.X : RatFunc F)⁻¹ ∧
      g_inf_0 ≫ (weilProjectiveSpaceOver F 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (j_V.comp Polynomial.C)) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_0) ≫ g_inf_0 = s_inf ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_inv) ≫ g_inf_0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) (RatFunc F))) ≫
          j_aff :=
by
  classical
  let _ : AlgebraicGeometry.IsOpenImmersion j_aff := hj_open
  have hSep : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver F 1).hom := by
    dsimp [weilProjectiveSpaceOver]
    infer_instance
  let _ : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver F 1).hom := hSep

  
  
  
  let P := MvPolynomial (Fin 2) F
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) F
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := default
  let x₀ : ProjectiveSpectrum 𝒜 := s_inf pt₀

  have hex_i₀ : ∃ i₀ : Fin 2, MvPolynomial.X i₀ ∉ x₀.asHomogeneousIdeal := by
    by_contra! hAll
    apply x₀.not_irrelevant_le
    intro p hp
    have h0 : (((DirectSum.decompose 𝒜) p 0 : ↥(𝒜 0)) : MvPolynomial (Fin 2) F) = 0 := by
      have hp0 : GradedRing.proj 𝒜 0 p = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      rwa [GradedRing.proj_apply] at hp0
    have hcoeff0 : (p : MvPolynomial (Fin 2) F).coeff 0 = 0 := by
      conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 p]
      rw [MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro n _
      by_cases hn : n = 0
      · subst hn
        simp [h0]
      · let qn : ↥(𝒜 n) := (DirectSum.decompose 𝒜) p n
        have hqn : MvPolynomial.IsHomogeneous qn.1 n :=
          (MvPolynomial.mem_homogeneousSubmodule n qn.1).mp qn.2
        by_contra hne
        have hdeg := hqn hne
        rw [map_zero] at hdeg
        exact hn hdeg.symm
    have hp_span : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd_ne : d ≠ 0 := by
        intro hd0
        subst hd0
        exact (MvPolynomial.mem_support_iff.mp hd) hcoeff0
      have hex_j : ∃ j : Fin 2, d j ≠ 0 := by
        by_contra! hall0
        apply hd_ne
        ext j
        exact hall0 j
      obtain ⟨j, hj⟩ := hex_j
      exact ⟨j, Set.mem_univ j, hj⟩
    have hspan_le : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) ≤
        x₀.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨j, _, rfl⟩
      exact hAll j
    exact hspan_le hp_span
  obtain ⟨i₀, hi₀⟩ := hex_i₀

  let i₁ : Fin 2 := if i₀ = 0 then 1 else 0
  have hi₁_ne : i₁ ≠ i₀ := by
    dsimp [i₁]
    fin_cases i₀ <;> decide
  have hj_cases : ∀ j : Fin 2, j = i₀ ∨ j = i₁ := by
    intro j
    dsimp [i₁]
    fin_cases i₀ <;> fin_cases j <;> decide

  let X₀ : P := MvPolynomial.X i₀
  let X₁ : P := MvPolynomial.X i₁
  have hX_mem : ∀ r : Fin 2, (MvPolynomial.X r : P) ∈ 𝒜 1 := fun r =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X r)).mpr
      (MvPolynomial.isHomogeneous_X F r)
  have hdeg : X₀ ∈ 𝒜 1 := hX_mem i₀
  let H₀ := HomogeneousLocalization.Away 𝒜 X₀
  let M₀ : Submonoid P := Submonoid.powers X₀
  have hpow_mem : ∀ n : ℕ, X₀ ^ n ∈ M₀ := fun n =>
    pow_mem (Submonoid.mem_powers X₀) n
  let ι_F : F →+* H₀ :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜 M₀).comp (algebraMap F ↥(𝒜 0))
  have hι_val : ∀ c : F, (ι_F c).val = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
    intro c
    change (HomogeneousLocalization.mk _).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
    rw [HomogeneousLocalization.val_mk]
    rfl
  let u₁ : H₀ :=
    HomogeneousLocalization.mk
      { deg := 1
        num := ⟨X₁, hX_mem i₁⟩
        den := ⟨X₀, hdeg⟩
        den_mem := Submonoid.mem_powers X₀ }
  let α₀ : Polynomial F →+* H₀ := Polynomial.eval₂RingHom ι_F u₁
  let w : Fin 2 → Polynomial F := fun j =>
    if j = i₀ then 1 else Polynomial.X
  let dehom : P →+* Polynomial F := MvPolynomial.eval₂Hom Polynomial.C w
  have hdehom_X₀ : dehom X₀ = 1 := by
    dsimp [dehom, X₀, w]
    rw [MvPolynomial.eval₂Hom_X']
    simp
  have hdehom_mem : ∀ y : M₀, dehom y.1 = 1 := by
    rintro ⟨_, n, rfl⟩
    simp [map_pow, hdehom_X₀]
  have hUnit : ∀ y : M₀, IsUnit (dehom y.1) := by
    intro y
    rw [hdehom_mem y]
    exact isUnit_one
  let β_loc : Localization M₀ →+* Polynomial F := IsLocalization.lift hUnit
  have hβ_loc_mk : ∀ (p : P) (y : M₀), β_loc (Localization.mk p y) = dehom p := by
    intro p y
    rw [Localization.mk_eq_mk']
    exact (IsLocalization.lift_mk'_spec hUnit p (dehom p) y).mpr
      (by rw [hdehom_mem y, one_mul])
  let valHom : H₀ →+* Localization M₀ :=
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := fun x y => HomogeneousLocalization.val_mul x y
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := fun x y => HomogeneousLocalization.val_add x y }
  let β₀ : H₀ →+* Polynomial F := β_loc.comp valHom
  have h_left : ∀ q : Polynomial F, β₀ (α₀ q) = q := by
    have hcomp : β₀.comp α₀ = RingHom.id (Polynomial F) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change β_loc (α₀ (Polynomial.C c)).val = Polynomial.C c
        simp only [α₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [hι_val c, hβ_loc_mk]
        dsimp [dehom]
        rw [MvPolynomial.eval₂Hom_C]
      · change β_loc (α₀ Polynomial.X).val = Polynomial.X
        simp only [α₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        dsimp [u₁]
        rw [hβ_loc_mk]
        dsimp [dehom, w, X₁]
        rw [MvPolynomial.eval₂Hom_X']
        simp [hi₁_ne]
    intro q
    exact RingHom.congr_fun hcomp q
  let φ_homog : P →+* Localization M₀ := valHom.comp (α₀.comp dehom)
  have hφ_C : ∀ c : F, φ_homog (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
    intro c
    change (α₀ (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
    dsimp [dehom, α₀]
    rw [MvPolynomial.eval₂Hom_C, Polynomial.eval₂_C]
    exact hι_val c
  have hφ_X : ∀ j : Fin 2,
      φ_homog (MvPolynomial.X j) =
        Localization.mk (MvPolynomial.X j) (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀) := by
    intro j
    change (α₀ (dehom (MvPolynomial.X j))).val =
      Localization.mk (MvPolynomial.X j) (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀)
    dsimp [dehom]
    rw [MvPolynomial.eval₂Hom_X']
    dsimp [w]
    rcases hj_cases j with rfl | rfl
    · simp only [↓reduceIte, map_one, HomogeneousLocalization.val_one]
      exact (Localization.mk_self (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀)).symm
    · simp only [hi₁_ne, ↓reduceIte, α₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      dsimp [u₁, X₁]
  have hφ_prod : ∀ (s_fin : Finset (Fin 2)) (d : Fin 2 →₀ ℕ),
      φ_homog (∏ j ∈ s_fin, (MvPolynomial.X j : P) ^ d j) =
        Localization.mk (∏ j ∈ s_fin, (MvPolynomial.X j : P) ^ d j)
          ⟨X₀ ^ (∑ j ∈ s_fin, d j), hpow_mem (∑ j ∈ s_fin, d j)⟩ := by
    intro s_fin d
    induction s_fin using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
      exact (Localization.mk_self (1 : M₀)).symm
    | @insert j s_fin hj ih =>
      rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
        Localization.mk_pow, Localization.mk_mul]
      congr 1
      apply Subtype.ext
      change X₀ ^ d j * X₀ ^ (∑ r ∈ s_fin, d r) = X₀ ^ (d j + ∑ r ∈ s_fin, d r)
      rw [← pow_add]
  have hφ_monomial : ∀ (d : Fin 2 →₀ ℕ) (c : F) (n : ℕ),
      (Finsupp.weight 1) d = n →
      φ_homog (MvPolynomial.monomial d c) =
        Localization.mk (MvPolynomial.monomial d c) ⟨X₀ ^ n, hpow_mem n⟩ := by
    intro d c n hdn
    have hsum : ∑ j ∈ d.support, d j = n := by
      have hw : (Finsupp.weight (1 : Fin 2 → ℕ)) d = ∑ j ∈ d.support, d j := by
        simp [Finsupp.weight_apply, Finsupp.sum]
      exact hw.symm.trans hdn
    rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C c, hφ_prod d.support d,
      Localization.mk_mul]
    congr 1
    apply Subtype.ext
    change (1 : P) * X₀ ^ (∑ j ∈ d.support, d j) = X₀ ^ n
    rw [one_mul, hsum]
  have hφ_isHomog : ∀ (n : ℕ) (p : P), p.IsHomogeneous n →
      φ_homog p = Localization.mk p ⟨X₀ ^ n, hpow_mem n⟩ := by
    intro n p hp
    have h_sum_aux : ∀ (S_fin : Finset (Fin 2 →₀ ℕ)),
        (∀ d ∈ S_fin, (Finsupp.weight 1) d = n) →
        φ_homog (∑ d ∈ S_fin, MvPolynomial.monomial d ((p : MvPolynomial (Fin 2) F).coeff d)) =
          Localization.mk
            (∑ d ∈ S_fin, MvPolynomial.monomial d ((p : MvPolynomial (Fin 2) F).coeff d))
            ⟨X₀ ^ n, hpow_mem n⟩ := by
      intro S_fin hS
      induction S_fin using Finset.induction_on with
      | empty =>
        simp [Localization.mk_zero]
      | @insert d S_fin hd ih =>
        rw [Finset.sum_insert hd, map_add,
          hφ_monomial d ((p : MvPolynomial (Fin 2) F).coeff d) n
            (hS d (Finset.mem_insert_self d S_fin)),
          ih (fun d' hd' => hS d' (Finset.mem_insert_of_mem hd')),
          Localization.add_mk_self]
    conv_lhs => rw [MvPolynomial.as_sum p]
    conv_rhs => rw [MvPolynomial.as_sum p]
    exact h_sum_aux p.support (fun d hd => hp (MvPolynomial.mem_support_iff.mp hd))
  have h_right : ∀ z : H₀, α₀ (β₀ z) = z := by
    intro z
    refine Quotient.inductionOn' z fun nd => ?_
    apply HomogeneousLocalization.val_injective
    obtain ⟨n, hn⟩ := nd.den_mem
    dsimp only at hn
    have hX₀n_ne : (X₀ ^ n : MvPolynomial (Fin 2) F) ≠ 0 := by
      intro hzero
      have hev := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (1 : F))) hzero
      simp [X₀] at hev
    have hex_d₀ : ∃ d₀ : Fin 2 →₀ ℕ,
        ((X₀ ^ n : MvPolynomial (Fin 2) F)).coeff d₀ ≠ 0 := by
      by_contra! hall0
      apply hX₀n_ne
      ext d₀
      simpa using hall0 d₀
    obtain ⟨d₀, hd₀⟩ := hex_d₀
    have hpow_homog : (X₀ ^ n : P).IsHomogeneous n := by
      simpa using (MvPolynomial.isHomogeneous_X F i₀).pow n
    have hden_homog : (X₀ ^ n : P).IsHomogeneous nd.deg := by
      rw [hn]
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
    have hdeg_eq : nd.deg = n := (hden_homog hd₀).symm.trans (hpow_homog hd₀)
    have hnum_homog : nd.num.1.IsHomogeneous n := by
      rw [← hdeg_eq]
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
    change valHom (α₀ (β₀ (HomogeneousLocalization.mk nd))) =
      (HomogeneousLocalization.mk nd).val
    simp only [β₀, RingHom.comp_apply, valHom, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
    rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
    change φ_homog nd.num.1 = _
    rw [hφ_isHomog n nd.num.1 hnum_homog]
    congr 1
    exact Subtype.ext hn
  let e₀ : Polynomial F ≃+* H₀ :=
    { α₀ with
      invFun := β₀
      left_inv := h_left
      right_inv := h_right }
  have he₀_C : ∀ c : F, e₀ (Polynomial.C c) =
      HomogeneousLocalization.fromZeroRingHom 𝒜 M₀ (algebraMap F ↥(𝒜 0) c) := by
    intro c
    change α₀ (Polynomial.C c) = _
    simp only [α₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    rfl

  let φ_iso : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of H₀) :=
    AlgebraicGeometry.Spec.map e₀.toCommRingCatIso.inv
  let j_away : AlgebraicGeometry.Spec (CommRingCat.of H₀) ⟶ AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Proj.awayι 𝒜 X₀ hdeg Nat.zero_lt_one
  have _ : AlgebraicGeometry.IsOpenImmersion j_away := by
    dsimp [j_away]
    infer_instance
  let ι_raw : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left :=
    φ_iso ≫ j_away
  have _ : AlgebraicGeometry.IsOpenImmersion ι_raw := by
    dsimp [ι_raw, φ_iso, j_away, weilProjectiveSpaceOver]
    infer_instance
  have hBase_raw : ι_raw ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    dsimp [ι_raw, φ_iso, j_away, weilProjectiveSpaceOver]
    rw [Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      RingEquiv.toCommRingCatIso_inv, ← Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
    apply RingHom.ext
    intro c
    change e₀.symm (HomogeneousLocalization.fromZeroRingHom 𝒜 M₀ (algebraMap F ↥(𝒜 0) c)) =
      Polynomial.C c
    rw [← he₀_C c, e₀.symm_apply_apply]

  have hx₀_mem : x₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 X₀ :=
    (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 X₀ x₀).mpr hi₀
  have hx₀_range_j : x₀ ∈ j_away.opensRange := by
    dsimp [j_away]
    rwa [AlgebraicGeometry.Proj.opensRange_awayι]
  obtain ⟨z_raw, hz_raw⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hx₀_range_j
  let w_pt := AlgebraicGeometry.Spec.map e₀.toCommRingCatIso.hom z_raw
  have hw_pt : φ_iso w_pt = z_raw := by
    dsimp [φ_iso, w_pt]
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Spec.map_comp,
      Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    rfl
  have hs_pt₀ : ι_raw w_pt = s_inf pt₀ := by
    change j_away (φ_iso w_pt) = x₀
    rw [hw_pt]
    exact hz_raw
  have hRange_raw : Set.range ⇑s_inf ⊆ Set.range ⇑ι_raw := by
    rintro _ ⟨pt, rfl⟩
    have hpt : pt = pt₀ := (Unique.eq_default pt).trans (Unique.eq_default pt₀).symm
    rw [hpt, ← hs_pt₀]
    exact ⟨w_pt, rfl⟩
  let s_raw := AlgebraicGeometry.IsOpenImmersion.lift ι_raw s_inf hRange_raw
  have hs_raw_fac : s_raw ≫ ι_raw = s_inf :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac ι_raw s_inf hRange_raw
  let ψ_s : Polynomial F →+* F := (AlgebraicGeometry.Spec.preimage s_raw).hom
  have hψ_s : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ ι_raw = s_inf := by
    dsimp [ψ_s]
    rw [AlgebraicGeometry.Spec.map_preimage, hs_raw_fac]
  have hψ_s_C : ψ_s.comp Polynomial.C = RingHom.id F := by
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_s.comp Polynomial.C)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id F)) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← hBase_raw,
        ← Category.assoc, hψ_s, hsinf_sec, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)

  let a_inf : F := ψ_s Polynomial.X
  let shiftFwd : Polynomial F →+* Polynomial F :=
    Polynomial.eval₂RingHom Polynomial.C (Polynomial.X - Polynomial.C a_inf)
  let shiftInv : Polynomial F →+* Polynomial F :=
    Polynomial.eval₂RingHom Polynomial.C (Polynomial.X + Polynomial.C a_inf)
  have h_si_sf : ∀ q : Polynomial F, shiftInv (shiftFwd q) = q := by
    have hcomp : shiftInv.comp shiftFwd = RingHom.id (Polynomial F) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [shiftFwd, shiftInv]
      · simp [shiftFwd, shiftInv]
    exact fun q => RingHom.congr_fun hcomp q
  have h_sf_si : ∀ q : Polynomial F, shiftFwd (shiftInv q) = q := by
    have hcomp : shiftFwd.comp shiftInv = RingHom.id (Polynomial F) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [shiftFwd, shiftInv]
      · simp [shiftFwd, shiftInv]
    exact fun q => RingHom.congr_fun hcomp q
  let e_shift : Polynomial F ≃+* Polynomial F :=
    { shiftFwd with
      invFun := shiftInv
      left_inv := h_si_sf
      right_inv := h_sf_si }
  let j_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left :=
    AlgebraicGeometry.Spec.map e_shift.toCommRingCatIso.inv ≫ ι_raw
  have hj_inf_open : AlgebraicGeometry.IsOpenImmersion j_inf := by
    dsimp [j_inf]
    infer_instance
  let _ : AlgebraicGeometry.IsOpenImmersion j_inf := hj_inf_open
  have hj_inf_hom : j_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    dsimp [j_inf]
    rw [Category.assoc, hBase_raw, RingEquiv.toCommRingCatIso_inv,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    apply congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
    apply RingHom.ext
    intro c
    change shiftInv (Polynomial.C c) = Polynomial.C c
    simp [shiftInv]
  have hj_inf_s :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)) ≫ j_inf =
        s_inf := by
    dsimp [j_inf]
    rw [RingEquiv.toCommRingCatIso_inv, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have heq_s :
        (Polynomial.evalRingHom (0 : F)).comp (e_shift.symm : Polynomial F →+* Polynomial F) =
          ψ_s := by
      apply Polynomial.ringHom_ext'
      · ext c
        change Polynomial.eval 0 (shiftInv (Polynomial.C c)) = ψ_s (Polynomial.C c)
        simp only [shiftInv, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval_C]
        exact (RingHom.congr_fun hψ_s_C c).symm
      · change Polynomial.eval 0 (shiftInv Polynomial.X) = ψ_s Polynomial.X
        simp [shiftInv, a_inf]
    rw [heq_s, hψ_s]

  
  
  
  have hSpecMem : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
      (φ : R₁ →+* R₂) (x : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₂))) (r : R₁),
      r ∈ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) x).asIdeal ↔ φ r ∈ x.asIdeal :=
    fun _ _ _ => Iff.rfl

  have hZeroLocus_univ : ∀ {R_ps : Type u} [CommRing R_ps]
      (Z : Set (PrimeSpectrum R_ps)) (η : PrimeSpectrum R_ps),
      IsClosed Z → (∀ r : R_ps, r ∈ η.asIdeal ↔ r = 0) → η ∈ Z →
      ∀ q : PrimeSpectrum R_ps, q ∈ Z := by
    intro R_ps _ Z η hZ hη0 hηZ q
    obtain ⟨S, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus Z).mp hZ
    rw [PrimeSpectrum.mem_zeroLocus] at hηZ ⊢
    intro s hs
    rw [(hη0 s).mp (hηZ hs)]
    exact q.asIdeal.zero_mem

  have hBasicOpen_spec : ∀ (f : Polynomial F),
      ∃ B : Set (PrimeSpectrum (Polynomial F)),
        IsOpen B ∧ ∀ q : PrimeSpectrum (Polynomial F), q ∈ B ↔ f ∉ q.asIdeal :=
    fun f => ⟨(PrimeSpectrum.basicOpen f : Set (PrimeSpectrum (Polynomial F))),
      PrimeSpectrum.isOpen_basicOpen,
      fun q => SetLike.mem_coe.trans (PrimeSpectrum.mem_basicOpen f q)⟩

  let q₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 1)) pt₀
  let q₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)) pt₀
  have hq₁_not_sinf : j_inf.base q₁ ∉ Set.range s_inf.base := by
    rintro ⟨pt, hpt⟩
    have hpt_eq : pt = pt₀ := (Unique.eq_default pt).trans (Unique.eq_default pt₀).symm
    rw [hpt_eq] at hpt
    have hs_q₀ : s_inf.base pt₀ = j_inf.base q₀ := by
      rw [← hj_inf_s]
      rfl
    rw [hs_q₀] at hpt
    have hq_eq : q₁ = q₀ := j_inf.isOpenEmbedding.injective hpt.symm
    have hX_mem₀ : Polynomial.X ∈ q₀.asIdeal := by
      dsimp only [q₀]
      rw [hSpecMem]
      simp [pt₀.asIdeal.zero_mem]
    rw [← hq_eq] at hX_mem₀
    dsimp only [q₁] at hX_mem₀
    rw [hSpecMem] at hX_mem₀
    simp only [Polynomial.coe_evalRingHom, Polynomial.eval_X] at hX_mem₀
    exact pt₀.isPrime.ne_top (pt₀.asIdeal.eq_top_iff_one.mpr hX_mem₀)
  have hNonempty : (Set.range j_aff.base ∩ Set.range j_inf.base).Nonempty := by
    refine ⟨j_inf.base q₁, ?_, ⟨q₁, rfl⟩⟩
    by_contra hnot
    exact hq₁_not_sinf (hsinf_compl ▸ hnot)

  
  
  
  have halg_PC : ∀ c : F,
      algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) = algebraMap F (RatFunc F) c := by
    intro c
    rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]

  let e_gen : AlgebraicGeometry.Spec (CommRingCat.of (RatFunc F)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) (RatFunc F)))
  let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of (RatFunc F))) := default
  let η₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) := e_gen pt_K

  have hptK_ideal : ∀ a : RatFunc F, a ∈ pt_K.asIdeal ↔ a = 0 := by
    intro a
    constructor
    · intro ha
      by_contra hne
      exact pt_K.isPrime.ne_top (pt_K.asIdeal.eq_top_of_isUnit_mem ha (IsUnit.mk0 a hne))
    · rintro rfl
      exact pt_K.asIdeal.zero_mem

  have hη₀_ideal : ∀ p : Polynomial F, p ∈ η₀.asIdeal ↔ p = 0 := by
    intro p
    dsimp only [η₀, e_gen]
    rw [hSpecMem, hptK_ideal]
    exact ⟨fun h => IsFractionRing.injective (Polynomial F) (RatFunc F)
      (h.trans (map_zero _).symm), fun h => by rw [h, map_zero]⟩

  have h_η₀_mem : ∀ W : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))),
      IsOpen W → W.Nonempty → η₀ ∈ W := by
    intro W hW_open ⟨q_w, hq_w⟩
    by_contra hnot
    exact (hZeroLocus_univ Wᶜ η₀ hW_open.isClosed_compl hη₀_ideal hnot q_w) hq_w

  have hOneWay : ∀ (j₁ j₂ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
        (weilProjectiveSpaceOver F 1).left)
      [AlgebraicGeometry.IsOpenImmersion j₁] [AlgebraicGeometry.IsOpenImmersion j₂],
      j₁ ≫ (weilProjectiveSpaceOver F 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      j₂ ≫ (weilProjectiveSpaceOver F 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      (Set.range j₁.base ∩ Set.range j₂.base).Nonempty →
      ∃ Φ : RatFunc F →+* RatFunc F,
        Φ.comp (algebraMap F (RatFunc F)) = algebraMap F (RatFunc F) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ) ≫ e_gen ≫ j₁ = e_gen ≫ j₂ := by
    intro j₁ j₂ _ _ hj₁_hom hj₂_hom ⟨y₀, ⟨p_a, hp_a⟩, ⟨p_b, hp_b⟩⟩
    have hW₁_open : IsOpen (j₁.base ⁻¹' Set.range j₂.base) :=
      j₂.isOpenEmbedding.isOpen_range.preimage j₁.continuous
    have hW₁_ne : (j₁.base ⁻¹' Set.range j₂.base).Nonempty :=
      ⟨p_a, by simp only [Set.mem_preimage, hp_a]; exact ⟨p_b, hp_b⟩⟩
    have hη₁ : j₁.base η₀ ∈ Set.range j₂.base := h_η₀_mem _ hW₁_open hW₁_ne
    have hW₂_open : IsOpen (j₂.base ⁻¹' Set.range j₁.base) :=
      j₁.isOpenEmbedding.isOpen_range.preimage j₂.continuous
    have hW₂_ne : (j₂.base ⁻¹' Set.range j₁.base).Nonempty :=
      ⟨p_b, by simp only [Set.mem_preimage, hp_b]; exact ⟨p_a, hp_a⟩⟩
    have hη₂ : j₂.base η₀ ∈ Set.range j₁.base := h_η₀_mem _ hW₂_open hW₂_ne
    have hRange₁₂ : Set.range ⇑(e_gen ≫ j₂) ⊆ Set.range ⇑j₁ := by
      rintro _ ⟨pt, rfl⟩
      have hpt : pt = pt_K := (Unique.eq_default pt).trans (Unique.eq_default pt_K).symm
      rw [hpt]
      exact hη₂
    have hRange₂₁ : Set.range ⇑(e_gen ≫ j₁) ⊆ Set.range ⇑j₂ := by
      rintro _ ⟨pt, rfl⟩
      have hpt : pt = pt_K := (Unique.eq_default pt).trans (Unique.eq_default pt_K).symm
      rw [hpt]
      exact hη₁
    let v₁₂ := AlgebraicGeometry.IsOpenImmersion.lift j₁ (e_gen ≫ j₂) hRange₁₂
    have hv₁₂ : v₁₂ ≫ j₁ = e_gen ≫ j₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j₁ (e_gen ≫ j₂) hRange₁₂
    let v₂₁ := AlgebraicGeometry.IsOpenImmersion.lift j₂ (e_gen ≫ j₁) hRange₂₁
    have hv₂₁ : v₂₁ ≫ j₂ = e_gen ≫ j₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j₂ (e_gen ≫ j₁) hRange₂₁
    let ψ₁₂ : Polynomial F →+* RatFunc F := (AlgebraicGeometry.Spec.preimage v₁₂).hom
    have hψ₁₂_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁₂) = v₁₂ := by
      dsimp [ψ₁₂]
      exact AlgebraicGeometry.Spec.map_preimage v₁₂
    have hψ₁₂_inj : Function.Injective ψ₁₂ := by
      rw [injective_iff_map_eq_zero]
      intro f hf0
      by_contra hf_ne
      let p₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) := v₁₂ pt_K
      let p₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) := v₂₁ pt_K
      have hp₁_eq : j₁.base p₁ = j₂.base η₀ := congrArg (fun g => g.base pt_K) hv₁₂
      have hp₂_eq : j₂.base p₂ = j₁.base η₀ := congrArg (fun g => g.base pt_K) hv₂₁
      have hf_p₁ : f ∈ p₁.asIdeal := by
        have hp₁_map : p₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁₂) pt_K := by
          dsimp [p₁]; rw [hψ₁₂_map]
        rw [hp₁_map, hSpecMem, hptK_ideal]
        exact hf0
      obtain ⟨B_f_ps, hBf_ps_open, hBf_mem⟩ := hBasicOpen_spec f
      let B_f : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) := B_f_ps
      have hBf_open : IsOpen B_f := hBf_ps_open
      have hη_Bf : η₀ ∈ B_f := (hBf_mem η₀).mpr (by rw [hη₀_ideal]; exact hf_ne)
      have hp₁_not_Bf : p₁ ∉ B_f := fun h => (hBf_mem p₁).mp h hf_p₁
      let U_f : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
        j₂.base ⁻¹' (j₁.base '' B_f)
      have hUf_open : IsOpen U_f :=
        (j₁.isOpenEmbedding.isOpenMap B_f hBf_open).preimage j₂.continuous
      have hUf_ne : U_f.Nonempty :=
        ⟨p₂, by simp only [U_f, Set.mem_preimage, hp₂_eq]; exact ⟨η₀, hη_Bf, rfl⟩⟩
      have hη_Uf : η₀ ∈ U_f := h_η₀_mem U_f hUf_open hUf_ne
      obtain ⟨q_f, hqf_Bf, hqf_eq⟩ := hη_Uf
      have hqf_p₁ : q_f = p₁ := j₁.isOpenEmbedding.injective (hqf_eq.trans hp₁_eq.symm)
      rw [hqf_p₁] at hqf_Bf
      exact hp₁_not_Bf hqf_Bf
    have hψ_units : ∀ s : nonZeroDivisors (Polynomial F), IsUnit (ψ₁₂ s.1) := by
      intro s
      have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      exact IsUnit.mk0 (ψ₁₂ s.1) (fun h0 => hs_ne (hψ₁₂_inj (h0.trans (map_zero _).symm)))
    let Φ : RatFunc F →+* RatFunc F :=
      IsLocalization.lift (M := nonZeroDivisors (Polynomial F)) hψ_units
    have hΦ_comp : Φ.comp (algebraMap (Polynomial F) (RatFunc F)) = ψ₁₂ :=
      RingHom.ext (fun p => IsLocalization.lift_eq hψ_units p)
    have hΦ_gen : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ) ≫ e_gen ≫ j₁ = e_gen ≫ j₂ := by
      dsimp [e_gen]
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        hΦ_comp, hψ₁₂_map, hv₁₂]
    have hψ_C : ψ₁₂.comp Polynomial.C = algebraMap F (RatFunc F) := by
      have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁₂.comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap (Polynomial F) (RatFunc F)).comp Polynomial.C)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← hj₁_hom,
          ← Category.assoc, hψ₁₂_map, hv₁₂, Category.assoc, hj₂_hom]
        dsimp only [e_gen]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hhom := congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)
      ext c
      have hc : ψ₁₂ (Polynomial.C c) =
          algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) := RingHom.congr_fun hhom c
      exact hc.trans (halg_PC c)
    have hΦ_F : Φ.comp (algebraMap F (RatFunc F)) = algebraMap F (RatFunc F) := by
      ext c
      rw [RingHom.comp_apply, ← halg_PC c]
      change (Φ.comp (algebraMap (Polynomial F) (RatFunc F))) (Polynomial.C c) = _
      rw [hΦ_comp]
      exact RingHom.congr_fun hψ_C c
    exact ⟨Φ, hΦ_F, hΦ_gen⟩

  obtain ⟨Φ_XT, hXT_F, hGen_XT⟩ := hOneWay j_aff j_inf hj_hom hj_inf_hom hNonempty
  obtain ⟨Φ_TX, hTX_F, hGen_TX⟩ :=
    hOneWay j_inf j_aff hj_inf_hom hj_hom (Set.inter_comm _ _ ▸ hNonempty)

  have hTX_XT : Φ_TX.comp Φ_XT = RingHom.id (RatFunc F) := by
    have hcancel : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_TX) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_XT) ≫ e_gen = e_gen := by
      apply (CategoryTheory.cancel_mono j_aff).mp
      rw [Category.assoc, Category.assoc, hGen_XT, hGen_TX]
    dsimp [e_gen] at hcancel
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp] at hcancel
    have hcomp_eq : (Φ_TX.comp Φ_XT).comp (algebraMap (Polynomial F) (RatFunc F)) =
        (RingHom.id (RatFunc F)).comp (algebraMap (Polynomial F) (RatFunc F)) := by
      rw [RingHom.id_comp]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hcancel)
    exact IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F)) hcomp_eq

  have hXT_TX : Φ_XT.comp Φ_TX = RingHom.id (RatFunc F) := by
    have hcancel : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_XT) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_TX) ≫ e_gen = e_gen := by
      apply (CategoryTheory.cancel_mono j_inf).mp
      rw [Category.assoc, Category.assoc, hGen_TX, hGen_XT]
    dsimp [e_gen] at hcancel
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp] at hcancel
    have hcomp_eq : (Φ_XT.comp Φ_TX).comp (algebraMap (Polynomial F) (RatFunc F)) =
        (RingHom.id (RatFunc F)).comp (algebraMap (Polynomial F) (RatFunc F)) := by
      rw [RingHom.id_comp]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hcancel)
    exact IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F)) hcomp_eq

  
  
  
  let 𝔪₀ : Ideal (Polynomial F) := Ideal.span {Polynomial.X}
  have hker_eval0 : RingHom.ker (Polynomial.evalRingHom (0 : F)) = 𝔪₀ := by
    ext p
    rw [RingHom.mem_ker, Polynomial.coe_evalRingHom, ← Polynomial.IsRoot.def,
      ← Polynomial.dvd_iff_isRoot]
    dsimp [𝔪₀]
    rw [Ideal.mem_span_singleton, map_zero, sub_zero]
  have hMax_𝔪₀ : 𝔪₀.IsMaximal := by
    rw [← hker_eval0]
    exact RingHom.ker_isMaximal_of_surjective (Polynomial.evalRingHom (0 : F))
      (fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩)
  let _ : 𝔪₀.IsPrime := hMax_𝔪₀.isPrime
  have hmem_compl : ∀ p : Polynomial F, p ∈ 𝔪₀.primeCompl ↔ Polynomial.eval 0 p ≠ 0 := by
    intro p
    change p ∉ 𝔪₀ ↔ Polynomial.eval 0 p ≠ 0
    rw [← hker_eval0, RingHom.mem_ker, Polynomial.coe_evalRingHom]

  let V_inf : Type u := Localization.AtPrime 𝔪₀
  let j_V : Polynomial F →+* V_inf := algebraMap (Polynomial F) V_inf

  have hjV_units : ∀ p : Polynomial F, Polynomial.eval 0 p ≠ 0 → IsUnit (j_V p) := by
    intro p hp
    exact IsLocalization.map_units V_inf ⟨p, (hmem_compl p).mpr hp⟩

  have hjV_univ : ∀ {A : Type u} [CommRing A] (f : Polynomial F →+* A),
      (∀ p : Polynomial F, Polynomial.eval 0 p ≠ 0 → IsUnit (f p)) →
      ∃! f_lift : V_inf →+* A, f_lift.comp j_V = f := by
    intro A _ f hf
    have hf_sub : ∀ s : 𝔪₀.primeCompl, IsUnit (f s.1) :=
      fun s => hf s.1 ((hmem_compl s.1).mp s.2)
    let f_lift : V_inf →+* A := IsLocalization.lift hf_sub
    have hlift_eq : f_lift.comp j_V = f :=
      RingHom.ext (fun p => IsLocalization.lift_eq hf_sub p)
    refine ⟨f_lift, hlift_eq, ?_⟩
    intro g hg
    apply IsLocalization.ringHom_ext 𝔪₀.primeCompl
    change g.comp j_V = f_lift.comp j_V
    rw [hg, hlift_eq]

  have heval0_units : ∀ p : Polynomial F,
      Polynomial.eval 0 p ≠ 0 → IsUnit ((Polynomial.evalRingHom (0 : F)) p) :=
    fun p hp => IsUnit.mk0 _ hp
  obtain ⟨π_0, hπ0_jV, hπ0_uniq⟩ := hjV_univ (Polynomial.evalRingHom (0 : F)) heval0_units

  have hUnit_of_π0 : ∀ w_v : V_inf, π_0 w_v ≠ 0 → IsUnit w_v := by
    intro w_v hw0
    obtain ⟨⟨a_p, s_p⟩, hsurj⟩ := IsLocalization.surj 𝔪₀.primeCompl w_v
    have hs0 : Polynomial.eval 0 s_p.1 ≠ 0 := (hmem_compl s_p.1).mp s_p.2
    have ha0 : Polynomial.eval 0 a_p ≠ 0 := by
      have happ := congrArg π_0 hsurj
      rw [map_mul] at happ
      change π_0 w_v * (π_0.comp j_V) s_p.1 = (π_0.comp j_V) a_p at happ
      rw [hπ0_jV, Polynomial.coe_evalRingHom] at happ
      rw [← happ]
      exact mul_ne_zero hw0 hs0
    have hunit_a : IsUnit (j_V a_p) := hjV_units a_p ha0
    rw [← hsurj] at hunit_a
    exact isUnit_of_mul_isUnit_left hunit_a

  have halg_units : ∀ p : Polynomial F,
      Polynomial.eval 0 p ≠ 0 → IsUnit (algebraMap (Polynomial F) (RatFunc F) p) := by
    intro p hp
    have hp_ne : p ≠ 0 := fun h0 => hp (by rw [h0, Polynomial.eval_zero])
    exact IsUnit.mk0 _ (fun h0 =>
      hp_ne (IsFractionRing.injective (Polynomial F) (RatFunc F) (h0.trans (map_zero _).symm)))
  obtain ⟨ι_std, hιstd_jV, _⟩ := hjV_univ (algebraMap (Polynomial F) (RatFunc F)) halg_units

  have hιstd_inj : Function.Injective ι_std := by
    rw [injective_iff_map_eq_zero]
    intro z hz0
    obtain ⟨⟨a_p, s_p⟩, hsurj⟩ := IsLocalization.surj 𝔪₀.primeCompl z
    have happ := congrArg ι_std hsurj
    rw [map_mul, hz0, zero_mul] at happ
    change 0 = (ι_std.comp j_V) a_p at happ
    rw [hιstd_jV] at happ
    have ha0 : a_p = 0 :=
      IsFractionRing.injective (Polynomial F) (RatFunc F) (happ.symm.trans (map_zero _).symm)
    rw [ha0, map_zero] at hsurj
    have hs_unit : IsUnit (j_V s_p.1) := hjV_units s_p.1 ((hmem_compl s_p.1).mp s_p.2)
    exact hs_unit.mul_left_eq_zero.mp hsurj

  let _ : IsDomain V_inf := Function.Injective.isDomain ι_std hιstd_inj

  
  have hNoVal : ∀ v : V_inf, ι_std v ≠ Φ_XT RatFunc.X := by
    intro v hv
    let d_K : AlgebraicGeometry.Spec (CommRingCat.of (RatFunc F)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of V_inf) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_std)
    have hdK_dom : AlgebraicGeometry.IsDominant d_K := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
      have hdK_ideal : ∀ s : V_inf, s ∈ (d_K pt_K).asIdeal ↔ s = 0 := by
        intro s
        dsimp only [d_K]
        rw [hSpecMem, hptK_ideal]
        exact ⟨fun h => hιstd_inj (h.trans (map_zero _).symm), fun h => by rw [h, map_zero]⟩
      apply Set.eq_univ_of_forall
      intro q_u
      exact hZeroLocus_univ (closure (Set.range ⇑d_K)) (d_K pt_K)
        isClosed_closure hdK_ideal (subset_closure ⟨pt_K, rfl⟩) q_u
    let _ : AlgebraicGeometry.IsDominant d_K := hdK_dom
    let θ_v : Polynomial F →+* V_inf := Polynomial.eval₂RingHom (j_V.comp Polynomial.C) v
    let f₁ : AlgebraicGeometry.Spec (CommRingCat.of V_inf) ⟶ (weilProjectiveSpaceOver F 1).left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_V) ≫ j_inf
    let f₂ : AlgebraicGeometry.Spec (CommRingCat.of V_inf) ⟶ (weilProjectiveSpaceOver F 1).left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_v) ≫ j_aff
    have hf_over : f₁ ≫ (weilProjectiveSpaceOver F 1).hom =
        f₂ ≫ (weilProjectiveSpaceOver F 1).hom := by
      dsimp only [f₁, f₂]
      rw [Category.assoc, hj_inf_hom, Category.assoc, hj_hom,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hC_eq : j_V.comp Polynomial.C = θ_v.comp Polynomial.C := by
        ext c; simp [θ_v]
      rw [hC_eq]
    have hθ_std : ι_std.comp θ_v = Φ_XT.comp (algebraMap (Polynomial F) (RatFunc F)) := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, θ_v, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change (ι_std.comp j_V) (Polynomial.C c) =
          Φ_XT (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c))
        rw [hιstd_jV, halg_PC]
        exact (RingHom.congr_fun hXT_F c).symm
      · simp only [RingHom.comp_apply, θ_v, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          RatFunc.algebraMap_X]
        exact hv
    have hf_dom : d_K ≫ f₁ = d_K ≫ f₂ := by
      have hLHS : d_K ≫ f₁ = e_gen ≫ j_inf := by
        dsimp only [d_K, f₁, e_gen]
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          hιstd_jV]
      have hRHS : d_K ≫ f₂ = e_gen ≫ j_inf := by
        dsimp only [d_K, f₂]
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          hθ_std, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
        exact hGen_XT
      exact hLHS.trans hRHS.symm
    have hf_eq : f₁ = f₂ :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated (weilProjectiveSpaceOver F 1).hom
        hf_over d_K hf_dom
    have hsp := congrArg (fun g => AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_0) ≫ g) hf_eq
    dsimp only [f₁, f₂] at hsp
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hπ0_jV,
      hj_inf_s, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp] at hsp
    have hmem_aff : s_inf.base pt₀ ∈ Set.range j_aff.base := by
      rw [hsp]
      exact ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_0.comp θ_v)) pt₀, rfl⟩
    have hmem_compl_pt : s_inf.base pt₀ ∈ (Set.range j_aff.base)ᶜ := by
      rw [hsinf_compl]
      exact ⟨pt₀, rfl⟩
    exact hmem_compl_pt hmem_aff

  
  let g_inv : Polynomial F →+* RatFunc F :=
    Polynomial.eval₂RingHom (algebraMap F (RatFunc F)) ((RatFunc.X : RatFunc F)⁻¹)
  have hginv_ne : ∀ q : Polynomial F, q ≠ 0 → g_inv q ≠ 0 := by
    intro q hq h0
    let d := q.natDegree
    let q_rev : Polynomial F :=
      ∑ i ∈ Finset.range (d + 1), Polynomial.C (q.coeff i) * Polynomial.X ^ (d - i)
    have hq_rev_eval0 : Polynomial.eval 0 q_rev = q.leadingCoeff := by
      dsimp [q_rev]
      rw [Polynomial.eval_finsetSum, Finset.sum_range_succ]
      have hsum0 : (∑ x ∈ Finset.range d,
          Polynomial.eval 0 (Polynomial.C (q.coeff x) * Polynomial.X ^ (d - x))) = 0 := by
        apply Finset.sum_eq_zero
        intro i hi
        have hi_lt : i < d := Finset.mem_range.mp hi
        simp [zero_pow (by omega : d - i ≠ 0)]
      rw [hsum0, zero_add, Nat.sub_self, pow_zero, mul_one, Polynomial.eval_C]
      rfl
    have hq_rev_ne : q_rev ≠ 0 := by
      intro hrev0
      apply Polynomial.leadingCoeff_ne_zero.mpr hq
      rw [← hq_rev_eval0, hrev0, Polynomial.eval_zero]
    have hX_ne : (RatFunc.X : RatFunc F) ≠ 0 := RatFunc.X_ne_zero
    have hmul_eq : (RatFunc.X : RatFunc F) ^ d * g_inv q =
        algebraMap (Polynomial F) (RatFunc F) q_rev := by
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow q]
      change (RatFunc.X : RatFunc F) ^ d *
        g_inv (∑ i ∈ Finset.range (d + 1), Polynomial.C (q.coeff i) * Polynomial.X ^ i) = _
      rw [map_sum, Finset.mul_sum]
      dsimp [q_rev]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i hi
      have hi_le : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      simp only [g_inv, Polynomial.coe_eval₂RingHom, map_mul, map_pow, Polynomial.eval₂_C,
        Polynomial.eval₂_X, RatFunc.algebraMap_C, RatFunc.algebraMap_X]
      have hpow_split : (RatFunc.X : RatFunc F) ^ d =
          (RatFunc.X : RatFunc F) ^ (d - i) * (RatFunc.X : RatFunc F) ^ i := by
        rw [← pow_add, Nat.sub_add_cancel hi_le]
      rw [hpow_split]
      calc
        ((RatFunc.X : RatFunc F) ^ (d - i) * (RatFunc.X : RatFunc F) ^ i) *
            (algebraMap F (RatFunc F) (q.coeff i) * ((RatFunc.X : RatFunc F)⁻¹) ^ i) =
          algebraMap F (RatFunc F) (q.coeff i) * (RatFunc.X : RatFunc F) ^ (d - i) *
            ((RatFunc.X : RatFunc F) * (RatFunc.X : RatFunc F)⁻¹) ^ i := by
          rw [mul_pow]
          ring
        _ = algebraMap F (RatFunc F) (q.coeff i) * (RatFunc.X : RatFunc F) ^ (d - i) := by
          rw [mul_inv_cancel₀ hX_ne, one_pow, mul_one]
    rw [h0, mul_zero] at hmul_eq
    exact hq_rev_ne (IsFractionRing.injective (Polynomial F) (RatFunc F)
      (hmul_eq.symm.trans (map_zero _).symm))

  have hginv_units : ∀ s : nonZeroDivisors (Polynomial F), IsUnit (g_inv s.1) :=
    fun s => IsUnit.mk0 _ (hginv_ne s.1 (mem_nonZeroDivisors_iff_ne_zero.mp s.2))
  let τ_inv : RatFunc F →+* RatFunc F :=
    IsLocalization.lift (M := nonZeroDivisors (Polynomial F)) hginv_units
  have hτ_comp : τ_inv.comp (algebraMap (Polynomial F) (RatFunc F)) = g_inv :=
    RingHom.ext (fun p => IsLocalization.lift_eq hginv_units p)
  have hτ_F : ∀ c : F, τ_inv (algebraMap F (RatFunc F) c) = algebraMap F (RatFunc F) c := by
    intro c
    rw [← halg_PC c]
    change (τ_inv.comp (algebraMap (Polynomial F) (RatFunc F))) (Polynomial.C c) = _
    rw [hτ_comp]
    simp [g_inv, halg_PC]
  have hτ_X : τ_inv (RatFunc.X : RatFunc F) = (RatFunc.X : RatFunc F)⁻¹ := by
    rw [← RatFunc.algebraMap_X]
    change (τ_inv.comp (algebraMap (Polynomial F) (RatFunc F))) Polynomial.X = _
    rw [hτ_comp]
    simp [g_inv]
  have hτ_inv_self : ∀ z : RatFunc F, τ_inv (τ_inv z) = z := by
    have hcomp : (τ_inv.comp τ_inv).comp (algebraMap (Polynomial F) (RatFunc F)) =
        (RingHom.id (RatFunc F)).comp (algebraMap (Polynomial F) (RatFunc F)) := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, RingHom.id_apply, halg_PC, hτ_F]
      · simp only [RingHom.comp_apply, RingHom.id_apply, RatFunc.algebraMap_X, hτ_X,
          map_inv₀, inv_inv]
    have hid := IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F)) hcomp
    exact fun z => RingHom.congr_fun hid z

  let ι_inv : V_inf →+* RatFunc F := τ_inv.comp ι_std
  have hιinv_C : ι_inv.comp (j_V.comp Polynomial.C) = algebraMap F (RatFunc F) := by
    ext c
    simp only [ι_inv, RingHom.comp_apply]
    change τ_inv ((ι_std.comp j_V) (Polynomial.C c)) = _
    rw [hιstd_jV, halg_PC, hτ_F]
  have hιinv_X : ι_inv (j_V Polynomial.X) = (RatFunc.X : RatFunc F)⁻¹ := by
    simp only [ι_inv, RingHom.comp_apply]
    change τ_inv ((ι_std.comp j_V) Polynomial.X) = _
    rw [hιstd_jV, RatFunc.algebraMap_X, hτ_X]

  
  have hFactor : ∀ (n : ℕ) (p : Polynomial F),
      p.natDegree ≤ n → p ≠ 0 →
      ∃ (k : ℕ) (u : Polynomial F), p = Polynomial.X ^ k * u ∧ Polynomial.eval 0 u ≠ 0 := by
    intro n
    induction n with
    | zero =>
      intro p hdeg0 hp_ne
      refine ⟨0, p, (one_mul p).symm.trans (by rw [pow_zero]), ?_⟩
      have hp_C : p = Polynomial.C (p.coeff 0) :=
        Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg0)
      intro hev0
      apply hp_ne
      rw [hp_C, Polynomial.coeff_zero_eq_eval_zero, hev0, map_zero]
    | succ n ih =>
      intro p hdeg_le hp_ne
      by_cases hev_ne : Polynomial.eval 0 p ≠ 0
      · exact ⟨0, p, by rw [pow_zero, one_mul], hev_ne⟩
      · have hev0 : Polynomial.eval 0 p = 0 := not_not.mp hev_ne
        have hc0 : p.coeff 0 = 0 := by rwa [Polynomial.coeff_zero_eq_eval_zero]
        have hp_div : Polynomial.X * p.divX = p := by
          have h := Polynomial.X_mul_divX_add p
          rwa [hc0, map_zero, add_zero] at h
        have hdiv_ne : p.divX ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hp_div
          exact hp_ne hp_div.symm
        have hdeg_div : p.divX.natDegree ≤ n := by
          have h1 := Polynomial.natDegree_X_mul hdiv_ne
          rw [hp_div] at h1
          omega
        obtain ⟨k, u, hku, hu0⟩ := ih p.divX hdeg_div hdiv_ne
        exact ⟨k + 1, u, by rw [← hp_div, hku, pow_succ', mul_assoc], hu0⟩

  have hDichot : ∀ z : RatFunc F,
      (∃ v : V_inf, ι_std v = z) ∨ (z ≠ 0 ∧ ∃ m : V_inf, π_0 m = 0 ∧ ι_std m = z⁻¹) := by
    intro z
    by_cases hz : z = 0
    · left
      exact ⟨0, by rw [hz, map_zero]⟩
    · obtain ⟨⟨p_num, q_den⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial F)) z
      have hq_ne : q_den.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp q_den.2
      have hq_rat_ne : algebraMap (Polynomial F) (RatFunc F) q_den.1 ≠ 0 := fun h0 =>
        hq_ne (IsFractionRing.injective (Polynomial F) (RatFunc F) (h0.trans (map_zero _).symm))
      have hp_rat_ne : algebraMap (Polynomial F) (RatFunc F) p_num ≠ 0 := by
        rw [← hsurj]
        exact mul_ne_zero hz hq_rat_ne
      have hp_ne : p_num ≠ 0 := fun h0 => hp_rat_ne (by rw [h0, map_zero])
      obtain ⟨a_exp, u_p, hp_fac, hup0⟩ := hFactor p_num.natDegree p_num le_rfl hp_ne
      obtain ⟨b_exp, u_q, hq_fac, huq0⟩ := hFactor q_den.1.natDegree q_den.1 le_rfl hq_ne
      let U_p : V_infˣ := (hjV_units u_p hup0).unit
      let U_q : V_infˣ := (hjV_units u_q huq0).unit
      have hUp_val : (U_p : V_inf) = j_V u_p := IsUnit.unit_spec (hjV_units u_p hup0)
      have hUq_val : (U_q : V_inf) = j_V u_q := IsUnit.unit_spec (hjV_units u_q huq0)
      have hstd_X : ι_std (j_V Polynomial.X) = RatFunc.X := by
        change (ι_std.comp j_V) Polynomial.X = RatFunc.X
        rw [hιstd_jV, RatFunc.algebraMap_X]
      by_cases hle : b_exp ≤ a_exp
      · left
        let v_wit : V_inf := j_V Polynomial.X ^ (a_exp - b_exp) * ↑(U_p * U_q⁻¹)
        refine ⟨v_wit, ?_⟩
        apply mul_right_cancel₀ hq_rat_ne
        rw [hsurj]
        have hUq_inv : ι_std ↑(U_q⁻¹ : V_infˣ) * algebraMap (Polynomial F) (RatFunc F) u_q = 1 := by
          have h1 : ↑(U_q⁻¹ : V_infˣ) * (U_q : V_inf) = 1 := Units.inv_mul U_q
          have h2 := congrArg ι_std h1
          rw [map_mul, map_one, hUq_val] at h2
          change ι_std ↑(U_q⁻¹ : V_infˣ) * (ι_std.comp j_V) u_q = 1 at h2
          rwa [hιstd_jV] at h2
        have hp_map : algebraMap (Polynomial F) (RatFunc F) p_num =
            (RatFunc.X : RatFunc F) ^ a_exp * algebraMap (Polynomial F) (RatFunc F) u_p := by
          rw [hp_fac, map_mul, map_pow, RatFunc.algebraMap_X]
        have hq_map : algebraMap (Polynomial F) (RatFunc F) q_den.1 =
            (RatFunc.X : RatFunc F) ^ b_exp * algebraMap (Polynomial F) (RatFunc F) u_q := by
          rw [hq_fac, map_mul, map_pow, RatFunc.algebraMap_X]
        dsimp [v_wit]
        rw [map_mul, map_mul, map_pow, hstd_X, hUp_val]
        change ((RatFunc.X : RatFunc F) ^ (a_exp - b_exp) *
            ((ι_std.comp j_V) u_p * ι_std ↑(U_q⁻¹ : V_infˣ))) *
          algebraMap (Polynomial F) (RatFunc F) q_den.1 = _
        rw [hιstd_jV, hq_map, hp_map]
        calc
          ((RatFunc.X : RatFunc F) ^ (a_exp - b_exp) *
              (algebraMap (Polynomial F) (RatFunc F) u_p * ι_std ↑(U_q⁻¹ : V_infˣ))) *
            ((RatFunc.X : RatFunc F) ^ b_exp * algebraMap (Polynomial F) (RatFunc F) u_q) =
            ((RatFunc.X : RatFunc F) ^ (a_exp - b_exp) * (RatFunc.X : RatFunc F) ^ b_exp) *
              algebraMap (Polynomial F) (RatFunc F) u_p *
              (ι_std ↑(U_q⁻¹ : V_infˣ) * algebraMap (Polynomial F) (RatFunc F) u_q) := by ring
          _ = (RatFunc.X : RatFunc F) ^ a_exp * algebraMap (Polynomial F) (RatFunc F) u_p := by
            rw [← pow_add, Nat.sub_add_cancel hle, hUq_inv, mul_one]
      · right
        have hlt : a_exp < b_exp := Nat.lt_of_not_ge hle
        let m_wit : V_inf := j_V Polynomial.X ^ (b_exp - a_exp) * ↑(U_q * U_p⁻¹)
        refine ⟨hz, m_wit, ?_, ?_⟩
        · dsimp [m_wit]
          rw [map_mul, map_pow]
          have hπX : π_0 (j_V Polynomial.X) = 0 := by
            change (π_0.comp j_V) Polynomial.X = 0
            rw [hπ0_jV, Polynomial.coe_evalRingHom, Polynomial.eval_X]
          rw [hπX, zero_pow (by omega : b_exp - a_exp ≠ 0), zero_mul]
        · apply eq_inv_of_mul_eq_one_left
          apply mul_right_cancel₀ hq_rat_ne
          rw [one_mul, mul_assoc, hsurj]
          have hUp_inv : ι_std ↑(U_p⁻¹ : V_infˣ) *
              algebraMap (Polynomial F) (RatFunc F) u_p = 1 := by
            have h1 : ↑(U_p⁻¹ : V_infˣ) * (U_p : V_inf) = 1 := Units.inv_mul U_p
            have h2 := congrArg ι_std h1
            rw [map_mul, map_one, hUp_val] at h2
            change ι_std ↑(U_p⁻¹ : V_infˣ) * (ι_std.comp j_V) u_p = 1 at h2
            rwa [hιstd_jV] at h2
          have hp_map : algebraMap (Polynomial F) (RatFunc F) p_num =
              (RatFunc.X : RatFunc F) ^ a_exp * algebraMap (Polynomial F) (RatFunc F) u_p := by
            rw [hp_fac, map_mul, map_pow, RatFunc.algebraMap_X]
          have hq_map : algebraMap (Polynomial F) (RatFunc F) q_den.1 =
              (RatFunc.X : RatFunc F) ^ b_exp * algebraMap (Polynomial F) (RatFunc F) u_q := by
            rw [hq_fac, map_mul, map_pow, RatFunc.algebraMap_X]
          dsimp [m_wit]
          rw [map_mul, map_mul, map_pow, hstd_X, hUq_val]
          change ((RatFunc.X : RatFunc F) ^ (b_exp - a_exp) *
              ((ι_std.comp j_V) u_q * ι_std ↑(U_p⁻¹ : V_infˣ))) *
            algebraMap (Polynomial F) (RatFunc F) p_num = _
          rw [hιstd_jV, hp_map, hq_map]
          calc
            ((RatFunc.X : RatFunc F) ^ (b_exp - a_exp) *
                (algebraMap (Polynomial F) (RatFunc F) u_q * ι_std ↑(U_p⁻¹ : V_infˣ))) *
              ((RatFunc.X : RatFunc F) ^ a_exp * algebraMap (Polynomial F) (RatFunc F) u_p) =
              ((RatFunc.X : RatFunc F) ^ (b_exp - a_exp) * (RatFunc.X : RatFunc F) ^ a_exp) *
                algebraMap (Polynomial F) (RatFunc F) u_q *
                (ι_std ↑(U_p⁻¹ : V_infˣ) * algebraMap (Polynomial F) (RatFunc F) u_p) := by ring
            _ = (RatFunc.X : RatFunc F) ^ b_exp * algebraMap (Polynomial F) (RatFunc F) u_q := by
              rw [← pow_add, Nat.sub_add_cancel (Nat.le_of_lt hlt), hUp_inv, mul_one]

  
  have hm₀_ex : ∃ m₀ : V_inf, π_0 m₀ = 0 ∧ ι_std m₀ = (Φ_XT RatFunc.X)⁻¹ := by
    rcases hDichot (Φ_XT RatFunc.X) with ⟨v, hv⟩ | ⟨_, m₀, hm₀_0, hm₀_std⟩
    · exact False.elim (hNoVal v hv)
    · exact ⟨m₀, hm₀_0, hm₀_std⟩
  obtain ⟨m₀, hm₀_0, hm₀_std⟩ := hm₀_ex

  let α_V : Polynomial F →+* V_inf := Polynomial.eval₂RingHom (j_V.comp Polynomial.C) m₀
  have hπ0_αV : π_0.comp α_V = Polynomial.evalRingHom (0 : F) := by
    apply Polynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, α_V, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      change (π_0.comp j_V) (Polynomial.C c) = _
      rw [hπ0_jV]
    · simp only [RingHom.comp_apply, α_V, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
        Polynomial.coe_evalRingHom, Polynomial.eval_X]
      exact hm₀_0
  have hαV_units : ∀ p : Polynomial F, Polynomial.eval 0 p ≠ 0 → IsUnit (α_V p) := by
    intro p hp
    apply hUnit_of_π0 (α_V p)
    have h1 := RingHom.congr_fun hπ0_αV p
    simpa using h1.symm ▸ hp
  obtain ⟨ψ_V, hψV_jV, _⟩ := hjV_univ α_V hαV_units

  have hπ0_ψV : π_0.comp ψ_V = π_0 := by
    have h1 : (π_0.comp ψ_V).comp j_V = Polynomial.evalRingHom (0 : F) := by
      rw [RingHom.comp_assoc, hψV_jV, hπ0_αV]
    exact hπ0_uniq (π_0.comp ψ_V) h1

  have hΦinv_units : ∀ p : Polynomial F,
      Polynomial.eval 0 p ≠ 0 → IsUnit (((Φ_XT.comp ι_inv).comp j_V) p) :=
    fun p hp => (hjV_units p hp).map (Φ_XT.comp ι_inv)
  obtain ⟨_, _, hΦinv_uniq⟩ := hjV_univ ((Φ_XT.comp ι_inv).comp j_V) hΦinv_units
  have hιstd_ψV : ι_std.comp ψ_V = Φ_XT.comp ι_inv := by
    have h1 : (ι_std.comp ψ_V).comp j_V = (Φ_XT.comp ι_inv).comp j_V := by
      rw [RingHom.comp_assoc, hψV_jV]
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, α_V, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        have hC1 : ι_std (j_V (Polynomial.C c)) = algebraMap F (RatFunc F) c := by
          change (ι_std.comp j_V) (Polynomial.C c) = _
          rw [hιstd_jV, halg_PC]
        have hC2 : Φ_XT (ι_inv (j_V (Polynomial.C c))) = algebraMap F (RatFunc F) c := by
          change Φ_XT ((ι_inv.comp (j_V.comp Polynomial.C)) c) = _
          rw [hιinv_C]
          exact RingHom.congr_fun hXT_F c
        rw [hC1, hC2]
      · simp only [RingHom.comp_apply, α_V, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          hm₀_std, hιinv_X, map_inv₀]
    exact (hΦinv_uniq (ι_std.comp ψ_V) h1).trans (hΦinv_uniq (Φ_XT.comp ι_inv) rfl).symm

  let w₁ : RatFunc F := Φ_TX RatFunc.X
  have hw₁_XT : Φ_XT w₁ = RatFunc.X := by
    dsimp [w₁]
    exact RingHom.congr_fun hXT_TX RatFunc.X
  have hm₁_ex : ∃ m_1 : V_inf, π_0 m_1 = 0 ∧ ι_inv m_1 = Φ_TX RatFunc.X := by
    rcases hDichot (τ_inv w₁) with ⟨m_1, hm1_std⟩ | ⟨_, u₁, _, hu1_std⟩
    · have hm1_inv : ι_inv m_1 = w₁ := by
        change τ_inv (ι_std m_1) = w₁
        rw [hm1_std, hτ_inv_self]
      have hψ_m1 : ψ_V m_1 = j_V Polynomial.X := by
        apply hιstd_inj
        have h1 : (ι_std.comp ψ_V) m_1 = (Φ_XT.comp ι_inv) m_1 :=
          RingHom.congr_fun hιstd_ψV m_1
        simp only [RingHom.comp_apply] at h1
        rw [h1, hm1_inv, hw₁_XT]
        change RatFunc.X = (ι_std.comp j_V) Polynomial.X
        rw [hιstd_jV, RatFunc.algebraMap_X]
      have hm1_0 : π_0 m_1 = 0 := by
        have h1 : (π_0.comp ψ_V) m_1 = π_0 m_1 := RingHom.congr_fun hπ0_ψV m_1
        rw [← h1, RingHom.comp_apply, hψ_m1]
        change (π_0.comp j_V) Polynomial.X = 0
        rw [hπ0_jV, Polynomial.coe_evalRingHom, Polynomial.eval_X]
      exact ⟨m_1, hm1_0, hm1_inv⟩
    · exfalso
      have hu1_inv : ι_inv u₁ = w₁⁻¹ := by
        change τ_inv (ι_std u₁) = w₁⁻¹
        rw [hu1_std, ← map_inv₀ τ_inv, hτ_inv_self]
      have hψ_u1 : ι_std (ψ_V u₁) = (RatFunc.X : RatFunc F)⁻¹ := by
        have h1 : (ι_std.comp ψ_V) u₁ = (Φ_XT.comp ι_inv) u₁ :=
          RingHom.congr_fun hιstd_ψV u₁
        simp only [RingHom.comp_apply] at h1
        rw [h1, hu1_inv, map_inv₀, hw₁_XT]
      have hmul_one : ψ_V u₁ * j_V Polynomial.X = 1 := by
        apply hιstd_inj
        rw [map_mul, map_one, hψ_u1]
        change (RatFunc.X : RatFunc F)⁻¹ * (ι_std.comp j_V) Polynomial.X = 1
        rw [hιstd_jV, RatFunc.algebraMap_X, inv_mul_cancel₀ RatFunc.X_ne_zero]
      have hπ_one := congrArg π_0 hmul_one
      rw [map_mul, map_one] at hπ_one
      have hπX : π_0 (j_V Polynomial.X) = 0 := by
        change (π_0.comp j_V) Polynomial.X = 0
        rw [hπ0_jV, Polynomial.coe_evalRingHom, Polynomial.eval_X]
      rw [hπX, mul_zero] at hπ_one
      exact zero_ne_one hπ_one
  obtain ⟨m_1, hm1_0, hm1_inv⟩ := hm₁_ex

  
  
  
  let β_T : Polynomial F →+* V_inf := Polynomial.eval₂RingHom (j_V.comp Polynomial.C) m_1
  let g_inf_0 : AlgebraicGeometry.Spec (CommRingCat.of V_inf) ⟶
      (weilProjectiveSpaceOver F 1).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_T) ≫ j_inf

  refine ⟨V_inf, inferInstance, j_V, π_0, ι_inv, g_inf_0,
    hjV_units, @hjV_univ, hπ0_jV, hιinv_C, hιinv_X, ?_, ?_, ?_⟩
  · dsimp only [g_inf_0]
    rw [Category.assoc, hj_inf_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hβ_C : β_T.comp Polynomial.C = j_V.comp Polynomial.C := by
      ext c; simp [β_T]
    rw [hβ_C]
  · dsimp only [g_inf_0]
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hπ_β : π_0.comp β_T = Polynomial.evalRingHom (0 : F) := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, β_T, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change (π_0.comp j_V) (Polynomial.C c) = _
        rw [hπ0_jV]
      · simp only [RingHom.comp_apply, β_T, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          Polynomial.coe_evalRingHom, Polynomial.eval_X]
        exact hm1_0
    rw [hπ_β, hj_inf_s]
  · dsimp only [g_inf_0]
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hι_β : ι_inv.comp β_T = Φ_TX.comp (algebraMap (Polynomial F) (RatFunc F)) := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, β_T, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change (ι_inv.comp (j_V.comp Polynomial.C)) c =
          Φ_TX (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c))
        rw [hιinv_C, halg_PC]
        exact (RingHom.congr_fun hTX_F c).symm
      · simp only [RingHom.comp_apply, β_T, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          RatFunc.algebraMap_X]
        exact hm1_inv
    rw [hι_β, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
    exact hGen_TX

theorem weil_odp_wit_val_subring_residue_and_rank1_max (k : Type u) [Field k] [IsAlgClosed k]
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial k)))
    (ht_eq : p_R Polynomial.X = t_bar)
    (hπ_pR : π_cl.comp p_R = Polynomial.evalRingHom 0)
    (hφ_pR : φ_R_Ω.comp p_R =
      algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k)))) :
    let P := Polynomial k
    let K_k := FractionRing P
    let Ω := AlgebraicClosure K_k
    ∃ (V_s : ValuationSubring Ω) (j_val : R_bar →+* ↥V_s) (π_Vs : ↥V_s →+* k)
      (hX_mem : algebraMap P Ω Polynomial.X ∈ V_s),
      IsLocalHom j_val ∧
      V_s.subtype.comp j_val = φ_R_Ω ∧
      RingHom.ker π_Vs = IsLocalRing.maximalIdeal ↥V_s ∧
      π_Vs.comp j_val = π_cl ∧
      (⟨algebraMap P Ω Polynomial.X, hX_mem⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s ∧
      (∀ c : k, ∃ hc : algebraMap P Ω (Polynomial.C c) ∈ V_s,
        π_Vs ⟨algebraMap P Ω (Polynomial.C c), hc⟩ = c) ∧
      (∀ (γ : Ω ≃ₐ[K_k] Ω), (∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) →
        ∀ z : ↥V_s, ∃ hz : γ z.1 ∈ V_s,
          (⟨γ z.1, hz⟩ : ↥V_s) - z ∈ IsLocalRing.maximalIdeal ↥V_s) ∧
      (∀ (L : IntermediateField K_k Ω) (W : ValuationSubring ↥L)
         (hXL : algebraMap P ↥L Polynomial.X ∈ W),
        (⟨algebraMap P ↥L Polynomial.X, hXL⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W →
        (∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ W) →
        (W ≤ V_s.comap L.val.toRingHom ∨ V_s.comap L.val.toRingHom ≤ W) →
        W = V_s.comap L.val.toRingHom) :=
by
  classical
  intro P K_k Ω
  obtain ⟨V_s, h_mem, hj_loc⟩ := IsLocalRing.exists_factor_valuationRing φ_R_Ω
  let j_val : R_bar →+* ↥V_s := φ_R_Ω.codRestrict V_s.toSubring h_mem
  have _ : IsLocalHom j_val := hj_loc
  have hj_sub : V_s.subtype.comp j_val = φ_R_Ω := by
    ext r
    rfl
  have hπ_cl_C : ∀ c : k, π_cl (p_R (Polynomial.C c)) = c := by
    intro c
    have h := RingHom.congr_fun hπ_pR (Polynomial.C c)
    simpa only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] using h
  have hπ_cl_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar :=
    IsLocalRing.ker_eq_maximalIdeal π_cl (fun c => ⟨p_R (Polynomial.C c), hπ_cl_C c⟩)
  have hφ_apply : ∀ p : P, φ_R_Ω (p_R p) = algebraMap P Ω p :=
    fun p => RingHom.congr_fun hφ_pR p
  have hX_eq_φ : algebraMap P Ω Polynomial.X = φ_R_Ω t_bar := by
    rw [← ht_eq, hφ_apply Polynomial.X]
  have hX_mem : algebraMap P Ω Polynomial.X ∈ V_s := by
    rw [hX_eq_φ]
    exact h_mem t_bar
  have hC_mem : ∀ c : k, algebraMap P Ω (Polynomial.C c) ∈ V_s := by
    intro c
    rw [← hφ_apply (Polynomial.C c)]
    exact h_mem (p_R (Polynomial.C c))
  have ht_max : t_bar ∈ IsLocalRing.maximalIdeal R_bar := by
    rw [← hπ_cl_ker, RingHom.mem_ker, ← ht_eq]
    have h := RingHom.congr_fun hπ_pR Polynomial.X
    simpa only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X] using h
  have hX_jval : (⟨algebraMap P Ω Polynomial.X, hX_mem⟩ : ↥V_s) = j_val t_bar :=
    Subtype.ext hX_eq_φ
  have hX_max_Vs : (⟨algebraMap P Ω Polynomial.X, hX_mem⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s := by
    rw [hX_jval]
    exact map_nonunit j_val t_bar ht_max
  have hValHelper : ∀ (E : Type u) [Field E] [Algebra P E] [Algebra K_k E]
      [IsScalarTower P K_k E] [Algebra.IsAlgebraic K_k E]
      (W : ValuationSubring E)
      (hX_W : algebraMap P E Polynomial.X ∈ W)
      (hX_max_W : (⟨algebraMap P E Polynomial.X, hX_W⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W)
      (hC_W : ∀ c : k, algebraMap P E (Polynomial.C c) ∈ W),
      (∃ π_W : ↥W →+* k,
        RingHom.ker π_W = IsLocalRing.maximalIdeal ↥W ∧
        ∀ c : k, π_W ⟨algebraMap P E (Polynomial.C c), hC_W c⟩ = c) ∧
      (∀ u : ↥W, u ∈ IsLocalRing.maximalIdeal ↥W →
        ∃ (j₀ : ℕ) (v : ↥W), 1 ≤ j₀ ∧ u ^ j₀ = ⟨algebraMap P E Polynomial.X, hX_W⟩ * v) := by
    intro E _ _ _ _ _ W hX_W hX_max_W hC_W
    have hP_W : ∀ p : P, algebraMap P E p ∈ W.toSubring := by
      intro p
      refine Polynomial.induction_on' p ?_ ?_
      · intro p₁ p₂ hp₁ hp₂
        rw [map_add]
        exact W.toSubring.add_mem hp₁ hp₂
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        exact W.toSubring.mul_mem (hC_W c) (W.toSubring.pow_mem hX_W n)
    let ι_W : P →+* ↥W := (algebraMap P E).codRestrict W.toSubring hP_W
    have hι_X : ι_W Polynomial.X = ⟨algebraMap P E Polynomial.X, hX_W⟩ := Subtype.ext rfl
    have hι_C : ∀ c : k, ι_W (Polynomial.C c) = ⟨algebraMap P E (Polynomial.C c), hC_W c⟩ :=
      fun _ => Subtype.ext rfl
    have hPE_inj : Function.Injective (algebraMap P E) := by
      intro p₁ p₂ hp
      have hp' : algebraMap K_k E (algebraMap P K_k p₁) =
          algebraMap K_k E (algebraMap P K_k p₂) := by
        rwa [← IsScalarTower.algebraMap_apply P K_k E,
          ← IsScalarTower.algebraMap_apply P K_k E]
      exact IsFractionRing.injective P K_k ((RingHom.injective (algebraMap K_k E)) hp')
    have hXE_ne : algebraMap P E Polynomial.X ≠ 0 := by
      intro h0
      exact Polynomial.X_ne_zero (hPE_inj (h0.trans (map_zero _).symm))
    have hCleared : ∀ z : ↥W,
        ∃ (G : Polynomial P) (i₀ : ℕ) (h : ℕ → P),
          i₀ ∈ G.support ∧
          (h i₀).coeff 0 ≠ 0 ∧
          ∑ i ∈ G.support, ι_W (h i) * z ^ i = 0 := by
      intro z
      have hz_algK : IsAlgebraic K_k z.1 := Algebra.IsAlgebraic.isAlgebraic (R := K_k) z.1
      have hz_algP : IsAlgebraic P z.1 := (IsFractionRing.isAlgebraic_iff P K_k E).mpr hz_algK
      obtain ⟨G, hG_ne, hG_eval⟩ := hz_algP
      have hSupp_ne : G.support.Nonempty := Polynomial.support_nonempty.mpr hG_ne
      obtain ⟨i₀, hi₀_supp, hm_le⟩ :=
        Finset.exists_min_image G.support (fun i => (G.coeff i).natTrailingDegree) hSupp_ne
      set m : ℕ := (G.coeff i₀).natTrailingDegree
      have h_dvd : ∀ i : ℕ, Polynomial.X ^ m ∣ G.coeff i := by
        intro i
        by_cases hi : i ∈ G.support
        · rw [Polynomial.X_pow_dvd_iff]
          intro d hd
          exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (lt_of_lt_of_le hd (hm_le i hi))
        · rw [Polynomial.notMem_support_iff.mp hi]
          exact dvd_zero _
      choose h h_fac using h_dvd
      have hh_i₀ : (h i₀).coeff 0 ≠ 0 := by
        have hgi₀_ne : G.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀_supp
        have hcm_ne : (G.coeff i₀).coeff m ≠ 0 :=
          Polynomial.coeff_natTrailingDegree_ne_zero.mpr hgi₀_ne
        rw [h_fac i₀, Polynomial.coeff_X_pow_mul'] at hcm_ne
        simpa only [le_refl, ↓reduceIte, Nat.sub_self] using hcm_ne
      have h_sumE : ∑ i ∈ G.support, algebraMap P E (h i) * (z.1) ^ i = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum, Polynomial.sum_def] at hG_eval
        have h_factE : (∑ i ∈ G.support, algebraMap P E (G.coeff i) * (z.1) ^ i) =
            (algebraMap P E Polynomial.X) ^ m *
              ∑ i ∈ G.support, algebraMap P E (h i) * (z.1) ^ i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [h_fac i, map_mul, map_pow, mul_assoc]
        rw [h_factE] at hG_eval
        exact (mul_eq_zero.mp hG_eval).resolve_left (pow_ne_zero m hXE_ne)
      have h_sum : ∑ i ∈ G.support, ι_W (h i) * z ^ i = 0 := by
        apply Subtype.ext
        have hsub : ((∑ i ∈ G.support, ι_W (h i) * z ^ i : ↥W) : E) =
            ∑ i ∈ G.support, algebraMap P E (h i) * (z.1) ^ i := by
          change W.subtype (∑ i ∈ G.support, ι_W (h i) * z ^ i) = _
          simp only [map_sum, map_mul, map_pow]
          rfl
        exact hsub.trans h_sumE
      exact ⟨G, i₀, h, hi₀_supp, hh_i₀, h_sum⟩
    have hRes_ex : ∃ π_W : ↥W →+* k,
        RingHom.ker π_W = IsLocalRing.maximalIdeal ↥W ∧
        ∀ c : k, π_W ⟨algebraMap P E (Polynomial.C c), hC_W c⟩ = c := by
      let 𝔪_W : Ideal ↥W := IsLocalRing.maximalIdeal ↥W
      have _ : 𝔪_W.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥W
      let κ_W := ↥W ⧸ 𝔪_W
      let _ : Field κ_W := Ideal.Quotient.field 𝔪_W
      let q_W : ↥W →+* κ_W := Ideal.Quotient.mk 𝔪_W
      let φ_kκ : k →+* κ_W := q_W.comp (ι_W.comp Polynomial.C)
      let _ : Algebra k κ_W := φ_kκ.toAlgebra
      have hq_X : q_W (ι_W Polynomial.X) = 0 := by
        rw [hι_X]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hX_max_W
      have hq_P : ∀ p : P, q_W (ι_W p) = algebraMap k κ_W (p.coeff 0) := by
        intro p
        have hp_div := Polynomial.X_mul_divX_add p
        have h1 := congrArg (fun f => q_W (ι_W f)) hp_div
        simp only [map_add, map_mul, hq_X, zero_mul, zero_add] at h1
        exact h1.symm
      have _ : Algebra.IsAlgebraic k κ_W := by
        refine ⟨fun x => ?_⟩
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨G, i₀, h, hi₀_supp, hh_i₀, h_sum⟩ := hCleared z
        let f₀ : Polynomial k := ∑ i ∈ G.support, Polynomial.monomial i ((h i).coeff 0)
        have hf₀_ne : f₀ ≠ 0 := by
          intro h0
          have hc0 : f₀.coeff i₀ = 0 := by rw [h0, Polynomial.coeff_zero]
          dsimp [f₀] at hc0
          rw [Polynomial.finsetSum_coeff] at hc0
          have hsum_eq : (∑ i ∈ G.support, (Polynomial.monomial i ((h i).coeff 0)).coeff i₀) =
              (h i₀).coeff 0 := by
            simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq' G.support i₀,
              hi₀_supp, ↓reduceIte]
          exact hh_i₀ (hsum_eq.symm.trans hc0)
        have hf₀_eval : Polynomial.aeval (q_W z) f₀ = 0 := by
          dsimp [f₀]
          rw [map_sum]
          have hcongr : (∑ i ∈ G.support,
              Polynomial.aeval (q_W z) (Polynomial.monomial i ((h i).coeff 0))) =
              q_W (∑ i ∈ G.support, ι_W (h i) * z ^ i) := by
            rw [map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Polynomial.aeval_monomial, ← hq_P (h i), map_mul, map_pow]
          rw [hcongr, h_sum, map_zero]
        exact ⟨f₀, hf₀_ne, hf₀_eval⟩
      let ψ_κ : κ_W →ₐ[k] k := IsAlgClosed.lift
      let π_W : ↥W →+* k := ψ_κ.toRingHom.comp q_W
      have hπ_C : ∀ c : k, π_W ⟨algebraMap P E (Polynomial.C c), hC_W c⟩ = c := by
        intro c
        rw [← hι_C c]
        exact ψ_κ.commutes c
      have hπ_ker : RingHom.ker π_W = IsLocalRing.maximalIdeal ↥W :=
        IsLocalRing.ker_eq_maximalIdeal π_W
          (fun c => ⟨⟨algebraMap P E (Polynomial.C c), hC_W c⟩, hπ_C c⟩)
      exact ⟨π_W, hπ_ker, hπ_C⟩
    obtain ⟨π_W, hπ_ker, hπ_C⟩ := hRes_ex
    have hπ_X : π_W (ι_W Polynomial.X) = 0 := by
      rw [hι_X, ← RingHom.mem_ker, hπ_ker]
      exact hX_max_W
    have hπ_P : ∀ p : P, π_W (ι_W p) = p.coeff 0 := by
      intro p
      have hp_div := Polynomial.X_mul_divX_add p
      have h1 := congrArg (fun f => π_W (ι_W f)) hp_div
      simp only [map_add, map_mul, hπ_X, zero_mul, zero_add] at h1
      rw [← h1, hι_C, hπ_C]
    refine ⟨⟨π_W, hπ_ker, hπ_C⟩, fun u hu_max => ?_⟩
    have hπ_u : π_W u = 0 := by
      rwa [← hπ_ker, RingHom.mem_ker] at hu_max
    obtain ⟨G, i₀, h, hi₀_supp, hh_i₀, h_sum⟩ := hCleared u
    let S_0 : Finset ℕ := G.support.filter (fun i => (h i).coeff 0 ≠ 0)
    have hi₀_S0 : i₀ ∈ S_0 := Finset.mem_filter.mpr ⟨hi₀_supp, hh_i₀⟩
    have hS0_ne : S_0.Nonempty := ⟨i₀, hi₀_S0⟩
    set j₀ : ℕ := S_0.min' hS0_ne
    have hj₀_mem : j₀ ∈ S_0 := Finset.min'_mem S_0 hS0_ne
    have hj₀_supp : j₀ ∈ G.support := (Finset.mem_filter.mp hj₀_mem).1
    have hh_j₀ : (h j₀).coeff 0 ≠ 0 := (Finset.mem_filter.mp hj₀_mem).2
    have hj₀_pos : 1 ≤ j₀ := by
      by_contra hj₀_not_pos
      have hj₀_zero : j₀ = 0 := by omega
      have h0_supp : 0 ∈ G.support := hj₀_zero ▸ hj₀_supp
      have hh_0 : (h 0).coeff 0 ≠ 0 := hj₀_zero ▸ hh_j₀
      have hπ_sum := congrArg π_W h_sum
      rw [map_zero, map_sum, ← Finset.add_sum_erase G.support _ h0_supp] at hπ_sum
      have h_rest : ∑ i ∈ G.support.erase 0, π_W (ι_W (h i) * u ^ i) = 0 := by
        refine Finset.sum_eq_zero fun i hi => ?_
        have hi_ne : i ≠ 0 := Finset.ne_of_mem_erase hi
        rw [map_mul, map_pow, hπ_u, zero_pow hi_ne, mul_zero]
      rw [h_rest, add_zero, pow_zero, mul_one, hπ_P (h 0)] at hπ_sum
      exact hh_0 hπ_sum
    let S_lt : Finset ℕ := G.support.filter (· < j₀)
    let S_ge : Finset ℕ := G.support.filter (fun i => ¬ i < j₀)
    have h_part : (∑ i ∈ S_lt, ι_W (h i) * u ^ i) + (∑ i ∈ S_ge, ι_W (h i) * u ^ i) = 0 := by
      rw [Finset.sum_filter_add_sum_filter_not G.support (· < j₀)]
      exact h_sum
    let q_lt : ↥W := ∑ i ∈ S_lt, ι_W (h i).divX * u ^ i
    have h_lt_eq : ∑ i ∈ S_lt, ι_W (h i) * u ^ i = ι_W Polynomial.X * q_lt := by
      dsimp [q_lt]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_supp : i ∈ G.support := (Finset.mem_filter.mp hi).1
      have hi_lt : i < j₀ := (Finset.mem_filter.mp hi).2
      have h_c0 : (h i).coeff 0 = 0 := by
        by_contra hc_ne
        have hi_S0 : i ∈ S_0 := Finset.mem_filter.mpr ⟨hi_supp, hc_ne⟩
        exact not_lt_of_ge (Finset.min'_le S_0 i hi_S0) hi_lt
      have h_div := (Polynomial.X_mul_divX_add (h i)).symm
      rw [h_c0, Polynomial.C_0, add_zero] at h_div
      conv_lhs => rw [h_div]
      rw [map_mul, mul_assoc]
    let w_0 : ↥W := ∑ i ∈ S_ge, ι_W (h i) * u ^ (i - j₀)
    have h_ge_eq : ∑ i ∈ S_ge, ι_W (h i) * u ^ i = u ^ j₀ * w_0 := by
      dsimp [w_0]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_ge : j₀ ≤ i := Nat.not_lt.mp (Finset.mem_filter.mp hi).2
      have hi_add : j₀ + (i - j₀) = i := Nat.add_sub_of_le hi_ge
      rw [← mul_left_comm, ← pow_add, hi_add]
    have h_rel : u ^ j₀ * w_0 = ι_W Polynomial.X * (-q_lt) := by
      rw [h_lt_eq, h_ge_eq] at h_part
      linear_combination h_part
    have hj₀_ge : j₀ ∈ S_ge := Finset.mem_filter.mpr ⟨hj₀_supp, lt_irrefl j₀⟩
    have hπ_w0 : π_W w_0 = (h j₀).coeff 0 := by
      dsimp [w_0]
      rw [map_sum, ← Finset.add_sum_erase S_ge _ hj₀_ge]
      have h_rest : ∑ i ∈ S_ge.erase j₀, π_W (ι_W (h i) * u ^ (i - j₀)) = 0 := by
        refine Finset.sum_eq_zero fun i hi => ?_
        have hi_ne : i ≠ j₀ := Finset.ne_of_mem_erase hi
        have hi_ge : j₀ ≤ i := Nat.not_lt.mp (Finset.mem_filter.mp (Finset.mem_of_mem_erase hi)).2
        have hsub_ne : i - j₀ ≠ 0 := by omega
        rw [map_mul, map_pow, hπ_u, zero_pow hsub_ne, mul_zero]
      rw [h_rest, add_zero, Nat.sub_self, pow_zero, mul_one, hπ_P (h j₀)]
    have hw_not_max : w_0 ∉ IsLocalRing.maximalIdeal ↥W := by
      rw [← hπ_ker, RingHom.mem_ker, hπ_w0]
      exact hh_j₀
    have hw_unit : IsUnit w_0 := IsLocalRing.notMem_maximalIdeal.mp hw_not_max
    rcases hw_unit with ⟨w_u, hw_eq⟩
    refine ⟨j₀, (-q_lt) * ↑(w_u⁻¹), hj₀_pos, ?_⟩
    calc
      u ^ j₀ = u ^ j₀ * (↑w_u * ↑(w_u⁻¹)) := by rw [Units.mul_inv, mul_one]
      _ = (u ^ j₀ * w_0) * ↑(w_u⁻¹) := by rw [hw_eq, mul_assoc]
      _ = (ι_W Polynomial.X * (-q_lt)) * ↑(w_u⁻¹) := by rw [h_rel]
      _ = ⟨algebraMap P E Polynomial.X, hX_W⟩ * ((-q_lt) * ↑(w_u⁻¹)) := by rw [hι_X, mul_assoc]
  obtain ⟨⟨π_Vs, hπ_Vs_ker, hπ_Vs_C⟩, _⟩ :=
    hValHelper Ω V_s hX_mem hX_max_Vs hC_mem
  have hπ_Vs_cl : π_Vs.comp j_val = π_cl := by
    ext r
    simp only [RingHom.comp_apply]
    set c : k := π_cl r
    let m : R_bar := r - p_R (Polynomial.C c)
    have hm_max : m ∈ IsLocalRing.maximalIdeal R_bar := by
      rw [← hπ_cl_ker, RingHom.mem_ker]
      dsimp [m, c]
      rw [map_sub, hπ_cl_C, sub_self]
    have hjm_ker : π_Vs (j_val m) = 0 := by
      rw [← RingHom.mem_ker, hπ_Vs_ker]
      exact map_nonunit j_val m hm_max
    have hjC_eq : j_val (p_R (Polynomial.C c)) =
        ⟨algebraMap P Ω (Polynomial.C c), hC_mem c⟩ :=
      Subtype.ext (hφ_apply (Polynomial.C c))
    have hr_decomp : r = m + p_R (Polynomial.C c) := (sub_add_cancel r _).symm
    conv_lhs => rw [hr_decomp]
    rw [map_add, map_add, hjm_ker, zero_add, hjC_eq, hπ_Vs_C]
  have hInertRes : ∀ (γ : Ω ≃ₐ[K_k] Ω), (∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) →
      ∀ z : ↥V_s, ∃ hz : γ z.1 ∈ V_s,
        (⟨γ z.1, hz⟩ : ↥V_s) - z ∈ IsLocalRing.maximalIdeal ↥V_s := by
    intro γ hγ_Vs z
    have hz : γ z.1 ∈ V_s := (hγ_Vs z.1).mp z.2
    refine ⟨hz, ?_⟩
    have hγ_max : ∀ x : ↥V_s, x ∈ IsLocalRing.maximalIdeal ↥V_s →
        (⟨γ x.1, (hγ_Vs x.1).mp x.2⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s := by
      intro x hx_max
      by_contra hx_not_max
      have hu : IsUnit (⟨γ x.1, (hγ_Vs x.1).mp x.2⟩ : ↥V_s) :=
        IsLocalRing.notMem_maximalIdeal.mp hx_not_max
      rcases hu with ⟨u, hu_eq⟩
      have hmul1 : γ x.1 * (u.inv : ↥V_s).1 = 1 := by
        have h1 : (⟨γ x.1, (hγ_Vs x.1).mp x.2⟩ : ↥V_s) * u.inv = 1 := by
          rw [← hu_eq]
          exact u.val_inv
        exact congrArg Subtype.val h1
      have hinv_mem : γ.symm (u.inv : ↥V_s).1 ∈ V_s :=
        (hγ_Vs _).mpr (by rw [γ.apply_symm_apply]; exact (u.inv : ↥V_s).2)
      have hx_mul1 : x * (⟨γ.symm (u.inv : ↥V_s).1, hinv_mem⟩ : ↥V_s) = 1 := by
        apply Subtype.ext
        change x.1 * γ.symm (u.inv : ↥V_s).1 = 1
        rw [← γ.symm_apply_apply x.1, ← map_mul, hmul1, map_one]
      have hx_unit : IsUnit x :=
        ⟨⟨x, ⟨γ.symm (u.inv : ↥V_s).1, hinv_mem⟩, hx_mul1, mul_comm x _ ▸ hx_mul1⟩, rfl⟩
      exact IsLocalRing.notMem_maximalIdeal.mpr hx_unit hx_max
    set c : k := π_Vs z
    let c_V : ↥V_s := ⟨algebraMap P Ω (Polynomial.C c), hC_mem c⟩
    have hz_diff : z - c_V ∈ IsLocalRing.maximalIdeal ↥V_s := by
      rw [← hπ_Vs_ker, RingHom.mem_ker, map_sub, hπ_Vs_C]
      exact sub_self c
    have hγ_diff := hγ_max (z - c_V) hz_diff
    have hγ_c : γ c_V.1 = c_V.1 := by
      dsimp [c_V]
      rw [IsScalarTower.algebraMap_apply P K_k Ω]
      exact γ.commutes (algebraMap P K_k (Polynomial.C c))
    have hγ_sub_eq : (⟨γ (z - c_V).1, (hγ_Vs (z - c_V).1).mp (z - c_V).2⟩ : ↥V_s) =
        (⟨γ z.1, hz⟩ : ↥V_s) - c_V := by
      apply Subtype.ext
      change γ (z.1 - c_V.1) = γ z.1 - c_V.1
      rw [map_sub, hγ_c]
    rw [hγ_sub_eq] at hγ_diff
    have h_cancel : (⟨γ z.1, hz⟩ : ↥V_s) - z =
        ((⟨γ z.1, hz⟩ : ↥V_s) - c_V) - (z - c_V) := by ring
    rw [h_cancel]
    exact (IsLocalRing.maximalIdeal ↥V_s).sub_mem hγ_diff hz_diff
  have hRank1Max : ∀ (L : IntermediateField K_k Ω) (W : ValuationSubring ↥L)
      (hXL : algebraMap P ↥L Polynomial.X ∈ W),
      (⟨algebraMap P ↥L Polynomial.X, hXL⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W →
      (∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ W) →
      (W ≤ V_s.comap L.val.toRingHom ∨ V_s.comap L.val.toRingHom ≤ W) →
      W = V_s.comap L.val.toRingHom := by
    intro L W hXL hX_max_W hC_W h_comp
    have _ : Algebra.IsAlgebraic K_k ↥L := Algebra.IsAlgebraic.of_injective L.val L.val.injective
    let V_L : ValuationSubring ↥L := V_s.comap L.val.toRingHom
    have hL_alg : ∀ p : P, L.val (algebraMap P ↥L p) = algebraMap P Ω p := by
      intro p
      rw [IsScalarTower.algebraMap_apply P K_k ↥L, L.val.commutes,
        ← IsScalarTower.algebraMap_apply P K_k Ω]
    have hX_VL : algebraMap P ↥L Polynomial.X ∈ V_L := by
      rw [ValuationSubring.mem_comap]
      change L.val (algebraMap P ↥L Polynomial.X) ∈ V_s
      rw [hL_alg]
      exact hX_mem
    have hC_VL : ∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ V_L := by
      intro c
      rw [ValuationSubring.mem_comap]
      change L.val (algebraMap P ↥L (Polynomial.C c)) ∈ V_s
      rw [hL_alg]
      exact hC_mem c
    let f_LV : ↥V_L →+* ↥V_s :=
      { toFun := fun y => ⟨L.val y.1, y.2⟩
        map_one' := Subtype.ext (map_one L.val)
        map_mul' := fun _ _ => Subtype.ext (map_mul L.val _ _)
        map_zero' := Subtype.ext (map_zero L.val)
        map_add' := fun _ _ => Subtype.ext (map_add L.val _ _) }
    have hX_max_VL : (⟨algebraMap P ↥L Polynomial.X, hX_VL⟩ : ↥V_L) ∈
        IsLocalRing.maximalIdeal ↥V_L := by
      by_contra h_not_max
      have hu : IsUnit (⟨algebraMap P ↥L Polynomial.X, hX_VL⟩ : ↥V_L) :=
        IsLocalRing.notMem_maximalIdeal.mp h_not_max
      have hu_Vs : IsUnit (f_LV ⟨algebraMap P ↥L Polynomial.X, hX_VL⟩) := hu.map f_LV
      have hf_X : f_LV ⟨algebraMap P ↥L Polynomial.X, hX_VL⟩ =
          ⟨algebraMap P Ω Polynomial.X, hX_mem⟩ :=
        Subtype.ext (hL_alg Polynomial.X)
      rw [hf_X] at hu_Vs
      exact IsLocalRing.notMem_maximalIdeal.mpr hu_Vs hX_max_Vs
    have hEqOfLe : ∀ (V₁ V₂ : ValuationSubring ↥L)
        (hX₁ : algebraMap P ↥L Polynomial.X ∈ V₁)
        (hX_max₁ : (⟨algebraMap P ↥L Polynomial.X, hX₁⟩ : ↥V₁) ∈ IsLocalRing.maximalIdeal ↥V₁)
        (hC₁ : ∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ V₁)
        (hX₂ : algebraMap P ↥L Polynomial.X ∈ V₂)
        (hX_max₂ : (⟨algebraMap P ↥L Polynomial.X, hX₂⟩ : ↥V₂) ∈ IsLocalRing.maximalIdeal ↥V₂),
        V₁ ≤ V₂ → V₁ = V₂ := by
      intro V₁ V₂ hX₁ hX_max₁ hC₁ hX₂ hX_max₂ h_le
      refine le_antisymm h_le fun z hz₂ => ?_
      by_contra hz₁
      have hz_ne : z ≠ 0 := fun h0 => hz₁ (h0 ▸ V₁.zero_mem)
      have hu₁ : z⁻¹ ∈ V₁ := (ValuationSubring.mem_or_inv_mem V₁ z).resolve_left hz₁
      let u : ↥V₁ := ⟨z⁻¹, hu₁⟩
      have hu_max : u ∈ IsLocalRing.maximalIdeal ↥V₁ := by
        by_contra hu_not_max
        have hu_unit : IsUnit u := IsLocalRing.notMem_maximalIdeal.mp hu_not_max
        rcases hu_unit with ⟨w, hw_eq⟩
        have hmul1 : (w.inv : ↥V₁).1 * z⁻¹ = 1 := by
          have h1 : (w.inv : ↥V₁) * u = 1 := by
            rw [← hw_eq]
            exact w.inv_val
          exact congrArg Subtype.val h1
        have hw_eq_z : (w.inv : ↥V₁).1 = z := by
          calc
            (w.inv : ↥V₁).1 = (w.inv : ↥V₁).1 * (z⁻¹ * z) := by
              rw [inv_mul_cancel₀ hz_ne, mul_one]
            _ = ((w.inv : ↥V₁).1 * z⁻¹) * z := by ring
            _ = z := by rw [hmul1, one_mul]
        exact hz₁ (hw_eq_z ▸ (w.inv : ↥V₁).2)
      obtain ⟨j₀, v, _, hv_eq⟩ := (hValHelper ↥L V₁ hX₁ hX_max₁ hC₁).2 u hu_max
      have hv_L : (z⁻¹) ^ j₀ = algebraMap P ↥L Polynomial.X * v.1 :=
        congrArg Subtype.val hv_eq
      have hv₂ : v.1 ∈ V₂ := h_le v.2
      have hprod_mem : v.1 * z ^ j₀ ∈ V₂ :=
        V₂.toSubring.mul_mem hv₂ (V₂.toSubring.pow_mem hz₂ j₀)
      let x₂ : ↥V₂ := ⟨algebraMap P ↥L Polynomial.X, hX₂⟩
      let y₂ : ↥V₂ := ⟨v.1 * z ^ j₀, hprod_mem⟩
      have hX₂_mul1 : x₂ * y₂ = 1 := by
        apply Subtype.ext
        calc
          algebraMap P ↥L Polynomial.X * (v.1 * z ^ j₀) =
              (algebraMap P ↥L Polynomial.X * v.1) * z ^ j₀ := by ring
          _ = (z⁻¹) ^ j₀ * z ^ j₀ := by rw [← hv_L]
          _ = (z⁻¹ * z) ^ j₀ := (mul_pow z⁻¹ z j₀).symm
          _ = 1 := by rw [inv_mul_cancel₀ hz_ne, one_pow]
      have hX₂_unit : IsUnit x₂ :=
        ⟨⟨x₂, y₂, hX₂_mul1, mul_comm x₂ y₂ ▸ hX₂_mul1⟩, rfl⟩
      exact IsLocalRing.notMem_maximalIdeal.mpr hX₂_unit hX_max₂
    rcases h_comp with hWV | hVW
    · exact hEqOfLe W V_L hXL hX_max_W hC_W hX_VL hX_max_VL hWV
    · exact (hEqOfLe V_L W hX_VL hX_max_VL hC_VL hXL hX_max_W hVW).symm
  exact ⟨V_s, j_val, π_Vs, hX_mem, hj_loc, hj_sub, hπ_Vs_ker, hπ_Vs_cl, hX_max_Vs,
    fun c => ⟨hC_mem c, hπ_Vs_C c⟩, hInertRes, hRank1Max⟩

theorem weil_odp_wit_val_stabilizer_profinite_galois_lift (k : Type u) [Field k] [IsAlgClosed k] :
    let P := Polynomial k
    let K_k := FractionRing P
    let Ω := AlgebraicClosure K_k
    ∀ (V_s : ValuationSubring Ω) (hX_mem : algebraMap P Ω Polynomial.X ∈ V_s),
      (⟨algebraMap P Ω Polynomial.X, hX_mem⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s →
      (∀ c : k, algebraMap P Ω (Polynomial.C c) ∈ V_s) →
      (∀ (L : IntermediateField K_k Ω) (W : ValuationSubring ↥L)
         (hXL : algebraMap P ↥L Polynomial.X ∈ W),
        (⟨algebraMap P ↥L Polynomial.X, hXL⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W →
        (∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ W) →
        (W ≤ V_s.comap L.val.toRingHom ∨ V_s.comap L.val.toRingHom ≤ W) →
        W = V_s.comap L.val.toRingHom) →
      ∀ (M : IntermediateField K_k Ω),
        M ≤ separableClosure K_k Ω →
        ∀ (σ_M : ↥M ≃ₐ[K_k] ↥M),
          (∀ x : ↥M, (x : Ω) ∈ V_s ↔ (σ_M x : Ω) ∈ V_s) →
          ∃ γ : Ω ≃ₐ[K_k] Ω,
            (∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) ∧
            (∀ x : ↥M, γ (x : Ω) = (σ_M x : Ω)) :=
by
  classical
  intro P K_k Ω V_s hX_mem hX_max hC_mem _hRank1Max M hM_sep σ_M hσ_M

  
  have hPurelyInsep : ∀ (K₀ L Ω₀ : Type u) [Field K₀] [Field L] [Field Ω₀]
      [Algebra K₀ L] [Algebra K₀ Ω₀] [Algebra L Ω₀] [IsScalarTower K₀ L Ω₀]
      [Normal K₀ Ω₀] [IsPurelyInseparable L Ω₀]
      (V : ValuationSubring Ω₀) (γ_L : L ≃ₐ[K₀] L),
      (∀ z : L, algebraMap L Ω₀ z ∈ V ↔ algebraMap L Ω₀ (γ_L z) ∈ V) →
      ∃ γ : Ω₀ ≃ₐ[K₀] Ω₀,
        (∀ w : Ω₀, w ∈ V ↔ γ w ∈ V) ∧
        (∀ z : L, γ (algebraMap L Ω₀ z) = algebraMap L Ω₀ (γ_L z)) := by
    intro K₀ L Ω₀ _ _ _ _ _ _ _ _ _ V γ_L hγ_L
    let γ : Ω₀ ≃ₐ[K₀] Ω₀ := AlgEquiv.liftNormal γ_L Ω₀
    have hcomm : ∀ z : L, γ (algebraMap L Ω₀ z) = algebraMap L Ω₀ (γ_L z) :=
      AlgEquiv.liftNormal_commutes γ_L Ω₀
    have hPowMem : ∀ {m : ℕ}, 1 ≤ m → ∀ u : Ω₀, u ∈ V ↔ u ^ m ∈ V := by
      intro m hm u
      constructor
      · intro hu
        exact pow_mem hu m
      · intro hum
        obtain ⟨d, rfl⟩ : ∃ d : ℕ, m = d + 1 := ⟨m - 1, (Nat.sub_add_cancel hm).symm⟩
        by_cases hu0 : u = 0
        · rw [hu0]
          exact zero_mem V
        · rcases ValuationSubring.mem_or_inv_mem V u with hu | hu_inv
          · exact hu
          · have hprod : u ^ (d + 1) * (u⁻¹) ^ d ∈ V := mul_mem hum (pow_mem hu_inv d)
            have heq : u ^ (d + 1) * (u⁻¹) ^ d = u := by
              rw [pow_succ', mul_assoc, ← mul_pow, mul_inv_cancel₀ hu0, one_pow, mul_one]
            rwa [heq] at hprod
    refine ⟨γ, fun w => ?_, hcomm⟩
    let q : ℕ := ringExpChar L
    let _ : ExpChar L q := ringExpChar.expChar L
    obtain ⟨n, z, hz⟩ := IsPurelyInseparable.pow_mem L q w
    have hq_pos : 1 ≤ q ^ n := expChar_pow_pos L q n
    have hγ_pow : (γ w) ^ (q ^ n) = algebraMap L Ω₀ (γ_L z) := by
      rw [← map_pow, ← hz, hcomm z]
    rw [hPowMem hq_pos w, ← hz, hγ_L z, ← hγ_pow, ← hPowMem hq_pos (γ w)]

  
  have hProfGal : ∀ (F₀ L : Type u) [Field F₀] [Field L] [Algebra F₀ L] [IsGalois F₀ L]
      (V₁ V₂ : ValuationSubring L),
      (∀ E : FiniteGaloisIntermediateField F₀ L,
        ∃ g : ↥E.toIntermediateField ≃ₐ[F₀] ↥E.toIntermediateField,
          ∀ x : ↥E.toIntermediateField, (x : L) ∈ V₁ ↔ (g x : L) ∈ V₂) →
      ∃ τ : L ≃ₐ[F₀] L, ∀ z : L, z ∈ V₁ ↔ τ z ∈ V₂ := by
    intro F₀ L _ _ _ _ V₁ V₂ hStage
    let S : FiniteGaloisIntermediateField F₀ L → Type u := fun E =>
      { g : ↥E.toIntermediateField ≃ₐ[F₀] ↥E.toIntermediateField //
        ∀ x : ↥E.toIntermediateField, (x : L) ∈ V₁ ↔ (g x : L) ∈ V₂ }
    let res_S : ∀ {E₁ E₂ : FiniteGaloisIntermediateField F₀ L}, E₁ ≤ E₂ → S E₂ → S E₁ :=
      fun {E₁ E₂} h g₂ =>
        let inc : ↥E₁.toIntermediateField →ₐ[F₀] ↥E₂.toIntermediateField :=
          IntermediateField.inclusion h
        letI : Algebra ↥E₁.toIntermediateField ↥E₂.toIntermediateField := inc.toRingHom.toAlgebra
        letI : IsScalarTower F₀ ↥E₁.toIntermediateField ↥E₂.toIntermediateField :=
          IsScalarTower.of_algebraMap_eq fun c => (inc.commutes c).symm
        let g₁ : ↥E₁.toIntermediateField ≃ₐ[F₀] ↥E₁.toIntermediateField :=
          AlgEquiv.restrictNormal g₂.1 ↥E₁.toIntermediateField
        ⟨g₁, fun x => by
          have hcomm_x : (g₁ x : L) = (g₂.1 (inc x) : L) :=
            congrArg Subtype.val (AlgEquiv.restrictNormal_commutes g₂.1 ↥E₁.toIntermediateField x)
          rw [hcomm_x]
          exact g₂.2 (inc x)⟩
    have hres_val : ∀ {E₁ E₂ : FiniteGaloisIntermediateField F₀ L} (h : E₁ ≤ E₂)
        (g₂ : S E₂) (x : ↥E₁.toIntermediateField),
        ((res_S h g₂).1 x : L) = (g₂.1 (IntermediateField.inclusion h x) : L) := by
      intro E₁ E₂ h g₂ x
      let inc : ↥E₁.toIntermediateField →ₐ[F₀] ↥E₂.toIntermediateField :=
        IntermediateField.inclusion h
      let _ : Algebra ↥E₁.toIntermediateField ↥E₂.toIntermediateField := inc.toRingHom.toAlgebra
      have _ : IsScalarTower F₀ ↥E₁.toIntermediateField ↥E₂.toIntermediateField :=
        IsScalarTower.of_algebraMap_eq fun c => (inc.commutes c).symm
      exact congrArg Subtype.val (AlgEquiv.restrictNormal_commutes g₂.1 ↥E₁.toIntermediateField x)
    let F_sys : (FiniteGaloisIntermediateField F₀ L)ᵒᵖ ⥤ Type u :=
      { obj := fun j => S (Opposite.unop j)
        map := fun f => TypeCat.ofHom (res_S (CategoryTheory.leOfHom f.unop))
        map_id := fun j => by
          ext g x
          exact hres_val le_rfl g x
        map_comp := fun f g => by
          ext u x
          change ((res_S (CategoryTheory.leOfHom (f ≫ g).unop) u).1 x : L) =
            ((res_S (CategoryTheory.leOfHom g.unop)
              (res_S (CategoryTheory.leOfHom f.unop) u)).1 x : L)
          rw [hres_val, hres_val, hres_val]
          rfl }
    have _ : ∀ j : (FiniteGaloisIntermediateField F₀ L)ᵒᵖ, Finite (F_sys.obj j) :=
      fun j => Subtype.finite
    have _ : ∀ j : (FiniteGaloisIntermediateField F₀ L)ᵒᵖ, Nonempty (F_sys.obj j) :=
      fun j => let ⟨g, hg⟩ := hStage (Opposite.unop j); ⟨⟨g, hg⟩⟩
    obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system F_sys
    have hs_coh : ∀ {E₁ E₂ : FiniteGaloisIntermediateField F₀ L} (h : E₁ ≤ E₂)
        (x : ↥E₁.toIntermediateField),
        ((s (Opposite.op E₁)).1 x : L) =
          ((s (Opposite.op E₂)).1 (IntermediateField.inclusion h x) : L) := by
      intro E₁ E₂ h x
      have hmap : res_S h (s (Opposite.op E₂)) = s (Opposite.op E₁) :=
        hs (CategoryTheory.homOfLE h).op
      rw [← hmap, hres_val]
    let E_of : L → FiniteGaloisIntermediateField F₀ L :=
      fun z => FiniteGaloisIntermediateField.adjoin F₀ ({z} : Set L)
    have hmem_E : ∀ z : L, z ∈ (E_of z).toIntermediateField :=
      fun z => FiniteGaloisIntermediateField.subset_adjoin F₀ ({z} : Set L) (Set.mem_singleton z)
    let τ_fun : L → L := fun z => ((s (Opposite.op (E_of z))).1 ⟨z, hmem_E z⟩ : L)
    let τ_inv : L → L := fun z => ((s (Opposite.op (E_of z))).1.symm ⟨z, hmem_E z⟩ : L)
    have hEval : ∀ (E : FiniteGaloisIntermediateField F₀ L) (z : L)
        (hz : z ∈ E.toIntermediateField),
        τ_fun z = ((s (Opposite.op E)).1 ⟨z, hz⟩ : L) := by
      intro E z hz
      have hle : E_of z ≤ E := (FiniteGaloisIntermediateField.adjoin_simple_le_iff).mpr hz
      exact hs_coh hle ⟨z, hmem_E z⟩
    have hEvalInv : ∀ (E : FiniteGaloisIntermediateField F₀ L) (z : L)
        (hz : z ∈ E.toIntermediateField),
        τ_inv z = ((s (Opposite.op E)).1.symm ⟨z, hz⟩ : L) := by
      intro E z hz
      have hle : E_of z ≤ E := (FiniteGaloisIntermediateField.adjoin_simple_le_iff).mpr hz
      let w₀ : ↥(E_of z).toIntermediateField :=
        (s (Opposite.op (E_of z))).1.symm ⟨z, hmem_E z⟩
      let wE : ↥E.toIntermediateField := IntermediateField.inclusion hle w₀
      have h_app : (s (Opposite.op E)).1 wE = ⟨z, hz⟩ := by
        apply Subtype.ext
        rw [← hs_coh hle w₀]
        change ((s (Opposite.op (E_of z))).1
          ((s (Opposite.op (E_of z))).1.symm ⟨z, hmem_E z⟩) : L) = z
        rw [(s (Opposite.op (E_of z))).1.apply_symm_apply]
      have hwE : wE = (s (Opposite.op E)).1.symm ⟨z, hz⟩ := by
        rw [← h_app, (s (Opposite.op E)).1.symm_apply_apply]
      exact congrArg Subtype.val hwE
    let τ : L ≃ₐ[F₀] L :=
      { toFun := τ_fun
        invFun := τ_inv
        left_inv := fun z => by
          let u : ↥(E_of z).toIntermediateField := (s (Opposite.op (E_of z))).1 ⟨z, hmem_E z⟩
          change τ_inv (u : L) = z
          rw [hEvalInv (E_of z) u.1 u.2]
          change ((s (Opposite.op (E_of z))).1.symm ((s (Opposite.op (E_of z))).1 ⟨z, hmem_E z⟩) : L) = z
          rw [(s (Opposite.op (E_of z))).1.symm_apply_apply]
        right_inv := fun z => by
          let v : ↥(E_of z).toIntermediateField := (s (Opposite.op (E_of z))).1.symm ⟨z, hmem_E z⟩
          change τ_fun (v : L) = z
          rw [hEval (E_of z) v.1 v.2]
          change ((s (Opposite.op (E_of z))).1 ((s (Opposite.op (E_of z))).1.symm ⟨z, hmem_E z⟩) : L) = z
          rw [(s (Opposite.op (E_of z))).1.apply_symm_apply]
        map_mul' := fun x y => by
          let E := E_of x ⊔ E_of y
          have hx : x ∈ E.toIntermediateField :=
            (le_sup_left : E_of x ≤ E) (hmem_E x)
          have hy : y ∈ E.toIntermediateField :=
            (le_sup_right : E_of y ≤ E) (hmem_E y)
          have hxy : x * y ∈ E.toIntermediateField := E.toIntermediateField.mul_mem hx hy
          rw [hEval E (x * y) hxy, hEval E x hx, hEval E y hy]
          change ((s (Opposite.op E)).1 (⟨x, hx⟩ * ⟨y, hy⟩) : L) = _
          rw [map_mul]
          rfl
        map_add' := fun x y => by
          let E := E_of x ⊔ E_of y
          have hx : x ∈ E.toIntermediateField :=
            (le_sup_left : E_of x ≤ E) (hmem_E x)
          have hy : y ∈ E.toIntermediateField :=
            (le_sup_right : E_of y ≤ E) (hmem_E y)
          have hxy : x + y ∈ E.toIntermediateField := E.toIntermediateField.add_mem hx hy
          rw [hEval E (x + y) hxy, hEval E x hx, hEval E y hy]
          change ((s (Opposite.op E)).1 (⟨x, hx⟩ + ⟨y, hy⟩) : L) = _
          rw [map_add]
          rfl
        commutes' := fun c => by
          let E : FiniteGaloisIntermediateField F₀ L := ⊥
          have hc : algebraMap F₀ L c ∈ E.toIntermediateField :=
            E.toIntermediateField.algebraMap_mem c
          rw [hEval E (algebraMap F₀ L c) hc]
          change ((s (Opposite.op E)).1 (algebraMap F₀ ↥E.toIntermediateField c) : L) = _
          rw [(s (Opposite.op E)).1.commutes c]
          rfl }
    exact ⟨τ, fun z => (s (Opposite.op (E_of z))).2 ⟨z, hmem_E z⟩⟩

  
  have hFinGal : ∀ (F₀ E : Type u) [Field F₀] [Field E]
      [Algebra K_k F₀] [Algebra K_k E] [Algebra F₀ E] [IsScalarTower K_k F₀ E]
      [FiniteDimensional F₀ E] [IsGalois F₀ E] [Algebra.IsSeparable K_k E]
      (W₁ W₂ : ValuationSubring E)
      (hX₁ : algebraMap K_k E (algebraMap P K_k Polynomial.X) ∈ W₁)
      (hX₂ : algebraMap K_k E (algebraMap P K_k Polynomial.X) ∈ W₂),
      (⟨algebraMap K_k E (algebraMap P K_k Polynomial.X), hX₁⟩ : ↥W₁) ∈
        IsLocalRing.maximalIdeal ↥W₁ →
      (∀ c : k, algebraMap K_k E (algebraMap P K_k (Polynomial.C c)) ∈ W₁) →
      (⟨algebraMap K_k E (algebraMap P K_k Polynomial.X), hX₂⟩ : ↥W₂) ∈
        IsLocalRing.maximalIdeal ↥W₂ →
      (∀ c : k, algebraMap K_k E (algebraMap P K_k (Polynomial.C c)) ∈ W₂) →
      W₁.comap (algebraMap F₀ E) = W₂.comap (algebraMap F₀ E) →
      ∃ g : E ≃ₐ[F₀] E, ∀ x : E, x ∈ W₁ ↔ g x ∈ W₂ := by
    intro F₀ E _ _ _ _ _ _ _ _ _ W₁ W₂ hX₁ hX₂ hX₁_max hC₁ hX₂_max hC₂ hComap
    let X_E : E := algebraMap K_k E (algebraMap P K_k Polynomial.X)
    let A₀ : ValuationSubring F₀ := W₁.comap (algebraMap F₀ E)
    let _ : Algebra ↥A₀ E := ((algebraMap F₀ E).comp A₀.subtype).toAlgebra
    have _ : IsScalarTower ↥A₀ F₀ E := IsScalarTower.of_algebraMap_eq' rfl
    let C_E : Subalgebra ↥A₀ E := integralClosure ↥A₀ E
    have _ : IsFractionRing ↥C_E E := integralClosure.isFractionRing_of_finite_extension F₀ E
    have _ : Algebra.IsIntegral ↥A₀ ↥C_E := IsIntegralClosure.isIntegral_algebra ↥A₀ E
    have _ : IsGaloisGroup (E ≃ₐ[F₀] E) F₀ E := IsGaloisGroup.of_isGalois F₀ E
    have _ : IsGaloisGroup (E ≃ₐ[F₀] E) ↥A₀ ↥C_E :=
      IsGaloisGroup.of_isFractionRing (E ≃ₐ[F₀] E) ↥A₀ ↥C_E F₀ E
    have _ : Algebra.IsInvariant ↥A₀ ↥C_E (E ≃ₐ[F₀] E) := IsGaloisGroup.isInvariant

    have hMax_iff : ∀ (W : ValuationSubring E) (u : E) (hu : u ∈ W),
        (⟨u, hu⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ (u ≠ 0 ∧ u⁻¹ ∈ W) := by
      intro W u hu
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      constructor
      · rintro hnu ⟨hu0, hinv⟩
        exact hnu ⟨⟨⟨u, hu⟩, ⟨u⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ hu0),
          Subtype.ext (inv_mul_cancel₀ hu0)⟩, rfl⟩
      · rintro hnot ⟨⟨_, v, huv, _⟩, hval⟩
        have hu_eq : (⟨u, hu⟩ : ↥W) * v = 1 := by rw [← hval]; exact huv
        have hE : u * v.1 = 1 := congrArg Subtype.val hu_eq
        have hu0 : u ≠ 0 := fun h0 => zero_ne_one (by rw [h0, zero_mul] at hE; exact hE)
        have hv_inv : u⁻¹ = v.1 := inv_eq_of_mul_eq_one_right hE
        exact hnot ⟨hu0, hv_inv ▸ v.2⟩

    have hCE_mem : ∀ (W : ValuationSubring E),
        W.comap (algebraMap F₀ E) = A₀ → ∀ y : ↥C_E, y.1 ∈ W := by
      intro W hW y
      let α_W : ↥A₀ →+* ↥W :=
        { toFun := fun a => ⟨algebraMap F₀ E a.1, by
            change a.1 ∈ W.comap (algebraMap F₀ E)
            rw [hW]
            exact a.2⟩
          map_one' := Subtype.ext (map_one _)
          map_mul' := fun _ _ => Subtype.ext (map_mul _ _ _)
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun _ _ => Subtype.ext (map_add _ _ _) }
      obtain ⟨p, hp_mon, hp_eval⟩ := y.2
      have hIntW : _root_.IsIntegral ↥W y.1 := by
        refine ⟨p.map α_W, hp_mon.map α_W, ?_⟩
        rw [Polynomial.eval₂_map]
        have hcomp : W.subtype.comp α_W = algebraMap ↥A₀ E := by ext a; rfl
        change Polynomial.eval₂ (W.subtype.comp α_W) y.1 p = 0
        rwa [hcomp]
      obtain ⟨v, hv⟩ := IsIntegrallyClosed.isIntegral_iff.mp hIntW
      rw [← hv]
      exact v.2

    let ι_CE : ∀ (W : ValuationSubring E), W.comap (algebraMap F₀ E) = A₀ → (↥C_E →+* ↥W) :=
      fun W hW =>
        { toFun := fun y => ⟨y.1, hCE_mem W hW y⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }

    let P_of : ∀ (W : ValuationSubring E), W.comap (algebraMap F₀ E) = A₀ → Ideal ↥C_E :=
      fun W hW => Ideal.comap (ι_CE W hW) (IsLocalRing.maximalIdeal ↥W)

    have hUnder : Ideal.under ↥A₀ (P_of W₁ rfl) = Ideal.under ↥A₀ (P_of W₂ hComap.symm) := by
      ext a
      change ι_CE W₁ rfl (algebraMap ↥A₀ ↥C_E a) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔
        ι_CE W₂ hComap.symm (algebraMap ↥A₀ ↥C_E a) ∈ IsLocalRing.maximalIdeal ↥W₂
      rw [hMax_iff, hMax_iff]
      change ¬ (algebraMap F₀ E a.1 ≠ 0 ∧ (algebraMap F₀ E a.1)⁻¹ ∈ W₁) ↔
        ¬ (algebraMap F₀ E a.1 ≠ 0 ∧ (algebraMap F₀ E a.1)⁻¹ ∈ W₂)
      rw [← map_inv₀ (algebraMap F₀ E) a.1]
      change ¬ (algebraMap F₀ E a.1 ≠ 0 ∧ a.1⁻¹ ∈ W₁.comap (algebraMap F₀ E)) ↔
        ¬ (algebraMap F₀ E a.1 ≠ 0 ∧ a.1⁻¹ ∈ W₂.comap (algebraMap F₀ E))
      rw [hComap]

    let _ : MulSemiringAction (E ≃ₐ[F₀] E) (Ideal ↥C_E) := Ideal.pointwiseMulSemiringAction
    have _ : (P_of W₁ rfl).IsPrime := Ideal.IsPrime.comap _
    have _ : (P_of W₂ hComap.symm).IsPrime := Ideal.IsPrime.comap _
    obtain ⟨g, hg_P⟩ :=
      Algebra.IsInvariant.exists_smul_of_under_eq ↥A₀ ↥C_E (E ≃ₐ[F₀] E)
        (P_of W₁ rfl) (P_of W₂ hComap.symm) hUnder

    have hg_K : ∀ u : K_k, g (algebraMap K_k E u) = algebraMap K_k E u := by
      intro u
      rw [IsScalarTower.algebraMap_apply K_k F₀ E u]
      exact g.commutes (algebraMap K_k F₀ u)

    let W₁' : ValuationSubring E := W₂.comap g.toRingHom
    have hW₁'_comap : W₁'.comap (algebraMap F₀ E) = A₀ := by
      ext a
      change g (algebraMap F₀ E a) ∈ W₂ ↔ algebraMap F₀ E a ∈ W₁
      rw [g.commutes a]
      change a ∈ W₂.comap (algebraMap F₀ E) ↔ a ∈ W₁.comap (algebraMap F₀ E)
      rw [hComap]

    have hW₁'_max_iff : ∀ (u : E) (hu : u ∈ W₁'),
        (⟨u, hu⟩ : ↥W₁') ∈ IsLocalRing.maximalIdeal ↥W₁' ↔
          (⟨g u, hu⟩ : ↥W₂) ∈ IsLocalRing.maximalIdeal ↥W₂ := by
      intro u hu
      rw [hMax_iff W₁' u hu, hMax_iff W₂ (g u) hu]
      have hne : u ≠ 0 ↔ g u ≠ 0 := ⟨fun h h0 => h (g.injective (h0.trans (map_zero g).symm)),
        fun h h0 => h (by rw [h0, map_zero])⟩
      have hinv : u⁻¹ ∈ W₁' ↔ (g u)⁻¹ ∈ W₂ := by
        change g u⁻¹ ∈ W₂ ↔ (g u)⁻¹ ∈ W₂
        rw [map_inv₀ g u]
      rw [hne, hinv]

    have hX₁' : X_E ∈ W₁' := by
      change g X_E ∈ W₂
      rw [hg_K]
      exact hX₂
    have hX₁'_max : (⟨X_E, hX₁'⟩ : ↥W₁') ∈ IsLocalRing.maximalIdeal ↥W₁' := by
      rw [hW₁'_max_iff X_E hX₁']
      have hsub : (⟨g X_E, hX₁'⟩ : ↥W₂) = ⟨X_E, hX₂⟩ := Subtype.ext (hg_K _)
      rwa [hsub]

    have hP_eq : P_of W₁ rfl = P_of W₁' hW₁'_comap := by
      ext y
      have hmem_smul : y ∈ P_of W₁ rfl ↔ g • y ∈ P_of W₂ hComap.symm := by
        rw [hg_P]
        exact (Ideal.smul_mem_pointwise_smul_iff).symm
      rw [hmem_smul]
      change ι_CE W₂ hComap.symm (g • y) ∈ IsLocalRing.maximalIdeal ↥W₂ ↔
        (⟨y.1, hCE_mem W₁' hW₁'_comap y⟩ : ↥W₁') ∈ IsLocalRing.maximalIdeal ↥W₁'
      rw [hW₁'_max_iff y.1 (hCE_mem W₁' hW₁'_comap y)]
      have hsub : ι_CE W₂ hComap.symm (g • y) = ⟨g y.1, hCE_mem W₁' hW₁'_comap y⟩ :=
        Subtype.ext rfl
      rw [hsub]

    have hP_poly_A₀ : ∀ p : P, algebraMap K_k F₀ (algebraMap P K_k p) ∈ A₀ := by
      intro p
      change algebraMap F₀ E (algebraMap K_k F₀ (algebraMap P K_k p)) ∈ W₁
      rw [← IsScalarTower.algebraMap_apply K_k F₀ E]
      let φ_PE : P →+* E := (algebraMap K_k E).comp (algebraMap P K_k)
      change φ_PE p ∈ W₁
      refine Polynomial.induction_on' p ?_ ?_
      · intro p₁ p₂ h₁ h₂
        rw [map_add]
        exact add_mem h₁ h₂
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        exact mul_mem (hC₁ c) (pow_mem hX₁ n)

    have hPin : ∀ (U₁ U₂ : ValuationSubring E)
        (hU₁ : U₁.comap (algebraMap F₀ E) = A₀)
        (hU₂ : U₂.comap (algebraMap F₀ E) = A₀)
        (hXU₁ : X_E ∈ U₁),
        (⟨X_E, hXU₁⟩ : ↥U₁) ∈ IsLocalRing.maximalIdeal ↥U₁ →
        P_of U₁ hU₁ = P_of U₂ hU₂ →
        ∀ z : E, z ∈ U₁ → z ∈ U₂ := by
      intro U₁ U₂ hU₁ hU₂ hXU₁ hXU₁_max hPU z hz
      by_cases hz0 : z = 0
      · rw [hz0]
        exact zero_mem U₂
      · let F_z : IntermediateField K_k E := IntermediateField.adjoin K_k ({z} : Set E)
        let z' : ↥F_z := ⟨z, IntermediateField.mem_adjoin_simple_self K_k z⟩
        have hz_int : _root_.IsIntegral K_k z := (Algebra.IsSeparable.isSeparable K_k z).isIntegral
        have _ : FiniteDimensional K_k ↥F_z := IntermediateField.adjoin.finiteDimensional hz_int
        let _ : Algebra ↥F_z E := F_z.val.toRingHom.toAlgebra
        have _ : IsScalarTower K_k ↥F_z E :=
          IsScalarTower.of_algebraMap_eq fun c => (F_z.val.commutes c).symm
        have _ : Algebra.IsSeparable K_k ↥F_z :=
          Algebra.isSeparable_tower_bot_of_isSeparable K_k ↥F_z E
        let _ : Algebra P ↥F_z := ((algebraMap K_k ↥F_z).comp (algebraMap P K_k)).toAlgebra
        have _ : IsScalarTower P K_k ↥F_z := IsScalarTower.of_algebraMap_eq' rfl
        let O_z : Subalgebra P ↥F_z := integralClosure P ↥F_z
        have _ : IsDedekindDomain ↥O_z := integralClosure.isDedekindDomain P K_k ↥F_z
        have _ : IsFractionRing ↥O_z ↥F_z :=
          integralClosure.isFractionRing_of_finite_extension K_k ↥F_z

        let φ_PF₀ : P →+* F₀ := (algebraMap K_k F₀).comp (algebraMap P K_k)
        let ψ_PA₀ : P →+* ↥A₀ :=
          { toFun := fun p => ⟨φ_PF₀ p, hP_poly_A₀ p⟩
            map_one' := Subtype.ext (map_one φ_PF₀)
            map_mul' := fun _ _ => Subtype.ext (map_mul φ_PF₀ _ _)
            map_zero' := Subtype.ext (map_zero φ_PF₀)
            map_add' := fun _ _ => Subtype.ext (map_add φ_PF₀ _ _) }

        have hOz_CE : ∀ w : ↥O_z, (w.1 : E) ∈ C_E := by
          intro w
          obtain ⟨f, hf_mon, hf_eval⟩ := w.2
          refine ⟨f.map ψ_PA₀, hf_mon.map ψ_PA₀, ?_⟩
          rw [Polynomial.eval₂_map]
          have hcomp : (algebraMap ↥A₀ E).comp ψ_PA₀ =
              F_z.val.toRingHom.comp (algebraMap P ↥F_z) := by
            refine RingHom.ext fun p => ?_
            simp only [RingHom.comp_apply]
            change algebraMap F₀ E (algebraMap K_k F₀ (algebraMap P K_k p)) =
              F_z.val (algebraMap K_k ↥F_z (algebraMap P K_k p))
            rw [← IsScalarTower.algebraMap_apply K_k F₀ E, F_z.val.commutes]
          change Polynomial.eval₂ ((algebraMap ↥A₀ E).comp ψ_PA₀) (F_z.val.toRingHom w.1) f = 0
          rw [hcomp, ← Polynomial.hom_eval₂, hf_eval, map_zero]

        let j_z : ↥O_z →+* ↥C_E :=
          { toFun := fun w => ⟨(w.1 : E), hOz_CE w⟩
            map_one' := rfl
            map_mul' := fun _ _ => rfl
            map_zero' := rfl
            map_add' := fun _ _ => rfl }

        let q : Ideal ↥O_z := Ideal.comap j_z (P_of U₁ hU₁)
        have _ : q.IsPrime := Ideal.IsPrime.comap j_z

        have hq_U₁ : ∀ w : ↥O_z,
            w ∈ q ↔ (⟨(w.1 : E), hCE_mem U₁ hU₁ (j_z w)⟩ : ↥U₁) ∈ IsLocalRing.maximalIdeal ↥U₁ :=
          fun _ => Iff.rfl
        have hq_U₂ : ∀ w : ↥O_z,
            w ∈ q ↔ (⟨(w.1 : E), hCE_mem U₂ hU₂ (j_z w)⟩ : ↥U₂) ∈ IsLocalRing.maximalIdeal ↥U₂ := by
          intro w
          change j_z w ∈ P_of U₁ hU₁ ↔ _
          rw [hPU]
          rfl

        let x_Oz : ↥O_z := algebraMap P ↥O_z Polynomial.X
        have hx_Oz_val : (x_Oz.1 : E) = X_E := by
          change F_z.val (algebraMap K_k ↥F_z (algebraMap P K_k Polynomial.X)) = X_E
          exact F_z.val.commutes _
        have hx_mem_q : x_Oz ∈ q := by
          rw [hq_U₁]
          have hsub : (⟨(x_Oz.1 : E), hCE_mem U₁ hU₁ (j_z x_Oz)⟩ : ↥U₁) = ⟨X_E, hXU₁⟩ :=
            Subtype.ext hx_Oz_val
          rwa [hsub]
        have hx_Oz_ne : x_Oz ≠ 0 := by
          intro h0
          have hXE0 : X_E = 0 := hx_Oz_val.symm.trans (congrArg Subtype.val (congrArg Subtype.val h0))
          have hXK0 : algebraMap P K_k Polynomial.X = 0 :=
            (algebraMap K_k E).injective (hXE0.trans (map_zero _).symm)
          exact Polynomial.X_ne_zero
            ((IsFractionRing.injective P K_k) (hXK0.trans (map_zero _).symm))
        have hq_ne_bot : q ≠ ⊥ := by
          intro hbot
          rw [hbot, Ideal.mem_bot] at hx_mem_q
          exact hx_Oz_ne hx_mem_q

        let R_q := Localization.AtPrime q
        have _ : IsDiscreteValuationRing R_q :=
          IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥O_z hq_ne_bot R_q
        have hVal_Rq : ValuationRing R_q := of_isDiscreteValuationRing R_q
        have hRq_inj : Function.Injective (algebraMap ↥O_z R_q) :=
          IsLocalization.injective R_q (Ideal.primeCompl_le_nonZeroDivisors q)

        obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors ↥O_z) z'
        have hab_E : z * (b.1.1 : E) = (a.1 : E) := congrArg Subtype.val hab
        have hb_ne0 : b.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
        have hb_E_ne : (b.1.1 : E) ≠ 0 := fun h0 => hb_ne0 (Subtype.ext (Subtype.ext h0))

        obtain ⟨r, hr_ab | hr_ba⟩ :=
          @ValuationRing.cond R_q _ (@ValuationRing.toPreValuationRing R_q _ _ hVal_Rq)
            (algebraMap ↥O_z R_q a) (algebraMap ↥O_z R_q b.1)
        · obtain ⟨⟨c, s⟩, hrcs⟩ := IsLocalization.surj q.primeCompl r
          have hbs_ac : b.1 * s.1 = a * c := hRq_inj (by
            rw [map_mul, map_mul, ← hr_ab, mul_assoc, hrcs])
          have hbs_ac_E : (b.1.1 : E) * (s.1.1 : E) = (b.1.1 : E) * (z * (c.1 : E)) := by
            have hE : (b.1.1 : E) * (s.1.1 : E) = (a.1 : E) * (c.1 : E) :=
              congrArg (fun u : ↥O_z => (u.1 : E)) hbs_ac
            rw [hE, ← hab_E]
            ring
          have hs_eq_zc : (s.1.1 : E) = z * (c.1 : E) := mul_left_cancel₀ hb_E_ne hbs_ac_E
          by_cases hc_q : c ∈ q
          · have hc_max :
                (⟨(c.1 : E), hCE_mem U₁ hU₁ (j_z c)⟩ : ↥U₁) ∈ IsLocalRing.maximalIdeal ↥U₁ :=
              (hq_U₁ c).mp hc_q
            have hs_sub : (⟨(s.1.1 : E), hCE_mem U₁ hU₁ (j_z s.1)⟩ : ↥U₁) =
                (⟨z, hz⟩ : ↥U₁) * ⟨(c.1 : E), hCE_mem U₁ hU₁ (j_z c)⟩ :=
              Subtype.ext hs_eq_zc
            have hs_max :
                (⟨(s.1.1 : E), hCE_mem U₁ hU₁ (j_z s.1)⟩ : ↥U₁) ∈ IsLocalRing.maximalIdeal ↥U₁ := by
              rw [hs_sub]
              exact Ideal.mul_mem_left _ _ hc_max
            exact False.elim (s.2 ((hq_U₁ s.1).mpr hs_max))
          · have hc_not_max :
                (⟨(c.1 : E), hCE_mem U₂ hU₂ (j_z c)⟩ : ↥U₂) ∉ IsLocalRing.maximalIdeal ↥U₂ :=
              mt (hq_U₂ c).mpr hc_q
            rw [hMax_iff, not_not] at hc_not_max
            obtain ⟨hc_ne, hc_inv_U₂⟩ := hc_not_max
            have hs_U₂ : (s.1.1 : E) ∈ U₂ := hCE_mem U₂ hU₂ (j_z s.1)
            have hz_eq : z = (s.1.1 : E) * (c.1 : E)⁻¹ := by
              rw [hs_eq_zc, mul_assoc, mul_inv_cancel₀ hc_ne, mul_one]
            rw [hz_eq]
            exact mul_mem hs_U₂ hc_inv_U₂
        · obtain ⟨⟨c, s⟩, hrcs⟩ := IsLocalization.surj q.primeCompl r
          have has_bc : a * s.1 = b.1 * c := hRq_inj (by
            rw [map_mul, map_mul, ← hr_ba, mul_assoc, hrcs])
          have has_bc_E : (b.1.1 : E) * (z * (s.1.1 : E)) = (b.1.1 : E) * (c.1 : E) := by
            have hE : (a.1 : E) * (s.1.1 : E) = (b.1.1 : E) * (c.1 : E) :=
              congrArg (fun u : ↥O_z => (u.1 : E)) has_bc
            rw [← hE, ← hab_E]
            ring
          have hzs_eq_c : z * (s.1.1 : E) = (c.1 : E) := mul_left_cancel₀ hb_E_ne has_bc_E
          have hs_not_max :
              (⟨(s.1.1 : E), hCE_mem U₂ hU₂ (j_z s.1)⟩ : ↥U₂) ∉ IsLocalRing.maximalIdeal ↥U₂ :=
            mt (hq_U₂ s.1).mpr s.2
          rw [hMax_iff, not_not] at hs_not_max
          obtain ⟨hs_ne, hs_inv_U₂⟩ := hs_not_max
          have hc_U₂ : (c.1 : E) ∈ U₂ := hCE_mem U₂ hU₂ (j_z c)
          have hz_eq : z = (c.1 : E) * (s.1.1 : E)⁻¹ := by
            rw [← hzs_eq_c, mul_assoc, mul_inv_cancel₀ hs_ne, mul_one]
          rw [hz_eq]
          exact mul_mem hc_U₂ hs_inv_U₂

    exact ⟨g, fun x => ⟨hPin W₁ W₁' rfl hW₁'_comap hX₁ hX₁_max hP_eq x,
      hPin W₁' W₁ hW₁'_comap rfl hX₁' hX₁'_max hP_eq.symm x⟩⟩

  
  have hSepLift : ∀ (M₀ L₀ : Type u) [Field M₀] [Field L₀]
      [Algebra K_k M₀] [Algebra K_k L₀] [Algebra M₀ L₀] [IsScalarTower K_k M₀ L₀]
      [IsGalois K_k L₀] [Algebra.IsSeparable K_k L₀]
      (j_L : L₀ →ₐ[K_k] Ω) (σ₀ : M₀ ≃ₐ[K_k] M₀),
      (∀ x : M₀, j_L (algebraMap M₀ L₀ x) ∈ V_s ↔ j_L (algebraMap M₀ L₀ (σ₀ x)) ∈ V_s) →
      ∃ γ_sep : L₀ ≃ₐ[K_k] L₀,
        (∀ z : L₀, j_L z ∈ V_s ↔ j_L (γ_sep z) ∈ V_s) ∧
        (∀ x : M₀, γ_sep (algebraMap M₀ L₀ x) = algebraMap M₀ L₀ (σ₀ x)) := by
    intro M₀ L₀ _ _ _ _ _ _ _ _ j_L σ₀ hσ₀
    have _ : IsGalois M₀ L₀ := IsGalois.tower_top_of_isGalois K_k M₀ L₀
    let γ₀ : L₀ ≃ₐ[K_k] L₀ := AlgEquiv.liftNormal σ₀ L₀
    have hγ₀_M : ∀ x : M₀, γ₀ (algebraMap M₀ L₀ x) = algebraMap M₀ L₀ (σ₀ x) :=
      AlgEquiv.liftNormal_commutes σ₀ L₀
    let V₁ : ValuationSubring L₀ := V_s.comap j_L.toRingHom
    let V₂ : ValuationSubring L₀ := V₁.comap γ₀.toRingHom

    have hMax_comap : ∀ {F_sub : Type u} [Field F_sub] (φ : F_sub →+* Ω) (u : F_sub)
        (hu : φ u ∈ V_s),
        (⟨φ u, hu⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s →
        (⟨u, hu⟩ : ↥(V_s.comap φ)) ∈ IsLocalRing.maximalIdeal ↥(V_s.comap φ) := by
      intro F_sub _ φ u hu hmax
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmax ⊢
      intro hunit
      let φ_sub : ↥(V_s.comap φ) →+* ↥V_s :=
        { toFun := fun v => ⟨φ v.1, v.2⟩
          map_one' := Subtype.ext (map_one φ)
          map_mul' := fun _ _ => Subtype.ext (map_mul φ _ _)
          map_zero' := Subtype.ext (map_zero φ)
          map_add' := fun _ _ => Subtype.ext (map_add φ _ _) }
      exact hmax (hunit.map φ_sub)

    have hStage : ∀ E : FiniteGaloisIntermediateField M₀ L₀,
        ∃ g : ↥E.toIntermediateField ≃ₐ[M₀] ↥E.toIntermediateField,
          ∀ x : ↥E.toIntermediateField, (x : L₀) ∈ V₁ ↔ (g x : L₀) ∈ V₂ := by
      intro E
      let j_EL : ↥E.toIntermediateField →ₐ[K_k] L₀ :=
        E.toIntermediateField.val.restrictScalars K_k
      have _ : Algebra.IsSeparable K_k ↥E.toIntermediateField :=
        ⟨fun x => by
          dsimp [IsSeparable]
          rw [← minpoly.algHom_eq j_EL j_EL.injective x]
          exact Algebra.IsSeparable.isSeparable K_k (j_EL x)⟩
      let φ₁ : ↥E.toIntermediateField →+* Ω :=
        j_L.toRingHom.comp E.toIntermediateField.val.toRingHom
      let φ₂ : ↥E.toIntermediateField →+* Ω :=
        j_L.toRingHom.comp (γ₀.toRingHom.comp E.toIntermediateField.val.toRingHom)
      let W₁ : ValuationSubring ↥E.toIntermediateField := V_s.comap φ₁
      let W₂ : ValuationSubring ↥E.toIntermediateField := V_s.comap φ₂
      have hφ₁_P : ∀ p : P,
          φ₁ (algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k p)) =
            algebraMap P Ω p := by
        intro p
        change j_L (E.toIntermediateField.val
          (algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k p))) = algebraMap P Ω p
        rw [IsScalarTower.algebraMap_apply K_k M₀ ↥E.toIntermediateField,
          E.toIntermediateField.val.commutes,
          ← IsScalarTower.algebraMap_apply K_k M₀ L₀, j_L.commutes,
          ← IsScalarTower.algebraMap_apply P K_k Ω]
      have hφ₂_P : ∀ p : P,
          φ₂ (algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k p)) =
            algebraMap P Ω p := by
        intro p
        change j_L (γ₀ (E.toIntermediateField.val
          (algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k p)))) = algebraMap P Ω p
        rw [IsScalarTower.algebraMap_apply K_k M₀ ↥E.toIntermediateField,
          E.toIntermediateField.val.commutes,
          ← IsScalarTower.algebraMap_apply K_k M₀ L₀, γ₀.commutes, j_L.commutes,
          ← IsScalarTower.algebraMap_apply P K_k Ω]
      have hX₁ : algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k Polynomial.X) ∈ W₁ := by
        change φ₁ _ ∈ V_s
        rw [hφ₁_P]
        exact hX_mem
      have hX₂ : algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k Polynomial.X) ∈ W₂ := by
        change φ₂ _ ∈ V_s
        rw [hφ₂_P]
        exact hX_mem
      have hX₁_max :
          (⟨algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k Polynomial.X), hX₁⟩ : ↥W₁) ∈
            IsLocalRing.maximalIdeal ↥W₁ := by
        refine hMax_comap φ₁ _ hX₁ ?_
        have hsub : (⟨φ₁ _, hX₁⟩ : ↥V_s) = ⟨algebraMap P Ω Polynomial.X, hX_mem⟩ :=
          Subtype.ext (hφ₁_P Polynomial.X)
        rwa [hsub]
      have hX₂_max :
          (⟨algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k Polynomial.X), hX₂⟩ : ↥W₂) ∈
            IsLocalRing.maximalIdeal ↥W₂ := by
        refine hMax_comap φ₂ _ hX₂ ?_
        have hsub : (⟨φ₂ _, hX₂⟩ : ↥V_s) = ⟨algebraMap P Ω Polynomial.X, hX_mem⟩ :=
          Subtype.ext (hφ₂_P Polynomial.X)
        rwa [hsub]
      have hC₁ : ∀ c : k,
          algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k (Polynomial.C c)) ∈ W₁ := by
        intro c
        change φ₁ _ ∈ V_s
        rw [hφ₁_P]
        exact hC_mem c
      have hC₂ : ∀ c : k,
          algebraMap K_k ↥E.toIntermediateField (algebraMap P K_k (Polynomial.C c)) ∈ W₂ := by
        intro c
        change φ₂ _ ∈ V_s
        rw [hφ₂_P]
        exact hC_mem c
      have hComap : W₁.comap (algebraMap M₀ ↥E.toIntermediateField) =
          W₂.comap (algebraMap M₀ ↥E.toIntermediateField) := by
        ext x
        have hx₁ : φ₁ (algebraMap M₀ ↥E.toIntermediateField x) = j_L (algebraMap M₀ L₀ x) := by
          change j_L (E.toIntermediateField.val (algebraMap M₀ ↥E.toIntermediateField x)) = _
          rw [E.toIntermediateField.val.commutes x]
        have hx₂ : φ₂ (algebraMap M₀ ↥E.toIntermediateField x) =
            j_L (algebraMap M₀ L₀ (σ₀ x)) := by
          change j_L (γ₀ (E.toIntermediateField.val (algebraMap M₀ ↥E.toIntermediateField x))) = _
          rw [E.toIntermediateField.val.commutes x, hγ₀_M x]
        change φ₁ (algebraMap M₀ ↥E.toIntermediateField x) ∈ V_s ↔
          φ₂ (algebraMap M₀ ↥E.toIntermediateField x) ∈ V_s
        rw [hx₁, hx₂]
        exact hσ₀ x
      exact hFinGal M₀ ↥E.toIntermediateField W₁ W₂ hX₁ hX₂ hX₁_max hC₁ hX₂_max hC₂ hComap

    obtain ⟨τ, hτ_V⟩ := hProfGal M₀ L₀ V₁ V₂ hStage
    let γ_sep : L₀ ≃ₐ[K_k] L₀ := (τ.restrictScalars K_k).trans γ₀
    refine ⟨γ_sep, fun z => hτ_V z, fun x => ?_⟩
    change γ₀ (τ (algebraMap M₀ L₀ x)) = algebraMap M₀ L₀ (σ₀ x)
    rw [τ.commutes x, hγ₀_M x]

  let Ω_sep : IntermediateField K_k Ω := separableClosure K_k Ω
  have _ : IsGalois K_k ↥Ω_sep := separableClosure.isGalois K_k Ω
  have _ : Algebra.IsSeparable K_k ↥Ω_sep := separableClosure.isSeparable K_k Ω
  have _ : IsPurelyInseparable ↥Ω_sep Ω := separableClosure.isPurelyInseparable K_k Ω
  let ι_M : ↥M →ₐ[K_k] ↥Ω_sep := IntermediateField.inclusion hM_sep
  let _ : Algebra ↥M ↥Ω_sep := ι_M.toRingHom.toAlgebra
  have _ : IsScalarTower K_k ↥M ↥Ω_sep :=
    IsScalarTower.of_algebraMap_eq fun c => by
      change algebraMap K_k ↥Ω_sep c = ι_M (algebraMap K_k ↥M c)
      exact (ι_M.commutes c).symm
  obtain ⟨γ_sep, hγ_sep_V, hγ_sep_M⟩ := hSepLift ↥M ↥Ω_sep Ω_sep.val σ_M hσ_M
  obtain ⟨γ, hγ_V, hγ_comm⟩ := hPurelyInsep K_k ↥Ω_sep Ω V_s γ_sep hγ_sep_V
  refine ⟨γ, hγ_V, fun x => ?_⟩
  change γ (algebraMap ↥Ω_sep Ω (ι_M x)) = (σ_M x : Ω)
  rw [hγ_comm (ι_M x)]
  exact congrArg Subtype.val (hγ_sep_M x)

theorem weil_odp_wit_geom_inertia_compositum_extend (F : Type u) [Finite F] [Field F] :
    let k := AlgebraicClosure F
    let P := Polynomial k
    let K_k := FractionRing P
    let Ω := AlgebraicClosure K_k
    ∀ (α_pt : RatFunc F ≃ₐ[F] RatFunc F) (t_pt : RatFunc F),
      α_pt RatFunc.X = t_pt →
      ∀ (ψ_k : RatFunc F →+* K_k) (ψ_pt : RatFunc F →+* Ω),
        ψ_pt = (algebraMap K_k Ω).comp ψ_k →
        ψ_k.comp (algebraMap F (RatFunc F)) =
          (algebraMap P K_k).comp (Polynomial.C.comp (algebraMap F k)) →
        ψ_k t_pt = algebraMap P K_k Polynomial.X →
        ∀ (V_s : ValuationSubring Ω) (hX_mem : algebraMap P Ω Polynomial.X ∈ V_s),
          (⟨algebraMap P Ω Polynomial.X, hX_mem⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s →
          (∀ c : k, algebraMap P Ω (Polynomial.C c) ∈ V_s) →
          (∀ (L : IntermediateField K_k Ω) (W : ValuationSubring ↥L)
             (hXL : algebraMap P ↥L Polynomial.X ∈ W),
            (⟨algebraMap P ↥L Polynomial.X, hXL⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W →
            (∀ c : k, algebraMap P ↥L (Polynomial.C c) ∈ W) →
            (W ≤ V_s.comap L.val.toRingHom ∨ V_s.comap L.val.toRingHom ≤ W) →
            W = V_s.comap L.val.toRingHom) →
          ∀ (L_r : Type u) [Field L_r] [Algebra F L_r] [Algebra (RatFunc F) L_r]
            [IsScalarTower F (RatFunc F) L_r] [FiniteDimensional (RatFunc F) L_r]
            [IsGalois (RatFunc F) L_r]
            (ι_r : L_r →+* Ω),
            ι_r.comp (algebraMap (RatFunc F) L_r) = ψ_pt →
            let A_pt := Algebra.adjoin F ({algebraMap (RatFunc F) L_r t_pt} : Set L_r)
            let C_pt := integralClosure ↥A_pt L_r
            ∀ (Q_pt : Ideal ↥C_pt),
              (∀ y : ↥C_pt, y ∈ Q_pt ↔ ∃ hy : ι_r y.1 ∈ V_s,
                (⟨ι_r y.1, hy⟩ : ↥V_s) ∈ IsLocalRing.maximalIdeal ↥V_s) →
              let E_r : IntermediateField K_k Ω := IntermediateField.adjoin K_k (Set.range ι_r)
              (E_r ≤ separableClosure K_k Ω ∧ FiniteDimensional K_k ↥E_r ∧ IsGalois K_k ↥E_r) ∧
              ∀ (σ_L : L_r ≃ₐ[RatFunc F] L_r),
                (∀ x : L_r, IsIntegral F x → σ_L x = x) →
                (∀ y : ↥C_pt, σ_L y.1 - y.1 ∈ Subtype.val '' (Q_pt : Set ↥C_pt)) →
                ∃ (σ_E : ↥E_r ≃ₐ[K_k] ↥E_r),
                  (∀ z : L_r, ∃ hz : ι_r z ∈ E_r, (σ_E ⟨ι_r z, hz⟩ : Ω) = ι_r (σ_L z)) ∧
                  (∀ w : ↥E_r, (w : Ω) ∈ V_s ↔ (σ_E w : Ω) ∈ V_s) :=
by
  classical
  intro k P K_k Ω _α_pt t_pt _hα_pt ψ_k ψ_pt hψ_pt hψ_k_F hψ_k_t
    V_s hX_mem hX_max hC_mem hRank1Max
    L_r _ _ _ _ _ _ ι_r hι_RF A_pt C_pt Q_pt hQ_iff E_r

  let K₀ := RatFunc F
  have hι_K₀ : ι_r.comp (algebraMap K₀ L_r) = (algebraMap K_k Ω).comp ψ_k :=
    hι_RF.trans hψ_pt

  
  
  
  have hPart1 : E_r ≤ separableClosure K_k Ω ∧ FiniteDimensional K_k ↥E_r ∧ IsGalois K_k ↥E_r := by
    obtain ⟨p, hp_sep, sp⟩ := IsGalois.is_separable_splitting_field K₀ L_r
    let _ : Polynomial.IsSplittingField K₀ L_r p := sp
    let q : Polynomial K_k := p.map ψ_k
    have hq_sep : q.Separable := hp_sep.map
    have hp_ne : p ≠ 0 := hp_sep.ne_zero
    have hq_ne : q ≠ 0 := hq_sep.ne_zero
    have hq_splits : (q.map (algebraMap K_k Ω)).Splits := IsAlgClosed.splits _
    let E_split : IntermediateField K_k Ω := IntermediateField.adjoin K_k (q.rootSet Ω)
    let _ : Polynomial.IsSplittingField K_k ↥E_split q :=
      IntermediateField.adjoin_rootSet_isSplittingField hq_splits
    have hFD_split : FiniteDimensional K_k ↥E_split :=
      Polynomial.IsSplittingField.finiteDimensional ↥E_split q
    have hGal_split : IsGalois K_k ↥E_split :=
      IsGalois.of_separable_splitting_field hq_sep
    have hEr_eq : E_r = E_split := by
      apply le_antisymm
      · rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨z, rfl⟩
        have hz_top : z ∈ (⊤ : Subalgebra K₀ L_r) := Algebra.mem_top
        rw [← Polynomial.IsSplittingField.adjoin_rootSet L_r p] at hz_top
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz_top
        · intro a ha
          rw [Polynomial.mem_rootSet_of_ne hp_ne] at ha
          have ha_q : ι_r a ∈ q.rootSet Ω := by
            rw [Polynomial.mem_rootSet_of_ne hq_ne]
            change Polynomial.eval₂ (algebraMap K_k Ω) (ι_r a) (p.map ψ_k) = 0
            rw [Polynomial.eval₂_map, ← hι_K₀, ← Polynomial.hom_eval₂]
            change ι_r (Polynomial.aeval a p) = 0
            rw [ha, map_zero]
          exact IntermediateField.subset_adjoin K_k (q.rootSet Ω) ha_q
        · intro c
          have hc := RingHom.congr_fun hι_K₀ c
          simp only [RingHom.comp_apply] at hc
          rw [hc]
          exact E_split.algebraMap_mem (ψ_k c)
        · intro x y _ _ hx hy
          rw [map_add]
          exact E_split.add_mem hx hy
        · intro x y _ _ hx hy
          rw [map_mul]
          exact E_split.mul_mem hx hy
      · rw [IntermediateField.adjoin_le_iff]
        intro w hw
        rw [Polynomial.mem_rootSet_of_ne hq_ne] at hw
        let p_L : Polynomial L_r := p.map (algebraMap K₀ L_r)
        have hpL_ne : p_L ≠ 0 := Polynomial.map_ne_zero hp_ne
        have hpL_splits : p_L.Splits := Polynomial.IsSplittingField.splits L_r p
        have hpL_prod :
            p_L = Polynomial.C p_L.leadingCoeff *
              (p_L.roots.map (fun a : L_r => Polynomial.X - Polynomial.C a)).prod :=
          hpL_splits.eq_prod_roots
        have hq_map : q.map (algebraMap K_k Ω) = p_L.map ι_r := by
          dsimp [q, p_L]
          rw [Polynomial.map_map, Polynomial.map_map, hι_K₀]
        have heval0 : Polynomial.eval w (p_L.map ι_r) = 0 := by
          rw [← hq_map, Polynomial.eval_map]
          exact hw
        rw [hpL_prod, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_multiset_prod,
          Multiset.map_map, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_multiset_prod, Multiset.map_map] at heval0
        have hlc_ne : ι_r p_L.leadingCoeff ≠ 0 := fun h0 =>
          Polynomial.leadingCoeff_ne_zero.mpr hpL_ne
            (ι_r.injective (h0.trans (map_zero ι_r).symm))
        rcases mul_eq_zero.mp heval0 with h0 | hprod0
        · exact False.elim (hlc_ne h0)
        · rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at hprod0
          obtain ⟨a, _, ha_eq⟩ := hprod0
          simp only [Function.comp_apply, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
            Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at ha_eq
          rw [ha_eq]
          exact IntermediateField.subset_adjoin K_k (Set.range ι_r) ⟨a, rfl⟩
    let e_split : ↥E_split ≃ₐ[K_k] ↥E_r := IntermediateField.equivOfEq hEr_eq.symm
    have hFD_Er : FiniteDimensional K_k ↥E_r :=
      LinearEquiv.finiteDimensional e_split.toLinearEquiv
    have hGal_Er : IsGalois K_k ↥E_r := IsGalois.of_algEquiv e_split
    let _ : FiniteDimensional K_k ↥E_r := hFD_Er
    let _ : IsGalois K_k ↥E_r := hGal_Er
    exact ⟨le_separableClosure K_k Ω E_r, hFD_Er, hGal_Er⟩

  let _ : FiniteDimensional K_k ↥E_r := hPart1.2.1
  let _ : IsGalois K_k ↥E_r := hPart1.2.2

  
  
  
  let i_k : k →+* Ω := (algebraMap P Ω).comp Polynomial.C
  let t₀ : L_r := algebraMap (RatFunc F) L_r t_pt
  let F₁ : IntermediateField F L_r := algebraicClosure F L_r

  have hι_F : ∀ a : F, ι_r (algebraMap F L_r a) = i_k (algebraMap F k a) := by
    intro a
    rw [IsScalarTower.algebraMap_apply F (RatFunc F) L_r a]
    have h1 := RingHom.congr_fun hι_K₀ (algebraMap F (RatFunc F) a)
    have h2 := RingHom.congr_fun hψ_k_F a
    simp only [RingHom.comp_apply] at h1 h2
    rw [h1, h2, ← IsScalarTower.algebraMap_apply P K_k Ω]
    rfl

  have hι_t₀ : ι_r t₀ = algebraMap P Ω Polynomial.X := by
    have h1 := RingHom.congr_fun hι_K₀ t_pt
    simp only [RingHom.comp_apply] at h1
    rw [h1, hψ_k_t, ← IsScalarTower.algebraMap_apply P K_k Ω]

  have hF₁_int : ∀ x : ↥F₁, IsIntegral F x.1 := by
    intro x
    have hx_alg : IsAlgebraic F x.1 := mem_algebraicClosure_iff.mp x.2
    exact isAlgebraic_iff_isIntegral.mp hx_alg

  have hF₁_ex : ∀ x : ↥F₁, ∃ c : k, i_k c = ι_r x.1 := by
    intro x
    let p : Polynomial F := minpoly F x.1
    have hp_monic : p.Monic := minpoly.monic (hF₁_int x)
    let p_k : Polynomial k := p.map (algebraMap F k)
    have hpk_monic : p_k.Monic := hp_monic.map (algebraMap F k)
    have hpk_splits : p_k.Splits := IsAlgClosed.splits p_k
    have hprod_k : p_k = (p_k.roots.map (fun a : k => Polynomial.X - Polynomial.C a)).prod :=
      hpk_splits.eq_prod_roots_of_monic hpk_monic
    have hi_k_F : i_k.comp (algebraMap F k) = ι_r.comp (algebraMap F L_r) := by
      ext a; exact (hι_F a).symm
    have heval0 : Polynomial.eval (ι_r x.1) (p_k.map i_k) = 0 := by
      rw [Polynomial.map_map, hi_k_F, Polynomial.eval_map, ← Polynomial.hom_eval₂]
      change ι_r (Polynomial.aeval x.1 p) = 0
      rw [minpoly.aeval F x.1, map_zero]
    rw [hprod_k, Polynomial.map_multiset_prod, Multiset.map_map,
      Polynomial.eval_multiset_prod, Multiset.map_map, Multiset.prod_eq_zero_iff,
      Multiset.mem_map] at heval0
    obtain ⟨c, _, hc_eval⟩ := heval0
    simp only [Function.comp_apply, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
      Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hc_eval
    exact ⟨c, hc_eval.symm⟩

  let φ₁ : ↥F₁ →ₐ[F] k :=
    { toFun := fun x => Classical.choose (hF₁_ex x)
      map_one' := i_k.injective (by
        rw [Classical.choose_spec (hF₁_ex 1), map_one, OneMemClass.coe_one, map_one])
      map_mul' := fun x y => i_k.injective (by
        rw [Classical.choose_spec (hF₁_ex (x * y)), map_mul,
          Classical.choose_spec (hF₁_ex x), Classical.choose_spec (hF₁_ex y),
          MulMemClass.coe_mul, map_mul])
      map_zero' := i_k.injective (by
        rw [Classical.choose_spec (hF₁_ex 0), map_zero, ZeroMemClass.coe_zero, map_zero])
      map_add' := fun x y => i_k.injective (by
        rw [Classical.choose_spec (hF₁_ex (x + y)), map_add,
          Classical.choose_spec (hF₁_ex x), Classical.choose_spec (hF₁_ex y),
          AddMemClass.coe_add, map_add])
      commutes' := fun a => i_k.injective (by
        rw [Classical.choose_spec (hF₁_ex (algebraMap F ↥F₁ a))]
        exact hι_F a) }

  have hφ₁ : ∀ x : ↥F₁, i_k (φ₁ x) = ι_r x.1 :=
    fun x => Classical.choose_spec (hF₁_ex x)

  
  
  
  have hMinpoly_coeff_F₁ : ∀ c : k,
      letI : Algebra L_r Ω := ι_r.toAlgebra
      IsIntegral L_r (i_k c) ∧ ∀ i : ℕ, (minpoly L_r (i_k c)).coeff i ∈ F₁ := by
    intro c
    let _ : Algebra L_r Ω := ι_r.toAlgebra
    have hc_int_F : IsIntegral F c :=
      isAlgebraic_iff_isIntegral.mp ((AlgebraicClosure.isAlgebraic F).isAlgebraic c)
    let p_F : Polynomial F := minpoly F c
    have hpF_monic : p_F.Monic := minpoly.monic hc_int_F
    let p_L : Polynomial L_r := p_F.map (algebraMap F L_r)
    have hpL_monic : p_L.Monic := hpF_monic.map (algebraMap F L_r)
    have hi_k_F : i_k.comp (algebraMap F k) = ι_r.comp (algebraMap F L_r) := by
      ext a; exact (hι_F a).symm
    have hpL_aeval : Polynomial.aeval (i_k c) p_L = 0 := by
      change Polynomial.eval₂ ι_r (i_k c) (p_F.map (algebraMap F L_r)) = 0
      rw [Polynomial.eval₂_map, ← hi_k_F, ← Polynomial.hom_eval₂]
      change i_k (Polynomial.aeval c p_F) = 0
      rw [minpoly.aeval F c, map_zero]
    have hβ_int : IsIntegral L_r (i_k c) := ⟨p_L, hpL_monic, hpL_aeval⟩
    refine ⟨hβ_int, fun i => ?_⟩
    let g : Polynomial L_r := minpoly L_r (i_k c)
    have hg_monic : g.Monic := minpoly.monic hβ_int
    have hg_dvd : g ∣ p_L := minpoly.dvd L_r (i_k c) hpL_aeval
    have hg_Ω_monic : (g.map ι_r).Monic := hg_monic.map ι_r
    have hg_Ω_splits : (g.map ι_r).Splits := IsAlgClosed.splits (g.map ι_r)
    have hg_Ω_prod :
        g.map ι_r = ((g.map ι_r).roots.map (fun w : Ω => Polynomial.X - Polynomial.C w)).prod :=
      hg_Ω_splits.eq_prod_roots_of_monic hg_Ω_monic
    have hcoeff_int : IsIntegral F (g.coeff i) := by
      let _ : Algebra F Ω := (ι_r.comp (algebraMap F L_r)).toAlgebra
      let R_F : Subalgebra F Ω := integralClosure F Ω
      have hroots_mem : ∀ w ∈ (g.map ι_r).roots, w ∈ R_F := by
        intro w hw
        have hw_eval_g : Polynomial.eval w (g.map ι_r) = 0 :=
          (Polynomial.mem_roots hg_Ω_monic.ne_zero).mp hw
        rcases hg_dvd with ⟨h_fac, hh_fac⟩
        have hw_eval_p : Polynomial.eval w (p_L.map ι_r) = 0 := by
          rw [hh_fac, Polynomial.map_mul, Polynomial.eval_mul, hw_eval_g, zero_mul]
        refine ⟨p_F, hpF_monic, ?_⟩
        change Polynomial.eval₂ (ι_r.comp (algebraMap F L_r)) w p_F = 0
        rw [← Polynomial.eval_map, ← Polynomial.map_map]
        exact hw_eval_p
      let M_sub : Multiset ↥R_F := (g.map ι_r).roots.pmap (fun w hw => ⟨w, hw⟩) hroots_mem
      let Q_sub : Polynomial ↥R_F :=
        (M_sub.map (fun u : ↥R_F => Polynomial.X - Polynomial.C u)).prod
      have hQ_map : Q_sub.map R_F.val.toRingHom = g.map ι_r := by
        dsimp [Q_sub, M_sub]
        rw [Polynomial.map_multiset_prod, Multiset.map_map, Multiset.map_pmap]
        have hfun :
            (fun (a : Ω) (h : a ∈ R_F) =>
              (Polynomial.map ↑R_F.val ∘ fun u : ↥R_F => Polynomial.X - Polynomial.C u) ⟨a, h⟩) =
            (fun (a : Ω) (_ : a ∈ R_F) => Polynomial.X - Polynomial.C a) := by
          ext a h n
          simp
        rw [hfun, Multiset.pmap_eq_map, ← hg_Ω_prod]
      have hcoeff_R_F : ι_r (g.coeff i) ∈ R_F := by
        have h1 : (Q_sub.map R_F.val.toRingHom).coeff i = (g.map ι_r).coeff i :=
          congrArg (fun r => r.coeff i) hQ_map
        rw [Polynomial.coeff_map, Polynomial.coeff_map] at h1
        rw [← h1]
        exact (Q_sub.coeff i).2
      let ι_F : L_r →ₐ[F] Ω := { ι_r with commutes' := fun _ => rfl }
      exact (isIntegral_algHom_iff ι_F ι_F.injective).mp hcoeff_R_F
    exact mem_algebraicClosure_iff.mpr (isAlgebraic_iff_isIntegral.mpr hcoeff_int)

  have hTensor_and_Trace :
      (letI : Algebra ↥F₁ k := φ₁.toRingHom.toAlgebra
       letI : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
       let f_k : k →ₐ[↥F₁] Ω := { i_k with commutes' := hφ₁ }
       let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
       let Φ : (TensorProduct ↥F₁ k L_r) →+* Ω :=
         (Algebra.TensorProduct.lift f_k f_L (fun _ _ => mul_comm _ _)).toRingHom
       Function.Injective Φ ∧ (E_r : Set Ω) = Set.range Φ) ∧
      (∀ (w : Ω),
        (ι_r.comp (algebraMap ↥A_pt L_r)).IsIntegralElem w →
        ∀ (m : ℕ) (c : Fin m → k) (z : Fin m → L_r),
          w = ∑ j : Fin m, i_k (c j) * ι_r (z j) →
          ∃ (s : ℕ) (u : Fin s → k) (y : Fin s → ↥C_pt),
            w = ∑ b : Fin s, i_k (u b) * ι_r (y b).1) := by
    let _ : Algebra ↥F₁ k := φ₁.toRingHom.toAlgebra
    have hST_F_F1_k : IsScalarTower F ↥F₁ k :=
      IsScalarTower.of_algebraMap_eq fun a => (φ₁.commutes a).symm
    let _ : IsScalarTower F ↥F₁ k := hST_F_F1_k
    let _ : PerfectField F := PerfectField.ofFinite
    have hSep_Fk : Algebra.IsSeparable F k :=
      (perfectField_iff_isSeparable_algebraicClosure F k).mp inferInstance
    let _ : Algebra.IsSeparable F k := hSep_Fk
    let _ : Algebra.IsSeparable ↥F₁ k :=
      Algebra.isSeparable_tower_top_of_isSeparable F ↥F₁ k
    have hAlg_F1_k : Algebra.IsAlgebraic ↥F₁ k := by
      let _ : Algebra.IsAlgebraic F k := AlgebraicClosure.isAlgebraic F
      exact Algebra.IsAlgebraic.tower_top (K := F) (L := ↥F₁) (A := k)

    have hFin_inj : ∀ (F' : IntermediateField ↥F₁ k) [FiniteDimensional ↥F₁ ↥F'],
        Algebra.IsSeparable ↥F₁ ↥F' ∧
        Function.Injective
          (letI : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
           let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
           let g_F' : ↥F' →ₐ[↥F₁] Ω :=
             { i_k.comp F'.val.toRingHom with commutes' := hφ₁ }
           Algebra.TensorProduct.lift f_L g_F' (fun _ _ => Commute.all _ _)) := by
      intro F' _
      have hSep_F' : Algebra.IsSeparable ↥F₁ ↥F' :=
        ⟨fun x => IsSeparable.tower_bot (F := ↥F₁) (K := ↥F') (E := k)
          (Algebra.IsSeparable.isSeparable ↥F₁ (algebraMap ↥F' k x))⟩
      let _ : Algebra.IsSeparable ↥F₁ ↥F' := hSep_F'
      refine ⟨hSep_F', ?_⟩
      let _ : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
      let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
      let g_F' : ↥F' →ₐ[↥F₁] Ω := { i_k.comp F'.val.toRingHom with commutes' := hφ₁ }
      let Ψ_alg : TensorProduct ↥F₁ L_r ↥F' →ₐ[↥F₁] Ω :=
        Algebra.TensorProduct.lift f_L g_F' (fun _ _ => Commute.all _ _)
      rw [injective_iff_map_eq_zero]
      intro t ht
      change Ψ_alg t = 0 at ht
      obtain ⟨α₀, hα₀_top⟩ := Field.exists_primitive_element ↥F₁ ↥F'
      have hα₀_int : IsIntegral ↥F₁ α₀ := Algebra.IsIntegral.isIntegral α₀
      let pb₀ : PowerBasis ↥F₁ ↥(IntermediateField.adjoin ↥F₁ ({α₀} : Set ↥F')) :=
        IntermediateField.adjoin.powerBasis hα₀_int
      let pb : PowerBasis ↥F₁ ↥F' :=
        pb₀.map ((IntermediateField.equivOfEq hα₀_top).trans IntermediateField.topEquiv)
      let α : ↥F' := pb.gen
      have hα_int : IsIntegral ↥F₁ α := Algebra.IsIntegral.isIntegral α
      have hdim_eq : (minpoly ↥F₁ α).natDegree = pb.dim := pb.natDegree_minpoly
      have hdeg_le :
          pb.dim ≤ (letI : Algebra L_r Ω := ι_r.toAlgebra; (minpoly L_r (i_k α.1)).natDegree) := by
        let _ : Algebra L_r Ω := ι_r.toAlgebra
        obtain ⟨hβ_int, hcoeff⟩ := hMinpoly_coeff_F₁ α.1
        let g : Polynomial L_r := minpoly L_r (i_k α.1)
        have hg_monic : g.Monic := minpoly.monic hβ_int
        let g₀ : Polynomial ↥F₁ :=
          ∑ i ∈ g.support, Polynomial.monomial i ⟨g.coeff i, hcoeff i⟩
        have hg₀_map : g₀.map (algebraMap ↥F₁ L_r) = g := by
          dsimp [g₀]
          rw [Polynomial.map_sum]
          have hcongr :
              ∑ i ∈ g.support,
                (Polynomial.monomial i (⟨g.coeff i, hcoeff i⟩ : ↥F₁)).map (algebraMap ↥F₁ L_r) =
              ∑ i ∈ g.support, Polynomial.monomial i (g.coeff i) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Polynomial.map_monomial]
            rfl
          rw [hcongr, ← Polynomial.as_sum_support g]
        have hg₀_ne : g₀ ≠ 0 := by
          intro h0
          rw [h0, Polynomial.map_zero] at hg₀_map
          exact hg_monic.ne_zero hg₀_map.symm
        have hg₀_deg : g₀.natDegree = g.natDegree := by
          rw [← hg₀_map, Polynomial.natDegree_map_eq_of_injective (algebraMap ↥F₁ L_r).injective]
        have hg₀_aeval : Polynomial.aeval α g₀ = 0 := by
          apply Subtype.val_injective
          apply i_k.injective
          have hval : ((Polynomial.aeval α g₀ : ↥F') : k) =
              Polynomial.eval₂ φ₁.toRingHom α.1 g₀ := by
            change F'.val.toRingHom (Polynomial.eval₂ (algebraMap ↥F₁ ↥F') α g₀) = _
            rw [Polynomial.hom_eval₂]
            rfl
          rw [ZeroMemClass.coe_zero, map_zero, hval, Polynomial.hom_eval₂]
          have hcomp : i_k.comp φ₁.toRingHom = ι_r.comp (algebraMap ↥F₁ L_r) := by
            ext x; exact hφ₁ x
          rw [hcomp, ← Polynomial.eval₂_map, hg₀_map]
          exact minpoly.aeval L_r (i_k α.1)
        have hdvd : minpoly ↥F₁ α ∣ g₀ := minpoly.dvd ↥F₁ α hg₀_aeval
        rw [← hdim_eq, ← hg₀_deg]
        exact Polynomial.natDegree_le_of_dvd hdvd hg₀_ne
      let b_T : Module.Basis (Fin pb.dim) L_r (TensorProduct ↥F₁ L_r ↥F') :=
        pb.basis.baseChange L_r
      have ht_sum : t = ∑ i : Fin pb.dim, (b_T.repr t i) • b_T i := (b_T.sum_repr t).symm
      have hΨ_sum : Ψ_alg t =
          ∑ i : Fin pb.dim, ι_r (b_T.repr t i) * (i_k α.1) ^ (i : ℕ) := by
        conv_lhs => rw [ht_sum]
        rw [map_sum Ψ_alg]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hb_i : b_T i = TensorProduct.tmul ↥F₁ (1 : L_r) (α ^ (i : ℕ)) := by
          dsimp [b_T]
          rw [Module.Basis.baseChange_apply, pb.basis_eq_pow i]
        have hsmul : (b_T.repr t i) • b_T i =
            TensorProduct.tmul ↥F₁ (b_T.repr t i) (α ^ (i : ℕ)) := by
          rw [hb_i]
          change TensorProduct.tmul ↥F₁ (b_T.repr t i * 1) (α ^ (i : ℕ)) = _
          rw [mul_one]
        rw [hsmul]
        change ι_r (b_T.repr t i) * i_k (F'.val (α ^ (i : ℕ))) = _
        rw [map_pow, map_pow]
        rfl
      let q_L : Polynomial L_r :=
        ∑ i : Fin pb.dim, Polynomial.monomial (i : ℕ) (b_T.repr t i)
      have hqL_eval :
          (letI : Algebra L_r Ω := ι_r.toAlgebra; Polynomial.aeval (i_k α.1) q_L) = 0 := by
        let _ : Algebra L_r Ω := ι_r.toAlgebra
        dsimp [q_L]
        rw [map_sum, ← ht, hΨ_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.aeval_monomial]
        rfl
      have hqL_zero : q_L = 0 := by
        by_contra hq_ne
        let _ : Algebra L_r Ω := ι_r.toAlgebra
        have hdvd : minpoly L_r (i_k α.1) ∣ q_L := minpoly.dvd L_r (i_k α.1) hqL_eval
        have hdeg1 : (minpoly L_r (i_k α.1)).natDegree ≤ q_L.natDegree :=
          Polynomial.natDegree_le_of_dvd hdvd hq_ne
        have hdim_pos : 0 < pb.dim := by
          rw [← hdim_eq]
          exact minpoly.natDegree_pos hα_int
        have hdeg2 : q_L.natDegree ≤ pb.dim - 1 := by
          dsimp [q_L]
          refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun i _ => ?_
          exact (Polynomial.natDegree_monomial_le _).trans (Nat.le_sub_one_of_lt i.2)
        omega
      have hrepr_zero : ∀ i : Fin pb.dim, b_T.repr t i = 0 := by
        intro i
        have hc0 : q_L.coeff (i : ℕ) = 0 := by rw [hqL_zero, Polynomial.coeff_zero]
        dsimp [q_L] at hc0
        rw [Polynomial.finsetSum_coeff] at hc0
        simp only [Polynomial.coeff_monomial] at hc0
        have hsum_eq :
            (∑ x : Fin pb.dim, if (x : ℕ) = (i : ℕ) then b_T.repr t x else 0) =
            b_T.repr t i := by
          have hcongr :
              (∑ x : Fin pb.dim, if (x : ℕ) = (i : ℕ) then b_T.repr t x else 0) =
              ∑ x : Fin pb.dim, if x = i then b_T.repr t x else 0 := by
            refine Finset.sum_congr rfl fun x _ => ?_
            simp [Fin.ext_iff]
          rw [hcongr, Finset.sum_ite_eq' Finset.univ i]
          simp
        rwa [hsum_eq] at hc0
      rw [ht_sum]
      exact Finset.sum_eq_zero fun i _ => by rw [hrepr_zero i, zero_smul]

    have h_tmul_sum : ∀ s₀ : TensorProduct ↥F₁ k L_r,
        ∃ (m : ℕ) (c : Fin m → k) (z : Fin m → L_r),
          s₀ = ∑ j : Fin m, TensorProduct.tmul ↥F₁ (c j) (z j) := by
      intro s₀
      induction s₀ using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      | tmul x y =>
        exact ⟨1, fun _ => x, fun _ => y,
          (Fin.sum_univ_one (fun _ : Fin 1 => TensorProduct.tmul ↥F₁ x y)).symm⟩
      | add t₁ t₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨m₁, c₁, z₁, rfl⟩
        rcases ih₂ with ⟨m₂, c₂, z₂, rfl⟩
        refine ⟨m₁ + m₂, Fin.addCases c₁ c₂, Fin.addCases z₁ z₂, ?_⟩
        rw [Fin.sum_univ_add]
        simp [Fin.addCases]

    refine ⟨?_, ?_⟩
    · 
      let _ : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
      let f_k : k →ₐ[↥F₁] Ω := { i_k with commutes' := hφ₁ }
      let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
      let Φ_alg : (TensorProduct ↥F₁ k L_r) →ₐ[↥F₁] Ω :=
        Algebra.TensorProduct.lift f_k f_L (fun _ _ => Commute.all _ _)
      let Φ : (TensorProduct ↥F₁ k L_r) →+* Ω := Φ_alg.toRingHom
      have hΦ_inj : Function.Injective Φ := by
        change Function.Injective Φ_alg
        rw [injective_iff_map_eq_zero]
        intro t ht
        obtain ⟨m, c, z, rfl⟩ := h_tmul_sum t
        let F' : IntermediateField ↥F₁ k := IntermediateField.adjoin ↥F₁ (Set.range c)
        have hFD_F' : FiniteDimensional ↥F₁ ↥F' :=
          IntermediateField.finiteDimensional_adjoin fun x _ =>
            isAlgebraic_iff_isIntegral.mp (hAlg_F1_k.isAlgebraic x)
        let _ : FiniteDimensional ↥F₁ ↥F' := hFD_F'
        obtain ⟨_, hΨ_inj⟩ := hFin_inj F'
        let g_F' : ↥F' →ₐ[↥F₁] Ω := { i_k.comp F'.val.toRingHom with commutes' := hφ₁ }
        let Ψ_alg : TensorProduct ↥F₁ L_r ↥F' →ₐ[↥F₁] Ω :=
          Algebra.TensorProduct.lift f_L g_F' (fun _ _ => Commute.all _ _)
        let ι_T : TensorProduct ↥F₁ L_r ↥F' →ₗ[↥F₁] TensorProduct ↥F₁ k L_r :=
          (LinearMap.rTensor L_r F'.val.toLinearMap).comp
            (TensorProduct.comm ↥F₁ L_r ↥F').toLinearMap
        let t' : TensorProduct ↥F₁ L_r ↥F' :=
          ∑ j : Fin m, TensorProduct.tmul ↥F₁ (z j)
            ⟨c j, IntermediateField.subset_adjoin ↥F₁ (Set.range c) ⟨j, rfl⟩⟩
        have hι_t' : ι_T t' = ∑ j : Fin m, TensorProduct.tmul ↥F₁ (c j) (z j) := by
          dsimp [t']
          rw [map_sum ι_T]
          refine Finset.sum_congr rfl fun j _ => rfl
        have hΨ_eq : Ψ_alg t' = Φ_alg (∑ j : Fin m, TensorProduct.tmul ↥F₁ (c j) (z j)) := by
          dsimp [t']
          rw [map_sum Ψ_alg, map_sum Φ_alg]
          refine Finset.sum_congr rfl fun j _ => ?_
          change ι_r (z j) * i_k (c j) = i_k (c j) * ι_r (z j)
          exact mul_comm _ _
        have ht'_zero : t' = 0 :=
          hΨ_inj ((hΨ_eq.trans ht).trans (map_zero Ψ_alg).symm)
        rw [← hι_t', ht'_zero, map_zero]
      refine ⟨hΦ_inj, ?_⟩
      have hRange_inv : ∀ u ∈ Set.range Φ, u⁻¹ ∈ Set.range Φ := by
        rintro u ⟨t, rfl⟩
        by_cases hu0 : Φ t = 0
        · rw [hu0, inv_zero]
          exact ⟨0, map_zero Φ⟩
        · let _ : Algebra L_r Ω := ι_r.toAlgebra
          have hST_F1_Lr_Ω : IsScalarTower ↥F₁ L_r Ω :=
            IsScalarTower.of_algebraMap_eq fun _ => rfl
          let _ : IsScalarTower ↥F₁ L_r Ω := hST_F1_Lr_Ω
          let R_sub : Subalgebra L_r Ω := Algebra.adjoin L_r (Set.range i_k)
          have hΦ_mem_R : ∀ s : TensorProduct ↥F₁ k L_r, Φ s ∈ R_sub := by
            intro s
            induction s using TensorProduct.induction_on with
            | zero => rw [map_zero]; exact R_sub.zero_mem
            | tmul c z =>
              change i_k c * ι_r z ∈ R_sub
              exact R_sub.mul_mem (Algebra.subset_adjoin ⟨c, rfl⟩) (R_sub.algebraMap_mem z)
            | add s₁ s₂ h₁ h₂ => rw [map_add]; exact R_sub.add_mem h₁ h₂
          have hR_le_Φ : (R_sub : Set Ω) ⊆ Set.range Φ := by
            intro w hw
            refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hw
            · rintro _ ⟨c, rfl⟩
              exact ⟨TensorProduct.tmul ↥F₁ c 1, by change i_k c * ι_r 1 = i_k c; simp⟩
            · intro z
              exact ⟨TensorProduct.tmul ↥F₁ 1 z, by change i_k 1 * ι_r z = ι_r z; simp⟩
            · rintro w₁ w₂ _ _ ⟨s₁, rfl⟩ ⟨s₂, rfl⟩
              exact ⟨s₁ + s₂, map_add Φ s₁ s₂⟩
            · rintro w₁ w₂ _ _ ⟨s₁, rfl⟩ ⟨s₂, rfl⟩
              exact ⟨s₁ * s₂, map_mul Φ s₁ s₂⟩
          have hInt_R : Algebra.IsIntegral L_r ↥R_sub := by
            rw [Algebra.isIntegral_def]
            intro ⟨w, hw⟩
            rw [← isIntegral_algHom_iff R_sub.val Subtype.val_injective]
            change IsIntegral L_r w
            refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hw
            · rintro _ ⟨c, rfl⟩
              exact (hMinpoly_coeff_F₁ c).1
            · intro z
              exact isIntegral_algebraMap
            · intro w₁ w₂ _ _ h₁ h₂
              exact h₁.add h₂
            · intro w₁ w₂ _ _ h₁ h₂
              exact h₁.mul h₂
          let _ : Algebra.IsIntegral L_r ↥R_sub := hInt_R
          have hIsField_R : IsField ↥R_sub :=
            isField_of_isIntegral_of_isField' (Field.toIsField L_r)
          let u_R : ↥R_sub := ⟨Φ t, hΦ_mem_R t⟩
          have hu_R_ne : u_R ≠ 0 := fun h0 => hu0 (congrArg Subtype.val h0)
          obtain ⟨v_R, hv_R⟩ := hIsField_R.mul_inv_cancel hu_R_ne
          have hv_val : v_R.1 = (Φ t)⁻¹ := by
            have hmul : Φ t * v_R.1 = 1 := congrArg Subtype.val hv_R
            exact eq_inv_of_mul_eq_one_right hmul
          rw [← hv_val]
          exact hR_le_Φ v_R.2
      have hP_in_Φ : ∀ f : P, algebraMap P Ω f ∈ Set.range Φ := by
        intro f
        refine Polynomial.induction_on' f ?_ ?_
        · rintro f₁ f₂ ⟨s₁, hs₁⟩ ⟨s₂, hs₂⟩
          exact ⟨s₁ + s₂, by rw [map_add, map_add, hs₁, hs₂]⟩
        · intro n c
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
          have hc_mem : algebraMap P Ω (Polynomial.C c) ∈ Set.range Φ :=
            ⟨TensorProduct.tmul ↥F₁ c 1, by change i_k c * ι_r 1 = _; rw [map_one, mul_one]; rfl⟩
          have hX_in : algebraMap P Ω Polynomial.X ∈ Set.range Φ :=
            ⟨TensorProduct.tmul ↥F₁ 1 t₀, by
              change i_k 1 * ι_r t₀ = _; rw [map_one, one_mul, hι_t₀]⟩
          exact Φ.range.mul_mem hc_mem (Φ.range.pow_mem hX_in n)
      have hKk_in_Φ : ∀ q : K_k, algebraMap K_k Ω q ∈ Set.range Φ := by
        intro q
        obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors P) q
        have hs_ne : algebraMap P Ω s.1 ≠ 0 := by
          intro h0
          rw [IsScalarTower.algebraMap_apply P K_k Ω] at h0
          have hs_K : algebraMap P K_k s.1 = 0 :=
            (algebraMap K_k Ω).injective (h0.trans (map_zero _).symm)
          have hs0 : s.1 = 0 :=
            IsFractionRing.injective P K_k (hs_K.trans (map_zero _).symm)
          exact mem_nonZeroDivisors_iff_ne_zero.mp s.2 hs0
        have hq_eq : algebraMap K_k Ω q = algebraMap P Ω a * (algebraMap P Ω s.1)⁻¹ := by
          apply mul_right_cancel₀ hs_ne
          rw [inv_mul_cancel_right₀ hs_ne,
            IsScalarTower.algebraMap_apply P K_k Ω s.1,
            IsScalarTower.algebraMap_apply P K_k Ω a, ← map_mul, hsurj]
        rw [hq_eq]
        exact Φ.range.mul_mem (hP_in_Φ a) (hRange_inv _ (hP_in_Φ s.1))
      let E_Φ : IntermediateField K_k Ω :=
        { Φ.range with
          algebraMap_mem' := hKk_in_Φ
          inv_mem' := fun {u} hu => hRange_inv u hu }
      have hEr_eq_EΦ : E_r = E_Φ := by
        apply le_antisymm
        · rw [IntermediateField.adjoin_le_iff]
          rintro _ ⟨z, rfl⟩
          exact ⟨TensorProduct.tmul ↥F₁ 1 z, by change i_k 1 * ι_r z = ι_r z; simp⟩
        · intro u hu
          rcases hu with ⟨t, rfl⟩
          induction t using TensorProduct.induction_on with
          | zero => rw [map_zero]; exact E_r.zero_mem
          | tmul c z =>
            change i_k c * ι_r z ∈ E_r
            have hc_Er : i_k c ∈ E_r := by
              change algebraMap P Ω (Polynomial.C c) ∈ E_r
              rw [IsScalarTower.algebraMap_apply P K_k Ω]
              exact E_r.algebraMap_mem _
            exact E_r.mul_mem hc_Er (IntermediateField.subset_adjoin K_k (Set.range ι_r) ⟨z, rfl⟩)
          | add s₁ s₂ h₁ h₂ => rw [map_add]; exact E_r.add_mem h₁ h₂
      exact congrArg SetLike.coe hEr_eq_EΦ

    · 
      intro w hw_int m c z hw_sum
      let F' : IntermediateField ↥F₁ k := IntermediateField.adjoin ↥F₁ (Set.range c)
      have hFD_F' : FiniteDimensional ↥F₁ ↥F' :=
        IntermediateField.finiteDimensional_adjoin fun x _ =>
          isAlgebraic_iff_isIntegral.mp (hAlg_F1_k.isAlgebraic x)
      let _ : FiniteDimensional ↥F₁ ↥F' := hFD_F'
      obtain ⟨hSep_F', hΨ_inj⟩ := hFin_inj F'
      let _ : Algebra.IsSeparable ↥F₁ ↥F' := hSep_F'
      let s : ℕ := Module.finrank ↥F₁ ↥F'
      let b₀ : Module.Basis (Fin s) ↥F₁ ↥F' := Module.finBasis ↥F₁ ↥F'
      let u : Fin s → k := fun i => (b₀ i).1
      let T := TensorProduct ↥F₁ L_r ↥F'
      let b_T : Module.Basis (Fin s) L_r T := b₀.baseChange L_r

      let t_w : T := ∑ j : Fin m, TensorProduct.tmul ↥F₁ (z j)
        ⟨c j, IntermediateField.subset_adjoin ↥F₁ (Set.range c) ⟨j, rfl⟩⟩
      have hΨ_pkg : ∃ f_Ψ : T → Ω,
          Function.Injective f_Ψ ∧
          (∀ (r : L_r) (x : ↥F'), f_Ψ (TensorProduct.tmul ↥F₁ r x) = ι_r r * i_k x.1) ∧
          f_Ψ 0 = 0 ∧
          f_Ψ 1 = 1 ∧
          (∀ x y : T, f_Ψ (x + y) = f_Ψ x + f_Ψ y) ∧
          (∀ x y : T, f_Ψ (x * y) = f_Ψ x * f_Ψ y) ∧
          (∀ (r : L_r) (t : T), f_Ψ (r • t) = ι_r r * f_Ψ t) ∧
          f_Ψ t_w = w := by
        let _ : Algebra ↥F₁ Ω := (ι_r.comp F₁.val.toRingHom).toAlgebra
        let f_L : L_r →ₐ[↥F₁] Ω := { ι_r with commutes' := fun _ => rfl }
        let g_F' : ↥F' →ₐ[↥F₁] Ω := { i_k.comp F'.val.toRingHom with commutes' := hφ₁ }
        let Ψ_alg : T →ₐ[↥F₁] Ω :=
          Algebra.TensorProduct.lift f_L g_F' (fun _ _ => Commute.all _ _)
        have hΨ_tmul : ∀ (r : L_r) (x : ↥F'),
            Ψ_alg (TensorProduct.tmul ↥F₁ r x) = ι_r r * i_k x.1 :=
          fun _ _ => rfl
        refine ⟨⇑Ψ_alg, hΨ_inj, hΨ_tmul, map_zero Ψ_alg, ?_, map_add Ψ_alg,
          map_mul Ψ_alg, ?_, ?_⟩
        · change Ψ_alg (TensorProduct.tmul ↥F₁ 1 1) = 1
          rw [hΨ_tmul, map_one, OneMemClass.coe_one, map_one, mul_one]
        · intro r t
          induction t using TensorProduct.induction_on with
          | zero => rw [smul_zero, map_zero, mul_zero]
          | tmul a x =>
            change Ψ_alg (TensorProduct.tmul ↥F₁ (r * a) x) = _
            rw [hΨ_tmul, hΨ_tmul, map_mul, mul_assoc]
          | add t₁ t₂ ih₁ ih₂ => rw [smul_add, map_add, map_add, ih₁, ih₂, mul_add]
        · dsimp [t_w]
          rw [map_sum Ψ_alg, hw_sum]
