        intro k hk
        apply Fin.ext
        have hlt : (iv_lt k hk).castSucc < u_idx j := by change 2 * k.1 + 1 < 2 * j.1; omega
        rw [Fin.succAbove_of_castSucc_lt _ _ hlt]; rfl
      have h_istar : (u_idx j).succAbove i_star = v_idx j := by
        apply Fin.ext
        have hle : u_idx j ≤ i_star.castSucc := by change 2 * j.1 ≤ 2 * j.1; omega
        rw [Fin.succAbove_of_le_castSucc _ _ hle]; rfl
      have h_iu_gt : ∀ (k : Fin (m + 1)) (hk : j.1 < k.1),
