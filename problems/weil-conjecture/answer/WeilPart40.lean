  have hBij_term : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (T : Z.Etale)
      (hT : CategoryTheory.Limits.IsTerminal T)
      (ℰ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
