        have : AlgebraicGeometry.IsAffine W_d := inferInstance
        let ι_d : W_d ⟶ D.left := hAff.fromSpec
        have _ : AlgebraicGeometry.IsOpenImmersion ι_d := hAff.isOpenImmersion_fromSpec
        have hEt_ι : AlgebraicGeometry.Etale ι_d := inferInstance
        let w_d : W_d ⟶ X := ι_d ≫ D.hom
