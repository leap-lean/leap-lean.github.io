      change (M.obj.map ((weilEtaleSitePullback g'').map u₁).op ≫ M.obj.map u₂.op).hom s_comp = _
      rw [← M.obj.map_comp, ← CategoryTheory.op_comp]
    exact hL_step1.trans
      ((congrArg (M.obj.map v''.op).hom hL_step2).trans
        (hL_step3.trans
          ((congrArg (fun m₀ => (M.obj.map m₀.op).hom s_comp) hv).trans
