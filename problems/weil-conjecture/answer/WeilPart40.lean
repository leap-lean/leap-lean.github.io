  have hMvPushout : ∀ (d : ℕ) {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (φ : R₁ →+* R₂),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom (MvPolynomial.C : R₁ →+* MvPolynomial (Fin d) R₁))
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (MvPolynomial.map φ))
        (CommRingCat.ofHom (MvPolynomial.C : R₂ →+* MvPolynomial (Fin d) R₂)) := by
    intro d R₁ R₂ _ _ φ
    have hcomm : CommRingCat.ofHom (MvPolynomial.C : R₁ →+* MvPolynomial (Fin d) R₁) ≫
        CommRingCat.ofHom (MvPolynomial.map φ) =
        CommRingCat.ofHom φ ≫ CommRingCat.ofHom MvPolynomial.C := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply RingHom.ext
      intro r
      exact MvPolynomial.map_C φ r
    refine { w := hcomm, isColimit' := ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
      (fun coc => CommRingCat.ofHom (MvPolynomial.eval₂Hom coc.inr.hom
        (fun i => coc.inl.hom (MvPolynomial.X i))))
      (fun coc => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change MvPolynomial.eval₂Hom coc.inr.hom (fun i => coc.inl.hom (MvPolynomial.X i))
            (MvPolynomial.map φ p) = coc.inl.hom p
        induction p using MvPolynomial.induction_on with
        | C r =>
          have hC := RingHom.congr_fun (congrArg CommRingCat.Hom.hom coc.condition) r
          change coc.inl.hom (MvPolynomial.C r) = coc.inr.hom (φ r) at hC
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact hC.symm
        | add p₁ p₂ ih₁ ih₂ => rw [map_add, map_add, map_add, ih₁, ih₂]
        | mul_X p i ih =>
          rw [map_mul, map_mul, map_mul, ih, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X'])
      (fun coc => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        change MvPolynomial.eval₂Hom coc.inr.hom (fun i => coc.inl.hom (MvPolynomial.X i))
            (MvPolynomial.C r) = coc.inr.hom r
        rw [MvPolynomial.eval₂Hom_C])
      (fun coc l hl1 hl2 => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change l.hom p = MvPolynomial.eval₂Hom coc.inr.hom
            (fun i => coc.inl.hom (MvPolynomial.X i)) p
        induction p using MvPolynomial.induction_on with
        | C r =>
          rw [MvPolynomial.eval₂Hom_C]
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl2) r
        | add p₁ p₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
        | mul_X p i ih =>
          have hX := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hl1) (MvPolynomial.X i)
          change l.hom (MvPolynomial.map φ (MvPolynomial.X i)) =
            coc.inl.hom (MvPolynomial.X i) at hX
          rw [MvPolynomial.map_X] at hX
          rw [map_mul, map_mul, ih, MvPolynomial.eval₂Hom_X', hX])⟩ }

