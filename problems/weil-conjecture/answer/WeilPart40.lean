        (∀ a : Fin (M + 1),
          let O'_a : Z'_M.Opens :=
            (TopologicalSpace.Opens.map ι_Z'.base).obj (weilProjBasicOpen K M a)
          ∃ e'_a : O'_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
