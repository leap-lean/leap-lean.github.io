      change (M.obj.map (e_B'.hom.app U).op ≫ M.obj.map u₁₂.op ≫ M.obj.map v''.op).hom s_comp = _
      rw [← M.obj.map_comp, ← M.obj.map_comp, ← CategoryTheory.op_comp, ← CategoryTheory.op_comp,
