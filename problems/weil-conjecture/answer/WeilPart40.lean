        weilEtaleLocalFreeMap S m u₁ ≫ weilEtaleLocalFreeMap S m u₂) ∧
    ∃ (π : ∀ U : S.Etale, weilEtaleLocalFreeSheaf S m U ⟶ 𝒬_s),
      (∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
        weilEtaleLocalFreeMap S m u ≫ π U₂ = π U₁) ∧
      (∀ (W_st W_op : S.Etale) (v : W_op ⟶ W_st),
        AlgebraicGeometry.IsOpenImmersion
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left →
        Set.range ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left.base =
          { y : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W_st).left |
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W_st).hom.base y ∉
              Set.range i_s.base } →
        CategoryTheory.IsIso
          (CategoryTheory.Limits.pullback.snd
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W_st).hom i_s) →
        ∃ h0 : weilEtaleLocalFreeMap S m v ≫ π W_st = 0,
          (CategoryTheory.ShortComplex.mk
            (weilEtaleLocalFreeMap S m v) (π W_st) h0).ShortExact) :=
by
  intro R
