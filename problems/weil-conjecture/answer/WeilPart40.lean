  have hConj : ∀ f : C₂.obj Aℤ ⟶ C₂.obj A_m,
      (adj₁.homEquiv Aℤ (C₁.obj A_m) (Φ f)) ≫ (C₁.obj A_m).obj.map τ.op =
        (adj₂.homEquiv Aℤ (C₂.obj A_m) f) ≫ η_h.hom.app (Opposite.op T₂) := by
    intro f
    have h_pre : πℤ ≫ Φ f = P_pull.map f ≫ πM :=
      (CategoryTheory.Category.assoc πℤ (ιℤ ≫ P_pull.map f) πM).symm.trans
        (congrArg (· ≫ πM)
          ((CategoryTheory.Category.assoc πℤ ιℤ (P_pull.map f)).symm.trans
            ((congrArg (· ≫ P_pull.map f) hι₂).trans
              (CategoryTheory.Category.id_comp (P_pull.map f)))))
    have h_step := congrArg
      (fun k => adj₂.homEquiv Aℤ (P_push.obj (C₁.obj A_m))
        (adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj A_m) k)) h_pre
    have hRHS : adj₂.homEquiv Aℤ (P_push.obj (C₁.obj A_m))
        (adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj A_m) (P_pull.map f ≫ πM)) =
        (adj₂.homEquiv Aℤ (C₂.obj A_m) f) ≫ η_h.hom.app (Opposite.op T₂) := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
        CategoryTheory.Adjunction.homEquiv_naturality_right]
      rfl
    have hLHS : adj₂.homEquiv Aℤ (P_push.obj (C₁.obj A_m))
        (adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj A_m) (πℤ ≫ Φ f)) =
        (adj₁.homEquiv Aℤ (C₁.obj A_m) (Φ f)) ≫ (C₁.obj A_m).obj.map τ.op := by
      have h1 : adj₂.homEquiv Aℤ (P_push.obj (C₁.obj A_m))
          (adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj A_m) (πℤ ≫ Φ f)) =
          adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))
            (adj_h.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ) πℤ) ≫
            (Φ f).hom.app (Opposite.op (B.obj T₂)) := by
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
