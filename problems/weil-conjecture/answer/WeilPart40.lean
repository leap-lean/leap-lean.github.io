          exact congrArg (⇑L₁ ∘ pbFn) (L₂.apply_symm_apply g).symm
        rw [h2]
        exact hh.comp L₂.symm.bijective
      have h3 : pbFn = ⇑L₁.symm ∘ (⇑L₁ ∘ pbFn) := by
        funext g
        exact (L₁.symm_apply_apply (pbFn g)).symm
      rw [h3]
      exact L₁.symm.bijective.comp h1
  exact hBij_p_Φ.trans (hBij_Φ_η.trans (hBij_η_T₂.trans hBij_pb_h))

theorem weil_odp_val_seq_closed_point_skyscraper_and_const_unit : (∀ (k : Type u) [Field k] [IsAlgClosed k]
        (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
        (X : AlgebraicGeometry.Scheme.{u})
        (_p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
        (i₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X)
        [AlgebraicGeometry.IsClosedImmersion i₀]
        (hCont_i : (weilEtaleSitePullback i₀).IsContinuous
          X.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
        (hAdj_i : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
          X.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
          hCont_i).IsRightAdjoint),
      let pb_i := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
        X.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        hCont_i hAdj_i
      let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let Fℤ_k := (CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      ∃ ev_hom : ∀ S : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u},
          S.H 0 →+ (pb_i.obj S).H 0,
        (∀ (S₁ S₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
            (τ : S₂ ⟶ S₁) (y : S₂.H 0),
          ev_hom S₁
              ((CategoryTheory.Abelian.Ext.mk₀ τ).postcomp Fℤ_X (Nat.add_zero 0) y) =
            (CategoryTheory.Abelian.Ext.mk₀ (pb_i.map τ)).postcomp Fℤ_k (Nat.add_zero 0)
              (ev_hom S₂ y)) ∧
        (∀ (r : ℕ) (S : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id S = 0 →
          (∀ (K : Type u) [Field K] [IsAlgClosed K]
              (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
            Disjoint (Set.range z_bar.base) (Set.range i₀.base) →
            ∃ H_z : CategoryTheory.Sheaf
                (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u},
              WeilIsEtaleSheafPullback z_bar S H_z ∧ CategoryTheory.Limits.IsZero H_z) →
          Function.Bijective (ev_hom S) ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (S.H q))) ∧
    (∀ {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
        (hCont_j : (weilEtaleSitePullback j).IsContinuous
          X.smallEtaleTopology X_U.smallEtaleTopology)
        (hAdj_j : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback j) AddCommGrpCat.{u} _
          X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).IsRightAdjoint)
        (T_U : X_U.Etale) (hT_U : CategoryTheory.Limits.IsTerminal T_U)
        (T_X : X.Etale) (hT_X : CategoryTheory.Limits.IsTerminal T_X)
        (m_mod : ℕ),
      (∀ x : ↥X,
        ∃ (V_x V_U : AlgebraicGeometry.Scheme.{u})
          (e_x : V_x ⟶ X) (_ : AlgebraicGeometry.Etale e_x)
          (j_V : V_U ⟶ V_x) (e_U : V_U ⟶ X_U),
          x ∈ Set.range e_x.base ∧
          CategoryTheory.IsPullback e_U j_V j e_x ∧
          ∀ (W : V_x.Etale)
            (p_W0 : weilEtaleTorsionH
                ((AlgebraicGeometry.Scheme.Etale.forget V_x).obj W).left m_mod 0 →+
              weilEtaleTorsionH
                ((AlgebraicGeometry.Scheme.Etale.forget V_U).obj
                  ((weilEtaleSitePullback j_V).obj W)).left m_mod 0),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget V_x).obj W).hom j_V)
              m_mod 0 p_W0 →
            Function.Bijective p_W0) →
      let adj_j := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback j) AddCommGrpCat.{u} _
        X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
      let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m_mod))
      CategoryTheory.IsIso
        ((adj_j.homEquiv (weilEtaleTorsionSheaf X m_mod) (weilEtaleTorsionSheaf X_U m_mod))
          (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A_m))) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro k _ _ ℓ _ X _p_X i₀ _ hCont_i hAdj_i pb_i Fℤ_X Fℤ_k
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let pf_i := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
      X.smallEtaleTopology S_k.smallEtaleTopology hCont_i
    let adj_i := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
      X.smallEtaleTopology S_k.smallEtaleTopology hCont_i hAdj_i
    have hpb_add : pb_i.Additive := by
      have hpf_add : ∀ {A B : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
          (f g : A ⟶ B), pf_i.map (f + g) = pf_i.map f + pf_i.map g :=
        fun _ _ => CategoryTheory.Sheaf.hom_ext rfl
      refine ⟨fun {A B} {f g} => ?_⟩
      apply (adj_i.homEquiv A (pb_i.obj B)).injective
      have h1 : (adj_i.homEquiv A (pb_i.obj B)) (pb_i.map (f + g)) =
          (f + g) ≫ adj_i.unit.app B := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        exact (adj_i.unit.naturality (f + g)).symm
      have h2 : (adj_i.homEquiv A (pb_i.obj B)) (pb_i.map f + pb_i.map g) =
          f ≫ adj_i.unit.app B + g ≫ adj_i.unit.app B := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, hpf_add,
          CategoryTheory.Preadditive.comp_add]
        exact congrArg₂ (· + ·) (adj_i.unit.naturality f).symm (adj_i.unit.naturality g).symm
      rw [h1, h2, CategoryTheory.Preadditive.add_comp]
    let _ : pb_i.Additive := hpb_add
    have hConstPb := (weil_etale_pullback_exact_and_pseudofunctor.{u} 0).2.2.2.1 i₀ Aℤ
    rcases hConstPb with ⟨hc', hr', ⟨iso'⟩⟩
    have hhc_eq : hc' = hCont_i := Subsingleton.elim _ _
    subst hhc_eq
    let adj_i' := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      (weilEtaleSitePullback i₀) AddCommGrpCat.{u} _
      X.smallEtaleTopology S_k.smallEtaleTopology hc' hr'
    let α_pb := adj_i.leftAdjointUniq adj_i'
    let eℤ : pb_i.obj Fℤ_X ≅ Fℤ_k := α_pb.app Fℤ_X ≪≫ iso'
    let ιℤ : Fℤ_k ⟶ pb_i.obj Fℤ_X := eℤ.inv
    let ev_hom : ∀ S : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u},
        S.H 0 →+ (pb_i.obj S).H 0 := fun S =>
      CategoryTheory.Abelian.Ext.addEquiv₀.symm.toAddMonoidHom.comp
        ({ toFun := fun (f : Fℤ_X ⟶ S) => ιℤ ≫ pb_i.map f
