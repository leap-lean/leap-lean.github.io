    let skySheafOf : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (Θ : CategoryTheory.GrothendieckTopology.Point.{u} Z.smallEtaleTopology),
        CategoryTheory.Functor AddCommGrpCat.{u}
