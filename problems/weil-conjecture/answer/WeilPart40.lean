        fun k hk => ⟨2 * k.1, by omega⟩
      let iv_lt : ∀ (k : Fin (m + 1)), k.1 < j.1 → Fin N :=
        fun k hk => ⟨2 * k.1 + 1, by omega⟩
      let i_star : Fin N := ⟨2 * j.1, by omega⟩
      let iu_gt : ∀ (k : Fin (m + 1)), j.1 < k.1 → Fin N :=
        fun k hk => ⟨2 * k.1 - 1, by omega⟩
      let iv_gt : ∀ (k : Fin (m + 1)), j.1 < k.1 → Fin N :=
        fun k hk => ⟨2 * k.1, by omega⟩
      let iw : Fin N := ⟨2 * m + 1, by omega⟩
      have h_iu_lt : ∀ (k : Fin (m + 1)) (hk : k.1 < j.1),
