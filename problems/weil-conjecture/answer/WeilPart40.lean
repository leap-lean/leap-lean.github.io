      let φ_Z : AlgebraicGeometry.Spec B_Z ⟶ AlgebraicGeometry.Spec A_Z :=
        e_OZ ≫ h_Z_left ≫ e_VZ.hom
      have hφ_Z_et : AlgebraicGeometry.Etale φ_Z := inferInstance
      let f_Z_hom : A_Z ⟶ B_Z := AlgebraicGeometry.Spec.preimage φ_Z
      have hSpec_fZ : AlgebraicGeometry.Spec.map f_Z_hom = φ_Z :=
        AlgebraicGeometry.Spec.map_preimage φ_Z
      have hf_Z_et : f_Z_hom.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
