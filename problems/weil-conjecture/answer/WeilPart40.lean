        · have hmap_fst : Bq₂_left ≫ CategoryTheory.Limits.pullback.fst π_r η_U =
              CategoryTheory.Limits.pullback.fst (q₂_left ≫ π_r) η_U ≫ q₂_left :=
            (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.fst π_r η_U)
              (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_U q₂)).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          rw [CategoryTheory.Category.assoc, hmap_fst, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst]
          dsimp only [q₂_left]
          rw [← CategoryTheory.Category.assoc, hηO_fac,
            CategoryTheory.Limits.pullback.lift_snd]
          exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        · have hmap_snd : Bq₂_left ≫ CategoryTheory.Limits.pullback.snd π_r η_U =
              CategoryTheory.Limits.pullback.snd (q₂_left ≫ π_r) η_U :=
            (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.snd π_r η_U)
              (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ η_U q₂)).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          rw [CategoryTheory.Category.assoc, hmap_snd,
            CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd]
      have hτO_q₂ : τ_O ≫ B_η.map q₂ = σ_ηV :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext h_q₂_left (Subsingleton.elim _ _)

      
      have hSec_eq : (𝒱_r.obj.map (Opposite.op q₁)).hom t =
          (𝒱_r.obj.map (Opposite.op q₂)).hom s := by
        apply (_htriv_r.2.2 E_O).1
        apply LocallyConstant.ext
        obtain ⟨δ_O, hδ_O_props, _, hδ_O_cov, hδ_O_var⟩ := hSheets U_O.toScheme q₂_left
        let E_O_r := CategoryTheory.Limits.pullback (q₂_left ≫ π_r) π_r
        let u_q₁ : E_O_r ⟶ W_r :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (q₂_left ≫ π_r) π_r ≫ q₁_left)
            (CategoryTheory.Limits.pullback.snd (q₂_left ≫ π_r) π_r)
            (by rw [CategoryTheory.Category.assoc, hq_comm,
                  CategoryTheory.Limits.pullback.condition])
        let u_q₂ : E_O_r ⟶ V_r2 :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (q₂_left ≫ π_r) π_r ≫ q₂_left)
            (CategoryTheory.Limits.pullback.snd (q₂_left ≫ π_r) π_r)
            (by rw [CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.condition])
        have hδO1_uq₁ : δ_O 1 ≫ u_q₁ = U_O.ι := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, (hδ_O_props 1).1,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              (hδ_O_props 1).2.1]
            change q₂_left ≫ d_V 1 = U_O.ι ≫ CategoryTheory.Limits.pullback.snd h_W π_r
            rw [hd_V_one, CategoryTheory.Category.comp_id]
        have hδO1_uq₂ : δ_O 1 ≫ u_q₂ = q₂_left ≫ δ_V 1 := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, (hδ_O_props 1).1,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
              hδ_V_fst 1, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              (hδ_O_props 1).2.1]
            change q₂_left ≫ d_V 1 = q₂_left ≫ δ_V 1 ≫
              CategoryTheory.Limits.pullback.snd π_r π_r
            rw [hd_V_one, hδ_V_snd 1, hd_V_one]
        let s₁ : ↑(𝒱_r.obj.obj (Opposite.op E_O)) := (𝒱_r.obj.map (Opposite.op q₁)).hom t
        let s₂ : ↑(𝒱_r.obj.obj (Opposite.op E_O)) := (𝒱_r.obj.map (Opposite.op q₂)).hom s
        have hUnit_eq : ∀ z₀ : ↥U_O.toScheme,
            triv_r E_O s₁ ((δ_O 1).base z₀) = v ∧
            triv_r E_O s₂ ((δ_O 1).base z₀) = v := by
          intro z₀
          refine ⟨?_, ?_⟩
          · have h1a : triv_r E_O s₁ ((δ_O 1).base z₀) =
                triv_r W t (u_q₁.base ((δ_O 1).base z₀)) :=
              _htriv_r.2.1 q₁ u_q₁
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _) t ((δ_O 1).base z₀)
            have hpt1 : u_q₁.base ((δ_O 1).base z₀) = U_O.ι.base z₀ :=
              congrArg (fun k : U_O.toScheme ⟶ W_r => k.base z₀) hδO1_uq₁
            have hz₀_mem : U_O.ι.base z₀ ∈ (U_O : Set ↥W_r) := by
              rw [← AlgebraicGeometry.Scheme.Opens.range_ι U_O]
              exact ⟨z₀, rfl⟩
            have h1b : triv_r W t (U_O.ι.base z₀) = v := Set.mem_singleton_iff.mp hz₀_mem
            exact h1a.trans ((congrArg (triv_r W t) hpt1).trans h1b)
          · have h2a : triv_r E_O s₂ ((δ_O 1).base z₀) =
                triv_r E_V s (u_q₂.base ((δ_O 1).base z₀)) :=
              _htriv_r.2.1 q₂ u_q₂
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _) s ((δ_O 1).base z₀)
            have hpt2 : u_q₂.base ((δ_O 1).base z₀) = (δ_V 1).base (q₂_left.base z₀) :=
              congrArg (fun k : U_O.toScheme ⟶ V_r2 => k.base z₀) hδO1_uq₂
            exact h2a.trans ((congrArg (triv_r E_V s) hpt2).trans
              ((hConst_δV1 s (q₂_left.base z₀) v₀).trans (ev_V.apply_symm_apply v)))
        intro z
        have hz_mem : z ∈ ⋃ σ : B_r ≃ₐ[R₀] B_r, Set.range (δ_O σ).base := by
          rw [hδ_O_cov]
          exact Set.mem_univ z
        obtain ⟨σ, z₀, rfl⟩ := Set.mem_iUnion.mp hz_mem
        have hz_deck : (δ_O σ).base z₀ = (m_can (q₂_left ≫ π_r) σ).base ((δ_O 1).base z₀) := by
          have hmul : δ_O 1 ≫ m_can (q₂_left ≫ π_r) σ = δ_O σ := by
            have hv := hδ_O_var 1 σ (m_can (q₂_left ≫ π_r) σ)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            rwa [mul_one] at hv
          exact (congrArg (fun k => k.base z₀) hmul).symm
        have hm₁_mem : triv_r E_O s₁ ∈ Set.range (triv_r E_O) := ⟨s₁, rfl⟩
        have hm₂_mem : triv_r E_O s₂ ∈ Set.range (triv_r E_O) := ⟨s₂, rfl⟩
        have hm₁ := Eq.mp (congrArg (fun S => triv_r E_O s₁ ∈ S) (_htriv_r.2.2 E_O).2) hm₁_mem
        have hm₂ := Eq.mp (congrArg (fun S => triv_r E_O s₂ ∈ S) (_htriv_r.2.2 E_O).2) hm₂_mem
        have heq₁ : triv_r E_O s₁ ((δ_O σ).base z₀) = ((ρ_r σ).val).mulVec v :=
          (congrArg (triv_r E_O s₁) hz_deck).trans
            ((hm₁ σ (m_can (q₂_left ≫ π_r) σ)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ_O 1).base z₀)).trans
              (congrArg ((ρ_r σ).val).mulVec (hUnit_eq z₀).1))
        have heq₂ : triv_r E_O s₂ ((δ_O σ).base z₀) = ((ρ_r σ).val).mulVec v :=
          (congrArg (triv_r E_O s₂) hz_deck).trans
            ((hm₂ σ (m_can (q₂_left ≫ π_r) σ)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ_O 1).base z₀)).trans
              (congrArg ((ρ_r σ).val).mulVec (hUnit_eq z₀).2))
        exact heq₁.trans heq₂.symm

      refine ⟨s, ?_⟩
      calc germ E_V σ_ηV s
          = germ E_O τ_O ((𝒱_r.obj.map (Opposite.op q₂)).hom s) :=
            (hgerm_nat q₂ τ_O σ_ηV hτO_q₂ s).symm
        _ = germ E_O τ_O ((𝒱_r.obj.map (Opposite.op q₁)).hom t) :=
            congrArg (germ E_O τ_O) hSec_eq.symm
        _ = germ W τ_W t := hgerm_nat q₁ τ_O τ_W hτO_q₁ t
        _ = x := hx

