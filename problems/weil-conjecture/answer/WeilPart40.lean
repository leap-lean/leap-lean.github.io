      exact hLHS_ext.trans hRHS_ext.symm
    change ((e_pf.hom.app R_S'').hom.app (Opposite.op W)).hom
        ((β_Tor₁₂.hom.app (Opposite.op W)).hom (((η_S.app P_X).app (Opposite.op W)).hom x)) =
      (β_Tor₂.hom.app (Opposite.op W')).hom
        ((β_Tor₁.hom.app (Opposite.op W)).hom (((η_S.app P_X).app (Opposite.op W)).hom x))
    exact hLHS_tot.trans ((congrArg (((η_S''.app P_X'').app (Opposite.op W'')).hom) hExtEq).trans
      hRHS_tot.symm)

  
  refine ⟨?_, ?_⟩
  · intro W s
    have hEval := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom s) hStar
    have he_pf_W : (e_pf.hom.app R_S'').hom.app (Opposite.op W) =
