      rw [(hConn_U F).2.1, AddMonoidHom.mem_range] at hmem
      obtain ⟨v, hv⟩ := hmem
      obtain ⟨u, rfl⟩ := (hEdge0 (I_F F)).2 v
      have hNat : edge (Q_F F) 0
          ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map (π_F F))).postcomp Fℤ_X (Nat.add_zero 0) u) =
          edge (Q_F F) 0 (iW_H0 w) :=
        (hEdgeNat (π_F F) 0 u).trans hv
      rw [← hq_i F, ← hPostComp] at hNat
      have heq1 := (hEdge0 (Q_F F)).1 hNat
      have heq2 := hiW_H0_inj heq1
      have hw_ker : w ∈ AddMonoidHom.ker (d10 F) := by
        rw [(hConn_1 F).2.1, AddMonoidHom.mem_range]
        exact ⟨u, heq2⟩
      exact hw_ker
    · ext z
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨x, rfl⟩
        obtain ⟨w, rfl⟩ := (hConn_1 F).1 x
        have h0 := hIntertwine 0 w
        change edge F 1 (d10 F w) = dU0 F (e_Q0 F (iW_H0 w)) at h0
        rw [h0, hν₀_apply, AddEquiv.symm_apply_apply]
        calc δ₀_H0 F (iW_H0 w)
            = (CategoryTheory.Abelian.Ext.mk₀ (i_W F ≫ δ₀ (SC_F F) (hSE_F F))).postcomp
                Fℤ_X (Nat.add_zero 0) w :=
              hPostComp Fℤ_X (i_W F) (δ₀ (SC_F F) (hSE_F F)) 0 w
          _ = (CategoryTheory.Abelian.Ext.mk₀ (0 : W_F F ⟶
                weilEtaleHigherDirectImage j 1 (SC_F F).X₁)).postcomp Fℤ_X (Nat.add_zero 0) w :=
              congrArg (fun f => (CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ_X (Nat.add_zero 0) w)
                (hi_δ F)
          _ = 0 := hPostZero Fℤ_X _ _ 0 w
      · intro hz
        obtain ⟨q, rfl⟩ := (hConn_U F).1 z
        rw [hν₀_apply] at hz
        let t := (e_Q0 F).symm q
        have ht0 : t.comp (CategoryTheory.Abelian.Ext.mk₀ (δ₀ (SC_F F) (hSE_F F)))
            (Nat.add_zero 0) = 0 := hz
        obtain ⟨w, hw⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_X (hSE₂ F) t ht0
        have hw' : iW_H0 w = t := hw
        refine ⟨d10 F w, ?_⟩
        have h0 := hIntertwine 0 w
        change edge F 1 (d10 F w) = dU0 F (e_Q0 F (iW_H0 w)) at h0
        rw [h0, hw', AddEquiv.apply_symm_apply]
    · ext y
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      have hβ_iff : β₀ F y = 0 ↔ d20 F y = 0 := by
        dsimp [β₀]
        exact ⟨fun h => (hConn_1 F).2.2.1 (h.trans (map_zero _).symm),
          fun h => by rw [h, map_zero]⟩
      rw [hβ_iff]
      constructor
      · rintro ⟨z, rfl⟩
        obtain ⟨q, rfl⟩ := (hConn_U F).1 z
        rw [hν₀_apply]
        change (((e_Q0 F).symm q).comp
            (CategoryTheory.Abelian.Ext.mk₀ (δ₀ (SC_F F) (hSE_F F))) (Nat.add_zero 0)).comp
          (hSE₂ F).extClass (rfl : 0 + 1 = 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
          CategoryTheory.ShortComplex.ShortExact.comp_extClass (hSE₂ F),
          CategoryTheory.Abelian.Ext.comp_zero]
      · intro hy
        obtain ⟨t, ht⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_X (hSE₂ F) y (rfl : 0 + 1 = 1) hy
        refine ⟨dU0 F (e_Q0 F t), ?_⟩
        rw [hν₀_apply, AddEquiv.symm_apply_apply]
        exact ht
    · ext x
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨y, rfl⟩
        dsimp [β₀]
        have h1 := hIntertwine 1 (d20 F y)
        change edge F 2 (d11 F (d20 F y)) = dU1 F (edge (Q_F F) 1 (iW_H1 (d20 F y))) at h1
        have hw0 : d20 F y ∈ AddMonoidHom.ker iW_H1 := by
          rw [hiW_H1_ker]
          exact ⟨y, rfl⟩
        have hw0' : iW_H1 (d20 F y) = 0 := hw0
        rw [h1, hw0', map_zero, map_zero]
      · intro hx
        obtain ⟨w, rfl⟩ := (hConn_1 F).2.2.2 x
        have h1 := hIntertwine 1 w
        change edge F 2 (d11 F w) = dU1 F (edge (Q_F F) 1 (iW_H1 w)) at h1
        rw [h1] at hx
        have heq1 : edge (Q_F F) 1 (iW_H1 w) = 0 :=
          (hConn_U F).2.2.1 (hx.trans (map_zero _).symm)
        have heq2 : iW_H1 w = 0 :=
          hBij_edgeQ1.1 (heq1.trans (map_zero _).symm)
        have hw_mem : w ∈ AddMonoidHom.ker iW_H1 := heq2
        rw [hiW_H1_ker, AddMonoidHom.mem_range] at hw_mem
        obtain ⟨y, rfl⟩ := hw_mem
        exact ⟨y, rfl⟩
    · intro z
      obtain ⟨q, rfl⟩ := (hConn_U F).2.2.2 z
      obtain ⟨u, rfl⟩ := hBij_edgeQ1.2 q
      obtain ⟨w, hw⟩ := hiW_H1_surj u
      refine ⟨d11 F w, ?_⟩
      have h1 := hIntertwine 1 w
      change edge F 2 (d11 F w) = dU1 F (edge (Q_F F) 1 (iW_H1 w)) at h1
      rw [h1, hw]

theorem weil_leray_five_term_dimension_shift_step {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
    (hCont_j : (weilEtaleSitePullback j).IsContinuous
      X.smallEtaleTopology X_U.smallEtaleTopology)
    [(@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).Additive]
    (edge : ∀ (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback j) AddCommGrpCat.{u} _
        X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).obj F).H q →+ F.H q)
    (hEdge0 : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
