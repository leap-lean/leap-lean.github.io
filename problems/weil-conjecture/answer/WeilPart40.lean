        ↑((weilProjectiveSpaceOver K (2 * m + 2)).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K (2 * m + 2) a))))
    (hCoord_K : IsCommRingProjCoordSystem K (2 * m + 2) hAff_K c_K t_K)
    (hθ_K : ∀ a : Fin (2 * m + 2 + 1),
      (θ_K a).toRingHom.comp MvPolynomial.C = c_K a ∧
      ∀ i : Fin (2 * m + 2), θ_K a (MvPolynomial.X i) = t_K a (a.succAbove i))
    (hAff_Pm : ∀ a : Fin (m + 1),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K m a))
    (c_Pm : ∀ a : Fin (m + 1),
      K →+* ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K m a))))
    (t_Pm : ∀ a : Fin (m + 1), Fin (m + 1) →
      ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K m a))))
    (θ_Pm : ∀ a : Fin (m + 1),
      MvPolynomial (Fin m) K ≃+*
        ↑((weilProjectiveSpaceOver K m).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K m a))))
    (hCoord_Pm : IsCommRingProjCoordSystem K m hAff_Pm c_Pm t_Pm)
    (hθ_Pm : ∀ a : Fin (m + 1),
      (θ_Pm a).toRingHom.comp MvPolynomial.C = c_Pm a ∧
      ∀ i : Fin m, θ_Pm a (MvPolynomial.X i) = t_Pm a (a.succAbove i))
    (hSubEx_K : ∀ (M : ℕ)
        (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
        (c_M : ∀ a : Fin (M + 1),
          K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))))
        (t_M : ∀ a : Fin (M + 1), Fin (M + 1) →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
      IsCommRingProjCoordSystem K M hAff_M c_M t_M →
      ∀ (L : ℕ) (d_gen : Fin L → ℕ)
        (g_M : ∀ a : Fin (M + 1), Fin L →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
        (∀ (a a' : Fin (M + 1)) (ν : Fin L),
          ((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_right).op).hom (g_M a' ν) *
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (t_M a a')) ^ (d_gen ν) =
          ((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE inf_le_left).op).hom (g_M a ν)) →
        ∃ (Z_M : AlgebraicGeometry.Scheme.{u})
          (ι_Z : Z_M ⟶ (weilProjectiveSpaceOver K M).left),
          AlgebraicGeometry.IsClosedImmersion ι_Z ∧
          ∀ a : Fin (M + 1),
            let O_a : Z_M.Opens :=
              (TopologicalSpace.Opens.map ι_Z.base).obj (weilProjBasicOpen K M a)
            ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
                (↑((weilProjectiveSpaceOver K M).left.presheaf.obj
                  (Opposite.op (weilProjBasicOpen K M a))) ⧸
                  Ideal.span (Set.range (g_M a)))),
              O_a.ι ≫ ι_Z =
                e_a.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫
                  (hAff_M a).fromSpec)
    (hSubIncl_K : ∀ (M : ℕ)
        (hAff_M : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
        (c_M : ∀ a : Fin (M + 1),
          K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))))
        (t_M : ∀ a : Fin (M + 1), Fin (M + 1) →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a)))),
      IsCommRingProjCoordSystem K M hAff_M c_M t_M →
      ∀ (Z_M : AlgebraicGeometry.Scheme.{u})
        (ι_Z : Z_M ⟶ (weilProjectiveSpaceOver K M).left)
        [AlgebraicGeometry.IsClosedImmersion ι_Z]
        (L : ℕ)
        (g_M : ∀ a : Fin (M + 1), Fin L →
          ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M a))))
        (Z'_M : AlgebraicGeometry.Scheme.{u})
        (ι_Z' : Z'_M ⟶ (weilProjectiveSpaceOver K M).left)
        [AlgebraicGeometry.IsClosedImmersion ι_Z']
        (L' : ℕ)
        (g'_M : ∀ a : Fin (M + 1), Fin L' →
