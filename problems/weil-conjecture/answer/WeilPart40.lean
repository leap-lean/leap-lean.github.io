      have hp_A_eq : g_A.left p_A = x := by
        have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A)).base p_bar =
            (φ_Z ≫ AlgebraicGeometry.Spec.map π_A).base p_bar := by
          rw [hPB_top.w]
        have h2 : (φ_Z ≫ AlgebraicGeometry.Spec.map π_A).base p_bar = x_A := by
          have hφ_comp : φ_Z ≫ AlgebraicGeometry.Spec.map π_A = e_OZ ≫ h_Z_left ≫ p₁ := by
            rw [← he_VZ_p₁]
            dsimp [φ_Z]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          rw [hφ_comp]
