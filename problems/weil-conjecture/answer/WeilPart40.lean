      refine ⟨i₄, (θ₀₁ ≫ τ₁) ≫ θ₃₄, ?_⟩
      rw [C.map_comp, C.map_comp, ← hb₁, ← hmap_δ, ← hmap_δ, hb₄, hcomp_A_lvl]

