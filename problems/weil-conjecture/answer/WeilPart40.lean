      _ = 0 := map_zero pre_x
  have hExt_rem : ∀ (X Y : 𝒞) (n_deg n : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y n_deg),
      n • x = (n % M) • x := by
    intro X Y n_deg n x
    conv_lhs => rw [← Nat.div_add_mod n M]
    rw [add_nsmul, mul_comm M (n / M), mul_smul, hExt_tors X Y n_deg x, smul_zero, zero_add]
  have hval_cast : ∀ c : ZMod M, (c.val : ZMod M) = c := ZMod.natCast_zmod_val
  obtain ⟨hDeg0, hVan, ⟨E_top, hE_nat⟩⟩ := hDualExt
  obtain ⟨𝒯, η, _, _, _, hMonoη, _, _, hAcyc, _⟩ := hGod
  let id_ext0 : CategoryTheory.Abelian.Ext.{u} one_Z one_Z 0 :=
    CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id one_Z)
  have he₀_bij : Function.Bijective (fun c : ZMod M => c.val • id_ext0) := by
    have hEq : (fun c : ZMod M => c.val • id_ext0) =
        (⇑CategoryTheory.Abelian.Ext.addEquiv₀.symm) ∘
          (fun c : ZMod M => c.val • CategoryTheory.CategoryStruct.id one_Z) := by
      ext c
      simp only [Function.comp_apply, map_nsmul]
      rfl
    rw [hEq]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective.comp hEnd
  let e₀_hom : ZMod M →+ CategoryTheory.Abelian.Ext.{u} one_Z one_Z 0 :=
    { toFun := fun c => c.val • id_ext0
      map_zero' := by rw [ZMod.val_zero, zero_nsmul]
      map_add' := fun c₁ c₂ => by
        rw [ZMod.val_add, ← hExt_rem one_Z one_Z 0, add_nsmul] }
  let e₀ : ZMod M ≃+ CategoryTheory.Abelian.Ext.{u} one_Z one_Z 0 :=
    AddEquiv.ofBijective e₀_hom he₀_bij
  have hcomp_e₀ : ∀ {X : 𝒞} {n_deg : ℕ}
      (α : CategoryTheory.Abelian.Ext.{u} X one_Z n_deg) (c : ZMod M),
      α.comp (e₀ c) (Nat.add_zero n_deg) = c.val • α := by
    intro X n_deg α c
    let pre_α : CategoryTheory.Abelian.Ext.{u} one_Z one_Z 0 →+
        CategoryTheory.Abelian.Ext.{u} X one_Z n_deg :=
      AddMonoidHom.mk' (fun u => α.comp u (Nat.add_zero n_deg))
        (fun u₁ u₂ => CategoryTheory.Abelian.Ext.comp_add α u₁ u₂ (Nat.add_zero n_deg))
    change pre_α (c.val • id_ext0) = c.val • α
    rw [map_nsmul]
    change c.val • (α.comp id_ext0 (Nat.add_zero n_deg)) = c.val • α
    rw [CategoryTheory.Abelian.Ext.comp_mk₀_id]
  have he₀_comp : ∀ {Y : 𝒞} {n_deg : ℕ}
      (c : ZMod M) (α : CategoryTheory.Abelian.Ext.{u} one_Z Y n_deg),
      (e₀ c).comp α (Nat.zero_add n_deg) = c.val • α := by
    intro Y n_deg c α
    change (α.postcomp one_Z (Nat.zero_add n_deg)) (c.val • id_ext0) = c.val • α
    rw [map_nsmul]
    change c.val • (id_ext0.comp α (Nat.zero_add n_deg)) = c.val • α
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp]
  have hτ_bij : Function.Bijective τ := by
    apply hTrCrit (weilEtaleModuleH S M (2 * d)) (hExt_tors one_Z one_Z (2 * d)) τ
    intro φ
    obtain ⟨f₀, hf₀, hf₀_uniq⟩ := hDeg0 one_Z φ
    refine ⟨e₀.symm f₀, ?_, ?_⟩
    · intro α
      have h1 := hf₀ α
      have hf₀_eq : f₀ = e₀ (e₀.symm f₀) := (e₀.apply_symm_apply f₀).symm
      rw [hf₀_eq, hcomp_e₀, map_nsmul, nsmul_eq_mul, hval_cast] at h1
      exact h1.symm
    · intro c hc
      have hc' : ∀ α : weilEtaleModuleH S M (2 * d),
          τ (α.comp (e₀ c) (Nat.add_zero (2 * d))) = φ α := by
        intro α
        rw [hcomp_e₀, map_nsmul, nsmul_eq_mul, hval_cast, hc α]
      have heq : e₀ c = f₀ := hf₀_uniq (e₀ c) hc'
      rw [← heq, e₀.symm_apply_apply]
  let Φ : ∀ (G : 𝒞) (p q : ℕ) (_ : p + q = 2 * d),
      CategoryTheory.Abelian.Ext.{u} G one_Z q →+
        (CategoryTheory.Abelian.Ext.{u} one_Z G p →+ ZMod M) :=
    fun G p q hpq =>
      AddMonoidHom.mk'
        (fun β => AddMonoidHom.mk'
          (fun α => τ (α.comp β hpq))
          (fun α₁ α₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add]))
        (fun β₁ β₂ => by
          ext α
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply,
            CategoryTheory.Abelian.Ext.comp_add, map_add])
  let ψ₁ : CategoryTheory.Abelian.Ext.{u} one_Z one_Z 0 →+ ZMod M := e₀.symm.toAddMonoidHom
  let u₀ : ZMod M := τ (E_top one_Z ψ₁)
  have hΦ_top_eval : ∀ (G : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} one_Z G 0 →+ ZMod M)
      (α : CategoryTheory.Abelian.Ext.{u} one_Z G 0),
      Φ G 0 (2 * d) (Nat.zero_add (2 * d)) (E_top G φ) α = φ α * u₀ := by
    intro G φ α
    have hpull : φ.comp (α.postcomp one_Z (Nat.add_zero 0)) = (φ α).val • ψ₁ := by
