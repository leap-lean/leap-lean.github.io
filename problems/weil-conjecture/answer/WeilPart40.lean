        ((pb_g'.obj A₀).obj.map u₁.op).hom s_pull₁ :=
      Equiv.apply_symm_apply _ _
    have hρ₂ : weilPolyP1CohomologyRepHomEquiv X'' U'' (pb_g''.obj A'₀) ρ₂ =
        ((pb_g''.obj A'₀).obj.map u₂.op).hom s_pull₂ :=
      Equiv.apply_symm_apply _ _
    have hρ₁₂ : weilPolyP1CohomologyRepHomEquiv X'' U''₁₂ (pb_g'₁₂.obj A₀) ρ₁₂ =
        ((pb_g'₁₂.obj A₀).obj.map u₁₂.op).hom s_pull₁₂ :=
      Equiv.apply_symm_apply _ _
    have hL_step1 : weilPolyP1CohomologyRepHomEquiv X'' U'' M
          ((R_fun X'').map v'' ≫ ρ₁₂ ≫ e_pb'.hom.app A₀) =
        (M.obj.map v''.op).hom
          (((e_pb'.hom.app A₀).hom.app (Opposite.op U''₁₂)).hom
            (((pb_g'₁₂.obj A₀).obj.map u₁₂.op).hom s_pull₁₂)) :=
      (hRepLeft X'' v'' (ρ₁₂ ≫ e_pb'.hom.app A₀)).trans
