        intro r_deg hr_ne
        have hr_pos : 1 ≤ r_deg := by omega
        exact weil_etale_dim_zero_algClosed_cohomology_subsingleton K Z₀ hDimSpecK
          (weilEtaleLocalTorsionSheaf Z₀.left ℓ (U_aff_et 0)) r_deg hr_pos
      let A_M := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      let T_Z0 : Z₀.left.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 Z₀.left)
      obtain ⟨hT_Z0, θ_Z0, hθ_bij, _, _⟩ :=
        weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.2.2 Z₀.left A_M
      let e_emp := MvPolynomial.isEmptyAlgEquiv K (Fin 0)
      let e_ring0 : CommRingCat.of K ≅ CommRingCat.of (MvPolynomial (Fin 0) K) :=
        { hom := CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 0) K)
          inv := CommRingCat.ofHom e_emp.toRingHom
          hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun c => e_emp.commutes c)
          inv_hom_id := CommRingCat.hom_ext (MvPolynomial.ringHom_ext
            (fun c => congrArg MvPolynomial.C (e_emp.commutes c))
            (fun i => Fin.elim0 i)) }
      let e_spec0 : (weilAffineSpaceOver K 0).left ≅ Z₀.left :=
        AlgebraicGeometry.Scheme.Spec.mapIso e_ring0.op
      let e_U0 : U_aff_et 0 ≅ T_Z0 :=
        CategoryTheory.MorphismProperty.Over.isoMk e_spec0
          ((CategoryTheory.Category.comp_id (weilAffineSpaceOver K 0).hom).trans hι_aff0.symm)
      let J₀ := Z₀.left.smallEtaleTopology
      let X₁ := weilEtaleLocalTorsionSheaf Z₀.left ℓ (U_aff_et 0)
      let X₂ := weilEtaleTorsionSheaf Z₀.left ℓ
      let e₁ : ∀ F : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u},
          (X₁ ⟶ F) ≃ (A_M ⟶ F.obj.obj (Opposite.op (U_aff_et 0))) :=
        fun _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
      let adj_c0 := CategoryTheory.constantSheafAdj J₀ AddCommGrpCat.{u} hT_Z0
      let e₂ : ∀ F : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u},
          (X₂ ⟶ F) ≃ (A_M ⟶ F.obj.obj (Opposite.op T_Z0)) :=
        fun F => adj_c0.homEquiv A_M F
      have he₁_nat : ∀ {F G : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}}
          (α : X₁ ⟶ F) (g : F ⟶ G),
          e₁ G (α ≫ g) = e₁ F α ≫ g.hom.app (Opposite.op (U_aff_et 0)) :=
        fun α g =>
          (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
            ((CategoryTheory.sheafificationAdjunction J₀
              AddCommGrpCat.{u}).homEquiv_naturality_right α g)).trans
            (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ g.hom)
      have he₂_nat : ∀ {F G : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}}
          (β : X₂ ⟶ F) (g : F ⟶ G),
          e₂ G (β ≫ g) = e₂ F β ≫ g.hom.app (Opposite.op T_Z0) :=
        fun β g => adj_c0.homEquiv_naturality_right β g
      let e_sh0 : X₁ ≅ X₂ :=
        CategoryTheory.Coyoneda.ext X₁ X₂
          (fun {F} α => (e₂ F).symm (e₁ F α ≫ F.obj.map e_U0.inv.op))
          (fun {F} β => (e₁ F).symm (e₂ F β ≫ F.obj.map e_U0.hom.op))
          (fun {F} α => by
            rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, ← F.obj.map_comp,
              ← CategoryTheory.op_comp, e_U0.hom_inv_id, CategoryTheory.op_id,
              F.obj.map_id, CategoryTheory.Category.comp_id, Equiv.symm_apply_apply])
          (fun {F} β => by
            rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, ← F.obj.map_comp,
              ← CategoryTheory.op_comp, e_U0.inv_hom_id, CategoryTheory.op_id,
              F.obj.map_id, CategoryTheory.Category.comp_id, Equiv.symm_apply_apply])
