    subst hhc_i'
    let pb_z := @CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback z_bar) AddCommGrpCat.{u} _
      X.smallEtaleTopology S_K.smallEtaleTopology hc_z hra_z
    let pf_f' := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
