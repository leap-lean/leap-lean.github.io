  have hAlg_tr :
      letI : Algebra k K_s := (ι_RK.comp p_k).toAlgebra
      letI : Algebra K_s Ω := ι_KΩ.toAlgebra
      Algebra.trdeg k K_s ≤ 1 ∧ Algebra.IsAlgebraic K_s Ω := by
