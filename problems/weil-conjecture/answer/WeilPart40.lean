        _ = AlgebraicGeometry.Spec.map (α ≫ γ ≫ β) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        _ = g_aff := by
              rw [hβ_eq, AlgebraicGeometry.Spec.map_preimage]
