by
  let pf_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    (weilEtaleSitePullback j) AddCommGrpCat.{u} _
    X.smallEtaleTopology X_U.smallEtaleTopology hCont_j
  let cZ := fun (S : AlgebraicGeometry.Scheme.{u}) =>
    (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
  let Fℤ_X := cZ X
  let Fℤ_U := cZ X_U
  obtain ⟨ν_n, β_n, h_ih⟩ := ih

  have hPostcompComp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        {G₁ G₂ G₃ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : G₁ ⟶ G₂) (β : G₂ ⟶ G₃) (q : ℕ) (z : G₁.H q),
        (CategoryTheory.Abelian.Ext.mk₀ β).postcomp (cZ S) (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ α).postcomp (cZ S) (Nat.add_zero q) z) =
        (CategoryTheory.Abelian.Ext.mk₀ (α ≫ β)).postcomp (cZ S) (Nat.add_zero q) z := by
    intro S G₁ G₂ G₃ α β q z
    change (z.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β) (Nat.add_zero q) =
      z.comp (CategoryTheory.Abelian.Ext.mk₀ (α ≫ β)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc z
        (CategoryTheory.Abelian.Ext.mk₀ α) (CategoryTheory.Abelian.Ext.mk₀ β)
        (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  have hPostcompId :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ) (z : G.H q),
        (CategoryTheory.Abelian.Ext.mk₀ (𝟙 G)).postcomp (cZ S) (Nat.add_zero q) z = z :=
    fun _ _ z => CategoryTheory.Abelian.Ext.comp_mk₀_id z

  let isoH :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (e : G₁ ≅ G₂) (q : ℕ), G₁.H q ≃+ G₂.H q :=
    fun e q =>
      { toFun := (CategoryTheory.Abelian.Ext.mk₀ e.hom).postcomp (cZ _) (Nat.add_zero q)
        invFun := (CategoryTheory.Abelian.Ext.mk₀ e.inv).postcomp (cZ _) (Nat.add_zero q)
        left_inv := fun z => by
          rw [hPostcompComp, e.hom_inv_id, hPostcompId]
        right_inv := fun w => by
          rw [hPostcompComp, e.inv_hom_id, hPostcompId]
        map_add' := map_add _ }

  have hConjSymm :
      ∀ {A₁ A₂ A'₁ A'₂ : Type u}
        [AddCommGroup A₁] [AddCommGroup A₂] [AddCommGroup A'₁] [AddCommGroup A'₂]
        (e₁ : A₁ ≃+ A'₁) (e₂ : A₂ ≃+ A'₂) (f : A₁ →+ A₂) (f' : A'₁ →+ A'₂),
        (∀ x : A₁, f' (e₁ x) = e₂ (f x)) →
        (f' : A'₁ → A'₂) = e₂ ∘ f ∘ e₁.symm := by
    intro A₁ A₂ A'₁ A'₂ _ _ _ _ e₁ e₂ f f' hf_comm
    funext x'
    change f' x' = e₂ (f (e₁.symm x'))
    rw [← hf_comm (e₁.symm x'), e₁.apply_symm_apply]

  have hConjInj :
      ∀ {A₁ A₂ A'₁ A'₂ : Type u}
        [AddCommGroup A₁] [AddCommGroup A₂] [AddCommGroup A'₁] [AddCommGroup A'₂]
        (e₁ : A₁ ≃+ A'₁) (e₂ : A₂ ≃+ A'₂) (f : A₁ →+ A₂) (f' : A'₁ →+ A'₂),
        (∀ x : A₁, f' (e₁ x) = e₂ (f x)) →
        Function.Injective f → Function.Injective f' := by
    intro A₁ A₂ A'₁ A'₂ _ _ _ _ e₁ e₂ f f' hf_comm hf
    rw [hConjSymm e₁ e₂ f f' hf_comm]
    exact e₂.injective.comp (hf.comp e₁.symm.injective)

  have hConjSurj :
      ∀ {A₁ A₂ A'₁ A'₂ : Type u}
        [AddCommGroup A₁] [AddCommGroup A₂] [AddCommGroup A'₁] [AddCommGroup A'₂]
        (e₁ : A₁ ≃+ A'₁) (e₂ : A₂ ≃+ A'₂) (f : A₁ →+ A₂) (f' : A'₁ →+ A'₂),
        (∀ x : A₁, f' (e₁ x) = e₂ (f x)) →
        Function.Surjective f → Function.Surjective f' := by
    intro A₁ A₂ A'₁ A'₂ _ _ _ _ e₁ e₂ f f' hf_comm hf
    rw [hConjSymm e₁ e₂ f f' hf_comm]
    exact e₂.surjective.comp (hf.comp e₁.symm.surjective)

  have hConjBij :
      ∀ {A₁ A₂ A'₁ A'₂ : Type u}
        [AddCommGroup A₁] [AddCommGroup A₂] [AddCommGroup A'₁] [AddCommGroup A'₂]
        (e₁ : A₁ ≃+ A'₁) (e₂ : A₂ ≃+ A'₂) (f : A₁ →+ A₂) (f' : A'₁ →+ A'₂),
        (∀ x : A₁, f' (e₁ x) = e₂ (f x)) →
        Function.Bijective f → Function.Bijective f' := by
    intro A₁ A₂ A'₁ A'₂ _ _ _ _ e₁ e₂ f f' hf_comm hf
    rw [hConjSymm e₁ e₂ f f' hf_comm]
    exact e₂.bijective.comp (hf.comp e₁.symm.bijective)

  have hConjExact :
      ∀ {A₁ A₂ A₃ A'₁ A'₂ A'₃ : Type u}
        [AddCommGroup A₁] [AddCommGroup A₂] [AddCommGroup A₃]
        [AddCommGroup A'₁] [AddCommGroup A'₂] [AddCommGroup A'₃]
        (e₁ : A₁ ≃+ A'₁) (e₂ : A₂ ≃+ A'₂) (e₃ : A₃ ≃+ A'₃)
        (f : A₁ →+ A₂) (g : A₂ →+ A₃)
        (f' : A'₁ →+ A'₂) (g' : A'₂ →+ A'₃),
        (∀ x : A₁, f' (e₁ x) = e₂ (f x)) →
        (∀ y : A₂, g' (e₂ y) = e₃ (g y)) →
        AddMonoidHom.range f = AddMonoidHom.ker g →
        AddMonoidHom.range f' = AddMonoidHom.ker g' := by
    intro A₁ A₂ A₃ A'₁ A'₂ A'₃ _ _ _ _ _ _ e₁ e₂ e₃ f g f' g' hf_comm hg_comm hex
    ext y'
    have h_rng : y' ∈ AddMonoidHom.range f' ↔ e₂.symm y' ∈ AddMonoidHom.range f := by
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_range]
      constructor
      · rintro ⟨x', rfl⟩
        refine ⟨e₁.symm x', ?_⟩
        apply e₂.injective
        rw [← hf_comm (e₁.symm x'), e₁.apply_symm_apply, e₂.apply_symm_apply]
      · rintro ⟨x, hx⟩
        refine ⟨e₁ x, ?_⟩
        rw [hf_comm x, hx, e₂.apply_symm_apply]
    have h_ker : y' ∈ AddMonoidHom.ker g' ↔ e₂.symm y' ∈ AddMonoidHom.ker g := by
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker]
      have hy' : g' y' = e₃ (g (e₂.symm y')) := by
        rw [← hg_comm (e₂.symm y'), e₂.apply_symm_apply]
      rw [hy']
      exact ⟨fun h => e₃.injective (h.trans (map_zero e₃).symm),
        fun h => by rw [h, map_zero]⟩
    rw [h_rng, h_ker, hex]

  have hConnZero :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂],
        Function.Surjective (hSE.extClass.postcomp (cZ S) (rfl : 0 + 1 = 1)) ∧
        ∀ x₃ : SC.X₃.H 0,
          (hSE.extClass.postcomp (cZ S) (rfl : 0 + 1 = 1)) x₃ = 0 ↔
            ∃ x₂ : SC.X₂.H 0,
              (CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (cZ S) (Nat.add_zero 0) x₂ = x₃ := by
    intro S SC hSE _
    refine ⟨?_, ?_⟩
    · intro x₁
      have hx₂ : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (cZ S) hSE x₁ hx₂ (rfl : 0 + 1 = 1)
    · intro x₃
      constructor
      · intro hx₃
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (cZ S) hSE x₃
          (rfl : 0 + 1 = 1) hx₃
      · rintro ⟨x₂, rfl⟩
        change (x₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero 0)).comp
            hSE.extClass (rfl : 0 + 1 = 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc x₂
            (CategoryTheory.Abelian.Ext.mk₀ SC.g) hSE.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (rfl : 0 + 1 = 1),
          hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

  have hConnSuccBij :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂] (m : ℕ),
        Function.Bijective (hSE.extClass.postcomp (cZ S) (rfl : (m + 1) + 1 = m + 2)) := by
    intro S SC hSE _ m
    refine ⟨?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro x₃ hx₃
      obtain ⟨x₂, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (cZ S) hSE x₃
        (rfl : (m + 1) + 1 = m + 2) hx₃
      have hx₂ : x₂ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective x₂
      change x₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero (m + 1)) = 0
      rw [hx₂, CategoryTheory.Abelian.Ext.zero_comp]
    · intro x₁
      have hx₂ : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (m + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (cZ S) hSE x₁ hx₂
        (rfl : (m + 1) + 1 = m + 2)

  let I_F := fun (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) =>
    CategoryTheory.Injective.under F
  let ι_F := fun (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) =>
    CategoryTheory.Injective.ι F
  let Q_F := fun (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) =>
    CategoryTheory.Limits.cokernel (ι_F F)
  let π_F := fun (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) =>
    CategoryTheory.Limits.cokernel.π (ι_F F)
  let SC_F := fun (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}) =>
    CategoryTheory.ShortComplex.mk (ι_F F) (π_F F) (CategoryTheory.Limits.cokernel.condition (ι_F F))
  have hSE_F : ∀ F, (SC_F F).ShortExact := fun F =>
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_cokernel (ι_F F))
      (inferInstance : CategoryTheory.Mono (ι_F F))
      (inferInstance : CategoryTheory.Epi (π_F F))

  let d_U : ∀ F (k : ℕ), (Q_F F).H k →+ F.H (k + 1) :=
    fun F k => (hSE_F F).extClass.postcomp Fℤ_U (rfl : k + 1 = k + 1)
  let e_U : ∀ F (m : ℕ), (Q_F F).H (m + 1) ≃+ F.H (m + 2) :=
    fun F m => AddEquiv.ofBijective (d_U F (m + 1))
      (@hConnSuccBij X_U (SC_F F) (hSE_F F) inferInstance m)

  have hΔ_isIso : ∀ F (q : ℕ), 1 ≤ q → CategoryTheory.IsIso (Δ (SC_F F) (hSE_F F) q) :=
    fun F q hq => hΔ_iso (SC_F F) (hSE_F F) q hq
      ((hInjAdj (I_F F)).2 q hq)
      ((hInjAdj (I_F F)).2 (q + 1) (Nat.le_add_left 1 q))
  let isoΔ : ∀ F (q : ℕ), 1 ≤ q →
      (weilEtaleHigherDirectImage j q (Q_F F) ≅ weilEtaleHigherDirectImage j (q + 1) F) :=
    fun F q hq => @CategoryTheory.asIso _ _ _ _ (Δ (SC_F F) (hSE_F F) q) (hΔ_isIso F q hq)
  let e_Δ : ∀ F,
      (weilEtaleHigherDirectImage j (n + 1) (Q_F F)).H 0 ≃+
        (weilEtaleHigherDirectImage j (n + 1 + 1) F).H 0 :=
    fun F => isoH (isoΔ F (n + 1) (Nat.le_add_left 1 n)) 0

  let SC_X := fun F => (SC_F F).map pf_j
  have hSE_X : ∀ F,
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F) → (SC_X F).ShortExact :=
    fun F h₁ => hMapSE (SC_F F) (hSE_F F) h₁
  let d_X : ∀ F, CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F) →
      ∀ k : ℕ, (pf_j.obj (Q_F F)).H k →+ (pf_j.obj F).H (k + 1) :=
    fun F h₁ k => (hSE_X F h₁).extClass.postcomp Fℤ_X (rfl : k + 1 = k + 1)
  let e_X : ∀ F (h₁ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F)) (m : ℕ),
      (pf_j.obj (Q_F F)).H (m + 1) ≃+ (pf_j.obj F).H (m + 2) :=
    fun F h₁ m =>
      AddEquiv.ofBijective (d_X F h₁ (m + 1))
        (@hConnSuccBij X (SC_X F) (hSE_X F h₁) (hInjAdj (I_F F)).1 m)

  let ν_succ : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
      F.H (n + 1 + 1) →+ (weilEtaleHigherDirectImage j (n + 1 + 1) F).H 0 :=
    fun F => (e_Δ F).toAddMonoidHom.comp ((ν_n (Q_F F)).comp (e_U F n).symm.toAddMonoidHom)
  classical
  let β_succ : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
      (weilEtaleHigherDirectImage j (n + 1 + 1) F).H 0 →+ (pf_j.obj F).H (n + 1 + 2) :=
    fun F =>
      if h₁ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F) then
        (e_X F h₁ (n + 1)).toAddMonoidHom.comp ((β_n (Q_F F)).comp (e_Δ F).symm.toAddMonoidHom)
      else 0

  have hEdgeIntertwine :
      ∀ F (h₁ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F))
        (k : ℕ) (w : (pf_j.obj (Q_F F)).H k),
        edge F (k + 1) (d_X F h₁ k w) = d_U F k (edge (Q_F F) k w) := by
    intro F h₁ k w
    have hconn := hEdgeConn (SC_X F) (hSE_X F h₁) (SC_F F) (hSE_F F)
      (𝟙 (pf_j.obj F)) (𝟙 (pf_j.obj (I_F F))) (𝟙 (pf_j.obj (Q_F F)))
      (by dsimp [SC_X, SC_F]; rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      (by dsimp [SC_X, SC_F]; rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      k w
    change edge F (k + 1)
        ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 (pf_j.obj F))).postcomp (cZ X) (Nat.add_zero (k + 1))
          (d_X F h₁ k w)) =
      d_U F k
        (edge (Q_F F) k
          ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 (pf_j.obj (Q_F F)))).postcomp (cZ X) (Nat.add_zero k) w)) at hconn
    rwa [hPostcompId, hPostcompId] at hconn

  have hEdge1Bij :
      ∀ F (h₁ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F)),
        Function.Bijective (edge F 1) := by
    intro F h₁
    obtain ⟨hSurjX0, hKerX0⟩ := @hConnZero X (SC_X F) (hSE_X F h₁) (hInjAdj (I_F F)).1
    obtain ⟨hSurjU0, hKerU0⟩ := @hConnZero X_U (SC_F F) (hSE_F F) inferInstance
    refine ⟨?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨w, rfl⟩ := hSurjX0 x
      change edge F 1 (d_X F h₁ 0 w) = 0 at hx
      rw [hEdgeIntertwine F h₁ 0 w] at hx
      obtain ⟨u, hu⟩ := (hKerU0 (edge (Q_F F) 0 w)).mp hx
      obtain ⟨v, rfl⟩ := (hEdge0 (I_F F)).2 u
      have hnat := hEdgeNat (π_F F) 0 v
      rw [hu] at hnat
      have hvw : (CategoryTheory.Abelian.Ext.mk₀ (pf_j.map (π_F F))).postcomp (cZ X)
          (Nat.add_zero 0) v = w := (hEdge0 (Q_F F)).1 hnat
      exact (hKerX0 w).mpr ⟨v, hvw⟩
    · intro y
      obtain ⟨z, rfl⟩ := hSurjU0 y
      obtain ⟨w, rfl⟩ := (hEdge0 (Q_F F)).2 z
      exact ⟨d_X F h₁ 0 w, hEdgeIntertwine F h₁ 0 w⟩

  have hShiftHyp :
      ∀ G : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
        (∀ b : ℕ, 1 ≤ b → b ≤ n + 1 →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b G)) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 1 + 2) G) →
        Subsingleton ((weilEtaleHigherDirectImage j (n + 1 + 1) G).H 1) →
        (∀ b : ℕ, 1 ≤ b → b ≤ n →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b (Q_F G))) ∧
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 2) (Q_F G)) ∧
        Subsingleton ((weilEtaleHigherDirectImage j (n + 1) (Q_F G)).H 1) := by
    intro G hLow hTop hSub
    refine ⟨?_, ?_, ?_⟩
    · intro b hb1 hbn
      exact (hLow (b + 1) (by omega) (by omega)).of_iso (isoΔ G b hb1)
    · exact hTop.of_iso (isoΔ G (n + 2) (by omega))
    · exact @Equiv.subsingleton _ _ (isoH (isoΔ G (n + 1) (Nat.le_add_left 1 n)) 1).toEquiv hSub

  refine ⟨ν_succ, β_succ, fun F hLow hTop hSub => ?_⟩
  have h₁ : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F) :=
    hLow 1 le_rfl (Nat.le_add_left 1 n)
  obtain ⟨hLowQ, hTopQ, hSubQ⟩ := hShiftHyp F hLow hTop hSub
  obtain ⟨hIH_low, ⟨hIH_inj, hIH_ex1, hIH_ex2, hIH_ex3, hIH_surj⟩, hIH_nat⟩ :=
    h_ih (Q_F F) hLowQ hTopQ hSubQ

  have hβ_F : β_succ F =
      (e_X F h₁ (n + 1)).toAddMonoidHom.comp ((β_n (Q_F F)).comp (e_Δ F).symm.toAddMonoidHom) := by
    dsimp only [β_succ]
    simp only [h₁, ↓reduceDIte]

  refine ⟨?_, ?_, ?_⟩
  · intro q hq
    rcases q with _ | _ | m
    · exact hEdge0 F
    · exact hEdge1Bij F h₁
    · have hm : m + 1 ≤ n := by omega
      exact hConjBij (e_X F h₁ m) (e_U F m) (edge (Q_F F) (m + 1)) (edge F (m + 2))
        (fun w => hEdgeIntertwine F h₁ (m + 1) w)
        (hIH_low (m + 1) hm)
  · have hComm1 : ∀ w : (pf_j.obj (Q_F F)).H (n + 1),
        edge F (n + 1 + 1) (e_X F h₁ n w) = e_U F n (edge (Q_F F) (n + 1) w) :=
      fun w => hEdgeIntertwine F h₁ (n + 1) w
    have hComm2 : ∀ z : (Q_F F).H (n + 1),
        ν_succ F (e_U F n z) = e_Δ F (ν_n (Q_F F) z) := by
      intro z
      dsimp only [ν_succ, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [(e_U F n).symm_apply_apply]
    have hComm3 : ∀ s : (weilEtaleHigherDirectImage j (n + 1) (Q_F F)).H 0,
        β_succ F (e_Δ F s) = e_X F h₁ (n + 1) (β_n (Q_F F) s) := by
      intro s
      rw [hβ_F]
      dsimp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [(e_Δ F).symm_apply_apply]
    have hComm4 : ∀ w : (pf_j.obj (Q_F F)).H (n + 2),
        edge F (n + 1 + 2) (e_X F h₁ (n + 1) w) = e_U F (n + 1) (edge (Q_F F) (n + 2) w) :=
      fun w => hEdgeIntertwine F h₁ (n + 2) w
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · exact hConjInj (e_X F h₁ n) (e_U F n)
        (edge (Q_F F) (n + 1)) (edge F (n + 1 + 1)) hComm1 hIH_inj
    · exact hConjExact (e_X F h₁ n) (e_U F n) (e_Δ F)
        (edge (Q_F F) (n + 1)) (ν_n (Q_F F))
        (edge F (n + 1 + 1)) (ν_succ F) hComm1 hComm2 hIH_ex1
    · exact hConjExact (e_U F n) (e_Δ F) (e_X F h₁ (n + 1))
        (ν_n (Q_F F)) (β_n (Q_F F))
        (ν_succ F) (β_succ F) hComm2 hComm3 hIH_ex2
    · exact hConjExact (e_Δ F) (e_X F h₁ (n + 1)) (e_U F (n + 1))
        (β_n (Q_F F)) (edge (Q_F F) (n + 2))
        (β_succ F) (edge F (n + 1 + 2)) hComm3 hComm4 hIH_ex3
    · exact hConjSurj (e_X F h₁ (n + 1)) (e_U F (n + 1))
        (edge (Q_F F) (n + 2)) (edge F (n + 1 + 2)) hComm4 hIH_surj
  · intro F₂ hLow₂ hTop₂ hSub₂ φ y
    have h₁_2 : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 F₂) :=
      hLow₂ 1 le_rfl (Nat.le_add_left 1 n)
    have hβ_F₂ : β_succ F₂ =
        (e_X F₂ h₁_2 (n + 1)).toAddMonoidHom.comp
          ((β_n (Q_F F₂)).comp (e_Δ F₂).symm.toAddMonoidHom) := by
      dsimp only [β_succ]
      simp only [h₁_2, ↓reduceDIte]
    obtain ⟨hLowQ₂, hTopQ₂, hSubQ₂⟩ := hShiftHyp F₂ hLow₂ hTop₂ hSub₂

    obtain ⟨φ_I, hφ_I⟩ := CategoryTheory.Injective.factors (φ ≫ ι_F F) (ι_F F₂)
    have h_zero : ι_F F₂ ≫ (φ_I ≫ π_F F) = 0 := by
      rw [← CategoryTheory.Category.assoc, hφ_I, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
    let φ_Q : Q_F F₂ ⟶ Q_F F :=
      CategoryTheory.Limits.cokernel.desc (ι_F F₂) (φ_I ≫ π_F F) h_zero
    have hπ_Q : π_F F₂ ≫ φ_Q = φ_I ≫ π_F F :=
      CategoryTheory.Limits.cokernel.π_desc (ι_F F₂) (φ_I ≫ π_F F) h_zero

    let Ψ : SC_F F₂ ⟶ SC_F F :=
      CategoryTheory.ShortComplex.homMk φ φ_I φ_Q hφ_I.symm hπ_Q.symm
    let Ψ_X : SC_X F₂ ⟶ SC_X F :=
      CategoryTheory.ShortComplex.homMk (pf_j.map φ) (pf_j.map φ_I) (pf_j.map φ_Q)
        (by dsimp [SC_X, SC_F]; rw [← pf_j.map_comp, ← pf_j.map_comp, hφ_I])
        (by dsimp [SC_X, SC_F]; rw [← pf_j.map_comp, ← pf_j.map_comp, hπ_Q])

    let d₂ := isoΔ F₂ (n + 1) (Nat.le_add_left 1 n)
    let d₁ := isoΔ F (n + 1) (Nat.le_add_left 1 n)
    let τ_φ := weilEtaleHigherDirectImageMap j (n + 1 + 1) φ
    let τ_φQ := weilEtaleHigherDirectImageMap j (n + 1) φ_Q

    have hSqΔ_hom : d₂.hom ≫ τ_φ = τ_φQ ≫ d₁.hom :=
      hΔ_nat (hSE_F F₂) (hSE_F F) Ψ (n + 1)
    have hSqΔ_inv : τ_φ ≫ d₁.inv = d₂.inv ≫ τ_φQ := by
      calc
        τ_φ ≫ d₁.inv = (d₂.inv ≫ d₂.hom) ≫ (τ_φ ≫ d₁.inv) := by
          rw [d₂.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = d₂.inv ≫ (d₂.hom ≫ τ_φ) ≫ d₁.inv := by
          simp only [CategoryTheory.Category.assoc]
        _ = d₂.inv ≫ τ_φQ ≫ (d₁.hom ≫ d₁.inv) := by
          rw [hSqΔ_hom]
          simp only [CategoryTheory.Category.assoc]
        _ = d₂.inv ≫ τ_φQ := by
          rw [d₁.hom_inv_id, CategoryTheory.Category.comp_id]

    have hSqA :
        (e_Δ F).symm ((CategoryTheory.Abelian.Ext.mk₀ τ_φ).postcomp (cZ X) (Nat.add_zero 0) y) =
          (CategoryTheory.Abelian.Ext.mk₀ τ_φQ).postcomp (cZ X) (Nat.add_zero 0)
            ((e_Δ F₂).symm y) := by
      change (CategoryTheory.Abelian.Ext.mk₀ d₁.inv).postcomp (cZ X) (Nat.add_zero 0)
          ((CategoryTheory.Abelian.Ext.mk₀ τ_φ).postcomp (cZ X) (Nat.add_zero 0) y) =
        (CategoryTheory.Abelian.Ext.mk₀ τ_φQ).postcomp (cZ X) (Nat.add_zero 0)
          ((CategoryTheory.Abelian.Ext.mk₀ d₂.inv).postcomp (cZ X) (Nat.add_zero 0) y)
      rw [hPostcompComp, hSqΔ_inv, ← hPostcompComp]

    have hSqB :
        (CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ_Q)).postcomp Fℤ_X (Nat.add_zero (n + 2))
          (β_n (Q_F F₂) ((e_Δ F₂).symm y)) =
        β_n (Q_F F)
          ((e_Δ F).symm
            ((CategoryTheory.Abelian.Ext.mk₀ τ_φ).postcomp (cZ X) (Nat.add_zero 0) y)) := by
      rw [hSqA]
      exact hIH_nat (Q_F F₂) hLowQ₂ hTopQ₂ hSubQ₂ φ_Q ((e_Δ F₂).symm y)

    let w := β_n (Q_F F₂) ((e_Δ F₂).symm y)
    have hNatExt := CategoryTheory.ShortComplex.ShortExact.extClass_naturality
      (hSE_X F₂ h₁_2) (hSE_X F h₁) Ψ_X
    have hSqC :
        (CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp Fℤ_X (Nat.add_zero (n + 1 + 2))
          (d_X F₂ h₁_2 (n + 2) w) =
        d_X F h₁ (n + 2)
          ((CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ_Q)).postcomp Fℤ_X
            (Nat.add_zero (n + 2)) w) := by
      change (w.comp (hSE_X F₂ h₁_2).extClass (rfl : (n + 2) + 1 = n + 1 + 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ Ψ_X.τ₁) (Nat.add_zero (n + 1 + 2)) =
        (w.comp (CategoryTheory.Abelian.Ext.mk₀ Ψ_X.τ₃) (Nat.add_zero (n + 2))).comp
          (hSE_X F h₁).extClass (rfl : (n + 2) + 1 = n + 1 + 2)
      rw [CategoryTheory.Abelian.Ext.comp_assoc w
          (hSE_X F₂ h₁_2).extClass (CategoryTheory.Abelian.Ext.mk₀ Ψ_X.τ₁)
          (rfl : (n + 2) + 1 = n + 1 + 2) (Nat.add_zero 1) (rfl : (n + 2) + 1 = n + 1 + 2),
        hNatExt,
        ← CategoryTheory.Abelian.Ext.comp_assoc w
          (CategoryTheory.Abelian.Ext.mk₀ Ψ_X.τ₃) (hSE_X F h₁).extClass
          (Nat.add_zero (n + 2)) (Nat.zero_add 1) (rfl : (n + 2) + 1 = n + 1 + 2)]

    rw [hβ_F₂, hβ_F]
    change (CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp Fℤ_X (Nat.add_zero (n + 1 + 2))
        (d_X F₂ h₁_2 (n + 2) w) =
      d_X F h₁ (n + 2)
        (β_n (Q_F F)
          ((e_Δ F).symm
            ((CategoryTheory.Abelian.Ext.mk₀ τ_φ).postcomp (cZ X) (Nat.add_zero 0) y)))
    rw [hSqC, ← hSqB]

theorem weil_odp_val_seq_truncated_skyscraper_five_term_leray {X X_U : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
    (hCont_j : (weilEtaleSitePullback j).IsContinuous
      X.smallEtaleTopology X_U.smallEtaleTopology)
    (hAdj_j : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback j) AddCommGrpCat.{u} _
      X.smallEtaleTopology X_U.smallEtaleTopology hCont_j).IsRightAdjoint)
    (T_U : X_U.Etale) (hT_U : CategoryTheory.Limits.IsTerminal T_U)
    (T_X : X.Etale) (hT_X : CategoryTheory.Limits.IsTerminal T_X)
    (ℓ N : ℕ)
    (hUnit : ∀ r : ℕ,
      let adj_j := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback j) AddCommGrpCat.{u} _
        X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
      let A_r := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
      CategoryTheory.IsIso
        ((adj_j.homEquiv
          (weilEtaleTorsionSheaf X (ℓ ^ (r + 1)))
          (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1))))
          (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A_r)))
    (hVan : ∀ (r b : ℕ), 1 ≤ b → b ≠ N + 1 →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1)))))
    (hH1 : ∀ r : ℕ,
      Subsingleton
        ((weilEtaleHigherDirectImage j (N + 1)
          (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1)))).H 1)) :
    ∃ (ν_raw : ∀ r : ℕ,
        weilEtaleTorsionH X_U (ℓ ^ (r + 1)) (N + 1) →+
          (weilEtaleHigherDirectImage j (N + 1)
            (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1)))).H 0)
      (β_raw : ∀ r : ℕ,
        (weilEtaleHigherDirectImage j (N + 1)
          (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1)))).H 0 →+
          weilEtaleTorsionH X (ℓ ^ (r + 1)) (N + 2)),
      (∀ (r q : ℕ), q ≤ N →
        ∀ (p_q : weilEtaleTorsionH X (ℓ ^ (r + 1)) q →+
            weilEtaleTorsionH X_U (ℓ ^ (r + 1)) q),
          WeilIsTorsionEtalePullback j (ℓ ^ (r + 1)) q p_q →
          Function.Bijective p_q) ∧
      (∀ (r : ℕ)
          (p_N1 : weilEtaleTorsionH X (ℓ ^ (r + 1)) (N + 1) →+
            weilEtaleTorsionH X_U (ℓ ^ (r + 1)) (N + 1))
          (p_N2 : weilEtaleTorsionH X (ℓ ^ (r + 1)) (N + 2) →+
            weilEtaleTorsionH X_U (ℓ ^ (r + 1)) (N + 2)),
        WeilIsTorsionEtalePullback j (ℓ ^ (r + 1)) (N + 1) p_N1 →
        WeilIsTorsionEtalePullback j (ℓ ^ (r + 1)) (N + 2) p_N2 →
        Function.Injective p_N1 ∧
        AddMonoidHom.range p_N1 = AddMonoidHom.ker (ν_raw r) ∧
        AddMonoidHom.range (ν_raw r) = AddMonoidHom.ker (β_raw r) ∧
        AddMonoidHom.range (β_raw r) = AddMonoidHom.ker p_N2 ∧
        Function.Surjective p_N2) ∧
      (∀ (r : ℕ)
          (y : (weilEtaleHigherDirectImage j (N + 1)
            (weilEtaleTorsionSheaf X_U (ℓ ^ (r + 2)))).H 0),
        let cast_U :=
          (CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map
              (AddCommGrpCat.ofHom
                (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
                  (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom))
        let τ_𝒮 := weilEtaleHigherDirectImageMap j (N + 1) cast_U
        let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        weilEtaleTorsionTransition X ℓ (r + 1) (N + 2) (β_raw (r + 1) y) =
          β_raw r
            ((CategoryTheory.Abelian.Ext.mk₀ τ_𝒮).postcomp Fℤ_X (Nat.add_zero 0) y)) :=
by
  let pf_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    (weilEtaleSitePullback j) AddCommGrpCat.{u} _
    X.smallEtaleTopology X_U.smallEtaleTopology hCont_j
  let pb_j := @CategoryTheory.Functor.sheafPullback _ _ _ _
    (weilEtaleSitePullback j) AddCommGrpCat.{u} _
    X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
  let adj_j := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    (weilEtaleSitePullback j) AddCommGrpCat.{u} _
    X.smallEtaleTopology X_U.smallEtaleTopology hCont_j hAdj_j
  let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
  let C_U := CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := C_X.obj Aℤ

  
  obtain ⟨hAdd_pb, hColim_pb, hLim_pb⟩ :=
    (weil_transv_etale_sheaf_pullback_exact X_U X j).2 hCont_j hAdj_j
  letI : pb_j.Additive := hAdd_pb
  letI : CategoryTheory.Limits.PreservesFiniteColimits pb_j := hColim_pb
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_j := hLim_pb
  have hMono_pb : pb_j.PreservesMonomorphisms := inferInstance
  have hAdd_pf : pf_j.Additive :=
    { map_add := fun {_ _ _ _} => by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W
        rfl }
  letI : pf_j.Additive := hAdd_pf

  
  obtain ⟨⟨_, hConstNat⟩, ⟨_, edge, _, _, hEdge0, hEdgeNat, hEdgeConn, hPcan⟩⟩ :=
    weil_leray_five_term_const_pullback_and_edge_bridge j hCont_j hAdj_j T_U hT_U T_X hT_X
  obtain ⟨hInjRaw, ⟨δ₀, Δ, hHDI_props, hδ₀_nat, hΔ_nat⟩⟩ :=
    weil_leray_five_term_natural_hdi_connecting_package j hCont_j hAdj_j
  have hInjAdj : ∀ (I : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective I],
      CategoryTheory.Injective (pf_j.obj I) ∧
      ∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j p I) :=
    fun I _ => ⟨(hInjRaw I).1 hMono_pb, (hInjRaw I).2⟩

  
  have hPullFactor : ∀ (m q : ℕ)
      (p_q : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X_U m q),
      WeilIsTorsionEtalePullback j m q p_q →
      ∀ z : weilEtaleTorsionH X m q,
        let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
        let π_m := @weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X A_m
        let η_m := (adj_j.homEquiv (weilEtaleTorsionSheaf X m) (weilEtaleTorsionSheaf X_U m)) π_m
        p_q z = edge (weilEtaleTorsionSheaf X_U m) q
          ((CategoryTheory.Abelian.Ext.mk₀ η_m).postcomp Fℤ_X (Nat.add_zero q) z) := by
    intro m q p_q hp_q z
    obtain ⟨p_can, hp_can, h_pcan_eq⟩ := hPcan m q
    obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality
    obtain ⟨p_id, hp_id⟩ := hPullEx (𝟙 X_U) m q
    have hp_id_eq : p_id = AddMonoidHom.id _ := hPullId m q p_id hp_id
    have hp_comp_j : WeilIsTorsionEtalePullback (CategoryTheory.CategoryStruct.comp (𝟙 X_U) j)
        m q p_q := by
      rwa [CategoryTheory.Category.id_comp]
    have hp_eq : p_q = p_can := by
      have h1 := hPullComp (𝟙 X_U) j m q p_id p_can p_q hp_id hp_can hp_comp_j
      rwa [hp_id_eq, AddMonoidHom.id_comp] at h1
    rw [hp_eq]
    exact h_pcan_eq z

  
  let LerayAt : ℕ → Prop := fun n =>
    ∃ (ν_n : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
          F.H (n + 1) →+ (weilEtaleHigherDirectImage j (n + 1) F).H 0)
      (β_n : ∀ F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u},
          (weilEtaleHigherDirectImage j (n + 1) F).H 0 →+ (pf_j.obj F).H (n + 2)),
      ∀ (F : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ b : ℕ, 1 ≤ b → b ≤ n →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b F)) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 2) F) →
        Subsingleton ((weilEtaleHigherDirectImage j (n + 1) F).H 1) →
        (∀ q : ℕ, q ≤ n → Function.Bijective (edge F q)) ∧
        (Function.Injective (edge F (n + 1)) ∧
          AddMonoidHom.range (edge F (n + 1)) = AddMonoidHom.ker (ν_n F) ∧
          AddMonoidHom.range (ν_n F) = AddMonoidHom.ker (β_n F) ∧
          AddMonoidHom.range (β_n F) = AddMonoidHom.ker (edge F (n + 2)) ∧
          Function.Surjective (edge F (n + 2))) ∧
        (∀ (F₂ : CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ b : ℕ, 1 ≤ b → b ≤ n →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b F₂)) →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (n + 2) F₂) →
          Subsingleton ((weilEtaleHigherDirectImage j (n + 1) F₂).H 1) →
          ∀ (φ : F₂ ⟶ F) (y : (weilEtaleHigherDirectImage j (n + 1) F₂).H 0),
            (CategoryTheory.Abelian.Ext.mk₀ (pf_j.map φ)).postcomp Fℤ_X
              (Nat.add_zero (n + 2)) (β_n F₂ y) =
            β_n F ((CategoryTheory.Abelian.Ext.mk₀
              (weilEtaleHigherDirectImageMap j (n + 1) φ)).postcomp Fℤ_X
              (Nat.add_zero 0) y))

  have hBase : LerayAt 0 := by
    obtain ⟨ν₀, β₀, hNat₀, hEx₀⟩ :=
      weil_leray_five_term_coimage_cokernel_base j hCont_j edge hEdge0 hEdgeNat hEdgeConn
        hInjAdj δ₀
        (fun SC hSE => ⟨(hHDI_props SC hSE).1, (hHDI_props SC hSE).2.1,
          (hHDI_props SC hSE).2.2.1, (hHDI_props SC hSE).2.2.2.1⟩)
        hδ₀_nat
        (fun SC hSE => Δ SC hSE 1)
        (fun SC hSE => (hHDI_props SC hSE).2.2.2.2 1 le_rfl)
    refine ⟨ν₀, β₀, fun F _ hTop hSub => ?_⟩
    obtain ⟨hLowBij, hInj1, hKer1, hKer2, hKer3, hSurj2⟩ := hEx₀ F hTop hSub
    exact ⟨hLowBij, ⟨hInj1, hKer1, hKer2, hKer3, hSurj2⟩,
      fun F₂ _ _ _ φ y => hNat₀ F F₂ φ y⟩

  have hLerayAll : ∀ n : ℕ, LerayAt n := by
    intro n
    induction n with
    | zero => exact hBase
    | succ n ih =>
      exact weil_leray_five_term_dimension_shift_step j hCont_j edge hEdge0 hEdgeNat hEdgeConn
        hInjAdj
        (fun SC hSE => (hHDI_props SC hSE).2.2.1)
        Δ
        (fun SC hSE => (hHDI_props SC hSE).2.2.2.2)
        hΔ_nat n ih

  obtain ⟨ν_N, β_N, hLeray_N⟩ := hLerayAll N

  
  have hPostcompComp :
      ∀ {G₁ G₂ G₃ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (α : G₁ ⟶ G₂) (β : G₂ ⟶ G₃) (q : ℕ) (z : G₁.H q),
        (CategoryTheory.Abelian.Ext.mk₀ β).postcomp Fℤ_X (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ α).postcomp Fℤ_X (Nat.add_zero q) z) =
        (CategoryTheory.Abelian.Ext.mk₀ (α ≫ β)).postcomp Fℤ_X (Nat.add_zero q) z := by
    intro G₁ G₂ G₃ α β q z
    change (z.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β) (Nat.add_zero q) =
      z.comp (CategoryTheory.Abelian.Ext.mk₀ (α ≫ β)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc z
        (CategoryTheory.Abelian.Ext.mk₀ α) (CategoryTheory.Abelian.Ext.mk₀ β)
        (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  have hPostcompId :
      ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ) (z : G.H q),
        (CategoryTheory.Abelian.Ext.mk₀ (𝟙 G)).postcomp Fℤ_X (Nat.add_zero q) z = z :=
    fun _ _ z => CategoryTheory.Abelian.Ext.comp_mk₀_id z

  let A_mod : ℕ → AddCommGrpCat.{u} :=
    fun r => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
  let Λ_X : ℕ → CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r => weilEtaleTorsionSheaf X (ℓ ^ (r + 1))
  let Λ_U : ℕ → CategoryTheory.Sheaf X_U.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r => weilEtaleTorsionSheaf X_U (ℓ ^ (r + 1))
  let η : ∀ r : ℕ, Λ_X r ⟶ pf_j.obj (Λ_U r) :=
    fun r => (adj_j.homEquiv (Λ_X r) (Λ_U r))
      (@weilEtaleConstPullbackHom X_U X j hCont_j hAdj_j T_U hT_U T_X hT_X (A_mod r))
  have hIso_η : ∀ r : ℕ, CategoryTheory.IsIso (η r) := hUnit
  let η_inv : ∀ r : ℕ, pf_j.obj (Λ_U r) ⟶ Λ_X r :=
    fun r => @CategoryTheory.inv _ _ _ _ (η r) (hIso_η r)

  let e_η : ∀ (r q : ℕ), weilEtaleTorsionH X (ℓ ^ (r + 1)) q ≃+ (pf_j.obj (Λ_U r)).H q :=
    fun r q =>
      { toFun := (CategoryTheory.Abelian.Ext.mk₀ (η r)).postcomp Fℤ_X (Nat.add_zero q)
        invFun := (CategoryTheory.Abelian.Ext.mk₀ (η_inv r)).postcomp Fℤ_X (Nat.add_zero q)
        left_inv := fun z => by
          letI : CategoryTheory.IsIso (η r) := hIso_η r
          dsimp only [η_inv]
          rw [hPostcompComp, CategoryTheory.IsIso.hom_inv_id, hPostcompId]
        right_inv := fun w => by
          letI : CategoryTheory.IsIso (η r) := hIso_η r
          dsimp only [η_inv]
          rw [hPostcompComp, CategoryTheory.IsIso.inv_hom_id, hPostcompId]
        map_add' := map_add _ }

  have hp_eq_comp : ∀ (r q : ℕ)
      (p_q : weilEtaleTorsionH X (ℓ ^ (r + 1)) q →+ weilEtaleTorsionH X_U (ℓ ^ (r + 1)) q),
      WeilIsTorsionEtalePullback j (ℓ ^ (r + 1)) q p_q →
      p_q = (edge (Λ_U r) q).comp (e_η r q).toAddMonoidHom := by
    intro r q p_q hp_q
    ext z
    exact hPullFactor (ℓ ^ (r + 1)) q p_q hp_q z

  have hLow_Λ : ∀ (r b : ℕ), 1 ≤ b → b ≤ N →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j b (Λ_U r)) :=
    fun r b hb1 hbN => hVan r b hb1 (by omega)
  have hTop_Λ : ∀ r : ℕ,
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (N + 2) (Λ_U r)) :=
    fun r => hVan r (N + 2) (by omega) (by omega)

  let ν_raw : ∀ r : ℕ,
      weilEtaleTorsionH X_U (ℓ ^ (r + 1)) (N + 1) →+
        (weilEtaleHigherDirectImage j (N + 1) (Λ_U r)).H 0 :=
    fun r => ν_N (Λ_U r)
  let β_raw : ∀ r : ℕ,
      (weilEtaleHigherDirectImage j (N + 1) (Λ_U r)).H 0 →+
        weilEtaleTorsionH X (ℓ ^ (r + 1)) (N + 2) :=
    fun r => (e_η r (N + 2)).symm.toAddMonoidHom.comp (β_N (Λ_U r))

  refine ⟨ν_raw, β_raw, ?_, ?_, ?_⟩
  · 
    intro r q hq p_q hp_q
    have hBij_edge := (hLeray_N (Λ_U r) (hLow_Λ r) (hTop_Λ r) (hH1 r)).1 q hq
    rw [hp_eq_comp r q p_q hp_q, AddMonoidHom.coe_comp]
    exact hBij_edge.comp (e_η r q).bijective
  · 
    intro r p_N1 p_N2 hp_N1 hp_N2
    obtain ⟨hInj_e1, hEx1, hEx2, hEx3, hSurj_e2⟩ :=
      (hLeray_N (Λ_U r) (hLow_Λ r) (hTop_Λ r) (hH1 r)).2.1
    have hp1 := hp_eq_comp r (N + 1) p_N1 hp_N1
    have hp2 := hp_eq_comp r (N + 2) p_N2 hp_N2
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [hp1, AddMonoidHom.coe_comp]
      exact hInj_e1.comp (e_η r (N + 1)).injective
    · ext x
      rw [hp1, AddMonoidHom.mem_range]
      simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      have h_rng : (∃ z, edge (Λ_U r) (N + 1) (e_η r (N + 1) z) = x) ↔
          x ∈ AddMonoidHom.range (edge (Λ_U r) (N + 1)) := by
        rw [AddMonoidHom.mem_range]
        exact ⟨fun ⟨z, hz⟩ => ⟨e_η r (N + 1) z, hz⟩,
          fun ⟨w, hw⟩ => ⟨(e_η r (N + 1)).symm w, by rw [AddEquiv.apply_symm_apply, hw]⟩⟩
      rw [h_rng, hEx1]
    · ext z
      have h_ker : z ∈ AddMonoidHom.ker (β_raw r) ↔ z ∈ AddMonoidHom.ker (β_N (Λ_U r)) := by
        simp only [β_raw, AddMonoidHom.mem_ker, AddMonoidHom.comp_apply,
          AddEquiv.coe_toAddMonoidHom]
        exact ⟨fun h => (e_η r (N + 2)).symm.injective (h.trans (map_zero _).symm),
          fun h => by rw [h, map_zero]⟩
      rw [h_ker, ← hEx2]
    · ext z
      have h_rng : z ∈ AddMonoidHom.range (β_raw r) ↔
          e_η r (N + 2) z ∈ AddMonoidHom.range (β_N (Λ_U r)) := by
        simp only [β_raw, AddMonoidHom.mem_range, AddMonoidHom.comp_apply,
          AddEquiv.coe_toAddMonoidHom]
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨y, ((e_η r (N + 2)).apply_symm_apply _).symm⟩
        · rintro ⟨y, hy⟩
          refine ⟨y, ?_⟩
          rw [hy, (e_η r (N + 2)).symm_apply_apply]
      rw [h_rng, hEx3, hp2, AddMonoidHom.mem_ker, AddMonoidHom.mem_ker,
        AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
    · rw [hp2, AddMonoidHom.coe_comp]
      exact hSurj_e2.comp (e_η r (N + 2)).surjective
