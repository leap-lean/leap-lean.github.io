  let E₁ : (C₁.obj Aℤ ⟶ C₁.obj A_m) ≃ ↥((C₁.obj A_m).obj.obj (Opposite.op T₁)) :=
    (adj₁.homEquiv Aℤ (C₁.obj A_m)).trans (ev₁ _)
  let E₁_tot : (C₁.obj Aℤ ⟶ C₁.obj A_m) ≃ ↥((C₁.obj A_m).obj.obj (Opposite.op (B.obj T₂))) :=
    E₁.trans E_τ
  let E₂ : (C₂.obj Aℤ ⟶ C₂.obj A_m) ≃ ↥((C₂.obj A_m).obj.obj (Opposite.op T₂)) :=
    (adj₂.homEquiv Aℤ (C₂.obj A_m)).trans (ev₁ _)
  have hConj_ev : ⇑E₁_tot ∘ Φ = ⇑(η_h.hom.app (Opposite.op T₂)) ∘ ⇑E₂ := by
    funext f
    exact CategoryTheory.ConcreteCategory.congr_hom (hConj f) (ULift.up 1)
  have hBij_Φ_η : Function.Bijective Φ ↔ Function.Bijective (η_h.hom.app (Opposite.op T₂)) := by
    constructor
    · intro hΦ_bij
      have h1 : Function.Bijective (⇑(η_h.hom.app (Opposite.op T₂)) ∘ ⇑E₂) := by
