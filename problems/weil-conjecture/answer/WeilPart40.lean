      have : CategoryTheory.IsIso (e_sh0.inv.hom.app (Opposite.op T_Z0)) :=
        CategoryTheory.Iso.isIso_hom
          (((CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).mapIso e_sh0.symm).app
            (Opposite.op T_Z0))
      have hBij_sh0 : Function.Bijective (e_sh0.inv.hom.app (Opposite.op T_Z0)).hom :=
