      have hres₁_sub : res₁_inf (c_inf - C.leg i₂ c'₂) = 0 := by
        rw [map_sub, (hleg_res i₂ c'₂).2, hc'₂_1, D₁_sys.leg_map, hd₁₁, sub_self]
      obtain ⟨b_inf, hb_inf⟩ := hex_C_inf (c_inf - C.leg i₂ c'₂) hres₀_sub hres₁_sub
      obtain ⟨i₃, b₃, hb₃⟩ := hSurj_B b_inf
      let i₄ : ℐ := CategoryTheory.IsFiltered.max i₂ i₃
      let σ₂ : i₂ ⟶ i₄ := CategoryTheory.IsFiltered.leftToMax i₂ i₃
      let σ₃ : i₃ ⟶ i₄ := CategoryTheory.IsFiltered.rightToMax i₂ i₃
      refine ⟨i₄, C.map σ₂ c'₂ + δ i₄ (B.map σ₃ b₃), ?_⟩
      rw [map_add, C.leg_map, ← hleg_δ, B.leg_map, hb₃, hb_inf, add_sub_cancel]
    · intro i₀ c₀ hc₀
      have h0_leg : D₀_sys.leg i₀ (res₀ i₀ c₀) = 0 := by
        rw [← (hleg_res i₀ c₀).1, hc₀, map_zero]
      have h1_leg : D₁_sys.leg i₀ (res₁ i₀ c₀) = 0 := by
        rw [← (hleg_res i₀ c₀).2, hc₀, map_zero]
