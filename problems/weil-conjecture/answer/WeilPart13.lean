        intro ω
        have hq_mem : Submodule.Quotient.mk (p := S_Ω) ω ∈ (⊤ : Submodule L₀ Q) := trivial
        rw [hbot, Submodule.mem_bot, Submodule.Quotient.mk_eq_zero] at hq_mem
        exact hq_mem
      have hKer_Ω : ∀ u : Fin 2 → L₀, π_Ω u = 0 → ∀ i : Fin 2, u i ∈ 𝔪₀ := by
        intro u hu i
        have h0 : IsLocalRing.residue L₀ (u 0) • b 0 + IsLocalRing.residue L₀ (u 1) • b 1 = 0 := by
          have := congrArg ((1 : κ_L) ⊗ₜ[L₀] ·) hu
