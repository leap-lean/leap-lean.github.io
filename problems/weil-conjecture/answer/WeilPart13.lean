      ∃ Ψ : (A ⧸ (Ideal.comap ψ m₀.asIdeal) ^ 3) ≃+* (D_K ⧸ m₀.asIdeal ^ 3),
        ∀ a : A, Ψ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (ψ a) := by
    intro A _ toA ψ hψ hev_A
