      obtain ⟨ω₁, hω₁⟩ := htmul_surj (b 1)
      let π_Ω : (Fin 2 → L₀) →ₗ[L₀] Ω[L₀⁄κ₀] :=
        { toFun := fun u => u 0 • ω₀ + u 1 • ω₁
