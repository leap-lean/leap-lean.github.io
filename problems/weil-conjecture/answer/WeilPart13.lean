            (pow_ne_zero n (mul_ne_zero (MvPolynomial.X_ne_zero i) (MvPolynomial.X_ne_zero j)))
        have hf0 : f = 0 :=
          IsLocalization.injective Loc_ij h_nzd (by rw [← h_map, map_zero])
        rw [hf0, map_zero] at hf
        let s_im : Submonoid.powers (MvPolynomial.X (R := k) i) :=
          ⟨(MvPolynomial.X i) ^ m, pow_mem (Submonoid.mem_powers _) m⟩
        obtain ⟨u_im, hu_im⟩ := IsLocalization.map_units Loc_i s_im
        have h_val0 : (a₁ - a₂).val = (0 : A_i_ring).val := by
          rw [HomogeneousLocalization.val_zero, ← Units.mul_left_inj u_im, zero_mul, hu_im]
          simpa [s_im, map_pow] using hf
        exact HomogeneousLocalization.val_injective _ h_val0
    intro x hx
    have hx_i : x ∈ D_raw i := (P.basicOpen_le (c_raw i j)) hx
    let A_i := CommRingCat.of A_i_ring
    let u_i : AlgebraicGeometry.Spec A_i ⟶ P :=
      AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) zero_lt_one
    have hu_range : u_i.opensRange = D_raw i :=
      AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X i) (hX i) zero_lt_one
    have hx_range : x ∈ u_i.opensRange := hu_range.symm ▸ hx_i
    obtain ⟨p_spec, rfl⟩ := hx_range
    have hp_pre : p_spec ∈
        (TopologicalSpace.Opens.map u_i.base).obj (P.basicOpen (c_raw i j)) := hx
    rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen u_i (c_raw i j)] at hp_pre
    have h_res_bo :
        (AlgebraicGeometry.Spec A_i).basicOpen
          ((u_i.appLE (D_raw i) ⊤ (hTop_u i)).hom (c_raw i j)) =
        (⊤ : (AlgebraicGeometry.Spec A_i).Opens) ⊓
          (AlgebraicGeometry.Spec A_i).basicOpen ((u_i.app (D_raw i)).hom (c_raw i j)) :=
      AlgebraicGeometry.Scheme.basicOpen_res (AlgebraicGeometry.Spec A_i)
        ((u_i.app (D_raw i)).hom (c_raw i j)) (CategoryTheory.homOfLE (hTop_u i)).op
    have h_appLE_tij :
        (u_i.appLE (D_raw i) ⊤ (hTop_u i)).hom (c_raw i j) =
          (AlgebraicGeometry.Scheme.ΓSpecIso A_i).inv.hom (t i j) := by
      let e_i : A_i ≅ P.presheaf.obj (Opposite.op (D_raw i)) :=
        AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X i) (hX i) zero_lt_one
      have h_inv : u_i.appLE (D_raw i) ⊤ (hTop_u i) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso A_i).hom = e_i.inv := hChartInv i
      have h1 : u_i.appLE (D_raw i) ⊤ (hTop_u i) =
          e_i.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso A_i).inv := by
        rw [CategoryTheory.Iso.eq_comp_inv]
        exact h_inv
      rw [h1]
      change (e_i.hom ≫ e_i.inv ≫ (AlgebraicGeometry.Scheme.ΓSpecIso A_i).inv).hom (t i j) = _
      rw [← Category.assoc, e_i.hom_inv_id, Category.id_comp]
    have hp_prime_bo : p_spec ∈ PrimeSpectrum.basicOpen (t i j) := by
      rw [← AlgebraicGeometry.basicOpen_eq_of_affine (R := A_i) (t i j), ← h_appLE_tij, h_res_bo]
      exact ⟨trivial, hp_pre⟩
    have hp_comap : p_spec ∈ Set.range (PrimeSpectrum.comap (algebraMap A_i_ring A_ij_ring)) := by
      rw [PrimeSpectrum.localization_away_comap_range A_ij_ring (t i j)]
      exact hp_prime_bo
    obtain ⟨q_spec, hq_eq⟩ := hp_comap
    have h_base_eq :
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ij)).base q_spec) = p_spec := hq_eq
    rw [← h_base_eq]
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ij) ≫ u_i).base q_spec ∈ D_raw j
    rw [AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX i) zero_lt_one (hX j) rfl]
    have h_in_ij :
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X i * MvPolynomial.X j) hXij zero_lt_two).base q_spec ∈
          AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i * MvPolynomial.X j) := by
      rw [← AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X i * MvPolynomial.X j) hXij zero_lt_two]
      exact ⟨q_spec, rfl⟩
    rw [AlgebraicGeometry.Proj.basicOpen_mul] at h_in_ij
    exact h_in_ij.2

  
  have hCocycle_raw : ∀ i j r : Fin (N + 1),
      ((P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_raw i ⊓ D_raw j ≤ D_raw j)).op).hom
          (c_raw j r)) *
      ((P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_raw i ⊓ D_raw j ≤ D_raw i)).op).hom
          (c_raw i j)) =
      (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_raw i ⊓ D_raw j ≤ D_raw i)).op).hom
          (c_raw i r) := by
    intro i j r
    have h_mul_eq : AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i * MvPolynomial.X j) =
        D_raw i ⊓ D_raw j :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X i) (MvPolynomial.X j)
    have h_ge : D_raw i ⊓ D_raw j ≤
        AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i * MvPolynomial.X j) :=
      le_of_eq h_mul_eq.symm
    let ρ_ij : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i * MvPolynomial.X j) →+*
        ↑(P.presheaf.obj (Opposite.op (D_raw i ⊓ D_raw j))) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X i * MvPolynomial.X j) ≫
        P.presheaf.map (CategoryTheory.homOfLE h_ge).op).hom
    let φ_ij := HomogeneousLocalization.awayMap 𝒜 (hX j)
      (rfl : MvPolynomial.X i * MvPolynomial.X j = MvPolynomial.X i * MvPolynomial.X j)
    let φ'_ji := HomogeneousLocalization.awayMap 𝒜 (hX i)
      (mul_comm (MvPolynomial.X (R := k) i) (MvPolynomial.X j))
    have h_res_left : ∀ s : Fin (N + 1),
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D_raw i ⊓ D_raw j ≤ D_raw i)).op).hom
          (c_raw i s) = ρ_ij (φ_ij (t i s)) := by
      intro s
      have h_away := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX j)
        (rfl : MvPolynomial.X i * MvPolynomial.X j = MvPolynomial.X i * MvPolynomial.X j)
      have h_comp := h_away =≫ P.presheaf.map (CategoryTheory.homOfLE h_ge).op
      rw [Category.assoc, Category.assoc, ← P.presheaf.map_comp, ← op_comp,
        CategoryTheory.homOfLE_comp] at h_comp
      exact (congrArg (fun f => f.hom (t i s)) h_comp).symm
    have h_res_right :
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D_raw i ⊓ D_raw j ≤ D_raw j)).op).hom
          (c_raw j r) = ρ_ij (φ'_ji (t j r)) := by
      have h_away := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX i)
        (mul_comm (MvPolynomial.X (R := k) i) (MvPolynomial.X j))
      have h_comp := h_away =≫ P.presheaf.map (CategoryTheory.homOfLE h_ge).op
      rw [Category.assoc, Category.assoc, ← P.presheaf.map_comp, ← op_comp,
        CategoryTheory.homOfLE_comp] at h_comp
      exact (congrArg (fun f => f.hom (t j r)) h_comp).symm
    rw [h_res_right, h_res_left j, h_res_left r, ← map_mul]
    congr 1
    apply HomogeneousLocalization.val_injective
    let Loc_ij := Localization.Away (MvPolynomial.X (R := k) i * MvPolynomial.X j)
    let s_ij1 : Submonoid.powers (MvPolynomial.X (R := k) i * MvPolynomial.X j) :=
      ⟨(MvPolynomial.X i * MvPolynomial.X j) ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩
    obtain ⟨u_ij, hu_ij_raw⟩ := IsLocalization.map_units Loc_ij s_ij1
    rw [← Units.mul_left_inj u_ij]
    have hu_ij : (u_ij : Loc_ij) = algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i * MvPolynomial.X j) := by
      simpa [s_ij1, pow_one] using hu_ij_raw
    have hXi_u : IsUnit (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i)) := by
      refine IsUnit.of_mul_eq_one
        (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j) * ↑u_ij⁻¹) ?_
      rw [← mul_assoc, ← map_mul, ← hu_ij, Units.mul_inv]
    have hXj_u : IsUnit (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j)) := by
      refine IsUnit.of_mul_eq_one
        (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i) * ↑u_ij⁻¹) ?_
      rw [← mul_assoc, ← map_mul, mul_comm (MvPolynomial.X j), ← hu_ij, Units.mul_inv]
    have h_val_ij : ∀ b : Fin (N + 1),
        (φ_ij (t i b)).val * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i) =
          algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X b) := by
      intro b
      rw [HomogeneousLocalization.val_awayMap, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk']
      let lift_i := Localization.awayLift
        (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij) (MvPolynomial.X i) hXi_u
      let s_i1 : Submonoid.powers (MvPolynomial.X (R := k) i) :=
        ⟨(MvPolynomial.X i) ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩
      have h_spec := IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X (R := k) i))
        (MvPolynomial.X b) s_i1
      have h_map := congrArg lift_i h_spec
      change lift_i (IsLocalization.mk' (Localization.Away (MvPolynomial.X (R := k) i))
        (MvPolynomial.X b) s_i1 *
        algebraMap (MvPolynomial (Fin (N + 1)) k) _ ((MvPolynomial.X i) ^ 1)) =
        lift_i (algebraMap (MvPolynomial (Fin (N + 1)) k) _ (MvPolynomial.X b)) at h_map
      rw [map_mul, pow_one,
        IsLocalization.Away.lift_eq (MvPolynomial.X i) hXi_u (MvPolynomial.X i),
        IsLocalization.Away.lift_eq (MvPolynomial.X i) hXi_u (MvPolynomial.X b)] at h_map
      exact h_map
    have h_val_jr :
        (φ'_ji (t j r)).val * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j) =
          algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X r) := by
      rw [HomogeneousLocalization.val_awayMap, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk']
      let lift_j := Localization.awayLift
        (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij) (MvPolynomial.X j) hXj_u
      let s_j1 : Submonoid.powers (MvPolynomial.X (R := k) j) :=
        ⟨(MvPolynomial.X j) ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩
      have h_spec := IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X (R := k) j))
        (MvPolynomial.X r) s_j1
      have h_map := congrArg lift_j h_spec
      change lift_j (IsLocalization.mk' (Localization.Away (MvPolynomial.X (R := k) j))
        (MvPolynomial.X r) s_j1 *
        algebraMap (MvPolynomial (Fin (N + 1)) k) _ ((MvPolynomial.X j) ^ 1)) =
        lift_j (algebraMap (MvPolynomial (Fin (N + 1)) k) _ (MvPolynomial.X r)) at h_map
      rw [map_mul, pow_one,
        IsLocalization.Away.lift_eq (MvPolynomial.X j) hXj_u (MvPolynomial.X j),
        IsLocalization.Away.lift_eq (MvPolynomial.X j) hXj_u (MvPolynomial.X r)] at h_map
      exact h_map
    rw [HomogeneousLocalization.val_mul, hu_ij, map_mul]
    calc ((φ'_ji (t j r)).val * (φ_ij (t i j)).val) *
          (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i) * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j))
        = ((φ'_ji (t j r)).val * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j)) *
            ((φ_ij (t i j)).val * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i)) := by ring
      _ = algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X r) * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j) := by
            rw [h_val_jr, h_val_ij j]
      _ = ((φ_ij (t i r)).val * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i)) *
            algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j) := by rw [h_val_ij r]
      _ = (φ_ij (t i r)).val *
            (algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X i) * algebraMap (MvPolynomial (Fin (N + 1)) k) Loc_ij (MvPolynomial.X j)) :=
            mul_assoc _ _ _

  have hBasicLe : ∀ i j : Fin (N + 1),
      (weilProjectiveSpaceOver k N).left.basicOpen (coord_ratio i j) ≤ D_proj j := hBasicLe_raw
  have hCocycle : ∀ i j r : Fin (N + 1),
      (((weilProjectiveSpaceOver k N).left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_right : D_proj i ⊓ D_proj j ≤ D_proj j)).op).hom
          (coord_ratio j r)) *
      (((weilProjectiveSpaceOver k N).left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : D_proj i ⊓ D_proj j ≤ D_proj i)).op).hom
          (coord_ratio i j)) =
      ((weilProjectiveSpaceOver k N).left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : D_proj i ⊓ D_proj j ≤ D_proj i)).op).hom
          (coord_ratio i r) := hCocycle_raw

  
  
  
  let W : Fin (N + 1) → Y.left.Opens :=
    fun i => (TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i)
  obtain ⟨y₀⟩ := (AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left).toNonempty
  have hy₀_top : ι_Y.left.base y₀ ∈ (⊤ : (weilProjectiveSpaceOver k N).left.Opens) := trivial
  rw [← hCovD, TopologicalSpace.Opens.mem_iSup] at hy₀_top
  obtain ⟨i₀, hy₀⟩ := hy₀_top
  have hNe0 : Nonempty (W i₀) := ⟨⟨y₀, hy₀⟩⟩
  let u : Fin (N + 1) → ↑Y.left.functionField := fun r =>
    letI := hNe0
    (Y.left.germToFunctionField (W i₀)).hom
      ((ι_Y.left.app (D_proj i₀)).hom (coord_ratio i₀ r))

  have hu₀ : u i₀ = 1 := by
    change (Y.left.germToFunctionField (W i₀)).hom
      ((ι_Y.left.app (D_proj i₀)).hom (coord_ratio i₀ i₀)) = 1
    rw [hDiag i₀, map_one, map_one]

  have h_app_res_right : ∀ (i j : Fin (N + 1))
      (s : ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D_proj j)))),
      (ι_Y.left.app (D_proj i ⊓ D_proj j)).hom
        (((weilProjectiveSpaceOver k N).left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : D_proj i ⊓ D_proj j ≤ D_proj j)).op).hom s) =
      (Y.left.presheaf.map
        (CategoryTheory.homOfLE
          ((TopologicalSpace.Opens.map ι_Y.left.base).monotone
            (inf_le_right : D_proj i ⊓ D_proj j ≤ D_proj j))).op).hom
        ((ι_Y.left.app (D_proj j)).hom s) := by
    intro i j s
    change (((weilProjectiveSpaceOver k N).left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_right : D_proj i ⊓ D_proj j ≤ D_proj j)).op) ≫
      ι_Y.left.app (D_proj i ⊓ D_proj j)).hom s = _
    rw [AlgebraicGeometry.Scheme.Hom.naturality]
    rfl

  have h_app_res_left : ∀ (i j : Fin (N + 1))
      (s : ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D_proj i)))),
      (ι_Y.left.app (D_proj i ⊓ D_proj j)).hom
        (((weilProjectiveSpaceOver k N).left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : D_proj i ⊓ D_proj j ≤ D_proj i)).op).hom s) =
      (Y.left.presheaf.map
        (CategoryTheory.homOfLE
          ((TopologicalSpace.Opens.map ι_Y.left.base).monotone
            (inf_le_left : D_proj i ⊓ D_proj j ≤ D_proj i))).op).hom
        ((ι_Y.left.app (D_proj i)).hom s) := by
    intro i j s
    change (((weilProjectiveSpaceOver k N).left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : D_proj i ⊓ D_proj j ≤ D_proj i)).op) ≫
      ι_Y.left.app (D_proj i ⊓ D_proj j)).hom s = _
    rw [AlgebraicGeometry.Scheme.Hom.naturality]
    rfl

  have hu_zero : ∀ i : Fin (N + 1), u i = 0 → W i = ⊥ := by
    intro i hui
    have hs_zero : (ι_Y.left.app (D_proj i₀)).hom (coord_ratio i₀ i) = 0 := by
      apply AlgebraicGeometry.Scheme.germToFunctionField_injective Y.left (W i₀)
      rw [map_zero]
      exact hui
    by_contra hWi_ne
    have hWi_nonempty : ((W i : Y.left.Opens) : Set ↥Y.left).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro h_emp
      apply hWi_ne
      exact TopologicalSpace.Opens.ext h_emp
    obtain ⟨y₁, hy₁⟩ := hWi_nonempty
    obtain ⟨y₂, _, hy₂_0, hy₂_i⟩ :=
      PreirreducibleSpace.isPreirreducible_univ (W i₀).1 (W i).1 (W i₀).isOpen (W i).isOpen
        ⟨y₀, trivial, hy₀⟩ ⟨y₁, trivial, hy₁⟩
    let W0i : Y.left.Opens := (TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i₀ ⊓ D_proj i)
    have hNe0i : Nonempty W0i := ⟨⟨y₂, hy₂_0, hy₂_i⟩⟩
    have h_coc := congrArg (ι_Y.left.app (D_proj i₀ ⊓ D_proj i)).hom (hCocycle i₀ i i₀)
    rw [map_mul, hDiag i₀, map_one, map_one] at h_coc
    rw [h_app_res_left i₀ i (coord_ratio i₀ i)] at h_coc
    rw [hs_zero, map_zero, mul_zero] at h_coc
    have h_field := congrArg (Y.left.germToFunctionField W0i).hom h_coc
    rw [map_zero, map_one] at h_field
    exact zero_ne_one h_field

  have hu_ne : ∀ i : Fin (N + 1), u i ≠ 0 →
      ∃ hNeW : Nonempty (W i),
        ∀ r : Fin (N + 1),
          letI := hNeW
          (Y.left.germToFunctionField (W i)).hom
            ((ι_Y.left.app (D_proj i)).hom (coord_ratio i r)) = (u i)⁻¹ * u r := by
    intro i hui
    let s_i := (ι_Y.left.app (D_proj i₀)).hom (coord_ratio i₀ i)
    have hs_ne : s_i ≠ 0 := by
      intro hs0
      apply hui
      change (Y.left.germToFunctionField (W i₀)).hom s_i = 0
      rw [hs0, map_zero]
    have hBo_ne : Y.left.basicOpen s_i ≠ ⊥ := by
      rwa [ne_eq, AlgebraicGeometry.basicOpen_eq_bot_iff]
    have hBo_nonempty : ((Y.left.basicOpen s_i : Y.left.Opens) : Set ↥Y.left).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro h_emp
      apply hBo_ne
      exact TopologicalSpace.Opens.ext h_emp
    obtain ⟨y_i, hy_i_bo⟩ := hBo_nonempty
    have hBo_le_Wi : Y.left.basicOpen s_i ≤ W i := by
      rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι_Y.left (coord_ratio i₀ i)]
      exact (TopologicalSpace.Opens.map ι_Y.left.base).monotone (hBasicLe i₀ i)
    have hy_i : y_i ∈ W i := hBo_le_Wi hy_i_bo
    have hNeW : Nonempty (W i) := ⟨⟨y_i, hy_i⟩⟩
    refine ⟨hNeW, ?_⟩
    intro r
    obtain ⟨y₂, _, hy₂_0, hy₂_i⟩ :=
      PreirreducibleSpace.isPreirreducible_univ (W i₀).1 (W i).1 (W i₀).isOpen (W i).isOpen
        ⟨y₀, trivial, hy₀⟩ ⟨y_i, trivial, hy_i⟩
    let W0i : Y.left.Opens := (TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i₀ ⊓ D_proj i)
    have hNe0i : Nonempty W0i := ⟨⟨y₂, hy₂_0, hy₂_i⟩⟩
    have h_coc := congrArg
      ((Y.left.germToFunctionField W0i).hom ∘
        (ι_Y.left.app (D_proj i₀ ⊓ D_proj i)).hom)
      (hCocycle i₀ i r)
    dsimp only [Function.comp_apply] at h_coc
    rw [map_mul, map_mul,
      h_app_res_right i₀ i (coord_ratio i r),
      h_app_res_left i₀ i (coord_ratio i₀ i),
      h_app_res_left i₀ i (coord_ratio i₀ r)] at h_coc
    have h_germ_right :
        ∀ t_sec : ↑(Y.left.presheaf.obj (Opposite.op (W i))),
          (Y.left.germToFunctionField W0i).hom
            ((Y.left.presheaf.map
              (CategoryTheory.homOfLE
                ((TopologicalSpace.Opens.map ι_Y.left.base).monotone
                  (inf_le_right : D_proj i₀ ⊓ D_proj i ≤ D_proj i))).op).hom t_sec) =
          (Y.left.germToFunctionField (W i)).hom t_sec := by
      intro t_sec
      change (Y.left.presheaf.map
          (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map ι_Y.left.base).monotone inf_le_right)).op ≫
        Y.left.germToFunctionField W0i).hom t_sec = _
      rw [TopCat.Presheaf.germ_res]
    have h_germ_left :
        ∀ t_sec : ↑(Y.left.presheaf.obj (Opposite.op (W i₀))),
          (Y.left.germToFunctionField W0i).hom
            ((Y.left.presheaf.map
              (CategoryTheory.homOfLE
                ((TopologicalSpace.Opens.map ι_Y.left.base).monotone
                  (inf_le_left : D_proj i₀ ⊓ D_proj i ≤ D_proj i₀))).op).hom t_sec) =
          (Y.left.germToFunctionField (W i₀)).hom t_sec := by
      intro t_sec
      change (Y.left.presheaf.map
          (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map ι_Y.left.base).monotone inf_le_left)).op ≫
        Y.left.germToFunctionField W0i).hom t_sec = _
      rw [TopCat.Presheaf.germ_res]
    rw [h_germ_right, h_germ_left, h_germ_left] at h_coc
    change ((Y.left.germToFunctionField (W i)).hom
      ((ι_Y.left.app (D_proj i)).hom (coord_ratio i r))) * u i = u r at h_coc
    rw [mul_comm, ← div_eq_mul_inv, eq_div_iff hui]
    exact h_coc

  exact ⟨U₀, hAffU₀, hNeU₀, φ_KL, u, i₀, D_proj, coord_ratio,
    hU₀_le, hφ_compat, hu₀, hCovD, hAffD, hAdjD, hu_zero, hu_ne⟩

theorem weil_cramer_macaulay_subalgebra_flat (N d₀ : ℕ) (hd₀ : 1 ≤ d₀)
    (K L : Type u) [Field K] [Field L] [Algebra K L]
    (u : Fin (N + 1) → L) (i₀ : Fin (N + 1)) (hu₀ : u i₀ = 1)
    (hMac_d₀ : ∀ (F : Type u) [Field F] (J : Ideal (MvPolynomial (Fin (N + 1)) F)),
      Module.finrank F
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d₀) ⧸
          (J.restrictScalars F).comap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d₀).subtype) ≤
      Module.finrank K
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀) ⧸
          ((RingHom.ker (MvPolynomial.aeval (R := K)
              (fun r : Fin (N + 1) => Polynomial.C (u r) * Polynomial.X)).toRingHom).restrictScalars K).comap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀).subtype) →
      ∀ d : ℕ, d₀ ≤ d →
        Module.finrank F
          (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d) ⧸
            (J.restrictScalars F).comap
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d).subtype) ≤
        Module.finrank K
          (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) ⧸
            ((RingHom.ker (MvPolynomial.aeval (R := K)
                (fun r : Fin (N + 1) => Polynomial.C (u r) * Polynomial.X)).toRingHom).restrictScalars K).comap
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype)) :
    ∃ (M_Pl : ℕ) (Δ : Fin (M_Pl + 1) → K) (a₀ : Fin (M_Pl + 1)),
      Δ a₀ ≠ 0 ∧
      ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra A K] [IsFractionRing A K]
          [Algebra A L] [IsScalarTower A K L],
        (∃ a₁ : Fin (M_Pl + 1), Δ a₁ ≠ 0 ∧
          ∀ a : Fin (M_Pl + 1), Δ a / Δ a₁ ∈ Set.range (algebraMap A K)) →
        ∀ i : Fin (N + 1), u i ≠ 0 →
          Module.Flat A ↥(Algebra.adjoin A (Set.range (fun r : Fin (N + 1) => (u i)⁻¹ * u r))) :=
by
  classical
  have _ := hu₀
  
  let Mon (d : ℕ) := { m : Fin (N + 1) → Fin (d + 1) // ∑ r : Fin (N + 1), (m r : ℕ) = d }
  let toFinsupp (d : ℕ) (m : Mon d) : Fin (N + 1) →₀ ℕ :=
    Finsupp.equivFunOnFinite.symm (fun r => (m.1 r : ℕ))
  have hToFinsupp_inj (d : ℕ) : Function.Injective (toFinsupp d) := by
    intro m₁ m₂ h
    apply Subtype.ext; funext r; apply Fin.ext
    exact congrArg (fun f : Fin (N + 1) →₀ ℕ => f r) h
  have hToFinsupp_deg (d : ℕ) (m : Mon d) : Finsupp.degree (toFinsupp d m) = d := by
    rw [Finsupp.degree_eq_sum]
    exact m.2
  have hExistsMon (d : ℕ) (s : Fin (N + 1) →₀ ℕ) (hs : Finsupp.degree s = d) :
      ∃ m : Mon d, toFinsupp d m = s := by
    rw [Finsupp.degree_eq_sum] at hs
    have h_lt : ∀ r : Fin (N + 1), s r < d + 1 := by
      intro r
      have h_le : s r ≤ ∑ i : Fin (N + 1), s i :=
        Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ r)
      omega
    refine ⟨⟨fun r => ⟨s r, h_lt r⟩, hs⟩, ?_⟩
    ext r
    rfl
  have hHomogCompEq : ∀ {R : Type u} [CommSemiring R] (d : ℕ)
      (P : MvPolynomial (Fin (N + 1)) R),
      MvPolynomial.homogeneousComponent d P =
        ∑ m : Mon d, MvPolynomial.monomial (toFinsupp d m) (P.coeff (toFinsupp d m)) := by
    intro R _ d P
    ext s
    rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_sum]
    simp_rw [MvPolynomial.coeff_monomial]
    split_ifs with hs
    · obtain ⟨m₀, rfl⟩ := hExistsMon d s hs
      have h_eq : ∀ m : Mon d,
          (if toFinsupp d m = toFinsupp d m₀ then P.coeff (toFinsupp d m) else 0) =
            if m = m₀ then P.coeff (toFinsupp d m₀) else 0 := by
        intro m
        split_ifs with h₁ h₂ h₃
        · rw [h₁]
        · exact absurd (hToFinsupp_inj d h₁) h₂
        · subst h₃; exact absurd rfl h₁
        · rfl
      simp_rw [h_eq]
      rw [Finset.sum_ite_eq' Finset.univ m₀]
      simp
    · symm
      apply Finset.sum_eq_zero
      intro m _
      split_ifs with h_eq
      · exact absurd (h_eq ▸ hToFinsupp_deg d m) hs
      · rfl
  let X_mon (R : Type u) [CommSemiring R] (d : ℕ) (m : Mon d) : MvPolynomial (Fin (N + 1)) R :=
    MvPolynomial.monomial (toFinsupp d m) (1 : R)
  have hX_mon_mem : ∀ (R : Type u) [CommSemiring R] (d : ℕ) (m : Mon d),
      X_mon R d m ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R d := by
    intro R _ d m
    rw [MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.isHomogeneous_monomial 1 (hToFinsupp_deg d m)
  let u_mon (d : ℕ) (m : Mon d) : L := ∏ r : Fin (N + 1), (u r) ^ (m.1 r : ℕ)
  have hAeval_X_mon : ∀ (R : Type u) [CommSemiring R] [Algebra R L] (d : ℕ) (m : Mon d),
      MvPolynomial.aeval (R := R) u (X_mon R d m) = u_mon d m := by
    intro R _ _ d m
    rw [MvPolynomial.aeval_monomial, map_one, one_mul]
    exact Finsupp.prod_fintype (toFinsupp d m) (fun r k => (u r) ^ k) (fun r => pow_zero (u r))
  have hAeval_homogComp : ∀ (R : Type u) [CommSemiring R] [Algebra R L] (d : ℕ)
      (P : MvPolynomial (Fin (N + 1)) R),
      MvPolynomial.aeval (R := R) u (MvPolynomial.homogeneousComponent d P) =
        ∑ m : Mon d, (P.coeff (toFinsupp d m)) • u_mon d m := by
    intro R _ _ d P
    conv_lhs => rw [hHomogCompEq d P]
    rw [map_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    have h_smul : MvPolynomial.monomial (toFinsupp d m) (P.coeff (toFinsupp d m)) =
        (P.coeff (toFinsupp d m)) • X_mon R d m := by
      dsimp [X_mon]
      rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [h_smul, map_smul, hAeval_X_mon R d m]
  let M_eval (R : Type u) [CommSemiring R] [Algebra R L] (d : ℕ) : Submodule R L :=
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R d).map
      (MvPolynomial.aeval (R := R) u).toLinearMap
  have hMeval_eq_span : ∀ (R : Type u) [CommSemiring R] [Algebra R L] (d : ℕ),
      M_eval R d = Submodule.span R (Set.range (u_mon d)) := by
    intro R _ _ d
    apply le_antisymm
    · rintro y ⟨P, hP, rfl⟩
      have hP_eq : MvPolynomial.homogeneousComponent d P = P := by
        simpa using MvPolynomial.homogeneousComponent_of_mem (m := d) hP
      change MvPolynomial.aeval (R := R) u P ∈ _
      rw [← hP_eq, hAeval_homogComp R d P]
      exact Submodule.sum_mem _ (fun m _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨m, rfl⟩))
    · rw [Submodule.span_le]
      rintro _ ⟨m, rfl⟩
      exact ⟨X_mon R d m, hX_mon_mem R d m, hAeval_X_mon R d m⟩
  have hMap_homogComp : ∀ {R₁ R₂ : Type u} [CommSemiring R₁] [CommSemiring R₂]
      (φ : R₁ →+* R₂) (d : ℕ) (P : MvPolynomial (Fin (N + 1)) R₁),
      MvPolynomial.map φ (MvPolynomial.homogeneousComponent d P) =
        MvPolynomial.homogeneousComponent d (MvPolynomial.map φ P) := by
    intro R₁ R₂ _ _ φ d P
    ext s
    simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
    split_ifs <;> simp

  
  let Ψ_K : MvPolynomial (Fin (N + 1)) K →ₐ[K] Polynomial L :=
    MvPolynomial.aeval (R := K) (fun r : Fin (N + 1) => Polynomial.C (u r) * Polynomial.X)
  let I_η : Ideal (MvPolynomial (Fin (N + 1)) K) := RingHom.ker Ψ_K.toRingHom
  have hΨ_X_mon : ∀ (d : ℕ) (m : Mon d),
      Ψ_K (X_mon K d m) = Polynomial.monomial d (u_mon d m) := by
    intro d m
    dsimp [Ψ_K, X_mon]
    rw [MvPolynomial.aeval_monomial, map_one, one_mul,
      Finsupp.prod_fintype (toFinsupp d m) _ (fun _ => pow_zero _)]
    change (∏ r : Fin (N + 1), (Polynomial.C (u r) * Polynomial.X) ^ (m.1 r : ℕ)) =
      Polynomial.monomial d (u_mon d m)
    have h_prod : (∏ r : Fin (N + 1), (Polynomial.C (u r) * Polynomial.X) ^ (m.1 r : ℕ)) =
        (∏ r : Fin (N + 1), Polynomial.C ((u r) ^ (m.1 r : ℕ))) *
          (∏ r : Fin (N + 1), (Polynomial.X : Polynomial L) ^ (m.1 r : ℕ)) := by
      rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun r _ => ?_)
      rw [mul_pow, Polynomial.C_pow]
    rw [h_prod, ← map_prod, Finset.prod_pow_eq_pow_sum, m.2, Polynomial.C_mul_X_pow_eq_monomial]
  have hΨ_homogComp : ∀ (d : ℕ) (G : MvPolynomial (Fin (N + 1)) K),
      Ψ_K (MvPolynomial.homogeneousComponent d G) =
        Polynomial.monomial d (MvPolynomial.aeval (R := K) u (MvPolynomial.homogeneousComponent d G)) := by
    intro d G
    rw [hAeval_homogComp K d G]
    conv_lhs => rw [hHomogCompEq d G]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    have h_smul : MvPolynomial.monomial (toFinsupp d m) (G.coeff (toFinsupp d m)) =
        (G.coeff (toFinsupp d m)) • X_mon K d m := by
      dsimp [X_mon]
      rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [h_smul, map_smul, hΨ_X_mon d m]
    ext k
    simp only [Polynomial.coeff_smul, Polynomial.coeff_monomial]
    split_ifs <;> simp
  have hΨ_coeff : ∀ (d : ℕ) (G : MvPolynomial (Fin (N + 1)) K),
      (Ψ_K G).coeff d = MvPolynomial.aeval (R := K) u (MvPolynomial.homogeneousComponent d G) := by
    intro d G
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent G]
    rw [map_sum, Polynomial.finsetSum_coeff]
    simp_rw [hΨ_homogComp, Polynomial.coeff_monomial]
    by_cases hd : d < G.totalDegree + 1
    · have hmem : d ∈ Finset.range (G.totalDegree + 1) := Finset.mem_range.mpr hd
      simp [hmem]
    · have h_zero : Finset.sum (Finset.range (G.totalDegree + 1))
          (fun i => if i = d then MvPolynomial.aeval (R := K) u (MvPolynomial.homogeneousComponent i G) else 0) = 0 := by
        apply Finset.sum_eq_zero
        intro i hi
        have hi' : i < G.totalDegree + 1 := Finset.mem_range.mp hi
        split_ifs with hid
        · omega
        · rfl
      rw [h_zero, MvPolynomial.homogeneousComponent_eq_zero d G (by omega), map_zero]
  have hMem_Iη_homog : ∀ {d : ℕ} {F : MvPolynomial (Fin (N + 1)) K},
      F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d →
        (F ∈ I_η ↔ MvPolynomial.aeval (R := K) u F = 0) := by
    intro d F hF
    have hF_eq : MvPolynomial.homogeneousComponent d F = F := by
      simpa using MvPolynomial.homogeneousComponent_of_mem (m := d) hF
    constructor
    · intro hKer
      change Ψ_K F = 0 at hKer
      have hc := hΨ_coeff d F
      rw [hKer, Polynomial.coeff_zero, hF_eq] at hc
      exact hc.symm
    · intro hEv
      change Ψ_K F = 0
      rw [← hF_eq, hΨ_homogComp d F, hF_eq, hEv, map_zero]
  have hFinrank_K : ∀ d : ℕ,
      Module.finrank K
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) ⧸
          (I_η.restrictScalars K).comap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype) =
        Module.finrank K ↥(M_eval K d) := by
    intro d
    let ev_Kd : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) →ₗ[K] L :=
      (MvPolynomial.aeval (R := K) u).toLinearMap.comp
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype
    have hKer_eq : LinearMap.ker ev_Kd =
        (I_η.restrictScalars K).comap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype := by
      ext x
      exact (hMem_Iη_homog x.2).symm
    have hRange_eq : LinearMap.range ev_Kd = M_eval K d := by
      rw [LinearMap.range_comp, Submodule.range_subtype]
    have hEquiv := LinearEquiv.finrank_eq ev_Kd.quotKerEquivRange
    rwa [hKer_eq, hRange_eq] at hEquiv

  
  let S₀ : Submodule K L := Submodule.span K (Set.range (u_mon d₀))
  have hMeval_S₀ : M_eval K d₀ = S₀ := hMeval_eq_span K d₀
  have hFin_S₀ : Module.Finite K ↥S₀ := Module.Finite.span_of_finite K (Set.toFinite _)
  let r₀ : ℕ := Module.finrank K ↥S₀
  obtain ⟨f₀, hf₀_mem, hf₀_span, hf₀_li⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq K (Set.range (u_mon d₀))
  let τ₀ : Fin r₀ → Mon d₀ := fun j => Classical.choose (hf₀_mem j)
  have hτ₀ : ∀ j : Fin r₀, u_mon d₀ (τ₀ j) = f₀ j :=
    fun j => Classical.choose_spec (hf₀_mem j)
  let b₀_vec : Fin r₀ → ↥S₀ := fun j => ⟨u_mon d₀ (τ₀ j), Submodule.subset_span ⟨τ₀ j, rfl⟩⟩
  have hComp_b₀ : S₀.subtype ∘ b₀_vec = f₀ := by
    funext j
    exact hτ₀ j
  have hLI_b₀ : LinearIndependent K b₀_vec := by
    apply LinearIndependent.of_comp S₀.subtype
    rwa [hComp_b₀]
  have hSpan_b₀ : (⊤ : Submodule K ↥S₀) ≤ Submodule.span K (Set.range b₀_vec) := by
    have hMap_eq : (Submodule.span K (Set.range b₀_vec)).map S₀.subtype =
        (⊤ : Submodule K ↥S₀).map S₀.subtype := by
      rw [Submodule.map_span, ← Set.range_comp, hComp_b₀, hf₀_span, Submodule.map_top,
        Submodule.range_subtype]
    exact (Submodule.map_injective_of_injective S₀.injective_subtype hMap_eq).ge
  let b₀ : Module.Basis (Fin r₀) K ↥S₀ := Module.Basis.mk hLI_b₀ hSpan_b₀
  have hb₀_coe : ∀ j : Fin r₀, (b₀ j : L) = u_mon d₀ (τ₀ j) := by
    intro j
    simp [b₀, b₀_vec]
  let M_mat : Matrix (Fin r₀) (Mon d₀) K :=
    fun j m => b₀.repr ⟨u_mon d₀ m, Submodule.subset_span ⟨m, rfl⟩⟩ j
  have hM_sum : ∀ m : Mon d₀, ∑ j : Fin r₀, M_mat j m • u_mon d₀ (τ₀ j) = u_mon d₀ m := by
    intro m
    have h_repr := congrArg Subtype.val (b₀.sum_repr ⟨u_mon d₀ m, Submodule.subset_span ⟨m, rfl⟩⟩)
    rw [AddSubmonoidClass.coe_finsetSum] at h_repr
    simpa [M_mat, hb₀_coe] using h_repr
  have hM_sub_τ₀ : M_mat.submatrix id τ₀ = (1 : Matrix (Fin r₀) (Fin r₀) K) := by
    ext j l
    change b₀.repr ⟨u_mon d₀ (τ₀ l), Submodule.subset_span ⟨τ₀ l, rfl⟩⟩ j =
      (1 : Matrix (Fin r₀) (Fin r₀) K) j l
    rw [Matrix.one_apply]
    have h_eq : (⟨u_mon d₀ (τ₀ l), Submodule.subset_span ⟨τ₀ l, rfl⟩⟩ : ↥S₀) = b₀ l :=
      Subtype.ext (hb₀_coe l).symm
    rw [h_eq, b₀.repr_self, Finsupp.single_apply]
    by_cases hjl : j = l
    · subst hjl; simp
    · have hlj : l ≠ j := Ne.symm hjl
      simp [hjl, hlj]
  let m_base : Mon d₀ :=
    ⟨fun r => if r = 0 then ⟨d₀, Nat.lt_succ_self d₀⟩ else ⟨0, Nat.zero_lt_succ d₀⟩, by
      simp_rw [apply_ite Fin.val]
      simp⟩
  have : Nonempty (Fin r₀ → Mon d₀) := ⟨fun _ => m_base⟩
  have hCard_pos : 1 ≤ Fintype.card (Fin r₀ → Mon d₀) := Fintype.card_pos
  let M_Pl : ℕ := Fintype.card (Fin r₀ → Mon d₀) - 1
  have hCard_eq : Fintype.card (Fin r₀ → Mon d₀) = M_Pl + 1 :=
    (Nat.sub_add_cancel hCard_pos).symm
  let e_Pl : Fin (M_Pl + 1) ≃ (Fin r₀ → Mon d₀) := (Fintype.equivFinOfCardEq hCard_eq).symm
  let Δ : Fin (M_Pl + 1) → K := fun a => (M_mat.submatrix id (e_Pl a)).det
  let a₀ : Fin (M_Pl + 1) := e_Pl.symm τ₀
  have hΔ₀ : Δ a₀ ≠ 0 := by
    dsimp [Δ, a₀]
    rw [Equiv.apply_symm_apply, hM_sub_τ₀, Matrix.det_one]
    exact one_ne_zero

  refine ⟨M_Pl, Δ, a₀, hΔ₀, ?_⟩
  intro A _ _ _ _ _ _ ⟨a₁, hΔ₁, hRatio⟩ i hui
  let τ₁ : Fin r₀ → Mon d₀ := e_Pl a₁
  let P₁ : Matrix (Fin r₀) (Fin r₀) K := M_mat.submatrix id τ₁
  have hP₁_det : P₁.det = Δ a₁ := rfl
  let M_tilde : Matrix (Fin r₀) (Mon d₀) K := (Δ a₁)⁻¹ • (P₁.adjugate * M_mat)
  have hP₁_mul : P₁ * M_tilde = M_mat := by
    dsimp [M_tilde]
    rw [Matrix.mul_smul, ← Matrix.mul_assoc, Matrix.mul_adjugate, hP₁_det,
      Matrix.smul_mul, Matrix.one_mul, smul_smul, inv_mul_cancel₀ hΔ₁, one_smul]
  have hM_tilde_mem : ∀ (l : Fin r₀) (m : Mon d₀),
      M_tilde l m ∈ Set.range (algebraMap A K) := by
    intro l m
    have h_adj : (P₁.adjugate * M_mat) l m = Δ (e_Pl.symm (Function.update τ₁ l m)) := by
      change P₁.adjugate.mulVec (fun j => M_mat j m) l = _
      rw [← Matrix.cramer_eq_adjugate_mulVec, Matrix.cramer_apply]
      have h_upd : P₁.updateCol l (fun j => M_mat j m) =
          M_mat.submatrix id (Function.update τ₁ l m) := by
        ext j c
        by_cases hc : c = l <;> simp [P₁, hc]
      rw [h_upd]
      simp [Δ]
    have h_eq : M_tilde l m = Δ (e_Pl.symm (Function.update τ₁ l m)) / Δ a₁ := by
      change (Δ a₁)⁻¹ * ((P₁.adjugate * M_mat) l m) = _
      rw [h_adj, inv_mul_eq_div]
    rw [h_eq]
    exact hRatio (e_Pl.symm (Function.update τ₁ l m))
  let α : Fin r₀ → Mon d₀ → A := fun l m => Classical.choose (hM_tilde_mem l m)
  have hα : ∀ (l : Fin r₀) (m : Mon d₀), algebraMap A K (α l m) = M_tilde l m :=
    fun l m => Classical.choose_spec (hM_tilde_mem l m)
  have hCramer_eval : ∀ μ : Mon d₀, u_mon d₀ μ = ∑ l : Fin r₀, (α l μ) • u_mon d₀ (τ₁ l) := by
    intro μ
    calc u_mon d₀ μ
        = ∑ j : Fin r₀, M_mat j μ • u_mon d₀ (τ₀ j) := (hM_sum μ).symm
      _ = ∑ j : Fin r₀, (∑ l : Fin r₀, P₁ j l * M_tilde l μ) • u_mon d₀ (τ₀ j) := by
            simp_rw [← hP₁_mul, Matrix.mul_apply]
      _ = ∑ j : Fin r₀, ∑ l : Fin r₀, M_tilde l μ • (P₁ j l • u_mon d₀ (τ₀ j)) := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Finset.sum_smul]
            refine Finset.sum_congr rfl (fun l _ => ?_)
            rw [mul_comm (P₁ j l), mul_smul]
      _ = ∑ l : Fin r₀, M_tilde l μ • (∑ j : Fin r₀, M_mat j (τ₁ l) • u_mon d₀ (τ₀ j)) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun l _ => ?_)
            rw [Finset.smul_sum]
            rfl
      _ = ∑ l : Fin r₀, M_tilde l μ • u_mon d₀ (τ₁ l) := by
            simp_rw [hM_sum]
      _ = ∑ l : Fin r₀, (α l μ) • u_mon d₀ (τ₁ l) := by
            refine Finset.sum_congr rfl (fun l _ => ?_)
            rw [← hα l μ, algebraMap_smul]

  
  have hFlat_deg : ∀ d : ℕ, d₀ ≤ d → Module.Flat A ↥(M_eval A d) := by
    intro d hd
    apply Module.flat_of_localized_maximal
    intro m_id hMax_m
    have : m_id.IsMaximal := hMax_m

    
    have hSandwich : ∀ (κ : Type u) [Field κ] [Algebra A κ]
        [Module κ (↥(M_eval A d) ⧸ (m_id • (⊤ : Submodule A ↥(M_eval A d))))]
        [IsScalarTower A κ (↥(M_eval A d) ⧸ (m_id • (⊤ : Submodule A ↥(M_eval A d))))],
        Function.Surjective (algebraMap A κ) →
        Module.finrank κ
          (↥(M_eval A d) ⧸ (m_id • (⊤ : Submodule A ↥(M_eval A d)))) ≤
          Module.finrank K ↥(M_eval K d) := by
      intro κ _ _ _ _ hSurj_κ
      let ι_AK : MvPolynomial (Fin (N + 1)) A →+* MvPolynomial (Fin (N + 1)) K :=
        MvPolynomial.map (algebraMap A K)
      let π_m : MvPolynomial (Fin (N + 1)) A →+* MvPolynomial (Fin (N + 1)) κ :=
        MvPolynomial.map (algebraMap A κ)
      let I_A : Ideal (MvPolynomial (Fin (N + 1)) A) := I_η.comap ι_AK
      let J_m : Ideal (MvPolynomial (Fin (N + 1)) κ) := Ideal.map π_m I_A
      let K_md₀ : Submodule κ
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀) :=
        (J_m.restrictScalars κ).comap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀).subtype
      let Q_md₀ := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀) ⧸ K_md₀
      let q₀ : Fin r₀ → Q_md₀ :=
        fun l => K_md₀.mkQ ⟨X_mon κ d₀ (τ₁ l), hX_mon_mem κ d₀ (τ₁ l)⟩
      have hSpan_q₀ : Submodule.span κ (Set.range q₀) = ⊤ := by
        rw [eq_top_iff]
        intro z _
        obtain ⟨g, rfl⟩ := K_md₀.mkQ_surjective z
        have hg_eq : g = ∑ μ : Mon d₀,
            (g.1.coeff (toFinsupp d₀ μ)) •
              (⟨X_mon κ d₀ μ, hX_mon_mem κ d₀ μ⟩ :
                ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀)) := by
          apply Subtype.ext
          rw [AddSubmonoidClass.coe_finsetSum]
          have hg_hom : MvPolynomial.homogeneousComponent d₀ g.1 = g.1 := by
            simpa using MvPolynomial.homogeneousComponent_of_mem (m := d₀) g.2
          conv_lhs => rw [← hg_hom, hHomogCompEq d₀ g.1]
          refine Finset.sum_congr rfl (fun μ _ => ?_)
          change MvPolynomial.monomial (toFinsupp d₀ μ) (g.1.coeff (toFinsupp d₀ μ)) =
            (g.1.coeff (toFinsupp d₀ μ)) • X_mon κ d₀ μ
          dsimp [X_mon]
          rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
        rw [hg_eq, map_sum]
        refine Submodule.sum_mem _ (fun μ _ => ?_)
        rw [map_smul]
        refine Submodule.smul_mem _ _ ?_
        let R_μ : MvPolynomial (Fin (N + 1)) A :=
          X_mon A d₀ μ - ∑ l : Fin r₀, (α l μ) • X_mon A d₀ (τ₁ l)
        have hR_IA : R_μ ∈ I_A := by
          have hι_mem : ι_AK R_μ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀ := by
            dsimp [R_μ, ι_AK]
            rw [map_sub, map_sum]
            refine Submodule.sub_mem _ ?_ (Submodule.sum_mem _ (fun l _ => ?_))
            · dsimp [X_mon]; rw [MvPolynomial.map_monomial, map_one]; exact hX_mon_mem K d₀ μ
            · dsimp [X_mon]
              rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one, MvPolynomial.map_monomial]
              have h_sm : MvPolynomial.monomial (toFinsupp d₀ (τ₁ l)) (algebraMap A K (α l μ)) =
                  (algebraMap A K (α l μ)) • X_mon K d₀ (τ₁ l) := by
                dsimp [X_mon]
                rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
              rw [h_sm]
              exact Submodule.smul_mem _ _ (hX_mon_mem K d₀ (τ₁ l))
          change ι_AK R_μ ∈ I_η
          rw [hMem_Iη_homog hι_mem]
          change MvPolynomial.aeval (R := K) u (MvPolynomial.map (algebraMap A K) R_μ) = 0
          rw [MvPolynomial.aeval_map_algebraMap]
          dsimp [R_μ]
          rw [map_sub, map_sum]
          simp_rw [map_smul, hAeval_X_mon A d₀]
          exact sub_eq_zero.mpr (hCramer_eval μ)
        have hπR_Jm : π_m R_μ ∈ J_m := Ideal.mem_map_of_mem π_m hR_IA
        have hπR_eq : π_m R_μ =
            X_mon κ d₀ μ -
              ∑ l : Fin r₀, (algebraMap A κ (α l μ)) • X_mon κ d₀ (τ₁ l) := by
          dsimp [R_μ, π_m, X_mon]
          rw [map_sub, MvPolynomial.map_monomial, map_one, map_sum]
          congr 1
          refine Finset.sum_congr rfl (fun l _ => ?_)
          rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one, MvPolynomial.map_monomial,
            MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
        have hDiff_ker :
            (⟨X_mon κ d₀ μ, hX_mon_mem κ d₀ μ⟩ :
              ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀)) -
              ∑ l : Fin r₀, (algebraMap A κ (α l μ)) •
                ⟨X_mon κ d₀ (τ₁ l), hX_mon_mem κ d₀ (τ₁ l)⟩ ∈ K_md₀ := by
          change (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀).subtype _ ∈ J_m
          rw [map_sub, map_sum]
          simp_rw [map_smul, Submodule.subtype_apply]
          rw [← hπR_eq]
          exact hπR_Jm
        have hQuot_eq :
            K_md₀.mkQ ⟨X_mon κ d₀ μ, hX_mon_mem κ d₀ μ⟩ =
              ∑ l : Fin r₀, (algebraMap A κ (α l μ)) • q₀ l := by
          rw [← sub_eq_zero]
          have h_lhs : K_md₀.mkQ ⟨X_mon κ d₀ μ, hX_mon_mem κ d₀ μ⟩ -
              ∑ l : Fin r₀, (algebraMap A κ (α l μ)) • q₀ l =
              K_md₀.mkQ ((⟨X_mon κ d₀ μ, hX_mon_mem κ d₀ μ⟩ :
                ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d₀)) -
                ∑ l : Fin r₀, (algebraMap A κ (α l μ)) •
                  ⟨X_mon κ d₀ (τ₁ l), hX_mon_mem κ d₀ (τ₁ l)⟩) := by
            rw [map_sub, map_sum]
            simp_rw [map_smul]
            rfl
          rw [h_lhs]
          exact (Submodule.Quotient.mk_eq_zero K_md₀).mpr hDiff_ker
        rw [hQuot_eq]
        exact Submodule.sum_mem _ (fun l _ =>
          Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩))
      have h_le_d₀ : Module.finrank κ Q_md₀ ≤ r₀ := by
        have h1 : Module.finrank κ Q_md₀ =
            Module.finrank κ ↥(Submodule.span κ (Set.range q₀)) := by
          rw [hSpan_q₀, finrank_top]
        rw [h1]
        calc Module.finrank κ ↥(Submodule.span κ (Set.range q₀))
            ≤ (Set.range q₀).toFinset.card := finrank_span_le_card (Set.range q₀)
          _ ≤ Fintype.card (Fin r₀) := by rw [Set.toFinset_range]; exact Finset.card_image_le
          _ = r₀ := Fintype.card_fin r₀
      have h_le_d₀' : Module.finrank κ Q_md₀ ≤
          Module.finrank K
            (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀) ⧸
              (I_η.restrictScalars K).comap
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀).subtype) := by
        rw [hFinrank_K d₀, hMeval_S₀]
        exact h_le_d₀
      let K_md : Submodule κ
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d) :=
        (J_m.restrictScalars κ).comap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d).subtype
      let Q_Jm_d := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d) ⧸ K_md
      have hJm_le_Kd : Module.finrank κ Q_Jm_d ≤ Module.finrank K ↥(M_eval K d) := by
        rw [← hFinrank_K d]
        exact hMac_d₀ κ J_m h_le_d₀' d hd
      let N_mod_d : Submodule A ↥(M_eval A d) := m_id • (⊤ : Submodule A ↥(M_eval A d))
      let Q_mod_d := ↥(M_eval A d) ⧸ N_mod_d
      let g_Ad : Mon d → ↥(M_eval A d) := fun μ =>
        ⟨u_mon d μ, by rw [hMeval_eq_span A d]; exact Submodule.subset_span ⟨μ, rfl⟩⟩
      let ψ_d : MvPolynomial (Fin (N + 1)) κ →ₗ[κ] Q_mod_d :=
        ∑ μ : Mon d,
          (LinearMap.toSpanSingleton κ Q_mod_d (N_mod_d.mkQ (g_Ad μ))).comp
            (MvPolynomial.lcoeff κ (toFinsupp d μ))
      have hψ_map : ∀ P : MvPolynomial (Fin (N + 1)) A,
          ψ_d (π_m P) = N_mod_d.mkQ
            ⟨MvPolynomial.aeval (R := A) u (MvPolynomial.homogeneousComponent d P),
              ⟨MvPolynomial.homogeneousComponent d P, MvPolynomial.homogeneousComponent_mem d P, rfl⟩⟩ := by
        intro P
        simp only [ψ_d, LinearMap.sum_apply, LinearMap.comp_apply, MvPolynomial.lcoeff_apply,
          LinearMap.toSpanSingleton_apply, π_m, MvPolynomial.coeff_map]
        have h_each : ∀ μ : Mon d,
            (algebraMap A κ (P.coeff (toFinsupp d μ))) • N_mod_d.mkQ (g_Ad μ) =
            N_mod_d.mkQ ((P.coeff (toFinsupp d μ)) • g_Ad μ) := by
          intro μ
          rw [map_smul]
          exact IsScalarTower.algebraMap_smul κ (P.coeff (toFinsupp d μ))
            (N_mod_d.mkQ (g_Ad μ))
        simp_rw [h_each, ← map_sum]
        congr 1
        apply Subtype.ext
        rw [AddSubmonoidClass.coe_finsetSum]
        exact (hAeval_homogComp A d P).symm
      have hSurj_πm : Function.Surjective π_m :=
        MvPolynomial.map_surjective _ hSurj_κ
      let ψ_Vd : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d) →ₗ[κ] Q_mod_d :=
        ψ_d.comp (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d).subtype
      have hKer_ψVd : K_md ≤ LinearMap.ker ψ_Vd := by
        intro g hg
        change g.1 ∈ J_m at hg
        obtain ⟨P, hP_IA, hP_eq⟩ := (Ideal.mem_map_iff_of_surjective π_m hSurj_πm).mp hg
        change ψ_d g.1 = 0
        rw [← hP_eq, hψ_map P]
        have hEv_zero : MvPolynomial.aeval (R := A) u (MvPolynomial.homogeneousComponent d P) = 0 := by
          rw [← MvPolynomial.aeval_map_algebraMap K u]
          change MvPolynomial.aeval (R := K) u (ι_AK (MvPolynomial.homogeneousComponent d P)) = 0
          rw [hMap_homogComp (algebraMap A K) d P, ← hΨ_coeff d (ι_AK P)]
          have hKer_P : Ψ_K (ι_AK P) = 0 := hP_IA
          rw [hKer_P, Polynomial.coeff_zero]
        have hZero_el :
            (⟨MvPolynomial.aeval (R := A) u (MvPolynomial.homogeneousComponent d P),
              ⟨MvPolynomial.homogeneousComponent d P, MvPolynomial.homogeneousComponent_mem d P, rfl⟩⟩ :
                ↥(M_eval A d)) = 0 := Subtype.ext hEv_zero
        rw [hZero_el, map_zero]
      let Φ_d : Q_Jm_d →ₗ[κ] Q_mod_d := Submodule.liftQ K_md ψ_Vd hKer_ψVd
      have hSurj_Φd : Function.Surjective Φ_d := by
        intro z
        obtain ⟨y, rfl⟩ := N_mod_d.mkQ_surjective z
        obtain ⟨P, hP_hom, hyP⟩ := y.2
        have hP_comp : MvPolynomial.homogeneousComponent d P = P := by
          simpa using MvPolynomial.homogeneousComponent_of_mem (m := d) hP_hom
        have hπP_hom : π_m P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d := by
          have h_eq := hMap_homogComp (algebraMap A κ) d P
          rw [hP_comp] at h_eq
          change π_m P = MvPolynomial.homogeneousComponent d (π_m P) at h_eq
          rw [h_eq]
          exact MvPolynomial.homogeneousComponent_mem d (π_m P)
        refine ⟨K_md.mkQ ⟨π_m P, hπP_hom⟩, ?_⟩
        change ψ_d (π_m P) = N_mod_d.mkQ y
        rw [hψ_map P]
        congr 1
        apply Subtype.ext
        change MvPolynomial.aeval (R := A) u (MvPolynomial.homogeneousComponent d P) = y.1
        rw [hP_comp]
        exact hyP
      have hFin_Vd : Module.Finite κ
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d) := by
        let x_gen : Mon d → ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d) :=
          fun μ => ⟨X_mon κ d μ, hX_mon_mem κ d μ⟩
        have hTop_Vd : (⊤ : Submodule κ
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ d)) =
            Submodule.span κ (Set.range x_gen) := by
          symm; rw [eq_top_iff]; intro g _
          have hg_eq : g = ∑ μ : Mon d, (g.1.coeff (toFinsupp d μ)) • x_gen μ := by
            apply Subtype.ext
            rw [AddSubmonoidClass.coe_finsetSum]
            have hg_hom : MvPolynomial.homogeneousComponent d g.1 = g.1 := by
              simpa using MvPolynomial.homogeneousComponent_of_mem (m := d) g.2
            conv_lhs => rw [← hg_hom, hHomogCompEq d g.1]
            refine Finset.sum_congr rfl (fun μ _ => ?_)
            change MvPolynomial.monomial (toFinsupp d μ) (g.1.coeff (toFinsupp d μ)) =
              (g.1.coeff (toFinsupp d μ)) • X_mon κ d μ
            dsimp [X_mon]
            rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
          rw [hg_eq]
          exact Submodule.sum_mem _ (fun μ _ =>
            Submodule.smul_mem _ _ (Submodule.subset_span ⟨μ, rfl⟩))
        exact Module.Finite.of_fg_top (hTop_Vd ▸ Submodule.fg_span (Set.toFinite _))
      have hFin_QJm : Module.Finite κ Q_Jm_d :=
        Module.Finite.of_surjective _ (Submodule.mkQ_surjective K_md)
      have hMod_le_Jm : Module.finrank κ Q_mod_d ≤ Module.finrank κ Q_Jm_d := by
        have hRange : LinearMap.range Φ_d = ⊤ := LinearMap.range_eq_top.mpr hSurj_Φd
        have h_le := LinearMap.finrank_range_le Φ_d
        rwa [hRange, finrank_top] at h_le
      exact le_trans hMod_le_Jm hJm_le_Kd
    have hMod_finrank_le :
        Module.finrank (A ⧸ m_id)
          (↥(M_eval A d) ⧸ (m_id • (⊤ : Submodule A ↥(M_eval A d)))) ≤
          Module.finrank K ↥(M_eval K d) := by
      let instAlg : Algebra A (A ⧸ m_id) := inferInstance
      let instMod : Module (A ⧸ m_id) (↥(M_eval A d) ⧸ (m_id • (⊤ : Submodule A ↥(M_eval A d)))) :=
        inferInstance
      have instTow : IsScalarTower A (A ⧸ m_id)
          (↥(M_eval A d) ⧸ (m_id • (⊤ : Submodule A ↥(M_eval A d)))) := inferInstance
      exact @hSandwich (A ⧸ m_id) (Ideal.Quotient.field m_id) instAlg instMod instTow
        Ideal.Quotient.mk_surjective

    
    let A_m := Localization.AtPrime m_id
    have hUnits_mK : ∀ y : m_id.primeCompl, IsUnit (algebraMap A K y.1) := by
      intro y
      apply IsUnit.mk0
      intro h0
      have hy0 : (y : A) = 0 := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
      exact y.2 (hy0.symm ▸ m_id.zero_mem)
    let φ_mK : A_m →+* K := IsLocalization.lift (M := m_id.primeCompl) (S := A_m) hUnits_mK
    let : Algebra A_m K := φ_mK.toAlgebra
    let : Algebra A_m L := ((algebraMap K L).comp φ_mK).toAlgebra
    have : IsScalarTower A A_m K :=
      IsScalarTower.of_algebraMap_eq
        (fun a => (IsLocalization.lift_eq (M := m_id.primeCompl) hUnits_mK a).symm)
    have : IsScalarTower A_m K L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have : IsScalarTower A A_m L :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        rw [IsScalarTower.algebraMap_apply A K L a, IsScalarTower.algebraMap_apply A A_m K a]
        rfl)
    have hInj_mK : Function.Injective (algebraMap A_m K) := by
      intro z₁ z₂ hz_eq
      suffices hsub : z₁ - z₂ = 0 from sub_eq_zero.mp hsub
      have hz : algebraMap A_m K (z₁ - z₂) = 0 := by rw [map_sub, hz_eq, sub_self]
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj m_id.primeCompl (z₁ - z₂)
      dsimp only at hzs
      have h_eqK : algebraMap A_m K (z₁ - z₂) * algebraMap A K s.1 = algebraMap A K a := by
        rw [IsScalarTower.algebraMap_apply A A_m K s.1, ← map_mul, hzs,
          ← IsScalarTower.algebraMap_apply A A_m K a]
      rw [hz, zero_mul] at h_eqK
      have ha0 : a = 0 := IsFractionRing.injective A K (h_eqK.symm.trans (map_zero _).symm)
      rw [ha0, map_zero] at hzs
      let u_s := IsLocalization.map_units A_m s
      calc z₁ - z₂
          = (z₁ - z₂) * (u_s.unit.1 * ↑u_s.unit⁻¹) := by simp
        _ = ((z₁ - z₂) * algebraMap A A_m s.1) * ↑u_s.unit⁻¹ := by rw [mul_assoc]; rfl
        _ = 0 := by rw [hzs, zero_mul]
    let M_Ad : Submodule A L := M_eval A d
    let M_Kd : Submodule K L := M_eval K d
    have hMAd_eq : M_Ad = Submodule.span A (Set.range (u_mon d)) := hMeval_eq_span A d
    have hMKd_eq : M_Kd = Submodule.span K (Set.range (u_mon d)) := hMeval_eq_span K d
    let M_md : Submodule A_m L := Submodule.span A_m (Set.range (u_mon d))
    have hLe_Am : M_Ad ≤ M_md.restrictScalars A := by
      rw [hMAd_eq, Submodule.span_le]
      exact Submodule.subset_span
    have hLe_mK : M_md ≤ M_Kd.restrictScalars A_m := by
      rw [hMKd_eq, Submodule.span_le]
      exact Submodule.subset_span
    let f_m : ↥M_Ad →ₗ[A] ↥M_md :=
      { toFun := fun x => ⟨x.1, hLe_Am x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hLocMod : IsLocalizedModule m_id.primeCompl f_m := by
      refine IsLocalizedModule.mk ?_ ?_ ?_
      · intro s
        let u_s := IsLocalization.map_units A_m s
        refine ⟨⟨algebraMap A (Module.End A ↥M_md) s.1,
          (LinearMap.lsmul A_m ↥M_md ↑u_s.unit⁻¹).restrictScalars A, ?_, ?_⟩, rfl⟩
        · apply LinearMap.ext; intro y
          change s.1 • ((↑u_s.unit⁻¹ : A_m) • y) = y
          rw [← IsScalarTower.algebraMap_smul A_m s.1, smul_smul]
          change (u_s.unit.1 * ↑u_s.unit⁻¹) • y = y
          simp
        · apply LinearMap.ext; intro y
          change (↑u_s.unit⁻¹ : A_m) • (s.1 • y) = y
          rw [← IsScalarTower.algebraMap_smul A_m s.1, smul_smul]
          change (↑u_s.unit⁻¹ * u_s.unit.1) • y = y
          simp
      · intro y
        have h_surj : ∀ t ∈ M_md, ∃ (x : ↥M_Ad) (s : m_id.primeCompl), s.1 • t = x.1 := by
          intro t ht
          refine Submodule.span_induction ?_ ?_ ?_ ?_ ht
          · rintro _ ⟨μ, rfl⟩
            exact ⟨⟨u_mon d μ, by rw [hMAd_eq]; exact Submodule.subset_span ⟨μ, rfl⟩⟩, 1,
              one_smul A (u_mon d μ)⟩
          · exact ⟨0, 1, by simp⟩
          · rintro t₁ t₂ _ _ ⟨x₁, s₁, h₁⟩ ⟨x₂, s₂, h₂⟩
            refine ⟨s₂.1 • x₁ + s₁.1 • x₂, s₁ * s₂, ?_⟩
            change (s₁.1 * s₂.1) • (t₁ + t₂) = s₂.1 • x₁.1 + s₁.1 • x₂.1
            rw [smul_add, mul_comm s₁.1 s₂.1, mul_smul, h₁, mul_comm s₂.1 s₁.1, mul_smul, h₂]
          · rintro z t₁ _ ⟨x₁, s₁, h₁⟩
            obtain ⟨⟨a, s₀⟩, hzs⟩ := IsLocalization.surj m_id.primeCompl z
            dsimp only at hzs
            refine ⟨a • x₁, s₀ * s₁, ?_⟩
            change (s₀.1 * s₁.1) • (z • t₁) = a • x₁.1
            rw [mul_smul, smul_comm s₁.1 z t₁, h₁, ← IsScalarTower.algebraMap_smul A_m s₀.1,
              smul_smul, mul_comm (algebraMap A A_m s₀.1) z, hzs, IsScalarTower.algebraMap_smul]
        obtain ⟨x, s, hp⟩ := h_surj y.1 y.2
        exact ⟨(x, s), Subtype.ext hp⟩
      · intro x₁ x₂ h
        refine ⟨1, ?_⟩
        have hx : x₁ = x₂ := Subtype.ext (congrArg (fun z : ↥M_md => z.1) h)
        rw [hx]

    
    have hFlat_Am : Module.Flat A_m ↥M_md := by
      let : Field (A ⧸ m_id) := Ideal.Quotient.field m_id
      let N_mod_d : Submodule A ↥M_Ad := m_id • (⊤ : Submodule A ↥M_Ad)
      let Q_mod_d := ↥M_Ad ⧸ N_mod_d
      have : Module.Finite A ↥M_Ad := by
        rw [hMAd_eq]
        exact Module.Finite.span_of_finite A (Set.toFinite _)
      have : Module.Finite A Q_mod_d :=
        Module.Finite.of_surjective _ (Submodule.mkQ_surjective N_mod_d)
      have : Module.Finite (A ⧸ m_id) Q_mod_d :=
        Module.Finite.of_restrictScalars_finite A (A ⧸ m_id) Q_mod_d
      have : Module.Finite A_m ↥M_md := Module.Finite.span_of_finite A_m (Set.toFinite _)
      have : Module.Finite K ↥M_Kd := by
        rw [hMKd_eq]
        exact Module.Finite.span_of_finite K (Set.toFinite _)
      let r := Module.finrank (A ⧸ m_id) Q_mod_d
      let b_mod : Module.Basis (Fin r) (A ⧸ m_id) Q_mod_d := Module.finBasis (A ⧸ m_id) Q_mod_d
      let w_A : Fin r → ↥M_Ad :=
        fun j => Classical.choose (N_mod_d.mkQ_surjective (b_mod j))
      have hw_A : ∀ j : Fin r, N_mod_d.mkQ (w_A j) = b_mod j :=
        fun j => Classical.choose_spec (N_mod_d.mkQ_surjective (b_mod j))
      let w_m : Fin r → ↥M_md := fun j => f_m (w_A j)
      let W_m : Submodule A_m ↥M_md := Submodule.span A_m (Set.range w_m)
      have hMap_Nmod : ∀ x ∈ N_mod_d,
          f_m x ∈ (IsLocalRing.maximalIdeal A_m) • (⊤ : Submodule A_m ↥M_md) := by
        intro x hx
        refine Submodule.smul_induction_on hx ?_ (fun _ _ => add_mem)
        intro t ht y _
        rw [map_smul, ← IsScalarTower.algebraMap_smul A_m t]
        have ht_max : algebraMap A A_m t ∈ IsLocalRing.maximalIdeal A_m := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
            IsLocalization.AtPrime.isUnit_to_map_iff A_m m_id t]
          exact fun h => h ht
        exact Submodule.smul_mem_smul ht_max Submodule.mem_top
      have hGen_in_sup : ∀ μ : Mon d,
          (⟨u_mon d μ, Submodule.subset_span ⟨μ, rfl⟩⟩ : ↥M_md) ∈
            W_m ⊔ (IsLocalRing.maximalIdeal A_m) • (⊤ : Submodule A_m ↥M_md) := by
        intro μ
        let g_A : ↥M_Ad := ⟨u_mon d μ, by rw [hMAd_eq]; exact Submodule.subset_span ⟨μ, rfl⟩⟩
        let c_fn : Fin r → (A ⧸ m_id) := fun j => b_mod.repr (N_mod_d.mkQ g_A) j
        let a_fn : Fin r → A := fun j => Classical.choose (Ideal.Quotient.mk_surjective (c_fn j))
        have ha_fn : ∀ j : Fin r, Ideal.Quotient.mk m_id (a_fn j) = c_fn j :=
          fun j => Classical.choose_spec (Ideal.Quotient.mk_surjective (c_fn j))
        have hRem_mem : g_A - ∑ j : Fin r, a_fn j • w_A j ∈ N_mod_d := by
          rw [← Submodule.Quotient.mk_eq_zero]
          change N_mod_d.mkQ (g_A - ∑ j : Fin r, a_fn j • w_A j) = 0
          rw [map_sub, map_sum]
          have h_sum_eq : (∑ j : Fin r, N_mod_d.mkQ (a_fn j • w_A j)) = N_mod_d.mkQ g_A := by
            calc (∑ j : Fin r, N_mod_d.mkQ (a_fn j • w_A j))
                = ∑ j : Fin r, c_fn j • b_mod j := by
                    refine Finset.sum_congr rfl (fun j _ => ?_)
                    rw [map_smul, ← IsScalarTower.algebraMap_smul (A ⧸ m_id) (a_fn j)]
                    change Ideal.Quotient.mk m_id (a_fn j) • N_mod_d.mkQ (w_A j) = _
                    rw [ha_fn j, hw_A j]
              _ = N_mod_d.mkQ g_A := b_mod.sum_repr (N_mod_d.mkQ g_A)
          rw [h_sum_eq, sub_self]
        have h_decomp : (⟨u_mon d μ, Submodule.subset_span ⟨μ, rfl⟩⟩ : ↥M_md) =
            f_m (∑ j : Fin r, a_fn j • w_A j) + f_m (g_A - ∑ j : Fin r, a_fn j • w_A j) := by
          rw [← map_add, add_sub_cancel]
          rfl
        rw [h_decomp]
        refine Submodule.add_mem_sup ?_ (hMap_Nmod _ hRem_mem)
        rw [map_sum]
        refine Submodule.sum_mem _ (fun j _ => ?_)
        rw [map_smul, ← IsScalarTower.algebraMap_smul A_m (a_fn j)]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
      have hTop_le_sup : (⊤ : Submodule A_m ↥M_md) ≤
          W_m ⊔ (IsLocalRing.maximalIdeal A_m) • (⊤ : Submodule A_m ↥M_md) := by
        intro y _
        have h_ind : ∀ t (ht : t ∈ M_md),
            (⟨t, ht⟩ : ↥M_md) ∈
              W_m ⊔ (IsLocalRing.maximalIdeal A_m) • (⊤ : Submodule A_m ↥M_md) := by
          intro t ht
          refine Submodule.span_induction ?_ ?_ ?_ ?_ ht
          · rintro _ ⟨μ, rfl⟩
            exact hGen_in_sup μ
          · exact zero_mem _
          · intro t₁ t₂ ht₁ ht₂ h₁ h₂
            exact add_mem h₁ h₂
          · intro z t₁ ht₁ h₁
            exact Submodule.smul_mem _ z h₁
        exact h_ind y.1 y.2
      have hTop_le_Wm : (⊤ : Submodule A_m ↥M_md) ≤ W_m :=
        Submodule.le_of_le_smul_of_le_jacobson_bot
          Module.Finite.fg_top (IsLocalRing.maximalIdeal_le_jacobson ⊥) hTop_le_sup
      let w_K : Fin r → ↥M_Kd := fun j => ⟨(w_m j).1, hLe_mK (w_m j).2⟩
      have hTop_le_wK : (⊤ : Submodule K ↥M_Kd) ≤ Submodule.span K (Set.range w_K) := by
        have hGen_wK : ∀ μ : Mon d,
            (⟨u_mon d μ, by rw [hMKd_eq]; exact Submodule.subset_span ⟨μ, rfl⟩⟩ : ↥M_Kd) ∈
              Submodule.span K (Set.range w_K) := by
          intro μ
          have h_in_Wm : (⟨u_mon d μ, Submodule.subset_span ⟨μ, rfl⟩⟩ : ↥M_md) ∈ W_m :=
            hTop_le_Wm Submodule.mem_top
          have h_push : ∀ x : ↥M_md, x ∈ W_m →
              (⟨x.1, hLe_mK x.2⟩ : ↥M_Kd) ∈ Submodule.span K (Set.range w_K) := by
            intro x hx
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
            · rintro _ ⟨j, rfl⟩
              exact Submodule.subset_span ⟨j, rfl⟩
            · exact zero_mem _
            · intro x₁ x₂ _ _ h₁ h₂
              exact add_mem h₁ h₂
            · intro z x₁ _ h₁
              have h_sm : (⟨(z • x₁).1, hLe_mK (z • x₁).2⟩ : ↥M_Kd) =
                  (algebraMap A_m K z) • ⟨x₁.1, hLe_mK x₁.2⟩ := by
                apply Subtype.ext
                exact (IsScalarTower.algebraMap_smul K z x₁.1).symm
              rw [h_sm]
              exact Submodule.smul_mem _ _ h₁
          exact h_push _ h_in_Wm
        intro y _
        have hy_span : y.1 ∈ Submodule.span K (Set.range (u_mon d)) := by
          rw [← hMKd_eq]
          exact y.2
        have h_ind_K : ∀ t (ht : t ∈ Submodule.span K (Set.range (u_mon d))),
            (⟨t, by rwa [hMKd_eq]⟩ : ↥M_Kd) ∈ Submodule.span K (Set.range w_K) := by
          intro t ht
          refine Submodule.span_induction ?_ ?_ ?_ ?_ ht
          · rintro _ ⟨μ, rfl⟩
            exact hGen_wK μ
          · exact zero_mem _
          · intro t₁ t₂ _ _ h₁ h₂
            exact add_mem h₁ h₂
          · intro c t₁ _ h₁
            exact Submodule.smul_mem _ c h₁
        exact h_ind_K y.1 hy_span
      have hKd_le_r : Module.finrank K ↥M_Kd ≤ r := by
        have h1 : Module.finrank K ↥M_Kd =
            Module.finrank K ↥(Submodule.span K (Set.range w_K)) := by
          rw [top_unique hTop_le_wK, finrank_top]
        rw [h1]
        calc Module.finrank K ↥(Submodule.span K (Set.range w_K))
            ≤ (Set.range w_K).toFinset.card := finrank_span_le_card (Set.range w_K)
          _ ≤ Fintype.card (Fin r) := by rw [Set.toFinset_range]; exact Finset.card_image_le
          _ = r := Fintype.card_fin r
      have hCard_r : Fintype.card (Fin r) = Module.finrank K ↥M_Kd := by
        rw [Fintype.card_fin]
        exact le_antisymm hMod_finrank_le hKd_le_r
      have hLI_wK : LinearIndependent K w_K :=
        linearIndependent_of_top_le_span_of_card_eq_finrank hTop_le_wK hCard_r
      have hLI_wm : LinearIndependent A_m w_m := by
        rw [Fintype.linearIndependent_iff] at hLI_wK ⊢
        intro c hc j
        apply hInj_mK
        rw [map_zero]
        refine hLI_wK (fun l => algebraMap A_m K (c l)) ?_ j
        apply Subtype.ext
        rw [AddSubmonoidClass.coe_finsetSum]
        have hc_val := congrArg Subtype.val hc
        rw [AddSubmonoidClass.coe_finsetSum] at hc_val
        simpa [w_K, IsScalarTower.algebraMap_smul] using hc_val
      let b_m : Module.Basis (Fin r) A_m ↥M_md := Module.Basis.mk hLI_wm hTop_le_Wm
      have : Module.Free A_m ↥M_md := Module.Free.of_basis b_m
      exact Module.Flat.of_free

    have : Module.Flat A ↥M_md :=
      (Module.flat_iff_of_isLocalization A_m m_id.primeCompl ↥M_md).mp hFlat_Am
    exact Module.Flat.of_linearEquiv (IsLocalizedModule.iso m_id.primeCompl f_m)

  
  let B : Subalgebra A L :=
    Algebra.adjoin A (Set.range (fun r : Fin (N + 1) => (u i)⁻¹ * u r))
  have hui_pow : ∀ k : ℕ, (u i) ^ k ≠ 0 := fun k => pow_ne_zero k hui
  let μ_lin (e : ℕ) : L ≃ₗ[A] L :=
    { toFun := fun x => ((u i) ^ (e * d₀))⁻¹ * x
      invFun := fun y => (u i) ^ (e * d₀) * y
      map_add' := fun x y => mul_add _ x y
      map_smul' := fun a x => mul_smul_comm a (((u i) ^ (e * d₀))⁻¹) x
      left_inv := fun x => by dsimp only; exact mul_inv_cancel_left₀ (hui_pow (e * d₀)) x
      right_inv := fun y => by dsimp only; exact inv_mul_cancel_left₀ (hui_pow (e * d₀)) y }
  let N_sub (e : ℕ) : Submodule A L := (M_eval A (e * d₀)).map (μ_lin e).toLinearMap
  have hN_flat : ∀ e : ℕ, 1 ≤ e → Module.Flat A ↥(N_sub e) := by
    intro e he
    have hd_e : d₀ ≤ e * d₀ := by
      simpa using Nat.mul_le_mul_right d₀ he
    have : Module.Flat A ↥(M_eval A (e * d₀)) := hFlat_deg (e * d₀) hd_e
    exact Module.Flat.of_linearEquiv (LinearEquiv.submoduleMap (μ_lin e) (M_eval A (e * d₀))).symm
  have hN_mono : ∀ {e₁ e₂ : ℕ}, e₁ ≤ e₂ → N_sub e₁ ≤ N_sub e₂ := by
    intro e₁ e₂ he₁₂ x hx
    rcases hx with ⟨y, ⟨P, hP, rfl⟩, rfl⟩
    let k := (e₂ - e₁) * d₀
    let P' : MvPolynomial (Fin (N + 1)) A := (MvPolynomial.X i) ^ k * P
    have hk_add : k + e₁ * d₀ = e₂ * d₀ := by
      dsimp [k]
      rw [← Nat.add_mul, Nat.sub_add_cancel he₁₂]
    have hP'_mem : P' ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A (e₂ * d₀) := by
      change P.IsHomogeneous (e₁ * d₀) at hP
      rw [MvPolynomial.mem_homogeneousSubmodule, ← hk_add]
      exact (MvPolynomial.isHomogeneous_X_pow i k).mul hP
    refine ⟨MvPolynomial.aeval (R := A) u P', ⟨P', hP'_mem, rfl⟩, ?_⟩
    dsimp [μ_lin, P']
    rw [map_mul, map_pow, MvPolynomial.aeval_X, ← hk_add, pow_add]
    have hk0 : (u i) ^ k ≠ 0 := hui_pow k
    have he0 : (u i) ^ (e₁ * d₀) ≠ 0 := hui_pow (e₁ * d₀)
    field_simp [hk0, he0]
  have hN_le_B : ∀ (e : ℕ) {x : L}, x ∈ N_sub e → x ∈ B := by
    intro e x hx
    have hSpan_N : N_sub e = Submodule.span A (μ_lin e '' Set.range (u_mon (e * d₀))) := by
      dsimp [N_sub]
      rw [hMeval_eq_span A (e * d₀), Submodule.map_span]
      rfl
    have hLe : N_sub e ≤ B.toSubmodule := by
      rw [hSpan_N, Submodule.span_le]
      rintro _ ⟨_, ⟨m, rfl⟩, rfl⟩
      have h_eq : μ_lin e (u_mon (e * d₀) m) =
          ∏ r : Fin (N + 1), ((u i)⁻¹ * u r) ^ (m.1 r : ℕ) := by
        dsimp [μ_lin, u_mon]
        have h_prod : (∏ r : Fin (N + 1), ((u i)⁻¹ * u r) ^ (m.1 r : ℕ)) =
            (∏ r : Fin (N + 1), ((u i)⁻¹) ^ (m.1 r : ℕ)) *
              (∏ r : Fin (N + 1), (u r) ^ (m.1 r : ℕ)) := by
          rw [← Finset.prod_mul_distrib]
          exact Finset.prod_congr rfl (fun r _ => mul_pow _ _ _)
        rw [h_prod, Finset.prod_pow_eq_pow_sum, m.2, inv_pow]
      rw [h_eq]
      exact B.prod_mem (fun r _ => B.pow_mem (Algebra.subset_adjoin ⟨r, rfl⟩) _)
    exact hLe hx
  have hB_in_N : ∀ {x : L}, x ∈ B → ∃ e : ℕ, 1 ≤ e ∧ x ∈ N_sub e := by
    intro x hx
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨r, rfl⟩
      refine ⟨1, le_rfl, ?_⟩
      let P_r : MvPolynomial (Fin (N + 1)) A :=
        (MvPolynomial.X i) ^ (d₀ - 1) * MvPolynomial.X r
      have hd_sub : (d₀ - 1) + 1 = 1 * d₀ := by omega
      have hPr_mem : P_r ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A (1 * d₀) := by
        rw [MvPolynomial.mem_homogeneousSubmodule, ← hd_sub]
        exact (MvPolynomial.isHomogeneous_X_pow i (d₀ - 1)).mul (MvPolynomial.isHomogeneous_X A r)
      refine ⟨MvPolynomial.aeval (R := A) u P_r, ⟨P_r, hPr_mem, rfl⟩, ?_⟩
      dsimp [μ_lin, P_r]
      rw [map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_X, ← hd_sub, pow_succ]
      have h1 : (u i) ^ (d₀ - 1) ≠ 0 := hui_pow (d₀ - 1)
      field_simp [hui, h1]
    · intro a
      refine ⟨1, le_rfl, ?_⟩
      let P_a : MvPolynomial (Fin (N + 1)) A := MvPolynomial.C a * (MvPolynomial.X i) ^ d₀
      have hPa_mem : P_a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A (1 * d₀) := by
        rw [MvPolynomial.mem_homogeneousSubmodule, one_mul, ← zero_add d₀]
        exact (MvPolynomial.isHomogeneous_C _ a).mul (MvPolynomial.isHomogeneous_X_pow i d₀)
      refine ⟨MvPolynomial.aeval (R := A) u P_a, ⟨P_a, hPa_mem, rfl⟩, ?_⟩
      dsimp [μ_lin, P_a]
      rw [one_mul, map_mul, MvPolynomial.aeval_C, map_pow, MvPolynomial.aeval_X]
      have hd0_ne : (u i) ^ d₀ ≠ 0 := hui_pow d₀
      field_simp [hd0_ne]
    · rintro x₁ x₂ _ _ ⟨e₁, he₁, hx₁⟩ ⟨e₂, he₂, hx₂⟩
      refine ⟨max e₁ e₂, le_trans he₁ (le_max_left _ _),
        add_mem (hN_mono (le_max_left _ _) hx₁) (hN_mono (le_max_right _ _) hx₂)⟩
    · rintro x₁ x₂ _ _ ⟨e₁, he₁, y₁, ⟨P₁, hP₁, rfl⟩, rfl⟩ ⟨e₂, he₂, y₂, ⟨P₂, hP₂, rfl⟩, rfl⟩
      refine ⟨e₁ + e₂, by omega, MvPolynomial.aeval (R := A) u (P₁ * P₂), ?_, ?_⟩
      · refine ⟨P₁ * P₂, ?_, rfl⟩
        change P₁.IsHomogeneous (e₁ * d₀) at hP₁
        change P₂.IsHomogeneous (e₂ * d₀) at hP₂
        change (P₁ * P₂).IsHomogeneous ((e₁ + e₂) * d₀)
        rw [Nat.add_mul]
        exact hP₁.mul hP₂
      · dsimp [μ_lin]
        rw [Nat.add_mul, pow_add, mul_inv, map_mul]
        ring
  apply Module.Flat.of_forall_isTrivialRelation
  intro l f x h_rel
  let e_fn : Fin l → ℕ := fun c => Classical.choose (hB_in_N (x c).2)
  have he_fn : ∀ c : Fin l, 1 ≤ e_fn c ∧ (x c).1 ∈ N_sub (e_fn c) :=
    fun c => Classical.choose_spec (hB_in_N (x c).2)
  let E : ℕ := 1 + Finset.univ.sup e_fn
  have hE_ge : 1 ≤ E := Nat.le_add_right 1 _
  have hx_in_E : ∀ c : Fin l, (x c).1 ∈ N_sub E := by
    intro c
    have hc_le : e_fn c ≤ E :=
      le_trans (Finset.le_sup (Finset.mem_univ c)) (Nat.le_add_left _ 1)
    exact hN_mono hc_le (he_fn c).2
  let x_E : Fin l → ↥(N_sub E) := fun c => ⟨(x c).1, hx_in_E c⟩
  have h_rel_E : ∑ c : Fin l, f c • x_E c = 0 := by
    apply Subtype.ext
    rw [AddSubmonoidClass.coe_finsetSum]
    have h_val := congrArg Subtype.val h_rel
    rw [Subalgebra.coe_zero] at h_val
    simpa [x_E] using h_val
  have : Module.Flat A ↥(N_sub E) := hN_flat E hE_ge
  have hTriv_E := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero h_rel_E
  rw [Module.isTrivialRelation_iff_vanishesTrivially] at hTriv_E ⊢
  rcases hTriv_E with ⟨n_triv, a_mat, y_E, h_xy, h_fa⟩
  exact TensorProduct.VanishesTrivially.of_fintype a_mat
    (fun k => ⟨(y_E k).1, hN_le_B E (y_E k).2⟩)
    (fun c => Subtype.ext (by
      have hc := congrArg Subtype.val (h_xy c)
      rw [AddSubmonoidClass.coe_finsetSum] at hc
      simpa using hc))
    h_fa

theorem weil_plucker_modification_over_open (k : Type u) [Field k]
    (hSegre : ∀ (Y₁ Y₂ S₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (a₁ : Y₁ ⟶ S₀) (a₂ : Y₂ ⟶ S₀),
      IsProjectiveOverField k Y₁ → IsProjectiveOverField k Y₂ → IsProjectiveOverField k S₀ →
      IsProjectiveOverField k
        (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)))
    (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral S.left]
    (hProjS : IsProjectiveOverField k S)
    (U₀ : S.left.Opens) (hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀) [Nonempty U₀]
    (M_Pl : ℕ) (Δ : Fin (M_Pl + 1) → ↑S.left.functionField)
    (a₀ : Fin (M_Pl + 1)) (hΔ₀ : Δ a₀ ≠ 0) :
    ∃ (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U' : S.left.Opens)
      (π : S' ⟶ S)
      (hIntS' : AlgebraicGeometry.IsIntegral S'.left),
      letI := hIntS'
      IsProjectiveOverField k S' ∧
      Nonempty U' ∧
      U' ≤ U₀ ∧
      AlgebraicGeometry.IsProper π.left ∧
      AlgebraicGeometry.Surjective π.left ∧
      CategoryTheory.IsIso (π.left ∣_ U') ∧
      ∃ (e_K : ↑S'.left.functionField →+* ↑S.left.functionField),
        Function.Bijective e_K ∧
