        let e₀_D : M_D := S_D.mkQ (Pi.single 0 1)
        let e₁_D : M_D := S_D.mkQ (Pi.single 1 1)
        let bwd_κ : (Fin 2 → κ_D) →ₗ[κ_D] TensorProduct D κ_D M_D :=
          { toFun := fun w => w 0 • ((1 : κ_D) ⊗ₜ[D] e₀_D) + w 1 • ((1 : κ_D) ⊗ₜ[D] e₁_D)
            map_add' := fun u w => by
              rw [Pi.add_apply, Pi.add_apply, add_smul, add_smul]
