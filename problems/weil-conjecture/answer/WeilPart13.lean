      have hF'_eq_E : F' = E_exc :=
        Set.Subset.antisymm hF'_sub_E (hF'_mem.2 hE_mem.1 hF'_sub_E)
      rw [hF'_eq_E] at hqY₁_F'
      have hqY₁_eq_η : q_Y₁ = η_exc := hqY₁_F'.eq hη_gen
      have hvY₁_qexc : v_Y₁.base m_V = ι₁.base q_exc := by
        rw [hvY₁_m, hqY₁_eq_η, hι₁_qexc]
      have : q_exc.asIdeal.IsPrime := q_exc.isPrime
      obtain ⟨hϖ_ne, hm_Vexc, v_W_exc, m_V_exc, hm_Vexc_pt, hvW_exc_m, hvW_exc_g, hvW_exc_h⟩ :=
        hPillar3 R₁ ι₁ q_exc (φ₁.hom z₁) V L u_K v_W v_Y₁ m_V
          hOpen_ι₁ hDom_R₁ hz₁_ne hq_exc_span hu_dom hvW_gen hvY₁_gen hv_base hm_V hvY₁_qexc
      obtain ⟨_a_W, _b_W, R_W, p_W, ι_W, w₁_0, w₂_0, _A'_W, _v₀_W, _e_W, _u_W, _v_W', _ε_W,
          hOpen_ιW, hιW_pW, hDom_RW, hpW_span, hw₁_ne0, hw_reg0, hres_RW, _⟩ :=
        hNC_W q_W hqW_cl
      have : p₀.asIdeal.IsPrime := p₀.isPrime
      have : p_W.asIdeal.IsPrime := p_W.isPrime
      have hpW_y₀ : h.base (ι_W.base p_W) = y₀ := by
        rw [hιW_pW, hy_eq, hy]
      obtain ⟨θ, hθ_loc, hθ_inj, hθ_Ω, hθ_geom, hθ_bir, hθ_notSurj⟩ :=
        hq₀_notSurj R₀ p₀ ι₀ R_W p_W ι_W hOpen_ι₀ hDom_R₀ hι₀_p₀ hOpen_ιW hDom_RW hpW_y₀
      have hvW_exc_pW : v_W_exc.base m_V_exc = ι_W.base p_W := by
        rw [hvW_exc_m, hvW_m, hιW_pW]
      obtain ⟨hNoeth_A, hNoeth_B, hm_A, hm_B, hw₁_ne, hw_reg, hres_B,
          ψ, hψ_loc, hz₁_V, hz₂_V, hs₁_trans⟩ :=
        hPillar4 R₀ R₁ R_W p₀ q_exc p_W ι₀ ι₁ ι_W φ₁ z₁ z₂ s₁ w₁_0 w₂_0 θ v_W_exc m_V_exc
          hOpen_ι₀ hOpen_ι₁ hOpen_ιW hDom_R₀ hDom_R₁ hDom_RW hι₁_ρ₁ hp₀_span hz₂_eq hs₁_not_mem
          hpW_span hw₁_ne0 hw_reg0 hres_RW hθ_geom hm_Vexc_pt hvW_exc_pW hvW_exc_g hvW_exc_h
      let A := Localization.AtPrime p₀.asIdeal
      let B := Localization.AtPrime p_W.asIdeal
      let V_exc := Localization.AtPrime q_exc.asIdeal
      have : IsNoetherianRing A := hNoeth_A
      have : IsNoetherianRing B := hNoeth_B
      let c_A : Ω →+* A :=
        (algebraMap R₀ A).comp ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_Y)).hom.comp PowerSeries.C)
      let c_B : Ω →+* B :=
        (algebraMap R_W B).comp ((AlgebraicGeometry.Spec.preimage (ι_W ≫ g_W)).hom.comp PowerSeries.C)
      exact hθ_notSurj
        (hLocalSurj A B V_exc c_A c_B θ ψ hθ_loc hψ_loc hθ_inj hθ_Ω
          (algebraMap R₀ A z₁) (algebraMap R₀ A z₂) hm_A
          (algebraMap R_W B w₁_0) (algebraMap R_W B w₂_0) hm_B
          hw₁_ne hw_reg hres_B hθ_bir
          (algebraMap R₁ V_exc (φ₁.hom z₁)) (algebraMap R₁ V_exc s₁)
          hϖ_ne hm_Vexc hz₁_V hz₂_V hs₁_trans)
    · obtain ⟨F', hF'_mem, hqY₁_F'⟩ := hqY₁_gen
      exact hNoClosedGen F' q_Y₁ hF'_mem hqY₁_F' (hOffCenter hqW_cl hy)
  obtain ⟨h₁, hh₁_g, hh₁_sec, hh₁_gen⟩ := hDom₁ α₁ hα₁_snd hα₁_sec hCenters
  exact ⟨α₁, h₁, hα₁_snd, hh₁_g, hα₁_uniq h₁ hh₁_g hh₁_gen, hh₁_sec, hh₁_gen⟩

theorem weil_nc2d_birational_morphism_blowup_factorization (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W Y : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (h : W ⟶ Y)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hαK_snd : α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hh_comm : h ≫ g_Y = g_W)
    (hh_sec : ∀ j : Fin n, τ_W j ≫ h = τ_Y j)
    (hh_gen : CategoryTheory.Limits.pullback.fst g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≫ h =
      α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hNorm : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z)),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      ∀ U : Z.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        IsIntegrallyClosed ↑(Z.presheaf.obj (Opposite.op U)))
    (hBlowup : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
      (q₀ : ↥(CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))) →
      ∃ (Z' : AlgebraicGeometry.Scheme.{u})
        (g_Z' : Z' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τ_Z' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z'))
        (π : Z' ⟶ Z),
        IsNC2DClosedPointBlowup Ω n g_Z τ_Z g_Z' τ_Z' q₀ π)
    (hDom : ∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
      (g_Z₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_Z₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z₁))
      (g_Z₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_Z₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z₂))
      (β_K : CategoryTheory.Limits.pullback g_Z₁
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
        CategoryTheory.Limits.pullback g_Z₂
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
      IsNC2DPointedSurface Ω n g_Z₁ τ_Z₁ →
      IsNC2DPointedSurface Ω n g_Z₂ τ_Z₂ →
      (∀ U : Z₁.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        IsIntegrallyClosed ↑(Z₁.presheaf.obj (Opposite.op U))) →
      β_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Z₂
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
        CategoryTheory.Limits.pullback.snd g_Z₁
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) →
      (∀ j : Fin n,
        ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
            CategoryTheory.Limits.pullback g_Z₁
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
          s₁ ≫ CategoryTheory.Limits.pullback.fst g_Z₁
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
              τ_Z₁ j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g_Z₁
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
          (s₁ ≫ β_K.hom) ≫ CategoryTheory.Limits.pullback.fst g_Z₂
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
              τ_Z₂ j) →
      HasNonclosedComponentCenters Ω g_Z₁ g_Z₂ β_K →
      ∃ h' : Z₁ ⟶ Z₂,
        h' ≫ g_Z₂ = g_Z₁ ∧
        (∀ j : Fin n, τ_Z₁ j ≫ h' = τ_Z₂ j) ∧
        CategoryTheory.Limits.pullback.fst g_Z₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≫ h' =
          β_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Z₂
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ (ℓ : ℕ)
      (Y_seq : Fin (ℓ + 1) → AlgebraicGeometry.Scheme.{u})
      (gY_seq : ∀ i : Fin (ℓ + 1), Y_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τY_seq : ∀ i : Fin (ℓ + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y_seq i))
      (centersY : ∀ i : Fin ℓ, ↥(CategoryTheory.Limits.pullback (gY_seq i.castSucc) s_Ω))
      (mapsY : ∀ i : Fin ℓ, Y_seq i.succ ⟶ Y_seq i.castSucc)
      (ρ_from : ∀ i : Fin (ℓ + 1), Y_seq i ⟶ Y)
      (h_ℓ : W ≅ Y_seq (Fin.last ℓ)),
      IsNC2DBlowupTower Ω n g_Y τ_Y ℓ Y_seq gY_seq τY_seq centersY mapsY ρ_from ∧
      h_ℓ.hom ≫ gY_seq (Fin.last ℓ) = g_W ∧
      h_ℓ.hom ≫ ρ_from (Fin.last ℓ) = h ∧
      (∀ j : Fin n, τ_W j ≫ h_ℓ.hom = τY_seq (Fin.last ℓ) j) :=
by
  intro s_Ω
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  
  have hLocalSurj : ∀ (A B V_exc : Type u)
      [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsLocalRing A]
      [CommRing B] [IsDomain B] [IsNoetherianRing B] [IsLocalRing B]
      [CommRing V_exc] [IsDomain V_exc] [IsLocalRing V_exc]
      (c_A : Ω →+* A) (c_B : Ω →+* B)
      (θ : A →+* B) (ψ : B →+* V_exc),
      IsLocalHom θ → IsLocalHom ψ → Function.Injective θ → θ.comp c_A = c_B →
      ∀ (z₁ z₂ : A), IsLocalRing.maximalIdeal A = Ideal.span ({z₁, z₂} : Set A) →
      ∀ (w₁ w₂ : B), IsLocalRing.maximalIdeal B = Ideal.span ({w₁, w₂} : Set B) →
      w₁ ≠ 0 →
      (∀ y : B, w₂ * y ∈ Ideal.span ({w₁} : Set B) → y ∈ Ideal.span ({w₁} : Set B)) →
      (∀ b : B, ∃ c : Ω, b - c_B c ∈ IsLocalRing.maximalIdeal B) →
      (∀ b : B, ∃ f g : A, g ≠ 0 ∧ θ g * b = θ f) →
      ∀ (ϖ s₁ : V_exc), ϖ ≠ 0 →
      IsLocalRing.maximalIdeal V_exc = Ideal.span ({ϖ} : Set V_exc) →
      ψ (θ z₁) = ϖ →
      ψ (θ z₂) = ϖ * s₁ →
      (∀ c : Ω, s₁ - ψ (c_B c) ∉ IsLocalRing.maximalIdeal V_exc) →
      Function.Surjective θ := by
    intro A B V_exc _ _ _ _ _ _ _ _ _ _ _ c_A c_B θ ψ
      hθ_loc hψ_loc hθ_inj hc_comm z₁ z₂ hz w₁ w₂ hw hw₁_ne hw_reg hres_B hbir
      ϖ s₁ hϖ_ne hm_V hz₁_V hz₂_V hs₁_trans
    let m_A : Ideal A := IsLocalRing.maximalIdeal A
    let m_B : Ideal B := IsLocalRing.maximalIdeal B
    let m_V : Ideal V_exc := IsLocalRing.maximalIdeal V_exc
    have hmA_def : m_A = IsLocalRing.maximalIdeal A := rfl
    have hmB_def : m_B = IsLocalRing.maximalIdeal B := rfl
    have hmV_def : m_V = IsLocalRing.maximalIdeal V_exc := rfl
    have h_map_mA : ∀ x ∈ m_A, θ x ∈ m_B := by
      intro x hx
      by_contra hnot
      have hu : IsUnit (θ x) := IsLocalRing.notMem_maximalIdeal.mp hnot
      have hux : IsUnit x := hθ_loc.map_nonunit x hu
      exact (IsLocalRing.notMem_maximalIdeal.mpr hux) hx
    have h_comap_mB : ∀ x : A, θ x ∈ m_B → x ∈ m_A := by
      intro x hx
      by_contra hnot
      have hux : IsUnit x := IsLocalRing.notMem_maximalIdeal.mp hnot
      exact (IsLocalRing.notMem_maximalIdeal.mpr (hux.map θ)) hx
    have h_map_mB : ∀ y ∈ m_B, ψ y ∈ m_V := by
      intro y hy
      by_contra hnot
      have hu : IsUnit (ψ y) := IsLocalRing.notMem_maximalIdeal.mp hnot
      have huy : IsUnit y := hψ_loc.map_nonunit y hu
      exact (IsLocalRing.notMem_maximalIdeal.mpr huy) hy
    have h_span_two : ∀ {R : Type u} [CommRing R] (x y z : R),
        z ∈ Ideal.span ({x, y} : Set R) ↔ ∃ a b : R, a * x + b * y = z := by
      intro R _ x y z
      rw [Set.insert_eq x {y}, Ideal.span_union, Submodule.mem_sup]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩
        rcases Ideal.mem_span_singleton.mp hu with ⟨a, rfl⟩
        rcases Ideal.mem_span_singleton.mp hv with ⟨b, rfl⟩
        exact ⟨a, b, by ring⟩
      · rintro ⟨a, b, rfl⟩
        exact ⟨x * a, Ideal.mem_span_singleton.mpr ⟨a, rfl⟩,
          y * b, Ideal.mem_span_singleton.mpr ⟨b, rfl⟩, by ring⟩
    have h_span_two_le : ∀ {R : Type u} [CommRing R] {x y : R} {I : Ideal R},
        x ∈ I → y ∈ I → Ideal.span ({x, y} : Set R) ≤ I := by
      intro R _ x y I hx hy
      rw [Set.insert_eq x {y}, Ideal.span_union]
      exact sup_le ((Ideal.span_singleton_le_iff_mem I).mpr hx)
        ((Ideal.span_singleton_le_iff_mem I).mpr hy)
    let ζ₁ : B := θ z₁
    let ζ₂ : B := θ z₂
    have hz₁_mem : z₁ ∈ m_A := by rw [hmA_def, hz]; exact Ideal.subset_span (by simp)
    have hz₂_mem : z₂ ∈ m_A := by rw [hmA_def, hz]; exact Ideal.subset_span (by simp)
    have hζ₁_mem : ζ₁ ∈ m_B := h_map_mA z₁ hz₁_mem
    have hζ₂_mem : ζ₂ ∈ m_B := h_map_mA z₂ hz₂_mem
    have hw₁_mem : w₁ ∈ m_B := by rw [hmB_def, hw]; exact Ideal.subset_span (by simp)
    have hw₂_mem : w₂ ∈ m_B := by rw [hmB_def, hw]; exact Ideal.subset_span (by simp)
    have hex_w' : ∃ w' : B, w' ∈ m_B ∧ m_B = Ideal.span ({ζ₁, w'} : Set B) := by
      have hζ₁_sp : ζ₁ ∈ Ideal.span ({w₁, w₂} : Set B) := by rw [← hw, ← hmB_def]; exact hζ₁_mem
      obtain ⟨a₁, a₂, ha_eq⟩ := (h_span_two w₁ w₂ ζ₁).mp hζ₁_sp
      have hm1 : ψ w₁ ∈ Ideal.span ({ϖ} : Set V_exc) := by
        rw [← hm_V, ← hmV_def]; exact h_map_mB w₁ hw₁_mem
      obtain ⟨u₁, hu₁⟩ := Ideal.mem_span_singleton.mp hm1
      have hm2 : ψ w₂ ∈ Ideal.span ({ϖ} : Set V_exc) := by
        rw [← hm_V, ← hmV_def]; exact h_map_mB w₂ hw₂_mem
      obtain ⟨u₂, hu₂⟩ := Ideal.mem_span_singleton.mp hm2
      have h1_eq : ψ a₁ * u₁ + ψ a₂ * u₂ = 1 := by
        apply mul_left_cancel₀ hϖ_ne
        calc ϖ * (ψ a₁ * u₁ + ψ a₂ * u₂)
            = ψ a₁ * (ϖ * u₁) + ψ a₂ * (ϖ * u₂) := by ring
          _ = ψ (a₁ * w₁ + a₂ * w₂) := by rw [← hu₁, ← hu₂, map_add, map_mul, map_mul]
          _ = ψ ζ₁ := by rw [ha_eq]
          _ = ϖ * 1 := by rw [hz₁_V, mul_one]
      have hnot_both : a₁ ∉ m_B ∨ a₂ ∉ m_B := by
        by_contra hboth
        push Not at hboth
        have hmem1 : (1 : V_exc) ∈ m_V := by
          rw [← h1_eq]
          exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (h_map_mB a₁ hboth.1))
            (Ideal.mul_mem_right _ _ (h_map_mB a₂ hboth.2))
        exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) hmem1
      rcases hnot_both with ha₁_nu | ha₂_nu
      · refine ⟨w₂, hw₂_mem, le_antisymm ?_ (h_span_two_le hζ₁_mem hw₂_mem)⟩
        rw [hmB_def, hw]
        refine h_span_two_le ?_ (Ideal.subset_span (by simp))
        obtain ⟨v₁, hv₁⟩ := (IsLocalRing.notMem_maximalIdeal.mp ha₁_nu).exists_left_inv
        rw [h_span_two]
        refine ⟨v₁, -(v₁ * a₂), ?_⟩
        calc v₁ * ζ₁ + -(v₁ * a₂) * w₂
            = v₁ * (a₁ * w₁ + a₂ * w₂) - v₁ * a₂ * w₂ := by rw [← ha_eq]; ring
          _ = (v₁ * a₁) * w₁ := by ring
          _ = w₁ := by rw [hv₁, one_mul]
      · refine ⟨w₁, hw₁_mem, le_antisymm ?_ (h_span_two_le hζ₁_mem hw₁_mem)⟩
        rw [hmB_def, hw]
        refine h_span_two_le (Ideal.subset_span (by simp)) ?_
        obtain ⟨v₂, hv₂⟩ := (IsLocalRing.notMem_maximalIdeal.mp ha₂_nu).exists_left_inv
        rw [h_span_two]
        refine ⟨v₂, -(v₂ * a₁), ?_⟩
        calc v₂ * ζ₁ + -(v₂ * a₁) * w₁
            = v₂ * (a₁ * w₁ + a₂ * w₂) - v₂ * a₁ * w₁ := by rw [← ha_eq]; ring
          _ = (v₂ * a₂) * w₂ := by ring
          _ = w₂ := by rw [hv₂, one_mul]
    obtain ⟨w', hw'_mem, hmB_w'⟩ := hex_w'
    have hmB_ζ : m_B = Ideal.span ({ζ₁, ζ₂} : Set B) := by
      obtain ⟨b₁, b₂, hb_eq⟩ : ∃ b₁ b₂ : B, b₁ * ζ₁ + b₂ * w' = ζ₂ := by
        rw [← h_span_two, ← hmB_w']; exact hζ₂_mem
      have hmw' : ψ w' ∈ Ideal.span ({ϖ} : Set V_exc) := by
        rw [← hm_V, ← hmV_def]; exact h_map_mB w' hw'_mem
      obtain ⟨u', hu'⟩ := Ideal.mem_span_singleton.mp hmw'
      have hs₁_eq : s₁ = ψ b₁ + ψ b₂ * u' := by
        apply mul_left_cancel₀ hϖ_ne
        calc ϖ * s₁ = ψ ζ₂ := hz₂_V.symm
          _ = ψ (b₁ * ζ₁ + b₂ * w') := by rw [hb_eq]
          _ = ψ b₁ * ψ ζ₁ + ψ b₂ * ψ w' := by rw [map_add, map_mul, map_mul]
          _ = ϖ * (ψ b₁ + ψ b₂ * u') := by rw [hz₁_V, hu']; ring
      obtain ⟨c₁, hc₁⟩ := hres_B b₁
      have hb₂_nu : b₂ ∉ m_B := by
        intro hb₂_in
        apply hs₁_trans c₁
        have hdiff : s₁ - ψ (c_B c₁) = ψ (b₁ - c_B c₁) + ψ b₂ * u' := by
          rw [hs₁_eq, map_sub]; ring
        rw [hdiff]
        exact Ideal.add_mem _ (h_map_mB _ hc₁) (Ideal.mul_mem_right _ _ (h_map_mB b₂ hb₂_in))
      obtain ⟨v₂, hv₂⟩ := (IsLocalRing.notMem_maximalIdeal.mp hb₂_nu).exists_left_inv
      refine le_antisymm ?_ (h_span_two_le hζ₁_mem hζ₂_mem)
      rw [hmB_w']
      refine h_span_two_le (Ideal.subset_span (by simp)) ?_
      rw [h_span_two]
      refine ⟨-(v₂ * b₁), v₂, ?_⟩
      calc -(v₂ * b₁) * ζ₁ + v₂ * ζ₂
          = -(v₂ * b₁) * ζ₁ + v₂ * (b₁ * ζ₁ + b₂ * w') := by rw [← hb_eq]
        _ = (v₂ * b₂) * w' := by ring
        _ = w' := by rw [hv₂, one_mul]
    have h_pow_mono : ∀ {I J : Ideal B}, I ≤ J → ∀ n : ℕ, I ^ n ≤ J ^ n := by
      intro I J hIJ n
      induction n with
      | zero => simp
      | succ n ih => rw [pow_succ', pow_succ']; exact Ideal.mul_mono hIJ ih
    have h_sup_pow : ∀ (I J : Ideal B) (n : ℕ),
        (I ⊔ J) ^ (n + 1) ≤ I * (I ⊔ J) ^ n ⊔ J ^ (n + 1) := by
      intro I J n
      induction n with
      | zero => simp
      | succ n ih =>
        calc (I ⊔ J) ^ (n + 2)
            = (I ⊔ J) * (I ⊔ J) ^ (n + 1) := by rw [pow_succ']
          _ ≤ (I ⊔ J) * (I * (I ⊔ J) ^ n ⊔ J ^ (n + 1)) := Ideal.mul_mono_right ih
          _ = I * (I * (I ⊔ J) ^ n) ⊔ I * J ^ (n + 1) ⊔
                (J * (I * (I ⊔ J) ^ n) ⊔ J * J ^ (n + 1)) := by
              rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup]
          _ ≤ I * (I ⊔ J) ^ (n + 1) ⊔ J ^ (n + 2) := by
              refine sup_le (sup_le ?_ ?_) (sup_le ?_ ?_)
              · refine le_sup_of_le_left (Ideal.mul_mono_right ?_)
                rw [pow_succ']
                exact Ideal.mul_mono_left le_sup_left
              · refine le_sup_of_le_left (Ideal.mul_mono_right ?_)
                exact h_pow_mono le_sup_right (n + 1)
              · refine le_sup_of_le_left ?_
                calc J * (I * (I ⊔ J) ^ n)
                    = I * (J * (I ⊔ J) ^ n) := by rw [← mul_assoc, mul_comm J I, mul_assoc]
                  _ ≤ I * (I ⊔ J) ^ (n + 1) := by
                      refine Ideal.mul_mono_right ?_
                      rw [pow_succ']
                      exact Ideal.mul_mono_left le_sup_right
              · refine le_sup_of_le_right ?_
                rw [pow_succ' J (n + 1)]
    have h_span_mul_mem : ∀ {R : Type u} [CommRing R] (x : R) (K : Ideal R) (z : R),
        z ∈ Ideal.span ({x} : Set R) * K → ∃ u ∈ K, z = x * u := by
      intro R _ x K z hz_in
      refine Submodule.mul_induction_on hz_in ?_ ?_
      · intro r hr k hk
        obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hr
        exact ⟨a * k, K.mul_mem_left a hk, by ring⟩
      · rintro _ _ ⟨u₁, hu₁, rfl⟩ ⟨u₂, hu₂, rfl⟩
        exact ⟨u₁ + u₂, K.add_mem hu₁ hu₂, by ring⟩
    have hw₂_pow_reg : ∀ (k : ℕ) (z : B),
        w₂ ^ k * z ∈ Ideal.span ({w₁} : Set B) → z ∈ Ideal.span ({w₁} : Set B) := by
      intro k
      induction k with
      | zero => intro z hz0; simpa using hz0
      | succ k ih =>
        intro z hzk
        apply ih z
        apply hw_reg (w₂ ^ k * z)
        have heq : w₂ * (w₂ ^ k * z) = w₂ ^ (k + 1) * z := by ring
        rwa [heq]
    have hcB_mem_iff : ∀ c : Ω, c_B c ∈ m_B ↔ c = 0 := by
      intro c
      constructor
      · intro hc
        by_contra hc_ne
        have hu : IsUnit (c_B c) := (IsUnit.mk0 c hc_ne).map c_B
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hc
      · rintro rfl; rw [map_zero]; exact m_B.zero_mem
    have hw_hom_reg : ∀ (d : ℕ) (γ : Fin (d + 1) → Ω),
        (∑ k : Fin (d + 1), c_B (γ k) * w₁ ^ (k : ℕ) * w₂ ^ (d - (k : ℕ))) ∈ m_B ^ (d + 1) →
        ∀ k : Fin (d + 1), γ k = 0 := by
      intro d
      induction d with
      | zero =>
        intro γ hsum k
        have h0 : c_B (γ 0) ∈ m_B := by
          simpa [Fin.sum_univ_one] using hsum
        have hγ0 : γ 0 = 0 := (hcB_mem_iff (γ 0)).mp h0
        fin_cases k
        exact hγ0
      | succ d ih =>
        intro γ hsum
        have hmB_sup : m_B = Ideal.span ({w₁} : Set B) ⊔ Ideal.span ({w₂} : Set B) := by
          rw [hmB_def, hw, Set.insert_eq w₁ {w₂}, Ideal.span_union]
        have hsplit : m_B ^ (d + 2) ≤
            Ideal.span ({w₁} : Set B) * m_B ^ (d + 1) ⊔ Ideal.span ({w₂} : Set B) ^ (d + 2) := by
          simpa [hmB_sup] using h_sup_pow (Ideal.span {w₁}) (Ideal.span {w₂}) (d + 1)
        obtain ⟨z₁_part, hz₁_part, z₂_part, hz₂_part, hz_sum⟩ :=
          Submodule.mem_sup.mp (hsplit hsum)
        obtain ⟨u, hu_mem, rfl⟩ := h_span_mul_mem w₁ (m_B ^ (d + 1)) z₁_part hz₁_part
        rw [Ideal.span_singleton_pow] at hz₂_part
        obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton.mp hz₂_part
        let S' : B := ∑ j : Fin (d + 1),
          c_B (γ j.succ) * w₁ ^ (j : ℕ) * w₂ ^ (d - (j : ℕ))
        have hsum_decomp :
            (∑ k : Fin (d + 2), c_B (γ k) * w₁ ^ (k : ℕ) * w₂ ^ (d + 1 - (k : ℕ))) =
            c_B (γ 0) * w₂ ^ (d + 1) + w₁ * S' := by
          rw [Fin.sum_univ_succ]
          simp only [Fin.val_zero, pow_zero, mul_one, Nat.sub_zero, Fin.val_succ,
            Nat.succ_sub_succ_eq_sub, S', Finset.mul_sum]
          congr 1
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [pow_succ']; ring
        have h_eq1 : c_B (γ 0) * w₂ ^ (d + 1) + w₁ * S' = w₁ * u + w₂ ^ (d + 2) * v := by
          rw [← hsum_decomp, hz_sum]
        have hγ0_zero : γ 0 = 0 := by
          have hdiv : w₂ ^ (d + 1) * (c_B (γ 0) - w₂ * v) ∈ Ideal.span ({w₁} : Set B) := by
            rw [Ideal.mem_span_singleton]
            refine ⟨u - S', ?_⟩
            calc w₂ ^ (d + 1) * (c_B (γ 0) - w₂ * v)
                = (c_B (γ 0) * w₂ ^ (d + 1) + w₁ * S') - w₂ ^ (d + 2) * v - w₁ * S' := by ring
              _ = (w₁ * u + w₂ ^ (d + 2) * v) - w₂ ^ (d + 2) * v - w₁ * S' := by rw [h_eq1]
              _ = w₁ * (u - S') := by ring
          have hmem_w1 : c_B (γ 0) - w₂ * v ∈ Ideal.span ({w₁} : Set B) :=
            hw₂_pow_reg (d + 1) _ hdiv
          have hmem_mB : c_B (γ 0) - w₂ * v ∈ m_B :=
            (Ideal.span_singleton_le_iff_mem m_B).mpr hw₁_mem hmem_w1
          have hc0_mB : c_B (γ 0) ∈ m_B := by
            have heq : c_B (γ 0) = (c_B (γ 0) - w₂ * v) + w₂ * v := by ring
            rw [heq]
            exact m_B.add_mem hmem_mB (m_B.mul_mem_right v hw₂_mem)
          exact (hcB_mem_iff (γ 0)).mp hc0_mB
        have hv_div : v ∈ Ideal.span ({w₁} : Set B) := by
          apply hw₂_pow_reg (d + 2) v
          rw [Ideal.mem_span_singleton]
          refine ⟨S' - u, ?_⟩
          have h_eq2 : w₁ * S' = w₁ * u + w₂ ^ (d + 2) * v := by
            simpa [hγ0_zero] using h_eq1
          linear_combination h_eq2.symm
        obtain ⟨v', rfl⟩ := Ideal.mem_span_singleton.mp hv_div
        have hS'_eq : S' = u + w₂ ^ (d + 2) * v' := by
          apply mul_left_cancel₀ hw₁_ne
          have h_eq2 : w₁ * S' = w₁ * u + w₂ ^ (d + 2) * (w₁ * v') := by
            simpa [hγ0_zero] using h_eq1
          linear_combination h_eq2
        have hS'_mem : S' ∈ m_B ^ (d + 1) := by
          rw [hS'_eq]
          refine (m_B ^ (d + 1)).add_mem hu_mem ?_
          have heq : w₂ ^ (d + 2) * v' = w₂ ^ (d + 1) * (w₂ * v') := by ring
          rw [heq]
          exact (m_B ^ (d + 1)).mul_mem_right (w₂ * v') (Ideal.pow_mem_pow hw₂_mem (d + 1))
        have hγ_succ : ∀ j : Fin (d + 1), γ j.succ = 0 := ih (fun j => γ j.succ) hS'_mem
        intro k
        refine Fin.cases hγ0_zero hγ_succ k
    let _ : Algebra Ω B := c_B.toAlgebra
    have halg_B : ∀ c : Ω, algebraMap Ω B c = c_B c := fun _ => rfl
    let X₀ : MvPolynomial (Fin 2) Ω := MvPolynomial.X 0
    let X₁ : MvPolynomial (Fin 2) Ω := MvPolynomial.X 1
    let IsHom : ℕ → MvPolynomial (Fin 2) Ω → Prop := fun d P =>
      ∃ γ : Fin (d + 1) → Ω,
        P = ∑ k : Fin (d + 1), MvPolynomial.C (γ k) * X₀ ^ (k : ℕ) * X₁ ^ (d - (k : ℕ))
    have hIsHom_zero : ∀ d : ℕ, IsHom d 0 := fun d => ⟨0, by simp⟩
    have hIsHom_add : ∀ {d : ℕ} {P Q : MvPolynomial (Fin 2) Ω},
        IsHom d P → IsHom d Q → IsHom d (P + Q) := by
      rintro d _ _ ⟨γ₁, rfl⟩ ⟨γ₂, rfl⟩
      refine ⟨γ₁ + γ₂, ?_⟩
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [Pi.add_apply, map_add]; ring
    have hIsHom_smul : ∀ {d : ℕ} (c : Ω) {P : MvPolynomial (Fin 2) Ω},
        IsHom d P → IsHom d (MvPolynomial.C c * P) := by
      rintro d c _ ⟨γ, rfl⟩
      refine ⟨fun k => c * γ k, ?_⟩
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [map_mul]; ring
    have hIsHom_mul_lin : ∀ {d : ℕ} (a b : Ω) {P : MvPolynomial (Fin 2) Ω},
        IsHom d P → IsHom (d + 1) ((MvPolynomial.C a * X₀ + MvPolynomial.C b * X₁) * P) := by
      rintro d a b _ ⟨γ, rfl⟩
      have hX0 : IsHom (d + 1)
          (MvPolynomial.C a * X₀ *
            ∑ k : Fin (d + 1), MvPolynomial.C (γ k) * X₀ ^ (k : ℕ) * X₁ ^ (d - (k : ℕ))) := by
        refine ⟨@Fin.cases (d + 1) (fun _ => Ω) 0 (fun j => a * γ j), ?_⟩
        symm
        rw [Fin.sum_univ_succ, Finset.mul_sum]
        simp only [Fin.cases_zero, map_zero, zero_mul, zero_add, Fin.cases_succ,
          Fin.val_succ, Nat.succ_sub_succ_eq_sub, map_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [pow_succ']; ring
      have hX1 : IsHom (d + 1)
          (MvPolynomial.C b * X₁ *
            ∑ k : Fin (d + 1), MvPolynomial.C (γ k) * X₀ ^ (k : ℕ) * X₁ ^ (d - (k : ℕ))) := by
        refine ⟨@Fin.snoc (d + 1) (fun _ => Ω) (fun j => b * γ j) 0, ?_⟩
        symm
        rw [Fin.sum_univ_castSucc, Finset.mul_sum]
        simp only [Fin.snoc_last, map_zero, zero_mul, add_zero, Fin.snoc_castSucc,
          Fin.val_castSucc, map_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        have hsub : d + 1 - (j : ℕ) = (d - (j : ℕ)) + 1 := by omega
        rw [hsub, pow_succ]; ring
      simpa [add_mul] using hIsHom_add hX0 hX1
    have hIsHom_pow_lin : ∀ (a b : Ω) (k : ℕ),
        IsHom k ((MvPolynomial.C a * X₀ + MvPolynomial.C b * X₁) ^ k) := by
      intro a b k
      induction k with
      | zero => exact ⟨fun _ => 1, by simp⟩
      | succ k ih => rw [pow_succ']; exact hIsHom_mul_lin a b ih
    have hIsHom_prod_lin : ∀ (a₁ b₁ a₂ b₂ : Ω) (k r : ℕ),
        IsHom (k + r)
          ((MvPolynomial.C a₁ * X₀ + MvPolynomial.C b₁ * X₁) ^ k *
           (MvPolynomial.C a₂ * X₀ + MvPolynomial.C b₂ * X₁) ^ r) := by
      intro a₁ b₁ a₂ b₂ k r
      induction r with
      | zero => simpa using hIsHom_pow_lin a₁ b₁ k
      | succ r ih =>
        have heq :
            (MvPolynomial.C a₁ * X₀ + MvPolynomial.C b₁ * X₁) ^ k *
              (MvPolynomial.C a₂ * X₀ + MvPolynomial.C b₂ * X₁) ^ (r + 1) =
            (MvPolynomial.C a₂ * X₀ + MvPolynomial.C b₂ * X₁) *
              ((MvPolynomial.C a₁ * X₀ + MvPolynomial.C b₁ * X₁) ^ k *
               (MvPolynomial.C a₂ * X₀ + MvPolynomial.C b₂ * X₁) ^ r) := by
          rw [pow_succ']; ring
        rw [heq, ← Nat.add_assoc]
        exact hIsHom_mul_lin a₂ b₂ ih
    have hIsHom_aeval_lin : ∀ (a₁ b₁ a₂ b₂ : Ω) {d : ℕ} {P : MvPolynomial (Fin 2) Ω},
        IsHom d P →
        IsHom d (MvPolynomial.aeval
          ![MvPolynomial.C a₁ * X₀ + MvPolynomial.C b₁ * X₁,
            MvPolynomial.C a₂ * X₀ + MvPolynomial.C b₂ * X₁] P) := by
      rintro a₁ b₁ a₂ b₂ d _ ⟨γ, rfl⟩
      simp only [map_sum, map_mul, map_pow, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
        X₀, X₁, MvPolynomial.aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one]
      have hsum_hom : ∀ s : Finset (Fin (d + 1)),
          IsHom d (∑ k ∈ s, MvPolynomial.C (γ k) *
            (MvPolynomial.C a₁ * MvPolynomial.X 0 + MvPolynomial.C b₁ * MvPolynomial.X 1) ^ (k : ℕ) *
            (MvPolynomial.C a₂ * MvPolynomial.X 0 + MvPolynomial.C b₂ * MvPolynomial.X 1) ^ (d - (k : ℕ))) := by
        intro s
        refine Finset.induction_on s (hIsHom_zero d) fun k s hks ih => ?_
        rw [Finset.sum_insert hks]
        refine hIsHom_add ?_ ih
        rw [mul_assoc]
        refine hIsHom_smul (γ k) ?_
        have hkd : (k : ℕ) + (d - (k : ℕ)) = d := Nat.add_sub_of_le (Nat.le_of_lt_succ k.isLt)
        have hprod := hIsHom_prod_lin a₁ b₁ a₂ b₂ (k : ℕ) (d - (k : ℕ))
        rwa [hkd] at hprod
      exact hsum_hom Finset.univ
    have hIsHom_eq_zero : ∀ {d : ℕ} (γ : Fin (d + 1) → Ω),
        (∑ k : Fin (d + 1), MvPolynomial.C (γ k) * X₀ ^ (k : ℕ) * X₁ ^ (d - (k : ℕ))) = 0 →
        ∀ k : Fin (d + 1), γ k = 0 := by
      intro d γ hP0 k
      have hpol := congrArg (MvPolynomial.aeval ![Polynomial.X, (1 : Polynomial Ω)]) hP0
      simp only [map_sum, map_mul, map_pow, map_zero, MvPolynomial.aeval_C,
        X₀, X₁, MvPolynomial.aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
        one_pow, mul_one] at hpol
      have hcoeff := congrArg (fun p : Polynomial Ω => p.coeff (k : ℕ)) hpol
      simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_zero,
        Polynomial.algebraMap_eq, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
        mul_ite, mul_one, mul_zero] at hcoeff
      rw [Finset.sum_eq_single k] at hcoeff
      · simpa using hcoeff
      · intro j _ hjk
        have hval : (k : ℕ) ≠ (j : ℕ) := fun hv => hjk (Fin.ext hv.symm)
        simp [hval]
      · intro hk_abs; exact absurd (Finset.mem_univ k) hk_abs
    have hw_IsHom_zero : ∀ {d : ℕ} {P : MvPolynomial (Fin 2) Ω},
        IsHom d P → MvPolynomial.aeval ![w₁, w₂] P ∈ m_B ^ (d + 1) → P = 0 := by
      rintro d _ ⟨γ, rfl⟩ hev
      have hev' : (∑ k : Fin (d + 1), c_B (γ k) * w₁ ^ (k : ℕ) * w₂ ^ (d - (k : ℕ))) ∈ m_B ^ (d + 1) := by
        simpa [map_sum, map_mul, map_pow, MvPolynomial.aeval_C, halg_B,
          X₀, X₁, MvPolynomial.aeval_X] using hev
      have hγ0 := hw_hom_reg d γ hev'
      simp [hγ0]
    have h_pow_congr : ∀ {x y : B}, x ∈ m_B → y ∈ m_B → x - y ∈ m_B ^ 2 →
        ∀ e : ℕ, x ^ e - y ^ e ∈ m_B ^ (e + 1) := by
      intro x y hx hy hxy e
      induction e with
      | zero => simp
      | succ e ih =>
        have heq : x ^ (e + 1) - y ^ (e + 1) = (x - y) * x ^ e + y * (x ^ e - y ^ e) := by ring
        rw [heq]
        refine (m_B ^ (e + 2)).add_mem ?_ ?_
        · have hp : m_B ^ 2 * m_B ^ e = m_B ^ (e + 2) := by rw [← pow_add]; ring_nf
          rw [← hp]
          exact Ideal.mul_mem_mul hxy (Ideal.pow_mem_pow hx e)
        · rw [pow_succ']
          exact Ideal.mul_mem_mul hy ih
    have h_mon_congr : ∀ {x₀ x₁ y₀ y₁ : B},
        x₀ ∈ m_B → x₁ ∈ m_B → y₀ ∈ m_B → y₁ ∈ m_B →
        x₀ - y₀ ∈ m_B ^ 2 → x₁ - y₁ ∈ m_B ^ 2 →
        ∀ (k r : ℕ), x₀ ^ k * x₁ ^ r - y₀ ^ k * y₁ ^ r ∈ m_B ^ (k + r + 1) := by
      intro x₀ x₁ y₀ y₁ hx₀ hx₁ hy₀ hy₁ h0 h1 k r
      have heq : x₀ ^ k * x₁ ^ r - y₀ ^ k * y₁ ^ r =
          (x₀ ^ k - y₀ ^ k) * x₁ ^ r + y₀ ^ k * (x₁ ^ r - y₁ ^ r) := by ring
      rw [heq]
      refine (m_B ^ (k + r + 1)).add_mem ?_ ?_
      · have hp : m_B ^ (k + 1) * m_B ^ r = m_B ^ (k + r + 1) := by rw [← pow_add]; ring_nf
        rw [← hp]
        exact Ideal.mul_mem_mul (h_pow_congr hx₀ hy₀ h0 k) (Ideal.pow_mem_pow hx₁ r)
      · have hp : m_B ^ k * m_B ^ (r + 1) = m_B ^ (k + r + 1) := by rw [← pow_add]; ring_nf
        rw [← hp]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hy₀ k) (h_pow_congr hx₁ hy₁ h1 r)
    have h_aeval_congr : ∀ {x₀ x₁ y₀ y₁ : B},
        x₀ ∈ m_B → x₁ ∈ m_B → y₀ ∈ m_B → y₁ ∈ m_B →
        x₀ - y₀ ∈ m_B ^ 2 → x₁ - y₁ ∈ m_B ^ 2 →
        ∀ {d : ℕ} {P : MvPolynomial (Fin 2) Ω}, IsHom d P →
        MvPolynomial.aeval ![x₀, x₁] P - MvPolynomial.aeval ![y₀, y₁] P ∈ m_B ^ (d + 1) := by
      rintro x₀ x₁ y₀ y₁ hx₀ hx₁ hy₀ hy₁ h0 h1 d _ ⟨γ, rfl⟩
      simp only [map_sum, map_mul, map_pow, MvPolynomial.aeval_C, halg_B,
        X₀, X₁, MvPolynomial.aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
        ← Finset.sum_sub_distrib]
      refine Ideal.sum_mem (m_B ^ (d + 1)) fun k _ => ?_
      have heq : c_B (γ k) * x₀ ^ (k : ℕ) * x₁ ^ (d - (k : ℕ)) -
          c_B (γ k) * y₀ ^ (k : ℕ) * y₁ ^ (d - (k : ℕ)) =
          c_B (γ k) * (x₀ ^ (k : ℕ) * x₁ ^ (d - (k : ℕ)) - y₀ ^ (k : ℕ) * y₁ ^ (d - (k : ℕ))) := by
        ring
      rw [heq]
      refine (m_B ^ (d + 1)).mul_mem_left _ ?_
      have hkd : (k : ℕ) + (d - (k : ℕ)) + 1 = d + 1 := by omega
      have hm := h_mon_congr hx₀ hx₁ hy₀ hy₁ h0 h1 (k : ℕ) (d - (k : ℕ))
      rwa [hkd] at hm
    have hζ₁_sp : ζ₁ ∈ Ideal.span ({w₁, w₂} : Set B) := by rw [← hw, ← hmB_def]; exact hζ₁_mem
    have hζ₂_sp : ζ₂ ∈ Ideal.span ({w₁, w₂} : Set B) := by rw [← hw, ← hmB_def]; exact hζ₂_mem
    have hw₁_sp : w₁ ∈ Ideal.span ({ζ₁, ζ₂} : Set B) := by rw [← hmB_ζ]; exact hw₁_mem
    have hw₂_sp : w₂ ∈ Ideal.span ({ζ₁, ζ₂} : Set B) := by rw [← hmB_ζ]; exact hw₂_mem
    obtain ⟨n00_B, n01_B, hn0⟩ := (h_span_two w₁ w₂ ζ₁).mp hζ₁_sp
    obtain ⟨n10_B, n11_B, hn1⟩ := (h_span_two w₁ w₂ ζ₂).mp hζ₂_sp
    obtain ⟨m00_B, m01_B, hm0⟩ := (h_span_two ζ₁ ζ₂ w₁).mp hw₁_sp
    obtain ⟨m10_B, m11_B, hm1⟩ := (h_span_two ζ₁ ζ₂ w₂).mp hw₂_sp
    obtain ⟨n00, hn00⟩ := hres_B n00_B
    obtain ⟨n01, hn01⟩ := hres_B n01_B
    obtain ⟨n10, hn10⟩ := hres_B n10_B
    obtain ⟨n11, hn11⟩ := hres_B n11_B
    obtain ⟨m00, hm00⟩ := hres_B m00_B
    obtain ⟨m01, hm01⟩ := hres_B m01_B
    obtain ⟨m10, hm10⟩ := hres_B m10_B
    obtain ⟨m11, hm11⟩ := hres_B m11_B
    let L_N : MvPolynomial (Fin 2) Ω →ₐ[Ω] MvPolynomial (Fin 2) Ω :=
      MvPolynomial.aeval
        ![MvPolynomial.C n00 * X₀ + MvPolynomial.C n01 * X₁,
          MvPolynomial.C n10 * X₀ + MvPolynomial.C n11 * X₁]
    let L_M : MvPolynomial (Fin 2) Ω →ₐ[Ω] MvPolynomial (Fin 2) Ω :=
      MvPolynomial.aeval
        ![MvPolynomial.C m00 * X₀ + MvPolynomial.C m01 * X₁,
          MvPolynomial.C m10 * X₀ + MvPolynomial.C m11 * X₁]
    let y_N0 : B := c_B n00 * w₁ + c_B n01 * w₂
    let y_N1 : B := c_B n10 * w₁ + c_B n11 * w₂
    let y_M0 : B := c_B m00 * ζ₁ + c_B m01 * ζ₂
    let y_M1 : B := c_B m10 * ζ₁ + c_B m11 * ζ₂
    have hyN0_mem : y_N0 ∈ m_B := m_B.add_mem (m_B.mul_mem_left _ hw₁_mem) (m_B.mul_mem_left _ hw₂_mem)
    have hyN1_mem : y_N1 ∈ m_B := m_B.add_mem (m_B.mul_mem_left _ hw₁_mem) (m_B.mul_mem_left _ hw₂_mem)
    have hyM0_mem : y_M0 ∈ m_B := m_B.add_mem (m_B.mul_mem_left _ hζ₁_mem) (m_B.mul_mem_left _ hζ₂_mem)
    have hyM1_mem : y_M1 ∈ m_B := m_B.add_mem (m_B.mul_mem_left _ hζ₁_mem) (m_B.mul_mem_left _ hζ₂_mem)
    have hζ₁_yN0 : ζ₁ - y_N0 ∈ m_B ^ 2 := by
      have heq : ζ₁ - y_N0 = (n00_B - c_B n00) * w₁ + (n01_B - c_B n01) * w₂ := by
        rw [← hn0]; ring
      rw [heq, sq]
      exact (m_B * m_B).add_mem (Ideal.mul_mem_mul hn00 hw₁_mem) (Ideal.mul_mem_mul hn01 hw₂_mem)
    have hζ₂_yN1 : ζ₂ - y_N1 ∈ m_B ^ 2 := by
      have heq : ζ₂ - y_N1 = (n10_B - c_B n10) * w₁ + (n11_B - c_B n11) * w₂ := by
        rw [← hn1]; ring
      rw [heq, sq]
      exact (m_B * m_B).add_mem (Ideal.mul_mem_mul hn10 hw₁_mem) (Ideal.mul_mem_mul hn11 hw₂_mem)
    have hw₁_yM0 : w₁ - y_M0 ∈ m_B ^ 2 := by
      have heq : w₁ - y_M0 = (m00_B - c_B m00) * ζ₁ + (m01_B - c_B m01) * ζ₂ := by
        rw [← hm0]; ring
      rw [heq, sq]
      exact (m_B * m_B).add_mem (Ideal.mul_mem_mul hm00 hζ₁_mem) (Ideal.mul_mem_mul hm01 hζ₂_mem)
    have hw₂_yM1 : w₂ - y_M1 ∈ m_B ^ 2 := by
      have heq : w₂ - y_M1 = (m10_B - c_B m10) * ζ₁ + (m11_B - c_B m11) * ζ₂ := by
        rw [← hm1]; ring
      rw [heq, sq]
      exact (m_B * m_B).add_mem (Ideal.mul_mem_mul hm10 hζ₁_mem) (Ideal.mul_mem_mul hm11 hζ₂_mem)
    have hev_LN : ∀ P : MvPolynomial (Fin 2) Ω,
        MvPolynomial.aeval ![w₁, w₂] (L_N P) = MvPolynomial.aeval ![y_N0, y_N1] P := by
      intro P
      change (MvPolynomial.aeval ![w₁, w₂]).comp L_N P = _
      congr 1
      apply MvPolynomial.algHom_ext
      intro i; fin_cases i <;>
        simp [L_N, X₀, X₁, y_N0, y_N1, halg_B]
    have hev_LM : ∀ P : MvPolynomial (Fin 2) Ω,
        MvPolynomial.aeval ![ζ₁, ζ₂] (L_M P) = MvPolynomial.aeval ![y_M0, y_M1] P := by
      intro P
      change (MvPolynomial.aeval ![ζ₁, ζ₂]).comp L_M P = _
      congr 1
      apply MvPolynomial.algHom_ext
      intro i; fin_cases i <;>
        simp [L_M, X₀, X₁, y_M0, y_M1, halg_B]
    let M_mat : Matrix (Fin 2) (Fin 2) Ω := !![m00, m01; m10, m11]
    let N_mat : Matrix (Fin 2) (Fin 2) Ω := !![n00, n01; n10, n11]
    have hMN_eq_one : M_mat * N_mat = 1 := by
      have hrow0 : m00 * n00 + m01 * n10 = 1 ∧ m00 * n01 + m01 * n11 = 0 := by
        let Q0 : MvPolynomial (Fin 2) Ω := L_N (L_M X₀) - X₀
        have hQ0_eq : Q0 = ∑ k : Fin 2,
            MvPolynomial.C (![m00 * n01 + m01 * n11, m00 * n00 + m01 * n10 - 1] k) *
              X₀ ^ (k : ℕ) * X₁ ^ (1 - (k : ℕ)) := by
          simp only [Q0, L_N, L_M, X₀, X₁, Fin.sum_univ_two, Fin.val_zero, Fin.val_one,
            Matrix.cons_val_zero, Matrix.cons_val_one, map_add, map_mul,
            map_sub, map_one, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
            MvPolynomial.aeval_X, pow_zero, pow_one, mul_one]
          ring
        have hQ0_ev : MvPolynomial.aeval ![w₁, w₂] Q0 ∈ m_B ^ 2 := by
          have h1 : MvPolynomial.aeval ![ζ₁, ζ₂] (L_M X₀) -
              MvPolynomial.aeval ![w₁, w₂] (L_N (L_M X₀)) ∈ m_B ^ 2 := by
            rw [hev_LN]
            refine h_aeval_congr hζ₁_mem hζ₂_mem hyN0_mem hyN1_mem hζ₁_yN0 hζ₂_yN1 (d := 1) ?_
            refine ⟨![m01, m00], ?_⟩
            simp [L_M, X₀, X₁, Fin.sum_univ_two]; ring
          have h2 : MvPolynomial.aeval ![ζ₁, ζ₂] (L_M X₀) = y_M0 := by
            rw [hev_LM]; simp [X₀]
          have h3 : MvPolynomial.aeval ![w₁, w₂] Q0 =
              -(MvPolynomial.aeval ![ζ₁, ζ₂] (L_M X₀) -
                MvPolynomial.aeval ![w₁, w₂] (L_N (L_M X₀))) - (w₁ - y_M0) := by
            have hw0 : MvPolynomial.aeval ![w₁, w₂] X₀ = w₁ := by simp [X₀]
            simp only [Q0, map_sub, h2, hw0]
            ring
          rw [h3]
          exact (m_B ^ 2).sub_mem ((m_B ^ 2).neg_mem h1) hw₁_yM0
        have hQ0_zero : Q0 = 0 := hw_IsHom_zero ⟨_, hQ0_eq⟩ hQ0_ev
        rw [hQ0_eq] at hQ0_zero
        have hc0 := hIsHom_eq_zero _ hQ0_zero 0
        have hc1 := hIsHom_eq_zero _ hQ0_zero 1
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hc0 hc1
        exact ⟨sub_eq_zero.mp hc1, hc0⟩
      have hrow1 : m10 * n00 + m11 * n10 = 0 ∧ m10 * n01 + m11 * n11 = 1 := by
        let Q1 : MvPolynomial (Fin 2) Ω := L_N (L_M X₁) - X₁
        have hQ1_eq : Q1 = ∑ k : Fin 2,
            MvPolynomial.C (![m10 * n01 + m11 * n11 - 1, m10 * n00 + m11 * n10] k) *
              X₀ ^ (k : ℕ) * X₁ ^ (1 - (k : ℕ)) := by
          simp only [Q1, L_N, L_M, X₀, X₁, Fin.sum_univ_two, Fin.val_zero, Fin.val_one,
            Matrix.cons_val_zero, Matrix.cons_val_one, map_add, map_mul,
            map_sub, map_one, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
            MvPolynomial.aeval_X, pow_zero, pow_one, mul_one]
          ring
        have hQ1_ev : MvPolynomial.aeval ![w₁, w₂] Q1 ∈ m_B ^ 2 := by
          have h1 : MvPolynomial.aeval ![ζ₁, ζ₂] (L_M X₁) -
              MvPolynomial.aeval ![w₁, w₂] (L_N (L_M X₁)) ∈ m_B ^ 2 := by
            rw [hev_LN]
            refine h_aeval_congr hζ₁_mem hζ₂_mem hyN0_mem hyN1_mem hζ₁_yN0 hζ₂_yN1 (d := 1) ?_
            refine ⟨![m11, m10], ?_⟩
            simp [L_M, X₀, X₁, Fin.sum_univ_two]; ring
          have h2 : MvPolynomial.aeval ![ζ₁, ζ₂] (L_M X₁) = y_M1 := by
            rw [hev_LM]; simp [X₁]
          have h3 : MvPolynomial.aeval ![w₁, w₂] Q1 =
              -(MvPolynomial.aeval ![ζ₁, ζ₂] (L_M X₁) -
                MvPolynomial.aeval ![w₁, w₂] (L_N (L_M X₁))) - (w₂ - y_M1) := by
            have hw1 : MvPolynomial.aeval ![w₁, w₂] X₁ = w₂ := by simp [X₁]
            simp only [Q1, map_sub, h2, hw1]
            ring
          rw [h3]
          exact (m_B ^ 2).sub_mem ((m_B ^ 2).neg_mem h1) hw₂_yM1
        have hQ1_zero : Q1 = 0 := hw_IsHom_zero ⟨_, hQ1_eq⟩ hQ1_ev
        rw [hQ1_eq] at hQ1_zero
        have hc0 := hIsHom_eq_zero _ hQ1_zero 0
        have hc1 := hIsHom_eq_zero _ hQ1_zero 1
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hc0 hc1
        exact ⟨hc1, sub_eq_zero.mp hc0⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [M_mat, N_mat, Matrix.mul_apply, Fin.sum_univ_two, hrow0.1, hrow0.2, hrow1.1, hrow1.2]
    have hNM_eq_one : N_mat * M_mat = 1 :=
      (Matrix.mul_eq_one_comm_of_equiv (Equiv.refl (Fin 2))).mp hMN_eq_one
    have hLM_LN : ∀ P : MvPolynomial (Fin 2) Ω, L_M (L_N P) = P := by
      intro P
      change (L_M.comp L_N) P = AlgHom.id Ω _ P
      congr 1
      apply MvPolynomial.algHom_ext
      intro i
      have h00 : n00 * m00 + n01 * m10 = 1 := by
        have := congr_fun (congr_fun hNM_eq_one 0) 0
        simpa [N_mat, M_mat, Matrix.mul_apply, Fin.sum_univ_two] using this
      have h01 : n00 * m01 + n01 * m11 = 0 := by
        have := congr_fun (congr_fun hNM_eq_one 0) 1
        simpa [N_mat, M_mat, Matrix.mul_apply, Fin.sum_univ_two] using this
      have h10 : n10 * m00 + n11 * m10 = 0 := by
        have := congr_fun (congr_fun hNM_eq_one 1) 0
        simpa [N_mat, M_mat, Matrix.mul_apply, Fin.sum_univ_two] using this
      have h11 : n10 * m01 + n11 * m11 = 1 := by
        have := congr_fun (congr_fun hNM_eq_one 1) 1
        simpa [N_mat, M_mat, Matrix.mul_apply, Fin.sum_univ_two] using this
      fin_cases i
      · change L_M (L_N X₀) = X₀
        have hexp : L_M (L_N X₀) =
            MvPolynomial.C (n00 * m00 + n01 * m10) * X₀ +
              MvPolynomial.C (n00 * m01 + n01 * m11) * X₁ := by
          simp only [L_N, L_M, X₀, X₁, MvPolynomial.aeval_X, Matrix.cons_val_zero,
            Matrix.cons_val_one, map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          ring
        rw [hexp, h00, h01]; simp
      · change L_M (L_N X₁) = X₁
        have hexp : L_M (L_N X₁) =
            MvPolynomial.C (n10 * m00 + n11 * m10) * X₀ +
              MvPolynomial.C (n10 * m01 + n11 * m11) * X₁ := by
          simp only [L_N, L_M, X₀, X₁, MvPolynomial.aeval_X, Matrix.cons_val_zero,
            Matrix.cons_val_one, map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          ring
        rw [hexp, h10, h11]; simp
    have hζ_hom_reg : ∀ (d : ℕ) (c : Fin (d + 1) → B),
        (∑ k : Fin (d + 1), c k * ζ₁ ^ (k : ℕ) * ζ₂ ^ (d - (k : ℕ))) ∈ m_B ^ (d + 1) →
        ∀ k : Fin (d + 1), c k ∈ m_B := by
      intro d c hc_sum
      choose γ hγ using fun k : Fin (d + 1) => hres_B (c k)
      let P : MvPolynomial (Fin 2) Ω :=
        ∑ k : Fin (d + 1), MvPolynomial.C (γ k) * X₀ ^ (k : ℕ) * X₁ ^ (d - (k : ℕ))
      have hP_hom : IsHom d P := ⟨γ, rfl⟩
      have hP_ev_ζ : MvPolynomial.aeval ![ζ₁, ζ₂] P ∈ m_B ^ (d + 1) := by
        have hdiff : (∑ k : Fin (d + 1), c k * ζ₁ ^ (k : ℕ) * ζ₂ ^ (d - (k : ℕ))) -
            MvPolynomial.aeval ![ζ₁, ζ₂] P =
            ∑ k : Fin (d + 1), (c k - c_B (γ k)) * (ζ₁ ^ (k : ℕ) * ζ₂ ^ (d - (k : ℕ))) := by
          simp only [P, map_sum, map_mul, map_pow, MvPolynomial.aeval_C, halg_B,
            X₀, X₁, MvPolynomial.aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
            ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun k _ => by ring
        have hdiff_mem : (∑ k : Fin (d + 1), c k * ζ₁ ^ (k : ℕ) * ζ₂ ^ (d - (k : ℕ))) -
            MvPolynomial.aeval ![ζ₁, ζ₂] P ∈ m_B ^ (d + 1) := by
          rw [hdiff]
          refine Ideal.sum_mem (m_B ^ (d + 1)) fun k _ => ?_
          rw [pow_succ']
          refine Ideal.mul_mem_mul (hγ k) ?_
          have hkd : m_B ^ (k : ℕ) * m_B ^ (d - (k : ℕ)) = m_B ^ d := by
            rw [← pow_add, Nat.add_sub_of_le (Nat.le_of_lt_succ k.isLt)]
          have hm := Ideal.mul_mem_mul (Ideal.pow_mem_pow hζ₁_mem (k : ℕ))
            (Ideal.pow_mem_pow hζ₂_mem (d - (k : ℕ)))
          rwa [hkd] at hm
        have heq : MvPolynomial.aeval ![ζ₁, ζ₂] P =
            (∑ k : Fin (d + 1), c k * ζ₁ ^ (k : ℕ) * ζ₂ ^ (d - (k : ℕ))) -
            ((∑ k : Fin (d + 1), c k * ζ₁ ^ (k : ℕ) * ζ₂ ^ (d - (k : ℕ))) -
              MvPolynomial.aeval ![ζ₁, ζ₂] P) := by ring
        rw [heq]
        exact (m_B ^ (d + 1)).sub_mem hc_sum hdiff_mem
      have hLN_ev_w : MvPolynomial.aeval ![w₁, w₂] (L_N P) ∈ m_B ^ (d + 1) := by
        rw [hev_LN]
        have hcongr := h_aeval_congr hζ₁_mem hζ₂_mem hyN0_mem hyN1_mem hζ₁_yN0 hζ₂_yN1 hP_hom
        have heq : MvPolynomial.aeval ![y_N0, y_N1] P =
            MvPolynomial.aeval ![ζ₁, ζ₂] P -
            (MvPolynomial.aeval ![ζ₁, ζ₂] P - MvPolynomial.aeval ![y_N0, y_N1] P) := by ring
        rw [heq]
        exact (m_B ^ (d + 1)).sub_mem hP_ev_ζ hcongr
      have hLN_zero : L_N P = 0 :=
        hw_IsHom_zero (hIsHom_aeval_lin n00 n01 n10 n11 hP_hom) hLN_ev_w
      have hP_zero : P = 0 := by rw [← hLM_LN P, hLN_zero, map_zero]
      have hγ_zero := hIsHom_eq_zero γ hP_zero
      intro k
      have hk := hγ k
      rw [hγ_zero k, map_zero, sub_zero] at hk
      exact hk
    have h_pow_span_two : ∀ {R : Type u} [CommRing R] (x y : R) (r : ℕ) (z : R),
        z ∈ (Ideal.span ({x, y} : Set R)) ^ r →
        ∃ d : Fin (r + 1) → R, z = ∑ k : Fin (r + 1), d k * x ^ (k : ℕ) * y ^ (r - (k : ℕ)) := by
      intro R _ x y r
      induction r with
      | zero =>
        intro z _; refine ⟨fun _ => z, ?_⟩; simp
      | succ r ih =>
        intro z hz_in
        rw [pow_succ', Set.insert_eq x {y}, Ideal.span_union, Ideal.sup_mul] at hz_in
        obtain ⟨zx, hzx, zy, hzy, rfl⟩ := Submodule.mem_sup.mp hz_in
        rw [← Ideal.span_union, ← Set.insert_eq x {y}] at hzx hzy
        obtain ⟨ux, hux_mem, rfl⟩ := h_span_mul_mem x _ zx hzx
        obtain ⟨uy, huy_mem, rfl⟩ := h_span_mul_mem y _ zy hzy
        obtain ⟨dx, rfl⟩ := ih ux hux_mem
        obtain ⟨dy, rfl⟩ := ih uy huy_mem
        let dx' : Fin (r + 2) → R := @Fin.cases (r + 1) (fun _ => R) 0 dx
        let dy' : Fin (r + 2) → R := @Fin.snoc (r + 1) (fun _ => R) dy 0
        refine ⟨dx' + dy', ?_⟩
        have h1 : x * (∑ k : Fin (r + 1), dx k * x ^ (k : ℕ) * y ^ (r - (k : ℕ))) =
            ∑ k : Fin (r + 2), dx' k * x ^ (k : ℕ) * y ^ (r + 1 - (k : ℕ)) := by
          symm
          rw [Fin.sum_univ_succ, Finset.mul_sum]
          simp only [dx', Fin.cases_zero, zero_mul, zero_add, Fin.cases_succ,
            Fin.val_succ, Nat.succ_sub_succ_eq_sub]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [pow_succ']; ring
        have h2 : y * (∑ k : Fin (r + 1), dy k * x ^ (k : ℕ) * y ^ (r - (k : ℕ))) =
            ∑ k : Fin (r + 2), dy' k * x ^ (k : ℕ) * y ^ (r + 1 - (k : ℕ)) := by
          symm
          rw [Fin.sum_univ_castSucc, Finset.mul_sum]
          simp only [dy', Fin.snoc_last, zero_mul, add_zero, Fin.snoc_castSucc, Fin.val_castSucc]
          refine Finset.sum_congr rfl fun j _ => ?_
          have hsub : r + 1 - (j : ℕ) = (r - (j : ℕ)) + 1 := by omega
          rw [hsub, pow_succ]; ring
        rw [h1, h2, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun k _ => ?_
        simp only [Pi.add_apply]; ring
    have h_approx : ∀ (r : ℕ) (b : B), ∃ a : A, b - θ a ∈ m_B ^ r := by
      intro r b
      induction r with
      | zero => exact ⟨0, by simp⟩
      | succ r ih =>
        obtain ⟨a_r, ha_r⟩ := ih
        obtain ⟨d, hd_eq⟩ := h_pow_span_two ζ₁ ζ₂ r (b - θ a_r) (hmB_ζ ▸ ha_r)
        choose γ hγ using fun k : Fin (r + 1) => hres_B (d k)
        refine ⟨a_r + ∑ k : Fin (r + 1), c_A (γ k) * z₁ ^ (k : ℕ) * z₂ ^ (r - (k : ℕ)), ?_⟩
        have hc_apply : ∀ c : Ω, θ (c_A c) = c_B c := fun c => RingHom.congr_fun hc_comm c
        have hdiff : b - θ (a_r + ∑ k : Fin (r + 1), c_A (γ k) * z₁ ^ (k : ℕ) * z₂ ^ (r - (k : ℕ))) =
            ∑ k : Fin (r + 1), (d k - c_B (γ k)) * (ζ₁ ^ (k : ℕ) * ζ₂ ^ (r - (k : ℕ))) := by
          calc b - θ (a_r + ∑ k : Fin (r + 1), c_A (γ k) * z₁ ^ (k : ℕ) * z₂ ^ (r - (k : ℕ)))
              = (b - θ a_r) - θ (∑ k : Fin (r + 1), c_A (γ k) * z₁ ^ (k : ℕ) * z₂ ^ (r - (k : ℕ))) := by
                rw [map_add]; ring
            _ = (∑ k : Fin (r + 1), d k * ζ₁ ^ (k : ℕ) * ζ₂ ^ (r - (k : ℕ))) -
                (∑ k : Fin (r + 1), c_B (γ k) * ζ₁ ^ (k : ℕ) * ζ₂ ^ (r - (k : ℕ))) := by
                rw [hd_eq]; simp only [map_sum, map_mul, map_pow, hc_apply, ζ₁, ζ₂]
            _ = ∑ k : Fin (r + 1), (d k - c_B (γ k)) * (ζ₁ ^ (k : ℕ) * ζ₂ ^ (r - (k : ℕ))) := by
                rw [← Finset.sum_sub_distrib]
                exact Finset.sum_congr rfl fun k _ => by ring
        rw [hdiff]
        refine Ideal.sum_mem (m_B ^ (r + 1)) fun k _ => ?_
        rw [pow_succ']
        refine Ideal.mul_mem_mul (hγ k) ?_
        have hkr : m_B ^ (k : ℕ) * m_B ^ (r - (k : ℕ)) = m_B ^ r := by
          rw [← pow_add, Nat.add_sub_of_le (Nat.le_of_lt_succ k.isLt)]
        have hm := Ideal.mul_mem_mul (Ideal.pow_mem_pow hζ₁_mem (k : ℕ))
          (Ideal.pow_mem_pow hζ₂_mem (r - (k : ℕ)))
        rwa [hkr] at hm
    have h_filt : ∀ (r : ℕ) (a : A), θ a ∈ m_B ^ r → a ∈ m_A ^ r := by
      intro r
      induction r with
      | zero => intro a _; simp
      | succ r ih =>
        intro a hθa
        have hθa_r : θ a ∈ m_B ^ r :=
          Ideal.pow_le_pow_right (Nat.le_succ r) hθa
        have ha_r0 : a ∈ m_A ^ r := ih a hθa_r
        have ha_r : a ∈ (Ideal.span ({z₁, z₂} : Set A)) ^ r := by
          rw [← hz, ← hmA_def]; exact ha_r0
        obtain ⟨d, rfl⟩ := h_pow_span_two z₁ z₂ r a ha_r
        have hsum_B : (∑ k : Fin (r + 1), θ (d k) * ζ₁ ^ (k : ℕ) * ζ₂ ^ (r - (k : ℕ))) ∈ m_B ^ (r + 1) := by
          simpa [map_sum, map_mul, map_pow, ζ₁, ζ₂] using hθa
        have hd_mB := hζ_hom_reg r (fun k => θ (d k)) hsum_B
        refine Ideal.sum_mem (m_A ^ (r + 1)) fun k _ => ?_
        rw [mul_assoc, pow_succ']
        refine Ideal.mul_mem_mul (h_comap_mB (d k) (hd_mB k)) ?_
        have hkr : m_A ^ (k : ℕ) * m_A ^ (r - (k : ℕ)) = m_A ^ r := by
          rw [← pow_add, Nat.add_sub_of_le (Nat.le_of_lt_succ k.isLt)]
        have hm := Ideal.mul_mem_mul (Ideal.pow_mem_pow hz₁_mem (k : ℕ))
          (Ideal.pow_mem_pow hz₂_mem (r - (k : ℕ)))
        rwa [hkr] at hm
    intro b
    obtain ⟨f, g, hg_ne, hgb_eq⟩ := hbir b
    let I_g : Ideal A := Ideal.span ({g} : Set A)
    have hmA_ne_top : m_A ≠ ⊤ := by
      intro htop
      apply IsLocalRing.notMem_maximalIdeal.mpr (isUnit_one (M := A))
      rw [← hmA_def, htop]; trivial
    have hkrull := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing
      (M := A ⧸ I_g) m_A hmA_ne_top
    have hf_in_iInf : Ideal.Quotient.mk I_g f ∈
        ⨅ r : ℕ, m_A ^ r • (⊤ : Submodule A (A ⧸ I_g)) := by
      rw [Submodule.mem_iInf]
      intro r
      obtain ⟨a_r, ha_r⟩ := h_approx r b
      have hθ_fg : θ (f - g * a_r) ∈ m_B ^ r := by
        have heq : θ (f - g * a_r) = θ g * (b - θ a_r) := by
          rw [map_sub, map_mul, ← hgb_eq]; ring
        rw [heq]
        exact (m_B ^ r).mul_mem_left _ ha_r
      have hfg_mA : f - g * a_r ∈ m_A ^ r := h_filt r (f - g * a_r) hθ_fg
      have hq_eq : Ideal.Quotient.mk I_g f = (f - g * a_r) • Ideal.Quotient.mk I_g 1 := by
        change Ideal.Quotient.mk I_g f = Ideal.Quotient.mk I_g ((f - g * a_r) * 1)
        rw [mul_one, map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.mem_span_singleton.mpr ⟨a_r, rfl⟩), sub_zero]
      rw [hq_eq]
      exact Submodule.smul_mem_smul hfg_mA trivial
    rw [hkrull, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hf_in_iInf
    obtain ⟨a, rfl⟩ := hf_in_iInf
    refine ⟨a, ?_⟩
    have hθg_ne : θ g ≠ 0 := fun h0 => hg_ne (hθ_inj (h0.trans (map_zero θ).symm))
    apply mul_left_cancel₀ hθg_ne
    rw [← map_mul, hgb_eq]
  
  obtain ⟨hCompGen, hCardLe, hCardStep⟩ :=
    weil_nc2d_specialFiber_components_ncard_and_blowup_lt Ω n
  have hNormW := hNorm W g_W τ_W hW
  let c_W : ℕ := (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_W s_Ω)).ncard
  have hInd : ∀ (M : ℕ)
      (Y : AlgebraicGeometry.Scheme.{u})
      (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
      (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g_Y η_K)
      (h : W ⟶ Y),
      IsNC2DPointedSurface Ω n g_Y τ_Y →
      α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y η_K =
        CategoryTheory.Limits.pullback.snd g_W η_K →
      h ≫ g_Y = g_W →
      (∀ j : Fin n, τ_W j ≫ h = τ_Y j) →
      CategoryTheory.Limits.pullback.fst g_W η_K ≫ h =
        α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K →
      c_W ≤ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard + M →
      ∃ (ℓ : ℕ)
        (Y_tail : Fin ℓ → AlgebraicGeometry.Scheme.{u})
        (gY_tail : ∀ j : Fin ℓ, Y_tail j ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τY_tail : ∀ j : Fin ℓ, Fin n →
          (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y_tail j))
        (centersY : ∀ i : Fin ℓ,
          ↥(CategoryTheory.Limits.pullback
            ((@Fin.cases ℓ
              (fun i => (@Fin.cases ℓ (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y_tail i) ⟶
                AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
              g_Y gY_tail) i.castSucc) s_Ω))
        (mapsY : ∀ i : Fin ℓ,
          (@Fin.cases ℓ (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y_tail) i.succ ⟶
            (@Fin.cases ℓ (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y_tail) i.castSucc)
        (ρ_tail : ∀ j : Fin ℓ, Y_tail j ⟶ Y),
        let Y_seq : Fin (ℓ + 1) → AlgebraicGeometry.Scheme.{u} :=
          @Fin.cases ℓ (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y_tail
        let gY_seq : ∀ i : Fin (ℓ + 1), Y_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
          @Fin.cases ℓ (fun i => Y_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))) g_Y gY_tail
        let τY_seq : ∀ i : Fin (ℓ + 1), Fin n →
            (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y_seq i) :=
          @Fin.cases ℓ (fun i => Fin n →
            (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y_seq i)) τ_Y τY_tail
        let ρ_from : ∀ i : Fin (ℓ + 1), Y_seq i ⟶ Y :=
          @Fin.cases ℓ (fun i => Y_seq i ⟶ Y) (𝟙 Y) ρ_tail
        ∃ (h_ℓ : W ≅ Y_seq (Fin.last ℓ)),
          IsNC2DBlowupTower Ω n g_Y τ_Y ℓ Y_seq gY_seq τY_seq centersY mapsY ρ_from ∧
          h_ℓ.hom ≫ gY_seq (Fin.last ℓ) = g_W ∧
          h_ℓ.hom ≫ ρ_from (Fin.last ℓ) = h ∧
          (∀ j : Fin n, τ_W j ≫ h_ℓ.hom = τY_seq (Fin.last ℓ) j) := by
    intro M
    induction M with
    | zero =>
      intro Y g_Y τ_Y α_K h hY hαK_snd hh_comm hh_sec hh_gen hM
      by_cases hIso : CategoryTheory.IsIso h
      · refine ⟨0, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0,
          fun i => i.elim0, fun i => i.elim0, fun i => i.elim0, ?_⟩
        dsimp only
        refine ⟨@CategoryTheory.asIso _ _ _ _ h hIso,
          ⟨hY, (inferInstance : CategoryTheory.IsIso (𝟙 Y)), CategoryTheory.Category.id_comp g_Y,
            fun j => CategoryTheory.Category.comp_id (τ_Y j),
            fun i => i.elim0, fun i => i.elim0⟩,
          hh_comm, CategoryTheory.Category.comp_id h, hh_sec⟩
      · obtain ⟨q₀, hq₀_cl, hq₀_notSurj⟩ :=
          weil_nc2d_exists_nonIso_closedPoint_and_local_birational_not_surj
            Ω n W Y g_W τ_W g_Y τ_Y α_K h hW hY hαK_snd hh_comm hh_gen hIso
        obtain ⟨Y₁, g_Y₁, τ_Y₁, ρ₁, hBlow₁⟩ := hBlowup Y g_Y τ_Y q₀ hY hq₀_cl
        obtain ⟨α₁, h₁, _, hh₁_g, _, _, hh₁_gen⟩ :=
          weil_nc2d_blowup_nonclosed_centers_and_lift
            Ω n W Y Y₁ g_W τ_W g_Y τ_Y g_Y₁ τ_Y₁ α_K h q₀ ρ₁
            hW hY hBlow₁ hαK_snd hh_comm hh_sec hh_gen hNormW
            (hCompGen Y₁ g_Y₁ τ_Y₁ hBlow₁.2.1).2 hq₀_notSurj hLocalSurj
            (fun β_K => hDom W Y₁ g_W τ_W g_Y₁ τ_Y₁ β_K hW hBlow₁.2.1 hNormW)
        have hc_le :
            (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y₁ s_Ω)).ncard ≤ c_W :=
          hCardLe W Y₁ g_W τ_W g_Y₁ τ_Y₁ α₁ h₁ hW hBlow₁.2.1 hh₁_g hh₁_gen
        have hc_lt :
            (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard + 1 ≤
              (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y₁ s_Ω)).ncard :=
          hCardStep Y Y₁ g_Y τ_Y g_Y₁ τ_Y₁ q₀ ρ₁ hY hBlow₁
        omega
    | succ M ih =>
      intro Y g_Y τ_Y α_K h hY hαK_snd hh_comm hh_sec hh_gen hM
      by_cases hIso : CategoryTheory.IsIso h
      · refine ⟨0, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0,
          fun i => i.elim0, fun i => i.elim0, fun i => i.elim0, ?_⟩
        dsimp only
        refine ⟨@CategoryTheory.asIso _ _ _ _ h hIso,
          ⟨hY, (inferInstance : CategoryTheory.IsIso (𝟙 Y)), CategoryTheory.Category.id_comp g_Y,
            fun j => CategoryTheory.Category.comp_id (τ_Y j),
            fun i => i.elim0, fun i => i.elim0⟩,
          hh_comm, CategoryTheory.Category.comp_id h, hh_sec⟩
      · obtain ⟨q₀, hq₀_cl, hq₀_notSurj⟩ :=
          weil_nc2d_exists_nonIso_closedPoint_and_local_birational_not_surj
            Ω n W Y g_W τ_W g_Y τ_Y α_K h hW hY hαK_snd hh_comm hh_gen hIso
        obtain ⟨Y₁, g_Y₁, τ_Y₁, ρ₁, hBlow₁⟩ := hBlowup Y g_Y τ_Y q₀ hY hq₀_cl
        obtain ⟨α₁, h₁, hα₁_snd, hh₁_g, hh₁_ρ, hh₁_sec, hh₁_gen⟩ :=
          weil_nc2d_blowup_nonclosed_centers_and_lift
            Ω n W Y Y₁ g_W τ_W g_Y τ_Y g_Y₁ τ_Y₁ α_K h q₀ ρ₁
            hW hY hBlow₁ hαK_snd hh_comm hh_sec hh_gen hNormW
            (hCompGen Y₁ g_Y₁ τ_Y₁ hBlow₁.2.1).2 hq₀_notSurj hLocalSurj
            (fun β_K => hDom W Y₁ g_W τ_W g_Y₁ τ_Y₁ β_K hW hBlow₁.2.1 hNormW)
        have hc_lt :
            (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard + 1 ≤
              (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y₁ s_Ω)).ncard :=
          hCardStep Y Y₁ g_Y τ_Y g_Y₁ τ_Y₁ q₀ ρ₁ hY hBlow₁
        have hc_M :
            c_W ≤ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y₁ s_Ω)).ncard + M := by
          omega
        obtain ⟨ℓ', Y'_tail, gY'_tail, τY'_tail, centersY', mapsY', ρ'_tail,
            h_ℓ', hTower', hhℓ'_g, hhℓ'_ρ, hhℓ'_sec⟩ :=
          ih Y₁ g_Y₁ τ_Y₁ α₁ h₁ hBlow₁.2.1 hα₁_snd hh₁_g hh₁_sec hh₁_gen hc_M
        let Y'_seq : Fin (ℓ' + 1) → AlgebraicGeometry.Scheme.{u} :=
          @Fin.cases ℓ' (fun _ => AlgebraicGeometry.Scheme.{u}) Y₁ Y'_tail
        let gY'_seq : ∀ j : Fin (ℓ' + 1), Y'_seq j ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
          @Fin.cases ℓ' (fun j => Y'_seq j ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))) g_Y₁ gY'_tail
        let τY'_seq : ∀ j : Fin (ℓ' + 1), Fin n →
            (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y'_seq j) :=
          @Fin.cases ℓ' (fun j => Fin n →
            (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y'_seq j)) τ_Y₁ τY'_tail
        let ρ'_from : ∀ j : Fin (ℓ' + 1), Y'_seq j ⟶ Y₁ :=
          @Fin.cases ℓ' (fun j => Y'_seq j ⟶ Y₁) (𝟙 Y₁) ρ'_tail
        refine ⟨ℓ' + 1, Y'_seq, gY'_seq, τY'_seq,
          @Fin.cases ℓ'
            (fun i => ↥(CategoryTheory.Limits.pullback
              ((@Fin.cases (ℓ' + 1)
                (fun k => (@Fin.cases (ℓ' + 1) (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y'_seq k) ⟶
                  AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
                g_Y gY'_seq) i.castSucc) s_Ω))
            q₀ centersY',
          @Fin.cases ℓ'
            (fun i =>
              (@Fin.cases (ℓ' + 1) (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y'_seq) i.succ ⟶
                (@Fin.cases (ℓ' + 1) (fun _ => AlgebraicGeometry.Scheme.{u}) Y Y'_seq) i.castSucc)
            ρ₁ mapsY',
          fun j => ρ'_from j ≫ ρ₁, ?_⟩
        dsimp only
        rw [← Fin.succ_last ℓ']
        refine ⟨h_ℓ', ?_, hhℓ'_g, ?_, hhℓ'_sec⟩
        · refine ⟨hY, (inferInstance : CategoryTheory.IsIso (𝟙 Y)),
            CategoryTheory.Category.id_comp g_Y,
            fun j => CategoryTheory.Category.comp_id (τ_Y j), ?_, ?_⟩
          · intro i
            refine Fin.cases ?_ ?_ i
            · change ρ₁ ≫ 𝟙 Y = 𝟙 Y₁ ≫ ρ₁
              rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            · intro j
              change mapsY' j ≫ (ρ'_from j.castSucc ≫ ρ₁) = ρ'_from j.succ ≫ ρ₁
              rw [← CategoryTheory.Category.assoc, hTower'.2.2.2.2.1 j]
          · intro i
            refine Fin.cases ?_ ?_ i
            · exact hBlow₁
            · intro j
              exact hTower'.2.2.2.2.2 j
        · change h_ℓ'.hom ≫ (ρ'_from (Fin.last ℓ') ≫ ρ₁) = h
          rw [← CategoryTheory.Category.assoc, hhℓ'_ρ, hh₁_ρ]
  obtain ⟨ℓ, Y_tail, gY_tail, τY_tail, centersY, mapsY, ρ_tail,
      h_ℓ, hTower, hhℓ_g, hhℓ_ρ, hhℓ_sec⟩ :=
    hInd c_W Y g_Y τ_Y α_K h hY hαK_snd hh_comm hh_sec hh_gen (Nat.le_add_left c_W _)
  exact ⟨ℓ, _, _, _, centersY, mapsY, _, h_ℓ, hTower, hhℓ_g, hhℓ_ρ, hhℓ_sec⟩

theorem weil_nc2d_nonfactor_noncontracted_and_specialFiber_components (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    (∀ (W_prev W_top C₂ : AlgebraicGeometry.Scheme.{u})
       (g_prev : W_prev ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_prev : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_prev))
       (g_top : W_top ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_top : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_top))
       (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (q_center : ↥(CategoryTheory.Limits.pullback g_prev s_Ω))
       (π_last : W_top ⟶ W_prev)
       (h : W_top ⟶ C₂)
       (h₀ : CategoryTheory.Limits.pullback g_top s_Ω ⟶ CategoryTheory.Limits.pullback g₂ s_Ω)
       (E_exc : Set ↥(CategoryTheory.Limits.pullback g_top s_Ω)),
      IsNC2DClosedPointBlowup Ω n g_prev τ_prev g_top τ_top q_center π_last →
      (¬ ∃ h' : W_prev ⟶ C₂, π_last ≫ h' = h) →
      h₀ ≫ CategoryTheory.Limits.pullback.fst g₂ s_Ω =
        CategoryTheory.Limits.pullback.fst g_top s_Ω ≫ h →
      π_last.base ⁻¹' {(CategoryTheory.Limits.pullback.fst g_prev s_Ω).base q_center} =
        (CategoryTheory.Limits.pullback.fst g_top s_Ω).base '' E_exc →
      ¬ (h₀.base '' E_exc).Subsingleton) ∧
    (∀ (Z : AlgebraicGeometry.Scheme.{u})
       (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
       (F : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω)),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      IsClosed F →
      IsIrreducible F →
      ¬ F.Subsingleton →
      F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω)) ∧
    (∀ (Z : AlgebraicGeometry.Scheme.{u})
       (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
       (E₁ E₂ : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω))
       (q : ↥(CategoryTheory.Limits.pullback g_Z s_Ω)),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω) →
      E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω) →
      E₁ ≠ E₂ →
      q ∈ E₁ →
      q ∈ E₂ →
      IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω)) ∧
        ∃ a b : ℕ, 1 ≤ b ∧ HasNCBranchAt Ω g_Z q a b) :=
by
  classical
  intro s_Ω
  have : AlgebraicGeometry.IsClosedImmersion s_Ω :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _
      (fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩)
  
  have hStein : ∀ (X Y C : AlgebraicGeometry.Scheme.{u})
      (π : X ⟶ Y) (h : X ⟶ C),
      AlgebraicGeometry.IsProper π →
      AlgebraicGeometry.Surjective π →
      (∀ V : Y.Opens, CategoryTheory.IsIso (π.app V)) →
      (∀ x₁ x₂ : ↥X, π.base x₁ = π.base x₂ → h.base x₁ = h.base x₂) →
      ∃ h' : Y ⟶ C, π ≫ h' = h := by
    intro X Y C π h hProper hSurj hAppIso hConst
    have : AlgebraicGeometry.IsProper π := hProper
    have hq : Topology.IsQuotientMap ⇑π.base.hom :=
      π.isClosedMap.isQuotientMap π.base.hom.continuous hSurj.surj
    have hFact : Function.FactorsThrough ⇑h.base.hom ⇑π.base.hom :=
      fun x₁ x₂ hx => hConst x₁ x₂ hx
    let b_cont : C(↑Y.toPresheafedSpace, ↑C.toPresheafedSpace) := hq.lift h.base.hom hFact
    have hb_comp : b_cont.comp π.base.hom = h.base.hom := hq.lift_comp h.base.hom hFact
    let b_top : Y.toPresheafedSpace.carrier ⟶ C.toPresheafedSpace.carrier := TopCat.ofHom b_cont
    have hb_base : π.toLRSHom.toHom.base ≫ b_top = h.toLRSHom.toHom.base := by
      ext x
      exact DFunLike.congr_fun hb_comp x
    let V_U : C.Opens → Y.Opens := fun U => (TopologicalSpace.Opens.map b_top).obj U
    have heq_U : ∀ U : C.Opens,
        (TopologicalSpace.Opens.map h.base).obj U =
          (TopologicalSpace.Opens.map π.base).obj (V_U U) := by
      intro U
      ext x
      change h.base.hom x ∈ U ↔ b_cont (π.base.hom x) ∈ U
      rw [← ContinuousMap.comp_apply, hb_comp]
    let c_bar : C.presheaf ⟶
        (TopCat.Presheaf.pushforward CommRingCat.{u} b_top).obj Y.presheaf :=
      { app := fun U_op =>
          letI := hAppIso (V_U U_op.unop)
          h.app U_op.unop ≫
