        have hπx_zero : π_bar ^ b * x = 0 := by
          apply hu_unit.mul_right_cancel
          calc (π_bar ^ b * x) * u = x * (π_bar ^ b * u) := by ring
            _ = 0 := hxy
            _ = 0 * u := (zero_mul u).symm
        have hsmul_zero : (π₀ ^ b) • x = 0 := by
          rw [Algebra.smul_def, map_pow]
          exact hπx_zero
        exact hx_ne ((smul_eq_zero.mp hsmul_zero).resolve_left (hπ₀_pow_ne b))
      exact IsDomain.mk

  
  have h_irred_dim1 : ∀ (K : Type u) [Field K] (F : AlgebraicGeometry.Scheme.{u})
