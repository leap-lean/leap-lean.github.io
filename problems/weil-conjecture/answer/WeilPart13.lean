      refine RingHom.ext fun z => ?_
      refine TensorProduct.inductionOn
        (motive := fun z =>
          μ₁ (piMap z) =
            Algebra.TensorProduct.lift (AlgHom.id K K) (j₁.comp π₁) (fun _ _ => mul_comm _ _) z)
        z (fun _ _ => rfl) (fun z₁ z₂ ih₁ ih₂ => by simp [map_add, ih₁, ih₂])
