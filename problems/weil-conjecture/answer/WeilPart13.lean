  obtain ⟨inv_C, hinv_base, hinv_gen⟩ :=
    hGlue C₂ C₁ g₂ g₁ hDom₂ φ_L.inv w₂ hw₂_fst (fun q => (φ_h q).inv) hφh_inv_snd hw₂_φh_inv
  have h_hom_inv : hom_C ≫ inv_C = 𝟙 C₁ := by
    have : AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g₁ η_L) := hDom₁
    refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₁ ?_
      (CategoryTheory.Limits.pullback.fst g₁ η_L) ?_
    · rw [CategoryTheory.Category.assoc, hinv_base, hhom_base, CategoryTheory.Category.id_comp]
    · rw [← CategoryTheory.Category.assoc, hhom_gen, CategoryTheory.Category.assoc, hinv_gen,
        ← CategoryTheory.Category.assoc, φ_L.hom_inv_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
  have h_inv_hom : inv_C ≫ hom_C = 𝟙 C₂ := by
    have : AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g₂ η_L) := hDom₂
    refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₂ ?_
      (CategoryTheory.Limits.pullback.fst g₂ η_L) ?_
    · rw [CategoryTheory.Category.assoc, hhom_base, hinv_base, CategoryTheory.Category.id_comp]
    · rw [← CategoryTheory.Category.assoc, hinv_gen, CategoryTheory.Category.assoc, hhom_gen,
        ← CategoryTheory.Category.assoc, φ_L.inv_hom_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
  let φ : C₁ ≅ C₂ :=
    { hom := hom_C
      inv := inv_C
      hom_inv_id := h_hom_inv
      inv_hom_id := h_inv_hom }
  have hV_eq : V₁.ι ≫ φ.hom = φ₀.hom ≫ V₂.ι := by
    have : AlgebraicGeometry.IsReduced V₁.toScheme :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion V₁.ι
    have : AlgebraicGeometry.IsDominant (ι₁_L ≫ V₁.ι) := hι₁_fst.symm ▸ hDom₁
    have : AlgebraicGeometry.IsDominant ι₁_L :=
      AlgebraicGeometry.IsDominant.of_comp_of_isOpenImmersion ι₁_L V₁.ι
    refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₂ ?_ ι₁_L ?_
    · rw [CategoryTheory.Category.assoc, hhom_base, CategoryTheory.Category.assoc, hφ₀_base']
    · calc ι₁_L ≫ (V₁.ι ≫ φ.hom)
          = CategoryTheory.Limits.pullback.fst g₁ η_L ≫ hom_C := by
              rw [← CategoryTheory.Category.assoc, hι₁_fst]
        _ = φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L := hhom_gen
        _ = ι₁_L ≫ (φ₀.hom ≫ V₂.ι) := hφL_ι₁
  have : AlgebraicGeometry.IsIntegral S :=
    (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of B₀)).mpr ‹IsDomain B₀›
  have : AlgebraicGeometry.IsReduced S := AlgebraicGeometry.isReduced_of_isIntegral S
  have : AlgebraicGeometry.IsDominant U₀.ι := hDom_U₀
  have hφ_sec : ∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j := by
    intro j
    refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₂ ?_ U₀.ι ?_
    · rw [CategoryTheory.Category.assoc, hhom_base, hSec₁ j, hSec₂ j]
    · calc U₀.ι ≫ (τ₁ j ≫ φ.hom)
          = (U₀.ι ≫ τ₁ j) ≫ φ.hom := by rw [CategoryTheory.Category.assoc]
        _ = (s₁_U₀ j ≫ V₁.ι) ≫ φ.hom := by rw [hs₁_U₀ j]
        _ = s₁_U₀ j ≫ (V₁.ι ≫ φ.hom) := by rw [CategoryTheory.Category.assoc]
        _ = (s₁_U₀ j ≫ φ₀.hom) ≫ V₂.ι := by rw [hV_eq, CategoryTheory.Category.assoc]
        _ = U₀.ι ≫ τ₂ j := hφ₀_sec' j (s₁_U₀ j) (hs₁_U₀ j)
  exact ⟨φ, hhom_base, hφ_sec, hV_eq⟩

theorem weil_overlap_pointed_iso_cocycle_from_affine_ext (k : Type u) [Field k]
    (B₂ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₃ : B₃.left.Opens)
    (ψ₃ : B₃ ⟶ B₂)
    (hIntB₃ : AlgebraicGeometry.IsIntegral B₃.left)
    (hFTB₃ : AlgebraicGeometry.LocallyOfFiniteType B₃.hom)
    (hNormB₃ : ∀ U : B₃.left.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      IsIntegrallyClosed ↑(B₃.left.presheaf.obj (Opposite.op U)))
    (hU₃ : Nonempty U₃)
    (N : ℕ)
    (W : Fin N → B₃.left.Opens)
    (hWNonempty : ∀ a : Fin N, Nonempty ↥(W a))
    (C_loc : Fin N → AlgebraicGeometry.Scheme.{u})
    (g_loc : ∀ a : Fin N, C_loc a ⟶ (W a).toScheme)
    (τ_loc : ∀ a : Fin N, Fin n → ((W a).toScheme ⟶ C_loc a))
    (hStabLoc : ∀ a : Fin N, IsGeometricStablePointedCurve (g_loc a) n (τ_loc a))
    (hIntLoc : ∀ a : Fin N, AlgebraicGeometry.IsIntegral (C_loc a))
    (hSmLoc : ∀ a : Fin N,
      let U_Wa : (W a).toScheme.Opens := (TopologicalSpace.Opens.map (W a).ι.base).obj U₃
      AlgebraicGeometry.SmoothOfRelativeDimension 1 ((g_loc a) ∣_ U_Wa))
    (hIsoLoc : ∀ a : Fin N, HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ (W a) (g_loc a) (τ_loc a))
    (hStabPull : ∀ (C S S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (u : S' ⟶ S) (τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g u)),
      IsGeometricStablePointedCurve g n τ →
      (∀ j : Fin n,
        τ' j ≫ CategoryTheory.Limits.pullback.fst g u = u ≫ τ j ∧
        τ' j ≫ CategoryTheory.Limits.pullback.snd g u = 𝟙 S') →
      IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g u) n τ')
    (hStabIso : ∀ (C S C' S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (g' : C' ⟶ S') (τ' : Fin n → (S' ⟶ C')) (e_C : C ≅ C') (e_S : S ≅ S'),
      IsGeometricStablePointedCurve g n τ →
      e_C.hom ≫ g' = g ≫ e_S.hom →
      (∀ j : Fin n, τ' j = e_S.inv ≫ τ j ≫ e_C.hom) →
      IsGeometricStablePointedCurve g' n τ')
    (hDomPull : ∀ (C S S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (u : S' ⟶ S),
      IsGeometricStablePointedCurve g n τ →
      AlgebraicGeometry.IsDominant u →
      AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g u))
    (hAffExt : ∀ (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsIntegrallyClosed B₀]
      [Algebra k B₀] [Algebra.FiniteType k B₀]
      (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
      (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
      (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₁))
      (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
      (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₂)),
      IsGeometricStablePointedCurve g₁ n τ₁ →
      IsGeometricStablePointedCurve g₂ n τ₂ →
      AlgebraicGeometry.IsIntegral C₁ →
      AlgebraicGeometry.IsIntegral C₂ →
      ∀ (U₀ : (AlgebraicGeometry.Spec (CommRingCat.of B₀)).Opens),
        Nonempty ↥U₀ →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (g₁ ∣_ U₀) →
        ∀ (φ₀ : AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map g₁.base).obj U₀) ≅
            AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map g₂.base).obj U₀)),
          (let V₁ : C₁.Opens := (TopologicalSpace.Opens.map g₁.base).obj U₀
           let V₂ : C₂.Opens := (TopologicalSpace.Opens.map g₂.base).obj U₀
           φ₀.hom ≫ V₂.ι ≫ g₂ = V₁.ι ≫ g₁) →
          (let V₁ : C₁.Opens := (TopologicalSpace.Opens.map g₁.base).obj U₀
           let V₂ : C₂.Opens := (TopologicalSpace.Opens.map g₂.base).obj U₀
           ∀ j : Fin n, ∀ (s₁ : U₀.toScheme ⟶ V₁.toScheme),
             s₁ ≫ V₁.ι = U₀.ι ≫ τ₁ j →
             (s₁ ≫ φ₀.hom) ≫ V₂.ι = U₀.ι ≫ τ₂ j) →
          let V₁ : C₁.Opens := (TopologicalSpace.Opens.map g₁.base).obj U₀
          let V₂ : C₂.Opens := (TopologicalSpace.Opens.map g₂.base).obj U₀
          ∃ (φ : C₁ ≅ C₂),
            φ.hom ≫ g₂ = g₁ ∧
            (∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j) ∧
            V₁.ι ≫ φ.hom = φ₀.hom ≫ V₂.ι) :
    ∃ (ι_loc : ∀ a : Fin N,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃) ⟶ X₂.left)
      (φ : ∀ a b : Fin N,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)) ≅
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a))),
      (∀ a : Fin N,
        let V_a : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃
        ∃ (hcomm_a : ι_loc a ≫ f₂.left = V_a.ι ≫ g_loc a ≫ (W a).ι ≫ ψ₃.left),
          AlgebraicGeometry.IsOpenImmersion
            (CategoryTheory.Limits.pullback.lift (ι_loc a) (V_a.ι ≫ g_loc a ≫ (W a).ι) hcomm_a) ∧
          Set.range (CategoryTheory.Limits.pullback.lift (ι_loc a) (V_a.ι ≫ g_loc a ≫ (W a).ι) hcomm_a).base =
            (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹'
              ((W a ⊓ U₃ : B₃.left.Opens) : Set B₃.left) ∧
          ∀ j : Fin n,
            ∃ s_a : (W a ⊓ U₃).toScheme ⟶ V_a.toScheme,
              s_a ≫ V_a.ι = B₃.left.homOfLE inf_le_left ≫ τ_loc a j ∧
              s_a ≫ ι_loc a = (W a ⊓ U₃).ι ≫ ψ₃.left ≫ (σ j).left) ∧
      (∀ a b : Fin N,
        let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
        let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
        (φ a b).hom ≫ O_ba.ι ≫ g_loc b ≫ (W b).ι = O_ab.ι ≫ g_loc a ≫ (W a).ι) ∧
      (∀ a : Fin N,
        let O_aa : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W a)
        (φ a a).hom = 𝟙 O_aa.toScheme) ∧
      (∀ a b c : Fin N,
        let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
        let O_ac : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W c)
        let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
        let O_bc : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W c)
        let O_cb : (C_loc c).Opens := (TopologicalSpace.Opens.map (g_loc c ≫ (W c).ι).base).obj (W b)
        let O_ca : (C_loc c).Opens := (TopologicalSpace.Opens.map (g_loc c ≫ (W c).ι).base).obj (W a)
        ∃ ψ_abc : (O_ab ⊓ O_ac).toScheme ⟶ O_bc.toScheme,
          ψ_abc ≫ O_bc.ι = (C_loc a).homOfLE inf_le_left ≫ (φ a b).hom ≫ O_ba.ι ∧
          ψ_abc ≫ (φ b c).hom ≫ O_cb.ι =
            (C_loc a).homOfLE inf_le_right ≫ (φ a c).hom ≫ O_ca.ι) ∧
      (∀ (a b : Fin N) (j : Fin n),
        let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
        let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
        ∃ (t_ab : (W a ⊓ W b).toScheme ⟶ O_ab.toScheme),
          t_ab ≫ O_ab.ι = B₃.left.homOfLE inf_le_left ≫ τ_loc a j ∧
          (t_ab ≫ (φ a b).hom) ≫ O_ba.ι = B₃.left.homOfLE inf_le_right ≫ τ_loc b j) ∧
      (∀ a b : Fin N,
        let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
        let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
        let V_a : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃
        let V_b : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj U₃
        ∃ (φ_U₃ : (O_ab ⊓ V_a).toScheme ⟶ V_b.toScheme),
          φ_U₃ ≫ V_b.ι = (C_loc a).homOfLE inf_le_left ≫ (φ a b).hom ≫ O_ba.ι ∧
          φ_U₃ ≫ ι_loc b = (C_loc a).homOfLE inf_le_right ≫ ι_loc a) :=
by
  let _ := hDomPull
  let S : AlgebraicGeometry.Scheme.{u} := B₃.left
  have : AlgebraicGeometry.IsIntegral S := hIntB₃
  have : IrreducibleSpace ↥S := irreducibleSpace_of_isIntegral S
  have hPropLoc : ∀ a : Fin N, AlgebraicGeometry.IsProper (g_loc a) :=
    fun a => (hStabLoc a).2.2.1
  have hSurjLoc : ∀ a : Fin N, AlgebraicGeometry.Surjective (g_loc a) :=
    fun a => (hStabLoc a).2.2.2.2.1
  have hSecLoc : ∀ (a : Fin N) (j : Fin n), τ_loc a j ≫ g_loc a = 𝟙 (W a).toScheme :=
    fun a j => (hStabLoc a).2.2.2.2.2.1 j
  let O_loc (a b : Fin N) : (C_loc a).Opens :=
    (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
  let V_loc (a : Fin N) : (C_loc a).Opens :=
    (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃

  
  have mem_of_ι : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens) (z : ↥U.toScheme),
      U.ι z ∈ U := by
    intro X U z
    change U.ι z ∈ (U : Set ↥X)
    rw [← Scheme.Opens.range_ι]
    exact ⟨z, rfl⟩
  have lift_mem_ι : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens) {x : ↥X},
      x ∈ U → ∃ z : ↥U.toScheme, U.ι z = x := by
    intro X U x hx
    change x ∈ (U : Set ↥X) at hx
    rwa [← Scheme.Opens.range_ι] at hx
  have openImm_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
      [AlgebraicGeometry.IsOpenImmersion f] [AlgebraicGeometry.IsOpenImmersion g],
      AlgebraicGeometry.IsOpenImmersion (f ≫ g) :=
    fun f g => MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion) f g
      inferInstance inferInstance
  have sep_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
      [AlgebraicGeometry.IsSeparated f] [AlgebraicGeometry.IsSeparated g],
      AlgebraicGeometry.IsSeparated (f ≫ g) :=
    fun f g => MorphismProperty.comp_mem (@AlgebraicGeometry.IsSeparated) f g
      inferInstance inferInstance
  have hSepBase : ∀ a : Fin N, AlgebraicGeometry.IsSeparated (g_loc a ≫ (W a).ι) := fun a => by
    have : AlgebraicGeometry.IsProper (g_loc a) := hPropLoc a
    have : AlgebraicGeometry.IsSeparated (g_loc a) := IsProper.toIsSeparated
    exact sep_comp (g_loc a) (W a).ι
  have ext_on_nonempty_open : ∀ {Y₀ W_sub X Y Z : AlgebraicGeometry.Scheme.{u}},
      AlgebraicGeometry.IsIntegral Y₀ →
      ∀ (j_X : X ⟶ Y₀) [AlgebraicGeometry.IsOpenImmersion j_X]
        (ι : W_sub ⟶ X) [AlgebraicGeometry.IsOpenImmersion ι],
        Nonempty ↥W_sub →
        ∀ (s : Y ⟶ Z) [AlgebraicGeometry.IsSeparated s] {f₁ f₂ : X ⟶ Y},
          f₁ ≫ s = f₂ ≫ s → ι ≫ f₁ = ι ≫ f₂ → f₁ = f₂ := by
    intro Y₀ W_sub X Y Z hIntY₀ j_X _ ι _ hne s _ f₁ f₂ hs hι
    have : AlgebraicGeometry.IsIntegral Y₀ := hIntY₀
    have : Nonempty ↥X := Nonempty.map ⇑ι hne
    have : AlgebraicGeometry.IsIntegral X := isIntegral_of_isOpenImmersion j_X
    have : AlgebraicGeometry.IsReduced X := inferInstance
    have : IrreducibleSpace ↥X := irreducibleSpace_of_isIntegral X
    have : AlgebraicGeometry.IsDominant ι :=
      (isDominant_iff ι).mpr (IsOpen.dense ι.isOpenEmbedding.isOpen_range (Set.range_nonempty ⇑ι))
    exact ext_of_isDominant_of_isSeparated s hs ι hι
  have hInterNe : ∀ {U₁ U₂ : S.Opens}, Nonempty ↥U₁ → Nonempty ↥U₂ → Nonempty ↥(U₁ ⊓ U₂) := by
    intro U₁ U₂ ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
    obtain ⟨x, hx⟩ := nonempty_preirreducible_inter U₁.isOpen U₂.isOpen ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
    exact ⟨⟨x, hx⟩⟩
  have hOpensToSchNe : ∀ {U : S.Opens}, Nonempty ↥U → Nonempty ↥U.toScheme := by
    intro U ⟨x, hx⟩
    obtain ⟨z, _⟩ := lift_mem_ι U hx
    exact ⟨z⟩
  have hPreimageNe : ∀ (a : Fin N) {U : S.Opens}, Nonempty ↥U →
      Nonempty ↥(AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U)) := by
    intro a U hneU
    obtain ⟨⟨x, hxWa, hxU⟩⟩ := hInterNe (hWNonempty a) hneU
    let O_U : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U
    obtain ⟨w, hw⟩ := lift_mem_ι (W a) hxWa
    obtain ⟨c, hc⟩ := (surjective_iff (g_loc a)).mp (hSurjLoc a) w
    have hcU : c ∈ O_U := by
      change (g_loc a ≫ (W a).ι) c ∈ U
      rw [Scheme.Hom.comp_apply, hc, hw]
      exact hxU
    obtain ⟨z, _⟩ := lift_mem_ι O_U hcU
    exact ⟨z⟩

  
  choose ι_loc hClause1 using hIsoLoc
  have hClause1_copy := hClause1
  choose hcomm hOpen hRange hSec using hClause1_copy

  
  let P_pb := CategoryTheory.Limits.pullback f₂.left ψ₃.left
  let Φ_loc (a : Fin N) : (V_loc a).toScheme ⟶ P_pb :=
    CategoryTheory.Limits.pullback.lift (ι_loc a)
      (AlgebraicGeometry.Scheme.Opens.ι
        ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃) ≫ g_loc a ≫ (W a).ι)
      (hcomm a)
  have hΦ_fst : ∀ a : Fin N,
      Φ_loc a ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left = ι_loc a :=
    fun a => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ_snd : ∀ a : Fin N,
      Φ_loc a ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left =
        (V_loc a).ι ≫ g_loc a ≫ (W a).ι :=
    fun a => CategoryTheory.Limits.pullback.lift_snd _ _ _
  let jV (a b : Fin N) : (O_loc a b ⊓ V_loc a).toScheme ⟶ (V_loc a).toScheme :=
    (C_loc a).homOfLE inf_le_right
  let Φ_ab (a b : Fin N) : (O_loc a b ⊓ V_loc a).toScheme ⟶ P_pb :=
    jV a b ≫ Φ_loc a
  have hOpenΦ_ab : ∀ a b : Fin N, AlgebraicGeometry.IsOpenImmersion (Φ_ab a b) := fun a b => by
    have : AlgebraicGeometry.IsOpenImmersion (Φ_loc a) := hOpen a
    exact openImm_comp (jV a b) (Φ_loc a)
  have hRangeΦ_ab : ∀ a b : Fin N,
      Set.range ⇑(Φ_ab a b) =
        (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹'
          ((W a ⊓ W b ⊓ U₃ : S.Opens) : Set S) := by
    intro a b
    ext p
    constructor
    · rintro ⟨z, rfl⟩
      have hp_a : (Φ_ab a b) z ∈ Set.range (Φ_loc a).base := ⟨jV a b z, rfl⟩
      rw [hRange a] at hp_a
      have hp_hom : Φ_ab a b ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left =
          (O_loc a b ⊓ V_loc a).ι ≫ g_loc a ≫ (W a).ι := by
        dsimp only [Φ_ab, jV]
        rw [Category.assoc, hΦ_snd a, ← Category.assoc, Scheme.homOfLE_ι]
      have hp_snd : (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left) ((Φ_ab a b) z) =
          (g_loc a ≫ (W a).ι) ((O_loc a b ⊓ V_loc a).ι z) := by
        have := congrArg (fun f : (O_loc a b ⊓ V_loc a).toScheme ⟶ S => f z) hp_hom
        simpa only [Scheme.Hom.comp_apply] using this
      have hz_mem : (O_loc a b ⊓ V_loc a).ι z ∈ O_loc a b ⊓ V_loc a :=
        mem_of_ι (O_loc a b ⊓ V_loc a) z
      have hp_Wb : (g_loc a ≫ (W a).ι) ((O_loc a b ⊓ V_loc a).ι z) ∈ W b := hz_mem.1
      change (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left) ((Φ_ab a b) z) ∈
        (W a ⊓ W b) ⊓ U₃
      exact ⟨⟨hp_a.1, by rwa [hp_snd]⟩, hp_a.2⟩
    · intro hp
      have hp' : p ∈ (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹'
          ((W a ⊓ U₃ : S.Opens) : Set S) := ⟨hp.1.1, hp.2⟩
      rw [← hRange a] at hp'
      obtain ⟨y, rfl⟩ := hp'
      let x : ↥(C_loc a) := (V_loc a).ι y
      have hxV : x ∈ V_loc a := mem_of_ι (V_loc a) y
      have hxO : x ∈ O_loc a b := by
        change (g_loc a ≫ (W a).ι) ((V_loc a).ι y) ∈ W b
        rw [← Scheme.Hom.comp_apply, ← hΦ_snd a, Scheme.Hom.comp_apply]
        exact hp.1.2
      obtain ⟨z, hz⟩ := lift_mem_ι (O_loc a b ⊓ V_loc a) ⟨hxO, hxV⟩
      refine ⟨z, ?_⟩
      have hjz : jV a b z = y := by
        apply (V_loc a).ι.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply]
        dsimp only [jV]
        rw [Scheme.homOfLE_ι]
        exact hz
      change Φ_loc a (jV a b z) = Φ_loc a y
      rw [hjz]
  have hEqRange_ab : ∀ a b : Fin N, Set.range ⇑(Φ_ab a b) = Set.range ⇑(Φ_ab b a) := by
    intro a b
    rw [hRangeΦ_ab a b, hRangeΦ_ab b a, inf_comm (W a) (W b)]
  let φ_open (a b : Fin N) : (O_loc a b ⊓ V_loc a).toScheme ≅ (O_loc b a ⊓ V_loc b).toScheme :=
    @IsOpenImmersion.isoOfRangeEq _ _ _ (Φ_ab a b) (Φ_ab b a)
      (hOpenΦ_ab a b) (hOpenΦ_ab b a) (hEqRange_ab a b)
  have hφ_open_fac : ∀ a b : Fin N, (φ_open a b).hom ≫ Φ_ab b a = Φ_ab a b := fun a b =>
    @IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _ (Φ_ab a b) (Φ_ab b a)
      (hOpenΦ_ab a b) (hOpenΦ_ab b a) (hEqRange_ab a b)
  have hφ_open_ι : ∀ a b : Fin N,
      (φ_open a b).hom ≫ jV b a ≫ ι_loc b = jV a b ≫ ι_loc a := by
    intro a b
    have h := hφ_open_fac a b =≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left
    dsimp only [Φ_ab] at h
    simpa only [Category.assoc, hΦ_fst] using h
  have hφ_open_base : ∀ a b : Fin N,
      (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι ≫ g_loc b ≫ (W b).ι =
        (O_loc a b ⊓ V_loc a).ι ≫ g_loc a ≫ (W a).ι := by
    intro a b
    have h := hφ_open_fac a b =≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left
    dsimp only [Φ_ab, jV] at h
    rw [Category.assoc, Category.assoc, hΦ_snd b, Category.assoc, hΦ_snd a,
      ← Category.assoc ((C_loc b).homOfLE _), Scheme.homOfLE_ι,
      ← Category.assoc ((C_loc a).homOfLE _), Scheme.homOfLE_ι] at h
    exact h
  have hφ_open_symm : ∀ a b : Fin N,
      (φ_open a b).hom ≫ (φ_open b a).hom = 𝟙 (O_loc a b ⊓ V_loc a).toScheme := by
    intro a b
    have : AlgebraicGeometry.IsOpenImmersion (Φ_ab a b) := hOpenΦ_ab a b
    rw [← cancel_mono (Φ_ab a b), Category.assoc, hφ_open_fac b a, hφ_open_fac a b,
      Category.id_comp]
  have hφ_open_id : ∀ a : Fin N, (φ_open a a).hom = 𝟙 (O_loc a a ⊓ V_loc a).toScheme := by
    intro a
    have : AlgebraicGeometry.IsOpenImmersion (Φ_ab a a) := hOpenΦ_ab a a
    rw [← cancel_mono (Φ_ab a a), hφ_open_fac a a, Category.id_comp]
  have hφ_open_cocycle : ∀ a b c : Fin N,
      ∃ θ_abc : (O_loc a b ⊓ O_loc a c ⊓ V_loc a).toScheme ⟶ (O_loc b c ⊓ V_loc b).toScheme,
        θ_abc ≫ (O_loc b c ⊓ V_loc b).ι =
          (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left) ≫
            (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι ∧
        θ_abc ≫ (φ_open b c).hom ≫ (O_loc c b ⊓ V_loc c).ι =
          (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right) ≫
            (φ_open a c).hom ≫ (O_loc c a ⊓ V_loc c).ι := by
    intro a b c
    let U_abc : (C_loc a).Opens := O_loc a b ⊓ O_loc a c ⊓ V_loc a
    let i_ab : U_abc.toScheme ⟶ (O_loc a b ⊓ V_loc a).toScheme :=
      (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left)
    let i_ac : U_abc.toScheme ⟶ (O_loc a c ⊓ V_loc a).toScheme :=
      (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right)
    let m_ab : U_abc.toScheme ⟶ C_loc b :=
      i_ab ≫ (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι
    have hm_hom : m_ab ≫ g_loc b ≫ (W b).ι = U_abc.ι ≫ g_loc a ≫ (W a).ι := by
      dsimp only [m_ab, i_ab]
      rw [Category.assoc, Category.assoc, hφ_open_base a b, ← Category.assoc, Scheme.homOfLE_ι]
    have hm_sub : Set.range ⇑m_ab ⊆ Set.range ⇑(O_loc b c ⊓ V_loc b).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz_mem : U_abc.ι z ∈ U_abc := mem_of_ι U_abc z
      have hm_base : (g_loc b ≫ (W b).ι) (m_ab z) = (g_loc a ≫ (W a).ι) (U_abc.ι z) := by
        have := congrArg (fun f : U_abc.toScheme ⟶ S => f z) hm_hom
        simpa only [Scheme.Hom.comp_apply] using this
      refine ⟨?_, ?_⟩
      · change (g_loc b ≫ (W b).ι) (m_ab z) ∈ W c
        rw [hm_base]
        exact hz_mem.1.2
      · change (g_loc b ≫ (W b).ι) (m_ab z) ∈ U₃
        rw [hm_base]
        exact hz_mem.2
    let θ_abc := IsOpenImmersion.lift (O_loc b c ⊓ V_loc b).ι m_ab hm_sub
    have hθ_fac : θ_abc ≫ (O_loc b c ⊓ V_loc b).ι = m_ab :=
      IsOpenImmersion.lift_fac (O_loc b c ⊓ V_loc b).ι m_ab hm_sub
    refine ⟨θ_abc, hθ_fac, ?_⟩
    have hθ_jV : θ_abc ≫ jV b c = i_ab ≫ (φ_open a b).hom ≫ jV b a := by
      rw [← cancel_mono (V_loc b).ι]
      dsimp only [jV, m_ab] at hθ_fac ⊢
      rw [Category.assoc, Scheme.homOfLE_ι, Category.assoc, Category.assoc, Scheme.homOfLE_ι]
      exact hθ_fac
    have h_to_Vc : θ_abc ≫ (φ_open b c).hom ≫ jV c b = i_ac ≫ (φ_open a c).hom ≫ jV c a := by
      have : AlgebraicGeometry.IsOpenImmersion (Φ_loc c) := hOpen c
      rw [← cancel_mono (Φ_loc c)]
      have h1 : (θ_abc ≫ (φ_open b c).hom ≫ jV c b) ≫ Φ_loc c =
          (C_loc a).homOfLE inf_le_right ≫ Φ_loc a := by
        calc (θ_abc ≫ (φ_open b c).hom ≫ jV c b) ≫ Φ_loc c
            = θ_abc ≫ ((φ_open b c).hom ≫ Φ_ab c b) := by
                dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = (θ_abc ≫ jV b c) ≫ Φ_loc b := by
                rw [hφ_open_fac b c]; dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = i_ab ≫ ((φ_open a b).hom ≫ Φ_ab b a) := by
                rw [hθ_jV]; dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = (i_ab ≫ jV a b) ≫ Φ_loc a := by
                rw [hφ_open_fac a b]; dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = (C_loc a).homOfLE inf_le_right ≫ Φ_loc a := by
                dsimp only [i_ab, jV]; rw [Scheme.homOfLE_homOfLE]
      have h2 : (i_ac ≫ (φ_open a c).hom ≫ jV c a) ≫ Φ_loc c =
          (C_loc a).homOfLE inf_le_right ≫ Φ_loc a := by
        calc (i_ac ≫ (φ_open a c).hom ≫ jV c a) ≫ Φ_loc c
            = i_ac ≫ ((φ_open a c).hom ≫ Φ_ab c a) := by
                dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = (i_ac ≫ jV a c) ≫ Φ_loc a := by
                rw [hφ_open_fac a c]; dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = (C_loc a).homOfLE inf_le_right ≫ Φ_loc a := by
                dsimp only [i_ac, jV]; rw [Scheme.homOfLE_homOfLE]
      exact h1.trans h2.symm
    have h_post := h_to_Vc =≫ (V_loc c).ι
    dsimp only [jV] at h_post
    simpa only [Category.assoc, Scheme.homOfLE_ι] using h_post
  have hφ_open_sec : ∀ (a b : Fin N) (j : Fin n),
      ∃ s_ab : (W a ⊓ W b ⊓ U₃).toScheme ⟶ (O_loc a b ⊓ V_loc a).toScheme,
        s_ab ≫ (O_loc a b ⊓ V_loc a).ι =
          S.homOfLE (inf_le_left.trans inf_le_left) ≫ τ_loc a j ∧
        (s_ab ≫ (φ_open a b).hom) ≫ (O_loc b a ⊓ V_loc b).ι =
          S.homOfLE (inf_le_left.trans inf_le_right) ≫ τ_loc b j := by
    intro a b j
    let W_abU : S.Opens := W a ⊓ W b ⊓ U₃
    let μ_a : W_abU.toScheme ⟶ C_loc a :=
      S.homOfLE (inf_le_left.trans inf_le_left) ≫ τ_loc a j
    have hμ_base : μ_a ≫ g_loc a ≫ (W a).ι = W_abU.ι := by
      dsimp only [μ_a]
      rw [Category.assoc, ← Category.assoc (τ_loc a j), hSecLoc a j, Category.id_comp,
        Scheme.homOfLE_ι]
    have hμ_sub : Set.range ⇑μ_a ⊆ Set.range ⇑(O_loc a b ⊓ V_loc a).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      have hw_mem : W_abU.ι w ∈ W_abU := mem_of_ι W_abU w
      have h_eq : (g_loc a ≫ (W a).ι) (μ_a w) = W_abU.ι w := by
        have := congrArg (fun f : W_abU.toScheme ⟶ S => f w) hμ_base
        simpa only [Scheme.Hom.comp_apply] using this
      exact ⟨by change (g_loc a ≫ (W a).ι) (μ_a w) ∈ W b; rw [h_eq]; exact hw_mem.1.2,
             by change (g_loc a ≫ (W a).ι) (μ_a w) ∈ U₃; rw [h_eq]; exact hw_mem.2⟩
    let s_ab := IsOpenImmersion.lift (O_loc a b ⊓ V_loc a).ι μ_a hμ_sub
    have hs_ab_fac : s_ab ≫ (O_loc a b ⊓ V_loc a).ι = μ_a :=
      IsOpenImmersion.lift_fac (O_loc a b ⊓ V_loc a).ι μ_a hμ_sub
    refine ⟨s_ab, hs_ab_fac, ?_⟩
    obtain ⟨s_a, hs_a1, hs_a2⟩ := hSec a j
    obtain ⟨s_b, hs_b1, hs_b2⟩ := hSec b j
    let r_a : W_abU.toScheme ⟶ (W a ⊓ U₃).toScheme :=
      S.homOfLE (inf_le_inf_right U₃ inf_le_left)
    let r_b : W_abU.toScheme ⟶ (W b ⊓ U₃).toScheme :=
      S.homOfLE (inf_le_inf_right U₃ inf_le_right)
    have hs_ab_jV : s_ab ≫ jV a b = r_a ≫ s_a := by
      rw [← cancel_mono (V_loc a).ι]
      calc (s_ab ≫ jV a b) ≫ (V_loc a).ι
          = s_ab ≫ (O_loc a b ⊓ V_loc a).ι := by
              dsimp only [jV]; rw [Category.assoc, Scheme.homOfLE_ι]
        _ = S.homOfLE (inf_le_left.trans inf_le_left) ≫ τ_loc a j := hs_ab_fac
        _ = (r_a ≫ S.homOfLE inf_le_left) ≫ τ_loc a j := by
              dsimp only [r_a]; rw [Scheme.homOfLE_homOfLE]
        _ = r_a ≫ (s_a ≫ (V_loc a).ι) := by rw [Category.assoc, ← hs_a1]
        _ = (r_a ≫ s_a) ≫ (V_loc a).ι := by rw [Category.assoc]
    have h_to_Vb : s_ab ≫ (φ_open a b).hom ≫ jV b a = r_b ≫ s_b := by
      have : AlgebraicGeometry.IsOpenImmersion (Φ_loc b) := hOpen b
      rw [← cancel_mono (Φ_loc b)]
      have h_lhs : (s_ab ≫ (φ_open a b).hom ≫ jV b a) ≫ Φ_loc b = r_a ≫ s_a ≫ Φ_loc a := by
        calc (s_ab ≫ (φ_open a b).hom ≫ jV b a) ≫ Φ_loc b
            = s_ab ≫ ((φ_open a b).hom ≫ Φ_ab b a) := by
                dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = (s_ab ≫ jV a b) ≫ Φ_loc a := by
                rw [hφ_open_fac a b]; dsimp only [Φ_ab]; simp only [Category.assoc]
          _ = r_a ≫ s_a ≫ Φ_loc a := by rw [hs_ab_jV, Category.assoc]
      rw [h_lhs]
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc (r_a ≫ s_a ≫ Φ_loc a) ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left
            = r_a ≫ s_a ≫ (Φ_loc a ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left) := by
                simp only [Category.assoc]
          _ = r_a ≫ (s_a ≫ ι_loc a) := by rw [hΦ_fst a]
          _ = (r_a ≫ (W a ⊓ U₃).ι) ≫ ψ₃.left ≫ (σ j).left := by
                rw [hs_a2]; simp only [Category.assoc]
          _ = W_abU.ι ≫ ψ₃.left ≫ (σ j).left := by
                dsimp only [r_a]; rw [Scheme.homOfLE_ι]
          _ = (r_b ≫ (W b ⊓ U₃).ι) ≫ ψ₃.left ≫ (σ j).left := by
                dsimp only [r_b]; rw [Scheme.homOfLE_ι]
          _ = r_b ≫ (s_b ≫ ι_loc b) := by
                simp only [Category.assoc, hs_b2]
          _ = r_b ≫ s_b ≫ (Φ_loc b ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left) := by
                rw [hΦ_fst b]
          _ = ((r_b ≫ s_b) ≫ Φ_loc b) ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left := by
                simp only [Category.assoc]
      · calc (r_a ≫ s_a ≫ Φ_loc a) ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left
            = r_a ≫ s_a ≫ (Φ_loc a ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left) := by
                simp only [Category.assoc]
          _ = r_a ≫ (s_a ≫ (V_loc a).ι) ≫ g_loc a ≫ (W a).ι := by
                rw [hΦ_snd a]; simp only [Category.assoc]
          _ = (r_a ≫ B₃.left.homOfLE inf_le_left) ≫ (τ_loc a j ≫ g_loc a) ≫ (W a).ι := by
                change r_a ≫ (s_a ≫ Scheme.Opens.ι
                  ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃)) ≫
                  g_loc a ≫ (W a).ι = _
                rw [hs_a1]; simp only [Category.assoc]
          _ = W_abU.ι := by
                rw [hSecLoc a j, Category.id_comp]; dsimp only [r_a, S]; rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_ι]
          _ = (r_b ≫ B₃.left.homOfLE inf_le_left) ≫ (τ_loc b j ≫ g_loc b) ≫ (W b).ι := by
                rw [hSecLoc b j, Category.id_comp]; dsimp only [r_b, S]; rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_ι]
          _ = r_b ≫ (s_b ≫ (V_loc b).ι) ≫ g_loc b ≫ (W b).ι := by
                change _ = r_b ≫ (s_b ≫ Scheme.Opens.ι
                  ((TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj U₃)) ≫
                  g_loc b ≫ (W b).ι
                rw [hs_b1]; simp only [Category.assoc]
          _ = r_b ≫ s_b ≫ (Φ_loc b ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left) := by
                rw [hΦ_snd b]; simp only [Category.assoc]
          _ = ((r_b ≫ s_b) ≫ Φ_loc b) ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left := by
                simp only [Category.assoc]
    calc (s_ab ≫ (φ_open a b).hom) ≫ (O_loc b a ⊓ V_loc b).ι
        = (s_ab ≫ (φ_open a b).hom ≫ jV b a) ≫ (V_loc b).ι := by
            dsimp only [jV]; simp only [Category.assoc, Scheme.homOfLE_ι]
      _ = (r_b ≫ s_b) ≫ (V_loc b).ι := by rw [h_to_Vb]
      _ = r_b ≫ (s_b ≫ (V_loc b).ι) := by rw [Category.assoc]
      _ = (r_b ≫ S.homOfLE inf_le_left) ≫ τ_loc b j := by rw [hs_b1, Category.assoc]
      _ = S.homOfLE (inf_le_left.trans inf_le_right) ≫ τ_loc b j := by
            dsimp only [r_b]; rw [Scheme.homOfLE_homOfLE]

  
  have hRestrictCurve : ∀ (c : Fin N) (V₀ : S.Opens) (hV₀_W : V₀ ≤ W c) (hneV₀ : Nonempty ↥V₀)
      (B₀ : Type u) [CommRing B₀] (e_V₀ : V₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of B₀)),
      let O_cV₀ : (C_loc c).Opens :=
        (TopologicalSpace.Opens.map (g_loc c ≫ (W c).ι).base).obj V₀
      let i_Wc : V₀.toScheme ⟶ (W c).toScheme := S.homOfLE hV₀_W
      ∃ (g_tilde : O_cV₀.toScheme ⟶ V₀.toScheme)
        (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ O_cV₀.toScheme)),
        g_tilde ≫ V₀.ι = O_cV₀.ι ≫ g_loc c ≫ (W c).ι ∧
        g_tilde ≫ i_Wc = O_cV₀.ι ≫ g_loc c ∧
        CategoryTheory.IsPullback O_cV₀.ι g_tilde (g_loc c) i_Wc ∧
        (∀ j : Fin n, τ' j ≫ O_cV₀.ι = e_V₀.inv ≫ i_Wc ≫ τ_loc c j) ∧
        IsGeometricStablePointedCurve (g_tilde ≫ e_V₀.hom) n τ' ∧
        AlgebraicGeometry.IsIntegral O_cV₀.toScheme := by
    intro c V₀ hV₀_W hneV₀ B₀ _ e_V₀ O_cV₀ i_Wc
    have hg_sub : Set.range ⇑(O_cV₀.ι ≫ g_loc c ≫ (W c).ι) ⊆ Set.range ⇑V₀.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact mem_of_ι O_cV₀ z
    let g_tilde := IsOpenImmersion.lift V₀.ι (O_cV₀.ι ≫ g_loc c ≫ (W c).ι) hg_sub
    have hg_V₀ : g_tilde ≫ V₀.ι = O_cV₀.ι ≫ g_loc c ≫ (W c).ι :=
      IsOpenImmersion.lift_fac V₀.ι (O_cV₀.ι ≫ g_loc c ≫ (W c).ι) hg_sub
    have hg_iWc : g_tilde ≫ i_Wc = O_cV₀.ι ≫ g_loc c := by
      rw [← cancel_mono (W c).ι, Category.assoc, Category.assoc]
      dsimp only [i_Wc]
      rwa [Scheme.homOfLE_ι]
    have h_opens_eq :
        (TopologicalSpace.Opens.map (g_loc c).base).obj i_Wc.opensRange =
          O_cV₀.ι.opensRange := by
      ext x
      change g_loc c x ∈ i_Wc.opensRange ↔ x ∈ O_cV₀.ι.opensRange
      rw [Scheme.Hom.mem_opensRange, Scheme.Hom.mem_opensRange]
      constructor
      · rintro ⟨v, hv⟩
        have hxV₀ : x ∈ O_cV₀ := by
          change (g_loc c ≫ (W c).ι) x ∈ V₀
          rw [Scheme.Hom.comp_apply, ← hv, ← Scheme.Hom.comp_apply]
          dsimp only [i_Wc]
          rw [Scheme.homOfLE_ι]
          exact mem_of_ι V₀ v
        exact lift_mem_ι O_cV₀ hxV₀
      · rintro ⟨z, rfl⟩
        have hzV₀ : (g_loc c ≫ (W c).ι) (O_cV₀.ι z) ∈ V₀ := mem_of_ι O_cV₀ z
        rw [Scheme.Hom.comp_apply] at hzV₀
        obtain ⟨v, hv⟩ := lift_mem_ι V₀ hzV₀
        refine ⟨v, ?_⟩
        apply (W c).ι.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply]
        dsimp only [i_Wc]
        rw [Scheme.homOfLE_ι]
        exact hv
    have h_pb : CategoryTheory.IsPullback O_cV₀.ι g_tilde (g_loc c) i_Wc :=
      (IsOpenImmersion.isPullback g_tilde O_cV₀.ι i_Wc (g_loc c) hg_iWc.symm h_opens_eq).flip
    have hτ_sub : ∀ j : Fin n, Set.range ⇑(i_Wc ≫ τ_loc c j) ⊆ Set.range ⇑O_cV₀.ι := by
      intro j
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨v, rfl⟩
      change (g_loc c ≫ (W c).ι) ((i_Wc ≫ τ_loc c j) v) ∈ V₀
      rw [← Scheme.Hom.comp_apply]
      have h_id : (i_Wc ≫ τ_loc c j) ≫ g_loc c ≫ (W c).ι = V₀.ι := by
        dsimp only [i_Wc]
        rw [Category.assoc, ← Category.assoc (τ_loc c j), hSecLoc c j, Category.id_comp,
          Scheme.homOfLE_ι]
      rw [h_id]
      exact mem_of_ι V₀ v
    let τ_tilde (j : Fin n) : V₀.toScheme ⟶ O_cV₀.toScheme :=
      IsOpenImmersion.lift O_cV₀.ι (i_Wc ≫ τ_loc c j) (hτ_sub j)
    have hτ_tilde_fac : ∀ j : Fin n, τ_tilde j ≫ O_cV₀.ι = i_Wc ≫ τ_loc c j :=
      fun j => IsOpenImmersion.lift_fac O_cV₀.ι (i_Wc ≫ τ_loc c j) (hτ_sub j)
    let τ' (j : Fin n) : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ O_cV₀.toScheme :=
      e_V₀.inv ≫ τ_tilde j
    have hτ'_fac : ∀ j : Fin n, τ' j ≫ O_cV₀.ι = e_V₀.inv ≫ i_Wc ≫ τ_loc c j := by
      intro j
      dsimp only [τ']
      rw [Category.assoc, hτ_tilde_fac j]
    let τ_pb (j : Fin n) : V₀.toScheme ⟶ CategoryTheory.Limits.pullback (g_loc c) i_Wc :=
      CategoryTheory.Limits.pullback.lift (i_Wc ≫ τ_loc c j) (𝟙 V₀.toScheme)
        (by rw [Category.assoc, hSecLoc c j, Category.comp_id, Category.id_comp])
    have hStab_pb : IsGeometricStablePointedCurve
        (CategoryTheory.Limits.pullback.snd (g_loc c) i_Wc) n τ_pb :=
      hStabPull (C_loc c) (W c).toScheme V₀.toScheme (g_loc c) (τ_loc c) i_Wc τ_pb (hStabLoc c)
        (fun j => ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
                   CategoryTheory.Limits.pullback.lift_snd _ _ _⟩)
    let e_pb : CategoryTheory.Limits.pullback (g_loc c) i_Wc ≅ O_cV₀.toScheme :=
      h_pb.isoPullback.symm
    have hStab' : IsGeometricStablePointedCurve (g_tilde ≫ e_V₀.hom) n τ' := by
      apply hStabIso (CategoryTheory.Limits.pullback (g_loc c) i_Wc) V₀.toScheme
        O_cV₀.toScheme (AlgebraicGeometry.Spec (CommRingCat.of B₀))
        (CategoryTheory.Limits.pullback.snd (g_loc c) i_Wc) τ_pb
        (g_tilde ≫ e_V₀.hom) τ' e_pb e_V₀ hStab_pb
      · dsimp only [e_pb, Iso.symm_hom]
        rw [← Category.assoc, h_pb.isoPullback_inv_snd]
      · intro j
        rw [← cancel_mono O_cV₀.ι, hτ'_fac j, Category.assoc, Category.assoc]
        dsimp only [e_pb, Iso.symm_hom, τ_pb]
        rw [h_pb.isoPullback_inv_fst, CategoryTheory.Limits.pullback.lift_fst]
    have : Nonempty ↥O_cV₀.toScheme := hPreimageNe c hneV₀
    have : AlgebraicGeometry.IsIntegral (C_loc c) := hIntLoc c
    have hInt' : AlgebraicGeometry.IsIntegral O_cV₀.toScheme :=
      isIntegral_of_isOpenImmersion O_cV₀.ι
    exact ⟨g_tilde, τ', hg_V₀, hg_iWc, h_pb, hτ'_fac, hStab', hInt'⟩

  
  have hAffOracle : ∀ (a b : Fin N) (V₀ : S.Opens) (hV₀_le : V₀ ≤ W a ⊓ W b),
      AlgebraicGeometry.IsAffineOpen V₀ →
      Nonempty ↥V₀ →
      let O_aV₀ : (C_loc a).Opens :=
        (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj V₀
      let O_bV₀ : (C_loc b).Opens :=
        (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj V₀
      ∃ (φ_V₀ : O_aV₀.toScheme ≅ O_bV₀.toScheme),
        φ_V₀.hom ≫ O_bV₀.ι ≫ g_loc b ≫ (W b).ι = O_aV₀.ι ≫ g_loc a ≫ (W a).ι ∧
        (C_loc a).homOfLE inf_le_left ≫ φ_V₀.hom ≫ O_bV₀.ι =
          (C_loc a).homOfLE (inf_le_inf_right (V_loc a)
            ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).monotone
              (hV₀_le.trans inf_le_right))) ≫
            (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
    intro a b V₀ hV₀_le hAffV₀ hneV₀ O_aV₀ O_bV₀
    
    let B₀ : Type u := ↑(B₃.left.presheaf.obj (Opposite.op V₀))
    have : Nonempty ↥V₀.toScheme := hOpensToSchNe hneV₀
    have : IsDomain B₀ := @IsIntegral.component_integral S hIntB₃ V₀ this
    have : IsIntegrallyClosed B₀ := hNormB₃ V₀ hAffV₀ hneV₀
    have h_top : V₀ ≤ (TopologicalSpace.Opens.map B₃.hom.base).obj ⊤ := fun _ _ => trivial
    let e_k := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    let f_k : CommRingCat.of k ⟶ B₃.left.presheaf.obj (Opposite.op V₀) :=
      e_k.inv ≫ B₃.hom.appLE ⊤ V₀ h_top
    have hf_surj : Function.Surjective e_k.inv.hom := fun y =>
      ⟨e_k.hom.hom y, congrArg (fun g => CommRingCat.Hom.hom g y) e_k.hom_inv_id⟩
    have hf1 : e_k.inv.hom.FiniteType := RingHom.FiniteType.of_surjective e_k.inv.hom hf_surj
    have : AlgebraicGeometry.LocallyOfFiniteType B₃.hom := hFTB₃
    have hf2 : (B₃.hom.appLE ⊤ V₀ h_top).hom.FiniteType :=
      LocallyOfFiniteType.finiteType_appLE B₃.hom (isAffineOpen_top _) hAffV₀ h_top
    letI : Algebra k B₀ := f_k.hom.toAlgebra
    have : Algebra.FiniteType k B₀ := hf2.comp hf1
    let e_V₀ : V₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of B₀) := hAffV₀.isoSpec

    
    have hV₀_Wa : V₀ ≤ W a := hV₀_le.trans inf_le_left
    have hV₀_Wb : V₀ ≤ W b := hV₀_le.trans inf_le_right
    let i_Wa : V₀.toScheme ⟶ (W a).toScheme := S.homOfLE hV₀_Wa
    let i_Wb : V₀.toScheme ⟶ (W b).toScheme := S.homOfLE hV₀_Wb
    obtain ⟨g_tilde_a, τ'_a, hg_V₀_a, _hg_iWa, h_pb_a, hτ'_a_fac, hStab'_a, hInt'_a⟩ :=
      hRestrictCurve a V₀ hV₀_Wa hneV₀ B₀ e_V₀
    obtain ⟨g_tilde_b, τ'_b, hg_V₀_b, _hg_iWb, _h_pb_b, hτ'_b_fac, hStab'_b, hInt'_b⟩ :=
      hRestrictCurve b V₀ hV₀_Wb hneV₀ B₀ e_V₀
    let g'_a : O_aV₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      g_tilde_a ≫ e_V₀.hom
    let g'_b : O_bV₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      g_tilde_b ≫ e_V₀.hom
    have hg'_a_base : g'_a ≫ e_V₀.inv ≫ V₀.ι = O_aV₀.ι ≫ g_loc a ≫ (W a).ι := by
      dsimp only [g'_a]
      rw [Category.assoc, Iso.hom_inv_id_assoc, hg_V₀_a]
    have hg'_b_base : g'_b ≫ e_V₀.inv ≫ V₀.ι = O_bV₀.ι ≫ g_loc b ≫ (W b).ι := by
      dsimp only [g'_b]
      rw [Category.assoc, Iso.hom_inv_id_assoc, hg_V₀_b]

    
    let U₀ : (AlgebraicGeometry.Spec (CommRingCat.of B₀)).Opens :=
      (TopologicalSpace.Opens.map (e_V₀.inv ≫ V₀.ι).base).obj U₃
    have hneU₀ : Nonempty ↥U₀ := by
      obtain ⟨⟨x, hxV₀, hxU₃⟩⟩ := hInterNe hneV₀ hU₃
      obtain ⟨v, hv⟩ := lift_mem_ι V₀ hxV₀
      refine ⟨⟨e_V₀.hom v, ?_⟩⟩
      change (e_V₀.inv ≫ V₀.ι) (e_V₀.hom v) ∈ U₃
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id_assoc, hv]
      exact hxU₃
    let V'_a : O_aV₀.toScheme.Opens := (TopologicalSpace.Opens.map g'_a.base).obj U₀
    let V'_b : O_bV₀.toScheme.Opens := (TopologicalSpace.Opens.map g'_b.base).obj U₀
    have hSm'_a : AlgebraicGeometry.SmoothOfRelativeDimension 1 (g'_a ∣_ U₀) := by
      let U_Wa : (W a).toScheme.Opens := (TopologicalSpace.Opens.map (W a).ι.base).obj U₃
      let W'_Ua : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a).base).obj U_Wa
      have sqA : CategoryTheory.IsPullback V'_a.ι (g'_a ∣_ U₀) g'_a U₀.ι :=
        (isPullback_morphismRestrict g'_a U₀).flip
      have sqB : CategoryTheory.IsPullback (𝟙 O_aV₀.toScheme) g'_a g_tilde_a e_V₀.inv :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by dsimp only [g'_a]; simp⟩
      have sqAB := sqA.paste_horiz sqB
      rw [Category.comp_id] at sqAB
      have sq_tot := sqAB.paste_horiz h_pb_a
      rw [Category.assoc] at sq_tot
      have hu_sub : Set.range ⇑(U₀.ι ≫ e_V₀.inv ≫ i_Wa) ⊆ Set.range ⇑U_Wa.ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨u, rfl⟩
        change (W a).ι ((U₀.ι ≫ e_V₀.inv ≫ i_Wa) u) ∈ U₃
        rw [← Scheme.Hom.comp_apply]
        have h_eq : (U₀.ι ≫ e_V₀.inv ≫ i_Wa) ≫ (W a).ι = U₀.ι ≫ e_V₀.inv ≫ V₀.ι := by
          dsimp only [i_Wa]
          rw [Category.assoc, Category.assoc, Scheme.homOfLE_ι]
        rw [h_eq, Scheme.Hom.comp_apply]
        exact mem_of_ι U₀ u
      let u_Wa := IsOpenImmersion.lift U_Wa.ι (U₀.ι ≫ e_V₀.inv ≫ i_Wa) hu_sub
      have hu_Wa_fac : u_Wa ≫ U_Wa.ι = U₀.ι ≫ e_V₀.inv ≫ i_Wa :=
        IsOpenImmersion.lift_fac U_Wa.ι (U₀.ι ≫ e_V₀.inv ≫ i_Wa) hu_sub
      have sq_sm : CategoryTheory.IsPullback W'_Ua.ι ((g_loc a) ∣_ U_Wa) (g_loc a) U_Wa.ι :=
        (isPullback_morphismRestrict (g_loc a) U_Wa).flip
      have h_lift_comm :
          (V'_a.ι ≫ O_aV₀.ι) ≫ g_loc a = ((g'_a ∣_ U₀) ≫ u_Wa) ≫ U_Wa.ι := by
        rw [sq_tot.w, Category.assoc, hu_Wa_fac]
      let v_Wa := sq_sm.lift (V'_a.ι ≫ O_aV₀.ι) ((g'_a ∣_ U₀) ≫ u_Wa) h_lift_comm
      have hv_fst : v_Wa ≫ W'_Ua.ι = V'_a.ι ≫ O_aV₀.ι := sq_sm.lift_fst _ _ _
      have hv_snd : v_Wa ≫ ((g_loc a) ∣_ U_Wa) = (g'_a ∣_ U₀) ≫ u_Wa :=
        sq_sm.lift_snd _ _ _
      rw [← hv_fst, ← hu_Wa_fac] at sq_tot
      have sq_fin := CategoryTheory.IsPullback.of_right sq_tot hv_snd sq_sm
      exact MorphismProperty.IsStableUnderBaseChange.of_isPullback sq_fin (hSmLoc a)

    
    have hRange_α : ∀ (c : Fin N) (O_cV₀ : (C_loc c).Opens)
        (g'_c : O_cV₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
        (V'_c : O_cV₀.toScheme.Opens),
        V'_c = (TopologicalSpace.Opens.map g'_c.base).obj U₀ →
        g'_c ≫ e_V₀.inv ≫ V₀.ι = O_cV₀.ι ≫ g_loc c ≫ (W c).ι →
        Set.range ⇑(V'_c.ι ≫ O_cV₀.ι) = Set.range ⇑(O_cV₀ ⊓ V_loc c).ι := by
      intro c O_cV₀ g'_c V'_c hV' hg'_base
      subst hV'
      let V''_c : O_cV₀.toScheme.Opens := (TopologicalSpace.Opens.map g'_c.base).obj U₀
      change Set.range ⇑(V''_c.ι ≫ O_cV₀.ι) = Set.range ⇑(O_cV₀ ⊓ V_loc c).ι
      rw [Scheme.Opens.range_ι]
      ext x
      constructor
      · rintro ⟨z, rfl⟩
        rw [Scheme.Hom.comp_apply]
        refine ⟨mem_of_ι O_cV₀ (V''_c.ι z), ?_⟩
        change (g_loc c ≫ (W c).ι) (O_cV₀.ι (V''_c.ι z)) ∈ U₃
        have h_pt : (g_loc c ≫ (W c).ι) (O_cV₀.ι (V''_c.ι z)) =
            (e_V₀.inv ≫ V₀.ι) (g'_c (V''_c.ι z)) := by
          have := congrArg (fun f : O_cV₀.toScheme ⟶ S => f (V''_c.ι z)) hg'_base.symm
          simpa only [Scheme.Hom.comp_apply] using this
        rw [h_pt]
        exact mem_of_ι V''_c z
      · rintro ⟨hxO, hxU₃⟩
        obtain ⟨y, rfl⟩ := lift_mem_ι O_cV₀ hxO
        have hyV' : y ∈ V''_c := by
          change (e_V₀.inv ≫ V₀.ι) (g'_c y) ∈ U₃
          have h_pt : (e_V₀.inv ≫ V₀.ι) (g'_c y) = (g_loc c ≫ (W c).ι) (O_cV₀.ι y) := by
            have := congrArg (fun f : O_cV₀.toScheme ⟶ S => f y) hg'_base
            simpa only [Scheme.Hom.comp_apply] using this
          rw [h_pt]
          exact hxU₃
        obtain ⟨z, rfl⟩ := lift_mem_ι V''_c hyV'
        exact ⟨z, rfl⟩
    have : AlgebraicGeometry.IsOpenImmersion (V'_a.ι ≫ O_aV₀.ι) := openImm_comp V'_a.ι O_aV₀.ι
    have : AlgebraicGeometry.IsOpenImmersion (V'_b.ι ≫ O_bV₀.ι) := openImm_comp V'_b.ι O_bV₀.ι
    let α_a : V'_a.toScheme ≅ (O_aV₀ ⊓ V_loc a).toScheme :=
      IsOpenImmersion.isoOfRangeEq (V'_a.ι ≫ O_aV₀.ι) (O_aV₀ ⊓ V_loc a).ι
        (hRange_α a O_aV₀ g'_a V'_a rfl hg'_a_base)
    let α_b : V'_b.toScheme ≅ (O_bV₀ ⊓ V_loc b).toScheme :=
      IsOpenImmersion.isoOfRangeEq (V'_b.ι ≫ O_bV₀.ι) (O_bV₀ ⊓ V_loc b).ι
        (hRange_α b O_bV₀ g'_b V'_b rfl hg'_b_base)
    have hα_a_hom : α_a.hom ≫ (O_aV₀ ⊓ V_loc a).ι = V'_a.ι ≫ O_aV₀.ι :=
      IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
    have hα_a_inv : α_a.inv ≫ V'_a.ι ≫ O_aV₀.ι = (O_aV₀ ⊓ V_loc a).ι := by
      simpa only [Category.assoc] using IsOpenImmersion.isoOfRangeEq_inv_fac
        (V'_a.ι ≫ O_aV₀.ι) (O_aV₀ ⊓ V_loc a).ι (hRange_α a O_aV₀ g'_a V'_a rfl hg'_a_base)
    have hα_b_inv : α_b.inv ≫ V'_b.ι ≫ O_bV₀.ι = (O_bV₀ ⊓ V_loc b).ι := by
      simpa only [Category.assoc] using IsOpenImmersion.isoOfRangeEq_inv_fac
        (V'_b.ι ≫ O_bV₀.ι) (O_bV₀ ⊓ V_loc b).ι (hRange_α b O_bV₀ g'_b V'_b rfl hg'_b_base)

    have h_sub_a : O_aV₀ ⊓ V_loc a ≤ O_loc a b ⊓ V_loc a :=
      inf_le_inf_right (V_loc a)
        ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).monotone hV₀_Wb)
    have h_sub_b : O_bV₀ ⊓ V_loc b ≤ O_loc b a ⊓ V_loc b :=
      inf_le_inf_right (V_loc b)
        ((TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).monotone hV₀_Wa)
    let j_sub_a : (O_aV₀ ⊓ V_loc a).toScheme ⟶ (O_loc a b ⊓ V_loc a).toScheme :=
      (C_loc a).homOfLE h_sub_a
    let j_sub_b : (O_bV₀ ⊓ V_loc b).toScheme ⟶ (O_loc b a ⊓ V_loc b).toScheme :=
      (C_loc b).homOfLE h_sub_b
    let m_sub : (O_aV₀ ⊓ V_loc a).toScheme ⟶ C_loc b :=
      j_sub_a ≫ (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι
    have : AlgebraicGeometry.IsOpenImmersion ((φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι) :=
      openImm_comp (φ_open a b).hom (O_loc b a ⊓ V_loc b).ι
    have : AlgebraicGeometry.IsOpenImmersion m_sub :=
      openImm_comp j_sub_a ((φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι)
    have hm_sub_hom : m_sub ≫ g_loc b ≫ (W b).ι =
        (O_aV₀ ⊓ V_loc a).ι ≫ g_loc a ≫ (W a).ι := by
      dsimp only [m_sub, j_sub_a]
      rw [Category.assoc, Category.assoc, hφ_open_base a b, ← Category.assoc, Scheme.homOfLE_ι]
    have hm_sub_symm_hom :
        (j_sub_b ≫ (φ_open b a).hom ≫ (O_loc a b ⊓ V_loc a).ι) ≫ g_loc a ≫ (W a).ι =
          (O_bV₀ ⊓ V_loc b).ι ≫ g_loc b ≫ (W b).ι := by
      dsimp only [j_sub_b]
      rw [Category.assoc, Category.assoc, hφ_open_base b a, ← Category.assoc, Scheme.homOfLE_ι]
    have hRange_sub : Set.range ⇑m_sub = Set.range ⇑(O_bV₀ ⊓ V_loc b).ι := by
      rw [Scheme.Opens.range_ι]
      ext c₂
      constructor
      · rintro ⟨x, rfl⟩
        have hc₂_mem : (O_loc b a ⊓ V_loc b).ι ((φ_open a b).hom (j_sub_a x)) ∈
            O_loc b a ⊓ V_loc b :=
          mem_of_ι (O_loc b a ⊓ V_loc b) ((φ_open a b).hom (j_sub_a x))
        refine ⟨?_, hc₂_mem.2⟩
        change (g_loc b ≫ (W b).ι) (m_sub x) ∈ V₀
        have hm_eq : (g_loc b ≫ (W b).ι) (m_sub x) =
            (g_loc a ≫ (W a).ι) ((O_aV₀ ⊓ V_loc a).ι x) := by
          have := congrArg (fun f : (O_aV₀ ⊓ V_loc a).toScheme ⟶ S => f x) hm_sub_hom
          simpa only [Scheme.Hom.comp_apply] using this
        rw [hm_eq]
        exact (mem_of_ι (O_aV₀ ⊓ V_loc a) x).1
      · intro hc₂
        obtain ⟨y, rfl⟩ := lift_mem_ι (O_bV₀ ⊓ V_loc b) hc₂
        let z := (φ_open b a).hom (j_sub_b y)
        let c₁ := (O_loc a b ⊓ V_loc a).ι z
        have hc₁_mem : c₁ ∈ O_aV₀ ⊓ V_loc a := by
          refine ⟨?_, (mem_of_ι (O_loc a b ⊓ V_loc a) z).2⟩
          change (g_loc a ≫ (W a).ι) c₁ ∈ V₀
          have hc₁_eq : (g_loc a ≫ (W a).ι) c₁ =
              (g_loc b ≫ (W b).ι) ((O_bV₀ ⊓ V_loc b).ι y) := by
            have := congrArg (fun f : (O_bV₀ ⊓ V_loc b).toScheme ⟶ S => f y) hm_sub_symm_hom
            simpa only [Scheme.Hom.comp_apply, c₁, z] using this
          rw [hc₁_eq]
          exact (mem_of_ι (O_bV₀ ⊓ V_loc b) y).1
        obtain ⟨x, hx⟩ := lift_mem_ι (O_aV₀ ⊓ V_loc a) hc₁_mem
        have hjx : j_sub_a x = z := by
          apply (O_loc a b ⊓ V_loc a).ι.isOpenEmbedding.injective
          rw [← Scheme.Hom.comp_apply]
          dsimp only [j_sub_a]
          rw [Scheme.homOfLE_ι]
          exact hx
        refine ⟨x, ?_⟩
        dsimp only [m_sub]
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hjx]
        dsimp only [z]
        rw [← Scheme.Hom.comp_apply (φ_open b a).hom (φ_open a b).hom, hφ_open_symm b a]
        change (O_loc b a ⊓ V_loc b).ι (j_sub_b y) = (O_bV₀ ⊓ V_loc b).ι y
        rw [← Scheme.Hom.comp_apply]
        dsimp only [j_sub_b]
        rw [Scheme.homOfLE_ι]
    let φ_sub : (O_aV₀ ⊓ V_loc a).toScheme ≅ (O_bV₀ ⊓ V_loc b).toScheme :=
      IsOpenImmersion.isoOfRangeEq m_sub (O_bV₀ ⊓ V_loc b).ι hRange_sub
    have hφ_sub_hom : φ_sub.hom ≫ (O_bV₀ ⊓ V_loc b).ι = m_sub :=
      IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

    let φ₀ : V'_a.toScheme ≅ V'_b.toScheme := α_a ≪≫ φ_sub ≪≫ α_b.symm
    have hφ₀_ι : φ₀.hom ≫ V'_b.ι ≫ O_bV₀.ι =
        α_a.hom ≫ j_sub_a ≫ (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
      dsimp only [φ₀, Iso.trans_hom, Iso.symm_hom]
      rw [Category.assoc, Category.assoc, hα_b_inv, hφ_sub_hom]
    have hφ₀_base : φ₀.hom ≫ V'_b.ι ≫ g'_b = V'_a.ι ≫ g'_a := by
      have : AlgebraicGeometry.IsOpenImmersion (e_V₀.inv ≫ V₀.ι) := openImm_comp e_V₀.inv V₀.ι
      rw [← cancel_mono (e_V₀.inv ≫ V₀.ι)]
      calc (φ₀.hom ≫ V'_b.ι ≫ g'_b) ≫ (e_V₀.inv ≫ V₀.ι)
          = φ₀.hom ≫ V'_b.ι ≫ (g'_b ≫ e_V₀.inv ≫ V₀.ι) := by simp only [Category.assoc]
        _ = (φ₀.hom ≫ V'_b.ι ≫ O_bV₀.ι) ≫ g_loc b ≫ (W b).ι := by
              rw [hg'_b_base]; simp only [Category.assoc]
        _ = α_a.hom ≫ j_sub_a ≫ ((φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι ≫ g_loc b ≫ (W b).ι) := by
              rw [hφ₀_ι]; simp only [Category.assoc]
        _ = α_a.hom ≫ (j_sub_a ≫ (O_loc a b ⊓ V_loc a).ι) ≫ g_loc a ≫ (W a).ι := by
              rw [hφ_open_base a b]; simp only [Category.assoc]
        _ = (α_a.hom ≫ (O_aV₀ ⊓ V_loc a).ι) ≫ g_loc a ≫ (W a).ι := by
              dsimp only [j_sub_a]; rw [Scheme.homOfLE_ι]; simp only [Category.assoc]
        _ = V'_a.ι ≫ (O_aV₀.ι ≫ g_loc a ≫ (W a).ι) := by rw [hα_a_hom, Category.assoc]
        _ = (V'_a.ι ≫ g'_a) ≫ (e_V₀.inv ≫ V₀.ι) := by
              rw [← hg'_a_base]; simp only [Category.assoc]
    have hφ₀_sec : ∀ (j : Fin n) (s₁ : U₀.toScheme ⟶ V'_a.toScheme),
        s₁ ≫ V'_a.ι = U₀.ι ≫ τ'_a j →
        (s₁ ≫ φ₀.hom) ≫ V'_b.ι = U₀.ι ≫ τ'_b j := by
      intro j s₁ hs₁
      obtain ⟨s_ab, hs_ab1, hs_ab2⟩ := hφ_open_sec a b j
      let W_abU : S.Opens := W a ⊓ W b ⊓ U₃
      have hu_abU_sub : Set.range ⇑(U₀.ι ≫ e_V₀.inv ≫ V₀.ι) ⊆ Set.range ⇑W_abU.ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨u, rfl⟩
        have huU₃ : (e_V₀.inv ≫ V₀.ι) (U₀.ι u) ∈ U₃ := mem_of_ι U₀ u
        have hvV₀ : V₀.ι (e_V₀.inv (U₀.ι u)) ∈ V₀ := mem_of_ι V₀ (e_V₀.inv (U₀.ι u))
        exact ⟨hV₀_le hvV₀, huU₃⟩
      let u_abU := IsOpenImmersion.lift W_abU.ι (U₀.ι ≫ e_V₀.inv ≫ V₀.ι) hu_abU_sub
      have hu_abU_fac : u_abU ≫ W_abU.ι = U₀.ι ≫ e_V₀.inv ≫ V₀.ι :=
        IsOpenImmersion.lift_fac W_abU.ι (U₀.ι ≫ e_V₀.inv ≫ V₀.ι) hu_abU_sub
      have hu_Wa_eq : u_abU ≫ S.homOfLE (inf_le_left.trans inf_le_left) =
          U₀.ι ≫ e_V₀.inv ≫ i_Wa := by
        rw [← cancel_mono (W a).ι]
        dsimp only [i_Wa]
        rw [Category.assoc, Scheme.homOfLE_ι, hu_abU_fac, Category.assoc, Category.assoc,
          Scheme.homOfLE_ι]
      have hu_Wb_eq : u_abU ≫ S.homOfLE (inf_le_left.trans inf_le_right) =
          U₀.ι ≫ e_V₀.inv ≫ i_Wb := by
        rw [← cancel_mono (W b).ι]
        dsimp only [i_Wb]
        rw [Category.assoc, Scheme.homOfLE_ι, hu_abU_fac, Category.assoc, Category.assoc,
          Scheme.homOfLE_ι]
      have hs₁_eq : s₁ ≫ α_a.hom ≫ j_sub_a = u_abU ≫ s_ab := by
        rw [← cancel_mono (O_loc a b ⊓ V_loc a).ι]
        calc (s₁ ≫ α_a.hom ≫ j_sub_a) ≫ (O_loc a b ⊓ V_loc a).ι
            = s₁ ≫ α_a.hom ≫ (O_aV₀ ⊓ V_loc a).ι := by
                dsimp only [j_sub_a]; simp only [Category.assoc, Scheme.homOfLE_ι]
          _ = (s₁ ≫ V'_a.ι) ≫ O_aV₀.ι := by rw [hα_a_hom]; simp only [Category.assoc]
          _ = U₀.ι ≫ (τ'_a j ≫ O_aV₀.ι) := by rw [hs₁, Category.assoc]
          _ = (U₀.ι ≫ e_V₀.inv ≫ i_Wa) ≫ τ_loc a j := by
                change U₀.ι ≫ (τ'_a j ≫
                  Scheme.Opens.ι ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj V₀)) = _
                rw [hτ'_a_fac j]; dsimp only [i_Wa]; simp only [Category.assoc]
          _ = (u_abU ≫ S.homOfLE (inf_le_left.trans inf_le_left)) ≫ τ_loc a j := by rw [hu_Wa_eq]
          _ = (u_abU ≫ s_ab) ≫ (O_loc a b ⊓ V_loc a).ι := by
                simp only [Category.assoc, hs_ab1]
      rw [← cancel_mono O_bV₀.ι]
      calc ((s₁ ≫ φ₀.hom) ≫ V'_b.ι) ≫ O_bV₀.ι
          = s₁ ≫ (φ₀.hom ≫ V'_b.ι ≫ O_bV₀.ι) := by simp only [Category.assoc]
        _ = (s₁ ≫ α_a.hom ≫ j_sub_a) ≫ (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
              rw [hφ₀_ι]; simp only [Category.assoc]
        _ = u_abU ≫ ((s_ab ≫ (φ_open a b).hom) ≫ (O_loc b a ⊓ V_loc b).ι) := by
              rw [hs₁_eq]; simp only [Category.assoc]
        _ = (u_abU ≫ S.homOfLE (inf_le_left.trans inf_le_right)) ≫ τ_loc b j := by
              rw [hs_ab2, Category.assoc]
        _ = (U₀.ι ≫ e_V₀.inv ≫ i_Wb) ≫ τ_loc b j := by rw [hu_Wb_eq]
        _ = (U₀.ι ≫ τ'_b j) ≫ O_bV₀.ι := by
              change _ = (U₀.ι ≫ τ'_b j) ≫
                Scheme.Opens.ι ((TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj V₀)
              simp only [Category.assoc]
              rw [hτ'_b_fac j]

    obtain ⟨φ_V₀, hφV₀_g, _hφV₀_τ, hφV₀_open⟩ :=
      hAffExt B₀ O_aV₀.toScheme O_bV₀.toScheme g'_a τ'_a g'_b τ'_b
        hStab'_a hStab'_b hInt'_a hInt'_b U₀ hneU₀ hSm'_a φ₀ hφ₀_base hφ₀_sec
    have hφV₀_open' : V'_a.ι ≫ φ_V₀.hom = φ₀.hom ≫ V'_b.ι := hφV₀_open
    refine ⟨φ_V₀, ?_, ?_⟩
    · have h := hφV₀_g =≫ (e_V₀.inv ≫ V₀.ι)
      simpa only [Category.assoc, hg'_a_base, hg'_b_base] using h
    · have hα_inv_ι : α_a.inv ≫ V'_a.ι = (C_loc a).homOfLE inf_le_left := by
        rw [← cancel_mono O_aV₀.ι, Category.assoc, hα_a_inv, Scheme.homOfLE_ι]
      calc (C_loc a).homOfLE inf_le_left ≫ φ_V₀.hom ≫ O_bV₀.ι
          = α_a.inv ≫ (V'_a.ι ≫ φ_V₀.hom) ≫ O_bV₀.ι := by rw [← hα_inv_ι]; simp only [Category.assoc]
        _ = α_a.inv ≫ (φ₀.hom ≫ V'_b.ι ≫ O_bV₀.ι) := by rw [hφV₀_open']; simp only [Category.assoc]
        _ = j_sub_a ≫ (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
              rw [hφ₀_ι, Iso.inv_hom_id_assoc]

  
  have hPatchHom : ∀ a b : Fin N,
      ∃ f_ab : (O_loc a b).toScheme ⟶ (O_loc b a).toScheme,
        f_ab ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι = (O_loc a b).ι ≫ g_loc a ≫ (W a).ι ∧
        (C_loc a).homOfLE inf_le_left ≫ f_ab =
          (φ_open a b).hom ≫ (C_loc b).homOfLE inf_le_left := by
    intro a b
    let J_ab : Type u :=
      {V₀ : S.Opens // V₀ ≤ W a ⊓ W b ∧ AlgebraicGeometry.IsAffineOpen V₀ ∧ Nonempty ↥V₀}
    choose φ_V₀ hφV₀_base hφV₀_agree using
      fun i : J_ab => hAffOracle a b i.1 i.2.1 i.2.2.1 i.2.2.2
    let O_ai (i : J_ab) : (C_loc a).Opens :=
      (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj i.1
    let O_bi (i : J_ab) : (C_loc b).Opens :=
      (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj i.1
    have h_le_ai : ∀ i : J_ab, O_ai i ≤ O_loc a b :=
      fun i => (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).monotone
        (i.2.1.trans inf_le_right)
    have h_le_bi : ∀ i : J_ab, O_bi i ≤ O_loc b a :=
      fun i => (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).monotone
        (i.2.1.trans inf_le_left)
    let u_cov (i : J_ab) : (O_ai i).toScheme ⟶ (O_loc a b).toScheme :=
      (C_loc a).homOfLE (h_le_ai i)
    have h_cov : ∀ x : ↥(O_loc a b).toScheme, ∃ (i : J_ab) (y : ↥(O_ai i).toScheme),
        u_cov i y = x := by
      intro x
      let c : ↥(C_loc a) := (O_loc a b).ι x
      let z : ↥S := (g_loc a ≫ (W a).ι) c
      have hzWa : z ∈ W a := mem_of_ι (W a) (g_loc a c)
      have hzWb : z ∈ W b := mem_of_ι (O_loc a b) x
      have hz : z ∈ W a ⊓ W b := ⟨hzWa, hzWb⟩
      obtain ⟨V₀, hV₀_aff, hzV₀, hV₀_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens) hz
      let i : J_ab := ⟨V₀, hV₀_le, hV₀_aff, ⟨⟨z, hzV₀⟩⟩⟩
      obtain ⟨y, hy⟩ := lift_mem_ι (O_ai i) hzV₀
      refine ⟨i, y, ?_⟩
      apply (O_loc a b).ι.isOpenEmbedding.injective
      rw [← Scheme.Hom.comp_apply]
      dsimp only [u_cov]
      rw [Scheme.homOfLE_ι]
      exact hy
    let loc_map (i : J_ab) : (O_ai i).toScheme ⟶ (O_loc b a).toScheme :=
      (φ_V₀ i).hom ≫ (C_loc b).homOfLE (h_le_bi i)
    have hloc_ι : ∀ i : J_ab, loc_map i ≫ (O_loc b a).ι = (φ_V₀ i).hom ≫ (O_bi i).ι := by
      intro i
      dsimp only [loc_map]
      rw [Category.assoc, Scheme.homOfLE_ι]
    have h_compat : ∀ i j : J_ab,
        CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫ loc_map i =
          CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫ loc_map j := by
      intro i j
      let P_ij := CategoryTheory.Limits.pullback (u_cov i) (u_cov j)
      let g_P : P_ij ⟶ C_loc a :=
        CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫ u_cov i ≫ (O_loc a b).ι
      have : AlgebraicGeometry.IsOpenImmersion (u_cov i ≫ (O_loc a b).ι) :=
        openImm_comp (u_cov i) (O_loc a b).ι
      have : AlgebraicGeometry.IsOpenImmersion g_P :=
        openImm_comp (CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j))
          (u_cov i ≫ (O_loc a b).ι)
      let W_ijU : (C_loc a).Opens := O_ai i ⊓ O_ai j ⊓ V_loc a
      have hne_ijU : Nonempty ↥W_ijU.toScheme :=
        hPreimageNe a (hInterNe (hInterNe i.2.2.2 j.2.2.2) hU₃)
      let p_i : W_ijU.toScheme ⟶ (O_ai i).toScheme :=
        (C_loc a).homOfLE (inf_le_left.trans inf_le_left)
      let p_j : W_ijU.toScheme ⟶ (O_ai j).toScheme :=
        (C_loc a).homOfLE (inf_le_left.trans inf_le_right)
      have hp_i_split : p_i =
          (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left) ≫
            (C_loc a).homOfLE inf_le_left := by
        dsimp only [p_i]
        rw [Scheme.homOfLE_homOfLE]
      have hp_j_split : p_j =
          (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right) ≫
            (C_loc a).homOfLE inf_le_left := by
        dsimp only [p_j]
        rw [Scheme.homOfLE_homOfLE]
      have hp_comm : p_i ≫ u_cov i = p_j ≫ u_cov j := by
        dsimp only [p_i, p_j, u_cov]
        rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_homOfLE]
      let ι_P : W_ijU.toScheme ⟶ P_ij :=
        CategoryTheory.Limits.pullback.lift p_i p_j hp_comm
      have hι_gP : ι_P ≫ g_P = W_ijU.ι := by
        dsimp only [ι_P, g_P, p_i, u_cov]
        rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← Category.assoc, Scheme.homOfLE_homOfLE, Scheme.homOfLE_ι]
      have : AlgebraicGeometry.IsOpenImmersion (ι_P ≫ g_P) := by
        rw [hι_gP]; exact inferInstance
      have : AlgebraicGeometry.IsOpenImmersion ι_P := IsOpenImmersion.of_comp ι_P g_P
      have : AlgebraicGeometry.IsSeparated (g_loc b ≫ (W b).ι) := hSepBase b
      have : AlgebraicGeometry.IsSeparated ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι) :=
        sep_comp (O_loc b a).ι (g_loc b ≫ (W b).ι)
      apply ext_on_nonempty_open (hIntLoc a) g_P ι_P hne_ijU ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι)
      · have h1 : (CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫ loc_map i) ≫
            ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι) = g_P ≫ g_loc a ≫ (W a).ι := by
          calc (CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫ loc_map i) ≫
                ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι)
              = CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫
                  (loc_map i ≫ (O_loc b a).ι) ≫ g_loc b ≫ (W b).ι := by
                  simp only [Category.assoc]
            _ = CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫
                  ((φ_V₀ i).hom ≫ (O_bi i).ι ≫ g_loc b ≫ (W b).ι) := by
                  rw [hloc_ι i]; simp only [Category.assoc]
            _ = CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫
                  (O_ai i).ι ≫ g_loc a ≫ (W a).ι := by
                  have hbase_i : (φ_V₀ i).hom ≫ (O_bi i).ι ≫ g_loc b ≫ (W b).ι =
                      (O_ai i).ι ≫ g_loc a ≫ (W a).ι := hφV₀_base i
                  rw [hbase_i]
            _ = g_P ≫ g_loc a ≫ (W a).ι := by
                  dsimp only [g_P, u_cov]
                  simp only [Category.assoc, Scheme.homOfLE_ι]
        have h2 : (CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫ loc_map j) ≫
            ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι) = g_P ≫ g_loc a ≫ (W a).ι := by
          calc (CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫ loc_map j) ≫
                ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι)
              = CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫
                  (loc_map j ≫ (O_loc b a).ι) ≫ g_loc b ≫ (W b).ι := by
                  simp only [Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫
                  ((φ_V₀ j).hom ≫ (O_bi j).ι ≫ g_loc b ≫ (W b).ι) := by
                  rw [hloc_ι j]; simp only [Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫
                  (O_ai j).ι ≫ g_loc a ≫ (W a).ι := by
                  have hbase_j : (φ_V₀ j).hom ≫ (O_bi j).ι ≫ g_loc b ≫ (W b).ι =
                      (O_ai j).ι ≫ g_loc a ≫ (W a).ι := hφV₀_base j
                  rw [hbase_j]
            _ = (CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫ u_cov j) ≫
                  (O_loc a b).ι ≫ g_loc a ≫ (W a).ι := by
                  dsimp only [u_cov]
                  rw [← Scheme.homOfLE_ι (C_loc a) (h_le_ai j)]
                  simp only [Category.assoc]
            _ = g_P ≫ g_loc a ≫ (W a).ι := by
                  rw [← CategoryTheory.Limits.pullback.condition]
                  dsimp only [g_P]
                  simp only [Category.assoc]
        exact h1.trans h2.symm
      · rw [← cancel_mono (O_loc b a).ι]
        have h_i : (ι_P ≫ CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫ loc_map i) ≫
            (O_loc b a).ι =
            (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (inf_le_left.trans (h_le_ai i))) ≫
              (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
          calc (ι_P ≫ CategoryTheory.Limits.pullback.fst (u_cov i) (u_cov j) ≫ loc_map i) ≫
                (O_loc b a).ι
              = p_i ≫ (loc_map i ≫ (O_loc b a).ι) := by
                  dsimp only [ι_P, loc_map]
                  rw [← Category.assoc, ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
                  simp only [Category.assoc]
            _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left) ≫
                  ((C_loc a).homOfLE inf_le_left ≫ (φ_V₀ i).hom ≫ (O_bi i).ι) := by
                  rw [hloc_ι i, hp_i_split]; simp only [Category.assoc]
            _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (inf_le_left.trans (h_le_ai i))) ≫
                  (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
                  have hagree_i : (C_loc a).homOfLE inf_le_left ≫ (φ_V₀ i).hom ≫ (O_bi i).ι =
                      (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (h_le_ai i)) ≫
                        (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := hφV₀_agree i
                  rw [hagree_i, ← Category.assoc, Scheme.homOfLE_homOfLE]
        have h_j : (ι_P ≫ CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫ loc_map j) ≫
            (O_loc b a).ι =
            (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (inf_le_right.trans (h_le_ai j))) ≫
              (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
          calc (ι_P ≫ CategoryTheory.Limits.pullback.snd (u_cov i) (u_cov j) ≫ loc_map j) ≫
                (O_loc b a).ι
              = p_j ≫ (loc_map j ≫ (O_loc b a).ι) := by
                  dsimp only [ι_P, loc_map]
                  rw [← Category.assoc, ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
                  simp only [Category.assoc]
            _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right) ≫
                  ((C_loc a).homOfLE inf_le_left ≫ (φ_V₀ j).hom ≫ (O_bi j).ι) := by
                  rw [hloc_ι j, hp_j_split]; simp only [Category.assoc]
            _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (inf_le_right.trans (h_le_ai j))) ≫
                  (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
                  have hagree_j : (C_loc a).homOfLE inf_le_left ≫ (φ_V₀ j).hom ≫ (O_bi j).ι =
                      (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (h_le_ai j)) ≫
                        (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := hφV₀_agree j
                  rw [hagree_j, ← Category.assoc, Scheme.homOfLE_homOfLE]
        exact h_i.trans h_j.symm
    let 𝒰_ab : (O_loc a b).toScheme.OpenCover :=
      Scheme.Cover.mkOfCovers J_ab (fun i => (O_ai i).toScheme) u_cov h_cov
    let f_ab : (O_loc a b).toScheme ⟶ (O_loc b a).toScheme :=
      𝒰_ab.glueMorphisms loc_map h_compat
    have hf_ab_ι : ∀ i : J_ab, u_cov i ≫ f_ab = loc_map i :=
      fun i => 𝒰_ab.ι_glueMorphisms loc_map h_compat i
    have hf_ab_base :
        f_ab ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι =
          (O_loc a b).ι ≫ g_loc a ≫ (W a).ι := by
      apply 𝒰_ab.hom_ext
      intro i
      let i' : J_ab := i
      change u_cov i' ≫ f_ab ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι =
        u_cov i' ≫ (O_loc a b).ι ≫ g_loc a ≫ (W a).ι
      have hbase_i' : (φ_V₀ i').hom ≫ (O_bi i').ι ≫ g_loc b ≫ (W b).ι =
          (O_ai i').ι ≫ g_loc a ≫ (W a).ι := hφV₀_base i'
      calc u_cov i' ≫ f_ab ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι
          = (u_cov i' ≫ f_ab) ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι := by
              simp only [Category.assoc]
        _ = (loc_map i' ≫ (O_loc b a).ι) ≫ g_loc b ≫ (W b).ι := by
              rw [hf_ab_ι i']; simp only [Category.assoc]
        _ = (φ_V₀ i').hom ≫ (O_bi i').ι ≫ g_loc b ≫ (W b).ι := by
              rw [hloc_ι i']; simp only [Category.assoc]
        _ = (O_ai i').ι ≫ g_loc a ≫ (W a).ι := hbase_i'
        _ = (u_cov i' ≫ (O_loc a b).ι) ≫ g_loc a ≫ (W a).ι := by
              dsimp only [u_cov]; rw [Scheme.homOfLE_ι]
        _ = u_cov i' ≫ (O_loc a b).ι ≫ g_loc a ≫ (W a).ι := by simp only [Category.assoc]
    refine ⟨f_ab, hf_ab_base, ?_⟩
    obtain ⟨⟨z₀, hz₀⟩⟩ := hInterNe (hWNonempty a) (hWNonempty b)
    obtain ⟨V₀, hV₀_aff, hz₀V₀, hV₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens) hz₀
    let i₀ : J_ab := ⟨V₀, hV₀_le, hV₀_aff, ⟨⟨z₀, hz₀V₀⟩⟩⟩
    let j_i₀ : (O_ai i₀ ⊓ V_loc a).toScheme ⟶ (O_loc a b ⊓ V_loc a).toScheme :=
      (C_loc a).homOfLE (inf_le_inf_right (V_loc a) (h_le_ai i₀))
    have hne_i₀U : Nonempty ↥(O_ai i₀ ⊓ V_loc a).toScheme :=
      hPreimageNe a (hInterNe i₀.2.2.2 hU₃)
    have : AlgebraicGeometry.IsSeparated (g_loc b ≫ (W b).ι) := hSepBase b
    have : AlgebraicGeometry.IsSeparated ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι) :=
      sep_comp (O_loc b a).ι (g_loc b ≫ (W b).ι)
    apply ext_on_nonempty_open (hIntLoc a) (O_loc a b ⊓ V_loc a).ι j_i₀ hne_i₀U
      ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι)
    · calc ((C_loc a).homOfLE inf_le_left ≫ f_ab) ≫ ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι)
          = (C_loc a).homOfLE inf_le_left ≫ (f_ab ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι) := by
              simp only [Category.assoc]
        _ = (O_loc a b ⊓ V_loc a).ι ≫ g_loc a ≫ (W a).ι := by
              rw [hf_ab_base, ← Category.assoc, Scheme.homOfLE_ι]
        _ = (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι ≫ g_loc b ≫ (W b).ι :=
              (hφ_open_base a b).symm
        _ = ((φ_open a b).hom ≫ (C_loc b).homOfLE inf_le_left) ≫
              ((O_loc b a).ι ≫ g_loc b ≫ (W b).ι) := by
              rw [← Scheme.homOfLE_ι (C_loc b) (inf_le_left : O_loc b a ⊓ V_loc b ≤ O_loc b a)]
              simp only [Category.assoc]
    · rw [← cancel_mono (O_loc b a).ι]
      have h_hom_eq : j_i₀ ≫ (C_loc a).homOfLE inf_le_left =
          (C_loc a).homOfLE inf_le_left ≫ u_cov i₀ := by
        dsimp only [j_i₀, u_cov]
        rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_homOfLE]
      calc (j_i₀ ≫ (C_loc a).homOfLE inf_le_left ≫ f_ab) ≫ (O_loc b a).ι
          = ((j_i₀ ≫ (C_loc a).homOfLE inf_le_left) ≫ f_ab) ≫ (O_loc b a).ι := by
              simp only [Category.assoc]
        _ = (C_loc a).homOfLE inf_le_left ≫ (u_cov i₀ ≫ f_ab) ≫ (O_loc b a).ι := by
              rw [h_hom_eq]; simp only [Category.assoc]
        _ = (C_loc a).homOfLE inf_le_left ≫ (φ_V₀ i₀).hom ≫ (O_bi i₀).ι := by
              rw [hf_ab_ι i₀, hloc_ι i₀]
        _ = j_i₀ ≫ (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := hφV₀_agree i₀
        _ = (j_i₀ ≫ (φ_open a b).hom ≫ (C_loc b).homOfLE inf_le_left) ≫ (O_loc b a).ι := by
              simp only [Category.assoc, Scheme.homOfLE_ι]

  choose f_hom hf_base hf_open using hPatchHom

  
  have hf_inv : ∀ a b : Fin N, f_hom a b ≫ f_hom b a = 𝟙 (O_loc a b).toScheme := by
    intro a b
    have hne_abU : Nonempty ↥(O_loc a b ⊓ V_loc a).toScheme :=
      hPreimageNe a (hInterNe (hWNonempty b) hU₃)
    have : AlgebraicGeometry.IsSeparated (g_loc a ≫ (W a).ι) := hSepBase a
    have : AlgebraicGeometry.IsSeparated ((O_loc a b).ι ≫ g_loc a ≫ (W a).ι) :=
      sep_comp (O_loc a b).ι (g_loc a ≫ (W a).ι)
    apply ext_on_nonempty_open (hIntLoc a) (O_loc a b).ι ((C_loc a).homOfLE inf_le_left)
      hne_abU ((O_loc a b).ι ≫ g_loc a ≫ (W a).ι)
    · rw [Category.assoc, hf_base b a, hf_base a b, Category.id_comp]
    · rw [← Category.assoc, hf_open a b, Category.assoc, hf_open b a, ← Category.assoc,
        hφ_open_symm a b, Category.id_comp, Category.comp_id]
  let φ (a b : Fin N) : (O_loc a b).toScheme ≅ (O_loc b a).toScheme :=
    { hom := f_hom a b
      inv := f_hom b a
      hom_inv_id := hf_inv a b
      inv_hom_id := hf_inv b a }

  refine ⟨ι_loc, φ, hClause1, hf_base, ?_, ?_, ?_, ?_⟩
  · 
    intro a
    change f_hom a a = 𝟙 (O_loc a a).toScheme
    have hne_aaU : Nonempty ↥(O_loc a a ⊓ V_loc a).toScheme :=
      hPreimageNe a (hInterNe (hWNonempty a) hU₃)
    have : AlgebraicGeometry.IsSeparated (g_loc a ≫ (W a).ι) := hSepBase a
    have : AlgebraicGeometry.IsSeparated ((O_loc a a).ι ≫ g_loc a ≫ (W a).ι) :=
      sep_comp (O_loc a a).ι (g_loc a ≫ (W a).ι)
    apply ext_on_nonempty_open (hIntLoc a) (O_loc a a).ι ((C_loc a).homOfLE inf_le_left)
      hne_aaU ((O_loc a a).ι ≫ g_loc a ≫ (W a).ι)
    · rw [hf_base a a, Category.id_comp]
    · rw [hf_open a a, hφ_open_id a, Category.id_comp, Category.comp_id]
  · 
    intro a b c
    let m_full : (O_loc a b ⊓ O_loc a c).toScheme ⟶ C_loc b :=
      (C_loc a).homOfLE inf_le_left ≫ (φ a b).hom ≫ (O_loc b a).ι
    have hm_full_hom : m_full ≫ g_loc b ≫ (W b).ι =
        (O_loc a b ⊓ O_loc a c).ι ≫ g_loc a ≫ (W a).ι := by
      dsimp only [m_full, φ]
      rw [Category.assoc, Category.assoc, hf_base a b, ← Category.assoc, Scheme.homOfLE_ι]
    have hm_sub : Set.range ⇑m_full ⊆ Set.range ⇑(O_loc b c).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      change (g_loc b ≫ (W b).ι) (m_full z) ∈ W c
      have h_eq : (g_loc b ≫ (W b).ι) (m_full z) =
          (g_loc a ≫ (W a).ι) ((O_loc a b ⊓ O_loc a c).ι z) := by
        have := congrArg (fun f : (O_loc a b ⊓ O_loc a c).toScheme ⟶ S => f z) hm_full_hom
        simpa only [Scheme.Hom.comp_apply] using this
      rw [h_eq]
      exact (mem_of_ι (O_loc a b ⊓ O_loc a c) z).2
    let ψ_abc := IsOpenImmersion.lift (O_loc b c).ι m_full hm_sub
    have hψ_fac : ψ_abc ≫ (O_loc b c).ι = m_full :=
      IsOpenImmersion.lift_fac (O_loc b c).ι m_full hm_sub
    refine ⟨ψ_abc, hψ_fac, ?_⟩
    obtain ⟨θ_abc, hθ1, hθ2⟩ := hφ_open_cocycle a b c
    let ι_abc : (O_loc a b ⊓ O_loc a c ⊓ V_loc a).toScheme ⟶ (O_loc a b ⊓ O_loc a c).toScheme :=
      (C_loc a).homOfLE inf_le_left
    have hne_abcU : Nonempty ↥(O_loc a b ⊓ O_loc a c ⊓ V_loc a).toScheme :=
      hPreimageNe a (hInterNe (hInterNe (hWNonempty b) (hWNonempty c)) hU₃)
    have h_hom_ab : ι_abc ≫ (C_loc a).homOfLE inf_le_left =
        (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left) ≫
          (C_loc a).homOfLE inf_le_left := by
      dsimp only [ι_abc]
      rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_homOfLE]
    have h_hom_ac : ι_abc ≫ (C_loc a).homOfLE inf_le_right =
        (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right) ≫
          (C_loc a).homOfLE inf_le_left := by
      dsimp only [ι_abc]
      rw [Scheme.homOfLE_homOfLE, Scheme.homOfLE_homOfLE]
    have hθ_ψ : ι_abc ≫ ψ_abc = θ_abc ≫ (C_loc b).homOfLE inf_le_left := by
      rw [← cancel_mono (O_loc b c).ι]
      calc (ι_abc ≫ ψ_abc) ≫ (O_loc b c).ι
          = (ι_abc ≫ (C_loc a).homOfLE inf_le_left) ≫ f_hom a b ≫ (O_loc b a).ι := by
              rw [Category.assoc, hψ_fac]; dsimp only [m_full, φ]; simp only [Category.assoc]
        _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left) ≫
              ((C_loc a).homOfLE inf_le_left ≫ f_hom a b) ≫ (O_loc b a).ι := by
              rw [h_hom_ab]; simp only [Category.assoc]
        _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_left) ≫
              (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
              rw [hf_open a b]; simp only [Category.assoc, Scheme.homOfLE_ι]
        _ = θ_abc ≫ (O_loc b c ⊓ V_loc b).ι := hθ1.symm
        _ = (θ_abc ≫ (C_loc b).homOfLE inf_le_left) ≫ (O_loc b c).ι := by
              simp only [Category.assoc, Scheme.homOfLE_ι]
    have : AlgebraicGeometry.IsSeparated (g_loc c ≫ (W c).ι) := hSepBase c
    apply ext_on_nonempty_open (hIntLoc a) (O_loc a b ⊓ O_loc a c).ι ι_abc hne_abcU
      (g_loc c ≫ (W c).ι)
    · have h1 : (ψ_abc ≫ (φ b c).hom ≫ (O_loc c b).ι) ≫ (g_loc c ≫ (W c).ι) =
          (O_loc a b ⊓ O_loc a c).ι ≫ g_loc a ≫ (W a).ι := by
        calc (ψ_abc ≫ (φ b c).hom ≫ (O_loc c b).ι) ≫ (g_loc c ≫ (W c).ι)
            = ψ_abc ≫ (f_hom b c ≫ (O_loc c b).ι ≫ g_loc c ≫ (W c).ι) := by
                dsimp only [φ]; simp only [Category.assoc]
          _ = (ψ_abc ≫ (O_loc b c).ι) ≫ g_loc b ≫ (W b).ι := by
                rw [hf_base b c, Category.assoc]
          _ = (O_loc a b ⊓ O_loc a c).ι ≫ g_loc a ≫ (W a).ι := by
                rw [hψ_fac, hm_full_hom]
      have h2 : ((C_loc a).homOfLE inf_le_right ≫ (φ a c).hom ≫ (O_loc c a).ι) ≫
            (g_loc c ≫ (W c).ι) =
          (O_loc a b ⊓ O_loc a c).ι ≫ g_loc a ≫ (W a).ι := by
        dsimp only [φ]
        rw [Category.assoc, Category.assoc, hf_base a c, ← Category.assoc, Scheme.homOfLE_ι]
      exact h1.trans h2.symm
    · calc ι_abc ≫ ψ_abc ≫ (φ b c).hom ≫ (O_loc c b).ι
          = (ι_abc ≫ ψ_abc) ≫ f_hom b c ≫ (O_loc c b).ι := by
              dsimp only [φ]; simp only [Category.assoc]
        _ = θ_abc ≫ ((C_loc b).homOfLE inf_le_left ≫ f_hom b c) ≫ (O_loc c b).ι := by
              rw [hθ_ψ]; simp only [Category.assoc]
        _ = θ_abc ≫ (φ_open b c).hom ≫ (O_loc c b ⊓ V_loc c).ι := by
              rw [hf_open b c]; simp only [Category.assoc, Scheme.homOfLE_ι]
        _ = (C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right) ≫
              (φ_open a c).hom ≫ (O_loc c a ⊓ V_loc c).ι := hθ2
        _ = ((C_loc a).homOfLE (inf_le_inf_right (V_loc a) inf_le_right) ≫
              (C_loc a).homOfLE inf_le_left) ≫ f_hom a c ≫ (O_loc c a).ι := by
              simp only [Category.assoc]
              rw [← Category.assoc ((C_loc a).homOfLE inf_le_left) (f_hom a c), hf_open a c]
              simp only [Category.assoc, Scheme.homOfLE_ι]
        _ = (ι_abc ≫ (C_loc a).homOfLE inf_le_right) ≫ f_hom a c ≫ (O_loc c a).ι := by
              rw [h_hom_ac]
        _ = ι_abc ≫ (C_loc a).homOfLE inf_le_right ≫ (φ a c).hom ≫ (O_loc c a).ι := by
              dsimp only [φ]; simp only [Category.assoc]
  · 
    intro a b j
    let ν_a : (W a ⊓ W b).toScheme ⟶ C_loc a := S.homOfLE inf_le_left ≫ τ_loc a j
    have hν_sub : Set.range ⇑ν_a ⊆ Set.range ⇑(O_loc a b).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      change (g_loc a ≫ (W a).ι) (ν_a w) ∈ W b
      have h_eq : ν_a ≫ g_loc a ≫ (W a).ι = (W a ⊓ W b).ι := by
        dsimp only [ν_a]
        rw [Category.assoc, ← Category.assoc (τ_loc a j), hSecLoc a j, Category.id_comp,
          Scheme.homOfLE_ι]
      have h_pt : (g_loc a ≫ (W a).ι) (ν_a w) = (W a ⊓ W b).ι w := by
        have := congrArg (fun f : (W a ⊓ W b).toScheme ⟶ S => f w) h_eq
        simpa only [Scheme.Hom.comp_apply] using this
      rw [h_pt]
      exact (mem_of_ι (W a ⊓ W b) w).2
    let t_ab := IsOpenImmersion.lift (O_loc a b).ι ν_a hν_sub
    have ht_fac : t_ab ≫ (O_loc a b).ι = ν_a :=
      IsOpenImmersion.lift_fac (O_loc a b).ι ν_a hν_sub
    refine ⟨t_ab, ht_fac, ?_⟩
    obtain ⟨s_ab, hs_ab1, hs_ab2⟩ := hφ_open_sec a b j
    let ι_W : (W a ⊓ W b ⊓ U₃).toScheme ⟶ (W a ⊓ W b).toScheme := S.homOfLE inf_le_left
    have hne_WabU : Nonempty ↥(W a ⊓ W b ⊓ U₃).toScheme :=
      hOpensToSchNe (hInterNe (hInterNe (hWNonempty a) (hWNonempty b)) hU₃)
    have hs_t : ι_W ≫ t_ab = s_ab ≫ (C_loc a).homOfLE inf_le_left := by
      rw [← cancel_mono (O_loc a b).ι]
      calc (ι_W ≫ t_ab) ≫ (O_loc a b).ι
          = (ι_W ≫ S.homOfLE inf_le_left) ≫ τ_loc a j := by
              rw [Category.assoc, ht_fac]; dsimp only [ν_a]; rw [Category.assoc]
        _ = S.homOfLE (inf_le_left.trans inf_le_left) ≫ τ_loc a j := by
              dsimp only [ι_W]; rw [Scheme.homOfLE_homOfLE]
        _ = s_ab ≫ (O_loc a b ⊓ V_loc a).ι := hs_ab1.symm
        _ = (s_ab ≫ (C_loc a).homOfLE inf_le_left) ≫ (O_loc a b).ι := by
              simp only [Category.assoc, Scheme.homOfLE_ι]
    have : AlgebraicGeometry.IsSeparated (g_loc b ≫ (W b).ι) := hSepBase b
    apply ext_on_nonempty_open hIntB₃ (W a ⊓ W b).ι ι_W hne_WabU (g_loc b ≫ (W b).ι)
    · have h1 : ((t_ab ≫ (φ a b).hom) ≫ (O_loc b a).ι) ≫ (g_loc b ≫ (W b).ι) =
          (W a ⊓ W b).ι := by
        calc ((t_ab ≫ (φ a b).hom) ≫ (O_loc b a).ι) ≫ (g_loc b ≫ (W b).ι)
            = t_ab ≫ (f_hom a b ≫ (O_loc b a).ι ≫ g_loc b ≫ (W b).ι) := by
                dsimp only [φ]; simp only [Category.assoc]
          _ = (t_ab ≫ (O_loc a b).ι) ≫ g_loc a ≫ (W a).ι := by
                rw [hf_base a b, Category.assoc]
          _ = S.homOfLE inf_le_left ≫ (τ_loc a j ≫ g_loc a) ≫ (W a).ι := by
                rw [ht_fac]; dsimp only [ν_a]; simp only [Category.assoc]
          _ = (W a ⊓ W b).ι := by rw [hSecLoc a j, Category.id_comp, Scheme.homOfLE_ι]
      have h2 : (S.homOfLE inf_le_right ≫ τ_loc b j) ≫ (g_loc b ≫ (W b).ι) =
          (W a ⊓ W b).ι := by
        rw [Category.assoc, ← Category.assoc (τ_loc b j), hSecLoc b j, Category.id_comp,
          Scheme.homOfLE_ι]
      exact h1.trans h2.symm
    · calc ι_W ≫ ((t_ab ≫ (φ a b).hom) ≫ (O_loc b a).ι)
          = (ι_W ≫ t_ab) ≫ f_hom a b ≫ (O_loc b a).ι := by
              dsimp only [φ]; simp only [Category.assoc]
        _ = s_ab ≫ ((C_loc a).homOfLE inf_le_left ≫ f_hom a b) ≫ (O_loc b a).ι := by
              rw [hs_t]; simp only [Category.assoc]
        _ = (s_ab ≫ (φ_open a b).hom) ≫ (O_loc b a ⊓ V_loc b).ι := by
              rw [hf_open a b]; simp only [Category.assoc, Scheme.homOfLE_ι]
        _ = S.homOfLE (inf_le_left.trans inf_le_right) ≫ τ_loc b j := hs_ab2
        _ = (ι_W ≫ S.homOfLE inf_le_right) ≫ τ_loc b j := by
              dsimp only [ι_W]; rw [Scheme.homOfLE_homOfLE]
        _ = ι_W ≫ (S.homOfLE inf_le_right ≫ τ_loc b j) := by rw [Category.assoc]
  · 
    intro a b
    refine ⟨(φ_open a b).hom ≫ jV b a, ?_, ?_⟩
    · calc ((φ_open a b).hom ≫ jV b a) ≫ (V_loc b).ι
          = (φ_open a b).hom ≫ (O_loc b a ⊓ V_loc b).ι := by
              dsimp only [jV]; rw [Category.assoc, Scheme.homOfLE_ι]
        _ = ((φ_open a b).hom ≫ (C_loc b).homOfLE inf_le_left) ≫ (O_loc b a).ι := by
              simp only [Category.assoc, Scheme.homOfLE_ι]
        _ = (C_loc a).homOfLE inf_le_left ≫ (φ a b).hom ≫ (O_loc b a).ι := by
              rw [← hf_open a b]; dsimp only [φ]; rw [Category.assoc]
    · rw [Category.assoc]
      exact hφ_open_ι a b

theorem weil_glue_local_stable_curves_along_cocycle (k : Type u) [Field k]
    (B₂ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hn : 3 ≤ n)
    (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₃ : B₃.left.Opens)
    (ψ₃ : B₃ ⟶ B₂)
    (hIntB₃ : AlgebraicGeometry.IsIntegral B₃.left)
    (hU₃ : Nonempty U₃)
    (N : ℕ)
    (W : Fin N → B₃.left.Opens)
    (hCover : (⋃ a : Fin N, (W a : Set B₃.left)) = Set.univ)
    (hWNonempty : ∀ a : Fin N, Nonempty ↥(W a))
    (C_loc : Fin N → AlgebraicGeometry.Scheme.{u})
    (g_loc : ∀ a : Fin N, C_loc a ⟶ (W a).toScheme)
    (τ_loc : ∀ a : Fin N, Fin n → ((W a).toScheme ⟶ C_loc a))
    (hStabLoc : ∀ a : Fin N, IsGeometricStablePointedCurve (g_loc a) n (τ_loc a))
    (hIntLoc : ∀ a : Fin N, AlgebraicGeometry.IsIntegral (C_loc a))
    (ι_loc : ∀ a : Fin N,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃) ⟶ X₂.left)
    (φ : ∀ a b : Fin N,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)) ≅
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)))
    (hClause1 : ∀ a : Fin N,
      let V_a : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃
      ∃ (hcomm_a : ι_loc a ≫ f₂.left = V_a.ι ≫ g_loc a ≫ (W a).ι ≫ ψ₃.left),
        AlgebraicGeometry.IsOpenImmersion
          (CategoryTheory.Limits.pullback.lift (ι_loc a) (V_a.ι ≫ g_loc a ≫ (W a).ι) hcomm_a) ∧
        Set.range (CategoryTheory.Limits.pullback.lift (ι_loc a) (V_a.ι ≫ g_loc a ≫ (W a).ι) hcomm_a).base =
          (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹'
            ((W a ⊓ U₃ : B₃.left.Opens) : Set B₃.left) ∧
        ∀ j : Fin n,
          ∃ s_a : (W a ⊓ U₃).toScheme ⟶ V_a.toScheme,
            s_a ≫ V_a.ι = B₃.left.homOfLE inf_le_left ≫ τ_loc a j ∧
            s_a ≫ ι_loc a = (W a ⊓ U₃).ι ≫ ψ₃.left ≫ (σ j).left)
    (hClause2 : ∀ a b : Fin N,
      let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
      let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
      (φ a b).hom ≫ O_ba.ι ≫ g_loc b ≫ (W b).ι = O_ab.ι ≫ g_loc a ≫ (W a).ι)
    (hClause3 : ∀ a : Fin N,
      let O_aa : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W a)
      (φ a a).hom = 𝟙 O_aa.toScheme)
    (hClause4 : ∀ a b c : Fin N,
      let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
      let O_ac : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W c)
      let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
      let O_bc : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W c)
      let O_cb : (C_loc c).Opens := (TopologicalSpace.Opens.map (g_loc c ≫ (W c).ι).base).obj (W b)
      let O_ca : (C_loc c).Opens := (TopologicalSpace.Opens.map (g_loc c ≫ (W c).ι).base).obj (W a)
      ∃ ψ_abc : (O_ab ⊓ O_ac).toScheme ⟶ O_bc.toScheme,
        ψ_abc ≫ O_bc.ι = (C_loc a).homOfLE inf_le_left ≫ (φ a b).hom ≫ O_ba.ι ∧
        ψ_abc ≫ (φ b c).hom ≫ O_cb.ι =
          (C_loc a).homOfLE inf_le_right ≫ (φ a c).hom ≫ O_ca.ι)
    (hClause5 : ∀ (a b : Fin N) (j : Fin n),
      let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
      let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
      ∃ (t_ab : (W a ⊓ W b).toScheme ⟶ O_ab.toScheme),
        t_ab ≫ O_ab.ι = B₃.left.homOfLE inf_le_left ≫ τ_loc a j ∧
        (t_ab ≫ (φ a b).hom) ≫ O_ba.ι = B₃.left.homOfLE inf_le_right ≫ τ_loc b j)
    (hClause6 : ∀ a b : Fin N,
      let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
      let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
      let V_a : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj U₃
      let V_b : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj U₃
      ∃ (φ_U₃ : (O_ab ⊓ V_a).toScheme ⟶ V_b.toScheme),
        φ_U₃ ≫ V_b.ι = (C_loc a).homOfLE inf_le_left ≫ (φ a b).hom ≫ O_ba.ι ∧
        φ_U₃ ≫ ι_loc b = (C_loc a).homOfLE inf_le_right ≫ ι_loc a) :
    ∃ (C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (g₃ : C₃ ⟶ B₃)
      (τ₃ : Fin n → (B₃ ⟶ C₃)),
      IsGeometricStablePointedCurve g₃.left n (fun j => (τ₃ j).left) ∧
      AlgebraicGeometry.IsIntegral C₃.left ∧
      HasOpenPointedCurvePullbackIsoOver k f₂ σ ψ₃ U₃ g₃ τ₃ :=
by
  have hSecLoc : ∀ (a : Fin N) (j : Fin n), τ_loc a j ≫ g_loc a = 𝟙 (W a).toScheme :=
    fun a j => (hStabLoc a).2.2.2.2.2.1 j
  have hGlue :
      ∃ (C : AlgebraicGeometry.Scheme.{u})
        (g : C ⟶ B₃.left)
        (τ : Fin n → (B₃.left ⟶ C))
        (ι_chart : ∀ a : Fin N, C_loc a ⟶ C),
        (∀ a : Fin N, AlgebraicGeometry.IsOpenImmersion (ι_chart a)) ∧
        (∀ a : Fin N, Set.range (ι_chart a).base = g.base ⁻¹' ((W a : B₃.left.Opens) : Set B₃.left)) ∧
        (∀ a : Fin N, ι_chart a ≫ g = g_loc a ≫ (W a).ι) ∧
        (∀ a : Fin N, CategoryTheory.IsPullback (ι_chart a) (g_loc a) g (W a).ι) ∧
        (∀ j : Fin n, τ j ≫ g = 𝟙 B₃.left) ∧
        (∀ (a : Fin N) (j : Fin n), (W a).ι ≫ τ j = τ_loc a j ≫ ι_chart a) ∧
        (∀ a b : Fin N,
          let O_ab : (C_loc a).Opens := (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
          let O_ba : (C_loc b).Opens := (TopologicalSpace.Opens.map (g_loc b ≫ (W b).ι).base).obj (W a)
          O_ab.ι ≫ ι_chart a = (φ a b).hom ≫ O_ba.ι ≫ ι_chart b) := by
    let O (a b : Fin N) : (C_loc a).Opens :=
      (TopologicalSpace.Opens.map (g_loc a ≫ (W a).ι).base).obj (W b)
    have hO_top : ∀ a : Fin N, O a a = ⊤ := by
      intro a
      ext x
      simp only [O, SetLike.mem_coe, TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hx : (g_loc a ≫ (W a).ι).base x ∈ Set.range (W a).ι.base :=
        ⟨(g_loc a).base x, by simp⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hx
    have hf_id : ∀ a : Fin N, CategoryTheory.IsIso (O a a).ι := by
      intro a
      rw [AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective]
      refine ⟨inferInstance, ⟨fun x => ?_⟩⟩
      have hx : x ∈ Set.range (O a a).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hO_top a]
        trivial
      exact hx
    have hSymm : ∀ a b : Fin N, (φ a b).hom ≫ (φ b a).hom = 𝟙 (O a b).toScheme := by
      intro a b
      obtain ⟨ψ_aba, hψ1, hψ2⟩ := hClause4 a b a
      have h_le : O a b ≤ O a b ⊓ O a a := le_inf (le_refl _) (by rw [hO_top a]; exact le_top)
      let u_ab : (O a b).toScheme ⟶ (O a b ⊓ O a a).toScheme := (C_loc a).homOfLE h_le
      have hu_left : u_ab ≫ (C_loc a).homOfLE inf_le_left = 𝟙 (O a b).toScheme := by
        rw [← cancel_mono (O a b).ι, Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι,
