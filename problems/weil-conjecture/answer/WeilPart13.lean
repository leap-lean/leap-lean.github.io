  have h_jac_rels :
      ∀ (P : Type u) [CommRing P]
        (c_P : R₁ →+* P) (X₀_P X₁_P : P)
        (r : ℕ) (Phi : MvPolynomial (Fin r) P →+* A₁)
        (_ : Function.Surjective Phi)
        (_ : ∀ r₀ : R₁, Phi (MvPolynomial.C (c_P r₀)) = f₁ r₀)
        (_ : Phi (MvPolynomial.C X₀_P) = u₁)
        (_ : Phi (MvPolynomial.C X₁_P) = v₁),
        ∃ G : Fin r → MvPolynomial (Fin r) P,
          (∀ j : Fin r, Phi (G j) = 0) ∧
          Phi (Matrix.of fun i j : Fin r => MvPolynomial.pderiv i (G j)).det ∉ q₁.asIdeal := by
    intro P _ c_P X₀_P X₁_P r Phi hPhi_surj hPhi_C hPhi_X0 hPhi_X1
    choose s a w b₀ b₁ hs hw hy_mem hrel using
      fun j : Fin r => h_elem_lift (Phi (MvPolynomial.X j))
    let c_R : R₁ →+* MvPolynomial (Fin r) P := MvPolynomial.C.comp c_P
    have hc_R_comp : Phi.comp c_R = f₁ := RingHom.ext hPhi_C
    have h_surj_map :
        ∀ (I : Ideal (MvPolynomial (Fin r) P)) (y : A₁),
          y ∈ Ideal.map Phi I → ∃ Z ∈ I, Phi Z = y := by
      intro I y hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro _ ⟨Z, hZ, rfl⟩; exact ⟨Z, hZ, rfl⟩
      · exact ⟨0, Ideal.zero_mem _, map_zero _⟩
      · rintro y₁ y₂ _ _ ⟨Z₁, hZ₁, rfl⟩ ⟨Z₂, hZ₂, rfl⟩
        exact ⟨Z₁ + Z₂, add_mem hZ₁ hZ₂, map_add _ _ _⟩
      · rintro a' y₁ _ ⟨Z₁, hZ₁, rfl⟩
        obtain ⟨F, rfl⟩ := hPhi_surj a'
        exact ⟨F * Z₁, Ideal.mul_mem_left _ _ hZ₁, map_mul _ _ _⟩
    have hrel_map : ∀ j : Fin r,
        w j * (f₁ (s j) * Phi (MvPolynomial.X j) - f₁ (a j)) - b₀ j * u₁ - b₁ j * v₁ ∈
          Ideal.map Phi (Ideal.map c_R p₁.asIdeal) := by
      intro j
      rw [Ideal.map_map, hc_R_comp]
