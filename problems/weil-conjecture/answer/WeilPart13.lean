    let ψ₄_U := AlgebraicGeometry.IsOpenImmersion.lift U₃.ι (U_B.ι ≫ ψ₄.left) hψ₄U_sub
    have hψ₄U_fac : ψ₄_U ≫ U₃.ι = U_B.ι ≫ ψ₄.left :=
