  have hu_s₁ : IsUnit (algebraMap B₀ B s₁) := by
    refine isUnit_of_mul_isUnit_right (x := algebraMap B₀ B (w_tot * β)) ?_
    rw [← map_mul]
    exact hu_sB
  let u_w : Bˣ := hu_wtot.unit
  let u_β : Bˣ := hu_β.unit
  let u_s₁ : Bˣ := hu_s₁.unit
  let u_sB : Bˣ := hu_sB.unit
  let g : B := ↑(u_w⁻¹) * algebraMap B₀ B (β * g₀)
  have hg_cong : g - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
      Ideal.map (φ_P.comp MvPolynomial.C) (PrimeSpectrum.comap f₁ q₁).asIdeal ⊔
        Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 := by
    have hRel_B : algebraMap B₀ B w_tot * φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) =
        algebraMap B₀ B (β * g₀) + algebraMap B₀ B p_elem + algebraMap B₀ B c₃ := by
      simpa [φ_P, map_mul, map_add, add_assoc] using congrArg (algebraMap B₀ B) hRel
    have hdiff : g - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) =
        (-↑(u_w⁻¹)) * algebraMap B₀ B p_elem + (-↑(u_w⁻¹)) * algebraMap B₀ B c₃ := by
      have h1 : ↑(u_w⁻¹) * (algebraMap B₀ B w_tot * φ_P (MvPolynomial.X 0 * MvPolynomial.X 1)) =
          φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) := by
        rw [← mul_assoc]
        have hw : (↑(u_w⁻¹) : B) * algebraMap B₀ B w_tot = 1 := u_w.inv_mul
        rw [hw, one_mul]
      have h2 := congrArg (fun z : B => (↑(u_w⁻¹) : B) * z) hRel_B
      rw [h1] at h2
      dsimp [g] at h2 ⊢
      linear_combination -h2
    rw [hdiff]
    refine Submodule.add_mem_sup ?_ ?_
    · refine Ideal.mul_mem_left _ _ ?_
      have hmap : Ideal.map (φ_P.comp MvPolynomial.C) (PrimeSpectrum.comap f₁ q₁).asIdeal =
          Ideal.map (algebraMap B₀ B)
            (Ideal.map (φ₀.comp MvPolynomial.C) (PrimeSpectrum.comap f₁ q₁).asIdeal) := by
        rw [Ideal.map_map]
        rfl
      rw [hmap]
      exact Ideal.mem_map_of_mem _ hp_elem
    · refine Ideal.mul_mem_left _ _ ?_
      have hspan : Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 =
          Ideal.map (algebraMap B₀ B)
            (Ideal.span {φ₀ (MvPolynomial.X 0), φ₀ (MvPolynomial.X 1)} ^ 3) := by
        rw [Ideal.map_pow, Ideal.map_span]
        simp [φ_P, Set.image_insert_eq, Set.image_singleton]
      rw [hspan]
      exact Ideal.mem_map_of_mem _ hc₃
  let s_B_bar : A'₁ := π₀ s_B
  have hs_B_bar : s_B_bar ∉ q'₁.asIdeal := by
    intro hmem
    apply hs_B
    rw [← hQ₀_as]
    exact hmem
  let A''₁ : Type u := Localization.Away s_B_bar
  let f_to_A'' : B₀ →+* A''₁ := (algebraMap A'₁ A''₁).comp π₀
  have hu_bar : IsUnit (f_to_A'' s_B) :=
    IsLocalization.Away.algebraMap_isUnit s_B_bar
  let π_B : B →+* A''₁ := IsLocalization.Away.lift (S := B) s_B hu_bar
  have hπ_B_eq : ∀ x : B₀, π_B (algebraMap B₀ B x) = algebraMap A'₁ A''₁ (π₀ x) :=
    fun x => IsLocalization.Away.lift_eq (S := B) s_B hu_bar x
  have hπ_B_surj : Function.Surjective π_B := by
    intro y
    obtain ⟨k, x, hxk⟩ := IsLocalization.Away.surj s_B_bar y
    obtain ⟨b₀, rfl⟩ := hSurj₀ x
    refine ⟨algebraMap B₀ B b₀ * ↑((u_sB ^ k)⁻¹), ?_⟩
    have hmap_unit : π_B ↑((u_sB ^ k)⁻¹) = ↑((hu_bar.unit ^ k)⁻¹) := by
      apply (hu_bar.unit ^ k).mul_right_inj.mp
      have hpow : (hu_bar.unit ^ k : A''₁ˣ).val = π_B ↑(u_sB ^ k) := by
        simp only [Units.val_pow_eq_pow_val, map_pow]
        have hbase : π_B (u_sB : B) = (hu_bar.unit : A''₁) := hπ_B_eq s_B
        rw [hbase]
      rw [hpow, ← map_mul, Units.mul_inv, map_one, ← hpow, Units.mul_inv]
    rw [map_mul, hmap_unit, hπ_B_eq b₀, ← hxk, mul_assoc]
    have hcancel : (algebraMap A'₁ A''₁ s_B_bar) ^ k * ↑((hu_bar.unit ^ k)⁻¹) = 1 :=
      (hu_bar.unit ^ k).mul_inv
    rw [hcancel, mul_one]
  have hπ_B_ker : RingHom.ker π_B = Ideal.span {g} := by
    apply le_antisymm
    · intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨n, x, hxn⟩ := IsLocalization.Away.surj s_B z
      have hπ_x : algebraMap A'₁ A''₁ (π₀ x) = 0 := by
        rw [← hπ_B_eq x, ← hxn, map_mul, hz, zero_mul]
      have hpow_zero : ∃ m : ℕ, s_B_bar ^ m * π₀ x = 0 := by
        have hzero := (IsLocalization.map_eq_zero_iff (Submonoid.powers s_B_bar) A''₁ (π₀ x)).mp hπ_x
        obtain ⟨⟨_, m, rfl⟩, hm⟩ := hzero
        exact ⟨m, hm⟩
      obtain ⟨m, hm⟩ := hpow_zero
      have hker_m : s_B ^ m * x ∈ RingHom.ker π₀ := by
        rw [RingHom.mem_ker, map_mul, map_pow]
        exact hm
      obtain ⟨b, hb⟩ := hPrin (s_B ^ m * x) hker_m
      have hb_B := congrArg (algebraMap B₀ B) hb
      simp only [map_mul, map_pow] at hb_B
      have hg₀_eq : algebraMap B₀ B g₀ = ↑(u_β⁻¹) * (u_w : B) * g := by
        dsimp [g]
        rw [map_mul]
        have hβ_inv : (↑(u_β⁻¹) : B) * algebraMap B₀ B β = 1 := u_β.inv_mul
        have hw_inv : (u_w : B) * ↑(u_w⁻¹) = 1 := u_w.mul_inv
        calc
          algebraMap B₀ B g₀ = 1 * algebraMap B₀ B g₀ := (one_mul _).symm
          _ = ((↑(u_β⁻¹) : B) * algebraMap B₀ B β) * algebraMap B₀ B g₀ := by rw [hβ_inv]
          _ = ↑(u_β⁻¹) * (1 * (algebraMap B₀ B β * algebraMap B₀ B g₀)) := by ring
          _ = ↑(u_β⁻¹) * (((u_w : B) * ↑(u_w⁻¹)) * (algebraMap B₀ B β * algebraMap B₀ B g₀)) := by
              rw [hw_inv]
          _ = ↑(u_β⁻¹) * (u_w : B) * (↑(u_w⁻¹) * (algebraMap B₀ B β * algebraMap B₀ B g₀)) := by
              ring
      have hz_eq : z = g * (↑((u_sB ^ n)⁻¹) * ↑(u_s₁⁻¹) * ↑((u_sB ^ m)⁻¹) *
          algebraMap B₀ B b * ↑(u_β⁻¹) * (u_w : B)) := by
        have hzx : z = ↑((u_sB ^ n)⁻¹) * algebraMap B₀ B x := by
          apply (u_sB ^ n).mul_right_inj.mp
          have hmul : (u_sB ^ n : Bˣ).val * z = z * (algebraMap B₀ B s_B) ^ n := by
            rw [mul_comm, Units.val_pow_eq_pow_val]; rfl
          rw [hmul, hxn, ← mul_assoc, Units.mul_inv, one_mul]
        have hx_B : algebraMap B₀ B x =
            ↑(u_s₁⁻¹) * ↑((u_sB ^ m)⁻¹) * (algebraMap B₀ B b * algebraMap B₀ B g₀) := by
          apply (u_s₁ * u_sB ^ m).mul_right_inj.mp
          have hunit_inv : ((u_s₁ * u_sB ^ m : Bˣ) : B) *
              (↑(u_s₁⁻¹) * ↑((u_sB ^ m)⁻¹)) = 1 := by
            simp only [Units.val_mul]
            calc
              ((u_s₁ : B) * (u_sB ^ m : Bˣ).val) * (↑(u_s₁⁻¹) * ↑((u_sB ^ m)⁻¹))
                = ((u_s₁ : B) * ↑(u_s₁⁻¹)) * ((u_sB ^ m : Bˣ).val * ↑((u_sB ^ m)⁻¹)) := by ring
              _ = 1 * 1 := by rw [u_s₁.mul_inv, (u_sB ^ m).mul_inv]
              _ = 1 := one_mul 1
          rw [← mul_assoc, hunit_inv, one_mul]
          have hu_val : ((u_s₁ * u_sB ^ m : Bˣ) : B) * algebraMap B₀ B x =
              algebraMap B₀ B s₁ * ((algebraMap B₀ B s_B) ^ m * algebraMap B₀ B x) := by
            simp only [Units.val_mul, Units.val_pow_eq_pow_val]
            exact mul_assoc _ _ _
          rw [hu_val]
          exact hb_B
        rw [hzx, hx_B, hg₀_eq]
        ring
      rw [Ideal.mem_span_singleton]
      exact ⟨_, hz_eq⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      dsimp [g]
      rw [map_mul, map_mul, map_mul]
      have hg₀_zero : π_B (algebraMap B₀ B g₀) = 0 := by
        rw [hπ_B_eq g₀, RingHom.mem_ker.mp hg₀, map_zero]
      rw [hg₀_zero, mul_zero, mul_zero]
  let e_iso : (B ⧸ Ideal.span {g}) ≃+* A''₁ :=
    (Ideal.quotEquivOfEq hπ_B_ker.symm).trans (RingHom.quotientKerEquivOfSurjective hπ_B_surj)
  have he_iso_mk : ∀ b : B, e_iso (Ideal.Quotient.mk (Ideal.span {g}) b) = π_B b := fun _ => rfl
  let ι_A : A₁ →+* A''₁ := (algebraMap A'₁ A''₁).comp (algebraMap A₁ A'₁)
  have hι_A_et : ι_A.Etale := by
    have het1 : (algebraMap A₁ A'₁).Etale := by
      rw [RingHom.etale_algebraMap]; exact Algebra.Etale.of_isLocalizationAway s_A
    have het2 : (algebraMap A'₁ A''₁).Etale := by
      rw [RingHom.etale_algebraMap]; exact Algebra.Etale.of_isLocalizationAway s_B_bar
    exact RingHom.Etale.stableUnderComposition (algebraMap A₁ A'₁) (algebraMap A'₁ A''₁) het1 het2
  let e_hyp : A₁ →+* (B ⧸ Ideal.span {g}) := e_iso.symm.toRingHom.comp ι_A
  have he_hyp_et : e_hyp.Etale :=
    RingHom.Etale.stableUnderComposition ι_A e_iso.symm.toRingHom hι_A_et
      (RingHom.Etale.of_bijective (f := e_iso.symm.toRingHom) e_iso.symm.bijective)
  have hq'₁_mem : q'₁ ∈ Set.range (PrimeSpectrum.comap (algebraMap A'₁ A''₁)) := by
    rw [PrimeSpectrum.localization_comap_range A''₁ (Submonoid.powers s_B_bar)]
    rw [Set.mem_ofPred_eq, Set.disjoint_left]
    rintro x ⟨n, rfl⟩ hx
    exact hs_B_bar (q'₁.isPrime.mem_of_pow_mem n hx)
  obtain ⟨q''₁, hq''₁⟩ := hq'₁_mem
  let q_bar : PrimeSpectrum (B ⧸ Ideal.span {g}) := PrimeSpectrum.comap e_iso.toRingHom q''₁
  refine ⟨B, inferInstance, φ_P, Q, g, e_hyp, hφ_P_et, he_hyp_et, ?_, ?_, hg_cong, ?_, ⟨q_bar, ?_, ?_⟩⟩
  · have hQ_as : Q.asIdeal.comap (algebraMap B₀ B) = Q₀.asIdeal := congrArg PrimeSpectrum.asIdeal hQ
    ext r
    simp only [Ideal.mem_comap, RingHom.comp_apply, PrimeSpectrum.comap_asIdeal]
    have h1 : φ_P (MvPolynomial.C r) ∈ Q.asIdeal ↔ φ₀ (MvPolynomial.C r) ∈ Q₀.asIdeal := by
      rw [← hQ_as]; rfl
    have h2 : φ₀ (MvPolynomial.C r) ∈ Q₀.asIdeal ↔ π₀ (φ₀ (MvPolynomial.C r)) ∈ q'₁.asIdeal := by
      rw [← hQ₀_as]; rfl
    have h4 : algebraMap A₁ A'₁ (f₁ r) ∈ q'₁.asIdeal ↔ f₁ r ∈ q₁.asIdeal := by
      rw [← hq'₁_as]; rfl
    exact (h1.trans h2).trans ((iff_of_eq (congrArg (· ∈ q'₁.asIdeal) (hπ₀_C r))).trans h4)
  · intro i
    have hQ_as : Q.asIdeal.comap (algebraMap B₀ B) = Q₀.asIdeal := congrArg PrimeSpectrum.asIdeal hQ
    rw [show φ_P (MvPolynomial.X i) = algebraMap B₀ B (φ₀ (MvPolynomial.X i)) from rfl,
      ← Ideal.mem_comap, hQ_as]
    fin_cases i
    · exact hU₀_mem
    · exact hV₀_mem
  · ext r
    apply e_iso.injective
    simp only [RingHom.comp_apply, e_hyp, ι_A, RingEquiv.toRingHom_eq_coe,
      RingHom.coe_coe, RingEquiv.apply_symm_apply, he_iso_mk]
    rw [show φ_P (MvPolynomial.C r) = algebraMap B₀ B (φ₀ (MvPolynomial.C r)) from rfl,
      hπ_B_eq, hπ₀_C r]
  · apply PrimeSpectrum.localization_comap_injective B (Submonoid.powers s_B)
    rw [hQ]
    ext x
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    change π_B (algebraMap B₀ B x) ∈ q''₁.asIdeal ↔ x ∈ Q₀.asIdeal
    rw [hπ_B_eq x]
    have hq''₁_as : q''₁.asIdeal.comap (algebraMap A'₁ A''₁) = q'₁.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hq''₁
    rw [← Ideal.mem_comap, hq''₁_as, ← Ideal.mem_comap, hQ₀_as]
  · ext a
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, q_bar, e_hyp, ι_A,
      RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.apply_symm_apply]
    have hq''₁_as : q''₁.asIdeal.comap (algebraMap A'₁ A''₁) = q'₁.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hq''₁
    rw [← Ideal.mem_comap, hq''₁_as, ← Ideal.mem_comap, hq'₁_as]

theorem weil_etale_plane_nodal_hypersurface_to_standard_nodal_roof (R₁ B : Type u) [CommRing R₁] [CommRing B]
    (p₁ : PrimeSpectrum R₁)
    (φ_P : MvPolynomial (Fin 2) R₁ →+* B)
    (hEtP : φ_P.Etale)
    (Q : PrimeSpectrum B)
    (hQp : Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = p₁.asIdeal)
    (hXi : ∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal)
    (g : B)
    (hg : g - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
      Ideal.map (φ_P.comp MvPolynomial.C) p₁.asIdeal ⊔
        Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3)
    (q_bar : PrimeSpectrum (B ⧸ Ideal.span {g}))
    (hq_bar : PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {g})) q_bar = Q) :
    HasStandardNodalRingRoofAt
      ((Ideal.Quotient.mk (Ideal.span {g})).comp (φ_P.comp MvPolynomial.C)) q_bar :=
by
  
  have h_dual_basis : ∀ {R C : Type u} [CommRing R] [CommRing C] [Algebra R C]
      (φ : MvPolynomial (Fin 2) R →+* C)
      (_ : algebraMap R C = φ.comp MvPolynomial.C) (_ : φ.Etale),
      ∃ (b_C : Module.Basis (Fin 2) C Ω[C⁄R]) (der_C : Fin 2 → Derivation R C C),
        (∀ i : Fin 2, b_C i = KaehlerDifferential.D R C (φ (MvPolynomial.X i))) ∧
        (∀ i j : Fin 2, der_C i (φ (MvPolynomial.X j)) = if j = i then 1 else 0) ∧
        (∀ x : C, KaehlerDifferential.D R C x = der_C 0 x • b_C 0 + der_C 1 x • b_C 1) := by
    intro R C _ _ _ φ hAlg hEt
    let P := MvPolynomial (Fin 2) R
    letI : Algebra P C := φ.toAlgebra
    haveI : IsScalarTower R P C := IsScalarTower.of_algebraMap_eq' hAlg
    haveI : Algebra.Etale P C := RingHom.etale_algebraMap.mp hEt
    obtain ⟨hSubΩ, hSubH1⟩ := (Algebra.formallyEtale_iff P C).mp inferInstance
    have hInj : Function.Injective (KaehlerDifferential.mapBaseChange R P C) := by
      intro x y hxy
      rw [← sub_eq_zero] at hxy ⊢
      rw [← map_sub] at hxy
      obtain ⟨z, hz⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange R P C (x - y)).mp hxy
      rw [← hz, Subsingleton.elim z 0, map_zero]
    have hSurj : Function.Surjective (KaehlerDifferential.mapBaseChange R P C) := by
      intro ω
      exact (KaehlerDifferential.exact_mapBaseChange_map R P C ω).mp (Subsingleton.elim _ _)
    let eΩ : TensorProduct P C Ω[P⁄R] ≃ₗ[C] Ω[C⁄R] :=
      LinearEquiv.ofBijective (KaehlerDifferential.mapBaseChange R P C) ⟨hInj, hSurj⟩
    let b₀ : Module.Basis (Fin 2) P Ω[P⁄R] := KaehlerDifferential.mvPolynomialBasis R (Fin 2)
    have hb₀ : ∀ j : Fin 2, b₀ j = KaehlerDifferential.D R P (MvPolynomial.X j) := by
      intro j
      apply b₀.repr.injective
      ext i
      rw [Module.Basis.repr_self, Finsupp.single_apply,
        KaehlerDifferential.mvPolynomialBasis_repr_apply]
      by_cases hij : j = i
      · subst hij; simp [MvPolynomial.pderiv_X_self]
      · simp [hij, MvPolynomial.pderiv_X_of_ne (Ne.symm hij)]
    let b_C : Module.Basis (Fin 2) C Ω[C⁄R] := (Algebra.TensorProduct.basis C b₀).map eΩ
    have hb_C : ∀ i : Fin 2, b_C i = KaehlerDifferential.D R C (φ (MvPolynomial.X i)) := by
      intro i
      change KaehlerDifferential.mapBaseChange R P C ((Algebra.TensorProduct.basis C b₀) i) = _
      rw [Algebra.TensorProduct.basis_apply, hb₀ i, KaehlerDifferential.mapBaseChange_tmul,
        one_smul, KaehlerDifferential.map_D]
      rfl
    let der_C : Fin 2 → Derivation R C C :=
      fun i => KaehlerDifferential.linearMapEquivDerivation R C (b_C.coord i)
    refine ⟨b_C, der_C, hb_C, ?_, ?_⟩
    · intro i j
      change (b_C.coord i) (KaehlerDifferential.D R C (φ (MvPolynomial.X j))) = _
      rw [← hb_C j, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
    · intro x
      have hrepr := (b_C.sum_repr (KaehlerDifferential.D R C x)).symm
      rw [Fin.sum_univ_two] at hrepr
      exact hrepr

  
  have hg_Q : g ∈ Q.asIdeal := by
    rw [← hq_bar]
    change Ideal.Quotient.mk (Ideal.span {g}) g ∈ q_bar.asIdeal
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g)]
    exact q_bar.asIdeal.zero_mem

  
  letI : Algebra R₁ B := (φ_P.comp MvPolynomial.C).toAlgebra
  obtain ⟨b_B, der_B, hb_B, hder_B, hD_B⟩ := h_dual_basis φ_P rfl hEtP
  obtain ⟨der₀, hder₀_def⟩ : ∃ d : Derivation R₁ B B, d = der_B 0 := ⟨der_B 0, rfl⟩
  obtain ⟨der₁, hder₁_def⟩ : ∃ d : Derivation R₁ B B, d = der_B 1 := ⟨der_B 1, rfl⟩

  have h_step1 : ∃ (R₂ : Type u) (_ : CommRing R₂) (eR₂ : R₁ →+* R₂)
      (π_crit : B →+* R₂) (p₂ : PrimeSpectrum R₂),
      eR₂.Etale ∧
      π_crit.comp (φ_P.comp MvPolynomial.C) = eR₂ ∧
      PrimeSpectrum.comap π_crit p₂ = Q ∧
      π_crit (der₀ g) = 0 ∧ π_crit (der₁ g) = 0 := by
    let U : B := φ_P (MvPolynomial.X 0)
    let V : B := φ_P (MvPolynomial.X 1)
    let I_p₁ : Ideal B := Ideal.map (φ_P.comp MvPolynomial.C) p₁.asIdeal
    let I_UV : Ideal B := Ideal.span {U, V}
    have hIp₁_le : I_p₁ ≤ Q.asIdeal := Ideal.map_le_iff_le_comap.mpr (le_of_eq hQp.symm)
    have hIUV_le : I_UV ≤ Q.asIdeal := by
      rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · exact hXi 0
      · exact hXi 1
    have hD_Ip₁ : ∀ (D : Derivation R₁ B B) {x : B}, x ∈ I_p₁ → D x ∈ I_p₁ := by
      intro D x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨r, hr, rfl⟩
        change D (algebraMap R₁ B r) ∈ I_p₁
        rw [Derivation.map_algebraMap]
        exact I_p₁.zero_mem
      · rw [map_zero]; exact I_p₁.zero_mem
      · intro a b _ _ ha hb; rw [map_add]; exact I_p₁.add_mem ha hb
      · intro b a _ ha
        change D (b * a) ∈ I_p₁
        rw [Derivation.leibniz]
        exact I_p₁.add_mem (I_p₁.mul_mem_left b ha) (I_p₁.mul_mem_right (D b) ‹a ∈ I_p₁›)
    have hD_sq : ∀ (D : Derivation R₁ B B) {x : B}, x ∈ I_UV ^ 2 → D x ∈ I_UV := by
      intro D x hx
      rw [pow_two] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz]
        exact I_UV.add_mem (I_UV.mul_mem_right (D b) ha) (I_UV.mul_mem_right (D a) hb)
      · intro a b ha hb; rw [map_add]; exact I_UV.add_mem ha hb
    have hD_cube : ∀ (D : Derivation R₁ B B) {x : B}, x ∈ I_UV ^ 3 → D x ∈ I_UV ^ 2 := by
      intro D x hx
      have hx' : x ∈ I_UV * I_UV ^ 2 := by simpa [pow_succ'] using hx
      refine Submodule.mul_induction_on hx' ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, pow_two]
        have h1 : a * D b ∈ I_UV * I_UV := Submodule.mul_mem_mul ha (hD_sq D hb)
        have h2 : b * D a ∈ I_UV * I_UV := by
          rw [← pow_two] at *; exact (I_UV ^ 2).mul_mem_right (D a) hb
        exact (I_UV * I_UV).add_mem h1 h2
      · intro a b ha hb; rw [map_add]; exact (I_UV ^ 2).add_mem ha hb
    obtain ⟨p_part, hp_part, c_cub, hc_cub, h_decomp⟩ := Submodule.mem_sup.mp hg
    have hg_eq : g = U * V + p_part + c_cub := by
      have hUV : φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) = U * V := map_mul φ_P _ _
      linear_combination h_decomp.symm + hUV
    have hder₀U : der₀ U = 1 := by rw [hder₀_def]; simpa [U] using hder_B 0 0
    have hder₀V : der₀ V = 0 := by rw [hder₀_def]; simpa [V] using hder_B 0 1
    have hder₁U : der₁ U = 0 := by rw [hder₁_def]; simpa [U] using hder_B 1 0
    have hder₁V : der₁ V = 1 := by rw [hder₁_def]; simpa [V] using hder_B 1 1
    have hder₀UV : der₀ (U * V) = V := by
      rw [Derivation.leibniz]; simp [hder₀U, hder₀V]
    have hder₁UV : der₁ (U * V) = U := by
      rw [Derivation.leibniz]; simp [hder₁U, hder₁V]
    obtain ⟨F₀, hF₀_def⟩ : ∃ x : B, x = der₀ g := ⟨der₀ g, rfl⟩
    obtain ⟨F₁, hF₁_def⟩ : ∃ x : B, x = der₁ g := ⟨der₁ g, rfl⟩
    have hF₀_eq : F₀ = V + der₀ p_part + der₀ c_cub := by
      rw [hF₀_def, hg_eq, map_add, map_add, hder₀UV]
    have hF₁_eq : F₁ = U + der₁ p_part + der₁ c_cub := by
      rw [hF₁_def, hg_eq, map_add, map_add, hder₁UV]
    have hIUV2_le : I_UV ^ 2 ≤ Q.asIdeal := le_trans (Ideal.pow_le_self (by norm_num)) hIUV_le
    have hF₀_Q : F₀ ∈ Q.asIdeal := by
      rw [hF₀_eq]
      exact Q.asIdeal.add_mem (Q.asIdeal.add_mem (hXi 1) (hIp₁_le (hD_Ip₁ der₀ hp_part)))
        (hIUV2_le (hD_cube der₀ hc_cub))
    have hF₁_Q : F₁ ∈ Q.asIdeal := by
      rw [hF₁_eq]
      exact Q.asIdeal.add_mem (Q.asIdeal.add_mem (hXi 0) (hIp₁_le (hD_Ip₁ der₁ hp_part)))
        (hIUV2_le (hD_cube der₁ hc_cub))
    have h00_Q : der₀ F₀ ∈ Q.asIdeal := by
      rw [hF₀_eq, map_add, map_add, hder₀V, zero_add]
      exact Q.asIdeal.add_mem (hIp₁_le (hD_Ip₁ der₀ (hD_Ip₁ der₀ hp_part)))
        (hIUV_le (hD_sq der₀ (hD_cube der₀ hc_cub)))
    have h10_Q : der₁ F₀ - 1 ∈ Q.asIdeal := by
      have : der₁ F₀ - 1 = der₁ (der₀ p_part) + der₁ (der₀ c_cub) := by
        rw [hF₀_eq, map_add, map_add, hder₁V]; ring
      rw [this]
      exact Q.asIdeal.add_mem (hIp₁_le (hD_Ip₁ der₁ (hD_Ip₁ der₀ hp_part)))
        (hIUV_le (hD_sq der₁ (hD_cube der₀ hc_cub)))
    have h01_Q : der₀ F₁ - 1 ∈ Q.asIdeal := by
      have : der₀ F₁ - 1 = der₀ (der₁ p_part) + der₀ (der₁ c_cub) := by
        rw [hF₁_eq, map_add, map_add, hder₀U]; ring
      rw [this]
      exact Q.asIdeal.add_mem (hIp₁_le (hD_Ip₁ der₀ (hD_Ip₁ der₁ hp_part)))
        (hIUV_le (hD_sq der₀ (hD_cube der₁ hc_cub)))
    have h11_Q : der₁ F₁ ∈ Q.asIdeal := by
      rw [hF₁_eq, map_add, map_add, hder₁U, zero_add]
      exact Q.asIdeal.add_mem (hIp₁_le (hD_Ip₁ der₁ (hD_Ip₁ der₁ hp_part)))
        (hIUV_le (hD_sq der₁ (hD_cube der₁ hc_cub)))
    obtain ⟨Δ_crit, hΔ_def⟩ : ∃ x : B, x = der₀ F₀ * der₁ F₁ - der₁ F₀ * der₀ F₁ := ⟨_, rfl⟩
    have hΔ_plus_one : Δ_crit + 1 ∈ Q.asIdeal := by
      have h_id : Δ_crit + 1 = der₀ F₀ * der₁ F₁ - (der₁ F₀ - 1) * der₀ F₁ - (der₀ F₁ - 1) := by
        rw [hΔ_def]; ring
      rw [h_id]
      exact Q.asIdeal.sub_mem
        (Q.asIdeal.sub_mem (Q.asIdeal.mul_mem_right _ h00_Q) (Q.asIdeal.mul_mem_right _ h10_Q))
        h01_Q
    let S : Type u := Localization.Away Δ_crit
    let loc : B →+* S := algebraMap B S
    let I_crit : Ideal S := Ideal.span {loc F₀, loc F₁}
    let R₂ : Type u := S ⧸ I_crit
    let π_S : S →+* R₂ := Ideal.Quotient.mk I_crit
    let π_crit : B →+* R₂ := π_S.comp loc
    let eR₂ : R₁ →+* R₂ := π_crit.comp (φ_P.comp MvPolynomial.C)
    letI : Q.asIdeal.IsPrime := Q.isPrime
    let K_Q : Type u := FractionRing (B ⧸ Q.asIdeal)
    let toKQ : B →+* K_Q :=
      (algebraMap (B ⧸ Q.asIdeal) K_Q).comp (Ideal.Quotient.mk Q.asIdeal)
    have hker_KQ : ∀ b : B, toKQ b = 0 ↔ b ∈ Q.asIdeal := by
      intro b
      change algebraMap (B ⧸ Q.asIdeal) K_Q (Ideal.Quotient.mk Q.asIdeal b) = 0 ↔ _
      rw [← map_zero (algebraMap (B ⧸ Q.asIdeal) K_Q),
        (IsFractionRing.injective (B ⧸ Q.asIdeal) K_Q).eq_iff,
        Ideal.Quotient.eq_zero_iff_mem]
    have hΔ_unit_KQ : IsUnit (toKQ Δ_crit) := by
      have h0 : toKQ (Δ_crit + 1) = 0 := (hker_KQ _).mpr hΔ_plus_one
      rw [map_add, map_one, add_eq_zero_iff_eq_neg] at h0
      rw [h0]
      exact isUnit_one.neg
    let toKQ_S : S →+* K_Q := IsLocalization.Away.lift Δ_crit hΔ_unit_KQ
    have hIcrit_ker : ∀ s ∈ I_crit, toKQ_S s = 0 := by
      have hle : I_crit ≤ RingHom.ker toKQ_S := by
        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · change toKQ_S (algebraMap B S F₀) = 0
          rw [IsLocalization.Away.lift_eq]; exact (hker_KQ F₀).mpr hF₀_Q
        · change toKQ_S (algebraMap B S F₁) = 0
          rw [IsLocalization.Away.lift_eq]; exact (hker_KQ F₁).mpr hF₁_Q
      exact fun s hs => hle hs
    let toKQ_R₂ : R₂ →+* K_Q := Ideal.Quotient.lift I_crit toKQ_S hIcrit_ker
    let p₂ : PrimeSpectrum R₂ := PrimeSpectrum.comap toKQ_R₂ (⊥ : PrimeSpectrum K_Q)
    have hp₂_Q : PrimeSpectrum.comap π_crit p₂ = Q := by
      ext b
      change b ∈ Ideal.comap (toKQ_R₂.comp π_crit) (⊥ : Ideal K_Q) ↔ b ∈ Q.asIdeal
      have hcomp : toKQ_R₂.comp π_crit = toKQ := by
        ext x
        simp only [RingHom.comp_apply, π_crit, π_S, toKQ_R₂, Ideal.Quotient.lift_mk]
        exact IsLocalization.Away.lift_eq Δ_crit hΔ_unit_KQ x
      rw [hcomp, Ideal.mem_comap, Ideal.mem_bot, hker_KQ]
    have heR₂ : eR₂.Etale := by
      let P₁ := MvPolynomial (Fin 2) R₁
      letI : Algebra P₁ B := φ_P.toAlgebra
      haveI : IsScalarTower R₁ P₁ S := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : Algebra.Etale P₁ B := RingHom.etale_algebraMap.mp hEtP
      haveI : Algebra.Etale B S := Algebra.Etale.of_isLocalizationAway Δ_crit
      haveI : Algebra.Etale P₁ S := Algebra.Etale.comp P₁ B S
      haveI : Algebra.FormallySmooth R₁ S := Algebra.FormallySmooth.comp R₁ P₁ S
      haveI : Algebra.FinitePresentation R₁ S := Algebra.FinitePresentation.trans R₁ P₁ S
      have hFG_crit : I_crit.FG := Submodule.fg_span (Set.toFinite _)
      haveI : Algebra.FinitePresentation R₁ R₂ := Algebra.FinitePresentation.quotient hFG_crit
      have hEt_PS : (loc.comp φ_P).Etale := RingHom.etale_algebraMap.mpr (inferInstance : Algebra.Etale P₁ S)
      obtain ⟨b_S, _, hb_S, _, _⟩ := h_dual_basis (loc.comp φ_P) rfl hEt_PS
      have hD_S : ∀ x : B, KaehlerDifferential.D R₁ S (loc x) =
          loc (der₀ x) • b_S 0 + loc (der₁ x) • b_S 1 := by
        intro x
        have hm := KaehlerDifferential.map_D R₁ R₁ B S x
        change (KaehlerDifferential.map R₁ R₁ B S) (KaehlerDifferential.D R₁ B x) =
          KaehlerDifferential.D R₁ S (loc x) at hm
        rw [← hm, hD_B x, ← hder₀_def, ← hder₁_def, map_add, LinearMap.map_smul_of_tower,
          LinearMap.map_smul_of_tower,
          hb_B 0, hb_B 1, KaehlerDifferential.map_D, KaehlerDifferential.map_D, hb_S 0, hb_S 1,
          ← IsScalarTower.algebraMap_smul S (der₀ x), ← IsScalarTower.algebraMap_smul S (der₁ x)]
        rfl
      let K_ker : Ideal S := RingHom.ker (algebraMap S R₂)
      have hK_eq : K_ker = I_crit := Ideal.mk_ker
      let b_R₂ : Module.Basis (Fin 2) R₂ (TensorProduct S R₂ Ω[S⁄R₁]) :=
        Algebra.TensorProduct.basis R₂ b_S
      let κ := KaehlerDifferential.kerCotangentToTensor R₁ S R₂
      have hF₀_mem : loc F₀ ∈ K_ker := by rw [hK_eq]; exact Ideal.subset_span (Or.inl rfl)
      have hF₁_mem : loc F₁ ∈ K_ker := by rw [hK_eq]; exact Ideal.subset_span (Or.inr rfl)
      let w₀ : K_ker.Cotangent := K_ker.toCotangent ⟨loc F₀, hF₀_mem⟩
      let w₁ : K_ker.Cotangent := K_ker.toCotangent ⟨loc F₁, hF₁_mem⟩
      let a₀₀ : R₂ := π_crit (der₀ F₀)
      let a₀₁ : R₂ := π_crit (der₁ F₀)
      let a₁₀ : R₂ := π_crit (der₀ F₁)
      let a₁₁ : R₂ := π_crit (der₁ F₁)
      have hκ_w₀ : κ w₀ = a₀₀ • b_R₂ 0 + a₀₁ • b_R₂ 1 := by
        dsimp [κ, w₀]
        rw [KaehlerDifferential.kerCotangentToTensor_toCotangent, hD_S F₀,
          TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
          ← IsScalarTower.algebraMap_smul R₂ (loc (der₀ F₀)),
          ← IsScalarTower.algebraMap_smul R₂ (loc (der₁ F₀)),
          ← Algebra.TensorProduct.basis_apply b_S 0,
          ← Algebra.TensorProduct.basis_apply b_S 1]
        rfl
      have hκ_w₁ : κ w₁ = a₁₀ • b_R₂ 0 + a₁₁ • b_R₂ 1 := by
        dsimp [κ, w₁]
        rw [KaehlerDifferential.kerCotangentToTensor_toCotangent, hD_S F₁,
          TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
          ← IsScalarTower.algebraMap_smul R₂ (loc (der₀ F₁)),
          ← IsScalarTower.algebraMap_smul R₂ (loc (der₁ F₁)),
          ← Algebra.TensorProduct.basis_apply b_S 0,
          ← Algebra.TensorProduct.basis_apply b_S 1]
        rfl
      have hd_unit : IsUnit (a₀₀ * a₁₁ - a₀₁ * a₁₀) := by
        have hd_eq : a₀₀ * a₁₁ - a₀₁ * a₁₀ = π_S (loc Δ_crit) := by
          dsimp [a₀₀, a₀₁, a₁₀, a₁₁, π_crit]
          rw [congr_arg (fun z => π_S (loc z)) hΔ_def]
          simp only [RingHom.comp_apply, map_sub, map_mul]
        rw [hd_eq]
        exact (IsLocalization.Away.algebraMap_isUnit Δ_crit).map π_S
      obtain ⟨u_d, hu_d⟩ := hd_unit
      let d_inv : R₂ := ↑(u_d⁻¹)
      have hd_mul_inv : (a₀₀ * a₁₁ - a₀₁ * a₁₀) * d_inv = 1 := by
        rw [← hu_d]; exact Units.mul_inv u_d
      have hinv_mul_d : d_inv * (a₀₀ * a₁₁ - a₀₁ * a₁₀) = 1 := by
        rw [mul_comm]; exact hd_mul_inv
      have hπS_surj : Function.Surjective (algebraMap S R₂) := Ideal.Quotient.mk_surjective
      have hS_smul : ∀ (s : S) (z : TensorProduct S R₂ Ω[S⁄R₁]), s • z = (π_S s) • z := by
        intro s z; exact (IsScalarTower.algebraMap_smul R₂ s z).symm
      have hκ_inj : Function.Injective κ := by
        rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
        intro w hw
        rw [LinearMap.mem_ker] at hw
        obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective K_ker w
        have hx_span : x ∈ I_crit := by rwa [← hK_eq]
        rw [Ideal.mem_span_pair] at hx_span
        obtain ⟨c₀, c₁, rfl⟩ := hx_span
        have hsub_eq : (⟨c₀ * loc F₀ + c₁ * loc F₁, hx⟩ : K_ker) =
            c₀ • ⟨loc F₀, hF₀_mem⟩ + c₁ • ⟨loc F₁, hF₁_mem⟩ := by
          ext; simp [smul_eq_mul]
        rw [hsub_eq, map_add, map_smul, map_smul] at hw
        have hw' : κ (c₀ • w₀ + c₁ • w₁) = 0 := by simpa [w₀, w₁] using hw
        rw [map_add, map_smul, map_smul, hS_smul, hS_smul, hκ_w₀, hκ_w₁] at hw'
        have h_comb : (π_S c₀ * a₀₀ + π_S c₁ * a₁₀) • b_R₂ 0 +
            (π_S c₀ * a₀₁ + π_S c₁ * a₁₁) • b_R₂ 1 = 0 := by
          rw [← hw']
          simp only [add_smul, smul_add, mul_smul]
          abel
        have hc_eq0 : π_S c₀ * a₀₀ + π_S c₁ * a₁₀ = 0 := by
          have := congr_arg (fun z => (b_R₂.repr z) 0) h_comb
          simpa [Module.Basis.repr_self] using this
        have hc_eq1 : π_S c₀ * a₀₁ + π_S c₁ * a₁₁ = 0 := by
          have := congr_arg (fun z => (b_R₂.repr z) 1) h_comb
          simpa [Module.Basis.repr_self] using this
        have hc₀_zero : π_S c₀ = 0 := by
          calc π_S c₀ = π_S c₀ * ((a₀₀ * a₁₁ - a₀₁ * a₁₀) * d_inv) := by rw [hd_mul_inv, mul_one]
            _ = ((π_S c₀ * a₀₀ + π_S c₁ * a₁₀) * a₁₁ -
                  (π_S c₀ * a₀₁ + π_S c₁ * a₁₁) * a₁₀) * d_inv := by ring
            _ = 0 := by rw [hc_eq0, hc_eq1]; ring
        have hc₁_zero : π_S c₁ = 0 := by
          calc π_S c₁ = π_S c₁ * ((a₀₀ * a₁₁ - a₀₁ * a₁₀) * d_inv) := by rw [hd_mul_inv, mul_one]
            _ = (a₀₀ * (π_S c₀ * a₀₁ + π_S c₁ * a₁₁) -
                  a₀₁ * (π_S c₀ * a₀₀ + π_S c₁ * a₁₀)) * d_inv := by ring
            _ = 0 := by rw [hc_eq0, hc_eq1]; ring
        have hc₀_K : c₀ ∈ K_ker := hc₀_zero
        have hc₁_K : c₁ ∈ K_ker := hc₁_zero
        rw [Ideal.toCotangent_eq_zero, pow_two]
        exact (K_ker * K_ker).add_mem (Submodule.mul_mem_mul hc₀_K hF₀_mem)
          (Submodule.mul_mem_mul hc₁_K hF₁_mem)
      have hκ_surj : Function.Surjective κ := by
        obtain ⟨s_inv, hs_inv⟩ := hπS_surj d_inv
        obtain ⟨s₀₀, hs₀₀⟩ := hπS_surj a₀₀
        obtain ⟨s₀₁, hs₀₁⟩ := hπS_surj a₀₁
        obtain ⟨s₁₀, hs₁₀⟩ := hπS_surj a₁₀
        obtain ⟨s₁₁, hs₁₁⟩ := hπS_surj a₁₁
        change π_S s_inv = d_inv at hs_inv
        change π_S s₀₀ = a₀₀ at hs₀₀
        change π_S s₀₁ = a₀₁ at hs₀₁
        change π_S s₁₀ = a₁₀ at hs₁₀
        change π_S s₁₁ = a₁₁ at hs₁₁
        have hb0_hit : ∃ u₀ : K_ker.Cotangent, κ u₀ = b_R₂ 0 := by
          refine ⟨(s_inv * s₁₁) • w₀ - (s_inv * s₀₁) • w₁, ?_⟩
          rw [map_sub, map_smul, map_smul, hS_smul, hS_smul, map_mul, map_mul,
            hs_inv, hs₁₁, hs₀₁, hκ_w₀, hκ_w₁, sub_eq_iff_eq_add]
          have hr0 : d_inv * a₁₁ * a₀₀ = 1 + d_inv * a₀₁ * a₁₀ := by
            linear_combination hinv_mul_d
          have hr1 : d_inv * a₁₁ * a₀₁ = d_inv * a₀₁ * a₁₁ := by ring
          calc (d_inv * a₁₁) • (a₀₀ • b_R₂ 0 + a₀₁ • b_R₂ 1)
              = (d_inv * a₁₁ * a₀₀) • b_R₂ 0 + (d_inv * a₁₁ * a₀₁) • b_R₂ 1 := by
                simp only [smul_add, mul_smul]
            _ = (1 + d_inv * a₀₁ * a₁₀) • b_R₂ 0 + (d_inv * a₀₁ * a₁₁) • b_R₂ 1 := by
                rw [hr0, hr1]
            _ = b_R₂ 0 + (d_inv * a₀₁) • (a₁₀ • b_R₂ 0 + a₁₁ • b_R₂ 1) := by
                simp only [add_smul, one_smul, smul_add, mul_smul]
                abel
        have hb1_hit : ∃ u₁ : K_ker.Cotangent, κ u₁ = b_R₂ 1 := by
          refine ⟨(s_inv * s₀₀) • w₁ - (s_inv * s₁₀) • w₀, ?_⟩
          rw [map_sub, map_smul, map_smul, hS_smul, hS_smul, map_mul, map_mul,
            hs_inv, hs₀₀, hs₁₀, hκ_w₁, hκ_w₀, sub_eq_iff_eq_add]
          have hr0 : d_inv * a₀₀ * a₁₀ = d_inv * a₁₀ * a₀₀ := by ring
          have hr1 : d_inv * a₀₀ * a₁₁ = 1 + d_inv * a₁₀ * a₀₁ := by
            linear_combination hinv_mul_d
          calc (d_inv * a₀₀) • (a₁₀ • b_R₂ 0 + a₁₁ • b_R₂ 1)
              = (d_inv * a₀₀ * a₁₀) • b_R₂ 0 + (d_inv * a₀₀ * a₁₁) • b_R₂ 1 := by
                simp only [smul_add, mul_smul]
            _ = (d_inv * a₁₀ * a₀₀) • b_R₂ 0 + (1 + d_inv * a₁₀ * a₀₁) • b_R₂ 1 := by
                rw [hr0, hr1]
            _ = b_R₂ 1 + (d_inv * a₁₀) • (a₀₀ • b_R₂ 0 + a₀₁ • b_R₂ 1) := by
                simp only [add_smul, one_smul, smul_add, mul_smul]
                abel
        obtain ⟨u₀, hu₀⟩ := hb0_hit
        obtain ⟨u₁, hu₁⟩ := hb1_hit
        intro z
        have hz := (b_R₂.sum_repr z).symm
        rw [Fin.sum_univ_two] at hz
        obtain ⟨c₀, hc₀⟩ := hπS_surj (b_R₂.repr z 0)
        obtain ⟨c₁, hc₁⟩ := hπS_surj (b_R₂.repr z 1)
        refine ⟨c₀ • u₀ + c₁ • u₁, ?_⟩
        rw [map_add, map_smul, map_smul, hS_smul, hS_smul, hu₀, hu₁]
        change (algebraMap S R₂ c₀) • b_R₂ 0 + (algebraMap S R₂ c₁) • b_R₂ 1 = z
        rw [hc₀, hc₁, ← hz]
      have hSubH1 : Subsingleton (Algebra.H1Cotangent R₁ R₂) :=
        (Algebra.FormallySmooth.kerCotangentToTensor_injective_iff hπS_surj).mp hκ_inj
      have hSubΩ : Subsingleton Ω[R₂⁄R₁] := by
        refine Subsingleton.intro fun ω₁ ω₂ => ?_
        rw [← sub_eq_zero]
        obtain ⟨t, ht⟩ := KaehlerDifferential.mapBaseChange_surjective R₁ S R₂ hπS_surj (ω₁ - ω₂)
        obtain ⟨u, rfl⟩ := hκ_surj t
        rw [← ht]
        exact (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R₁ S R₂ hπS_surj
          (κ u)).mpr ⟨u, rfl⟩
      haveI : Algebra.FormallyEtale R₁ R₂ := (Algebra.formallyEtale_iff R₁ R₂).mpr ⟨hSubΩ, hSubH1⟩
      haveI : Algebra.Etale R₁ R₂ := {}
      exact RingHom.etale_algebraMap.mpr inferInstance
    refine ⟨R₂, inferInstance, eR₂, π_crit, p₂, heR₂, rfl, hp₂_Q, ?_, ?_⟩
    · rw [← hF₀_def]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inl rfl))
    · rw [← hF₁_def]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inr rfl))

  obtain ⟨R₂, instR₂, eR₂, π_crit, p₂, heR₂, hπ_comm, hπ_p₂, hF₀_crit, hF₁_crit⟩ := h_step1
  letI : CommRing R₂ := instR₂

  
  have h_step2 : ∃ (h : R₂) (B'₂ : Type u) (_ : CommRing B'₂)
      (τ₂ : MvPolynomial (Fin 2) R₂ →+* B'₂) (eB₂ : B →+* B'₂)
      (Q'₂ : PrimeSpectrum B'₂) (A₂₀ A₁₁ A₀₂ : B'₂),
      τ₂.Etale ∧
      eB₂.Etale ∧
      eB₂.comp (φ_P.comp MvPolynomial.C) = (τ₂.comp MvPolynomial.C).comp eR₂ ∧
      PrimeSpectrum.comap eB₂ Q'₂ = Q ∧
      (∀ i : Fin 2, τ₂ (MvPolynomial.X i) ∈ Q'₂.asIdeal) ∧
      τ₂ (MvPolynomial.C h) ∈ Q'₂.asIdeal ∧
      eB₂ g + τ₂ (MvPolynomial.C h) =
        A₂₀ * τ₂ (MvPolynomial.X 0) ^ 2 +
          A₁₁ * (τ₂ (MvPolynomial.X 0) * τ₂ (MvPolynomial.X 1)) +
          A₀₂ * τ₂ (MvPolynomial.X 1) ^ 2 ∧
      A₂₀ ∈ Q'₂.asIdeal ∧
      A₁₁ - 1 ∈ Q'₂.asIdeal ∧
      A₀₂ ∈ Q'₂.asIdeal := by
    let P₁ := MvPolynomial (Fin 2) R₁
    let P₂ := MvPolynomial (Fin 2) R₂
    have hmapP_et : (MvPolynomial.map eR₂ : P₁ →+* P₂).Etale := by
      letI : Algebra R₁ R₂ := eR₂.toAlgebra
      haveI : Algebra.Etale R₁ R₂ := RingHom.etale_algebraMap.mp heR₂
      haveI : Algebra.Etale P₁ (TensorProduct R₁ P₁ R₂) := Algebra.Etale.baseChange R₁ R₂ P₁
      have h_alg : (algebraMap P₁ (TensorProduct R₁ P₁ R₂)).Etale :=
        RingHom.etale_algebraMap.mpr inferInstance
      let e_iso : TensorProduct R₁ P₁ R₂ ≃+* P₂ :=
        (Algebra.TensorProduct.comm R₁ P₁ R₂).toRingEquiv.trans
          (MvPolynomial.algebraTensorAlgEquiv R₁ R₂).toRingEquiv
      have h_iso : e_iso.toRingHom.Etale := RingHom.Etale.of_bijective e_iso.bijective
      have h_eq : (MvPolynomial.map eR₂ : P₁ →+* P₂) =
          e_iso.toRingHom.comp (algebraMap P₁ (TensorProduct R₁ P₁ R₂)) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          symm
          change (MvPolynomial.algebraTensorAlgEquiv R₁ R₂) ((1 : R₂) ⊗ₜ[R₁] MvPolynomial.C r) =
            MvPolynomial.map eR₂ (MvPolynomial.C r)
          have htmul : (1 : R₂) ⊗ₜ[R₁] (MvPolynomial.C r : P₁) =
              (eR₂ r) ⊗ₜ[R₁] (1 : P₁) := by
            calc (1 : R₂) ⊗ₜ[R₁] (MvPolynomial.C r : P₁)
                = (1 : R₂) ⊗ₜ[R₁] (r • (1 : P₁)) := by rw [Algebra.smul_def, mul_one]; rfl
              _ = (r • (1 : R₂)) ⊗ₜ[R₁] (1 : P₁) := TensorProduct.tmul_smul r 1 1
              _ = (eR₂ r) ⊗ₜ[R₁] (1 : P₁) := by rw [Algebra.smul_def, mul_one]; rfl
          rw [htmul, MvPolynomial.map_C]
          exact (MvPolynomial.algebraTensorAlgEquiv R₁ R₂).commutes (eR₂ r)
        · intro i
          symm
          change (MvPolynomial.algebraTensorAlgEquiv R₁ R₂) ((1 : R₂) ⊗ₜ[R₁] MvPolynomial.X i) =
            MvPolynomial.map eR₂ (MvPolynomial.X i)
          simp only [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul, MvPolynomial.map_X]
      rw [h_eq]
      exact RingHom.Etale.stableUnderComposition _ _ h_alg h_iso
    let U : B := φ_P (MvPolynomial.X 0)
    let V : B := φ_P (MvPolynomial.X 1)
    let u₀ : R₂ := π_crit U
    let v₀ : R₂ := π_crit V
    let h : R₂ := -π_crit g
    have hu₀_p₂ : u₀ ∈ p₂.asIdeal := by
      have : U ∈ (PrimeSpectrum.comap π_crit p₂).asIdeal := by rw [hπ_p₂]; exact hXi 0
      exact this
    have hv₀_p₂ : v₀ ∈ p₂.asIdeal := by
      have : V ∈ (PrimeSpectrum.comap π_crit p₂).asIdeal := by rw [hπ_p₂]; exact hXi 1
      exact this
    have hh_p₂ : h ∈ p₂.asIdeal := by
      have : g ∈ (PrimeSpectrum.comap π_crit p₂).asIdeal := by rw [hπ_p₂]; exact hg_Q
      exact p₂.asIdeal.neg_mem this
    have h_B₂_pkg : ∃ (B₂ : Type u) (_ : CommRing B₂)
        (ψ₂ : P₂ →+* B₂) (incR : B →+* B₂) (σ_ring : B₂ →+* R₂),
        ψ₂.Etale ∧
        incR.Etale ∧
        (∀ i : Fin 2, ψ₂ (MvPolynomial.X i) = incR (φ_P (MvPolynomial.X i))) ∧
        (∀ r₁ : R₁, incR (φ_P (MvPolynomial.C r₁)) = ψ₂ (MvPolynomial.C (eR₂ r₁))) ∧
        (∀ p : P₂, σ_ring (ψ₂ p) = MvPolynomial.aeval ![u₀, v₀] p) ∧
        (∀ b : B, σ_ring (incR b) = π_crit b) := by
      letI : Algebra P₁ P₂ := (MvPolynomial.map eR₂).toAlgebra
      letI : Algebra P₁ B := φ_P.toAlgebra
      haveI : Algebra.Etale P₁ P₂ := RingHom.etale_algebraMap.mp hmapP_et
      haveI : Algebra.Etale P₁ B := RingHom.etale_algebraMap.mp hEtP
      let B₂_tp : Type u := TensorProduct P₁ P₂ B
      haveI : Algebra.Etale P₂ B₂_tp := Algebra.Etale.baseChange P₁ B P₂
      have hψ_et : (algebraMap P₂ B₂_tp).Etale := RingHom.etale_algebraMap.mpr inferInstance
      let incR : B →+* B₂_tp := Algebra.TensorProduct.includeRight.toRingHom
      have hincR_et : incR.Etale := by
        haveI : Algebra.Etale B (TensorProduct P₁ B P₂) := Algebra.Etale.baseChange P₁ P₂ B
        have h_alg : (algebraMap B (TensorProduct P₁ B P₂)).Etale :=
          RingHom.etale_algebraMap.mpr inferInstance
        let e_comm : TensorProduct P₁ B P₂ ≃+* B₂_tp :=
          (Algebra.TensorProduct.comm P₁ B P₂).toRingEquiv
        have h_iso : e_comm.toRingHom.Etale := RingHom.Etale.of_bijective e_comm.bijective
        have h_eq : incR = e_comm.toRingHom.comp (algebraMap B (TensorProduct P₁ B P₂)) := by
          ext b; rfl
        rw [h_eq]
        exact RingHom.Etale.stableUnderComposition _ _ h_alg h_iso
      have hψ_X : ∀ i : Fin 2,
          (algebraMap P₂ B₂_tp) (MvPolynomial.X i) = incR (φ_P (MvPolynomial.X i)) := by
        intro i
        rw [← MvPolynomial.map_X eR₂ i]
        exact Algebra.TensorProduct.tmul_one_eq_one_tmul (MvPolynomial.X i)
      have hψ_C_eR₂ : ∀ r₁ : R₁,
          incR (φ_P (MvPolynomial.C r₁)) = (algebraMap P₂ B₂_tp) (MvPolynomial.C (eR₂ r₁)) := by
        intro r₁
        rw [← MvPolynomial.map_C eR₂ r₁]
        exact (Algebra.TensorProduct.tmul_one_eq_one_tmul (MvPolynomial.C r₁)).symm
      let ev_uv : P₂ →+* R₂ := (MvPolynomial.aeval ![u₀, v₀]).toRingHom
      letI : Algebra P₁ R₂ := (π_crit.comp φ_P).toAlgebra
      have hev_comm : ∀ q : P₁, ev_uv (algebraMap P₁ P₂ q) = algebraMap P₁ R₂ q := by
        have heq : ev_uv.comp (MvPolynomial.map eR₂) = π_crit.comp φ_P := by
          apply MvPolynomial.ringHom_ext
          · intro r
            change MvPolynomial.aeval ![u₀, v₀] (MvPolynomial.map eR₂ (MvPolynomial.C r)) =
              π_crit (φ_P (MvPolynomial.C r))
            rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
            exact (RingHom.congr_fun hπ_comm r).symm
          · intro i
            change MvPolynomial.aeval ![u₀, v₀] (MvPolynomial.map eR₂ (MvPolynomial.X i)) =
              π_crit (φ_P (MvPolynomial.X i))
            rw [MvPolynomial.map_X, MvPolynomial.aeval_X]
            fin_cases i
            · rfl
            · rfl
        exact fun q => RingHom.congr_fun heq q
      let ev_alg : P₂ →ₐ[P₁] R₂ := { toRingHom := ev_uv, commutes' := hev_comm }
      let π_P₁ : B →ₐ[P₁] R₂ := { toRingHom := π_crit, commutes' := fun _ => rfl }
      let σ_P₁ : B₂_tp →ₐ[P₁] R₂ := Algebra.TensorProduct.productMap ev_alg π_P₁
      refine ⟨B₂_tp, inferInstance, algebraMap P₂ B₂_tp, incR, σ_P₁.toRingHom,
        hψ_et, hincR_et, hψ_X, hψ_C_eR₂, ?_, ?_⟩
      · intro p
        exact AlgHom.congr_fun (Algebra.TensorProduct.productMap_left ev_alg π_P₁) p
      · intro b
        exact AlgHom.congr_fun (Algebra.TensorProduct.productMap_right ev_alg π_P₁) b
    obtain ⟨B₂, instB₂, ψ₂, incR, σ_ring, hψ_et, hincR_et, hψ_X, hψ_C_eR₂, hσ_P₂, hσ_inc⟩ :=
      h_B₂_pkg
    letI : CommRing B₂ := instB₂
    
    let shiftMinusHom : P₂ →ₐ[R₂] P₂ :=
      MvPolynomial.aeval ![MvPolynomial.X 0 - MvPolynomial.C u₀,
        MvPolynomial.X 1 - MvPolynomial.C v₀]
    let shiftPlusHom : P₂ →ₐ[R₂] P₂ :=
      MvPolynomial.aeval ![MvPolynomial.X 0 + MvPolynomial.C u₀,
        MvPolynomial.X 1 + MvPolynomial.C v₀]
    have h_shift_bij : Function.Bijective shiftMinusHom.toRingHom := by
      have h1 : shiftPlusHom.comp shiftMinusHom = AlgHom.id R₂ P₂ := by
        apply MvPolynomial.algHom_ext
        rw [Fin.forall_fin_two]
        constructor
        · change shiftPlusHom (shiftMinusHom (MvPolynomial.X 0)) = MvPolynomial.X 0
          dsimp only [shiftMinusHom, shiftPlusHom]
          rw [MvPolynomial.aeval_X, Matrix.cons_val_zero, map_sub,
            MvPolynomial.aeval_X, Matrix.cons_val_zero,
            MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          ring
        · change shiftPlusHom (shiftMinusHom (MvPolynomial.X 1)) = MvPolynomial.X 1
          dsimp only [shiftMinusHom, shiftPlusHom]
          rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero, map_sub,
            MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero,
            MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          ring
      have h2 : shiftMinusHom.comp shiftPlusHom = AlgHom.id R₂ P₂ := by
        apply MvPolynomial.algHom_ext
        rw [Fin.forall_fin_two]
        constructor
        · change shiftMinusHom (shiftPlusHom (MvPolynomial.X 0)) = MvPolynomial.X 0
          dsimp only [shiftMinusHom, shiftPlusHom]
          rw [MvPolynomial.aeval_X, Matrix.cons_val_zero, map_add,
            MvPolynomial.aeval_X, Matrix.cons_val_zero,
            MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          ring
        · change shiftMinusHom (shiftPlusHom (MvPolynomial.X 1)) = MvPolynomial.X 1
          dsimp only [shiftMinusHom, shiftPlusHom]
          rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero, map_add,
            MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero,
            MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          ring
      exact ⟨Function.LeftInverse.injective (fun x => by simpa using AlgHom.congr_fun h1 x),
        Function.RightInverse.surjective (fun x => by simpa using AlgHom.congr_fun h2 x)⟩
    let τ_raw : P₂ →+* B₂ := ψ₂.comp shiftMinusHom.toRingHom
    have hτ_raw_et : τ_raw.Etale :=
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective h_shift_bij) hψ_et
    have hτ_raw_C : ∀ r₂ : R₂, τ_raw (MvPolynomial.C r₂) = ψ₂ (MvPolynomial.C r₂) := by
      intro r₂
      dsimp [τ_raw, shiftMinusHom]
      rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    have hτ_raw_X0 : τ_raw (MvPolynomial.X 0) =
        incR U - ψ₂ (MvPolynomial.C u₀) := by
      dsimp [τ_raw, shiftMinusHom]
      rw [MvPolynomial.aeval_X, Matrix.cons_val_zero, map_sub, hψ_X 0]
    have hτ_raw_X1 : τ_raw (MvPolynomial.X 1) =
        incR V - ψ₂ (MvPolynomial.C v₀) := by
      dsimp [τ_raw, shiftMinusHom]
      rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero, map_sub, hψ_X 1]
    have hσ_C : ∀ r₂ : R₂, σ_ring (τ_raw (MvPolynomial.C r₂)) = r₂ := by
      intro r₂; rw [hτ_raw_C, hσ_P₂]; simp
    have hσ_X : ∀ i : Fin 2, σ_ring (τ_raw (MvPolynomial.X i)) = 0 := by
      intro i; fin_cases i
      · change σ_ring (τ_raw (MvPolynomial.X 0)) = 0
        rw [hτ_raw_X0, map_sub, hσ_inc, hσ_P₂]; simp [u₀]
      · change σ_ring (τ_raw (MvPolynomial.X 1)) = 0
        rw [hτ_raw_X1, map_sub, hσ_inc, hσ_P₂]; simp [v₀]
    
    let I_X : Ideal P₂ := Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
    let J_shift : Ideal B₂ := Ideal.span {τ_raw (MvPolynomial.X 0), τ_raw (MvPolynomial.X 1)}
    have hJ_map : J_shift = Ideal.map τ_raw I_X := by
      dsimp [J_shift, I_X]
      rw [Ideal.map_span, Set.image_pair]
    let E₀ : Type u := B₂ ⧸ J_shift
    let π_J : B₂ →+* E₀ := Ideal.Quotient.mk J_shift
    let r₂ToE₀ : R₂ →+* E₀ := π_J.comp (τ_raw.comp MvPolynomial.C)
    have hr₂ToE₀_et : r₂ToE₀.Etale := by
      let ev₀ : P₂ →ₐ[R₂] R₂ := MvPolynomial.aeval 0
      letI : Algebra P₂ R₂ := ev₀.toRingHom.toAlgebra
      letI : Algebra P₂ B₂ := τ_raw.toAlgebra
      haveI : Algebra.Etale P₂ B₂ := RingHom.etale_algebraMap.mp hτ_raw_et
      haveI : Algebra.Etale R₂ (TensorProduct P₂ R₂ B₂) :=
        Algebra.Etale.baseChange P₂ B₂ R₂
      have h_bc : (algebraMap R₂ (TensorProduct P₂ R₂ B₂)).Etale :=
        RingHom.etale_algebraMap.mpr inferInstance
      have h_mod : ∀ q : P₂, q - MvPolynomial.C (ev₀ q) ∈ I_X := by
        intro q
        refine MvPolynomial.induction_on (motive := fun q => q - MvPolynomial.C (ev₀ q) ∈ I_X)
          q ?_ ?_ ?_
        · intro r
          have hr : ev₀ (MvPolynomial.C r) = r := ev₀.commutes r
          rw [hr, sub_self]
          exact I_X.zero_mem
        · intro f₁ f₂ hf₁ hf₂
          have : (f₁ + f₂) - MvPolynomial.C (ev₀ (f₁ + f₂)) =
              (f₁ - MvPolynomial.C (ev₀ f₁)) + (f₂ - MvPolynomial.C (ev₀ f₂)) := by
            simp [map_add]; ring
          rw [this]; exact I_X.add_mem hf₁ hf₂
        · intro f₁ i _
          have hx : (MvPolynomial.X i : P₂) ∈ I_X := by
            fin_cases i
            · exact Ideal.subset_span (Or.inl rfl)
            · exact Ideal.subset_span (Or.inr rfl)
          have hev : ev₀ (f₁ * MvPolynomial.X i) = 0 := by
            rw [map_mul]
            have hXi0 : ev₀ (MvPolynomial.X i) = 0 := by
              dsimp [ev₀]
              rw [MvPolynomial.aeval_X]; rfl
            rw [hXi0, mul_zero]
          rw [hev, map_zero, sub_zero]
          exact I_X.mul_mem_left f₁ hx
      letI : Algebra P₂ E₀ := (π_J.comp τ_raw).toAlgebra
      have hr₂_comm : ∀ q : P₂, r₂ToE₀ (algebraMap P₂ R₂ q) = algebraMap P₂ E₀ q := by
        intro q
        change π_J (τ_raw (MvPolynomial.C (ev₀ q))) = π_J (τ_raw q)
        symm
        rw [← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, hJ_map]
        exact Ideal.mem_map_of_mem τ_raw (h_mod q)
      let r₂_alg : R₂ →ₐ[P₂] E₀ := { toRingHom := r₂ToE₀, commutes' := hr₂_comm }
      let b₂_alg : B₂ →ₐ[P₂] E₀ := { toRingHom := π_J, commutes' := fun _ => rfl }
      let f_alg : TensorProduct P₂ R₂ B₂ →ₐ[P₂] E₀ :=
        Algebra.TensorProduct.productMap r₂_alg b₂_alg
      let f_TP : @RingHom (TensorProduct P₂ R₂ B₂) E₀
          CommRing.toCommSemiring.toNonAssocSemiring
          CommRing.toCommSemiring.toNonAssocSemiring :=
        { toFun := fun t => f_alg t
          map_one' := f_alg.map_one
          map_mul' := f_alg.map_mul
          map_zero' := f_alg.map_zero
          map_add' := f_alg.map_add }
      let incR_alg : B₂ →ₐ[P₂] TensorProduct P₂ R₂ B₂ := Algebra.TensorProduct.includeRight
      let incR_TP : @RingHom B₂ (TensorProduct P₂ R₂ B₂)
          CommRing.toCommSemiring.toNonAssocSemiring
          CommRing.toCommSemiring.toNonAssocSemiring :=
        { toFun := fun b => incR_alg b
          map_one' := incR_alg.map_one
          map_mul' := incR_alg.map_mul
          map_zero' := incR_alg.map_zero
          map_add' := incR_alg.map_add }
      have hJ_TP : ∀ z ∈ J_shift, incR_TP z = 0 := by
        have hle : J_shift ≤ RingHom.ker incR_TP := by
          rw [Ideal.span_le]
          rintro _ (rfl | rfl)
          · change (1 : R₂) ⊗ₜ[P₂] (algebraMap P₂ B₂ (MvPolynomial.X 0)) = 0
            rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul (MvPolynomial.X 0)]
            have h0 : algebraMap P₂ R₂ (MvPolynomial.X 0) = 0 := by
              change (MvPolynomial.aeval 0) (MvPolynomial.X 0) = 0
              rw [MvPolynomial.aeval_X]; rfl
            rw [h0, TensorProduct.zero_tmul]
          · change (1 : R₂) ⊗ₜ[P₂] (algebraMap P₂ B₂ (MvPolynomial.X 1)) = 0
            rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul (MvPolynomial.X 1)]
            have h1 : algebraMap P₂ R₂ (MvPolynomial.X 1) = 0 := by
              change (MvPolynomial.aeval 0) (MvPolynomial.X 1) = 0
              rw [MvPolynomial.aeval_X]; rfl
            rw [h1, TensorProduct.zero_tmul]
        exact fun z hz => hle hz
      let g_TP : E₀ →+* TensorProduct P₂ R₂ B₂ :=
        Ideal.Quotient.lift J_shift incR_TP hJ_TP
      have h_fg : ∀ z : E₀, f_TP (g_TP z) = z := by
        intro z
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
        change f_alg (g_TP (Ideal.Quotient.mk J_shift b)) = π_J b
        rw [Ideal.Quotient.lift_mk]
        exact AlgHom.congr_fun (Algebra.TensorProduct.productMap_right r₂_alg b₂_alg) b
      have h_gf : ∀ t : TensorProduct P₂ R₂ B₂, g_TP (f_TP t) = t := by
        intro t
        let P_mot : TensorProduct P₂ R₂ B₂ → Prop := fun z => g_TP (f_TP z) = z
        change P_mot t
        refine TensorProduct.induction_on t ?_ ?_ ?_
        · dsimp only [P_mot]
          rw [map_zero, map_zero]
        · intro r b
          dsimp only [P_mot]
          have hsplit : (r ⊗ₜ[P₂] b : TensorProduct P₂ R₂ B₂) =
              algebraMap R₂ (TensorProduct P₂ R₂ B₂) r * incR_TP b := by
            change r ⊗ₜ[P₂] b = (r ⊗ₜ[P₂] (1 : B₂)) * ((1 : R₂) ⊗ₜ[P₂] b)
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hsplit, map_mul, map_mul]
          have hf_l : f_TP (algebraMap R₂ (TensorProduct P₂ R₂ B₂) r) = r₂ToE₀ r :=
            AlgHom.congr_fun (Algebra.TensorProduct.productMap_left r₂_alg b₂_alg) r
          have hf_r : f_TP (incR_TP b) = π_J b :=
            AlgHom.congr_fun (Algebra.TensorProduct.productMap_right r₂_alg b₂_alg) b
          rw [hf_l, hf_r]
          change g_TP (Ideal.Quotient.mk J_shift (τ_raw (MvPolynomial.C r))) *
              g_TP (Ideal.Quotient.mk J_shift b) = _
          rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
          have hg_l : incR_TP (τ_raw (MvPolynomial.C r)) =
              algebraMap R₂ (TensorProduct P₂ R₂ B₂) r := by
            change (1 : R₂) ⊗ₜ[P₂] algebraMap P₂ B₂ (MvPolynomial.C r) = r ⊗ₜ[P₂] (1 : B₂)
            rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul (MvPolynomial.C r)]
            have hr : algebraMap P₂ R₂ (MvPolynomial.C r) = r := ev₀.commutes r
            rw [hr]
          rw [hg_l]
        · intro x y hx hy
          dsimp only [P_mot] at hx hy ⊢
          rw [map_add, map_add, hx, hy]
      have hf_TP_bij : Function.Bijective f_TP :=
        ⟨Function.LeftInverse.injective h_gf, Function.RightInverse.surjective h_fg⟩
      have h_eq : r₂ToE₀ = f_TP.comp (algebraMap R₂ (TensorProduct P₂ R₂ B₂)) := by
        ext r
        exact (AlgHom.congr_fun (Algebra.TensorProduct.productMap_left r₂_alg b₂_alg) r).symm
      rw [h_eq]
      exact RingHom.Etale.stableUnderComposition _ _ h_bc (RingHom.Etale.of_bijective hf_TP_bij)
    
    have hJ_ker : ∀ z ∈ J_shift, σ_ring z = 0 := by
      have hle : J_shift ≤ RingHom.ker σ_ring := by
        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · exact hσ_X 0
        · exact hσ_X 1
      exact fun z hz => hle hz
    let σ_bar_ring : E₀ →+* R₂ := Ideal.Quotient.lift J_shift σ_ring hJ_ker
    letI : Algebra R₂ E₀ := r₂ToE₀.toAlgebra
    haveI : Algebra.Etale R₂ E₀ := RingHom.etale_algebraMap.mp hr₂ToE₀_et
    let σ_bar : E₀ →ₐ[R₂] R₂ :=
      { toRingHom := σ_bar_ring
        commutes' := fun r => hσ_C r }
    let K₀ : Ideal E₀ := RingHom.ker σ_bar.toRingHom
    have hK₀_idem : IsIdempotentElem K₀ := by
      change K₀ * K₀ = K₀
      rw [← pow_two]
      apply le_antisymm (Ideal.pow_le_self (by norm_num))
      let q_K2 : E₀ →ₐ[R₂] E₀ ⧸ (K₀ ^ 2) := Ideal.Quotient.mkₐ R₂ (K₀ ^ 2)
      let J_bar : Ideal (E₀ ⧸ (K₀ ^ 2)) := Ideal.map q_K2.toRingHom K₀
      have hJ_bar_sq : J_bar ^ 2 = ⊥ := by
        dsimp [J_bar]
        rw [← Ideal.map_pow]
        exact Ideal.map_quotient_self (K₀ ^ 2)
      let f₁_map : E₀ →ₐ[R₂] E₀ ⧸ (K₀ ^ 2) := q_K2
      let f₂_map : E₀ →ₐ[R₂] E₀ ⧸ (K₀ ^ 2) :=
        (Algebra.ofId R₂ (E₀ ⧸ (K₀ ^ 2))).comp σ_bar
      have hf_eq : f₁_map = f₂_map := by
        apply (Algebra.FormallyEtale.comp_bijective R₂ E₀ J_bar hJ_bar_sq).1
        ext x
        change Ideal.Quotient.mk J_bar (q_K2 x) =
          Ideal.Quotient.mk J_bar (q_K2 (algebraMap R₂ E₀ (σ_bar x)))
        rw [← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        refine Ideal.mem_map_of_mem q_K2.toRingHom ?_
        change σ_bar (x - algebraMap R₂ E₀ (σ_bar x)) = 0
        rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      intro x hx
      have hx0 : σ_bar x = 0 := hx
      have hfx : q_K2 x = 0 := by
        change f₁_map x = 0
        rw [hf_eq]
        simp [f₂_map, hx0]
      exact Ideal.Quotient.eq_zero_iff_mem.mp hfx
    have hK₀_fg : K₀.FG := by
      haveI : Algebra.FiniteType R₂ E₀ := inferInstance
      obtain ⟨s, hs⟩ := ‹Algebra.FiniteType R₂ E₀›
      let I_s : Ideal E₀ := Ideal.span ((fun y : E₀ => y - algebraMap R₂ E₀ (σ_bar y)) '' (s : Set E₀))
      have hK₀_eq : K₀ = I_s := by
        apply le_antisymm
        · let A_sub : Subalgebra R₂ E₀ :=
            { carrier := {x : E₀ | x - algebraMap R₂ E₀ (σ_bar x) ∈ I_s}
              mul_mem' := by
                intro x y hx hy
                change x * y - algebraMap R₂ E₀ (σ_bar (x * y)) ∈ I_s
                rw [map_mul, map_mul]
                have h_id : x * y - algebraMap R₂ E₀ (σ_bar x) * algebraMap R₂ E₀ (σ_bar y) =
                    x * (y - algebraMap R₂ E₀ (σ_bar y)) +
                      (x - algebraMap R₂ E₀ (σ_bar x)) * algebraMap R₂ E₀ (σ_bar y) := by ring
                rw [h_id]
                exact I_s.add_mem (I_s.mul_mem_left x hy)
                  (I_s.mul_mem_right (algebraMap R₂ E₀ (σ_bar y)) hx)
              one_mem' := by simp [I_s.zero_mem]
              add_mem' := by
                intro x y hx hy
                change (x + y) - algebraMap R₂ E₀ (σ_bar (x + y)) ∈ I_s
                have h_id : (x + y) - algebraMap R₂ E₀ (σ_bar (x + y)) =
                    (x - algebraMap R₂ E₀ (σ_bar x)) + (y - algebraMap R₂ E₀ (σ_bar y)) := by
                  simp [map_add]; ring
                rw [h_id]; exact I_s.add_mem hx hy
              zero_mem' := by simp [I_s.zero_mem]
              algebraMap_mem' := fun r => by simp [I_s.zero_mem] }
          have htop : (⊤ : Subalgebra R₂ E₀) ≤ A_sub := by
            rw [← hs, Algebra.adjoin_le_iff]
            intro y hy
            exact Ideal.subset_span ⟨y, hy, rfl⟩
          intro x hx
          have hx_mem : x ∈ A_sub := htop trivial
          change x - algebraMap R₂ E₀ (σ_bar x) ∈ I_s at hx_mem
          have hx0 : σ_bar x = 0 := hx
          rwa [hx0, map_zero, sub_zero] at hx_mem
        · rw [Ideal.span_le]
          rintro _ ⟨y, _, rfl⟩
          change σ_bar (y - algebraMap R₂ E₀ (σ_bar y)) = 0
          rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      rw [hK₀_eq]
      exact Submodule.fg_span (s.finite_toSet.image _)
    obtain ⟨e, he_idem, hK₀_span⟩ := (Ideal.isIdempotentElem_iff_of_fg K₀ hK₀_fg).mp hK₀_idem
    obtain ⟨e₀, he₀⟩ := Ideal.Quotient.mk_surjective (I := J_shift) e
    have hσ_e₀ : σ_ring e₀ = 0 := by
      have he_mem : e ∈ K₀ := by rw [hK₀_span]; exact Ideal.mem_span_singleton_self e
      have hbar : σ_bar_ring (π_J e₀) = 0 := by rw [he₀]; exact he_mem
      rw [← Ideal.Quotient.lift_mk J_shift σ_ring hJ_ker]
      exact hbar
    obtain ⟨f₁, hf₁_def⟩ : ∃ x : B₂, x = 1 - e₀ := ⟨1 - e₀, rfl⟩
    have hσ_f₁ : σ_ring f₁ = 1 := by rw [hf₁_def, map_sub, map_one, hσ_e₀, sub_zero]
    have hf₁_kill : ∀ b : B₂, σ_ring b = 0 → f₁ * b ∈ J_shift := by
      intro b hb
      have hb_K₀ : π_J b ∈ K₀ := hb
      rw [hK₀_span, Ideal.mem_span_singleton] at hb_K₀
      obtain ⟨q, hq⟩ := hb_K₀
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hf₁_def]
      change π_J (1 - e₀) * π_J b = 0
      rw [map_sub, map_one, he₀, hq]
      have hee : e * e = e := he_idem
      calc (1 - e) * (e * q) = (e - e * e) * q := by ring
        _ = 0 := by rw [hee, sub_self, zero_mul]
    
    let B'₂ : Type u := Localization.Away f₁
    let loc₁ : B₂ →+* B'₂ := algebraMap B₂ B'₂
    haveI : Algebra.Etale B₂ B'₂ := Algebra.Etale.of_isLocalizationAway f₁
    have hloc₁_et : loc₁.Etale := RingHom.etale_algebraMap.mpr inferInstance
    let τ₂ : P₂ →+* B'₂ := loc₁.comp τ_raw
    let eB₂ : B →+* B'₂ := loc₁.comp incR
    have hτ₂_et : τ₂.Etale := RingHom.Etale.stableUnderComposition _ _ hτ_raw_et hloc₁_et
    have heB₂_et : eB₂.Etale := RingHom.Etale.stableUnderComposition _ _ hincR_et hloc₁_et
    have hf₁_unit_R₂ : IsUnit (σ_ring f₁) := by rw [hσ_f₁]; exact isUnit_one
    let σ'_crit : B'₂ →+* R₂ := IsLocalization.Away.lift f₁ hf₁_unit_R₂
    have hσ'_loc₁ : ∀ b : B₂, σ'_crit (loc₁ b) = σ_ring b :=
      fun b => IsLocalization.Away.lift_eq f₁ hf₁_unit_R₂ b
    let Q'₂ : PrimeSpectrum B'₂ := PrimeSpectrum.comap σ'_crit p₂
    have hQ'₂_Q : PrimeSpectrum.comap eB₂ Q'₂ = Q := by
      have hcomp : σ'_crit.comp eB₂ = π_crit := by
        ext x; change σ'_crit (loc₁ (incR x)) = _; rw [hσ'_loc₁, hσ_inc]
      rw [← PrimeSpectrum.comap_comp_apply, hcomp, hπ_p₂]
    have hcomm₂ : eB₂.comp (φ_P.comp MvPolynomial.C) = (τ₂.comp MvPolynomial.C).comp eR₂ := by
      ext r₁
      dsimp [eB₂, τ₂]
      rw [hψ_C_eR₂ r₁, hτ_raw_C]
    have hσ'_C : ∀ r₂ : R₂, σ'_crit (τ₂ (MvPolynomial.C r₂)) = r₂ := by
      intro r₂; dsimp [τ₂]; rw [hσ'_loc₁, hσ_C]
    have hσ'_X : ∀ i : Fin 2, σ'_crit (τ₂ (MvPolynomial.X i)) = 0 := by
      intro i; dsimp [τ₂]; rw [hσ'_loc₁, hσ_X]
    have hXi_Q'₂ : ∀ i : Fin 2, τ₂ (MvPolynomial.X i) ∈ Q'₂.asIdeal := by
      intro i
      change σ'_crit (τ₂ (MvPolynomial.X i)) ∈ p₂.asIdeal
      rw [hσ'_X]; exact p₂.asIdeal.zero_mem
    have hh_Q'₂ : τ₂ (MvPolynomial.C h) ∈ Q'₂.asIdeal := by
      change σ'_crit (τ₂ (MvPolynomial.C h)) ∈ p₂.asIdeal
      rw [hσ'_C]; exact hh_p₂
    have hker_σ' : RingHom.ker σ'_crit =
        Ideal.span {τ₂ (MvPolynomial.X 0), τ₂ (MvPolynomial.X 1)} := by
      apply le_antisymm
      · intro w hw
        have hw0 : σ'_crit w = 0 := hw
        obtain ⟨n, b, hwn⟩ := IsLocalization.Away.surj f₁ w
        have hb0 : σ_ring b = 0 := by
          have := congr_arg σ'_crit hwn
          rw [map_mul, map_pow, hσ'_loc₁, hσ'_loc₁, hσ_f₁, hw0, zero_mul] at this
          exact this.symm
        have hfb : f₁ * b ∈ J_shift := hf₁_kill b hb0
        rw [Ideal.mem_span_pair] at hfb
        obtain ⟨q₀, q₁, hfb_eq⟩ := hfb
        obtain ⟨u_f, hu_f⟩ := IsLocalization.Away.algebraMap_isUnit (S := B'₂) f₁
        change (↑u_f : B'₂) = loc₁ f₁ at hu_f
        have h_inv : (↑u_f : B'₂) * ↑(u_f⁻¹) = 1 := Units.mul_inv u_f
        have hw_eq : w = (↑(u_f⁻¹) ^ (n + 1) * loc₁ q₀) * τ₂ (MvPolynomial.X 0) +
            (↑(u_f⁻¹) ^ (n + 1) * loc₁ q₁) * τ₂ (MvPolynomial.X 1) := by
          have h1 : w * loc₁ f₁ ^ (n + 1) = loc₁ (f₁ * b) := by
            rw [pow_succ, ← mul_assoc, hwn, map_mul, mul_comm (loc₁ b)]
          have h2 : loc₁ (f₁ * b) =
              loc₁ q₀ * τ₂ (MvPolynomial.X 0) + loc₁ q₁ * τ₂ (MvPolynomial.X 1) := by
            rw [← hfb_eq, map_add, map_mul, map_mul]; rfl
          have h3 : (↑u_f : B'₂) ^ (n + 1) * ↑(u_f⁻¹) ^ (n + 1) = 1 := by
            rw [← mul_pow, h_inv, one_pow]
          calc w = w * ((↑u_f : B'₂) ^ (n + 1) * ↑(u_f⁻¹) ^ (n + 1)) := by rw [h3, mul_one]
            _ = (w * loc₁ f₁ ^ (n + 1)) * ↑(u_f⁻¹) ^ (n + 1) := by rw [hu_f, mul_assoc]
            _ = (loc₁ q₀ * τ₂ (MvPolynomial.X 0) + loc₁ q₁ * τ₂ (MvPolynomial.X 1)) *
                  ↑(u_f⁻¹) ^ (n + 1) := by rw [h1, h2]
            _ = _ := by ring
        rw [Ideal.mem_span_pair]
        exact ⟨_, _, hw_eq.symm⟩
      · rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · exact hσ'_X 0
        · exact hσ'_X 1
    
    letI : Algebra R₂ B'₂ := (τ₂.comp MvPolynomial.C).toAlgebra
    obtain ⟨_, der2, _, hder2, _⟩ := h_dual_basis τ₂ rfl hτ₂_et
    have heB₂_U : eB₂ U = τ₂ (MvPolynomial.X 0) + τ₂ (MvPolynomial.C u₀) := by
      dsimp [eB₂, τ₂]; rw [hτ_raw_X0, map_sub, ← hτ_raw_C, sub_add_cancel]
    have heB₂_V : eB₂ V = τ₂ (MvPolynomial.X 1) + τ₂ (MvPolynomial.C v₀) := by
      dsimp [eB₂, τ₂]; rw [hτ_raw_X1, map_sub, ← hτ_raw_C, sub_add_cancel]
    have hder2_eB₂ : ∀ (i : Fin 2) (x : B), der2 i (eB₂ x) = eB₂ (der_B i x) := by
      intro i x
      letI : Algebra B B'₂ := eB₂.toAlgebra
      letI : Algebra R₁ B'₂ := (eB₂.comp (φ_P.comp MvPolynomial.C)).toAlgebra
      haveI : IsScalarTower R₁ B B'₂ := IsScalarTower.of_algebraMap_eq' rfl
      let D_comp : Derivation R₁ B B'₂ :=
        { toFun := fun y => der2 i (eB₂ y)
          map_add' := fun y₁ y₂ => by rw [map_add, map_add]
          map_smul' := fun r₁ y => by
            change der2 i (eB₂ (φ_P (MvPolynomial.C r₁) * y)) =
              eB₂ (φ_P (MvPolynomial.C r₁)) * der2 i (eB₂ y)
            have hr : eB₂ (φ_P (MvPolynomial.C r₁)) = algebraMap R₂ B'₂ (eR₂ r₁) :=
              RingHom.congr_fun hcomm₂ r₁
            rw [map_mul, hr]
            exact (der2 i).map_smul (eR₂ r₁) (eB₂ y)
          map_one_eq_zero' := by
            change der2 i (eB₂ 1) = 0
            rw [eB₂.map_one, Derivation.map_one_eq_zero]
          leibniz' := fun y₁ y₂ => by
            change der2 i (eB₂ (y₁ * y₂)) = eB₂ y₁ * der2 i (eB₂ y₂) + eB₂ y₂ * der2 i (eB₂ y₁)
            rw [map_mul, Derivation.leibniz]; rfl }
      have hD_lift := D_comp.liftKaehlerDifferential_comp_D x
      change D_comp x = eB₂ (der_B i x)
      rw [← hD_lift, hD_B x, ← hder₀_def, ← hder₁_def, map_add, map_smul, map_smul,
        hb_B 0, hb_B 1,
        D_comp.liftKaehlerDifferential_comp_D, D_comp.liftKaehlerDifferential_comp_D]
      have hDU : D_comp U = if (0 : Fin 2) = i then 1 else 0 := by
        change der2 i (eB₂ U) = _
        rw [heB₂_U, map_add]
        have hC : der2 i (τ₂ (MvPolynomial.C u₀)) = 0 :=
          (der2 i).map_algebraMap u₀
        rw [hC, add_zero, hder2 i 0]
      have hDV : D_comp V = if (1 : Fin 2) = i then 1 else 0 := by
        change der2 i (eB₂ V) = _
        rw [heB₂_V, map_add]
        have hC : der2 i (τ₂ (MvPolynomial.C v₀)) = 0 :=
          (der2 i).map_algebraMap v₀
        rw [hC, add_zero, hder2 i 1]
      change der₀ x • D_comp U + der₁ x • D_comp V = eB₂ (der_B i x)
      rw [hDU, hDV]
      fin_cases i
      · simp [hder₀_def, Algebra.smul_def]; rfl
      · simp [hder₁_def, Algebra.smul_def]; rfl
    have hg_plus_h_ker : eB₂ g + τ₂ (MvPolynomial.C h) ∈ RingHom.ker σ'_crit := by
      change σ'_crit (eB₂ g + τ₂ (MvPolynomial.C h)) = 0
      rw [map_add, hσ'_C]
      have h1 : σ'_crit (eB₂ g) = π_crit g := by dsimp [eB₂]; rw [hσ'_loc₁, hσ_inc]
      rw [h1]; dsimp [h]; ring
    rw [hker_σ', Ideal.mem_span_pair] at hg_plus_h_ker
    obtain ⟨c₀, c₁, hc_lin⟩ := hg_plus_h_ker
    have hc₀_ker : c₀ ∈ RingHom.ker σ'_crit := by
      have hdiff := congr_arg (fun z => σ'_crit (der2 0 z)) hc_lin
      have hL : σ'_crit (der2 0 (eB₂ g + τ₂ (MvPolynomial.C h))) = 0 := by
        have halg_h : τ₂ (MvPolynomial.C h) = algebraMap R₂ B'₂ h := rfl
        rw [map_add, hder2_eB₂ 0 g, halg_h, (der2 0).map_algebraMap h, add_zero]
        dsimp [eB₂]; rw [hσ'_loc₁, hσ_inc, ← hder₀_def]; exact hF₀_crit
      have hR : σ'_crit (der2 0 (c₀ * τ₂ (MvPolynomial.X 0) + c₁ * τ₂ (MvPolynomial.X 1))) =
          σ'_crit c₀ := by
        rw [map_add, Derivation.leibniz, Derivation.leibniz]
        change σ'_crit ((c₀ * der2 0 (τ₂ (MvPolynomial.X 0)) + τ₂ (MvPolynomial.X 0) * der2 0 c₀) +
          (c₁ * der2 0 (τ₂ (MvPolynomial.X 1)) + τ₂ (MvPolynomial.X 1) * der2 0 c₁)) = _
        rw [hder2 0 0, hder2 0 1]
        simp [hσ'_X 0, hσ'_X 1]
      rw [hL, hR] at hdiff
      change σ'_crit c₀ = 0
      exact hdiff
    have hc₁_ker : c₁ ∈ RingHom.ker σ'_crit := by
      have hdiff := congr_arg (fun z => σ'_crit (der2 1 z)) hc_lin
      have hL : σ'_crit (der2 1 (eB₂ g + τ₂ (MvPolynomial.C h))) = 0 := by
        have halg_h : τ₂ (MvPolynomial.C h) = algebraMap R₂ B'₂ h := rfl
        rw [map_add, hder2_eB₂ 1 g, halg_h, (der2 1).map_algebraMap h, add_zero]
        dsimp [eB₂]; rw [hσ'_loc₁, hσ_inc, ← hder₁_def]; exact hF₁_crit
      have hR : σ'_crit (der2 1 (c₀ * τ₂ (MvPolynomial.X 0) + c₁ * τ₂ (MvPolynomial.X 1))) =
          σ'_crit c₁ := by
        rw [map_add, Derivation.leibniz, Derivation.leibniz]
        change σ'_crit ((c₀ * der2 1 (τ₂ (MvPolynomial.X 0)) + τ₂ (MvPolynomial.X 0) * der2 1 c₀) +
          (c₁ * der2 1 (τ₂ (MvPolynomial.X 1)) + τ₂ (MvPolynomial.X 1) * der2 1 c₁)) = _
        rw [hder2 1 0, hder2 1 1]
        simp [hσ'_X 0, hσ'_X 1]
      rw [hL, hR] at hdiff
      change σ'_crit c₁ = 0
      exact hdiff
    rw [hker_σ', Ideal.mem_span_pair] at hc₀_ker hc₁_ker
    obtain ⟨α₀₀, α₀₁, rfl⟩ := hc₀_ker
    obtain ⟨α₁₀, α₁₁, rfl⟩ := hc₁_ker
    let A₂₀ : B'₂ := α₀₀
    let A₁₁ : B'₂ := α₀₁ + α₁₀
    let A₀₂ : B'₂ := α₁₁
    have hQuad : eB₂ g + τ₂ (MvPolynomial.C h) =
        A₂₀ * τ₂ (MvPolynomial.X 0) ^ 2 +
          A₁₁ * (τ₂ (MvPolynomial.X 0) * τ₂ (MvPolynomial.X 1)) +
          A₀₂ * τ₂ (MvPolynomial.X 1) ^ 2 := by
      rw [← hc_lin]; dsimp [A₂₀, A₁₁, A₀₂]; ring
    
    have hCong : A₂₀ ∈ Q'₂.asIdeal ∧ A₁₁ - 1 ∈ Q'₂.asIdeal ∧ A₀₂ ∈ Q'₂.asIdeal := by
      have h_k₂_pkg : ∃ (k₂ : Type u) (_ : CommRing k₂) (π_p₂ : R₂ →+* k₂),
          ∀ r : R₂, π_p₂ r = 0 ↔ r ∈ p₂.asIdeal :=
        ⟨R₂ ⧸ p₂.asIdeal, inferInstance, Ideal.Quotient.mk p₂.asIdeal,
          fun _ => Ideal.Quotient.eq_zero_iff_mem⟩
      obtain ⟨k₂, instk₂, π_p₂, hπ_p₂_zero⟩ := h_k₂_pkg
      letI : CommRing k₂ := instk₂
      let Pk₂ : Type u := MvPolynomial (Fin 2) k₂
      let M : Ideal Pk₂ := Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
      have h_Qjet_pkg : ∃ (Q_jet : Type u) (_ : CommRing Q_jet) (π_M3 : Pk₂ →+* Q_jet),
          RingHom.ker π_M3 = M ^ 3 ∧ Ideal.map π_M3 (M ^ 3) = ⊥ :=
        ⟨Pk₂ ⧸ (M ^ 3), inferInstance, Ideal.Quotient.mk (M ^ 3), Ideal.mk_ker,
          Ideal.map_quotient_self (M ^ 3)⟩
      obtain ⟨Q_jet, instQjet, π_M3, hπ_M3_ker, hM3_map_bot⟩ := h_Qjet_pkg
      letI : CommRing Q_jet := instQjet
      let M_bar : Ideal Q_jet := Ideal.map π_M3 M
      have hM_bar_cube : M_bar ^ 3 = ⊥ := by
        dsimp [M_bar]
        rw [← Ideal.map_pow π_M3 M 3]
        exact hM3_map_bot
      let R_mid : Type u := Q_jet ⧸ (M_bar ^ 2)
      let π_mid : Q_jet →+* R_mid := Ideal.Quotient.mk (M_bar ^ 2)
      let M_bar1 : Ideal R_mid := Ideal.map π_mid M_bar
      have hM_bar1_sq : M_bar1 ^ 2 = ⊥ := by
        dsimp [M_bar1]
        rw [← Ideal.map_pow π_mid M_bar 2]
        exact Ideal.map_quotient_self (M_bar ^ 2)
      have hM_bar2_sq : (M_bar ^ 2) ^ 2 = ⊥ := by
        rw [← pow_mul, show (2 * 2 : ℕ) = 3 + 1 by rfl, pow_succ, hM_bar_cube, Ideal.bot_mul]
      letI : Algebra P₂ B'₂ := τ₂.toAlgebra
      haveI : Algebra.Etale P₂ B'₂ := RingHom.etale_algebraMap.mp hτ₂_et
      let toQjet_P₂ : P₂ →+* Q_jet := π_M3.comp (MvPolynomial.map π_p₂)
      letI : Algebra P₂ Q_jet := toQjet_P₂.toAlgebra
      letI : Algebra P₂ R_mid := (π_mid.comp toQjet_P₂).toAlgebra
      let R_top : Type u := R_mid ⧸ M_bar1
      let π_top : R_mid →+* R_top := Ideal.Quotient.mk M_bar1
      letI : Algebra P₂ R_top := (π_top.comp (π_mid.comp toQjet_P₂)).toAlgebra
      let c_jet : B'₂ →+* Q_jet :=
        π_M3.comp (MvPolynomial.C.comp (π_p₂.comp σ'_crit))
      let η₀_ring : B'₂ →+* R_top := π_top.comp (π_mid.comp c_jet)
      have hη₀_comm : ∀ f : P₂, η₀_ring (τ₂ f) = algebraMap P₂ R_top f := by
        have heq : η₀_ring.comp τ₂ = π_top.comp (π_mid.comp toQjet_P₂) := by
          apply MvPolynomial.ringHom_ext
          · intro r₂
            dsimp [η₀_ring, c_jet, toQjet_P₂]
            rw [hσ'_C r₂, MvPolynomial.map_C]
          · intro i
            dsimp [η₀_ring, c_jet, toQjet_P₂]
            rw [hσ'_X i, map_zero, map_zero, map_zero, map_zero, map_zero, MvPolynomial.map_X]
            symm
            rw [Ideal.Quotient.eq_zero_iff_mem]
            refine Ideal.mem_map_of_mem π_mid (Ideal.mem_map_of_mem π_M3 ?_)
            fin_cases i
            · exact Ideal.subset_span (Or.inl rfl)
            · exact Ideal.subset_span (Or.inr rfl)
        exact fun f => RingHom.congr_fun heq f
      let η₀ : B'₂ →ₐ[P₂] R_top := { toRingHom := η₀_ring, commutes' := hη₀_comm }
      have h_mk1 : Ideal.Quotient.mkₐ P₂ M_bar1 =
          { toRingHom := π_top, commutes' := fun _ => rfl } := rfl
      obtain ⟨η₁, hη₁⟩ :=
        (Algebra.FormallyEtale.comp_bijective P₂ B'₂ M_bar1 hM_bar1_sq).2 η₀
      obtain ⟨ψ₃, hψ₃⟩ :=
        (Algebra.FormallyEtale.comp_bijective P₂ B'₂ (M_bar ^ 2) hM_bar2_sq).2 η₁
      have hψ₃_P₂ : ∀ f : P₂, ψ₃ (τ₂ f) = toQjet_P₂ f := ψ₃.commutes
      have hψ₃_mod_M : ∀ b : B'₂, ψ₃ b - c_jet b ∈ M_bar := by
        intro b
        have htop_eq : π_top (π_mid (ψ₃ b)) = π_top (π_mid (c_jet b)) := by
          have h1 := AlgHom.congr_fun hψ₃ b
          have h2 := AlgHom.congr_fun hη₁ b
          change π_mid (ψ₃ b) = η₁ b at h1
          change π_top (η₁ b) = η₀_ring b at h2
          rw [h1, h2]; rfl
        have hmem1 : π_mid (ψ₃ b - c_jet b) ∈ M_bar1 := by
          rw [map_sub, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, htop_eq, sub_self]
        rcases (Ideal.mem_map_iff_of_surjective π_mid Ideal.Quotient.mk_surjective).mp hmem1 with
          ⟨y, hy, hy_eq⟩
        have hdiff_sq : (ψ₃ b - c_jet b) - y ∈ M_bar ^ 2 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hy_eq, sub_self]
        have hsq_le : M_bar ^ 2 ≤ M_bar := Ideal.pow_le_self (by norm_num)
        have : ψ₃ b - c_jet b = ((ψ₃ b - c_jet b) - y) + y := by ring
        rw [this]
        exact M_bar.add_mem (hsq_le hdiff_sq) hy
      
      have hψ₃_U : ψ₃ (eB₂ U) = π_M3 (MvPolynomial.X 0) := by
        rw [heB₂_U, map_add, hψ₃_P₂, hψ₃_P₂]
        dsimp [toQjet_P₂]
        rw [MvPolynomial.map_X, MvPolynomial.map_C,
          (hπ_p₂_zero u₀).mpr hu₀_p₂, map_zero, map_zero, add_zero]
      have hψ₃_V : ψ₃ (eB₂ V) = π_M3 (MvPolynomial.X 1) := by
        rw [heB₂_V, map_add, hψ₃_P₂, hψ₃_P₂]
        dsimp [toQjet_P₂]
        rw [MvPolynomial.map_X, MvPolynomial.map_C,
          (hπ_p₂_zero v₀).mpr hv₀_p₂, map_zero, map_zero, add_zero]
      have hψ₃_gh : ψ₃ (eB₂ g + τ₂ (MvPolynomial.C h)) =
          π_M3 (MvPolynomial.X 0 * MvPolynomial.X 1) := by
        have hψ₃_h : ψ₃ (τ₂ (MvPolynomial.C h)) = 0 := by
          rw [hψ₃_P₂]; dsimp [toQjet_P₂]
          rw [MvPolynomial.map_C, (hπ_p₂_zero h).mpr hh_p₂, map_zero, map_zero]
        let φ_B_jet : B →+* Q_jet := ψ₃.toRingHom.comp eB₂
        have hIp₁_zero : Ideal.map (φ_P.comp MvPolynomial.C) p₁.asIdeal ≤ RingHom.ker φ_B_jet := by
          rw [Ideal.map_le_iff_le_comap]
          intro r₁ hr₁
          change ψ₃ (eB₂ (φ_P (MvPolynomial.C r₁))) = 0
          have hr₂_p₂ : eR₂ r₁ ∈ p₂.asIdeal := by
            have h1 : φ_P (MvPolynomial.C r₁) ∈ Q.asIdeal := by
              rw [← hQp] at hr₁; exact hr₁
            rw [← hπ_p₂] at h1
            have h2 : π_crit (φ_P (MvPolynomial.C r₁)) ∈ p₂.asIdeal := h1
            have hπ_r₁ : π_crit (φ_P (MvPolynomial.C r₁)) = eR₂ r₁ :=
              RingHom.congr_fun hπ_comm r₁
            rwa [hπ_r₁] at h2
          have hcomm_r₁ : eB₂ (φ_P (MvPolynomial.C r₁)) = τ₂ (MvPolynomial.C (eR₂ r₁)) :=
            RingHom.congr_fun hcomm₂ r₁
          rw [hcomm_r₁, hψ₃_P₂]
          dsimp [toQjet_P₂]
          rw [MvPolynomial.map_C, (hπ_p₂_zero (eR₂ r₁)).mpr hr₂_p₂, map_zero, map_zero]
        have hIUV_eq_Mbar : Ideal.map φ_B_jet (Ideal.span {U, V}) = M_bar := by
          rw [Ideal.map_span, Set.image_pair]
          change Ideal.span {ψ₃ (eB₂ U), ψ₃ (eB₂ V)} = M_bar
          rw [hψ₃_U, hψ₃_V]
          dsimp [M_bar, M]
          rw [Ideal.map_span, Set.image_pair]
        have hIUV3_zero : Ideal.span {U, V} ^ 3 ≤ RingHom.ker φ_B_jet := by
          rw [RingHom.ker_eq_comap_bot, ← Ideal.map_le_iff_le_comap, Ideal.map_pow,
            hIUV_eq_Mbar, hM_bar_cube]
        have hg_diff_zero : φ_B_jet (g - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1)) = 0 :=
          (sup_le hIp₁_zero hIUV3_zero) hg
        rw [map_add, hψ₃_h, add_zero]
        change φ_B_jet g = _
        rw [← sub_eq_zero]
        have hUV_jet : φ_B_jet (φ_P (MvPolynomial.X 0 * MvPolynomial.X 1)) =
            π_M3 (MvPolynomial.X 0 * MvPolynomial.X 1) := by
          change ψ₃ (eB₂ (φ_P (MvPolynomial.X 0 * MvPolynomial.X 1))) = _
          rw [map_mul, map_mul, map_mul, hψ₃_U, hψ₃_V, ← map_mul]
        rw [← hUV_jet, ← map_sub]
        exact hg_diff_zero
      
      have hψ₃_quad_term : ∀ (b : B'₂) (i j : Fin 2),
          ψ₃ (b * (τ₂ (MvPolynomial.X i) * τ₂ (MvPolynomial.X j))) =
            π_M3 (MvPolynomial.C (π_p₂ (σ'_crit b)) *
              (MvPolynomial.X i * MvPolynomial.X j)) := by
        intro b i j
        rw [map_mul, map_mul, hψ₃_P₂, hψ₃_P₂]
        dsimp [toQjet_P₂]
        rw [MvPolynomial.map_X, MvPolynomial.map_X]
        have hXi_M : π_M3 (MvPolynomial.X i) ∈ M_bar := by
          refine Ideal.mem_map_of_mem π_M3 ?_
          fin_cases i
          · exact Ideal.subset_span (Or.inl rfl)
          · exact Ideal.subset_span (Or.inr rfl)
        have hXj_M : π_M3 (MvPolynomial.X j) ∈ M_bar := by
          refine Ideal.mem_map_of_mem π_M3 ?_
          fin_cases j
          · exact Ideal.subset_span (Or.inl rfl)
          · exact Ideal.subset_span (Or.inr rfl)
        have hprod_zero : (ψ₃ b - c_jet b) * (π_M3 (MvPolynomial.X i) * π_M3 (MvPolynomial.X j)) = 0 := by
          have hmem3 : (ψ₃ b - c_jet b) * (π_M3 (MvPolynomial.X i) * π_M3 (MvPolynomial.X j)) ∈
              M_bar ^ 3 := by
            have h3 : M_bar ^ 3 = M_bar * (M_bar * M_bar) := by
              rw [show (3 : ℕ) = 1 + 2 by rfl, pow_add, pow_one, pow_two]
            rw [h3]
            exact Submodule.mul_mem_mul (hψ₃_mod_M b) (Submodule.mul_mem_mul hXi_M hXj_M)
          rwa [hM_bar_cube, Submodule.mem_bot] at hmem3
        rw [sub_mul, sub_eq_zero] at hprod_zero
        rw [hprod_zero]; dsimp [c_jet]; rw [← map_mul, ← map_mul]
      let a20_bar : k₂ := π_p₂ (σ'_crit A₂₀)
      let a11_bar : k₂ := π_p₂ (σ'_crit A₁₁)
      let a02_bar : k₂ := π_p₂ (σ'_crit A₀₂)
      have h_jet_eq : π_M3 (MvPolynomial.C a20_bar * MvPolynomial.X 0 ^ 2 +
          MvPolynomial.C a11_bar * (MvPolynomial.X 0 * MvPolynomial.X 1) +
          MvPolynomial.C a02_bar * MvPolynomial.X 1 ^ 2) =
          π_M3 (MvPolynomial.X 0 * MvPolynomial.X 1) := by
        symm
        calc π_M3 (MvPolynomial.X 0 * MvPolynomial.X 1)
            = ψ₃ (eB₂ g + τ₂ (MvPolynomial.C h)) := hψ₃_gh.symm
          _ = ψ₃ (A₂₀ * τ₂ (MvPolynomial.X 0) ^ 2 +
                A₁₁ * (τ₂ (MvPolynomial.X 0) * τ₂ (MvPolynomial.X 1)) +
                A₀₂ * τ₂ (MvPolynomial.X 1) ^ 2) := by rw [hQuad]
          _ = π_M3 (MvPolynomial.C a20_bar * (MvPolynomial.X 0 * MvPolynomial.X 0)) +
                π_M3 (MvPolynomial.C a11_bar * (MvPolynomial.X 0 * MvPolynomial.X 1)) +
                π_M3 (MvPolynomial.C a02_bar * (MvPolynomial.X 1 * MvPolynomial.X 1)) := by
              rw [map_add, map_add, pow_two, pow_two,
                hψ₃_quad_term A₂₀ 0 0, hψ₃_quad_term A₁₁ 0 1, hψ₃_quad_term A₀₂ 1 1]
          _ = _ := by rw [← map_add, ← map_add, ← pow_two, ← pow_two]
      let P_diff : Pk₂ := MvPolynomial.C a20_bar * MvPolynomial.X 0 ^ 2 +
        MvPolynomial.C (a11_bar - 1) * (MvPolynomial.X 0 * MvPolynomial.X 1) +
        MvPolynomial.C a02_bar * MvPolynomial.X 1 ^ 2
      have h_poly_M3 : P_diff ∈ M ^ 3 := by
        rw [← hπ_M3_ker, RingHom.mem_ker]
        have hsub := sub_eq_zero.mpr h_jet_eq
        rw [← map_sub] at hsub
        convert hsub using 2
        dsimp [P_diff]
        simp [map_sub]; ring
      
      have h_quad_spec : ∀ u v : k₂,
          a20_bar * u ^ 2 + (a11_bar - 1) * (u * v) + a02_bar * v ^ 2 = 0 := by
        intro u v
        let φ_uv_alg : Pk₂ →ₐ[k₂] Polynomial k₂ :=
          MvPolynomial.aeval ![Polynomial.C u * Polynomial.X,
            Polynomial.C v * Polynomial.X]
        let φ_uv : Pk₂ →+* Polynomial k₂ := φ_uv_alg.toRingHom
        have hM_X : Ideal.map φ_uv M ≤ Ideal.span ({Polynomial.X} : Set (Polynomial k₂)) := by
          rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
          rintro _ (rfl | rfl)
          · change φ_uv_alg (MvPolynomial.X 0) ∈ Ideal.span {Polynomial.X}
            dsimp only [φ_uv_alg]
            rw [MvPolynomial.aeval_X, Matrix.cons_val_zero, Ideal.mem_span_singleton]
            exact ⟨Polynomial.C u, mul_comm _ _⟩
          · change φ_uv_alg (MvPolynomial.X 1) ∈ Ideal.span {Polynomial.X}
            dsimp only [φ_uv_alg]
            rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero,
              Ideal.mem_span_singleton]
            exact ⟨Polynomial.C v, mul_comm _ _⟩
        have h_mul_mono : ∀ {I₁ I₂ J₁ J₂ : Ideal (Polynomial k₂)},
            I₁ ≤ J₁ → I₂ ≤ J₂ → I₁ * I₂ ≤ J₁ * J₂ := by
          intro I₁ I₂ J₁ J₂ h₁ h₂ x hx
          exact Submodule.mul_induction_on hx
            (fun a ha b hb => Submodule.mul_mem_mul (h₁ ha) (h₂ hb))
            (fun _ _ ha hb => (J₁ * J₂).add_mem ha hb)
        have h_cube_le : (Ideal.map φ_uv M) ^ 3 ≤
            (Ideal.span ({Polynomial.X} : Set (Polynomial k₂))) ^ 3 := by
          have h3 : ∀ K : Ideal (Polynomial k₂), K ^ 3 = K * (K * K) := fun K => by
            rw [show (3 : ℕ) = 1 + (1 + 1) by rfl, pow_add, pow_add, pow_one]
          rw [h3, h3]
          exact h_mul_mono hM_X (h_mul_mono hM_X hM_X)
        have hmem_map : φ_uv P_diff ∈ Ideal.map φ_uv (M ^ 3) :=
          Ideal.mem_map_of_mem φ_uv h_poly_M3
        rw [Ideal.map_pow] at hmem_map
        have hp3 : φ_uv P_diff ∈ (Ideal.span ({Polynomial.X} : Set (Polynomial k₂))) ^ 3 :=
          h_cube_le hmem_map
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hp3
        obtain ⟨q, hq⟩ := hp3
        have h_rhs_coeff : (Polynomial.X ^ 3 * q).coeff 2 = 0 := by
          have h_assoc : Polynomial.X ^ 3 * q = ((q * Polynomial.X) * Polynomial.X) * Polynomial.X := by
            ring
          rw [h_assoc, show (2 : ℕ) = 1 + 1 by rfl, Polynomial.coeff_mul_X,
            show (1 : ℕ) = 0 + 1 by rfl, Polynomial.coeff_mul_X, Polynomial.coeff_mul_X_zero]
        let c_uv : k₂ := a20_bar * u ^ 2 + (a11_bar - 1) * (u * v) + a02_bar * v ^ 2
        have hX0 : φ_uv (MvPolynomial.X 0) = Polynomial.C u * Polynomial.X := by
          change φ_uv_alg (MvPolynomial.X 0) = _
          dsimp only [φ_uv_alg]
          rw [MvPolynomial.aeval_X, Matrix.cons_val_zero]
        have hX1 : φ_uv (MvPolynomial.X 1) = Polynomial.C v * Polynomial.X := by
          change φ_uv_alg (MvPolynomial.X 1) = _
          dsimp only [φ_uv_alg]
          rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero]
        have hC_uv : ∀ c : k₂, φ_uv (MvPolynomial.C c) = Polynomial.C c := by
          intro c
          change φ_uv_alg (MvPolynomial.C c) = Polynomial.C c
          dsimp only [φ_uv_alg]
          rw [MvPolynomial.aeval_C]
          rfl
        have h_eval : φ_uv P_diff = Polynomial.C c_uv * Polynomial.X ^ 2 := by
          dsimp only [P_diff, c_uv]
          rw [map_add, map_add, map_mul, map_mul, map_mul, map_mul,
            map_pow, map_pow, hC_uv, hC_uv, hC_uv, hX0, hX1]
          simp only [map_add, map_mul, map_pow]
          ring
        have h_lhs_coeff : (Polynomial.C c_uv * Polynomial.X ^ 2).coeff 2 = c_uv := by
          have h_assoc : Polynomial.C c_uv * Polynomial.X ^ 2 =
              (Polynomial.C c_uv * Polynomial.X) * Polynomial.X := by ring
          rw [h_assoc, show (2 : ℕ) = 1 + 1 by rfl, Polynomial.coeff_mul_X,
            show (1 : ℕ) = 0 + 1 by rfl, Polynomial.coeff_mul_X, Polynomial.coeff_C_zero]
        rw [h_eval] at hq
        change c_uv = 0
        rw [← h_lhs_coeff, hq, h_rhs_coeff]
      have ha20_zero : a20_bar = 0 := by simpa using h_quad_spec 1 0
      have ha02_zero : a02_bar = 0 := by simpa using h_quad_spec 0 1
      have ha11_zero : a11_bar - 1 = 0 := by
        have h11 := h_quad_spec 1 1
        rw [ha20_zero, ha02_zero] at h11
        simpa using h11
      refine ⟨?_, ?_, ?_⟩
      · change σ'_crit A₂₀ ∈ p₂.asIdeal
        exact (hπ_p₂_zero _).mp ha20_zero
      · change σ'_crit (A₁₁ - 1) ∈ p₂.asIdeal
        rw [← hπ_p₂_zero, map_sub, map_one, map_sub, map_one]
        exact ha11_zero
      · change σ'_crit A₀₂ ∈ p₂.asIdeal
        exact (hπ_p₂_zero _).mp ha02_zero
    exact ⟨h, B'₂, inferInstance, τ₂, eB₂, Q'₂, A₂₀, A₁₁, A₀₂,
      hτ₂_et, heB₂_et, hcomm₂, hQ'₂_Q, hXi_Q'₂, hh_Q'₂, hQuad,
      hCong.1, hCong.2.1, hCong.2.2⟩

  obtain ⟨h, B'₂, instB'₂, τ₂, eB₂, Q'₂, A₂₀, A₁₁, A₀₂,
    hτ₂_et, heB₂_et, hcomm₂, hQ'₂_Q, hXi_Q'₂, hh_Q'₂, hQuad, hA₂₀, hA₁₁, hA₀₂⟩ := h_step2
  letI : CommRing B'₂ := instB'₂

  
  have h_step3 : ∃ (B₃ : Type u) (_ : CommRing B₃) (e₂₃ : B'₂ →+* B₃)
      (Q₃ : PrimeSpectrum B₃) (W : B₃),
      e₂₃.Etale ∧
      PrimeSpectrum.comap e₂₃ Q₃ = Q'₂ ∧
      W ∈ Q₃.asIdeal ∧
      (e₂₃ (τ₂ (MvPolynomial.X 0)) + W * e₂₃ (τ₂ (MvPolynomial.X 1))) *
        (e₂₃ A₂₀ * e₂₃ (τ₂ (MvPolynomial.X 0)) +
          (e₂₃ A₁₁ - e₂₃ A₂₀ * W) * e₂₃ (τ₂ (MvPolynomial.X 1))) -
        e₂₃ (τ₂ (MvPolynomial.C h)) = e₂₃ (eB₂ g) := by
    obtain ⟨C₂, hC₂_def⟩ : ∃ x : B'₂, x = A₂₀ + A₁₁ + A₀₂ := ⟨_, rfl⟩
    have hC₂_sub_one : C₂ - 1 ∈ Q'₂.asIdeal := by
      have : C₂ - 1 = A₂₀ + (A₁₁ - 1) + A₀₂ := by rw [hC₂_def]; ring
      rw [this]
      exact Q'₂.asIdeal.add_mem (Q'₂.asIdeal.add_mem hA₂₀ hA₁₁) hA₀₂
    let B''₂ : Type u := Localization.Away C₂
    let loc_C : B'₂ →+* B''₂ := algebraMap B'₂ B''₂
    haveI : Algebra.Etale B'₂ B''₂ := Algebra.Etale.of_isLocalizationAway C₂
    have hlocC_et : loc_C.Etale := RingHom.etale_algebraMap.mpr inferInstance
    obtain ⟨u_c, hu_c⟩ := IsLocalization.Away.algebraMap_isUnit (S := B''₂) C₂
    change (↑u_c : B''₂) = loc_C C₂ at hu_c
    let c_inv : B''₂ := ↑(u_c⁻¹)
    have hc_mul_inv : loc_C C₂ * c_inv = 1 := by rw [← hu_c]; exact Units.mul_inv u_c
    let a₂₀ : B''₂ := loc_C A₂₀
    let a₁₁ : B''₂ := loc_C A₁₁
    let a₀₂ : B''₂ := loc_C A₀₂
    let b₁_coeff : B''₂ := c_inv * (2 * a₂₀ + a₁₁)
    let b₀_coeff : B''₂ := c_inv * a₂₀
    let P_mon : Polynomial B''₂ :=
      Polynomial.X ^ 2 - Polynomial.C b₁_coeff * Polynomial.X + Polynomial.C b₀_coeff
    have hP_monic : P_mon.Monic := by
      have h_eq : P_mon = Polynomial.X ^ 2 +
          (-(Polynomial.C b₁_coeff * Polynomial.X) + Polynomial.C b₀_coeff) := by
        dsimp [P_mon]; ring
      rw [h_eq]
      apply Polynomial.monic_X_pow_add
      refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ ?_)
      · rw [Polynomial.degree_neg]
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le b₁_coeff) (by decide)
      · exact lt_of_le_of_lt Polynomial.degree_C_le (by decide)
    let g_sep : Polynomial B''₂ := Polynomial.X * Polynomial.derivative P_mon
    let P_sep : StandardEtalePair B''₂ :=
      StandardEtalePair.mk P_mon hP_monic g_sep ⟨Polynomial.X, 0, 1, by ring⟩
    let B₃ : Type u := P_sep.Ring
    let e₂₃ : B'₂ →+* B₃ := (algebraMap B''₂ B₃).comp loc_C
    have he₂₃_et : e₂₃.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hlocC_et (RingHom.etale_algebraMap.mpr inferInstance)
    
    letI : Q'₂.asIdeal.IsPrime := Q'₂.isPrime
    let K'₂ : Type u := FractionRing (B'₂ ⧸ Q'₂.asIdeal)
    let toK'₂ : B'₂ →+* K'₂ :=
      (algebraMap (B'₂ ⧸ Q'₂.asIdeal) K'₂).comp (Ideal.Quotient.mk Q'₂.asIdeal)
    have hker_K'₂ : ∀ x : B'₂, toK'₂ x = 0 ↔ x ∈ Q'₂.asIdeal := by
      intro x
      change algebraMap (B'₂ ⧸ Q'₂.asIdeal) K'₂ (Ideal.Quotient.mk Q'₂.asIdeal x) = 0 ↔ _
      rw [← map_zero (algebraMap (B'₂ ⧸ Q'₂.asIdeal) K'₂),
        (IsFractionRing.injective (B'₂ ⧸ Q'₂.asIdeal) K'₂).eq_iff,
        Ideal.Quotient.eq_zero_iff_mem]
    have htoK_C₂ : toK'₂ C₂ = 1 := by
      have := (hker_K'₂ (C₂ - 1)).mpr hC₂_sub_one
      rwa [map_sub, map_one, sub_eq_zero] at this
    have htoK_A₂₀ : toK'₂ A₂₀ = 0 := (hker_K'₂ A₂₀).mpr hA₂₀
    have htoK_A₁₁ : toK'₂ A₁₁ = 1 := by
      have := (hker_K'₂ (A₁₁ - 1)).mpr hA₁₁
      rwa [map_sub, map_one, sub_eq_zero] at this
    have hC₂_unit_K'₂ : IsUnit (toK'₂ C₂) := by rw [htoK_C₂]; exact isUnit_one
    let toK''₂ : B''₂ →+* K'₂ := IsLocalization.Away.lift C₂ hC₂_unit_K'₂
    have htoK''_loc : ∀ x : B'₂, toK''₂ (loc_C x) = toK'₂ x :=
      fun x => IsLocalization.Away.lift_eq C₂ hC₂_unit_K'₂ x
    have htoK''_cinv : toK''₂ c_inv = 1 := by
      have h1 := congr_arg toK''₂ hc_mul_inv
      rw [map_mul, map_one, htoK''_loc, htoK_C₂, one_mul] at h1
      exact h1
    letI : Algebra B''₂ K'₂ := toK''₂.toAlgebra
    have hderiv_P : Polynomial.derivative P_mon =
        2 * Polynomial.X - Polynomial.C b₁_coeff := by
      dsimp [P_mon]
      rw [Polynomial.derivative_add, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
        Polynomial.derivative_C_mul_X, Polynomial.derivative_C, add_zero]
      simp [Polynomial.C_ofNat]
    have hHasMap1 : P_sep.HasMap (1 : K'₂) := by
      have halg : (algebraMap B''₂ K'₂ : B''₂ →+* K'₂) = toK''₂ := rfl
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval (1 : K'₂) P_mon = 0
        dsimp [P_mon, b₁_coeff, b₀_coeff, a₂₀, a₁₁]
        simp only [map_add, map_sub, map_mul, map_pow, map_ofNat,
          Polynomial.aeval_X, Polynomial.aeval_C, halg,
          htoK''_cinv, htoK''_loc, htoK_A₂₀, htoK_A₁₁]
        ring
      · change IsUnit (Polynomial.aeval (1 : K'₂) g_sep)
        have hg1 : Polynomial.aeval (1 : K'₂) g_sep = 1 := by
          dsimp [g_sep]
          rw [hderiv_P]
          dsimp [b₁_coeff, a₂₀, a₁₁]
          simp only [map_mul, map_sub, map_add, map_ofNat,
            Polynomial.aeval_X, Polynomial.aeval_C, halg,
            htoK''_cinv, htoK''_loc, htoK_A₂₀, htoK_A₁₁]
          ring
        rw [hg1]; exact isUnit_one
    let ev₁ : B₃ →ₐ[B''₂] K'₂ := P_sep.lift (1 : K'₂) hHasMap1
    let Q₃ : PrimeSpectrum B₃ := PrimeSpectrum.comap ev₁.toRingHom (⊥ : PrimeSpectrum K'₂)
    have hQ₃_Q'₂ : PrimeSpectrum.comap e₂₃ Q₃ = Q'₂ := by
      ext x
      change x ∈ Ideal.comap (ev₁.toRingHom.comp e₂₃) (⊥ : Ideal K'₂) ↔ x ∈ Q'₂.asIdeal
      have hcomp : ev₁.toRingHom.comp e₂₃ = toK'₂ := by
        ext y
        change ev₁ (algebraMap B''₂ B₃ (loc_C y)) = toK'₂ y
        rw [ev₁.commutes]
        exact htoK''_loc y
      rw [hcomp, Ideal.mem_comap, Ideal.mem_bot, hker_K'₂]
    let Z_bar : B₃ := P_sep.X
    have h1_sub_Z : 1 - Z_bar ∈ Q₃.asIdeal := by
      change ev₁ (1 - Z_bar) = 0
      rw [map_sub, map_one, StandardEtalePair.lift_X, sub_self]
    obtain ⟨hPZ_zero, hZ_gsep_unit⟩ := (StandardEtalePair.hasMap_X (P := P_sep))
    change Polynomial.aeval Z_bar P_mon = 0 at hPZ_zero
    change IsUnit (Polynomial.aeval Z_bar g_sep) at hZ_gsep_unit
    have hZ_unit : IsUnit Z_bar := by
      dsimp [g_sep] at hZ_gsep_unit
      rw [map_mul, Polynomial.aeval_X] at hZ_gsep_unit
      exact isUnit_of_mul_isUnit_left hZ_gsep_unit
    obtain ⟨u_z, hu_z⟩ := hZ_unit
    change (↑u_z : B₃) = Z_bar at hu_z
    let z_inv : B₃ := ↑(u_z⁻¹)
    have hZ_mul_inv : Z_bar * z_inv = 1 := by rw [← hu_z]; exact Units.mul_inv u_z
    let W : B₃ := (1 - Z_bar) * z_inv
    have hW_Q₃ : W ∈ Q₃.asIdeal := Q₃.asIdeal.mul_mem_right z_inv h1_sub_Z
    have hZW : Z_bar * W = 1 - Z_bar := by
      dsimp [W]
      calc Z_bar * ((1 - Z_bar) * z_inv) = (1 - Z_bar) * (Z_bar * z_inv) := by ring
        _ = 1 - Z_bar := by rw [hZ_mul_inv, mul_one]
    have hP_raw_zero :
        (e₂₃ A₂₀ + e₂₃ A₁₁ + e₂₃ A₀₂) * Z_bar ^ 2 -
          (2 * e₂₃ A₂₀ + e₂₃ A₁₁) * Z_bar + e₂₃ A₂₀ = 0 := by
      have hmul := congr_arg (fun t => e₂₃ C₂ * t) hPZ_zero
      dsimp [P_mon] at hmul
      simp only [Polynomial.aeval_def, Polynomial.eval₂_add, Polynomial.eval₂_sub,
        Polynomial.eval₂_mul, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
        mul_zero] at hmul
      have hC_b1 : e₂₃ C₂ * algebraMap B''₂ B₃ b₁_coeff =
          2 * e₂₃ A₂₀ + e₂₃ A₁₁ := by
        dsimp [e₂₃, b₁_coeff, a₂₀, a₁₁]
        rw [← map_mul, ← mul_assoc, hc_mul_inv, one_mul, map_add, map_mul, map_ofNat]
      have hC_b0 : e₂₃ C₂ * algebraMap B''₂ B₃ b₀_coeff = e₂₃ A₂₀ := by
        dsimp [e₂₃, b₀_coeff, a₂₀]
        rw [← map_mul, ← mul_assoc, hc_mul_inv, one_mul]
      have hC_expand : e₂₃ C₂ = e₂₃ A₂₀ + e₂₃ A₁₁ + e₂₃ A₀₂ := by
        rw [congr_arg e₂₃ hC₂_def]; simp only [map_add]
      have hmul' : e₂₃ C₂ * Z_bar ^ 2 -
          (e₂₃ C₂ * algebraMap B''₂ B₃ b₁_coeff) * Z_bar +
          e₂₃ C₂ * algebraMap B''₂ B₃ b₀_coeff = 0 := by
        linear_combination hmul
      rwa [hC_b1, hC_b0, hC_expand] at hmul'
    let u_t : B₃ := e₂₃ (τ₂ (MvPolynomial.X 0))
    let v_t : B₃ := e₂₃ (τ₂ (MvPolynomial.X 1))
    let x₀ : B₃ := u_t + W * v_t
    let x₁ : B₃ := e₂₃ A₂₀ * u_t + (e₂₃ A₁₁ - e₂₃ A₂₀ * W) * v_t
    let g_quad₃ : B₃ := e₂₃ A₂₀ * u_t ^ 2 + e₂₃ A₁₁ * (u_t * v_t) + e₂₃ A₀₂ * v_t ^ 2
    have hZ2_fact : Z_bar ^ 2 * (x₀ * x₁ - g_quad₃) = 0 := by
      have hZx₀ : Z_bar * x₀ = Z_bar * u_t + (1 - Z_bar) * v_t := by
        dsimp [x₀]; linear_combination v_t * hZW
      have hZx₁ : Z_bar * x₁ =
          Z_bar * e₂₃ A₂₀ * u_t + (Z_bar * e₂₃ A₁₁ - e₂₃ A₂₀ * (1 - Z_bar)) * v_t := by
        dsimp [x₁]; linear_combination -(e₂₃ A₂₀ * v_t * hZW)
      calc Z_bar ^ 2 * (x₀ * x₁ - g_quad₃)
          = (Z_bar * x₀) * (Z_bar * x₁) - Z_bar ^ 2 * g_quad₃ := by ring
        _ = (Z_bar * u_t + (1 - Z_bar) * v_t) *
              (Z_bar * e₂₃ A₂₀ * u_t + (Z_bar * e₂₃ A₁₁ - e₂₃ A₂₀ * (1 - Z_bar)) * v_t) -
              Z_bar ^ 2 * g_quad₃ := by rw [hZx₀, hZx₁]
        _ = -(((e₂₃ A₂₀ + e₂₃ A₁₁ + e₂₃ A₀₂) * Z_bar ^ 2 -
              (2 * e₂₃ A₂₀ + e₂₃ A₁₁) * Z_bar + e₂₃ A₂₀) * v_t ^ 2) := by
              dsimp [g_quad₃]; ring
        _ = 0 := by rw [hP_raw_zero, zero_mul, neg_zero]
    have hfact_eq : x₀ * x₁ = g_quad₃ := by
      have hZ2_inv : z_inv ^ 2 * Z_bar ^ 2 = 1 := by
        rw [← mul_pow, mul_comm, hZ_mul_inv, one_pow]
      have h0 : x₀ * x₁ - g_quad₃ = 0 := by
        calc x₀ * x₁ - g_quad₃ = (z_inv ^ 2 * Z_bar ^ 2) * (x₀ * x₁ - g_quad₃) := by
              rw [hZ2_inv, one_mul]
          _ = z_inv ^ 2 * (Z_bar ^ 2 * (x₀ * x₁ - g_quad₃)) := by ring
          _ = 0 := by rw [hZ2_fact, mul_zero]
      exact sub_eq_zero.mp h0
    have hg_quad₃_eq : g_quad₃ = e₂₃ (eB₂ g) + e₂₃ (τ₂ (MvPolynomial.C h)) := by
      have := congr_arg e₂₃ hQuad
      simp only [map_add, map_mul, map_pow] at this
      exact this.symm
    refine ⟨B₃, inferInstance, e₂₃, Q₃, W, he₂₃_et, hQ₃_Q'₂, hW_Q₃, ?_⟩
    change x₀ * x₁ - e₂₃ (τ₂ (MvPolynomial.C h)) = e₂₃ (eB₂ g)
    rw [hfact_eq, hg_quad₃_eq, add_sub_cancel_right]

  obtain ⟨B₃, instB₃, e₂₃, Q₃, W, he₂₃_et, hQ₃_Q'₂, hW_Q₃, hFact⟩ := h_step3
  letI : CommRing B₃ := instB₃

  
  let P₂ := MvPolynomial (Fin 2) R₂
  let τ₃ : P₂ →+* B₃ := e₂₃.comp τ₂
  let eB₃ : B →+* B₃ := e₂₃.comp eB₂
  have hτ₃_et : τ₃.Etale := RingHom.Etale.stableUnderComposition _ _ hτ₂_et he₂₃_et
  have heB₃_et : eB₃.Etale := RingHom.Etale.stableUnderComposition _ _ heB₂_et he₂₃_et
  have hQ₃_Q : PrimeSpectrum.comap eB₃ Q₃ = Q := by
    ext x
    change e₂₃ (eB₂ x) ∈ Q₃.asIdeal ↔ x ∈ Q.asIdeal
    rw [← hQ'₂_Q, ← hQ₃_Q'₂]; rfl
  have he₂₃_mem : ∀ {x : B'₂}, x ∈ Q'₂.asIdeal → e₂₃ x ∈ Q₃.asIdeal := by
    intro x hx; rw [← hQ₃_Q'₂] at hx; exact hx
  let u_t : B₃ := τ₃ (MvPolynomial.X 0)
  let v_t : B₃ := τ₃ (MvPolynomial.X 1)
  let A₂₀_3 : B₃ := e₂₃ A₂₀
  let B₁₁ : B₃ := e₂₃ A₁₁ - e₂₃ A₂₀ * W
  let x₀ : B₃ := u_t + W * v_t
  let x₁ : B₃ := A₂₀_3 * u_t + B₁₁ * v_t
  have hu_t_Q₃ : u_t ∈ Q₃.asIdeal := he₂₃_mem (hXi_Q'₂ 0)
  have hv_t_Q₃ : v_t ∈ Q₃.asIdeal := he₂₃_mem (hXi_Q'₂ 1)
  have hh_Q₃ : τ₃ (MvPolynomial.C h) ∈ Q₃.asIdeal := he₂₃_mem hh_Q'₂
  have hA₂₀_Q₃ : A₂₀_3 ∈ Q₃.asIdeal := he₂₃_mem hA₂₀
  have hB₁₁_Q₃ : B₁₁ - 1 ∈ Q₃.asIdeal := by
    have : B₁₁ - 1 = e₂₃ (A₁₁ - 1) - A₂₀_3 * W := by dsimp [B₁₁, A₂₀_3]; simp [map_sub]; ring
    rw [this]
    exact Q₃.asIdeal.sub_mem (he₂₃_mem hA₁₁) (Q₃.asIdeal.mul_mem_left _ hW_Q₃)
  have hx₀_Q₃ : x₀ ∈ Q₃.asIdeal :=
    Q₃.asIdeal.add_mem hu_t_Q₃ (Q₃.asIdeal.mul_mem_left W hv_t_Q₃)
  have hx₁_Q₃ : x₁ ∈ Q₃.asIdeal :=
    Q₃.asIdeal.add_mem (Q₃.asIdeal.mul_mem_left A₂₀_3 hu_t_Q₃)
      (Q₃.asIdeal.mul_mem_left B₁₁ hv_t_Q₃)

  
  letI : Algebra R₂ B₃ := (τ₃.comp MvPolynomial.C).toAlgebra
  obtain ⟨b_B₃, D_B₃, hb_B₃, hD_B₃, hDiff_B₃⟩ := h_dual_basis τ₃ rfl hτ₃_et
  obtain ⟨D₀, hD₀_def⟩ : ∃ d : Derivation R₂ B₃ B₃, d = D_B₃ 0 := ⟨D_B₃ 0, rfl⟩
  obtain ⟨D₁, hD₁_def⟩ : ∃ d : Derivation R₂ B₃ B₃, d = D_B₃ 1 := ⟨D_B₃ 1, rfl⟩
  have hD₀u : D₀ u_t = 1 := by rw [hD₀_def]; simpa [u_t] using hD_B₃ 0 0
  have hD₀v : D₀ v_t = 0 := by rw [hD₀_def]; simpa [v_t] using hD_B₃ 0 1
  have hD₁u : D₁ u_t = 0 := by rw [hD₁_def]; simpa [u_t] using hD_B₃ 1 0
  have hD₁v : D₁ v_t = 1 := by rw [hD₁_def]; simpa [v_t] using hD_B₃ 1 1
  have hJ00 : D₀ x₀ - 1 ∈ Q₃.asIdeal := by
    have : D₀ x₀ - 1 = v_t * D₀ W := by
      dsimp [x₀]; rw [map_add, Derivation.leibniz]
      change D₀ u_t + (W * D₀ v_t + v_t * D₀ W) - 1 = _
      rw [hD₀u, hD₀v]; ring
    rw [this]; exact Q₃.asIdeal.mul_mem_right (D₀ W) hv_t_Q₃
  have hJ10 : D₁ x₀ ∈ Q₃.asIdeal := by
    have : D₁ x₀ = W + v_t * D₁ W := by
      dsimp [x₀]; rw [map_add, Derivation.leibniz]
      change D₁ u_t + (W * D₁ v_t + v_t * D₁ W) = _
      rw [hD₁u, hD₁v]; ring
    rw [this]; exact Q₃.asIdeal.add_mem hW_Q₃ (Q₃.asIdeal.mul_mem_right (D₁ W) hv_t_Q₃)
  have hJ01 : D₀ x₁ ∈ Q₃.asIdeal := by
    have : D₀ x₁ = A₂₀_3 + u_t * D₀ A₂₀_3 + v_t * D₀ B₁₁ := by
      dsimp [x₁]; rw [map_add, Derivation.leibniz, Derivation.leibniz]
      change (A₂₀_3 * D₀ u_t + u_t * D₀ A₂₀_3) + (B₁₁ * D₀ v_t + v_t * D₀ B₁₁) = _
      rw [hD₀u, hD₀v]; ring
    rw [this]
    exact Q₃.asIdeal.add_mem
      (Q₃.asIdeal.add_mem hA₂₀_Q₃ (Q₃.asIdeal.mul_mem_right _ hu_t_Q₃))
      (Q₃.asIdeal.mul_mem_right _ hv_t_Q₃)
  have hJ11 : D₁ x₁ - 1 ∈ Q₃.asIdeal := by
    have : D₁ x₁ - 1 = (B₁₁ - 1) + u_t * D₁ A₂₀_3 + v_t * D₁ B₁₁ := by
      dsimp [x₁]; rw [map_add, Derivation.leibniz, Derivation.leibniz]
      change (A₂₀_3 * D₁ u_t + u_t * D₁ A₂₀_3) + (B₁₁ * D₁ v_t + v_t * D₁ B₁₁) - 1 = _
      rw [hD₁u, hD₁v]; ring
    rw [this]
    exact Q₃.asIdeal.add_mem
      (Q₃.asIdeal.add_mem hB₁₁_Q₃ (Q₃.asIdeal.mul_mem_right _ hu_t_Q₃))
      (Q₃.asIdeal.mul_mem_right _ hv_t_Q₃)
  obtain ⟨f_det, hf_det_def⟩ : ∃ x : B₃, x = D₀ x₀ * D₁ x₁ - D₁ x₀ * D₀ x₁ := ⟨_, rfl⟩
  have hf_det_sub_one : f_det - 1 ∈ Q₃.asIdeal := by
    have : f_det - 1 = (D₀ x₀ - 1) * D₁ x₁ + (D₁ x₁ - 1) - D₁ x₀ * D₀ x₁ := by
      rw [hf_det_def]; ring
    rw [this]
    exact Q₃.asIdeal.sub_mem
      (Q₃.asIdeal.add_mem (Q₃.asIdeal.mul_mem_right _ hJ00) hJ11)
      (Q₃.asIdeal.mul_mem_right _ hJ10)

  
  let B₄ : Type u := Localization.Away f_det
  let loc₄ : B₃ →+* B₄ := algebraMap B₃ B₄
  haveI : Algebra.Etale B₃ B₄ := Algebra.Etale.of_isLocalizationAway f_det
  have hloc₄_et : loc₄.Etale := RingHom.etale_algebraMap.mpr inferInstance
  let τ₄ : P₂ →+* B₄ := loc₄.comp τ₃
  let eB₄ : B →+* B₄ := loc₄.comp eB₃
  have hτ₄_et : τ₄.Etale := RingHom.Etale.stableUnderComposition _ _ hτ₃_et hloc₄_et
  have heB₄_et : eB₄.Etale := RingHom.Etale.stableUnderComposition _ _ heB₃_et hloc₄_et
  
  have hR₂_B₄_pkg : Subsingleton (Algebra.H1Cotangent R₂ B₄) ∧
      Algebra.FinitePresentation R₂ B₄ ∧
      ∃ b₄ : Module.Basis (Fin 2) B₄ Ω[B₄⁄R₂],
        ∀ y : B₃, KaehlerDifferential.D R₂ B₄ (loc₄ y) =
          loc₄ (D₀ y) • b₄ 0 + loc₄ (D₁ y) • b₄ 1 := by
    letI : Algebra P₂ B₄ := τ₄.toAlgebra
    haveI : IsScalarTower R₂ P₂ B₄ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.Etale P₂ B₄ := RingHom.etale_algebraMap.mp hτ₄_et
    haveI : Algebra.FormallySmooth R₂ B₄ := Algebra.FormallySmooth.comp R₂ P₂ B₄
    haveI : Algebra.FinitePresentation R₂ B₄ := Algebra.FinitePresentation.trans R₂ P₂ B₄
    obtain ⟨_, hSubH1⟩ := (Algebra.formallySmooth_iff R₂ B₄).mp inferInstance
    obtain ⟨b₄, _, hb₄, _, _⟩ := h_dual_basis τ₄ rfl hτ₄_et
    refine ⟨hSubH1, inferInstance, b₄, ?_⟩
    intro y
    have hm := KaehlerDifferential.map_D R₂ R₂ B₃ B₄ y
    change (KaehlerDifferential.map R₂ R₂ B₃ B₄) (KaehlerDifferential.D R₂ B₃ y) =
      KaehlerDifferential.D R₂ B₄ (loc₄ y) at hm
    rw [← hm, hDiff_B₃ y, ← hD₀_def, ← hD₁_def, map_add, LinearMap.map_smul_of_tower,
      LinearMap.map_smul_of_tower,
      hb_B₃ 0, hb_B₃ 1, KaehlerDifferential.map_D, KaehlerDifferential.map_D, hb₄ 0, hb₄ 1,
      ← IsScalarTower.algebraMap_smul B₄ (D₀ y), ← IsScalarTower.algebraMap_smul B₄ (D₁ y)]
    rfl
  obtain ⟨hSubH1_R₂B₄, hFP_R₂B₄, b₄, hD_B₄⟩ := hR₂_B₄_pkg
  haveI : Algebra.FinitePresentation R₂ B₄ := hFP_R₂B₄
  let φ_tilde₄ : P₂ →+* B₄ := (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]).toRingHom
  have hφ_tilde₄_et : φ_tilde₄.Etale := by
    letI : Algebra P₂ B₄ := φ_tilde₄.toAlgebra
    have hAlg_eq : ∀ r₂ : R₂, algebraMap R₂ B₄ r₂ = algebraMap P₂ B₄ (algebraMap R₂ P₂ r₂) := by
      intro r₂
      symm
      exact (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]).commutes r₂
    haveI : IsScalarTower R₂ P₂ B₄ := IsScalarTower.of_algebraMap_eq hAlg_eq
    haveI : Algebra.FinitePresentation P₂ B₄ :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R₂ P₂ B₄
    let b₀_P₂ : Module.Basis (Fin 2) P₂ Ω[P₂⁄R₂] := KaehlerDifferential.mvPolynomialBasis R₂ (Fin 2)
    have hb₀_P₂ : ∀ j : Fin 2, b₀_P₂ j = KaehlerDifferential.D R₂ P₂ (MvPolynomial.X j) := by
      intro j
      apply b₀_P₂.repr.injective
      ext i
      rw [Module.Basis.repr_self, Finsupp.single_apply,
        KaehlerDifferential.mvPolynomialBasis_repr_apply]
      by_cases hij : j = i
      · subst hij; simp
      · simp [hij]
    let b_dom : Module.Basis (Fin 2) B₄ (TensorProduct P₂ B₄ Ω[P₂⁄R₂]) :=
      Algebra.TensorProduct.basis B₄ b₀_P₂
    let μ := KaehlerDifferential.mapBaseChange R₂ P₂ B₄
    let m₀₀ : B₄ := loc₄ (D₀ x₀)
    let m₀₁ : B₄ := loc₄ (D₁ x₀)
    let m₁₀ : B₄ := loc₄ (D₀ x₁)
    let m₁₁ : B₄ := loc₄ (D₁ x₁)
    have hμ0 : μ (b_dom 0) = m₀₀ • b₄ 0 + m₀₁ • b₄ 1 := by
      dsimp [μ, b_dom]
      rw [Algebra.TensorProduct.basis_apply, hb₀_P₂ 0, KaehlerDifferential.mapBaseChange_tmul,
        one_smul, KaehlerDifferential.map_D]
      have hx : (algebraMap P₂ B₄) (MvPolynomial.X 0) = loc₄ x₀ := by
        change (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]) (MvPolynomial.X 0) = loc₄ x₀
        rw [MvPolynomial.aeval_X, Matrix.cons_val_zero]
      rw [hx, hD_B₄ x₀]
    have hμ1 : μ (b_dom 1) = m₁₀ • b₄ 0 + m₁₁ • b₄ 1 := by
      dsimp [μ, b_dom]
      rw [Algebra.TensorProduct.basis_apply, hb₀_P₂ 1, KaehlerDifferential.mapBaseChange_tmul,
        one_smul, KaehlerDifferential.map_D]
      have hx : (algebraMap P₂ B₄) (MvPolynomial.X 1) = loc₄ x₁ := by
        change (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]) (MvPolynomial.X 1) = loc₄ x₁
        rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero]
      rw [hx, hD_B₄ x₁]
    have hdet_unit : IsUnit (m₀₀ * m₁₁ - m₀₁ * m₁₀) := by
      have h_eq : m₀₀ * m₁₁ - m₀₁ * m₁₀ = loc₄ f_det := by
        dsimp [m₀₀, m₀₁, m₁₀, m₁₁]
        rw [congr_arg loc₄ hf_det_def]
        simp only [map_sub, map_mul]
      rw [h_eq]; exact IsLocalization.Away.algebraMap_isUnit f_det
    obtain ⟨u_det, hu_det⟩ := hdet_unit
    let det_inv : B₄ := ↑(u_det⁻¹)
    have hdet_mul_inv : (m₀₀ * m₁₁ - m₀₁ * m₁₀) * det_inv = 1 := by
      rw [← hu_det]; exact Units.mul_inv u_det
    have hinv_mul_det : det_inv * (m₀₀ * m₁₁ - m₀₁ * m₁₀) = 1 := by
      rw [mul_comm]; exact hdet_mul_inv
    have hμ_inj : Function.Injective μ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro z hz
      rw [LinearMap.mem_ker] at hz
      have hz_sum := (b_dom.sum_repr z).symm
      rw [Fin.sum_univ_two] at hz_sum
      let c₀ : B₄ := b_dom.repr z 0
      let c₁ : B₄ := b_dom.repr z 1
      rw [hz_sum, map_add, map_smul, map_smul, hμ0, hμ1] at hz
      have h_comb : (c₀ * m₀₀ + c₁ * m₁₀) • b₄ 0 + (c₀ * m₀₁ + c₁ * m₁₁) • b₄ 1 = 0 := by
        rw [← hz]
        simp only [add_smul, smul_add, mul_smul]
        abel
      have hc0 : c₀ * m₀₀ + c₁ * m₁₀ = 0 := by
        have := congr_arg (fun w => b₄.repr w 0) h_comb
        simpa [Module.Basis.repr_self] using this
      have hc1 : c₀ * m₀₁ + c₁ * m₁₁ = 0 := by
        have := congr_arg (fun w => b₄.repr w 1) h_comb
        simpa [Module.Basis.repr_self] using this
      have hc₀_zero : c₀ = 0 := by
        calc c₀ = c₀ * ((m₀₀ * m₁₁ - m₀₁ * m₁₀) * det_inv) := by rw [hdet_mul_inv, mul_one]
          _ = ((c₀ * m₀₀ + c₁ * m₁₀) * m₁₁ - (c₀ * m₀₁ + c₁ * m₁₁) * m₁₀) * det_inv := by ring
          _ = 0 := by rw [hc0, hc1]; ring
      have hc₁_zero : c₁ = 0 := by
        calc c₁ = c₁ * ((m₀₀ * m₁₁ - m₀₁ * m₁₀) * det_inv) := by rw [hdet_mul_inv, mul_one]
          _ = (m₀₀ * (c₀ * m₀₁ + c₁ * m₁₁) - m₀₁ * (c₀ * m₀₀ + c₁ * m₁₀)) * det_inv := by ring
          _ = 0 := by rw [hc0, hc1]; ring
      rw [hz_sum]
      change c₀ • b_dom 0 + c₁ • b_dom 1 = 0
      rw [hc₀_zero, hc₁_zero, zero_smul, zero_smul, add_zero]
    have hμ_surj : Function.Surjective μ := by
      have hb0 : μ ((det_inv * m₁₁) • b_dom 0 - (det_inv * m₀₁) • b_dom 1) = b₄ 0 := by
        rw [map_sub, map_smul, map_smul, hμ0, hμ1,
          smul_add, smul_add, smul_smul, smul_smul, smul_smul, smul_smul,
          add_sub_add_comm, ← sub_smul, ← sub_smul]
        have hr0 : det_inv * m₁₁ * m₀₀ - det_inv * m₀₁ * m₁₀ = (1 : B₄) := by
          linear_combination hinv_mul_det
        have hr1 : det_inv * m₁₁ * m₀₁ - det_inv * m₀₁ * m₁₁ = (0 : B₄) := by ring
        rw [hr0, hr1, one_smul, zero_smul, add_zero]
      have hb1 : μ ((det_inv * m₀₀) • b_dom 1 - (det_inv * m₁₀) • b_dom 0) = b₄ 1 := by
        rw [map_sub, map_smul, map_smul, hμ1, hμ0,
          smul_add, smul_add, smul_smul, smul_smul, smul_smul, smul_smul,
          add_sub_add_comm, ← sub_smul, ← sub_smul]
        have hr0 : det_inv * m₀₀ * m₁₀ - det_inv * m₁₀ * m₀₀ = (0 : B₄) := by ring
        have hr1 : det_inv * m₀₀ * m₁₁ - det_inv * m₁₀ * m₀₁ = (1 : B₄) := by
          linear_combination hinv_mul_det
        rw [hr0, hr1, zero_smul, one_smul, zero_add]
      intro ω
      have hω := (b₄.sum_repr ω).symm
      rw [Fin.sum_univ_two] at hω
      refine ⟨(b₄.repr ω 0) • ((det_inv * m₁₁) • b_dom 0 - (det_inv * m₀₁) • b_dom 1) +
        (b₄.repr ω 1) • ((det_inv * m₀₀) • b_dom 1 - (det_inv * m₁₀) • b_dom 0), ?_⟩
      rw [map_add, map_smul, map_smul, hb0, hb1, ← hω]
    have hSubΩ_P₂B₄ : Subsingleton Ω[B₄⁄P₂] := by
      refine Subsingleton.intro fun ω₁ ω₂ => ?_
      rw [← sub_eq_zero]
      obtain ⟨ω₀, hω₀⟩ := KaehlerDifferential.map_surjective R₂ P₂ B₄ (ω₁ - ω₂)
      obtain ⟨t, rfl⟩ := hμ_surj ω₀
      rw [← hω₀]
      exact (KaehlerDifferential.exact_mapBaseChange_map R₂ P₂ B₄ (μ t)).mpr ⟨t, rfl⟩
    have hSubH1_P₂B₄ : Subsingleton (Algebra.H1Cotangent P₂ B₄) := by
      refine Subsingleton.intro fun c₁ c₂ => ?_
      rw [← sub_eq_zero]
      have hδ0 : Algebra.H1Cotangent.δ R₂ P₂ B₄ (c₁ - c₂) = 0 := by
        apply hμ_inj
        rw [map_zero]
        exact (Algebra.H1Cotangent.exact_δ_mapBaseChange R₂ P₂ B₄
          (Algebra.H1Cotangent.δ R₂ P₂ B₄ (c₁ - c₂))).mpr ⟨c₁ - c₂, rfl⟩
      obtain ⟨c₀, hc₀⟩ := (Algebra.H1Cotangent.exact_map_δ R₂ P₂ B₄ (c₁ - c₂)).mp hδ0
      rw [← hc₀, hSubH1_R₂B₄.elim c₀ 0, map_zero]
    haveI : Algebra.FormallyEtale P₂ B₄ :=
      (Algebra.formallyEtale_iff P₂ B₄).mpr ⟨hSubΩ_P₂B₄, hSubH1_P₂B₄⟩
    haveI : Algebra.Etale P₂ B₄ := {}
    exact RingHom.etale_algebraMap.mpr inferInstance

  
  have h_quot_etale : ∀ {A C : Type u} [CommRing A] [CommRing C]
      (f : A →+* C) (_ : f.Etale) (a : A) (J : Ideal C) (hJ : J = Ideal.span {f a})
      (hIJ : Ideal.span {a} ≤ Ideal.comap f J),
      (Ideal.quotientMap (I := Ideal.span {a}) J f hIJ).Etale := by
    intro A C _ _ f hf a J hJ hIJ
    subst hJ
    let I : Ideal A := Ideal.span {a}
    let J₀ : Ideal C := Ideal.span {f a}
    have h_QA_pkg : ∃ (Q_A : Type u) (_ : CommRing Q_A) (mk_QA : A →+* Q_A)
        (e_QA : (A ⧸ I) →+* Q_A) (q_to_CJ : Q_A →+* (C ⧸ J₀)),
        Function.Bijective e_QA ∧
        (∀ x : A, e_QA (Ideal.Quotient.mk I x) = mk_QA x) ∧
        (∀ x : A, q_to_CJ (mk_QA x) = Ideal.Quotient.mk J₀ (f x)) ∧
        mk_QA a = 0 := by
      refine ⟨A ⧸ I, inferInstance, Ideal.Quotient.mk I, RingHom.id (A ⧸ I),
        Ideal.quotientMap (I := I) J₀ f hIJ,
        Function.bijective_id, fun _ => rfl, fun _ => Ideal.quotientMap_mk, ?_⟩
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self a)
    obtain ⟨Q_A, instQA, mk_QA, e_QA, q_to_CJ, he_QA_bij, he_QA_mk, hq_CJ_mk, hmk_a_zero⟩ :=
      h_QA_pkg
    letI : CommRing Q_A := instQA
    letI : Algebra A Q_A := mk_QA.toAlgebra
    letI : Algebra A C := f.toAlgebra
    haveI : Algebra.Etale A C := RingHom.etale_algebraMap.mp hf
    haveI : Algebra.Etale Q_A (TensorProduct A Q_A C) :=
      Algebra.Etale.baseChange A C Q_A
    have h_bc : (algebraMap Q_A (TensorProduct A Q_A C)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let π_J₀ : C →+* (C ⧸ J₀) := Ideal.Quotient.mk J₀
    letI : Algebra A (C ⧸ J₀) := (π_J₀.comp f).toAlgebra
    let q_alg : Q_A →ₐ[A] (C ⧸ J₀) :=
      { toRingHom := q_to_CJ
        commutes' := fun x => hq_CJ_mk x }
    let c_alg : C →ₐ[A] (C ⧸ J₀) :=
      { toRingHom := π_J₀
        commutes' := fun _ => rfl }
    let f_alg : TensorProduct A Q_A C →ₐ[A] (C ⧸ J₀) :=
      Algebra.TensorProduct.productMap q_alg c_alg
    let f_TP : @RingHom (TensorProduct A Q_A C) (C ⧸ J₀)
        CommRing.toCommSemiring.toNonAssocSemiring
        CommRing.toCommSemiring.toNonAssocSemiring :=
      { toFun := fun t => f_alg t
        map_one' := f_alg.map_one
        map_mul' := f_alg.map_mul
        map_zero' := f_alg.map_zero
        map_add' := f_alg.map_add }
    let incR_alg : C →ₐ[A] TensorProduct A Q_A C := Algebra.TensorProduct.includeRight
    let incR_TP : @RingHom C (TensorProduct A Q_A C)
        CommRing.toCommSemiring.toNonAssocSemiring
        CommRing.toCommSemiring.toNonAssocSemiring :=
      { toFun := fun c => incR_alg c
        map_one' := incR_alg.map_one
        map_mul' := incR_alg.map_mul
        map_zero' := incR_alg.map_zero
        map_add' := incR_alg.map_add }
    have hJ₀_TP : ∀ z ∈ J₀, incR_TP z = 0 := by
      have hle : J₀ ≤ RingHom.ker incR_TP := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change (1 : Q_A) ⊗ₜ[A] (algebraMap A C a) = 0
        rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul a]
        change (mk_QA a) ⊗ₜ[A] (1 : C) = 0
        rw [hmk_a_zero, TensorProduct.zero_tmul]
      exact fun z hz => hle hz
    let g_TP : (C ⧸ J₀) →+* TensorProduct A Q_A C :=
      Ideal.Quotient.lift J₀ incR_TP hJ₀_TP
    have h_fg : ∀ z : (C ⧸ J₀), f_TP (g_TP z) = z := by
      intro z
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
      change f_alg (g_TP (Ideal.Quotient.mk J₀ c)) = π_J₀ c
      rw [Ideal.Quotient.lift_mk]
      exact AlgHom.congr_fun (Algebra.TensorProduct.productMap_right q_alg c_alg) c
    have h_gf : ∀ t : TensorProduct A Q_A C, g_TP (f_TP t) = t := by
      intro t
      let P_mot : TensorProduct A Q_A C → Prop := fun z => g_TP (f_TP z) = z
      change P_mot t
      refine TensorProduct.induction_on t ?_ ?_ ?_
      · dsimp only [P_mot]
        rw [map_zero, map_zero]
      · intro q c
        dsimp only [P_mot]
        have h_surj_QA : Function.Surjective mk_QA := by
          intro y
          obtain ⟨y₀, hy₀⟩ := he_QA_bij.2 y
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y₀
          exact ⟨x, (he_QA_mk x).symm.trans hy₀⟩
        obtain ⟨x, rfl⟩ := h_surj_QA q
        have hsplit : (mk_QA x ⊗ₜ[A] c : TensorProduct A Q_A C) =
            algebraMap Q_A (TensorProduct A Q_A C) (mk_QA x) * incR_TP c := by
          change mk_QA x ⊗ₜ[A] c = (mk_QA x ⊗ₜ[A] (1 : C)) * ((1 : Q_A) ⊗ₜ[A] c)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, map_mul, map_mul]
        have hf_l : f_TP (algebraMap Q_A (TensorProduct A Q_A C) (mk_QA x)) = π_J₀ (f x) := by
          have h1 := AlgHom.congr_fun (Algebra.TensorProduct.productMap_left q_alg c_alg) (mk_QA x)
          exact h1.trans (hq_CJ_mk x)
        have hf_r : f_TP (incR_TP c) = π_J₀ c :=
          AlgHom.congr_fun (Algebra.TensorProduct.productMap_right q_alg c_alg) c
        rw [hf_l, hf_r]
        change g_TP (Ideal.Quotient.mk J₀ (f x)) * g_TP (Ideal.Quotient.mk J₀ c) = _
        rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
        have hg_l : incR_TP (f x) = algebraMap Q_A (TensorProduct A Q_A C) (mk_QA x) := by
          change (1 : Q_A) ⊗ₜ[A] algebraMap A C x = mk_QA x ⊗ₜ[A] (1 : C)
          exact (Algebra.TensorProduct.tmul_one_eq_one_tmul x).symm
        rw [hg_l]
      · intro u v hu hv
        dsimp only [P_mot] at hu hv ⊢
        rw [map_add, map_add, hu, hv]
    have hf_TP_bij : Function.Bijective f_TP :=
      ⟨Function.LeftInverse.injective h_gf, Function.RightInverse.surjective h_fg⟩
    have h_eq : Ideal.quotientMap (I := I) J₀ f hIJ =
        f_TP.comp ((algebraMap Q_A (TensorProduct A Q_A C)).comp e_QA) := by
      apply Ideal.Quotient.ringHom_ext
      ext x
      change Ideal.quotientMap (I := I) J₀ f hIJ (Ideal.Quotient.mk I x) =
        f_TP (algebraMap Q_A (TensorProduct A Q_A C) (e_QA (Ideal.Quotient.mk I x)))
      rw [Ideal.quotientMap_mk, he_QA_mk]
      have h1 := AlgHom.congr_fun (Algebra.TensorProduct.productMap_left q_alg c_alg) (mk_QA x)
      exact (h1.trans (hq_CJ_mk x)).symm
    rw [h_eq]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective he_QA_bij) h_bc)
      (RingHom.Etale.of_bijective hf_TP_bij)

  let J_D : Ideal B₄ := Ideal.span {eB₄ g}
  let D : Type u := B₄ ⧸ J_D
  let mk_D : B₄ →+* D := Ideal.Quotient.mk J_D
  have hφ_tilde₄_rel : φ_tilde₄ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) = eB₄ g := by
    have hX0 : φ_tilde₄ (MvPolynomial.X 0) = loc₄ x₀ := by
      change (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]) (MvPolynomial.X 0) = loc₄ x₀
      rw [MvPolynomial.aeval_X, Matrix.cons_val_zero]
    have hX1 : φ_tilde₄ (MvPolynomial.X 1) = loc₄ x₁ := by
      change (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]) (MvPolynomial.X 1) = loc₄ x₁
      rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero]
    have hCh : φ_tilde₄ (MvPolynomial.C h) = loc₄ (τ₃ (MvPolynomial.C h)) := by
      exact (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]).commutes h
    rw [map_sub, map_mul, hX0, hX1, hCh]
    change loc₄ x₀ * loc₄ x₁ - loc₄ (τ₃ (MvPolynomial.C h)) = loc₄ (eB₃ g)
    rw [← map_mul, ← map_sub]
    exact congr_arg loc₄ hFact
  have hle_eD : Ideal.span {g} ≤ Ideal.comap eB₄ J_D := by
    rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.mem_comap.mpr (Ideal.mem_span_singleton_self (eB₄ g))
  let eD : (B ⧸ Ideal.span {g}) →+* D :=
    Ideal.quotientMap (I := Ideal.span {g}) J_D eB₄ hle_eD
  have heD_et : eD.Etale := h_quot_etale eB₄ heB₄_et g J_D rfl hle_eD
  have hle_φq : Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h} ≤
      Ideal.comap φ_tilde₄ J_D := by
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hφ_tilde₄_rel]
    exact Ideal.mem_span_singleton_self (eB₄ g)
  let φ_q : (P₂ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}) →+* D :=
    Ideal.quotientMap
      (I := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})
      J_D φ_tilde₄ hle_φq
  have hφ_q_et : φ_q.Etale :=
    h_quot_etale φ_tilde₄ hφ_tilde₄_et
      (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) J_D
      (by dsimp [J_D]; rw [hφ_tilde₄_rel]) hle_φq

  
  letI : Q₃.asIdeal.IsPrime := Q₃.isPrime
  let K₃ : Type u := FractionRing (B₃ ⧸ Q₃.asIdeal)
  let toK₃ : B₃ →+* K₃ :=
    (algebraMap (B₃ ⧸ Q₃.asIdeal) K₃).comp (Ideal.Quotient.mk Q₃.asIdeal)
  have hker_K₃ : ∀ y : B₃, toK₃ y = 0 ↔ y ∈ Q₃.asIdeal := by
    intro y
    change algebraMap (B₃ ⧸ Q₃.asIdeal) K₃ (Ideal.Quotient.mk Q₃.asIdeal y) = 0 ↔ _
    rw [← map_zero (algebraMap (B₃ ⧸ Q₃.asIdeal) K₃),
      (IsFractionRing.injective (B₃ ⧸ Q₃.asIdeal) K₃).eq_iff,
      Ideal.Quotient.eq_zero_iff_mem]
  have hf_det_unit_K₃ : IsUnit (toK₃ f_det) := by
    have h1 := (hker_K₃ (f_det - 1)).mpr hf_det_sub_one
    rw [map_sub, map_one, sub_eq_zero] at h1
    rw [h1]; exact isUnit_one
  let toK₄ : B₄ →+* K₃ := IsLocalization.Away.lift f_det hf_det_unit_K₃
  have htoK₄_loc : ∀ y : B₃, toK₄ (loc₄ y) = toK₃ y :=
    fun y => IsLocalization.Away.lift_eq f_det hf_det_unit_K₃ y
  have hJD_ker : ∀ w ∈ J_D, toK₄ w = 0 := by
    have hle : J_D ≤ RingHom.ker toK₄ := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      change toK₄ (loc₄ (eB₃ g)) = 0
      rw [htoK₄_loc, hker_K₃]
      dsimp [eB₃]
      rw [← hFact]
      exact Q₃.asIdeal.sub_mem (Q₃.asIdeal.mul_mem_left x₀ hx₁_Q₃) hh_Q₃
    exact fun w hw => hle hw
  let toK_D : D →+* K₃ := Ideal.Quotient.lift J_D toK₄ hJD_ker
  let v₀ : PrimeSpectrum D := PrimeSpectrum.comap toK_D (⊥ : PrimeSpectrum K₃)

  refine ⟨R₂, inferInstance, eR₂, h, D, inferInstance, v₀, eD, φ_q,
    heR₂, heD_et, hφ_q_et, ?_, ?_, ?_, ?_⟩
  · apply PrimeSpectrum.comap_injective_of_surjective (Ideal.Quotient.mk (Ideal.span {g}))
      Ideal.Quotient.mk_surjective
    rw [hq_bar]
    ext b
    change b ∈ Ideal.comap (toK_D.comp (eD.comp (Ideal.Quotient.mk (Ideal.span {g}))))
      (⊥ : Ideal K₃) ↔ b ∈ Q.asIdeal
    have hcomp : toK_D.comp (eD.comp (Ideal.Quotient.mk (Ideal.span {g}))) = toK₃.comp eB₃ := by
      ext y
      dsimp only [RingHom.comp_apply, toK_D, eD, eB₄]
      rw [Ideal.quotientMap_mk, Ideal.Quotient.lift_mk]
      exact htoK₄_loc (eB₃ y)
    rw [hcomp, Ideal.mem_comap, RingHom.comp_apply, Ideal.mem_bot, hker_K₃]
    rw [← hQ₃_Q]; rfl
  · rw [Fin.forall_fin_two]
    constructor
    · change toK_D (φ_q (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = 0
      dsimp only [toK_D, φ_q]
      rw [Ideal.quotientMap_mk, Ideal.Quotient.lift_mk]
      have hX0 : φ_tilde₄ (MvPolynomial.X 0) = loc₄ x₀ := by
        change (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]) (MvPolynomial.X 0) = loc₄ x₀
        rw [MvPolynomial.aeval_X, Matrix.cons_val_zero]
      rw [hX0, htoK₄_loc]
      exact (hker_K₃ x₀).mpr hx₀_Q₃
    · change toK_D (φ_q (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = 0
      dsimp only [toK_D, φ_q]
      rw [Ideal.quotientMap_mk, Ideal.Quotient.lift_mk]
      have hX1 : φ_tilde₄ (MvPolynomial.X 1) = loc₄ x₁ := by
        change (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]) (MvPolynomial.X 1) = loc₄ x₁
        rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero]
      rw [hX1, htoK₄_loc]
      exact (hker_K₃ x₁).mpr hx₁_Q₃
  · change toK_D (φ_q (Ideal.Quotient.mk _ (MvPolynomial.C h))) = 0
    dsimp only [toK_D, φ_q]
    rw [Ideal.quotientMap_mk, Ideal.Quotient.lift_mk]
    have hC : φ_tilde₄ (MvPolynomial.C h) = loc₄ (τ₃ (MvPolynomial.C h)) :=
      (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]).commutes h
    rw [hC, htoK₄_loc]
    exact (hker_K₃ _).mpr hh_Q₃
  · ext r₁
    dsimp only [RingHom.comp_apply, eD, φ_q]
    rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk]
    have hC₁ : eB₄ (φ_P (MvPolynomial.C r₁)) = loc₄ (e₂₃ (eB₂ (φ_P (MvPolynomial.C r₁)))) := rfl
    have hC₂ : eB₂ (φ_P (MvPolynomial.C r₁)) = τ₂ (MvPolynomial.C (eR₂ r₁)) :=
      RingHom.congr_fun hcomm₂ r₁
    have hC₃ : φ_tilde₄ (MvPolynomial.C (eR₂ r₁)) = loc₄ (e₂₃ (τ₂ (MvPolynomial.C (eR₂ r₁)))) :=
      (MvPolynomial.aeval ![loc₄ x₀, loc₄ x₁]).commutes (eR₂ r₁)
    rw [hC₁, hC₂, hC₃]

theorem weil_geometric_stable_curve_to_semistablePointedCurveOver (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ X₂ B₃ C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (hProjB₃ : IsProjectiveOverField k B₃)
    (hProjC₃ : IsProjectiveOverField k C₃)
    (ψ₃ : B₃ ⟶ B₂)
    (U₃ : B₃.left.Opens)
    (hU₃Sub : (U₃ : Set B₃.left) ⊆ ψ₃.left.base ⁻¹' (U₂ : Set B₂.left))
    (g₃ : C₃ ⟶ B₃)
    (τ₃ : Fin n → (B₃ ⟶ C₃))
    (hStab₃ : IsGeometricStablePointedCurve g₃.left n (fun j => (τ₃ j).left))
    (hIso₃ : HasOpenPointedCurvePullbackIsoOver k f₂ σ ψ₃ U₃ g₃ τ₃) :
    IsSemistablePointedCurveOver k g₃ U₃ n τ₃ :=
by
  obtain ⟨_, hFlat, hProp, hFP, hSurj, hSec, hDisj, hSmSec, hFibGeom⟩ := hStab₃
  have hSmU₃ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (g₃.left ∣_ U₃) := by
    have hSm₂ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₂.left ∣_ U₂) := hFib₂.2.1.2.2.1
    obtain ⟨ι₃, hcomm, hOpenImm, hRange, _⟩ := hIso₃
    let V₃ : C₃.left.Opens := (TopologicalSpace.Opens.map g₃.left.base).obj U₃
    let P := CategoryTheory.Limits.pullback f₂.left ψ₃.left
    let fstP := CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left
    let sndP := CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left
    let Φ₃ : V₃.toScheme ⟶ P := CategoryTheory.Limits.pullback.lift ι₃ (V₃.ι ≫ g₃.left) hcomm
    let W_P : P.Opens := (TopologicalSpace.Opens.map sndP.base).obj U₃
    have hRange_sub : Set.range Φ₃.base ⊆ Set.range W_P.ι.base := by
      rw [hRange, W_P.range_ι]; exact Set.Subset.rfl
    let Φ_bar : V₃.toScheme ⟶ W_P.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W_P.ι Φ₃ hRange_sub
    have hΦ_fac : Φ_bar ≫ W_P.ι = Φ₃ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_P.ι Φ₃ hRange_sub
    have hOpen_bar : AlgebraicGeometry.IsOpenImmersion Φ_bar := by
      have : AlgebraicGeometry.IsOpenImmersion (Φ_bar ≫ W_P.ι) := by
        rw [hΦ_fac]; exact hOpenImm
      exact AlgebraicGeometry.IsOpenImmersion.of_comp Φ_bar W_P.ι
    have hSurj_bar : AlgebraicGeometry.Surjective Φ_bar := by
      refine ⟨fun w => ?_⟩
      have hw : W_P.ι.base w ∈ Set.range Φ₃.base := by
        rw [hRange]; exact w.2
      obtain ⟨v, hv⟩ := hw
      refine ⟨v, W_P.ι.isOpenEmbedding.injective ?_⟩
      change (Φ_bar ≫ W_P.ι).base v = W_P.ι.base w
      rw [hΦ_fac, hv]
    have hIso_bar : CategoryTheory.IsIso Φ_bar :=
      (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective Φ_bar).mpr ⟨hOpen_bar, hSurj_bar⟩
    have hΦ_snd : Φ_bar ≫ (sndP ∣_ U₃) = g₃.left ∣_ U₃ := by
      rw [← CategoryTheory.cancel_mono U₃.ι]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc, hΦ_fac]
      exact (CategoryTheory.Limits.pullback.lift_snd ι₃ (V₃.ι ≫ g₃.left) _).trans
        (AlgebraicGeometry.morphismRestrict_ι g₃.left U₃).symm
    have hPb_WP : CategoryTheory.IsPullback (W_P.ι ≫ fstP) (sndP ∣_ U₃) f₂.left (U₃.ι ≫ ψ₃.left) :=
      (AlgebraicGeometry.isPullback_morphismRestrict sndP U₃).flip.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f₂.left ψ₃.left)
    have hPb_V₃ : CategoryTheory.IsPullback ι₃ (g₃.left ∣_ U₃) f₂.left (U₃.ι ≫ ψ₃.left) := by
      refine CategoryTheory.IsPullback.of_iso hPb_WP
        (CategoryTheory.asIso Φ_bar).symm (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ (by simp) (by simp)
      · rw [CategoryTheory.Iso.symm_hom, CategoryTheory.asIso_inv, CategoryTheory.IsIso.eq_inv_comp,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          ← CategoryTheory.Category.assoc, hΦ_fac]
        exact CategoryTheory.Limits.pullback.lift_fst ι₃ (V₃.ι ≫ g₃.left) _
      · rw [CategoryTheory.Iso.symm_hom, CategoryTheory.asIso_inv, CategoryTheory.IsIso.eq_inv_comp,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
        exact hΦ_snd
    have hLE_U : U₃ ≤ (TopologicalSpace.Opens.map ψ₃.left.base).obj U₂ := hU₃Sub
    let ψ_U : U₃.toScheme ⟶ U₂.toScheme := B₃.left.homOfLE hLE_U ≫ (ψ₃.left ∣_ U₂)
    have hψ_U : ψ_U ≫ U₂.ι = U₃.ι ≫ ψ₃.left := by
      dsimp [ψ_U]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
    let V₂ : X₂.left.Opens := (TopologicalSpace.Opens.map f₂.left.base).obj U₂
    have hι_sub : Set.range ι₃.base ⊆ Set.range V₂.ι.base := by
      rw [V₂.range_ι]
      rintro _ ⟨v, rfl⟩
      change (ι₃ ≫ f₂.left).base v ∈ (U₂ : Set B₂.left)
      rw [hPb_V₃.w, ← hψ_U]
      exact (((g₃.left ∣_ U₃) ≫ ψ_U).base v).2
    let ι_V : V₃.toScheme ⟶ V₂.toScheme := AlgebraicGeometry.IsOpenImmersion.lift V₂.ι ι₃ hι_sub
    have hι_V : ι_V ≫ V₂.ι = ι₃ := AlgebraicGeometry.IsOpenImmersion.lift_fac V₂.ι ι₃ hι_sub
    have hSq_left : ι_V ≫ (f₂.left ∣_ U₂) = (g₃.left ∣_ U₃) ≫ ψ_U := by
      rw [← CategoryTheory.cancel_mono U₂.ι]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc, hι_V, hPb_V₃.w, ← hψ_U]
      simp only [CategoryTheory.Category.assoc]
    have hPb_outer : CategoryTheory.IsPullback (ι_V ≫ V₂.ι) (g₃.left ∣_ U₃) f₂.left (ψ_U ≫ U₂.ι) := by
      rw [hι_V, hψ_U]; exact hPb_V₃
    have hPb_final : CategoryTheory.IsPullback ι_V (g₃.left ∣_ U₃) (f₂.left ∣_ U₂) ψ_U :=
      CategoryTheory.IsPullback.of_right hPb_outer hSq_left
        (AlgebraicGeometry.isPullback_morphismRestrict f₂.left U₂).flip
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hPb_final hSm₂
  refine ⟨hFlat, hProp, hFP, hSurj, fun K _ _ s => (hFibGeom K s).1, hSmU₃,
    fun j => CategoryTheory.Over.OverMorphism.ext (hSec j), hDisj, hSmSec, ?_⟩
  intro x
  rcases weil_flat_finPres_curve_affine_dichotomy_at_point C₃.left B₃.left g₃.left hFlat hFP
      (fun K _ _ s y => (hFibGeom K s).2.1 y) x with hSm |
    ⟨U_S, hAffS, U_C, hAffC, hLE, q₀, _, hq₀_x, hFlat₀, hFP₀, hNode₀⟩
  · exact Or.inl hSm
  · refine Or.inr ?_
    let f₀_hom := g₃.left.appLE U_S U_C hLE
    obtain ⟨R₁, A₁, instR₁, instA₁, eR₁, eA₁, f₁, q₁, u₁, v₁,
        heR₁, heA₁, hFlat₁, hFP₁, hcomm₁, hq₁, hSplit⟩ :=
      weil_geom_nodal_fiber_etale_split_tangent_cone
        ↑(B₃.left.presheaf.obj (Opposite.op U_S))
        ↑(C₃.left.presheaf.obj (Opposite.op U_C))
        f₀_hom.hom hFlat₀ hFP₀ q₀ hNode₀
    letI : CommRing R₁ := instR₁
    letI : CommRing A₁ := instA₁
    obtain ⟨B, instB, φ_P, Q, g, e_hyp, hEtP, he_hyp, hQp, hXi, hg, hcomm_hyp,
        ⟨q_bar, hq_bar, hq_bar_q₁⟩⟩ :=
      weil_split_nodal_fiber_to_etale_ambient_hypersurface R₁ A₁ f₁ hFlat₁ hFP₁ q₁ u₁ v₁ hSplit
    letI : CommRing B := instB
    obtain ⟨R', instR', eR₂, h, D, instD, v₀, eD, φ_q,
        heR₂, heD, hφ_q, hv₀, hX_v₀, hh_v₀, hcomm₂⟩ :=
      weil_etale_plane_nodal_hypersurface_to_standard_nodal_roof
        R₁ B (PrimeSpectrum.comap f₁ q₁) φ_P hEtP Q hQp hXi g hg q_bar hq_bar
    letI : CommRing R' := instR'
    letI : CommRing D := instD
    have heR₁_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom eR₁)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr heR₁
    have heR₂_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom eR₂)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr heR₂
    have heA₁_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom eA₁)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr heA₁
    have he_hyp_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_hyp)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr he_hyp
    have heD_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom eD)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr heD
    have hφ_q_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_q)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_q
    let e_B : AlgebraicGeometry.Spec (CommRingCat.of R') ⟶ B₃.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom eR₂) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom eR₁) ≫ hAffS.fromSpec
    let V' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of D)
    let e_C : V' ⟶ C₃.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom eD) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_hyp) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom eA₁) ≫ hAffC.fromSpec
    let q : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) R' ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_q)
    refine ⟨CommRingCat.of R', e_B, h, V', v₀, e_C, q,
      inferInstance, inferInstance, hφ_q_sch, ?_, hX_v₀, hh_v₀, ?_⟩
    · change hAffC.fromSpec.base
        (PrimeSpectrum.comap eA₁ (PrimeSpectrum.comap e_hyp (PrimeSpectrum.comap eD v₀))) = x
      rw [hv₀, hq_bar_q₁, hq₁, hq₀_x]
    · dsimp only [e_C, e_B, q]
      simp only [CategoryTheory.Category.assoc]
      rw [← hAffS.SpecMap_appLE_fromSpec g₃.left hAffC hLE]
      have hf₀ : g₃.left.appLE U_S U_C hLE = CommRingCat.ofHom f₀_hom.hom := rfl
      rw [hf₀]
      simp only [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      congr 3
      ext r
      have h₁ := RingHom.congr_fun hcomm₁ r
      have h₂ := RingHom.congr_fun hcomm_hyp (eR₁ r)
      have h₃ := RingHom.congr_fun hcomm₂ (eR₁ r)
      simp only [RingHom.comp_apply] at h₁ h₂ h₃ ⊢
      rw [h₁, h₂, h₃]

theorem weil_algClosed_stable_pointed_curve_extension (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hDimB₂ : topologicalKrullDim B₂.left = (m : WithBot ℕ∞))
    (hU₂ : Nonempty U₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX₂ : AlgebraicGeometry.IsIntegral X₂.left)
    (hProjX₂ : IsProjectiveOverField k X₂)
    (hDimX₂ : topologicalKrullDim X₂.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ) :
    ∃ (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₃ : B₃.left.Opens)
      (ψ₃ : B₃ ⟶ B₂)
      (C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (g₃ : C₃ ⟶ B₃)
      (τ₃ : Fin n → (B₃ ⟶ C₃)),
      AlgebraicGeometry.IsIntegral B₃.left ∧
      IsProjectiveOverField k B₃ ∧
      topologicalKrullDim B₃.left = (m : WithBot ℕ∞) ∧
      Nonempty U₃ ∧
      IsGenFiniteEtaleAlterationOver k ψ₃ ∧
      (U₃ : Set B₃.left) ⊆ ψ₃.left.base ⁻¹' (U₂ : Set B₂.left) ∧
      IsSemistablePointedCurveOver k g₃ U₃ n τ₃ ∧
      AlgebraicGeometry.IsIntegral C₃.left ∧
      IsProjectiveOverField k C₃ ∧
      HasOpenPointedCurvePullbackIsoOver k f₂ σ ψ₃ U₃ g₃ τ₃ :=
by
  obtain ⟨K₀, instFieldK₀, instAlgkK₀, η₀, hη₀_hom, hFuncK₀,
      K, instFieldK, instSepClosedK, instAlgkK, instAlgK₀K, instTowerkK₀K, instSepClosK₀K, hTrK,
      C_K, p_K, ι_K, σ_K, M_K, ι_proj,
      F, instFieldF, instAlgkF, instAlgKF, instTowerkKF, η_F,
      hPbK, hσK, hIntCK, hPropCK, hSmCK, hStabCK, hClProj, hProjComm, hηF_comm, hFuncF⟩ :=
    weil_threeSecant_generic_smooth_curve_setup k m B₂ U₂ hIntB₂ hProjB₂ hDimB₂ hU₂
      X₂ hIntX₂ hProjX₂ hDimX₂ f₂ n σ hFib₂
  letI : Field K₀ := instFieldK₀
  letI : Algebra k K₀ := instAlgkK₀
  letI : Field K := instFieldK
  letI : IsSepClosed K := instSepClosedK
  letI : Algebra k K := instAlgkK
  letI : Algebra K₀ K := instAlgK₀K
  letI : IsScalarTower k K₀ K := instTowerkK₀K
  letI : IsSepClosure K₀ K := instSepClosK₀K
  letI : Field F := instFieldF
  letI : Algebra k F := instAlgkF
  letI : Algebra K F := instAlgKF
  letI : IsScalarTower k K F := instTowerkKF
  have hUnif :=
    weil_valued_curve_functionField_uniformization k m K hTrK C_K p_K hIntCK hPropCK hSmCK
      F η_F hηF_comm hFuncF
  have hValExt :=
    weil_valuationSubring_pointed_stable_curve_extension k m K hTrK C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK M_K ι_proj hClProj hProjComm F η_F hηF_comm hFuncF hUnif
  obtain ⟨B₃, U₃, ψ₃, N, W, C_loc, g_loc, τ_loc,
      hIntB₃, hProjB₃, hDimB₃, hNormB₃, hU₃, hψ₃, hU₃Sub, hCover, hWNonempty, hStabLoc, hIsoLoc⟩ :=
    weil_riemannZariski_spreadOut_normal_base_cover k m B₂ U₂ hIntB₂ hProjB₂ hDimB₂ hU₂
      X₂ hIntX₂ hProjX₂ f₂ n σ hFib₂ K₀ η₀ hη₀_hom hFuncK₀ K C_K p_K ι_K σ_K hPbK hσK hValExt
  obtain ⟨C₃, g₃, τ₃, hStab₃, hIntC₃, hProjC₃, hIso₃⟩ :=
    weil_normal_base_stable_curve_gluing_and_projectivity k B₂ U₂ X₂ f₂ n σ hFib₂
      B₃ U₃ ψ₃ hIntB₃ hProjB₃ hNormB₃ hU₃ hU₃Sub N W hCover hWNonempty C_loc g_loc τ_loc hStabLoc hIsoLoc
  have hCurve₃ : IsSemistablePointedCurveOver k g₃ U₃ n τ₃ :=
    weil_geometric_stable_curve_to_semistablePointedCurveOver k B₂ X₂ B₃ C₃ U₂ f₂ n σ hFib₂
      hProjB₃ hProjC₃ ψ₃ U₃ hU₃Sub g₃ τ₃ hStab₃ hIso₃
  exact ⟨B₃, U₃, ψ₃, C₃, g₃, τ₃, hIntB₃, hProjB₃, hDimB₃, hU₃, hψ₃, hU₃Sub,
    hCurve₃, hIntC₃, hProjC₃, hIso₃⟩

theorem weil_projectiveOverField_noetherianSpace_and_isSeparated (k : Type u) [Field k]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProj : IsProjectiveOverField k Y) :
    TopologicalSpace.NoetherianSpace ↥Y.left ∧ AlgebraicGeometry.IsSeparated Y.hom :=
by
  obtain ⟨N, ι, hCl⟩ := hProj
  have _ : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hSep_PN : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k N).hom := by
    change AlgebraicGeometry.IsSeparated
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
    infer_instance
  have hSep_Y : AlgebraicGeometry.IsSeparated Y.hom := by
    have _ : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k N).hom := hSep_PN
    rw [← CategoryTheory.Over.w ι]
    infer_instance
  have _ : IsScalarTower k (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k) :=
    ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
  have _ : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k)
  have h_surj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
    intro x
    have hx : (x : MvPolynomial (Fin (N + 1)) k) ∈
        (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero]
      exact x.2
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hx
    refine ⟨c, Subtype.ext ?_⟩
    rw [Algebra.algebraMap_eq_smul_one]
    change c • (1 : MvPolynomial (Fin (N + 1)) k) = (x : MvPolynomial (Fin (N + 1)) k)
    rw [← Algebra.algebraMap_eq_smul_one]
    exact hc
  have _ : IsNoetherianRing ↥(𝒜 0) :=
    isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) h_surj
  have _ : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
  have hNoeth_PN : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left := by
    change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left := hNoeth_PN
  have hNoeth_Y : TopologicalSpace.NoetherianSpace ↥Y.left :=
    ι.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  exact ⟨hNoeth_Y, hSep_Y⟩

theorem weil_immersion_schematic_image_integral_and_open_iso (V Y : AlgebraicGeometry.Scheme.{u})
    [TopologicalSpace.NoetherianSpace ↥V]
    [AlgebraicGeometry.IsIntegral V]
    (q : V ⟶ Y)
    [AlgebraicGeometry.IsImmersion q]
    (W : Y.Opens)
    (hSub : Set.range q.base ⊆ (W : Set ↥Y))
    (hRelCl : ∃ Z : Set ↥Y, IsClosed Z ∧ Z ∩ (W : Set ↥Y) = Set.range q.base) :
    AlgebraicGeometry.IsIntegral q.image ∧
    AlgebraicGeometry.IsClosedImmersion q.imageι ∧
    AlgebraicGeometry.IsOpenImmersion q.toImage ∧
    Set.range q.toImage.base =
      (((TopologicalSpace.Opens.map q.imageι.base).obj W : q.image.Opens) : Set ↥q.image) :=
by
  have _ : AlgebraicGeometry.QuasiCompact q :=
    AlgebraicGeometry.quasiCompact_of_noetherianSpace_source q
  have hCl : AlgebraicGeometry.IsClosedImmersion q.imageι := inferInstance
  have hDom : AlgebraicGeometry.IsDominant q.toImage := inferInstance
  have hOpen : AlgebraicGeometry.IsOpenImmersion q.toImage := inferInstance
  let 𝒰 : q.image.OpenCover := q.ker.subschemeCover.openCover
  have _ : ∀ U : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X U) := by
    intro U
    change AlgebraicGeometry.IsReduced
      (AlgebraicGeometry.Spec (CommRingCat.of (↑(Y.presheaf.obj (Opposite.op U.1)) ⧸ q.ker.ideal U)))
    rw [AlgebraicGeometry.affine_isReduced_iff]
    dsimp only [CommRingCat.coe_of]
    rw [q.ker_apply U]
    have _ : AlgebraicGeometry.IsReduced V := AlgebraicGeometry.isReduced_of_isIntegral V
    exact _root_.isReduced_of_injective (RingHom.kerLift (CommRingCat.Hom.hom (q.app U.1)))
      (RingHom.kerLift_injective (CommRingCat.Hom.hom (q.app U.1)))
  have _ : AlgebraicGeometry.IsReduced q.image :=
    AlgebraicGeometry.IsReduced.of_openCover q.image 𝒰
  have hIrrV : IrreducibleSpace ↥V := AlgebraicGeometry.irreducibleSpace_of_isIntegral V
  obtain ⟨v₀⟩ := hIrrV.toNonempty
  have hPreRange : IsPreirreducible (Set.range ⇑q.toImage) := by
    rw [← Set.image_univ]
    exact hIrrV.isPreirreducible_univ.image _ q.toImage.continuous.continuousOn
  have hPreUniv : IsPreirreducible (Set.univ : Set ↥q.image) := by
    have hcl := hPreRange.closure
    rwa [hDom.denseRange.closure_range] at hcl
  have _ : IrreducibleSpace ↥q.image :=
    { isPreirreducible_univ := hPreUniv
      toNonempty := ⟨q.toImage v₀⟩ }
  have hInt : AlgebraicGeometry.IsIntegral q.image :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced q.image
  obtain ⟨Z, hZ_cl, hZW⟩ := hRelCl
  have hRange_ι : Set.range ⇑q.imageι = closure (Set.range ⇑q) := by
    change Set.range ⇑q.ker.subschemeι = closure (Set.range ⇑q)
    rw [q.ker.range_subschemeι, q.support_ker]
  have hRange : Set.range q.toImage.base =
      (((TopologicalSpace.Opens.map q.imageι.base).obj W : q.image.Opens) : Set ↥q.image) := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      change q.imageι.base (q.toImage.base v) ∈ (W : Set ↥Y)
      have hv_eq : q.imageι.base (q.toImage.base v) = q.base v := by
        calc q.imageι.base (q.toImage.base v)
            = (q.toImage ≫ q.imageι).base v := rfl
          _ = q.base v := by rw [q.toImage_imageι]
      rw [hv_eq]
      exact hSub ⟨v, rfl⟩
    · intro hxW
      have hxW' : q.imageι.base x ∈ (W : Set ↥Y) := hxW
      have hClosSub : closure (Set.range q.base) ⊆ Z :=
        closure_minimal (hZW ▸ Set.inter_subset_left) hZ_cl
      have hxRange : q.imageι.base x ∈ Set.range ⇑q.imageι := ⟨x, rfl⟩
      rw [hRange_ι] at hxRange
      have hxZ : q.imageι.base x ∈ Z := hClosSub hxRange
      have hxZW : q.imageι.base x ∈ Set.range q.base := by
        rw [← hZW]
        exact ⟨hxZ, hxW'⟩
      obtain ⟨v, hv⟩ := hxZW
      refine ⟨v, ?_⟩
      apply q.imageι.isClosedEmbedding.injective
      calc q.imageι (q.toImage.base v)
          = (q.toImage ≫ q.imageι).base v := rfl
        _ = q.base v := by rw [q.toImage_imageι]
        _ = q.imageι x := hv
  exact ⟨hInt, hCl, hOpen, hRange⟩

theorem weil_open_graph_lift_isImmersion_and_relClosed {C X B : AlgebraicGeometry.Scheme.{u}}
    (g : C ⟶ B) (p : X ⟶ B)
    [AlgebraicGeometry.IsSeparated p]
    (V : C.Opens)
    (e : V.toScheme ⟶ X)
    (he : V.ι ≫ g = e ≫ p) :
    let δ : V.toScheme ⟶ CategoryTheory.Limits.pullback g p :=
      CategoryTheory.Limits.pullback.lift V.ι e he
    let W : (CategoryTheory.Limits.pullback g p).Opens :=
      (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g p).base).obj V
    AlgebraicGeometry.IsImmersion δ ∧
    Set.range δ.base ⊆ (W : Set ↥(CategoryTheory.Limits.pullback g p)) ∧
    ∃ Z : Set ↥(CategoryTheory.Limits.pullback g p),
      IsClosed Z ∧ Z ∩ (W : Set ↥(CategoryTheory.Limits.pullback g p)) = Set.range δ.base :=
by
  intro δ W
  let P_T : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g p
  let π_C : P_T ⟶ C := CategoryTheory.Limits.pullback.fst g p
  have hδ_fst : δ ≫ π_C = V.ι := CategoryTheory.Limits.pullback.lift_fst V.ι e he
  have _ : AlgebraicGeometry.IsImmersion (δ ≫ π_C) := by
    rw [hδ_fst]
    infer_instance
  have hImm : AlgebraicGeometry.IsImmersion δ :=
    AlgebraicGeometry.IsImmersion.of_comp δ π_C
  have hSub : Set.range δ.base ⊆ (W : Set ↥P_T) := by
    rintro _ ⟨v, rfl⟩
    change (δ ≫ π_C).base v ∈ (V : Set ↥C)
    rw [hδ_fst, ← V.range_ι]
    exact ⟨v, rfl⟩
  let P_TU : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback π_C V.ι
  let j_open : P_TU ⟶ P_T := CategoryTheory.Limits.pullback.fst π_C V.ι
  let p_V : P_TU ⟶ V.toScheme := CategoryTheory.Limits.pullback.snd π_C V.ι
  have hRange_j : Set.range j_open.base = (W : Set ↥P_T) := by
    change Set.range (CategoryTheory.Limits.pullback.fst π_C V.ι).base = π_C.base ⁻¹' (V : Set ↥C)
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst, V.range_ι]
  let γ_e : V.toScheme ⟶ P_TU :=
    CategoryTheory.Limits.pullback.lift δ (𝟙 V.toScheme)
      (by rw [hδ_fst, CategoryTheory.Category.id_comp])
  have hγ_j : γ_e ≫ j_open = δ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hγ_snd : γ_e ≫ p_V = 𝟙 V.toScheme := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have _ : AlgebraicGeometry.IsClosedImmersion (γ_e ≫ p_V) := by
    rw [hγ_snd]
    infer_instance
  have _ : AlgebraicGeometry.IsClosedImmersion γ_e :=
    AlgebraicGeometry.IsClosedImmersion.of_comp γ_e p_V
  obtain ⟨Z, hZ_cl, hZ_pre⟩ :=
    j_open.isOpenEmbedding.toIsEmbedding.toIsInducing.isClosed_iff.mp
      γ_e.isClosedEmbedding.isClosed_range
  refine ⟨hImm, hSub, Z, hZ_cl, ?_⟩
  ext y
  constructor
  · rintro ⟨hyZ, hyW⟩
    have hy_j : y ∈ Set.range j_open.base := by
      rw [hRange_j]
      exact hyW
    obtain ⟨u, rfl⟩ := hy_j
    have hu : u ∈ Set.range γ_e.base := by
      rw [← hZ_pre]
      exact hyZ
    obtain ⟨v, rfl⟩ := hu
    refine ⟨v, ?_⟩
    rw [← hγ_j]
    rfl
  · rintro ⟨v, rfl⟩
    refine ⟨?_, hSub ⟨v, rfl⟩⟩
    have hv_pre : γ_e.base v ∈ j_open.base ⁻¹' Z := by
      rw [hZ_pre]
      exact ⟨v, rfl⟩
    change (γ_e ≫ j_open).base v ∈ Z at hv_pre
    rwa [hγ_j] at hv_pre

theorem weil_algClosed_open_iso_strict_transform_correspondence (k : Type u) [Field k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjX₂ : IsProjectiveOverField k X₂)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₃ : B₃.left.Opens)
    (ψ₃ : B₃ ⟶ B₂)
    (hProjB₃ : IsProjectiveOverField k B₃)
    (hU₃ : Nonempty U₃)
    (C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g₃ : C₃ ⟶ B₃)
    (τ₃ : Fin n → (B₃ ⟶ C₃))
    (hCurve₃ : IsSemistablePointedCurveOver k g₃ U₃ n τ₃)
    (hIntC₃ : AlgebraicGeometry.IsIntegral C₃.left)
    (hProjC₃ : IsProjectiveOverField k C₃)
    (hIso₃ : HasOpenPointedCurvePullbackIsoOver k f₂ σ ψ₃ U₃ g₃ τ₃) :
    ∃ (X₃ T₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (pX₃ : X₃ ⟶ B₃) (qX₃ : X₃ ⟶ X₂)
      (pT₃ : T₃ ⟶ B₃) (rC₃ : T₃ ⟶ C₃) (rX₃ : T₃ ⟶ X₃),
      IsOpenGraphStrictTransformPairOver k f₂ σ ψ₃ U₃ g₃ τ₃ pX₃ qX₃ pT₃ rC₃ rX₃ :=
by
  
  let V₃_C : C₃.left.Opens := (TopologicalSpace.Opens.map g₃.left.base).obj U₃
  have _ : AlgebraicGeometry.Flat g₃.left := hCurve₃.1
  have hSurj_g₃ : AlgebraicGeometry.Surjective g₃.left := hCurve₃.2.2.2.1
  have _ : AlgebraicGeometry.Surjective g₃.left := hSurj_g₃
  have _ : AlgebraicGeometry.IsIntegral C₃.left := hIntC₃
  have hNonempty_VC : Nonempty ↥V₃_C.toScheme := by
    obtain ⟨⟨u₀, hu₀⟩⟩ := hU₃
    obtain ⟨c₀, hc₀⟩ := hSurj_g₃.surj u₀
    exact ⟨⟨c₀, by change g₃.left.base c₀ ∈ U₃; rw [hc₀]; exact hu₀⟩⟩
  have _ : Nonempty ↥V₃_C.toScheme := hNonempty_VC
  have _ : AlgebraicGeometry.IsIntegral V₃_C.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion V₃_C.ι
  obtain ⟨hNoeth_C₃, _⟩ :=
    weil_projectiveOverField_noetherianSpace_and_isSeparated k C₃ hProjC₃
  have _ : TopologicalSpace.NoetherianSpace ↥C₃.left := hNoeth_C₃
  have _ : TopologicalSpace.NoetherianSpace ↥V₃_C.toScheme :=
    V₃_C.ι.isOpenEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have _ : AlgebraicGeometry.Flat (g₃.left ∣_ U₃) := inferInstance
  have _ : AlgebraicGeometry.Surjective (g₃.left ∣_ U₃) := by
    refine ⟨fun ⟨y, hy⟩ => ?_⟩
    obtain ⟨x, hx⟩ := hSurj_g₃.surj y
    let v : ↥V₃_C.toScheme := ⟨x, by simpa [V₃_C, hx] using hy⟩
    exact ⟨v, Subtype.ext ((AlgebraicGeometry.morphismRestrict_base_coe g₃.left U₃ v).trans hx)⟩
  
  obtain ⟨ι₃, hcomm₃, hOpen_q₃, hRange_q₃, hs₃⟩ := hIso₃
  let P_X_sch := CategoryTheory.Limits.pullback f₂.left ψ₃.left
  let q₃ : V₃_C.toScheme ⟶ P_X_sch :=
    CategoryTheory.Limits.pullback.lift ι₃ (V₃_C.ι ≫ g₃.left) hcomm₃
  have hq₃_fst : q₃ ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left = ι₃ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq₃_snd : q₃ ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left = V₃_C.ι ≫ g₃.left :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  let W₃_pb : P_X_sch.Opens :=
    (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base).obj U₃
  have _ : AlgebraicGeometry.IsOpenImmersion q₃ := hOpen_q₃
  have hRange_q₃' : Set.range q₃.base = (W₃_pb : Set ↥P_X_sch) := hRange_q₃
  obtain ⟨hIntX₃, hClX₃, hOpen_eX₃, hRange_eX₃⟩ :=
    weil_immersion_schematic_image_integral_and_open_iso V₃_C.toScheme P_X_sch q₃ W₃_pb
      hRange_q₃'.subset ⟨Set.univ, isClosed_univ, by rw [Set.univ_inter, hRange_q₃']⟩
  let P_X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left ≫ B₃.hom)
  let p_PX : P_X ⟶ B₃ :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left) rfl
  let q_PX : P_X ⟶ X₂ :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left) (by
      dsimp [P_X]
      rw [← CategoryTheory.Over.w f₂, ← Category.assoc,
        CategoryTheory.Limits.pullback.condition, Category.assoc, CategoryTheory.Over.w ψ₃])
  obtain ⟨N_PX, ι_PX, hCl_PX⟩ :=
    weil_projectiveOverField_pullback k f₂ ψ₃ p_PX q_PX
      (CategoryTheory.IsPullback.of_hasPullback f₂.left ψ₃.left) hProjB₂ hProjX₂ hProjB₃
  let X₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (q₃.imageι ≫ P_X.hom)
  let ι_X₃_PX : X₃ ⟶ P_X := CategoryTheory.Over.homMk q₃.imageι rfl
  let pX₃ : X₃ ⟶ B₃ := ι_X₃_PX ≫ p_PX
  let qX₃ : X₃ ⟶ X₂ := ι_X₃_PX ≫ q_PX
  have _ : AlgebraicGeometry.IsClosedImmersion q₃.imageι := hClX₃
  have _ : AlgebraicGeometry.IsClosedImmersion ι_PX.left := hCl_PX
  have hProjX₃ : IsProjectiveOverField k X₃ :=
    ⟨N_PX, ι_X₃_PX ≫ ι_PX, by change AlgebraicGeometry.IsClosedImmersion (q₃.imageι ≫ ι_PX.left); infer_instance⟩
  let V₃_X : X₃.left.Opens := pX₃.left ⁻¹ᵁ U₃
  have _ : AlgebraicGeometry.IsOpenImmersion q₃.toImage := hOpen_eX₃
  have hRange_eX₃' : Set.range q₃.toImage.base = Set.range V₃_X.ι.base := by
    rw [V₃_X.range_ι]
    exact hRange_eX₃
  let α_X : V₃_C.toScheme ≅ V₃_X.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq q₃.toImage V₃_X.ι hRange_eX₃'
  let V_resX : q₃.image.Opens := q₃.imageι ⁻¹ᵁ W₃_pb
  have hRange_resX : Set.range q₃.toImage.base = Set.range V_resX.ι.base := by
    rw [V_resX.range_ι]
    exact hRange_eX₃
  let α_resX : V₃_C.toScheme ≅ V_resX.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq q₃.toImage V_resX.ι hRange_resX
  let α_W : V₃_C.toScheme ≅ W₃_pb.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq q₃ W₃_pb.ι (hRange_q₃'.trans W₃_pb.range_ι.symm)
  have hcommX : qX₃.left ≫ f₂.left = pX₃.left ≫ ψ₃.left := by
    change (q₃.imageι ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left) ≫ f₂.left =
      (q₃.imageι ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left) ≫ ψ₃.left
    rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc]
  have hLiftX : CategoryTheory.Limits.pullback.lift qX₃.left pX₃.left hcommX = q₃.imageι := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    · exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hIso_resX : CategoryTheory.IsIso (q₃.imageι ∣_ W₃_pb) := by
    have hfac : α_resX.hom ≫ (q₃.imageι ∣_ W₃_pb) = α_W.hom := by
      rw [← cancel_mono W₃_pb.ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← Category.assoc, AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac,
        q₃.toImage_imageι, AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
    have h_eq : q₃.imageι ∣_ W₃_pb = (α_resX.symm ≪≫ α_W).hom := by
      dsimp only [Iso.trans_hom, Iso.symm_hom]
      rw [← hfac, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
    rw [h_eq]
    infer_instance
  have hFac_pX₃ : pX₃.left ∣_ U₃ = α_X.inv ≫ (g₃.left ∣_ U₃) := by
    have h1 : α_X.hom ≫ (pX₃.left ∣_ U₃) = g₃.left ∣_ U₃ := by
      rw [← cancel_mono U₃.ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      change q₃.toImage ≫ q₃.imageι ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left =
        V₃_C.ι ≫ g₃.left
      rw [← Category.assoc, q₃.toImage_imageι, hq₃_snd]
    rw [← h1, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
  have hFlat_pX₃ : AlgebraicGeometry.Flat (pX₃.left ∣_ U₃) := by
    rw [hFac_pX₃]; infer_instance
  have hSurj_pX₃ : AlgebraicGeometry.Surjective (pX₃.left ∣_ U₃) := by
    rw [hFac_pX₃]; infer_instance
  
  obtain ⟨_, hSep_X₃⟩ :=
    weil_projectiveOverField_noetherianSpace_and_isSeparated k X₃ hProjX₃
  have _ : AlgebraicGeometry.IsSeparated pX₃.left := by
    have _ : AlgebraicGeometry.IsSeparated (pX₃.left ≫ B₃.hom) := by
      rw [CategoryTheory.Over.w pX₃]
      exact hSep_X₃
    exact AlgebraicGeometry.IsSeparated.of_comp pX₃.left B₃.hom
  have h_δ : V₃_C.ι ≫ g₃.left = q₃.toImage ≫ pX₃.left := by
    change V₃_C.ι ≫ g₃.left =
      q₃.toImage ≫ q₃.imageι ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left
    rw [← Category.assoc, q₃.toImage_imageι, hq₃_snd]
  let P_T_sch := CategoryTheory.Limits.pullback g₃.left pX₃.left
  let δ₃ : V₃_C.toScheme ⟶ P_T_sch :=
    CategoryTheory.Limits.pullback.lift V₃_C.ι q₃.toImage h_δ
  have hδ₃_fst : δ₃ ≫ CategoryTheory.Limits.pullback.fst g₃.left pX₃.left = V₃_C.ι :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hδ₃_snd : δ₃ ≫ CategoryTheory.Limits.pullback.snd g₃.left pX₃.left = q₃.toImage :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  let W_T : P_T_sch.Opens :=
    (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g₃.left pX₃.left).base).obj V₃_C
  obtain ⟨hImm_δ₃, hSub_δ₃, hRelCl_δ₃⟩ :=
    weil_open_graph_lift_isImmersion_and_relClosed g₃.left pX₃.left V₃_C q₃.toImage h_δ
  have _ : AlgebraicGeometry.IsImmersion δ₃ := hImm_δ₃
  obtain ⟨hIntT₃, hClT₃, hOpen_eT₃, hRange_eT₃⟩ :=
    weil_immersion_schematic_image_integral_and_open_iso V₃_C.toScheme P_T_sch δ₃ W_T
      hSub_δ₃ hRelCl_δ₃
  let P_T : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.fst g₃.left pX₃.left ≫ C₃.hom)
  let rC_PT : P_T ⟶ C₃ :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst g₃.left pX₃.left) rfl
  let rX_PT : P_T ⟶ X₃ :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd g₃.left pX₃.left) (by
      dsimp [P_T]
      rw [← CategoryTheory.Over.w pX₃, ← Category.assoc,
        ← CategoryTheory.Limits.pullback.condition, Category.assoc, CategoryTheory.Over.w g₃])
  obtain ⟨N_PT, ι_PT, hCl_PT⟩ :=
    weil_projectiveOverField_pullback k g₃ pX₃ rX_PT rC_PT
      (CategoryTheory.IsPullback.of_hasPullback g₃.left pX₃.left) hProjB₃ hProjC₃ hProjX₃
  let T₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (δ₃.imageι ≫ P_T.hom)
  let ι_T₃_PT : T₃ ⟶ P_T := CategoryTheory.Over.homMk δ₃.imageι rfl
  let rC₃ : T₃ ⟶ C₃ := ι_T₃_PT ≫ rC_PT
  let rX₃ : T₃ ⟶ X₃ := ι_T₃_PT ≫ rX_PT
  let pT₃ : T₃ ⟶ B₃ := rC₃ ≫ g₃
  have _ : AlgebraicGeometry.IsClosedImmersion δ₃.imageι := hClT₃
  have _ : AlgebraicGeometry.IsClosedImmersion ι_PT.left := hCl_PT
  have hProjT₃ : IsProjectiveOverField k T₃ :=
    ⟨N_PT, ι_T₃_PT ≫ ι_PT, by change AlgebraicGeometry.IsClosedImmersion (δ₃.imageι ≫ ι_PT.left); infer_instance⟩
  have hcommT : rC₃.left ≫ g₃.left = rX₃.left ≫ pX₃.left := by
    change (δ₃.imageι ≫ CategoryTheory.Limits.pullback.fst g₃.left pX₃.left) ≫ g₃.left =
      (δ₃.imageι ≫ CategoryTheory.Limits.pullback.snd g₃.left pX₃.left) ≫ pX₃.left
    rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc]
  have hLiftT : CategoryTheory.Limits.pullback.lift rC₃.left rX₃.left hcommT = δ₃.imageι := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    · exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  
  let V₃_T : T₃.left.Opens := pT₃.left ⁻¹ᵁ U₃
  have _ : AlgebraicGeometry.IsOpenImmersion δ₃.toImage := hOpen_eT₃
  have hRange_eT₃' : Set.range δ₃.toImage.base = Set.range V₃_T.ι.base := by
    rw [V₃_T.range_ι]
    exact hRange_eT₃
  let α_T : V₃_C.toScheme ≅ V₃_T.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq δ₃.toImage V₃_T.ι hRange_eT₃'
  let V_resC : T₃.left.Opens := rC₃.left ⁻¹ᵁ V₃_C
  have hRange_resC : Set.range δ₃.toImage.base = Set.range V_resC.ι.base := by
    rw [V_resC.range_ι]
    exact hRange_eT₃
  let α_resC : V₃_C.toScheme ≅ V_resC.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq δ₃.toImage V_resC.ι hRange_resC
  have hIso_rC₃ : CategoryTheory.IsIso (rC₃.left ∣_ V₃_C) := by
    have hfac : α_resC.hom ≫ (rC₃.left ∣_ V₃_C) = 𝟙 V₃_C.toScheme := by
      rw [← cancel_mono V₃_C.ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        Category.id_comp, ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      change δ₃.toImage ≫ δ₃.imageι ≫ CategoryTheory.Limits.pullback.fst g₃.left pX₃.left = V₃_C.ι
      rw [← Category.assoc, δ₃.toImage_imageι, hδ₃_fst]
    have h_eq : rC₃.left ∣_ V₃_C = α_resC.symm.hom := by
      dsimp only [Iso.symm_hom]
      rw [← Category.comp_id α_resC.inv, ← hfac, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
    rw [h_eq]
    infer_instance
  have hFac_pT₃ : pT₃.left ∣_ U₃ = α_T.inv ≫ (g₃.left ∣_ U₃) := by
    have h1 : α_T.hom ≫ (pT₃.left ∣_ U₃) = g₃.left ∣_ U₃ := by
      rw [← cancel_mono U₃.ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      change δ₃.toImage ≫ (δ₃.imageι ≫ CategoryTheory.Limits.pullback.fst g₃.left pX₃.left) ≫ g₃.left =
        V₃_C.ι ≫ g₃.left
      rw [← Category.assoc, ← Category.assoc, δ₃.toImage_imageι, hδ₃_fst]
    rw [← h1, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
  have hFlat_pT₃ : AlgebraicGeometry.Flat (pT₃.left ∣_ U₃) := by
    rw [hFac_pT₃]; infer_instance
  have hSurj_pT₃ : AlgebraicGeometry.Surjective (pT₃.left ∣_ U₃) := by
    rw [hFac_pT₃]; infer_instance
  let V'₃_T : T₃.left.Opens := rX₃.left ⁻¹ᵁ V₃_X
  have hVT_eq : (V'₃_T : Set ↥T₃.left) = (V₃_T : Set ↥T₃.left) := by
    have h_comp : rX₃.left ≫ pX₃.left = pT₃.left := hcommT.symm
    change ((TopologicalSpace.Opens.map (rX₃.left ≫ pX₃.left).base).obj U₃ : Set ↥T₃.left) =
      ((TopologicalSpace.Opens.map pT₃.left.base).obj U₃ : Set ↥T₃.left)
    rw [h_comp]
  have hRange_eT₃'' : Set.range δ₃.toImage.base = Set.range V'₃_T.ι.base := by
    rw [V'₃_T.range_ι, hVT_eq, ← V₃_T.range_ι]
    exact hRange_eT₃'
  let α'_T : V₃_C.toScheme ≅ V'₃_T.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq δ₃.toImage V'₃_T.ι hRange_eT₃''
  have hIso_rX₃ : CategoryTheory.IsIso (rX₃.left ∣_ V₃_X) := by
    have hfac : α'_T.hom ≫ (rX₃.left ∣_ V₃_X) = α_X.hom := by
      rw [← cancel_mono V₃_X.ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← Category.assoc, AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      change δ₃.toImage ≫ δ₃.imageι ≫ CategoryTheory.Limits.pullback.snd g₃.left pX₃.left =
        q₃.toImage
      rw [← Category.assoc, δ₃.toImage_imageι, hδ₃_snd]
    have h_eq : rX₃.left ∣_ V₃_X = (α'_T.symm ≪≫ α_X).hom := by
      dsimp only [Iso.trans_hom, Iso.symm_hom]
      rw [← hfac, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
    rw [h_eq]
    infer_instance
  refine ⟨X₃, T₃, pX₃, qX₃, pT₃, rC₃, rX₃, hIntX₃, hProjX₃, hFlat_pX₃, hSurj_pX₃,
    hIntT₃, hProjT₃, hFlat_pT₃, hSurj_pT₃, ⟨hcommX, ?_, ?_⟩, ⟨hcommT, rfl, ?_⟩,
    hIso_rC₃, hIso_rX₃, ?_⟩
  · rw [hLiftX]; exact hClX₃
  · rw [hLiftX]; exact hIso_resX
  · rw [hLiftT]; exact hClT₃
  · intro j
    obtain ⟨s₃, hs₃_C, hs₃_X⟩ := hs₃ j
    refine ⟨s₃ ≫ α_T.hom, ?_, ?_⟩
    · rw [Category.assoc, ← Category.assoc α_T.hom,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      change s₃ ≫ δ₃.toImage ≫ δ₃.imageι ≫ CategoryTheory.Limits.pullback.fst g₃.left pX₃.left =
        U₃.ι ≫ (τ₃ j).left
      rw [← Category.assoc δ₃.toImage, δ₃.toImage_imageι, hδ₃_fst, hs₃_C]
    · rw [Category.assoc, ← Category.assoc α_T.hom,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      change s₃ ≫ δ₃.toImage ≫ (δ₃.imageι ≫ CategoryTheory.Limits.pullback.snd g₃.left pX₃.left) ≫
        (q₃.imageι ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left) =
        U₃.ι ≫ ψ₃.left ≫ (σ j).left
      rw [← Category.assoc δ₃.toImage, ← Category.assoc δ₃.toImage, δ₃.toImage_imageι,
        hδ₃_snd, ← Category.assoc q₃.toImage, q₃.toImage_imageι, hq₃_fst, hs₃_X]

theorem weil_macaulay_hilbert_persistence_bound (N : ℕ) (K : Type u) [Field K]
    (I_η : Ideal (MvPolynomial (Fin (N + 1)) K)) :
    ∃ d₀ : ℕ, 1 ≤ d₀ ∧
      ∀ (F : Type u) [Field F]
        (J : Ideal (MvPolynomial (Fin (N + 1)) F)),
        Module.finrank F
          (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d₀) ⧸
            (J.restrictScalars F).comap
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d₀).subtype) ≤
        Module.finrank K
          (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀) ⧸
            (I_η.restrictScalars K).comap
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀).subtype) →
        ∀ d : ℕ, d₀ ≤ d →
          Module.finrank F
            (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d) ⧸
              (J.restrictScalars F).comap
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d).subtype) ≤
          Module.finrank K
            (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) ⧸
              (I_η.restrictScalars K).comap
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype) :=
by
  have toLex_lt_iff_fin : ∀ {n : ℕ} {a b : Fin n → ℕ},
      toLex a < toLex b ↔ ∃ p : Fin n, (∀ k < p, a k = b k) ∧ a p < b p :=
    fun {_} {_} {_} => Iff.rfl

  have mem_weilMonomialSet_iff : ∀ (n d : ℕ) (u : Fin n → ℕ),
      u ∈ weilMonomialSet n d ↔ ∑ i : Fin n, u i = d := by
    intro n d u
    constructor
    · exact fun h => (Finset.mem_filter.mp h).2
    · intro h
      refine Finset.mem_filter.mpr ⟨Fintype.mem_piFinset.mpr fun i => Finset.mem_range.mpr ?_, h⟩
      have hi : u i ≤ ∑ j : Fin n, u j :=
        Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      omega

  have update_pred_mem_weilMonomialSet : ∀ {n d : ℕ} {w : Fin n → ℕ},
      w ∈ weilMonomialSet n (d + 1) → ∀ (i : Fin n), 1 ≤ w i →
      Function.update w i (w i - 1) ∈ weilMonomialSet n d := by
    intro n d w hw i hi
    rw [mem_weilMonomialSet_iff] at hw ⊢
    rw [Finset.sum_update_of_mem (Finset.mem_univ i), Finset.sdiff_singleton_eq_erase]
    have herase := Finset.add_sum_erase Finset.univ w (Finset.mem_univ i)
    omega

  have insertNth_self_succAbove_eq : ∀ {m : ℕ} (idx : Fin (m + 1)) (f : Fin (m + 1) → ℕ),
      idx.insertNth (f idx) (fun j => f (idx.succAbove j)) = f := by
    intro m idx f
    ext i
    by_cases hi : i = idx
    · subst hi; simp
    · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq_iff.mpr hi
      simp

  
  have s1_initial_monomial_reduction : ∀ (M_N : ℕ) (L : Type u) [Field L]
      (J : Ideal (MvPolynomial (Fin (M_N + 1)) L)),
      ∃ 𝒪 : ℕ → Finset (Fin (M_N + 1) → ℕ),
        (∀ d : ℕ, 𝒪 d ⊆ weilMonomialSet (M_N + 1) d) ∧
        (∀ d : ℕ, (𝒪 d).card =
          Module.finrank L
            (↥(MvPolynomial.homogeneousSubmodule (Fin (M_N + 1)) L d) ⧸
              (J.restrictScalars L).comap
                (MvPolynomial.homogeneousSubmodule (Fin (M_N + 1)) L d).subtype)) ∧
        (∀ d : ℕ, 𝒪 (d + 1) ⊆ weilUpperShadow (M_N + 1) d (𝒪 d)) := by
    intro M_N L _ J
    classical
    let σ := Fin (M_N + 1)
    have : WellFoundedGT σ := Finite.to_wellFoundedGT
    let ord : MonomialOrder σ := MonomialOrder.lex
    let e_fun : (σ →₀ ℕ) ≃ (σ → ℕ) := Finsupp.equivFunOnFinite
    let V (d : ℕ) := MvPolynomial.homogeneousSubmodule σ L d
    let W (d : ℕ) : Submodule L ↥(V d) := (J.restrictScalars L).comap (V d).subtype
    let P (d : ℕ) (u : σ → ℕ) : Prop :=
      ¬ ∃ f : ↥(V d), f ∈ W d ∧ f.1 ≠ 0 ∧ e_fun (ord.degree f.1) = u
    let 𝒪 (d : ℕ) : Finset (σ → ℕ) := (weilMonomialSet (M_N + 1) d).filter (P d)
    have hFinsuppDeg : ∀ (β : σ →₀ ℕ), β.degree = ∑ i : σ, e_fun β i := by
      intro β
      rw [Finsupp.degree_eq_weight_one, Finsupp.weight_apply]
      have h1 : (β.sum fun _ a => a • (1 : ℕ)) = ∑ i ∈ β.support, β i := by
        simp [Finsupp.sum]
      rw [h1]
      exact Finset.sum_subset (Finset.subset_univ _) fun x _ hx => Finsupp.notMem_support_iff.mp hx
    refine ⟨𝒪, ?_, ?_, ?_⟩
    · intro d
      exact Finset.filter_subset _ _
    · intro d
      let α : ↥(𝒪 d) → (σ →₀ ℕ) := fun u => e_fun.symm u.1
      have hα_inj : Function.Injective α := fun u₁ u₂ h => Subtype.ext (e_fun.symm.injective h)
      have hm_hom : ∀ u : ↥(𝒪 d), MvPolynomial.monomial (α u) (1 : L) ∈ V d := by
        intro u
        rw [MvPolynomial.mem_homogeneousSubmodule]
        refine MvPolynomial.isHomogeneous_monomial _ ?_
        rw [hFinsuppDeg]
        have hu_sum : ∑ i : σ, u.1 i = d :=
          (mem_weilMonomialSet_iff (M_N + 1) d u.1).mp (Finset.mem_filter.mp u.2).1
        simpa [α] using hu_sum
      let m_sub : ↥(𝒪 d) → ↥(V d) := fun u => ⟨MvPolynomial.monomial (α u) (1 : L), hm_hom u⟩
      let b : ↥(𝒪 d) → (↥(V d) ⧸ W d) := fun u => (W d).mkQ (m_sub u)
      have hli : LinearIndependent L b := by
        rw [Fintype.linearIndependent_iff]
        intro c hc
        have hmk : (W d).mkQ (∑ u : ↥(𝒪 d), c u • m_sub u) = 0 := by
          rw [map_sum]
          simpa [map_smul, b] using hc
        have hg_W : (∑ u : ↥(𝒪 d), c u • m_sub u) ∈ W d :=
          (Submodule.Quotient.mk_eq_zero (W d)).mp hmk
        let g_sub : ↥(V d) := ∑ u : ↥(𝒪 d), c u • m_sub u
        let g_poly : MvPolynomial σ L := g_sub.1
        have hg_val : g_poly = ∑ u : ↥(𝒪 d), MvPolynomial.monomial (α u) (c u) := by
          calc g_poly
              = ∑ u : ↥(𝒪 d), (c u • m_sub u).1 := Submodule.coe_sum _ _ _
            _ = ∑ u : ↥(𝒪 d), c u • MvPolynomial.monomial (α u) (1 : L) := rfl
            _ = ∑ u : ↥(𝒪 d), MvPolynomial.monomial (α u) (c u) := by
                  refine Finset.sum_congr rfl fun u _ => ?_
                  rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
        have hcoeff_α : ∀ u : ↥(𝒪 d), g_poly.coeff (α u) = c u := by
          intro u
          rw [hg_val, MvPolynomial.coeff_sum]
          rw [Finset.sum_eq_single u]
          · simp [MvPolynomial.coeff_monomial]
          · intro u' _ hu'
            have hne : α u' ≠ α u := fun h => hu' (hα_inj h)
            simp [MvPolynomial.coeff_monomial, hne]
          · intro hu_abs
            exact False.elim (hu_abs (Finset.mem_univ u))
        have hg_zero : g_poly = 0 := by
          by_contra hg_ne
          have hmem_supp : ord.degree g_poly ∈ g_poly.support :=
            ord.degree_mem_support hg_ne
          have hcoeff_ne : g_poly.coeff (ord.degree g_poly) ≠ 0 :=
            MvPolynomial.mem_support_iff.mp hmem_supp
          have hex_u : ∃ u₀ : ↥(𝒪 d), α u₀ = ord.degree g_poly := by
            by_contra hno
            let β₀ := ord.degree g_poly
            have hne_all : ∀ u : ↥(𝒪 d), α u ≠ β₀ := fun u h => hno ⟨u, h⟩
            apply hcoeff_ne
            change g_poly.coeff β₀ = 0
            rw [hg_val, MvPolynomial.coeff_sum]
            refine Finset.sum_eq_zero fun u _ => ?_
            simp [MvPolynomial.coeff_monomial, hne_all u]
          obtain ⟨u₀, hu₀⟩ := hex_u
          have hu₀_P : P d u₀.1 := (Finset.mem_filter.mp u₀.2).2
          apply hu₀_P
          refine ⟨g_sub, hg_W, hg_ne, ?_⟩
          change e_fun (ord.degree g_poly) = u₀.1
          rw [← hu₀]
          simp [α]
        intro u
        have := hcoeff_α u
        rw [hg_zero] at this
        simpa using this.symm
      have hspan : ⊤ ≤ Submodule.span L (Set.range b) := by
        intro q _
        refine Submodule.Quotient.induction_on (W d) q fun h => ?_
        have h_ind : ∀ (s : ord.syn), ∀ (h : ↥(V d)),
            ord.toSyn (ord.degree h.1) = s →
            (W d).mkQ h ∈ Submodule.span L (Set.range b) := by
          intro s
          refine WellFoundedLT.induction s
            (motive := fun s => ∀ (h : ↥(V d)),
              ord.toSyn (ord.degree h.1) = s →
              (W d).mkQ h ∈ Submodule.span L (Set.range b))
            fun s ih h hs => ?_
          by_cases hh0 : h.1 = 0
          · have hh_sub : h = 0 := Subtype.ext hh0
            rw [hh_sub, map_zero]
            exact Submodule.zero_mem _
          · let β := ord.degree h.1
            let u_h := e_fun β
            have hβ_supp : β ∈ h.1.support := ord.degree_mem_support hh0
            have ha_ne : h.1.coeff β ≠ 0 := MvPolynomial.mem_support_iff.mp hβ_supp
            have hu_mon : u_h ∈ weilMonomialSet (M_N + 1) d := by
              rw [mem_weilMonomialSet_iff]
              have hdeg_β : β.degree = d := by
                rw [Finsupp.degree_eq_weight_one]
                exact h.2 ha_ne
              rwa [hFinsuppDeg] at hdeg_β
            by_cases hP : P d u_h
            · let u₀ : ↥(𝒪 d) := ⟨u_h, Finset.mem_filter.mpr ⟨hu_mon, hP⟩⟩
              have hα_u₀ : α u₀ = β := e_fun.symm_apply_apply β
              let a := h.1.coeff β
              let h' : ↥(V d) := h - a • m_sub u₀
              have h_decomp : (W d).mkQ h = a • b u₀ + (W d).mkQ h' := by
                have : h = a • m_sub u₀ + h' := (add_sub_cancel _ _).symm
                conv_lhs => rw [this]
                rw [map_add, map_smul]
              rw [h_decomp]
              refine Submodule.add_mem _ (Submodule.smul_mem _ a (Submodule.subset_span ⟨u₀, rfl⟩)) ?_
              by_cases hh'0 : h'.1 = 0
              · have hh'_sub : h' = 0 := Subtype.ext hh'0
                rw [hh'_sub, map_zero]
                exact Submodule.zero_mem _
              · have hlt : ord.toSyn (ord.degree h'.1) < s := by
                  rw [← hs]
                  let γ := ord.degree h'.1
                  have hγ_ne : h'.1.coeff γ ≠ 0 :=
                    MvPolynomial.mem_support_iff.mp (ord.degree_mem_support hh'0)
                  have hcoeff_h' : ∀ δ : σ →₀ ℕ, h'.1.coeff δ =
                      h.1.coeff δ - a * (MvPolynomial.monomial β (1 : L)).coeff δ := by
                    intro δ
                    change (h.1 - a • MvPolynomial.monomial (α u₀) (1 : L)).coeff δ = _
                    rw [hα_u₀, MvPolynomial.coeff_sub, MvPolynomial.coeff_smul, smul_eq_mul]
                  have hle : ord.toSyn γ ≤ ord.toSyn β := by
                    by_contra hgt
                    rw [not_le] at hgt
                    have hc1 : h.1.coeff γ = 0 := ord.coeff_eq_zero_of_lt hgt
                    have hne_γβ : β ≠ γ := fun heq => lt_irrefl _ (heq ▸ hgt)
                    have hc2 : (MvPolynomial.monomial β (1 : L)).coeff γ = 0 := by
                      simp [MvPolynomial.coeff_monomial, hne_γβ]
                    apply hγ_ne
                    rw [hcoeff_h', hc1, hc2, mul_zero, sub_zero]
                  have hne : ord.toSyn γ ≠ ord.toSyn β := by
                    intro heq
                    have hγβ : γ = β := ord.toSyn.injective heq
                    apply hγ_ne
                    rw [hγβ, hcoeff_h']
                    simp [MvPolynomial.coeff_monomial, a]
                  exact lt_of_le_of_ne hle hne
                exact ih _ hlt h' rfl
            · simp only [P, not_not] at hP
              obtain ⟨f, hf_W, hf0, hf_deg⟩ := hP
              have hdeg_eq : ord.degree f.1 = β := e_fun.injective hf_deg
              let a := h.1.coeff β
              let cf := f.1.coeff β
              have hcf_ne : cf ≠ 0 := by
                have : ord.degree f.1 ∈ f.1.support := ord.degree_mem_support hf0
                rw [hdeg_eq] at this
                exact MvPolynomial.mem_support_iff.mp this
              let lam := a * cf⁻¹
              let h' : ↥(V d) := h - lam • f
              have hmk_eq : (W d).mkQ h = (W d).mkQ h' := by
                change Submodule.Quotient.mk h = Submodule.Quotient.mk h'
                rw [Submodule.Quotient.eq]
                have : h - h' = lam • f := by simp [h']
                rw [this]
                exact Submodule.smul_mem (W d) lam hf_W
              rw [hmk_eq]
              by_cases hh'0 : h'.1 = 0
              · have hh'_sub : h' = 0 := Subtype.ext hh'0
                rw [hh'_sub, map_zero]
                exact Submodule.zero_mem _
              · have hlt : ord.toSyn (ord.degree h'.1) < s := by
                  rw [← hs]
                  let γ := ord.degree h'.1
                  have hγ_ne : h'.1.coeff γ ≠ 0 :=
                    MvPolynomial.mem_support_iff.mp (ord.degree_mem_support hh'0)
                  have hcoeff_h' : ∀ δ : σ →₀ ℕ, h'.1.coeff δ =
                      h.1.coeff δ - lam * f.1.coeff δ := by
                    intro δ
                    change (h.1 - lam • f.1).coeff δ = _
                    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_smul, smul_eq_mul]
                  have hle : ord.toSyn γ ≤ ord.toSyn β := by
                    by_contra hgt
                    rw [not_le] at hgt
                    have hc1 : h.1.coeff γ = 0 := ord.coeff_eq_zero_of_lt hgt
                    have hc2 : f.1.coeff γ = 0 := by
                      apply ord.coeff_eq_zero_of_lt
                      rwa [hdeg_eq]
                    apply hγ_ne
                    rw [hcoeff_h', hc1, hc2, mul_zero, sub_zero]
                  have hne : ord.toSyn γ ≠ ord.toSyn β := by
                    intro heq
                    have hγβ : γ = β := ord.toSyn.injective heq
                    apply hγ_ne
                    rw [hγβ, hcoeff_h']
                    change a - a * cf⁻¹ * cf = 0
                    rw [inv_mul_cancel_right₀ hcf_ne, sub_self]
                  exact lt_of_le_of_ne hle hne
                exact ih _ hlt h' rfl
        exact h_ind _ h rfl
      let B : Module.Basis ↥(𝒪 d) L (↥(V d) ⧸ W d) := Module.Basis.mk hli hspan
      rw [Module.finrank_eq_card_basis B, Fintype.card_coe]
    · intro d w hw
      obtain ⟨hw_mon, hw_P⟩ := Finset.mem_filter.mp hw
      refine Finset.mem_filter.mpr ⟨hw_mon, fun i hi => ?_⟩
      let u := Function.update w i (w i - 1)
      have hu_mon : u ∈ weilMonomialSet (M_N + 1) d := update_pred_mem_weilMonomialSet hw_mon i hi
      refine Finset.mem_filter.mpr ⟨hu_mon, ?_⟩
      rintro ⟨f, hf_W, hf0, hf_deg⟩
      let g₁ : MvPolynomial σ L := MvPolynomial.X i * f.1
      have hg₁_hom : g₁ ∈ V (d + 1) := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have h1 : g₁.IsHomogeneous (1 + d) := (MvPolynomial.isHomogeneous_X L i).mul f.2
        rwa [Nat.add_comm] at h1
      have hg₁_J : g₁ ∈ J := Ideal.mul_mem_left J (MvPolynomial.X i) hf_W
      have hg₁_ne : g₁ ≠ 0 := mul_ne_zero (MvPolynomial.X_ne_zero i) hf0
      apply hw_P
      refine ⟨⟨g₁, hg₁_hom⟩, hg₁_J, hg₁_ne, ?_⟩
      have hdeg_g₁ : ord.degree g₁ = Finsupp.single i 1 + ord.degree f.1 := by
        change ord.degree (MvPolynomial.X i * f.1) = _
        rw [ord.degree_mul (MvPolynomial.X_ne_zero i) hf0, ord.degree_X]
      ext k
      rw [hdeg_g₁]
      change (Finsupp.single i 1 : σ →₀ ℕ) k + (ord.degree f.1) k = w k
      have hfk : (ord.degree f.1) k = u k := congr_fun hf_deg k
      rw [hfk]
      by_cases hki : k = i
      · subst hki
        simp [u]
        omega
      · simp [u, hki]

  
  have s2_lexInitSeg_shadow_properties : ∀ (m : ℕ),
      (∀ (d : ℕ) {u v : Fin (m + 1) → ℕ},
        u ∈ weilMonomialSet (m + 1) d → v ∈ weilMonomialSet (m + 1) d →
        (toLex v < toLex u ↔ weilLexRank (m + 1) d v < weilLexRank (m + 1) d u)) ∧
      (∀ (d c : ℕ), (weilLexInitSeg (m + 1) d c).card = min c (weilMonomialSet (m + 1) d).card) ∧
      (∀ (d c₁ c₂ : ℕ), c₁ ≤ c₂ → weilLexInitSeg (m + 1) d c₁ ⊆ weilLexInitSeg (m + 1) d c₂) ∧
      (∀ (d : ℕ) (S : Finset (Fin (m + 1) → ℕ)),
        S ⊆ weilMonomialSet (m + 1) d →
        (∀ u ∈ S, ∀ v ∈ weilMonomialSet (m + 1) d, toLex v < toLex u → v ∈ S) →
        S = weilLexInitSeg (m + 1) d S.card) ∧
      (∀ (d c : ℕ),
        weilUpperShadow (m + 1) d (weilLexInitSeg (m + 1) d c) =
          weilLexInitSeg (m + 1) (d + 1)
            (weilUpperShadow (m + 1) d (weilLexInitSeg (m + 1) d c)).card) ∧
      (∀ (d c : ℕ),
        (weilLexInitSeg (m + 1) d c).card ≤
          (weilUpperShadow (m + 1) d (weilLexInitSeg (m + 1) d c)).card) ∧
      (∀ (d c : ℕ),
        c < (weilMonomialSet (m + 1) d).card →
        ∃ u ∈ weilMonomialSet (m + 1) d,
          weilLexRank (m + 1) d u = c ∧
          (weilUpperShadow (m + 1) d (weilLexInitSeg (m + 1) d c)).card <
            (weilMonomialSet (m + 1) (d + 1)).card ∧
          weilLexRank (m + 1) (d + 1) (Function.update u (Fin.last m) (u (Fin.last m) + 1)) =
            (weilUpperShadow (m + 1) d (weilLexInitSeg (m + 1) d c)).card) := by
    intro m
    classical
    let n := m + 1
    have hRank_eq : ∀ (d : ℕ) (u : Fin n → ℕ),
        weilLexRank n d u = ((weilMonomialSet n d).filter (fun v => toLex v < toLex u)).card := by
      intro d u
      unfold weilLexRank
      congr 1
    have hOrder : ∀ (d : ℕ) {u v : Fin n → ℕ},
        u ∈ weilMonomialSet n d → v ∈ weilMonomialSet n d →
        (toLex v < toLex u ↔ weilLexRank n d v < weilLexRank n d u) := by
      intro d u v hu hv
      rw [hRank_eq, hRank_eq]
      constructor
      · intro hvu
        refine Finset.card_lt_card ⟨?_, ?_⟩
        · intro w hw
          obtain ⟨hw_m, hw_lt⟩ := Finset.mem_filter.mp hw
          exact Finset.mem_filter.mpr ⟨hw_m, lt_trans hw_lt hvu⟩
        · intro hsub
          have hv_in : v ∈ (weilMonomialSet n d).filter (fun w => toLex w < toLex u) :=
            Finset.mem_filter.mpr ⟨hv, hvu⟩
          have hv_lt := (Finset.mem_filter.mp (hsub hv_in)).2
          exact lt_irrefl _ hv_lt
      · intro hcard
        by_contra hnot
        have huv : toLex u ≤ toLex v := le_of_not_gt hnot
        have hle : ((weilMonomialSet n d).filter (fun w => toLex w < toLex v)).card ≥
            ((weilMonomialSet n d).filter (fun w => toLex w < toLex u)).card := by
          refine Finset.card_le_card fun w hw => ?_
          obtain ⟨hw_m, hw_lt⟩ := Finset.mem_filter.mp hw
          exact Finset.mem_filter.mpr ⟨hw_m, lt_of_lt_of_le hw_lt huv⟩
        omega
    have hRank_lt_card : ∀ (d : ℕ) {u : Fin n → ℕ},
        u ∈ weilMonomialSet n d → weilLexRank n d u < (weilMonomialSet n d).card := by
      intro d u hu
      rw [hRank_eq]
      refine Finset.card_lt_card ⟨Finset.filter_subset _ _, ?_⟩
      intro hsub
      have := (Finset.mem_filter.mp (hsub hu)).2
      exact lt_irrefl _ this
    have hRank_inj : ∀ (d : ℕ), Set.InjOn (weilLexRank n d) ↑(weilMonomialSet n d) := by
      intro d u₁ hu₁ u₂ hu₂ heq
      rcases lt_trichotomy (toLex u₁) (toLex u₂) with hlt | heq_lex | hgt
      · have := (hOrder d hu₂ hu₁).mp hlt
        omega
      · exact ofLex_inj.mp heq_lex
      · have := (hOrder d hu₁ hu₂).mp hgt
        omega
    have hRank_img : ∀ (d : ℕ),
        (weilMonomialSet n d).image (weilLexRank n d) = Finset.range (weilMonomialSet n d).card := by
      intro d
      refine Finset.eq_of_subset_of_card_le ?_ ?_
      · intro r hr
        obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hr
        exact Finset.mem_range.mpr (hRank_lt_card d hu)
      · rw [Finset.card_image_of_injOn (hRank_inj d), Finset.card_range]
    have hCard : ∀ (d c : ℕ),
        (weilLexInitSeg n d c).card = min c (weilMonomialSet n d).card := by
      intro d c
      have hinj : Set.InjOn (weilLexRank n d) ↑(weilLexInitSeg n d c) :=
        (hRank_inj d).mono (Finset.filter_subset _ _)
      rw [← Finset.card_image_of_injOn hinj]
      have himg : (weilLexInitSeg n d c).image (weilLexRank n d) =
          Finset.range (min c (weilMonomialSet n d).card) := by
        ext r
        simp only [Finset.mem_image, Finset.mem_range, lt_min_iff]
        constructor
        · rintro ⟨u, hu, rfl⟩
          obtain ⟨hu_m, hu_lt⟩ := Finset.mem_filter.mp hu
          exact ⟨hu_lt, hRank_lt_card d hu_m⟩
        · rintro ⟨hrc, hrM⟩
          have hr_in : r ∈ (weilMonomialSet n d).image (weilLexRank n d) := by
            rw [hRank_img d]
            exact Finset.mem_range.mpr hrM
          obtain ⟨u, hu_m, rfl⟩ := Finset.mem_image.mp hr_in
          exact ⟨u, Finset.mem_filter.mpr ⟨hu_m, hrc⟩, rfl⟩
      rw [himg, Finset.card_range]
    have hMono : ∀ (d c₁ c₂ : ℕ), c₁ ≤ c₂ → weilLexInitSeg n d c₁ ⊆ weilLexInitSeg n d c₂ := by
      intro d c₁ c₂ hle u hu
      obtain ⟨hu_m, hu_lt⟩ := Finset.mem_filter.mp hu
      exact Finset.mem_filter.mpr ⟨hu_m, lt_of_lt_of_le hu_lt hle⟩
    have hDown : ∀ (d : ℕ) (S : Finset (Fin n → ℕ)),
        S ⊆ weilMonomialSet n d →
        (∀ u ∈ S, ∀ v ∈ weilMonomialSet n d, toLex v < toLex u → v ∈ S) →
        S = weilLexInitSeg n d S.card := by
      intro d S hSub hClosed
      have hS_le : S.card ≤ (weilMonomialSet n d).card := Finset.card_le_card hSub
      have hL_card : (weilLexInitSeg n d S.card).card = S.card := by
        rw [hCard d S.card, min_eq_left hS_le]
      suffices hSubL : S ⊆ weilLexInitSeg n d S.card from
        Finset.eq_of_subset_of_card_le hSubL (le_of_eq hL_card)
      intro u huS
      refine Finset.mem_filter.mpr ⟨hSub huS, ?_⟩
      by_contra hge
      rw [not_lt] at hge
      have hsub_S : (weilMonomialSet n d).filter (fun v => toLex v < toLex u) ⊆ S.erase u := by
        intro v hv
        obtain ⟨hv_m, hv_lt⟩ := Finset.mem_filter.mp hv
        exact Finset.mem_erase.mpr ⟨fun heq => lt_irrefl _ (heq ▸ hv_lt), hClosed u huS v hv_m hv_lt⟩
      have hcard_lt : ((weilMonomialSet n d).filter (fun v => toLex v < toLex u)).card < S.card := by
        calc ((weilMonomialSet n d).filter (fun v => toLex v < toLex u)).card
            ≤ (S.erase u).card := Finset.card_le_card hsub_S
          _ < S.card := Finset.card_erase_lt_of_mem huS
      rw [← hRank_eq] at hcard_lt
      omega
    have hNoLastDiff : ∀ (e : ℕ) {a b : Fin n → ℕ},
        a ∈ weilMonomialSet n e → b ∈ weilMonomialSet n e →
        ∀ p : Fin n, (∀ k < p, a k = b k) → a p < b p → p ≠ Fin.last m := by
      intro e a b ha hb p hpref hp hlast
      have ha_sum := (mem_weilMonomialSet_iff n e a).mp ha
      have hb_sum := (mem_weilMonomialSet_iff n e b).mp hb
      rw [Fin.sum_univ_castSucc] at ha_sum hb_sum
      have hpref_sum : ∑ i : Fin m, a i.castSucc = ∑ i : Fin m, b i.castSucc := by
        refine Finset.sum_congr rfl fun i _ => hpref i.castSucc ?_
        rw [hlast]
        exact Fin.castSucc_lt_last i
      rw [hlast] at hp
      omega
    have hMaster : ∀ (d : ℕ) (u_star : Fin n → ℕ),
        u_star ∈ weilMonomialSet n d →
        let S := (weilMonomialSet n d).filter (fun u => toLex u < toLex u_star)
        let w_star := Function.update u_star (Fin.last m) (u_star (Fin.last m) + 1)
        w_star ∈ weilMonomialSet n (d + 1) ∧
        weilUpperShadow n d S =
          (weilMonomialSet n (d + 1)).filter (fun w => toLex w < toLex w_star) := by
      intro d u_star hu_star S w_star
      have hw_star_mon : w_star ∈ weilMonomialSet n (d + 1) := by
        rw [mem_weilMonomialSet_iff]
        have hu_sum := (mem_weilMonomialSet_iff n d u_star).mp hu_star
        rw [Fin.sum_univ_castSucc] at hu_sum ⊢
        have hcast : ∑ i : Fin m, w_star i.castSucc = ∑ i : Fin m, u_star i.castSucc := by
          refine Finset.sum_congr rfl fun i _ => ?_
          simp [w_star, Fin.castSucc_ne_last]
        rw [hcast]
        simp [w_star]
        omega
      refine ⟨hw_star_mon, ?_⟩
      ext w
      simp only [weilUpperShadow, Finset.mem_filter]
      constructor
      · rintro ⟨hw_mon, hw_sh⟩
        refine ⟨hw_mon, ?_⟩
        by_contra hnot_lt
        have hw_ge : toLex w_star ≤ toLex w := le_of_not_gt hnot_lt
        rcases lt_or_eq_of_le hw_ge with hw_gt | hw_eq
        · have hw_gt' : ∃ p : Fin n, (∀ k < p, w_star k = w k) ∧ w_star p < w p := hw_gt
          obtain ⟨p, hpref, hp⟩ := hw_gt'
          have hp_ne : p ≠ Fin.last m := hNoLastDiff (d + 1) hw_star_mon hw_mon p hpref hp
          have hp_lt_last : p < Fin.last m := lt_of_le_of_ne (Fin.le_last p) hp_ne
          have hwp_pos : 1 ≤ w p := Nat.succ_le_of_lt (lt_of_le_of_lt (Nat.zero_le _) hp)
          have hu_eq_wstar : ∀ k ≤ p, w_star k = u_star k := by
            intro k hk
            have hk_ne : k ≠ Fin.last m := ne_of_lt (lt_of_le_of_lt hk hp_lt_last)
            simp [w_star, hk_ne]
          by_cases hex : ∃ q : Fin n, p < q ∧ 1 ≤ w q
          · obtain ⟨q, hpq, hwq⟩ := hex
            let w' := Function.update w q (w q - 1)
            have hw'_S : w' ∈ S := hw_sh q hwq
            have hw'_lt : toLex w' < toLex u_star := (Finset.mem_filter.mp hw'_S).2
            have hu_lt_w' : toLex u_star < toLex w' := by
              rw [toLex_lt_iff_fin]
              refine ⟨p, ?_, ?_⟩
              · intro k hkp
                have hkq : k ≠ q := ne_of_lt (lt_trans hkp hpq)
                calc u_star k = w_star k := (hu_eq_wstar k (le_of_lt hkp)).symm
                  _ = w k := hpref k hkp
                  _ = w' k := by simp [w', hkq]
              · have hpq_ne : p ≠ q := ne_of_lt hpq
                calc u_star p = w_star p := (hu_eq_wstar p le_rfl).symm
                  _ < w p := hp
                  _ = w' p := by simp [w', hpq_ne]
            exact lt_asymm hw'_lt hu_lt_w'
          · have hw_zero_gt : ∀ q : Fin n, p < q → w q = 0 := by
              intro q hpq
              by_contra hne0
              exact hex ⟨q, hpq, Nat.pos_of_ne_zero hne0⟩
            let w' := Function.update w p (w p - 1)
            have hw'_S : w' ∈ S := hw_sh p hwp_pos
            obtain ⟨hw'_mon, hw'_lt⟩ := Finset.mem_filter.mp hw'_S
            have hw'_pref : ∀ k < p, w' k = u_star k := by
              intro k hkp
              have hkp_ne : k ≠ p := ne_of_lt hkp
              calc w' k = w k := by simp [w', hkp_ne]
                _ = w_star k := (hpref k hkp).symm
                _ = u_star k := hu_eq_wstar k (le_of_lt hkp)
            have hw'_gt_zero : ∀ q : Fin n, p < q → w' q = 0 := by
              intro q hpq
              have hqp : q ≠ p := ne_of_gt hpq
              simp [w', hqp, hw_zero_gt q hpq]
            have hw'_sum := (mem_weilMonomialSet_iff n d w').mp hw'_mon
            have hu_sum := (mem_weilMonomialSet_iff n d u_star).mp hu_star
            have hsplit : ∀ f : Fin n → ℕ, ∑ k : Fin n, f k =
                ∑ k ∈ Finset.univ.filter (· < p), f k + f p +
                ∑ k ∈ Finset.univ.filter (p < ·), f k := by
              intro f
              have h1 := Finset.add_sum_erase Finset.univ f (Finset.mem_univ p)
              have h2 : Finset.univ.erase p =
                  Finset.univ.filter (· < p) ∪ Finset.univ.filter (p < ·) := by
                ext k
                simp only [Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_union,
                  Finset.mem_filter, true_and]
                exact ne_iff_lt_or_gt
              have hdisj : Disjoint (Finset.univ.filter (· < p)) (Finset.univ.filter (p < ·)) := by
                rw [Finset.disjoint_filter]
                intro k _ h1 h2
                exact lt_asymm h1 h2
              rw [← h1, h2, Finset.sum_union hdisj]
              omega
            have hsum_lt_eq : ∑ k ∈ Finset.univ.filter (· < p), w' k =
                ∑ k ∈ Finset.univ.filter (· < p), u_star k :=
              Finset.sum_congr rfl fun k hk => hw'_pref k (Finset.mem_filter.mp hk).2
            have hsum_gt_w' : ∑ k ∈ Finset.univ.filter (p < ·), w' k = 0 :=
              Finset.sum_eq_zero fun k hk => hw'_gt_zero k (Finset.mem_filter.mp hk).2
            rw [hsplit w', hsum_lt_eq, hsum_gt_w', add_zero] at hw'_sum
            rw [hsplit u_star] at hu_sum
            have hw'p_eq_sum : w' p = u_star p + ∑ k ∈ Finset.univ.filter (p < ·), u_star k := by
              omega
            rw [toLex_lt_iff_fin] at hw'_lt
            obtain ⟨r, hr_pref, hr_lt⟩ := hw'_lt
            rcases lt_trichotomy r p with hrp | rfl | hpr
            · exact absurd (hw'_pref r hrp) (ne_of_lt hr_lt)
            · omega
            · have hwp_eq : w' p = u_star p := hr_pref p hpr
              have hsum_gt_u : ∑ k ∈ Finset.univ.filter (p < ·), u_star k = 0 := by omega
              have hur_zero : u_star r = 0 := by
                have hr_mem : r ∈ Finset.univ.filter (p < ·) :=
                  Finset.mem_filter.mpr ⟨Finset.mem_univ r, hpr⟩
                have := Finset.single_le_sum (f := u_star) (fun _ _ => Nat.zero_le _) hr_mem
                omega
              omega
        · have hw_eq' : w = w_star := (ofLex_inj.mp hw_eq).symm
          subst hw_eq'
          have hpos : 1 ≤ w_star (Fin.last m) := by simp [w_star]
          have hu_in_S : Function.update w_star (Fin.last m) (w_star (Fin.last m) - 1) ∈ S :=
            hw_sh (Fin.last m) hpos
          have hupd_eq : Function.update w_star (Fin.last m) (w_star (Fin.last m) - 1) = u_star := by
            ext k
            by_cases hk : k = Fin.last m
            · subst hk; simp [w_star]
            · simp [w_star, hk]
          rw [hupd_eq] at hu_in_S
          exact lt_irrefl _ (Finset.mem_filter.mp hu_in_S).2
      · rintro ⟨hw_mon, hw_lt⟩
        refine ⟨hw_mon, fun i hi => ?_⟩
        rw [toLex_lt_iff_fin] at hw_lt
        obtain ⟨p, hpref, hp⟩ := hw_lt
        have hp_ne : p ≠ Fin.last m := hNoLastDiff (d + 1) hw_mon hw_star_mon p hpref hp
        have hp_lt_last : p < Fin.last m := lt_of_le_of_ne (Fin.le_last p) hp_ne
        have hu_eq_wstar : ∀ k ≤ p, w_star k = u_star k := by
          intro k hk
          have hk_ne : k ≠ Fin.last m := ne_of_lt (lt_of_le_of_lt hk hp_lt_last)
          simp [w_star, hk_ne]
        let w' := Function.update w i (w i - 1)
        have hw'_mon : w' ∈ weilMonomialSet n d := update_pred_mem_weilMonomialSet hw_mon i hi
        refine Finset.mem_filter.mpr ⟨hw'_mon, ?_⟩
        rw [toLex_lt_iff_fin]
        by_cases hip : i < p
        · refine ⟨i, ?_, ?_⟩
          · intro k hki
            have hki_ne : k ≠ i := ne_of_lt hki
            calc w' k = w k := by simp [w', hki_ne]
              _ = w_star k := hpref k (lt_trans hki hip)
              _ = u_star k := hu_eq_wstar k (le_of_lt (lt_trans hki hip))
          · calc w' i = w i - 1 := by simp [w']
              _ < w i := by omega
              _ = w_star i := hpref i hip
              _ = u_star i := hu_eq_wstar i (le_of_lt hip)
        · have hpi : p ≤ i := le_of_not_gt hip
          refine ⟨p, ?_, ?_⟩
          · intro k hkp
            have hki_ne : k ≠ i := ne_of_lt (lt_of_lt_of_le hkp hpi)
            calc w' k = w k := by simp [w', hki_ne]
              _ = w_star k := hpref k hkp
              _ = u_star k := hu_eq_wstar k (le_of_lt hkp)
          · have hw'p_le : w' p ≤ w p := by
              by_cases hpeq : p = i
              · subst hpeq; simp [w']
              · simp [w', hpeq]
            calc w' p ≤ w p := hw'p_le
              _ < w_star p := hp
              _ = u_star p := hu_eq_wstar p le_rfl
    have hRankShift : ∀ (d c : ℕ),
        c < (weilMonomialSet n d).card →
        ∃ u ∈ weilMonomialSet n d,
          weilLexRank n d u = c ∧
          (weilUpperShadow n d (weilLexInitSeg n d c)).card < (weilMonomialSet n (d + 1)).card ∧
          weilLexRank n (d + 1) (Function.update u (Fin.last m) (u (Fin.last m) + 1)) =
            (weilUpperShadow n d (weilLexInitSeg n d c)).card := by
      intro d c hc
      have hc_in : c ∈ (weilMonomialSet n d).image (weilLexRank n d) := by
        rw [hRank_img d]
        exact Finset.mem_range.mpr hc
      obtain ⟨u, hu_mon, hu_rk⟩ := Finset.mem_image.mp hc_in
      have hL_eq : weilLexInitSeg n d c =
          (weilMonomialSet n d).filter (fun v => toLex v < toLex u) := by
        ext v
        simp only [weilLexInitSeg, Finset.mem_filter]
        refine and_congr_right fun hv_mon => ?_
        rw [← hu_rk]
        exact (hOrder d hu_mon hv_mon).symm
      obtain ⟨hw_mon, hSh_eq⟩ := hMaster d u hu_mon
      have hSh_eq' : weilUpperShadow n d (weilLexInitSeg n d c) =
          (weilMonomialSet n (d + 1)).filter
            (fun w => toLex w < toLex (Function.update u (Fin.last m) (u (Fin.last m) + 1))) := by
        rw [hL_eq]
        exact hSh_eq
      refine ⟨u, hu_mon, hu_rk, ?_, ?_⟩
      · rw [hSh_eq', ← hRank_eq]
        exact hRank_lt_card (d + 1) hw_mon
      · rw [hRank_eq, hSh_eq']
    have hFullSh : ∀ (d : ℕ),
        weilUpperShadow n d (weilMonomialSet n d) = weilMonomialSet n (d + 1) := by
      intro d
      ext w
      simp only [weilUpperShadow, Finset.mem_filter, and_iff_left_iff_imp]
      exact fun hw_mon i hi => update_pred_mem_weilMonomialSet hw_mon i hi
    have hInitSh : ∀ (d c : ℕ),
        weilUpperShadow n d (weilLexInitSeg n d c) =
          weilLexInitSeg n (d + 1) (weilUpperShadow n d (weilLexInitSeg n d c)).card := by
      intro d c
      by_cases hc : c < (weilMonomialSet n d).card
      · have hc_in : c ∈ (weilMonomialSet n d).image (weilLexRank n d) := by
          rw [hRank_img d]; exact Finset.mem_range.mpr hc
        obtain ⟨u, hu_mon, hu_rk⟩ := Finset.mem_image.mp hc_in
        have hL_eq : weilLexInitSeg n d c =
            (weilMonomialSet n d).filter (fun v => toLex v < toLex u) := by
          ext v; simp only [weilLexInitSeg, Finset.mem_filter]
          refine and_congr_right fun hv_mon => ?_
          rw [← hu_rk]; exact (hOrder d hu_mon hv_mon).symm
        obtain ⟨_, hSh_eq⟩ := hMaster d u hu_mon
        have hSh_eq' : weilUpperShadow n d (weilLexInitSeg n d c) =
            (weilMonomialSet n (d + 1)).filter
              (fun w => toLex w < toLex (Function.update u (Fin.last m) (u (Fin.last m) + 1))) := by
          rw [hL_eq]; exact hSh_eq
        refine hDown (d + 1) _ (Finset.filter_subset _ _) ?_
        rw [hSh_eq']
        intro w₁ hw₁ w₂ hw₂ hlt
        exact Finset.mem_filter.mpr ⟨hw₂, lt_trans hlt (Finset.mem_filter.mp hw₁).2⟩
      · have hc_ge : (weilMonomialSet n d).card ≤ c := le_of_not_gt hc
        have hL_full : weilLexInitSeg n d c = weilMonomialSet n d := by
          ext u; simp only [weilLexInitSeg, Finset.mem_filter, and_iff_left_iff_imp]
          intro hu; exact lt_of_lt_of_le (hRank_lt_card d hu) hc_ge
        rw [hL_full, hFullSh d]
        exact hDown (d + 1) _ (Finset.Subset.refl _) fun _ _ _ hv _ => hv
    have hGrow : ∀ (d c : ℕ),
        (weilLexInitSeg n d c).card ≤ (weilUpperShadow n d (weilLexInitSeg n d c)).card := by
      intro d c
      let f : (Fin n → ℕ) → (Fin n → ℕ) :=
        fun v => Function.update v (Fin.last m) (v (Fin.last m) + 1)
      have hf_inj : Function.Injective f := by
        intro v₁ v₂ heq
        ext k
        by_cases hk : k = Fin.last m
        · subst hk
          have := congr_fun heq (Fin.last m)
          simp [f] at this
          omega
        · have := congr_fun heq k
          simpa [f, hk] using this
      refine Finset.card_le_card_of_injOn f (fun v hv => ?_) (hf_inj.injOn)
      obtain ⟨hv_mon, hv_rk⟩ := Finset.mem_filter.mp hv
      have hfv_mon : f v ∈ weilMonomialSet n (d + 1) := (hMaster d v hv_mon).1
      by_cases hc : c < (weilMonomialSet n d).card
      · have hc_in : c ∈ (weilMonomialSet n d).image (weilLexRank n d) := by
          rw [hRank_img d]; exact Finset.mem_range.mpr hc
        obtain ⟨u, hu_mon, hu_rk⟩ := Finset.mem_image.mp hc_in
        have hL_eq : weilLexInitSeg n d c =
            (weilMonomialSet n d).filter (fun z => toLex z < toLex u) := by
          ext z; simp only [weilLexInitSeg, Finset.mem_filter]
          refine and_congr_right fun hz_mon => ?_
          rw [← hu_rk]; exact (hOrder d hu_mon hz_mon).symm
        obtain ⟨_, hSh_eq⟩ := hMaster d u hu_mon
        have hSh_eq' : weilUpperShadow n d (weilLexInitSeg n d c) =
            (weilMonomialSet n (d + 1)).filter
              (fun w => toLex w < toLex (Function.update u (Fin.last m) (u (Fin.last m) + 1))) := by
          rw [hL_eq]; exact hSh_eq
        rw [hSh_eq']
        refine Finset.mem_filter.mpr ⟨hfv_mon, ?_⟩
        have hvu : toLex v < toLex u := by
          rw [hOrder d hu_mon hv_mon, hu_rk]; exact hv_rk
        rw [toLex_lt_iff_fin] at hvu ⊢
        obtain ⟨p, hpref, hp⟩ := hvu
        have hp_ne : p ≠ Fin.last m := hNoLastDiff d hv_mon hu_mon p hpref hp
        have hp_lt_last : p < Fin.last m := lt_of_le_of_ne (Fin.le_last p) hp_ne
        refine ⟨p, ?_, ?_⟩
        · intro k hkp
          have hk_ne : k ≠ Fin.last m := ne_of_lt (lt_trans hkp hp_lt_last)
          simp [f, hk_ne, hpref k hkp]
        · simp [f, hp_ne, hp]
      · have hc_ge : (weilMonomialSet n d).card ≤ c := le_of_not_gt hc
        have hL_full : weilLexInitSeg n d c = weilMonomialSet n d := by
          ext u; simp only [weilLexInitSeg, Finset.mem_filter, and_iff_left_iff_imp]
          intro hu; exact lt_of_lt_of_le (hRank_lt_card d hu) hc_ge
        rw [hL_full, hFullSh d]
        exact hfv_mon
    exact ⟨hOrder, hCard, hMono, hDown, hInitSh, hGrow, hRankShift⟩

  
  have s3_slice_compression_fixed_point : ∀ (m d : ℕ) (ℱ : Finset (Fin (m + 2) → ℕ)),
      ℱ ⊆ weilMonomialSet (m + 2) d →
      (∀ (n e : ℕ) {u v : Fin (n + 1) → ℕ},
        u ∈ weilMonomialSet (n + 1) e → v ∈ weilMonomialSet (n + 1) e →
        (toLex v < toLex u ↔ weilLexRank (n + 1) e v < weilLexRank (n + 1) e u)) →
      (∀ (e c : ℕ),
        (weilLexInitSeg (m + 1) e c).card = min c (weilMonomialSet (m + 1) e).card) →
      (∀ (e c₁ c₂ : ℕ), c₁ ≤ c₂ → weilLexInitSeg (m + 1) e c₁ ⊆ weilLexInitSeg (m + 1) e c₂) →
      (∀ (e c : ℕ),
        weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e c) =
          weilLexInitSeg (m + 1) (e + 1)
            (weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e c)).card) →
      (∀ (e : ℕ) (𝒢 : Finset (Fin (m + 1) → ℕ)),
        𝒢 ⊆ weilMonomialSet (m + 1) e →
        (weilUpperShadow (m + 1) e 𝒢).card ≤
          (weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e 𝒢.card)).card) →
      ∃ ℱ_star : Finset (Fin (m + 2) → ℕ),
        ℱ_star ⊆ weilMonomialSet (m + 2) d ∧
        ℱ_star.card = ℱ.card ∧
        (weilUpperShadow (m + 2) d ℱ).card ≤ (weilUpperShadow (m + 2) d ℱ_star).card ∧
        IsWeilSliceCompressed (m + 1) ℱ_star := by
    intro m d ℱ hF hRank hCard hMono hInitSh hPrev
    classical
    let ins (idx : Fin (m + 2)) (a : ℕ) (g : Fin (m + 1) → ℕ) : Fin (m + 2) → ℕ :=
      idx.insertNth (α := fun _ => ℕ) a g
    have hInsSame : ∀ (idx : Fin (m + 2)) (a : ℕ) (g : Fin (m + 1) → ℕ),
        ins idx a g idx = a := by
      intro idx a g; simp [ins]
    have hInsSucc : ∀ (idx : Fin (m + 2)) (a : ℕ) (g : Fin (m + 1) → ℕ) (j : Fin (m + 1)),
        ins idx a g (idx.succAbove j) = g j := by
      intro idx a g j; simp [ins]
    let slice (idx : Fin (m + 2)) (e : ℕ) (ℬ : Finset (Fin (m + 2) → ℕ)) (a : ℕ) :
        Finset (Fin (m + 1) → ℕ) :=
      (weilMonomialSet (m + 1) (e - a)).filter (fun g => ins idx a g ∈ ℬ)
    have hInsInj : ∀ (idx : Fin (m + 2)) (a : ℕ),
        Function.Injective (ins idx a) := by
      intro idx a g₁ g₂ heq
      ext j
      have := congr_fun heq (idx.succAbove j)
      simpa [hInsSucc] using this
    have hInsMemMon : ∀ (idx : Fin (m + 2)) (e a : ℕ) (g : Fin (m + 1) → ℕ),
        a ≤ e → g ∈ weilMonomialSet (m + 1) (e - a) →
        ins idx a g ∈ weilMonomialSet (m + 2) e := by
      intro idx e a g ha hg
      rw [mem_weilMonomialSet_iff] at hg ⊢
      rw [Fin.sum_univ_succAbove _ idx]
      simp only [hInsSame, hInsSucc]
      omega
    have hBiUnionEq : ∀ (idx : Fin (m + 2)) (e : ℕ) (ℬ : Finset (Fin (m + 2) → ℕ)),
        ℬ ⊆ weilMonomialSet (m + 2) e →
        ℬ = (Finset.range (e + 1)).biUnion
          (fun a => (slice idx e ℬ a).image (ins idx a)) := by
      intro idx e ℬ hℬ
      ext w
      simp only [Finset.mem_biUnion, Finset.mem_range, Finset.mem_image, slice, Finset.mem_filter]
      constructor
      · intro hw
        have hw_sum := (mem_weilMonomialSet_iff (m + 2) e w).mp (hℬ hw)
        rw [Fin.sum_univ_succAbove w idx] at hw_sum
        let a := w idx
        let g : Fin (m + 1) → ℕ := fun j => w (idx.succAbove j)
        have ha_lt : a < e + 1 := by dsimp [a]; omega
        have hg_mon : g ∈ weilMonomialSet (m + 1) (e - a) := by
          rw [mem_weilMonomialSet_iff]
          dsimp [a, g]
          omega
        have hins : ins idx a g = w := insertNth_self_succAbove_eq idx w
        exact ⟨a, ha_lt, g, ⟨hg_mon, hins.symm ▸ hw⟩, hins⟩
      · rintro ⟨a, _, g, ⟨_, hg_in⟩, rfl⟩
        exact hg_in
    have hBiUnionDisj : ∀ (idx : Fin (m + 2)) (e : ℕ) (F_sl : ℕ → Finset (Fin (m + 1) → ℕ)),
        (↑(Finset.range (e + 1)) : Set ℕ).PairwiseDisjoint
          (fun a => (F_sl a).image (ins idx a)) := by
      intro idx e F_sl a₁ _ a₂ _ hne
      refine Finset.disjoint_left.mpr fun w hw₁ hw₂ => ?_
      obtain ⟨g₁, _, hg₁⟩ := Finset.mem_image.mp hw₁
      obtain ⟨g₂, _, hg₂⟩ := Finset.mem_image.mp hw₂
      apply hne
      have h1 : w idx = a₁ := by rw [← hg₁, hInsSame]
      have h2 : w idx = a₂ := by rw [← hg₂, hInsSame]
      exact h1.symm.trans h2
    have hCardSliceSum : ∀ (idx : Fin (m + 2)) (e : ℕ) (ℬ : Finset (Fin (m + 2) → ℕ)),
        ℬ ⊆ weilMonomialSet (m + 2) e →
        ℬ.card = ∑ a ∈ Finset.range (e + 1), (slice idx e ℬ a).card := by
      intro idx e ℬ hℬ
      conv_lhs => rw [hBiUnionEq idx e ℬ hℬ]
      rw [Finset.card_biUnion (hBiUnionDisj idx e (slice idx e ℬ))]
      refine Finset.sum_congr rfl fun a _ => Finset.card_image_of_injective _ (hInsInj idx a)
    have hSumSlice : ∀ (idx : Fin (m + 2)) (e : ℕ) (ℬ : Finset (Fin (m + 2) → ℕ))
        (wt : (Fin (m + 2) → ℕ) → ℕ),
        ℬ ⊆ weilMonomialSet (m + 2) e →
        ∑ w ∈ ℬ, wt w =
          ∑ a ∈ Finset.range (e + 1), ∑ g ∈ slice idx e ℬ a, wt (ins idx a g) := by
      intro idx e ℬ wt hℬ
      conv_lhs => rw [hBiUnionEq idx e ℬ hℬ]
      rw [Finset.sum_biUnion (hBiUnionDisj idx e (slice idx e ℬ))]
      refine Finset.sum_congr rfl fun a _ => ?_
      exact Finset.sum_image fun _ _ _ _ h => hInsInj idx a h
    let L_sl (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)) (a : ℕ) :
        Finset (Fin (m + 1) → ℕ) :=
      weilLexInitSeg (m + 1) (d - a) (slice idx d 𝒜 a).card
    let comp (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)) :
        Finset (Fin (m + 2) → ℕ) :=
      (Finset.range (d + 1)).biUnion (fun a => (L_sl idx 𝒜 a).image (ins idx a))
    have hCompSub : ∀ (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)),
        comp idx 𝒜 ⊆ weilMonomialSet (m + 2) d := by
      intro idx 𝒜 w hw
      obtain ⟨a, ha_r, w_im⟩ := Finset.mem_biUnion.mp hw
      obtain ⟨g, hg_L, rfl⟩ := Finset.mem_image.mp w_im
      exact hInsMemMon idx d a g (Nat.lt_succ_iff.mp (Finset.mem_range.mp ha_r))
        (Finset.mem_filter.mp hg_L).1
    have hSliceComp : ∀ (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)) (a : ℕ),
        a ≤ d → slice idx d (comp idx 𝒜) a = L_sl idx 𝒜 a := by
      intro idx 𝒜 a ha
      ext g
      simp only [slice, Finset.mem_filter, comp, Finset.mem_biUnion, Finset.mem_range,
        Finset.mem_image]
      constructor
      · rintro ⟨_, a', _, g', hg', heq⟩
        have ha_eq : a' = a := by
          have := congr_fun heq idx
          simpa [hInsSame] using this
        subst ha_eq
        have hg_eq : g' = g := hInsInj idx a' heq
        rwa [← hg_eq]
      · intro hg
        exact ⟨(Finset.mem_filter.mp hg).1, a, Nat.lt_succ_of_le ha, g, hg, rfl⟩
    have hLCardEq : ∀ (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)) (a : ℕ),
        (L_sl idx 𝒜 a).card = (slice idx d 𝒜 a).card := by
      intro idx 𝒜 a
      dsimp [L_sl]
      rw [hCard]
      exact min_eq_left (Finset.card_le_card (Finset.filter_subset _ _))
    have hCompCard : ∀ (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)),
        𝒜 ⊆ weilMonomialSet (m + 2) d → (comp idx 𝒜).card = 𝒜.card := by
      intro idx 𝒜 h𝒜
      rw [hCardSliceSum idx d (comp idx 𝒜) (hCompSub idx 𝒜), hCardSliceSum idx d 𝒜 h𝒜]
      refine Finset.sum_congr rfl fun a ha => ?_
      rw [hSliceComp idx 𝒜 a (Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)), hLCardEq]
    have hUpdInsSame : ∀ (idx : Fin (m + 2)) (b c : ℕ) (g : Fin (m + 1) → ℕ),
        Function.update (ins idx b g) idx c = ins idx c g := by
      intro idx b c g
      ext i
      by_cases hi : i = idx
      · subst hi; simp [hInsSame]
      · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq_iff.mpr hi
        simp [hi, hInsSucc]
    have hUpdInsSucc : ∀ (idx : Fin (m + 2)) (b c : ℕ) (g : Fin (m + 1) → ℕ) (j : Fin (m + 1)),
        Function.update (ins idx b g) (idx.succAbove j) c =
          ins idx b (Function.update g j c) := by
      intro idx b c g j
      ext i
      by_cases hi : i = idx
      · subst hi
        simp [(Fin.succAbove_ne i j).symm, hInsSame]
      · obtain ⟨j', rfl⟩ := Fin.exists_succAbove_eq_iff.mpr hi
        by_cases hjj : j' = j
        · subst hjj; simp [hInsSucc]
        · have hne : idx.succAbove j' ≠ idx.succAbove j :=
            fun h => hjj (idx.succAbove_right_injective h)
          simp [hne, hjj, hInsSucc]
    have hShSliceEq : ∀ (idx : Fin (m + 2)) (ℬ : Finset (Fin (m + 2) → ℕ)) (b : ℕ),
        b ≤ d + 1 →
        slice idx (d + 1) (weilUpperShadow (m + 2) d ℬ) b =
          if b = 0 then weilUpperShadow (m + 1) d (slice idx d ℬ 0)
          else if b = d + 1 then slice idx d ℬ d
          else slice idx d ℬ (b - 1) ∩ weilUpperShadow (m + 1) (d - b) (slice idx d ℬ b) := by
      intro idx ℬ b hb
      by_cases hb0 : b = 0
      · subst hb0
        simp only [↓reduceIte]
        ext g
        simp only [slice, weilUpperShadow, Finset.mem_filter]
        constructor
        · rintro ⟨hg_mon, _, hw_sh⟩
          have hg_mon' : g ∈ weilMonomialSet (m + 1) (d + 1) := by simpa using hg_mon
          refine ⟨hg_mon', fun j hj => ?_⟩
          have h1 : Function.update g j (g j - 1) ∈ weilMonomialSet (m + 1) (d - 0) :=
            update_pred_mem_weilMonomialSet hg_mon' j hj
          refine ⟨h1, ?_⟩
          have hj' : 1 ≤ ins idx 0 g (idx.succAbove j) := by rwa [hInsSucc]
          have h2 := hw_sh (idx.succAbove j) hj'
          rwa [hInsSucc, hUpdInsSucc] at h2
        · rintro ⟨hg_mon, hg_sh⟩
          have hg_mon0 : g ∈ weilMonomialSet (m + 1) (d + 1 - 0) := by simpa using hg_mon
          refine ⟨hg_mon0, hInsMemMon idx (d + 1) 0 g (Nat.zero_le _) hg_mon0, ?_⟩
          rw [Fin.forall_iff_succAbove idx]
          refine ⟨fun h10 => by rw [hInsSame] at h10; omega, fun j hj => ?_⟩
          rw [hInsSucc] at hj
          rw [hInsSucc, hUpdInsSucc]
          exact (hg_sh j hj).2
      · by_cases hbd1 : b = d + 1
        · subst hbd1
          simp only [hb0, ↓reduceIte]
          ext g
          have hsub0 : d + 1 - (d + 1) = d - d := by omega
          simp only [slice, weilUpperShadow, Finset.mem_filter]
          constructor
          · rintro ⟨hg_mon, _, hw_sh⟩
            have hg_mon' : g ∈ weilMonomialSet (m + 1) (d - d) := hsub0 ▸ hg_mon
            refine ⟨hg_mon', ?_⟩
            have h1 := hw_sh idx (by rw [hInsSame]; omega)
            rwa [hInsSame, Nat.add_sub_cancel, hUpdInsSame] at h1
          · rintro ⟨hg_mon, hg_in⟩
            have hg_mon0 : g ∈ weilMonomialSet (m + 1) (d + 1 - (d + 1)) := hsub0.symm ▸ hg_mon
            refine ⟨hg_mon0, hInsMemMon idx (d + 1) (d + 1) g le_rfl hg_mon0, ?_⟩
            rw [Fin.forall_iff_succAbove idx]
            refine ⟨fun _ => ?_, fun j hj => ?_⟩
            · rwa [hInsSame, Nat.add_sub_cancel, hUpdInsSame]
            · rw [hInsSucc] at hj
              have hgs := (mem_weilMonomialSet_iff (m + 1) 0 g).mp (by simpa using hg_mon)
              have hgj_le : g j ≤ ∑ k : Fin (m + 1), g k :=
                Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
              omega
        · simp only [hb0, hbd1, ↓reduceIte]
          have hb_pos : 1 ≤ b := by omega
          have hb_le_d : b ≤ d := by omega
          have he1 : d + 1 - b = d - (b - 1) := by omega
          have he2 : d + 1 - b = d - b + 1 := by omega
          ext g
          simp only [slice, weilUpperShadow, Finset.mem_inter, Finset.mem_filter]
          constructor
          · rintro ⟨hg_mon, _, hw_sh⟩
            refine ⟨⟨he1 ▸ hg_mon, ?_⟩, ⟨he2 ▸ hg_mon, fun j hj => ?_⟩⟩
            · have h1 := hw_sh idx (by rwa [hInsSame])
              rwa [hInsSame, hUpdInsSame] at h1
            · have hupd_mon : Function.update g j (g j - 1) ∈ weilMonomialSet (m + 1) (d - b) :=
                update_pred_mem_weilMonomialSet (he2 ▸ hg_mon) j hj
              refine ⟨hupd_mon, ?_⟩
              have hj' : 1 ≤ ins idx b g (idx.succAbove j) := by rwa [hInsSucc]
              have h2 := hw_sh (idx.succAbove j) hj'
              rwa [hInsSucc, hUpdInsSucc] at h2
          · rintro ⟨⟨hg_mon1, hg_b1⟩, ⟨_, hg_sh⟩⟩
            have hg_mon0 : g ∈ weilMonomialSet (m + 1) (d + 1 - b) := he1.symm ▸ hg_mon1
            refine ⟨hg_mon0, hInsMemMon idx (d + 1) b g hb hg_mon0, ?_⟩
            rw [Fin.forall_iff_succAbove idx]
            refine ⟨fun _ => ?_, fun j hj => ?_⟩
            · rwa [hInsSame, hUpdInsSame]
            · rw [hInsSucc] at hj
              rw [hInsSucc, hUpdInsSucc]
              exact (hg_sh j hj).2
    have hCompShLe : ∀ (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)),
        𝒜 ⊆ weilMonomialSet (m + 2) d →
        (weilUpperShadow (m + 2) d 𝒜).card ≤
          (weilUpperShadow (m + 2) d (comp idx 𝒜)).card := by
      intro idx 𝒜 h𝒜
      rw [hCardSliceSum idx (d + 1) (weilUpperShadow (m + 2) d 𝒜) (Finset.filter_subset _ _),
        hCardSliceSum idx (d + 1) (weilUpperShadow (m + 2) d (comp idx 𝒜)) (Finset.filter_subset _ _)]
      refine Finset.sum_le_sum fun b hb_r => ?_
      have hb : b ≤ d + 1 := Nat.lt_succ_iff.mp (Finset.mem_range.mp hb_r)
      rw [hShSliceEq idx 𝒜 b hb, hShSliceEq idx (comp idx 𝒜) b hb]
      by_cases hb0 : b = 0
      · subst hb0
        simp only [↓reduceIte]
        rw [hSliceComp idx 𝒜 0 (Nat.zero_le d)]
        exact hPrev d (slice idx d 𝒜 0) (Finset.filter_subset _ _)
      · by_cases hbd1 : b = d + 1
        · subst hbd1
          simp only [hb0, ↓reduceIte]
          rw [hSliceComp idx 𝒜 d le_rfl, hLCardEq]
        · simp only [hb0, hbd1, ↓reduceIte]
          have hb_pos : 1 ≤ b := by omega
          have hb_le_d : b ≤ d := by omega
          rw [hSliceComp idx 𝒜 (b - 1) (by omega), hSliceComp idx 𝒜 b hb_le_d]
          let Lb1 := L_sl idx 𝒜 (b - 1)
          let Lb := L_sl idx 𝒜 b
          let Sb := weilUpperShadow (m + 1) (d - b) Lb
          have h_inter_le : (slice idx d 𝒜 (b - 1) ∩
              weilUpperShadow (m + 1) (d - b) (slice idx d 𝒜 b)).card ≤
              min Lb1.card Sb.card := by
            refine le_min ?_ ?_
            · calc (slice idx d 𝒜 (b - 1) ∩ _).card
                  ≤ (slice idx d 𝒜 (b - 1)).card := Finset.card_le_card Finset.inter_subset_left
                _ = Lb1.card := (hLCardEq idx 𝒜 (b - 1)).symm
            · calc (slice idx d 𝒜 (b - 1) ∩ _).card
                  ≤ (weilUpperShadow (m + 1) (d - b) (slice idx d 𝒜 b)).card :=
                    Finset.card_le_card Finset.inter_subset_right
                _ ≤ Sb.card := hPrev (d - b) (slice idx d 𝒜 b) (Finset.filter_subset _ _)
          have hLb1_eq : Lb1 = weilLexInitSeg (m + 1) (d - b + 1) Lb1.card := by
            have he : d - (b - 1) = d - b + 1 := by omega
            dsimp [Lb1, L_sl]
            rw [hLCardEq, he]
          have hSb_eq : Sb = weilLexInitSeg (m + 1) (d - b + 1) Sb.card := hInitSh (d - b) _
          have h_inter_eq : (Lb1 ∩ Sb).card = min Lb1.card Sb.card := by
            rcases le_total Lb1.card Sb.card with hle | hle
            · have hsub : Lb1 ⊆ Sb := by
                rw [hLb1_eq, hSb_eq]; exact hMono (d - b + 1) _ _ hle
              rw [Finset.inter_eq_left.mpr hsub, min_eq_left hle]
            · have hsub : Sb ⊆ Lb1 := by
                rw [hLb1_eq, hSb_eq]; exact hMono (d - b + 1) _ _ hle
              rw [Finset.inter_eq_right.mpr hsub, min_eq_right hle]
          exact h_inter_eq.symm ▸ h_inter_le
    have hInsLex : ∀ (idx : Fin (m + 2)) (a : ℕ) {g₁ g₂ : Fin (m + 1) → ℕ},
        toLex g₁ < toLex g₂ → toLex (ins idx a g₁) < toLex (ins idx a g₂) := by
      intro idx a g₁ g₂ hlt
      rw [toLex_lt_iff_fin] at hlt ⊢
      obtain ⟨j₀, hpref, hj₀⟩ := hlt
      refine ⟨idx.succAbove j₀, ?_, ?_⟩
      · intro k hk
        by_cases hk_idx : k = idx
        · subst hk_idx; simp [hInsSame]
        · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq_iff.mpr hk_idx
          have hjj₀ : j < j₀ := idx.succAbove_lt_succAbove_iff.mp hk
          simp [hInsSucc, hpref j hjj₀]
      · simp [hInsSucc, hj₀]
    have hWeightCompare : ∀ {α : Type} [DecidableEq α] (S T : Finset α) (f : α → ℕ),
        S.card = T.card →
        (∀ x ∈ S \ T, ∀ y ∈ T \ S, f x < f y) →
        (∑ x ∈ S, f x ≤ ∑ y ∈ T, f y) ∧
        (S ≠ T → ∑ x ∈ S, f x < ∑ y ∈ T, f y) := by
      intro α _ S T f hcard hlt_st
      have hS_split : S = S ∩ T ∪ (S \ T) := by
        ext x
        simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]
        exact ⟨fun hx => if hxT : x ∈ T then Or.inl ⟨hx, hxT⟩ else Or.inr ⟨hx, hxT⟩,
          fun h => h.elim (fun h1 => h1.1) (fun h2 => h2.1)⟩
      have hT_split : T = S ∩ T ∪ (T \ S) := by
        ext x
        simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]
        exact ⟨fun hx => if hxS : x ∈ S then Or.inl ⟨hxS, hx⟩ else Or.inr ⟨hx, hxS⟩,
          fun h => h.elim (fun h1 => h1.2) (fun h2 => h2.1)⟩
      have hdS : Disjoint (S ∩ T) (S \ T) := by
        refine Finset.disjoint_left.mpr fun x hx1 hx2 => ?_
        exact (Finset.mem_sdiff.mp hx2).2 (Finset.mem_inter.mp hx1).2
      have hdT : Disjoint (S ∩ T) (T \ S) := by
        refine Finset.disjoint_left.mpr fun x hx1 hx2 => ?_
        exact (Finset.mem_sdiff.mp hx2).2 (Finset.mem_inter.mp hx1).1
      have hcA : (S \ T).card = (T \ S).card := by
        have hc1 : S.card = (S ∩ T).card + (S \ T).card := by
          conv_lhs => rw [hS_split]
          exact Finset.card_union_of_disjoint hdS
        have hc2 : T.card = (S ∩ T).card + (T \ S).card := by
          conv_lhs => rw [hT_split]
          exact Finset.card_union_of_disjoint hdT
        omega
      have hSumS : ∑ x ∈ S, f x = ∑ x ∈ S ∩ T, f x + ∑ x ∈ S \ T, f x := by
        conv_lhs => rw [hS_split]
        exact Finset.sum_union hdS
      have hSumT : ∑ y ∈ T, f y = ∑ x ∈ S ∩ T, f x + ∑ y ∈ T \ S, f y := by
        conv_lhs => rw [hT_split]
        exact Finset.sum_union hdT
      by_cases heq : S = T
      · subst heq; exact ⟨le_rfl, fun h => False.elim (h rfl)⟩
      · have hAne : (S \ T).Nonempty := by
          rw [Finset.sdiff_nonempty]
          intro hsub
          exact heq (Finset.eq_of_subset_of_card_le hsub (le_of_eq hcard.symm))
        let M := ((S \ T).image f).max' (hAne.image f)
        obtain ⟨x₀, hx₀_A, hx₀_M⟩ := Finset.mem_image.mp (Finset.max'_mem _ (hAne.image f))
        have hA_le : ∑ x ∈ S \ T, f x ≤ (S \ T).card * M := by
          calc ∑ x ∈ S \ T, f x
              ≤ ∑ _ ∈ S \ T, M := Finset.sum_le_sum fun x hx =>
                Finset.le_max' _ (f x) (Finset.mem_image_of_mem f hx)
            _ = (S \ T).card * M := by simp
        have hB_ge : (T \ S).card * (M + 1) ≤ ∑ y ∈ T \ S, f y := by
          calc (T \ S).card * (M + 1)
              = ∑ _ ∈ T \ S, (M + 1) := by simp
            _ ≤ ∑ y ∈ T \ S, f y := Finset.sum_le_sum fun y hy => by
                have hlt := hlt_st x₀ hx₀_A y hy
                omega
        have hc_pos : 1 ≤ (S \ T).card := Finset.Nonempty.card_pos hAne
        have h_strict : ∑ x ∈ S \ T, f x < ∑ y ∈ T \ S, f y := by
          have hmul_lt : (S \ T).card * M < (T \ S).card * (M + 1) := by
            rw [← hcA, Nat.mul_add, mul_one]
            omega
          omega
        refine ⟨by omega, fun _ => by omega⟩
    let sig (𝒜 : Finset (Fin (m + 2) → ℕ)) : ℕ :=
      ∑ w ∈ 𝒜, weilLexRank (m + 2) d w
    have hSigLt : ∀ (idx : Fin (m + 2)) (𝒜 : Finset (Fin (m + 2) → ℕ)),
        𝒜 ⊆ weilMonomialSet (m + 2) d →
        comp idx 𝒜 ≠ 𝒜 →
        sig (comp idx 𝒜) < sig 𝒜 := by
      intro idx 𝒜 h𝒜 hne
      dsimp [sig]
      rw [hSumSlice idx d (comp idx 𝒜) _ (hCompSub idx 𝒜), hSumSlice idx d 𝒜 _ h𝒜]
      have hSliceCmp : ∀ a ∈ Finset.range (d + 1),
          let f := fun g : Fin (m + 1) → ℕ => weilLexRank (m + 2) d (ins idx a g)
          (∑ g ∈ slice idx d (comp idx 𝒜) a, f g ≤ ∑ g ∈ slice idx d 𝒜 a, f g) ∧
          (slice idx d (comp idx 𝒜) a ≠ slice idx d 𝒜 a →
            ∑ g ∈ slice idx d (comp idx 𝒜) a, f g < ∑ g ∈ slice idx d 𝒜 a, f g) := by
        intro a ha_r
        have ha : a ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha_r)
        rw [hSliceComp idx 𝒜 a ha]
        refine hWeightCompare (L_sl idx 𝒜 a) (slice idx d 𝒜 a) _ (hLCardEq idx 𝒜 a) ?_
        intro v hv u hu
        obtain ⟨hv_L, _⟩ := Finset.mem_sdiff.mp hv
        obtain ⟨hu_G, hu_notL⟩ := Finset.mem_sdiff.mp hu
        obtain ⟨hv_mon, hv_rk⟩ := Finset.mem_filter.mp hv_L
        have hu_mon : u ∈ weilMonomialSet (m + 1) (d - a) := (Finset.mem_filter.mp hu_G).1
        have hu_rk : (slice idx d 𝒜 a).card ≤ weilLexRank (m + 1) (d - a) u := by
          by_contra hlt
          exact hu_notL (Finset.mem_filter.mpr ⟨hu_mon, Nat.lt_of_not_le hlt⟩)
        have hvu_lex : toLex v < toLex u :=
          (hRank m (d - a) hu_mon hv_mon).mpr (lt_of_lt_of_le hv_rk hu_rk)
        have hins_lex : toLex (ins idx a v) < toLex (ins idx a u) :=
          hInsLex idx a hvu_lex
        exact (hRank (m + 1) d (hInsMemMon idx d a u ha hu_mon)
          (hInsMemMon idx d a v ha hv_mon)).mp hins_lex
      have hex_a : ∃ a ∈ Finset.range (d + 1),
          slice idx d (comp idx 𝒜) a ≠ slice idx d 𝒜 a := by
        by_contra hall
        apply hne
        conv_lhs => rw [hBiUnionEq idx d (comp idx 𝒜) (hCompSub idx 𝒜)]
        conv_rhs => rw [hBiUnionEq idx d 𝒜 h𝒜]
        refine Finset.biUnion_congr rfl fun a ha => ?_
        have heq_a : slice idx d (comp idx 𝒜) a = slice idx d 𝒜 a :=
          Classical.not_not.mp fun h => hall ⟨a, ha, h⟩
        rw [heq_a]
      obtain ⟨a₀, ha₀, hne_a₀⟩ := hex_a
      exact Finset.sum_lt_sum (fun a ha => (hSliceCmp a ha).1)
        ⟨a₀, ha₀, (hSliceCmp a₀ ha₀).2 hne_a₀⟩
    have hMain : ∀ (S_val : ℕ) (𝒜 : Finset (Fin (m + 2) → ℕ)),
        sig 𝒜 = S_val →
        𝒜 ⊆ weilMonomialSet (m + 2) d →
        ∃ ℱ_star : Finset (Fin (m + 2) → ℕ),
          ℱ_star ⊆ weilMonomialSet (m + 2) d ∧
          ℱ_star.card = 𝒜.card ∧
          (weilUpperShadow (m + 2) d 𝒜).card ≤ (weilUpperShadow (m + 2) d ℱ_star).card ∧
          IsWeilSliceCompressed (m + 1) ℱ_star := by
      intro S_val
      refine Nat.strongRecOn S_val fun S_val ih 𝒜 hS h𝒜 => ?_
      by_cases hex_idx : ∃ idx : Fin (m + 2), comp idx 𝒜 ≠ 𝒜
      · obtain ⟨idx, hne_idx⟩ := hex_idx
        have hlt : sig (comp idx 𝒜) < S_val := hS ▸ hSigLt idx 𝒜 h𝒜 hne_idx
        obtain ⟨ℱ_star, hSub_s, hCard_s, hSh_s, hComp_s⟩ :=
          ih (sig (comp idx 𝒜)) hlt (comp idx 𝒜) rfl (hCompSub idx 𝒜)
        exact ⟨ℱ_star, hSub_s, hCard_s.trans (hCompCard idx 𝒜 h𝒜),
          le_trans (hCompShLe idx 𝒜 h𝒜) hSh_s, hComp_s⟩
      · refine ⟨𝒜, h𝒜, rfl, le_rfl, ?_⟩
        intro idx a u v hu_in hsum_vu hvu_lt
        have hfix : comp idx 𝒜 = 𝒜 := Classical.not_not.mp fun h => hex_idx ⟨idx, h⟩
        have hu_sum_tot : ∑ i : Fin (m + 2), (ins idx a u) i = d :=
          (mem_weilMonomialSet_iff (m + 2) d _).mp (h𝒜 hu_in)
        rw [Fin.sum_univ_succAbove _ idx] at hu_sum_tot
        simp only [hInsSame, hInsSucc] at hu_sum_tot
        have ha_le : a ≤ d := by omega
        have hu_mon : u ∈ weilMonomialSet (m + 1) (d - a) := by
          rw [mem_weilMonomialSet_iff]; omega
        have hv_mon : v ∈ weilMonomialSet (m + 1) (d - a) := by
          rw [mem_weilMonomialSet_iff]; omega
        have hu_sl : u ∈ slice idx d 𝒜 a := Finset.mem_filter.mpr ⟨hu_mon, hu_in⟩
        have h_sl_eq : slice idx d 𝒜 a = L_sl idx 𝒜 a := by
          have := hSliceComp idx 𝒜 a ha_le
          rwa [hfix] at this
        rw [h_sl_eq] at hu_sl
        have hu_rk : weilLexRank (m + 1) (d - a) u < (slice idx d 𝒜 a).card :=
          (Finset.mem_filter.mp hu_sl).2
        have hv_rk : weilLexRank (m + 1) (d - a) v < weilLexRank (m + 1) (d - a) u :=
          (hRank m (d - a) hu_mon hv_mon).mp hvu_lt
        have hv_L : v ∈ L_sl idx 𝒜 a :=
          Finset.mem_filter.mpr ⟨hv_mon, lt_trans hv_rk hu_rk⟩
        rw [← h_sl_eq] at hv_L
        exact (Finset.mem_filter.mp hv_L).2
    exact hMain (sig ℱ) ℱ rfl hF

  
  have s4_low_dim_shadow_bounds :
      (∀ (m e c : ℕ),
        (weilLexInitSeg (m + 1) e c).card = min c (weilMonomialSet (m + 1) e).card) →
      (∀ (m e c : ℕ),
        (weilLexInitSeg (m + 1) e c).card ≤
          (weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e c)).card) →
      (∀ (d : ℕ) (ℱ : Finset (Fin 1 → ℕ)),
        ℱ ⊆ weilMonomialSet 1 d →
        (weilUpperShadow 1 d ℱ).card ≤ (weilUpperShadow 1 d (weilLexInitSeg 1 d ℱ.card)).card) ∧
      (∀ (d : ℕ) (ℱ : Finset (Fin 2 → ℕ)),
        ℱ ⊆ weilMonomialSet 2 d →
        (weilUpperShadow 2 d ℱ).card ≤ (weilUpperShadow 2 d (weilLexInitSeg 2 d ℱ.card)).card) ∧
      (∀ (d : ℕ) (ℱ_star : Finset (Fin 3 → ℕ)),
        ℱ_star ⊆ weilMonomialSet 3 d →
        IsWeilSliceCompressed 2 ℱ_star →
        (weilUpperShadow 3 d ℱ_star).card ≤
          (weilUpperShadow 3 d (weilLexInitSeg 3 d ℱ_star.card)).card) := by
    intro hCard hGrow
    classical
    have hFullEq : ∀ (m e : ℕ) (ℱ : Finset (Fin (m + 1) → ℕ)),
        ℱ = weilMonomialSet (m + 1) e →
        weilLexInitSeg (m + 1) e ℱ.card = ℱ := by
      intro m e ℱ hfull
      subst hfull
      refine Finset.eq_of_subset_of_card_le (Finset.filter_subset _ _) ?_
      rw [hCard m e _, min_self]
    refine ⟨?_, ?_, ?_⟩
    · intro d ℱ hSub
      by_cases hne : ℱ.Nonempty
      · obtain ⟨u₀, hu₀⟩ := hne
        have hfull : ℱ = weilMonomialSet 1 d := by
          refine Finset.Subset.antisymm hSub fun u hu => ?_
          have hu_s := (mem_weilMonomialSet_iff 1 d u).mp hu
          have hu₀_s := (mem_weilMonomialSet_iff 1 d u₀).mp (hSub hu₀)
          have heq : u = u₀ := by
            ext i; fin_cases i
            simpa using hu_s.trans hu₀_s.symm
          exact heq ▸ hu₀
        rw [hFullEq 0 d ℱ hfull]
      · rw [Finset.not_nonempty_iff_eq_empty] at hne
        subst hne
        have hL0 : weilLexInitSeg 1 d 0 = ∅ := by
          ext u; simp [weilLexInitSeg]
        simp [hL0]
    · intro d ℱ hSub
      have hEq2 : ∀ {e : ℕ} {a b : Fin 2 → ℕ},
          a ∈ weilMonomialSet 2 e → b ∈ weilMonomialSet 2 e → a 0 = b 0 → a = b := by
        intro e a b ha hb h0
        have ha_s := (mem_weilMonomialSet_iff 2 e a).mp ha
        have hb_s := (mem_weilMonomialSet_iff 2 e b).mp hb
        rw [Fin.sum_univ_two] at ha_s hb_s
        ext i; fin_cases i <;> (dsimp; omega)
      by_cases hfull : ℱ = weilMonomialSet 2 d
      · rw [hFullEq 1 d ℱ hfull]
      · have hex_out : (weilMonomialSet 2 d \ ℱ).Nonempty := by
          rw [Finset.sdiff_nonempty]
          intro hsub'
          exact hfull (Finset.Subset.antisymm hSub hsub')
        obtain ⟨u₀, hu₀_sd⟩ := hex_out
        obtain ⟨hu₀_mon, hu₀_notF⟩ := Finset.mem_sdiff.mp hu₀_sd
        have hu₀_sum := (mem_weilMonomialSet_iff 2 d u₀).mp hu₀_mon
        rw [Fin.sum_univ_two] at hu₀_sum
        let a₀ := u₀ 0
        have ha₀_le : a₀ ≤ d := by omega
        let g : (Fin 2 → ℕ) → (Fin 2 → ℕ) :=
          fun w => if w 0 ≤ a₀ then Function.update w 1 (w 1 - 1) else Function.update w 0 (w 0 - 1)
        have hg_maps : ∀ w ∈ weilUpperShadow 2 d ℱ,
            g w ∈ ℱ ∧ ((w 0 < a₀ ∧ g w 0 = w 0) ∨ (a₀ < w 0 ∧ g w 0 = w 0 - 1)) := by
          intro w hw
          obtain ⟨hw_mon, hw_sh⟩ := Finset.mem_filter.mp hw
          have hw_sum := (mem_weilMonomialSet_iff 2 (d + 1) w).mp hw_mon
          rw [Fin.sum_univ_two] at hw_sum
          have hw0_ne : w 0 ≠ a₀ := by
            intro heq0
            have hw1_pos : 1 ≤ w 1 := by omega
            have hw'_F : Function.update w 1 (w 1 - 1) ∈ ℱ := hw_sh 1 hw1_pos
            have hw'_mon : Function.update w 1 (w 1 - 1) ∈ weilMonomialSet 2 d :=
              update_pred_mem_weilMonomialSet hw_mon 1 hw1_pos
            have hw'_eq_u₀ : Function.update w 1 (w 1 - 1) = u₀ :=
              hEq2 hw'_mon hu₀_mon (by simp [heq0, a₀])
