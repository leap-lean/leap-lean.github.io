  have hMin : ∀ m < k, ¬ P m := fun m hm => Nat.find_min hex hm
  rcases Nat.eq_zero_or_pos k with hk0 | hk_pos
  · left
    rw [hk0] at hk
    obtain ⟨W_seq, g_seq, τ_seq, centers, maps, π_from, α_top, h,
        hTower, _hα_snd, hα_fst, hh_g, _hh_sec, hh_gen⟩ := hk
    have : CategoryTheory.IsIso (π_from 0) := hTower.2.1
