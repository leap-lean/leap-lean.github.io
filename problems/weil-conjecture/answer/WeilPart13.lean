            rw [← hev_ker, RingHom.mem_ker, map_sub]
            have hK := RingHom.congr_fun hev_A (ev_K d)
            change ev_K (ψ (toA (ev_K d))) = ev_K d at hK
            rw [hK, sub_self]
          refine ⟨a_d * a₁, Ideal.mul_mem_left _ _ ha₁, ?_⟩
          have hrew : d • z₁ - ψ (a_d * a₁) = d * (z₁ - ψ a₁) + (d - ψ a_d) * ψ a₁ := by
            change d * z₁ - ψ (a_d * a₁) = _
            rw [map_mul]; ring
          rw [hrew]
          refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ h₁) ?_
          rw [sq]
          exact Ideal.mul_mem_mul hd_mem ha₁
      have hClaim2 : ∀ y ∈ m₀.asIdeal, ∃ x₁ ∈ m_A, y - ψ x₁ ∈ m₀.asIdeal ^ 2 := by
        intro y hy
        obtain ⟨z, hz, hyz⟩ := hClaim1 y hy
        obtain ⟨x₁, hx₁, hzx⟩ := hJ_approx z hz
        refine ⟨x₁, hx₁, ?_⟩
        have hrew : y - ψ x₁ = (y - z) + (z - ψ x₁) := by ring
        rw [hrew]
        exact Ideal.add_mem _ (Ideal.pow_le_pow_right (by omega : 2 ≤ 3) hyz) hzx
      have hClaim3 : ∀ w ∈ m₀.asIdeal ^ 2, ∃ x₂ ∈ m_A ^ 2, w - ψ x₂ ∈ m₀.asIdeal ^ 3 := by
        intro w hw
        rw [sq] at hw
        refine Submodule.mul_induction_on hw ?_ ?_
        · intro y₁ hy₁ y₂ hy₂
          obtain ⟨x₁, hx₁, h₁⟩ := hClaim2 y₁ hy₁
          obtain ⟨x₁', hx₁', h₂⟩ := hClaim2 y₂ hy₂
          refine ⟨x₁ * x₁', by rw [sq]; exact Ideal.mul_mem_mul hx₁ hx₁', ?_⟩
