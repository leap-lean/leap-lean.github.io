      exact Algebra.FinitePresentation.ker_fG_of_surjective π₀_alg hSurj₀
    exact ⟨Localization.Away Δ_bar, inferInstance, φ₀, Q₀, s_A, q'₁, π₀,
      hEt₀, hs_A, hq'₁, rfl, hSurj₀, hKerFG, hComm₀⟩
  
  let α₀ : MvPolynomial (Fin 2) R₁ →ₐ[R₁] A₁ := MvPolynomial.aeval (R := R₁) ![u₁, v₁]
