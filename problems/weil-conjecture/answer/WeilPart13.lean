        have hfb_κ : fwd_κ.comp bwd_κ = LinearMap.id := by
          have he₀ : res_MD e₀_D = Pi.single 0 1 := by
            change res_raw (Pi.single 0 1) = Pi.single 0 1
            ext j; fin_cases j <;> simp [res_raw]
          have he₁ : res_MD e₁_D = Pi.single 1 1 := by
            change res_raw (Pi.single 1 1) = Pi.single 1 1
            ext j; fin_cases j <;> simp [res_raw]
