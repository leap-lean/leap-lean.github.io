        · exact ⟨0, Ideal.zero_mem _, by simp⟩
        · rintro z₁ z₂ _ _ ⟨a₁, ha₁, h₁⟩ ⟨a₂, ha₂, h₂⟩
          refine ⟨a₁ + a₂, Ideal.add_mem _ ha₁ ha₂, ?_⟩
