      u_ext ∈ m₂.asIdeal ∧
      v_ext ∈ m₂.asIdeal ∧
      (∀ z : TensorProduct κ₀ E₂ F₀,
        ∃ c : E₂, z - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c ∈ m₂.asIdeal) ∧
      (let L₂ := Localization.AtPrime m₂.asIdeal
       let loc := algebraMap (TensorProduct κ₀ E₂ F₀) L₂
