        _ = (y * algebraMap K C₁ (μ₁ t.1)) * algebraMap K C₁ (μ₁ t.1)⁻¹ := by rw [hrt]
        _ = y * (algebraMap K C₁ (μ₁ t.1) * algebraMap K C₁ (μ₁ t.1)⁻¹) := by ring
        _ = y := by rw [hunit, mul_one]
    have : Subsingleton Ω[C₁⁄K] := KaehlerDifferential.subsingleton_of_surjective K C₁ hSurj_KC₁
    letI : Algebra E₁ R_E₁ := Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
    have : IsScalarTower κ₀ E₁ R_E₁ :=
      IsScalarTower.of_algebraMap_eq fun c => by
        change algebraMap κ₀ R_E₁ c = Algebra.TensorProduct.includeRight (algebraMap κ₀ E₁ c)
        change (algebraMap κ₀ K c) ⊗ₜ[κ₀] (1 : E₁) = (1 : K) ⊗ₜ[κ₀] (algebraMap κ₀ E₁ c)
