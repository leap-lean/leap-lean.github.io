        rfl
      · rename_i u v hu hv
        rw [map_add, map_add, hu, hv]
  
  have hs1 :
      ∀ (K : Type u) [Field K],
        let J_std : Ideal (MvPolynomial (Fin 2) K) :=
          Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) * MvPolynomial.X 1} ⊔
            Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K), MvPolynomial.X 1} ^ 3
