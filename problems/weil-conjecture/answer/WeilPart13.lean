      exact IsUnit.mk0 _ (fun h0 => hw_ne (hinj_RK (h0.trans (map_zero _).symm)))
    · intro w
      obtain ⟨a, b, hb_nzd, rfl⟩ := IsFractionRing.div_surjective (A := PowerSeries Ω) w
