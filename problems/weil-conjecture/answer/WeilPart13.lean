          (C₁.left.presheaf.map (homOfLE e_VU_le).op).hom ((f₁.left.app U_Y).hom a) := rfl
      have hres : W_a = V_X ⊓ C₁.left.basicOpen ((f₁.left.app U_Y).hom a) := by
        dsimp [W_a]
        rw [hφ_eq, C₁.left.basicOpen_res]
      rw [hres, ← f₁.left.preimage_basicOpen a]
      exact inf_le_right.trans ((TopologicalSpace.Opens.map f₁.left.base).monotone ha_le)
    have hRedWa_ring : True ∧ _root_.IsReduced ↑(C₁.left.presheaf.obj (Opposite.op W_a)) := by
      refine ⟨trivial, ?_⟩
      haveI : AlgebraicGeometry.IsReduced ↑(f₁.left ⁻¹ᵁ U_B₁) := hRedVC₁.2
      have hRedWa : AlgebraicGeometry.IsReduced ↑W_a :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion (C₁.left.homOfLE hWa_le)
      haveI : _root_.IsReduced
          ↑((↑W_a : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) :=
        @AlgebraicGeometry.IsReduced.component_reduced (↑W_a) hRedWa ⊤
      exact isReduced_of_injective W_a.topIso.inv.hom
        W_a.topIso.commRingCatIsoToRingEquiv.symm.injective
    haveI : IsLocalization.Away (φ.hom a) ↑(C₁.left.presheaf.obj (Opposite.op W_a)) :=
      hVX.isLocalization_basicOpen (φ.hom a)
    haveI : _root_.IsReduced ↑(C₁.left.presheaf.obj (Opposite.op V_X)) := by
      refine ⟨fun r hr => ?_⟩
      have hr_map_zero :
          algebraMap ↑(C₁.left.presheaf.obj (Opposite.op V_X))
            ↑(C₁.left.presheaf.obj (Opposite.op W_a)) r = 0 := by
        haveI : _root_.IsReduced ↑(C₁.left.presheaf.obj (Opposite.op W_a)) := hRedWa_ring.2
        exact (hr.map _).eq_zero
      obtain ⟨⟨_, k_pow, rfl⟩, hk_eq⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ.hom a))
          ↑(C₁.left.presheaf.obj (Opposite.op W_a)) r).mp hr_map_zero
      have hsmul_zero : (a ^ k_pow) • r = 0 := by
        rw [Algebra.smul_def]
        change φ.hom (a ^ k_pow) * r = 0
        rw [map_pow]
        exact hk_eq
      exact (smul_eq_zero.mp hsmul_zero).resolve_left (pow_ne_zero k_pow ha_ne)
    exact (@h_loc_red
      ↑(C₁.left.presheaf.obj (Opposite.op V_X)) _ _
      (hVX.primeIdealOf ⟨x, hxVX⟩).asIdeal.primeCompl
      ↑(C₁.left.presheaf.stalk x) _
      (TopCat.Presheaf.algebra_section_stalk _ ⟨x, hxVX⟩)
      (hVX.isLocalization_stalk ⟨x, hxVX⟩)).2

  
  have hIrredC₁ : True ∧ IrreducibleSpace ↥C₁.left := by
    refine ⟨trivial, ?_⟩
    haveI : IrreducibleSpace ↥B₁.left := hIrredB₁
    let η : ↥B₁.left := genericPoint ↥B₁.left
    obtain ⟨⟨u₁, hu₁⟩⟩ := hU_B₁
    have hηU : η ∈ U_B₁ :=
      ((genericPoint_spec ↥B₁.left).mem_open_set_iff U_B₁.isOpen).mpr ⟨u₁, trivial, hu₁⟩
    let s_Kbar : AlgebraicGeometry.Spec
        (CommRingCat.of (AlgebraicClosure ↑(B₁.left.residueField η))) ⟶ B₁.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↑(B₁.left.residueField η)
          (AlgebraicClosure ↑(B₁.left.residueField η)))) ≫
        B₁.left.fromSpecResidueField η
    have hs_Kbar_pt : ∀ z, s_Kbar.base z = η := by
      intro z
      exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply η _
    have hRange_s : Set.range s_Kbar.base ⊆ Set.range U_B₁.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [hs_Kbar_pt z]
      exact ⟨⟨η, hηU⟩, rfl⟩
    let s_U := AlgebraicGeometry.IsOpenImmersion.lift U_B₁.ι s_Kbar hRange_s
    have hs_U_fac : s_U ≫ U_B₁.ι = s_Kbar :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_B₁.ι s_Kbar hRange_s
    have hPb_main := CategoryTheory.IsPullback.of_hasPullback f₁.left s_Kbar
    have hPb_U := AlgebraicGeometry.isPullback_morphismRestrict f₁.left U_B₁
    let l_F := hPb_U.lift
      (CategoryTheory.Limits.pullback.snd f₁.left s_Kbar ≫ s_U)
      (CategoryTheory.Limits.pullback.fst f₁.left s_Kbar)
      (by rw [CategoryTheory.Category.assoc, hs_U_fac, hPb_main.w])
    have hPb_top : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd f₁.left s_Kbar)
        l_F s_U (f₁.left ∣_ U_B₁) := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_U
      · rw [hPb_U.lift_snd, hs_U_fac]
        exact hPb_main.flip
      · exact (hPb_U.lift_fst _ _ _).symm
    have hSm_F : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.snd f₁.left s_Kbar) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top.flip hSmU
    have hConn_F : ConnectedSpace ↥(CategoryTheory.Limits.pullback f₁.left s_Kbar) :=
      hConn (AlgebraicClosure ↑(B₁.left.residueField η)) s_Kbar
    have hIrred_F : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₁.left s_Kbar) :=
      (@h_irred_dim1 (AlgebraicClosure ↑(B₁.left.residueField η)) _
        (CategoryTheory.Limits.pullback f₁.left s_Kbar)
        (CategoryTheory.Limits.pullback.snd f₁.left s_Kbar) hSm_F hConn_F).2
    obtain ⟨p₀⟩ := hIrred_F.toNonempty
    let z₀ : ↥(AlgebraicGeometry.Spec
        (CommRingCat.of (AlgebraicClosure ↑(B₁.left.residueField η)))) :=
      ⟨⊥, Ideal.isPrime_bot⟩
    haveI : AlgebraicGeometry.Flat f₁.left := hFlat_f₁
    haveI : AlgebraicGeometry.LocallyOfFinitePresentation f₁.left := hLfp_f₁
    haveI : AlgebraicGeometry.UniversallyOpen f₁.left :=
      AlgebraicGeometry.UniversallyOpen.of_flat f₁.left
    have hOpen_f : IsOpenMap ⇑f₁.left.base := f₁.left.isOpenMap
    refine { isPreirreducible_univ := ?_,
             toNonempty := ⟨(CategoryTheory.Limits.pullback.fst f₁.left s_Kbar).base p₀⟩ }
    intro W₁ W₂ hOpenW₁ hOpenW₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
    have hη_W₁ : η ∈ f₁.left.base '' W₁ :=
      ((genericPoint_spec ↥B₁.left).mem_open_set_iff (hOpen_f W₁ hOpenW₁)).mpr
        ⟨f₁.left.base x₁, trivial, ⟨x₁, hx₁, rfl⟩⟩
    have hη_W₂ : η ∈ f₁.left.base '' W₂ :=
      ((genericPoint_spec ↥B₁.left).mem_open_set_iff (hOpen_f W₂ hOpenW₂)).mpr
        ⟨f₁.left.base x₂, trivial, ⟨x₂, hx₂, rfl⟩⟩
    obtain ⟨w₁, hw₁, hfw₁⟩ := hη_W₁
    obtain ⟨w₂, hw₂, hfw₂⟩ := hη_W₂
    obtain ⟨q₁, hq₁_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₁ z₀
        (hfw₁.trans (hs_Kbar_pt z₀).symm)
    obtain ⟨q₂, hq₂_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₂ z₀
        (hfw₂.trans (hs_Kbar_pt z₀).symm)
    let π₁ := CategoryTheory.Limits.pullback.fst f₁.left s_Kbar
    obtain ⟨q, _, hqW₁, hqW₂⟩ :=
      hIrred_F.isPreirreducible_univ
        (π₁.base ⁻¹' W₁) (π₁.base ⁻¹' W₂)
        (hOpenW₁.preimage π₁.continuous) (hOpenW₂.preimage π₁.continuous)
        ⟨q₁, trivial, by rw [Set.mem_preimage, hq₁_fst]; exact hw₁⟩
        ⟨q₂, trivial, by rw [Set.mem_preimage, hq₂_fst]; exact hw₂⟩
    exact ⟨π₁.base q, trivial, hqW₁, hqW₂⟩

  exact @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C₁.left hRedC₁.2 hIrredC₁.2

theorem weil_etale_ring_normal_localizations_of_normal_noetherian_domain (D S : Type u) [CommRing D] [CommRing S] [Algebra D S]
    [IsDomain D] [IsIntegrallyClosed D] [IsNoetherianRing D]
    [Algebra.Etale D S] (P : Ideal S) [P.IsPrime] :
    ∃ (e : S), e ∉ P ∧
      IsDomain (Localization.Away e) ∧
      IsIntegrallyClosed (Localization.Away e) :=
by
  
  have h_s2 : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
      [IsDomain R] [IsIntegrallyClosed R] [IsNoetherianRing R] [IsLocalRing R]
      [Module.Flat R B]
      (r₀ : R), r₀ ≠ 0 → r₀ ∈ IsLocalRing.maximalIdeal R →
      ∀ (w : B), w ∉ Ideal.span {algebraMap R B r₀} →
      (∀ m ∈ IsLocalRing.maximalIdeal R, m • w ∈ Ideal.span {algebraMap R B r₀}) →
      ∃ ϖ : R, ϖ ≠ 0 ∧ IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := by
    intro R B _ _ _ _ _ _ _ _ r₀ hr₀_ne hr₀_mem w hw_not_mem hw_ann
    let K_R : Type u := FractionRing R
    let ι_R : R →+* K_R := algebraMap R K_R
    have hιR_inj : Function.Injective ι_R := IsFractionRing.injective R K_R
    let P_inv : K_R → Prop := fun q => ∀ m ∈ IsLocalRing.maximalIdeal R, q * ι_R m ∈ Set.range ι_R
    by_cases h_case : ∃ q₀ : K_R, P_inv q₀ ∧
        ∃ ϖ ∈ IsLocalRing.maximalIdeal R, ∃ u : R, u ∉ IsLocalRing.maximalIdeal R ∧ q₀ * ι_R ϖ = ι_R u
    · obtain ⟨q₀, hq₀, ϖ, hϖ_mem, u, hu_not_mem, hq₀_eq⟩ := h_case
      have hu_unit : IsUnit u := IsLocalRing.notMem_maximalIdeal.mp hu_not_mem
      have hϖ_ne : ϖ ≠ 0 := by
        intro h0
        rw [h0, map_zero, mul_zero] at hq₀_eq
        exact hu_unit.ne_zero (hιR_inj (hq₀_eq.symm.trans (map_zero ι_R).symm))
      refine ⟨ϖ, hϖ_ne, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖ_mem))⟩
      intro m hm
      obtain ⟨r_m, hr_m⟩ := hq₀ m hm
      have hmu : m * u = r_m * ϖ := hιR_inj (by
        calc ι_R (m * u) = ι_R m * (q₀ * ι_R ϖ) := by rw [map_mul, ← hq₀_eq]
          _ = (q₀ * ι_R m) * ι_R ϖ := by ring
          _ = ι_R (r_m * ϖ) := by rw [← hr_m, map_mul])
      obtain ⟨u_inv, hu_inv⟩ := hu_unit.exists_right_inv
      rw [Ideal.mem_span_singleton]
      refine ⟨r_m * u_inv, ?_⟩
      calc m = (m * u) * u_inv := by rw [mul_assoc, hu_inv, mul_one]
        _ = ϖ * (r_m * u_inv) := by rw [hmu]; ring
    · exfalso
      let N : Submodule R K_R := Submodule.map (Algebra.linearMap R K_R) (IsLocalRing.maximalIdeal R)
      have hN_ne : N ≠ ⊥ := by
        intro hbot
        have hmem : ι_R r₀ ∈ N := ⟨r₀, hr₀_mem, rfl⟩
        rw [hbot, Submodule.mem_bot] at hmem
        exact hr₀_ne (hιR_inj (hmem.trans (map_zero ι_R).symm))
      have hN_fg : N.FG := (IsNoetherian.noetherian (IsLocalRing.maximalIdeal R)).map _
      have h_Pinv_range : ∀ q : K_R, P_inv q → q ∈ Set.range ι_R := by
        intro q hq
        have hq_mem_N : ∀ n ∈ N, q • n ∈ N := by
          rintro _ ⟨m, hm, rfl⟩
          obtain ⟨u, hu⟩ := hq m hm
          have hu_mem : u ∈ IsLocalRing.maximalIdeal R := by
            by_contra hu_not
            exact h_case ⟨q, hq, m, hm, u, hu_not, hu.symm⟩
          exact ⟨u, hu_mem, hu⟩
        have hq_int : IsIntegral R q := isIntegral_of_smul_mem_submodule N hN_ne hN_fg q hq_mem_N
        exact (isIntegrallyClosed_iff K_R).mp inferInstance hq_int
      have h_colon_R : ∀ c : R,
          (∀ m ∈ IsLocalRing.maximalIdeal R, m * c ∈ Ideal.span {r₀}) → c ∈ Ideal.span {r₀} := by
        intro c hc
        have hιr₀_ne : ι_R r₀ ≠ 0 := fun h0 => hr₀_ne (hιR_inj (h0.trans (map_zero ι_R).symm))
        let q : K_R := ι_R c / ι_R r₀
        have hq_inv : P_inv q := by
          intro m hm
          obtain ⟨d_m, hd_m⟩ := Ideal.mem_span_singleton.mp (hc m hm)
          refine ⟨d_m, ?_⟩
          symm
          rw [div_mul_eq_mul_div, div_eq_iff hιr₀_ne, ← map_mul, ← map_mul]
          congr 1
          rw [mul_comm, hd_m, mul_comm]
        obtain ⟨r, hr⟩ := h_Pinv_range q hq_inv
        have hcr : c = r₀ * r := hιR_inj (by
          rw [map_mul, mul_comm, hr]
          exact (div_mul_cancel₀ (ι_R c) hιr₀_ne).symm)
        exact Ideal.mem_span_singleton.mpr ⟨r, hcr⟩
      obtain ⟨s, hs⟩ := IsNoetherian.noetherian (IsLocalRing.maximalIdeal R)
      let I₀ : Ideal R := Ideal.span {r₀}
      let α : (R ⧸ I₀) →ₗ[R] (∀ i : ↑s, R ⧸ I₀) :=
        LinearMap.pi fun i : ↑s => LinearMap.lsmul R (R ⧸ I₀) i.1
      have hα_inj : Function.Injective α := by
        rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        intro x hx
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [LinearMap.mem_ker] at hx
        have hc_mem : c ∈ I₀ := h_colon_R c (by
          let Jc : Ideal R :=
            { carrier := {m : R | m * c ∈ I₀}
              add_mem' := fun {a b} ha hb => by change (a + b) * c ∈ I₀; rw [add_mul]; exact I₀.add_mem ha hb
              zero_mem' := by change 0 * c ∈ I₀; rw [zero_mul]; exact I₀.zero_mem
              smul_mem' := fun r {a} ha => by
                change (r • a) * c ∈ I₀; rw [smul_eq_mul, mul_assoc]; exact I₀.mul_mem_left r ha }
          have hsub : IsLocalRing.maximalIdeal R ≤ Jc := by
            rw [← hs, Submodule.span_le]
            intro m hm
            have hi := congr_fun hx ⟨m, hm⟩
            change Ideal.Quotient.mk I₀ (m * c) = 0 at hi
            exact (Ideal.Quotient.eq_zero_iff_mem (I := I₀)).mp hi
          exact fun m hm => hsub hm)
        rw [Submodule.mem_bot]
        exact (Ideal.Quotient.eq_zero_iff_mem (I := I₀)).mpr hc_mem
      let _ : DecidableEq ↑s := Classical.decEq ↑s
      have hlα_inj : Function.Injective (LinearMap.lTensor B α) :=
        Module.Flat.lTensor_preserves_injective_linearMap α hα_inj
      let e₂ := TensorProduct.piRight R R B (fun _ : ↑s => R ⧸ I₀)
      have hw_zero : e₂ ((LinearMap.lTensor B α) (w ⊗ₜ[R] (1 : R ⧸ I₀))) = 0 := by
        ext i
        change w ⊗ₜ[R] (i.1 • (1 : R ⧸ I₀)) = 0
        have hi_mem : i.1 ∈ IsLocalRing.maximalIdeal R := hs ▸ Submodule.subset_span i.2
        obtain ⟨b_i, hb_i⟩ := Ideal.mem_span_singleton.mp (hw_ann i.1 hi_mem)
        have hsmul : i.1 • w = r₀ • b_i := by rw [hb_i, Algebra.smul_def]
        have hr₀_one : r₀ • (1 : R ⧸ I₀) = 0 := by
          change Ideal.Quotient.mk I₀ (r₀ * 1) = 0
          rw [mul_one, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self r₀
        calc w ⊗ₜ[R] (i.1 • (1 : R ⧸ I₀))
            = (i.1 • w) ⊗ₜ[R] (1 : R ⧸ I₀) := (TensorProduct.smul_tmul i.1 w 1).symm
          _ = (r₀ • b_i) ⊗ₜ[R] (1 : R ⧸ I₀) := by rw [hsmul]
          _ = b_i ⊗ₜ[R] (r₀ • (1 : R ⧸ I₀)) := TensorProduct.smul_tmul r₀ b_i 1
          _ = 0 := by rw [hr₀_one, TensorProduct.tmul_zero]
      have hw_tmul_zero : w ⊗ₜ[R] (1 : R ⧸ I₀) = 0 :=
        hlα_inj (e₂.injective (by rw [hw_zero, map_zero, map_zero]))
      let e₁ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I₀
      have he₁_w : e₁ (Ideal.Quotient.mk (Ideal.map (algebraMap R B) I₀) w) = w ⊗ₜ[R] (1 : R ⧸ I₀) := by
        have hmk : Ideal.Quotient.mk (Ideal.map (algebraMap R B) I₀) w =
            w • (1 : B ⧸ Ideal.map (algebraMap R B) I₀) := by
          rw [Algebra.smul_def, mul_one]; rfl
        rw [hmk, map_smul e₁ w 1, map_one, Algebra.smul_def w (1 : TensorProduct R B (R ⧸ I₀))]
        change (w ⊗ₜ[R] (1 : R ⧸ I₀)) * ((1 : B) ⊗ₜ[R] (1 : R ⧸ I₀)) = w ⊗ₜ[R] (1 : R ⧸ I₀)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one]
      have hw_mem_map : w ∈ Ideal.map (algebraMap R B) I₀ := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact e₁.injective (he₁_w.trans (hw_tmul_zero.trans e₁.map_zero.symm))
      rw [show I₀ = Ideal.span {r₀} from rfl, Ideal.map_span, Set.image_singleton] at hw_mem_map
      exact hw_not_mem hw_mem_map

  
  have h_s3 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T]
      [IsDomain R] [IsNoetherianRing R] [IsLocalRing R] [Algebra.Etale R T]
      (ϖ : R), ϖ ≠ 0 → IsLocalRing.maximalIdeal R = Ideal.span {ϖ} →
      ∀ (Q : Ideal T) [Q.IsPrime],
      IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro R T _ _ _ _ _ _ _ ϖ hϖ_ne hmaxR Q _
    let A : Type u := Localization.AtPrime Q
    by_cases hQ_bot : Ideal.comap (algebraMap R T) Q = ⊥
    · let K_R : Type u := FractionRing R
      let M_R : Submonoid T := Algebra.algebraMapSubmonoid T (nonZeroDivisors R)
      let T_K : Type u := Localization M_R
      have hDisj : Disjoint (M_R : Set T) (Q : Set T) := by
        rw [Set.disjoint_left]
        rintro _ ⟨r, hr_nzd, rfl⟩ hmemQ
        have hr_mem : r ∈ Ideal.comap (algebraMap R T) Q := hmemQ
        rw [hQ_bot, Ideal.mem_bot] at hr_mem
        exact nonZeroDivisors.ne_zero hr_nzd hr_mem
      let Q_K : Ideal T_K := Ideal.map (algebraMap T T_K) Q
      have hQK_prime : Q_K.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M_R T_K Q inferInstance hDisj
      have hQ_under : Q = Ideal.comap (algebraMap T T_K) Q_K :=
        (IsLocalization.under_map_of_isPrime_disjoint M_R T_K inferInstance hDisj).symm
      let e₁ : A ≃+* Localization.AtPrime Q_K :=
        (Localization.localRingEquiv Q (Ideal.comap (algebraMap T T_K) Q_K) (RingEquiv.refl T) hQ_under).trans
          (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M_R Q_K).toRingEquiv
      let _ : IsLocalization M_R (TensorProduct R T K_R) := IsLocalization.tensor K_R (nonZeroDivisors R)
      have hEt_KR : Algebra.Etale K_R (TensorProduct R K_R T) := inferInstance
      obtain ⟨J, hFinJ, E, hFieldE, hAlgE, Φ_T, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K_R (TensorProduct R K_R T)).mp hEt_KR
      let Φ_K : T_K ≃+* (∀ j : J, E j) :=
        (IsLocalization.algEquiv M_R T_K (TensorProduct R T K_R)).toRingEquiv.trans
          ((Algebra.TensorProduct.comm R T K_R).toRingEquiv.trans Φ_T.toRingEquiv)
      let Q_star : Ideal (∀ j : J, E j) := Ideal.comap Φ_K.symm.toRingHom Q_K
      have hQstar_prime : Q_star.IsPrime := Ideal.IsPrime.comap Φ_K.symm.toRingHom
      have hQK_eq : Q_K = Ideal.comap Φ_K Q_star := by
        ext x
        simp [Q_star]
      let e₂ : Localization.AtPrime Q_K ≃+* Localization.AtPrime Q_star :=
        Localization.localRingEquiv Q_K Q_star Φ_K hQK_eq
      obtain ⟨j₀, q₀, hq₀_eq⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq ⟨Q_star, hQstar_prime⟩
      have hQstar_eq : Q_star = Ideal.comap (Pi.evalRingHom E j₀) q₀.asIdeal :=
        (congrArg PrimeSpectrum.asIdeal hq₀_eq).symm
      let e₃ : Localization.AtPrime Q_star ≃+* Localization.AtPrime q₀.asIdeal :=
        (Localization.localRingEquiv Q_star (Ideal.comap (Pi.evalRingHom E j₀) q₀.asIdeal)
          (RingEquiv.refl _) hQstar_eq).trans
          (RingEquiv.ofBijective (Localization.AtPrime.mapPiEvalRingHom q₀.asIdeal)
            (Localization.AtPrime.mapPiEvalRingHom_bijective q₀.asIdeal))
      let _ : Field (E j₀) := hFieldE j₀
      have h_units : q₀.asIdeal.primeCompl ≤ IsUnit.submonoid (E j₀) := by
        intro x hx
        have hx0 : x ≠ 0 := fun h0 => hx (h0 ▸ q₀.asIdeal.zero_mem)
        exact isUnit_iff_ne_zero.mpr hx0
      let e₄ : Localization.AtPrime q₀.asIdeal ≃+* E j₀ :=
        (IsLocalization.atUnits (E j₀) q₀.asIdeal.primeCompl h_units).symm.toRingEquiv
      let e_all : A ≃+* E j₀ := e₁.trans (e₂.trans (e₃.trans e₄))
      exact ⟨Function.Injective.isDomain e_all.toRingHom e_all.injective, IsIntegrallyClosed.of_equiv e_all.symm⟩
    · have hNotFieldR : ¬ IsField R := by
        rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmaxR]
        intro hbot
        exact hϖ_ne (Ideal.mem_bot.mp (hbot ▸ Ideal.mem_span_singleton_self ϖ))
      have hPrinR : (IsLocalRing.maximalIdeal R).IsPrincipal := ⟨⟨ϖ, hmaxR⟩⟩
      have hTFAE_R : (IsLocalRing.maximalIdeal R).IsPrincipal ↔
          (IsIntegrallyClosed R ∧ ∃! P : Ideal R, P ≠ ⊥ ∧ P.IsPrime) :=
        (IsDiscreteValuationRing.TFAE R hNotFieldR).out 5 4
      have hUniquePrimeR : ∃! P : Ideal R, P ≠ ⊥ ∧ P.IsPrime :=
        (hTFAE_R.mp hPrinR).2
      have hmaxR_ne_bot : IsLocalRing.maximalIdeal R ≠ ⊥ := by
        rw [hmaxR]
        intro hbot
        exact hϖ_ne (Ideal.mem_bot.mp (hbot ▸ Ideal.mem_span_singleton_self ϖ))
      have hQ_comap_eq : Ideal.comap (algebraMap R T) Q = IsLocalRing.maximalIdeal R :=
        hUniquePrimeR.unique ⟨hQ_bot, inferInstance⟩ ⟨hmaxR_ne_bot, inferInstance⟩
      let ϖ_T : T := algebraMap R T ϖ
      have hϖT_mem : ϖ_T ∈ Q := by
        change ϖ ∈ Ideal.comap (algebraMap R T) Q
        rw [hQ_comap_eq, hmaxR]
        exact Ideal.mem_span_singleton_self ϖ
      let I_ϖ : Ideal R := IsLocalRing.maximalIdeal R
      let _ : I_ϖ.IsMaximal := IsLocalRing.maximalIdeal.isMaximal R
      let κ : Type u := R ⧸ I_ϖ
      let _ : Field κ := Ideal.Quotient.field I_ϖ
      have hEt_κ : Algebra.Etale κ (TensorProduct R κ T) := inferInstance
      obtain ⟨J, hFinJ, κ_f, hFieldκ, hAlgκ, Φ_κ, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod κ (TensorProduct R κ T)).mp hEt_κ
      let J_ϖ : Ideal T := Ideal.map (algebraMap R T) I_ϖ
      have hJ_ϖ_eq : J_ϖ = Ideal.span {ϖ_T} := by
        change Ideal.map (algebraMap R T) I_ϖ = Ideal.span {ϖ_T}
        rw [show I_ϖ = Ideal.span {ϖ} from hmaxR, Ideal.map_span, Set.image_singleton]
      let Φ₀ : (T ⧸ J_ϖ) ≃+* (∀ j : J, κ_f j) :=
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I_ϖ).toRingEquiv.trans
          ((Algebra.TensorProduct.comm R T κ).toRingEquiv.trans Φ_κ.toRingEquiv)
      let q_T : T →+* (∀ j : J, κ_f j) := Φ₀.toRingHom.comp (Ideal.Quotient.mk J_ϖ)
      have hqT_surj : Function.Surjective q_T := Φ₀.surjective.comp Ideal.Quotient.mk_surjective
      have hker_qT : RingHom.ker q_T = J_ϖ := by
        ext t
        change Φ₀ (Ideal.Quotient.mk J_ϖ t) = 0 ↔ t ∈ J_ϖ
        rw [map_eq_zero_iff Φ₀ Φ₀.injective, Ideal.Quotient.eq_zero_iff_mem]
      have hker_le_Q : RingHom.ker q_T ≤ Q := by
        rw [hker_qT, hJ_ϖ_eq]
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖT_mem)
      let Q_bar : Ideal (∀ j : J, κ_f j) := Ideal.map q_T Q
      have hQbar_prime : Q_bar.IsPrime := Ideal.map_isPrime_of_surjective hqT_surj hker_le_Q
      have hQ_comap_qT : Ideal.comap q_T Q_bar = Q := by
        rw [Ideal.comap_map_of_surjective' q_T hqT_surj Q, sup_eq_left.mpr hker_le_Q]
      obtain ⟨j₀, p₀, hp₀_eq⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq ⟨Q_bar, hQbar_prime⟩
      let _ : Field (κ_f j₀) := hFieldκ j₀
      have hp₀_bot : p₀.asIdeal = ⊥ := eq_bot_iff.mpr fun x hx => by
        by_contra hx0
        exact p₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (isUnit_iff_ne_zero.mpr hx0))
      have hQbar_eq : Q_bar = Ideal.comap (Pi.evalRingHom κ_f j₀) ⊥ := by
        have h1 : Q_bar = Ideal.comap (Pi.evalRingHom κ_f j₀) p₀.asIdeal :=
          (congrArg PrimeSpectrum.asIdeal hp₀_eq).symm
        rwa [hp₀_bot] at h1
      have hQ_iff : ∀ t : T, t ∈ Q ↔ q_T t j₀ = 0 := by
        intro t
        rw [← hQ_comap_qT, Ideal.mem_comap, hQbar_eq, Ideal.mem_comap, Pi.evalRingHom_apply, Ideal.mem_bot]
      let _ : DecidableEq J := Classical.decEq J
      obtain ⟨u₀, hu₀⟩ := hqT_surj (Pi.single j₀ 1)
      have hu₀_not_Q : u₀ ∉ Q := by
        rw [hQ_iff, hu₀, Pi.single_eq_same]
        exact one_ne_zero
      have hu₀_mul : ∀ t ∈ Q, u₀ * t ∈ Ideal.span {ϖ_T} := by
        intro t ht
        rw [← hJ_ϖ_eq, ← hker_qT, RingHom.mem_ker, map_mul, hu₀]
        ext j
        simp only [Pi.mul_apply, Pi.zero_apply]
        by_cases hj : j = j₀
        · subst hj
          rw [(hQ_iff t).mp ht, mul_zero]
        · rw [Pi.single_eq_of_ne hj, zero_mul]
      let π : A := algebraMap T A ϖ_T
      have hmaxA : IsLocalRing.maximalIdeal A = Ideal.span {π} := by
        apply le_antisymm
        · intro y hy
          obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj Q.primeCompl y
          have htA_mem : algebraMap T A t ∈ IsLocalRing.maximalIdeal A := by
            rw [← hts]
            exact (IsLocalRing.maximalIdeal A).mul_mem_right _ hy
          have ht_Q : t ∈ Q := by
            rw [← IsLocalization.AtPrime.under_maximalIdeal A Q]
            exact htA_mem
          obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (hu₀_mul t ht_Q)
          have hu_unit : IsUnit (algebraMap T A u₀ * algebraMap T A s) :=
            (IsLocalization.map_units A (⟨u₀, hu₀_not_Q⟩ : Q.primeCompl)).mul (IsLocalization.map_units A s)
          obtain ⟨v, hv⟩ := hu_unit.exists_left_inv
          rw [Ideal.mem_span_singleton]
          refine ⟨v * algebraMap T A c, ?_⟩
          calc y = (v * (algebraMap T A u₀ * algebraMap T A s)) * y := by rw [hv, one_mul]
            _ = v * (algebraMap T A u₀ * (y * algebraMap T A s)) := by ring
            _ = v * (algebraMap T A u₀ * algebraMap T A t) := by rw [hts]
            _ = v * algebraMap T A (u₀ * t) := by rw [← map_mul]
            _ = v * algebraMap T A (ϖ_T * c) := by rw [hc]
            _ = π * (v * algebraMap T A c) := by rw [map_mul]; ring
        · apply Ideal.span_le.mpr
          rw [Set.singleton_subset_iff]
          change ϖ_T ∈ Ideal.under T (IsLocalRing.maximalIdeal A)
          rw [IsLocalization.AtPrime.under_maximalIdeal A Q]
          exact hϖT_mem
      have _ : Module.Flat R T := inferInstance
      have _ : Module.IsTorsionFree R T := Module.Flat.isTorsionFree
      have hπ_nzd : ∀ z : A, π * z = 0 → z = 0 := by
        intro z hz
        obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj Q.primeCompl z
        have h0 : algebraMap T A (ϖ_T * t) = algebraMap T A 0 := by
          rw [map_mul, map_zero, ← hts]
          calc π * (z * algebraMap T A s) = (π * z) * algebraMap T A s := by ring
            _ = 0 := by rw [hz, zero_mul]
        obtain ⟨s', hs'⟩ := (IsLocalization.eq_iff_exists Q.primeCompl A).mp h0
        have hsmul0 : ϖ • (s'.1 * t) = 0 := by
          rw [Algebra.smul_def]
          calc ϖ_T * (s'.1 * t) = s'.1 * (ϖ_T * t) := by ring
            _ = s'.1 * 0 := hs'
            _ = 0 := mul_zero _
        have hst0 : s'.1 * t = 0 := (smul_eq_zero.mp hsmul0).resolve_left hϖ_ne
        have hunit : IsUnit (algebraMap T A s' * algebraMap T A s) :=
          (IsLocalization.map_units A s').mul (IsLocalization.map_units A s)
        obtain ⟨v, hv⟩ := hunit.exists_left_inv
        calc z = (v * (algebraMap T A s' * algebraMap T A s)) * z := by rw [hv, one_mul]
          _ = v * (algebraMap T A s' * (z * algebraMap T A s)) := by ring
          _ = v * algebraMap T A (s'.1 * t) := by rw [hts, ← map_mul]
          _ = 0 := by rw [hst0, map_zero, mul_zero]
      have hπ_pow_nzd : ∀ (m : ℕ) (z : A), π ^ m * z = 0 → z = 0 := by
        intro m
        induction m with
        | zero => intro z hz; simpa using hz
        | succ m ih =>
          intro z hz
          rw [pow_succ, mul_assoc] at hz
          exact hπ_nzd z (ih (π * z) hz)
      have _ : Algebra.FiniteType R T := inferInstance
      have _ : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing R T
      have _ : IsNoetherianRing A := IsLocalization.isNoetherianRing Q.primeCompl A inferInstance
      have hiInf : (⨅ n : ℕ, Ideal.span {π ^ n}) = (⊥ : Ideal A) := by
        have h := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal A)
          (IsLocalRing.maximalIdeal.isMaximal A).ne_top
        simpa only [hmaxA, Ideal.span_singleton_pow] using h
      have h_factor : ∀ x : A, x ≠ 0 → ∃ (k : ℕ) (u : A), IsUnit u ∧ x = π ^ k * u := by
        intro x hx
        classical
        have hx_not_iInf : x ∉ (⨅ n : ℕ, Ideal.span {π ^ n}) := by
          rw [hiInf, Ideal.mem_bot]
          exact hx
        rw [Ideal.mem_iInf] at hx_not_iInf
        have hexN : ∃ N : ℕ, x ∉ Ideal.span {π ^ N} := not_forall.mp hx_not_iInf
        obtain ⟨N, hN⟩ := hexN
        have h_ex : ∃ k : ℕ, x ∉ Ideal.span {π ^ (k + 1)} := by
          cases N with
          | zero =>
            exfalso
            apply hN
            rw [pow_zero, Ideal.span_singleton_one]
            trivial
          | succ k => exact ⟨k, hN⟩
        let k := Nat.find h_ex
        have hk_not : x ∉ Ideal.span {π ^ (k + 1)} := Nat.find_spec h_ex
        have hk_mem : x ∈ Ideal.span {π ^ k} := by
          cases h_k : k with
          | zero => rw [pow_zero, Ideal.span_singleton_one]; trivial
          | succ k' =>
            by_contra h_not
            have hlt : k' < k := by omega
            exact Nat.find_min h_ex hlt (h_k ▸ h_not)
        obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hk_mem
        have hu_not_max : u ∉ IsLocalRing.maximalIdeal A := by
          rw [hmaxA, Ideal.mem_span_singleton]
          rintro ⟨v, rfl⟩
          apply hk_not
          rw [Ideal.mem_span_singleton]
          exact ⟨v, by rw [hu_eq, pow_succ]; ring⟩
        exact ⟨k, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_max, hu_eq⟩
      have h_nzd_A : NoZeroDivisors A := ⟨fun {x y} hxy => by
        by_cases hx : x = 0
        · exact Or.inl hx
        · by_cases hy : y = 0
          · exact Or.inr hy
          · exfalso
            obtain ⟨k, u, hu, rfl⟩ := h_factor x hx
            obtain ⟨l, v, hv, rfl⟩ := h_factor y hy
            have huv : u * v = 0 := hπ_pow_nzd (k + l) (u * v) (by
              calc π ^ (k + l) * (u * v) = (π ^ k * u) * (π ^ l * v) := by rw [pow_add]; ring
                _ = 0 := hxy)
            exact (hu.mul hv).ne_zero huv⟩
      let hDomA : IsDomain A := @NoZeroDivisors.to_isDomain A _ inferInstance h_nzd_A
      have hπ_ne : π ≠ 0 := fun h0 => one_ne_zero (hπ_nzd 1 (by rw [h0, zero_mul]))
      have hNotFieldA : ¬ IsField A := by
        rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmaxA]
        intro hbot
        exact hπ_ne (Ideal.mem_bot.mp (hbot ▸ Ideal.mem_span_singleton_self π))
      have hPrinA : (IsLocalRing.maximalIdeal A).IsPrincipal := ⟨⟨π, hmaxA⟩⟩
      have hTFAE_A : (IsLocalRing.maximalIdeal A).IsPrincipal ↔
          (IsIntegrallyClosed A ∧ ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime) :=
        (IsDiscreteValuationRing.TFAE A hNotFieldA).out 5 4
      have hNormA : IsIntegrallyClosed A :=
        (hTFAE_A.mp hPrinA).1
      exact ⟨hDomA, hNormA⟩

  
  have h_s4 : ∀ (B : Type u) [CommRing B] (b₀ y : B) (n : ℕ) (c : ℕ → B),
      y ^ n + ∑ k ∈ Finset.range n, c k * b₀ ^ (n - k) * y ^ k = 0 →
      (∀ (Q : Ideal B) [Q.IsPrime],
        IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q) ∧
        algebraMap B (Localization.AtPrime Q) b₀ ≠ 0) →
      y ∈ Ideal.span {b₀} := by
    intro B _ b₀ y n c h_eq h_loc
    by_contra hy_not
    let J : Ideal B :=
      { carrier := {s : B | s * y ∈ Ideal.span {b₀}}
        add_mem' := fun {a b} ha hb => by
          change (a + b) * y ∈ Ideal.span {b₀}; rw [add_mul]; exact (Ideal.span {b₀}).add_mem ha hb
        zero_mem' := by change 0 * y ∈ Ideal.span {b₀}; rw [zero_mul]; exact (Ideal.span {b₀}).zero_mem
        smul_mem' := fun r {a} ha => by
          change (r • a) * y ∈ Ideal.span {b₀}; rw [smul_eq_mul, mul_assoc]; exact (Ideal.span {b₀}).mul_mem_left r ha }
    have hJ_ne_top : J ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one]
      intro h1
      change 1 * y ∈ Ideal.span {b₀} at h1
      rw [one_mul] at h1
      exact hy_not h1
    obtain ⟨Q, hQ_max, hJ_le_Q⟩ := Ideal.exists_le_maximal J hJ_ne_top
    let _ : Q.IsPrime := hQ_max.isPrime
    let A_Q : Type u := Localization.AtPrime Q
    obtain ⟨hDomQ, hNormQ, hb₀_ne⟩ := h_loc Q
    let _ : IsDomain A_Q := hDomQ
    let _ : IsIntegrallyClosed A_Q := hNormQ
    let f_Q : B →+* A_Q := algebraMap B A_Q
    let F_Q : Type u := FractionRing A_Q
    let ι_Q : A_Q →+* F_Q := algebraMap A_Q F_Q
    have hιQ_inj : Function.Injective ι_Q := IsFractionRing.injective A_Q F_Q
    have hιb₀_ne : ι_Q (f_Q b₀) ≠ 0 := fun h0 => hb₀_ne (hιQ_inj (h0.trans (map_zero ι_Q).symm))
    let q : F_Q := ι_Q (f_Q y) / ι_Q (f_Q b₀)
    have hq_mul : q * ι_Q (f_Q b₀) = ι_Q (f_Q y) := div_mul_cancel₀ _ hιb₀_ne
    let P_Q : Polynomial A_Q :=
      Polynomial.X ^ n + ∑ k ∈ Finset.range n, Polynomial.C (f_Q (c k)) * Polynomial.X ^ k
    have hPQ_monic : P_Q.Monic := Polynomial.monic_X_pow_add (by
      calc (∑ k ∈ Finset.range n, Polynomial.C (f_Q (c k)) * Polynomial.X ^ k).degree
          ≤ (Finset.range n).sup (fun k => (Polynomial.C (f_Q (c k)) * Polynomial.X ^ k).degree) :=
            Polynomial.degree_sum_le _ _
        _ < (n : WithBot ℕ) := (Finset.sup_lt_iff (WithBot.bot_lt_coe n)).mpr fun k hk =>
            (Polynomial.degree_C_mul_X_pow_le k _).trans_lt (WithBot.coe_lt_coe.mpr (Finset.mem_range.mp hk)))
    have hPQ_eval : Polynomial.eval₂ ι_Q q P_Q = 0 := by
      have hmul_zero : Polynomial.eval₂ ι_Q q P_Q * ι_Q (f_Q b₀) ^ n = 0 := by
        simp only [P_Q, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
          Polynomial.eval₂_mul, Polynomial.eval₂_C]
        rw [add_mul, Finset.sum_mul, ← mul_pow, hq_mul]
        have hsum_eq : (∑ k ∈ Finset.range n, ι_Q (f_Q (c k)) * q ^ k * ι_Q (f_Q b₀) ^ n) =
            ∑ k ∈ Finset.range n, ι_Q (f_Q (c k * b₀ ^ (n - k) * y ^ k)) := by
          refine Finset.sum_congr rfl fun k hk => ?_
          have hkn : n - k + k = n := Nat.sub_add_cancel (Nat.le_of_lt (Finset.mem_range.mp hk))
          calc ι_Q (f_Q (c k)) * q ^ k * ι_Q (f_Q b₀) ^ n
              = ι_Q (f_Q (c k)) * q ^ k * (ι_Q (f_Q b₀) ^ (n - k) * ι_Q (f_Q b₀) ^ k) := by
                rw [← pow_add, hkn]
            _ = ι_Q (f_Q (c k)) * ι_Q (f_Q b₀) ^ (n - k) * (q * ι_Q (f_Q b₀)) ^ k := by
                rw [mul_pow]; ring
            _ = ι_Q (f_Q (c k * b₀ ^ (n - k) * y ^ k)) := by
                rw [hq_mul]; simp only [map_mul, map_pow]
        rw [hsum_eq, ← map_pow, ← map_pow, ← map_sum, ← map_sum, ← map_add, ← map_add, h_eq, map_zero, map_zero]
      exact (mul_eq_zero.mp hmul_zero).resolve_right (pow_ne_zero n hιb₀_ne)
    have hq_int : IsIntegral A_Q q := ⟨P_Q, hPQ_monic, hPQ_eval⟩
    obtain ⟨a_Q, ha_Q⟩ := (isIntegrallyClosed_iff F_Q).mp hNormQ hq_int
    have hy_eq : f_Q y = a_Q * f_Q b₀ := hιQ_inj (by rw [map_mul, ha_Q, hq_mul])
    obtain ⟨⟨t, u₁⟩, htu₁⟩ := IsLocalization.surj Q.primeCompl a_Q
    have hfQ_eq : f_Q (u₁.1 * y) = f_Q (t * b₀) := by
      calc f_Q (u₁.1 * y) = f_Q u₁.1 * (a_Q * f_Q b₀) := by rw [map_mul, hy_eq]
        _ = (a_Q * f_Q u₁.1) * f_Q b₀ := by ring
        _ = f_Q (t * b₀) := by rw [htu₁, map_mul]
    obtain ⟨u₂, hu₂⟩ := (IsLocalization.eq_iff_exists Q.primeCompl A_Q).mp hfQ_eq
    have hu_mem_J : (u₂ * u₁).1 ∈ J := by
      change (u₂.1 * u₁.1) * y ∈ Ideal.span {b₀}
      rw [mul_assoc, hu₂, Ideal.mem_span_singleton]
      exact ⟨u₂.1 * t, by ring⟩
    exact (u₂ * u₁).2 (hJ_le_Q hu_mem_J)

  
  have h_s5 : ∀ (I : Type u) [Finite I] (L : I → Type u) [∀ i : I, Field (L i)]
      (φ : S →+* (∀ i : I, L i)),
      Function.Injective φ →
      (∀ z : (∀ i : I, L i), (∃ p : Polynomial S, p.Monic ∧ Polynomial.eval₂ φ z p = 0) → z ∈ Set.range φ) →
      ∃ e : S, e ∉ P ∧ IsDomain (Localization.Away e) ∧ IsIntegrallyClosed (Localization.Away e) := by
    intro I _ L _ φ hφ_inj hIntClosed
    let _ : Fintype I := Fintype.ofFinite I
    let _ : DecidableEq I := Classical.decEq I
    have h_idem_ex : ∃ (i₀ : I) (e : S), e ∉ P ∧ φ e = Pi.single i₀ 1 := by
      have h_idem : ∀ i : I, ∃ e_i : S, φ e_i = Pi.single i 1 := by
        intro i
        let v_i : ∀ j : I, L j := Pi.single i 1
        let p_idem : Polynomial S := Polynomial.X ^ 2 + Polynomial.C (-1 : S) * Polynomial.X ^ 1
        have hp_monic : p_idem.Monic := Polynomial.monic_X_pow_add
          ((Polynomial.degree_C_mul_X_pow_le 1 (-1 : S)).trans_lt (WithBot.coe_lt_coe.mpr (by omega)))
        have hp_eval : Polynomial.eval₂ φ v_i p_idem = 0 := by
          simp only [p_idem, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_mul,
            pow_one, map_neg, map_one]
          ext j
          simp only [Pi.add_apply, Pi.pow_apply, Pi.mul_apply, Pi.zero_apply, v_i]
          by_cases hj : j = i
          · subst hj; simp
          · simp [hj]
        exact hIntClosed v_i ⟨p_idem, hp_monic, hp_eval⟩
      choose e_tilde he_tilde using h_idem
      have hsum_one : ∑ i : I, e_tilde i = 1 := hφ_inj (by
        rw [map_sum, map_one]
        ext j
        simp only [Finset.sum_apply, Pi.one_apply, he_tilde]
        rw [Finset.sum_eq_single j]
        · exact Pi.single_eq_same j 1
        · intro i _ hij; exact Pi.single_eq_of_ne hij.symm 1
        · intro hj; exact False.elim (hj (Finset.mem_univ j)))
      have hex_not_P : ∃ i₀ : I, e_tilde i₀ ∉ P := by
        by_contra h_all
        have h1_mem : (1 : S) ∈ P := by
          rw [← hsum_one]
          exact P.sum_mem fun i _ => not_not.mp (not_exists.mp h_all i)
        exact P.ne_top_iff_one.mp (Ideal.IsPrime.ne_top inferInstance) h1_mem
      obtain ⟨i₀, hi₀_not_P⟩ := hex_not_P
      exact ⟨i₀, e_tilde i₀, hi₀_not_P, he_tilde i₀⟩
    obtain ⟨i₀, e, he_not_P, he_φ⟩ := h_idem_ex
    let B_e : Type u := Localization.Away e
    let g_i₀ : S →+* L i₀ := (Pi.evalRingHom L i₀).comp φ
    have hg_e : g_i₀ e = 1 := by
      change φ e i₀ = 1
      rw [he_φ, Pi.single_eq_same]
    have hg_unit : IsUnit (g_i₀ e) := hg_e ▸ isUnit_one
    let ψ : B_e →+* L i₀ := IsLocalization.Away.lift e hg_unit
    have hψ_alg : ∀ s : S, ψ (algebraMap S B_e s) = φ s i₀ := fun s =>
      IsLocalization.Away.lift_eq e hg_unit s
    have hψ_inj : Function.Injective ψ := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨m, s, hms⟩ := IsLocalization.Away.surj e x
      have hφs_zero : φ s i₀ = 0 := by
        have h1 := congrArg ψ hms
        rw [map_mul, hx, zero_mul, hψ_alg] at h1
        exact h1.symm
      have hes_zero : e * s = 0 := hφ_inj (by
        rw [map_mul, map_zero]
        ext j
        simp only [Pi.mul_apply, Pi.zero_apply, he_φ]
        by_cases hj : j = i₀
        · subst hj; rw [Pi.single_eq_same, one_mul, hφs_zero]
        · rw [Pi.single_eq_of_ne hj, zero_mul])
      have hx_pow_zero : x * (algebraMap S B_e e) ^ (m + 1) = 0 := by
        calc x * (algebraMap S B_e e) ^ (m + 1)
            = (x * (algebraMap S B_e e) ^ m) * algebraMap S B_e e := by rw [pow_succ, mul_assoc]
          _ = algebraMap S B_e (e * s) := by rw [hms, ← map_mul, mul_comm]
          _ = 0 := by rw [hes_zero, map_zero]
      have he_pow_unit : IsUnit ((algebraMap S B_e e) ^ (m + 1)) :=
        (IsLocalization.Away.algebraMap_isUnit (S := B_e) e).pow (m + 1)
      obtain ⟨v, hv⟩ := he_pow_unit.exists_right_inv
      rw [Ideal.mem_bot]
      calc x = x * ((algebraMap S B_e e) ^ (m + 1) * v) := by rw [hv, mul_one]
        _ = (x * (algebraMap S B_e e) ^ (m + 1)) * v := by ring
        _ = 0 := by rw [hx_pow_zero, zero_mul]
    let hDom_e : IsDomain B_e := Function.Injective.isDomain ψ hψ_inj
    have hNorm_e : IsIntegrallyClosed B_e := by
      let F_e : Type u := FractionRing B_e
      let ψ_frac : F_e →+* L i₀ := IsFractionRing.lift (K := F_e) hψ_inj
      have hψ_frac_inj : Function.Injective ψ_frac := ψ_frac.injective
      rw [isIntegrallyClosed_iff F_e]
      intro q hq
      obtain ⟨P_B, hPB_monic, hPB_eval⟩ := hq
      let d := P_B.natDegree
      let y : L i₀ := ψ_frac q
      have hcomp_eq : ψ_frac.comp (algebraMap B_e F_e) = ψ :=
        RingHom.ext fun b => IsFractionRing.lift_algebraMap (K := F_e) hψ_inj b
      have hy_eval : Polynomial.eval₂ ψ y P_B = 0 := by
        have h1 := (Polynomial.hom_eval₂ P_B (algebraMap B_e F_e) ψ_frac q).symm
        rwa [hPB_eval, map_zero, hcomp_eq] at h1
      have hy_sum : y ^ d + ∑ k ∈ Finset.range d, ψ (P_B.coeff k) * y ^ k = 0 := by
        rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hPB_monic.coeff_natDegree,
          map_one, one_mul, add_comm] at hy_eval
        exact hy_eval
      have h_coeff : ∀ k : ℕ, ∃ s_k : S, ψ (P_B.coeff k) = φ s_k i₀ := by
        intro k
        obtain ⟨m_k, s_k, hmk⟩ := IsLocalization.Away.surj e (P_B.coeff k)
        refine ⟨s_k, ?_⟩
        have h1 := congrArg ψ hmk
        rw [map_mul, map_pow, hψ_alg e, he_φ, Pi.single_eq_same, one_pow, mul_one, hψ_alg s_k] at h1
        exact h1
      choose s_coeff hs_coeff using h_coeff
      let z : ∀ j : I, L j := Pi.single i₀ y
      let Q_S : Polynomial S :=
        Polynomial.X * (Polynomial.X ^ d + ∑ k ∈ Finset.range d, Polynomial.C (s_coeff k) * Polynomial.X ^ k)
      have hQS_monic : Q_S.Monic := Polynomial.monic_X.mul (Polynomial.monic_X_pow_add (by
        calc (∑ k ∈ Finset.range d, Polynomial.C (s_coeff k) * Polynomial.X ^ k).degree
            ≤ (Finset.range d).sup (fun k => (Polynomial.C (s_coeff k) * Polynomial.X ^ k).degree) :=
              Polynomial.degree_sum_le _ _
          _ < (d : WithBot ℕ) := (Finset.sup_lt_iff (WithBot.bot_lt_coe d)).mpr fun k hk =>
              (Polynomial.degree_C_mul_X_pow_le k _).trans_lt (WithBot.coe_lt_coe.mpr (Finset.mem_range.mp hk))))
      have hQS_eval : Polynomial.eval₂ φ z Q_S = 0 := by
        simp only [Q_S, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_add,
          Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum, Polynomial.eval₂_C]
        ext j
        simp only [Pi.mul_apply, Pi.add_apply, Pi.pow_apply, Finset.sum_apply, Pi.zero_apply, z]
        by_cases hj : j = i₀
        · subst hj
          simp only [Pi.single_eq_same, ← hs_coeff]
          rw [hy_sum, mul_zero]
        · rw [Pi.single_eq_of_ne hj, zero_mul]
      obtain ⟨s_star, hs_star⟩ := hIntClosed z ⟨Q_S, hQS_monic, hQS_eval⟩
      refine ⟨algebraMap S B_e s_star, hψ_frac_inj ?_⟩
      rw [show ψ_frac (algebraMap B_e F_e (algebraMap S B_e s_star)) = ψ (algebraMap S B_e s_star) from
        IsFractionRing.lift_algebraMap (K := F_e) hψ_inj _, hψ_alg, hs_star]
      exact Pi.single_eq_same i₀ y
    exact ⟨e, he_not_P, hDom_e, hNorm_e⟩

  
  let φ_D : D →+* S := algebraMap D S
  let M_D : Submonoid S := Algebra.algebraMapSubmonoid S (nonZeroDivisors D)
  let S_K : Type u := Localization M_D
  let ι_S : S →+* S_K := algebraMap S S_K
  have _ : Module.Flat D S := inferInstance
  have _ : Module.IsTorsionFree D S := Module.Flat.isTorsionFree
  have hM_nzd : M_D ≤ nonZeroDivisors S := by
    rintro _ ⟨d, hd_nzd, rfl⟩
    rw [mem_nonZeroDivisors_iff_right]
    intro s hs
    have hd_ne : d ≠ 0 := nonZeroDivisors.ne_zero hd_nzd
    have hsmul : d • s = 0 := by rw [Algebra.smul_def, mul_comm, hs]
    exact (smul_eq_zero.mp hsmul).resolve_left hd_ne
  have hι_inj : Function.Injective ι_S := IsLocalization.injective S_K hM_nzd
  let K : Type u := FractionRing D
  let _ : IsLocalization M_D (TensorProduct D S K) := IsLocalization.tensor K (nonZeroDivisors D)
  have hEt_K : Algebra.Etale K (TensorProduct D K S) := inferInstance
  obtain ⟨I, hFinI, L, hFieldL, hAlgL, Φ_T, _⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod K (TensorProduct D K S)).mp hEt_K
  let Φ_ring : S_K ≃+* (∀ i : I, L i) :=
    (IsLocalization.algEquiv M_D S_K (TensorProduct D S K)).toRingEquiv.trans
      ((Algebra.TensorProduct.comm D S K).toRingEquiv.trans Φ_T.toRingEquiv)
  let φ : S →+* (∀ i : I, L i) := Φ_ring.toRingHom.comp ι_S
  have hφ_inj : Function.Injective φ := Φ_ring.injective.comp hι_inj

  
  have hIntClosed : ∀ z₀ : (∀ i : I, L i),
      (∃ p : Polynomial S, p.Monic ∧ Polynomial.eval₂ φ z₀ p = 0) → z₀ ∈ Set.range φ := by
    rintro z₀ ⟨p_poly, hp_monic, hp_eval⟩
    let z : S_K := Φ_ring.symm z₀
    have hz_eval : Polynomial.eval₂ ι_S z p_poly = 0 := by
      have h1 := (Polynomial.hom_eval₂ p_poly φ Φ_ring.symm.toRingHom z₀).symm
      have hcomp : Φ_ring.symm.toRingHom.comp φ = ι_S := by
        ext s; simp [φ]
      rwa [hp_eval, map_zero, hcomp] at h1
    obtain ⟨⟨x, m₀⟩, hxm₀⟩ := IsLocalization.surj M_D z
    obtain ⟨d₀, hd₀_nzd, hm₀_eq⟩ := m₀.2
    have hd₀_ne : d₀ ≠ 0 := nonZeroDivisors.ne_zero hd₀_nzd
    have hzx : z * ι_S (φ_D d₀) = ι_S x := by
      change z * (algebraMap S S_K) ((algebraMap D S) d₀) = (algebraMap S S_K) x
      rw [hm₀_eq]
      exact hxm₀
    let n := p_poly.natDegree
    have hx_homog : x ^ n + ∑ k ∈ Finset.range n, p_poly.coeff k * φ_D d₀ ^ (n - k) * x ^ k = 0 := by
      apply hι_inj
      rw [map_zero, map_add, map_pow, map_sum]
      have hz_sum : z ^ n + ∑ k ∈ Finset.range n, ι_S (p_poly.coeff k) * z ^ k = 0 := by
        rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hp_monic.coeff_natDegree,
          map_one, one_mul, add_comm] at hz_eval
        exact hz_eval
      have hmul := congrArg (· * ι_S (φ_D d₀) ^ n) hz_sum
      rw [zero_mul, add_mul, Finset.sum_mul, ← mul_pow, hzx] at hmul
      rw [← hmul]
      congr 1
      refine Finset.sum_congr rfl fun k hk => ?_
      have hkn : n - k + k = n := Nat.sub_add_cancel (Nat.le_of_lt (Finset.mem_range.mp hk))
      calc ι_S (p_poly.coeff k * φ_D d₀ ^ (n - k) * x ^ k)
          = ι_S (p_poly.coeff k) * ι_S (φ_D d₀) ^ (n - k) * (z * ι_S (φ_D d₀)) ^ k := by
            rw [hzx]; simp only [map_mul, map_pow]
        _ = ι_S (p_poly.coeff k) * z ^ k * (ι_S (φ_D d₀) ^ (n - k) * ι_S (φ_D d₀) ^ k) := by
            rw [mul_pow]; ring
        _ = ι_S (p_poly.coeff k) * z ^ k * ι_S (φ_D d₀) ^ n := by
            rw [← pow_add, hkn]
    have hx_mem : x ∈ Ideal.span {φ_D d₀} := by
      by_contra hx_not_mem
      let I_d₀ : Ideal S := Ideal.span {φ_D d₀}
      let M : Type u := S ⧸ I_d₀
      let bar_x : M := Ideal.Quotient.mk I_d₀ x
      have hbar_x_ne : bar_x ≠ 0 := fun h0 => hx_not_mem ((Ideal.Quotient.eq_zero_iff_mem (I := I_d₀)).mp h0)
      obtain ⟨p, hp_assoc, hcolon_le⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing D bar_x hbar_x_ne
      obtain ⟨hp_prime, f_inj, hf_inj⟩ := (isAssociatedPrime_iff_exists_injective_linearMap p M).mp hp_assoc
      let _ : p.IsPrime := hp_prime
      obtain ⟨w₀, hw₀⟩ := Ideal.Quotient.mk_surjective (f_inj 1)
      have hw₀_iff : ∀ a : D, a ∈ p ↔ φ_D a * w₀ ∈ I_d₀ := by
        intro a
        rw [← Ideal.Quotient.eq_zero_iff_mem (I := p), ← Ideal.Quotient.eq_zero_iff_mem (I := I_d₀)]
        have h1 : Ideal.Quotient.mk I_d₀ (φ_D a * w₀) = f_inj (Ideal.Quotient.mk p a) := by
          calc Ideal.Quotient.mk I_d₀ (φ_D a * w₀)
              = a • Ideal.Quotient.mk I_d₀ w₀ := by rw [Algebra.smul_def]; rfl
            _ = a • f_inj 1 := by rw [hw₀]
            _ = f_inj (a • (1 : D ⧸ p)) := (f_inj.map_smul a 1).symm
            _ = f_inj (Ideal.Quotient.mk p a) := by congr 1; rw [Algebra.smul_def, mul_one]; rfl
        rw [h1, map_eq_zero_iff f_inj hf_inj]
      have hd₀_mem_p : d₀ ∈ p := hcolon_le (Submodule.mem_colon_singleton.mpr (by
        rw [Submodule.mem_bot, Algebra.smul_def]
        change Ideal.Quotient.mk I_d₀ (φ_D d₀ * x) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton.mpr ⟨x, rfl⟩))
      let R : Type u := Localization.AtPrime p
      let _ : IsNoetherianRing R := IsLocalization.isNoetherianRing p.primeCompl R inferInstance
      let _ : IsIntegrallyClosed R :=
        isIntegrallyClosed_of_isLocalization R p.primeCompl p.primeCompl_le_nonZeroDivisors
      let S_p : Type u := TensorProduct D R S
      let ι_p : S →+* S_p := Algebra.TensorProduct.includeRight.toRingHom
      let r₀ : R := algebraMap D R d₀
      have hr₀_ne : r₀ ≠ 0 := by
        have hinj : Function.Injective (algebraMap D R) :=
          IsLocalization.injective R p.primeCompl_le_nonZeroDivisors
        exact fun h0 => hd₀_ne (hinj (h0.trans (map_zero _).symm))
      have h_under_R : Ideal.under D (IsLocalRing.maximalIdeal R) = p :=
        IsLocalization.AtPrime.under_maximalIdeal R p
      have hr₀_mem : r₀ ∈ IsLocalRing.maximalIdeal R := by
        change d₀ ∈ Ideal.under D (IsLocalRing.maximalIdeal R)
        rwa [h_under_R]
      let b₀ : S_p := algebraMap R S_p r₀
      have hb₀_eq : b₀ = ι_p (φ_D d₀) := by
        have hd₀_one : algebraMap D R d₀ = d₀ • (1 : R) := by rw [Algebra.smul_def, mul_one]
        change (algebraMap D R d₀) ⊗ₜ[D] (1 : S) = (1 : R) ⊗ₜ[D] (φ_D d₀)
        rw [hd₀_one, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      let M_p : Submonoid S := Algebra.algebraMapSubmonoid S p.primeCompl
      let T' : Type u := TensorProduct D S R
      let _ : IsLocalization M_p T' := IsLocalization.tensor R p.primeCompl
      let e_comm : S_p ≃+* T' := (Algebra.TensorProduct.comm D R S).toRingEquiv
      have h_clear : ∀ y : S, ι_p y ∈ Ideal.span {b₀} → ∃ u ∈ p.primeCompl, φ_D u * y ∈ I_d₀ := by
        intro y hy
        obtain ⟨z_sp, hz_sp⟩ := Ideal.mem_span_singleton.mp hy
        have hT' : algebraMap S T' y = algebraMap S T' (φ_D d₀) * e_comm z_sp := by
          have h1 := congrArg e_comm hz_sp
          rw [map_mul, hb₀_eq] at h1
          exact h1
        obtain ⟨⟨t, m₁⟩, htm₁⟩ := IsLocalization.surj M_p (e_comm z_sp)
        obtain ⟨u₁, hu₁, hm₁_eq⟩ := m₁.2
        have h_alg_eq : algebraMap S T' (φ_D u₁ * y) = algebraMap S T' (φ_D d₀ * t) := by
          calc algebraMap S T' (φ_D u₁ * y)
              = algebraMap S T' m₁.1 * (algebraMap S T' (φ_D d₀) * e_comm z_sp) := by
                change algebraMap S T' ((algebraMap D S u₁) * y) = _
                rw [hm₁_eq, map_mul, hT']
            _ = algebraMap S T' (φ_D d₀) * (e_comm z_sp * algebraMap S T' m₁.1) := by ring
            _ = algebraMap S T' (φ_D d₀ * t) := by rw [htm₁, map_mul]
        obtain ⟨m₂, hm₂⟩ := (IsLocalization.eq_iff_exists M_p T').mp h_alg_eq
        obtain ⟨u₂, hu₂, hm₂_eq⟩ := m₂.2
        refine ⟨u₂ * u₁, p.primeCompl.mul_mem hu₂ hu₁, ?_⟩
        have h_eq2 : φ_D u₂ * (φ_D u₁ * y) = m₂.1 * (φ_D d₀ * t) := by
          change (algebraMap D S) u₂ * (φ_D u₁ * y) = m₂.1 * (φ_D d₀ * t)
          rw [hm₂_eq, hm₂]
        rw [map_mul, mul_assoc, h_eq2]
        exact Ideal.mem_span_singleton.mpr ⟨m₂.1 * t, by ring⟩
      let w : S_p := ι_p w₀
      have hw_not_mem : w ∉ Ideal.span {b₀} := by
        intro hw_mem
        obtain ⟨u, hu_not_p, hu_mem⟩ := h_clear w₀ hw_mem
        exact hu_not_p ((hw₀_iff u).mpr hu_mem)
      have hw_ann : ∀ m ∈ IsLocalRing.maximalIdeal R, m • w ∈ Ideal.span {b₀} := by
        intro m hm
        obtain ⟨⟨a, u⟩, hau⟩ := IsLocalization.surj p.primeCompl m
        have ha_mem_R : algebraMap D R a ∈ IsLocalRing.maximalIdeal R := by
          rw [← hau]
          exact (IsLocalRing.maximalIdeal R).mul_mem_right _ hm
        have ha_p : a ∈ p := by
          rw [← h_under_R]
          exact ha_mem_R
        obtain ⟨s_a, hs_a⟩ := Ideal.mem_span_singleton.mp ((hw₀_iff a).mp ha_p)
        have hu_unit : IsUnit (algebraMap D R u) := IsLocalization.map_units R u
        obtain ⟨v_u, hv_u⟩ := hu_unit.exists_left_inv
        have h_auw : (algebraMap D R a) • w = b₀ * ι_p s_a := by
          have ha_one : algebraMap D R a = a • (1 : R) := by rw [Algebra.smul_def, mul_one]
          calc (algebraMap D R a) • ((1 : R) ⊗ₜ[D] w₀)
              = (algebraMap D R a) ⊗ₜ[D] w₀ := by
                rw [Algebra.smul_def (algebraMap D R a) ((1 : R) ⊗ₜ[D] w₀)]
                change ((algebraMap D R a) ⊗ₜ[D] (1 : S)) * ((1 : R) ⊗ₜ[D] w₀) = _
                rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            _ = (a • (1 : R)) ⊗ₜ[D] w₀ := by rw [← ha_one]
            _ = (1 : R) ⊗ₜ[D] (a • w₀) := TensorProduct.smul_tmul a 1 w₀
            _ = ι_p (φ_D a * w₀) := by rw [Algebra.smul_def]; rfl
            _ = ι_p (φ_D d₀ * s_a) := by rw [hs_a]
            _ = b₀ * ι_p s_a := by rw [hb₀_eq, map_mul]
        rw [Ideal.mem_span_singleton]
        refine ⟨v_u • ι_p s_a, ?_⟩
        have hm_eq : (v_u * algebraMap D R u) * m = v_u * (m * algebraMap D R u) := by ring
        calc m • w = ((v_u * algebraMap D R u) * m) • w := by rw [hv_u, one_mul]
          _ = v_u • ((m * algebraMap D R u) • w) := by rw [hm_eq, mul_smul]
          _ = v_u • ((algebraMap D R a) • w) := by rw [hau]
          _ = v_u • (b₀ * ι_p s_a) := by rw [h_auw]
          _ = b₀ * (v_u • ι_p s_a) := (mul_smul_comm v_u b₀ (ι_p s_a)).symm
      obtain ⟨ϖ, hϖ_ne, hmaxR⟩ := h_s2 R S_p r₀ hr₀_ne hr₀_mem w hw_not_mem hw_ann
      have _ : Module.Flat R S_p := inferInstance
      have _ : Module.IsTorsionFree R S_p := Module.Flat.isTorsionFree
      have h_loc_Sp : ∀ (Q : Ideal S_p) [Q.IsPrime],
          IsDomain (Localization.AtPrime Q) ∧
          IsIntegrallyClosed (Localization.AtPrime Q) ∧
          algebraMap S_p (Localization.AtPrime Q) b₀ ≠ 0 := by
        intro Q _
        obtain ⟨hDomQ, hNormQ⟩ := h_s3 R S_p ϖ hϖ_ne hmaxR Q
        refine ⟨hDomQ, hNormQ, ?_⟩
        intro hb₀_zero
        have h0 : algebraMap S_p (Localization.AtPrime Q) b₀ = algebraMap S_p (Localization.AtPrime Q) 0 := by
          rwa [map_zero]
        obtain ⟨s_q, hs_q⟩ := (IsLocalization.eq_iff_exists Q.primeCompl (Localization.AtPrime Q)).mp h0
        have hsmul0 : r₀ • s_q.1 = 0 := by
          rw [Algebra.smul_def r₀ s_q.1, mul_comm]
          exact hs_q.trans (mul_zero s_q.1)
        have hsq0 : s_q.1 = 0 := (smul_eq_zero.mp hsmul0).resolve_left hr₀_ne
        exact s_q.2 (hsq0 ▸ Q.zero_mem)
      have h_homog_Sp : (ι_p x) ^ n + ∑ k ∈ Finset.range n, ι_p (p_poly.coeff k) * b₀ ^ (n - k) * (ι_p x) ^ k = 0 := by
        have h1 := congrArg ι_p hx_homog
        simpa only [map_zero, map_add, map_pow, map_sum, map_mul, hb₀_eq] using h1
      have hιpx_mem : ι_p x ∈ Ideal.span {b₀} :=
        h_s4 S_p b₀ (ι_p x) n (fun k => ι_p (p_poly.coeff k)) h_homog_Sp h_loc_Sp
      obtain ⟨u, hu_not_p, hu_mem⟩ := h_clear x hιpx_mem
      have hu_in_p : u ∈ p := hcolon_le (Submodule.mem_colon_singleton.mpr (by
        rw [Submodule.mem_bot, Algebra.smul_def]
        change Ideal.Quotient.mk I_d₀ (φ_D u * x) = 0
        exact (Ideal.Quotient.eq_zero_iff_mem (I := I_d₀)).mpr hu_mem))
      exact hu_not_p hu_in_p
    obtain ⟨s₀, hs₀⟩ := Ideal.mem_span_singleton.mp hx_mem
    have hum₀ : IsUnit (ι_S m₀.1) := IsLocalization.map_units S_K m₀
    obtain ⟨v_m, hv_m⟩ := hum₀.exists_right_inv
    have hz_eq : z = ι_S s₀ := by
      calc z = z * (ι_S m₀.1 * v_m) := by rw [hv_m, mul_one]
        _ = (z * ι_S (φ_D d₀)) * v_m := by rw [← hm₀_eq, mul_assoc]
        _ = ι_S x * v_m := by rw [hzx]
        _ = (ι_S s₀ * ι_S m₀.1) * v_m := by rw [hs₀, map_mul, mul_comm (ι_S _) (ι_S s₀), hm₀_eq]
        _ = ι_S s₀ * (ι_S m₀.1 * v_m) := by ring
        _ = ι_S s₀ := by rw [hv_m, mul_one]
    refine ⟨s₀, ?_⟩
    change Φ_ring (ι_S s₀) = z₀
    rw [← hz_eq]
    exact Φ_ring.apply_symm_apply z₀

  exact h_s5 I L φ hφ_inj hIntClosed

theorem weil_smooth_relDimOne_affineNormal_nhds_over_normal_base (k : Type u) [Field k]
    (hEtNorm : ∀ (D S : Type u) [CommRing D] [CommRing S] [Algebra D S]
      [IsDomain D] [IsIntegrallyClosed D] [IsNoetherianRing D]
      [Algebra.Etale D S] (P : Ideal S) [P.IsPrime],
      ∃ (e : S), e ∉ P ∧
        IsDomain (Localization.Away e) ∧
        IsIntegrallyClosed (Localization.Away e))
    (B X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjB : IsProjectiveOverField k B)
    (hNormB : IsAffineNormalScheme B.left)
    (f_X : X ⟶ B)
    (W : X.left.Opens)
    (hSmW : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f_X.left))
    (x : ↥X.left) (hx : x ∈ W) :
    ∃ (U : X.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ U ≤ W ∧
      IsDomain ↑(X.left.presheaf.obj (Opposite.op U)) ∧
      IsIntegrallyClosed ↑(X.left.presheaf.obj (Opposite.op U)) :=
by
  have hLocNoethB : AlgebraicGeometry.IsLocallyNoetherian B.left := by
    obtain ⟨N, ι, hCl⟩ := hProjB
    let P := MvPolynomial (Fin (N + 1)) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz : z.1 ∈ (1 : Submodule k P) := by
        simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using z.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hz
      exact ⟨c, Subtype.ext hc⟩
    have : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hSurj₀
    have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0))) :=
      AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
    have : IsScalarTower k ↥(𝒜 0) P := ⟨fun c y p => smul_mul_assoc c (y : P) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) P :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) P
    have : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    have : AlgebraicGeometry.IsLocallyNoetherian (weilProjectiveSpaceOver k N).left := by
      change AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜)
      exact AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    exact AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian ι.left
  obtain ⟨U₀, hU₀, V'₀, hV'₀, hx'₀, e_map, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (W.ι ≫ f_X.left)).mp hSmW ⟨x, hx⟩
  have hbU₀ : (W.ι ≫ f_X.left).base ⟨x, hx⟩ ∈ U₀ := e_map hx'₀
  have hNonemptyU₀ : Nonempty U₀ := ⟨⟨_, hbU₀⟩⟩
  let D : Type u := ↑(B.left.presheaf.obj (Opposite.op U₀))
  obtain ⟨hDomD, hIntClD⟩ := hNormB U₀ hU₀ hNonemptyU₀
  have : IsDomain D := hDomD
  have : IsIntegrallyClosed D := hIntClD
  have : IsNoetherianRing D :=
    AlgebraicGeometry.IsLocallyNoetherian.component_noetherian ⟨U₀, hU₀⟩
  let V₀ : X.left.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor W.ι).obj V'₀
  have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hV'₀.image_of_isOpenImmersion W.ι
  have hV₀W : V₀ ≤ W :=
    (AlgebraicGeometry.Scheme.Hom.image_le_opensRange W.ι V'₀).trans_eq
      (AlgebraicGeometry.Scheme.Opens.opensRange_ι W)
  have hxV₀ : x ∈ V₀ := ⟨⟨x, hx⟩, hx'₀, AlgebraicGeometry.Scheme.Opens.ι_apply W ⟨x, hx⟩⟩
  let S' : Type u := ↑((↑W : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op V'₀))
  let S : Type u := ↑(X.left.presheaf.obj (Opposite.op V₀))
  let α : S' ≃+* S :=
    (AlgebraicGeometry.Scheme.Hom.appIso W.ι V'₀).symm.commRingCatIsoToRingEquiv
  obtain ⟨g_mv, _hg_comp, hg_mv⟩ :=
    RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
  let e_poly : Polynomial D ≃+* MvPolynomial (Fin 1) D :=
    (MvPolynomial.uniqueAlgEquiv D (Fin 1)).symm.toRingEquiv
  have he_poly : e_poly.toRingHom.Etale := RingHom.Etale.of_bijective e_poly.bijective
  have hα_et : α.toRingHom.Etale := RingHom.Etale.of_bijective α.bijective
  have hg₁ : (g_mv.comp e_poly.toRingHom).Etale :=
    RingHom.Etale.stableUnderComposition _ _ he_poly hg_mv
  let g : Polynomial D →+* S := α.toRingHom.comp (g_mv.comp e_poly.toRingHom)
  have hg : g.Etale :=
    RingHom.Etale.stableUnderComposition _ _ hg₁ hα_et
  let : Algebra (Polynomial D) S := g.toAlgebra
  have : Algebra.Etale (Polynomial D) S := hg.toAlgebra
  let P : Ideal S := (hV₀.primeIdealOf ⟨x, hxV₀⟩).asIdeal
  obtain ⟨e, heP, hDomLoc, hIntClLoc⟩ := hEtNorm (Polynomial D) S P
  let U : X.left.Opens := X.left.basicOpen e
  have hAffU : AlgebraicGeometry.IsAffineOpen U := hV₀.basicOpen e
  have hxU : x ∈ U := by
    have hMemSpec : hV₀.primeIdealOf ⟨x, hxV₀⟩ ∈ PrimeSpectrum.basicOpen e :=
      (PrimeSpectrum.mem_basicOpen e (hV₀.primeIdealOf ⟨x, hxV₀⟩)).mpr heP
    have hMemPre : hV₀.primeIdealOf ⟨x, hxV₀⟩ ∈
        (TopologicalSpace.Opens.map hV₀.fromSpec.base).obj (X.left.basicOpen e) := by
      rw [hV₀.fromSpec_preimage_basicOpen e]
      exact hMemSpec
    have hImgMem : hV₀.fromSpec.base (hV₀.primeIdealOf ⟨x, hxV₀⟩) ∈ X.left.basicOpen e :=
      hMemPre
    rw [hV₀.fromSpec_primeIdealOf ⟨x, hxV₀⟩] at hImgMem
    exact hImgMem
  have hUW : U ≤ W := le_trans (X.left.basicOpen_le e) hV₀W
  have hLocU : IsLocalization.Away e ↑(X.left.presheaf.obj (Opposite.op U)) :=
    hV₀.isLocalization_basicOpen e
  let θ : Localization.Away e ≃+* ↑(X.left.presheaf.obj (Opposite.op U)) :=
    (IsLocalization.algEquiv (Submonoid.powers e) (Localization.Away e)
      ↑(X.left.presheaf.obj (Opposite.op U))).toRingEquiv
  have hDomU : IsDomain ↑(X.left.presheaf.obj (Opposite.op U)) :=
    MulEquiv.isDomain (Localization.Away e) θ.symm.toMulEquiv
  have hIntClU : IsIntegrallyClosed ↑(X.left.presheaf.obj (Opposite.op U)) :=
    IsIntegrallyClosed.of_equiv θ
  exact ⟨U, hAffU, hxU, hUW, hDomU, hIntClU⟩

theorem weil_nodal_quotient_domain_and_integrallyClosed (A' : Type u) [CommRing A'] [IsDomain A'] [IsIntegrallyClosed A']
    (h' : A') (hh' : h' ≠ 0) :
    IsDomain (MvPolynomial (Fin 2) A' ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'}) ∧
    IsIntegrallyClosed (MvPolynomial (Fin 2) A' ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'}) :=
by
  let I : Ideal (MvPolynomial (Fin 2) A') :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'}
  let E₀ := MvPolynomial (Fin 2) A' ⧸ I
  let π : MvPolynomial (Fin 2) A' →+* E₀ := Ideal.Quotient.mk I
  let P := Polynomial A'
  let F := FractionRing P
  let ι_P : P →+* F := algebraMap P F
  let t : F := ι_P Polynomial.X
  let η : F := ι_P (Polynomial.C h')
  have hι_inj : Function.Injective ι_P := IsFractionRing.injective P F
  have ht_ne : t ≠ 0 := fun ht =>
    Polynomial.X_ne_zero (hι_inj (ht.trans (map_zero ι_P).symm))
  have hη_ne : η ≠ 0 := fun hη =>
    Polynomial.C_ne_zero.mpr hh' (hι_inj (hη.trans (map_zero ι_P).symm))
  have hrel : π (MvPolynomial.X 0) * π (MvPolynomial.X 1) = π (MvPolynomial.C h') := by
    rw [← map_mul]
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (Ideal.subset_span rfl)
  let φ₀ : P →+* E₀ := Polynomial.eval₂RingHom (π.comp MvPolynomial.C) (π (MvPolynomial.X 0))
  let φ₁ : P →+* E₀ := Polynomial.eval₂RingHom (π.comp MvPolynomial.C) (π (MvPolynomial.X 1))
  have hφ₀_C : ∀ a : A', φ₀ (Polynomial.C a) = π (MvPolynomial.C a) :=
    fun _ => Polynomial.eval₂_C _ _
  have hφ₀_X : φ₀ Polynomial.X = π (MvPolynomial.X 0) := Polynomial.eval₂_X _ _
  have hφ₁_C : ∀ a : A', φ₁ (Polynomial.C a) = π (MvPolynomial.C a) :=
    fun _ => Polynomial.eval₂_C _ _
  have hφ₁_X : φ₁ Polynomial.X = π (MvPolynomial.X 1) := Polynomial.eval₂_X _ _
  have hnf_poly : ∀ Q : MvPolynomial (Fin 2) A',
      ∃ p₀ p₁ : P, π Q = φ₀ p₀ + π (MvPolynomial.X 1) * φ₁ p₁ := by
    intro Q
    induction Q using MvPolynomial.induction_on with
    | C a =>
      refine ⟨Polynomial.C a, 0, ?_⟩
      rw [hφ₀_C, map_zero, mul_zero, add_zero]
    | add Q₁ Q₂ ih₁ ih₂ =>
      obtain ⟨p₀₁, p₁₁, h₁⟩ := ih₁
      obtain ⟨p₀₂, p₁₂, h₂⟩ := ih₂
      refine ⟨p₀₁ + p₀₂, p₁₁ + p₁₂, ?_⟩
      rw [map_add, h₁, h₂, map_add, map_add]
      ring
    | mul_X Q' idx ih =>
      obtain ⟨p₀, p₁, hQ'⟩ := ih
      fin_cases idx
      · refine ⟨p₀ * Polynomial.X + Polynomial.C (h' * p₁.coeff 0),
            Polynomial.C h' * p₁.divX, ?_⟩
        have hp₁ : φ₁ p₁ = π (MvPolynomial.C (p₁.coeff 0)) +
            π (MvPolynomial.X 1) * φ₁ p₁.divX := by
          conv_lhs => rw [← Polynomial.X_mul_divX_add p₁]
          rw [map_add, map_mul, hφ₁_X, hφ₁_C, add_comm]
        change π (Q' * MvPolynomial.X 0) = _
        calc
          π (Q' * MvPolynomial.X 0)
            = (φ₀ p₀ + π (MvPolynomial.X 1) * φ₁ p₁) * π (MvPolynomial.X 0) := by
              rw [map_mul, hQ']
          _ = φ₀ p₀ * π (MvPolynomial.X 0) +
              π (MvPolynomial.X 1) *
                (π (MvPolynomial.C (p₁.coeff 0)) + π (MvPolynomial.X 1) * φ₁ p₁.divX) *
                π (MvPolynomial.X 0) := by
              rw [add_mul, hp₁]
          _ = φ₀ p₀ * π (MvPolynomial.X 0) +
              (π (MvPolynomial.X 0) * π (MvPolynomial.X 1)) * π (MvPolynomial.C (p₁.coeff 0)) +
              π (MvPolynomial.X 1) *
                ((π (MvPolynomial.X 0) * π (MvPolynomial.X 1)) * φ₁ p₁.divX) := by ring
          _ = φ₀ p₀ * φ₀ Polynomial.X +
              π (MvPolynomial.C h') * π (MvPolynomial.C (p₁.coeff 0)) +
              π (MvPolynomial.X 1) * (φ₁ (Polynomial.C h') * φ₁ p₁.divX) := by
              rw [hrel, hφ₀_X, hφ₁_C]
          _ = φ₀ (p₀ * Polynomial.X + Polynomial.C (h' * p₁.coeff 0)) +
              π (MvPolynomial.X 1) * φ₁ (Polynomial.C h' * p₁.divX) := by
              rw [← map_mul, ← map_mul, ← MvPolynomial.C_mul, ← hφ₀_C, ← map_add, ← map_mul]
      · refine ⟨Polynomial.C h' * p₀.divX,
            Polynomial.C (p₀.coeff 0) + p₁ * Polynomial.X, ?_⟩
        have hp₀ : φ₀ p₀ = π (MvPolynomial.C (p₀.coeff 0)) +
            π (MvPolynomial.X 0) * φ₀ p₀.divX := by
          conv_lhs => rw [← Polynomial.X_mul_divX_add p₀]
          rw [map_add, map_mul, hφ₀_X, hφ₀_C, add_comm]
        change π (Q' * MvPolynomial.X 1) = _
        calc
          π (Q' * MvPolynomial.X 1)
            = (φ₀ p₀ + π (MvPolynomial.X 1) * φ₁ p₁) * π (MvPolynomial.X 1) := by
              rw [map_mul, hQ']
          _ = (π (MvPolynomial.C (p₀.coeff 0)) + π (MvPolynomial.X 0) * φ₀ p₀.divX) *
                π (MvPolynomial.X 1) +
              π (MvPolynomial.X 1) * φ₁ p₁ * π (MvPolynomial.X 1) := by
              rw [add_mul, hp₀]
          _ = (π (MvPolynomial.X 0) * π (MvPolynomial.X 1)) * φ₀ p₀.divX +
              π (MvPolynomial.X 1) *
                (π (MvPolynomial.C (p₀.coeff 0)) + φ₁ p₁ * π (MvPolynomial.X 1)) := by ring
          _ = φ₀ (Polynomial.C h') * φ₀ p₀.divX +
              π (MvPolynomial.X 1) *
                (φ₁ (Polynomial.C (p₀.coeff 0)) + φ₁ p₁ * φ₁ Polynomial.X) := by
              rw [hrel, hφ₀_C, hφ₁_C, hφ₁_X]
          _ = φ₀ (Polynomial.C h' * p₀.divX) +
              π (MvPolynomial.X 1) * φ₁ (Polynomial.C (p₀.coeff 0) + p₁ * Polynomial.X) := by
              rw [← map_mul, ← map_mul, ← map_add]
  have hnf : ∀ q : E₀, ∃ p₀ p₁ : P, q = φ₀ p₀ + π (MvPolynomial.X 1) * φ₁ p₁ := by
    intro q
    exact Submodule.Quotient.induction_on _ q hnf_poly
  let σ : P →+* F := Polynomial.eval₂RingHom (ι_P.comp Polynomial.C) (η * t⁻¹)
  have hσ_C : ∀ a : A', σ (Polynomial.C a) = ι_P (Polynomial.C a) :=
    fun _ => Polynomial.eval₂_C _ _
  have hσ_X : σ Polynomial.X = η * t⁻¹ := Polynomial.eval₂_X _ _
  let R_poly : P → ℕ → P := fun p D =>
    ∑ k ∈ Finset.range (p.natDegree + 1),
      Polynomial.C (p.coeff k * h' ^ k) * Polynomial.X ^ (D - k)
  have hηt_cancel : (η * t⁻¹) * t = η := by
    rw [mul_assoc, inv_mul_cancel₀ ht_ne, mul_one]
  have hσ_clear : ∀ (p : P) (D : ℕ), p.natDegree ≤ D →
      σ p * t ^ D = ι_P (R_poly p D) := by
    intro p D hD
    have hp_sum := Polynomial.as_sum_range_C_mul_X_pow p
    conv_lhs => rw [hp_sum]
    rw [map_sum, Finset.sum_mul]
    dsimp [R_poly]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro k hk
    have hkD : k ≤ D := by
      have hk' : k < p.natDegree + 1 := Finset.mem_range.mp hk
      omega
    have hD_split : D = k + (D - k) := by omega
    have hσ_term : σ (Polynomial.C (p.coeff k) * Polynomial.X ^ k) =
        ι_P (Polynomial.C (p.coeff k)) * (η * t⁻¹) ^ k := by
      rw [map_mul, map_pow, hσ_C, hσ_X]
    rw [hσ_term]
    conv_lhs => rw [hD_split]
    rw [pow_add, ← mul_assoc, mul_assoc (ι_P (Polynomial.C (p.coeff k))),
      ← mul_pow, hηt_cancel]
    simp [η, t, Polynomial.C_mul, Polynomial.C_pow, mul_assoc]
  have hR_coeff_gt : ∀ (p : P) (D m : ℕ), D < m → (R_poly p D).coeff m = 0 := by
    intro p D m hm
    dsimp [R_poly]
    rw [Polynomial.finsetSum_coeff]
    apply Finset.sum_eq_zero
    intro k _
    rw [Polynomial.coeff_C_mul_X_pow]
    have hne : m ≠ D - k := by omega
    simp only [hne, ↓reduceIte]
  have hR_coeff_sub : ∀ (p : P) (D i : ℕ), p.natDegree ≤ D → i ≤ p.natDegree →
      (R_poly p D).coeff (D - i) = p.coeff i * h' ^ i := by
    intro p D i hD hi
    dsimp [R_poly]
    rw [Polynomial.finsetSum_coeff]
    have hi_mem : i ∈ Finset.range (p.natDegree + 1) := Finset.mem_range.mpr (by omega)
    rw [Finset.sum_eq_single i]
    · rw [Polynomial.coeff_C_mul_X_pow]
      simp only [↓reduceIte]
    · intro k hk hki
      rw [Polynomial.coeff_C_mul_X_pow]
      have hk_le : k < p.natDegree + 1 := Finset.mem_range.mp hk
      have hne : D - i ≠ D - k := by omega
      simp only [hne, ↓reduceIte]
    · intro hi_not
      exact absurd hi_mem hi_not
  have hσ_inj : Function.Injective σ := by
    rw [injective_iff_map_eq_zero]
    intro p hp
    have hR0 : R_poly p p.natDegree = 0 := by
      apply hι_inj
      rw [← hσ_clear p p.natDegree le_rfl, hp, zero_mul, map_zero]
    ext i
    rw [Polynomial.coeff_zero]
    by_cases hi : p.natDegree < i
    · exact Polynomial.coeff_eq_zero_of_natDegree_lt hi
    · have hi' : i ≤ p.natDegree := Nat.le_of_not_lt hi
      have hc : (R_poly p p.natDegree).coeff (p.natDegree - i) = p.coeff i * h' ^ i :=
        hR_coeff_sub p p.natDegree i le_rfl hi'
      rw [hR0, Polynomial.coeff_zero] at hc
      rcases mul_eq_zero.mp hc.symm with hpi | hpow
      · exact hpi
      · exact absurd hpow (pow_ne_zero i hh')
  let θ : F →+* F := IsFractionRing.lift hσ_inj
  have hθ_ι : ∀ p : P, θ (ι_P p) = σ p := IsFractionRing.lift_algebraMap hσ_inj
  have hθ_C : ∀ a : A', θ (ι_P (Polynomial.C a)) = ι_P (Polynomial.C a) := fun a => by
    rw [hθ_ι, hσ_C]
  have hθ_t : θ t = η * t⁻¹ := by
    dsimp [t]; rw [hθ_ι, hσ_X]
  let Ψ_raw : MvPolynomial (Fin 2) A' →+* F :=
    MvPolynomial.eval₂Hom (ι_P.comp Polynomial.C) ![t, η * t⁻¹]
  have hΨ_ker : ∀ r ∈ I, Ψ_raw r = 0 := by
    intro r hr
    rw [Ideal.mem_span_singleton] at hr
    obtain ⟨g, rfl⟩ := hr
    have hgen : Ψ_raw (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h') = 0 := by
      simp only [Ψ_raw, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        RingHom.comp_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
      have hmul : t * (η * t⁻¹) = η := by
        calc
          t * (η * t⁻¹) = η * (t * t⁻¹) := by ring
          _ = η * 1 := by rw [mul_inv_cancel₀ ht_ne]
          _ = η := mul_one η
      rw [hmul]
      exact sub_self η
    rw [map_mul, hgen, zero_mul]
  let Ψ : E₀ →+* F := Ideal.Quotient.lift I Ψ_raw hΨ_ker
  have hΨ_mk : ∀ Q : MvPolynomial (Fin 2) A', Ψ (π Q) = Ψ_raw Q :=
    fun _ => Ideal.Quotient.lift_mk I Ψ_raw hΨ_ker
  have hΨ_C : ∀ a : A', Ψ (π (MvPolynomial.C a)) = ι_P (Polynomial.C a) := fun a => by
    rw [hΨ_mk]; exact MvPolynomial.eval₂Hom_C _ _ a
  have hΨ_X₀ : Ψ (π (MvPolynomial.X 0)) = t := by
    rw [hΨ_mk, MvPolynomial.eval₂Hom_X']; rfl
  have hΨ_X₁ : Ψ (π (MvPolynomial.X 1)) = η * t⁻¹ := by
    rw [hΨ_mk, MvPolynomial.eval₂Hom_X']; rfl
  have hΨ_φ₀ : Ψ.comp φ₀ = ι_P := by
    apply Polynomial.ringHom_ext'
    · ext a
      change Ψ (φ₀ (Polynomial.C a)) = ι_P (Polynomial.C a)
      rw [hφ₀_C, hΨ_C]
    · change Ψ (φ₀ Polynomial.X) = t
      rw [hφ₀_X, hΨ_X₀]
  have hΨ_φ₁ : Ψ.comp φ₁ = σ := by
    apply Polynomial.ringHom_ext'
    · ext a
      change Ψ (φ₁ (Polynomial.C a)) = σ (Polynomial.C a)
      rw [hφ₁_C, hΨ_C, hσ_C]
    · change Ψ (φ₁ Polynomial.X) = σ Polynomial.X
      rw [hφ₁_X, hΨ_X₁, hσ_X]
  have hΨ_nf_clear : ∀ p₀ p₁ : P,
      Ψ (φ₀ p₀ + π (MvPolynomial.X 1) * φ₁ p₁) * t ^ (p₁.natDegree + 1) =
        ι_P (p₀ * Polynomial.X ^ (p₁.natDegree + 1) +
          Polynomial.C h' * R_poly p₁ p₁.natDegree) := by
    intro p₀ p₁
    have h1 : Ψ (φ₀ p₀) = ι_P p₀ := RingHom.congr_fun hΨ_φ₀ p₀
    have h2 : Ψ (φ₁ p₁) = σ p₁ := RingHom.congr_fun hΨ_φ₁ p₁
    rw [map_add, map_mul, h1, h2, hΨ_X₁, add_mul]
    have h_term1 : ι_P p₀ * t ^ (p₁.natDegree + 1) =
        ι_P (p₀ * Polynomial.X ^ (p₁.natDegree + 1)) := by
      simp [t]
    have h_term2 : η * t⁻¹ * σ p₁ * t ^ (p₁.natDegree + 1) =
        ι_P (Polynomial.C h' * R_poly p₁ p₁.natDegree) := by
      calc
        η * t⁻¹ * σ p₁ * t ^ (p₁.natDegree + 1)
          = η * t⁻¹ * σ p₁ * (t * t ^ p₁.natDegree) := by rw [pow_succ']
        _ = η * (t⁻¹ * t) * (σ p₁ * t ^ p₁.natDegree) := by ring
        _ = η * 1 * (σ p₁ * t ^ p₁.natDegree) := by rw [inv_mul_cancel₀ ht_ne]
        _ = η * ι_P (R_poly p₁ p₁.natDegree) := by
          rw [mul_one, hσ_clear p₁ p₁.natDegree le_rfl]
        _ = ι_P (Polynomial.C h' * R_poly p₁ p₁.natDegree) := by simp [η]
    rw [h_term1, h_term2, ← map_add]
  have h_clear : ∀ q : E₀, ∃ (M : ℕ) (p : P), Ψ q * t ^ M = ι_P p := by
    intro q
    obtain ⟨p₀, p₁, rfl⟩ := hnf q
    exact ⟨p₁.natDegree + 1,
      p₀ * Polynomial.X ^ (p₁.natDegree + 1) + Polynomial.C h' * R_poly p₁ p₁.natDegree,
      hΨ_nf_clear p₀ p₁⟩
  have hΨ_inj : Function.Injective Ψ := by
    rw [injective_iff_map_eq_zero]
    intro q hq
    obtain ⟨p₀, p₁, rfl⟩ := hnf q
    have hpoly0 : p₀ * Polynomial.X ^ (p₁.natDegree + 1) +
        Polynomial.C h' * R_poly p₁ p₁.natDegree = 0 := by
      apply hι_inj
      rw [← hΨ_nf_clear p₀ p₁, hq, zero_mul, map_zero]
    have hp₀ : p₀ = 0 := by
      ext m
      rw [Polynomial.coeff_zero]
      have hm := congrArg (fun p : Polynomial A' => p.coeff (m + (p₁.natDegree + 1))) hpoly0
      rw [Polynomial.coeff_add, Polynomial.coeff_mul_X_pow,
        Polynomial.coeff_C_mul, Polynomial.coeff_zero] at hm
      have hR_gt : (R_poly p₁ p₁.natDegree).coeff (m + (p₁.natDegree + 1)) = 0 :=
        hR_coeff_gt p₁ p₁.natDegree (m + (p₁.natDegree + 1)) (by omega)
      rw [hR_gt, mul_zero, add_zero] at hm
      exact hm
    have hp₁ : p₁ = 0 := by
      have h1 : Ψ (φ₀ p₀) = ι_P p₀ := RingHom.congr_fun hΨ_φ₀ p₀
      have h2 : Ψ (φ₁ p₁) = σ p₁ := RingHom.congr_fun hΨ_φ₁ p₁
      rw [map_add, map_mul, h1, h2, hΨ_X₁, hp₀, map_zero, zero_add] at hq
      have hηt_ne : η * t⁻¹ ≠ 0 := mul_ne_zero hη_ne (inv_ne_zero ht_ne)
      rcases mul_eq_zero.mp hq with hbad | hσ0
      · exact absurd hbad hηt_ne
      · exact hσ_inj (hσ0.trans (map_zero σ).symm)
    simp [hp₀, hp₁]
  have hDomE₀ : IsDomain E₀ := Function.Injective.isDomain Ψ hΨ_inj
  let swap_raw : MvPolynomial (Fin 2) A' →+* E₀ :=
    MvPolynomial.eval₂Hom (π.comp MvPolynomial.C) ![π (MvPolynomial.X 1), π (MvPolynomial.X 0)]
  have hswap_ker : ∀ r ∈ I, swap_raw r = 0 := by
    intro r hr
    rw [Ideal.mem_span_singleton] at hr
    obtain ⟨g, rfl⟩ := hr
    have hgen : swap_raw (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h') = 0 := by
      simp only [swap_raw, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        RingHom.comp_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [mul_comm, hrel, sub_self]
    rw [map_mul, hgen, zero_mul]
  let swap : E₀ →+* E₀ := Ideal.Quotient.lift I swap_raw hswap_ker
  have hswap_mk : ∀ Q : MvPolynomial (Fin 2) A', swap (π Q) = swap_raw Q :=
    fun _ => Ideal.Quotient.lift_mk I swap_raw hswap_ker
  have hswap_C : ∀ a : A', swap (π (MvPolynomial.C a)) = π (MvPolynomial.C a) := fun a => by
    rw [hswap_mk]; exact MvPolynomial.eval₂Hom_C _ _ a
  have hswap_X₀ : swap (π (MvPolynomial.X 0)) = π (MvPolynomial.X 1) := by
    rw [hswap_mk, MvPolynomial.eval₂Hom_X']; rfl
  have hswap_X₁ : swap (π (MvPolynomial.X 1)) = π (MvPolynomial.X 0) := by
    rw [hswap_mk, MvPolynomial.eval₂Hom_X']; rfl
  have hθ_comp : θ.comp Ψ = Ψ.comp swap := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext'
    · ext a
      change θ (Ψ (π (MvPolynomial.C a))) = Ψ (swap (π (MvPolynomial.C a)))
      rw [hΨ_C, hθ_C, hswap_C, hΨ_C]
    · intro idx
      fin_cases idx
      · change θ (Ψ (π (MvPolynomial.X 0))) = Ψ (swap (π (MvPolynomial.X 0)))
        rw [hΨ_X₀, hθ_t, hswap_X₀, hΨ_X₁]
      · change θ (Ψ (π (MvPolynomial.X 1))) = Ψ (swap (π (MvPolynomial.X 1)))
        have hθη : θ η = η := hθ_C h'
        rw [hΨ_X₁, hswap_X₁, hΨ_X₀, map_mul, map_inv₀, hθη, hθ_t]
        have hηt_ne : η * t⁻¹ ≠ 0 := mul_ne_zero hη_ne (inv_ne_zero ht_ne)
        apply mul_right_cancel₀ hηt_ne
        calc
          η * (η * t⁻¹)⁻¹ * (η * t⁻¹)
            = η * ((η * t⁻¹)⁻¹ * (η * t⁻¹)) := by ring
          _ = η * 1 := by rw [inv_mul_cancel₀ hηt_ne]
          _ = η * (t * t⁻¹) := by rw [mul_inv_cancel₀ ht_ne]
          _ = t * (η * t⁻¹) := by ring
  let _ : Algebra E₀ F := Ψ.toAlgebra
  have h_alg_eq : algebraMap E₀ F = Ψ := rfl
  have _ : FaithfulSMul E₀ F := (faithfulSMul_iff_algebraMap_injective E₀ F).mpr hΨ_inj
  have h_int_denom : ∀ w : F, IsIntegral E₀ w → ∃ (M : ℕ) (p : P), w * t ^ M = ι_P p := by
    intro w ⟨Q, hQ_monic, hQ_eval⟩
    let n := Q.natDegree
    let M_fn : Fin n → ℕ := fun i => (h_clear (Q.coeff i)).choose
    let f_fn : Fin n → P := fun i => (h_clear (Q.coeff i)).choose_spec.choose
    have hf_fn : ∀ i : Fin n, Ψ (Q.coeff i) * t ^ (M_fn i) = ι_P (f_fn i) :=
      fun i => (h_clear (Q.coeff i)).choose_spec.choose_spec
    let M : ℕ := Finset.univ.sup M_fn
    let g : Fin n → P := fun i =>
      f_fn i * Polynomial.X ^ ((M - M_fn i) + (n - 1 - (i : ℕ)) * M)
    let Q_tilde : Polynomial P :=
      Polynomial.X ^ n + ∑ i : Fin n, Polynomial.C (g i) * Polynomial.X ^ (i : ℕ)
    have hQ_tilde_monic : Q_tilde.Monic :=
      Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt g)
    have hQ_sum : w ^ n + ∑ k ∈ Finset.range n, Ψ (Q.coeff k) * w ^ k = 0 := by
      have has := hQ_monic.as_sum
      have hev := hQ_eval
      rw [h_alg_eq] at hev
      conv at hev => lhs; rw [has]
      simpa [n, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
        Polynomial.eval₂_mul, Polynomial.eval₂_C] using hev
    have hQ_tilde_eval : Polynomial.eval₂ ι_P (w * t ^ M) Q_tilde = 0 := by
      dsimp [Q_tilde]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
      have h_lead : (w * t ^ M) ^ n = w ^ n * t ^ (n * M) := by
        rw [mul_pow, ← pow_mul, mul_comm M n]
      have h_sum : (∑ i : Fin n,
          Polynomial.eval₂ ι_P (w * t ^ M) (Polynomial.C (g i) * Polynomial.X ^ (i : ℕ))) =
          (∑ k ∈ Finset.range n, Ψ (Q.coeff k) * w ^ k) * t ^ (n * M) := by
        rw [← Fin.sum_univ_eq_sum_range, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro i _
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        have hM_le : M_fn i ≤ M := Finset.le_sup (Finset.mem_univ i)
        have hi_lt : (i : ℕ) < n := i.isLt
        have hg_map : ι_P (g i) =
            (Ψ (Q.coeff i) * t ^ (M_fn i)) *
              t ^ ((M - M_fn i) + (n - 1 - (i : ℕ)) * M) := by
          dsimp [g]
          rw [map_mul, map_pow, ← hf_fn i]
        rw [hg_map, mul_pow, ← pow_mul]
        have hexp : M_fn i + ((M - M_fn i) + (n - 1 - (i : ℕ)) * M) + M * (i : ℕ) = n * M := by
          have h1 : M_fn i + (M - M_fn i) = M := by omega
          have h2 : 1 + (n - 1 - (i : ℕ)) + (i : ℕ) = n := by omega
          calc
            M_fn i + ((M - M_fn i) + (n - 1 - (i : ℕ)) * M) + M * (i : ℕ)
              = (M_fn i + (M - M_fn i)) + (n - 1 - (i : ℕ)) * M + M * (i : ℕ) := by ring
            _ = M + (n - 1 - (i : ℕ)) * M + M * (i : ℕ) := by rw [h1]
            _ = (1 + (n - 1 - (i : ℕ)) + (i : ℕ)) * M := by ring
            _ = n * M := by rw [h2]
        calc
          (Ψ (Q.coeff i) * t ^ M_fn i) * t ^ ((M - M_fn i) + (n - 1 - (i : ℕ)) * M) *
              (w ^ (i : ℕ) * t ^ (M * (i : ℕ)))
            = (Ψ (Q.coeff i) * w ^ (i : ℕ)) *
              (t ^ M_fn i * t ^ ((M - M_fn i) + (n - 1 - (i : ℕ)) * M) * t ^ (M * (i : ℕ))) := by
            ring
          _ = (Ψ (Q.coeff i) * w ^ (i : ℕ)) *
              t ^ (M_fn i + ((M - M_fn i) + (n - 1 - (i : ℕ)) * M) + M * (i : ℕ)) := by
            rw [← pow_add, ← pow_add]
          _ = Ψ (Q.coeff i) * w ^ (i : ℕ) * t ^ (n * M) := by rw [hexp]
      rw [h_lead, h_sum, ← add_mul, hQ_sum, zero_mul]
    have hu_int : IsIntegral P (w * t ^ M) := ⟨Q_tilde, hQ_tilde_monic, hQ_tilde_eval⟩
    obtain ⟨p, hp⟩ := (isIntegrallyClosed_iff F).mp (inferInstance : IsIntegrallyClosed P) hu_int
    exact ⟨M, p, hp.symm⟩
  have hθ_div : ∀ (y : F) (M₁ M₂ : ℕ) (p₁ p₂ : P),
      y * t ^ M₁ = ι_P p₁ → θ y * t ^ M₂ = ι_P p₂ →
      ∀ i < M₁, ∃ d : A', p₁.coeff i = d * h' ^ (M₁ - i) := by
    intro y M₁ M₂ p₁ p₂ hp₁ hp₂ i hi
    by_cases hiD : p₁.natDegree < i
    · refine ⟨0, ?_⟩
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hiD, zero_mul]
    · have hi_le : i ≤ p₁.natDegree := Nat.le_of_not_lt hiD
      let D₁ := p₁.natDegree
      let N := M₁ + M₂ + D₁
      have hθ_p₁ : θ y * (η * t⁻¹) ^ M₁ = σ p₁ := by
        have h := congrArg θ hp₁
        rw [map_mul, map_pow, hθ_t, hθ_ι] at h
        exact h
      have h_poly_eq : Polynomial.C (h' ^ M₁) * (Polynomial.X ^ D₁ * p₂) = R_poly p₁ N := by
        apply hι_inj
        rw [← hσ_clear p₁ N (by omega), ← hθ_p₁]
        have hN_split : N = M₂ + M₁ + D₁ := by omega
        calc
          ι_P (Polynomial.C (h' ^ M₁) * (Polynomial.X ^ D₁ * p₂))
            = η ^ M₁ * (t ^ D₁ * ι_P p₂) := by
              simp [η, t, Polynomial.C_pow]
          _ = η ^ M₁ * (t ^ D₁ * (θ y * t ^ M₂)) := by rw [← hp₂]
          _ = θ y * t ^ M₂ * ((η * t⁻¹ * t) ^ M₁) * t ^ D₁ := by
              rw [hηt_cancel]
              ring
          _ = θ y * t ^ M₂ * ((η * t⁻¹) ^ M₁ * t ^ M₁) * t ^ D₁ := by
              rw [mul_pow]
          _ = θ y * (η * t⁻¹) ^ M₁ * (t ^ M₂ * t ^ M₁ * t ^ D₁) := by ring
          _ = θ y * (η * t⁻¹) ^ M₁ * t ^ N := by
              rw [← pow_add, ← pow_add, ← hN_split]
      have hN_sub : N - i = (M₁ + M₂ - i) + D₁ := by omega
      have hc := congrArg (fun p : P => p.coeff (N - i)) h_poly_eq
      rw [hR_coeff_sub p₁ N i (by omega) hi_le] at hc
      rw [hN_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul] at hc
      refine ⟨p₂.coeff (M₁ + M₂ - i), ?_⟩
      have hM₁_split : M₁ = (M₁ - i) + i := by omega
      have hc' : (p₂.coeff (M₁ + M₂ - i) * h' ^ (M₁ - i)) * h' ^ i = p₁.coeff i * h' ^ i := by
        calc
          (p₂.coeff (M₁ + M₂ - i) * h' ^ (M₁ - i)) * h' ^ i
            = (h' ^ (M₁ - i) * h' ^ i) * p₂.coeff (M₁ + M₂ - i) := by ring
          _ = h' ^ M₁ * p₂.coeff (M₁ + M₂ - i) := by rw [← pow_add, ← hM₁_split]
          _ = p₁.coeff i * h' ^ i := hc
      exact (mul_right_cancel₀ (pow_ne_zero i hh') hc').symm
  have _ : IsIntegrallyClosedIn E₀ F := by
    rw [isIntegrallyClosedIn_iff]
    refine ⟨hΨ_inj, ?_⟩
    intro y hy
    obtain ⟨M₁, p₁, hp₁⟩ := h_int_denom y hy
    have hy_θ : IsIntegral E₀ (θ y) := by
      obtain ⟨Q, hQ_monic, hQ_eval⟩ := hy
      refine ⟨Q.map swap, hQ_monic.map swap, ?_⟩
      rw [h_alg_eq] at hQ_eval ⊢
      rw [Polynomial.eval₂_map, ← hθ_comp, ← Polynomial.hom_eval₂, hQ_eval, map_zero]
    obtain ⟨M₂, p₂, hp₂⟩ := h_int_denom (θ y) hy_θ
    have hd := hθ_div y M₁ M₂ p₁ p₂ hp₁ hp₂
    let q₀ : E₀ :=
      ∑ i ∈ Finset.range (p₁.natDegree + 1),
        if hi : i < M₁ then
          π (MvPolynomial.C (hd i hi).choose * MvPolynomial.X 1 ^ (M₁ - i))
        else
          π (MvPolynomial.C (p₁.coeff i) * MvPolynomial.X 0 ^ (i - M₁))
    refine ⟨q₀, ?_⟩
    rw [h_alg_eq]
    apply mul_right_cancel₀ (pow_ne_zero M₁ ht_ne)
    rw [hp₁]
    dsimp [q₀]
    rw [map_sum, Finset.sum_mul]
    conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow p₁, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    split_ifs with hi
    · have hdi : p₁.coeff i = (hd i hi).choose * h' ^ (M₁ - i) := (hd i hi).choose_spec
      have ht_split : t ^ M₁ = t ^ (M₁ - i) * t ^ i := by
        rw [← pow_add]
        congr 1
        omega
      rw [map_mul, map_pow, map_mul, map_pow, hΨ_C, hΨ_X₁, ht_split, ← mul_assoc,
        mul_assoc (ι_P (Polynomial.C (hd i hi).choose)), ← mul_pow, hηt_cancel]
      conv_rhs => rw [hdi]
      simp [η, t, Polynomial.C_mul, Polynomial.C_pow, mul_assoc]
    · have hM₁_add : (i - M₁) + M₁ = i := by omega
      rw [map_mul, map_pow, map_mul, map_pow, hΨ_C, hΨ_X₀, mul_assoc, ← pow_add, hM₁_add]
      simp [t]
  exact ⟨hDomE₀, IsIntegrallyClosed.of_isIntegrallyClosedIn E₀ F⟩

theorem weil_etale_spec_base_normal_away_and_generic_in_open (k : Type u) [Field k]
    (hEtNorm : ∀ (D S : Type u) [CommRing D] [CommRing S] [Algebra D S]
      [IsDomain D] [IsIntegrallyClosed D] [IsNoetherianRing D]
      [Algebra.Etale D S] (P : Ideal S) [P.IsPrime],
      ∃ (e : S), e ∉ P ∧
        IsDomain (Localization.Away e) ∧
        IsIntegrallyClosed (Localization.Away e))
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hNormB : IsAffineNormalScheme B.left)
    (hUB : Nonempty U_B)
    (R' : CommRingCat.{u})
    (e_B : AlgebraicGeometry.Spec R' ⟶ B.left)
    (he_B : AlgebraicGeometry.Etale e_B)
    (p₀ : AlgebraicGeometry.Spec R') :
    ∃ (s₀ : R'),
      s₀ ∉ p₀.asIdeal ∧
      IsDomain (Localization.Away s₀) ∧
      IsIntegrallyClosed (Localization.Away s₀) ∧
      IsNoetherianRing (Localization.Away s₀) ∧
      ∀ (p : AlgebraicGeometry.Spec R'),
        s₀ ∉ p.asIdeal →
        p.asIdeal = Ideal.comap (algebraMap R' (Localization.Away s₀)) ⊥ →
        e_B.base p ∈ U_B :=
by
  
  have _ : AlgebraicGeometry.IsLocallyNoetherian B.left := by
    obtain ⟨N, ι, hCl⟩ := hProjB
    let P := MvPolynomial (Fin (N + 1)) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz : (z : P) ∈ (1 : Submodule k P) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact z.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hz
      refine ⟨c, Subtype.ext ?_⟩
      rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul_of_tower]
      change c • (1 : P) = (z : P)
      rwa [← Algebra.algebraMap_eq_smul_one]
    have _ : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hSurj₀
    have _ : AlgebraicGeometry.IsLocallyNoetherian
        (AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0))) :=
      AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
    have _ : IsScalarTower k ↥(𝒜 0) P := ⟨fun c y p => smul_mul_assoc c (y : P) p⟩
    have _ : Algebra.FiniteType ↥(𝒜 0) P :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) P
    have _ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    have _ : AlgebraicGeometry.IsLocallyNoetherian (weilProjectiveSpaceOver k N).left := by
      change AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜)
      exact AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
        (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have _ : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    exact AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian ι.left
  
  let b₀ : ↥B.left := e_B.base p₀
  obtain ⟨U₀, hU₀, hb₀, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := b₀) (U := ⊤) trivial
  have hNonemptyU₀ : Nonempty U₀ := ⟨⟨b₀, hb₀⟩⟩
  let D_cat : CommRingCat.{u} := B.left.presheaf.obj (Opposite.op U₀)
  let D : Type u := ↑D_cat
  obtain ⟨hDomD, hIntClD⟩ := hNormB U₀ hU₀ hNonemptyU₀
  have _ : IsDomain D := hDomD
  have _ : IsIntegrallyClosed D := hIntClD
  have _ : IsNoetherianRing D :=
    AlgebraicGeometry.IsLocallyNoetherian.component_noetherian ⟨U₀, hU₀⟩
  have hp₀_mem : p₀ ∈ (TopologicalSpace.Opens.map e_B.base).obj U₀ := hb₀
  obtain ⟨_, ⟨s₁, rfl⟩, hs₁, hV₁_le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd
      (B := Set.range (PrimeSpectrum.basicOpen (R := R')))).mp
      PrimeSpectrum.isBasis_basic_opens hp₀_mem
  have hs₁_p₀ : s₁ ∉ p₀.asIdeal := hs₁
  let S₁ : Type u := Localization.Away s₁
  let S₁_cat : CommRingCat.{u} := CommRingCat.of S₁
  let j₁ : AlgebraicGeometry.Spec S₁_cat ⟶ AlgebraicGeometry.Spec R' :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' S₁))
  have _ : AlgebraicGeometry.Etale j₁ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr (inferInstance : Algebra.Etale R' S₁))
  have _ : AlgebraicGeometry.Etale e_B := he_B
  have _ : AlgebraicGeometry.Etale (j₁ ≫ e_B) := inferInstance
  have h_range : Set.range (j₁ ≫ e_B).base ⊆ Set.range hU₀.fromSpec.base := by
    rw [hU₀.range_fromSpec]
    rintro _ ⟨Q, rfl⟩
    have hj₁Q : j₁.base Q ∈ PrimeSpectrum.basicOpen s₁ := by
      apply (PrimeSpectrum.mem_basicOpen s₁ (j₁.base Q)).mpr
      have hQ_ideal : (j₁.base Q).asIdeal = Ideal.comap (algebraMap R' S₁) Q.asIdeal := rfl
      rw [hQ_ideal, Ideal.mem_comap]
      intro hmem
      exact Q.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem Q.asIdeal hmem (IsLocalization.Away.algebraMap_isUnit s₁))
    exact hV₁_le hj₁Q
  let g₁ : AlgebraicGeometry.Spec S₁_cat ⟶ AlgebraicGeometry.Spec D_cat :=
    AlgebraicGeometry.IsOpenImmersion.lift hU₀.fromSpec (j₁ ≫ e_B) h_range
  have hg₁_fac : g₁ ≫ hU₀.fromSpec = j₁ ≫ e_B :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac hU₀.fromSpec (j₁ ≫ e_B) h_range
  have hg₁_comp_et : AlgebraicGeometry.Etale (g₁ ≫ hU₀.fromSpec) := by
    rwa [hg₁_fac]
  have _ : AlgebraicGeometry.Etale g₁ :=
    CategoryTheory.MorphismProperty.of_postcomp @AlgebraicGeometry.Etale
      (W' := @AlgebraicGeometry.Etale) g₁ hU₀.fromSpec inferInstance hg₁_comp_et
  let φ₁_cat : D_cat ⟶ S₁_cat := (AlgebraicGeometry.Spec.fullyFaithful.preimage g₁).unop
  have hSpec_φ₁ : AlgebraicGeometry.Spec.map φ₁_cat = g₁ :=
    AlgebraicGeometry.Spec.map_preimage_unop g₁
  have hEt_Spec_φ₁ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₁_cat) := by
    rwa [hSpec_φ₁]
  have hφ₁ : RingHom.Etale φ₁_cat.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec_φ₁
  
  let q₀ : Ideal R' := p₀.asIdeal
  have hq₀ : q₀.IsPrime := p₀.isPrime
  have hDisj : Disjoint (↑(Submonoid.powers s₁) : Set R') (↑q₀ : Set R') := by
    rw [Set.disjoint_left]
    rintro x ⟨n, rfl⟩ hx_q₀
    exact hs₁_p₀ (hq₀.mem_of_pow_mem n hx_q₀)
  let P₁ : Ideal S₁ := Ideal.map (algebraMap R' S₁) q₀
  have hP₁ : P₁.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s₁) S₁ q₀ hq₀ hDisj
  have h_under : Ideal.comap (algebraMap R' S₁) P₁ = q₀ :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s₁) S₁ hq₀ hDisj
  let _ : Algebra D S₁ := φ₁_cat.hom.toAlgebra
  have _ : Algebra.Etale D S₁ := hφ₁.toAlgebra
  obtain ⟨e₁, he₁_P₁, hDomE₁, hNormE₁⟩ := hEtNorm D S₁ P₁
  obtain ⟨⟨r₂, y_pow⟩, he₁_eq⟩ := IsLocalization.surj (Submonoid.powers s₁) e₁
  obtain ⟨m, hm_pow⟩ : ∃ m : ℕ, s₁ ^ m = (y_pow : R') := y_pow.2
  have he₁_mul : e₁ * algebraMap R' S₁ (s₁ ^ m) = algebraMap R' S₁ r₂ := by
    simpa [hm_pow] using he₁_eq
  have hr₂_q₀ : r₂ ∉ q₀ := by
    intro hr₂_mem
    have hprod_mem : e₁ * algebraMap R' S₁ (s₁ ^ m) ∈ P₁ := by
      rw [he₁_mul]
      exact Ideal.mem_map_of_mem (algebraMap R' S₁) hr₂_mem
    rcases hP₁.mem_or_mem hprod_mem with he₁_mem | hs₁m_mem
    · exact he₁_P₁ he₁_mem
    · have hs₁m_q₀ : s₁ ^ m ∈ q₀ := by
        rw [← h_under]
        exact hs₁m_mem
      exact hs₁_p₀ (hq₀.mem_of_pow_mem m hs₁m_q₀)
  let s₀ : R' := s₁ * r₂
  have hs₀_p₀ : s₀ ∉ p₀.asIdeal := by
    intro hmem
    rcases hq₀.mem_or_mem hmem with h1 | h2
    · exact hs₁_p₀ h1
    · exact hr₂_q₀ h2
  let A' : Type u := Localization.Away s₀
  let E₁ : Type u := Localization.Away e₁
  have hu_s₀_A' : IsUnit (algebraMap R' A' s₁ * algebraMap R' A' r₂) := by
    rw [← map_mul]
    exact IsLocalization.Away.algebraMap_isUnit s₀
  have hu_s₁_A' : IsUnit (algebraMap R' A' s₁) := isUnit_of_mul_isUnit_left hu_s₀_A'
  have hu_r₂_A' : IsUnit (algebraMap R' A' r₂) := isUnit_of_mul_isUnit_right hu_s₀_A'
  let β₁ : S₁ →+* A' := IsLocalization.Away.lift s₁ (g := algebraMap R' A') hu_s₁_A'
  have hβ₁_eq : ∀ r : R', β₁ (algebraMap R' S₁ r) = algebraMap R' A' r :=
    IsLocalization.Away.lift_eq s₁ hu_s₁_A'
  have hβ₁_comp : β₁.comp (algebraMap R' S₁) = algebraMap R' A' :=
    RingHom.ext hβ₁_eq
  have hu_e₁_A' : IsUnit (β₁ e₁) := by
    have hmul_A' : β₁ e₁ * algebraMap R' A' (s₁ ^ m) = algebraMap R' A' r₂ := by
      calc
        β₁ e₁ * algebraMap R' A' (s₁ ^ m)
            = β₁ e₁ * β₁ (algebraMap R' S₁ (s₁ ^ m)) := by rw [hβ₁_eq]
        _ = β₁ (e₁ * algebraMap R' S₁ (s₁ ^ m)) := (map_mul β₁ _ _).symm
        _ = β₁ (algebraMap R' S₁ r₂) := by rw [he₁_mul]
        _ = algebraMap R' A' r₂ := hβ₁_eq r₂
    exact isUnit_of_mul_isUnit_left (hmul_A'.symm ▸ hu_r₂_A')
  let Ξ_inv : E₁ →+* A' := IsLocalization.Away.lift e₁ (g := β₁) hu_e₁_A'
  have hΞ_inv_eq : ∀ z : S₁, Ξ_inv (algebraMap S₁ E₁ z) = β₁ z :=
    IsLocalization.Away.lift_eq e₁ hu_e₁_A'
  let α_R_E₁ : R' →+* E₁ := (algebraMap S₁ E₁).comp (algebraMap R' S₁)
  have hu_s₁_E₁ : IsUnit (α_R_E₁ s₁) :=
    RingHom.isUnit_map (algebraMap S₁ E₁) (IsLocalization.Away.algebraMap_isUnit s₁)
  have hu_r₂_E₁ : IsUnit (α_R_E₁ r₂) := by
    have hr₂_E₁ : α_R_E₁ r₂ = algebraMap S₁ E₁ e₁ * (α_R_E₁ s₁) ^ m := by
      change algebraMap S₁ E₁ (algebraMap R' S₁ r₂) =
        algebraMap S₁ E₁ e₁ * (algebraMap S₁ E₁ (algebraMap R' S₁ s₁)) ^ m
      rw [← he₁_mul, map_mul, ← map_pow, ← map_pow]
    rw [hr₂_E₁]
    exact (IsLocalization.Away.algebraMap_isUnit e₁).mul (hu_s₁_E₁.pow m)
  have hu_s₀_E₁ : IsUnit (α_R_E₁ s₀) := by
    change IsUnit (α_R_E₁ (s₁ * r₂))
    rw [map_mul]
    exact hu_s₁_E₁.mul hu_r₂_E₁
  let Ξ_to : A' →+* E₁ := IsLocalization.Away.lift s₀ (g := α_R_E₁) hu_s₀_E₁
  have hΞ_to_eq : ∀ r : R', Ξ_to (algebraMap R' A' r) = α_R_E₁ r :=
    IsLocalization.Away.lift_eq s₀ hu_s₀_E₁
  have hΞ_left_hom : Ξ_inv.comp Ξ_to = RingHom.id A' := by
    apply IsLocalization.ringHom_ext (Submonoid.powers s₀)
    ext r
    simp only [RingHom.comp_apply, RingHom.id_apply, hΞ_to_eq, α_R_E₁, hΞ_inv_eq, hβ₁_eq]
  have hΞ_to_β₁ : Ξ_to.comp β₁ = algebraMap S₁ E₁ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers s₁)
    ext r
    simp only [RingHom.comp_apply, hβ₁_eq, hΞ_to_eq, α_R_E₁]
  have hΞ_right_hom : Ξ_to.comp Ξ_inv = RingHom.id E₁ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers e₁)
    ext z
    have hz : Ξ_to (β₁ z) = algebraMap S₁ E₁ z :=
      RingHom.congr_fun hΞ_to_β₁ z
    simp only [RingHom.comp_apply, RingHom.id_apply, hΞ_inv_eq, hz]
  let Ξ : A' ≃+* E₁ :=
    { toFun := Ξ_to
      invFun := Ξ_inv
      left_inv := fun x => RingHom.congr_fun hΞ_left_hom x
      right_inv := fun y => RingHom.congr_fun hΞ_right_hom y
      map_mul' := Ξ_to.map_mul'
      map_add' := Ξ_to.map_add' }
  have _ : IsDomain E₁ := hDomE₁
  have _ : IsIntegrallyClosed E₁ := hNormE₁
  have hDomA' : IsDomain A' := MulEquiv.isDomain E₁ Ξ.toMulEquiv
  have hNormA' : IsIntegrallyClosed A' := IsIntegrallyClosed.of_equiv Ξ.symm
  have _ : IsNoetherianRing S₁ := Algebra.FiniteType.isNoetherianRing D S₁
  have _ : IsNoetherianRing E₁ := inferInstance
  have hNoethA' : IsNoetherianRing A' := isNoetherianRing_of_ringEquiv E₁ Ξ.symm
  have hβ₁_fac : β₁ = Ξ.symm.toRingHom.comp (algebraMap S₁ E₁) := by
    ext z
    exact (hΞ_inv_eq z).symm
  have hEt_locE₁ : (algebraMap S₁ E₁).Etale :=
    RingHom.etale_algebraMap.mpr (inferInstance : Algebra.Etale S₁ E₁)
  have hEt_Ξsymm : Ξ.symm.toRingHom.Etale :=
    RingHom.Etale.of_bijective Ξ.symm.bijective
  have hEt_β₁ : β₁.Etale := by
    rw [hβ₁_fac]
    exact RingHom.Etale.stableUnderComposition _ _ hEt_locE₁ hEt_Ξsymm
  have hEt_ψ : (β₁.comp φ₁_cat.hom).Etale :=
    RingHom.Etale.stableUnderComposition _ _ hφ₁ hEt_β₁
  have hinj_ψ : Function.Injective (β₁.comp φ₁_cat.hom) := by
    let _ : Algebra D A' := (β₁.comp φ₁_cat.hom).toAlgebra
    have _ : Algebra.Etale D A' := hEt_ψ.toAlgebra
    have _ : IsDomain A' := hDomA'
    exact FaithfulSMul.algebraMap_injective D A'
  
  refine ⟨s₀, hs₀_p₀, hDomA', hNormA', hNoethA', ?_⟩
  intro p _hs₀_p hbot_p
  have _ : IsDomain A' := hDomA'
  let Q_bot : PrimeSpectrum S₁ := ⟨Ideal.comap β₁ ⊥, Ideal.comap_isPrime β₁ ⊥⟩
  have hj₁_Q : j₁.base Q_bot = p := by
    apply PrimeSpectrum.ext
    have hQ_ideal : (j₁.base Q_bot).asIdeal = Ideal.comap (algebraMap R' S₁) Q_bot.asIdeal := rfl
    rw [hQ_ideal, hbot_p]
    ext r
    simp only [Q_bot, Ideal.mem_comap, Ideal.mem_bot, hβ₁_eq]
    exact Iff.rfl
  have hφ₁_Q : (AlgebraicGeometry.Spec.map φ₁_cat).base Q_bot = (⊥ : PrimeSpectrum D) := by
    apply PrimeSpectrum.ext
    have hQ_ideal : ((AlgebraicGeometry.Spec.map φ₁_cat).base Q_bot).asIdeal =
        Ideal.comap φ₁_cat.hom Q_bot.asIdeal := rfl
    rw [hQ_ideal]
    change Ideal.comap φ₁_cat.hom (Ideal.comap β₁ ⊥) = (⊥ : Ideal D)
    ext d
    simp only [Ideal.mem_comap, Ideal.mem_bot]
    exact ⟨fun hd => hinj_ψ (by
      change β₁ (φ₁_cat.hom d) = β₁ (φ₁_cat.hom 0)
      rw [hd, map_zero, map_zero]), fun hd => by rw [hd, map_zero, map_zero]⟩
  have hp_eq : e_B.base p = hU₀.fromSpec.base (⊥ : PrimeSpectrum D) := by
    calc
      e_B.base p = (j₁ ≫ e_B).base Q_bot := by
        rw [← hj₁_Q]
        rfl
      _ = (g₁ ≫ hU₀.fromSpec).base Q_bot := by
        rw [hg₁_fac]
      _ = hU₀.fromSpec.base ((AlgebraicGeometry.Spec.map φ₁_cat).base Q_bot) := by
        rw [← hSpec_φ₁]
        rfl
      _ = hU₀.fromSpec.base (⊥ : PrimeSpectrum D) := by
        rw [hφ₁_Q]
  rw [hp_eq]
  have _ : AlgebraicGeometry.IsIntegral B.left := hIntB
  have _ : IrreducibleSpace ↥B.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral B.left
  obtain ⟨⟨y₀, hy₀⟩⟩ := hUB
  obtain ⟨x, hxU₀, hxUB⟩ :=
    nonempty_preirreducible_inter U₀.isOpen U_B.isOpen ⟨b₀, hb₀⟩ ⟨y₀, hy₀⟩
  have hx_range : x ∈ Set.range hU₀.fromSpec.base := by
    rwa [hU₀.range_fromSpec]
  obtain ⟨q_x, hq_x⟩ := hx_range
  let O : TopologicalSpace.Opens (PrimeSpectrum D) :=
    (TopologicalSpace.Opens.map hU₀.fromSpec.base).obj U_B
  have hq_O : q_x ∈ O := by
    change hU₀.fromSpec.base q_x ∈ U_B
    rwa [hq_x]
  obtain ⟨s_set, hs_set⟩ :=
    (PrimeSpectrum.isClosed_iff_zeroLocus (O : Set (PrimeSpectrum D))ᶜ).mp O.isOpen.isClosed_compl
  by_contra hbot_not_O
  have hbot_compl : (⊥ : PrimeSpectrum D) ∈ (O : Set (PrimeSpectrum D))ᶜ := hbot_not_O
  rw [hs_set, PrimeSpectrum.mem_zeroLocus] at hbot_compl
  have hsub_q : s_set ⊆ (q_x.asIdeal : Set D) := by
    intro a ha
    have ha0 : a ∈ (⊥ : Ideal D) := hbot_compl ha
    rw [Ideal.mem_bot.mp ha0]
    exact q_x.asIdeal.zero_mem
  have hq_zero : q_x ∈ PrimeSpectrum.zeroLocus s_set :=
    (PrimeSpectrum.mem_zeroLocus q_x s_set).mpr hsub_q
  rw [← hs_set] at hq_zero
  exact hq_zero hq_O

theorem weil_etale_nodal_roof_stalk_integrallyClosed (hEtNorm : ∀ (D S : Type u) [CommRing D] [CommRing S] [Algebra D S]
      [IsDomain D] [IsIntegrallyClosed D] [IsNoetherianRing D]
      [Algebra.Etale D S] (P : Ideal S) [P.IsPrime],
      ∃ (e : S), e ∉ P ∧
        IsDomain (Localization.Away e) ∧
        IsIntegrallyClosed (Localization.Away e))
    (hNodalNorm : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [IsIntegrallyClosed A']
      (h' : A'), h' ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) A' ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'}) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) A' ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'}))
    (R' : CommRingCat.{u}) (s₀ h : R')
    (hDomA' : IsDomain (Localization.Away s₀))
    (hNormA' : IsIntegrallyClosed (Localization.Away s₀))
    (hNoethA' : IsNoetherianRing (Localization.Away s₀))
    (V' : AlgebraicGeometry.Scheme.{u}) (v₀ : V')
    (q : V' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) R' ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})))
    (hq : AlgebraicGeometry.Etale q)
    (hs₀ : Ideal.Quotient.mk _ (MvPolynomial.C s₀) ∉ (q.base v₀).asIdeal)
    (hX : ∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (q.base v₀).asIdeal)
    (hGenDom : ∀ (v : V'),
      Ideal.Quotient.mk _ (MvPolynomial.C s₀) ∉ (q.base v).asIdeal →
      Ideal.comap ((Ideal.Quotient.mk _).comp MvPolynomial.C) (q.base v).asIdeal =
        Ideal.comap (algebraMap R' (Localization.Away s₀)) ⊥ →
      IsDomain ↑(V'.presheaf.stalk v)) :
    IsDomain ↑(V'.presheaf.stalk v₀) ∧
    IsIntegrallyClosed ↑(V'.presheaf.stalk v₀) :=
by
  
  have h_away_equiv :
      ∀ (R₀ A₀ : Type u) [CommRing R₀] [CommRing A₀] [Algebra R₀ A₀]
        (s h₀ : R₀) [IsLocalization.Away s A₀]
        (E_R E_A : Type u) [CommRing E_R] [CommRing E_A]
        (mk_R : MvPolynomial (Fin 2) R₀ →+* E_R)
        (mk_A : MvPolynomial (Fin 2) A₀ →+* E_A)
        (hSurj_R : Function.Surjective mk_R)
        (hKer_R : RingHom.ker mk_R =
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₀})
        (hSurj_A : Function.Surjective mk_A)
        (hKer_A : RingHom.ker mk_A =
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C (algebraMap R₀ A₀ h₀)}),
        ∃ (π_E : E_R →+* E_A),
          RingHom.Etale π_E ∧
          (∀ (p : MvPolynomial (Fin 2) R₀),
            π_E (mk_R p) = mk_A (MvPolynomial.map (algebraMap R₀ A₀) p)) ∧
          (∀ (B₀ : Type u) [CommRing B₀] (ψ₀ : E_R →+* B₀),
            IsUnit (ψ₀ (mk_R (MvPolynomial.C s))) →
            ∃ (φ_q : E_A →+* B₀), φ_q.comp π_E = ψ₀) := by
    intro R₀ A₀ _ _ _ s h₀ _ E_R E_A _ _ mk_R mk_A hSurj_R hKer_R hSurj_A hKer_A
    let s0_bar : E_R := mk_R (MvPolynomial.C s)
    let π₀ : MvPolynomial (Fin 2) R₀ →+* E_A :=
      mk_A.comp (MvPolynomial.map (algebraMap R₀ A₀))
    have hπ₀_le : RingHom.ker mk_R ≤ RingHom.ker π₀ := by
      rw [hKer_R, Ideal.span_le, Set.singleton_subset_iff]
      change mk_A ((MvPolynomial.map (algebraMap R₀ A₀))
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₀)) = 0
      rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C]
      rw [← RingHom.mem_ker, hKer_A]
      exact Ideal.subset_span (Set.mem_singleton _)
    let e_R : (MvPolynomial (Fin 2) R₀ ⧸ RingHom.ker mk_R) ≃+* E_R :=
      RingHom.quotientKerEquivOfSurjective hSurj_R
    let π_quot : (MvPolynomial (Fin 2) R₀ ⧸ RingHom.ker mk_R) →+* E_A :=
      Ideal.Quotient.lift (RingHom.ker mk_R) π₀ (fun _ hx => hπ₀_le hx)
    let π_E : E_R →+* E_A := π_quot.comp e_R.symm.toRingHom
    have hπ_E_mk : ∀ p, π_E (mk_R p) = π₀ p := by
      intro p
      have he : e_R (Ideal.Quotient.mk (RingHom.ker mk_R) p) = mk_R p := rfl
      change π_quot (e_R.symm (mk_R p)) = π₀ p
      rw [← he, e_R.symm_apply_apply]
      rfl
    have hu_π : IsUnit (π_E s0_bar) := by
      change IsUnit (π_E (mk_R (MvPolynomial.C s)))
      rw [hπ_E_mk]
      change IsUnit (mk_A (MvPolynomial.map (algebraMap R₀ A₀) (MvPolynomial.C s)))
      rw [MvPolynomial.map_C]
      exact (mk_A.comp MvPolynomial.C).isUnit_map
        (IsLocalization.Away.algebraMap_isUnit (S := A₀) s)
    let α_to := IsLocalization.Away.lift (S := Localization.Away s0_bar) s0_bar (g := π_E) hu_π
    let γ₀ : R₀ →+* Localization.Away s0_bar :=
      (algebraMap E_R (Localization.Away s0_bar)).comp (mk_R.comp MvPolynomial.C)
    have hu_γ : IsUnit (γ₀ s) :=
      IsLocalization.Away.algebraMap_isUnit (S := Localization.Away s0_bar) s0_bar
    let ι_A : A₀ →+* Localization.Away s0_bar :=
      IsLocalization.Away.lift (S := A₀) s (g := γ₀) hu_γ
    let β_tilde : MvPolynomial (Fin 2) A₀ →+* Localization.Away s0_bar :=
      MvPolynomial.eval₂Hom ι_A
        (fun i => algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.X i)))
    have hβ_le : RingHom.ker mk_A ≤ RingHom.ker β_tilde := by
      rw [hKer_A, Ideal.span_le, Set.singleton_subset_iff]
      change β_tilde (MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C (algebraMap R₀ A₀ h₀)) = 0
      rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C, IsLocalization.Away.lift_eq (S := A₀) s hu_γ h₀]
      change algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.X 0)) *
          algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.X 1)) -
          algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.C h₀)) = 0
      rw [← map_mul (algebraMap E_R (Localization.Away s0_bar)),
        ← map_sub (algebraMap E_R (Localization.Away s0_bar)),
        ← map_mul mk_R, ← map_sub mk_R]
      have hzero : mk_R (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₀) = 0 := by
        rw [← RingHom.mem_ker, hKer_R]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [hzero, map_zero]
    let e_A : (MvPolynomial (Fin 2) A₀ ⧸ RingHom.ker mk_A) ≃+* E_A :=
      RingHom.quotientKerEquivOfSurjective hSurj_A
    let β_quot : (MvPolynomial (Fin 2) A₀ ⧸ RingHom.ker mk_A) →+* Localization.Away s0_bar :=
      Ideal.Quotient.lift (RingHom.ker mk_A) β_tilde (fun _ hx => hβ_le hx)
    let α_inv : E_A →+* Localization.Away s0_bar := β_quot.comp e_A.symm.toRingHom
    have hα_inv_mk : ∀ p, α_inv (mk_A p) = β_tilde p := by
      intro p
      have he : e_A (Ideal.Quotient.mk (RingHom.ker mk_A) p) = mk_A p := rfl
      change β_quot (e_A.symm (mk_A p)) = β_tilde p
      rw [← he, e_A.symm_apply_apply]
      rfl
    have h_left : α_inv.comp α_to = RingHom.id (Localization.Away s0_bar) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers s0_bar)
      have h_poly_R :
          ((α_inv.comp α_to).comp (algebraMap E_R (Localization.Away s0_bar))).comp mk_R =
          (algebraMap E_R (Localization.Away s0_bar)).comp mk_R := by
        apply MvPolynomial.ringHom_ext'
        · ext r
          change α_inv (α_to (algebraMap E_R (Localization.Away s0_bar)
            (mk_R (MvPolynomial.C r)))) =
            algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.C r))
          rw [IsLocalization.Away.lift_eq (S := Localization.Away s0_bar) s0_bar hu_π, hπ_E_mk]
          change α_inv (mk_A (MvPolynomial.map (algebraMap R₀ A₀) (MvPolynomial.C r))) = _
          rw [hα_inv_mk, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact IsLocalization.Away.lift_eq (S := A₀) s hu_γ r
        · intro i
          change α_inv (α_to (algebraMap E_R (Localization.Away s0_bar)
            (mk_R (MvPolynomial.X i)))) =
            algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.X i))
          rw [IsLocalization.Away.lift_eq (S := Localization.Away s0_bar) s0_bar hu_π, hπ_E_mk]
          change α_inv (mk_A (MvPolynomial.map (algebraMap R₀ A₀) (MvPolynomial.X i))) = _
          rw [hα_inv_mk, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      ext x
      obtain ⟨p, rfl⟩ := hSurj_R x
      exact RingHom.congr_fun h_poly_R p
    have h_right : α_to.comp α_inv = RingHom.id E_A := by
      have h_to_ι : α_to.comp ι_A = mk_A.comp MvPolynomial.C := by
        apply IsLocalization.ringHom_ext (Submonoid.powers s)
        ext r
        change α_to (ι_A (algebraMap R₀ A₀ r)) = mk_A (MvPolynomial.C (algebraMap R₀ A₀ r))
        rw [IsLocalization.Away.lift_eq (S := A₀) s hu_γ r]
        change α_to (algebraMap E_R (Localization.Away s0_bar) (mk_R (MvPolynomial.C r))) = _
        rw [IsLocalization.Away.lift_eq (S := Localization.Away s0_bar) s0_bar hu_π, hπ_E_mk]
        change mk_A (MvPolynomial.map (algebraMap R₀ A₀) (MvPolynomial.C r)) = _
        rw [MvPolynomial.map_C]
      have h_poly_A : (α_to.comp α_inv).comp mk_A = mk_A := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          change α_to (α_inv (mk_A (MvPolynomial.C a))) = mk_A (MvPolynomial.C a)
          rw [hα_inv_mk, MvPolynomial.eval₂Hom_C]
          exact RingHom.congr_fun h_to_ι a
        · intro i
          change α_to (α_inv (mk_A (MvPolynomial.X i))) = mk_A (MvPolynomial.X i)
          rw [hα_inv_mk, MvPolynomial.eval₂Hom_X',
            IsLocalization.Away.lift_eq (S := Localization.Away s0_bar) s0_bar hu_π, hπ_E_mk]
          change mk_A (MvPolynomial.map (algebraMap R₀ A₀) (MvPolynomial.X i)) = _
          rw [MvPolynomial.map_X]
      ext x
      obtain ⟨p, rfl⟩ := hSurj_A x
      exact RingHom.congr_fun h_poly_A p
    let α_E : Localization.Away s0_bar ≃+* E_A :=
      { α_to with
        invFun := α_inv
        left_inv := fun x => RingHom.congr_fun h_left x
        right_inv := fun x => RingHom.congr_fun h_right x }
    have hπ_eq : α_E.toRingHom.comp (algebraMap E_R (Localization.Away s0_bar)) = π_E := by
      ext x
      exact IsLocalization.Away.lift_eq (S := Localization.Away s0_bar) s0_bar hu_π x
    have hπ_Etale : RingHom.Etale π_E := by
      rw [← hπ_eq]
      have hEt1 : RingHom.Etale (algebraMap E_R (Localization.Away s0_bar)) :=
        RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway s0_bar)
      have hEt2 : RingHom.Etale α_E.toRingHom :=
        RingHom.Etale.of_bijective α_E.bijective
      exact RingHom.Etale.stableUnderComposition
        (algebraMap E_R (Localization.Away s0_bar)) α_E.toRingHom hEt1 hEt2
    refine ⟨π_E, hπ_Etale, hπ_E_mk, ?_⟩
    intro B₀ _ ψ₀ hu
    let φ_L := IsLocalization.Away.lift (S := Localization.Away s0_bar) s0_bar (g := ψ₀) hu
    refine ⟨φ_L.comp α_E.symm.toRingHom, ?_⟩
    rw [← hπ_eq]
    ext x
    change φ_L (α_E.symm (α_E (algebraMap E_R (Localization.Away s0_bar) x))) = ψ₀ x
    rw [α_E.symm_apply_apply]
    exact IsLocalization.Away.lift_eq (S := Localization.Away s0_bar) s0_bar hu x

  
  have h_param_ne_zero :
      ∀ (A₀ B₀ E₀ : Type u) [CommRing A₀] [IsDomain A₀] [CommRing B₀] [CommRing E₀]
        (h' : A₀)
        (mk_A : MvPolynomial (Fin 2) A₀ →+* E₀)
        (hSurj_A : Function.Surjective mk_A)
        (hKer_A : RingHom.ker mk_A =
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'})
        (φ : E₀ →+* B₀) (hEt : RingHom.Etale φ)
        (Q₀ : Ideal B₀) [Q₀.IsPrime]
        (hX_Q₀ : ∀ i : Fin 2, φ (mk_A (MvPolynomial.X i)) ∈ Q₀)
        (hGen : ∀ (P : Ideal B₀) [P.IsPrime], P ≤ Q₀ →
          Ideal.comap (φ.comp (mk_A.comp MvPolynomial.C)) P = ⊥ →
          IsDomain (Localization.AtPrime P)),
        h' ≠ 0 := by
    intro A₀ B₀ E₀ _ _ _ _ h' mk_A hSurj_A hKer_A φ hEt Q₀ _ hX_Q₀ hGen hh'0
    have hev00_le : RingHom.ker mk_A ≤ RingHom.ker (MvPolynomial.eval (0 : Fin 2 → A₀)) := by
      rw [hKer_A, Ideal.span_le, Set.singleton_subset_iff]
      change (MvPolynomial.eval (0 : Fin 2 → A₀))
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h') = 0
      rw [map_sub, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, MvPolynomial.eval_C, hh'0]
      simp
    let e_A : (MvPolynomial (Fin 2) A₀ ⧸ RingHom.ker mk_A) ≃+* E₀ :=
      RingHom.quotientKerEquivOfSurjective hSurj_A
    let ev00_quot : (MvPolynomial (Fin 2) A₀ ⧸ RingHom.ker mk_A) →+* A₀ :=
      Ideal.Quotient.lift (RingHom.ker mk_A) (MvPolynomial.eval 0) (fun _ hx => hev00_le hx)
    let ev00 : E₀ →+* A₀ := ev00_quot.comp e_A.symm.toRingHom
    have hev00_mk : ∀ p, ev00 (mk_A p) = MvPolynomial.eval 0 p := by
      intro p
      have he : e_A (Ideal.Quotient.mk (RingHom.ker mk_A) p) = mk_A p := rfl
      change ev00_quot (e_A.symm (mk_A p)) = MvPolynomial.eval 0 p
      rw [← he, e_A.symm_apply_apply]
      rfl
    have hSurj00 : Function.Surjective ev00 := by
      intro a
      refine ⟨mk_A (MvPolynomial.C a), ?_⟩
      rw [hev00_mk, MvPolynomial.eval_C]
    let q_node : Ideal E₀ := RingHom.ker ev00
    have _ : IsDomain (E₀ ⧸ q_node) :=
      MulEquiv.isDomain A₀ (RingHom.quotientKerEquivOfSurjective hSurj00).toMulEquiv
    have _ : q_node.IsPrime := (Ideal.Quotient.isDomain_iff_prime q_node).mp ‹_›
    have hpoly_mod_Q₀ : ∀ (p : MvPolynomial (Fin 2) A₀),
        φ (mk_A p) - φ (mk_A (MvPolynomial.C (MvPolynomial.eval 0 p))) ∈ Q₀ := by
      intro p
      refine MvPolynomial.induction_on
        (motive := fun q => φ (mk_A q) - φ (mk_A (MvPolynomial.C (MvPolynomial.eval 0 q))) ∈ Q₀)
        p ?_ ?_ ?_
      · intro a
        rw [MvPolynomial.eval_C, sub_self]
        exact Q₀.zero_mem
      · intro p₁ p₂ hp₁ hp₂
        rw [map_add, map_add, map_add, map_add, map_add, map_add]
        have h_eq :
            (φ (mk_A p₁) + φ (mk_A p₂)) -
              (φ (mk_A (MvPolynomial.C ((MvPolynomial.eval 0) p₁))) +
                φ (mk_A (MvPolynomial.C ((MvPolynomial.eval 0) p₂)))) =
            (φ (mk_A p₁) - φ (mk_A (MvPolynomial.C ((MvPolynomial.eval 0) p₁)))) +
            (φ (mk_A p₂) - φ (mk_A (MvPolynomial.C ((MvPolynomial.eval 0) p₂)))) := by
          ring
        rw [h_eq]
        exact Q₀.add_mem hp₁ hp₂
      · intro p₁ i _
        simp only [map_mul, MvPolynomial.eval_X, Pi.zero_apply, mul_zero, map_zero, sub_zero]
        exact Q₀.mul_mem_left _ (hX_Q₀ i)
    have hq_le : q_node ≤ Ideal.comap φ Q₀ := by
      intro x hx
      obtain ⟨p, rfl⟩ := hSurj_A x
      have hp0 : MvPolynomial.eval 0 p = 0 := by
        rw [← hev00_mk p]
        exact hx
      have hdiff := hpoly_mod_Q₀ p
      rw [hp0, map_zero, map_zero, map_zero, sub_zero] at hdiff
      exact hdiff
    let _ : Algebra E₀ B₀ := φ.toAlgebra
    have _ : Algebra.Etale E₀ B₀ := hEt.toAlgebra
    have _ : Module.Flat E₀ B₀ := inferInstance
    have _ : Algebra.HasGoingDown E₀ B₀ := Algebra.HasGoingDown.of_flat
    let q_top : Ideal E₀ := Ideal.under E₀ Q₀
    have _ : q_top.IsPrime := Ideal.comap_isPrime φ Q₀
    have _ : Q₀.LiesOver q_top := ⟨rfl⟩
    obtain ⟨P_η, hP_le, hP_prime, hP_over⟩ :=
      @Ideal.exists_ideal_le_liesOver_of_le E₀ B₀ _ _ _ _ q_node q_top _ _ Q₀ _ _ hq_le
    have _ : P_η.IsPrime := hP_prime
    have hover_eq : q_node = Ideal.comap φ P_η := hP_over.over
    have hP_bot : Ideal.comap (φ.comp (mk_A.comp MvPolynomial.C)) P_η = ⊥ := by
      ext a
      change mk_A (MvPolynomial.C a) ∈ Ideal.comap φ P_η ↔ a = 0
      rw [← hover_eq]
      change ev00 (mk_A (MvPolynomial.C a)) = 0 ↔ a = 0
      rw [hev00_mk, MvPolynomial.eval_C]
    have hDom_L₁ : IsDomain (Localization.AtPrime P_η) := hGen P_η hP_le hP_bot
    let L₀ : Type u := Localization.AtPrime q_node
    let L₁ : Type u := Localization.AtPrime P_η
    have _ : IsDomain L₁ := hDom_L₁
    let lam : L₀ →+* L₁ := Localization.localRingHom q_node P_η φ hover_eq
    let _ : Algebra L₀ L₁ := lam.toAlgebra
    have _ : IsScalarTower E₀ L₀ L₁ :=
      IsScalarTower.of_algebraMap_eq (fun e => by
        rw [IsScalarTower.algebraMap_apply E₀ B₀ L₁ e]
        exact (Localization.localRingHom_to_map q_node P_η φ hover_eq e).symm)
    have _ : Module.Flat B₀ L₁ := IsLocalization.flat L₁ P_η.primeCompl
    have hFlat_E₀_L₁ : Module.Flat E₀ L₁ := Module.Flat.trans E₀ B₀ L₁
    have _ : Module.Flat L₀ L₁ :=
      (Module.flat_iff_of_isLocalization L₀ q_node.primeCompl L₁).mpr hFlat_E₀_L₁
    have _ : IsLocalHom (algebraMap L₀ L₁) :=
      Localization.isLocalHom_localRingHom q_node P_η φ hover_eq
    have _ : Module.FaithfullyFlat L₀ L₁ := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hlam_inj : Function.Injective lam := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      have hmem : z ∈ Ideal.comap (algebraMap L₀ L₁)
          (Ideal.map (algebraMap L₀ L₁) (⊥ : Ideal L₀)) := by
        rw [Ideal.map_bot]
        exact Ideal.mem_bot.mpr hz
      rw [Ideal.comap_map_eq_self_of_faithfullyFlat] at hmem
      exact Ideal.mem_bot.mp hmem
    have _ : IsDomain L₀ := Function.Injective.isDomain lam hlam_inj
    have hxi_ne_zero : ∀ i : Fin 2, algebraMap E₀ L₀ (mk_A (MvPolynomial.X i)) ≠ 0 := by
      intro i hxi0
      let ev_i_poly : MvPolynomial (Fin 2) A₀ →+* Polynomial A₀ :=
        MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then Polynomial.X else 0)
      have hev_i_le : RingHom.ker mk_A ≤ RingHom.ker ev_i_poly := by
        rw [hKer_A, Ideal.span_le, Set.singleton_subset_iff]
        change ev_i_poly (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h') = 0
        rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, hh'0, map_zero, sub_zero]
        fin_cases i <;> simp
      let ev_i_quot : (MvPolynomial (Fin 2) A₀ ⧸ RingHom.ker mk_A) →+* Polynomial A₀ :=
        Ideal.Quotient.lift (RingHom.ker mk_A) ev_i_poly (fun _ hx => hev_i_le hx)
      let ev_i : E₀ →+* Polynomial A₀ := ev_i_quot.comp e_A.symm.toRingHom
      have hev_i_mk : ∀ p, ev_i (mk_A p) = ev_i_poly p := by
        intro p
        have he : e_A (Ideal.Quotient.mk (RingHom.ker mk_A) p) = mk_A p := rfl
        change ev_i_quot (e_A.symm (mk_A p)) = ev_i_poly p
        rw [← he, e_A.symm_apply_apply]
        rfl
      have hcc_eq : Polynomial.constantCoeff.comp ev_i = ev00 := by
        have hcc_poly :
            (Polynomial.constantCoeff.comp ev_i).comp mk_A = ev00.comp mk_A := by
          apply MvPolynomial.ringHom_ext'
          · ext a
            change Polynomial.constantCoeff (ev_i (mk_A (MvPolynomial.C a))) =
              ev00 (mk_A (MvPolynomial.C a))
            rw [hev_i_mk, hev00_mk, MvPolynomial.eval₂Hom_C, Polynomial.constantCoeff_apply,
              Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_C, MvPolynomial.eval_C]
          · intro j
            change Polynomial.constantCoeff (ev_i (mk_A (MvPolynomial.X j))) =
              ev00 (mk_A (MvPolynomial.X j))
            rw [hev_i_mk, hev00_mk, MvPolynomial.eval₂Hom_X', MvPolynomial.eval_X, Pi.zero_apply]
            by_cases hj : j = i
            · simp only [hj, ↓reduceIte, Polynomial.constantCoeff_apply,
                Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_X]
            · simp only [hj, ↓reduceIte, map_zero]
        ext x
        obtain ⟨p, rfl⟩ := hSurj_A x
        exact RingHom.congr_fun hcc_poly p
      obtain ⟨⟨s, hs⟩, hs_mul⟩ :=
        (IsLocalization.map_eq_zero_iff q_node.primeCompl L₀ (mk_A (MvPolynomial.X i))).mp hxi0
      have hev_mul : ev_i (s * mk_A (MvPolynomial.X i)) = 0 := by
        rw [hs_mul, map_zero]
      rw [map_mul, hev_i_mk, MvPolynomial.eval₂Hom_X'] at hev_mul
      simp only [↓reduceIte] at hev_mul
      have hs_nmem : ev00 s ≠ 0 := hs
      have hev_s_ne : ev_i s ≠ 0 := by
        intro h0
        apply hs_nmem
        rw [← RingHom.congr_fun hcc_eq s]
        change Polynomial.constantCoeff (ev_i s) = 0
        rw [h0, map_zero]
      exact mul_ne_zero hev_s_ne Polynomial.X_ne_zero hev_mul
    have hmul_zero :
        algebraMap E₀ L₀ (mk_A (MvPolynomial.X 0)) *
        algebraMap E₀ L₀ (mk_A (MvPolynomial.X 1)) = 0 := by
      rw [← map_mul, ← map_mul]
      have hzero : mk_A (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := by
        have hsub : mk_A (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h') = 0 := by
          rw [← RingHom.mem_ker, hKer_A]
          exact Ideal.subset_span (Set.mem_singleton _)
        rw [hh'0, map_zero, sub_zero] at hsub
        exact hsub
      rw [hzero, map_zero]
    exact mul_ne_zero (hxi_ne_zero 0) (hxi_ne_zero 1) hmul_zero

  
  have h_etale_atPrime :
      ∀ (E₀ B₀ S₀ : Type u) [CommRing E₀] [CommRing B₀] [CommRing S₀]
        [IsDomain E₀] [IsIntegrallyClosed E₀] [IsNoetherianRing E₀]
        (φ : E₀ →+* B₀) (hEt : RingHom.Etale φ)
        (Q₀ : Ideal B₀) [Q₀.IsPrime]
        [Algebra B₀ S₀] [IsLocalization.AtPrime S₀ Q₀],
        IsDomain S₀ ∧ IsIntegrallyClosed S₀ := by
    intro E₀ B₀ S₀ _ _ _ _ _ _ φ hEt Q₀ _ _ _
    let _ : Algebra E₀ B₀ := φ.toAlgebra
    have _ : Algebra.Etale E₀ B₀ := hEt.toAlgebra
    obtain ⟨e', he', hDom_e', hNorm_e'⟩ := hEtNorm E₀ B₀ Q₀
    let M : Submonoid B₀ := Submonoid.powers e'
    have _ : IsDomain (Localization M) := hDom_e'
    have _ : IsIntegrallyClosed (Localization M) := hNorm_e'
    have hDisj : Disjoint (M : Set B₀) (Q₀ : Set B₀) := by
      rw [Set.disjoint_left]
      intro x hxM hxQ
      obtain ⟨n, rfl⟩ := hxM
      exact he' (Ideal.IsPrime.mem_of_pow_mem inferInstance n hxQ)
    let p : Ideal (Localization M) := Ideal.map (algebraMap B₀ (Localization M)) Q₀
    have _ : p.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M (Localization M) Q₀ inferInstance hDisj
    have h_under : Ideal.comap (algebraMap B₀ (Localization M)) p = Q₀ :=
      IsLocalization.under_map_of_isPrime_disjoint M (Localization M) inferInstance hDisj
    have hle_p : p.primeCompl ≤ nonZeroDivisors (Localization M) := by
      intro s hs
      apply mem_nonZeroDivisors_of_ne_zero
      intro hs0
      apply hs
      change s ∈ p
      rw [hs0]
      exact p.zero_mem
    have hDom_p : IsDomain (Localization.AtPrime p) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.AtPrime p) hle_p
    have hNorm_p : IsIntegrallyClosed (Localization.AtPrime p) :=
      isIntegrallyClosed_of_isLocalization (Localization.AtPrime p) p.primeCompl hle_p
    let I₀ : Ideal B₀ := Ideal.comap (algebraMap B₀ (Localization M)) p
    have h_pc : I₀.primeCompl = Q₀.primeCompl := by
      ext x
      change x ∉ Ideal.comap (algebraMap B₀ (Localization M)) p ↔ x ∉ Q₀
      rw [h_under]
    have _ : IsLocalization Q₀.primeCompl (Localization.AtPrime I₀) :=
      h_pc ▸ (inferInstance : IsLocalization I₀.primeCompl (Localization.AtPrime I₀))
    let Ξ : S₀ ≃+* Localization.AtPrime p :=
      ((IsLocalization.algEquiv Q₀.primeCompl S₀ (Localization.AtPrime I₀)).trans
        (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M p)).toRingEquiv
    exact ⟨MulEquiv.isDomain (Localization.AtPrime p) Ξ.toMulEquiv,
      @IsIntegrallyClosed.of_equiv _ _ _ _ Ξ.symm hNorm_p⟩

  
  let I_R : Ideal (MvPolynomial (Fin 2) R') :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
  let mk_R := Ideal.Quotient.mk I_R
  let s0_bar := mk_R (MvPolynomial.C s₀)
  let h' : Localization.Away s₀ := algebraMap R' (Localization.Away s₀) h
  let I_A : Ideal (MvPolynomial (Fin 2) (Localization.Away s₀)) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h'}
  let mk_A := Ideal.Quotient.mk I_A
  obtain ⟨π_E, hπ_Etale, hπ_E_mk, hπ_lift⟩ :=
    h_away_equiv R' (Localization.Away s₀) s₀ h
      (MvPolynomial (Fin 2) R' ⧸ I_R)
      (MvPolynomial (Fin 2) (Localization.Away s₀) ⧸ I_A)
      mk_R mk_A
      Ideal.Quotient.mk_surjective Ideal.mk_ker
      Ideal.Quotient.mk_surjective Ideal.mk_ker
  let U_E : (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) R' ⧸ I_R))).Opens :=
    PrimeSpectrum.basicOpen s0_bar
  have hv₀_UE : v₀ ∈ (TopologicalSpace.Opens.map q.base).obj U_E :=
    (PrimeSpectrum.mem_basicOpen s0_bar (q.base v₀)).mpr hs₀
  obtain ⟨W', hW', hv₀, hW'_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
      (x := v₀) (U := (TopologicalSpace.Opens.map q.base).obj U_E) hv₀_UE
  let B'_cat : CommRingCat.{u} := V'.presheaf.obj (Opposite.op W')
  let g₀ : AlgebraicGeometry.Spec B'_cat ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) R' ⧸ I_R)) :=
    hW'.fromSpec ≫ q
  have : AlgebraicGeometry.Etale q := hq
  have _ : AlgebraicGeometry.Etale g₀ := inferInstance
  let ψ₀_cat : CommRingCat.of (MvPolynomial (Fin 2) R' ⧸ I_R) ⟶ B'_cat :=
    (AlgebraicGeometry.Spec.fullyFaithful.preimage g₀).unop
  let ψ₀ := ψ₀_cat.hom
  have hg₀_eq : AlgebraicGeometry.Spec.map ψ₀_cat = g₀ :=
    AlgebraicGeometry.Spec.map_preimage_unop g₀
  have hbase_comap : ∀ (Q : PrimeSpectrum ↑B'_cat),
      (q.base (hW'.fromSpec.base Q)).asIdeal = Ideal.comap ψ₀ Q.asIdeal := by
    intro Q
    change (g₀.base Q).asIdeal = Ideal.comap ψ₀ Q.asIdeal
    rw [← hg₀_eq]
    rfl
  have hu_s0_bar : IsUnit (ψ₀ s0_bar) := by
    by_contra hnu
    obtain ⟨M, hM, hmem⟩ := Ideal.exists_le_maximal _ (Ideal.span_singleton_ne_top hnu)
    let y_M : PrimeSpectrum ↑B'_cat := ⟨M, hM.isPrime⟩
    have hw_M : hW'.fromSpec.base y_M ∈ W' := by
      change hW'.fromSpec.base y_M ∈ (W' : Set V')
      rw [← hW'.range_fromSpec]
      exact ⟨y_M, rfl⟩
    have hs_not_mem : s0_bar ∉ (q.base (hW'.fromSpec.base y_M)).asIdeal :=
      (PrimeSpectrum.mem_basicOpen s0_bar _).mp (hW'_sub hw_M)
    rw [hbase_comap y_M] at hs_not_mem
    exact hs_not_mem (hmem (Ideal.subset_span (Set.mem_singleton _)))
  obtain ⟨φ_q, hφ_comp⟩ := hπ_lift ↑B'_cat ψ₀ hu_s0_bar
  let φ_cat :
      CommRingCat.of (MvPolynomial (Fin 2) (Localization.Away s₀) ⧸ I_A) ⟶ B'_cat :=
    CommRingCat.ofHom φ_q
  have hcat_comp : CommRingCat.ofHom π_E ≫ φ_cat = ψ₀_cat :=
    CommRingCat.hom_ext hφ_comp
  have hSpec_comp :
      AlgebraicGeometry.Spec.map φ_cat ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_E) = g₀ := by
    rw [← AlgebraicGeometry.Spec.map_comp, hcat_comp, hg₀_eq]
  have hSpec_π_Etale :
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_E)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hπ_Etale
  have hSpec_φ_Etale : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by
    apply CategoryTheory.MorphismProperty.of_postcomp @AlgebraicGeometry.Etale
      (W' := @AlgebraicGeometry.Etale)
      (AlgebraicGeometry.Spec.map φ_cat)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_E))
      hSpec_π_Etale
    rwa [hSpec_comp]
  have hφ_Etale : RingHom.Etale φ_q :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hSpec_φ_Etale
  let Q₀ : Ideal ↑B'_cat := (hW'.primeIdealOf ⟨v₀, hv₀⟩).asIdeal
  have hv₀_ideal : (q.base v₀).asIdeal = Ideal.comap (φ_q.comp π_E) Q₀ := by
    have hfv₀ : hW'.fromSpec.base (hW'.primeIdealOf ⟨v₀, hv₀⟩) = v₀ :=
      hW'.fromSpec_primeIdealOf ⟨v₀, hv₀⟩
    calc
      (q.base v₀).asIdeal =
          (q.base (hW'.fromSpec.base (hW'.primeIdealOf ⟨v₀, hv₀⟩))).asIdeal := by
        rw [hfv₀]
      _ = Ideal.comap ψ₀ Q₀ := hbase_comap (hW'.primeIdealOf ⟨v₀, hv₀⟩)
      _ = Ideal.comap (φ_q.comp π_E) Q₀ := by rw [hφ_comp]
  have hX_Q₀ : ∀ i : Fin 2, φ_q (mk_A (MvPolynomial.X i)) ∈ Q₀ := by
    intro i
    have hi : mk_R (MvPolynomial.X i) ∈ (q.base v₀).asIdeal := hX i
    rw [hv₀_ideal] at hi
    change φ_q (π_E (mk_R (MvPolynomial.X i))) ∈ Q₀ at hi
    rw [hπ_E_mk, MvPolynomial.map_X] at hi
    exact hi
  have hGen_Q₀ : ∀ (P : Ideal ↑B'_cat) [P.IsPrime], P ≤ Q₀ →
      Ideal.comap (φ_q.comp (mk_A.comp MvPolynomial.C)) P = ⊥ →
      IsDomain (Localization.AtPrime P) := by
    intro P hP_prime _ hP_bot
    let y_P : PrimeSpectrum ↑B'_cat := ⟨P, hP_prime⟩
    let v_P : V' := hW'.fromSpec.base y_P
    have hv_P : v_P ∈ W' := by
      change hW'.fromSpec.base y_P ∈ (W' : Set V')
      rw [← hW'.range_fromSpec]
      exact ⟨y_P, rfl⟩
    have hs₀_vP : s0_bar ∉ (q.base v_P).asIdeal :=
      (PrimeSpectrum.mem_basicOpen s0_bar _).mp (hW'_sub hv_P)
    have hcomap_vP :
        Ideal.comap (mk_R.comp MvPolynomial.C) (q.base v_P).asIdeal =
          Ideal.comap (algebraMap R' (Localization.Away s₀)) ⊥ := by
      ext r
      change mk_R (MvPolynomial.C r) ∈ (q.base (hW'.fromSpec.base y_P)).asIdeal ↔
        algebraMap R' (Localization.Away s₀) r ∈ (⊥ : Ideal (Localization.Away s₀))
      rw [hbase_comap y_P, ← hφ_comp]
      change φ_q (π_E (mk_R (MvPolynomial.C r))) ∈ P ↔ _
      rw [hπ_E_mk, MvPolynomial.map_C]
      change algebraMap R' (Localization.Away s₀) r ∈
        Ideal.comap (φ_q.comp (mk_A.comp MvPolynomial.C)) P ↔ _
      rw [hP_bot]
    have hDom_stalk_P : IsDomain ↑(V'.presheaf.stalk v_P) :=
      hGenDom v_P hs₀_vP hcomap_vP
    let _ : Algebra ↑B'_cat ↑(V'.presheaf.stalk v_P) :=
      TopCat.Presheaf.algebra_section_stalk V'.presheaf ⟨v_P, hv_P⟩
    have _ : IsLocalization.AtPrime ↑(V'.presheaf.stalk v_P) P :=
      hW'.isLocalization_stalk' y_P hv_P
    have _ : IsDomain ↑(V'.presheaf.stalk v_P) := hDom_stalk_P
    exact MulEquiv.isDomain ↑(V'.presheaf.stalk v_P)
      (IsLocalization.algEquiv P.primeCompl
        (Localization.AtPrime P) ↑(V'.presheaf.stalk v_P)).toMulEquiv
  have _ : IsDomain (Localization.Away s₀) := hDomA'
  have _ : IsIntegrallyClosed (Localization.Away s₀) := hNormA'
  have _ : IsNoetherianRing (Localization.Away s₀) := hNoethA'
  have hh' : h' ≠ 0 :=
    h_param_ne_zero (Localization.Away s₀) ↑B'_cat
      (MvPolynomial (Fin 2) (Localization.Away s₀) ⧸ I_A)
      h' mk_A Ideal.Quotient.mk_surjective Ideal.mk_ker φ_q hφ_Etale Q₀ hX_Q₀ hGen_Q₀
  obtain ⟨hDomE₀, hNormE₀⟩ := hNodalNorm (Localization.Away s₀) h' hh'
  have _ : IsDomain (MvPolynomial (Fin 2) (Localization.Away s₀) ⧸ I_A) := hDomE₀
  have _ : IsIntegrallyClosed (MvPolynomial (Fin 2) (Localization.Away s₀) ⧸ I_A) := hNormE₀
  let _ : Algebra ↑B'_cat ↑(V'.presheaf.stalk v₀) :=
    TopCat.Presheaf.algebra_section_stalk V'.presheaf ⟨v₀, hv₀⟩
  have _ : IsLocalization.AtPrime ↑(V'.presheaf.stalk v₀) Q₀ :=
    hW'.isLocalization_stalk ⟨v₀, hv₀⟩
  exact h_etale_atPrime
    (MvPolynomial (Fin 2) (Localization.Away s₀) ⧸ I_A)
    ↑B'_cat ↑(V'.presheaf.stalk v₀) φ_q hφ_Etale Q₀

theorem weil_semistable_curve_isAffineNormalScheme_over_normal_base (k : Type u) [Field k]
    (hEtNorm : ∀ (D S : Type u) [CommRing D] [CommRing S] [Algebra D S]
      [IsDomain D] [IsIntegrallyClosed D] [IsNoetherianRing D]
      [Algebra.Etale D S] (P : Ideal S) [P.IsPrime],
      ∃ (e : S), e ∉ P ∧
        IsDomain (Localization.Away e) ∧
        IsIntegrallyClosed (Localization.Away e))
    (B C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (f : C ⟶ B) (n : ℕ) (τ : Fin n → (B ⟶ C))
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hNormB : IsAffineNormalScheme B.left)
    (hUB : Nonempty U_B)
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hIntC : AlgebraicGeometry.IsIntegral C.left) :
    IsAffineNormalScheme C.left :=
by
  have _ : AlgebraicGeometry.IsIntegral C.left := hIntC
  
  have hEtSm0 : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ Y),
      AlgebraicGeometry.Etale g → AlgebraicGeometry.SmoothOfRelativeDimension 0 g := by
    intro X Y g hg
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro z
    obtain ⟨U, hU, hzU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g.base z) (U := ⊤) trivial
    obtain ⟨V, hV, hzV, hVU⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := z) (U := (TopologicalSpace.Opens.map g.base).obj U) hzU
    refine ⟨U, hU, V, hV, hzV, hVU, ?_⟩
    have hEt : RingHom.Etale (g.appLE U V hVU).hom :=
      AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) g hg ⟨U, hU⟩ ⟨V, hV⟩ hVU
    let _ : Algebra ↑(Y.presheaf.obj (Opposite.op U)) ↑(X.presheaf.obj (Opposite.op V)) :=
      (g.appLE U V hVU).hom.toAlgebra
    exact (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero).mp hEt
  
  have hStalkNorm : ∀ x : C.left, IsIntegrallyClosed ↑(C.left.presheaf.stalk x) := by
    intro x
    rcases hCurve.2.2.2.2.2.2.2.2.2 x with
      ⟨V, hxV, hSmV⟩ |
      ⟨R', e_B, h, V', v₀, e_C, q, he_B, he_C, hq, he_C_v₀, hX, _, hcomm_roof⟩
    · 
      obtain ⟨U_x, hUx, hxU, _, hDomU, hNormU⟩ :=
        weil_smooth_relDimOne_affineNormal_nhds_over_normal_base k hEtNorm B C
          hProjB hNormB f V hSmV x hxV
      let _ : Algebra ↑(C.left.presheaf.obj (Opposite.op U_x)) ↑(C.left.presheaf.stalk x) :=
        TopCat.Presheaf.algebra_section_stalk C.left.presheaf ⟨x, hxU⟩
      have _ : IsLocalization.AtPrime (↑(C.left.presheaf.stalk x))
          (hUx.primeIdealOf ⟨x, hxU⟩).asIdeal :=
        hUx.isLocalization_stalk ⟨x, hxU⟩
      have _ : IsDomain ↑(C.left.presheaf.obj (Opposite.op U_x)) := hDomU
      have _ : IsIntegrallyClosed ↑(C.left.presheaf.obj (Opposite.op U_x)) := hNormU
      have hle : (hUx.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl ≤
          nonZeroDivisors ↑(C.left.presheaf.obj (Opposite.op U_x)) := by
        intro s hs
        apply mem_nonZeroDivisors_of_ne_zero
        intro hs0
        apply hs
        change s ∈ (hUx.primeIdealOf ⟨x, hxU⟩).asIdeal
        rw [hs0]
        exact Ideal.zero_mem _
      exact isIntegrallyClosed_of_isLocalization (↑(C.left.presheaf.stalk x)) _ hle
    · 
      rw [← he_C_v₀]
      have _ : AlgebraicGeometry.Etale e_C := he_C
      
      let V'_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (e_C ≫ f.left ≫ B.hom)
      let f_V' : V'_over ⟶ B := CategoryTheory.Over.homMk (e_C ≫ f.left) rfl
      let V_smC : C.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj U_B
      let W_sm : V'.Opens := (TopologicalSpace.Opens.map e_C.base).obj V_smC
      have hSmW_sm : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f_V'.left) := by
        have hSm0_e : AlgebraicGeometry.SmoothOfRelativeDimension 0 (e_C ∣_ V_smC) :=
          hEtSm0 (e_C ∣_ V_smC) inferInstance
        have hSm1_f : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f.left ∣_ U_B) :=
          hCurve.2.2.2.2.2.1
        have hSm0_ι : AlgebraicGeometry.SmoothOfRelativeDimension 0 U_B.ι :=
          hEtSm0 U_B.ι inferInstance
        have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension 1
            ((e_C ∣_ V_smC) ≫ (f.left ∣_ U_B)) := by
          simpa using @AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 _ _
            (e_C ∣_ V_smC) _ (f.left ∣_ U_B) hSm0_e hSm1_f
        have hSm1 : AlgebraicGeometry.SmoothOfRelativeDimension 1
            (((e_C ∣_ V_smC) ≫ (f.left ∣_ U_B)) ≫ U_B.ι) := by
          simpa using @AlgebraicGeometry.smoothOfRelativeDimension_comp 1 0 _ _
            ((e_C ∣_ V_smC) ≫ (f.left ∣_ U_B)) _ U_B.ι hSm01 hSm0_ι
        have hW_eq : W_sm.ι ≫ f_V'.left =
            ((e_C ∣_ V_smC) ≫ (f.left ∣_ U_B)) ≫ U_B.ι := by
          change W_sm.ι ≫ (e_C ≫ f.left) = ((e_C ∣_ V_smC) ≫ (f.left ∣_ U_B)) ≫ U_B.ι
          rw [← CategoryTheory.Category.assoc W_sm.ι e_C f.left,
            ← AlgebraicGeometry.morphismRestrict_ι e_C V_smC,
            CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.morphismRestrict_ι f.left U_B,
            ← CategoryTheory.Category.assoc]
        rwa [hW_eq]
      have hDomOnW : ∀ (v : V'), v ∈ W_sm → IsDomain ↑(V'.presheaf.stalk v) := by
        intro v hv
        obtain ⟨U_v, hUv, hvU, _, hDomUv, _⟩ :=
          weil_smooth_relDimOne_affineNormal_nhds_over_normal_base k hEtNorm B V'_over
            hProjB hNormB f_V' W_sm hSmW_sm v hv
        let _ : Algebra ↑(V'_over.left.presheaf.obj (Opposite.op U_v))
            ↑(V'_over.left.presheaf.stalk v) :=
          TopCat.Presheaf.algebra_section_stalk V'_over.left.presheaf ⟨v, hvU⟩
        have _ : IsLocalization.AtPrime (↑(V'_over.left.presheaf.stalk v))
            (hUv.primeIdealOf ⟨v, hvU⟩).asIdeal :=
          hUv.isLocalization_stalk ⟨v, hvU⟩
        have _ : IsDomain ↑(V'_over.left.presheaf.obj (Opposite.op U_v)) := hDomUv
        have hle_v : (hUv.primeIdealOf ⟨v, hvU⟩).asIdeal.primeCompl ≤
            nonZeroDivisors ↑(V'_over.left.presheaf.obj (Opposite.op U_v)) := by
          intro s hs
          apply mem_nonZeroDivisors_of_ne_zero
          intro hs0
          apply hs
          change s ∈ (hUv.primeIdealOf ⟨v, hvU⟩).asIdeal
          rw [hs0]
          exact Ideal.zero_mem _
        exact @IsLocalization.isDomain_of_le_nonZeroDivisors
          ↑(V'_over.left.presheaf.obj (Opposite.op U_v)) _ _
          (↑(V'_over.left.presheaf.stalk v)) _ _ _ hDomUv hle_v
      
      let π_base : AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) R' ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})) ⟶
          AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
      let p₀ : AlgebraicGeometry.Spec R' := π_base.base (q.base v₀)
      obtain ⟨s₀, hs₀_p₀, hDomA', hNormA', hNoethA', h_in_UB⟩ :=
        weil_etale_spec_base_normal_away_and_generic_in_open k hEtNorm B U_B
          hIntB hProjB hNormB hUB R' e_B he_B p₀
      have hGenDom : ∀ (v : V'),
          Ideal.Quotient.mk _ (MvPolynomial.C s₀) ∉ (q.base v).asIdeal →
          Ideal.comap ((Ideal.Quotient.mk _).comp MvPolynomial.C) (q.base v).asIdeal =
            Ideal.comap (algebraMap R' (Localization.Away s₀)) ⊥ →
          IsDomain ↑(V'.presheaf.stalk v) := by
        intro v hs₀_v hbot_v
        let p_v : AlgebraicGeometry.Spec R' := π_base.base (q.base v)
        have hv_UB : e_B.base p_v ∈ U_B := h_in_UB p_v hs₀_v hbot_v
        have hbase_eq : f.left.base (e_C.base v) = e_B.base p_v := by
          change (e_C ≫ f.left).base v = (q ≫ π_base ≫ e_B).base v
          exact congrArg (fun m => m.base v) hcomm_roof
        have hv_W : v ∈ W_sm := by
          change f.left.base (e_C.base v) ∈ U_B
          rwa [hbase_eq]
        exact hDomOnW v hv_W
      obtain ⟨hDomStalkV, hNormStalkV⟩ :=
        weil_etale_nodal_roof_stalk_integrallyClosed hEtNorm
          (@weil_nodal_quotient_domain_and_integrallyClosed)
          R' s₀ h hDomA' hNormA' hNoethA' V' v₀ q hq hs₀_p₀ hX hGenDom
      
      let A : Type u := ↑(C.left.presheaf.stalk (e_C.base v₀))
      let B_st : Type u := ↑(V'.presheaf.stalk v₀)
      have _ : IsDomain B_st := hDomStalkV
      let ψ : A →+* B_st := (e_C.stalkMap v₀).hom
      have hFlatψ : ψ.Flat := AlgebraicGeometry.Flat.stalkMap e_C v₀
      let _ : Algebra A B_st := ψ.toAlgebra
      have _ : Module.Flat A B_st := hFlatψ
      have _ : IsLocalHom (algebraMap A B_st) :=
        inferInstanceAs (IsLocalHom (e_C.stalkMap v₀).hom)
      have _ : Module.FaithfullyFlat A B_st := Module.FaithfullyFlat.of_flat_of_isLocalHom
      have hψ_inj : Function.Injective ψ := by
        rw [injective_iff_map_eq_zero]
        intro a ha
        have hmem : a ∈ Ideal.comap (algebraMap A B_st)
            (Ideal.map (algebraMap A B_st) (⊥ : Ideal A)) := by
          rw [Ideal.map_bot]
          exact Ideal.mem_bot.mpr ha
        rw [Ideal.comap_map_eq_self_of_faithfullyFlat] at hmem
        exact Ideal.mem_bot.mp hmem
      have hφ_inj : Function.Injective ((algebraMap B_st (FractionRing B_st)).comp ψ) :=
        (IsFractionRing.injective B_st (FractionRing B_st)).comp hψ_inj
      obtain ⟨ψ_frac, hψ_frac⟩ : ∃ ψ_frac : FractionRing A →+* FractionRing B_st,
          ∀ r : A, ψ_frac (algebraMap A (FractionRing A) r) =
            algebraMap B_st (FractionRing B_st) (ψ r) :=
        ⟨IsFractionRing.lift hφ_inj, IsFractionRing.lift_algebraMap hφ_inj⟩
      rw [isIntegrallyClosed_iff (FractionRing A)]
      intro z hz
      obtain ⟨⟨a, ⟨b, hb⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) z
      obtain ⟨p, hp_monic, hp_eval⟩ := hz
      have hz_B : IsIntegral B_st (ψ_frac (IsLocalization.mk' (FractionRing A) a ⟨b, hb⟩)) := by
        refine ⟨p.map ψ, hp_monic.map ψ, ?_⟩
        rw [Polynomial.eval₂_map]
        have hcomp : (algebraMap B_st (FractionRing B_st)).comp ψ =
            ψ_frac.comp (algebraMap A (FractionRing A)) := by
          ext r
          exact (hψ_frac r).symm
        rw [hcomp, ← Polynomial.hom_eval₂, hp_eval, map_zero]
      obtain ⟨c, hc⟩ := (isIntegrallyClosed_iff (FractionRing B_st)).mp hNormStalkV hz_B
      have hmul : algebraMap B_st (FractionRing B_st) (ψ b * c) =
          algebraMap B_st (FractionRing B_st) (ψ a) := by
        rw [map_mul, hc, ← hψ_frac b, ← hψ_frac a, ← map_mul,
          IsLocalization.mk'_spec' (FractionRing A) a ⟨b, hb⟩]
      have hab_B : ψ b * c = ψ a := IsFractionRing.injective B_st (FractionRing B_st) hmul
      have ha_mem : a ∈ Ideal.comap (algebraMap A B_st)
          (Ideal.map (algebraMap A B_st) (Ideal.span ({b} : Set A))) := by
        change ψ a ∈ Ideal.map ψ (Ideal.span ({b} : Set A))
        rw [← hab_B, mul_comm]
        exact Ideal.mul_mem_left _ c
          (Ideal.mem_map_of_mem ψ (Ideal.subset_span (Set.mem_singleton b)))
      rw [Ideal.comap_map_eq_self_of_faithfullyFlat] at ha_mem
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp ha_mem
      exact ⟨r, (IsLocalization.mk'_mul_cancel_left r ⟨b, hb⟩).symm⟩
  
  intro U hU hNonempty
  have _ : Nonempty ↥U := hNonempty
  have _ : IsDomain ↑(C.left.presheaf.obj (Opposite.op U)) :=
    AlgebraicGeometry.IsIntegral.component_integral U
  refine ⟨‹_›, ?_⟩
  apply IsIntegrallyClosed.of_localization_maximal
  intro P _ _
  let y : PrimeSpectrum ↑(C.left.presheaf.obj (Opposite.op U)) :=
    ⟨P, Ideal.IsMaximal.isPrime' P⟩
  have hx_mem : hU.fromSpec.base y ∈ (U : Set ↥C.left) := by
    rw [← hU.range_fromSpec]
    exact ⟨y, rfl⟩
  have hx : hU.fromSpec.base y ∈ U := hx_mem
  let _ : Algebra ↑(C.left.presheaf.obj (Opposite.op U))
      ↑(C.left.presheaf.stalk (hU.fromSpec.base y)) :=
    TopCat.Presheaf.algebra_section_stalk C.left.presheaf ⟨hU.fromSpec.base y, hx⟩
  have _ : IsLocalization.AtPrime (↑(C.left.presheaf.stalk (hU.fromSpec.base y))) P :=
    hU.isLocalization_stalk' y hx
  have _ : IsIntegrallyClosed ↑(C.left.presheaf.stalk (hU.fromSpec.base y)) :=
    hStalkNorm (hU.fromSpec.base y)
  exact IsIntegrallyClosed.of_equiv
    (IsLocalization.algEquiv P.primeCompl
      (↑(C.left.presheaf.stalk (hU.fromSpec.base y))) (Localization.AtPrime P)).toRingEquiv

theorem weil_strict_transform_sections_and_threeSecant_fibers (k : Type u) [Field k]
    (B₂ X₂ B₃ X₃ B X_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (f₂ : X₂ ⟶ B₂) (n : ℕ) (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (U₃ : B₃.left.Opens) (ψ₃ : B₃ ⟶ B₂)
    (pX₃ : X₃ ⟶ B₃) (qX₃ : X₃ ⟶ X₂)
    (hClX₃ : ∃ hcommX : qX₃.left ≫ f₂.left = pX₃.left ≫ ψ₃.left,
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift qX₃.left pX₃.left hcommX) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift qX₃.left pX₃.left hcommX) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base).obj U₃)))
    (U_good : B₃.left.Opens) (ψ₄ : B ⟶ B₃)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hUgoodSub : (U_good : Set B₃.left) ⊆ (U₃ : Set B₃.left))
    (hUB : Nonempty ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))
    (f_XB : X_B ⟶ B) (q_XB : X_B ⟶ X₃)
    (hcomm_XB : q_XB.left ≫ pX₃.left = f_XB.left ≫ ψ₄.left)
    (hProjXB : IsProjectiveOverField k X_B)
    (hClXB : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB))
    (hIsoXB : CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∣_
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd pX₃.left ψ₄.left).base).obj
            ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good)))) :
    ∃ (σ_B : Fin n → (B ⟶ X_B)),
      AlgebraicGeometry.IsProper f_XB.left ∧
      AlgebraicGeometry.Surjective f_XB.left ∧
      (∀ j : Fin n, σ_B j ≫ f_XB = 𝟙 B ∧ σ_B j ≫ (q_XB ≫ qX₃) = (ψ₄ ≫ ψ₃) ≫ σ j) ∧
      (∃ hcommXB : (q_XB ≫ qX₃).left ≫ f₂.left = f_XB.left ≫ (ψ₄ ≫ ψ₃).left,
        CategoryTheory.IsIso
          ((CategoryTheory.Limits.pullback.lift (q_XB ≫ qX₃).left f_XB.left hcommXB) ∣_
            ((TopologicalSpace.Opens.map
              (CategoryTheory.Limits.pullback.snd f₂.left (ψ₄ ≫ ψ₃).left).base).obj
                ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good)))) ∧
      (∀ (K : Type u) [Field K] [IsAlgClosed K]
          (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B.left)
          (E : Set ↥(CategoryTheory.Limits.pullback f_XB.left s)),
        E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f_XB.left s) →
        topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧
        ∃ (j₁ j₂ j₃ : Fin n)
          (q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback f_XB.left s))
          (W₁ W₂ W₃ : X_B.left.Opens),
          q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
          q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
          (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₁ ∈ Set.range (σ_B j₁).left.base ∧
          (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₂ ∈ Set.range (σ_B j₂).left.base ∧
          (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₃ ∈ Set.range (σ_B j₃).left.base ∧
          (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₁ ∈ W₁ ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ f_XB.left) ∧
          (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₂ ∈ W₂ ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₂.ι ≫ f_XB.left) ∧
          (CategoryTheory.Limits.pullback.fst f_XB.left s).base q₃ ∈ W₃ ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₃.ι ≫ f_XB.left)) :=
by
  
  have hIsoOfLE : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ Y)
      {U V : Y.Opens} (_ : V ≤ U) [CategoryTheory.IsIso (g ∣_ U)],
      CategoryTheory.IsIso (g ∣_ V) := by
    intro X Y g U V hVU _
    let W₀ : U.toScheme.Opens := (TopologicalSpace.Opens.map U.ι.base).obj V
    let eV : W₀.toScheme ≅ V.toScheme := Scheme.Opens.isoOfLE hVU
    let U_X : X.Opens := (TopologicalSpace.Opens.map g.base).obj U
    let W_UX : U_X.toScheme.Opens := (TopologicalSpace.Opens.map (g ∣_ U).base).obj W₀
    let V_X : X.Opens := (TopologicalSpace.Opens.map g.base).obj V
    have hPb₁ : IsPullback ((g ∣_ U) ∣_ W₀) (W_UX.ι ≫ U_X.ι) (W₀.ι ≫ U.ι) g :=
      (isPullback_morphismRestrict (g ∣_ U) W₀).paste_vert (isPullback_morphismRestrict g U)
    have hPb₂ : IsPullback (((g ∣_ U) ∣_ W₀) ≫ eV.hom) (W_UX.ι ≫ U_X.ι) V.ι g := by
      have hTop : IsPullback (((g ∣_ U) ∣_ W₀) ≫ eV.hom) (𝟙 _) eV.inv ((g ∣_ U) ∣_ W₀) :=
        IsPullback.of_vert_isIso ⟨by simp⟩
      have hPaste := hTop.paste_vert hPb₁
      have heV : eV.inv ≫ W₀.ι ≫ U.ι = V.ι := by
        rw [Iso.inv_comp_eq]
        exact (Scheme.Opens.isoOfLE_hom_ι hVU).symm
      simpa [Category.id_comp, heV] using hPaste
    have hPbV : IsPullback (g ∣_ V) V_X.ι V.ι g :=
      isPullback_morphismRestrict g V
    let α := IsPullback.isoIsPullback V.toScheme X hPb₂ hPbV
    have hEq : g ∣_ V = α.inv ≫ (((g ∣_ U) ∣_ W₀) ≫ eV.hom) := by
      rw [Iso.eq_inv_comp]
      exact IsPullback.isoIsPullback_hom_fst V.toScheme X hPb₂ hPbV
    rw [hEq]
    infer_instance
  
  have hPropXB : AlgebraicGeometry.IsProper f_XB.left := by
    have hHomProper : ∀ {Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))},
        IsProjectiveOverField k Y → AlgebraicGeometry.IsProper Y.hom := by
      intro Y ⟨N, ιY, hClY⟩
      have : AlgebraicGeometry.IsClosedImmersion ιY.left := hClY
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let φ₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
      have hφ₀_val : ∀ c : k, (φ₀ c : MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C c := by
        intro c
        rw [Algebra.algebraMap_eq_smul_one]
        change c • (1 : MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C c
        rw [← Algebra.algebraMap_eq_smul_one]
        rfl
      have hInj : Function.Injective φ₀ := by
        intro c₁ c₂ hc
        have hc' : (φ₀ c₁ : MvPolynomial (Fin (N + 1)) k) =
            (φ₀ c₂ : MvPolynomial (Fin (N + 1)) k) :=
          congrArg Subtype.val hc
        rw [hφ₀_val, hφ₀_val] at hc'
        simpa using congrArg MvPolynomial.constantCoeff hc'
      have hSurj : Function.Surjective φ₀ := by
        intro p
        refine ⟨MvPolynomial.constantCoeff p.1, Subtype.ext ?_⟩
        rw [hφ₀_val]
        ext d
        by_cases hd : d = 0
        · subst hd
          simp [MvPolynomial.coeff_C, MvPolynomial.constantCoeff_eq]
        · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h => False.elim (hd h.symm)]
          by_contra hne
          have hhom : MvPolynomial.IsHomogeneous p.1 0 :=
            (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
          have hdeg := hhom (Ne.symm hne)
          apply hd
          ext i
          rw [Finsupp.coe_zero, Pi.zero_apply]
          by_cases hi : i ∈ d.support
          · simpa using Finset.sum_eq_zero_iff.mp hdeg i hi
          · exact Finsupp.notMem_support_iff.mp hi
      let e₀ : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective φ₀ ⟨hInj, hSurj⟩
      have : IsIso (CommRingCat.ofHom φ₀) :=
        ⟨⟨CommRingCat.ofHom e₀.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext fun x => e₀.symm_apply_apply x),
          CommRingCat.hom_ext (RingHom.ext fun x => e₀.apply_symm_apply x)⟩⟩
      have : IsIso (Spec.map (CommRingCat.ofHom φ₀)) := inferInstance
      have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        ⟨fun c a q => by
          change (c • a).1 * q = c • (a.1 * q)
          exact smul_mul_assoc c a.1 q⟩
      have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) := by
        obtain ⟨s, hs⟩ :=
          (inferInstance : Algebra.FiniteType k (MvPolynomial (Fin (N + 1)) k)).out
        refine ⟨⟨s, top_unique ?_⟩⟩
        intro q _
        have hq : q ∈ Algebra.adjoin k (s : Set (MvPolynomial (Fin (N + 1)) k)) := by
          rw [hs]; trivial
        exact (Algebra.adjoin_le (R := k)
          (S := (Algebra.adjoin ↥(𝒜 0) (s : Set (MvPolynomial (Fin (N + 1)) k))).restrictScalars k)
          (fun x hx => Algebra.subset_adjoin hx)) hq
      have : IsProper (Proj.toSpecZero 𝒜) := inferInstance
      have : IsProper (Spec.map (CommRingCat.ofHom φ₀)) := inferInstance
      have : IsProper ιY.left := inferInstance
      have hP1 : IsProper (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ₀)) :=
        MorphismProperty.comp_mem (@IsProper) _ _ inferInstance inferInstance
      have hP2 : IsProper (ιY.left ≫ Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ₀)) :=
        MorphismProperty.comp_mem (@IsProper) _ _ inferInstance hP1
      have hComp : ιY.left ≫ Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ₀) = Y.hom :=
        CategoryTheory.Over.w ιY
      rwa [hComp] at hP2
    have : IsProper X_B.hom := hHomProper hProjXB
    have : IsProper B.hom := hHomProper hProjB
    have : IsProper (f_XB.left ≫ B.hom) := by
      rw [CategoryTheory.Over.w f_XB]
      infer_instance
    exact AlgebraicGeometry.IsProper.of_comp f_XB.left B.hom
  
  have hStage2 : ∃ (σ_B : Fin n → (B ⟶ X_B))
      (hcommXB : (q_XB ≫ qX₃).left ≫ f₂.left = f_XB.left ≫ (ψ₄ ≫ ψ₃).left),
      (∀ j : Fin n, σ_B j ≫ f_XB = 𝟙 B ∧ σ_B j ≫ (q_XB ≫ qX₃) = (ψ₄ ≫ ψ₃) ≫ σ j) ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift (q_XB ≫ qX₃).left f_XB.left hcommXB) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift (q_XB ≫ qX₃).left f_XB.left hcommXB) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd f₂.left (ψ₄ ≫ ψ₃).left).base).obj
              ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))) := by
    have hσ : ∀ j : Fin n, σ j ≫ f₂ = 𝟙 B₂ := hFib₂.2.2.1
    obtain ⟨hcommX₃, hCl₃, hIso₃⟩ := hClX₃
    let ψ : B ⟶ B₂ := ψ₄ ≫ ψ₃
    let q_XB_2 : X_B ⟶ X₂ := q_XB ≫ qX₃
    let U_B : B.left.Opens := (TopologicalSpace.Opens.map ψ₄.left.base).obj U_good
    have hcommXB : q_XB_2.left ≫ f₂.left = f_XB.left ≫ ψ.left := by
      change (q_XB.left ≫ qX₃.left) ≫ f₂.left = f_XB.left ≫ (ψ₄.left ≫ ψ₃.left)
      rw [Category.assoc, hcommX₃, ← Category.assoc, hcomm_XB, Category.assoc]
    let P₃ := Limits.pullback f₂.left ψ₃.left
    let ι₃ : X₃.left ⟶ P₃ := Limits.pullback.lift qX₃.left pX₃.left hcommX₃
    let P₃B := Limits.pullback pX₃.left ψ₄.left
    let ι_XB_3 : X_B.left ⟶ P₃B := Limits.pullback.lift q_XB.left f_XB.left hcomm_XB
    let P₂ := Limits.pullback f₂.left ψ.left
    let π₂ : P₂ ⟶ X₂.left := Limits.pullback.fst f₂.left ψ.left
    let p₂ : P₂ ⟶ B.left := Limits.pullback.snd f₂.left ψ.left
    let ι_XB_2 : X_B.left ⟶ P₂ := Limits.pullback.lift q_XB_2.left f_XB.left hcommXB
    let θ : P₂ ⟶ P₃ :=
      Limits.pullback.lift π₂ (p₂ ≫ ψ₄.left) (by
        rw [Category.assoc]
        exact Limits.pullback.condition)
    have hPb_θ : IsPullback θ p₂ (Limits.pullback.snd f₂.left ψ₃.left) ψ₄.left :=
      IsPullback.of_right
        (by
          rw [Limits.pullback.lift_fst]
          exact IsPullback.of_hasPullback f₂.left ψ.left)
        (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback f₂.left ψ₃.left)
    let ι'_3B : P₃B ⟶ P₂ :=
      Limits.pullback.lift (Limits.pullback.fst pX₃.left ψ₄.left ≫ qX₃.left)
        (Limits.pullback.snd pX₃.left ψ₄.left) (by
          rw [Category.assoc, hcommX₃, ← Category.assoc, Limits.pullback.condition,
            Category.assoc]
          rfl)
    have hcomm_ι' : Limits.pullback.fst pX₃.left ψ₄.left ≫ ι₃ = ι'_3B ≫ θ := by
      apply Limits.pullback.hom_ext
      · dsimp [ι₃, θ, ι'_3B, π₂]
        rw [Category.assoc, Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst]
      · dsimp [ι₃, θ, ι'_3B, p₂]
        rw [Category.assoc, Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd,
          ← Category.assoc, Limits.pullback.lift_snd, Limits.pullback.condition]
    have hPb_ι' : IsPullback (Limits.pullback.fst pX₃.left ψ₄.left) ι'_3B ι₃ θ :=
      IsPullback.of_bot
        (by
          have h1 : ι'_3B ≫ p₂ = Limits.pullback.snd pX₃.left ψ₄.left :=
            Limits.pullback.lift_snd _ _ _
          have h2 : ι₃ ≫ Limits.pullback.snd f₂.left ψ₃.left = pX₃.left :=
            Limits.pullback.lift_snd _ _ _
          rw [h1, h2]
          exact IsPullback.of_hasPullback pX₃.left ψ₄.left)
        hcomm_ι' hPb_θ
    have : IsClosedImmersion ι₃ := hCl₃
    have : IsClosedImmersion ι'_3B :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ι' hCl₃
    have : IsClosedImmersion ι_XB_3 := hClXB
    have hFactor_ι : ι_XB_2 = ι_XB_3 ≫ ι'_3B := by
      apply Limits.pullback.hom_ext
      · dsimp [ι_XB_2, ι_XB_3, ι'_3B, π₂, q_XB_2]
        rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst,
          ← Category.assoc, Limits.pullback.lift_fst]
      · dsimp [ι_XB_2, ι_XB_3, ι'_3B, p₂]
        rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd]
    have hClXB_2 : IsClosedImmersion ι_XB_2 := by
      rw [hFactor_ι]
      infer_instance
    have : IsClosedImmersion ι_XB_2 := hClXB_2
    let W₃_pb : P₃.Opens :=
      (TopologicalSpace.Opens.map (Limits.pullback.snd f₂.left ψ₃.left).base).obj U₃
    let W'_23 : P₂.Opens := (TopologicalSpace.Opens.map θ.base).obj W₃_pb
    let W_B_pb : P₂.Opens := (TopologicalSpace.Opens.map p₂.base).obj U_B
    let W_3B_pb : P₃B.Opens :=
      (TopologicalSpace.Opens.map (Limits.pullback.snd pX₃.left ψ₄.left).base).obj U_B
    have : IsIso (ι₃ ∣_ W₃_pb) := hIso₃
    have : IsIso (ι'_3B ∣_ W'_23) := by
      let V_3B : P₃B.Opens := (TopologicalSpace.Opens.map ι'_3B.base).obj W'_23
      let V_3 : X₃.left.Opens := (TopologicalSpace.Opens.map ι₃.base).obj W₃_pb
      have hV_le : V_3B ≤
          (TopologicalSpace.Opens.map (Limits.pullback.fst pX₃.left ψ₄.left).base).obj V_3 := by
        intro x hx
        change θ.base (ι'_3B.base x) ∈ W₃_pb at hx
        change ι₃.base ((Limits.pullback.fst pX₃.left ψ₄.left).base x) ∈ W₃_pb
        have h_eq := congrArg (fun g => g.base x) hcomm_ι'
        simpa using h_eq.symm ▸ hx
      let res_top : V_3B.toScheme ⟶ V_3.toScheme :=
        (Limits.pullback.fst pX₃.left ψ₄.left).resLE V_3 V_3B hV_le
      have hOuter : IsPullback (res_top ≫ V_3.ι) (ι'_3B ∣_ W'_23) ι₃
          ((θ ∣_ W₃_pb) ≫ W₃_pb.ι) := by
        have h1 : res_top ≫ V_3.ι = V_3B.ι ≫ Limits.pullback.fst pX₃.left ψ₄.left :=
          Scheme.Hom.resLE_comp_ι _ _
        have h2 : (θ ∣_ W₃_pb) ≫ W₃_pb.ι = W'_23.ι ≫ θ := morphismRestrict_ι θ W₃_pb
        rw [h1, h2]
        exact (isPullback_morphismRestrict ι'_3B W'_23).flip.paste_horiz hPb_ι'
      have hCommSq : res_top ≫ (ι₃ ∣_ W₃_pb) = (ι'_3B ∣_ W'_23) ≫ (θ ∣_ W₃_pb) := by
        rw [← cancel_mono W₃_pb.ι]
        rw [Category.assoc, Category.assoc, morphismRestrict_ι, morphismRestrict_ι,
          Scheme.Hom.resLE_comp_ι_assoc, morphismRestrict_ι_assoc, hcomm_ι']
      have hPb_res : IsPullback res_top (ι'_3B ∣_ W'_23) (ι₃ ∣_ W₃_pb) (θ ∣_ W₃_pb) :=
        IsPullback.of_right hOuter hCommSq (isPullback_morphismRestrict ι₃ W₃_pb).flip
      exact hPb_res.isIso_snd_of_isIso
    have hWB_le_W23 : W_B_pb ≤ W'_23 := by
      intro x hx
      change p₂.base x ∈ U_B at hx
      change (Limits.pullback.snd f₂.left ψ₃.left).base (θ.base x) ∈ U₃
      have h_eq : (θ ≫ Limits.pullback.snd f₂.left ψ₃.left).base x =
          (p₂ ≫ ψ₄.left).base x := by
        rw [Limits.pullback.lift_snd]
      change (θ ≫ Limits.pullback.snd f₂.left ψ₃.left).base x ∈ U₃
      rw [h_eq]
      exact hUgoodSub hx
    have : IsIso (ι'_3B ∣_ W_B_pb) := hIsoOfLE ι'_3B hWB_le_W23
    have : IsIso (ι_XB_3 ∣_ W_3B_pb) := hIsoXB
    have hPre_le : (ι'_3B ⁻¹ᵁ W_B_pb) ≤ W_3B_pb := by
      intro x hx
      change p₂.base (ι'_3B.base x) ∈ U_B at hx
      change (Limits.pullback.snd pX₃.left ψ₄.left).base x ∈ U_B
      have h_eq : (ι'_3B ≫ p₂).base x = (Limits.pullback.snd pX₃.left ψ₄.left).base x := by
        rw [Limits.pullback.lift_snd]
      exact h_eq ▸ hx
