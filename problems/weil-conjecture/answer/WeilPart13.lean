          map_smul' := fun r u => by simp [mul_smul, smul_add] }
      let 𝔪₀ : Ideal L₀ := IsLocalRing.maximalIdeal L₀
      have htmul_zero_mem : ∀ z : Ω[L₀⁄κ₀],
          (1 : κ_L) ⊗ₜ[L₀] z = 0 → z ∈ 𝔪₀ • (⊤ : Submodule L₀ Ω[L₀⁄κ₀]) := by
        intro z hz
        let N_smul : Submodule L₀ Ω[L₀⁄κ₀] := 𝔪₀ • ⊤
        let span_mkQ :=
          LinearMap.toSpanSingleton L₀ (Ω[L₀⁄κ₀] →ₗ[L₀] (Ω[L₀⁄κ₀] ⧸ N_smul)) N_smul.mkQ
        have h_ker_N : 𝔪₀ ≤ LinearMap.ker span_mkQ := by
          intro r hr
          rw [LinearMap.mem_ker]
          refine LinearMap.ext fun m => ?_
          change N_smul.mkQ (r • m) = 0
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
          exact Submodule.smul_mem_smul hr trivial
        let ψ_N : TensorProduct L₀ κ_L Ω[L₀⁄κ₀] →ₗ[L₀] (Ω[L₀⁄κ₀] ⧸ N_smul) :=
