  · 
    intro Z g_Z τ_Z E₁ E₂ q hZ hE₁ hE₂ hNe hq₁ hq₂
    let Z₀ := CategoryTheory.Limits.pullback g_Z s_Ω
    have hE₁_max := irreducibleComponents_eq_maximals_closed (X := ↥Z₀) ▸ hE₁
    have hE₂_max := irreducibleComponents_eq_maximals_closed (X := ↥Z₀) ▸ hE₂
    obtain ⟨⟨hE₁_cl, hE₁_irred⟩, hE₁_top⟩ := hE₁_max
