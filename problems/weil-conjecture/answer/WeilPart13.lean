            rw [Submodule.map_smul'']
            exact Submodule.smul_mono le_rfl le_top
          exact hmap_le (Submodule.mem_map_of_mem hmem_smul)
        have hjac : 𝔪₀ ≤ (⊥ : Ideal L₀).jacobson := by
