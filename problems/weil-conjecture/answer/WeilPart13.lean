            rw [map_mul]; ring
          rw [hrew]
          have hpow : m₀.asIdeal * m₀.asIdeal ^ 2 = m₀.asIdeal ^ 3 := by ring
          rw [← hpow]
          exact Ideal.add_mem _ (Ideal.mul_mem_mul hx₁ h₂) (Ideal.mul_mem_mul hy₂ h₁)
