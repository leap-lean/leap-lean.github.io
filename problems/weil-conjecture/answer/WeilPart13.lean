    have : m_A.IsPrime := m₀.isPrime.comap ψ
    have h_le_cube : m_A ^ 3 ≤ Ideal.comap ψ (m₀.asIdeal ^ 3) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono Ideal.map_comap_le 3
