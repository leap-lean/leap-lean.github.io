              (Submodule.Quotient.mk (p := 𝔪₀) (1 : L₀))) z = N_smul.mkQ z
            rw [Submodule.liftQ_apply]
            change ((1 : L₀) • N_smul.mkQ) z = N_smul.mkQ z
            rw [one_smul]
          rw [← h_app, hz, map_zero]
        rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hz_q
      have hSurj_Ω : Function.Surjective π_Ω := by
        let S_Ω : Submodule L₀ Ω[L₀⁄κ₀] := LinearMap.range π_Ω
        let Q := Ω[L₀⁄κ₀] ⧸ S_Ω
        have hFG : (⊤ : Submodule L₀ Q).FG := Module.Finite.fg_top
        have hle : (⊤ : Submodule L₀ Q) ≤ 𝔪₀ • (⊤ : Submodule L₀ Q) := by
          intro q _
          obtain ⟨ω, rfl⟩ := Submodule.Quotient.mk_surjective S_Ω q
          let v : TensorProduct L₀ κ_L Ω[L₀⁄κ₀] := (1 : κ_L) ⊗ₜ[L₀] ω
          have hv : b.repr v 0 • b 0 + b.repr v 1 • b 1 = v := by
            have hsum := b.sum_repr v
            rwa [Fin.sum_univ_two] at hsum
          obtain ⟨u₀, hu₀⟩ := IsLocalRing.residue_surjective (b.repr v 0)
          obtain ⟨u₁, hu₁⟩ := IsLocalRing.residue_surjective (b.repr v 1)
          let u : Fin 2 → L₀ := ![u₀, u₁]
          have hdiff_zero : (1 : κ_L) ⊗ₜ[L₀] (ω - π_Ω u) = 0 := by
            rw [TensorProduct.tmul_sub]
            change v - (1 : κ_L) ⊗ₜ[L₀] (u₀ • ω₀ + u₁ • ω₁) = 0
            rw [TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
