      refine (@AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _ (g_a ∣_ U_Wa) Φ_a
        (U_Wa.ι ≫ W_a.ι) (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left)
        hOpen_a inferInstance ?_ h_opens_eq).flip
      exact hΦ_snd.trans ((CategoryTheory.Category.assoc _ _ _).symm.trans
