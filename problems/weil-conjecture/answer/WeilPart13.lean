      have hC : e_mv (MvPolynomial.C k₁) = MvPolynomial.C (ι_K k₁) := by
        change MvPolynomial.map ι_K.toRingHom (MvPolynomial.C k₁) = _
        exact MvPolynomial.map_C ι_K.toRingHom k₁
