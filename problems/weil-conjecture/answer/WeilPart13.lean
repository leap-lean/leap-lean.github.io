          Λ x₀ 1 = 1 ∧ Λ x₀ 2 = 0 ∧
          Λ x₁ 1 = 0 ∧ Λ x₁ 2 = 1 ∧
          (∀ u v : T_std, u ∈ 𝔫 → v ∈ 𝔫 →
