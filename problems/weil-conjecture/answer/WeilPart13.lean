    exact ⟨S', π, p₂, ν, hIntS', hProjS', hPropπ, hSurjπ, hIsoπ, hOpenν, hνπ, hνp₂⟩
  obtain ⟨S', π, p₂, ν, hIntS', hProjS', hPropπ, hSurjπ, hIsoπ, hOpenν, hνπ, hνp₂⟩ := hPart3
  let _ : AlgebraicGeometry.IsIntegral S'.left := hIntS'
  have : AlgebraicGeometry.IsOpenImmersion ν := hOpenν

  
  have hPart4 :
      ∀ (W S'_sch S_base : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsIntegral W]
        [AlgebraicGeometry.IsIntegral S'_sch]
        [AlgebraicGeometry.IsIntegral S_base]
        (ν₀ : W ⟶ S'_sch) [AlgebraicGeometry.IsOpenImmersion ν₀]
        (π₀ : S'_sch ⟶ S_base)
        (j_U : W ⟶ S_base) [AlgebraicGeometry.IsOpenImmersion j_U]
        (_ : ν₀ ≫ π₀ = j_U),
        ∃ (e_K : ↑S'_sch.functionField →+* ↑S_base.functionField)
          (e_W : ↑W.functionField →+* ↑S_base.functionField),
          Function.Bijective e_K ∧
          (∀ (V : S_base.Opens) [Nonempty V] (V' : S'_sch.Opens) [Nonempty V']
              (hVV' : V' ≤ (TopologicalSpace.Opens.map π₀.base).obj V),
            (e_K.comp (S'_sch.germToFunctionField V').hom).comp (π₀.appLE V V' hVV').hom =
              (S_base.germToFunctionField V).hom) ∧
          (∀ (V : S_base.Opens) [Nonempty V] (W' : W.Opens) [Nonempty W']
              (hWW' : W' ≤ (TopologicalSpace.Opens.map j_U.base).obj V),
            (e_W.comp (W.germToFunctionField W').hom).comp (j_U.appLE V W' hWW').hom =
              (S_base.germToFunctionField V).hom) ∧
          (∀ (U_A : S'_sch.Opens) [Nonempty U_A],
            ∃ hNeW' : Nonempty ((TopologicalSpace.Opens.map ν₀.base).obj U_A),
              letI := hNeW'
              (e_W.comp (W.germToFunctionField ((TopologicalSpace.Opens.map ν₀.base).obj U_A)).hom).comp
                  (ν₀.appLE U_A ((TopologicalSpace.Opens.map ν₀.base).obj U_A) (le_refl _)).hom =
                e_K.comp (S'_sch.germToFunctionField U_A).hom) := by
    intro W S'_sch S_base _ _ _ ν₀ _ π₀ j_U _ hνπ₀
    subst hνπ₀
    have hHelper :
        ∀ {X Y : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsIntegral X]
          [AlgebraicGeometry.IsIntegral Y] (g : X ⟶ Y)
          (hg : g.base (genericPoint ↥X) = genericPoint ↥Y)
          (_ : CategoryTheory.IsIso (g.stalkMap (genericPoint ↥X))),
          ∃ (iso_g : X.functionField ≅ Y.functionField),
            ∀ (U_Y : Y.Opens) [Nonempty U_Y] (U_X : X.Opens) [Nonempty U_X]
              (hXY : U_X ≤ (TopologicalSpace.Opens.map g.base).obj U_Y),
              (g.appLE U_Y U_X hXY ≫ X.germToFunctionField U_X) ≫ iso_g.hom =
                Y.germToFunctionField U_Y := by
      intro X Y _ _ g hg hIso
      have := hIso
      let η_X : ↥X := genericPoint ↥X
      let iso_g : X.functionField ≅ Y.functionField :=
        (CategoryTheory.asIso (g.stalkMap η_X)).symm ≪≫
          Y.presheaf.stalkCongr (Inseparable.of_eq hg)
      refine ⟨iso_g, ?_⟩
      intro U_Y _ U_X _ hXY
      obtain ⟨u₀⟩ := (‹Nonempty U_X› : Nonempty U_X)
      have hηX_UX : η_X ∈ U_X :=
        ((genericPoint_spec ↥X).mem_open_set_iff U_X.isOpen).mpr ⟨u₀.1, trivial, u₀.2⟩
      have hηX_pre : η_X ∈ (TopologicalSpace.Opens.map g.base).obj U_Y := hXY hηX_UX
      have hηX_g : g.base η_X ∈ U_Y := hηX_pre
      have h1 : g.appLE U_Y U_X hXY ≫ X.germToFunctionField U_X =
          Y.presheaf.germ U_Y (g.base η_X) hηX_g ≫ g.stalkMap η_X := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE, CategoryTheory.Category.assoc]
        change g.app U_Y ≫ (X.presheaf.map (CategoryTheory.homOfLE hXY).op ≫
          X.presheaf.germ U_X η_X hηX_UX) = _
        rw [TopCat.Presheaf.germ_res]
        exact (AlgebraicGeometry.PresheafedSpace.stalkMap_germ g.toPshHom U_Y η_X hηX_pre).symm
      calc (g.appLE U_Y U_X hXY ≫ X.germToFunctionField U_X) ≫ iso_g.hom
          = (Y.presheaf.germ U_Y (g.base η_X) hηX_g ≫ (CategoryTheory.asIso (g.stalkMap η_X)).hom) ≫
              ((CategoryTheory.asIso (g.stalkMap η_X)).inv ≫
                (Y.presheaf.stalkCongr (Inseparable.of_eq hg)).hom) := by
              rw [h1]
              rfl
        _ = Y.presheaf.germ U_Y (g.base η_X) hηX_g ≫
              (Y.presheaf.stalkCongr (Inseparable.of_eq hg)).hom := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
        _ = Y.germToFunctionField U_Y := by
              rw [TopCat.Presheaf.stalkCongr_hom]
              exact TopCat.Presheaf.germ_stalkSpecializes Y.presheaf hηX_g
                (Inseparable.of_eq hg).symm.specializes
    let η_W : ↥W := genericPoint ↥W
    let η' : ↥S'_sch := genericPoint ↥S'_sch
    let η : ↥S_base := genericPoint ↥S_base
    have hη_ν : ν₀.base η_W = η' := AlgebraicGeometry.genericPoint_eq_of_isOpenImmersion ν₀
    have hη_j : (ν₀ ≫ π₀).base η_W = η :=
      AlgebraicGeometry.genericPoint_eq_of_isOpenImmersion (ν₀ ≫ π₀)
    have hη_π : π₀.base η' = η := by
      rw [← hη_ν]
      exact hη_j
    have hIso_ν : CategoryTheory.IsIso (ν₀.stalkMap η_W) := inferInstance
    have hIso_comp : CategoryTheory.IsIso ((ν₀ ≫ π₀).stalkMap η_W) := inferInstance
    have hIso_π_ν : CategoryTheory.IsIso (π₀.stalkMap (ν₀.base η_W)) := by
      have hcomp : (ν₀ ≫ π₀).stalkMap η_W = π₀.stalkMap (ν₀.base η_W) ≫ ν₀.stalkMap η_W :=
        AlgebraicGeometry.PresheafedSpace.stalkMap.comp ν₀.toPshHom π₀.toPshHom η_W
      have : CategoryTheory.IsIso (π₀.stalkMap (ν₀.base η_W) ≫ ν₀.stalkMap η_W) := by
        rwa [← hcomp]
      exact CategoryTheory.IsIso.of_isIso_comp_right (π₀.stalkMap (ν₀.base η_W)) (ν₀.stalkMap η_W)
    have hIso_π : CategoryTheory.IsIso (π₀.stalkMap η') := by
      rwa [← hη_ν]
    obtain ⟨iso_π, h_π⟩ := hHelper π₀ hη_π hIso_π
    obtain ⟨iso_ν, h_ν⟩ := hHelper ν₀ hη_ν hIso_ν
    let e_K : ↑S'_sch.functionField →+* ↑S_base.functionField := iso_π.hom.hom
    let e_W : ↑W.functionField →+* ↑S_base.functionField := e_K.comp iso_ν.hom.hom
    have hBij_eK : Function.Bijective e_K := by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        have h := congrArg iso_π.inv.hom hxy
        change (iso_π.hom ≫ iso_π.inv).hom x = (iso_π.hom ≫ iso_π.inv).hom y at h
