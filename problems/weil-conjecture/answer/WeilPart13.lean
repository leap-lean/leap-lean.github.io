    have h_pt_eq : (AlgebraicGeometry.Spec.map φ).base (⟨⊥, inferInstance⟩ : PrimeSpectrum ↑B) =
        (⟨⊥, inferInstance⟩ : PrimeSpectrum ↑A) :=
      PrimeSpectrum.ext (le_bot_iff.mp h_le)
    refine ⟨?_, h_pt_eq⟩
    rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
    intro r hr
    have hr_mem : r ∈ (PrimeSpectrum.comap φ.hom (⟨⊥, inferInstance⟩ : PrimeSpectrum ↑B)).asIdeal :=
