    have hv₀_in : v₀_2 ∈ e_U2.base ⁻¹' {p₀_2} := by
      rw [hv₀_pre]
      exact Set.mem_singleton v₀_2
    have he_v₀ : e_U2.base v₀_2 = p₀_2 := Set.mem_singleton_iff.mp hv₀_in
    have h_map_e : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U2) = e_U2 :=
      AlgebraicGeometry.Spec.map_preimage e_U2
    have h_app := AlgebraicGeometry.Spec.map_apply
      (AlgebraicGeometry.Spec.preimage e_U2) (v₀_2 : PrimeSpectrum ↑A'_2)
    rw [h_map_e, he_v₀] at h_app
    exact congrArg PrimeSpectrum.asIdeal h_app.symm
  have hX_fet : (AlgebraicGeometry.Spec.preimage e_U2).hom
      ((AlgebraicGeometry.Spec.preimage (ι_U2 ≫ g₂)).hom PowerSeries.X) =
      ε * u ^ a₂ * v ^ b₂ := by
    have h_pre_comp : AlgebraicGeometry.Spec.preimage (e_U2 ≫ (ι_U2 ≫ g₂)) =
        AlgebraicGeometry.Spec.preimage (ι_U2 ≫ g₂) ≫ AlgebraicGeometry.Spec.preimage e_U2 :=
      AlgebraicGeometry.Spec.preimage_comp e_U2 (ι_U2 ≫ g₂)
    have h_eval := congrArg (fun φ => φ.hom PowerSeries.X) h_pre_comp
    exact h_eval.symm.trans hX_branch
  obtain ⟨hDVR₂, hMax₂⟩ := hs1_dvr (AlgebraicGeometry.Spec.preimage e_U2).hom hFlat_eU2
    (p_gen : PrimeSpectrum ↑R_02) (p₀_2 : PrimeSpectrum ↑R_02) (v₀_2 : PrimeSpectrum ↑A'_2)
    ((AlgebraicGeometry.Spec.preimage (ι_U2 ≫ g₂)).hom PowerSeries.X) u v ε a₂ b₂
    hp_lt hX₂_mem hRed_quot hv_over hv₀_span hu_ne hreg_uv hε_unit ha₂_pos hX_fet
  have h_pt_exc : (ι₁ ≫ h).base (q_exc : PrimeSpectrum ↑R₁) =
      ι_U2.base (p_gen : PrimeSpectrum ↑R_02) := by
    calc (ι₁ ≫ h).base q_exc = h.base (ι₁.base q_exc) := hbase_comp _ _ _
      _ = (CategoryTheory.Limits.pullback.fst g_top s_Ω ≫ h).base η_exc := by
        rw [hq_exc_pt, hbase_comp]
      _ = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base q_gen := by
        rw [← hh₀_fst, hbase_comp]
      _ = ι_U2.base p_gen := hp_gen_pt.symm
  have hNotMemSq := hs3_mult R₁ R_02 (q_exc : PrimeSpectrum ↑R₁) (φ₁.hom z₁)
    hz₁_ne hq_exc_span ι₁ (p_gen : PrimeSpectrum ↑R_02) ι_U2 h_pt_exc hDVR₂ hMax₂
  have hNodeSet_sub := hMultOne_imp hNotMemSq
  have hinj_ιexc : Function.Injective ι_exc.base :=
    (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_exc).injective
  have hNode_sub : (nc2dNodePullbackSet Ω g_top ι_exc).Subsingleton := by
    rintro p₁ ⟨hp₁_cl, hp₁_br⟩ p₂ ⟨hp₂_cl, hp₂_br⟩
    have hp₁_E : ι_exc.base p₁ ∈ E_exc := by rw [← hRange_exc]; exact ⟨p₁, rfl⟩
    have hp₂_E : ι_exc.base p₂ ∈ E_exc := by rw [← hRange_exc]; exact ⟨p₂, rfl⟩
    exact hinj_ιexc (hNodeSet_sub ⟨hp₁_E, hp₁_cl, hp₁_br⟩ ⟨hp₂_E, hp₂_cl, hp₂_br⟩)
  have hMark_sub : (nc2dMarkPullbackSet Ω n g_top τ_top ι_exc).Subsingleton := by
    have : AlgebraicGeometry.IsClosedImmersion s_Ω :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _
        (fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩)
    have hinj_fst_top : Function.Injective (CategoryTheory.Limits.pullback.fst g_top s_Ω).base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
        (CategoryTheory.Limits.pullback.fst g_top s_Ω)).injective
    rintro p₁ ⟨j₁, b₁, hb₁⟩ p₂ ⟨j₂, b₂, hb₂⟩
    let w₀ := (CategoryTheory.Limits.pullback.fst g_prev s_Ω).base q_center
    have hw₀_1 : (τ_prev j₁).base b₁ = w₀ := by
      have hp₁_E : ι_exc.base p₁ ∈ E_exc := by rw [← hRange_exc]; exact ⟨p₁, rfl⟩
      have h_in_pre : (CategoryTheory.Limits.pullback.fst g_top s_Ω).base (ι_exc.base p₁) ∈
          π_last.base ⁻¹' {w₀} := by
        rw [hFib_exc]
        exact ⟨ι_exc.base p₁, hp₁_E, rfl⟩
      calc (τ_prev j₁).base b₁ = (τ_top j₁ ≫ π_last).base b₁ := by rw [hLast.2.2.2.1 j₁]
        _ = π_last.base ((τ_top j₁).base b₁) := hbase_comp _ _ _
        _ = π_last.base ((CategoryTheory.Limits.pullback.fst g_top s_Ω).base (ι_exc.base p₁)) := by
          rw [hb₁]
        _ = w₀ := Set.mem_singleton_iff.mp h_in_pre
    have hw₀_2 : (τ_prev j₂).base b₂ = w₀ := by
      have hp₂_E : ι_exc.base p₂ ∈ E_exc := by rw [← hRange_exc]; exact ⟨p₂, rfl⟩
      have h_in_pre : (CategoryTheory.Limits.pullback.fst g_top s_Ω).base (ι_exc.base p₂) ∈
          π_last.base ⁻¹' {w₀} := by
        rw [hFib_exc]
        exact ⟨ι_exc.base p₂, hp₂_E, rfl⟩
      calc (τ_prev j₂).base b₂ = (τ_top j₂ ≫ π_last).base b₂ := by rw [hLast.2.2.2.1 j₂]
        _ = π_last.base ((τ_top j₂).base b₂) := hbase_comp _ _ _
        _ = π_last.base ((CategoryTheory.Limits.pullback.fst g_top s_Ω).base (ι_exc.base p₂)) := by
          rw [hb₂]
        _ = w₀ := Set.mem_singleton_iff.mp h_in_pre
    have hj_eq : j₁ = j₂ := by
      by_contra hj_ne
      exact Set.disjoint_left.mp (hPrev.2.2.2.2.2.2.2.1 hj_ne) ⟨b₁, hw₀_1⟩ ⟨b₂, hw₀_2⟩
    subst hj_eq
    have hb_eq : b₁ = b₂ := by
      have hsec_j1 : τ_top j₁ ≫ g_top =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))) :=
        hLast.2.1.2.2.2.2.2.2.1 j₁
      have hb₁_s : b₁ = s_Ω.base ((CategoryTheory.Limits.pullback.snd g_top s_Ω).base (ι_exc.base p₁)) := by
        calc b₁ = (τ_top j₁ ≫ g_top).base b₁ := by rw [hsec_j1]; simp
          _ = g_top.base ((τ_top j₁).base b₁) := hbase_comp _ _ _
          _ = (CategoryTheory.Limits.pullback.fst g_top s_Ω ≫ g_top).base (ι_exc.base p₁) := by
            rw [hb₁, hbase_comp]
          _ = s_Ω.base ((CategoryTheory.Limits.pullback.snd g_top s_Ω).base (ι_exc.base p₁)) := by
            rw [CategoryTheory.Limits.pullback.condition, hbase_comp]
      have hb₂_s : b₂ = s_Ω.base ((CategoryTheory.Limits.pullback.snd g_top s_Ω).base (ι_exc.base p₂)) := by
        calc b₂ = (τ_top j₁ ≫ g_top).base b₂ := by rw [hsec_j1]; simp
          _ = g_top.base ((τ_top j₁).base b₂) := hbase_comp _ _ _
          _ = (CategoryTheory.Limits.pullback.fst g_top s_Ω ≫ g_top).base (ι_exc.base p₂) := by
            rw [hb₂, hbase_comp]
          _ = s_Ω.base ((CategoryTheory.Limits.pullback.snd g_top s_Ω).base (ι_exc.base p₂)) := by
            rw [CategoryTheory.Limits.pullback.condition, hbase_comp]
      rw [hb₁_s, hb₂_s]
      exact congrArg s_Ω.base (Subsingleton.elim _ _)
    apply hinj_ιexc
    apply hinj_fst_top
    rw [← hb₁, ← hb₂, hb_eq]
  exact ⟨E_exc, ι_exc, hCl_exc, hRange_exc, hSnd_exc, hFib_exc, hNode_sub, hMark_sub⟩

theorem weil_nc2d_iso_and_offCenter_blowup_specialPoint_transport (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    (∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
       (g₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z₁))
       (g₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z₂))
       (f : Z₁ ⟶ Z₂) [CategoryTheory.IsIso f]
       (f₀ : CategoryTheory.Limits.pullback g₁ s_Ω ⟶ CategoryTheory.Limits.pullback g₂ s_Ω)
       (φ : (weilProjectiveSpaceOver Ω 1).left ⟶ CategoryTheory.Limits.pullback g₁ s_Ω),
      f ≫ g₂ = g₁ →
      (∀ j : Fin n, τ₁ j ≫ f = τ₂ j) →
      f₀ ≫ CategoryTheory.Limits.pullback.fst g₂ s_Ω =
        CategoryTheory.Limits.pullback.fst g₁ s_Ω ≫ f →
      f₀ ≫ CategoryTheory.Limits.pullback.snd g₂ s_Ω =
        CategoryTheory.Limits.pullback.snd g₁ s_Ω →
      CategoryTheory.IsIso f₀ ∧
        nc2dNodePullbackSet Ω g₁ φ = nc2dNodePullbackSet Ω g₂ (φ ≫ f₀) ∧
        nc2dMarkPullbackSet Ω n g₁ τ₁ φ = nc2dMarkPullbackSet Ω n g₂ τ₂ (φ ≫ f₀)) ∧
    (∀ (Y Y' : AlgebraicGeometry.Scheme.{u})
       (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
       (g_Y' : Y' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Y' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y'))
       (y₀ : ↥(CategoryTheory.Limits.pullback g_Y s_Ω))
       (ρ : Y' ⟶ Y)
       (ρ₀ : CategoryTheory.Limits.pullback g_Y' s_Ω ⟶ CategoryTheory.Limits.pullback g_Y s_Ω)
       (ψ' : (weilProjectiveSpaceOver Ω 1).left ⟶ CategoryTheory.Limits.pullback g_Y' s_Ω)
       (p : ↥(weilProjectiveSpaceOver Ω 1).left),
      IsNC2DClosedPointBlowup Ω n g_Y τ_Y g_Y' τ_Y' y₀ ρ →
      ρ₀ ≫ CategoryTheory.Limits.pullback.fst g_Y s_Ω =
        CategoryTheory.Limits.pullback.fst g_Y' s_Ω ≫ ρ →
      ρ₀ ≫ CategoryTheory.Limits.pullback.snd g_Y s_Ω =
        CategoryTheory.Limits.pullback.snd g_Y' s_Ω →
      (ψ' ≫ ρ₀).base p ≠ y₀ →
      (p ∈ nc2dNodePullbackSet Ω g_Y (ψ' ≫ ρ₀) → p ∈ nc2dNodePullbackSet Ω g_Y' ψ') ∧
      (p ∈ nc2dMarkPullbackSet Ω n g_Y τ_Y (ψ' ≫ ρ₀) →
        p ∈ nc2dMarkPullbackSet Ω n g_Y' τ_Y' ψ')) :=
by
  intro s_Ω
  let S := AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))
  let P₁ := (weilProjectiveSpaceOver Ω 1).left
  have hbase_comp : ∀ {A B C : AlgebraicGeometry.Scheme.{u}}
      (u : A ⟶ B) (v : B ⟶ C) (x : ↥A),
      (u ≫ v).base x = v.base (u.base x) := by
    intro A B C u v x
    simp
  have hbase_cancel : ∀ {A B : AlgebraicGeometry.Scheme.{u}}
      (u : A ⟶ B) (v : B ⟶ A) (x : ↥A),
      u ≫ v = 𝟙 A → v.base (u.base x) = x := by
    intro A B u v x huv
    have h1 : (u ≫ v).base x = v.base (u.base x) := hbase_comp u v x
    rw [← h1, huv]
    simp
  have hIsoFwd : ∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
      (g₁ : Z₁ ⟶ S) (τ₁ : Fin n → (S ⟶ Z₁))
      (g₂ : Z₂ ⟶ S) (τ₂ : Fin n → (S ⟶ Z₂))
      (f : Z₁ ⟶ Z₂) [CategoryTheory.IsIso f]
      (f₀ : CategoryTheory.Limits.pullback g₁ s_Ω ⟶ CategoryTheory.Limits.pullback g₂ s_Ω)
      (f₀_inv : CategoryTheory.Limits.pullback g₂ s_Ω ⟶ CategoryTheory.Limits.pullback g₁ s_Ω)
      (φ : P₁ ⟶ CategoryTheory.Limits.pullback g₁ s_Ω),
      f ≫ g₂ = g₁ →
      (∀ j : Fin n, τ₁ j ≫ f = τ₂ j) →
      f₀ ≫ CategoryTheory.Limits.pullback.fst g₂ s_Ω =
        CategoryTheory.Limits.pullback.fst g₁ s_Ω ≫ f →
      f₀ ≫ f₀_inv = 𝟙 (CategoryTheory.Limits.pullback g₁ s_Ω) →
      f₀_inv ≫ f₀ = 𝟙 (CategoryTheory.Limits.pullback g₂ s_Ω) →
      nc2dNodePullbackSet Ω g₁ φ ⊆ nc2dNodePullbackSet Ω g₂ (φ ≫ f₀) ∧
        nc2dMarkPullbackSet Ω n g₁ τ₁ φ ⊆ nc2dMarkPullbackSet Ω n g₂ τ₂ (φ ≫ f₀) := by
    intro Z₁ Z₂ g₁ τ₁ g₂ τ₂ f _ f₀ f₀_inv φ hf_g hf_τ hf₀_fst hf₀_hom_inv hf₀_inv_hom
    refine ⟨?_, ?_⟩
    · rintro p ⟨hq_cl, a, b, hb, R₀, p₀, ι_U, z₁, z₂, A', v₀, e_U, u, v, ε,
        hOpen_ι, hp₀_eq, hDomR, hp₀_id, hz₁_ne, hRegR, hResR,
        hEt_e, hDomA, hv₀_fib, hv₀_id, hu_ne, hRegA, hResA, hUnit_ε, ha, hX_eq⟩
      have h_pre : f₀_inv.base ⁻¹' ({φ.base p} : Set ↥(CategoryTheory.Limits.pullback g₁ s_Ω)) =
          {(φ ≫ f₀).base p} := by
        ext y
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hy
          calc y = f₀.base (f₀_inv.base y) := (hbase_cancel f₀_inv f₀ y hf₀_inv_hom).symm
            _ = f₀.base (φ.base p) := by rw [hy]
            _ = (φ ≫ f₀).base p := (hbase_comp φ f₀ p).symm
        · intro hy
          rw [hy, hbase_comp φ f₀ p]
          exact hbase_cancel f₀ f₀_inv (φ.base p) hf₀_hom_inv
      have hq'_cl : IsClosed ({(φ ≫ f₀).base p} : Set ↥(CategoryTheory.Limits.pullback g₂ s_Ω)) := by
        rw [← h_pre]
        exact hq_cl.preimage f₀_inv.base.hom.continuous
      refine ⟨hq'_cl, a, b, hb, R₀, p₀, ι_U ≫ f, z₁, z₂, A', v₀, e_U, u, v, ε, ?_⟩
      have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_ι
      have hOpen_ι' : AlgebraicGeometry.IsOpenImmersion (ι_U ≫ f) := inferInstance
      have h_ιg : (ι_U ≫ f) ≫ g₂ = ι_U ≫ g₁ := by
        rw [CategoryTheory.Category.assoc, hf_g]
      have h_eιg : e_U ≫ (ι_U ≫ f) ≫ g₂ = e_U ≫ ι_U ≫ g₁ := by
        rw [h_ιg]
      have hp₀_eq' : (ι_U ≫ f).base p₀ =
          (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base ((φ ≫ f₀).base p) := by
        calc (ι_U ≫ f).base p₀
            = f.base (ι_U.base p₀) := hbase_comp ι_U f p₀
          _ = f.base ((CategoryTheory.Limits.pullback.fst g₁ s_Ω).base (φ.base p)) := by
                rw [hp₀_eq]
          _ = (CategoryTheory.Limits.pullback.fst g₁ s_Ω ≫ f).base (φ.base p) :=
                (hbase_comp _ _ _).symm
          _ = (f₀ ≫ CategoryTheory.Limits.pullback.fst g₂ s_Ω).base (φ.base p) := by
                rw [← hf₀_fst]
          _ = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base (f₀.base (φ.base p)) :=
                hbase_comp _ _ _
          _ = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base ((φ ≫ f₀).base p) := by
                rw [hbase_comp φ f₀ p]
      refine ⟨hOpen_ι', hp₀_eq', hDomR, hp₀_id, hz₁_ne, hRegR, ?_,
        hEt_e, hDomA, hv₀_fib, hv₀_id, hu_ne, hRegA, ?_, hUnit_ε, ha, ?_⟩
      · rw [h_ιg]; exact hResR
      · rw [h_eιg]; exact hResA
      · rw [h_eιg]; exact hX_eq
    · rintro p ⟨j, b_S, hb_S⟩
      refine ⟨j, b_S, ?_⟩
      calc (τ₂ j).base b_S
          = (τ₁ j ≫ f).base b_S := by rw [← hf_τ j]
        _ = f.base ((τ₁ j).base b_S) := hbase_comp (τ₁ j) f b_S
        _ = f.base ((CategoryTheory.Limits.pullback.fst g₁ s_Ω).base (φ.base p)) := by
              rw [hb_S]
        _ = (CategoryTheory.Limits.pullback.fst g₁ s_Ω ≫ f).base (φ.base p) :=
              (hbase_comp _ _ _).symm
        _ = (f₀ ≫ CategoryTheory.Limits.pullback.fst g₂ s_Ω).base (φ.base p) := by
              rw [← hf₀_fst]
        _ = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base (f₀.base (φ.base p)) :=
              hbase_comp _ _ _
        _ = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base ((φ ≫ f₀).base p) := by
              rw [hbase_comp φ f₀ p]
  have hLocAwayNC : ∀ (R₀ : CommRingCat.{u}) [IsDomain R₀]
      (p : AlgebraicGeometry.Spec R₀)
      (f x₁ x₂ : R₀) (φ_R : PowerSeries Ω →+* R₀),
      f ∉ p.asIdeal →
      p.asIdeal = Ideal.span ({x₁, x₂} : Set R₀) →
      x₁ ≠ 0 →
      (∀ y : R₀, x₂ * y ∈ Ideal.span ({x₁} : Set R₀) → y ∈ Ideal.span ({x₁} : Set R₀)) →
      (∀ r : R₀, ∃ c : Ω, r - φ_R (PowerSeries.C c) ∈ p.asIdeal) →
      let α := algebraMap R₀ (Localization.Away f)
      IsDomain (CommRingCat.of (Localization.Away f)) ∧
      ∃ p_f : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)),
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base p_f = p ∧
        p_f.asIdeal = Ideal.span ({α x₁, α x₂} : Set (Localization.Away f)) ∧
        α x₁ ≠ 0 ∧
        (∀ y : Localization.Away f,
          α x₂ * y ∈ Ideal.span ({α x₁} : Set (Localization.Away f)) →
          y ∈ Ideal.span ({α x₁} : Set (Localization.Away f))) ∧
        (∀ r_loc : Localization.Away f,
          ∃ c : Ω, r_loc - α (φ_R (PowerSeries.C c)) ∈ p_f.asIdeal) := by
    intro R₀ _ p f x₁ x₂ φ_R hf hp_span hx₁_ne h_reg h_res α
    have hf_ne : f ≠ 0 := fun h0 => hf (h0 ▸ p.asIdeal.zero_mem)
    have hf_nzd : Submonoid.powers f ≤ nonZeroDivisors R₀ := by
      rintro _ ⟨k, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hf_ne)
    have hDom : IsDomain (Localization.Away f) := IsLocalization.isDomain_localization hf_nzd
    have hinj : Function.Injective α := IsLocalization.injective (Localization.Away f) hf_nzd
    have h_disj : Disjoint (Submonoid.powers f : Set R₀) (p.asIdeal : Set R₀) := by
      rw [Set.disjoint_left]
      rintro _ ⟨k, rfl⟩ hmem
      exact hf (p.isPrime.mem_of_pow_mem k hmem)
    let p_f : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) :=
      ⟨Ideal.map α p.asIdeal,
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
          p.asIdeal p.isPrime h_disj⟩
    refine ⟨hDom, p_f, ?_, ?_, ?_, ?_, ?_⟩
    · apply PrimeSpectrum.ext
      exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
        p.isPrime h_disj
    · change Ideal.map α p.asIdeal = _
      rw [hp_span, Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
    · intro h0
      exact hx₁_ne (hinj (h0.trans (map_zero α).symm))
    · intro y hy
      rw [Ideal.mem_span_singleton] at hy ⊢
      obtain ⟨w, hw⟩ := hy
      obtain ⟨⟨r, ⟨_, m, rfl⟩⟩, hy_eq⟩ := IsLocalization.surj (Submonoid.powers f) y
      obtain ⟨⟨s, ⟨_, k, rfl⟩⟩, hw_eq⟩ := IsLocalization.surj (Submonoid.powers f) w
      change y * α (f ^ m) = α r at hy_eq
      change w * α (f ^ k) = α s at hw_eq
      have h_rel : x₂ * (r * f ^ k) = x₁ * (s * f ^ m) := by
        apply hinj
        calc α (x₂ * (r * f ^ k))
            = α x₂ * α r * α (f ^ k) := by simp only [map_mul]; ring
