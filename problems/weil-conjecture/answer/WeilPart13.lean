          (f₁ s'' * (f₁ (t_d * t₀) * b'₁)) * v₁ =
        f₁ s'' * ((f₁ (t₀ * t₁) * w₀) * y₀ - (f₁ (t_d * t₁) * b'₀) * u₁ -
