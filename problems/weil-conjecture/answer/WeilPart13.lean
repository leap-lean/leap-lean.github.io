theorem weil_dvr_stable_pointed_curve_iso_extension (k : Type u) [Field k]
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂))
    (hStab₁ : IsGeometricStablePointedCurve g₁ n τ₁)
    (hStab₂ : IsGeometricStablePointedCurve g₂ n τ₂)
    (hSm₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g₁
