    have hAffDT : AlgebraicGeometry.IsAffineOpen D_T := hAffD.preimage ι_T.left
    have hCompT : (hAffDT.fromSpec ≫ π.left) ≫ X.hom = hAffDT.fromSpec ≫ T.hom := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w π]
    haveI : AlgebraicGeometry.IsAffineHom (hAffDT.fromSpec ≫ T.hom) :=
      AlgebraicGeometry.isAffineHom_of_isAffine _
    haveI : AlgebraicGeometry.IsAffineHom (hAffDT.fromSpec ≫ π.left) :=
      @AlgebraicGeometry.IsAffineHom.of_comp _ _ _ (hAffDT.fromSpec ≫ π.left) X.hom
        (by rw [hCompT]; infer_instance) inferInstance
    let W_spec : (AlgebraicGeometry.Spec (T.left.presheaf.obj (Opposite.op D_T))).Opens :=
      (TopologicalSpace.Opens.map (hAffDT.fromSpec ≫ π.left).base).obj U₀
    have hAffWspec : AlgebraicGeometry.IsAffineOpen W_spec :=
      hAffU₀.preimage (hAffDT.fromSpec ≫ π.left)
    have hAffImg : AlgebraicGeometry.IsAffineOpen (hAffDT.fromSpec.opensFunctor.obj W_spec) :=
      hAffWspec.image_of_isOpenImmersion hAffDT.fromSpec
    have hImgEq : hAffDT.fromSpec.opensFunctor.obj W_spec = D_T ⊓ W := by
      ext t
      constructor
      · rintro ⟨q, hq, rfl⟩
        refine ⟨?_, hq⟩
        have hRange := hAffDT.opensRange_fromSpec
        have : hAffDT.fromSpec.base q ∈ hAffDT.fromSpec.opensRange := ⟨q, rfl⟩
        rwa [hRange] at this
      · rintro ⟨htDT, htW⟩
        have hRange := hAffDT.opensRange_fromSpec
        have htRange : t ∈ hAffDT.fromSpec.opensRange := by rwa [hRange]
        obtain ⟨q, rfl⟩ := htRange
        exact ⟨q, htW, rfl⟩
    rw [hImgEq] at hAffImg
    have hRangeW : D_T ⊓ W ≤ W.ι.opensRange := by
      intro t ht
      rw [Scheme.Opens.opensRange_ι]
      exact ht.2
    have hPreW := hAffImg.preimage_of_isOpenImmersion W.ι hRangeW
    have hPreEq : (TopologicalSpace.Opens.map W.ι.base).obj (D_T ⊓ W) =
        (TopologicalSpace.Opens.map gProj.base).obj D := by
      ext y
      exact ⟨fun h => h.1, fun h => ⟨h, y.2⟩⟩
    rwa [hPreEq] at hPreW
  have hAffD₀ : AlgebraicGeometry.IsAffineOpen D₀ :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_k L₀ hL₀ zero_lt_one
  have hAffD₁ : AlgebraicGeometry.IsAffineOpen D₁ :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_k L₁ hL₁ zero_lt_one
  have hAffD₀₁ : AlgebraicGeometry.IsAffineOpen (D₀ ⊓ D₁) := by
    change AlgebraicGeometry.IsAffineOpen
      (AlgebraicGeometry.Proj.basicOpen 𝒜_k L₀ ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_k L₁)
    rw [← AlgebraicGeometry.Proj.basicOpen_mul 𝒜_k L₀ L₁]
    have hL₀₁ : L₀ * L₁ ∈ 𝒜_k (1 + 1) := SetLike.mul_mem_graded hL₀ hL₁
    exact AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_k (L₀ * L₁) hL₀₁ (by omega)
  let V₀ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj D₀
  let V₁ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj D₁
  have hAff₀ : AlgebraicGeometry.IsAffineOpen V₀ := hAffPre D₀ hAffD₀
  have hAff₁ : AlgebraicGeometry.IsAffineOpen V₁ := hAffPre D₁ hAffD₁
  have hAff₀₁ : AlgebraicGeometry.IsAffineOpen (V₀ ⊓ V₁) := by
