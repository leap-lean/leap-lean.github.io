        PowerSeries.isUnit_iff_constantCoeff.mpr (IsUnit.mk0 _ hc_ne)
      obtain ⟨v_b, hvb⟩ := hu_unit.exists_right_inv
      have hbv : b * v_b = (PowerSeries.X : PowerSeries Ω) ^ m := by
        calc b * v_b = ((PowerSeries.X : PowerSeries Ω) ^ m * u_b) * v_b := by rw [hub_eq]
          _ = (PowerSeries.X : PowerSeries Ω) ^ m * (u_b * v_b) := by ring
          _ = (PowerSeries.X : PowerSeries Ω) ^ m := by rw [hvb, mul_one]
