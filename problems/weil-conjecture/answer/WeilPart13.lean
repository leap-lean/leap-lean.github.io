    (let s_Ω := AlgebraicGeometry.Spec.map
       (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
     ∃ (F₀ : Set ↥(CategoryTheory.Limits.pullback g₂ s_Ω))
       (F_sch : AlgebraicGeometry.Scheme.{u})
       (ιF : F_sch ⟶ CategoryTheory.Limits.pullback g₂ s_Ω)
       (isoP1 : F_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
       F₀ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_Ω) ∧
       AlgebraicGeometry.IsClosedImmersion ιF ∧
       AlgebraicGeometry.IsIntegral F_sch ∧
       Set.range ιF.base = F₀ ∧
       ιF ≫ CategoryTheory.Limits.pullback.snd g₂ s_Ω =
         isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom ∧
       {q : ↥(CategoryTheory.Limits.pullback g₂ s_Ω) |
         q ∈ F₀ ∧
         ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_Ω),
           E' ≠ F₀ ∧ q ∈ E'}.Subsingleton ∧
       ∃ p₁ p₂ : ↥(CategoryTheory.Limits.pullback g₂ s_Ω),
         ∀ q ∈ F₀,
           ((∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_Ω),
               E' ≠ F₀ ∧ q ∈ E') ∨
            (∃ j : Fin n,
               (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base q ∈ Set.range (τ₂ j).base)) →
           q = p₁ ∨ q = p₂) :=
by
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  obtain ⟨hIntP1, hToNC, hNorm⟩ := weil_regularSimpleNodal_to_nc2d_and_normal Ω n
  obtain ⟨hNC₁, _⟩ := hToNC C₁ g₁ τ₁ hSurf₁
  obtain ⟨hNC₂, hRed₂⟩ := hToNC C₂ g₂ τ₂ hSurf₂
  have hTowerSurf : ∀ {m : ℕ}
      {W_seq : Fin (m + 1) → AlgebraicGeometry.Scheme.{u}}
      {g_seq : ∀ i : Fin (m + 1), W_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))}
      {τ_seq : ∀ i : Fin (m + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_seq i)}
      {centers : ∀ i : Fin m, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω)}
      {maps : ∀ i : Fin m, W_seq i.succ ⟶ W_seq i.castSucc}
      {π_from : ∀ i : Fin (m + 1), W_seq i ⟶ C₁},
      IsNC2DBlowupTower Ω n g₁ τ₁ m W_seq g_seq τ_seq centers maps π_from →
      ∀ i : Fin (m + 1), IsNC2DPointedSurface Ω n (g_seq i) (τ_seq i) := by
    intro m W_seq g_seq τ_seq centers maps π_from hT i
    exact Fin.cases hT.1 (fun j => (hT.2.2.2.2.2 j).2.1) i
  let P : ℕ → Prop := fun k =>
    ∃ (W_seq : Fin (k + 1) → AlgebraicGeometry.Scheme.{u})
      (g_seq : ∀ i : Fin (k + 1), W_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_seq : ∀ i : Fin (k + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_seq i))
      (centers : ∀ i : Fin k, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
      (maps : ∀ i : Fin k, W_seq i.succ ⟶ W_seq i.castSucc)
      (π_from : ∀ i : Fin (k + 1), W_seq i ⟶ C₁)
      (α_top : CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K ≅
        CategoryTheory.Limits.pullback g₂ η_K)
      (h : W_seq (Fin.last k) ⟶ C₂),
      IsNC2DBlowupTower Ω n g₁ τ₁ k W_seq g_seq τ_seq centers maps π_from ∧
      α_top.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
        CategoryTheory.Limits.pullback.snd (g_seq (Fin.last k)) η_K ∧
      CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K ≫ π_from (Fin.last k) =
        (α_top.hom ≫ ψ_K.inv) ≫ CategoryTheory.Limits.pullback.fst g₁ η_K ∧
      h ≫ g₂ = g_seq (Fin.last k) ∧
      (∀ j : Fin n, τ_seq (Fin.last k) j ≫ h = τ₂ j) ∧
      CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K ≫ h =
        α_top.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K
  have hex : ∃ N, P N := by
    obtain ⟨N, W_seq, g_seq, τ_seq, centers, maps, π_from, α_N,
        hTowerN, hαN_snd, hαN_fst, hαN_sec, hCentersN⟩ :=
      weil_nc2d_blowup_tower_eliminating_closed_centers Ω n C₁ C₂ g₁ τ₁ g₂ τ₂ ψ_K
        hNC₁ hNC₂ hψK_snd hψK_sec (weil_nc2d_single_closed_point_blowup Ω n)
    have hNC_N : IsNC2DPointedSurface Ω n (g_seq (Fin.last N)) (τ_seq (Fin.last N)) :=
      hTowerSurf hTowerN (Fin.last N)
    obtain ⟨h_N, hhN_g, hhN_sec, hhN_gen⟩ :=
      weil_nc2d_morphism_of_nonclosed_component_centers Ω n
        (W_seq (Fin.last N)) C₂ (g_seq (Fin.last N)) (τ_seq (Fin.last N)) g₂ τ₂ α_N
