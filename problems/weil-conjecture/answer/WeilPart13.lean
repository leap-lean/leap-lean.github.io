import WeilPart12
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_nc2d_blowup_nonclosed_centers_and_lift (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ)
    (W Y Y₁ : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (g_Y₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y₁))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (h : W ⟶ Y)
    (q₀ : ↥(CategoryTheory.Limits.pullback g_Y
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (ρ₁ : Y₁ ⟶ Y)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hBlow₁ : IsNC2DClosedPointBlowup Ω n g_Y τ_Y g_Y₁ τ_Y₁ q₀ ρ₁)
    (hαK_snd : α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hh_comm : h ≫ g_Y = g_W)
    (hh_sec : ∀ j : Fin n, τ_W j ≫ h = τ_Y j)
    (hh_gen : CategoryTheory.Limits.pullback.fst g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≫ h =
      α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hNormW : ∀ U : W.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      IsIntegrallyClosed ↑(W.presheaf.obj (Opposite.op U)))
    (hNoClosedGen : ∀ (F : Set ↥(CategoryTheory.Limits.pullback g_Y₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
      (q_F : ↥(CategoryTheory.Limits.pullback g_Y₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))),
      F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))) →
      IsGenericPoint q_F F →
      ¬ IsClosed ({q_F} : Set ↥(CategoryTheory.Limits.pullback g_Y₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))))
    (hq₀_notSurj : ∀ (R₀ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀) [p₀.asIdeal.IsPrime]
      (ι₀ : AlgebraicGeometry.Spec R₀ ⟶ Y)
      (R_W : CommRingCat.{u}) (p_W : AlgebraicGeometry.Spec R_W) [p_W.asIdeal.IsPrime]
      (ι_W : AlgebraicGeometry.Spec R_W ⟶ W),
      AlgebraicGeometry.IsOpenImmersion ι₀ →
      IsDomain R₀ →
      ι₀.base p₀ = (CategoryTheory.Limits.pullback.fst g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))).base q₀ →
      AlgebraicGeometry.IsOpenImmersion ι_W →
      IsDomain R_W →
      h.base (ι_W.base p_W) = (CategoryTheory.Limits.pullback.fst g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))).base q₀ →
      ∃ θ : Localization.AtPrime p₀.asIdeal →+* Localization.AtPrime p_W.asIdeal,
        IsLocalHom θ ∧
        Function.Injective θ ∧
        θ.comp ((algebraMap R₀ (Localization.AtPrime p₀.asIdeal)).comp
          ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_Y)).hom.comp PowerSeries.C)) =
          (algebraMap R_W (Localization.AtPrime p_W.asIdeal)).comp
            ((AlgebraicGeometry.Spec.preimage (ι_W ≫ g_W)).hom.comp PowerSeries.C) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal))) ≫ ι₀ =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R_W (Localization.AtPrime p_W.asIdeal))) ≫
            ι_W ≫ h ∧
        (∀ b : Localization.AtPrime p_W.asIdeal,
          ∃ f g : Localization.AtPrime p₀.asIdeal, g ≠ 0 ∧ θ g * b = θ f) ∧
        ¬ Function.Surjective θ)
    (hLocalSurj : ∀ (A B V_exc : Type u)
      [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsLocalRing A]
      [CommRing B] [IsDomain B] [IsNoetherianRing B] [IsLocalRing B]
      [CommRing V_exc] [IsDomain V_exc] [IsLocalRing V_exc]
      (c_A : Ω →+* A) (c_B : Ω →+* B)
      (θ : A →+* B) (ψ : B →+* V_exc),
      IsLocalHom θ → IsLocalHom ψ → Function.Injective θ → θ.comp c_A = c_B →
      ∀ (z₁ z₂ : A), IsLocalRing.maximalIdeal A = Ideal.span ({z₁, z₂} : Set A) →
      ∀ (w₁ w₂ : B), IsLocalRing.maximalIdeal B = Ideal.span ({w₁, w₂} : Set B) →
      w₁ ≠ 0 →
      (∀ y : B, w₂ * y ∈ Ideal.span ({w₁} : Set B) → y ∈ Ideal.span ({w₁} : Set B)) →
      (∀ b : B, ∃ c : Ω, b - c_B c ∈ IsLocalRing.maximalIdeal B) →
      (∀ b : B, ∃ f g : A, g ≠ 0 ∧ θ g * b = θ f) →
      ∀ (ϖ s₁ : V_exc), ϖ ≠ 0 →
      IsLocalRing.maximalIdeal V_exc = Ideal.span ({ϖ} : Set V_exc) →
      ψ (θ z₁) = ϖ →
      ψ (θ z₂) = ϖ * s₁ →
      (∀ c : Ω, s₁ - ψ (c_B c) ∉ IsLocalRing.maximalIdeal V_exc) →
      Function.Surjective θ)
    (hDom₁ : ∀ (β_K : CategoryTheory.Limits.pullback g_W
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
        CategoryTheory.Limits.pullback g_Y₁
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
      β_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y₁
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
        CategoryTheory.Limits.pullback.snd g_W
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) →
      (∀ j : Fin n,
        ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
            CategoryTheory.Limits.pullback g_W
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
          s₁ ≫ CategoryTheory.Limits.pullback.fst g_W
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
              τ_W j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g_W
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
          (s₁ ≫ β_K.hom) ≫ CategoryTheory.Limits.pullback.fst g_Y₁
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
              τ_Y₁ j) →
      HasNonclosedComponentCenters Ω g_W g_Y₁ β_K →
      ∃ h₁ : W ⟶ Y₁,
        h₁ ≫ g_Y₁ = g_W ∧
        (∀ j : Fin n, τ_W j ≫ h₁ = τ_Y₁ j) ∧
        CategoryTheory.Limits.pullback.fst g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≫ h₁ =
          β_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))) :
    let η_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
    ∃ (α₁ : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g_Y₁ η_K)
      (h₁ : W ⟶ Y₁),
      α₁.hom ≫ CategoryTheory.Limits.pullback.snd g_Y₁ η_K =
        CategoryTheory.Limits.pullback.snd g_W η_K ∧
      h₁ ≫ g_Y₁ = g_W ∧
      h₁ ≫ ρ₁ = h ∧
      (∀ j : Fin n, τ_W j ≫ h₁ = τ_Y₁ j) ∧
      CategoryTheory.Limits.pullback.fst g_W η_K ≫ h₁ =
        α₁.hom ≫ CategoryTheory.Limits.pullback.fst g_Y₁ η_K :=
by
  intro η_K
  let _ := hNormW
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  obtain ⟨hIntW, _, hPropW, hLFP_W, hSurjW, _, _, _, hNC_W⟩ := hW
  obtain ⟨_, _, hPropY, hLFP_Y, _, _, _, _, _⟩ := hY
  obtain ⟨hq₀_cl, hY₁, hρ₁_g, hρ₁_sec, _, _, hρ₁_genIso, hρ₁_off, _, hBlow_pkg⟩ := hBlow₁
  obtain ⟨hIntY₁, _, _, hLFP_Y₁, hSurjY₁, _, hτY₁_sec, _, _⟩ := hY₁
  
  have hPillar1 :
      AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g_W η_K) ∧
      AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g_Y₁ η_K) ∧
      ∃ α₁ : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g_Y₁ η_K,
        α₁.hom ≫ CategoryTheory.Limits.pullback.snd g_Y₁ η_K =
          CategoryTheory.Limits.pullback.snd g_W η_K ∧
        α₁.hom ≫ CategoryTheory.Limits.pullback.fst g_Y₁ η_K ≫ ρ₁ =
          CategoryTheory.Limits.pullback.fst g_W η_K ≫ h ∧
        (∀ j : Fin n,
          ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
              CategoryTheory.Limits.pullback g_W η_K),
            s₁ ≫ CategoryTheory.Limits.pullback.fst g_W η_K = η_K ≫ τ_W j →
            s₁ ≫ CategoryTheory.Limits.pullback.snd g_W η_K =
              𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
            (s₁ ≫ α₁.hom) ≫ CategoryTheory.Limits.pullback.fst g_Y₁ η_K = η_K ≫ τ_Y₁ j) ∧
        (∀ h₁ : W ⟶ Y₁,
          h₁ ≫ g_Y₁ = g_W →
          CategoryTheory.Limits.pullback.fst g_W η_K ≫ h₁ =
            α₁.hom ≫ CategoryTheory.Limits.pullback.fst g_Y₁ η_K →
          h₁ ≫ ρ₁ = h) := by
    let RStar := PowerSeries Ω
    let KStar := FractionRing RStar
    have hMaxR : IsLocalRing.maximalIdeal RStar = Ideal.span ({PowerSeries.X} : Set RStar) :=
      (PowerSeries.X_irreducible (R := Ω)).maximalIdeal_eq
    have hinj_RK : Function.Injective (algebraMap RStar KStar) :=
      IsFractionRing.injective RStar KStar
    have hRange_ηK :
        Set.range η_K.base = (PrimeSpectrum.basicOpen (PowerSeries.X : RStar)).1 := by
      ext p
      constructor
      · rintro ⟨z, rfl⟩
        change PowerSeries.X ∉ (η_K.base z).asIdeal
        change algebraMap RStar KStar PowerSeries.X ∉ z.asIdeal
        intro hmem
        have hX_ne : algebraMap RStar KStar PowerSeries.X ≠ 0 :=
          fun h0 => PowerSeries.X_ne_zero (hinj_RK (h0.trans (map_zero _).symm))
        exact z.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem z.asIdeal hmem (IsUnit.mk0 _ hX_ne))
      · intro hp
        change PowerSeries.X ∉ p.asIdeal at hp
        have hp_bot : p.asIdeal = ⊥ := by
          by_contra hne_bot
          have hmax : p.asIdeal.IsMaximal := p.isPrime.isMaximal hne_bot
          have heq : p.asIdeal = IsLocalRing.maximalIdeal RStar :=
            IsLocalRing.eq_maximalIdeal hmax
          rw [heq, hMaxR, Ideal.mem_span_singleton] at hp
          exact hp ⟨1, (mul_one _).symm⟩
        let z₀ : AlgebraicGeometry.Spec (CommRingCat.of KStar) := ⟨⊥, inferInstance⟩
        refine ⟨z₀, PrimeSpectrum.ext ?_⟩
        change Ideal.comap (algebraMap RStar KStar) ⊥ = p.asIdeal
        rw [hp_bot]
        ext r
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        exact ⟨fun hr => hinj_RK (hr.trans (map_zero _).symm), fun hr => by rw [hr, map_zero]⟩
    have hDom_gen : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of RStar)),
        AlgebraicGeometry.IsIntegral Z →
        AlgebraicGeometry.Surjective g_Z →
        AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g_Z η_K) := by
      intro Z g_Z hIntZ hSurjZ
      have : AlgebraicGeometry.IsIntegral Z := hIntZ
      have : AlgebraicGeometry.Surjective g_Z := hSurjZ
      rw [AlgebraicGeometry.isDominant_iff]
      change Dense (Set.range (CategoryTheory.Limits.pullback.fst g_Z η_K).base)
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
      have hOpen : IsOpen (g_Z.base ⁻¹' Set.range η_K.base) := by
        rw [hRange_ηK]
        exact (PrimeSpectrum.basicOpen (PowerSeries.X : RStar)).isOpen.preimage g_Z.continuous
      have hNE : (g_Z.base ⁻¹' Set.range η_K.base).Nonempty := by
        let z₀ : AlgebraicGeometry.Spec (CommRingCat.of KStar) := ⟨⊥, inferInstance⟩
        obtain ⟨w₀, hw₀⟩ := g_Z.surjective (η_K.base z₀)
        exact ⟨w₀, by simp only [Set.mem_preimage, hw₀]; exact ⟨z₀, rfl⟩⟩
      exact hOpen.dense hNE
    have hDomW : AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g_W η_K) :=
      hDom_gen W g_W hIntW hSurjW
    have hDomY₁ : AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g_Y₁ η_K) :=
      hDom_gen Y₁ g_Y₁ hIntY₁ hSurjY₁
    have hvK_comm :
        (CategoryTheory.Limits.pullback.fst g_Y₁ η_K ≫ ρ₁) ≫ g_Y =
          CategoryTheory.Limits.pullback.snd g_Y₁ η_K ≫ η_K := by
      rw [CategoryTheory.Category.assoc, hρ₁_g, CategoryTheory.Limits.pullback.condition]
    let v_K : CategoryTheory.Limits.pullback g_Y₁ η_K ⟶ CategoryTheory.Limits.pullback g_Y η_K :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_Y₁ η_K ≫ ρ₁)
        (CategoryTheory.Limits.pullback.snd g_Y₁ η_K) hvK_comm
    have hvK_fst :
        v_K ≫ CategoryTheory.Limits.pullback.fst g_Y η_K =
          CategoryTheory.Limits.pullback.fst g_Y₁ η_K ≫ ρ₁ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hvK_snd :
        v_K ≫ CategoryTheory.Limits.pullback.snd g_Y η_K =
          CategoryTheory.Limits.pullback.snd g_Y₁ η_K :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have : CategoryTheory.IsIso v_K := hρ₁_genIso v_K hvK_fst hvK_snd
    let α₁ : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g_Y₁ η_K :=
      α_K ≪≫ (CategoryTheory.asIso v_K).symm
    have hα₁_vK : α₁.hom ≫ v_K = α_K.hom := by
      change (α_K.hom ≫ (CategoryTheory.asIso v_K).inv) ≫ (CategoryTheory.asIso v_K).hom = α_K.hom
      rw [CategoryTheory.Category.assoc, (CategoryTheory.asIso v_K).inv_hom_id,
        CategoryTheory.Category.comp_id]
    have hα₁_snd :
        α₁.hom ≫ CategoryTheory.Limits.pullback.snd g_Y₁ η_K =
          CategoryTheory.Limits.pullback.snd g_W η_K := by
      rw [← hvK_snd, ← CategoryTheory.Category.assoc, hα₁_vK, hαK_snd]
    have hα₁_fst :
        α₁.hom ≫ CategoryTheory.Limits.pullback.fst g_Y₁ η_K ≫ ρ₁ =
          CategoryTheory.Limits.pullback.fst g_W η_K ≫ h := by
      rw [← hvK_fst, ← CategoryTheory.Category.assoc, hα₁_vK, hh_gen]
    refine ⟨hDomW, hDomY₁, α₁, hα₁_snd, hα₁_fst, ?_, ?_⟩
    · intro j s₁ hs₁_fst hs₁_snd
      have ht₁_comm :
          (η_K ≫ τ_Y₁ j) ≫ g_Y₁ =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of KStar)) ≫ η_K := by
        rw [CategoryTheory.Category.assoc, hτY₁_sec j,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      let t₁ : AlgebraicGeometry.Spec (CommRingCat.of KStar) ⟶
          CategoryTheory.Limits.pullback g_Y₁ η_K :=
        CategoryTheory.Limits.pullback.lift (η_K ≫ τ_Y₁ j) (𝟙 _) ht₁_comm
      have hs₁_eq_t₁ : s₁ ≫ α₁.hom = t₁ := by
        apply (CategoryTheory.cancel_mono v_K).mp
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc ((s₁ ≫ α₁.hom) ≫ v_K) ≫ CategoryTheory.Limits.pullback.fst g_Y η_K
              = s₁ ≫ (α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K) := by
                rw [CategoryTheory.Category.assoc s₁ α₁.hom v_K, hα₁_vK,
                  CategoryTheory.Category.assoc]
            _ = (s₁ ≫ CategoryTheory.Limits.pullback.fst g_W η_K) ≫ h := by
                rw [← hh_gen, CategoryTheory.Category.assoc]
            _ = η_K ≫ τ_Y j := by
                rw [hs₁_fst, CategoryTheory.Category.assoc, hh_sec j]
            _ = (η_K ≫ τ_Y₁ j) ≫ ρ₁ := by
                rw [← hρ₁_sec j, CategoryTheory.Category.assoc]
            _ = (t₁ ≫ CategoryTheory.Limits.pullback.fst g_Y₁ η_K) ≫ ρ₁ := by
                rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = (t₁ ≫ v_K) ≫ CategoryTheory.Limits.pullback.fst g_Y η_K := by
                rw [CategoryTheory.Category.assoc t₁ v_K, hvK_fst, CategoryTheory.Category.assoc]
        · calc ((s₁ ≫ α₁.hom) ≫ v_K) ≫ CategoryTheory.Limits.pullback.snd g_Y η_K
              = s₁ ≫ (α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y η_K) := by
                rw [CategoryTheory.Category.assoc s₁ α₁.hom v_K, hα₁_vK,
                  CategoryTheory.Category.assoc]
            _ = 𝟙 _ := by rw [hαK_snd, hs₁_snd]
            _ = t₁ ≫ CategoryTheory.Limits.pullback.snd g_Y₁ η_K := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = (t₁ ≫ v_K) ≫ CategoryTheory.Limits.pullback.snd g_Y η_K := by
                rw [CategoryTheory.Category.assoc t₁ v_K, hvK_snd]
      rw [hs₁_eq_t₁, CategoryTheory.Limits.pullback.lift_fst]
    · intro h₁ hh₁_g hh₁_gen
      have : AlgebraicGeometry.IsIntegral W := hIntW
      have : AlgebraicGeometry.IsProper g_Y := hPropY
      have : AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g_W η_K) := hDomW
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_Y ?_
        (CategoryTheory.Limits.pullback.fst g_W η_K) ?_
      · rw [CategoryTheory.Category.assoc, hρ₁_g, hh₁_g, hh_comm]
      · rw [← CategoryTheory.Category.assoc, hh₁_gen, CategoryTheory.Category.assoc, hα₁_fst]
  obtain ⟨_hDom_fstW, hDom_fstY₁, α₁, hα₁_snd, hα₁_fst, hα₁_sec, hα₁_uniq⟩ := hPillar1
  
  have hPillar2 : ∀ (V L : Type u) [CommRing V] [IsDomain V] [Field L]
      [Algebra V L] [IsFractionRing V L]
      (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W)
      (v_Y₁ : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ Y₁)
      (m_V : AlgebraicGeometry.Spec (CommRingCat.of V))
      (q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω))
      (q_Y₁ : ↥(CategoryTheory.Limits.pullback g_Y₁ s_Ω)),
      v_W ≫ g_W = v_Y₁ ≫ g_Y₁ →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ v_W ≫ h =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ v_Y₁ ≫ ρ₁ →
