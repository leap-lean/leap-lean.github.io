    ∀ (W_a : B₃.left.Opens), Nonempty ↥W_a →
      ∀ (C_a : AlgebraicGeometry.Scheme.{u})
        (g_a : C_a ⟶ W_a.toScheme)
        (τ_a : Fin n → (W_a.toScheme ⟶ C_a)),
        IsGeometricStablePointedCurve g_a n τ_a →
        HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ W_a g_a τ_a →
        let U_Wa : W_a.toScheme.Opens := (TopologicalSpace.Opens.map W_a.ι.base).obj U₃
