    let v_TB := CategoryTheory.Limits.pullback.lift (ψ₄_U ≫ uT₃_full) U_B.ι hvTB_comm
    have hwB_sub : Set.range ⇑v_TB ⊆ Set.range ⇑W_TB.ι := by
