        exact (IsLocalRing.maximalIdeal.isMaximal L').ne_top ((Ideal.eq_top_iff_one _).mpr h1_m)
      have hm_Q₁_le : IsLocalRing.maximalIdeal Q₁ ≤ J₁ := by
        intro z hz
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
        have hw_m : w ∈ IsLocalRing.maximalIdeal L' := by
          rw [IsLocalRing.mem_maximalIdeal]
          intro hw_unit
          exact ((IsLocalRing.mem_maximalIdeal _).mp hz) (hw_unit.map π₁)
        rw [hm_span, Ideal.mem_span_pair] at hw_m
        obtain ⟨c₁, c₂, hw_eq⟩ := hw_m
        have hπ_t₁ : π₁ t₁ = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton t₁))
        rw [Ideal.mem_span_singleton]
        refine ⟨π₁ c₂, ?_⟩
        calc π₁ w = π₁ (c₁ * t₁ + c₂ * t₂) := by rw [hw_eq]
          _ = π₁ c₁ * π₁ t₁ + π₁ c₂ * π₁ t₂ := by simp
          _ = π₁ t₂ * π₁ c₂ := by rw [hπ_t₁]; ring
      let q_bar : Ideal Q₁ := Ideal.map π₁ q
      have hq_bar_prime : q_bar.IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
      have hq_bar_le : q_bar ≤ J₁ :=
        (IsLocalRing.le_maximalIdeal hq_bar_prime.ne_top).trans hm_Q₁_le
      have ht₂_not_qbar : π₁ t₂ ∉ q_bar := by
        intro hmem
        obtain ⟨x, hx_q, hx_eq⟩ :=
          (Ideal.mem_map_iff_of_surjective π₁ Ideal.Quotient.mk_surjective).mp hmem
        have h_sub : t₂ - x ∈ I₁ :=
          Ideal.Quotient.eq_zero_iff_mem.mp (by simp [π₁, hx_eq])
        have ht₂_in : t₂ ∈ q := by
          have : t₂ = (t₂ - x) + x := by ring
          rw [this]
          exact Ideal.add_mem _ (hI₁_le h_sub) hx_q
        exact ht₂_not_q ht₂_in
      apply le_antisymm _ hI₁_le
      intro x hx
      let z : Q₁ := π₁ x
      have hz_qbar : z ∈ q_bar := Ideal.mem_map_of_mem π₁ hx
      have h_ind : ∀ i : ℕ, ∃ y ∈ q_bar, z = (π₁ t₂) ^ i * y := by
        intro i
        induction i with
        | zero => exact ⟨z, hz_qbar, by simp⟩
        | succ i ih =>
          obtain ⟨y, hy_q, hzy⟩ := ih
          obtain ⟨y', hy'⟩ := Ideal.mem_span_singleton.mp (hq_bar_le hy_q)
