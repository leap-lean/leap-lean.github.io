    let S'_sch : AlgebraicGeometry.Scheme.{u} := γ.image
    let ι_S' : S'_sch ⟶ Z := γ.imageι
    let ν : U'.toScheme ⟶ S'_sch := γ.toImage
    let π₀ : S'_sch ⟶ S.left := ι_S' ≫ pr₁
    let p₂₀ : S'_sch ⟶ P_Pl.left := ι_S' ≫ pr₂
    let S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
