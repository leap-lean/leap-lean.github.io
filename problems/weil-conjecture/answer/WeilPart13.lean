                  (TensorProduct.tmul κ₀ 1 x - TensorProduct.tmul κ₀ (ι₁₂ (π₁ x)) 1)
              rw [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
                mul_one, one_mul, mul_one]
            rw [hprod]
            exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hmem1)
          · rename_i x y hx hy
            have heq : (x + y) - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (ρ₂ (x + y)) =
                (x - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (ρ₂ x)) +
                  (y - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (ρ₂ y)) := by
              rw [map_add, map_add]; abel
            rw [heq]
            exact Ideal.add_mem _ hx hy
        have h := hdecomp w
        rw [hw0, map_zero, sub_zero] at h
        exact h
      · rw [Ideal.map_le_iff_le_comap]
        intro z hz
        change ρ₂ (ι_F z) = 0
        rw [hρ_ι z]
        have hz0 : ρ₁ z = 0 := hz
        rw [hz0, map_zero]
    let u₀₂ : TensorProduct κ₀ E₂ F₀ := ι_F u₀
    let v₀₂ : TensorProduct κ₀ E₂ F₀ := ι_F v₀
    let u_ext : TensorProduct κ₀ E₂ F₀ :=
      algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₀₀ * u₀₂ +
        algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₀₁ * v₀₂
    let v_ext : TensorProduct κ₀ E₂ F₀ :=
      algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₁₀ * u₀₂ +
        algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₁₁ * v₀₂
    have hu₀₂_mem : u₀₂ ∈ I₂ := by rw [hI₂_eq_map]; exact Ideal.mem_map_of_mem _ hu₀
    have hv₀₂_mem : v₀₂ ∈ I₂ := by rw [hI₂_eq_map]; exact Ideal.mem_map_of_mem _ hv₀
    have hu_mem : u_ext ∈ I₂ :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu₀₂_mem) (Ideal.mul_mem_left _ _ hv₀₂_mem)
    have hv_mem : v_ext ∈ I₂ :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu₀₂_mem) (Ideal.mul_mem_left _ _ hv₀₂_mem)
    have huv_cube : u_ext * v_ext ∈ I₂ ^ 3 := by
      have hexp1 : u_ext * v_ext =
          algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (p₀₀ * p₁₀) * u₀₂ ^ 2 +
            algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (p₀₀ * p₁₁ + p₀₁ * p₁₀) * u₀₂ * v₀₂ +
            algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (p₀₁ * p₁₁) * v₀₂ ^ 2 := by
        dsimp only [u_ext, v_ext]
        simp only [map_add, map_mul]
        ring
      have hexp : u_ext * v_ext = ι_F
          (algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₀ * u₀ ^ 2 +
            algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₁ * u₀ * v₀ +
            algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₂ * v₀ ^ 2) := by
        rw [hexp1, hP₀, hP₁, hP₂, ← h_alg_ι, ← h_alg_ι, ← h_alg_ι]
        dsimp only [u₀₂, v₀₂]
        simp only [map_add, map_mul, map_pow]
      rw [hexp, hI₂_eq_map, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hCubic₁
    have hSpan₂ : I₂ ≤ Ideal.span {u_ext, v_ext} ⊔ I₂ ^ 2 := by
      have hmap : I₂ ≤ Ideal.span {u₀₂, v₀₂} ⊔ I₂ ^ 2 := by
        have hm := Ideal.map_mono (f := ι_F.toRingHom) hSpan₁
        rw [← hI₂_eq_map, Ideal.map_sup, Ideal.map_span, Set.image_pair,
          Ideal.map_pow, ← hI₂_eq_map] at hm
        exact hm
      have hsub_span : Ideal.span {u₀₂, v₀₂} ≤ Ideal.span {u_ext, v_ext} := by
        let d := p₀₀ * p₁₁ - p₀₁ * p₁₀
        have hu_inv : u₀₂ = algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (d⁻¹ * p₁₁) * u_ext -
            algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (d⁻¹ * p₀₁) * v_ext := by
          have hd_eq : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) d * u₀₂ =
              algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₁₁ * u_ext -
                algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₀₁ * v_ext := by
            dsimp only [d, u_ext, v_ext]
            simp only [map_sub, map_mul]
            ring
          have h1 : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) d⁻¹ *
              (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) d * u₀₂) = u₀₂ := by
            rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hDetP, map_one, one_mul]
          rw [← h1, hd_eq, map_mul, map_mul]
          ring
        have hv_inv : v₀₂ = -algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (d⁻¹ * p₁₀) * u_ext +
            algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (d⁻¹ * p₀₀) * v_ext := by
          have hd_eq : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) d * v₀₂ =
              -algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₁₀ * u_ext +
                algebraMap E₂ (TensorProduct κ₀ E₂ F₀) p₀₀ * v_ext := by
            dsimp only [d, u_ext, v_ext]
            simp only [map_sub, map_mul]
            ring
          have h1 : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) d⁻¹ *
              (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) d * v₀₂) = v₀₂ := by
            rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hDetP, map_one, one_mul]
          rw [← h1, hd_eq, map_mul, map_mul]
          ring
        rw [Ideal.span_le]
        have hu_s : u_ext ∈ Ideal.span {u_ext, v_ext} := Ideal.subset_span (Set.mem_insert _ _)
        have hv_s : v_ext ∈ Ideal.span {u_ext, v_ext} :=
          Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
        rintro z (rfl | rfl)
        · rw [SetLike.mem_coe, hu_inv]
          exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hu_s) (Ideal.mul_mem_left _ _ hv_s)
        · rw [SetLike.mem_coe, hv_inv]
          exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu_s) (Ideal.mul_mem_left _ _ hv_s)
      exact hmap.trans (sup_le_sup_right hsub_span _)
    let mkL (l : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁) : TensorProduct κ₀ E₂ F₀ →ₗ[κ₀] E₂ :=
      TensorProduct.lift (LinearMap.mk₂ κ₀
        (fun (e₂ : E₂) (x : F₀) => e₂ * ι₁₂ (l (TensorProduct.tmul κ₀ (1 : E₁) x)))
        (fun a b x => by rw [add_mul])
        (fun r a x => by simp [Algebra.smul_def, mul_assoc])
        (fun e₂ x y => by rw [TensorProduct.tmul_add, map_add, map_add, mul_add])
        (fun r e₂ x => by
          have h1 : TensorProduct.tmul κ₀ (1 : E₁) (r • x) =
              algebraMap κ₀ E₁ r • TensorProduct.tmul κ₀ (1 : E₁) x := by
            rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
            symm
            rw [Algebra.smul_def]
            change TensorProduct.tmul κ₀ (algebraMap κ₀ E₁ r) 1 * TensorProduct.tmul κ₀ 1 x = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [h1, l.map_smul, smul_eq_mul, map_mul, ι₁₂.commutes, Algebra.smul_def]
          ring))
    have hmkL_tmul : ∀ (l : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁) (e₂ : E₂) (x : F₀),
        mkL l (TensorProduct.tmul κ₀ e₂ x) = e₂ * ι₁₂ (l (TensorProduct.tmul κ₀ (1 : E₁) x)) :=
      fun _ _ _ => rfl
    have hL_alg_mul : ∀ (l : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁) (c : E₂)
        (z : TensorProduct κ₀ E₂ F₀),
        mkL l (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c * z) = c * mkL l z := by
      intro l c z
      induction z using TensorProduct.induction_on
      · rw [mul_zero, map_zero, mul_zero]
      · rename_i e₂ x
        change mkL l (TensorProduct.tmul κ₀ c 1 * TensorProduct.tmul κ₀ e₂ x) =
          c * mkL l (TensorProduct.tmul κ₀ e₂ x)
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hmkL_tmul, hmkL_tmul, mul_assoc]
      · rename_i x y hx hy
        rw [mul_add, map_add, map_add, hx, hy, mul_add]
    have hL_ι : ∀ (l : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁) (z : TensorProduct κ₀ E₁ F₀),
        mkL l (ι_F z) = ι₁₂ (l z) := by
      intro l z
      induction z using TensorProduct.induction_on
      · rw [map_zero, map_zero, map_zero, map_zero]
      · rename_i e₁ x
        rw [hιF_tmul, hmkL_tmul]
        have hsmul : TensorProduct.tmul κ₀ e₁ x = e₁ • TensorProduct.tmul κ₀ (1 : E₁) x := by
          rw [Algebra.smul_def]
          change _ = TensorProduct.tmul κ₀ e₁ 1 * TensorProduct.tmul κ₀ 1 x
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsmul, l.map_smul, smul_eq_mul, map_mul]
      · rename_i x y hx hy
        rw [map_add, map_add, map_add, map_add, hx, hy]
    have hL_sq_zero : ∀ (l : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁),
        (∀ w ∈ m₁ ^ 2, l w = 0) → ∀ q ∈ I₂ ^ 2, mkL l q = 0 := by
      intro l hl q hq
      let K_l : Ideal (TensorProduct κ₀ E₂ F₀) :=
        { carrier := {t : TensorProduct κ₀ E₂ F₀ | ∀ w : TensorProduct κ₀ E₂ F₀, mkL l (w * t) = 0}
          add_mem' := fun {a b} ha hb w => by rw [mul_add, map_add, ha w, hb w, add_zero]
          zero_mem' := fun w => by rw [mul_zero, map_zero]
          smul_mem' := fun r t ht w => by rw [smul_eq_mul, ← mul_assoc]; exact ht (w * r) }
      have hmap_le : I₂ ^ 2 ≤ K_l := by
        rw [hI₂_eq_map, ← Ideal.map_pow, Ideal.map_le_iff_le_comap]
        intro r hr w
        change mkL l (w * ι_F r) = 0
        induction w using TensorProduct.induction_on
        · rw [zero_mul, map_zero]
        · rename_i e₂ y
          have hmul : TensorProduct.tmul κ₀ e₂ y * ι_F r =
              algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e₂ *
                ι_F (TensorProduct.tmul κ₀ (1 : E₁) y * r) := by
            have hy : TensorProduct.tmul κ₀ e₂ y =
                algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e₂ *
                  ι_F (TensorProduct.tmul κ₀ (1 : E₁) y) := by
              rw [hιF_tmul, map_one]
              change TensorProduct.tmul κ₀ e₂ y =
                TensorProduct.tmul κ₀ e₂ 1 * TensorProduct.tmul κ₀ 1 y
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [hy, mul_assoc, ← map_mul]
          rw [hmul, hL_alg_mul, hL_ι, hl _ (Ideal.mul_mem_left _ _ hr), map_zero, mul_zero]
        · rename_i x y hx hy
          rw [add_mul, map_add, hx, hy, add_zero]
      have hqK := hmap_le hq 1
      rw [one_mul] at hqK
      exact hqK
    have hLinIndep_global : ∀ c₀ c₁ : E₂,
        algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₀ * u_ext +
          algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₁ * v_ext ∈ I₂ ^ 2 →
        c₀ = 0 ∧ c₁ = 0 := by
      intro c₀ c₁ hx
      let x := algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₀ * u_ext +
        algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₁ * v_ext
      have hx_eq : x = algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (c₀ * p₀₀ + c₁ * p₁₀) * u₀₂ +
          algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (c₀ * p₀₁ + c₁ * p₁₁) * v₀₂ := by
        dsimp only [x, u_ext, v_ext]
        simp only [map_add, map_mul]
        ring
      have h0 : mkL l₀ x = 0 := hL_sq_zero l₀ (fun w hw => (hl_sq w hw).1) x hx
      have h1 : mkL l₁ x = 0 := hL_sq_zero l₁ (fun w hw => (hl_sq w hw).2) x hx
      rw [hx_eq, map_add, hL_alg_mul, hL_alg_mul, hL_ι, hL_ι, hl₀u, hl₀v,
        map_one, map_zero, mul_one, mul_zero, add_zero] at h0
      rw [hx_eq, map_add, hL_alg_mul, hL_alg_mul, hL_ι, hL_ι, hl₁u, hl₁v,
        map_zero, map_one, mul_zero, mul_one, zero_add] at h1
      let d := p₀₀ * p₁₁ - p₀₁ * p₁₀
      have hc₀ : d * c₀ = 0 := by
        have hd : d * c₀ = p₁₁ * (c₀ * p₀₀ + c₁ * p₁₀) - p₁₀ * (c₀ * p₀₁ + c₁ * p₁₁) := by
          dsimp [d]; ring
        rw [hd, h0, h1, mul_zero, mul_zero, sub_self]
      have hc₁ : d * c₁ = 0 := by
        have hd : d * c₁ = p₀₀ * (c₀ * p₀₁ + c₁ * p₁₁) - p₀₁ * (c₀ * p₀₀ + c₁ * p₁₀) := by
          dsimp [d]; ring
        rw [hd, h0, h1, mul_zero, mul_zero, sub_self]
      exact ⟨(mul_eq_zero.mp hc₀).resolve_left hDetP, (mul_eq_zero.mp hc₁).resolve_left hDetP⟩
    let L₂ := Localization.AtPrime m₂.asIdeal
    let loc := algebraMap (TensorProduct κ₀ E₂ F₀) L₂
    let 𝔪 : Ideal L₂ := IsLocalRing.maximalIdeal L₂
    have h𝔪_eq : Ideal.map loc I₂ = 𝔪 :=
      IsLocalization.AtPrime.map_eq_maximalIdeal I₂ L₂
    have hloc_cube : loc u_ext * loc v_ext ∈ 𝔪 ^ 3 := by
      rw [← map_mul, ← h𝔪_eq, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem loc huv_cube
    have hloc_lin : ∀ c₀ c₁ : E₂,
        loc (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₀) * loc u_ext +
          loc (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₁) * loc v_ext ∈ 𝔪 ^ 2 →
        c₀ = 0 ∧ c₁ = 0 := by
      intro c₀ c₁ hmem
      let x := algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₀ * u_ext +
        algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₁ * v_ext
      have hx_I₂ : x ∈ I₂ :=
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu_mem) (Ideal.mul_mem_left _ _ hv_mem)
      have hloc_x : loc x ∈ Ideal.map loc (I₂ ^ 2) := by
        rw [Ideal.map_pow, h𝔪_eq]
        dsimp [x]
        rwa [map_add, map_mul, map_mul]
      obtain ⟨s, hs, hsx⟩ :=
        (IsLocalization.algebraMap_mem_map_algebraMap_iff m₂.asIdeal.primeCompl L₂ (I₂ ^ 2) x).mp
          hloc_x
      have hs_not : s ∉ I₂ := hs
      let e : E₂ := ρ₂ s
      have he_ne : e ≠ 0 := fun he0 => hs_not he0
      have hs_sub : s - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e ∈ I₂ := by
        change ρ₂ (s - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) (ρ₂ s)) = 0
        rw [map_sub, ρ₂.commutes]
        exact sub_self (ρ₂ s)
      have hprod_sq : (s - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e) * x ∈ I₂ ^ 2 := by
        rw [sq]
        exact Ideal.mul_mem_mul hs_sub hx_I₂
      have hex_sq : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e * x ∈ I₂ ^ 2 := by
        have heq : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e * x =
            s * x - (s - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e) * x := by ring
        rw [heq]
        exact Ideal.sub_mem _ hsx hprod_sq
      have hx_sq : x ∈ I₂ ^ 2 := by
        have h1 : algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e⁻¹ *
            (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) e * x) ∈ I₂ ^ 2 :=
          Ideal.mul_mem_left _ _ hex_sq
        rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ he_ne, map_one, one_mul] at h1
      exact hLinIndep_global c₀ c₁ hx_sq
    have hloc_span : Ideal.span {loc u_ext, loc v_ext} = 𝔪 := by
      apply le_antisymm
      · rw [Ideal.span_le, ← h𝔪_eq]
        rintro z (rfl | rfl)
        · exact Ideal.mem_map_of_mem loc hu_mem
        · exact Ideal.mem_map_of_mem loc hv_mem
      · have : Algebra.FiniteType E₂ (TensorProduct κ₀ E₂ F₀) := Algebra.FiniteType.baseChange E₂
        have : IsNoetherianRing (TensorProduct κ₀ E₂ F₀) :=
          Algebra.FiniteType.isNoetherianRing E₂ (TensorProduct κ₀ E₂ F₀)
        have : IsNoetherianRing L₂ :=
          IsLocalization.isNoetherianRing m₂.asIdeal.primeCompl L₂ inferInstance
        have hFG : 𝔪.FG := IsNoetherian.noetherian 𝔪
        have hJac : 𝔪 ≤ (⊥ : Ideal L₂).jacobson := by
          rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
        have hLe : 𝔪 ≤ Ideal.span {loc u_ext, loc v_ext} ⊔ 𝔪 • 𝔪 := by
          have hm := Ideal.map_mono (f := loc) hSpan₂
          rw [h𝔪_eq, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_pow,
            h𝔪_eq, sq, ← smul_eq_mul] at hm
          exact hm
        exact Submodule.le_of_le_smul_of_le_jacobson_bot hFG hJac hLe
    exact ⟨u_ext, v_ext, m₂, rfl, hu_mem, hv_mem, hres, hloc_span, hloc_lin, hloc_cube⟩
  
  let I_cube : Ideal (TensorProduct κ₀ K F₀) := q_K ^ 3
  let J_std : Ideal (MvPolynomial (Fin 2) K) :=
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) * MvPolynomial.X 1} ⊔
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K), MvPolynomial.X 1} ^ 3
  obtain ⟨Φ_K, hΦ_K⟩ := hIso_cube
  let Φ_alg : (TensorProduct κ₀ K F₀ ⧸ I_cube) ≃ₐ[K] (MvPolynomial (Fin 2) K ⧸ J_std) :=
    AlgEquiv.ofRingEquiv (f := Φ_K) hΦ_K
  obtain ⟨hNil, hRank5, hRank3, Λ, hΛ_one, hΛ_mem, hΛ_sq, hx₀₁, hx₀₂, hx₁₁, hx₁₂, hΛ_mul⟩ :=
    hs1 K
  let x₀ : MvPolynomial (Fin 2) K ⧸ J_std := Ideal.Quotient.mk J_std (MvPolynomial.X 0)
  let x₁ : MvPolynomial (Fin 2) K ⧸ J_std := Ideal.Quotient.mk J_std (MvPolynomial.X 1)
  let 𝔫 : Ideal (MvPolynomial (Fin 2) K ⧸ J_std) := Ideal.span {x₀, x₁}
  have hx₀_mem : x₀ ∈ 𝔫 := Ideal.subset_span (Set.mem_insert _ _)
  have hx₁_mem : x₁ ∈ 𝔫 := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  obtain ⟨u₀, v₀, l₀, l₁, a₀, a₁, a₂, m₀₀, m₀₁, m₁₀, m₁₁,
      hu₀, hv₀, hSpan₁, hl_sq, hl₀u, hl₀v, hl₁u, hl₁v,
      ha_nonzero, hCubic₁, hDet, hEq₀, hEq₁⟩ :=
    hs2 κ₀ F₀ K E₁ (MvPolynomial (Fin 2) K ⧸ J_std) π₁ j₁ q_K 𝔫 Λ
      hq_K Φ_alg hNil hRank5 hRank3 hΛ_one hΛ_mem hΛ_sq
      ⟨x₀, x₁, hx₀_mem, hx₁_mem, hx₀₁, hx₀₂, hx₁₁, hx₁₂⟩ hΛ_mul
  obtain ⟨E₂, instFieldE₂, instAlgE₂, instFinE₂, instSepE₂,
      ι₁₂, j₂, p₀₀, p₀₁, p₁₀, p₁₁, hj₂_ι, hDetP, hP₀, hP₁, hP₂⟩ :=
    hs3 κ₀ E₁ K j₁ a₀ a₁ a₂ m₀₀ m₀₁ m₁₀ m₁₁ ha_nonzero hDet hEq₀ hEq₁
  letI : Field E₂ := instFieldE₂
  letI : Algebra κ₀ E₂ := instAlgE₂
  letI : FiniteDimensional κ₀ E₂ := instFinE₂
  letI : Algebra.IsSeparable κ₀ E₂ := instSepE₂
  obtain ⟨u_ext, v_ext, m₂, hm₂_ker, hu_ext, hv_ext, hres, hloc⟩ :=
    hs4 κ₀ F₀ E₁ E₂ π₁ ι₁₂ u₀ v₀ l₀ l₁ a₀ a₁ a₂ p₀₀ p₀₁ p₁₀ p₁₁
      hu₀ hv₀ hSpan₁ hl_sq hl₀u hl₀v hl₁u hl₁v hCubic₁ hDetP hP₀ hP₁ hP₂
  let π₂ : F₀ →ₐ[κ₀] E₂ := ι₁₂.comp π₁
  have hj₂_π₂ : j₂.comp π₂ = j₁.comp π₁ := by
    ext x
    exact AlgHom.congr_fun hj₂_ι (π₁ x)
  exact ⟨E₂, instFieldE₂, instAlgE₂, instFinE₂, instSepE₂,
    π₂, j₂, u_ext, v_ext, m₂, hj₂_π₂, hm₂_ker, hu_ext, hv_ext, hres, hloc⟩

theorem weil_etale_base_lift_of_finite_separable_residue_ext (R₀ : Type u) [CommRing R₀] (p₀ : PrimeSpectrum R₀)
    (E : Type u) [Field E] [Algebra p₀.asIdeal.ResidueField E]
    [FiniteDimensional p₀.asIdeal.ResidueField E] [Algebra.IsSeparable p₀.asIdeal.ResidueField E]
    (S_fin : Finset E) :
    ∃ (R₁ : Type u) (_ : CommRing R₁) (eR₁ : R₀ →+* R₁) (p₁ : PrimeSpectrum R₁)
      (hp₁ : p₀.asIdeal = Ideal.comap eR₁ p₁.asIdeal)
      (φ_κ : p₁.asIdeal.ResidueField ≃+* E),
      eR₁.Etale ∧
      φ_κ.toRingHom.comp (Ideal.ResidueField.map p₀.asIdeal p₁.asIdeal eR₁ hp₁) =
        algebraMap p₀.asIdeal.ResidueField E ∧
      (∀ e ∈ S_fin, ∃ r₁ : R₁, φ_κ (algebraMap R₁ p₁.asIdeal.ResidueField r₁) = e) :=
by
  classical
  let κ₀ : Type u := p₀.asIdeal.ResidueField
  obtain ⟨α, hα⟩ := Field.exists_primitive_element κ₀ E
  have hα_int : IsIntegral κ₀ α := Algebra.IsIntegral.isIntegral α
  have hα_alg : IsAlgebraic κ₀ α := Algebra.IsAlgebraic.isAlgebraic α
  have hAdj : Algebra.adjoin κ₀ ({α} : Set E) = ⊤ :=
    Algebra.adjoin_eq_top_of_primitive_element hα_alg hα
  have h_surj : Function.Surjective (Polynomial.aeval (R := κ₀) α) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_singleton_eq_range_aeval]
    exact hAdj
  let Q_poly : E → Polynomial κ₀ := fun e => Classical.choose (h_surj e)
  have hQ_poly : ∀ e : E, Polynomial.aeval (R := κ₀) α (Q_poly e) = e :=
    fun e => Classical.choose_spec (h_surj e)
  let P₀ : Polynomial κ₀ := minpoly κ₀ α
  let d : ℕ := P₀.natDegree
  have hP₀_monic : P₀.Monic := minpoly.monic hα_int
  have hP₀_aeval : Polynomial.aeval (R := κ₀) α P₀ = 0 := minpoly.aeval κ₀ α
  have hP₀_deriv_unit : IsUnit (Polynomial.aeval (R := κ₀) α (Polynomial.derivative P₀)) :=
    ((Algebra.IsSeparable.isSeparable κ₀ α).aeval_derivative_ne_zero hP₀_aeval).isUnit
  have hFracAll : ∀ c : κ₀, ∃ a b : R₀, b ∉ p₀.asIdeal ∧
      c * algebraMap R₀ κ₀ b = algebraMap R₀ κ₀ a := by
    intro c
    obtain ⟨q_a, q_b, hq_b, hdiv⟩ := IsFractionRing.div_surjective (R₀ ⧸ p₀.asIdeal) c
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q_a
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q_b
    have hb_ne_q : Ideal.Quotient.mk p₀.asIdeal b ≠ 0 := nonZeroDivisors.ne_zero hq_b
    have hb : b ∉ p₀.asIdeal := by
      intro hb_mem
      exact hb_ne_q ((Ideal.Quotient.eq_zero_iff_mem).mpr hb_mem)
    have ha_alg : algebraMap (R₀ ⧸ p₀.asIdeal) κ₀ (Ideal.Quotient.mk p₀.asIdeal a) =
        algebraMap R₀ κ₀ a :=
      (IsScalarTower.algebraMap_apply R₀ (R₀ ⧸ p₀.asIdeal) κ₀ a).symm
    have hb_alg : algebraMap (R₀ ⧸ p₀.asIdeal) κ₀ (Ideal.Quotient.mk p₀.asIdeal b) =
        algebraMap R₀ κ₀ b :=
      (IsScalarTower.algebraMap_apply R₀ (R₀ ⧸ p₀.asIdeal) κ₀ b).symm
    rw [ha_alg, hb_alg] at hdiv
    have hb_ne : algebraMap R₀ κ₀ b ≠ 0 := by
      intro hzero
      exact hb ((Ideal.algebraMap_residueField_eq_zero).mp hzero)
    refine ⟨a, b, hb, ?_⟩
    rw [← hdiv, div_mul_cancel₀ _ hb_ne]
  let numR : κ₀ → R₀ := fun c => Classical.choose (hFracAll c)
  let denR : κ₀ → R₀ := fun c => Classical.choose (Classical.choose_spec (hFracAll c))
  have hden : ∀ c : κ₀, denR c ∉ p₀.asIdeal :=
    fun c => (Classical.choose_spec (Classical.choose_spec (hFracAll c))).1
  have hfrac : ∀ c : κ₀, c * algebraMap R₀ κ₀ (denR c) = algebraMap R₀ κ₀ (numR c) :=
    fun c => (Classical.choose_spec (Classical.choose_spec (hFracAll c))).2
  let Poly_fin : Finset (Polynomial κ₀) := insert P₀ (S_fin.image Q_poly)
  let C_fin : Finset κ₀ :=
    Poly_fin.biUnion fun q => (Finset.range (q.natDegree + 1)).image q.coeff
  let s₀ : R₀ := ∏ c ∈ C_fin, denR c
  have hs₀ : s₀ ∉ p₀.asIdeal :=
    Submonoid.prod_mem p₀.asIdeal.primeCompl fun c _ => hden c
  have hs₀_ne : algebraMap R₀ κ₀ s₀ ≠ 0 := by
    intro hzero
    exact hs₀ ((Ideal.algebraMap_residueField_eq_zero).mp hzero)
  have hs₀_unit : IsUnit (algebraMap R₀ κ₀ s₀) := hs₀_ne.isUnit
  let R_loc : Type u := Localization.Away s₀
  let π_loc : R_loc →+* κ₀ := IsLocalization.Away.lift s₀ hs₀_unit
  have hπ_loc_eq : ∀ r : R₀, π_loc (algebraMap R₀ R_loc r) = algebraMap R₀ κ₀ r :=
    fun r => IsLocalization.Away.lift_eq s₀ hs₀_unit r
  have h_exists_lift : ∀ c ∈ C_fin, ∃ r_c : R_loc, π_loc r_c = c := by
    intro c hc
    obtain ⟨d_c, hd_c⟩ := Finset.dvd_prod_of_mem denR hc
    let r_c : R_loc :=
      algebraMap R₀ R_loc (numR c * d_c) * IsLocalization.Away.invSelf (S := R_loc) s₀
    refine ⟨r_c, ?_⟩
    apply mul_right_cancel₀ hs₀_ne
    calc
      π_loc r_c * algebraMap R₀ κ₀ s₀
          = π_loc (r_c * algebraMap R₀ R_loc s₀) := by rw [← hπ_loc_eq, ← map_mul]
      _ = π_loc (algebraMap R₀ R_loc (numR c * d_c) *
            (algebraMap R₀ R_loc s₀ * IsLocalization.Away.invSelf (S := R_loc) s₀)) := by
            congr 1; dsimp [r_c]; ring
      _ = π_loc (algebraMap R₀ R_loc (numR c * d_c)) := by
            rw [IsLocalization.Away.mul_invSelf, mul_one]
      _ = algebraMap R₀ κ₀ (numR c) * algebraMap R₀ κ₀ d_c := by
            rw [hπ_loc_eq, map_mul]
      _ = (c * algebraMap R₀ κ₀ (denR c)) * algebraMap R₀ κ₀ d_c := by
            rw [hfrac c]
      _ = c * algebraMap R₀ κ₀ s₀ := by
            rw [mul_assoc, ← map_mul, ← hd_c]
  let liftCoeff : κ₀ → R_loc :=
    fun c => if hc : c ∈ C_fin then Classical.choose (h_exists_lift c hc) else 0
  have h_liftCoeff : ∀ c ∈ C_fin, π_loc (liftCoeff c) = c := by
    intro c hc
    simp only [liftCoeff, hc, ↓reduceDIte]
    exact Classical.choose_spec (h_exists_lift c hc)
  let liftPoly : Polynomial κ₀ → Polynomial R_loc := fun q =>
    ∑ i ∈ Finset.range (q.natDegree + 1),
      Polynomial.C (liftCoeff (q.coeff i)) * Polynomial.X ^ i
  have h_liftPoly : ∀ q ∈ Poly_fin, Polynomial.map π_loc (liftPoly q) = q := by
    intro q hq
    dsimp [liftPoly]
    rw [Polynomial.map_sum]
    have hsum : (∑ i ∈ Finset.range (q.natDegree + 1),
        Polynomial.map π_loc (Polynomial.C (liftCoeff (q.coeff i)) * Polynomial.X ^ i)) =
        ∑ i ∈ Finset.range (q.natDegree + 1), Polynomial.C (q.coeff i) * Polynomial.X ^ i := by
      refine Finset.sum_congr rfl fun i hi => ?_
      have hc : q.coeff i ∈ C_fin :=
        Finset.mem_biUnion.mpr ⟨q, hq, Finset.mem_image_of_mem _ hi⟩
      rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X,
        h_liftCoeff _ hc]
    rw [hsum, ← Polynomial.as_sum_range_C_mul_X_pow]
  let P : Polynomial R_loc :=
    Polynomial.X ^ d + ∑ i : Fin d,
      Polynomial.C (liftCoeff (P₀.coeff (i : ℕ))) * Polynomial.X ^ (i : ℕ)
  have hP_monic : P.Monic :=
    Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
  have hP_map : Polynomial.map π_loc P = P₀ := by
    dsimp [P]
    rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum]
    have hP₀_mem : P₀ ∈ Poly_fin := Finset.mem_insert_self _ _
    have hsum : (∑ i : Fin d,
        Polynomial.map π_loc (Polynomial.C (liftCoeff (P₀.coeff (i : ℕ))) * Polynomial.X ^ (i : ℕ))) =
        ∑ i : Fin d, Polynomial.C (P₀.coeff (i : ℕ)) * Polynomial.X ^ (i : ℕ) := by
      refine Finset.sum_congr rfl fun i _ => ?_
      have hi_range : (i : ℕ) ∈ Finset.range (P₀.natDegree + 1) :=
        Finset.mem_range.mpr (Nat.lt_succ_of_lt i.isLt)
      have hc : P₀.coeff (i : ℕ) ∈ C_fin :=
        Finset.mem_biUnion.mpr ⟨P₀, hP₀_mem, Finset.mem_image_of_mem _ hi_range⟩
      rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X,
        h_liftCoeff _ hc]
    rw [hsum, Fin.sum_univ_eq_sum_range (fun k : ℕ => Polynomial.C (P₀.coeff k) * Polynomial.X ^ k),
      add_comm]
    have hlead : (Polynomial.X ^ d : Polynomial κ₀) = Polynomial.C (P₀.coeff d) * Polynomial.X ^ d := by
      rw [show P₀.coeff d = 1 from hP₀_monic.coeff_natDegree, map_one, one_mul]
    rw [hlead, ← Finset.sum_range_succ, ← Polynomial.as_sum_range_C_mul_X_pow]
  let S_pair : StandardEtalePair R_loc :=
    StandardEtalePair.mk P hP_monic (Polynomial.derivative P)
      ⟨1, 0, 1, by rw [mul_one, mul_zero, add_zero, pow_one]⟩
  let R₁ : Type u := S_pair.Ring
  let eR₁ : R₀ →+* R₁ := (algebraMap R_loc R₁).comp (algebraMap R₀ R_loc)
  have heR₁ : eR₁.Etale :=
    RingHom.Etale.stableUnderComposition (algebraMap R₀ R_loc) (algebraMap R_loc R₁)
      ((RingHom.etale_algebraMap).mpr (Algebra.Etale.of_isLocalizationAway s₀))
      ((RingHom.etale_algebraMap).mpr inferInstance)
  let toE_loc : R_loc →+* E := (algebraMap κ₀ E).comp π_loc
  letI : Algebra R_loc E := toE_loc.toAlgebra
  have h_aeval_loc : ∀ q : Polynomial R_loc,
      Polynomial.aeval (R := R_loc) α q = Polynomial.aeval (R := κ₀) α (Polynomial.map π_loc q) := by
    intro q
    rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map]
    rfl
  have hHas : S_pair.HasMap α := by
    refine ⟨?_, ?_⟩
    · change Polynomial.aeval (R := R_loc) α P = 0
      rw [h_aeval_loc, hP_map]
      exact hP₀_aeval
    · change IsUnit (Polynomial.aeval (R := R_loc) α (Polynomial.derivative P))
      rw [h_aeval_loc, ← Polynomial.derivative_map, hP_map]
      exact hP₀_deriv_unit
  let ψ_E : R₁ →ₐ[R_loc] E := S_pair.lift α hHas
  have hψ_X : ψ_E S_pair.X = α := S_pair.lift_X α hHas
  haveI : (RingHom.ker ψ_E.toRingHom).IsPrime := RingHom.ker_isPrime ψ_E.toRingHom
  let p₁ : PrimeSpectrum R₁ := ⟨RingHom.ker ψ_E.toRingHom, inferInstance⟩
  haveI : p₁.asIdeal.IsPrime := p₁.isPrime
  have hψ_eR₁ : ∀ r₀ : R₀, ψ_E (eR₁ r₀) = algebraMap κ₀ E (algebraMap R₀ κ₀ r₀) := by
    intro r₀
    change ψ_E (algebraMap R_loc R₁ (algebraMap R₀ R_loc r₀)) = _
    rw [ψ_E.commutes]
    change algebraMap κ₀ E (π_loc (algebraMap R₀ R_loc r₀)) = _
    rw [hπ_loc_eq]
  have hp₁ : p₀.asIdeal = Ideal.comap eR₁ p₁.asIdeal := by
    ext r₀
    rw [Ideal.mem_comap]
    change r₀ ∈ p₀.asIdeal ↔ ψ_E (eR₁ r₀) = 0
    rw [hψ_eR₁, map_eq_zero_iff (algebraMap κ₀ E) (algebraMap κ₀ E).injective,
      Ideal.algebraMap_residueField_eq_zero]
  let κ₁ : Type u := p₁.asIdeal.ResidueField
  let ψ_bar : κ₁ →+* E :=
    Ideal.ResidueField.lift p₁.asIdeal ψ_E.toRingHom le_rfl
      (fun r₁ hr₁ => Ne.isUnit hr₁)
  have hψ_bar_alg : ∀ r₁ : R₁, ψ_bar (algebraMap R₁ κ₁ r₁) = ψ_E r₁ :=
    fun r₁ => Ideal.ResidueField.lift_algebraMap p₁.asIdeal ψ_E.toRingHom le_rfl _ r₁
  let j₀ : κ₀ →+* κ₁ := Ideal.ResidueField.map p₀.asIdeal p₁.asIdeal eR₁ hp₁
  have hcomp : ψ_bar.comp j₀ = algebraMap κ₀ E := by
    apply Ideal.ResidueField.ringHom_ext
    ext r₀
    simp only [RingHom.comp_apply]
    change ψ_bar (Ideal.ResidueField.map p₀.asIdeal p₁.asIdeal eR₁ hp₁ (algebraMap R₀ κ₀ r₀)) = _
    rw [Ideal.ResidueField.map_algebraMap, hψ_bar_alg, hψ_eR₁]
  have hψ_bar_surj : Function.Surjective ψ_bar := by
    intro y
    let x₁ : κ₁ := algebraMap R₁ κ₁ S_pair.X
    refine ⟨Polynomial.eval₂ j₀ x₁ (Q_poly y), ?_⟩
    rw [Polynomial.hom_eval₂, hcomp]
    have hx₁ : ψ_bar x₁ = α := by
      dsimp [x₁]
      rw [hψ_bar_alg, hψ_X]
    rw [hx₁, ← Polynomial.aeval_def, hQ_poly]
  let φ_κ : κ₁ ≃+* E := RingEquiv.ofBijective ψ_bar ⟨ψ_bar.injective, hψ_bar_surj⟩
  have hφ_toRingHom : φ_κ.toRingHom = ψ_bar := RingHom.ext fun _ => rfl
  refine ⟨R₁, inferInstance, eR₁, p₁, hp₁, φ_κ, heR₁, ?_, ?_⟩
  · rw [hφ_toRingHom]
    exact hcomp
  · intro e he
    have hQe_mem : Q_poly e ∈ Poly_fin :=
      Finset.mem_insert_of_mem (Finset.mem_image_of_mem Q_poly he)
    refine ⟨Polynomial.aeval (R := R_loc) S_pair.X (liftPoly (Q_poly e)), ?_⟩
    change ψ_bar (algebraMap R₁ κ₁ (Polynomial.aeval (R := R_loc) S_pair.X (liftPoly (Q_poly e)))) = e
    rw [hψ_bar_alg, ← Polynomial.aeval_algHom_apply ψ_E S_pair.X, hψ_X, h_aeval_loc,
      h_liftPoly _ hQe_mem, hQ_poly]

theorem weil_split_fiber_node_of_etale_base_and_ext_witness (R₀ A₀ R₁ E₂ D_K : Type u)
    [CommRing R₀] [CommRing A₀] [CommRing R₁] [Field E₂] [CommRing D_K]
    (f₀ : R₀ →+* A₀) (hFlat₀ : f₀.Flat) (hFP₀ : f₀.FinitePresentation) (q₀ : PrimeSpectrum A₀)
    (m₀ : PrimeSpectrum D_K)
    [Algebra (PrimeSpectrum.comap f₀ q₀).asIdeal.ResidueField E₂]
    [FiniteDimensional (PrimeSpectrum.comap f₀ q₀).asIdeal.ResidueField E₂]
    (eR₁ : R₀ →+* R₁) (p₁ : PrimeSpectrum R₁)
    (hp₁ : (PrimeSpectrum.comap f₀ q₀).asIdeal = Ideal.comap eR₁ p₁.asIdeal)
    (φ_κ : p₁.asIdeal.ResidueField ≃+* E₂) :
    letI : Algebra R₀ A₀ := f₀.toAlgebra
    let p₀ : PrimeSpectrum R₀ := PrimeSpectrum.comap f₀ q₀
    let κ₀ : Type u := p₀.asIdeal.ResidueField
    let K : Type u := AlgebraicClosure κ₀
    let toK : R₀ →+* K := (algebraMap κ₀ K).comp (algebraMap R₀ κ₀)
    letI : Algebra R₀ K := toK.toAlgebra
    let F₀ : Type u := TensorProduct R₀ κ₀ A₀
    letI : Algebra R₀ R₁ := eR₁.toAlgebra
    let A₁ : Type u := TensorProduct R₀ R₁ A₀
    let f₁ : R₁ →+* A₁ := Algebra.TensorProduct.includeLeftRingHom
    let eA₁ : A₀ →+* A₁ := Algebra.TensorProduct.includeRight.toRingHom
    ∀ (ψ₁ : TensorProduct R₀ A₀ K →+* D_K)
      (ψ₂ : (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D_K)
      (π₂ : F₀ →ₐ[κ₀] E₂) (j₂ : E₂ →ₐ[κ₀] K)
      (u_ext v_ext : TensorProduct κ₀ E₂ F₀)
      (m₂ : PrimeSpectrum (TensorProduct κ₀ E₂ F₀))
      (u₁ v₁ : A₁),
        ψ₁.Etale →
        ψ₂.Etale →
        PrimeSpectrum.comap (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom) m₀ = q₀ →
        (∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ m₀.asIdeal) →
        ψ₁.comp Algebra.TensorProduct.includeRight.toRingHom =
          ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
        eR₁.Etale →
        φ_κ.toRingHom.comp (Ideal.ResidueField.map p₀.asIdeal p₁.asIdeal eR₁ hp₁) =
          algebraMap κ₀ E₂ →
        (∀ a₀ : A₀,
          ψ₁ (Algebra.TensorProduct.includeLeftRingHom a₀) -
            ψ₁ (Algebra.TensorProduct.includeRight (j₂ (π₂ (Algebra.TensorProduct.includeRight a₀)))) ∈
            m₀.asIdeal) →
        m₂.asIdeal =
          RingHom.ker (Algebra.TensorProduct.lift (AlgHom.id E₂ E₂) π₂
            (fun _ _ => mul_comm _ _)).toRingHom →
        u_ext ∈ m₂.asIdeal →
        v_ext ∈ m₂.asIdeal →
        (∀ z : TensorProduct κ₀ E₂ F₀,
          ∃ c : E₂, z - algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c ∈ m₂.asIdeal) →
        (let L₂ := Localization.AtPrime m₂.asIdeal
         let loc := algebraMap (TensorProduct κ₀ E₂ F₀) L₂
         let 𝔪 : Ideal L₂ := IsLocalRing.maximalIdeal L₂
         Ideal.span {loc u_ext, loc v_ext} = 𝔪 ∧
         (∀ c₀ c₁ : E₂,
           loc (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₀) * loc u_ext +
             loc (algebraMap E₂ (TensorProduct κ₀ E₂ F₀) c₁) * loc v_ext ∈ 𝔪 ^ 2 →
           c₀ = 0 ∧ c₁ = 0) ∧
         loc u_ext * loc v_ext ∈ 𝔪 ^ 3) →
        (∀ (τ : A₁ →+* TensorProduct κ₀ E₂ F₀),
          (∀ r₁ : R₁,
            τ (f₁ r₁) = algebraMap E₂ (TensorProduct κ₀ E₂ F₀)
              (φ_κ (algebraMap R₁ p₁.asIdeal.ResidueField r₁))) →
          (∀ a₀ : A₀,
            τ (eA₁ a₀) = Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀)) →
          τ u₁ = u_ext ∧ τ v₁ = v_ext) →
        ∃ q₁ : PrimeSpectrum A₁,
          eA₁.Etale ∧
          f₁.Flat ∧
          f₁.FinitePresentation ∧
          eA₁.comp f₀ = f₁.comp eR₁ ∧
          PrimeSpectrum.comap eA₁ q₁ = q₀ ∧
          HasSplitFiberNodeAt f₁ q₁ u₁ v₁ :=
by
  intro p₀ κ₀ K toK F₀ A₁ f₁ eA₁
    ψ₁ ψ₂ π₂ j₂ u_ext v_ext m₂ u₁ v₁
    hψ₁ hψ₂ hm₀_q₀ hXi hcomm_orig heR₁ hφ_map hcompat₂
    hm₂_ker hu_m₂ hv_m₂ hres_m₂ hloc_m₂ hτ_uv
  letI : Algebra R₀ A₀ := f₀.toAlgebra
  letI : Algebra R₀ K := toK.toAlgebra
  letI : Algebra R₀ R₁ := eR₁.toAlgebra
  
  have hf₁_flat : f₁.Flat := by
    haveI : Module.Flat R₀ A₀ := (RingHom.flat_algebraMap_iff).mp hFlat₀
    haveI : Module.Flat R₁ A₁ := Module.Flat.baseChange R₀ R₁ A₀
    exact (RingHom.flat_algebraMap_iff).mpr inferInstance
  have hf₁_fp : f₁.FinitePresentation := by
    haveI : Algebra.FinitePresentation R₀ A₀ := (RingHom.finitePresentation_algebraMap).mp hFP₀
    haveI : Algebra.FinitePresentation R₁ A₁ :=
