        (Y.left.presheaf.map i_Z₀.op).hom a₀ := by
      apply AlgebraicGeometry.Scheme.germToFunctionField_injective Y.left W_Y
      rw [map_mul]
      have h1 := congrArg (fun φ => φ.hom b₀) hg_Z₀
      have h2 := congrArg (fun φ => φ.hom s) hg_Z
      have h3 := congrArg (fun φ => φ.hom a₀) hg_Z₀
      dsimp at h1 h2 h3
      rw [h1, h2, h3, h_eq_L]
    have hW'_le : W'_Y' ≤ (TopologicalSpace.Opens.map q'.left.base).obj W_Y :=
      fun _ hx => ⟨hZZ' hx.1, hZ'₀_le_q hx.2⟩
    let j_Z' : W'_Y' ⟶ Z' := CategoryTheory.homOfLE inf_le_left
    let j_Z'₀ : W'_Y' ⟶ Z'₀ := CategoryTheory.homOfLE inf_le_right
    have hg'_Z' : Y'.left.presheaf.map j_Z'.op ≫ Y'.left.germToFunctionField W'_Y' =
        Y'.left.germToFunctionField Z' :=
      TopCat.Presheaf.germ_res Y'.left.presheaf j_Z' _ _
    have hg'_Z'₀ : Y'.left.presheaf.map j_Z'₀.op ≫ Y'.left.germToFunctionField W'_Y' =
        Y'.left.germToFunctionField Z'₀ :=
      TopCat.Presheaf.germ_res Y'.left.presheaf j_Z'₀ _ _
    have h_pull := congrArg (q'.left.appLE W_Y W'_Y' hW'_le).hom h_sec_W
    rw [map_mul] at h_pull
    have hm_Z₀ : ∀ x : B₀,
        (q'.left.appLE W_Y W'_Y' hW'_le).hom ((Y.left.presheaf.map i_Z₀.op).hom x) =
          (Y'.left.presheaf.map j_Z'₀.op).hom (τ₀.hom x) := by
      intro x
      have h_eq_hom : Y.left.presheaf.map i_Z₀.op ≫ q'.left.appLE W_Y W'_Y' hW'_le =
          τ₀ ≫ Y'.left.presheaf.map j_Z'₀.op := by
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      exact congrArg (fun φ => φ.hom x) h_eq_hom
    have hm_Z : (q'.left.appLE W_Y W'_Y' hW'_le).hom ((Y.left.presheaf.map i_Z.op).hom s) =
        (Y'.left.presheaf.map j_Z'.op).hom ((q'.left.appLE Z Z' hZZ').hom s) := by
      have h_eq_hom : Y.left.presheaf.map i_Z.op ≫ q'.left.appLE W_Y W'_Y' hW'_le =
          q'.left.appLE Z Z' hZZ' ≫ Y'.left.presheaf.map j_Z'.op := by
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      exact congrArg (fun φ => φ.hom s) h_eq_hom
    rw [hm_Z₀ b₀, hm_Z, hm_Z₀ a₀] at h_pull
    have h_apply := congrArg (fun z => e_L ((Y'.left.germToFunctionField W'_Y').hom z)) h_pull
    rw [map_mul, map_mul] at h_apply
    have h_g1 := congrArg (fun φ => e_L (φ.hom (τ₀.hom b₀))) hg'_Z'₀
    have h_g2 := congrArg (fun φ => e_L (φ.hom ((q'.left.appLE Z Z' hZZ').hom s))) hg'_Z'
    have h_g3 := congrArg (fun φ => e_L (φ.hom (τ₀.hom a₀))) hg'_Z'₀
    dsimp at h_g1 h_g2 h_g3
    rw [h_g1, h_g2, h_g3, he_L_Z₀ b₀, he_L_Z₀ a₀, ← h_eq_L] at h_apply
    exact mul_left_cancel₀ hgb₀_ne h_apply

  
  let α_S : U'.toScheme ⟶ S'.left := π_inv ≫ V'.ι
  haveI : CategoryTheory.IsIso π_inv := by dsimp [π_inv]; infer_instance
  haveI : AlgebraicGeometry.IsOpenImmersion α_S := by dsimp [α_S]; infer_instance
  obtain ⟨U₁, hAffU₁_raw, hw₀_U₁, hU₁_le⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.left.isBasis_affineOpens w₀.2
  let U₁ : S.left.Opens := U₁
  have hAffU₁ : AlgebraicGeometry.IsAffineOpen U₁ := hAffU₁_raw
  have hRange_U₁ : Set.range hAffU₁.fromSpec.base ⊆ Set.range U'.ι.base := by
    rw [hAffU₁.range_fromSpec, U'.range_ι]; exact hU₁_le
  let ℓ_S : AlgebraicGeometry.Spec (S.left.presheaf.obj (Opposite.op U₁)) ⟶ U'.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U'.ι hAffU₁.fromSpec hRange_U₁
  have hℓS_fac : ℓ_S ≫ U'.ι = hAffU₁.fromSpec :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U'.ι hAffU₁.fromSpec hRange_U₁
  haveI : AlgebraicGeometry.IsOpenImmersion ℓ_S := by
    haveI : AlgebraicGeometry.IsOpenImmersion (ℓ_S ≫ U'.ι) := by
      rw [hℓS_fac]; infer_instance
    exact AlgebraicGeometry.IsOpenImmersion.of_comp ℓ_S U'.ι
  let β_S : AlgebraicGeometry.Spec (S.left.presheaf.obj (Opposite.op U₁)) ⟶ S'.left := ℓ_S ≫ α_S
  haveI : AlgebraicGeometry.IsOpenImmersion β_S := by dsimp [β_S]; infer_instance
  have hβS_π : β_S ≫ π.left = hAffU₁.fromSpec := by
    dsimp [β_S, α_S]
    rw [CategoryTheory.Category.assoc, hπ_inv_ι, hℓS_fac]
  let V'₁ : S'.left.Opens := β_S.opensRange
  have hAffV'₁ : AlgebraicGeometry.IsAffineOpen V'₁ :=
    AlgebraicGeometry.isAffineOpen_opensRange β_S
  have hNeU₁ : Nonempty U₁ := ⟨⟨w₀.1, hw₀_U₁⟩⟩
  obtain ⟨x_U₁, hx_U₁⟩ : w₀.1 ∈ Set.range hAffU₁.fromSpec.base := by
    rw [hAffU₁.range_fromSpec]; exact hw₀_U₁
  have hNeV'₁ : Nonempty V'₁ := ⟨⟨β_S.base x_U₁, ⟨x_U₁, rfl⟩⟩⟩
  have hV'₁_le_π : V'₁ ≤ (TopologicalSpace.Opens.map π.left.base).obj U₁ := by
    rintro s' ⟨x, rfl⟩
    change (β_S ≫ π.left).base x ∈ U₁
    rw [hβS_π]
    have hx_mem : hAffU₁.fromSpec.base x ∈ Set.range hAffU₁.fromSpec.base := ⟨x, rfl⟩
    rwa [hAffU₁.range_fromSpec] at hx_mem
  have hRange_βS : Set.range β_S.base = Set.range hAffV'₁.fromSpec.base := by
    rw [hAffV'₁.range_fromSpec]; rfl
  let ε_S := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq β_S hAffV'₁.fromSpec hRange_βS
  let π₁ := π.left.appLE U₁ V'₁ hV'₁_le_π
  have hSpec_π₁ : AlgebraicGeometry.Spec.map π₁ = ε_S.inv := by
    rw [← CategoryTheory.cancel_mono hAffU₁.fromSpec]
    rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π.left hAffU₁ hAffV'₁ hV'₁_le_π,
      ← hβS_π, ← AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac β_S hAffV'₁.fromSpec hRange_βS,
      CategoryTheory.Category.assoc]
  have : CategoryTheory.IsIso (AlgebraicGeometry.Scheme.Spec.map π₁.op) := by
    change CategoryTheory.IsIso (AlgebraicGeometry.Spec.map π₁)
    rw [hSpec_π₁]; infer_instance
  have : CategoryTheory.IsIso π₁.op :=
    AlgebraicGeometry.Spec.fullyFaithful.isIso_of_isIso_map π₁.op
  have : CategoryTheory.IsIso π₁ := CategoryTheory.isIso_of_op π₁

  let Z'₁ : Y'.left.Opens := (TopologicalSpace.Opens.map f'.left.base).obj V'₁
  have hNeZ'₁ : Nonempty Z'₁ := by
    have hαY_f : α_Y ≫ f'.left = (p.left ∣_ U') ≫ α_S := by
      change (s_pb ≫ j.toImage) ≫ (ι_Y' ≫ snd_P) = (p.left ∣_ U') ≫ (π_inv ≫ V'.ι)
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j.toImage,
        AlgebraicGeometry.Scheme.Hom.toImage_imageι j, ← CategoryTheory.Category.assoc, hs_snd]
      dsimp [q_open, g_U]
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
    have hℓ_x : ℓ_S.base x_U₁ = w₀ := by
      apply U'.ι.isOpenEmbedding.injective
      change (ℓ_S ≫ U'.ι).base x_U₁ = U'.ι.base w₀
      rw [hℓS_fac, hx_U₁]
      rfl
    refine ⟨⟨α_Y.base u₀, ?_⟩⟩
    change (α_Y ≫ f'.left).base u₀ ∈ V'₁
    rw [hαY_f]
    change α_S.base ((p.left ∣_ U').base u₀) ∈ V'₁
    rw [hu₀_w₀, ← hℓ_x]
    exact ⟨x_U₁, rfl⟩

  have heL_f : ∀ (V₀ : S'.left.Opens) [Nonempty V₀] (Z' : Y'.left.Opens) [Nonempty Z']
      (hZV₀ : Z' ≤ (TopologicalSpace.Opens.map f'.left.base).obj V₀),
      (e_L.comp (Y'.left.germToFunctionField Z').hom).comp (f'.left.appLE V₀ Z' hZV₀).hom =
        φ_KL.comp (e_K.comp (S'.left.germToFunctionField V₀).hom) := by
    intro V₀ hNeV₀ Z' hNeZ' hZV₀
    ext a
    let A₁ : Type u := ↑(S.left.presheaf.obj (Opposite.op U₁))
    let A'₁ : Type u := ↑(S'.left.presheaf.obj (Opposite.op V'₁))
    have : IsDomain A₁ := AlgebraicGeometry.IsIntegral.component_integral U₁
    have : IsDomain A'₁ := AlgebraicGeometry.IsIntegral.component_integral V'₁
    have : IsFractionRing A'₁ ↑S'.left.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen S'.left V'₁ hAffV'₁
    obtain ⟨x', y', hy'_nzd, hdiv'⟩ :=
      IsFractionRing.div_surjective (A := A'₁) ((S'.left.germToFunctionField V₀).hom a)
    have hy'_ne : y' ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hy'_nzd
    have hgy'_ne : (S'.left.germToFunctionField V'₁).hom y' ≠ 0 := by
      intro h0
      exact hy'_ne (AlgebraicGeometry.Scheme.germToFunctionField_injective S'.left V'₁
        (by simpa using h0))
    let r₁ : A₁ := (CategoryTheory.inv π₁).hom x'
    let s₁ : A₁ := (CategoryTheory.inv π₁).hom y'
    have hπ₁_r₁ : π₁.hom r₁ = x' := by
      change (CategoryTheory.inv π₁ ≫ π₁).hom x' = x'
      rw [CategoryTheory.IsIso.inv_hom_id]; rfl
    have hπ₁_s₁ : π₁.hom s₁ = y' := by
      change (CategoryTheory.inv π₁ ≫ π₁).hom y' = y'
      rw [CategoryTheory.IsIso.inv_hom_id]; rfl
    have hs₁_ne : s₁ ≠ 0 := by
      intro h0
      apply hy'_ne
      rw [← hπ₁_s₁, h0, map_zero]
    have h_eq_K' : (S'.left.germToFunctionField V'₁).hom (π₁.hom s₁) *
        (S'.left.germToFunctionField V₀).hom a =
        (S'.left.germToFunctionField V'₁).hom (π₁.hom r₁) := by
      have h_alg_x : algebraMap A'₁ ↑S'.left.functionField x' =
          (S'.left.germToFunctionField V'₁).hom x' := rfl
      have h_alg_y : algebraMap A'₁ ↑S'.left.functionField y' =
          (S'.left.germToFunctionField V'₁).hom y' := rfl
      rw [h_alg_x, h_alg_y] at hdiv'
      rw [hπ₁_s₁, hπ₁_r₁, mul_comm]
      exact ((div_eq_iff hgy'_ne).mp hdiv').symm
    have heK_U₁ : ∀ t : A₁,
        e_K ((S'.left.germToFunctionField V'₁).hom (π₁.hom t)) =
          (S.left.germToFunctionField U₁).hom t := by
      intro t
      exact congrArg (fun φ => φ t) (heK_compat U₁ V'₁ hV'₁_le_π)
    have h_rhs_mul : φ_KL ((S.left.germToFunctionField U₁).hom s₁) *
        φ_KL (e_K ((S'.left.germToFunctionField V₀).hom a)) =
        φ_KL ((S.left.germToFunctionField U₁).hom r₁) := by
      have h_app := congrArg (fun z => φ_KL (e_K z)) h_eq_K'
      rw [map_mul, map_mul, heK_U₁ s₁, heK_U₁ r₁] at h_app
      exact h_app
    let W_S' : S'.left.Opens := V₀ ⊓ V'₁
    let W_tilde : Y'.left.Opens := Z' ⊓ Z'₁
    have : Nonempty W_S' := hInterNe V₀ V'₁
    have : Nonempty W_tilde := hInterNe Z' Z'₁
    let i_V₀ : W_S' ⟶ V₀ := CategoryTheory.homOfLE inf_le_left
    let i_V'₁ : W_S' ⟶ V'₁ := CategoryTheory.homOfLE inf_le_right
    have hg_V₀ : S'.left.presheaf.map i_V₀.op ≫ S'.left.germToFunctionField W_S' =
        S'.left.germToFunctionField V₀ :=
      TopCat.Presheaf.germ_res S'.left.presheaf i_V₀ _ _
    have hg_V'₁ : S'.left.presheaf.map i_V'₁.op ≫ S'.left.germToFunctionField W_S' =
        S'.left.germToFunctionField V'₁ :=
      TopCat.Presheaf.germ_res S'.left.presheaf i_V'₁ _ _
    have h_sec_S' : (S'.left.presheaf.map i_V'₁.op).hom (π₁.hom s₁) *
        (S'.left.presheaf.map i_V₀.op).hom a =
        (S'.left.presheaf.map i_V'₁.op).hom (π₁.hom r₁) := by
      apply AlgebraicGeometry.Scheme.germToFunctionField_injective S'.left W_S'
      rw [map_mul]
      have h1 := congrArg (fun φ => φ.hom (π₁.hom s₁)) hg_V'₁
      have h2 := congrArg (fun φ => φ.hom a) hg_V₀
      have h3 := congrArg (fun φ => φ.hom (π₁.hom r₁)) hg_V'₁
      dsimp at h1 h2 h3
      rw [h1, h2, h3, h_eq_K']
    have hWtilde_le : W_tilde ≤ (TopologicalSpace.Opens.map f'.left.base).obj W_S' :=
      fun _ hx => ⟨hZV₀ hx.1, hx.2⟩
    let j_Z' : W_tilde ⟶ Z' := CategoryTheory.homOfLE inf_le_left
    let j_Z'₁ : W_tilde ⟶ Z'₁ := CategoryTheory.homOfLE inf_le_right
    have hg'_Z' : Y'.left.presheaf.map j_Z'.op ≫ Y'.left.germToFunctionField W_tilde =
        Y'.left.germToFunctionField Z' :=
      TopCat.Presheaf.germ_res Y'.left.presheaf j_Z' _ _
    have hg'_Z'₁ : Y'.left.presheaf.map j_Z'₁.op ≫ Y'.left.germToFunctionField W_tilde =
        Y'.left.germToFunctionField Z'₁ :=
      TopCat.Presheaf.germ_res Y'.left.presheaf j_Z'₁ _ _
    have h_pull := congrArg (f'.left.appLE W_S' W_tilde hWtilde_le).hom h_sec_S'
    rw [map_mul] at h_pull
    have hm_V'₁ : ∀ x : A'₁,
        (f'.left.appLE W_S' W_tilde hWtilde_le).hom ((S'.left.presheaf.map i_V'₁.op).hom x) =
          (Y'.left.presheaf.map j_Z'₁.op).hom ((f'.left.appLE V'₁ Z'₁ le_rfl).hom x) := by
      intro x
      have h_eq_hom : S'.left.presheaf.map i_V'₁.op ≫ f'.left.appLE W_S' W_tilde hWtilde_le =
          f'.left.appLE V'₁ Z'₁ le_rfl ≫ Y'.left.presheaf.map j_Z'₁.op := by
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      exact congrArg (fun φ => φ.hom x) h_eq_hom
    have hm_V₀ : (f'.left.appLE W_S' W_tilde hWtilde_le).hom ((S'.left.presheaf.map i_V₀.op).hom a) =
        (Y'.left.presheaf.map j_Z'.op).hom ((f'.left.appLE V₀ Z' hZV₀).hom a) := by
      have h_eq_hom : S'.left.presheaf.map i_V₀.op ≫ f'.left.appLE W_S' W_tilde hWtilde_le =
          f'.left.appLE V₀ Z' hZV₀ ≫ Y'.left.presheaf.map j_Z'.op := by
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      exact congrArg (fun φ => φ.hom a) h_eq_hom
    rw [hm_V'₁ (π₁.hom s₁), hm_V₀, hm_V'₁ (π₁.hom r₁)] at h_pull
    let W_pU₁ : Y.left.Opens := (TopologicalSpace.Opens.map p.left.base).obj U₁
    have hZ'₁_le_qp : Z'₁ ≤ (TopologicalSpace.Opens.map (q'.left ≫ p.left).base).obj U₁ := by
      intro y' hy'
      have hy'_fπ : (f'.left ≫ π.left).base y' ∈ U₁ := hV'₁_le_π hy'
      rwa [← hcomm] at hy'_fπ
    have hNeWpU₁ : Nonempty W_pU₁ := by
      obtain ⟨⟨y', hy'⟩⟩ := hNeZ'₁
      exact ⟨⟨q'.left.base y', hZ'₁_le_qp hy'⟩⟩
    have h_eval_Z'₁ : ∀ t : A₁,
        e_L ((Y'.left.germToFunctionField Z'₁).hom
          ((f'.left.appLE V'₁ Z'₁ le_rfl).hom (π₁.hom t))) =
          φ_KL ((S.left.germToFunctionField U₁).hom t) := by
      intro t
      have h_comp1 : π₁ ≫ f'.left.appLE V'₁ Z'₁ le_rfl =
          (f'.left ≫ π.left).appLE U₁ Z'₁ (fun _ hx => hV'₁_le_π hx) :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE f'.left π.left U₁ V'₁ Z'₁ hV'₁_le_π le_rfl
      have h_congr : (f'.left ≫ π.left).appLE U₁ Z'₁ (fun _ hx => hV'₁_le_π hx) =
          (q'.left ≫ p.left).appLE U₁ Z'₁ hZ'₁_le_qp :=
        AlgebraicGeometry.Scheme.Hom.appLE.congr_simp (f'.left ≫ π.left) (q'.left ≫ p.left)
          hcomm.symm U₁ Z'₁ (fun _ hx => hV'₁_le_π hx)
      have h_comp2 : p.left.appLE U₁ W_pU₁ le_rfl ≫ q'.left.appLE W_pU₁ Z'₁ hZ'₁_le_qp =
          (q'.left ≫ p.left).appLE U₁ Z'₁ hZ'₁_le_qp :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE q'.left p.left U₁ W_pU₁ Z'₁ le_rfl hZ'₁_le_qp
      have ht_eq : (f'.left.appLE V'₁ Z'₁ le_rfl).hom (π₁.hom t) =
          (q'.left.appLE W_pU₁ Z'₁ hZ'₁_le_qp).hom ((p.left.appLE U₁ W_pU₁ le_rfl).hom t) :=
        congrArg (fun φ => φ.hom t) ((h_comp1.trans h_congr).trans h_comp2.symm)
      rw [ht_eq]
      have hq_eval := congrArg (fun φ => φ ((p.left.appLE U₁ W_pU₁ le_rfl).hom t))
        (heL_q W_pU₁ Z'₁ hZ'₁_le_qp)
      dsimp at hq_eval
      rw [hq_eval]
      have hp_eval := congrArg (fun φ => φ t) (hφ_compat U₁ W_pU₁ le_rfl)
      exact hp_eval
    have h_apply := congrArg (fun z => e_L ((Y'.left.germToFunctionField W_tilde).hom z)) h_pull
    rw [map_mul, map_mul] at h_apply
    have h_g1 := congrArg (fun φ => e_L (φ.hom ((f'.left.appLE V'₁ Z'₁ le_rfl).hom (π₁.hom s₁)))) hg'_Z'₁
    have h_g2 := congrArg (fun φ => e_L (φ.hom ((f'.left.appLE V₀ Z' hZV₀).hom a))) hg'_Z'
    have h_g3 := congrArg (fun φ => e_L (φ.hom ((f'.left.appLE V'₁ Z'₁ le_rfl).hom (π₁.hom r₁)))) hg'_Z'₁
    dsimp at h_g1 h_g2 h_g3
    rw [h_g1, h_g2, h_g3, h_eval_Z'₁ s₁, h_eval_Z'₁ r₁, ← h_rhs_mul] at h_apply
    have hgs₁_ne : (S.left.germToFunctionField U₁).hom s₁ ≠ 0 := by
      intro h0
      exact hs₁_ne (AlgebraicGeometry.Scheme.germToFunctionField_injective S.left U₁
        (by simpa using h0))
    have hφs₁_ne : φ_KL ((S.left.germToFunctionField U₁).hom s₁) ≠ 0 := by
      intro h0
      exact hgs₁_ne (φ_KL.injective (by simpa using h0))
    exact mul_left_cancel₀ hφs₁_ne h_apply

  
  
  
  let P_N := weilProjectiveSpaceOver k N
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P_YS' := CategoryTheory.Limits.pullback Y.hom S'.hom
  let fst_YS' := CategoryTheory.Limits.pullback.fst Y.hom S'.hom
  let snd_YS' := CategoryTheory.Limits.pullback.snd Y.hom S'.hom
  let P_amb := CategoryTheory.Limits.pullback P_N.hom S'.hom
  let pr₁ := CategoryTheory.Limits.pullback.fst P_N.hom S'.hom
  let pr₂ := CategoryTheory.Limits.pullback.snd P_N.hom S'.hom

  haveI : AlgebraicGeometry.IsSeparated S.hom := by
    obtain ⟨M_S, ι_S, hClS⟩ := hProjS
    haveI : AlgebraicGeometry.IsClosedImmersion ι_S.left := hClS
    let 𝒜_S := MvPolynomial.homogeneousSubmodule (Fin (M_S + 1)) k
    letI : GradedAlgebra 𝒜_S := MvPolynomial.gradedAlgebra
    haveI : AlgebraicGeometry.IsSeparated (AlgebraicGeometry.Proj.toSpecZero 𝒜_S) :=
      AlgebraicGeometry.Proj.isSeparated 𝒜_S
    haveI : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k M_S).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    rw [← CategoryTheory.Over.w ι_S]
    infer_instance

  let δ_raw := CategoryTheory.Limits.pullback.mapDesc p.left π.left S.hom
  let e_congr := CategoryTheory.Limits.pullback.congrHom
    (CategoryTheory.Over.w p) (CategoryTheory.Over.w π)
  let δ_Y : P_sch ⟶ P_YS' := δ_raw ≫ e_congr.hom
  haveI : AlgebraicGeometry.IsClosedImmersion δ_Y := by
    dsimp [δ_Y, δ_raw]
    infer_instance

  let m_Y : P_YS' ⟶ P_amb :=
    CategoryTheory.Limits.pullback.lift (fst_YS' ≫ ι_Y.left) snd_YS'
      (by rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_Y,
            CategoryTheory.Limits.pullback.condition])
  have hPb_mY : CategoryTheory.IsPullback fst_YS' m_Y ι_Y.left pr₁ := by
    refine CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      (CategoryTheory.IsPullback.of_hasPullback P_N.hom S'.hom)
    rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Over.w ι_Y]
    exact CategoryTheory.IsPullback.of_hasPullback Y.hom S'.hom
  haveI : AlgebraicGeometry.IsClosedImmersion ι_Y.left := hClY
  haveI : AlgebraicGeometry.IsClosedImmersion m_Y :=
    CategoryTheory.MorphismProperty.of_isPullback hPb_mY hClY

  let ι_tot : Y'.left ⟶ P_amb := ι_Y' ≫ δ_Y ≫ m_Y
  haveI : AlgebraicGeometry.IsClosedImmersion ι_tot := by
    dsimp [ι_tot]
    infer_instance
  have hι_pr₁ : ι_tot ≫ pr₁ = q'.left ≫ ι_Y.left := by
    change (ι_Y' ≫ (δ_raw ≫ e_congr.hom) ≫ m_Y) ≫ pr₁ = (ι_Y' ≫ fst_P) ≫ ι_Y.left
    have hm : m_Y ≫ pr₁ = fst_YS' ≫ ι_Y.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hc : e_congr.hom ≫ fst_YS' =
        CategoryTheory.Limits.pullback.fst (p.left ≫ S.hom) (π.left ≫ S.hom) := by
      dsimp [e_congr, fst_YS', CategoryTheory.Limits.pullback.congrHom,
        CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    have hd : δ_raw ≫ CategoryTheory.Limits.pullback.fst (p.left ≫ S.hom) (π.left ≫ S.hom) =
        fst_P := by
      dsimp [δ_raw, fst_P, CategoryTheory.Limits.pullback.mapDesc]
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    calc (ι_Y' ≫ (δ_raw ≫ e_congr.hom) ≫ m_Y) ≫ pr₁
        = ι_Y' ≫ δ_raw ≫ e_congr.hom ≫ (m_Y ≫ pr₁) := by
            simp only [CategoryTheory.Category.assoc]
      _ = ι_Y' ≫ δ_raw ≫ (e_congr.hom ≫ fst_YS') ≫ ι_Y.left := by
            rw [hm, ← CategoryTheory.Category.assoc e_congr.hom]
      _ = ι_Y' ≫ (δ_raw ≫ CategoryTheory.Limits.pullback.fst (p.left ≫ S.hom) (π.left ≫ S.hom)) ≫ ι_Y.left := by
            rw [hc, ← CategoryTheory.Category.assoc δ_raw]
      _ = (ι_Y' ≫ fst_P) ≫ ι_Y.left := by
            rw [hd, CategoryTheory.Category.assoc]
  have hι_pr₂ : ι_tot ≫ pr₂ = f'.left := by
    change (ι_Y' ≫ (δ_raw ≫ e_congr.hom) ≫ m_Y) ≫ pr₂ = ι_Y' ≫ snd_P
    have hm : m_Y ≫ pr₂ = snd_YS' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hc : e_congr.hom ≫ snd_YS' =
        CategoryTheory.Limits.pullback.snd (p.left ≫ S.hom) (π.left ≫ S.hom) := by
      dsimp [e_congr, snd_YS', CategoryTheory.Limits.pullback.congrHom,
        CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have hd : δ_raw ≫ CategoryTheory.Limits.pullback.snd (p.left ≫ S.hom) (π.left ≫ S.hom) =
        snd_P := by
      dsimp [δ_raw, snd_P, CategoryTheory.Limits.pullback.mapDesc]
      exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    calc (ι_Y' ≫ (δ_raw ≫ e_congr.hom) ≫ m_Y) ≫ pr₂
        = ι_Y' ≫ δ_raw ≫ e_congr.hom ≫ (m_Y ≫ pr₂) := by
            simp only [CategoryTheory.Category.assoc]
      _ = ι_Y' ≫ δ_raw ≫ (e_congr.hom ≫ snd_YS') := by rw [hm]
      _ = ι_Y' ≫ (δ_raw ≫ CategoryTheory.Limits.pullback.snd (p.left ≫ S.hom) (π.left ≫ S.hom)) := by
            rw [hc]
      _ = ι_Y' ≫ snd_P := by rw [hd]

  have hFromSpec_over_k :
      ∀ (X : CategoryTheory.Over S_k) (U : X.left.Opens)
        (hAffU : AlgebraicGeometry.IsAffineOpen U),
        let R_U : Type u := ↑(X.left.presheaf.obj (Opposite.op U))
        letI : Algebra k R_U :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (X.hom.appLE ⊤ U le_top)).hom).toAlgebra
        hAffU.fromSpec ≫ X.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_U)) := by
    intro X U hAffU
    dsimp only
    rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec X.hom
          (AlgebraicGeometry.isAffineOpen_top S_k) hAffU le_top,
        AlgebraicGeometry.IsAffineOpen.fromSpec_top,
        AlgebraicGeometry.Scheme.isoSpec_Spec_inv,
        ← AlgebraicGeometry.Spec.map_comp]
    rfl

  have hProdChart :
      ∀ (P_0 : CategoryTheory.Over S_k)
        (g_P : Y'.left ⟶ P_0.left)
        (D : P_0.left.Opens) (hAffD₀ : AlgebraicGeometry.IsAffineOpen D)
        (U_0 : S'.left.Opens) (hAffU₀ : AlgebraicGeometry.IsAffineOpen U_0)
        (ι_0 : Y'.left ⟶ CategoryTheory.Limits.pullback P_0.hom S'.hom)
        [AlgebraicGeometry.IsClosedImmersion ι_0]
        (_ : ι_0 ≫ CategoryTheory.Limits.pullback.fst P_0.hom S'.hom = g_P)
        (_ : ι_0 ≫ CategoryTheory.Limits.pullback.snd P_0.hom S'.hom = f'.left),
        let O_tilde₀ : Y'.left.Opens :=
          (TopologicalSpace.Opens.map g_P.base).obj D ⊓
            (TopologicalSpace.Opens.map f'.left.base).obj U_0
        let R_D : Type u := ↑(P_0.left.presheaf.obj (Opposite.op D))
        let A : Type u := ↑(S'.left.presheaf.obj (Opposite.op U_0))
        letI : Algebra k R_D :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (P_0.hom.appLE ⊤ D le_top)).hom).toAlgebra
        letI : Algebra k A :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (S'.hom.appLE ⊤ U_0 le_top)).hom).toAlgebra
        AlgebraicGeometry.IsAffineOpen O_tilde₀ ∧
        ∃ (σ : TensorProduct k R_D A →+* ↑(Y'.left.presheaf.obj (Opposite.op O_tilde₀))),
          Function.Surjective σ ∧
          (∀ r : R_D, σ (r ⊗ₜ[k] 1) = (g_P.appLE D O_tilde₀ inf_le_left).hom r) ∧
          (∀ a : A, σ (1 ⊗ₜ[k] a) = (f'.left.appLE U_0 O_tilde₀ inf_le_right).hom a) := by
    intro P_0 g_P D hAffD₀ U_0 hAffU₀ ι_0 _ hι0_1 hι0_2
    let P_amb₀ := CategoryTheory.Limits.pullback P_0.hom S'.hom
    let pr₁_0 := CategoryTheory.Limits.pullback.fst P_0.hom S'.hom
    let pr₂_0 := CategoryTheory.Limits.pullback.snd P_0.hom S'.hom
    let O_tilde₀ : Y'.left.Opens :=
      (TopologicalSpace.Opens.map g_P.base).obj D ⊓
        (TopologicalSpace.Opens.map f'.left.base).obj U_0
    let R_D : Type u := ↑(P_0.left.presheaf.obj (Opposite.op D))
    let A : Type u := ↑(S'.left.presheaf.obj (Opposite.op U_0))
    letI : Algebra k R_D :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        (P_0.hom.appLE ⊤ D le_top)).hom).toAlgebra
    letI : Algebra k A :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        (S'.hom.appLE ⊤ U_0 le_top)).hom).toAlgebra
    have hf_D : hAffD₀.fromSpec ≫ P_0.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_D)) :=
      hFromSpec_over_k P_0 D hAffD₀
    have hf_A : hAffU₀.fromSpec ≫ S'.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) :=
      hFromSpec_over_k S' U_0 hAffU₀
    let f_alg_D := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_D))
    let f_alg_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
    let m_DA : CategoryTheory.Limits.pullback f_alg_D f_alg_A ⟶ P_amb₀ :=
      CategoryTheory.Limits.pullback.map f_alg_D f_alg_A P_0.hom S'.hom
        hAffD₀.fromSpec hAffU₀.fromSpec (𝟙 S_k)
        (by rw [CategoryTheory.Category.comp_id, hf_D])
        (by rw [CategoryTheory.Category.comp_id, hf_A])
    have : AlgebraicGeometry.IsOpenImmersion m_DA :=
      AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion _ _ _ _ _ _ _ _ _
    let ψ_DA : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k R_D A)) ⟶ P_amb₀ :=
      (AlgebraicGeometry.pullbackSpecIso k R_D A).inv ≫ m_DA
    have : AlgebraicGeometry.IsOpenImmersion ψ_DA := by
      dsimp [ψ_DA]; infer_instance
    have hψ_pr₁ : ψ_DA ≫ pr₁_0 =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
          hAffD₀.fromSpec := by
      dsimp [ψ_DA, m_DA, pr₁_0, CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst]
    have hψ_pr₂ : ψ_DA ≫ pr₂_0 =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
          hAffU₀.fromSpec := by
      dsimp [ψ_DA, m_DA, pr₂_0, CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd]

    let O_DA : P_amb₀.Opens := ψ_DA.opensRange
    have hAffO : AlgebraicGeometry.IsAffineOpen O_DA :=
      AlgebraicGeometry.isAffineOpen_opensRange ψ_DA
    have hODA_carrier : ∀ z : ↥P_amb₀,
        z ∈ O_DA ↔ pr₁_0.base z ∈ D ∧ pr₂_0.base z ∈ U_0 := by
      intro z
      constructor
      · rintro ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · change (ψ_DA ≫ pr₁_0).base x ∈ D
          rw [hψ_pr₁]
          have hx : hAffD₀.fromSpec.base
              ((AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)).base x) ∈
              Set.range hAffD₀.fromSpec.base := ⟨_, rfl⟩
          rwa [hAffD₀.range_fromSpec] at hx
        · change (ψ_DA ≫ pr₂_0).base x ∈ U_0
          rw [hψ_pr₂]
          have hx : hAffU₀.fromSpec.base
              ((AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)).base x) ∈
              Set.range hAffU₀.fromSpec.base := ⟨_, rfl⟩
          rwa [hAffU₀.range_fromSpec] at hx
      · rintro ⟨hzD, hzA⟩
        let ξ_z := P_amb₀.fromSpecResidueField z
        have hRange_ξD : Set.range (ξ_z ≫ pr₁_0).base ⊆ Set.range hAffD₀.fromSpec.base := by
          rw [hAffD₀.range_fromSpec]
          rintro _ ⟨q, rfl⟩
          change pr₁_0.base (ξ_z.base q) ∈ D
          rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply z q]
          exact hzD
        have hRange_ξA : Set.range (ξ_z ≫ pr₂_0).base ⊆ Set.range hAffU₀.fromSpec.base := by
          rw [hAffU₀.range_fromSpec]
          rintro _ ⟨q, rfl⟩
          change pr₂_0.base (ξ_z.base q) ∈ U_0
          rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply z q]
          exact hzA
        let ℓ₁ := AlgebraicGeometry.IsOpenImmersion.lift hAffD₀.fromSpec (ξ_z ≫ pr₁_0) hRange_ξD
        let ℓ₂ := AlgebraicGeometry.IsOpenImmersion.lift hAffU₀.fromSpec (ξ_z ≫ pr₂_0) hRange_ξA
        have hℓ₁ : ℓ₁ ≫ hAffD₀.fromSpec = ξ_z ≫ pr₁_0 :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
        have hℓ₂ : ℓ₂ ≫ hAffU₀.fromSpec = ξ_z ≫ pr₂_0 :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
        have hℓ_comm : ℓ₁ ≫ f_alg_D = ℓ₂ ≫ f_alg_A := by
          dsimp [f_alg_D, f_alg_A]
          rw [← hf_D, ← hf_A, ← CategoryTheory.Category.assoc, hℓ₁,
            ← CategoryTheory.Category.assoc, hℓ₂,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc]
        let ξ_pb := CategoryTheory.Limits.pullback.lift ℓ₁ ℓ₂ hℓ_comm
        have hξ_m : ξ_pb ≫ m_DA = ξ_z := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp [m_DA, ξ_pb, pr₁_0, CategoryTheory.Limits.pullback.map]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hℓ₁]
          · dsimp [m_DA, ξ_pb, pr₂_0, CategoryTheory.Limits.pullback.map]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hℓ₂]
        let ξ_spec := ξ_pb ≫ (AlgebraicGeometry.pullbackSpecIso k R_D A).hom
        have hξ_ψ : ξ_spec ≫ ψ_DA = ξ_z := by
          dsimp [ξ_spec, ψ_DA]
          rw [CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso k R_D A).hom,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp, hξ_m]
        let s₀ : ↥(AlgebraicGeometry.Spec (P_amb₀.residueField z)) :=
          (⊥ : PrimeSpectrum ↑(P_amb₀.residueField z))
        refine ⟨ξ_spec.base s₀, ?_⟩
        change (ξ_spec ≫ ψ_DA).base s₀ = z
        rw [hξ_ψ]
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply z s₀

    have hPre_ODA : (TopologicalSpace.Opens.map ι_0.base).obj O_DA = O_tilde₀ := by
      ext y'
      change ι_0.base y' ∈ O_DA ↔ _
      rw [hODA_carrier (ι_0.base y')]
      have h1 : pr₁_0.base (ι_0.base y') = g_P.base y' := by
        change (ι_0 ≫ pr₁_0).base y' = _
        rw [hι0_1]
      have h2 : pr₂_0.base (ι_0.base y') = f'.left.base y' := by
        change (ι_0 ≫ pr₂_0).base y' = _
        rw [hι0_2]
      rw [h1, h2]
      rfl

    have hAffOtilde : AlgebraicGeometry.IsAffineOpen O_tilde₀ := by
      rw [← hPre_ODA]
      exact hAffO.preimage ι_0
    have hO_le_pre : O_tilde₀ ≤ (TopologicalSpace.Opens.map ι_0.base).obj O_DA :=
      hPre_ODA.symm.le
    have hRange_ψ : Set.range ψ_DA.base = Set.range hAffO.fromSpec.base := by
      rw [hAffO.range_fromSpec]; rfl
    let ε_DA := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ψ_DA hAffO.fromSpec hRange_ψ
    let e_ring_iso := (AlgebraicGeometry.Spec.fullyFaithful.preimageIso ε_DA.symm).unop
    let e_ring := e_ring_iso.hom
    have hSpec_ering : AlgebraicGeometry.Spec.map e_ring = ε_DA.inv :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage ε_DA.inv
    let σ_cat := e_ring ≫ ι_0.appLE O_DA O_tilde₀ hO_le_pre
    let σ : TensorProduct k R_D A →+* ↑(Y'.left.presheaf.obj (Opposite.op O_tilde₀)) :=
      σ_cat.hom
    have hSurj_σ : Function.Surjective σ := by
      have : CategoryTheory.IsIso e_ring := inferInstance
      have hSurj_e : Function.Surjective e_ring.hom :=
        (ConcreteCategory.bijective_of_isIso e_ring).2
      have hSurj_app : Function.Surjective (ι_0.app O_DA).hom :=
        AlgebraicGeometry.Scheme.Hom.app_surjective ι_0 O_DA hAffO
      have : CategoryTheory.IsIso (CategoryTheory.homOfLE hO_le_pre) := by
        have h_eq : CategoryTheory.homOfLE hO_le_pre = eqToHom hPre_ODA.symm := rfl
        rw [h_eq]; infer_instance
      have hSurj_res : Function.Surjective
          (Y'.left.presheaf.map (CategoryTheory.homOfLE hO_le_pre).op).hom :=
        (ConcreteCategory.bijective_of_isIso
          (Y'.left.presheaf.map (CategoryTheory.homOfLE hO_le_pre).op)).2
      have h_appLE_def : ι_0.appLE O_DA O_tilde₀ hO_le_pre =
          ι_0.app O_DA ≫ Y'.left.presheaf.map (CategoryTheory.homOfLE hO_le_pre).op := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      change Function.Surjective (e_ring ≫ ι_0.appLE O_DA O_tilde₀ hO_le_pre).hom
      rw [h_appLE_def]
      exact hSurj_res.comp (hSurj_app.comp hSurj_e)

    have hSpec_σ : AlgebraicGeometry.Spec.map σ_cat ≫ ψ_DA =
        hAffOtilde.fromSpec ≫ ι_0 := by
      dsimp [σ_cat]
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hSpec_ering,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac ψ_DA hAffO.fromSpec hRange_ψ,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_0 hAffO hAffOtilde hO_le_pre]
    have hσL : ∀ r : R_D,
        σ (r ⊗ₜ[k] 1) = (g_P.appLE D O_tilde₀ inf_le_left).hom r := by
      have h_eq1 : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ σ_cat) ≫
            hAffD₀.fromSpec =
          AlgebraicGeometry.Spec.map (g_P.appLE D O_tilde₀ inf_le_left) ≫
            hAffD₀.fromSpec := by
        calc AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ σ_cat) ≫
              hAffD₀.fromSpec
            = AlgebraicGeometry.Spec.map σ_cat ≫
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
                  hAffD₀.fromSpec) := by
                rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Spec.map σ_cat ≫ ψ_DA) ≫ pr₁_0 := by
                rw [← hψ_pr₁]
                simp only [ψ_DA, CategoryTheory.Category.assoc]
          _ = hAffOtilde.fromSpec ≫ (ι_0 ≫ pr₁_0) := by
                rw [hSpec_σ, CategoryTheory.Category.assoc]
          _ = hAffOtilde.fromSpec ≫ g_P := by rw [hι0_1]
          _ = AlgebraicGeometry.Spec.map (g_P.appLE D O_tilde₀ inf_le_left) ≫
                hAffD₀.fromSpec :=
                (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
                  g_P hAffD₀ hAffOtilde inf_le_left).symm
      have h_cat : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ σ_cat =
          g_P.appLE D O_tilde₀ inf_le_left :=
        Quiver.Hom.op_inj (AlgebraicGeometry.Spec.fullyFaithful.map_injective
          ((CategoryTheory.cancel_mono hAffD₀.fromSpec).mp h_eq1))
      intro r
      exact congrArg (fun φ => φ.hom r) h_cat
    have hσR : ∀ a : A,
        σ (1 ⊗ₜ[k] a) = (f'.left.appLE U_0 O_tilde₀ inf_le_right).hom a := by
      have h_eq2 : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ σ_cat) ≫
            hAffU₀.fromSpec =
          AlgebraicGeometry.Spec.map (f'.left.appLE U_0 O_tilde₀ inf_le_right) ≫
            hAffU₀.fromSpec := by
        calc AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ σ_cat) ≫
              hAffU₀.fromSpec
            = AlgebraicGeometry.Spec.map σ_cat ≫
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
                  hAffU₀.fromSpec) := by
                rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Spec.map σ_cat ≫ ψ_DA) ≫ pr₂_0 := by
                rw [← hψ_pr₂]
                simp only [ψ_DA, CategoryTheory.Category.assoc]
          _ = hAffOtilde.fromSpec ≫ (ι_0 ≫ pr₂_0) := by
                rw [hSpec_σ, CategoryTheory.Category.assoc]
          _ = hAffOtilde.fromSpec ≫ f'.left := by rw [hι0_2]
          _ = AlgebraicGeometry.Spec.map (f'.left.appLE U_0 O_tilde₀ inf_le_right) ≫
                hAffU₀.fromSpec :=
                (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
                  f'.left hAffU₀ hAffOtilde inf_le_right).symm
      have h_cat : CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ σ_cat =
          f'.left.appLE U_0 O_tilde₀ inf_le_right :=
        Quiver.Hom.op_inj (AlgebraicGeometry.Spec.fullyFaithful.map_injective
          ((CategoryTheory.cancel_mono hAffU₀.fromSpec).mp h_eq2))
      intro a
      exact congrArg (fun φ => φ.hom a) h_cat
    exact ⟨hAffOtilde, σ, hSurj_σ, hσL, hσR⟩

  
  
  
  have hCommAlg :
      ∀ {R A B L : Type u} [CommRing R] [CommRing A] [CommRing B] [CommRing L]
        [Algebra k R] [Algebra k A]
        (g : Fin (N + 1) → R)
        (_ : Algebra.adjoin k (Set.range g) = ⊤)
        (α_R : R →+* B) (α_A : A →+* B)
        (σ : TensorProduct k R A →+* B)
        (_ : Function.Surjective σ)
        (_ : ∀ r : R, σ (r ⊗ₜ[k] 1) = α_R r)
        (_ : ∀ a : A, σ (1 ⊗ₜ[k] a) = α_A a)
        (θ : B →+* L) (_ : Function.Injective θ)
        (v : Fin (N + 1) → L)
        (_ : ∀ r : Fin (N + 1), θ (α_R (g r)) = v r),
        (letI : Algebra A L := (θ.comp α_A).toAlgebra
         Module.Flat A ↥(Algebra.adjoin A (Set.range v))) →
        α_A.Flat := by
    intro R A B L _ _ _ _ _ _ g hAdj α_R α_A σ hSurj hσL hσR θ hInj v hv hFlatC
    letI : Algebra A B := α_A.toAlgebra
    letI : Algebra A L := (θ.comp α_A).toAlgebra
    let C : Subalgebra A L := Algebra.adjoin A (Set.range v)
    haveI : Module.Flat A ↥C := hFlatC
    have hScalar : ∀ c : k, α_R (algebraMap k R c) = α_A (algebraMap k A c) := by
      intro c
      rw [← hσL, ← hσR, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
        TensorProduct.smul_tmul]
    let R₀ : Subalgebra k R :=
      { carrier := { r : R | θ (α_R r) ∈ C }
        mul_mem' := fun {x y} hx hy => by
          change θ (α_R (x * y)) ∈ C
          rw [map_mul, map_mul]
          exact C.mul_mem hx hy
        one_mem' := by
          change θ (α_R 1) ∈ C
          rw [map_one, map_one]
          exact C.one_mem
        add_mem' := fun {x y} hx hy => by
          change θ (α_R (x + y)) ∈ C
          rw [map_add, map_add]
          exact C.add_mem hx hy
        zero_mem' := by
          change θ (α_R 0) ∈ C
          rw [map_zero, map_zero]
          exact C.zero_mem
        algebraMap_mem' := fun c => by
          change θ (α_R (algebraMap k R c)) ∈ C
          rw [hScalar c]
          exact C.algebraMap_mem (algebraMap k A c) }
    have hg_mem : Set.range g ⊆ (R₀ : Set R) := by
      rintro _ ⟨i, rfl⟩
      change θ (α_R (g i)) ∈ C
      rw [hv i]
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    have hR₀_top : R₀ = ⊤ := top_unique (hAdj ▸ Algebra.adjoin_le hg_mem)
    have hR_in_C : ∀ r : R, θ (α_R r) ∈ C := by
      intro r
      have hr : r ∈ R₀ := by
        rw [hR₀_top]
        exact Algebra.mem_top
      exact hr
    have hT_in_C : ∀ t : TensorProduct k R A, θ (σ t) ∈ C := by
      intro t
      refine TensorProduct.inductionOn t ?_ ?_
      · intro r a
        have h_tmul : (r ⊗ₜ[k] a : TensorProduct k R A) = (r ⊗ₜ[k] 1) * (1 ⊗ₜ[k] a) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [h_tmul, map_mul, map_mul, hσL, hσR]
        exact C.mul_mem (hR_in_C r) (C.algebraMap_mem a)
      · intro x y hx hy
        rw [map_add, map_add]
        exact C.add_mem hx hy
    have hB_in_C : ∀ b : B, θ b ∈ C := by
      intro b
      obtain ⟨t, rfl⟩ := hSurj b
      exact hT_in_C t
    let S_θ : Subalgebra A L :=
      { carrier := Set.range θ
        mul_mem' := by rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩; exact ⟨x * y, map_mul θ x y⟩
        one_mem' := ⟨1, map_one θ⟩
        add_mem' := by rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩; exact ⟨x + y, map_add θ x y⟩
        zero_mem' := ⟨0, map_zero θ⟩
        algebraMap_mem' := fun a => ⟨α_A a, rfl⟩ }
    have hv_in_S : Set.range v ⊆ (S_θ : Set L) := by
      rintro _ ⟨i, rfl⟩
      exact ⟨α_R (g i), hv i⟩
    have hC_le_S : C ≤ S_θ := Algebra.adjoin_le hv_in_S
    let θ_lin : B →ₗ[A] ↥C :=
      { toFun := fun b => ⟨θ b, hB_in_C b⟩
        map_add' := fun x y => Subtype.ext (map_add θ x y)
        map_smul' := fun a x => Subtype.ext (by
          change θ (α_A a * x) = θ (α_A a) * θ x
          exact map_mul θ (α_A a) x) }
    have hBij_lin : Function.Bijective θ_lin := by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        exact hInj (congrArg Subtype.val hxy)
      · rintro ⟨z, hz⟩
        obtain ⟨b, rfl⟩ := hC_le_S hz
        exact ⟨b, rfl⟩
    let e_BC : B ≃ₗ[A] ↥C := LinearEquiv.ofBijective θ_lin hBij_lin
    haveI : Module.Flat A B := Module.Flat.of_linearEquiv e_BC
    exact (RingHom.flat_algebraMap_iff (R := A) (S := B)).mpr inferInstance

  
  
  
  let U_A : S'.left → S'.left.Opens := fun s' => (hLocalFlat s').choose
  have hs'_mem : ∀ s' : S'.left, s' ∈ U_A s' := fun s' => (hLocalFlat s').choose_spec.choose
  have hAffUA : ∀ s' : S'.left, AlgebraicGeometry.IsAffineOpen (U_A s') :=
    fun s' => (hLocalFlat s').choose_spec.choose_spec.1
  have hFlatAlg : ∀ (s' : S'.left) (i : Fin (N + 1)), u i ≠ 0 →
      letI : Nonempty (U_A s') := ⟨⟨s', hs'_mem s'⟩⟩
      letI : Algebra ↑(S'.left.presheaf.obj (Opposite.op (U_A s'))) ↑Y.left.functionField :=
        (φ_KL.comp (e_K.comp (S'.left.germToFunctionField (U_A s')).hom)).toAlgebra
      Module.Flat ↑(S'.left.presheaf.obj (Opposite.op (U_A s')))
        ↥(Algebra.adjoin ↑(S'.left.presheaf.obj (Opposite.op (U_A s')))
          (Set.range (fun r : Fin (N + 1) => (u i)⁻¹ * u r))) :=
    fun s' => (hLocalFlat s').choose_spec.choose_spec.2

  let O_tilde : S'.left → Fin (N + 1) → Y'.left.Opens := fun s' i =>
    (TopologicalSpace.Opens.map (q'.left ≫ ι_Y.left).base).obj (D_proj i) ⊓
      (TopologicalSpace.Opens.map f'.left.base).obj (U_A s')
  let ι_cov := { idx : S'.left × Fin (N + 1) // Nonempty (O_tilde idx.1 idx.2) }
  let U_cov : ι_cov → Y'.left.Opens := fun idx => O_tilde idx.1.1 idx.1.2

  have hSup : ⨆ idx : ι_cov, U_cov idx = ⊤ := by
    rw [eq_top_iff]
    intro y' _
    let s' : S'.left := f'.left.base y'
    have hp_top : (q'.left ≫ ι_Y.left).base y' ∈ (⊤ : P_N.left.Opens) := trivial
    rw [← hCovD, TopologicalSpace.Opens.mem_iSup] at hp_top
    obtain ⟨i, hi_y'⟩ := hp_top
    have hy'_mem : y' ∈ O_tilde s' i := ⟨hi_y', hs'_mem s'⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨(s', i), ⟨⟨y', hy'_mem⟩⟩⟩, hy'_mem⟩

  have hFlat_f' : AlgebraicGeometry.Flat f'.left := by
    have : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Flat) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.Flat) (Q := @RingHom.Flat)
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
      (P := @AlgebraicGeometry.Flat) U_cov hSup ?_
    rintro ⟨⟨s', i⟩, hNeO⟩
    change AlgebraicGeometry.Flat ((O_tilde s' i).ι ≫ f'.left)
    have : Nonempty (O_tilde s' i) := hNeO
    have : Nonempty (U_A s') := ⟨⟨s', hs'_mem s'⟩⟩
    have hu_i : u i ≠ 0 := by
      intro hu0
      obtain ⟨⟨y', hy'⟩⟩ := hNeO
      have h_in : q'.left.base y' ∈
          (TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i) := hy'.1
      rw [hu_zero i hu0] at h_in
      exact h_in

    
    let D := D_proj i
    let R_D : Type u := ↑(P_N.left.presheaf.obj (Opposite.op D))
    let A : Type u := ↑(S'.left.presheaf.obj (Opposite.op (U_A s')))
    letI : Algebra k R_D :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        (P_N.hom.appLE ⊤ D le_top)).hom).toAlgebra
    letI : Algebra k A :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        (S'.hom.appLE ⊤ (U_A s') le_top)).hom).toAlgebra
    obtain ⟨hAffOtilde, σ, hSurj_σ, hσL, hσR⟩ :=
      hProdChart P_N (q'.left ≫ ι_Y.left) D (hAffD i) (U_A s') (hAffUA s')
        ι_tot hι_pr₁ hι_pr₂

    
    let B : Type u := ↑(Y'.left.presheaf.obj (Opposite.op (O_tilde s' i)))
    let α_R : R_D →+* B := ((q'.left ≫ ι_Y.left).appLE D (O_tilde s' i) inf_le_left).hom
    let α_A : A →+* B := (f'.left.appLE (U_A s') (O_tilde s' i) inf_le_right).hom
    let θ : B →+* ↑Y.left.functionField :=
      e_L.comp (Y'.left.germToFunctionField (O_tilde s' i)).hom
    have hInj_θ : Function.Injective θ :=
      e_L.injective.comp
        (AlgebraicGeometry.Scheme.germToFunctionField_injective Y'.left (O_tilde s' i))

    obtain ⟨hNeWi, h_coord⟩ := hu_ne i hu_i
    let W_i : Y.left.Opens := (TopologicalSpace.Opens.map ι_Y.left.base).obj D
    have : Nonempty W_i := hNeWi
    let v : Fin (N + 1) → ↑Y.left.functionField := fun r => (u i)⁻¹ * u r
    have hO_le_Wi : O_tilde s' i ≤ (TopologicalSpace.Opens.map q'.left.base).obj W_i :=
      fun _ hx => hx.1
    have hv : ∀ r : Fin (N + 1), θ (α_R (coord_ratio i r)) = v r := by
      intro r
      have h_comp_app : (q'.left ≫ ι_Y.left).appLE D (O_tilde s' i) inf_le_left =
          ι_Y.left.app D ≫ q'.left.appLE W_i (O_tilde s' i) hO_le_Wi :=
        AlgebraicGeometry.Scheme.Hom.comp_appLE q'.left ι_Y.left D (O_tilde s' i) inf_le_left
      have h_α_eq : α_R (coord_ratio i r) =
          (q'.left.appLE W_i (O_tilde s' i) hO_le_Wi).hom
            ((ι_Y.left.app D).hom (coord_ratio i r)) :=
        congrArg (fun φ => φ.hom (coord_ratio i r)) h_comp_app
      change e_L ((Y'.left.germToFunctionField (O_tilde s' i)).hom (α_R (coord_ratio i r))) = v r
      rw [h_α_eq]
      have hq_r := congrArg (fun φ => φ ((ι_Y.left.app D).hom (coord_ratio i r)))
        (heL_q W_i (O_tilde s' i) hO_le_Wi)
      dsimp at hq_r
      rw [hq_r]
      exact h_coord r

    have hθ_αA : θ.comp α_A =
        φ_KL.comp (e_K.comp (S'.left.germToFunctionField (U_A s')).hom) :=
      heL_f (U_A s') (O_tilde s' i) inf_le_right
    have hFlat_v :
        (letI : Algebra A ↑Y.left.functionField := (θ.comp α_A).toAlgebra
         Module.Flat A ↥(Algebra.adjoin A (Set.range v))) := by
      have hF := hFlatAlg s' i hu_i
      dsimp [A, v] at hF ⊢
      rwa [hθ_αA]

    have hFlat_ring : α_A.Flat :=
      hCommAlg (coord_ratio i) (hAdjD i) α_R α_A σ hSurj_σ hσL hσR θ hInj_θ v hv hFlat_v
    haveI : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map (f'.left.appLE (U_A s') (O_tilde s' i) inf_le_right)) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hFlat_ring
    haveI : CategoryTheory.IsIso (O_tilde s' i).toSpecΓ := by
      rw [← hAffOtilde.isoSpec_hom]
      infer_instance
    have h_fac_f' : (O_tilde s' i).ι ≫ f'.left =
        (O_tilde s' i).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (f'.left.appLE (U_A s') (O_tilde s' i) inf_le_right) ≫
          (hAffUA s').fromSpec := by
      rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
            f'.left (hAffUA s') hAffOtilde inf_le_right,
          ← CategoryTheory.Category.assoc, hAffOtilde.toSpecΓ_fromSpec]
    rw [h_fac_f']
    infer_instance

  refine ⟨Y', f', q', hcomm, hIntY', hProjY', hFlat_f', ?_, ?_⟩
  · rw [hlift_eq]
    infer_instance
  · rw [hlift_eq]
    exact hIso_ι

theorem weil_projective_single_flattening (k : Type u) [Field k]
    (hSegre : ∀ (Y₁ Y₂ S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (a₁ : Y₁ ⟶ S) (a₂ : Y₂ ⟶ S),
      IsProjectiveOverField k Y₁ → IsProjectiveOverField k Y₂ → IsProjectiveOverField k S →
      IsProjectiveOverField k
        (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)))
    (hMac : ∀ (N : ℕ) (K : Type u) [Field K]
      (I_η : Ideal (MvPolynomial (Fin (N + 1)) K)),
      ∃ d₀ : ℕ, 1 ≤ d₀ ∧
        ∀ (F : Type u) [Field F]
          (J : Ideal (MvPolynomial (Fin (N + 1)) F)),
          Module.finrank F
            (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d₀) ⧸
              (J.restrictScalars F).comap
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d₀).subtype) ≤
          Module.finrank K
            (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀) ⧸
              (I_η.restrictScalars K).comap
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d₀).subtype) →
          ∀ d : ℕ, d₀ ≤ d →
            Module.finrank F
              (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d) ⧸
                (J.restrictScalars F).comap
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F d).subtype) ≤
            Module.finrank K
              (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) ⧸
                (I_η.restrictScalars K).comap
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype))
    (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U : S.left.Opens)
    (hIntS : AlgebraicGeometry.IsIntegral S.left)
    (hProjS : IsProjectiveOverField k S)
    (hU : Nonempty U)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (p : Y ⟶ S)
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    (hProjY : IsProjectiveOverField k Y)
    (hFlatU : AlgebraicGeometry.Flat (p.left ∣_ U))
    (hSurjU : AlgebraicGeometry.Surjective (p.left ∣_ U)) :
    ∃ (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U' : S.left.Opens)
      (π : S' ⟶ S)
      (Y' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f' : Y' ⟶ S') (q' : Y' ⟶ Y)
      (hcomm : q'.left ≫ p.left = f'.left ≫ π.left),
      AlgebraicGeometry.IsIntegral S'.left ∧
      IsProjectiveOverField k S' ∧
      Nonempty U' ∧
      (U' : Set S.left) ⊆ (U : Set S.left) ∧
      AlgebraicGeometry.IsProper π.left ∧
      AlgebraicGeometry.Surjective π.left ∧
      CategoryTheory.IsIso (π.left ∣_ U') ∧
      AlgebraicGeometry.IsIntegral Y'.left ∧
      IsProjectiveOverField k Y' ∧
      AlgebraicGeometry.Flat f'.left ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift q'.left f'.left hcomm) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift q'.left f'.left hcomm) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd p.left π.left).base).obj
              ((TopologicalSpace.Opens.map π.left.base).obj U'))) :=
by
  have : AlgebraicGeometry.IsIntegral S.left := hIntS
  have : AlgebraicGeometry.IsIntegral Y.left := hIntY
  obtain ⟨N, ι_Y, hClY⟩ := hProjY
  obtain ⟨U₀, hAffU₀, hNeU₀, φ_KL, u, i₀, D_proj, coord_ratio,
      hU₀_le, hφ_compat, hu₀, hCovD, hAffD, hAdjD, hu_zero, hu_ne⟩ :=
    weil_dominant_proj_generic_coord_package k N S Y U hU p hSurjU ι_Y hClY
  let : Algebra ↑S.left.functionField ↑Y.left.functionField := φ_KL.toAlgebra
  let I_η : Ideal (MvPolynomial (Fin (N + 1)) ↑S.left.functionField) :=
    RingHom.ker (MvPolynomial.aeval (R := ↑S.left.functionField)
      (fun r : Fin (N + 1) => Polynomial.C (u r) * Polynomial.X)).toRingHom
  obtain ⟨d₀, hd₀, hMac_d₀⟩ := hMac N ↑S.left.functionField I_η
  obtain ⟨M_Pl, Δ, a₀, hΔ₀, hFlatAlg⟩ :=
    weil_cramer_macaulay_subalgebra_flat N d₀ hd₀
      ↑S.left.functionField ↑Y.left.functionField u i₀ hu₀ hMac_d₀
  have : Nonempty U₀ := hNeU₀
  obtain ⟨S', U', π, hIntS', hProjS', hU', hU'_le_U₀, hPropπ, hSurjπ, hIsoπ,
      e_K, hBij_eK, heK_compat, hPlCover⟩ :=
    weil_plucker_modification_over_open k hSegre S hProjS U₀ hAffU₀ M_Pl Δ a₀ hΔ₀
  have : AlgebraicGeometry.IsIntegral S'.left := hIntS'
  have hU'_le_U : U' ≤ U := hU'_le_U₀.trans hU₀_le
  have hU'_sub : (U' : Set S.left) ⊆ (U : Set S.left) := hU'_le_U
  have hSurjU' : AlgebraicGeometry.Surjective (p.left ∣_ U') := by
    have hPU' : CategoryTheory.IsPullback (p.left ∣_ U') ((p.left ⁻¹ᵁ U').ι) U'.ι p.left :=
      AlgebraicGeometry.isPullback_morphismRestrict p.left U'
    have hPU : CategoryTheory.IsPullback (p.left ∣_ U) ((p.left ⁻¹ᵁ U).ι) U.ι p.left :=
      AlgebraicGeometry.isPullback_morphismRestrict p.left U
    have hPre : p.left ⁻¹ᵁ U' ≤ p.left ⁻¹ᵁ U := fun _ hx => hU'_le_U hx
    have hcomm_res : (p.left ∣_ U') ≫ S.left.homOfLE hU'_le_U =
        Y.left.homOfLE hPre ≫ (p.left ∣_ U) := by
      rw [← CategoryTheory.cancel_mono U.ι]
      simp [AlgebraicGeometry.morphismRestrict_ι]
    have hTop : CategoryTheory.IsPullback (p.left ∣_ U') (Y.left.homOfLE hPre)
        (S.left.homOfLE hU'_le_U) (p.left ∣_ U) :=
      CategoryTheory.IsPullback.of_bot (by simpa using hPU') hcomm_res hPU
    exact CategoryTheory.MorphismProperty.of_isPullback hTop.flip hSurjU
  have hLocalFlat : ∀ s' : S'.left,
      ∃ (U_A : S'.left.Opens) (hs' : s' ∈ U_A),
        AlgebraicGeometry.IsAffineOpen U_A ∧
        ∀ i : Fin (N + 1), u i ≠ 0 →
          letI : Nonempty U_A := ⟨⟨s', hs'⟩⟩
          letI : Algebra ↑(S'.left.presheaf.obj (Opposite.op U_A)) ↑Y.left.functionField :=
            (φ_KL.comp (e_K.comp (S'.left.germToFunctionField U_A).hom)).toAlgebra
          Module.Flat ↑(S'.left.presheaf.obj (Opposite.op U_A))
            ↥(Algebra.adjoin ↑(S'.left.presheaf.obj (Opposite.op U_A))
              (Set.range (fun r : Fin (N + 1) => (u i)⁻¹ * u r))) := by
    intro s'
    obtain ⟨U_A, hs', a₁, hAffUA, hΔ₁, hRatio⟩ := hPlCover s'
    refine ⟨U_A, hs', hAffUA, ?_⟩
    intro i hui
    let hneUA : Nonempty U_A := ⟨⟨s', hs'⟩⟩
    let A := ↑(S'.left.presheaf.obj (Opposite.op U_A))
    have : IsDomain A :=
      @AlgebraicGeometry.IsIntegral.component_integral S'.left hIntS' U_A hneUA
    have : IsFractionRing A ↑S'.left.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen S'.left U_A hAffUA
    let : Algebra A ↑S.left.functionField :=
      (e_K.comp (S'.left.germToFunctionField U_A).hom).toAlgebra
    let e_alg : ↑S'.left.functionField ≃ₐ[A] ↑S.left.functionField :=
      AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective e_K hBij_eK) (fun _ => rfl)
    have : IsFractionRing A ↑S.left.functionField :=
      IsLocalization.isLocalization_of_algEquiv (nonZeroDivisors A) e_alg
    let : Algebra A ↑Y.left.functionField :=
      (φ_KL.comp (e_K.comp (S'.left.germToFunctionField U_A).hom)).toAlgebra
    have : IsScalarTower A ↑S.left.functionField ↑Y.left.functionField :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    exact hFlatAlg A ⟨a₁, hΔ₁, hRatio⟩ i hui
  obtain ⟨Y', f', q', hcomm, hIntY', hProjY', hFlat_f', hCl_lift, hIso_lift⟩ :=
    weil_strictTransform_chart_adjoin_flat k hSegre N S S' Y
      hProjS hProjS' ⟨N, ι_Y, hClY⟩ U' hU' π hIsoπ p hSurjU' ι_Y hClY
      φ_KL hφ_compat e_K heK_compat u D_proj coord_ratio
      hCovD hAffD hAdjD hu_zero hu_ne hLocalFlat
  exact ⟨S', U', π, Y', f', q', hcomm,
    hIntS', hProjS', hU', hU'_sub, hPropπ, hSurjπ, hIsoπ,
    hIntY', hProjY', hFlat_f', hCl_lift, hIso_lift⟩

theorem weil_projective_openFlat_strictTransform (k : Type u) [Field k]
    (hSegre : ∀ (Y₁ Y₂ S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (a₁ : Y₁ ⟶ S) (a₂ : Y₂ ⟶ S),
      IsProjectiveOverField k Y₁ → IsProjectiveOverField k Y₂ → IsProjectiveOverField k S →
      IsProjectiveOverField k
        (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)))
    (S₁ S₂ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (W₁ : S₁.left.Opens)
    (θ : S₂ ⟶ S₁)
    (p_Z : Z ⟶ S₁)
    (hProjS₁ : IsProjectiveOverField k S₁)
    (hProjS₂ : IsProjectiveOverField k S₂)
    (hW₁ : Nonempty W₁)
    (hIsoθ : CategoryTheory.IsIso (θ.left ∣_ W₁))
    (hIntZ : AlgebraicGeometry.IsIntegral Z.left)
    (hProjZ : IsProjectiveOverField k Z)
    (hFlatZ : AlgebraicGeometry.Flat (p_Z.left ∣_ W₁))
    (hSurjZ : AlgebraicGeometry.Surjective (p_Z.left ∣_ W₁)) :
    ∃ (Z' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p'_Z : Z' ⟶ S₂) (q'_Z : Z' ⟶ Z)
      (hcomm : q'_Z.left ≫ p_Z.left = p'_Z.left ≫ θ.left),
      AlgebraicGeometry.IsIntegral Z'.left ∧
      IsProjectiveOverField k Z' ∧
      AlgebraicGeometry.Flat
        (p'_Z.left ∣_ ((TopologicalSpace.Opens.map θ.left.base).obj W₁)) ∧
      AlgebraicGeometry.Surjective
        (p'_Z.left ∣_ ((TopologicalSpace.Opens.map θ.left.base).obj W₁)) ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift q'_Z.left p'_Z.left hcomm) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift q'_Z.left p'_Z.left hcomm) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd p_Z.left θ.left).base).obj
              ((TopologicalSpace.Opens.map θ.left.base).obj W₁))) :=
by
  let U_Z : Z.left.Opens := (TopologicalSpace.Opens.map p_Z.left.base).obj W₁
  let W₂ : S₂.left.Opens := (TopologicalSpace.Opens.map θ.left.base).obj W₁
  let P_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p_Z.left θ.left
  let fst_P : P_sch ⟶ Z.left := CategoryTheory.Limits.pullback.fst p_Z.left θ.left
  let snd_P : P_sch ⟶ S₂.left := CategoryTheory.Limits.pullback.snd p_Z.left θ.left
  let W_pb : P_sch.Opens := (TopologicalSpace.Opens.map snd_P.base).obj W₂

  
  have : CategoryTheory.IsIso (θ.left ∣_ W₁) := hIsoθ
  let θ_inv : W₁.toScheme ⟶ W₂.toScheme := CategoryTheory.inv (θ.left ∣_ W₁)
  have hθ_inv_ι : (θ_inv ≫ W₂.ι) ≫ θ.left = W₁.ι := by
    rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι θ.left W₁,
      CategoryTheory.IsIso.inv_hom_id_assoc]
  let g_U : U_Z.toScheme ⟶ S₂.left := ((p_Z.left ∣_ W₁) ≫ θ_inv) ≫ W₂.ι
  have h_q_comm : U_Z.ι ≫ p_Z.left = g_U ≫ θ.left := by
    dsimp [g_U]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc θ_inv, hθ_inv_ι,
      AlgebraicGeometry.morphismRestrict_ι p_Z.left W₁]
  let q_open : U_Z.toScheme ⟶ P_sch :=
    CategoryTheory.Limits.pullback.lift U_Z.ι g_U h_q_comm
  have hPb_W : CategoryTheory.IsPullback (snd_P ∣_ W₂) W_pb.ι W₂.ι snd_P :=
    AlgebraicGeometry.isPullback_morphismRestrict snd_P W₂
  have hs_comm : ((p_Z.left ∣_ W₁) ≫ θ_inv) ≫ W₂.ι = q_open ≫ snd_P := by
    dsimp [q_open]
    rw [CategoryTheory.Limits.pullback.lift_snd]
  let s_pb : U_Z.toScheme ⟶ W_pb.toScheme :=
    hPb_W.lift ((p_Z.left ∣_ W₁) ≫ θ_inv) q_open hs_comm
  have hs_fst : s_pb ≫ (snd_P ∣_ W₂) = (p_Z.left ∣_ W₁) ≫ θ_inv :=
    hPb_W.lift_fst _ _ _
  have hs_snd : s_pb ≫ W_pb.ι = q_open :=
    hPb_W.lift_snd _ _ _

  let V_fst : P_sch.Opens := (TopologicalSpace.Opens.map fst_P.base).obj U_Z
  have hW_le : W_pb ≤ V_fst := by
    intro x hx
    have hx' : (snd_P ≫ θ.left).base x ∈ W₁ := hx
    rwa [← CategoryTheory.Limits.pullback.condition] at hx'
  let r_pb : W_pb.toScheme ⟶ U_Z.toScheme := P_sch.homOfLE hW_le ≫ (fst_P ∣_ U_Z)
  have hr_ι : r_pb ≫ U_Z.ι = W_pb.ι ≫ fst_P := by
    dsimp [r_pb]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι fst_P U_Z,
      ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι P_sch hW_le]
  have hsr : s_pb ≫ r_pb = 𝟙 U_Z.toScheme := by
    rw [← CategoryTheory.cancel_mono U_Z.ι]
    rw [CategoryTheory.Category.assoc, hr_ι, ← CategoryTheory.Category.assoc, hs_snd]
    dsimp [q_open]
    rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
  have hr_p : r_pb ≫ (p_Z.left ∣_ W₁) = (snd_P ∣_ W₂) ≫ (θ.left ∣_ W₁) := by
    rw [← CategoryTheory.cancel_mono W₁.ι]
    calc (r_pb ≫ (p_Z.left ∣_ W₁)) ≫ W₁.ι
        = r_pb ≫ ((p_Z.left ∣_ W₁) ≫ W₁.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (r_pb ≫ U_Z.ι) ≫ p_Z.left := by
            rw [AlgebraicGeometry.morphismRestrict_ι p_Z.left W₁]
            exact (CategoryTheory.Category.assoc r_pb U_Z.ι p_Z.left).symm
      _ = W_pb.ι ≫ (fst_P ≫ p_Z.left) := by
            rw [hr_ι, CategoryTheory.Category.assoc]
      _ = (W_pb.ι ≫ snd_P) ≫ θ.left := by
            rw [CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc]
      _ = (snd_P ∣_ W₂) ≫ (W₂.ι ≫ θ.left) := by
            rw [← AlgebraicGeometry.morphismRestrict_ι snd_P W₂, CategoryTheory.Category.assoc]
      _ = ((snd_P ∣_ W₂) ≫ (θ.left ∣_ W₁)) ≫ W₁.ι := by
            rw [← AlgebraicGeometry.morphismRestrict_ι θ.left W₁, ← CategoryTheory.Category.assoc]
  have hrs : r_pb ≫ s_pb = 𝟙 W_pb.toScheme := by
    rw [← CategoryTheory.cancel_mono W_pb.ι]
    rw [CategoryTheory.Category.id_comp]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc s_pb, hs_snd]
      dsimp [q_open]
      rw [CategoryTheory.Limits.pullback.lift_fst, hr_ι]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc s_pb, hs_snd]
      dsimp [q_open]
      rw [CategoryTheory.Limits.pullback.lift_snd]
      calc r_pb ≫ (((p_Z.left ∣_ W₁) ≫ θ_inv) ≫ W₂.ι)
          = (r_pb ≫ (p_Z.left ∣_ W₁)) ≫ θ_inv ≫ W₂.ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = ((snd_P ∣_ W₂) ≫ (θ.left ∣_ W₁)) ≫ θ_inv ≫ W₂.ι := by rw [hr_p]
        _ = (snd_P ∣_ W₂) ≫ ((θ.left ∣_ W₁) ≫ θ_inv) ≫ W₂.ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = (snd_P ∣_ W₂) ≫ W₂.ι := by
              dsimp [θ_inv]
              rw [CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.id_comp]
        _ = W_pb.ι ≫ snd_P := AlgebraicGeometry.morphismRestrict_ι snd_P W₂
  let e_pb : U_Z.toScheme ≅ W_pb.toScheme :=
    { hom := s_pb, inv := r_pb, hom_inv_id := hsr, inv_hom_id := hrs }
  have : CategoryTheory.IsIso e_pb.inv := e_pb.isIso_inv
  have he_snd : (snd_P ∣_ W₂) = e_pb.inv ≫ (p_Z.left ∣_ W₁) ≫ θ_inv := by
    calc (snd_P ∣_ W₂)
        = 𝟙 W_pb.toScheme ≫ (snd_P ∣_ W₂) := (CategoryTheory.Category.id_comp _).symm
      _ = (e_pb.inv ≫ e_pb.hom) ≫ (snd_P ∣_ W₂) := by rw [e_pb.inv_hom_id]
      _ = e_pb.inv ≫ (s_pb ≫ (snd_P ∣_ W₂)) := CategoryTheory.Category.assoc _ _ _
      _ = e_pb.inv ≫ (p_Z.left ∣_ W₁) ≫ θ_inv := by rw [hs_fst]

  
  have : AlgebraicGeometry.IsIntegral Z.left := hIntZ
  have : AlgebraicGeometry.Surjective (p_Z.left ∣_ W₁) := hSurjZ
  obtain ⟨w₀⟩ := hW₁
  obtain ⟨u₀, _⟩ := AlgebraicGeometry.Surjective.surj (f := p_Z.left ∣_ W₁) w₀
  have : Nonempty ↥U_Z.toScheme := ⟨u₀⟩
  have : AlgebraicGeometry.IsIntegral U_Z.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_Z.ι
  have : Nonempty ↥W_pb.toScheme := ⟨e_pb.hom.base u₀⟩
  have : AlgebraicGeometry.IsIntegral W_pb.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion e_pb.inv

  
  let P_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (snd_P ≫ S₂.hom)
  have hProjP : IsProjectiveOverField k P_over :=
    hSegre Z S₂ S₁ p_Z θ hProjZ hProjS₂ hProjS₁
  obtain ⟨N_P, ι_P, hCl_P⟩ := hProjP
  have : AlgebraicGeometry.IsClosedImmersion ι_P.left := hCl_P
  have : TopologicalSpace.NoetherianSpace ↥P_sch := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N_P + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N_P + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N_P + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N_P + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N_P + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N_P + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hSurj0
    have : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) :=
      (AlgebraicGeometry.isNoetherian_iff (AlgebraicGeometry.Proj 𝒜)).mpr ⟨inferInstance, inferInstance⟩
    have : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N_P).left := by
      change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
      exact AlgebraicGeometry.IsNoetherian.noetherianSpace
    exact ι_P.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have : TopologicalSpace.NoetherianSpace ↥W_pb.toScheme :=
    W_pb.ι.isOpenEmbedding.toIsEmbedding.toIsInducing.noetherianSpace

  
  let j : W_pb.toScheme ⟶ P_sch := W_pb.ι
  have : AlgebraicGeometry.QuasiCompact j :=
    AlgebraicGeometry.quasiCompact_of_noetherianSpace_source j
  have : AlgebraicGeometry.IsReduced W_pb.toScheme :=
    AlgebraicGeometry.isReduced_of_isIntegral W_pb.toScheme
  have : AlgebraicGeometry.IsReduced j.image := by
    let 𝒰 := j.ker.subschemeCover.openCover
    have : ∀ U : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X U) := by
      intro U
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of
          (↑(P_sch.presheaf.obj (Opposite.op U.1)) ⧸ j.ker.ideal U)))
      rw [AlgebraicGeometry.affine_isReduced_iff]
      dsimp
      rw [j.ker_apply U]
      have : IsReduced ↑(W_pb.toScheme.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map j.base).obj U.1))) :=
        @AlgebraicGeometry.IsReduced.component_reduced W_pb.toScheme _ _
      exact isReduced_of_injective _ (RingHom.kerLift_injective (j.app U.1).hom)
    exact AlgebraicGeometry.IsReduced.of_openCover j.image 𝒰
  have : IrreducibleSpace ↥W_pb.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral W_pb.toScheme
  have : IrreducibleSpace ↥j.image :=
    { isPreirreducible_univ := by
        have hRange : IsPreirreducible (Set.range j.toImage.base) := by
          rw [← Set.image_univ]
          exact PreirreducibleSpace.isPreirreducible_univ.image j.toImage.base
            j.toImage.base.hom.continuous.continuousOn
        have hDense : DenseRange j.toImage.base :=
          AlgebraicGeometry.IsDominant.denseRange (f := j.toImage)
        simpa [hDense.closure_range] using hRange.closure
      toNonempty := ⟨j.toImage.base (e_pb.hom.base u₀)⟩ }
  have hIntZ' : AlgebraicGeometry.IsIntegral j.image :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced j.image

  let ι_Z' : j.image ⟶ P_sch := j.imageι
  have hIso_ι : CategoryTheory.IsIso (ι_Z' ∣_ W_pb) := by
    have hPb_ι : CategoryTheory.IsPullback (ι_Z' ∣_ W_pb) (ι_Z' ⁻¹ᵁ W_pb).ι W_pb.ι ι_Z' :=
      AlgebraicGeometry.isPullback_morphismRestrict ι_Z' W_pb
    have ht_comm : 𝟙 W_pb.toScheme ≫ W_pb.ι = j.toImage ≫ ι_Z' := by
      rw [CategoryTheory.Category.id_comp]
      exact (AlgebraicGeometry.Scheme.Hom.toImage_imageι j).symm
    let t_W : W_pb.toScheme ⟶ (ι_Z' ⁻¹ᵁ W_pb).toScheme :=
      hPb_ι.lift (𝟙 W_pb.toScheme) j.toImage ht_comm
    have ht_fst : t_W ≫ (ι_Z' ∣_ W_pb) = 𝟙 W_pb.toScheme :=
      hPb_ι.lift_fst _ _ _
    have ht_snd : t_W ≫ (ι_Z' ⁻¹ᵁ W_pb).ι = j.toImage :=
      hPb_ι.lift_snd _ _ _
    have h_comp_t : (ι_Z' ∣_ W_pb) ≫ t_W = 𝟙 (ι_Z' ⁻¹ᵁ W_pb).toScheme := by
      rw [← CategoryTheory.cancel_mono (ι_Z' ⁻¹ᵁ W_pb).ι, ← CategoryTheory.cancel_mono ι_Z']
      calc (((ι_Z' ∣_ W_pb) ≫ t_W) ≫ (ι_Z' ⁻¹ᵁ W_pb).ι) ≫ ι_Z'
          = (ι_Z' ∣_ W_pb) ≫ (t_W ≫ (ι_Z' ⁻¹ᵁ W_pb).ι) ≫ ι_Z' := by
              simp only [CategoryTheory.Category.assoc]
        _ = (ι_Z' ∣_ W_pb) ≫ (j.toImage ≫ ι_Z') := by rw [ht_snd]
        _ = (ι_Z' ∣_ W_pb) ≫ W_pb.ι := by rw [AlgebraicGeometry.Scheme.Hom.toImage_imageι j]
        _ = (ι_Z' ⁻¹ᵁ W_pb).ι ≫ ι_Z' := AlgebraicGeometry.morphismRestrict_ι ι_Z' W_pb
        _ = (𝟙 (ι_Z' ⁻¹ᵁ W_pb).toScheme ≫ (ι_Z' ⁻¹ᵁ W_pb).ι) ≫ ι_Z' := by
              rw [CategoryTheory.Category.id_comp]
    exact ⟨⟨t_W, h_comp_t, ht_fst⟩⟩

  
  let p'_sch : j.image ⟶ S₂.left := ι_Z' ≫ snd_P
  let q'_sch : j.image ⟶ Z.left := ι_Z' ≫ fst_P
  let Z' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (p'_sch ≫ S₂.hom)
  let p'_Z : Z' ⟶ S₂ := CategoryTheory.Over.homMk p'_sch rfl
  have hq'_w : q'_sch ≫ Z.hom = Z'.hom := by
    dsimp [Z', p'_sch, q'_sch]
    calc (ι_Z' ≫ fst_P) ≫ Z.hom
        = ι_Z' ≫ fst_P ≫ (p_Z.left ≫ S₁.hom) := by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Over.w p_Z]
      _ = ι_Z' ≫ (fst_P ≫ p_Z.left) ≫ S₁.hom := by
            simp only [CategoryTheory.Category.assoc]
      _ = ι_Z' ≫ (snd_P ≫ θ.left) ≫ S₁.hom := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = (ι_Z' ≫ snd_P) ≫ S₂.hom := by
            rw [CategoryTheory.Category.assoc snd_P, CategoryTheory.Over.w θ,
              CategoryTheory.Category.assoc]
  let q'_Z : Z' ⟶ Z := CategoryTheory.Over.homMk q'_sch hq'_w
  have hcomm : q'_Z.left ≫ p_Z.left = p'_Z.left ≫ θ.left := by
    change (ι_Z' ≫ fst_P) ≫ p_Z.left = (ι_Z' ≫ snd_P) ≫ θ.left
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      CategoryTheory.Category.assoc]
  have hlift_eq : CategoryTheory.Limits.pullback.lift q'_Z.left p'_Z.left hcomm = ι_Z' := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    · exact CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hProjZ' : IsProjectiveOverField k Z' := by
    let ι_Z'_over : Z' ⟶ P_over :=
      CategoryTheory.Over.homMk ι_Z' (CategoryTheory.Category.assoc ι_Z' snd_P S₂.hom)
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (ι_Z'_over ≫ ι_P).left := by
      change AlgebraicGeometry.IsClosedImmersion (ι_Z' ≫ ι_P.left)
      infer_instance
    exact ⟨N_P, ι_Z'_over ≫ ι_P, hCl_comp⟩

  have flat_of_isIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      CategoryTheory.IsIso f → AlgebraicGeometry.Flat f := by
    intro X Y f hf
    have := hf
    infer_instance
  have surj_of_isIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      CategoryTheory.IsIso f → AlgebraicGeometry.Surjective f := by
    intro X Y f hf
    have := hf
    infer_instance
  have flat_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} {f : X ⟶ Y} {g : Y ⟶ Z},
      AlgebraicGeometry.Flat f → AlgebraicGeometry.Flat g → AlgebraicGeometry.Flat (f ≫ g) := by
    intro X Y Z f g hf hg
    have := hf
    have := hg
    infer_instance
  have surj_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} {f : X ⟶ Y} {g : Y ⟶ Z},
      AlgebraicGeometry.Surjective f → AlgebraicGeometry.Surjective g →
      AlgebraicGeometry.Surjective (f ≫ g) := by
    intro X Y Z f g hf hg
    have := hf
    have := hg
    infer_instance
  have hIso_θ_inv : CategoryTheory.IsIso θ_inv := by
    dsimp [θ_inv]
    infer_instance
  have h_p'_res : (p'_Z.left ∣_ W₂) =
      (ι_Z' ∣_ W_pb) ≫ e_pb.inv ≫ (p_Z.left ∣_ W₁) ≫ θ_inv := by
    change ((ι_Z' ≫ snd_P) ∣_ W₂) = _
    rw [AlgebraicGeometry.morphismRestrict_comp ι_Z' snd_P W₂, he_snd]
  have hFlatZ' : AlgebraicGeometry.Flat (p'_Z.left ∣_ W₂) := by
    rw [h_p'_res]
    exact flat_comp (flat_of_isIso _ hIso_ι)
      (flat_comp (flat_of_isIso _ e_pb.isIso_inv)
        (flat_comp hFlatZ (flat_of_isIso _ hIso_θ_inv)))
  have hSurjZ' : AlgebraicGeometry.Surjective (p'_Z.left ∣_ W₂) := by
    rw [h_p'_res]
    exact surj_comp (surj_of_isIso _ hIso_ι)
      (surj_comp (surj_of_isIso _ e_pb.isIso_inv)
        (surj_comp hSurjZ (surj_of_isIso _ hIso_θ_inv)))

  refine ⟨Z', p'_Z, q'_Z, hcomm, hIntZ', hProjZ', hFlatZ', hSurjZ', ?_, ?_⟩
  · rw [hlift_eq]
    infer_instance
  · rw [hlift_eq]
    exact hIso_ι

theorem weil_projective_flat_strictTransform_pullback (k : Type u) [Field k]
    (hSegre : ∀ (Y₁ Y₂ S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (a₁ : Y₁ ⟶ S) (a₂ : Y₂ ⟶ S),
      IsProjectiveOverField k Y₁ → IsProjectiveOverField k Y₂ → IsProjectiveOverField k S →
      IsProjectiveOverField k
        (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)))
    (S₀ S₁ S₂ Z₀ Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ U_good : S₀.left.Opens)
    (ψ₁ : S₁ ⟶ S₀)
    (θ : S₂ ⟶ S₁)
    (p₀ : Z₀ ⟶ S₀)
    (f₁ : Y₁ ⟶ S₁)
    (q₁ : Y₁ ⟶ Z₀)
    (hcomm₁ : q₁.left ≫ p₀.left = f₁.left ≫ ψ₁.left)
    (hIntS₁ : AlgebraicGeometry.IsIntegral S₁.left)
    (hIntS₂ : AlgebraicGeometry.IsIntegral S₂.left)
    (hProjS₁ : IsProjectiveOverField k S₁)
    (hProjS₂ : IsProjectiveOverField k S₂)
    (hIntY₁ : AlgebraicGeometry.IsIntegral Y₁.left)
    (hProjY₁ : IsProjectiveOverField k Y₁)
    (hFlat₁ : AlgebraicGeometry.Flat f₁.left)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift q₁.left f₁.left hcomm₁))
    (hIso₁ : CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift q₁.left f₁.left hcomm₁) ∣_
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd p₀.left ψ₁.left).base).obj
            ((TopologicalSpace.Opens.map ψ₁.left.base).obj U₀))))
    (hUgood : Nonempty U_good)
    (hSub : (U_good : Set S₀.left) ⊆ (U₀ : Set S₀.left))
    (hIsoψ₁ : CategoryTheory.IsIso (ψ₁.left ∣_ U_good))
    (hIsoComp : CategoryTheory.IsIso ((θ ≫ ψ₁).left ∣_ U_good)) :
    ∃ (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f₂ : Y₂ ⟶ S₂) (q₂ : Y₂ ⟶ Z₀)
      (hcomm₂ : q₂.left ≫ p₀.left = f₂.left ≫ (θ ≫ ψ₁).left),
      AlgebraicGeometry.IsIntegral Y₂.left ∧
      IsProjectiveOverField k Y₂ ∧
      AlgebraicGeometry.Flat f₂.left ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift q₂.left f₂.left hcomm₂) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift q₂.left f₂.left hcomm₂) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd p₀.left (θ ≫ ψ₁).left).base).obj
              ((TopologicalSpace.Opens.map (θ ≫ ψ₁).left.base).obj U_good))) :=
by
  have hIsIsoRestrictLE :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (U W : Y.Opens),
        W ≤ U → CategoryTheory.IsIso (f ∣_ U) → True ∧ CategoryTheory.IsIso (f ∣_ W) := by
    intro X Y f U W hWU hIsoU
    refine ⟨trivial, ?_⟩
    have : CategoryTheory.IsIso (f ∣_ U) := hIsoU
    have hPW : CategoryTheory.IsPullback (f ∣_ W) ((f ⁻¹ᵁ W).ι) W.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f W
    have hPU : CategoryTheory.IsPullback (f ∣_ U) ((f ⁻¹ᵁ U).ι) U.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f U
    have hPre : f ⁻¹ᵁ W ≤ f ⁻¹ᵁ U := fun _ hx => hWU hx
    have hcomm : (f ∣_ W) ≫ Y.homOfLE hWU = X.homOfLE hPre ≫ (f ∣_ U) := by
      rw [← CategoryTheory.cancel_mono U.ι]
      simp [AlgebraicGeometry.morphismRestrict_ι]
    have hTop : CategoryTheory.IsPullback (f ∣_ W) (X.homOfLE hPre) (Y.homOfLE hWU) (f ∣_ U) :=
      CategoryTheory.IsPullback.of_bot (by simpa using hPW) hcomm hPU
    exact hTop.isIso_fst_of_isIso

  have hPullRestrictBase :
      ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
        (fst : P ⟶ X) (snd : P ⟶ Y) (f : X ⟶ Z) (g : Y ⟶ Z),
        CategoryTheory.IsPullback fst snd f g →
        ∀ (U : Z.Opens),
          CategoryTheory.IsIso (f ∣_ U) →
          True ∧ CategoryTheory.IsIso (snd ∣_ ((TopologicalSpace.Opens.map g.base).obj U)) := by
    intro P X Y Z fst snd f g hPb U hIsoF
    refine ⟨trivial, ?_⟩
    have : CategoryTheory.IsIso (f ∣_ U) := hIsoF
    have hTop : CategoryTheory.IsPullback (snd ∣_ (g ⁻¹ᵁ U)) (snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι
        (g ⁻¹ᵁ U).ι snd :=
      AlgebraicGeometry.isPullback_morphismRestrict snd (g ⁻¹ᵁ U)
    have hBot : CategoryTheory.IsPullback (f ∣_ U) (f ⁻¹ᵁ U).ι U.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f U
    have hOuter' : CategoryTheory.IsPullback (snd ∣_ (g ⁻¹ᵁ U))
        ((snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι ≫ fst) ((g ∣_ U) ≫ U.ι) f := by
      rw [AlgebraicGeometry.morphismRestrict_ι g U]
      exact hTop.paste_vert hPb.flip
    let r_U : (snd ⁻¹ᵁ (g ⁻¹ᵁ U)).toScheme ⟶ (f ⁻¹ᵁ U).toScheme :=
      hBot.lift ((snd ∣_ (g ⁻¹ᵁ U)) ≫ (g ∣_ U)) ((snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι ≫ fst)
        (by rw [CategoryTheory.Category.assoc]; exact hOuter'.w)
    have hr_ι : r_U ≫ (f ⁻¹ᵁ U).ι = (snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι ≫ fst :=
      hBot.lift_snd _ _ _
    have hr_comm : (snd ∣_ (g ⁻¹ᵁ U)) ≫ (g ∣_ U) = r_U ≫ (f ∣_ U) :=
      (hBot.lift_fst _ _ _).symm
    have hSq' : CategoryTheory.IsPullback (snd ∣_ (g ⁻¹ᵁ U)) r_U (g ∣_ U) (f ∣_ U) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hr_comm hBot
      rw [hr_ι]
      exact hOuter'
    exact hSq'.isIso_fst_of_isIso

  have hFlatIntegralOpen :
      ∀ (X S : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ S) (V : S.Opens),
        AlgebraicGeometry.IsIntegral S →
        Nonempty V →
        AlgebraicGeometry.Flat f →
        (Nonempty ↥X → Nonempty ↥((TopologicalSpace.Opens.map f.base).obj V)) ∧
        (AlgebraicGeometry.IsIntegral
            (↑((TopologicalSpace.Opens.map f.base).obj V) : AlgebraicGeometry.Scheme.{u}) →
          AlgebraicGeometry.IsIntegral X) := by
    intro X S f V hIntS hV hFlat
    have : AlgebraicGeometry.IsIntegral S := hIntS
    have : IrreducibleSpace ↥S := AlgebraicGeometry.irreducibleSpace_of_isIntegral S
    have : AlgebraicGeometry.Flat f := hFlat
    let W : X.Opens := (TopologicalSpace.Opens.map f.base).obj V
    have hLocalBasic :
        ∀ (U_S : S.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_S)
          (U_X : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (x : ↥X) (_ : x ∈ U_X)
          (_ : U_X ≤ (TopologicalSpace.Opens.map f.base).obj U_S),
          ∃ b : ↑(X.presheaf.obj (Opposite.op U_X)),
            X.basicOpen b ≤ U_X ⊓ W ∧
            Nonempty ↥(X.basicOpen b) ∧
            Function.Injective
              (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le b)).op).hom := by
      intro U_S hUS U_X hUX x hx e
      have hneUS : Nonempty U_S := ⟨⟨f.base x, e hx⟩⟩
      let A := ↑(S.presheaf.obj (Opposite.op U_S))
      let R := ↑(X.presheaf.obj (Opposite.op U_X))
      have _hDomA : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral S hIntS U_S hneUS
      let φ := f.appLE U_S U_X e
      let _instAlgAR : Algebra A R := φ.hom.toAlgebra
      have hFlat_φ : φ.hom.Flat :=
        @AlgebraicGeometry.Scheme.Hom.flat_appLE X S f hFlat U_S hUS U_X hUX e
      have : Module.Flat A R := RingHom.flat_algebraMap_iff.mpr hFlat_φ
      have : Module.IsTorsionFree A R := Module.Flat.isTorsionFree
      obtain ⟨⟨v₀, hv₀⟩⟩ := hV
      obtain ⟨s₀, _, hs₀US, hs₀V⟩ :=
        PreirreducibleSpace.isPreirreducible_univ (U_S : Set S) (V : Set S) U_S.isOpen V.isOpen
          ⟨f.base x, trivial, e hx⟩ ⟨v₀, trivial, hv₀⟩
      obtain ⟨a, ha_le, hs₀_ba⟩ := hUS.exists_basicOpen_le (⟨s₀, hs₀V⟩ : ↥V) hs₀US
      have ha_ne : a ≠ 0 := by
        intro ha0
        rw [ha0, AlgebraicGeometry.Scheme.basicOpen_zero] at hs₀_ba
        exact hs₀_ba
      let b : R := φ.hom a
      refine ⟨b, ?_, ?_, ?_⟩
      · change X.basicOpen ((f.appLE U_S U_X e).hom a) ≤ U_X ⊓ W
        rw [AlgebraicGeometry.Scheme.basicOpen_appLE f U_X U_S e a]
        exact inf_le_inf_left U_X ((TopologicalSpace.Opens.map f.base).monotone ha_le)
      · have h1_ne : (1 : R) ≠ 0 := by
          let p₀ : PrimeSpectrum R := hUX.primeIdealOf ⟨x, hx⟩
          intro h10
          have h1_mem : (1 : R) ∈ p₀.asIdeal := h10 ▸ p₀.asIdeal.zero_mem
          exact (p₀.asIdeal.ne_top_iff_one.mp p₀.isPrime.ne_top) h1_mem
        have hb_not_nil : ¬ IsNilpotent b := by
          rintro ⟨n, hbn⟩
          have hsmul : (a ^ n) • (1 : R) = 0 := by
            change φ.hom (a ^ n) * (1 : R) = 0
            rw [mul_one, map_pow]
            exact hbn
          have h10 : (1 : R) = 0 :=
            (smul_eq_zero.mp hsmul).resolve_left (pow_ne_zero n ha_ne)
          exact h1_ne h10
        have hbo_ne : PrimeSpectrum.basicOpen b ≠ ⊥ := by
          intro hbot
          exact hb_not_nil ((PrimeSpectrum.basicOpen_eq_bot_iff b).mp hbot)
        obtain ⟨q, hq⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hbo_ne
        have hq' : hUX.fromSpec.base q ∈ X.basicOpen b := by
          have hpre := hUX.fromSpec_preimage_basicOpen b
          change q ∈ (TopologicalSpace.Opens.map hUX.fromSpec.base).obj (X.basicOpen b)
          rwa [hpre]
        exact ⟨⟨hUX.fromSpec.base q, hq'⟩⟩
      · let res_b := (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le b)).op).hom
        let _instAlgBo : Algebra R ↑(X.presheaf.obj (Opposite.op (X.basicOpen b))) :=
          res_b.toAlgebra
        have : IsLocalization.Away b ↑(X.presheaf.obj (Opposite.op (X.basicOpen b))) :=
          hUX.isLocalization_basicOpen b
        rw [injective_iff_map_eq_zero]
        intro r hr
        have hr' : algebraMap R ↑(X.presheaf.obj (Opposite.op (X.basicOpen b))) r = 0 := hr
        obtain ⟨⟨_, k, rfl⟩, hbk⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers b)
            ↑(X.presheaf.obj (Opposite.op (X.basicOpen b))) r).mp hr'
        have hsmul : (a ^ k) • r = 0 := by
          change φ.hom (a ^ k) * r = 0
          rw [map_pow]
          exact hbk
        exact (smul_eq_zero.mp hsmul).resolve_left (pow_ne_zero k ha_ne)
    constructor
    · rintro ⟨x₀⟩
      obtain ⟨U_S, hUS, hxUS, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := f.base x₀) (U := ⊤) trivial
      obtain ⟨U_X, hUX, hxUX, e⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x₀) (U := (TopologicalSpace.Opens.map f.base).obj U_S) hxUS
      obtain ⟨b, hba_le, ⟨⟨z, hz⟩⟩, _⟩ := hLocalBasic U_S hUS U_X hUX x₀ hxUX e
      exact ⟨⟨z, (hba_le hz).2⟩⟩
    · intro hIntW
      have : AlgebraicGeometry.IsIntegral (↑W : AlgebraicGeometry.Scheme.{u}) := hIntW
      have hIrredW : IrreducibleSpace ↥(↑W : AlgebraicGeometry.Scheme.{u}) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (↑W : AlgebraicGeometry.Scheme.{u})
      obtain ⟨w₀⟩ := hIrredW.toNonempty
      have hneX : Nonempty ↥X := ⟨w₀.1⟩
      have hIrredW' : IrreducibleSpace ↥W := hIrredW
      have hIrredSetW : IsIrreducible (W : Set X) := by
        have himg :=
          (@IrreducibleSpace.isIrreducible_univ ↥W _ hIrredW').image
            (Subtype.val : ↥W → ↥X) continuous_subtype_val.continuousOn
        rwa [Set.image_univ, Subtype.range_val] at himg
      have hDenseW : Dense (W : Set X) := by
        rw [dense_iff_inter_open]
        intro O hOpenO ⟨x, hxO⟩
        obtain ⟨U_S, hUS, hxUS, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := f.base x) (U := ⊤) trivial
        have hxInter : x ∈ (⟨O, hOpenO⟩ : X.Opens) ⊓ (TopologicalSpace.Opens.map f.base).obj U_S :=
          ⟨hxO, hxUS⟩
        obtain ⟨U_X, hUX, hxUX, hUX_sub⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hxInter
        have hUX_le : U_X ≤ (⟨O, hOpenO⟩ : X.Opens) ⊓ (TopologicalSpace.Opens.map f.base).obj U_S :=
          hUX_sub
        obtain ⟨b, hba_le, ⟨⟨z, hz⟩⟩, _⟩ :=
          hLocalBasic U_S hUS U_X hUX x hxUX (hUX_le.trans inf_le_right)
        exact ⟨z, (hUX_le (hba_le hz).1).1, (hba_le hz).2⟩
      have hIrredUniv : IsIrreducible (Set.univ : Set X) := by
        rw [← hDenseW.closure_eq]
        exact hIrredSetW.closure
      have hIrredX : IrreducibleSpace ↥X :=
        { isPreirreducible_univ := hIrredUniv.isPreirreducible
          toNonempty := hneX }
      have hRedX : AlgebraicGeometry.IsReduced X := by
        refine @AlgebraicGeometry.isReduced_of_isReduced_stalk X (fun x => ?_)
        obtain ⟨U_S, hUS, hxUS, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := f.base x) (U := ⊤) trivial
        obtain ⟨U_X, hUX, hxUX, e⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := x) (U := (TopologicalSpace.Opens.map f.base).obj U_S) hxUS
        obtain ⟨b, hba_le, _, hInj_b⟩ := hLocalBasic U_S hUS U_X hUX x hxUX e
        have hbaW : X.basicOpen b ≤ W := hba_le.trans inf_le_right
        have : AlgebraicGeometry.IsReduced (↑(X.basicOpen b) : AlgebraicGeometry.Scheme.{u}) :=
          AlgebraicGeometry.isReduced_of_isOpenImmersion (X.homOfLE hbaW)
        have hRedTop :
            _root_.IsReduced
              ↑((↑(X.basicOpen b) : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) :=
          inferInstance
        have hRedBo : _root_.IsReduced ↑(X.presheaf.obj (Opposite.op (X.basicOpen b))) :=
          @isReduced_of_injective _ _ _ _ _ _ _
            (X.basicOpen b).topIso.inv.hom
            (X.basicOpen b).topIso.commRingCatIsoToRingEquiv.symm.injective
            hRedTop
        have hRedUX : _root_.IsReduced ↑(X.presheaf.obj (Opposite.op U_X)) :=
          @isReduced_of_injective _ _ _ _ _ _ _
            (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le b)).op).hom
            hInj_b
            hRedBo
        let _instAlgStalk : Algebra ↑(X.presheaf.obj (Opposite.op U_X)) ↑(X.presheaf.stalk x) :=
          TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxUX⟩
        have : IsLocalization.AtPrime (↑(X.presheaf.stalk x))
            (hUX.primeIdealOf ⟨x, hxUX⟩).asIdeal :=
          hUX.isLocalization_stalk ⟨x, hxUX⟩
        exact isReduced_localizationPreserves
          (hUX.primeIdealOf ⟨x, hxUX⟩).asIdeal.primeCompl
          (↑(X.presheaf.stalk x))
          hRedUX
      exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced X).mpr
        ⟨hIrredX, hRedX⟩

  let fst₂ := CategoryTheory.Limits.pullback.fst f₁.left θ.left
  let snd₂ := CategoryTheory.Limits.pullback.snd f₁.left θ.left
  let Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (snd₂ ≫ S₂.hom)
  let f₂ : Y₂ ⟶ S₂ := CategoryTheory.Over.homMk snd₂ rfl
  have hq₂_w : (fst₂ ≫ q₁.left) ≫ Z₀.hom = Y₂.hom := by
    calc (fst₂ ≫ q₁.left) ≫ Z₀.hom
        = fst₂ ≫ (q₁.left ≫ Z₀.hom) := CategoryTheory.Category.assoc _ _ _
      _ = fst₂ ≫ Y₁.hom := by rw [CategoryTheory.Over.w q₁]
      _ = fst₂ ≫ (f₁.left ≫ S₁.hom) := by rw [← CategoryTheory.Over.w f₁]
      _ = (fst₂ ≫ f₁.left) ≫ S₁.hom := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (snd₂ ≫ θ.left) ≫ S₁.hom := by rw [CategoryTheory.Limits.pullback.condition]
      _ = snd₂ ≫ (θ.left ≫ S₁.hom) := CategoryTheory.Category.assoc _ _ _
      _ = Y₂.hom := by
            change _ = snd₂ ≫ S₂.hom
            rw [CategoryTheory.Over.w θ]
  let q₂ : Y₂ ⟶ Z₀ := CategoryTheory.Over.homMk (fst₂ ≫ q₁.left) hq₂_w
  have hcomm₂ : q₂.left ≫ p₀.left = f₂.left ≫ (θ ≫ ψ₁).left := by
    change (fst₂ ≫ q₁.left) ≫ p₀.left = snd₂ ≫ (θ.left ≫ ψ₁.left)
    calc (fst₂ ≫ q₁.left) ≫ p₀.left
        = fst₂ ≫ (q₁.left ≫ p₀.left) := CategoryTheory.Category.assoc _ _ _
      _ = fst₂ ≫ (f₁.left ≫ ψ₁.left) := by rw [hcomm₁]
      _ = (fst₂ ≫ f₁.left) ≫ ψ₁.left := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (snd₂ ≫ θ.left) ≫ ψ₁.left := by rw [CategoryTheory.Limits.pullback.condition]
      _ = snd₂ ≫ (θ.left ≫ ψ₁.left) := CategoryTheory.Category.assoc _ _ _

  have hProjY₂ : IsProjectiveOverField k Y₂ :=
    hSegre Y₁ S₂ S₁ f₁ θ hProjY₁ hProjS₂ hProjS₁
  have : AlgebraicGeometry.Flat f₁.left := hFlat₁
  have hFlat₂ : AlgebraicGeometry.Flat f₂.left :=
    AlgebraicGeometry.Flat.instSndScheme f₁.left θ.left

  let fst₁ := CategoryTheory.Limits.pullback.fst p₀.left ψ₁.left
  let snd₁ := CategoryTheory.Limits.pullback.snd p₀.left ψ₁.left
  let fst_tot := CategoryTheory.Limits.pullback.fst p₀.left (θ ≫ ψ₁).left
  let snd_tot := CategoryTheory.Limits.pullback.snd p₀.left (θ ≫ ψ₁).left
  let ι₁ := CategoryTheory.Limits.pullback.lift q₁.left f₁.left hcomm₁
  let ι₂ := CategoryTheory.Limits.pullback.lift q₂.left f₂.left hcomm₂

  have hν_comm : fst_tot ≫ p₀.left = (snd_tot ≫ θ.left) ≫ ψ₁.left := by
    rw [CategoryTheory.Category.assoc]
    exact CategoryTheory.Limits.pullback.condition
  let ν_mid : CategoryTheory.Limits.pullback p₀.left (θ ≫ ψ₁).left ⟶
      CategoryTheory.Limits.pullback p₀.left ψ₁.left :=
    CategoryTheory.Limits.pullback.lift fst_tot (snd_tot ≫ θ.left) hν_comm

  have hPb_mid : CategoryTheory.IsPullback ν_mid snd_tot snd₁ θ.left := by
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback p₀.left ψ₁.left)
    rw [CategoryTheory.Limits.pullback.lift_fst]
    exact CategoryTheory.IsPullback.of_hasPullback p₀.left (θ ≫ ψ₁).left

  have hPb_ι₂ : CategoryTheory.IsPullback fst₂ ι₂ ι₁ ν_mid := by
    have h_top_comm : fst₂ ≫ ι₁ = ι₂ ≫ ν_mid := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst]
        rfl
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc ι₂, CategoryTheory.Limits.pullback.lift_snd]
        exact CategoryTheory.Limits.pullback.condition
    refine CategoryTheory.IsPullback.of_bot ?_ h_top_comm hPb_mid
    rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    exact CategoryTheory.IsPullback.of_hasPullback f₁.left θ.left

  have hCl₂ : AlgebraicGeometry.IsClosedImmersion ι₂ :=
    CategoryTheory.MorphismProperty.of_isPullback hPb_ι₂ hCl₁

  let O₁_U₀ : (CategoryTheory.Limits.pullback p₀.left ψ₁.left).Opens :=
    (TopologicalSpace.Opens.map snd₁.base).obj
      ((TopologicalSpace.Opens.map ψ₁.left.base).obj U₀)
  let O₁_good : (CategoryTheory.Limits.pullback p₀.left ψ₁.left).Opens :=
    (TopologicalSpace.Opens.map snd₁.base).obj
      ((TopologicalSpace.Opens.map ψ₁.left.base).obj U_good)
  have hO₁_le : O₁_good ≤ O₁_U₀ := fun _ hx => hSub hx
  have hIso₁_good : CategoryTheory.IsIso (ι₁ ∣_ O₁_good) :=
    (hIsIsoRestrictLE ι₁ O₁_U₀ O₁_good hO₁_le hIso₁).2
  have hIso₂_pre :
      CategoryTheory.IsIso (ι₂ ∣_ ((TopologicalSpace.Opens.map ν_mid.base).obj O₁_good)) :=
    (hPullRestrictBase fst₂ ι₂ ι₁ ν_mid hPb_ι₂ O₁_good hIso₁_good).2
  let O₂_good : (CategoryTheory.Limits.pullback p₀.left (θ ≫ ψ₁).left).Opens :=
    (TopologicalSpace.Opens.map snd_tot.base).obj
      ((TopologicalSpace.Opens.map (θ ≫ ψ₁).left.base).obj U_good)
  have hO₂_eq : O₂_good = (TopologicalSpace.Opens.map ν_mid.base).obj O₁_good := by
    ext p
    have h_snd_eq : snd₁.base (ν_mid.base p) = θ.left.base (snd_tot.base p) := by
      change (ν_mid ≫ snd₁).base p = (snd_tot ≫ θ.left).base p
      rw [CategoryTheory.Limits.pullback.lift_snd]
    change ψ₁.left.base (θ.left.base (snd_tot.base p)) ∈ U_good ↔
      ψ₁.left.base (snd₁.base (ν_mid.base p)) ∈ U_good
    rw [h_snd_eq]
  have hIso₂ : CategoryTheory.IsIso (ι₂ ∣_ O₂_good) := hO₂_eq.symm ▸ hIso₂_pre

  let V₁ : S₁.left.Opens := (TopologicalSpace.Opens.map ψ₁.left.base).obj U_good
  let V₂ : S₂.left.Opens := (TopologicalSpace.Opens.map (θ ≫ ψ₁).left.base).obj U_good
  obtain ⟨u₀⟩ := hUgood
  have : CategoryTheory.IsIso (ψ₁.left ∣_ U_good) := hIsoψ₁
  have : CategoryTheory.IsIso ((θ ≫ ψ₁).left ∣_ U_good) := hIsoComp
  have hV₁ : Nonempty V₁ := ⟨(CategoryTheory.inv (ψ₁.left ∣_ U_good)).base u₀⟩
  have hV₂ : Nonempty V₂ := ⟨(CategoryTheory.inv ((θ ≫ ψ₁).left ∣_ U_good)).base u₀⟩

  have hIsoθ : CategoryTheory.IsIso (θ.left ∣_ V₁) := by
    have hComp : CategoryTheory.IsIso ((θ.left ≫ ψ₁.left) ∣_ U_good) := hIsoComp
    rw [AlgebraicGeometry.morphismRestrict_comp θ.left ψ₁.left U_good] at hComp
    have : CategoryTheory.IsIso ((θ.left ∣_ V₁) ≫ (ψ₁.left ∣_ U_good)) := hComp
    exact CategoryTheory.IsIso.of_isIso_comp_right (θ.left ∣_ V₁) (ψ₁.left ∣_ U_good)

  have : AlgebraicGeometry.IsIntegral Y₁.left := hIntY₁
  obtain ⟨y₁⟩ := (AlgebraicGeometry.irreducibleSpace_of_isIntegral Y₁.left).toNonempty
  let W₁ : Y₁.left.Opens := (TopologicalSpace.Opens.map f₁.left.base).obj V₁
  have hNe_W₁ : Nonempty ↥W₁ :=
    (hFlatIntegralOpen Y₁.left S₁.left f₁.left V₁ hIntS₁ hV₁ hFlat₁).1 ⟨y₁⟩

  have hPb_f₁θ : CategoryTheory.IsPullback snd₂ fst₂ θ.left f₁.left :=
    (CategoryTheory.IsPullback.of_hasPullback f₁.left θ.left).flip
  have hIso_fst₂ : CategoryTheory.IsIso (fst₂ ∣_ W₁) :=
    (hPullRestrictBase snd₂ fst₂ θ.left f₁.left hPb_f₁θ V₁ hIsoθ).2
  have : CategoryTheory.IsIso (fst₂ ∣_ W₁) := hIso_fst₂

  let W₂_fst : Y₂.left.Opens := (TopologicalSpace.Opens.map fst₂.base).obj W₁
  let W₂_snd : Y₂.left.Opens := (TopologicalSpace.Opens.map f₂.left.base).obj V₂
  obtain ⟨w₁⟩ := hNe_W₁
  have hNe_W₂_fst : Nonempty ↥(↑W₂_fst : AlgebraicGeometry.Scheme.{u}) :=
    ⟨(CategoryTheory.inv (fst₂ ∣_ W₁)).base w₁⟩
  have : Nonempty ↥(↑W₂_fst : AlgebraicGeometry.Scheme.{u}) := hNe_W₂_fst
  have : AlgebraicGeometry.IsOpenImmersion (fst₂ ∣_ W₁) :=
    AlgebraicGeometry.IsOpenImmersion.of_isIso (fst₂ ∣_ W₁)
  have hInt_W₂_fst : AlgebraicGeometry.IsIntegral (↑W₂_fst : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion ((fst₂ ∣_ W₁) ≫ W₁.ι)

  have hW₂_eq : W₂_snd = W₂_fst := by
    ext y
    have h_cond : θ.left.base (snd₂.base y) = f₁.left.base (fst₂.base y) := by
      change (snd₂ ≫ θ.left).base y = (fst₂ ≫ f₁.left).base y
      rw [CategoryTheory.Limits.pullback.condition]
    change ψ₁.left.base (θ.left.base (snd₂.base y)) ∈ U_good ↔
      ψ₁.left.base (f₁.left.base (fst₂.base y)) ∈ U_good
    rw [h_cond]
  have hInt_W₂_snd : AlgebraicGeometry.IsIntegral (↑W₂_snd : AlgebraicGeometry.Scheme.{u}) :=
    hW₂_eq.symm ▸ hInt_W₂_fst

  have hIntY₂ : AlgebraicGeometry.IsIntegral Y₂.left :=
    (hFlatIntegralOpen Y₂.left S₂.left f₂.left V₂ hIntS₂ hV₂ hFlat₂).2 hInt_W₂_snd

  exact ⟨Y₂, f₂, q₂, hcomm₂, hIntY₂, hProjY₂, hFlat₂, hCl₂, hIso₂⟩

theorem weil_algClosed_projective_pair_flattening_normal_base (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ)
    (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₃ : B₃.left.Opens)
    (hIntB₃ : AlgebraicGeometry.IsIntegral B₃.left)
    (hProjB₃ : IsProjectiveOverField k B₃)
    (hDimB₃ : topologicalKrullDim B₃.left = (m : WithBot ℕ∞))
    (hU₃ : Nonempty U₃)
    (X₃ T₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (pX₃ : X₃ ⟶ B₃)
    (pT₃ : T₃ ⟶ B₃)
    (hIntX₃ : AlgebraicGeometry.IsIntegral X₃.left)
    (hProjX₃ : IsProjectiveOverField k X₃)
    (hFlatX₃ : AlgebraicGeometry.Flat (pX₃.left ∣_ U₃))
    (hSurjX₃ : AlgebraicGeometry.Surjective (pX₃.left ∣_ U₃))
    (hIntT₃ : AlgebraicGeometry.IsIntegral T₃.left)
    (hProjT₃ : IsProjectiveOverField k T₃)
    (hFlatT₃ : AlgebraicGeometry.Flat (pT₃.left ∣_ U₃))
    (hSurjT₃ : AlgebraicGeometry.Surjective (pT₃.left ∣_ U₃)) :
    ∃ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U_good : B₃.left.Opens)
      (ψ₄ : B ⟶ B₃)
      (X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f_XB : X_B ⟶ B) (q_XB : X_B ⟶ X₃)
      (f_TB : T_B ⟶ B) (q_TB : T_B ⟶ T₃)
      (hcomm_XB : q_XB.left ≫ pX₃.left = f_XB.left ≫ ψ₄.left)
      (hcomm_TB : q_TB.left ≫ pT₃.left = f_TB.left ≫ ψ₄.left),
      AlgebraicGeometry.IsIntegral B.left ∧
      IsProjectiveOverField k B ∧
      IsAffineNormalScheme B.left ∧
      topologicalKrullDim B.left = (m : WithBot ℕ∞) ∧
      Nonempty U_good ∧
      (U_good : Set B₃.left) ⊆ (U₃ : Set B₃.left) ∧
      AlgebraicGeometry.IsProper ψ₄.left ∧
      AlgebraicGeometry.Surjective ψ₄.left ∧
      CategoryTheory.IsIso (ψ₄.left ∣_ U_good) ∧
      AlgebraicGeometry.IsIntegral X_B.left ∧
      IsProjectiveOverField k X_B ∧
      AlgebraicGeometry.Flat f_XB.left ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd pX₃.left ψ₄.left).base).obj
              ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))) ∧
      AlgebraicGeometry.IsIntegral T_B.left ∧
      IsProjectiveOverField k T_B ∧
      AlgebraicGeometry.Flat f_TB.left ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift q_TB.left f_TB.left hcomm_TB) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift q_TB.left f_TB.left hcomm_TB) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd pT₃.left ψ₄.left).base).obj
              ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))) :=
by
  
  have hSegre : ∀ (Y₁ Y₂ S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (a₁ : Y₁ ⟶ S) (a₂ : Y₂ ⟶ S),
      IsProjectiveOverField k Y₁ → IsProjectiveOverField k Y₂ → IsProjectiveOverField k S →
      IsProjectiveOverField k
        (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)) := by
    intro Y₁ Y₂ S a₁ a₂ hProj₁ hProj₂ hProjS
    let C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)
    let f₁ : C₁ ⟶ Y₂ :=
      CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left) rfl
    have hψ_w : CategoryTheory.Limits.pullback.fst a₁.left a₂.left ≫ Y₁.hom = C₁.hom := by
      calc CategoryTheory.Limits.pullback.fst a₁.left a₂.left ≫ Y₁.hom
          = CategoryTheory.Limits.pullback.fst a₁.left a₂.left ≫ (a₁.left ≫ S.hom) := by
              rw [← CategoryTheory.Over.w a₁]
        _ = (CategoryTheory.Limits.pullback.fst a₁.left a₂.left ≫ a₁.left) ≫ S.hom :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ a₂.left) ≫ S.hom := by
              rw [CategoryTheory.Limits.pullback.condition]
        _ = CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ (a₂.left ≫ S.hom) :=
              CategoryTheory.Category.assoc _ _ _
        _ = C₁.hom := by
              change _ = CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom
              rw [CategoryTheory.Over.w a₂]
    let ψ_C : C₁ ⟶ Y₁ :=
      CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst a₁.left a₂.left) hψ_w
    have hPb : CategoryTheory.IsPullback ψ_C.left f₁.left a₁.left a₂.left :=
      CategoryTheory.IsPullback.of_hasPullback a₁.left a₂.left
    exact weil_projectiveOverField_pullback k a₁ a₂ f₁ ψ_C hPb hProjS hProj₁ hProj₂

  
  have hRestrictPb :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (U W : Y.Opens) (hWU : W ≤ U),
        ∃ g : (f ⁻¹ᵁ W).toScheme ⟶ (f ⁻¹ᵁ U).toScheme,
          CategoryTheory.IsPullback (f ∣_ W) g (Y.homOfLE hWU) (f ∣_ U) := by
    intro X Y f U W hWU
    have hPW : CategoryTheory.IsPullback (f ∣_ W) ((f ⁻¹ᵁ W).ι) W.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f W
    have hPU : CategoryTheory.IsPullback (f ∣_ U) ((f ⁻¹ᵁ U).ι) U.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f U
    have hPre : f ⁻¹ᵁ W ≤ f ⁻¹ᵁ U := fun _ hx => hWU hx
    have hcomm : (f ∣_ W) ≫ Y.homOfLE hWU = X.homOfLE hPre ≫ (f ∣_ U) := by
      rw [← CategoryTheory.cancel_mono U.ι]
      simp [AlgebraicGeometry.morphismRestrict_ι]
    have hTop : CategoryTheory.IsPullback (f ∣_ W) (X.homOfLE hPre) (Y.homOfLE hWU) (f ∣_ U) :=
      CategoryTheory.IsPullback.of_bot (by simpa using hPW) hcomm hPU
    exact ⟨X.homOfLE hPre, hTop⟩

  have hIsIsoRestrictLE :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (U W : Y.Opens),
        W ≤ U → CategoryTheory.IsIso (f ∣_ U) → CategoryTheory.IsIso (f ∣_ W) := by
    intro X Y f U W hWU hIsoU
    haveI : CategoryTheory.IsIso (f ∣_ U) := hIsoU
    obtain ⟨_, hPb⟩ := hRestrictPb f U W hWU
    exact hPb.isIso_fst_of_isIso

  have hNonemptyPreIso :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens),
        Nonempty U → CategoryTheory.IsIso (f ∣_ U) →
        Nonempty ((TopologicalSpace.Opens.map f.base).obj U) := by
    intro X Y f U ⟨u₀⟩ hIso
    haveI : CategoryTheory.IsIso (f ∣_ U) := hIso
    exact ⟨(CategoryTheory.inv (f ∣_ U)).base u₀⟩

  have hOpenPushIso :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ Y) (U : Y.Opens) (W : X.Opens),
        CategoryTheory.IsIso (g ∣_ U) →
        Nonempty W →
        (W : Set X) ⊆ ((TopologicalSpace.Opens.map g.base).obj U : Set X) →
        ∃ U₀ : Y.Opens,
          Nonempty U₀ ∧
          (U₀ : Set Y) ⊆ (U : Set Y) ∧
          (TopologicalSpace.Opens.map g.base).obj U₀ = W ∧
          CategoryTheory.IsIso (g ∣_ U₀) := by
    intro X Y g U W hIso hW hSub
    haveI : CategoryTheory.IsIso (g ∣_ U) := hIso
    let e := CategoryTheory.asIso (g ∣_ U)
    let W_U : (g ⁻¹ᵁ U).toScheme.Opens :=
      (TopologicalSpace.Opens.map (g ⁻¹ᵁ U).ι.base).obj W
    let V_U : U.toScheme.Opens :=
      (TopologicalSpace.Opens.map e.inv.base).obj W_U
    let U₀ : Y.Opens :=
      ⟨U.ι.base '' (V_U : Set ↥U.toScheme), U.ι.isOpenEmbedding.isOpenMap _ V_U.isOpen⟩
    have hU₀_le : U₀ ≤ U := by
      rintro y ⟨u, _, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.ι_apply U u]
      exact u.2
    have hU₀_ne : Nonempty U₀ := by
      obtain ⟨⟨x, hxW⟩⟩ := hW
      have hxGU : x ∈ g ⁻¹ᵁ U := hSub hxW
      let x' : ↥(g ⁻¹ᵁ U).toScheme := ⟨x, hxGU⟩
      let u' : ↥U.toScheme := e.hom.base x'
      have hu'V : u' ∈ V_U := by
        change (g ⁻¹ᵁ U).ι.base (e.inv.base (e.hom.base x')) ∈ W
        have h_id : e.inv.base (e.hom.base x') = x' := by
          change (e.hom ≫ e.inv).base x' = x'
          rw [e.hom_inv_id]
          rfl
        rw [h_id, AlgebraicGeometry.Scheme.Opens.ι_apply]
        exact hxW
      exact ⟨⟨U.ι.base u', ⟨u', hu'V, rfl⟩⟩⟩
    have hPreEq : (TopologicalSpace.Opens.map g.base).obj U₀ = W := by
      ext x
      constructor
      · intro hxU₀
        have hxGU : x ∈ g ⁻¹ᵁ U := hU₀_le hxU₀
        let x' : ↥(g ⁻¹ᵁ U).toScheme := ⟨x, hxGU⟩
        rcases hxU₀ with ⟨u, huV, hu_eq⟩
        have h_ι_eq : U.ι.base (e.hom.base x') = U.ι.base u := by
          calc U.ι.base (e.hom.base x')
              = ((g ∣_ U) ≫ U.ι).base x' := rfl
            _ = ((g ⁻¹ᵁ U).ι ≫ g).base x' := by
                  rw [AlgebraicGeometry.morphismRestrict_ι g U]
            _ = g.base x := by
                  change g.base ((g ⁻¹ᵁ U).ι.base x') = g.base x
                  rw [AlgebraicGeometry.Scheme.Opens.ι_apply]
            _ = U.ι.base u := hu_eq.symm
        have hx'_eq : e.hom.base x' = u := U.ι.isOpenEmbedding.injective h_ι_eq
        have hx'_inv : e.inv.base u = x' := by
          rw [← hx'_eq]
          change (e.hom ≫ e.inv).base x' = x'
          rw [e.hom_inv_id]
          rfl
        have hx'W : x' ∈ W_U := hx'_inv ▸ huV
        change (g ⁻¹ᵁ U).ι.base x' ∈ W at hx'W
        rwa [AlgebraicGeometry.Scheme.Opens.ι_apply] at hx'W
      · intro hxW
        have hxGU : x ∈ g ⁻¹ᵁ U := hSub hxW
        let x' : ↥(g ⁻¹ᵁ U).toScheme := ⟨x, hxGU⟩
        let u : ↥U.toScheme := e.hom.base x'
        have huV : u ∈ V_U := by
          change (g ⁻¹ᵁ U).ι.base (e.inv.base (e.hom.base x')) ∈ W
          have h_id : e.inv.base (e.hom.base x') = x' := by
            change (e.hom ≫ e.inv).base x' = x'
            rw [e.hom_inv_id]
            rfl
          rw [h_id, AlgebraicGeometry.Scheme.Opens.ι_apply]
          exact hxW
        refine ⟨u, huV, ?_⟩
        calc U.ι.base u
            = ((g ∣_ U) ≫ U.ι).base x' := rfl
          _ = ((g ⁻¹ᵁ U).ι ≫ g).base x' := by
                rw [AlgebraicGeometry.morphismRestrict_ι g U]
          _ = g.base x := by
                change g.base ((g ⁻¹ᵁ U).ι.base x') = g.base x
                rw [AlgebraicGeometry.Scheme.Opens.ι_apply]
    exact ⟨U₀, hU₀_ne, hU₀_le, hPreEq, hIsIsoRestrictLE g U U₀ hU₀_le hIso⟩

  have hPullRestrictBase :
      ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
        (fst : P ⟶ X) (snd : P ⟶ Y) (f : X ⟶ Z) (g : Y ⟶ Z),
        CategoryTheory.IsPullback fst snd f g →
        ∀ (U : Z.Opens),
          CategoryTheory.IsIso (f ∣_ U) →
          CategoryTheory.IsIso (snd ∣_ (g ⁻¹ᵁ U)) := by
    intro P X Y Z fst snd f g hPb U hIsoF
    haveI : CategoryTheory.IsIso (f ∣_ U) := hIsoF
    have hTop : CategoryTheory.IsPullback (snd ∣_ (g ⁻¹ᵁ U)) (snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι
        (g ⁻¹ᵁ U).ι snd :=
      AlgebraicGeometry.isPullback_morphismRestrict snd (g ⁻¹ᵁ U)
    have hBot : CategoryTheory.IsPullback (f ∣_ U) (f ⁻¹ᵁ U).ι U.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f U
    have hOuter' : CategoryTheory.IsPullback (snd ∣_ (g ⁻¹ᵁ U))
        ((snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι ≫ fst) ((g ∣_ U) ≫ U.ι) f := by
      rw [AlgebraicGeometry.morphismRestrict_ι g U]
      exact hTop.paste_vert hPb.flip
    let r_U : (snd ⁻¹ᵁ (g ⁻¹ᵁ U)).toScheme ⟶ (f ⁻¹ᵁ U).toScheme :=
      hBot.lift ((snd ∣_ (g ⁻¹ᵁ U)) ≫ (g ∣_ U)) ((snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι ≫ fst)
        (by rw [CategoryTheory.Category.assoc]; exact hOuter'.w)
    have hr_ι : r_U ≫ (f ⁻¹ᵁ U).ι = (snd ⁻¹ᵁ (g ⁻¹ᵁ U)).ι ≫ fst :=
      hBot.lift_snd _ _ _
    have hr_comm : (snd ∣_ (g ⁻¹ᵁ U)) ≫ (g ∣_ U) = r_U ≫ (f ∣_ U) :=
      hBot.lift_fst _ _ _ |>.symm
    have hSq' : CategoryTheory.IsPullback (snd ∣_ (g ⁻¹ᵁ U)) r_U (g ∣_ U) (f ∣_ U) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hr_comm hBot
      rw [hr_ι]
      exact hOuter'
    exact hSq'.isIso_fst_of_isIso

  
  obtain ⟨B', U'₃, ψ'₄, X_B', f_XB', q_XB', hcomm_XB',
      hIntB', hProjB', hU'₃, hU'₃Sub, hPropψ'₄, hSurjψ'₄, hIsoψ'₄,
      hIntXB', hProjXB', hFlatXB', hClXB', hIsoXB'⟩ :=
    weil_projective_single_flattening k hSegre
      (fun N K _ I_η => weil_macaulay_hilbert_persistence_bound N K I_η)
      B₃ U₃ hIntB₃ hProjB₃ hU₃ X₃ pX₃ hIntX₃ hProjX₃ hFlatX₃ hSurjX₃

  obtain ⟨_, hPbT₃_res⟩ := hRestrictPb pT₃.left U₃ U'₃ hU'₃Sub
  have hFlatT₃_U'₃ : AlgebraicGeometry.Flat (pT₃.left ∣_ U'₃) :=
    CategoryTheory.MorphismProperty.of_isPullback hPbT₃_res.flip hFlatT₃
  have hSurjT₃_U'₃ : AlgebraicGeometry.Surjective (pT₃.left ∣_ U'₃) :=
    CategoryTheory.MorphismProperty.of_isPullback hPbT₃_res.flip hSurjT₃

  obtain ⟨T'_B', p'_T, q'_T, hcomm'_T,
      hIntT'B', hProjT'B', hFlatT'B', hSurjT'B', hClT'B', hIsoT'B'⟩ :=
    weil_projective_openFlat_strictTransform k hSegre
      B₃ B' T₃ U'₃ ψ'₄ pT₃ hProjB₃ hProjB' hU'₃ hIsoψ'₄
      hIntT₃ hProjT₃ hFlatT₃_U'₃ hSurjT₃_U'₃

  let V'₃ : B'.left.Opens := (TopologicalSpace.Opens.map ψ'₄.left.base).obj U'₃
  have hV'₃ : Nonempty V'₃ := hNonemptyPreIso ψ'₄.left U'₃ hU'₃ hIsoψ'₄

  obtain ⟨B'', V''₃, ψ''₄, T_B'', f_TB'', q''_T, hcomm''_T,
      hIntB'', hProjB'', hV''₃, hV''₃Sub, hPropψ''₄, hSurjψ''₄, hIsoψ''₄,
      hIntTB'', hProjTB'', hFlatTB'', hClTB'', hIsoTB''⟩ :=
    weil_projective_single_flattening k hSegre
      (fun N K _ I_η => weil_macaulay_hilbert_persistence_bound N K I_η)
      B' V'₃ hIntB' hProjB' hV'₃ T'_B' p'_T hIntT'B' hProjT'B' hFlatT'B' hSurjT'B'

  obtain ⟨U''₃, hU''₃, hU''₃_le_U'₃, hPreU''₃, hIsoψ'₄_U''₃⟩ :=
    hOpenPushIso ψ'₄.left U'₃ V''₃ hIsoψ'₄ hV''₃ hV''₃Sub

  let ψ₄₂ : B'' ⟶ B₃ := ψ''₄ ≫ ψ'₄
  have hIsoψ₄₂_U''₃ : CategoryTheory.IsIso (ψ₄₂.left ∣_ U''₃) := by
    change CategoryTheory.IsIso ((ψ''₄.left ≫ ψ'₄.left) ∣_ U''₃)
    rw [AlgebraicGeometry.morphismRestrict_comp]
    have hIso_left : CategoryTheory.IsIso (ψ''₄.left ∣_ (ψ'₄.left ⁻¹ᵁ U''₃)) := by
      change CategoryTheory.IsIso (ψ''₄.left ∣_ ((TopologicalSpace.Opens.map ψ'₄.left.base).obj U''₃))
      rw [hPreU''₃]
      exact hIsoψ''₄
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_left hIsoψ'₄_U''₃

  
  let q_TB'' : T_B'' ⟶ T₃ := q''_T ≫ q'_T
  have hcomm_TB'' : q_TB''.left ≫ pT₃.left = f_TB''.left ≫ ψ₄₂.left := by
    calc (q''_T.left ≫ q'_T.left) ≫ pT₃.left
        = q''_T.left ≫ (q'_T.left ≫ pT₃.left) := CategoryTheory.Category.assoc _ _ _
      _ = q''_T.left ≫ (p'_T.left ≫ ψ'₄.left) := by rw [hcomm'_T]
      _ = (q''_T.left ≫ p'_T.left) ≫ ψ'₄.left := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (f_TB''.left ≫ ψ''₄.left) ≫ ψ'₄.left := by rw [hcomm''_T]
      _ = f_TB''.left ≫ (ψ''₄.left ≫ ψ'₄.left) := CategoryTheory.Category.assoc _ _ _

  let fst₁ := CategoryTheory.Limits.pullback.fst pT₃.left ψ'₄.left
  let snd₁ := CategoryTheory.Limits.pullback.snd pT₃.left ψ'₄.left
  let fst₂ := CategoryTheory.Limits.pullback.fst p'_T.left ψ''₄.left
  let snd₂ := CategoryTheory.Limits.pullback.snd p'_T.left ψ''₄.left
  let fst_tot := CategoryTheory.Limits.pullback.fst pT₃.left ψ₄₂.left
  let snd_tot := CategoryTheory.Limits.pullback.snd pT₃.left ψ₄₂.left
  let ι'_T := CategoryTheory.Limits.pullback.lift q'_T.left p'_T.left hcomm'_T
  let ι''_T := CategoryTheory.Limits.pullback.lift q''_T.left f_TB''.left hcomm''_T
  let ι_tot := CategoryTheory.Limits.pullback.lift q_TB''.left f_TB''.left hcomm_TB''

  have hν_mid_comm : fst_tot ≫ pT₃.left = (snd_tot ≫ ψ''₄.left) ≫ ψ'₄.left := by
    rw [CategoryTheory.Category.assoc]
    exact CategoryTheory.Limits.pullback.condition
  let ν_mid : CategoryTheory.Limits.pullback pT₃.left ψ₄₂.left ⟶
      CategoryTheory.Limits.pullback pT₃.left ψ'₄.left :=
    CategoryTheory.Limits.pullback.lift fst_tot (snd_tot ≫ ψ''₄.left) hν_mid_comm

  have hPb_mid : CategoryTheory.IsPullback ν_mid snd_tot snd₁ ψ''₄.left := by
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback pT₃.left ψ'₄.left)
    rw [CategoryTheory.Limits.pullback.lift_fst]
    exact CategoryTheory.IsPullback.of_hasPullback pT₃.left ψ₄₂.left

  have hμ_comm : (fst₂ ≫ q'_T.left) ≫ pT₃.left = snd₂ ≫ ψ₄₂.left := by
    calc (fst₂ ≫ q'_T.left) ≫ pT₃.left
        = fst₂ ≫ (q'_T.left ≫ pT₃.left) := CategoryTheory.Category.assoc _ _ _
      _ = fst₂ ≫ (p'_T.left ≫ ψ'₄.left) := by rw [hcomm'_T]
      _ = (fst₂ ≫ p'_T.left) ≫ ψ'₄.left := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (snd₂ ≫ ψ''₄.left) ≫ ψ'₄.left := by rw [CategoryTheory.Limits.pullback.condition]
      _ = snd₂ ≫ ψ₄₂.left := CategoryTheory.Category.assoc _ _ _
  let μ : CategoryTheory.Limits.pullback p'_T.left ψ''₄.left ⟶
      CategoryTheory.Limits.pullback pT₃.left ψ₄₂.left :=
    CategoryTheory.Limits.pullback.lift (fst₂ ≫ q'_T.left) snd₂ hμ_comm

  have hPb_μ : CategoryTheory.IsPullback fst₂ μ ι'_T ν_mid := by
    have h_top_comm : fst₂ ≫ ι'_T = μ ≫ ν_mid := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc μ, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.condition]
    refine CategoryTheory.IsPullback.of_bot ?_ h_top_comm hPb_mid
    rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    exact CategoryTheory.IsPullback.of_hasPullback p'_T.left ψ''₄.left

  have hι_tot_fac : ι_tot = ι''_T ≫ μ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst]
      rfl
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]

  have hCl_μ : AlgebraicGeometry.IsClosedImmersion μ :=
    CategoryTheory.MorphismProperty.of_isPullback hPb_μ hClT'B'
  haveI : AlgebraicGeometry.IsClosedImmersion ι''_T := hClTB''
  haveI : AlgebraicGeometry.IsClosedImmersion μ := hCl_μ
  have hCl_tot : AlgebraicGeometry.IsClosedImmersion ι_tot := by
    rw [hι_tot_fac]
    infer_instance

  let O_tot : (CategoryTheory.Limits.pullback pT₃.left ψ₄₂.left).Opens :=
    (TopologicalSpace.Opens.map snd_tot.base).obj
      ((TopologicalSpace.Opens.map ψ₄₂.left.base).obj U''₃)
  have hIso_tot : CategoryTheory.IsIso (ι_tot ∣_ O_tot) := by
    let O₁_U' : (CategoryTheory.Limits.pullback pT₃.left ψ'₄.left).Opens :=
      (TopologicalSpace.Opens.map snd₁.base).obj
        ((TopologicalSpace.Opens.map ψ'₄.left.base).obj U'₃)
    let O₁_V'' : (CategoryTheory.Limits.pullback pT₃.left ψ'₄.left).Opens :=
      (TopologicalSpace.Opens.map snd₁.base).obj V''₃
    have hO₁_le : O₁_V'' ≤ O₁_U' := fun _ hx => hV''₃Sub hx
    have hIso_ι'_O₁ : CategoryTheory.IsIso (ι'_T ∣_ O₁_V'') :=
      hIsIsoRestrictLE ι'_T O₁_U' O₁_V'' hO₁_le hIsoT'B'
    have hIso_μ_pre : CategoryTheory.IsIso (μ ∣_ (ν_mid ⁻¹ᵁ O₁_V'')) :=
      hPullRestrictBase fst₂ μ ι'_T ν_mid hPb_μ O₁_V'' hIso_ι'_O₁
    have hO_tot_eq : O_tot = ν_mid ⁻¹ᵁ O₁_V'' := by
      ext p
      have hPreψ₄₂ : (TopologicalSpace.Opens.map ψ₄₂.left.base).obj U''₃ =
          (TopologicalSpace.Opens.map ψ''₄.left.base).obj V''₃ := by
        rw [← hPreU''₃]
        rfl
      change p ∈ (TopologicalSpace.Opens.map snd_tot.base).obj
        ((TopologicalSpace.Opens.map ψ₄₂.left.base).obj U''₃) ↔
        snd₁.base (ν_mid.base p) ∈ V''₃
      rw [hPreψ₄₂]
      have h_snd_eq : snd₁.base (ν_mid.base p) = ψ''₄.left.base (snd_tot.base p) := by
        change (ν_mid ≫ snd₁).base p = (snd_tot ≫ ψ''₄.left).base p
        rw [CategoryTheory.Limits.pullback.lift_snd]
      rw [h_snd_eq]
      rfl
    have hIso_μ : CategoryTheory.IsIso (μ ∣_ O_tot) := hO_tot_eq.symm ▸ hIso_μ_pre
    have hPre_μ_eq : μ ⁻¹ᵁ O_tot =
        (TopologicalSpace.Opens.map snd₂.base).obj
          ((TopologicalSpace.Opens.map ψ''₄.left.base).obj V''₃) := by
      ext p
      have h_μ_snd : snd_tot.base (μ.base p) = snd₂.base p := by
        change (μ ≫ snd_tot).base p = snd₂.base p
        rw [CategoryTheory.Limits.pullback.lift_snd]
      change ψ₄₂.left.base (snd_tot.base (μ.base p)) ∈ U''₃ ↔
        ψ''₄.left.base (snd₂.base p) ∈ V''₃
      rw [h_μ_snd]
      change ψ''₄.left.base (snd₂.base p) ∈
        (TopologicalSpace.Opens.map ψ'₄.left.base).obj U''₃ ↔ _
      rw [hPreU''₃]
    have hIso_ι''_pre : CategoryTheory.IsIso (ι''_T ∣_ (μ ⁻¹ᵁ O_tot)) :=
      hPre_μ_eq.symm ▸ hIsoTB''
    rw [hι_tot_fac, AlgebraicGeometry.morphismRestrict_comp]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_ι''_pre hIso_μ

  
  obtain ⟨B, ν_B, U_ν, hIntB, hFinν, hPropν, hSurjν, hUν, hIsoν_Uν, hNormCov⟩ :=
    weil_algClosed_scheme_normalization_finite_birational k B'' hIntB'' hProjB''
      (fun A _ _ _ _ K _ _ _ => weil_algClosed_finiteType_domain_integralClosure_finite k A K)

  have hNormB : IsAffineNormalScheme B.left := by
    intro V hV hneV
    haveI : AlgebraicGeometry.IsIntegral B.left := hIntB
    haveI : Nonempty ↥V := hneV
    let R := ↑(B.left.presheaf.obj (Opposite.op V))
    let K := ↑B.left.functionField
    haveI hDomR : IsDomain R :=
      @AlgebraicGeometry.IsIntegral.component_integral B.left hIntB V hneV
    refine ⟨hDomR, ?_⟩
    haveI : IsFractionRing R K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen B.left V hV
    let s : Set R :=
      { f : R |
        Nonempty (B.left.basicOpen f) ∧
        IsIntegrallyClosed ↑(B.left.presheaf.obj (Opposite.op (B.left.basicOpen f))) }
    have hV_le_sup : V ≤ ⨆ f : s, B.left.basicOpen (f : R) := by
      intro x hxV
      obtain ⟨U, hU, hxU, hICU⟩ := hNormCov x
      have hneU : Nonempty ↥U := ⟨⟨x, hxU⟩⟩
      haveI : IsDomain ↑(B.left.presheaf.obj (Opposite.op U)) :=
        @AlgebraicGeometry.IsIntegral.component_integral B.left hIntB U hneU
      haveI : IsIntegrallyClosed ↑(B.left.presheaf.obj (Opposite.op U)) := hICU
      obtain ⟨f, g, hfg, hxBf⟩ :=
        AlgebraicGeometry.exists_basicOpen_le_affine_inter hV hU x ⟨hxV, hxU⟩
      have hneBf : Nonempty (B.left.basicOpen f) := ⟨⟨x, hxBf⟩⟩
      have hg_ne : g ≠ 0 := by
        intro hg0
        rw [hfg, hg0, AlgebraicGeometry.Scheme.basicOpen_zero] at hxBf
        exact hxBf
      have hPowNzd :
          Submonoid.powers g ≤ nonZeroDivisors ↑(B.left.presheaf.obj (Opposite.op U)) := by
        rintro _ ⟨n, rfl⟩
        exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hg_ne)
      let res_Ug := B.left.presheaf.map (CategoryTheory.homOfLE (B.left.basicOpen_le g)).op
      letI : Algebra ↑(B.left.presheaf.obj (Opposite.op U))
          ↑(B.left.presheaf.obj (Opposite.op (B.left.basicOpen g))) :=
        res_Ug.hom.toAlgebra
      haveI : IsLocalization.Away g
          ↑(B.left.presheaf.obj (Opposite.op (B.left.basicOpen g))) :=
        hU.isLocalization_basicOpen g
      have hIC_Bg : IsIntegrallyClosed
          ↑(B.left.presheaf.obj (Opposite.op (B.left.basicOpen g))) :=
        isIntegrallyClosed_of_isLocalization _ (Submonoid.powers g) hPowNzd
      have hIC_Bf : IsIntegrallyClosed
          ↑(B.left.presheaf.obj (Opposite.op (B.left.basicOpen f))) := by
        rwa [hfg]
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hneBf, hIC_Bf⟩, hxBf⟩
    have hSpanTop : Ideal.span s = ⊤ := (hV.self_le_iSup_basicOpen_iff).mp hV_le_sup
    rw [isIntegrallyClosed_iff K]
    intro z hz
    let J_z : Ideal R :=
      { carrier := { r : R | ∃ a : R, algebraMap R K r * z = algebraMap R K a }
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro r₁ r₂ ⟨a₁, ha₁⟩ ⟨a₂, ha₂⟩
          exact ⟨a₁ + a₂, by rw [map_add, add_mul, ha₁, ha₂, map_add]⟩
        smul_mem' := by
          rintro c r ⟨a, ha⟩
          refine ⟨c * a, ?_⟩
          rw [smul_eq_mul, map_mul, mul_assoc, ha, map_mul] }
    have hs_rad : s ⊆ (J_z.radical : Set R) := by
      rintro f ⟨hneD, hICD⟩
      let D : B.left.Opens := B.left.basicOpen f
      have hD : AlgebraicGeometry.IsAffineOpen D := hV.basicOpen f
      haveI : Nonempty ↥D := hneD
      let C := ↑(B.left.presheaf.obj (Opposite.op D))
      haveI : IsDomain C := @AlgebraicGeometry.IsIntegral.component_integral B.left hIntB D hneD
      haveI : IsIntegrallyClosed C := hICD
      let res_VD := B.left.presheaf.map (CategoryTheory.homOfLE (B.left.basicOpen_le f)).op
      letI : Algebra R C := res_VD.hom.toAlgebra
      haveI : IsLocalization.Away f C := hV.isLocalization_basicOpen f
      haveI : IsFractionRing C K :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen B.left D hD
      have h_germ : res_VD ≫ B.left.germToFunctionField D = B.left.germToFunctionField V :=
        TopCat.Presheaf.germ_res B.left.presheaf
          (CategoryTheory.homOfLE (B.left.basicOpen_le f)) _ _
      haveI : IsScalarTower R C K := by
        refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
        exact (congrArg (fun φ => φ.hom r) h_germ).symm
      have hzC : _root_.IsIntegral C z := _root_.IsIntegral.tower_top hz
      obtain ⟨c, hc⟩ := (isIntegrallyClosed_iff K).mp hICD hzC
      obtain ⟨n, a, hca⟩ := IsLocalization.Away.surj f c
      refine ⟨n, a, ?_⟩
      have hK := congrArg (algebraMap C K) hca
      rw [map_mul, map_pow, hc, ← IsScalarTower.algebraMap_apply R C K f,
        ← IsScalarTower.algebraMap_apply R C K a, ← map_pow, mul_comm] at hK
      exact hK
    have hTop_le : (⊤ : Ideal R) ≤ J_z.radical := hSpanTop ▸ Ideal.span_le.mpr hs_rad
    obtain ⟨n, hn1⟩ := hTop_le trivial
    rw [one_pow] at hn1
    obtain ⟨a, ha⟩ := hn1
    refine ⟨a, ?_⟩
    rw [map_one, one_mul] at ha
    exact ha.symm

  obtain ⟨hProjB, _⟩ :=
    weil_isFinite_projective_and_krullDim_over_field k ν_B hIntB hIntB'' hProjB'' hFinν hSurjν

  
  let W''₃ : B''.left.Opens := (TopologicalSpace.Opens.map ψ₄₂.left.base).obj U''₃
  have hW''₃ : Nonempty W''₃ := hNonemptyPreIso ψ₄₂.left U''₃ hU''₃ hIsoψ₄₂_U''₃
  let W_good : B''.left.Opens := W''₃ ⊓ U_ν
  have hWgood : Nonempty W_good := by
    haveI : IrreducibleSpace ↥B''.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral B''.left
    obtain ⟨⟨w₁, hw₁⟩⟩ := hW''₃
    obtain ⟨⟨w₂, hw₂⟩⟩ := hUν
    obtain ⟨w₀, _, hw₀₁, hw₀₂⟩ :=
      PreirreducibleSpace.isPreirreducible_univ W''₃.1 U_ν.1 W''₃.isOpen U_ν.isOpen
        ⟨w₁, trivial, hw₁⟩ ⟨w₂, trivial, hw₂⟩
    exact ⟨⟨w₀, hw₀₁, hw₀₂⟩⟩
  have hIsoν_Wgood : CategoryTheory.IsIso (ν_B.left ∣_ W_good) :=
    hIsIsoRestrictLE ν_B.left U_ν W_good inf_le_right hIsoν_Uν

  obtain ⟨U_good, hUgood, hUgood_le_U''₃, hPreUgood, hIsoψ₄₂_Ugood⟩ :=
    hOpenPushIso ψ₄₂.left U''₃ W_good hIsoψ₄₂_U''₃ hWgood inf_le_left

  have hUgood_le_U'₃ : U_good ≤ U'₃ := hUgood_le_U''₃.trans hU''₃_le_U'₃
  have hUgoodSub : (U_good : Set B₃.left) ⊆ (U₃ : Set B₃.left) :=
    hUgood_le_U'₃.trans hU'₃Sub
  have hIsoψ'₄_Ugood : CategoryTheory.IsIso (ψ'₄.left ∣_ U_good) :=
    hIsIsoRestrictLE ψ'₄.left U'₃ U_good hUgood_le_U'₃ hIsoψ'₄

  let ψ₄ : B ⟶ B₃ := ν_B ≫ ψ₄₂
  haveI : AlgebraicGeometry.IsProper ν_B.left := hPropν
  haveI : AlgebraicGeometry.IsProper ψ''₄.left := hPropψ''₄
  haveI : AlgebraicGeometry.IsProper ψ'₄.left := hPropψ'₄
  haveI : AlgebraicGeometry.Surjective ν_B.left := hSurjν
  haveI : AlgebraicGeometry.Surjective ψ''₄.left := hSurjψ''₄
  haveI : AlgebraicGeometry.Surjective ψ'₄.left := hSurjψ'₄
  have hPropψ₄ : AlgebraicGeometry.IsProper ψ₄.left := by
    change AlgebraicGeometry.IsProper (ν_B.left ≫ ψ''₄.left ≫ ψ'₄.left)
    infer_instance
  have hSurjψ₄ : AlgebraicGeometry.Surjective ψ₄.left := by
    change AlgebraicGeometry.Surjective (ν_B.left ≫ ψ''₄.left ≫ ψ'₄.left)
    infer_instance
  have hIsoψ₄ : CategoryTheory.IsIso (ψ₄.left ∣_ U_good) := by
    change CategoryTheory.IsIso ((ν_B.left ≫ ψ₄₂.left) ∣_ U_good)
    rw [AlgebraicGeometry.morphismRestrict_comp]
    have hIso_ν_pre : CategoryTheory.IsIso (ν_B.left ∣_ (ψ₄₂.left ⁻¹ᵁ U_good)) := by
      change CategoryTheory.IsIso
        (ν_B.left ∣_ ((TopologicalSpace.Opens.map ψ₄₂.left.base).obj U_good))
      rw [hPreUgood]
      exact hIsoν_Wgood
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_ν_pre hIsoψ₄₂_Ugood

  haveI hFT_B₃ : AlgebraicGeometry.LocallyOfFiniteType B₃.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjB₃
    haveI : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    haveI : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    haveI : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  haveI : CategoryTheory.IsIso (ψ₄.left ∣_ U_good) := hIsoψ₄
  have hDimB : topologicalKrullDim B.left = (m : WithBot ℕ∞) :=
    (weil_birational_iso_on_open_krullDim_eq k B B₃ hIntB hProjB hIntB₃ ψ₄ U_good hUgood).trans
      hDimB₃

  have hψ₄_assoc : (ν_B ≫ ψ''₄) ≫ ψ'₄ = ψ₄ := CategoryTheory.Category.assoc ν_B ψ''₄ ψ'₄
  have hIso_assoc : CategoryTheory.IsIso (((ν_B ≫ ψ''₄) ≫ ψ'₄).left ∣_ U_good) := by
    rw [hψ₄_assoc]
    exact hIsoψ₄

  obtain ⟨X_B, f_XB, q_XB, hcomm_XB_raw, hIntXB, hProjXB, hFlatXB, hClXB_raw, hIsoXB_raw⟩ :=
    weil_projective_flat_strictTransform_pullback k hSegre
      B₃ B' B X₃ X_B' U'₃ U_good ψ'₄ (ν_B ≫ ψ''₄) pX₃ f_XB' q_XB' hcomm_XB'
      hIntB' hIntB hProjB' hProjB hIntXB' hProjXB' hFlatXB' hClXB' hIsoXB'
      hUgood hUgood_le_U'₃ hIsoψ'₄_Ugood hIso_assoc

  obtain ⟨T_B, f_TB, q_TB, hcomm_TB, hIntTB, hProjTB, hFlatTB, hClTB, hIsoTB⟩ :=
    weil_projective_flat_strictTransform_pullback k hSegre
      B₃ B'' B T₃ T_B'' U''₃ U_good ψ₄₂ ν_B pT₃ f_TB'' q_TB'' hcomm_TB''
      hIntB'' hIntB hProjB'' hProjB hIntTB'' hProjTB'' hFlatTB'' hCl_tot hIso_tot
      hUgood hUgood_le_U''₃ hIsoψ₄₂_Ugood hIsoψ₄

  have hXB_transport :
      ∀ (ψ_gen : B ⟶ B₃), (ν_B ≫ ψ''₄) ≫ ψ'₄ = ψ_gen →
        ∃ (hcomm_XB : q_XB.left ≫ pX₃.left = f_XB.left ≫ ψ_gen.left),
          AlgebraicGeometry.IsClosedImmersion
            (CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∧
          CategoryTheory.IsIso
            ((CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∣_
              ((TopologicalSpace.Opens.map
                (CategoryTheory.Limits.pullback.snd pX₃.left ψ_gen.left).base).obj
                  ((TopologicalSpace.Opens.map ψ_gen.left.base).obj U_good))) := by
    rintro _ rfl
    exact ⟨hcomm_XB_raw, hClXB_raw, hIsoXB_raw⟩
  obtain ⟨hcomm_XB, hClXB, hIsoXB⟩ := hXB_transport ψ₄ hψ₄_assoc

  exact ⟨B, U_good, ψ₄, X_B, T_B, f_XB, q_XB, f_TB, q_TB,
    hcomm_XB, hcomm_TB,
    hIntB, hProjB, hNormB, hDimB, hUgood, hUgoodSub,
    hPropψ₄, hSurjψ₄, hIsoψ₄,
    hIntXB, hProjXB, hFlatXB, hClXB, hIsoXB,
    hIntTB, hProjTB, hFlatTB, hClTB, hIsoTB⟩

theorem weil_semistable_pointed_curve_pullback (k : Type u) [Field k]
    {B C B₁ C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (U_B : B.left.Opens) (U_B₁ : B₁.left.Opens)
    (f : C ⟶ B) (ψ : B₁ ⟶ B) (f₁ : C₁ ⟶ B₁) (ψ_C : C₁ ⟶ C)
    (n : ℕ) (τ : Fin n → (B ⟶ C)) (τ₁ : Fin n → (B₁ ⟶ C₁))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hPb : CategoryTheory.IsPullback ψ_C.left f₁.left f.left ψ.left)
    (hU_sub : (U_B₁ : Set B₁.left) ⊆ ψ.left.base ⁻¹' (U_B : Set B.left))
    (hτ₁_f₁ : ∀ j : Fin n, τ₁ j ≫ f₁ = 𝟙 B₁)
    (hτ₁_ψ : ∀ j : Fin n, τ₁ j ≫ ψ_C = ψ ≫ τ j) :
    IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁ :=
by
  obtain ⟨hFlat, hProp, hLfp, hSurj, hConn, hSmU, _hSec, hDisj, hSmSec, hLocal⟩ := hCurve
  have hOpenSm : ∀ (V : C.left.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f.left) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 ((ψ_C.left ⁻¹ᵁ V).ι ≫ f₁.left) := by
    intro V hSmV
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      ((AlgebraicGeometry.isPullback_morphismRestrict ψ_C.left V).paste_vert hPb) hSmV
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, hτ₁_f₁, ?_, ?_, ?_⟩
  · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hFlat
  · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hProp
  · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hLfp
  · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hSurj
  · intro K _ _ s₁
    have hPb_fib := (CategoryTheory.IsPullback.of_hasPullback f₁.left s₁).paste_horiz hPb
    let e := AlgebraicGeometry.Scheme.homeoOfIso hPb_fib.isoPullback
    have hConn_base : ConnectedSpace ↥(CategoryTheory.Limits.pullback f.left (s₁ ≫ ψ.left)) :=
      hConn K (s₁ ≫ ψ.left)
    rw [connectedSpace_iff_univ] at hConn_base ⊢
    simpa [Set.preimage_univ] using e.isConnected_preimage.mpr hConn_base
  · have hU_le : U_B₁ ≤ ψ.left ⁻¹ᵁ U_B := hU_sub
    let ψ_U : U_B₁.toScheme ⟶ U_B.toScheme := B₁.left.homOfLE hU_le ≫ (ψ.left ∣_ U_B)
    have hψU : ψ_U ≫ U_B.ι = U_B₁.ι ≫ ψ.left := by
      dsimp [ψ_U]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
    have hPb_outer :
        CategoryTheory.IsPullback (f₁.left ∣_ U_B₁) ((f₁.left ⁻¹ᵁ U_B₁).ι ≫ ψ_C.left)
          (ψ_U ≫ U_B.ι) f.left := by
      have hp := (AlgebraicGeometry.isPullback_morphismRestrict f₁.left U_B₁).paste_vert hPb.flip
      rwa [← hψU] at hp
    have hPb_UB := AlgebraicGeometry.isPullback_morphismRestrict f.left U_B
    let ψ_CU := hPb_UB.lift ((f₁.left ∣_ U_B₁) ≫ ψ_U) ((f₁.left ⁻¹ᵁ U_B₁).ι ≫ ψ_C.left) (by
      rw [CategoryTheory.Category.assoc]
      exact hPb_outer.w)
    have hPb_res : CategoryTheory.IsPullback (f₁.left ∣_ U_B₁) ψ_CU ψ_U (f.left ∣_ U_B) := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_UB
      · simpa [ψ_CU, hPb_UB.lift_snd] using hPb_outer
      · exact (hPb_UB.lift_fst _ _ _).symm
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_res.flip hSmU
  · intro i j hij
    rw [Set.disjoint_left]
    rintro x₁ ⟨b₁, rfl⟩ ⟨b₂, hb₂⟩
    have hi_pt : ψ_C.left.base ((τ₁ i).left.base b₁) = (τ i).left.base (ψ.left.base b₁) :=
      congrArg (fun m : B₁ ⟶ C => m.left.base b₁) (hτ₁_ψ i)
    have hj_pt : ψ_C.left.base ((τ₁ j).left.base b₂) = (τ j).left.base (ψ.left.base b₂) :=
      congrArg (fun m : B₁ ⟶ C => m.left.base b₂) (hτ₁_ψ j)
    refine Set.disjoint_left.mp (hDisj hij) ⟨ψ.left.base b₁, hi_pt.symm⟩ ⟨ψ.left.base b₂, ?_⟩
    rw [← hj_pt, hb₂]
  · intro j b₁
    obtain ⟨V, hV_mem, hV_sm⟩ := hSmSec j (ψ.left.base b₁)
    refine ⟨ψ_C.left ⁻¹ᵁ V, ?_, hOpenSm V hV_sm⟩
    have hj_pt : ψ_C.left.base ((τ₁ j).left.base b₁) = (τ j).left.base (ψ.left.base b₁) :=
      congrArg (fun m : B₁ ⟶ C => m.left.base b₁) (hτ₁_ψ j)
    change ψ_C.left.base ((τ₁ j).left.base b₁) ∈ V
    rwa [hj_pt]
  · intro x₁
    rcases hLocal (ψ_C.left.base x₁) with ⟨V, hxV, hV_sm⟩ |
      ⟨R', e_B, h, V', v₀, e_C, q, he_B, he_C, hq, hv₀, hXi, hCh, hcomm⟩
    · exact Or.inl ⟨ψ_C.left ⁻¹ᵁ V, hxV, hOpenSm V hV_sm⟩
    · right
      let I : Ideal (MvPolynomial (Fin 2) R') :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
      let Q : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 2) R' ⧸ I)
      let c₀ : R' ⟶ Q := CommRingCat.ofHom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
      let p₀ : AlgebraicGeometry.Spec Q ⟶ AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map c₀
      let W' := CategoryTheory.Limits.pullback e_C ψ_C.left
      let π_V : W' ⟶ V' := CategoryTheory.Limits.pullback.fst e_C ψ_C.left
      let eC_tilde : W' ⟶ C₁.left := CategoryTheory.Limits.pullback.snd e_C ψ_C.left
      have hPb_W' : CategoryTheory.IsPullback π_V eC_tilde e_C ψ_C.left :=
        CategoryTheory.IsPullback.of_hasPullback e_C ψ_C.left
      have hEt_eC_tilde : AlgebraicGeometry.Etale eC_tilde :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_W' he_C
      obtain ⟨w₀, hw₀_V, hw₀_C₁⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_W' v₀ x₁ hv₀
      let W_B := CategoryTheory.Limits.pullback e_B ψ.left
      let π_R' : W_B ⟶ AlgebraicGeometry.Spec R' := CategoryTheory.Limits.pullback.fst e_B ψ.left
      let eB_tilde : W_B ⟶ B₁.left := CategoryTheory.Limits.pullback.snd e_B ψ.left
      have hPb_WB : CategoryTheory.IsPullback π_R' eB_tilde e_B ψ.left :=
        CategoryTheory.IsPullback.of_hasPullback e_B ψ.left
      have hEt_eB_tilde : AlgebraicGeometry.Etale eB_tilde :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_WB he_B
      have hg_cond : (π_V ≫ q ≫ p₀) ≫ e_B = (eC_tilde ≫ f₁.left) ≫ ψ.left := by
        calc (π_V ≫ q ≫ p₀) ≫ e_B
            = π_V ≫ (q ≫ p₀ ≫ e_B) := by simp only [CategoryTheory.Category.assoc]
          _ = π_V ≫ (e_C ≫ f.left) := by rw [← hcomm]
          _ = (π_V ≫ e_C) ≫ f.left := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (eC_tilde ≫ ψ_C.left) ≫ f.left := by rw [hPb_W'.w]
          _ = eC_tilde ≫ (ψ_C.left ≫ f.left) := CategoryTheory.Category.assoc _ _ _
          _ = eC_tilde ≫ (f₁.left ≫ ψ.left) := by rw [hPb.w]
          _ = (eC_tilde ≫ f₁.left) ≫ ψ.left := (CategoryTheory.Category.assoc _ _ _).symm
      let g_tilde : W' ⟶ W_B :=
        CategoryTheory.Limits.pullback.lift (π_V ≫ q ≫ p₀) (eC_tilde ≫ f₁.left) hg_cond
      have hPb_mid : CategoryTheory.IsPullback π_V g_tilde (q ≫ p₀) π_R' := by
        have hp := hPb_W'.paste_vert hPb
        refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_WB
        · have h1 : g_tilde ≫ eB_tilde = eC_tilde ≫ f₁.left :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have h2 : (q ≫ p₀) ≫ e_B = e_C ≫ f.left := by
            rw [CategoryTheory.Category.assoc, hcomm]
          rwa [h1, h2]
        · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      obtain ⟨U_B', hAff_B', hw₀_UB', _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (show g_tilde.base w₀ ∈ (⊤ : W_B.Opens) from trivial)
      let R'₁ : CommRingCat.{u} := W_B.presheaf.obj (Opposite.op U_B')
      let ι_B' : AlgebraicGeometry.Spec R'₁ ⟶ W_B := hAff_B'.fromSpec
      have hOpen_ιB' : AlgebraicGeometry.IsOpenImmersion ι_B' := hAff_B'.isOpenImmersion_fromSpec
      let e_B₁ : AlgebraicGeometry.Spec R'₁ ⟶ B₁.left := ι_B' ≫ eB_tilde
      have hEt_eB₁ : AlgebraicGeometry.Etale e_B₁ := inferInstance
      let φ_R : R' ⟶ R'₁ := AlgebraicGeometry.Spec.preimage (ι_B' ≫ π_R')
      have hSpec_φR : AlgebraicGeometry.Spec.map φ_R = ι_B' ≫ π_R' :=
        AlgebraicGeometry.Spec.map_preimage (ι_B' ≫ π_R')
      let h₁ : R'₁ := φ_R.hom h
      let I₁ : Ideal (MvPolynomial (Fin 2) R'₁) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₁}
      let Q₁ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 2) R'₁ ⧸ I₁)
      let c₁ : R'₁ ⟶ Q₁ := CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C)
      let p₁ : AlgebraicGeometry.Spec Q₁ ⟶ AlgebraicGeometry.Spec R'₁ :=
        AlgebraicGeometry.Spec.map c₁
      let F₀ : MvPolynomial (Fin 2) R' →+* (MvPolynomial (Fin 2) R'₁ ⧸ I₁) :=
        (Ideal.Quotient.mk I₁).comp (MvPolynomial.map φ_R.hom)
      have hF₀_ker : I ≤ RingHom.ker F₀ := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        dsimp [F₀]
        rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      let φ_Q : Q ⟶ Q₁ :=
        CommRingCat.ofHom (Ideal.Quotient.lift I F₀ (fun a ha => RingHom.mem_ker.mp (hF₀_ker ha)))
      have hφQ_X : ∀ i : Fin 2,
          φ_Q.hom (Ideal.Quotient.mk I (MvPolynomial.X i)) =
            Ideal.Quotient.mk I₁ (MvPolynomial.X i) := by
        intro i
        change Ideal.Quotient.lift I F₀ _ (Ideal.Quotient.mk I (MvPolynomial.X i)) = _
        rw [Ideal.Quotient.lift_mk]
        dsimp [F₀]
        rw [MvPolynomial.map_X]
      have hφQ_C : ∀ r : R',
          φ_Q.hom (Ideal.Quotient.mk I (MvPolynomial.C r)) =
            Ideal.Quotient.mk I₁ (MvPolynomial.C (φ_R.hom r)) := by
        intro r
        change Ideal.Quotient.lift I F₀ _ (Ideal.Quotient.mk I (MvPolynomial.C r)) = _
        rw [Ideal.Quotient.lift_mk]
        dsimp [F₀]
        rw [MvPolynomial.map_C]
      have heq_push : φ_R ≫ c₁ = c₀ ≫ φ_Q := by
        apply CommRingCat.hom_ext
        ext r
        exact (hφQ_C r).symm
      let Ψ₀ : ∀ (s : CategoryTheory.Limits.PushoutCocone φ_R c₀),
          MvPolynomial (Fin 2) R'₁ →+* s.pt :=
        fun s => MvPolynomial.eval₂Hom s.inl.hom
          (fun i => s.inr.hom (Ideal.Quotient.mk I (MvPolynomial.X i)))
      have hΨ₀_ker : ∀ (s : CategoryTheory.Limits.PushoutCocone φ_R c₀),
          I₁ ≤ RingHom.ker (Ψ₀ s) := by
        intro s
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        rw [map_sub, map_mul]
        dsimp only [Ψ₀]
        rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
        have hs_cond : s.inl.hom (φ_R.hom h) = s.inr.hom (Ideal.Quotient.mk I (MvPolynomial.C h)) :=
          congrArg (fun m : R' ⟶ s.pt => m.hom h) s.condition
        change _ - s.inl.hom (φ_R.hom h) = 0
        rw [hs_cond, ← map_mul, ← map_sub, ← map_mul (Ideal.Quotient.mk I),
          ← map_sub (Ideal.Quotient.mk I)]
        have hgen0 : Ideal.Quotient.mk I
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [hgen0, map_zero]
      have hΨ₀_zero : ∀ s, ∀ a ∈ I₁, Ψ₀ s a = 0 :=
        fun s a ha => RingHom.mem_ker.mp (hΨ₀_ker s ha)
      let desc_push : ∀ (s : CategoryTheory.Limits.PushoutCocone φ_R c₀), Q₁ ⟶ s.pt :=
        fun s => CommRingCat.ofHom (Ideal.Quotient.lift I₁ (Ψ₀ s) (hΨ₀_zero s))
      have fac_left : ∀ s, c₁ ≫ desc_push s = s.inl := by
        intro s
        apply CommRingCat.hom_ext
        ext r₁
        change Ideal.Quotient.lift I₁ (Ψ₀ s) (hΨ₀_zero s)
          (Ideal.Quotient.mk I₁ (MvPolynomial.C r₁)) = s.inl.hom r₁
        rw [Ideal.Quotient.lift_mk]
        exact MvPolynomial.eval₂Hom_C _ _ r₁
      have fac_right : ∀ s, φ_Q ≫ desc_push s = s.inr := by
        intro s
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r
          change (desc_push s).hom (φ_Q.hom (Ideal.Quotient.mk I (MvPolynomial.C r))) =
            s.inr.hom (Ideal.Quotient.mk I (MvPolynomial.C r))
          rw [hφQ_C r]
          change (c₁ ≫ desc_push s).hom (φ_R.hom r) = (c₀ ≫ s.inr).hom r
          rw [fac_left s, ← s.condition]
          rfl
        · intro i
          change (desc_push s).hom (φ_Q.hom (Ideal.Quotient.mk I (MvPolynomial.X i))) =
            s.inr.hom (Ideal.Quotient.mk I (MvPolynomial.X i))
          rw [hφQ_X i]
          change Ideal.Quotient.lift I₁ (Ψ₀ s) (hΨ₀_zero s)
            (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) = _
          rw [Ideal.Quotient.lift_mk]
          exact MvPolynomial.eval₂Hom_X' _ _ i
      have uniq_push : ∀ s (m : Q₁ ⟶ s.pt),
          c₁ ≫ m = s.inl → φ_Q ≫ m = s.inr → m = desc_push s := by
        intro s m hm₁ hm₂
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r₁
          change (c₁ ≫ m).hom r₁ = (c₁ ≫ desc_push s).hom r₁
          rw [hm₁, fac_left s]
        · intro i
          change m.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) =
            (desc_push s).hom (Ideal.Quotient.mk I₁ (MvPolynomial.X i))
          rw [← hφQ_X i]
          change (φ_Q ≫ m).hom (Ideal.Quotient.mk I (MvPolynomial.X i)) =
            (φ_Q ≫ desc_push s).hom (Ideal.Quotient.mk I (MvPolynomial.X i))
          rw [hm₂, fac_right s]
      have hIsPush : CategoryTheory.IsPushout φ_R c₀ c₁ φ_Q :=
        CategoryTheory.IsPushout.of_isColimit
          (CategoryTheory.Limits.PushoutCocone.IsColimit.mk
            heq_push desc_push fac_left fac_right uniq_push)
      let V'₁_open : W'.Opens := g_tilde ⁻¹ᵁ U_B'
      let V'₁ : AlgebraicGeometry.Scheme.{u} := V'₁_open.toScheme
      let v₁ : V'₁ := ⟨w₀, hw₀_UB'⟩
      let e_C₁ : V'₁ ⟶ C₁.left := V'₁_open.ι ≫ eC_tilde
      have hEt_eC₁ : AlgebraicGeometry.Etale e_C₁ := inferInstance
      let g₁ : V'₁ ⟶ AlgebraicGeometry.Spec R'₁ := (g_tilde ∣_ U_B') ≫ hAff_B'.isoSpec.hom
      have hPb_iso : CategoryTheory.IsPullback (𝟙 V'₁) g₁ (g_tilde ∣_ U_B') hAff_B'.isoSpec.inv := by
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        dsimp [g₁]
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          hAff_B'.isoSpec.hom_inv_id, CategoryTheory.Category.comp_id]
      have hPb_res_g : CategoryTheory.IsPullback V'₁_open.ι (g_tilde ∣_ U_B') g_tilde U_B'.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict g_tilde U_B').flip
      have hPb_V'₁_outer :
          CategoryTheory.IsPullback (V'₁_open.ι ≫ π_V) g₁ (q ≫ p₀)
            (AlgebraicGeometry.Spec.map φ_R) := by
        have hp := (hPb_iso.paste_horiz hPb_res_g).paste_horiz hPb_mid
        have htop : (𝟙 V'₁ ≫ V'₁_open.ι) ≫ π_V = V'₁_open.ι ≫ π_V := by
          rw [CategoryTheory.Category.id_comp]
        have hbot : (hAff_B'.isoSpec.inv ≫ U_B'.ι) ≫ π_R' = AlgebraicGeometry.Spec.map φ_R := by
          rw [hAff_B'.isoSpec_inv_ι, ← hSpec_φR]
        rwa [htop, hbot] at hp
      have hPb_Q_flip :
          CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map φ_Q) p₁ p₀
            (AlgebraicGeometry.Spec.map φ_R) :=
        (AlgebraicGeometry.isPullback_SpecMap_of_isPushout φ_R c₀ c₁ φ_Q hIsPush).flip
      let q₁ : V'₁ ⟶ AlgebraicGeometry.Spec Q₁ :=
        hPb_Q_flip.lift ((V'₁_open.ι ≫ π_V) ≫ q) g₁ (by
          rw [CategoryTheory.Category.assoc]
          exact hPb_V'₁_outer.w)
      have hq₁_φQ : q₁ ≫ AlgebraicGeometry.Spec.map φ_Q = (V'₁_open.ι ≫ π_V) ≫ q :=
        hPb_Q_flip.lift_fst _ _ _
      have hq₁_p₁ : q₁ ≫ p₁ = g₁ :=
        hPb_Q_flip.lift_snd _ _ _
      have hPb_q₁ :
          CategoryTheory.IsPullback (V'₁_open.ι ≫ π_V) q₁ q
            (AlgebraicGeometry.Spec.map φ_Q) := by
        refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_Q_flip
        · rwa [hq₁_p₁]
        · exact hq₁_φQ.symm
      have hEt_q₁ : AlgebraicGeometry.Etale q₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₁ hq
      have hv₁_pt : (AlgebraicGeometry.Spec.map φ_Q).base (q₁.base v₁) = q.base v₀ := by
        calc (AlgebraicGeometry.Spec.map φ_Q).base (q₁.base v₁)
            = (q₁ ≫ AlgebraicGeometry.Spec.map φ_Q).base v₁ := rfl
          _ = ((V'₁_open.ι ≫ π_V) ≫ q).base v₁ := by rw [hq₁_φQ]
          _ = q.base (π_V.base w₀) := rfl
          _ = q.base v₀ := by rw [hw₀_V]
      have hcomap_v₁ : Ideal.comap φ_Q.hom (q₁.base v₁).asIdeal = (q.base v₀).asIdeal :=
        congrArg PrimeSpectrum.asIdeal hv₁_pt
      refine ⟨R'₁, e_B₁, h₁, V'₁, v₁, e_C₁, q₁, hEt_eB₁, hEt_eC₁, hEt_q₁, ?_, ?_, ?_, ?_⟩
      · change eC_tilde.base w₀ = x₁
        exact hw₀_C₁
      · intro i
        have hx : Ideal.Quotient.mk I (MvPolynomial.X i) ∈
            Ideal.comap φ_Q.hom (q₁.base v₁).asIdeal := by
          rw [hcomap_v₁]
          exact hXi i
        rw [Ideal.mem_comap, hφQ_X i] at hx
        exact hx
      · have hc : Ideal.Quotient.mk I (MvPolynomial.C h) ∈
            Ideal.comap φ_Q.hom (q₁.base v₁).asIdeal := by
          rw [hcomap_v₁]
          exact hCh
        rw [Ideal.mem_comap, hφQ_C h] at hc
        exact hc
      · calc e_C₁ ≫ f₁.left
            = V'₁_open.ι ≫ (eC_tilde ≫ f₁.left) := CategoryTheory.Category.assoc _ _ _
          _ = V'₁_open.ι ≫ (g_tilde ≫ eB_tilde) := by
              rw [← CategoryTheory.Limits.pullback.lift_snd (π_V ≫ q ≫ p₀) (eC_tilde ≫ f₁.left) hg_cond]
          _ = (V'₁_open.ι ≫ g_tilde) ≫ eB_tilde := (CategoryTheory.Category.assoc _ _ _).symm
          _ = ((g_tilde ∣_ U_B') ≫ U_B'.ι) ≫ eB_tilde := by
              rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = ((g_tilde ∣_ U_B') ≫ (hAff_B'.isoSpec.hom ≫ hAff_B'.isoSpec.inv) ≫ U_B'.ι) ≫ eB_tilde := by
              rw [hAff_B'.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp]
          _ = g₁ ≫ ι_B' ≫ eB_tilde := by
              dsimp [g₁, ι_B']
              rw [← hAff_B'.isoSpec_inv_ι]
              simp only [CategoryTheory.Category.assoc]
          _ = (q₁ ≫ p₁) ≫ e_B₁ := by
              rw [hq₁_p₁]
          _ = q₁ ≫ p₁ ≫ e_B₁ := CategoryTheory.Category.assoc _ _ _

theorem weil_semistable_curve_isIntegral_of_integral_base (k : Type u) [Field k]
    {B₁ C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (U_B₁ : B₁.left.Opens) (f₁ : C₁ ⟶ B₁) (n : ℕ) (τ₁ : Fin n → (B₁ ⟶ C₁))
    (hIntB₁ : AlgebraicGeometry.IsIntegral B₁.left)
    (hU_B₁ : Nonempty U_B₁)
    (hCurve₁ : IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁) :
    AlgebraicGeometry.IsIntegral C₁.left :=
by
  have hIrredB₁ : IrreducibleSpace ↥B₁.left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral B₁.left hIntB₁
  have hFlat_f₁ : AlgebraicGeometry.Flat f₁.left := hCurve₁.1
  have hLfp_f₁ : AlgebraicGeometry.LocallyOfFinitePresentation f₁.left := hCurve₁.2.2.1
  have hConn := hCurve₁.2.2.2.2.1
  have hSmU : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U_B₁) :=
    hCurve₁.2.2.2.2.2.1

  
  
  have h_loc_red : ∀ (R : Type u) [CommRing R] [_root_.IsReduced R] (M : Submonoid R)
      (L : Type u) [CommRing L] [Algebra R L] [IsLocalization M L],
      True ∧ _root_.IsReduced L := by
    intro R _ _ M L _ _ _
    refine ⟨trivial, ⟨fun z ⟨m_exp, hzm⟩ => ?_⟩⟩
    obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj M z
    have hr_pow : algebraMap R L (r ^ m_exp) = 0 := by
      rw [map_pow, ← hrs, mul_pow, hzm, zero_mul]
    obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff M L (r ^ m_exp)).mp hr_pow
    have hcr_nil : IsNilpotent (c.1 * r) := by
      refine ⟨m_exp + 1, ?_⟩
      calc (c.1 * r) ^ (m_exp + 1) = c.1 ^ m_exp * (c.1 * r ^ m_exp) * r := by ring
        _ = 0 := by rw [hc, mul_zero, zero_mul]
    have hcr_zero : c.1 * r = 0 := hcr_nil.eq_zero
    have hr_zero : algebraMap R L r = 0 :=
      (IsLocalization.map_eq_zero_iff M L r).mpr ⟨c, hcr_zero⟩
    rw [hr_zero] at hrs
    apply (IsLocalization.map_units L s).mul_right_cancel
    rw [zero_mul, hrs]

  
  have h_etale_field : ∀ (L : Type u) [Field L] (B : Type u) [CommRing B]
      [Algebra L B] [Algebra.Etale L B], _root_.IsReduced B ∧ IsArtinianRing B := by
    intro L _ B _ _ _
    refine ⟨Algebra.FormallyUnramified.isReduced_of_field L B, ?_⟩
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, hEquiv, hModAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod L B).mp inferInstance
    letI := hFinI
    letI := hFieldAi
    letI := hAlgAi
    haveI : ∀ i : I, Module.Finite L (Ai i) := fun i => (hModAi i).1
    haveI : Module.Finite L (∀ i : I, Ai i) := Module.Finite.pi
    haveI : Module.Finite L B := Module.Finite.equiv hEquiv.symm.toLinearEquiv
    exact (Module.finite_iff_isArtinianRing L B).mp inferInstance

  
  have h_etale_dom_red : ∀ (P : Type u) [CommRing P] [IsDomain P]
      (T : Type u) [CommRing T] [Algebra P T] [Algebra.Etale P T],
      True ∧ _root_.IsReduced T := by
    intro P _ _ T _ _ _
    refine ⟨trivial, ?_⟩
    haveI : Module.Flat P T := Algebra.Smooth.flat P T
    haveI : Algebra.Etale (FractionRing P) (TensorProduct P (FractionRing P) T) := inferInstance
    haveI : _root_.IsReduced (TensorProduct P (FractionRing P) T) :=
