    (hIntC₃ : AlgebraicGeometry.IsIntegral C₃.left)
    (hProjC₃ : IsProjectiveOverField k C₃)
    (X₃ T₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (pX₃ : X₃ ⟶ B₃) (qX₃ : X₃ ⟶ X₂)
    (pT₃ : T₃ ⟶ B₃) (rC₃ : T₃ ⟶ C₃) (rX₃ : T₃ ⟶ X₃)
    (hPair : IsOpenGraphStrictTransformPairOver k f₂ σ ψ₃ U₃ g₃ τ₃ pX₃ qX₃ pT₃ rC₃ rX₃)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_good : B₃.left.Opens)
    (ψ₄ : B ⟶ B₃)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hNormB : IsAffineNormalScheme B.left)
    (hUgood : Nonempty U_good)
    (hUgoodSub : (U_good : Set B₃.left) ⊆ (U₃ : Set B₃.left))
    (hIsoψ₄ : CategoryTheory.IsIso (ψ₄.left ∣_ U_good))
    (X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f_XB : X_B ⟶ B) (q_XB : X_B ⟶ X₃)
    (f_TB : T_B ⟶ B) (q_TB : T_B ⟶ T₃)
    (hcomm_XB : q_XB.left ≫ pX₃.left = f_XB.left ≫ ψ₄.left)
    (hcomm_TB : q_TB.left ≫ pT₃.left = f_TB.left ≫ ψ₄.left)
    (hIntXB : AlgebraicGeometry.IsIntegral X_B.left)
    (hProjXB : IsProjectiveOverField k X_B)
    (hFlatXB : AlgebraicGeometry.Flat f_XB.left)
    (hClXB : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB))
    (hIsoXB : CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∣_
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd pX₃.left ψ₄.left).base).obj
            ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))))
    (hIntTB : AlgebraicGeometry.IsIntegral T_B.left)
    (hProjTB : IsProjectiveOverField k T_B)
    (hFlatTB : AlgebraicGeometry.Flat f_TB.left)
    (hClTB : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift q_TB.left f_TB.left hcomm_TB))
    (hIsoTB : CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift q_TB.left f_TB.left hcomm_TB) ∣_
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd pT₃.left ψ₄.left).base).obj
            ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good)))) :
    ∃ (U_B : B.left.Opens)
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f : C ⟶ B) (τ : Fin n → (B ⟶ C))
      (σ_B : Fin n → (B ⟶ X_B))
      (pr₁ : T_B ⟶ C) (pr₂ : T_B ⟶ X_B),
      (U_B : Set B.left) = ψ₄.left.base ⁻¹' (U_good : Set B₃.left) ∧
      Nonempty U_B ∧
      IsSemistablePointedCurveOver k f U_B n τ ∧
      AlgebraicGeometry.IsIntegral C.left ∧
      IsProjectiveOverField k C ∧
      IsFlattenedNormalPointedCorrespondenceOver k f₂ σ (ψ₄ ≫ ψ₃) U_B f τ f_XB σ_B
        (q_XB ≫ qX₃) f_TB pr₁ pr₂ :=
by
  
  let U_B : B.left.Opens := (TopologicalSpace.Opens.map ψ₄.left.base).obj U_good
  have hUB : Nonempty U_B := by
    haveI : CategoryTheory.IsIso (ψ₄.left ∣_ U_good) := hIsoψ₄
    obtain ⟨⟨y₀, hy₀⟩⟩ := hUgood
    let x₀ := (CategoryTheory.inv (ψ₄.left ∣_ U_good)).base ⟨y₀, hy₀⟩
    exact ⟨⟨x₀.1, x₀.2⟩⟩
  have hUB_sub_U₃ : (U_B : Set B.left) ⊆ ψ₄.left.base ⁻¹' (U₃ : Set B₃.left) :=
    Set.preimage_mono hUgoodSub
  let C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd g₃.left ψ₄.left ≫ B.hom)
  let f : C ⟶ B :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd g₃.left ψ₄.left) rfl
  let q_C : C ⟶ C₃ :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst g₃.left ψ₄.left) (by
      dsimp [C]
      rw [← CategoryTheory.Over.w g₃, CategoryTheory.Limits.pullback.condition_assoc,
        CategoryTheory.Over.w ψ₄])
  have hτ₃_g₃ : ∀ j : Fin n, τ₃ j ≫ g₃ = 𝟙 B₃ := hCurve₃.2.2.2.2.2.2.1
  have hτ₃_left : ∀ j : Fin n, (τ₃ j).left ≫ g₃.left = 𝟙 B₃.left := fun j =>
    congrArg CategoryTheory.CommaMorphism.left (hτ₃_g₃ j)
  let τ : Fin n → (B ⟶ C) := fun j =>
    CategoryTheory.Over.homMk
      (CategoryTheory.Limits.pullback.lift (ψ₄.left ≫ (τ₃ j).left) (𝟙 B.left) (by
        rw [CategoryTheory.Category.assoc, hτ₃_left j, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]))
      (by
        dsimp [C]
        rw [CategoryTheory.Limits.pullback.lift_snd_assoc, CategoryTheory.Category.id_comp])
  have hPb_C : CategoryTheory.IsPullback q_C.left f.left g₃.left ψ₄.left :=
    CategoryTheory.IsPullback.of_hasPullback g₃.left ψ₄.left
  have hτ_f : ∀ j : Fin n, τ j ≫ f = 𝟙 B := by
    intro j
    ext1
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hτ_qC : ∀ j : Fin n, τ j ≫ q_C = ψ₄ ≫ τ₃ j := by
    intro j
    ext1
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  
  have hCurve : IsSemistablePointedCurveOver k f U_B n τ :=
    weil_semistable_pointed_curve_pullback k U₃ U_B g₃ ψ₄ f q_C n τ₃ τ
      hCurve₃ hPb_C hUB_sub_U₃ hτ_f hτ_qC
  have hIntC : AlgebraicGeometry.IsIntegral C.left :=
    weil_semistable_curve_isIntegral_of_integral_base k U_B f n τ hIntB hUB hCurve
  have hProjC : IsProjectiveOverField k C :=
    weil_projectiveOverField_pullback k g₃ ψ₄ f q_C hPb_C hProjB₃ hProjC₃ hProjB
  
  have hNormC : IsAffineNormalScheme C.left :=
    weil_semistable_curve_isAffineNormalScheme_over_normal_base k
      (@weil_etale_ring_normal_localizations_of_normal_noetherian_domain)
      B C U_B f n τ hIntB hProjB hNormB hUB hCurve hIntC
  have hSmNhdsXB : ∀ (W : X_B.left.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f_XB.left) →
      ∀ x ∈ W, ∃ (U : X_B.left.Opens),
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ U ≤ W ∧
        IsDomain ↑(X_B.left.presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑(X_B.left.presheaf.obj (Opposite.op U)) :=
    fun W hSmW x hx =>
      weil_smooth_relDimOne_affineNormal_nhds_over_normal_base k
        (@weil_etale_ring_normal_localizations_of_normal_noetherian_domain)
        B X_B hProjB hNormB f_XB W hSmW x hx
  
  obtain ⟨σ_B, hPropXB, hSurjXB, hσB, hIsoXB_2, hFibXB⟩ :=
    weil_strict_transform_sections_and_threeSecant_fibers k
      B₂ X₂ B₃ X₃ B X_B U₂ f₂ n σ hFib₂ U₃ ψ₃ pX₃ qX₃
      hPair.2.2.2.2.2.2.2.2.1
      U_good ψ₄ hIntB hProjB hUgoodSub hUB
      f_XB q_XB hcomm_XB hProjXB hClXB hIsoXB
  
  obtain ⟨pr₁, pr₂, hClTB_CX, hIsoPr₁, hIsoPr₂, hτ_tilde⟩ :=
    weil_graph_strict_transform_correspondence_pullback k
      B₂ X₂ B₃ C₃ X₃ T₃ B C X_B T_B
      f₂ n σ U₃ ψ₃ g₃ τ₃ hτ₃_g₃ pX₃ qX₃ pT₃ rC₃ rX₃ hPair
      U_good ψ₄ hIntB hUgood hUgoodSub hIsoψ₄
      f q_C τ hPb_C hτ_f hτ_qC
      f_XB q_XB σ_B hcomm_XB hClXB hIsoXB
      (fun j => (hσB j).1) (fun j => (hσB j).2)
      f_TB q_TB hcomm_TB hIntTB hClTB hIsoTB
  
  exact ⟨U_B, C, f, τ, σ_B, pr₁, pr₂, rfl, hUB, hCurve, hIntC, hProjC,
    ⟨hFib₂.1, hNormB, hNormC, hIntXB, hProjXB, hPropXB, hFlatXB, hSurjXB,
      hσB, hIsoXB_2, hSmNhdsXB, hFibXB,
      hIntTB, hProjTB, hFlatTB, hClTB_CX, hIsoPr₁, hIsoPr₂, hτ_tilde⟩⟩

theorem weil_projective_birational_normal_open_iso_of_no_strict_spec (k : Type u) [Field k] [IsAlgClosed k]
    (T Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntT : AlgebraicGeometry.IsIntegral T.left)
    (hProjT : IsProjectiveOverField k T)
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    (hProjY : IsProjectiveOverField k Y)
    (π : T ⟶ Y)
    (U_iso : Y.left.Opens)
    (hUiso : Nonempty U_iso)
    (hIsoU : CategoryTheory.IsIso (π.left ∣_ U_iso))
    (W : Y.left.Opens)
    (y : Y.left)
    (hyW : y ∈ W)
    (hNormW : ∃ (U : Y.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧ U ≤ W ∧
      IsDomain ↑(Y.left.presheaf.obj (Opposite.op U)) ∧
      IsIntegrallyClosed ↑(Y.left.presheaf.obj (Opposite.op U)))
    (hZeroDim : ∀ (t₀ t₁ : T.left),
      π.left.base t₀ = y → π.left.base t₁ = y →
      t₀ ∈ closure ({t₁} : Set T.left) → t₀ = t₁) :
    ∃ (V : Y.left.Opens),
      AlgebraicGeometry.IsAffineOpen V ∧ y ∈ V ∧ V ≤ W ∧
      CategoryTheory.IsIso (π.left ∣_ V) :=
by
  classical
  let _ := hyW
  
  have hAdjoinProj : ∀ M : ℕ,
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        MvPolynomial.gradedAlgebra
      Algebra.adjoin (↥(MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0))
        (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k)) = ⊤ := by
    intro M
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hmem : ∀ P : MvPolynomial (Fin (M + 1)) k,
        P ∈ Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k)) := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C a =>
        let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
        have hc₀ : algebraMap (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) c₀ = MvPolynomial.C a := rfl
        rw [← hc₀]
        exact Subalgebra.algebraMap_mem _ c₀
      | add P₁ P₂ h₁ h₂ => exact add_mem h₁ h₂
      | mul_X P₁ i h₁ => exact mul_mem h₁ (Algebra.subset_adjoin ⟨i, rfl⟩)
    rw [eq_top_iff]
    intro P _
    exact hmem P
  have hProjProper : ∀ M : ℕ, AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k M).hom := by
    intro M
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) := by
      refine ⟨⟨Finset.univ.image MvPolynomial.X, ?_⟩⟩
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      exact hAdjoinProj M
    have hBij₀ : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      refine ⟨?_, ?_⟩
      · intro a b hab
        have hC : (MvPolynomial.C a : MvPolynomial (Fin (M + 1)) k) = MvPolynomial.C b :=
          congrArg Subtype.val hab
        simpa using congrArg (fun q => q.coeff 0) hC
      · rintro ⟨p, hp⟩
        rw [MvPolynomial.mem_homogeneousSubmodule] at hp
        by_cases hp0 : p = 0
        · refine ⟨0, Subtype.ext ?_⟩
          simp [hp0]
        · refine ⟨p.coeff 0, Subtype.ext ?_⟩
          have hdeg : p.totalDegree = 0 := hp.totalDegree hp0
          exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hdeg).symm
    let e₀ := (RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hBij₀).toCommRingCatIso
    have he₀ : CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) = e₀.hom := by
      ext x; rfl
    have : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) := by
      rw [he₀]; infer_instance
    have : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) := inferInstance
    have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
    infer_instance
  obtain ⟨N_T, ι_T, hClT⟩ := hProjT
  obtain ⟨N_Y, ι_Y, hClY⟩ := hProjY
  have hPropT : AlgebraicGeometry.IsProper T.hom := by
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N_T).hom := hProjProper N_T
    rw [← CategoryTheory.Over.w ι_T]
    infer_instance
  have hPropY : AlgebraicGeometry.IsProper Y.hom := by
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N_Y).hom := hProjProper N_Y
    rw [← CategoryTheory.Over.w ι_Y]
    infer_instance
  have : AlgebraicGeometry.IsSeparated Y.hom := inferInstance
  have hPropπ : AlgebraicGeometry.IsProper π.left := by
    have hcomp : AlgebraicGeometry.IsProper (π.left ≫ Y.hom) := by
      rwa [CategoryTheory.Over.w π]
    exact @AlgebraicGeometry.IsProper.of_comp _ _ _ π.left Y.hom hcomp inferInstance
  have : TopologicalSpace.NoetherianSpace ↥T.left := by
    have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType T.hom := inferInstance
    have : AlgebraicGeometry.IsLocallyNoetherian T.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian T.hom
    have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := PrimeSpectrum.compactSpace
    have : CompactSpace ↥T.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace T.hom
    have : AlgebraicGeometry.IsNoetherian T.left := ⟨⟩
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace

  
  have hFinFib : (π.left.base ⁻¹' ({y} : Set Y.left)).Finite := by
    set F : Set ↥T.left := π.left.base ⁻¹' ({y} : Set Y.left)
    obtain ⟨S, hS_fin, hS_cl, hS_irr, hZ_eq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
        (isClosed_closure (s := F))
    let S' : Set (Set ↥T.left) := {t | t ∈ S ∧ (t ∩ F).Nonempty}
    have hS'_fin : S'.Finite := hS_fin.subset fun _ h => h.1
    have : Fintype ↥S' := hS'_fin.fintype
    let η : ↥S' → ↥T.left := fun t => (hS_irr t.1 t.2.1).genericPoint
    refine (Set.finite_range η).subset ?_
    intro x hx
    have hx_cl : x ∈ closure F := subset_closure hx
    rw [hZ_eq, Set.mem_sUnion] at hx_cl
    obtain ⟨t, htS, hxt⟩ := hx_cl
    have htS' : t ∈ S' := ⟨htS, ⟨x, hxt, hx⟩⟩
    let z_t : ↥T.left := η ⟨t, htS'⟩
    have hcl_zt : closure ({z_t} : Set ↥T.left) = t :=
      (hS_irr t htS).closure_genericPoint (hS_cl t htS)
    have hx_in_zt : x ∈ closure ({z_t} : Set ↥T.left) := by
      rwa [hcl_zt]
    have hy_in_cl : y ∈ closure ({π.left.base z_t} : Set ↥Y.left) := by
      have h_img : π.left.base x ∈ π.left.base '' closure ({z_t} : Set ↥T.left) :=
        ⟨x, hx_in_zt, rfl⟩
      have h_sub := image_closure_subset_closure_image π.left.continuous h_img
      rw [Set.image_singleton] at h_sub
      have hxy : π.left.base x = y := hx
      rwa [hxy] at h_sub
    have hF_sub : closure F ⊆ π.left.base ⁻¹' closure ({y} : Set ↥Y.left) := by
      refine closure_minimal ?_
        ((isClosed_closure (s := ({y} : Set ↥Y.left))).preimage π.left.continuous)
      intro w hw
      have hwy : π.left.base w = y := hw
      change π.left.base w ∈ closure ({y} : Set ↥Y.left)
      rw [hwy]
      exact subset_closure (Set.mem_singleton y)
    have hzt_in_cl : π.left.base z_t ∈ closure ({y} : Set ↥Y.left) := by
      have hzt_t : z_t ∈ t := by
        rw [← hcl_zt]
        exact subset_closure (Set.mem_singleton z_t)
      have hzt_clF : z_t ∈ closure F := by
        rw [hZ_eq]
        exact Set.mem_sUnion.mpr ⟨t, htS, hzt_t⟩
      exact hF_sub hzt_clF
    have hzt_y : π.left.base z_t = y :=
      inseparable_iff_eq.mp (inseparable_iff_mem_closure.mpr ⟨hzt_in_cl, hy_in_cl⟩)
    have hxz : x = z_t := hZeroDim x z_t hx hzt_y hx_in_zt
    exact ⟨⟨t, htS'⟩, hxz.symm⟩

  
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N_T + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let ι_Proj : T.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι_T.left
  have : AlgebraicGeometry.IsClosedImmersion ι_Proj := hClT
  let S_y : Set ↥(AlgebraicGeometry.Proj 𝒜) := ι_Proj.base '' (π.left.base ⁻¹' ({y} : Set Y.left))
  have hSy_fin : S_y.Finite := hFinFib.image ι_Proj.base
  have hCovProj : (⨆ μ : Fin (N_T + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)) = ⊤ := by
    refine AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X ?_ (hAdjoinProj N_T)
    intro μ
    exact ⟨1, MvPolynomial.isHomogeneous_X k μ⟩
  let L_form : k → MvPolynomial (Fin (N_T + 1)) k := fun t =>
    ∑ μ : Fin (N_T + 1), MvPolynomial.C (t ^ (μ : ℕ)) * MvPolynomial.X μ
  have hL_hom : ∀ t : k, L_form t ∈ 𝒜 1 := by
    intro t
    refine (𝒜 1).sum_mem fun μ _ => ?_
    rw [MvPolynomial.mem_homogeneousSubmodule]
    simpa using (MvPolynomial.isHomogeneous_C (Fin (N_T + 1)) (t ^ (μ : ℕ))).mul
      (MvPolynomial.isHomogeneous_X k μ)
  have hBadFin : ∀ q : ↥(AlgebraicGeometry.Proj 𝒜),
      {t : k | L_form t ∈ q.asHomogeneousIdeal}.Finite := by
    intro q
    have hq_top : q ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
    rw [← hCovProj, TopologicalSpace.Opens.mem_iSup] at hq_top
    obtain ⟨μ₀, hμ₀⟩ := hq_top
    rw [AlgebraicGeometry.Proj.mem_basicOpen] at hμ₀
    by_contra hInf
    have hInf' : {t : k | L_form t ∈ q.asHomogeneousIdeal}.Infinite := hInf
    obtain ⟨T_fin, hT_sub, hT_card⟩ := hInf'.exists_subset_card_eq (N_T + 1)
    let e : Fin (N_T + 1) ≃ ↥T_fin :=
      (T_fin.equivFin.trans (Equiv.cast (congrArg Fin hT_card))).symm
    let v : Fin (N_T + 1) → k := fun r => (e r).1
    have hv_inj : Function.Injective v := fun r₁ r₂ h => e.injective (Subtype.ext h)
    have hv_mem : ∀ r : Fin (N_T + 1), L_form (v r) ∈ q.asHomogeneousIdeal.toIdeal :=
      fun r => hT_sub (e r).2
    let V_mat : Matrix (Fin (N_T + 1)) (Fin (N_T + 1)) k := Matrix.vandermonde v
    have hdet : V_mat.det ≠ 0 := Matrix.det_vandermonde_ne_zero_iff.mpr hv_inj
    have hV_inv : V_mat⁻¹ * V_mat = 1 :=
      Matrix.nonsing_inv_mul V_mat (isUnit_iff_ne_zero.mpr hdet)
    have hSumMem : (∑ r : Fin (N_T + 1), MvPolynomial.C (V_mat⁻¹ μ₀ r) * L_form (v r)) ∈
        q.asHomogeneousIdeal.toIdeal :=
      q.asHomogeneousIdeal.toIdeal.sum_mem fun r _ =>
        q.asHomogeneousIdeal.toIdeal.mul_mem_left _ (hv_mem r)
    have hSumEq : (∑ r : Fin (N_T + 1), MvPolynomial.C (V_mat⁻¹ μ₀ r) * L_form (v r)) =
        MvPolynomial.X μ₀ := by
      calc
        (∑ r : Fin (N_T + 1), MvPolynomial.C (V_mat⁻¹ μ₀ r) * L_form (v r))
            = ∑ r : Fin (N_T + 1), ∑ μ : Fin (N_T + 1),
                MvPolynomial.C (V_mat⁻¹ μ₀ r * v r ^ (μ : ℕ)) * MvPolynomial.X μ := by
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun μ _ => ?_
          rw [← mul_assoc, ← MvPolynomial.C_mul]
        _ = ∑ μ : Fin (N_T + 1), ∑ r : Fin (N_T + 1),
                MvPolynomial.C (V_mat⁻¹ μ₀ r * V_mat r μ) * MvPolynomial.X μ := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun r _ => ?_
          have hv_eq : v r ^ (μ : ℕ) = V_mat r μ := (Matrix.vandermonde_apply v r μ).symm
          exact congrArg (fun x => MvPolynomial.C (V_mat⁻¹ μ₀ r * x) * MvPolynomial.X μ) hv_eq
        _ = ∑ μ : Fin (N_T + 1), MvPolynomial.C ((V_mat⁻¹ * V_mat) μ₀ μ) * MvPolynomial.X μ := by
          refine Finset.sum_congr rfl fun μ _ => ?_
          rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
        _ = MvPolynomial.X μ₀ := by
          rw [hV_inv]
          simp [Matrix.one_apply]
    rw [hSumEq] at hSumMem
    exact hμ₀ hSumMem
  have hBall_fin : (⋃ q ∈ S_y, {t : k | L_form t ∈ q.asHomogeneousIdeal}).Finite :=
    hSy_fin.biUnion fun q _ => hBadFin q
  have : Infinite k := IsAlgClosed.instInfinite
  obtain ⟨t₀, ht₀⟩ := hBall_fin.exists_notMem
  let D_L : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 (L_form t₀)
  have hAffDL : AlgebraicGeometry.IsAffineOpen D_L :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (L_form t₀) (hL_hom t₀) zero_lt_one
  let W_T : T.left.Opens := (TopologicalSpace.Opens.map ι_Proj.base).obj D_L
  have hAffWT : AlgebraicGeometry.IsAffineOpen W_T := hAffDL.preimage ι_Proj
  have hFibSubWT : π.left.base ⁻¹' ({y} : Set Y.left) ⊆ (W_T : Set T.left) := by
    intro x hx
    have hqx : ι_Proj.base x ∈ S_y := ⟨x, hx, rfl⟩
    change ι_Proj.base x ∈ D_L
    rw [AlgebraicGeometry.Proj.mem_basicOpen]
    intro hmem
    exact ht₀ (Set.mem_iUnion₂.mpr ⟨ι_Proj.base x, hqx, hmem⟩)

  
  obtain ⟨U, hAffU, hyU, hUW, hDomU, hICU⟩ := hNormW
  have : AlgebraicGeometry.IsProper π.left := hPropπ
  let K_y : Set ↥Y.left := π.left.base '' ((W_T : Set ↥T.left)ᶜ)
  have hKy_cl : IsClosed K_y := π.left.isClosedMap _ W_T.isOpen.isClosed_compl
  have hy_not_Ky : y ∉ K_y := by
    rintro ⟨z, hz_not, hzy⟩
    exact hz_not (hFibSubWT hzy)
  let W_good : Y.left.Opens := U ⊓ ⟨K_yᶜ, hKy_cl.isOpen_compl⟩
  obtain ⟨g, hg_le, hyV⟩ := hAffU.exists_basicOpen_le (V := W_good) ⟨y, hyU, hy_not_Ky⟩ hyU
  let V : Y.left.Opens := Y.left.basicOpen g
  have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffU.basicOpen g
  have hVU : V ≤ U := Y.left.basicOpen_le g
  have hVW : V ≤ W := hVU.trans hUW
  let W_V : T.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj V
  have hWV_sub_WT : (W_V : Set ↥T.left) ⊆ (W_T : Set ↥T.left) := by
    intro x hx
    by_contra hx_not
    have hpx_Ky : π.left.base x ∈ K_y := ⟨x, hx_not, rfl⟩
    exact (hg_le hx).2 hpx_Ky
  have hAffPreV : AlgebraicGeometry.IsAffineOpen W_V := by
    let i_W := hAffWT.fromSpec
    let i_V := hAffV.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion i_W := hAffWT.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion i_V := hAffV.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsAffineHom (i_V ≫ Y.hom) :=
      AlgebraicGeometry.isAffineHom_of_isAffine (i_V ≫ Y.hom)
    have : AlgebraicGeometry.IsAffineHom i_V :=
      AlgebraicGeometry.IsAffineHom.of_comp i_V Y.hom
    let π₁ := CategoryTheory.Limits.pullback.fst (i_W ≫ π.left) i_V
    let π₂ := CategoryTheory.Limits.pullback.snd (i_W ≫ π.left) i_V
    have hRangeEq : (π₁ ≫ i_W).opensRange = W_V := by
      ext x
      simp only [AlgebraicGeometry.Scheme.Hom.coe_opensRange]
      constructor
      · rintro ⟨p, rfl⟩
        have hcond := congrArg (fun f => f.base p)
          (CategoryTheory.Limits.pullback.condition (f := i_W ≫ π.left) (g := i_V))
        have hmem : (π₂ ≫ i_V).base p ∈ (V : Set ↥Y.left) := by
          have hiV : i_V.base (π₂.base p) ∈ (i_V.opensRange : Set ↥Y.left) := ⟨π₂.base p, rfl⟩
          rw [hAffV.opensRange_fromSpec] at hiV
          simpa using hiV
        rw [← hcond] at hmem
        have hmem' : π.left.base (i_W.base (π₁.base p)) ∈ (V : Set ↥Y.left) := by
          simpa [π₁, π₂] using hmem
        exact hmem'
      · intro hx
        have hxWT : x ∈ (i_W.opensRange : Set ↥T.left) := by
          rw [hAffWT.opensRange_fromSpec]
          exact hWV_sub_WT hx
        obtain ⟨a, rfl⟩ := hxWT
        have ha_fst : a ∈ (π₁.opensRange : Set _) := by
          rw [AlgebraicGeometry.Scheme.Hom.opensRange_pullbackFst i_V (i_W ≫ π.left),
            hAffV.opensRange_fromSpec]
          have hx' : π.left.base (i_W.base a) ∈ (V : Set ↥Y.left) := hx
          simpa using hx'
        obtain ⟨p, rfl⟩ := ha_fst
        exact ⟨p, by simp⟩
    rw [← hRangeEq]
    exact AlgebraicGeometry.isAffineOpen_opensRange (π₁ ≫ i_W)
  have : AlgebraicGeometry.IsAffine (W_V : AlgebraicGeometry.Scheme) := hAffPreV
  have : AlgebraicGeometry.IsAffine (V : AlgebraicGeometry.Scheme) := hAffV
  have hFinV : AlgebraicGeometry.IsFinite (π.left ∣_ V) := by
    have : AlgebraicGeometry.IsProper (π.left ∣_ V) :=
      AlgebraicGeometry.IsZariskiLocalAtTarget.restrict hPropπ V
    have : AlgebraicGeometry.IsAffineHom (π.left ∣_ V) :=
      AlgebraicGeometry.isAffineHom_of_isAffine (π.left ∣_ V)
    exact AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩
  have hg_ne : g ≠ 0 := by
    intro hg0
    subst hg0
    have hbot : V = ⊥ := Y.left.basicOpen_zero U
    have hy_bot : y ∈ (⊥ : Y.left.Opens) := hbot ▸ hyV
    exact False.elim hy_bot
  have : IsDomain ↑(Y.left.presheaf.obj (Opposite.op U)) := hDomU
  have : IsIntegrallyClosed ↑(Y.left.presheaf.obj (Opposite.op U)) := hICU
  have : IsLocalization.Away g ↑(Y.left.presheaf.obj (Opposite.op V)) :=
    hAffU.isLocalization_basicOpen g
  have hICV : IsIntegrallyClosed ↑(Y.left.presheaf.obj (Opposite.op V)) :=
    isIntegrallyClosed_of_isLocalization (↑(Y.left.presheaf.obj (Opposite.op V)))
      (Submonoid.powers g) (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg_ne))

  
  have : AlgebraicGeometry.IsIntegral T.left := hIntT
  have : AlgebraicGeometry.IsIntegral Y.left := hIntY
  let R_V := ↑(Y.left.presheaf.obj (Opposite.op V))
  let S_V := ↑(T.left.presheaf.obj (Opposite.op W_V))
  let φ : R_V →+* S_V := (π.left.app V).hom
  have : IrreducibleSpace ↥Y.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left
  have hInterNe : ((V : Set ↥Y.left) ∩ (U_iso : Set ↥Y.left)).Nonempty :=
    nonempty_preirreducible_inter V.isOpen U_iso.isOpen ⟨y, hyV⟩ ⟨hUiso.some.1, hUiso.some.2⟩
  obtain ⟨x₀, hx₀V, hx₀U⟩ := hInterNe
  obtain ⟨r₀, hD₀_le, hx₀D₀⟩ :=
    hAffV.exists_basicOpen_le (V := V ⊓ U_iso) ⟨x₀, hx₀V, hx₀U⟩ hx₀V
  let D₀ : Y.left.Opens := Y.left.basicOpen r₀
  have hr₀_ne : r₀ ≠ 0 := by
    intro hr0
    subst hr0
    have hbot : D₀ = ⊥ := Y.left.basicOpen_zero V
    have hx_bot : x₀ ∈ (⊥ : Y.left.Opens) := hbot ▸ hx₀D₀
    exact False.elim hx_bot
  have : CategoryTheory.IsIso (π.left ∣_ U_iso) := hIsoU
  let e_iso := CategoryTheory.asIso (π.left ∣_ U_iso)
  let t₀_sub := e_iso.inv.base ⟨x₀, hx₀U⟩
  have ht₀_proj : π.left.base t₀_sub.1 = x₀ := by
    have h1 : (⇑(π.left ∣_ U_iso)) t₀_sub = ⟨x₀, hx₀U⟩ := by
      change (e_iso.inv ≫ e_iso.hom).base ⟨x₀, hx₀U⟩ = ⟨x₀, hx₀U⟩
      rw [e_iso.inv_hom_id]
      rfl
    have h2 : (⇑(π.left ∣_ U_iso) t₀_sub).1 = x₀ := congrArg Subtype.val h1
    rwa [AlgebraicGeometry.morphismRestrict_base] at h2
  have ht₀_preD₀ : t₀_sub.1 ∈ (TopologicalSpace.Opens.map π.left.base).obj D₀ := by
    change π.left.base t₀_sub.1 ∈ D₀
    rw [ht₀_proj]
    exact hx₀D₀
  have hPreD₀_eq : (TopologicalSpace.Opens.map π.left.base).obj D₀ = T.left.basicOpen (φ r₀) :=
    AlgebraicGeometry.Scheme.Hom.preimage_basicOpen π.left r₀
  have ht₀_basic : t₀_sub.1 ∈ T.left.basicOpen (φ r₀) := hPreD₀_eq ▸ ht₀_preD₀
  have hφr₀_ne : φ r₀ ≠ 0 := by
    intro h0
    have hbot : T.left.basicOpen (φ r₀) = ⊥ := by
      rw [h0]
      exact T.left.basicOpen_zero W_V
    have ht_bot : t₀_sub.1 ∈ (⊥ : T.left.Opens) := hbot ▸ ht₀_basic
    exact False.elim ht_bot
  have : Nonempty V := ⟨⟨y, hyV⟩⟩
  have : Nonempty W_V :=
    ⟨⟨t₀_sub.1, by change π.left.base t₀_sub.1 ∈ V; rw [ht₀_proj]; exact hx₀V⟩⟩
  have : IsDomain R_V := AlgebraicGeometry.IsIntegral.component_integral V
  have : IsDomain S_V := AlgebraicGeometry.IsIntegral.component_integral W_V

  
  let R_D₀ := ↑(Y.left.presheaf.obj (Opposite.op D₀))
  let S_D₀ := ↑(T.left.presheaf.obj (Opposite.op (T.left.basicOpen (φ r₀))))
  have : IsLocalization.Away r₀ R_D₀ := hAffV.isLocalization_basicOpen r₀
  have : IsLocalization.Away (φ r₀) S_D₀ := hAffPreV.isLocalization_basicOpen (φ r₀)
  let ψ : R_D₀ →+* S_D₀ := IsLocalization.Away.map R_D₀ S_D₀ φ r₀
  have hIsoAppD₀ : CategoryTheory.IsIso (π.left.app D₀) := by
    let D'₀ : (U_iso : AlgebraicGeometry.Scheme).Opens :=
      (TopologicalSpace.Opens.map U_iso.ι.base).obj D₀
    have hD'₀_eq : (U_iso.ι.opensFunctor).obj D'₀ = D₀ := by
      ext z
      simp
      exact ⟨fun ⟨_, hx, hxz⟩ => hxz ▸ hx, fun hz => ⟨⟨z, (hD₀_le hz).2⟩, hz, rfl⟩⟩
    have hIsoD'₀ : CategoryTheory.IsIso ((π.left ∣_ U_iso).app D'₀) :=
      @AlgebraicGeometry.Scheme.Hom.instIsIsoCommRingCatApp _ _ (π.left ∣_ U_iso) hIsoU D'₀
    rw [AlgebraicGeometry.morphismRestrict_app] at hIsoD'₀
    have hCompIso₁ : CategoryTheory.IsIso (π.left.app ((U_iso.ι.opensFunctor).obj D'₀)) :=
      @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
        (π.left.app ((U_iso.ι.opensFunctor).obj D'₀)) _
        (CategoryTheory.Functor.map_isIso T.left.presheaf _) hIsoD'₀
    let i := (CategoryTheory.eqToHom hD'₀_eq).op
    have hNat := AlgebraicGeometry.Scheme.Hom.naturality π.left i
    have hLHS : CategoryTheory.IsIso
        (Y.left.presheaf.map i ≫ π.left.app ((U_iso.ι.opensFunctor).obj D'₀)) :=
      @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
        (CategoryTheory.Functor.map_isIso Y.left.presheaf i) hCompIso₁
    rw [hNat] at hLHS
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ (π.left.app D₀) _
      (CategoryTheory.Functor.map_isIso T.left.presheaf _) hLHS
  have hBijψ : Function.Bijective ψ := by
    have hAway := AlgebraicGeometry.IsAffineOpen.app_basicOpen_eq_away_map π.left hAffV hAffPreV r₀
    have hIsoComp : CategoryTheory.IsIso (π.left.app D₀) := hIsoAppD₀
    rw [hAway] at hIsoComp
    have hIsoψ : CategoryTheory.IsIso (CommRingCat.ofHom ψ) :=
      @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ (CommRingCat.ofHom ψ) _
        (CategoryTheory.Functor.map_isIso T.left.presheaf _) hIsoComp
    exact (@CategoryTheory.asIso _ _ _ _ (CommRingCat.ofHom ψ) hIsoψ).commRingCatIsoToRingEquiv.bijective

  
  have : AlgebraicGeometry.IsFinite (π.left ∣_ V) := hFinV
  have hTopV_eq : (V.ι.opensFunctor).obj ⊤ = V := by
    ext z
    simp
  have hFinφ : φ.Finite := by
    have hIsoFin : ∀ {A B : CommRingCat.{u}} (u : A ⟶ B) [CategoryTheory.IsIso u], u.hom.Finite :=
      fun u _ => RingHom.Finite.of_surjective u.hom
        (CategoryTheory.ConcreteCategory.bijective_of_isIso u).2
    have hCancelRightFin : ∀ {A B C : CommRingCat.{u}} (u : A ⟶ B) (e : B ⟶ C)
        [CategoryTheory.IsIso e], (u ≫ e).hom.Finite → u.hom.Finite := by
      intro A B C u e _ hfe
      have hu_eq : u = (u ≫ e) ≫ CategoryTheory.inv e := by simp
      rw [hu_eq]
      exact RingHom.Finite.comp (hIsoFin _) hfe
    have hFinTop : ((π.left ∣_ V).appTop).hom.Finite :=
      AlgebraicGeometry.IsFinite.finite_app (π.left ∣_ V) ⊤
        (AlgebraicGeometry.isAffineOpen_top (V : AlgebraicGeometry.Scheme))
    rw [AlgebraicGeometry.morphismRestrict_appTop] at hFinTop
    have hFinV' : (π.left.app ((V.ι.opensFunctor).obj ⊤)).hom.Finite :=
      @hCancelRightFin _ _ _ (π.left.app ((V.ι.opensFunctor).obj ⊤)) _
        (CategoryTheory.Functor.map_isIso T.left.presheaf _) hFinTop
    let j := (CategoryTheory.eqToHom hTopV_eq).op
    have hNatTop := AlgebraicGeometry.Scheme.Hom.naturality π.left j
    have hLHS_fin : (Y.left.presheaf.map j ≫ π.left.app ((V.ι.opensFunctor).obj ⊤)).hom.Finite :=
      RingHom.Finite.comp hFinV'
        (@hIsoFin _ _ (Y.left.presheaf.map j) (CategoryTheory.Functor.map_isIso Y.left.presheaf j))
    rw [hNatTop] at hLHS_fin
    exact @hCancelRightFin _ _ _ (π.left.app V) _
      (CategoryTheory.Functor.map_isIso T.left.presheaf _) hLHS_fin

  
  have hInjR : Function.Injective (algebraMap R_V R_D₀) :=
    IsLocalization.injective R_D₀
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hr₀_ne))
  have hInjS : Function.Injective (algebraMap S_V S_D₀) :=
    IsLocalization.injective S_D₀
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hφr₀_ne))
  have hψ_alg : ∀ r : R_V, ψ (algebraMap R_V R_D₀ r) = algebraMap S_V S_D₀ (φ r) :=
    fun r => IsLocalization.map_eq _ r
  have hInjφ : Function.Injective φ := by
    intro a b hab
    apply hInjR
    apply hBijψ.1
    rw [hψ_alg, hψ_alg, hab]
  have hSurjφ : Function.Surjective φ := by
    intro s
    let _ : Algebra R_V S_V := φ.toAlgebra
    have : Module.Finite R_V S_V := hFinφ
    have hs_int : IsIntegral R_V s := (Algebra.IsIntegral.of_finite R_V S_V).isIntegral s
    obtain ⟨P, hP_monic, hP_eval⟩ := hs_int
    have hP_eval' : Polynomial.eval₂ φ s P = 0 := hP_eval
    obtain ⟨z, hz⟩ := hBijψ.2 (algebraMap S_V S_D₀ s)
    let a : R_V := (IsLocalization.Away.sec r₀ z).1
    let n : ℕ := (IsLocalization.Away.sec r₀ z).2
    have hsec : z * algebraMap R_V R_D₀ (r₀ ^ n) = algebraMap R_V R_D₀ a :=
      IsLocalization.Away.sec_spec r₀ z
    have hs_eq : s * φ (r₀ ^ n) = φ a := by
      apply hInjS
      rw [map_mul, ← hz, ← hψ_alg, ← hψ_alg, ← map_mul, hsec]
    let q : R_V := r₀ ^ n
    have hq_ne : q ≠ 0 := pow_ne_zero n hr₀_ne
    have hφq_ne : φ q ≠ 0 := by
      change φ (r₀ ^ n) ≠ 0
      rw [map_pow]
      exact pow_ne_zero n hφr₀_ne
    have hφa : φ a = s * φ q := hs_eq.symm
    let d : ℕ := P.natDegree
    let C_num : R_V := ∑ i ∈ Finset.range (d + 1), P.coeff i * a ^ i * q ^ (d - i)
    have hφC : φ C_num = 0 := by
      change φ (∑ i ∈ Finset.range (d + 1), P.coeff i * a ^ i * q ^ (d - i)) = 0
      rw [map_sum]
      have hterm : ∀ i ∈ Finset.range (d + 1),
          φ (P.coeff i * a ^ i * q ^ (d - i)) = (φ (P.coeff i) * s ^ i) * φ q ^ d := by
        intro i hi
        have hi_le : i ≤ d := Nat.le_of_lt_succ (Finset.mem_range.mp hi)
        rw [map_mul, map_mul, map_pow, map_pow, hφa, mul_pow]
        calc
          φ (P.coeff i) * (s ^ i * φ q ^ i) * φ q ^ (d - i)
              = (φ (P.coeff i) * s ^ i) * (φ q ^ i * φ q ^ (d - i)) := by ring
          _ = (φ (P.coeff i) * s ^ i) * φ q ^ d := by
              rw [← pow_add, Nat.add_sub_of_le hi_le]
      rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, ← Polynomial.eval₂_eq_sum_range,
        hP_eval', zero_mul]
    have hC0 : C_num = 0 := hInjφ (by rw [hφC, map_zero])
    let K := FractionRing R_V
    let ιK : R_V →+* K := algebraMap R_V K
    have hιKq_ne : ιK q ≠ 0 := fun h0 =>
      hq_ne (IsFractionRing.injective R_V K (by rw [h0, map_zero]))
    let x : K := ιK a * (ιK q)⁻¹
    have hxq : x * ιK q = ιK a := inv_mul_cancel_right₀ hιKq_ne (ιK a)
    have hx_eval : Polynomial.eval₂ ιK x P = 0 := by
      have hιKC : ιK C_num = 0 := by rw [hC0, map_zero]
      change ιK (∑ i ∈ Finset.range (d + 1), P.coeff i * a ^ i * q ^ (d - i)) = 0 at hιKC
      rw [map_sum] at hιKC
      have htermK : ∀ i ∈ Finset.range (d + 1),
          ιK (P.coeff i * a ^ i * q ^ (d - i)) = (ιK (P.coeff i) * x ^ i) * ιK q ^ d := by
        intro i hi
        have hi_le : i ≤ d := Nat.le_of_lt_succ (Finset.mem_range.mp hi)
        rw [map_mul, map_mul, map_pow, map_pow, ← hxq, mul_pow]
        calc
          ιK (P.coeff i) * (x ^ i * ιK q ^ i) * ιK q ^ (d - i)
              = (ιK (P.coeff i) * x ^ i) * (ιK q ^ i * ιK q ^ (d - i)) := by ring
          _ = (ιK (P.coeff i) * x ^ i) * ιK q ^ d := by
              rw [← pow_add, Nat.add_sub_of_le hi_le]
      rw [Finset.sum_congr rfl htermK, ← Finset.sum_mul, ← Polynomial.eval₂_eq_sum_range] at hιKC
      exact (mul_eq_zero.mp hιKC).resolve_right (pow_ne_zero d hιKq_ne)
    have hx_int : IsIntegral R_V x := ⟨P, hP_monic, hx_eval⟩
    obtain ⟨b, hb⟩ := (isIntegrallyClosed_iff K).mp hICV hx_int
    have hbq : b * q = a := by
      apply IsFractionRing.injective R_V K
      change ιK (b * q) = ιK a
      rw [map_mul, hb, hxq]
    refine ⟨b, ?_⟩
    apply mul_right_cancel₀ hφq_ne
    rw [← map_mul, hbq, hφa]

  
  let e_φ := (RingEquiv.ofBijective φ ⟨hInjφ, hSurjφ⟩).toCommRingCatIso
  have he_φ : π.left.app V = e_φ.hom := by
    ext r; rfl
  have hIsoAppV : CategoryTheory.IsIso (π.left.app V) := by
    rw [he_φ]; infer_instance
  let j' := (CategoryTheory.eqToHom hTopV_eq.symm).op
  have hNatTop' := AlgebraicGeometry.Scheme.Hom.naturality π.left j'
  have hLHS_iso : CategoryTheory.IsIso (Y.left.presheaf.map j' ≫ π.left.app V) :=
    @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
      (CategoryTheory.Functor.map_isIso Y.left.presheaf j') hIsoAppV
  rw [hNatTop'] at hLHS_iso
  have hIsoV' : CategoryTheory.IsIso (π.left.app ((V.ι.opensFunctor).obj ⊤)) :=
    @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
      (π.left.app ((V.ι.opensFunctor).obj ⊤)) _
      (CategoryTheory.Functor.map_isIso T.left.presheaf _) hLHS_iso
  have hIsoAppTop : CategoryTheory.IsIso ((π.left ∣_ V).appTop) := by
    rw [AlgebraicGeometry.morphismRestrict_appTop π.left V]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIsoV'
      (CategoryTheory.Functor.map_isIso T.left.presheaf _)
  have hIsoV : CategoryTheory.IsIso (π.left ∣_ V) :=
    (@AlgebraicGeometry.HasAffineProperty.iff_of_isAffine
      (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) _
      AlgebraicGeometry.instHasAffinePropertyIsomorphismsSchemeAndIsAffineIsIsoCommRingCatAppTop
      _ _ (π.left ∣_ V) hAffV).mpr ⟨hAffPreV, hIsoAppTop⟩
  exact ⟨V, hAffV, hyV, hVW, hIsoV⟩

theorem weil_proj_infinite_field_two_hyperplane_avoidance_with_point (k : Type u) [Field k] [Infinite k] (N : ℕ)
    (S₀ : Set ↥(letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)))
    (p₀ : ↥(letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)))
    (hp₀ : p₀ ∈ S₀)
    (hClosedS₀ : IsClosed S₀)
    (hDimS₀ : topologicalKrullDim ↥S₀ ≤ (1 : WithBot ℕ∞)) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    ∃ (L₀ L₁ : MvPolynomial (Fin (N + 1)) k),
      L₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 ∧
      L₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 ∧
      p₀ ∈ AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₀ ∧
      p₀ ∈ AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₁ ∧
      S₀ ⊆ (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₀ :
          Set ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k))) ∪
        (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₁ :
          Set ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k))) :=
by
  have _ : p₀ ∈ S₀ ∧ IsClosed S₀ := ⟨hp₀, hClosedS₀⟩
  let A := MvPolynomial (Fin (N + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_k := AlgebraicGeometry.Proj 𝒜
  have hNoethProj : TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜) := by
    let toSpec : ProjectiveSpectrum 𝒜 → PrimeSpectrum A :=
      fun q => ⟨q.asHomogeneousIdeal.toIdeal, q.isPrime⟩
    have hInd : Topology.IsInducing toSpec := by
      rw [Topology.isInducing_iff]
      ext s
      rw [isOpen_induced_iff]
      constructor
      · intro hs
        obtain ⟨E, hEs⟩ := (ProjectiveSpectrum.isOpen_iff 𝒜 s).mp hs
        refine ⟨(PrimeSpectrum.zeroLocus E)ᶜ, (PrimeSpectrum.isClosed_zeroLocus E).isOpen_compl, ?_⟩
        rw [← compl_inj_iff, Set.preimage_compl, compl_compl, hEs]
        rfl
      · rintro ⟨t, ht, rfl⟩
        obtain ⟨E, hEt⟩ := (PrimeSpectrum.isOpen_iff t).mp ht
        refine (ProjectiveSpectrum.isOpen_iff 𝒜 (toSpec ⁻¹' t)).mpr ⟨E, ?_⟩
        rw [← Set.preimage_compl, hEt]
        rfl
    exact hInd.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥P_k := hNoethProj
  let V : ↥P_k → Subspace k ↥(𝒜 1) := fun q =>
    (q.asHomogeneousIdeal.toIdeal.restrictScalars k).comap (𝒜 1).subtype
  have hV_ne_top : ∀ q : ↥P_k, V q ≠ ⊤ := by
    intro q
    have hX : ∃ j : Fin (N + 1), (MvPolynomial.X j : A) ∉ q.asHomogeneousIdeal := by
      by_contra hEx
      have hAll : ∀ j : Fin (N + 1), (MvPolynomial.X j : A) ∈ q.asHomogeneousIdeal :=
        fun j => Classical.byContradiction fun hj => hEx ⟨j, hj⟩
      apply q.not_irrelevant_le
      intro p hp
      have hproj0 : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hdecEq : ((DirectSum.decompose 𝒜 p) 0 : ↥(𝒜 0)) =
          (DirectSum.Decomposition.decompose' p) 0 := rfl
      have hcomp0 : MvPolynomial.homogeneousComponent 0 p = 0 := by
        rw [GradedRing.proj_apply, hdecEq, MvPolynomial.decomposition.decompose'_apply] at hproj0
        exact hproj0
      have hp0 : p.coeff 0 = 0 := by
        have hc := congrArg (fun f : MvPolynomial (Fin (N + 1)) k => f.coeff 0) hcomp0
        simpa [MvPolynomial.coeff_homogeneousComponent] using hc
      have hp_span : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hm_ne : m ≠ 0 := by
          intro hm0
          subst hm0
          exact (MvPolynomial.mem_support_iff.mp hm) hp0
        obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp hm_ne
        exact ⟨j, Set.mem_univ j, hj⟩
      have hspan_le : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
          q.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨j, -, rfl⟩
        exact hAll j
      exact hspan_le hp_span
    obtain ⟨j, hj_notMem⟩ := hX
    intro hTop
    have hXj_hom : (MvPolynomial.X j : A) ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X j)).mpr
        (MvPolynomial.isHomogeneous_X k j)
    have hmem : (⟨MvPolynomial.X j, hXj_hom⟩ : ↥(𝒜 1)) ∈ V q := by
      rw [hTop]
      trivial
    exact hj_notMem hmem
  have hAvoid : ∀ (ι : Type u) [Finite ι] (pts : ι → ↥P_k),
      ∃ L : A, L ∈ 𝒜 1 ∧ ∀ i : ι, pts i ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L := by
    intro ι _ pts
    have hNeUniv : (⋃ i : ι, (V (pts i) : Set ↥(𝒜 1))) ≠ Set.univ := by
      intro hUniv
      obtain ⟨i, hi⟩ := Subspace.exists_eq_top_of_iUnion_eq_univ hUniv
      exact hV_ne_top (pts i) hi
    obtain ⟨ℓ, hℓ⟩ := (Set.ne_univ_iff_exists_notMem _).mp hNeUniv
    refine ⟨ℓ.1, ℓ.2, fun i => ?_⟩
    rw [AlgebraicGeometry.Proj.mem_basicOpen]
    intro hMem
    exact hℓ (Set.mem_iUnion.mpr ⟨i, hMem⟩)
  have _ : TopologicalSpace.NoetherianSpace ↥S₀ :=
    TopologicalSpace.NoetherianSpace.set S₀
  have _ : Finite ↥(irreducibleComponents ↥S₀) :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.to_subtype
  let x_C : ↥(irreducibleComponents ↥S₀) → ↥S₀ := fun C => C.2.1.nonempty.some
  have hx_C : ∀ C : ↥(irreducibleComponents ↥S₀), x_C C ∈ C.1 :=
    fun C => C.2.1.nonempty.some_mem
  let pts₀ : Option ↥(irreducibleComponents ↥S₀) → ↥P_k :=
    fun o => Option.elim o p₀ (fun C => (x_C C).1)
  obtain ⟨L₀, hL₀, hPts₀⟩ := hAvoid (Option ↥(irreducibleComponents ↥S₀)) pts₀
  have hp₀_L₀ : p₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L₀ := hPts₀ none
  have hComp₀ : ∀ C : ↥(irreducibleComponents ↥S₀),
      (x_C C).1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L₀ :=
    fun C => hPts₀ (some C)
  let S₁ : Set ↥S₀ := {x : ↥S₀ | x.1 ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 L₀}
  have hClosedS₁ : IsClosed S₁ :=
    (AlgebraicGeometry.Proj.basicOpen 𝒜 L₀).isOpen.isClosed_compl.preimage continuous_subtype_val
  have _ : TopologicalSpace.NoetherianSpace ↥S₁ :=
    TopologicalSpace.NoetherianSpace.set S₁
  have _ : Finite ↥(irreducibleComponents ↥S₁) :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.to_subtype
  let y_C : ↥(irreducibleComponents ↥S₁) → ↥S₁ := fun C' => C'.2.1.nonempty.some
  have hy_C : ∀ C' : ↥(irreducibleComponents ↥S₁), y_C C' ∈ C'.1 :=
    fun C' => C'.2.1.nonempty.some_mem
  let pts₁ : Option ↥(irreducibleComponents ↥S₁) → ↥P_k :=
    fun o => Option.elim o p₀ (fun C' => (y_C C').1.1)
  obtain ⟨L₁, hL₁, hPts₁⟩ := hAvoid (Option ↥(irreducibleComponents ↥S₁)) pts₁
  have hp₀_L₁ : p₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L₁ := hPts₁ none
  have hComp₁ : ∀ C' : ↥(irreducibleComponents ↥S₁),
      (y_C C').1.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 L₁ :=
    fun C' => hPts₁ (some C')
  refine ⟨L₀, L₁, hL₀, hL₁, hp₀_L₀, hp₀_L₁, ?_⟩
  intro z hz
  by_contra hzNot
  have hzNot₀ : z ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 L₀ :=
    fun h => hzNot (Or.inl h)
  have hzNot₁ : z ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 L₁ :=
    fun h => hzNot (Or.inr h)
  let z₀ : ↥S₀ := ⟨z, hz⟩
  let z₁ : ↥S₁ := ⟨z₀, hzNot₀⟩
  let Z₀ : Set ↥S₀ := closure ({z₀} : Set ↥S₀)
  let z₀_ic : TopologicalSpace.IrreducibleCloseds ↥S₀ :=
    ⟨Z₀, isIrreducible_singleton.closure, isClosed_closure⟩
  let W₁ : Set ↥S₀ := {w : ↥S₀ | w.1 ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 L₁}
  have hClosedW₁ : IsClosed W₁ :=
    (AlgebraicGeometry.Proj.basicOpen 𝒜 L₁).isOpen.isClosed_compl.preimage continuous_subtype_val
  have hZ₀_sub_W₁ : Z₀ ⊆ W₁ :=
    hClosedW₁.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hzNot₁)
  let C₁_set : Set ↥S₁ := irreducibleComponent z₁
  let Z₁ : Set ↥S₀ := Subtype.val '' C₁_set
  have hIrredZ₁ : IsIrreducible Z₁ :=
    isIrreducible_irreducibleComponent.image Subtype.val continuous_subtype_val.continuousOn
  have hClosedZ₁ : IsClosed Z₁ :=
    (hClosedS₁.isClosedEmbedding_subtypeVal).isClosedMap C₁_set isClosed_irreducibleComponent
  let z₁_ic : TopologicalSpace.IrreducibleCloseds ↥S₀ := ⟨Z₁, hIrredZ₁, hClosedZ₁⟩
  have hZ₁_sub_S₁ : Z₁ ⊆ S₁ := by
    rintro _ ⟨u, -, rfl⟩
    exact u.2
  have h₀₁ : z₀_ic < z₁_ic := by
    apply lt_of_le_of_ne
    · change Z₀ ⊆ Z₁
      exact hClosedZ₁.closure_subset_iff.mpr
        (Set.singleton_subset_iff.mpr ⟨z₁, mem_irreducibleComponent, rfl⟩)
    · intro hEq
      let C' : ↥(irreducibleComponents ↥S₁) :=
        ⟨C₁_set, irreducibleComponent_mem_irreducibleComponents z₁⟩
      have hw₁_Z₁ : (y_C C').1 ∈ Z₁ := ⟨y_C C', hy_C C', rfl⟩
      have hw₁_Z₀ : (y_C C').1 ∈ Z₀ := by
        have hSetEq : Z₀ = Z₁ := congrArg SetLike.coe hEq
        rwa [hSetEq]
      exact hZ₀_sub_W₁ hw₁_Z₀ (hComp₁ C')
  obtain ⟨C, hMemC, hZ₁_sub_C⟩ :=
    exists_mem_irreducibleComponents_subset_of_isIrreducible Z₁ hIrredZ₁
  let z₂_ic : TopologicalSpace.IrreducibleCloseds ↥S₀ :=
    ⟨C, hMemC.1, isClosed_of_mem_irreducibleComponents C hMemC⟩
  have h₁₂ : z₁_ic < z₂_ic := by
    apply lt_of_le_of_ne
    · exact hZ₁_sub_C
    · intro hEq
      let C₀ : ↥(irreducibleComponents ↥S₀) := ⟨C, hMemC⟩
      have hw₂_C : x_C C₀ ∈ C := hx_C C₀
      have hw₂_Z₁ : x_C C₀ ∈ Z₁ := by
        have hSetEq : Z₁ = C := congrArg SetLike.coe hEq
        rwa [← hSetEq] at hw₂_C
      exact hZ₁_sub_S₁ hw₂_Z₁ (hComp₀ C₀)
  let l : LTSeries (TopologicalSpace.IrreducibleCloseds ↥S₀) :=
    ((RelSeries.singleton _ z₀_ic :
      LTSeries (TopologicalSpace.IrreducibleCloseds ↥S₀)).snoc z₁_ic h₀₁).snoc z₂_ic h₁₂
  have h2le : (2 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S₀ :=
    Order.le_krullDim_iff.mpr ⟨l, rfl⟩
  have h21 : (2 : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) :=
    le_trans h2le hDimS₀
  norm_cast at h21

theorem weil_proper_two_affine_proj_line_finite (k : Type u) [CommRing k]
    (R₀ : Type u) [CommRing R₀] [Nontrivial R₀]
    (N : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u})
    (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀)) [AlgebraicGeometry.IsProper p]
    (gProj : Y ⟶ (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)))
    (L₀ L₁ : MvPolynomial (Fin (N + 1)) k)
    (hL₀ : L₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
    (hL₁ : L₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
    (hAff₀ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map gProj.base).obj
          (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₀)))
    (hAff₁ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map gProj.base).obj
          (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₁)))
    (hAff₀₁ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map gProj.base).obj
            (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₀) ⊓
          (TopologicalSpace.Opens.map gProj.base).obj
            (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₁)))
    (hCovY : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (TopologicalSpace.Opens.map gProj.base).obj
          (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₀) ⊔
        (TopologicalSpace.Opens.map gProj.base).obj
          (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₁) = ⊤) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let V₀ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj
      (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₀)
    let V₁ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj
      (AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) L₁)
    let r₀ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
      p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
    let r₁ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
      p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : V₁ ≤ ⊤)).op).hom
    let res₀ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
    let res₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
    ∃ (u : ↑(Y.presheaf.obj (Opposite.op V₀))) (v : ↑(Y.presheaf.obj (Opposite.op V₁))),
      res₀ u * res₁ v = 1 ∧
      (Polynomial.eval₂RingHom r₀ u).Finite ∧
      (Polynomial.eval₂RingHom r₁ v).Finite ∧
      (∀ z : ↑(Y.presheaf.obj (Opposite.op (V₀ ⊓ V₁))),
        ∃ (m : ℕ) (b₀ : ↑(Y.presheaf.obj (Opposite.op V₀))),
          z * (res₀ u) ^ m = res₀ b₀) ∧
      (∀ z : ↑(Y.presheaf.obj (Opposite.op (V₀ ⊓ V₁))),
        ∃ (m : ℕ) (b₁ : ↑(Y.presheaf.obj (Opposite.op V₁))),
          z * (res₁ v) ^ m = res₁ b₁) :=
by
  let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
  let P_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_k
  let D₀ : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k L₀
  let D₁ : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k L₁
  let V₀ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj D₀
  let V₁ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj D₁
  let r₀ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
    p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
  let r₁ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
    p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : V₁ ≤ ⊤)).op).hom
  let res₀ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
  let res₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom

  
  
  
  have hProjBasicOpen : ∀ (f g : MvPolynomial (Fin (N + 1)) k) (hf : f ∈ 𝒜_k 1) (hg : g ∈ 𝒜_k 1),
      P_k.basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜_k f).hom
        (HomogeneousLocalization.Away.isLocalizationElem hf hg)) =
      AlgebraicGeometry.Proj.basicOpen 𝒜_k f ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_k g := by
    intro f g hf hg
    let D_f : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k f
    let D_g : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k g
    have hAffDf : AlgebraicGeometry.IsAffineOpen D_f :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_k f hf zero_lt_one
    let s_fg : ↑(P_k.presheaf.obj (Opposite.op D_f)) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜_k f).hom
        (HomogeneousLocalization.Away.isLocalizationElem hf hg)
    have hFromSpec :
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_k f) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_k f hf zero_lt_one = hAffDf.fromSpec := by
      have h1 : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_k f hf zero_lt_one).hom =
          D_f.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_k f) := rfl
      have h2 : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_k f hf zero_lt_one).inv ≫ D_f.ι =
          AlgebraicGeometry.Proj.awayι 𝒜_k f hf zero_lt_one := rfl
      have h3 : hAffDf.isoSpec.inv ≫ D_f.toSpecΓ = 𝟙 _ := by
        rw [← hAffDf.isoSpec_hom, CategoryTheory.Iso.inv_hom_id]
      calc
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_k f) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_k f hf zero_lt_one
          = (hAffDf.isoSpec.inv ≫ D_f.toSpecΓ) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_k f) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_k f hf zero_lt_one).inv ≫ D_f.ι := by
            rw [h3, CategoryTheory.Category.id_comp, h2]
        _ = hAffDf.isoSpec.inv ≫
              (D_f.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_k f)) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_k f hf zero_lt_one).inv ≫ D_f.ι := by
            simp only [CategoryTheory.Category.assoc]
        _ = hAffDf.isoSpec.inv ≫ D_f.ι := by
            rw [← h1, CategoryTheory.Iso.hom_inv_id_assoc]
        _ = hAffDf.fromSpec := rfl
    have hPre : (TopologicalSpace.Opens.map hAffDf.fromSpec.base).obj D_g =
        PrimeSpectrum.basicOpen s_fg := by
      rw [← hFromSpec]
      change (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_k f)).base).obj
        ((TopologicalSpace.Opens.map
          (AlgebraicGeometry.Proj.awayι 𝒜_k f hf zero_lt_one).base).obj D_g) = _
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_k hf zero_lt_one hg zero_lt_one,
        AlgebraicGeometry.SpecMap_preimage_basicOpen]
    have hImg := congrArg (AlgebraicGeometry.Scheme.Hom.opensFunctor hAffDf.fromSpec).obj hPre
    rw [AlgebraicGeometry.Scheme.Hom.image_preimage_eq_opensRange_inf,
      hAffDf.opensRange_fromSpec, hAffDf.fromSpec_image_basicOpen] at hImg
    exact hImg.symm

  let u_raw := HomogeneousLocalization.Away.isLocalizationElem hL₀ hL₁
  let v_raw := HomogeneousLocalization.Away.isLocalizationElem hL₁ hL₀
  let u_k := (AlgebraicGeometry.Proj.awayToSection 𝒜_k L₀).hom u_raw
  let v_k := (AlgebraicGeometry.Proj.awayToSection 𝒜_k L₁).hom v_raw
  let u : ↑(Y.presheaf.obj (Opposite.op V₀)) := (gProj.app D₀).hom u_k
  let v : ↑(Y.presheaf.obj (Opposite.op V₁)) := (gProj.app D₁).hom v_k

  have hu : Y.basicOpen u = V₀ ⊓ V₁ := by
    change Y.basicOpen ((gProj.app D₀).hom u_k) = V₀ ⊓ V₁
    rw [← gProj.preimage_basicOpen u_k, hProjBasicOpen L₀ L₁ hL₀ hL₁]
    rfl

  have hv : Y.basicOpen v = V₀ ⊓ V₁ := by
    change Y.basicOpen ((gProj.app D₁).hom v_k) = V₀ ⊓ V₁
    rw [← gProj.preimage_basicOpen v_k, hProjBasicOpen L₁ L₀ hL₁ hL₀]
    exact inf_comm V₁ V₀

  have huv : res₀ u * res₁ v = 1 := by
    let u_tilde := HomogeneousLocalization.awayMap 𝒜_k hL₁ rfl u_raw
    let v_tilde := HomogeneousLocalization.awayMap 𝒜_k hL₀ (mul_comm L₀ L₁) v_raw
    have h_uv_raw : u_tilde * v_tilde = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one]
      dsimp [u_tilde, v_tilde, u_raw, v_raw, HomogeneousLocalization.Away.isLocalizationElem]
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, ← Localization.mk_self (1 : Submonoid.powers (L₀ * L₁)),
        Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_one, Submonoid.coe_mul]
      ring
    let D₀₁ : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k (L₀ * L₁)
    have hD₀₁ : D₀₁ = D₀ ⊓ D₁ := AlgebraicGeometry.Proj.basicOpen_mul 𝒜_k L₀ L₁
    let V₀₁ : Y.Opens := (TopologicalSpace.Opens.map gProj.base).obj D₀₁
    have hV₀₁ : V₀₁ = V₀ ⊓ V₁ := congrArg (TopologicalSpace.Opens.map gProj.base).obj hD₀₁
    let ψ_cat := AlgebraicGeometry.Proj.awayToSection 𝒜_k (L₀ * L₁) ≫
      gProj.app D₀₁ ≫ Y.presheaf.map (CategoryTheory.homOfLE hV₀₁.ge).op
    have hψ_u : ψ_cat.hom u_tilde = res₀ u := by
      have hcomp : CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_k hL₁ rfl) ≫ ψ_cat =
          AlgebraicGeometry.Proj.awayToSection 𝒜_k L₀ ≫ gProj.app D₀ ≫
            Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op := by
        dsimp [ψ_cat]
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_k hL₁ rfl,
          CategoryTheory.Category.assoc,
          gProj.naturality_assoc,
          ← Y.presheaf.map_comp]
        rfl
      exact congrArg (fun f => f.hom u_raw) hcomp
    have hψ_v : ψ_cat.hom v_tilde = res₁ v := by
      have hcomp : CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_k hL₀ (mul_comm L₀ L₁)) ≫ ψ_cat =
          AlgebraicGeometry.Proj.awayToSection 𝒜_k L₁ ≫ gProj.app D₁ ≫
            Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op := by
        dsimp [ψ_cat]
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_k hL₀ (mul_comm L₀ L₁),
          CategoryTheory.Category.assoc,
          gProj.naturality_assoc,
          ← Y.presheaf.map_comp]
        rfl
      exact congrArg (fun f => f.hom v_raw) hcomp
    calc
      res₀ u * res₁ v = ψ_cat.hom u_tilde * ψ_cat.hom v_tilde := by rw [hψ_u, hψ_v]
      _ = ψ_cat.hom (u_tilde * v_tilde) := (map_mul ψ_cat.hom u_tilde v_tilde).symm
      _ = ψ_cat.hom 1 := by rw [h_uv_raw]
      _ = 1 := map_one ψ_cat.hom

  have hLocClear : ∀ (W : Y.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W)
      (s : ↑(Y.presheaf.obj (Opposite.op W))) (hs : Y.basicOpen s = V₀ ⊓ V₁)
      (hle : V₀ ⊓ V₁ ≤ W) (z : ↑(Y.presheaf.obj (Opposite.op (V₀ ⊓ V₁)))),
      ∃ (m : ℕ) (b : ↑(Y.presheaf.obj (Opposite.op W))),
        z * ((Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom s) ^ m =
          (Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom b := by
    intro W hAffW s hs hle z
    letI : Algebra ↑(Y.presheaf.obj (Opposite.op W))
        ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s))) :=
      (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op).hom.toAlgebra
    haveI : IsLocalization.Away s ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s))) :=
      hAffW.isLocalization_basicOpen s
    let α := (Y.presheaf.map (CategoryTheory.homOfLE hs.le).op).hom
    let β := (Y.presheaf.map (CategoryTheory.homOfLE hs.ge).op).hom
    have hβα : ∀ x, β (α x) = x := by
      intro x
      change (Y.presheaf.map (CategoryTheory.homOfLE hs.le).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE hs.ge).op).hom x = x
      rw [← Y.presheaf.map_comp]
      have hid : CategoryTheory.homOfLE hs.ge ≫ CategoryTheory.homOfLE hs.le = 𝟙 (V₀ ⊓ V₁) :=
        Subsingleton.elim _ _
      rw [← CategoryTheory.op_comp, hid, CategoryTheory.op_id, Y.presheaf.map_id]
      rfl
    have hβ_alg : ∀ b : ↑(Y.presheaf.obj (Opposite.op W)),
        β (algebraMap ↑(Y.presheaf.obj (Opposite.op W))
          ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s))) b) =
        (Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom b := by
      intro b
      change (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE hs.ge).op).hom b = _
      rw [← Y.presheaf.map_comp]
      rfl
    obtain ⟨⟨b, _, m, rfl⟩, hzb⟩ := IsLocalization.surj (Submonoid.powers s) (α z)
    dsimp at hzb
    refine ⟨m, b, ?_⟩
    have happ := congrArg β hzb
    rw [map_mul, hβα, hβ_alg, hβ_alg, map_pow] at happ
    exact happ

  have hLoc₀ := hLocClear V₀ hAff₀ u hu inf_le_left
  have hLoc₁ := hLocClear V₁ hAff₁ v hv inf_le_right

  
  
  
  let A_R₀ := MvPolynomial (Fin 2) R₀
  let 𝒜_R₀ := MvPolynomial.homogeneousSubmodule (Fin 2) R₀
  letI : GradedAlgebra 𝒜_R₀ := MvPolynomial.gradedAlgebra
  let W₀ : A_R₀ := MvPolynomial.X 0
  let W₁ : A_R₀ := MvPolynomial.X 1
  have hW₀ : W₀ ∈ 𝒜_R₀ 1 := MvPolynomial.isHomogeneous_X R₀ (0 : Fin 2)
  have hW₁ : W₁ ∈ 𝒜_R₀ 1 := MvPolynomial.isHomogeneous_X R₀ (1 : Fin 2)
  let cHom : R₀ →+* HomogeneousLocalization.Away 𝒜_R₀ W₀ :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜_R₀ (Submonoid.powers W₀)).comp
      (algebraMap R₀ ↥(𝒜_R₀ 0))
  let tElem : HomogeneousLocalization.Away 𝒜_R₀ W₀ :=
    HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁
  let toAway : Polynomial R₀ →+* HomogeneousLocalization.Away 𝒜_R₀ W₀ :=
    Polynomial.eval₂RingHom cHom tElem

  let valRingHom : ∀ (S : Submonoid A_R₀),
      HomogeneousLocalization 𝒜_R₀ S →+* Localization S := fun S =>
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }

  have hDegTwo : ∀ {n : ℕ} {f : A_R₀}, f ∈ 𝒜_R₀ n → ∀ {d : Fin 2 →₀ ℕ},
      d ∈ f.support → d 0 + d 1 = n := by
    intro n f hf d hd
    have hf_hom : f.IsHomogeneous n := (MvPolynomial.mem_homogeneousSubmodule n f).mp hf
    have hdeg : Finsupp.degree d = n := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd) (hf_hom.coeff_eq_zero hne)
    have hsum : Finsupp.degree d = d 0 + d 1 := by
      change d.sum (fun _ e => e) = d 0 + d 1
      rw [Finsupp.sum_fintype d (fun _ e => e) (fun _ => rfl), Fin.sum_univ_two]
    exact hsum.symm.trans hdeg

  have hMonomialTwo : ∀ (d : Fin 2 →₀ ℕ) (c : R₀),
      MvPolynomial.monomial d c = MvPolynomial.C c * W₀ ^ (d 0) * W₁ ^ (d 1) := by
    intro d c
    rw [MvPolynomial.monomial_eq,
      Finsupp.prod_fintype d (fun i e => MvPolynomial.X i ^ e) (fun i => pow_zero _),
      Fin.prod_univ_two]
    dsimp [W₀, W₁]
    ring

  have hSurjToAway : Function.Surjective toAway := by
    let dehomog : A_R₀ →ₐ[R₀] Polynomial R₀ :=
      MvPolynomial.aeval (fun i : Fin 2 => if i = 0 then (1 : Polynomial R₀) else Polynomial.X)
    intro z
    obtain ⟨n, f, hf_smul, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_R₀ hW₀ z
    have hf : f ∈ 𝒜_R₀ n := by simpa [smul_eq_mul, mul_one] using hf_smul
    refine ⟨dehomog f, ?_⟩
    apply HomogeneousLocalization.val_injective
    change (valRingHom (Submonoid.powers W₀)) (toAway (dehomog f)) = _
    rw [HomogeneousLocalization.Away.val_mk]
    let ψ_loc : A_R₀ →+* Localization (Submonoid.powers W₀) :=
      (valRingHom (Submonoid.powers W₀)).comp (toAway.comp dehomog.toRingHom)
    let den_n : Submonoid.powers W₀ :=
      ⟨W₀ ^ n, pow_mem (Submonoid.mem_powers W₀) n⟩
    let den_1 : Submonoid.powers W₀ :=
      ⟨W₀ ^ 1, pow_mem (Submonoid.mem_powers W₀) 1⟩
    change ψ_loc f = Localization.mk f den_n
    have hMkSum : ∀ (s : Finset (Fin 2 →₀ ℕ)) (g : (Fin 2 →₀ ℕ) → A_R₀),
        (∑ d ∈ s, Localization.mk (g d) den_n) =
          Localization.mk (∑ d ∈ s, g d) den_n := by
      intro s g
      induction s using Finset.cons_induction with
      | empty =>
        simp [Localization.mk_zero]
      | cons d s hd ih =>
        rw [Finset.sum_cons, Finset.sum_cons, ih, Localization.add_mk_self]
    conv_lhs => rw [MvPolynomial.as_sum f]
    rw [map_sum]
    have hTerm : ∀ d ∈ f.support,
        ψ_loc (MvPolynomial.monomial d (f.coeff d)) =
          Localization.mk (MvPolynomial.monomial d (f.coeff d)) den_n := by
      intro d hd
      have hdn : d 0 + d 1 = n := hDegTwo hf hd
      let c := f.coeff d
      have hmon := hMonomialTwo d c
      have hdeh : dehomog (MvPolynomial.monomial d c) = Polynomial.C c * Polynomial.X ^ (d 1) := by
        rw [hmon, map_mul, map_mul, MvPolynomial.aeval_C, map_pow, map_pow,
          MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        change Polynomial.C c * (1 : Polynomial R₀) ^ (d 0) * Polynomial.X ^ (d 1) = _
        simp
      have hto : toAway (dehomog (MvPolynomial.monomial d c)) = cHom c * tElem ^ (d 1) := by
        rw [hdeh, map_mul, map_pow]
        dsimp [toAway]
        simp only [Polynomial.eval₂_C, Polynomial.eval₂_X]
      change (valRingHom (Submonoid.powers W₀)) (toAway (dehomog (MvPolynomial.monomial d c))) = _
      rw [hto, map_mul, map_pow]
      have hvc : (valRingHom (Submonoid.powers W₀)) (cHom c) =
          Localization.mk (MvPolynomial.C c) (1 : Submonoid.powers W₀) := by
        rfl
      have hvt : (valRingHom (Submonoid.powers W₀)) tElem =
          Localization.mk W₁ den_1 := by
        change Localization.mk (W₁ ^ 1) den_1 = Localization.mk W₁ den_1
        rw [pow_one]
      rw [hvc, hvt, Localization.mk_pow, Localization.mk_mul, one_mul]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_one, one_mul]
      calc
        W₀ ^ n * (MvPolynomial.C c * W₁ ^ (d 1))
          = MvPolynomial.C c * (W₀ ^ (d 0 + d 1)) * W₁ ^ (d 1) := by rw [hdn]; ring
        _ = MvPolynomial.C c * (W₀ ^ (d 0) * W₀ ^ (d 1)) * W₁ ^ (d 1) := by rw [pow_add]
        _ = (W₀ ^ 1) ^ (d 1) * (MvPolynomial.C c * W₀ ^ (d 0) * W₁ ^ (d 1)) := by ring
        _ = (W₀ ^ 1) ^ (d 1) * MvPolynomial.monomial d c := by rw [← hmon]
    rw [Finset.sum_congr rfl hTerm, hMkSum, ← MvPolynomial.as_sum f]

  have hFinToAway : toAway.Finite := RingHom.Finite.of_surjective toAway hSurjToAway

  
  
  
  have hAwayChartFinite : ∀ (U₀ U₁ : Y.Opens)
      (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
      (hU₁ : AlgebraicGeometry.IsAffineOpen U₁)
      (hU₀₁ : AlgebraicGeometry.IsAffineOpen (U₀ ⊓ U₁))
      (hCovU : U₀ ⊔ U₁ = ⊤)
      (u' : ↑(Y.presheaf.obj (Opposite.op U₀)))
      (v' : ↑(Y.presheaf.obj (Opposite.op U₁)))
      (hu' : Y.basicOpen u' = U₀ ⊓ U₁)
      (hv' : Y.basicOpen v' = U₀ ⊓ U₁)
      (huv' : (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom u' *
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom v' = 1),
      let rU₀ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom
      ∃ (φ₀ : HomogeneousLocalization.Away 𝒜_R₀ W₀ →+* ↑(Y.presheaf.obj (Opposite.op U₀))),
        φ₀.Finite ∧
        (∀ c : R₀, φ₀ (cHom c) = rU₀ c) ∧
        φ₀ tElem = u' := by
    intro U₀ U₁ hU₀ hU₁ hU₀₁ hCovU u' v' hu' hv' huv'
    let B₀ : Type u := ↑(Y.presheaf.obj (Opposite.op U₀))
    let B₁ : Type u := ↑(Y.presheaf.obj (Opposite.op U₁))
    let B₀₁ : Type u := ↑(Y.presheaf.obj (Opposite.op (U₀ ⊓ U₁)))
    let resU₀ : B₀ →+* B₀₁ :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom
    let resU₁ : B₁ →+* B₀₁ :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom
    let rU₀ : R₀ →+* B₀ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom
    let rU₁ : R₀ →+* B₁ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op).hom
    let rU₀₁ : R₀ →+* B₀₁ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op).hom
    have hr₀_comp : resU₀.comp rU₀ = rU₀₁ := by
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        p.appTop ≫ (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op)).hom = _
      rw [← Y.presheaf.map_comp]
      rfl
    have hr₁_comp : resU₁.comp rU₁ = rU₀₁ := by
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        p.appTop ≫ (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op)).hom = _
      rw [← Y.presheaf.map_comp]
      rfl

    let ev₀ : MvPolynomial (Fin 2) R₀ →+* B₀ := MvPolynomial.eval₂Hom rU₀ ![1, u']
    let ev₁ : MvPolynomial (Fin 2) R₀ →+* B₁ := MvPolynomial.eval₂Hom rU₁ ![v', 1]
    let ev₀₁ : MvPolynomial (Fin 2) R₀ →+* B₀₁ := MvPolynomial.eval₂Hom rU₀₁ ![1, resU₀ u']
    have hv₀ : ev₀ W₀ * 1 = 1 := by
      dsimp [ev₀, W₀, A_R₀]
      rw [MvPolynomial.eval₂_X]
      simp
    have hv₁ : ev₁ W₁ * 1 = 1 := by
      dsimp [ev₁, W₁, A_R₀]
      rw [MvPolynomial.eval₂_X]
      simp
    have hv₀₁ : ev₀₁ (W₀ * W₁) * resU₁ v' = 1 := by
      have hw : ev₀₁ (W₀ * W₁) = resU₀ u' := by
        rw [map_mul]
        dsimp [ev₀₁, W₀, W₁, A_R₀]
        rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
        simp
      rw [hw]
      exact huv'
    have hW₀₁ : W₀ * W₁ ∈ 𝒜_R₀ (1 + 1) := SetLike.mul_mem_graded hW₀ hW₁

    let φ₀ : HomogeneousLocalization.Away 𝒜_R₀ W₀ →+* B₀ :=
      (Localization.awayLift ev₀ W₀ (IsUnit.of_mul_eq_one 1 hv₀)).comp
        (valRingHom (Submonoid.powers W₀))
    let φ₁ : HomogeneousLocalization.Away 𝒜_R₀ W₁ →+* B₁ :=
      (Localization.awayLift ev₁ W₁ (IsUnit.of_mul_eq_one 1 hv₁)).comp
        (valRingHom (Submonoid.powers W₁))
    let φ₀₁ : HomogeneousLocalization.Away 𝒜_R₀ (W₀ * W₁) →+* B₀₁ :=
      (Localization.awayLift ev₀₁ (W₀ * W₁) (IsUnit.of_mul_eq_one (resU₁ v') hv₀₁)).comp
        (valRingHom (Submonoid.powers (W₀ * W₁)))

    have hφ₀_mk : ∀ (j : ℕ) (a : A_R₀) (ha : a ∈ 𝒜_R₀ (j • 1)),
        φ₀ (HomogeneousLocalization.Away.mk 𝒜_R₀ hW₀ j a ha) = ev₀ a := by
      intro j a ha
      change (Localization.awayLift ev₀ W₀ (IsUnit.of_mul_eq_one 1 hv₀))
        ((HomogeneousLocalization.Away.mk 𝒜_R₀ hW₀ j a ha).val) = ev₀ a
      rw [HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ev₀ W₀ a 1 hv₀ j,
        one_pow, mul_one]
    have hφ₁_mk : ∀ (j : ℕ) (a : A_R₀) (ha : a ∈ 𝒜_R₀ (j • 1)),
        φ₁ (HomogeneousLocalization.Away.mk 𝒜_R₀ hW₁ j a ha) = ev₁ a := by
      intro j a ha
      change (Localization.awayLift ev₁ W₁ (IsUnit.of_mul_eq_one 1 hv₁))
        ((HomogeneousLocalization.Away.mk 𝒜_R₀ hW₁ j a ha).val) = ev₁ a
      rw [HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ev₁ W₁ a 1 hv₁ j,
        one_pow, mul_one]
    have hφ₀₁_mk : ∀ (j : ℕ) (a : A_R₀) (ha : a ∈ 𝒜_R₀ (j • (1 + 1))),
        φ₀₁ (HomogeneousLocalization.Away.mk 𝒜_R₀ hW₀₁ j a ha) = ev₀₁ a * (resU₁ v') ^ j := by
      intro j a ha
      change (Localization.awayLift ev₀₁ (W₀ * W₁) (IsUnit.of_mul_eq_one (resU₁ v') hv₀₁))
        ((HomogeneousLocalization.Away.mk 𝒜_R₀ hW₀₁ j a ha).val) = _
      rw [HomogeneousLocalization.Away.val_mk,
        Localization.awayLift_mk ev₀₁ (W₀ * W₁) a (resU₁ v') hv₀₁ j]

    have hφ₀_c : ∀ c : R₀, φ₀ (cHom c) = rU₀ c := by
      intro c
      change (Localization.awayLift ev₀ W₀ (IsUnit.of_mul_eq_one 1 hv₀)) ((cHom c).val) = rU₀ c
      let den0_W₀ : Submonoid.powers W₀ :=
        ⟨W₀ ^ 0, pow_mem (Submonoid.mem_powers W₀) 0⟩
      have hval : (cHom c).val = Localization.mk (MvPolynomial.C c) den0_W₀ := by
        have h1 : (1 : Submonoid.powers W₀) = den0_W₀ := by
          apply Subtype.ext
          exact (pow_zero W₀).symm
        change Localization.mk (MvPolynomial.C c) 1 = _
        rw [h1]
      rw [hval, Localization.awayLift_mk ev₀ W₀ (MvPolynomial.C c) 1 hv₀ 0,
        pow_zero, mul_one, MvPolynomial.eval₂Hom_C]
    have hφ₁_c : ∀ c : R₀,
        φ₁ ((HomogeneousLocalization.fromZeroRingHom 𝒜_R₀ (Submonoid.powers W₁)).comp
          (algebraMap R₀ ↥(𝒜_R₀ 0)) c) = rU₁ c := by
      intro c
      let zc := (HomogeneousLocalization.fromZeroRingHom 𝒜_R₀ (Submonoid.powers W₁)).comp
        (algebraMap R₀ ↥(𝒜_R₀ 0)) c
      change (Localization.awayLift ev₁ W₁ (IsUnit.of_mul_eq_one 1 hv₁)) zc.val = rU₁ c
      let den0_W₁ : Submonoid.powers W₁ :=
        ⟨W₁ ^ 0, pow_mem (Submonoid.mem_powers W₁) 0⟩
      have hval : zc.val = Localization.mk (MvPolynomial.C c) den0_W₁ := by
        have h1 : (1 : Submonoid.powers W₁) = den0_W₁ := by
          apply Subtype.ext
          exact (pow_zero W₁).symm
        change Localization.mk (MvPolynomial.C c) 1 = _
        rw [h1]
      rw [hval, Localization.awayLift_mk ev₁ W₁ (MvPolynomial.C c) 1 hv₁ 0,
        pow_zero, mul_one, MvPolynomial.eval₂Hom_C]

    have hφ₀_t : φ₀ tElem = u' := by
      dsimp [tElem, HomogeneousLocalization.Away.isLocalizationElem]
      rw [hφ₀_mk, pow_one]
      dsimp [ev₀, W₁, A_R₀]
      rw [MvPolynomial.eval₂_X]
      simp
    have hφ₁_t : φ₁ (HomogeneousLocalization.Away.isLocalizationElem hW₁ hW₀) = v' := by
      dsimp [HomogeneousLocalization.Away.isLocalizationElem]
      rw [hφ₁_mk, pow_one]
      dsimp [ev₁, W₀, A_R₀]
      rw [MvPolynomial.eval₂_X]
      simp

    
    let ι₀ : HomogeneousLocalization.Away 𝒜_R₀ W₀ →+*
        HomogeneousLocalization.Away 𝒜_R₀ (W₀ * W₁) :=
      HomogeneousLocalization.awayMap 𝒜_R₀ hW₁ (rfl : W₀ * W₁ = W₀ * W₁)
    let ι₁ := HomogeneousLocalization.awayMap 𝒜_R₀ hW₀ (mul_comm W₀ W₁)
    have hResEv₀ : resU₀.comp ev₀ = ev₀₁ := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply]
        dsimp [ev₀, ev₀₁]
        rw [MvPolynomial.eval₂_C, MvPolynomial.eval₂_C]
        exact congrArg (fun f => f c) hr₀_comp
      · intro i
        fin_cases i
        · simp only [RingHom.comp_apply]
          dsimp [ev₀, ev₀₁]
          rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
          simp
        · simp only [RingHom.comp_apply]
          dsimp [ev₀, ev₀₁]
          rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
          simp
    have hOv₀ : φ₀₁.comp ι₀ = resU₀.comp φ₀ := by
      ext z₀
      obtain ⟨j, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_R₀ hW₀ z₀
      simp only [RingHom.comp_apply]
      rw [hφ₀_mk]
      dsimp [ι₀]
      rw [HomogeneousLocalization.awayMap_mk, hφ₀₁_mk]
      have hW₁_ev : ev₀₁ (a * W₁ ^ j) = ev₀₁ a * (resU₀ u') ^ j := by
        rw [map_mul, map_pow]
        have hw1 : ev₀₁ W₁ = resU₀ u' := by
          dsimp [ev₀₁, W₁, A_R₀]
          rw [MvPolynomial.eval₂_X]
          simp
        rw [hw1]
      have ha_ev : ev₀₁ a = resU₀ (ev₀ a) := by
        rw [← hResEv₀]
        rfl
      calc
        ev₀₁ (a * W₁ ^ j) * (resU₁ v') ^ j
          = ev₀₁ a * ((resU₀ u') ^ j * (resU₁ v') ^ j) := by rw [hW₁_ev, mul_assoc]
        _ = ev₀₁ a * (resU₀ u' * resU₁ v') ^ j := by rw [← mul_pow]
        _ = ev₀₁ a := by rw [huv', one_pow, mul_one]
        _ = resU₀ (ev₀ a) := ha_ev
    have hOv₁ : φ₀₁.comp ι₁ = resU₁.comp φ₁ := by
      ext z₁
      obtain ⟨j, a, ha_smul, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_R₀ hW₁ z₁
      have ha : a ∈ 𝒜_R₀ j := by simpa [smul_eq_mul, mul_one] using ha_smul
      simp only [RingHom.comp_apply]
      rw [hφ₁_mk]
      dsimp [ι₁]
      rw [HomogeneousLocalization.awayMap_mk, hφ₀₁_mk]
      have hW₀_ev : ev₀₁ (a * W₀ ^ j) = ev₀₁ a := by
        rw [map_mul, map_pow]
        have hw0 : ev₀₁ W₀ = 1 := by
          dsimp [ev₀₁, W₀, A_R₀]
          rw [MvPolynomial.eval₂_X]
          simp
        rw [hw0, one_pow, mul_one]
      rw [hW₀_ev]
      conv_lhs => rw [MvPolynomial.as_sum a]
      conv_rhs => rw [MvPolynomial.as_sum a]
      rw [map_sum, Finset.sum_mul, map_sum, map_sum]
      refine Finset.sum_congr rfl ?_
      intro d hd
      have hdj : d 0 + d 1 = j := hDegTwo ha hd
      let c := a.coeff d
      rw [hMonomialTwo d c]
      have hlhs : ev₀₁ (MvPolynomial.C c * W₀ ^ (d 0) * W₁ ^ (d 1)) =
          rU₀₁ c * (resU₀ u') ^ (d 1) := by
        rw [map_mul, map_mul, map_pow, map_pow]
        dsimp [ev₀₁, W₀, W₁, A_R₀]
        rw [MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
        simp
      have hrhs : resU₁ (ev₁ (MvPolynomial.C c * W₀ ^ (d 0) * W₁ ^ (d 1))) =
          rU₀₁ c * (resU₁ v') ^ (d 0) := by
        have h1 : ev₁ (MvPolynomial.C c * W₀ ^ (d 0) * W₁ ^ (d 1)) = rU₁ c * v' ^ (d 0) := by
          rw [map_mul, map_mul, map_pow, map_pow]
          dsimp [ev₁, W₀, W₁, A_R₀]
          rw [MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
          simp
        rw [h1, map_mul, map_pow]
        have hc : resU₁ (rU₁ c) = rU₀₁ c := congrArg (fun f => f c) hr₁_comp
        rw [hc]
      rw [hlhs, hrhs, ← hdj, pow_add]
      calc
        rU₀₁ c * (resU₀ u') ^ (d 1) * ((resU₁ v') ^ (d 0) * (resU₁ v') ^ (d 1))
          = rU₀₁ c * (resU₁ v') ^ (d 0) * ((resU₀ u') ^ (d 1) * (resU₁ v') ^ (d 1)) := by ring
        _ = rU₀₁ c * (resU₁ v') ^ (d 0) * (resU₀ u' * resU₁ v') ^ (d 1) := by rw [← mul_pow]
        _ = rU₀₁ c * (resU₁ v') ^ (d 0) := by rw [huv', one_pow, mul_one]

    
    let P1 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_R₀
    let α₀ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_R₀ W₀)) ⟶ P1 :=
      AlgebraicGeometry.Proj.awayι 𝒜_R₀ W₀ hW₀ zero_lt_one
    let α₁ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_R₀ W₁)) ⟶ P1 :=
      AlgebraicGeometry.Proj.awayι 𝒜_R₀ W₁ hW₁ zero_lt_one
    have hSpecOv :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resU₀.comp φ₀)) ≫ α₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resU₁.comp φ₁)) ≫ α₁ := by
      have hα₀₁ :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) ≫ α₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁) ≫ α₁ :=
        (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_R₀ hW₀ zero_lt_one hW₁ rfl).trans
          (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_R₀ hW₁ zero_lt_one hW₀
            (mul_comm W₀ W₁)).symm
      rw [← hOv₀, ← hOv₁, CommRingCat.ofHom_comp ι₀ φ₀₁, CommRingCat.ofHom_comp ι₁ φ₀₁,
        AlgebraicGeometry.Spec.map_comp_assoc, AlgebraicGeometry.Spec.map_comp_assoc, hα₀₁]

    let covObj : Bool → AlgebraicGeometry.Scheme.{u} := fun b =>
      Bool.rec (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U₀)))
        (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U₁))) b
    let covMap : ∀ b : Bool, covObj b ⟶ Y := fun b =>
      Bool.rec hU₀.fromSpec hU₁.fromSpec b
    have hCovSurj : ∀ y : Y, ∃ (b : Bool) (q : covObj b), (covMap b).base q = y := by
      intro y
      have hyTop : y ∈ (⊤ : Y.Opens) := trivial
      rw [← hCovU] at hyTop
      rcases hyTop with hy₀ | hy₁
      · have hRange₀ : y ∈ hU₀.fromSpec.opensRange := by
          rwa [hU₀.opensRange_fromSpec]
        obtain ⟨q, hq⟩ := hRange₀
        exact ⟨false, q, hq⟩
      · have hRange₁ : y ∈ hU₁.fromSpec.opensRange := by
          rwa [hU₁.opensRange_fromSpec]
        obtain ⟨q, hq⟩ := hRange₁
        exact ⟨true, q, hq⟩
    have hCovImm : ∀ b : Bool, AlgebraicGeometry.IsOpenImmersion (covMap b) := by
      intro b
      cases b <;> dsimp [covMap] <;> infer_instance
    let 𝒰 : AlgebraicGeometry.Scheme.OpenCover Y :=
      AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := AlgebraicGeometry.IsOpenImmersion)
        Bool covObj covMap hCovSurj hCovImm
    let gChart : ∀ b : 𝒰.I₀, 𝒰.X b ⟶ P1 := fun b =>
      Bool.rec (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁) b

    have hGlue01 :
        CategoryTheory.Limits.pullback.fst hU₀.fromSpec hU₁.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀) =
          CategoryTheory.Limits.pullback.snd hU₀.fromSpec hU₁.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁) := by
      let fst₀₁ := CategoryTheory.Limits.pullback.fst hU₀.fromSpec hU₁.fromSpec
      let snd₀₁ := CategoryTheory.Limits.pullback.snd hU₀.fromSpec hU₁.fromSpec
      change fst₀₁ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀) =
        snd₀₁ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁)
      haveI : AlgebraicGeometry.IsOpenImmersion (fst₀₁ ≫ hU₀.fromSpec) :=
        CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
      have hRangeEq : Set.range ⇑(fst₀₁ ≫ hU₀.fromSpec) = Set.range ⇑hU₀₁.fromSpec := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_fst_comp]
        have hr₀ : Set.range ⇑hU₀.fromSpec = (U₀ : Set Y) :=
          congrArg SetLike.coe hU₀.opensRange_fromSpec
        have hr₁ : Set.range ⇑hU₁.fromSpec = (U₁ : Set Y) :=
          congrArg SetLike.coe hU₁.opensRange_fromSpec
        have hr₀₁ : Set.range ⇑hU₀₁.fromSpec = ((U₀ ⊓ U₁ : Y.Opens) : Set Y) :=
          congrArg SetLike.coe hU₀₁.opensRange_fromSpec
        rw [hr₀, hr₁, hr₀₁]
        rfl
      let isoOv := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
        (fst₀₁ ≫ hU₀.fromSpec) hU₀₁.fromSpec hRangeEq
      have hFst : isoOv.inv ≫ fst₀₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom resU₀) := by
        rw [← CategoryTheory.cancel_mono hU₀.fromSpec, CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac]
        exact (hU₀.map_fromSpec hU₀₁ (CategoryTheory.homOfLE inf_le_left).op).symm
      have hSnd : isoOv.inv ≫ snd₀₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom resU₁) := by
        rw [← CategoryTheory.cancel_mono hU₁.fromSpec, CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc isoOv.inv fst₀₁ hU₀.fromSpec,
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac]
        exact (hU₁.map_fromSpec hU₀₁ (CategoryTheory.homOfLE inf_le_right).op).symm
      rw [← CategoryTheory.cancel_epi isoOv.inv]
      calc
        isoOv.inv ≫ fst₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀
          = (isoOv.inv ≫ fst₀₁) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀ := by
              simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resU₀.comp φ₀)) ≫ α₀ := by
              rw [hFst, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resU₁.comp φ₁)) ≫ α₁ := hSpecOv
        _ = (isoOv.inv ≫ snd₀₁) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁ := by
              rw [hSnd, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp]
        _ = isoOv.inv ≫ snd₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁ := by
              simp only [CategoryTheory.Category.assoc]

    have hGlueCond : ∀ (b₁ b₂ : 𝒰.I₀),
        CategoryTheory.Limits.pullback.fst (𝒰.f b₁) (𝒰.f b₂) ≫ gChart b₁ =
          CategoryTheory.Limits.pullback.snd (𝒰.f b₁) (𝒰.f b₂) ≫ gChart b₂ := by
      intro b₁ b₂
      cases b₁ <;> cases b₂
      · change CategoryTheory.Limits.pullback.fst hU₀.fromSpec hU₀.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀) =
          CategoryTheory.Limits.pullback.snd hU₀.fromSpec hU₀.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀)
        have hEq : CategoryTheory.Limits.pullback.fst hU₀.fromSpec hU₀.fromSpec =
            CategoryTheory.Limits.pullback.snd hU₀.fromSpec hU₀.fromSpec := by
          rw [← CategoryTheory.cancel_mono hU₀.fromSpec]
          exact CategoryTheory.Limits.pullback.condition
        rw [hEq]
      · exact hGlue01
      · change CategoryTheory.Limits.pullback.fst hU₁.fromSpec hU₀.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁) =
          CategoryTheory.Limits.pullback.snd hU₁.fromSpec hU₀.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀)
        rw [← CategoryTheory.cancel_epi
          (CategoryTheory.Limits.pullbackSymmetry hU₀.fromSpec hU₁.fromSpec).hom]
        rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst_assoc,
          CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd_assoc]
        exact hGlue01.symm
      · change CategoryTheory.Limits.pullback.fst hU₁.fromSpec hU₁.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁) =
          CategoryTheory.Limits.pullback.snd hU₁.fromSpec hU₁.fromSpec ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁)
        have hEq : CategoryTheory.Limits.pullback.fst hU₁.fromSpec hU₁.fromSpec =
            CategoryTheory.Limits.pullback.snd hU₁.fromSpec hU₁.fromSpec := by
          rw [← CategoryTheory.cancel_mono hU₁.fromSpec]
          exact CategoryTheory.Limits.pullback.condition
        rw [hEq]

    let π_R₀ : Y ⟶ P1 := 𝒰.glueMorphisms gChart hGlueCond
    have hπ₀ : hU₀.fromSpec ≫ π_R₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ α₀ :=
      𝒰.ι_glueMorphisms gChart hGlueCond (false : 𝒰.I₀)
    have hπ₁ : hU₁.fromSpec ≫ π_R₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ α₁ :=
      𝒰.ι_glueMorphisms gChart hGlueCond (true : 𝒰.I₀)
    let q_R₀ : P1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜_R₀ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ ↥(𝒜_R₀ 0)))

    have hCompP : π_R₀ ≫ q_R₀ = p := by
      apply 𝒰.hom_ext
      intro b
      have hp_eq : p = Y.toSpecΓ ≫ AlgebraicGeometry.Spec.map p.appTop ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv := by
        calc
          p = p ≫ 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R₀)) :=
              (CategoryTheory.Category.comp_id p).symm
          _ = p ≫ (AlgebraicGeometry.Spec (CommRingCat.of R₀)).toSpecΓ ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv := by
              rw [AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv]
          _ = Y.toSpecΓ ≫ AlgebraicGeometry.Spec.map p.appTop ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv := by
              rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc]
      cases b
      · change (hU₀.fromSpec ≫ π_R₀) ≫ q_R₀ = hU₀.fromSpec ≫ p
        rw [hπ₀]
        dsimp [q_R₀, α₀]
        rw [CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜_R₀ W₀ hW₀ zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        rw [hp_eq, ← CategoryTheory.Category.assoc, hU₀.fromSpec_toSpecΓ,
          CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext c
        exact hφ₀_c c
      · change (hU₁.fromSpec ≫ π_R₀) ≫ q_R₀ = hU₁.fromSpec ≫ p
        rw [hπ₁]
        dsimp [q_R₀, α₁]
        rw [CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜_R₀ W₁ hW₁ zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        rw [hp_eq, ← CategoryTheory.Category.assoc, hU₁.fromSpec_toSpecΓ,
          CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext c
        exact hφ₁_c c

    haveI hSepProj : AlgebraicGeometry.IsSeparated (AlgebraicGeometry.Proj.toSpecZero 𝒜_R₀) :=
      AlgebraicGeometry.Proj.isSeparated 𝒜_R₀
    haveI hSepQ : AlgebraicGeometry.IsSeparated q_R₀ :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ hSepProj inferInstance
    haveI hPropComp : AlgebraicGeometry.IsProper (π_R₀ ≫ q_R₀) := by
      rw [hCompP]
      infer_instance
    haveI hPropπ : AlgebraicGeometry.IsProper π_R₀ :=
      AlgebraicGeometry.IsProper.of_comp π_R₀ q_R₀

    let DW₀ : P1.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_R₀ W₀
    let DW₁ : P1.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_R₀ W₁

    have hPreDW₀ : (TopologicalSpace.Opens.map π_R₀.base).obj DW₀ = U₀ := by
      ext y
      constructor
      · intro hy
        have hyTop : y ∈ (⊤ : Y.Opens) := trivial
        rw [← hCovU] at hyTop
        rcases hyTop with hy₀ | hy₁
        · exact hy₀
        · have hRange₁ : y ∈ hU₁.fromSpec.opensRange := by rwa [hU₁.opensRange_fromSpec]
          obtain ⟨q₁, rfl⟩ := hRange₁
          have hq₁ : q₁ ∈ (TopologicalSpace.Opens.map (hU₁.fromSpec ≫ π_R₀).base).obj DW₀ := hy
          rw [hπ₁] at hq₁
          dsimp [α₁] at hq₁
          rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_R₀ hW₁ zero_lt_one hW₀ zero_lt_one,
            AlgebraicGeometry.SpecMap_preimage_basicOpen] at hq₁
          change q₁ ∈ PrimeSpectrum.basicOpen (φ₁ _) at hq₁
          rw [hφ₁_t, ← hU₁.fromSpec_preimage_basicOpen v'] at hq₁
          have hyBasic : hU₁.fromSpec.base q₁ ∈ Y.basicOpen v' := hq₁
          rw [hv'] at hyBasic
          exact hyBasic.1
      · intro hy₀
        have hRange₀ : y ∈ hU₀.fromSpec.opensRange := by rwa [hU₀.opensRange_fromSpec]
        obtain ⟨q₀, rfl⟩ := hRange₀
        change (hU₀.fromSpec ≫ π_R₀).base q₀ ∈ DW₀
        rw [hπ₀]
        dsimp [α₀]
        have hInRange : (AlgebraicGeometry.Proj.awayι 𝒜_R₀ W₀ hW₀ zero_lt_one).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).base q₀) ∈
            (AlgebraicGeometry.Proj.awayι 𝒜_R₀ W₀ hW₀ zero_lt_one).opensRange :=
          ⟨_, rfl⟩
        rwa [AlgebraicGeometry.Proj.opensRange_awayι 𝒜_R₀ W₀ hW₀ zero_lt_one] at hInRange

    have hPreDW₁ : (TopologicalSpace.Opens.map π_R₀.base).obj DW₁ = U₁ := by
      ext y
      constructor
      · intro hy
        have hyTop : y ∈ (⊤ : Y.Opens) := trivial
        rw [← hCovU] at hyTop
        rcases hyTop with hy₀ | hy₁
        · have hRange₀ : y ∈ hU₀.fromSpec.opensRange := by rwa [hU₀.opensRange_fromSpec]
          obtain ⟨q₀, rfl⟩ := hRange₀
          have hq₀ : q₀ ∈ (TopologicalSpace.Opens.map (hU₀.fromSpec ≫ π_R₀).base).obj DW₁ := hy
          rw [hπ₀] at hq₀
          dsimp [α₀] at hq₀
          rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_R₀ hW₀ zero_lt_one hW₁ zero_lt_one,
            AlgebraicGeometry.SpecMap_preimage_basicOpen] at hq₀
          change q₀ ∈ PrimeSpectrum.basicOpen (φ₀ _) at hq₀
          rw [hφ₀_t, ← hU₀.fromSpec_preimage_basicOpen u'] at hq₀
          have hyBasic : hU₀.fromSpec.base q₀ ∈ Y.basicOpen u' := hq₀
          rw [hu'] at hyBasic
          exact hyBasic.2
        · exact hy₁
      · intro hy₁
        have hRange₁ : y ∈ hU₁.fromSpec.opensRange := by rwa [hU₁.opensRange_fromSpec]
        obtain ⟨q₁, rfl⟩ := hRange₁
        change (hU₁.fromSpec ≫ π_R₀).base q₁ ∈ DW₁
        rw [hπ₁]
        dsimp [α₁]
        have hInRange : (AlgebraicGeometry.Proj.awayι 𝒜_R₀ W₁ hW₁ zero_lt_one).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)).base q₁) ∈
            (AlgebraicGeometry.Proj.awayι 𝒜_R₀ W₁ hW₁ zero_lt_one).opensRange :=
          ⟨_, rfl⟩
        rwa [AlgebraicGeometry.Proj.opensRange_awayι 𝒜_R₀ W₁ hW₁ zero_lt_one] at hInRange

    have hCovP1 : (⨆ i : Fin 2, AlgebraicGeometry.Proj.basicOpen 𝒜_R₀ (MvPolynomial.X i)) = ⊤ := by
      apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_R₀ MvPolynomial.X
      intro f hf
      have hf0 : GradedRing.proj 𝒜_R₀ 0 f = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_R₀ f).mp hf
      classical
      rw [← DirectSum.sum_support_decompose 𝒜_R₀ f]
      refine Submodule.sum_mem _ ?_
      intro i _hi
      by_cases hi0 : i = 0
      · subst hi0
        have hz : ((DirectSum.decompose 𝒜_R₀ f 0 : 𝒜_R₀ 0) : A_R₀) = 0 := hf0
        rw [hz]
        exact Submodule.zero_mem _
      · let fi : A_R₀ := (DirectSum.decompose 𝒜_R₀ f i : 𝒜_R₀ i)
        have hfi : fi ∈ 𝒜_R₀ i := (DirectSum.decompose 𝒜_R₀ f i).2
        rw [← Set.image_univ]
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro d hd
        have hdi : d 0 + d 1 = i := hDegTwo hfi hd
        by_cases hd0 : d 0 = 0
        · refine ⟨1, trivial, ?_⟩
          omega
        · exact ⟨0, trivial, hd0⟩

    haveI hAffπ : AlgebraicGeometry.IsAffineHom π_R₀ := by
      apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
      intro z
      have hz : z ∈ (⊤ : P1.Opens) := trivial
      rw [← hCovP1, TopologicalSpace.Opens.mem_iSup] at hz
      obtain ⟨i, hzi⟩ := hz
      fin_cases i
      · refine ⟨DW₀, hzi, AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_R₀ W₀ hW₀ zero_lt_one, ?_⟩
        rw [hPreDW₀]
        exact hU₀
      · refine ⟨DW₁, hzi, AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_R₀ W₁ hW₁ zero_lt_one, ?_⟩
        rw [hPreDW₁]
        exact hU₁

    haveI hFinπ : AlgebraicGeometry.IsFinite π_R₀ :=
      AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hPropπ, hAffπ⟩

    have hRangePb :
        Set.range ⇑(CategoryTheory.Limits.pullback.fst π_R₀ α₀) = Set.range ⇑hU₀.fromSpec := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
      have hrα₀ : Set.range ⇑α₀ = (DW₀ : Set P1) :=
        congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜_R₀ W₀ hW₀ zero_lt_one)
      have hrU₀ : Set.range ⇑hU₀.fromSpec = (U₀ : Set Y) :=
        congrArg SetLike.coe hU₀.opensRange_fromSpec
      rw [hrα₀, hrU₀, ← hPreDW₀]
      rfl

    let isoPb := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
      (CategoryTheory.Limits.pullback.fst π_R₀ α₀) hU₀.fromSpec hRangePb
    have hSpecφ₀ :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) =
          isoPb.inv ≫ CategoryTheory.Limits.pullback.snd π_R₀ α₀ := by
      rw [← CategoryTheory.cancel_mono α₀, CategoryTheory.Category.assoc,
        ← CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac]
      exact hπ₀.symm

    haveI hFinSpecφ₀ : AlgebraicGeometry.IsFinite
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) := by
      rw [hSpecφ₀]
      exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance

    have hFinφ₀ : φ₀.Finite :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom φ₀)).mp hFinSpecφ₀

    exact ⟨φ₀, hFinφ₀, hφ₀_c, hφ₀_t⟩

  
  
  
  obtain ⟨φ₀, hFinφ₀, hφ₀_c, hφ₀_t⟩ :=
    hAwayChartFinite V₀ V₁ hAff₀ hAff₁ hAff₀₁ hCovY u v hu hv huv
  have hEval₀ : Polynomial.eval₂RingHom r₀ u = φ₀.comp toAway := by
    apply Polynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      dsimp [toAway]
      rw [Polynomial.eval₂_C, hφ₀_c]
    · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      dsimp [toAway]
      rw [Polynomial.eval₂_X, hφ₀_t]
  have hFin₀ : (Polynomial.eval₂RingHom r₀ u).Finite := by
    rw [hEval₀]
    exact RingHom.Finite.comp hFinφ₀ hFinToAway

  have hAff₁₀ : AlgebraicGeometry.IsAffineOpen (V₁ ⊓ V₀) := by
    rw [inf_comm]
    exact hAff₀₁
  have hCovY₁₀ : V₁ ⊔ V₀ = ⊤ := by
    rw [sup_comm]
    exact hCovY
  have hv₁₀ : Y.basicOpen v = V₁ ⊓ V₀ := by
    rw [inf_comm]
    exact hv
  have hu₁₀ : Y.basicOpen u = V₁ ⊓ V₀ := by
    rw [inf_comm]
    exact hu
  have hvu₁₀ :
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₀ ≤ V₁)).op).hom v *
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₁ ⊓ V₀ ≤ V₀)).op).hom u = 1 := by
    let ψ_swap := (Y.presheaf.map (CategoryTheory.homOfLE (inf_comm V₁ V₀).le).op).hom
    have h1 : ψ_swap (res₁ v) =
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₀ ≤ V₁)).op).hom v := by
      change (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE (inf_comm V₁ V₀).le).op).hom v = _
      rw [← Y.presheaf.map_comp]
      rfl
    have h2 : ψ_swap (res₀ u) =
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₁ ⊓ V₀ ≤ V₀)).op).hom u := by
      change (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE (inf_comm V₁ V₀).le).op).hom u = _
      rw [← Y.presheaf.map_comp]
      rfl
    rw [← h1, ← h2, ← map_mul, mul_comm, huv, map_one]

  obtain ⟨φ₁, hFinφ₁, hφ₁_c, hφ₁_t⟩ :=
    hAwayChartFinite V₁ V₀ hAff₁ hAff₀ hAff₁₀ hCovY₁₀ v u hv₁₀ hu₁₀ hvu₁₀
  have hEval₁ : Polynomial.eval₂RingHom r₁ v = φ₁.comp toAway := by
    apply Polynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      dsimp [toAway]
      rw [Polynomial.eval₂_C, hφ₁_c]
    · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      dsimp [toAway]
      rw [Polynomial.eval₂_X, hφ₁_t]
  have hFin₁ : (Polynomial.eval₂RingHom r₁ v).Finite := by
    rw [hEval₁]
    exact RingHom.Finite.comp hFinφ₁ hFinToAway

  exact ⟨u, v, huv, hFin₀, hFin₁, hLoc₀, hLoc₁⟩

theorem weil_integrallyClosed_domain_birational_two_chart_surjective (R₀ D B₀ B₁ B₀₁ : Type u)
    [CommRing R₀] [IsDomain R₀] [IsIntegrallyClosed R₀]
    [CommRing D] [IsDomain D]
    [CommRing B₀] [CommRing B₁] [CommRing B₀₁] [IsDomain B₀₁]
    (φ : R₀ →+* D)
    (hInjφ : Function.Injective φ)
    (r_gen : R₀)
    (hr_ne : r_gen ≠ 0)
    (hFrac : ∀ s : D, ∃ (m : ℕ) (a : R₀), (φ r_gen) ^ m * s = φ a)
    (f₀ : D →+* B₀)
    (f₁ : D →+* B₁)
    (res₀ : B₀ →+* B₀₁)
    (res₁ : B₁ →+* B₀₁)
    (hComm : res₀.comp f₀ = res₁.comp f₁)
    (hInj01 : Function.Injective (res₀.comp f₀))
    (u : B₀)
    (v : B₁)
    (huv : res₀ u * res₁ v = 1)
    (hFin₀ : (Polynomial.eval₂RingHom (f₀.comp φ) u).Finite)
    (hFin₁ : (Polynomial.eval₂RingHom (f₁.comp φ) v).Finite) :
    Function.Surjective φ :=
by
  intro s
  let r₀ : R₀ →+* B₀ := f₀.comp φ
  let r₁ : R₀ →+* B₁ := f₁.comp φ
  let r₀₁ : R₀ →+* B₀₁ := (res₀.comp f₀).comp φ
  let s₀₁ : B₀₁ := (res₀.comp f₀) s
  let u₀₁ : B₀₁ := res₀ u
  let v₀₁ : B₀₁ := res₁ v
  let θ₀ : Polynomial R₀ →+* B₀₁ := Polynomial.eval₂RingHom r₀₁ u₀₁
  let θ₁ : Polynomial R₀ →+* B₀₁ := Polynomial.eval₂RingHom r₀₁ v₀₁
  have hr₁ : res₁.comp r₁ = r₀₁ := by
    ext x
    change (res₁.comp f₁) (φ x) = (res₀.comp f₀) (φ x)
    rw [hComm]
  have hs₀ : res₀ (f₀ s) = s₀₁ := rfl
  have hs₁ : res₁ (f₁ s) = s₀₁ := by
    change (res₁.comp f₁) s = (res₀.comp f₀) s
    rw [hComm]
  have hθ₀ : res₀.comp (Polynomial.eval₂RingHom r₀ u) = θ₀ := by
    apply Polynomial.ringHom_ext
    · intro r
      change res₀ (Polynomial.eval₂ r₀ u (Polynomial.C r)) = Polynomial.eval₂ r₀₁ u₀₁ (Polynomial.C r)
      rw [Polynomial.eval₂_C, Polynomial.eval₂_C]
      rfl
    · change res₀ (Polynomial.eval₂ r₀ u Polynomial.X) = Polynomial.eval₂ r₀₁ u₀₁ Polynomial.X
      rw [Polynomial.eval₂_X, Polynomial.eval₂_X]
  have hθ₁ : res₁.comp (Polynomial.eval₂RingHom r₁ v) = θ₁ := by
    apply Polynomial.ringHom_ext
    · intro r
      change res₁ (Polynomial.eval₂ r₁ v (Polynomial.C r)) = Polynomial.eval₂ r₀₁ v₀₁ (Polynomial.C r)
      rw [Polynomial.eval₂_C, Polynomial.eval₂_C]
      exact congrArg (fun f => f r) hr₁
    · change res₁ (Polynomial.eval₂ r₁ v Polynomial.X) = Polynomial.eval₂ r₀₁ v₀₁ Polynomial.X
      rw [Polynomial.eval₂_X, Polynomial.eval₂_X]
  obtain ⟨P₀, hP₀_monic, hP₀_eval⟩ := hFin₀.to_isIntegral (f₀ s)
  have hP₀_01 : Polynomial.eval₂ θ₀ s₀₁ P₀ = 0 := by
    have h := congrArg res₀ hP₀_eval
    rw [map_zero] at h
    change res₀ (Polynomial.eval₂ (Polynomial.eval₂RingHom r₀ u) (f₀ s) P₀) = 0 at h
    rw [Polynomial.hom_eval₂, hθ₀, hs₀] at h
    exact h
  obtain ⟨P₁, hP₁_monic, hP₁_eval⟩ := hFin₁.to_isIntegral (f₁ s)
  have hP₁_01 : Polynomial.eval₂ θ₁ s₀₁ P₁ = 0 := by
    have h := congrArg res₁ hP₁_eval
    rw [map_zero] at h
    change res₁ (Polynomial.eval₂ (Polynomial.eval₂RingHom r₁ v) (f₁ s) P₁) = 0 at h
    rw [Polynomial.hom_eval₂, hθ₁, hs₁] at h
    exact h
  let p : ℕ := P₀.natDegree
  let q : ℕ := P₁.natDegree
  have hp_pos : 1 ≤ p := by
    refine Nat.one_le_iff_ne_zero.mpr fun hp0 => ?_
    have hP₀1 : P₀ = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP₀_monic hp0
    rw [hP₀1, Polynomial.eval₂_one] at hP₀_01
    exact one_ne_zero hP₀_01
  have hq_pos : 1 ≤ q := by
    refine Nat.one_le_iff_ne_zero.mpr fun hq0 => ?_
    have hP₁1 : P₁ = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP₁_monic hq0
    rw [hP₁1, Polynomial.eval₂_one] at hP₁_01
    exact one_ne_zero hP₁_01
  let d : ℕ := (Finset.range p).sup (fun i => (P₀.coeff i).natDegree)
  let c₀ : ℕ → Polynomial R₀ := fun i => - P₀.coeff i
  have h_sp : s₀₁ ^ p = ∑ i ∈ Finset.range p, ∑ a ∈ Finset.range (d + 1),
      r₀₁ ((c₀ i).coeff a) * (s₀₁ ^ i * u₀₁ ^ a) := by
    have hsum := hP₀_01
    rw [Polynomial.eval₂_eq_sum_range, show P₀.natDegree = p from rfl,
      Finset.sum_range_succ, hP₀_monic.coeff_natDegree, map_one, one_mul] at hsum
    have hsp1 : s₀₁ ^ p = ∑ i ∈ Finset.range p, θ₀ (c₀ i) * s₀₁ ^ i := by
      have hneg : s₀₁ ^ p = - ∑ i ∈ Finset.range p, θ₀ (P₀.coeff i) * s₀₁ ^ i := by
        calc s₀₁ ^ p = (∑ i ∈ Finset.range p, θ₀ (P₀.coeff i) * s₀₁ ^ i + s₀₁ ^ p) -
            ∑ i ∈ Finset.range p, θ₀ (P₀.coeff i) * s₀₁ ^ i := by ring
          _ = 0 - ∑ i ∈ Finset.range p, θ₀ (P₀.coeff i) * s₀₁ ^ i := by rw [hsum]
          _ = - ∑ i ∈ Finset.range p, θ₀ (P₀.coeff i) * s₀₁ ^ i := by ring
      rw [hneg, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      dsimp [c₀]
      rw [map_neg, neg_mul]
    rw [hsp1]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hdeg : (c₀ i).natDegree < d + 1 := by
      dsimp [c₀]
      rw [Polynomial.natDegree_neg]
      exact Nat.lt_succ_of_le (Finset.le_sup (f := fun k => (P₀.coeff k).natDegree) hi)
    change Polynomial.eval₂ r₀₁ u₀₁ (c₀ i) * s₀₁ ^ i = _
    rw [Polynomial.eval₂_eq_sum_range' r₀₁ hdeg u₀₁, Finset.sum_mul]
    refine Finset.sum_congr rfl fun a _ => ?_
    ring
  let e : ℕ := (Finset.range q).sup (fun j => (P₁.coeff j).natDegree)
  let c₁ : ℕ → Polynomial R₀ := fun j => - P₁.coeff j
  have h_sq : s₀₁ ^ q = ∑ j ∈ Finset.range q, ∑ b ∈ Finset.range (e + 1),
      r₀₁ ((c₁ j).coeff b) * (s₀₁ ^ j * v₀₁ ^ b) := by
    have hsum := hP₁_01
    rw [Polynomial.eval₂_eq_sum_range, show P₁.natDegree = q from rfl,
      Finset.sum_range_succ, hP₁_monic.coeff_natDegree, map_one, one_mul] at hsum
    have hsq1 : s₀₁ ^ q = ∑ j ∈ Finset.range q, θ₁ (c₁ j) * s₀₁ ^ j := by
      have hneg : s₀₁ ^ q = - ∑ j ∈ Finset.range q, θ₁ (P₁.coeff j) * s₀₁ ^ j := by
        calc s₀₁ ^ q = (∑ j ∈ Finset.range q, θ₁ (P₁.coeff j) * s₀₁ ^ j + s₀₁ ^ q) -
            ∑ j ∈ Finset.range q, θ₁ (P₁.coeff j) * s₀₁ ^ j := by ring
          _ = 0 - ∑ j ∈ Finset.range q, θ₁ (P₁.coeff j) * s₀₁ ^ j := by rw [hsum]
          _ = - ∑ j ∈ Finset.range q, θ₁ (P₁.coeff j) * s₀₁ ^ j := by ring
      rw [hneg, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      dsimp [c₁]
      rw [map_neg, neg_mul]
    rw [hsq1]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hdeg : (c₁ j).natDegree < e + 1 := by
      dsimp [c₁]
      rw [Polynomial.natDegree_neg]
      exact Nat.lt_succ_of_le (Finset.le_sup (f := fun k => (P₁.coeff k).natDegree) hj)
    change Polynomial.eval₂ r₀₁ v₀₁ (c₁ j) * s₀₁ ^ j = _
    rw [Polynomial.eval₂_eq_sum_range' r₀₁ hdeg v₀₁, Finset.sum_mul]
    refine Finset.sum_congr rfl fun b _ => ?_
    ring
  letI : Algebra R₀ B₀₁ := r₀₁.toAlgebra
  have hsmul_r₀₁ : ∀ (r : R₀) (z : B₀₁), r • z = r₀₁ r * z := by
    intro r z
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  let I_box : Finset (ℕ × ℕ) := Finset.range (p + q) ×ˢ Finset.range (e + d + 1)
  let S_box : Set B₀₁ := (fun x : ℕ × ℕ => s₀₁ ^ x.1 * u₀₁ ^ x.2) '' (I_box : Set (ℕ × ℕ))
  let N : Submodule R₀ B₀₁ := Submodule.span R₀ S_box
  have hBox_mem : ∀ (i m : ℕ), i < p + q → m < e + d + 1 → s₀₁ ^ i * u₀₁ ^ m ∈ N := by
    intro i m hi hm
    apply Submodule.subset_span
    refine ⟨(i, m), ?_, rfl⟩
    rw [Finset.mem_coe, Finset.mem_product, Finset.mem_range, Finset.mem_range]
    exact ⟨hi, hm⟩
  have hN_fg : N.FG := Submodule.fg_span ((Finset.finite_toSet I_box).image _)
  have hN_ne_bot : N ≠ ⊥ := by
    rw [Submodule.ne_bot_iff]
    refine ⟨1, ?_, one_ne_zero⟩
    have h00 := hBox_mem 0 0 (by omega) (by omega)
    simpa only [pow_zero, one_mul] using h00
  have hN_stable : ∀ n ∈ N, s₀₁ • n ∈ N := by
    intro n hn
    refine Submodule.span_induction (p := fun x _ => s₀₁ • x ∈ N) ?_ ?_ ?_ ?_ hn
    · rintro _ ⟨⟨i, m⟩, him, rfl⟩
      rw [Finset.mem_coe, Finset.mem_product, Finset.mem_range, Finset.mem_range] at him
      rcases him with ⟨hi, hm⟩
      have hmul : s₀₁ • (s₀₁ ^ i * u₀₁ ^ m) = s₀₁ ^ (i + 1) * u₀₁ ^ m := by
        rw [smul_eq_mul]
        ring
      rw [hmul]
      by_cases h1 : i + 1 < p + q
      · exact hBox_mem (i + 1) m h1 hm
      · have hipq : i + 1 = p + q := by omega
        rw [hipq]
        by_cases h2 : e ≤ m
        · rw [pow_add s₀₁ p q, h_sq, Finset.mul_sum, Finset.sum_mul]
          refine N.sum_mem fun j hj => ?_
          rw [Finset.mul_sum, Finset.sum_mul]
          refine N.sum_mem fun b hb => ?_
          rw [Finset.mem_range] at hj hb
          have hbm : b ≤ m := by omega
          have huv_pow : u₀₁ ^ m * v₀₁ ^ b = u₀₁ ^ (m - b) := by
            calc u₀₁ ^ m * v₀₁ ^ b
                = u₀₁ ^ (m - b + b) * v₀₁ ^ b := by rw [Nat.sub_add_cancel hbm]
              _ = u₀₁ ^ (m - b) * (u₀₁ ^ b * v₀₁ ^ b) := by rw [pow_add, mul_assoc]
              _ = u₀₁ ^ (m - b) * (u₀₁ * v₀₁) ^ b := by rw [← mul_pow]
              _ = u₀₁ ^ (m - b) * 1 ^ b := by rw [show u₀₁ * v₀₁ = 1 from huv]
              _ = u₀₁ ^ (m - b) := by rw [one_pow, mul_one]
          have hterm : s₀₁ ^ p * (r₀₁ ((c₁ j).coeff b) * (s₀₁ ^ j * v₀₁ ^ b)) * u₀₁ ^ m =
              ((c₁ j).coeff b) • (s₀₁ ^ (p + j) * u₀₁ ^ (m - b)) := by
            rw [hsmul_r₀₁, pow_add s₀₁ p j]
            calc s₀₁ ^ p * (r₀₁ ((c₁ j).coeff b) * (s₀₁ ^ j * v₀₁ ^ b)) * u₀₁ ^ m
                = r₀₁ ((c₁ j).coeff b) * ((s₀₁ ^ p * s₀₁ ^ j) * (u₀₁ ^ m * v₀₁ ^ b)) := by ring
              _ = r₀₁ ((c₁ j).coeff b) * (s₀₁ ^ p * s₀₁ ^ j * u₀₁ ^ (m - b)) := by rw [huv_pow]
          rw [hterm]
          exact N.smul_mem ((c₁ j).coeff b) (hBox_mem (p + j) (m - b) (by omega) (by omega))
        · have hqp : p + q = q + p := add_comm p q
          rw [hqp, pow_add s₀₁ q p, h_sp, Finset.mul_sum, Finset.sum_mul]
          refine N.sum_mem fun i' hi' => ?_
          rw [Finset.mul_sum, Finset.sum_mul]
          refine N.sum_mem fun a ha => ?_
          rw [Finset.mem_range] at hi' ha
          have hterm : s₀₁ ^ q * (r₀₁ ((c₀ i').coeff a) * (s₀₁ ^ i' * u₀₁ ^ a)) * u₀₁ ^ m =
              ((c₀ i').coeff a) • (s₀₁ ^ (q + i') * u₀₁ ^ (m + a)) := by
            rw [hsmul_r₀₁, pow_add s₀₁ q i', pow_add u₀₁ m a]
            ring
          rw [hterm]
          exact N.smul_mem ((c₀ i').coeff a) (hBox_mem (q + i') (m + a) (by omega) (by omega))
    · rw [smul_zero]
      exact N.zero_mem
    · intro x y _ _ hx hy
      rw [smul_add]
      exact N.add_mem hx hy
    · intro r x _ hx
      have hcomm_smul : s₀₁ • (r • x) = r • (s₀₁ • x) := by
        rw [smul_eq_mul, hsmul_r₀₁, hsmul_r₀₁, smul_eq_mul]
        ring
      rw [hcomm_smul]
      exact N.smul_mem r hx
  have hInt01 : IsIntegral R₀ s₀₁ :=
    isIntegral_of_smul_mem_submodule N hN_ne_bot hN_fg s₀₁ hN_stable
  obtain ⟨P, hP_monic, hP_eval01⟩ := hInt01
  have hP_D : Polynomial.eval₂ φ s P = 0 := by
    apply hInj01
    rw [map_zero]
    rw [RingHom.algebraMap_toAlgebra] at hP_eval01
    change Polynomial.eval₂ ((res₀.comp f₀).comp φ) ((res₀.comp f₀) s) P = 0 at hP_eval01
    rwa [← Polynomial.hom_eval₂ P φ (res₀.comp f₀) s] at hP_eval01
  obtain ⟨m, a, hma⟩ := hFrac s
  let b : R₀ := r_gen ^ m
  have hb_ne : b ≠ 0 := pow_ne_zero m hr_ne
  have hφbs : φ b * s = φ a := by
    dsimp [b]
    rw [map_pow]
    exact hma
  have hφb_ne : φ b ≠ 0 := fun h => hb_ne (hInjφ (h.trans (map_zero φ).symm))
  have h_scale : Polynomial.eval a (P.scaleRoots b) = 0 := by
    have h1 := Polynomial.scaleRoots_eval₂_eq_zero φ (s := b) hP_D
    rw [hφbs, Polynomial.eval₂_at_apply φ a] at h1
    exact hInjφ (h1.trans (map_zero φ).symm)
  let K := FractionRing R₀
  let ι : R₀ →+* K := algebraMap R₀ K
  have hInjι : Function.Injective ι := IsFractionRing.injective R₀ K
  have hιb_ne : ι b ≠ 0 := fun h => hb_ne (hInjι (h.trans (map_zero ι).symm))
  let q_frac : K := ι a / ι b
  have hιbq : ι b * q_frac = ι a := mul_div_cancel₀ (ι a) hιb_ne
  have hq_eval : Polynomial.eval₂ ι q_frac P = 0 := by
    have hmul : ι b ^ P.natDegree * Polynomial.eval₂ ι q_frac P = 0 := by
      rw [← Polynomial.scaleRoots_eval₂_mul (p := P) ι q_frac b, hιbq,
        Polynomial.eval₂_at_apply ι a, h_scale, map_zero]
    exact (mul_eq_zero.mp hmul).resolve_left (pow_ne_zero P.natDegree hιb_ne)
  have hq_int : IsIntegral R₀ q_frac := ⟨P, hP_monic, hq_eval⟩
  obtain ⟨c, hc⟩ := (IsIntegrallyClosed.isIntegral_iff (x := q_frac)).mp hq_int
  have hbc : b * c = a := by
    apply hInjι
    rw [map_mul, show algebraMap R₀ K c = q_frac from hc, hιbq]
  refine ⟨c, ?_⟩
  apply mul_left_cancel₀ hφb_ne
  rw [← map_mul, hbc, hφbs]

theorem weil_rees_laurent_cech_maximal_idempotent_rigidity (R₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀]
    (m₀ : Ideal R₀) (hMax : m₀.IsMaximal)
    (B₀ B₁ B₀₁ : Type u) [CommRing B₀] [CommRing B₁] [CommRing B₀₁]
    (r₀ : R₀ →+* B₀) (r₁ : R₀ →+* B₁) (r₀₁ : R₀ →+* B₀₁)
    (res₀ : B₀ →+* B₀₁) (res₁ : B₁ →+* B₀₁)
    (hr₀ : res₀.comp r₀ = r₀₁)
    (hr₁ : res₁.comp r₁ = r₀₁)
    (hGlued : ∀ (x₀ : B₀) (x₁ : B₁), res₀ x₀ = res₁ x₁ → ∃ r : R₀, r₀ r = x₀ ∧ r₁ r = x₁)
    (u : B₀) (v : B₁)
    (huv : res₀ u * res₁ v = 1)
    (hFin₀ : (Polynomial.eval₂RingHom r₀ u).Finite)
    (hLoc₀ : ∀ z : B₀₁, ∃ (m : ℕ) (b₀ : B₀), z * (res₀ u) ^ m = res₀ b₀)
    (hLoc₁ : ∀ z : B₀₁, ∃ (m : ℕ) (b₁ : B₁), z * (res₁ v) ^ m = res₁ b₁)
    (x₀ : B₀) (x₁ : B₁)
    (hx₀ : x₀ ^ 2 - x₀ ∈ Ideal.map r₀ m₀)
    (hx₁ : x₁ ^ 2 - x₁ ∈ Ideal.map r₁ m₀)
    (hx₀₁ : res₀ x₀ - res₁ x₁ ∈ Ideal.map r₀₁ m₀) :
    (x₀ ∈ Ideal.map r₀ m₀ ∧ x₁ ∈ Ideal.map r₁ m₀) ∨
      (1 - x₀ ∈ Ideal.map r₀ m₀ ∧ 1 - x₁ ∈ Ideal.map r₁ m₀) :=
by
  have hr₀_ap : ∀ c : R₀, res₀ (r₀ c) = r₀₁ c := fun c => congrArg (fun f => f c) hr₀
  have hr₁_ap : ∀ c : R₀, res₁ (r₁ c) = r₀₁ c := fun c => congrArg (fun f => f c) hr₁
  
  have h_s1 : ∃ (F₀ : Finset B₀₁), ∀ w : B₀₁, ∃ (a₀ : B₀) (a₁ : B₁) (c : B₀₁ → R₀),
      w = res₀ a₀ - res₁ a₁ + ∑ f ∈ F₀, r₀₁ (c f) * f := by
    classical
    letI : Algebra (Polynomial R₀) B₀ := (Polynomial.eval₂RingHom r₀ u).toAlgebra
    haveI : Module.Finite (Polynomial R₀) B₀ := hFin₀
    obtain ⟨E, hE⟩ := Module.Finite.fg_top (R := Polynomial R₀) (M := B₀)
    choose d g hdg using fun e : B₀ => hLoc₁ (res₀ e)
    let D : ℕ := E.sup d + 1
    let F₀ : Finset B₀₁ :=
      E.biUnion (fun e => (Finset.Ico 1 D).image (fun k => (res₁ v) ^ k * res₀ e))
    let IsDecomp : B₀₁ → Prop := fun w =>
      ∃ (a₀ : B₀) (a₁ : B₁) (c : B₀₁ → R₀), w = res₀ a₀ - res₁ a₁ + ∑ f ∈ F₀, r₀₁ (c f) * f
    have hDecomp_zero : IsDecomp 0 := ⟨0, 0, fun _ => 0, by simp⟩
    have hDecomp_add : ∀ {w₁ w₂ : B₀₁}, IsDecomp w₁ → IsDecomp w₂ → IsDecomp (w₁ + w₂) := by
      rintro w₁ w₂ ⟨a₀, a₁, c₁, hw₁⟩ ⟨b₀, b₁, c₂, hw₂⟩
      refine ⟨a₀ + b₀, a₁ + b₁, fun f => c₁ f + c₂ f, ?_⟩
      rw [hw₁, hw₂]
      simp only [map_add, add_mul, Finset.sum_add_distrib]
      ring
    refine ⟨F₀, fun w => ?_⟩
    obtain ⟨M, b₀, hb₀⟩ := hLoc₀ w
    have hw_eq : w = res₀ b₀ * (res₁ v) ^ M := by
      calc w = w * 1 := (mul_one w).symm
        _ = w * (res₀ u * res₁ v) ^ M := by rw [huv, one_pow]
        _ = (w * (res₀ u) ^ M) * (res₁ v) ^ M := by rw [mul_pow, mul_assoc]
        _ = res₀ b₀ * (res₁ v) ^ M := by rw [hb₀]
    have hb₀_mem : b₀ ∈ Submodule.span (Polynomial R₀) (E : Set B₀) := by
      rw [hE]; trivial
    obtain ⟨φ, _, hφ_sum⟩ := Submodule.mem_span_finset.mp hb₀_mem
    have hsmul_eq : ∀ (p : Polynomial R₀) (e : B₀), p • e = Polynomial.eval₂ r₀ u p * e :=
      fun _ _ => rfl
    rw [hw_eq, ← hφ_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_induction (fun e => res₀ (φ e • e) * (res₁ v) ^ M) IsDecomp
      (fun _ _ => hDecomp_add) hDecomp_zero (fun e he => ?_)
    rw [hsmul_eq]
    refine Polynomial.induction_on' (φ e) ?_ ?_
    · intro p q hp hq
      have h_add : res₀ (Polynomial.eval₂ r₀ u (p + q) * e) * (res₁ v) ^ M =
          res₀ (Polynomial.eval₂ r₀ u p * e) * (res₁ v) ^ M +
            res₀ (Polynomial.eval₂ r₀ u q * e) * (res₁ v) ^ M := by
        rw [Polynomial.eval₂_add, add_mul, map_add, add_mul]
      rw [h_add]
      exact hDecomp_add hp hq
    · intro j r
      rw [Polynomial.eval₂_monomial]
      have h_mon : res₀ (r₀ r * u ^ j * e) * (res₁ v) ^ M =
          r₀₁ r * ((res₀ u) ^ j * (res₁ v) ^ M) * res₀ e := by
        simp only [map_mul, map_pow, hr₀_ap]
        ring
      rw [h_mon]
      rcases le_or_gt M j with hMj | hMj
      · have hj : j = (j - M) + M := (Nat.sub_add_cancel hMj).symm
        have huv_cancel : (res₀ u) ^ j * (res₁ v) ^ M = (res₀ u) ^ (j - M) := by
          calc (res₀ u) ^ j * (res₁ v) ^ M
              = (res₀ u) ^ ((j - M) + M) * (res₁ v) ^ M := by rw [← hj]
            _ = (res₀ u) ^ (j - M) * ((res₀ u) ^ M * (res₁ v) ^ M) := by rw [pow_add, mul_assoc]
            _ = (res₀ u) ^ (j - M) * (res₀ u * res₁ v) ^ M := by rw [← mul_pow]
            _ = (res₀ u) ^ (j - M) := by rw [huv, one_pow, mul_one]
        refine ⟨r₀ r * u ^ (j - M) * e, 0, fun _ => 0, ?_⟩
        rw [huv_cancel]
        simp only [map_mul, map_pow, map_zero, hr₀_ap, zero_mul, Finset.sum_const_zero]
        ring
      · let k : ℕ := M - j
        have hM_eq : M = j + k := (Nat.add_sub_of_le (le_of_lt hMj)).symm
        have huv_cancel : (res₀ u) ^ j * (res₁ v) ^ M = (res₁ v) ^ k := by
          calc (res₀ u) ^ j * (res₁ v) ^ M
              = (res₀ u) ^ j * (res₁ v) ^ (j + k) := by rw [← hM_eq]
            _ = ((res₀ u) ^ j * (res₁ v) ^ j) * (res₁ v) ^ k := by rw [pow_add, ← mul_assoc]
            _ = (res₀ u * res₁ v) ^ j * (res₁ v) ^ k := by rw [← mul_pow]
            _ = (res₁ v) ^ k := by rw [huv, one_pow, one_mul]
        rw [huv_cancel]
        rcases le_or_gt D k with hDk | hkD
        · have hd_le_sup : d e ≤ E.sup d := Finset.le_sup he
          have hd_le_k : d e ≤ k := by omega
          have hk_eq : k = d e + (k - d e) := (Nat.add_sub_of_le hd_le_k).symm
          have hv_pole : (res₁ v) ^ k * res₀ e = res₁ (g e * v ^ (k - d e)) := by
            calc (res₁ v) ^ k * res₀ e
                = (res₁ v) ^ (d e + (k - d e)) * res₀ e := by rw [← hk_eq]
              _ = (res₀ e * (res₁ v) ^ d e) * (res₁ v) ^ (k - d e) := by rw [pow_add]; ring
              _ = res₁ (g e) * (res₁ v) ^ (k - d e) := by rw [hdg e]
              _ = res₁ (g e * v ^ (k - d e)) := by rw [map_mul, map_pow]
          refine ⟨0, -(r₁ r * (g e * v ^ (k - d e))), fun _ => 0, ?_⟩
          have h_term : r₀₁ r * (res₁ v) ^ k * res₀ e =
               res₁ (r₁ r * (g e * v ^ (k - d e))) := by
            calc r₀₁ r * (res₁ v) ^ k * res₀ e
                = res₁ (r₁ r) * ((res₁ v) ^ k * res₀ e) := by rw [hr₁_ap, mul_assoc]
              _ = res₁ (r₁ r) * res₁ (g e * v ^ (k - d e)) := by rw [hv_pole]
              _ = res₁ (r₁ r * (g e * v ^ (k - d e))) := (map_mul _ _ _).symm
          rw [h_term]
          simp only [map_zero, map_neg, zero_mul, Finset.sum_const_zero]
          ring
        · have hk_mem : k ∈ Finset.Ico 1 D := Finset.mem_Ico.mpr ⟨by omega, hkD⟩
          let f₀ : B₀₁ := (res₁ v) ^ k * res₀ e
          have hf₀ : f₀ ∈ F₀ :=
            Finset.mem_biUnion.mpr ⟨e, he, Finset.mem_image.mpr ⟨k, hk_mem, rfl⟩⟩
          refine ⟨0, 0, fun f => if f = f₀ then r else 0, ?_⟩
          have h_sum : ∑ f ∈ F₀, r₀₁ (if f = f₀ then r else 0) * f = r₀₁ r * f₀ := by
            rw [Finset.sum_eq_single f₀]
            · simp
            · intro f _ hne
              simp [hne]
            · intro hnot
              exact False.elim (hnot hf₀)
          rw [h_sum]
          simp only [f₀, map_zero, sub_self, zero_add]
          ring
  obtain ⟨F₀, hSplit⟩ := h_s1
  
  have h_s2 : ∃ n₀ : ℕ, ∀ (a₀ : B₀) (a₁ : B₁),
      res₀ a₀ - res₁ a₁ ∈ Ideal.map r₀₁ (m₀ ^ n₀) →
        ∃ (b₀ : B₀) (b₁ : B₁),
          b₀ ∈ Ideal.map r₀ m₀ ∧ b₁ ∈ Ideal.map r₁ m₀ ∧
            res₀ a₀ - res₁ a₁ = res₀ b₀ - res₁ b₁ := by
    classical
    let R_rees : Subalgebra R₀ (Polynomial R₀) := reesAlgebra m₀
    let ψ_rees : ↥R_rees →+* Polynomial B₀₁ :=
      (Polynomial.mapRingHom r₀₁).comp R_rees.val.toRingHom
    letI : Algebra ↥R_rees (Polynomial B₀₁) := ψ_rees.toAlgebra
    have h_smul_rees : ∀ (q : ↥R_rees) (P : Polynomial B₀₁),
        q • P = Polynomial.map r₀₁ q.1 * P := fun _ _ => rfl
    have h_mul_pow : ∀ {A : Type u} [CommRing A] (ρ : R₀ →+* A) {i j : ℕ} {c : R₀} {x : A},
        c ∈ m₀ ^ i → x ∈ Ideal.map ρ (m₀ ^ j) → ρ c * x ∈ Ideal.map ρ (m₀ ^ (i + j)) := by
      intro A _ ρ i j c x hc hx
      have hmul : ρ c * x ∈ Ideal.map ρ (m₀ ^ i) * Ideal.map ρ (m₀ ^ j) :=
        Ideal.mul_mem_mul (Ideal.mem_map_of_mem ρ hc) hx
      rwa [← Ideal.map_mul, ← pow_add] at hmul
    let M_Rees : Submodule ↥R_rees (Polynomial B₀₁) :=
      { carrier := {P | ∀ n : ℕ, P.coeff n ∈ Ideal.map r₀₁ (m₀ ^ n)}
        zero_mem' := fun n => by simp
        add_mem' := fun {P₁ P₂} h₁ h₂ n => by
          rw [Polynomial.coeff_add]
          exact add_mem (h₁ n) (h₂ n)
        smul_mem' := fun q P hP n => by
          rw [h_smul_rees, Polynomial.coeff_mul]
          refine sum_mem fun ij hij => ?_
          rw [Polynomial.coeff_map, ← Finset.HasAntidiagonal.mem_antidiagonal.mp hij]
          exact h_mul_pow r₀₁ ((mem_reesAlgebra_iff m₀ q.1).mp q.2 ij.1) (hP ij.2) }
    let D_Rees : Submodule ↥R_rees (Polynomial B₀₁) :=
      { carrier := {P | ∀ n : ℕ, ∃ (a₀ : B₀) (a₁ : B₁),
          a₀ ∈ Ideal.map r₀ (m₀ ^ n) ∧ a₁ ∈ Ideal.map r₁ (m₀ ^ n) ∧
            P.coeff n = res₀ a₀ - res₁ a₁}
        zero_mem' := fun n => ⟨0, 0, zero_mem _, zero_mem _, by simp⟩
        add_mem' := fun {P₁ P₂} h₁ h₂ n => by
          obtain ⟨a₀, a₁, ha₀, ha₁, heq₁⟩ := h₁ n
          obtain ⟨b₀, b₁, hb₀, hb₁, heq₂⟩ := h₂ n
          refine ⟨a₀ + b₀, a₁ + b₁, add_mem ha₀ hb₀, add_mem ha₁ hb₁, ?_⟩
          rw [Polynomial.coeff_add, heq₁, heq₂, map_add, map_add]
          ring
        smul_mem' := fun q P hP n => by
          choose a₀_fn a₁_fn ha₀_fn ha₁_fn heq_fn using hP
          refine ⟨∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, r₀ (q.1.coeff ij.1) * a₀_fn ij.2,
            ∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, r₁ (q.1.coeff ij.1) * a₁_fn ij.2,
            ?_, ?_, ?_⟩
          · refine sum_mem fun ij hij => ?_
            rw [← Finset.HasAntidiagonal.mem_antidiagonal.mp hij]
            exact h_mul_pow r₀ ((mem_reesAlgebra_iff m₀ q.1).mp q.2 ij.1) (ha₀_fn ij.2)
          · refine sum_mem fun ij hij => ?_
            rw [← Finset.HasAntidiagonal.mem_antidiagonal.mp hij]
            exact h_mul_pow r₁ ((mem_reesAlgebra_iff m₀ q.1).mp q.2 ij.1) (ha₁_fn ij.2)
          · rw [h_smul_rees, Polynomial.coeff_mul, map_sum, map_sum, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun ij _ => ?_
            rw [Polynomial.coeff_map, heq_fn ij.2, map_mul, map_mul, hr₀_ap, hr₁_ap, mul_sub] }
    let B_Rees : Submodule ↥R_rees (Polynomial B₀₁) :=
      { carrier := {P | ∀ n : ℕ, ∃ (a₀ : B₀) (a₁ : B₁), P.coeff n = res₀ a₀ - res₁ a₁}
        zero_mem' := fun n => ⟨0, 0, by simp⟩
        add_mem' := fun {P₁ P₂} h₁ h₂ n => by
          obtain ⟨a₀, a₁, heq₁⟩ := h₁ n
          obtain ⟨b₀, b₁, heq₂⟩ := h₂ n
          refine ⟨a₀ + b₀, a₁ + b₁, ?_⟩
          rw [Polynomial.coeff_add, heq₁, heq₂, map_add, map_add]
          ring
        smul_mem' := fun q P hP n => by
          choose a₀_fn a₁_fn heq_fn using hP
          refine ⟨∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, r₀ (q.1.coeff ij.1) * a₀_fn ij.2,
            ∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n, r₁ (q.1.coeff ij.1) * a₁_fn ij.2, ?_⟩
          rw [h_smul_rees, Polynomial.coeff_mul, map_sum, map_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun ij _ => ?_
          rw [Polynomial.coeff_map, heq_fn ij.2, map_mul, map_mul, hr₀_ap, hr₁_ap, mul_sub] }
    let K_Rees : Submodule ↥R_rees (Polynomial B₀₁) := M_Rees ⊓ B_Rees
    letI : AddCommGroup ↥M_Rees := M_Rees.addCommGroup
    letI : Module ↥R_rees ↥M_Rees := M_Rees.module
    let D'_Rees : Submodule ↥R_rees ↥M_Rees := D_Rees.comap M_Rees.subtype
    let Q : Type u := ↥M_Rees ⧸ D'_Rees
    letI : AddCommGroup Q := Submodule.Quotient.addCommGroup D'_Rees
    letI : Module ↥R_rees Q := Submodule.Quotient.module D'_Rees
    let π_Q : ↥M_Rees →ₗ[↥R_rees] Q := Submodule.mkQ D'_Rees
    have hC_M : ∀ w : B₀₁, Polynomial.C w ∈ M_Rees := by
      intro w n
      rcases eq_or_ne n 0 with rfl | hn
      · rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]; trivial
      · simp only [Polynomial.coeff_C, hn, ↓reduceIte, zero_mem]
    have hC_D : ∀ (a₀ : B₀) (a₁ : B₁), Polynomial.C (res₀ a₀ - res₁ a₁) ∈ D_Rees := by
      intro a₀ a₁ n
      rcases eq_or_ne n 0 with rfl | hn
      · refine ⟨a₀, a₁, ?_, ?_, Polynomial.coeff_C_zero⟩
        · rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]; trivial
        · rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]; trivial
      · refine ⟨0, 0, zero_mem _, zero_mem _, ?_⟩
        simp [Polynomial.coeff_C, hn]
    have hMon_M : ∀ (n : ℕ) {z : B₀₁},
        z ∈ Ideal.map r₀₁ (m₀ ^ n) → Polynomial.monomial n z ∈ M_Rees := by
      intro n z hz m
      rw [Polynomial.coeff_monomial]
      split_ifs with hnm
      · subst hnm; exact hz
      · exact zero_mem _
    let cLift : B₀₁ → ↥M_Rees := fun w => ⟨Polynomial.C w, hC_M w⟩
    let G_Q : Finset Q := F₀.image (fun f => π_Q (cLift f))
    let S_Q : Submodule ↥R_rees Q := Submodule.span ↥R_rees (G_Q : Set Q)
    have hcLift_mem : ∀ w : B₀₁, π_Q (cLift w) ∈ S_Q := by
      intro w
      obtain ⟨a₀, a₁, c, hw⟩ := hSplit w
      let q₀ : R₀ → ↥R_rees := fun r => ⟨Polynomial.C r, R_rees.algebraMap_mem r⟩
      have h_eq : cLift w =
          cLift (res₀ a₀ - res₁ a₁) + ∑ f ∈ F₀, q₀ (c f) • cLift f := by
        apply Subtype.ext
        change Polynomial.C w =
          (cLift (res₀ a₀ - res₁ a₁) + ∑ f ∈ F₀, q₀ (c f) • cLift f).1
        rw [Submodule.coe_add, AddSubmonoidClass.coe_finsetSum]
        change Polynomial.C w =
          Polynomial.C (res₀ a₀ - res₁ a₁) + ∑ f ∈ F₀, Polynomial.map r₀₁ (Polynomial.C (c f)) * Polynomial.C f
        rw [hw, map_add, map_sum]
        congr 1
        refine Finset.sum_congr rfl fun f _ => ?_
        rw [Polynomial.map_C, Polynomial.C_mul]
      rw [h_eq, map_add, map_sum]
      have h_cob_zero : π_Q (cLift (res₀ a₀ - res₁ a₁)) = 0 :=
        (Submodule.Quotient.mk_eq_zero D'_Rees).mpr
          (show cLift (res₀ a₀ - res₁ a₁) ∈ D'_Rees from hC_D a₀ a₁)
      rw [h_cob_zero, zero_add]
      refine sum_mem fun f hf => ?_
      rw [map_smul]
      exact S_Q.smul_mem (q₀ (c f)) (Submodule.subset_span (Finset.mem_image_of_mem _ hf))
    have hMon_mem : ∀ (n : ℕ) {z : B₀₁} (hz : z ∈ Ideal.map r₀₁ (m₀ ^ n)) (w : B₀₁),
        π_Q ⟨Polynomial.monomial n (w * z), hMon_M n (Ideal.mul_mem_left _ w hz)⟩ ∈ S_Q := by
      intro n z hz
      refine Submodule.span_induction
        (p := fun z (hz : z ∈ Ideal.map r₀₁ (m₀ ^ n)) =>
          ∀ w : B₀₁, π_Q ⟨Polynomial.monomial n (w * z), hMon_M n (Ideal.mul_mem_left _ w hz)⟩ ∈ S_Q)
        ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨c, hc, rfl⟩ w
        let q_c : ↥R_rees := ⟨Polynomial.monomial n c, reesAlgebra.monomial_mem.mpr hc⟩
        have h_eq : (⟨Polynomial.monomial n (w * r₀₁ c),
            hMon_M n (Ideal.mul_mem_left _ w (Submodule.subset_span ⟨c, hc, rfl⟩))⟩ : ↥M_Rees) =
            q_c • cLift w := by
          apply Subtype.ext
          change Polynomial.monomial n (w * r₀₁ c) = Polynomial.map r₀₁ (Polynomial.monomial n c) * Polynomial.C w
          rw [Polynomial.map_monomial, ← Polynomial.monomial_zero_left,
            Polynomial.monomial_mul_monomial, add_zero, mul_comm]
        rw [h_eq, map_smul]
        exact S_Q.smul_mem q_c (hcLift_mem w)
      · intro w
        have h_eq : (⟨Polynomial.monomial n (w * 0),
            hMon_M n (Ideal.mul_mem_left _ w (zero_mem _))⟩ : ↥M_Rees) = 0 := by
          apply Subtype.ext
          simp
        rw [h_eq, map_zero]
        exact S_Q.zero_mem
      · intro z₁ z₂ hz₁ hz₂ ih₁ ih₂ w
        have h_eq : (⟨Polynomial.monomial n (w * (z₁ + z₂)),
            hMon_M n (Ideal.mul_mem_left _ w (add_mem hz₁ hz₂))⟩ : ↥M_Rees) =
            ⟨Polynomial.monomial n (w * z₁), hMon_M n (Ideal.mul_mem_left _ w hz₁)⟩ +
              ⟨Polynomial.monomial n (w * z₂), hMon_M n (Ideal.mul_mem_left _ w hz₂)⟩ := by
          apply Subtype.ext
          change Polynomial.monomial n (w * (z₁ + z₂)) =
            Polynomial.monomial n (w * z₁) + Polynomial.monomial n (w * z₂)
          rw [mul_add, map_add]
        rw [h_eq, map_add]
        exact S_Q.add_mem (ih₁ w) (ih₂ w)
      · intro b z' hz' ih w
        have h_eq : (⟨Polynomial.monomial n (w * (b • z')),
            hMon_M n (Ideal.mul_mem_left _ w (Submodule.smul_mem _ b hz'))⟩ : ↥M_Rees) =
            ⟨Polynomial.monomial n ((w * b) * z'), hMon_M n (Ideal.mul_mem_left _ (w * b) hz')⟩ := by
          apply Subtype.ext
          change Polynomial.monomial n (w * (b • z')) = Polynomial.monomial n ((w * b) * z')
          rw [smul_eq_mul, mul_assoc]
        rw [h_eq]
        exact ih (w * b)
    have hSQ_top : S_Q = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨P_sub, rfl⟩ := Submodule.Quotient.mk_surjective D'_Rees x
      have hP_eq : P_sub =
          ∑ n ∈ P_sub.1.support, ⟨Polynomial.monomial n (P_sub.1.coeff n), hMon_M n (P_sub.2 n)⟩ := by
        apply Subtype.ext
        rw [AddSubmonoidClass.coe_finsetSum]
        exact P_sub.1.as_sum_support
      change π_Q P_sub ∈ S_Q
      rw [hP_eq, map_sum]
      refine sum_mem fun n _ => ?_
      have h1 := hMon_mem n (P_sub.2 n) 1
      have h_eq : (⟨Polynomial.monomial n (P_sub.1.coeff n), hMon_M n (P_sub.2 n)⟩ : ↥M_Rees) =
          ⟨Polynomial.monomial n (1 * P_sub.1.coeff n),
            hMon_M n (Ideal.mul_mem_left _ 1 (P_sub.2 n))⟩ := by
        apply Subtype.ext
        simp
      rw [h_eq]
      exact h1
    haveI : Module.Finite ↥R_rees Q := Module.Finite.of_fg_top ⟨G_Q, hSQ_top⟩
    haveI : IsNoetherian ↥R_rees Q := isNoetherian_of_isNoetherianRing_of_finite ↥R_rees Q
    let K'_Rees : Submodule ↥R_rees ↥M_Rees := K_Rees.comap M_Rees.subtype
    let K_Q : Submodule ↥R_rees Q := K'_Rees.map π_Q
    obtain ⟨S_gen, hS_gen⟩ := IsNoetherian.noetherian K_Q
    let liftK : Q → ↥M_Rees := fun s =>
      if hs : s ∈ K_Q then Classical.choose hs else 0
    have hliftK_mem : ∀ s ∈ S_gen, (liftK s).1 ∈ K_Rees := by
      intro s hs
      have hs_KQ : s ∈ K_Q := hS_gen ▸ Submodule.subset_span hs
      simp only [liftK, hs_KQ, ↓reduceDIte]
      exact (Classical.choose_spec hs_KQ).1
    have hliftK_proj : ∀ s ∈ S_gen, π_Q (liftK s) = s := by
      intro s hs
      have hs_KQ : s ∈ K_Q := hS_gen ▸ Submodule.subset_span hs
      simp only [liftK, hs_KQ, ↓reduceDIte]
      exact (Classical.choose_spec hs_KQ).2
    let d_max : ℕ := S_gen.sup (fun s => (liftK s).1.natDegree)
    let n₀ : ℕ := d_max + 1
    let IsGoodCob : B₀₁ → Prop := fun w =>
      ∃ (b₀ : B₀) (b₁ : B₁),
        b₀ ∈ Ideal.map r₀ m₀ ∧ b₁ ∈ Ideal.map r₁ m₀ ∧ w = res₀ b₀ - res₁ b₁
    have hGood_zero : IsGoodCob 0 := ⟨0, 0, zero_mem _, zero_mem _, by simp⟩
    have hGood_add : ∀ {w₁ w₂ : B₀₁}, IsGoodCob w₁ → IsGoodCob w₂ → IsGoodCob (w₁ + w₂) := by
      rintro w₁ w₂ ⟨b₀, b₁, hb₀, hb₁, hw₁⟩ ⟨c₀, c₁, hc₀, hc₁, hw₂⟩
      refine ⟨b₀ + c₀, b₁ + c₁, add_mem hb₀ hc₀, add_mem hb₁ hc₁, ?_⟩
      rw [hw₁, hw₂, map_add, map_add]
      ring
    refine ⟨n₀, fun a₀ a₁ hz => ?_⟩
    let z : B₀₁ := res₀ a₀ - res₁ a₁
    have hPz_K : Polynomial.monomial n₀ z ∈ K_Rees := by
      refine ⟨hMon_M n₀ hz, fun n => ?_⟩
      rw [Polynomial.coeff_monomial]
      split_ifs with h
      · exact ⟨a₀, a₁, rfl⟩
      · exact ⟨0, 0, by simp⟩
    let Pz_sub : ↥M_Rees := ⟨Polynomial.monomial n₀ z, hPz_K.1⟩
    have hPz_KQ : π_Q Pz_sub ∈ Submodule.span ↥R_rees (S_gen : Set Q) := by
      rw [hS_gen]
      exact ⟨Pz_sub, hPz_K, rfl⟩
    obtain ⟨α, _, hα_sum⟩ := Submodule.mem_span_finset.mp hPz_KQ
    let Δ_sub : ↥M_Rees := Pz_sub - ∑ s ∈ S_gen, α s • liftK s
    have hΔ_proj : π_Q Δ_sub = 0 := by
      rw [map_sub, map_sum]
      have h_sum_eq : ∑ s ∈ S_gen, π_Q (α s • liftK s) = ∑ s ∈ S_gen, α s • s := by
        refine Finset.sum_congr rfl fun s hs => ?_
        rw [map_smul, hliftK_proj s hs]
      rw [h_sum_eq, hα_sum, sub_self]
    have hΔ_D : Δ_sub.1 ∈ D_Rees := (Submodule.Quotient.mk_eq_zero D'_Rees).mp hΔ_proj
    have hz_decomp : z = Δ_sub.1.coeff n₀ + ∑ s ∈ S_gen, ((α s • liftK s).1).coeff n₀ := by
      have hP_val : Pz_sub.1 = Δ_sub.1 + ∑ s ∈ S_gen, (α s • liftK s).1 := by
        change Pz_sub.1 = (Pz_sub - ∑ s ∈ S_gen, α s • liftK s).1 + ∑ s ∈ S_gen, (α s • liftK s).1
        rw [Submodule.coe_sub, AddSubmonoidClass.coe_finsetSum, sub_add_cancel]
      have hPz_coeff : Pz_sub.1.coeff n₀ = z := by
        change (Polynomial.monomial n₀ z).coeff n₀ = z
        simp
      rw [← hPz_coeff, hP_val, Polynomial.coeff_add, Polynomial.finsetSum_coeff]
    change IsGoodCob z
    rw [hz_decomp]
    refine hGood_add ?_ (Finset.sum_induction (fun s => ((α s • liftK s).1).coeff n₀) IsGoodCob
      (fun _ _ => hGood_add) hGood_zero fun s hs => ?_)
    · obtain ⟨d₀, d₁, hd₀, hd₁, hΔ_eq⟩ := hΔ_D n₀
      have hn₀_ne : n₀ ≠ 0 := Nat.succ_ne_zero d_max
      have hm_le : m₀ ^ n₀ ≤ m₀ := Ideal.pow_le_self hn₀_ne
      exact ⟨d₀, d₁, Ideal.map_mono hm_le hd₀, Ideal.map_mono hm_le hd₁, hΔ_eq⟩
    · change IsGoodCob ((Polynomial.map r₀₁ (α s).1 * (liftK s).1).coeff n₀)
      rw [Polynomial.coeff_mul]
      refine Finset.sum_induction
        (fun ij : ℕ × ℕ => (Polynomial.map r₀₁ (α s).1).coeff ij.1 * (liftK s).1.coeff ij.2)
        IsGoodCob (fun _ _ => hGood_add) hGood_zero (fun ij hij => ?_)
      rw [Polynomial.coeff_map]
      have hij_eq : ij.1 + ij.2 = d_max + 1 :=
        Finset.HasAntidiagonal.mem_antidiagonal.mp hij
      rcases lt_or_ge d_max ij.2 with hd_lt | hd_ge
      · have hdeg_le : (liftK s).1.natDegree ≤ d_max :=
          Finset.le_sup (f := fun s => (liftK s).1.natDegree) hs
        have h_zero : (liftK s).1.coeff ij.2 = 0 :=
          Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hdeg_le hd_lt)
        rw [h_zero, mul_zero]
        exact hGood_zero
      · have hij1_ne : ij.1 ≠ 0 := by omega
        have hc_pow : (α s).1.coeff ij.1 ∈ m₀ ^ ij.1 :=
          (mem_reesAlgebra_iff m₀ (α s).1).mp (α s).2 ij.1
        have hc_m₀ : (α s).1.coeff ij.1 ∈ m₀ := Ideal.pow_le_self hij1_ne hc_pow
        obtain ⟨u₀, u₁, hu_eq⟩ := (hliftK_mem s hs).2 ij.2
        refine ⟨r₀ ((α s).1.coeff ij.1) * u₀, r₁ ((α s).1.coeff ij.1) * u₁,
          Ideal.mul_mem_right u₀ _ (Ideal.mem_map_of_mem r₀ hc_m₀),
          Ideal.mul_mem_right u₁ _ (Ideal.mem_map_of_mem r₁ hc_m₀), ?_⟩
        rw [hu_eq, map_mul, map_mul, hr₀_ap, hr₁_ap, mul_sub]
  obtain ⟨n₀, hVanish⟩ := h_s2
  
  let J₀ : Ideal B₀ := Ideal.map r₀ m₀
  let J₁ : Ideal B₁ := Ideal.map r₁ m₀
  let J₀₁ : Ideal B₀₁ := Ideal.map r₀₁ m₀
  have h_s3 : ∃ (y₀ : B₀) (y₁ : B₁),
      y₀ - x₀ ∈ J₀ ∧ y₁ - x₁ ∈ J₁ ∧ res₀ y₀ - res₁ y₁ ∈ Ideal.map r₀₁ (m₀ ^ n₀) := by
    let iterN : ∀ {A : Type u} [CommRing A], ℕ → A → A :=
      fun k a => Nat.rec a (fun _ y => 3 * y ^ 2 - 2 * y ^ 3) k
    have h_id1 : ∀ {A : Type u} [CommRing A] (a : A),
        (3 * a ^ 2 - 2 * a ^ 3) - a = (a ^ 2 - a) * (1 - 2 * a) := fun _ => by ring
    have h_id2 : ∀ {A : Type u} [CommRing A] (a : A),
        (3 * a ^ 2 - 2 * a ^ 3) ^ 2 - (3 * a ^ 2 - 2 * a ^ 3) =
          (a ^ 2 - a) ^ 2 * (4 * a ^ 2 - 4 * a - 3) := fun _ => by ring
    have h_id3 : ∀ {A : Type u} [CommRing A] (u' w' : A),
        (3 * u' ^ 2 - 2 * u' ^ 3) - (3 * w' ^ 2 - 2 * w' ^ 3) =
          (-6) * ((u' - w') * (u' ^ 2 - u')) +
            (u' - w') ^ 2 * (6 * u' - 3 - 2 * (u' - w')) := fun _ _ => by ring
    have h_res₀_Jpow : ∀ (m : ℕ) {a : B₀}, a ∈ J₀ ^ m → res₀ a ∈ J₀₁ ^ m := by
      intro m a ha
      dsimp only [J₀, J₀₁] at ha ⊢
      rw [← Ideal.map_pow] at ha ⊢
      have h1 : res₀ a ∈ Ideal.map res₀ (Ideal.map r₀ (m₀ ^ m)) := Ideal.mem_map_of_mem res₀ ha
      rwa [Ideal.map_map, hr₀] at h1
    have h_ind : ∀ k : ℕ,
        (iterN k x₀) ^ 2 - iterN k x₀ ∈ J₀ ^ (2 ^ k) ∧
        (iterN k x₁) ^ 2 - iterN k x₁ ∈ J₁ ^ (2 ^ k) ∧
        iterN k x₀ - x₀ ∈ J₀ ∧
        iterN k x₁ - x₁ ∈ J₁ ∧
        res₀ (iterN k x₀) - res₁ (iterN k x₁) ∈ J₀₁ ^ (2 ^ k) := by
      intro k
      induction k with
      | zero =>
        change x₀ ^ 2 - x₀ ∈ J₀ ^ (2 ^ 0) ∧ x₁ ^ 2 - x₁ ∈ J₁ ^ (2 ^ 0) ∧
          x₀ - x₀ ∈ J₀ ∧ x₁ - x₁ ∈ J₁ ∧ res₀ x₀ - res₁ x₁ ∈ J₀₁ ^ (2 ^ 0)
        simp only [pow_zero, pow_one, sub_self]
        exact ⟨hx₀, hx₁, zero_mem _, zero_mem _, hx₀₁⟩
      | succ k ih =>
        rcases ih with ⟨h0_idem, h1_idem, h0_mod, h1_mod, h01_compat⟩
        let y₀k : B₀ := iterN k x₀
        let y₁k : B₁ := iterN k x₁
        have h2k : 2 ^ (k + 1) = 2 ^ k + 2 ^ k := by rw [pow_succ, mul_two]
        have h2k_ne : 2 ^ k ≠ 0 := pow_ne_zero k two_ne_zero
        have h0_sq : (y₀k ^ 2 - y₀k) ^ 2 ∈ J₀ ^ (2 ^ (k + 1)) := by
          rw [sq, h2k, pow_add]
          exact Ideal.mul_mem_mul h0_idem h0_idem
        have h1_sq : (y₁k ^ 2 - y₁k) ^ 2 ∈ J₁ ^ (2 ^ (k + 1)) := by
          rw [sq, h2k, pow_add]
          exact Ideal.mul_mem_mul h1_idem h1_idem
        have h0_idem_next : (iterN (k + 1) x₀) ^ 2 - iterN (k + 1) x₀ ∈ J₀ ^ (2 ^ (k + 1)) := by
          change (3 * y₀k ^ 2 - 2 * y₀k ^ 3) ^ 2 - (3 * y₀k ^ 2 - 2 * y₀k ^ 3) ∈ J₀ ^ (2 ^ (k + 1))
          rw [h_id2]
          exact Ideal.mul_mem_right _ _ h0_sq
        have h1_idem_next : (iterN (k + 1) x₁) ^ 2 - iterN (k + 1) x₁ ∈ J₁ ^ (2 ^ (k + 1)) := by
          change (3 * y₁k ^ 2 - 2 * y₁k ^ 3) ^ 2 - (3 * y₁k ^ 2 - 2 * y₁k ^ 3) ∈ J₁ ^ (2 ^ (k + 1))
          rw [h_id2]
          exact Ideal.mul_mem_right _ _ h1_sq
        have h0_mod_next : iterN (k + 1) x₀ - x₀ ∈ J₀ := by
          have h_step : (3 * y₀k ^ 2 - 2 * y₀k ^ 3) - y₀k ∈ J₀ := by
            rw [h_id1]
            exact Ideal.mul_mem_right _ _ (Ideal.pow_le_self h2k_ne h0_idem)
          have h_eq : iterN (k + 1) x₀ - x₀ =
              ((3 * y₀k ^ 2 - 2 * y₀k ^ 3) - y₀k) + (y₀k - x₀) := by
            change (3 * y₀k ^ 2 - 2 * y₀k ^ 3) - x₀ = _
            ring
          rw [h_eq]
          exact add_mem h_step h0_mod
        have h1_mod_next : iterN (k + 1) x₁ - x₁ ∈ J₁ := by
          have h_step : (3 * y₁k ^ 2 - 2 * y₁k ^ 3) - y₁k ∈ J₁ := by
            rw [h_id1]
            exact Ideal.mul_mem_right _ _ (Ideal.pow_le_self h2k_ne h1_idem)
          have h_eq : iterN (k + 1) x₁ - x₁ =
              ((3 * y₁k ^ 2 - 2 * y₁k ^ 3) - y₁k) + (y₁k - x₁) := by
            change (3 * y₁k ^ 2 - 2 * y₁k ^ 3) - x₁ = _
            ring
          rw [h_eq]
          exact add_mem h_step h1_mod
        have h01_next : res₀ (iterN (k + 1) x₀) - res₁ (iterN (k + 1) x₁) ∈ J₀₁ ^ (2 ^ (k + 1)) := by
          let u' : B₀₁ := res₀ y₀k
          let w' : B₀₁ := res₁ y₁k
          have h_map : res₀ (iterN (k + 1) x₀) - res₁ (iterN (k + 1) x₁) =
              (3 * u' ^ 2 - 2 * u' ^ 3) - (3 * w' ^ 2 - 2 * w' ^ 3) := by
            change res₀ (3 * y₀k ^ 2 - 2 * y₀k ^ 3) - res₁ (3 * y₁k ^ 2 - 2 * y₁k ^ 3) = _
            simp [u', w', map_ofNat]
          have hu_idem : u' ^ 2 - u' ∈ J₀₁ ^ (2 ^ k) := by
            have : u' ^ 2 - u' = res₀ (y₀k ^ 2 - y₀k) := by simp [u']
            rw [this]
            exact h_res₀_Jpow (2 ^ k) h0_idem
          have h_prod1 : (u' - w') * (u' ^ 2 - u') ∈ J₀₁ ^ (2 ^ (k + 1)) := by
            rw [h2k, pow_add]
            exact Ideal.mul_mem_mul h01_compat hu_idem
          have h_prod2 : (u' - w') ^ 2 ∈ J₀₁ ^ (2 ^ (k + 1)) := by
            rw [sq, h2k, pow_add]
            exact Ideal.mul_mem_mul h01_compat h01_compat
          rw [h_map, h_id3]
          exact add_mem (Ideal.mul_mem_left _ _ h_prod1) (Ideal.mul_mem_right _ _ h_prod2)
        exact ⟨h0_idem_next, h1_idem_next, h0_mod_next, h1_mod_next, h01_next⟩
    rcases h_ind n₀ with ⟨_, _, hy₀_mod, hy₁_mod, hy₀₁_pow⟩
    refine ⟨iterN n₀ x₀, iterN n₀ x₁, hy₀_mod, hy₁_mod, ?_⟩
    rw [Ideal.map_pow]
    exact Ideal.pow_le_pow_right (Nat.le_of_lt Nat.lt_two_pow_self) hy₀₁_pow
  obtain ⟨y₀, y₁, hy₀, hy₁, hy₀₁⟩ := h_s3
  
  obtain ⟨b₀, b₁, hb₀, hb₁, hb_eq⟩ := hVanish y₀ y₁ hy₀₁
  have h_res_glued : res₀ (y₀ - b₀) = res₁ (y₁ - b₁) := by
    have h_diff : res₀ (y₀ - b₀) - res₁ (y₁ - b₁) =
        (res₀ y₀ - res₁ y₁) - (res₀ b₀ - res₁ b₁) := by
      simp only [map_sub]
      ring
    rw [hb_eq, sub_self] at h_diff
    exact sub_eq_zero.mp h_diff
  obtain ⟨r, hr₀_eq, hr₁_eq⟩ := hGlued (y₀ - b₀) (y₁ - b₁) h_res_glued
  have hx₀_r : x₀ - r₀ r ∈ J₀ := by
    have h_eq : x₀ - r₀ r = b₀ - (y₀ - x₀) := by rw [hr₀_eq]; ring
    rw [h_eq]
    exact sub_mem hb₀ hy₀
  have hx₁_r : x₁ - r₁ r ∈ J₁ := by
    have h_eq : x₁ - r₁ r = b₁ - (y₁ - x₁) := by rw [hr₁_eq]; ring
    rw [h_eq]
    exact sub_mem hb₁ hy₁
  by_cases hr : r ∈ m₀
  · left
    refine ⟨?_, ?_⟩
    · have h_eq : x₀ = (x₀ - r₀ r) + r₀ r := by ring
      rw [h_eq]
      exact add_mem hx₀_r (Ideal.mem_map_of_mem r₀ hr)
    · have h_eq : x₁ = (x₁ - r₁ r) + r₁ r := by ring
      rw [h_eq]
      exact add_mem hx₁_r (Ideal.mem_map_of_mem r₁ hr)
  · right
    have h1_sup : (1 : R₀) ∈ m₀ ⊔ Ideal.span {r} :=
      (Ideal.isMaximal_iff.mp hMax).2 (m₀ ⊔ Ideal.span {r}) r le_sup_left hr
        (Submodule.mem_sup_right (Ideal.mem_span_singleton_self r))
    obtain ⟨m, hm, z, hz, hmz⟩ := Submodule.mem_sup.mp h1_sup
    obtain ⟨u_r, rfl⟩ := Ideal.mem_span_singleton.mp hz
    have hm_eq : 1 - r * u_r = m := by
      calc 1 - r * u_r = (m + r * u_r) - r * u_r := by rw [hmz]
        _ = m := add_sub_cancel_right m (r * u_r)
    have h_bezout : ∀ {A : Type u} [CommRing A] (x s q : A),
        1 - x = (1 - x) * (1 - s * q) - (1 - x) * q * (x - s) - q * (x ^ 2 - x) :=
      fun _ _ _ => by ring
    refine ⟨?_, ?_⟩
    · have h_inv0 : 1 - r₀ r * r₀ u_r ∈ J₀ := by
        have : 1 - r₀ r * r₀ u_r = r₀ m := by
          rw [← hm_eq, map_sub, map_one, map_mul]
        rw [this]
        exact Ideal.mem_map_of_mem r₀ hm
      rw [h_bezout x₀ (r₀ r) (r₀ u_r)]
      exact sub_mem
        (sub_mem (Ideal.mul_mem_left _ _ h_inv0) (Ideal.mul_mem_left _ _ hx₀_r))
        (Ideal.mul_mem_left _ _ hx₀)
    · have h_inv1 : 1 - r₁ r * r₁ u_r ∈ J₁ := by
        have : 1 - r₁ r * r₁ u_r = r₁ m := by
          rw [← hm_eq, map_sub, map_one, map_mul]
        rw [this]
        exact Ideal.mem_map_of_mem r₁ hm
      rw [h_bezout x₁ (r₁ r) (r₁ u_r)]
      exact sub_mem
        (sub_mem (Ideal.mul_mem_left _ _ h_inv1) (Ideal.mul_mem_left _ _ hx₁_r))
        (Ideal.mul_mem_left _ _ hx₁)

theorem weil_closed_fiber_connected_of_two_affine_idempotent_rigidity (Y X : AlgebraicGeometry.Scheme.{u})
    (g_X : Y ⟶ X)
    (x : X)
    (hClx : IsClosed ({x} : Set X))
    (U₀ : X.Opens)
    (hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (hxU₀ : x ∈ U₀)
    (hFibNe : Nonempty ↥{y : Y | g_X.base y = x})
    (V₀ V₁ : Y.Opens)
    (hAff₀ : AlgebraicGeometry.IsAffineOpen V₀)
    (hAff₁ : AlgebraicGeometry.IsAffineOpen V₁)
    (hAff₀₁ : AlgebraicGeometry.IsAffineOpen (V₀ ⊓ V₁))
    (hV₀_le : V₀ ≤ (TopologicalSpace.Opens.map g_X.base).obj U₀)
    (hV₁_le : V₁ ≤ (TopologicalSpace.Opens.map g_X.base).obj U₀)
    (hCov : V₀ ⊔ V₁ = ⊤)
    (hRig :
      let m₀ := (hAffU₀.primeIdealOf ⟨x, hxU₀⟩).asIdeal
      let r₀ := (g_X.appLE U₀ V₀ hV₀_le).hom
      let r₁ := (g_X.appLE U₀ V₁ hV₁_le).hom
      let r₀₁ := (g_X.appLE U₀ (V₀ ⊓ V₁) (inf_le_of_left_le hV₀_le)).hom
      let res₀ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
      let res₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
      ∀ (x₀ : ↑(Y.presheaf.obj (Opposite.op V₀))) (x₁ : ↑(Y.presheaf.obj (Opposite.op V₁))),
        x₀ ^ 2 - x₀ ∈ Ideal.map r₀ m₀ →
        x₁ ^ 2 - x₁ ∈ Ideal.map r₁ m₀ →
        res₀ x₀ - res₁ x₁ ∈ Ideal.map r₀₁ m₀ →
        (x₀ ∈ Ideal.map r₀ m₀ ∧ x₁ ∈ Ideal.map r₁ m₀) ∨
          (1 - x₀ ∈ Ideal.map r₀ m₀ ∧ 1 - x₁ ∈ Ideal.map r₁ m₀)) :
    ConnectedSpace ↥{y : Y | g_X.base y = x} :=
by
  let F_Y : Set Y := {y : Y | g_X.base y = x}
  let R₀ := ↑(X.presheaf.obj (Opposite.op U₀))
  let p₀ : PrimeSpectrum R₀ := hAffU₀.primeIdealOf ⟨x, hxU₀⟩
  let m₀ : Ideal R₀ := p₀.asIdeal
  let hV₀₁_le : V₀ ⊓ V₁ ≤ (TopologicalSpace.Opens.map g_X.base).obj U₀ :=
    inf_le_of_left_le hV₀_le
  let B₀ := ↑(Y.presheaf.obj (Opposite.op V₀))
  let B₁ := ↑(Y.presheaf.obj (Opposite.op V₁))
  let B₀₁ := ↑(Y.presheaf.obj (Opposite.op (V₀ ⊓ V₁)))
  let r₀ : R₀ →+* B₀ := (g_X.appLE U₀ V₀ hV₀_le).hom
  let r₁ : R₀ →+* B₁ := (g_X.appLE U₀ V₁ hV₁_le).hom
  let r₀₁ : R₀ →+* B₀₁ := (g_X.appLE U₀ (V₀ ⊓ V₁) hV₀₁_le).hom
  let res₀ : B₀ →+* B₀₁ :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
  let res₁ : B₁ →+* B₀₁ :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
  let J₀ : Ideal B₀ := Ideal.map r₀ m₀
  let J₁ : Ideal B₁ := Ideal.map r₁ m₀
  let J₀₁ : Ideal B₀₁ := Ideal.map r₀₁ m₀
  let π₀ := Ideal.Quotient.mk J₀
  let π₁ := Ideal.Quotient.mk J₁
  let π₀₁ := Ideal.Quotient.mk J₀₁
  have hMax : m₀.IsMaximal := hAffU₀.primeIdealOf_isMaximal_of_isClosed ⟨x, hxU₀⟩ hClx
  have hp₀_fromSpec : hAffU₀.fromSpec p₀ = x := hAffU₀.fromSpec_primeIdealOf ⟨x, hxU₀⟩
  have hInjU₀ : Function.Injective ⇑hAffU₀.fromSpec :=
    hAffU₀.fromSpec.isOpenEmbedding.toIsEmbedding.injective
  have hr₀_comp : res₀.comp r₀ = r₀₁ := by
    change (g_X.appLE U₀ V₀ hV₀_le ≫ Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom = r₀₁
    rw [g_X.appLE_map]
  have hr₁_comp : res₁.comp r₁ = r₀₁ := by
    change (g_X.appLE U₀ V₁ hV₁_le ≫ Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom = r₀₁
    rw [g_X.appLE_map]
  have hJ₀_le : J₀ ≤ Ideal.comap res₀ J₀₁ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, hr₀_comp]
    exact Ideal.le_comap_map
  have hJ₁_le : J₁ ≤ Ideal.comap res₁ J₀₁ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, hr₁_comp]
    exact Ideal.le_comap_map
  let resbar₀ : B₀ ⧸ J₀ →+* B₀₁ ⧸ J₀₁ := Ideal.quotientMap J₀₁ res₀ hJ₀_le
  let resbar₁ : B₁ ⧸ J₁ →+* B₀₁ ⧸ J₀₁ := Ideal.quotientMap J₀₁ res₁ hJ₁_le
  have hLand : ∀ (V : Y.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hV_le : V ≤ (TopologicalSpace.Opens.map g_X.base).obj U₀)
      (q : PrimeSpectrum (↑(Y.presheaf.obj (Opposite.op V)) ⧸
        Ideal.map (g_X.appLE U₀ V hV_le).hom m₀)),
      hAffV.fromSpec (PrimeSpectrum.comap
        (Ideal.Quotient.mk (Ideal.map (g_X.appLE U₀ V hV_le).hom m₀)) q) ∈ F_Y := by
    intro V hAffV hV_le q
    let r_V := (g_X.appLE U₀ V hV_le).hom
    let J_V := Ideal.map r_V m₀
    let π_V := Ideal.Quotient.mk J_V
    let P := PrimeSpectrum.comap π_V q
    have hJV_le : J_V ≤ P.asIdeal := by
      intro b hb
      change π_V b ∈ q.asIdeal
      rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hb]
      exact q.asIdeal.zero_mem
    have hm₀_le : m₀ ≤ Ideal.comap r_V P.asIdeal :=
      Ideal.map_le_iff_le_comap.mp hJV_le
    have hPrimeComap : (Ideal.comap r_V P.asIdeal).IsPrime :=
      Ideal.IsPrime.comap r_V
    have hm₀_eq : m₀ = Ideal.comap r_V P.asIdeal :=
      hMax.eq_of_le hPrimeComap.ne_top hm₀_le
    have hComapEq : PrimeSpectrum.comap r_V P = p₀ :=
      PrimeSpectrum.ext hm₀_eq.symm
    let P' : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op V))) := P
    have hComm : (AlgebraicGeometry.Spec.map (g_X.appLE U₀ V hV_le) ≫ hAffU₀.fromSpec) P' =
        (hAffV.fromSpec ≫ g_X) P' :=
      congrArg (fun k => k P') (hAffU₀.SpecMap_appLE_fromSpec g_X hAffV hV_le)
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Spec.map_apply,
      AlgebraicGeometry.Scheme.Hom.comp_apply] at hComm
    change g_X (hAffV.fromSpec P') = x
    rw [← hComm]
    change hAffU₀.fromSpec (PrimeSpectrum.comap r_V P) = x
    rw [hComapEq, hp₀_fromSpec]
  have hSurj : ∀ (V : Y.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hV_le : V ≤ (TopologicalSpace.Opens.map g_X.base).obj U₀)
      (z : ↥F_Y), z.1 ∈ V →
      ∃ q : PrimeSpectrum (↑(Y.presheaf.obj (Opposite.op V)) ⧸
        Ideal.map (g_X.appLE U₀ V hV_le).hom m₀),
        hAffV.fromSpec (PrimeSpectrum.comap
          (Ideal.Quotient.mk (Ideal.map (g_X.appLE U₀ V hV_le).hom m₀)) q) = z.1 := by
    intro V hAffV hV_le z hzV
    let B_V := ↑(Y.presheaf.obj (Opposite.op V))
    let r_V := (g_X.appLE U₀ V hV_le).hom
    let J_V := Ideal.map r_V m₀
    let π_V := Ideal.Quotient.mk J_V
    have hzRange : z.1 ∈ Set.range ⇑hAffV.fromSpec := by
      rw [hAffV.range_fromSpec]
      exact hzV
    obtain ⟨P, hPz⟩ := hzRange
    have hComm := congrArg (fun k => k P) (hAffU₀.SpecMap_appLE_fromSpec g_X hAffV hV_le)
    simp only [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Spec.map_apply] at hComm
    have hFromEq : hAffU₀.fromSpec (PrimeSpectrum.comap r_V P) = hAffU₀.fromSpec p₀ := by
      calc hAffU₀.fromSpec (PrimeSpectrum.comap r_V P)
          = g_X (hAffV.fromSpec P) := hComm
        _ = g_X z.1 := by rw [hPz]
        _ = x := z.2
        _ = hAffU₀.fromSpec p₀ := hp₀_fromSpec.symm
    have hComapEq : PrimeSpectrum.comap r_V P = p₀ := hInjU₀ hFromEq
    have hm₀_le : m₀ ≤ Ideal.comap r_V P.asIdeal := by
      have hId : Ideal.comap r_V P.asIdeal = m₀ := congrArg PrimeSpectrum.asIdeal hComapEq
      exact hId.symm.le
    have hJV_le : J_V ≤ P.asIdeal := Ideal.map_le_iff_le_comap.mpr hm₀_le
    have hMemZero : P ∈ PrimeSpectrum.zeroLocus (J_V : Set B_V) :=
      (PrimeSpectrum.mem_zeroLocus P (J_V : Set B_V)).mpr hJV_le
    rw [← Ideal.mk_ker (I := J_V),
      ← range_comap_of_surjective (B_V ⧸ J_V) π_V Ideal.Quotient.mk_surjective] at hMemZero
    obtain ⟨q, hqP⟩ := hMemZero
    exact ⟨q, by rw [hqP, hPz]⟩
  let γ₀ : PrimeSpectrum (B₀ ⧸ J₀) → ↥F_Y := fun q =>
    ⟨hAff₀.fromSpec (PrimeSpectrum.comap π₀ q), hLand V₀ hAff₀ hV₀_le q⟩
  let γ₁ : PrimeSpectrum (B₁ ⧸ J₁) → ↥F_Y := fun q =>
    ⟨hAff₁.fromSpec (PrimeSpectrum.comap π₁ q), hLand V₁ hAff₁ hV₁_le q⟩
  let γ₀₁ : PrimeSpectrum (B₀₁ ⧸ J₀₁) → ↥F_Y := fun q =>
    ⟨hAff₀₁.fromSpec (PrimeSpectrum.comap π₀₁ q), hLand (V₀ ⊓ V₁) hAff₀₁ hV₀₁_le q⟩
  have hCont₀ : Continuous γ₀ :=
    Continuous.subtype_mk (hAff₀.fromSpec.continuous.comp (PrimeSpectrum.continuous_comap π₀)) _
  have hCont₁ : Continuous γ₁ :=
    Continuous.subtype_mk (hAff₁.fromSpec.continuous.comp (PrimeSpectrum.continuous_comap π₁)) _
  have hMapFromSpec : ∀ (W V : Y.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hAffW : AlgebraicGeometry.IsAffineOpen W) (hle : W ≤ V)
      (P : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op W))),
      hAffV.fromSpec.base (PrimeSpectrum.comap (Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom P) =
        hAffW.fromSpec.base P := by
    intro W V hAffV hAffW hle P
    let f := Y.presheaf.map (CategoryTheory.homOfLE hle).op
    let P' : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op W))) := P
    have h1 : (AlgebraicGeometry.Spec.map f ≫ hAffV.fromSpec) P' = hAffW.fromSpec P' :=
      congrArg (fun k => k P') (hAffV.map_fromSpec hAffW (CategoryTheory.homOfLE hle).op)
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Spec.map_apply] at h1
    exact h1
  have hγ₀_comp : ∀ q : PrimeSpectrum (B₀₁ ⧸ J₀₁),
      γ₀ (PrimeSpectrum.comap resbar₀ q) = γ₀₁ q := by
    intro q
    apply Subtype.ext
    change hAff₀.fromSpec.base (PrimeSpectrum.comap π₀ (PrimeSpectrum.comap resbar₀ q)) =
      hAff₀₁.fromSpec.base (PrimeSpectrum.comap π₀₁ q)
    have hComap : PrimeSpectrum.comap π₀ (PrimeSpectrum.comap resbar₀ q) =
        PrimeSpectrum.comap res₀ (PrimeSpectrum.comap π₀₁ q) := by
      rw [← PrimeSpectrum.comap_comp_apply, Ideal.quotientMap_comp_mk,
        PrimeSpectrum.comap_comp_apply]
    rw [hComap]
    exact hMapFromSpec (V₀ ⊓ V₁) V₀ hAff₀ hAff₀₁ inf_le_left (PrimeSpectrum.comap π₀₁ q)
  have hγ₁_comp : ∀ q : PrimeSpectrum (B₀₁ ⧸ J₀₁),
      γ₁ (PrimeSpectrum.comap resbar₁ q) = γ₀₁ q := by
    intro q
    apply Subtype.ext
    change hAff₁.fromSpec.base (PrimeSpectrum.comap π₁ (PrimeSpectrum.comap resbar₁ q)) =
      hAff₀₁.fromSpec.base (PrimeSpectrum.comap π₀₁ q)
    have hComap : PrimeSpectrum.comap π₁ (PrimeSpectrum.comap resbar₁ q) =
        PrimeSpectrum.comap res₁ (PrimeSpectrum.comap π₀₁ q) := by
      rw [← PrimeSpectrum.comap_comp_apply, Ideal.quotientMap_comp_mk,
        PrimeSpectrum.comap_comp_apply]
    rw [hComap]
    exact hMapFromSpec (V₀ ⊓ V₁) V₁ hAff₁ hAff₀₁ inf_le_right (PrimeSpectrum.comap π₀₁ q)
  rw [connectedSpace_iff_clopen]
  refine ⟨hFibNe, fun S hS => ?_⟩
  obtain ⟨e₀, he₀, hS₀⟩ := PrimeSpectrum.isClopen_iff.mp (hS.preimage hCont₀)
  obtain ⟨e₁, he₁, hS₁⟩ := PrimeSpectrum.isClopen_iff.mp (hS.preimage hCont₁)
  obtain ⟨x₀, hx₀_mk⟩ := Ideal.Quotient.mk_surjective e₀
  obtain ⟨x₁, hx₁_mk⟩ := Ideal.Quotient.mk_surjective e₁
  have hx₀_idem : x₀ ^ 2 - x₀ ∈ J₀ := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change π₀ (x₀ ^ 2 - x₀) = 0
    rw [map_sub, map_pow, sq, hx₀_mk, he₀.eq, sub_self]
  have hx₁_idem : x₁ ^ 2 - x₁ ∈ J₁ := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change π₁ (x₁ ^ 2 - x₁) = 0
    rw [map_sub, map_pow, sq, hx₁_mk, he₁.eq, sub_self]
  have hBasicEq : PrimeSpectrum.basicOpen (resbar₀ e₀) = PrimeSpectrum.basicOpen (resbar₁ e₁) := by
    rw [SetLike.ext_iff]
    intro q
    have hL : q ∈ PrimeSpectrum.basicOpen (resbar₀ e₀) ↔ γ₀₁ q ∈ S := by
      change resbar₀ e₀ ∉ q.asIdeal ↔ γ₀₁ q ∈ S
      change PrimeSpectrum.comap resbar₀ q ∈ (PrimeSpectrum.basicOpen e₀ : Set (PrimeSpectrum (B₀ ⧸ J₀))) ↔
        γ₀₁ q ∈ S
      rw [← hS₀]
      change γ₀ (PrimeSpectrum.comap resbar₀ q) ∈ S ↔ γ₀₁ q ∈ S
      rw [hγ₀_comp q]
    have hR : q ∈ PrimeSpectrum.basicOpen (resbar₁ e₁) ↔ γ₀₁ q ∈ S := by
      change resbar₁ e₁ ∉ q.asIdeal ↔ γ₀₁ q ∈ S
      change PrimeSpectrum.comap resbar₁ q ∈ (PrimeSpectrum.basicOpen e₁ : Set (PrimeSpectrum (B₁ ⧸ J₁))) ↔
        γ₀₁ q ∈ S
      rw [← hS₁]
      change γ₁ (PrimeSpectrum.comap resbar₁ q) ∈ S ↔ γ₀₁ q ∈ S
      rw [hγ₁_comp q]
    exact hL.trans hR.symm
  have he_eq : resbar₀ e₀ = resbar₁ e₁ :=
    PrimeSpectrum.basicOpen_injOn_isIdempotentElem (he₀.map resbar₀) (he₁.map resbar₁) hBasicEq
  have hx₀₁_compat : res₀ x₀ - res₁ x₁ ∈ J₀₁ := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change π₀₁ (res₀ x₀ - res₁ x₁) = 0
    rw [map_sub, sub_eq_zero]
    have h1 : resbar₀ (π₀ x₀) = resbar₁ (π₁ x₁) := by rw [hx₀_mk, hx₁_mk, he_eq]
    dsimp only [resbar₀, resbar₁, π₀, π₁, π₀₁] at h1 ⊢
    simpa only [Ideal.quotientMap_mk] using h1
  have hz_cov : ∀ z : ↥F_Y, z.1 ∈ V₀ ∨ z.1 ∈ V₁ := by
    intro z
    have hzTop : z.1 ∈ (⊤ : Y.Opens) := trivial
    rw [← hCov, TopologicalSpace.Opens.mem_sup] at hzTop
    exact hzTop
  rcases hRig x₀ x₁ hx₀_idem hx₁_idem hx₀₁_compat with ⟨hx₀_mem, hx₁_mem⟩ | ⟨hx₀_one, hx₁_one⟩
  · left
    rw [Set.eq_empty_iff_forall_notMem]
    intro z hzS
    have he₀_zero : e₀ = 0 := by
      rw [← hx₀_mk]
      exact (Ideal.Quotient.eq_zero_iff_mem).mpr hx₀_mem
    have he₁_zero : e₁ = 0 := by
      rw [← hx₁_mk]
      exact (Ideal.Quotient.eq_zero_iff_mem).mpr hx₁_mem
    rw [he₀_zero, PrimeSpectrum.basicOpen_zero, TopologicalSpace.Opens.coe_bot] at hS₀
    rw [he₁_zero, PrimeSpectrum.basicOpen_zero, TopologicalSpace.Opens.coe_bot] at hS₁
    rcases hz_cov z with hzV₀ | hzV₁
    · obtain ⟨q₀, hq₀⟩ := hSurj V₀ hAff₀ hV₀_le z hzV₀
      have hq₀_eq : γ₀ q₀ = z := Subtype.ext hq₀
      have hq₀_mem : q₀ ∈ γ₀ ⁻¹' S := by
        change γ₀ q₀ ∈ S
        rw [hq₀_eq]
        exact hzS
      rw [hS₀] at hq₀_mem
      exact hq₀_mem
    · obtain ⟨q₁, hq₁⟩ := hSurj V₁ hAff₁ hV₁_le z hzV₁
      have hq₁_eq : γ₁ q₁ = z := Subtype.ext hq₁
      have hq₁_mem : q₁ ∈ γ₁ ⁻¹' S := by
        change γ₁ q₁ ∈ S
        rw [hq₁_eq]
        exact hzS
      rw [hS₁] at hq₁_mem
      exact hq₁_mem
  · right
    rw [Set.eq_univ_iff_forall]
    intro z
    have he₀_one : e₀ = 1 := by
      have h0 : 1 - e₀ = 0 := by
        rw [← hx₀_mk, ← map_one π₀, ← map_sub]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr hx₀_one
      exact (sub_eq_zero.mp h0).symm
    have he₁_one : e₁ = 1 := by
      have h0 : 1 - e₁ = 0 := by
        rw [← hx₁_mk, ← map_one π₁, ← map_sub]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr hx₁_one
      exact (sub_eq_zero.mp h0).symm
    rw [he₀_one, PrimeSpectrum.basicOpen_one, TopologicalSpace.Opens.coe_top] at hS₀
    rw [he₁_one, PrimeSpectrum.basicOpen_one, TopologicalSpace.Opens.coe_top] at hS₁
    rcases hz_cov z with hzV₀ | hzV₁
    · obtain ⟨q₀, hq₀⟩ := hSurj V₀ hAff₀ hV₀_le z hzV₀
      have hq₀_eq : γ₀ q₀ = z := Subtype.ext hq₀
      have hq₀_mem : q₀ ∈ γ₀ ⁻¹' S := by
        rw [hS₀]
        trivial
      rw [← hq₀_eq]
      exact hq₀_mem
    · obtain ⟨q₁, hq₁⟩ := hSurj V₁ hAff₁ hV₁_le z hzV₁
      have hq₁_eq : γ₁ q₁ = z := Subtype.ext hq₁
      have hq₁_mem : q₁ ∈ γ₁ ⁻¹' S := by
        rw [hS₁]
        trivial
      rw [← hq₁_eq]
      exact hq₁_mem

theorem weil_projective_birational_normal_closed_fiber_connected (k : Type u) [Field k] [IsAlgClosed k]
    (T X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntT : AlgebraicGeometry.IsIntegral T.left)
    (hProjT : IsProjectiveOverField k T)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (π : T ⟶ X)
    (U_iso : X.left.Opens)
    (hUiso : Nonempty U_iso)
    (hIsoU : CategoryTheory.IsIso (π.left ∣_ U_iso))
    (x : X.left)
    (hClx : IsClosed ({x} : Set X.left))
    (hNormx : ∃ (U : X.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧
      IsDomain ↑(X.left.presheaf.obj (Opposite.op U)) ∧
      IsIntegrallyClosed ↑(X.left.presheaf.obj (Opposite.op U)))
    (hDimFib : topologicalKrullDim ↥{t : T.left | π.left.base t = x} ≤ (1 : WithBot ℕ∞)) :
    ConnectedSpace ↥{t : T.left | π.left.base t = x} :=
by
  
  have hProjSpaceProper : ∀ d : ℕ, AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k d).hom := by
    intro d
    let 𝒜_d := MvPolynomial.homogeneousSubmodule (Fin (d + 1)) k
    letI : GradedAlgebra 𝒜_d := MvPolynomial.gradedAlgebra
    have hBij : Function.Bijective (algebraMap k ↥(𝒜_d 0)) := by
      refine ⟨fun c₁ c₂ hc => MvPolynomial.C_injective (Fin (d + 1)) k (congrArg Subtype.val hc), fun y => ?_⟩
      rcases y with ⟨p, hp⟩
      dsimp [𝒜_d] at hp
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hp
      obtain ⟨c, rfl⟩ := hp
      exact ⟨c, Subtype.ext rfl⟩
    let e_d : k ≃+* ↥(𝒜_d 0) := RingEquiv.ofBijective (algebraMap k ↥(𝒜_d 0)) hBij
    have hHomEq : CommRingCat.ofHom (algebraMap k ↥(𝒜_d 0)) = e_d.toCommRingCatIso.hom := rfl
    haveI : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_d 0)))) := by
      rw [hHomEq]
      infer_instance
    haveI : IsScalarTower k ↥(𝒜_d 0) (MvPolynomial (Fin (d + 1)) k) :=
      ⟨fun c y p => smul_mul_assoc c (y : MvPolynomial (Fin (d + 1)) k) p⟩
    haveI : Algebra.FiniteType ↥(𝒜_d 0) (MvPolynomial (Fin (d + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    dsimp [weilProjectiveSpaceOver]
    exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
  have hOverProper : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      IsProjectiveOverField k Z → AlgebraicGeometry.IsProper Z.hom := by
    rintro Z ⟨d, ι_Z, hClZ⟩
    haveI : AlgebraicGeometry.IsClosedImmersion ι_Z.left := hClZ
    haveI : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k d).hom := hProjSpaceProper d
    rw [← CategoryTheory.Over.w ι_Z]
    exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
  haveI hPropT : AlgebraicGeometry.IsProper T.hom := hOverProper T hProjT
  haveI hPropX : AlgebraicGeometry.IsProper X.hom := hOverProper X hProjX
  haveI hPropπ : AlgebraicGeometry.IsProper π.left :=
    @AlgebraicGeometry.IsProper.of_comp _ _ _ π.left X.hom
      (by rw [CategoryTheory.Over.w π]; exact hPropT) inferInstance
  haveI : AlgebraicGeometry.IsIntegral T.left := hIntT
  haveI : AlgebraicGeometry.IsIntegral X.left := hIntX
  haveI : CategoryTheory.IsIso (π.left ∣_ U_iso) := hIsoU
  have hIrredX : IrreducibleSpace ↥X.left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral X.left hIntX
  let W_iso : T.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U_iso
  have hSurjπ : Function.Surjective π.left.base := by
    have hSub : (U_iso : Set X.left) ⊆ Set.range π.left.base := by
      intro y hy
      let y' : ↥U_iso.toScheme := ⟨y, hy⟩
      let w : ↥W_iso.toScheme := (inv (π.left ∣_ U_iso)).base y'
      refine ⟨W_iso.ι.base w, ?_⟩
      have h1 : (inv (π.left ∣_ U_iso) ≫ (π.left ∣_ U_iso) ≫ U_iso.ι).base y' = U_iso.ι.base y' := by
        rw [CategoryTheory.IsIso.inv_hom_id_assoc]
      rw [AlgebraicGeometry.morphismRestrict_ι] at h1
      exact h1
    have hDense : Dense (U_iso : Set X.left) := by
      rw [dense_iff_inter_open]
      intro V hV hVne
      obtain ⟨y₀, hy₀⟩ := hVne
      obtain ⟨⟨u₀, hu₀⟩⟩ := hUiso
      have hInter := hIrredX.isPreirreducible_univ V (U_iso : Set X.left) hV U_iso.isOpen
        ⟨y₀, trivial, hy₀⟩ ⟨u₀, trivial, hu₀⟩
      obtain ⟨z, _, hzV, hzU⟩ := hInter
      exact ⟨z, hzV, hzU⟩
    have hClRange : IsClosed (Set.range π.left.base) := by
      rw [← Set.image_univ]
      exact π.left.isClosedMap _ isClosed_univ
    have hClSub : closure (U_iso : Set X.left) ⊆ Set.range π.left.base :=
      hClRange.closure_subset_iff.mpr hSub
    rw [hDense.closure_eq] at hClSub
    exact Set.range_eq_univ.mp (Set.eq_univ_of_univ_subset hClSub)
  obtain ⟨t_x, htx⟩ := hSurjπ x
  
  obtain ⟨N, ι_T, hClT⟩ := hProjT
  haveI : AlgebraicGeometry.IsClosedImmersion ι_T.left := hClT
  haveI hAffHomιT : AlgebraicGeometry.IsAffineHom ι_T.left :=
    AlgebraicGeometry.IsClosedImmersion.instIsAffineHom ι_T.left
  let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
  let P_k : AlgebraicGeometry.Scheme.{u} := (weilProjectiveSpaceOver k N).left
  let F_x : Set T.left := {t : T.left | π.left.base t = x}
  have hClosedFx : IsClosed F_x := hClx.preimage π.left.base.hom.continuous
  let S₀ : Set P_k := ι_T.left.base '' F_x
  let p₀ : P_k := ι_T.left.base t_x
  have hp₀ : p₀ ∈ S₀ := ⟨t_x, htx, rfl⟩
  have hClosedEmbT : Topology.IsClosedEmbedding ι_T.left.base := hClT.isClosedEmbedding
  have hClosedS₀ : IsClosed S₀ := hClosedEmbT.isClosedMap _ hClosedFx
  have hDimS₀ : topologicalKrullDim ↥S₀ ≤ (1 : WithBot ℕ∞) := by
    let f_emb : ↥F_x → ↥S₀ := fun z => ⟨ι_T.left.base z.1, ⟨z.1, z.2, rfl⟩⟩
    have hf_bij : Function.Bijective f_emb := by
      refine ⟨fun a b hab => Subtype.ext (hClosedEmbT.injective (congrArg Subtype.val hab)), ?_⟩
      rintro ⟨_, t, ht, rfl⟩
      exact ⟨⟨t, ht⟩, rfl⟩
    let e_emb : ↥F_x ≃ ↥S₀ := Equiv.ofBijective f_emb hf_bij
    have hComp : (ι_T.left.base ∘ (Subtype.val : ↥F_x → T.left)) ∘ e_emb.symm =
        (Subtype.val : ↥S₀ → P_k) := by
      ext z
      change (f_emb (e_emb.symm z)).1 = z.1
      exact congrArg Subtype.val (e_emb.apply_symm_apply z)
    have hIndL : Topology.IsInducing (ι_T.left.base ∘ (Subtype.val : ↥F_x → T.left)) :=
      hClosedEmbT.isInducing.comp Topology.IsInducing.subtypeVal
    have hIndSymm : Topology.IsInducing e_emb.symm :=
      (Topology.IsInducing.of_comp_iff hIndL).mp
        (by rw [hComp]; exact Topology.IsInducing.subtypeVal)
    exact le_trans hIndSymm.topologicalKrullDim_le hDimFib
  haveI : Infinite k := IsAlgClosed.instInfinite
  obtain ⟨L₀, L₁, hL₀, hL₁, hp₀_L₀, hp₀_L₁, hSubS₀⟩ :=
    weil_proj_infinite_field_two_hyperplane_avoidance_with_point k N S₀ p₀ hp₀ hClosedS₀ hDimS₀
  let D₀ : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k L₀
  let D₁ : P_k.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_k L₁
  let W_cov : T.left.Opens := (TopologicalSpace.Opens.map ι_T.left.base).obj (D₀ ⊔ D₁)
  let Z_bad : Set X.left := π.left.base '' ((W_cov : Set T.left)ᶜ)
  have hClosedZbad : IsClosed Z_bad := π.left.isClosedMap _ W_cov.isOpen.isClosed_compl
  have hxNotZbad : x ∉ Z_bad := by
    rintro ⟨t, htNot, hπt⟩
    have htS₀ : ι_T.left.base t ∈ S₀ := ⟨t, hπt, rfl⟩
    have htCov : ι_T.left.base t ∈ (D₀ : Set P_k) ∪ (D₁ : Set P_k) := hSubS₀ htS₀
    exact htNot htCov
  obtain ⟨U, hAffU, hxU, hDomU, hICU⟩ := hNormx
  let U_good : X.left.Opens := U ⊓ ⟨Z_badᶜ, hClosedZbad.isOpen_compl⟩
  have hxUgood : x ∈ U_good := ⟨hxU, hxNotZbad⟩
  obtain ⟨g, hg_mem, hxU₀_tmp⟩ := hAffU.exists_basicOpen_le ⟨x, hxUgood⟩ hxU
  let U₀ : X.left.Opens := X.left.basicOpen g
  have hU₀_le_good : U₀ ≤ U_good := hg_mem
  have hxU₀ : x ∈ U₀ := hxU₀_tmp
  have hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hAffU.basicOpen g
  
  let R₀ : Type u := ↑(X.left.presheaf.obj (Opposite.op U₀))
  haveI hNeU₀ : Nonempty ↥U₀ := ⟨⟨x, hxU₀⟩⟩
  haveI hDomR₀ : IsDomain R₀ :=
    @AlgebraicGeometry.IsIntegral.component_integral X.left hIntX U₀ hNeU₀
  haveI : IsDomain ↑(X.left.presheaf.obj (Opposite.op U)) := hDomU
  haveI : IsIntegrallyClosed ↑(X.left.presheaf.obj (Opposite.op U)) := hICU
  have hg_ne : g ≠ 0 := by
    intro hg0
    have hx_bot : x ∈ (⊥ : X.left.Opens) := by
      have : U₀ = ⊥ := by simp [U₀, hg0]
      rwa [← this]
    exact False.elim hx_bot
  haveI hLocU₀ : IsLocalization.Away g R₀ := hAffU.isLocalization_basicOpen g
  have hSubNzd : Submonoid.powers g ≤ nonZeroDivisors ↑(X.left.presheaf.obj (Opposite.op U)) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg_ne)
  haveI hICR₀ : IsIntegrallyClosed R₀ :=
    isIntegrallyClosed_of_isLocalization (S := R₀) (Submonoid.powers g) hSubNzd
  haveI hNoethR₀ : IsNoetherianRing R₀ := by
    let φ_k : CommRingCat.of k ⟶ X.left.presheaf.obj (Opposite.op U₀) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        X.hom.appLE ⊤ U₀ le_top
    letI : Algebra k R₀ := φ_k.hom.toAlgebra
    have hFT : φ_k.hom.FiniteType := by
      have h1 : (X.hom.appLE ⊤ U₀ le_top).hom.FiniteType :=
        X.hom.finiteType_appLE (U := ⊤) (V := U₀)
          (isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of k))) hAffU₀ le_top
      have h2 : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom.FiniteType :=
        RingHom.FiniteType.of_surjective _
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.symm.surjective)
      exact h1.comp h2
    haveI : Algebra.FiniteType k R₀ := hFT
    exact Algebra.FiniteType.isNoetherianRing k R₀
  let W : T.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U₀
  let Y : AlgebraicGeometry.Scheme.{u} := W.toScheme
  let g_X : Y ⟶ X.left := W.ι ≫ π.left
  let gProj : Y ⟶ P_k := W.ι ≫ ι_T.left
  let p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) := (π.left ∣_ U₀) ≫ U₀.toSpecΓ
  have hToSpecIso : U₀.toSpecΓ = hAffU₀.isoSpec.hom := rfl
  haveI : CategoryTheory.IsIso U₀.toSpecΓ := by
    rw [hToSpecIso]
    infer_instance
  haveI hPropP : AlgebraicGeometry.IsProper p :=
    CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
  
  have hAffPre : ∀ (D : P_k.Opens), AlgebraicGeometry.IsAffineOpen D →
