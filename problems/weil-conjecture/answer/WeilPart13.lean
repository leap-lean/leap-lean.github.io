        AlgebraicGeometry.IsIntegral C_a :=
by
  refine ⟨?_, ?_⟩
  · obtain ⟨N₃, ι_B, hCl_ι⟩ := hProjB₃
    haveI : AlgebraicGeometry.IsClosedImmersion ι_B.left := hCl_ι
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k) :=
      MvPolynomial.gradedAlgebra
    have h_surj : Function.Surjective
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k 0)) := by
      intro p
      have hp : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N₃ + 1)) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (N₃ + 1)) (R := k)]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp
      exact ⟨c, Subtype.ext hc⟩
    have h_ft_zero :
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ h_surj
    have h_ft_k_A : (algebraMap k (MvPolynomial (Fin (N₃ + 1)) k)).FiniteType :=
      RingHom.finiteType_algebraMap.mpr inferInstance
    have h_comp :
        (algebraMap (↥(MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k 0))
          (MvPolynomial (Fin (N₃ + 1)) k)).comp
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k 0)) =
        algebraMap k (MvPolynomial (Fin (N₃ + 1)) k) := by
      ext x
      rfl
    haveI h_alg_ft : Algebra.FiniteType
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k 0))
        (MvPolynomial (Fin (N₃ + 1)) k) :=
      RingHom.finiteType_algebraMap.mp
        (RingHom.FiniteType.of_comp_finiteType (h_comp.symm ▸ h_ft_k_A))
    let f₂_proj := AlgebraicGeometry.Proj.toSpecZero
      (MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k)
    let f₃_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k 0)))
    have h1_ft : AlgebraicGeometry.LocallyOfFiniteType ι_B.left :=
      AlgebraicGeometry.instLocallyOfFiniteTypeOfIsClosedImmersion ι_B.left
    have h2_ft : AlgebraicGeometry.LocallyOfFiniteType f₂_proj :=
      AlgebraicGeometry.Proj.instLocallyOfFiniteTypeToSpecZeroOfFiniteTypeSubtypeMemOfNatNat
        (MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k)
    have h3_ft : AlgebraicGeometry.LocallyOfFiniteType f₃_spec :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr h_ft_zero
