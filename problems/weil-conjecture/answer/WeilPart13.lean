    let : Algebra R₀ A₀ := f₀.toAlgebra
    have : Module.Flat R₀ A₀ := hFlat₀
    have : Algebra.FinitePresentation R₀ A₀ := hFP₀
    let : Field K_in := instFieldK
    let : Algebra R₀ K_in := toK.toAlgebra
    obtain ⟨f, hf, hSmAway⟩ :=
      @h_s2_s3 R₀ A₀ _ _ _ _ _ K_in _ _ q₀ q_K hq_K h_K hh_K hSmRelK
    exact h_s4 U_S hAffS U_C hAffC hLE q₀ hq₀_x f hf hSmAway
  · exact Or.inr ⟨U_S, hAffS, U_C, hAffC, hLE, q₀, hp₀_gx, hq₀_x, hFlat₀, hFP₀, hNode₀⟩

theorem weil_geom_nodal_roof_residue_separable_and_mod_cube_iso (κ₀ F₀ K D_K : Type u) [Field κ₀] [CommRing F₀] [Field K] [IsAlgClosed K] [CommRing D_K]
    [Algebra κ₀ F₀] [Algebra.FiniteType κ₀ F₀] [Algebra κ₀ K] [Algebra.IsAlgebraic κ₀ K]
    (m₀ : PrimeSpectrum D_K)
    (ψ₁ : TensorProduct κ₀ K F₀ →+* D_K)
    (ψ₂ : (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D_K)
    (hψ₁ : ψ₁.Etale)
    (hψ₂ : ψ₂.Etale)
    (hXi : ∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ m₀.asIdeal)
    (hcomm_K : ψ₁.comp (algebraMap K (TensorProduct κ₀ K F₀)) =
      ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) :
    ∃ (E₁ : Type u) (_ : Field E₁) (_ : Algebra κ₀ E₁)
      (_ : FiniteDimensional κ₀ E₁) (_ : Algebra.IsSeparable κ₀ E₁)
      (π₁ : F₀ →ₐ[κ₀] E₁) (j₁ : E₁ →ₐ[κ₀] K),
      Function.Surjective π₁ ∧
      (∀ x : F₀,
        ψ₁ (Algebra.TensorProduct.includeRight x) -
          ψ₁ (algebraMap K (TensorProduct κ₀ K F₀) (j₁ (π₁ x))) ∈ m₀.asIdeal) ∧
      Ideal.comap ψ₁ m₀.asIdeal =
        RingHom.ker (Algebra.TensorProduct.lift (AlgHom.id K K) (j₁.comp π₁)
          (fun _ _ => mul_comm _ _)).toRingHom ∧
      (let q_K : Ideal (TensorProduct κ₀ K F₀) := Ideal.comap ψ₁ m₀.asIdeal
       let I_cube : Ideal (TensorProduct κ₀ K F₀) := q_K ^ 3
       let J_std : Ideal (MvPolynomial (Fin 2) K) :=
         Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) * MvPolynomial.X 1} ⊔
           Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K), MvPolynomial.X 1} ^ 3
       ∃ Φ_K : (TensorProduct κ₀ K F₀ ⧸ I_cube) ≃+* (MvPolynomial (Fin 2) K ⧸ J_std),
         ∀ c : K,
           Φ_K (Ideal.Quotient.mk I_cube (algebraMap K (TensorProduct κ₀ K F₀) c)) =
             Ideal.Quotient.mk J_std (MvPolynomial.C c)) :=
by
  have h_etale_local : ∀ (A : Type u) [CommRing A] (p_A : Ideal A) [p_A.IsPrime]
      (f : A →+* D_K) (_ : f.Etale) (hp : p_A = Ideal.comap f m₀.asIdeal),
      let A_p := Localization.AtPrime p_A
      let D := Localization.AtPrime m₀.asIdeal
      let θ : A_p →+* D := Localization.localRingHom p_A m₀.asIdeal f hp
      letI : Algebra A_p D := θ.toAlgebra
