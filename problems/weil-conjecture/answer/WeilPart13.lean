    exact ⟨⟨x₀, hx₀A, hx₀B⟩⟩

  let α_Y : U'_Y.toScheme ⟶ Y'.left := e_pb.hom ≫ j.toImage
  haveI : AlgebraicGeometry.IsOpenImmersion j.toImage := inferInstance
  haveI : AlgebraicGeometry.IsOpenImmersion α_Y := by
    dsimp [α_Y]
    infer_instance
  have hαY_q : α_Y ≫ q'.left = U'_Y.ι := by
    change (s_pb ≫ j.toImage) ≫ (ι_Y' ≫ fst_P) = U'_Y.ι
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j.toImage,
      AlgebraicGeometry.Scheme.Hom.toImage_imageι j, ← CategoryTheory.Category.assoc, hs_snd]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  obtain ⟨Z₀, hAffZ₀_raw, hu₀_Z₀, hZ₀_le⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.left.isBasis_affineOpens u₀.2
  let Z₀ : Y.left.Opens := Z₀
  have hAffZ₀ : AlgebraicGeometry.IsAffineOpen Z₀ := hAffZ₀_raw
  have hRange_Z₀ : Set.range hAffZ₀.fromSpec.base ⊆ Set.range U'_Y.ι.base := by
    rw [hAffZ₀.range_fromSpec, U'_Y.range_ι]
    exact hZ₀_le
  let ℓ₀ : AlgebraicGeometry.Spec (Y.left.presheaf.obj (Opposite.op Z₀)) ⟶ U'_Y.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U'_Y.ι hAffZ₀.fromSpec hRange_Z₀
  have hℓ₀_fac : ℓ₀ ≫ U'_Y.ι = hAffZ₀.fromSpec :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U'_Y.ι hAffZ₀.fromSpec hRange_Z₀
  haveI : AlgebraicGeometry.IsOpenImmersion ℓ₀ := by
    haveI : AlgebraicGeometry.IsOpenImmersion (ℓ₀ ≫ U'_Y.ι) := by
