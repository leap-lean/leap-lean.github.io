    obtain ⟨t₂, c₀, ht₂, hc₀, hj_clear⟩ := h_map_dc j'_F hj'_F
    have hw₀_not : w₀ ∉ q₁.asIdeal := by
      intro hw₀_in
      apply hd_F
      have ht₁_ne : algebraMap R₁ κ₁ t₁ ≠ 0 :=
        mt Ideal.algebraMap_residueField_eq_zero.mp ht₁
      have hu_t₁ : IsUnit (toκ₁ (algebraMap R₁ κ₁ t₁)) := (IsUnit.mk0 _ ht₁_ne).map toκ₁
      obtain ⟨u_inv, hu_inv⟩ := hu_t₁.exists_left_inv
      have hd_eq : d_F = u_inv * toF₁ w₀ := by
        calc
          d_F = 1 * d_F := (one_mul _).symm
          _ = (u_inv * toκ₁ (algebraMap R₁ κ₁ t₁)) * d_F := by rw [hu_inv]
          _ = u_inv * (toκ₁ (algebraMap R₁ κ₁ t₁) * d_F) := by ring
