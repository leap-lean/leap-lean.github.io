            change S_Ω.mkQ ω = S_Ω.mkQ (ω - π_Ω u)
            have h0 : S_Ω.mkQ (π_Ω u) = 0 := by
              rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
              exact LinearMap.mem_range_self π_Ω u
            rw [map_sub, h0, sub_zero]
          rw [hq_eq]
          have hmap_le : Submodule.map S_Ω.mkQ (𝔪₀ • (⊤ : Submodule L₀ Ω[L₀⁄κ₀])) ≤
