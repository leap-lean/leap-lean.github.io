        rw [Ideal.mem_iInf]
        intro i
        obtain ⟨y, _, hzy⟩ := h_ind i
        rw [Ideal.span_singleton_pow]
        exact Ideal.mem_span_singleton.mpr ⟨y, hzy⟩
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing J₁ hJ₁_ne_top, Ideal.mem_bot] at hz_iInf
      exact Ideal.Quotient.eq_zero_iff_mem.mp hz_iInf
    have hPrime_min : ∀ (t₁ : L'), t₁ ∈ IsLocalRing.maximalIdeal L' →
