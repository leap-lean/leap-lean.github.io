                TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S) * (x₁ - x₂) = 0 by
              exact sub_eq_zero.mp (by rwa [mul_sub] at hsub)
            rw [hs₀, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
            have hts : t.1 * s₀ = π₀ • (t₂.1 * s₁) := by
              calc t.1 * s₀ = t₂.1 * (t₁.1 * s₀) := mul_assoc _ _ _
                _ = t₂.1 * (π_S * s₁) := ht₂
                _ = π_S * (t₂.1 * s₁) := by ring
                _ = π₀ • (t₂.1 * s₁) := (Algebra.smul_def π₀ (t₂.1 * s₁)).symm
            rw [hts, ← TensorProduct.smul_tmul]
            have hπ₀_zero : π₀ • (1 : Polynomial R₀ ⧸ p) = 0 := by
              rw [Algebra.smul_def, mul_one]
              exact Ideal.Quotient.eq_zero_iff_mem.mpr
                (by rw [← hπ₀_span]; exact Ideal.subset_span rfl)
            rw [hπ₀_zero, TensorProduct.zero_tmul]
        haveI : Algebra.Etale (Polynomial R₀ ⧸ p)
            (TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S) := inferInstance
        have hRedArt := h_etale_field (Polynomial R₀ ⧸ p)
          (TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S)
        haveI : _root_.IsReduced (TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S) := hRedArt.1
        haveI : IsArtinianRing (TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S) := hRedArt.2
        haveI : _root_.IsReduced (Localization.AtPrime q ⧸ I_bar) :=
          (h_loc_red _ M_p (Localization.AtPrime q ⧸ I_bar)).2
        haveI : IsArtinianRing (Localization.AtPrime q ⧸ I_bar) :=
          IsArtinianRing.localization_artinian M_p (Localization.AtPrime q ⧸ I_bar)
        have hFieldQ : IsField (Localization.AtPrime q ⧸ I_bar) :=
          IsArtinianRing.isField_of_isReduced_of_isLocalRing (Localization.AtPrime q ⧸ I_bar)
        exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient I_bar).mpr hFieldQ
      have hI_eq_max : I_bar = IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        IsLocalRing.eq_maximalIdeal hI_max
      haveI : NoZeroDivisors (Localization.AtPrime q) := by
        refine ⟨fun {x y} hxy => ?_⟩
        by_contra hnot
        push_neg at hnot
        obtain ⟨hx_ne, hy_ne⟩ := hnot
        have hiInf : (⨅ idx : ℕ, I_bar ^ idx) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing I_bar hI_ne_top
        have hy_not_iInf : y ∉ (⨅ idx : ℕ, I_bar ^ idx) := by
          rw [hiInf]
          exact fun hy_bot => hy_ne (Ideal.mem_bot.mp hy_bot)
        rw [Ideal.mem_iInf] at hy_not_iInf
        push_neg at hy_not_iInf
        classical
        let m : ℕ := Nat.find hy_not_iInf
        have hm_spec : y ∉ I_bar ^ m := Nat.find_spec hy_not_iInf
        have hm_ne_zero : m ≠ 0 := by
          intro hm0
          apply hm_spec
          rw [hm0, pow_zero, Ideal.one_eq_top]
          trivial
        obtain ⟨b, hb⟩ := Nat.exists_eq_succ_of_ne_zero hm_ne_zero
        have hb_lt : b < m := by omega
        have hy_mem_b : y ∈ I_bar ^ b := by
          by_contra hy_not_b
          exact Nat.find_min hy_not_iInf hb_lt hy_not_b
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hy_mem_b
        obtain ⟨u, rfl⟩ := hy_mem_b
        have hu_not_max : u ∉ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          rw [← hI_eq_max, Ideal.mem_span_singleton]
          rintro ⟨v, rfl⟩
          apply hm_spec
          rw [hb, Nat.succ_eq_add_one, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact ⟨v, by ring⟩
