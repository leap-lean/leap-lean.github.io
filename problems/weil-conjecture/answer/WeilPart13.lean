    exact AlgebraicGeometry.IsOpenImmersion.of_comp ℓ₀ U'_Y.ι
  let β₀ : AlgebraicGeometry.Spec (Y.left.presheaf.obj (Opposite.op Z₀)) ⟶ Y'.left := ℓ₀ ≫ α_Y
  haveI : AlgebraicGeometry.IsOpenImmersion β₀ := by
    dsimp [β₀]; infer_instance
  have hβ₀_q : β₀ ≫ q'.left = hAffZ₀.fromSpec := by
    dsimp [β₀]
    rw [CategoryTheory.Category.assoc, hαY_q, hℓ₀_fac]
  let Z'₀ : Y'.left.Opens := β₀.opensRange
  have hAffZ'₀ : AlgebraicGeometry.IsAffineOpen Z'₀ :=
