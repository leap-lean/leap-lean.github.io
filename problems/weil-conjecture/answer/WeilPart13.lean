    have hc := RingHom.congr_fun hComm_lift (algebraMap K B_K c)
    simp only [RingHom.comp_apply] at hc
    rw [hc]
    change ψ'₁ (π_K (c ⊗ₜ[R₁] (1 : B₀))) = algebraMap K D'_K c
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
    exact ψ'₁.commutes c)
  haveI : Algebra.Etale B_K B'_K := by rwa [← RingHom.etale_algebraMap]
  let J_K : Ideal B_K := RingHom.ker π_K.toRingHom
  let f_sub : TensorProduct B_K B'_K ↥J_K →ₗ[B'_K] B'_K :=
    (TensorProduct.AlgebraTensorModule.rid B_K B'_K B'_K).toLinearMap.comp
      (LinearMap.baseChange B'_K J_K.subtype)
  have hf_sub_tmul : ∀ (b' : B'_K) (x : ↥J_K), f_sub (b' ⊗ₜ[B_K] x) = b' * ι_B x.1 := by
    intro b' x
    simp only [f_sub, LinearMap.comp_apply, LinearMap.baseChange_tmul, Submodule.coe_subtype,
      LinearEquiv.coe_coe, TensorProduct.AlgebraTensorModule.rid_tmul]
    change ι_B x.1 * b' = b' * ι_B x.1
    exact mul_comm _ _
  have hf_inj : Function.Injective f_sub :=
    (TensorProduct.AlgebraTensorModule.rid B_K B'_K B'_K).injective.comp
      (Module.Flat.lTensor_preserves_injective_linearMap J_K.subtype Subtype.val_injective)
  have hrange_eq : LinearMap.range f_sub = RingHom.ker π'_K := by
    rw [hKer_π']
    apply le_antisymm
    · rintro _ ⟨z, rfl⟩
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Ideal.zero_mem _
      | tmul b' x =>
        rw [hf_sub_tmul]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem ι_B x.2)
      | add z₁ z₂ ih₁ ih₂ =>
        rw [map_add]
        exact add_mem ih₁ ih₂
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      exact ⟨(1 : B'_K) ⊗ₜ[B_K] ⟨x, hx⟩, by rw [hf_sub_tmul, one_mul]⟩
  let e_JB' : TensorProduct B_K B'_K ↥J_K ≃ₗ[B'_K] ↥(RingHom.ker π'_K) :=
    (LinearEquiv.ofInjective f_sub hf_inj).trans (LinearEquiv.ofEq _ _ hrange_eq)
  have hfr_κ₀ :
      ∀ (E κ₀ : Type u) [Field E] [Field κ₀] [Algebra D'_K E] [Algebra B₀ κ₀],
        (∀ d' : D'_K, algebraMap D'_K E d' = 0 ↔ d' ∈ m'₀.asIdeal) →
        (∀ (f : B₀ →+* E),
          Q₀.asIdeal ≤ RingHom.ker f →
          Q₀.asIdeal.primeCompl ≤ Submonoid.comap f (IsUnit.submonoid E) →
          ∃ g : κ₀ →+* E, g.comp (algebraMap B₀ κ₀) = f) →
        Module.finrank κ₀ (TensorProduct B₀ κ₀ ↥(RingHom.ker π₀)) = 1 := by
    intro E κ₀ _ _ _ _ hE_ker hLift
    letI : Algebra B'_K E := ((algebraMap D'_K E).comp π'_K).toAlgebra
    haveI : IsScalarTower B'_K D'_K E := IsScalarTower.mk (fun b' d' e => by
      have h1 : (b' • d') • e = algebraMap D'_K E (π'_K b' * d') * e := Algebra.smul_def _ _
      have h2 : b' • (d' • e) = algebraMap D'_K E (π'_K b') * (algebraMap D'_K E d' * e) := by
        rw [Algebra.smul_def d' e]
        exact Algebra.smul_def _ _
      rw [h1, h2, map_mul, mul_assoc])
    have hfr_B' : Module.finrank E (TensorProduct B'_K E ↥(RingHom.ker π'_K)) = 1 :=
      hStep3 B'_K D'_K E φ'_K hEt_φ' hSurj_π' hH1' hSeq'
    letI : Algebra B_K E := ((algebraMap B'_K E).comp ι_B).toAlgebra
    haveI : IsScalarTower B_K B'_K E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let θ_E : B₀ →+* E := (algebraMap B_K E).comp (algebraMap B₀ B_K)
    letI : Algebra B₀ E := θ_E.toAlgebra
    haveI : IsScalarTower B₀ B_K E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let e_E_J0 : TensorProduct B'_K E ↥(RingHom.ker π'_K) ≃ₗ[E]
        TensorProduct B₀ E ↥(RingHom.ker π₀) :=
      (LinearEquiv.baseChange B'_K E _ _ e_JB'.symm).trans <|
        (TensorProduct.AlgebraTensorModule.cancelBaseChange B_K B'_K E E ↥J_K).trans <|
          (LinearEquiv.baseChange B_K E _ _ e_JK).trans <|
            TensorProduct.AlgebraTensorModule.cancelBaseChange B₀ B_K E E ↥(RingHom.ker π₀)
    have hθ_zero : ∀ b : B₀, θ_E b = 0 ↔ b ∈ Q₀.asIdeal := by
      intro b
      change algebraMap D'_K E (π'_K (ι_B ((1 : K) ⊗ₜ[R₁] b))) = 0 ↔ b ∈ Q₀.asIdeal
      have h1 := RingHom.congr_fun hComm_lift ((1 : K) ⊗ₜ[R₁] b)
      simp only [RingHom.comp_apply] at h1
      rw [h1]
      have h2 : ψ'₁.toRingHom (π_K.toRingHom ((1 : K) ⊗ₜ[R₁] b)) =
          (ψ'₁.toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := R₁) (A := K) (B := A'₁)).toRingHom) (π₀ b) := by
        change ψ'₁ (π_K ((1 : K) ⊗ₜ[R₁] b)) = ψ'₁ ((1 : K) ⊗ₜ[R₁] π₀ b)
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
        rfl
      rw [h2, hE_ker]
      have hm'₀_comap_as :
          m'₀.asIdeal.comap
            (ψ'₁.toRingHom.comp
              (Algebra.TensorProduct.includeRight (R := R₁) (A := K) (B := A'₁)).toRingHom) =
          q'₁.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hm'₀_comap
      have hQ₀_as : q'₁.asIdeal.comap π₀ = Q₀.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hQ₀
      rw [← Ideal.mem_comap, hm'₀_comap_as, ← Ideal.mem_comap, hQ₀_as]
    have hker_θ : Q₀.asIdeal ≤ RingHom.ker θ_E := fun b hb => (hθ_zero b).mpr hb
    have hunit_θ : Q₀.asIdeal.primeCompl ≤ Submonoid.comap θ_E (IsUnit.submonoid E) :=
      fun b hb => IsUnit.mk0 (θ_E b) (mt (hθ_zero b).mp hb)
    obtain ⟨ι_κE, hι_κE⟩ := hLift θ_E hker_θ hunit_θ
    letI : Algebra κ₀ E := ι_κE.toAlgebra
    haveI : IsScalarTower B₀ κ₀ E :=
      IsScalarTower.of_algebraMap_eq (fun b => (RingHom.congr_fun hι_κE b).symm)
    let e_κE : TensorProduct κ₀ E (TensorProduct B₀ κ₀ ↥(RingHom.ker π₀)) ≃ₗ[E]
        TensorProduct B₀ E ↥(RingHom.ker π₀) :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange B₀ κ₀ E E ↥(RingHom.ker π₀)
    rw [← Module.finrank_baseChange (R := E) (S := κ₀)
      (M' := TensorProduct B₀ κ₀ ↥(RingHom.ker π₀))]
    rw [LinearEquiv.finrank_eq e_κE, ← LinearEquiv.finrank_eq e_E_J0]
    exact hfr_B'
  have hfr_final : Module.finrank Q₀.asIdeal.ResidueField
      (TensorProduct B₀ Q₀.asIdeal.ResidueField ↥(RingHom.ker π₀)) = 1 :=
    hfr_κ₀ m'₀.asIdeal.ResidueField Q₀.asIdeal.ResidueField
      (fun _ => Ideal.algebraMap_residueField_eq_zero)
      (fun f hf₁ hf₂ =>
        ⟨Ideal.ResidueField.lift Q₀.asIdeal f hf₁ hf₂,
          RingHom.ext (Ideal.ResidueField.lift_algebraMap Q₀.asIdeal f hf₁ hf₂)⟩)
  exact hStep4 (RingHom.ker π₀) hKerFG hfr_final

theorem weil_split_nodal_fiber_to_etale_ambient_hypersurface (R₁ A₁ : Type u) [CommRing R₁] [CommRing A₁]
    (f₁ : R₁ →+* A₁)
    (hFlat₁ : f₁.Flat)
    (hFP₁ : f₁.FinitePresentation)
    (q₁ : PrimeSpectrum A₁)
    (u₁ v₁ : A₁)
    (hSplit : HasSplitFiberNodeAt f₁ q₁ u₁ v₁) :
    ∃ (B : Type u) (_ : CommRing B)
      (φ_P : MvPolynomial (Fin 2) R₁ →+* B)
      (Q : PrimeSpectrum B)
      (g : B)
      (e_hyp : A₁ →+* (B ⧸ Ideal.span {g})),
      φ_P.Etale ∧
      e_hyp.Etale ∧
      Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = (PrimeSpectrum.comap f₁ q₁).asIdeal ∧
      (∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal) ∧
      g - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
        Ideal.map (φ_P.comp MvPolynomial.C) (PrimeSpectrum.comap f₁ q₁).asIdeal ⊔
          Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 ∧
      e_hyp.comp f₁ = (Ideal.Quotient.mk (Ideal.span {g})).comp (φ_P.comp MvPolynomial.C) ∧
      (∃ q_bar : PrimeSpectrum (B ⧸ Ideal.span {g}),
        PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {g})) q_bar = Q ∧
        PrimeSpectrum.comap e_hyp q_bar = q₁) :=
by
  letI : Algebra R₁ A₁ := f₁.toAlgebra
  let p₁ : PrimeSpectrum R₁ := PrimeSpectrum.comap f₁ q₁
  let κ₁ : Type u := p₁.asIdeal.ResidueField
  let F₁ : Type u := TensorProduct R₁ A₁ κ₁
  let toF₁ : A₁ →+* F₁ := Algebra.TensorProduct.includeLeftRingHom
  let toκ₁ : κ₁ →+* F₁ := Algebra.TensorProduct.includeRight.toRingHom
  obtain ⟨hu₁, hv₁, hGeom, m₁, hm₁_comap, hm₁_res, hSpan, hLinIndep, hProdCub⟩ := hSplit
  obtain ⟨B₀, instRingB₀, φ₀, Q₀, s_A, q'₁, π₀,
      hEt₀, hs_A, hq'₁, hQ₀, hSurj₀, hKerFG, hComm₀_full⟩ :=
    weil_split_fiber_span_to_etale_ambient_surjection R₁ A₁ hFP₁ q₁ u₁ v₁ hu₁ hv₁
      m₁ hm₁_comap hm₁_res hSpan
  letI : CommRing B₀ := instRingB₀
  have hComm₀ : π₀.comp (φ₀.comp MvPolynomial.C) =
      (algebraMap A₁ (Localization.Away s_A)).comp f₁ := by
    ext r
    have hc := RingHom.congr_fun hComm₀_full (MvPolynomial.C r)
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      MvPolynomial.aeval_C] at hc
    exact hc
  let K : Type u := AlgebraicClosure κ₁
  let toK : R₁ →+* K := (algebraMap κ₁ K).comp (algebraMap R₁ κ₁)
  letI : Algebra R₁ K := toK.toAlgebra
  obtain ⟨D_K, instRingDK, m₀, ψ₁, ψ₂, hψ₁, hψ₂, hm₀, _hXi_m₀, hcomm_K⟩ := hGeom
  letI : CommRing D_K := instRingDK
  letI : Algebra K D_K := (ψ₁.comp Algebra.TensorProduct.includeRight.toRingHom).toAlgebra
  obtain ⟨hH1, hSeq⟩ :=
    weil_etale_over_std_nodal_plane_curve_cotangent_exact K D_K ψ₂ hψ₂ hcomm_K.symm
  obtain ⟨s₁, g₀, hs₁, hg₀, hPrin⟩ :=
    weil_flat_etale_ambient_principal_at_prime_of_nodal_cotangent
      R₁ A₁ B₀ hFlat₁ q₁ s_A hs_A q'₁ hq'₁ φ₀ hEt₀ π₀ hSurj₀ hKerFG hComm₀ Q₀ hQ₀
      K D_K m₀ ψ₁ hψ₁ hm₀ rfl hH1 hSeq
  let L₁ : Type u := Localization.AtPrime m₁.asIdeal
  let loc : F₁ →+* L₁ := algebraMap F₁ L₁
  let 𝔪 : Ideal L₁ := IsLocalRing.maximalIdeal L₁
  let A'₁ : Type u := Localization.Away s_A
  have hQ₀_as : q'₁.asIdeal.comap π₀ = Q₀.asIdeal := congrArg PrimeSpectrum.asIdeal hQ₀
  have hq'₁_as : q'₁.asIdeal.comap (algebraMap A₁ A'₁) = q₁.asIdeal :=
    congrArg PrimeSpectrum.asIdeal hq'₁
  have hm₁_as : m₁.asIdeal.comap toF₁ = q₁.asIdeal := congrArg PrimeSpectrum.asIdeal hm₁_comap
  let P₂ : Type u := MvPolynomial (Fin 2) R₁
  let U₀ : B₀ := φ₀ (MvPolynomial.X 0)
  let V₀ : B₀ := φ₀ (MvPolynomial.X 1)
  have hπ₀_C : ∀ r : R₁, π₀ (φ₀ (MvPolynomial.C r)) = algebraMap A₁ A'₁ (f₁ r) := by
    intro r
    exact RingHom.congr_fun hComm₀ r
  have hπ₀_U₀ : π₀ U₀ = algebraMap A₁ A'₁ u₁ := by
    have hc := RingHom.congr_fun hComm₀_full (MvPolynomial.X 0)
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      MvPolynomial.aeval_X, Matrix.cons_val_zero] at hc
    exact hc
  have hπ₀_V₀ : π₀ V₀ = algebraMap A₁ A'₁ v₁ := by
    have hc := RingHom.congr_fun hComm₀_full (MvPolynomial.X 1)
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      MvPolynomial.aeval_X, Matrix.cons_val_one] at hc
    exact hc
  have hU₀_mem : U₀ ∈ Q₀.asIdeal := by
    rw [← hQ₀_as, Ideal.mem_comap, hπ₀_U₀, ← Ideal.mem_comap, hq'₁_as]
    exact hu₁
  have hV₀_mem : V₀ ∈ Q₀.asIdeal := by
    rw [← hQ₀_as, Ideal.mem_comap, hπ₀_V₀, ← Ideal.mem_comap, hq'₁_as]
    exact hv₁
  have hg₀_mem_Q₀ : g₀ ∈ Q₀.asIdeal := by
    rw [← hQ₀_as, Ideal.mem_comap, RingHom.mem_ker.mp hg₀]
    exact Ideal.zero_mem _
  have hp₁_sub_Q₀ : Ideal.map (φ₀.comp MvPolynomial.C) p₁.asIdeal ≤ Q₀.asIdeal := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, RingHom.comp_apply, ← hQ₀_as, Ideal.mem_comap, hπ₀_C,
      ← Ideal.mem_comap, hq'₁_as]
    exact hr
  letI : Algebra P₂ B₀ := φ₀.toAlgebra
  letI : Algebra R₁ B₀ := (φ₀.comp MvPolynomial.C).toAlgebra
  haveI : IsScalarTower R₁ P₂ B₀ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hDerivPkg :
      ∃ (derU derV : Derivation R₁ B₀ B₀),
        derU U₀ = 1 ∧ derU V₀ = 0 ∧ derV U₀ = 0 ∧ derV V₀ = 1 ∧
        ∀ b : B₀, KaehlerDifferential.D R₁ B₀ b =
          derU b • KaehlerDifferential.D R₁ B₀ U₀ + derV b • KaehlerDifferential.D R₁ B₀ V₀ := by
    haveI : Algebra.Etale P₂ B₀ := by rw [← RingHom.etale_algebraMap]; exact hEt₀
    obtain ⟨hSubΩ, hSubH1⟩ := (Algebra.formallyEtale_iff P₂ B₀).mp inferInstance
    have hmbc_inj : Function.Injective (KaehlerDifferential.mapBaseChange R₁ P₂ B₀) := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro z hz
      rw [LinearMap.mem_ker] at hz
      obtain ⟨w, rfl⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange R₁ P₂ B₀ z).mp hz
      rw [hSubH1.elim w 0, map_zero]
      exact Submodule.zero_mem _
    have hmbc_surj : Function.Surjective (KaehlerDifferential.mapBaseChange R₁ P₂ B₀) := by
      intro ω
      exact (KaehlerDifferential.exact_mapBaseChange_map R₁ P₂ B₀ ω).mp (hSubΩ.elim _ 0)
    let e_mbc : TensorProduct P₂ B₀ (KaehlerDifferential R₁ P₂) ≃ₗ[B₀] KaehlerDifferential R₁ B₀ :=
      LinearEquiv.ofBijective (KaehlerDifferential.mapBaseChange R₁ P₂ B₀) ⟨hmbc_inj, hmbc_surj⟩
    let b_P₂ := KaehlerDifferential.mvPolynomialBasis R₁ (Fin 2)
    let c_P₂ : Fin 2 → (KaehlerDifferential R₁ P₂ →ₗ[P₂] P₂) :=
      fun i => (Finsupp.lapply i).comp b_P₂.repr.toLinearMap
    let lift_B₀ : Fin 2 → (TensorProduct P₂ B₀ (KaehlerDifferential R₁ P₂) →ₗ[B₀] B₀) := fun i =>
      let bil : B₀ →ₗ[P₂] KaehlerDifferential R₁ P₂ →ₗ[P₂] B₀ :=
        LinearMap.mk₂ P₂ (fun b ω => b * φ₀ (c_P₂ i ω))
          (fun b₁ b₂ ω => add_mul b₁ b₂ _)
          (fun p b ω => by
            change (φ₀ p * b) * φ₀ (c_P₂ i ω) = φ₀ p * (b * φ₀ (c_P₂ i ω))
            ring)
          (fun b ω₁ ω₂ => by rw [map_add, map_add, mul_add])
          (fun p b ω => by
            rw [map_smul, smul_eq_mul, map_mul]
            change b * (φ₀ p * φ₀ (c_P₂ i ω)) = φ₀ p * (b * φ₀ (c_P₂ i ω))
            ring)
      let l_P₂ := TensorProduct.lift bil
      { toFun := l_P₂
        map_add' := l_P₂.map_add
        map_smul' := fun b₀ z => by
          simp only [RingHom.id_apply, smul_eq_mul]
          induction z using TensorProduct.induction_on with
          | zero => simp [l_P₂]
          | tmul b ω =>
            change l_P₂ ((b₀ * b) ⊗ₜ[P₂] ω) = b₀ * l_P₂ (b ⊗ₜ[P₂] ω)
            simp only [l_P₂, TensorProduct.lift.tmul, bil, LinearMap.mk₂_apply]
            ring
          | add x y ihx ihy =>
            rw [smul_add, map_add, map_add, ihx, ihy, mul_add] }
    let der_i : Fin 2 → Derivation R₁ B₀ B₀ := fun i =>
      KaehlerDifferential.linearMapEquivDerivation R₁ B₀ ((lift_B₀ i).comp e_mbc.symm.toLinearMap)
    have hmbc_D : ∀ p : P₂, e_mbc (1 ⊗ₜ[P₂] KaehlerDifferential.D R₁ P₂ p) =
        KaehlerDifferential.D R₁ B₀ (φ₀ p) := by
      intro p
      change KaehlerDifferential.mapBaseChange R₁ P₂ B₀ (1 ⊗ₜ[P₂] KaehlerDifferential.D R₁ P₂ p) =
        KaehlerDifferential.D R₁ B₀ (φ₀ p)
      rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
      rfl
    have hder_X : ∀ i j : Fin 2, der_i i (φ₀ (MvPolynomial.X j)) = if j = i then 1 else 0 := by
      intro i j
      change ((lift_B₀ i).comp e_mbc.symm.toLinearMap)
        (KaehlerDifferential.D R₁ B₀ (φ₀ (MvPolynomial.X j))) = _
      rw [LinearMap.comp_apply, ← hmbc_D (MvPolynomial.X j), LinearEquiv.coe_coe,
        LinearEquiv.symm_apply_apply]
      change (1 : B₀) * φ₀ ((b_P₂.repr (KaehlerDifferential.D R₁ P₂ (MvPolynomial.X j))) i) = _
      rw [one_mul, KaehlerDifferential.mvPolynomialBasis_repr_D_X, Finsupp.single_apply]
      split_ifs <;> simp
    refine ⟨der_i 0, der_i 1, hder_X 0 0, hder_X 0 1, hder_X 1 0, hder_X 1 1, ?_⟩
    intro b
    have hdecomp_tp : ∀ z : TensorProduct P₂ B₀ (KaehlerDifferential R₁ P₂),
        z = (lift_B₀ 0 z) • (1 ⊗ₜ[P₂] KaehlerDifferential.D R₁ P₂ (MvPolynomial.X 0)) +
            (lift_B₀ 1 z) • (1 ⊗ₜ[P₂] KaehlerDifferential.D R₁ P₂ (MvPolynomial.X 1)) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b₀ ω =>
        have hω : ω = (c_P₂ 0 ω) • b_P₂ 0 + (c_P₂ 1 ω) • b_P₂ 1 := by
          conv_lhs => rw [← b_P₂.sum_repr ω]
          rw [Fin.sum_univ_two]
          rfl
        conv_lhs => rw [hω]
        rw [TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
          TensorProduct.smul_tmul', TensorProduct.smul_tmul']
        rw [KaehlerDifferential.mvPolynomialBasis_apply, KaehlerDifferential.mvPolynomialBasis_apply]
        have hsmul : ∀ (k : Fin 2),
            (lift_B₀ k (b₀ ⊗ₜ[P₂] ω)) • (1 ⊗ₜ[P₂] KaehlerDifferential.D R₁ P₂ (MvPolynomial.X k)) =
            (c_P₂ k ω • b₀) ⊗ₜ[P₂] KaehlerDifferential.D R₁ P₂ (MvPolynomial.X k) := by
          intro k
          have hl : lift_B₀ k (b₀ ⊗ₜ[P₂] ω) = b₀ * φ₀ (c_P₂ k ω) := rfl
          rw [hl, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          have hp : c_P₂ k ω • b₀ = b₀ * φ₀ (c_P₂ k ω) := by
            change φ₀ (c_P₂ k ω) * b₀ = b₀ * φ₀ (c_P₂ k ω)
            ring
          rw [hp]
        rw [hsmul 0, hsmul 1]
      | add x y ihx ihy =>
        rw [map_add, map_add, add_smul, add_smul]
        conv_lhs => rw [ihx, ihy]
        abel
    have hz := congrArg e_mbc (hdecomp_tp (e_mbc.symm (KaehlerDifferential.D R₁ B₀ b)))
    rw [LinearEquiv.apply_symm_apply, map_add, map_smul, map_smul,
      hmbc_D (MvPolynomial.X 0), hmbc_D (MvPolynomial.X 1)] at hz
    exact hz
  obtain ⟨derU, derV, hderU_U, hderU_V, hderV_U, hderV_V, hD_expand⟩ := hDerivPkg
  have hderg₀_mem : derU g₀ ∈ Q₀.asIdeal ∧ derV g₀ ∈ Q₀.asIdeal := by
    have hs_A_not_m₁ : toF₁ s_A ∉ m₁.asIdeal := by
      intro hmem
      apply hs_A
      rw [← hm₁_as]
      exact hmem
    have hu_sA_L₁ : IsUnit ((loc.comp toF₁) s_A) :=
      IsLocalization.map_units L₁ (⟨toF₁ s_A, hs_A_not_m₁⟩ : m₁.asIdeal.primeCompl)
    let loc_A : A'₁ →+* L₁ := IsLocalization.Away.lift (S := A'₁) s_A hu_sA_L₁
    have hloc_A_eq : ∀ a : A₁, loc_A (algebraMap A₁ A'₁ a) = loc (toF₁ a) :=
      fun a => IsLocalization.Away.lift_eq (S := A'₁) s_A hu_sA_L₁ a
    let Ψ : B₀ →+* L₁ := loc_A.comp π₀
    have hΨ_U₀ : Ψ U₀ = loc (toF₁ u₁) := by
      change loc_A (π₀ U₀) = _; rw [hπ₀_U₀, hloc_A_eq]
    have hΨ_V₀ : Ψ V₀ = loc (toF₁ v₁) := by
      change loc_A (π₀ V₀) = _; rw [hπ₀_V₀, hloc_A_eq]
    have hΨ_g₀ : Ψ g₀ = 0 := by
      change loc_A (π₀ g₀) = 0; rw [RingHom.mem_ker.mp hg₀, map_zero]
    have hΨ_C : ∀ r : R₁, Ψ (φ₀ (MvPolynomial.C r)) = loc (toκ₁ (algebraMap R₁ κ₁ r)) := by
      intro r
      change loc_A (π₀ (φ₀ (MvPolynomial.C r))) = _
      rw [hπ₀_C, hloc_A_eq]
      congr 1
      change (f₁ r) ⊗ₜ[R₁] (1 : κ₁) = (1 : A₁) ⊗ₜ[R₁] (algebraMap R₁ κ₁ r)
      have hr1 : f₁ r = r • (1 : A₁) := by
        rw [Algebra.smul_def, mul_one]; rfl
      have hr2 : algebraMap R₁ κ₁ r = r • (1 : κ₁) := by
        rw [Algebra.smul_def, mul_one]
      rw [hr1, hr2, TensorProduct.smul_tmul]
    haveI : Nontrivial (F₁ ⧸ m₁.asIdeal) := Ideal.Quotient.nontrivial_iff.mpr m₁.isPrime.ne_top
    let f_κ : κ₁ →+* (F₁ ⧸ m₁.asIdeal) := (Ideal.Quotient.mk m₁.asIdeal).comp toκ₁
    have hf_κ_surj : Function.Surjective f_κ := by
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨c, hc⟩ := hm₁_res z
      refine ⟨c, ?_⟩
      symm
      rw [RingHom.comp_apply, Ideal.Quotient.eq]
      exact hc
    let e_κ : κ₁ ≃+* (F₁ ⧸ m₁.asIdeal) := RingEquiv.ofBijective f_κ ⟨f_κ.injective, hf_κ_surj⟩
    let π_κ : F₁ →+* κ₁ := e_κ.symm.toRingHom.comp (Ideal.Quotient.mk m₁.asIdeal)
    have hπ_κ_sec : ∀ c : κ₁, π_κ (toκ₁ c) = c := fun c => e_κ.symm_apply_apply c
    have hπ_κ_units : ∀ y : m₁.asIdeal.primeCompl, IsUnit (π_κ y.1) := by
      intro y
      apply IsUnit.mk0
      intro hzero
      apply y.2
      have hmk : Ideal.Quotient.mk m₁.asIdeal y.1 = 0 := by
        apply e_κ.symm.injective
        rw [map_zero]
        exact hzero
      exact Ideal.Quotient.eq_zero_iff_mem.mp hmk
    let ρ : L₁ →+* κ₁ := IsLocalization.lift (M := m₁.asIdeal.primeCompl) (S := L₁) hπ_κ_units
    have hρ_loc : ∀ z : F₁, ρ (loc z) = π_κ z :=
      fun z => IsLocalization.lift_eq (M := m₁.asIdeal.primeCompl) (S := L₁) hπ_κ_units z
    have hρ_sec : ∀ c : κ₁, ρ (loc (toκ₁ c)) = c := by
      intro c; rw [hρ_loc, hπ_κ_sec]
    have hker_ρ_le : ∀ x : L₁, ρ x = 0 → x ∈ 𝔪 := by
      intro x hx
      by_contra hnot
      have hu : IsUnit x := IsLocalRing.notMem_maximalIdeal.mp hnot
      exact (hu.map ρ).ne_zero hx
    have h𝔪_ker_ρ : ∀ x ∈ 𝔪, ρ x = 0 := by
      intro x hx
      by_contra hne
      obtain ⟨⟨z, s⟩, hzs⟩ := IsLocalization.surj m₁.asIdeal.primeCompl x
      have hz_mem : z ∈ m₁.asIdeal := by
        have hloc_z : loc z ∈ 𝔪 := by
          rw [← hzs]
          exact Ideal.mul_mem_right _ _ hx
        have hcomap : 𝔪.comap loc = m₁.asIdeal :=
          IsLocalization.AtPrime.under_maximalIdeal L₁ m₁.asIdeal
        have hz_in : z ∈ 𝔪.comap loc := hloc_z
        rwa [hcomap] at hz_in
      have hρz : ρ (loc z) = 0 := by
        rw [hρ_loc]
        change e_κ.symm (Ideal.Quotient.mk m₁.asIdeal z) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hz_mem, map_zero]
      have hρ_prod := congrArg ρ hzs
      rw [map_mul, hρz, hρ_loc] at hρ_prod
      exact hne ((mul_eq_zero.mp hρ_prod).resolve_right (hπ_κ_units s).ne_zero)
    have hΨ_pre_𝔪 : ∀ b : B₀, Ψ b ∈ 𝔪 ↔ b ∈ Q₀.asIdeal := by
      intro b
      have hlocA_comap : PrimeSpectrum.comap loc_A ⟨𝔪, inferInstance⟩ = q'₁ := by
        apply PrimeSpectrum.localization_comap_injective A'₁ (Submonoid.powers s_A)
        rw [hq'₁]
        ext a
        simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        change loc_A (algebraMap A₁ A'₁ a) ∈ 𝔪 ↔ a ∈ q₁.asIdeal
        rw [hloc_A_eq]
        have hcomap : 𝔪.comap loc = m₁.asIdeal :=
          IsLocalization.AtPrime.under_maximalIdeal L₁ m₁.asIdeal
        have h1 : loc (toF₁ a) ∈ 𝔪 ↔ toF₁ a ∈ m₁.asIdeal := by
          change toF₁ a ∈ 𝔪.comap loc ↔ toF₁ a ∈ m₁.asIdeal
          rw [hcomap]
        have h2 : toF₁ a ∈ m₁.asIdeal ↔ a ∈ q₁.asIdeal := by rw [← hm₁_as]; rfl
        exact h1.trans h2
      have hlocA_as : 𝔪.comap loc_A = q'₁.asIdeal := congrArg PrimeSpectrum.asIdeal hlocA_comap
      change π₀ b ∈ 𝔪.comap loc_A ↔ b ∈ Q₀.asIdeal
      rw [hlocA_as, ← Ideal.mem_comap, hQ₀_as]
    let modB₀ : Module B₀ 𝔪.Cotangent := Module.compHom 𝔪.Cotangent Ψ
    let modR₁ : Module R₁ 𝔪.Cotangent :=
      Module.compHom 𝔪.Cotangent (Ψ.comp (φ₀.comp MvPolynomial.C))
    letI : Module B₀ 𝔪.Cotangent := modB₀
    letI : Module R₁ 𝔪.Cotangent := modR₁
    haveI : @IsScalarTower R₁ B₀ 𝔪.Cotangent inferInstance modB₀.toSMul modR₁.toSMul :=
      @IsScalarTower.mk R₁ B₀ 𝔪.Cotangent inferInstance modB₀.toSMul modR₁.toSMul (fun r b x => by
        change Ψ (φ₀ (MvPolynomial.C r) * b) • x = Ψ (φ₀ (MvPolynomial.C r)) • (Ψ b • x)
        rw [map_mul, mul_smul])
    have hm_part : ∀ x : L₁, x - loc (toκ₁ (ρ x)) ∈ 𝔪 := by
      intro x
      apply hker_ρ_le
      rw [map_sub, hρ_sec, sub_self]
    let d_L : L₁ → 𝔪.Cotangent := fun x => 𝔪.toCotangent ⟨x - loc (toκ₁ (ρ x)), hm_part x⟩
    let δ_cot : Derivation R₁ B₀ 𝔪.Cotangent :=
      { toFun := fun b => d_L (Ψ b)
        map_add' := fun b₁ b₂ => by
          dsimp [d_L]
          rw [← map_add]
          congr 1
          ext
          simp only [Submodule.coe_add, map_add]
          ring
        map_smul' := fun r b => by
          dsimp [d_L]
          change 𝔪.toCotangent ⟨Ψ (φ₀ (MvPolynomial.C r) * b) -
              loc (toκ₁ (ρ (Ψ (φ₀ (MvPolynomial.C r) * b)))), _⟩ =
            Ψ (φ₀ (MvPolynomial.C r)) • 𝔪.toCotangent ⟨Ψ b - loc (toκ₁ (ρ (Ψ b))), _⟩
          rw [← map_smul]
          congr 1
          ext
          change Ψ (φ₀ (MvPolynomial.C r) * b) -
              loc (toκ₁ (ρ (Ψ (φ₀ (MvPolynomial.C r) * b)))) =
            Ψ (φ₀ (MvPolynomial.C r)) * (Ψ b - loc (toκ₁ (ρ (Ψ b))))
          rw [map_mul Ψ, hΨ_C r, map_mul ρ, hρ_sec, map_mul toκ₁, map_mul loc]
          ring
        map_one_eq_zero' := by
          dsimp [d_L]
          have h1 : Ψ 1 - loc (toκ₁ (ρ (Ψ 1))) = 0 := by simp
          have hsub : (⟨Ψ 1 - loc (toκ₁ (ρ (Ψ 1))), hm_part (Ψ 1)⟩ : 𝔪) = 0 := by
            ext; exact h1
          rw [hsub, map_zero]
        leibniz' := fun a b => by
          dsimp [d_L]
          change 𝔪.toCotangent ⟨Ψ (a * b) - loc (toκ₁ (ρ (Ψ (a * b)))), _⟩ =
            Ψ a • 𝔪.toCotangent ⟨Ψ b - loc (toκ₁ (ρ (Ψ b))), _⟩ +
            Ψ b • 𝔪.toCotangent ⟨Ψ a - loc (toκ₁ (ρ (Ψ a))), _⟩
          rw [← map_smul, ← map_smul, ← map_add, ← sub_eq_zero, ← map_sub,
            ← LinearMap.mem_ker, Ideal.mem_toCotangent_ker]
          simp only [Submodule.coe_sub, Submodule.coe_add, SetLike.val_smul, smul_eq_mul]
          rw [map_mul Ψ a b, map_mul ρ, map_mul toκ₁, map_mul loc]
          have hident : (Ψ a * Ψ b - loc (toκ₁ (ρ (Ψ a))) * loc (toκ₁ (ρ (Ψ b)))) -
              (Ψ a * (Ψ b - loc (toκ₁ (ρ (Ψ b)))) + Ψ b * (Ψ a - loc (toκ₁ (ρ (Ψ a))))) =
              - ((Ψ a - loc (toκ₁ (ρ (Ψ a)))) * (Ψ b - loc (toκ₁ (ρ (Ψ b))))) := by ring
          rw [hident, sq]
          exact neg_mem (Ideal.mul_mem_mul (hm_part (Ψ a)) (hm_part (Ψ b))) }
    let m_cot : KaehlerDifferential R₁ B₀ →ₗ[B₀] 𝔪.Cotangent :=
      (KaehlerDifferential.linearMapEquivDerivation R₁ B₀).symm δ_cot
    have hm_cot_D : ∀ b : B₀, m_cot (KaehlerDifferential.D R₁ B₀ b) = δ_cot b := by
      intro b
      have h := KaehlerDifferential.linearMapEquivDerivation_apply_apply R₁ B₀ m_cot b
      rw [LinearEquiv.apply_symm_apply] at h
      exact h.symm
    have hδ_g₀ := congrArg m_cot (hD_expand g₀)
    rw [hm_cot_D g₀, map_add, map_smul, map_smul, hm_cot_D U₀, hm_cot_D V₀] at hδ_g₀
    have hδ_g₀_zero : δ_cot g₀ = 0 := by
      change d_L (Ψ g₀) = 0
      rw [hΨ_g₀]
      dsimp [d_L]
      have hsub : (⟨(0 : L₁) - loc (toκ₁ (ρ 0)), hm_part 0⟩ : 𝔪) = 0 := by ext; simp
      rw [hsub, map_zero]
    rw [hδ_g₀_zero] at hδ_g₀
    have hu_bar_mem : loc (toF₁ u₁) ∈ 𝔪 := by
      rw [← hΨ_U₀, hΨ_pre_𝔪]; exact hU₀_mem
    have hv_bar_mem : loc (toF₁ v₁) ∈ 𝔪 := by
      rw [← hΨ_V₀, hΨ_pre_𝔪]; exact hV₀_mem
    have hδ_U₀ : δ_cot U₀ = 𝔪.toCotangent ⟨loc (toF₁ u₁), hu_bar_mem⟩ := by
      change 𝔪.toCotangent ⟨Ψ U₀ - loc (toκ₁ (ρ (Ψ U₀))), hm_part (Ψ U₀)⟩ = _
      congr 1
      ext
      change Ψ U₀ - loc (toκ₁ (ρ (Ψ U₀))) = loc (toF₁ u₁)
      rw [hΨ_U₀, h𝔪_ker_ρ _ hu_bar_mem, map_zero, map_zero, sub_zero]
    have hδ_V₀ : δ_cot V₀ = 𝔪.toCotangent ⟨loc (toF₁ v₁), hv_bar_mem⟩ := by
      change 𝔪.toCotangent ⟨Ψ V₀ - loc (toκ₁ (ρ (Ψ V₀))), hm_part (Ψ V₀)⟩ = _
      congr 1
      ext
      change Ψ V₀ - loc (toκ₁ (ρ (Ψ V₀))) = loc (toF₁ v₁)
      rw [hΨ_V₀, h𝔪_ker_ρ _ hv_bar_mem, map_zero, map_zero, sub_zero]
    rw [hδ_U₀, hδ_V₀] at hδ_g₀
    let c₀ : κ₁ := ρ (Ψ (derU g₀))
    let c₁ : κ₁ := ρ (Ψ (derV g₀))
    have hsmul_c₀ : (derU g₀ : B₀) • 𝔪.toCotangent ⟨loc (toF₁ u₁), hu_bar_mem⟩ =
        𝔪.toCotangent ⟨loc (toκ₁ c₀) * loc (toF₁ u₁), Ideal.mul_mem_left _ _ hu_bar_mem⟩ := by
      change Ψ (derU g₀) • 𝔪.toCotangent ⟨loc (toF₁ u₁), hu_bar_mem⟩ = _
      have hsplit : Ψ (derU g₀) = (Ψ (derU g₀) - loc (toκ₁ c₀)) + loc (toκ₁ c₀) := by ring
      rw [hsplit, add_smul, Ideal.Cotangent.smul_eq_zero_of_mem (hm_part (Ψ (derU g₀))),
        zero_add, ← map_smul]
      rfl
    have hsmul_c₁ : (derV g₀ : B₀) • 𝔪.toCotangent ⟨loc (toF₁ v₁), hv_bar_mem⟩ =
        𝔪.toCotangent ⟨loc (toκ₁ c₁) * loc (toF₁ v₁), Ideal.mul_mem_left _ _ hv_bar_mem⟩ := by
      change Ψ (derV g₀) • 𝔪.toCotangent ⟨loc (toF₁ v₁), hv_bar_mem⟩ = _
      have hsplit : Ψ (derV g₀) = (Ψ (derV g₀) - loc (toκ₁ c₁)) + loc (toκ₁ c₁) := by ring
      rw [hsplit, add_smul, Ideal.Cotangent.smul_eq_zero_of_mem (hm_part (Ψ (derV g₀))),
        zero_add, ← map_smul]
      rfl
    rw [hsmul_c₀, hsmul_c₁, ← map_add] at hδ_g₀
    have hker_lin : loc (toκ₁ c₀) * loc (toF₁ u₁) + loc (toκ₁ c₁) * loc (toF₁ v₁) ∈ 𝔪 ^ 2 :=
      (Ideal.mem_toCotangent_ker 𝔪).mp (LinearMap.mem_ker.mpr hδ_g₀.symm)
    obtain ⟨hc₀, hc₁⟩ := hLinIndep c₀ c₁ hker_lin
    exact ⟨(hΨ_pre_𝔪 _).mp (hker_ρ_le _ hc₀), (hΨ_pre_𝔪 _).mp (hker_ρ_le _ hc₁)⟩
  obtain ⟨hderUg₀, hderVg₀⟩ := hderg₀_mem
  have h_cross_F₁ : ∀ (r : R₁) (b : A₁),
      toκ₁ (algebraMap R₁ κ₁ r) * toF₁ b = toF₁ (f₁ r * b) := by
    intro r b
    change ((1 : A₁) ⊗ₜ[R₁] algebraMap R₁ κ₁ r) * (b ⊗ₜ[R₁] (1 : κ₁)) = (f₁ r * b) ⊗ₜ[R₁] (1 : κ₁)
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    have hr1 : f₁ r * b = r • b := (Algebra.smul_def r b).symm
    have hr2 : algebraMap R₁ κ₁ r = r • (1 : κ₁) := by rw [Algebra.smul_def, mul_one]
    rw [hr1, hr2, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
  have h_dc1 : ∀ z : F₁, ∃ (t : R₁) (b : A₁),
      t ∉ p₁.asIdeal ∧ toκ₁ (algebraMap R₁ κ₁ t) * z = toF₁ b := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, 0, p₁.isPrime.one_notMem, by simp⟩
    | tmul a c =>
      obtain ⟨q, rfl⟩ := IsLocalRing.residue_surjective c
      obtain ⟨⟨r_a, s⟩, hqs⟩ := IsLocalization.surj p₁.asIdeal.primeCompl q
      have hres := congrArg (IsLocalRing.residue (Localization.AtPrime p₁.asIdeal)) hqs
      rw [map_mul] at hres
      have h_alg : ∀ r : R₁,
          IsLocalRing.residue (Localization.AtPrime p₁.asIdeal)
            (algebraMap R₁ (Localization.AtPrime p₁.asIdeal) r) = algebraMap R₁ κ₁ r :=
        fun _ => rfl
      rw [h_alg s.1, h_alg r_a] at hres
      refine ⟨s.1, f₁ r_a * a, s.2, ?_⟩
      change ((1 : A₁) ⊗ₜ[R₁] algebraMap R₁ κ₁ s.1) * (a ⊗ₜ[R₁] _) = (f₁ r_a * a) ⊗ₜ[R₁] (1 : κ₁)
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm (algebraMap R₁ κ₁ s.1), hres]
      have hr1 : f₁ r_a * a = r_a • a := (Algebra.smul_def r_a a).symm
      have hr2 : algebraMap R₁ κ₁ r_a = r_a • (1 : κ₁) := by rw [Algebra.smul_def, mul_one]
      rw [hr1, hr2, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
    | add x y ihx ihy =>
      obtain ⟨t₁, b₁, ht₁, hx⟩ := ihx
      obtain ⟨t₂, b₂, ht₂, hy⟩ := ihy
      refine ⟨t₁ * t₂, f₁ t₂ * b₁ + f₁ t₁ * b₂, p₁.isPrime.mul_notMem ht₁ ht₂, ?_⟩
      calc
        toκ₁ (algebraMap R₁ κ₁ (t₁ * t₂)) * (x + y)
          = toκ₁ (algebraMap R₁ κ₁ t₂) * (toκ₁ (algebraMap R₁ κ₁ t₁) * x) +
            toκ₁ (algebraMap R₁ κ₁ t₁) * (toκ₁ (algebraMap R₁ κ₁ t₂) * y) := by
            simp only [map_mul]; ring
        _ = toκ₁ (algebraMap R₁ κ₁ t₂) * toF₁ b₁ + toκ₁ (algebraMap R₁ κ₁ t₁) * toF₁ b₂ := by
            rw [hx, hy]
        _ = toF₁ (f₁ t₂ * b₁ + f₁ t₁ * b₂) := by
            rw [h_cross_F₁, h_cross_F₁, map_add]
  have h_dc2 : ∀ x : A₁, toF₁ x = 0 →
      ∃ s'' : R₁, s'' ∉ p₁.asIdeal ∧ f₁ s'' * x ∈ Ideal.map f₁ p₁.asIdeal := by
    intro x hx
    let I_p₁ : Ideal A₁ := Ideal.map f₁ p₁.asIdeal
    let Q_A : Type u := A₁ ⧸ I_p₁
    let q_A : A₁ →+* Q_A := Ideal.Quotient.mk I_p₁
    let M_sub : Submonoid Q_A := Submonoid.map (q_A.comp f₁) p₁.asIdeal.primeCompl
    let Q_loc : Type u := Localization M_sub
    let φ_left : A₁ →+* Q_loc := (algebraMap Q_A Q_loc).comp q_A
    let φ_R : R₁ →+* Q_loc := φ_left.comp f₁
    have h_ker : p₁.asIdeal ≤ RingHom.ker φ_R := by
      intro r hr
      rw [RingHom.mem_ker]
      change algebraMap Q_A Q_loc (q_A (f₁ r)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem f₁ hr), map_zero]
    have h_unit : p₁.asIdeal.primeCompl ≤ Submonoid.comap φ_R (IsUnit.submonoid Q_loc) := by
      intro s hs
      rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      exact IsLocalization.map_units Q_loc ⟨q_A (f₁ s), Submonoid.mem_map_of_mem (q_A.comp f₁) hs⟩
    let φ_right : κ₁ →+* Q_loc := Ideal.ResidueField.lift p₁.asIdeal φ_R h_ker h_unit
    letI : Algebra R₁ Q_loc := φ_R.toAlgebra
    let φ_left_alg : A₁ →ₐ[R₁] Q_loc := { toRingHom := φ_left, commutes' := fun _ => rfl }
    let φ_right_alg : κ₁ →ₐ[R₁] Q_loc :=
      { toRingHom := φ_right
        commutes' := fun r => Ideal.ResidueField.lift_algebraMap p₁.asIdeal φ_R h_ker h_unit r }
    let Φ_prod : F₁ →ₐ[R₁] Q_loc := Algebra.TensorProduct.productMap φ_left_alg φ_right_alg
    have hΦx : algebraMap Q_A Q_loc (q_A x) = 0 := by
      have hΦ_apply : Φ_prod (toF₁ x) = algebraMap Q_A Q_loc (q_A x) := by
        change (Algebra.TensorProduct.productMap φ_left_alg φ_right_alg)
          (x ⊗ₜ[R₁] (1 : κ₁)) = _
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        rfl
      rw [← hΦ_apply, hx, map_zero]
    obtain ⟨⟨_, s'', hs'', rfl⟩, hmul_zero⟩ :=
      (IsLocalization.map_eq_zero_iff M_sub Q_loc (q_A x)).mp hΦx
    refine ⟨s'', hs'', ?_⟩
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q_A (f₁ s'' * x) = 0
    rw [map_mul]
    exact hmul_zero
  have h_clear_A₁ : ∃ (w_A c_A : A₁),
      w_A ∉ q₁.asIdeal ∧ c_A ∈ Ideal.span {u₁, v₁} ^ 3 ∧
      w_A * (u₁ * v₁) - c_A ∈ Ideal.map f₁ p₁.asIdeal := by
    have hmem_loc : loc (toF₁ (u₁ * v₁)) ∈
        Ideal.map loc (Ideal.span {toF₁ u₁, toF₁ v₁} ^ 3) := by
      rw [Ideal.map_pow, Ideal.map_span]
      simp only [Set.image_insert_eq, Set.image_singleton]
      rw [hSpan, map_mul, map_mul]
      exact hProdCub
    have h_loc_map : ∀ w ∈ Ideal.map loc (Ideal.span {toF₁ u₁, toF₁ v₁} ^ 3),
        ∃ (d j : F₁), d ∉ m₁.asIdeal ∧ j ∈ Ideal.span {toF₁ u₁, toF₁ v₁} ^ 3 ∧
          loc d * w = loc j := by
      intro w hw
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
      · rintro _ ⟨j, hj, rfl⟩
        exact ⟨1, j, m₁.isPrime.one_notMem, hj, by simp⟩
      · exact ⟨1, 0, m₁.isPrime.one_notMem, Ideal.zero_mem _, by simp⟩
      · rintro x y _ _ ⟨d₁, j₁, hd₁, hj₁, hx⟩ ⟨d₂, j₂, hd₂, hj₂, hy⟩
        refine ⟨d₁ * d₂, d₂ * j₁ + d₁ * j₂, m₁.isPrime.mul_notMem hd₁ hd₂,
          add_mem (Ideal.mul_mem_left _ _ hj₁) (Ideal.mul_mem_left _ _ hj₂), ?_⟩
        simp only [map_mul, map_add]
        linear_combination loc d₂ * hx + loc d₁ * hy
      · rintro l x _ ⟨d₁, j₁, hd₁, hj₁, hx⟩
        obtain ⟨⟨f_l, s_l⟩, hl⟩ := IsLocalization.surj m₁.asIdeal.primeCompl l
        refine ⟨s_l.1 * d₁, f_l * j₁, m₁.isPrime.mul_notMem s_l.2 hd₁,
