    weil_powerSeries_stable_curve_node_resolution Ω n C₁' g₁' τ₁' hStab₁' hInt₁' hSm₁'
  obtain ⟨C₂_res, g₂_res, τ₂_res, q₂_res, hRes₂⟩ :=
    weil_powerSeries_stable_curve_node_resolution Ω n C₂' g₂' τ₂' hStab₂' hInt₂' hSm₂'
  exact weil_powerSeries_node_resolution_pointed_iso_descent
    Ω n C₁' C₂' C₁_res C₂_res g₁' τ₁' g₂' τ₂'
    g₁_res τ₁_res q₁_res g₂_res τ₂_res q₂_res
    hRes₁ hRes₂ hInt₁' hStab₂'.2.2.1 φ_K' hφK'_snd hφK'_sec
    (fun X₁ X₂ f₁ σ₁ f₂ σ₂ hS₁ hS₂ ψ_K hψ_snd hψ_sec =>
