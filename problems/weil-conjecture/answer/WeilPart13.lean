          ⟨w_b, by rw [hub_eq, hwb, pow_succ, mul_assoc]⟩
        have hcoeff0 : (PowerSeries.coeff m) b = 0 :=
          (PowerSeries.X_pow_dvd_iff.mp hdvd_succ) m (Nat.lt_succ_self m)
        exact PowerSeries.coeff_order hb_ne hcoeff0
