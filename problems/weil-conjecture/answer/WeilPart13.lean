    have : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k M_prod).hom := hSepProj M_prod
    have hZ_hom_eq : ι_Z ≫ (weilProjectiveSpaceOver k M_prod).hom = pr₂ ≫ P_Pl.hom :=
