          hPb_WXB hSmWP
    have hSecRange : ∀ (j : Fin n) (x_B : X_B.left),
        π₂.base (ι.base x_B) ∈ Set.range (σ j).left.base →
        x_B ∈ Set.range (σ_B j).left.base := by
      intro j x_B ⟨b₂, hb₂⟩
      let s_Pj : B.left ⟶ P₂ := (σ_B j).left ≫ ι
      have hsPj_p₂ : s_Pj ≫ p₂ = 𝟙 B.left := by
        have h1 : ι ≫ p₂ = f_XB.left := Limits.pullback.lift_snd _ _ _
        rw [Category.assoc, h1]
        exact congrArg CategoryTheory.CommaMorphism.left (hσB j).1
      have hσj_f₂ : (σ j).left ≫ f₂.left = 𝟙 B₂.left :=
        congrArg CategoryTheory.CommaMorphism.left (hFib₂.2.2.1 j)
      have hsPj_π₂ : ψ.left ≫ (σ j).left = s_Pj ≫ π₂ := by
        have h1 : ι ≫ π₂ = q_XB_2.left := Limits.pullback.lift_fst _ _ _
        rw [Category.assoc, h1]
        exact (congrArg CategoryTheory.CommaMorphism.left (hσB j).2).symm
      have hOuter : IsPullback ψ.left (s_Pj ≫ p₂) ((σ j).left ≫ f₂.left) ψ.left := by
        rw [hsPj_p₂, hσj_f₂]
        exact IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, Category.id_comp]⟩
      have hPbSec : IsPullback ψ.left s_Pj (σ j).left π₂ :=
        IsPullback.of_bot hOuter hsPj_π₂ (IsPullback.of_hasPullback f₂.left ψ.left)
      obtain ⟨b', _, hb'⟩ :=
        Scheme.exists_preimage_of_isPullback hPbSec b₂ (ι.base x_B) hb₂
      refine ⟨b', ?_⟩
      apply ι.isClosedEmbedding.injective
      exact hb'
    intro K _ _ s E hE
    let s₂ : Spec (CommRingCat.of K) ⟶ B₂.left := s ≫ ψ.left
    let F_B := Limits.pullback f_XB.left s
    let F₂ := Limits.pullback f₂.left s₂
    let θ_s : F₂ ⟶ P₂ :=
      Limits.pullback.lift (Limits.pullback.fst f₂.left s₂)
        (Limits.pullback.snd f₂.left s₂ ≫ s) (by
          rw [Category.assoc]
          exact Limits.pullback.condition)
    have hPb_θs : IsPullback θ_s (Limits.pullback.snd f₂.left s₂) p₂ s :=
      IsPullback.of_right
        (by
          rw [Limits.pullback.lift_fst]
          exact IsPullback.of_hasPullback f₂.left s₂)
        (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback f₂.left ψ.left)
    let ι_s : F_B ⟶ F₂ :=
      Limits.pullback.lift (Limits.pullback.fst f_XB.left s ≫ q_XB_2.left)
        (Limits.pullback.snd f_XB.left s) (by
          change (Limits.pullback.fst f_XB.left s ≫ q_XB_2.left) ≫ f₂.left =
            Limits.pullback.snd f_XB.left s ≫ (s ≫ ψ.left)
          rw [Category.assoc, hcommXB, ← Category.assoc, Limits.pullback.condition,
            Category.assoc])
    have hcomm_ιs : ι_s ≫ θ_s = Limits.pullback.fst f_XB.left s ≫ ι := by
      apply Limits.pullback.hom_ext
      · have h1 : θ_s ≫ π₂ = Limits.pullback.fst f₂.left s₂ := Limits.pullback.lift_fst _ _ _
        have h2 : ι_s ≫ Limits.pullback.fst f₂.left s₂ =
            Limits.pullback.fst f_XB.left s ≫ q_XB_2.left := Limits.pullback.lift_fst _ _ _
        have h3 : ι ≫ π₂ = q_XB_2.left := Limits.pullback.lift_fst _ _ _
        change (ι_s ≫ θ_s) ≫ π₂ = (Limits.pullback.fst f_XB.left s ≫ ι) ≫ π₂
        rw [Category.assoc, h1, h2, Category.assoc, h3]
      · have h1 : θ_s ≫ p₂ = Limits.pullback.snd f₂.left s₂ ≫ s := Limits.pullback.lift_snd _ _ _
        have h2 : ι_s ≫ Limits.pullback.snd f₂.left s₂ = Limits.pullback.snd f_XB.left s :=
          Limits.pullback.lift_snd _ _ _
        have h3 : ι ≫ p₂ = f_XB.left := Limits.pullback.lift_snd _ _ _
        change (ι_s ≫ θ_s) ≫ p₂ = (Limits.pullback.fst f_XB.left s ≫ ι) ≫ p₂
        rw [Category.assoc, h1, ← Category.assoc, h2, Category.assoc, h3,
          Limits.pullback.condition]
    have hPb_ιs : IsPullback (Limits.pullback.fst f_XB.left s) ι_s ι θ_s :=
      (IsPullback.of_right
        (by
          have h1 : ι_s ≫ Limits.pullback.snd f₂.left s₂ = Limits.pullback.snd f_XB.left s :=
            Limits.pullback.lift_snd _ _ _
          have h2 : ι ≫ p₂ = f_XB.left := Limits.pullback.lift_snd _ _ _
          rw [h1, h2]
          exact (IsPullback.of_hasPullback f_XB.left s).flip)
        hcomm_ιs hPb_θs.flip).flip
    have : IsClosedImmersion ι_s :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ιs hClXB_2
    have hSurj_ιs : Function.Surjective ι_s.base := by
      intro z
      let E₂ : Set ↥F₂ := irreducibleComponent z
      have hE₂_mem : E₂ ∈ irreducibleComponents ↥F₂ :=
        irreducibleComponent_mem_irreducibleComponents z
      have hz_E₂ : z ∈ E₂ := mem_irreducibleComponent
      have hE₂_pre : IsPreirreducible E₂ := isIrreducible_irreducibleComponent.isPreirreducible
      obtain ⟨_, q₀, W₂, hq₀_E₂, hq₀_W₂, hSmW₂⟩ := (hFib₂.2.1.2.2.2 K s₂).2 E₂ hE₂_mem
      let V_sm : Set ↥F₂ := (Limits.pullback.fst f₂.left s₂).base ⁻¹' (W₂ : Set X₂.left)
      have hVsm_open : IsOpen V_sm :=
        W₂.isOpen.preimage (Limits.pullback.fst f₂.left s₂).continuous
      have hVsm_sub : V_sm ⊆ Set.range ι_s.base := by
        intro y hy
        have hy_WP : θ_s.base y ∈ (TopologicalSpace.Opens.map π₂.base).obj W₂ := by
          change π₂.base (θ_s.base y) ∈ W₂
          have h_eq : (θ_s ≫ π₂).base y = (Limits.pullback.fst f₂.left s₂).base y := by
            rw [Limits.pullback.lift_fst]
          exact h_eq.symm ▸ hy
        obtain ⟨x_B, hx_B⟩ := (hSmTransfer W₂ hSmW₂).1 hy_WP
        obtain ⟨y_B, _, hy_B⟩ := Scheme.exists_preimage_of_isPullback hPb_ιs x_B y hx_B
        exact ⟨y_B, hy_B⟩
      by_contra hz_not
      have hOpenCompl : IsOpen (Set.range ι_s.base)ᶜ :=
        ι_s.isClosedEmbedding.isClosed_range.isOpen_compl
      obtain ⟨w, _, hwV, hwNot⟩ :=
        hE₂_pre V_sm (Set.range ι_s.base)ᶜ hVsm_open hOpenCompl
          ⟨q₀, hq₀_E₂, hq₀_W₂⟩ ⟨z, hz_E₂, hz_not⟩
      exact hwNot (hVsm_sub hwV)
    let e_s : ↥F_B ≃ₜ ↥F₂ :=
      ι_s.isClosedEmbedding.isEmbedding.toHomeomorphOfSurjective hSurj_ιs
    let E₂ : Set ↥F₂ := e_s '' E
    have hE₂ : E₂ ∈ irreducibleComponents ↥F₂ := by
      refine ⟨hE.1.image e_s e_s.continuous.continuousOn, ?_⟩
      intro S hS hSub
      have hS' : IsIrreducible (e_s.symm '' S) :=
        hS.image e_s.symm e_s.symm.continuous.continuousOn
      have hES' : E ⊆ e_s.symm '' S := by
        intro q hq
        exact ⟨e_s q, hSub ⟨q, hq, rfl⟩, e_s.symm_apply_apply q⟩
      have hS'_sub : e_s.symm '' S ⊆ E := hE.2 hS' hES'
      intro y hy
      have hy_in : e_s.symm y ∈ E := hS'_sub ⟨y, hy, rfl⟩
      exact ⟨e_s.symm y, hy_in, e_s.apply_symm_apply y⟩
    have hDimE₂ : topologicalKrullDim ↥E₂ = (1 : WithBot ℕ∞) :=
      ((hFib₂.2.1.2.2.2 K s₂).2 E₂ hE₂).1
    have hDimE : topologicalKrullDim ↥E = (1 : WithBot ℕ∞) := by
      rw [(e_s.image E).isHomeomorph.topologicalKrullDim_eq]
      exact hDimE₂
    obtain ⟨j₁, j₂, j₃, q'₁, q'₂, q'₃, W'₁, W'₂, W'₃,
        hne12, hne13, hne23, hq1_E₂, hq2_E₂, hq3_E₂,
        hr1, hr2, hr3, hw1, hSm1, hw2, hSm2, hw3, hSm3⟩ :=
      hFib₂.2.2.2.2 K s₂ E₂ hE₂
    let q₁ : ↥F_B := e_s.symm q'₁
    let q₂ : ↥F_B := e_s.symm q'₂
    let q₃ : ↥F_B := e_s.symm q'₃
    let W₁ : X_B.left.Opens :=
      (TopologicalSpace.Opens.map ι.base).obj ((TopologicalSpace.Opens.map π₂.base).obj W'₁)
    let W₂ : X_B.left.Opens :=
      (TopologicalSpace.Opens.map ι.base).obj ((TopologicalSpace.Opens.map π₂.base).obj W'₂)
    let W₃ : X_B.left.Opens :=
      (TopologicalSpace.Opens.map ι.base).obj ((TopologicalSpace.Opens.map π₂.base).obj W'₃)
    have hProj_eq : ∀ q : ↥F_B,
        π₂.base (ι.base ((Limits.pullback.fst f_XB.left s).base q)) =
          (Limits.pullback.fst f₂.left s₂).base (e_s q) := by
      intro q
      have h1 : ι ≫ π₂ = q_XB_2.left := Limits.pullback.lift_fst _ _ _
      have h2 : ι_s ≫ Limits.pullback.fst f₂.left s₂ =
          Limits.pullback.fst f_XB.left s ≫ q_XB_2.left := Limits.pullback.lift_fst _ _ _
      change ((Limits.pullback.fst f_XB.left s ≫ ι) ≫ π₂).base q =
        (ι_s ≫ Limits.pullback.fst f₂.left s₂).base q
      rw [Category.assoc, h1, h2]
    have hMemE : ∀ {q' : ↥F₂}, q' ∈ E₂ → e_s.symm q' ∈ E := by
      rintro q' ⟨q, hq, rfl⟩
      simpa using hq
    refine ⟨hDimE, j₁, j₂, j₃, q₁, q₂, q₃, W₁, W₂, W₃,
        fun h => hne12 (e_s.symm.injective h),
        fun h => hne13 (e_s.symm.injective h),
        fun h => hne23 (e_s.symm.injective h),
        hMemE hq1_E₂, hMemE hq2_E₂, hMemE hq3_E₂,
        ?_, ?_, ?_, ?_, (hSmTransfer W'₁ hSm1).2, ?_, (hSmTransfer W'₂ hSm2).2,
        ?_, (hSmTransfer W'₃ hSm3).2⟩
    · apply hSecRange j₁
      rw [hProj_eq q₁, e_s.apply_symm_apply]
      exact hr1
    · apply hSecRange j₂
      rw [hProj_eq q₂, e_s.apply_symm_apply]
      exact hr2
    · apply hSecRange j₃
      rw [hProj_eq q₃, e_s.apply_symm_apply]
      exact hr3
    · change π₂.base (ι.base ((Limits.pullback.fst f_XB.left s).base q₁)) ∈ W'₁
      rw [hProj_eq q₁, e_s.apply_symm_apply]
      exact hw1
    · change π₂.base (ι.base ((Limits.pullback.fst f_XB.left s).base q₂)) ∈ W'₂
      rw [hProj_eq q₂, e_s.apply_symm_apply]
      exact hw2
    · change π₂.base (ι.base ((Limits.pullback.fst f_XB.left s).base q₃)) ∈ W'₃
      rw [hProj_eq q₃, e_s.apply_symm_apply]
      exact hw3
  exact ⟨σ_B, hPropXB, hSurjXB, hσB, ⟨hcommXB, hIsoXB_2⟩, hFibXB⟩

theorem weil_graph_strict_transform_correspondence_pullback (k : Type u) [Field k]
    (B₂ X₂ B₃ C₃ X₃ T₃ B C X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂) (n : ℕ) (σ : Fin n → (B₂ ⟶ X₂))
    (U₃ : B₃.left.Opens) (ψ₃ : B₃ ⟶ B₂)
    (g₃ : C₃ ⟶ B₃) (τ₃ : Fin n → (B₃ ⟶ C₃))
    (hτ₃_g₃ : ∀ j : Fin n, τ₃ j ≫ g₃ = 𝟙 B₃)
    (pX₃ : X₃ ⟶ B₃) (qX₃ : X₃ ⟶ X₂)
    (pT₃ : T₃ ⟶ B₃) (rC₃ : T₃ ⟶ C₃) (rX₃ : T₃ ⟶ X₃)
    (hPair : IsOpenGraphStrictTransformPairOver k f₂ σ ψ₃ U₃ g₃ τ₃ pX₃ qX₃ pT₃ rC₃ rX₃)
    (U_good : B₃.left.Opens) (ψ₄ : B ⟶ B₃)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hUgood : Nonempty U_good)
    (hUgoodSub : (U_good : Set B₃.left) ⊆ (U₃ : Set B₃.left))
    (hIsoψ₄ : CategoryTheory.IsIso (ψ₄.left ∣_ U_good))
    (f : C ⟶ B) (q_C : C ⟶ C₃) (τ : Fin n → (B ⟶ C))
    (hPb_C : CategoryTheory.IsPullback q_C.left f.left g₃.left ψ₄.left)
    (hτ_f : ∀ j : Fin n, τ j ≫ f = 𝟙 B)
    (hτ_qC : ∀ j : Fin n, τ j ≫ q_C = ψ₄ ≫ τ₃ j)
    (f_XB : X_B ⟶ B) (q_XB : X_B ⟶ X₃) (σ_B : Fin n → (B ⟶ X_B))
    (hcomm_XB : q_XB.left ≫ pX₃.left = f_XB.left ≫ ψ₄.left)
    (hClXB : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB))
    (hIsoXB : CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift q_XB.left f_XB.left hcomm_XB) ∣_
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd pX₃.left ψ₄.left).base).obj
            ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))))
    (hσB_f : ∀ j : Fin n, σ_B j ≫ f_XB = 𝟙 B)
    (hσB_q : ∀ j : Fin n, σ_B j ≫ (q_XB ≫ qX₃) = (ψ₄ ≫ ψ₃) ≫ σ j)
    (f_TB : T_B ⟶ B) (q_TB : T_B ⟶ T₃)
    (hcomm_TB : q_TB.left ≫ pT₃.left = f_TB.left ≫ ψ₄.left)
    (hIntTB : AlgebraicGeometry.IsIntegral T_B.left)
    (hClTB : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift q_TB.left f_TB.left hcomm_TB))
    (hIsoTB : CategoryTheory.IsIso
      ((CategoryTheory.Limits.pullback.lift q_TB.left f_TB.left hcomm_TB) ∣_
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd pT₃.left ψ₄.left).base).obj
            ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good)))) :
    ∃ (pr₁ : T_B ⟶ C) (pr₂ : T_B ⟶ X_B),
      (∃ hcommTB : pr₁.left ≫ f.left = pr₂.left ≫ f_XB.left,
        pr₁ ≫ f = f_TB ∧
        pr₂ ≫ f_XB = f_TB ∧
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.lift pr₁.left pr₂.left hcommTB)) ∧
      CategoryTheory.IsIso
        (pr₁.left ∣_ ((TopologicalSpace.Opens.map f.left.base).obj
          ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))) ∧
      CategoryTheory.IsIso
        (pr₂.left ∣_ ((TopologicalSpace.Opens.map f_XB.left.base).obj
          ((TopologicalSpace.Opens.map ψ₄.left.base).obj U_good))) ∧
      (∀ j : Fin n, ∃ τ_tilde : B ⟶ T_B,
        τ_tilde ≫ pr₁ = τ j ∧ τ_tilde ≫ pr₂ = σ_B j) :=
by
  have h_lift : ∀ (Y X P : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral Y)
      (U : Y.Opens) (_ : Nonempty U)
      (ι : X ⟶ P) (_ : AlgebraicGeometry.IsClosedImmersion ι)
      (g : Y ⟶ P) (u : U.toScheme ⟶ X),
      u ≫ ι = U.ι ≫ g → ∃ g_tilde : Y ⟶ X, g_tilde ≫ ι = g := by
    intro Y X P hIntY U hU ι hCl g u hu
    have : AlgebraicGeometry.IsIntegral Y := hIntY
    have : AlgebraicGeometry.IsClosedImmersion ι := hCl
    have hker_U : U.ι.ker = ⊥ := by
      rw [← le_bot_iff, AlgebraicGeometry.Scheme.IdealSheafData.le_def]
      intro V
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, le_bot_iff,
        Submodule.eq_bot_iff]
      intro a ha
      rcases isEmpty_or_nonempty ↥V.1 with hEmp | hNonempV
      · have hVbot : V.1 = ⊥ := by
          ext x
          exact ⟨fun hx => False.elim (hEmp.false ⟨x, hx⟩), False.elim⟩
        have hSub : Subsingleton ↑(Y.presheaf.obj (Opposite.op V.1)) := by
          rw [hVbot]
          infer_instance
        exact @Subsingleton.elim _ hSub a 0
      · have : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y
        obtain ⟨v₀⟩ := hNonempV
        obtain ⟨u₀⟩ := hU
        have hInter : ((V.1 : Set ↥Y) ∩ (U : Set ↥Y)).Nonempty :=
          nonempty_preirreducible_inter V.1.2 U.2 ⟨v₀.1, v₀.2⟩ ⟨u₀.1, u₀.2⟩
        obtain ⟨x, hxV, hxU⟩ := hInter
        obtain ⟨s, hs_le_U, hx_s⟩ := V.2.exists_basicOpen_le (⟨x, hxU⟩ : ↥U) hxV
        have hcomp_s : Y.homOfLE hs_le_U ≫ U.ι = (Y.basicOpen s).ι :=
          Y.homOfLE_ι hs_le_U
        have hker_le_s : U.ι.ker ≤ (Y.basicOpen s).ι.ker := by
          rw [← hcomp_s]
          exact AlgebraicGeometry.Scheme.Hom.le_ker_comp (Y.homOfLE hs_le_U) U.ι
        have ha_s : a ∈ ((Y.basicOpen s).ι.ker).ideal V :=
          (AlgebraicGeometry.Scheme.IdealSheafData.le_def.mp hker_le_s V) ha
        have ha_app : (((Y.basicOpen s).ι).app V.1).hom a = 0 :=
          AlgebraicGeometry.Scheme.Hom.ideal_ker_le (Y.basicOpen s).ι V ha_s
        have hs_ne : s ≠ 0 := by
          intro hs0
          rw [hs0, Y.basicOpen_zero V.1] at hx_s
          exact hx_s
        have : IsDomain ↑(Y.presheaf.obj (Opposite.op V.1)) :=
          @AlgebraicGeometry.IsIntegral.component_integral Y hIntY V.1 ⟨⟨v₀.1, v₀.2⟩⟩
        have : IsLocalization.Away s ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s))) :=
          V.2.isLocalization_basicOpen s
        have hinj : Function.Injective
            (algebraMap ↑(Y.presheaf.obj (Opposite.op V.1))
              ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s)))) :=
          IsLocalization.injective _
            (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hs_ne))
        have hmap_eq :
            (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op).hom a = 0 := by
          have h_comp_app : ∀ {W : Y.Opens} (hw : W ≤ V.1) (hsub : Y.basicOpen s ≤ W),
              (Y.presheaf.map (CategoryTheory.homOfLE hw).op).hom a = 0 →
              (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op).hom a = 0 := by
            intro W hw hsub h0
            have h1 : CategoryTheory.homOfLE (Y.basicOpen_le s) =
                CategoryTheory.homOfLE hsub ≫ CategoryTheory.homOfLE hw :=
              Subsingleton.elim _ _
            rw [h1, CategoryTheory.op_comp, Y.presheaf.map_comp, CommRingCat.hom_comp,
              RingHom.comp_apply, h0, map_zero]
          rw [AlgebraicGeometry.Scheme.Opens.ι_app] at ha_app
          refine h_comp_app _ (fun z hz => ?_) ha_app
          exact ⟨⟨z, hz⟩, Y.basicOpen_le s hz, rfl⟩
        have halg : (algebraMap ↑(Y.presheaf.obj (Opposite.op V.1))
            ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen s)))) a =
            (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op).hom a := rfl
        apply hinj
        rw [halg, hmap_eq, map_zero]
    have hker_le : ι.ker ≤ g.ker := by
      calc
        ι.ker ≤ (u ≫ ι).ker := AlgebraicGeometry.Scheme.Hom.le_ker_comp u ι
        _ = (U.ι ≫ g).ker := by rw [hu]
        _ = (U.ι.ker).map g := AlgebraicGeometry.Scheme.Hom.ker_comp U.ι g
        _ = (⊥ : Y.IdealSheafData).map g := by rw [hker_U]
        _ = g.ker := AlgebraicGeometry.Scheme.IdealSheafData.map_bot g
    exact ⟨AlgebraicGeometry.IsClosedImmersion.lift ι g hker_le,
      AlgebraicGeometry.IsClosedImmersion.lift_fac ι g hker_le⟩
  have h_open_iso : ∀ (Y₃ Y_B : AlgebraicGeometry.Scheme.{u})
      (pY₃ : Y₃ ⟶ B₃.left) (r : T₃.left ⟶ Y₃) (_ : r ≫ pY₃ = pT₃.left)
      (_ : CategoryTheory.IsIso (r ∣_ ((TopologicalSpace.Opens.map pY₃.base).obj U₃)))
      (f_YB : Y_B ⟶ B.left) (q_YB : Y_B ⟶ Y₃)
      (hcomm_YB : q_YB ≫ pY₃ = f_YB ≫ ψ₄.left)
