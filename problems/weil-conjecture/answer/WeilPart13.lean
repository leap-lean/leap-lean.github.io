        rw [← hunder]
        exact Ideal.comap_mono bot_le
      let M_other : Set (Ideal ↑(F.presheaf.obj (Opposite.op V_z))) :=
        minimalPrimes ↑(F.presheaf.obj (Opposite.op V_z)) \ {p_bot}
      have hFinM : M_other.Finite :=
        (minimalPrimes.finite_of_isNoetherianRing ↑(F.presheaf.obj (Opposite.op V_z))).diff
      let F_other : Set (PrimeSpectrum ↑(F.presheaf.obj (Opposite.op V_z))) :=
        ⋃ m ∈ M_other, PrimeSpectrum.zeroLocus (m : Set ↑(F.presheaf.obj (Opposite.op V_z)))
      have hClosedF : IsClosed F_other :=
        hFinM.isClosed_biUnion fun m _ =>
          PrimeSpectrum.isClosed_zeroLocus (m : Set ↑(F.presheaf.obj (Opposite.op V_z)))
      let U_spec : Set (PrimeSpectrum ↑(F.presheaf.obj (Opposite.op V_z))) := F_otherᶜ
      have hOpenU : IsOpen U_spec := hClosedF.isOpen_compl
      have hq_mem : q_pt ∈ U_spec := by
        intro hmem
        rw [Set.mem_iUnion₂] at hmem
        obtain ⟨m, hm_other, hq_zl⟩ := hmem
        have hm_min : m ∈ minimalPrimes ↑(F.presheaf.obj (Opposite.op V_z)) := hm_other.1
        have hm_ne : m ≠ p_bot := hm_other.2
        have hm_prime : m.IsPrime := hm_min.1.1
        have hm_le_q₀ : m ≤ q₀ := SetLike.coe_subset_coe.mp hq_zl
