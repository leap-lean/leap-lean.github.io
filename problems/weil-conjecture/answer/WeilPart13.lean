          have h1 : IsLocalRing.residue D (u 1) • ((1 : κ_D) ⊗ₜ[D] e₁_D) =
              (1 : κ_D) ⊗ₜ[D] (u 1 • e₁_D) := by
            change (u 1 • (1 : κ_D)) ⊗ₜ[D] e₁_D = (1 : κ_D) ⊗ₜ[D] (u 1 • e₁_D)
