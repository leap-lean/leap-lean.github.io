  · intro W_a hWa C_a g_a τ_a hStab_a hIso_a U_Wa
    let V_a : C_a.Opens := (TopologicalSpace.Opens.map (g_a ≫ W_a.ι).base).obj U₃
    obtain ⟨ι_a, hcomm_a, hOpen_a, hRange_a, _⟩ := hIso_a
