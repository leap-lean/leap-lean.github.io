          change ev_loc₀ ((HomogeneousLocalization.fromZeroRingHom 𝒜₀ _ (algebraMap k ↥(𝒜₀ 0) c)).val) = c
          rw [← HomogeneousLocalization.algebraMap_eq]
          change ev_loc₀ (algebraMap (MvPolynomial (Fin 1) k) (Localization.Away X₀)
            (algebraMap k (MvPolynomial (Fin 1) k) c)) = c
          rw [IsLocalization.Away.lift_eq]
          simp [ev₀]
        rw [h_ring, AlgebraicGeometry.Spec.map_id]
      have : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k 0).hom := hSepProj 0
      have : AlgebraicGeometry.IsClosedImmersion
          (σ₀ ≫ (weilProjectiveSpaceOver k 0).hom) := by
        rw [hσ₀_comp]
        infer_instance
      have hCl_σ₀ : AlgebraicGeometry.IsClosedImmersion σ₀ :=
        AlgebraicGeometry.IsClosedImmersion.of_comp σ₀ (weilProjectiveSpaceOver k 0).hom
      exact ⟨0, CategoryTheory.Over.homMk σ₀ hσ₀_comp, hCl_σ₀⟩
    let S₀ := CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    let mor₁ : S ⟶ S₀ := CategoryTheory.Over.homMk S.hom (CategoryTheory.Category.comp_id S.hom)
    let mor₂ : P_Pl ⟶ S₀ := CategoryTheory.Over.homMk P_Pl.hom (CategoryTheory.Category.comp_id P_Pl.hom)
    obtain ⟨M_prod, ι_prod, hCl_prod⟩ := hSegre S P_Pl S₀ mor₁ mor₂ hProjS hProjP hProjSpec
    let Z : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback S.hom P_Pl.hom
    let pr₁ : Z ⟶ S.left := CategoryTheory.Limits.pullback.fst S.hom P_Pl.hom
    let pr₂ : Z ⟶ P_Pl.left := CategoryTheory.Limits.pullback.snd S.hom P_Pl.hom
    let ι_Z : Z ⟶ (weilProjectiveSpaceOver k M_prod).left := ι_prod.left
    have : AlgebraicGeometry.IsClosedImmersion ι_Z := hCl_prod
    let γ : U'.toScheme ⟶ Z := CategoryTheory.Limits.pullback.lift U'.ι Φ hΦ_hom.symm
