    [FiniteDimensional κ₀ E₁] [Algebra.IsSeparable κ₀ E₁]
    (π₁ : F₀ →ₐ[κ₀] E₁) (j₁ : E₁ →ₐ[κ₀] K)
    (q_K : Ideal (TensorProduct κ₀ K F₀))
    (hSurj₁ : Function.Surjective π₁)
    (hq_K : q_K = RingHom.ker (Algebra.TensorProduct.lift (AlgHom.id K K) (j₁.comp π₁)
