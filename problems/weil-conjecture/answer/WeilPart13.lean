      (Submodule.liftQ (Submodule.restrictScalars K J_std) L₅ hJ_ker).comp
        (Submodule.Quotient.restrictScalarsEquiv K J_std).symm.toLinearMap
    have hΛ_mk : ∀ P : MvPolynomial (Fin 2) K, Λ (Ideal.Quotient.mk J_std P) = L₅ P :=
      fun _ => rfl
    have hev10_1 : ev₁₀ 1 = 1 := map_one ev₁₀
    have hev01_1 : ev₀₁ 1 = 1 := map_one ev₀₁
    have hev10_X0 : ev₁₀ (MvPolynomial.X 0) = Polynomial.X := by simp [ev₁₀]
    have hev10_X1 : ev₁₀ (MvPolynomial.X 1) = 0 := by simp [ev₁₀]
    have hev01_X0 : ev₀₁ (MvPolynomial.X 0) = 0 := by simp [ev₀₁]
    have hev01_X1 : ev₀₁ (MvPolynomial.X 1) = Polynomial.X := by simp [ev₀₁]
    have hΛ_1 : Λ 1 = ![1, 0, 0, 0, 0] := by
      change Λ (Ideal.Quotient.mk J_std 1) = _
      rw [hΛ_mk]
      ext ⟨i, hi⟩
      rcases i with _ | _ | _ | _ | _ | n
      · change (ev₁₀ 1).coeff 0 = 1; rw [hev10_1, Polynomial.coeff_one_zero]
      · change (ev₁₀ 1).coeff 1 = 0; rw [hev10_1, Polynomial.coeff_one]; simp
      · change (ev₀₁ 1).coeff 1 = 0; rw [hev01_1, Polynomial.coeff_one]; simp
      · change (ev₁₀ 1).coeff 2 = 0; rw [hev10_1, Polynomial.coeff_one]; simp
      · change (ev₀₁ 1).coeff 2 = 0; rw [hev01_1, Polynomial.coeff_one]; simp
      · omega
    have hΛ_x0 : Λ x₀ = ![0, 1, 0, 0, 0] := by
      dsimp [x₀]; rw [hΛ_mk]
      ext ⟨i, hi⟩
      rcases i with _ | _ | _ | _ | _ | n
      · change (ev₁₀ (MvPolynomial.X 0)).coeff 0 = 0; rw [hev10_X0, Polynomial.coeff_X_zero]
      · change (ev₁₀ (MvPolynomial.X 0)).coeff 1 = 1; rw [hev10_X0, Polynomial.coeff_X_one]
      · change (ev₀₁ (MvPolynomial.X 0)).coeff 1 = 0; rw [hev01_X0, Polynomial.coeff_zero]
      · change (ev₁₀ (MvPolynomial.X 0)).coeff 2 = 0; rw [hev10_X0]; simp [Polynomial.coeff_X]
      · change (ev₀₁ (MvPolynomial.X 0)).coeff 2 = 0; rw [hev01_X0, Polynomial.coeff_zero]
      · omega
    have hΛ_x1 : Λ x₁ = ![0, 0, 1, 0, 0] := by
      dsimp [x₁]; rw [hΛ_mk]
      ext ⟨i, hi⟩
      rcases i with _ | _ | _ | _ | _ | n
      · change (ev₁₀ (MvPolynomial.X 1)).coeff 0 = 0; rw [hev10_X1, Polynomial.coeff_zero]
      · change (ev₁₀ (MvPolynomial.X 1)).coeff 1 = 0; rw [hev10_X1, Polynomial.coeff_zero]
      · change (ev₀₁ (MvPolynomial.X 1)).coeff 1 = 1; rw [hev01_X1, Polynomial.coeff_X_one]
      · change (ev₁₀ (MvPolynomial.X 1)).coeff 2 = 0; rw [hev10_X1, Polynomial.coeff_zero]
      · change (ev₀₁ (MvPolynomial.X 1)).coeff 2 = 0; rw [hev01_X1]; simp [Polynomial.coeff_X]
      · omega
    have hΛ_x0_sq : Λ (x₀ ^ 2) = ![0, 0, 0, 1, 0] := by
      change Λ (Ideal.Quotient.mk J_std (MvPolynomial.X 0 ^ 2)) = _
      rw [hΛ_mk]
      ext ⟨i, hi⟩
      rcases i with _ | _ | _ | _ | _ | n
      · change (ev₁₀ (MvPolynomial.X 0 ^ 2)).coeff 0 = 0
        rw [map_pow, hev10_X0]; simp [Polynomial.coeff_X_pow]
      · change (ev₁₀ (MvPolynomial.X 0 ^ 2)).coeff 1 = 0
        rw [map_pow, hev10_X0]; simp [Polynomial.coeff_X_pow]
      · change (ev₀₁ (MvPolynomial.X 0 ^ 2)).coeff 1 = 0
        rw [map_pow, hev01_X0, zero_pow (by norm_num : 2 ≠ 0), Polynomial.coeff_zero]
      · change (ev₁₀ (MvPolynomial.X 0 ^ 2)).coeff 2 = 1
        rw [map_pow, hev10_X0]; simp [Polynomial.coeff_X_pow]
      · change (ev₀₁ (MvPolynomial.X 0 ^ 2)).coeff 2 = 0
        rw [map_pow, hev01_X0, zero_pow (by norm_num : 2 ≠ 0), Polynomial.coeff_zero]
      · omega
    have hΛ_x1_sq : Λ (x₁ ^ 2) = ![0, 0, 0, 0, 1] := by
      change Λ (Ideal.Quotient.mk J_std (MvPolynomial.X 1 ^ 2)) = _
      rw [hΛ_mk]
      ext ⟨i, hi⟩
      rcases i with _ | _ | _ | _ | _ | n
      · change (ev₁₀ (MvPolynomial.X 1 ^ 2)).coeff 0 = 0
        rw [map_pow, hev10_X1, zero_pow (by norm_num : 2 ≠ 0), Polynomial.coeff_zero]
      · change (ev₁₀ (MvPolynomial.X 1 ^ 2)).coeff 1 = 0
        rw [map_pow, hev10_X1, zero_pow (by norm_num : 2 ≠ 0), Polynomial.coeff_zero]
      · change (ev₀₁ (MvPolynomial.X 1 ^ 2)).coeff 1 = 0
        rw [map_pow, hev01_X1]; simp [Polynomial.coeff_X_pow]
      · change (ev₁₀ (MvPolynomial.X 1 ^ 2)).coeff 2 = 0
        rw [map_pow, hev10_X1, zero_pow (by norm_num : 2 ≠ 0), Polynomial.coeff_zero]
      · change (ev₀₁ (MvPolynomial.X 1 ^ 2)).coeff 2 = 1
        rw [map_pow, hev01_X1]; simp [Polynomial.coeff_X_pow]
      · omega
    let S₅ : (Fin 5 → K) →ₗ[K] T_std :=
      { toFun := fun c => c 0 • 1 + c 1 • x₀ + c 2 • x₁ + c 3 • x₀ ^ 2 + c 4 • x₁ ^ 2
        map_add' := fun a b => by simp only [Pi.add_apply, add_smul]; abel
        map_smul' := fun r a => by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply,
          mul_smul, smul_add] }
    have hΛS : ∀ c : Fin 5 → K, Λ (S₅ c) = c := by
      intro c
      ext i
      change Λ (c 0 • 1 + c 1 • x₀ + c 2 • x₁ + c 3 • x₀ ^ 2 + c 4 • x₁ ^ 2) i = c i
      simp only [map_add, map_smul, hΛ_1, hΛ_x0, hΛ_x1, hΛ_x0_sq, hΛ_x1_sq,
        Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      fin_cases i <;> simp
    have hx0_x1 : x₀ * x₁ = 0 := by
      change Ideal.Quotient.mk J_std (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    have hx1_x0 : x₁ * x₀ = 0 := by rw [mul_comm, hx0_x1]
    have hx0_cube : x₀ * x₀ ^ 2 = 0 := by
      change Ideal.Quotient.mk J_std (MvPolynomial.X 0 * MvPolynomial.X 0 ^ 2) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) ∈
          Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :=
        Ideal.subset_span (Set.mem_insert _ _)
      have h3 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) * MvPolynomial.X 0 ^ 2 =
          MvPolynomial.X 0 ^ 3 := by ring
      rw [h3]
      exact Ideal.mem_sup_right (Ideal.pow_mem_pow hX0 3)
    have hx1_cube : x₁ * x₁ ^ 2 = 0 := by
      change Ideal.Quotient.mk J_std (MvPolynomial.X 1 * MvPolynomial.X 1 ^ 2) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) K) ∈
          Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :=
        Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      have h3 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) K) * MvPolynomial.X 1 ^ 2 =
          MvPolynomial.X 1 ^ 3 := by ring
      rw [h3]
      exact Ideal.mem_sup_right (Ideal.pow_mem_pow hX1 3)
    have hx0_x1_sq : x₀ * x₁ ^ 2 = 0 := by
      rw [sq, ← mul_assoc, hx0_x1, zero_mul]
    have hx1_x0_sq : x₁ * x₀ ^ 2 = 0 := by
      rw [sq, ← mul_assoc, hx1_x0, zero_mul]
    have hS_surj : ∀ y : T_std, y ∈ LinearMap.range S₅ := by
      have hmul0 : ∀ y ∈ LinearMap.range S₅, x₀ * y ∈ LinearMap.range S₅ := by
        rintro _ ⟨c, rfl⟩
        refine ⟨![0, c 0, 0, c 1, 0], ?_⟩
        change (0 : K) • 1 + c 0 • x₀ + (0 : K) • x₁ + c 1 • x₀ ^ 2 + (0 : K) • x₁ ^ 2 =
          x₀ * (c 0 • 1 + c 1 • x₀ + c 2 • x₁ + c 3 • x₀ ^ 2 + c 4 • x₁ ^ 2)
        simp only [mul_add, mul_smul_comm, mul_one, ← sq, hx0_x1, hx0_cube, hx0_x1_sq,
          smul_zero, zero_smul, add_zero, zero_add]
      have hmul1 : ∀ y ∈ LinearMap.range S₅, x₁ * y ∈ LinearMap.range S₅ := by
        rintro _ ⟨c, rfl⟩
        refine ⟨![0, 0, c 0, 0, c 2], ?_⟩
        change (0 : K) • 1 + (0 : K) • x₀ + c 0 • x₁ + (0 : K) • x₀ ^ 2 + c 2 • x₁ ^ 2 =
          x₁ * (c 0 • 1 + c 1 • x₀ + c 2 • x₁ + c 3 • x₀ ^ 2 + c 4 • x₁ ^ 2)
        simp only [mul_add, mul_smul_comm, mul_one, ← sq, hx1_x0, hx1_cube, hx1_x0_sq,
          smul_zero, zero_smul, add_zero, zero_add]
      intro y
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective y
      induction P using MvPolynomial.induction_on with
      | C a =>
        refine ⟨![a, 0, 0, 0, 0], ?_⟩
        change a • (1 : T_std) + (0 : K) • x₀ + (0 : K) • x₁ + (0 : K) • x₀ ^ 2 + (0 : K) • x₁ ^ 2 =
          Ideal.Quotient.mk J_std (MvPolynomial.C a)
        simp only [zero_smul, add_zero]
        rw [Algebra.smul_def, mul_one]
        rfl
      | add p q hp hq =>
        rw [map_add]
        exact (LinearMap.range S₅).add_mem hp hq
      | mul_X p i hp =>
        rw [map_mul, mul_comm]
        fin_cases i
        · exact hmul0 _ hp
        · exact hmul1 _ hp
    have hSΛ : ∀ y : T_std, S₅ (Λ y) = y := by
      intro y
      obtain ⟨c, rfl⟩ := hS_surj y
      rw [hΛS]
    let e₅ : T_std ≃ₗ[K] (Fin 5 → K) :=
      LinearEquiv.ofLinear Λ S₅ (LinearMap.ext hΛS) (LinearMap.ext hSΛ)
    have hRank5 : Module.finrank K T_std = 5 := by
      rw [e₅.finrank_eq, Module.finrank_fin_fun]
    let ev₀ : MvPolynomial (Fin 2) K →ₐ[K] K := MvPolynomial.aeval 0
    have hJ_ev₀ : ∀ P ∈ J_std, ev₀ P = 0 := by
      intro P hP
      obtain ⟨p₁, hp₁, p₂, hp₂, rfl⟩ := Submodule.mem_sup.mp hP
      rw [map_add]
      have hp1_0 : ev₀ p₁ = 0 := by
        obtain ⟨Q, rfl⟩ := Ideal.mem_span_singleton.mp hp₁
        simp [ev₀, map_mul]
      have hp2_0 : ev₀ p₂ = 0 := by
        have hm : ev₀ p₂ ∈ Ideal.map ev₀.toRingHom
            (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K), MvPolynomial.X 1} ^ 3) :=
          Ideal.mem_map_of_mem _ hp₂
        have hsub : Ideal.map ev₀.toRingHom
            (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K), MvPolynomial.X 1}) ≤ ⊥ := by
          rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
          rintro p (rfl | rfl) <;> simp [ev₀]
        rw [Ideal.map_pow] at hm
        have hbot : ev₀ p₂ ∈ (⊥ : Ideal K) :=
          (Ideal.pow_le_self (by norm_num : 3 ≠ 0)) (pow_le_pow_left' hsub 3 hm)
        exact Ideal.mem_bot.mp hbot
      rw [hp1_0, hp2_0, add_zero]
    let ε₀ : T_std →+* K := Ideal.Quotient.lift J_std ev₀.toRingHom hJ_ev₀
    have hε₀_smul : ∀ (c : K) (y : T_std), ε₀ (c • y) = c * ε₀ y := by
      intro c y
      rw [Algebra.smul_def, map_mul]
      have hc : ε₀ (algebraMap K T_std c) = c := by
        change Ideal.Quotient.lift J_std ev₀.toRingHom hJ_ev₀
          (Ideal.Quotient.mk J_std (MvPolynomial.C c)) = c
        simp [ev₀]
      rw [hc]
    have hΛ0_eq_ε₀ : ∀ y : T_std, Λ y 0 = ε₀ y := by
      intro y
      conv_rhs => rw [← hSΛ y]
      change Λ y 0 = ε₀ (Λ y 0 • 1 + Λ y 1 • x₀ + Λ y 2 • x₁ + Λ y 3 • x₀ ^ 2 + Λ y 4 • x₁ ^ 2)
      have hε0_x0 : ε₀ x₀ = 0 := by
        change ev₀ (MvPolynomial.X 0) = 0
        simp [ev₀]
      have hε0_x1 : ε₀ x₁ = 0 := by
        change ev₀ (MvPolynomial.X 1) = 0
        simp [ev₀]
      simp [map_add, hε₀_smul, map_pow, hε0_x0, hε0_x1]
    have h_mem_𝔫_iff : ∀ y : T_std, y ∈ 𝔫 ↔ Λ y 0 = 0 := by
      intro y
      constructor
      · intro hy
        rw [hΛ0_eq_ε₀]
        have hle : 𝔫 ≤ RingHom.ker ε₀ := by
          rw [Ideal.span_le]
          rintro z (rfl | rfl)
          · change ev₀ (MvPolynomial.X 0) = 0; simp [ev₀]
          · change ev₀ (MvPolynomial.X 1) = 0; simp [ev₀]
        exact hle hy
      · intro hy0
        rw [← hSΛ y]
        change Λ y 0 • 1 + Λ y 1 • x₀ + Λ y 2 • x₁ + Λ y 3 • x₀ ^ 2 + Λ y 4 • x₁ ^ 2 ∈ 𝔫
        rw [hy0, zero_smul, zero_add]
        have hx0_mem : x₀ ∈ 𝔫 := Ideal.subset_span (Set.mem_insert _ _)
        have hx1_mem : x₁ ∈ 𝔫 := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
        refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_) ?_
        · rw [Algebra.smul_def]; exact Ideal.mul_mem_left _ _ hx0_mem
        · rw [Algebra.smul_def]; exact Ideal.mul_mem_left _ _ hx1_mem
        · rw [Algebra.smul_def, sq]; exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hx0_mem)
        · rw [Algebra.smul_def, sq]; exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hx1_mem)
    have h𝔫_cube : 𝔫 ^ 3 = ⊥ := by
      have hmap : 𝔫 = Ideal.map (Ideal.Quotient.mk J_std)
          (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K), MvPolynomial.X 1}) := by
        dsimp [𝔫, x₀, x₁]
        rw [Ideal.map_span, Set.image_pair]
      rw [hmap, ← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
      have hker : RingHom.ker (Ideal.Quotient.mk J_std) = J_std := Ideal.mk_ker
      rw [hker]
      exact le_sup_right
    have hNil : ∀ y : T_std, y ∈ 𝔫 ↔ IsNilpotent y := by
      intro y
      constructor
      · intro hy
        refine ⟨3, ?_⟩
        have h3 : y ^ 3 ∈ (⊥ : Ideal T_std) := h𝔫_cube ▸ Ideal.pow_mem_pow hy 3
        exact Ideal.mem_bot.mp h3
      · rintro ⟨n, hn⟩
        rw [h_mem_𝔫_iff, hΛ0_eq_ε₀]
        have hpow : (ε₀ y) ^ n = 0 := by rw [← map_pow, hn, map_zero]
        exact eq_zero_of_pow_eq_zero hpow
    have h_prod_𝔫 : ∀ u v : T_std, u ∈ 𝔫 → v ∈ 𝔫 →
        u * v = (Λ u 1 * Λ v 1) • x₀ ^ 2 + (Λ u 2 * Λ v 2) • x₁ ^ 2 := by
      intro u v hu hv
      have hu0 : Λ u 0 = 0 := (h_mem_𝔫_iff u).mp hu
      have hv0 : Λ v 0 = 0 := (h_mem_𝔫_iff v).mp hv
      have hu_eq : u = Λ u 1 • x₀ + Λ u 2 • x₁ + Λ u 3 • x₀ ^ 2 + Λ u 4 • x₁ ^ 2 := by
        have h := (hSΛ u).symm
        change u = Λ u 0 • 1 + Λ u 1 • x₀ + Λ u 2 • x₁ + Λ u 3 • x₀ ^ 2 + Λ u 4 • x₁ ^ 2 at h
        rw [hu0, zero_smul, zero_add] at h
        exact h
      have hv_eq : v = Λ v 1 • x₀ + Λ v 2 • x₁ + Λ v 3 • x₀ ^ 2 + Λ v 4 • x₁ ^ 2 := by
        have h := (hSΛ v).symm
        change v = Λ v 0 • 1 + Λ v 1 • x₀ + Λ v 2 • x₁ + Λ v 3 • x₀ ^ 2 + Λ v 4 • x₁ ^ 2 at h
        rw [hv0, zero_smul, zero_add] at h
        exact h
      have hx0_sq_x0 : x₀ ^ 2 * x₀ = 0 := by rw [mul_comm, hx0_cube]
      have hx1_sq_x1 : x₁ ^ 2 * x₁ = 0 := by rw [mul_comm, hx1_cube]
      have hx0_sq_x1 : x₀ ^ 2 * x₁ = 0 := by rw [mul_comm, hx1_x0_sq]
      have hx1_sq_x0 : x₁ ^ 2 * x₀ = 0 := by rw [mul_comm, hx0_x1_sq]
      have hx0_4 : x₀ ^ 2 * x₀ ^ 2 = 0 := by
        nth_rw 2 [sq x₀]
        rw [← mul_assoc, hx0_sq_x0, zero_mul]
      have hx1_4 : x₁ ^ 2 * x₁ ^ 2 = 0 := by
        nth_rw 2 [sq x₁]
        rw [← mul_assoc, hx1_sq_x1, zero_mul]
      have hx02_x12 : x₀ ^ 2 * x₁ ^ 2 = 0 := by rw [sq x₁, ← mul_assoc, hx0_sq_x1, zero_mul]
      have hx12_x02 : x₁ ^ 2 * x₀ ^ 2 = 0 := by rw [sq x₀, ← mul_assoc, hx1_sq_x0, zero_mul]
      conv_lhs => rw [hu_eq, hv_eq]
      simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm]
      simp only [← sq x₀, ← sq x₁, hx0_x1, hx1_x0, hx0_cube, hx1_cube, hx0_x1_sq, hx1_x0_sq,
        hx0_sq_x0, hx1_sq_x1, hx0_sq_x1, hx1_sq_x0, hx0_4, hx1_4, hx02_x12, hx12_x02,
        smul_zero, add_zero, zero_add]
      rw [smul_smul, smul_smul, mul_comm (Λ v 1), mul_comm (Λ v 2)]
    let I_sq : Ideal T_std :=
      { carrier := {q : T_std | Λ q 0 = 0 ∧ Λ q 1 = 0 ∧ Λ q 2 = 0}
        add_mem' := fun {a b} ha hb => by
          change Λ (a + b) 0 = 0 ∧ Λ (a + b) 1 = 0 ∧ Λ (a + b) 2 = 0
          simp only [map_add, Pi.add_apply, ha.1, ha.2.1, ha.2.2,
            hb.1, hb.2.1, hb.2.2, add_zero, and_self]
        zero_mem' := by simp
        smul_mem' := fun r q hq => by
          rcases hq with ⟨hq0, hq1, hq2⟩
          have hq_eq : q = Λ q 3 • x₀ ^ 2 + Λ q 4 • x₁ ^ 2 := by
            have h := (hSΛ q).symm
            change q = Λ q 0 • 1 + Λ q 1 • x₀ + Λ q 2 • x₁ + Λ q 3 • x₀ ^ 2 + Λ q 4 • x₁ ^ 2 at h
            simp only [hq0, hq1, hq2, zero_smul, zero_add] at h
            exact h
          have hr_eq : r = Λ r 0 • 1 + Λ r 1 • x₀ + Λ r 2 • x₁ + Λ r 3 • x₀ ^ 2 + Λ r 4 • x₁ ^ 2 :=
            (hSΛ r).symm
          have hrq : r • q = (Λ r 0 * Λ q 3) • x₀ ^ 2 + (Λ r 0 * Λ q 4) • x₁ ^ 2 := by
            rw [smul_eq_mul]
            conv_lhs => rw [hr_eq, hq_eq]
            have hx0_4 : x₀ ^ 2 * x₀ ^ 2 = 0 := by
              nth_rw 2 [sq x₀]
              rw [← mul_assoc, mul_comm (x₀ ^ 2) x₀, hx0_cube, zero_mul]
            have hx1_4 : x₁ ^ 2 * x₁ ^ 2 = 0 := by
              nth_rw 2 [sq x₁]
              rw [← mul_assoc, mul_comm (x₁ ^ 2) x₁, hx1_cube, zero_mul]
            have hx02_x12 : x₀ ^ 2 * x₁ ^ 2 = 0 := by
              rw [sq x₁, ← mul_assoc, mul_comm (x₀ ^ 2) x₁, hx1_x0_sq, zero_mul]
            have hx12_x02 : x₁ ^ 2 * x₀ ^ 2 = 0 := by
              rw [sq x₀, ← mul_assoc, mul_comm (x₁ ^ 2) x₀, hx0_x1_sq, zero_mul]
            simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, smul_smul, one_mul,
              hx0_cube, hx1_cube, hx0_x1_sq, hx1_x0_sq, hx0_4, hx1_4, hx02_x12, hx12_x02,
              smul_zero, add_zero]
            rw [mul_comm (Λ q 3), mul_comm (Λ q 4)]
          change Λ (r • q) 0 = 0 ∧ Λ (r • q) 1 = 0 ∧ Λ (r • q) 2 = 0
          rw [hrq]
