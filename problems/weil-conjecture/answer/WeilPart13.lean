                    (MvPolynomial.X (e.symm ij)) (hX M (e.symm ij)) zero_lt_one).base).obj
                  (AlgebraicGeometry.Proj.basicOpen _ (MvPolynomial.X (e.symm ij₀))) :=
              Eq.mp (congrArg
                (· ∈ (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
                  (MvPolynomial.X (e.symm ij₀)) : Set _)) hσ_x.symm) hp_basic
            rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen _ (hX M (e.symm ij)) zero_lt_one
              (hX M (e.symm ij₀)) zero_lt_one] at hq_pre
            have hq_not_mem : φ ij (r_M (e.symm ij) (e.symm ij₀)) ∉ q.asIdeal := hq_pre
            rw [hφ_ratio ij (e.symm ij₀), e.apply_symm_apply] at hq_not_mem
            have h_prod_tmul : (r₁ ij.1 ij₀.1) ⊗ₜ[k] (r₂ ij.2 ij₀.2) =
                (Algebra.TensorProduct.includeLeftRingHom (r₁ ij.1 ij₀.1)) *
                (Algebra.TensorProduct.includeRight (r₂ ij.2 ij₀.2)) := by
              change _ = ((r₁ ij.1 ij₀.1) ⊗ₜ[k] (1 : B ij.2)) * ((1 : A ij.1) ⊗ₜ[k] (r₂ ij.2 ij₀.2))
              simp
            rw [h_prod_tmul] at hq_not_mem
            have h_not_L : Algebra.TensorProduct.includeLeftRingHom (r₁ ij.1 ij₀.1) ∉ q.asIdeal :=
              fun h => hq_not_mem (q.asIdeal.mul_mem_right _ h)
            have h_not_R : (Algebra.TensorProduct.includeRight :
                B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2)) (r₂ ij.2 ij₀.2) ∉ q.asIdeal :=
              fun h => hq_not_mem (q.asIdeal.mul_mem_left _ h)
            have h_fst_mem : (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base p ∈
                Set.range (𝒰₁.f ij₀.1).base := by
              let inL_hom : A ij.1 →+* TensorProduct k (A ij.1) (B ij.2) :=
                Algebra.TensorProduct.includeLeftRingHom
              have h_pre₁ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inL_hom)).base q_pt ∈
                  (TopologicalSpace.Opens.map
                    (AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k)
                      (MvPolynomial.X ij.1) (hX N₁ ij.1) zero_lt_one).base).obj
                    (AlgebraicGeometry.Proj.basicOpen _ (MvPolynomial.X ij₀.1)) := by
                rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen _ (hX N₁ ij.1) zero_lt_one
                  (hX N₁ ij₀.1) zero_lt_one]
                exact h_not_L
              have h_eq₁ : (𝒰₁.f ij.1).base
                  ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom inL_hom)).base q_pt) =
                  (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base p :=
                (congrArg (fun m => (𝒰₁.f ij.1).base (m.base x)) (hθ_fst ij)).trans
                  ((congrArg (fun m => m.base x) (h𝒰₁₂_fst ij).symm).trans
                    (congrArg (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base hx))
              have h_in_basic : (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base p ∈
                  AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k) (MvPolynomial.X ij₀.1) :=
                Eq.mp (congrArg
                  (· ∈ (AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k)
                    (MvPolynomial.X ij₀.1) : Set _)) h_eq₁) h_pre₁
              have h_rng₁ : (AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k) (MvPolynomial.X ij₀.1) :
                    Set (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k))) =
                  Set.range (𝒰₁.f ij₀.1).base :=
                (congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι _ _ _ _)).symm.trans
                  (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰₁.f ij₀.1))
              exact h_rng₁.subset h_in_basic
            have h_snd_mem : (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base p ∈
                Set.range (𝒰₂.f ij₀.2).base := by
              let inR_hom : B ij.2 →+* TensorProduct k (A ij.1) (B ij.2) :=
                ↑(Algebra.TensorProduct.includeRight :
                  B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))
              have h_pre₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inR_hom)).base q_pt ∈
                  (TopologicalSpace.Opens.map
                    (AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k)
                      (MvPolynomial.X ij.2) (hX N₂ ij.2) zero_lt_one).base).obj
                    (AlgebraicGeometry.Proj.basicOpen _ (MvPolynomial.X ij₀.2)) := by
                rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen _ (hX N₂ ij.2) zero_lt_one
                  (hX N₂ ij₀.2) zero_lt_one]
                exact h_not_R
              have h_eq₂ : (𝒰₂.f ij.2).base
                  ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom inR_hom)).base q_pt) =
                  (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base p :=
                (congrArg (fun m => (𝒰₂.f ij.2).base (m.base x)) (hθ_snd ij)).trans
                  ((congrArg (fun m => m.base x) (h𝒰₁₂_snd ij).symm).trans
                    (congrArg (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base hx))
              have h_in_basic : (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base p ∈
                  AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k) (MvPolynomial.X ij₀.2) :=
                Eq.mp (congrArg
                  (· ∈ (AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k)
                    (MvPolynomial.X ij₀.2) : Set _)) h_eq₂) h_pre₂
              have h_rng₂ : (AlgebraicGeometry.Proj.basicOpen
                    (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k) (MvPolynomial.X ij₀.2) :
                    Set (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k))) =
                  Set.range (𝒰₂.f ij₀.2).base :=
                (congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι _ _ _ _)).symm.trans
                  (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰₂.f ij₀.2))
              exact h_rng₂.subset h_in_basic
            have h_rng12 : Set.range (𝒰₁₂.f ij₀).base =
                (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base ⁻¹' Set.range (𝒰₁.f ij₀.1).base ∩
                  (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base ⁻¹' Set.range (𝒰₂.f ij₀.2).base :=
              (congrArg (fun m => Set.range m.base)
                (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂) ij₀)).trans
                (AlgebraicGeometry.Scheme.Pullback.range_map _ _ _ _ _ _ _ _ _)
            exact h_rng12.symm.subset ⟨h_fst_mem, h_snd_mem⟩
          · rintro ⟨x, rfl⟩
            exact ⟨g₀.base x, (congrArg (fun m => m.base x) h_comm₀).symm⟩
        have h_pb : CategoryTheory.IsPullback (𝒰₁₂.f ij₀) g₀ σ (𝒰_M.f (e.symm ij₀)) :=
          (AlgebraicGeometry.IsOpenImmersion.isPullback g₀ (𝒰₁₂.f ij₀)
            (𝒰_M.f (e.symm ij₀)) σ h_comm₀ h_opens).flip
        have h_pull_eq : AlgebraicGeometry.Scheme.Cover.pullbackHom 𝒰_M σ (e.symm ij₀) =
            h_pb.isoPullback.inv ≫ g₀ :=
          h_pb.isoPullback_inv_snd.symm
        have hCl_spec : AlgebraicGeometry.IsClosedImmersion
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀))) :=
          AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ (hφ_surj ij₀)
        have hCl_g₀ : AlgebraicGeometry.IsClosedImmersion g₀ :=
          @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ (θ ij₀).hom _ inferInstance hCl_spec
        have hCl_inv_g₀ : AlgebraicGeometry.IsClosedImmersion (h_pb.isoPullback.inv ≫ g₀) :=
          @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ h_pb.isoPullback.inv g₀
            inferInstance hCl_g₀
        exact Eq.mpr (congrArg AlgebraicGeometry.IsClosedImmersion h_pull_eq) hCl_inv_g₀
      exact ⟨σ, hCl_σ, hσ_hom⟩

    obtain ⟨σ, hCl_σ, hσ_hom⟩ := hSegre
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (j_tot ≫ σ) :=
      @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ j_tot σ hCl_jtot hCl_σ
    have h_over : (j_tot ≫ σ) ≫ (weilProjectiveSpaceOver k M).hom = C₃.hom := by
      rw [Category.assoc, hσ_hom, ← Category.assoc]
      exact hj_tot_hom
    exact ⟨M, CategoryTheory.Over.homMk (j_tot ≫ σ) h_over, hCl_comp⟩

  obtain ⟨N₃, ι_B, hCl_B⟩ := hProjB₃
  obtain ⟨s₀, r₀, U, hAffU, hCovU, j_loc, T, hCl_j, hComm_j, hT_id, hT_cocycle, j_ov, h_ov⟩ :=
    hAtlas
  have hNonemptyB₃ : Nonempty ↥B₃.left :=
    (@AlgebraicGeometry.irreducibleSpace_of_isIntegral B₃.left hIntB₃).toNonempty
  let 𝒜_P := MvPolynomial.homogeneousSubmodule (Fin (N₃ + 1)) k
  letI : GradedAlgebra 𝒜_P := MvPolynomial.gradedAlgebra
  obtain ⟨s'₀, U', μ, u, hSub, hAffU', hCovU', hu_id, hu_basic, hu_mul⟩ :=
    hPart1 k B₃.left hNonemptyB₃ N₃ s₀ 𝒜_P (hIrrelGen k N₃)
      (fun ℓ => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k ℓ))
      ι_B.left hCl_B U hAffU hCovU
  have hAffU'_ov : ∀ β γ : Fin (s'₀ + 1), AlgebraicGeometry.IsAffineOpen (U' β ⊓ U' γ) := by
    intro β γ
    rw [hu_basic β γ]
    exact (hAffU' β).basicOpen (u γ β)
  let T' : ∀ β γ : Fin (s'₀ + 1),
      Matrix.GeneralLinearGroup (Fin (r₀ + 1))
        ↑(B₃.left.presheaf.obj (Opposite.op (U' β ⊓ U' γ))) :=
    fun β γ =>
      Units.map ((B₃.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub γ))).op).hom.mapMatrix).toMonoidHom
        (T (μ β) (μ γ))
  have hT'_val : ∀ β γ : Fin (s'₀ + 1),
      (T' β γ).val = Matrix.map (T (μ β) (μ γ)).val
        (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub γ))).op).hom :=
    fun β γ => RingHom.mapMatrix_apply _ _
  have hT'_id : ∀ β : Fin (s'₀ + 1), (T' β β).val = 1 := by
    intro β
    have h1 : T (μ β) (μ β) = 1 := Units.ext (hT_id (μ β))
    rw [show T' β β = 1 by dsimp only [T']; rw [h1, map_one], Units.val_one]
  have hT'_cocycle : ∀ β γ α : Fin (s'₀ + 1),
      let u₁ : U' β ⊓ U' γ ⊓ U' α ⟶ U' β ⊓ U' γ := CategoryTheory.homOfLE inf_le_left
      let u₂ : U' β ⊓ U' γ ⊓ U' α ⟶ U' γ ⊓ U' α :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
      let u₃ : U' β ⊓ U' γ ⊓ U' α ⟶ U' β ⊓ U' α :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
      Matrix.map (T' β γ).val (B₃.left.presheaf.map u₁.op).hom *
        Matrix.map (T' γ α).val (B₃.left.presheaf.map u₂.op).hom =
        Matrix.map (T' β α).val (B₃.left.presheaf.map u₃.op).hom := by
    intro β γ α u₁ u₂ u₃
    rw [hT'_val, hT'_val, hT'_val, Matrix.map_map, Matrix.map_map, Matrix.map_map]
    let w_ov : U' β ⊓ U' γ ⊓ U' α ⟶ U (μ β) ⊓ U (μ γ) ⊓ U (μ α) :=
      CategoryTheory.homOfLE (inf_le_inf (inf_le_inf (hSub β) (hSub γ)) (hSub α))
    let v₁ : U (μ β) ⊓ U (μ γ) ⊓ U (μ α) ⟶ U (μ β) ⊓ U (μ γ) :=
      CategoryTheory.homOfLE inf_le_left
    let v₂ : U (μ β) ⊓ U (μ γ) ⊓ U (μ α) ⟶ U (μ γ) ⊓ U (μ α) :=
      CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
    let v₃ : U (μ β) ⊓ U (μ γ) ⊓ U (μ α) ⟶ U (μ β) ⊓ U (μ α) :=
      CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
    have hc₁ : ((B₃.left.presheaf.map u₁.op).hom ∘
        (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub γ))).op).hom) =
        ((B₃.left.presheaf.map w_ov.op).hom ∘ (B₃.left.presheaf.map v₁.op).hom) := by
      funext x
      change (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom x =
        (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom x
      rw [← B₃.left.presheaf.map_comp, ← B₃.left.presheaf.map_comp]
      rfl
    have hc₂ : ((B₃.left.presheaf.map u₂.op).hom ∘
        (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_inf (hSub γ) (hSub α))).op).hom) =
        ((B₃.left.presheaf.map w_ov.op).hom ∘ (B₃.left.presheaf.map v₂.op).hom) := by
      funext x
      change (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom x =
        (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom x
      rw [← B₃.left.presheaf.map_comp, ← B₃.left.presheaf.map_comp]
      rfl
    have hc₃ : ((B₃.left.presheaf.map u₃.op).hom ∘
        (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub α))).op).hom) =
        ((B₃.left.presheaf.map w_ov.op).hom ∘ (B₃.left.presheaf.map v₃.op).hom) := by
      funext x
      change (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom x =
        (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom x
      rw [← B₃.left.presheaf.map_comp, ← B₃.left.presheaf.map_comp]
      rfl
    rw [hc₁, hc₂, hc₃, ← Matrix.map_map, ← Matrix.map_map, ← Matrix.map_map]
    have h_mul_map : ∀ (M_L M_R : Matrix (Fin (r₀ + 1)) (Fin (r₀ + 1))
        ↑(B₃.left.presheaf.obj (Opposite.op (U (μ β) ⊓ U (μ γ) ⊓ U (μ α))))),
        Matrix.map M_L (B₃.left.presheaf.map w_ov.op).hom *
          Matrix.map M_R (B₃.left.presheaf.map w_ov.op).hom =
        Matrix.map (M_L * M_R) (B₃.left.presheaf.map w_ov.op).hom := by
      intro M_L M_R; ext i j; simp [Matrix.mul_apply, map_sum, map_mul]
    rw [h_mul_map, hT_cocycle (μ β) (μ γ) (μ α)]
  obtain ⟨v, Q, hQ_id, hQ_cocycle'⟩ :=
    hPart2 B₃.left s'₀ r₀ U' hAffU' u hu_id hu_basic hu_mul T' hT'_id hT'_cocycle
  have hQ_cocycle : ∀ β γ α : Fin (s'₀ + 1),
      Matrix.map (T (μ β) (μ γ)).val
          (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub γ))).op).hom *
        Matrix.map (Q γ α) (B₃.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom =
        (v β γ).val •
          Matrix.map (Q β α) (B₃.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom := by
    intro β γ α
    rw [← hT'_val β γ]
    exact hQ_cocycle' β γ α
  obtain ⟨hProjPB, hProjSurjClosed⟩ := hPart3
  obtain ⟨M₁, j_glob, hj_hom, hCl_jglob⟩ :=
    hPart4 k B₃ C₃ g₃ s₀ r₀ U hAffU j_loc T hCl_j hComm_j j_ov h_ov
      s'₀ U' μ hSub hAffU' hAffU'_ov hCovU' v Q hQ_id hQ_cocycle hProjPB hProjSurjClosed
  exact hPart5 k M₁ N₃ B₃ C₃ ι_B hCl_B j_glob hj_hom hCl_jglob

theorem weil_normal_base_stable_curve_gluing_and_projectivity (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₃ : B₃.left.Opens)
    (ψ₃ : B₃ ⟶ B₂)
    (hIntB₃ : AlgebraicGeometry.IsIntegral B₃.left)
    (hProjB₃ : IsProjectiveOverField k B₃)
    (hNormB₃ : ∀ U : B₃.left.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      IsIntegrallyClosed ↑(B₃.left.presheaf.obj (Opposite.op U)))
    (hU₃ : Nonempty U₃)
    (hU₃Sub : (U₃ : Set B₃.left) ⊆ ψ₃.left.base ⁻¹' (U₂ : Set B₂.left))
    (N : ℕ)
    (W : Fin N → B₃.left.Opens)
    (hCover : (⋃ a : Fin N, (W a : Set B₃.left)) = Set.univ)
    (hWNonempty : ∀ a : Fin N, Nonempty ↥(W a))
    (C_loc : Fin N → AlgebraicGeometry.Scheme.{u})
    (g_loc : ∀ a : Fin N, C_loc a ⟶ (W a).toScheme)
    (τ_loc : ∀ a : Fin N, Fin n → ((W a).toScheme ⟶ C_loc a))
    (hStabLoc : ∀ a : Fin N, IsGeometricStablePointedCurve (g_loc a) n (τ_loc a))
    (hIsoLoc : ∀ a : Fin N, HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ (W a) (g_loc a) (τ_loc a)) :
    ∃ (C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (g₃ : C₃ ⟶ B₃)
      (τ₃ : Fin n → (B₃ ⟶ C₃)),
      IsGeometricStablePointedCurve g₃.left n (fun j => (τ₃ j).left) ∧
      AlgebraicGeometry.IsIntegral C₃.left ∧
      IsProjectiveOverField k C₃ ∧
      HasOpenPointedCurvePullbackIsoOver k f₂ σ ψ₃ U₃ g₃ τ₃ :=
by
  have hHartogs : ∀ (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
      [IsIntegrallyClosed B₀] (L : Type u) [Field L] [Algebra B₀ L] [IsFractionRing B₀ L]
      (r : ℕ) (M : Matrix.GeneralLinearGroup (Fin r) L),
      (∀ (p : PrimeSpectrum B₀),
        p.asIdeal ≠ ⊥ →
        IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) →
        ∀ i j : Fin r,
          (∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * M.val i j = algebraMap B₀ L a) ∧
          (∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * (M⁻¹).val i j = algebraMap B₀ L a)) →
      ∃ M₀ : Matrix.GeneralLinearGroup (Fin r) B₀,
        ∀ i j : Fin r, algebraMap B₀ L (M₀.val i j) = M.val i j := by
    intro B₀ _ _ _ _ L _ _ _ r M hDVR
    have hLocalDVR : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
        [IsLocalRing A] [IsIntegrallyClosed A],
        ¬IsField A →
        ∀ (b_A c_A : A),
          b_A ≠ 0 →
          b_A ∈ IsLocalRing.maximalIdeal A →
          (¬∃ u : A, b_A * u = c_A) →
          (∀ m ∈ IsLocalRing.maximalIdeal A, ∃ u : A, m * c_A = b_A * u) →
          IsDiscreteValuationRing A := by
      intro A _ _ _ _ _ hNotField b_A c_A hb_ne hb_max h_not_dvd h_max_dvd
      apply ((IsDiscreteValuationRing.TFAE A hNotField).out 1 5).mpr
      let f_K : A →+* FractionRing A := algebraMap A (FractionRing A)
      have hinj_AK : Function.Injective f_K := IsFractionRing.injective A (FractionRing A)
      have hbK_ne : f_K b_A ≠ 0 := fun h => hb_ne (hinj_AK (h.trans (map_zero _).symm))
      let w : FractionRing A := f_K c_A / f_K b_A
      have hw_mul : f_K b_A * w = f_K c_A := mul_div_cancel₀ _ hbK_ne
      have hw_not_int : ¬∃ u : A, f_K u = w := by
        rintro ⟨u, hu⟩
        apply h_not_dvd
        refine ⟨u, hinj_AK ?_⟩
        rw [map_mul, hu, hw_mul]
      have hw_map_max : ∀ m ∈ IsLocalRing.maximalIdeal A,
          ∃ u : A, w * f_K m = f_K u := by
        intro m hm
        obtain ⟨u, hmu⟩ := h_max_dvd m hm
        refine ⟨u, ?_⟩
        apply mul_left_cancel₀ hbK_ne
        calc f_K b_A * (w * f_K m)
            = f_K m * (f_K b_A * w) := by ring
          _ = f_K (m * c_A) := by rw [hw_mul, map_mul]
          _ = f_K b_A * f_K u := by rw [hmu, map_mul]
      have hw_not_into_max : ∃ m₀ ∈ IsLocalRing.maximalIdeal A,
          ∃ u₀ : A, w * f_K m₀ = f_K u₀ ∧ u₀ ∉ IsLocalRing.maximalIdeal A := by
        by_contra hAllInMax
        push Not at hAllInMax
        let f_lin := Algebra.linearMap A (FractionRing A)
        let N : Submodule A (FractionRing A) :=
          Submodule.map f_lin (IsLocalRing.maximalIdeal A)
        have hN_ne_bot : N ≠ ⊥ := by
          intro hbot
          have hmem : f_lin b_A ∈ N := Submodule.mem_map_of_mem hb_max
          rw [hbot, Submodule.mem_bot] at hmem
          exact hbK_ne hmem
        have hN_fg : N.FG :=
          (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A)).map f_lin
        have : IsScalarTower A (FractionRing A) (FractionRing A) := IsScalarTower.right
        have hw_int : IsIntegral A w := by
          apply isIntegral_of_smul_mem_submodule N hN_ne_bot hN_fg w
          intro n hn
          rcases Submodule.mem_map.mp hn with ⟨m, hm, rfl⟩
          obtain ⟨u, hu⟩ := hw_map_max m hm
          have hu_max : u ∈ IsLocalRing.maximalIdeal A := hAllInMax m hm u hu
          change w * f_K m ∈ N
          rw [hu]
          exact Submodule.mem_map_of_mem hu_max
        exact hw_not_int ((IsIntegrallyClosed.isIntegral_iff
          (R := A) (K := FractionRing A)).mp hw_int)
      obtain ⟨m₀, hm₀, u₀, hu₀_eq, hu₀_not_max⟩ := hw_not_into_max
      have hu₀_unit : IsUnit u₀ := IsLocalRing.notMem_maximalIdeal.mp hu₀_not_max
      obtain ⟨v₀, hv₀⟩ := hu₀_unit.exists_left_inv
      let ϖ : A := v₀ * m₀
      have hϖ_mem : ϖ ∈ IsLocalRing.maximalIdeal A := Ideal.mul_mem_left _ _ hm₀
      have hw_ϖ : w * f_K ϖ = 1 := by
        calc w * f_K (v₀ * m₀)
            = f_K v₀ * (w * f_K m₀) := by rw [map_mul]; ring
          _ = f_K (v₀ * u₀) := by rw [hu₀_eq, ← map_mul]
          _ = 1 := by rw [hv₀, map_one]
      refine ⟨⟨ϖ, ?_⟩⟩
      ext m
      simp only [Ideal.submodule_span_eq, Ideal.mem_span_singleton]
      constructor
      · intro hm
        obtain ⟨u, hu⟩ := hw_map_max m hm
        refine ⟨u, ?_⟩
        apply hinj_AK
        calc f_K m
            = (w * f_K ϖ) * f_K m := by rw [hw_ϖ, one_mul]
          _ = f_K ϖ * (w * f_K m) := by ring
          _ = f_K (ϖ * u) := by rw [hu, ← map_mul]
      · rintro ⟨u, rfl⟩
        exact Ideal.mul_mem_right _ _ hϖ_mem
    have hScalar : ∀ (z : L),
        (∀ (p : PrimeSpectrum B₀),
          p.asIdeal ≠ ⊥ →
          IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) →
          ∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * z = algebraMap B₀ L a) →
        ∃ d : B₀, algebraMap B₀ L d = z := by
      intro z hz
      by_contra hNotMem
      obtain ⟨a₀, b₀, hb₀_nzd, hz_eq⟩ := IsFractionRing.div_surjective (A := B₀) z
      have hb₀_ne : b₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb₀_nzd
      have hinj_B₀L : Function.Injective (algebraMap B₀ L) := IsFractionRing.injective B₀ L
      have hb₀L_ne : algebraMap B₀ L b₀ ≠ 0 :=
        fun h => hb₀_ne (hinj_B₀L (h.trans (map_zero _).symm))
      have h_bz : algebraMap B₀ L b₀ * z = algebraMap B₀ L a₀ := by
        rw [← hz_eq, mul_div_cancel₀ _ hb₀L_ne]
      have ha₀_not_mem : a₀ ∉ Ideal.span ({b₀} : Set B₀) := by
        intro ha₀_mem
        rw [Ideal.mem_span_singleton] at ha₀_mem
        obtain ⟨d, rfl⟩ := ha₀_mem
        apply hNotMem
        refine ⟨d, ?_⟩
        apply mul_left_cancel₀ hb₀L_ne
        rw [← map_mul, h_bz]
      let I_b₀ : Ideal B₀ := Ideal.span ({b₀} : Set B₀)
      let S_ann : Set (Ideal B₀) :=
        {I : Ideal B₀ | ∃ c : B₀, c ∉ I_b₀ ∧ I = Submodule.colon I_b₀ {c} ∧
          Submodule.colon I_b₀ {a₀} ≤ I}
      have hS_nonempty : S_ann.Nonempty :=
        ⟨Submodule.colon I_b₀ {a₀}, a₀, ha₀_not_mem, rfl, le_refl _⟩
      obtain ⟨P_sub, ⟨c₀, hc₀_not_mem, hP_eq, hP_colon⟩, hP_max⟩ :=
        set_has_maximal_iff_noetherian.mpr ‹IsNoetherianRing B₀› S_ann hS_nonempty
      let P : Ideal B₀ := P_sub
      have hP_mem_iff : ∀ x : B₀, x ∈ P ↔ x * c₀ ∈ I_b₀ := by
        intro x
        change x ∈ P_sub ↔ x * c₀ ∈ I_b₀
        rw [hP_eq, Submodule.mem_colon_singleton]
        simp [smul_eq_mul]
      have hP_ne_top : P ≠ ⊤ := by
        intro htop
        have h1 : (1 : B₀) ∈ P := by rw [htop]; trivial
        rw [hP_mem_iff, one_mul] at h1
        exact hc₀_not_mem h1
      have hP_prime : P.IsPrime := by
        refine ⟨hP_ne_top, ?_⟩
        intro u v huv
        by_cases hv : v ∈ P
        · right; exact hv
        · left
          have hvc₀_not_mem : v * c₀ ∉ I_b₀ := (hP_mem_iff v).not.mp hv
          let Q_id : Ideal B₀ := Submodule.colon I_b₀ {v * c₀}
          have hP_le_Q : P_sub ≤ Q_id := by
            intro x hx
            rw [Submodule.mem_colon_singleton]
            simp only [smul_eq_mul]
            have hxc : x * c₀ ∈ I_b₀ := (hP_mem_iff x).mp hx
            have h_eq : x * (v * c₀) = v * (x * c₀) := by ring
            rw [h_eq]
            exact Ideal.mul_mem_left I_b₀ v hxc
          have hQ_in_S : Q_id ∈ S_ann :=
            ⟨v * c₀, hvc₀_not_mem, rfl, le_trans hP_colon hP_le_Q⟩
          have hQ_eq_P : P_sub = Q_id := by
            by_contra hne
            exact hP_max Q_id hQ_in_S (lt_of_le_of_ne hP_le_Q hne)
          have hu_in_Q : u ∈ Q_id := by
            rw [Submodule.mem_colon_singleton]
            simp only [smul_eq_mul]
            have h_eq : u * (v * c₀) = (u * v) * c₀ := by ring
            rw [h_eq]
            exact (hP_mem_iff (u * v)).mp huv
          change u ∈ P_sub
          rwa [hQ_eq_P]
      have : P.IsPrime := hP_prime
      have hb₀_mem_P : b₀ ∈ P := by
        apply hP_colon
        rw [Submodule.mem_colon_singleton]
        simp only [smul_eq_mul]
        exact Ideal.mem_span_singleton.mpr ⟨a₀, rfl⟩
      have hP_ne_bot : P ≠ ⊥ := by
        intro hbot
        rw [hbot, Ideal.mem_bot] at hb₀_mem_P
        exact hb₀_ne hb₀_mem_P
      have : IsIntegrallyClosed (Localization.AtPrime P) :=
        isIntegrallyClosed_of_isLocalization (Localization.AtPrime P) P.primeCompl
          (Ideal.primeCompl_le_nonZeroDivisors P)
      have hinj_B₀A : Function.Injective (algebraMap B₀ (Localization.AtPrime P)) :=
        IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
      have hb₀A_ne : algebraMap B₀ (Localization.AtPrime P) b₀ ≠ 0 :=
        fun h => hb₀_ne (hinj_B₀A (h.trans (map_zero _).symm))
      have hb₀A_max : algebraMap B₀ (Localization.AtPrime P) b₀ ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P b₀).mpr hb₀_mem_P
      have hNotFieldA : ¬IsField (Localization.AtPrime P) := by
        intro hF
        obtain ⟨v, hv⟩ := hF.mul_inv_cancel hb₀A_ne
        have hUnit : IsUnit (algebraMap B₀ (Localization.AtPrime P) b₀) :=
          isUnit_iff_exists_inv.mpr ⟨v, hv⟩
        exact (IsLocalRing.notMem_maximalIdeal.mpr hUnit) hb₀A_max
      have hDVR_A : IsDiscreteValuationRing (Localization.AtPrime P) := by
        apply hLocalDVR (Localization.AtPrime P) hNotFieldA
          (algebraMap B₀ (Localization.AtPrime P) b₀)
          (algebraMap B₀ (Localization.AtPrime P) c₀)
          hb₀A_ne hb₀A_max
        · rintro ⟨u, hu⟩
          obtain ⟨⟨r, s⟩, hus⟩ := IsLocalization.surj P.primeCompl u
          have h_sc : (s : B₀) * c₀ = b₀ * r := by
            apply hinj_B₀A
            calc algebraMap B₀ (Localization.AtPrime P) ((s : B₀) * c₀)
                = algebraMap B₀ (Localization.AtPrime P) (s : B₀) *
                    (algebraMap B₀ (Localization.AtPrime P) b₀ * u) := by rw [hu, map_mul]
              _ = algebraMap B₀ (Localization.AtPrime P) b₀ *
                    (u * algebraMap B₀ (Localization.AtPrime P) (s : B₀)) := by ring
              _ = algebraMap B₀ (Localization.AtPrime P) (b₀ * r) := by rw [hus, map_mul]
          exact s.2 ((hP_mem_iff (s : B₀)).mpr (Ideal.mem_span_singleton.mpr ⟨r, h_sc⟩))
        · intro m hm
          obtain ⟨⟨x, s⟩, hms⟩ := IsLocalization.surj P.primeCompl m
          have hxA_max : algebraMap B₀ (Localization.AtPrime P) x ∈
              IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
            rw [← hms]
            exact Ideal.mul_mem_right _ _ hm
          have hx_in_P : x ∈ P :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P x).mp hxA_max
          obtain ⟨d, hxc_eq⟩ := Ideal.mem_span_singleton.mp ((hP_mem_iff x).mp hx_in_P)
          refine ⟨IsLocalization.mk' (Localization.AtPrime P) d s, ?_⟩
          have hsA_ne : algebraMap B₀ (Localization.AtPrime P) (s : B₀) ≠ 0 :=
            fun h => s.2 (by rw [hinj_B₀A (h.trans (map_zero _).symm)]; exact P.zero_mem)
          apply mul_right_cancel₀ hsA_ne
          have hu_spec : IsLocalization.mk' (Localization.AtPrime P) d s *
              algebraMap B₀ (Localization.AtPrime P) (s : B₀) =
              algebraMap B₀ (Localization.AtPrime P) d :=
            IsLocalization.mk'_spec (Localization.AtPrime P) d s
          calc (m * algebraMap B₀ (Localization.AtPrime P) c₀) *
                algebraMap B₀ (Localization.AtPrime P) (s : B₀)
              = (m * algebraMap B₀ (Localization.AtPrime P) (s : B₀)) *
                  algebraMap B₀ (Localization.AtPrime P) c₀ := by ring
            _ = algebraMap B₀ (Localization.AtPrime P) (x * c₀) := by rw [hms, map_mul]
            _ = algebraMap B₀ (Localization.AtPrime P) (b₀ * d) := by rw [hxc_eq]
            _ = algebraMap B₀ (Localization.AtPrime P) b₀ *
                  (IsLocalization.mk' (Localization.AtPrime P) d s *
                    algebraMap B₀ (Localization.AtPrime P) (s : B₀)) := by rw [hu_spec, map_mul]
            _ = (algebraMap B₀ (Localization.AtPrime P) b₀ *
                  IsLocalization.mk' (Localization.AtPrime P) d s) *
                  algebraMap B₀ (Localization.AtPrime P) (s : B₀) := by ring
      obtain ⟨a, b, hb_not_P, h_bz_a⟩ := hz ⟨P, hP_prime⟩ hP_ne_bot hDVR_A
      have h_ba₀ : b * a₀ = b₀ * a := by
        apply hinj_B₀L
        calc algebraMap B₀ L (b * a₀)
            = algebraMap B₀ L b * (algebraMap B₀ L b₀ * z) := by rw [h_bz, map_mul]
          _ = algebraMap B₀ L b₀ * (algebraMap B₀ L b * z) := by ring
          _ = algebraMap B₀ L (b₀ * a) := by rw [h_bz_a, map_mul]
      have hb_in_P : b ∈ P := by
        apply hP_colon
        rw [Submodule.mem_colon_singleton]
        simp only [smul_eq_mul]
        exact Ideal.mem_span_singleton.mpr ⟨a, h_ba₀⟩
      exact hb_not_P hb_in_P
    choose A₀ hA₀ using fun i j : Fin r =>
      hScalar (M.val i j) (fun p hp hdvr => (hDVR p hp hdvr i j).1)
    choose B₀_inv hB₀_inv using fun i j : Fin r =>
      hScalar ((M⁻¹).val i j) (fun p hp hdvr => (hDVR p hp hdvr i j).2)
    have hinj : Function.Injective (algebraMap B₀ L) := IsFractionRing.injective B₀ L
    have h_mul : Matrix.of A₀ * Matrix.of B₀_inv = 1 := by
      ext i k
      apply hinj
      simp only [Matrix.mul_apply, Matrix.of_apply, map_sum, map_mul, hA₀, hB₀_inv]
      change (M.val * (M⁻¹).val) i k = algebraMap B₀ L ((1 : Matrix (Fin r) (Fin r) B₀) i k)
      rw [Units.mul_inv]
      by_cases hik : i = k <;> simp [Matrix.one_apply, hik]
    have h_inv_mul : Matrix.of B₀_inv * Matrix.of A₀ = 1 := by
      ext i k
      apply hinj
      simp only [Matrix.mul_apply, Matrix.of_apply, map_sum, map_mul, hA₀, hB₀_inv]
      change ((M⁻¹).val * M.val) i k = algebraMap B₀ L ((1 : Matrix (Fin r) (Fin r) B₀) i k)
      rw [Units.inv_mul]
      by_cases hik : i = k <;> simp [Matrix.one_apply, hik]
    refine ⟨⟨Matrix.of A₀, Matrix.of B₀_inv, h_mul, h_inv_mul⟩, ?_⟩
    intro i j
    exact hA₀ i j
  obtain ⟨hMakeAtlas, hBridge⟩ := weil_log_tricanonical_bundle_and_matrix_criterion k
  obtain ⟨C₃, g₃, τ₃, hStab₃, hIntC₃, hIso₃⟩ :=
    weil_normal_base_local_stable_curve_gluing k B₂ U₂ X₂ f₂ n σ hFib₂
      B₃ U₃ ψ₃ hIntB₃ hProjB₃ hNormB₃ hU₃ hU₃Sub N W hCover hWNonempty
      C_loc g_loc τ_loc hStabLoc hIsoLoc hBridge
      (fun R _ _ _ _ K _ _ _ C₁ C₂ g₁ τ₁ g₂ τ₂ hStab₁ hStab₂ hSm₁ φ_K hφK_snd hφK_sec =>
        weil_dvr_stable_pointed_curve_iso_extension k R K n C₁ C₂ g₁ τ₁ g₂ τ₂
          hStab₁ hStab₂ hSm₁ φ_K hφK_snd hφK_sec)
      hHartogs
  have hAtlas : HasGLProjBundleAtlas g₃.left :=
    hMakeAtlas B₃ hIntB₃ hProjB₃ C₃.left g₃.left n (fun j => (τ₃ j).left) hStab₃
  have hProjC₃ : IsProjectiveOverField k C₃ :=
    weil_gl_proj_bundle_atlas_to_isProjectiveOverField k B₃ C₃ hIntB₃ hProjB₃ g₃ hAtlas
  exact ⟨C₃, g₃, τ₃, hStab₃, hIntC₃, hProjC₃, hIso₃⟩

theorem weil_flat_finPres_curve_affine_dichotomy_at_point (C S : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ S)
    (hFlat : AlgebraicGeometry.Flat g)
    (hFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (hGeom : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S)
      (y : ↥(CategoryTheory.Limits.pullback g s)),
      (∃ V : (CategoryTheory.Limits.pullback g s).Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V.ι ≫ CategoryTheory.Limits.pullback.snd g s)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ CategoryTheory.Limits.pullback g s)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ CategoryTheory.Limits.pullback.snd g s =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))))
    (x : C) :
    (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
    (∃ (U_S : S.Opens) (hAffS : AlgebraicGeometry.IsAffineOpen U_S)
        (U_C : C.Opens) (hAffC : AlgebraicGeometry.IsAffineOpen U_C)
        (hLE : U_C ≤ (TopologicalSpace.Opens.map g.base).obj U_S)
        (q₀ : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op U_C))),
      hAffS.fromSpec.base (PrimeSpectrum.comap (g.appLE U_S U_C hLE).hom q₀) = g.base x ∧
      hAffC.fromSpec.base q₀ = x ∧
      (g.appLE U_S U_C hLE).hom.Flat ∧
      (g.appLE U_S U_C hLE).hom.FinitePresentation ∧
      HasGeomFiberNodalRoofAt (g.appLE U_S U_C hLE).hom q₀) :=
by
  have h_s4 : ∀ (U_S : S.Opens) (hAffS : AlgebraicGeometry.IsAffineOpen U_S)
      (U_C : C.Opens) (hAffC : AlgebraicGeometry.IsAffineOpen U_C)
      (hLE : U_C ≤ (TopologicalSpace.Opens.map g.base).obj U_S)
      (q₀ : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op U_C)))
      (hq₀_x : hAffC.fromSpec.base q₀ = x)
      (f : ↑(C.presheaf.obj (Opposite.op U_C))) (_ : f ∉ q₀.asIdeal),
      RingHom.IsStandardSmoothOfRelativeDimension 1
        ((algebraMap ↑(C.presheaf.obj (Opposite.op U_C)) (Localization.Away f)).comp
          (g.appLE U_S U_C hLE).hom) →
      ∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g) := by
    clear hFlat hFP hGeom
    intro U_S hAffS U_C hAffC hLE q₀ hq₀_x f hf hSm
    let V : C.Opens := C.basicOpen f
    have hxV : x ∈ V := by
      change x ∈ C.basicOpen f
      rw [← hAffC.fromSpec_image_basicOpen f]
      exact ⟨q₀, hf, hq₀_x⟩
    have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffC.basicOpen f
    have hLE_V : V ≤ (TopologicalSpace.Opens.map g.base).obj U_S :=
      (C.basicOpen_le f).trans hLE
    have : IsLocalization.Away f ↑(C.presheaf.obj (Opposite.op V)) :=
      hAffC.isLocalization_basicOpen f
    let e_loc : Localization.Away f ≃ₐ[↑(C.presheaf.obj (Opposite.op U_C))]
        ↑(C.presheaf.obj (Opposite.op V)) :=
      IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f)
        ↑(C.presheaf.obj (Opposite.op V))
    have happ_eq : (g.appLE U_S V hLE_V).hom =
        e_loc.toRingEquiv.toRingHom.comp
          ((algebraMap ↑(C.presheaf.obj (Opposite.op U_C)) (Localization.Away f)).comp
            (g.appLE U_S U_C hLE).hom) := by
      have hmap := g.appLE_map hLE (CategoryTheory.homOfLE (C.basicOpen_le f)).op
      rw [← hmap]
      ext r
      change (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le f)).op).hom
          ((g.appLE U_S U_C hLE).hom r) =
        e_loc (algebraMap _ (Localization.Away f) ((g.appLE U_S U_C hLE).hom r))
      rw [e_loc.commutes]
      rfl
    have hSm_app : RingHom.IsStandardSmoothOfRelativeDimension 1 (g.appLE U_S V hLE_V).hom := by
      rw [happ_eq]
      exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).left _ e_loc.toRingEquiv hSm
    have hSm_spec : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (g.appLE U_S V hLE_V)) := by
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)]
      exact RingHom.locally_of (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1)
        (g.appLE U_S V hLE_V).hom hSm_app
    have hfac : V.ι ≫ g =
        hAffV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (g.appLE U_S V hLE_V) ≫ hAffS.fromSpec := by
      rw [hAffS.SpecMap_appLE_fromSpec g hAffV hLE_V, ← CategoryTheory.Category.assoc,
        hAffV.isoSpec_hom_fromSpec]
    refine ⟨V, hxV, ?_⟩
    rw [hfac]
    have h1 : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
        (AlgebraicGeometry.Spec.map (g.appLE U_S V hLE_V) ≫ hAffS.fromSpec) :=
      @AlgebraicGeometry.smoothOfRelativeDimension_comp 1 0 _ _ _ _ _ hSm_spec inferInstance
    have h2 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (1 + 0))
        (hAffV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (g.appLE U_S V hLE_V) ≫ hAffS.fromSpec) :=
