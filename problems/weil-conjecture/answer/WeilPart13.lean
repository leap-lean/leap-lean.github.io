  let ε₀ := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq β₀ hAffZ'₀.fromSpec hRange_β₀
  let τ₀ := q'.left.appLE Z₀ Z'₀ hZ'₀_le_q
  have hSpec_τ₀ : AlgebraicGeometry.Spec.map τ₀ = ε₀.inv := by
    rw [← CategoryTheory.cancel_mono hAffZ₀.fromSpec]
    rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec q'.left hAffZ₀ hAffZ'₀ hZ'₀_le_q,
