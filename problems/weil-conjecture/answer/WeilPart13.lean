  have hRoof₁ : HasGeomFiberNodalRoofAt f₁ q₁ := by
    refine hRoof_gen f₁ q₁ Algebra.TensorProduct.leftAlgebra hAlg₁ p₁ hp₁_eq ?_
    let K₁ : Type u := AlgebraicClosure κ₁
    let toK₁ : R₁ →+* K₁ := (algebraMap κ₁ K₁).comp (algebraMap R₁ κ₁)
