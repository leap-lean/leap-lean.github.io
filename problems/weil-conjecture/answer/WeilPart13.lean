              rw [CategoryTheory.Category.assoc]
        _ = ψ_K.hom ≫ α_top.inv ≫ (CategoryTheory.Limits.pullback.fst (g_seq 0) η_K ≫ h) := by
              rw [h2]; simp [CategoryTheory.Category.assoc]
        _ = ψ_K.hom ≫ α_top.inv ≫ (α_top.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K) := by
              rw [hh_gen0]
        _ = ψ_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K := by
