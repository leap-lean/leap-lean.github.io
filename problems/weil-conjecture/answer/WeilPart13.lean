theorem weil_algClosed_positive_fiber_dim_specializes_to_closed_point (k : Type u) [Field k] [IsAlgClosed k]
    (B C T : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (hIntT : AlgebraicGeometry.IsIntegral T.left)
    (hProjT : IsProjectiveOverField k T)
    (f : C ⟶ B)
    (π : T ⟶ C)
    (hIsoU : CategoryTheory.IsIso (π.left ∣_ ((TopologicalSpace.Opens.map f.left.base).obj U_B)))
    (c₀ : C.left)
    (t₀ t₁ : T.left)
    (ht₀ : π.left.base t₀ = c₀)
    (ht₁ : π.left.base t₁ = c₀)
    (hcl : t₀ ∈ closure ({t₁} : Set T.left))
    (hne : t₀ ≠ t₁) :
    ∃ (s₀ : B.left)
      (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ B.left)
      (c₁ : C.left)
      (w₀ w₁ : T.left),
      IsClosed ({s₀} : Set B.left) ∧
      s₀ ∉ (U_B : Set B.left) ∧
      s_bar ≫ B.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      (∀ pt, s_bar.base pt = s₀) ∧
      f.left.base c₁ = s₀ ∧
      π.left.base w₀ = c₁ ∧
      π.left.base w₁ = c₁ ∧
      w₀ ∈ closure ({w₁} : Set T.left) ∧
      w₀ ≠ w₁ :=
by
  have _ : AlgebraicGeometry.IsIntegral B.left ∧
      AlgebraicGeometry.IsIntegral C.left ∧
      AlgebraicGeometry.IsIntegral T.left := ⟨hIntB, hIntC, hIntT⟩
  
  have h_ht_comap_le : ∀ (m : ℕ) {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S)
      (P : Ideal S) [P.IsPrime],
      P.height ≤ (m : ℕ∞) → (Ideal.comap e.toRingHom P).height ≤ (m : ℕ∞) := by
    intro m
    induction m using Nat.strongRecOn with
    | ind m ih =>
      intro R S _ _ e P _ hPm
      rw [Ideal.height_le_iff]
      intro q hq hq_lt
      let Q : Ideal S := Ideal.comap e.symm.toRingHom q
      have hQ_prime : Q.IsPrime := Ideal.IsPrime.comap e.symm.toRingHom
      have hq_eq : Ideal.comap e.toRingHom Q = q := by
        ext x
        change e.symm (e x) ∈ q ↔ x ∈ q
        rw [e.symm_apply_apply]
      have hQ_le : Q ≤ P := by
        intro y hy
        have hy' : e.symm y ∈ Ideal.comap e.toRingHom P := hq_lt.le hy
        change e (e.symm y) ∈ P at hy'
        rwa [e.apply_symm_apply] at hy'
      have hQ_lt : Q < P := lt_of_le_of_ne hQ_le (fun hEq => hq_lt.ne (by rw [← hq_eq, hEq]))
      have hQ_ht_lt : Q.height < (m : ℕ∞) := (Ideal.height_le_iff.mp hPm) Q hQ_prime hQ_lt
      cases hQ_ht : Q.height with
      | top =>
        rw [hQ_ht] at hQ_ht_lt
        exact absurd hQ_ht_lt (not_lt_of_ge le_top)
      | coe r =>
        have hr_lt : r < m := by
          rw [hQ_ht] at hQ_ht_lt
          exact Nat.cast_lt.mp hQ_ht_lt
        have hq_le_r : q.height ≤ (r : ℕ∞) := by
          rw [← hq_eq]
          exact @ih r hr_lt R S _ _ e Q hQ_prime (le_of_eq hQ_ht)
        exact lt_of_le_of_lt hq_le_r (Nat.cast_lt.mpr hr_lt)
  have h_ht_comap_equiv : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (e : R ≃+* S) (P : Ideal S) [P.IsPrime],
      (Ideal.comap e.toRingHom P).height = P.height := by
    intro R S _ _ e P _
    apply le_antisymm
    · cases hP : P.height with
      | top => exact le_top
      | coe m => exact h_ht_comap_le m e P (le_of_eq hP)
    · have hEq : Ideal.comap e.symm.toRingHom (Ideal.comap e.toRingHom P) = P := by
        ext y
        change e (e.symm y) ∈ P ↔ y ∈ P
        rw [e.apply_symm_apply]
      cases hC : (Ideal.comap e.toRingHom P).height with
      | top => exact le_top
      | coe m =>
        have := h_ht_comap_le m e.symm (Ideal.comap e.toRingHom P) (le_of_eq hC)
        rwa [hEq] at this
  
  have h_mvPoly_ht : ∀ (n : ℕ) (M : Ideal (MvPolynomial (Fin n) k)) [M.IsMaximal],
      M.height = (n : ℕ∞) := by
    intro n
    induction n with
    | zero =>
      intro M _
      let e₀ : MvPolynomial (Fin 0) k ≃+* k := (MvPolynomial.isEmptyAlgEquiv k (Fin 0)).toRingEquiv
      let M' : Ideal k := Ideal.comap e₀.symm.toRingHom M
      have : M'.IsPrime := Ideal.IsPrime.comap e₀.symm.toRingHom
      have hM'_bot : M' = ⊥ := Ideal.eq_bot_of_prime M'
      have hM_eq : Ideal.comap e₀.toRingHom M' = M := by
        ext x
        change e₀.symm (e₀ x) ∈ M ↔ x ∈ M
        rw [e₀.symm_apply_apply]
      rw [← hM_eq, h_ht_comap_equiv e₀ M', hM'_bot, Ideal.height_bot]
      rfl
    | succ n ih =>
      intro M _
      let e : MvPolynomial (Fin (n + 1)) k ≃+* Polynomial (MvPolynomial (Fin n) k) :=
        (MvPolynomial.finSuccEquiv k n).toRingEquiv
      let P' : Ideal (Polynomial (MvPolynomial (Fin n) k)) := Ideal.comap e.symm.toRingHom M
      have : P'.IsMaximal := Ideal.comap_isMaximal_of_surjective e.symm.toRingHom e.symm.surjective
      let p' : Ideal (MvPolynomial (Fin n) k) := Ideal.comap Polynomial.C P'
      have : p'.IsMaximal := Polynomial.isMaximal_comap_C_of_isJacobsonRing P'
      have : P'.LiesOver p' := ⟨rfl⟩
      have hP'_ht : P'.height = ((n + 1 : ℕ) : ℕ∞) := by
        rw [Polynomial.height_eq_height_add_one p' P', ih p']
        rfl
      have hM_eq : Ideal.comap e.toRingHom P' = M := by
        ext x
        change e.symm (e x) ∈ M ↔ x ∈ M
        rw [e.symm_apply_apply]
      rw [← hM_eq, h_ht_comap_equiv e P', hP'_ht]
  
  have h_map_isMax : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (g : R →+* S), Function.Surjective g →
      ∀ (M : Ideal R) [M.IsMaximal], RingHom.ker g ≤ M → (Ideal.map g M).IsMaximal := by
    intro R S _ _ g hg M hM hker
    rw [Ideal.isMaximal_iff] at hM ⊢
    refine ⟨fun h1 => hM.1 ?_, fun J x hMJ hxM hxJ => ?_⟩
    · have hcomap := Ideal.comap_map_of_surjective' g hg M
      rw [sup_eq_left.mpr hker] at hcomap
      have h1' : (1 : R) ∈ Ideal.comap g (Ideal.map g M) := by
        rw [Ideal.mem_comap, map_one]
        exact h1
      rwa [hcomap] at h1'
    · obtain ⟨r, rfl⟩ := hg x
      have hrM : r ∉ M := fun hr => hxM (Ideal.mem_map_of_mem g hr)
      have h1 : (1 : R) ∈ Ideal.comap g J :=
        hM.2 (Ideal.comap g J) r (Ideal.map_le_iff_le_comap.mp hMJ) hrM hxJ
      simpa using h1
  
  have h_alg_crux : ∀ (D_C D_T : Type u) [CommRing D_C] [IsDomain D_C] [CommRing D_T] [IsDomain D_T]
      [Algebra k D_C] [Algebra.FiniteType k D_C] [Algebra k D_T] [Algebra.FiniteType k D_T]
      (φ : D_C →ₐ[k] D_T), Function.Injective φ →
      ∀ (q₀ : Ideal D_T), q₀ ≠ ⊥ → Ideal.comap φ.toRingHom q₀ = ⊥ →
      ∀ (m_C : Ideal D_C) [m_C.IsMaximal] (m_T : Ideal D_T) [m_T.IsMaximal],
        Ideal.comap φ.toRingHom m_T = m_C →
        ∃ Q₁ : Ideal D_T, Q₁.IsPrime ∧ Q₁ < m_T ∧ Ideal.comap φ.toRingHom Q₁ = m_C := by
    intro D_C D_T _ _ _ _ _ _ _ _ φ hφ_inj q₀ hq₀_ne hq₀_comap m_C _ m_T _ hm_comap
    have : IsNoetherianRing D_C := Algebra.FiniteType.isNoetherianRing k D_C
    have : IsNoetherianRing D_T := Algebra.FiniteType.isNoetherianRing k D_T
    obtain ⟨d₀, g_C, hgC_inj, hgC_int⟩ := exists_integral_inj_algHom_of_fg k D_C
    obtain ⟨d_T, g_T, hgT_inj, hgT_int⟩ := exists_integral_inj_algHom_of_fg k D_T
    have htrC_and_htC : Algebra.trdeg k D_C = (d₀ : Cardinal.{u}) ∧ m_C.height ≤ (d₀ : ℕ∞) := by
      let P_C : Type u := MvPolynomial (Fin d₀) k
      let : Algebra P_C D_C := g_C.toRingHom.toAlgebra
      have : FaithfulSMul P_C D_C := (faithfulSMul_iff_algebraMap_injective P_C D_C).mpr hgC_inj
      have : IsScalarTower k P_C D_C := IsScalarTower.of_algebraMap_eq' g_C.comp_algebraMap.symm
      have : Algebra.IsIntegral P_C D_C := ⟨hgC_int⟩
      have : Algebra.IsAlgebraic P_C D_C := Algebra.IsIntegral.isAlgebraic
      have htr : Algebra.trdeg k D_C = (d₀ : Cardinal.{u}) := by
        have hadd := trdeg_add_eq k P_C (A := D_C)
        rw [trdeg_eq_zero (R := P_C) (A := D_C), add_zero] at hadd
        rw [← hadd, MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
      have h_mono : StrictMono (PrimeSpectrum.comap g_C.toRingHom) := by
        intro p₁ p₂ hp
        obtain ⟨x, hx₂, hx₁⟩ := Set.not_subset.mp hp.not_ge
        exact Ideal.under_lt_under_of_integral_mem_sdiff hp.le ⟨hx₂, hx₁⟩ (hgC_int x)
      have h_dimC : ringKrullDim D_C ≤ (d₀ : WithBot ℕ∞) := by
        calc ringKrullDim D_C
            ≤ ringKrullDim P_C := Order.krullDim_le_of_strictMono _ h_mono
          _ = ringKrullDim k + (ENat.card (Fin d₀) : WithBot ℕ∞) :=
              MvPolynomial.ringKrullDim_of_isNoetherianRing
          _ = (d₀ : WithBot ℕ∞) := by
              rw [ringKrullDim_eq_zero_of_field k, zero_add, ENat.card_eq_coe_fintype_card,
                Fintype.card_fin]
              rfl
      have h_htC_wb : (m_C.height : WithBot ℕ∞) ≤ (d₀ : WithBot ℕ∞) :=
        (Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsMaximal.ne_top inferInstance)).trans h_dimC
      exact ⟨htr, WithBot.coe_le_coe.mp h_htC_wb⟩
    have htrT_and_htT : Algebra.trdeg k D_T = (d_T : Cardinal.{u}) ∧ (d_T : ℕ∞) ≤ m_T.height := by
      let P_T : Type u := MvPolynomial (Fin d_T) k
      let : Algebra P_T D_T := g_T.toRingHom.toAlgebra
      have : FaithfulSMul P_T D_T := (faithfulSMul_iff_algebraMap_injective P_T D_T).mpr hgT_inj
      have : IsScalarTower k P_T D_T := IsScalarTower.of_algebraMap_eq' g_T.comp_algebraMap.symm
      have : Algebra.IsIntegral P_T D_T := ⟨hgT_int⟩
      have : Algebra.IsAlgebraic P_T D_T := Algebra.IsIntegral.isAlgebraic
      have htr : Algebra.trdeg k D_T = (d_T : Cardinal.{u}) := by
        have hadd := trdeg_add_eq k P_T (A := D_T)
        rw [trdeg_eq_zero (R := P_T) (A := D_T), add_zero] at hadd
        rw [← hadd, MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
      have : Algebra.HasGoingDown P_T D_T := inferInstance
      let n_T : Ideal P_T := Ideal.comap g_T.toRingHom m_T
      have : n_T.IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal g_T.toRingHom hgT_int m_T
      have : m_T.LiesOver n_T := ⟨rfl⟩
      have h_gd := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown n_T m_T
      have hn_ht : n_T.height = (d_T : ℕ∞) := h_mvPoly_ht d_T n_T
      refine ⟨htr, ?_⟩
      rw [h_gd, hn_ht]
      exact le_self_add
    have hd_gap : d₀ + 1 ≤ d_T := by
      obtain ⟨x, hx_mem, hx_ne⟩ := (Submodule.ne_bot_iff q₀).mp hq₀_ne
      let : Algebra D_C D_T := φ.toRingHom.toAlgebra
      have : FaithfulSMul D_C D_T := (faithfulSMul_iff_algebraMap_injective D_C D_T).mpr hφ_inj
      have : IsScalarTower k D_C D_T := IsScalarTower.of_algebraMap_eq' φ.comp_algebraMap.symm
      have hx_tr : Transcendental D_C x := by
        intro ⟨p, hp_ne, hp_eval⟩
        have hex : ∃ m : ℕ, ∃ q : Polynomial D_C, q.natDegree = m ∧ q ≠ 0 ∧ Polynomial.aeval x q = 0 :=
          ⟨p.natDegree, p, rfl, hp_ne, hp_eval⟩
        classical
        let m_min := Nat.find hex
        obtain ⟨q, hq_deg, hq_ne, hq_eval⟩ := Nat.find_spec hex
        by_cases hq0 : q.coeff 0 = 0
        · have hX_mul : Polynomial.X * q.divX = q := by
            have h := Polynomial.X_mul_divX_add q
            rw [hq0, map_zero, add_zero] at h
            exact h
          have hdiv_ne : q.divX ≠ 0 := by
            intro h0
            rw [h0, mul_zero] at hX_mul
            exact hq_ne hX_mul.symm
          have hq_deg_eq : q.natDegree = q.divX.natDegree + 1 :=
            (congrArg Polynomial.natDegree hX_mul).symm.trans (Polynomial.natDegree_X_mul hdiv_ne)
          have hdiv_deg : q.divX.natDegree < m_min := by
            change q.divX.natDegree < Nat.find hex
            omega
          have hdiv_eval : Polynomial.aeval x q.divX = 0 := by
            have hmul_eval : x * Polynomial.aeval x q.divX = 0 := by
              have h := congrArg (Polynomial.aeval x) hX_mul
              rw [hq_eval, map_mul, Polynomial.aeval_X] at h
              exact h
            exact (mul_eq_zero.mp hmul_eval).resolve_left hx_ne
          exact Nat.find_min hex hdiv_deg ⟨q.divX, rfl, hdiv_ne, hdiv_eval⟩
        · have h_rel : φ (q.coeff 0) = -(x * Polynomial.aeval x q.divX) := by
            have h := congrArg (Polynomial.aeval x) (Polynomial.X_mul_divX_add q)
            rw [hq_eval, map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h
            change x * Polynomial.aeval x q.divX + φ (q.coeff 0) = 0 at h
            exact eq_neg_of_add_eq_zero_right h
          have hc0_mem : q.coeff 0 ∈ Ideal.comap φ.toRingHom q₀ := by
            rw [Ideal.mem_comap]
            change φ (q.coeff 0) ∈ q₀
            rw [h_rel]
            exact q₀.neg_mem (q₀.mul_mem_right _ hx_mem)
          rw [hq₀_comap, Ideal.mem_bot] at hc0_mem
          exact hq0 hc0_mem
      have h_indep : AlgebraicIndependent D_C (fun _ : PUnit.{u + 1} => x) :=
        (algebraicIndependent_unique_type_iff).mpr hx_tr
      have h_tr1 : (1 : Cardinal.{u}) ≤ Algebra.trdeg D_C D_T := by
        simpa using h_indep.cardinalMk_le_trdeg
      have h_add := trdeg_add_eq k D_C (A := D_T)
      rw [htrC_and_htC.1, htrT_and_htT.1] at h_add
      have h_le_card : ((d₀ + 1 : ℕ) : Cardinal.{u}) ≤ (d_T : Cardinal.{u}) := by
        rw [Nat.cast_add, Nat.cast_one, ← h_add]
        exact add_le_add le_rfl h_tr1
      exact Nat.cast_le.mp h_le_card
    let : Algebra D_C D_T := φ.toRingHom.toAlgebra
    have : m_T.LiesOver m_C := ⟨hm_comap.symm⟩
    let I_fib : Ideal D_T := Ideal.map (algebraMap D_C D_T) m_C
    let M_fib : Ideal (D_T ⧸ I_fib) := Ideal.map (Ideal.Quotient.mk I_fib) m_T
    have hI_le_mT : I_fib ≤ m_T := Ideal.map_le_iff_le_comap.mpr hm_comap.symm.le
    have : M_fib.IsMaximal :=
      h_map_isMax (Ideal.Quotient.mk I_fib) Ideal.Quotient.mk_surjective m_T
        (by rw [Ideal.mk_ker]; exact hI_le_mT)
    have h_fib_ineq : m_T.height ≤ m_C.height + M_fib.height :=
      Ideal.height_le_height_add_of_liesOver m_C m_T
    have hM_fib_not_zero : ¬ (M_fib.height ≤ ((0 : ℕ) : ℕ∞)) := by
      intro h0
      have hle : ((d₀ + 1 : ℕ) : ℕ∞) ≤ (d₀ : ℕ∞) := by
        calc ((d₀ + 1 : ℕ) : ℕ∞)
            ≤ (d_T : ℕ∞) := Nat.cast_le.mpr hd_gap
          _ ≤ m_T.height := htrT_and_htT.2
          _ ≤ m_C.height + M_fib.height := h_fib_ineq
          _ ≤ (d₀ : ℕ∞) + 0 := add_le_add htrC_and_htC.2 h0
          _ = (d₀ : ℕ∞) := add_zero _
      exact absurd (Nat.cast_le.mp hle) (by omega)
    rw [Ideal.height_le_iff] at hM_fib_not_zero
    push Not at hM_fib_not_zero
    obtain ⟨q_fib, hq_fib_prime, hq_fib_lt, _⟩ := hM_fib_not_zero
    let Q₁ : Ideal D_T := Ideal.comap (Ideal.Quotient.mk I_fib) q_fib
    have hQ₁_prime : Q₁.IsPrime := hq_fib_prime.comap (Ideal.Quotient.mk I_fib)
    have hM_fib_comap : Ideal.comap (Ideal.Quotient.mk I_fib) M_fib = m_T := by
      rw [Ideal.comap_map_of_surjective' (Ideal.Quotient.mk I_fib) Ideal.Quotient.mk_surjective m_T,
        Ideal.mk_ker, sup_eq_left.mpr hI_le_mT]
    have hQ₁_le : Q₁ ≤ m_T := by
      rw [← hM_fib_comap]
      exact Ideal.comap_mono hq_fib_lt.le
    have hQ₁_lt : Q₁ < m_T := by
      refine lt_of_le_of_ne hQ₁_le (fun hEq => hq_fib_lt.ne ?_)
      have hmap_q : Ideal.map (Ideal.Quotient.mk I_fib) Q₁ = q_fib :=
        Ideal.map_comap_of_surjective (Ideal.Quotient.mk I_fib) Ideal.Quotient.mk_surjective q_fib
      rw [← hmap_q, hEq]
    have hQ₁_comap : Ideal.comap φ.toRingHom Q₁ = m_C := by
      apply le_antisymm
      · rw [← hm_comap]
        exact Ideal.comap_mono hQ₁_le
      · have hI_le_Q₁ : I_fib ≤ Q₁ := by
          rw [← Ideal.mk_ker (I := I_fib), RingHom.ker_eq_comap_bot]
          exact Ideal.comap_mono bot_le
        exact Ideal.map_le_iff_le_comap.mp hI_le_Q₁
    exact ⟨Q₁, hQ₁_prime, hQ₁_lt, hQ₁_comap⟩
  
  have h_proper : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      IsProjectiveOverField k Y → AlgebraicGeometry.IsProper Y.hom ∧ CompactSpace ↥Y.left := by
    intro Y hProj
    obtain ⟨N, ι, hCl⟩ := hProj
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k)
    have h_surj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro x
      have hx : x.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using x.2
      rw [Submodule.mem_one] at hx
      obtain ⟨c, hc⟩ := hx
      refine ⟨c, Subtype.ext ?_⟩
      rw [Algebra.algebraMap_eq_smul_one]
      change c • (1 : MvPolynomial (Fin (N + 1)) k) = x.1
      rw [← Algebra.algebraMap_eq_smul_one]
      exact hc
    have hFin0 : RingHom.Finite (algebraMap k ↥(𝒜 0)) :=
      RingHom.Finite.of_surjective _ h_surj0
    have : AlgebraicGeometry.IsFinite
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))).mpr hFin0
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
      infer_instance
    have hPropY : AlgebraicGeometry.IsProper Y.hom := by
      rw [← CategoryTheory.Over.w ι]
      infer_instance
    have hCompY : CompactSpace ↥Y.left :=
      isCompact_univ_iff.mp (Y.hom.isProperMap.isCompact_preimage isCompact_univ)
    exact ⟨hPropY, hCompY⟩
  
  obtain ⟨hPropB, _hCompB⟩ := h_proper B hProjB
  obtain ⟨hPropC, hCompC⟩ := h_proper C hProjC
  obtain ⟨hPropT, hCompT⟩ := h_proper T hProjT
  have : AlgebraicGeometry.IsProper B.hom := hPropB
  have : AlgebraicGeometry.IsProper C.hom := hPropC
  have : AlgebraicGeometry.IsProper T.hom := hPropT
  have : CompactSpace ↥C.left := hCompC
  have : CompactSpace ↥T.left := hCompT
  have hPropf : AlgebraicGeometry.IsProper f.left := by
    have : AlgebraicGeometry.IsProper (f.left ≫ B.hom) := by rw [f.w]; infer_instance
    exact AlgebraicGeometry.IsProper.of_comp f.left B.hom
  have hPropπ : AlgebraicGeometry.IsProper π.left := by
    have : AlgebraicGeometry.IsProper (π.left ≫ C.hom) := by rw [π.w]; infer_instance
    exact AlgebraicGeometry.IsProper.of_comp π.left C.hom
  have : AlgebraicGeometry.IsProper f.left := hPropf
  have : AlgebraicGeometry.IsProper π.left := hPropπ
  
  let F₀ : Set T.left := closure ({t₀} : Set T.left)
  have hF₀_img_closed : IsClosed (π.left.base '' F₀) :=
    π.left.isClosedMap F₀ isClosed_closure
  have hc₀_mem_img : c₀ ∈ π.left.base '' F₀ :=
    ⟨t₀, subset_closure (Set.mem_singleton t₀), ht₀⟩
  have hZ₀_sub : closure ({c₀} : Set C.left) ⊆ π.left.base '' F₀ :=
    closure_minimal (Set.singleton_subset_iff.mpr hc₀_mem_img) hF₀_img_closed
  obtain ⟨c₁, hc₁_cl, hc₁_closed⟩ :=
    isClosed_closure.exists_closed_singleton ⟨c₀, subset_closure (Set.mem_singleton c₀)⟩
  obtain ⟨u₀, hu₀_F₀, hu₀_c₁⟩ := hZ₀_sub hc₁_cl
  let F₁ : Set T.left := F₀ ∩ π.left.base ⁻¹' ({c₁} : Set C.left)
  have hF₁_closed : IsClosed F₁ :=
    isClosed_closure.inter (hc₁_closed.preimage π.left.continuous)
  obtain ⟨y₀, ⟨hy₀_cl, hy₀_c₁⟩, hy₀_closed⟩ :=
    hF₁_closed.exists_closed_singleton ⟨u₀, hu₀_F₀, hu₀_c₁⟩
  
  obtain ⟨U_C, hAffC, hc₁U, _⟩ :=
    @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset C.left c₁ ⊤ trivial
  have hc₀U : c₀ ∈ U_C := by
    obtain ⟨z, hzU, hzc₀⟩ := mem_closure_iff.mp hc₁_cl U_C.carrier U_C.isOpen hc₁U
    rwa [Set.mem_singleton_iff.mp hzc₀] at hzU
  let W_T : T.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U_C
  have hy₀W : y₀ ∈ W_T := by
    change π.left.base y₀ ∈ U_C
    rw [hy₀_c₁]
    exact hc₁U
  obtain ⟨U_T, hAffT, hy₀U, hUT_le⟩ :=
    @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset T.left y₀ W_T hy₀W
  have ht₀U : t₀ ∈ U_T := by
    obtain ⟨z, hzU, hzt₀⟩ := mem_closure_iff.mp hy₀_cl U_T.carrier U_T.isOpen hy₀U
    rwa [Set.mem_singleton_iff.mp hzt₀] at hzU
  have ht₁U : t₁ ∈ U_T := by
    obtain ⟨z, hzU, hzt₁⟩ := mem_closure_iff.mp hcl U_T.carrier U_T.isOpen ht₀U
    rwa [Set.mem_singleton_iff.mp hzt₁] at hzU
  
  let R_C : CommRingCat.{u} := C.left.presheaf.obj (Opposite.op U_C)
  let R_T : CommRingCat.{u} := T.left.presheaf.obj (Opposite.op U_T)
  let ψ_CT : R_C ⟶ R_T := π.left.appLE U_C U_T hUT_le
  let α_C : CommRingCat.of k ⟶ R_C :=
    (AlgebraicGeometry.Spec.fullyFaithful.preimage (hAffC.fromSpec ≫ C.hom)).unop
  let α_T : CommRingCat.of k ⟶ R_T :=
    (AlgebraicGeometry.Spec.fullyFaithful.preimage (hAffT.fromSpec ≫ T.hom)).unop
  have hSpecαC : AlgebraicGeometry.Spec.map α_C = hAffC.fromSpec ≫ C.hom :=
    AlgebraicGeometry.Spec.fullyFaithful.map_preimage (hAffC.fromSpec ≫ C.hom)
  have hSpecαT : AlgebraicGeometry.Spec.map α_T = hAffT.fromSpec ≫ T.hom :=
    AlgebraicGeometry.Spec.fullyFaithful.map_preimage (hAffT.fromSpec ≫ T.hom)
  have hAppSpec : AlgebraicGeometry.Spec.map ψ_CT ≫ hAffC.fromSpec = hAffT.fromSpec ≫ π.left :=
    hAffC.SpecMap_appLE_fromSpec π.left hAffT hUT_le
  have hα_comm : α_C ≫ ψ_CT = α_T := by
    apply AlgebraicGeometry.Spec.map_inj.mp
    rw [AlgebraicGeometry.Spec.map_comp, hSpecαC, hSpecαT, ← Category.assoc,
      hAppSpec, Category.assoc, π.w]
  have hLFT_C : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α_C) := by
    rw [hSpecαC, ← hAffC.isoSpec_inv_ι]; infer_instance
  have hLFT_T : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α_T) := by
    rw [hSpecαT, ← hAffT.isoSpec_inv_ι]; infer_instance
  have hFTC : α_C.hom.FiniteType :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_C
  have hFTT : α_T.hom.FiniteType :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_T
  let : Algebra k R_C := α_C.hom.toAlgebra
  let : Algebra k R_T := α_T.hom.toAlgebra
  have : Algebra.FiniteType k R_C := hFTC
  have : Algebra.FiniteType k R_T := hFTT
  let e_C : ↥U_C ≃ₜ PrimeSpectrum R_C := AlgebraicGeometry.Scheme.homeoOfIso hAffC.isoSpec
  let e_T : ↥U_T ≃ₜ PrimeSpectrum R_T := AlgebraicGeometry.Scheme.homeoOfIso hAffT.isoSpec
  have hSpec_pt : ∀ (q : PrimeSpectrum R_T),
      (e_C.symm ((AlgebraicGeometry.Spec.map ψ_CT).base q)).1 = π.left.base (e_T.symm q).1 := by
    intro q
    have h1 := congrArg (fun g => g.base q) hAppSpec
    change hAffC.fromSpec.base ((AlgebraicGeometry.Spec.map ψ_CT).base q) =
      π.left.base (hAffT.fromSpec.base q) at h1
    rw [← hAffC.isoSpec_inv_ι, ← hAffT.isoSpec_inv_ι] at h1
    exact h1
  have hComap_pt : ∀ (z : T.left) (hz : z ∈ U_T),
      (AlgebraicGeometry.Spec.map ψ_CT).base (e_T ⟨z, hz⟩) = e_C ⟨π.left.base z, hUT_le hz⟩ := by
    intro z hz
    apply e_C.symm.injective
    apply Subtype.ext
    rw [hSpec_pt (e_T ⟨z, hz⟩), Homeomorph.symm_apply_apply, Homeomorph.symm_apply_apply]
  let p₀ : PrimeSpectrum R_C := e_C ⟨c₀, hc₀U⟩
  let p₁ : PrimeSpectrum R_C := e_C ⟨c₁, hc₁U⟩
  let q_y : PrimeSpectrum R_T := e_T ⟨y₀, hy₀U⟩
  let q_0 : PrimeSpectrum R_T := e_T ⟨t₀, ht₀U⟩
  let q_1 : PrimeSpectrum R_T := e_T ⟨t₁, ht₁U⟩
  have h_comap_q1 : Ideal.comap ψ_CT.hom q_1.asIdeal = p₀.asIdeal := by
    have h := hComap_pt t₁ ht₁U
    have heq : (⟨π.left.base t₁, hUT_le ht₁U⟩ : ↥U_C) = ⟨c₀, hc₀U⟩ := Subtype.ext ht₁
    rw [heq] at h
    exact congrArg PrimeSpectrum.asIdeal h
  have h_comap_q0 : Ideal.comap ψ_CT.hom q_0.asIdeal = p₀.asIdeal := by
    have h := hComap_pt t₀ ht₀U
    have heq : (⟨π.left.base t₀, hUT_le ht₀U⟩ : ↥U_C) = ⟨c₀, hc₀U⟩ := Subtype.ext ht₀
    rw [heq] at h
    exact congrArg PrimeSpectrum.asIdeal h
  have h_comap_qy : Ideal.comap ψ_CT.hom q_y.asIdeal = p₁.asIdeal := by
    have h := hComap_pt y₀ hy₀U
    have heq : (⟨π.left.base y₀, hUT_le hy₀U⟩ : ↥U_C) = ⟨c₁, hc₁U⟩ := Subtype.ext hy₀_c₁
    rw [heq] at h
    exact congrArg PrimeSpectrum.asIdeal h
  have h_sub_cl : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens) {a b : X}
      (ha : a ∈ U) (hb : b ∈ U),
      a ∈ closure ({b} : Set X) → (⟨a, ha⟩ : ↥U) ∈ closure ({⟨b, hb⟩} : Set ↥U) := by
    intro X U a b ha hb hab
    rw [mem_closure_iff]
    intro V hV haV
    obtain ⟨z, hzV, hzb⟩ :=
      mem_closure_iff.mp hab _ (U.isOpen.isOpenMap_subtype_val V hV) ⟨⟨a, ha⟩, haV, rfl⟩
    rw [Set.mem_singleton_iff] at hzb
    subst hzb
    rcases hzV with ⟨⟨x, hx⟩, hxV, rfl⟩
    exact ⟨⟨x, hx⟩, hxV, rfl⟩
  have hp₀_le_p₁ : p₀.asIdeal ≤ p₁.asIdeal := by
    have hcl_sub := h_sub_cl U_C hc₁U hc₀U hc₁_cl
    have hp_cl : p₁ ∈ closure ({p₀} : Set (PrimeSpectrum R_C)) := by
      rw [← Set.image_singleton, ← Homeomorph.image_closure]
      exact ⟨⟨c₁, hc₁U⟩, hcl_sub, rfl⟩
    exact (PrimeSpectrum.le_iff_mem_closure p₀ p₁).mpr hp_cl
  have hq0_le_qy : q_0.asIdeal ≤ q_y.asIdeal := by
    have hcl_sub := h_sub_cl U_T hy₀U ht₀U hy₀_cl
    have hq_cl : q_y ∈ closure ({q_0} : Set (PrimeSpectrum R_T)) := by
      rw [← Set.image_singleton, ← Homeomorph.image_closure]
      exact ⟨⟨y₀, hy₀U⟩, hcl_sub, rfl⟩
    exact (PrimeSpectrum.le_iff_mem_closure q_0 q_y).mpr hq_cl
  have hq1_le_q0 : q_1.asIdeal ≤ q_0.asIdeal := by
    have hcl_sub := h_sub_cl U_T ht₀U ht₁U hcl
    have hq_cl : q_0 ∈ closure ({q_1} : Set (PrimeSpectrum R_T)) := by
      rw [← Set.image_singleton, ← Homeomorph.image_closure]
      exact ⟨⟨t₀, ht₀U⟩, hcl_sub, rfl⟩
    exact (PrimeSpectrum.le_iff_mem_closure q_1 q_0).mpr hq_cl
  have hq1_lt_q0 : q_1.asIdeal < q_0.asIdeal := by
    refine lt_of_le_of_ne hq1_le_q0 (fun hEq => hne ?_)
    have hq_eq : q_1 = q_0 := PrimeSpectrum.ext hEq
    have hsub_eq := e_T.injective hq_eq
    exact (congrArg Subtype.val hsub_eq).symm
  have hq1_le_qy : q_1.asIdeal ≤ q_y.asIdeal := hq1_le_q0.trans hq0_le_qy
  have : p₁.asIdeal.IsMaximal := by
    have hSub_eq : ({⟨c₁, hc₁U⟩} : Set ↥U_C) = (Subtype.val : ↥U_C → C.left) ⁻¹' ({c₁} : Set C.left) := by
      ext ⟨x, hx⟩; simp
    have hCl_sub : IsClosed ({⟨c₁, hc₁U⟩} : Set ↥U_C) :=
      hSub_eq ▸ hc₁_closed.preimage continuous_subtype_val
    have hCl_p1 : IsClosed ({p₁} : Set (PrimeSpectrum R_C)) := by
      rw [← Set.image_singleton]
      exact e_C.isClosedMap _ hCl_sub
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal p₁).mp hCl_p1
  have : q_y.asIdeal.IsMaximal := by
    have hSub_eq : ({⟨y₀, hy₀U⟩} : Set ↥U_T) = (Subtype.val : ↥U_T → T.left) ⁻¹' ({y₀} : Set T.left) := by
      ext ⟨x, hx⟩; simp
    have hCl_sub : IsClosed ({⟨y₀, hy₀U⟩} : Set ↥U_T) :=
      hSub_eq ▸ hy₀_closed.preimage continuous_subtype_val
    have hCl_qy : IsClosed ({q_y} : Set (PrimeSpectrum R_T)) := by
      rw [← Set.image_singleton]
      exact e_T.isClosedMap _ hCl_sub
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_y).mp hCl_qy
  
  let D_C : Type u := R_C ⧸ p₀.asIdeal
  let D_T : Type u := R_T ⧸ q_1.asIdeal
  have : Algebra.FiniteType k D_C :=
    Algebra.FiniteType.of_surjective (IsScalarTower.toAlgHom k R_C D_C) Ideal.Quotient.mk_surjective
  have : Algebra.FiniteType k D_T :=
    Algebra.FiniteType.of_surjective (IsScalarTower.toAlgHom k R_T D_T) Ideal.Quotient.mk_surjective
  let φ_ring : D_C →+* D_T := Ideal.quotientMap q_1.asIdeal ψ_CT.hom h_comap_q1.symm.le
  let φ : D_C →ₐ[k] D_T :=
    { φ_ring with
      commutes' := fun c => by
        change Ideal.quotientMap q_1.asIdeal ψ_CT.hom h_comap_q1.symm.le
          (Ideal.Quotient.mk p₀.asIdeal (α_C.hom c)) = Ideal.Quotient.mk q_1.asIdeal (α_T.hom c)
        rw [Ideal.quotientMap_mk]
        have hcomm_c : ψ_CT.hom (α_C.hom c) = α_T.hom c :=
          congrArg (fun g => g.hom c) hα_comm
        rw [hcomm_c] }
  have hφ_inj : Function.Injective φ :=
    Ideal.quotientMap_injective' (H := h_comap_q1.symm.le) h_comap_q1.le
  let q₀_dom : Ideal D_T := Ideal.map (Ideal.Quotient.mk q_1.asIdeal) q_0.asIdeal
  have hq₀_comap_mk : Ideal.comap (Ideal.Quotient.mk q_1.asIdeal) q₀_dom = q_0.asIdeal := by
    rw [Ideal.comap_map_of_surjective' (Ideal.Quotient.mk q_1.asIdeal) Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr hq1_le_q0]
  have hq₀_ne : q₀_dom ≠ ⊥ := by
    intro hbot
    have hEq : q_0.asIdeal = q_1.asIdeal := by
      rw [← hq₀_comap_mk, hbot, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact hq1_lt_q0.ne hEq.symm
  have hq₀_comap : Ideal.comap φ.toRingHom q₀_dom = ⊥ := by
    ext x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    change Ideal.Quotient.mk q_1.asIdeal (ψ_CT.hom a) ∈ q₀_dom ↔
      Ideal.Quotient.mk p₀.asIdeal a = 0
    rw [← Ideal.mem_comap, hq₀_comap_mk, Ideal.Quotient.eq_zero_iff_mem, ← h_comap_q0, Ideal.mem_comap]
  let m_C : Ideal D_C := Ideal.map (Ideal.Quotient.mk p₀.asIdeal) p₁.asIdeal
  let m_T : Ideal D_T := Ideal.map (Ideal.Quotient.mk q_1.asIdeal) q_y.asIdeal
  have : m_C.IsMaximal :=
    h_map_isMax (Ideal.Quotient.mk p₀.asIdeal) Ideal.Quotient.mk_surjective p₁.asIdeal
      (by rw [Ideal.mk_ker]; exact hp₀_le_p₁)
  have : m_T.IsMaximal :=
    h_map_isMax (Ideal.Quotient.mk q_1.asIdeal) Ideal.Quotient.mk_surjective q_y.asIdeal
      (by rw [Ideal.mk_ker]; exact hq1_le_qy)
  have hmC_comap_mk : Ideal.comap (Ideal.Quotient.mk p₀.asIdeal) m_C = p₁.asIdeal := by
    rw [Ideal.comap_map_of_surjective' (Ideal.Quotient.mk p₀.asIdeal) Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr hp₀_le_p₁]
  have hmT_comap_mk : Ideal.comap (Ideal.Quotient.mk q_1.asIdeal) m_T = q_y.asIdeal := by
    rw [Ideal.comap_map_of_surjective' (Ideal.Quotient.mk q_1.asIdeal) Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr hq1_le_qy]
  have hm_comap : Ideal.comap φ.toRingHom m_T = m_C := by
    ext x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    change Ideal.Quotient.mk q_1.asIdeal (ψ_CT.hom a) ∈ m_T ↔
      Ideal.Quotient.mk p₀.asIdeal a ∈ m_C
    rw [← Ideal.mem_comap, hmT_comap_mk, ← Ideal.mem_comap (f := Ideal.Quotient.mk p₀.asIdeal),
      hmC_comap_mk, ← h_comap_qy, Ideal.mem_comap]
  
  obtain ⟨Q₁, hQ₁_prime, hQ₁_lt, hQ₁_comap⟩ :=
    h_alg_crux D_C D_T φ hφ_inj q₀_dom hq₀_ne hq₀_comap m_C m_T hm_comap
  
  let Q₁_tilde : Ideal R_T := Ideal.comap (Ideal.Quotient.mk q_1.asIdeal) Q₁
  have : Q₁_tilde.IsPrime := hQ₁_prime.comap (Ideal.Quotient.mk q_1.asIdeal)
  have hQ₁_tilde_le : Q₁_tilde ≤ q_y.asIdeal := by
    rw [← hmT_comap_mk]
    exact Ideal.comap_mono hQ₁_lt.le
  have hQ₁_tilde_lt : Q₁_tilde < q_y.asIdeal := by
    refine lt_of_le_of_ne hQ₁_tilde_le (fun hEq => hQ₁_lt.ne ?_)
    have hmap : Ideal.map (Ideal.Quotient.mk q_1.asIdeal) Q₁_tilde = Q₁ :=
      Ideal.map_comap_of_surjective (Ideal.Quotient.mk q_1.asIdeal) Ideal.Quotient.mk_surjective Q₁
    rw [← hmap, hEq]
  have hQ₁_tilde_comap : Ideal.comap ψ_CT.hom Q₁_tilde = p₁.asIdeal := by
    ext a
    change Ideal.Quotient.mk q_1.asIdeal (ψ_CT.hom a) ∈ Q₁ ↔ a ∈ p₁.asIdeal
    have hmk_comm : Ideal.Quotient.mk q_1.asIdeal (ψ_CT.hom a) =
        φ.toRingHom (Ideal.Quotient.mk p₀.asIdeal a) :=
      (Ideal.quotientMap_mk (I := q_1.asIdeal) (f := ψ_CT.hom) (H := h_comap_q1.symm.le)).symm
    rw [hmk_comm, ← Ideal.mem_comap (f := φ.toRingHom), hQ₁_comap, ← hmC_comap_mk, Ideal.mem_comap]
  let q_w₁ : PrimeSpectrum R_T := ⟨Q₁_tilde, inferInstance⟩
  let w₀ : T.left := y₀
  let w₁ : T.left := (e_T.symm q_w₁).1
  have hw₀_c₁ : π.left.base w₀ = c₁ := hy₀_c₁
  have hw₁_c₁ : π.left.base w₁ = c₁ := by
    have hspec := (hSpec_pt q_w₁).symm
    have hmap_eq : (AlgebraicGeometry.Spec.map ψ_CT).base q_w₁ = p₁ :=
      PrimeSpectrum.ext hQ₁_tilde_comap
    rw [hmap_eq] at hspec
    have hp₁_symm : e_C.symm p₁ = ⟨c₁, hc₁U⟩ := Homeomorph.symm_apply_apply e_C ⟨c₁, hc₁U⟩
    rw [hp₁_symm] at hspec
    exact hspec
  have hw_cl : w₀ ∈ closure ({w₁} : Set T.left) := by
    have hqy_cl : q_y ∈ closure ({q_w₁} : Set (PrimeSpectrum R_T)) :=
      (PrimeSpectrum.le_iff_mem_closure q_w₁ q_y).mp hQ₁_tilde_le
    let g_emb : PrimeSpectrum R_T → T.left := Subtype.val ∘ e_T.symm
    have hg_cont : Continuous g_emb := continuous_subtype_val.comp e_T.symm.continuous
    have himg := image_closure_subset_closure_image hg_cont ⟨q_y, hqy_cl, rfl⟩
    have hg_qy : g_emb q_y = w₀ := by
      simp [g_emb, q_y, w₀]
    have hg_qw1 : g_emb '' ({q_w₁} : Set (PrimeSpectrum R_T)) = {w₁} := by
      simp [g_emb, w₁]
    rwa [hg_qy, hg_qw1] at himg
  have hw_ne : w₀ ≠ w₁ := by
    intro hEq
    have hsub_eq : (⟨y₀, hy₀U⟩ : ↥U_T) = e_T.symm q_w₁ := Subtype.ext hEq
    have hq_eq : q_y = q_w₁ := by
      simpa [q_y] using congrArg e_T hsub_eq
    exact hQ₁_tilde_lt.ne (congrArg PrimeSpectrum.asIdeal hq_eq).symm
  
  let s₀ : B.left := f.left.base c₁
  have hCls₀ : IsClosed ({s₀} : Set B.left) := by
    have h := f.left.isClosedMap ({c₁} : Set C.left) hc₁_closed
    rwa [Set.image_singleton] at h
  have hs₀_notMem : s₀ ∉ (U_B : Set B.left) := by
    intro hs₀_in
    let V_CB : C.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj U_B
    let W_TB : T.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj V_CB
    have hc₁_V : c₁ ∈ V_CB := hs₀_in
    have hw₀_W : w₀ ∈ W_TB := by
