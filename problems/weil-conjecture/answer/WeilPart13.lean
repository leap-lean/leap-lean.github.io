      let θ₂ : A_0 →+* D := Localization.localRingHom I_max m₀.asIdeal ψ₂ hcomap₂.symm
      letI : Algebra A_0 D := θ₂.toAlgebra
      have : IsLocalHom (algebraMap A_0 D) :=
        Localization.isLocalHom_localRingHom I_max m₀.asIdeal ψ₂ hcomap₂.symm
