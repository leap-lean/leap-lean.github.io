      rw [hψ_lift_fac]
      infer_instance
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map ψ_lift_cat) :=
      AlgebraicGeometry.IsOpenImmersion.of_comp
