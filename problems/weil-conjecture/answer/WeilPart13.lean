    have hSurjπ : AlgebraicGeometry.Surjective π.left :=
      AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant π.left
    let V'₀ : S'.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U'
    have hRange_ν : Set.range ν.base ⊆ Set.range V'₀.ι.base := by
      rintro _ ⟨u, rfl⟩
