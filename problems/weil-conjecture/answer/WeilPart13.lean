        rw [hq_eq]
        exact hp_lt
    have hv_in_F : idx.insertNth a v' ∈ ℱ_star :=
      hComp idx a u' v' (hu_ins.symm ▸ hu_F) hsum_eq hv'_lt_u'
    rw [hv_ins] at hv_in_F
    exact hv_notF hv_in_F

  
  have s6_numerical_persistence_threshold : ∀ (M_N : ℕ) (h_η : ℕ → ℕ),
      (∀ d : ℕ, h_η d ≤ (weilMonomialSet (M_N + 1) d).card) →
      (∀ d : ℕ,
        h_η (d + 1) ≤ (weilUpperShadow (M_N + 1) d (weilLexInitSeg (M_N + 1) d (h_η d))).card) →
      (∀ (d : ℕ) {u v : Fin (M_N + 1) → ℕ},
        u ∈ weilMonomialSet (M_N + 1) d → v ∈ weilMonomialSet (M_N + 1) d →
        (toLex v < toLex u ↔ weilLexRank (M_N + 1) d v < weilLexRank (M_N + 1) d u)) →
      (∀ (d c : ℕ),
        c < (weilMonomialSet (M_N + 1) d).card →
        ∃ u ∈ weilMonomialSet (M_N + 1) d,
          weilLexRank (M_N + 1) d u = c ∧
          (weilUpperShadow (M_N + 1) d (weilLexInitSeg (M_N + 1) d c)).card <
            (weilMonomialSet (M_N + 1) (d + 1)).card ∧
          weilLexRank (M_N + 1) (d + 1) (Function.update u (Fin.last M_N) (u (Fin.last M_N) + 1)) =
            (weilUpperShadow (M_N + 1) d (weilLexInitSeg (M_N + 1) d c)).card) →
      ∃ d₀ : ℕ, 1 ≤ d₀ ∧
        ∀ d : ℕ, d₀ ≤ d →
          h_η (d + 1) = (weilUpperShadow (M_N + 1) d (weilLexInitSeg (M_N + 1) d (h_η d))).card := by
    intro M_N h_η hBound hStep hOrder hRankShift
    classical
    let M : ℕ → ℕ := fun d => (weilMonomialSet (M_N + 1) d).card
    let G : ℕ → ℕ := fun d => (weilUpperShadow (M_N + 1) d (weilLexInitSeg (M_N + 1) d (h_η d))).card
    by_cases hAllFull : ∀ d : ℕ, 1 ≤ d → h_η d = M d
    · refine ⟨1, le_rfl, fun d hd => ?_⟩
      have hd1 : 1 ≤ d + 1 := by omega
      rw [hAllFull (d + 1) hd1]
      have hL_full : weilLexInitSeg (M_N + 1) d (h_η d) = weilMonomialSet (M_N + 1) d := by
        rw [hAllFull d hd]
        ext u
        simp only [weilLexInitSeg, Finset.mem_filter, and_iff_left_iff_imp]
        intro hu
        have hRank_eq : weilLexRank (M_N + 1) d u =
            ((weilMonomialSet (M_N + 1) d).filter (fun v => toLex v < toLex u)).card := by
          unfold weilLexRank; congr 1
        rw [hRank_eq]
        refine Finset.card_lt_card ⟨Finset.filter_subset _ _, ?_⟩
        intro hsub
        exact lt_irrefl _ (Finset.mem_filter.mp (hsub hu)).2
      have hSh_full : weilUpperShadow (M_N + 1) d (weilMonomialSet (M_N + 1) d) =
          weilMonomialSet (M_N + 1) (d + 1) := by
        ext w
        simp only [weilUpperShadow, Finset.mem_filter, and_iff_left_iff_imp]
        exact fun hw i hi => update_pred_mem_weilMonomialSet hw i hi
      rw [hL_full, hSh_full]
    · have hex : ∃ d₁ : ℕ, 1 ≤ d₁ ∧ h_η d₁ ≠ M d₁ := by
        by_contra hno
        exact hAllFull fun d hd => Classical.not_not.mp fun hne => hno ⟨d, hd, hne⟩
      obtain ⟨d₁, hd₁_pos, hd₁_ne⟩ := hex
      have hd₁_lt : h_η d₁ < M d₁ := lt_of_le_of_ne (hBound d₁) hd₁_ne
      have hPermLt : ∀ k : ℕ, h_η (d₁ + k) < M (d₁ + k) := by
        intro k
        induction k with
        | zero => simpa using hd₁_lt
        | succ k ih =>
          obtain ⟨_, _, _, hG_lt, _⟩ := hRankShift (d₁ + k) (h_η (d₁ + k)) ih
          have hst : h_η (d₁ + k + 1) ≤
              (weilUpperShadow (M_N + 1) (d₁ + k)
                (weilLexInitSeg (M_N + 1) (d₁ + k) (h_η (d₁ + k)))).card :=
            hStep (d₁ + k)
          exact lt_of_le_of_lt hst hG_lt
      let u_seq : ℕ → (Fin (M_N + 1) → ℕ) :=
        fun k => Classical.choose (hRankShift (d₁ + k) (h_η (d₁ + k)) (hPermLt k))
      have hu_spec : ∀ k : ℕ,
          u_seq k ∈ weilMonomialSet (M_N + 1) (d₁ + k) ∧
          weilLexRank (M_N + 1) (d₁ + k) (u_seq k) = h_η (d₁ + k) ∧
          G (d₁ + k) < M (d₁ + k + 1) ∧
          weilLexRank (M_N + 1) (d₁ + k + 1)
            (Function.update (u_seq k) (Fin.last M_N) (u_seq k (Fin.last M_N) + 1)) = G (d₁ + k) :=
        fun k => Classical.choose_spec (hRankShift (d₁ + k) (h_η (d₁ + k)) (hPermLt k))
      let w_seq : ℕ → (Fin (M_N + 1) → ℕ) :=
        fun k => Function.update (u_seq k) (Fin.last M_N) (u_seq k (Fin.last M_N) + 1)
      have hw_mon : ∀ k : ℕ, w_seq k ∈ weilMonomialSet (M_N + 1) (d₁ + k + 1) := by
        intro k
        rw [mem_weilMonomialSet_iff]
        have hu_sum := (mem_weilMonomialSet_iff (M_N + 1) (d₁ + k) (u_seq k)).mp (hu_spec k).1
        rw [Fin.sum_univ_castSucc] at hu_sum ⊢
        have hcast : ∑ i : Fin M_N, w_seq k i.castSucc = ∑ i : Fin M_N, u_seq k i.castSucc := by
          refine Finset.sum_congr rfl fun i _ => ?_
          simp [w_seq, Fin.castSucc_ne_last]
        rw [hcast]
        simp [w_seq]
        omega
      let π : ℕ → Lex (Fin M_N → ℕ) := fun k => toLex (fun j : Fin M_N => u_seq k j.castSucc)
      have hStep_π : ∀ k : ℕ,
          (h_η (d₁ + k + 1) = G (d₁ + k) → π (k + 1) = π k) ∧
          (h_η (d₁ + k + 1) < G (d₁ + k) → π (k + 1) < π k) := by
        intro k
        have hu_next_mon : u_seq (k + 1) ∈ weilMonomialSet (M_N + 1) (d₁ + k + 1) := (hu_spec (k + 1)).1
        have hu_next_rk : weilLexRank (M_N + 1) (d₁ + k + 1) (u_seq (k + 1)) = h_η (d₁ + k + 1) :=
          (hu_spec (k + 1)).2.1
        have hw_rk : weilLexRank (M_N + 1) (d₁ + k + 1) (w_seq k) = G (d₁ + k) :=
          (hu_spec k).2.2.2
        constructor
        · intro heq
          have hrk_eq : weilLexRank (M_N + 1) (d₁ + k + 1) (u_seq (k + 1)) =
              weilLexRank (M_N + 1) (d₁ + k + 1) (w_seq k) := by omega
          have hu_eq_w : u_seq (k + 1) = w_seq k := by
            rcases lt_trichotomy (toLex (u_seq (k + 1))) (toLex (w_seq k)) with hlt | heq_lex | hgt
            · have := (hOrder (d₁ + k + 1) (hw_mon k) hu_next_mon).mp hlt
              omega
            · exact ofLex_inj.mp heq_lex
            · have := (hOrder (d₁ + k + 1) hu_next_mon (hw_mon k)).mp hgt
              omega
          change toLex (fun j : Fin M_N => u_seq (k + 1) j.castSucc) =
            toLex (fun j : Fin M_N => u_seq k j.castSucc)
          congr 1
          ext j
          rw [hu_eq_w]
          simp [w_seq, Fin.castSucc_ne_last]
        · intro hlt
          have hrk_lt : weilLexRank (M_N + 1) (d₁ + k + 1) (u_seq (k + 1)) <
              weilLexRank (M_N + 1) (d₁ + k + 1) (w_seq k) := by omega
          have hlex_lt : toLex (u_seq (k + 1)) < toLex (w_seq k) :=
            (hOrder (d₁ + k + 1) (hw_mon k) hu_next_mon).mpr hrk_lt
          rw [toLex_lt_iff_fin] at hlex_lt
          obtain ⟨p, hpref, hp_lt⟩ := hlex_lt
          have hp_ne_last : p ≠ Fin.last M_N := by
            intro hlast
            have hu_s := (mem_weilMonomialSet_iff (M_N + 1) (d₁ + k + 1) (u_seq (k + 1))).mp hu_next_mon
            have hw_s := (mem_weilMonomialSet_iff (M_N + 1) (d₁ + k + 1) (w_seq k)).mp (hw_mon k)
            rw [Fin.sum_univ_castSucc] at hu_s hw_s
            have hcs : ∑ i : Fin M_N, u_seq (k + 1) i.castSucc = ∑ i : Fin M_N, w_seq k i.castSucc := by
              refine Finset.sum_congr rfl fun i _ => hpref i.castSucc ?_
              rw [hlast]; exact Fin.castSucc_lt_last i
            rw [hlast] at hp_lt
            omega
          obtain ⟨p₀, hp₀⟩ := Fin.exists_castSucc_eq.mpr hp_ne_last
          change toLex (fun j : Fin M_N => u_seq (k + 1) j.castSucc) <
            toLex (fun j : Fin M_N => u_seq k j.castSucc)
          rw [toLex_lt_iff_fin]
          refine ⟨p₀, ?_, ?_⟩
          · intro j hjp₀
            have hj_lt_p : j.castSucc < p := by
              rw [← hp₀]
              exact Fin.castSucc_lt_castSucc_iff.mpr hjp₀
            calc u_seq (k + 1) j.castSucc = w_seq k j.castSucc := hpref j.castSucc hj_lt_p
              _ = u_seq k j.castSucc := by simp [w_seq, Fin.castSucc_ne_last]
          · calc u_seq (k + 1) p₀.castSucc = u_seq (k + 1) p := by rw [hp₀]
              _ < w_seq k p := hp_lt
              _ = w_seq k p₀.castSucc := by rw [← hp₀]
              _ = u_seq k p₀.castSucc := by simp [w_seq, Fin.castSucc_ne_last]
      have hAnti_step : ∀ k : ℕ, π (k + 1) ≤ π k := by
        intro k
        have hle := hStep (d₁ + k)
        rcases lt_or_eq_of_le hle with hlt | heq
        · exact le_of_lt ((hStep_π k).2 hlt)
        · exact le_of_eq ((hStep_π k).1 heq)
      let a_dual : ℕ →o (Lex (Fin M_N → ℕ))ᵒᵈ :=
        ⟨fun k => OrderDual.toDual (π k),
          monotone_nat_of_le_succ fun k => hAnti_step k⟩
      have : WellFoundedLT (Lex (Fin M_N → ℕ)) := Pi.Lex.wellFoundedLT
      obtain ⟨k₀, hk₀⟩ := WellFoundedGT.monotone_chain_condition a_dual
      refine ⟨d₁ + k₀, by omega, fun d hd => ?_⟩
      let k := d - d₁
      have hdk : d₁ + k = d := by omega
      have hk_ge : k₀ ≤ k := by omega
      have hk1_ge : k₀ ≤ k + 1 := by omega
      have hπ_eq : π (k + 1) = π k := by
        have h1 : OrderDual.toDual (π k₀) = OrderDual.toDual (π k) := hk₀ k hk_ge
        have h2 : OrderDual.toDual (π k₀) = OrderDual.toDual (π (k + 1)) := hk₀ (k + 1) hk1_ge
        exact OrderDual.toDual.injective (h2.symm.trans h1)
      have hle := hStep (d₁ + k)
      rcases lt_or_eq_of_le hle with hlt | heq
      · have hlt_π := (hStep_π k).2 hlt
        exact False.elim (ne_of_lt hlt_π hπ_eq)
      · simpa [G, hdk] using heq

  
  have hOrderAll : ∀ (m e : ℕ) {u v : Fin (m + 1) → ℕ},
      u ∈ weilMonomialSet (m + 1) e → v ∈ weilMonomialSet (m + 1) e →
      (toLex v < toLex u ↔ weilLexRank (m + 1) e v < weilLexRank (m + 1) e u) :=
    fun m => (s2_lexInitSeg_shadow_properties m).1
  have hCardAll : ∀ (m e c : ℕ),
      (weilLexInitSeg (m + 1) e c).card = min c (weilMonomialSet (m + 1) e).card :=
    fun m => (s2_lexInitSeg_shadow_properties m).2.1
  have hMonoAll : ∀ (m e c₁ c₂ : ℕ),
      c₁ ≤ c₂ → weilLexInitSeg (m + 1) e c₁ ⊆ weilLexInitSeg (m + 1) e c₂ :=
    fun m => (s2_lexInitSeg_shadow_properties m).2.2.1
  have hDownAll : ∀ (m e : ℕ) (S : Finset (Fin (m + 1) → ℕ)),
      S ⊆ weilMonomialSet (m + 1) e →
      (∀ u ∈ S, ∀ v ∈ weilMonomialSet (m + 1) e, toLex v < toLex u → v ∈ S) →
      S = weilLexInitSeg (m + 1) e S.card :=
    fun m => (s2_lexInitSeg_shadow_properties m).2.2.2.1
  have hInitShAll : ∀ (m e c : ℕ),
      weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e c) =
        weilLexInitSeg (m + 1) (e + 1)
          (weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e c)).card :=
    fun m => (s2_lexInitSeg_shadow_properties m).2.2.2.2.1
  have hGrowAll : ∀ (m e c : ℕ),
      (weilLexInitSeg (m + 1) e c).card ≤
        (weilUpperShadow (m + 1) e (weilLexInitSeg (m + 1) e c)).card :=
    fun m => (s2_lexInitSeg_shadow_properties m).2.2.2.2.2.1
  have hRankShiftN := (s2_lexInitSeg_shadow_properties N).2.2.2.2.2.2
  obtain ⟨hLow1, hLow2, hLow3⟩ := s4_low_dim_shadow_bounds hCardAll hGrowAll
  have hMacAll : ∀ (m d : ℕ) (ℱ : Finset (Fin (m + 1) → ℕ)),
      ℱ ⊆ weilMonomialSet (m + 1) d →
      (weilUpperShadow (m + 1) d ℱ).card ≤
        (weilUpperShadow (m + 1) d (weilLexInitSeg (m + 1) d ℱ.card)).card := by
    intro m
    induction m with
    | zero => exact hLow1
    | succ m₁ ih =>
      rcases m₁ with _ | _ | m'
      · exact hLow2
      · intro d ℱ hSub
        obtain ⟨ℱ_star, hSub_s, hCard_s, hSh_s, hComp_s⟩ :=
          s3_slice_compression_fixed_point 1 d ℱ hSub hOrderAll (hCardAll 1) (hMonoAll 1)
            (hInitShAll 1) ih
        calc (weilUpperShadow 3 d ℱ).card
            ≤ (weilUpperShadow 3 d ℱ_star).card := hSh_s
          _ ≤ (weilUpperShadow 3 d (weilLexInitSeg 3 d ℱ_star.card)).card :=
              hLow3 d ℱ_star hSub_s hComp_s
          _ = (weilUpperShadow 3 d (weilLexInitSeg 3 d ℱ.card)).card := by rw [hCard_s]
      · intro d ℱ hSub
        obtain ⟨ℱ_star, hSub_s, hCard_s, hSh_s, hComp_s⟩ :=
          s3_slice_compression_fixed_point (m' + 2) d ℱ hSub hOrderAll (hCardAll (m' + 2))
            (hMonoAll (m' + 2)) (hInitShAll (m' + 2)) ih
        have hEqL : ℱ_star = weilLexInitSeg (m' + 4) d ℱ_star.card :=
          s5_high_dim_compressed_eq_lexInitSeg m' d ℱ_star hSub_s hComp_s (hDownAll (m' + 3) d)
        calc (weilUpperShadow (m' + 4) d ℱ).card
            ≤ (weilUpperShadow (m' + 4) d ℱ_star).card := hSh_s
          _ = (weilUpperShadow (m' + 4) d (weilLexInitSeg (m' + 4) d ℱ.card)).card := by
              conv_lhs => rw [hEqL]
              rw [hCard_s]
  have hShadowMono : ∀ (m d : ℕ) {𝒜 ℬ : Finset (Fin (m + 1) → ℕ)},
      𝒜 ⊆ ℬ → weilUpperShadow (m + 1) d 𝒜 ⊆ weilUpperShadow (m + 1) d ℬ := by
    intro m d 𝒜 ℬ hAB w hw
    obtain ⟨hw_mon, hw_sh⟩ := Finset.mem_filter.mp hw
    exact Finset.mem_filter.mpr ⟨hw_mon, fun i hi => hAB (hw_sh i hi)⟩
  obtain ⟨𝒪_η, hSub_η, hCard_η, hSh_η⟩ := s1_initial_monomial_reduction N K I_η
  let h_η : ℕ → ℕ := fun d => (𝒪_η d).card
  have hBound_η : ∀ d : ℕ, h_η d ≤ (weilMonomialSet (N + 1) d).card :=
    fun d => Finset.card_le_card (hSub_η d)
  have hStep_η : ∀ d : ℕ,
      h_η (d + 1) ≤ (weilUpperShadow (N + 1) d (weilLexInitSeg (N + 1) d (h_η d))).card := by
    intro d
    calc (𝒪_η (d + 1)).card
        ≤ (weilUpperShadow (N + 1) d (𝒪_η d)).card := Finset.card_le_card (hSh_η d)
      _ ≤ (weilUpperShadow (N + 1) d (weilLexInitSeg (N + 1) d (h_η d))).card :=
          hMacAll N d (𝒪_η d) (hSub_η d)
  obtain ⟨d₀, hd₀_pos, hPersist⟩ :=
    s6_numerical_persistence_threshold N h_η hBound_η hStep_η (hOrderAll N) hRankShiftN
  refine ⟨d₀, hd₀_pos, ?_⟩
  intro F _ J h_le₀ d hd
  obtain ⟨𝒪_J, hSub_J, hCard_J, hSh_J⟩ := s1_initial_monomial_reduction N F J
  rw [← hCard_J d, ← hCard_η d]
  rw [← hCard_J d₀, ← hCard_η d₀] at h_le₀
  refine Nat.le_induction h_le₀ (fun e he ih_e => ?_) d hd
  calc (𝒪_J (e + 1)).card
      ≤ (weilUpperShadow (N + 1) e (𝒪_J e)).card := Finset.card_le_card (hSh_J e)
    _ ≤ (weilUpperShadow (N + 1) e (weilLexInitSeg (N + 1) e (𝒪_J e).card)).card :=
        hMacAll N e (𝒪_J e) (hSub_J e)
    _ ≤ (weilUpperShadow (N + 1) e (weilLexInitSeg (N + 1) e (h_η e))).card :=
        Finset.card_le_card (hShadowMono N e (hMonoAll N e _ _ ih_e))
    _ = (𝒪_η (e + 1)).card := (hPersist e he).symm

theorem weil_dominant_proj_generic_coord_package (k : Type u) [Field k] (N : ℕ)
    (S Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral S.left] [AlgebraicGeometry.IsIntegral Y.left]
    (U : S.left.Opens) (hU : Nonempty U)
    (p : Y ⟶ S) (hSurjU : AlgebraicGeometry.Surjective (p.left ∣_ U))
    (ι_Y : Y ⟶ weilProjectiveSpaceOver k N)
    (hClY : AlgebraicGeometry.IsClosedImmersion ι_Y.left) :
    ∃ (U₀ : S.left.Opens)
      (hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀)
      (hNeU₀ : Nonempty U₀)
      (φ_KL : ↑S.left.functionField →+* ↑Y.left.functionField)
      (u : Fin (N + 1) → ↑Y.left.functionField)
      (i₀ : Fin (N + 1))
      (D_proj : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens)
      (coord_ratio : ∀ i : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D_proj i)))),
      U₀ ≤ U ∧
      (∀ (V : S.left.Opens) [Nonempty V] (W : Y.left.Opens) [Nonempty W]
          (hWV : W ≤ (TopologicalSpace.Opens.map p.left.base).obj V),
        (p.left.appLE V W hWV ≫ Y.left.germToFunctionField W).hom =
          φ_KL.comp (S.left.germToFunctionField V).hom) ∧
      u i₀ = 1 ∧
      (⨆ i : Fin (N + 1), D_proj i = ⊤) ∧
      (∀ i : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_proj i)) ∧
      (∀ i : Fin (N + 1),
        letI : Algebra k ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D_proj i))) :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            ((weilProjectiveSpaceOver k N).hom.appLE ⊤ (D_proj i) le_top)).hom).toAlgebra
        Algebra.adjoin k (Set.range (coord_ratio i)) = ⊤) ∧
      (∀ i : Fin (N + 1), u i = 0 →
        (TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i) = ⊥) ∧
      (∀ i : Fin (N + 1), u i ≠ 0 →
        ∃ hNeW : Nonempty ((TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i)),
          ∀ r : Fin (N + 1),
            letI := hNeW
            (Y.left.germToFunctionField
              ((TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i))).hom
              ((ι_Y.left.app (D_proj i)).hom (coord_ratio i r)) = (u i)⁻¹ * u r) :=
by
  
  
  
  obtain ⟨⟨s₀, hs₀⟩⟩ := hU
  obtain ⟨U₀, hAffU₀, hs₀_U₀, hU₀_le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.left.isBasis_affineOpens) hs₀
  have hNeU₀ : Nonempty U₀ := ⟨⟨s₀, hs₀_U₀⟩⟩
  let η_Y : ↥Y.left := genericPoint ↥Y.left
  let η_S : ↥S.left := genericPoint ↥S.left
  have hGenImg : IsGenericPoint (p.left.base η_Y) (closure (p.left.base '' Set.univ)) :=
    (genericPoint_spec ↥Y.left).image p.left.continuous
  have hU_sub_range : (U : Set ↥S.left) ⊆ p.left.base '' Set.univ := by
    intro s hs
    obtain ⟨y', hy'⟩ := hSurjU.1 ⟨s, hs⟩
    refine ⟨(p.left ⁻¹ᵁ U).ι.base y', trivial, ?_⟩
    change ((p.left ⁻¹ᵁ U).ι ≫ p.left).base y' = U.ι.base ⟨s, hs⟩
    rw [← AlgebraicGeometry.morphismRestrict_ι p.left U]
    change U.ι.base ((p.left ∣_ U).base y') = U.ι.base ⟨s, hs⟩
    rw [hy']
  have hU_dense : closure (U : Set ↥S.left) = Set.univ := by
    apply Set.Subset.antisymm (Set.subset_univ _)
    intro x _
    rw [mem_closure_iff]
    intro O hO hxO
    obtain ⟨z, _, hz⟩ :=
      PreirreducibleSpace.isPreirreducible_univ O (U : Set ↥S.left) hO U.isOpen
        ⟨x, trivial, hxO⟩ ⟨s₀, trivial, hs₀⟩
    exact ⟨z, hz⟩
  have hClRange : closure (p.left.base '' Set.univ) = Set.univ := by
