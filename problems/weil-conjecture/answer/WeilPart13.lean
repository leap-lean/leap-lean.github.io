    let ψ₁' : TensorProduct R₁ A₁ K₁ →+* D_K := ψ₁.comp α_A.toRingHom
    let ψ₂' : (MvPolynomial (Fin 2) K₁ ⧸ I_K₁) →+* D_K := ψ₂.comp α_N.toRingHom
