    have h_app : (AlgebraicGeometry.Spec.map φ).base (⟨⊥, inferInstance⟩ : PrimeSpectrum ↑B) =
        PrimeSpectrum.comap φ.hom (⟨⊥, inferInstance⟩ : PrimeSpectrum ↑B) :=
      AlgebraicGeometry.Spec.map_apply φ (⟨⊥, inferInstance⟩ : PrimeSpectrum ↑B)
    rw [← h_app, h_pt_eq] at hr_mem
