theorem weil_nc2d_reduced_target_dvr_ord_one_and_top_subsingletons (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ)
    (W_prev W_top C₂ : AlgebraicGeometry.Scheme.{u})
