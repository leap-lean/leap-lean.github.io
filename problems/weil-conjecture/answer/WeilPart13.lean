        hVz.isLocalization_stalk ⟨z, hz⟩
      exact isReduced_of_injective
        (IsLocalization.algEquiv (hVz.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl
          ↑(C_K.presheaf.stalk z) (Localization.AtPrime (hVz.primeIdealOf ⟨z, hz⟩).asIdeal))
        (AlgEquiv.injective _)
    haveI : AlgebraicGeometry.IsReduced C_K := AlgebraicGeometry.isReduced_of_isReduced_stalk C_K
    have h_loc_preirred_CK : ∀ z : ↥C_K,
        ∃ U_z : Set ↥C_K, IsOpen U_z ∧ z ∈ U_z ∧ IsPreirreducible U_z := by
      intro z
      obtain ⟨V_z, hVz, hz, hNoeth, hDom⟩ := h_chart_dom z
      let S_ring : Type u := ↑(C_K.presheaf.obj (Opposite.op V_z))
      haveI : IsNoetherianRing S_ring := hNoeth
      let q_pt : PrimeSpectrum S_ring := hVz.primeIdealOf ⟨z, hz⟩
      let q₀ : Ideal S_ring := q_pt.asIdeal
      haveI : IsDomain (Localization.AtPrime q₀) := hDom
      let p_bot : Ideal S_ring := Ideal.comap (algebraMap S_ring (Localization.AtPrime q₀)) ⊥
      have hp_bot_prime : p_bot.IsPrime := Ideal.IsPrime.comap _
      have hp_bot_le : ∀ (r : Ideal S_ring), r.IsPrime → r ≤ q₀ → p_bot ≤ r := by
        intro r hr hr_le x hx
        obtain ⟨c, hc⟩ :=
          (IsLocalization.map_eq_zero_iff q₀.primeCompl (Localization.AtPrime q₀) x).mp hx
        rcases hr.mem_or_mem (hc ▸ r.zero_mem : (c : S_ring) * x ∈ r) with hc_in | hx_in
        · exact False.elim (c.2 (hr_le hc_in))
        · exact hx_in
      let M_other : Set (Ideal S_ring) := minimalPrimes S_ring \ {p_bot}
      have hFin : M_other.Finite := (minimalPrimes.finite_of_isNoetherianRing S_ring).sdiff
      let F_other : Set (PrimeSpectrum S_ring) :=
        ⋃ m ∈ M_other, PrimeSpectrum.zeroLocus (m : Set S_ring)
      have hOpenU : IsOpen F_otherᶜ :=
        (hFin.isClosed_biUnion (fun _ _ => PrimeSpectrum.isClosed_zeroLocus _)).isOpen_compl
      have hq_in_U : q_pt ∈ F_otherᶜ := by
        intro hmem
        simp only [F_other, Set.mem_iUnion] at hmem
        rcases hmem with ⟨m, ⟨hm_min, hm_ne⟩, hq_zl⟩
        have hp_le_m : p_bot ≤ m := hp_bot_le m hm_min.1.1 hq_zl
        exact hm_ne (le_antisymm (hm_min.2 ⟨hp_bot_prime, bot_le⟩ hp_le_m) hp_le_m)
      let Z₀ : Set (PrimeSpectrum S_ring) := PrimeSpectrum.zeroLocus (p_bot : Set S_ring)
      have hU_sub_Z₀ : F_otherᶜ ⊆ Z₀ := by
        intro x_sp hx_sp
        obtain ⟨m, hm_min, hm_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ x_sp.asIdeal)
        by_cases hm_eq : m = p_bot
        · change p_bot ≤ x_sp.asIdeal
          exact hm_eq ▸ hm_le
        · exfalso
          apply hx_sp
          simp only [F_other, Set.mem_iUnion]
          exact ⟨m, ⟨hm_min, hm_eq⟩, hm_le⟩
      have hIrredZ₀ : IsIrreducible Z₀ :=
        (PrimeSpectrum.isIrreducible_zeroLocus_iff_of_radical p_bot hp_bot_prime.isRadical).mpr
          hp_bot_prime
      have hPreU : IsPreirreducible F_otherᶜ := by
        intro u v hu hv ⟨x₁, hx₁U, hx₁u⟩ ⟨x₂, hx₂U, hx₂v⟩
        obtain ⟨w, _, ⟨hwU, hwu⟩, ⟨_, hwv⟩⟩ :=
          hIrredZ₀.isPreirreducible (F_otherᶜ ∩ u) (F_otherᶜ ∩ v)
            (hOpenU.inter hu) (hOpenU.inter hv)
            ⟨x₁, hU_sub_Z₀ hx₁U, hx₁U, hx₁u⟩ ⟨x₂, hU_sub_Z₀ hx₂U, hx₂U, hx₂v⟩
        exact ⟨w, hwU, hwu, hwv⟩
      refine ⟨hVz.fromSpec.base '' F_otherᶜ,
        hVz.fromSpec.isOpenEmbedding.isOpenMap F_otherᶜ hOpenU,
        ⟨q_pt, hq_in_U, hVz.fromSpec_primeIdealOf ⟨z, hz⟩⟩,
        hPreU.image hVz.fromSpec.base hVz.fromSpec.continuous.continuousOn⟩
    haveI : IrreducibleSpace ↥C_K :=
      { isPreirreducible_univ := by
          intro W₁ W₂ hW₁ hW₂ ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩
          have hOpenCl : IsOpen (closure W₁) := by
            rw [isOpen_iff_forall_mem_open]
            intro z hz_cl
            obtain ⟨U_z, hOpenUz, hzUz, hPreUz⟩ := h_loc_preirred_CK z
            have hUzW₁ : (U_z ∩ W₁).Nonempty :=
              mem_closure_iff.mp hz_cl U_z hOpenUz hzUz
            refine ⟨U_z, ?_, hOpenUz, hzUz⟩
            intro y hyUz
            rw [mem_closure_iff]
            intro O hOpenO hyO
            obtain ⟨w, _, hwO, hwW₁⟩ :=
              hPreUz O W₁ hOpenO hW₁ ⟨y, hyUz, hyO⟩ hUzW₁
            exact ⟨w, hwO, hwW₁⟩
          have hCl_univ : closure W₁ = Set.univ :=
            IsClopen.eq_univ ⟨isClosed_closure, hOpenCl⟩ ⟨y₁, subset_closure hy₁⟩
          obtain ⟨w, hwW₂, hwW₁⟩ :=
            mem_closure_iff.mp (hCl_univ ▸ Set.mem_univ y₂) W₂ hW₂ hy₂
          exact ⟨w, Set.mem_univ w, hwW₁, hwW₂⟩
        toNonempty := hConn_CK.toNonempty }
    haveI : AlgebraicGeometry.Flat g_a := hStab_a.2.1
    haveI : AlgebraicGeometry.LocallyOfFinitePresentation g_a := hStab_a.2.2.2.1
    haveI : AlgebraicGeometry.UniversallyOpen g_a := AlgebraicGeometry.UniversallyOpen.of_flat g_a
    have hg_open : IsOpenMap ⇑g_a := AlgebraicGeometry.Scheme.Hom.isOpenMap g_a
    have h_pre_ne : ∀ (O : Set ↥C_a), IsOpen O → O.Nonempty → (⇑fst_K ⁻¹' O).Nonempty := by
      intro O hO ⟨y₀, hy₀⟩
      let U_O : W_a.toScheme.Opens := ⟨⇑g_a '' O, hg_open O hO⟩
      have hUO_ne : Nonempty ↥U_O := ⟨⟨g_a y₀, y₀, hy₀, rfl⟩⟩
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_W)) :=
        p_K (Classical.arbitrary ↥C_K)
      have hmem : η_W pt₀ ∈ (U_O : Set ↥W_a.toScheme) := hη_mem U_O hUO_ne pt₀
      rcases hmem with ⟨y, hyO, hy_eq⟩
      have hy_pre : y ∈ ⇑g_a ⁻¹' Set.range ⇑η_W := ⟨pt₀, hy_eq.symm⟩
      rw [← AlgebraicGeometry.Scheme.Pullback.range_fst g_a η_W] at hy_pre
      rcases hy_pre with ⟨z, rfl⟩
      exact ⟨z, hyO⟩
    have hPreCa : PreirreducibleSpace ↥C_a := by
      refine ⟨fun O₁ O₂ hO₁ hO₂ h₁ h₂ => ?_⟩
      have h₁' : (⇑fst_K ⁻¹' O₁).Nonempty := h_pre_ne O₁ hO₁ (h₁.mono Set.inter_subset_right)
      have h₂' : (⇑fst_K ⁻¹' O₂).Nonempty := h_pre_ne O₂ hO₂ (h₂.mono Set.inter_subset_right)
      obtain ⟨z, hz₁, hz₂⟩ := nonempty_preirreducible_inter
        (hO₁.preimage fst_K.continuous) (hO₂.preimage fst_K.continuous) h₁' h₂'
      exact ⟨fst_K z, trivial, hz₁, hz₂⟩
    haveI : IrreducibleSpace ↥C_a :=
      { toPreirreducibleSpace := hPreCa
        toNonempty := ⟨fst_K (Classical.arbitrary ↥C_K)⟩ }
    haveI : ∀ x : ↥C_a, _root_.IsReduced ↑(C_a.presheaf.stalk x) := by
      intro x
      obtain ⟨U_S, hUS, hgx, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g_a x) (U := ⊤) trivial
      haveI : Nonempty ↥U_S := ⟨⟨g_a x, hgx⟩⟩
      obtain ⟨U_C, hUC, hx, h_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (TopologicalSpace.Opens.map g_a.base).obj U_S) hgx
      let R₀_cat := W_a.toScheme.presheaf.obj (Opposite.op U_S)
      let A₀_cat := C_a.presheaf.obj (Opposite.op U_C)
      let ψ_CA : R₀_cat ⟶ A₀_cat := g_a.appLE U_S U_C h_le
      obtain ⟨φ_W, hFrac, hSpec_φ⟩ := hFuncW U_S hUS inferInstance
      letI : Algebra (↑R₀_cat) K_W := φ_W.hom.toAlgebra
      letI : Algebra (↑R₀_cat) (↑A₀_cat) := ψ_CA.hom.toAlgebra
      haveI : IsFractionRing (↑R₀_cat) K_W := hFrac
      haveI : AlgebraicGeometry.IsOpenImmersion hUS.fromSpec := hUS.isOpenImmersion_fromSpec
      haveI : AlgebraicGeometry.IsOpenImmersion hUC.fromSpec := hUC.isOpenImmersion_fromSpec
      let e_spec : AlgebraicGeometry.Spec
            (CommRingCat.of (TensorProduct (↑R₀_cat) K_W (↑A₀_cat))) ≅
          CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map φ_W) (AlgebraicGeometry.Spec.map ψ_CA) :=
        (AlgebraicGeometry.pullbackSpecIso (↑R₀_cat) K_W (↑A₀_cat)).symm
      have h_psi_fac : AlgebraicGeometry.Spec.map ψ_CA ≫ hUS.fromSpec = hUC.fromSpec ≫ g_a :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec g_a hUS hUC h_le
      have sq_left : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map φ_W) (AlgebraicGeometry.Spec.map ψ_CA))
          (CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map φ_W) (AlgebraicGeometry.Spec.map ψ_CA))
          η_W (hUC.fromSpec ≫ g_a) := by
        refine
          { w := by
              rw [← hSpec_φ, ← h_psi_fac, ← CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
            isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
              (fun s => CategoryTheory.Limits.pullback.lift s.fst s.snd
                ((cancel_mono hUS.fromSpec).mp (by
                  rw [CategoryTheory.Category.assoc, hSpec_φ,
                    CategoryTheory.Category.assoc, h_psi_fac]
                  exact s.condition)))
              (fun s => CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (fun s => CategoryTheory.Limits.pullback.lift_snd _ _ _)
              (fun s m hm₁ hm₂ => CategoryTheory.Limits.pullback.hom_ext
                (hm₁.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
                (hm₂.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))⟩ }
      have sq_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd hUC.fromSpec fst_K ≫ p_K)
          (CategoryTheory.Limits.pullback.fst hUC.fromSpec fst_K)
          η_W (hUC.fromSpec ≫ g_a) :=
        ((CategoryTheory.IsPullback.of_hasPullback hUC.fromSpec fst_K).flip).paste_horiz
          ((CategoryTheory.IsPullback.of_hasPullback g_a η_W).flip)
      let e_pb := CategoryTheory.IsPullback.isoIsPullback
        (AlgebraicGeometry.Spec (CommRingCat.of K_W))
        (AlgebraicGeometry.Spec A₀_cat) sq_left sq_right
      let ι_tensor : AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct (↑R₀_cat) K_W (↑A₀_cat))) ⟶ C_K :=
        e_spec.hom ≫ e_pb.hom ≫ CategoryTheory.Limits.pullback.snd hUC.fromSpec fst_K
      haveI : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct (↑R₀_cat) K_W (↑A₀_cat)))) :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion ι_tensor
      haveI : _root_.IsReduced (TensorProduct (↑R₀_cat) K_W (↑A₀_cat)) :=
        (AlgebraicGeometry.affine_isReduced_iff
          (CommRingCat.of (TensorProduct (↑R₀_cat) K_W (↑A₀_cat)))).mp inferInstance
      haveI : IsDomain (↑R₀_cat) :=
        @AlgebraicGeometry.IsIntegral.component_integral W_a.toScheme _ U_S ⟨⟨g_a x, hgx⟩⟩
      have hinj_RK : Function.Injective (algebraMap (↑R₀_cat) K_W) :=
        IsFractionRing.injective (↑R₀_cat) K_W
      haveI : Module.Flat (↑R₀_cat) (↑A₀_cat) :=
        RingHom.flat_algebraMap_iff.mp (g_a.flat_appLE hUS hUC h_le)
      haveI : _root_.IsReduced (↑A₀_cat) :=
        isReduced_of_injective
          (Algebra.TensorProduct.includeRight (R := ↑R₀_cat) (A := K_W) (B := ↑A₀_cat))
          (Algebra.TensorProduct.includeRight_injective hinj_RK)
      let S_x := ↑(C_a.presheaf.stalk x)
      letI : Algebra (↑A₀_cat) S_x := (C_a.presheaf.germ U_C x hx).hom.toAlgebra
      let M_x := (hUC.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      haveI : IsLocalization M_x S_x := hUC.isLocalization_stalk ⟨x, hx⟩
      refine ⟨fun s ⟨m, hsm⟩ => ?_⟩
      obtain ⟨⟨a, t⟩, hst⟩ := IsLocalization.surj M_x s
      have ham : algebraMap (↑A₀_cat) S_x (a ^ m) = algebraMap (↑A₀_cat) S_x 0 := by
        rw [map_pow, ← hst, mul_pow, hsm, zero_mul, map_zero]
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists M_x S_x).mp ham
      have hca_nil : ((c : ↑A₀_cat) * a) ^ (m + 1) = 0 := by
        have hc0 : (c : ↑A₀_cat) * a ^ m = 0 := by
          simpa only [mul_zero] using hc
        calc ((c : ↑A₀_cat) * a) ^ (m + 1)
            = (c : ↑A₀_cat) ^ m * a * ((c : ↑A₀_cat) * a ^ m) := by ring
          _ = 0 := by rw [hc0, mul_zero]
      have hca_zero : (c : ↑A₀_cat) * a = 0 :=
        IsReduced.eq_zero ((c : ↑A₀_cat) * a) ⟨m + 1, hca_nil⟩
      have hcs : algebraMap (↑A₀_cat) S_x (c : ↑A₀_cat) *
          (s * algebraMap (↑A₀_cat) S_x (t : ↑A₀_cat)) = 0 := by
        rw [hst, ← map_mul, hca_zero, map_zero]
      have hst_zero : s * algebraMap (↑A₀_cat) S_x (t : ↑A₀_cat) = 0 :=
        (IsLocalization.map_units S_x c).mul_right_eq_zero.mp hcs
      exact (IsLocalization.map_units S_x t).mul_left_eq_zero.mp hst_zero
    haveI : AlgebraicGeometry.IsReduced C_a :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk C_a
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_a

theorem weil_isGeometricStablePointedCurve_baseChange_and_dominant (n : ℕ)
    (C S : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ S)
    (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ) :
    (∀ (S' : AlgebraicGeometry.Scheme.{u}) (u : S' ⟶ S)
       (τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g u)),
       (∀ j : Fin n,
         τ' j ≫ CategoryTheory.Limits.pullback.fst g u = u ≫ τ j ∧
         τ' j ≫ CategoryTheory.Limits.pullback.snd g u = 𝟙 S') →
       IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g u) n τ') ∧
    (∀ (C' S' : AlgebraicGeometry.Scheme.{u}) (g' : C' ⟶ S') (τ' : Fin n → (S' ⟶ C'))
       (e_C : C ≅ C') (e_S : S ≅ S'),
       e_C.hom ≫ g' = g ≫ e_S.hom →
       (∀ j : Fin n, τ' j = e_S.inv ≫ τ j ≫ e_C.hom) →
       IsGeometricStablePointedCurve g' n τ') ∧
    (∀ (S' : AlgebraicGeometry.Scheme.{u}) (u : S' ⟶ S),
       AlgebraicGeometry.IsDominant u →
       AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g u)) :=
by
  rcases hStab with ⟨hn, hFlat, hProp, hLFP, hSurj, hSec, hDisj, hSmSec, hGeom⟩
  have hTransfer : ∀ {C' S' : AlgebraicGeometry.Scheme.{u}}
      {g' : C' ⟶ S'} {p_C : C' ⟶ C} {u : S' ⟶ S} {τ' : Fin n → (S' ⟶ C')},
      CategoryTheory.IsPullback p_C g' g u →
      (∀ j : Fin n, τ' j ≫ g' = 𝟙 S') →
      (∀ j : Fin n, τ' j ≫ p_C = u ≫ τ j) →
      IsGeometricStablePointedCurve g' n τ' := by
    intro C' S' g' p_C u τ' hp hSec' hτ_comm
    have hFlat' : AlgebraicGeometry.Flat g' :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Flat) hp hFlat
    have hProp' : AlgebraicGeometry.IsProper g' :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsProper) hp hProp
    have hLFP' : AlgebraicGeometry.LocallyOfFinitePresentation g' :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation) hp hLFP
    have hSurj' : AlgebraicGeometry.Surjective g' :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hp hSurj
    have hDisj' : _root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ' i).base) (Set.range (τ' j).base) := by
      intro i j hij
      rw [Set.disjoint_left]
      rintro z ⟨w₁, rfl⟩ ⟨w₂, hw₂⟩
      have hz_i : p_C.base ((τ' i).base w₁) ∈ Set.range (τ i).base := by
        have h1 : p_C.base ((τ' i).base w₁) = (τ i).base (u.base w₁) := by
          simpa using congrArg (fun φ => φ.base w₁) (hτ_comm i)
        rw [h1]
        exact ⟨u.base w₁, rfl⟩
      have hz_j : p_C.base ((τ' i).base w₁) ∈ Set.range (τ j).base := by
        rw [← hw₂]
        have h1 : p_C.base ((τ' j).base w₂) = (τ j).base (u.base w₂) := by
          simpa using congrArg (fun φ => φ.base w₂) (hτ_comm j)
        rw [h1]
        exact ⟨u.base w₂, rfl⟩
      exact Set.disjoint_left.mp (hDisj hij) hz_i hz_j
    have hSmSec' : ∀ (j : Fin n) (b : S'), ∃ V' : C'.Opens,
        (τ' j).base b ∈ V' ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V'.ι ≫ g') := by
      intro j b
      obtain ⟨V, hbV, hSmV⟩ := hSmSec j (u.base b)
      refine ⟨p_C ⁻¹ᵁ V, ?_, ?_⟩
      · change p_C.base ((τ' j).base b) ∈ V
        have h1 : p_C.base ((τ' j).base b) = (τ j).base (u.base b) := by
          simpa using congrArg (fun φ => φ.base b) (hτ_comm j)
        rw [h1]
        exact hbV
      · have hp_res : CategoryTheory.IsPullback (p_C ∣_ V) (p_C ⁻¹ᵁ V).ι V.ι p_C :=
          AlgebraicGeometry.isPullback_morphismRestrict p_C V
        exact MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
          (hp_res.paste_vert hp) hSmV
    have hSecRange : ∀ j : Fin n,
        Set.range (τ' j).base = p_C.base ⁻¹' Set.range (τ j).base := by
      intro j
      have h_outer : CategoryTheory.IsPullback u (τ' j ≫ g') (τ j ≫ g) u := by
        rw [hSec' j, hSec j]
        exact CategoryTheory.IsPullback.id_vert u
      have hp_sec : CategoryTheory.IsPullback u (τ' j) (τ j) p_C :=
        CategoryTheory.IsPullback.of_bot h_outer (hτ_comm j).symm hp
      let e_sec := hp_sec.isoPullback
      have he_snd : e_sec.hom ≫ CategoryTheory.Limits.pullback.snd (τ j) p_C = τ' j :=
        hp_sec.isoPullback_hom_snd
      have hsurj : Function.Surjective e_sec.hom.base := by
        intro y
        refine ⟨(Scheme.homeoOfIso e_sec).symm y, ?_⟩
        have h_app := (Scheme.homeoOfIso e_sec).apply_symm_apply y
        rwa [Scheme.homeoOfIso_apply] at h_app
      have hrange1 : Set.range (τ' j).base =
          Set.range (CategoryTheory.Limits.pullback.snd (τ j) p_C).base := by
        rw [← he_snd]
        change Set.range ((CategoryTheory.Limits.pullback.snd (τ j) p_C).base ∘ e_sec.hom.base) = _
        exact hsurj.range_comp _
      rw [hrange1]
      exact AlgebraicGeometry.Scheme.Pullback.range_snd (τ j) p_C
    have hIrredHomeo : ∀ {X Z : Type u} [TopologicalSpace X] [TopologicalSpace Z]
        (h : X ≃ₜ Z) {A : Set X},
        A ∈ irreducibleComponents X → h '' A ∈ irreducibleComponents Z := by
      intro X Z _ _ h A hA
      exact image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
        (fun z => Set.Subsingleton.isPreirreducible fun a₁ ha₁ a₂ ha₂ =>
          h.injective (ha₁.trans ha₂.symm))
        h.surjective hA
    refine ⟨hn, hFlat', hProp', hLFP', hSurj', hSec', hDisj', hSmSec', ?_⟩
    intro K _ _ s
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S := s ≫ u
    have hp_fib : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g' s ≫ p_C)
        (CategoryTheory.Limits.pullback.snd g' s) g s₀ :=
      (CategoryTheory.IsPullback.of_hasPullback g' s).paste_horiz hp
    let Φ := hp_fib.isoPullback
    let hΦ := Scheme.homeoOfIso Φ
    have hΦ_fst : Φ.hom ≫ CategoryTheory.Limits.pullback.fst g s₀ =
        CategoryTheory.Limits.pullback.fst g' s ≫ p_C :=
      hp_fib.isoPullback_hom_fst
    have hΦ_snd : Φ.hom ≫ CategoryTheory.Limits.pullback.snd g s₀ =
        CategoryTheory.Limits.pullback.snd g' s :=
      hp_fib.isoPullback_hom_snd
    have hΦ_inv_snd : Φ.inv ≫ CategoryTheory.Limits.pullback.snd g' s =
        CategoryTheory.Limits.pullback.snd g s₀ := by
      rw [← hΦ_snd, ← CategoryTheory.Category.assoc, Φ.inv_hom_id, CategoryTheory.Category.id_comp]
    rcases hGeom K s₀ with ⟨hConn, hLoc, hP1⟩
    refine ⟨?_, ?_, ?_⟩
    · exact @Function.Surjective.connectedSpace _ _ _ hConn _
        hΦ.symm hΦ.symm.surjective hΦ.symm.continuous
    · intro y'
      rcases hLoc (hΦ y') with ⟨V, hyV, hSmV⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hMax, hRoof⟩
      · let V' : (CategoryTheory.Limits.pullback g' s).Opens := Φ.hom ⁻¹ᵁ V
        have hyV' : y' ∈ V' := by
          change Φ.hom.base y' ∈ V
          simpa [hΦ, Scheme.homeoOfIso_apply] using hyV
        have hp_res : CategoryTheory.IsPullback (Φ.hom ∣_ V) V'.ι V.ι Φ.hom :=
          AlgebraicGeometry.isPullback_morphismRestrict Φ.hom V
        have : IsIso (Φ.hom ∣_ V) := hp_res.isIso_fst_of_isIso
        have hV'_eq : V'.ι ≫ CategoryTheory.Limits.pullback.snd g' s =
            (Φ.hom ∣_ V) ≫ (V.ι ≫ CategoryTheory.Limits.pullback.snd g s₀) := by
          rw [← hΦ_snd, ← CategoryTheory.Category.assoc, ← hp_res.w, CategoryTheory.Category.assoc]
        have hp_iso : CategoryTheory.IsPullback (Φ.hom ∣_ V)
            (V'.ι ≫ CategoryTheory.Limits.pullback.snd g' s)
            (V.ι ≫ CategoryTheory.Limits.pullback.snd g s₀) (𝟙 _) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [CategoryTheory.Category.comp_id, hV'_eq]⟩
        exact Or.inl ⟨V', hyV', MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hp_iso hSmV⟩
      · refine Or.inr ⟨U', u₀, e₁ ≫ Φ.inv, e₂, inferInstance, hEt₂, ?_, hMax, ?_⟩
        · have h1 : (e₁ ≫ Φ.inv).base u₀ = Φ.inv.base (e₁.base u₀) := rfl
          rw [h1, hu₀]
          have h2 : hΦ.symm (hΦ y') = y' := hΦ.symm_apply_apply y'
          rwa [Scheme.homeoOfIso_symm, Scheme.homeoOfIso_apply] at h2
        · rw [CategoryTheory.Category.assoc, hΦ_inv_snd, hRoof]
    · intro E' E_sch ιE' hE' hCl' hIntE hRange' ⟨isoP1, hisoP1⟩
      let E : Set ↥(CategoryTheory.Limits.pullback g s₀) := hΦ '' E'
      let ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s₀ := ιE' ≫ Φ.hom
      have hE : E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀) :=
        hIrredHomeo hΦ hE'
      have hCl : AlgebraicGeometry.IsClosedImmersion ιE := inferInstance
      have hRange : Set.range ιE.base = E := by
        change Set.range (Φ.hom.base ∘ ιE'.base) = hΦ '' E'
        rw [Set.range_comp, hRange']
        rfl
      have hisoP1₀ : ιE ≫ CategoryTheory.Limits.pullback.snd g s₀ =
          isoP1.hom ≫ (weilProjectiveSpaceOver K 1).hom := by
        rw [CategoryTheory.Category.assoc, hΦ_snd, hisoP1]
      obtain ⟨q₁, q₂, q₃, h12, h13, h23, hq₁E, hq₂E, hq₃E, hSpec⟩ :=
        hP1 E E_sch ιE hE hCl hIntE hRange ⟨isoP1, hisoP1₀⟩
      have hmem_symm : ∀ {q : ↥(CategoryTheory.Limits.pullback g s₀)},
          q ∈ E → hΦ.symm q ∈ E' := by
        rintro q ⟨x, hx, rfl⟩
        simpa using hx
      refine ⟨hΦ.symm q₁, hΦ.symm q₂, hΦ.symm q₃,
        fun h => h12 (hΦ.symm.injective h),
        fun h => h13 (hΦ.symm.injective h),
        fun h => h23 (hΦ.symm.injective h),
        hmem_symm hq₁E, hmem_symm hq₂E, hmem_symm hq₃E, ?_⟩
      intro q' hq'
      have hq_in : hΦ q' ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s₀)) := by
        rcases hq' with rfl | rfl | rfl <;> simp
      rcases hSpec (hΦ q') hq_in with ⟨E₁, hE₁, hE₁_ne, hqE₁⟩ | ⟨j, hj⟩
      · refine Or.inl ⟨hΦ.symm '' E₁, hIrredHomeo hΦ.symm hE₁, ?_,
          ⟨hΦ q', hqE₁, hΦ.symm_apply_apply q'⟩⟩
        intro h_eq
        apply hE₁_ne
        calc
          E₁ = hΦ '' (hΦ.symm '' E₁) := by
            ext z
            simp
          _ = hΦ '' E' := by rw [h_eq]
          _ = E := rfl
      · refine Or.inr ⟨j, ?_⟩
        rw [hSecRange j]
        change p_C.base ((CategoryTheory.Limits.pullback.fst g' s).base q') ∈ Set.range (τ j).base
        have h_fst_eq : (CategoryTheory.Limits.pullback.fst g s₀).base (hΦ q') =
            p_C.base ((CategoryTheory.Limits.pullback.fst g' s).base q') := by
          simpa [hΦ, Scheme.homeoOfIso_apply] using congrArg (fun φ => φ.base q') hΦ_fst
        rwa [← h_fst_eq]
  refine ⟨?_, ?_, ?_⟩
  · intro S' u τ' hτ'
    exact hTransfer (CategoryTheory.IsPullback.of_hasPullback g u)
      (fun j => (hτ' j).2) (fun j => (hτ' j).1)
  · intro C' S' g' τ' e_C e_S hcomm hτ'
    have hsq : e_C.inv ≫ g = g' ≫ e_S.inv := by
      calc
        e_C.inv ≫ g = e_C.inv ≫ (g ≫ e_S.hom) ≫ e_S.inv := by
          rw [CategoryTheory.Category.assoc, e_S.hom_inv_id, CategoryTheory.Category.comp_id]
        _ = e_C.inv ≫ (e_C.hom ≫ g') ≫ e_S.inv := by rw [← hcomm]
        _ = g' ≫ e_S.inv := by
          rw [CategoryTheory.Category.assoc e_C.hom g',
            ← CategoryTheory.Category.assoc e_C.inv e_C.hom,
            e_C.inv_hom_id, CategoryTheory.Category.id_comp]
    have hSec' : ∀ j : Fin n, τ' j ≫ g' = 𝟙 S' := by
      intro j
      rw [hτ' j]
      calc
        (e_S.inv ≫ τ j ≫ e_C.hom) ≫ g'
            = e_S.inv ≫ τ j ≫ (e_C.hom ≫ g') := by simp only [CategoryTheory.Category.assoc]
        _ = e_S.inv ≫ (τ j ≫ g) ≫ e_S.hom := by
            rw [hcomm, ← CategoryTheory.Category.assoc (τ j) g]
        _ = 𝟙 S' := by
            rw [hSec j, CategoryTheory.Category.id_comp, e_S.inv_hom_id]
    have hτ_comm : ∀ j : Fin n, τ' j ≫ e_C.inv = e_S.inv ≫ τ j := by
      intro j
      rw [hτ' j, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        e_C.hom_inv_id, CategoryTheory.Category.comp_id]
    exact hTransfer (CategoryTheory.IsPullback.of_horiz_isIso ⟨hsq⟩) hSec' hτ_comm
  · intro S' u hDom
    have : AlgebraicGeometry.Flat g := hFlat
    have : AlgebraicGeometry.LocallyOfFinitePresentation g := hLFP
    have : AlgebraicGeometry.UniversallyOpen g := AlgebraicGeometry.UniversallyOpen.of_flat g
    rw [AlgebraicGeometry.isDominant_iff] at hDom ⊢
    change Dense (Set.range ⇑(CategoryTheory.Limits.pullback.fst g u))
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst g u]
    exact Dense.preimage hDom (AlgebraicGeometry.Scheme.Hom.isOpenMap g)

theorem weil_affine_normal_stable_curve_iso_extension (k : Type u) [Field k]
    (n : ℕ)
    (hBridge : HasLocalCurveIsoMatrixBridge k)
    (hDvrExt : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
      (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
      (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂)),
      IsGeometricStablePointedCurve g₁ n τ₁ →
      IsGeometricStablePointedCurve g₂ n τ₂ →
      let η_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g₁ η_K) →
      ∀ (φ_K : CategoryTheory.Limits.pullback g₁ η_K ≅ CategoryTheory.Limits.pullback g₂ η_K),
        φ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
          CategoryTheory.Limits.pullback.snd g₁ η_K →
        (∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
            CategoryTheory.Limits.pullback g₁ η_K),
          s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ η_K = η_K ≫ τ₁ j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ η_K =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
          (s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_K = η_K ≫ τ₂ j) →
        ∃ (φ : C₁ ≅ C₂),
          φ.hom ≫ g₂ = g₁ ∧
          (∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j) ∧
          CategoryTheory.Limits.pullback.fst g₁ η_K ≫ φ.hom =
            φ_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K)
    (hHartogs : ∀ (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
      [IsIntegrallyClosed B₀] (L : Type u) [Field L] [Algebra B₀ L] [IsFractionRing B₀ L]
      (r : ℕ) (M : Matrix.GeneralLinearGroup (Fin r) L),
      (∀ (p : PrimeSpectrum B₀),
        p.asIdeal ≠ ⊥ →
        IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) →
        ∀ i j : Fin r,
          (∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * M.val i j = algebraMap B₀ L a) ∧
          (∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * (M⁻¹).val i j = algebraMap B₀ L a)) →
      ∃ M₀ : Matrix.GeneralLinearGroup (Fin r) B₀,
        ∀ i j : Fin r, algebraMap B₀ L (M₀.val i j) = M.val i j)
    (hStabPull : ∀ (C S S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (u : S' ⟶ S) (τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g u)),
      IsGeometricStablePointedCurve g n τ →
      (∀ j : Fin n,
        τ' j ≫ CategoryTheory.Limits.pullback.fst g u = u ≫ τ j ∧
        τ' j ≫ CategoryTheory.Limits.pullback.snd g u = 𝟙 S') →
      IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g u) n τ')
    (hDomPull : ∀ (C S S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (u : S' ⟶ S),
      IsGeometricStablePointedCurve g n τ →
      AlgebraicGeometry.IsDominant u →
      AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g u))
    (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsIntegrallyClosed B₀]
    [Algebra k B₀] [Algebra.FiniteType k B₀]
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₂))
    (hStab₁ : IsGeometricStablePointedCurve g₁ n τ₁)
    (hStab₂ : IsGeometricStablePointedCurve g₂ n τ₂)
    (hInt₁ : AlgebraicGeometry.IsIntegral C₁)
    (hInt₂ : AlgebraicGeometry.IsIntegral C₂)
    (U₀ : (AlgebraicGeometry.Spec (CommRingCat.of B₀)).Opens)
    (hU₀ : Nonempty ↥U₀)
    (hSm₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (g₁ ∣_ U₀))
    (φ₀ : AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map g₁.base).obj U₀) ≅
        AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map g₂.base).obj U₀))
    (hφ₀_base :
      let V₁ : C₁.Opens := (TopologicalSpace.Opens.map g₁.base).obj U₀
      let V₂ : C₂.Opens := (TopologicalSpace.Opens.map g₂.base).obj U₀
      φ₀.hom ≫ V₂.ι ≫ g₂ = V₁.ι ≫ g₁)
    (hφ₀_sec :
      let V₁ : C₁.Opens := (TopologicalSpace.Opens.map g₁.base).obj U₀
      let V₂ : C₂.Opens := (TopologicalSpace.Opens.map g₂.base).obj U₀
      ∀ j : Fin n, ∀ (s₁ : U₀.toScheme ⟶ V₁.toScheme),
        s₁ ≫ V₁.ι = U₀.ι ≫ τ₁ j →
        (s₁ ≫ φ₀.hom) ≫ V₂.ι = U₀.ι ≫ τ₂ j) :
    let V₁ : C₁.Opens := (TopologicalSpace.Opens.map g₁.base).obj U₀
    let V₂ : C₂.Opens := (TopologicalSpace.Opens.map g₂.base).obj U₀
    ∃ (φ : C₁ ≅ C₂),
      φ.hom ≫ g₂ = g₁ ∧
      (∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j) ∧
      V₁.ι ≫ φ.hom = φ₀.hom ≫ V₂.ι :=
by
  intro V₁ V₂
  let S : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B₀)
  obtain ⟨L, instFieldL, instAlgB₀L, instFracB₀L⟩ :
      ∃ (L : Type u) (_ : Field L) (_ : Algebra B₀ L), IsFractionRing B₀ L :=
    ⟨FractionRing B₀, inferInstance, inferInstance, inferInstance⟩
  let : Field L := instFieldL
  let : Algebra B₀ L := instAlgB₀L
  have : IsFractionRing B₀ L := instFracB₀L
  let η_L : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ S :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))
  have hProp₁ : AlgebraicGeometry.IsProper g₁ := hStab₁.2.2.1
  have hProp₂ : AlgebraicGeometry.IsProper g₂ := hStab₂.2.2.1
  have hSec₁ : ∀ j : Fin n, τ₁ j ≫ g₁ = 𝟙 S := hStab₁.2.2.2.2.2.1
  have hSec₂ : ∀ j : Fin n, τ₂ j ≫ g₂ = 𝟙 S := hStab₂.2.2.2.2.2.1
  
  have hinj_B₀L : Function.Injective (algebraMap B₀ L) := IsFractionRing.injective B₀ L
  have h_η_bot : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)),
      (η_L pt).asIdeal = ⊥ := by
    intro pt
    have hpt : pt.asIdeal = ⊥ := @Ideal.eq_bot_of_prime L _ pt.asIdeal pt.2
    change Ideal.comap (algebraMap B₀ L) pt.asIdeal = ⊥
    rw [hpt]
    exact Ideal.comap_bot_of_injective (algebraMap B₀ L) hinj_B₀L
  have h_η_mem : ∀ (W : S.Opens), Nonempty ↥W →
      ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)), η_L pt ∈ W := by
    intro W ⟨⟨q₀, hq₀⟩⟩ pt
    obtain ⟨_, ⟨f, rfl⟩, hq₀_f, hf_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hq₀
    have hf_not_q₀ : f ∉ q₀.asIdeal := hq₀_f
    have hf_ne : f ≠ 0 := fun h => hf_not_q₀ (h ▸ q₀.asIdeal.zero_mem)
    apply hf_le
    change f ∉ (η_L pt).asIdeal
    rw [h_η_bot pt, Ideal.mem_bot]
    exact hf_ne
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := Classical.arbitrary _
  have hDom_U₀ : AlgebraicGeometry.IsDominant U₀.ι := by
    rw [AlgebraicGeometry.isDominant_iff]
    change Dense (Set.range ⇑U₀.ι)
    rw [AlgebraicGeometry.Scheme.Opens.range_ι, dense_iff_inter_open]
    intro O hO ⟨q₀, hq₀⟩
    exact ⟨η_L pt₀, h_η_mem ⟨O, hO⟩ ⟨⟨q₀, hq₀⟩⟩ pt₀, h_η_mem U₀ hU₀ pt₀⟩
  have hDom_ηL : AlgebraicGeometry.IsDominant η_L := by
    rw [AlgebraicGeometry.isDominant_iff]
    change Dense (Set.range ⇑η_L)
    rw [dense_iff_inter_open]
    intro O hO ⟨q₀, hq₀⟩
    exact ⟨η_L pt₀, h_η_mem ⟨O, hO⟩ ⟨⟨q₀, hq₀⟩⟩ pt₀, ⟨pt₀, rfl⟩⟩
  have hη_range : Set.range ⇑η_L ⊆ Set.range ⇑U₀.ι := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact h_η_mem U₀ hU₀ pt
  let η_U₀ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ U₀.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U₀.ι η_L hη_range
  have hη_U₀ : η_U₀ ≫ U₀.ι = η_L :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι η_L hη_range
  have sq_V₁ : CategoryTheory.IsPullback V₁.ι (g₁ ∣_ U₀) g₁ U₀.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict g₁ U₀).flip
  have sq_V₂ : CategoryTheory.IsPullback V₂.ι (g₂ ∣_ U₀) g₂ U₀.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict g₂ U₀).flip
  have hres₁ : (g₁ ∣_ U₀) ≫ U₀.ι = V₁.ι ≫ g₁ :=
    AlgebraicGeometry.morphismRestrict_ι g₁ U₀
  have hres₂ : (g₂ ∣_ U₀) ≫ U₀.ι = V₂.ι ≫ g₂ :=
    AlgebraicGeometry.morphismRestrict_ι g₂ U₀
  let ι₁_L : CategoryTheory.Limits.pullback g₁ η_L ⟶ V₁.toScheme :=
    sq_V₁.lift (CategoryTheory.Limits.pullback.fst g₁ η_L)
      (CategoryTheory.Limits.pullback.snd g₁ η_L ≫ η_U₀)
      (by rw [CategoryTheory.Category.assoc, hη_U₀, CategoryTheory.Limits.pullback.condition])
  have hι₁_fst : ι₁_L ≫ V₁.ι = CategoryTheory.Limits.pullback.fst g₁ η_L :=
    sq_V₁.lift_fst _ _ _
  have hι₁_snd : ι₁_L ≫ (g₁ ∣_ U₀) = CategoryTheory.Limits.pullback.snd g₁ η_L ≫ η_U₀ :=
    sq_V₁.lift_snd _ _ _
  let ι₂_L : CategoryTheory.Limits.pullback g₂ η_L ⟶ V₂.toScheme :=
    sq_V₂.lift (CategoryTheory.Limits.pullback.fst g₂ η_L)
      (CategoryTheory.Limits.pullback.snd g₂ η_L ≫ η_U₀)
      (by rw [CategoryTheory.Category.assoc, hη_U₀, CategoryTheory.Limits.pullback.condition])
  have hι₂_fst : ι₂_L ≫ V₂.ι = CategoryTheory.Limits.pullback.fst g₂ η_L :=
    sq_V₂.lift_fst _ _ _
  have hι₂_snd : ι₂_L ≫ (g₂ ∣_ U₀) = CategoryTheory.Limits.pullback.snd g₂ η_L ≫ η_U₀ :=
    sq_V₂.lift_snd _ _ _
  have sq₁ : CategoryTheory.IsPullback ι₁_L
      (CategoryTheory.Limits.pullback.snd g₁ η_L) (g₁ ∣_ U₀) η_U₀ := by
    refine CategoryTheory.IsPullback.of_right ?_ hι₁_snd sq_V₁
    rw [hι₁_fst, hη_U₀]
    exact CategoryTheory.IsPullback.of_hasPullback g₁ η_L
  have sq₂ : CategoryTheory.IsPullback ι₂_L
      (CategoryTheory.Limits.pullback.snd g₂ η_L) (g₂ ∣_ U₀) η_U₀ := by
    refine CategoryTheory.IsPullback.of_right ?_ hι₂_snd sq_V₂
    rw [hι₂_fst, hη_U₀]
    exact CategoryTheory.IsPullback.of_hasPullback g₂ η_L
  have hSmL : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g₁ η_L) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback sq₁ hSm₀
  have hφ₀_base' : φ₀.hom ≫ V₂.ι ≫ g₂ = V₁.ι ≫ g₁ := hφ₀_base
  have hφ₀_res : φ₀.hom ≫ (g₂ ∣_ U₀) = g₁ ∣_ U₀ := by
    apply (CategoryTheory.cancel_mono U₀.ι).mp
    rw [CategoryTheory.Category.assoc, hres₂, hφ₀_base', hres₁]
  have hφ₀_inv_res : φ₀.inv ≫ (g₁ ∣_ U₀) = g₂ ∣_ U₀ := by
    rw [← hφ₀_res, ← CategoryTheory.Category.assoc, φ₀.inv_hom_id,
      CategoryTheory.Category.id_comp]
  let hom_L : CategoryTheory.Limits.pullback g₁ η_L ⟶ CategoryTheory.Limits.pullback g₂ η_L :=
    sq₂.lift (ι₁_L ≫ φ₀.hom) (CategoryTheory.Limits.pullback.snd g₁ η_L)
      (by rw [CategoryTheory.Category.assoc, hφ₀_res, hι₁_snd])
  let inv_L : CategoryTheory.Limits.pullback g₂ η_L ⟶ CategoryTheory.Limits.pullback g₁ η_L :=
    sq₁.lift (ι₂_L ≫ φ₀.inv) (CategoryTheory.Limits.pullback.snd g₂ η_L)
      (by rw [CategoryTheory.Category.assoc, hφ₀_inv_res, hι₂_snd])
  have hhom_L_fst : hom_L ≫ ι₂_L = ι₁_L ≫ φ₀.hom := sq₂.lift_fst _ _ _
  have hhom_L_snd : hom_L ≫ CategoryTheory.Limits.pullback.snd g₂ η_L =
      CategoryTheory.Limits.pullback.snd g₁ η_L := sq₂.lift_snd _ _ _
  have hinv_L_fst : inv_L ≫ ι₁_L = ι₂_L ≫ φ₀.inv := sq₁.lift_fst _ _ _
  have hinv_L_snd : inv_L ≫ CategoryTheory.Limits.pullback.snd g₁ η_L =
      CategoryTheory.Limits.pullback.snd g₂ η_L := sq₁.lift_snd _ _ _
  let φ_L : CategoryTheory.Limits.pullback g₁ η_L ≅ CategoryTheory.Limits.pullback g₂ η_L :=
    { hom := hom_L
      inv := inv_L
      hom_inv_id := by
        apply sq₁.hom_ext
        · rw [CategoryTheory.Category.assoc, hinv_L_fst, ← CategoryTheory.Category.assoc,
            hhom_L_fst, CategoryTheory.Category.assoc, φ₀.hom_inv_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hinv_L_snd, hhom_L_snd,
            CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply sq₂.hom_ext
        · rw [CategoryTheory.Category.assoc, hhom_L_fst, ← CategoryTheory.Category.assoc,
            hinv_L_fst, CategoryTheory.Category.assoc, φ₀.inv_hom_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hhom_L_snd, hinv_L_snd,
            CategoryTheory.Category.id_comp] }
  have hφL_snd : φ_L.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_L =
      CategoryTheory.Limits.pullback.snd g₁ η_L := hhom_L_snd
  have hφL_ι₁ : φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L =
      ι₁_L ≫ φ₀.hom ≫ V₂.ι := by
    calc φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L
        = hom_L ≫ (ι₂_L ≫ V₂.ι) := by rw [← hι₂_fst]
      _ = (hom_L ≫ ι₂_L) ≫ V₂.ι := by rw [← CategoryTheory.Category.assoc]
      _ = ι₁_L ≫ φ₀.hom ≫ V₂.ι := by rw [hhom_L_fst, CategoryTheory.Category.assoc]
  let s₁_U₀ : ∀ j : Fin n, U₀.toScheme ⟶ V₁.toScheme := fun j =>
    sq_V₁.lift (U₀.ι ≫ τ₁ j) (𝟙 U₀.toScheme)
      (by rw [CategoryTheory.Category.assoc, hSec₁ j, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp])
  have hs₁_U₀ : ∀ j : Fin n, s₁_U₀ j ≫ V₁.ι = U₀.ι ≫ τ₁ j :=
    fun j => sq_V₁.lift_fst _ _ _
  have hφ₀_sec' : ∀ j : Fin n, ∀ (s₁ : U₀.toScheme ⟶ V₁.toScheme),
      s₁ ≫ V₁.ι = U₀.ι ≫ τ₁ j → (s₁ ≫ φ₀.hom) ≫ V₂.ι = U₀.ι ≫ τ₂ j := hφ₀_sec
  have hφL_sec : ∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
      CategoryTheory.Limits.pullback g₁ η_L),
      s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ η_L = η_L ≫ τ₁ j →
      s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ η_L =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) →
      (s₁ ≫ φ_L.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_L = η_L ≫ τ₂ j := by
    intro j s₁ hs₁_fst _hs₁_snd
    have hs₁_ι : s₁ ≫ ι₁_L = η_U₀ ≫ s₁_U₀ j := by
      apply (CategoryTheory.cancel_mono V₁.ι).mp
      rw [CategoryTheory.Category.assoc, hι₁_fst, hs₁_fst, ← hη_U₀,
        CategoryTheory.Category.assoc, ← hs₁_U₀ j, CategoryTheory.Category.assoc]
    calc (s₁ ≫ φ_L.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_L
        = s₁ ≫ (φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L) := by
            rw [CategoryTheory.Category.assoc]
      _ = (s₁ ≫ ι₁_L) ≫ φ₀.hom ≫ V₂.ι := by
            rw [hφL_ι₁, ← CategoryTheory.Category.assoc]
      _ = η_U₀ ≫ ((s₁_U₀ j ≫ φ₀.hom) ≫ V₂.ι) := by
            rw [hs₁_ι, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      _ = η_U₀ ≫ U₀.ι ≫ τ₂ j := by rw [hφ₀_sec' j (s₁_U₀ j) (hs₁_U₀ j)]
      _ = η_L ≫ τ₂ j := by rw [← CategoryTheory.Category.assoc, hη_U₀]
  
  have hLoc : ∀ (q : PrimeSpectrum B₀),
      ∃ (h₀ : B₀) (_ : h₀ ∉ q.asIdeal)
        (v_h : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h₀))),
        let u_h := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap B₀ (Localization.Away h₀)))
        v_h ≫ u_h = η_L ∧
        ∃ (φ_h : CategoryTheory.Limits.pullback g₁ u_h ≅
            CategoryTheory.Limits.pullback g₂ u_h),
          φ_h.hom ≫ CategoryTheory.Limits.pullback.snd g₂ u_h =
            CategoryTheory.Limits.pullback.snd g₁ u_h ∧
          (∀ (w₁ : CategoryTheory.Limits.pullback g₁ η_L ⟶
              CategoryTheory.Limits.pullback g₁ u_h),
            w₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u_h =
              CategoryTheory.Limits.pullback.fst g₁ η_L →
            w₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u_h =
              CategoryTheory.Limits.pullback.snd g₁ η_L ≫ v_h →
            (w₁ ≫ φ_h.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u_h =
              φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L) := by
    intro q
    obtain ⟨h₀, hh₀, r₀, M, hBridge_a, hBridge_b⟩ :=
      hBridge B₀ L n C₁ C₂ g₁ τ₁ g₂ τ₂ hStab₁ hStab₂ hSmL φ_L hφL_snd hφL_sec q
    let B_h : Type u := Localization.Away h₀
    let u_h := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ B_h))
    have hh₀_ne : h₀ ≠ 0 := fun h => hh₀ (h ▸ q.asIdeal.zero_mem)
    have h_pow_nzd : Submonoid.powers h₀ ≤ nonZeroDivisors B₀ :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hh₀_ne)
    have : IsDomain B_h := IsLocalization.isDomain_of_le_nonZeroDivisors B_h h_pow_nzd
    have : IsNoetherianRing B₀ := Algebra.FiniteType.isNoetherianRing k B₀
    have : IsNoetherianRing B_h :=
      IsLocalization.isNoetherianRing (Submonoid.powers h₀) B_h ‹IsNoetherianRing B₀›
    have : IsIntegrallyClosed B_h :=
      isIntegrallyClosed_of_isLocalization B_h (Submonoid.powers h₀) h_pow_nzd
    have hh₀_L_ne : algebraMap B₀ L h₀ ≠ 0 :=
      fun h => hh₀_ne (hinj_B₀L (h.trans (map_zero _).symm))
    have h_unit : IsUnit (algebraMap B₀ L h₀) := IsUnit.mk0 _ hh₀_L_ne
    obtain ⟨ψ_h, hψ_h_comp⟩ : ∃ ψ_h : B_h →+* L,
        ψ_h.comp (algebraMap B₀ B_h) = algebraMap B₀ L :=
      ⟨IsLocalization.Away.lift h₀ h_unit, by
        ext x
        exact IsLocalization.Away.lift_eq (S := Localization.Away h₀) h₀ h_unit x⟩
    let : Algebra B_h L := ψ_h.toAlgebra
    have : IsScalarTower B₀ B_h L := IsScalarTower.of_algebraMap_eq' hψ_h_comp.symm
    have : IsFractionRing B_h L :=
      IsFractionRing.isFractionRing_of_isLocalization (Submonoid.powers h₀) B_h L h_pow_nzd
    let v_h : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_h) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)
    have hv_h : v_h ≫ u_h = η_L := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ B_h)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_h_comp]
    have hinj_BhL : Function.Injective ψ_h := IsFractionRing.injective B_h L
    have hDVR_bounds : ∀ (p : PrimeSpectrum B_h),
        p.asIdeal ≠ ⊥ →
        IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) →
        ∀ i j : Fin (r₀ + 1),
          (∃ a b : B_h, b ∉ p.asIdeal ∧ algebraMap B_h L b * M.val i j = algebraMap B_h L a) ∧
          (∃ a b : B_h, b ∉ p.asIdeal ∧ algebraMap B_h L b * (M⁻¹).val i j = algebraMap B_h L a) := by
      intro p _hp_ne hDVR_p
      let R_p : Type u := Localization.AtPrime p.asIdeal
      have : IsDiscreteValuationRing R_p := hDVR_p
      have hp_nzd : p.asIdeal.primeCompl ≤ nonZeroDivisors B_h :=
        Ideal.primeCompl_le_nonZeroDivisors p.asIdeal
      have : IsDomain R_p := IsLocalization.isDomain_of_le_nonZeroDivisors R_p hp_nzd
      let : Algebra k R_p :=
        (((algebraMap B_h R_p).comp (algebraMap B₀ B_h)).comp (algebraMap k B₀)).toAlgebra
      have h_units_p : ∀ y : p.asIdeal.primeCompl, IsUnit (ψ_h (y : B_h)) := by
        intro y
        have hy_ne : (y : B_h) ≠ 0 := fun h => y.2 (h ▸ p.asIdeal.zero_mem)
        exact IsUnit.mk0 _ (fun h => hy_ne (hinj_BhL (h.trans (map_zero _).symm)))
      obtain ⟨ψ_p, hψ_p_comp⟩ : ∃ ψ_p : R_p →+* L,
          ψ_p.comp (algebraMap B_h R_p) = ψ_h :=
        ⟨IsLocalization.lift (M := p.asIdeal.primeCompl)
            (S := Localization.AtPrime p.asIdeal) h_units_p, by
          ext x
          exact IsLocalization.lift_eq (M := p.asIdeal.primeCompl)
            (S := Localization.AtPrime p.asIdeal) h_units_p x⟩
      let : Algebra R_p L := ψ_p.toAlgebra
      have : IsScalarTower B_h R_p L := IsScalarTower.of_algebraMap_eq' hψ_p_comp.symm
      have : IsFractionRing R_p L :=
        IsFractionRing.isFractionRing_of_isLocalization p.asIdeal.primeCompl R_p L hp_nzd
      let u_p := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R_p)) ≫ u_h
      let η_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_p L))
      have hη_K_up : η_K ≫ u_p = η_L := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_p) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R_p)) ≫ u_h) = η_L
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hψ_p_comp]
        exact hv_h
      let C₁_p := CategoryTheory.Limits.pullback g₁ u_p
      let g₁_p := CategoryTheory.Limits.pullback.snd g₁ u_p
      let τ₁_p : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R_p) ⟶ C₁_p) := fun j =>
        CategoryTheory.Limits.pullback.lift (u_p ≫ τ₁ j)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_p)))
          (by rw [CategoryTheory.Category.assoc, hSec₁ j, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp])
      let C₂_p := CategoryTheory.Limits.pullback g₂ u_p
      let g₂_p := CategoryTheory.Limits.pullback.snd g₂ u_p
      let τ₂_p : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R_p) ⟶ C₂_p) := fun j =>
        CategoryTheory.Limits.pullback.lift (u_p ≫ τ₂ j)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_p)))
          (by rw [CategoryTheory.Category.assoc, hSec₂ j, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp])
      have hStab₁_p : IsGeometricStablePointedCurve g₁_p n τ₁_p :=
        hStabPull C₁ S _ g₁ τ₁ u_p τ₁_p hStab₁
          (fun j => ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
            CategoryTheory.Limits.pullback.lift_snd _ _ _⟩)
      have hStab₂_p : IsGeometricStablePointedCurve g₂_p n τ₂_p :=
        hStabPull C₂ S _ g₂ τ₂ u_p τ₂_p hStab₂
          (fun j => ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
            CategoryTheory.Limits.pullback.lift_snd _ _ _⟩)
      have sq₁_p : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst g₁_p η_K ≫
            CategoryTheory.Limits.pullback.fst g₁ u_p)
          (CategoryTheory.Limits.pullback.snd g₁_p η_K) g₁ η_L := by
        rw [← hη_K_up]
        exact (CategoryTheory.IsPullback.of_hasPullback g₁_p η_K).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback g₁ u_p)
      have sq₂_p : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst g₂_p η_K ≫
            CategoryTheory.Limits.pullback.fst g₂ u_p)
          (CategoryTheory.Limits.pullback.snd g₂_p η_K) g₂ η_L := by
        rw [← hη_K_up]
        exact (CategoryTheory.IsPullback.of_hasPullback g₂_p η_K).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback g₂ u_p)
      let e₁ := sq₁_p.isoPullback
      let e₂ := sq₂_p.isoPullback
      have hSm_p : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.Limits.pullback.snd g₁_p η_K) := by
        have sq_e₁ : CategoryTheory.IsPullback e₁.hom
            (CategoryTheory.Limits.pullback.snd g₁_p η_K)
            (CategoryTheory.Limits.pullback.snd g₁ η_L)
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L))) :=
          CategoryTheory.IsPullback.of_horiz_isIso
            ⟨by rw [CategoryTheory.Category.comp_id]; exact sq₁_p.isoPullback_hom_snd⟩
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback sq_e₁ hSmL
      let φ_K : CategoryTheory.Limits.pullback g₁_p η_K ≅
          CategoryTheory.Limits.pullback g₂_p η_K :=
        e₁ ≪≫ φ_L ≪≫ e₂.symm
      have hφK_snd : φ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂_p η_K =
          CategoryTheory.Limits.pullback.snd g₁_p η_K := by
        change (e₁.hom ≫ φ_L.hom ≫ e₂.inv) ≫ CategoryTheory.Limits.pullback.snd g₂_p η_K = _
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          sq₂_p.isoPullback_inv_snd, hφL_snd, sq₁_p.isoPullback_hom_snd]
      have hφK_sec : ∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
          CategoryTheory.Limits.pullback g₁_p η_K),
          s₁ ≫ CategoryTheory.Limits.pullback.fst g₁_p η_K = η_K ≫ τ₁_p j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g₁_p η_K =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) →
          (s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂_p η_K = η_K ≫ τ₂_p j := by
        intro j s₁ hs₁_fst hs₁_snd
        have hs₁'_fst : (s₁ ≫ e₁.hom) ≫ CategoryTheory.Limits.pullback.fst g₁ η_L =
            η_L ≫ τ₁ j := by
          rw [CategoryTheory.Category.assoc, sq₁_p.isoPullback_hom_fst,
            ← CategoryTheory.Category.assoc, hs₁_fst, CategoryTheory.Category.assoc]
          have hτ₁_fst : τ₁_p j ≫ CategoryTheory.Limits.pullback.fst g₁ u_p = u_p ≫ τ₁ j :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [hτ₁_fst, ← CategoryTheory.Category.assoc, hη_K_up]
        have hs₁'_snd : (s₁ ≫ e₁.hom) ≫ CategoryTheory.Limits.pullback.snd g₁ η_L =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) := by
          rw [CategoryTheory.Category.assoc, sq₁_p.isoPullback_hom_snd, hs₁_snd]
        have hsec_L := hφL_sec j (s₁ ≫ e₁.hom) hs₁'_fst hs₁'_snd
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc ((s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂_p η_K) ≫
                CategoryTheory.Limits.pullback.fst g₂ u_p
              = ((s₁ ≫ e₁.hom) ≫ φ_L.hom) ≫
                  (e₂.inv ≫ (CategoryTheory.Limits.pullback.fst g₂_p η_K ≫
                    CategoryTheory.Limits.pullback.fst g₂ u_p)) := by
                  simp only [φ_K, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
                    CategoryTheory.Category.assoc]
            _ = ((s₁ ≫ e₁.hom) ≫ φ_L.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_L := by
                  rw [sq₂_p.isoPullback_inv_fst]
            _ = η_L ≫ τ₂ j := hsec_L
            _ = (η_K ≫ τ₂_p j) ≫ CategoryTheory.Limits.pullback.fst g₂ u_p := by
                  have hτ₂_fst : τ₂_p j ≫ CategoryTheory.Limits.pullback.fst g₂ u_p =
                      u_p ≫ τ₂ j := CategoryTheory.Limits.pullback.lift_fst _ _ _
                  rw [CategoryTheory.Category.assoc, hτ₂_fst, ← CategoryTheory.Category.assoc,
                    hη_K_up]
        · calc ((s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂_p η_K) ≫ g₂_p
              = (s₁ ≫ φ_K.hom) ≫ (CategoryTheory.Limits.pullback.snd g₂_p η_K ≫ η_K) := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
            _ = s₁ ≫ (φ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂_p η_K) ≫ η_K := by
                  simp only [CategoryTheory.Category.assoc]
            _ = η_K := by
                  rw [hφK_snd, ← CategoryTheory.Category.assoc, hs₁_snd,
                    CategoryTheory.Category.id_comp]
            _ = (η_K ≫ τ₂_p j) ≫ g₂_p := by
                  have hτ₂_snd : τ₂_p j ≫ g₂_p = 𝟙 _ :=
                    CategoryTheory.Limits.pullback.lift_snd _ _ _
                  rw [CategoryTheory.Category.assoc, hτ₂_snd, CategoryTheory.Category.comp_id]
      obtain ⟨φ_p, hφp_base, hφp_sec, hφp_gen⟩ :=
        hDvrExt R_p L C₁_p C₂_p g₁_p τ₁_p g₂_p τ₂_p hStab₁_p hStab₂_p hSm_p φ_K hφK_snd hφK_sec
      refine hBridge_b ψ_h hψ_h_comp p ⟨φ_p, hφp_base, ?_, ?_⟩
      · intro j s₁ hs₁_fst hs₁_snd
        have hs₁_eq : s₁ = τ₁_p j := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact hs₁_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
          · exact hs₁_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        rw [hs₁_eq, hφp_sec j]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · intro v_p w₁ hv_p hw₁_fst hw₁_snd
        let f := AlgebraicGeometry.Spec.preimage v_p
        have hf_map : AlgebraicGeometry.Spec.map f = v_p :=
          AlgebraicGeometry.Spec.map_preimage v_p
        have hf_comp_B₀ :
            (f.hom.comp (algebraMap B_h R_p)).comp (algebraMap B₀ B_h) =
              ψ_h.comp (algebraMap B₀ B_h) := by
          have hmap_eq :
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((f.hom.comp (algebraMap B_h R_p)).comp (algebraMap B₀ B_h))) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L)) := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
            have hf_ofHom : CommRingCat.ofHom f.hom = f := rfl
            rw [hf_ofHom, hf_map, CategoryTheory.Category.assoc]
            exact hv_p
          have h_hom := AlgebraicGeometry.Spec.map_injective hmap_eq
          exact (congrArg CommRingCat.Hom.hom h_hom).trans hψ_h_comp.symm
        have hf_comp_Bh :
            f.hom.comp (algebraMap B_h R_p) = ψ_p.comp (algebraMap B_h R_p) :=
          (IsLocalization.ringHom_ext (Submonoid.powers h₀) hf_comp_B₀).trans hψ_p_comp.symm
        have hf_eq_ψp : f.hom = ψ_p :=
          IsLocalization.ringHom_ext p.asIdeal.primeCompl hf_comp_Bh
        have hv_p_eq : v_p = η_K := by
          rw [← hf_map]
          have hf_ofHom : f = CommRingCat.ofHom f.hom := rfl
          rw [hf_ofHom, hf_eq_ψp]
        have hw₁_eq : w₁ = e₁.inv ≫ CategoryTheory.Limits.pullback.fst g₁_p η_K := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [hw₁_fst, CategoryTheory.Category.assoc, sq₁_p.isoPullback_inv_fst]
          · rw [hw₁_snd, hv_p_eq]
            change _ = (e₁.inv ≫ CategoryTheory.Limits.pullback.fst g₁_p η_K) ≫ g₁_p
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              ← CategoryTheory.Category.assoc, sq₁_p.isoPullback_inv_snd]
        calc (w₁ ≫ φ_p.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ u_p
            = e₁.inv ≫ (CategoryTheory.Limits.pullback.fst g₁_p η_K ≫ φ_p.hom) ≫
                CategoryTheory.Limits.pullback.fst g₂ u_p := by
                simp only [hw₁_eq, CategoryTheory.Category.assoc]
          _ = e₁.inv ≫ (φ_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂_p η_K) ≫
                CategoryTheory.Limits.pullback.fst g₂ u_p := by
                rw [hφp_gen]
          _ = (e₁.inv ≫ e₁.hom) ≫ φ_L.hom ≫
                (e₂.inv ≫ (CategoryTheory.Limits.pullback.fst g₂_p η_K ≫
                  CategoryTheory.Limits.pullback.fst g₂ u_p)) := by
                simp only [φ_K, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
                  CategoryTheory.Category.assoc]
          _ = φ_L.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_L := by
                rw [e₁.inv_hom_id, CategoryTheory.Category.id_comp, sq₂_p.isoPullback_inv_fst]
    obtain ⟨M₀, hM₀⟩ := hHartogs B_h L (r₀ + 1) M hDVR_bounds
    obtain ⟨φ_h, hφh_snd, _hφh_sec, hφh_gen⟩ := hBridge_a ψ_h hψ_h_comp ⟨M₀, hM₀⟩
    exact ⟨h₀, hh₀, v_h, hv_h, φ_h, hφh_snd, hφh_gen⟩
  
  choose h₀ hh₀ v_h hv_h φ_h hφh_snd hφh_gen using hLoc
  let u_h : ∀ q : PrimeSpectrum B₀,
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h₀ q))) ⟶ S :=
    fun q => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap B₀ (Localization.Away (h₀ q))))
  let w₁ : ∀ q : PrimeSpectrum B₀,
      CategoryTheory.Limits.pullback g₁ η_L ⟶ CategoryTheory.Limits.pullback g₁ (u_h q) :=
    fun q => CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst g₁ η_L)
      (CategoryTheory.Limits.pullback.snd g₁ η_L ≫ v_h q)
      (by rw [CategoryTheory.Category.assoc, hv_h q, CategoryTheory.Limits.pullback.condition])
  let w₂ : ∀ q : PrimeSpectrum B₀,
      CategoryTheory.Limits.pullback g₂ η_L ⟶ CategoryTheory.Limits.pullback g₂ (u_h q) :=
    fun q => CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst g₂ η_L)
      (CategoryTheory.Limits.pullback.snd g₂ η_L ≫ v_h q)
      (by rw [CategoryTheory.Category.assoc, hv_h q, CategoryTheory.Limits.pullback.condition])
  have hw₁_fst : ∀ q, w₁ q ≫ CategoryTheory.Limits.pullback.fst g₁ (u_h q) =
      CategoryTheory.Limits.pullback.fst g₁ η_L :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hw₁_snd : ∀ q, w₁ q ≫ CategoryTheory.Limits.pullback.snd g₁ (u_h q) =
      CategoryTheory.Limits.pullback.snd g₁ η_L ≫ v_h q :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hw₂_fst : ∀ q, w₂ q ≫ CategoryTheory.Limits.pullback.fst g₂ (u_h q) =
      CategoryTheory.Limits.pullback.fst g₂ η_L :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hw₂_snd : ∀ q, w₂ q ≫ CategoryTheory.Limits.pullback.snd g₂ (u_h q) =
      CategoryTheory.Limits.pullback.snd g₂ η_L ≫ v_h q :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hw₁_φh : ∀ q, w₁ q ≫ (φ_h q).hom = φ_L.hom ≫ w₂ q := by
    intro q
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hφh_gen q (w₁ q) (hw₁_fst q) (hw₁_snd q), CategoryTheory.Category.assoc, hw₂_fst q]
    · rw [CategoryTheory.Category.assoc, hφh_snd q, hw₁_snd q, CategoryTheory.Category.assoc,
