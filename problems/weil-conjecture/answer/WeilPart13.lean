    have hh_g0 : h ≫ g₂ = g_seq 0 := hh_g
    have hh_gen0 : CategoryTheory.Limits.pullback.fst (g_seq 0) η_K ≫ h =
        α_top.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K := hh_gen
    have hα_fst0 : CategoryTheory.Limits.pullback.fst (g_seq 0) η_K ≫ π_from 0 =
        (α_top.hom ≫ ψ_K.inv) ≫ CategoryTheory.Limits.pullback.fst g₁ η_K := hα_fst
    refine ⟨CategoryTheory.inv (π_from 0) ≫ h, ?_, ?_⟩
    · rw [CategoryTheory.Category.assoc, hh_g0, ← hπ0_g, CategoryTheory.IsIso.inv_hom_id_assoc]
    · have h1 : CategoryTheory.Limits.pullback.fst (g_seq 0) η_K =
          (α_top.hom ≫ ψ_K.inv) ≫ CategoryTheory.Limits.pullback.fst g₁ η_K ≫
