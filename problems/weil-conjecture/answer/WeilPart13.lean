    change f₁ r₀ = α₀ (algebraMap R₁ (MvPolynomial (Fin 2) R₁) r₀)
    rw [MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C]
  have : Algebra.FinitePresentation R₁ A₁ := RingHom.finitePresentation_algebraMap.mp hFP₁
  have : Algebra.FinitePresentation (MvPolynomial (Fin 2) R₁) A₁ :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R₁ (MvPolynomial (Fin 2) R₁) A₁
  obtain ⟨r, Phi_alg, hPhi_surj, _⟩ :=
    Algebra.FinitePresentation.out (R := MvPolynomial (Fin 2) R₁) (A := A₁)
  have hPhi_P₂ : ∀ p : MvPolynomial (Fin 2) R₁, Phi_alg.toRingHom (MvPolynomial.C p) = α₀ p := by
    intro p
    change Phi_alg (MvPolynomial.C p) = algebraMap (MvPolynomial (Fin 2) R₁) A₁ p
    rw [← MvPolynomial.algebraMap_eq]
    exact Phi_alg.commutes p
  have hPhi_C : ∀ r₀ : R₁, Phi_alg.toRingHom (MvPolynomial.C (MvPolynomial.C r₀)) = f₁ r₀ := by
    intro r₀
    rw [hPhi_P₂]
    exact MvPolynomial.aeval_C ![u₁, v₁] r₀
  have hPhi_X0 : Phi_alg.toRingHom (MvPolynomial.C (MvPolynomial.X 0)) = u₁ := by
    rw [hPhi_P₂]
    exact MvPolynomial.aeval_X ![u₁, v₁] 0
  have hPhi_X1 : Phi_alg.toRingHom (MvPolynomial.C (MvPolynomial.X 1)) = v₁ := by
    rw [hPhi_P₂]
    exact MvPolynomial.aeval_X ![u₁, v₁] 1
  obtain ⟨G, hG_ker, hG_det⟩ := h_jac_rels
    (MvPolynomial (Fin 2) R₁) MvPolynomial.C (MvPolynomial.X 0) (MvPolynomial.X 1)
    r Phi_alg.toRingHom hPhi_surj hPhi_C hPhi_X0 hPhi_X1
  exact h_etale_of_jac (MvPolynomial (Fin 2) R₁) r Phi_alg hPhi_surj G hG_ker hG_det

theorem weil_etale_over_std_nodal_plane_curve_cotangent_exact (K D_K : Type u) [Field K] [CommRing D_K] [Algebra K D_K]
    (ψ₂ : (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D_K)
    (hψ₂ : ψ₂.Etale)
    (hAlg : ψ₂.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp
      MvPolynomial.C) = algebraMap K D_K) :
    Subsingleton (Algebra.H1Cotangent K D_K) ∧
    ∃ (i_rel : D_K →ₗ[D_K] (Fin 2 → D_K))
      (p_rel : (Fin 2 → D_K) →ₗ[D_K] KaehlerDifferential K D_K),
      Function.Injective i_rel ∧
      Function.Surjective p_rel ∧
      Function.Exact i_rel p_rel :=
by
  have hH1_tower : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T]
      [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T] [Module.Flat S T],
      Subsingleton (Algebra.H1Cotangent R S) →
      Subsingleton (Algebra.H1Cotangent S T) →
      Subsingleton (Algebra.H1Cotangent R T) := by
    intro R S T _ _ _ _ _ _ _ _ hRS hST
    let P := Algebra.Generators.self R S
    let Q := Algebra.Generators.self S T
    have : Algebra.FormallySmooth R P.toExtension.Ring :=
      (inferInstance : Algebra.FormallySmooth R P.Ring)
    have : Algebra.FormallySmooth S Q.toExtension.Ring :=
      (inferInstance : Algebra.FormallySmooth S Q.Ring)
    have : Algebra.FormallySmooth R (Q.comp P).toExtension.Ring :=
      (inferInstance : Algebra.FormallySmooth R (Q.comp P).Ring)
    have hd₁ : Function.Injective P.toExtension.cotangentComplex :=
      P.toExtension.cotangentComplex_injective_iff.mpr hRS
    have hd₃ : Function.Injective Q.toExtension.cotangentComplex :=
      Q.toExtension.cotangentComplex_injective_iff.mpr hST
    rw [← (Q.comp P).toExtension.cotangentComplex_injective_iff, ← LinearMap.ker_eq_bot, eq_bot_iff]
    intro x hx
    rw [LinearMap.mem_ker] at hx
    let f_to := (Q.toComp P).toExtensionHom
    let f_of := (Q.ofComp P).toExtensionHom
    have hmap_of : Algebra.Extension.Cotangent.map f_of x = 0 := by
      apply hd₃
      rw [← Algebra.Extension.CotangentSpace.map_cotangentComplex f_of x, hx, map_zero, map_zero]
    obtain ⟨y, hy⟩ := (Algebra.Generators.Cotangent.exact Q P x).mp hmap_of
    have hcomm := LinearMap.congr_fun
      (Algebra.Generators.H1Cotangent.map_comp_cotangentComplex_baseChange Q P) y
    simp only [LinearMap.comp_apply] at hcomm
    have hbc_y_eq : LinearMap.liftBaseChange T (Algebra.Extension.CotangentSpace.map f_to)
        (LinearMap.baseChange T P.toExtension.cotangentComplex y) = 0 := by
      have h1 : (Q.comp P).toExtension.cotangentComplex x = 0 := hx
      rw [← hy] at h1
      rw [hcomm]
      exact h1
    have hbc_y : LinearMap.baseChange T P.toExtension.cotangentComplex y = 0 := by
      apply Algebra.Generators.CotangentSpace.map_toComp_injective Q P
      rw [hbc_y_eq, map_zero]
    have hbc_inj : Function.Injective (LinearMap.baseChange T P.toExtension.cotangentComplex) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_preserves_injective_linearMap P.toExtension.cotangentComplex hd₁
    have hy0 : y = 0 := hbc_inj (by rw [hbc_y, map_zero])
    rw [Submodule.mem_bot, ← hy, hy0, map_zero]
  have hExact_bc : ∀ (S T : Type u) [CommRing S] [CommRing T]
      [Algebra K S] [Algebra S T] [Algebra K T] [IsScalarTower K S T]
      [Module.Flat S T] [Algebra.FormallyEtale S T]
      (μ_S : S →ₗ[S] (Fin 2 → S))
      (ν_S : (Fin 2 → S) →ₗ[S] KaehlerDifferential K S),
      Function.Injective μ_S →
      Function.Surjective ν_S →
      Function.Exact μ_S ν_S →
      ∃ (i_T : T →ₗ[T] (Fin 2 → T))
        (p_T : (Fin 2 → T) →ₗ[T] KaehlerDifferential K T),
        Function.Injective i_T ∧
        Function.Surjective p_T ∧
        Function.Exact i_T p_T := by
    intro S T _ _ _ _ _ _ _ _ μ_S ν_S hμ_inj hν_surj h_ex
    obtain ⟨hSubΩ, hSubH1⟩ := (Algebra.formallyEtale_iff S T).mp inferInstance
    have hmbc_inj : Function.Injective (KaehlerDifferential.mapBaseChange K S T) := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro z hz
      rw [LinearMap.mem_ker] at hz
      obtain ⟨w, rfl⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange K S T z).mp hz
      rw [hSubH1.elim w 0, map_zero]
      exact Submodule.zero_mem _
    have hmbc_surj : Function.Surjective (KaehlerDifferential.mapBaseChange K S T) := by
      intro ω
      exact (KaehlerDifferential.exact_mapBaseChange_map K S T ω).mp (hSubΩ.elim _ 0)
    have hμT_inj : Function.Injective (LinearMap.baseChange T μ_S) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_preserves_injective_linearMap μ_S hμ_inj
    have hνT_surj : Function.Surjective (LinearMap.baseChange T ν_S) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective T hν_surj
    have hexT : Function.Exact (LinearMap.baseChange T μ_S) (LinearMap.baseChange T ν_S) := by
      rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_exact T h_ex
    let e_left : TensorProduct S T S ≃ₗ[T] T :=
      TensorProduct.AlgebraTensorModule.rid S T T
    let e_mid : TensorProduct S T (Fin 2 → S) ≃ₗ[T] (Fin 2 → T) :=
      TensorProduct.piScalarRight S T T (Fin 2)
    let i_T : T →ₗ[T] (Fin 2 → T) :=
      e_mid.toLinearMap.comp ((LinearMap.baseChange T μ_S).comp e_left.symm.toLinearMap)
    let p_T : (Fin 2 → T) →ₗ[T] KaehlerDifferential K T :=
      (KaehlerDifferential.mapBaseChange K S T).comp
        ((LinearMap.baseChange T ν_S).comp e_mid.symm.toLinearMap)
    have hi_inj : Function.Injective i_T :=
      e_mid.injective.comp (hμT_inj.comp e_left.symm.injective)
    have hp_surj : Function.Surjective p_T :=
      hmbc_surj.comp (hνT_surj.comp e_mid.symm.surjective)
    have hex_T : Function.Exact i_T p_T := by
      intro v
      change p_T v = 0 ↔ ∃ t, i_T t = v
      constructor
      · intro hv
        have hν0 : LinearMap.baseChange T ν_S (e_mid.symm v) = 0 := by
          apply hmbc_inj
          rw [map_zero]
          exact hv
        obtain ⟨u, hu⟩ := (hexT (e_mid.symm v)).mp hν0
        refine ⟨e_left u, ?_⟩
        dsimp [i_T]
        rw [LinearEquiv.symm_apply_apply, hu, LinearEquiv.apply_symm_apply]
      · rintro ⟨t, rfl⟩
        dsimp [p_T, i_T]
        rw [LinearEquiv.symm_apply_apply, (hexT _).mpr ⟨e_left.symm t, rfl⟩, map_zero]
    exact ⟨i_T, p_T, hi_inj, hp_surj, hex_T⟩
  let P₂ := MvPolynomial (Fin 2) K
  let X₀ : P₂ := MvPolynomial.X 0
  let X₁ : P₂ := MvPolynomial.X 1
  let f₀ : P₂ := X₀ * X₁
  let I₀ : Ideal P₂ := Ideal.span {f₀}
  let N_K := P₂ ⧸ I₀
  let _ : Algebra N_K D_K := ψ₂.toAlgebra
  have hAlg_eq : algebraMap K D_K = (algebraMap N_K D_K).comp (algebraMap K N_K) := by
    rw [IsScalarTower.algebraMap_eq K P₂ N_K, Ideal.Quotient.algebraMap_eq,
      MvPolynomial.algebraMap_eq]
    exact hAlg.symm
  have _ : IsScalarTower K N_K D_K := IsScalarTower.of_algebraMap_eq' hAlg_eq
  have _ : Algebra.Etale N_K D_K := by
    rw [← RingHom.etale_algebraMap]
    exact hψ₂
  have hX₀ : X₀ ≠ 0 := MvPolynomial.X_ne_zero 0
  have hX₁ : X₁ ≠ 0 := MvPolynomial.X_ne_zero 1
  let π₀ : P₂ →ₐ[K] P₂ := MvPolynomial.aeval ![X₀, 0]
  have hπ₀_X₀ : π₀ X₀ = X₀ :=
    (MvPolynomial.aeval_X ![X₀, 0] 0).trans (Matrix.cons_val_zero _ _)
  have hπ₀_X₁ : π₀ X₁ = 0 :=
    (MvPolynomial.aeval_X ![X₀, 0] 1).trans (Matrix.cons_val_one _ _)
  have hdvd_sub : ∀ q : P₂, X₁ ∣ q - π₀ q := by
    intro q
    refine MvPolynomial.induction_on (motive := fun q => X₁ ∣ q - π₀ q) q ?_ ?_ ?_
    · intro a
      have hCa : π₀ (MvPolynomial.C a) = MvPolynomial.C a := MvPolynomial.aeval_C ![X₀, 0] a
      rw [hCa, sub_self]
      exact dvd_zero X₁
    · intro q₁ q₂ ih₁ ih₂
      have hadd : (q₁ + q₂) - π₀ (q₁ + q₂) = (q₁ - π₀ q₁) + (q₂ - π₀ q₂) := by
        rw [map_add]; ring
      rw [hadd]
      exact dvd_add ih₁ ih₂
    · intro q n ih
      fin_cases n
      · change X₁ ∣ q * X₀ - π₀ (q * X₀)
        rw [map_mul, hπ₀_X₀, ← sub_mul]
        exact dvd_mul_of_dvd_left ih X₀
      · change X₁ ∣ q * X₁ - π₀ (q * X₁)
        rw [map_mul, hπ₀_X₁, mul_zero, sub_zero, mul_comm]
        exact dvd_mul_right X₁ q
  have hdvd_f₀ : ∀ p : P₂, f₀ ∣ p * X₁ → f₀ ∣ p * X₀ → f₀ ∣ p := by
    intro p ⟨g₀, hg₀⟩ ⟨g₁, hg₁⟩
    have hp_eq : p = X₀ * g₀ := by
      apply mul_right_cancel₀ hX₁
      calc p * X₁ = f₀ * g₀ := hg₀
        _ = (X₀ * g₀) * X₁ := by dsimp [f₀]; ring
    have hg₀_eq : g₀ * X₀ = X₁ * g₁ := by
      apply mul_right_cancel₀ hX₀
      calc (g₀ * X₀) * X₀ = p * X₀ := by rw [hp_eq]; ring
        _ = f₀ * g₁ := hg₁
        _ = (X₁ * g₁) * X₀ := by dsimp [f₀]; ring
    have hπ_g₀ : π₀ g₀ = 0 := by
      have hmul0 : π₀ g₀ * X₀ = 0 := by
        calc π₀ g₀ * X₀ = π₀ g₀ * π₀ X₀ := by rw [hπ₀_X₀]
          _ = π₀ (g₀ * X₀) := (map_mul π₀ g₀ X₀).symm
          _ = π₀ (X₁ * g₁) := by rw [hg₀_eq]
          _ = π₀ X₁ * π₀ g₁ := map_mul π₀ X₁ g₁
          _ = 0 := by rw [hπ₀_X₁, zero_mul]
      exact (mul_eq_zero.mp hmul0).resolve_right hX₀
    obtain ⟨h, hh⟩ : X₁ ∣ g₀ := by
      have hd := hdvd_sub g₀
      rwa [hπ_g₀, sub_zero] at hd
    refine ⟨h, ?_⟩
    rw [hp_eq, hh]
    dsimp [f₀]
    ring
  let b : Module.Basis (Fin 2) P₂ (KaehlerDifferential K P₂) :=
    KaehlerDifferential.mvPolynomialBasis K (Fin 2)
  let b_N : Module.Basis (Fin 2) N_K (TensorProduct P₂ N_K (KaehlerDifferential K P₂)) :=
    b.baseChange N_K
  let e_fun : TensorProduct P₂ N_K (KaehlerDifferential K P₂) ≃ₗ[N_K] (Fin 2 → N_K) :=
    b_N.equivFun
  let v₀ : Fin 2 → N_K := e_fun (1 ⊗ₜ[P₂] KaehlerDifferential.D K P₂ f₀)
  have h_tmul_smul_alg : ∀ (q : P₂) (ω : KaehlerDifferential K P₂),
      (1 : N_K) ⊗ₜ[P₂] (q • ω) = (algebraMap P₂ N_K q) • ((1 : N_K) ⊗ₜ[P₂] ω) := by
    intro q ω
    rw [← TensorProduct.smul_tmul, ← IsScalarTower.algebraMap_smul N_K q (1 : N_K),
      ← TensorProduct.smul_tmul']
  have hdf₀ : (1 : N_K) ⊗ₜ[P₂] KaehlerDifferential.D K P₂ f₀ =
      (algebraMap P₂ N_K X₁) • b_N 0 + (algebraMap P₂ N_K X₀) • b_N 1 := by
    dsimp [f₀]
    rw [(KaehlerDifferential.D K P₂).leibniz X₀ X₁, TensorProduct.tmul_add,
      h_tmul_smul_alg X₀, h_tmul_smul_alg X₁]
    have hb0 : (1 : N_K) ⊗ₜ[P₂] KaehlerDifferential.D K P₂ X₀ = b_N 0 := by
      rw [← KaehlerDifferential.mvPolynomialBasis_apply K (Fin 2) 0]
      exact (b.baseChange_apply N_K 0).symm
    have hb1 : (1 : N_K) ⊗ₜ[P₂] KaehlerDifferential.D K P₂ X₁ = b_N 1 := by
      rw [← KaehlerDifferential.mvPolynomialBasis_apply K (Fin 2) 1]
      exact (b.baseChange_apply N_K 1).symm
    rw [hb1, hb0, add_comm]
  have hv₀_0 : v₀ 0 = algebraMap P₂ N_K X₁ := by
    dsimp [v₀, e_fun]
    rw [hdf₀, map_add, map_smul, map_smul, b_N.repr_self, b_N.repr_self]
    simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
      Finsupp.single_eq_same, smul_eq_mul, mul_one,
      show (Finsupp.single (1 : Fin 2) (1 : N_K)) 0 = 0 from
        Finsupp.single_eq_of_ne (by decide),
      mul_zero, add_zero]
  have hv₀_1 : v₀ 1 = algebraMap P₂ N_K X₀ := by
    dsimp [v₀, e_fun]
    rw [hdf₀, map_add, map_smul, map_smul, b_N.repr_self, b_N.repr_self]
    simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
      Finsupp.single_eq_same, smul_eq_mul, mul_one,
      show (Finsupp.single (0 : Fin 2) (1 : N_K)) 1 = 0 from
        Finsupp.single_eq_of_ne (by decide),
      mul_zero, zero_add]
  let μ_N : N_K →ₗ[N_K] (Fin 2 → N_K) := LinearMap.toSpanSingleton N_K (Fin 2 → N_K) v₀
  let ν_N : (Fin 2 → N_K) →ₗ[N_K] KaehlerDifferential K N_K :=
    (KaehlerDifferential.mapBaseChange K P₂ N_K).comp e_fun.symm.toLinearMap
  have hmk_surj : Function.Surjective (algebraMap P₂ N_K) := by
    rw [Ideal.Quotient.algebraMap_eq]
    exact Ideal.Quotient.mk_surjective
  have hμ_inj : Function.Injective μ_N := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro y hy
    rw [LinearMap.mem_ker] at hy
    obtain ⟨p, rfl⟩ := hmk_surj y
    have hp0 : f₀ ∣ p * X₁ := by
      have h0 := congrFun hy 0
      simp only [μ_N, LinearMap.toSpanSingleton_apply, Pi.smul_apply, smul_eq_mul,
        hv₀_0, ← map_mul, Pi.zero_apply] at h0
      rw [Ideal.Quotient.algebraMap_eq I₀, Ideal.Quotient.eq_zero_iff_mem] at h0
      exact Ideal.mem_span_singleton.mp h0
    have hp1 : f₀ ∣ p * X₀ := by
      have h1 := congrFun hy 1
      simp only [μ_N, LinearMap.toSpanSingleton_apply, Pi.smul_apply, smul_eq_mul,
        hv₀_1, ← map_mul, Pi.zero_apply] at h1
      rw [Ideal.Quotient.algebraMap_eq I₀, Ideal.Quotient.eq_zero_iff_mem] at h1
      exact Ideal.mem_span_singleton.mp h1
    have hpf : p ∈ I₀ := Ideal.mem_span_singleton.mpr (hdvd_f₀ p hp0 hp1)
    rw [Submodule.mem_bot, Ideal.Quotient.algebraMap_eq]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hpf
  let J₀ : Ideal P₂ := RingHom.ker (algebraMap P₂ N_K)
  have hJ₀_eq : J₀ = I₀ := by
    dsimp [J₀]
    rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker]
  have hf₀_J₀ : f₀ ∈ J₀ := by
    rw [hJ₀_eq]
    exact Ideal.subset_span rfl
  let σ₀ : P₂ → J₀.Cotangent := fun p =>
    J₀.toCotangent ⟨p * f₀, Ideal.mul_mem_left J₀ p hf₀_J₀⟩
  have hσ₀_surj : Function.Surjective σ₀ := by
    intro z
    obtain ⟨⟨h, hh⟩, rfl⟩ := Ideal.toCotangent_surjective J₀ z
    have hh' : h ∈ I₀ := hJ₀_eq ▸ hh
    obtain ⟨p, hp⟩ := Ideal.mem_span_singleton.mp hh'
    refine ⟨p, ?_⟩
    dsimp [σ₀]
    congr 1
    ext
    dsimp
    rw [hp, mul_comm]
  let δ₀ := KaehlerDifferential.kerCotangentToTensor K P₂ N_K
  have hδ₀_σ₀ : ∀ p : P₂, e_fun (δ₀ (σ₀ p)) = μ_N (algebraMap P₂ N_K p) := by
    intro p
    have hδ : δ₀ (σ₀ p) = (algebraMap P₂ N_K p) • ((1 : N_K) ⊗ₜ[P₂] KaehlerDifferential.D K P₂ f₀) := by
      dsimp [δ₀, σ₀]
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
      dsimp
      rw [(KaehlerDifferential.D K P₂).leibniz p f₀, TensorProduct.tmul_add,
        h_tmul_smul_alg p, h_tmul_smul_alg f₀]
      have hf₀_zero : algebraMap P₂ N_K f₀ = 0 := RingHom.mem_ker.mp hf₀_J₀
      rw [hf₀_zero, TensorProduct.smul_tmul' (0 : N_K), smul_eq_mul, zero_mul,
        TensorProduct.zero_tmul, add_zero]
    rw [hδ, map_smul]
    rfl
  have hδ₀_inj : Function.Injective δ₀ := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro z hz
    rw [LinearMap.mem_ker] at hz
    obtain ⟨p, rfl⟩ := hσ₀_surj z
    have hμ0 : μ_N (algebraMap P₂ N_K p) = 0 := by
      rw [← hδ₀_σ₀ p, hz, map_zero]
    have hp_zero : algebraMap P₂ N_K p = 0 := hμ_inj (by rw [hμ0, map_zero])
    have hp_J₀ : p ∈ J₀ := RingHom.mem_ker.mpr hp_zero
    rw [Submodule.mem_bot]
    dsimp [σ₀]
    rw [← LinearMap.mem_ker, Ideal.mem_toCotangent_ker, sq]
    exact Ideal.mul_mem_mul hp_J₀ hf₀_J₀
  have hH1_N : Subsingleton (Algebra.H1Cotangent K N_K) :=
    (Algebra.FormallySmooth.kerCotangentToTensor_injective_iff hmk_surj).mp hδ₀_inj
  have hν_surj : Function.Surjective ν_N :=
    (KaehlerDifferential.mapBaseChange_surjective K P₂ N_K hmk_surj).comp e_fun.symm.surjective
  have hex_N : Function.Exact μ_N ν_N := by
    intro w
    change ν_N w = 0 ↔ ∃ y, μ_N y = w
    constructor
    · intro hw
      have hmbc0 : KaehlerDifferential.mapBaseChange K P₂ N_K (e_fun.symm w) = 0 := hw
      obtain ⟨z, hz⟩ :=
        (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange K P₂ N_K hmk_surj
          (e_fun.symm w)).mp hmbc0
      obtain ⟨p, rfl⟩ := hσ₀_surj z
      refine ⟨algebraMap P₂ N_K p, ?_⟩
      rw [← hδ₀_σ₀ p, hz, LinearEquiv.apply_symm_apply]
    · rintro ⟨y, rfl⟩
      obtain ⟨p, rfl⟩ := hmk_surj y
      have hsymm : e_fun.symm (μ_N (algebraMap P₂ N_K p)) = δ₀ (σ₀ p) := by
        rw [← hδ₀_σ₀ p, LinearEquiv.symm_apply_apply]
      change KaehlerDifferential.mapBaseChange K P₂ N_K (e_fun.symm (μ_N (algebraMap P₂ N_K p))) = 0
      rw [hsymm]
      exact (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange K P₂ N_K hmk_surj
        (δ₀ (σ₀ p))).mpr ⟨σ₀ p, rfl⟩
  obtain ⟨_, hH1_ND⟩ := (Algebra.formallyEtale_iff N_K D_K).mp inferInstance
  exact ⟨hH1_tower K N_K D_K hH1_N hH1_ND,
    hExact_bc N_K D_K μ_N ν_N hμ_inj hν_surj hex_N⟩

theorem weil_flat_etale_ambient_principal_at_prime_of_nodal_cotangent (R₁ A₁ B₀ : Type u) [CommRing R₁] [CommRing A₁] [CommRing B₀] [Algebra R₁ A₁]
    (hFlat₁ : (algebraMap R₁ A₁).Flat)
    (q₁ : PrimeSpectrum A₁)
    (s_A : A₁)
    (hs_A : s_A ∉ q₁.asIdeal)
    (q'₁ : PrimeSpectrum (Localization.Away s_A))
    (hq'₁ : PrimeSpectrum.comap (algebraMap A₁ (Localization.Away s_A)) q'₁ = q₁)
    (φ₀ : MvPolynomial (Fin 2) R₁ →+* B₀)
    (hEt₀ : φ₀.Etale)
    (π₀ : B₀ →+* Localization.Away s_A)
    (hSurj₀ : Function.Surjective π₀)
    (hKerFG : (RingHom.ker π₀).FG)
    (hComm₀ : π₀.comp (φ₀.comp MvPolynomial.C) =
      (algebraMap A₁ (Localization.Away s_A)).comp (algebraMap R₁ A₁))
    (Q₀ : PrimeSpectrum B₀)
    (hQ₀ : PrimeSpectrum.comap π₀ q'₁ = Q₀)
    (K D_K : Type u) [Field K] [CommRing D_K] [Algebra R₁ K] [Algebra K D_K]
    (m₀ : PrimeSpectrum D_K)
    (ψ₁ : TensorProduct R₁ A₁ K →+* D_K)
    (hψ₁ : ψ₁.Etale)
    (hm₀ : PrimeSpectrum.comap (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom) m₀ = q₁)
    (hAlgK : ψ₁.comp Algebra.TensorProduct.includeRight.toRingHom = algebraMap K D_K)
    (hH1 : Subsingleton (Algebra.H1Cotangent K D_K))
    (hSeq : ∃ (i_rel : D_K →ₗ[D_K] (Fin 2 → D_K))
      (p_rel : (Fin 2 → D_K) →ₗ[D_K] KaehlerDifferential K D_K),
      Function.Injective i_rel ∧
      Function.Surjective p_rel ∧
      Function.Exact i_rel p_rel) :
    ∃ (s₁ g₀ : B₀),
      s₁ ∉ Q₀.asIdeal ∧
      g₀ ∈ RingHom.ker π₀ ∧
      ∀ j ∈ RingHom.ker π₀, ∃ b : B₀, s₁ * j = b * g₀ :=
by
  let fin2Prod : ∀ (R : Type u) [CommRing R], (Fin 2 → R) ≃ₗ[R] R × R := fun R _ =>
    { toFun := fun f => (f 0, f 1)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      invFun := fun p i => if i = 0 then p.1 else p.2
      left_inv := fun f => by ext i; fin_cases i <;> rfl
      right_inv := fun p => by ext <;> rfl }
  let fin2Tensor : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S],
      TensorProduct R S (Fin 2 → R) ≃ₗ[S] (Fin 2 → S) := fun R S _ _ _ =>
    (LinearEquiv.baseChange R S (Fin 2 → R) (R × R) (fin2Prod R)).trans <|
      (TensorProduct.prodRight R S S R R).trans <|
        (LinearEquiv.prodCongr
          (TensorProduct.AlgebraTensorModule.rid R S S)
          (TensorProduct.AlgebraTensorModule.rid R S S)).trans
          (fin2Prod S).symm
  
  have hStep1 :
      ∃ (D'_K : Type u) (_ : CommRing D'_K) (_ : Algebra K D'_K)
        (m'₀ : PrimeSpectrum D'_K)
        (ψ'₁ : TensorProduct R₁ K (Localization.Away s_A) →ₐ[K] D'_K),
        ψ'₁.toRingHom.Etale ∧
        PrimeSpectrum.comap
          (ψ'₁.toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := R₁) (A := K)
              (B := Localization.Away s_A)).toRingHom) m'₀ = q'₁ ∧
        Subsingleton (Algebra.H1Cotangent K D'_K) ∧
        (∃ (i'_rel : D'_K →ₗ[D'_K] (Fin 2 → D'_K))
          (p'_rel : (Fin 2 → D'_K) →ₗ[D'_K] KaehlerDifferential K D'_K),
          Function.Injective i'_rel ∧ Function.Surjective p'_rel ∧ Function.Exact i'_rel p'_rel) := by
    let A'₁ : Type u := Localization.Away s_A
    let A_K : Type u := TensorProduct R₁ A₁ K
    let A'_K : Type u := TensorProduct R₁ K A'₁
    let s_D : D_K := ψ₁ (Algebra.TensorProduct.includeLeftRingHom s_A)
    have hm₀_as : m₀.asIdeal.comap (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom) = q₁.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hm₀
    have hs_D : s_D ∉ m₀.asIdeal := by
      intro hmem
      apply hs_A
      rw [← hm₀_as]
      exact hmem
    let D'_K : Type u := Localization.Away s_D
    have hm₀_mem : m₀ ∈ Set.range (PrimeSpectrum.comap (algebraMap D_K D'_K)) := by
      rw [PrimeSpectrum.localization_comap_range D'_K (Submonoid.powers s_D)]
      rw [Set.mem_ofPred_eq, Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hs_D (m₀.isPrime.mem_of_pow_mem n hx)
    obtain ⟨m'₀, hm'₀⟩ := hm₀_mem
    have hm'₀_as : m'₀.asIdeal.comap (algebraMap D_K D'_K) = m₀.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hm'₀
    let g_A : A₁ →+* D'_K :=
      (algebraMap D_K D'_K).comp (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom)
    have hg_A_unit : IsUnit (g_A s_A) := IsLocalization.Away.algebraMap_isUnit s_D
    let α_A' : A'₁ →+* D'_K := IsLocalization.Away.lift (S := A'₁) s_A hg_A_unit
    have hα_A'_eq : ∀ a : A₁, α_A' (algebraMap A₁ A'₁ a) = g_A a :=
      IsLocalization.Away.lift_eq (S := A'₁) s_A hg_A_unit
    let algR₁D' : Algebra R₁ D'_K := ((algebraMap K D'_K).comp (algebraMap R₁ K)).toAlgebra
    letI : Algebra R₁ D'_K := algR₁D'
    haveI : IsScalarTower R₁ K D'_K := IsScalarTower.mk (fun r c d' => by
      simp only [Algebra.smul_def]
      change algebraMap K D'_K (algebraMap R₁ K r * c) * d' =
        algebraMap K D'_K (algebraMap R₁ K r) * (algebraMap K D'_K c * d')
      rw [map_mul, mul_assoc])
    have hα_R₁ : ∀ r : R₁, α_A' (algebraMap R₁ A'₁ r) = algebraMap R₁ D'_K r := by
      intro r
      rw [IsScalarTower.algebraMap_apply R₁ A₁ A'₁ r, hα_A'_eq]
      change algebraMap D_K D'_K (ψ₁ (algebraMap R₁ A₁ r ⊗ₜ[R₁] (1 : K))) =
        algebraMap K D'_K (algebraMap R₁ K r)
      rw [IsScalarTower.algebraMap_apply K D_K D'_K (algebraMap R₁ K r)]
      congr 1
      have htmul : (algebraMap R₁ A₁ r) ⊗ₜ[R₁] (1 : K) = (1 : A₁) ⊗ₜ[R₁] (algebraMap R₁ K r) := by
        have hr1 : algebraMap R₁ A₁ r = r • (1 : A₁) := by rw [Algebra.smul_def, mul_one]
        have hr2 : algebraMap R₁ K r = r • (1 : K) := by rw [Algebra.smul_def, mul_one]
        rw [hr1, hr2, TensorProduct.smul_tmul]
      rw [htmul]
      exact RingHom.congr_fun hAlgK (algebraMap R₁ K r)
    let α_A'_alg : A'₁ →ₐ[R₁] D'_K := { toRingHom := α_A', commutes' := hα_R₁ }
    let ψ'₁_R₁ : A'_K →ₐ[R₁] D'_K :=
      Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R₁ K D'_K) α_A'_alg
    let ψ'₁ : A'_K →ₐ[K] D'_K :=
      { toRingHom := ψ'₁_R₁.toRingHom
        commutes' := fun c => by
          change ψ'₁_R₁ (c ⊗ₜ[R₁] (1 : A'₁)) = algebraMap K D'_K c
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
          rfl }
    have hψ'₁_tmul : ∀ (c : K) (y : A'₁), ψ'₁ (c ⊗ₜ[R₁] y) = algebraMap K D'_K c * α_A' y :=
      fun c y => Algebra.TensorProduct.productMap_apply_tmul
        (IsScalarTower.toAlgHom R₁ K D'_K) α_A'_alg c y
    have hcomap_q'₁ :
        PrimeSpectrum.comap
          (ψ'₁.toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := R₁) (A := K) (B := A'₁)).toRingHom) m'₀ = q'₁ := by
      apply PrimeSpectrum.localization_comap_injective A'₁ (Submonoid.powers s_A)
      rw [hq'₁]
      ext a
      simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, RingHom.comp_apply]
      change ψ'₁ ((1 : K) ⊗ₜ[R₁] algebraMap A₁ A'₁ a) ∈ m'₀.asIdeal ↔ a ∈ q₁.asIdeal
      rw [hψ'₁_tmul, map_one, one_mul, hα_A'_eq]
      change algebraMap D_K D'_K (ψ₁ (Algebra.TensorProduct.includeLeftRingHom a)) ∈ m'₀.asIdeal ↔
        a ∈ q₁.asIdeal
      rw [← Ideal.mem_comap, hm'₀_as, ← hm₀_as]
      rfl
    have hAbstractEtale :
        ∀ (R₀ S₀ D₀ D'₀ : Type u) [CommRing R₀] [CommRing S₀] [CommRing D₀] [CommRing D'₀]
          [Algebra D₀ D'₀] (s₀ : D₀) [IsLocalization.Away s₀ D'₀]
          (β : R₀ →+* S₀) (ψ : R₀ →+* D₀), ψ.Etale →
          ∀ (ψ' : S₀ →+* D'₀),
            (∀ z : R₀, ψ' (β z) = algebraMap D₀ D'₀ (ψ z)) →
            ∀ (r₀ : R₀), ψ r₀ = s₀ → IsUnit (β r₀) →
              (∀ x : S₀, ∃ (n : ℕ) (z : R₀), x * (β r₀) ^ n = β z) →
              ψ'.Etale := by
      clear * -
      intro R₀ S₀ D₀ D'₀ _ _ _ _ _ s₀ _ β ψ hψ ψ' hcomm r₀ hr₀_D hu_β hsurj_β
      letI : Algebra R₀ S₀ := β.toAlgebra
      letI : Algebra R₀ D₀ := ψ.toAlgebra
      letI : Algebra R₀ D'₀ := ((algebraMap D₀ D'₀).comp ψ).toAlgebra
      letI : Algebra S₀ D'₀ := ψ'.toAlgebra
      haveI : IsScalarTower R₀ D₀ D'₀ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : IsScalarTower R₀ S₀ D'₀ := IsScalarTower.of_algebraMap_eq (fun z => (hcomm z).symm)
      haveI : Algebra.Etale R₀ D₀ := by rwa [← RingHom.etale_algebraMap]
      let Φ : TensorProduct R₀ S₀ D₀ →ₐ[R₀] D'₀ :=
        Algebra.TensorProduct.productMap
          (IsScalarTower.toAlgHom R₀ S₀ D'₀) (IsScalarTower.toAlgHom R₀ D₀ D'₀)
      let incR : D₀ →+* TensorProduct R₀ S₀ D₀ :=
        (Algebra.TensorProduct.includeRight (R := R₀) (A := S₀) (B := D₀)).toRingHom
      have hincR_s₀ : incR s₀ = (β r₀) ⊗ₜ[R₀] (1 : D₀) := by
        rw [← hr₀_D]
        have hs1 : ψ r₀ = r₀ • (1 : D₀) := by change ψ r₀ = ψ r₀ * 1; exact (mul_one _).symm
        have hs2 : β r₀ = r₀ • (1 : S₀) := by change β r₀ = β r₀ * 1; exact (mul_one _).symm
        change (1 : S₀) ⊗ₜ[R₀] (ψ r₀) = (β r₀) ⊗ₜ[R₀] (1 : D₀)
        rw [hs1, hs2, TensorProduct.smul_tmul]
      have hu_TP : IsUnit (incR s₀) := by
        rw [hincR_s₀]
        exact hu_β.map (Algebra.TensorProduct.includeLeftRingHom (R := R₀) (A := S₀) (B := D₀))
      let Ψ : D'₀ →+* TensorProduct R₀ S₀ D₀ := IsLocalization.Away.lift (S := D'₀) s₀ hu_TP
      have hΨ_eq : ∀ d : D₀, Ψ (algebraMap D₀ D'₀ d) = (1 : S₀) ⊗ₜ[R₀] d :=
        IsLocalization.Away.lift_eq (S := D'₀) s₀ hu_TP
      have hΦΨ : Φ.toRingHom.comp Ψ = RingHom.id D'₀ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers s₀)
        ext d
        simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [hΨ_eq, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      have hΨΦ : ∀ w : TensorProduct R₀ S₀ D₀, Ψ (Φ w) = w := by
        let θ : TensorProduct R₀ S₀ D₀ →+* TensorProduct R₀ S₀ D₀ := Ψ.comp Φ.toRingHom
        change ∀ w, θ w = w
        have hθ_right : ∀ d : D₀, θ ((1 : S₀) ⊗ₜ[R₀] d) = (1 : S₀) ⊗ₜ[R₀] d := by
          intro d
          change Ψ (Φ (1 ⊗ₜ[R₀] d)) = _
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
          exact hΨ_eq d
        have hθ_β : ∀ z : R₀, θ ((β z) ⊗ₜ[R₀] (1 : D₀)) = (β z) ⊗ₜ[R₀] (1 : D₀) := by
          intro z
          have heq : (β z) ⊗ₜ[R₀] (1 : D₀) = (1 : S₀) ⊗ₜ[R₀] (ψ z) := by
            have hz1 : β z = z • (1 : S₀) := by change β z = β z * 1; exact (mul_one _).symm
            have hz2 : ψ z = z • (1 : D₀) := by change ψ z = ψ z * 1; exact (mul_one _).symm
            rw [hz1, hz2, TensorProduct.smul_tmul]
          rw [heq, hθ_right]
        have hθ_left : ∀ x : S₀, θ (x ⊗ₜ[R₀] (1 : D₀)) = x ⊗ₜ[R₀] (1 : D₀) := by
          intro x
          obtain ⟨n, z, hxz⟩ := hsurj_β x
          let u_tp : (TensorProduct R₀ S₀ D₀)ˣ := (hu_TP.pow n).unit
          apply u_tp.mul_left_inj.mp
          have hu_val : (u_tp : TensorProduct R₀ S₀ D₀) = ((β r₀) ^ n) ⊗ₜ[R₀] (1 : D₀) := by
            change (incR s₀) ^ n = _
            rw [hincR_s₀, ← Algebra.TensorProduct.includeLeftRingHom_apply, ← map_pow,
              Algebra.TensorProduct.includeLeftRingHom_apply]
          have hθ_u : θ (u_tp : TensorProduct R₀ S₀ D₀) = u_tp := by
            change θ ((incR s₀) ^ n) = (incR s₀) ^ n
            rw [map_pow, hincR_s₀, hθ_β]
          calc
            θ (x ⊗ₜ[R₀] (1 : D₀)) * u_tp
              = θ ((x ⊗ₜ[R₀] (1 : D₀)) * u_tp) := by rw [map_mul, hθ_u]
            _ = θ ((β z) ⊗ₜ[R₀] (1 : D₀)) := by
                congr 1
                rw [hu_val, Algebra.TensorProduct.tmul_mul_tmul, mul_one, hxz]
            _ = (β z) ⊗ₜ[R₀] (1 : D₀) := hθ_β z
            _ = (x ⊗ₜ[R₀] (1 : D₀)) * u_tp := by
                rw [hu_val, Algebra.TensorProduct.tmul_mul_tmul, mul_one, hxz]
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul x d =>
          have hxd : (x ⊗ₜ[R₀] d : TensorProduct R₀ S₀ D₀) =
              (x ⊗ₜ[R₀] (1 : D₀)) * ((1 : S₀) ⊗ₜ[R₀] d) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hxd, map_mul, hθ_left, hθ_right]
        | add w₁ w₂ ih₁ ih₂ =>
          rw [map_add, ih₁, ih₂]
      have hΦ_bij : Function.Bijective Φ.toRingHom :=
        ⟨Function.LeftInverse.injective hΨΦ,
          Function.RightInverse.surjective (fun x => RingHom.congr_fun hΦΨ x)⟩
      have hincL_et : (algebraMap S₀ (TensorProduct R₀ S₀ D₀)).Etale := by
        rw [RingHom.etale_algebraMap]
        infer_instance
      have hcomp_eq : ψ' = Φ.toRingHom.comp (algebraMap S₀ (TensorProduct R₀ S₀ D₀)) := by
        ext x
        change ψ' x = Φ (x ⊗ₜ[R₀] (1 : D₀))
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        rfl
      rw [hcomp_eq]
      exact RingHom.Etale.stableUnderComposition _ _ hincL_et (RingHom.Etale.of_bijective hΦ_bij)
    have hψ'₁_et : ψ'₁.toRingHom.Etale := by
      let β_K_alg : A_K →ₐ[R₁] A'_K :=
        (Algebra.TensorProduct.map (AlgHom.id R₁ K) (IsScalarTower.toAlgHom R₁ A₁ A'₁)).comp
          (Algebra.TensorProduct.comm R₁ A₁ K).toAlgHom
      let β_K : A_K →+* A'_K := β_K_alg.toRingHom
      have hβ_tmul : ∀ (a : A₁) (c : K), β_K (a ⊗ₜ[R₁] c) = c ⊗ₜ[R₁] algebraMap A₁ A'₁ a :=
        fun _ _ => rfl
      have hψ'₁_β : ∀ z : A_K, ψ'₁.toRingHom (β_K z) = algebraMap D_K D'_K (ψ₁ z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a c =>
          change ψ'₁ (β_K (a ⊗ₜ[R₁] c)) = algebraMap D_K D'_K (ψ₁ (a ⊗ₜ[R₁] c))
          rw [hβ_tmul, hψ'₁_tmul, hα_A'_eq]
          rw [IsScalarTower.algebraMap_apply K D_K D'_K c]
          change algebraMap D_K D'_K (algebraMap K D_K c) *
              algebraMap D_K D'_K (ψ₁ (a ⊗ₜ[R₁] (1 : K))) =
            algebraMap D_K D'_K (ψ₁ (a ⊗ₜ[R₁] c))
          rw [← map_mul, ← RingHom.congr_fun hAlgK c]
          congr 1
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.includeRight_apply, ← map_mul,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        | add x y ihx ihy =>
          rw [map_add β_K, map_add ψ'₁.toRingHom, ihx, ihy, map_add, map_add]
      let r₀ : A_K := s_A ⊗ₜ[R₁] (1 : K)
      have hu_sA : IsUnit (algebraMap A₁ A'₁ s_A) := IsLocalization.Away.algebraMap_isUnit s_A
      have hu_β : IsUnit (β_K r₀) := by
        rw [hβ_tmul]
        exact hu_sA.map (Algebra.TensorProduct.includeRight (R := R₁) (A := K) (B := A'₁)).toRingHom
      have hsurj_β : ∀ x : A'_K, ∃ (n : ℕ) (z : A_K), x * (β_K r₀) ^ n = β_K z := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => exact ⟨0, 0, by simp⟩
        | tmul c y =>
          obtain ⟨n, a, hya⟩ := IsLocalization.Away.surj s_A y
          refine ⟨n, a ⊗ₜ[R₁] c, ?_⟩
          have hpow : (β_K r₀) ^ n = (1 : K) ⊗ₜ[R₁] ((algebraMap A₁ A'₁ s_A) ^ n) := by
            rw [hβ_tmul]
            change ((Algebra.TensorProduct.includeRight (R := R₁) (A := K) (B := A'₁))
              (algebraMap A₁ A'₁ s_A)) ^ n = _
            rw [← map_pow]
            rfl
          rw [hpow, Algebra.TensorProduct.tmul_mul_tmul, mul_one, hya, hβ_tmul]
        | add x₁ x₂ ih₁ ih₂ =>
          obtain ⟨n₁, z₁, hx₁⟩ := ih₁
          obtain ⟨n₂, z₂, hx₂⟩ := ih₂
          refine ⟨n₁ + n₂, z₁ * r₀ ^ n₂ + z₂ * r₀ ^ n₁, ?_⟩
          calc
            (x₁ + x₂) * (β_K r₀) ^ (n₁ + n₂)
              = (x₁ * (β_K r₀) ^ n₁) * (β_K r₀) ^ n₂ +
                (x₂ * (β_K r₀) ^ n₂) * (β_K r₀) ^ n₁ := by
                rw [pow_add]
                ring
            _ = β_K z₁ * (β_K r₀) ^ n₂ + β_K z₂ * (β_K r₀) ^ n₁ := by rw [hx₁, hx₂]
            _ = β_K (z₁ * r₀ ^ n₂ + z₂ * r₀ ^ n₁) := by
                simp only [map_add, map_mul, map_pow]
      exact hAbstractEtale A_K A'_K D_K D'_K s_D β_K ψ₁ hψ₁ ψ'₁.toRingHom hψ'₁_β
        r₀ rfl hu_β hsurj_β
    have hH1' : Subsingleton (Algebra.H1Cotangent K D'_K) := by
      let eH1 := Algebra.tensorH1CotangentOfIsLocalization K D'_K (Submonoid.powers s_D)
      have hSubTP : Subsingleton (TensorProduct D_K D'_K (Algebra.H1Cotangent K D_K)) := by
        refine ⟨fun x y => ?_⟩
        suffices hzero : ∀ z : TensorProduct D_K D'_K (Algebra.H1Cotangent K D_K), z = 0 by
          rw [hzero x, hzero y]
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul d' h => rw [hH1.elim h 0, TensorProduct.tmul_zero]
        | add z₁ z₂ ih₁ ih₂ => rw [ih₁, ih₂, add_zero]
      exact eH1.symm.injective.subsingleton
    obtain ⟨i_rel, p_rel, hInj, hSurj, hEx⟩ := hSeq
    have hEtLocD : Algebra.Etale D_K D'_K := Algebra.Etale.of_isLocalizationAway s_D
    let i_bc : TensorProduct D_K D'_K D_K →ₗ[D'_K] TensorProduct D_K D'_K (Fin 2 → D_K) :=
      LinearMap.baseChange D'_K i_rel
    let p_bc : TensorProduct D_K D'_K (Fin 2 → D_K) →ₗ[D'_K]
        TensorProduct D_K D'_K (KaehlerDifferential K D_K) :=
      LinearMap.baseChange D'_K p_rel
    have hi_bc : Function.Injective i_bc :=
      Module.Flat.lTensor_preserves_injective_linearMap i_rel hInj
    have hp_bc : Function.Surjective p_bc := LinearMap.lTensor_surjective D'_K hSurj
    have hex_bc : Function.Exact i_bc p_bc := Module.Flat.lTensor_exact D'_K hEx
    let e1 : TensorProduct D_K D'_K D_K ≃ₗ[D'_K] D'_K :=
      TensorProduct.AlgebraTensorModule.rid D_K D'_K D'_K
    let e2 : TensorProduct D_K D'_K (Fin 2 → D_K) ≃ₗ[D'_K] (Fin 2 → D'_K) :=
      fin2Tensor D_K D'_K
    let e3 : TensorProduct D_K D'_K (KaehlerDifferential K D_K) ≃ₗ[D'_K]
        KaehlerDifferential K D'_K :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K D_K D'_K
    let i'_rel : D'_K →ₗ[D'_K] (Fin 2 → D'_K) :=
      e2.toLinearMap ∘ₗ i_bc ∘ₗ e1.symm.toLinearMap
    let p'_rel : (Fin 2 → D'_K) →ₗ[D'_K] KaehlerDifferential K D'_K :=
      e3.toLinearMap ∘ₗ p_bc ∘ₗ e2.symm.toLinearMap
    have hi' : Function.Injective i'_rel :=
      e2.injective.comp (hi_bc.comp e1.symm.injective)
    have hp' : Function.Surjective p'_rel :=
      e3.surjective.comp (hp_bc.comp e2.symm.surjective)
    have hex' : Function.Exact i'_rel p'_rel := by
      intro v
      constructor
      · intro hv
        change e3 (p_bc (e2.symm v)) = 0 at hv
        have hv0 : p_bc (e2.symm v) = 0 := e3.map_eq_zero_iff.mp hv
        obtain ⟨w, hw⟩ := (hex_bc (e2.symm v)).mp hv0
        refine ⟨e1 w, ?_⟩
        change e2 (i_bc (e1.symm (e1 w))) = v
        rw [e1.symm_apply_apply, hw, e2.apply_symm_apply]
      · rintro ⟨d, rfl⟩
        change e3 (p_bc (e2.symm (e2 (i_bc (e1.symm d))))) = 0
        rw [e2.symm_apply_apply]
        have h0 : p_bc (i_bc (e1.symm d)) = 0 := (hex_bc _).mpr ⟨e1.symm d, rfl⟩
        rw [h0, map_zero]
    exact ⟨D'_K, inferInstance, inferInstance, m'₀, ψ'₁, hψ'₁_et, hcomap_q'₁, hH1',
      ⟨i'_rel, p'_rel, hi', hp', hex'⟩⟩
  
  have hStep2 : ∀ (B_K A'_K D'_K : Type u) [CommRing B_K] [CommRing A'_K] [CommRing D'_K]
      (π_K : B_K →+* A'_K), Function.Surjective π_K →
      ∀ (ψ'₁ : A'_K →+* D'_K), ψ'₁.Etale →
      ∃ (B'_K : Type u) (_ : CommRing B'_K) (ι_B : B_K →+* B'_K) (π'_K : B'_K →+* D'_K),
        ι_B.Etale ∧
        Function.Surjective π'_K ∧
        π'_K.comp ι_B = ψ'₁.comp π_K ∧
        RingHom.ker π'_K = Ideal.map ι_B (RingHom.ker π_K) := by
    intro B_K A'_K D'_K _ _ _ π_K hSurj ψ'₁ hEt
    letI : Algebra B_K A'_K := π_K.toAlgebra
    letI : Algebra A'_K D'_K := ψ'₁.toAlgebra
    have hEtAlg : Algebra.Etale A'_K D'_K := by rwa [← RingHom.etale_algebraMap]
    have hSS0 : Algebra.IsStandardSmoothOfRelativeDimension 0 A'_K D'_K :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEtAlg
    obtain ⟨ι, σ, hFinσ, hFinι, P₀, hDim₀⟩ := hSS0.out
    have hle : Nat.card σ ≤ Nat.card ι := Nat.card_le_card_of_injective P₀.map P₀.map_inj
    have hsub : Nat.card ι - Nat.card σ = 0 := hDim₀
    have hcard_eq : Nat.card ι = Nat.card σ := by omega
    let n : ℕ := Nat.card σ
    let e_ι : Fin n ≃ ι := (finCongr hcard_eq.symm).trans (Finite.equivFin ι).symm
    let e_σ : Fin n ≃ σ := (Finite.equivFin σ).symm
    let P : Algebra.SubmersivePresentation A'_K D'_K (Fin n) (Fin n) := P₀.reindex e_ι e_σ
    have hPolySurj : Function.Surjective
        (MvPolynomial.map π_K : MvPolynomial (Fin n) B_K →+* MvPolynomial (Fin n) A'_K) :=
      MvPolynomial.map_surjective π_K hSurj
    choose H_tilde hH_tilde using fun j : Fin n => hPolySurj (P.relation j)
    let I_H : Ideal (MvPolynomial (Fin n) B_K) := Ideal.span (Set.range H_tilde)
    let Q_B : Type u := MvPolynomial (Fin n) B_K ⧸ I_H
    let P_pre : Algebra.PreSubmersivePresentation B_K Q_B (Fin n) (Fin n) :=
      Algebra.PreSubmersivePresentation.naive (v := H_tilde) P.map P.map_inj
    let Δ_bar : Q_B := P_pre.jacobian
    let B'_K : Type u := Localization.Away Δ_bar
    let ι_B : B_K →+* B'_K := algebraMap B_K B'_K
    let Q_loc : Algebra.PreSubmersivePresentation Q_B B'_K Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B'_K Δ_bar
    let P_comp : Algebra.PreSubmersivePresentation B_K B'_K (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
      Q_loc.comp P_pre
    have hu_Δ_B' : IsUnit (algebraMap Q_B B'_K Δ_bar) := IsLocalization.Away.algebraMap_isUnit Δ_bar
    have hP_comp_unit : IsUnit P_comp.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact hu_Δ_B'.mul hu_Δ_B'
    let P_sub : Algebra.SubmersivePresentation B_K B'_K (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
      { P_comp with jacobian_isUnit := hP_comp_unit }
    have hP_sub_dim : P_sub.dimension = 0 := Nat.sub_self _
    have hSS_B' : Algebra.IsStandardSmoothOfRelativeDimension 0 B_K B'_K :=
      P_sub.isStandardSmoothOfRelativeDimension hP_sub_dim
    have hι_B_et : ι_B.Etale := by
      rw [RingHom.etale_algebraMap]
      exact Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hSS_B'
    let α_P : MvPolynomial (Fin n) A'_K →+* D'_K := algebraMap P.Ring D'_K
    have hα_P_surj : Function.Surjective α_P := P.algebraMap_surjective
    let Φ_poly : MvPolynomial (Fin n) B_K →+* D'_K := α_P.comp (MvPolynomial.map π_K)
    have hI_H_ker : I_H ≤ RingHom.ker Φ_poly := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hH_tilde j]
      have hmem : P.relation j ∈ P.ker := by
        rw [← P.span_range_relation_eq_ker]
        exact Ideal.subset_span ⟨j, rfl⟩
      exact hmem
    let π_Q : Q_B →+* D'_K := Ideal.Quotient.lift I_H Φ_poly hI_H_ker
    have hπ_Q_surj : Function.Surjective π_Q := by
      intro d
      obtain ⟨F_A, rfl⟩ := hα_P_surj d
      obtain ⟨F_B, rfl⟩ := hPolySurj F_A
      exact ⟨Ideal.Quotient.mk I_H F_B, rfl⟩
    have hπ_Q_Δ : π_Q Δ_bar = P.jacobian := by
      change π_Q P_pre.jacobian = P.jacobian
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      change α_P ((MvPolynomial.map π_K) P_pre.jacobiMatrix.det) = α_P P.jacobiMatrix.det
      congr 1
      rw [RingHom.map_det]
      congr 1
      apply Matrix.ext
      intro i j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      change (MvPolynomial.map π_K) ((MvPolynomial.pderiv (P.map i)) (H_tilde j)) =
        (MvPolynomial.pderiv (P.map i)) (P.relation j)
      rw [← MvPolynomial.pderiv_map, hH_tilde j]
    have hu_πQ_Δ : IsUnit (π_Q Δ_bar) := by
      rw [hπ_Q_Δ]
      exact P.jacobian_isUnit
    let π'_K : B'_K →+* D'_K := IsLocalization.Away.lift (S := B'_K) Δ_bar hu_πQ_Δ
    have hπ'_K_eq : ∀ q : Q_B, π'_K (algebraMap Q_B B'_K q) = π_Q q :=
      IsLocalization.Away.lift_eq (S := B'_K) Δ_bar hu_πQ_Δ
    have hπ'_K_surj : Function.Surjective π'_K := by
      intro d
      obtain ⟨q, rfl⟩ := hπ_Q_surj d
      exact ⟨algebraMap Q_B B'_K q, hπ'_K_eq q⟩
    have hι_B_eq : ι_B = (algebraMap Q_B B'_K).comp (algebraMap B_K Q_B) :=
      IsScalarTower.algebraMap_eq B_K Q_B B'_K
    have hcomm : π'_K.comp ι_B = ψ'₁.comp π_K := by
      ext b
      rw [hι_B_eq]
      change π'_K (algebraMap Q_B B'_K (Ideal.Quotient.mk I_H (MvPolynomial.C b))) = ψ'₁ (π_K b)
      rw [hπ'_K_eq]
      change α_P ((MvPolynomial.map π_K) (MvPolynomial.C b)) = ψ'₁ (π_K b)
      rw [MvPolynomial.map_C]
      exact (P.algebraMap_apply (MvPolynomial.C (π_K b))).trans
        (MvPolynomial.aeval_C P.val (π_K b))
    have hker : RingHom.ker π'_K = Ideal.map ι_B (RingHom.ker π_K) := by
      apply le_antisymm
      · intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨k, q, hzq⟩ := IsLocalization.Away.surj Δ_bar z
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective q
        have hπQ_zero : π_Q (Ideal.Quotient.mk I_H F) = 0 := by
          rw [← hπ'_K_eq, ← hzq, map_mul, hz, zero_mul]
        have hmap_ker : MvPolynomial.map π_K F ∈ Ideal.map (MvPolynomial.map π_K) I_H := by
          have hin_Pker : MvPolynomial.map π_K F ∈ P.ker := hπQ_zero
          rw [← P.span_range_relation_eq_ker] at hin_Pker
          have hmap_IH : Ideal.map (MvPolynomial.map π_K) I_H =
              Ideal.span (Set.range P.relation) := by
            rw [Ideal.map_span, ← Set.range_comp]
            exact congrArg Ideal.span (congrArg Set.range (funext hH_tilde))
          rwa [hmap_IH]
        have hF_comap : F ∈ Ideal.comap (MvPolynomial.map π_K) (Ideal.map (MvPolynomial.map π_K) I_H) :=
          hmap_ker
        rw [Ideal.comap_map_of_surjective' (MvPolynomial.map π_K) hPolySurj I_H,
          MvPolynomial.ker_map π_K] at hF_comap
        obtain ⟨f₁, hf₁, f₂, hf₂, rfl⟩ := Submodule.mem_sup.mp hF_comap
        have hq_mem : Ideal.Quotient.mk I_H (f₁ + f₂) ∈
            Ideal.map (algebraMap B_K Q_B) (RingHom.ker π_K) := by
          rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hf₁, zero_add]
          have hcomp_C : (Ideal.Quotient.mk I_H).comp MvPolynomial.C = algebraMap B_K Q_B := rfl
          rw [← hcomp_C, ← Ideal.map_map]
          exact Ideal.mem_map_of_mem _ hf₂
        have hloc_mem : algebraMap Q_B B'_K (Ideal.Quotient.mk I_H (f₁ + f₂)) ∈
            Ideal.map ι_B (RingHom.ker π_K) := by
          rw [hι_B_eq, ← Ideal.map_map]
          exact Ideal.mem_map_of_mem _ hq_mem
        let u_Δk : B'_Kˣ := (hu_Δ_B'.pow k).unit
        have hz_eq : z = ↑(u_Δk⁻¹) * algebraMap Q_B B'_K (Ideal.Quotient.mk I_H (f₁ + f₂)) := by
          apply u_Δk.mul_right_inj.mp
          rw [← mul_assoc, Units.mul_inv, one_mul, mul_comm]
          exact hzq
        rw [hz_eq]
        exact Ideal.mul_mem_left _ _ hloc_mem
      · rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, hcomm, RingHom.comp_apply,
          RingHom.mem_ker.mp hb, map_zero]
    exact ⟨B'_K, inferInstance, ι_B, π'_K, hι_B_et, hπ'_K_surj, hcomm, hker⟩
  
  have hStep3 : ∀ (B'_K D'_K E : Type u) [CommRing B'_K] [CommRing D'_K] [Field E]
      [Algebra K B'_K] [Algebra K D'_K] [Algebra B'_K D'_K] [IsScalarTower K B'_K D'_K]
      [Algebra D'_K E] [Algebra B'_K E] [IsScalarTower B'_K D'_K E]
      (φ'_K : MvPolynomial (Fin 2) K →ₐ[K] B'_K), φ'_K.toRingHom.Etale →
      Function.Surjective (algebraMap B'_K D'_K) →
      Subsingleton (Algebra.H1Cotangent K D'_K) →
      (∃ (i'_rel : D'_K →ₗ[D'_K] (Fin 2 → D'_K))
        (p'_rel : (Fin 2 → D'_K) →ₗ[D'_K] KaehlerDifferential K D'_K),
        Function.Injective i'_rel ∧ Function.Surjective p'_rel ∧ Function.Exact i'_rel p'_rel) →
      Module.finrank E (TensorProduct B'_K E ↥(RingHom.ker (algebraMap B'_K D'_K))) = 1 := by
    intro B'_K D'_K E _ _ _ _ _ _ _ _ _ _ φ'_K hEt_φ' hSurj_π' hH1' hSeq'
    let P2K : Type u := MvPolynomial (Fin 2) K
    letI : Algebra P2K B'_K := φ'_K.toRingHom.toAlgebra
    haveI : IsScalarTower K P2K B'_K :=
      IsScalarTower.mk (fun c p b' => by
        change φ'_K (c • p) * b' = c • (φ'_K p * b')
        rw [Algebra.smul_def, Algebra.smul_def, map_mul, φ'_K.commutes, mul_assoc])
    haveI : Algebra.Etale P2K B'_K := by rwa [← RingHom.etale_algebraMap]
    haveI : Algebra.FormallySmooth K B'_K := Algebra.FormallySmooth.comp K P2K B'_K
    let b_P2 := KaehlerDifferential.mvPolynomialBasis K (Fin 2)
    let e_ΩP2 : KaehlerDifferential K P2K ≃ₗ[P2K] (Fin 2 → P2K) :=
      b_P2.repr.trans (Finsupp.linearEquivFunOnFinite P2K P2K (Fin 2))
    let e_ΩB' : KaehlerDifferential K B'_K ≃ₗ[B'_K] (Fin 2 → B'_K) :=
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K P2K B'_K).symm.trans <|
        (LinearEquiv.baseChange P2K B'_K _ _ e_ΩP2).trans (fin2Tensor P2K B'_K)
    let P_ext : Algebra.Extension K D'_K :=
      Algebra.Extension.mk B'_K (Function.surjInv hSurj_π') (Function.surjInv_eq hSurj_π')
    have hInj_cc : Function.Injective P_ext.cotangentComplex :=
      (Algebra.Extension.cotangentComplex_injective_iff P_ext).mpr hH1'
    have hSurj_tk : Function.Surjective P_ext.toKaehler :=
      Algebra.Extension.toKaehler_surjective
    have hEx_cc : Function.Exact P_ext.cotangentComplex P_ext.toKaehler :=
      Algebra.Extension.exact_cotangentComplex_toKaehler
    let e_space : P_ext.CotangentSpace ≃ₗ[D'_K] (Fin 2 → D'_K) :=
      (LinearEquiv.baseChange B'_K D'_K _ _ e_ΩB').trans (fin2Tensor B'_K D'_K)
    let i₂ : P_ext.Cotangent →ₗ[D'_K] (Fin 2 → D'_K) :=
      e_space.toLinearMap ∘ₗ P_ext.cotangentComplex
    let p₂ : (Fin 2 → D'_K) →ₗ[D'_K] KaehlerDifferential K D'_K :=
      P_ext.toKaehler ∘ₗ e_space.symm.toLinearMap
    have hi₂ : Function.Injective i₂ := e_space.injective.comp hInj_cc
    have hp₂ : Function.Surjective p₂ := hSurj_tk.comp e_space.symm.surjective
    have hex₂ : Function.Exact i₂ p₂ := by
      intro v
      constructor
      · intro hv
        change P_ext.toKaehler (e_space.symm v) = 0 at hv
        obtain ⟨c, hc⟩ := (hEx_cc (e_space.symm v)).mp hv
        refine ⟨c, ?_⟩
        change e_space (P_ext.cotangentComplex c) = v
        rw [hc, e_space.apply_symm_apply]
      · rintro ⟨c, rfl⟩
        change P_ext.toKaehler (e_space.symm (e_space (P_ext.cotangentComplex c))) = 0
        rw [e_space.symm_apply_apply]
        exact (hEx_cc _).mpr ⟨c, rfl⟩
    obtain ⟨i₁, p₁, hi₁, hp₁, hex₁⟩ := hSeq'
    have hSplit : ∀ {K_a K_b : Type u} [AddCommGroup K_a] [Module D'_K K_a]
        [AddCommGroup K_b] [Module D'_K K_b]
        (pa : (Fin 2 → D'_K) →ₗ[D'_K] KaehlerDifferential K D'_K)
        (ib : K_b →ₗ[D'_K] (Fin 2 → D'_K))
        (pb : (Fin 2 → D'_K) →ₗ[D'_K] KaehlerDifferential K D'_K),
        Function.Injective ib → Function.Surjective pb → Function.Exact ib pb →
        Nonempty ((K_b × (Fin 2 → D'_K)) ≃ₗ[D'_K]
          ↥(LinearMap.ker (pa.comp (LinearMap.fst D'_K (Fin 2 → D'_K) (Fin 2 → D'_K)) -
            pb.comp (LinearMap.snd D'_K (Fin 2 → D'_K) (Fin 2 → D'_K))))) := by
      intro K_a K_b _ _ _ _ pa ib pb hib hpb hexb
      let F2 := Fin 2 → D'_K
      let M := LinearMap.ker (pa.comp (LinearMap.fst D'_K F2 F2) -
        pb.comp (LinearMap.snd D'_K F2 F2))
      have hmem_M : ∀ u₁ u₂ : F2, (u₁, u₂) ∈ M ↔ pa u₁ = pb u₂ := by
        intro u₁ u₂
        rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.comp_apply,
          LinearMap.fst_apply, LinearMap.snd_apply, sub_eq_zero]
      let π₁ : ↥M →ₗ[D'_K] F2 := (LinearMap.fst D'_K F2 F2).comp M.subtype
      have hπ₁_range : LinearMap.range π₁ = ⊤ := by
        rw [eq_top_iff]
        intro u₁ _
        obtain ⟨u₂, hu₂⟩ := hpb (pa u₁)
        exact ⟨⟨(u₁, u₂), (hmem_M u₁ u₂).mpr hu₂.symm⟩, rfl⟩
      obtain ⟨sec, hsec⟩ := LinearMap.exists_rightInverse_of_surjective π₁ hπ₁_range
      have hsec_fst : ∀ u₁ : F2, (sec u₁).1.1 = u₁ := fun u₁ => LinearMap.congr_fun hsec u₁
      let jb : K_b →ₗ[D'_K] ↥M :=
        LinearMap.codRestrict M ((LinearMap.inr D'_K F2 F2).comp ib) (fun kb => by
          rw [hmem_M]
          simp only [LinearMap.comp_apply, LinearMap.inr_apply, map_zero]
          exact ((hexb (ib kb)).mpr ⟨kb, rfl⟩).symm)
      let Φ : K_b × F2 →ₗ[D'_K] ↥M :=
        jb.comp (LinearMap.fst D'_K K_b F2) + sec.comp (LinearMap.snd D'_K K_b F2)
      refine ⟨LinearEquiv.ofBijective Φ ⟨?_, ?_⟩⟩
      · rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        rintro ⟨kb, u₁⟩ hker
        rw [LinearMap.mem_ker] at hker
        have hfst : π₁ (Φ (kb, u₁)) = 0 := by rw [hker, map_zero]
        have hπ₁_Φ : π₁ (Φ (kb, u₁)) = u₁ := by
          change (jb kb).1.1 + (sec u₁).1.1 = u₁
          rw [show (jb kb).1.1 = 0 from rfl, zero_add, hsec_fst]
        rw [hπ₁_Φ] at hfst
        subst hfst
        have hjb_zero : jb kb = 0 := by simpa [Φ] using hker
        have hib_zero : ib kb = 0 := congrArg (fun m : ↥M => m.1.2) hjb_zero
        exact Prod.ext (hib (hib_zero.trans ib.map_zero.symm)) rfl
      · intro m
        let u₁ : F2 := m.1.1
        let m₀' : ↥M := m - sec u₁
        have hm₀_fst : m₀'.1.1 = 0 := by
          change m.1.1 - (sec u₁).1.1 = 0
          rw [hsec_fst, sub_self]
        have hm₀_mem : pa m₀'.1.1 = pb m₀'.1.2 := (hmem_M m₀'.1.1 m₀'.1.2).mp m₀'.2
        rw [hm₀_fst, map_zero] at hm₀_mem
        obtain ⟨kb, hkb⟩ := (hexb m₀'.1.2).mp hm₀_mem.symm
        refine ⟨(kb, u₁), ?_⟩
        have hjb_eq : jb kb = m₀' := Subtype.ext (Prod.ext hm₀_fst.symm hkb)
        change jb kb + sec u₁ = m
        rw [hjb_eq, sub_add_cancel]
    obtain ⟨split1⟩ := hSplit (K_a := D'_K) p₁ i₂ p₂ hi₂ hp₂ hex₂
    obtain ⟨split2⟩ := hSplit (K_a := P_ext.Cotangent) p₂ i₁ p₁ hi₁ hp₁ hex₁
    let M₁ := LinearMap.ker (p₁.comp (LinearMap.fst D'_K (Fin 2 → D'_K) (Fin 2 → D'_K)) -
      p₂.comp (LinearMap.snd D'_K (Fin 2 → D'_K) (Fin 2 → D'_K)))
    let M₂ := LinearMap.ker (p₂.comp (LinearMap.fst D'_K (Fin 2 → D'_K) (Fin 2 → D'_K)) -
      p₁.comp (LinearMap.snd D'_K (Fin 2 → D'_K) (Fin 2 → D'_K)))
    let e_swap : ↥M₁ ≃ₗ[D'_K] ↥M₂ :=
      { toFun := fun m => ⟨(m.1.2, m.1.1), by
          have hm := m.2
