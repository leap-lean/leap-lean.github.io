      have hd0 : d_raw (MvPolynomial.X 0) = Pi.single 0 1 := by
        ext j; fin_cases j <;>
          (change Ideal.Quotient.mk I_node (MvPolynomial.pderiv _ _) = _;
           rw [MvPolynomial.pderiv_X]; simp)
      have hd1 : d_raw (MvPolynomial.X 1) = Pi.single 1 1 := by
        ext j; fin_cases j <;>
          (change Ideal.Quotient.mk I_node (MvPolynomial.pderiv _ _) = _;
           rw [MvPolynomial.pderiv_X]; simp)
      have hβα : ∀ m : M_N, β_N (α_N m) = m := by
        intro m
        obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective S_N m
        change β_N (u 0 • dX₀ + u 1 • dX₁) = S_N.mkQ u
        dsimp only [dX₀, dX₁]
        rw [map_add, map_smul, map_smul, Derivation.liftKaehlerDifferential_comp_D,
          Derivation.liftKaehlerDifferential_comp_D]
        change u 0 • S_N.mkQ (d_raw (MvPolynomial.X 0)) +
          u 1 • S_N.mkQ (d_raw (MvPolynomial.X 1)) = S_N.mkQ u
        rw [← S_N.mkQ.map_smul, ← S_N.mkQ.map_smul, ← S_N.mkQ.map_add, hd0, hd1]
        congr 1
        ext i; fin_cases i <;> simp
      have hαβ : α_N.comp β_N = LinearMap.id := by
        refine Derivation.liftKaehlerDifferential_unique (α_N.comp β_N) LinearMap.id ?_
        ext z
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
        change α_N (β_N (KaehlerDifferential.D K N_K (Ideal.Quotient.mk I_node f))) =
          KaehlerDifferential.D K N_K (Ideal.Quotient.mk I_node f)
        induction f using MvPolynomial.induction_on with
        | C c =>
