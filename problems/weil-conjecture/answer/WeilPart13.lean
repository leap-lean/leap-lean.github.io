          refine ⟨x₂ + x₂', Ideal.add_mem _ hx₂ hx₂', ?_⟩
          have hrew : (w₁ + w₂) - ψ (x₂ + x₂') = (w₁ - ψ x₂) + (w₂ - ψ x₂') := by
            rw [map_add]; ring
          rw [hrew]
          exact Ideal.add_mem _ h₁ h₂
      intro q
      obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective q
      let a₀ : A := toA (ev_K d)
      have hy : d - ψ a₀ ∈ m₀.asIdeal := by
        rw [← hev_ker, RingHom.mem_ker, map_sub]
        have hK := RingHom.congr_fun hev_A (ev_K d)
        change ev_K (ψ (toA (ev_K d))) = ev_K d at hK
        rw [hK, sub_self]
      obtain ⟨x₁', _, h₁⟩ := hClaim2 (d - ψ a₀) hy
      obtain ⟨x₂', _, h₂⟩ := hClaim3 ((d - ψ a₀) - ψ x₁') h₁
      refine ⟨Ideal.Quotient.mk (m_A ^ 3) (a₀ + x₁' + x₂'), ?_⟩
      change Ideal.Quotient.mk (m₀.asIdeal ^ 3) (ψ (a₀ + x₁' + x₂')) =
        Ideal.Quotient.mk (m₀.asIdeal ^ 3) d
      refine Ideal.Quotient.eq.mpr ?_
