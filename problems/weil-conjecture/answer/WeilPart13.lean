      let W_seq' : Fin (k' + 1) → AlgebraicGeometry.Scheme.{u} := fun i => W_seq i.castSucc
      let g_seq' : ∀ i : Fin (k' + 1), W_seq' i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
        fun i => g_seq i.castSucc
      let τ_seq' : ∀ i : Fin (k' + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_seq' i) :=
        fun i => τ_seq i.castSucc
      let centers' : ∀ i : Fin k', ↥(CategoryTheory.Limits.pullback (g_seq' i.castSucc) s_Ω) :=
        fun i => centers i.castSucc
      let maps' : ∀ i : Fin k', W_seq' i.succ ⟶ W_seq' i.castSucc :=
        fun i => maps i.castSucc
      let π_from' : ∀ i : Fin (k' + 1), W_seq' i ⟶ C₁ :=
        fun i => π_from i.castSucc
      have hTower' : IsNC2DBlowupTower Ω n g₁ τ₁ k' W_seq' g_seq' τ_seq' centers' maps' π_from' :=
        ⟨hTower.1, hTower.2.1, hTower.2.2.1, hTower.2.2.2.1,
          fun i => hTower.2.2.2.2.1 i.castSucc,
          fun i => hTower.2.2.2.2.2 i.castSucc⟩
      have hMapG : maps i_prev ≫ g_seq i_prev.castSucc = g_seq (Fin.last (k' + 1)) :=
        hLast.2.2.1
      have : AlgebraicGeometry.Surjective (maps i_prev) :=
        hLast.2.2.2.2.2.1
      have : AlgebraicGeometry.IsIntegral (W_seq i_prev.castSucc) := hPrev.1
      have hh'_g : h' ≫ g₂ = g_seq' (Fin.last k') := by
        apply AlgebraicGeometry.ext_of_isDominant (maps i_prev)
        rw [← CategoryTheory.Category.assoc, hh', hh_g, hMapG]
      have hh'_sec : ∀ j : Fin n, τ_seq' (Fin.last k') j ≫ h' = τ₂ j := by
        intro j
        have hτ_map : τ_seq (Fin.last (k' + 1)) j ≫ maps i_prev = τ_seq i_prev.castSucc j :=
          hLast.2.2.2.1 j
