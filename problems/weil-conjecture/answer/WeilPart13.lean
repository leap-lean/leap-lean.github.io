    choose n_exp hn_exp using hStage2_entry
    let Idx2 := Fin (s'₀ + 1) × Fin (s'₀ + 1) × Fin (s'₀ + 1) × Fin (r₀ + 1) × Fin (r₀ + 1)
    let m₂ : ℕ := Finset.univ.sup (fun x : Idx2 => n_exp x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2)
    have hm₂_ge : ∀ (β γ α : Fin (s'₀ + 1)) (i j : Fin (r₀ + 1)),
