    h_open_iso X₃.left X_B.left pX₃.left rX₃.left hrX₃_left hIso_rX₃
      f_XB.left q_XB.left hcomm_XB hIsoXB pr₂.left hp₂_f hp₂_qX
  have hτ_tilde : ∀ j : Fin n, ∃ τ_tilde : B ⟶ T_B,
