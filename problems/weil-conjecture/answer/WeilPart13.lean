        dsimp only [𝔪₀]
        rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
        fin_cases i <;> exact hlin
      let I₀ : Ideal D := Ideal.map φ_L 𝔪₀
      let D_bar := D ⧸ I₀
      letI : Algebra L₀ D_bar := ((Ideal.Quotient.mk I₀).comp φ_L).toAlgebra
