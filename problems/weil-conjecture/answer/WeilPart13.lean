  have hcomm : q'.left ≫ p.left = f'.left ≫ π.left := by
    change (ι_Y' ≫ fst_P) ≫ p.left = (ι_Y' ≫ snd_P) ≫ π.left
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      CategoryTheory.Category.assoc]
  have hlift_eq : CategoryTheory.Limits.pullback.lift q'.left f'.left hcomm = ι_Y' := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    · exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hProjY' : IsProjectiveOverField k Y' := by
    let ι_Y'_over : Y' ⟶ P_over :=
      CategoryTheory.Over.homMk ι_Y' (CategoryTheory.Category.assoc ι_Y' snd_P S'.hom)
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (ι_Y'_over ≫ ι_P).left := by
      change AlgebraicGeometry.IsClosedImmersion (ι_Y' ≫ ι_P.left)
      infer_instance
    exact ⟨N_P, ι_Y'_over ≫ ι_P, hCl_comp⟩

  
  
  
  have hInterNe : ∀ {X : AlgebraicGeometry.Scheme.{u}} [IrreducibleSpace ↥X]
      (A B : X.Opens) [Nonempty A] [Nonempty B], Nonempty (A ⊓ B : X.Opens) := by
    intro X _ A B ⟨⟨x₁, hx₁⟩⟩ ⟨⟨x₂, hx₂⟩⟩
    obtain ⟨x₀, _, hx₀A, hx₀B⟩ :=
      PreirreducibleSpace.isPreirreducible_univ A.1 B.1 A.isOpen B.isOpen
