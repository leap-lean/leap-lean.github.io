        if i = j then MvPolynomial.C (c_P (s j)) else 0 := by
      intro i j
      rw [(MvPolynomial.pderiv i).map_sub, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C,
        zero_mul, zero_add, MvPolynomial.pderiv_C, sub_zero, MvPolynomial.pderiv_X]
      by_cases hij : i = j
      · subst hij
        simp only [ ↓reduceIte, Pi.single_eq_same, mul_one]
      · simp only [hij, ↓reduceIte, Pi.single_eq_of_ne (Ne.symm hij), mul_zero]
    have hpderiv_G : ∀ (i j : Fin r),
        MvPolynomial.pderiv i (G j) =
          MvPolynomial.pderiv i (W j) *
            (MvPolynomial.C (c_P (s j)) * MvPolynomial.X j - MvPolynomial.C (c_P (a j))) +
          W j * (if i = j then MvPolynomial.C (c_P (s j)) else 0) -
          MvPolynomial.pderiv i (B₀_poly j) * MvPolynomial.C X₀_P -
          MvPolynomial.pderiv i (B₁_poly j) * MvPolynomial.C X₁_P -
          MvPolynomial.pderiv i (Z j) := by
      intro i j
      dsimp only [G]
      rw [(MvPolynomial.pderiv i).map_sub, (MvPolynomial.pderiv i).map_sub,
        (MvPolynomial.pderiv i).map_sub,
        MvPolynomial.pderiv_mul, hpderiv_lin,
        MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, mul_zero, add_zero,
        MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, mul_zero, add_zero]
    let M_G : Matrix (Fin r) (Fin r) (MvPolynomial (Fin r) P) :=
      Matrix.of fun i j => MvPolynomial.pderiv i (G j)
    let q_mk : A₁ →+* (A₁ ⧸ q₁.asIdeal) := Ideal.Quotient.mk q₁.asIdeal
    let π_bar : MvPolynomial (Fin r) P →+* (A₁ ⧸ q₁.asIdeal) := q_mk.comp Phi
    have hM_G_diag :
        π_bar.mapMatrix M_G =
          Matrix.diagonal fun i : Fin r => q_mk (w i * f₁ (s i)) := by
      refine Matrix.ext fun i j => ?_
      rw [RingHom.mapMatrix_apply, Matrix.map_apply]
      have hMG_ij : M_G i j = MvPolynomial.pderiv i (G j) := rfl
      rw [hMG_ij, hpderiv_G, RingHom.comp_apply]
      have hq_lin :
          q_mk (f₁ (s j)) * q_mk (Phi (MvPolynomial.X j)) - q_mk (f₁ (a j)) = 0 := by
        rw [← map_mul, ← map_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hy_mem j)
      have hq_u : q_mk (Phi (MvPolynomial.C X₀_P)) = 0 := by
        rw [hPhi_X0]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hu₁
      have hq_v : q_mk (Phi (MvPolynomial.C X₁_P)) = 0 := by
        rw [hPhi_X1]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hv₁
      have hq_Z : q_mk (Phi (MvPolynomial.pderiv i (Z j))) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (h_pderiv_Z_q₁ i j)
      by_cases hij : i = j
      · subst hij
        simp only [↓reduceIte, Matrix.diagonal_apply_eq,
          map_sub, map_add, map_mul, hPhi_C, hq_lin, hq_u, hq_v, hq_Z,
          mul_zero, zero_add, sub_zero, hW_eq]
      · simp only [hij, ↓reduceIte, Matrix.diagonal_apply_ne _ hij,
          map_sub, map_mul, hPhi_C, hq_lin, hq_u, hq_v, hq_Z,
          mul_zero, add_zero, sub_zero]
