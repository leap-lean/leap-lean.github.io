by
  
  have quotBaseChangeEquiv :
      ∀ (E₁ K A B : Type u) [Field E₁] [Field K] [Algebra E₁ K]
        [CommRing A] [Algebra E₁ A] [CommRing B] [Algebra K B]
        (γ : TensorProduct E₁ K A ≃ₐ[K] B)
        (I : Ideal A) (J : Ideal B),
        Ideal.map (γ.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) I = J →
        TensorProduct E₁ K (A ⧸ I) ≃ₐ[K] (B ⧸ J) := by
    clear! κ₀ F₀ K E₁
    intro E₁ K A B _ _ _ _ _ _ _ γ I J hIJ
    letI : Algebra E₁ B := ((algebraMap K B).comp (algebraMap E₁ K)).toAlgebra
    haveI : IsScalarTower E₁ K B := IsScalarTower.of_algebraMap_eq' rfl
    let mkI : A →ₐ[E₁] A ⧸ I := Ideal.Quotient.mkₐ E₁ I
    let mkJ : B →ₐ[K] B ⧸ J := Ideal.Quotient.mkₐ K J
    let toBJ : A →ₐ[E₁] B ⧸ J :=
      { toRingHom := (Ideal.Quotient.mk J).comp
          (γ.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom)
