  let y_x : Y := ⟨t_x, by change π.left.base t_x ∈ U₀; rw [htx]; exact hxU₀⟩
  have hy_x_mem01 : y_x ∈ V₀ ⊓ V₁ := ⟨hp₀_L₀, hp₀_L₁⟩
  haveI : Nonempty ↥Y := ⟨y_x⟩
  haveI hNeY : Nonempty ↥(⊤ : Y.Opens) := ⟨⟨y_x, trivial⟩⟩
  haveI hNe01 : Nonempty ↥(V₀ ⊓ V₁) := ⟨⟨y_x, hy_x_mem01⟩⟩
  haveI hIntY : AlgebraicGeometry.IsIntegral Y :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion W.ι
  let D_top : Type u := ↑(Y.presheaf.obj (Opposite.op ⊤))
  let B₀ : Type u := ↑(Y.presheaf.obj (Opposite.op V₀))
  let B₁ : Type u := ↑(Y.presheaf.obj (Opposite.op V₁))
  let B₀₁ : Type u := ↑(Y.presheaf.obj (Opposite.op (V₀ ⊓ V₁)))
  haveI hDomD : IsDomain D_top :=
    @AlgebraicGeometry.IsIntegral.component_integral Y hIntY ⊤ hNeY
  haveI hDomB₀₁ : IsDomain B₀₁ :=
    @AlgebraicGeometry.IsIntegral.component_integral Y hIntY (V₀ ⊓ V₁) hNe01
  let φ_cat : CommRingCat.of R₀ ⟶ Y.presheaf.obj (Opposite.op ⊤) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫ p.appTop
  let φ : R₀ →+* D_top := φ_cat.hom
  let f₀ : D_top →+* B₀ := (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op).hom
  let f₁ : D_top →+* B₁ := (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V₁ ≤ ⊤)).op).hom
  let res₀ : B₀ →+* B₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
  let res₁ : B₁ →+* B₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
  have hComm : res₀.comp f₀ = res₁.comp f₁ := by
    change (Y.presheaf.map _ ≫ Y.presheaf.map _).hom = (Y.presheaf.map _ ≫ Y.presheaf.map _).hom
    rw [← Y.presheaf.map_comp, ← Y.presheaf.map_comp]
