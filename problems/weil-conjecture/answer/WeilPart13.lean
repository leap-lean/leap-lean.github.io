      · rename_i u v hu hv
        rw [map_add, map_add, map_add, map_add, hu, hv]
    · apply AlgHom.ext
      intro w
      change bwd (fwd w) = w
      induction w using TensorProduct.induction_on
      · rw [map_zero, map_zero]
      · rename_i k qa
