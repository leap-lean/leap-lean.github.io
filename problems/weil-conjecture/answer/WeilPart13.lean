theorem weil_algClosed_semistable_pullback_normality_and_threeSecant_lift (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hProjB₂ : IsProjectiveOverField k B₂)
