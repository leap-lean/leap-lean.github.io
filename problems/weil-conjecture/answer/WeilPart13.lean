    (φ_K : CategoryTheory.Limits.pullback g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) ≅
      CategoryTheory.Limits.pullback g₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))))
    (hφK_snd : φ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
      CategoryTheory.Limits.pullback.snd g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))))
    (hφK_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
        (s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ τ₂ j) :
    ∃ (φ : C₁ ≅ C₂),
      φ.hom ≫ g₂ = g₁ ∧
      (∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j) ∧
      CategoryTheory.Limits.pullback.fst g₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) ≫ φ.hom =
        φ_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) :=
by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  let Ω : Type u := AlgebraicClosure (IsLocalRing.ResidueField R)
  obtain ⟨ι, hι_π, _hι_loc, _hι_inj, hι_ff⟩ :=
    weil_equichar_dvr_cohen_powerSeries_embedding k R π hπ
  apply weil_dvr_faithfullyFlat_pointed_curve_iso_descent
    R (PowerSeries Ω) K π hπ (PowerSeries.X : PowerSeries Ω) PowerSeries.X_irreducible
    ι hι_π hι_ff n C₁ C₂ g₁ τ₁ g₂ τ₂ hStab₁ hStab₂ hSm₁ φ_K hφK_snd hφK_sec
  intro C₁' C₂' g₁' τ₁' g₂' τ₂' hStab₁' hStab₂' hInt₁' hInt₂' η_K' hSm₁' φ_K' hφK'_snd hφK'_sec
  have hPb : CategoryTheory.IsPullback φ_K'.inv
