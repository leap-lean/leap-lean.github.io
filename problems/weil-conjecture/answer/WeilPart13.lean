    rw [h_alg, IsLocalization.lift_eq hψ'₀_unit (τ₀.hom b)]
    change (Y.left.germToFunctionField Z₀).hom ((τ₀ ≫ CategoryTheory.inv τ₀).hom b) = _
    rw [CategoryTheory.IsIso.hom_inv_id]
    rfl

  have heL_q : ∀ (Z : Y.left.Opens) [Nonempty Z] (Z' : Y'.left.Opens) [Nonempty Z']
