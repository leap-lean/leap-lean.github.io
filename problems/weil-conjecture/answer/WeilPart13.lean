    exact ⟨ψ₁', ψ₂', hψ₁'_etale, hψ₂'_etale, hcomap₁', hXi', hcomm'⟩
  
  let F₁ : Type u := TensorProduct R₁ A₁ κ₁
  let toF₁ : A₁ →+* F₁ := Algebra.TensorProduct.includeLeftRingHom
  let toκ₁ : κ₁ →+* F₁ := Algebra.TensorProduct.includeRight.toRingHom
  let F_ext : Type u := TensorProduct κ₀ E₂ F₀
  have hΨ_F : ∃ Ψ_F : F₁ ≃+* F_ext,
      (∀ c : κ₁, Ψ_F (toκ₁ c) = algebraMap E₂ F_ext (φ_κ c)) ∧
      (∀ r₁ : R₁, Ψ_F (toF₁ (f₁ r₁)) = algebraMap E₂ F_ext (φ_κ (algebraMap R₁ κ₁ r₁))) ∧
      (∀ a₀ : A₀, Ψ_F (toF₁ (eA₁ a₀)) =
        Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀)) := by
    let toE₂_R₁ : R₁ →+* E₂ := φ_κ.toRingHom.comp (algebraMap R₁ κ₁)
    letI : Algebra R₁ E₂ := toE₂_R₁.toAlgebra
    have hTower_R₀R₁E₂ : toE₂_R₁.comp eR₁ = toE₂ := by
      ext r₀
      exact hφ_compat r₀
    haveI : IsScalarTower R₀ R₁ E₂ := IsScalarTower.of_algebraMap_eq' hTower_R₀R₁E₂.symm
    let φ_κ_alg : κ₁ ≃ₐ[R₁] E₂ := AlgEquiv.ofRingEquiv (f := φ_κ) (fun _ => rfl)
    let fe₁ : F₁ ≃ₐ[R₁] TensorProduct R₁ κ₁ A₁ := Algebra.TensorProduct.comm R₁ A₁ κ₁
    let fe₂ : TensorProduct R₁ κ₁ A₁ ≃ₐ[R₁] TensorProduct R₁ E₂ A₁ :=
      Algebra.TensorProduct.congr φ_κ_alg (AlgEquiv.refl : A₁ ≃ₐ[R₁] A₁)
    let fe₃ : TensorProduct R₁ E₂ A₁ ≃ₐ[E₂] TensorProduct R₀ E₂ A₀ :=
      Algebra.TensorProduct.cancelBaseChange R₀ R₁ E₂ E₂ A₀
    let fe₄ : TensorProduct R₀ E₂ A₀ ≃ₐ[E₂] F_ext :=
      (Algebra.TensorProduct.cancelBaseChange R₀ κ₀ E₂ E₂ A₀).symm
    let Ψ_F : F₁ ≃+* F_ext :=
      ((fe₁.toRingEquiv.trans fe₂.toRingEquiv).trans fe₃.toRingEquiv).trans fe₄.toRingEquiv
    have hΨ_κ₁ : ∀ c : κ₁, Ψ_F (toκ₁ c) = algebraMap E₂ F_ext (φ_κ c) := by
      intro c
      change fe₄ (fe₃ (fe₂ (fe₁ (TensorProduct.tmul R₁ (TensorProduct.tmul R₀ (1 : R₁) (1 : A₀)) c)))) =
        algebraMap E₂ F_ext (φ_κ c)
      dsimp only [fe₁, fe₂]
      rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.congr_apply,
        Algebra.TensorProduct.map_tmul]
      change fe₄ (fe₃ (TensorProduct.tmul R₁ (φ_κ_alg c) (TensorProduct.tmul R₀ (1 : R₁) (1 : A₀)))) = _
      dsimp only [fe₃]
      rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul]
      exact fe₄.commutes (φ_κ c)
    have hΨ_f₁ : ∀ r₁ : R₁, Ψ_F (toF₁ (f₁ r₁)) = algebraMap E₂ F_ext (φ_κ (algebraMap R₁ κ₁ r₁)) := by
      intro r₁
      have h_eq : toF₁ (f₁ r₁) = toκ₁ (algebraMap R₁ κ₁ r₁) := by
        change TensorProduct.tmul R₁ (algebraMap R₁ A₁ r₁) (1 : κ₁) =
          TensorProduct.tmul R₁ (1 : A₁) (algebraMap R₁ κ₁ r₁)
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
      rw [h_eq, hΨ_κ₁]
    have hΨ_eA₁ : ∀ a₀ : A₀, Ψ_F (toF₁ (eA₁ a₀)) =
        Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀) := by
      intro a₀
      change fe₄ (fe₃ (fe₂ (fe₁ (TensorProduct.tmul R₁ (TensorProduct.tmul R₀ (1 : R₁) a₀) (1 : κ₁))))) = _
      dsimp only [fe₁, fe₂]
      rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.congr_apply,
        Algebra.TensorProduct.map_tmul]
      change fe₄ (fe₃ (TensorProduct.tmul R₁ (φ_κ_alg 1) (TensorProduct.tmul R₀ (1 : R₁) a₀))) = _
      dsimp only [fe₃]
      rw [Algebra.TensorProduct.cancelBaseChange_tmul]
      have h1 : (1 : R₁) • φ_κ_alg 1 = (1 : E₂) := by
        rw [map_one, one_smul]
      rw [h1]
      dsimp only [fe₄]
      rw [AlgEquiv.symm_apply_eq]
      change TensorProduct.tmul R₀ (1 : E₂) a₀ =
        Algebra.TensorProduct.cancelBaseChange R₀ κ₀ E₂ E₂ A₀
          (TensorProduct.tmul κ₀ (1 : E₂) (TensorProduct.tmul R₀ (1 : κ₀) a₀))
      rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul]
    exact ⟨Ψ_F, hΨ_κ₁, hΨ_f₁, hΨ_eA₁⟩
  obtain ⟨Ψ_F, hΨ_κ₁, hΨ_f₁, hΨ_eA₁⟩ := hΨ_F
  let τ : A₁ →+* F_ext := Ψ_F.toRingHom.comp toF₁
  have hτ_f₁ : ∀ r₁ : R₁, τ (f₁ r₁) = algebraMap E₂ F_ext (φ_κ (algebraMap R₁ κ₁ r₁)) := hΨ_f₁
  have hτ_eA₁ : ∀ a₀ : A₀, τ (eA₁ a₀) =
      Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀) := hΨ_eA₁
  obtain ⟨hτ_u₁, hτ_v₁⟩ := hτ_uv τ hτ_f₁ hτ_eA₁
  let ρ₂ : F_ext →ₐ[E₂] E₂ :=
    Algebra.TensorProduct.lift (AlgHom.id E₂ E₂) π₂ (fun _ _ => Commute.all _ _)
  have hρ₂_τ : ∀ z : A₁, ρ₂ (τ z) = ev_A₁ z := by
    intro z
    refine @TensorProduct.induction_on R₀ _ R₁ A₀ _ _ _ _
      (fun z => ρ₂ (τ z) = ev_A₁ z) z ?_ ?_ ?_
    · simp only [map_zero]
    · intro r₁ a₀
      have hmul : (TensorProduct.tmul R₀ r₁ a₀ : A₁) = f₁ r₁ * eA₁ a₀ := by
        change TensorProduct.tmul R₀ r₁ a₀ =
          (TensorProduct.tmul R₀ r₁ (1 : A₀)) * (TensorProduct.tmul R₀ (1 : R₁) a₀)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hmul, map_mul, map_mul, map_mul, hτ_f₁, hτ_eA₁, hev_f₁, hev_eA₁]
      have hρ_l : ρ₂ (algebraMap E₂ F_ext (φ_κ (algebraMap R₁ κ₁ r₁))) =
          φ_κ (algebraMap R₁ κ₁ r₁) := by
        change ρ₂ (TensorProduct.tmul κ₀ (φ_κ (algebraMap R₁ κ₁ r₁)) (1 : F₀)) = _
        dsimp only [ρ₂]
        rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one]
      have hρ_r : ρ₂ (Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀)) =
          π₂ (Algebra.TensorProduct.includeRight a₀) := by
        change ρ₂ (TensorProduct.tmul κ₀ (1 : E₂) (Algebra.TensorProduct.includeRight a₀)) = _
        dsimp only [ρ₂]
        rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]
      rw [hρ_l, hρ_r]
    · intro x y hx hy
      simp only [map_add, hx, hy]
  have hm₂_mem : ∀ w : F_ext, w ∈ m₂.asIdeal ↔ ρ₂ w = 0 := by
    intro w
    rw [hm₂_ker]
    rfl
  have hu₁_q₁ : u₁ ∈ q₁.asIdeal := by
    rw [hq₁_mem, ← hρ₂_τ, ← hm₂_mem]
    rwa [hτ_u₁]
  have hv₁_q₁ : v₁ ∈ q₁.asIdeal := by
    rw [hq₁_mem, ← hρ₂_τ, ← hm₂_mem]
    rwa [hτ_v₁]
  
  let m₁ : PrimeSpectrum F₁ := PrimeSpectrum.comap Ψ_F.toRingHom m₂
  have hm₁_q₁ : PrimeSpectrum.comap toF₁ m₁ = q₁ := by
    ext z
    change τ z ∈ m₂.asIdeal ↔ ev_A₁ z = 0
    rw [hm₂_mem, hρ₂_τ]
  have hres_m₁ : ∀ z : F₁, ∃ c : κ₁, z - toκ₁ c ∈ m₁.asIdeal := by
    intro z
    obtain ⟨e, he⟩ := hres_m₂ (Ψ_F z)
    refine ⟨φ_κ.symm e, ?_⟩
    change Ψ_F (z - toκ₁ (φ_κ.symm e)) ∈ m₂.asIdeal
    rw [map_sub, hΨ_κ₁, RingEquiv.apply_symm_apply]
    exact he
  let L₁ := Localization.AtPrime m₁.asIdeal
  let L₂ := Localization.AtPrime m₂.asIdeal
  have hSub : Submonoid.map Ψ_F.toMonoidHom m₁.asIdeal.primeCompl = m₂.asIdeal.primeCompl := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx
    · intro hy
      exact ⟨Ψ_F.symm y, by change Ψ_F (Ψ_F.symm y) ∉ m₂.asIdeal; rwa [RingEquiv.apply_symm_apply],
        RingEquiv.apply_symm_apply Ψ_F y⟩
  let Φ_L : L₁ ≃+* L₂ := IsLocalization.ringEquivOfRingEquiv L₁ L₂ Ψ_F hSub
  have hΦ_loc : ∀ x : F₁, Φ_L (algebraMap F₁ L₁ x) = algebraMap F_ext L₂ (Ψ_F x) := by
    intro x
    rw [IsLocalization.ringEquivOfRingEquiv_apply, IsLocalization.map_eq]
    rfl
  let 𝔪₁ : Ideal L₁ := IsLocalRing.maximalIdeal L₁
  let 𝔪₂ : Ideal L₂ := IsLocalRing.maximalIdeal L₂
  have hΦ_unit : ∀ w : L₁, IsUnit w ↔ IsUnit (Φ_L w) := by
    intro w
    constructor
    · exact IsUnit.map Φ_L.toMonoidHom
    · intro hu
      have := hu.map Φ_L.symm.toMonoidHom
      change IsUnit (Φ_L.symm (Φ_L w)) at this
      rwa [RingEquiv.symm_apply_apply] at this
  have hΦ_mem_max : ∀ w : L₁, w ∈ 𝔪₁ ↔ Φ_L w ∈ 𝔪₂ := by
    intro w
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      mem_nonunits_iff, hΦ_unit]
  have hMax_map : Ideal.map Φ_L.toRingHom 𝔪₁ = 𝔪₂ := by
    ext y
    have hbij : Ideal.comap Φ_L.toRingHom (Ideal.map Φ_L.toRingHom 𝔪₁) = 𝔪₁ :=
      Ideal.comap_map_of_bijective Φ_L.toRingHom Φ_L.bijective
    have hy : y = Φ_L (Φ_L.symm y) := (RingEquiv.apply_symm_apply Φ_L y).symm
    conv_lhs => rw [hy]
    change Φ_L.symm y ∈ Ideal.comap Φ_L.toRingHom (Ideal.map Φ_L.toRingHom 𝔪₁) ↔ y ∈ 𝔪₂
    rw [hbij, hΦ_mem_max, RingEquiv.apply_symm_apply]
  have hΦ_mem_pow : ∀ (n : ℕ) (w : L₁), w ∈ 𝔪₁ ^ n ↔ Φ_L w ∈ 𝔪₂ ^ n := by
    intro n w
    have hmap_pow : Ideal.map Φ_L.toRingHom (𝔪₁ ^ n) = 𝔪₂ ^ n := by
      rw [Ideal.map_pow, hMax_map]
    rw [← hmap_pow]
    have hbij : Ideal.comap Φ_L.toRingHom (Ideal.map Φ_L.toRingHom (𝔪₁ ^ n)) = 𝔪₁ ^ n :=
      Ideal.comap_map_of_bijective Φ_L.toRingHom Φ_L.bijective
    conv_lhs => rw [← hbij]
    rfl
  obtain ⟨hspan₂, hlin₂, hcube₂⟩ := hloc_m₂
  have hspan₁ : Ideal.span {algebraMap F₁ L₁ (toF₁ u₁), algebraMap F₁ L₁ (toF₁ v₁)} = 𝔪₁ := by
    have hmap_eq :
        Ideal.map Φ_L.toRingHom
            (Ideal.span {algebraMap F₁ L₁ (toF₁ u₁), algebraMap F₁ L₁ (toF₁ v₁)}) =
          Ideal.map Φ_L.toRingHom 𝔪₁ := by
      rw [Ideal.map_span, Set.image_pair]
      change Ideal.span {Φ_L (algebraMap F₁ L₁ (toF₁ u₁)), Φ_L (algebraMap F₁ L₁ (toF₁ v₁))} = _
      rw [hΦ_loc, hΦ_loc]
      change Ideal.span {algebraMap F_ext L₂ (τ u₁), algebraMap F_ext L₂ (τ v₁)} = _
      rw [hτ_u₁, hτ_v₁, hspan₂, hMax_map]
    have h1 := congrArg (Ideal.comap Φ_L.toRingHom) hmap_eq
    simpa only [Ideal.comap_map_of_bijective Φ_L.toRingHom Φ_L.bijective] using h1
  have hlin₁ : ∀ c₀ c₁ : κ₁,
      algebraMap F₁ L₁ (toκ₁ c₀) * algebraMap F₁ L₁ (toF₁ u₁) +
        algebraMap F₁ L₁ (toκ₁ c₁) * algebraMap F₁ L₁ (toF₁ v₁) ∈ 𝔪₁ ^ 2 →
      c₀ = 0 ∧ c₁ = 0 := by
    intro c₀ c₁ hw
    rw [hΦ_mem_pow 2] at hw
    simp only [map_add, map_mul, hΦ_loc, hΨ_κ₁] at hw
    change algebraMap F_ext L₂ (algebraMap E₂ F_ext (φ_κ c₀)) * algebraMap F_ext L₂ (τ u₁) +
      algebraMap F_ext L₂ (algebraMap E₂ F_ext (φ_κ c₁)) * algebraMap F_ext L₂ (τ v₁) ∈ 𝔪₂ ^ 2 at hw
    rw [hτ_u₁, hτ_v₁] at hw
    obtain ⟨hc₀, hc₁⟩ := hlin₂ (φ_κ c₀) (φ_κ c₁) hw
    exact ⟨φ_κ.injective (hc₀.trans (map_zero φ_κ).symm),
      φ_κ.injective (hc₁.trans (map_zero φ_κ).symm)⟩
  have hcube₁ : algebraMap F₁ L₁ (toF₁ u₁) * algebraMap F₁ L₁ (toF₁ v₁) ∈ 𝔪₁ ^ 3 := by
    rw [hΦ_mem_pow 3, map_mul, hΦ_loc, hΦ_loc]
    change algebraMap F_ext L₂ (τ u₁) * algebraMap F_ext L₂ (τ v₁) ∈ 𝔪₂ ^ 3
    rw [hτ_u₁, hτ_v₁]
    exact hcube₂
  have hSplit_gen : ∀ {B₁ : Type u} [CommRing B₁] (g₁ : R₁ →+* B₁) (r₁ : PrimeSpectrum B₁)
      (x₁ y₁ : B₁) (instB₁ : Algebra R₁ B₁), g₁.toAlgebra = instB₁ →
      ∀ (p₁' : PrimeSpectrum R₁), PrimeSpectrum.comap g₁ r₁ = p₁' →
      x₁ ∈ r₁.asIdeal →
      y₁ ∈ r₁.asIdeal →
      HasGeomFiberNodalRoofAt g₁ r₁ →
      (letI : Algebra R₁ B₁ := instB₁
       let κ₁' : Type u := p₁'.asIdeal.ResidueField
       let F₁' : Type u := TensorProduct R₁ B₁ κ₁'
       let toF₁' : B₁ →+* F₁' := Algebra.TensorProduct.includeLeftRingHom
       let toκ₁' : κ₁' →+* F₁' := Algebra.TensorProduct.includeRight.toRingHom
       ∃ (m₁' : PrimeSpectrum F₁'),
         PrimeSpectrum.comap toF₁' m₁' = r₁ ∧
         (∀ z : F₁', ∃ c : κ₁', z - toκ₁' c ∈ m₁'.asIdeal) ∧
         (let L₁' := Localization.AtPrime m₁'.asIdeal
          let loc' : F₁' →+* L₁' := algebraMap F₁' L₁'
          let 𝔪' : Ideal L₁' := IsLocalRing.maximalIdeal L₁'
          Ideal.span {loc' (toF₁' x₁), loc' (toF₁' y₁)} = 𝔪' ∧
          (∀ c₀ c₁ : κ₁',
            loc' (toκ₁' c₀) * loc' (toF₁' x₁) + loc' (toκ₁' c₁) * loc' (toF₁' y₁) ∈ 𝔪' ^ 2 →
            c₀ = 0 ∧ c₁ = 0) ∧
          loc' (toF₁' x₁) * loc' (toF₁' y₁) ∈ 𝔪' ^ 3)) →
      HasSplitFiberNodeAt g₁ r₁ x₁ y₁ := by
    intro B₁ _ g₁ r₁ x₁ y₁ instB₁ hAlg p₁' hp₁' hx₁ hy₁ hR h
    unfold HasSplitFiberNodeAt
    dsimp only []
    refine ⟨hx₁, hy₁, hR, ?_⟩
    subst hAlg
    subst hp₁'
    exact h
  have hSplit : HasSplitFiberNodeAt f₁ q₁ u₁ v₁ :=
    hSplit_gen f₁ q₁ u₁ v₁ Algebra.TensorProduct.leftAlgebra hAlg₁ p₁ hp₁_eq
      hu₁_q₁ hv₁_q₁ hRoof₁ ⟨m₁, hm₁_q₁, hres_m₁, hspan₁, hlin₁, hcube₁⟩
  exact ⟨q₁, heA₁_etale, hf₁_flat, hf₁_fp, hcomm₁, hq₁_q₀, hSplit⟩

theorem weil_geom_nodal_fiber_etale_split_tangent_cone (R₀ A₀ : Type u) [CommRing R₀] [CommRing A₀]
    (f₀ : R₀ →+* A₀)
    (hFlat₀ : f₀.Flat)
    (hFP₀ : f₀.FinitePresentation)
    (q₀ : PrimeSpectrum A₀)
    (hNode₀ : HasGeomFiberNodalRoofAt f₀ q₀) :
    ∃ (R₁ A₁ : Type u) (_ : CommRing R₁) (_ : CommRing A₁)
      (eR₁ : R₀ →+* R₁) (eA₁ : A₀ →+* A₁)
      (f₁ : R₁ →+* A₁) (q₁ : PrimeSpectrum A₁) (u₁ v₁ : A₁),
      eR₁.Etale ∧
      eA₁.Etale ∧
      f₁.Flat ∧
      f₁.FinitePresentation ∧
      eA₁.comp f₀ = f₁.comp eR₁ ∧
      PrimeSpectrum.comap eA₁ q₁ = q₀ ∧
      HasSplitFiberNodeAt f₁ q₁ u₁ v₁ :=
by
  letI : Algebra R₀ A₀ := f₀.toAlgebra
  let p₀ : PrimeSpectrum R₀ := PrimeSpectrum.comap f₀ q₀
  let κ₀ : Type u := p₀.asIdeal.ResidueField
  let K : Type u := AlgebraicClosure κ₀
  let toK : R₀ →+* K := (algebraMap κ₀ K).comp (algebraMap R₀ κ₀)
  letI : Algebra R₀ K := toK.toAlgebra
  haveI : @IsScalarTower R₀ κ₀ K _ _ toK.toAlgebra.toSMul :=
    @IsScalarTower.of_algebraMap_eq' R₀ κ₀ K _ _ _ _ _ toK.toAlgebra rfl
  obtain ⟨D_K, instDK, m₀, ψ₁_orig, ψ₂, hψ₁_orig, hψ₂, hm₀_q₀, hXi, hcomm_orig⟩ := hNode₀
  letI : CommRing D_K := instDK
  let F₀ : Type u := TensorProduct R₀ κ₀ A₀
  haveI : Algebra.FinitePresentation R₀ A₀ := hFP₀
  haveI : Algebra.IsAlgebraic κ₀ K := AlgebraicClosure.isAlgebraic κ₀
  let e_cancel : TensorProduct κ₀ K F₀ ≃ₐ[K] TensorProduct R₀ K A₀ :=
    Algebra.TensorProduct.cancelBaseChange R₀ κ₀ K K A₀
  let e_comm : TensorProduct R₀ K A₀ ≃ₐ[R₀] TensorProduct R₀ A₀ K :=
    Algebra.TensorProduct.comm R₀ K A₀
  let α₀ : TensorProduct κ₀ K F₀ ≃+* TensorProduct R₀ A₀ K :=
    e_cancel.toRingEquiv.trans e_comm.toRingEquiv
  let ψ₁_F₀ : TensorProduct κ₀ K F₀ →+* D_K := ψ₁_orig.comp α₀.toRingHom
  have hα₀_etale : α₀.toRingHom.Etale := RingHom.Etale.of_bijective α₀.bijective
  have hψ₁_F₀ : ψ₁_F₀.Etale :=
    RingHom.Etale.stableUnderComposition α₀.toRingHom ψ₁_orig hα₀_etale hψ₁_orig
  have hα₀_K : ∀ c : K, α₀ (algebraMap K (TensorProduct κ₀ K F₀) c) =
      Algebra.TensorProduct.includeRight c := by
    intro c
    change e_comm (e_cancel (TensorProduct.tmul κ₀ c (TensorProduct.tmul R₀ (1 : κ₀) (1 : A₀)))) =
      TensorProduct.tmul R₀ (1 : A₀) c
    dsimp only [e_cancel, e_comm]
    rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul,
      Algebra.TensorProduct.comm_tmul]
  have hcomm_K : ψ₁_F₀.comp (algebraMap K (TensorProduct κ₀ K F₀)) =
      ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) := by
    rw [← hcomm_orig]
    ext c
    change ψ₁_orig (α₀ (algebraMap K (TensorProduct κ₀ K F₀) c)) =
      ψ₁_orig (Algebra.TensorProduct.includeRight c)
    rw [hα₀_K]
  obtain ⟨E₁, instFieldE₁, instAlgE₁, instFinE₁, instSepE₁, π₁, j₁,
      hSurj₁, hcompat₁, hq_K, hIso_cube⟩ :=
    weil_geom_nodal_roof_residue_separable_and_mod_cube_iso
      κ₀ F₀ K D_K m₀ ψ₁_F₀ ψ₂ hψ₁_F₀ hψ₂ hXi hcomm_K
  letI : Field E₁ := instFieldE₁
  letI : Algebra κ₀ E₁ := instAlgE₁
  letI : FiniteDimensional κ₀ E₁ := instFinE₁
  letI : Algebra.IsSeparable κ₀ E₁ := instSepE₁
  obtain ⟨E₂, instFieldE₂, instAlgE₂, instFinE₂, instSepE₂, π₂, j₂,
      u_ext, v_ext, m₂, hj₂_π₂, hm₂_ker, hu_m₂, hv_m₂, hres_m₂, hloc_m₂⟩ :=
    weil_nodal_mod_cube_iso_split_tangent_cone_over_ext
      κ₀ F₀ K E₁ π₁ j₁ (Ideal.comap ψ₁_F₀ m₀.asIdeal) hSurj₁ hq_K hIso_cube
  letI : Field E₂ := instFieldE₂
  letI : Algebra κ₀ E₂ := instAlgE₂
  letI : FiniteDimensional κ₀ E₂ := instFinE₂
  letI : Algebra.IsSeparable κ₀ E₂ := instSepE₂
  let toE₂ : R₀ →+* E₂ := (algebraMap κ₀ E₂).comp (algebraMap R₀ κ₀)
  letI : Algebra R₀ E₂ := toE₂.toAlgebra
  haveI : IsScalarTower R₀ κ₀ E₂ := IsScalarTower.of_algebraMap_eq' rfl
  let β₂ : TensorProduct κ₀ E₂ F₀ ≃ₐ[E₂] TensorProduct R₀ E₂ A₀ :=
    Algebra.TensorProduct.cancelBaseChange R₀ κ₀ E₂ E₂ A₀
  obtain ⟨S_u, hu_sum⟩ := TensorProduct.exists_finset (β₂ u_ext)
  obtain ⟨S_v, hv_sum⟩ := TensorProduct.exists_finset (β₂ v_ext)
  classical
  let S_fin : Finset E₂ := S_u.image Prod.fst ∪ S_v.image Prod.fst
  obtain ⟨R₁, instR₁, eR₁, p₁, hp₁, φ_κ, heR₁, hφ_map, hS_lift⟩ :=
    weil_etale_base_lift_of_finite_separable_residue_ext R₀ p₀ E₂ S_fin
  letI : CommRing R₁ := instR₁
  letI : Algebra R₀ R₁ := eR₁.toAlgebra
  let A₁ : Type u := TensorProduct R₀ R₁ A₀
  let f₁ : R₁ →+* A₁ := Algebra.TensorProduct.includeLeftRingHom
  let eA₁ : A₀ →+* A₁ := Algebra.TensorProduct.includeRight.toRingHom
  let liftE : E₂ → R₁ := fun e =>
    if h : e ∈ S_fin then Classical.choose (hS_lift e h) else 0
  have hliftE : ∀ e ∈ S_fin, φ_κ (algebraMap R₁ p₁.asIdeal.ResidueField (liftE e)) = e := by
    intro e he
    simp only [liftE, he, ↓reduceDIte]
    exact Classical.choose_spec (hS_lift e he)
  let u₁ : A₁ := ∑ p ∈ S_u, TensorProduct.tmul R₀ (liftE p.1) p.2
  let v₁ : A₁ := ∑ p ∈ S_v, TensorProduct.tmul R₀ (liftE p.1) p.2
  have hcompat₂ : ∀ a₀ : A₀,
      ψ₁_orig (Algebra.TensorProduct.includeLeftRingHom a₀) -
        ψ₁_orig (Algebra.TensorProduct.includeRight (j₂ (π₂ (Algebra.TensorProduct.includeRight a₀)))) ∈
        m₀.asIdeal := by
    intro a₀
    have h₁ : ψ₁_orig (α₀ (Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀))) -
        ψ₁_orig (α₀ (algebraMap K (TensorProduct κ₀ K F₀) (j₁ (π₁ (Algebra.TensorProduct.includeRight a₀))))) ∈
        m₀.asIdeal := hcompat₁ (Algebra.TensorProduct.includeRight a₀)
    have hj : j₁ (π₁ (Algebra.TensorProduct.includeRight a₀)) =
        j₂ (π₂ (Algebra.TensorProduct.includeRight a₀)) :=
      (AlgHom.congr_fun hj₂_π₂ (Algebra.TensorProduct.includeRight a₀)).symm
    have hα₀_a : α₀ (Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀)) =
        Algebra.TensorProduct.includeLeftRingHom a₀ := by
      change e_comm (e_cancel (TensorProduct.tmul κ₀ (1 : K) (TensorProduct.tmul R₀ (1 : κ₀) a₀))) =
        TensorProduct.tmul R₀ a₀ (1 : K)
      dsimp only [e_cancel, e_comm]
      rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul,
        Algebra.TensorProduct.comm_tmul]
    rw [hα₀_a, hj, hα₀_K] at h₁
    exact h₁
  have hτ_uv : ∀ (τ : A₁ →+* TensorProduct κ₀ E₂ F₀),
      (∀ r₁ : R₁,
        τ (f₁ r₁) = algebraMap E₂ (TensorProduct κ₀ E₂ F₀)
          (φ_κ (algebraMap R₁ p₁.asIdeal.ResidueField r₁))) →
      (∀ a₀ : A₀,
        τ (eA₁ a₀) = Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight a₀)) →
      τ u₁ = u_ext ∧ τ v₁ = v_ext := by
    intro τ hτ_l hτ_r
    have htmul : ∀ (p : E₂ × A₀), p.1 ∈ S_fin →
        β₂ (τ (TensorProduct.tmul R₀ (liftE p.1) p.2)) = TensorProduct.tmul R₀ p.1 p.2 := by
      intro p hp
      have hmul : (TensorProduct.tmul R₀ (liftE p.1) p.2 : A₁) = f₁ (liftE p.1) * eA₁ p.2 := by
        change TensorProduct.tmul R₀ (liftE p.1) p.2 =
          (TensorProduct.tmul R₀ (liftE p.1) (1 : A₀)) * (TensorProduct.tmul R₀ (1 : R₁) p.2)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hmul, map_mul, hτ_l, hτ_r, hliftE p.1 hp, map_mul, β₂.commutes]
      have hβ₂_a : β₂ (Algebra.TensorProduct.includeRight (Algebra.TensorProduct.includeRight p.2)) =
          TensorProduct.tmul R₀ (1 : E₂) p.2 := by
        change Algebra.TensorProduct.cancelBaseChange R₀ κ₀ E₂ E₂ A₀
            (TensorProduct.tmul κ₀ (1 : E₂) (TensorProduct.tmul R₀ (1 : κ₀) p.2)) =
          TensorProduct.tmul R₀ (1 : E₂) p.2
        rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul]
      rw [hβ₂_a]
      change (TensorProduct.tmul R₀ p.1 (1 : A₀)) * (TensorProduct.tmul R₀ (1 : E₂) p.2) =
        TensorProduct.tmul R₀ p.1 p.2
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    refine ⟨β₂.injective ?_, β₂.injective ?_⟩
    · rw [hu_sum]
      dsimp [u₁]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl ?_
      intro p hp
      exact htmul p (Finset.mem_union_left _ (Finset.mem_image_of_mem Prod.fst hp))
    · rw [hv_sum]
      dsimp [v₁]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl ?_
      intro p hp
      exact htmul p (Finset.mem_union_right _ (Finset.mem_image_of_mem Prod.fst hp))
  obtain ⟨q₁, heA₁, hFlat₁, hFP₁, hcomm₁, hq₁, hSplit⟩ :=
    weil_split_fiber_node_of_etale_base_and_ext_witness
      R₀ A₀ R₁ E₂ D_K f₀ hFlat₀ hFP₀ q₀ m₀ eR₁ p₁ hp₁ φ_κ ψ₁_orig ψ₂ π₂ j₂ u_ext v_ext m₂
      u₁ v₁ hψ₁_orig hψ₂ hm₀_q₀ hXi hcomm_orig heR₁ hφ_map hcompat₂
      hm₂_ker hu_m₂ hv_m₂ hres_m₂ hloc_m₂ hτ_uv
  exact ⟨R₁, A₁, instR₁, inferInstance, eR₁, eA₁, f₁, q₁, u₁, v₁,
    heR₁, heA₁, hFlat₁, hFP₁, hcomm₁, hq₁, hSplit⟩

theorem weil_split_fiber_span_to_etale_ambient_surjection (R₁ A₁ : Type u) [CommRing R₁] [CommRing A₁] [Algebra R₁ A₁]
    (hFP₁ : (algebraMap R₁ A₁).FinitePresentation)
    (q₁ : PrimeSpectrum A₁)
    (u₁ v₁ : A₁)
    (hu₁ : u₁ ∈ q₁.asIdeal)
    (hv₁ : v₁ ∈ q₁.asIdeal)
    (m₁ : PrimeSpectrum
      (TensorProduct R₁ A₁ (PrimeSpectrum.comap (algebraMap R₁ A₁) q₁).asIdeal.ResidueField))
    (hm₁_comap : PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom m₁ = q₁)
    (hm₁_res :
      ∀ z : TensorProduct R₁ A₁ (PrimeSpectrum.comap (algebraMap R₁ A₁) q₁).asIdeal.ResidueField,
        ∃ c : (PrimeSpectrum.comap (algebraMap R₁ A₁) q₁).asIdeal.ResidueField,
          z - Algebra.TensorProduct.includeRight.toRingHom c ∈ m₁.asIdeal)
    (hSpan :
      Ideal.span
        {algebraMap
          (TensorProduct R₁ A₁ (PrimeSpectrum.comap (algebraMap R₁ A₁) q₁).asIdeal.ResidueField)
          (Localization.AtPrime m₁.asIdeal)
          (Algebra.TensorProduct.includeLeftRingHom u₁),
         algebraMap
          (TensorProduct R₁ A₁ (PrimeSpectrum.comap (algebraMap R₁ A₁) q₁).asIdeal.ResidueField)
          (Localization.AtPrime m₁.asIdeal)
          (Algebra.TensorProduct.includeLeftRingHom v₁)} =
      IsLocalRing.maximalIdeal (Localization.AtPrime m₁.asIdeal)) :
    ∃ (B₀ : Type u) (_ : CommRing B₀)
      (φ₀ : MvPolynomial (Fin 2) R₁ →+* B₀)
      (Q₀ : PrimeSpectrum B₀)
      (s_A : A₁)
      (q'₁ : PrimeSpectrum (Localization.Away s_A))
      (π₀ : B₀ →+* Localization.Away s_A),
      φ₀.Etale ∧
      s_A ∉ q₁.asIdeal ∧
      PrimeSpectrum.comap (algebraMap A₁ (Localization.Away s_A)) q'₁ = q₁ ∧
      PrimeSpectrum.comap π₀ q'₁ = Q₀ ∧
      Function.Surjective π₀ ∧
      (RingHom.ker π₀).FG ∧
      π₀.comp φ₀ = (algebraMap A₁ (Localization.Away s_A)).comp
        (MvPolynomial.aeval (R := R₁) ![u₁, v₁]).toRingHom :=
by
  let f₁ : R₁ →+* A₁ := algebraMap R₁ A₁
  let p₁ : PrimeSpectrum R₁ := PrimeSpectrum.comap (algebraMap R₁ A₁) q₁
  let κ₁ : Type u := p₁.asIdeal.ResidueField
  let F₁ : Type u := TensorProduct R₁ A₁ κ₁
  let toF₁ : A₁ →+* F₁ := Algebra.TensorProduct.includeLeftRingHom
  let toκ₁ : κ₁ →+* F₁ := Algebra.TensorProduct.includeRight.toRingHom
  let L₁ : Type u := Localization.AtPrime m₁.asIdeal
  let loc : F₁ →+* L₁ := algebraMap F₁ L₁
  have hm₁_as : m₁.asIdeal.comap toF₁ = q₁.asIdeal := congrArg PrimeSpectrum.asIdeal hm₁_comap
  
  have h_cross_F₁ : ∀ (r : R₁) (b : A₁),
      toκ₁ (algebraMap R₁ κ₁ r) * toF₁ b = toF₁ (f₁ r * b) := by
    intro r b
    change ((1 : A₁) ⊗ₜ[R₁] algebraMap R₁ κ₁ r) * (b ⊗ₜ[R₁] (1 : κ₁)) = (f₁ r * b) ⊗ₜ[R₁] (1 : κ₁)
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    have hr1 : f₁ r * b = r • b := (Algebra.smul_def r b).symm
    have hr2 : algebraMap R₁ κ₁ r = r • (1 : κ₁) := by rw [Algebra.smul_def, mul_one]
    rw [hr1, hr2, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
  have h_dc1 : ∀ z : F₁, ∃ (t : R₁) (b : A₁),
      t ∉ p₁.asIdeal ∧ toκ₁ (algebraMap R₁ κ₁ t) * z = toF₁ b := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, 0, p₁.isPrime.one_notMem, by simp⟩
    | tmul a c =>
      obtain ⟨q_c, rfl⟩ := IsLocalRing.residue_surjective c
      obtain ⟨⟨r_a, s⟩, hqs⟩ := IsLocalization.surj p₁.asIdeal.primeCompl q_c
      have hres := congrArg (IsLocalRing.residue (Localization.AtPrime p₁.asIdeal)) hqs
      rw [map_mul] at hres
      have h_alg : ∀ r : R₁,
          IsLocalRing.residue (Localization.AtPrime p₁.asIdeal)
            (algebraMap R₁ (Localization.AtPrime p₁.asIdeal) r) = algebraMap R₁ κ₁ r :=
        fun _ => rfl
      rw [h_alg s.1, h_alg r_a] at hres
      refine ⟨s.1, f₁ r_a * a, s.2, ?_⟩
      change ((1 : A₁) ⊗ₜ[R₁] algebraMap R₁ κ₁ s.1) * (a ⊗ₜ[R₁] _) = (f₁ r_a * a) ⊗ₜ[R₁] (1 : κ₁)
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm (algebraMap R₁ κ₁ s.1), hres]
      have hr1 : f₁ r_a * a = r_a • a := (Algebra.smul_def r_a a).symm
      have hr2 : algebraMap R₁ κ₁ r_a = r_a • (1 : κ₁) := by rw [Algebra.smul_def, mul_one]
      rw [hr1, hr2, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
    | add x y ihx ihy =>
      obtain ⟨t₁, b₁, ht₁, hx⟩ := ihx
      obtain ⟨t₂, b₂, ht₂, hy⟩ := ihy
      refine ⟨t₁ * t₂, f₁ t₂ * b₁ + f₁ t₁ * b₂, p₁.isPrime.mul_notMem ht₁ ht₂, ?_⟩
      calc
        toκ₁ (algebraMap R₁ κ₁ (t₁ * t₂)) * (x + y)
          = toκ₁ (algebraMap R₁ κ₁ t₂) * (toκ₁ (algebraMap R₁ κ₁ t₁) * x) +
            toκ₁ (algebraMap R₁ κ₁ t₁) * (toκ₁ (algebraMap R₁ κ₁ t₂) * y) := by
            simp only [map_mul]; ring
        _ = toκ₁ (algebraMap R₁ κ₁ t₂) * toF₁ b₁ + toκ₁ (algebraMap R₁ κ₁ t₁) * toF₁ b₂ := by
            rw [hx, hy]
        _ = toF₁ (f₁ t₂ * b₁ + f₁ t₁ * b₂) := by
            rw [h_cross_F₁, h_cross_F₁, map_add]
  have h_dc2 : ∀ x : A₁, toF₁ x = 0 →
      ∃ s'' : R₁, s'' ∉ p₁.asIdeal ∧ f₁ s'' * x ∈ Ideal.map f₁ p₁.asIdeal := by
    intro x hx
    let I_p₁ : Ideal A₁ := Ideal.map f₁ p₁.asIdeal
    let Q_A : Type u := A₁ ⧸ I_p₁
    let q_A : A₁ →+* Q_A := Ideal.Quotient.mk I_p₁
    let M_sub : Submonoid Q_A := Submonoid.map (q_A.comp f₁) p₁.asIdeal.primeCompl
    let Q_loc : Type u := Localization M_sub
    let φ_left : A₁ →+* Q_loc := (algebraMap Q_A Q_loc).comp q_A
    let φ_R : R₁ →+* Q_loc := φ_left.comp f₁
    have h_ker : p₁.asIdeal ≤ RingHom.ker φ_R := by
      intro r hr
      rw [RingHom.mem_ker]
      change algebraMap Q_A Q_loc (q_A (f₁ r)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem f₁ hr), map_zero]
    have h_unit : p₁.asIdeal.primeCompl ≤ Submonoid.comap φ_R (IsUnit.submonoid Q_loc) := by
      intro s hs
      rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      exact IsLocalization.map_units Q_loc ⟨q_A (f₁ s), Submonoid.mem_map_of_mem (q_A.comp f₁) hs⟩
    let φ_right : κ₁ →+* Q_loc := Ideal.ResidueField.lift p₁.asIdeal φ_R h_ker h_unit
    let : Algebra R₁ Q_loc := φ_R.toAlgebra
    let φ_left_alg : A₁ →ₐ[R₁] Q_loc := { toRingHom := φ_left, commutes' := fun _ => rfl }
    let φ_right_alg : κ₁ →ₐ[R₁] Q_loc :=
      { toRingHom := φ_right
        commutes' := fun r => Ideal.ResidueField.lift_algebraMap p₁.asIdeal φ_R h_ker h_unit r }
    let Φ_prod : F₁ →ₐ[R₁] Q_loc := Algebra.TensorProduct.productMap φ_left_alg φ_right_alg
    have hΦx : algebraMap Q_A Q_loc (q_A x) = 0 := by
      have hΦ_apply : Φ_prod (toF₁ x) = algebraMap Q_A Q_loc (q_A x) := by
        change (Algebra.TensorProduct.productMap φ_left_alg φ_right_alg)
          (x ⊗ₜ[R₁] (1 : κ₁)) = _
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        rfl
      rw [← hΦ_apply, hx, map_zero]
    obtain ⟨⟨_, s'', hs'', rfl⟩, hmul_zero⟩ :=
      (IsLocalization.map_eq_zero_iff M_sub Q_loc (q_A x)).mp hΦx
    refine ⟨s'', hs'', ?_⟩
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q_A (f₁ s'' * x) = 0
    rw [map_mul]
    exact hmul_zero
  have h_elem_lift : ∀ y : A₁, ∃ (s a : R₁) (w b₀ b₁ : A₁),
      s ∉ p₁.asIdeal ∧ w ∉ q₁.asIdeal ∧
      f₁ s * y - f₁ a ∈ q₁.asIdeal ∧
      w * (f₁ s * y - f₁ a) - b₀ * u₁ - b₁ * v₁ ∈ Ideal.map f₁ p₁.asIdeal := by
    intro y
    obtain ⟨c, hc⟩ := hm₁_res (toF₁ y)
    obtain ⟨q_c, rfl⟩ := IsLocalRing.residue_surjective c
    obtain ⟨⟨a, s⟩, hqs⟩ := IsLocalization.surj p₁.asIdeal.primeCompl q_c
    have hres := congrArg (IsLocalRing.residue (Localization.AtPrime p₁.asIdeal)) hqs
    rw [map_mul] at hres
    have h_alg : ∀ r : R₁,
        IsLocalRing.residue (Localization.AtPrime p₁.asIdeal)
          (algebraMap R₁ (Localization.AtPrime p₁.asIdeal) r) = algebraMap R₁ κ₁ r :=
      fun _ => rfl
    rw [h_alg s.1, h_alg a] at hres
    let y₀ : A₁ := f₁ s.1 * y - f₁ a
    have hy₀_F₁ : toF₁ y₀ ∈ m₁.asIdeal := by
      have hm_mul : toκ₁ (algebraMap R₁ κ₁ s.1) * (toF₁ y - toκ₁ _) ∈ m₁.asIdeal :=
        Ideal.mul_mem_left _ _ hc
      have heq : toκ₁ (algebraMap R₁ κ₁ s.1) *
          (toF₁ y - toκ₁ (IsLocalRing.residue (Localization.AtPrime p₁.asIdeal) q_c)) =
          toF₁ y₀ := by
        rw [mul_sub, h_cross_F₁, ← map_mul toκ₁, mul_comm (algebraMap R₁ κ₁ s.1), hres]
        have ha_eq : toκ₁ (algebraMap R₁ κ₁ a) = toF₁ (f₁ a) := by
          have h1 := h_cross_F₁ a 1
          rw [map_one, mul_one, mul_one] at h1
          exact h1
        rw [ha_eq, ← map_sub]
      rwa [heq] at hm_mul
    have hy₀_q₁ : y₀ ∈ q₁.asIdeal := by
      rw [← hm₁_as]
      exact hy₀_F₁
    have hy₀_max : loc (toF₁ y₀) ∈ IsLocalRing.maximalIdeal L₁ :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff L₁ m₁.asIdeal (toF₁ y₀)).mpr hy₀_F₁
    rw [← hSpan, Ideal.mem_span_pair] at hy₀_max
    obtain ⟨l₀, l₁, hl₀₁⟩ := hy₀_max
    obtain ⟨⟨n₀, d₀⟩, hd₀⟩ := IsLocalization.surj m₁.asIdeal.primeCompl l₀
    obtain ⟨⟨n₁, d₁⟩, hd₁⟩ := IsLocalization.surj m₁.asIdeal.primeCompl l₁
    have hloc_eq : loc (d₀.1 * d₁.1 * toF₁ y₀) =
        loc (d₁.1 * n₀ * toF₁ u₁ + d₀.1 * n₁ * toF₁ v₁) := by
      simp only [map_mul, map_add]
      calc
        (loc d₀.1 * loc d₁.1) * loc (toF₁ y₀)
          = (loc d₀.1 * loc d₁.1) * (l₀ * loc (toF₁ u₁) + l₁ * loc (toF₁ v₁)) := by rw [hl₀₁]
        _ = loc d₁.1 * (l₀ * loc d₀.1) * loc (toF₁ u₁) +
            loc d₀.1 * (l₁ * loc d₁.1) * loc (toF₁ v₁) := by ring
        _ = loc d₁.1 * loc n₀ * loc (toF₁ u₁) + loc d₀.1 * loc n₁ * loc (toF₁ v₁) := by
            rw [hd₀, hd₁]
    obtain ⟨d₂, hd₂_eq⟩ := (IsLocalization.eq_iff_exists m₁.asIdeal.primeCompl L₁).mp hloc_eq
    let d_F : F₁ := d₂.1 * (d₀.1 * d₁.1)
    let z₀ : F₁ := d₂.1 * (d₁.1 * n₀)
    let z₁ : F₁ := d₂.1 * (d₀.1 * n₁)
    have hd_F : d_F ∉ m₁.asIdeal :=
      m₁.isPrime.mul_notMem d₂.2 (m₁.isPrime.mul_notMem d₀.2 d₁.2)
    have hF_eq : d_F * toF₁ y₀ = z₀ * toF₁ u₁ + z₁ * toF₁ v₁ := by
      calc
        d_F * toF₁ y₀ = d₂.1 * (d₀.1 * d₁.1 * toF₁ y₀) := mul_assoc d₂.1 (d₀.1 * d₁.1) (toF₁ y₀)
        _ = d₂.1 * (d₁.1 * n₀ * toF₁ u₁ + d₀.1 * n₁ * toF₁ v₁) := hd₂_eq
        _ = d₂.1 * (d₁.1 * n₀ * toF₁ u₁) + d₂.1 * (d₀.1 * n₁ * toF₁ v₁) := mul_add _ _ _
        _ = z₀ * toF₁ u₁ + z₁ * toF₁ v₁ := by
          rw [← mul_assoc d₂.1 (d₁.1 * n₀) (toF₁ u₁), ← mul_assoc d₂.1 (d₀.1 * n₁) (toF₁ v₁)]
    obtain ⟨t_d, w₀, ht_d, hw₀_eq⟩ := h_dc1 d_F
    obtain ⟨t₀, b'₀, ht₀, hb'₀_eq⟩ := h_dc1 z₀
    obtain ⟨t₁, b'₁, ht₁, hb'₁_eq⟩ := h_dc1 z₁
    have hw₀_not : w₀ ∉ q₁.asIdeal := by
      intro hw₀_in
      apply hd_F
      have ht_d_ne : algebraMap R₁ κ₁ t_d ≠ 0 :=
        mt Ideal.algebraMap_residueField_eq_zero.mp ht_d
      have hu_td : IsUnit (toκ₁ (algebraMap R₁ κ₁ t_d)) := (IsUnit.mk0 _ ht_d_ne).map toκ₁
      obtain ⟨u_inv, hu_inv⟩ := hu_td.exists_left_inv
      have hd_eq : d_F = u_inv * toF₁ w₀ := by
        calc
          d_F = 1 * d_F := (one_mul _).symm
          _ = (u_inv * toκ₁ (algebraMap R₁ κ₁ t_d)) * d_F := by rw [hu_inv]
          _ = u_inv * (toκ₁ (algebraMap R₁ κ₁ t_d) * d_F) := by ring
          _ = u_inv * toF₁ w₀ := by rw [hw₀_eq]
      rw [hd_eq]
      apply Ideal.mul_mem_left
      rw [← Ideal.mem_comap, hm₁_as]
      exact hw₀_in
    have h_toF₁_zero :
        toF₁ ((f₁ (t₀ * t₁) * w₀) * y₀ - (f₁ (t_d * t₁) * b'₀) * u₁ -
          (f₁ (t_d * t₀) * b'₁) * v₁) = 0 := by
