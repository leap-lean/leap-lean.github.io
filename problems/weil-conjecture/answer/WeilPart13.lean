  let toD_K : K →+* D_K := ψ₁.comp (algebraMap K (TensorProduct κ₀ K F₀))
  letI : Algebra K D_K := toD_K.toAlgebra
  let I_node : Ideal (MvPolynomial (Fin 2) K) :=
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) * MvPolynomial.X 1}
  let N_K := MvPolynomial (Fin 2) K ⧸ I_node
  let I_max : Ideal N_K :=
    Ideal.span {Ideal.Quotient.mk I_node (MvPolynomial.X 0),
