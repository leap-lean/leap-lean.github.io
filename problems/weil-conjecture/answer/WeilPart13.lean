      weil_nc2d_birational_morphism_blowup_factorization Ω n
        (W_seq (Fin.last (k' + 1))) C₂
        (g_seq (Fin.last (k' + 1))) (τ_seq (Fin.last (k' + 1))) g₂ τ₂
        α_top h hTop hNC₂ hα_snd hh_g hh_sec hh_gen
        hNorm
        (weil_nc2d_single_closed_point_blowup Ω n)
        (weil_nc2d_morphism_of_nonclosed_component_centers Ω n)
    exact weil_nc2d_minimal_blowup_step_to_subthree_rational_component Ω n
      (W_seq i_prev.castSucc) (W_seq (Fin.last (k' + 1))) C₂
      (g_seq i_prev.castSucc) (τ_seq i_prev.castSucc)
      (g_seq (Fin.last (k' + 1))) (τ_seq (Fin.last (k' + 1)))
      g₂ τ₂ (centers i_prev) (maps i_prev) α_top h
      ℓ Y_seq gY_seq τY_seq centersY mapsY ρ_from h_ℓ
      hPrev hLast hNC₂ hRed₂ hIntP1 hα_snd hh_g hh_sec hh_gen
      hNotFactor hTowerY hhℓ_g hhℓ_ρ hhℓ_sec

theorem weil_powerSeries_node_resolution_pointed_iso_descent (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C₁' C₂' C₁_res C₂_res : AlgebraicGeometry.Scheme.{u})
    (g₁' : C₁' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₁' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₁'))
    (g₂' : C₂' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₂' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₂'))
    (g₁_res : C₁_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₁_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₁_res))
    (q₁_res : C₁_res ⟶ C₁')
    (g₂_res : C₂_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₂_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₂_res))
    (q₂_res : C₂_res ⟶ C₂')
    (hRes₁ : IsPowerSeriesNodeResolution Ω n g₁' τ₁' g₁_res τ₁_res q₁_res)
    (hRes₂ : IsPowerSeriesNodeResolution Ω n g₂' τ₂' g₂_res τ₂_res q₂_res)
    (hInt₁ : AlgebraicGeometry.IsIntegral C₁')
    (hProp₂ : AlgebraicGeometry.IsProper g₂')
    (φ_K' : CategoryTheory.Limits.pullback g₁'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g₂'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hφK'_snd : φ_K'.hom ≫ CategoryTheory.Limits.pullback.snd g₂'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g₁'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hφK'_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
          CategoryTheory.Limits.pullback g₁'
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁'
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ₁' j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁'
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
        (s₁ ≫ φ_K'.hom) ≫ CategoryTheory.Limits.pullback.fst g₂'
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ₂' j)
    (hBirat : ∀ (X₁ X₂ : AlgebraicGeometry.Scheme.{u})
      (f₁ : X₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (σ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ X₁))
      (f₂ : X₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (σ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ X₂)),
      IsRegularSimpleNodalSurface Ω n f₁ σ₁ →
      IsRegularSimpleNodalSurface Ω n f₂ σ₂ →
      let η_K := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
      ∀ (ψ_K : CategoryTheory.Limits.pullback f₁ η_K ≅
          CategoryTheory.Limits.pullback f₂ η_K),
        ψ_K.hom ≫ CategoryTheory.Limits.pullback.snd f₂ η_K =
          CategoryTheory.Limits.pullback.snd f₁ η_K →
        (∀ j : Fin n,
          ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
              CategoryTheory.Limits.pullback f₁ η_K),
            s₁ ≫ CategoryTheory.Limits.pullback.fst f₁ η_K = η_K ≫ σ₁ j →
            s₁ ≫ CategoryTheory.Limits.pullback.snd f₁ η_K =
