        (∃ h : X₁ ⟶ X₂,
          h ≫ f₂ = f₁ ∧
          CategoryTheory.Limits.pullback.fst f₁ η_K ≫ h =
            ψ_K.hom ≫ CategoryTheory.Limits.pullback.fst f₂ η_K) ∨
        (let s_Ω := AlgebraicGeometry.Spec.map
           (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
         ∃ (F₀ : Set ↥(CategoryTheory.Limits.pullback f₂ s_Ω))
           (F_sch : AlgebraicGeometry.Scheme.{u})
           (ιF : F_sch ⟶ CategoryTheory.Limits.pullback f₂ s_Ω)
           (isoP1 : F_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
           F₀ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₂ s_Ω) ∧
           AlgebraicGeometry.IsClosedImmersion ιF ∧
           AlgebraicGeometry.IsIntegral F_sch ∧
           Set.range ιF.base = F₀ ∧
           ιF ≫ CategoryTheory.Limits.pullback.snd f₂ s_Ω =
             isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom ∧
           {q : ↥(CategoryTheory.Limits.pullback f₂ s_Ω) |
             q ∈ F₀ ∧
             ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₂ s_Ω),
               E' ≠ F₀ ∧ q ∈ E'}.Subsingleton ∧
           ∃ p₁ p₂ : ↥(CategoryTheory.Limits.pullback f₂ s_Ω),
             ∀ q ∈ F₀,
               ((∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₂ s_Ω),
                   E' ≠ F₀ ∧ q ∈ E') ∨
