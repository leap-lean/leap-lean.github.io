      simp only [Category.assoc]
      rw [CategoryTheory.Limits.pullback.condition (f := (O c a).ι) (g := (O c b).ι)]
      rw [← Category.assoc (t'_fn b c a), CategoryTheory.Limits.pullback.lift_snd]
