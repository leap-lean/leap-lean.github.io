theorem weil_powerSeries_regular_nodal_morphism_or_subthree_rational_component (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₂))
    (hSurf₁ : IsRegularSimpleNodalSurface Ω n g₁ τ₁)
    (hSurf₂ : IsRegularSimpleNodalSurface Ω n g₂ τ₂)
    (ψ_K : CategoryTheory.Limits.pullback g₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hψK_snd : ψ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hψK_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
          CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
        (s₁ ≫ ψ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ₂ j) :
    (let η_K := AlgebraicGeometry.Spec.map
       (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
     ∃ h : C₁ ⟶ C₂,
       h ≫ g₂ = g₁ ∧
       CategoryTheory.Limits.pullback.fst g₁ η_K ≫ h =
