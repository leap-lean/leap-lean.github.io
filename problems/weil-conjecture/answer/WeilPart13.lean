        ((Fin 2 → D) ⧸ Submodule.span D {fun i : Fin 2 => if i = 0 then x₁ else x₀})) := by
    let ev₀ : MvPolynomial (Fin 2) K →ₐ[K] K := MvPolynomial.aeval (fun _ : Fin 2 => (0 : K))
    have hInode_ker : I_node ≤ RingHom.ker ev₀.toRingHom := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      change ev₀ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [map_mul, MvPolynomial.aeval_X, zero_mul]
    let ev₀_bar : N_K →ₐ[K] K := Ideal.Quotient.liftₐ I_node ev₀ (fun _ hx => hInode_ker hx)
    have hev₀_surj : Function.Surjective ev₀_bar.toRingHom := by
      intro c
      refine ⟨Ideal.Quotient.mk I_node (MvPolynomial.C c), ?_⟩
      change ev₀ (MvPolynomial.C c) = c
      exact MvPolynomial.aeval_C _ c
    have hf_sub : ∀ f : MvPolynomial (Fin 2) K,
