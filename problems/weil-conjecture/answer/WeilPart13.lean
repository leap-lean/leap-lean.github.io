          = (AlgebraicGeometry.Spec.map φ).base '' Set.univ := Set.image_univ.symm
        _ = (AlgebraicGeometry.Spec.map φ).base '' closure ({η_B} : Set ↥(AlgebraicGeometry.Spec B)) := by
            rw [hcl_B]
        _ ⊆ closure ((AlgebraicGeometry.Spec.map φ).base '' ({η_B} : Set ↥(AlgebraicGeometry.Spec B))) :=
            image_closure_subset_closure_image (AlgebraicGeometry.Spec.map φ).base.hom.continuous
        _ = closure ({(AlgebraicGeometry.Spec.map φ).base η_B} : Set ↥(AlgebraicGeometry.Spec A)) := by
            rw [Set.image_singleton]
    have hηA_in : η_A ∈
        closure ({(AlgebraicGeometry.Spec.map φ).base η_B} : Set ↥(AlgebraicGeometry.Spec A)) := by
      have h_univ : closure ({(AlgebraicGeometry.Spec.map φ).base η_B} : Set ↥(AlgebraicGeometry.Spec A)) =
          Set.univ :=
        Set.eq_univ_of_univ_subset
