      · change (ev₀₁ P).coeff 1 = 0; rw [hg01]; exact h_coeff_X3 g01 1 (by omega)
      · change (ev₁₀ P).coeff 2 = 0; rw [hg10]; exact h_coeff_X3 g10 2 (by omega)
      · change (ev₀₁ P).coeff 2 = 0; rw [hg01]; exact h_coeff_X3 g01 2 (by omega)
