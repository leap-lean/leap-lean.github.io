    have h_sub_U₂ : Set.range ⇑((U_Wa.ι ≫ W_a.ι) ≫ ψ₃.left) ⊆ Set.range ⇑U₂.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
