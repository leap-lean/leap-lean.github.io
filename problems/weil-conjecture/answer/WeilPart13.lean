    choose Z hZ_mem hZ_eq using
      fun j : Fin r => h_surj_map (Ideal.map c_R p₁.asIdeal) _ (hrel_map j)
    choose W hW_eq using fun j : Fin r => hPhi_surj (w j)
    choose B₀_poly hB₀_eq using fun j : Fin r => hPhi_surj (b₀ j)
    choose B₁_poly hB₁_eq using fun j : Fin r => hPhi_surj (b₁ j)
    let G : Fin r → MvPolynomial (Fin r) P := fun j =>
