          rfl }
    have h_barA : ∀ a ∈ I, toBJ a = 0 := by
      intro a ha
      change Ideal.Quotient.mk J
        ((γ.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) a) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hIJ]
      exact Ideal.mem_map_of_mem _ ha
    let barA : A ⧸ I →ₐ[E₁] B ⧸ J := Ideal.Quotient.liftₐ I toBJ h_barA
    let fK : K →ₐ[E₁] B ⧸ J :=
      { toRingHom := algebraMap K (B ⧸ J)
        commutes' := fun _ => rfl }
    let fwd_E₁ : TensorProduct E₁ K (A ⧸ I) →ₐ[E₁] B ⧸ J :=
      Algebra.TensorProduct.lift fK barA (fun _ _ => mul_comm _ _)
    have hfwd_tmul : ∀ (k : K) (x : A ⧸ I), fwd_E₁ (TensorProduct.tmul E₁ k x) = fK k * barA x :=
      fun k x => Algebra.TensorProduct.lift_tmul _ _ _ k x
    let fwd : TensorProduct E₁ K (A ⧸ I) →ₐ[K] B ⧸ J :=
      { fwd_E₁.toRingHom with
        commutes' := fun k => by
          change fwd_E₁ (TensorProduct.tmul E₁ k 1) = algebraMap K (B ⧸ J) k
          rw [hfwd_tmul, map_one, mul_one]
          rfl }
    let qMap_E₁ : TensorProduct E₁ K A →ₐ[E₁] TensorProduct E₁ K (A ⧸ I) :=
      Algebra.TensorProduct.map (AlgHom.id E₁ K) mkI
    have hqMap_tmul : ∀ (k : K) (a : A),
        qMap_E₁ (TensorProduct.tmul E₁ k a) = TensorProduct.tmul E₁ k (mkI a) :=
      fun k a => Algebra.TensorProduct.map_tmul _ _ k a
    let qMap : TensorProduct E₁ K A →ₐ[K] TensorProduct E₁ K (A ⧸ I) :=
      { qMap_E₁.toRingHom with
        commutes' := fun k => by
          change qMap_E₁ (TensorProduct.tmul E₁ k 1) = TensorProduct.tmul E₁ k 1
          rw [hqMap_tmul, map_one] }
    let gB : B →ₐ[K] TensorProduct E₁ K (A ⧸ I) := qMap.comp γ.symm.toAlgHom
    have h_bwd : ∀ b ∈ J, gB b = 0 := by
      have hle : J ≤ RingHom.ker gB.toRingHom := by
        rw [← hIJ, Ideal.map_le_iff_le_comap]
        intro a ha
        change qMap (γ.symm (γ (TensorProduct.tmul E₁ 1 a))) = 0
        rw [γ.symm_apply_apply]
        change TensorProduct.tmul E₁ (1 : K) (Ideal.Quotient.mk I a) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, TensorProduct.tmul_zero]
      intro b hb
      exact hle hb
    let bwd : (B ⧸ J) →ₐ[K] TensorProduct E₁ K (A ⧸ I) := Ideal.Quotient.liftₐ J gB h_bwd
    have h_tmul : ∀ (k : K) (a : A),
        fwd (TensorProduct.tmul E₁ k (mkI a)) = mkJ (γ (TensorProduct.tmul E₁ k a)) := by
      intro k a
      change fwd_E₁ (TensorProduct.tmul E₁ k (mkI a)) = mkJ (γ (TensorProduct.tmul E₁ k a))
      rw [hfwd_tmul]
      have hk : TensorProduct.tmul E₁ k a = algebraMap K (TensorProduct E₁ K A) k *
          TensorProduct.tmul E₁ 1 a := by
        change TensorProduct.tmul E₁ k a = TensorProduct.tmul E₁ k 1 * TensorProduct.tmul E₁ 1 a
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hk, map_mul, γ.commutes, map_mul]
      rfl
    refine AlgEquiv.ofAlgHom fwd bwd ?_ ?_
    · apply AlgHom.ext
      intro x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hb : b = γ (γ.symm b) := (γ.apply_symm_apply b).symm
      change fwd (bwd (mkJ b)) = mkJ b
      rw [hb]
      generalize γ.symm b = w
      induction w using TensorProduct.induction_on
      · rw [map_zero, map_zero, map_zero, map_zero]
      · rename_i k a
        change fwd (qMap (γ.symm (γ (TensorProduct.tmul E₁ k a)))) =
          mkJ (γ (TensorProduct.tmul E₁ k a))
        rw [γ.symm_apply_apply]
