      rw [hw₀_c₁]; exact hc₁_V
    have hw₁_W : w₁ ∈ W_TB := by
      change π.left.base w₁ ∈ V_CB
      rw [hw₁_c₁]; exact hc₁_V
    have h_res_ι := AlgebraicGeometry.morphismRestrict_ι π.left V_CB
    have h_pt0 := congrArg (fun g => g.base ⟨w₀, hw₀_W⟩) h_res_ι
    have h_pt1 := congrArg (fun g => g.base ⟨w₁, hw₁_W⟩) h_res_ι
    change V_CB.ι.base ((π.left ∣_ V_CB).base ⟨w₀, hw₀_W⟩) = π.left.base w₀ at h_pt0
    change V_CB.ι.base ((π.left ∣_ V_CB).base ⟨w₁, hw₁_W⟩) = π.left.base w₁ at h_pt1
    have h_val_eq : V_CB.ι.base ((π.left ∣_ V_CB).base ⟨w₀, hw₀_W⟩) =
        V_CB.ι.base ((π.left ∣_ V_CB).base ⟨w₁, hw₁_W⟩) := by
      rw [h_pt0, h_pt1, hw₀_c₁, hw₁_c₁]
    have h_res_eq : (π.left ∣_ V_CB).base ⟨w₀, hw₀_W⟩ = (π.left ∣_ V_CB).base ⟨w₁, hw₁_W⟩ :=
      Subtype.ext h_val_eq
    let e_iso : ↥W_TB ≃ₜ ↥V_CB :=
