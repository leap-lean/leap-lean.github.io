      [AlgebraicGeometry.SmoothOfRelativeDimension 1 π] [ConnectedSpace ↥F],
      True ∧ IrreducibleSpace ↥F := by
    intro K _ F π _ _
    refine ⟨trivial, ?_⟩
    have hLocalPre : ∀ z : ↥F, ∃ U_z : Set ↥F, IsOpen U_z ∧ z ∈ U_z ∧ IsPreirreducible U_z := by
      intro z
      obtain ⟨U₀, _hU₀, V_z, hVz, hz, e_z, hf₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 π).mp inferInstance z
      have hU₀_top : U₀ = ⊤ := by
        ext p
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hp_eq : p = π.base z := Subsingleton.elim p (π.base z)
        rw [hp_eq]
        exact e_z hz
      let iso_K : (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀) ≅
          CommRingCat.of K :=
        (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.mapIso
          (eqToIso (congrArg Opposite.op hU₀_top)) ≪≫
          AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)
      let e_K := iso_K.commRingCatIsoToRingEquiv
      have hIsFieldR₀ : IsField
          ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)) :=
        { exists_pair_ne := ⟨e_K.symm 0, e_K.symm 1,
            fun h => zero_ne_one (e_K.symm.injective h)⟩
          mul_comm := mul_comm
          mul_inv_cancel := fun {a} ha => ⟨e_K.symm (e_K a)⁻¹, by
            apply e_K.injective
            rw [map_mul, e_K.apply_symm_apply, map_one]
            exact mul_inv_cancel₀
              (fun h0 => ha (e_K.injective (h0.trans (map_zero e_K).symm)))⟩ }
      letI : Field ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)) :=
        hIsFieldR₀.toField
      obtain ⟨g_mv, _hg_comp, hg_mv⟩ := hf₀.exists_etale_mvPolynomial
      let e_poly :=
        (MvPolynomial.uniqueAlgEquiv
          ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀))
          (Fin 1)).symm.toRingEquiv
      letI : Algebra
          (MvPolynomial (Fin 1)
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z)) := g_mv.toAlgebra
      haveI : Algebra.Etale
          (MvPolynomial (Fin 1)
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z)) := hg_mv.toAlgebra
      letI : Algebra
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          (MvPolynomial (Fin 1)
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀))) :=
        e_poly.toRingHom.toAlgebra
      haveI : Algebra.Etale
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          (MvPolynomial (Fin 1)
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀))) :=
        (RingHom.Etale.of_bijective e_poly.bijective).toAlgebra
      letI : Algebra
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z)) :=
        (g_mv.comp e_poly.toRingHom).toAlgebra
      haveI : IsScalarTower
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          (MvPolynomial (Fin 1)
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z)) :=
        IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.Etale
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z)) :=
        Algebra.Etale.comp
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          (MvPolynomial (Fin 1)
            ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z))
