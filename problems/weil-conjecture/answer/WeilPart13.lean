      intro a b c
      rw [← cancel_mono (O a b).ι, Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      exact AlgebraicGeometry.IsOpenImmersion.lift_fac (O a b ⊓ O a c).ι
