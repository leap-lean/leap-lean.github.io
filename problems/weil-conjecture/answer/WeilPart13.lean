        rwa [AlgebraicGeometry.Spec.map_preimage]
      let _ : Algebra RStar R_W := (AlgebraicGeometry.Spec.preimage (ι_W ≫ g_W)).hom.toAlgebra
      have : Algebra.FiniteType RStar R_W :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hLFT'
