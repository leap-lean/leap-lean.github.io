    let V_cot : Submodule E₁ Q₁ := LinearMap.ker eps1_bar.toLinearMap
    have hRank_Vcot : Module.finrank E₁ ↥V_cot = 2 := by
      have hrng : LinearMap.range eps1_bar.toLinearMap = ⊤ := by
        rw [Submodule.eq_top_iff']
        intro c
        exact ⟨algebraMap E₁ Q₁ c, eps1_bar.commutes c⟩
      have hsum := LinearMap.finrank_range_add_finrank_ker eps1_bar.toLinearMap
      rw [hrng, _root_.finrank_top, Module.finrank_self, hRank_Q₁] at hsum
      change 1 + Module.finrank E₁ ↥V_cot = 3 at hsum
      omega
    let b_cot : Module.Basis (Fin 2) E₁ ↥V_cot :=
      Module.finBasisOfFinrankEq E₁ ↥V_cot hRank_Vcot
    have hSurj_qmk : Function.Surjective (fun z : TensorProduct κ₀ E₁ F₀ => q_mk (mk₁ z)) :=
      (Ideal.Quotient.mk_surjective).comp (Ideal.Quotient.mk_surjective)
    obtain ⟨u₀, hu₀_q⟩ := hSurj_qmk (b_cot 0).1
    obtain ⟨v₀, hv₀_q⟩ := hSurj_qmk (b_cot 1).1
    dsimp only at hu₀_q hv₀_q
    have hu₀_m₁ : u₀ ∈ m₁ := by
      have h0 : eps1_bar (q_mk (mk₁ u₀)) = 0 := by
        rw [hu₀_q]
        exact (b_cot 0).2
      exact h0
    have hv₀_m₁ : v₀ ∈ m₁ := by
      have h0 : eps1_bar (q_mk (mk₁ v₀)) = 0 := by
        rw [hv₀_q]
        exact (b_cot 1).2
      exact h0
    let proj_Q₁ : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] Q₁ :=
      q_mk.toLinearMap.comp mk₁.toLinearMap -
        (Algebra.linearMap E₁ Q₁).comp ρ₁.toLinearMap
    have hproj_mem : ∀ z : TensorProduct κ₀ E₁ F₀, proj_Q₁ z ∈ V_cot := by
      intro z
      change eps1_bar (q_mk (mk₁ z) - algebraMap E₁ Q₁ (ρ₁ z)) = 0
      rw [map_sub, eps1_bar.commutes]
      change ρ₁ z - ρ₁ z = 0
      exact sub_self _
    let proj_cot : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] ↥V_cot :=
      LinearMap.codRestrict V_cot proj_Q₁ hproj_mem
    let l₀ : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁ := (b_cot.coord 0).comp proj_cot
    let l₁ : TensorProduct κ₀ E₁ F₀ →ₗ[E₁] E₁ := (b_cot.coord 1).comp proj_cot
    have hproj_u₀ : proj_cot u₀ = b_cot 0 := by
      ext
      change q_mk (mk₁ u₀) - algebraMap E₁ Q₁ (ρ₁ u₀) = (b_cot 0).1
      have hρ0 : ρ₁ u₀ = 0 := hu₀_m₁
      rw [hu₀_q, hρ0, RingHom.map_zero, sub_zero]
    have hproj_v₀ : proj_cot v₀ = b_cot 1 := by
      ext
      change q_mk (mk₁ v₀) - algebraMap E₁ Q₁ (ρ₁ v₀) = (b_cot 1).1
      have hρ0 : ρ₁ v₀ = 0 := hv₀_m₁
      rw [hv₀_q, hρ0, RingHom.map_zero, sub_zero]
    have hl₀u : l₀ u₀ = 1 := by
      change b_cot.coord 0 (proj_cot u₀) = 1
      rw [hproj_u₀, Module.Basis.coord_apply, b_cot.repr_self]
      simp
    have hl₀v : l₀ v₀ = 0 := by
      change b_cot.coord 0 (proj_cot v₀) = 0
      rw [hproj_v₀, Module.Basis.coord_apply, b_cot.repr_self]
      simp
    have hl₁u : l₁ u₀ = 0 := by
      change b_cot.coord 1 (proj_cot u₀) = 0
      rw [hproj_u₀, Module.Basis.coord_apply, b_cot.repr_self]
      simp
    have hl₁v : l₁ v₀ = 1 := by
      change b_cot.coord 1 (proj_cot v₀) = 1
      rw [hproj_v₀, Module.Basis.coord_apply, b_cot.repr_self]
      simp
    have h_mk₁_sq_iff : ∀ z : TensorProduct κ₀ E₁ F₀, mk₁ z ∈ m1_bar ^ 2 ↔ z ∈ m₁ ^ 2 := by
      intro z
      rw [hm1_bar_eq_map, ← Ideal.map_pow]
      constructor
      · intro hz
        have hcomap : z ∈ Ideal.comap mk₁.toRingHom (Ideal.map mk₁.toRingHom (m₁ ^ 2)) := hz
        rw [Ideal.comap_map_of_surjective mk₁.toRingHom Ideal.Quotient.mk_surjective] at hcomap
        change z ∈ m₁ ^ 2 ⊔ RingHom.ker mk₁.toRingHom at hcomap
        have hker : RingHom.ker mk₁.toRingHom = m₁ ^ 3 := Ideal.mk_ker
        rw [hker] at hcomap
        have hsup : m₁ ^ 2 ⊔ m₁ ^ 3 = m₁ ^ 2 :=
          sup_eq_left.mpr (Ideal.pow_le_pow_right (by norm_num : 2 ≤ 3))
        rwa [hsup] at hcomap
      · intro hz
        exact Ideal.mem_map_of_mem _ hz
    have hl_sq : ∀ w ∈ m₁ ^ 2, l₀ w = 0 ∧ l₁ w = 0 := by
      intro w hw
      have hw_m₁ : w ∈ m₁ := Ideal.pow_le_self (by norm_num : 2 ≠ 0) hw
      have hw_ρ : ρ₁ w = 0 := hw_m₁
      have hw_q : q_mk (mk₁ w) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr ((h_mk₁_sq_iff w).mpr hw)
      have hp0 : proj_cot w = 0 := by
        ext
        change q_mk (mk₁ w) - algebraMap E₁ Q₁ (ρ₁ w) = 0
        rw [hw_q, hw_ρ, map_zero, sub_self]
      refine ⟨?_, ?_⟩
      · change b_cot.coord 0 (proj_cot w) = 0; rw [hp0, map_zero]
      · change b_cot.coord 1 (proj_cot w) = 0; rw [hp0, map_zero]
    have hdecomp_m₁ : ∀ z ∈ m₁, z - (l₀ z • u₀ + l₁ z • v₀) ∈ m₁ ^ 2 := by
      intro z hz
      rw [← h_mk₁_sq_iff, ← Ideal.Quotient.eq_zero_iff_mem]
      have hz_ρ : ρ₁ z = 0 := hz
      have hrepr := b_cot.sum_repr (proj_cot z)
      rw [Fin.sum_univ_two] at hrepr
      have hval := congr_arg Subtype.val hrepr
      change (b_cot.repr (proj_cot z) 0) • (b_cot 0).1 +
          (b_cot.repr (proj_cot z) 1) • (b_cot 1).1 =
        q_mk (mk₁ z) - algebraMap E₁ Q₁ (ρ₁ z) at hval
      rw [hz_ρ, RingHom.map_zero, sub_zero, ← hu₀_q, ← hv₀_q] at hval
      change q_mk (mk₁ (z - (l₀ z • u₀ + l₁ z • v₀))) = 0
      simp only [map_sub, map_add, map_smul]
      change q_mk (mk₁ z) -
        ((b_cot.repr (proj_cot z) 0) • q_mk (mk₁ u₀) +
          (b_cot.repr (proj_cot z) 1) • q_mk (mk₁ v₀)) = 0
      rw [hval, sub_self]
    have hSpan₁ : m₁ ≤ Ideal.span {u₀, v₀} ⊔ m₁ ^ 2 := by
      intro z hz
      have hr := hdecomp_m₁ z hz
      have hz_eq : z = (l₀ z • u₀ + l₁ z • v₀) + (z - (l₀ z • u₀ + l₁ z • v₀)) := by abel
      rw [hz_eq]
      refine Submodule.add_mem_sup ?_ hr
      have hu_s : u₀ ∈ Ideal.span {u₀, v₀} := Ideal.subset_span (Set.mem_insert _ _)
      have hv_s : v₀ ∈ Ideal.span {u₀, v₀} :=
        Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      rw [Algebra.smul_def, Algebra.smul_def]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu_s) (Ideal.mul_mem_left _ _ hv_s)
    let u0_bar : T₁ := mk₁ u₀
    let v0_bar : T₁ := mk₁ v₀
    have hu0_bar_mem : u0_bar ∈ m1_bar := by rw [hm1_bar_eq_map]; exact Ideal.mem_map_of_mem _ hu₀_m₁
    have hv0_bar_mem : v0_bar ∈ m1_bar := by rw [hm1_bar_eq_map]; exact Ideal.mem_map_of_mem _ hv₀_m₁
    have hquad_mem : ∀ c : Fin 3 → E₁,
        c 0 • u0_bar ^ 2 + c 1 • (u0_bar * v0_bar) + c 2 • v0_bar ^ 2 ∈ m1_bar_sq_E₁ := by
      intro c
      rw [Submodule.restrictScalars_mem]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
      · rw [Algebra.smul_def]; exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hu0_bar_mem 2)
      · rw [Algebra.smul_def, sq]; exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul hu0_bar_mem hv0_bar_mem)
      · rw [Algebra.smul_def]; exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hv0_bar_mem 2)
    let μ₂_raw : (Fin 3 → E₁) →ₗ[E₁] T₁ :=
      { toFun := fun c => c 0 • u0_bar ^ 2 + c 1 • (u0_bar * v0_bar) + c 2 • v0_bar ^ 2
        map_add' := fun a b => by simp only [Pi.add_apply, add_smul]; abel
        map_smul' := fun r a => by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply,
          mul_smul, smul_add] }
    let μ₂ : (Fin 3 → E₁) →ₗ[E₁] ↥m1_bar_sq_E₁ := LinearMap.codRestrict m1_bar_sq_E₁ μ₂_raw hquad_mem
    have hker_pos : 0 < Module.finrank E₁ ↥(LinearMap.ker μ₂) := by
      have hsum := LinearMap.finrank_range_add_finrank_ker μ₂
      have hle := Submodule.finrank_le (LinearMap.range μ₂)
      rw [Module.finrank_fin_fun] at hsum
      rw [hRank_m1_bar_sq] at hle
      omega
    haveI : Nontrivial ↥(LinearMap.ker μ₂) := Module.nontrivial_of_finrank_pos hker_pos
    obtain ⟨⟨c_rel, hc_ker⟩, hc_ne⟩ := exists_ne (0 : ↥(LinearMap.ker μ₂))
    let a₀ : E₁ := c_rel 0
    let a₁ : E₁ := c_rel 1
    let a₂ : E₁ := c_rel 2
    have ha_nonzero : a₀ ≠ 0 ∨ a₁ ≠ 0 ∨ a₂ ≠ 0 := by
      by_contra h_all
      push_neg at h_all
      apply hc_ne
      ext i
      fin_cases i
      · exact h_all.1
      · exact h_all.2.1
      · exact h_all.2.2
    have hμ₂_zero : a₀ • u0_bar ^ 2 + a₁ • (u0_bar * v0_bar) + a₂ • v0_bar ^ 2 = 0 :=
      congr_arg Subtype.val hc_ker
    have hCubic₁ : algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₀ * u₀ ^ 2 +
        algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₁ * u₀ * v₀ +
        algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₂ * v₀ ^ 2 ∈ m₁ ^ 3 := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change mk₁ (algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₀ * u₀ ^ 2 +
        algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₁ * u₀ * v₀ +
        algebraMap E₁ (TensorProduct κ₀ E₁ F₀) a₂ * v₀ ^ 2) = 0
      rw [← hμ₂_zero]
      dsimp only [u0_bar, v0_bar]
      simp only [Algebra.smul_def, map_add, map_mul, map_pow, mk₁.commutes, mul_assoc]
    let U_K : T_std := ι_T u0_bar
    let V_K : T_std := ι_T v0_bar
    have hU_mem : U_K ∈ 𝔫 := by rw [← hmap_m1_bar]; exact Ideal.mem_map_of_mem _ hu0_bar_mem
    have hV_mem : V_K ∈ 𝔫 := by rw [← hmap_m1_bar]; exact Ideal.mem_map_of_mem _ hv0_bar_mem
    let m₀₀ : K := Λ U_K 1
    let m₀₁ : K := Λ U_K 2
    let m₁₀ : K := Λ V_K 1
    let m₁₁ : K := Λ V_K 2
    let S_K : Submodule K T_std :=
      Submodule.span K ({1, U_K, V_K} : Set T_std) ⊔ Submodule.restrictScalars K (𝔫 ^ 2 : Ideal T_std)
    have hT₁_in_SK : ∀ t : T₁, ι_T t ∈ S_K := by
      intro t
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective t
      let z' := z - algebraMap E₁ (TensorProduct κ₀ E₁ F₀) (ρ₁ z)
      have hz'_m₁ : z' ∈ m₁ := by
        change ρ₁ (z - algebraMap E₁ (TensorProduct κ₀ E₁ F₀) (ρ₁ z)) = 0
        rw [map_sub, ρ₁.commutes]
        exact sub_self (ρ₁ z)
      have hr := hdecomp_m₁ z' hz'_m₁
      have hmk_r : mk₁ (z' - (l₀ z' • u₀ + l₁ z' • v₀)) ∈ m1_bar ^ 2 :=
        (h_mk₁_sq_iff _).mpr hr
      have hz_sum : z = algebraMap E₁ (TensorProduct κ₀ E₁ F₀) (ρ₁ z) +
          l₀ z' • u₀ + l₁ z' • v₀ + (z' - (l₀ z' • u₀ + l₁ z' • v₀)) := by
        change z = algebraMap E₁ _ (ρ₁ z) + l₀ z' • u₀ + l₁ z' • v₀ +
          ((z - algebraMap E₁ _ (ρ₁ z)) - (l₀ z' • u₀ + l₁ z' • v₀))
        abel
      have ht_eq : mk₁ z = ρ₁ z • (1 : T₁) + l₀ z' • u0_bar + l₁ z' • v0_bar +
          mk₁ (z' - (l₀ z' • u₀ + l₁ z' • v₀)) := by
        conv_lhs => rw [hz_sum]
        simp only [map_add, map_smul, mk₁.commutes]
        have h1 : algebraMap E₁ T₁ (ρ₁ z) = ρ₁ z • (1 : T₁) := by
          rw [Algebra.smul_def, mul_one]
        rw [h1]
      change ι_T (mk₁ z) ∈ S_K
      rw [ht_eq, map_add, map_add, map_add, hι_T_smul, hι_T_smul, hι_T_smul, map_one]
      refine S_K.add_mem (S_K.add_mem (S_K.add_mem ?_ ?_) ?_) ?_
      · exact Submodule.mem_sup_left (Submodule.smul_mem _ _
          (Submodule.subset_span (Set.mem_insert _ _)))
      · exact Submodule.mem_sup_left (Submodule.smul_mem _ _
          (Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))))
      · exact Submodule.mem_sup_left (Submodule.smul_mem _ _
          (Submodule.subset_span
            (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))))
      · refine Submodule.mem_sup_right ?_
        rw [Submodule.restrictScalars_mem, ← hmap_m1_bar_sq]
        exact Ideal.mem_map_of_mem _ hmk_r
    have hSK_all : ∀ y : T_std, ∃ (c p₀ p₁ : K) (q : T_std),
        q ∈ 𝔫 ^ 2 ∧ y = c • (1 : T_std) + p₀ • U_K + p₁ • V_K + q := by
      have h_univ : ∀ y : T_std, y ∈ S_K := by
        intro y
        rw [← Ψ_K.apply_symm_apply y]
        generalize Ψ_K.symm y = w
        induction w using TensorProduct.induction_on
        · rw [map_zero]; exact S_K.zero_mem
        · rename_i k t
          have hkt : TensorProduct.tmul E₁ k t =
              algebraMap K _ k * TensorProduct.tmul E₁ 1 t := by
            change TensorProduct.tmul E₁ k t = TensorProduct.tmul E₁ k 1 * TensorProduct.tmul E₁ 1 t
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hkt, map_mul, Ψ_K.commutes, ← Algebra.smul_def]
          exact S_K.smul_mem k (hT₁_in_SK t)
        · rename_i u v hu hv
          rw [map_add]; exact S_K.add_mem hu hv
      intro y
      obtain ⟨s, hs, q, hq, rfl⟩ := Submodule.mem_sup.mp (h_univ y)
      rw [Submodule.mem_span_insert] at hs
      obtain ⟨c, s₁, hs₁, rfl⟩ := hs
      rw [Submodule.mem_span_insert] at hs₁
      obtain ⟨p₀, s₂, hs₂, rfl⟩ := hs₁
      rw [Submodule.mem_span_singleton] at hs₂
      obtain ⟨p₁, rfl⟩ := hs₂
      refine ⟨c, p₀, p₁, q, hq, by abel⟩
    obtain ⟨x₀, x₁, hx₀_n, hx₁_n, hx₀₁, hx₀₂, hx₁₁, hx₁₂⟩ := hx
    obtain ⟨c₀, p₀₀, p₀₁, q₀, hq₀_sq, hx₀_eq⟩ := hSK_all x₀
    obtain ⟨c₁, p₁₀, p₁₁, q₁, hq₁_sq, hx₁_eq⟩ := hSK_all x₁
    have hq₀_n : q₀ ∈ 𝔫 := Ideal.pow_le_self (by norm_num : 2 ≠ 0) hq₀_sq
    have hq₁_n : q₁ ∈ 𝔫 := Ideal.pow_le_self (by norm_num : 2 ≠ 0) hq₁_sq
    have hc₀_0 : c₀ = 0 := by
      have h0 := hΛ_mem x₀ hx₀_n
      rw [hx₀_eq] at h0
      simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        hΛ_one, hΛ_mem U_K hU_mem, hΛ_mem V_K hV_mem, hΛ_mem q₀ hq₀_n,
        mul_one, mul_zero, add_zero] at h0
      exact h0
    have hc₁_0 : c₁ = 0 := by
      have h0 := hΛ_mem x₁ hx₁_n
      rw [hx₁_eq] at h0
      simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        hΛ_one, hΛ_mem U_K hU_mem, hΛ_mem V_K hV_mem, hΛ_mem q₁ hq₁_n,
        mul_one, mul_zero, add_zero] at h0
      exact h0
    have hp00 : p₀₀ * m₀₀ + p₀₁ * m₁₀ = 1 := by
      have h := hx₀₁
      rw [hx₀_eq, hc₀_0, zero_smul, zero_add] at h
      simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        (hΛ_sq q₀ hq₀_sq).1, add_zero] at h
      exact h
    have hp01 : p₀₀ * m₀₁ + p₀₁ * m₁₁ = 0 := by
      have h := hx₀₂
      rw [hx₀_eq, hc₀_0, zero_smul, zero_add] at h
      simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        (hΛ_sq q₀ hq₀_sq).2, add_zero] at h
      exact h
    have hp10 : p₁₀ * m₀₀ + p₁₁ * m₁₀ = 0 := by
      have h := hx₁₁
      rw [hx₁_eq, hc₁_0, zero_smul, zero_add] at h
      simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        (hΛ_sq q₁ hq₁_sq).1, add_zero] at h
      exact h
    have hp11 : p₁₀ * m₀₁ + p₁₁ * m₁₁ = 1 := by
      have h := hx₁₂
      rw [hx₁_eq, hc₁_0, zero_smul, zero_add] at h
      simp only [map_add, map_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
        (hΛ_sq q₁ hq₁_sq).2, add_zero] at h
      exact h
    have hDet : m₀₀ * m₁₁ - m₀₁ * m₁₀ ≠ 0 := by
      intro h0
      have hmul : (p₀₀ * p₁₁ - p₀₁ * p₁₀) * (m₀₀ * m₁₁ - m₀₁ * m₁₀) = 1 := by
        have hid : (p₀₀ * p₁₁ - p₀₁ * p₁₀) * (m₀₀ * m₁₁ - m₀₁ * m₁₀) =
            (p₀₀ * m₀₀ + p₀₁ * m₁₀) * (p₁₀ * m₀₁ + p₁₁ * m₁₁) -
              (p₀₀ * m₀₁ + p₀₁ * m₁₁) * (p₁₀ * m₀₀ + p₁₁ * m₁₀) := by ring
        rw [hid, hp00, hp11, hp01, hp10]; ring
      rw [h0, mul_zero] at hmul
      exact zero_ne_one hmul
    have hQ_K : j₁ a₀ • U_K ^ 2 + j₁ a₁ • (U_K * V_K) + j₁ a₂ • V_K ^ 2 = 0 := by
      have h := congr_arg ι_T hμ₂_zero
      rw [map_zero, map_add, map_add, hι_T_smul, hι_T_smul, hι_T_smul,
        map_pow, map_mul, map_pow] at h
      exact h
    have hEq₀ : j₁ a₀ * m₀₀ ^ 2 + j₁ a₁ * m₀₀ * m₁₀ + j₁ a₂ * m₁₀ ^ 2 = 0 := by
      have h := congr_fun (congr_arg Λ hQ_K) 3
      simp only [map_zero, Pi.zero_apply, map_add, map_smul, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul, sq U_K, sq V_K,
        (hΛ_mul U_K U_K hU_mem hU_mem).1,
        (hΛ_mul U_K V_K hU_mem hV_mem).1,
        (hΛ_mul V_K V_K hV_mem hV_mem).1] at h
      dsimp [m₀₀, m₁₀]
      linear_combination h
    have hEq₁ : j₁ a₀ * m₀₁ ^ 2 + j₁ a₁ * m₀₁ * m₁₁ + j₁ a₂ * m₁₁ ^ 2 = 0 := by
      have h := congr_fun (congr_arg Λ hQ_K) 4
      simp only [map_zero, Pi.zero_apply, map_add, map_smul, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul, sq U_K, sq V_K,
        (hΛ_mul U_K U_K hU_mem hU_mem).2,
        (hΛ_mul U_K V_K hU_mem hV_mem).2,
