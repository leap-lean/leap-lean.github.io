        simp only [map_add]; ring
      rw [hneg]
      exact Submodule.neg_mem _ h₂
    exact ⟨RingEquiv.ofBijective ψ_bar ⟨hInj, hSurj⟩, fun _ => rfl⟩
  refine ⟨E₁, instFieldE₁, instAlgE₁, instFinE₁, instSepE₁, π₁, j₁, hSurj₁, hcompat₁, hq_K, ?_⟩
  intro q_K I_cube J_std
  obtain ⟨Ψ₁, hΨ₁⟩ :=
    s4_mod_cube (TensorProduct κ₀ K F₀) (algebraMap K (TensorProduct κ₀ K F₀)) ψ₁ hψ₁ hev_id
  have hev_id₂ :
      ev_K.comp (ψ₂.comp ((Ideal.Quotient.mk I_node).comp MvPolynomial.C)) = RingHom.id K := by
    rw [← hcomm_K]
    exact hev_id
  obtain ⟨Ψ₂, hΨ₂⟩ :=
    s4_mod_cube N_K ((Ideal.Quotient.mk I_node).comp MvPolynomial.C) ψ₂ hψ₂ hev_id₂
