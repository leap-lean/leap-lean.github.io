        intro v
        refine TensorProduct.inductionOn
          (motive := fun v => ∃ ω : Ω[L₀⁄κ₀], (1 : κ_L) ⊗ₜ[L₀] ω = v) v ?_ ?_
        · intro c ω
          obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective c
          refine ⟨r • ω, ?_⟩
          rw [← TensorProduct.smul_tmul]
          change (algebraMap L₀ κ_L r * 1) ⊗ₜ[L₀] ω = _
