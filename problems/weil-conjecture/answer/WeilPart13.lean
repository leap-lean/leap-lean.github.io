          rw [mul_one]
        let e_MD_κD : TensorProduct D κ_D M_D ≃ₗ[κ_D] (Fin 2 → κ_D) :=
          LinearEquiv.ofLinearMap fwd_κ bwd_κ hfb_κ hbf_κ
        let e_tot : TensorProduct κ_L κ_D (TensorProduct L₀ κ_L Ω[L₀⁄κ₀]) ≃ₗ[κ_D] (Fin 2 → κ_D) :=
          (((TensorProduct.AlgebraTensorModule.cancelBaseChange L₀ κ_L κ_D κ_D Ω[L₀⁄κ₀]).trans
            (TensorProduct.AlgebraTensorModule.cancelBaseChange L₀ D κ_D κ_D Ω[L₀⁄κ₀]).symm).trans
            (LinearEquiv.baseChange D κ_D _ _ Ξ)).trans e_MD_κD
        have hfr := LinearEquiv.finrank_eq e_tot
        rw [Module.finrank_baseChange, Module.finrank_fin_fun] at hfr
        exact hfr
      have : Algebra.EssFiniteType F₀ L₀ :=
        Algebra.EssFiniteType.of_isLocalization L₀ m_F₀.primeCompl
      have : Algebra.EssFiniteType κ₀ L₀ := Algebra.EssFiniteType.comp κ₀ F₀ L₀
      have : Module.Finite L₀ Ω[L₀⁄κ₀] := KaehlerDifferential.finite κ₀ L₀
      let b : Module.Basis (Fin 2) κ_L (TensorProduct L₀ κ_L Ω[L₀⁄κ₀]) :=
