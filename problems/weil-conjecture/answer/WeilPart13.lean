        · intro hw'
          have hj_eq : e_U.base (j_f'.base w') = p₀ := by
            calc e_U.base (j_f'.base w')
                = (j_f' ≫ e_U).base w' := (hbase_comp j_f' e_U w').symm
              _ = (e_Uf ≫ j_f).base w' := by rw [← he_comm]
              _ = j_f.base (e_Uf.base w') := hbase_comp e_Uf j_f w'
              _ = j_f.base p₀_f := by rw [hw']
              _ = p₀ := hp₀f_base
          have hj_mem : j_f'.base w' ∈ ({v₀} : Set ↥(AlgebraicGeometry.Spec A')) := by
            rw [← hv₀_fib]
            exact hj_eq
          rw [Set.mem_singleton_iff, ← hv₀f_base] at hj_mem
          exact j_f'.isOpenEmbedding.injective hj_mem
        · intro hw'
          rw [hw']
          apply j_f.isOpenEmbedding.injective
          calc j_f.base (e_Uf.base v₀_f')
              = (e_Uf ≫ j_f).base v₀_f' := (hbase_comp e_Uf j_f v₀_f').symm
            _ = (j_f' ≫ e_U).base v₀_f' := by rw [he_comm]
            _ = e_U.base (j_f'.base v₀_f') := hbase_comp j_f' e_U v₀_f'
            _ = e_U.base v₀ := by rw [hv₀f_base]
            _ = p₀ := he_v₀
            _ = j_f.base p₀_f := hp₀f_base.symm
      have h_pre_R : ∀ x : PowerSeries Ω,
          (AlgebraicGeometry.Spec.preimage (ι'_Uf ≫ g_Y')).hom x =
            α_f ((AlgebraicGeometry.Spec.preimage (ι_U ≫ g_Y)).hom x) := by
        intro x
        rw [h_ι'_g, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
        rfl
      have h_e_ι'_g : e_Uf ≫ ι'_Uf ≫ g_Y' = j_f' ≫ (e_U ≫ ι_U ≫ g_Y) := by
        calc e_Uf ≫ ι'_Uf ≫ g_Y'
            = (e_Uf ≫ j_f) ≫ (ι_U ≫ g_Y) := by
                rw [h_ι'_g, CategoryTheory.Category.assoc]
          _ = (j_f' ≫ e_U) ≫ (ι_U ≫ g_Y) := by rw [he_comm]
          _ = j_f' ≫ (e_U ≫ ι_U ≫ g_Y) := by simp only [CategoryTheory.Category.assoc]
      have h_pre_A : ∀ x : PowerSeries Ω,
          (AlgebraicGeometry.Spec.preimage (e_Uf ≫ ι'_Uf ≫ g_Y')).hom x =
            β_f' ((AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_Y)).hom x) := by
        intro x
        rw [h_e_ι'_g, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
        rfl
      refine ⟨hq'_cl, a, b, hb, R₀_f, p₀_f, ι'_Uf, α_f z₁, α_f z₂,
        A'_f', v₀_f', e_Uf, β_f' u, β_f' v, β_f' ε,
        hOpen_ι', hp₀f_eq, hDomRf, hp₀f_id, hz₁f_ne, hRegRf, ?_,
        hEt_eUf, hDomAf, hv₀f_fib, hv₀f_id, huf_ne, hRegAf, ?_,
        hUnit_ε.map β_f', ha, ?_⟩
      · intro r_loc
        obtain ⟨c, hc⟩ := hResRf r_loc
        refine ⟨c, ?_⟩
        rw [h_pre_R]
        exact hc
      · intro r'_loc
        obtain ⟨c, hc⟩ := hResAf r'_loc
        refine ⟨c, ?_⟩
        rw [h_pre_A]
        exact hc
      · rw [h_pre_A, hX_eq]
        simp only [map_mul, map_pow]
    · rintro ⟨j, b_S, hb_S⟩
      refine ⟨j, b_S, ?_⟩
      have h_ρ_eq : ρ.base ((τ_Y' j).base b_S) = ρ.base (fst_Y'.base q') := by
        calc ρ.base ((τ_Y' j).base b_S)
            = (τ_Y' j ≫ ρ).base b_S := (hbase_comp (τ_Y' j) ρ b_S).symm
          _ = (τ_Y j).base b_S := by rw [hBlow.2.2.2.1 j]
          _ = fst_Y.base q := hb_S
          _ = ρ.base (fst_Y'.base q') := hq'_ρ.symm
      have h_ne_w : ρ.base ((τ_Y' j).base b_S) ≠ w_y := by
        rw [h_ρ_eq, hq'_ρ]
        exact hw_q
      exact hInj_off h_ne_w h_ρ_eq

theorem weil_nc2d_single_blowup_step_closedImmersion_and_monotone_descent (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ)
    (hIntP1 : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver Ω 1).left)
    (hProperP1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver Ω 1).hom)
    (hAffP1 : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen Ω 1 a))
    (hCovP1 : (⨆ a : Fin 2, weilProjBasicOpen Ω 1 a) = ⊤)
    (hPolyP1 : ∀ a : Fin 2,
      Nonempty (MvPolynomial (Fin 1) Ω ≃+*
        ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen Ω 1 a)))))
    (hCompMax : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
        (F : Set ↥(CategoryTheory.Limits.pullback g_Z
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      IsClosed F →
      IsIrreducible F →
      ¬ F.Subsingleton →
      F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hTwoCompNode : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
        (E₁ E₂ : Set ↥(CategoryTheory.Limits.pullback g_Z
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
        (q : ↥(CategoryTheory.Limits.pullback g_Z
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))) →
      E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))) →
      E₁ ≠ E₂ →
      q ∈ E₁ →
      q ∈ E₂ →
      IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_Z
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))) ∧
        ∃ a b : ℕ, 1 ≤ b ∧ HasNCBranchAt Ω g_Z q a b)
    (Y Y' : AlgebraicGeometry.Scheme.{u})
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (g_Y' : Y' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y'))
    (y₀ : ↥(CategoryTheory.Limits.pullback g_Y
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (ρ : Y' ⟶ Y)
    (ρ₀ : CategoryTheory.Limits.pullback g_Y'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) ⟶
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (ψ' : (weilProjectiveSpaceOver Ω 1).left ⟶
      CategoryTheory.Limits.pullback g_Y'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hBlow : IsNC2DClosedPointBlowup Ω n g_Y τ_Y g_Y' τ_Y' y₀ ρ)
    (hρ₀_fst : ρ₀ ≫ CategoryTheory.Limits.pullback.fst g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      CategoryTheory.Limits.pullback.fst g_Y'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) ≫ ρ)
    (hρ₀_snd : ρ₀ ≫ CategoryTheory.Limits.pullback.snd g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      CategoryTheory.Limits.pullback.snd g_Y'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (hOffLift : ∀ p : ↥(weilProjectiveSpaceOver Ω 1).left,
      (ψ' ≫ ρ₀).base p ≠ y₀ →
      (p ∈ nc2dNodePullbackSet Ω g_Y (ψ' ≫ ρ₀) → p ∈ nc2dNodePullbackSet Ω g_Y' ψ') ∧
      (p ∈ nc2dMarkPullbackSet Ω n g_Y τ_Y (ψ' ≫ ρ₀) →
        p ∈ nc2dMarkPullbackSet Ω n g_Y' τ_Y' ψ'))
    (hCl' : AlgebraicGeometry.IsClosedImmersion ψ')
    (hSnd' : ψ' ≫ CategoryTheory.Limits.pullback.snd g_Y'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      (weilProjectiveSpaceOver Ω 1).hom)
    (hNonSub : ¬ (Set.range (ψ' ≫ ρ₀).base).Subsingleton)
    (hB'Sub : (nc2dNodePullbackSet Ω g_Y' ψ').Subsingleton) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    let ψ := ψ' ≫ ρ₀
    AlgebraicGeometry.IsClosedImmersion ψ ∧
    ψ ≫ CategoryTheory.Limits.pullback.snd g_Y s_Ω = (weilProjectiveSpaceOver Ω 1).hom ∧
    nc2dNodePullbackSet Ω g_Y ψ ⊆ nc2dNodePullbackSet Ω g_Y' ψ' ∧
    nc2dNodePullbackSet Ω g_Y ψ ∪ nc2dMarkPullbackSet Ω n g_Y τ_Y ψ ⊆
      nc2dNodePullbackSet Ω g_Y' ψ' ∪ nc2dMarkPullbackSet Ω n g_Y' τ_Y' ψ' :=
by
  have hPIR_poly : IsPrincipalIdealRing (Polynomial Ω) := inferInstance
  classical
  let _ := hProperP1
  
  let commRingIsoToEquiv : ∀ {C₁ C₂ : CommRingCat.{u}} (_ : C₁ ≅ C₂), ↑C₁ ≃+* ↑C₂ :=
    fun e =>
      { toFun := e.hom.hom
        invFun := e.inv.hom
        left_inv := fun x => congrArg (fun m => m.hom x) e.hom_inv_id
        right_inv := fun y => congrArg (fun m => m.hom y) e.inv_hom_id
        map_mul' := map_mul e.hom.hom
        map_add' := map_add e.hom.hom }

  have hSurjCompIso : ∀ {C₁ C₂ C₃ : CommRingCat.{u}} (f : C₁ ⟶ C₂) (g : C₂ ⟶ C₃)
      [CategoryTheory.IsIso g],
      Function.Surjective f.hom ↔ Function.Surjective (f ≫ g).hom := by
    intro C₁ C₂ C₃ f g _
    let eg := commRingIsoToEquiv (CategoryTheory.asIso g)
    have hcomp : (f ≫ g).hom = eg.toRingHom.comp f.hom := rfl
    rw [hcomp, RingHom.coe_comp]
    exact ⟨fun hf => eg.surjective.comp hf, fun hfg y => by
      obtain ⟨x, hx⟩ := hfg (eg y)
      exact ⟨x, eg.injective hx⟩⟩

  have hSurjIsoComp : ∀ {C₁ C₂ C₃ : CommRingCat.{u}} (f : C₁ ⟶ C₂) (g : C₂ ⟶ C₃)
      [CategoryTheory.IsIso f],
      Function.Surjective g.hom ↔ Function.Surjective (f ≫ g).hom := by
    intro C₁ C₂ C₃ f g _
    let ef := commRingIsoToEquiv (CategoryTheory.asIso f)
    have hcomp : (f ≫ g).hom = g.hom.comp ef.toRingHom := rfl
    rw [hcomp, RingHom.coe_comp]
    exact ⟨fun hg => hg.comp ef.surjective, fun hfg z => by
      obtain ⟨x, hx⟩ := hfg z
      exact ⟨ef x, hx⟩⟩

  have hSurjEqIso : ∀ {C₁ C₂ C₃ C₄ : CommRingCat.{u}}
      (a : C₁ ⟶ C₂) (b : C₂ ⟶ C₄) (c : C₁ ⟶ C₃) (d : C₃ ⟶ C₄)
      [CategoryTheory.IsIso a] [CategoryTheory.IsIso c],
      a ≫ b = c ≫ d → (Function.Surjective b.hom ↔ Function.Surjective d.hom) := by
    intro C₁ C₂ C₃ C₄ a b c d _ _ h
    rw [hSurjIsoComp a b, h, ← hSurjIsoComp c d]

  have hDVROfRingEquiv : ∀ {A B : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
      [CommRing B] [IsDomain B] [IsLocalRing B],
      (A ≃+* B) → IsDiscreteValuationRing B := by
    intro A B _ _ _ _ _ _ e
    haveI : IsNoetherianRing B := isNoetherianRing_of_ringEquiv A e
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible A
    have hϖB_ne : e ϖ ≠ 0 :=
      fun h0 => hϖ.ne_zero (e.injective (h0.trans (map_zero e).symm))
    have hϖB_not_unit : ¬ IsUnit (e ϖ) :=
      fun hu => hϖ.not_isUnit (by simpa using hu.map e.symm.toRingHom)
    have hNotFieldB : ¬ IsField B := by
      intro hF
      obtain ⟨v, hv⟩ := hF.mul_inv_cancel hϖB_ne
      exact hϖB_not_unit (isUnit_iff_exists_inv.mpr ⟨v, hv⟩)
    have hPrincB : Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) := by
      refine ⟨⟨e ϖ, ?_⟩⟩
      rw [Ideal.submodule_span_eq]
      apply le_antisymm
      · intro y hy
        by_cases hy0 : y = 0
        · rw [hy0]; exact Ideal.zero_mem _
        · have hx0 : e.symm y ≠ 0 := by
            intro h0
            apply hy0
            simpa using congrArg e h0
          obtain ⟨k, hk⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx0 hϖ
          obtain ⟨u_x, hux⟩ := hk.symm
          rcases Nat.eq_zero_or_pos k with rfl | hk_pos
          · exfalso
            have huB : IsUnit y := by
              have h_eq := congrArg e hux
              simp only [pow_zero, one_mul, RingEquiv.apply_symm_apply] at h_eq
              rw [← h_eq]
              exact u_x.isUnit.map e.toRingHom
            exact (IsLocalRing.notMem_maximalIdeal.mpr huB) hy
          · obtain ⟨r, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk_pos)
            rw [Ideal.mem_span_singleton]
            refine ⟨e (ϖ ^ r * u_x), ?_⟩
            calc y = e (e.symm y) := (e.apply_symm_apply y).symm
              _ = e (ϖ ^ (r + 1) * u_x) := by rw [← hux]
              _ = e ϖ * e (ϖ ^ r * u_x) := by rw [pow_succ', mul_assoc, map_mul]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        by_contra hnot
        exact hϖB_not_unit (IsLocalRing.notMem_maximalIdeal.mp hnot)
    exact ((IsDiscreteValuationRing.TFAE B hNotFieldB).out 5 1).mp hPrincB

  
  have hPrincDVR : ∀ (T : Type u) [CommRing T] [IsLocalRing T] [IsNoetherianRing T] (π : T),
      IsLocalRing.maximalIdeal T = Ideal.span ({π} : Set T) →
      π ≠ 0 →
      (∀ z : T, π * z = 0 → z = 0) →
      ∃ (hDom : IsDomain T),
        letI : IsDomain T := hDom
        ¬ IsField T ∧ IsDiscreteValuationRing T ∧
          (∀ P : Ideal T, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal T) := by
    intro T _ _ _ π hmax hπ_ne hπ_reg
    have hpow_span : ∀ k : ℕ, (IsLocalRing.maximalIdeal T) ^ k = Ideal.span ({π ^ k} : Set T) := by
      intro k
      rw [hmax, Ideal.span_singleton_pow]
    have hpow_reg : ∀ (k : ℕ) (z : T), π ^ k * z = 0 → z = 0 := by
      intro k
      induction k with
      | zero =>
        intro z hz
        simpa using hz
      | succ k ih =>
        intro z hz
        have hz' : π ^ k * (π * z) = 0 := by
          calc π ^ k * (π * z) = (π ^ k * π) * z := by ring
            _ = π ^ (k + 1) * z := by rw [pow_succ]
            _ = 0 := hz
        exact hπ_reg z (ih (π * z) hz')
    have hiInf : (⨅ k : ℕ, (IsLocalRing.maximalIdeal T) ^ k) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal T)
        (IsLocalRing.maximalIdeal.isMaximal T).ne_top
    have hfactor : ∀ x : T, x ≠ 0 → ∃ (k : ℕ) (u : T), IsUnit u ∧ x = π ^ k * u := by
      intro x hx
      have hex : ∃ k : ℕ, x ∉ (IsLocalRing.maximalIdeal T) ^ (k + 1) := by
        by_contra hall
        push Not at hall
        have hmem : x ∈ (⨅ m : ℕ, (IsLocalRing.maximalIdeal T) ^ m) := by
          rw [Ideal.mem_iInf]
          intro m
          cases m with
          | zero => simp
          | succ k => exact hall k
        rw [hiInf, Ideal.mem_bot] at hmem
        exact hx hmem
      let k := Nat.find hex
      have hk_not : x ∉ (IsLocalRing.maximalIdeal T) ^ (k + 1) := Nat.find_spec hex
      have hk_in : x ∈ (IsLocalRing.maximalIdeal T) ^ k := by
        rcases Nat.eq_zero_or_pos k with hk0 | hk_pos
        · rw [hk0, pow_zero, Ideal.one_eq_top]
          trivial
        · obtain ⟨r, hr⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk_pos)
          have hmin := Nat.find_min hex (show r < k by omega)
          rw [hr]
          exact Classical.not_not.mp hmin
      rw [hpow_span k, Ideal.mem_span_singleton] at hk_in
      rcases hk_in with ⟨u, hx_eq⟩
      have hu_not_max : u ∉ IsLocalRing.maximalIdeal T := by
        intro hu_max
        rw [hmax, Ideal.mem_span_singleton] at hu_max
        rcases hu_max with ⟨w, rfl⟩
        apply hk_not
        rw [hpow_span (k + 1), Ideal.mem_span_singleton]
        exact ⟨w, by rw [hx_eq, pow_succ]; ring⟩
      exact ⟨k, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_max, hx_eq⟩
    have hNZD : NoZeroDivisors T := ⟨fun {x y} hxy => by
      by_contra hne
      push Not at hne
      obtain ⟨hx, hy⟩ := hne
      obtain ⟨k, u_x, hu_x, rfl⟩ := hfactor x hx
      obtain ⟨m, u_y, hu_y, rfl⟩ := hfactor y hy
      have hprod : π ^ (k + m) * (u_x * u_y) = 0 := by
        calc π ^ (k + m) * (u_x * u_y)
            = (π ^ k * u_x) * (π ^ m * u_y) := by rw [pow_add]; ring
          _ = 0 := hxy
      have hu_zero : u_x * u_y = 0 := hpow_reg (k + m) (u_x * u_y) hprod
      exact (hu_x.mul hu_y).ne_zero hu_zero⟩
    have hDom : IsDomain T := @NoZeroDivisors.to_isDomain T _ _ hNZD
    letI : IsDomain T := hDom
    have hNotField : ¬ IsField T := by
      intro hF
      obtain ⟨v, hv⟩ := hF.mul_inv_cancel hπ_ne
      have hπ_unit : IsUnit π := isUnit_iff_exists_inv.mpr ⟨v, hv⟩
      have hπ_mem : π ∈ IsLocalRing.maximalIdeal T := by
        rw [hmax]
        exact Ideal.subset_span (Set.mem_singleton π)
      exact (IsLocalRing.notMem_maximalIdeal.mpr hπ_unit) hπ_mem
    have hPrinc : Submodule.IsPrincipal (IsLocalRing.maximalIdeal T) :=
      ⟨⟨π, by rw [Ideal.submodule_span_eq, hmax]⟩⟩
    have hDVR : IsDiscreteValuationRing T :=
      ((IsDiscreteValuationRing.TFAE T hNotField).out 5 1).mp hPrinc
    refine ⟨hDom, hNotField, hDVR, ?_⟩
    intro P hP
    by_cases hP_bot : P = ⊥
    · exact Or.inl hP_bot
    · right
      obtain ⟨x, hxP, hx_ne⟩ := (Submodule.ne_bot_iff P).mp hP_bot
      obtain ⟨k, u_x, hu_x, rfl⟩ := hfactor x hx_ne
      rcases Nat.eq_zero_or_pos k with rfl | _hk_pos
      · exfalso
        have hu_mem : u_x ∈ P := by simpa using hxP
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem P hu_mem hu_x)
      · obtain ⟨v_x, hv_x⟩ := hu_x.exists_right_inv
        have hpow_P : π ^ k ∈ P := by
          have hmem := Ideal.mul_mem_right v_x P hxP
          have heq : (π ^ k * u_x) * v_x = π ^ k := by rw [mul_assoc, hv_x, mul_one]
          rwa [heq] at hmem
        have hπ_in_P : π ∈ P := hP.mem_of_pow_mem k hpow_P
        apply le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top)
        rw [hmax, Ideal.span_le, Set.singleton_subset_iff]
        exact hπ_in_P

  have hQuotDVRCore : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [IsNoetherianRing A']
      (v₀ : PrimeSpectrum A') (u v : A'),
      v₀.asIdeal = Ideal.span ({u, v} : Set A') →
      u ≠ 0 →
      (∀ y : A', v * y ∈ Ideal.span ({u} : Set A') → y ∈ Ideal.span ({u} : Set A')) →
      let L_A' := Localization.AtPrime v₀.asIdeal
      let t₀ : L_A' := algebraMap A' L_A' u
      let D₀ := L_A' ⧸ Ideal.span ({t₀} : Set L_A')
      ∃ (hLoc : IsLocalRing D₀) (hDom : IsDomain D₀),
        letI : IsLocalRing D₀ := hLoc
        letI : IsDomain D₀ := hDom
        IsDiscreteValuationRing D₀ ∧
          ∀ P : Ideal D₀, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal D₀ := by
    intro A' _ _ _ v₀ u v hv₀_span _hu_ne huv_reg
    dsimp only
    let L_A' := Localization.AtPrime v₀.asIdeal
    let u_bar : L_A' := algebraMap A' L_A' u
    let v_bar : L_A' := algebraMap A' L_A' v
    let I₀ : Ideal L_A' := Ideal.span ({u_bar} : Set L_A')
    let D₀ := L_A' ⧸ I₀
    let mk : L_A' →+* D₀ := Ideal.Quotient.mk I₀
    have hinj_LA' : Function.Injective (algebraMap A' L_A') :=
      IsLocalization.injective L_A' (Ideal.primeCompl_le_nonZeroDivisors v₀.asIdeal)
    haveI : IsDomain L_A' :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors v₀.asIdeal)
    haveI : IsNoetherianRing L_A' :=
      IsLocalization.isNoetherianRing v₀.asIdeal.primeCompl L_A' inferInstance
    have h_u_le_v0 : Ideal.span ({u} : Set A') ≤ v₀.asIdeal := by
      rw [hv₀_span]
      exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert u {v}))
    have hv_not_I₀ : v_bar ∉ I₀ := by
      intro hv_mem
      rw [Ideal.mem_span_singleton] at hv_mem
      obtain ⟨z, hz⟩ := hv_mem
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj v₀.asIdeal.primeCompl z
      have h_eq : v * (s : A') = u * a := by
        apply hinj_LA'
        calc algebraMap A' L_A' (v * (s : A'))
            = v_bar * algebraMap A' L_A' (s : A') := by rw [map_mul]
          _ = (u_bar * z) * algebraMap A' L_A' (s : A') := by rw [hz]
          _ = u_bar * (z * algebraMap A' L_A' (s : A')) := by ring
          _ = u_bar * algebraMap A' L_A' a := by rw [hzs]
          _ = algebraMap A' L_A' (u * a) := by rw [map_mul]
      have hs_in_u : (s : A') ∈ Ideal.span ({u} : Set A') :=
        huv_reg (s : A') (Ideal.mem_span_singleton.mpr ⟨a, h_eq⟩)
      exact s.2 (h_u_le_v0 hs_in_u)
    have hI₀_ne_top : I₀ ≠ ⊤ := by
      intro htop
      apply hv_not_I₀
      rw [htop]
      trivial
    haveI : Nontrivial D₀ := Ideal.Quotient.nontrivial_iff.mpr hI₀_ne_top
    have hLoc : IsLocalRing D₀ := IsLocalRing.of_surjective' mk Ideal.Quotient.mk_surjective
    letI : IsLocalRing D₀ := hLoc
    have hu_mem_v0 : u ∈ v₀.asIdeal := by
      rw [hv₀_span]
      exact Ideal.subset_span (Set.mem_insert u {v})
    have hv_mem_v0 : v ∈ v₀.asIdeal := by
      rw [hv₀_span]
      exact Ideal.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton v))
    have hu_bar_max : u_bar ∈ IsLocalRing.maximalIdeal L_A' :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff L_A' v₀.asIdeal u).mpr hu_mem_v0
    have hv_bar_max : v_bar ∈ IsLocalRing.maximalIdeal L_A' :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff L_A' v₀.asIdeal v).mpr hv_mem_v0
    have hI₀_le_max : I₀ ≤ IsLocalRing.maximalIdeal L_A' :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu_bar_max)
    have hmax_LA' : IsLocalRing.maximalIdeal L_A' = Ideal.span ({u_bar, v_bar} : Set L_A') := by
      have hmap : Ideal.map (algebraMap A' L_A') v₀.asIdeal = IsLocalRing.maximalIdeal L_A' :=
        Localization.AtPrime.map_eq_maximalIdeal
      have hmap2 : Ideal.map (algebraMap A' L_A') v₀.asIdeal =
          Ideal.map (algebraMap A' L_A') (Ideal.span ({u, v} : Set A')) :=
        congrArg (Ideal.map (algebraMap A' L_A')) hv₀_span
      rw [← hmap, hmap2, Ideal.map_span]
      congr 1
      ext x
      simp [u_bar, v_bar]
    let π_D : D₀ := mk v_bar
    have hπ_D_ne : π_D ≠ 0 :=
      fun h0 => hv_not_I₀ ((Ideal.Quotient.eq_zero_iff_mem).mp h0)
    have hmax_D₀ : IsLocalRing.maximalIdeal D₀ = Ideal.span ({π_D} : Set D₀) := by
      apply le_antisymm
      · intro d hd
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
        have hx_max : x ∈ IsLocalRing.maximalIdeal L_A' := by
          by_contra hx_not
          have hx_unit : IsUnit x := IsLocalRing.notMem_maximalIdeal.mp hx_not
          exact (IsLocalRing.notMem_maximalIdeal.mpr (hx_unit.map mk)) hd
        have hmk_in : mk x ∈ Ideal.map mk (IsLocalRing.maximalIdeal L_A') :=
          Ideal.mem_map_of_mem mk hx_max
        rw [hmax_LA', Ideal.map_span] at hmk_in
        have hmk_u : mk u_bar = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton u_bar))
        have hset : mk '' ({u_bar, v_bar} : Set L_A') = ({0, π_D} : Set D₀) := by
          ext y
          simp [π_D, hmk_u]
        rw [hset] at hmk_in
        have hspan0 : Ideal.span ({0, π_D} : Set D₀) = Ideal.span ({π_D} : Set D₀) := by
          rw [← Set.insert_eq_of_mem (Set.mem_singleton π_D)]
          simp
        rwa [hspan0] at hmk_in
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        by_contra hπ_not
        have hπ_unit : IsUnit π_D := IsLocalRing.notMem_maximalIdeal.mp hπ_not
        obtain ⟨q, hq⟩ := hπ_unit.exists_right_inv
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
        have hsub : v_bar * y - 1 ∈ I₀ := by
          apply (Ideal.Quotient.eq_zero_iff_mem).mp
          simpa [map_sub, map_mul, map_one, π_D] using sub_eq_zero.mpr hq
        have hsub_max : v_bar * y - 1 ∈ IsLocalRing.maximalIdeal L_A' := hI₀_le_max hsub
        have hvy_max : v_bar * y ∈ IsLocalRing.maximalIdeal L_A' :=
          Ideal.mul_mem_right y _ hv_bar_max
        have h1 : (1 : L_A') ∈ IsLocalRing.maximalIdeal L_A' := by
          have hmem := Ideal.sub_mem _ hvy_max hsub_max
          have heq : v_bar * y - (v_bar * y - 1) = 1 := by ring
          rwa [heq] at hmem
        exact (IsLocalRing.maximalIdeal.isMaximal L_A').ne_top
          ((Ideal.eq_top_iff_one _).mpr h1)
    have hπ_D_reg : ∀ z : D₀, π_D * z = 0 → z = 0 := by
      intro z hz
      obtain ⟨y_loc, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hmem : v_bar * y_loc ∈ I₀ :=
        (Ideal.Quotient.eq_zero_iff_mem).mp (by simpa [π_D, map_mul] using hz)
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨a_loc, ha_loc⟩ := hmem
      obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj v₀.asIdeal.primeCompl y_loc
      obtain ⟨⟨a, t⟩, hat⟩ := IsLocalization.surj v₀.asIdeal.primeCompl a_loc
      have h_eq : v * (y * (t : A')) = u * (a * (s : A')) := by
        apply hinj_LA'
        calc algebraMap A' L_A' (v * (y * (t : A')))
            = v_bar * (algebraMap A' L_A' y) * algebraMap A' L_A' (t : A') := by
                simp [v_bar, map_mul, mul_assoc]
          _ = v_bar * (y_loc * algebraMap A' L_A' (s : A')) * algebraMap A' L_A' (t : A') := by
                rw [← hys]
          _ = (v_bar * y_loc) * algebraMap A' L_A' (s : A') * algebraMap A' L_A' (t : A') := by
                ring
          _ = (u_bar * a_loc) * algebraMap A' L_A' (s : A') * algebraMap A' L_A' (t : A') := by
                rw [ha_loc]
          _ = u_bar * (a_loc * algebraMap A' L_A' (t : A')) * algebraMap A' L_A' (s : A') := by
                ring
          _ = u_bar * algebraMap A' L_A' a * algebraMap A' L_A' (s : A') := by
                rw [hat]
          _ = algebraMap A' L_A' (u * (a * (s : A'))) := by
                simp [u_bar, map_mul, mul_assoc]
      have hyt_in_u : y * (t : A') ∈ Ideal.span ({u} : Set A') :=
        huv_reg (y * (t : A')) (Ideal.mem_span_singleton.mpr ⟨a * (s : A'), h_eq⟩)
      rw [Ideal.mem_span_singleton] at hyt_in_u
      obtain ⟨w, hw⟩ := hyt_in_u
      let st : v₀.asIdeal.primeCompl := s * t
      have hst_unit : IsUnit (algebraMap A' L_A' (st : A')) :=
        IsLocalization.map_units L_A' st
      have hy_eq : y_loc = u_bar * IsLocalization.mk' L_A' w st := by
        apply hst_unit.mul_left_injective
        calc y_loc * algebraMap A' L_A' (st : A')
            = (y_loc * algebraMap A' L_A' (s : A')) * algebraMap A' L_A' (t : A') := by
                simp [st, Submonoid.coe_mul, map_mul, mul_assoc]
          _ = algebraMap A' L_A' (y * (t : A')) := by rw [hys, map_mul]
          _ = algebraMap A' L_A' (u * w) := by rw [hw]
          _ = u_bar * algebraMap A' L_A' w := by rw [map_mul]
          _ = u_bar * (IsLocalization.mk' L_A' w st * algebraMap A' L_A' (st : A')) := by
                rw [IsLocalization.mk'_spec]
          _ = (u_bar * IsLocalization.mk' L_A' w st) * algebraMap A' L_A' (st : A') := by
                ring
      exact (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.mem_span_singleton.mpr ⟨_, hy_eq⟩)
    obtain ⟨hDom, _hNotField, hDVR, hPrimes⟩ :=
      hPrincDVR D₀ π_D hmax_D₀ hπ_D_ne hπ_D_reg
    exact ⟨hLoc, hDom, hDVR, hPrimes⟩

  have hQuotDVR : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [IsNoetherianRing A']
      (v₀ : PrimeSpectrum A') (u v : A'),
      v₀.asIdeal = Ideal.span ({u, v} : Set A') →
      u ≠ 0 →
      (∀ y : A', v * y ∈ Ideal.span ({u} : Set A') → y ∈ Ideal.span ({u} : Set A')) →
      let L_A' := Localization.AtPrime v₀.asIdeal
      ∀ t₀ : L_A',
        (t₀ = algebraMap A' L_A' u ∨ t₀ = algebraMap A' L_A' v) →
        let D₀ := L_A' ⧸ Ideal.span ({t₀} : Set L_A')
        ∃ (hLoc : IsLocalRing D₀) (hDom : IsDomain D₀),
          letI : IsLocalRing D₀ := hLoc
          letI : IsDomain D₀ := hDom
          IsDiscreteValuationRing D₀ ∧
            ∀ P : Ideal D₀, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal D₀ := by
    intro A' _ _ _ v₀ u v hv₀_span hu_ne huv_reg L_A' t₀ ht₀
    rcases ht₀ with rfl | rfl
    · exact hQuotDVRCore A' v₀ u v hv₀_span hu_ne huv_reg
    · have hv_ne : v ≠ 0 := by
        intro hv0
        have h1_u : (1 : A') ∈ Ideal.span ({u} : Set A') := by
          apply huv_reg 1
          simp [hv0]
        have h1_v0 : (1 : A') ∈ v₀.asIdeal := by
          rw [hv₀_span]
          exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert u {v})) h1_u
        exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_v0)
      have hvu_reg : ∀ x : A', u * x ∈ Ideal.span ({v} : Set A') → x ∈ Ideal.span ({v} : Set A') := by
        intro x hx
        rw [Ideal.mem_span_singleton] at hx ⊢
        obtain ⟨y, hy⟩ := hx
        have hvy_u : v * y ∈ Ideal.span ({u} : Set A') :=
          Ideal.mem_span_singleton.mpr ⟨x, hy.symm⟩
        obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp (huv_reg y hvy_u)
        refine ⟨w, ?_⟩
        apply mul_left_cancel₀ hu_ne
        calc u * x = v * (u * w) := hy
          _ = u * (v * w) := by ring
      have hv₀_span' : v₀.asIdeal = Ideal.span ({v, u} : Set A') := by
        rwa [Set.pair_comm]
      exact hQuotDVRCore A' v₀ v u hv₀_span' hv_ne hvu_reg

  have hDVRMax : ∀ (D₀ T : Type u) [CommRing D₀] [IsDomain D₀] [IsDiscreteValuationRing D₀]
      [CommRing T] [IsDomain T] [IsLocalRing T] (θ_bar : D₀ →+* T) [IsLocalHom θ_bar],
      Function.Injective θ_bar →
      (∀ z : T, ∃ x y : D₀, θ_bar y ≠ 0 ∧ θ_bar y * z = θ_bar x) →
      Function.Surjective θ_bar := by
    intro D₀ T _ _ _ _ _ _ θ_bar _ hInj hFrac
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible D₀
    have hθϖ_ne : θ_bar ϖ ≠ 0 :=
      fun h => hϖ.ne_zero (hInj (h.trans (map_zero θ_bar).symm))
    intro z
    by_cases hz : z = 0
    · exact ⟨0, by rw [map_zero, hz]⟩
    · obtain ⟨x, y, hy_θ, hyz⟩ := hFrac z
      have hy_ne : y ≠ 0 := fun h => hy_θ (by rw [h, map_zero])
      have hx_θ : θ_bar x ≠ 0 := by
        rw [← hyz]
        exact mul_ne_zero hy_θ hz
      have hx_ne : x ≠ 0 := fun h => hx_θ (by rw [h, map_zero])
      obtain ⟨k, hk_x⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx_ne hϖ
      obtain ⟨u_x, rfl⟩ := hk_x.symm
      obtain ⟨m, hk_y⟩ := IsDiscreteValuationRing.associated_pow_irreducible hy_ne hϖ
      obtain ⟨u_y, rfl⟩ := hk_y.symm
      by_cases hlt : k < m
      · exfalso
        have hm_eq : m = k + (m - k - 1) + 1 := by omega
        have h_eq : (θ_bar ϖ) ^ k *
            (θ_bar ϖ * ((θ_bar ϖ) ^ (m - k - 1) * θ_bar u_y * z)) =
            (θ_bar ϖ) ^ k * θ_bar u_x := by
          calc (θ_bar ϖ) ^ k * (θ_bar ϖ * ((θ_bar ϖ) ^ (m - k - 1) * θ_bar u_y * z))
              = (θ_bar ϖ) ^ (k + (m - k - 1) + 1) * θ_bar u_y * z := by
                  rw [pow_succ, pow_add]; ring
            _ = (θ_bar ϖ) ^ m * θ_bar u_y * z := by rw [← hm_eq]
            _ = θ_bar (ϖ ^ m * u_y) * z := by simp [map_mul, map_pow]
            _ = θ_bar (ϖ ^ k * u_x) := hyz
            _ = (θ_bar ϖ) ^ k * θ_bar u_x := by simp [map_mul, map_pow]
        have hcancel := mul_left_cancel₀ (pow_ne_zero k hθϖ_ne) h_eq
        have hu_T : IsUnit (θ_bar u_x) := u_x.isUnit.map θ_bar
        rw [← hcancel] at hu_T
        have hθϖ_unit : IsUnit (θ_bar ϖ) := isUnit_of_mul_isUnit_left hu_T
        exact hϖ.not_isUnit (isUnit_of_map_unit θ_bar ϖ hθϖ_unit)
      · have hm_le : m ≤ k := Nat.le_of_not_lt hlt
        have hk_eq : k = m + (k - m) := (Nat.add_sub_of_le hm_le).symm
        have h_eq : (θ_bar ϖ) ^ m * (θ_bar u_y * z) =
            (θ_bar ϖ) ^ m * θ_bar (ϖ ^ (k - m) * u_x) := by
          calc (θ_bar ϖ) ^ m * (θ_bar u_y * z)
              = θ_bar (ϖ ^ m * u_y) * z := by simp [map_mul, map_pow, mul_assoc]
            _ = θ_bar (ϖ ^ k * u_x) := hyz
            _ = θ_bar (ϖ ^ (m + (k - m)) * u_x) := by rw [← hk_eq]
            _ = (θ_bar ϖ) ^ m * θ_bar (ϖ ^ (k - m) * u_x) := by
                  simp [pow_add, map_mul, map_pow, mul_assoc]
        have hcancel := mul_left_cancel₀ (pow_ne_zero m hθϖ_ne) h_eq
        refine ⟨↑(u_y⁻¹) * (ϖ ^ (k - m) * u_x), ?_⟩
        calc θ_bar (↑(u_y⁻¹) * (ϖ ^ (k - m) * u_x))
            = θ_bar (↑(u_y⁻¹)) * (θ_bar u_y * z) := by rw [map_mul, hcancel]
          _ = θ_bar (↑(u_y⁻¹) * ↑u_y) * z := by rw [← mul_assoc, ← map_mul]
          _ = z := by simp

  
  have hTensorHom : ∀ {R A B M : Type u} [CommRing R] [CommRing A] [CommRing B] [CommRing M]
      [Algebra R A] [Algebra R B] (fA : A →+* M) (fB : B →+* M),
      fA.comp (algebraMap R A) = fB.comp (algebraMap R B) →
      ∃ φ : TensorProduct R A B →+* M, ∀ (a : A) (b : B), φ (a ⊗ₜ[R] b) = fA a * fB b := by
    intro R A B M _ _ _ _ _ _ fA fB hcomm
    letI : Algebra R M := (fA.comp (algebraMap R A)).toAlgebra
    haveI : IsScalarTower R R M := IsScalarTower.left R
    let algA : A →ₐ[R] M := ⟨fA, fun _ => rfl⟩
    let algB : B →ₐ[R] M := ⟨fB, fun r => (RingHom.congr_fun hcomm r).symm⟩
    exact ⟨(Algebra.TensorProduct.lift algA algB (fun _ _ => mul_comm _ _)).toRingHom,
      fun _ _ => rfl⟩

  have hUniquePrimeLoc : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S]
      (P : PrimeSpectrum R) (Q : PrimeSpectrum S),
      (∀ Q' : PrimeSpectrum S, PrimeSpectrum.comap (algebraMap R S) Q' = P ↔ Q' = Q) →
      ∀ (h_comap : P.asIdeal = Ideal.comap (algebraMap R S) Q.asIdeal),
        let L_P := Localization.AtPrime P.asIdeal
        let S_Q := Localization.AtPrime Q.asIdeal
        let φ_PQ := Localization.localRingHom P.asIdeal Q.asIdeal (algebraMap R S) h_comap
        ∃ (e_ring : TensorProduct R L_P S ≃+* S_Q),
          (∀ l : L_P, e_ring (l ⊗ₜ[R] (1 : S)) = φ_PQ l) ∧
          (∀ s : S, e_ring ((1 : L_P) ⊗ₜ[R] s) = algebraMap S S_Q s) := by
    intro R S _ _ _ _ P Q hQ h_comap
    dsimp only
    let L_P := Localization.AtPrime P.asIdeal
    let S_Q := Localization.AtPrime Q.asIdeal
    let φ_PQ : L_P →+* S_Q :=
      Localization.localRingHom P.asIdeal Q.asIdeal (algebraMap R S) h_comap
    let S_P := TensorProduct R L_P S
    let f_S : S →+* S_P := Algebra.TensorProduct.includeRight.toRingHom
    let M₁ : Submonoid S := Algebra.algebraMapSubmonoid S P.asIdeal.primeCompl
    have hM₁_le : M₁ ≤ Q.asIdeal.primeCompl := by
      rintro _ ⟨r, hr, rfl⟩ hmem
      apply hr
      rw [h_comap]
      exact hmem
    have hLoc₁ : @IsLocalization S _ M₁ S_P _ f_S.toAlgebra := by
      let e_comm : TensorProduct R S L_P ≃ₐ[R] S_P := Algebra.TensorProduct.comm R S L_P
      letI : Algebra S S_P := f_S.toAlgebra
      have he_S : ∀ s : S, e_comm (s ⊗ₜ[R] (1 : L_P)) = algebraMap S S_P s := fun _ => rfl
      have _ : IsLocalization M₁ (TensorProduct R S L_P) := inferInstance
      refine ⟨?_, ?_, ?_⟩
      · intro y
        have hu : IsUnit (algebraMap S (TensorProduct R S L_P) y.1) :=
          IsLocalization.map_units (TensorProduct R S L_P) y
        have hu' : IsUnit (e_comm (algebraMap S (TensorProduct R S L_P) y.1)) :=
          hu.map e_comm.toRingHom
        change IsUnit (e_comm (y.1 ⊗ₜ[R] (1 : L_P))) at hu'
        rwa [he_S] at hu'
      · intro z
        obtain ⟨⟨x, m⟩, hxm⟩ := IsLocalization.surj M₁ (e_comm.symm z)
        refine ⟨⟨x, m⟩, ?_⟩
        have h1 : e_comm (e_comm.symm z * (m.1 ⊗ₜ[R] (1 : L_P))) = e_comm (x ⊗ₜ[R] (1 : L_P)) :=
          congrArg e_comm hxm
        rw [map_mul, e_comm.apply_symm_apply, he_S, he_S] at h1
        exact h1
      · intro x y hxy
        have hxy' : algebraMap S (TensorProduct R S L_P) x =
            algebraMap S (TensorProduct R S L_P) y := by
          apply e_comm.injective
          change e_comm (x ⊗ₜ[R] (1 : L_P)) = e_comm (y ⊗ₜ[R] (1 : L_P))
          rw [he_S, he_S]
          exact hxy
        exact IsLocalization.exists_of_eq hxy'
    haveI : Module.Finite L_P S_P := Module.Finite.base_change R L_P S
    haveI : Algebra.IsIntegral L_P S_P := Algebra.IsIntegral.of_finite L_P S_P
    have h_units_Q : ∀ u : Q.asIdeal.primeCompl, IsUnit (f_S u.1) := by
      intro u
      by_contra hnot
      have hne_top : Ideal.span ({f_S u.1} : Set S_P) ≠ ⊤ := by
        rwa [Ne, Ideal.span_singleton_eq_top]
      obtain ⟨𝔪, h𝔪_max, hu_𝔪⟩ := Ideal.exists_le_maximal _ hne_top
      haveI : 𝔪.IsMaximal := h𝔪_max
      have h𝔪_LP_max : (Ideal.comap (algebraMap L_P S_P) 𝔪).IsMaximal := by
        let I_L := Ideal.comap (algebraMap L_P S_P) 𝔪
        haveI hIL_prime : I_L.IsPrime := h𝔪_max.isPrime.comap (algebraMap L_P S_P)
        let K_M := S_P ⧸ 𝔪
        letI : Field K_M := Ideal.Quotient.field 𝔪
        let φ_quot : (L_P ⧸ I_L) →+* K_M :=
          Ideal.Quotient.lift I_L ((Ideal.Quotient.mk 𝔪).comp (algebraMap L_P S_P))
            (fun _ hx => (Ideal.Quotient.eq_zero_iff_mem).mpr hx)
        have hinj_quot : Function.Injective φ_quot := by
          rw [RingHom.injective_iff_ker_eq_bot]
          ext q_bar
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q_bar
          change Ideal.Quotient.mk 𝔪 (algebraMap L_P S_P x) = 0 ↔ Ideal.Quotient.mk I_L x = 0
          rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.Quotient.eq_zero_iff_mem]
          rfl
        letI : Algebra (L_P ⧸ I_L) K_M := φ_quot.toAlgebra
        haveI : Algebra.IsIntegral (L_P ⧸ I_L) K_M := ⟨fun z => by
          obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective z
          obtain ⟨P_pol, hP_mon, hP_ev⟩ := Algebra.IsIntegral.isIntegral (R := L_P) s
          refine ⟨P_pol.map (Ideal.Quotient.mk I_L), hP_mon.map _, ?_⟩
          rw [Polynomial.eval₂_map]
          change Polynomial.eval₂ ((Ideal.Quotient.mk 𝔪).comp (algebraMap L_P S_P))
            (Ideal.Quotient.mk 𝔪 s) P_pol = 0
          rw [← Polynomial.hom_eval₂, hP_ev, map_zero]⟩
        have hField_L : IsField (L_P ⧸ I_L) :=
          (Algebra.IsIntegral.isField_iff_isField (R := L_P ⧸ I_L) (S := K_M) hinj_quot).mpr
            (Field.toIsField K_M)
        refine ⟨hIL_prime.ne_top, fun J hlt => ?_⟩
        obtain ⟨x, hxJ, hx_not_IL⟩ := SetLike.exists_of_lt hlt
        have hmk_ne : Ideal.Quotient.mk I_L x ≠ 0 :=
          fun h0 => hx_not_IL ((Ideal.Quotient.eq_zero_iff_mem).mp h0)
        obtain ⟨q_inv, hq_inv⟩ := hField_L.mul_inv_cancel hmk_ne
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q_inv
        have hsub_IL : x * y - 1 ∈ I_L :=
          (Ideal.Quotient.eq_zero_iff_mem).mp (by simpa [map_sub, map_mul] using sub_eq_zero.mpr hq_inv)
        have hsub_J : x * y - 1 ∈ J := le_of_lt hlt hsub_IL
        have h1_J : (1 : L_P) ∈ J := by
          have hmem := Ideal.sub_mem J (Ideal.mul_mem_right y J hxJ) hsub_J
          have heq : x * y - (x * y - 1) = 1 := by ring
          rwa [heq] at hmem
        exact (Ideal.eq_top_iff_one J).mpr h1_J
      have h𝔪_LP_eq : Ideal.comap (algebraMap L_P S_P) 𝔪 = IsLocalRing.maximalIdeal L_P :=
        IsLocalRing.eq_maximalIdeal h𝔪_LP_max
      let Q' : PrimeSpectrum S := ⟨Ideal.comap f_S 𝔪, h𝔪_max.isPrime.comap f_S⟩
      have hQ'_over_P : PrimeSpectrum.comap (algebraMap R S) Q' = P := by
        ext r
        change f_S (algebraMap R S r) ∈ 𝔪 ↔ r ∈ P.asIdeal
        have hcomm_r : f_S (algebraMap R S r) = algebraMap L_P S_P (algebraMap R L_P r) := by
          change (1 : L_P) ⊗ₜ[R] (algebraMap R S r) = (algebraMap R L_P r) ⊗ₜ[R] (1 : S)
          rw [Algebra.algebraMap_eq_smul_one (A := S), TensorProduct.tmul_smul,
            TensorProduct.smul_tmul', Algebra.algebraMap_eq_smul_one (A := L_P)]
        rw [hcomm_r]
        change algebraMap R L_P r ∈ Ideal.comap (algebraMap L_P S_P) 𝔪 ↔ r ∈ P.asIdeal
        rw [h𝔪_LP_eq]
        exact IsLocalization.AtPrime.to_map_mem_maximal_iff L_P P.asIdeal r
      have hQ'_eq : Q' = Q := (hQ Q').mp hQ'_over_P
      have hu_in_Q' : u.1 ∈ Q'.asIdeal :=
        hu_𝔪 (Ideal.subset_span (Set.mem_singleton (f_S u.1)))
      rw [hQ'_eq] at hu_in_Q'
      exact u.2 hu_in_Q'
    letI : Algebra S S_P := f_S.toAlgebra
    haveI : IsLocalization Q.asIdeal.primeCompl S_P := by
      refine ⟨h_units_Q, ?_, ?_⟩
      · intro z
        obtain ⟨⟨x, m⟩, hxm⟩ := @IsLocalization.surj S _ M₁ S_P _ f_S.toAlgebra hLoc₁ z
        exact ⟨⟨x, ⟨m.1, hM₁_le m.2⟩⟩, hxm⟩
      · intro x y hxy
        obtain ⟨m, hm⟩ := @IsLocalization.exists_of_eq S _ M₁ S_P _ f_S.toAlgebra hLoc₁ x y hxy
        exact ⟨⟨m.1, hM₁_le m.2⟩, hm⟩
    let e_alg : S_P ≃ₐ[S] S_Q :=
      IsLocalization.algEquiv Q.asIdeal.primeCompl S_P S_Q
    let e_ring : S_P ≃+* S_Q := e_alg.toRingEquiv
    have he_fS : ∀ s : S, e_ring ((1 : L_P) ⊗ₜ[R] s) = algebraMap S S_Q s := fun s =>
      e_alg.commutes s
    have he_LP : ∀ l : L_P, e_ring (l ⊗ₜ[R] (1 : S)) = φ_PQ l := by
      intro l
      obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj P.asIdeal.primeCompl l
      have hs_Q : algebraMap R S (s : R) ∈ Q.asIdeal.primeCompl := by
        intro hmem
        let s₀ : R := s.1
        have hs₀ : s₀ ∈ Ideal.comap (algebraMap R S) Q.asIdeal := hmem
        rw [← h_comap] at hs₀
        exact s.2 hs₀
      have hs_unit : IsUnit (algebraMap S S_Q (algebraMap R S (s : R))) :=
        IsLocalization.map_units S_Q ⟨algebraMap R S (s : R), hs_Q⟩
      apply hs_unit.mul_left_injective
      have hcomm_R : ∀ a : R,
          (algebraMap R L_P a) ⊗ₜ[R] (1 : S) = (1 : L_P) ⊗ₜ[R] (algebraMap R S a) := by
        intro a
        rw [Algebra.algebraMap_eq_smul_one (A := L_P), TensorProduct.smul_tmul,
          Algebra.algebraMap_eq_smul_one (A := S)]
      have hφ_R : ∀ a : R, φ_PQ (algebraMap R L_P a) = algebraMap S S_Q (algebraMap R S a) :=
        fun a => Localization.localRingHom_to_map P.asIdeal Q.asIdeal (algebraMap R S) h_comap a
      calc e_ring (l ⊗ₜ[R] (1 : S)) * algebraMap S S_Q (algebraMap R S (s : R))
          = e_ring (l ⊗ₜ[R] (1 : S)) * e_ring ((1 : L_P) ⊗ₜ[R] algebraMap R S (s : R)) := by
              rw [he_fS]
        _ = e_ring ((l * algebraMap R L_P (s : R)) ⊗ₜ[R] (1 : S)) := by
              rw [← hcomm_R, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        _ = e_ring ((1 : L_P) ⊗ₜ[R] algebraMap R S r) := by rw [hrs, hcomm_R]
        _ = algebraMap S S_Q (algebraMap R S r) := he_fS _
        _ = φ_PQ (l * algebraMap R L_P (s : R)) := by rw [← hφ_R, ← hrs]
        _ = φ_PQ l * algebraMap S S_Q (algebraMap R S (s : R)) := by rw [map_mul, hφ_R]
    exact ⟨e_ring, he_LP, he_fS⟩

  have hEtaleSurj :
      ∀ (R₀ A' B_P1 : Type u) [CommRing R₀] [IsDomain R₀] [IsNoetherianRing R₀]
        [CommRing A'] [IsDomain A'] [CommRing B_P1] [IsDomain B_P1]
        (φ₀ : PowerSeries Ω →+* R₀) (f_et : R₀ →+* A') (f_RB : R₀ →+* B_P1)
        (p₀ : PrimeSpectrum R₀) (v₀ : PrimeSpectrum A') (q_pt : PrimeSpectrum B_P1)
        (u v ε : A') (a_y b_y : ℕ)
        (h_comap : p₀.asIdeal = Ideal.comap f_RB q_pt.asIdeal),
        (letI : Algebra R₀ A' := f_et.toAlgebra; Algebra.Etale R₀ A') →
        f_RB.Finite →
        (∀ v' : PrimeSpectrum A', PrimeSpectrum.comap f_et v' = p₀ ↔ v' = v₀) →
        (∀ q : PrimeSpectrum B_P1, PrimeSpectrum.comap f_RB q = p₀ ↔ q = q_pt) →
        (∀ r : R₀, ∃ c : Ω, r - φ₀ (PowerSeries.C c) ∈ p₀.asIdeal) →
        (∀ r' : A', ∃ c : Ω, r' - f_et (φ₀ (PowerSeries.C c)) ∈ v₀.asIdeal) →
        v₀.asIdeal = Ideal.span ({u, v} : Set A') →
        u ≠ 0 →
        (∀ y : A', v * y ∈ Ideal.span ({u} : Set A') → y ∈ Ideal.span ({u} : Set A')) →
        IsUnit ε →
        1 ≤ a_y →
        f_et (φ₀ PowerSeries.X) = ε * u ^ a_y * v ^ b_y →
        f_RB (φ₀ PowerSeries.X) = 0 →
        IsDiscreteValuationRing (Localization.AtPrime q_pt.asIdeal) →
        (∀ b : B_P1, ∃ r s : R₀, f_RB s ≠ 0 ∧ f_RB s * b = f_RB r) →
        Function.Surjective (Localization.localRingHom p₀.asIdeal q_pt.asIdeal f_RB h_comap) := by
    intro R₀ A' B_P1 _ _ _ _ _ _ _ φ₀ f_et f_RB p₀ v₀ q_pt u v ε a_y b_y h_comap
      hEt hFinRB hv₀_uniq hq_uniq hp₀_res hv₀_res hv₀_span hu_ne huv_reg
      hε _ha_pos hX_nc hf_X hDVR_LB hGenSurj
    letI : Algebra R₀ A' := f_et.toAlgebra
    letI : Algebra R₀ B_P1 := f_RB.toAlgebra
    haveI : Algebra.Etale R₀ A' := hEt
    haveI : Module.Finite R₀ B_P1 := hFinRB
    haveI : Algebra.FiniteType R₀ A' := inferInstance
    haveI : IsNoetherianRing A' := Algebra.FiniteType.isNoetherianRing R₀ A'
    haveI : IsNoetherian R₀ B_P1 := inferInstance
    haveI : IsNoetherianRing B_P1 := isNoetherianRing_iff.mpr ⟨fun I => by
      obtain ⟨s, hs⟩ := IsNoetherian.noetherian (I.restrictScalars R₀)
      refine ⟨s, le_antisymm ?_ ?_⟩
      · exact Ideal.span_le.mpr (by
          have hsub : (s : Set B_P1) ⊆ (I.restrictScalars R₀ : Set B_P1) := by
            rw [← hs]
            exact Submodule.subset_span
          exact hsub)
      · intro x hx
        have hx' : x ∈ Submodule.span R₀ (s : Set B_P1) := by
          rw [hs]
          exact hx
        have hle : Submodule.span R₀ (s : Set B_P1) ≤
            (Ideal.span (s : Set B_P1)).restrictScalars R₀ :=
          Submodule.span_le.mpr (fun _ hy => Ideal.subset_span hy)
        exact hle hx'⟩

    let B'_P1 := TensorProduct R₀ B_P1 A'
    let ι_L : B_P1 →+* B'_P1 := algebraMap B_P1 B'_P1
    let ι_R : A' →+* B'_P1 := Algebra.TensorProduct.includeRight.toRingHom
    have h_ι_comm : ι_L.comp f_RB = ι_R.comp f_et := by
      ext r
      change (algebraMap R₀ B_P1 r) ⊗ₜ[R₀] (1 : A') = (1 : B_P1) ⊗ₜ[R₀] (algebraMap R₀ A' r)
      rw [Algebra.algebraMap_eq_smul_one (A := B_P1), TensorProduct.smul_tmul,
        Algebra.algebraMap_eq_smul_one (A := A')]
    haveI : Algebra.Etale B_P1 B'_P1 := inferInstance
    haveI : Algebra.FiniteType B_P1 B'_P1 := inferInstance
    haveI : IsNoetherianRing B'_P1 := Algebra.FiniteType.isNoetherianRing B_P1 B'_P1

    let c_R : Ω →+* R₀ := φ₀.comp PowerSeries.C
    have hp0_v0_comap : p₀.asIdeal = Ideal.comap f_et v₀.asIdeal := by
      have h1 : PrimeSpectrum.comap f_et v₀ = p₀ := (hv₀_uniq v₀).mpr rfl
      exact (congrArg PrimeSpectrum.asIdeal h1).symm

    let α_R : Ω →+* (R₀ ⧸ p₀.asIdeal) := (Ideal.Quotient.mk p₀.asIdeal).comp c_R
    have hSurj_αR : Function.Surjective α_R := by
      intro q_bar
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q_bar
      obtain ⟨c, hc⟩ := hp₀_res r
      refine ⟨c, ?_⟩
      have h0 : Ideal.Quotient.mk p₀.asIdeal r - Ideal.Quotient.mk p₀.asIdeal (c_R c) = 0 := by
        rw [← map_sub]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr hc
      exact (sub_eq_zero.mp h0).symm
    haveI : Nontrivial (R₀ ⧸ p₀.asIdeal) :=
      Ideal.Quotient.nontrivial_iff.mpr p₀.isPrime.ne_top
    let e_resR : Ω ≃+* (R₀ ⧸ p₀.asIdeal) :=
      RingEquiv.ofBijective α_R ⟨α_R.injective, hSurj_αR⟩
    let χ_R : R₀ →+* Ω := e_resR.symm.toRingHom.comp (Ideal.Quotient.mk p₀.asIdeal)
    have hχR_ker : RingHom.ker χ_R = p₀.asIdeal := by
      ext r
      change e_resR.symm (Ideal.Quotient.mk p₀.asIdeal r) = 0 ↔ r ∈ p₀.asIdeal
      rw [map_eq_zero_iff e_resR.symm e_resR.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hχR_c : ∀ c : Ω, χ_R (c_R c) = c := fun c => e_resR.symm_apply_apply c

    let α_A' : Ω →+* (A' ⧸ v₀.asIdeal) :=
      (Ideal.Quotient.mk v₀.asIdeal).comp (f_et.comp c_R)
    have hSurj_αA' : Function.Surjective α_A' := by
      intro q_bar
      obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective q_bar
      obtain ⟨c, hc⟩ := hv₀_res r'
      refine ⟨c, ?_⟩
      have h0 : Ideal.Quotient.mk v₀.asIdeal r' -
          Ideal.Quotient.mk v₀.asIdeal (f_et (c_R c)) = 0 := by
        rw [← map_sub]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr hc
      exact (sub_eq_zero.mp h0).symm
    haveI : Nontrivial (A' ⧸ v₀.asIdeal) :=
      Ideal.Quotient.nontrivial_iff.mpr v₀.isPrime.ne_top
    let e_resA' : Ω ≃+* (A' ⧸ v₀.asIdeal) :=
      RingEquiv.ofBijective α_A' ⟨α_A'.injective, hSurj_αA'⟩
    let χ_A' : A' →+* Ω := e_resA'.symm.toRingHom.comp (Ideal.Quotient.mk v₀.asIdeal)
    have hχA'_ker : RingHom.ker χ_A' = v₀.asIdeal := by
      ext r'
      change e_resA'.symm (Ideal.Quotient.mk v₀.asIdeal r') = 0 ↔ r' ∈ v₀.asIdeal
      rw [map_eq_zero_iff e_resA'.symm e_resA'.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hχA'_c : ∀ c : Ω, χ_A' (f_et (c_R c)) = c := fun c => e_resA'.symm_apply_apply c
    have hχA'_comp : χ_A'.comp f_et = χ_R := by
      ext r
      obtain ⟨c, hc⟩ := hp₀_res r
      have hc_v0 : f_et (r - c_R c) ∈ v₀.asIdeal := by
        change r - c_R c ∈ Ideal.comap f_et v₀.asIdeal
        rwa [← hp0_v0_comap]
      have h1 : χ_A' (f_et r) = χ_A' (f_et (c_R c)) := by
        apply sub_eq_zero.mp
        rw [← map_sub, ← map_sub, ← RingHom.mem_ker, hχA'_ker]
        exact hc_v0
      have h2 : χ_R r = χ_R (c_R c) := by
        apply sub_eq_zero.mp
        rw [← map_sub, ← RingHom.mem_ker, hχR_ker]
        exact hc
      rw [RingHom.comp_apply, h1, hχA'_c, h2, hχR_c]

    let Q_B := B_P1 ⧸ q_pt.asIdeal
    let β_RB : (R₀ ⧸ p₀.asIdeal) →+* Q_B :=
      Ideal.Quotient.lift p₀.asIdeal ((Ideal.Quotient.mk q_pt.asIdeal).comp f_RB) (by
        intro r hr
        rw [h_comap] at hr
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr hr)
    let α_B : Ω →+* Q_B := β_RB.comp e_resR.toRingHom
    have hαB_χR : ∀ r : R₀, α_B (χ_R r) = Ideal.Quotient.mk q_pt.asIdeal (f_RB r) := by
      intro r
      change β_RB (e_resR (e_resR.symm (Ideal.Quotient.mk p₀.asIdeal r))) = _
      rw [e_resR.apply_symm_apply]
      rfl
    haveI : Algebra.IsIntegral R₀ B_P1 := Algebra.IsIntegral.of_finite R₀ B_P1
    have hInt_αB : α_B.IsIntegral := by
      intro q_bar
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q_bar
      obtain ⟨P, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := R₀) b
      refine ⟨P.map χ_R, hP_monic.map χ_R, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp_eq : α_B.comp χ_R = (Ideal.Quotient.mk q_pt.asIdeal).comp f_RB := by
        ext r
        exact hαB_χR r
      rw [hcomp_eq, ← Polynomial.hom_eval₂]
      exact (congrArg (Ideal.Quotient.mk q_pt.asIdeal) hP_eval).trans (map_zero _)
    have hBij_αB : Function.Bijective α_B :=
      IsAlgClosed.ringHom_bijective_of_isIntegral α_B hInt_αB
    let e_resB : Ω ≃+* Q_B := RingEquiv.ofBijective α_B hBij_αB
    let χ_B : B_P1 →+* Ω := e_resB.symm.toRingHom.comp (Ideal.Quotient.mk q_pt.asIdeal)
    have hχB_ker : RingHom.ker χ_B = q_pt.asIdeal := by
      ext b
      change e_resB.symm (Ideal.Quotient.mk q_pt.asIdeal b) = 0 ↔ b ∈ q_pt.asIdeal
      rw [map_eq_zero_iff e_resB.symm e_resB.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hχB_comp : χ_B.comp f_RB = χ_R := by
      ext r
      apply e_resB.injective
      change e_resB (e_resB.symm (Ideal.Quotient.mk q_pt.asIdeal (f_RB r))) = α_B (χ_R r)
      rw [e_resB.apply_symm_apply, hαB_χR]

    obtain ⟨χ_otimes, hχ_tmul⟩ :=
      hTensorHom (R := R₀) χ_B χ_A' (hχB_comp.trans hχA'_comp.symm)
    let w₀ : PrimeSpectrum B'_P1 := ⟨RingHom.ker χ_otimes, RingHom.ker_isPrime χ_otimes⟩
    haveI : w₀.asIdeal.IsPrime := w₀.isPrime
    have hw₀_L : PrimeSpectrum.comap ι_L w₀ = q_pt := by
      ext b
      change χ_otimes (b ⊗ₜ[R₀] 1) = 0 ↔ b ∈ q_pt.asIdeal
      rw [hχ_tmul, map_one, mul_one, ← RingHom.mem_ker, hχB_ker]
    have hw₀_R : PrimeSpectrum.comap ι_R w₀ = v₀ := by
      ext a'
      change χ_otimes (1 ⊗ₜ[R₀] a') = 0 ↔ a' ∈ v₀.asIdeal
      rw [hχ_tmul, map_one, one_mul, ← RingHom.mem_ker, hχA'_ker]
    have h_qw_comap : q_pt.asIdeal = Ideal.comap ι_L w₀.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hw₀_L).symm
    have h_vw_comap : v₀.asIdeal = Ideal.comap ι_R w₀.asIdeal :=
      (congrArg PrimeSpectrum.asIdeal hw₀_R).symm

    have hdecomp_B' : ∀ x : B'_P1, ∃ (b : B_P1) (y : B'_P1),
        y ∈ Ideal.map ι_R v₀.asIdeal ∧ x = ι_L b + y := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, Ideal.zero_mem _, by simp⟩
      | tmul b a' =>
        obtain ⟨c, hc⟩ := hv₀_res a'
        let v' : A' := a' - f_et (c_R c)
        have ha'_eq : a' = f_et (c_R c) + v' := by simp [v']
        have hf_smul : f_et (c_R c) = c_R c • (1 : A') :=
          Algebra.algebraMap_eq_smul_one (A := A') (c_R c)
        refine ⟨f_RB (c_R c) * b, ι_L b * ι_R v',
          Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem ι_R hc), ?_⟩
        calc b ⊗ₜ[R₀] a'
            = b ⊗ₜ[R₀] (f_et (c_R c) + v') := by rw [← ha'_eq]
          _ = b ⊗ₜ[R₀] (c_R c • (1 : A')) + b ⊗ₜ[R₀] v' := by
                rw [TensorProduct.tmul_add, hf_smul]
          _ = (c_R c • b) ⊗ₜ[R₀] (1 : A') + (b ⊗ₜ[R₀] (1 : A')) * ((1 : B_P1) ⊗ₜ[R₀] v') := by
                rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul',
                  Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          _ = ι_L (f_RB (c_R c) * b) + ι_L b * ι_R v' := rfl
      | add x₁ x₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨b₁, y₁, hy₁, rfl⟩
        rcases ih₂ with ⟨b₂, y₂, hy₂, rfl⟩
        exact ⟨b₁ + b₂, y₁ + y₂, Ideal.add_mem _ hy₁ hy₂, by rw [map_add]; ring⟩

    have hw₀_uniq : ∀ W : PrimeSpectrum B'_P1, PrimeSpectrum.comap ι_R W = v₀ ↔ W = w₀ := by
      intro W
      constructor
      · intro hW
        have hWL_over_p0 : PrimeSpectrum.comap f_RB (PrimeSpectrum.comap ι_L W) = p₀ := by
          ext r
          change ι_L (f_RB r) ∈ W.asIdeal ↔ r ∈ p₀.asIdeal
          have h_eq := RingHom.congr_fun h_ι_comm r
          simp only [RingHom.comp_apply] at h_eq
          rw [h_eq]
          have hWv : Ideal.comap ι_R W.asIdeal = v₀.asIdeal := congrArg PrimeSpectrum.asIdeal hW
          change f_et r ∈ Ideal.comap ι_R W.asIdeal ↔ r ∈ p₀.asIdeal
          rw [hWv, hp0_v0_comap]
          rfl
        have hWL : PrimeSpectrum.comap ι_L W = q_pt := (hq_uniq _).mp hWL_over_p0
        have hmap_W : Ideal.map ι_R v₀.asIdeal ≤ W.asIdeal :=
          Ideal.map_le_iff_le_comap.mpr (le_of_eq (congrArg PrimeSpectrum.asIdeal hW).symm)
        have hmap_w0 : Ideal.map ι_R v₀.asIdeal ≤ w₀.asIdeal :=
          Ideal.map_le_iff_le_comap.mpr (le_of_eq h_vw_comap)
        ext x
        obtain ⟨b, y, hy, rfl⟩ := hdecomp_B' x
        have h1 : ι_L b + y ∈ W.asIdeal ↔ ι_L b ∈ W.asIdeal :=
          Ideal.add_mem_iff_left W.asIdeal (hmap_W hy)
        have h2 : ι_L b + y ∈ w₀.asIdeal ↔ ι_L b ∈ w₀.asIdeal :=
          Ideal.add_mem_iff_left w₀.asIdeal (hmap_w0 hy)
        rw [h1, h2]
        change b ∈ (PrimeSpectrum.comap ι_L W).asIdeal ↔ b ∈ (PrimeSpectrum.comap ι_L w₀).asIdeal
        rw [hWL, hw₀_L]
      · rintro rfl
        exact hw₀_R

    let L_R := Localization.AtPrime p₀.asIdeal
    let L_B := Localization.AtPrime q_pt.asIdeal
    let L_A' := Localization.AtPrime v₀.asIdeal
    let T_loc := Localization.AtPrime w₀.asIdeal
    haveI : IsNoetherianRing T_loc :=
      IsLocalization.isNoetherianRing w₀.asIdeal.primeCompl T_loc inferInstance
    let φ_loc : L_R →+* L_B := Localization.localRingHom p₀.asIdeal q_pt.asIdeal f_RB h_comap
    let ψ_et : L_R →+* L_A' := Localization.localRingHom p₀.asIdeal v₀.asIdeal f_et hp0_v0_comap
    let lam : L_B →+* T_loc := Localization.localRingHom q_pt.asIdeal w₀.asIdeal ι_L h_qw_comap
    let θ_A' : L_A' →+* T_loc := Localization.localRingHom v₀.asIdeal w₀.asIdeal ι_R h_vw_comap

    have h_loc_comm : θ_A'.comp ψ_et = lam.comp φ_loc := by
      apply IsLocalization.ringHom_ext p₀.asIdeal.primeCompl
      ext r
      simp only [RingHom.comp_apply]
      have h_eq := RingHom.congr_fun h_ι_comm r
      simp only [RingHom.comp_apply] at h_eq
      calc θ_A' (ψ_et (algebraMap R₀ L_R r))
          = θ_A' (algebraMap A' L_A' (f_et r)) := by
              rw [Localization.localRingHom_to_map p₀.asIdeal v₀.asIdeal f_et hp0_v0_comap r]
        _ = algebraMap B'_P1 T_loc (ι_R (f_et r)) :=
              Localization.localRingHom_to_map v₀.asIdeal w₀.asIdeal ι_R h_vw_comap (f_et r)
        _ = algebraMap B'_P1 T_loc (ι_L (f_RB r)) := by rw [← h_eq]
        _ = lam (algebraMap B_P1 L_B (f_RB r)) :=
              (Localization.localRingHom_to_map q_pt.asIdeal w₀.asIdeal ι_L h_qw_comap (f_RB r)).symm
        _ = lam (φ_loc (algebraMap R₀ L_R r)) := by
              rw [Localization.localRingHom_to_map p₀.asIdeal q_pt.asIdeal f_RB h_comap r]

    have h_Tloc_A' :
        (@Module.Finite L_A' T_loc _ _ θ_A'.toAlgebra.toModule) ∧
        (letI : Algebra L_R L_A' := ψ_et.toAlgebra
         letI : Algebra L_R L_B := φ_loc.toAlgebra
         ∃ Φ_fwd : TensorProduct L_R L_A' L_B →+* T_loc,
           Function.Injective Φ_fwd ∧
           ∀ a_loc : L_A', Φ_fwd (a_loc ⊗ₜ[L_R] (1 : L_B)) = θ_A' a_loc) := by
      let algA'_B' : Algebra A' B'_P1 := ι_R.toAlgebra
      have hFin_A'_B' : @Module.Finite A' B'_P1 _ _ algA'_B'.toModule := by
        letI : Algebra A' B'_P1 := algA'_B'
        let e_comm : TensorProduct R₀ A' B_P1 ≃+* B'_P1 :=
          (Algebra.TensorProduct.comm R₀ A' B_P1).toRingEquiv
        let e_lin : TensorProduct R₀ A' B_P1 ≃ₗ[A'] B'_P1 :=
          { e_comm with
            map_smul' := fun a' x => by
              rw [RingHom.id_apply, Algebra.smul_def, Algebra.smul_def]
              exact map_mul e_comm (a' ⊗ₜ[R₀] (1 : B_P1)) x }
        exact Module.Finite.equiv e_lin
      obtain ⟨e_3, he3_LA', he3_B'⟩ :=
        @hUniquePrimeLoc A' B'_P1 _ _ algA'_B' hFin_A'_B' v₀ w₀ hw₀_uniq h_vw_comap
      have hFin_LA'_T : @Module.Finite L_A' T_loc _ _ θ_A'.toAlgebra.toModule := by
        letI : Algebra A' B'_P1 := algA'_B'
        letI : Algebra L_A' T_loc := θ_A'.toAlgebra
        haveI : Module.Finite L_A' (TensorProduct A' L_A' B'_P1) :=
          Module.Finite.base_change A' L_A' B'_P1
        let e_lin3 : TensorProduct A' L_A' B'_P1 ≃ₗ[L_A'] T_loc :=
          { e_3 with
            map_smul' := fun l x => by
              rw [RingHom.id_apply]
              change e_3 (l • x) = θ_A' l * e_3 x
              induction x using TensorProduct.induction_on with
              | zero => simp
              | tmul l' b' =>
                change e_3 ((l * l') ⊗ₜ[A'] b') = θ_A' l * e_3 (l' ⊗ₜ[A'] b')
                have hsplit : ((l * l') ⊗ₜ[A'] b' : TensorProduct A' L_A' B'_P1) =
                    (l ⊗ₜ[A'] (1 : B'_P1)) * (l' ⊗ₜ[A'] b') := by
                  rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
                rw [hsplit, map_mul, he3_LA']
                rfl
              | add x₁ x₂ hx₁ hx₂ =>
                rw [smul_add, map_add, map_add, hx₁, hx₂, mul_add] }
        exact Module.Finite.equiv e_lin3
      refine ⟨hFin_LA'_T, ?_⟩
      letI : Algebra L_R L_A' := ψ_et.toAlgebra
      letI : Algebra L_R L_B := φ_loc.toAlgebra
      obtain ⟨Φ_fwd, hΦ_tmul⟩ :=
        hTensorHom (R := L_R) θ_A' lam h_loc_comm
      let M₀ := TensorProduct L_R L_A' L_B
      let j_B_hom : B_P1 →+* M₀ :=
        Algebra.TensorProduct.includeRight.toRingHom.comp (algebraMap B_P1 L_B)
      let j_A'_hom : A' →+* M₀ :=
        (algebraMap L_A' M₀).comp (algebraMap A' L_A')
      have hj_comm : j_B_hom.comp (algebraMap R₀ B_P1) = j_A'_hom.comp (algebraMap R₀ A') := by
        ext r
        change (1 : L_A') ⊗ₜ[L_R] (algebraMap B_P1 L_B (f_RB r)) =
          (algebraMap A' L_A' (f_et r)) ⊗ₜ[L_R] (1 : L_B)
        have h1 : algebraMap B_P1 L_B (f_RB r) = φ_loc (algebraMap R₀ L_R r) :=
          (Localization.localRingHom_to_map p₀.asIdeal q_pt.asIdeal f_RB h_comap r).symm
        have h2 : algebraMap A' L_A' (f_et r) = ψ_et (algebraMap R₀ L_R r) :=
          (Localization.localRingHom_to_map p₀.asIdeal v₀.asIdeal f_et hp0_v0_comap r).symm
        have h1' : φ_loc (algebraMap R₀ L_R r) = (algebraMap R₀ L_R r) • (1 : L_B) :=
          Algebra.algebraMap_eq_smul_one (A := L_B) (algebraMap R₀ L_R r)
        have h2' : ψ_et (algebraMap R₀ L_R r) = (algebraMap R₀ L_R r) • (1 : L_A') :=
          Algebra.algebraMap_eq_smul_one (A := L_A') (algebraMap R₀ L_R r)
        rw [h1, h2, h1', h2', TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      obtain ⟨j_B', hj_B'_tmul⟩ := hTensorHom (R := R₀) j_B_hom j_A'_hom hj_comm
      obtain ⟨Ψ_bwd, hΨ_tmul⟩ := @hTensorHom A' L_A' B'_P1 M₀ _ _ _ _ _ algA'_B'
        (algebraMap L_A' M₀) j_B' (by
          ext a'
          change (algebraMap A' L_A' a') ⊗ₜ[L_R] (1 : L_B) = j_B' ((1 : B_P1) ⊗ₜ[R₀] a')
          rw [hj_B'_tmul, map_one, one_mul]
          rfl)
      let g_ret : M₀ →+* M₀ := (Ψ_bwd.comp e_3.symm.toRingHom).comp Φ_fwd
      have hg_L : ∀ a_loc : L_A', g_ret (a_loc ⊗ₜ[L_R] (1 : L_B)) = a_loc ⊗ₜ[L_R] (1 : L_B) := by
        intro a_loc
        have h1 : Φ_fwd (a_loc ⊗ₜ[L_R] (1 : L_B)) = θ_A' a_loc := by
          rw [hΦ_tmul, map_one, mul_one]
        have h2 : e_3.symm (θ_A' a_loc) =
            @TensorProduct.tmul A' _ L_A' B'_P1 _ _ _ algA'_B'.toModule a_loc 1 := by
          apply e_3.injective
          rw [e_3.apply_symm_apply]
          exact (he3_LA' a_loc).symm
        change Ψ_bwd (e_3.symm (Φ_fwd (a_loc ⊗ₜ[L_R] 1))) = _
        rw [h1, h2, hΨ_tmul, map_one, mul_one]
        rfl
      have hg_B_base : ∀ c : B_P1,
          g_ret ((1 : L_A') ⊗ₜ[L_R] algebraMap B_P1 L_B c) =
            (1 : L_A') ⊗ₜ[L_R] algebraMap B_P1 L_B c := by
        intro c
        have h1 : Φ_fwd ((1 : L_A') ⊗ₜ[L_R] algebraMap B_P1 L_B c) =
            algebraMap B'_P1 T_loc (ι_L c) := by
          rw [hΦ_tmul, map_one, one_mul, Localization.localRingHom_to_map]
        have h2 : e_3.symm (algebraMap B'_P1 T_loc (ι_L c)) =
            @TensorProduct.tmul A' _ L_A' B'_P1 _ _ _ algA'_B'.toModule 1 (ι_L c) := by
          apply e_3.injective
          rw [e_3.apply_symm_apply]
          exact (he3_B' (ι_L c)).symm
        change Ψ_bwd (e_3.symm (Φ_fwd (1 ⊗ₜ[L_R] algebraMap B_P1 L_B c))) = _
        rw [h1, h2, hΨ_tmul, map_one, one_mul]
        change j_B' (c ⊗ₜ[R₀] 1) = _
        rw [hj_B'_tmul, map_one, mul_one]
        rfl
      have hg_R : ∀ b_loc : L_B, g_ret ((1 : L_A') ⊗ₜ[L_R] b_loc) = (1 : L_A') ⊗ₜ[L_R] b_loc := by
        intro b_loc
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj q_pt.asIdeal.primeCompl b_loc
        let u_s : M₀ := (1 : L_A') ⊗ₜ[L_R] algebraMap B_P1 L_B (s : B_P1)
        have hu_s : IsUnit u_s :=
          (IsLocalization.map_units L_B s).map Algebra.TensorProduct.includeRight.toRingHom
        have hmul_ten : ((1 : L_A') ⊗ₜ[L_R] b_loc) * u_s =
            (1 : L_A') ⊗ₜ[L_R] (b_loc * algebraMap B_P1 L_B (s : B_P1)) := by
          dsimp only [u_s]
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        apply hu_s.mul_left_injective
        calc g_ret ((1 : L_A') ⊗ₜ[L_R] b_loc) * u_s
            = g_ret ((1 : L_A') ⊗ₜ[L_R] b_loc) * g_ret u_s := by rw [hg_B_base (s : B_P1)]
          _ = g_ret (((1 : L_A') ⊗ₜ[L_R] b_loc) * u_s) := (map_mul g_ret _ _).symm
          _ = g_ret ((1 : L_A') ⊗ₜ[L_R] (b_loc * algebraMap B_P1 L_B (s : B_P1))) := by
                rw [hmul_ten]
          _ = g_ret ((1 : L_A') ⊗ₜ[L_R] algebraMap B_P1 L_B b) := by rw [hbs]
          _ = (1 : L_A') ⊗ₜ[L_R] algebraMap B_P1 L_B b := hg_B_base b
          _ = (1 : L_A') ⊗ₜ[L_R] (b_loc * algebraMap B_P1 L_B (s : B_P1)) := by rw [hbs]
          _ = ((1 : L_A') ⊗ₜ[L_R] b_loc) * u_s := hmul_ten.symm
      have hg_id : ∀ x : M₀, g_ret x = x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => exact map_zero g_ret
        | tmul a_loc b_loc =>
          have hsplit : (a_loc ⊗ₜ[L_R] b_loc : M₀) =
              (a_loc ⊗ₜ[L_R] (1 : L_B)) * ((1 : L_A') ⊗ₜ[L_R] b_loc) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hsplit, map_mul, hg_L, hg_R]
        | add x₁ x₂ hx₁ hx₂ => rw [map_add, hx₁, hx₂]
      refine ⟨Φ_fwd, ?_, fun a_loc => by rw [hΦ_tmul, map_one, mul_one]⟩
      intro x₁ x₂ h_eq
      calc x₁ = g_ret x₁ := (hg_id x₁).symm
        _ = Ψ_bwd (e_3.symm (Φ_fwd x₁)) := rfl
        _ = Ψ_bwd (e_3.symm (Φ_fwd x₂)) := by rw [h_eq]
        _ = g_ret x₂ := rfl
        _ = x₂ := hg_id x₂

    have hDomDVR_T : ∃ (hDomT : IsDomain T_loc),
        letI : IsDomain T_loc := hDomT
        ¬ IsField T_loc ∧ IsDiscreteValuationRing T_loc ∧ Function.Injective lam := by
      letI : Algebra L_B T_loc := lam.toAlgebra
      haveI : IsScalarTower B_P1 L_B T_loc := IsScalarTower.of_algebraMap_eq fun b => by
        change algebraMap B_P1 T_loc b = lam (algebraMap B_P1 L_B b)
        rw [IsScalarTower.algebraMap_apply B_P1 B'_P1 T_loc, Localization.localRingHom_to_map]
      haveI : IsLocalHom (algebraMap L_B T_loc) :=
        Localization.isLocalHom_localRingHom q_pt.asIdeal w₀.asIdeal ι_L h_qw_comap
      haveI : Module.Flat B_P1 B'_P1 := inferInstance
      haveI : Module.Flat B'_P1 T_loc := IsLocalization.flat T_loc w₀.asIdeal.primeCompl
      haveI : Module.Flat B_P1 T_loc := Module.Flat.trans B_P1 B'_P1 T_loc
      haveI : Module.Flat L_B T_loc :=
        (Module.flat_iff_of_isLocalization (S := L_B) (p := q_pt.asIdeal.primeCompl)
          T_loc).mpr inferInstance
      haveI : IsDomain L_B :=
        IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors q_pt.asIdeal)
      haveI : IsDiscreteValuationRing L_B := hDVR_LB
      have h_nzd_L : ∀ (x : L_B), x ≠ 0 → ∀ (z : T_loc), lam x * z = 0 → z = 0 := by
        intro x hx z hz
        let mul_x : L_B →ₗ[L_B] L_B := LinearMap.mulLeft L_B x
        have hinj_x : Function.Injective mul_x := mul_right_injective₀ hx
        have hinj_ten : Function.Injective (LinearMap.lTensor T_loc mul_x) :=
          Module.Flat.lTensor_preserves_injective_linearMap mul_x hinj_x
        let e_rid : TensorProduct L_B T_loc L_B ≃ₗ[L_B] T_loc := TensorProduct.rid L_B T_loc
        have h_zero : LinearMap.lTensor T_loc mul_x (z ⊗ₜ[L_B] (1 : L_B)) = 0 := by
          apply e_rid.injective
          rw [map_zero]
          change e_rid (z ⊗ₜ[L_B] (x * 1)) = 0
          rw [mul_one, TensorProduct.rid_tmul]
          exact hz
        have h_zt : (z ⊗ₜ[L_B] (1 : L_B) : TensorProduct L_B T_loc L_B) = 0 :=
          hinj_ten (h_zero.trans (map_zero _).symm)
        have h_eval := congrArg e_rid h_zt
        rw [TensorProduct.rid_tmul, one_smul, map_zero] at h_eval
        exact h_eval
      have hinj_lam : Function.Injective lam := by
        rw [RingHom.injective_iff_ker_eq_bot]
        ext x
        simp only [RingHom.mem_ker, Ideal.mem_bot]
        constructor
        · intro hx0
          by_contra hx_ne
          have h10 : (1 : T_loc) = 0 := h_nzd_L x hx_ne 1 (by rw [hx0, zero_mul])
          exact one_ne_zero h10
        · rintro rfl
          exact map_zero lam
      obtain ⟨ϖ_B, hϖ_B⟩ := IsDiscreteValuationRing.exists_irreducible L_B
      have hmax_LB : IsLocalRing.maximalIdeal L_B = Ideal.span ({ϖ_B} : Set L_B) := by
        apply le_antisymm
        · intro x hx
          by_cases hx0 : x = 0
          · rw [hx0]; exact Ideal.zero_mem _
          · obtain ⟨k, hk⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx0 hϖ_B
            obtain ⟨u_x, rfl⟩ := hk.symm
            rcases Nat.eq_zero_or_pos k with rfl | hk_pos
            · exfalso
              simp only [pow_zero, one_mul] at hx
              exact (IsLocalRing.notMem_maximalIdeal.mpr u_x.isUnit) hx
            · obtain ⟨r, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk_pos)
              rw [Ideal.mem_span_singleton]
              exact ⟨ϖ_B ^ r * u_x, by rw [pow_succ']; ring⟩
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          by_contra hnot
          exact hϖ_B.not_isUnit (IsLocalRing.notMem_maximalIdeal.mp hnot)
      haveI : Algebra.FormallyUnramified B'_P1 T_loc :=
        Algebra.FormallyUnramified.instLocalization (M := w₀.asIdeal.primeCompl)
      haveI : Algebra.FormallyUnramified B_P1 T_loc :=
        Algebra.FormallyUnramified.comp B_P1 B'_P1 T_loc
      haveI : Algebra.FormallyUnramified L_B T_loc :=
        Algebra.FormallyUnramified.localization_base q_pt.asIdeal.primeCompl
      haveI : Algebra.EssFiniteType B_P1 B'_P1 := Algebra.EssFiniteType.of_finiteType B_P1 B'_P1
      haveI : Algebra.EssFiniteType B'_P1 T_loc :=
        Algebra.EssFiniteType.of_isLocalization T_loc w₀.asIdeal.primeCompl
      haveI : Algebra.EssFiniteType B_P1 T_loc := Algebra.EssFiniteType.comp B_P1 B'_P1 T_loc
      haveI : Algebra.EssFiniteType L_B T_loc := Algebra.EssFiniteType.of_comp B_P1 L_B T_loc
      have hmax_T : IsLocalRing.maximalIdeal T_loc = Ideal.span ({lam ϖ_B} : Set T_loc) := by
        have hmap : Ideal.map (algebraMap L_B T_loc) (IsLocalRing.maximalIdeal L_B) =
            IsLocalRing.maximalIdeal T_loc :=
          ((Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := L_B) (S := T_loc)).mp
            inferInstance).2
        rw [← hmap, hmax_LB, Ideal.map_span, Set.image_singleton]
        rfl
      have hϖT_ne : lam ϖ_B ≠ 0 :=
        fun h => hϖ_B.ne_zero (hinj_lam (h.trans (map_zero lam).symm))
      obtain ⟨hDomT, hNotFieldT, hDVRT, _⟩ :=
        hPrincDVR T_loc (lam ϖ_B) hmax_T hϖT_ne (h_nzd_L ϖ_B hϖ_B.ne_zero)
      exact ⟨hDomT, hNotFieldT, hDVRT, hinj_lam⟩

    obtain ⟨hDomT, hNotFieldT, _hDVRT, hinj_lam⟩ := hDomDVR_T
    letI : IsDomain T_loc := hDomT

    let u_loc : L_A' := algebraMap A' L_A' u
    let v_loc : L_A' := algebraMap A' L_A' v
    have ht₀_ex : ∃ t₀ : L_A', (t₀ = u_loc ∨ t₀ = v_loc) ∧ θ_A' t₀ = 0 := by
      have hX_zero_B' : ι_R (f_et (φ₀ PowerSeries.X)) = 0 := by
        have h1 := RingHom.congr_fun h_ι_comm (φ₀ PowerSeries.X)
        simp only [RingHom.comp_apply] at h1
        rw [← h1, hf_X, map_zero]
      have hX_zero_T : θ_A' (algebraMap A' L_A' (f_et (φ₀ PowerSeries.X))) = 0 := by
        rw [Localization.localRingHom_to_map, hX_zero_B', map_zero]
      rw [hX_nc] at hX_zero_T
      simp only [map_mul, map_pow] at hX_zero_T
      have hε_ne : θ_A' (algebraMap A' L_A' ε) ≠ 0 :=
        ((hε.map (algebraMap A' L_A')).map θ_A').ne_zero
      have huv_zero : (θ_A' u_loc) ^ a_y * (θ_A' v_loc) ^ b_y = 0 := by
        rcases mul_eq_zero.mp hX_zero_T with h_eu | hv_z
        · rcases mul_eq_zero.mp h_eu with hε_z | hu_z
          · exact absurd hε_z hε_ne
          · rw [hu_z, zero_mul]
        · rw [hv_z, mul_zero]
      rcases mul_eq_zero.mp huv_zero with hu_pow | hv_pow
      · exact ⟨u_loc, Or.inl rfl, eq_zero_of_pow_eq_zero hu_pow⟩
      · rcases Nat.eq_zero_or_pos b_y with hb0 | _hb_pos
        · rw [hb0, pow_zero] at hv_pow
          exact absurd hv_pow one_ne_zero
        · exact ⟨v_loc, Or.inr rfl, eq_zero_of_pow_eq_zero hv_pow⟩

    obtain ⟨t₀, ht₀_cases, ht₀_zero⟩ := ht₀_ex
    obtain ⟨hLocD, hDomD, hDVR_D, hPrimesD⟩ :=
      hQuotDVR A' v₀ u v hv₀_span hu_ne huv_reg t₀ ht₀_cases
    let D₀ := L_A' ⧸ Ideal.span ({t₀} : Set L_A')
    letI : IsLocalRing D₀ := hLocD
    letI : IsDomain D₀ := hDomD
    letI : IsDiscreteValuationRing D₀ := hDVR_D
    let mk_D : L_A' →+* D₀ := Ideal.Quotient.mk (Ideal.span ({t₀} : Set L_A'))
    let θ_bar : D₀ →+* T_loc := Ideal.Quotient.lift (Ideal.span ({t₀} : Set L_A')) θ_A' (by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨c, rfl⟩
      rw [map_mul, ht₀_zero, zero_mul])
    haveI : IsLocalHom θ_A' :=
      Localization.isLocalHom_localRingHom v₀.asIdeal w₀.asIdeal ι_R h_vw_comap
    haveI : IsLocalHom θ_bar := ⟨by
      intro d hd
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      have hx_u : IsUnit x := isUnit_of_map_unit θ_A' x hd
      exact hx_u.map mk_D⟩

    have hInj_θbar : Function.Injective θ_bar := by
      rw [RingHom.injective_iff_ker_eq_bot]
      have hker_prime : (RingHom.ker θ_bar).IsPrime := RingHom.ker_isPrime θ_bar
      rcases hPrimesD (RingHom.ker θ_bar) hker_prime with hbot | hmax_ker
      · exact hbot
      · exfalso
        haveI hmax_inst : (RingHom.ker θ_bar).IsMaximal := by
          rw [hmax_ker]
          exact IsLocalRing.maximalIdeal.isMaximal D₀
        let K₀ := D₀ ⧸ RingHom.ker θ_bar
        letI : Field K₀ := Ideal.Quotient.field (RingHom.ker θ_bar)
        let φ_KT : K₀ →+* T_loc := RingHom.kerLift θ_bar
        have hinj_KT : Function.Injective φ_KT := RingHom.kerLift_injective θ_bar
        let π_LK : L_A' →+* K₀ := (Ideal.Quotient.mk (RingHom.ker θ_bar)).comp mk_D
        obtain ⟨hFin_LA'_T, _⟩ := h_Tloc_A'
        letI : Algebra K₀ T_loc := φ_KT.toAlgebra
        haveI : Algebra.IsIntegral K₀ T_loc := by
          letI : Algebra L_A' T_loc := θ_A'.toAlgebra
          haveI : Module.Finite L_A' T_loc := hFin_LA'_T
          haveI : Algebra.IsIntegral L_A' T_loc := Algebra.IsIntegral.of_finite L_A' T_loc
          refine ⟨fun z => ?_⟩
          obtain ⟨P, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := L_A') z
          refine ⟨P.map π_LK, hP_monic.map π_LK, ?_⟩
          rw [Polynomial.eval₂_map]
          exact hP_eval
        have hFieldT : IsField T_loc :=
          (Algebra.IsIntegral.isField_iff_isField (R := K₀) (S := T_loc) hinj_KT).mp
            (Field.toIsField K₀)
        exact hNotFieldT hFieldT

    let inQ : T_loc → Prop := fun w => ∃ x y : D₀, θ_bar y ≠ 0 ∧ θ_bar y * w = θ_bar x
    have hinQ_zero : inQ 0 := ⟨0, 1, by simp, by simp⟩
    have hinQ_add : ∀ {w₁ w₂ : T_loc}, inQ w₁ → inQ w₂ → inQ (w₁ + w₂) := by
      rintro w₁ w₂ ⟨x₁, y₁, hy₁, hw₁⟩ ⟨x₂, y₂, hy₂, hw₂⟩
      refine ⟨y₂ * x₁ + y₁ * x₂, y₁ * y₂, ?_, ?_⟩
      · rw [map_mul]; exact mul_ne_zero hy₁ hy₂
      · calc θ_bar (y₁ * y₂) * (w₁ + w₂)
            = θ_bar y₂ * (θ_bar y₁ * w₁) + θ_bar y₁ * (θ_bar y₂ * w₂) := by rw [map_mul]; ring
          _ = θ_bar y₂ * θ_bar x₁ + θ_bar y₁ * θ_bar x₂ := by rw [hw₁, hw₂]
          _ = θ_bar (y₂ * x₁ + y₁ * x₂) := by simp [map_add, map_mul]
    have hinQ_mul : ∀ {w₁ w₂ : T_loc}, inQ w₁ → inQ w₂ → inQ (w₁ * w₂) := by
      rintro w₁ w₂ ⟨x₁, y₁, hy₁, hw₁⟩ ⟨x₂, y₂, hy₂, hw₂⟩
      refine ⟨x₁ * x₂, y₁ * y₂, ?_, ?_⟩
      · rw [map_mul]; exact mul_ne_zero hy₁ hy₂
      · calc θ_bar (y₁ * y₂) * (w₁ * w₂)
            = (θ_bar y₁ * w₁) * (θ_bar y₂ * w₂) := by rw [map_mul]; ring
          _ = θ_bar x₁ * θ_bar x₂ := by rw [hw₁, hw₂]
          _ = θ_bar (x₁ * x₂) := by rw [map_mul]

    let α_BT : B_P1 →+* T_loc := lam.comp (algebraMap B_P1 L_B)
    have hinj_αBT : Function.Injective α_BT :=
      hinj_lam.comp (IsLocalization.injective L_B (Ideal.primeCompl_le_nonZeroDivisors q_pt.asIdeal))
    have hαBT_eq : ∀ b : B_P1, algebraMap B'_P1 T_loc (ι_L b) = α_BT b := fun b =>
      (Localization.localRingHom_to_map q_pt.asIdeal w₀.asIdeal ι_L h_qw_comap b).symm
    have hαBT_R : ∀ r : R₀, α_BT (f_RB r) = θ_bar (mk_D (algebraMap A' L_A' (f_et r))) := by
      intro r
      rw [← hαBT_eq]
      have h1 := RingHom.congr_fun h_ι_comm r
      simp only [RingHom.comp_apply] at h1
      rw [h1]
      exact (Localization.localRingHom_to_map v₀.asIdeal w₀.asIdeal ι_R h_vw_comap (f_et r)).symm

    have hinQ_B' : ∀ β : B'_P1, inQ (algebraMap B'_P1 T_loc β) := by
      intro β
      induction β using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact hinQ_zero
      | tmul b a' =>
        have hsplit : (b ⊗ₜ[R₀] a' : B'_P1) = ι_L b * ι_R a' := by
          change b ⊗ₜ[R₀] a' = (b ⊗ₜ[R₀] 1) * (1 ⊗ₜ[R₀] a')
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, map_mul]
        apply hinQ_mul
        · rw [hαBT_eq]
          obtain ⟨r, s, hs_ne, hsb⟩ := hGenSurj b
          refine ⟨mk_D (algebraMap A' L_A' (f_et r)), mk_D (algebraMap A' L_A' (f_et s)), ?_, ?_⟩
          · rw [← hαBT_R]
            exact fun h0 => hs_ne (hinj_αBT (h0.trans (map_zero α_BT).symm))
          · rw [← hαBT_R, ← hαBT_R, ← map_mul, hsb]
        · refine ⟨mk_D (algebraMap A' L_A' a'), 1, by simp, ?_⟩
          rw [map_one, one_mul]
          exact (Localization.localRingHom_to_map v₀.asIdeal w₀.asIdeal ι_R h_vw_comap a').symm
      | add x₁ x₂ hx₁ hx₂ =>
        rw [map_add]
        exact hinQ_add hx₁ hx₂

    have hinQ_all : ∀ z : T_loc, inQ z := by
      intro z
      obtain ⟨⟨β, γ⟩, hz_eq⟩ := IsLocalization.surj w₀.asIdeal.primeCompl z
      have hγ_unit : IsUnit (algebraMap B'_P1 T_loc (γ : B'_P1)) :=
        IsLocalization.map_units T_loc γ
      obtain ⟨x_β, y_β, hy_β, hβ_eq⟩ := hinQ_B' β
      obtain ⟨x_γ, y_γ, hy_γ, hγ_eq⟩ := hinQ_B' (γ : B'_P1)
      have hx_γ_ne : θ_bar x_γ ≠ 0 := by
        rw [← hγ_eq]
        exact mul_ne_zero hy_γ hγ_unit.ne_zero
      refine ⟨y_γ * x_β, y_β * x_γ, ?_, ?_⟩
      · rw [map_mul]
        exact mul_ne_zero hy_β hx_γ_ne
      · calc θ_bar (y_β * x_γ) * z
            = θ_bar y_β * (θ_bar y_γ * algebraMap B'_P1 T_loc (γ : B'_P1)) * z := by
                rw [map_mul, ← hγ_eq]
          _ = θ_bar y_γ * (θ_bar y_β * (z * algebraMap B'_P1 T_loc (γ : B'_P1))) := by ring
          _ = θ_bar y_γ * (θ_bar y_β * algebraMap B'_P1 T_loc β) := by rw [hz_eq]
          _ = θ_bar y_γ * θ_bar x_β := by rw [hβ_eq]
          _ = θ_bar (y_γ * x_β) := by rw [map_mul]

    have hSurj_θbar : Function.Surjective θ_bar :=
      hDVRMax D₀ T_loc θ_bar hInj_θbar hinQ_all
    have hSurj_θA' : Function.Surjective θ_A' := by
      intro z
      obtain ⟨d, rfl⟩ := hSurj_θbar z
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      exact ⟨x, rfl⟩

    letI : Algebra L_R L_A' := ψ_et.toAlgebra
    letI : Algebra L_R L_B := φ_loc.toAlgebra
    haveI : IsScalarTower R₀ L_R L_A' := IsScalarTower.of_algebraMap_eq fun r => by
      change algebraMap R₀ L_A' r = ψ_et (algebraMap R₀ L_R r)
      rw [IsScalarTower.algebraMap_apply R₀ A' L_A', Localization.localRingHom_to_map]
      rfl
    haveI : IsLocalHom (algebraMap L_R L_A') :=
      Localization.isLocalHom_localRingHom p₀.asIdeal v₀.asIdeal f_et hp0_v0_comap
    haveI : Module.Flat R₀ A' := inferInstance
    haveI : Module.Flat A' L_A' := IsLocalization.flat L_A' v₀.asIdeal.primeCompl
    haveI : Module.Flat R₀ L_A' := Module.Flat.trans R₀ A' L_A'
    haveI : Module.Flat L_R L_A' :=
      (Module.flat_iff_of_isLocalization (S := L_R) (p := p₀.asIdeal.primeCompl)
        L_A').mpr inferInstance
    haveI : Module.FaithfullyFlat L_R L_A' := Module.FaithfullyFlat.of_flat_of_isLocalHom

    obtain ⟨_, ⟨Φ_fwd, hInj_Φ, hΦ_LA'⟩⟩ := h_Tloc_A'
    have hSurj_ten : Function.Surjective (algebraMap L_A' (TensorProduct L_R L_A' L_B)) := by
      intro w
      obtain ⟨a_loc, ha_loc⟩ := hSurj_θA' (Φ_fwd w)
      refine ⟨a_loc, hInj_Φ ?_⟩
      change Φ_fwd (a_loc ⊗ₜ[L_R] (1 : L_B)) = Φ_fwd w
      rw [hΦ_LA', ha_loc]
    exact Module.FaithfullyFlat.surjective_of_tensorProduct (R := L_R) (S := L_A') (T := L_B)
      hSurj_ten

  
  have hP1Bridge :
      let P₁ := (weilProjectiveSpaceOver Ω 1).left
      let p_P1 := (weilProjectiveSpaceOver Ω 1).hom
      ¬ (Set.univ : Set ↥P₁).Subsingleton →
      ∀ (Φ : P₁ ⟶ Y) [AlgebraicGeometry.IsFinite Φ],
        Function.Injective Φ.base →
        Φ ≫ g_Y = p_P1 ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)) →
        ∀ (p_pt : ↥P₁),
          IsClosed ({p_pt} : Set ↥P₁) →
          (∀ x : ↥P₁, x ≠ p_pt → Function.Surjective (Φ.stalkMap x).hom) →
          ∀ (R₀ : CommRingCat.{u}) (p₀ : PrimeSpectrum ↑R₀)
            (ι_U : AlgebraicGeometry.Spec R₀ ⟶ Y) [AlgebraicGeometry.IsOpenImmersion ι_U],
            ι_U.base p₀ = Φ.base p_pt →
            ∃ (B_P1 : Type u) (instRing : CommRing B_P1) (instDom : @IsDomain B_P1 instRing.toSemiring)
              (f_RB : ↑R₀ →+* B_P1) (q_pt : @PrimeSpectrum B_P1 instRing.toCommSemiring),
              letI : CommRing B_P1 := instRing
              letI : IsDomain B_P1 := instDom
              f_RB.Finite ∧
              (∀ q : PrimeSpectrum B_P1, PrimeSpectrum.comap f_RB q = p₀ ↔ q = q_pt) ∧
              f_RB ((AlgebraicGeometry.Spec.preimage (ι_U ≫ g_Y)).hom PowerSeries.X) = 0 ∧
              IsDiscreteValuationRing (Localization.AtPrime q_pt.asIdeal) ∧
              (∀ b : B_P1, ∃ r s : ↑R₀, f_RB s ≠ 0 ∧ f_RB s * b = f_RB r) ∧
              ((∀ h_comap : p₀.asIdeal = Ideal.comap f_RB q_pt.asIdeal,
                  Function.Surjective (Localization.localRingHom p₀.asIdeal q_pt.asIdeal f_RB h_comap)) →
                Function.Surjective (Φ.stalkMap p_pt).hom) := by
    dsimp only
    intro hNonSubP1 Φ _ hInjΦ hΦ_sΩ p_pt hp_cl hSurjGen R₀ p₀ ι_U _ hι_p₀
    let P₁ := (weilProjectiveSpaceOver Ω 1).left
    let p_P1 := (weilProjectiveSpaceOver Ω 1).hom
    let W_P1 : Fin 2 → P₁.Opens := weilProjBasicOpen Ω 1
    haveI : AlgebraicGeometry.IsIntegral P₁ := hIntP1
    let U_Y : Y.Opens := ι_U.opensRange
    have hUY_aff : AlgebraicGeometry.IsAffineOpen U_Y :=
      AlgebraicGeometry.isAffineOpen_opensRange ι_U
    let U_P1 : P₁.Opens := (TopologicalSpace.Opens.map Φ.base).obj U_Y
    have hUP1_aff : AlgebraicGeometry.IsAffineOpen U_P1 :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage U_Y hUY_aff
    have hp_in_UP1 : p_pt ∈ U_P1 := ⟨p₀, hι_p₀⟩
    haveI : Nonempty U_P1 := ⟨⟨p_pt, hp_in_UP1⟩⟩

    let B_obj : CommRingCat.{u} := P₁.presheaf.obj (Opposite.op U_P1)
    let B_P1 : Type u := ↑B_obj
    haveI hDomB : IsDomain B_P1 := AlgebraicGeometry.IsIntegral.component_integral U_P1

    have hRange_eq : Set.range ι_U.base = Set.range U_Y.ι.base := Subtype.range_coe.symm
    let e_iso : AlgebraicGeometry.Spec R₀ ≅ U_Y.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ι_U U_Y.ι hRange_eq
    have he_inv_ι : e_iso.inv ≫ ι_U = U_Y.ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac ι_U U_Y.ι hRange_eq

    let ψ_aff : AlgebraicGeometry.Spec B_obj ⟶ AlgebraicGeometry.Spec R₀ :=
      hUP1_aff.isoSpec.inv ≫ (Φ ∣_ U_Y) ≫ e_iso.inv
    haveI : AlgebraicGeometry.IsFinite ψ_aff := inferInstance
    let f_RB_hom : R₀ ⟶ B_obj := AlgebraicGeometry.Spec.preimage ψ_aff
    let f_RB : ↑R₀ →+* B_P1 := f_RB_hom.hom
    have hSpec_fRB : AlgebraicGeometry.Spec.map f_RB_hom = ψ_aff :=
      AlgebraicGeometry.Spec.map_preimage ψ_aff
    have hFin_RB : f_RB.Finite := by
      have hFin_spec : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map f_RB_hom) := by
        rw [hSpec_fRB]; infer_instance
      exact (AlgebraicGeometry.IsFinite.SpecMap_iff f_RB_hom).mp hFin_spec

    have hMaster : AlgebraicGeometry.Spec.map f_RB_hom ≫ ι_U = hUP1_aff.fromSpec ≫ Φ := by
      calc AlgebraicGeometry.Spec.map f_RB_hom ≫ ι_U
          = (hUP1_aff.isoSpec.inv ≫ (Φ ∣_ U_Y) ≫ e_iso.inv) ≫ ι_U := by rw [hSpec_fRB]
        _ = hUP1_aff.isoSpec.inv ≫ (Φ ∣_ U_Y) ≫ (e_iso.inv ≫ ι_U) := by
              simp only [CategoryTheory.Category.assoc]
        _ = hUP1_aff.isoSpec.inv ≫ ((Φ ∣_ U_Y) ≫ U_Y.ι) := by rw [he_inv_ι]
        _ = (hUP1_aff.isoSpec.inv ≫ U_P1.ι) ≫ Φ := by
              rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = hUP1_aff.fromSpec ≫ Φ := by rw [hUP1_aff.isoSpec_inv_ι]

    have hp_in_range : p_pt ∈ Set.range hUP1_aff.fromSpec.base := by
      rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
      exact hp_in_UP1
    obtain ⟨q_pt_raw, hq_pt_raw⟩ := hp_in_range
    let q_pt : PrimeSpectrum B_P1 := q_pt_raw
    have hq_pt_eq : hUP1_aff.fromSpec.base q_pt = p_pt := hq_pt_raw
    have hInj_fromB : Function.Injective hUP1_aff.fromSpec.base :=
      hUP1_aff.fromSpec.isOpenEmbedding.injective
    have hInj_ιU : Function.Injective ι_U.base := ι_U.isOpenEmbedding.injective

    have hq_uniq : ∀ q : PrimeSpectrum B_P1, PrimeSpectrum.comap f_RB q = p₀ ↔ q = q_pt := by
      intro q
      have hmap_q : ((AlgebraicGeometry.Spec.map f_RB_hom).base q : PrimeSpectrum ↑R₀) =
          PrimeSpectrum.comap f_RB q := by
        rw [AlgebraicGeometry.Spec.map_base]
        rfl
      rw [← hmap_q]
      constructor
      · intro hq
        apply hInj_fromB
        apply hInjΦ
        have h1 := congrArg (fun m => m.base q) hMaster
        change ι_U.base ((AlgebraicGeometry.Spec.map f_RB_hom).base q) =
          Φ.base (hUP1_aff.fromSpec.base q) at h1
        rw [hq_pt_eq, ← hι_p₀, ← hq]
        exact h1.symm
      · rintro rfl
        apply hInj_ιU
        have h1 := congrArg (fun m => m.base q_pt) hMaster
        change ι_U.base ((AlgebraicGeometry.Spec.map f_RB_hom).base q_pt) =
          Φ.base (hUP1_aff.fromSpec.base q_pt) at h1
        rw [h1, hq_pt_eq, hι_p₀]

    have hf_X : f_RB ((AlgebraicGeometry.Spec.preimage (ι_U ≫ g_Y)).hom PowerSeries.X) = 0 := by
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      have hsq_Ω : ψ_aff ≫ (ι_U ≫ g_Y) = (hUP1_aff.fromSpec ≫ p_P1) ≫ s_Ω := by
        calc ψ_aff ≫ (ι_U ≫ g_Y)
            = (ψ_aff ≫ ι_U) ≫ g_Y := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (AlgebraicGeometry.Spec.map f_RB_hom ≫ ι_U) ≫ g_Y := by rw [hSpec_fRB]
          _ = hUP1_aff.fromSpec ≫ (Φ ≫ g_Y) := by rw [hMaster, CategoryTheory.Category.assoc]
          _ = (hUP1_aff.fromSpec ≫ p_P1) ≫ s_Ω := by
                rw [hΦ_sΩ, CategoryTheory.Category.assoc]
      let α_Ω : CommRingCat.of Ω ⟶ B_obj :=
        AlgebraicGeometry.Spec.preimage (hUP1_aff.fromSpec ≫ p_P1)
      let φ₀_hom : CommRingCat.of (PowerSeries Ω) ⟶ R₀ :=
        AlgebraicGeometry.Spec.preimage (ι_U ≫ g_Y)
      have hhom_eq : φ₀_hom ≫ f_RB_hom =
          CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) ≫ α_Ω := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
        dsimp only [f_RB_hom, φ₀_hom, α_Ω]
        rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage]
        exact hsq_Ω
      have hval := congrArg (fun m => m.hom PowerSeries.X) hhom_eq
      simpa [f_RB, φ₀_hom, PowerSeries.constantCoeff_X] using hval

    have hq_pt_ne_bot : q_pt.asIdeal ≠ ⊥ := by
      intro hbot
      have hq_cl : IsClosed ({q_pt} : Set (PrimeSpectrum B_P1)) := by
        have hpre : (fun q : PrimeSpectrum B_P1 => hUP1_aff.fromSpec.base q) ⁻¹'
            ({p_pt} : Set ↥P₁) = ({q_pt} : Set (PrimeSpectrum B_P1)) := by
          ext q
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact ⟨fun h => hInj_fromB (h.trans hq_pt_eq.symm), fun h => h ▸ hq_pt_eq⟩
        rw [← hpre]
        exact hp_cl.preimage hUP1_aff.fromSpec.continuous
      have huniv_B : (Set.univ : Set (PrimeSpectrum B_P1)) = ({q_pt} : Set (PrimeSpectrum B_P1)) := by
        have hcl_eq : closure ({q_pt} : Set (PrimeSpectrum B_P1)) = {q_pt} := hq_cl.closure_eq
        rw [← hcl_eq, PrimeSpectrum.closure_singleton]
        ext q
        simp only [PrimeSpectrum.mem_zeroLocus, Set.mem_univ, true_iff]
        intro x hx
        have hx' : x ∈ (⊥ : Ideal B_P1) := hbot ▸ hx
        rw [Ideal.mem_bot] at hx'
        rw [hx']
        exact q.asIdeal.zero_mem
      have hUP1_eq : (U_P1 : Set ↥P₁) = {p_pt} := by
        rw [← AlgebraicGeometry.IsAffineOpen.range_fromSpec hUP1_aff]
        ext x
        simp only [Set.mem_range, Set.mem_singleton_iff]
        constructor
        · rintro ⟨q_raw, rfl⟩
          let q_b : PrimeSpectrum B_P1 := q_raw
          have hq_mem : q_b ∈ (Set.univ : Set (PrimeSpectrum B_P1)) := Set.mem_univ q_b
          rw [huniv_B, Set.mem_singleton_iff] at hq_mem
          change hUP1_aff.fromSpec.base q_b = p_pt
          rw [hq_mem, hq_pt_eq]
        · rintro rfl
          exact ⟨q_pt, hq_pt_eq⟩
      haveI : IrreducibleSpace ↥P₁ := AlgebraicGeometry.irreducibleSpace_of_isIntegral P₁
      have hDense : Dense (U_P1 : Set ↥P₁) :=
        U_P1.isOpen.dense ⟨p_pt, hp_in_UP1⟩
      have huniv_P1 : (Set.univ : Set ↥P₁) = {p_pt} := by
        rw [← hDense.closure_eq, hUP1_eq, hp_cl.closure_eq]
      apply hNonSubP1
      rw [huniv_P1]
      exact Set.subsingleton_singleton

    let stalkSpecEquiv : ∀ (C_ring : CommRingCat.{u}) (q : PrimeSpectrum ↑C_ring),
        ↑((AlgebraicGeometry.Spec C_ring).presheaf.stalk q) ≃+*
          Localization.AtPrime q.asIdeal := fun C_ring q =>
      commRingIsoToEquiv
        (CategoryTheory.Arrow.rightFunc.mapIso
          (AlgebraicGeometry.Scheme.arrowStalkMapSpecIso (𝟙 C_ring) q))

    have hDVR_LB : IsDiscreteValuationRing (Localization.AtPrime q_pt.asIdeal) := by
      have hp_top : p_pt ∈ (⨆ a : Fin 2, W_P1 a : P₁.Opens) := by
        rw [hCovP1]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hp_top
      obtain ⟨a₀, hp_Wa0⟩ := hp_top
      let C_obj : CommRingCat.{u} := P₁.presheaf.obj (Opposite.op (W_P1 a₀))
      have hp_range_a0 : p_pt ∈ Set.range (hAffP1 a₀).fromSpec.base := by
        rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
        exact hp_Wa0
      obtain ⟨q_a0_raw, hq_a0_raw⟩ := hp_range_a0
      let q_a0 : PrimeSpectrum ↑C_obj := q_a0_raw
      haveI : CategoryTheory.IsIso (hUP1_aff.fromSpec.stalkMap q_pt_raw) := inferInstance
      haveI : CategoryTheory.IsIso ((hAffP1 a₀).fromSpec.stalkMap q_a0_raw) := inferInstance
      let iso_P1_B : P₁.presheaf.stalk p_pt ≅ (AlgebraicGeometry.Spec B_obj).presheaf.stalk q_pt :=
        CategoryTheory.eqToIso (by rw [← hq_pt_raw]) ≪≫
          CategoryTheory.asIso (hUP1_aff.fromSpec.stalkMap q_pt_raw)
      let iso_P1_C : P₁.presheaf.stalk p_pt ≅ (AlgebraicGeometry.Spec C_obj).presheaf.stalk q_a0 :=
        CategoryTheory.eqToIso (by rw [← hq_a0_raw]) ≪≫
          CategoryTheory.asIso ((hAffP1 a₀).fromSpec.stalkMap q_a0_raw)
      let e_CB_stalk : Localization.AtPrime q_a0.asIdeal ≃+* Localization.AtPrime q_pt.asIdeal :=
        (stalkSpecEquiv C_obj q_a0).symm.trans
          ((commRingIsoToEquiv (iso_P1_C.symm ≪≫ iso_P1_B)).trans
            (stalkSpecEquiv B_obj q_pt))
      obtain ⟨θ_mv⟩ := hPolyP1 a₀
      let θ_poly : Polynomial Ω ≃+* ↑C_obj :=
        (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).toRingEquiv.symm.trans θ_mv
      let P_poly : Ideal (Polynomial Ω) := Ideal.comap θ_poly.toRingHom q_a0.asIdeal
      haveI : P_poly.IsPrime := q_a0.isPrime.comap θ_poly.toRingHom
      have hMap_sub : P_poly.primeCompl.map θ_poly.toRingHom = q_a0.asIdeal.primeCompl := by
        ext c
        simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff, P_poly, Ideal.mem_comap]
        constructor
        · rintro ⟨p, hp, rfl⟩
          exact hp
        · intro hc
          exact ⟨θ_poly.symm c, by simpa using hc, θ_poly.apply_symm_apply c⟩
      let e_poly_C : Localization.AtPrime P_poly ≃+* Localization.AtPrime q_a0.asIdeal :=
        IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime P_poly)
          (Localization.AtPrime q_a0.asIdeal) θ_poly hMap_sub
      let e_poly_B : Localization.AtPrime P_poly ≃+* Localization.AtPrime q_pt.asIdeal :=
        e_poly_C.trans e_CB_stalk
      haveI : IsDomain (Localization.AtPrime P_poly) :=
        IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors P_poly)
      haveI : IsDomain (Localization.AtPrime q_pt.asIdeal) :=
        IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors q_pt.asIdeal)
      have hP_poly_ne_bot : P_poly ≠ ⊥ := by
        intro hP0
        obtain ⟨b, hb_mem, hb_ne⟩ := (Submodule.ne_bot_iff q_pt.asIdeal).mp hq_pt_ne_bot
        have hb_loc_ne : algebraMap B_P1 (Localization.AtPrime q_pt.asIdeal) b ≠ 0 := by
          intro h0
          exact hb_ne (IsLocalization.injective (Localization.AtPrime q_pt.asIdeal)
            (Ideal.primeCompl_le_nonZeroDivisors q_pt.asIdeal) (h0.trans (map_zero _).symm))
        have hb_loc_max : algebraMap B_P1 (Localization.AtPrime q_pt.asIdeal) b ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime q_pt.asIdeal) :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff _ q_pt.asIdeal b).mpr hb_mem
        have hb_not_unit : ¬ IsUnit (algebraMap B_P1 (Localization.AtPrime q_pt.asIdeal) b) :=
          fun hu => (IsLocalRing.notMem_maximalIdeal.mpr hu) hb_loc_max
        let w_poly := e_poly_B.symm (algebraMap B_P1 (Localization.AtPrime q_pt.asIdeal) b)
        have hw_ne : w_poly ≠ 0 := by
          intro h0
          apply hb_loc_ne
          have h_ap := congrArg e_poly_B h0
          dsimp only [w_poly] at h_ap
          rw [RingEquiv.apply_symm_apply, map_zero] at h_ap
          exact h_ap
        obtain ⟨⟨num, den⟩, hnd⟩ := IsLocalization.surj P_poly.primeCompl w_poly
        have hnum_ne : num ≠ 0 := by
          intro h0
          rw [h0, map_zero] at hnd
          exact hw_ne ((IsLocalization.map_units _ den).mul_left_injective
            (hnd.trans (zero_mul _).symm))
        have hnum_not_P : num ∈ P_poly.primeCompl := by
          rw [Ideal.mem_primeCompl_iff, hP0, Ideal.mem_bot]
          exact hnum_ne
        have hw_unit : IsUnit w_poly := by
          have h1 : IsUnit (w_poly * algebraMap _ _ (den : Polynomial Ω)) := by
            rw [hnd]
            exact IsLocalization.map_units _ ⟨num, hnum_not_P⟩
          exact isUnit_of_mul_isUnit_left h1
        have hu_map : IsUnit (e_poly_B w_poly) := hw_unit.map e_poly_B.toRingHom
        dsimp only [w_poly] at hu_map
        rw [RingEquiv.apply_symm_apply] at hu_map
        exact hb_not_unit hu_map
      haveI : IsDiscreteValuationRing (Localization.AtPrime P_poly) := by
        let L_poly := Localization.AtPrime P_poly
        haveI : IsNoetherianRing (Polynomial Ω) := Polynomial.isNoetherianRing
        haveI : IsNoetherianRing L_poly :=
          IsLocalization.isNoetherianRing P_poly.primeCompl L_poly inferInstance
        haveI : IsPrincipalIdealRing (Polynomial Ω) := hPIR_poly
        obtain ⟨g_pol, hg_span⟩ := (IsPrincipalIdealRing.principal P_poly).principal
        have hg_ne : g_pol ≠ 0 := by
          intro hg0
          apply hP_poly_ne_bot
          rw [hg_span, Ideal.submodule_span_eq, hg0]
          exact Ideal.span_singleton_eq_bot.mpr rfl
        let π_pol : L_poly := algebraMap (Polynomial Ω) L_poly g_pol
        have hπ_pol_ne : π_pol ≠ 0 := by
          intro h0
          exact hg_ne (IsLocalization.injective L_poly
            (Ideal.primeCompl_le_nonZeroDivisors P_poly) (h0.trans (map_zero _).symm))
        have hmax_Lpoly : IsLocalRing.maximalIdeal L_poly = Ideal.span ({π_pol} : Set L_poly) := by
          have hmap : Ideal.map (algebraMap (Polynomial Ω) L_poly) P_poly =
              IsLocalRing.maximalIdeal L_poly :=
            Localization.AtPrime.map_eq_maximalIdeal
          have hP_eq : P_poly = Ideal.span ({g_pol} : Set (Polynomial Ω)) := by
            rw [hg_span, Ideal.submodule_span_eq]
          have hmap2 := congrArg (Ideal.map (algebraMap (Polynomial Ω) L_poly)) hP_eq
          rw [← hmap, hmap2, Ideal.map_span, Set.image_singleton]
        obtain ⟨_, _, hDVR_pol, _⟩ := hPrincDVR L_poly π_pol hmax_Lpoly hπ_pol_ne
          (fun z hz => (mul_eq_zero.mp hz).resolve_left hπ_pol_ne)
        exact hDVR_pol
      exact hDVROfRingEquiv e_poly_B

    have hStalkIff : ∀ (q : PrimeSpectrum B_P1),
        Function.Surjective (Φ.stalkMap (hUP1_aff.fromSpec.base q)).hom ↔
          Function.Surjective
            (Localization.localRingHom (PrimeSpectrum.comap f_RB q).asIdeal q.asIdeal f_RB rfl) := by
      intro q
      let q_sp : ↥(AlgebraicGeometry.Spec B_obj) := q
      let p_q : ↥(AlgebraicGeometry.Spec R₀) := (AlgebraicGeometry.Spec.map f_RB_hom).base q_sp
      haveI : AlgebraicGeometry.IsOpenImmersion hUP1_aff.fromSpec := inferInstance
      haveI : CategoryTheory.IsIso (ι_U.stalkMap p_q) := inferInstance
      haveI : CategoryTheory.IsIso (hUP1_aff.fromSpec.stalkMap q_sp) := inferInstance
      have h_congr := AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom
        (AlgebraicGeometry.Spec.map f_RB_hom ≫ ι_U) (hUP1_aff.fromSpec ≫ Φ) hMaster q_sp
      rw [AlgebraicGeometry.Scheme.Hom.stalkMap_comp,
        AlgebraicGeometry.Scheme.Hom.stalkMap_comp] at h_congr
      have h_surj_spec_iff :
          Function.Surjective (Φ.stalkMap (hUP1_aff.fromSpec.base q_sp)).hom ↔
            Function.Surjective ((AlgebraicGeometry.Spec.map f_RB_hom).stalkMap q_sp).hom := by
        have h1 := @hSurjEqIso _ _ _ _ _ _ _ _ inferInstance (CategoryTheory.Iso.isIso_hom _) h_congr
        exact (hSurjCompIso (Φ.stalkMap (hUP1_aff.fromSpec.base q_sp))
          (hUP1_aff.fromSpec.stalkMap q_sp)).trans h1.symm
      change Function.Surjective (Φ.stalkMap (hUP1_aff.fromSpec.base q_sp)).hom ↔ _
      rw [h_surj_spec_iff]
      let arr_iso := AlgebraicGeometry.Scheme.arrowStalkMapSpecIso f_RB_hom q
      haveI : CategoryTheory.IsIso arr_iso.hom.left :=
        (CategoryTheory.Arrow.leftFunc.mapIso arr_iso).isIso_hom
      haveI : CategoryTheory.IsIso arr_iso.hom.right :=
        (CategoryTheory.Arrow.rightFunc.mapIso arr_iso).isIso_hom
      have hw_arr : arr_iso.hom.left ≫
          CommRingCat.ofHom (Localization.localRingHom
            (PrimeSpectrum.comap f_RB q).asIdeal q.asIdeal f_RB rfl) =
          (AlgebraicGeometry.Spec.map f_RB_hom).stalkMap q_sp ≫ arr_iso.hom.right :=
        arr_iso.hom.w
      rw [hSurjCompIso ((AlgebraicGeometry.Spec.map f_RB_hom).stalkMap q_sp)
        arr_iso.hom.right, ← hw_arr, ← hSurjIsoComp arr_iso.hom.left]
      rfl

    have hGenSurj : ∀ b : B_P1, ∃ r s : ↑R₀, f_RB s ≠ 0 ∧ f_RB s * b = f_RB r := by
      have hbot_prime : (⊥ : Ideal B_P1).IsPrime :=
        ⟨fun htop => one_ne_zero (Ideal.mem_bot.mp ((Ideal.eq_top_iff_one _).mp htop)),
         fun {x y} hxy => by
           rcases mul_eq_zero.mp (Ideal.mem_bot.mp hxy) with hx | hy
           · exact Or.inl (Ideal.mem_bot.mpr hx)
           · exact Or.inr (Ideal.mem_bot.mpr hy)⟩
      let q_gen : PrimeSpectrum B_P1 := ⟨⊥, hbot_prime⟩
      let p_gen : PrimeSpectrum ↑R₀ := PrimeSpectrum.comap f_RB q_gen
      have hq_gen_ne : q_gen ≠ q_pt := by
        intro heq
        exact hq_pt_ne_bot (congrArg PrimeSpectrum.asIdeal heq).symm
      have hx_gen_ne : hUP1_aff.fromSpec.base q_gen ≠ p_pt := by
        intro heq
        exact hq_gen_ne (hInj_fromB (heq.trans hq_pt_eq.symm))
      let φ_gen := Localization.localRingHom p_gen.asIdeal q_gen.asIdeal f_RB rfl
      have hSurj_gen_loc : Function.Surjective φ_gen :=
        (hStalkIff q_gen).mp (hSurjGen _ hx_gen_ne)
      intro b
      let L_bot := Localization.AtPrime q_gen.asIdeal
      let L_pgen := Localization.AtPrime p_gen.asIdeal
      obtain ⟨z, hz⟩ := hSurj_gen_loc (algebraMap B_P1 L_bot b)
      obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj p_gen.asIdeal.primeCompl z
      have hs_ne : f_RB (s : ↑R₀) ≠ 0 := by
        intro h0
        exact s.2 (Ideal.mem_bot.mpr h0)
      refine ⟨r, (s : ↑R₀), hs_ne, ?_⟩
      apply IsLocalization.injective L_bot (Ideal.primeCompl_le_nonZeroDivisors q_gen.asIdeal)
      calc algebraMap B_P1 L_bot (f_RB (s : ↑R₀) * b)
          = algebraMap B_P1 L_bot b * algebraMap B_P1 L_bot (f_RB (s : ↑R₀)) := by
              rw [map_mul, mul_comm]
        _ = φ_gen z * φ_gen (algebraMap (↑R₀) L_pgen (s : ↑R₀)) := by
              rw [hz, ← Localization.localRingHom_to_map p_gen.asIdeal q_gen.asIdeal f_RB rfl (s : ↑R₀)]
        _ = φ_gen (z * algebraMap (↑R₀) L_pgen (s : ↑R₀)) := (map_mul φ_gen _ _).symm
        _ = φ_gen (algebraMap (↑R₀) L_pgen r) := by rw [hrs]
        _ = algebraMap B_P1 L_bot (f_RB r) :=
              Localization.localRingHom_to_map p_gen.asIdeal q_gen.asIdeal f_RB rfl r

    have hToStalk :
        (∀ h_comap : p₀.asIdeal = Ideal.comap f_RB q_pt.asIdeal,
          Function.Surjective (Localization.localRingHom p₀.asIdeal q_pt.asIdeal f_RB h_comap)) →
        Function.Surjective (Φ.stalkMap p_pt).hom := by
      intro hLocSurj
      have hp0_eq : p₀ = PrimeSpectrum.comap f_RB q_pt := ((hq_uniq q_pt).mpr rfl).symm
      have hSurj_qpt : Function.Surjective (Φ.stalkMap (hUP1_aff.fromSpec.base q_pt)).hom := by
        apply (hStalkIff q_pt).mpr
        cases hp0_eq
        exact hLocSurj rfl
      have hpt_nat := AlgebraicGeometry.Scheme.Hom.stalkMap_congr_point Φ
        (hUP1_aff.fromSpec.base q_pt) p_pt hq_pt_eq
      have h_lhs_pt : Function.Surjective
          (Φ.stalkMap (hUP1_aff.fromSpec.base q_pt) ≫
            (P₁.presheaf.stalkCongr (Inseparable.of_eq hq_pt_eq)).hom).hom :=
        (@hSurjCompIso _ _ _ _ _ (CategoryTheory.Iso.isIso_hom _)).mp hSurj_qpt
      rw [hpt_nat] at h_lhs_pt
      exact (@hSurjIsoComp _ _ _ _ (Φ.stalkMap p_pt) (CategoryTheory.Iso.isIso_hom _)).mpr h_lhs_pt

    exact ⟨B_P1, inferInstance, hDomB, f_RB, q_pt,
      hFin_RB, hq_uniq, hf_X, hDVR_LB, hGenSurj, hToStalk⟩

  
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let P₁ := (weilProjectiveSpaceOver Ω 1).left
  let ψ := ψ' ≫ ρ₀
  let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_Ω
  let Φ := ψ ≫ fst_Y
  let w_y := fst_Y.base y₀

  have hPillar1 :
      ψ ≫ CategoryTheory.Limits.pullback.snd g_Y s_Ω = (weilProjectiveSpaceOver Ω 1).hom ∧
      nc2dNodePullbackSet Ω g_Y ψ ⊆ nc2dNodePullbackSet Ω g_Y' ψ' ∧
      nc2dNodePullbackSet Ω g_Y ψ ∪ nc2dMarkPullbackSet Ω n g_Y τ_Y ψ ⊆
        nc2dNodePullbackSet Ω g_Y' ψ' ∪ nc2dMarkPullbackSet Ω n g_Y' τ_Y' ψ' ∧
      AlgebraicGeometry.IsClosedImmersion fst_Y ∧
      Function.Injective Φ.base ∧
      Topology.IsClosedEmbedding Φ.base ∧
      AlgebraicGeometry.IsFinite Φ ∧
      (∀ x : ↥P₁, Φ.base x ≠ w_y → Function.Surjective (Φ.stalkMap x).hom) := by
    let fst_Y' := CategoryTheory.Limits.pullback.fst g_Y' s_Ω
    let Φ' := ψ' ≫ fst_Y'

    have hSnd_ψ : ψ ≫ CategoryTheory.Limits.pullback.snd g_Y s_Ω =
        (weilProjectiveSpaceOver Ω 1).hom := by
      dsimp only [ψ]
      rw [CategoryTheory.Category.assoc, hρ₀_snd, hSnd']

    haveI : AlgebraicGeometry.IsClosedImmersion s_Ω :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
        (fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩)
    haveI hCl_fstY : AlgebraicGeometry.IsClosedImmersion fst_Y := inferInstance
    haveI : AlgebraicGeometry.IsClosedImmersion fst_Y' := inferInstance
    haveI : AlgebraicGeometry.IsClosedImmersion ψ' := hCl'
    haveI : AlgebraicGeometry.IsClosedImmersion Φ' := inferInstance

    have hΦ_eq : Φ = Φ' ≫ ρ := by
      dsimp only [Φ, Φ', ψ]
      rw [CategoryTheory.Category.assoc, hρ₀_fst, ← CategoryTheory.Category.assoc]

    have hInj_fstY : Function.Injective fst_Y.base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding fst_Y).injective
    have hInj_Φ' : Function.Injective Φ'.base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding Φ').injective

    have hY' : IsNC2DPointedSurface Ω n g_Y' τ_Y' := hBlow.2.1
    obtain ⟨E'_exc, _η_exc, _ι_exc, _R0, _R1, _R2, _p0, _i0, _i1, _i2, _phi1, _phi2,
        _z1, _z2, _s1, _s2, hE'_comp, _hGen, _hCl_exc, _hRange_exc, _hSnd_exc, hE'_pre, _rest⟩ :=
      hBlow.2.2.2.2.2.2.2.2.2
    have hρ₀_pre : ρ₀.base ⁻¹' ({y₀} : Set _) = E'_exc := by
      rw [← hE'_pre]
      ext q'
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      have hcomm_q' : fst_Y.base (ρ₀.base q') = ρ.base (fst_Y'.base q') :=
        congrArg (fun m => m.base q') hρ₀_fst
      exact ⟨fun h => by rw [← hcomm_q', h], fun h => hInj_fstY (hcomm_q'.trans h)⟩

    let F' : Set ↥(CategoryTheory.Limits.pullback g_Y' s_Ω) := Set.range ψ'.base
    have hF'_cl : IsClosed F' :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ψ').isClosed_range
    haveI : IrreducibleSpace ↥P₁ := @AlgebraicGeometry.irreducibleSpace_of_isIntegral P₁ hIntP1
    have hF'_irred : IsIrreducible F' := by
      dsimp only [F']
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ ↥P₁).image ψ'.base ψ'.continuous.continuousOn
    have hF'_nonSub : ¬ F'.Subsingleton := by
      intro hSub
      apply hNonSub
      have hImg : ρ₀.base '' F' = Set.range ψ.base := by
        ext q
        simp only [F', ψ, Set.mem_image, Set.mem_range]
        constructor
        · rintro ⟨_, ⟨p, rfl⟩, rfl⟩
          exact ⟨p, by simp⟩
        · rintro ⟨p, rfl⟩
          exact ⟨ψ'.base p, ⟨p, rfl⟩, by simp⟩
      rw [← hImg]
      exact hSub.image ρ₀.base
    have hF'_comp : F' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y' s_Ω) :=
      hCompMax Y' g_Y' τ_Y' F' hY' hF'_cl hF'_irred hF'_nonSub
    have hF'_ne : F' ≠ E'_exc := by
      intro hEq
      apply hNonSub
      refine (@Set.subsingleton_singleton _ y₀).anti ?_
      rintro _ ⟨p, rfl⟩
      have hp_E' : ψ'.base p ∈ E'_exc := by
        rw [← hEq]; exact ⟨p, rfl⟩
      rw [← hρ₀_pre] at hp_E'
      simpa [ψ] using hp_E'

    have hCenterNode : ∀ p : ↥P₁, ψ.base p = y₀ → p ∈ nc2dNodePullbackSet Ω g_Y' ψ' := by
      intro p hp
      have hp_E' : ψ'.base p ∈ E'_exc := by
        rw [← hρ₀_pre]
        exact hp
      exact hTwoCompNode Y' g_Y' τ_Y' F' E'_exc (ψ'.base p) hY' hF'_comp hE'_comp hF'_ne
        ⟨p, rfl⟩ hp_E'

    have hB_incl : nc2dNodePullbackSet Ω g_Y ψ ⊆ nc2dNodePullbackSet Ω g_Y' ψ' := by
      intro p hpB
      by_cases hp : ψ.base p = y₀
      · exact hCenterNode p hp
      · exact (hOffLift p hp).1 hpB

    have hBM_incl : nc2dNodePullbackSet Ω g_Y ψ ∪ nc2dMarkPullbackSet Ω n g_Y τ_Y ψ ⊆
        nc2dNodePullbackSet Ω g_Y' ψ' ∪ nc2dMarkPullbackSet Ω n g_Y' τ_Y' ψ' := by
      intro p hpBM
      by_cases hp : ψ.base p = y₀
      · exact Or.inl (hCenterNode p hp)
      · rcases hpBM with hpB | hpM
        · exact Or.inl ((hOffLift p hp).1 hpB)
        · exact Or.inr ((hOffLift p hp).2 hpM)

    have hw_y_cl : IsClosed ({w_y} : Set ↥Y) := by
      have himg : fst_Y.base '' ({y₀} : Set _) = {w_y} := Set.image_singleton
      rw [← himg]
      exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding fst_Y).isClosedMap _ hBlow.1
    let U_off : Y.Opens := ⟨({w_y} : Set ↥Y)ᶜ, hw_y_cl.isOpen_compl⟩
    let V_off : Y'.Opens := (TopologicalSpace.Opens.map ρ.base).obj U_off
    have hw_not_Uoff : w_y ∉ (U_off : Set ↥Y) := by simp [U_off]
    haveI : CategoryTheory.IsIso (ρ ∣_ U_off) := hBlow.2.2.2.2.2.2.2.1 U_off hw_not_Uoff
    have hRes_ι : (ρ ∣_ U_off) ≫ U_off.ι = V_off.ι ≫ ρ :=
      AlgebraicGeometry.morphismRestrict_ι ρ U_off
    have hInj_res : Function.Injective (ρ ∣_ U_off).base := by
      intro a b hab
      have h_inv := congrArg (fun m => m.base a) (CategoryTheory.IsIso.hom_inv_id (ρ ∣_ U_off))
      have h_inv_b := congrArg (fun m => m.base b) (CategoryTheory.IsIso.hom_inv_id (ρ ∣_ U_off))
      change (CategoryTheory.inv (ρ ∣_ U_off)).base ((ρ ∣_ U_off).base a) = a at h_inv
      change (CategoryTheory.inv (ρ ∣_ U_off)).base ((ρ ∣_ U_off).base b) = b at h_inv_b
      rw [← h_inv, ← h_inv_b, hab]

    have hInjΦ : Function.Injective Φ.base := by
      intro p₁ p₂ hp_eq
      have hψ_eq : ψ.base p₁ = ψ.base p₂ := hInj_fstY hp_eq
      by_cases hp₁ : ψ.base p₁ = y₀
      · have hp₂ : ψ.base p₂ = y₀ := hψ_eq.symm.trans hp₁
        exact hB'Sub (hCenterNode p₁ hp₁) (hCenterNode p₂ hp₂)
      · have hp₂ : ψ.base p₂ ≠ y₀ := fun h => hp₁ (hψ_eq.trans h)
        have hΦ1_ne : Φ.base p₁ ≠ w_y := fun h => hp₁ (hInj_fstY h)
        have hΦ2_ne : Φ.base p₂ ≠ w_y := fun h => hp₂ (hInj_fstY h)
        have hρ1_in : Φ'.base p₁ ∈ V_off := by
          change ρ.base (Φ'.base p₁) ∈ U_off
          have h1 : ρ.base (Φ'.base p₁) = Φ.base p₁ := (congrArg (fun m => m.base p₁) hΦ_eq).symm
          rw [h1]
          exact hΦ1_ne
        have hρ2_in : Φ'.base p₂ ∈ V_off := by
          change ρ.base (Φ'.base p₂) ∈ U_off
          have h2 : ρ.base (Φ'.base p₂) = Φ.base p₂ := (congrArg (fun m => m.base p₂) hΦ_eq).symm
          rw [h2]
          exact hΦ2_ne
        let q'₁ : ↥V_off := ⟨Φ'.base p₁, hρ1_in⟩
        let q'₂ : ↥V_off := ⟨Φ'.base p₂, hρ2_in⟩
        have hq'_eq : q'₁ = q'₂ := by
          apply hInj_res
          apply U_off.ι.isOpenEmbedding.injective
          have hc1 := congrArg (fun m => m.base q'₁) hRes_ι
          have hc2 := congrArg (fun m => m.base q'₂) hRes_ι
          change U_off.ι.base ((ρ ∣_ U_off).base q'₁) = ρ.base (Φ'.base p₁) at hc1
          change U_off.ι.base ((ρ ∣_ U_off).base q'₂) = ρ.base (Φ'.base p₂) at hc2
          have hf1 : ρ.base (Φ'.base p₁) = Φ.base p₁ := (congrArg (fun m => m.base p₁) hΦ_eq).symm
          have hf2 : ρ.base (Φ'.base p₂) = Φ.base p₂ := (congrArg (fun m => m.base p₂) hΦ_eq).symm
          rw [hc1, hc2, hf1, hf2, hp_eq]
        exact hInj_Φ' (congrArg Subtype.val hq'_eq)

    haveI : AlgebraicGeometry.IsProper ρ := hBlow.2.2.2.2.1
    haveI : AlgebraicGeometry.IsProper Φ := by
      rw [hΦ_eq]; infer_instance
    have hClEmbΦ : Topology.IsClosedEmbedding Φ.base :=
      Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap Φ.continuous hInjΦ Φ.isClosedMap

    haveI : AlgebraicGeometry.LocallyOfFinitePresentation g_Y' := hY'.2.2.2.1
    haveI : AlgebraicGeometry.LocallyOfFiniteType (ρ ≫ g_Y) := by
      rw [hBlow.2.2.1]; infer_instance
    haveI : AlgebraicGeometry.LocallyOfFiniteType ρ :=
      AlgebraicGeometry.locallyOfFiniteType_of_comp ρ g_Y
    haveI hLFT_Φ : AlgebraicGeometry.LocallyOfFiniteType Φ := by
      rw [hΦ_eq]; infer_instance

    haveI : AlgebraicGeometry.LocallyQuasiFinite Φ := by
      rw [AlgebraicGeometry.locallyQuasiFinite_iff]
      intro U hU V hV e
      let φ := (Φ.appLE U V e).hom
      letI : Algebra ↑(Y.presheaf.obj (Opposite.op U)) ↑(P₁.presheaf.obj (Opposite.op V)) :=
        φ.toAlgebra
      haveI : Algebra.FiniteType ↑(Y.presheaf.obj (Opposite.op U))
          ↑(P₁.presheaf.obj (Opposite.op V)) := by
        cases hLFT_Φ with
        | mk hf => exact hf hU hV e
      have hSq := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ hU hV e
      have hQFin : Algebra.QuasiFinite ↑(Y.presheaf.obj (Opposite.op U))
          ↑(P₁.presheaf.obj (Opposite.op V)) := by
        rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
        intro q
        apply Set.Subsingleton.finite
        intro p₁ hp₁ p₂ hp₂
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at hp₁ hp₂
        have hmap_eq : (AlgebraicGeometry.Spec.map (Φ.appLE U V e)).base p₁ =
            (AlgebraicGeometry.Spec.map (Φ.appLE U V e)).base p₂ := by
          rw [AlgebraicGeometry.Spec.map_base]
          exact hp₁.trans hp₂.symm
        have hcomp_p : (hV.fromSpec ≫ Φ).base p₁ = (hV.fromSpec ≫ Φ).base p₂ := by
          rw [← hSq]
          change hU.fromSpec.base ((AlgebraicGeometry.Spec.map (Φ.appLE U V e)).base p₁) =
            hU.fromSpec.base ((AlgebraicGeometry.Spec.map (Φ.appLE U V e)).base p₂)
          rw [hmap_eq]
        exact hV.fromSpec.isOpenEmbedding.injective (hInjΦ hcomp_p)
      exact hQFin

    have hFinΦ : AlgebraicGeometry.IsFinite Φ :=
      AlgebraicGeometry.IsFinite.of_isProper_of_locallyQuasiFinite Φ

    have hIsIso_eq : ∀ {C₁ C₂ C₃ : CommRingCat.{u}}
        (u : C₁ ⟶ C₃) (f : C₁ ⟶ C₂) (g : C₂ ⟶ C₃)
        [CategoryTheory.IsIso u] [CategoryTheory.IsIso f],
        u = f ≫ g → CategoryTheory.IsIso g := by
      intro C₁ C₂ C₃ u f g _ _ hu
      haveI : CategoryTheory.IsIso (f ≫ g) := hu ▸ inferInstance
      exact CategoryTheory.IsIso.of_isIso_comp_left f g
    have hOffStalk : ∀ x : ↥P₁, Φ.base x ≠ w_y → Function.Surjective (Φ.stalkMap x).hom := by
      intro x hx
      have hx'_in : Φ'.base x ∈ V_off := by
        change ρ.base (Φ'.base x) ∈ U_off
        have h1 : ρ.base (Φ'.base x) = Φ.base x := (congrArg (fun m => m.base x) hΦ_eq).symm
        rw [h1]
        exact hx
      let x' : ↥V_off.toScheme := ⟨Φ'.base x, hx'_in⟩
      have h_res_stalk := AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom
        ((ρ ∣_ U_off) ≫ U_off.ι) (V_off.ι ≫ ρ) hRes_ι x'
      have hc_lhs := AlgebraicGeometry.Scheme.Hom.stalkMap_comp (ρ ∣_ U_off) U_off.ι x'
      have hc_rhs := AlgebraicGeometry.Scheme.Hom.stalkMap_comp V_off.ι ρ x'
      rw [hc_lhs, hc_rhs] at h_res_stalk
      haveI : AlgebraicGeometry.IsOpenImmersion (ρ ∣_ U_off) := inferInstance
      haveI : AlgebraicGeometry.IsOpenImmersion V_off.ι := inferInstance
      haveI : CategoryTheory.IsIso (U_off.ι.stalkMap ((ρ ∣_ U_off).base x')) :=
        AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap U_off.ι _
      haveI : CategoryTheory.IsIso ((ρ ∣_ U_off).stalkMap x') :=
        AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap (ρ ∣_ U_off) x'
      haveI : CategoryTheory.IsIso (V_off.ι.stalkMap x') :=
        AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap V_off.ι x'
      haveI : CategoryTheory.IsIso (ρ.stalkMap (V_off.ι.base x')) := by
        haveI : CategoryTheory.IsIso
            (U_off.ι.stalkMap ((ρ ∣_ U_off).base x') ≫ (ρ ∣_ U_off).stalkMap x') :=
          CategoryTheory.IsIso.comp_isIso
        haveI : CategoryTheory.IsIso (ρ.stalkMap (V_off.ι.base x') ≫ V_off.ι.stalkMap x') :=
          @hIsIso_eq _ _ _ _ _ _ inferInstance (CategoryTheory.Iso.isIso_hom _) h_res_stalk
        exact CategoryTheory.IsIso.of_isIso_comp_right (ρ.stalkMap (V_off.ι.base x'))
          (V_off.ι.stalkMap x')
      haveI : CategoryTheory.IsIso (ρ.stalkMap (Φ'.base x)) :=
        show CategoryTheory.IsIso (ρ.stalkMap (V_off.ι.base x')) from inferInstance
      have hΦ_stalk := AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom Φ (Φ' ≫ ρ) hΦ_eq x
      have hc_Φ := AlgebraicGeometry.Scheme.Hom.stalkMap_comp Φ' ρ x
      rw [hc_Φ] at hΦ_stalk
      have hSurj_Φ' : Function.Surjective (Φ'.stalkMap x).hom :=
        AlgebraicGeometry.SurjectiveOnStalks.stalkMap_surjective Φ' x
      rw [hΦ_stalk]
      exact (@hSurjIsoComp _ _ _ _ _ (CategoryTheory.Iso.isIso_hom _)).mp
        ((hSurjIsoComp (ρ.stalkMap (Φ'.base x)) (Φ'.stalkMap x)).mp hSurj_Φ')

    exact ⟨hSnd_ψ, hB_incl, hBM_incl, hCl_fstY, hInjΦ, hClEmbΦ, hFinΦ, hOffStalk⟩

  
  obtain ⟨hSnd_ψ, hB_incl, hBM_incl, hCl_fstY, hInjΦ, hClEmbΦ, hFinΦ, hOffStalk⟩ := hPillar1
  haveI : AlgebraicGeometry.IsClosedImmersion fst_Y := hCl_fstY
  haveI : AlgebraicGeometry.IsFinite Φ := hFinΦ
  have hCl_Φ : AlgebraicGeometry.IsClosedImmersion Φ := by
    refine (AlgebraicGeometry.isClosedImmersion_iff Φ).mpr
      ⟨AlgebraicGeometry.SurjectiveOnStalks.mk (fun x => ?_), hClEmbΦ⟩
    by_cases hx : Φ.base x = w_y
    · let p_pt : ↥P₁ := x
      obtain ⟨a_y, b_y, R₀, p₀_raw, ι_U, _z₁, _z₂, A', v₀_raw, e_U, u, v, ε,
          hOpen_ιU, hι_p₀_wy, hDomR₀, _, _, _, hp₀_res, hEt_eU, hDomA', heU_pre,
          hv₀_span, hu_ne, huv_reg, hv₀_res, hε, ha_pos, hX_nc⟩ :=
        hY.2.2.2.2.2.2.2.2 y₀ hBlow.1
      let p₀ : PrimeSpectrum ↑R₀ := p₀_raw
      let v₀ : PrimeSpectrum ↑A' := v₀_raw
      haveI : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_ιU
      haveI : IsDomain ↑R₀ := hDomR₀
      haveI : IsDomain ↑A' := hDomA'
      haveI : AlgebraicGeometry.Etale e_U := hEt_eU
      haveI : AlgebraicGeometry.LocallyOfFinitePresentation g_Y := hY.2.2.2.1
      have hSpecProps : IsNoetherianRing ↑R₀ ∧
          (letI : Algebra ↑R₀ ↑A' := (AlgebraicGeometry.Spec.preimage e_U).hom.toAlgebra
           Algebra.Etale ↑R₀ ↑A') := by
        let f_UY := ι_U ≫ g_Y
        have hf_map : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage f_UY) = f_UY :=
          AlgebraicGeometry.Spec.map_preimage f_UY
        have hFT : (AlgebraicGeometry.Spec.preimage f_UY).hom.FiniteType := by
          have hLFT : AlgebraicGeometry.LocallyOfFiniteType
              (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage f_UY)) := by
            rw [hf_map]; infer_instance
          exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFiniteType) (Q := @RingHom.FiniteType)).mp hLFT
        letI : Algebra (PowerSeries Ω) ↑R₀ := (AlgebraicGeometry.Spec.preimage f_UY).hom.toAlgebra
        haveI : Algebra.FiniteType (PowerSeries Ω) ↑R₀ := hFT
        have hNoeth : IsNoetherianRing ↑R₀ :=
          Algebra.FiniteType.isNoetherianRing (PowerSeries Ω) ↑R₀
        have he_map : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U) = e_U :=
          AlgebraicGeometry.Spec.map_preimage e_U
        have hEt_hom : (AlgebraicGeometry.Spec.preimage e_U).hom.Etale := by
          have hEt_sp : AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U)) := by
            rw [he_map]; infer_instance
          exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.Etale) (Q := @RingHom.Etale)).mp hEt_sp
        refine ⟨hNoeth, ?_⟩
        letI : Algebra ↑R₀ ↑A' := (AlgebraicGeometry.Spec.preimage e_U).hom.toAlgebra
        exact RingHom.etale_algebraMap.mp hEt_hom
      obtain ⟨hNoethR₀, hEt_alg⟩ := hSpecProps
      haveI : IsNoetherianRing ↑R₀ := hNoethR₀
      have hNonSubP1 : ¬ (Set.univ : Set ↥P₁).Subsingleton := by
        intro hSub
        apply hNonSub
        rw [← Set.image_univ]
        exact hSub.image ψ.base
      have hΦ_sΩ : Φ ≫ g_Y = (weilProjectiveSpaceOver Ω 1).hom ≫ s_Ω := by
        calc (ψ ≫ fst_Y) ≫ g_Y
            = ψ ≫ (fst_Y ≫ g_Y) := CategoryTheory.Category.assoc _ _ _
          _ = ψ ≫ (CategoryTheory.Limits.pullback.snd g_Y s_Ω ≫ s_Ω) := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = (ψ ≫ CategoryTheory.Limits.pullback.snd g_Y s_Ω) ≫ s_Ω :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = (weilProjectiveSpaceOver Ω 1).hom ≫ s_Ω := by rw [hSnd_ψ]
      have hp_cl : IsClosed ({p_pt} : Set ↥P₁) := by
        have hw_y_cl : IsClosed ({w_y} : Set ↥Y) := by
          have himg : fst_Y.base '' ({y₀} : Set _) = {w_y} := Set.image_singleton
          rw [← himg]
          exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding fst_Y).isClosedMap _ hBlow.1
        have hpre_pt : Φ.base ⁻¹' ({w_y} : Set ↥Y) = {p_pt} := by
          ext z
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact ⟨fun h => hInjΦ (h.trans hx.symm), fun h => h ▸ hx⟩
        rw [← hpre_pt]
        exact hw_y_cl.preimage Φ.continuous
      have hSurjGen : ∀ x' : ↥P₁, x' ≠ p_pt → Function.Surjective (Φ.stalkMap x').hom := by
        intro x' hx'
        exact hOffStalk x' (fun h => hx' (hInjΦ (h.trans hx.symm)))
      have hι_p₀ : ι_U.base p₀ = Φ.base p_pt := hι_p₀_wy.trans hx.symm
      obtain ⟨B_P1, instRingB, instDomB, f_RB, q_pt,
          hFinRB, hq_uniq, hf_X, hDVR_LB, hGenSurj, hToStalk⟩ :=
        hP1Bridge hNonSubP1 Φ hInjΦ hΦ_sΩ p_pt hp_cl hSurjGen R₀ p₀ ι_U hι_p₀
      letI : CommRing B_P1 := instRingB
      letI : IsDomain B_P1 := instDomB
      let φ₀ : PowerSeries Ω →+* ↑R₀ := (AlgebraicGeometry.Spec.preimage (ι_U ≫ g_Y)).hom
      let f_et : ↑R₀ →+* ↑A' := (AlgebraicGeometry.Spec.preimage e_U).hom
      have hpre_comp : (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_Y)).hom = f_et.comp φ₀ := by
        have h_hom : AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_Y) =
            AlgebraicGeometry.Spec.preimage (ι_U ≫ g_Y) ≫ AlgebraicGeometry.Spec.preimage e_U := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
        exact congrArg CommRingCat.Hom.hom h_hom
      have hv₀_uniq : ∀ v' : PrimeSpectrum ↑A', PrimeSpectrum.comap f_et v' = p₀ ↔ v' = v₀ := by
        intro v'
        have hmap_v' : ((AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U)).base v' :
            PrimeSpectrum ↑R₀) = PrimeSpectrum.comap f_et v' := by
          rw [AlgebraicGeometry.Spec.map_base]
          rfl
        rw [← hmap_v', AlgebraicGeometry.Spec.map_preimage]
        constructor
        · intro hv'
          let v'_sp : ↥(AlgebraicGeometry.Spec A') := v'
          have hmem : v'_sp ∈ e_U.base ⁻¹' ({p₀_raw} : Set ↥(AlgebraicGeometry.Spec R₀)) := hv'
          rw [heU_pre, Set.mem_singleton_iff] at hmem
          exact hmem
        · intro hv'_eq
          rw [hv'_eq]
          have hmem : v₀_raw ∈ ({v₀_raw} : Set ↥(AlgebraicGeometry.Spec A')) :=
            Set.mem_singleton v₀_raw
          rw [← heU_pre] at hmem
          exact hmem
      have hv₀_res' : ∀ r' : ↑A', ∃ c : Ω, r' - f_et (φ₀ (PowerSeries.C c)) ∈ v₀.asIdeal := by
        intro r'
        obtain ⟨c, hc⟩ := hv₀_res r'
        rw [hpre_comp] at hc
        exact ⟨c, hc⟩
      have hX_nc' : f_et (φ₀ PowerSeries.X) = ε * u ^ a_y * v ^ b_y := by
        have h1 := hX_nc
        rw [hpre_comp] at h1
        exact h1
      apply hToStalk
      intro h_comap
      exact hEtaleSurj (↑R₀) (↑A') B_P1 φ₀ f_et f_RB p₀ v₀ q_pt u v ε a_y b_y h_comap
        hEt_alg hFinRB hv₀_uniq hq_uniq hp₀_res hv₀_res' hv₀_span hu_ne huv_reg
        hε ha_pos hX_nc' hf_X hDVR_LB hGenSurj
    · exact hOffStalk x hx
  haveI : AlgebraicGeometry.IsClosedImmersion (ψ ≫ fst_Y) := hCl_Φ
  have hCl_ψ : AlgebraicGeometry.IsClosedImmersion ψ :=
    AlgebraicGeometry.IsClosedImmersion.of_comp_isClosedImmersion ψ fst_Y
  exact ⟨hCl_ψ, hSnd_ψ, hB_incl, hBM_incl⟩

theorem weil_nc2d_minimal_blowup_step_to_subthree_rational_component (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W_prev W_top C₂ : AlgebraicGeometry.Scheme.{u})
    (g_prev : W_prev ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_prev : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_prev))
    (g_top : W_top ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_top : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_top))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₂))
    (q_center : ↥(CategoryTheory.Limits.pullback g_prev
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (π_last : W_top ⟶ W_prev)
    (α_top : CategoryTheory.Limits.pullback g_top
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (h : W_top ⟶ C₂)
    (ℓ : ℕ)
    (Y_seq : Fin (ℓ + 1) → AlgebraicGeometry.Scheme.{u})
    (gY_seq : ∀ i : Fin (ℓ + 1), Y_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τY_seq : ∀ i : Fin (ℓ + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y_seq i))
    (centersY : ∀ i : Fin ℓ,
      ↥(CategoryTheory.Limits.pullback (gY_seq i.castSucc)
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (mapsY : ∀ i : Fin ℓ, Y_seq i.succ ⟶ Y_seq i.castSucc)
    (ρ_from : ∀ i : Fin (ℓ + 1), Y_seq i ⟶ C₂)
    (h_ℓ : W_top ≅ Y_seq (Fin.last ℓ))
    (hPrev : IsNC2DPointedSurface Ω n g_prev τ_prev)
    (hLast : IsNC2DClosedPointBlowup Ω n g_prev τ_prev g_top τ_top q_center π_last)
    (hNC₂ : IsNC2DPointedSurface Ω n g₂ τ₂)
    (hRed₂ : AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback g₂
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hIntP1 : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver Ω 1).left)
    (hα_snd : α_top.hom ≫ CategoryTheory.Limits.pullback.snd g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g_top
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hh_comm : h ≫ g₂ = g_top)
    (hh_sec : ∀ j : Fin n, τ_top j ≫ h = τ₂ j)
    (hh_gen : CategoryTheory.Limits.pullback.fst g_top
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≫ h =
      α_top.hom ≫ CategoryTheory.Limits.pullback.fst g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hNotFactor : ¬ ∃ h' : W_prev ⟶ C₂, π_last ≫ h' = h)
    (hTowerY : IsNC2DBlowupTower Ω n g₂ τ₂ ℓ Y_seq gY_seq τY_seq centersY mapsY ρ_from)
    (hhℓ_g : h_ℓ.hom ≫ gY_seq (Fin.last ℓ) = g_top)
    (hhℓ_ρ : h_ℓ.hom ≫ ρ_from (Fin.last ℓ) = h)
    (hhℓ_sec : ∀ j : Fin n, τ_top j ≫ h_ℓ.hom = τY_seq (Fin.last ℓ) j) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ (F₀ : Set ↥(CategoryTheory.Limits.pullback g₂ s_Ω))
      (F_sch : AlgebraicGeometry.Scheme.{u})
      (ιF : F_sch ⟶ CategoryTheory.Limits.pullback g₂ s_Ω)
      (isoP1 : F_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
      F₀ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_Ω) ∧
      AlgebraicGeometry.IsClosedImmersion ιF ∧
      AlgebraicGeometry.IsIntegral F_sch ∧
      Set.range ιF.base = F₀ ∧
      ιF ≫ CategoryTheory.Limits.pullback.snd g₂ s_Ω =
        isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom ∧
      {q : ↥(CategoryTheory.Limits.pullback g₂ s_Ω) |
        q ∈ F₀ ∧
        ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_Ω),
          E' ≠ F₀ ∧ q ∈ E'}.Subsingleton ∧
      ∃ p₁ p₂ : ↥(CategoryTheory.Limits.pullback g₂ s_Ω),
        ∀ q ∈ F₀,
