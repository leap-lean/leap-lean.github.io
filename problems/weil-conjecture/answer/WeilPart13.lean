    have : Algebra.FormallyUnramified A D := Algebra.FormallyUnramified.comp A D_K D
    have : Algebra.FormallyUnramified A_p D :=
      Algebra.FormallyUnramified.localization_base p_A.primeCompl
    have : Algebra.EssFiniteType D_K D :=
      Algebra.EssFiniteType.of_isLocalization D m₀.asIdeal.primeCompl
    have : Algebra.EssFiniteType A D := Algebra.EssFiniteType.comp A D_K D
    have : Algebra.EssFiniteType A_p D := by
      have hAD : (algebraMap A D).EssFiniteType := by
