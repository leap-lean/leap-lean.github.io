        rw [IsScalarTower.algebraMap_apply κ₀ R_E₁ C₁, IsScalarTower.algebraMap_apply κ₀ E₁ R_E₁,
          ← IsScalarTower.algebraMap_apply E₁ R_E₁ C₁]
