          _ = loc f_l * loc j₁ := by rw [hl, hx]
    obtain ⟨d₁, j_F, hd₁, hj_F, hdj⟩ := h_loc_map _ hmem_loc
    rw [← map_mul] at hdj
    obtain ⟨⟨d₂, hd₂⟩, hd₂_eq⟩ :=
      (IsLocalization.eq_iff_exists m₁.asIdeal.primeCompl L₁).mp hdj
    have hd₂_eq' : d₂ * (d₁ * toF₁ (u₁ * v₁)) = d₂ * j_F := hd₂_eq
    let d_F : F₁ := d₂ * d₁
    have hd_F : d_F ∉ m₁.asIdeal := m₁.isPrime.mul_notMem hd₂ hd₁
    let j'_F : F₁ := d₂ * j_F
    have hj'_F : j'_F ∈ Ideal.map toF₁ (Ideal.span {u₁, v₁} ^ 3) := by
      rw [Ideal.map_pow, Ideal.map_span]
      simp only [Set.image_insert_eq, Set.image_singleton]
      exact Ideal.mul_mem_left _ _ hj_F
    have hF_eq : d_F * toF₁ (u₁ * v₁) = j'_F := by
      change (d₂ * d₁) * toF₁ (u₁ * v₁) = d₂ * j_F
      rw [mul_assoc, hd₂_eq']
    have h_map_dc : ∀ y ∈ Ideal.map toF₁ (Ideal.span {u₁, v₁} ^ 3),
        ∃ (t : R₁) (c : A₁), t ∉ p₁.asIdeal ∧ c ∈ Ideal.span {u₁, v₁} ^ 3 ∧
          toκ₁ (algebraMap R₁ κ₁ t) * y = toF₁ c := by
      intro y hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro _ ⟨c, hc, rfl⟩
        exact ⟨1, c, p₁.isPrime.one_notMem, hc, by simp⟩
      · exact ⟨1, 0, p₁.isPrime.one_notMem, Ideal.zero_mem _, by simp⟩
      · rintro x₁ x₂ _ _ ⟨t₁, c₁, ht₁, hc₁, hx₁⟩ ⟨t₂, c₂, ht₂, hc₂, hx₂⟩
        refine ⟨t₁ * t₂, f₁ t₂ * c₁ + f₁ t₁ * c₂, p₁.isPrime.mul_notMem ht₁ ht₂,
          add_mem (Ideal.mul_mem_left _ _ hc₁) (Ideal.mul_mem_left _ _ hc₂), ?_⟩
        calc
          toκ₁ (algebraMap R₁ κ₁ (t₁ * t₂)) * (x₁ + x₂)
            = toκ₁ (algebraMap R₁ κ₁ t₂) * (toκ₁ (algebraMap R₁ κ₁ t₁) * x₁) +
              toκ₁ (algebraMap R₁ κ₁ t₁) * (toκ₁ (algebraMap R₁ κ₁ t₂) * x₂) := by
              simp only [map_mul]; ring
          _ = toκ₁ (algebraMap R₁ κ₁ t₂) * toF₁ c₁ + toκ₁ (algebraMap R₁ κ₁ t₁) * toF₁ c₂ := by
              rw [hx₁, hx₂]
          _ = toF₁ (f₁ t₂ * c₁ + f₁ t₁ * c₂) := by rw [h_cross_F₁, h_cross_F₁, map_add]
      · rintro z x₁ _ ⟨t₁, c₁, ht₁, hc₁, hx₁⟩
        obtain ⟨t₂, b₂, ht₂, hz⟩ := h_dc1 z
        refine ⟨t₂ * t₁, b₂ * c₁, p₁.isPrime.mul_notMem ht₂ ht₁,
          Ideal.mul_mem_left _ _ hc₁, ?_⟩
        rw [smul_eq_mul, map_mul (algebraMap R₁ κ₁), map_mul toκ₁]
        calc
          (toκ₁ (algebraMap R₁ κ₁ t₂) * toκ₁ (algebraMap R₁ κ₁ t₁)) * (z * x₁)
            = (toκ₁ (algebraMap R₁ κ₁ t₂) * z) * (toκ₁ (algebraMap R₁ κ₁ t₁) * x₁) := by ring
