          rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem,
            AlgebraicGeometry.Scheme.Hom.ker_apply γ V, RingHom.mem_ker, map_pow] at hn
          have hr0 : (γ.app V.1).hom r = 0 := IsNilpotent.eq_zero ⟨n, hn⟩
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            ((AlgebraicGeometry.Scheme.Hom.ker_apply γ V).symm ▸ hr0)
        infer_instance
      exact AlgebraicGeometry.IsReduced.of_openCover γ.ker.subscheme γ.ker.subschemeCover.openCover
    have hIntS' : AlgebraicGeometry.IsIntegral S'.left :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced S'_sch
    have hPropπ : AlgebraicGeometry.IsProper π.left := by
      change AlgebraicGeometry.IsProper (ι_S' ≫ pr₁)
      infer_instance
    have : AlgebraicGeometry.IsProper π.left := hPropπ
    have hDenseU' : DenseRange U'.ι.base := by
