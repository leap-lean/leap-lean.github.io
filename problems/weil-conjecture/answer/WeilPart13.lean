          = (p.left.app V ≫ Y.left.presheaf.map (CategoryTheory.homOfLE hWV).op) ≫
              Y.left.presheaf.germ W η_Y hηW := rfl
        _ = p.left.app V ≫
              (Y.left.presheaf.map (CategoryTheory.homOfLE hWV).op ≫
                Y.left.presheaf.germ W η_Y hηW) := Category.assoc _ _ _
        _ = p.left.app V ≫
              Y.left.presheaf.germ ((TopologicalSpace.Opens.map p.left.base).obj V) η_Y h_mem := by
            rw [TopCat.Presheaf.germ_res]
        _ = S.left.presheaf.germ V (p.left.base η_Y) h_mem ≫ p.left.stalkMap η_Y := by
