            α (u ⊗ₜ[Localization.AtPrime Q₀] y) = u ⊗ₜ[Localization.AtPrime Q'_K] ⟨ψ_P y.1, hy'⟩) ∧
          Function.Injective α := by
      clear * -
      intro R₀ K P₀ P'_K F _ _ _ _ _ _ _ Q₀ _ Q'_K _ _ _ _
        I₀ I'_K J₀ J'_K map_P ψ_P f₀ _ f'_K _ e_poly I_K
        hf₀_val hf'K_val hψ_J hψ_F hψ_map he_poly_map hz_mem hz'_mem hex_ker
      let P_loc := Localization.AtPrime Q₀
      let P'_locK := Localization.AtPrime Q'_K
      let P_K := TensorProduct R₀ K P₀
      let : Algebra P₀ P_K := Algebra.TensorProduct.rightAlgebra
      let : Algebra P_loc P'_locK := ψ_P.toAlgebra
      have : IsScalarTower P_loc P'_locK F := IsScalarTower.of_algebraMap_eq (fun x =>
        (RingHom.congr_fun hψ_F x).symm)
      obtain ⟨e_ker, he_ker_z⟩ := hex_ker
      let α_bilin : F →ₗ[P_loc] ↥J₀ →ₗ[P_loc] TensorProduct P'_locK F ↥J'_K :=
        { toFun := fun u =>
            { toFun := fun y => u ⊗ₜ[P'_locK] ⟨ψ_P y.1, hψ_J y⟩
              map_add' := fun x y => by
                rw [← TensorProduct.tmul_add]; congr 1; ext; exact map_add ψ_P x.1 y.1
              map_smul' := fun p y => by
                have hsm : (⟨ψ_P (p • y).1, hψ_J (p • y)⟩ : ↥J'_K) =
                    (ψ_P p) • ⟨ψ_P y.1, hψ_J y⟩ := Subtype.ext (map_mul ψ_P p y.1)
                dsimp only [RingHom.id_apply]
                rw [hsm, ← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
                congr 1
                rw [Algebra.smul_def, Algebra.smul_def]
                congr 1
                exact RingHom.congr_fun hψ_F p }
          map_add' := fun u v => LinearMap.ext (fun y => by simp [TensorProduct.add_tmul])
          map_smul' := fun p u => LinearMap.ext (fun y => by dsimp; rw [TensorProduct.smul_tmul']) }
      let α : TensorProduct P_loc F ↥J₀ →ₗ[F] TensorProduct P'_locK F ↥J'_K :=
        { toFun := TensorProduct.lift α_bilin
          map_add' := map_add _
          map_smul' := fun c w => by
            induction w using TensorProduct.induction_on with
            | zero => simp
            | tmul u y => simp [α_bilin, TensorProduct.smul_tmul']
            | add x y hx hy => simp [smul_add, hx, hy] }
      let : Algebra P₀ F := ((algebraMap P_loc F).comp (algebraMap P₀ P_loc)).toAlgebra
      have : IsScalarTower P₀ P_loc F := IsScalarTower.of_algebraMap_eq' rfl
      let : Algebra P'_K F := ((algebraMap P'_locK F).comp (algebraMap P'_K P'_locK)).toAlgebra
      have : IsScalarTower P'_K P'_locK F := IsScalarTower.of_algebraMap_eq' rfl
      let : Algebra P_K F := ((algebraMap P'_K F).comp e_poly.toRingHom).toAlgebra
      have : IsScalarTower P₀ P_K F := IsScalarTower.of_algebraMap_eq (fun p => by
        change algebraMap P_loc F (algebraMap P₀ P_loc p) =
          algebraMap P'_locK F (algebraMap P'_K P'_locK (e_poly ((1 : K) ⊗ₜ[R₀] p)))
        rw [he_poly_map p]
        have h1 := RingHom.congr_fun hψ_map p
        simp only [RingHom.comp_apply] at h1
        rw [← h1, ← RingHom.comp_apply (algebraMap P'_locK F) ψ_P, hψ_F])
      let V := TensorProduct P₀ F ↥I₀
      let proj_bilin : P_K →ₗ[P₀] ↥I₀ →ₗ[P₀] V :=
        { toFun := fun w =>
            { toFun := fun z => (algebraMap P_K F w) ⊗ₜ[P₀] z
              map_add' := fun x y => TensorProduct.tmul_add _ _ _
              map_smul' := fun p₀ z => by
                dsimp only [RingHom.id_apply]
                rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul'] }
          map_add' := fun w₁ w₂ => LinearMap.ext (fun z => by simp [map_add, TensorProduct.add_tmul])
          map_smul' := fun p₀ w => LinearMap.ext (fun z => by
            dsimp
            rw [TensorProduct.smul_tmul', Algebra.smul_def, map_mul,
              ← IsScalarTower.algebraMap_apply P₀ P_K F, ← Algebra.smul_def]) }
      let proj_V : TensorProduct P₀ P_K ↥I₀ →ₗ[P_K] V :=
        { toFun := TensorProduct.lift proj_bilin
          map_add' := map_add _
          map_smul' := fun w x => by
            induction x using TensorProduct.induction_on with
            | zero => simp
            | tmul w' z =>
              change (algebraMap P_K F (w * w')) ⊗ₜ[P₀] z = w • ((algebraMap P_K F w') ⊗ₜ[P₀] z)
              rw [map_mul, ← smul_eq_mul, ← TensorProduct.smul_tmul']
              rfl
            | add x y hx hy => simp [smul_add, hx, hy] }
      let γ_I'K : ↥I'_K →ₗ[P'_K] V :=
        { toFun := fun z' => proj_V (e_ker ⟨e_poly.symm z'.1, hz'_mem z'⟩)
          map_add' := fun x y => by
            have hadd : (⟨e_poly.symm (x + y).1, hz'_mem (x + y)⟩ : ↥I_K) =
                ⟨e_poly.symm x.1, hz'_mem x⟩ + ⟨e_poly.symm y.1, hz'_mem y⟩ :=
              Subtype.ext (map_add e_poly.symm x.1 y.1)
            rw [hadd, map_add, map_add]
          map_smul' := fun w' z' => by
            have hsmul : (⟨e_poly.symm (w' • z').1, hz'_mem (w' • z')⟩ : ↥I_K) =
                (e_poly.symm w') • ⟨e_poly.symm z'.1, hz'_mem z'⟩ :=
              Subtype.ext (map_mul e_poly.symm w' z'.1)
            change proj_V (e_ker ⟨e_poly.symm (w' • z').1, hz'_mem (w' • z')⟩) =
              w' • proj_V (e_ker ⟨e_poly.symm z'.1, hz'_mem z'⟩)
            rw [hsmul, e_ker.map_smul, proj_V.map_smul]
            have hsc : ∀ v : V, (e_poly.symm w') • v = w' • v := by
              intro v
              induction v using TensorProduct.induction_on with
              | zero => simp
              | tmul u z =>
                rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', Algebra.smul_def, Algebra.smul_def]
                congr 2
                change algebraMap P'_K F (e_poly (e_poly.symm w')) = _
                rw [e_poly.apply_symm_apply]
              | add x y hx hy => rw [smul_add, smul_add, hx, hy]
            exact hsc _ }
      have h_units_V : ∀ t : Q'_K.primeCompl, IsUnit (algebraMap P'_K (Module.End P'_K V) t.1) := by
        intro t
        rw [Module.End.isUnit_iff]
        obtain ⟨u, hu⟩ := (IsLocalization.map_units P'_locK t).map (algebraMap P'_locK F)
        have ht_smul : ∀ v : V, (t.1 : P'_K) • v = (↑u : F) • v := by
          intro v
          rw [← IsScalarTower.algebraMap_smul P'_locK t.1,
            ← IsScalarTower.algebraMap_smul F (algebraMap P'_K P'_locK t.1), ← hu]
        refine ⟨?_, ?_⟩
        · intro v₁ v₂ hv
          have h1 : (↑u : F) • v₁ = (↑u : F) • v₂ := by rw [← ht_smul v₁, ← ht_smul v₂]; exact hv
          have h2 := congrArg ((↑u⁻¹ : F) • ·) h1
          rwa [smul_smul, smul_smul, Units.inv_mul, one_smul, one_smul] at h2
        · intro v
          refine ⟨(↑u⁻¹ : F) • v, ?_⟩
          change (t.1 : P'_K) • ((↑u⁻¹ : F) • v) = v
          rw [ht_smul, smul_smul, Units.mul_inv, one_smul]
      let γ_JK_PK : ↥J'_K →ₗ[P'_K] V := IsLocalizedModule.lift Q'_K.primeCompl f'_K γ_I'K h_units_V
      have hγ_JK_smul : ∀ (r : P'_locK) (y : ↥J'_K), γ_JK_PK (r • y) = r • γ_JK_PK y := by
        intro r y
        obtain ⟨⟨p, t⟩, hrt⟩ := IsLocalization.surj Q'_K.primeCompl r
        dsimp at hrt
        have ht_eq : t.1 • (r • y) = p • y := by
          ext
          simp only [Submodule.coe_smul_of_tower, smul_eq_mul, Algebra.smul_def]
          rw [← mul_assoc, mul_comm (algebraMap P'_K P'_locK t.1) r, hrt]
        have h1 : t.1 • γ_JK_PK (r • y) = t.1 • (r • γ_JK_PK y) := by
          rw [← γ_JK_PK.map_smul, ht_eq, γ_JK_PK.map_smul]
          rw [← IsScalarTower.algebraMap_smul P'_locK p, ← IsScalarTower.algebraMap_smul F (algebraMap P'_K P'_locK p)]
          rw [← IsScalarTower.algebraMap_smul P'_locK t.1, ← IsScalarTower.algebraMap_smul F (algebraMap P'_K P'_locK t.1)]
          rw [← IsScalarTower.algebraMap_smul F r, smul_smul, ← map_mul, mul_comm _ r, hrt]
        exact ((Module.End.isUnit_iff _).mp (h_units_V t)).1 h1
      let σ₀_bilin : F →ₗ[P₀] ↥I₀ →ₗ[P₀] TensorProduct P_loc F ↥J₀ :=
        { toFun := fun u =>
            { toFun := fun z => u ⊗ₜ[P_loc] f₀ z
              map_add' := fun x y => by rw [map_add, TensorProduct.tmul_add]
              map_smul' := fun p₀ z => by
                dsimp only [RingHom.id_apply]
                rw [f₀.map_smul]
                have hsm : (p₀ • f₀ z : ↥J₀) = (algebraMap P₀ P_loc p₀) • f₀ z := by ext; simp [Algebra.smul_def]
                rw [hsm, ← TensorProduct.smul_tmul, TensorProduct.smul_tmul',
                  IsScalarTower.algebraMap_smul P_loc p₀] }
          map_add' := fun u v => LinearMap.ext (fun z => by simp [TensorProduct.add_tmul])
          map_smul' := fun p₀ u => LinearMap.ext (fun z => by dsimp; rw [TensorProduct.smul_tmul']) }
      let σ₀ : V →ₗ[F] TensorProduct P_loc F ↥J₀ :=
        { toFun := TensorProduct.lift σ₀_bilin
          map_add' := map_add _
          map_smul' := fun c v => by
            induction v using TensorProduct.induction_on with
            | zero => simp
            | tmul u z => rw [TensorProduct.smul_tmul', smul_eq_mul, TensorProduct.lift.tmul]; rfl
            | add x y hx hy => simp [smul_add, hx, hy] }
      let γ_bilin : F →ₗ[P'_locK] ↥J'_K →ₗ[P'_locK] V :=
        { toFun := fun u =>
            { toFun := fun y => u • γ_JK_PK y
              map_add' := fun x y => by rw [map_add, smul_add]
              map_smul' := fun r y => by
                dsimp only [RingHom.id_apply]
                rw [hγ_JK_smul, ← IsScalarTower.algebraMap_smul F r (γ_JK_PK y),
                  ← IsScalarTower.algebraMap_smul F r (u • γ_JK_PK y), smul_smul, smul_smul, mul_comm] }
          map_add' := fun u v => LinearMap.ext (fun y => by simp [add_smul])
          map_smul' := fun r u => LinearMap.ext (fun y => by
            dsimp
            rw [← IsScalarTower.algebraMap_smul F r (u • γ_JK_PK y), Algebra.smul_def, mul_smul]) }
      let γ_mid : TensorProduct P'_locK F ↥J'_K →ₗ[F] V :=
        { toFun := TensorProduct.lift γ_bilin
          map_add' := map_add _
          map_smul' := fun c w => by
            induction w using TensorProduct.induction_on with
            | zero => simp
            | tmul u y => rw [TensorProduct.smul_tmul', smul_eq_mul, TensorProduct.lift.tmul]; dsimp [γ_bilin]; rw [mul_smul]
            | add x y hx hy => simp [smul_add, hx, hy] }
      let γ : TensorProduct P'_locK F ↥J'_K →ₗ[F] TensorProduct P_loc F ↥J₀ := σ₀.comp γ_mid
      have hγα_id : ∀ w, γ (α w) = w := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul u y =>
          obtain ⟨⟨z, s⟩, hsy⟩ := IsLocalizedModule.surj Q₀.primeCompl f₀ y
          obtain ⟨v_s, hv_s⟩ := (IsLocalization.map_units P_loc s).map (algebraMap P_loc F)
          have hw_eq : u ⊗ₜ[P_loc] y = (u * ↑v_s⁻¹) ⊗ₜ[P_loc] (s • y) := by
            have h1 : (s • y : ↥J₀) = (algebraMap P₀ P_loc s.1) • y := by
              ext; change s.1 • y.1 = algebraMap P₀ P_loc s.1 * y.1; rw [Algebra.smul_def]
            rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_comm _ (u * _), mul_assoc]
            change u ⊗ₜ[P_loc] y = (u * (↑v_s⁻¹ * algebraMap P_loc F (algebraMap P₀ P_loc s.1))) ⊗ₜ[P_loc] y
            rw [← hv_s, Units.inv_mul, mul_one]
          rw [hw_eq, hsy]
          let u' := u * ↑v_s⁻¹
          let z'_K : ↥I'_K := ⟨map_P z.1, (hz_mem z).1⟩
          have hα_z : α (u' ⊗ₜ[P_loc] f₀ z) = u' ⊗ₜ[P'_locK] f'_K z'_K := by
            change u' ⊗ₜ[P'_locK] ⟨ψ_P (f₀ z).1, _⟩ = u' ⊗ₜ[P'_locK] f'_K z'_K
            congr 1; ext; change ψ_P (f₀ z).1 = (f'_K z'_K).1
            rw [hf₀_val, hf'K_val]
            exact RingHom.congr_fun hψ_map z.1
          rw [hα_z]
          change σ₀ (u' • γ_JK_PK (f'_K z'_K)) = _
          rw [IsLocalizedModule.lift_apply, LinearMap.map_smul]
          have hz'_symm : (⟨e_poly.symm z'_K.1, hz'_mem z'_K⟩ : ↥I_K) = ⟨(1 : K) ⊗ₜ[R₀] z.1, (hz_mem z).2⟩ := by
            ext; apply e_poly.injective; rw [e_poly.apply_symm_apply, he_poly_map z.1]
          change u' • σ₀ (proj_V (e_ker ⟨e_poly.symm z'_K.1, hz'_mem z'_K⟩)) = _
          rw [hz'_symm, he_ker_z z (hz_mem z).2]
          have hproj_z : proj_V ((1 : P_K) ⊗ₜ[P₀] z) = (1 : F) ⊗ₜ[P₀] z := by
            change TensorProduct.lift proj_bilin ((1 : P_K) ⊗ₜ[P₀] z) = _
            rw [TensorProduct.lift.tmul]; dsimp [proj_bilin]; rw [map_one]
          have hσ_z : σ₀ ((1 : F) ⊗ₜ[P₀] z) = (1 : F) ⊗ₜ[P_loc] f₀ z := rfl
          rw [hproj_z, hσ_z, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        | add x y hx hy => simp [hx, hy]
      exact ⟨α, fun u y => ⟨hψ_J y, rfl⟩, Function.LeftInverse.injective hγα_id⟩
    have hSmK : Algebra.IsSmoothAt K_in q_K_in.asIdeal := by
      have : Algebra.IsStandardSmooth K_in (Localization.Away h_K_in) := hSmRel_in.isStandardSmooth
      have hFS : Algebra.FormallySmooth K_in (Localization.Away h_K_in) := inferInstance
      exact (Algebra.basicOpen_subset_smoothLocus_iff.mpr hFS) hh_K_in
    have hPart1 : ∃ (N : ℕ) (π₀ : MvPolynomial (Fin N) R₀_in →ₐ[R₀_in] A₀_in)
        (π'_K : MvPolynomial (Fin N) K_in →ₐ[K_in] TensorProduct R₀_in K_in A₀_in)
        (e_poly : TensorProduct R₀_in K_in (MvPolynomial (Fin N) R₀_in) ≃ₐ[K_in] MvPolynomial (Fin N) K_in),
        Function.Surjective π₀ ∧
        (RingHom.ker π₀.toRingHom).FG ∧
        Function.Surjective π'_K ∧
        (RingHom.ker π'_K.toRingHom).FG ∧
        (∀ x, π'_K x = Algebra.TensorProduct.map (AlgHom.id K_in K_in)
          ⟨π₀.toRingHom, π₀.commutes⟩ (e_poly.symm x)) ∧
        (∀ p, e_poly ((1 : K_in) ⊗ₜ[R₀_in] p) = MvPolynomial.map (algebraMap R₀_in K_in) p) ∧
        (∀ p, π'_K (MvPolynomial.map (algebraMap R₀_in K_in) p) =
          Algebra.TensorProduct.includeRight (π₀ p)) := by
      obtain ⟨N, π₀, hπ₀_surj⟩ :=
        Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType R₀_in A₀_in)
      let P₀ := MvPolynomial (Fin N) R₀_in
      have hI₀_fg : (RingHom.ker π₀.toRingHom).FG :=
        Algebra.FinitePresentation.ker_fg_of_mvPolynomial π₀ hπ₀_surj
      let P_K := TensorProduct R₀_in K_in P₀
      let A'_K := TensorProduct R₀_in K_in A₀_in
      let π_K : P_K →ₐ[K_in] A'_K :=
        Algebra.TensorProduct.map (AlgHom.id K_in K_in) ⟨π₀.toRingHom, π₀.commutes⟩
      have hπ_K_surj : Function.Surjective π_K :=
        Algebra.TensorProduct.map_surjective _ _ Function.surjective_id hπ₀_surj
      have hker_PK_fg : (RingHom.ker π_K.toRingHom).FG := by
        have hmap_eq : π_K.toRingHom =
            (Algebra.TensorProduct.map (AlgHom.id R₀_in K_in) ⟨π₀.toRingHom, π₀.commutes⟩).toRingHom := by
          refine RingHom.ext (fun x => ?_)
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul c p =>
            change π_K (c ⊗ₜ[R₀_in] p) =
              (Algebra.TensorProduct.map (AlgHom.id R₀_in K_in) ⟨π₀.toRingHom, π₀.commutes⟩) (c ⊗ₜ[R₀_in] p)
            rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul,
              AlgHom.id_apply, AlgHom.id_apply]
          | add x y hx hy => rw [map_add, map_add, hx, hy]
        rw [hmap_eq]
        have hker_eq := @Algebra.TensorProduct.lTensor_ker R₀_in _ K_in P₀ A₀_in _ _ _ _ _ _
          ⟨π₀.toRingHom, π₀.commutes⟩ hπ₀_surj
        change (RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R₀_in K_in) ⟨π₀.toRingHom, π₀.commutes⟩)).FG
        rw [hker_eq]
        exact hI₀_fg.map _
      let P'_K := MvPolynomial (Fin N) K_in
      let e_poly : P_K ≃ₐ[K_in] P'_K := MvPolynomial.algebraTensorAlgEquiv R₀_in K_in
      let π'_K : P'_K →ₐ[K_in] A'_K := π_K.comp e_poly.symm
      have hπ'_K_surj : Function.Surjective π'_K := hπ_K_surj.comp e_poly.symm.surjective
      have hI'_K_fg : (RingHom.ker π'_K.toRingHom).FG := by
        have hker_eq : RingHom.ker π'_K.toRingHom =
            Ideal.map e_poly.toRingHom (RingHom.ker π_K.toRingHom) := by
          apply le_antisymm
          · intro x hx
            have hx' : e_poly.symm x ∈ RingHom.ker π_K.toRingHom := hx
            rw [← e_poly.apply_symm_apply x]
            exact Ideal.mem_map_of_mem e_poly.toRingHom hx'
          · rw [Ideal.map_le_iff_le_comap]
            intro x hx
            change π_K (e_poly.symm (e_poly x)) = 0
            rw [e_poly.symm_apply_apply]
            exact hx
        rw [hker_eq]
        exact hker_PK_fg.map _
      have he_poly_map : ∀ p : P₀, e_poly ((1 : K_in) ⊗ₜ[R₀_in] p) = MvPolynomial.map (algebraMap R₀_in K_in) p := by
        intro p
        change (MvPolynomial.algebraTensorAlgEquiv R₀_in K_in) ((1 : K_in) ⊗ₜ[R₀_in] p) = _
        rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
      have hπ'_map_P : ∀ p : P₀, π'_K (MvPolynomial.map (algebraMap R₀_in K_in) p) =
          Algebra.TensorProduct.includeRight (π₀ p) := by
        intro p
        change π_K (e_poly.symm (MvPolynomial.map (algebraMap R₀_in K_in) p)) = _
        rw [← he_poly_map p, e_poly.symm_apply_apply,
          Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Algebra.TensorProduct.includeRight_apply]
      exact ⟨N, π₀, π'_K, e_poly, hπ₀_surj, hI₀_fg, hπ'_K_surj, hI'_K_fg,
        fun _ => rfl, he_poly_map, hπ'_map_P⟩
    have hSm₀ : Algebra.IsSmoothAt R₀_in q₀_in.asIdeal := by
      obtain ⟨N, π₀, π'_K, e_poly, hπ₀_surj, hI₀_fg, hπ'_K_surj, hI'_K_fg,
        hπ'_apply, he_poly_map, hπ'_map_P⟩ := hPart1
      let P₀ := MvPolynomial (Fin N) R₀_in
      let P'_K := MvPolynomial (Fin N) K_in
      let A'_K := TensorProduct R₀_in K_in A₀_in
      let : Algebra P₀ A₀_in := π₀.toRingHom.toAlgebra
      have : IsScalarTower R₀_in P₀ A₀_in := IsScalarTower.of_algebraMap_eq (fun r => (π₀.commutes r).symm)
      have hπ₀_surj' : Function.Surjective (algebraMap P₀ A₀_in) := hπ₀_surj
      let : Algebra P'_K A'_K := π'_K.toRingHom.toAlgebra
      have : IsScalarTower K_in P'_K A'_K := IsScalarTower.of_algebraMap_eq (fun c => (π'_K.commutes c).symm)
      have hπ'_K_surj' : Function.Surjective (algebraMap P'_K A'_K) := hπ'_K_surj
      let map_P : P₀ →+* P'_K := MvPolynomial.map (algebraMap R₀_in K_in)
      let Q₀ : Ideal P₀ := Ideal.comap (algebraMap P₀ A₀_in) q₀_in.asIdeal
      have : Q₀.IsPrime := Ideal.IsPrime.comap _
      let P_loc := Localization.AtPrime Q₀
