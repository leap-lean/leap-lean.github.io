                    ((congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp _ _).symm).trans
                      (congrArg (fun g => AlgebraicGeometry.Spec.map (CommRingCat.ofHom g))
                        h_away_comp)))).trans
                  (AlgebraicGeometry.Proj.awayι_comp_map (f₂.comp f₁) hf₁₂ zero_lt_one
                    (MvPolynomial.X a) hXa).symm)))))

    have hProjMapUnitScale : ∀ (A : Type u) [CommRing A] (r : ℕ) (u_unit : Aˣ),
        let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (r + 1)) A
        letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
        ∃ (S_v : 𝒜 →+*ᵍ 𝒜)
          (hS_v : HomogeneousIdeal.irrelevant 𝒜 ≤
            HomogeneousIdeal.map S_v (HomogeneousIdeal.irrelevant 𝒜)),
          (∀ c : A, S_v.toRingHom (MvPolynomial.C c) = MvPolynomial.C c) ∧
          (∀ i : Fin (r + 1), S_v.toRingHom (MvPolynomial.X i) =
            (MvPolynomial.C u_unit.val : MvPolynomial (Fin (r + 1)) A) *
              (MvPolynomial.X i : MvPolynomial (Fin (r + 1)) A)) ∧
          AlgebraicGeometry.Proj.map S_v hS_v = 𝟙 (AlgebraicGeometry.Proj 𝒜) := by
      intro A _ r u_unit 𝒜
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let s_raw : MvPolynomial (Fin (r + 1)) A →+* MvPolynomial (Fin (r + 1)) A :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.C u_unit.val * MvPolynomial.X i)
      have hs_hom : ∀ (d : ℕ) {P : MvPolynomial (Fin (r + 1)) A},
          P ∈ 𝒜 d → s_raw P = P * (MvPolynomial.C u_unit.val) ^ d := by
        intro d P hP
        have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hP
        have hs_prod : ∀ (m : Fin (r + 1) →₀ ℕ) (S_fin : Finset (Fin (r + 1))),
            s_raw (∏ i ∈ S_fin, MvPolynomial.X i ^ m i) =
              (∏ i ∈ S_fin, MvPolynomial.X i ^ m i) *
                (MvPolynomial.C u_unit.val) ^ (∑ i ∈ S_fin, m i) := by
          intro m S_fin
          induction S_fin using Finset.induction_on with
          | empty => simp
          | insert i S_fin hi ih =>
            rw [Finset.prod_insert hi, Finset.sum_insert hi, map_mul, map_pow, ih]
            simp only [s_raw, MvPolynomial.eval₂Hom_X']
            rw [mul_pow, pow_add]
            ring
        conv_lhs => rw [MvPolynomial.as_sum P]
        conv_rhs => rw [MvPolynomial.as_sum P, Finset.sum_mul]
        rw [map_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hm_deg : (∑ i ∈ m.support, m i) = d := by
          have hw := hP_hom (MvPolynomial.mem_support_iff.mp hm)
          simpa [Finsupp.weight_apply, Finsupp.sum] using hw
        rw [MvPolynomial.monomial_eq, map_mul]
        have hsC : s_raw (MvPolynomial.C (P.coeff m)) = MvPolynomial.C (P.coeff m) :=
          MvPolynomial.eval₂Hom_C _ _ _
        rw [hsC]
        change MvPolynomial.C (P.coeff m) * s_raw (∏ i ∈ m.support, MvPolynomial.X i ^ m i) =
          MvPolynomial.C (P.coeff m) * (∏ i ∈ m.support, MvPolynomial.X i ^ m i) *
            MvPolynomial.C u_unit.val ^ d
        rw [hs_prod m m.support, hm_deg, mul_assoc]
      have hCu_mem : (MvPolynomial.C u_unit.val : MvPolynomial (Fin (r + 1)) A) ∈ 𝒜 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ u_unit.val)
      let S_v : 𝒜 →+*ᵍ 𝒜 :=
        { toRingHom := s_raw
          map_mem := fun {i} {P} hP => by
            rw [hs_hom i hP]
            have hpow : (MvPolynomial.C u_unit.val : MvPolynomial (Fin (r + 1)) A) ^ i ∈ 𝒜 0 := by
              simpa using SetLike.pow_mem_graded i hCu_mem
            simpa using SetLike.GradedMonoid.toGradedMul.mul_mem hP hpow }
      have hS_v : HomogeneousIdeal.irrelevant 𝒜 ≤
          HomogeneousIdeal.map S_v (HomogeneousIdeal.irrelevant 𝒜) := by
        change (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
          (HomogeneousIdeal.map S_v (HomogeneousIdeal.irrelevant 𝒜)).toIdeal
        rw [HomogeneousIdeal.toIdeal_map]
        refine le_trans (hIrrelPkg A r).1 (Ideal.span_le.mpr ?_)
        rintro _ ⟨i, rfl⟩
        have hXi_inv : (MvPolynomial.X i : MvPolynomial (Fin (r + 1)) A) =
            MvPolynomial.C (↑u_unit⁻¹ : A) * S_v.toRingHom (MvPolynomial.X i) := by
          have hSX : S_v.toRingHom (MvPolynomial.X i) =
              MvPolynomial.C u_unit.val * MvPolynomial.X i :=
            MvPolynomial.eval₂Hom_X' _ _ i
          rw [hSX, ← mul_assoc, ← MvPolynomial.C_mul, Units.inv_mul, MvPolynomial.C_1, one_mul]
        rw [hXi_inv]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem S_v.toRingHom ((hIrrelPkg A r).2 i))
      refine ⟨S_v, hS_v, fun c => MvPolynomial.eval₂Hom_C _ _ c,
        fun i => MvPolynomial.eval₂Hom_X' _ _ i, ?_⟩
      apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro x
      let π_S := AlgebraicGeometry.Proj.map S_v hS_v
      have hCov : (⨆ i : Fin (r + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X (hIrrelPkg A r).1
      have hy : π_S.base x ∈ (⨆ i : Fin (r + 1),
          AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) := by
        rw [hCov]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
      have hx_pre : x ∈ (TopologicalSpace.Opens.map π_S.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) := hi
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen S_v hS_v (MvPolynomial.X i)] at hx_pre
      have hXi : (MvPolynomial.X i : MvPolynomial (Fin (r + 1)) A) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A i)
      have hSXi : S_v (MvPolynomial.X i) ∈ 𝒜 1 := S_v.map_mem hXi
      refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜 (S_v (MvPolynomial.X i)), hx_pre, ?_⟩
      let e_iso := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (S_v (MvPolynomial.X i))
        hSXi zero_lt_one
      have he_inv : e_iso.inv ≫
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (S_v (MvPolynomial.X i))).ι =
          AlgebraicGeometry.Proj.awayι 𝒜 (S_v (MvPolynomial.X i)) hSXi zero_lt_one :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (S_v (MvPolynomial.X i)) hSXi zero_lt_one
      rw [← cancel_epi e_iso.inv, Category.comp_id, ← Category.assoc, he_inv]
      have h_hx : S_v (MvPolynomial.X i) = MvPolynomial.X i * MvPolynomial.C u_unit.val := by
        change MvPolynomial.eval₂Hom MvPolynomial.C _ (MvPolynomial.X i) = _
        rw [MvPolynomial.eval₂Hom_X', mul_comm]
      have h_away_eq : HomogeneousLocalization.Away.map S_v (MvPolynomial.X i) =
          HomogeneousLocalization.awayMap 𝒜 hCu_mem h_hx := by
        apply RingHom.ext
        intro z
        obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXi z
        have ha' : a ∈ 𝒜 n := by simpa [smul_eq_mul, mul_one] using ha
        apply HomogeneousLocalization.val_injective
        change (HomogeneousLocalization.map S_v _
            (HomogeneousLocalization.Away.mk 𝒜 hXi n a ha)).val =
          (HomogeneousLocalization.awayMap 𝒜 hCu_mem h_hx
            (HomogeneousLocalization.Away.mk 𝒜 hXi n a ha)).val
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
        change (HomogeneousLocalization.map S_v _ (HomogeneousLocalization.mk _)).val = _
        rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
          Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [OneMemClass.coe_one, one_mul]
        change (S_v (MvPolynomial.X i)) ^ n * s_raw a =
          s_raw (MvPolynomial.X i ^ n) * (a * MvPolynomial.C u_unit.val ^ n)
        have hSX : S_v (MvPolynomial.X i) = s_raw (MvPolynomial.X i) := rfl
        have hsXi : s_raw (MvPolynomial.X i) = MvPolynomial.C u_unit.val * MvPolynomial.X i :=
          MvPolynomial.eval₂Hom_X' _ _ i
        rw [hSX, hsXi, hs_hom n ha', map_pow, hsXi]
      calc
        AlgebraicGeometry.Proj.awayι 𝒜 (S_v (MvPolynomial.X i)) hSXi zero_lt_one ≫ π_S
          = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map S_v (MvPolynomial.X i))) ≫
              AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X i) hXi zero_lt_one :=
              AlgebraicGeometry.Proj.awayι_comp_map S_v hS_v zero_lt_one (MvPolynomial.X i) hXi
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 hCu_mem h_hx)) ≫
              AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X i) hXi zero_lt_one := by
              rw [h_away_eq]
        _ = AlgebraicGeometry.Proj.awayι 𝒜 (S_v (MvPolynomial.X i)) hSXi zero_lt_one :=
              AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 hXi zero_lt_one hCu_mem h_hx

    let instGA : ∀ (K : Type u) [CommRing K] (N : ℕ),
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      fun _ _ _ => MvPolynomial.gradedAlgebra
    letI := instGA

    let p_rel (K : Type u) [CommRing K] (N : ℕ) :
        AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of K) :=
      (weilProjectiveSpaceOver K N).hom

    have hIrrelComp : ∀ {R₁ R₂ R₃ : Type u} [CommRing R₁] [CommRing R₂] [CommRing R₃]
        {K₁ K₂ K₃ : ℕ}
        {f₁ : MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁ →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂}
        {f₂ : MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂ →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (K₃ + 1)) R₃},
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂) ≤
          HomogeneousIdeal.map f₁
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁)) →
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K₃ + 1)) R₃) ≤
          HomogeneousIdeal.map f₂
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂)) →
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K₃ + 1)) R₃) ≤
          HomogeneousIdeal.map (f₂.comp f₁)
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁)) := by
      intro R₁ R₂ R₃ _ _ _ K₁ K₂ K₃ f₁ f₂ hf₁ hf₂
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁
      let 𝒜₂ := MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂
      let 𝒜₃ := MvPolynomial.homogeneousSubmodule (Fin (K₃ + 1)) R₃
      change (HomogeneousIdeal.irrelevant 𝒜₃).toIdeal ≤
        (HomogeneousIdeal.map (f₂.comp f₁) (HomogeneousIdeal.irrelevant 𝒜₁)).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      have h1 : (HomogeneousIdeal.irrelevant 𝒜₂).toIdeal ≤
          (HomogeneousIdeal.map f₁ (HomogeneousIdeal.irrelevant 𝒜₁)).toIdeal := hf₁
      have h2 : (HomogeneousIdeal.irrelevant 𝒜₃).toIdeal ≤
          (HomogeneousIdeal.map f₂ (HomogeneousIdeal.irrelevant 𝒜₂)).toIdeal := hf₂
      rw [HomogeneousIdeal.toIdeal_map] at h1 h2
      exact le_trans h2 (le_trans (Ideal.map_mono h1) (Ideal.map_map _ _).le)

    have hProjMapCongr : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] {K₁ K₂ : ℕ}
        {F G : MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁ →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂}
        (_hFG : F = G)
        (hF : HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂) ≤
          HomogeneousIdeal.map F
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁)))
        (hG : HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂) ≤
          HomogeneousIdeal.map G
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁))),
        AlgebraicGeometry.Proj.map F hF = AlgebraicGeometry.Proj.map G hG := by
      rintro R₁ R₂ _ _ K₁ K₂ F _ rfl hF hG
      rfl

    have hProjMapRel : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] {K₁ K₂ : ℕ}
        (φ : R₁ →+* R₂)
        (F : MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁ →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂)
        (hF : HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂) ≤
          HomogeneousIdeal.map F
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁))),
        (∀ c : R₁, F.toRingHom (MvPolynomial.C c) = MvPolynomial.C (φ c)) →
        AlgebraicGeometry.Proj.map F hF ≫ p_rel R₁ K₁ =
          p_rel R₂ K₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) := by
      intro R₁ R₂ _ _ K₁ K₂ φ F hF hFC
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (K₁ + 1)) R₁
      let 𝒜₂ := MvPolynomial.homogeneousSubmodule (Fin (K₂ + 1)) R₂
      apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro x
      let π_F := AlgebraicGeometry.Proj.map F hF
      have hCov₁ : (⨆ a : Fin (K₁ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜₁ MvPolynomial.X (hIrrelPkg R₁ K₁).1
      have hy : π_F.base x ∈ (⨆ a : Fin (K₁ + 1),
          AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) := by
        rw [hCov₁]; trivial
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
      have hx_pre : x ∈ (TopologicalSpace.Opens.map π_F.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) := ha
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen F hF (MvPolynomial.X a)] at hx_pre
      have hXa : (MvPolynomial.X a : MvPolynomial (Fin (K₁ + 1)) R₁) ∈ 𝒜₁ 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R₁ a)
      have hFXa : F (MvPolynomial.X a) ∈ 𝒜₂ 1 := F.map_mem hXa
      refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜₂ (F (MvPolynomial.X a)), hx_pre, ?_⟩
      let e_iso := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₂ (F (MvPolynomial.X a))
        hFXa zero_lt_one
      have he_inv : e_iso.inv ≫
          (AlgebraicGeometry.Proj.basicOpen 𝒜₂ (F (MvPolynomial.X a))).ι =
          AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one
      have he_inv_assoc : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
          (m : AlgebraicGeometry.Proj 𝒜₂ ⟶ Z),
          e_iso.inv ≫ (AlgebraicGeometry.Proj.basicOpen 𝒜₂ (F (MvPolynomial.X a))).ι ≫ m =
            AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫ m :=
        fun m => by rw [← Category.assoc, he_inv]
      rw [← cancel_epi e_iso.inv, he_inv_assoc, he_inv_assoc]
      have hp₁ : AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one ≫ p_rel R₁ K₁ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R₁ ↥(𝒜₁ 0)))) := by
        change AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫ AlgebraicGeometry.Spec.map _) = _
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have hp₂ : AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫
          p_rel R₂ K₂ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₂
              (Submonoid.powers (F (MvPolynomial.X a)))).comp (algebraMap R₂ ↥(𝒜₂ 0)))) := by
        change AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜₂ ≫ AlgebraicGeometry.Spec.map _) = _
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have h_ring : (HomogeneousLocalization.Away.map F (MvPolynomial.X a)).comp
          ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
            (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R₁ ↥(𝒜₁ 0))) =
          ((HomogeneousLocalization.fromZeroRingHom 𝒜₂
            (Submonoid.powers (F (MvPolynomial.X a)))).comp (algebraMap R₂ ↥(𝒜₂ 0))).comp φ := by
        apply RingHom.ext
        intro c
        apply HomogeneousLocalization.val_injective
        have h_comap : Submonoid.powers (MvPolynomial.X a) ≤
            Submonoid.comap F (Submonoid.powers (F (MvPolynomial.X a))) := by
          rintro _ ⟨n, rfl⟩
          exact ⟨n, (map_pow F (MvPolynomial.X a) n).symm⟩
        change (HomogeneousLocalization.map F h_comap (HomogeneousLocalization.mk _)).val =
          (HomogeneousLocalization.mk _).val
        rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
          HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [OneMemClass.coe_one, one_mul]
        change 1 * F.toRingHom (MvPolynomial.C c) = F.toRingHom 1 * MvPolynomial.C (φ c)
        rw [hFC c, map_one]
      calc
        AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫ π_F ≫ p_rel R₁ K₁
          = (AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫ π_F) ≫
              p_rel R₁ K₁ := by rw [Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map F (MvPolynomial.X a))) ≫
              (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one ≫ p_rel R₁ K₁) := by
              rw [AlgebraicGeometry.Proj.awayι_comp_map F hF zero_lt_one (MvPolynomial.X a) hXa,
                Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((HomogeneousLocalization.Away.map F (MvPolynomial.X a)).comp
                ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                  (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R₁ ↥(𝒜₁ 0))))) := by
              rw [hp₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (((HomogeneousLocalization.fromZeroRingHom 𝒜₂
                (Submonoid.powers (F (MvPolynomial.X a)))).comp (algebraMap R₂ ↥(𝒜₂ 0))).comp φ)) := by
              rw [h_ring]
        _ = (AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫ p_rel R₂ K₂) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) := by
              rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hp₂]
        _ = AlgebraicGeometry.Proj.awayι 𝒜₂ (F (MvPolynomial.X a)) hFXa zero_lt_one ≫
              p_rel R₂ K₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) := by
              rw [Category.assoc]

    let V_orig (α : Fin (s₀ + 1)) : C₃.left.Opens :=
      (TopologicalSpace.Opens.map g₃.left.base).obj (U α)
    let V' (β : Fin (s'₀ + 1)) : C₃.left.Opens :=
      (TopologicalSpace.Opens.map g₃.left.base).obj (U' β)
    let V'_ov (β γ : Fin (s'₀ + 1)) : C₃.left.Opens :=
      (TopologicalSpace.Opens.map g₃.left.base).obj (U' β ⊓ U' γ)
    let A_orig (α : Fin (s₀ + 1)) : Type u := ↑(B₃.left.presheaf.obj (Opposite.op (U α)))
    let A' (β : Fin (s'₀ + 1)) : Type u := ↑(B₃.left.presheaf.obj (Opposite.op (U' β)))
    let A'_ov (β γ : Fin (s'₀ + 1)) : Type u :=
      ↑(B₃.left.presheaf.obj (Opposite.op (U' β ⊓ U' γ)))

    have hChartPull : ∀ β : Fin (s'₀ + 1),
        let ρ_β : A_orig (μ β) →+* A' β :=
          (B₃.left.presheaf.map (CategoryTheory.homOfLE (hSub β)).op).hom
        ∃ (R_β : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A_orig (μ β)) →+*ᵍ
            MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' β))
          (hR_β : HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' β)) ≤
            HomogeneousIdeal.map R_β
              (HomogeneousIdeal.irrelevant
                (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A_orig (μ β)))))
          (j'_β : (V' β).toScheme ⟶
            AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' β))),
          (∀ c : A_orig (μ β), R_β.toRingHom (MvPolynomial.C c) = MvPolynomial.C (ρ_β c)) ∧
          (∀ i : Fin (r₀ + 1), R_β.toRingHom (MvPolynomial.X i) = MvPolynomial.X i) ∧
          CategoryTheory.IsPullback (AlgebraicGeometry.Proj.map R_β hR_β)
            (p_rel (A' β) r₀) (p_rel (A_orig (μ β)) r₀)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β)) ∧
          j'_β ≫ AlgebraicGeometry.Proj.map R_β hR_β =
            C₃.left.homOfLE ((TopologicalSpace.Opens.map g₃.left.base).monotone (hSub β)) ≫
              j_loc (μ β) ∧
          j'_β ≫ p_rel (A' β) r₀ = g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ (U' β).toSpecΓ ∧
          AlgebraicGeometry.IsClosedImmersion j'_β := by
      intro β ρ_β
      obtain ⟨⟨R_β, hR_β, hRC, hRX⟩, hPB_gen⟩ := hProjPB (A_orig (μ β)) (A' β) r₀ ρ_β
      have hPB_β : CategoryTheory.IsPullback (AlgebraicGeometry.Proj.map R_β hR_β)
          (p_rel (A' β) r₀) (p_rel (A_orig (μ β)) r₀)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β)) :=
        hPB_gen R_β hR_β hRC hRX
      have hV_sub : V' β ≤ V_orig (μ β) :=
        (TopologicalSpace.Opens.map g₃.left.base).monotone (hSub β)
      have h_res_comm : C₃.left.homOfLE hV_sub ≫ g₃.left.resLE (U (μ β)) (V_orig (μ β)) (le_refl _) =
          g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ B₃.left.homOfLE (hSub β) := by
        rw [← cancel_mono (U (μ β)).ι, Category.assoc, Category.assoc,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, AlgebraicGeometry.Scheme.homOfLE_ι_assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      have h_spec_ρ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β) =
          AlgebraicGeometry.Spec.map (B₃.left.presheaf.map (CategoryTheory.homOfLE (hSub β)).op) :=
        congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
      have h_lift_comm : (C₃.left.homOfLE hV_sub ≫ j_loc (μ β)) ≫ p_rel (A_orig (μ β)) r₀ =
          (g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ (U' β).toSpecΓ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β) := by
        calc (C₃.left.homOfLE hV_sub ≫ j_loc (μ β)) ≫ p_rel (A_orig (μ β)) r₀
            = C₃.left.homOfLE hV_sub ≫ (j_loc (μ β) ≫ p_rel (A_orig (μ β)) r₀) := by
                rw [Category.assoc]
          _ = C₃.left.homOfLE hV_sub ≫
                (g₃.left.resLE (U (μ β)) (V_orig (μ β)) (le_refl _) ≫ (U (μ β)).toSpecΓ) :=
                congrArg (C₃.left.homOfLE hV_sub ≫ ·) (hComm_j (μ β))
          _ = (C₃.left.homOfLE hV_sub ≫ g₃.left.resLE (U (μ β)) (V_orig (μ β)) (le_refl _)) ≫
                (U (μ β)).toSpecΓ := by rw [← Category.assoc]
          _ = g₃.left.resLE (U' β) (V' β) (le_refl _) ≫
                (B₃.left.homOfLE (hSub β) ≫ (U (μ β)).toSpecΓ) := by
                rw [h_res_comm, Category.assoc]
          _ = g₃.left.resLE (U' β) (V' β) (le_refl _) ≫
                ((U' β).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β)) := by
                rw [h_spec_ρ, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map]
          _ = (g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ (U' β).toSpecΓ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β) := by rw [← Category.assoc]
      let j'_β := hPB_β.lift (C₃.left.homOfLE hV_sub ≫ j_loc (μ β))
        (g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ (U' β).toSpecΓ) h_lift_comm
      have hj'_fst : j'_β ≫ AlgebraicGeometry.Proj.map R_β hR_β =
          C₃.left.homOfLE hV_sub ≫ j_loc (μ β) := hPB_β.lift_fst _ _ _
      have hj'_snd : j'_β ≫ p_rel (A' β) r₀ =
          g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ (U' β).toSpecΓ := hPB_β.lift_snd _ _ _
      have hPB_open : CategoryTheory.IsPullback
          (g₃.left.resLE (U' β) (V' β) (le_refl _))
          (C₃.left.homOfLE hV_sub)
          (B₃.left.homOfLE (hSub β))
          (g₃.left.resLE (U (μ β)) (V_orig (μ β)) (le_refl _)) := by
        refine AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _ h_res_comm ?_
        have h_homOfLE_rng : ∀ {X : AlgebraicGeometry.Scheme.{u}} {W₁ W₂ : X.Opens}
            (hle : W₁ ≤ W₂) (pt : ↥W₂.toScheme),
            pt ∈ (X.homOfLE hle).opensRange ↔ W₂.ι.base pt ∈ W₁ := by
          intro X W₁ W₂ hle pt
          change pt ∈ Set.range (X.homOfLE hle).base ↔ W₂.ι.base pt ∈ W₁
          constructor
          · rintro ⟨z, rfl⟩
            have hz : W₂.ι.base ((X.homOfLE hle).base z) = W₁.ι.base z :=
              congrArg (fun m => m.base z) (X.homOfLE_ι hle)
            rw [hz]
            exact z.2
          · intro hpt
            exact ⟨⟨W₂.ι.base pt, hpt⟩,
              Subtype.ext (congrArg (fun m => m.base ⟨W₂.ι.base pt, hpt⟩) (X.homOfLE_ι hle))⟩
        ext y
        change (g₃.left.resLE (U (μ β)) (V_orig (μ β)) (le_refl _)).base y ∈
            (B₃.left.homOfLE (hSub β)).opensRange ↔ y ∈ (C₃.left.homOfLE hV_sub).opensRange
        rw [h_homOfLE_rng (hSub β), h_homOfLE_rng hV_sub]
        have hy_val : (U (μ β)).ι.base
            ((g₃.left.resLE (U (μ β)) (V_orig (μ β)) (le_refl _)).base y) =
            g₃.left.base ((V_orig (μ β)).ι.base y) :=
          congrArg (fun m => m.base y)
            (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι g₃.left (le_refl _))
        rw [hy_val]
        rfl
      have hPB_outer : CategoryTheory.IsPullback
          (j'_β ≫ p_rel (A' β) r₀)
          (C₃.left.homOfLE hV_sub)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_β))
          (j_loc (μ β) ≫ p_rel (A_orig (μ β)) r₀) := by
        refine hPB_open.of_iso (CategoryTheory.Iso.refl _) (hAffU' β).isoSpec
          (CategoryTheory.Iso.refl _) (hAffU (μ β)).isoSpec ?_ ?_ ?_ ?_
        · simp only [CategoryTheory.Iso.refl_hom, Category.id_comp]
          rw [(hAffU' β).isoSpec_hom, hj'_snd]
        · simp
        · rw [(hAffU' β).isoSpec_hom, (hAffU (μ β)).isoSpec_hom, h_spec_ρ]
          exact (AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map
            (U' β) (U (μ β)) (hSub β)).symm
        · simp only [CategoryTheory.Iso.refl_hom, Category.id_comp]
          rw [(hAffU (μ β)).isoSpec_hom]
          exact (hComm_j (μ β)).symm
      have hPB_j' : CategoryTheory.IsPullback
          (C₃.left.homOfLE hV_sub) j'_β (j_loc (μ β)) (AlgebraicGeometry.Proj.map R_β hR_β) :=
        (CategoryTheory.IsPullback.of_right hPB_outer hj'_fst hPB_β.flip).flip
      have hCl_j' : AlgebraicGeometry.IsClosedImmersion j'_β :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.IsClosedImmersion) hPB_j' (hCl_j (μ β))
      exact ⟨R_β, hR_β, j'_β, hRC, hRX, hPB_β, hj'_fst, hj'_snd, hCl_j'⟩
    choose R_chart hR_chart j'_loc hRC_chart hRX_chart hPB_chart hj'_fst hj'_snd hCl_j'
      using hChartPull

    let resL (β γ : Fin (s'₀ + 1)) : A' β →+* A'_ov β γ :=
      (B₃.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
    let resR (β γ : Fin (s'₀ + 1)) : A' γ →+* A'_ov β γ :=
      (B₃.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
    let T'_mat (β γ : Fin (s'₀ + 1)) : Matrix.GeneralLinearGroup (Fin (r₀ + 1)) (A'_ov β γ) :=
      Units.map ((B₃.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub γ))).op).hom.mapMatrix).toMonoidHom
        (T (μ β) (μ γ))
    have hV_L : ∀ β γ : Fin (s'₀ + 1), V'_ov β γ ≤ V' β := fun _ _ _ hx => hx.1
    have hV_R : ∀ β γ : Fin (s'₀ + 1), V'_ov β γ ≤ V' γ := fun _ _ _ hx => hx.2
    have hOvPull : ∀ β γ : Fin (s'₀ + 1),
        ∃ (P'_map : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' β) →+*ᵍ
            MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ))
          (hP'_map : HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ)) ≤
            HomogeneousIdeal.map P'_map
              (HomogeneousIdeal.irrelevant
                (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' β))))
          (Q'_map : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' γ) →+*ᵍ
            MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ))
          (hQ'_map : HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ)) ≤
            HomogeneousIdeal.map Q'_map
              (HomogeneousIdeal.irrelevant
                (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' γ))))
          (j'_ov : (V'_ov β γ).toScheme ⟶
            AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ))),
          (∀ c : A' β, P'_map.toRingHom (MvPolynomial.C c) = MvPolynomial.C (resL β γ c)) ∧
          (∀ i : Fin (r₀ + 1), P'_map.toRingHom (MvPolynomial.X i) = MvPolynomial.X i) ∧
          j'_ov ≫ AlgebraicGeometry.Proj.map P'_map hP'_map =
            C₃.left.homOfLE (hV_L β γ) ≫ j'_loc β ∧
          (∀ c : A' γ, Q'_map.toRingHom (MvPolynomial.C c) = MvPolynomial.C (resR β γ c)) ∧
          (∀ j : Fin (r₀ + 1), Q'_map.toRingHom (MvPolynomial.X j) =
            ∑ i : Fin (r₀ + 1),
              (MvPolynomial.C ((T'_mat β γ).val i j) : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ)) *
                (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ))) ∧
          j'_ov ≫ AlgebraicGeometry.Proj.map Q'_map hQ'_map =
            C₃.left.homOfLE (hV_R β γ) ≫ j'_loc γ := by
      intro β γ
      let hSub_ov : U' β ⊓ U' γ ≤ U (μ β) ⊓ U (μ γ) := inf_le_inf (hSub β) (hSub γ)
      let A_ov0 : Type u := ↑(B₃.left.presheaf.obj (Opposite.op (U (μ β) ⊓ U (μ γ))))
      let ρ_ov : A_ov0 →+* A'_ov β γ :=
        (B₃.left.presheaf.map (CategoryTheory.homOfLE hSub_ov).op).hom
      obtain ⟨hj_ov_comm, P_map, hP_map, Q_map, hQ_map, hPC, hPX, hjP, hQC, hQX, hjQ⟩ :=
        h_ov (μ β) (μ γ)
      obtain ⟨⟨R_ov, hR_ov, hRov_C, hRov_X⟩, hPB_ov_gen⟩ := hProjPB A_ov0 (A'_ov β γ) r₀ ρ_ov
      have hPB_ov : CategoryTheory.IsPullback (AlgebraicGeometry.Proj.map R_ov hR_ov)
          (p_rel (A'_ov β γ) r₀) (p_rel A_ov0 r₀)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_ov)) :=
        hPB_ov_gen R_ov hR_ov hRov_C hRov_X
      let V_ov0 : C₃.left.Opens :=
        (TopologicalSpace.Opens.map g₃.left.base).obj (U (μ β) ⊓ U (μ γ))
      have hV_sub_ov : V'_ov β γ ≤ V_ov0 :=
        (TopologicalSpace.Opens.map g₃.left.base).monotone hSub_ov
      have h_res_ov : C₃.left.homOfLE hV_sub_ov ≫
          g₃.left.resLE (U (μ β) ⊓ U (μ γ)) V_ov0 (le_refl _) =
          g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫ B₃.left.homOfLE hSub_ov := by
        rw [← cancel_mono (U (μ β) ⊓ U (μ γ)).ι, Category.assoc, Category.assoc,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, AlgebraicGeometry.Scheme.homOfLE_ι_assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      have h_spec_ρov : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_ov) =
          AlgebraicGeometry.Spec.map (B₃.left.presheaf.map (CategoryTheory.homOfLE hSub_ov).op) :=
        congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
      have h_lift_ov : (C₃.left.homOfLE hV_sub_ov ≫ j_ov (μ β) (μ γ)) ≫ p_rel A_ov0 r₀ =
          (g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫ (U' β ⊓ U' γ).toSpecΓ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_ov) := by
        calc (C₃.left.homOfLE hV_sub_ov ≫ j_ov (μ β) (μ γ)) ≫ p_rel A_ov0 r₀
            = C₃.left.homOfLE hV_sub_ov ≫ (j_ov (μ β) (μ γ) ≫ p_rel A_ov0 r₀) := by
                rw [Category.assoc]
          _ = C₃.left.homOfLE hV_sub_ov ≫
                (g₃.left.resLE (U (μ β) ⊓ U (μ γ)) V_ov0 (le_refl _) ≫
                  (U (μ β) ⊓ U (μ γ)).toSpecΓ) :=
                congrArg (C₃.left.homOfLE hV_sub_ov ≫ ·) hj_ov_comm
          _ = (C₃.left.homOfLE hV_sub_ov ≫
                g₃.left.resLE (U (μ β) ⊓ U (μ γ)) V_ov0 (le_refl _)) ≫
                (U (μ β) ⊓ U (μ γ)).toSpecΓ := by rw [← Category.assoc]
          _ = g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
                (B₃.left.homOfLE hSub_ov ≫ (U (μ β) ⊓ U (μ γ)).toSpecΓ) := by
                rw [h_res_ov, Category.assoc]
          _ = g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
                ((U' β ⊓ U' γ).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_ov)) := by
                rw [h_spec_ρov, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map]
          _ = (g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫ (U' β ⊓ U' γ).toSpecΓ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_ov) := by rw [← Category.assoc]
      let j'_ov := hPB_ov.lift (C₃.left.homOfLE hV_sub_ov ≫ j_ov (μ β) (μ γ))
        (g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫ (U' β ⊓ U' γ).toSpecΓ) h_lift_ov
      have hj'_ov_fst : j'_ov ≫ AlgebraicGeometry.Proj.map R_ov hR_ov =
          C₃.left.homOfLE hV_sub_ov ≫ j_ov (μ β) (μ γ) := hPB_ov.lift_fst _ _ _
      have hj'_ov_snd : j'_ov ≫ p_rel (A'_ov β γ) r₀ =
          g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫ (U' β ⊓ U' γ).toSpecΓ :=
        hPB_ov.lift_snd _ _ _
      obtain ⟨⟨P'_map, hP'_map, hP'C, hP'X⟩, _⟩ := hProjPB (A' β) (A'_ov β γ) r₀ (resL β γ)
      let q'_raw : MvPolynomial (Fin (r₀ + 1)) (A' γ) →+* MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ) :=
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp (resR β γ))
          (fun j => ∑ i : Fin (r₀ + 1), MvPolynomial.C ((T'_mat β γ).val i j) * MvPolynomial.X i)
      have hq'_hom : ∀ (d : ℕ) {P : MvPolynomial (Fin (r₀ + 1)) (A' γ)},
          P ∈ MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' γ) d →
          q'_raw P ∈ MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ) d := by
        intro d P hP
        have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hP
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have hlin_hom : ∀ j : Fin (r₀ + 1),
            (∑ i : Fin (r₀ + 1),
              MvPolynomial.C ((T'_mat β γ).val i j) *
                (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ))).IsHomogeneous 1 := by
          intro j
          refine MvPolynomial.IsHomogeneous.sum _ _ _ fun i _ => ?_
          simpa using (MvPolynomial.isHomogeneous_C _ ((T'_mat β γ).val i j)).mul
            (MvPolynomial.isHomogeneous_X _ i)
        simpa [q'_raw, one_mul] using hP_hom.eval₂ (MvPolynomial.C.comp (resR β γ))
          (fun j => ∑ i : Fin (r₀ + 1), MvPolynomial.C ((T'_mat β γ).val i j) * MvPolynomial.X i)
          (fun c => MvPolynomial.isHomogeneous_C _ (resR β γ c)) hlin_hom
      let Q'_map : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' γ) →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ) :=
        { toRingHom := q'_raw
          map_mem := hq'_hom _ }
      have hQ'_map : HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ)) ≤
          HomogeneousIdeal.map Q'_map
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' γ))) := by
        change (HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A'_ov β γ))).toIdeal ≤
          (HomogeneousIdeal.map Q'_map
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' γ)))).toIdeal
        rw [HomogeneousIdeal.toIdeal_map]
        refine le_trans (hIrrelPkg (A'_ov β γ) r₀).1 (Ideal.span_le.mpr ?_)
        rintro _ ⟨k_idx, rfl⟩
        have hX_inv : (MvPolynomial.X k_idx : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ)) =
            ∑ j : Fin (r₀ + 1),
              MvPolynomial.C (((T'_mat β γ)⁻¹).val j k_idx) * Q'_map.toRingHom (MvPolynomial.X j) := by
          have h_inv_mul : (T'_mat β γ).val * ((T'_mat β γ)⁻¹).val = 1 := Units.mul_inv (T'_mat β γ)
          calc (MvPolynomial.X k_idx : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ))
              = ∑ i : Fin (r₀ + 1),
                  MvPolynomial.C ((1 : Matrix (Fin (r₀ + 1)) (Fin (r₀ + 1)) (A'_ov β γ)) i k_idx) *
                    MvPolynomial.X i := by
                  rw [Finset.sum_eq_single k_idx]
                  · simp
                  · intro i _ hik; simp [hik]
                  · intro hk; exact False.elim (hk (Finset.mem_univ k_idx))
            _ = ∑ i : Fin (r₀ + 1),
                  MvPolynomial.C (((T'_mat β γ).val * ((T'_mat β γ)⁻¹).val) i k_idx) *
                    MvPolynomial.X i := by rw [h_inv_mul]
            _ = ∑ i : Fin (r₀ + 1),
                  (∑ j : Fin (r₀ + 1),
                    MvPolynomial.C ((T'_mat β γ).val i j) *
                      MvPolynomial.C (((T'_mat β γ)⁻¹).val j k_idx)) * MvPolynomial.X i := by
                  refine Finset.sum_congr rfl fun i _ => ?_
                  simp [Matrix.mul_apply, map_sum, map_mul]
            _ = ∑ j : Fin (r₀ + 1),
                  MvPolynomial.C (((T'_mat β γ)⁻¹).val j k_idx) *
                    (∑ i : Fin (r₀ + 1),
                      MvPolynomial.C ((T'_mat β γ).val i j) * MvPolynomial.X i) := by
                  simp_rw [Finset.sum_mul]
                  rw [Finset.sum_comm]
                  refine Finset.sum_congr rfl fun j _ => ?_
                  rw [Finset.mul_sum]
                  refine Finset.sum_congr rfl fun i _ => by ring
            _ = ∑ j : Fin (r₀ + 1),
                  MvPolynomial.C (((T'_mat β γ)⁻¹).val j k_idx) *
                    Q'_map.toRingHom (MvPolynomial.X j) := by
                  refine Finset.sum_congr rfl fun j _ => ?_
                  change _ = _ * q'_raw (MvPolynomial.X j)
                  rw [MvPolynomial.eval₂Hom_X']
        rw [hX_inv]
        refine Ideal.sum_mem _ fun j _ => ?_
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem Q'_map.toRingHom ((hIrrelPkg (A' γ) r₀).2 j))
      have hj'_P : j'_ov ≫ AlgebraicGeometry.Proj.map P'_map hP'_map =
          C₃.left.homOfLE (hV_L β γ) ≫ j'_loc β := by
        have h_comp_eq : P'_map.comp (R_chart β) = R_ov.comp P_map := by
          have h_ring : (P'_map.comp (R_chart β)).toRingHom = (R_ov.comp P_map).toRingHom := by
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro c
              change P'_map.toRingHom ((R_chart β).toRingHom (MvPolynomial.C c)) =
                R_ov.toRingHom (P_map.toRingHom (MvPolynomial.C c))
              rw [hRC_chart β c, hP'C, hPC c, hRov_C]
              congr 1
              change (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom c =
                (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom c
              rw [← B₃.left.presheaf.map_comp, ← B₃.left.presheaf.map_comp]
              rfl
            · intro i
              change P'_map.toRingHom ((R_chart β).toRingHom (MvPolynomial.X i)) =
                R_ov.toRingHom (P_map.toRingHom (MvPolynomial.X i))
              rw [hRX_chart β i, hP'X i, hPX i, hRov_X i]
          ext p m
          exact congrArg (fun q => q.coeff m) (RingHom.congr_fun h_ring p)
        have h_irrel_L := hIrrelComp (hR_chart β) hP'_map
        have h_irrel_R := hIrrelComp hP_map hR_ov
        apply (hPB_chart β).hom_ext
        · calc (j'_ov ≫ AlgebraicGeometry.Proj.map P'_map hP'_map) ≫
                AlgebraicGeometry.Proj.map (R_chart β) (hR_chart β)
              = j'_ov ≫ (AlgebraicGeometry.Proj.map P'_map hP'_map ≫
                  AlgebraicGeometry.Proj.map (R_chart β) (hR_chart β)) := by rw [Category.assoc]
            _ = j'_ov ≫ AlgebraicGeometry.Proj.map (P'_map.comp (R_chart β)) h_irrel_L := by
                  rw [hProjMapComp (A_orig (μ β)) (A' β) (A'_ov β γ) r₀ r₀ r₀
                    (R_chart β) (hR_chart β) P'_map hP'_map h_irrel_L]
            _ = j'_ov ≫ AlgebraicGeometry.Proj.map (R_ov.comp P_map) h_irrel_R := by
                  rw [hProjMapCongr h_comp_eq h_irrel_L h_irrel_R]
            _ = (j'_ov ≫ AlgebraicGeometry.Proj.map R_ov hR_ov) ≫
                  AlgebraicGeometry.Proj.map P_map hP_map := by
                  rw [← hProjMapComp (A_orig (μ β)) A_ov0 (A'_ov β γ) r₀ r₀ r₀
                    P_map hP_map R_ov hR_ov h_irrel_R, Category.assoc]
            _ = C₃.left.homOfLE hV_sub_ov ≫
                  (j_ov (μ β) (μ γ) ≫ AlgebraicGeometry.Proj.map P_map hP_map) := by
                  rw [hj'_ov_fst, Category.assoc]
            _ = (C₃.left.homOfLE hV_sub_ov ≫
                  C₃.left.homOfLE ((TopologicalSpace.Opens.map g₃.left.base).monotone inf_le_left)) ≫
                  j_loc (μ β) := by rw [hjP, Category.assoc]
            _ = (C₃.left.homOfLE (hV_L β γ) ≫
                  C₃.left.homOfLE ((TopologicalSpace.Opens.map g₃.left.base).monotone (hSub β))) ≫
                  j_loc (μ β) := by
                  rw [AlgebraicGeometry.Scheme.homOfLE_homOfLE,
                    AlgebraicGeometry.Scheme.homOfLE_homOfLE]
            _ = (C₃.left.homOfLE (hV_L β γ) ≫ j'_loc β) ≫
                  AlgebraicGeometry.Proj.map (R_chart β) (hR_chart β) := by
                  rw [Category.assoc, ← hj'_fst β, Category.assoc]
        · have h_spec_L : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resL β γ)) =
              AlgebraicGeometry.Spec.map
                (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U' β ⊓ U' γ ≤ U' β)).op) :=
            congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
          have h_res_V : g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
              B₃.left.homOfLE (inf_le_left : U' β ⊓ U' γ ≤ U' β) =
              C₃.left.homOfLE (hV_L β γ) ≫ g₃.left.resLE (U' β) (V' β) (le_refl _) := by
            rw [← cancel_mono (U' β).ι, Category.assoc, Category.assoc,
              AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
          calc (j'_ov ≫ AlgebraicGeometry.Proj.map P'_map hP'_map) ≫ p_rel (A' β) r₀
              = j'_ov ≫ (AlgebraicGeometry.Proj.map P'_map hP'_map ≫ p_rel (A' β) r₀) := by
                  rw [Category.assoc]
            _ = (j'_ov ≫ p_rel (A'_ov β γ) r₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resL β γ)) := by
                  rw [hProjMapRel (resL β γ) P'_map hP'_map hP'C, Category.assoc]
            _ = g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
                  ((U' β ⊓ U' γ).toSpecΓ ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resL β γ))) := by
                  rw [hj'_ov_snd, Category.assoc]
            _ = (g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
                  B₃.left.homOfLE inf_le_left) ≫ (U' β).toSpecΓ := by
                  rw [h_spec_L, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map,
                    Category.assoc]
            _ = (C₃.left.homOfLE (hV_L β γ) ≫ j'_loc β) ≫ p_rel (A' β) r₀ := by
                  rw [h_res_V, Category.assoc, ← hj'_snd β, Category.assoc]
      have hQ'C : ∀ c : A' γ, Q'_map.toRingHom (MvPolynomial.C c) = MvPolynomial.C (resR β γ c) :=
        fun c => MvPolynomial.eval₂Hom_C _ _ c
      have hQ'X : ∀ j : Fin (r₀ + 1), Q'_map.toRingHom (MvPolynomial.X j) =
          ∑ i : Fin (r₀ + 1),
            (MvPolynomial.C ((T'_mat β γ).val i j) : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ)) *
              (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ)) :=
        fun j => MvPolynomial.eval₂Hom_X' _ _ j
      have hj'_Q : j'_ov ≫ AlgebraicGeometry.Proj.map Q'_map hQ'_map =
          C₃.left.homOfLE (hV_R β γ) ≫ j'_loc γ := by
        have h_comp_eq : Q'_map.comp (R_chart γ) = R_ov.comp Q_map := by
          have h_ring : (Q'_map.comp (R_chart γ)).toRingHom = (R_ov.comp Q_map).toRingHom := by
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro c
              change Q'_map.toRingHom ((R_chart γ).toRingHom (MvPolynomial.C c)) =
                R_ov.toRingHom (Q_map.toRingHom (MvPolynomial.C c))
              rw [hRC_chart γ c, hQ'C, hQC c, hRov_C]
              congr 1
              change (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom c =
                (B₃.left.presheaf.map _ ≫ B₃.left.presheaf.map _).hom c
              rw [← B₃.left.presheaf.map_comp, ← B₃.left.presheaf.map_comp]
              rfl
            · intro j
              change Q'_map.toRingHom ((R_chart γ).toRingHom (MvPolynomial.X j)) =
                R_ov.toRingHom (Q_map.toRingHom (MvPolynomial.X j))
              rw [hRX_chart γ j, hQ'X j, hQX j, map_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [map_mul, hRov_C, hRov_X i]
              rfl
          ext p m
          exact congrArg (fun q => q.coeff m) (RingHom.congr_fun h_ring p)
        have h_irrel_L := hIrrelComp (hR_chart γ) hQ'_map
        have h_irrel_R := hIrrelComp hQ_map hR_ov
        apply (hPB_chart γ).hom_ext
        · calc (j'_ov ≫ AlgebraicGeometry.Proj.map Q'_map hQ'_map) ≫
                AlgebraicGeometry.Proj.map (R_chart γ) (hR_chart γ)
              = j'_ov ≫ (AlgebraicGeometry.Proj.map Q'_map hQ'_map ≫
                  AlgebraicGeometry.Proj.map (R_chart γ) (hR_chart γ)) := by rw [Category.assoc]
            _ = j'_ov ≫ AlgebraicGeometry.Proj.map (Q'_map.comp (R_chart γ)) h_irrel_L := by
                  rw [hProjMapComp (A_orig (μ γ)) (A' γ) (A'_ov β γ) r₀ r₀ r₀
                    (R_chart γ) (hR_chart γ) Q'_map hQ'_map h_irrel_L]
            _ = j'_ov ≫ AlgebraicGeometry.Proj.map (R_ov.comp Q_map) h_irrel_R := by
                  rw [hProjMapCongr h_comp_eq h_irrel_L h_irrel_R]
            _ = (j'_ov ≫ AlgebraicGeometry.Proj.map R_ov hR_ov) ≫
                  AlgebraicGeometry.Proj.map Q_map hQ_map := by
                  rw [← hProjMapComp (A_orig (μ γ)) A_ov0 (A'_ov β γ) r₀ r₀ r₀
                    Q_map hQ_map R_ov hR_ov h_irrel_R, Category.assoc]
            _ = C₃.left.homOfLE hV_sub_ov ≫
                  (j_ov (μ β) (μ γ) ≫ AlgebraicGeometry.Proj.map Q_map hQ_map) := by
                  rw [hj'_ov_fst, Category.assoc]
            _ = (C₃.left.homOfLE hV_sub_ov ≫
                  C₃.left.homOfLE ((TopologicalSpace.Opens.map g₃.left.base).monotone inf_le_right)) ≫
                  j_loc (μ γ) := by rw [hjQ, Category.assoc]
            _ = (C₃.left.homOfLE (hV_R β γ) ≫
                  C₃.left.homOfLE ((TopologicalSpace.Opens.map g₃.left.base).monotone (hSub γ))) ≫
                  j_loc (μ γ) := by
                  rw [AlgebraicGeometry.Scheme.homOfLE_homOfLE,
                    AlgebraicGeometry.Scheme.homOfLE_homOfLE]
            _ = (C₃.left.homOfLE (hV_R β γ) ≫ j'_loc γ) ≫
                  AlgebraicGeometry.Proj.map (R_chart γ) (hR_chart γ) := by
                  rw [Category.assoc, ← hj'_fst γ, Category.assoc]
        · have h_spec_R : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resR β γ)) =
              AlgebraicGeometry.Spec.map
                (B₃.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U' β ⊓ U' γ ≤ U' γ)).op) :=
            congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
          have h_res_V : g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
              B₃.left.homOfLE (inf_le_right : U' β ⊓ U' γ ≤ U' γ) =
              C₃.left.homOfLE (hV_R β γ) ≫ g₃.left.resLE (U' γ) (V' γ) (le_refl _) := by
            rw [← cancel_mono (U' γ).ι, Category.assoc, Category.assoc,
              AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
              AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
          calc (j'_ov ≫ AlgebraicGeometry.Proj.map Q'_map hQ'_map) ≫ p_rel (A' γ) r₀
              = j'_ov ≫ (AlgebraicGeometry.Proj.map Q'_map hQ'_map ≫ p_rel (A' γ) r₀) := by
                  rw [Category.assoc]
            _ = (j'_ov ≫ p_rel (A'_ov β γ) r₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resR β γ)) := by
                  rw [hProjMapRel (resR β γ) Q'_map hQ'_map hQ'C, Category.assoc]
            _ = g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
                  ((U' β ⊓ U' γ).toSpecΓ ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (resR β γ))) := by
                  rw [hj'_ov_snd, Category.assoc]
            _ = (g₃.left.resLE (U' β ⊓ U' γ) (V'_ov β γ) (le_refl _) ≫
                  B₃.left.homOfLE inf_le_right) ≫ (U' γ).toSpecΓ := by
                  rw [h_spec_R, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map,
                    Category.assoc]
            _ = (C₃.left.homOfLE (hV_R β γ) ≫ j'_loc γ) ≫ p_rel (A' γ) r₀ := by
                  rw [h_res_V, Category.assoc, ← hj'_snd γ, Category.assoc]
      exact ⟨P'_map, hP'_map, Q'_map, hQ'_map, j'_ov, hP'C, hP'X, hj'_P, hQ'C, hQ'X, hj'_Q⟩
    choose P'_ov hP'_ov Q'_ov hQ'_ov j'_ov hP'C_ov hP'X_ov hj'_P hQ'C_ov hQ'X_ov hj'_Q
      using hOvPull

    let M₁ : ℕ := s'₀ * (r₀ + 1) + r₀
    have hM₁ : (s'₀ + 1) * (r₀ + 1) = M₁ + 1 := by
      dsimp only [M₁]; ring
    let e_idx : Fin (s'₀ + 1) × Fin (r₀ + 1) ≃ Fin (M₁ + 1) :=
      finProdFinEquiv.trans (finCongr hM₁)
    let P₁ := weilProjectiveSpaceOver k M₁
    let ℬ_k := MvPolynomial.homogeneousSubmodule (Fin (M₁ + 1)) k
    let σ_hom (W : B₃.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W) :
        CommRingCat.of k ⟶ B₃.left.presheaf.obj (Opposite.op W) :=
      AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ B₃.hom)
    have hσ_spec : ∀ (W : B₃.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W),
        W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (σ_hom W hAffW) = W.ι ≫ B₃.hom := by
      intro W hAffW
      rw [AlgebraicGeometry.Spec.map_preimage, ← hAffW.isoSpec_hom]
      dsimp only [AlgebraicGeometry.IsAffineOpen.fromSpec]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
    have hσ_res : ∀ {W₁ W₂ : B₃.left.Opens} (hAff₁ : AlgebraicGeometry.IsAffineOpen W₁)
        (hAff₂ : AlgebraicGeometry.IsAffineOpen W₂) (hle : W₁ ≤ W₂),
        σ_hom W₂ hAff₂ ≫ B₃.left.presheaf.map (CategoryTheory.homOfLE hle).op =
          σ_hom W₁ hAff₁ := by
      intro W₁ W₂ hAff₁ hAff₂ hle
      apply AlgebraicGeometry.Spec.map_injective
      have : CategoryTheory.IsIso W₁.toSpecΓ := by rw [← hAff₁.isoSpec_hom]; infer_instance
      rw [AlgebraicGeometry.Spec.map_comp, ← cancel_epi W₁.toSpecΓ]
      calc W₁.toSpecΓ ≫
            (AlgebraicGeometry.Spec.map (B₃.left.presheaf.map (CategoryTheory.homOfLE hle).op) ≫
              AlgebraicGeometry.Spec.map (σ_hom W₂ hAff₂))
          = (W₁.toSpecΓ ≫
              AlgebraicGeometry.Spec.map (B₃.left.presheaf.map (CategoryTheory.homOfLE hle).op)) ≫
              AlgebraicGeometry.Spec.map (σ_hom W₂ hAff₂) := by rw [← Category.assoc]
        _ = B₃.left.homOfLE hle ≫ (W₂.toSpecΓ ≫ AlgebraicGeometry.Spec.map (σ_hom W₂ hAff₂)) := by
              rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map, Category.assoc]
        _ = W₁.ι ≫ B₃.hom := by
              rw [hσ_spec W₂ hAff₂, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
        _ = W₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (σ_hom W₁ hAff₁) :=
              (hσ_spec W₁ hAff₁).symm

    have hBlockHoms : ∀ β : Fin (s'₀ + 1),
        let ℬ_β := MvPolynomial.homogeneousSubmodule (Fin (M₁ + 1)) (A' β)
        let 𝒜'_β := MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (A' β)
        ∃ (Ψ_β : ℬ_β →+*ᵍ 𝒜'_β)
          (hΨ_β : HomogeneousIdeal.irrelevant 𝒜'_β ≤
            HomogeneousIdeal.map Ψ_β (HomogeneousIdeal.irrelevant ℬ_β))
          (Φ_β : ℬ_k →+*ᵍ 𝒜'_β)
          (hΦ_β : HomogeneousIdeal.irrelevant 𝒜'_β ≤
            HomogeneousIdeal.map Φ_β (HomogeneousIdeal.irrelevant ℬ_k)),
          (∀ a : A' β, Ψ_β.toRingHom (MvPolynomial.C a) = MvPolynomial.C a) ∧
          (∀ ν : Fin (M₁ + 1), Ψ_β.toRingHom (MvPolynomial.X ν) =
            ∑ i : Fin (r₀ + 1),
              (MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) :
                MvPolynomial (Fin (r₀ + 1)) (A' β)) *
                (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A' β))) ∧
          Function.Surjective Ψ_β.toRingHom ∧
          (∀ c : k, Φ_β.toRingHom (MvPolynomial.C c) =
            MvPolynomial.C ((σ_hom (U' β) (hAffU' β)).hom c)) ∧
          (∀ ν : Fin (M₁ + 1), Φ_β.toRingHom (MvPolynomial.X ν) =
            ∑ i : Fin (r₀ + 1),
              (MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) :
                MvPolynomial (Fin (r₀ + 1)) (A' β)) *
                (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A' β))) := by
      intro β ℬ_β 𝒜'_β
      let ψ_raw : MvPolynomial (Fin (M₁ + 1)) (A' β) →+* MvPolynomial (Fin (r₀ + 1)) (A' β) :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun ν => ∑ i : Fin (r₀ + 1),
            MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) * MvPolynomial.X i)
      have hlin_hom : ∀ ν : Fin (M₁ + 1),
          (∑ i : Fin (r₀ + 1),
            MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) *
              (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A' β))).IsHomogeneous 1 := by
        intro ν
        refine MvPolynomial.IsHomogeneous.sum _ _ _ fun i _ => ?_
        simpa using (MvPolynomial.isHomogeneous_C _ _).mul (MvPolynomial.isHomogeneous_X _ i)
      let Ψ_β : ℬ_β →+*ᵍ 𝒜'_β :=
        { toRingHom := ψ_raw
          map_mem := fun {d} {P} hP => by
            rw [MvPolynomial.mem_homogeneousSubmodule] at hP ⊢
            rw [show ψ_raw P = MvPolynomial.eval₂ MvPolynomial.C _ P from
              congrFun (MvPolynomial.coe_eval₂Hom _ _) P]
            simpa only [one_mul] using hP.eval₂ MvPolynomial.C
              (fun ν => ∑ i : Fin (r₀ + 1),
                MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) * MvPolynomial.X i)
              (fun a => MvPolynomial.isHomogeneous_C _ a) hlin_hom }
      let φ_raw : MvPolynomial (Fin (M₁ + 1)) k →+* MvPolynomial (Fin (r₀ + 1)) (A' β) :=
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp (σ_hom (U' β) (hAffU' β)).hom)
          (fun ν => ∑ i : Fin (r₀ + 1),
            MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) * MvPolynomial.X i)
      let Φ_β : ℬ_k →+*ᵍ 𝒜'_β :=
        { toRingHom := φ_raw
          map_mem := fun {d} {P} hP => by
            rw [MvPolynomial.mem_homogeneousSubmodule] at hP ⊢
            simpa [φ_raw, one_mul] using hP.eval₂ (MvPolynomial.C.comp (σ_hom (U' β) (hAffU' β)).hom)
              (fun ν => ∑ i : Fin (r₀ + 1),
                MvPolynomial.C (Q β (e_idx.symm ν).1 i (e_idx.symm ν).2) * MvPolynomial.X i)
              (fun c => MvPolynomial.isHomogeneous_C _ ((σ_hom (U' β) (hAffU' β)).hom c))
              hlin_hom }
      have h_diag_X : ∀ j : Fin (r₀ + 1),
          (∑ i : Fin (r₀ + 1),
            MvPolynomial.C (Q β (e_idx.symm (e_idx (β, j))).1 i (e_idx.symm (e_idx (β, j))).2) *
              (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A' β))) = MvPolynomial.X j := by
        intro j
        rw [e_idx.symm_apply_apply]
        dsimp only
        rw [hQ_id β, Finset.sum_eq_single j]
        · simp
        · intro i _ hij; simp [hij]
        · intro hj; exact False.elim (hj (Finset.mem_univ j))
      have hΨ_β : HomogeneousIdeal.irrelevant 𝒜'_β ≤
          HomogeneousIdeal.map Ψ_β (HomogeneousIdeal.irrelevant ℬ_β) := by
        change (HomogeneousIdeal.irrelevant 𝒜'_β).toIdeal ≤
          (HomogeneousIdeal.map Ψ_β (HomogeneousIdeal.irrelevant ℬ_β)).toIdeal
        rw [HomogeneousIdeal.toIdeal_map]
        refine le_trans (hIrrelPkg (A' β) r₀).1 (Ideal.span_le.mpr ?_)
        rintro _ ⟨j, rfl⟩
        have hXj : Ψ_β.toRingHom (MvPolynomial.X (e_idx (β, j))) = MvPolynomial.X j :=
          (MvPolynomial.eval₂Hom_X' _ _ _).trans (h_diag_X j)
        rw [← hXj]
        exact Ideal.mem_map_of_mem Ψ_β.toRingHom ((hIrrelPkg (A' β) M₁).2 (e_idx (β, j)))
      have hΦ_β : HomogeneousIdeal.irrelevant 𝒜'_β ≤
          HomogeneousIdeal.map Φ_β (HomogeneousIdeal.irrelevant ℬ_k) := by
        change (HomogeneousIdeal.irrelevant 𝒜'_β).toIdeal ≤
          (HomogeneousIdeal.map Φ_β (HomogeneousIdeal.irrelevant ℬ_k)).toIdeal
        rw [HomogeneousIdeal.toIdeal_map]
        refine le_trans (hIrrelPkg (A' β) r₀).1 (Ideal.span_le.mpr ?_)
        rintro _ ⟨j, rfl⟩
        have hXj : Φ_β.toRingHom (MvPolynomial.X (e_idx (β, j))) = MvPolynomial.X j :=
          (MvPolynomial.eval₂Hom_X' _ _ _).trans (h_diag_X j)
        rw [← hXj]
        exact Ideal.mem_map_of_mem Φ_β.toRingHom ((hIrrelPkg k M₁).2 (e_idx (β, j)))
      have hΨ_surj : Function.Surjective Ψ_β.toRingHom := by
        intro P
        refine MvPolynomial.induction_on (motive := fun P => ∃ p₀, Ψ_β.toRingHom p₀ = P) P
          (fun a => ⟨MvPolynomial.C a, MvPolynomial.eval₂Hom_C _ _ a⟩)
          (fun p q ⟨p₀, hp₀⟩ ⟨q₀, hq₀⟩ => ⟨p₀ + q₀, by rw [map_add, hp₀, hq₀]⟩)
          (fun p j ⟨p₀, hp₀⟩ => ⟨p₀ * MvPolynomial.X (e_idx (β, j)), by
            rw [map_mul, hp₀]
            congr 1
            exact (MvPolynomial.eval₂Hom_X' _ _ _).trans (h_diag_X j)⟩)
      exact ⟨Ψ_β, hΨ_β, Φ_β, hΦ_β,
        fun a => MvPolynomial.eval₂Hom_C _ _ a,
        fun ν => MvPolynomial.eval₂Hom_X' _ _ ν,
        hΨ_surj,
        fun c => MvPolynomial.eval₂Hom_C _ _ c,
        fun ν => MvPolynomial.eval₂Hom_X' _ _ ν⟩
    choose Ψ_blk hΨ_blk Φ_blk hΦ_blk hΨ_C hΨ_X hΨ_surj hΦ_C hΦ_X using hBlockHoms

    let π_loc (β : Fin (s'₀ + 1)) : (V' β).toScheme ⟶ AlgebraicGeometry.Proj ℬ_k :=
      j'_loc β ≫ AlgebraicGeometry.Proj.map (Φ_blk β) (hΦ_blk β)

    have hπ_ov : ∀ β γ : Fin (s'₀ + 1),
        C₃.left.homOfLE (hV_L β γ) ≫ π_loc β =
        C₃.left.homOfLE (hV_R β γ) ≫ π_loc γ := by
      intro β γ
      obtain ⟨S_v, hS_v, hSv_C, hSv_X, hSv_id⟩ :=
        hProjMapUnitScale (A'_ov β γ) r₀ (v β γ)
      have h_hom_eq : (Q'_ov β γ).comp (Φ_blk γ) =
          S_v.comp ((P'_ov β γ).comp (Φ_blk β)) := by
        have h_ring : ((Q'_ov β γ).comp (Φ_blk γ)).toRingHom =
            (S_v.comp ((P'_ov β γ).comp (Φ_blk β))).toRingHom := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            change (Q'_ov β γ).toRingHom ((Φ_blk γ).toRingHom (MvPolynomial.C c)) =
              S_v.toRingHom ((P'_ov β γ).toRingHom ((Φ_blk β).toRingHom (MvPolynomial.C c)))
            rw [hΦ_C γ c, hQ'C_ov β γ, hΦ_C β c, hP'C_ov β γ, hSv_C]
            congr 1
            have hR_eq := ConcreteCategory.congr_hom
              (hσ_res (hAffU'_ov β γ) (hAffU' γ) inf_le_right) c
            have hL_eq := ConcreteCategory.congr_hom
              (hσ_res (hAffU'_ov β γ) (hAffU' β) inf_le_left) c
            exact hR_eq.trans hL_eq.symm
          · intro ν
            change (Q'_ov β γ).toRingHom ((Φ_blk γ).toRingHom (MvPolynomial.X ν)) =
              S_v.toRingHom ((P'_ov β γ).toRingHom ((Φ_blk β).toRingHom (MvPolynomial.X ν)))
            let α := (e_idx.symm ν).1
            let j := (e_idx.symm ν).2
            rw [hΦ_X γ ν, hΦ_X β ν]
            change (Q'_ov β γ).toRingHom
                (∑ m : Fin (r₀ + 1), MvPolynomial.C (Q γ α m j) * MvPolynomial.X m) =
              S_v.toRingHom ((P'_ov β γ).toRingHom
                (∑ i : Fin (r₀ + 1), MvPolynomial.C (Q β α i j) * MvPolynomial.X i))
            simp only [map_sum, map_mul, hQ'C_ov β γ, hQ'X_ov β γ, hP'C_ov β γ, hP'X_ov β γ,
              hSv_C, hSv_X]
            have h_lhs :
                (∑ m : Fin (r₀ + 1),
                  MvPolynomial.C (resR β γ (Q γ α m j)) *
                    (∑ i : Fin (r₀ + 1),
                      MvPolynomial.C ((T'_mat β γ).val i m) *
                        (MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) (A'_ov β γ)))) =
                ∑ i : Fin (r₀ + 1),
                  MvPolynomial.C
                    (((T'_mat β γ).val * Matrix.map (Q γ α) (resR β γ)) i j) *
                    MvPolynomial.X i := by
              simp_rw [Finset.mul_sum]
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun i _ => ?_
              simp only [Matrix.mul_apply, Matrix.map_apply, map_sum, map_mul, Finset.sum_mul]
              refine Finset.sum_congr rfl fun m _ => by ring
            rw [h_lhs]
            have hT'_val : (T'_mat β γ).val =
                Matrix.map (T (μ β) (μ γ)).val
                  (B₃.left.presheaf.map
                    (CategoryTheory.homOfLE (inf_le_inf (hSub β) (hSub γ))).op).hom :=
              RingHom.mapMatrix_apply _ _
            rw [hT'_val, hQ_cocycle β γ α]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp only [Matrix.smul_apply, Matrix.map_apply, smul_eq_mul, map_mul]
            ring
        ext p m
        exact congrArg (fun q => q.coeff m) (RingHom.congr_fun h_ring p)
      have h_irrel_PΦ := hIrrelComp (hΦ_blk β) (hP'_ov β γ)
      have h_irrel_SPΦ := hIrrelComp h_irrel_PΦ hS_v
      have h_irrel_QΦ := hIrrelComp (hΦ_blk γ) (hQ'_ov β γ)
      calc C₃.left.homOfLE (hV_L β γ) ≫ π_loc β
          = (C₃.left.homOfLE (hV_L β γ) ≫ j'_loc β) ≫
              AlgebraicGeometry.Proj.map (Φ_blk β) (hΦ_blk β) :=
              (Category.assoc _ _ _).symm
        _ = j'_ov β γ ≫ (AlgebraicGeometry.Proj.map (P'_ov β γ) (hP'_ov β γ) ≫
              AlgebraicGeometry.Proj.map (Φ_blk β) (hΦ_blk β)) := by
              rw [← hj'_P β γ, Category.assoc]
        _ = j'_ov β γ ≫ AlgebraicGeometry.Proj.map ((P'_ov β γ).comp (Φ_blk β)) h_irrel_PΦ := by
              rw [hProjMapComp k (A' β) (A'_ov β γ) M₁ r₀ r₀
                (Φ_blk β) (hΦ_blk β) (P'_ov β γ) (hP'_ov β γ) h_irrel_PΦ]
        _ = j'_ov β γ ≫ (AlgebraicGeometry.Proj.map S_v hS_v ≫
              AlgebraicGeometry.Proj.map ((P'_ov β γ).comp (Φ_blk β)) h_irrel_PΦ) := by
              rw [hSv_id, Category.id_comp]
        _ = j'_ov β γ ≫
              AlgebraicGeometry.Proj.map (S_v.comp ((P'_ov β γ).comp (Φ_blk β))) h_irrel_SPΦ := by
              rw [hProjMapComp k (A'_ov β γ) (A'_ov β γ) M₁ r₀ r₀
                ((P'_ov β γ).comp (Φ_blk β)) h_irrel_PΦ S_v hS_v h_irrel_SPΦ]
        _ = j'_ov β γ ≫ AlgebraicGeometry.Proj.map ((Q'_ov β γ).comp (Φ_blk γ)) h_irrel_QΦ := by
              rw [hProjMapCongr h_hom_eq.symm h_irrel_SPΦ h_irrel_QΦ]
        _ = (j'_ov β γ ≫ AlgebraicGeometry.Proj.map (Q'_ov β γ) (hQ'_ov β γ)) ≫
              AlgebraicGeometry.Proj.map (Φ_blk γ) (hΦ_blk γ) := by
              rw [← hProjMapComp k (A' γ) (A'_ov β γ) M₁ r₀ r₀
                (Φ_blk γ) (hΦ_blk γ) (Q'_ov β γ) (hQ'_ov β γ) h_irrel_QΦ, Category.assoc]
        _ = C₃.left.homOfLE (hV_R β γ) ≫ π_loc γ := by
              rw [hj'_Q β γ, Category.assoc]

    have hCovV' : iSup V' = ⊤ := by
      ext x
      simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top,
        Set.mem_iUnion, Set.mem_univ, iff_true]
      have hxB : g₃.left.base x ∈ ⋃ β : Fin (s'₀ + 1), (U' β : Set B₃.left) := by
        rw [hCovU']; trivial
      obtain ⟨β, hβ⟩ := Set.mem_iUnion.mp hxB
      exact ⟨β, hβ⟩
    let 𝒰_C : C₃.left.OpenCover :=
      AlgebraicGeometry.Scheme.openCoverOfIsOpenCover C₃.left V' (TopologicalSpace.IsOpenCover.mk hCovV')
    have h_glue_π : ∀ (β γ : 𝒰_C.I₀),
        CategoryTheory.Limits.pullback.fst (𝒰_C.f β) (𝒰_C.f γ) ≫ π_loc β =
          CategoryTheory.Limits.pullback.snd (𝒰_C.f β) (𝒰_C.f γ) ≫ π_loc γ := by
      intro (β : Fin (s'₀ + 1)) (γ : Fin (s'₀ + 1))
      let π₁ := CategoryTheory.Limits.pullback.fst ((V' β).ι) ((V' γ).ι)
      let π₂ := CategoryTheory.Limits.pullback.snd ((V' β).ι) ((V' γ).ι)
      have h_rng : Set.range (π₁ ≫ (V' β).ι).base ⊆ Set.range (V'_ov β γ).ι.base := by
        rintro _ ⟨z, rfl⟩
        have hz_eq : ((π₁ ≫ (V' β).ι).base z) = ((π₂ ≫ (V' γ).ι).base z) :=
          congrArg (fun m : CategoryTheory.Limits.pullback (V' β).ι (V' γ).ι ⟶ C₃.left => m.base z)
            CategoryTheory.Limits.pullback.condition
        have hz_β : (π₁ ≫ (V' β).ι).base z ∈ V' β := (π₁.base z).2
        have hz_γ : (π₁ ≫ (V' β).ι).base z ∈ V' γ := by
          rw [hz_eq]; exact (π₂.base z).2
        have hz_ov : (π₁ ≫ (V' β).ι).base z ∈ V'_ov β γ := ⟨hz_β, hz_γ⟩
        exact ⟨⟨_, hz_ov⟩, rfl⟩
      let q_ov := AlgebraicGeometry.IsOpenImmersion.lift (V'_ov β γ).ι (π₁ ≫ (V' β).ι) h_rng
      have hq_fac : q_ov ≫ (V'_ov β γ).ι = π₁ ≫ (V' β).ι :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (V'_ov β γ).ι (π₁ ≫ (V' β).ι) h_rng
      have hq_π₁ : q_ov ≫ C₃.left.homOfLE (hV_L β γ) = π₁ := by
        rw [← cancel_mono (V' β).ι, Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
        exact hq_fac
      have hq_π₂ : q_ov ≫ C₃.left.homOfLE (hV_R β γ) = π₂ := by
        rw [← cancel_mono (V' γ).ι, Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
        exact hq_fac.trans CategoryTheory.Limits.pullback.condition
      change π₁ ≫ π_loc β = π₂ ≫ π_loc γ
      rw [← hq_π₁, ← hq_π₂, Category.assoc, Category.assoc, hπ_ov β γ]
    let π_proj₀ : C₃.left ⟶ AlgebraicGeometry.Proj ℬ_k :=
      AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰_C π_loc h_glue_π
    have hπ_ι : ∀ β : Fin (s'₀ + 1), (V' β).ι ≫ π_proj₀ = π_loc β :=
      AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰_C π_loc h_glue_π

    have hπ_hom₀ : π_proj₀ ≫ p_rel k M₁ = C₃.hom := by
      refine AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰_C _ _ fun (β : Fin (s'₀ + 1)) => ?_
      have h_spec_σ : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (σ_hom (U' β) (hAffU' β)).hom) =
          AlgebraicGeometry.Spec.map (σ_hom (U' β) (hAffU' β)) :=
        congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
      calc (V' β).ι ≫ (π_proj₀ ≫ p_rel k M₁)
          = ((V' β).ι ≫ π_proj₀) ≫ p_rel k M₁ := by rw [← Category.assoc]
        _ = j'_loc β ≫ (AlgebraicGeometry.Proj.map (Φ_blk β) (hΦ_blk β) ≫ p_rel k M₁) := by
              rw [hπ_ι β]; dsimp only [π_loc]; rw [Category.assoc]
        _ = (j'_loc β ≫ p_rel (A' β) r₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_hom (U' β) (hAffU' β)).hom) := by
              rw [hProjMapRel (σ_hom (U' β) (hAffU' β)).hom (Φ_blk β) (hΦ_blk β) (hΦ_C β),
                Category.assoc]
        _ = g₃.left.resLE (U' β) (V' β) (le_refl _) ≫
              ((U' β).toSpecΓ ≫ AlgebraicGeometry.Spec.map (σ_hom (U' β) (hAffU' β))) := by
              rw [hj'_snd β, h_spec_σ, Category.assoc]
        _ = (g₃.left.resLE (U' β) (V' β) (le_refl _) ≫ (U' β).ι) ≫ B₃.hom := by
              rw [hσ_spec (U' β) (hAffU' β), Category.assoc]
        _ = (V' β).ι ≫ (g₃.left ≫ B₃.hom) := by
              rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, Category.assoc]
        _ = (V' β).ι ≫ C₃.hom := by rw [CategoryTheory.Over.w g₃]

    let π_proj : C₃.left ⟶ P₁.left := π_proj₀
    have hπ_hom : π_proj ≫ P₁.hom = C₃.hom := hπ_hom₀

    let Q_prod := CategoryTheory.Limits.pullback P₁.hom B₃.hom
    let pr₁ := CategoryTheory.Limits.pullback.fst P₁.hom B₃.hom
    let pr₂ := CategoryTheory.Limits.pullback.snd P₁.hom B₃.hom
    have hj_comm : π_proj ≫ P₁.hom = g₃.left ≫ B₃.hom :=
      hπ_hom.trans (CategoryTheory.Over.w g₃).symm
    let j_glob : C₃.left ⟶ Q_prod :=
      CategoryTheory.Limits.pullback.lift π_proj g₃.left hj_comm
    have hj_glob_hom : j_glob ≫ pr₁ ≫ P₁.hom = C₃.hom := by
      rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      exact hπ_hom

    let W_pb : Fin (s'₀ + 1) → Q_prod.Opens :=
      fun β => (TopologicalSpace.Opens.map pr₂.base).obj (U' β)
    have hCovWpb : iSup W_pb = ⊤ := by
      calc iSup W_pb = (TopologicalSpace.Opens.map pr₂.base).obj (iSup U') :=
            (TopologicalSpace.Opens.map_iSup pr₂.base U').symm
        _ = (TopologicalSpace.Opens.map pr₂.base).obj ⊤ := by
            congr 1
            ext y
            simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top, hCovU']
        _ = ⊤ := rfl

    have hCl_glob : AlgebraicGeometry.IsClosedImmersion j_glob := by
      refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) W_pb hCovWpb).mpr fun β => ?_
      let V_dom : C₃.left.Opens := (TopologicalSpace.Opens.map j_glob.base).obj (W_pb β)
      have hV_dom_eq : V_dom = V' β := by
        have hj_snd : j_glob ≫ pr₂ = g₃.left :=
          CategoryTheory.Limits.pullback.lift_snd π_proj g₃.left hj_comm
        ext x
        change x ∈ j_glob.base ⁻¹' (pr₂.base ⁻¹' (U' β : Set B₃.left)) ↔
          x ∈ g₃.left.base ⁻¹' (U' β : Set B₃.left)
        rw [← hj_snd]; rfl
      let e_dom : V_dom.toScheme ≅ (V' β).toScheme := C₃.left.isoOfEq hV_dom_eq
      have hPB_Wpb : CategoryTheory.IsPullback
          ((W_pb β).ι ≫ pr₁) (pr₂ ∣_ U' β) P₁.hom ((U' β).ι ≫ B₃.hom) :=
        ((AlgebraicGeometry.isPullback_morphismRestrict pr₂ (U' β)).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback P₁.hom B₃.hom).flip).flip
      obtain ⟨⟨S_base, hS_base, hSb_C, hSb_X⟩, hPB_base_gen⟩ :=
        hProjPB k (A' β) M₁ (σ_hom (U' β) (hAffU' β)).hom
      have hPB_base_spec : CategoryTheory.IsPullback
          (AlgebraicGeometry.Proj.map S_base hS_base)
          (p_rel (A' β) M₁) P₁.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_hom (U' β) (hAffU' β)).hom)) :=
        hPB_base_gen S_base hS_base hSb_C hSb_X
      have hPB_base_U' : CategoryTheory.IsPullback
          (AlgebraicGeometry.Proj.map S_base hS_base)
          (p_rel (A' β) M₁ ≫ (hAffU' β).isoSpec.inv)
          P₁.hom ((U' β).ι ≫ B₃.hom) := by
        refine hPB_base_spec.of_iso (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (hAffU' β).isoSpec.symm (CategoryTheory.Iso.refl _) rfl ?_ rfl ?_
        · simp
        · simp only [CategoryTheory.Iso.refl_hom, Category.comp_id, CategoryTheory.Iso.symm_hom]
          have h_spec_σ : AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (σ_hom (U' β) (hAffU' β)).hom) =
              AlgebraicGeometry.Spec.map (σ_hom (U' β) (hAffU' β)) :=
            congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)
          rw [h_spec_σ, ← cancel_epi (hAffU' β).isoSpec.hom, Iso.hom_inv_id_assoc,
            (hAffU' β).isoSpec_hom]
          exact hσ_spec (U' β) (hAffU' β)
      let θ_pb := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_base_U' hPB_Wpb
      have hΦ_factor : (Ψ_blk β).comp S_base = Φ_blk β := by
        have h_ring : ((Ψ_blk β).comp S_base).toRingHom = (Φ_blk β).toRingHom := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            change (Ψ_blk β).toRingHom (S_base.toRingHom (MvPolynomial.C c)) =
              (Φ_blk β).toRingHom (MvPolynomial.C c)
            rw [hSb_C c, hΨ_C β, hΦ_C β c]
          · intro ν
            change (Ψ_blk β).toRingHom (S_base.toRingHom (MvPolynomial.X ν)) =
              (Φ_blk β).toRingHom (MvPolynomial.X ν)
            rw [hSb_X ν, hΨ_X β ν, hΦ_X β ν]
        ext p m
        exact congrArg (fun q => q.coeff m) (RingHom.congr_fun h_ring p)
      have h_irrel_ΨS := hIrrelComp hS_base (hΨ_blk β)
      have h_res_glob : (j_glob ∣_ W_pb β) =
          e_dom.hom ≫ j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ θ_pb.hom := by
        apply hPB_Wpb.hom_ext
        · have h_lhs_fst : (j_glob ∣_ W_pb β) ≫ ((W_pb β).ι ≫ pr₁) =
              e_dom.hom ≫ ((V' β).ι ≫ π_proj) := by
            rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst,
              ← AlgebraicGeometry.Scheme.isoOfEq_hom_ι C₃.left hV_dom_eq, Category.assoc]
          have h_mid_fst : (V' β).ι ≫ π_proj₀ =
              j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫
                AlgebraicGeometry.Proj.map S_base hS_base := by
            rw [hπ_ι β]
            dsimp only [π_loc]
            rw [hProjMapCongr hΦ_factor.symm (hΦ_blk β) h_irrel_ΨS,
              ← hProjMapComp k (A' β) (A' β) M₁ M₁ r₀
                S_base hS_base (Ψ_blk β) (hΨ_blk β) h_irrel_ΨS]
          have h_mid_P₁ : e_dom.hom ≫ ((V' β).ι ≫ π_proj) =
              e_dom.hom ≫ (j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫
                (AlgebraicGeometry.Proj.map S_base hS_base : _ ⟶ P₁.left)) :=
            congrArg (e_dom.hom ≫ ·) h_mid_fst
          have h_rhs_fst : (e_dom.hom ≫ j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫
                θ_pb.hom) ≫ ((W_pb β).ι ≫ pr₁) =
              e_dom.hom ≫ (j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫
                (AlgebraicGeometry.Proj.map S_base hS_base : _ ⟶ P₁.left)) := by
            simp only [Category.assoc]
            exact congrArg
              (fun m => e_dom.hom ≫ j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ m)
              (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_base_U' hPB_Wpb)
          exact h_lhs_fst.trans (h_mid_P₁.trans h_rhs_fst.symm)
        · have h_lhs_snd : (j_glob ∣_ W_pb β) ≫ (pr₂ ∣_ U' β) =
              e_dom.hom ≫ g₃.left.resLE (U' β) (V' β) (le_refl _) := by
            rw [← cancel_mono (U' β).ι, Category.assoc, Category.assoc,
              AlgebraicGeometry.morphismRestrict_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
              ← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
              AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
          have hΨ_rel : AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ p_rel (A' β) M₁ =
              p_rel (A' β) r₀ := by
            have h1 := hProjMapRel (RingHom.id (A' β)) (Ψ_blk β) (hΨ_blk β) (hΨ_C β)
            have hid : CommRingCat.ofHom (RingHom.id (A' β)) = 𝟙 (CommRingCat.of (A' β)) :=
              CommRingCat.hom_ext rfl
            rw [hid, AlgebraicGeometry.Spec.map_id, Category.comp_id] at h1
            exact h1
          rw [h_lhs_snd]
          simp only [Category.assoc]
          rw [CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_base_U' hPB_Wpb,
            ← Category.assoc (AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β)), hΨ_rel,
            ← Category.assoc (j'_loc β), hj'_snd β, Category.assoc,
            ← (hAffU' β).isoSpec_hom, Iso.hom_inv_id, Category.comp_id]
      rw [h_res_glob]
      have : AlgebraicGeometry.IsClosedImmersion (j'_loc β) := hCl_j' β
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β)) :=
        hProjSurjClosed (A' β) M₁ r₀ (Ψ_blk β) (hΨ_blk β) (hΨ_surj β)
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ θ_pb.hom) :=
        AlgebraicGeometry.IsClosedImmersion.comp
          (AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β)) θ_pb.hom
      have : AlgebraicGeometry.IsClosedImmersion
          (j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ θ_pb.hom) :=
        AlgebraicGeometry.IsClosedImmersion.comp (j'_loc β)
          (AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ θ_pb.hom)
      exact AlgebraicGeometry.IsClosedImmersion.comp e_dom.hom
        (j'_loc β ≫ AlgebraicGeometry.Proj.map (Ψ_blk β) (hΨ_blk β) ≫ θ_pb.hom)

    exact ⟨M₁, j_glob, hj_glob_hom, hCl_glob⟩

  have hPart5 : ∀ (k : Type u) [Field k] (M₁ N₃ : ℕ)
      (B₃ C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ι_B : B₃ ⟶ weilProjectiveSpaceOver k N₃)
      (_hCl_B : AlgebraicGeometry.IsClosedImmersion ι_B.left)
      (j_glob : C₃.left ⟶ CategoryTheory.Limits.pullback (weilProjectiveSpaceOver k M₁).hom B₃.hom)
      (_hj_hom : j_glob ≫ CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver k M₁).hom B₃.hom ≫
        (weilProjectiveSpaceOver k M₁).hom = C₃.hom)
      (_hCl_jglob : AlgebraicGeometry.IsClosedImmersion j_glob),
      ∃ (N_tot : ℕ) (ι_C : C₃ ⟶ weilProjectiveSpaceOver k N_tot),
        AlgebraicGeometry.IsClosedImmersion ι_C.left := by
    intro k _ M₁ N₃ B₃ C₃ ι_B hCl_B j_glob hj_hom hCl_jglob
    let P₁ := weilProjectiveSpaceOver k M₁
    let P₂ := weilProjectiveSpaceOver k N₃
    have hm₂_comm : CategoryTheory.Limits.pullback.fst P₁.hom B₃.hom ≫ P₁.hom =
        (CategoryTheory.Limits.pullback.snd P₁.hom B₃.hom ≫ ι_B.left) ≫ P₂.hom := by
      rw [Category.assoc, CategoryTheory.Over.w ι_B]
      exact CategoryTheory.Limits.pullback.condition
    let m₂ : CategoryTheory.Limits.pullback P₁.hom B₃.hom ⟶
        CategoryTheory.Limits.pullback P₁.hom P₂.hom :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst P₁.hom B₃.hom)
        (CategoryTheory.Limits.pullback.snd P₁.hom B₃.hom ≫ ι_B.left) hm₂_comm
    have hm₂_fst : m₂ ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom =
        CategoryTheory.Limits.pullback.fst P₁.hom B₃.hom :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm₂_snd : m₂ ≫ CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom =
        CategoryTheory.Limits.pullback.snd P₁.hom B₃.hom ≫ ι_B.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hSq₂ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd P₁.hom B₃.hom) m₂
        ι_B.left (CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hm₂_snd.symm
        (CategoryTheory.IsPullback.of_hasPullback P₁.hom P₂.hom).flip
      rw [hm₂_fst, CategoryTheory.Over.w ι_B]
      exact (CategoryTheory.IsPullback.of_hasPullback P₁.hom B₃.hom).flip
    have hCl_m₂ : AlgebraicGeometry.IsClosedImmersion m₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsClosedImmersion) hSq₂ hCl_B
    let j_tot : C₃.left ⟶ CategoryTheory.Limits.pullback P₁.hom P₂.hom := j_glob ≫ m₂
    have hCl_jtot : AlgebraicGeometry.IsClosedImmersion j_tot :=
      @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ j_glob m₂ hCl_jglob hCl_m₂
    have hj_tot_hom : j_tot ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom ≫ P₁.hom =
        C₃.hom := by
      calc (j_glob ≫ m₂) ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom ≫ P₁.hom
          = j_glob ≫ (m₂ ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom) ≫ P₁.hom := by
              simp only [Category.assoc]
        _ = j_glob ≫ CategoryTheory.Limits.pullback.fst P₁.hom B₃.hom ≫ P₁.hom := by
              rw [hm₂_fst]
        _ = C₃.hom := hj_hom

    let _ : ∀ (K : ℕ), GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) :=
      fun _ => MvPolynomial.gradedAlgebra
    have hX : ∀ (K : ℕ) (a : Fin (K + 1)),
        MvPolynomial.X a ∈ MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 1 :=
      fun _ a => MvPolynomial.isHomogeneous_X k a
    have hHomLoc : ∀ (K : ℕ),
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin (K + 1) → MvPolynomial (Fin (K + 1)) k)) ∧
        ∀ (i₀ : Fin (K + 1)),
          HomogeneousLocalization.Away.isLocalizationElem
            (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)
            (hX K i₀) (hX K i₀) = 1 ∧
          Subring.closure
            (Set.range ((HomogeneousLocalization.fromZeroRingHom
                (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)
                (Submonoid.powers (MvPolynomial.X i₀))).comp
                (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 0))) ∪
              Set.range (fun a : Fin (K + 1) =>
                HomogeneousLocalization.Away.isLocalizationElem
                  (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)
                  (hX K i₀) (hX K a))) = ⊤ := by
      intro K
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k
      have h_sum_mk : ∀ {R : Type u} [CommRing R] {S : Submonoid R} {ι : Type}
          (s : Finset ι) (f : ι → R) (y : S),
          (∑ x ∈ s, Localization.mk (f x) y) = Localization.mk (∑ x ∈ s, f x) y := by
        intro R _ S ι s f y
        classical
        induction s using Finset.induction_on with
        | empty => simp [Localization.mk_zero]
        | @insert a s ha ih =>
          rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
      have h_prod_mk : ∀ {R : Type u} [CommRing R] {S : Submonoid R} {ι : Type}
          (s : Finset ι) (f : ι → R) (g : ι → S),
          (∏ x ∈ s, Localization.mk (f x) (g x)) =
            Localization.mk (∏ x ∈ s, f x)
              ⟨∏ x ∈ s, (g x : R), Submonoid.prod_mem S fun x _ => (g x).2⟩ := by
        intro R _ S ι s f g
        classical
        induction s using Finset.induction_on with
        | empty => simp
        | @insert a s ha ih =>
          simp only [Finset.prod_insert ha, ih, Localization.mk_mul]
          rfl
      have h_hom_deg : ∀ {d : ℕ} {P : MvPolynomial (Fin (K + 1)) k},
          P.IsHomogeneous d → ∀ {m : Fin (K + 1) →₀ ℕ}, P.coeff m ≠ 0 → (∑ a : Fin (K + 1), m a) = d := by
        intro d P hP m hm
        have hw := hP hm
        rw [Finsupp.weight_apply, Finsupp.sum_fintype m _ (fun _ => by simp)] at hw
        simpa [smul_eq_mul, mul_one] using hw
      refine ⟨hIrrelGen k K, ?_⟩
      intro i₀
      have h_self : HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) (hX K i₀) (hX K i₀) = 1 := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
        change (HomogeneousLocalization.Away.mk 𝒜 (hX K i₀) 1 (MvPolynomial.X i₀ ^ 1) _).val = 1
        rw [HomogeneousLocalization.Away.val_mk]
        exact Localization.mk_self ⟨MvPolynomial.X i₀ ^ 1, Submonoid.pow_mem _ (Submonoid.mem_powers _) 1⟩
      refine ⟨h_self, ?_⟩
      rw [eq_top_iff]
      intro w _
      let S_pow := Submonoid.powers (MvPolynomial.X i₀ : MvPolynomial (Fin (K + 1)) k)
      let ι_k : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_pow).comp (algebraMap k ↥(𝒜 0))
      let r : Fin (K + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        fun a => HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) (hX K i₀) (hX K a)
      let S_gen : Set (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)) :=
        Set.range ι_k ∪ Set.range r
      obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX K i₀) w
      have hP' : P ∈ 𝒜 d := by simpa [smul_eq_mul, mul_one] using hP
      have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hP'
      let w' : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        ∑ m ∈ P.support, ι_k (P.coeff m) * ∏ a : Fin (K + 1), (r a) ^ (m a)
      have hw'_mem : w' ∈ Subring.closure S_gen := by
        refine Subring.sum_mem _ fun m _ => Subring.mul_mem _ ?_ ?_
        · exact Subring.subset_closure (s := S_gen) (Or.inl ⟨P.coeff m, rfl⟩)
        · refine Subring.prod_mem _ fun a _ => ?_
          exact Subring.pow_mem _ (Subring.subset_closure (s := S_gen) (Or.inr ⟨a, rfl⟩)) (m a)
      suffices h_eq : w' = HomogeneousLocalization.Away.mk 𝒜 (hX K i₀) d P hP by
        rwa [← h_eq]
      rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk]
      have h_val_hom : ∀ x : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀),
          x.val = algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)) (Localization S_pow) x :=
        fun x => (HomogeneousLocalization.algebraMap_apply x).symm
      rw [h_val_hom]
      simp only [w', map_sum, map_mul, map_prod, map_pow]
      have h_term : ∀ m ∈ P.support,
          algebraMap _ (Localization S_pow) (ι_k (P.coeff m)) *
            (∏ a : Fin (K + 1), (algebraMap _ (Localization S_pow) (r a)) ^ (m a)) =
          Localization.mk ((MvPolynomial.monomial m) (P.coeff m))
            ⟨MvPolynomial.X i₀ ^ d, Submonoid.pow_mem _ (Submonoid.mem_powers _) d⟩ := by
        intro m hm
        have hm_ne : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have hm_deg : (∑ a : Fin (K + 1), m a) = d := h_hom_deg hP_hom hm_ne
        have h_ik : algebraMap _ (Localization S_pow) (ι_k (P.coeff m)) =
            Localization.mk (MvPolynomial.C (P.coeff m)) 1 := by
          rw [HomogeneousLocalization.algebraMap_apply]; rfl
        have h_ra : ∀ a : Fin (K + 1),
            (algebraMap _ (Localization S_pow) (r a)) ^ (m a) =
            Localization.mk (MvPolynomial.X a ^ m a)
              ⟨MvPolynomial.X i₀ ^ m a, Submonoid.pow_mem _ (Submonoid.mem_powers _) (m a)⟩ := by
          intro a
          rw [HomogeneousLocalization.algebraMap_apply]
          change ((HomogeneousLocalization.Away.mk 𝒜 (hX K i₀) 1
            (MvPolynomial.X a ^ 1) _).val) ^ (m a) = _
          rw [HomogeneousLocalization.Away.val_mk, pow_one, Localization.mk_pow]
          congr 1; ext; simp
        simp_rw [h_ik, h_ra]
        rw [h_prod_mk, Localization.mk_mul]
        have h_num : MvPolynomial.C (P.coeff m) * (∏ a : Fin (K + 1), MvPolynomial.X a ^ m a) =
            (MvPolynomial.monomial m) (P.coeff m) := by
          rw [MvPolynomial.monomial_eq]
          congr 1
          exact (Finsupp.prod_of_support_subset m (Finset.subset_univ _) _ (fun _ _ => pow_zero _)).symm
        have h_den : (1 : S_pow) * ⟨∏ a : Fin (K + 1), MvPolynomial.X i₀ ^ m a,
            Submonoid.prod_mem S_pow fun a _ => Submonoid.pow_mem _ (Submonoid.mem_powers _) (m a)⟩ =
            ⟨MvPolynomial.X i₀ ^ d, Submonoid.pow_mem _ (Submonoid.mem_powers _) d⟩ := by
          ext; simp [Finset.prod_pow_eq_pow_sum, hm_deg]
        rw [h_num, h_den]
      rw [Finset.sum_congr rfl h_term, h_sum_mk, ← MvPolynomial.as_sum P]

    let N₁ := M₁
    let N₂ := N₃
    let M : ℕ := N₁ * (N₂ + 1) + N₂
    have h_card : (N₁ + 1) * (N₂ + 1) = M + 1 := by
      dsimp only [M]; ring
    let e : Fin (M + 1) ≃ Fin (N₁ + 1) × Fin (N₂ + 1) :=
      (finProdFinEquiv.trans (finCongr h_card)).symm
    let _ : ∀ {K : ℕ} (S : Submonoid (MvPolynomial (Fin (K + 1)) k)),
        Algebra k (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) S) :=
      fun {K} S =>
        ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) S).comp
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 0))).toAlgebra

    have hSegre :
        ∃ (σ : CategoryTheory.Limits.pullback (weilProjectiveSpaceOver k N₁).hom
              (weilProjectiveSpaceOver k N₂).hom ⟶
            (weilProjectiveSpaceOver k M).left),
          AlgebraicGeometry.IsClosedImmersion σ ∧
          σ ≫ (weilProjectiveSpaceOver k M).hom =
            CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver k N₁).hom
              (weilProjectiveSpaceOver k N₂).hom ≫ (weilProjectiveSpaceOver k N₁).hom := by
      let p_hom (K : ℕ) :
          AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of k) :=
        (weilProjectiveSpaceOver k K).hom
      have h_away_hom : ∀ (K : ℕ) (f : MvPolynomial (Fin (K + 1)) k) {m : ℕ}
          (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k m) (hm : 0 < m),
          AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) f hf hm ≫
            p_hom K =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap k (HomogeneousLocalization.Away
              (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) f))) := by
        intro K f m hf hm
        change AlgebraicGeometry.Proj.awayι _ f hf hm ≫
          (AlgebraicGeometry.Proj.toSpecZero _ ≫ AlgebraicGeometry.Spec.map _) = _
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      let 𝒰₁ := (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan
        (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k)
        MvPolynomial.X (hX N₁) (fun _ => zero_lt_one) (hHomLoc N₁).1).openCover
      let 𝒰₂ := (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan
        (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k)
        MvPolynomial.X (hX N₂) (fun _ => zero_lt_one) (hHomLoc N₂).1).openCover
      let 𝒰_M := (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
        MvPolynomial.X (hX M) (fun _ => zero_lt_one) (hHomLoc M).1).openCover
      let 𝒰₁₂ := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂)
      let A (i : Fin (N₁ + 1)) :=
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k) (MvPolynomial.X i)
      let B (j : Fin (N₂ + 1)) :=
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k) (MvPolynomial.X j)
      let C (ν : Fin (M + 1)) :=
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X ν)
      let c_ij (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :=
        CategoryTheory.Limits.pullback.congrHom
          (h_away_hom N₁ (MvPolynomial.X ij.1) (hX N₁ ij.1) zero_lt_one)
          (h_away_hom N₂ (MvPolynomial.X ij.2) (hX N₂ ij.2) zero_lt_one)
      let θ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
          𝒰₁₂.X ij ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k (A ij.1) (B ij.2))) :=
        c_ij ij ≪≫ AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)
      have hθ_fst : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
          (θ ij).hom ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
              A ij.1 →+* TensorProduct k (A ij.1) (B ij.2))) =
          CategoryTheory.Limits.pullback.fst (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) :=
        fun ij =>
          (CategoryTheory.Category.assoc (c_ij ij).hom
            (AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)).hom _).trans
            ((congrArg ((c_ij ij).hom ≫ ·)
              (AlgebraicGeometry.pullbackSpecIso_hom_fst k (A ij.1) (B ij.2))).trans
              ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.congrHom_hom _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                  (CategoryTheory.Category.comp_id _))))
      have hθ_snd : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
          (θ ij).hom ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ↑(Algebra.TensorProduct.includeRight :
              B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))) =
          CategoryTheory.Limits.pullback.snd (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) :=
        fun ij =>
          (CategoryTheory.Category.assoc (c_ij ij).hom
            (AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)).hom _).trans
            ((congrArg ((c_ij ij).hom ≫ ·)
              (AlgebraicGeometry.pullbackSpecIso_hom_snd k (A ij.1) (B ij.2))).trans
              ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.congrHom_hom _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  (CategoryTheory.Category.comp_id _))))
      have h𝒰₁₂_fst : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
          𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂) =
            CategoryTheory.Limits.pullback.fst (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) ≫ 𝒰₁.f ij.1 :=
        fun ij =>
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂))
            (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂) ij)).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have h𝒰₁₂_snd : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
          𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂) =
            CategoryTheory.Limits.pullback.snd (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) ≫ 𝒰₂.f ij.2 :=
        fun ij =>
          (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂))
            (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂) ij)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      let r₁ (i a : Fin (N₁ + 1)) : A i :=
        HomogeneousLocalization.Away.isLocalizationElem (hX N₁ i) (hX N₁ a)
      let r₂ (j b : Fin (N₂ + 1)) : B j :=
        HomogeneousLocalization.Away.isLocalizationElem (hX N₂ j) (hX N₂ b)
      let r_M (ν μ : Fin (M + 1)) : C ν :=
        HomogeneousLocalization.Away.isLocalizationElem (hX M ν) (hX M μ)
      let g_poly (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
          MvPolynomial (Fin (M + 1)) k →+* TensorProduct k (A ij.1) (B ij.2) :=
        MvPolynomial.eval₂Hom (algebraMap k (TensorProduct k (A ij.1) (B ij.2)))
          (fun μ => (r₁ ij.1 (e μ).1) ⊗ₜ[k] (r₂ ij.2 (e μ).2))
      have hg_self : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
          g_poly ij (MvPolynomial.X (e.symm ij)) = 1 := by
        intro ij
        simp only [g_poly, MvPolynomial.eval₂Hom_X', e.apply_symm_apply]
        dsimp only [r₁, r₂]
        rw [((hHomLoc N₁).2 ij.1).1, ((hHomLoc N₂).2 ij.2).1]
        rfl
      have hg_unit : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
          IsUnit (g_poly ij (MvPolynomial.X (e.symm ij))) := by
        intro ij; rw [hg_self ij]; exact isUnit_one
      let φ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
          C (e.symm ij) →+* TensorProduct k (A ij.1) (B ij.2) :=
        (IsLocalization.Away.lift
          (S := Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k))
          (MvPolynomial.X (e.symm ij)) (hg_unit ij)).comp
          (algebraMap (C (e.symm ij))
            (Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k)))
      have hφ_k : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (c : k),
          φ ij (algebraMap k (C (e.symm ij)) c) =
            algebraMap k (TensorProduct k (A ij.1) (B ij.2)) c := by
        intro ij c
        dsimp [φ]
        rw [HomogeneousLocalization.algebraMap_apply]
        change (IsLocalization.Away.lift
          (S := Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k))
          (MvPolynomial.X (e.symm ij)) (hg_unit ij))
          (Localization.mk (MvPolynomial.C c) 1) = _
        rw [Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
        simp [g_poly]
      have hφ_ratio : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (μ : Fin (M + 1)),
          φ ij (r_M (e.symm ij) μ) = (r₁ ij.1 (e μ).1) ⊗ₜ[k] (r₂ ij.2 (e μ).2) := by
        intro ij μ
        dsimp [φ, r_M]
        rw [HomogeneousLocalization.algebraMap_apply]
        change (IsLocalization.Away.lift
          (S := Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k))
          (MvPolynomial.X (e.symm ij)) (hg_unit ij))
          (HomogeneousLocalization.Away.mk _ (hX M (e.symm ij)) 1 (MvPolynomial.X μ ^ 1) _).val = _
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
        simp [pow_one, hg_self ij, g_poly]
      have hφ_surj : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1), Function.Surjective (φ ij) := by
        intro ij
        let inL : A ij.1 →+* TensorProduct k (A ij.1) (B ij.2) :=
          Algebra.TensorProduct.includeLeftRingHom
        let inR : B ij.2 →+* TensorProduct k (A ij.1) (B ij.2) :=
          ↑(Algebra.TensorProduct.includeRight : B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))
        have h_inL : ∀ w : A ij.1, inL w ∈ (φ ij).range := by
          have h_le : (⊤ : Subring (A ij.1)) ≤ (φ ij).range.comap inL := by
            rw [← ((hHomLoc N₁).2 ij.1).2, Subring.closure_le]
            rintro x (⟨c, rfl⟩ | ⟨a, rfl⟩)
            · refine ⟨algebraMap k (C (e.symm ij)) c, ?_⟩
              rw [hφ_k ij c]; rfl
            · refine ⟨r_M (e.symm ij) (e.symm (a, ij.2)), ?_⟩
              rw [hφ_ratio, e.apply_symm_apply]
              dsimp only [r₁, r₂]
              rw [((hHomLoc N₂).2 ij.2).1]; rfl
          exact fun w => h_le trivial
        have h_inR : ∀ z : B ij.2, inR z ∈ (φ ij).range := by
          have h_le : (⊤ : Subring (B ij.2)) ≤ (φ ij).range.comap inR := by
            rw [← ((hHomLoc N₂).2 ij.2).2, Subring.closure_le]
            rintro y (⟨c, rfl⟩ | ⟨b, rfl⟩)
            · refine ⟨algebraMap k (C (e.symm ij)) c, ?_⟩
              change φ ij (algebraMap k (C (e.symm ij)) c) =
                (Algebra.TensorProduct.includeRight :
                  B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2)) (algebraMap k (B ij.2) c)
              rw [hφ_k ij c]
              exact ((Algebra.TensorProduct.includeRight :
                B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2)).commutes c).symm
            · refine ⟨r_M (e.symm ij) (e.symm (ij.1, b)), ?_⟩
              rw [hφ_ratio, e.apply_symm_apply]
              dsimp only [r₁, r₂]
              rw [((hHomLoc N₁).2 ij.1).1]; rfl
          exact fun z => h_le trivial
        intro t
        exact TensorProduct.inductionOn (motive := fun t => t ∈ (φ ij).range) t
          (fun w z => by
            have hw : inL w ∈ (φ ij).range := h_inL w
            have hz : inR z ∈ (φ ij).range := h_inR z
            have hmul : inL w * inR z = w ⊗ₜ[k] z := by
              change (w ⊗ₜ[k] (1 : B ij.2)) * ((1 : A ij.1) ⊗ₜ[k] z) = w ⊗ₜ[k] z
              simp
            rw [← hmul]
            exact (φ ij).range.mul_mem hw hz)
          (fun x y hx hy => (φ ij).range.add_mem hx hy)
      let σ_loc (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
          𝒰₁₂.X ij ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
        (θ ij).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫ 𝒰_M.f (e.symm ij)
      have h_away_alg : ∀ {K : ℕ} {f g x : MvPolynomial (Fin (K + 1)) k}
          (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 1) (hx : x = f * g) (c : k),
          HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) hg hx
            (algebraMap k _ c) = algebraMap k _ c := by
        intro K f g x hg hx c
        exact HomogeneousLocalization.awayMap_fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) hg hx (algebraMap k _ c)
      have h_glue : ∀ (ij i'j' : 𝒰₁₂.I₀),
          CategoryTheory.Limits.pullback.fst (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ≫ σ_loc ij =
            CategoryTheory.Limits.pullback.snd (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ≫ σ_loc i'j' := by
        rintro (⟨i, j⟩ : Fin (N₁ + 1) × Fin (N₂ + 1)) (⟨i', j'⟩ : Fin (N₁ + 1) × Fin (N₂ + 1))
        let ν := e.symm (i, j); let ν' := e.symm (i', j')
        let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k
        let 𝒜₂ := MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k
        let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
        let A₂ := HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X i * MvPolynomial.X i')
        let B₂ := HomogeneousLocalization.Away 𝒜₂ (MvPolynomial.X j * MvPolynomial.X j')
        let C₂ := HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X ν * MvPolynomial.X ν')
        let αL : A i →ₐ[k] A₂ :=
          { HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl with
            commutes' := h_away_alg (hX N₁ i') rfl }
        let αR : A i' →ₐ[k] A₂ :=
          { HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i) (mul_comm _ _) with
            commutes' := h_away_alg (hX N₁ i) (mul_comm _ _) }
        let βL : B j →ₐ[k] B₂ :=
          { HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl with
            commutes' := h_away_alg (hX N₂ j') rfl }
        let βR : B j' →ₐ[k] B₂ :=
          { HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j) (mul_comm _ _) with
            commutes' := h_away_alg (hX N₂ j) (mul_comm _ _) }
        let τ_L : TensorProduct k (A i) (B j) →+* TensorProduct k A₂ B₂ :=
          (Algebra.TensorProduct.map αL βL).toRingHom
        let τ_R : TensorProduct k (A i') (B j') →+* TensorProduct k A₂ B₂ :=
          (Algebra.TensorProduct.map αR βR).toRingHom
        let G : MvPolynomial (Fin (M + 1)) k →+* TensorProduct k A₂ B₂ := τ_L.comp (g_poly (i, j))
        have hG_ν : G (MvPolynomial.X ν) = 1 := by
          dsimp [G, ν]; rw [hg_self (i, j), map_one]
        have h_inv_A : αL (r₁ i i') * αR (r₁ i' i) = 1 := by
          rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
          have hval_mul : ∀ x y : A₂, (x * y).val = x.val * y.val := fun x y => by
            simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
          rw [hval_mul]
          change (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl
              (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i) 1 (MvPolynomial.X i' ^ 1) _)).val *
            (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i) (mul_comm _ _)
              (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i') 1 (MvPolynomial.X i ^ 1) _)).val = 1
          rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
            HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
            Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk',
            IsLocalization.mk'_eq_iff_eq]
          congr 1; simp only [OneMemClass.coe_one, Submonoid.coe_mul]; ring
        have h_inv_B : βL (r₂ j j') * βR (r₂ j' j) = 1 := by
          rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
          have hval_mul : ∀ x y : B₂, (x * y).val = x.val * y.val := fun x y => by
            simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
          rw [hval_mul]
          change (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl
              (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j) 1 (MvPolynomial.X j' ^ 1) _)).val *
            (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j) (mul_comm _ _)
              (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j') 1 (MvPolynomial.X j ^ 1) _)).val = 1
          rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
            HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
            Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk',
            IsLocalization.mk'_eq_iff_eq]
          congr 1; simp only [OneMemClass.coe_one, Submonoid.coe_mul]; ring
        have hG_unit : IsUnit (G (MvPolynomial.X ν * MvPolynomial.X ν')) := by
          rw [map_mul, hG_ν, one_mul]
          have hG_ν' : G (MvPolynomial.X ν') = (αL (r₁ i i')) ⊗ₜ[k] (βL (r₂ j j')) := by
            dsimp [G, τ_L, g_poly, ν']; simp
          rw [hG_ν']
          refine ⟨⟨(αL (r₁ i i')) ⊗ₜ[k] (βL (r₂ j j')), (αR (r₁ i' i)) ⊗ₜ[k] (βR (r₂ j' j)), ?_, ?_⟩, rfl⟩
          · rw [Algebra.TensorProduct.tmul_mul_tmul, h_inv_A, h_inv_B]; rfl
          · rw [Algebra.TensorProduct.tmul_mul_tmul, mul_comm (αR _), mul_comm (βR _), h_inv_A, h_inv_B]; rfl
        let ψ : C₂ →+* TensorProduct k A₂ B₂ :=
          (IsLocalization.Away.lift
            (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
            (MvPolynomial.X ν * MvPolynomial.X ν') hG_unit).comp
            (algebraMap C₂
              (Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k)))
        let γL : C ν →+* C₂ := HomogeneousLocalization.awayMap 𝒜_M (hX M ν') rfl
        let γR : C ν' →+* C₂ := HomogeneousLocalization.awayMap 𝒜_M (hX M ν) (mul_comm _ _)
        have hψ_k : ∀ c : k, ψ (algebraMap k C₂ c) = algebraMap k (TensorProduct k A₂ B₂) c := by
          intro c
          dsimp [ψ]
          rw [HomogeneousLocalization.algebraMap_apply]
          change (IsLocalization.Away.lift
            (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
            _ hG_unit) (Localization.mk (MvPolynomial.C c) 1) = _
          rw [Localization.mk_eq_mk']
          refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
          simp only [OneMemClass.coe_one, map_one, one_mul, G, RingHom.comp_apply, g_poly,
            MvPolynomial.eval₂Hom_C]
          exact (Algebra.TensorProduct.map αL βL).commutes c
        have h_cocycle_L : ψ.comp γL = τ_L.comp (φ (i, j)) := by
          have h_le : (⊤ : Subring (C ν)) ≤ RingHom.eqLocus (ψ.comp γL) (τ_L.comp (φ (i, j))) := by
            rw [← ((hHomLoc M).2 ν).2, Subring.closure_le]
            rintro z (⟨c, rfl⟩ | ⟨μ, rfl⟩)
            · change ψ (γL (algebraMap k (C ν) c)) = τ_L (φ (i, j) (algebraMap k (C ν) c))
              rw [h_away_alg (hX M ν') rfl c, hψ_k c, hφ_k (i, j) c]
              exact ((Algebra.TensorProduct.map αL βL).commutes c).symm
            · change ψ (γL (r_M ν μ)) = τ_L (φ (i, j) (r_M ν μ))
              have h_rhs : τ_L (φ (i, j) (r_M ν μ)) = G (MvPolynomial.X μ) := by
                rw [hφ_ratio (i, j) μ]; simp [G, g_poly]
              rw [h_rhs]; dsimp [ψ]; rw [HomogeneousLocalization.algebraMap_apply]
              change (IsLocalization.Away.lift
                (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
                _ hG_unit)
                (γL (HomogeneousLocalization.Away.mk 𝒜_M (hX M ν) 1 (MvPolynomial.X μ ^ 1) _)).val = _
              rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
                Localization.mk_eq_mk']
              refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
              simp only [pow_one, map_mul, hG_ν, one_mul]
              exact mul_comm _ _
          exact RingHom.ext fun z => h_le trivial
        have h_cocycle_R : ψ.comp γR = τ_R.comp (φ (i', j')) := by
          have h_le : (⊤ : Subring (C ν')) ≤ RingHom.eqLocus (ψ.comp γR) (τ_R.comp (φ (i', j'))) := by
            rw [← ((hHomLoc M).2 ν').2, Subring.closure_le]
            rintro z (⟨c, rfl⟩ | ⟨μ, rfl⟩)
            · change ψ (γR (algebraMap k (C ν') c)) = τ_R (φ (i', j') (algebraMap k (C ν') c))
              rw [h_away_alg (hX M ν) (mul_comm _ _) c, hψ_k c, hφ_k (i', j') c]
              exact ((Algebra.TensorProduct.map αR βR).commutes c).symm
            · change ψ (γR (r_M ν' μ)) = τ_R (φ (i', j') (r_M ν' μ))
              dsimp [ψ]; rw [HomogeneousLocalization.algebraMap_apply]
              change (IsLocalization.Away.lift
                (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
                _ hG_unit)
                (γR (HomogeneousLocalization.Away.mk 𝒜_M (hX M ν') 1 (MvPolynomial.X μ ^ 1) _)).val = _
              rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
                Localization.mk_eq_mk']
              refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
              rw [hφ_ratio (i', j') μ]
              simp only [pow_one, map_mul, hG_ν, mul_one, one_mul]
              have hG_μ : G (MvPolynomial.X μ) = (αL (r₁ i (e μ).1)) ⊗ₜ[k] (βL (r₂ j (e μ).2)) := by
                simp [G, τ_L, g_poly]
              have hG_ν' : G (MvPolynomial.X ν') = (αL (r₁ i i')) ⊗ₜ[k] (βL (r₂ j j')) := by
                dsimp [G, τ_L, g_poly, ν']; simp
              have hτR_μ : τ_R ((r₁ i' (e μ).1) ⊗ₜ[k] (r₂ j' (e μ).2)) =
                  (αR (r₁ i' (e μ).1)) ⊗ₜ[k] (βR (r₂ j' (e μ).2)) := rfl
              rw [hG_μ, hG_ν', hτR_μ, Algebra.TensorProduct.tmul_mul_tmul]
              have hA_eq : αL (r₁ i (e μ).1) = αL (r₁ i i') * αR (r₁ i' (e μ).1) := by
                rw [HomogeneousLocalization.ext_iff_val]
                have hval_mul : ∀ x y : A₂, (x * y).val = x.val * y.val := fun x y => by
                  simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
                rw [hval_mul]
                change (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl
                    (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i) 1 (MvPolynomial.X (e μ).1 ^ 1) _)).val =
                  (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl
                    (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i) 1 (MvPolynomial.X i' ^ 1) _)).val *
                  (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i) (mul_comm _ _)
                    (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i') 1 (MvPolynomial.X (e μ).1 ^ 1) _)).val
                rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
                  HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
                  HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
                  Localization.mk_mul, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq]
                congr 1; simp only [Submonoid.coe_mul]; ring
              have hB_eq : βL (r₂ j (e μ).2) = βL (r₂ j j') * βR (r₂ j' (e μ).2) := by
                rw [HomogeneousLocalization.ext_iff_val]
                have hval_mul : ∀ x y : B₂, (x * y).val = x.val * y.val := fun x y => by
                  simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
                rw [hval_mul]
                change (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl
                    (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j) 1 (MvPolynomial.X (e μ).2 ^ 1) _)).val =
                  (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl
                    (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j) 1 (MvPolynomial.X j' ^ 1) _)).val *
                  (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j) (mul_comm _ _)
                    (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j') 1 (MvPolynomial.X (e μ).2 ^ 1) _)).val
                rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
                  HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
                  HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
                  Localization.mk_mul, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq]
                congr 1; simp only [Submonoid.coe_mul]; ring
              rw [hA_eq, hB_eq]
          exact RingHom.ext fun z => h_le trivial
        let πL := CategoryTheory.Limits.pullback.fst (𝒰₁₂.f (i, j)) (𝒰₁₂.f (i', j'))
        let πR := CategoryTheory.Limits.pullback.snd (𝒰₁₂.f (i, j)) (𝒰₁₂.f (i', j'))
        have h_ov₁ : (πL ≫ CategoryTheory.Limits.pullback.fst (𝒰₁.f i ≫ p_hom N₁) (𝒰₂.f j ≫ p_hom N₂)) ≫ 𝒰₁.f i =
            (πR ≫ CategoryTheory.Limits.pullback.fst (𝒰₁.f i' ≫ p_hom N₁) (𝒰₂.f j' ≫ p_hom N₂)) ≫ 𝒰₁.f i' :=
          (CategoryTheory.Category.assoc πL _ _).trans
            ((congrArg (πL ≫ ·) (h𝒰₁₂_fst (i, j)).symm).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) CategoryTheory.Limits.pullback.condition).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (πR ≫ ·) (h𝒰₁₂_fst (i', j'))).trans
                      (CategoryTheory.Category.assoc _ _ _).symm)))))
        have h_ov₂ : (πL ≫ CategoryTheory.Limits.pullback.snd (𝒰₁.f i ≫ p_hom N₁) (𝒰₂.f j ≫ p_hom N₂)) ≫ 𝒰₂.f j =
