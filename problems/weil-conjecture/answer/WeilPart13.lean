    have h_sub_w_eq : (⟨w₀, hw₀_W⟩ : ↥W_TB) = ⟨w₁, hw₁_W⟩ :=
      e_iso.injective h_res_eq
    exact hw_ne (congrArg Subtype.val h_sub_w_eq)
  have h_sec_s₀ : ∃ (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ B.left),
      s_bar ≫ B.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      ∀ pt, s_bar.base pt = s₀ := by
    obtain ⟨U, hAffU, hs₀U, _⟩ :=
      @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset B.left s₀ ⊤ trivial
    let R_U : CommRingCat.{u} := B.left.presheaf.obj (Opposite.op U)
    let α_U : CommRingCat.of k ⟶ R_U :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage (hAffU.fromSpec ≫ B.hom)).unop
    have hSpecα : AlgebraicGeometry.Spec.map α_U = hAffU.fromSpec ≫ B.hom :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage (hAffU.fromSpec ≫ B.hom)
    have hLFT_U : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α_U) := by
      rw [hSpecα, ← hAffU.isoSpec_inv_ι]
      infer_instance
    have hFT_U : α_U.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_U
    let : Algebra k R_U := α_U.hom.toAlgebra
    have : Algebra.FiniteType k R_U := hFT_U
    let e_U : ↥U ≃ₜ PrimeSpectrum R_U := AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec
    let p_s : PrimeSpectrum R_U := e_U ⟨s₀, hs₀U⟩
    have hSub_eq : ({⟨s₀, hs₀U⟩} : Set ↥U) = (Subtype.val : ↥U → B.left) ⁻¹' ({s₀} : Set B.left) := by
      ext ⟨x, hx⟩
      simp
    have hCl_sub : IsClosed ({⟨s₀, hs₀U⟩} : Set ↥U) :=
      hSub_eq ▸ hCls₀.preimage continuous_subtype_val
    have hCl_ps : IsClosed ({p_s} : Set (PrimeSpectrum R_U)) := by
      rw [← Set.image_singleton]
      exact e_U.isClosedMap _ hCl_sub
    have : p_s.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_s).mp hCl_ps
    let κ : Type u := R_U ⧸ p_s.asIdeal
    let : Field κ := Ideal.Quotient.field p_s.asIdeal
    have : Algebra.FiniteType k κ :=
      Algebra.FiniteType.of_surjective (IsScalarTower.toAlgHom k R_U κ) Ideal.Quotient.mk_surjective
    obtain ⟨n_κ, ψ_κ, hψ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := κ)).mp inferInstance
    have : (⊥ : Ideal κ).IsMaximal :=
      Ideal.isMaximal_iff.mpr ⟨one_ne_zero, fun J x _ hx0 hxJ => by
        simpa [inv_mul_cancel₀ hx0] using J.mul_mem_left x⁻¹ hxJ⟩
    have : (Ideal.comap ψ_κ.toRingHom ⊥).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective ψ_κ.toRingHom hψ_surj
    obtain ⟨a_κ, ha_κ⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton
        (I := Ideal.comap ψ_κ.toRingHom ⊥)).mp inferInstance
    have hBij_κ : Function.Bijective (algebraMap k κ) := by
      refine ⟨RingHom.injective _, fun y => ?_⟩
      obtain ⟨P, rfl⟩ := hψ_surj y
      refine ⟨MvPolynomial.aeval a_κ P, ?_⟩
      have hmem : P - MvPolynomial.C (MvPolynomial.aeval a_κ P) ∈ Ideal.comap ψ_κ.toRingHom ⊥ := by
        rw [ha_κ, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp
      rw [Ideal.mem_comap, Ideal.mem_bot, map_sub, sub_eq_zero] at hmem
      change ψ_κ P = ψ_κ (MvPolynomial.C (MvPolynomial.aeval a_κ P)) at hmem
      rw [hmem]
      exact (ψ_κ.commutes (MvPolynomial.aeval a_κ P)).symm
    let q_mk : R_U ⟶ CommRingCat.of κ := CommRingCat.ofHom (Ideal.Quotient.mk p_s.asIdeal)
    let φ_κ : CommRingCat.of k ⟶ CommRingCat.of κ := α_U ≫ q_mk
    have hφ_bij : Function.Bijective φ_κ.hom := hBij_κ
    let e_κ : CommRingCat.of k ≅ CommRingCat.of κ :=
      RingEquiv.toCommRingCatIso (RingEquiv.ofBijective φ_κ.hom hφ_bij)
    have he_hom : e_κ.hom = φ_κ := by
      ext c
      rfl
    refine ⟨AlgebraicGeometry.Spec.map e_κ.inv ≫ AlgebraicGeometry.Spec.map q_mk ≫ hAffU.fromSpec, ?_, ?_⟩
    · rw [Category.assoc, Category.assoc, ← hSpecα, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      have hcomp_id : (α_U ≫ q_mk) ≫ e_κ.inv = 𝟙 (CommRingCat.of k) := by
        change φ_κ ≫ e_κ.inv = 𝟙 _
        rw [← he_hom, e_κ.hom_inv_id]
      rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
    · intro pt
      let pt' : PrimeSpectrum κ := (AlgebraicGeometry.Spec.map e_κ.inv).base pt
      have hpt'_bot : pt'.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt'.asIdeal
      have hq_pt : (AlgebraicGeometry.Spec.map q_mk).base pt' = p_s := by
        apply PrimeSpectrum.ext
        change Ideal.comap (Ideal.Quotient.mk p_s.asIdeal) pt'.asIdeal = p_s.asIdeal
        rw [hpt'_bot, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      change hAffU.fromSpec.base ((AlgebraicGeometry.Spec.map q_mk).base pt') = s₀
      rw [hq_pt, ← hAffU.isoSpec_inv_ι]
      change U.ι.base (e_U.symm (e_U ⟨s₀, hs₀U⟩)) = s₀
      rw [Homeomorph.symm_apply_apply]
      rfl
  obtain ⟨s_bar, hs_bar_hom, hs_bar_pt⟩ := h_sec_s₀
  exact ⟨s₀, s_bar, c₁, w₀, w₁, hCls₀, hs₀_notMem, hs_bar_hom, hs_bar_pt, rfl,
    hw₀_c₁, hw₁_c₁, hw_cl, hw_ne⟩

theorem weil_algClosed_semistable_closed_fiber_equidim_and_branch_bounds (k : Type u) [Field k] [IsAlgClosed k]
    (B C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hUB : Nonempty U_B)
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (f : C ⟶ B)
    (n : ℕ)
    (τ : Fin n → (B ⟶ C))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (s₀ : B.left)
    (hCls₀ : IsClosed ({s₀} : Set B.left)) :
    (∀ E ∈ irreducibleComponents ↥{c : C.left | f.left.base c = s₀},
      topologicalKrullDim ↥E = (1 : WithBot ℕ∞)) ∧
    (∀ (c : C.left) (hc : f.left.base c = s₀)
        (E₁ E₂ E₃ : Set ↥{y : C.left | f.left.base y = s₀}),
      E₁ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      E₂ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      E₃ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      (⟨c, hc⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₁ →
      (⟨c, hc⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₂ →
      (⟨c, hc⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₃ →
      ¬(E₁ ≠ E₂ ∧ E₁ ≠ E₃ ∧ E₂ ≠ E₃)) ∧
    (∀ (j : Fin n) (hs_tau : f.left.base ((τ j).left.base s₀) = s₀)
        (E₁ E₂ : Set ↥{y : C.left | f.left.base y = s₀}),
      E₁ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      E₂ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      (⟨(τ j).left.base s₀, hs_tau⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₁ →
      (⟨(τ j).left.base s₀, hs_tau⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₂ →
      E₁ = E₂) :=
by
  let _ := hIntB; let _ := hUB; let _ := hIntC; let _ := hProjC
  have hRoofAlg : ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀] (R_C : Type u) [CommRing R_C],
      (∀ (S : Type u) [CommRing S] [Algebra (Polynomial K₀) S] [Algebra.Etale (Polynomial K₀) S]
          (φ_C : R_C →+* S), φ_C.Etale →
          ∀ (q₀ : Ideal S) [q₀.IsPrime],
            (∃ (p₁ p₀ : Ideal R_C), p₁.IsPrime ∧ p₀.IsPrime ∧ p₁ < p₀) ∧
            (∀ (p₂ p₁ : Ideal R_C),
              p₂.IsPrime → p₁.IsPrime → p₂ < p₁ → p₁ < Ideal.comap φ_C q₀ → False) ∧
            (∀ m₁ ∈ minimalPrimes R_C, ∀ m₂ ∈ minimalPrimes R_C,
              m₁ ≤ Ideal.comap φ_C q₀ → m₂ ≤ Ideal.comap φ_C q₀ → m₁ = m₂)) ∧
      (∀ (R' S : Type u) [CommRing R'] [CommRing S] [Algebra K₀ R'] [Algebra.Etale K₀ R']
          (h : R') (φ_C : R_C →+* S)
          (φ_Q : (MvPolynomial (Fin 2) R' ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}) →+* S),
          φ_C.Etale → φ_Q.Etale →
          ∀ (q₀ : Ideal S) [q₀.IsPrime],
            (∀ i : Fin 2, φ_Q (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀) →
            φ_Q (Ideal.Quotient.mk _ (MvPolynomial.C h)) ∈ q₀ →
            (∃ (p₁ p₀ : Ideal R_C), p₁.IsPrime ∧ p₀.IsPrime ∧ p₁ < p₀) ∧
            (∀ (p₂ p₁ : Ideal R_C),
              p₂.IsPrime → p₁.IsPrime → p₂ < p₁ → p₁ < Ideal.comap φ_C q₀ → False) ∧
            (∀ m₁ ∈ minimalPrimes R_C, ∀ m₂ ∈ minimalPrimes R_C, ∀ m₃ ∈ minimalPrimes R_C,
              m₁ ≤ Ideal.comap φ_C q₀ → m₂ ≤ Ideal.comap φ_C q₀ → m₃ ≤ Ideal.comap φ_C q₀ →
              ¬(m₁ ≠ m₂ ∧ m₁ ≠ m₃ ∧ m₂ ≠ m₃))) := by
    intro K₀ _ _ R_C _
    
    have hEtaleComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
        {f : A →+* B} {g : B →+* C}, f.Etale → g.Etale → (g.comp f).Etale := by
      intro A B C _ _ _ f g hf hg
      let _ : Algebra A B := f.toAlgebra
      let _ : Algebra B C := g.toAlgebra
      let _ : Algebra A C := (g.comp f).toAlgebra
      have _ : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale A B := hf.toAlgebra
      have _ : Algebra.Etale B C := hg.toAlgebra
      have hEtAC : Algebra.Etale A C := Algebra.Etale.comp A B C
      exact RingHom.etale_algebraMap.mpr hEtAC

    
    have hGoingDownLE : ∀ {A B : Type u} [CommRing A] [CommRing B] (ψ : A →+* B),
        ψ.Etale → ∀ (Q : Ideal B) [Q.IsPrime] (p : Ideal A) [p.IsPrime],
        p ≤ Ideal.comap ψ Q → ∃ P ≤ Q, P.IsPrime ∧ Ideal.comap ψ P = p := by
      intro A B _ _ ψ hψ Q _ p _ hp_le
      by_cases hEq : p = Ideal.comap ψ Q
      · exact ⟨Q, le_rfl, inferInstance, hEq.symm⟩
      · let _ : Algebra A B := ψ.toAlgebra
        have _ : Algebra.Etale A B := hψ.toAlgebra
        have _ : Module.Flat A B := inferInstance
        have _ : Algebra.HasGoingDown A B := Algebra.HasGoingDown.of_flat
        have hlt : p < Ideal.under A Q := lt_of_le_of_ne hp_le hEq
        obtain ⟨P, hPQ, hP_prime, hLies⟩ :=
          Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt Q hlt
        exact ⟨P, hPQ, hP_prime, hLies.over.symm⟩

    
    have hPrincipalQuotEtale : ∀ {A B : Type u} [CommRing A] [CommRing B]
        (φ : A →+* B), φ.Etale → ∀ (a₀ : A),
        ∃ (A' B' : Type u) (instA' : CommRing A') (instB' : CommRing B'),
          letI : CommRing A' := instA'
          letI : CommRing B' := instB'
          ∃ (π_A : A →+* A') (π_B : B →+* B') (φ' : A' →+* B'),
            Function.Surjective π_A ∧
            (∀ x : A, π_A x = 0 ↔ x ∈ Ideal.span {a₀}) ∧
            Function.Surjective π_B ∧
            (∀ y : B, π_B y = 0 ↔ y ∈ Ideal.span {φ a₀}) ∧
            (∀ x : A, φ' (π_A x) = π_B (φ x)) ∧
            φ'.Etale ∧
            (∀ {D : Type u} [CommRing D] (f : A →+* D),
              Ideal.span {a₀} ≤ RingHom.ker f →
              ∃ f' : A' →+* D, ∀ x : A, f' (π_A x) = f x) ∧
            (∀ {D : Type u} [CommRing D] (g : B →+* D),
              Ideal.span {φ a₀} ≤ RingHom.ker g →
              ∃ g' : B' →+* D, ∀ y : B, g' (π_B y) = g y) := by
      intro A B _ _ φ hφ a₀
      let I_A : Ideal A := Ideal.span {a₀}
      let I_B : Ideal B := Ideal.span {φ a₀}
      have hIB_map : I_B = Ideal.map φ I_A := by
        change Ideal.span {φ a₀} = Ideal.map φ (Ideal.span {a₀})
        rw [Ideal.map_span, Set.image_singleton]
      let instA' : CommRing (A ⧸ I_A) := Ideal.Quotient.commRing I_A
      let instB' : CommRing (B ⧸ I_B) := Ideal.Quotient.commRing I_B
      letI : CommRing (A ⧸ I_A) := instA'
      letI : CommRing (B ⧸ I_B) := instB'
      letI : Algebra A (A ⧸ I_A) := Ideal.Quotient.algebra A
      let π_A : A →+* (A ⧸ I_A) := Ideal.Quotient.mk I_A
      let π_B : B →+* (B ⧸ I_B) := Ideal.Quotient.mk I_B
      let φ'_raw := Ideal.Quotient.lift I_A (π_B.comp φ) (fun x hx => by
        change π_B (φ x) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem, hIB_map]
        exact Ideal.mem_map_of_mem φ hx)
      let φ' : @RingHom (A ⧸ I_A) (B ⧸ I_B)
          instA'.toCommSemiring.toSemiring.toNonAssocSemiring
          instB'.toCommSemiring.toSemiring.toNonAssocSemiring :=
        { toFun := φ'_raw
          map_one' := φ'_raw.map_one
          map_mul' := φ'_raw.map_mul
          map_zero' := φ'_raw.map_zero
          map_add' := φ'_raw.map_add }
      have hφ'_etale : @RingHom.Etale (A ⧸ I_A) (B ⧸ I_B) instA' instB' φ' := by
        letI : Algebra A B := φ.toAlgebra
        haveI : Algebra.Etale A B := hφ.toAlgebra
        letI : Algebra (A ⧸ I_A) (B ⧸ I_B) := φ'.toAlgebra
        letI : CommRing (B ⧸ Ideal.map (algebraMap A B) I_A) := Ideal.Quotient.commRing _
        have hEt_t : Algebra.Etale (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B) := inferInstance
        let e_q : (B ⧸ Ideal.map (algebraMap A B) I_A) ≃+* (B ⧸ I_B) :=
          Ideal.quotEquivOfEq hIB_map.symm
        let e_t : TensorProduct A (A ⧸ I_A) B ≃+* (B ⧸ I_B) :=
          (Algebra.TensorProduct.comm A (A ⧸ I_A) B).toRingEquiv.trans
            ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A).symm.toRingEquiv.trans e_q)
        let e_a : TensorProduct A (A ⧸ I_A) B ≃ₐ[A ⧸ I_A] (B ⧸ I_B) :=
          AlgEquiv.ofRingEquiv (f := e_t) (fun x => by
            obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
            change e_q ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A).symm
              (1 ⊗ₜ[A] π_A y)) = φ' (π_A y)
            have h1 : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A)
                (Ideal.Quotient.mk (Ideal.map (algebraMap A B) I_A) (φ y)) =
                (1 : B) ⊗ₜ[A] π_A y := by
              have hmk : Ideal.Quotient.mk (Ideal.map (algebraMap A B) I_A) (φ y) =
                  (φ y) • (1 : B ⧸ Ideal.map (algebraMap A B) I_A) := by
                rw [Algebra.smul_def, mul_one]; rfl
              rw [hmk, map_smul, map_one, Algebra.smul_def (φ y) (1 : TensorProduct A B (A ⧸ I_A))]
              change ((φ y) ⊗ₜ[A] (1 : A ⧸ I_A)) * ((1 : B) ⊗ₜ[A] (1 : A ⧸ I_A)) = 1 ⊗ₜ[A] π_A y
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one]
              have hφy : φ y = y • (1 : B) := by
                change algebraMap A B y = y • (1 : B)
                rw [Algebra.smul_def, mul_one]
              rw [hφy, TensorProduct.smul_tmul]
              congr 1
              change y • (1 : A ⧸ I_A) = π_A y
              rw [Algebra.smul_def, mul_one]
              rfl
            rw [← h1, AlgEquiv.symm_apply_apply]
            rfl)
        have hEt_B' : Algebra.Etale (A ⧸ I_A) (B ⧸ I_B) := Algebra.Etale.of_equiv e_a
        exact RingHom.etale_algebraMap.mpr hEt_B'
      refine ⟨A ⧸ I_A, B ⧸ I_B, instA', instB', π_A, π_B, φ',
        Ideal.Quotient.mk_surjective, fun x => Ideal.Quotient.eq_zero_iff_mem,
        Ideal.Quotient.mk_surjective, fun y => Ideal.Quotient.eq_zero_iff_mem,
        fun x => rfl, hφ'_etale, ?_, ?_⟩
      · intro D _ f hf
        let l := Ideal.Quotient.lift I_A f (fun x hx => hf hx)
        exact ⟨{ toFun := l, map_one' := l.map_one, map_mul' := l.map_mul,
                 map_zero' := l.map_zero, map_add' := l.map_add }, fun _ => rfl⟩
      · intro D _ g hg
        let l := Ideal.Quotient.lift I_B g (fun y hy => hg hy)
        exact ⟨{ toFun := l, map_one' := l.map_one, map_mul' := l.map_mul,
                 map_zero' := l.map_zero, map_add' := l.map_add }, fun _ => rfl⟩

    
    have hPolyDom : ∀ (T : Type u) [CommRing T] [Algebra (Polynomial K₀) T]
        [Algebra.Etale (Polynomial K₀) T] (Q : Ideal T) [Q.IsPrime],
        True ∧ IsDomain (Localization.AtPrime Q) := by
      intro T _ _ _ Q _
      refine ⟨trivial, ?_⟩
      let R : Type u := Polynomial K₀
      let A : Type u := Localization.AtPrime Q
      by_cases hQ_bot : Ideal.comap (algebraMap R T) Q = ⊥
      · let K_R : Type u := FractionRing R
        let M_R : Submonoid T := Algebra.algebraMapSubmonoid T (nonZeroDivisors R)
        let T_K : Type u := Localization M_R
        have hDisj : Disjoint (M_R : Set T) (Q : Set T) := by
          rw [Set.disjoint_left]
          rintro _ ⟨r, hr_nzd, rfl⟩ hmemQ
          have hr_mem : r ∈ Ideal.comap (algebraMap R T) Q := hmemQ
          rw [hQ_bot, Ideal.mem_bot] at hr_mem
          exact nonZeroDivisors.ne_zero hr_nzd hr_mem
        let Q_K : Ideal T_K := Ideal.map (algebraMap T T_K) Q
        have hQK_prime : Q_K.IsPrime :=
          IsLocalization.isPrime_of_isPrime_disjoint M_R T_K Q inferInstance hDisj
        have hQ_under : Q = Ideal.comap (algebraMap T T_K) Q_K :=
          (IsLocalization.under_map_of_isPrime_disjoint M_R T_K inferInstance hDisj).symm
        let e₁ : A ≃+* Localization.AtPrime Q_K :=
          (Localization.localRingEquiv Q (Ideal.comap (algebraMap T T_K) Q_K)
            (RingEquiv.refl T) hQ_under).trans
            (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M_R Q_K).toRingEquiv
        let _ : IsLocalization M_R (TensorProduct R T K_R) :=
          IsLocalization.tensor K_R (nonZeroDivisors R)
        have hEt_KR : Algebra.Etale K_R (TensorProduct R K_R T) := inferInstance
        obtain ⟨J, _, E, hFieldE, _, Φ_T, _⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod K_R (TensorProduct R K_R T)).mp hEt_KR
        let Φ_K : T_K ≃+* (∀ j : J, E j) :=
          (IsLocalization.algEquiv M_R T_K (TensorProduct R T K_R)).toRingEquiv.trans
            ((Algebra.TensorProduct.comm R T K_R).toRingEquiv.trans Φ_T.toRingEquiv)
        let Q_star : Ideal (∀ j : J, E j) := Ideal.comap Φ_K.symm.toRingHom Q_K
        have hQstar_prime : Q_star.IsPrime := Ideal.IsPrime.comap Φ_K.symm.toRingHom
        have hQK_eq : Q_K = Ideal.comap Φ_K Q_star := by
          ext x; simp [Q_star]
        let e₂ : Localization.AtPrime Q_K ≃+* Localization.AtPrime Q_star :=
          Localization.localRingEquiv Q_K Q_star Φ_K hQK_eq
        obtain ⟨j₀, q_j₀, hq_j₀_eq⟩ :=
          PrimeSpectrum.exists_comap_evalRingHom_eq ⟨Q_star, hQstar_prime⟩
        have hQstar_eq : Q_star = Ideal.comap (Pi.evalRingHom E j₀) q_j₀.asIdeal :=
          (congrArg PrimeSpectrum.asIdeal hq_j₀_eq).symm
        let e₃ : Localization.AtPrime Q_star ≃+* Localization.AtPrime q_j₀.asIdeal :=
          (Localization.localRingEquiv Q_star (Ideal.comap (Pi.evalRingHom E j₀) q_j₀.asIdeal)
            (RingEquiv.refl _) hQstar_eq).trans
            (RingEquiv.ofBijective (Localization.AtPrime.mapPiEvalRingHom q_j₀.asIdeal)
              (Localization.AtPrime.mapPiEvalRingHom_bijective q_j₀.asIdeal))
        let _ : Field (E j₀) := hFieldE j₀
        have h_units : q_j₀.asIdeal.primeCompl ≤ IsUnit.submonoid (E j₀) := by
          intro x hx
          exact isUnit_iff_ne_zero.mpr (fun h0 => hx (h0 ▸ q_j₀.asIdeal.zero_mem))
        let e₄ : Localization.AtPrime q_j₀.asIdeal ≃+* E j₀ :=
          (IsLocalization.atUnits (E j₀) q_j₀.asIdeal.primeCompl h_units).symm.toRingEquiv
        let e_all : A ≃+* E j₀ := e₁.trans (e₂.trans (e₃.trans e₄))
        exact Function.Injective.isDomain e_all.toRingHom e_all.injective
      · let p : Ideal R := Ideal.comap (algebraMap R T) Q
        have _ : p.IsPrime := inferInstance
        let ϖ : R := Submodule.IsPrincipal.generator p
        have hp_span : p = Ideal.span {ϖ} := (Submodule.IsPrincipal.span_singleton_generator p).symm
        have hϖ_ne : ϖ ≠ 0 := by
          intro h0
          apply hQ_bot
          change p = ⊥
          rw [hp_span, h0, Ideal.span_singleton_eq_bot]
        have hp_max : p.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hQ_bot
        let κ : Type u := R ⧸ p
        let _ : Field κ := Ideal.Quotient.field p
        let ϖ_T : T := algebraMap R T ϖ
        have hϖT_mem : ϖ_T ∈ Q := by
          change ϖ ∈ p
          rw [hp_span]
          exact Ideal.mem_span_singleton_self ϖ
        have hEt_κ : Algebra.Etale κ (TensorProduct R κ T) := inferInstance
        obtain ⟨J, _, κ_f, hFieldκ, _, Φ_κ, _⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod κ (TensorProduct R κ T)).mp hEt_κ
        let J_ϖ : Ideal T := Ideal.map (algebraMap R T) p
        have hJ_ϖ_eq : J_ϖ = Ideal.span {ϖ_T} := by
          change Ideal.map (algebraMap R T) p = Ideal.span {ϖ_T}
          rw [hp_span, Ideal.map_span, Set.image_singleton]
        let Φ₀ : (T ⧸ J_ϖ) ≃+* (∀ j : J, κ_f j) :=
          (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T p).toRingEquiv.trans
            ((Algebra.TensorProduct.comm R T κ).toRingEquiv.trans Φ_κ.toRingEquiv)
        let q_T : T →+* (∀ j : J, κ_f j) := Φ₀.toRingHom.comp (Ideal.Quotient.mk J_ϖ)
        have hqT_surj : Function.Surjective q_T := Φ₀.surjective.comp Ideal.Quotient.mk_surjective
        have hker_qT : RingHom.ker q_T = J_ϖ := by
          ext t
          change Φ₀ (Ideal.Quotient.mk J_ϖ t) = 0 ↔ t ∈ J_ϖ
          rw [map_eq_zero_iff Φ₀ Φ₀.injective, Ideal.Quotient.eq_zero_iff_mem]
        have hker_le_Q : RingHom.ker q_T ≤ Q := by
          rw [hker_qT, hJ_ϖ_eq]
          exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖT_mem)
        let Q_bar : Ideal (∀ j : J, κ_f j) := Ideal.map q_T Q
        have hQbar_prime : Q_bar.IsPrime := Ideal.map_isPrime_of_surjective hqT_surj hker_le_Q
        have hQ_comap_qT : Ideal.comap q_T Q_bar = Q := by
          rw [Ideal.comap_map_of_surjective' q_T hqT_surj Q, sup_eq_left.mpr hker_le_Q]
        obtain ⟨j₀, p₀, hp₀_eq⟩ :=
          PrimeSpectrum.exists_comap_evalRingHom_eq ⟨Q_bar, hQbar_prime⟩
        let _ : Field (κ_f j₀) := hFieldκ j₀
        have hp₀_bot : p₀.asIdeal = ⊥ := eq_bot_iff.mpr fun x hx => by
          by_contra hx0
          exact p₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (isUnit_iff_ne_zero.mpr hx0))
        have hQbar_eq : Q_bar = Ideal.comap (Pi.evalRingHom κ_f j₀) ⊥ := by
          have h1 : Q_bar = Ideal.comap (Pi.evalRingHom κ_f j₀) p₀.asIdeal :=
            (congrArg PrimeSpectrum.asIdeal hp₀_eq).symm
          rwa [hp₀_bot] at h1
        have hQ_iff : ∀ t : T, t ∈ Q ↔ q_T t j₀ = 0 := by
          intro t
          rw [← hQ_comap_qT, Ideal.mem_comap, hQbar_eq, Ideal.mem_comap,
            Pi.evalRingHom_apply, Ideal.mem_bot]
        let _ : DecidableEq J := Classical.decEq J
        obtain ⟨u₀, hu₀⟩ := hqT_surj (Pi.single j₀ 1)
        have hu₀_not_Q : u₀ ∉ Q := by
          rw [hQ_iff, hu₀, Pi.single_eq_same]
          exact one_ne_zero
        have hu₀_mul : ∀ t ∈ Q, u₀ * t ∈ Ideal.span {ϖ_T} := by
          intro t ht
          rw [← hJ_ϖ_eq, ← hker_qT, RingHom.mem_ker, map_mul, hu₀]
          ext j
          simp only [Pi.mul_apply, Pi.zero_apply]
          by_cases hj : j = j₀
          · subst hj; rw [(hQ_iff t).mp ht, mul_zero]
          · rw [Pi.single_eq_of_ne hj, zero_mul]
        let π : A := algebraMap T A ϖ_T
        have hmaxA : IsLocalRing.maximalIdeal A = Ideal.span {π} := by
          apply le_antisymm
          · intro y hy
            obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj Q.primeCompl y
            have htA_mem : algebraMap T A t ∈ IsLocalRing.maximalIdeal A := by
              rw [← hts]
              exact (IsLocalRing.maximalIdeal A).mul_mem_right _ hy
            have ht_Q : t ∈ Q := by
              rw [← IsLocalization.AtPrime.under_maximalIdeal A Q]
              exact htA_mem
            obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (hu₀_mul t ht_Q)
            have hu_unit : IsUnit (algebraMap T A u₀ * algebraMap T A s) :=
              (IsLocalization.map_units A (⟨u₀, hu₀_not_Q⟩ : Q.primeCompl)).mul
                (IsLocalization.map_units A s)
            obtain ⟨v, hv⟩ := hu_unit.exists_left_inv
            rw [Ideal.mem_span_singleton]
            refine ⟨v * algebraMap T A c, ?_⟩
            calc y = (v * (algebraMap T A u₀ * algebraMap T A s)) * y := by rw [hv, one_mul]
              _ = v * (algebraMap T A u₀ * (y * algebraMap T A s)) := by ring
              _ = v * (algebraMap T A u₀ * algebraMap T A t) := by rw [hts]
              _ = v * algebraMap T A (u₀ * t) := by rw [← map_mul]
              _ = v * algebraMap T A (ϖ_T * c) := by rw [hc]
              _ = π * (v * algebraMap T A c) := by rw [map_mul]; ring
          · apply Ideal.span_le.mpr
            rw [Set.singleton_subset_iff]
            change ϖ_T ∈ Ideal.under T (IsLocalRing.maximalIdeal A)
            rw [IsLocalization.AtPrime.under_maximalIdeal A Q]
            exact hϖT_mem
        have _ : Module.Flat R T := inferInstance
        have _ : Module.IsTorsionFree R T := Module.Flat.isTorsionFree
        have hπ_nzd : ∀ z : A, π * z = 0 → z = 0 := by
          intro z hz
          obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj Q.primeCompl z
          have h0 : algebraMap T A (ϖ_T * t) = algebraMap T A 0 := by
            rw [map_mul, map_zero, ← hts]
            calc π * (z * algebraMap T A s) = (π * z) * algebraMap T A s := by ring
              _ = 0 := by rw [hz, zero_mul]
          obtain ⟨s', hs'⟩ := (IsLocalization.eq_iff_exists Q.primeCompl A).mp h0
          have hsmul0 : ϖ • (s'.1 * t) = 0 := by
            rw [Algebra.smul_def]
            calc ϖ_T * (s'.1 * t) = s'.1 * (ϖ_T * t) := by ring
              _ = s'.1 * 0 := hs'
              _ = 0 := mul_zero _
          have hst0 : s'.1 * t = 0 := (smul_eq_zero.mp hsmul0).resolve_left hϖ_ne
          have hunit : IsUnit (algebraMap T A s' * algebraMap T A s) :=
            (IsLocalization.map_units A s').mul (IsLocalization.map_units A s)
          obtain ⟨v, hv⟩ := hunit.exists_left_inv
          calc z = (v * (algebraMap T A s' * algebraMap T A s)) * z := by rw [hv, one_mul]
            _ = v * (algebraMap T A s' * (z * algebraMap T A s)) := by ring
            _ = v * algebraMap T A (s'.1 * t) := by rw [hts, ← map_mul]
            _ = 0 := by rw [hst0, map_zero, mul_zero]
        have hπ_pow_nzd : ∀ (m : ℕ) (z : A), π ^ m * z = 0 → z = 0 := by
          intro m
          induction m with
          | zero => intro z hz; simpa using hz
          | succ m ih =>
            intro z hz
            rw [pow_succ, mul_assoc] at hz
            exact hπ_nzd z (ih (π * z) hz)
        have _ : Algebra.FiniteType R T := inferInstance
        have _ : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing R T
        have _ : IsNoetherianRing A := IsLocalization.isNoetherianRing Q.primeCompl A inferInstance
        have hiInf : (⨅ n : ℕ, Ideal.span {π ^ n}) = (⊥ : Ideal A) := by
          have h := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal A)
            (IsLocalRing.maximalIdeal.isMaximal A).ne_top
          simpa only [hmaxA, Ideal.span_singleton_pow] using h
        have h_factor : ∀ x : A, x ≠ 0 → ∃ (k : ℕ) (u : A), IsUnit u ∧ x = π ^ k * u := by
          intro x hx
          classical
          have hx_not_iInf : x ∉ (⨅ n : ℕ, Ideal.span {π ^ n}) := by
            rw [hiInf, Ideal.mem_bot]; exact hx
          rw [Ideal.mem_iInf] at hx_not_iInf
          obtain ⟨N, hN⟩ := not_forall.mp hx_not_iInf
          have h_ex : ∃ k : ℕ, x ∉ Ideal.span {π ^ (k + 1)} := by
            cases N with
            | zero =>
              exfalso; apply hN; rw [pow_zero, Ideal.span_singleton_one]; trivial
            | succ k => exact ⟨k, hN⟩
          let k := Nat.find h_ex
          have hk_not : x ∉ Ideal.span {π ^ (k + 1)} := Nat.find_spec h_ex
          have hk_mem : x ∈ Ideal.span {π ^ k} := by
            cases h_k : k with
            | zero => rw [pow_zero, Ideal.span_singleton_one]; trivial
            | succ k' =>
              by_contra h_not
              have hlt : k' < k := by omega
              exact Nat.find_min h_ex hlt (h_k ▸ h_not)
          obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hk_mem
          have hu_not_max : u ∉ IsLocalRing.maximalIdeal A := by
            rw [hmaxA, Ideal.mem_span_singleton]
            rintro ⟨v, rfl⟩
            apply hk_not
            rw [Ideal.mem_span_singleton]
            exact ⟨v, by rw [hu_eq, pow_succ]; ring⟩
          exact ⟨k, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_max, hu_eq⟩
        have h_nzd_A : NoZeroDivisors A := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · by_cases hy : y = 0
            · exact Or.inr hy
            · exfalso
              obtain ⟨k, u, hu, rfl⟩ := h_factor x hx
              obtain ⟨l, v, hv, rfl⟩ := h_factor y hy
              have huv : u * v = 0 := hπ_pow_nzd (k + l) (u * v) (by
                calc π ^ (k + l) * (u * v) = (π ^ k * u) * (π ^ l * v) := by rw [pow_add]; ring
                  _ = 0 := hxy)
              exact (hu.mul hv).ne_zero huv⟩
        exact @NoZeroDivisors.to_isDomain A _ inferInstance h_nzd_A

    
    have hStrictComap : ∀ {A B : Type u} [CommRing A] [CommRing B] (ψ : A →+* B),
        ψ.Etale → ∀ (q₁ q₂ : Ideal B), q₁.IsPrime → q₂.IsPrime → q₁ < q₂ →
        Ideal.comap ψ q₁ < Ideal.comap ψ q₂ := by
      intro A B _ _ ψ hψ q₁ q₂ hq₁ hq₂ hq₁₂
      have _ : q₁.IsPrime := hq₁
      have _ : q₂.IsPrime := hq₂
      let _ : Algebra A B := ψ.toAlgebra
      have _ : Algebra.Etale A B := hψ.toAlgebra
      refine lt_of_le_of_ne (Ideal.comap_mono (le_of_lt hq₁₂)) fun hEq => ?_
      let x : PrimeSpectrum A := ⟨Ideal.comap ψ q₂, inferInstance⟩
      have hDisc : _root_.IsDiscrete ((PrimeSpectrum.comap (algebraMap A B)) ⁻¹' ({x} : Set (PrimeSpectrum A))) :=
        Algebra.QuasiFinite.isDiscrete_comap_preimage (R := A) (S := B)
          (s := ({x} : Set (PrimeSpectrum A))) Set.subsingleton_singleton.isDiscrete
      let F_x := (PrimeSpectrum.comap (algebraMap A B)) ⁻¹' ({x} : Set (PrimeSpectrum A))
      let y₁ : ↥F_x := ⟨⟨q₁, hq₁⟩, PrimeSpectrum.ext hEq⟩
      let y₂ : ↥F_x := ⟨⟨q₂, hq₂⟩, rfl⟩
      have hy₂_clB : (⟨q₂, hq₂⟩ : PrimeSpectrum B) ∈ closure ({⟨q₁, hq₁⟩} : Set (PrimeSpectrum B)) :=
        (PrimeSpectrum.le_iff_mem_closure ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩).mp (le_of_lt hq₁₂)
      have hy₂_clF : y₂ ∈ closure ({y₁} : Set ↥F_x) := by
        rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
        simpa [y₁, y₂] using hy₂_clB
      have _ : DiscreteTopology ↥F_x := hDisc.1
      have hClSing : IsClosed ({y₁} : Set ↥F_x) := isClosed_discrete _
      rw [hClSing.closure_eq, Set.mem_singleton_iff] at hy₂_clF
      exact (ne_of_lt hq₁₂) (congrArg (fun z : ↥F_x => z.1.asIdeal) hy₂_clF.symm)

    
    have hLiftMinToLoc : ∀ {A B : Type u} [CommRing A] [CommRing B] (ψ : A →+* B),
        ψ.Etale → ∀ (q₀ : Ideal B) [q₀.IsPrime] (m : Ideal A),
        m ∈ minimalPrimes A → m ≤ Ideal.comap ψ q₀ →
        ∃ M ∈ minimalPrimes (Localization.AtPrime q₀),
          Ideal.comap ((algebraMap B (Localization.AtPrime q₀)).comp ψ) M = m := by
      intro A B _ _ ψ hψ q₀ _ m hm hm_le
      have _ : m.IsPrime := hm.1.1
      obtain ⟨q, hq_le, _, hq_comap⟩ := hGoingDownLE ψ hψ q₀ m hm_le
      obtain ⟨q_tilde, hq_tilde_min, hq_tilde_le_q⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ q)
      have hq_tilde_prime : q_tilde.IsPrime := hq_tilde_min.1.1
      have hq_tilde_le_q₀ : q_tilde ≤ q₀ := hq_tilde_le_q.trans hq_le
      have hcomap_q_tilde : Ideal.comap ψ q_tilde = m := by
        have h_le : Ideal.comap ψ q_tilde ≤ m := by
          calc Ideal.comap ψ q_tilde ≤ Ideal.comap ψ q := Ideal.comap_mono hq_tilde_le_q
            _ = m := hq_comap
        exact le_antisymm h_le (hm.2 ⟨inferInstance, bot_le⟩ h_le)
      let L₀ := Localization.AtPrime q₀
      have hDisj : Disjoint (q₀.primeCompl : Set B) (q_tilde : Set B) := by
        rw [Set.disjoint_left]
        intro b hb_not hbq
        exact hb_not (hq_tilde_le_q₀ hbq)
      let M : Ideal L₀ := Ideal.map (algebraMap B L₀) q_tilde
      have hM_prime : M.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint q₀.primeCompl L₀ q_tilde hq_tilde_prime hDisj
      have hM_under : Ideal.comap (algebraMap B L₀) M = q_tilde :=
        IsLocalization.under_map_of_isPrime_disjoint q₀.primeCompl L₀ hq_tilde_prime hDisj
      have hM_min : M ∈ minimalPrimes L₀ := by
        refine ⟨⟨hM_prime, bot_le⟩, ?_⟩
        intro P ⟨hP_prime, _⟩ hPM
        have _ : P.IsPrime := hP_prime
        have hP_comap_le : Ideal.comap (algebraMap B L₀) P ≤ q_tilde :=
          hM_under ▸ Ideal.comap_mono hPM
        have hq_tilde_le_P : q_tilde ≤ Ideal.comap (algebraMap B L₀) P :=
          hq_tilde_min.2 ⟨inferInstance, bot_le⟩ hP_comap_le
        calc M = Ideal.map (algebraMap B L₀) q_tilde := rfl
          _ ≤ Ideal.map (algebraMap B L₀) (Ideal.comap (algebraMap B L₀) P) :=
              Ideal.map_mono hq_tilde_le_P
          _ = P := IsLocalization.map_comap q₀.primeCompl L₀ P
      refine ⟨M, hM_min, ?_⟩
      rw [← Ideal.comap_comap, hM_under, hcomap_q_tilde]

    refine ⟨?_, ?_⟩
    · 
      intro S _ _ _ φ_C hφC q₀ _
      refine ⟨?_, ?_, ?_⟩
      · obtain ⟨m_S, hmS_max, _⟩ := Ideal.exists_le_maximal q₀ (Ideal.IsPrime.ne_top inferInstance)
        have _ : m_S.IsMaximal := hmS_max
        have _ : Algebra.FiniteType (Polynomial K₀) S := inferInstance
        let _ : Algebra K₀ S := ((algebraMap (Polynomial K₀) S).comp Polynomial.C).toAlgebra
        have _ : IsScalarTower K₀ (Polynomial K₀) S := IsScalarTower.of_algebraMap_eq' rfl
        have hFT_S : Algebra.FiniteType K₀ S :=
          Algebra.FiniteType.trans (R := K₀) (S := Polynomial K₀) inferInstance inferInstance
        obtain ⟨d, Φ_mv, hΦ_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_S
        let M_mv : Ideal (MvPolynomial (Fin d) K₀) := Ideal.comap Φ_mv.toRingHom m_S
        have hM_max : M_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective Φ_mv.toRingHom hΦ_surj
        obtain ⟨x_pt, hx_pt⟩ :=
          MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM_max
        obtain ⟨P_X, hPX⟩ := hΦ_surj (algebraMap (Polynomial K₀) S Polynomial.X)
        let a₀ : K₀ := MvPolynomial.aeval x_pt P_X
        have hDiff_mem : P_X - MvPolynomial.C a₀ ∈ M_mv := by
          rw [hx_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
          simp [a₀]
        have hXa_mem : Polynomial.X - Polynomial.C a₀ ∈ Ideal.comap (algebraMap (Polynomial K₀) S) m_S := by
          change algebraMap (Polynomial K₀) S (Polynomial.X - Polynomial.C a₀) ∈ m_S
          have hCa : algebraMap (Polynomial K₀) S (Polynomial.C a₀) = Φ_mv (MvPolynomial.C a₀) := by
            change algebraMap K₀ S a₀ = Φ_mv (algebraMap K₀ _ a₀)
            exact (Φ_mv.commutes a₀).symm
          rw [map_sub, ← hPX, hCa, ← map_sub]
          exact hDiff_mem
        have hXa_ne : (Polynomial.X - Polynomial.C a₀ : Polynomial K₀) ≠ 0 :=
          Polynomial.X_sub_C_ne_zero a₀
        have hBotLt : (⊥ : Ideal (Polynomial K₀)) < Ideal.comap (algebraMap (Polynomial K₀) S) m_S :=
          lt_of_le_of_ne bot_le fun hEq => hXa_ne (Ideal.mem_bot.mp (hEq ▸ hXa_mem))
        have hEtAlg : (algebraMap (Polynomial K₀) S).Etale :=
          RingHom.etale_algebraMap.mpr inferInstance
        have _ : (⊥ : Ideal (Polynomial K₀)).IsPrime :=
          ⟨bot_ne_top, fun {x y} hxy =>
            (mul_eq_zero.mp (Ideal.mem_bot.mp hxy)).imp Ideal.mem_bot.mpr Ideal.mem_bot.mpr⟩
        obtain ⟨q₁, hq₁_le, hq₁_prime, hq₁_comap⟩ :=
          hGoingDownLE (algebraMap (Polynomial K₀) S) hEtAlg m_S
            (⊥ : Ideal (Polynomial K₀)) (le_of_lt hBotLt)
        have hq₁_lt : q₁ < m_S := lt_of_le_of_ne hq₁_le fun hEq =>
          (ne_of_lt hBotLt) (hq₁_comap.symm.trans (congrArg _ hEq))
        exact ⟨Ideal.comap φ_C q₁, Ideal.comap φ_C m_S,
          Ideal.IsPrime.comap φ_C, Ideal.IsPrime.comap φ_C,
          hStrictComap φ_C hφC q₁ m_S hq₁_prime inferInstance hq₁_lt⟩
      · intro p₂ p₁ hp₂ hp₁ hp₂₁ hp₁₀
        have _ : p₂.IsPrime := hp₂
        have _ : p₁.IsPrime := hp₁
        obtain ⟨q₁, hq₁_le, hq₁_prime, hq₁_comap⟩ :=
          hGoingDownLE φ_C hφC q₀ p₁ (le_of_lt hp₁₀)
        have _ : q₁.IsPrime := hq₁_prime
        have hq₁_lt : q₁ < q₀ := lt_of_le_of_ne hq₁_le fun hEq =>
          (ne_of_lt hp₁₀) (hq₁_comap.symm.trans (congrArg _ hEq))
        obtain ⟨q₂, hq₂_le, hq₂_prime, hq₂_comap⟩ :=
          hGoingDownLE φ_C hφC q₁ p₂ (hq₁_comap.symm ▸ le_of_lt hp₂₁)
        have hq₂_lt : q₂ < q₁ := lt_of_le_of_ne hq₂_le fun hEq =>
          (ne_of_lt hp₂₁) (hq₂_comap.symm.trans ((congrArg _ hEq).trans hq₁_comap))
        have hEtAlg : (algebraMap (Polynomial K₀) S).Etale :=
          RingHom.etale_algebraMap.mpr inferInstance
        have hr₂₁ := hStrictComap (algebraMap (Polynomial K₀) S) hEtAlg q₂ q₁ hq₂_prime hq₁_prime hq₂_lt
        have hr₁₀ := hStrictComap (algebraMap (Polynomial K₀) S) hEtAlg q₁ q₀ hq₁_prime inferInstance hq₁_lt
        have hr₁_ne_bot : Ideal.comap (algebraMap (Polynomial K₀) S) q₁ ≠ ⊥ :=
          fun hEq => not_lt_bot (hEq ▸ hr₂₁)
        have hr₁_max : (Ideal.comap (algebraMap (Polynomial K₀) S) q₁).IsMaximal :=
          Ideal.IsPrime.isMaximal inferInstance hr₁_ne_bot
        exact (ne_of_lt hr₁₀) (hr₁_max.eq_of_le (Ideal.IsPrime.ne_top inferInstance) (le_of_lt hr₁₀))
      · intro m₁ hm₁ m₂ hm₂ hm₁_le hm₂_le
        have _ : IsDomain (Localization.AtPrime q₀) := (hPolyDom S q₀).2
        have hBotPrime : (⊥ : Ideal (Localization.AtPrime q₀)).IsPrime :=
          ⟨bot_ne_top, fun {x y} hxy =>
            (mul_eq_zero.mp (Ideal.mem_bot.mp hxy)).imp Ideal.mem_bot.mpr Ideal.mem_bot.mpr⟩
        obtain ⟨M₁, hM₁_min, hM₁_eq⟩ := hLiftMinToLoc φ_C hφC q₀ m₁ hm₁ hm₁_le
        obtain ⟨M₂, hM₂_min, hM₂_eq⟩ := hLiftMinToLoc φ_C hφC q₀ m₂ hm₂ hm₂_le
        have hM₁_bot : M₁ = ⊥ := le_bot_iff.mp (hM₁_min.2 ⟨hBotPrime, bot_le⟩ bot_le)
        have hM₂_bot : M₂ = ⊥ := le_bot_iff.mp (hM₂_min.2 ⟨hBotPrime, bot_le⟩ bot_le)
        rw [← hM₁_eq, ← hM₂_eq, hM₁_bot, hM₂_bot]

    · 
      intro R' S _ _ _ _ h φ_C φ_Q hφC hφQ q₀ _ hXi hCh
      obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e₁_R', hFinAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀ R').mp inferInstance
      have hEquivAi : ∀ i : I, Nonempty (Ai i ≃+* K₀) ∧
          ∃ e_i : Ai i ≃+* K₀, ∀ c : K₀, e_i (@algebraMap K₀ (Ai i) _ _ (hAlgAi i) c) = c := by
        intro i
        let _ : Field (Ai i) := hFieldAi i
        let _ : Algebra K₀ (Ai i) := hAlgAi i
        have _ : Module.Finite K₀ (Ai i) := (hFinAi i).1
        have _ : Algebra.IsIntegral K₀ (Ai i) := Algebra.IsIntegral.of_finite K₀ (Ai i)
        let e_k : K₀ ≃+* Ai i := RingEquiv.ofBijective (algebraMap K₀ (Ai i))
          (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K₀) (K := Ai i))
        exact ⟨⟨e_k.symm⟩, e_k.symm, fun c => e_k.symm_apply_apply c⟩
      choose e_Ai he_Ai using fun i => (hEquivAi i).2
      let e_pi : (∀ i : I, Ai i) ≃ₐ[K₀] (I → K₀) :=
        { toFun := fun f i => e_Ai i (f i)
          invFun := fun g i => (e_Ai i).symm (g i)
          left_inv := fun f => funext fun i => (e_Ai i).symm_apply_apply (f i)
          right_inv := fun g => funext fun i => (e_Ai i).apply_symm_apply (g i)
          map_mul' := fun f g => funext fun i => map_mul (e_Ai i) (f i) (g i)
          map_add' := fun f g => funext fun i => map_add (e_Ai i) (f i) (g i)
          commutes' := fun c => funext fun i => he_Ai i c }
      let e_prod : R' ≃ₐ[K₀] (I → K₀) := e₁_R'.trans e_pi
      let J_nod : Ideal (MvPolynomial (Fin 2) R') :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
      let Q_R' := MvPolynomial (Fin 2) R' ⧸ J_nod
      let c_R' : R' →+* S := φ_Q.comp ((Ideal.Quotient.mk J_nod).comp MvPolynomial.C)
      let p_R' : Ideal R' := Ideal.comap c_R' q₀
      have _ : p_R'.IsPrime := Ideal.IsPrime.comap c_R'
      let p_pi : Ideal (I → K₀) := Ideal.comap e_prod.symm.toRingHom p_R'
      have hp_pi_prime : p_pi.IsPrime := Ideal.IsPrime.comap e_prod.symm.toRingHom
      obtain ⟨i₀, q_i₀, hq_i₀_eq⟩ :=
        PrimeSpectrum.exists_comap_evalRingHom_eq ⟨p_pi, hp_pi_prime⟩
      have hq_i₀_bot : q_i₀.asIdeal = ⊥ := eq_bot_iff.mpr fun x hx => by
        by_contra hx0
        exact q_i₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (isUnit_iff_ne_zero.mpr hx0))
      have hp_R'_iff : ∀ r : R', r ∈ p_R' ↔ e_prod r i₀ = 0 := by
        intro r
        have h1 : p_pi = Ideal.comap (Pi.evalRingHom (fun _ : I => K₀) i₀) ⊥ := by
          have h2 : p_pi = Ideal.comap (Pi.evalRingHom (fun _ : I => K₀) i₀) q_i₀.asIdeal :=
            (congrArg PrimeSpectrum.asIdeal hq_i₀_eq).symm
          rwa [hq_i₀_bot] at h2
        have hr : e_prod r ∈ p_pi ↔ r ∈ p_R' := by
          simp [p_pi]
        rw [← hr, h1, Ideal.mem_comap, Pi.evalRingHom_apply, Ideal.mem_bot]
      let π_i₀ : R' →+* K₀ := (Pi.evalRingHom (fun _ : I => K₀) i₀).comp e_prod.toRingHom
      let _ : DecidableEq I := Classical.decEq I
      let e₀ : R' := e_prod.symm (Pi.single i₀ 1)
      have he₀_eval : e_prod e₀ = Pi.single i₀ 1 := e_prod.apply_symm_apply _
      have hπ_e₀ : π_i₀ e₀ = 1 := by
        change e_prod e₀ i₀ = 1
        rw [he₀_eval, Pi.single_eq_same]
      have he₀_idem : e₀ * (1 - e₀) = 0 := e_prod.injective (by
        rw [map_mul, map_sub, map_one, map_zero, he₀_eval]
        ext j
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply]
        by_cases hj : j = i₀
        · subst hj; simp
        · simp [hj])
      have h1_sub_e₀_mem : 1 - e₀ ∈ p_R' := by
        rw [hp_R'_iff, map_sub, map_one]
        change 1 - π_i₀ e₀ = 0
        rw [hπ_e₀, sub_self]
      have hr_mod_e₀ : ∀ r : R', r - algebraMap K₀ R' (π_i₀ r) ∈ Ideal.span {1 - e₀} := by
        intro r
        rw [Ideal.mem_span_singleton]
        refine ⟨r - algebraMap K₀ R' (π_i₀ r), e_prod.injective ?_⟩
        rw [map_mul, map_sub, map_sub, map_one, he₀_eval, e_prod.commutes]
        ext j
        simp only [Pi.sub_apply, Pi.mul_apply, Pi.one_apply]
        by_cases hj : j = i₀
        · subst hj; simp [π_i₀]
        · simp [hj]
      have hπ_h : π_i₀ h = 0 := (hp_R'_iff h).mp hCh
      have hh_span : h ∈ Ideal.span {1 - e₀} := by
        have h1 := hr_mod_e₀ h
        rwa [hπ_h, map_zero, sub_zero] at h1

      let ε_Q : Q_R' := Ideal.Quotient.mk J_nod (MvPolynomial.C e₀)
      let ε_S : S := φ_Q ε_Q
      have hεQ_idem : ε_Q * (1 - ε_Q) = 0 := by
        change Ideal.Quotient.mk J_nod (MvPolynomial.C e₀) *
          (1 - Ideal.Quotient.mk J_nod (MvPolynomial.C e₀)) = 0
        rw [← map_one (Ideal.Quotient.mk J_nod), ← map_one MvPolynomial.C, ← map_sub, ← map_sub,
          ← map_mul, ← map_mul, he₀_idem, map_zero, map_zero]
      have hεS_idem : ε_S * (1 - ε_S) = 0 := by
        change φ_Q ε_Q * (1 - φ_Q ε_Q) = 0
        rw [← map_one φ_Q, ← map_sub, ← map_mul, hεQ_idem, map_zero]
      have h1_sub_εS_mem : 1 - ε_S ∈ q₀ := by
        have hm : c_R' (1 - e₀) ∈ q₀ := h1_sub_e₀_mem
        simpa [c_R', ε_S, ε_Q] using hm
      letI : CommRing Q_R' := Ideal.Quotient.commRing J_nod
      have h1_sub_ε_map : φ_Q (1 - ε_Q) = 1 - ε_S := by
        rw [map_sub, map_one]
      obtain ⟨Q₀, S₀, instQ₀, instS₀, μ_Q, μ_S, φ_Q0,
          hμQ_surj, hμQ_ker, hμS_surj, hμS_ker, hφQ0_comm, hφQ0_etale, hLift_Q₀, _⟩ :=
        @hPrincipalQuotEtale Q_R' S (Ideal.Quotient.commRing J_nod) inferInstance φ_Q hφQ (1 - ε_Q)
      letI : CommRing Q₀ := instQ₀
      letI : CommRing S₀ := instS₀
      have hμS_ker' : ∀ y : S, μ_S y = 0 ↔ y ∈ Ideal.span {1 - ε_S} := by
        intro y
        rw [hμS_ker y, h1_sub_ε_map]
      have hμS_loc : @IsLocalization.Away S _ ε_S S₀ _ μ_S.toAlgebra := by
        let _ : Algebra S S₀ := μ_S.toAlgebra
        have hμ_ε : μ_S ε_S = 1 := by
          have h0 : μ_S (1 - ε_S) = 0 := (hμS_ker' (1 - ε_S)).mpr (Ideal.mem_span_singleton_self _)
          rw [map_sub, map_one, sub_eq_zero] at h0
          exact h0.symm
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · rintro ⟨_, n, rfl⟩
          change IsUnit (μ_S (ε_S ^ n))
          rw [map_pow, hμ_ε, one_pow]
          exact isUnit_one
        · intro z
          obtain ⟨a, rfl⟩ := hμS_surj z
          refine ⟨⟨a, ⟨1, 0, pow_zero ε_S⟩⟩, ?_⟩
          change μ_S a * μ_S 1 = μ_S a
          rw [map_one, mul_one]
        · intro a b hab
          have hab' : μ_S a = μ_S b := hab
          have hmem : a - b ∈ Ideal.span {1 - ε_S} := (hμS_ker' (a - b)).mp (by
            rw [map_sub, hab', sub_self])
          obtain ⟨t, ht⟩ := Ideal.mem_span_singleton.mp hmem
          refine ⟨⟨ε_S, 1, pow_one ε_S⟩, ?_⟩
          dsimp only
          rw [← sub_eq_zero, ← mul_sub, ht, ← mul_assoc, hεS_idem, zero_mul]
      have hμS_etale : μ_S.Etale := by
        let _ : Algebra S S₀ := μ_S.toAlgebra
        have _ : IsLocalization.Away ε_S S₀ := hμS_loc
        have hEt : Algebra.Etale S S₀ := Algebra.Etale.of_isLocalizationAway ε_S
        exact RingHom.etale_algebraMap.mpr hEt
      let ψ_C0 : R_C →+* S₀ := μ_S.comp φ_C
      have hψC0_etale : ψ_C0.Etale := hEtaleComp hφC hμS_etale
      have hker_μS : RingHom.ker μ_S ≤ q₀ := by
        intro y hy
        have hy' : y ∈ Ideal.span {1 - ε_S} := (hμS_ker' y).mp hy
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr h1_sub_εS_mem) hy'
      let q_bar₀ : Ideal S₀ := Ideal.map μ_S q₀
      have hq_bar₀_prime : q_bar₀.IsPrime :=
        Ideal.map_isPrime_of_surjective hμS_surj hker_μS
      have hq_bar₀_comap_μS : Ideal.comap μ_S q_bar₀ = q₀ := by
        rw [Ideal.comap_map_of_surjective' μ_S hμS_surj q₀, sup_eq_left.mpr hker_μS]
      have hq_bar₀_comap_C : Ideal.comap ψ_C0 q_bar₀ = Ideal.comap φ_C q₀ := by
        rw [← Ideal.comap_comap, hq_bar₀_comap_μS]

      let x_bar : Fin 2 → Q₀ := fun i => μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X i))
      have hx_bar_mul : x_bar 0 * x_bar 1 = 0 := by
        change μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X 0)) *
          μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X 1)) = 0
        rw [← map_mul, ← map_mul]
        have hrel : Ideal.Quotient.mk J_nod (MvPolynomial.X 0 * MvPolynomial.X 1) =
            Ideal.Quotient.mk J_nod (MvPolynomial.C h) := by
          rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self _
        rw [hrel]
        obtain ⟨r_h, hr_h⟩ := Ideal.mem_span_singleton.mp hh_span
        have hCh_eq : Ideal.Quotient.mk J_nod (MvPolynomial.C h) =
            (1 - ε_Q) * Ideal.Quotient.mk J_nod (MvPolynomial.C r_h) := by
          rw [hr_h, map_mul, map_sub, map_one, map_mul, map_sub, map_one]
        rw [hCh_eq, hμQ_ker]
        exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
      let s_br : Fin 2 → S₀ := fun i => φ_Q0 (x_bar i)
      have hs_mem : ∀ i : Fin 2, s_br i ∈ q_bar₀ := by
        intro i
        change φ_Q0 (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X i))) ∈ q_bar₀
        rw [hφQ0_comm]
        exact Ideal.mem_map_of_mem μ_S (hXi i)
      have hs_mul : s_br 0 * s_br 1 = 0 := by
        change φ_Q0 (x_bar 0) * φ_Q0 (x_bar 1) = 0
        rw [← map_mul, hx_bar_mul, map_zero]
      have hBranchData : ∀ b : Fin 2,
          ∃ (Q_b S_b : Type u) (instQb : CommRing Q_b) (instSb : CommRing S_b),
            letI : CommRing Q_b := instQb
            letI : CommRing S_b := instSb
            ∃ (mk_Qb : Q₀ →+* Q_b) (mk_Sb : S₀ →+* S_b) (φ_Qb : Q_b →+* S_b)
              (α_b : Q_b ≃+* Polynomial K₀),
              Function.Surjective mk_Qb ∧
              (∀ q : Q₀, mk_Qb q = 0 ↔ q ∈ Ideal.span {x_bar b}) ∧
              Function.Surjective mk_Sb ∧
              (∀ s : S₀, mk_Sb s = 0 ↔ s ∈ Ideal.span {s_br b}) ∧
              (∀ q : Q₀, φ_Qb (mk_Qb q) = mk_Sb (φ_Q0 q)) ∧
              φ_Qb.Etale ∧
              (∀ {D : Type u} [CommRing D] (g : S₀ →+* D),
                Ideal.span {s_br b} ≤ RingHom.ker g →
                ∃ g' : S_b →+* D, ∀ s : S₀, g' (mk_Sb s) = g s) ∧
              α_b (mk_Qb (x_bar (1 - b))) = Polynomial.X := by
        intro b
        obtain ⟨Q_b, S_b, instQb, instSb, mk_Qb, mk_Sb, φ_Qb,
            hmkQb_surj, hmkQb_ker, hmkSb_surj, hmkSb_ker, hφQb_comm, hφQb_etale, hLift_Qb, hLift_Sb⟩ :=
          hPrincipalQuotEtale φ_Q0 hφQ0_etale (x_bar b)
        letI : CommRing Q_b := instQb
        letI : CommRing S_b := instSb
        let v_b : Fin 2 → Polynomial K₀ := fun j => if j = b then 0 else Polynomial.X
        let F₀ : MvPolynomial (Fin 2) R' →+* Polynomial K₀ :=
          MvPolynomial.eval₂Hom (Polynomial.C.comp π_i₀) v_b
        have hF₀_J : J_nod ≤ RingHom.ker F₀ := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
            map_sub, map_mul]
          dsimp [F₀]
          rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X, MvPolynomial.eval₂_C,
            RingHom.comp_apply, hπ_h, map_zero, sub_zero]
          fin_cases b <;> simp [v_b]
        let F₁_raw := Ideal.Quotient.lift J_nod F₀ (fun p hp => hF₀_J hp)
        let F₁ : @RingHom Q_R' (Polynomial K₀)
            (Ideal.Quotient.commRing J_nod).toCommSemiring.toSemiring.toNonAssocSemiring _ :=
          { toFun := F₁_raw, map_one' := F₁_raw.map_one, map_mul' := F₁_raw.map_mul,
            map_zero' := F₁_raw.map_zero, map_add' := F₁_raw.map_add }
        have hF₁_IQ : Ideal.span {1 - ε_Q} ≤ RingHom.ker F₁ := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
            map_sub, map_one]
          change 1 - F₀ (MvPolynomial.C e₀) = 0
          dsimp [F₀]
          rw [MvPolynomial.eval₂_C, RingHom.comp_apply, hπ_e₀, map_one, sub_self]
        obtain ⟨F₂, hF₂_eq⟩ := hLift_Q₀ F₁ hF₁_IQ
        have hF₂_xb : Ideal.span {x_bar b} ≤ RingHom.ker F₂ := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          change F₂ (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X b))) = 0
          rw [hF₂_eq]
          change F₀ (MvPolynomial.X b) = 0
          dsimp [F₀, v_b]
          rw [MvPolynomial.eval₂_X, if_pos rfl]
        obtain ⟨toPoly, htoPoly_eq⟩ := hLift_Qb F₂ hF₂_xb
        let c_R'_Q0 : R' →+* Q₀ := μ_Q.comp
          ({ toFun := (Ideal.Quotient.mk J_nod).comp MvPolynomial.C
             map_one' := by simp
             map_mul' := by intro x y; simp
             map_zero' := by simp
             map_add' := by intro x y; simp })
        let c_K₀ : K₀ →+* Q_b := mk_Qb.comp (c_R'_Q0.comp (algebraMap K₀ R'))
        let fromPoly : Polynomial K₀ →+* Q_b :=
          Polynomial.eval₂RingHom c_K₀ (mk_Qb (x_bar (1 - b)))
        have h_1_sub_ne : (1 - b : Fin 2) ≠ b := by
          match b with
          | ⟨0, _⟩ => intro hEq; exact Nat.one_ne_zero (congrArg Fin.val hEq)
          | ⟨1, _⟩ => intro hEq; exact Nat.zero_ne_one (congrArg Fin.val hEq)
        have h_right : toPoly.comp fromPoly = RingHom.id (Polynomial K₀) := by
          apply Polynomial.ringHom_ext
          · intro c
            change toPoly (fromPoly (Polynomial.C c)) = Polynomial.C c
            dsimp [fromPoly]
            rw [Polynomial.eval₂_C]
            change toPoly (mk_Qb (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.C (algebraMap K₀ R' c))))) = _
            rw [htoPoly_eq, hF₂_eq]
            change F₀ (MvPolynomial.C (algebraMap K₀ R' c)) = Polynomial.C c
            dsimp [F₀]
            rw [MvPolynomial.eval₂_C, RingHom.comp_apply]
            congr 1
            change e_prod (algebraMap K₀ R' c) i₀ = c
            rw [e_prod.commutes]
            rfl
          · change toPoly (fromPoly Polynomial.X) = Polynomial.X
            dsimp [fromPoly]
            rw [Polynomial.eval₂_X, htoPoly_eq]
            change F₂ (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X (1 - b)))) = Polynomial.X
            rw [hF₂_eq]
            change F₀ (MvPolynomial.X (1 - b)) = Polynomial.X
            dsimp [F₀, v_b]
            rw [MvPolynomial.eval₂_X, if_neg h_1_sub_ne]
        have h_left : fromPoly.comp toPoly = RingHom.id Q_b := by
          ext z
          obtain ⟨q_z, rfl⟩ := hmkQb_surj z
          obtain ⟨p_z, rfl⟩ := hμQ_surj q_z
          obtain ⟨P_mv, rfl⟩ := Ideal.Quotient.mk_surjective p_z
          let lhsHom : MvPolynomial (Fin 2) R' →+* Q_b :=
            fromPoly.comp F₀
          let rhsHom : MvPolynomial (Fin 2) R' →+* Q_b :=
            mk_Qb.comp (μ_Q.comp
              { toFun := Ideal.Quotient.mk J_nod
                map_one' := map_one _
                map_mul' := map_mul _
                map_zero' := map_zero _
                map_add' := map_add _ })
          suffices hEqHom : lhsHom = rhsHom by
            change fromPoly (toPoly (mk_Qb (μ_Q (Ideal.Quotient.mk J_nod P_mv)))) =
              mk_Qb (μ_Q (Ideal.Quotient.mk J_nod P_mv))
            rw [htoPoly_eq, hF₂_eq]
            exact congrFun (congrArg DFunLike.coe hEqHom) P_mv
          apply MvPolynomial.ringHom_ext'
          · ext r
            change fromPoly (F₀ (MvPolynomial.C r)) =
              mk_Qb (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.C r)))
            dsimp [F₀]
            rw [MvPolynomial.eval₂_C, RingHom.comp_apply]
            dsimp [fromPoly]
            rw [Polynomial.eval₂_C]
            change mk_Qb (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.C (algebraMap K₀ R' (π_i₀ r))))) = _
            congr 1
            rw [eq_comm, ← sub_eq_zero, ← map_sub, ← map_sub, ← map_sub, hμQ_ker]
            obtain ⟨t_r, ht_r⟩ := Ideal.mem_span_singleton.mp (hr_mod_e₀ r)
            rw [ht_r, map_mul, map_sub, map_one, map_mul, map_sub, map_one]
            exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
          · intro j
            change fromPoly (F₀ (MvPolynomial.X j)) = mk_Qb (x_bar j)
            dsimp [F₀, v_b]
            rw [MvPolynomial.eval₂_X]
            by_cases hjb : j = b
            · subst hjb
              rw [if_pos rfl, map_zero, eq_comm, hmkQb_ker]
              exact Ideal.mem_span_singleton_self _
            · rw [if_neg hjb]
              dsimp [fromPoly]
              rw [Polynomial.eval₂_X]
              have hj_eq : (1 - b : Fin 2) = j := by
                match b, j with
                | ⟨0, _⟩, ⟨0, _⟩ => exact absurd rfl hjb
                | ⟨0, _⟩, ⟨1, _⟩ => rfl
                | ⟨1, _⟩, ⟨0, _⟩ => rfl
                | ⟨1, _⟩, ⟨1, _⟩ => exact absurd rfl hjb
              rw [hj_eq]
        refine ⟨Q_b, S_b, instQb, instSb, mk_Qb, mk_Sb, φ_Qb,
          { toFun := toPoly
            invFun := fromPoly
            left_inv := fun z => congrFun (congrArg DFunLike.coe h_left) z
            right_inv := fun p => congrFun (congrArg DFunLike.coe h_right) p
            map_mul' := toPoly.map_mul
            map_add' := toPoly.map_add },
          hmkQb_surj, hmkQb_ker, hmkSb_surj, hmkSb_ker, hφQb_comm, hφQb_etale, hLift_Sb, ?_⟩
        change toPoly (mk_Qb (x_bar (1 - b))) = Polynomial.X
        rw [htoPoly_eq]
        change F₂ (μ_Q (Ideal.Quotient.mk J_nod (MvPolynomial.X (1 - b)))) = Polynomial.X
        rw [hF₂_eq]
        change F₀ (MvPolynomial.X (1 - b)) = Polynomial.X
        dsimp [F₀, v_b]
        rw [MvPolynomial.eval₂_X, if_neg h_1_sub_ne]

      refine ⟨?_, ?_, ?_⟩
      · obtain ⟨Q_0, _, instQ0, _, mk_Q0, _, _, α₀, _, hmkQ0_ker, _, _, _, _, _, hα₀_X⟩ :=
          hBranchData 0
        letI : CommRing Q_0 := instQ0
        let r₁ : Ideal Q₀ := Ideal.span {x_bar 0}
        let π_0 : Q₀ →+* Polynomial K₀ := α₀.toRingHom.comp mk_Q0
        have hr₁_eq_ker : r₁ = RingHom.ker π_0 := by
          ext q
          change q ∈ r₁ ↔ α₀ (mk_Q0 q) = 0
          rw [map_eq_zero_iff α₀ α₀.injective, hmkQ0_ker]
        have hr₁_prime : r₁.IsPrime := hr₁_eq_ker ▸ RingHom.ker_isPrime π_0
        let r₀ : Ideal Q₀ := Ideal.comap φ_Q0 q_bar₀
        have hr₀_prime : r₀.IsPrime := Ideal.IsPrime.comap φ_Q0
        have hr₁_le_r₀ : r₁ ≤ r₀ :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hs_mem 0))
        have hx_bar₁_not_r₁ : x_bar 1 ∉ r₁ := by
          intro hmem
          have hmem_ker : x_bar (1 - 0) ∈ RingHom.ker π_0 := hr₁_eq_ker ▸ hmem
          have hX0 : π_0 (x_bar (1 - 0)) = 0 := RingHom.mem_ker.mp hmem_ker
          change α₀ (mk_Q0 (x_bar (1 - 0))) = 0 at hX0
          rw [hα₀_X] at hX0
          exact Polynomial.X_ne_zero hX0
        have hr₁_lt_r₀ : r₁ < r₀ :=
          lt_of_le_of_ne hr₁_le_r₀ fun hEq => hx_bar₁_not_r₁ (hEq.symm ▸ hs_mem 1)
        obtain ⟨q_bar₁, hq_bar₁_le, hq_bar₁_prime, hq_bar₁_comap⟩ :=
          hGoingDownLE φ_Q0 hφQ0_etale q_bar₀ r₁ hr₁_le_r₀
        have hq_bar₁_lt : q_bar₁ < q_bar₀ := lt_of_le_of_ne hq_bar₁_le fun hEq =>
          (ne_of_lt hr₁_lt_r₀) (hq_bar₁_comap.symm.trans (congrArg _ hEq))
        exact ⟨Ideal.comap ψ_C0 q_bar₁, Ideal.comap ψ_C0 q_bar₀,
          Ideal.IsPrime.comap ψ_C0, Ideal.IsPrime.comap ψ_C0,
          hStrictComap ψ_C0 hψC0_etale q_bar₁ q_bar₀ hq_bar₁_prime hq_bar₀_prime hq_bar₁_lt⟩
      · intro p₂ p₁ hp₂ hp₁ hp₂₁ hp₁₀
        rw [← hq_bar₀_comap_C] at hp₁₀
        have _ : p₂.IsPrime := hp₂
        have _ : p₁.IsPrime := hp₁
        obtain ⟨q_bar₁, hq_bar₁_le, hq_bar₁_prime, hq_bar₁_comap⟩ :=
          hGoingDownLE ψ_C0 hψC0_etale q_bar₀ p₁ (le_of_lt hp₁₀)
        have _ : q_bar₁.IsPrime := hq_bar₁_prime
        have hq_bar₁_lt : q_bar₁ < q_bar₀ := lt_of_le_of_ne hq_bar₁_le fun hEq =>
          (ne_of_lt hp₁₀) (hq_bar₁_comap.symm.trans (congrArg _ hEq))
        obtain ⟨q_bar₂, hq_bar₂_le, hq_bar₂_prime, hq_bar₂_comap⟩ :=
          hGoingDownLE ψ_C0 hψC0_etale q_bar₁ p₂ (hq_bar₁_comap.symm ▸ le_of_lt hp₂₁)
        have hq_bar₂_lt : q_bar₂ < q_bar₁ := lt_of_le_of_ne hq_bar₂_le fun hEq =>
          (ne_of_lt hp₂₁) (hq_bar₂_comap.symm.trans ((congrArg _ hEq).trans hq_bar₁_comap))
        have hr₂₁ := hStrictComap φ_Q0 hφQ0_etale q_bar₂ q_bar₁ hq_bar₂_prime hq_bar₁_prime hq_bar₂_lt
        have hr₁₀ := hStrictComap φ_Q0 hφQ0_etale q_bar₁ q_bar₀ hq_bar₁_prime hq_bar₀_prime hq_bar₁_lt
        let r₂ := Ideal.comap φ_Q0 q_bar₂
        let r₁ := Ideal.comap φ_Q0 q_bar₁
        let r₀ := Ideal.comap φ_Q0 q_bar₀
        have _ : q_bar₂.IsPrime := hq_bar₂_prime
        have hr₂_prime : r₂.IsPrime := Ideal.IsPrime.comap φ_Q0
        have hr₁_prime : r₁.IsPrime := Ideal.IsPrime.comap φ_Q0
        have hr₀_prime : r₀.IsPrime := Ideal.IsPrime.comap φ_Q0
        have hxb_mem : ∃ b : Fin 2, x_bar b ∈ r₂ := by
          have h0 : x_bar 0 * x_bar 1 ∈ r₂ := hx_bar_mul ▸ r₂.zero_mem
          rcases hr₂_prime.mem_or_mem h0 with h0_in | h1_in
          · exact ⟨0, h0_in⟩
          · exact ⟨1, h1_in⟩
        obtain ⟨b, hxb_r₂⟩ := hxb_mem
        obtain ⟨Q_b, _, instQb, _, mk_Qb, _, _, α_b, hmkQb_surj, hmkQb_ker, _, _, _, _, _, _⟩ :=
          hBranchData b
        letI : CommRing Q_b := instQb
        let π_b : Q₀ →+* Polynomial K₀ := α_b.toRingHom.comp mk_Qb
        have hπb_surj : Function.Surjective π_b := α_b.surjective.comp hmkQb_surj
        have hker_πb : RingHom.ker π_b ≤ r₂ := by
          have hk : RingHom.ker π_b = Ideal.span {x_bar b} := by
            ext y
            change α_b (mk_Qb y) = 0 ↔ y ∈ Ideal.span {x_bar b}
            rw [map_eq_zero_iff α_b α_b.injective, hmkQb_ker]
          rw [hk]
          exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxb_r₂)
        let u₂ := Ideal.map π_b r₂
        let u₁ := Ideal.map π_b r₁
        let u₀ := Ideal.map π_b r₀
        have hu₁_prime : u₁.IsPrime :=
          Ideal.map_isPrime_of_surjective hπb_surj (hker_πb.trans (le_of_lt hr₂₁))
        have hu₀_prime : u₀.IsPrime :=
          Ideal.map_isPrime_of_surjective hπb_surj
            (hker_πb.trans ((le_of_lt hr₂₁).trans (le_of_lt hr₁₀)))
        have hu₂₁ : u₂ < u₁ := lt_of_le_of_ne (Ideal.map_mono (le_of_lt hr₂₁)) fun hEq => by
          apply ne_of_lt hr₂₁
          have hc₂ := Ideal.comap_map_of_surjective' π_b hπb_surj r₂
          have hc₁ := Ideal.comap_map_of_surjective' π_b hπb_surj r₁
          rw [sup_eq_left.mpr hker_πb] at hc₂
          rw [sup_eq_left.mpr (hker_πb.trans (le_of_lt hr₂₁))] at hc₁
          exact hc₂.symm.trans ((congrArg (Ideal.comap π_b) hEq).trans hc₁)
        have hu₁₀ : u₁ < u₀ := lt_of_le_of_ne (Ideal.map_mono (le_of_lt hr₁₀)) fun hEq => by
          apply ne_of_lt hr₁₀
          have hc₁ := Ideal.comap_map_of_surjective' π_b hπb_surj r₁
          have hc₀ := Ideal.comap_map_of_surjective' π_b hπb_surj r₀
          rw [sup_eq_left.mpr (hker_πb.trans (le_of_lt hr₂₁))] at hc₁
          rw [sup_eq_left.mpr (hker_πb.trans ((le_of_lt hr₂₁).trans (le_of_lt hr₁₀)))] at hc₀
          exact hc₁.symm.trans ((congrArg (Ideal.comap π_b) hEq).trans hc₀)
        have hu₁_ne_bot : u₁ ≠ ⊥ := fun hEq => not_lt_bot (hEq ▸ hu₂₁)
        have hu₁_max : u₁.IsMaximal := Ideal.IsPrime.isMaximal hu₁_prime hu₁_ne_bot
        exact (ne_of_lt hu₁₀) (hu₁_max.eq_of_le hu₀_prime.ne_top (le_of_lt hu₁₀))
      · intro m₁ hm₁ m₂ hm₂ m₃ hm₃ hm₁_le hm₂_le hm₃_le
        rw [← hq_bar₀_comap_C] at hm₁_le hm₂_le hm₃_le
        let L₀ := Localization.AtPrime q_bar₀
        let s_tilde : Fin 2 → L₀ := fun b => algebraMap S₀ L₀ (s_br b)
        have hs_tilde_mul : s_tilde 0 * s_tilde 1 = 0 := by
          change algebraMap S₀ L₀ (s_br 0) * algebraMap S₀ L₀ (s_br 1) = 0
          rw [← map_mul, hs_mul, map_zero]
        have hPb_prime : ∀ b : Fin 2, (Ideal.span {s_tilde b} : Ideal L₀).IsPrime := by
          intro b
          obtain ⟨Q_b, S_b, instQb, instSb, _, mk_Sb, φ_Qb, α_b,
              _, _, hmkSb_surj, hmkSb_ker, _, hφQb_etale, hLift_Sb, _⟩ :=
            hBranchData b
          letI : CommRing Q_b := instQb
          letI : CommRing S_b := instSb
          have hα_symm_etale : α_b.symm.toRingHom.Etale :=
            RingHom.Etale.of_bijective α_b.symm.bijective
          let g_poly : Polynomial K₀ →+* S_b := φ_Qb.comp α_b.symm.toRingHom
          have hg_etale : g_poly.Etale := hEtaleComp hα_symm_etale hφQb_etale
          let _ : Algebra (Polynomial K₀) S_b := g_poly.toAlgebra
          have _ : Algebra.Etale (Polynomial K₀) S_b := hg_etale.toAlgebra
          have hker_mkSb : RingHom.ker mk_Sb ≤ q_bar₀ := by
            intro s hs
            have hs' : s ∈ Ideal.span {s_br b} := (hmkSb_ker s).mp hs
            exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hs_mem b)) hs'
          let q_bar_b : Ideal S_b := Ideal.map mk_Sb q_bar₀
          have hq_bar_b_prime : q_bar_b.IsPrime :=
            Ideal.map_isPrime_of_surjective hmkSb_surj hker_mkSb
          have hq_bar_b_comap : Ideal.comap mk_Sb q_bar_b = q_bar₀ := by
            rw [Ideal.comap_map_of_surjective' mk_Sb hmkSb_surj q_bar₀,
              sup_eq_left.mpr hker_mkSb]
          have _ : IsDomain (Localization.AtPrime q_bar_b) := (hPolyDom S_b q_bar_b).2
          let ρ₀ : S₀ →+* Localization.AtPrime q_bar_b :=
            (algebraMap S_b (Localization.AtPrime q_bar_b)).comp mk_Sb
          have hρ₀_units : ∀ y : q_bar₀.primeCompl, IsUnit (ρ₀ y) := by
            rintro ⟨y, hy⟩
            have hy_b : mk_Sb y ∉ q_bar_b := fun hin => hy (hq_bar_b_comap ▸ hin)
            exact IsLocalization.map_units (Localization.AtPrime q_bar_b)
              (⟨mk_Sb y, hy_b⟩ : q_bar_b.primeCompl)
          let ρ₁ : L₀ →+* Localization.AtPrime q_bar_b := IsLocalization.lift hρ₀_units
          let π_L : L₀ →+* (L₀ ⧸ Ideal.span {s_tilde b}) :=
            Ideal.Quotient.mk (Ideal.span {s_tilde b})
          have hρ₁_ker : Ideal.span {s_tilde b} ≤ RingHom.ker ρ₁ := by
            rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
            change ρ₁ (algebraMap S₀ L₀ (s_br b)) = 0
            rw [IsLocalization.lift_eq, RingHom.comp_apply]
            have h0 : mk_Sb (s_br b) = 0 :=
              (hmkSb_ker (s_br b)).mpr (Ideal.mem_span_singleton_self _)
            rw [h0, map_zero]
          letI : CommRing (L₀ ⧸ Ideal.span {s_tilde b}) := Ideal.Quotient.commRing _
          have hSb_ker : Ideal.span {s_br b} ≤ RingHom.ker (π_L.comp (algebraMap S₀ L₀)) := by
            rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
              RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mem_span_singleton_self _
          obtain ⟨σ₀, hσ₀_eq⟩ := hLift_Sb (π_L.comp (algebraMap S₀ L₀)) hSb_ker
          have hσ₀_units : ∀ y : q_bar_b.primeCompl, IsUnit (σ₀ y) := by
            rintro ⟨y, hy⟩
            obtain ⟨y₀, rfl⟩ := hmkSb_surj y
            have hy₀ : y₀ ∉ q_bar₀ := fun hin => hy (Ideal.mem_map_of_mem mk_Sb hin)
            rw [hσ₀_eq]
            exact (IsLocalization.map_units L₀ (⟨y₀, hy₀⟩ : q_bar₀.primeCompl)).map π_L
          let fromLocB : Localization.AtPrime q_bar_b →+* (L₀ ⧸ Ideal.span {s_tilde b}) :=
            IsLocalization.lift hσ₀_units
          have hker_ρ₁_eq : Ideal.span {s_tilde b} = RingHom.ker ρ₁ := by
            refine le_antisymm hρ₁_ker fun x hx => ?_
            have hcomp : fromLocB.comp ρ₁ = π_L := by
              apply IsLocalization.ringHom_ext q_bar₀.primeCompl
              ext y
              change fromLocB (ρ₁ (algebraMap S₀ L₀ y)) = π_L (algebraMap S₀ L₀ y)
              rw [IsLocalization.lift_eq]
              change fromLocB (algebraMap S_b (Localization.AtPrime q_bar_b) (mk_Sb y)) = _
              rw [IsLocalization.lift_eq, hσ₀_eq]
              rfl
            have hπx : π_L x = 0 := by
              rw [← hcomp, RingHom.comp_apply, RingHom.mem_ker.mp hx, map_zero]
            exact (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.span {s_tilde b})).mp hπx
          exact hker_ρ₁_eq ▸ RingHom.ker_isPrime ρ₁
        have hMinTwo : ∀ M ∈ minimalPrimes L₀,
            M = Ideal.span {s_tilde 0} ∨ M = Ideal.span {s_tilde 1} := by
          intro M hM
          have hM_prime : M.IsPrime := hM.1.1
          have h0 : s_tilde 0 * s_tilde 1 ∈ M := hs_tilde_mul ▸ M.zero_mem
          rcases hM_prime.mem_or_mem h0 with h0_in | h1_in
          · left
            have hle : Ideal.span {s_tilde 0} ≤ M :=
              Ideal.span_le.mpr (Set.singleton_subset_iff.mpr h0_in)
            exact le_antisymm (hM.2 ⟨hPb_prime 0, bot_le⟩ hle) hle
          · right
            have hle : Ideal.span {s_tilde 1} ≤ M :=
              Ideal.span_le.mpr (Set.singleton_subset_iff.mpr h1_in)
            exact le_antisymm (hM.2 ⟨hPb_prime 1, bot_le⟩ hle) hle
        obtain ⟨M₁, hM₁_min, hM₁_eq⟩ := hLiftMinToLoc ψ_C0 hψC0_etale q_bar₀ m₁ hm₁ hm₁_le
        obtain ⟨M₂, hM₂_min, hM₂_eq⟩ := hLiftMinToLoc ψ_C0 hψC0_etale q_bar₀ m₂ hm₂ hm₂_le
        obtain ⟨M₃, hM₃_min, hM₃_eq⟩ := hLiftMinToLoc ψ_C0 hψC0_etale q_bar₀ m₃ hm₃ hm₃_le
        rintro ⟨hne12, hne13, hne23⟩
        rcases hMinTwo M₁ hM₁_min with h1 | h1 <;>
          rcases hMinTwo M₂ hM₂_min with h2 | h2 <;>
          rcases hMinTwo M₃ hM₃_min with h3 | h3
        · exact hne12 (by rw [← hM₁_eq, ← hM₂_eq, h1, h2])
        · exact hne12 (by rw [← hM₁_eq, ← hM₂_eq, h1, h2])
        · exact hne13 (by rw [← hM₁_eq, ← hM₃_eq, h1, h3])
        · exact hne23 (by rw [← hM₂_eq, ← hM₃_eq, h2, h3])
        · exact hne23 (by rw [← hM₂_eq, ← hM₃_eq, h2, h3])
        · exact hne13 (by rw [← hM₁_eq, ← hM₃_eq, h1, h3])
        · exact hne12 (by rw [← hM₁_eq, ← hM₂_eq, h1, h2])
        · exact hne12 (by rw [← hM₁_eq, ← hM₂_eq, h1, h2])

  have hNoethBridge : ∀ (X : AlgebraicGeometry.Scheme.{u}) [TopologicalSpace.NoetherianSpace ↥X],
      (∀ (z : ↥X) (W : X.Opens), z ∈ W →
        ∃ (U_C : X.Opens) (hUC : AlgebraicGeometry.IsAffineOpen U_C) (hz : z ∈ U_C),
          U_C ≤ W ∧
          (∃ (p₁ p₀ : Ideal ↑(X.presheaf.obj (Opposite.op U_C))),
            p₁.IsPrime ∧ p₀.IsPrime ∧ p₁ < p₀) ∧
          (∀ (p₂ p₁ : Ideal ↑(X.presheaf.obj (Opposite.op U_C))),
            p₂.IsPrime → p₁.IsPrime → p₂ < p₁ →
            p₁ < (hUC.primeIdealOf ⟨z, hz⟩).asIdeal → False) ∧
          (∀ m₁ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
            ∀ m₂ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
            ∀ m₃ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
            m₁ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
            m₂ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
            m₃ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
            ¬(m₁ ≠ m₂ ∧ m₁ ≠ m₃ ∧ m₂ ≠ m₃))) →
      (∀ E ∈ irreducibleComponents ↥X, topologicalKrullDim ↥E = (1 : WithBot ℕ∞)) ∧
      (∀ (z : ↥X) (E₁ E₂ E₃ : Set ↥X),
        E₁ ∈ irreducibleComponents ↥X →
        E₂ ∈ irreducibleComponents ↥X →
        E₃ ∈ irreducibleComponents ↥X →
        z ∈ E₁ → z ∈ E₂ → z ∈ E₃ →
        ¬(E₁ ≠ E₂ ∧ E₁ ≠ E₃ ∧ E₂ ≠ E₃)) ∧
      (∀ (z : ↥X) (U_C : X.Opens) (hUC : AlgebraicGeometry.IsAffineOpen U_C) (hz : z ∈ U_C),
        (∀ m₁ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
          ∀ m₂ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
          m₁ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
          m₂ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal → m₁ = m₂) →
        ∀ (E₁ E₂ : Set ↥X),
          E₁ ∈ irreducibleComponents ↥X →
          E₂ ∈ irreducibleComponents ↥X →
          z ∈ E₁ → z ∈ E₂ → E₁ = E₂) := by
    intro X _ hLoc
    have hMinInj : ∀ (z : ↥X) (U_C : X.Opens) (hUC : AlgebraicGeometry.IsAffineOpen U_C)
        (hz : z ∈ U_C) (E : Set ↥X),
        E ∈ irreducibleComponents ↥X → z ∈ E →
        ∃ m ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
          m ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal ∧
          closure ((hUC.fromSpec.base : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_C)) → ↥X) ''
            PrimeSpectrum.zeroLocus (m : Set ↑(X.presheaf.obj (Opposite.op U_C)))) = E := by
      intro z U_C hUC hz E hE hzE
      let R_C : Type u := ↑(X.presheaf.obj (Opposite.op U_C))
      let ι_spec : PrimeSpectrum R_C → ↥X := hUC.fromSpec.base
      have hClE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
      have hIrrE : IsIrreducible E := hE.1
      have : AlgebraicGeometry.IsOpenImmersion hUC.fromSpec := hUC.isOpenImmersion_fromSpec
      have hEmb : Topology.IsOpenEmbedding ι_spec := hUC.fromSpec.isOpenEmbedding
      have hCont : Continuous ι_spec := hUC.fromSpec.continuous
      have hRange : Set.range ι_spec = (U_C : Set ↥X) := by
        change Set.range hUC.fromSpec.base = (U_C : Set ↥X)
        simp
      have hDense : closure (E ∩ (U_C : Set ↥X)) = E := by
        apply le_antisymm
        · exact closure_minimal Set.inter_subset_left hClE
        · intro y hyE
          by_contra hyNot
          have hu : IsOpen ((closure (E ∩ (U_C : Set ↥X)))ᶜ) := isClosed_closure.isOpen_compl
          have hv : IsOpen (U_C : Set ↥X) := U_C.isOpen
          obtain ⟨w, hwE, hw_cl, hw_UC⟩ :=
            hIrrE.2 _ _ hu hv ⟨y, hyE, hyNot⟩ ⟨z, hzE, hz⟩
          exact hw_cl (subset_closure ⟨hwE, hw_UC⟩)
      let q_z : PrimeSpectrum R_C := hUC.primeIdealOf ⟨z, hz⟩
      have hqz_img : ι_spec q_z = z := hUC.fromSpec_primeIdealOf ⟨z, hz⟩
      let S_E : Set (PrimeSpectrum R_C) := ι_spec ⁻¹' E
      have hqz_SE : q_z ∈ S_E := by
        change ι_spec q_z ∈ E
        rwa [hqz_img]
      have hImg_SE : ι_spec '' S_E = E ∩ (U_C : Set ↥X) := by
        change ι_spec '' (ι_spec ⁻¹' E) = E ∩ (U_C : Set ↥X)
        rw [Set.image_preimage_eq_inter_range, hRange]
      have hIrr_SE : IsIrreducible S_E := by
        refine ⟨⟨q_z, hqz_SE⟩, ?_⟩
        intro W₁ W₂ hW₁ hW₂ ⟨p₁, hp₁SE, hp₁W₁⟩ ⟨p₂, hp₂SE, hp₂W₂⟩
        have hU₁ : IsOpen (ι_spec '' W₁) := hEmb.isOpenMap W₁ hW₁
        have hU₂ : IsOpen (ι_spec '' W₂) := hEmb.isOpenMap W₂ hW₂
        obtain ⟨w, hwE, ⟨p'₁, hp'₁W₁, rfl⟩, ⟨p'₂, hp'₂W₂, hw_eq⟩⟩ :=
          hIrrE.2 _ _ hU₁ hU₂
            ⟨ι_spec p₁, hp₁SE, p₁, hp₁W₁, rfl⟩
            ⟨ι_spec p₂, hp₂SE, p₂, hp₂W₂, rfl⟩
        have hp_eq : p'₁ = p'₂ := hEmb.injective hw_eq.symm
        subst hp_eq
        exact ⟨p'₁, hwE, hp'₁W₁, hp'₂W₂⟩
      have hSE_comp : S_E ∈ irreducibleComponents (PrimeSpectrum R_C) := by
        refine ⟨hIrr_SE, ?_⟩
        intro T hIrrT hSET
        let K : Set ↥X := closure (ι_spec '' T)
        have hIrrK : IsIrreducible K := (hIrrT.image _ hCont.continuousOn).closure
        have hEK : E ⊆ K := by
          rw [← hDense, ← hImg_SE]
          exact closure_mono (Set.image_mono hSET)
        have hKE : K ⊆ E := hE.2 hIrrK hEK
        intro t htT
        change ι_spec t ∈ E
        exact hKE (subset_closure ⟨t, htT, rfl⟩)
      rw [← PrimeSpectrum.zeroLocus_minimalPrimes R_C] at hSE_comp
      obtain ⟨m, hm_min, hm_zl⟩ := hSE_comp
      have hm_zl' : PrimeSpectrum.zeroLocus (m : Set R_C) = S_E := hm_zl
      have hm_le : m ≤ q_z.asIdeal := by
        have hqz_zl : q_z ∈ PrimeSpectrum.zeroLocus (m : Set R_C) := by
          rwa [hm_zl']
        exact hqz_zl
      refine ⟨m, hm_min, hm_le, ?_⟩
      change closure (ι_spec '' PrimeSpectrum.zeroLocus (m : Set R_C)) = E
      rw [hm_zl', hImg_SE, hDense]
    refine ⟨?_, ?_, ?_⟩
    · intro E hE
      have hClE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
      have hIrrE : IsIrreducible E := hE.1
      have hFinComp : (irreducibleComponents ↥X).Finite :=
        TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
      let M_other : Set (Set ↥X) := irreducibleComponents ↥X \ {E}
      have hFinOther : M_other.Finite := hFinComp.subset Set.sdiff_subset
      let Z_other : Set ↥X := ⋃ E' ∈ M_other, E'
      have hClOther : IsClosed Z_other :=
        hFinOther.isClosed_biUnion fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1
      have hFinUnion : ∀ (F : Finset (Set ↥X)),
          (∀ A ∈ F, IsClosed A) → (E ⊆ ⋃ A ∈ F, A) → ∃ A ∈ F, E ⊆ A := by
        classical
        intro F
        induction F using Finset.induction_on with
        | empty =>
          intro _ hSub
          obtain ⟨x, hxE⟩ := hIrrE.1
          have hx0 := hSub hxE
          simp at hx0
        | insert A₀ F' hNotMem ih =>
          intro hClF hSub
          by_cases hEA₀ : E ⊆ A₀
          · exact ⟨A₀, Finset.mem_insert_self A₀ F', hEA₀⟩
          · have hClRest : IsClosed (⋃ A ∈ F', A) :=
              F'.finite_toSet.isClosed_biUnion fun A hA => hClF A (Finset.mem_insert_of_mem hA)
            by_cases hERest : E ⊆ ⋃ A ∈ F', A
            · obtain ⟨A, hAF', hEA⟩ := ih (fun A hA => hClF A (Finset.mem_insert_of_mem hA)) hERest
              exact ⟨A, Finset.mem_insert_of_mem hAF', hEA⟩
            · exfalso
              obtain ⟨x₁, hx₁E, hx₁Not⟩ := Set.not_subset.mp hEA₀
              obtain ⟨x₂, hx₂E, hx₂Not⟩ := Set.not_subset.mp hERest
              have hClA₀ : IsClosed A₀ := hClF A₀ (Finset.mem_insert_self A₀ F')
              obtain ⟨w, hwE, hw₁, hw₂⟩ :=
                hIrrE.2 _ _ hClA₀.isOpen_compl hClRest.isOpen_compl
                  ⟨x₁, hx₁E, hx₁Not⟩ ⟨x₂, hx₂E, hx₂Not⟩
              obtain ⟨A, hAF_mem, hwA⟩ := Set.mem_iUnion₂.mp (hSub hwE)
              rcases Finset.mem_insert.mp hAF_mem with rfl | hAF'
              · exact hw₁ hwA
              · exact hw₂ (Set.mem_iUnion₂.mpr ⟨A, hAF', hwA⟩)
      have hENotSub : ¬ (E ⊆ Z_other) := by
        intro hSub
        let F := hFinOther.toFinset
        have hSubF : E ⊆ ⋃ A ∈ F, A := by
          intro x hx
          obtain ⟨A, hAM, hxA⟩ := Set.mem_iUnion₂.mp (hSub hx)
          exact Set.mem_iUnion₂.mpr ⟨A, hFinOther.mem_toFinset.mpr hAM, hxA⟩
        obtain ⟨A, hAF, hEA⟩ := hFinUnion F
          (fun A hA => isClosed_of_mem_irreducibleComponents A (hFinOther.mem_toFinset.mp hA).1)
          hSubF
        have hAM : A ∈ M_other := hFinOther.mem_toFinset.mp hAF
        have hAE : A ⊆ E := hE.2 hAM.1.1 hEA
        exact hAM.2 (Set.Subset.antisymm hAE hEA)
      obtain ⟨z₀, hz₀E, hz₀Not⟩ := Set.not_subset.mp hENotSub
      let W_E : X.Opens := ⟨Z_otherᶜ, hClOther.isOpen_compl⟩
      have hWE_sub : (W_E : Set ↥X) ⊆ E := by
        intro y hyW
        have hy_comp : irreducibleComponent y ∈ irreducibleComponents ↥X :=
          irreducibleComponent_mem_irreducibleComponents y
        have hy_mem : y ∈ irreducibleComponent y := mem_irreducibleComponent
        by_cases hEq : irreducibleComponent y = E
        · rwa [← hEq]
        · exfalso
          exact hyW (Set.mem_iUnion₂.mpr ⟨irreducibleComponent y, ⟨hy_comp, hEq⟩, hy_mem⟩)
      obtain ⟨U_C, hUC, hz₀UC, hUC_le_W, ⟨p₁, p₀, hp₁, hp₀, hp₁₀⟩, _, _⟩ :=
        hLoc z₀ W_E hz₀Not
      have : p₁.IsPrime := hp₁
      have : p₀.IsPrime := hp₀
      have : AlgebraicGeometry.IsOpenImmersion hUC.fromSpec := hUC.isOpenImmersion_fromSpec
      let ι_spec : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_C)) → ↥X := hUC.fromSpec.base
      have hEmb : Topology.IsOpenEmbedding ι_spec := hUC.fromSpec.isOpenEmbedding
      have hCont : Continuous ι_spec := hUC.fromSpec.continuous
      have hRange : Set.range ι_spec = (U_C : Set ↥X) := by
        change Set.range hUC.fromSpec.base = (U_C : Set ↥X)
        simp
      let q₁ : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_C)) := ⟨p₁, hp₁⟩
      let q₀ : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_C)) := ⟨p₀, hp₀⟩
      let y₁ : ↥X := ι_spec q₁
      let y₀ : ↥X := ι_spec q₀
      have hy₁UC : y₁ ∈ (U_C : Set ↥X) := by
        rw [← hRange]; exact ⟨q₁, rfl⟩
      have hy₀UC : y₀ ∈ (U_C : Set ↥X) := by
        rw [← hRange]; exact ⟨q₀, rfl⟩
      have hy₁E : y₁ ∈ E := hWE_sub (hUC_le_W hy₁UC)
      have hy₀E : y₀ ∈ E := hWE_sub (hUC_le_W hy₀UC)
      have hy_ne : y₁ ≠ y₀ := fun h => (ne_of_lt hp₁₀) (congrArg PrimeSpectrum.asIdeal (hEmb.injective h))
      have hq₀_cl : q₀ ∈ closure ({q₁} : Set _) :=
        (PrimeSpectrum.le_iff_mem_closure q₁ q₀).mp (le_of_lt hp₁₀)
      have hy₀_clX : y₀ ∈ closure ({y₁} : Set ↥X) := by
        have hsub : ι_spec q₀ ∈ closure (ι_spec '' ({q₁} : Set _)) :=
          image_closure_subset_closure_image hCont ⟨q₀, hq₀_cl, rfl⟩
        rwa [Set.image_singleton] at hsub
      let yE₁ : ↥E := ⟨y₁, hy₁E⟩
      let yE₀ : ↥E := ⟨y₀, hy₀E⟩
      have hyE₀_cl : yE₀ ∈ closure ({yE₁} : Set ↥E) := by
        rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
        simpa [yE₁, yE₀] using hy₀_clX
      let K₀ : TopologicalSpace.IrreducibleCloseds ↥E :=
        ⟨closure ({yE₀} : Set ↥E), (isIrreducible_singleton (x := yE₀)).closure, isClosed_closure⟩
      let K₁ : TopologicalSpace.IrreducibleCloseds ↥E :=
        ⟨closure ({yE₁} : Set ↥E), (isIrreducible_singleton (x := yE₁)).closure, isClosed_closure⟩
      have hK_le : K₀ ≤ K₁ := closure_minimal (Set.singleton_subset_iff.mpr hyE₀_cl) isClosed_closure
      have hK_lt : K₀ < K₁ := by
        refine lt_of_le_of_ne hK_le fun hEq => ?_
        have hyE₁_in : yE₁ ∈ (K₀ : Set ↥E) := by
          rw [hEq]
          exact subset_closure (Set.mem_singleton yE₁)
        have hy₁_clX : y₁ ∈ closure ({y₀} : Set ↥X) := by
          have hsub := image_closure_subset_closure_image continuous_subtype_val ⟨yE₁, hyE₁_in, rfl⟩
          simpa [yE₁, yE₀] using hsub
        have h_eq : y₀ = y₁ :=
          inseparable_iff_eq.mp (inseparable_iff_mem_closure.mpr ⟨hy₀_clX, hy₁_clX⟩)
        exact hy_ne h_eq.symm
      let ser₁ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥E) :=
        { length := 1
          toFun := ![K₀, K₁]
          step := fun i => by
            match i with
            | ⟨0, _⟩ => exact hK_lt }
      have hLower : (1 : WithBot ℕ∞) ≤ topologicalKrullDim ↥E :=
        Order.LTSeries.length_le_krullDim ser₁
      have hUpper : topologicalKrullDim ↥E < ((2 : ℕ) : WithBot ℕ∞) := by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥E) < ((2 : ℕ) : WithBot ℕ∞)
        rw [Order.krullDim_lt_coe_iff]
        intro l
        by_contra hNotLt
        have hLen : 2 ≤ l.length := Nat.le_of_not_lt hNotLt
        let Z₀ := l ⟨0, by omega⟩
        let Z₁ := l ⟨1, by omega⟩
        let Z₂ := l ⟨2, by omega⟩
        have hZ₀₁ : Z₀ < Z₁ := l.step ⟨0, by omega⟩
        have hZ₁₂ : Z₁ < Z₂ := l.step ⟨1, by omega⟩
        have hClEmb : Topology.IsClosedEmbedding (Subtype.val : ↥E → ↥X) :=
          hClE.isClosedEmbedding_subtypeVal
        let pushZ : TopologicalSpace.IrreducibleCloseds ↥E → Set ↥X :=
          fun Z => (Subtype.val : ↥E → ↥X) '' (Z : Set ↥E)
        have hPushCl : ∀ Z, IsClosed (pushZ Z) := fun Z => hClEmb.isClosedMap _ Z.isClosed'
        have hPushIrr : ∀ Z, IsIrreducible (pushZ Z) :=
          fun Z => Z.isIrreducible'.image _ continuous_subtype_val.continuousOn
        have hPushLt : ∀ {A B : TopologicalSpace.IrreducibleCloseds ↥E},
            A < B → pushZ A ⊂ pushZ B := by
          intro A B hAB
          refine Set.ssubset_iff_subset_ne.mpr ⟨Set.image_mono (le_of_lt hAB), fun hEq => ?_⟩
          apply ne_of_lt hAB
          ext x
          have hx1 := Set.preimage_image_eq (A : Set ↥E) Subtype.val_injective
          have hx2 := Set.preimage_image_eq (B : Set ↥E) Subtype.val_injective
          change x ∈ (A : Set ↥E) ↔ x ∈ (B : Set ↥E)
          dsimp only [pushZ] at hEq
          rw [← hx1, ← hx2, hEq]
        have hW₀₁ : pushZ Z₀ ⊂ pushZ Z₁ := hPushLt hZ₀₁
        have hW₁₂ : pushZ Z₁ ⊂ pushZ Z₂ := hPushLt hZ₁₂
        let w₀ : ↥X := (hPushIrr Z₀).genericPoint
        let w₁ : ↥X := (hPushIrr Z₁).genericPoint
        let w₂ : ↥X := (hPushIrr Z₂).genericPoint
        have hw₀_cl : closure ({w₀} : Set ↥X) = pushZ Z₀ :=
          (hPushIrr Z₀).closure_genericPoint (hPushCl Z₀)
        have hw₁_cl : closure ({w₁} : Set ↥X) = pushZ Z₁ :=
          (hPushIrr Z₁).closure_genericPoint (hPushCl Z₁)
        have hw₂_cl : closure ({w₂} : Set ↥X) = pushZ Z₂ :=
          (hPushIrr Z₂).closure_genericPoint (hPushCl Z₂)
        have hw₀_in_w₁ : w₀ ∈ closure ({w₁} : Set ↥X) := by
          rw [hw₁_cl]
          exact hW₀₁.1 (hw₀_cl ▸ subset_closure (Set.mem_singleton w₀))
        have hw₁_in_w₂ : w₁ ∈ closure ({w₂} : Set ↥X) := by
          rw [hw₂_cl]
          exact hW₁₂.1 (hw₁_cl ▸ subset_closure (Set.mem_singleton w₁))
        have hw₀₁_ne : w₀ ≠ w₁ := fun h => hW₀₁.2 (by rw [← hw₀_cl, ← hw₁_cl, h])
        have hw₁₂_ne : w₁ ≠ w₂ := fun h => hW₁₂.2 (by rw [← hw₁_cl, ← hw₂_cl, h])
        obtain ⟨U₀, hU₀, hw₀U₀, _, _, hNoChain, _⟩ := hLoc w₀ ⊤ trivial
        have hw₁U₀ : w₁ ∈ U₀ := by
          obtain ⟨_, hzU, hzw⟩ := (mem_closure_iff.mp hw₀_in_w₁) U₀ U₀.isOpen hw₀U₀
          rwa [← Set.mem_singleton_iff.mp hzw]
        have hw₂U₀ : w₂ ∈ U₀ := by
          obtain ⟨_, hzU, hzw⟩ := (mem_closure_iff.mp hw₁_in_w₂) U₀ U₀.isOpen hw₁U₀
          rwa [← Set.mem_singleton_iff.mp hzw]
        have : AlgebraicGeometry.IsOpenImmersion hU₀.fromSpec := hU₀.isOpenImmersion_fromSpec
        let ι₀_spec : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U₀)) → ↥X := hU₀.fromSpec.base
        have hEmb₀ : Topology.IsOpenEmbedding ι₀_spec := hU₀.fromSpec.isOpenEmbedding
        let P₀ := hU₀.primeIdealOf ⟨w₀, hw₀U₀⟩
        let P₁ := hU₀.primeIdealOf ⟨w₁, hw₁U₀⟩
        let P₂ := hU₀.primeIdealOf ⟨w₂, hw₂U₀⟩
        have hP₀_img : ι₀_spec P₀ = w₀ := hU₀.fromSpec_primeIdealOf ⟨w₀, hw₀U₀⟩
        have hP₁_img : ι₀_spec P₁ = w₁ := hU₀.fromSpec_primeIdealOf ⟨w₁, hw₁U₀⟩
        have hP₂_img : ι₀_spec P₂ = w₂ := hU₀.fromSpec_primeIdealOf ⟨w₂, hw₂U₀⟩
        have hPullLt : ∀ {Q_a Q_b : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U₀))},
            ι₀_spec Q_a ∈ closure ({ι₀_spec Q_b} : Set ↥X) →
            ι₀_spec Q_a ≠ ι₀_spec Q_b →
            Q_b.asIdeal < Q_a.asIdeal := by
          intro Q_a Q_b hcl hne
          have hQa_cl : Q_a ∈ closure ({Q_b} : Set _) := by
            rw [mem_closure_iff]
            intro V hV hQaV
            have hImgOpen : IsOpen (ι₀_spec '' V) := hEmb₀.isOpenMap V hV
            obtain ⟨_, ⟨Q', hQ'V, rfl⟩, hQ'_eq⟩ :=
              (mem_closure_iff.mp hcl) _ hImgOpen ⟨Q_a, hQaV, rfl⟩
            have hEqQ : Q' = Q_b := hEmb₀.injective (Set.mem_singleton_iff.mp hQ'_eq)
            subst hEqQ
            exact ⟨Q', hQ'V, Set.mem_singleton Q'⟩
          have hle : Q_b.asIdeal ≤ Q_a.asIdeal := (PrimeSpectrum.le_iff_mem_closure Q_b Q_a).mpr hQa_cl
          exact lt_of_le_of_ne hle fun hEq => hne (congrArg ι₀_spec (PrimeSpectrum.ext hEq.symm))
        have hLt₁₀ : P₁.asIdeal < P₀.asIdeal :=
          hPullLt (by rwa [hP₀_img, hP₁_img]) (by rwa [hP₀_img, hP₁_img])
        have hLt₂₁ : P₂.asIdeal < P₁.asIdeal :=
          hPullLt (by rwa [hP₁_img, hP₂_img]) (by rwa [hP₁_img, hP₂_img])
        exact hNoChain P₂.asIdeal P₁.asIdeal P₂.isPrime P₁.isPrime hLt₂₁ hLt₁₀
      revert hLower hUpper
      generalize topologicalKrullDim ↥E = d
      cases d with
      | bot =>
        intro hL _
        exact absurd hL (by decide)
      | coe a =>
        cases a with
        | top =>
          intro _ hU
          exact absurd hU (by decide)
        | coe m =>
          intro hL hU
          have hm1 : 1 ≤ m := by exact_mod_cast hL
          have hm2 : m < 2 := Nat.cast_lt.mp (WithBot.coe_lt_coe.mp hU)
          have hm_eq : m = 1 := by omega
          subst hm_eq
          rfl
    · intro z E₁ E₂ E₃ hE₁ hE₂ hE₃ hz₁ hz₂ hz₃ hDist
      obtain ⟨U_C, hUC, hzUC, _, _, _, hThreeMin⟩ := hLoc z ⊤ trivial
      obtain ⟨m₁, hm₁_min, hm₁_le, hm₁_eq⟩ := hMinInj z U_C hUC hzUC E₁ hE₁ hz₁
      obtain ⟨m₂, hm₂_min, hm₂_le, hm₂_eq⟩ := hMinInj z U_C hUC hzUC E₂ hE₂ hz₂
      obtain ⟨m₃, hm₃_min, hm₃_le, hm₃_eq⟩ := hMinInj z U_C hUC hzUC E₃ hE₃ hz₃
      exact hThreeMin m₁ hm₁_min m₂ hm₂_min m₃ hm₃_min hm₁_le hm₂_le hm₃_le
        ⟨fun h12 => hDist.1 (by rw [← hm₁_eq, ← hm₂_eq, h12]),
         fun h13 => hDist.2.1 (by rw [← hm₁_eq, ← hm₃_eq, h13]),
         fun h23 => hDist.2.2 (by rw [← hm₂_eq, ← hm₃_eq, h23])⟩
    · intro z U_C hUC hzUC hOneMin E₁ E₂ hE₁ hE₂ hz₁ hz₂
      obtain ⟨m₁, hm₁_min, hm₁_le, hm₁_eq⟩ := hMinInj z U_C hUC hzUC E₁ hE₁ hz₁
      obtain ⟨m₂, hm₂_min, hm₂_le, hm₂_eq⟩ := hMinInj z U_C hUC hzUC E₂ hE₂ hz₂
      have hm12 : m₁ = m₂ := hOneMin m₁ hm₁_min m₂ hm₂_min hm₁_le hm₂_le
      rw [← hm₁_eq, ← hm₂_eq, hm12]

  have hEtaleComp : ∀ {A₁ A₂ A₃ : Type u} [CommRing A₁] [CommRing A₂] [CommRing A₃]
      {f₁ : A₁ →+* A₂} {f₂ : A₂ →+* A₃}, f₁.Etale → f₂.Etale → (f₂.comp f₁).Etale := by
    intro A₁ A₂ A₃ _ _ _ f₁ f₂ hf₁ hf₂
    let _ : Algebra A₁ A₂ := f₁.toAlgebra
    let _ : Algebra A₂ A₃ := f₂.toAlgebra
    let _ : Algebra A₁ A₃ := (f₂.comp f₁).toAlgebra
    have _ : IsScalarTower A₁ A₂ A₃ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Algebra.Etale A₁ A₂ := hf₁.toAlgebra
    have _ : Algebra.Etale A₂ A₃ := hf₂.toAlgebra
    exact RingHom.etale_algebraMap.mpr (Algebra.Etale.comp A₁ A₂ A₃)

  let R₀ : CommRingCat.{u} := B.left.residueField s₀
  let s : AlgebraicGeometry.Spec R₀ ⟶ B.left := B.left.fromSpecResidueField s₀
  let X : AlgebraicGeometry.Scheme.{u} := f.left.fiber s₀
  let ι₁ : X ⟶ C.left := f.left.fiberι s₀
  let p₁ : X ⟶ AlgebraicGeometry.Spec R₀ := f.left.fiberToSpecResidueField s₀
  have hPb : CategoryTheory.IsPullback ι₁ p₁ f.left s :=
    CategoryTheory.IsPullback.of_hasPullback f.left s

  have hAlgClosedR₀ : IsAlgClosed ↑R₀ := by
    obtain ⟨N, ι_B, hClB⟩ := hProjB
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hBij₀ : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      refine ⟨?_, ?_⟩
      · intro a b hab
        have hC : (MvPolynomial.C a : MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C b :=
          congrArg Subtype.val hab
        simpa using congrArg (fun q => q.coeff 0) hC
      · intro z
        have hz : z.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
          simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using z.2
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hz
        exact ⟨c, Subtype.ext hc⟩
    let e₀ := (RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hBij₀).toCommRingCatIso
    have he₀ : CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) = e₀.hom := by ext x; rfl
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) := by
      rw [he₀]; infer_instance
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) := inferInstance
    have _ : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c y p => smul_mul_assoc c (y : MvPolynomial (Fin (N + 1)) k) p⟩
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have _ : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      change AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
      infer_instance
    have _ : AlgebraicGeometry.IsClosedImmersion ι_B.left := hClB
    have _ : AlgebraicGeometry.LocallyOfFiniteType B.hom := by
      rw [← CategoryTheory.Over.w ι_B]
      infer_instance
    have _ : AlgebraicGeometry.IsClosedImmersion s :=
      AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion.mp hCls₀
    have hLFT_gs : AlgebraicGeometry.LocallyOfFiniteType (s ≫ B.hom) := inferInstance
    let φ_k_cat : CommRingCat.of k ⟶ R₀ := AlgebraicGeometry.Spec.preimage (s ≫ B.hom)
    have hSpec_φk : AlgebraicGeometry.Spec.map φ_k_cat = s ≫ B.hom :=
      AlgebraicGeometry.Spec.map_preimage (s ≫ B.hom)
    have hFT_φk : φ_k_cat.hom.FiniteType :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp
        (hSpec_φk.symm ▸ hLFT_gs)
    let _ : Algebra k ↑R₀ := φ_k_cat.hom.toAlgebra
    have hFT_alg : Algebra.FiniteType k ↑R₀ := hFT_φk
    obtain ⟨r, Φ_mv, hΦ_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    have _ : (⊥ : Ideal ↑R₀).IsMaximal := Ideal.bot_isMaximal
    let M_mv : Ideal (MvPolynomial (Fin r) k) := Ideal.comap Φ_mv.toRingHom ⊥
    have hM_max : M_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective Φ_mv.toRingHom hΦ_surj
    obtain ⟨x_k, hx_k⟩ :=
      MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM_max
    have hSurj_φk : Function.Surjective φ_k_cat.hom := by
      intro u
      obtain ⟨P, rfl⟩ := hΦ_surj u
      let c_u : k := MvPolynomial.aeval x_k P
      have hDiff : P - MvPolynomial.C c_u ∈ M_mv := by
        rw [hx_k, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp [c_u]
      have hZero : Φ_mv P - Φ_mv (MvPolynomial.C c_u) = 0 := by
        rw [← map_sub]
        exact Ideal.mem_bot.mp hDiff
      refine ⟨c_u, ?_⟩
      calc φ_k_cat.hom c_u = Φ_mv (MvPolynomial.C c_u) := (Φ_mv.commutes c_u).symm
        _ = Φ_mv P := (sub_eq_zero.mp hZero).symm
    let e_k : k ≃+* ↑R₀ := RingEquiv.ofBijective φ_k_cat.hom ⟨φ_k_cat.hom.injective, hSurj_φk⟩
    exact IsAlgClosed.mk fun p => by
      have hp : (p.map e_k.symm.toRingHom).Splits := IsAlgClosed.splits _
      have hp' := hp.map e_k.toRingHom
      have hcomp : e_k.toRingHom.comp e_k.symm.toRingHom = RingHom.id ↑R₀ := by
        ext x; exact e_k.apply_symm_apply x
      rwa [Polynomial.map_map, hcomp, Polynomial.map_id] at hp'
  have _ : IsAlgClosed ↑R₀ := hAlgClosedR₀

  have _ : TopologicalSpace.NoetherianSpace ↥X := by
    have _ : AlgebraicGeometry.IsProper f.left := hCurve.2.1
    have _ : AlgebraicGeometry.IsProper p₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb inferInstance
    have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec R₀) :=
      AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
    have _ : AlgebraicGeometry.IsLocallyNoetherian X :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p₁
    have _ : CompactSpace ↥(AlgebraicGeometry.Spec R₀) := PrimeSpectrum.compactSpace
    have _ : CompactSpace ↥X :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p₁
    have _ : AlgebraicGeometry.IsNoetherian X := ⟨⟩
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace

  have hSmoothChart : ∀ (V : C.left.Opens) (W : X.Opens) (z : ↥X),
      ι₁.base z ∈ V → z ∈ W →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f.left) →
      ∃ (U_C : X.Opens) (hUC : AlgebraicGeometry.IsAffineOpen U_C) (hz : z ∈ U_C),
        U_C ≤ W ∧
        ∃ (g_poly : Polynomial ↑R₀ →+* ↑(X.presheaf.obj (Opposite.op U_C))), g_poly.Etale := by
    intro V W z hzV hzW hSmV
    let V₁ : X.Opens := ι₁ ⁻¹ᵁ V
    have hzV₁ : z ∈ V₁ := hzV
    have hPb_res : CategoryTheory.IsPullback (ι₁ ∣_ V) V₁.ι V.ι ι₁ :=
      AlgebraicGeometry.isPullback_morphismRestrict ι₁ V
    have hPb_sm : CategoryTheory.IsPullback (ι₁ ∣_ V) (V₁.ι ≫ p₁) (V.ι ≫ f.left) s :=
      hPb_res.paste_vert hPb
    have hSmV₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₁.ι ≫ p₁) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_sm hSmV
    obtain ⟨U₀, hU₀, V_z, hVz, hzVz, e_map, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V₁.ι ≫ p₁)).mp hSmV₁ ⟨z, hzV₁⟩
    have hU₀_top : U₀ = ⊤ := eq_top_iff.mpr fun pt _ => by
      have hsub : Subsingleton ↥(AlgebraicGeometry.Spec R₀) := inferInstance
      rw [hsub.elim pt ((V₁.ι ≫ p₁).base ⟨z, hzV₁⟩)]
      exact e_map hzVz
    let e_R₀ : ↑R₀ ≃+* ↑((AlgebraicGeometry.Spec R₀).presheaf.obj (Opposite.op U₀)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).symm ≪≫
        (AlgebraicGeometry.Spec R₀).presheaf.mapIso
          (CategoryTheory.eqToIso hU₀_top).op).commRingCatIsoToRingEquiv
    let e_poly : Polynomial ↑R₀ ≃+*
        MvPolynomial (Fin 1) ↑((AlgebraicGeometry.Spec R₀).presheaf.obj (Opposite.op U₀)) :=
      (MvPolynomial.uniqueAlgEquiv ↑R₀ (Fin 1)).symm.toRingEquiv.trans
        (MvPolynomial.mapEquiv (Fin 1) e_R₀)
    obtain ⟨g_mv, _, hg_mv_et⟩ := hStd.exists_etale_mvPolynomial
    let U₁ : X.Opens := V₁.ι ''ᵁ V_z
    have hU₁ : AlgebraicGeometry.IsAffineOpen U₁ := hVz.image_of_isOpenImmersion V₁.ι
    have hzU₁ : z ∈ U₁ := ⟨⟨z, hzV₁⟩, hzVz, rfl⟩
    let e_V₁ : ↑(V₁.toScheme.presheaf.obj (Opposite.op V_z)) ≃+*
        ↑(X.presheaf.obj (Opposite.op U₁)) :=
      (V₁.ι.appIso V_z).symm.commRingCatIsoToRingEquiv
    obtain ⟨a, ha_le, hzUC⟩ := hU₁.exists_basicOpen_le (V := W) ⟨z, hzW⟩ hzU₁
    let U_C : X.Opens := X.basicOpen a
    have hUC : AlgebraicGeometry.IsAffineOpen U_C := hU₁.basicOpen a
    have _ : IsLocalization.Away a ↑(X.presheaf.obj (Opposite.op U_C)) :=
      hU₁.isLocalization_basicOpen a
    have hLoc_et : (algebraMap ↑(X.presheaf.obj (Opposite.op U₁))
        ↑(X.presheaf.obj (Opposite.op U_C))).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway a)
    have he_poly_et : e_poly.toRingHom.Etale := RingHom.Etale.of_bijective e_poly.bijective
    have he_V₁_et : e_V₁.toRingHom.Etale := RingHom.Etale.of_bijective e_V₁.bijective
    let g_poly : Polynomial ↑R₀ →+* ↑(X.presheaf.obj (Opposite.op U_C)) :=
      (algebraMap ↑(X.presheaf.obj (Opposite.op U₁))
        ↑(X.presheaf.obj (Opposite.op U_C))).comp
        (e_V₁.toRingHom.comp (g_mv.comp e_poly.toRingHom))
    have hg_et : g_poly.Etale :=
      hEtaleComp (hEtaleComp (hEtaleComp he_poly_et hg_mv_et) he_V₁_et) hLoc_et
    exact ⟨U_C, hUC, hzUC, ha_le, g_poly, hg_et⟩

  have hLocX : ∀ (z : ↥X) (W : X.Opens), z ∈ W →
      ∃ (U_C : X.Opens) (hUC : AlgebraicGeometry.IsAffineOpen U_C) (hz : z ∈ U_C),
        U_C ≤ W ∧
        (∃ (p₁ p₀ : Ideal ↑(X.presheaf.obj (Opposite.op U_C))),
          p₁.IsPrime ∧ p₀.IsPrime ∧ p₁ < p₀) ∧
        (∀ (p₂ p₁ : Ideal ↑(X.presheaf.obj (Opposite.op U_C))),
          p₂.IsPrime → p₁.IsPrime → p₂ < p₁ →
          p₁ < (hUC.primeIdealOf ⟨z, hz⟩).asIdeal → False) ∧
        (∀ m₁ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
          ∀ m₂ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
          ∀ m₃ ∈ minimalPrimes ↑(X.presheaf.obj (Opposite.op U_C)),
          m₁ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
          m₂ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
          m₃ ≤ (hUC.primeIdealOf ⟨z, hz⟩).asIdeal →
          ¬(m₁ ≠ m₂ ∧ m₁ ≠ m₃ ∧ m₂ ≠ m₃)) := by
    intro z W hzW
    rcases hCurve.2.2.2.2.2.2.2.2.2 (ι₁.base z) with
      ⟨V, hzV, hSmV⟩ |
      ⟨R', e_B, h, V', v₀, e_C, q, hEtB, hEtC, hEtQ, hv₀z, hXi, hCh, hcomm_nod⟩
    · obtain ⟨U_C, hUC, hzUC, hUC_W, g_poly, hg_et⟩ := hSmoothChart V W z hzV hzW hSmV
      let R_C := ↑(X.presheaf.obj (Opposite.op U_C))
      let _ : Algebra (Polynomial ↑R₀) R_C := g_poly.toAlgebra
      have _ : Algebra.Etale (Polynomial ↑R₀) R_C := hg_et.toAlgebra
      have hIdEt : (RingHom.id R_C).Etale := RingHom.Etale.of_bijective Function.bijective_id
      let q_z := (hUC.primeIdealOf ⟨z, hzUC⟩).asIdeal
      obtain ⟨hStep, hNoChain, hOneMin⟩ :=
        (hRoofAlg ↑R₀ R_C).1 R_C (RingHom.id R_C) hIdEt q_z
      refine ⟨U_C, hUC, hzUC, hUC_W, hStep, ?_, ?_⟩
      · intro p₂ p₁ hp₂ hp₁ hp₂₁ hp₁₀
        exact hNoChain p₂ p₁ hp₂ hp₁ hp₂₁ (by simpa [q_z] using hp₁₀)
      · intro m₁ hm₁ m₂ hm₂ _ _ hm₁_le hm₂_le _ hDist
        exact hDist.1 (hOneMin m₁ hm₁ m₂ hm₂
          (by simpa [q_z] using hm₁_le) (by simpa [q_z] using hm₂_le))
    · have _ : AlgebraicGeometry.Etale e_B := hEtB
      have _ : AlgebraicGeometry.Etale e_C := hEtC
      have _ : AlgebraicGeometry.Etale q := hEtQ
      let I_nod : Ideal (MvPolynomial (Fin 2) R') :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
      let Q₀_cat : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 2) R' ⧸ I_nod)
      let c₀ : R' ⟶ Q₀_cat := CommRingCat.ofHom ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)
      let p₀_Q : AlgebraicGeometry.Spec Q₀_cat ⟶ AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map c₀
      let B' : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback e_B s
      let π_R' : B' ⟶ AlgebraicGeometry.Spec R' := CategoryTheory.Limits.pullback.fst e_B s
      let eB_tilde : B' ⟶ AlgebraicGeometry.Spec R₀ := CategoryTheory.Limits.pullback.snd e_B s
      have hPb_B' : CategoryTheory.IsPullback π_R' eB_tilde e_B s :=
        CategoryTheory.IsPullback.of_hasPullback e_B s
      have _ : AlgebraicGeometry.Etale eB_tilde := inferInstance
      let W' : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback e_C ι₁
      let π_V : W' ⟶ V' := CategoryTheory.Limits.pullback.fst e_C ι₁
      let eC_tilde : W' ⟶ X := CategoryTheory.Limits.pullback.snd e_C ι₁
      have hPb_W' : CategoryTheory.IsPullback π_V eC_tilde e_C ι₁ :=
        CategoryTheory.IsPullback.of_hasPullback e_C ι₁
      have _ : AlgebraicGeometry.Etale eC_tilde := inferInstance
      obtain ⟨w₀, hw₀_V, hw₀_X⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ z hv₀z
      have hPb_outer : CategoryTheory.IsPullback π_V (eC_tilde ≫ p₁) (e_C ≫ f.left) s :=
        hPb_W'.paste_vert hPb
      have hg_cond : (π_V ≫ q ≫ p₀_Q) ≫ e_B = (eC_tilde ≫ p₁) ≫ s := by
        calc (π_V ≫ q ≫ p₀_Q) ≫ e_B
            = π_V ≫ (q ≫ p₀_Q ≫ e_B) := by simp only [CategoryTheory.Category.assoc]
          _ = π_V ≫ (e_C ≫ f.left) := by rw [← hcomm_nod]
          _ = (eC_tilde ≫ p₁) ≫ s := hPb_outer.w
      let g_tilde : W' ⟶ B' :=
        CategoryTheory.Limits.pullback.lift (π_V ≫ q ≫ p₀_Q) (eC_tilde ≫ p₁) hg_cond
      have hPb_mid : CategoryTheory.IsPullback π_V g_tilde (q ≫ p₀_Q) π_R' := by
        refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_B'
        · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc, ← hcomm_nod]
          exact hPb_outer
        · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      obtain ⟨U_B', hAff_B', hw₀_UB', _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g_tilde.base w₀) (U := ⊤) trivial
      let R'₁ : CommRingCat.{u} := B'.presheaf.obj (Opposite.op U_B')
      let ι_B' : AlgebraicGeometry.Spec R'₁ ⟶ B' := hAff_B'.fromSpec
      have _ : AlgebraicGeometry.IsOpenImmersion ι_B' := hAff_B'.isOpenImmersion_fromSpec
      let e_B₁ : AlgebraicGeometry.Spec R'₁ ⟶ AlgebraicGeometry.Spec R₀ := ι_B' ≫ eB_tilde
      have hEt_eB₁ : AlgebraicGeometry.Etale e_B₁ := inferInstance
      let φ_R₀ : R₀ ⟶ R'₁ := AlgebraicGeometry.Spec.preimage e_B₁
      have hEt_φR₀ : φ_R₀.hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp
          ((AlgebraicGeometry.Spec.map_preimage e_B₁).symm ▸ hEt_eB₁)
      let _ : Algebra ↑R₀ ↑R'₁ := φ_R₀.hom.toAlgebra
      have _ : Algebra.Etale ↑R₀ ↑R'₁ := hEt_φR₀.toAlgebra
      let φ_R : R' ⟶ R'₁ := AlgebraicGeometry.Spec.preimage (ι_B' ≫ π_R')
      have hSpec_φR : AlgebraicGeometry.Spec.map φ_R = ι_B' ≫ π_R' :=
        AlgebraicGeometry.Spec.map_preimage (ι_B' ≫ π_R')
      let h₁ : R'₁ := φ_R.hom h
      let I₁ : Ideal (MvPolynomial (Fin 2) R'₁) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₁}
      let Q₁ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 2) R'₁ ⧸ I₁)
      let c₁ : R'₁ ⟶ Q₁ := CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C)
      let p₁_Q : AlgebraicGeometry.Spec Q₁ ⟶ AlgebraicGeometry.Spec R'₁ :=
        AlgebraicGeometry.Spec.map c₁
      let mapPoly : MvPolynomial (Fin 2) R' →+* Q₁ :=
        (Ideal.Quotient.mk I₁).comp (MvPolynomial.map φ_R.hom)
      have hmap_ker : ∀ a ∈ I_nod, mapPoly a = 0 := by
        intro a ha
        have hle : I_nod ≤ RingHom.ker mapPoly := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          change Ideal.Quotient.mk I₁
            (MvPolynomial.map φ_R.hom (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h)) = 0
          rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C,
            Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self _
        exact hle ha
      let φ_Q_cat : Q₀_cat ⟶ Q₁ := CommRingCat.ofHom (Ideal.Quotient.lift I_nod mapPoly hmap_ker)
      have hφQ_C : ∀ r : R', φ_Q_cat.hom (Ideal.Quotient.mk I_nod (MvPolynomial.C r)) =
          Ideal.Quotient.mk I₁ (MvPolynomial.C (φ_R.hom r)) := by
        intro r
        change mapPoly (MvPolynomial.C r) = _
        dsimp [mapPoly]
        rw [MvPolynomial.map_C]
      have hφQ_X : ∀ i : Fin 2, φ_Q_cat.hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i)) =
          Ideal.Quotient.mk I₁ (MvPolynomial.X i) := by
        intro i
        change mapPoly (MvPolynomial.X i) = _
        dsimp [mapPoly]
        rw [MvPolynomial.map_X]
      have heq_push : φ_R ≫ c₁ = c₀ ≫ φ_Q_cat := by
        apply CommRingCat.hom_ext; ext r; exact (hφQ_C r).symm
      let Ψ₀ : ∀ (sc : CategoryTheory.Limits.PushoutCocone φ_R c₀),
          MvPolynomial (Fin 2) R'₁ →+* sc.pt :=
        fun sc => MvPolynomial.eval₂Hom sc.inl.hom
          (fun i => sc.inr.hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i)))
      have hΨ₀_zero : ∀ sc, ∀ a ∈ I₁, Ψ₀ sc a = 0 := by
        intro sc a ha
        have hle : I₁ ≤ RingHom.ker (Ψ₀ sc) := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
            map_sub, map_mul]
          dsimp only [Ψ₀]
          rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
          have hs_cond : sc.inl.hom (φ_R.hom h) =
              sc.inr.hom (Ideal.Quotient.mk I_nod (MvPolynomial.C h)) :=
            congrArg (fun m : R' ⟶ sc.pt => m.hom h) sc.condition
          change _ - sc.inl.hom (φ_R.hom h) = 0
          rw [hs_cond, ← map_mul, ← map_sub, ← map_mul (Ideal.Quotient.mk I_nod),
            ← map_sub (Ideal.Quotient.mk I_nod)]
          have hgen0 : Ideal.Quotient.mk I_nod
              (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hgen0, map_zero]
        exact hle ha
      let desc_push : ∀ (sc : CategoryTheory.Limits.PushoutCocone φ_R c₀), Q₁ ⟶ sc.pt :=
        fun sc => CommRingCat.ofHom (Ideal.Quotient.lift I₁ (Ψ₀ sc) (hΨ₀_zero sc))
      have fac_left : ∀ sc, c₁ ≫ desc_push sc = sc.inl := by
        intro sc; apply CommRingCat.hom_ext; ext r₁
        change Ideal.Quotient.lift I₁ (Ψ₀ sc) (hΨ₀_zero sc)
          (Ideal.Quotient.mk I₁ (MvPolynomial.C r₁)) = sc.inl.hom r₁
        rw [Ideal.Quotient.lift_mk]; exact MvPolynomial.eval₂Hom_C _ _ r₁
      have fac_right : ∀ sc, φ_Q_cat ≫ desc_push sc = sc.inr := by
        intro sc; apply CommRingCat.hom_ext; apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r
          change (desc_push sc).hom (φ_Q_cat.hom (Ideal.Quotient.mk I_nod (MvPolynomial.C r))) =
            sc.inr.hom (Ideal.Quotient.mk I_nod (MvPolynomial.C r))
          rw [hφQ_C r]
          change (c₁ ≫ desc_push sc).hom (φ_R.hom r) = (c₀ ≫ sc.inr).hom r
          rw [fac_left sc, ← sc.condition]; rfl
        · intro i
          change (desc_push sc).hom (φ_Q_cat.hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i))) =
            sc.inr.hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i))
          rw [hφQ_X i]
          change Ideal.Quotient.lift I₁ (Ψ₀ sc) (hΨ₀_zero sc)
            (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) = _
          rw [Ideal.Quotient.lift_mk]; exact MvPolynomial.eval₂Hom_X' _ _ i
      have uniq_push : ∀ sc (m : Q₁ ⟶ sc.pt),
          c₁ ≫ m = sc.inl → φ_Q_cat ≫ m = sc.inr → m = desc_push sc := by
        intro sc m hm₁ hm₂; apply CommRingCat.hom_ext; apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r₁; change (c₁ ≫ m).hom r₁ = (c₁ ≫ desc_push sc).hom r₁; rw [hm₁, fac_left sc]
        · intro i
          change m.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) =
            (desc_push sc).hom (Ideal.Quotient.mk I₁ (MvPolynomial.X i))
          rw [← hφQ_X i]
          change (φ_Q_cat ≫ m).hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i)) =
            (φ_Q_cat ≫ desc_push sc).hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i))
          rw [hm₂, fac_right sc]
      have hIsPush : CategoryTheory.IsPushout φ_R c₀ c₁ φ_Q_cat :=
        CategoryTheory.IsPushout.of_isColimit
          (CategoryTheory.Limits.PushoutCocone.IsColimit.mk
            heq_push desc_push fac_left fac_right uniq_push)
      let V'₁_open : W'.Opens := g_tilde ⁻¹ᵁ U_B'
      let V'₁ : AlgebraicGeometry.Scheme.{u} := V'₁_open.toScheme
      let v₁ : V'₁ := ⟨w₀, hw₀_UB'⟩
      let e_C₁ : V'₁ ⟶ X := V'₁_open.ι ≫ eC_tilde
      have _ : AlgebraicGeometry.Etale e_C₁ := inferInstance
      let g₁ : V'₁ ⟶ AlgebraicGeometry.Spec R'₁ := (g_tilde ∣_ U_B') ≫ hAff_B'.isoSpec.hom
      have hPb_iso : CategoryTheory.IsPullback (𝟙 V'₁) g₁ (g_tilde ∣_ U_B') hAff_B'.isoSpec.inv := by
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        dsimp [g₁]
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          hAff_B'.isoSpec.hom_inv_id, CategoryTheory.Category.comp_id]
      have hPb_res_g : CategoryTheory.IsPullback V'₁_open.ι (g_tilde ∣_ U_B') g_tilde U_B'.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict g_tilde U_B').flip
      have hPb_V'₁_outer : CategoryTheory.IsPullback (V'₁_open.ι ≫ π_V) g₁ (q ≫ p₀_Q)
          (AlgebraicGeometry.Spec.map φ_R) := by
        have hp := (hPb_iso.paste_horiz hPb_res_g).paste_horiz hPb_mid
        have htop : (𝟙 V'₁ ≫ V'₁_open.ι) ≫ π_V = V'₁_open.ι ≫ π_V := by
          rw [CategoryTheory.Category.id_comp]
        have hbot : (hAff_B'.isoSpec.inv ≫ U_B'.ι) ≫ π_R' = AlgebraicGeometry.Spec.map φ_R := by
          rw [hAff_B'.isoSpec_inv_ι, ← hSpec_φR]
        rwa [htop, hbot] at hp
      have hPb_Q_flip : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map φ_Q_cat) p₁_Q p₀_Q
          (AlgebraicGeometry.Spec.map φ_R) :=
        (AlgebraicGeometry.isPullback_SpecMap_of_isPushout φ_R c₀ c₁ φ_Q_cat hIsPush).flip
      let q₁ : V'₁ ⟶ AlgebraicGeometry.Spec Q₁ :=
        hPb_Q_flip.lift ((V'₁_open.ι ≫ π_V) ≫ q) g₁ (by
          rw [CategoryTheory.Category.assoc]; exact hPb_V'₁_outer.w)
      have hq₁_φQ : q₁ ≫ AlgebraicGeometry.Spec.map φ_Q_cat = (V'₁_open.ι ≫ π_V) ≫ q :=
        hPb_Q_flip.lift_fst _ _ _
      have hq₁_p₁ : q₁ ≫ p₁_Q = g₁ := hPb_Q_flip.lift_snd _ _ _
      have hPb_q₁ : CategoryTheory.IsPullback (V'₁_open.ι ≫ π_V) q₁ q
          (AlgebraicGeometry.Spec.map φ_Q_cat) := by
        refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_Q_flip
        · rwa [hq₁_p₁]
        · exact hq₁_φQ.symm
      have _ : AlgebraicGeometry.Etale q₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₁ hEtQ
      have hv₁_pt : (AlgebraicGeometry.Spec.map φ_Q_cat).base (q₁.base v₁) = q.base v₀ := by
        calc (AlgebraicGeometry.Spec.map φ_Q_cat).base (q₁.base v₁)
            = (q₁ ≫ AlgebraicGeometry.Spec.map φ_Q_cat).base v₁ := rfl
          _ = ((V'₁_open.ι ≫ π_V) ≫ q).base v₁ := by rw [hq₁_φQ]
          _ = q.base (π_V.base w₀) := rfl
          _ = q.base v₀ := by rw [hw₀_V]
      have hcomap_v₁ : Ideal.comap φ_Q_cat.hom (q₁.base v₁).asIdeal = (q.base v₀).asIdeal :=
        congrArg PrimeSpectrum.asIdeal hv₁_pt

      obtain ⟨U_C, hUC, hzUC, hUC_W⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := W) hzW
      have hv₁_pre : v₁ ∈ e_C₁ ⁻¹ᵁ U_C := by
        change eC_tilde.base w₀ ∈ U_C
        rwa [hw₀_X]
      obtain ⟨W'', hW'', hv₁W'', hW''_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := v₁) (U := e_C₁ ⁻¹ᵁ U_C) hv₁_pre
      let R_C := ↑(X.presheaf.obj (Opposite.op U_C))
      let S := ↑(V'₁.presheaf.obj (Opposite.op W''))
      let φ_C : R_C →+* S := (e_C₁.appLE U_C W'' hW''_le).hom
      have hφC_etale : φ_C.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) e_C₁ inferInstance
          ⟨U_C, hUC⟩ ⟨W'', hW''⟩ hW''_le
      have _ : AlgebraicGeometry.IsOpenImmersion hW''.fromSpec := hW''.isOpenImmersion_fromSpec
      have _ : AlgebraicGeometry.IsOpenImmersion hUC.fromSpec := hUC.isOpenImmersion_fromSpec
      let pt_w : PrimeSpectrum S := hW''.primeIdealOf ⟨v₁, hv₁W''⟩
      let q₀ : Ideal S := pt_w.asIdeal
      have _ : q₀.IsPrime := pt_w.isPrime
      have hpt_w_img : hW''.fromSpec.base pt_w = v₁ := hW''.fromSpec_primeIdealOf ⟨v₁, hv₁W''⟩
      have hSpec_φC := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec e_C₁ hUC hW'' hW''_le
      have hcomap_C : Ideal.comap φ_C q₀ = (hUC.primeIdealOf ⟨z, hzUC⟩).asIdeal := by
        have hbase := congrArg (fun m => m.base pt_w) hSpec_φC
        change hUC.fromSpec.base ((AlgebraicGeometry.Spec.map (e_C₁.appLE U_C W'' hW''_le)).base pt_w) =
          e_C₁.base (hW''.fromSpec.base pt_w) at hbase
        rw [hpt_w_img] at hbase
        have heC₁_v₁ : e_C₁.base v₁ = z := hw₀_X
        have hzr : hUC.fromSpec.base (hUC.primeIdealOf ⟨z, hzUC⟩) = z :=
          hUC.fromSpec_primeIdealOf ⟨z, hzUC⟩
        rw [heC₁_v₁, ← hzr] at hbase
        have hEqPt := hUC.fromSpec.isOpenEmbedding.injective hbase
        exact (PrimeSpectrum.comap_asIdeal φ_C pt_w).symm.trans (congrArg PrimeSpectrum.asIdeal hEqPt)
      let e_Q_S : AlgebraicGeometry.Spec (V'₁.presheaf.obj (Opposite.op W'')) ⟶
          AlgebraicGeometry.Spec Q₁ := hW''.fromSpec ≫ q₁
      have hEt_eQS : AlgebraicGeometry.Etale e_Q_S := inferInstance
      let φ_Q_mor : Q₁ ⟶ V'₁.presheaf.obj (Opposite.op W'') :=
        AlgebraicGeometry.Spec.preimage e_Q_S
      have hSpec_φQ : AlgebraicGeometry.Spec.map φ_Q_mor = e_Q_S :=
        AlgebraicGeometry.Spec.map_preimage e_Q_S
      let φ_Q : (MvPolynomial (Fin 2) ↑R'₁ ⧸ I₁) →+* S := φ_Q_mor.hom
      have hφQ_etale : φ_Q.Etale :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp
          (hSpec_φQ.symm ▸ hEt_eQS)
      have hcomap_Q : Ideal.comap φ_Q q₀ = (q₁.base v₁).asIdeal := by
        have hbase := congrArg (fun m => m.base pt_w) hSpec_φQ
        change (AlgebraicGeometry.Spec.map φ_Q_mor).base pt_w = q₁.base (hW''.fromSpec.base pt_w) at hbase
        rw [hpt_w_img] at hbase
        exact (PrimeSpectrum.comap_asIdeal φ_Q pt_w).symm.trans (congrArg PrimeSpectrum.asIdeal hbase)
      have hXi₁ : ∀ i : Fin 2, φ_Q (Ideal.Quotient.mk I₁ (MvPolynomial.X i)) ∈ q₀ := by
        intro i
        change Ideal.Quotient.mk I₁ (MvPolynomial.X i) ∈ Ideal.comap φ_Q q₀
        rw [hcomap_Q, ← hφQ_X i]
        change Ideal.Quotient.mk I_nod (MvPolynomial.X i) ∈ Ideal.comap φ_Q_cat.hom (q₁.base v₁).asIdeal
        rw [hcomap_v₁]
        exact hXi i
      have hCh₁ : φ_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C h₁)) ∈ q₀ := by
        change Ideal.Quotient.mk I₁ (MvPolynomial.C h₁) ∈ Ideal.comap φ_Q q₀
        rw [hcomap_Q, ← hφQ_C h]
        change Ideal.Quotient.mk I_nod (MvPolynomial.C h) ∈ Ideal.comap φ_Q_cat.hom (q₁.base v₁).asIdeal
        rw [hcomap_v₁]
        exact hCh
      obtain ⟨hStep, hNoChain, hThreeMin⟩ :=
        (hRoofAlg ↑R₀ R_C).2 ↑R'₁ S h₁ φ_C φ_Q hφC_etale hφQ_etale q₀ hXi₁ hCh₁
      rw [hcomap_C] at hNoChain hThreeMin
      exact ⟨U_C, hUC, hzUC, hUC_W, hStep, hNoChain, hThreeMin⟩

  obtain ⟨hDimX, hTwoX, hOneX⟩ := hNoethBridge X hLocX
  let F_set : Set C.left := {c : C.left | f.left.base c = s₀}
  let e_fib : ↥X ≃ₜ ↥F_set := f.left.fiberHomeo s₀
  have hPreComp : ∀ E ∈ irreducibleComponents ↥F_set,
      e_fib ⁻¹' E ∈ irreducibleComponents ↥X := by
    intro E hE
    refine preimage_mem_irreducibleComponents_of_isPreirreducible_fiber
      hE e_fib.continuous e_fib.isOpenMap ?_ ?_
    · intro y
      have hfib : e_fib ⁻¹' ({y} : Set ↥F_set) = {e_fib.symm y} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact (e_fib.toEquiv.eq_symm_apply).symm
      rw [hfib]
      exact (isIrreducible_singleton (x := e_fib.symm y)).isPreirreducible
    · obtain ⟨y, hyE⟩ := hE.1.1
      exact ⟨y, hyE, e_fib.symm y, e_fib.apply_symm_apply y⟩
  have hPreEq : ∀ {E₁ E₂ : Set ↥F_set}, e_fib ⁻¹' E₁ = e_fib ⁻¹' E₂ → E₁ = E₂ :=
    fun h => e_fib.surjective.preimage_injective h

  refine ⟨?_, ?_, ?_⟩
  · intro E hE
    have hE' : e_fib ⁻¹' E ∈ irreducibleComponents ↥X := hPreComp E hE
    let e_sub : ↥(e_fib ⁻¹' E) ≃ₜ ↥E :=
      { toFun := fun x => ⟨e_fib x.1, x.2⟩
        invFun := fun y => ⟨e_fib.symm y.1, by simp [y.2]⟩
        left_inv := fun x => Subtype.ext (e_fib.symm_apply_apply x.1)
        right_inv := fun y => Subtype.ext (e_fib.apply_symm_apply y.1)
        continuous_toFun := (e_fib.continuous.comp continuous_subtype_val).subtype_mk (fun x => x.2)
        continuous_invFun := (e_fib.symm.continuous.comp continuous_subtype_val).subtype_mk
          (fun y => by change e_fib (e_fib.symm y.1) ∈ E; rw [e_fib.apply_symm_apply]; exact y.2) }
    rw [← e_sub.isHomeomorph.topologicalKrullDim_eq]
    exact hDimX (e_fib ⁻¹' E) hE'
  · intro c hc E₁ E₂ E₃ hE₁ hE₂ hE₃ hy₁ hy₂ hy₃ hDist
    let y : ↥F_set := ⟨c, hc⟩
    let z : ↥X := e_fib.symm y
    have hz₁ : z ∈ e_fib ⁻¹' E₁ := by change e_fib (e_fib.symm y) ∈ E₁; rwa [e_fib.apply_symm_apply]
    have hz₂ : z ∈ e_fib ⁻¹' E₂ := by change e_fib (e_fib.symm y) ∈ E₂; rwa [e_fib.apply_symm_apply]
    have hz₃ : z ∈ e_fib ⁻¹' E₃ := by change e_fib (e_fib.symm y) ∈ E₃; rwa [e_fib.apply_symm_apply]
    exact hTwoX z (e_fib ⁻¹' E₁) (e_fib ⁻¹' E₂) (e_fib ⁻¹' E₃)
      (hPreComp E₁ hE₁) (hPreComp E₂ hE₂) (hPreComp E₃ hE₃) hz₁ hz₂ hz₃
      ⟨fun h12 => hDist.1 (hPreEq h12),
       fun h13 => hDist.2.1 (hPreEq h13),
       fun h23 => hDist.2.2 (hPreEq h23)⟩
  · intro j hs_tau E₁ E₂ hE₁ hE₂ hy₁ hy₂
    let y_j : ↥F_set := ⟨(τ j).left.base s₀, hs_tau⟩
    let z_j : ↥X := e_fib.symm y_j
    have hz_j_base : ι₁.base z_j = (τ j).left.base s₀ :=
      f.left.fiberι_fiberHomeo_symm s₀ y_j
    obtain ⟨V_j, hτVj, hSmVj⟩ := hCurve.2.2.2.2.2.2.2.2.1 j s₀
    obtain ⟨U_C, hUC, hzUC, _, g_poly, hg_et⟩ :=
      hSmoothChart V_j ⊤ z_j (hz_j_base ▸ hτVj) trivial hSmVj
    let R_C := ↑(X.presheaf.obj (Opposite.op U_C))
    let _ : Algebra (Polynomial ↑R₀) R_C := g_poly.toAlgebra
    have _ : Algebra.Etale (Polynomial ↑R₀) R_C := hg_et.toAlgebra
    have hIdEt : (RingHom.id R_C).Etale := RingHom.Etale.of_bijective Function.bijective_id
    obtain ⟨_, _, hOneMin⟩ :=
      (hRoofAlg ↑R₀ R_C).1 R_C (RingHom.id R_C) hIdEt (hUC.primeIdealOf ⟨z_j, hzUC⟩).asIdeal
    have hz₁ : z_j ∈ e_fib ⁻¹' E₁ := by
      change e_fib (e_fib.symm y_j) ∈ E₁; rwa [e_fib.apply_symm_apply]
    have hz₂ : z_j ∈ e_fib ⁻¹' E₂ := by
      change e_fib (e_fib.symm y_j) ∈ E₂; rwa [e_fib.apply_symm_apply]
    exact hPreEq (hOneX z_j U_C hUC hzUC
      (fun m₁ hm₁ m₂ hm₂ hm₁_le hm₂_le =>
        hOneMin m₁ hm₁ m₂ hm₂ (by simpa using hm₁_le) (by simpa using hm₂_le))
      (e_fib ⁻¹' E₁) (e_fib ⁻¹' E₂) (hPreComp E₁ hE₁) (hPreComp E₂ hE₂) hz₁ hz₂)

