    have hOpenΦ₃ : AlgebraicGeometry.IsOpenImmersion Φ₃ := by
      rw [← hΦ₃'_fac]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        Φ₃' P_U₃.ι inferInstance inferInstance
    have hRangeΦ₃ : Set.range Φ₃.base =
        (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹' (U₃ : Set B₃.left) := by
      rw [← hΦ₃'_fac]
      have hSurjΦ₃' : Function.Surjective Φ₃'.base :=
        (AlgebraicGeometry.Scheme.homeoOfIso (asIso Φ₃')).surjective
      ext p
      constructor
      · rintro ⟨v, rfl⟩
        have hp : P_U₃.ι.base (Φ₃'.base v) ∈ Set.range P_U₃.ι.base := ⟨_, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hp
        change (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base
            ((Φ₃' ≫ P_U₃.ι).base v) ∈ (U₃ : Set B₃.left)
        have h_pt : (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base
            ((Φ₃' ≫ P_U₃.ι).base v) =
            (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base
              (P_U₃.ι.base (Φ₃'.base v)) := by simp
        rw [h_pt]
        exact hp
      · intro hp
        have hp' : p ∈ Set.range P_U₃.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]; exact hp
        obtain ⟨q, rfl⟩ := hp'
        obtain ⟨v, rfl⟩ := hSurjΦ₃' q
        exact ⟨v, by simp⟩
    refine ⟨ι₃, hcomm, hOpenΦ₃, hRangeΦ₃, ?_⟩
    intro j
    have hs₃_range : Set.range (U₃.ι ≫ (τ₃ j).left).base ⊆ Set.range V₃.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      change g₃.left.base ((U₃.ι ≫ (τ₃ j).left).base u) ∈ (U₃ : Set B₃.left)
      have h_pt : g₃.left.base ((U₃.ι ≫ (τ₃ j).left).base u) = U₃.ι.base u := by
        calc g₃.left.base ((U₃.ι ≫ (τ₃ j).left).base u)
            = (U₃.ι ≫ ((τ₃ j).left ≫ g₃.left)).base u := by simp
          _ = U₃.ι.base u := by rw [hSec₃ j, Category.comp_id]
      rw [h_pt]
      have hu : U₃.ι.base u ∈ Set.range U₃.ι.base := ⟨u, rfl⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hu
    let s₃ : U₃.toScheme ⟶ V₃.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V₃.ι (U₃.ι ≫ (τ₃ j).left) hs₃_range
    have hs₃_fac : s₃ ≫ V₃.ι = U₃.ι ≫ (τ₃ j).left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V₃.ι (U₃.ι ≫ (τ₃ j).left) hs₃_range
    refine ⟨s₃, hs₃_fac, ?_⟩
    let W_U₃ (a : Fin N) : U₃.toScheme.Opens := (TopologicalSpace.Opens.map U₃.ι.base).obj (W a)
    have hSupWU₃ : iSup W_U₃ = ⊤ := by
      ext u
      simp only [W_U₃, TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top,
        Set.mem_iUnion, SetLike.mem_coe, Set.mem_univ, iff_true]
      have hu : U₃.ι.base u ∈ (⋃ a : Fin N, (W a : Set B₃.left)) := by rw [hCover]; trivial
      obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hu
      exact ⟨a, ha⟩
    let 𝒰_U₃ := U₃.toScheme.openCoverOfIsOpenCover W_U₃ (TopologicalSpace.IsOpenCover.mk hSupWU₃)
    apply 𝒰_U₃.hom_ext
    intro a
    let a' : Fin N := a
    change (W_U₃ a').ι ≫ (s₃ ≫ ι₃) = (W_U₃ a').ι ≫ (U₃.ι ≫ ψ₃.left ≫ (σ j).left)
    have hd_eq : Set.range ((W_U₃ a').ι ≫ U₃.ι).base = Set.range (W a' ⊓ U₃).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext b
      constructor
      · rintro ⟨w, rfl⟩
        refine ⟨?_, ?_⟩
        · have hw : (W_U₃ a').ι.base w ∈ Set.range (W_U₃ a').ι.base := ⟨w, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw
          change ((W_U₃ a').ι ≫ U₃.ι).base w ∈ (W a' : Set B₃.left)
          have h_pt : ((W_U₃ a').ι ≫ U₃.ι).base w = U₃.ι.base ((W_U₃ a').ι.base w) := by simp
          rw [h_pt]
          exact hw
        · have hu : U₃.ι.base ((W_U₃ a').ι.base w) ∈ Set.range U₃.ι.base := ⟨_, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hu
          change ((W_U₃ a').ι ≫ U₃.ι).base w ∈ (U₃ : Set B₃.left)
          have h_pt : ((W_U₃ a').ι ≫ U₃.ι).base w = U₃.ι.base ((W_U₃ a').ι.base w) := by simp
          rw [h_pt]
          exact hu
      · rintro ⟨hb_W, hb_U₃⟩
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hb_U₃
        obtain ⟨u, rfl⟩ := hb_U₃
        have hu_W : u ∈ (W_U₃ a' : Set U₃.toScheme) := hb_W
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hu_W
        obtain ⟨w, rfl⟩ := hu_W
        exact ⟨w, by simp⟩
    let d_a : (W_U₃ a').toScheme ≅ (W a' ⊓ U₃).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ((W_U₃ a').ι ≫ U₃.ι) (W a' ⊓ U₃).ι hd_eq
    have hd_a_fac : d_a.hom ≫ (W a' ⊓ U₃).ι = (W_U₃ a').ι ≫ U₃.ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac ((W_U₃ a').ι ≫ U₃.ι) (W a' ⊓ U₃).ι hd_eq
    have hr_range : Set.range ((W_U₃ a').ι ≫ s₃).base ⊆ Set.range (U_chart a').ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      change (V₃.ι ≫ g₃.left).base (((W_U₃ a').ι ≫ s₃).base w) ∈ (W a' : Set B₃.left)
      have h_pt : (V₃.ι ≫ g₃.left).base (((W_U₃ a').ι ≫ s₃).base w) =
          U₃.ι.base ((W_U₃ a').ι.base w) := by
        calc (V₃.ι ≫ g₃.left).base (((W_U₃ a').ι ≫ s₃).base w)
            = ((W_U₃ a').ι ≫ (s₃ ≫ V₃.ι) ≫ g₃.left).base w := by simp
          _ = ((W_U₃ a').ι ≫ U₃.ι ≫ ((τ₃ j).left ≫ g₃.left)).base w := by
              rw [hs₃_fac]; simp only [Category.assoc]
          _ = U₃.ι.base ((W_U₃ a').ι.base w) := by rw [hSec₃ j, Category.comp_id]; simp
      rw [h_pt]
      have hw : (W_U₃ a').ι.base w ∈ Set.range (W_U₃ a').ι.base := ⟨w, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw
      exact hw
    let r_a : (W_U₃ a').toScheme ⟶ (U_chart a').toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (U_chart a').ι ((W_U₃ a').ι ≫ s₃) hr_range
    have hr_a_fac : r_a ≫ (U_chart a').ι = (W_U₃ a').ι ≫ s₃ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (U_chart a').ι ((W_U₃ a').ι ≫ s₃) hr_range
    obtain ⟨_, _, _, hSecLoc1⟩ := hClause1 a'
    obtain ⟨s_a, hs_a1, hs_a2⟩ := hSecLoc1 j
    have hr_eq : r_a ≫ (e_V a').hom = d_a.hom ≫ s_a := by
      have _ := hOpenChart a'
      have _ : CategoryTheory.Mono ((V_loc a').ι ≫ ι_chart a') := mono_comp _ _
      rw [← cancel_mono ((V_loc a').ι ≫ ι_chart a')]
      calc (r_a ≫ (e_V a').hom) ≫ ((V_loc a').ι ≫ ι_chart a')
          = r_a ≫ ((e_V a').hom ≫ (V_loc a').ι ≫ ι_chart a') := by simp only [Category.assoc]
        _ = (r_a ≫ (U_chart a').ι) ≫ V₃.ι := by rw [he_V a', Category.assoc]
        _ = (W_U₃ a').ι ≫ (s₃ ≫ V₃.ι) := by rw [hr_a_fac, Category.assoc]
        _ = ((W_U₃ a').ι ≫ U₃.ι) ≫ (τ₃ j).left := by rw [hs₃_fac, Category.assoc]
        _ = (d_a.hom ≫ (W a' ⊓ U₃).ι) ≫ (τ₃ j).left := by rw [hd_a_fac]
        _ = d_a.hom ≫ B₃.left.homOfLE inf_le_left ≫ ((W a').ι ≫ (τ₃ j).left) := by
            rw [← AlgebraicGeometry.Scheme.homOfLE_ι B₃.left (inf_le_left : W a' ⊓ U₃ ≤ W a')]
            simp only [Category.assoc]
        _ = d_a.hom ≫ (B₃.left.homOfLE inf_le_left ≫ τ_loc a' j) ≫ ι_chart a' := by
            rw [hSecChart a' j]; simp only [Category.assoc]
        _ = d_a.hom ≫ (s_a ≫ (V_loc a').ι) ≫ ι_chart a' := by rw [← hs_a1]
        _ = (d_a.hom ≫ s_a) ≫ ((V_loc a').ι ≫ ι_chart a') := by simp only [Category.assoc]
    calc (W_U₃ a').ι ≫ (s₃ ≫ ι₃)
        = ((W_U₃ a').ι ≫ s₃) ≫ ι₃ := by simp only [Category.assoc]
      _ = r_a ≫ ((U_chart a').ι ≫ ι₃) := by rw [← hr_a_fac, Category.assoc]
      _ = (r_a ≫ (e_V a').hom) ≫ ι_loc a' := by rw [hι₃_chart a', Category.assoc]
      _ = d_a.hom ≫ (s_a ≫ ι_loc a') := by rw [hr_eq, Category.assoc]
      _ = (d_a.hom ≫ (W a' ⊓ U₃).ι) ≫ ψ₃.left ≫ (σ j).left := by
            rw [hs_a2]; simp only [Category.assoc]
      _ = (W_U₃ a').ι ≫ (U₃.ι ≫ ψ₃.left ≫ (σ j).left) := by
            rw [hd_a_fac]; simp only [Category.assoc]
  exact ⟨C₃, g₃, τ₃, hStab₃, hIntC₃, hIso₃⟩

theorem weil_normal_base_local_stable_curve_gluing (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₃ : B₃.left.Opens)
    (ψ₃ : B₃ ⟶ B₂)
    (hIntB₃ : AlgebraicGeometry.IsIntegral B₃.left)
    (hProjB₃ : IsProjectiveOverField k B₃)
    (hNormB₃ : ∀ U : B₃.left.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      IsIntegrallyClosed ↑(B₃.left.presheaf.obj (Opposite.op U)))
    (hU₃ : Nonempty U₃)
    (hU₃Sub : (U₃ : Set B₃.left) ⊆ ψ₃.left.base ⁻¹' (U₂ : Set B₂.left))
    (N : ℕ)
    (W : Fin N → B₃.left.Opens)
    (hCover : (⋃ a : Fin N, (W a : Set B₃.left)) = Set.univ)
    (hWNonempty : ∀ a : Fin N, Nonempty ↥(W a))
    (C_loc : Fin N → AlgebraicGeometry.Scheme.{u})
    (g_loc : ∀ a : Fin N, C_loc a ⟶ (W a).toScheme)
    (τ_loc : ∀ a : Fin N, Fin n → ((W a).toScheme ⟶ C_loc a))
    (hStabLoc : ∀ a : Fin N, IsGeometricStablePointedCurve (g_loc a) n (τ_loc a))
    (hIsoLoc : ∀ a : Fin N, HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ (W a) (g_loc a) (τ_loc a))
    (hBridge : HasLocalCurveIsoMatrixBridge k)
    (hDvrExt : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
      (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
      (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂)),
      IsGeometricStablePointedCurve g₁ n τ₁ →
      IsGeometricStablePointedCurve g₂ n τ₂ →
      let η_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g₁ η_K) →
      ∀ (φ_K : CategoryTheory.Limits.pullback g₁ η_K ≅ CategoryTheory.Limits.pullback g₂ η_K),
        φ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
          CategoryTheory.Limits.pullback.snd g₁ η_K →
        (∀ j : Fin n, ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
            CategoryTheory.Limits.pullback g₁ η_K),
          s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ η_K = η_K ≫ τ₁ j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ η_K =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
          (s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_K = η_K ≫ τ₂ j) →
        ∃ (φ : C₁ ≅ C₂),
          φ.hom ≫ g₂ = g₁ ∧
          (∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j) ∧
          CategoryTheory.Limits.pullback.fst g₁ η_K ≫ φ.hom =
            φ_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K)
    (hHartogs : ∀ (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
      [IsIntegrallyClosed B₀] (L : Type u) [Field L] [Algebra B₀ L] [IsFractionRing B₀ L]
      (r : ℕ) (M : Matrix.GeneralLinearGroup (Fin r) L),
      (∀ (p : PrimeSpectrum B₀),
        p.asIdeal ≠ ⊥ →
        IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) →
        ∀ i j : Fin r,
          (∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * M.val i j = algebraMap B₀ L a) ∧
          (∃ a b : B₀, b ∉ p.asIdeal ∧ algebraMap B₀ L b * (M⁻¹).val i j = algebraMap B₀ L a)) →
      ∃ M₀ : Matrix.GeneralLinearGroup (Fin r) B₀,
        ∀ i j : Fin r, algebraMap B₀ L (M₀.val i j) = M.val i j) :
    ∃ (C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (g₃ : C₃ ⟶ B₃)
      (τ₃ : Fin n → (B₃ ⟶ C₃)),
      IsGeometricStablePointedCurve g₃.left n (fun j => (τ₃ j).left) ∧
      AlgebraicGeometry.IsIntegral C₃.left ∧
      HasOpenPointedCurvePullbackIsoOver k f₂ σ ψ₃ U₃ g₃ τ₃ :=
by
  obtain ⟨hFTB₃, hLocProps⟩ :=
    weil_projective_base_finiteType_and_local_curve_isIntegral k B₂ U₂ X₂ f₂ n σ hFib₂
      B₃ U₃ ψ₃ hIntB₃ hProjB₃ hU₃ hU₃Sub
  have hSmLoc : ∀ a : Fin N,
      let U_Wa : (W a).toScheme.Opens := (TopologicalSpace.Opens.map (W a).ι.base).obj U₃
      AlgebraicGeometry.SmoothOfRelativeDimension 1 ((g_loc a) ∣_ U_Wa) :=
    fun a => (hLocProps (W a) (hWNonempty a) (C_loc a) (g_loc a) (τ_loc a)
      (hStabLoc a) (hIsoLoc a)).1
  have hIntLoc : ∀ a : Fin N, AlgebraicGeometry.IsIntegral (C_loc a) :=
    fun a => (hLocProps (W a) (hWNonempty a) (C_loc a) (g_loc a) (τ_loc a)
      (hStabLoc a) (hIsoLoc a)).2
  have hStabPull : ∀ (C S S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (u : S' ⟶ S) (τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g u)),
      IsGeometricStablePointedCurve g n τ →
      (∀ j : Fin n,
        τ' j ≫ CategoryTheory.Limits.pullback.fst g u = u ≫ τ j ∧
        τ' j ≫ CategoryTheory.Limits.pullback.snd g u = 𝟙 S') →
      IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g u) n τ' :=
    fun C S S' g τ u τ' hStab hτ' =>
      (weil_isGeometricStablePointedCurve_baseChange_and_dominant n C S g τ hStab).1 S' u τ' hτ'
  have hStabIso : ∀ (C S C' S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (g' : C' ⟶ S') (τ' : Fin n → (S' ⟶ C')) (e_C : C ≅ C') (e_S : S ≅ S'),
      IsGeometricStablePointedCurve g n τ →
      e_C.hom ≫ g' = g ≫ e_S.hom →
      (∀ j : Fin n, τ' j = e_S.inv ≫ τ j ≫ e_C.hom) →
      IsGeometricStablePointedCurve g' n τ' :=
    fun C S C' S' g τ g' τ' e_C e_S hStab hcomm hτ' =>
      (weil_isGeometricStablePointedCurve_baseChange_and_dominant n C S g τ hStab).2.1
        C' S' g' τ' e_C e_S hcomm hτ'
  have hDomPull : ∀ (C S S' : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (u : S' ⟶ S),
      IsGeometricStablePointedCurve g n τ →
      AlgebraicGeometry.IsDominant u →
      AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g u) :=
    fun C S S' g τ u hStab hDom =>
      (weil_isGeometricStablePointedCurve_baseChange_and_dominant n C S g τ hStab).2.2 S' u hDom
  have hAffExt :=
    weil_affine_normal_stable_curve_iso_extension k n hBridge hDvrExt hHartogs hStabPull hDomPull
  obtain ⟨ι_loc, φ, hC1, hC2, hC3, hC4, hC5, hC6⟩ :=
    weil_overlap_pointed_iso_cocycle_from_affine_ext k B₂ X₂ f₂ n σ B₃ U₃ ψ₃
      hIntB₃ hFTB₃ hNormB₃ hU₃ N W hWNonempty C_loc g_loc τ_loc
      hStabLoc hIntLoc hSmLoc hIsoLoc hStabPull hStabIso hDomPull hAffExt
  exact weil_glue_local_stable_curves_along_cocycle k B₂ X₂ f₂ n σ hFib₂.1 B₃ U₃ ψ₃
    hIntB₃ hU₃ N W hCover hWNonempty C_loc g_loc τ_loc hStabLoc hIntLoc
    ι_loc φ hC1 hC2 hC3 hC4 hC5 hC6

theorem weil_gl_proj_bundle_atlas_to_isProjectiveOverField (k : Type u) [Field k] [IsAlgClosed k]
    (B₃ C₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntB₃ : AlgebraicGeometry.IsIntegral B₃.left)
    (hProjB₃ : IsProjectiveOverField k B₃)
    (g₃ : C₃ ⟶ B₃)
    (hAtlas : HasGLProjBundleAtlas g₃.left) :
    IsProjectiveOverField k C₃ :=
by
  have hIrrelGen : ∀ (K : Type u) [CommRing K] (N : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range MvPolynomial.X) := by
    intro K _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.toIdeal_irrelevant_le]
    intro d hd P hP
    have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hP
    rw [MvPolynomial.as_sum P]
    refine Ideal.sum_mem _ fun m hm => ?_
    have hm_ne : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
    have hm_deg : (∑ a : Fin (N + 1), m a) = d := by
      have hw := hP_hom hm_ne
      rw [Finsupp.weight_apply, Finsupp.sum_fintype m _ (fun _ => by simp)] at hw
      simpa [smul_eq_mul, mul_one] using hw
    have hex : ∃ a₀ : Fin (N + 1), m a₀ ≠ 0 := by
      by_contra h_all
      have h0 : (∑ a : Fin (N + 1), m a) = 0 :=
        Finset.sum_eq_zero fun a _ => Classical.not_not.mp fun h => h_all ⟨a, h⟩
      omega
    obtain ⟨a₀, ha₀_ne⟩ := hex
    have ha₀_le : Finsupp.single a₀ 1 ≤ m := by
      intro b
      by_cases hb : b = a₀
      · subst hb; simp; omega
      · rw [Finsupp.single_eq_of_ne hb]; exact Nat.zero_le _
    have hm_split : (m - Finsupp.single a₀ 1) + Finsupp.single a₀ 1 = m :=
      tsub_add_cancel_of_le ha₀_le
    have h_mon : (MvPolynomial.monomial m) (P.coeff m) =
        (MvPolynomial.monomial (m - Finsupp.single a₀ 1)) (P.coeff m) * MvPolynomial.X a₀ := by
      rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, hm_split]
    rw [h_mon]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a₀, rfl⟩)

  have hPart1 : ∀ (k : Type u) [Field k]
      (S : AlgebraicGeometry.Scheme.{u}) (_hNonempty : Nonempty ↥S)
      (N₃ s₀ : ℕ)
      (𝒜_P : ℕ → Submodule k (MvPolynomial (Fin (N₃ + 1)) k))
      [GradedRing 𝒜_P]
      (_hIrrel : (HomogeneousIdeal.irrelevant 𝒜_P).toIdeal ≤ Ideal.span (Set.range MvPolynomial.X))
      (_hX : ∀ ℓ : Fin (N₃ + 1), MvPolynomial.X ℓ ∈ 𝒜_P 1)
      (ι_B : S ⟶ AlgebraicGeometry.Proj 𝒜_P)
      (_hCl_B : AlgebraicGeometry.IsClosedImmersion ι_B)
      (U : Fin (s₀ + 1) → S.Opens)
      (_hAffU : ∀ α : Fin (s₀ + 1), AlgebraicGeometry.IsAffineOpen (U α))
      (_hCovU : (⋃ α : Fin (s₀ + 1), (U α : Set S)) = Set.univ),
      ∃ (s'₀ : ℕ) (U' : Fin (s'₀ + 1) → S.Opens) (μ : Fin (s'₀ + 1) → Fin (s₀ + 1))
        (u : ∀ (γ β : Fin (s'₀ + 1)), ↑(S.presheaf.obj (Opposite.op (U' β)))),
        (∀ β : Fin (s'₀ + 1), U' β ≤ U (μ β)) ∧
        (∀ β : Fin (s'₀ + 1), AlgebraicGeometry.IsAffineOpen (U' β)) ∧
        (⋃ β : Fin (s'₀ + 1), (U' β : Set S)) = Set.univ ∧
        (∀ β : Fin (s'₀ + 1), u β β = 1) ∧
        (∀ β γ : Fin (s'₀ + 1), U' β ⊓ U' γ = S.basicOpen (u γ β)) ∧
        (∀ α β γ : Fin (s'₀ + 1),
          (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u γ β) *
            (S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u α γ) =
            (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u α β)) := by
    intro k _ S hNonempty N₃ s₀ 𝒜_P _ hIrrel hX ι_B hCl_B U hAffU hCovU
    classical
    haveI : AlgebraicGeometry.IsClosedImmersion ι_B := hCl_B
    let P := AlgebraicGeometry.Proj 𝒜_P
    have hInd : Topology.IsInducing ι_B.base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_B).isInducing
    have hLiftOpen : ∀ α : Fin (s₀ + 1), ∃ W : P.Opens,
        (TopologicalSpace.Opens.map ι_B.base).obj W = U α := by
      intro α
      obtain ⟨t, ht_open, ht_pre⟩ := hInd.isOpen_iff.mp (U α).isOpen
      refine ⟨⟨t, ht_open⟩, ?_⟩
      ext x
      exact Set.ext_iff.mp ht_pre x
    choose W hW using hLiftOpen
    have hTopX : (⨆ ℓ : Fin (N₃ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_P (MvPolynomial.X ℓ)) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_P MvPolynomial.X hIrrel
    have hPointwise : ∀ x : S,
        ∃ (α : Fin (s₀ + 1)) (d : ℕ) (G : MvPolynomial (Fin (N₃ + 1)) k),
          0 < d ∧ G ∈ 𝒜_P d ∧
          ι_B.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_P G ∧
          AlgebraicGeometry.Proj.basicOpen 𝒜_P G ≤ W α := by
      intro x
      have hxU : x ∈ ⋃ α : Fin (s₀ + 1), (U α : Set S) := by rw [hCovU]; trivial
      obtain ⟨α, hxα⟩ := Set.mem_iUnion.mp hxU
      have hxW : ι_B.base x ∈ W α := by
        change x ∈ (TopologicalSpace.Opens.map ι_B.base).obj (W α)
        rwa [hW α]
      have hxTop : ι_B.base x ∈ (⨆ ℓ : Fin (N₃ + 1),
          AlgebraicGeometry.Proj.basicOpen 𝒜_P (MvPolynomial.X ℓ)) := by
        rw [hTopX]; trivial
      obtain ⟨ℓ, hxℓ⟩ := TopologicalSpace.Opens.mem_iSup.mp hxTop
      have hxInf : ι_B.base x ∈ W α ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_P (MvPolynomial.X ℓ) :=
        ⟨hxW, hxℓ⟩
      obtain ⟨_, ⟨f, rfl⟩, hxf, hf_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Proj.isBasis_basicOpen 𝒜_P)) hxInf
      have hxf' : ι_B.base x ∈ ⨆ i : ℕ,
          AlgebraicGeometry.Proj.basicOpen 𝒜_P (GradedRing.proj 𝒜_P i f) := by
        rwa [← AlgebraicGeometry.Proj.basicOpen_eq_iSup_proj 𝒜_P f]
      obtain ⟨i, hxi⟩ := TopologicalSpace.Opens.mem_iSup.mp hxf'
      let h_i := GradedRing.proj 𝒜_P i f
      have hh_mem : h_i ∈ 𝒜_P i := SetLike.coe_mem ((DirectSum.decompose 𝒜_P f) i)
      have hh_le : AlgebraicGeometry.Proj.basicOpen 𝒜_P h_i ≤
          W α ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜_P (MvPolynomial.X ℓ) := by
        refine le_trans ?_ hf_le
        rw [AlgebraicGeometry.Proj.basicOpen_eq_iSup_proj 𝒜_P f]
        exact le_iSup (fun j : ℕ => AlgebraicGeometry.Proj.basicOpen 𝒜_P (GradedRing.proj 𝒜_P j f)) i
      let G := h_i * MvPolynomial.X ℓ
      have hG_mem : G ∈ 𝒜_P (i + 1) :=
        SetLike.GradedMonoid.toGradedMul.mul_mem hh_mem (hX ℓ)
      have hG_open : AlgebraicGeometry.Proj.basicOpen 𝒜_P G =
          AlgebraicGeometry.Proj.basicOpen 𝒜_P h_i ⊓
            AlgebraicGeometry.Proj.basicOpen 𝒜_P (MvPolynomial.X ℓ) :=
        AlgebraicGeometry.Proj.basicOpen_mul 𝒜_P h_i (MvPolynomial.X ℓ)
      refine ⟨α, i + 1, G, Nat.succ_pos i, hG_mem, ?_, ?_⟩
      · rw [hG_open]
        exact ⟨hxi, hxℓ⟩
      · rw [hG_open]
        exact le_trans inf_le_left (le_trans hh_le inf_le_left)
    choose α_pt d_pt G_pt hd_pos hG_mem hx_in hG_le using hPointwise
    have hCompUniv : IsCompact (Set.univ : Set S) := by
      rw [← hCovU]
      exact isCompact_iUnion (fun α => (hAffU α).isCompact)
    let V_pt : S → S.Opens := fun x =>
      (TopologicalSpace.Opens.map ι_B.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_P (G_pt x))
    have hCovV : (Set.univ : Set S) ⊆ ⋃ x : S, (V_pt x : Set S) := by
      intro x _
      exact Set.mem_iUnion.mpr ⟨x, hx_in x⟩
    obtain ⟨I, hICov⟩ := hCompUniv.elim_finite_subcover (fun x => (V_pt x : Set S))
      (fun x => (V_pt x).isOpen) hCovV
    have hI_nonempty : I.Nonempty := by
      obtain ⟨x₀⟩ := hNonempty
      have hx₀ := hICov (Set.mem_univ x₀)
      obtain ⟨y, hyI, _⟩ := Set.mem_iUnion₂.mp hx₀
      exact ⟨y, hyI⟩
    have hI_pos : 0 < I.card := Finset.card_pos.mpr hI_nonempty
    let s'₀ : ℕ := I.card - 1
    have hs'₀ : s'₀ + 1 = I.card := Nat.sub_add_cancel hI_pos
    let e_I : Fin (s'₀ + 1) ≃ ↥I :=
      (finCongr hs'₀).trans ((Fintype.equivFinOfCardEq (Fintype.card_coe I)).symm)
    let μ : Fin (s'₀ + 1) → Fin (s₀ + 1) := fun β => α_pt (e_I β).1
    let d_idx : Fin (s'₀ + 1) → ℕ := fun β => d_pt (e_I β).1
    let G_idx : Fin (s'₀ + 1) → MvPolynomial (Fin (N₃ + 1)) k := fun β => G_pt (e_I β).1
    let d₀ : ℕ := ∏ δ : Fin (s'₀ + 1), d_idx δ
    have hd₀_pos : 0 < d₀ := Finset.prod_pos (fun δ _ => hd_pos (e_I δ).1)
    let e_exp : Fin (s'₀ + 1) → ℕ := fun β => ∏ δ ∈ Finset.univ.erase β, d_idx δ
    have he_pos : ∀ β : Fin (s'₀ + 1), 0 < e_exp β :=
      fun β => Finset.prod_pos (fun δ _ => hd_pos (e_I δ).1)
    have he_mul : ∀ β : Fin (s'₀ + 1), e_exp β • d_idx β = d₀ := by
      intro β
      rw [smul_eq_mul, mul_comm]
      exact Finset.mul_prod_erase Finset.univ d_idx (Finset.mem_univ β)
    let F : Fin (s'₀ + 1) → MvPolynomial (Fin (N₃ + 1)) k := fun β => (G_idx β) ^ (e_exp β)
    have hF : ∀ β : Fin (s'₀ + 1), F β ∈ 𝒜_P d₀ := by
      intro β
      rw [← he_mul β]
      exact SetLike.pow_mem_graded (e_exp β) (hG_mem (e_I β).1)
    let D : Fin (s'₀ + 1) → P.Opens := fun β => AlgebraicGeometry.Proj.basicOpen 𝒜_P (F β)
    have hD_eq_G : ∀ β : Fin (s'₀ + 1),
        D β = AlgebraicGeometry.Proj.basicOpen 𝒜_P (G_idx β) :=
      fun β => AlgebraicGeometry.Proj.basicOpen_pow 𝒜_P (G_idx β) (e_exp β) (he_pos β)
    let U' : Fin (s'₀ + 1) → S.Opens := fun β => (TopologicalSpace.Opens.map ι_B.base).obj (D β)
    have hSub : ∀ β : Fin (s'₀ + 1), U' β ≤ U (μ β) := by
      intro β
      rw [← hW (μ β)]
      exact (TopologicalSpace.Opens.map ι_B.base).monotone
        ((hD_eq_G β).le.trans (hG_le (e_I β).1))
    have hAffD : ∀ β : Fin (s'₀ + 1), AlgebraicGeometry.IsAffineOpen (D β) :=
      fun β => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_P (F β) (hF β) hd₀_pos
    have hAffU' : ∀ β : Fin (s'₀ + 1), AlgebraicGeometry.IsAffineOpen (U' β) :=
      fun β => (hAffD β).preimage ι_B
    have hCovU' : (⋃ β : Fin (s'₀ + 1), (U' β : Set S)) = Set.univ := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      obtain ⟨y, hyI, hxy⟩ := Set.mem_iUnion₂.mp (hICov (Set.mem_univ x))
      refine ⟨e_I.symm ⟨y, hyI⟩, ?_⟩
      change x ∈ (TopologicalSpace.Opens.map ι_B.base).obj (D (e_I.symm ⟨y, hyI⟩))
      rw [hD_eq_G]
      dsimp only [G_idx]
      rw [e_I.apply_symm_apply]
      exact hxy
    let φ_spec (β : Fin (s'₀ + 1)) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_P (F β) (hF β) hd₀_pos
    let θ_hom (β : Fin (s'₀ + 1)) :
        CommRingCat.of (HomogeneousLocalization.Away 𝒜_P (F β)) ⟶
          P.presheaf.obj (Opposite.op (D β)) :=
      AlgebraicGeometry.Spec.preimage ((hAffD β).isoSpec.inv ≫ (φ_spec β).hom)
    let w_elem (γ β : Fin (s'₀ + 1)) : HomogeneousLocalization.Away 𝒜_P (F β) :=
      HomogeneousLocalization.Away.isLocalizationElem (hF β) (hF γ)
    let u_P (γ β : Fin (s'₀ + 1)) : ↑(P.presheaf.obj (Opposite.op (D β))) :=
      (θ_hom β).hom (w_elem γ β)
    let u (γ β : Fin (s'₀ + 1)) : ↑(S.presheaf.obj (Opposite.op (U' β))) :=
      (ι_B.app (D β)).hom (u_P γ β)
    have hu_id : ∀ β : Fin (s'₀ + 1), u β β = 1 := by
      intro β
      have hw1 : w_elem β β = 1 := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
        change (HomogeneousLocalization.Away.mk 𝒜_P (hF β) d₀ (F β ^ d₀) _).val = 1
        rw [HomogeneousLocalization.Away.val_mk]
        exact Localization.mk_self ⟨F β ^ d₀, Submonoid.pow_mem _ (Submonoid.mem_powers _) d₀⟩
      dsimp only [u, u_P]
      rw [hw1, map_one, map_one]
    have hu_basic : ∀ β γ : Fin (s'₀ + 1), U' β ⊓ U' γ = S.basicOpen (u γ β) := by
      intro β γ
      have hP_basic : D β ⊓ D γ = P.basicOpen (u_P γ β) := by
        have hSpec_map : AlgebraicGeometry.Spec.map (θ_hom β) =
            (hAffD β).isoSpec.inv ≫ (φ_spec β).hom :=
          AlgebraicGeometry.Spec.map_preimage _
        have h_away_eq : (φ_spec β).inv ≫ (hAffD β).isoSpec.hom ≫ (hAffD β).fromSpec =
            AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos := by
          have h_iso_from : (hAffD β).isoSpec.hom ≫ (hAffD β).fromSpec = (D β).ι := by
            dsimp only [AlgebraicGeometry.IsAffineOpen.fromSpec]
            exact Iso.hom_inv_id_assoc _ _
          rw [h_iso_from]
          exact AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_P (F β) (hF β) hd₀_pos
        have h_pre_uP : (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).base).obj
              (P.basicOpen (u_P γ β)) =
            PrimeSpectrum.basicOpen (w_elem γ β) := by
          rw [← h_away_eq]
          let e_inv := (φ_spec β).inv ≫ (hAffD β).isoSpec.hom
          change (TopologicalSpace.Opens.map e_inv.base).obj
            ((TopologicalSpace.Opens.map (hAffD β).fromSpec.base).obj (P.basicOpen (u_P γ β))) = _
          rw [(hAffD β).fromSpec_preimage_basicOpen (u_P γ β)]
          have h_id : e_inv ≫ AlgebraicGeometry.Spec.map (θ_hom β) = 𝟙 _ := by
            dsimp only [e_inv]
            rw [hSpec_map]
            simp
          ext p
          exact Eq.to_iff (congrArg
            (fun m => m.base p ∈ PrimeSpectrum.basicOpen (w_elem γ β)) h_id)
        have h_pre_Dγ : (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).base).obj (D β ⊓ D γ) =
            PrimeSpectrum.basicOpen (w_elem γ β) := by
          rw [← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_P (hF β) hd₀_pos (hF γ) hd₀_pos]
          ext p
          simp only [TopologicalSpace.Opens.map_coe, TopologicalSpace.Opens.coe_inf,
            Set.mem_preimage, Set.mem_inter_iff, SetLike.mem_coe]
          refine and_iff_right ?_
          have h_rng := AlgebraicGeometry.Proj.opensRange_awayι 𝒜_P (F β) (hF β) hd₀_pos
          have h_in : (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).base p ∈
              (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).opensRange := ⟨p, rfl⟩
          rwa [h_rng] at h_in
        have h_pre_eq : (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).base).obj (D β ⊓ D γ) =
            (TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).base).obj
              (P.basicOpen (u_P γ β)) :=
          h_pre_Dγ.trans h_pre_uP.symm
        have h_sub_L : D β ⊓ D γ ≤ D β := inf_le_left
        have h_sub_R : P.basicOpen (u_P γ β) ≤ D β := P.basicOpen_le (u_P γ β)
        have h_rng : Set.range (AlgebraicGeometry.Proj.awayι 𝒜_P (F β) (hF β) hd₀_pos).base =
            (D β : Set P) :=
          (AlgebraicGeometry.Scheme.Hom.coe_opensRange _).symm.trans
            (congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜_P (F β) (hF β) hd₀_pos))
        ext x
        constructor
        · intro hx
          have hxD : x ∈ (D β : Set P) := h_sub_L hx
          rw [← h_rng] at hxD
          obtain ⟨p, rfl⟩ := hxD
          exact Set.ext_iff.mp (congrArg SetLike.coe h_pre_eq) p |>.mp hx
        · intro hx
          have hxD : x ∈ (D β : Set P) := h_sub_R hx
          rw [← h_rng] at hxD
          obtain ⟨p, rfl⟩ := hxD
          exact Set.ext_iff.mp (congrArg SetLike.coe h_pre_eq) p |>.mpr hx
      calc U' β ⊓ U' γ
          = (TopologicalSpace.Opens.map ι_B.base).obj (D β ⊓ D γ) := rfl
        _ = (TopologicalSpace.Opens.map ι_B.base).obj (P.basicOpen (u_P γ β)) := by rw [hP_basic]
        _ = S.basicOpen (u γ β) := ι_B.preimage_basicOpen (u_P γ β)
    have hu_mul : ∀ α β γ : Fin (s'₀ + 1),
        (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u γ β) *
          (S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u α γ) =
          (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u α β) := by
      intro α β γ
      have hP_mul :
          (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D β ⊓ D γ ≤ D β)).op).hom (u_P γ β) *
            (P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D β ⊓ D γ ≤ D γ)).op).hom (u_P α γ) =
            (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D β ⊓ D γ ≤ D β)).op).hom (u_P α β) := by
        have hFG_mem : F β * F γ ∈ 𝒜_P (d₀ + d₀) :=
          SetLike.GradedMonoid.toGradedMul.mul_mem (hF β) (hF γ)
        have hd₀2_pos : 0 < d₀ + d₀ := Nat.add_pos_left hd₀_pos d₀
        let D_ov : P.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_P (F β * F γ)
        have hD_ov_eq : D β ⊓ D γ = D_ov :=
          (AlgebraicGeometry.Proj.basicOpen_mul 𝒜_P (F β) (F γ)).symm
        have hAff_ov : AlgebraicGeometry.IsAffineOpen D_ov :=
          AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_P (F β * F γ) hFG_mem hd₀2_pos
        let φ_ov := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_P (F β * F γ) hFG_mem hd₀2_pos
        let θ_ov : CommRingCat.of (HomogeneousLocalization.Away 𝒜_P (F β * F γ)) ⟶
            P.presheaf.obj (Opposite.op D_ov) :=
          AlgebraicGeometry.Spec.preimage (hAff_ov.isoSpec.inv ≫ φ_ov.hom)
        have h_res_L : θ_hom β ≫
            P.presheaf.map (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_left)).op =
            CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl) ≫ θ_ov := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
          rw [← cancel_epi hAff_ov.isoSpec.hom]
          have h1 : hAff_ov.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (P.presheaf.map
                (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_left)).op) ≫
                ((hAffD β).isoSpec.inv ≫ (φ_spec β).hom)) =
              P.homOfLE (hD_ov_eq.symm.le.trans inf_le_left) ≫ (φ_spec β).hom := by
            calc hAff_ov.isoSpec.hom ≫
                  (AlgebraicGeometry.Spec.map (P.presheaf.map
                    (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_left)).op) ≫
                    ((hAffD β).isoSpec.inv ≫ (φ_spec β).hom))
                = (D_ov.toSpecΓ ≫ AlgebraicGeometry.Spec.map (P.presheaf.map
                    (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_left)).op)) ≫
                    (hAffD β).isoSpec.inv ≫ (φ_spec β).hom := by
                    rw [hAff_ov.isoSpec_hom, Category.assoc]
              _ = (P.homOfLE (hD_ov_eq.symm.le.trans inf_le_left) ≫ (D β).toSpecΓ) ≫
                    (hAffD β).isoSpec.inv ≫ (φ_spec β).hom := by
                    rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map]
              _ = P.homOfLE (hD_ov_eq.symm.le.trans inf_le_left) ≫
                    ((hAffD β).isoSpec.hom ≫ (hAffD β).isoSpec.inv) ≫ (φ_spec β).hom := by
                    rw [← (hAffD β).isoSpec_hom]; simp only [Category.assoc]
              _ = P.homOfLE (hD_ov_eq.symm.le.trans inf_le_left) ≫ (φ_spec β).hom := by
                    rw [Iso.hom_inv_id, Category.id_comp]
          have h2 : hAff_ov.isoSpec.hom ≫ ((hAff_ov.isoSpec.inv ≫ φ_ov.hom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl))) =
              P.homOfLE (hD_ov_eq.symm.le.trans inf_le_left) ≫ (φ_spec β).hom := by
            rw [← Category.assoc, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
            change AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_P (F β * F γ) ≫ _ =
              _ ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_P (F β)
            exact AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_P (hF γ) rfl
          exact h1.trans h2.symm
        have h_res_R : θ_hom γ ≫
            P.presheaf.map (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_right)).op =
            CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_P (hF β) (mul_comm _ _)) ≫ θ_ov := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
          rw [← cancel_epi hAff_ov.isoSpec.hom]
          have h1 : hAff_ov.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map (P.presheaf.map
                (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_right)).op) ≫
                ((hAffD γ).isoSpec.inv ≫ (φ_spec γ).hom)) =
              P.homOfLE (hD_ov_eq.symm.le.trans inf_le_right) ≫ (φ_spec γ).hom := by
            calc hAff_ov.isoSpec.hom ≫
                  (AlgebraicGeometry.Spec.map (P.presheaf.map
                    (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_right)).op) ≫
                    ((hAffD γ).isoSpec.inv ≫ (φ_spec γ).hom))
                = (D_ov.toSpecΓ ≫ AlgebraicGeometry.Spec.map (P.presheaf.map
                    (CategoryTheory.homOfLE (hD_ov_eq.symm.le.trans inf_le_right)).op)) ≫
                    (hAffD γ).isoSpec.inv ≫ (φ_spec γ).hom := by
                    rw [hAff_ov.isoSpec_hom, Category.assoc]
              _ = (P.homOfLE (hD_ov_eq.symm.le.trans inf_le_right) ≫ (D γ).toSpecΓ) ≫
                    (hAffD γ).isoSpec.inv ≫ (φ_spec γ).hom := by
                    rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map]
              _ = P.homOfLE (hD_ov_eq.symm.le.trans inf_le_right) ≫
                    ((hAffD γ).isoSpec.hom ≫ (hAffD γ).isoSpec.inv) ≫ (φ_spec γ).hom := by
                    rw [← (hAffD γ).isoSpec_hom]; simp only [Category.assoc]
              _ = P.homOfLE (hD_ov_eq.symm.le.trans inf_le_right) ≫ (φ_spec γ).hom := by
                    rw [Iso.hom_inv_id, Category.id_comp]
          have h2 : hAff_ov.isoSpec.hom ≫ ((hAff_ov.isoSpec.inv ≫ φ_ov.hom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.awayMap 𝒜_P (hF β) (mul_comm _ _)))) =
              P.homOfLE (hD_ov_eq.symm.le.trans inf_le_right) ≫ (φ_spec γ).hom := by
            rw [← Category.assoc, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
            change AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_P (F β * F γ) ≫ _ =
              _ ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_P (F γ)
            exact AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_P (hF β) (mul_comm _ _)
          exact h1.trans h2.symm
        have hw_cocycle :
            HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl (w_elem γ β) *
              HomogeneousLocalization.awayMap 𝒜_P (hF β) (mul_comm _ _) (w_elem α γ) =
              HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl (w_elem α β) := by
          rw [HomogeneousLocalization.ext_iff_val]
          have hval_mul : ∀ x y : HomogeneousLocalization.Away 𝒜_P (F β * F γ),
              (x * y).val = x.val * y.val := fun x y => by
            simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
          rw [hval_mul]
          change (HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl
              (HomogeneousLocalization.Away.mk 𝒜_P (hF β) d₀ (F γ ^ d₀) _)).val *
            (HomogeneousLocalization.awayMap 𝒜_P (hF β) (mul_comm _ _)
              (HomogeneousLocalization.Away.mk 𝒜_P (hF γ) d₀ (F α ^ d₀) _)).val =
            (HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl
              (HomogeneousLocalization.Away.mk 𝒜_P (hF β) d₀ (F α ^ d₀) _)).val
          rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
            HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
            HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
            Localization.mk_mul, Localization.mk_eq_mk_iff]
          rw [Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [OneMemClass.coe_one, Submonoid.coe_mul]
          ring
        have h_inj : Function.Injective
            (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op).hom := by
          intro x y hxy
          have h_comp : (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op ≫
              P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.le).op) = 𝟙 _ := by
            rw [← P.presheaf.map_comp]
            exact P.presheaf.map_id _
          have hx := ConcreteCategory.congr_hom h_comp x
          have hy := ConcreteCategory.congr_hom h_comp y
          change (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.le).op).hom
              ((P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op).hom x) = x at hx
          change (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.le).op).hom
              ((P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op).hom y) = y at hy
          rw [← hx, ← hy, hxy]
        apply h_inj
        simp only [map_mul]
        have hL1 : (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op).hom
            ((P.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_P γ β)) =
            θ_ov.hom (HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl (w_elem γ β)) := by
          change (θ_hom β ≫ P.presheaf.map _ ≫ P.presheaf.map _).hom (w_elem γ β) = _
          rw [← P.presheaf.map_comp]
          exact ConcreteCategory.congr_hom h_res_L (w_elem γ β)
        have hR1 : (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op).hom
            ((P.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u_P α γ)) =
            θ_ov.hom (HomogeneousLocalization.awayMap 𝒜_P (hF β) (mul_comm _ _) (w_elem α γ)) := by
          change (θ_hom γ ≫ P.presheaf.map _ ≫ P.presheaf.map _).hom (w_elem α γ) = _
          rw [← P.presheaf.map_comp]
          exact ConcreteCategory.congr_hom h_res_R (w_elem α γ)
        have hL2 : (P.presheaf.map (CategoryTheory.homOfLE hD_ov_eq.symm.le).op).hom
            ((P.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_P α β)) =
            θ_ov.hom (HomogeneousLocalization.awayMap 𝒜_P (hF γ) rfl (w_elem α β)) := by
          change (θ_hom β ≫ P.presheaf.map _ ≫ P.presheaf.map _).hom (w_elem α β) = _
          rw [← P.presheaf.map_comp]
          exact ConcreteCategory.congr_hom h_res_L (w_elem α β)
        rw [hL1, hR1, hL2, ← map_mul, hw_cocycle]
      have h_nat_L : ∀ s : ↑(P.presheaf.obj (Opposite.op (D β))),
          (S.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U' β ⊓ U' γ ≤ U' β)).op).hom
            ((ι_B.app (D β)).hom s) =
          (ι_B.app (D β ⊓ D γ)).hom
            ((P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D β ⊓ D γ ≤ D β)).op).hom s) := by
        intro s
        exact (ConcreteCategory.congr_hom
          (ι_B.naturality (CategoryTheory.homOfLE (inf_le_left : D β ⊓ D γ ≤ D β)).op) s).symm
      have h_nat_R : ∀ s : ↑(P.presheaf.obj (Opposite.op (D γ))),
          (S.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U' β ⊓ U' γ ≤ U' γ)).op).hom
            ((ι_B.app (D γ)).hom s) =
          (ι_B.app (D β ⊓ D γ)).hom
            ((P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D β ⊓ D γ ≤ D γ)).op).hom s) := by
        intro s
        exact (ConcreteCategory.congr_hom
          (ι_B.naturality (CategoryTheory.homOfLE (inf_le_right : D β ⊓ D γ ≤ D γ)).op) s).symm
      dsimp only [u]
      rw [h_nat_L (u_P γ β), h_nat_R (u_P α γ), h_nat_L (u_P α β)]
      exact (((ι_B.app (D β ⊓ D γ)).hom.map_mul _ _).symm).trans
        (congrArg (ι_B.app (D β ⊓ D γ)).hom hP_mul)
    exact ⟨s'₀, U', μ, u, hSub, hAffU', hCovU', hu_id, hu_basic, hu_mul⟩

  have hPart2 : ∀ (S : AlgebraicGeometry.Scheme.{u}) (s'₀ r₀ : ℕ)
      (U' : Fin (s'₀ + 1) → S.Opens)
      (_hAffU' : ∀ β : Fin (s'₀ + 1), AlgebraicGeometry.IsAffineOpen (U' β))
      (u : ∀ (γ β : Fin (s'₀ + 1)), ↑(S.presheaf.obj (Opposite.op (U' β))))
      (_hu_id : ∀ β : Fin (s'₀ + 1), u β β = 1)
      (_hu_basic : ∀ β γ : Fin (s'₀ + 1), U' β ⊓ U' γ = S.basicOpen (u γ β))
      (_hu_mul : ∀ α β γ : Fin (s'₀ + 1),
        (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u γ β) *
          (S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u α γ) =
          (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u α β))
      (T' : ∀ β γ : Fin (s'₀ + 1),
        Matrix.GeneralLinearGroup (Fin (r₀ + 1))
          ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ))))
      (_hT'_id : ∀ β : Fin (s'₀ + 1), (T' β β).val = 1)
      (_hT'_cocycle : ∀ β γ α : Fin (s'₀ + 1),
        let u₁ : U' β ⊓ U' γ ⊓ U' α ⟶ U' β ⊓ U' γ := CategoryTheory.homOfLE inf_le_left
        let u₂ : U' β ⊓ U' γ ⊓ U' α ⟶ U' γ ⊓ U' α :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
        let u₃ : U' β ⊓ U' γ ⊓ U' α ⟶ U' β ⊓ U' α :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
        Matrix.map (T' β γ).val (S.presheaf.map u₁.op).hom *
          Matrix.map (T' γ α).val (S.presheaf.map u₂.op).hom =
          Matrix.map (T' β α).val (S.presheaf.map u₃.op).hom),
      ∃ (v : ∀ β γ : Fin (s'₀ + 1), (↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ))))ˣ)
        (Q : ∀ β _α : Fin (s'₀ + 1),
          Matrix (Fin (r₀ + 1)) (Fin (r₀ + 1)) ↑(S.presheaf.obj (Opposite.op (U' β)))),
        (∀ β : Fin (s'₀ + 1), Q β β = 1) ∧
        (∀ β γ α : Fin (s'₀ + 1),
          (T' β γ).val *
            Matrix.map (Q γ α) (S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom =
            (v β γ).val •
              Matrix.map (Q β α) (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom) := by
    intro S s'₀ r₀ U' hAffU' u hu_id hu_basic hu_mul T' hT'_id hT'_cocycle
    classical
    let resL (β γ : Fin (s'₀ + 1)) :
        ↑(S.presheaf.obj (Opposite.op (U' β))) →+*
          ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ))) :=
      (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
    let resR (β γ : Fin (s'₀ + 1)) :
        ↑(S.presheaf.obj (Opposite.op (U' γ))) →+*
          ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ))) :=
      (S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
    have hStage1_entry : ∀ (β α : Fin (s'₀ + 1)) (i j : Fin (r₀ + 1)),
        ∃ (p : ↑(S.presheaf.obj (Opposite.op (U' β))) × ℕ),
          (T' β α).val i j * resL β α (u α β ^ p.2) = resL β α p.1 := by
      intro β α i j
      letI : Algebra ↑(S.presheaf.obj (Opposite.op (U' β)))
          ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' α))) := (resL β α).toAlgebra
      haveI : IsLocalization.Away (u α β) ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' α))) :=
        (hAffU' β).isLocalization_of_eq_basicOpen (u α β)
          (CategoryTheory.homOfLE inf_le_left) (hu_basic β α)
      exact ⟨IsLocalization.Away.sec (u α β) ((T' β α).val i j),
        IsLocalization.Away.sec_spec (u α β) ((T' β α).val i j)⟩
    choose sec1 hsec1 using hStage1_entry
    let Idx1 := Fin (s'₀ + 1) × Fin (s'₀ + 1) × Fin (r₀ + 1) × Fin (r₀ + 1)
    let m₁ : ℕ := Finset.univ.sup (fun x : Idx1 => (sec1 x.1 x.2.1 x.2.2.1 x.2.2.2).2)
    have hm₁_ge : ∀ (β α : Fin (s'₀ + 1)) (i j : Fin (r₀ + 1)),
        (sec1 β α i j).2 ≤ m₁ := by
      intro β α i j
      exact Finset.le_sup (f := fun x : Idx1 => (sec1 x.1 x.2.1 x.2.2.1 x.2.2.2).2)
        (Finset.mem_univ (β, α, i, j))
    let Q₁ : ∀ β _α : Fin (s'₀ + 1),
        Matrix (Fin (r₀ + 1)) (Fin (r₀ + 1)) ↑(S.presheaf.obj (Opposite.op (U' β))) :=
      fun β α =>
        if β = α then 1
        else Matrix.of fun i j =>
          (u α β) ^ (m₁ - (sec1 β α i j).2) * (sec1 β α i j).1
    have hQ₁_id : ∀ β : Fin (s'₀ + 1), Q₁ β β = 1 := by
      intro β; simp [Q₁]
    have hQ₁_eq : ∀ β α : Fin (s'₀ + 1),
        Matrix.map (Q₁ β α) (resL β α) = (resL β α (u α β)) ^ m₁ • (T' β α).val := by
      intro β α
      by_cases hβα : β = α
      · subst hβα
        rw [hQ₁_id, hT'_id, hu_id, map_one, one_pow, one_smul]
        ext i j
        by_cases hij : i = j <;> simp [Matrix.one_apply, hij]
      · ext i j
        simp only [Q₁, if_neg hβα, Matrix.map_apply, Matrix.of_apply, Matrix.smul_apply,
          smul_eq_mul, map_mul, map_pow]
        have hk := hm₁_ge β α i j
        have h_sec := hsec1 β α i j
        rw [map_pow] at h_sec
        calc (resL β α (u α β)) ^ (m₁ - (sec1 β α i j).2) * resL β α (sec1 β α i j).1
            = (resL β α (u α β)) ^ (m₁ - (sec1 β α i j).2) *
                ((T' β α).val i j * (resL β α (u α β)) ^ (sec1 β α i j).2) := by rw [← h_sec]
          _ = ((resL β α (u α β)) ^ (m₁ - (sec1 β α i j).2) *
                (resL β α (u α β)) ^ (sec1 β α i j).2) * (T' β α).val i j := by ring
          _ = (resL β α (u α β)) ^ m₁ * (T' β α).val i j := by rw [← pow_add, Nat.sub_add_cancel hk]
    let L_mat (β γ α : Fin (s'₀ + 1)) :
        Matrix (Fin (r₀ + 1)) (Fin (r₀ + 1)) ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ))) :=
      (resL β γ (u γ β)) ^ m₁ • ((T' β γ).val * Matrix.map (Q₁ γ α) (resR β γ))
    let R_mat (β γ α : Fin (s'₀ + 1)) :
        Matrix (Fin (r₀ + 1)) (Fin (r₀ + 1)) ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ))) :=
      Matrix.map (Q₁ β α) (resL β γ)
    have hStage2_entry : ∀ (β γ α : Fin (s'₀ + 1)) (i j : Fin (r₀ + 1)),
        ∃ n : ℕ,
          (resL β γ (u α β)) ^ n * L_mat β γ α i j =
            (resL β γ (u α β)) ^ n * R_mat β γ α i j := by
      intro β γ α i j
      have hAff_ov : AlgebraicGeometry.IsAffineOpen (U' β ⊓ U' γ) := by
        rw [hu_basic β γ]
        exact (hAffU' β).basicOpen (u γ β)
      have h_basic_ov : U' β ⊓ U' γ ⊓ U' α = S.basicOpen (resL β γ (u α β)) := by
        rw [S.basicOpen_res (u α β) (CategoryTheory.homOfLE inf_le_left).op, ← hu_basic β α]
        ext x
        simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe]
        tauto
      let u₁ : U' β ⊓ U' γ ⊓ U' α ⟶ U' β ⊓ U' γ := CategoryTheory.homOfLE inf_le_left
      let u₂ : U' β ⊓ U' γ ⊓ U' α ⟶ U' γ ⊓ U' α :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
      let u₃ : U' β ⊓ U' γ ⊓ U' α ⟶ U' β ⊓ U' α :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
      let r₁ := (S.presheaf.map u₁.op).hom
      let r₂ := (S.presheaf.map u₂.op).hom
      let r₃ := (S.presheaf.map u₃.op).hom
      letI : Algebra ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ)))
          ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ ⊓ U' α))) := r₁.toAlgebra
      haveI : IsLocalization.Away (resL β γ (u α β))
          ↑(S.presheaf.obj (Opposite.op (U' β ⊓ U' γ ⊓ U' α))) :=
        hAff_ov.isLocalization_of_eq_basicOpen (resL β γ (u α β)) u₁ h_basic_ov
      have h_res_R1 : ∀ x : ↑(S.presheaf.obj (Opposite.op (U' γ))),
          r₁ (resR β γ x) = r₂ (resL γ α x) := by
        intro x
        change (S.presheaf.map _ ≫ S.presheaf.map _).hom x =
          (S.presheaf.map _ ≫ S.presheaf.map _).hom x
        rw [← S.presheaf.map_comp, ← S.presheaf.map_comp]
        rfl
      have h_res_L1 : ∀ x : ↑(S.presheaf.obj (Opposite.op (U' β))),
          r₁ (resL β γ x) = r₃ (resL β α x) := by
        intro x
        change (S.presheaf.map _ ≫ S.presheaf.map _).hom x =
          (S.presheaf.map _ ≫ S.presheaf.map _).hom x
        rw [← S.presheaf.map_comp, ← S.presheaf.map_comp]
        rfl
      have h_mat_eq : Matrix.map (L_mat β γ α) r₁ = Matrix.map (R_mat β γ α) r₁ := by
        have hQ1_γ : Matrix.map (Matrix.map (Q₁ γ α) (resR β γ)) r₁ =
            (r₁ (resR β γ (u α γ))) ^ m₁ • Matrix.map (T' γ α).val r₂ := by
          calc Matrix.map (Matrix.map (Q₁ γ α) (resR β γ)) r₁
              = Matrix.map (Q₁ γ α) (r₁ ∘ resR β γ) := Matrix.map_map
            _ = Matrix.map (Q₁ γ α) (r₂ ∘ resL γ α) := by
                congr 1; funext x; exact h_res_R1 x
            _ = Matrix.map (Matrix.map (Q₁ γ α) (resL γ α)) r₂ := Matrix.map_map.symm
            _ = Matrix.map ((resL γ α (u α γ)) ^ m₁ • (T' γ α).val) r₂ := by rw [hQ₁_eq γ α]
            _ = (r₂ (resL γ α (u α γ))) ^ m₁ • Matrix.map (T' γ α).val r₂ := by
                ext a b; simp [Matrix.smul_apply, smul_eq_mul]
            _ = (r₁ (resR β γ (u α γ))) ^ m₁ • Matrix.map (T' γ α).val r₂ := by
                rw [h_res_R1 (u α γ)]
        have hQ1_β : Matrix.map (R_mat β γ α) r₁ =
            (r₁ (resL β γ (u α β))) ^ m₁ • Matrix.map (T' β α).val r₃ := by
          calc Matrix.map (Matrix.map (Q₁ β α) (resL β γ)) r₁
              = Matrix.map (Q₁ β α) (r₁ ∘ resL β γ) := Matrix.map_map
            _ = Matrix.map (Q₁ β α) (r₃ ∘ resL β α) := by
                congr 1; funext x; exact h_res_L1 x
            _ = Matrix.map (Matrix.map (Q₁ β α) (resL β α)) r₃ := Matrix.map_map.symm
            _ = Matrix.map ((resL β α (u α β)) ^ m₁ • (T' β α).val) r₃ := by rw [hQ₁_eq β α]
            _ = (r₃ (resL β α (u α β))) ^ m₁ • Matrix.map (T' β α).val r₃ := by
                ext a b; simp [Matrix.smul_apply, smul_eq_mul]
            _ = (r₁ (resL β γ (u α β))) ^ m₁ • Matrix.map (T' β α).val r₃ := by
                rw [h_res_L1 (u α β)]
        have hL_map : Matrix.map (L_mat β γ α) r₁ =
            (r₁ (resL β γ (u γ β)) * r₁ (resR β γ (u α γ))) ^ m₁ •
              (Matrix.map (T' β γ).val r₁ * Matrix.map (T' γ α).val r₂) := by
          have h_mul_map : Matrix.map ((T' β γ).val * Matrix.map (Q₁ γ α) (resR β γ)) r₁ =
              Matrix.map (T' β γ).val r₁ * Matrix.map (Matrix.map (Q₁ γ α) (resR β γ)) r₁ := by
            ext a b
            simp [Matrix.mul_apply, map_sum, map_mul]
          calc Matrix.map (L_mat β γ α) r₁
              = (r₁ (resL β γ (u γ β))) ^ m₁ •
                  Matrix.map ((T' β γ).val * Matrix.map (Q₁ γ α) (resR β γ)) r₁ := by
                  ext a b
                  simp only [L_mat, Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_mul, map_pow]
            _ = (r₁ (resL β γ (u γ β))) ^ m₁ •
                  (Matrix.map (T' β γ).val r₁ *
                    ((r₁ (resR β γ (u α γ))) ^ m₁ • Matrix.map (T' γ α).val r₂)) := by
                  rw [h_mul_map, hQ1_γ]
            _ = (r₁ (resL β γ (u γ β)) * r₁ (resR β γ (u α γ))) ^ m₁ •
                  (Matrix.map (T' β γ).val r₁ * Matrix.map (T' γ α).val r₂) := by
                  rw [mul_smul_comm, smul_smul, ← mul_pow]
        rw [hL_map, hQ1_β, ← map_mul, hu_mul α β γ, hT'_cocycle β γ α]
      have h_entry : r₁ (L_mat β γ α i j) = r₁ (R_mat β γ α i j) := by
        simpa using congrArg (fun M => M i j) h_mat_eq
      obtain ⟨⟨c, n, rfl⟩, hc⟩ :=
        IsLocalization.exists_of_eq (M := Submonoid.powers (resL β γ (u α β))) h_entry
