        change MvPolynomial.pderiv i (MvPolynomial.C (c_P r₀)) ∈ _
        rw [MvPolynomial.pderiv_C]
        exact Ideal.zero_mem _
      · rw [map_zero]; exact Ideal.zero_mem _
      · intro F₁ F₂ _ _ h₁ h₂; rw [map_add]; exact add_mem h₁ h₂
