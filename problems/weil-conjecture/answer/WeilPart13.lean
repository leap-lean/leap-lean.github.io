    have hq₁_mem : q₁ ∈ Set.range (PrimeSpectrum.comap (algebraMap A₁ (Localization.Away s_A))) := by
      rw [PrimeSpectrum.localization_comap_range (Localization.Away s_A) (Submonoid.powers s_A)]
      rw [Set.mem_ofPred_eq, Set.disjoint_left]
