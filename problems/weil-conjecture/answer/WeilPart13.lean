        have htmp := congrArg (· ≫ CategoryTheory.inv (π_from 0)) hα_fst0
        simpa [CategoryTheory.Category.assoc] using htmp
      have h2 : CategoryTheory.Limits.pullback.fst g₁ η_K ≫ CategoryTheory.inv (π_from 0) =
          ψ_K.hom ≫ α_top.inv ≫ CategoryTheory.Limits.pullback.fst (g_seq 0) η_K := by
        rw [h1]
        simp [CategoryTheory.Category.assoc]
      calc CategoryTheory.Limits.pullback.fst g₁ η_K ≫ (CategoryTheory.inv (π_from 0) ≫ h)
