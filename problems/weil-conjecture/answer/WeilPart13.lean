  have h_etale_of_jac :
      ∀ (P : Type u) [CommRing P] [Algebra P A₁] [Algebra.FinitePresentation P A₁]
        (r : ℕ) (Phi_alg : MvPolynomial (Fin r) P →ₐ[P] A₁)
        (_ : Function.Surjective Phi_alg)
        (G : Fin r → MvPolynomial (Fin r) P)
        (_ : ∀ j : Fin r, Phi_alg (G j) = 0)
        (_ : Phi_alg (Matrix.of fun i j : Fin r => MvPolynomial.pderiv i (G j)).det ∉ q₁.asIdeal),
