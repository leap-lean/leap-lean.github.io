    exact congrArg (Ideal.Quotient.mk (m₀.asIdeal ^ 3)) (RingHom.congr_fun hcomm_K c)
  rw [h12, Ideal.quotEquivOfEq_mk]
  exact e_dbl.commutes c

theorem weil_nodal_mod_cube_iso_split_tangent_cone_over_ext (κ₀ F₀ K E₁ : Type u) [Field κ₀] [CommRing F₀] [Field K] [IsAlgClosed K] [Field E₁]
