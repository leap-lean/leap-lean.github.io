        (e_K.comp (S'_sch.germToFunctionField V').hom).comp (π₀.appLE V V' hVV').hom =
          (S_base.germToFunctionField V).hom := by
      intro V _ V' _ hVV'
      exact congrArg CommRingCat.Hom.hom (h_π V V' hVV')
    have hCompat_ν : ∀ (U_A : S'_sch.Opens) [Nonempty U_A],
        ∃ hNeW' : Nonempty ((TopologicalSpace.Opens.map ν₀.base).obj U_A),
          letI := hNeW'
          (e_W.comp (W.germToFunctionField ((TopologicalSpace.Opens.map ν₀.base).obj U_A)).hom).comp
              (ν₀.appLE U_A ((TopologicalSpace.Opens.map ν₀.base).obj U_A) (le_refl _)).hom =
            e_K.comp (S'_sch.germToFunctionField U_A).hom := by
      intro U_A _
      obtain ⟨u₀⟩ := (‹Nonempty U_A› : Nonempty U_A)
      have hη'_UA : η' ∈ U_A :=
        ((genericPoint_spec ↥S'_sch).mem_open_set_iff U_A.isOpen).mpr ⟨u₀.1, trivial, u₀.2⟩
      have hηW_pre : η_W ∈ (TopologicalSpace.Opens.map ν₀.base).obj U_A := by
        change ν₀.base η_W ∈ U_A
        rwa [hη_ν]
      let hNeW' : Nonempty ((TopologicalSpace.Opens.map ν₀.base).obj U_A) := ⟨⟨η_W, hηW_pre⟩⟩
      refine ⟨hNeW', ?_⟩
      let _ := hNeW'
      have hν_eq := congrArg CommRingCat.Hom.hom
        (h_ν U_A ((TopologicalSpace.Opens.map ν₀.base).obj U_A) (le_refl _))
      ext x
      exact congrArg e_K (RingHom.congr_fun hν_eq x)
    have hCompat_j : ∀ (V : S_base.Opens) [Nonempty V] (W' : W.Opens) [Nonempty W']
        (hWW' : W' ≤ (TopologicalSpace.Opens.map (ν₀ ≫ π₀).base).obj V),
        (e_W.comp (W.germToFunctionField W').hom).comp ((ν₀ ≫ π₀).appLE V W' hWW').hom =
          (S_base.germToFunctionField V).hom := by
      intro V _ W' _ hWW'
      obtain ⟨w₀⟩ := (‹Nonempty W'› : Nonempty W')
      let V'_π : S'_sch.Opens := (TopologicalSpace.Opens.map π₀.base).obj V
      have hw₀_π : ν₀.base w₀.1 ∈ V'_π := hWW' w₀.2
      let _ : Nonempty V'_π := ⟨⟨ν₀.base w₀.1, hw₀_π⟩⟩
      have hWW'_ν : W' ≤ (TopologicalSpace.Opens.map ν₀.base).obj V'_π := hWW'
      have happ : (ν₀ ≫ π₀).appLE V W' hWW' =
          π₀.appLE V V'_π (le_refl _) ≫ ν₀.appLE V'_π W' hWW'_ν := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_appLE, AlgebraicGeometry.Scheme.Hom.appLE_eq_app]
      have hν_W' := congrArg CommRingCat.Hom.hom (h_ν V'_π W' hWW'_ν)
      have hπ_V := hCompat_π V V'_π (le_refl _)
      rw [happ]
      ext x
      have step1 := congrArg e_K (RingHom.congr_fun hν_W' ((π₀.appLE V V'_π (le_refl _)).hom x))
      exact step1.trans (RingHom.congr_fun hπ_V x)
    exact ⟨e_K, e_W, hBij_eK, hCompat_π, hCompat_j, hCompat_ν⟩
  obtain ⟨e_K, e_W, hBij_eK, heK_compat, heW_U, heW_ν⟩ :=
    hPart4 U'.toScheme S'.left S.left ν π.left U'.ι hνπ

  
  refine ⟨S', U', π, hIntS', hProjS', hNeU', hU'_le_U₀, hPropπ, hSurjπ, hIsoπ,
    e_K, hBij_eK, heK_compat, ?_⟩
  intro s'
  have hs'_top : p₂.left.base s' ∈ (⨆ a₁ : Fin (M_Pl + 1), D_Pl a₁) := by
    rw [hCovD]
    trivial
  obtain ⟨a₁, ha₁_mem⟩ := TopologicalSpace.Opens.mem_iSup.mp hs'_top
  let V_D1 : S'.left.Opens := (TopologicalSpace.Opens.map p₂.left.base).obj (D_Pl a₁)
  have hs'_VD1 : s' ∈ V_D1 := ha₁_mem
  obtain ⟨U_A, hAffUA, hs', hUA_le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S'.left.isBasis_affineOpens) hs'_VD1
  let _ : Nonempty U_A := ⟨⟨s', hs'⟩⟩
  obtain ⟨hNeW', heW_ν_UA⟩ := heW_ν U_A
  let W'_A : U'.toScheme.Opens := (TopologicalSpace.Opens.map ν.base).obj U_A
  let _ : Nonempty W'_A := hNeW'
  let z_fn : Fin (M_Pl + 1) → ↑(S'.left.presheaf.obj (Opposite.op U_A)) :=
    fun a => (p₂.left.appLE (D_Pl a₁) U_A hUA_le).hom (ratio_Pl a₁ a)
  have hW'_a₀ : W'_A ≤ (TopologicalSpace.Opens.map Φ.base).obj (D_Pl a₀) :=
    le_top.trans hΦ_le
  have hW'_a₁ : W'_A ≤ (TopologicalSpace.Opens.map Φ.base).obj (D_Pl a₁) := by
    intro w hw
    change Φ.base w ∈ D_Pl a₁
    rw [← hνp₂]
    exact hUA_le hw
  have hW'_inter : W'_A ≤ (TopologicalSpace.Opens.map Φ.base).obj (D_Pl a₀ ⊓ D_Pl a₁) :=
    le_inf hW'_a₀ hW'_a₁
  have hW'_U' : W'_A ≤ (TopologicalSpace.Opens.map U'.ι.base).obj U' :=
    fun w _ => w.2
  have hEqK : ∀ a : Fin (M_Pl + 1),
      (Δ a₁ / Δ a₀) * (e_K.comp (S'.left.germToFunctionField U_A).hom) (z_fn a) =
        Δ a / Δ a₀ := by
    intro a
    have h_sec := congrArg (Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter).hom
      (hCocycle a₀ a₁ a)
    rw [map_mul] at h_sec
    have h_fac1 : ∀ c : Fin (M_Pl + 1),
        (Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter).hom
          ((P_Pl.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : D_Pl a₀ ⊓ D_Pl a₁ ≤ D_Pl a₀)).op).hom
              (ratio_Pl a₀ c)) =
          (U'.ι.appLE U' W'_A hW'_U').hom (r' c) := by
      intro c
      have hm : P_Pl.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : D_Pl a₀ ⊓ D_Pl a₁ ≤ D_Pl a₀)).op ≫
            Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter =
          Φ.appLE (D_Pl a₀) W'_A hW'_a₀ :=
        AlgebraicGeometry.Scheme.Hom.map_appLE _ _ _
      change (P_Pl.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : D_Pl a₀ ⊓ D_Pl a₁ ≤ D_Pl a₀)).op ≫
          Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter).hom (ratio_Pl a₀ c) = _
      rw [hm]
      exact hΦ_pull c W'_A hW'_a₀ hW'_U'
    have h_fac2 :
        (Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter).hom
          ((P_Pl.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : D_Pl a₀ ⊓ D_Pl a₁ ≤ D_Pl a₁)).op).hom
              (ratio_Pl a₁ a)) =
          (ν.appLE U_A W'_A (le_refl _)).hom (z_fn a) := by
      have hm : P_Pl.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : D_Pl a₀ ⊓ D_Pl a₁ ≤ D_Pl a₁)).op ≫
            Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter =
          Φ.appLE (D_Pl a₁) W'_A hW'_a₁ :=
        AlgebraicGeometry.Scheme.Hom.map_appLE _ _ _
      have hc : Φ.appLE (D_Pl a₁) W'_A hW'_a₁ =
          p₂.left.appLE (D_Pl a₁) U_A hUA_le ≫ ν.appLE U_A W'_A (le_refl _) := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
        have hcongr : ∀ {f₁ f₂ : U'.toScheme ⟶ P_Pl.left} (_ : f₁ = f₂)
            (h₁ : W'_A ≤ (TopologicalSpace.Opens.map f₁.base).obj (D_Pl a₁))
            (h₂ : W'_A ≤ (TopologicalSpace.Opens.map f₂.base).obj (D_Pl a₁)),
            f₁.appLE (D_Pl a₁) W'_A h₁ = f₂.appLE (D_Pl a₁) W'_A h₂ := by
          rintro f _ rfl _ _
          rfl
        exact hcongr hνp₂.symm hW'_a₁ _
      change (P_Pl.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_right : D_Pl a₀ ⊓ D_Pl a₁ ≤ D_Pl a₁)).op ≫
          Φ.appLE (D_Pl a₀ ⊓ D_Pl a₁) W'_A hW'_inter).hom (ratio_Pl a₁ a) = _
      rw [hm, hc]
      rfl
    rw [h_fac1 a₁, h_fac2, h_fac1 a] at h_sec
    let ψ_W : ↑(U'.toScheme.presheaf.obj (Opposite.op W'_A)) →+* ↑S.left.functionField :=
      e_W.comp (U'.toScheme.germToFunctionField W'_A).hom
    have h_psi := congrArg ψ_W h_sec
    rw [map_mul] at h_psi
    have h_r : ∀ c : Fin (M_Pl + 1),
        ψ_W ((U'.ι.appLE U' W'_A hW'_U').hom (r' c)) = Δ c / Δ a₀ := by
      intro c
      have h1 := RingHom.congr_fun (heW_U U' W'_A hW'_U') (r' c)
      exact h1.trans (hr'_germ c)
    have h_z : ψ_W ((ν.appLE U_A W'_A (le_refl _)).hom (z_fn a)) =
        (e_K.comp (S'.left.germToFunctionField U_A).hom) (z_fn a) :=
      RingHom.congr_fun heW_ν_UA (z_fn a)
    rw [h_r a₁, h_z, h_r a] at h_psi
    exact h_psi
  have hΔ₁ : Δ a₁ ≠ 0 := by
    intro h0
    have h00 := hEqK a₀
    rw [h0, zero_div, zero_mul, div_self hΔ₀] at h00
    exact zero_ne_one h00
  refine ⟨U_A, hs', a₁, hAffUA, hΔ₁, ?_⟩
  intro a
  refine ⟨z_fn a, ?_⟩
  have h_eq := hEqK a
  have h_mul : Δ a₁ * (e_K.comp (S'.left.germToFunctionField U_A).hom) (z_fn a) = Δ a := by
    have h1 := congrArg (· * Δ a₀) h_eq
    change ((Δ a₁ / Δ a₀) * (e_K.comp (S'.left.germToFunctionField U_A).hom) (z_fn a)) * Δ a₀ =
      (Δ a / Δ a₀) * Δ a₀ at h1
    rw [div_mul_eq_mul_div, div_mul_cancel₀ _ hΔ₀, div_mul_cancel₀ _ hΔ₀] at h1
    exact h1
  exact (eq_div_iff hΔ₁).mpr (by rw [mul_comm]; exact h_mul)

theorem weil_strictTransform_chart_adjoin_flat (k : Type u) [Field k]
    (hSegre : ∀ (Y₁ Y₂ S₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (a₁ : Y₁ ⟶ S₀) (a₂ : Y₂ ⟶ S₀),
      IsProjectiveOverField k Y₁ → IsProjectiveOverField k Y₂ → IsProjectiveOverField k S₀ →
      IsProjectiveOverField k
        (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd a₁.left a₂.left ≫ Y₂.hom)))
    (N : ℕ)
    (S S' Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral S.left]
    [AlgebraicGeometry.IsIntegral S'.left]
    [AlgebraicGeometry.IsIntegral Y.left]
    (hProjS : IsProjectiveOverField k S)
    (hProjS' : IsProjectiveOverField k S')
    (hProjY : IsProjectiveOverField k Y)
    (U' : S.left.Opens) (hU' : Nonempty U')
    (π : S' ⟶ S) (hIsoπ : CategoryTheory.IsIso (π.left ∣_ U'))
    (p : Y ⟶ S) (hSurjU' : AlgebraicGeometry.Surjective (p.left ∣_ U'))
    (ι_Y : Y ⟶ weilProjectiveSpaceOver k N)
    (hClY : AlgebraicGeometry.IsClosedImmersion ι_Y.left)
    (φ_KL : ↑S.left.functionField →+* ↑Y.left.functionField)
    (hφ_compat : ∀ (V : S.left.Opens) [Nonempty V] (W : Y.left.Opens) [Nonempty W]
        (hWV : W ≤ (TopologicalSpace.Opens.map p.left.base).obj V),
      (p.left.appLE V W hWV ≫ Y.left.germToFunctionField W).hom =
        φ_KL.comp (S.left.germToFunctionField V).hom)
    (e_K : ↑S'.left.functionField →+* ↑S.left.functionField)
    (heK_compat : ∀ (V : S.left.Opens) [Nonempty V] (V' : S'.left.Opens) [Nonempty V']
        (hVV' : V' ≤ (TopologicalSpace.Opens.map π.left.base).obj V),
      (e_K.comp (S'.left.germToFunctionField V').hom).comp (π.left.appLE V V' hVV').hom =
        (S.left.germToFunctionField V).hom)
    (u : Fin (N + 1) → ↑Y.left.functionField)
    (D_proj : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens)
    (coord_ratio : ∀ i : Fin (N + 1), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D_proj i))))
    (hCovD : ⨆ i : Fin (N + 1), D_proj i = ⊤)
    (hAffD : ∀ i : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_proj i))
    (hAdjD : ∀ i : Fin (N + 1),
      letI : Algebra k ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D_proj i))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          ((weilProjectiveSpaceOver k N).hom.appLE ⊤ (D_proj i) le_top)).hom).toAlgebra
      Algebra.adjoin k (Set.range (coord_ratio i)) = ⊤)
    (hu_zero : ∀ i : Fin (N + 1), u i = 0 →
      (TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i) = ⊥)
    (hu_ne : ∀ i : Fin (N + 1), u i ≠ 0 →
      ∃ hNeW : Nonempty ((TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i)),
        ∀ r : Fin (N + 1),
          letI := hNeW
          (Y.left.germToFunctionField
            ((TopologicalSpace.Opens.map ι_Y.left.base).obj (D_proj i))).hom
            ((ι_Y.left.app (D_proj i)).hom (coord_ratio i r)) = (u i)⁻¹ * u r)
    (hLocalFlat : ∀ s' : S'.left,
      ∃ (U_A : S'.left.Opens) (hs' : s' ∈ U_A),
        AlgebraicGeometry.IsAffineOpen U_A ∧
        ∀ i : Fin (N + 1), u i ≠ 0 →
          letI : Nonempty U_A := ⟨⟨s', hs'⟩⟩
          letI : Algebra ↑(S'.left.presheaf.obj (Opposite.op U_A)) ↑Y.left.functionField :=
            (φ_KL.comp (e_K.comp (S'.left.germToFunctionField U_A).hom)).toAlgebra
          Module.Flat ↑(S'.left.presheaf.obj (Opposite.op U_A))
            ↥(Algebra.adjoin ↑(S'.left.presheaf.obj (Opposite.op U_A))
              (Set.range (fun r : Fin (N + 1) => (u i)⁻¹ * u r)))) :
    ∃ (Y' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f' : Y' ⟶ S') (q' : Y' ⟶ Y)
      (hcomm : q'.left ≫ p.left = f'.left ≫ π.left),
      AlgebraicGeometry.IsIntegral Y'.left ∧
      IsProjectiveOverField k Y' ∧
      AlgebraicGeometry.Flat f'.left ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift q'.left f'.left hcomm) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.lift q'.left f'.left hcomm) ∣_
          ((TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd p.left π.left).base).obj
              ((TopologicalSpace.Opens.map π.left.base).obj U'))) :=
by
  
  
  
  let U'_Y : Y.left.Opens := (TopologicalSpace.Opens.map p.left.base).obj U'
  let V' : S'.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U'
  let P_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p.left π.left
  let fst_P : P_sch ⟶ Y.left := CategoryTheory.Limits.pullback.fst p.left π.left
  let snd_P : P_sch ⟶ S'.left := CategoryTheory.Limits.pullback.snd p.left π.left
  let W'_pb : P_sch.Opens := (TopologicalSpace.Opens.map snd_P.base).obj V'

  haveI : CategoryTheory.IsIso (π.left ∣_ U') := hIsoπ
  let π_inv : U'.toScheme ⟶ V'.toScheme := CategoryTheory.inv (π.left ∣_ U')
  have hπ_inv_ι : (π_inv ≫ V'.ι) ≫ π.left = U'.ι := by
    rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι π.left U',
      CategoryTheory.IsIso.inv_hom_id_assoc]
  let g_U : U'_Y.toScheme ⟶ S'.left := ((p.left ∣_ U') ≫ π_inv) ≫ V'.ι
  have h_q_comm : U'_Y.ι ≫ p.left = g_U ≫ π.left := by
    dsimp [g_U]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc π_inv, hπ_inv_ι,
      AlgebraicGeometry.morphismRestrict_ι p.left U']
  let q_open : U'_Y.toScheme ⟶ P_sch :=
    CategoryTheory.Limits.pullback.lift U'_Y.ι g_U h_q_comm
  have hPb_W : CategoryTheory.IsPullback (snd_P ∣_ V') W'_pb.ι V'.ι snd_P :=
    AlgebraicGeometry.isPullback_morphismRestrict snd_P V'
  have hs_comm : ((p.left ∣_ U') ≫ π_inv) ≫ V'.ι = q_open ≫ snd_P := by
    dsimp [q_open]
    rw [CategoryTheory.Limits.pullback.lift_snd]
  let s_pb : U'_Y.toScheme ⟶ W'_pb.toScheme :=
    hPb_W.lift ((p.left ∣_ U') ≫ π_inv) q_open hs_comm
  have hs_fst : s_pb ≫ (snd_P ∣_ V') = (p.left ∣_ U') ≫ π_inv :=
    hPb_W.lift_fst _ _ _
  have hs_snd : s_pb ≫ W'_pb.ι = q_open :=
    hPb_W.lift_snd _ _ _

  let V_fst : P_sch.Opens := (TopologicalSpace.Opens.map fst_P.base).obj U'_Y
  have hW_le : W'_pb ≤ V_fst := by
    intro x hx
    have hx' : (snd_P ≫ π.left).base x ∈ U' := hx
    rwa [← CategoryTheory.Limits.pullback.condition] at hx'
  let r_pb : W'_pb.toScheme ⟶ U'_Y.toScheme := P_sch.homOfLE hW_le ≫ (fst_P ∣_ U'_Y)
  have hr_ι : r_pb ≫ U'_Y.ι = W'_pb.ι ≫ fst_P := by
    dsimp [r_pb]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι fst_P U'_Y,
      ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι P_sch hW_le]
  have hsr : s_pb ≫ r_pb = 𝟙 U'_Y.toScheme := by
    rw [← CategoryTheory.cancel_mono U'_Y.ι]
    rw [CategoryTheory.Category.assoc, hr_ι, ← CategoryTheory.Category.assoc, hs_snd]
    dsimp [q_open]
    rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
  have hr_p : r_pb ≫ (p.left ∣_ U') = (snd_P ∣_ V') ≫ (π.left ∣_ U') := by
    rw [← CategoryTheory.cancel_mono U'.ι]
    calc (r_pb ≫ (p.left ∣_ U')) ≫ U'.ι
        = r_pb ≫ ((p.left ∣_ U') ≫ U'.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (r_pb ≫ U'_Y.ι) ≫ p.left := by
            rw [AlgebraicGeometry.morphismRestrict_ι p.left U']
            exact (CategoryTheory.Category.assoc r_pb U'_Y.ι p.left).symm
      _ = W'_pb.ι ≫ (fst_P ≫ p.left) := by
            rw [hr_ι, CategoryTheory.Category.assoc]
      _ = (W'_pb.ι ≫ snd_P) ≫ π.left := by
            rw [CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc]
      _ = (snd_P ∣_ V') ≫ (V'.ι ≫ π.left) := by
            rw [← AlgebraicGeometry.morphismRestrict_ι snd_P V', CategoryTheory.Category.assoc]
      _ = ((snd_P ∣_ V') ≫ (π.left ∣_ U')) ≫ U'.ι := by
            rw [← AlgebraicGeometry.morphismRestrict_ι π.left U', ← CategoryTheory.Category.assoc]
  have hrs : r_pb ≫ s_pb = 𝟙 W'_pb.toScheme := by
    rw [← CategoryTheory.cancel_mono W'_pb.ι]
    rw [CategoryTheory.Category.id_comp]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc s_pb, hs_snd]
      dsimp [q_open]
      rw [CategoryTheory.Limits.pullback.lift_fst, hr_ι]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc s_pb, hs_snd]
      dsimp [q_open]
      rw [CategoryTheory.Limits.pullback.lift_snd]
      calc r_pb ≫ (((p.left ∣_ U') ≫ π_inv) ≫ V'.ι)
          = (r_pb ≫ (p.left ∣_ U')) ≫ π_inv ≫ V'.ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = ((snd_P ∣_ V') ≫ (π.left ∣_ U')) ≫ π_inv ≫ V'.ι := by rw [hr_p]
        _ = (snd_P ∣_ V') ≫ ((π.left ∣_ U') ≫ π_inv) ≫ V'.ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = (snd_P ∣_ V') ≫ V'.ι := by
              dsimp [π_inv]
              rw [CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.id_comp]
        _ = W'_pb.ι ≫ snd_P := AlgebraicGeometry.morphismRestrict_ι snd_P V'
  let e_pb : U'_Y.toScheme ≅ W'_pb.toScheme :=
    { hom := s_pb, inv := r_pb, hom_inv_id := hsr, inv_hom_id := hrs }
  haveI : CategoryTheory.IsIso e_pb.hom := e_pb.isIso_hom
  haveI : CategoryTheory.IsIso e_pb.inv := e_pb.isIso_inv

  haveI : AlgebraicGeometry.Surjective (p.left ∣_ U') := hSurjU'
  obtain ⟨w₀⟩ := hU'
  obtain ⟨u₀, hu₀_w₀⟩ := AlgebraicGeometry.Surjective.surj (f := p.left ∣_ U') w₀
  haveI : Nonempty ↥U'_Y.toScheme := ⟨u₀⟩
  haveI : AlgebraicGeometry.IsIntegral U'_Y.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U'_Y.ι
  haveI : Nonempty ↥W'_pb.toScheme := ⟨e_pb.hom.base u₀⟩
  haveI : AlgebraicGeometry.IsIntegral W'_pb.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion e_pb.inv

  let P_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (snd_P ≫ S'.hom)
  have hProjP : IsProjectiveOverField k P_over :=
    hSegre Y S' S p π hProjY hProjS' hProjS
  obtain ⟨N_P, ι_P, hCl_P⟩ := hProjP
  haveI : AlgebraicGeometry.IsClosedImmersion ι_P.left := hCl_P
  haveI : TopologicalSpace.NoetherianSpace ↥P_sch := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N_P + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N_P + 1)) k) :=
      ⟨fun c x q => smul_mul_assoc c (x : MvPolynomial (Fin (N_P + 1)) k) q⟩
    haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N_P + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N_P + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N_P + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    haveI : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hSurj0
    haveI : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    haveI : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    haveI : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) :=
      (AlgebraicGeometry.isNoetherian_iff (AlgebraicGeometry.Proj 𝒜)).mpr ⟨inferInstance, inferInstance⟩
    haveI : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N_P).left := by
      change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
      exact AlgebraicGeometry.IsNoetherian.noetherianSpace
    exact ι_P.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  haveI : TopologicalSpace.NoetherianSpace ↥W'_pb.toScheme :=
    W'_pb.ι.isOpenEmbedding.toIsEmbedding.toIsInducing.noetherianSpace

  let j : W'_pb.toScheme ⟶ P_sch := W'_pb.ι
  haveI : AlgebraicGeometry.QuasiCompact j :=
    AlgebraicGeometry.quasiCompact_of_noetherianSpace_source j
  haveI : AlgebraicGeometry.IsReduced W'_pb.toScheme :=
    AlgebraicGeometry.isReduced_of_isIntegral W'_pb.toScheme
  haveI : AlgebraicGeometry.IsReduced j.image := by
    let 𝒰 := j.ker.subschemeCover.openCover
    haveI : ∀ U : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X U) := by
      intro U
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of
          (↑(P_sch.presheaf.obj (Opposite.op U.1)) ⧸ j.ker.ideal U)))
      rw [AlgebraicGeometry.affine_isReduced_iff]
      dsimp
      rw [j.ker_apply U]
      haveI : IsReduced ↑(W'_pb.toScheme.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map j.base).obj U.1))) :=
        @AlgebraicGeometry.IsReduced.component_reduced W'_pb.toScheme _ _
      exact isReduced_of_injective _ (RingHom.kerLift_injective (j.app U.1).hom)
    exact AlgebraicGeometry.IsReduced.of_openCover j.image 𝒰
  haveI : IrreducibleSpace ↥W'_pb.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral W'_pb.toScheme
  haveI : IrreducibleSpace ↥j.image :=
    { isPreirreducible_univ := by
        have hRange : IsPreirreducible (Set.range j.toImage.base) := by
          rw [← Set.image_univ]
          exact PreirreducibleSpace.isPreirreducible_univ.image j.toImage.base
            j.toImage.base.hom.continuous.continuousOn
        have hDense : DenseRange j.toImage.base :=
          AlgebraicGeometry.IsDominant.denseRange (f := j.toImage)
        simpa [hDense.closure_range] using hRange.closure
      toNonempty := ⟨j.toImage.base (e_pb.hom.base u₀)⟩ }
  have hIntY' : AlgebraicGeometry.IsIntegral j.image :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced j.image

  let ι_Y' : j.image ⟶ P_sch := j.imageι
  have hIso_ι : CategoryTheory.IsIso (ι_Y' ∣_ W'_pb) := by
    have hPb_ι : CategoryTheory.IsPullback (ι_Y' ∣_ W'_pb) (ι_Y' ⁻¹ᵁ W'_pb).ι W'_pb.ι ι_Y' :=
      AlgebraicGeometry.isPullback_morphismRestrict ι_Y' W'_pb
    have ht_comm : 𝟙 W'_pb.toScheme ≫ W'_pb.ι = j.toImage ≫ ι_Y' := by
      rw [CategoryTheory.Category.id_comp]
      exact (AlgebraicGeometry.Scheme.Hom.toImage_imageι j).symm
    let t_W : W'_pb.toScheme ⟶ (ι_Y' ⁻¹ᵁ W'_pb).toScheme :=
      hPb_ι.lift (𝟙 W'_pb.toScheme) j.toImage ht_comm
    have ht_fst : t_W ≫ (ι_Y' ∣_ W'_pb) = 𝟙 W'_pb.toScheme :=
      hPb_ι.lift_fst _ _ _
    have ht_snd : t_W ≫ (ι_Y' ⁻¹ᵁ W'_pb).ι = j.toImage :=
      hPb_ι.lift_snd _ _ _
    have h_comp_t : (ι_Y' ∣_ W'_pb) ≫ t_W = 𝟙 (ι_Y' ⁻¹ᵁ W'_pb).toScheme := by
      rw [← CategoryTheory.cancel_mono (ι_Y' ⁻¹ᵁ W'_pb).ι, ← CategoryTheory.cancel_mono ι_Y']
      calc (((ι_Y' ∣_ W'_pb) ≫ t_W) ≫ (ι_Y' ⁻¹ᵁ W'_pb).ι) ≫ ι_Y'
