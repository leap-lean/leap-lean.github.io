    change CategoryTheory.IsIso (AlgebraicGeometry.Spec.map τ₀)
    rw [hSpec_τ₀]; infer_instance
  have : CategoryTheory.IsIso τ₀.op :=
    AlgebraicGeometry.Spec.fullyFaithful.isIso_of_isIso_map τ₀.op
  have : CategoryTheory.IsIso τ₀ := CategoryTheory.isIso_of_op τ₀

  let B₀ : Type u := ↑(Y.left.presheaf.obj (Opposite.op Z₀))
  let B'₀ : Type u := ↑(Y'.left.presheaf.obj (Opposite.op Z'₀))
  have : IsDomain B₀ := AlgebraicGeometry.IsIntegral.component_integral Z₀
  have : IsDomain B'₀ := AlgebraicGeometry.IsIntegral.component_integral Z'₀
  have : IsFractionRing B₀ ↑Y.left.functionField :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y.left Z₀ hAffZ₀
  have : IsFractionRing B'₀ ↑Y'.left.functionField :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y'.left Z'₀ hAffZ'₀

  let ψ'₀ : B'₀ →+* ↑Y.left.functionField :=
    (Y.left.germToFunctionField Z₀).hom.comp (CategoryTheory.inv τ₀).hom
  have hψ'₀_unit : ∀ y : nonZeroDivisors B'₀, IsUnit (ψ'₀ y) := by
    rintro ⟨y, hy⟩
    have hy_ne : y ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hy
    have hinv_ne : (CategoryTheory.inv τ₀).hom y ≠ 0 := by
      intro h0
      apply hy_ne
      calc y = (CategoryTheory.inv τ₀ ≫ τ₀).hom y := by
              rw [CategoryTheory.IsIso.inv_hom_id]; rfl
        _ = τ₀.hom ((CategoryTheory.inv τ₀).hom y) := rfl
        _ = 0 := by rw [h0, map_zero]
    have hgerm_ne : ψ'₀ y ≠ 0 := by
      intro h0
      exact hinv_ne (AlgebraicGeometry.Scheme.germToFunctionField_injective Y.left Z₀
        (by simpa [ψ'₀] using h0))
    exact Ne.isUnit hgerm_ne
