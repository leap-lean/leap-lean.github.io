    ext s
    obtain ⟨a₀, b₀, hb₀_nzd, hdiv⟩ :=
      IsFractionRing.div_surjective (A := B₀) ((Y.left.germToFunctionField Z).hom s)
    have hb₀_ne : b₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb₀_nzd
    have hgb₀_ne : (Y.left.germToFunctionField Z₀).hom b₀ ≠ 0 := by
      intro h0
      exact hb₀_ne (AlgebraicGeometry.Scheme.germToFunctionField_injective Y.left Z₀
        (by simpa using h0))
    have h_eq_L : (Y.left.germToFunctionField Z₀).hom b₀ *
        (Y.left.germToFunctionField Z).hom s =
        (Y.left.germToFunctionField Z₀).hom a₀ := by
      have h_alg_a : algebraMap B₀ ↑Y.left.functionField a₀ =
          (Y.left.germToFunctionField Z₀).hom a₀ := rfl
      have h_alg_b : algebraMap B₀ ↑Y.left.functionField b₀ =
          (Y.left.germToFunctionField Z₀).hom b₀ := rfl
      rw [h_alg_a, h_alg_b] at hdiv
      rw [mul_comm]
      exact ((div_eq_iff hgb₀_ne).mp hdiv).symm
    let W_Y : Y.left.Opens := Z ⊓ Z₀
    let W'_Y' : Y'.left.Opens := Z' ⊓ Z'₀
    have : Nonempty W_Y := hInterNe Z Z₀
    have : Nonempty W'_Y' := hInterNe Z' Z'₀
    let i_Z : W_Y ⟶ Z := CategoryTheory.homOfLE inf_le_left
    let i_Z₀ : W_Y ⟶ Z₀ := CategoryTheory.homOfLE inf_le_right
    have hg_Z : Y.left.presheaf.map i_Z.op ≫ Y.left.germToFunctionField W_Y =
        Y.left.germToFunctionField Z :=
      TopCat.Presheaf.germ_res Y.left.presheaf i_Z _ _
    have hg_Z₀ : Y.left.presheaf.map i_Z₀.op ≫ Y.left.germToFunctionField W_Y =
