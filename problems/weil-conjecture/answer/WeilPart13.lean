        refine ⟨iso_π.inv.hom z, ?_⟩
        change (iso_π.inv ≫ iso_π.hom).hom z = z
        simp [iso_π.inv_hom_id]
    have hCompat_π : ∀ (V : S_base.Opens) [Nonempty V] (V' : S'_sch.Opens) [Nonempty V']
