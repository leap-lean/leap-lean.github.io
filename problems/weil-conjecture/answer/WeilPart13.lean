        (Ideal.map Algebra.TensorProduct.includeRight.toRingHom m_F₀) = ⊥ := by
      rw [Ideal.map_map, ← le_bot_iff, Ideal.map_le_iff_le_comap]
      intro x hx
      simp only [Ideal.mem_comap, Submodule.mem_bot, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
