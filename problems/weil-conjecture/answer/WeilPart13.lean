          (CategoryTheory.Limits.pullback.snd (g_seq (Fin.last (k' + 1))) η_K)
          (by
            rw [CategoryTheory.Category.assoc]
            change _ ≫ (maps i_prev ≫ g_seq i_prev.castSucc) = _
            rw [hMapG, CategoryTheory.Limits.pullback.condition])
      have : CategoryTheory.IsIso v_K :=
        hLast.2.2.2.2.2.2.1 v_K
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      let α_prev : CategoryTheory.Limits.pullback (g_seq' (Fin.last k')) η_K ≅
          CategoryTheory.Limits.pullback g₂ η_K :=
        (CategoryTheory.asIso v_K).symm ≪≫ α_top
      have hv_α : v_K ≫ α_prev.hom = α_top.hom := by
        simp [α_prev]
      have hStep_π : maps i_prev ≫ π_from i_prev.castSucc = π_from (Fin.last (k' + 1)) :=
        hTower.2.2.2.2.1 i_prev
      refine ⟨W_seq', g_seq', τ_seq', centers', maps', π_from', α_prev, h',
        hTower', ?_, ?_, hh'_g, hh'_sec, ?_⟩
      · rw [← CategoryTheory.cancel_epi v_K, ← CategoryTheory.Category.assoc, hv_α, hα_snd,
          CategoryTheory.Limits.pullback.lift_snd]
