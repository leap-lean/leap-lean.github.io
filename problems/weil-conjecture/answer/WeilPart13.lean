by
  
  have hs1_dvr : ∀ {R₀ A' : Type u} [CommRing R₀] [IsDomain R₀] [IsNoetherianRing R₀]
      [CommRing A'] [IsDomain A'] [IsNoetherianRing A']
      (f_et : R₀ →+* A'), f_et.Flat →
      ∀ (p_gen p₀ : PrimeSpectrum R₀) (v₀ : PrimeSpectrum A')
        (X₀ : R₀) (u v ε : A') (a b : ℕ),
        p_gen.asIdeal < p₀.asIdeal →
        X₀ ∈ p_gen.asIdeal →
        _root_.IsReduced (R₀ ⧸ Ideal.span ({X₀} : Set R₀)) →
        Ideal.comap f_et v₀.asIdeal = p₀.asIdeal →
        v₀.asIdeal = Ideal.span ({u, v} : Set A') →
        u ≠ 0 →
        (∀ y : A', v * y ∈ Ideal.span ({u} : Set A') → y ∈ Ideal.span ({u} : Set A')) →
        IsUnit ε → 1 ≤ a →
        f_et X₀ = ε * u ^ a * v ^ b →
        IsDiscreteValuationRing (Localization.AtPrime p_gen.asIdeal) ∧
        IsLocalRing.maximalIdeal (Localization.AtPrime p_gen.asIdeal) =
          Ideal.span ({algebraMap R₀ (Localization.AtPrime p_gen.asIdeal) X₀} :
            Set (Localization.AtPrime p_gen.asIdeal)) := by
    intro R₀ A' _ _ _ _ _ _ f_et hf_flat p_gen p₀ v₀ X₀ u v ε a b
      hp_lt hX_mem hRed hv_over hv_span hu_ne hreg_uv hε _ha hX_eq
    have hv_ne : v ≠ 0 := by
      intro hv0
      have h1_u : (1 : A') ∈ Ideal.span ({u} : Set A') := by
        apply hreg_uv 1
        rw [hv0, zero_mul]
        exact Ideal.zero_mem _
      have h1_v0 : (1 : A') ∈ v₀.asIdeal := by
        rw [hv_span]
        exact Ideal.span_mono (by simp) h1_u
      exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_v0)
    have hX_ne : X₀ ≠ 0 := by
      intro hX0
      have h0 : ε * u ^ a * v ^ b = 0 := by rw [← hX_eq, hX0, map_zero]
      exact mul_ne_zero (mul_ne_zero hε.ne_zero (pow_ne_zero a hu_ne)) (pow_ne_zero b hv_ne) h0
    let : Algebra R₀ A' := f_et.toAlgebra
    have : Module.Flat R₀ A' := hf_flat
    have hinj_fet : Function.Injective f_et := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro r hr
      by_contra hr_ne
      have hinj_mul : Function.Injective (LinearMap.mulLeft R₀ r) :=
        fun _ _ hxy => mul_left_cancel₀ hr_ne hxy
      have hinj_ten := Module.Flat.lTensor_preserves_injective_linearMap
        (M := A') (LinearMap.mulLeft R₀ r) hinj_mul
      have h_zero : (LinearMap.mulLeft R₀ r).lTensor A' ((1 : A') ⊗ₜ[R₀] (1 : R₀)) = 0 := by
        simp only [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, mul_one]
        have hr1 : r = r • (1 : R₀) := by simp
        rw [hr1, ← TensorProduct.smul_tmul, Algebra.smul_def]
        change (f_et r * 1) ⊗ₜ[R₀] (1 : R₀) = 0
        have hfr : f_et r = 0 := hr
        rw [hfr, zero_mul, TensorProduct.zero_tmul]
      have h11 : ((1 : A') ⊗ₜ[R₀] (1 : R₀)) = 0 :=
        hinj_ten (h_zero.trans (map_zero _).symm)
      have h1_eq_0 : (1 : A') = 0 := by
        have hrid := congrArg (TensorProduct.rid R₀ A') h11
        simp at hrid
      exact one_ne_zero h1_eq_0
    let L' := Localization.AtPrime v₀.asIdeal
    have : IsDomain L' :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors v₀.asIdeal)
    have : IsNoetherianRing L' :=
      IsLocalization.isNoetherianRing v₀.asIdeal.primeCompl L' ‹IsNoetherianRing A'›
    have hinj_AL' : Function.Injective (algebraMap A' L') :=
      IsLocalization.injective L' (Ideal.primeCompl_le_nonZeroDivisors v₀.asIdeal)
    let u' : L' := algebraMap A' L' u
    let v' : L' := algebraMap A' L' v
    let ε' : L' := algebraMap A' L' ε
    have hm_L' : IsLocalRing.maximalIdeal L' = Ideal.span ({u', v'} : Set L') := by
      have hmap := congrArg (Ideal.map (algebraMap A' L')) hv_span
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact hmap.trans (by rw [Ideal.map_span]; simp [u', v'])
    have hPrime_pair : ∀ (t₁ t₂ : L'),
        IsLocalRing.maximalIdeal L' = Ideal.span ({t₁, t₂} : Set L') →
        ∀ (q : Ideal L') [q.IsPrime], q < IsLocalRing.maximalIdeal L' → t₁ ∈ q →
          q = Ideal.span ({t₁} : Set L') := by
      intro t₁ t₂ hm_span q hq_prime hq_lt ht₁_q
      let I₁ : Ideal L' := Ideal.span ({t₁} : Set L')
      have hI₁_le : I₁ ≤ q := (Ideal.span_singleton_le_iff_mem q).mpr ht₁_q
      have hI₁_ne_top : I₁ ≠ ⊤ := ne_top_of_le_ne_top hq_prime.ne_top hI₁_le
      have ht₂_not_q : t₂ ∉ q := by
        intro ht₂_q
        apply not_le_of_gt hq_lt
        rw [hm_span, Ideal.span_le]
        intro x hx
        rcases Set.mem_insert_iff.mp hx with rfl | hx'
        · exact ht₁_q
        · rw [Set.mem_singleton_iff.mp hx']
          exact ht₂_q
      let Q₁ := L' ⧸ I₁
      let π₁ : L' →+* Q₁ := Ideal.Quotient.mk I₁
      have : Nontrivial Q₁ :=
        ⟨⟨0, 1, fun h01 => hI₁_ne_top ((Ideal.eq_top_iff_one _).mpr
          (Ideal.Quotient.eq_zero_iff_mem.mp h01.symm))⟩⟩
      have : IsLocalRing Q₁ := IsLocalRing.of_surjective' π₁ Ideal.Quotient.mk_surjective
      let J₁ : Ideal Q₁ := Ideal.span ({π₁ t₂} : Set Q₁)
      have ht₂_mem_m : t₂ ∈ IsLocalRing.maximalIdeal L' := by
        rw [hm_span]
        exact Ideal.subset_span (by simp)
      have hJ₁_ne_top : J₁ ≠ ⊤ := by
        intro hJ_top
        have h1_J : (1 : Q₁) ∈ J₁ := by rw [hJ_top]; trivial
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp h1_J
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective c
        have h_diff : 1 - t₂ * w ∈ I₁ :=
          Ideal.Quotient.eq_zero_iff_mem.mp (by simp [π₁, map_sub, map_mul, ← hc])
        have h_in_m : 1 - t₂ * w ∈ IsLocalRing.maximalIdeal L' :=
          (hI₁_le.trans hq_lt.le) h_diff
        have h1_m : (1 : L') ∈ IsLocalRing.maximalIdeal L' := by
          have : (1 : L') = (1 - t₂ * w) + t₂ * w := by ring
