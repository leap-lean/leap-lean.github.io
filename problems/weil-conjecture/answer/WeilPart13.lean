  dsimp only [Φ_K, RingEquiv.trans_apply]
  have h12 :
      Ψ₂.symm (Ψ₁ (Ideal.Quotient.mk I_cube (algebraMap K (TensorProduct κ₀ K F₀) c))) =
        Ideal.Quotient.mk ((Ideal.comap ψ₂ m₀.asIdeal) ^ 3)
