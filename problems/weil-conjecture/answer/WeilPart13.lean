  have hNeZ₀ : Nonempty Z₀ := ⟨⟨u₀.1, hu₀_Z₀⟩⟩
  obtain ⟨x_Z₀, hx_Z₀⟩ : u₀.1 ∈ Set.range hAffZ₀.fromSpec.base := by
    rw [hAffZ₀.range_fromSpec]; exact hu₀_Z₀
  have hNeZ'₀ : Nonempty Z'₀ := ⟨⟨β₀.base x_Z₀, ⟨x_Z₀, rfl⟩⟩⟩
  have hZ'₀_le_q : Z'₀ ≤ (TopologicalSpace.Opens.map q'.left.base).obj Z₀ := by
    rintro y' ⟨x, rfl⟩
