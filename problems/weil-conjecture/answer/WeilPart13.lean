    have hσBj_q_left : (σ_B j).left ≫ (q_XB.left ≫ qX₃.left) =
        (ψ₄.left ≫ ψ₃.left) ≫ (σ j).left :=
      congrArg CategoryTheory.CommaMorphism.left (hσB_q j)
    have huBj_pr₁ : u_Bj ≫ pr₁.left = U_B.ι ≫ (τ j).left := by
      refine hPb_C.hom_ext ?_ ?_
      · change (u_Bj ≫ p₁) ≫ q_C.left = (U_B.ι ≫ (τ j).left) ≫ q_C.left
        rw [CategoryTheory.Category.assoc, hp₁_qC, ← CategoryTheory.Category.assoc, huBj_q,
