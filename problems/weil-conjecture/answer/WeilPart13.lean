        _ = (ι_Y' ⁻¹ᵁ W'_pb).ι ≫ ι_Y' := AlgebraicGeometry.morphismRestrict_ι ι_Y' W'_pb
        _ = (𝟙 (ι_Y' ⁻¹ᵁ W'_pb).toScheme ≫ (ι_Y' ⁻¹ᵁ W'_pb).ι) ≫ ι_Y' := by
              rw [CategoryTheory.Category.id_comp]
    exact ⟨⟨t_W, h_comp_t, ht_fst⟩⟩

  let f'_sch : j.image ⟶ S'.left := ι_Y' ≫ snd_P
  let q'_sch : j.image ⟶ Y.left := ι_Y' ≫ fst_P
  let Y' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (f'_sch ≫ S'.hom)
  haveI : AlgebraicGeometry.IsIntegral Y'.left := hIntY'
  let f' : Y' ⟶ S' := CategoryTheory.Over.homMk f'_sch rfl
  have hq'_w : q'_sch ≫ Y.hom = Y'.hom := by
    dsimp [Y', f'_sch, q'_sch]
    calc (ι_Y' ≫ fst_P) ≫ Y.hom
        = ι_Y' ≫ fst_P ≫ (p.left ≫ S.hom) := by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Over.w p]
      _ = ι_Y' ≫ (fst_P ≫ p.left) ≫ S.hom := by
            simp only [CategoryTheory.Category.assoc]
      _ = ι_Y' ≫ (snd_P ≫ π.left) ≫ S.hom := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = (ι_Y' ≫ snd_P) ≫ S'.hom := by
