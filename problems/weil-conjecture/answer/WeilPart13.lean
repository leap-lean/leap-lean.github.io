        obtain ⟨k, u_x, hux⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx_ne hπ₂_irr
        obtain ⟨m, u_y, huy⟩ := IsDiscreteValuationRing.associated_pow_irreducible hy_ne hπ₂_irr
        obtain ⟨u_x', hux'⟩ := (Associated.symm ⟨u_x, hux⟩)
        obtain ⟨u_y', huy'⟩ := (Associated.symm ⟨u_y, huy⟩)
