        Algebra.FiniteType.isNoetherianRing
          (Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀)))
          ↑(F.presheaf.obj (Opposite.op V_z))
      let q_pt := hVz.primeIdealOf ⟨z, hz⟩
      let q₀ := q_pt.asIdeal
      haveI : q₀.IsPrime := q_pt.isPrime
      haveI : IsDomain (Localization.AtPrime q₀) :=
        (h_stalk_dom
          ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U₀))
          ↑(F.presheaf.obj (Opposite.op V_z)) q₀).2
      haveI : (⊥ : Ideal (Localization.AtPrime q₀)).IsPrime := Ideal.isPrime_bot
      let p_bot : Ideal ↑(F.presheaf.obj (Opposite.op V_z)) :=
        Ideal.comap (algebraMap _ (Localization.AtPrime q₀)) ⊥
      haveI : p_bot.IsPrime := Ideal.IsPrime.comap (algebraMap _ (Localization.AtPrime q₀))
      have hp_bot_le : ∀ (r : Ideal ↑(F.presheaf.obj (Opposite.op V_z))),
          r.IsPrime → r ≤ q₀ → p_bot ≤ r := by
        intro r hr hr_le
        have hr_disj : Disjoint
            (q₀.primeCompl : Set ↑(F.presheaf.obj (Opposite.op V_z)))
            (r : Set ↑(F.presheaf.obj (Opposite.op V_z))) :=
