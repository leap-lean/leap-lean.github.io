  rcases h_s1 q₀ with ⟨K_in, instFieldK, toK, q_K, hq_K, h_K, hh_K, hSmRelK⟩ | hNode₀
  · left
    let R₀ : Type u := ↑(S.presheaf.obj (Opposite.op U_S))
    let A₀ : Type u := ↑(C.presheaf.obj (Opposite.op U_C))
