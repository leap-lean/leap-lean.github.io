  have hOpen_uh : ∀ q : PrimeSpectrum B₀, AlgebraicGeometry.IsOpenImmersion (u_h q) :=
    fun q => AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway
      (R := CommRingCat.of B₀) (h₀ q)
  have hGlue : ∀ (X Y : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsReduced X]
      (p_X : X ⟶ S) (p_Y : Y ⟶ S) [AlgebraicGeometry.IsSeparated p_Y]
      (_ : AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst p_X η_L))
      (α_L : CategoryTheory.Limits.pullback p_X η_L ⟶
        CategoryTheory.Limits.pullback p_Y η_L)
      (w_X : ∀ q, CategoryTheory.Limits.pullback p_X η_L ⟶
        CategoryTheory.Limits.pullback p_X (u_h q))
      (_ : ∀ q, w_X q ≫ CategoryTheory.Limits.pullback.fst p_X (u_h q) =
        CategoryTheory.Limits.pullback.fst p_X η_L)
      (ψ_loc : ∀ q, CategoryTheory.Limits.pullback p_X (u_h q) ⟶
        CategoryTheory.Limits.pullback p_Y (u_h q))
      (_ : ∀ q, ψ_loc q ≫ CategoryTheory.Limits.pullback.snd p_Y (u_h q) =
        CategoryTheory.Limits.pullback.snd p_X (u_h q))
      (_ : ∀ q, (w_X q ≫ ψ_loc q) ≫ CategoryTheory.Limits.pullback.fst p_Y (u_h q) =
        α_L ≫ CategoryTheory.Limits.pullback.fst p_Y η_L),
      ∃ (F : X ⟶ Y),
        F ≫ p_Y = p_X ∧
        CategoryTheory.Limits.pullback.fst p_X η_L ≫ F =
          α_L ≫ CategoryTheory.Limits.pullback.fst p_Y η_L := by
    intro X Y _ p_X p_Y _ hDom_X α_L w_X hw_X ψ_loc hψ_snd hψ_gen
    have hOpen_f : ∀ q : PrimeSpectrum B₀,
        AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.fst p_X (u_h q)) := by
      intro q
      have := hOpen_uh q
      infer_instance
    have hCovers : ∀ x : ↥X,
        ∃ (q : PrimeSpectrum B₀) (y : ↥(CategoryTheory.Limits.pullback p_X (u_h q))),
          CategoryTheory.Limits.pullback.fst p_X (u_h q) y = x := by
      intro x
      let q : PrimeSpectrum B₀ := p_X x
      have hq_basic : q ∈ (PrimeSpectrum.basicOpen (h₀ q)).1 := hh₀ q
      have h_range_uh : Set.range ⇑(u_h q) = (PrimeSpectrum.basicOpen (h₀ q)).1 :=
        @PrimeSpectrum.localization_away_comap_range B₀ _ (Localization.Away (h₀ q)) _ _ (h₀ q) _
      rw [← h_range_uh] at hq_basic
      have hx_pre : x ∈ ⇑p_X ⁻¹' Set.range ⇑(u_h q) := hq_basic
      rw [← AlgebraicGeometry.Scheme.Pullback.range_fst p_X (u_h q)] at hx_pre
      rcases hx_pre with ⟨y, hy⟩
      exact ⟨q, y, hy⟩
    let 𝒰_X : X.OpenCover :=
      @AlgebraicGeometry.Scheme.Cover.mkOfCovers X (@AlgebraicGeometry.IsOpenImmersion)
        (PrimeSpectrum B₀) (fun q => CategoryTheory.Limits.pullback p_X (u_h q))
        (fun q => CategoryTheory.Limits.pullback.fst p_X (u_h q)) hCovers hOpen_f
    let α : ∀ q : 𝒰_X.I₀, 𝒰_X.X q ⟶ Y :=
      fun q => ψ_loc q ≫ CategoryTheory.Limits.pullback.fst p_Y (u_h q)
    have hα_over : ∀ q : 𝒰_X.I₀, α q ≫ p_Y = 𝒰_X.f q ≫ p_X := by
      intro q
      change (ψ_loc q ≫ CategoryTheory.Limits.pullback.fst p_Y (u_h q)) ≫ p_Y =
        CategoryTheory.Limits.pullback.fst p_X (u_h q) ≫ p_X
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hψ_snd q,
        ← CategoryTheory.Limits.pullback.condition]
    have h_ov : ∀ (q q' : 𝒰_X.I₀),
        CategoryTheory.Limits.pullback.fst (𝒰_X.f q) (𝒰_X.f q') ≫ α q =
          CategoryTheory.Limits.pullback.snd (𝒰_X.f q) (𝒰_X.f q') ≫ α q' := by
      intro q q'
      let π₁ := CategoryTheory.Limits.pullback.fst (𝒰_X.f q) (𝒰_X.f q')
      let π₂ := CategoryTheory.Limits.pullback.snd (𝒰_X.f q) (𝒰_X.f q')
      have : AlgebraicGeometry.IsOpenImmersion (𝒰_X.f q) := hOpen_f q
      have : AlgebraicGeometry.IsOpenImmersion (𝒰_X.f q') := hOpen_f q'
      have : AlgebraicGeometry.IsReduced
          (CategoryTheory.Limits.pullback (𝒰_X.f q) (𝒰_X.f q')) :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion (π₁ ≫ 𝒰_X.f q)
      let ι_O : CategoryTheory.Limits.pullback p_X η_L ⟶
          CategoryTheory.Limits.pullback (𝒰_X.f q) (𝒰_X.f q') :=
        CategoryTheory.Limits.pullback.lift (w_X q) (w_X q')
          (by change w_X q ≫ CategoryTheory.Limits.pullback.fst p_X (u_h q) =
                w_X q' ≫ CategoryTheory.Limits.pullback.fst p_X (u_h q')
              rw [hw_X q, hw_X q'])
      have hι_O_comp : ι_O ≫ (π₁ ≫ 𝒰_X.f q) =
          CategoryTheory.Limits.pullback.fst p_X η_L := by
        rw [← CategoryTheory.Category.assoc]
        have h_lift₁ : ι_O ≫ π₁ = w_X q := CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [h_lift₁]
        exact hw_X q
      have : AlgebraicGeometry.IsDominant (ι_O ≫ (π₁ ≫ 𝒰_X.f q)) :=
        hι_O_comp.symm ▸ hDom_X
      have : AlgebraicGeometry.IsDominant ι_O :=
        AlgebraicGeometry.IsDominant.of_comp_of_isOpenImmersion ι_O (π₁ ≫ 𝒰_X.f q)
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_Y ?_ ι_O ?_
      · rw [CategoryTheory.Category.assoc, hα_over q, CategoryTheory.Category.assoc,
          hα_over q', ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      · have h_left : ι_O ≫ (π₁ ≫ α q) =
            α_L ≫ CategoryTheory.Limits.pullback.fst p_Y η_L :=
          (CategoryTheory.Category.assoc ι_O π₁ (α q)).symm.trans
            ((congrArg (· ≫ α q) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Category.assoc (w_X q) (ψ_loc q) _).symm.trans (hψ_gen q)))
        have h_right : ι_O ≫ (π₂ ≫ α q') =
            α_L ≫ CategoryTheory.Limits.pullback.fst p_Y η_L :=
          (CategoryTheory.Category.assoc ι_O π₂ (α q')).symm.trans
            ((congrArg (· ≫ α q') (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.Category.assoc (w_X q') (ψ_loc q') _).symm.trans (hψ_gen q')))
        exact h_left.trans h_right.symm
    let F : X ⟶ Y := 𝒰_X.glueMorphisms α h_ov
    have hF_over : F ≫ p_Y = p_X := by
      apply 𝒰_X.hom_ext
      intro q
      have hF_q : 𝒰_X.f q ≫ F = α q := 𝒰_X.ι_glueMorphisms α h_ov q
      rw [← CategoryTheory.Category.assoc, hF_q, hα_over q]
    let q₀ : PrimeSpectrum B₀ := η_L pt₀
    let q₀' : 𝒰_X.I₀ := q₀
    have hF_gen : CategoryTheory.Limits.pullback.fst p_X η_L ≫ F =
        α_L ≫ CategoryTheory.Limits.pullback.fst p_Y η_L :=
      (congrArg (· ≫ F) (hw_X q₀).symm).trans
        ((CategoryTheory.Category.assoc (w_X q₀) (𝒰_X.f q₀') F).trans
          ((congrArg (w_X q₀ ≫ ·) (𝒰_X.ι_glueMorphisms α h_ov q₀')).trans
            ((CategoryTheory.Category.assoc (w_X q₀) (ψ_loc q₀) _).symm.trans (hψ_gen q₀))))
    exact ⟨F, hF_over, hF_gen⟩
  have : AlgebraicGeometry.IsIntegral C₁ := hInt₁
  have : AlgebraicGeometry.IsIntegral C₂ := hInt₂
  have : AlgebraicGeometry.IsReduced C₁ := AlgebraicGeometry.isReduced_of_isIntegral C₁
  have : AlgebraicGeometry.IsReduced C₂ := AlgebraicGeometry.isReduced_of_isIntegral C₂
  have : AlgebraicGeometry.IsProper g₁ := hProp₁
  have : AlgebraicGeometry.IsProper g₂ := hProp₂
  have : AlgebraicGeometry.IsSeparated g₁ := AlgebraicGeometry.IsProper.toIsSeparated
  have : AlgebraicGeometry.IsSeparated g₂ := AlgebraicGeometry.IsProper.toIsSeparated
