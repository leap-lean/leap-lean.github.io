        intro V
        change AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of
            (↑(Z.presheaf.obj (Opposite.op V.1)) ⧸ γ.ker.ideal V)))
        have : _root_.IsReduced (↑(Z.presheaf.obj (Opposite.op V.1)) ⧸ γ.ker.ideal V) := by
          refine ⟨fun q hq => ?_⟩
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
