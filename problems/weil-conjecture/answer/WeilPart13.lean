  have hp_fromSpec : p ≫ hAffU₀.fromSpec = g_X := by
    dsimp [p, g_X]
    rw [CategoryTheory.Category.assoc, hAffU₀.toSpecΓ_fromSpec, AlgebraicGeometry.morphismRestrict_ι]
  have hV_top_le : (⊤ : Y.Opens) ≤ (TopologicalSpace.Opens.map g_X.base).obj U₀ :=
    fun y _ => y.2
  have hAppCongr : ∀ (f' : Y ⟶ X.left) (_ : f' = g_X)
      (hle : (⊤ : Y.Opens) ≤ (TopologicalSpace.Opens.map f'.base).obj U₀),
