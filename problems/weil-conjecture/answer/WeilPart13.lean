    obtain ⟨⟨r₀, ⟨_, k, rfl⟩⟩, hur₀⟩ :=
      IsLocalization.surj (Submonoid.powers g₀) (ψ_lift_cat.hom b)
    refine ⟨r₀, g₀ ^ k, pow_ne_zero k hg₀_ne, hinj_ψlift ?_⟩
    calc ψ_lift_cat.hom (φ.hom (g₀ ^ k) * b)
        = ψ_lift_cat.hom b * ψ_lift_cat.hom (φ.hom (g₀ ^ k)) := by rw [map_mul, mul_comm]
      _ = ψ_lift_cat.hom b * algebraMap ↑A (Localization.Away g₀) (g₀ ^ k) := by rw [hψ_lift_comp]
      _ = algebraMap ↑A (Localization.Away g₀) r₀ := hur₀
      _ = ψ_lift_cat.hom (φ.hom r₀) := (hψ_lift_comp r₀).symm
  have hs3_dvr_overring : ∀ {R₁ R_02 : Type u} [CommRing R₁] [IsDomain R₁]
