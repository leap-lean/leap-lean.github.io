  have hEtaleSliceZero : ∀ (V : AlgebraicGeometry.Scheme.{u}) (v : V ⟶ Y.left)
      [hv : AlgebraicGeometry.Etale v],
      (∃ H_V : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback v R₁ H_V ∧ CategoryTheory.Limits.IsZero H_V) →
      let V_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ v hv
      Subsingleton ↥(R₁.obj.obj (Opposite.op V_et)) := by
    intro V v hv ⟨H_V, ⟨hc_v, hr_v, ⟨e_HV⟩⟩, hZero_HV⟩ V_et
    let M_v : CategoryTheory.Functor V.Etale Y.left.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hv
    let B_v : CategoryTheory.Functor Y.left.Etale V.Etale := weilEtaleSitePullback v
    let adj_slice : M_v ⊣ B_v :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ v hv trivial
    have hCov : CategoryTheory.CoverPreserving V.smallEtaleTopology J_Y M_v := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro W_v S hS
      have hMemV := (hMemEtale V W_v S).mp hS
      refine (hMemEtale Y.left (M_v.obj W_v) _).mpr ?_
      intro x
      obtain ⟨W₁, f, y, hfS, hfEt, hfy⟩ := hMemV x
      refine ⟨M_v.obj W₁, M_v.map f, y, ?_, hfEt, hfy⟩
      exact ⟨W₁, f, CategoryTheory.CategoryStruct.id (M_v.obj W₁), hfS,
        (CategoryTheory.Category.id_comp (M_v.map f)).symm⟩
    have hCompat : CategoryTheory.CompatiblePreserving J_Y M_v := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ W_v T x hx Y₁ Y₂ Z_c f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      let f₁_left : Quiver.Hom Z_c.left Y₁.left := f₁.left
      let f₂_left : Quiver.Hom Z_c.left Y₂.left := f₂.left
      have hfg_left : CategoryTheory.CategoryStruct.comp f₁_left g₁.left =
          CategoryTheory.CategoryStruct.comp f₂_left g₂.left :=
        congrArg (fun m => m.left) hfg
      let w_Z : Quiver.Hom Z_c.left V := CategoryTheory.CategoryStruct.comp f₁_left Y₁.hom
      have hw_Z_h : CategoryTheory.CategoryStruct.comp w_Z v = Z_c.hom :=
        (CategoryTheory.Category.assoc f₁_left Y₁.hom v).trans
          (CategoryTheory.MorphismProperty.Over.w f₁)
      have hw_Z : P_et w_Z :=
        CategoryTheory.MorphismProperty.of_postcomp P_et w_Z v hv (hw_Z_h.symm ▸ Z_c.prop)
      have hw₂ : CategoryTheory.CategoryStruct.comp f₂_left Y₂.hom = w_Z := by
        calc
          CategoryTheory.CategoryStruct.comp f₂_left Y₂.hom
              = CategoryTheory.CategoryStruct.comp f₂_left (CategoryTheory.CategoryStruct.comp g₂.left W_v.hom) :=
                congrArg (CategoryTheory.CategoryStruct.comp f₂_left) (CategoryTheory.MorphismProperty.Over.w g₂).symm
          _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₂_left g₂.left) W_v.hom :=
                (CategoryTheory.Category.assoc f₂_left g₂.left W_v.hom).symm
          _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₁_left g₁.left) W_v.hom :=
                congrArg (fun k => CategoryTheory.CategoryStruct.comp k W_v.hom) hfg_left.symm
          _ = CategoryTheory.CategoryStruct.comp f₁_left (CategoryTheory.CategoryStruct.comp g₁.left W_v.hom) :=
                CategoryTheory.Category.assoc f₁_left g₁.left W_v.hom
          _ = w_Z := congrArg (CategoryTheory.CategoryStruct.comp f₁_left) (CategoryTheory.MorphismProperty.Over.w g₁)
      let Z_lift : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_Z hw_Z
      let f₁_lift : Quiver.Hom Z_lift Y₁ :=
        CategoryTheory.MorphismProperty.Over.homMk f₁_left rfl trivial
      let f₂_lift : Quiver.Hom Z_lift Y₂ :=
        CategoryTheory.MorphismProperty.Over.homMk f₂_left hw₂ trivial
      have h_lift_eq : CategoryTheory.CategoryStruct.comp f₁_lift g₁ =
          CategoryTheory.CategoryStruct.comp f₂_lift g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hfg_left (Subsingleton.elim _ _)
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ h_lift_eq
      let ι_Z : Quiver.Hom Z_c (M_v.obj Z_lift) :=
        CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id Z_c.left)
          ((CategoryTheory.Category.id_comp _).trans hw_Z_h) trivial
      have hι₁ : CategoryTheory.CategoryStruct.comp ι_Z (M_v.map f₁_lift) = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₁_left) (Subsingleton.elim _ _)
      have hι₂ : CategoryTheory.CategoryStruct.comp ι_Z (M_v.map f₂_lift) = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₂_left) (Subsingleton.elim _ _)
      have hmap₁ : ℱ.obj.map f₁.op =
          CategoryTheory.CategoryStruct.comp (ℱ.obj.map (M_v.map f₁_lift).op) (ℱ.obj.map ι_Z.op) := by
        rw [← hι₁, CategoryTheory.op_comp, ℱ.obj.map_comp]
      have hmap₂ : ℱ.obj.map f₂.op =
          CategoryTheory.CategoryStruct.comp (ℱ.obj.map (M_v.map f₂_lift).op) (ℱ.obj.map ι_Z.op) := by
        rw [← hι₂, CategoryTheory.op_comp, ℱ.obj.map_comp]
      have h_app := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map ι_Z.op)) hx_eq
      change (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₁.op)) (x g₁ hg₁) =
        (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₂.op)) (x g₂ hg₂)
      rw [hmap₁, hmap₂]
      exact h_app
    have hcM : M_v.IsContinuous V.smallEtaleTopology J_Y :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
    let _ : B_v.IsContinuous J_Y V.smallEtaleTopology := hc_v
    let _ : M_v.IsContinuous V.smallEtaleTopology J_Y := hcM
    let R_v := M_v.sheafPushforwardContinuous AddCommGrpCat.{u} V.smallEtaleTopology J_Y
    let pf_v := B_v.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y V.smallEtaleTopology
    let _ : pf_v.IsRightAdjoint := hr_v
    let pb_v := B_v.sheafPullback AddCommGrpCat.{u} J_Y V.smallEtaleTopology
    obtain ⟨e_Rpb⟩ : Nonempty (R_v ≅ pb_v) := by
      let adj_R : R_v ⊣ pf_v :=
        CategoryTheory.Adjunction.mkOfUnitCounit
          { unit :=
              { app := fun ℱ => CategoryTheory.ObjectProperty.homMk
                  { app := fun W_op => ℱ.obj.map (adj_slice.counit.app W_op.unop).op
                    naturality := fun {W₁ W₂} u => by
                      change (ℱ.obj.map u.unop.op) ≫ (ℱ.obj.map (adj_slice.counit.app W₂.unop).op) =
                        (ℱ.obj.map (adj_slice.counit.app W₁.unop).op) ≫
                          (ℱ.obj.map (M_v.map (B_v.map u.unop)).op)
                      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
                      exact congrArg (fun k => ℱ.obj.map k.op) (adj_slice.counit.naturality u.unop).symm }
                naturality := fun {ℱ₁ ℱ₂} φ => by
                  apply CategoryTheory.Sheaf.hom_ext
                  ext W_op : 2
                  exact (φ.hom.naturality (adj_slice.counit.app W_op.unop).op).symm }
            counit :=
              { app := fun 𝒢 => CategoryTheory.ObjectProperty.homMk
                  { app := fun W_op => 𝒢.obj.map (adj_slice.unit.app W_op.unop).op
                    naturality := fun {W₁ W₂} u => by
                      change (𝒢.obj.map (B_v.map (M_v.map u.unop)).op) ≫
                          (𝒢.obj.map (adj_slice.unit.app W₂.unop).op) =
                        (𝒢.obj.map (adj_slice.unit.app W₁.unop).op) ≫ (𝒢.obj.map u.unop.op)
                      rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
                      exact congrArg (fun k => 𝒢.obj.map k.op) (adj_slice.unit.naturality u.unop).symm }
                naturality := fun {𝒢₁ 𝒢₂} ψ => by
                  apply CategoryTheory.Sheaf.hom_ext
                  ext W_op : 2
                  exact (ψ.hom.naturality (adj_slice.unit.app W_op.unop).op).symm }
            left_triangle := by
              ext ℱ : 2
              apply CategoryTheory.Sheaf.hom_ext
              ext W_op : 2
              change (ℱ.obj.map (adj_slice.counit.app (M_v.obj W_op.unop)).op) ≫
                  (ℱ.obj.map (M_v.map (adj_slice.unit.app W_op.unop)).op) = 𝟙 _
              rw [← ℱ.obj.map_comp, ← CategoryTheory.op_comp, adj_slice.left_triangle_components W_op.unop]
              exact ℱ.obj.map_id (Opposite.op (M_v.obj W_op.unop))
            right_triangle := by
              ext 𝒢 : 2
              apply CategoryTheory.Sheaf.hom_ext
              ext W_op : 2
              change (𝒢.obj.map (B_v.map (adj_slice.counit.app W_op.unop)).op) ≫
                  (𝒢.obj.map (adj_slice.unit.app (B_v.obj W_op.unop)).op) = 𝟙 _
              rw [← 𝒢.obj.map_comp, ← CategoryTheory.op_comp, adj_slice.right_triangle_components W_op.unop]
              exact 𝒢.obj.map_id (Opposite.op (B_v.obj W_op.unop)) }
      exact ⟨adj_R.leftAdjointUniq (B_v.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y V.smallEtaleTopology)⟩
    have hZero_Rv : CategoryTheory.Limits.IsZero (R_v.obj R₁) :=
      (hZero_HV.of_iso e_HV).of_iso (e_Rpb.app R₁)
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    have hZero_sec : CategoryTheory.Limits.IsZero ((R_v.obj R₁).obj.obj (Opposite.op T_V)) :=
      ((CategoryTheory.sheafSections V.smallEtaleTopology AddCommGrpCat.{u}).obj
