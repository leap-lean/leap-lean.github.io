      | mul x y hx hy ihx ihy =>
        intro _
        exact Subalgebra.mul_mem _ (ihx (hle_CM hx)) (ihy (hle_CM hy))
    exact hz_pull z.1 hz_cl z.2

  obtain ⟨Q_inf_k, hQ_inf_k_prime, hQ_inf_k_under, hInert_inf⟩ :=
    s5_sig F k C_inf_F C_inf_M L_r M_r
      (integralClosure A_inf_r L_r).val.toRingHom Subtype.val_injective
      (integralClosure A_inf_k M_r).val.toRingHom Subtype.val_injective
      ψ_M ι_C_inf hι_C_inf_inj (RingHom.ext fun _ => rfl) hι_C_inf_comm_F
      hι_C_inf_adjoin Q_inf hQ_inf_prime

  have hQ_inf_k_comap :
      Ideal.comap (algebraMap A_inf_k C_inf_M) Q_inf_k = Ideal.span {t_inf_k} := by
    let p_inf_k : Ideal A_inf_k := Ideal.comap (algebraMap A_inf_k C_inf_M) Q_inf_k
    have hp_prime : p_inf_k.IsPrime := hQ_inf_k_prime.comap _
    have ht_mem : t_inf_k ∈ p_inf_k := by
      have ht_r : t_inf_r ∈ Ideal.comap (algebraMap A_inf_r C_inf_F) Q_inf := by
        rw [hQ_inf_comap]
        exact Ideal.subset_span (Set.mem_singleton t_inf_r)
      rw [← hQ_inf_k_under, Ideal.mem_comap, Ideal.mem_comap] at ht_r
      have heq : algebraMap A_inf_k C_inf_M t_inf_k = ι_C_inf (algebraMap A_inf_r C_inf_F t_inf_r) := by
        apply Subtype.ext
        change u_M = ψ_M (algebraMap A_inf_r L_r t_inf_r)
        rw [hu_L_eq, hψ_uL]
      rw [Ideal.mem_comap, heq]
      exact ht_r
    apply le_antisymm
    · intro x hx
      have hx_rng : x ∈ (Polynomial.aeval t_inf_k : Polynomial k →ₐ[k] A_inf_k).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval, hA_inf_k_top]
        exact Algebra.mem_top
      rcases hx_rng with ⟨P, rfl⟩
      have hdiv : Polynomial.aeval t_inf_k P =
          t_inf_k * Polynomial.aeval t_inf_k P.divX + algebraMap k A_inf_k (P.coeff 0) := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add P]
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      have hc0_mem : algebraMap k A_inf_k (P.coeff 0) ∈ p_inf_k := by
        have h1 : algebraMap k A_inf_k (P.coeff 0) =
            Polynomial.aeval t_inf_k P - t_inf_k * Polynomial.aeval t_inf_k P.divX := by
          rw [hdiv, add_sub_cancel_left]
        rw [h1]
        exact p_inf_k.sub_mem hx (p_inf_k.mul_mem_right _ ht_mem)
      have hc0_zero : P.coeff 0 = 0 := by
        by_contra hc_ne
        have hu : IsUnit (algebraMap k A_inf_k (P.coeff 0)) :=
          (IsUnit.mk0 _ hc_ne).map (algebraMap k A_inf_k)
        exact hp_prime.ne_top (Ideal.eq_top_of_isUnit_mem p_inf_k hc0_mem hu)
      change Polynomial.aeval t_inf_k P ∈ Ideal.span {t_inf_k}
      rw [hdiv, hc0_zero, map_zero, add_zero]
      exact Ideal.mem_span_singleton.mpr ⟨Polynomial.aeval t_inf_k P.divX, rfl⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact ht_mem

  let j_PF_Pk : Polynomial F →+* Polynomial k := Polynomial.mapRingHom (algebraMap F k)
  have hj_PF_Pk_M : (algebraMap (Polynomial k) M_r).comp j_PF_Pk =
      ψ_M.comp (algebraMap (Polynomial F) L_r) := by
    apply Polynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, j_PF_Pk, Polynomial.coe_mapRingHom, Polynomial.map_C]
      have hL : algebraMap (Polynomial k) M_r (Polynomial.C (algebraMap F k c)) =
          algebraMap k M_r (algebraMap F k c) :=
        (IsScalarTower.algebraMap_apply k (Polynomial k) M_r (algebraMap F k c)).symm
      have hR : algebraMap (Polynomial F) L_r (Polynomial.C c) = algebraMap F L_r c :=
        (IsScalarTower.algebraMap_apply F (Polynomial F) L_r c).symm
      rw [hL, hR, hψ_F c]
    · simp only [RingHom.comp_apply, j_PF_Pk, Polynomial.coe_mapRingHom, Polynomial.map_X,
        IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M_r,
        IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
        RatFunc.algebraMap_X, ← hX_kr, hψ_X]

  let C_0_F := ↥(integralClosure (Polynomial F) L_r)
  let C_0_M := ↥(integralClosure (Polynomial k) M_r)
  let ι_C_aff : C_0_F →+* C_0_M :=
    { toFun := fun y => ⟨ψ_M y.1, y.2.map_of_comp_eq j_PF_Pk ψ_M hj_PF_Pk_M⟩
      map_one' := Subtype.ext (map_one ψ_M)
      map_mul' := fun x y => Subtype.ext (map_mul ψ_M x.1 y.1)
      map_zero' := Subtype.ext (map_zero ψ_M)
      map_add' := fun x y => Subtype.ext (map_add ψ_M x.1 y.1) }
  have hι_C_aff_inj : Function.Injective ι_C_aff := fun x y hxy =>
    Subtype.ext (hψ_inj (congrArg Subtype.val hxy))
  have hι_C_aff_comm_F : ι_C_aff.comp (algebraMap F C_0_F) =
      (algebraMap k C_0_M).comp (algebraMap F k) := by
    ext c
    exact hψ_F c
  have hι_C_aff_adjoin : Algebra.adjoin k (Set.range ι_C_aff) = ⊤ := by
    let R_sub_aff : Subalgebra k_r L_r := (IsScalarTower.toAlgHom k_r (Polynomial k_r) L_r).range
    have hRsub_aff_int : ∀ v ∈ R_sub_aff, v ∈ integralClosure (Polynomial F) L_r := by
      rintro _ ⟨P, rfl⟩
      change algebraMap (Polynomial k_r) L_r P ∈ integralClosure (Polynomial F) L_r
      induction P using Polynomial.induction_on' with
      | add p q hp hq =>
        rw [map_add]
        exact Subalgebra.add_mem _ hp hq
      | monomial n c =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        have hC : algebraMap (Polynomial k_r) L_r (Polynomial.C c) = algebraMap k_r L_r c :=
          (IsScalarTower.algebraMap_apply k_r (Polynomial k_r) L_r c).symm
        have hX : algebraMap (Polynomial k_r) L_r Polynomial.X =
            algebraMap (Polynomial F) L_r Polynomial.X := by
          rw [IsScalarTower.algebraMap_apply (Polynomial k_r) (RatFunc k_r) L_r,
            IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
            RatFunc.algebraMap_X, RatFunc.algebraMap_X, hX_kr]
        rw [hC, hX]
        exact Subalgebra.mul_mem _
          (IsIntegral.tower_top (R := F) (A := Polynomial F) (hkr_int c))
          (Subalgebra.pow_mem _ isIntegral_algebraMap n)
    have hIntCl_aff_sub : (integralClosure ↥R_sub_aff L_r : Set L_r) ⊆
        (integralClosure (Polynomial F) L_r : Set L_r) := by
      intro y hy
      let inc_R_C : ↥R_sub_aff →+* ↥(integralClosure (Polynomial F) L_r) :=
        { toFun := fun v => ⟨v.1, hRsub_aff_int v.1 v.2⟩
          map_one' := Subtype.ext rfl
          map_mul' := fun _ _ => Subtype.ext rfl
          map_zero' := Subtype.ext rfl
          map_add' := fun _ _ => Subtype.ext rfl }
      have hy_C : IsIntegral ↥(integralClosure (Polynomial F) L_r) y :=
        hy.map_of_comp_eq inc_R_C (RingHom.id L_r) (RingHom.ext fun _ => rfl)
      exact isIntegral_trans (R := Polynomial F) y hy_C
    let A_M_aff : Subalgebra k M_r := Algebra.adjoin k (ψ_M '' (R_sub_aff : Set L_r))
    have hPk_mem_AM : ∀ Q : Polynomial k, algebraMap (Polynomial k) M_r Q ∈ A_M_aff := by
      intro Q
      induction Q using Polynomial.induction_on' with
      | add p q hp hq =>
        rw [map_add]
        exact A_M_aff.add_mem hp hq
      | monomial n c =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        have hCk : algebraMap (Polynomial k) M_r (Polynomial.C c) = algebraMap k M_r c :=
          (IsScalarTower.algebraMap_apply k (Polynomial k) M_r c).symm
        have hXk : algebraMap (Polynomial k) M_r Polynomial.X ∈ A_M_aff := by
          rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M_r,
            RatFunc.algebraMap_X, ← hψ_X, ← RatFunc.algebraMap_X,
            ← IsScalarTower.algebraMap_apply (Polynomial k_r) (RatFunc k_r) L_r]
          exact Algebra.subset_adjoin ⟨_, ⟨Polynomial.X, rfl⟩, rfl⟩
        rw [hCk]
        exact A_M_aff.mul_mem (A_M_aff.algebraMap_mem c) (A_M_aff.pow_mem hXk n)
    rw [eq_top_iff]
    intro z _
    have hz_AM : (z : M_r) ∈ integralClosure ↥A_M_aff M_r := by
      let φ_Pk_AM : Polynomial k →+* ↥A_M_aff :=
        { toFun := fun Q => ⟨algebraMap (Polynomial k) M_r Q, hPk_mem_AM Q⟩
          map_one' := Subtype.ext (map_one _)
          map_mul' := fun a b => Subtype.ext (map_mul _ a b)
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun a b => Subtype.ext (map_add _ a b) }
      exact z.2.map_of_comp_eq φ_Pk_AM (RingHom.id M_r) (RingHom.ext fun _ => rfl)
    have hz_cl : (z : M_r) ∈
        Algebra.adjoin k (ψ_M '' (integralClosure (Polynomial F) L_r : Set L_r)) :=
      (Algebra.adjoin_mono (Set.image_mono hIntCl_aff_sub)) (hIntCl R_sub_aff hz_AM)
    have hImg_eq : ψ_M '' (integralClosure (Polynomial F) L_r : Set L_r) =
        Subtype.val '' (Set.range ι_C_aff) := by
      ext w
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact ⟨ι_C_aff ⟨y, hy⟩, ⟨⟨y, hy⟩, rfl⟩, rfl⟩
      · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
        exact ⟨y.1, y.2, rfl⟩
    rw [hImg_eq] at hz_cl
    have hle_CM : Algebra.adjoin k (Subtype.val '' (Set.range ι_C_aff)) ≤
        (integralClosure (Polynomial k) M_r).restrictScalars k := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨u, _, rfl⟩
      exact u.2
    have hz_pull : ∀ w : M_r, w ∈ Algebra.adjoin k (Subtype.val '' (Set.range ι_C_aff)) →
        ∀ hwm : w ∈ integralClosure (Polynomial k) M_r,
          (⟨w, hwm⟩ : C_0_M) ∈ Algebra.adjoin k (Set.range ι_C_aff) := by
      intro w hw
      induction hw using Algebra.adjoin_induction with
      | mem x hx =>
        rintro _
        rcases hx with ⟨u, hu, rfl⟩
        exact Algebra.subset_adjoin hu
      | algebraMap c =>
        intro _
        exact Subalgebra.algebraMap_mem _ c
      | add x y hx hy ihx ihy =>
        intro _
        exact Subalgebra.add_mem _ (ihx (hle_CM hx)) (ihy (hle_CM hy))
      | mul x y hx hy ihx ihy =>
        intro _
        exact Subalgebra.mul_mem _ (ihx (hle_CM hx)) (ihy (hle_CM hy))
    exact hz_pull z.1 hz_cl z.2

  obtain ⟨Q_a_k, hQ_a_k_prime, hQ_a_k_under, hInert_a⟩ :=
    s5_sig F k C_0_F C_0_M L_r M_r
      (integralClosure (Polynomial F) L_r).val.toRingHom Subtype.val_injective
      (integralClosure (Polynomial k) M_r).val.toRingHom Subtype.val_injective
      ψ_M ι_C_aff hι_C_aff_inj (RingHom.ext fun _ => rfl) hι_C_aff_comm_F
      hι_C_aff_adjoin Q_a hQ_a_prime

  have hQ_a_k_comap :
      Ideal.comap (algebraMap (Polynomial k) C_0_M) Q_a_k =
        Ideal.span {Polynomial.X - Polynomial.C a_k} := by
    let p_a_k : Ideal (Polynomial k) := Ideal.comap (algebraMap (Polynomial k) C_0_M) Q_a_k
    have hp_prime : p_a_k.IsPrime := hQ_a_k_prime.comap _
    have hlin_mem : Polynomial.X - Polynomial.C a_k ∈ p_a_k := by
      have hlin_F : Polynomial.X - Polynomial.C a ∈
          Ideal.comap (algebraMap (Polynomial F) C_0_F) Q_a := by
        rw [hQ_a_comap]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [← hQ_a_k_under, Ideal.mem_comap, Ideal.mem_comap] at hlin_F
      have heq : algebraMap (Polynomial k) C_0_M (Polynomial.X - Polynomial.C a_k) =
          ι_C_aff (algebraMap (Polynomial F) C_0_F (Polynomial.X - Polynomial.C a)) := by
        apply Subtype.ext
        have hmap : j_PF_Pk (Polynomial.X - Polynomial.C a) = Polynomial.X - Polynomial.C a_k := by
          simp only [j_PF_Pk, Polynomial.coe_mapRingHom, Polynomial.map_sub, Polynomial.map_X,
            Polynomial.map_C, ha_k]
        rw [← hmap]
        exact RingHom.congr_fun hj_PF_Pk_M _
      rw [Ideal.mem_comap, heq]
      exact hlin_F
    apply le_antisymm
    · intro P hP
      have hroot : Polynomial.IsRoot (P - Polynomial.C (P.eval a_k)) a_k := by
        rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, sub_self]
      obtain ⟨S, hS⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
      have hC_mem : Polynomial.C (P.eval a_k) ∈ p_a_k := by
        have h1 : Polynomial.C (P.eval a_k) = P - (Polynomial.X - Polynomial.C a_k) * S := by
          rw [← hS, sub_sub_cancel]
        rw [h1]
        exact p_a_k.sub_mem hP (p_a_k.mul_mem_right _ hlin_mem)
      have heval0 : P.eval a_k = 0 := by
        by_contra hne
        have hu : IsUnit (Polynomial.C (P.eval a_k)) :=
          (IsUnit.mk0 _ hne).map Polynomial.C
        exact hp_prime.ne_top (Ideal.eq_top_of_isUnit_mem p_a_k hC_mem hu)
      rw [heval0, Polynomial.C_0, sub_zero] at hS
      rw [hS]
      exact Ideal.mem_span_singleton.mpr ⟨S, rfl⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hlin_mem

  refine ⟨B_k, M_r, hCR_Bk, hDom_Bk, hFld_Mr, hAk_Bk, hAP_Bk, hAR_Bk,
    hAk_Mr, hAP_Mr, hARF_Mr, hABM, hARM,
    hST_k_P_Bk, hST_P_R_Bk, hST_k_RF_M, hST_P_RF_M, hST_P_Bk_M, hST_R_Bk_M,
    hFin_Bk, hEt_Bk, hFrac_Bk, hIntCl_Bk, hFD_Mr, hGal_Mr,
    j_Bk, A_inf_k, inferInstance, inferInstance, inferInstance, inferInstance,
    t_inf_k, Q_inf_k, Q_a_k,
    hj_Bk_inj, hj_Bk_comp, hj_Bk_adjoin,
    hA_inf_k_inj, ht_inf_k_eq, hA_inf_k_top,
    hQ_inf_k_prime, hQ_inf_k_comap, hQ_a_k_prime, hQ_a_k_comap, ?_⟩
  rintro ⟨τ_M, hτ_M⟩
  let Θ : (M_r ≃ₐ[RatFunc k] M_r) →* (B_r ≃ₐ[R₀] B_r) := Ψ_B.comp res_M.toMonoidHom
  let τ_B : B_r ≃ₐ[R₀] B_r := Θ τ_M
  have hτ_B_geom : ∀ x : B_r, IsIntegral F x → τ_B x = x :=
    (hΨB_range τ_B).mp ⟨res_M τ_M, rfl⟩
  have hτ_B_inv_geom : ∀ x : B_r, IsIntegral F x → τ_B⁻¹ x = x := by
    have hinv : τ_B⁻¹ = Θ τ_M⁻¹ := (map_inv Θ τ_M).symm
    rw [hinv]
    exact (hΨB_range (Θ τ_M⁻¹)).mp ⟨res_M τ_M⁻¹, rfl⟩

  have hσK_pres_Cinf : ∀ (σ_K : L_r ≃ₐ[RatFunc k_r] L_r) (y : C_inf_F),
      σ_K y.1 ∈ Set.range (Subtype.val : C_inf_F → L_r) := by
    intro σ_K y
    have hFix_Ainf : ∀ r : A_inf_r, σ_K (algebraMap A_inf_r L_r r) = algebraMap A_inf_r L_r r := by
      intro r
      have hr_top : r ∈ (⊤ : Subalgebra F A_inf_r) := Algebra.mem_top
      rw [← hA_inf_r_top] at hr_top
      induction hr_top using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        rw [hu_L_eq]
        exact σ_K.commutes (RatFunc.X)⁻¹
      | algebraMap c =>
        rw [← IsScalarTower.algebraMap_apply F A_inf_r L_r,
          IsScalarTower.algebraMap_apply F k_r L_r,
          IsScalarTower.algebraMap_apply k_r (RatFunc k_r) L_r]
        exact σ_K.commutes _
      | add x y _ _ ihx ihy => rw [map_add, map_add, ihx, ihy]
      | mul x y _ _ ihx ihy => rw [map_mul, map_mul, ihx, ihy]
    refine ⟨⟨σ_K y.1, ?_⟩, rfl⟩
    exact y.2.map_of_comp_eq (RingHom.id A_inf_r) σ_K.toRingHom
      (RingHom.ext fun r => (hFix_Ainf r).symm)

  have hγM_pres_Cinf : ∀ (γ_M : M_r ≃ₐ[RatFunc k] M_r) (z : C_inf_M),
      γ_M z.1 ∈ Set.range (Subtype.val : C_inf_M → M_r) := by
    intro γ_M z
    have hFix_Ainfk : ∀ r : A_inf_k, γ_M (algebraMap A_inf_k M_r r) = algebraMap A_inf_k M_r r := by
      rintro ⟨w, hw⟩
      change γ_M w = w
      induction hw using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact γ_M.commutes (RatFunc.X)⁻¹
      | algebraMap c =>
        rw [IsScalarTower.algebraMap_apply k (RatFunc k) M_r]
        exact γ_M.commutes _
      | add x y _ _ ihx ihy => rw [map_add, ihx, ihy]
      | mul x y _ _ ihx ihy => rw [map_mul, ihx, ihy]
    refine ⟨⟨γ_M z.1, ?_⟩, rfl⟩
    exact z.2.map_of_comp_eq (RingHom.id A_inf_k) γ_M.toRingHom
      (RingHom.ext fun r => (hFix_Ainfk r).symm)

  have hσK_pres_C0 : ∀ (σ_K : L_r ≃ₐ[RatFunc k_r] L_r) (y : C_0_F),
      σ_K y.1 ∈ Set.range (Subtype.val : C_0_F → L_r) := by
    intro σ_K y
    have hFix_PF : σ_K.toRingHom.comp (algebraMap (Polynomial F) L_r) =
        algebraMap (Polynomial F) L_r := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply]
        have hCF : algebraMap (Polynomial F) L_r (Polynomial.C c) = algebraMap F L_r c :=
          (IsScalarTower.algebraMap_apply F (Polynomial F) L_r c).symm
        rw [hCF, IsScalarTower.algebraMap_apply F k_r L_r,
          IsScalarTower.algebraMap_apply k_r (RatFunc k_r) L_r]
        exact σ_K.commutes _
      · simp only [RingHom.comp_apply,
          IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
          RatFunc.algebraMap_X, ← hX_kr]
        exact σ_K.commutes RatFunc.X
    refine ⟨⟨σ_K y.1, ?_⟩, rfl⟩
    exact y.2.map_of_comp_eq (RingHom.id (Polynomial F)) σ_K.toRingHom hFix_PF.symm

  have hγM_pres_C0 : ∀ (γ_M : M_r ≃ₐ[RatFunc k] M_r) (z : C_0_M),
      γ_M z.1 ∈ Set.range (Subtype.val : C_0_M → M_r) := by
    intro γ_M z
    have hFix_Pk : γ_M.toRingHom.comp (algebraMap (Polynomial k) M_r) =
        algebraMap (Polynomial k) M_r := by
      refine RingHom.ext fun p => ?_
      simp only [RingHom.comp_apply, IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M_r]
      exact γ_M.commutes _
    refine ⟨⟨γ_M z.1, ?_⟩, rfl⟩
    exact z.2.map_of_comp_eq (RingHom.id (Polynomial k)) γ_M.toRingHom hFix_Pk.symm

  refine ⟨τ_B, hτ_B_geom, fun σ_B => ?_⟩
  by_cases hσ_geom : ∀ x : B_r, IsIntegral F x → σ_B x = x
  · obtain ⟨σ_K, hσK_eq⟩ := (hΨB_range σ_B).mpr hσ_geom
    let γ_M : M_r ≃ₐ[RatFunc k] M_r := res_M.symm σ_K
    have hres_γ : res_M γ_M = σ_K := res_M.apply_symm_apply σ_K
    let γ'_M : M_r ≃ₐ[RatFunc k] M_r := τ_M * γ_M * τ_M⁻¹
    let σ'_K : L_r ≃ₐ[RatFunc k_r] L_r := res_M γ'_M
    have hσ'K_eq : Ψ_B σ'_K = τ_B * σ_B * τ_B⁻¹ := by
      change Θ (τ_M * γ_M * τ_M⁻¹) = τ_B * σ_B * τ_B⁻¹
      rw [map_mul, map_mul, map_inv]
      change τ_B * Ψ_B (res_M γ_M) * τ_B⁻¹ = _
      rw [hres_γ, hσK_eq]

    have hLHS_iff :
        (∃ σ_L : L_r ≃ₐ[RatFunc F] L_r,
          (∀ x : L_r, IsIntegral F x → σ_L x = x) ∧
          (∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b)) ∧
          (∀ y : C_inf_F, σ_L y.1 - y.1 ∈ Subtype.val '' (Q_inf : Set C_inf_F))) ↔
        (∀ y : C_inf_F, σ_K y.1 - y.1 ∈ Subtype.val '' (Q_inf : Set C_inf_F)) := by
      constructor
      · rintro ⟨σ_L, hFix_L, hExt_L, hIn_L⟩ y
        obtain ⟨σ_K₁, hΨ1, hVal1⟩ := hΨB_lift σ_B σ_L hFix_L hExt_L
        have hK_eq : σ_K₁ = σ_K := hΨB_inj (hΨ1.trans hσK_eq.symm)
        rw [← hK_eq, hVal1 y.1]
        exact hIn_L y
      · intro hIn_K
        obtain ⟨σ_L, hσL_eq⟩ := (hΨB_act σ_K).1
        refine ⟨σ_L, fun x hx => (hσL_eq x).trans ((hΨB_act σ_K).2.1 x hx), fun b => ?_, fun y => ?_⟩
        · rw [hσL_eq, (hΨB_act σ_K).2.2 b, hσK_eq]
        · rw [hσL_eq]
          exact hIn_K y

    have hRHS_iff :
        (∃ σ'_L : L_r ≃ₐ[RatFunc F] L_r,
          (∀ x : L_r, IsIntegral F x → σ'_L x = x) ∧
          (∀ b : B_r, σ'_L (algebraMap B_r L_r b) =
            algebraMap B_r L_r ((τ_B * σ_B * τ_B⁻¹) b)) ∧
          (∀ y : C_0_F, σ'_L y.1 - y.1 ∈ Subtype.val '' (Q_a : Set C_0_F))) ↔
        (∀ y : C_0_F, σ'_K y.1 - y.1 ∈ Subtype.val '' (Q_a : Set C_0_F)) := by
      constructor
      · rintro ⟨σ'_L, hFix_L, hExt_L, hIn_L⟩ y
        obtain ⟨σ_K₁, hΨ1, hVal1⟩ := hΨB_lift (τ_B * σ_B * τ_B⁻¹) σ'_L hFix_L hExt_L
        have hK_eq : σ_K₁ = σ'_K := hΨB_inj (hΨ1.trans hσ'K_eq.symm)
        rw [← hK_eq, hVal1 y.1]
        exact hIn_L y
      · intro hIn_K
        obtain ⟨σ'_L, hσ'L_eq⟩ := (hΨB_act σ'_K).1
        refine ⟨σ'_L, fun x hx => (hσ'L_eq x).trans ((hΨB_act σ'_K).2.1 x hx), fun b => ?_, fun y => ?_⟩
        · rw [hσ'L_eq, (hΨB_act σ'_K).2.2 b, hσ'K_eq]
        · rw [hσ'L_eq]
          exact hIn_K y

    have hBridge_inf :
        (∀ z : C_inf_M, γ_M z.1 - z.1 ∈ Subtype.val '' (Q_inf_k : Set C_inf_M)) ↔
        (∀ y : C_inf_F, σ_K y.1 - y.1 ∈ Subtype.val '' (Q_inf : Set C_inf_F)) := by
      refine hInert_inf σ_K.toRingHom γ_M.toRingHom ?_ ?_ (hσK_pres_Cinf σ_K) (hγM_pres_Cinf γ_M)
      · intro y
        change γ_M (ψ_M y) = ψ_M (σ_K y)
        rw [← hres_γ]
        exact hres_M γ_M y
      · intro c
        change γ_M (algebraMap k M_r c) = algebraMap k M_r c
        rw [IsScalarTower.algebraMap_apply k (RatFunc k) M_r]
        exact γ_M.commutes _

    have hBridge_a :
        (∀ z : C_0_M, γ'_M z.1 - z.1 ∈ Subtype.val '' (Q_a_k : Set C_0_M)) ↔
        (∀ y : C_0_F, σ'_K y.1 - y.1 ∈ Subtype.val '' (Q_a : Set C_0_F)) := by
      refine hInert_a σ'_K.toRingHom γ'_M.toRingHom ?_ ?_ (hσK_pres_C0 σ'_K) (hγM_pres_C0 γ'_M)
      · intro y
        exact hres_M γ'_M y
      · intro c
        change γ'_M (algebraMap k M_r c) = algebraMap k M_r c
        rw [IsScalarTower.algebraMap_apply k (RatFunc k) M_r]
        exact γ'_M.commutes _

    rw [hLHS_iff, hRHS_iff, ← hBridge_inf, ← hBridge_a]
    exact hτ_M γ_M

  · have hInj_BL : Function.Injective (algebraMap B_r L_r) := IsFractionRing.injective B_r L_r
    constructor
    · rintro ⟨σ_L, hFix_L, hExt_L, _⟩
      exfalso
      apply hσ_geom
      intro x hx
      apply hInj_BL
      rw [← hExt_L x]
      exact hFix_L _ (IsIntegral.map (IsScalarTower.toAlgHom F B_r L_r) hx)
    · rintro ⟨σ'_L, hFix'_L, hExt'_L, _⟩
      exfalso
      apply hσ_geom
      intro x hx
      have hConj_fix : (τ_B * σ_B * τ_B⁻¹) x = x := by
        apply hInj_BL
        rw [← hExt'_L x]
        exact hFix'_L _ (IsIntegral.map (IsScalarTower.toAlgHom F B_r L_r) hx)
      have h1 : τ_B (σ_B (τ_B⁻¹ x)) = x := hConj_fix
      rw [hτ_B_inv_geom x hx] at h1
      have h2 : (τ_B⁻¹ * τ_B) (σ_B x) = τ_B⁻¹ x :=
        congrArg (fun b : B_r => τ_B⁻¹ b) h1
      rw [inv_mul_cancel, AlgEquiv.one_apply, hτ_B_inv_geom x hx] at h2
      exact h2

theorem weil_p2_rf_biv_prime_principal (k : Type u) [Field k] [IsAlgClosed k]
    (P_ideal : Ideal (MvPolynomial (Fin 2) k)) [P_ideal.IsPrime]
    (hP_ne_bot : P_ideal ≠ ⊥) :
    ((∃ j₀ : Fin 2, ∀ g : Polynomial k,
        Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g ∈ P_ideal → g = 0) →
      ∃ f₀ : MvPolynomial (Fin 2) k, Irreducible f₀ ∧ P_ideal = Ideal.span {f₀}) ∧
    ((∃ p₁ p₂ : Fin 2 → k,
        p₁ ≠ p₂ ∧
        P_ideal ≤ RingHom.ker (MvPolynomial.eval p₁) ∧
        P_ideal ≤ RingHom.ker (MvPolynomial.eval p₂)) →
      ∃ f₀ : MvPolynomial (Fin 2) k, Irreducible f₀ ∧ P_ideal = Ideal.span {f₀}) :=
by
  classical
  have hPart1 : (∃ j₀ : Fin 2, ∀ g : Polynomial k,
      Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g ∈ P_ideal → g = 0) →
      ∃ f₀ : MvPolynomial (Fin 2) k, Irreducible f₀ ∧ P_ideal = Ideal.span {f₀} := by
    rintro ⟨j₀, hj₀⟩
    let R := Polynomial k
    let e₀ : MvPolynomial (Fin 1) k ≃ₐ[k] R := MvPolynomial.uniqueAlgEquiv k (Fin 1)
    let Ψ : MvPolynomial (Fin 2) k ≃ₐ[k] Polynomial R :=
      ((MvPolynomial.renameEquiv k (Equiv.swap j₀ 1)).trans
        (MvPolynomial.finSuccEquiv k 1)).trans
        (Polynomial.mapAlgEquiv e₀)
    have hΨ_Xj₀ : Ψ (MvPolynomial.X j₀) = Polynomial.C Polynomial.X := by
      dsimp [Ψ, e₀]
      rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, Equiv.swap_apply_left]
      have h1 : (1 : Fin 2) = Fin.succ (0 : Fin 1) := rfl
      rw [h1, MvPolynomial.finSuccEquiv_X_succ, Polynomial.map_C]
      congr 1
      change (MvPolynomial.uniqueAlgEquiv k (Fin 1)) (MvPolynomial.X 0) = Polynomial.X
      rw [MvPolynomial.uniqueAlgEquiv_apply, MvPolynomial.eval₂_X]
    have hC_aeval : (Polynomial.aeval (Polynomial.C Polynomial.X : Polynomial R) :
        R →ₐ[k] Polynomial R) = Polynomial.CAlgHom := by
      apply Polynomial.algHom_ext
      rw [Polynomial.aeval_X, Polynomial.CAlgHom_apply]
    have hΨ_aeval : ∀ g : R,
        Ψ (Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g) = Polynomial.C g := by
      intro g
      have h1 : Polynomial.aeval (Ψ (MvPolynomial.X j₀)) g =
          Ψ (Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g) :=
        Polynomial.aeval_algHom_apply Ψ.toAlgHom
          (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g
      rw [← h1, hΨ_Xj₀]
      exact AlgHom.congr_fun hC_aeval g
    let Q : Ideal (Polynomial R) := Ideal.map Ψ.toRingEquiv P_ideal
    have hQ_prime : Q.IsPrime := Ideal.map_isPrime_of_equiv Ψ.toRingEquiv
    have hQ_ne : Q ≠ ⊥ := by
      intro hbot
      exact hP_ne_bot ((Ideal.map_eq_bot_iff_of_injective Ψ.toRingEquiv.injective).mp hbot)
    have hQ_disj : ∀ g : R, Polynomial.C g ∈ Q → g = 0 := by
      intro g hg
      rw [← hΨ_aeval g] at hg
      change Ψ.toRingEquiv (Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g) ∈
        Ideal.map Ψ.toRingEquiv P_ideal at hg
      exact hj₀ g (Ideal.apply_mem_of_equiv_iff.mp hg)
    obtain ⟨f₁, hf₁_mem, hf₁_prime⟩ := hQ_prime.exists_mem_prime_of_ne_bot hQ_ne
    have hf₁_irr : Irreducible f₁ := hf₁_prime.irreducible
    have hSpan_prime : (Ideal.span ({f₁} : Set (Polynomial R))).IsPrime :=
      (Ideal.span_singleton_prime hf₁_prime.ne_zero).mpr hf₁_prime
    have hSpan_le : Ideal.span ({f₁} : Set (Polynomial R)) ≤ Q :=
      (Ideal.span_singleton_le_iff_mem Q).mpr hf₁_mem
    let K := FractionRing R
    let _ : Algebra (Polynomial R) (Polynomial K) := Polynomial.algebra R K
    let M : Submonoid (Polynomial R) :=
      Submonoid.map Polynomial.C.toMonoidHom (nonZeroDivisors R)
    have _ : IsLocalization M (Polynomial K) :=
      Polynomial.isLocalization (nonZeroDivisors R) K
    have hDisj : Disjoint (M : Set (Polynomial R)) (Q : Set (Polynomial R)) := by
      rw [Set.disjoint_left]
      rintro _ ⟨g, hg_nz, rfl⟩ hg_Q
      exact (mem_nonZeroDivisors_iff_ne_zero.mp hg_nz) (hQ_disj g hg_Q)
    have hDisj_span : Disjoint (M : Set (Polynomial R))
        (Ideal.span ({f₁} : Set (Polynomial R)) : Set (Polynomial R)) :=
      hDisj.mono_right hSpan_le
    let J₁ : Ideal (Polynomial K) :=
      Ideal.map (algebraMap (Polynomial R) (Polynomial K))
        (Ideal.span ({f₁} : Set (Polynomial R)))
    let J : Ideal (Polynomial K) :=
      Ideal.map (algebraMap (Polynomial R) (Polynomial K)) Q
    have hJ₁_prime : J₁.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M (Polynomial K)
        (Ideal.span ({f₁} : Set (Polynomial R))) hSpan_prime hDisj_span
    have hJ_prime : J.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M (Polynomial K) Q hQ_prime hDisj
    have hf1_map_ne : algebraMap (Polynomial R) (Polynomial K) f₁ ≠ 0 := by
      rw [Polynomial.algebraMap_def R K, Polynomial.coe_mapRingHom]
      intro h0
      exact hf₁_prime.ne_zero (Polynomial.map_injective (algebraMap R K)
        (IsFractionRing.injective R K) (h0.trans (Polynomial.map_zero _).symm))
    have hJ₁_span : J₁ = Ideal.span {algebraMap (Polynomial R) (Polynomial K) f₁} := by
      dsimp [J₁]
      rw [Ideal.map_span, Set.image_singleton]
    have hf1_map_prime : Prime (algebraMap (Polynomial R) (Polynomial K) f₁) := by
      rw [← Ideal.span_singleton_prime hf1_map_ne, ← hJ₁_span]
      exact hJ₁_prime
    have hJ₁_max : J₁.IsMaximal := by
      rw [hJ₁_span]
      exact PrincipalIdealRing.isMaximal_of_irreducible hf1_map_prime.irreducible
    have hJ₁_eq_J : J₁ = J :=
      hJ₁_max.eq_of_le hJ_prime.ne_top (Ideal.map_mono hSpan_le)
    have hQ_eq : Q = Ideal.span ({f₁} : Set (Polynomial R)) := by
      calc Q
        _ = Ideal.comap (algebraMap (Polynomial R) (Polynomial K)) J :=
            (IsLocalization.comap_map_of_isPrime_disjoint M (Polynomial K) hQ_prime hDisj).symm
        _ = Ideal.comap (algebraMap (Polynomial R) (Polynomial K)) J₁ := by rw [hJ₁_eq_J]
        _ = Ideal.span ({f₁} : Set (Polynomial R)) :=
            IsLocalization.comap_map_of_isPrime_disjoint M (Polynomial K) hSpan_prime hDisj_span
    refine ⟨Ψ.symm f₁, (MulEquiv.irreducible_iff Ψ.symm.toMulEquiv).mpr hf₁_irr, ?_⟩
    ext x
    constructor
    · intro hx
      have hΨx : Ψ x ∈ Q := Ideal.mem_map_of_mem Ψ.toRingEquiv hx
      rw [hQ_eq, Ideal.mem_span_singleton] at hΨx
      rw [Ideal.mem_span_singleton]
      have hdvd : Ψ.symm f₁ ∣ Ψ.symm (Ψ x) := map_dvd Ψ.symm hΨx
      rwa [Ψ.symm_apply_apply] at hdvd
    · intro hx
      rw [Ideal.mem_span_singleton] at hx
      have hdvd : Ψ (Ψ.symm f₁) ∣ Ψ x := map_dvd Ψ hx
      rw [Ψ.apply_symm_apply] at hdvd
      have hΨx : Ψ.toRingEquiv x ∈ Ideal.map Ψ.toRingEquiv P_ideal := by
        change Ψ x ∈ Q
        rw [hQ_eq, Ideal.mem_span_singleton]
        exact hdvd
      exact Ideal.apply_mem_of_equiv_iff.mp hΨx
  refine ⟨hPart1, ?_⟩
  rintro ⟨p₁, p₂, hp_ne, hp₁, hp₂⟩
  obtain ⟨j₀, hj₀_ne⟩ := Function.ne_iff.mp hp_ne
  apply hPart1
  refine ⟨j₀, ?_⟩
  have hStrong : ∀ n : ℕ, ∀ g : Polynomial k, g.natDegree = n →
      Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g ∈ P_ideal → g = 0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro g hn hg_mem
      by_contra hg_ne
      rcases Nat.eq_zero_or_pos n with rfl | hn_pos
      · have hC : g = Polynomial.C (g.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hn
        have hc_ne : g.coeff 0 ≠ 0 := by
          intro hc0
          apply hg_ne
          rw [hC, hc0, map_zero]
        rw [hC, Polynomial.aeval_C, MvPolynomial.algebraMap_eq] at hg_mem
        have hev : MvPolynomial.eval p₁ (MvPolynomial.C (g.coeff 0)) = 0 := hp₁ hg_mem
        rw [MvPolynomial.eval_C] at hev
        exact hc_ne hev
      · have hdeg_ne : g.degree ≠ 0 := by
          rw [Polynomial.degree_eq_natDegree hg_ne, hn]
          exact Nat.cast_ne_zero.mpr hn_pos.ne'
        obtain ⟨r, hr⟩ := IsAlgClosed.exists_root g hdeg_ne
        obtain ⟨h, hh_eq⟩ := Polynomial.dvd_iff_isRoot.mpr hr
        have hXr_ne : (Polynomial.X - Polynomial.C r : Polynomial k) ≠ 0 :=
          (Polynomial.monic_X_sub_C r).ne_zero
        have hh_ne : h ≠ 0 := right_ne_zero_of_mul (hh_eq ▸ hg_ne)
        have hdeg_sum : n = 1 + h.natDegree := by
          rw [← hn, hh_eq, Polynomial.natDegree_mul hXr_ne hh_ne, Polynomial.natDegree_X_sub_C]
        have hlt : h.natDegree < n := by omega
        rw [hh_eq, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C,
          MvPolynomial.algebraMap_eq] at hg_mem
        rcases (inferInstance : P_ideal.IsPrime).mem_or_mem hg_mem with hlin | hh_mem
        · have hev1 : MvPolynomial.eval p₁ (MvPolynomial.X j₀ - MvPolynomial.C r) = 0 := hp₁ hlin
          have hev2 : MvPolynomial.eval p₂ (MvPolynomial.X j₀ - MvPolynomial.C r) = 0 := hp₂ hlin
          rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C] at hev1 hev2
          exact hj₀_ne ((sub_eq_zero.mp hev1).trans (sub_eq_zero.mp hev2).symm)
        · exact hh_ne (ih h.natDegree hlt h rfl hh_mem)
  exact fun g hg => hStrong g.natDegree g rfl hg

theorem weil_p2_rf_homog_chart_bijection (k : Type u) [Field k] :
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    (∀ f₀ : MvPolynomial (Fin 2) k,
      Irreducible f₀ →
      1 ≤ f₀.totalDegree ∧
      ∃ G_hom : MvPolynomial (Fin 3) k,
        G_hom.IsHomogeneous f₀.totalDegree ∧
        Irreducible G_hom ∧
        eval_c 0 G_hom = f₀ ∧
        MvPolynomial.X 0 ∉ Ideal.span {G_hom}) ∧
    (∀ (d : ℕ) (G_hom : MvPolynomial (Fin 3) k),
      1 ≤ d →
      G_hom.IsHomogeneous d →
      Irreducible G_hom →
      (∀ c : Fin 3,
        (MvPolynomial.X c ∣ G_hom →
          ∃ μ : k, μ ≠ 0 ∧
            G_hom = MvPolynomial.C μ * MvPolynomial.X c ∧
            eval_c c G_hom = MvPolynomial.C μ) ∧
        (¬ MvPolynomial.X c ∣ G_hom →
          Irreducible (eval_c c G_hom))) ∧
      (∀ (P₀ P₁ P₂ : Polynomial k) (c : Fin 3),
        ![P₀, P₁, P₂] c ≠ 0 →
        let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
          MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
        θ_c (eval_c c G_hom) *
            (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ d =
          algebraMap (Polynomial k) (RatFunc k)
            (MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] G_hom))) :=
by
  intro eval_c
  classical
  have hEvalX_same : ∀ c : Fin 3, eval_c c (MvPolynomial.X c) = 1 := by
    intro c
    rw [MvPolynomial.aeval_X, Fin.succAbove_cases_eq_insertNth, Fin.insertNth_apply_same]
  have hEvalX_succ : ∀ (c : Fin 3) (j : Fin 2),
      eval_c c (MvPolynomial.X (c.succAbove j)) = MvPolynomial.X j := by
    intro c j
    rw [MvPolynomial.aeval_X, Fin.succAbove_cases_eq_insertNth, Fin.insertNth_apply_succAbove]
  have hDeg0_of_isUnit : ∀ {σ : Type} {P : MvPolynomial σ k}, IsUnit P → P.totalDegree = 0 := by
    intro σ P hP
    exact (MvPolynomial.isUnit_iff_totalDegree_of_isReduced.mp hP).2
  have hIsUnit_of_deg0 : ∀ {σ : Type} {P : MvPolynomial σ k},
      P ≠ 0 → P.totalDegree = 0 → IsUnit P := by
    intro σ P hP_ne hP_deg
    have hP_eq : P = MvPolynomial.C (P.coeff 0) :=
      MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hP_deg
    have hc_ne : P.coeff 0 ≠ 0 := by
      intro hc0
      apply hP_ne
      rw [hP_eq, hc0, map_zero]
    rw [hP_eq]
    exact (MvPolynomial.C : k →+* MvPolynomial σ k).isUnit_map (isUnit_iff_ne_zero.mpr hc_ne)
  have hMulFactors : ∀ (d : ℕ) (A B : MvPolynomial (Fin 3) k),
      A ≠ 0 → B ≠ 0 → (A * B).IsHomogeneous d →
      ∃ a b : ℕ, a + b = d ∧ A.IsHomogeneous a ∧ B.IsHomogeneous b := by
    intro d A B hA_ne hB_ne hAB
    let comp : ℕ → MvPolynomial (Fin 3) k → MvPolynomial (Fin 3) k :=
      fun i P => MvPolynomial.homogeneousComponent i P
    let suppDeg : MvPolynomial (Fin 3) k → Finset ℕ :=
      fun P => (Finset.range (P.totalDegree + 1)).filter (fun i => comp i P ≠ 0)
    have hSumSupp : ∀ P : MvPolynomial (Fin 3) k, ∑ i ∈ suppDeg P, comp i P = P := by
      intro P
      dsimp [suppDeg, comp]
      rw [Finset.sum_filter_ne_zero]
      exact MvPolynomial.sum_homogeneousComponent P
    have hNonempty : ∀ {P : MvPolynomial (Fin 3) k}, P ≠ 0 → (suppDeg P).Nonempty := by
      intro P hP
      rw [Finset.nonempty_iff_ne_empty]
      intro hemp
      apply hP
      rw [← hSumSupp P, hemp, Finset.sum_empty]
    have hSA : (suppDeg A).Nonempty := hNonempty hA_ne
    have hSB : (suppDeg B).Nonempty := hNonempty hB_ne
    let a_min := (suppDeg A).min' hSA
    let a_max := (suppDeg A).max' hSA
    let b_min := (suppDeg B).min' hSB
    let b_max := (suppDeg B).max' hSB
    have ha_min_mem : a_min ∈ suppDeg A := Finset.min'_mem (suppDeg A) hSA
    have ha_max_mem : a_max ∈ suppDeg A := Finset.max'_mem (suppDeg A) hSA
    have hb_min_mem : b_min ∈ suppDeg B := Finset.min'_mem (suppDeg B) hSB
    have hb_max_mem : b_max ∈ suppDeg B := Finset.max'_mem (suppDeg B) hSB
    have hAmin_ne : comp a_min A ≠ 0 := (Finset.mem_filter.mp ha_min_mem).2
    have hAmax_ne : comp a_max A ≠ 0 := (Finset.mem_filter.mp ha_max_mem).2
    have hBmin_ne : comp b_min B ≠ 0 := (Finset.mem_filter.mp hb_min_mem).2
    have hBmax_ne : comp b_max B ≠ 0 := (Finset.mem_filter.mp hb_max_mem).2
    have hAB_sum : A * B = ∑ i ∈ suppDeg A, ∑ j ∈ suppDeg B, comp i A * comp j B := by
      calc
        A * B = (∑ i ∈ suppDeg A, comp i A) * (∑ j ∈ suppDeg B, comp j B) := by
          rw [hSumSupp A, hSumSupp B]
        _ = ∑ i ∈ suppDeg A, comp i A * (∑ j ∈ suppDeg B, comp j B) := Finset.sum_mul _ _ _
        _ = ∑ i ∈ suppDeg A, ∑ j ∈ suppDeg B, comp i A * comp j B := by
          refine Finset.sum_congr rfl fun i _ => Finset.mul_sum _ _ _
    have hCompAB : ∀ m : ℕ, comp m (A * B) =
        ∑ i ∈ suppDeg A, ∑ j ∈ suppDeg B,
          if m = i + j then comp i A * comp j B else 0 := by
      intro m
      rw [hAB_sum]
      dsimp [comp]
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hij : (MvPolynomial.homogeneousComponent i A *
          MvPolynomial.homogeneousComponent j B) ∈
          MvPolynomial.homogeneousSubmodule (Fin 3) k (i + j) :=
        (MvPolynomial.mem_homogeneousSubmodule (i + j) _).mpr
          ((MvPolynomial.homogeneousComponent_isHomogeneous i A).mul
            (MvPolynomial.homogeneousComponent_isHomogeneous j B))
      exact MvPolynomial.homogeneousComponent_of_mem hij
    have hAB_mem : A * B ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k d :=
      (MvPolynomial.mem_homogeneousSubmodule d (A * B)).mpr hAB
    have hMax_d : a_max + b_max = d := by
      have h1 : comp (a_max + b_max) (A * B) = comp a_max A * comp b_max B := by
        rw [hCompAB]
        refine (Finset.sum_eq_single a_max ?_ (fun h => False.elim (h ha_max_mem))).trans ?_
        · intro i hi hia
          refine Finset.sum_eq_zero fun j hj => ?_
          have hi_le : i ≤ a_max := Finset.le_max' (suppDeg A) i hi
          have hj_le : j ≤ b_max := Finset.le_max' (suppDeg B) j hj
          have hne : a_max + b_max ≠ i + j := by omega
          simp [hne]
        · refine (Finset.sum_eq_single b_max ?_ (fun h => False.elim (h hb_max_mem))).trans ?_
          · intro j hj hjb
            have hj_le : j ≤ b_max := Finset.le_max' (suppDeg B) j hj
            have hne : a_max + b_max ≠ a_max + j := by omega
            simp only [hne, ↓reduceIte]
          · simp
      have h2 : comp (a_max + b_max) (A * B) = if a_max + b_max = d then A * B else 0 :=
        MvPolynomial.homogeneousComponent_of_mem hAB_mem
      rw [h1] at h2
      by_contra hd_ne
      simp only [hd_ne, ↓reduceIte] at h2
      exact mul_ne_zero hAmax_ne hBmax_ne h2
    have hMin_d : a_min + b_min = d := by
      have h1 : comp (a_min + b_min) (A * B) = comp a_min A * comp b_min B := by
        rw [hCompAB]
        refine (Finset.sum_eq_single a_min ?_ (fun h => False.elim (h ha_min_mem))).trans ?_
        · intro i hi hia
          refine Finset.sum_eq_zero fun j hj => ?_
          have hi_ge : a_min ≤ i := Finset.min'_le (suppDeg A) i hi
          have hj_ge : b_min ≤ j := Finset.min'_le (suppDeg B) j hj
          have hne : a_min + b_min ≠ i + j := by omega
          simp [hne]
        · refine (Finset.sum_eq_single b_min ?_ (fun h => False.elim (h hb_min_mem))).trans ?_
          · intro j hj hjb
            have hj_ge : b_min ≤ j := Finset.min'_le (suppDeg B) j hj
            have hne : a_min + b_min ≠ a_min + j := by omega
            simp only [hne, ↓reduceIte]
          · simp
      have h2 : comp (a_min + b_min) (A * B) = if a_min + b_min = d then A * B else 0 :=
        MvPolynomial.homogeneousComponent_of_mem hAB_mem
      rw [h1] at h2
      by_contra hd_ne
      simp only [hd_ne, ↓reduceIte] at h2
      exact mul_ne_zero hAmin_ne hBmin_ne h2
    have ha_le : a_min ≤ a_max := Finset.min'_le (suppDeg A) a_max ha_max_mem
    have hb_le : b_min ≤ b_max := Finset.min'_le (suppDeg B) b_max hb_max_mem
    have ha_eq : a_min = a_max := by omega
    have hb_eq : b_min = b_max := by omega
    have hA_eq : A = comp a_max A := by
      conv_lhs => rw [← hSumSupp A]
      refine Finset.sum_eq_single a_max (fun i hi hia => ?_) (fun h => False.elim (h ha_max_mem))
      have hi_min : a_min ≤ i := Finset.min'_le (suppDeg A) i hi
      have hi_max : i ≤ a_max := Finset.le_max' (suppDeg A) i hi
      omega
    have hB_eq : B = comp b_max B := by
      conv_lhs => rw [← hSumSupp B]
      refine Finset.sum_eq_single b_max (fun j hj hjb => ?_) (fun h => False.elim (h hb_max_mem))
      have hj_min : b_min ≤ j := Finset.min'_le (suppDeg B) j hj
      have hj_max : j ≤ b_max := Finset.le_max' (suppDeg B) j hj
      omega
    refine ⟨a_max, b_max, hMax_d, ?_, ?_⟩
    · rw [hA_eq]; exact MvPolynomial.homogeneousComponent_isHomogeneous a_max A
    · rw [hB_eq]; exact MvPolynomial.homogeneousComponent_isHomogeneous b_max B
  have hChartRoundtrip : ∀ (c : Fin 3) (d : ℕ),
      (∀ f : MvPolynomial (Fin 2) k,
        f.totalDegree ≤ d →
        ∃ H : MvPolynomial (Fin 3) k, H.IsHomogeneous d ∧ eval_c c H = f) ∧
      (∀ G : MvPolynomial (Fin 3) k,
        G.IsHomogeneous d →
        (eval_c c G).totalDegree ≤ d ∧
        (∀ G' : MvPolynomial (Fin 3) k,
          G'.IsHomogeneous d → eval_c c G = eval_c c G' → G = G') ∧
        (¬ MvPolynomial.X c ∣ G → (eval_c c G).totalDegree = d)) := by
    intro c d
    let π_c : (Fin 3 →₀ ℕ) → (Fin 2 →₀ ℕ) :=
      fun μ => Finsupp.equivFunOnFinite.symm (fun j : Fin 2 => μ (c.succAbove j))
    let ι_cd : (Fin 2 →₀ ℕ) → (Fin 3 →₀ ℕ) :=
      fun m => Finsupp.equivFunOnFinite.symm (c.insertNth (d - (m 0 + m 1)) (fun j : Fin 2 => m j))
    have hπ_apply : ∀ (μ : Fin 3 →₀ ℕ) (j : Fin 2), π_c μ j = μ (c.succAbove j) := by
      intro μ j
      simp [π_c]
    have hι_same : ∀ m : Fin 2 →₀ ℕ, ι_cd m c = d - (m 0 + m 1) := by
      intro m
      simp [ι_cd]
    have hι_succ : ∀ (m : Fin 2 →₀ ℕ) (j : Fin 2), ι_cd m (c.succAbove j) = m j := by
      intro m j
      simp [ι_cd]
    have hDeg2 : ∀ m : Fin 2 →₀ ℕ, (m.sum fun _ e => e) = m 0 + m 1 := by
      intro m
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
    have hDeg3 : ∀ μ : Fin 3 →₀ ℕ, Finsupp.degree μ = μ c + (π_c μ 0 + π_c μ 1) := by
      intro μ
      rw [Finsupp.degree_eq_sum, Fin.sum_univ_succAbove _ c, Fin.sum_univ_two,
        hπ_apply, hπ_apply]
    have hπ_ι : ∀ m : Fin 2 →₀ ℕ, π_c (ι_cd m) = m := by
      intro m
      ext j
      rw [hπ_apply, hι_succ]
    have hDeg_ι : ∀ m : Fin 2 →₀ ℕ, m 0 + m 1 ≤ d → Finsupp.degree (ι_cd m) = d := by
      intro m hm
      rw [hDeg3, hπ_ι, hι_same]
      omega
    have hι_π : ∀ μ : Fin 3 →₀ ℕ, Finsupp.degree μ = d →
        π_c μ 0 + π_c μ 1 ≤ d ∧ ι_cd (π_c μ) = μ := by
      intro μ hμ
      have hsum := hDeg3 μ
      have hle : π_c μ 0 + π_c μ 1 ≤ d := by omega
      refine ⟨hle, ?_⟩
      ext i
      rcases Fin.eq_self_or_eq_succAbove c i with rfl | ⟨j, rfl⟩
      · rw [hι_same]; omega
      · rw [hι_succ, hπ_apply]
    have hEvalMon : ∀ (μ : Fin 3 →₀ ℕ) (a : k),
        eval_c c (MvPolynomial.monomial μ a) = MvPolynomial.monomial (π_c μ) a := by
      intro μ a
      rw [MvPolynomial.aeval_monomial, MvPolynomial.algebraMap_eq, MvPolynomial.monomial_eq]
      congr 1
      rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_succAbove _ c, Fin.succAbove_cases_eq_insertNth,
        Fin.insertNth_apply_same, one_pow, one_mul]
      refine Finset.prod_congr rfl fun j _ => ?_
      rw [Fin.insertNth_apply_succAbove, hπ_apply]
    have hCoeffEval : ∀ (G : MvPolynomial (Fin 3) k), G.IsHomogeneous d →
        ∀ m : Fin 2 →₀ ℕ,
          (eval_c c G).coeff m =
            if m 0 + m 1 ≤ d then G.coeff (ι_cd m) else 0 := by
      intro G hG m
      conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff G]
      rw [map_sum, MvPolynomial.coeff_sum]
      simp only [hEvalMon, MvPolynomial.coeff_monomial]
      have hSuppDeg : ∀ μ ∈ G.support, Finsupp.degree μ = d := by
        intro μ hμ
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hμ) (hG.coeff_eq_zero hne)
      split_ifs with hm
      · have hcongr : ∑ μ ∈ G.support, (if π_c μ = m then G.coeff μ else 0) =
            ∑ μ ∈ G.support, (if μ = ι_cd m then G.coeff μ else 0) := by
          refine Finset.sum_congr rfl fun μ hμ => ?_
          have hiff : π_c μ = m ↔ μ = ι_cd m := by
            constructor
            · intro hπm
              rw [← hπm]
              exact ((hι_π μ (hSuppDeg μ hμ)).2).symm
            · intro hμm
              rw [hμm, hπ_ι]
          simp only [hiff]
        rw [hcongr]
        simp only [Finset.sum_ite_eq']
        split_ifs with hmem
        · rfl
        · symm
          rwa [MvPolynomial.mem_support_iff, not_not] at hmem
      · refine Finset.sum_eq_zero fun μ hμ => ?_
        have hle : π_c μ 0 + π_c μ 1 ≤ d := (hι_π μ (hSuppDeg μ hμ)).1
        have hne : π_c μ ≠ m := by
          intro heq
          rw [heq] at hle
          exact hm hle
        simp [hne]
    refine ⟨?_, ?_⟩
    · intro f hf_deg
      let H : MvPolynomial (Fin 3) k :=
        ∑ m ∈ f.support, MvPolynomial.monomial (ι_cd m) (f.coeff m)
      have hH_hom : H.IsHomogeneous d := by
        rw [← MvPolynomial.mem_homogeneousSubmodule]
        refine Submodule.sum_mem _ fun m hm => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have hm_le : m 0 + m 1 ≤ d := by
          rw [← hDeg2 m]
          exact (MvPolynomial.le_totalDegree hm).trans hf_deg
        exact MvPolynomial.isHomogeneous_monomial _ (hDeg_ι m hm_le)
      have hH_eval : eval_c c H = f := by
        dsimp [H]
        rw [map_sum]
        simp only [hEvalMon, hπ_ι]
        exact MvPolynomial.support_sum_monomial_coeff f
      exact ⟨H, hH_hom, hH_eval⟩
    · intro G hG
      have hDegLe : (eval_c c G).totalDegree ≤ d := by
        rw [MvPolynomial.totalDegree]
        refine Finset.sup_le fun m hm => ?_
        rw [hDeg2 m]
        by_contra hgt
        have hc0 : (eval_c c G).coeff m = 0 := by
          rw [hCoeffEval G hG m]
          simp [hgt]
        exact (MvPolynomial.mem_support_iff.mp hm) hc0
      refine ⟨hDegLe, ?_, ?_⟩
      · intro G' hG' heval_eq
        ext μ
        by_cases hμ : Finsupp.degree μ = d
        · obtain ⟨hle, hιeq⟩ := hι_π μ hμ
          have hc1 := hCoeffEval G hG (π_c μ)
          have hc2 := hCoeffEval G' hG' (π_c μ)
          simp only [hle, ↓reduceIte, hιeq] at hc1 hc2
          rw [← hc1, ← hc2, heval_eq]
        · rw [hG.coeff_eq_zero hμ, hG'.coeff_eq_zero hμ]
      · intro hndvd
        have hex_μ₀ : ∃ μ₀ ∈ G.support, μ₀ c = 0 := by
          by_contra hall
          apply hndvd
          rw [← MvPolynomial.support_sum_monomial_coeff G]
          refine Finset.dvd_sum fun μ hμ => ?_
          exact MvPolynomial.X_dvd_monomial.mpr (Or.inr fun hc0 => hall ⟨μ, hμ, hc0⟩)
        obtain ⟨μ₀, hμ₀_mem, hμ₀_c⟩ := hex_μ₀
        have hμ₀_deg : Finsupp.degree μ₀ = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hμ₀_mem) (hG.coeff_eq_zero hne)
        obtain ⟨hle₀, hι₀⟩ := hι_π μ₀ hμ₀_deg
        have hm₀_sum : π_c μ₀ 0 + π_c μ₀ 1 = d := by
          have hs := hDeg3 μ₀
          omega
        have hm₀_mem : π_c μ₀ ∈ (eval_c c G).support := by
          rw [MvPolynomial.mem_support_iff, hCoeffEval G hG (π_c μ₀)]
          simp only [hle₀, ↓reduceIte, hι₀]
          exact MvPolynomial.mem_support_iff.mp hμ₀_mem
        have hDegGe : d ≤ (eval_c c G).totalDegree := by
          rw [← hm₀_sum, ← hDeg2 (π_c μ₀)]
          exact MvPolynomial.le_totalDegree hm₀_mem
        exact le_antisymm hDegLe hDegGe
  refine ⟨?_, ?_⟩
  · intro f₀ hf₀
    let d := f₀.totalDegree
    have hd_pos : 1 ≤ d := by
      by_contra hlt
      have hd0 : d = 0 := by omega
      exact hf₀.not_isUnit (hIsUnit_of_deg0 hf₀.ne_zero hd0)
    obtain ⟨G_hom, hG_hom, heval0⟩ := (hChartRoundtrip 0 d).1 f₀ le_rfl
    have hG_ne : G_hom ≠ 0 := by
      intro h0
      rw [h0, map_zero] at heval0
      exact hf₀.ne_zero heval0.symm
    have hX0_not : MvPolynomial.X 0 ∉ Ideal.span {G_hom} := by
      intro hmem
      obtain ⟨Q, hQ⟩ := Ideal.mem_span_singleton.mp hmem
      have h1 : eval_c 0 (MvPolynomial.X 0) = eval_c 0 (G_hom * Q) := congrArg (eval_c 0) hQ
      rw [hEvalX_same 0, map_mul, heval0] at h1
      have hu : IsUnit f₀ :=
        ⟨⟨f₀, eval_c 0 Q, h1.symm, by rw [mul_comm, h1.symm]⟩, rfl⟩
      exact hf₀.not_isUnit hu
    have hG_irr : Irreducible G_hom := by
      refine ⟨?_, ?_⟩
      · intro hG_unit
        have hf₀_unit : IsUnit f₀ := heval0 ▸ (eval_c 0).toRingHom.isUnit_map hG_unit
        exact hf₀.not_isUnit hf₀_unit
      · intro A B hAB
        have hA_ne : A ≠ 0 := by
          intro h0; rw [h0, zero_mul] at hAB; exact hG_ne hAB
        have hB_ne : B ≠ 0 := by
          intro h0; rw [h0, mul_zero] at hAB; exact hG_ne hAB
        obtain ⟨a, b, hab, hA_hom, hB_hom⟩ := hMulFactors d A B hA_ne hB_ne (hAB ▸ hG_hom)
        have hf₀_mul : f₀ = eval_c 0 A * eval_c 0 B := by
          rw [← heval0, hAB, map_mul]
        rcases hf₀.isUnit_or_isUnit hf₀_mul with huA | huB
        · left
          have hdegA0 : (eval_c 0 A).totalDegree = 0 := hDeg0_of_isUnit huA
          have hdegBle : (eval_c 0 B).totalDegree ≤ b := ((hChartRoundtrip 0 b).2 B hB_hom).1
          have hdeg_le : d ≤ (eval_c 0 A).totalDegree + (eval_c 0 B).totalDegree := by
            change f₀.totalDegree ≤ _
            rw [hf₀_mul]
            exact MvPolynomial.totalDegree_mul _ _
          have ha0 : a = 0 := by omega
          subst ha0
          exact hIsUnit_of_deg0 hA_ne (hA_hom.totalDegree hA_ne)
        · right
          have hdegB0 : (eval_c 0 B).totalDegree = 0 := hDeg0_of_isUnit huB
          have hdegAle : (eval_c 0 A).totalDegree ≤ a := ((hChartRoundtrip 0 a).2 A hA_hom).1
          have hdeg_le : d ≤ (eval_c 0 A).totalDegree + (eval_c 0 B).totalDegree := by
            change f₀.totalDegree ≤ _
            rw [hf₀_mul]
            exact MvPolynomial.totalDegree_mul _ _
          have hb0 : b = 0 := by omega
          subst hb0
          exact hIsUnit_of_deg0 hB_ne (hB_hom.totalDegree hB_ne)
    exact ⟨hd_pos, G_hom, hG_hom, hG_irr, heval0, hX0_not⟩
  · intro d G_hom hd_pos hG_hom hG_irr
    refine ⟨?_, ?_⟩
    · intro c
      refine ⟨?_, ?_⟩
      · intro hdvd
        obtain ⟨K, hGK⟩ := hdvd
        have hXc_not_unit : ¬ IsUnit (MvPolynomial.X c : MvPolynomial (Fin 3) k) := by
          intro hu
          have hu0 : IsUnit (MvPolynomial.eval (0 : Fin 3 → k) (MvPolynomial.X c)) :=
            (MvPolynomial.eval (0 : Fin 3 → k)).isUnit_map hu
          rw [MvPolynomial.eval_X] at hu0
          exact not_isUnit_zero hu0
        have hK_unit : IsUnit K := (hG_irr.isUnit_or_isUnit hGK).resolve_left hXc_not_unit
        have hK_deg0 : K.totalDegree = 0 := hDeg0_of_isUnit hK_unit
        let μ : k := K.coeff 0
        have hK_eq : K = MvPolynomial.C μ := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hK_deg0
        have hμ_ne : μ ≠ 0 := by
          intro h0
          apply hK_unit.ne_zero
          rw [hK_eq, h0, map_zero]
        have hG_eq : G_hom = MvPolynomial.C μ * MvPolynomial.X c := by
          rw [hGK, hK_eq, mul_comm]
        have heval_eq : eval_c c G_hom = MvPolynomial.C μ := by
          rw [hG_eq, map_mul, hEvalX_same c, mul_one, MvPolynomial.aeval_C,
            MvPolynomial.algebraMap_eq]
        exact ⟨μ, hμ_ne, hG_eq, heval_eq⟩
      · intro hndvd
        let f := eval_c c G_hom
        have hf_deg : f.totalDegree = d := ((hChartRoundtrip c d).2 G_hom hG_hom).2.2 hndvd
        have hf_not_unit : ¬ IsUnit f := by
          intro hu
          have h0 := hDeg0_of_isUnit hu
          omega
        have hf_ne : f ≠ 0 := by
          intro h0
          have hd0 : f.totalDegree = 0 := by rw [h0, MvPolynomial.totalDegree_zero]
          omega
        refine ⟨hf_not_unit, ?_⟩
        intro f₁ f₂ hf_mul
        have hf₁_ne : f₁ ≠ 0 := by
          intro h0; rw [h0, zero_mul] at hf_mul; exact hf_ne hf_mul
        have hf₂_ne : f₂ ≠ 0 := by
          intro h0; rw [h0, mul_zero] at hf_mul; exact hf_ne hf_mul
        have hd_sum : f₁.totalDegree + f₂.totalDegree = d := by
          rw [← MvPolynomial.totalDegree_mul_of_isDomain hf₁_ne hf₂_ne, ← hf_mul, hf_deg]
        obtain ⟨H₁, hH₁_hom, he₁⟩ := (hChartRoundtrip c f₁.totalDegree).1 f₁ le_rfl
        obtain ⟨H₂, hH₂_hom, he₂⟩ := (hChartRoundtrip c f₂.totalDegree).1 f₂ le_rfl
        have hH12_hom : (H₁ * H₂).IsHomogeneous d := hd_sum ▸ (hH₁_hom.mul hH₂_hom)
        have hH12_eval : eval_c c G_hom = eval_c c (H₁ * H₂) := by
          rw [map_mul, he₁, he₂]
          exact hf_mul
        have hG_mul : G_hom = H₁ * H₂ :=
          ((hChartRoundtrip c d).2 G_hom hG_hom).2.1 (H₁ * H₂) hH12_hom hH12_eval
        rcases hG_irr.isUnit_or_isUnit hG_mul with hu1 | hu2
        · left
          exact he₁ ▸ (eval_c c).toRingHom.isUnit_map hu1
        · right
          exact he₂ ▸ (eval_c c).toRingHom.isUnit_map hu2
    · intro P₀ P₁ P₂ c hPc θ_c
      let v : Fin 3 → RatFunc k :=
        fun i => algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] i)
      have hv_c : v c ≠ 0 := RatFunc.algebraMap_ne_zero hPc
      let r : RatFunc k := (v c)⁻¹
      have hComp : θ_c.comp (eval_c c) = MvPolynomial.aeval (fun i : Fin 3 => r * v i) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply]
        rcases Fin.eq_self_or_eq_succAbove c i with h_eq | ⟨j, h_eq⟩
        · rw [h_eq, hEvalX_same c, map_one, MvPolynomial.aeval_X]
          exact (inv_mul_cancel₀ hv_c).symm
        · rw [h_eq, hEvalX_succ c j, MvPolynomial.aeval_X, MvPolynomial.aeval_X, div_eq_inv_mul]
      have hThetaEval : θ_c (eval_c c G_hom) = MvPolynomial.aeval (fun i => r * v i) G_hom :=
        AlgHom.congr_fun hComp G_hom
      have hScale : MvPolynomial.aeval (fun i => r * v i) G_hom =
          r ^ d * MvPolynomial.aeval v G_hom := by
        rw [MvPolynomial.aeval_def, MvPolynomial.aeval_def,
          MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl fun μ hμ => ?_
        have hdeg : (∑ i ∈ μ.support, μ i) = d := by
          rw [← Finsupp.degree_apply]
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hμ) (hG_hom.coeff_eq_zero hne)
        calc
          algebraMap k (RatFunc k) (G_hom.coeff μ) *
              ∏ i ∈ μ.support, (r * v i) ^ μ i
            = algebraMap k (RatFunc k) (G_hom.coeff μ) *
                ((∏ i ∈ μ.support, r ^ μ i) * ∏ i ∈ μ.support, v i ^ μ i) := by
                simp only [mul_pow, Finset.prod_mul_distrib]
          _ = algebraMap k (RatFunc k) (G_hom.coeff μ) *
                (r ^ (∑ i ∈ μ.support, μ i) * ∏ i ∈ μ.support, v i ^ μ i) := by
                rw [Finset.prod_pow_eq_pow_sum]
          _ = r ^ d * (algebraMap k (RatFunc k) (G_hom.coeff μ) *
                ∏ i ∈ μ.support, v i ^ μ i) := by
                rw [hdeg]
                ring
      have hHomEval : algebraMap (Polynomial k) (RatFunc k)
            (MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] G_hom) =
          MvPolynomial.aeval v G_hom := by
        rw [MvPolynomial.hom_eval₂, MvPolynomial.aeval_def]
        have hC : (algebraMap (Polynomial k) (RatFunc k)).comp Polynomial.C =
            algebraMap k (RatFunc k) := by
          ext a
          rw [RingHom.comp_apply, ← Polynomial.algebraMap_eq,
            ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
        rw [hC]
      rw [hThetaEval, hScale, hHomEval]
      change (r ^ d * MvPolynomial.aeval v G_hom) * (v c) ^ d = MvPolynomial.aeval v G_hom
      have hrvc : r * v c = 1 := inv_mul_cancel₀ hv_c
      calc
        (r ^ d * MvPolynomial.aeval v G_hom) * (v c) ^ d
          = (r * v c) ^ d * MvPolynomial.aeval v G_hom := by ring
        _ = 1 ^ d * MvPolynomial.aeval v G_hom := by rw [hrvc]
        _ = MvPolynomial.aeval v G_hom := by rw [one_pow, one_mul]

theorem weil_p2_rf_kernel_and_gauss_degree_eq (k : Type u) [Field k] [IsAlgClosed k]
    (P₀ P₁ P₂ : Polynomial k)
    (hP₀_monic : P₀.Monic)
    (hd_pos : 1 ≤ P₀.natDegree)
    (hP₁_deg : P₁.natDegree ≤ P₀.natDegree)
    (hP₂_deg : P₂.natDegree ≤ P₀.natDegree)
    (hCoprime : ∀ b : k, P₀.eval b = 0 → P₁.eval b ≠ 0 ∨ P₂.eval b ≠ 0) :
    let d_Sigma := P₀.natDegree
    let θ_c : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 =>
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
    ((Set.range (θ_c 0) =
        { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
            Q.natDegree ≤ n * d_Sigma ∧
            f = algebraMap (Polynomial k) (RatFunc k) Q /
              (algebraMap (Polynomial k) (RatFunc k) P₀) ^ n }) →
      (RingHom.ker (θ_c 0).toRingHom ≠ ⊥ ∧
        ∃ p₁ p₂ : Fin 2 → k,
          p₁ ≠ p₂ ∧
          RingHom.ker (θ_c 0).toRingHom ≤ RingHom.ker (MvPolynomial.eval p₁) ∧
          RingHom.ker (θ_c 0).toRingHom ≤ RingHom.ker (MvPolynomial.eval p₂)) ∧
      (∀ h₀ : MvPolynomial (Fin 2) k,
        Irreducible h₀ →
        RingHom.ker (θ_c 0).toRingHom = Ideal.span {h₀} →
        h₀.totalDegree = d_Sigma)) ∧
    (∀ (d : ℕ) (G_hom : MvPolynomial (Fin 3) k) (c : Fin 3),
      1 ≤ d →
      G_hom.IsHomogeneous d →
      MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] G_hom = 0 →
      ![P₀, P₁, P₂] c = 0 →
      MvPolynomial.X c ∣ G_hom) ∧
    (∀ c : Fin 3,
      ![P₀, P₁, P₂] c ≠ 0 →
      Set.range (θ_c c) =
        { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
            Q.natDegree ≤ n * d_Sigma ∧
            f = algebraMap (Polynomial k) (RatFunc k) Q /
              (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n } →
      ∃ j₀ : Fin 2, ∀ g : Polynomial k,
        Polynomial.aeval (MvPolynomial.X j₀ : MvPolynomial (Fin 2) k) g ∈
          RingHom.ker (θ_c c).toRingHom → g = 0) :=
by
  classical
  intro d_Sigma θ_c
  have hP₀_ne : P₀ ≠ 0 := hP₀_monic.ne_zero
  have hExistsRoot : ∀ p : Polynomial k, p ≠ 0 → p.natDegree ≠ 0 → ∃ r : k, p.eval r = 0 := by
    intro p hp_ne hdeg_ne
    have hp_deg : p.degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hp_ne]
      intro h0
      change (some p.natDegree : WithBot ℕ) = some 0 at h0
      injection h0 with h0'
      exact hdeg_ne h0'
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_root p hp_deg
    exact ⟨r, hr⟩
  have hCa_rf : ∀ a : k,
      algebraMap k (RatFunc k) a =
        algebraMap (Polynomial k) (RatFunc k) (Polynomial.C a) := by
    intro a
    rw [Polynomial.C_eq_algebraMap,
      ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
  have hAlgClosedConst : ∀ (n : ℕ) (p : Polynomial k) (z : RatFunc k),
      p.natDegree ≤ n → p ≠ 0 → Polynomial.aeval z p = 0 →
      z ∈ Set.range (algebraMap k (RatFunc k)) := by
    intro n
    induction n with
    | zero =>
      intro p z hdeg hp_ne heval
      have hdeg0 : p.natDegree = 0 := Nat.eq_zero_of_le_zero hdeg
      have hpC : p = Polynomial.C (p.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hdeg0
      have hc0_ne : p.coeff 0 ≠ 0 := by
        intro hc0
        apply hp_ne
        rw [hpC, hc0, map_zero]
      rw [hpC, Polynomial.aeval_C] at heval
      exact False.elim (hc0_ne ((RingHom.injective (algebraMap k (RatFunc k)))
        (heval.trans (map_zero _).symm)))
    | succ n ih =>
      intro p z hdeg hp_ne heval
      by_cases hle : p.natDegree ≤ n
      · exact ih p z hle hp_ne heval
      · have hdeg_eq : p.natDegree = n + 1 := by omega
        obtain ⟨r, hr⟩ := hExistsRoot p hp_ne (by omega)
        obtain ⟨q, hq_eq⟩ := Polynomial.dvd_iff_isRoot.mpr hr
        have hX_ne : (Polynomial.X - Polynomial.C r : Polynomial k) ≠ 0 :=
          (Polynomial.monic_X_sub_C r).ne_zero
        have hq_ne : q ≠ 0 := by
          intro hq0
          rw [hq_eq, hq0, mul_zero] at hp_ne
          exact hp_ne rfl
        have hq_deg : q.natDegree ≤ n := by
          have hmul := Polynomial.natDegree_mul hX_ne hq_ne
          rw [← hq_eq, Polynomial.natDegree_X_sub_C, hdeg_eq] at hmul
          omega
        rw [hq_eq, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at heval
        rcases mul_eq_zero.mp heval with hz | hqz
        · exact ⟨r, (sub_eq_zero.mp hz).symm⟩
        · exact ih q z hq_deg hq_ne hqz
  refine ⟨?_, ?_, ?_⟩
  · 
    intro hRange0
    set θ₀ := θ_c 0
    set P0_rf : RatFunc k := algebraMap (Polynomial k) (RatFunc k) P₀
    set P1_rf : RatFunc k := algebraMap (Polynomial k) (RatFunc k) P₁
    set P2_rf : RatFunc k := algebraMap (Polynomial k) (RatFunc k) P₂
    have hP0_rf_ne : P0_rf ≠ 0 := RatFunc.algebraMap_ne_zero hP₀_ne
    have hθ₀_X0 : θ₀ (MvPolynomial.X 0) = P1_rf / P0_rf := by
      simp [θ₀, θ_c, P0_rf, P1_rf]
    have hθ₀_X1 : θ₀ (MvPolynomial.X 1) = P2_rf / P0_rf := by
      simp [θ₀, θ_c, P0_rf, P2_rf]
    have hMonom : ∀ (ν : Fin 2 →₀ ℕ) (a : k),
        MvPolynomial.monomial ν a =
          MvPolynomial.C a * MvPolynomial.X 0 ^ (ν 0) * MvPolynomial.X 1 ^ (ν 1) := by
      intro ν a
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two, mul_assoc]
    refine ⟨?_, ?_⟩
    · 
      have hClearMonom : ∀ (m : ℕ) (ν : Fin 2 →₀ ℕ) (a : k),
          ν 0 + ν 1 ≤ m →
          θ₀ (MvPolynomial.monomial ν a) * P0_rf ^ m =
            algebraMap (Polynomial k) (RatFunc k)
              (Polynomial.C a * P₀ ^ (m - (ν 0 + ν 1)) * P₁ ^ (ν 0) * P₂ ^ (ν 1)) := by
        intro m ν a hle
        have hm_eq : m = (m - (ν 0 + ν 1)) + ν 0 + ν 1 := by omega
        rw [hMonom, map_mul, map_mul, map_pow, map_pow, hθ₀_X0, hθ₀_X1]
        have hCa : θ₀ (MvPolynomial.C a) =
            algebraMap (Polynomial k) (RatFunc k) (Polynomial.C a) := by
          rw [MvPolynomial.aeval_C, hCa_rf]
        rw [hCa]
        conv_lhs => rw [hm_eq]
        rw [pow_add, pow_add, div_pow, div_pow]
        have h0_ne : P0_rf ^ (ν 0) ≠ 0 := pow_ne_zero _ hP0_rf_ne
        have h1_ne : P0_rf ^ (ν 1) ≠ 0 := pow_ne_zero _ hP0_rf_ne
        simp only [map_mul, map_pow, P0_rf, P1_rf, P2_rf] at h0_ne h1_ne ⊢
        calc
          algebraMap (Polynomial k) (RatFunc k) (Polynomial.C a) *
              (algebraMap (Polynomial k) (RatFunc k) P₁ ^ ν 0 /
                algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 0) *
              (algebraMap (Polynomial k) (RatFunc k) P₂ ^ ν 1 /
                algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 1) *
              (algebraMap (Polynomial k) (RatFunc k) P₀ ^ (m - (ν 0 + ν 1)) *
                algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 0 *
                algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 1)
            = algebraMap (Polynomial k) (RatFunc k) (Polynomial.C a) *
                algebraMap (Polynomial k) (RatFunc k) P₀ ^ (m - (ν 0 + ν 1)) *
                ((algebraMap (Polynomial k) (RatFunc k) P₁ ^ ν 0 /
                  algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 0) *
                  algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 0) *
                ((algebraMap (Polynomial k) (RatFunc k) P₂ ^ ν 1 /
                  algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 1) *
                  algebraMap (Polynomial k) (RatFunc k) P₀ ^ ν 1) := by ring
          _ = algebraMap (Polynomial k) (RatFunc k) (Polynomial.C a) *
                algebraMap (Polynomial k) (RatFunc k) P₀ ^ (m - (ν 0 + ν 1)) *
                algebraMap (Polynomial k) (RatFunc k) P₁ ^ ν 0 *
                algebraMap (Polynomial k) (RatFunc k) P₂ ^ ν 1 := by
              rw [div_mul_cancel₀ _ h0_ne, div_mul_cancel₀ _ h1_ne]
      let numPoly : ℕ → MvPolynomial (Fin 2) k → Polynomial k := fun m F =>
        ∑ ν ∈ F.support,
          Polynomial.C (F.coeff ν) * P₀ ^ (m - (ν 0 + ν 1)) * P₁ ^ (ν 0) * P₂ ^ (ν 1)
      have hSuppDeg : ∀ (m : ℕ) (F : MvPolynomial (Fin 2) k),
          F.totalDegree ≤ m → ∀ ν ∈ F.support, ν 0 + ν 1 ≤ m := by
        intro m F hm ν hν
        have h1 : (ν.sum fun _ e => e) ≤ F.totalDegree := MvPolynomial.le_totalDegree hν
        rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at h1
        omega
      have hNum_rf : ∀ (m : ℕ) (F : MvPolynomial (Fin 2) k),
          F.totalDegree ≤ m →
          θ₀ F * P0_rf ^ m = algebraMap (Polynomial k) (RatFunc k) (numPoly m F) := by
        intro m F hm
        conv_lhs => rw [F.as_sum]
        rw [map_sum, Finset.sum_mul]
        dsimp [numPoly]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro ν hν
        exact hClearMonom m ν (F.coeff ν) (hSuppDeg m F hm ν hν)
      have hNum_eval : ∀ (m : ℕ) (F : MvPolynomial (Fin 2) k) (b : k),
          F.totalDegree ≤ m → P₀.eval b ≠ 0 →
          (numPoly m F).eval b =
            (P₀.eval b) ^ m *
              MvPolynomial.eval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b] F := by
        intro m F b hm hb
        dsimp [numPoly]
        rw [Polynomial.eval_finsetSum]
        conv_rhs => rw [F.as_sum]
        rw [map_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro ν hν
        have hle : ν 0 + ν 1 ≤ m := hSuppDeg m F hm ν hν
        have hm_eq : m = (m - (ν 0 + ν 1)) + ν 0 + ν 1 := by omega
        rw [hMonom]
        simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
          map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X,
          Matrix.cons_val_zero, Matrix.cons_val_one]
        conv_rhs => rw [hm_eq]
        rw [pow_add, pow_add, div_pow, div_pow]
        have hb0 : (P₀.eval b) ^ (ν 0) ≠ 0 := pow_ne_zero _ hb
        have hb1 : (P₀.eval b) ^ (ν 1) ≠ 0 := pow_ne_zero _ hb
        field_simp [hb0, hb1]
      refine ⟨?_, ?_⟩
      · let N : ℕ := 2 * d_Sigma + 1
        let M : ℕ := 2 * N * d_Sigma + 1
        let IdxBox := Fin (N + 1) × Fin (N + 1)
        let R_box : IdxBox → Polynomial k := fun α =>
          P₀ ^ (2 * N - (α.1.val + α.2.val)) * P₁ ^ α.1.val * P₂ ^ α.2.val
        have hR_deg : ∀ α : IdxBox, (R_box α).natDegree < M := by
          intro α
          have hα1 : α.1.val ≤ N := Nat.le_of_lt_succ α.1.isLt
          have hα2 : α.2.val ≤ N := Nat.le_of_lt_succ α.2.isLt
          have hsum_le : α.1.val + α.2.val ≤ 2 * N := by omega
          have hdeg_le : (R_box α).natDegree ≤ 2 * N * d_Sigma := by
            dsimp [R_box]
            calc
              (P₀ ^ (2 * N - (α.1.val + α.2.val)) * P₁ ^ α.1.val * P₂ ^ α.2.val).natDegree
                ≤ (P₀ ^ (2 * N - (α.1.val + α.2.val)) * P₁ ^ α.1.val).natDegree +
                    (P₂ ^ α.2.val).natDegree := Polynomial.natDegree_mul_le
              _ ≤ (P₀ ^ (2 * N - (α.1.val + α.2.val))).natDegree +
                    (P₁ ^ α.1.val).natDegree + (P₂ ^ α.2.val).natDegree :=
                  Nat.add_le_add_right Polynomial.natDegree_mul_le _
              _ ≤ (2 * N - (α.1.val + α.2.val)) * P₀.natDegree +
                    α.1.val * P₁.natDegree + α.2.val * P₂.natDegree := by
                  gcongr <;> exact Polynomial.natDegree_pow_le
              _ ≤ (2 * N - (α.1.val + α.2.val)) * d_Sigma +
                    α.1.val * d_Sigma + α.2.val * d_Sigma := by
                  dsimp [d_Sigma]
                  gcongr
              _ = ((2 * N - (α.1.val + α.2.val)) + (α.1.val + α.2.val)) * d_Sigma := by ring
              _ = 2 * N * d_Sigma := by rw [Nat.sub_add_cancel hsum_le]
          exact Nat.lt_succ_of_le hdeg_le
        let L_map : (IdxBox → k) →ₗ[k] (Fin M → k) :=
          { toFun := fun c r => (∑ α : IdxBox, Polynomial.C (c α) * R_box α).coeff r.val
