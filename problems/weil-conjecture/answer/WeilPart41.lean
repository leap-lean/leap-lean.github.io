    obtain ⟨c₀, hc₀_root⟩ := IsAlgClosed.exists_root Q hQ_degree_ne
    have h_root_laurent : ∀ r : k, Q.IsRoot r →
        ∃ (μ : k) (_ : μ ≠ 0) (m : ℤ),
          m ≠ 0 ∧ σ₀ (ι_Q_hom (Polynomial.X - Polynomial.C r)) =
