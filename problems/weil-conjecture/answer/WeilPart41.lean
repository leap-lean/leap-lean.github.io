        have h_right_id : r_inv_cat ≫ CommRingCat.ofHom (algebraMap K (R_b b)) = 𝟙 _ := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, hr_map, ← hg_iso_hom, g_iso.hom_inv_id,
