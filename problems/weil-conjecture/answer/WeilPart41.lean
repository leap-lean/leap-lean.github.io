        ι_T_hom (Polynomial.C μ₁) * (↑(u_T ^ m₁) : R_T) =
          ι_T_hom (Polynomial.C μ₂) * (↑(u_T ^ m₂) : R_T) →
        m₁ = m₂ := by
      intro μ₁ μ₂ m₁ m₂ hμ₁ hμ₂ heq
      let N : ℕ := (-m₁).toNat + (-m₂).toNat
      have hm₁N : 0 ≤ m₁ + (N : ℤ) := by dsimp [N]; omega
      have hm₂N : 0 ≤ m₂ + (N : ℤ) := by dsimp [N]; omega
      have h_mul := congrArg (· * (↑(u_T ^ (N : ℤ)) : R_T)) heq
      simp only [mul_assoc, ← Units.val_mul, ← zpow_add] at h_mul
      have hz₁ : m₁ + (N : ℤ) = ((m₁ + (N : ℤ)).toNat : ℤ) := (Int.toNat_of_nonneg hm₁N).symm
      have hz₂ : m₂ + (N : ℤ) = ((m₂ + (N : ℤ)).toNat : ℤ) := (Int.toNat_of_nonneg hm₂N).symm
      rw [hz₁, hz₂, hu_T_zpow_nat, hu_T_zpow_nat, ← map_mul, ← map_mul] at h_mul
      have h_poly := hι_T_inj h_mul
      have h_deg := congrArg Polynomial.natDegree h_poly
      rw [Polynomial.natDegree_C_mul_X_pow _ _ hμ₁,
        Polynomial.natDegree_C_mul_X_pow _ _ hμ₂] at h_deg
      omega
    have hQ_deg_pos : 1 ≤ Q.natDegree := by
      by_contra h_le
      have hQ_deg0 : Q.natDegree = 0 := by omega
      have hQ_C : Q = Polynomial.C (Q.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hQ_deg0
      have hc_ne : Q.coeff 0 ≠ 0 := by
        intro hc0; apply hQ_ne; rw [hQ_C, hc0, map_zero]
