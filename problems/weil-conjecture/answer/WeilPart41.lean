          (CategoryTheory.Abelian.Ext.mk₀ β_h) (Nat.add_zero q) = y
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ_h,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    let Φ_U := ((CategoryTheory.Abelian.Ext.mk₀ β_h).postcomp one_U (Nat.add_zero q)).comp Γ_U
    obtain ⟨⟨θ_U, _, hθ_U_bij⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique U.toScheme m q
    exact ⟨(AddEquiv.ofBijective Φ_U (hPostβ_bij.comp hΓ_U_bij)).trans
      (AddEquiv.ofBijective θ_U hθ_U_bij)⟩
  · 
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let U_m := CategoryTheory.Sheaf.composeAndSheafify J_S FgtMod
    let AM : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L_tors := weilEtaleLocalTorsionSheaf S m U_et
    rcases weil_etale_ordinary_godement_resolution S m hm with ⟨_, _, _, _, _, _, _, _, hGodComp⟩
    obtain ⟨e_god⟩ := hGodComp q L_mod
    
    have hmR : (m : R) = 0 := ULift.ext _ _ (ZMod.natCast_self m)
    have hm_mod : ∀ (M : ModuleCat.{u, u} R) (x : M), m • x = 0 := by
      intro M x
      rw [← Nat.cast_smul_eq_nsmul R m x, hmR, zero_smul]
    have hR_smul_addHom : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R M₁]
        [AddCommGroup M₂] [Module R M₂] (f : M₁ →+ M₂) (r : R) (x : M₁),
        f (r • x) = r • f x := by
      intro M₁ M₂ _ _ _ _ f r x
      obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
