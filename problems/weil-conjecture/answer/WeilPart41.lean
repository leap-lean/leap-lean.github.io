    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) R) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    let f₀ : CommRingCat.of R ⟶ CommRingCat.of ↥(𝒜 0) :=
      CommRingCat.ofHom (algebraMap R ↥(𝒜 0))
    have hBij₀ : Function.Bijective f₀.hom := by
      refine ⟨fun c₁ c₂ hc => ?_, fun p => ?_⟩
      · have hc_val : (algebraMap R ↥(𝒜 0) c₁ : MvPolynomial (Fin (N + 1)) R) =
            (algebraMap R ↥(𝒜 0) c₂ : MvPolynomial (Fin (N + 1)) R) :=
          congrArg Subtype.val hc
        rw [hCoeAlg0 c₁, hCoeAlg0 c₂] at hc_val
        exact MvPolynomial.C_injective (Fin (N + 1)) R hc_val
      · have hp1 : (p : MvPolynomial (Fin (N + 1)) R) ∈
            (1 : Submodule R (MvPolynomial (Fin (N + 1)) R)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (N + 1))]
          exact p.2
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
        refine ⟨c, Subtype.ext ?_⟩
        calc (algebraMap R ↥(𝒜 0) c : MvPolynomial (Fin (N + 1)) R)
            = c • (1 : MvPolynomial (Fin (N + 1)) R) := Algebra.algebraMap_eq_smul_one c
          _ = algebraMap R (MvPolynomial (Fin (N + 1)) R) c := (Algebra.algebraMap_eq_smul_one c).symm
          _ = p.1 := hc
    have : CategoryTheory.IsIso f₀ :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective f₀).mpr hBij₀
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f₀) := inferInstance
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map f₀)
    infer_instance

  have hIrrel : ∀ (R : Type u) [CommRing R] (N : ℕ),
      let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant 𝒜_R).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) := by
    intro R _ N 𝒜_R
    let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    intro p hp
    have hp0 : GradedRing.proj 𝒜_R 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff 𝒜_R p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      have hdecomp := DirectSum.sum_support_decompose 𝒜_R p
      have hsum_coeff :
          (∑ i ∈ (DirectSum.decompose 𝒜_R p).support,
            ((DirectSum.decompose 𝒜_R p i : MvPolynomial (Fin (N + 1)) R)).coeff 0) =
          p.coeff 0 := by
        rw [← MvPolynomial.coeff_sum, hdecomp]
      rw [← hsum_coeff]
      refine Finset.sum_eq_zero fun i _ => ?_
      by_cases hi : i = 0
      · subst hi
        have h0 : (DirectSum.decompose 𝒜_R p 0 : MvPolynomial (Fin (N + 1)) R) = 0 := hp0
        rw [h0]
        rfl
      · by_contra hne
        have hhom : ((DirectSum.decompose 𝒜_R p i :
            MvPolynomial (Fin (N + 1)) R)).IsHomogeneous i :=
          (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜_R p i).2
        have hdeg := hhom hne
        simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg
        exact hi hdeg.symm
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm_ne : m ≠ 0 := by
      intro h0
      rw [h0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
    by_contra h_all
    apply hm_ne
    ext i
    by_contra hmi
    exact h_all ⟨i, Set.mem_univ i, hmi⟩

  have hX_mem_irrel : ∀ (R : Type u) [CommRing R] (N : ℕ) (μ : Fin (N + 1)),
      let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
      (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) R) ∈
        (HomogeneousIdeal.irrelevant 𝒜_R).toIdeal := by
    intro R _ N μ 𝒜_R
    let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    change MvPolynomial.X μ ∈ HomogeneousIdeal.irrelevant 𝒜_R
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    have hX1 : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) R) ∈ 𝒜_R 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R μ)
    rw [DirectSum.decompose_of_mem_ne 𝒜_R hX1 (by decide)]

  have hProjMapCongr : ∀ {A B : Type u} [CommRing A] [CommRing B] {N₀ N₁ : ℕ},
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) A
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) B
      letI : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      ∀ {f' g' : 𝒜₀ →+*ᵍ 𝒜₁} (hfg : f' = g')
        (hf' : HomogeneousIdeal.irrelevant 𝒜₁ ≤
          HomogeneousIdeal.map f' (HomogeneousIdeal.irrelevant 𝒜₀))
        (hg' : HomogeneousIdeal.irrelevant 𝒜₁ ≤
          HomogeneousIdeal.map g' (HomogeneousIdeal.irrelevant 𝒜₀)),
        AlgebraicGeometry.Proj.map f' hf' = AlgebraicGeometry.Proj.map g' hg' := by
    intro A B _ _ N₀ N₁ 𝒜₀ 𝒜₁ f' g' hfg hf' hg'
    subst hfg
    rfl

  have hProjOverHom : ∀ (R₀ R₁ : Type u) [CommRing R₀] [CommRing R₁]
      (ρ : R₀ →+* R₁) (N₀ N₁ : ℕ),
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) R₀
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) R₁
      letI : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      ∀ (f : 𝒜₀ →+*ᵍ 𝒜₁)
        (hf : HomogeneousIdeal.irrelevant 𝒜₁ ≤
          HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜₀)),
        (∀ c : R₀, f (MvPolynomial.C c) = MvPolynomial.C (ρ c)) →
        AlgebraicGeometry.Proj.map f hf ≫ (weilProjectiveSpaceOver R₀ N₀).hom =
          (weilProjectiveSpaceOver R₁ N₁).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ) := by
    intro R₀ R₁ _ _ ρ N₀ N₁ 𝒜₀ 𝒜₁ f hf hC
    let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
    have hSpan_f : (HomogeneousIdeal.irrelevant 𝒜₁).toIdeal ≤
        Ideal.span (Set.range (fun μ : Fin (N₀ + 1) => f (MvPolynomial.X μ))) := by
      have hf_id : (HomogeneousIdeal.irrelevant 𝒜₁).toIdeal ≤
          (HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜₀)).toIdeal := hf
      rw [HomogeneousIdeal.toIdeal_map] at hf_id
      refine hf_id.trans ((Ideal.map_mono (hIrrel R₀ N₀)).trans ?_)
      rw [Ideal.map_span]
      refine le_of_eq (congrArg Ideal.span ?_)
      ext y
      simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and]
    have hCov_f :
        (⨆ μ : Fin (N₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜₁ (f (MvPolynomial.X μ))) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜₁
        (fun μ : Fin (N₀ + 1) => f (MvPolynomial.X μ)) hSpan_f
    let p₀_hom : AlgebraicGeometry.Proj 𝒜₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜₀ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ ↥(𝒜₀ 0)))
    let p₁_hom : AlgebraicGeometry.Proj 𝒜₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ ↥(𝒜₁ 0)))
    change AlgebraicGeometry.Proj.map f hf ≫ p₀_hom =
      p₁_hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
    refine AlgebraicGeometry.Scheme.hom_ext_of_forall _ _ fun x => ?_
    have hx_top : x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜₁).Opens) := trivial
    rw [← hCov_f, TopologicalSpace.Opens.mem_iSup] at hx_top
    obtain ⟨μ, hxμ⟩ := hx_top
    refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜₁ (f (MvPolynomial.X μ)), hxμ, ?_⟩
    have hXμ₀ : (MvPolynomial.X μ : MvPolynomial (Fin (N₀ + 1)) R₀) ∈ 𝒜₀ 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R₀ μ)
    have hfXμ : f (MvPolynomial.X μ) ∈ 𝒜₁ 1 := f.map_mem hXμ₀
    let iso₁ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (f (MvPolynomial.X μ)) hfXμ zero_lt_one
    rw [← CategoryTheory.cancel_epi iso₁.inv, ← CategoryTheory.Category.assoc iso₁.inv,
      ← CategoryTheory.Category.assoc iso₁.inv,
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₁ (f (MvPolynomial.X μ)) hfXμ zero_lt_one]
    have hLHS :
        AlgebraicGeometry.Proj.awayι 𝒜₁ (f (MvPolynomial.X μ)) hfXμ zero_lt_one ≫
          AlgebraicGeometry.Proj.map f hf ≫ p₀_hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((HomogeneousLocalization.Away.map f (MvPolynomial.X μ)).comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₀
                (Submonoid.powers (MvPolynomial.X μ))).comp
              (algebraMap R₀ ↥(𝒜₀ 0))))) := by
      dsimp only [p₀_hom]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_comp_map f hf zero_lt_one (MvPolynomial.X μ) hXμ₀,
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hRHS :
        AlgebraicGeometry.Proj.awayι 𝒜₁ (f (MvPolynomial.X μ)) hfXμ zero_lt_one ≫
          p₁_hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                (Submonoid.powers (f (MvPolynomial.X μ)))).comp
              (algebraMap R₁ ↥(𝒜₁ 0))).comp ρ)) := by
      dsimp only [p₁_hom]
      rw [CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hLHS, hRHS]
    congr 2
    apply RingHom.ext
    intro c
    apply HomogeneousLocalization.val_injective
    simp only [RingHom.comp_apply]
    rw [hFromZero_mk, hFromZero_mk]
    change (HomogeneousLocalization.map f _ (HomogeneousLocalization.mk _)).val =
      (HomogeneousLocalization.mk _).val
    rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
      HomogeneousLocalization.val_mk]
    have hg_num : f (algebraMap R₀ ↥(𝒜₀ 0) c : MvPolynomial (Fin (N₀ + 1)) R₀) =
        (algebraMap R₁ ↥(𝒜₁ 0) (ρ c) : MvPolynomial (Fin (N₁ + 1)) R₁) := by
      rw [hCoeAlg0 c, hCoeAlg0 (ρ c), hC c]
    exact congrArg₂ Localization.mk hg_num (Subtype.ext (map_one f))

  let mapGraded : ∀ {R₀ R₁ : Type u} [CommRing R₀] [CommRing R₁] (ρ : R₀ →+* R₁) (N : ℕ),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁) :=
        MvPolynomial.gradedAlgebra
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀ →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁ :=
    fun {R₀ R₁} _ _ ρ N =>
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁) :=
        MvPolynomial.gradedAlgebra
      { toRingHom := MvPolynomial.map ρ
        map_mem := fun {i p} hp => by
          rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
          intro d hd
          rw [MvPolynomial.coeff_map] at hd
          exact hp fun h0 => hd (by rw [h0, map_zero]) }

  have h_irrel_map : ∀ {R₀ R₁ : Type u} [CommRing R₀] [CommRing R₁] (ρ : R₀ →+* R₁) (N : ℕ),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁) :=
        MvPolynomial.gradedAlgebra
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁) ≤
        HomogeneousIdeal.map (mapGraded ρ N)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀)) := by
    intro R₀ R₁ _ _ ρ N
    let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀
    let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁
    let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
    change (HomogeneousIdeal.irrelevant 𝒜₁).toIdeal ≤
      (HomogeneousIdeal.map (mapGraded ρ N) (HomogeneousIdeal.irrelevant 𝒜₀)).toIdeal
    rw [HomogeneousIdeal.toIdeal_map]
    refine (hIrrel R₁ N).trans (Ideal.span_le.mpr ?_)
    rintro _ ⟨a, rfl⟩
    have hmap_X : (mapGraded ρ N).toRingHom (MvPolynomial.X a) = MvPolynomial.X a :=
      MvPolynomial.map_X ρ a
    rw [← hmap_X]
    exact Ideal.mem_map_of_mem _ (hX_mem_irrel R₀ N a)

  have hEquiv : ∀ (N : ℕ) (a : Fin (N + 1)) (R : Type u) [CommRing R],
      let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
      ∀ (x : MvPolynomial (Fin (N + 1)) R), x = MvPolynomial.X a →
        ∃ e : MvPolynomial {b : Fin (N + 1) // b ≠ a} R ≃+* HomogeneousLocalization.Away 𝒜_R x,
          (∀ c : R, e (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers x)
              (algebraMap R ↥(𝒜_R 0) c)) ∧
          (∀ b : {b : Fin (N + 1) // b ≠ a}, (e (MvPolynomial.X b)).val =
            Localization.mk (MvPolynomial.X b.1) ⟨x, Submonoid.mem_powers x⟩) := by
    intro N a R _ 𝒜_R x hx
    let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    subst hx
    let τ_a := {b : Fin (N + 1) // b ≠ a}
    let X_a : MvPolynomial (Fin (N + 1)) R := MvPolynomial.X a
    have hXa : X_a ∈ 𝒜_R 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R a)
    let s₁ : Submonoid.powers X_a := ⟨X_a, Submonoid.mem_powers X_a⟩
    let ι_R : R →+* HomogeneousLocalization.Away 𝒜_R X_a :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers X_a)).comp
        (algebraMap R ↥(𝒜_R 0))
    let u_R : τ_a → HomogeneousLocalization.Away 𝒜_R X_a := fun b =>
      HomogeneousLocalization.mk
        { deg := 1
          num := ⟨MvPolynomial.X b.1,
            (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b.1)⟩
          den := ⟨X_a, hXa⟩
          den_mem := Submonoid.mem_powers X_a }
    let α_R : MvPolynomial τ_a R →+* HomogeneousLocalization.Away 𝒜_R X_a :=
      MvPolynomial.eval₂Hom ι_R u_R
    let w_R : Fin (N + 1) → MvPolynomial τ_a R :=
      fun j => if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩
    let dehom_R : MvPolynomial (Fin (N + 1)) R →+* MvPolynomial τ_a R :=
      MvPolynomial.eval₂Hom MvPolynomial.C w_R
    have hdehom_Xa : dehom_R X_a = 1 := by
      simp [dehom_R, X_a, w_R]
    have hg_unit : ∀ y : Submonoid.powers X_a, IsUnit (dehom_R y.1) := by
      rintro ⟨_, ⟨n, rfl⟩⟩
      rw [map_pow, hdehom_Xa, one_pow]
      exact isUnit_one
    let β_loc : Localization (Submonoid.powers X_a) →+* MvPolynomial τ_a R :=
      IsLocalization.lift hg_unit
    let valHom : HomogeneousLocalization.Away 𝒜_R X_a →+* Localization (Submonoid.powers X_a) :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
    let β_R : HomogeneousLocalization.Away 𝒜_R X_a →+* MvPolynomial τ_a R :=
      β_loc.comp valHom
    have hβ_mk : ∀ (p : MvPolynomial (Fin (N + 1)) R) (s : Submonoid.powers X_a),
        dehom_R s.1 = 1 → β_loc (Localization.mk p s) = dehom_R p := by
      intro p s hs1
      have hmk' : Localization.mk p s =
          IsLocalization.mk' (Localization (Submonoid.powers X_a)) p s :=
        congrFun (congrFun Localization.mk_eq_mk' p) s
      rw [hmk']
      exact (IsLocalization.lift_mk'_spec hg_unit p (dehom_R p) s).mpr (by rw [hs1, one_mul])
    have hι_val : ∀ c : R, (ι_R c).val = Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      change (HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers X_a)
        (algebraMap R ↥(𝒜_R 0) c)).val = Localization.mk (MvPolynomial.C c) 1
      rw [hFromZero_mk, HomogeneousLocalization.val_mk]
      exact congrArg (fun q => Localization.mk q 1) (hCoeAlg0 c)
    have h_left : ∀ P : MvPolynomial τ_a R, β_R (α_R P) = P := by
      have hcomp : β_R.comp α_R = RingHom.id (MvPolynomial τ_a R) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change β_loc ((α_R (MvPolynomial.C c)).val) = MvPolynomial.C c
          rw [MvPolynomial.eval₂Hom_C, hι_val c, hβ_mk _ 1 (map_one dehom_R)]
          simp [dehom_R]
        · intro b
          change β_loc ((α_R (MvPolynomial.X b)).val) = MvPolynomial.X b
          rw [MvPolynomial.eval₂Hom_X']
          change β_loc (Localization.mk (MvPolynomial.X b.1) s₁) = MvPolynomial.X b
          rw [hβ_mk _ s₁ hdehom_Xa]
          simp [dehom_R, w_R, b.2]
      exact fun P => congrArg (fun f => f P) hcomp
    have h_right : ∀ z : HomogeneousLocalization.Away 𝒜_R X_a, α_R (β_R z) = z := by
      rcases subsingleton_or_nontrivial R with hSub | hNontriv
      · have : Subsingleton R := hSub
        have h01 : (0 : HomogeneousLocalization.Away 𝒜_R X_a) = 1 := by
          rw [← map_zero ι_R, ← map_one ι_R, Subsingleton.elim (0 : R) 1]
        have : Subsingleton (HomogeneousLocalization.Away 𝒜_R X_a) :=
          subsingleton_of_zero_eq_one h01
        intro z
        exact Subsingleton.elim _ _
      · have : Nontrivial R := hNontriv
        let φ : MvPolynomial (Fin (N + 1)) R →+* Localization (Submonoid.powers X_a) :=
          valHom.comp (α_R.comp dehom_R)
        have hφ_C : ∀ c : R, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
          intro c
          change (α_R (dehom_R (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) 1
          simp [dehom_R, α_R, hι_val]
        have hφ_X : ∀ j : Fin (N + 1),
            φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) s₁ := by
          intro j
          change (α_R (dehom_R (MvPolynomial.X j))).val = Localization.mk (MvPolynomial.X j) s₁
          rw [MvPolynomial.eval₂Hom_X']
          dsimp [w_R]
          split_ifs with hj
          · subst hj
            rw [map_one, HomogeneousLocalization.val_one]
            exact (Localization.mk_self s₁).symm
          · rw [MvPolynomial.eval₂Hom_X']
            rfl
        have hProd_mk : ∀ (S : Finset (Fin (N + 1))) (m : Fin (N + 1) →₀ ℕ),
            (∏ j ∈ S, Localization.mk (MvPolynomial.X j ^ m j) (s₁ ^ m j)) =
              Localization.mk (∏ j ∈ S, MvPolynomial.X j ^ m j)
                (s₁ ^ (∑ j ∈ S, m j)) := by
          intro S m
          induction S using Finset.induction_on with
          | empty =>
            simp [Localization.mk_one]
          | @insert j S hj ih =>
            rw [Finset.prod_insert hj, Finset.prod_insert hj, Finset.sum_insert hj,
              ih, Localization.mk_mul, pow_add]
        have hφ_mon : ∀ (m : Fin (N + 1) →₀ ℕ) (c : R),
            φ (MvPolynomial.monomial m c) =
              Localization.mk (MvPolynomial.monomial m c) (s₁ ^ (∑ j ∈ m.support, m j)) := by
          intro m c
          conv_lhs => rw [MvPolynomial.monomial_eq]
          rw [map_mul, hφ_C c, Finsupp.prod, map_prod]
          have hprod_eq : (∏ j ∈ m.support, φ (MvPolynomial.X j ^ m j)) =
              ∏ j ∈ m.support, Localization.mk (MvPolynomial.X j ^ m j) (s₁ ^ m j) := by
            refine Finset.prod_congr rfl fun j _ => ?_
            rw [map_pow, hφ_X j, Localization.mk_pow]
          rw [hprod_eq, hProd_mk, Localization.mk_mul, one_mul,
            ← Finsupp.prod, ← MvPolynomial.monomial_eq]
        intro z
        refine Quotient.inductionOn' z fun nd => ?_
        apply HomogeneousLocalization.val_injective
        obtain ⟨n, hn⟩ : ∃ n : ℕ, (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) R) ^ n =
            nd.den.1 := nd.den_mem
        have hd_eq : nd.deg = n := by
          have hden_hom1 : nd.den.1.IsHomogeneous nd.deg :=
            (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
          have hden_hom2 : nd.den.1.IsHomogeneous n := by
            rw [← hn]
            have hmem : X_a ^ n ∈ 𝒜_R (n • 1) := SetLike.pow_mem_graded n hXa
            rw [nsmul_one] at hmem
            exact (MvPolynomial.mem_homogeneousSubmodule n (X_a ^ n)).mp hmem
          have hcoeff_ne : nd.den.1.coeff (Finsupp.single a n) ≠ 0 := by
            rw [← hn]
            simp only [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial, ↓reduceIte]
            exact one_ne_zero
          exact (hden_hom1 hcoeff_ne).symm.trans (hden_hom2 hcoeff_ne)
        have hden_dehom : dehom_R nd.den.1 = 1 := by
          rw [← hn, map_pow, hdehom_Xa, one_pow]
        have hβ_nd : β_R (HomogeneousLocalization.mk nd) = dehom_R nd.num.1 := by
          change β_loc (HomogeneousLocalization.mk nd).val = dehom_R nd.num.1
          rw [HomogeneousLocalization.val_mk]
          exact hβ_mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩ hden_dehom
        rw [hβ_nd, HomogeneousLocalization.val_mk]
        change φ nd.num.1 = Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩
        have hnum_hom : nd.num.1.IsHomogeneous n := by
          rw [← hd_eq]
          exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
        have hSum_mk : ∀ (S : Finset (Fin (N + 1) →₀ ℕ)),
            (∀ m ∈ S, (∑ j ∈ m.support, m j) = n) →
            φ (∑ m ∈ S, MvPolynomial.monomial m (nd.num.1.coeff m)) =
              Localization.mk (∑ m ∈ S, MvPolynomial.monomial m (nd.num.1.coeff m)) (s₁ ^ n) := by
          intro S hS
          induction S using Finset.induction_on with
          | empty =>
            simp [Localization.mk_zero]
          | @insert m S hm ih =>
            rw [Finset.sum_insert hm, map_add,
              hφ_mon m _, hS m (Finset.mem_insert_self m S),
              ih (fun m' hm' => hS m' (Finset.mem_insert_of_mem hm')),
              Localization.add_mk_self]
