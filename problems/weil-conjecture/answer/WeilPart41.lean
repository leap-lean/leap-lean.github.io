    have hj_Sig0_fst : j_Sig0 ≫ π_P1 = f_Sigma_0 :=
      hPb_P1k.lift_fst _ _ hComm_jSig0
    have hj_Sig0_snd : j_Sig0 ≫ ι_line_k = q_h0 ≫ j_0 :=
