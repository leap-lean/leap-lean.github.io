    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
    refine ⟨?_, ?_⟩
    · 
      intro hInj_i0 p_y0 hp_y0
      refine ⟨?_, ?_⟩
      · refine (injective_iff_map_eq_zero p_y0).mpr fun x hx => ?_
        obtain ⟨p_π0, hp_π0⟩ := hPullEx π.left m₀ 0
        obtain ⟨p_i0, hp_i0⟩ := hPullEx i_E m₀ 0
        obtain ⟨p_Ehom, hp_Ehom⟩ := hPullEx E.hom m₀ 0
        obtain ⟨p_tot, hp_tot⟩ := hPullEx (i_E ≫ π.left) m₀ 0
        have hcomp1 : p_tot = p_i0.comp p_π0 :=
          hPullComp i_E π.left m₀ 0 p_i0 p_π0 p_tot hp_i0 hp_π0 hp_tot
        have hp_tot' : WeilIsTorsionEtalePullback (E.hom ≫ y₀) m₀ 0 p_tot := by
          rwa [← hPb_E.w]
        have hcomp2 : p_tot = p_Ehom.comp p_y0 :=
          hPullComp E.hom y₀ m₀ 0 p_Ehom p_y0 p_tot hp_Ehom hp_y0 hp_tot'
        have hp_i0_zero : p_i0 (p_π0 x) = 0 := by
          change (p_i0.comp p_π0) x = 0
          rw [← hcomp1, hcomp2, AddMonoidHom.comp_apply, hx, map_zero]
        have hp_π0_zero : p_π0 x = 0 :=
          hInj_i0 p_i0 hp_i0 (hp_i0_zero.trans (map_zero p_i0).symm)
        have hInj_π0 : Function.Injective p_π0 :=
          weil_split_quad_retracted_point_modif_and_clopen_counit.{u}.2.2
            k 0 ℓ r hℓ hPBC Y_tilde Y E π y₀ hy₀ U_Y hU_Y hIso_U i_E hi_cl hPb_E p_E hRetr
            p_π0 hp_π0
        exact hInj_π0 (hp_π0_zero.trans (map_zero p_π0).symm)
      · intro z
        obtain ⟨p_Yhom, hp_Yhom⟩ := hPullEx Y.hom m₀ 0
        obtain ⟨p_id, hp_id⟩ := hPullEx (𝟙 S_k) m₀ 0
        have hp_id_eq : p_id = AddMonoidHom.id _ := hPullId m₀ 0 p_id hp_id
        have hp_comp_pb : WeilIsTorsionEtalePullback (y₀ ≫ Y.hom) m₀ 0 p_id := by
          rwa [hy₀]
        have hcomp : p_id = p_y0.comp p_Yhom :=
          hPullComp y₀ Y.hom m₀ 0 p_y0 p_Yhom p_id hp_y0 hp_Yhom hp_comp_pb
        refine ⟨p_Yhom z, ?_⟩
        change (p_y0.comp p_Yhom) z = z
        rw [← hcomp, hp_id_eq, AddMonoidHom.id_apply]
    · 
      intro q p_π p_iE hp_π hp_iE
      have hInj_π : Function.Injective p_π :=
        weil_split_quad_retracted_point_modif_and_clopen_counit.{u}.2.2
          k (q + 1) ℓ r hℓ hPBC Y_tilde Y E π y₀ hy₀ U_Y hU_Y hIso_U i_E hi_cl hPb_E p_E hRetr
          p_π hp_π
      refine ⟨hInj_π, le_antisymm ?_ ?_⟩
      · rintro y ⟨x, rfl⟩
        change p_iE (p_π x) = 0
        obtain ⟨p_y0, hp_y0⟩ := hPullEx y₀ m₀ (q + 1)
        obtain ⟨p_Ehom, hp_Ehom⟩ := hPullEx E.hom m₀ (q + 1)
        obtain ⟨p_tot, hp_tot⟩ := hPullEx (i_E ≫ π.left) m₀ (q + 1)
        have hcomp1 : p_tot = p_iE.comp p_π :=
          hPullComp i_E π.left m₀ (q + 1) p_iE p_π p_tot hp_iE hp_π hp_tot
        have hp_tot' : WeilIsTorsionEtalePullback (E.hom ≫ y₀) m₀ (q + 1) p_tot := by
          rwa [← hPb_E.w]
        have hcomp2 : p_tot = p_Ehom.comp p_y0 :=
          hPullComp E.hom y₀ m₀ (q + 1) p_Ehom p_y0 p_tot hp_Ehom hp_y0 hp_tot'
        let Z_k : CategoryTheory.Over S_k := CategoryTheory.Over.mk (𝟙 S_k)
        have hSm_Zk : AlgebraicGeometry.SmoothOfRelativeDimension 0 Z_k.hom := by
          change AlgebraicGeometry.SmoothOfRelativeDimension 0 (𝟙 S_k)
          infer_instance
        have hLFT_Zk : AlgebraicGeometry.LocallyOfFiniteType Z_k.hom := by
          change AlgebraicGeometry.LocallyOfFiniteType (𝟙 S_k)
          infer_instance
        have hQC_Zk : AlgebraicGeometry.QuasiCompact Z_k.hom := by
          change AlgebraicGeometry.QuasiCompact (𝟙 S_k)
          infer_instance
        have hInt_Zk : AlgebraicGeometry.IsIntegral Z_k.left := by
          change AlgebraicGeometry.IsIntegral S_k
          infer_instance
        letI := hSm_Zk
        letI := hLFT_Zk
        letI := hQC_Zk
        have hDim_Zk : topologicalKrullDim Z_k.left = (0 : WithBot ℕ∞) :=
          weil_smooth_integral_krullDim_over_field k 0 Z_k hInt_Zk
        have hSub_Zk : Subsingleton (weilEtaleTorsionH S_k m₀ (q + 1)) :=
          weil_etale_dim_zero_algClosed_cohomology_subsingleton k Z_k (le_of_eq hDim_Zk)
            (weilEtaleTorsionSheaf Z_k.left m₀) (q + 1) (by omega)
        have hp_y0_x : p_y0 x = 0 := hSub_Zk.elim _ _
        change (p_iE.comp p_π) x = 0
        rw [← hcomp1, hcomp2, AddMonoidHom.comp_apply, hp_y0_x, map_zero]
      · intro y hy
        change p_iE y = 0 at hy
        let U_Yt : Y_tilde.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U_Y
        let U_Y_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U_Y.ι
          (inferInstance : AlgebraicGeometry.Etale U_Y.ι)
        let U_Yt_et : Y_tilde.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U_Yt.ι
          (inferInstance : AlgebraicGeometry.Etale U_Yt.ι)
        have hi_E_hom : i_E ≫ Y_tilde.hom = E.hom := by
          rw [← π.w, ← CategoryTheory.Category.assoc, hPb_E.w, CategoryTheory.Category.assoc, hy₀,
            CategoryTheory.Category.comp_id]
        have hU_Yt : (U_Yt : Set Y_tilde.left) = (Set.range i_E.base)ᶜ := by
          ext z
          change π.left.base z ∈ (U_Y : Set Y.left) ↔ z ∉ Set.range i_E.base
          rw [hU_Y, Set.mem_compl_iff]
          refine not_congr ⟨?_, ?_⟩
          · rintro ⟨pt, hpt⟩
            obtain ⟨e, he, _⟩ :=
              AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_E z pt hpt.symm
            exact ⟨e, he⟩
          · rintro ⟨e, rfl⟩
            exact ⟨E.hom.base e, (congrArg (fun g => g.base e) hPb_E.w).symm⟩
        rcases hp_iE with
          ⟨hc_iE, hr_iE, hAdd_iE, hLim_iE, hColim_iE, T₁_e, hT₁_e, T₂_e, hT₂_e,
            ιℤ_e, hιπ_e, hπι_e, hp_iE_eq⟩
        letI : (weilEtaleSitePullback i_E).IsContinuous
            Y_tilde.left.smallEtaleTopology E.left.smallEtaleTopology := hc_iE
        let pf_iE := (weilEtaleSitePullback i_E).sheafPushforwardContinuous
          AddCommGrpCat.{u} Y_tilde.left.smallEtaleTopology E.left.smallEtaleTopology
        letI : pf_iE.IsRightAdjoint := hr_iE
        let pb_iE := (weilEtaleSitePullback i_E).sheafPullback
          AddCommGrpCat.{u} Y_tilde.left.smallEtaleTopology E.left.smallEtaleTopology
        let adj_iE := (weilEtaleSitePullback i_E).sheafAdjunctionContinuous
          AddCommGrpCat.{u} Y_tilde.left.smallEtaleTopology E.left.smallEtaleTopology
        letI : pb_iE.Additive := hAdd_iE
        letI : CategoryTheory.Limits.PreservesFiniteLimits pb_iE := hLim_iE
        letI : CategoryTheory.Limits.PreservesFiniteColimits pb_iE := hColim_iE
        let Fℤ_Yt :=
          (CategoryTheory.constantSheaf Y_tilde.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
        let Fℤ_E :=
          (CategoryTheory.constantSheaf E.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
        let Λ_Yt := weilEtaleTorsionSheaf Y_tilde.left m₀
        let Λ_E := weilEtaleTorsionSheaf E.left m₀
        obtain ⟨⟨hκu_Yt, hSE_Yt⟩, hAcyc_iE⟩ :=
          weil_sq_rmcc_closed_open_localTorsion_excision_shortExact
            k ℓ r hℓ hPBC Y_tilde E i_E hi_cl hi_E_hom U_Yt hU_Yt T₁_e hT₁_e T₂_e hT₂_e
        obtain ⟨_, _, hEdgePkg, _⟩ := weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}
        let πM_e : pb_iE.obj Λ_Yt ⟶ Λ_E := weilEtaleConstPullbackHom i_E hT₁_e hT₂_e AM
        let u_iE : Λ_Yt ⟶ pf_iE.obj Λ_E := (adj_iE.homEquiv Λ_Yt Λ_E) πM_e
        let c_iE : pb_iE.obj (pf_iE.obj Λ_E) ⟶ Λ_E :=
          (adj_iE.homEquiv (pf_iE.obj Λ_E) Λ_E).symm (𝟙 (pf_iE.obj Λ_E))
        have hc_iE_eq : c_iE = adj_iE.counit.app Λ_E :=
          (adj_iE.homEquiv_counit (pf_iE.obj Λ_E) Λ_E (𝟙 (pf_iE.obj Λ_E))).trans
            ((congrArg (· ≫ adj_iE.counit.app Λ_E) (pb_iE.map_id (pf_iE.obj Λ_E))).trans
              (CategoryTheory.Category.id_comp (adj_iE.counit.app Λ_E)))
        have hπM_e_fac : πM_e = pb_iE.map u_iE ≫ c_iE :=
          ((adj_iE.homEquiv Λ_Yt Λ_E).symm_apply_apply πM_e).symm.trans
            ((adj_iE.homEquiv_counit Λ_Yt Λ_E u_iE).trans
              (congrArg (pb_iE.map u_iE ≫ ·) hc_iE_eq.symm))
        let edge_iE : (pf_iE.obj Λ_E).H (q + 1) → weilEtaleTorsionH E.left m₀ (q + 1) :=
          fun z =>
            (CategoryTheory.Abelian.Ext.mk₀ c_iE).postcomp Fℤ_E (Nat.add_zero (q + 1))
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_e).comp
                ((pb_iE.mapExtAddHom Fℤ_Yt (pf_iE.obj Λ_E) (q + 1)) z) (Nat.zero_add (q + 1)))
        have hedge_iE_bij : Function.Bijective edge_iE :=
          (hEdgePkg i_E hT₁_e hT₂_e ιℤ_e hιπ_e hπι_e).1
            (pf_iE.obj Λ_E) Λ_E (𝟙 (pf_iE.obj Λ_E)) inferInstance hAcyc_iE (q + 1)
        have hp_iE_fac : p_iE y =
            edge_iE (y.comp (CategoryTheory.Abelian.Ext.mk₀ u_iE) (Nat.add_zero (q + 1))) := by
          rw [hp_iE_eq y]
          change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_e).comp
              ((pb_iE.mapExtAddHom Fℤ_Yt Λ_Yt (q + 1)) y) (Nat.zero_add (q + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ πM_e) (Nat.add_zero (q + 1)) =
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_e).comp
              ((pb_iE.mapExtAddHom Fℤ_Yt (pf_iE.obj Λ_E) (q + 1))
                (y.comp (CategoryTheory.Abelian.Ext.mk₀ u_iE) (Nat.add_zero (q + 1))))
              (Nat.zero_add (q + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ c_iE) (Nat.add_zero (q + 1))
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            hπM_e_fac, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
          exact congrArg
            (fun t => t.comp (CategoryTheory.Abelian.Ext.mk₀ c_iE) (Nat.add_zero (q + 1)))
            (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
              (CategoryTheory.Abelian.Ext.mk₀ ιℤ_e)
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb_iE y)
              (CategoryTheory.Abelian.Ext.mk₀ (pb_iE.map u_iE))
              (Nat.zero_add (q + 1)))
        have hedge_iE_zero : edge_iE 0 = 0 :=
          (congrArg ((CategoryTheory.Abelian.Ext.mk₀ c_iE).postcomp Fℤ_E (Nat.add_zero (q + 1)))
            ((congrArg (fun t => (CategoryTheory.Abelian.Ext.mk₀ ιℤ_e).comp t (Nat.zero_add (q + 1)))
              (map_zero (pb_iE.mapExtAddHom Fℤ_Yt (pf_iE.obj Λ_E) (q + 1)))).trans
              (CategoryTheory.Abelian.Ext.comp_zero _ _ _ _ (Nat.zero_add (q + 1))))).trans
            (map_zero ((CategoryTheory.Abelian.Ext.mk₀ c_iE).postcomp Fℤ_E (Nat.add_zero (q + 1))))
        have huy_zero : y.comp (CategoryTheory.Abelian.Ext.mk₀ u_iE) (Nat.add_zero (q + 1)) = 0 :=
          hedge_iE_bij.1 ((hp_iE_fac.symm.trans hy).trans hedge_iE_zero.symm)
        obtain ⟨w_tilde, hw_tilde⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_Yt hSE_Yt y huy_zero
        obtain ⟨hModifLoc, _⟩ :=
          weil_sq_rmcc_point_modif_localTorsion_counit_pullback_bijective
            k ℓ r hℓ hPBC Y_tilde Y E π y₀ hy₀ U_Y hU_Y hIso_U i_E hPb_E
        obtain ⟨p_ℒ, hp_ℒ_bij, hp_ℒ_comm⟩ := hModifLoc (q + 1) p_π hp_π
        obtain ⟨w, hw⟩ := hp_ℒ_bij.2 w_tilde
        refine ⟨weilEtaleLocalTorsionCounitH Y.left m₀ U_Y_et (q + 1) w, ?_⟩
        rw [← hp_ℒ_comm w, hw]
        exact hw_tilde

theorem weil_quad_cvs_projSpace_charts_and_hyperplane_compl (K : Type u) [Field K] (N : ℕ) :
    ((⨆ μ : Fin (N + 1), weilProjBasicOpen K N μ) = ⊤ ∧
      ∀ μ : Fin (N + 1),
        ∃ e_μ : (weilProjBasicOpen K N μ).toScheme ≅ (weilAffineSpaceOver K N).left,
          e_μ.hom ≫ (weilAffineSpaceOver K N).hom =
            (weilProjBasicOpen K N μ).ι ≫ (weilProjectiveSpaceOver K N).hom) ∧
    (∃ i_hyp : weilProjectiveSpaceOver K N ⟶ weilProjectiveSpaceOver K (N + 1),
      AlgebraicGeometry.IsClosedImmersion i_hyp.left ∧
      (weilProjBasicOpen K (N + 1) 0 : Set (weilProjectiveSpaceOver K (N + 1)).left) =
        (Set.range i_hyp.left.base)ᶜ) :=
by
  classical
  
  have hCovProj : ∀ M : ℕ,
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (⨆ μ : Fin (M + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)) = ⊤ := by
    intro M
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) K)) := by
      intro p hp
      have h0 : (((DirectSum.decompose 𝒜) p 0 : ↥(𝒜 0)) : MvPolynomial (Fin (M + 1)) K) = 0 := by
        have hp0 : GradedRing.proj 𝒜 0 p = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
        rwa [GradedRing.proj_apply] at hp0
      have hcoeff0 : (p : MvPolynomial (Fin (M + 1)) K).coeff 0 = 0 := by
        conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 p]
        rw [MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro n _
        by_cases hn : n = 0
        · subst hn
          simp [h0]
        · let qn : ↥(𝒜 n) := (DirectSum.decompose 𝒜) p n
          have hqn : MvPolynomial.IsHomogeneous qn.1 n :=
            (MvPolynomial.mem_homogeneousSubmodule n qn.1).mp qn.2
          by_contra hne
          have hdeg := hqn hne
          rw [map_zero] at hdeg
          exact hn hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd_ne : d ≠ 0 := by
        intro hd0
        subst hd0
        exact (MvPolynomial.mem_support_iff.mp hd) hcoeff0
      have hex_j : ∃ j : Fin (M + 1), d j ≠ 0 := by
        by_contra! hall0
        apply hd_ne
        ext j
        exact hall0 j
      obtain ⟨j, hj⟩ := hex_j
      exact ⟨j, Set.mem_univ j, hj⟩
    exact AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrel

  have hCov : ∀ M : ℕ, (⨆ μ : Fin (M + 1), weilProjBasicOpen K M μ) = ⊤ := fun M => hCovProj M

  
  have hCharts : ∀ μ : Fin (N + 1),
      ∃ e_μ : (weilProjBasicOpen K N μ).toScheme ≅ (weilAffineSpaceOver K N).left,
        e_μ.hom ≫ (weilAffineSpaceOver K N).hom =
          (weilProjBasicOpen K N μ).ι ≫ (weilProjectiveSpaceOver K N).hom := by
    intro μ
    let P := MvPolynomial (Fin (N + 1)) K
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    let X_μ : P := MvPolynomial.X μ
    have hX_mem : ∀ r : Fin (N + 1), (MvPolynomial.X r : P) ∈ 𝒜_N 1 := fun r =>
      (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X r)).mpr
        (MvPolynomial.isHomogeneous_X K r)
    have hdeg : X_μ ∈ 𝒜_N 1 := hX_mem μ
    let τ := {b : Fin (N + 1) // b ≠ μ}
    let Pτ := MvPolynomial τ K
    let H_μ := HomogeneousLocalization.Away 𝒜_N X_μ
    let M_μ : Submonoid P := Submonoid.powers X_μ
    have hpow_mem : ∀ n : ℕ, X_μ ^ n ∈ M_μ := fun n =>
      pow_mem (Submonoid.mem_powers X_μ) n
    let ι_K : K →+* H_μ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_N M_μ).comp (algebraMap K ↥(𝒜_N 0))
    have hι_val : ∀ c : K, (ι_K c).val = Localization.mk (MvPolynomial.C c) (1 : M_μ) := by
      intro c
      change (HomogeneousLocalization.mk _).val = Localization.mk (MvPolynomial.C c) (1 : M_μ)
      rw [HomogeneousLocalization.val_mk]
      rfl
    let u : τ → H_μ := fun b =>
      HomogeneousLocalization.mk
        { deg := 1
          num := ⟨MvPolynomial.X b.1, hX_mem b.1⟩
          den := ⟨X_μ, hdeg⟩
          den_mem := Submonoid.mem_powers X_μ }
    let α_sub : Pτ →+* H_μ := MvPolynomial.eval₂Hom ι_K u
    let w : Fin (N + 1) → Pτ := fun j =>
      if h : j = μ then 1 else MvPolynomial.X ⟨j, h⟩
    let dehom : P →+* Pτ := MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_Xμ : dehom X_μ = 1 := by
      dsimp [dehom, X_μ, w]
      rw [MvPolynomial.eval₂Hom_X']
      simp only [↓reduceDIte]
    have hdehom_mem : ∀ y : M_μ, dehom y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      simp [map_pow, hdehom_Xμ]
    have hUnit : ∀ y : M_μ, IsUnit (dehom y.1) := by
      intro y
      rw [hdehom_mem y]
      exact isUnit_one
    let β_loc : Localization M_μ →+* Pτ := IsLocalization.lift hUnit
    have hβ_loc_mk : ∀ (p : P) (y : M_μ), β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit p (dehom p) y).mpr
        (by rw [hdehom_mem y, one_mul])
    let valHom : H_μ →+* Localization M_μ :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun x y => HomogeneousLocalization.val_mul x y
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun x y => HomogeneousLocalization.val_add x y }
    let β_sub : H_μ →+* Pτ := β_loc.comp valHom
    have h_left : ∀ q : Pτ, β_sub (α_sub q) = q := by
      have hcomp : β_sub.comp α_sub = RingHom.id Pτ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change β_loc (α_sub (MvPolynomial.C c)).val = MvPolynomial.C c
          dsimp [α_sub]
          rw [MvPolynomial.eval₂Hom_C, hι_val c, hβ_loc_mk]
          dsimp [dehom]
          rw [MvPolynomial.eval₂Hom_C]
        · intro b
          change β_loc (α_sub (MvPolynomial.X b)).val = MvPolynomial.X b
          dsimp [α_sub]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp [u]
          rw [hβ_loc_mk]
          dsimp [dehom, w]
          rw [MvPolynomial.eval₂Hom_X']
          simp only [b.2, ↓reduceDIte]
          rfl
      intro q
      exact RingHom.congr_fun hcomp q
    let φ : P →+* Localization M_μ := valHom.comp (α_sub.comp dehom)
    have hφ_C : ∀ c : K, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) (1 : M_μ) := by
      intro c
      change (α_sub (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) (1 : M_μ)
      dsimp [dehom, α_sub]
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      exact hι_val c
    have hφ_X : ∀ j : Fin (N + 1),
        φ (MvPolynomial.X j) =
          Localization.mk (MvPolynomial.X j) (⟨X_μ, Submonoid.mem_powers X_μ⟩ : M_μ) := by
      intro j
      change (α_sub (dehom (MvPolynomial.X j))).val =
        Localization.mk (MvPolynomial.X j) (⟨X_μ, Submonoid.mem_powers X_μ⟩ : M_μ)
      dsimp [dehom]
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [w]
      by_cases hj : j = μ
      · simp only [hj, ↓reduceDIte, map_one, HomogeneousLocalization.val_one]
        exact (Localization.mk_self (⟨X_μ, Submonoid.mem_powers X_μ⟩ : M_μ)).symm
      · simp only [hj, ↓reduceDIte]
        dsimp [α_sub]
        rw [MvPolynomial.eval₂Hom_X']
        dsimp [u]
    have hφ_prod : ∀ (s_fin : Finset (Fin (N + 1))) (d : Fin (N + 1) →₀ ℕ),
        φ (∏ j ∈ s_fin, (MvPolynomial.X j : P) ^ d j) =
          Localization.mk (∏ j ∈ s_fin, (MvPolynomial.X j : P) ^ d j)
            ⟨X_μ ^ (∑ j ∈ s_fin, d j), hpow_mem (∑ j ∈ s_fin, d j)⟩ := by
      intro s_fin d
      induction s_fin using Finset.induction_on with
      | empty =>
        simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
        exact (Localization.mk_self (1 : M_μ)).symm
      | @insert j s_fin hj ih =>
        rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
          Localization.mk_pow, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        change X_μ ^ d j * X_μ ^ (∑ r ∈ s_fin, d r) = X_μ ^ (d j + ∑ r ∈ s_fin, d r)
        rw [← pow_add]
    have hφ_monomial : ∀ (d : Fin (N + 1) →₀ ℕ) (c : K) (n : ℕ),
        (Finsupp.weight 1) d = n →
        φ (MvPolynomial.monomial d c) =
          Localization.mk (MvPolynomial.monomial d c) ⟨X_μ ^ n, hpow_mem n⟩ := by
      intro d c n hdn
      have hsum : ∑ j ∈ d.support, d j = n := by
        have hw : (Finsupp.weight (1 : Fin (N + 1) → ℕ)) d = ∑ j ∈ d.support, d j := by
          simp [Finsupp.weight_apply, Finsupp.sum]
        exact hw.symm.trans hdn
      rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C c, hφ_prod d.support d,
        Localization.mk_mul]
      congr 1
      apply Subtype.ext
      change (1 : P) * X_μ ^ (∑ j ∈ d.support, d j) = X_μ ^ n
      rw [one_mul, hsum]
    have hφ_homog : ∀ (n : ℕ) (p : P), p.IsHomogeneous n →
        φ p = Localization.mk p ⟨X_μ ^ n, hpow_mem n⟩ := by
      intro n p hp
      have h_sum_aux : ∀ (S_fin : Finset (Fin (N + 1) →₀ ℕ)),
          (∀ d ∈ S_fin, (Finsupp.weight 1) d = n) →
          φ (∑ d ∈ S_fin, MvPolynomial.monomial d ((p : MvPolynomial (Fin (N + 1)) K).coeff d)) =
            Localization.mk
              (∑ d ∈ S_fin, MvPolynomial.monomial d ((p : MvPolynomial (Fin (N + 1)) K).coeff d))
              ⟨X_μ ^ n, hpow_mem n⟩ := by
        intro S_fin hS
        induction S_fin using Finset.induction_on with
        | empty =>
          simp [Localization.mk_zero]
        | @insert d S_fin hd ih =>
          rw [Finset.sum_insert hd, map_add,
            hφ_monomial d ((p : MvPolynomial (Fin (N + 1)) K).coeff d) n
              (hS d (Finset.mem_insert_self d S_fin)),
            ih (fun d' hd' => hS d' (Finset.mem_insert_of_mem hd')),
            Localization.add_mk_self]
      conv_lhs => rw [MvPolynomial.as_sum p]
      conv_rhs => rw [MvPolynomial.as_sum p]
      exact h_sum_aux p.support (fun d hd => hp (MvPolynomial.mem_support_iff.mp hd))
    have h_right : ∀ z : H_μ, α_sub (β_sub z) = z := by
      intro z
      obtain ⟨n, g, hg, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_N hdeg z
      apply HomogeneousLocalization.val_injective
      have hg_homog : g.IsHomogeneous n := by
        have hn1 : n • (1 : ℕ) = n := by simp
        exact (MvPolynomial.mem_homogeneousSubmodule n g).mp (hn1 ▸ hg)
      change valHom (α_sub (β_sub (HomogeneousLocalization.Away.mk 𝒜_N hdeg n g hg))) =
        (HomogeneousLocalization.Away.mk 𝒜_N hdeg n g hg).val
      simp only [β_sub, RingHom.comp_apply, valHom, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
      rw [HomogeneousLocalization.Away.val_mk, hβ_loc_mk]
      change φ g = _
      rw [hφ_homog n g hg_homog]
    let e_sub : Pτ ≃+* H_μ :=
      { α_sub with
        invFun := β_sub
        left_inv := h_left
        right_inv := h_right }
    let e_ring : MvPolynomial (Fin N) K ≃+* H_μ :=
      ((MvPolynomial.renameEquiv K (finSuccAboveEquiv μ)).toRingEquiv).trans e_sub
    have he_C : ∀ c : K, e_ring (MvPolynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom 𝒜_N M_μ (algebraMap K ↥(𝒜_N 0) c) := by
      intro c
      simp only [e_ring, RingEquiv.trans_apply, AlgEquiv.coe_ringEquiv,
        MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
      change α_sub (MvPolynomial.C c) = _
      dsimp [α_sub, ι_K]
      rw [MvPolynomial.eval₂Hom_C]
      rfl
    let e_basic : (weilProjBasicOpen K N μ).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of H_μ) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N X_μ hdeg Nat.zero_lt_one
    let e_spec : AlgebraicGeometry.Spec (CommRingCat.of H_μ) ≅ (weilAffineSpaceOver K N).left :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.symm.toRingHom)
        hom_inv_id := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.symm.toRingHom) = 𝟙 _
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_ring.toRingHom.comp e_ring.symm.toRingHom = RingHom.id H_μ :=
            RingHom.ext e_ring.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom) = 𝟙 _
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_ring.symm.toRingHom.comp e_ring.toRingHom =
              RingHom.id (MvPolynomial (Fin N) K) :=
            RingHom.ext e_ring.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    refine ⟨e_basic ≪≫ e_spec, ?_⟩
    rw [← CategoryTheory.cancel_epi e_basic.inv]
    have hlhs : e_basic.inv ≫ ((e_basic ≪≫ e_spec).hom ≫ (weilAffineSpaceOver K N).hom) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin N) K)) ≫
            CommRingCat.ofHom e_ring.toRingHom) := by
      change e_basic.inv ≫
        (e_basic.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin N) K))) = _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
        ← AlgebraicGeometry.Spec.map_comp]
    have hrhs : e_basic.inv ≫ ((weilProjBasicOpen K N μ).ι ≫ (weilProjectiveSpaceOver K N).hom) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K ↥(𝒜_N 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_N M_μ)) := by
      dsimp only [e_basic, weilProjBasicOpen, weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp]
    rw [hlhs, hrhs]
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact he_C c

  
  refine ⟨⟨hCov N, hCharts⟩, ?_⟩
  let 𝒜_succ := MvPolynomial.homogeneousSubmodule (Fin (N + 1 + 1)) K
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
  let _ : GradedAlgebra 𝒜_succ := MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let v_hyp : Fin (N + 1 + 1) → MvPolynomial (Fin (N + 1)) K :=
    Fin.cases 0 (fun a => MvPolynomial.X a)
  let Φ_ring : MvPolynomial (Fin (N + 1 + 1)) K →+* MvPolynomial (Fin (N + 1)) K :=
    MvPolynomial.eval₂Hom MvPolynomial.C v_hyp
  have hΦ_mem : ∀ {i : ℕ} {p : MvPolynomial (Fin (N + 1 + 1)) K},
      p ∈ 𝒜_succ i → Φ_ring p ∈ 𝒜_N i := by
    intro i p hp
    rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
    change (MvPolynomial.eval₂ MvPolynomial.C v_hyp p).IsHomogeneous i
    rw [← one_mul i]
    refine MvPolynomial.IsHomogeneous.eval₂ hp MvPolynomial.C v_hyp
      (fun r => MvPolynomial.isHomogeneous_C (Fin (N + 1)) r) ?_
    intro ν
    refine Fin.cases ?_ ?_ ν
    · exact MvPolynomial.isHomogeneous_zero (Fin (N + 1)) K 1
    · intro a
      exact MvPolynomial.isHomogeneous_X K a
  let Φ : 𝒜_succ →+*ᵍ 𝒜_N :=
    { toRingHom := Φ_ring
      map_mem := fun hp => hΦ_mem hp }
  have hΦ0 : Φ (MvPolynomial.X 0) = 0 := by
    change Φ_ring (MvPolynomial.X 0) = 0
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  have hΦs : ∀ a : Fin (N + 1), Φ (MvPolynomial.X a.succ) = MvPolynomial.X a := by
    intro a
    change Φ_ring (MvPolynomial.X a.succ) = MvPolynomial.X a
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  let ρ_lift : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin (N + 1 + 1)) K :=
    (MvPolynomial.rename (R := K) Fin.succ).toRingHom
  have hΦ_ρ : Φ_ring.comp ρ_lift = RingHom.id (MvPolynomial (Fin (N + 1)) K) := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      simp [Φ_ring, ρ_lift]
    · intro a
      simp [Φ_ring, ρ_lift, v_hyp]
  have h_irrel : HomogeneousIdeal.irrelevant 𝒜_N ≤
      HomogeneousIdeal.map Φ (HomogeneousIdeal.irrelevant 𝒜_succ) := by
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi q hq
    let r_q : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.rename Fin.succ q
    have hr_hom : r_q ∈ 𝒜_succ i :=
      (MvPolynomial.mem_homogeneousSubmodule i r_q).mpr
        (MvPolynomial.IsHomogeneous.rename_isHomogeneous
          ((MvPolynomial.mem_homogeneousSubmodule i q).mp hq))
    have hr_irrel : r_q ∈ (HomogeneousIdeal.irrelevant 𝒜_succ).toIdeal :=
      (HomogeneousIdeal.irrelevant_le 𝒜_succ).mp (le_refl _) i hi hr_hom
    have hΦ_rq : Φ r_q = q := RingHom.congr_fun hΦ_ρ q
    change q ∈ (HomogeneousIdeal.map Φ (HomogeneousIdeal.irrelevant 𝒜_succ)).toIdeal
    rw [HomogeneousIdeal.toIdeal_map, ← hΦ_rq]
    exact Ideal.mem_map_of_mem Φ.toRingHom hr_irrel

  have hX_succ_mem : ∀ μ : Fin (N + 1 + 1),
      (MvPolynomial.X μ : MvPolynomial (Fin (N + 1 + 1)) K) ∈ 𝒜_succ 1 := fun μ =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X μ)).mpr
      (MvPolynomial.isHomogeneous_X K μ)

  have hΦ_const : ∀ (a : Fin (N + 1)) (c : K),
      HomogeneousLocalization.Away.map Φ (MvPolynomial.X a.succ)
        (HomogeneousLocalization.fromZeroRingHom 𝒜_succ
          (Submonoid.powers (MvPolynomial.X a.succ))
          (algebraMap K ↥(𝒜_succ 0) c)) =
      HomogeneousLocalization.fromZeroRingHom 𝒜_N
        (Submonoid.powers (Φ (MvPolynomial.X a.succ)))
        (algebraMap K ↥(𝒜_N 0) c) := by
    intro a c
    let s_a : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.X a.succ
    have hs_a : s_a ∈ 𝒜_succ 1 := hX_succ_mem a.succ
    have hC_succ : (MvPolynomial.C c : MvPolynomial (Fin (N + 1 + 1)) K) ∈ 𝒜_succ ((0 : ℕ) • 1) := by
      rw [zero_smul, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_C (Fin (N + 1 + 1)) c
    have hlhs_eq : HomogeneousLocalization.fromZeroRingHom 𝒜_succ (Submonoid.powers s_a)
          (algebraMap K ↥(𝒜_succ 0) c) =
        HomogeneousLocalization.Away.mk 𝒜_succ hs_a 0 (MvPolynomial.C c) hC_succ := by
      apply HomogeneousLocalization.val_injective
      change (HomogeneousLocalization.mk _).val = _
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
      rfl
    rw [hlhs_eq, HomogeneousLocalization.Away.map_mk]
    apply HomogeneousLocalization.val_injective
    change _ = (HomogeneousLocalization.mk _).val
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk]
    have hΦC : Φ (MvPolynomial.C c) = MvPolynomial.C c := by
      change Φ_ring (MvPolynomial.C c) = MvPolynomial.C c
      rw [MvPolynomial.eval₂Hom_C]
    rw [hΦC]
    rfl

  have hΦ_surj : ∀ a : Fin (N + 1),
      Function.Surjective (HomogeneousLocalization.Away.map Φ (MvPolynomial.X a.succ)) := by
    intro a w
    let s_a : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.X a.succ
    have hs_a : s_a ∈ 𝒜_succ 1 := hX_succ_mem a.succ
    have hs'_a : Φ s_a ∈ 𝒜_N 1 := Φ.map_mem hs_a
    obtain ⟨n, q, hq, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_N hs'_a w
    let r_q : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.rename Fin.succ q
    have hr_q : r_q ∈ 𝒜_succ (n • 1) := by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hq ⊢
      exact MvPolynomial.IsHomogeneous.rename_isHomogeneous hq
    refine ⟨HomogeneousLocalization.Away.mk 𝒜_succ hs_a n r_q hr_q, ?_⟩
    rw [HomogeneousLocalization.Away.map_mk]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
    have hΦ_rq : Φ r_q = q := RingHom.congr_fun hΦ_ρ q
    rw [hΦ_rq]

  have hΦ_ker : ∀ (a : Fin (N + 1))
      (z : HomogeneousLocalization.Away 𝒜_succ (MvPolynomial.X a.succ)),
      HomogeneousLocalization.Away.map Φ (MvPolynomial.X a.succ) z = 0 →
      HomogeneousLocalization.Away.isLocalizationElem
        (hX_succ_mem a.succ) (hX_succ_mem 0) ∣ z := by
    intro a z hz
    let s_a : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.X a.succ
    have hs_a : s_a ∈ 𝒜_succ 1 := hX_succ_mem a.succ
    have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1 + 1)) K) ∈ 𝒜_succ 1 := hX_succ_mem 0
    let t₀ := HomogeneousLocalization.Away.isLocalizationElem hs_a hX0
    obtain ⟨d, G, hG, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_succ hs_a z
    rw [HomogeneousLocalization.Away.map_mk] at hz
    have hz_val := congrArg HomogeneousLocalization.val hz
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
      Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hz_val
    obtain ⟨⟨u, k, rfl⟩, huG⟩ := hz_val
    have hXa_ne : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ≠ 0 := by
      intro h0
      have hev := congrArg (MvPolynomial.eval (fun _ : Fin (N + 1) => (1 : K))) h0
      simp at hev
    have hu_ne : (Φ s_a) ^ k ≠ 0 := by
      change (Φ (MvPolynomial.X a.succ)) ^ k ≠ 0
      rw [hΦs a]
      exact pow_ne_zero k hXa_ne
    have hΦG : Φ G = 0 := (mul_eq_zero.mp huG).resolve_left hu_ne
    by_cases hG0 : G = 0
    · refine ⟨0, ?_⟩
      rw [mul_zero]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero, hG0,
        Localization.mk_zero]
    · let e_succ := MvPolynomial.finSuccEquiv K (N + 1)
      have hev_eq : (Polynomial.evalRingHom 0).comp e_succ.toRingHom = Φ_ring := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp [e_succ, MvPolynomial.finSuccEquiv_apply, Φ_ring]
        · intro ν
          refine Fin.cases ?_ ?_ ν
          · simp [e_succ, MvPolynomial.finSuccEquiv_X_zero, Φ_ring, v_hyp]
          · intro b
            simp [e_succ, MvPolynomial.finSuccEquiv_X_succ, Φ_ring, v_hyp]
      have hcoeff0_G : (e_succ G).coeff 0 = 0 := by
        rw [Polynomial.coeff_zero_eq_eval_zero]
        change ((Polynomial.evalRingHom 0).comp e_succ.toRingHom) G = 0
        rw [hev_eq]
        exact hΦG
      obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_iff.mpr hcoeff0_G
      let H : MvPolynomial (Fin (N + 1 + 1)) K := e_succ.symm Q
      have hG_mul : G = MvPolynomial.X 0 * H := by
        apply e_succ.injective
        rw [map_mul, MvPolynomial.finSuccEquiv_X_zero, e_succ.apply_symm_apply, hQ]
      have hH_ne : H ≠ 0 := fun h0 => hG0 (by rw [hG_mul, h0, mul_zero])
      have hex_e₀ : ∃ e₀ : Fin (N + 1 + 1) →₀ ℕ, H.coeff e₀ ≠ 0 := by
        by_contra! hall0
        apply hH_ne
        ext e₀
        simpa using hall0 e₀
      obtain ⟨e₀, he₀⟩ := hex_e₀
      have hG_hom : G.IsHomogeneous d := by
        have hd1 : d • (1 : ℕ) = d := by simp
        exact (MvPolynomial.mem_homogeneousSubmodule d G).mp (hd1 ▸ hG)
      have h_wt : ∀ e : Fin (N + 1 + 1) →₀ ℕ, H.coeff e ≠ 0 →
          1 + (Finsupp.weight 1) e = d := by
        intro e he
        have hce : G.coeff (Finsupp.single 0 1 + e) ≠ 0 := by
          rw [hG_mul, MvPolynomial.coeff_X_mul]
          exact he
        have hw := hG_hom hce
        rw [map_add] at hw
        have hw0 : (Finsupp.weight (1 : Fin (N + 1 + 1) → ℕ)) (Finsupp.single 0 1) = 1 := by
          simp [Finsupp.weight_apply]
        rwa [hw0] at hw
      have hd_pos : 1 ≤ d := by
        have h0 := h_wt e₀ he₀
        omega
      have hH_hom : H.IsHomogeneous (d - 1) := by
        intro e he
        have h1 := h_wt e he
        omega
      have hH_mem : H ∈ 𝒜_succ ((d - 1) • 1) := by
        have hd1 : (d - 1) • (1 : ℕ) = d - 1 := by simp
        rw [hd1, MvPolynomial.mem_homogeneousSubmodule]
        exact hH_hom
      let q_z := HomogeneousLocalization.Away.mk 𝒜_succ hs_a (d - 1) H hH_mem
      refine ⟨q_z, ?_⟩
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk]
      change Localization.mk G _ = t₀.val * Localization.mk H _
      dsimp only [t₀, HomogeneousLocalization.Away.isLocalizationElem]
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
      congr 1
      · rw [pow_one, ← hG_mul]
      · apply Subtype.ext
        change s_a ^ d = s_a ^ 1 * s_a ^ (d - 1)
        rw [← pow_add, Nat.add_sub_of_le hd_pos]

  
  let P_succ := AlgebraicGeometry.Proj 𝒜_succ
  let P_N := AlgebraicGeometry.Proj 𝒜_N
  let i_left : P_N ⟶ P_succ := AlgebraicGeometry.Proj.map Φ h_irrel
  have h_over : i_left ≫ (weilProjectiveSpaceOver K (N + 1)).hom =
      (weilProjectiveSpaceOver K N).hom := by
    apply AlgebraicGeometry.Scheme.hom_ext_of_forall
    intro y
    have hCov_N : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X a)) = ⊤ :=
      hCovProj N
    have hy_top : y ∈ (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X a)) := by
      rw [hCov_N]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hy_top
    obtain ⟨a, ha⟩ := hy_top
    let s_a : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.X a.succ
    have hs_a : s_a ∈ 𝒜_succ 1 := hX_succ_mem a.succ
    have hs'_a : Φ s_a ∈ 𝒜_N 1 := Φ.map_mem hs_a
    let U'_a : P_N.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ s_a)
    have hy_U' : y ∈ U'_a := by
      change y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ (MvPolynomial.X a.succ))
      rw [hΦs a]
      exact ha
    refine ⟨U'_a, hy_U', ?_⟩
    let e_Ua := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ s_a) hs'_a Nat.zero_lt_one
    rw [← CategoryTheory.cancel_epi e_Ua.inv]
    dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
    have hlhs : e_Ua.inv ≫ (U'_a.ι ≫ (i_left ≫ (AlgebraicGeometry.Proj.toSpecZero 𝒜_succ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜_succ 0)))))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K ↥(𝒜_succ 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_succ (Submonoid.powers s_a)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.Away.map Φ s_a)) := by
      rw [← CategoryTheory.Category.assoc e_Ua.inv U'_a.ι,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜_N (Φ s_a) hs'_a Nat.zero_lt_one) i_left,
        AlgebraicGeometry.Proj.awayι_comp_map Φ h_irrel Nat.zero_lt_one s_a hs_a,
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc]
    have hrhs : e_Ua.inv ≫ (U'_a.ι ≫ (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜_N 0))))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K ↥(𝒜_N 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (Φ s_a)))) := by
      rw [← CategoryTheory.Category.assoc e_Ua.inv U'_a.ι,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp]
    rw [hlhs, hrhs]
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact hΦ_const a c

  let D : Fin (N + 1 + 1) → P_succ.Opens :=
    fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜_succ (MvPolynomial.X μ)
  have hCov_D : (⨆ μ : Fin (N + 1 + 1), D μ) = ⊤ := hCovProj (N + 1)
  have h_pre_0 : (i_left ⁻¹ᵁ D 0) = ⊥ := by
    change (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.map Φ h_irrel).base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_succ (MvPolynomial.X 0)) = ⊥
    rw [AlgebraicGeometry.Proj.map_preimage_basicOpen Φ h_irrel (MvPolynomial.X 0),
      hΦ0, AlgebraicGeometry.Proj.basicOpen_zero]

  have h_cl : AlgebraicGeometry.IsClosedImmersion i_left := by
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.IsClosedImmersion) D hCov_D]
    intro μ
    refine Fin.cases ?_ ?_ μ
    · have hEmp : IsEmpty ↥((i_left ⁻¹ᵁ D 0).toScheme) :=
        ⟨fun ⟨_, hx⟩ => by rw [h_pre_0] at hx; exact hx⟩
      exact @AlgebraicGeometry.IsClosedImmersion.instOfIsEmptyCarrierCarrierCommRingCat
        _ _ hEmp (i_left ∣_ D 0)
    · intro a
      let s_a : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.X a.succ
      have hs_a : s_a ∈ 𝒜_succ 1 := hX_succ_mem a.succ
      have hs'_a : Φ s_a ∈ 𝒜_N 1 := Φ.map_mem hs_a
      have h_eq_a : (i_left ⁻¹ᵁ D a.succ) = AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ s_a) :=
        AlgebraicGeometry.Proj.map_preimage_basicOpen Φ h_irrel s_a
      let e₁ : (i_left ⁻¹ᵁ D a.succ).toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (Φ s_a))) :=
        P_N.isoOfEq h_eq_a ≪≫
          AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ s_a) hs'_a Nat.zero_lt_one
      let e₀ : (D a.succ).toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_succ s_a)) :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_succ s_a hs_a Nat.zero_lt_one
      let f_spec := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (HomogeneousLocalization.Away.map Φ s_a))
      have h_res_eq : (i_left ∣_ D a.succ) = e₁.hom ≫ f_spec ≫ e₀.inv := by
        rw [← CategoryTheory.cancel_mono (D a.succ).ι, ← CategoryTheory.cancel_epi e₁.inv]
        have hlhs : e₁.inv ≫ ((i_left ∣_ D a.succ) ≫ (D a.succ).ι) =
            f_spec ≫ AlgebraicGeometry.Proj.awayι 𝒜_succ s_a hs_a Nat.zero_lt_one := by
          rw [AlgebraicGeometry.morphismRestrict_ι]
          change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ s_a) hs'_a Nat.zero_lt_one).inv ≫
              (P_N.isoOfEq h_eq_a).inv) ≫
            ((i_left ⁻¹ᵁ D a.succ).ι ≫ i_left) = _
          rw [CategoryTheory.Category.assoc
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (Φ s_a) hs'_a Nat.zero_lt_one).inv,
            ← CategoryTheory.Category.assoc (P_N.isoOfEq h_eq_a).inv,
            AlgebraicGeometry.Scheme.isoOfEq_inv_ι,
            ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
            AlgebraicGeometry.Proj.awayι_comp_map Φ h_irrel Nat.zero_lt_one s_a hs_a]
        have hrhs : e₁.inv ≫ ((e₁.hom ≫ f_spec ≫ e₀.inv) ≫ (D a.succ).ι) =
            f_spec ≫ AlgebraicGeometry.Proj.awayι 𝒜_succ s_a hs_a Nat.zero_lt_one := by
          rw [← CategoryTheory.Category.assoc e₁.inv, ← CategoryTheory.Category.assoc e₁.inv,
            e₁.inv_hom_id, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
        exact hlhs.trans hrhs.symm
      have hf_spec : AlgebraicGeometry.IsClosedImmersion f_spec :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map Φ s_a)) (hΦ_surj a)
      have he₁_cl : AlgebraicGeometry.IsClosedImmersion e₁.hom := inferInstance
      have he₀_cl : AlgebraicGeometry.IsClosedImmersion e₀.inv := inferInstance
      rw [h_res_eq]
      exact @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ e₁.hom (f_spec ≫ e₀.inv) he₁_cl
        (@AlgebraicGeometry.IsClosedImmersion.comp _ _ _ f_spec e₀.inv hf_spec he₀_cl)

  have h_compl : (D 0 : Set P_succ) = (Set.range i_left.base)ᶜ := by
    ext x
    rw [Set.mem_compl_iff]
    constructor
    · rintro hx0 ⟨y, hy_eq⟩
      rw [← hy_eq] at hx0
      have hy : y ∈ (i_left ⁻¹ᵁ D 0) := hx0
      rw [h_pre_0] at hy
      exact hy
    · intro hx_nrange
      by_contra hx_n0
      have hx_top : x ∈ (⨆ μ : Fin (N + 1 + 1), D μ) := by
        rw [hCov_D]
        trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hx_top
      obtain ⟨μ, hμ⟩ := hx_top
      revert hμ
      refine Fin.cases ?_ ?_ μ
      · intro h0
        exact hx_n0 h0
      · intro a ha
        let s_a : MvPolynomial (Fin (N + 1 + 1)) K := MvPolynomial.X a.succ
        have hs_a : s_a ∈ 𝒜_succ 1 := hX_succ_mem a.succ
        have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1 + 1)) K) ∈ 𝒜_succ 1 :=
          hX_succ_mem 0
        have hs'_a : Φ s_a ∈ 𝒜_N 1 := Φ.map_mem hs_a
        let ψ_a := HomogeneousLocalization.Away.map Φ s_a
        let j_succ := AlgebraicGeometry.Proj.awayι 𝒜_succ s_a hs_a Nat.zero_lt_one
        have hx_range_j : x ∈ j_succ.opensRange := by
          dsimp only [j_succ]
          rw [AlgebraicGeometry.Proj.opensRange_awayι]
          exact ha
        obtain ⟨p, hp⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hx_range_j
        have h_pre_j : (TopologicalSpace.Opens.map j_succ.base).obj (D 0) =
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hs_a hX0) :=
          AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_succ hs_a Nat.zero_lt_one hX0 Nat.zero_lt_one
        have ht0_mem : HomogeneousLocalization.Away.isLocalizationElem hs_a hX0 ∈ p.asIdeal := by
          by_contra ht0_nmem
          have hp_basic : (p : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_succ s_a)) ∈
              PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hs_a hX0) :=
            (PrimeSpectrum.mem_basicOpen _ p).mpr ht0_nmem
          have hp0 : p ∈ (TopologicalSpace.Opens.map j_succ.base).obj (D 0) := by
            rw [h_pre_j]
            exact hp_basic
          apply hx_n0
          rw [← hp]
          exact hp0
        let p' : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_succ s_a) := p
        have hp_zero : p' ∈ PrimeSpectrum.zeroLocus (RingHom.ker ψ_a : Set _) :=
          (PrimeSpectrum.mem_zeroLocus p' (RingHom.ker ψ_a : Set _)).mpr fun z hz => by
            obtain ⟨q_z, rfl⟩ := hΦ_ker a z hz
            exact Ideal.mul_mem_right q_z p'.asIdeal ht0_mem
        have h_range_comap := @range_comap_of_surjective _
          (HomogeneousLocalization.Away 𝒜_N (Φ s_a)) _ _ ψ_a (hΦ_surj a)
        rw [← h_range_comap] at hp_zero
        obtain ⟨q, hq⟩ := hp_zero
        let q_spec : ↥(AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (Φ s_a)))) := q
        let y : P_N :=
          (AlgebraicGeometry.Proj.awayι 𝒜_N (Φ s_a) hs'_a Nat.zero_lt_one).base q_spec
        have hcomm : i_left.base y =
            j_succ.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_a)).base q_spec) :=
          congrArg (fun f => f.base q_spec)
            (AlgebraicGeometry.Proj.awayι_comp_map Φ h_irrel Nat.zero_lt_one s_a hs_a)
        have hmap_q : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_a)).base q_spec = p :=
          (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ψ_a) q_spec).trans hq
        exact hx_nrange ⟨y, hcomm.trans ((congrArg j_succ.base hmap_q).trans hp)⟩

  let i_hyp : weilProjectiveSpaceOver K N ⟶ weilProjectiveSpaceOver K (N + 1) :=
    CategoryTheory.Over.homMk i_left h_over
  exact ⟨i_hyp, h_cl, h_compl⟩

theorem weil_quad_cvs_smooth_slice_partner_elim_and_overlaps (Ω : Type u) [Field Ω]
    (m : ℕ) (c_0 : Ω) (hc_0 : c_0 ≠ 0)
    (Q_amb Q_sm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (ι_amb : Q_amb.left ⟶ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left)
    (hι_amb : ι_amb ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb.hom)
    (i_sm : Q_sm ⟶ Q_amb) :
    let F_amb : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω :=
      ∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    let C : Fin (2 * m + 2) → Q_sm.left.Opens :=
      fun a => (TopologicalSpace.Opens.map (i_sm.left ≫ ι_amb).base).obj
        (weilProjBasicOpen Ω (2 * (m + 1) + 1) a.succ.succ)
    IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 2
      (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))) F_amb ι_amb →
    IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 1
      (CategoryTheory.Over.homMk ι_amb hι_amb)
      (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1) i_sm.left →
    (⨆ a : Fin (2 * m + 2), C a) = ⊤ ∧
    (∀ a : Fin (2 * m + 2),
      ∃ e_a : (C a).toScheme ≅ (weilAffineSpaceOver Ω (2 * m + 1)).left,
        e_a.hom ≫ (weilAffineSpaceOver Ω (2 * m + 1)).hom = (C a).ι ≫ Q_sm.hom) ∧
    (∀ a : Fin (2 * m + 2), Nonempty ↥(C ⟨0, by omega⟩ ⊓ C a)) :=
by
  intro F_amb C hSplit_amb hSplit_sm
  let A_amb := MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) Ω
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let L_hyp : A_amb := MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1
  rcases hSplit_amb with ⟨hCl_amb, hF, _, hKer_amb⟩
  rcases hSplit_sm with ⟨hCl_sm, hL, _, hKer_sm⟩
  let P_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let P_hom : P_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)))
  let f₁ : Q_amb.left ⟶ P_sch := ι_amb
  let f_ci : Q_sm.left ⟶ P_sch := i_sm.left ≫ f₁
  haveI : AlgebraicGeometry.IsClosedImmersion f₁ := hCl_amb
  haveI : AlgebraicGeometry.IsClosedImmersion i_sm.left := hCl_sm
  haveI : AlgebraicGeometry.IsClosedImmersion f_ci := inferInstance
  have hf_ci_hom : f_ci ≫ P_hom = Q_sm.hom := by
    change (i_sm.left ≫ ι_amb) ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_sm.hom
    rw [CategoryTheory.Category.assoc, hι_amb, i_sm.w]
  let D : Fin (2 * (m + 1) + 1 + 1) → P_sch.Opens :=
    fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)
  let W₁ : Fin (2 * (m + 1) + 1 + 1) → Q_amb.left.Opens :=
    fun μ => (TopologicalSpace.Opens.map f₁.base).obj (D μ)
  let C' : Fin (2 * (m + 1) + 1 + 1) → Q_sm.left.Opens :=
    fun μ => (TopologicalSpace.Opens.map f_ci.base).obj (D μ)

  have hX : ∀ μ : Fin (2 * (m + 1) + 1 + 1), (MvPolynomial.X μ : A_amb) ∈ 𝒜 1 :=
    fun μ => (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X μ)).mpr
      (MvPolynomial.isHomogeneous_X Ω μ)
  have hX_smul1 : ∀ μ : Fin (2 * (m + 1) + 1 + 1), (MvPolynomial.X μ : A_amb) ∈ 𝒜 ((1 : ℕ) • 1) := by
    intro μ
    simpa using hX μ
  have hC_smul0 : ∀ c : Ω, (MvPolynomial.C c : A_amb) ∈ 𝒜 ((0 : ℕ) • 1) := by
    intro c
    have hc0 : (MvPolynomial.C c : A_amb) ∈ 𝒜 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 (MvPolynomial.C c)).mpr
        (MvPolynomial.isHomogeneous_C _ c)
    simpa using hc0
  have hCX_smul1 : ∀ (c : Ω) (ν : Fin (2 * (m + 1) + 1 + 1)),
      (MvPolynomial.C c * MvPolynomial.X ν : A_amb) ∈ 𝒜 ((1 : ℕ) • 1) := by
    intro c ν
    have hmul : MvPolynomial.IsHomogeneous (MvPolynomial.C c * MvPolynomial.X ν : A_amb) (0 + 1) :=
      (MvPolynomial.isHomogeneous_C _ c).mul (MvPolynomial.isHomogeneous_X Ω ν)
    have hmem : (MvPolynomial.C c * MvPolynomial.X ν : A_amb) ∈ 𝒜 (0 + 1) :=
      (MvPolynomial.mem_homogeneousSubmodule (0 + 1) _).mpr hmul
    simpa using hmem
  have halg0_val : ∀ c : Ω, (algebraMap Ω ↥(𝒜 0) c).1 = MvPolynomial.C c := by
    intro c
    rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
      Algebra.smul_def, mul_one]
    rfl
  have helem_eq : ∀ μ ν : Fin (2 * (m + 1) + 1 + 1),
      HomogeneousLocalization.Away.isLocalizationElem (hX μ) (hX ν) =
        HomogeneousLocalization.Away.mk 𝒜 (hX μ) 1 (MvPolynomial.X ν) (hX_smul1 ν) := by
    intro μ ν
    rw [HomogeneousLocalization.ext_iff_val]
    change Localization.mk (MvPolynomial.X ν ^ 1) ⟨MvPolynomial.X μ ^ 1, _⟩ =
      Localization.mk (MvPolynomial.X ν) ⟨MvPolynomial.X μ ^ 1, _⟩
    simp [pow_one]
  have hmk_mul : ∀ (μ : Fin (2 * (m + 1) + 1 + 1)) (d : ℕ) (G : A_amb) (hG : G ∈ 𝒜 (d • 1)),
      (algebraMap A_amb (Localization (Submonoid.powers (MvPolynomial.X μ : A_amb)))
          (MvPolynomial.X μ)) ^ d *
        algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ))
          (Localization (Submonoid.powers (MvPolynomial.X μ : A_amb)))
          (HomogeneousLocalization.Away.mk 𝒜 (hX μ) d G hG) =
        algebraMap A_amb (Localization (Submonoid.powers (MvPolynomial.X μ : A_amb))) G := by
    intro μ d G hG
    let L_μ := Localization (Submonoid.powers (MvPolynomial.X μ : A_amb))
    let s_d : Submonoid.powers (MvPolynomial.X μ : A_amb) :=
      ⟨MvPolynomial.X μ ^ d, (Submonoid.powers (MvPolynomial.X μ : A_amb)).pow_mem
        (Submonoid.mem_powers _) d⟩
    have hspec :
        algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ)) L_μ
            (HomogeneousLocalization.Away.mk 𝒜 (hX μ) d G hG) *
          (algebraMap A_amb L_μ (MvPolynomial.X μ)) ^ d =
        algebraMap A_amb L_μ G := by
      rw [HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      have hpow : (algebraMap A_amb L_μ (MvPolynomial.X μ)) ^ d = algebraMap A_amb L_μ s_d.1 :=
        (map_pow _ _ d).symm
      rw [hpow]
      exact IsLocalization.mk'_spec L_μ G s_d
    exact (mul_comm _ _).trans hspec

  
  let ν_even : Fin (m + 1) → Fin (2 * (m + 1) + 1 + 1) :=
    fun j => (⟨2 * j.1, by omega⟩ : Fin (2 * m + 2)).succ.succ
  let ν_odd : Fin (m + 1) → Fin (2 * (m + 1) + 1 + 1) :=
    fun j => (⟨2 * j.1 + 1, by omega⟩ : Fin (2 * m + 2)).succ.succ
  have h1_val : (1 : Fin (2 * (m + 1) + 1 + 1)).1 = 1 := by
    change 1 % (2 * (m + 1) + 1 + 1) = 1
    exact Nat.mod_eq_of_lt (by omega)
  have hF_amb_eq :
      F_amb =
        (∑ j : Fin (m + 1),
          (MvPolynomial.X (ν_even j) : A_amb) * MvPolynomial.X (ν_odd j)) +
        MvPolynomial.X 0 * MvPolynomial.X 1 := by
    dsimp only [F_amb]
    rw [Finset.sum_range_succ', ← Fin.sum_univ_eq_sum_range]
    have hsum_eq :
        (∑ j : Fin (m + 1),
          if h : 2 * (j.1 + 1) + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * (j.1 + 1), Nat.lt_of_succ_lt h⟩ : A_amb) *
              MvPolynomial.X ⟨2 * (j.1 + 1) + 1, h⟩
          else 0) =
        ∑ j : Fin (m + 1),
          (MvPolynomial.X (ν_even j) : A_amb) * MvPolynomial.X (ν_odd j) := by
      refine Finset.sum_congr rfl fun j _ => ?_
      have hj_lt : 2 * (j.1 + 1) + 1 < 2 * (m + 1) + 1 + 1 := by omega
      rw [dif_pos hj_lt]
      have hev_eq : (⟨2 * (j.1 + 1), Nat.lt_of_succ_lt hj_lt⟩ : Fin (2 * (m + 1) + 1 + 1)) =
          ν_even j := by
        ext
        change 2 * (j.1 + 1) = 2 * j.1 + 2
        omega
      have hod_eq : (⟨2 * (j.1 + 1) + 1, hj_lt⟩ : Fin (2 * (m + 1) + 1 + 1)) =
          ν_odd j := by
        ext
        change 2 * (j.1 + 1) + 1 = (2 * j.1 + 1) + 2
        omega
      rw [hev_eq, hod_eq]
    have h0_term :
        (if h : 2 * 0 + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * 0, Nat.lt_of_succ_lt h⟩ : A_amb) *
            MvPolynomial.X ⟨2 * 0 + 1, h⟩
        else 0) = MvPolynomial.X 0 * MvPolynomial.X 1 := by
      have h0_lt : 2 * 0 + 1 < 2 * (m + 1) + 1 + 1 := by omega
      rw [dif_pos h0_lt]
      have h0_eq : (⟨2 * 0, Nat.lt_of_succ_lt h0_lt⟩ : Fin (2 * (m + 1) + 1 + 1)) = 0 :=
        Fin.ext rfl
      have h1_eq : (⟨2 * 0 + 1, h0_lt⟩ : Fin (2 * (m + 1) + 1 + 1)) = 1 :=
        Fin.ext h1_val.symm
      rw [h0_eq, h1_eq]
    rw [hsum_eq, h0_term]

  
  have hSupD : (⨆ μ : Fin (2 * (m + 1) + 1 + 1), D μ) = ⊤ := by
    have hAdjoin :
        Algebra.adjoin ↥(𝒜 0)
          (Set.range (MvPolynomial.X : Fin (2 * (m + 1) + 1 + 1) → A_amb)) = ⊤ := by
      have hmem : ∀ p : A_amb,
          p ∈ Algebra.adjoin ↥(𝒜 0)
            (Set.range (MvPolynomial.X : Fin (2 * (m + 1) + 1 + 1) → A_amb)) := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C c =>
          have hC : (MvPolynomial.C c : A_amb) = algebraMap ↥(𝒜 0) A_amb (algebraMap Ω ↥(𝒜 0) c) :=
            (halg0_val c).symm
          rw [hC]
          exact Subalgebra.algebraMap_mem _ _
        | add p q hp hq => exact Subalgebra.add_mem _ hp hq
        | mul_X p i hp =>
          exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin (Set.mem_range_self i))
      rw [eq_top_iff]
      intro p _
      exact hmem p
    exact AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜
      (fun μ : Fin (2 * (m + 1) + 1 + 1) => MvPolynomial.X μ) (fun μ => ⟨1, hX μ⟩) hAdjoin

  
  have hChartCI : ∀ μ : Fin (2 * (m + 1) + 1 + 1),
      let awaySec := AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)
      let π_μ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) →+*
          ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ))) :=
        ((f_ci.app (D μ)).hom).comp awaySec.hom
      AlgebraicGeometry.IsAffineOpen (C' μ) ∧
      Function.Surjective π_μ ∧
      RingHom.ker π_μ =
        Ideal.span
          {HomogeneousLocalization.Away.mk 𝒜 (hX μ) 2 F_amb hF,
           HomogeneousLocalization.Away.mk 𝒜 (hX μ) 1 L_hyp hL} ∧
      ((C' μ).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_μ) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one =
        (C' μ).ι ≫ f_ci) := by
    intro μ
    have hAff_D : AlgebraicGeometry.IsAffineOpen (D μ) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one
    have hAff_W1 : AlgebraicGeometry.IsAffineOpen (W₁ μ) := hAff_D.preimage f₁
    have hAff_C : AlgebraicGeometry.IsAffineOpen (C' μ) := hAff_D.preimage f_ci
    let awaySec := AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)
    let β_μ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) →+*
        ↑(Q_amb.left.presheaf.obj (Opposite.op (W₁ μ))) :=
      ((f₁.app (D μ)).hom).comp awaySec.hom
    let π_μ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) →+*
        ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ))) :=
      ((f_ci.app (D μ)).hom).comp awaySec.hom
    have hπ_eq_comp : ∀ z, π_μ z = (i_sm.left.app (W₁ μ)).hom (β_μ z) := by
      intro z
      change ((i_sm.left ≫ f₁).app (D μ)).hom (awaySec.hom z) = _
      rw [AlgebraicGeometry.Scheme.Hom.comp_app]
      rfl
    have hAwayIso : awaySec =
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one).hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one).symm
    have hAwayBij : Function.Bijective awaySec.hom := by
      let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one
      rw [hAwayIso]
      exact isoA.commRingCatIsoToRingEquiv.bijective
    have hf₁_surj : Function.Surjective (f₁.app (D μ)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective f₁ (D μ) hAff_D
    have hi_surj : Function.Surjective (i_sm.left.app (W₁ μ)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective i_sm.left (W₁ μ) hAff_W1
    have hβ_surj : Function.Surjective β_μ := hf₁_surj.comp hAwayBij.2
    have hπ_surj : Function.Surjective π_μ := by
      intro y
      obtain ⟨w, rfl⟩ := hi_surj y
      obtain ⟨z, rfl⟩ := hβ_surj w
      exact ⟨z, (hπ_eq_comp z).symm⟩
    let s_F := HomogeneousLocalization.Away.mk 𝒜 (hX μ) 2 F_amb hF
    let s_L := HomogeneousLocalization.Away.mk 𝒜 (hX μ) 1 L_hyp hL
    have h_id_sub : D μ ≤
        (TopologicalSpace.Opens.map (𝟙 P_sch : P_sch ⟶ P_sch).base).obj (D μ) :=
      fun _ hx => hx
    have hker1_raw := hKer_amb μ (hX μ) (D μ) hAff_D h_id_sub
    change RingHom.ker (f₁.app (D μ)).hom =
      Ideal.span {((𝟙 P_sch : P_sch ⟶ P_sch).appLE (D μ)
          ((TopologicalSpace.Opens.map (𝟙 P_sch : P_sch ⟶ P_sch).base).obj (D μ))
          h_id_sub).hom
        (awaySec.hom s_F)} at hker1_raw
    rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE (𝟙 P_sch),
      AlgebraicGeometry.Scheme.Hom.id_app] at hker1_raw
    change RingHom.ker (f₁.app (D μ)).hom = Ideal.span {awaySec.hom s_F} at hker1_raw
    have hβ_ker : RingHom.ker β_μ = Ideal.span {s_F} := by
      apply le_antisymm
      · intro z hz
        have hmem : awaySec.hom z ∈ RingHom.ker (f₁.app (D μ)).hom := hz
        rw [hker1_raw, Ideal.mem_span_singleton] at hmem
        rcases hmem with ⟨s, hs⟩
        obtain ⟨a, rfl⟩ := hAwayBij.2 s
        rw [← map_mul] at hs
        exact Ideal.mem_span_singleton.mpr ⟨a, hAwayBij.1 hs⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        change (f₁.app (D μ)).hom (awaySec.hom s_F) = 0
        have hmem : awaySec.hom s_F ∈ RingHom.ker (f₁.app (D μ)).hom := by
          rw [hker1_raw]
          exact Ideal.subset_span rfl
        exact hmem
    have hW1_sub : W₁ μ ≤
        (TopologicalSpace.Opens.map
          (CategoryTheory.Over.homMk ι_amb hι_amb).left.base).obj (D μ) :=
      fun _ hx => hx
    have hker2_raw := hKer_sm μ (hX μ) (W₁ μ) hAff_W1 hW1_sub
    change RingHom.ker (i_sm.left.app (W₁ μ)).hom =
      Ideal.span {(f₁.appLE (D μ)
          ((TopologicalSpace.Opens.map f₁.base).obj (D μ)) hW1_sub).hom
        (awaySec.hom s_L)} at hker2_raw
    rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f₁] at hker2_raw
    change RingHom.ker (i_sm.left.app (W₁ μ)).hom = Ideal.span {β_μ s_L} at hker2_raw
    have hπ_ker : RingHom.ker π_μ = Ideal.span {s_F, s_L} := by
      apply le_antisymm
      · intro z hz
        have hi_z : β_μ z ∈ RingHom.ker (i_sm.left.app (W₁ μ)).hom := by
          change (i_sm.left.app (W₁ μ)).hom (β_μ z) = 0
          rwa [← hπ_eq_comp]
        rw [hker2_raw, Ideal.mem_span_singleton] at hi_z
        rcases hi_z with ⟨y, hy⟩
        obtain ⟨b, rfl⟩ := hβ_surj y
        have hsub_ker : z - s_L * b ∈ RingHom.ker β_μ := by
          change β_μ (z - s_L * b) = 0
          rw [map_sub, map_mul, hy, sub_self]
        rw [hβ_ker, Ideal.mem_span_singleton] at hsub_ker
        rcases hsub_ker with ⟨a, ha⟩
        rw [Ideal.mem_span_pair]
        refine ⟨a, b, ?_⟩
        linear_combination ha.symm
      · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        refine ⟨?_, ?_⟩
        · change π_μ s_F = 0
          rw [hπ_eq_comp]
          have h0 : β_μ s_F = 0 := by
            change s_F ∈ RingHom.ker β_μ
            rw [hβ_ker]
            exact Ideal.subset_span rfl
          rw [h0]
          exact map_zero _
        · change π_μ s_L = 0
          rw [hπ_eq_comp]
          change β_μ s_L ∈ RingHom.ker (i_sm.left.app (W₁ μ)).hom
          rw [hker2_raw]
          exact Ideal.subset_span rfl
    have hStep1 :
        (C' μ).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (awaySec ≫ f_ci.appLE (D μ) (C' μ) le_rfl) =
        (f_ci ∣_ D μ) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one).hom := by
      rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE f_ci (D μ) (C' μ) le_rfl,
        AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict,
        CategoryTheory.Category.assoc]
      congr 1
    have hStep2 :
        (C' μ).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (awaySec ≫ f_ci.appLE (D μ) (C' μ) le_rfl) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one =
        (C' μ).ι ≫ f_ci := by
      rw [← CategoryTheory.Category.assoc, hStep1, CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one,
        CategoryTheory.Iso.hom_inv_id_assoc,
        AlgebraicGeometry.morphismRestrict_ι]
    have hEqMor : awaySec ≫ f_ci.appLE (D μ) (C' μ) le_rfl = CommRingCat.ofHom π_μ := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f_ci]
      rfl
    rw [hEqMor] at hStep2
    exact ⟨hAff_C, hπ_surj, hπ_ker, hStep2⟩

  refine ⟨?_, ?_, ?_⟩
  · 
    
    
    have hSubcovElim : ∀ (μ₀ : Fin (2 * (m + 1) + 1 + 1))
        (q₁ q₂ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀))
        (r : Fin (m + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀)),
        1 = q₁ * HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 2 F_amb hF +
            q₂ * HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 1 L_hyp hL +
            ∑ j : Fin (m + 1),
              r j * HomogeneousLocalization.Away.isLocalizationElem (hX μ₀) (hX (ν_even j)) →
        C' μ₀ ≤ ⨆ a : Fin (2 * m + 2), C a := by
      intro μ₀ q₁ q₂ r hSyz z hz
      obtain ⟨_, _, hπ_ker, hStep2⟩ := hChartCI μ₀
      let awaySec := AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ₀)
      let π₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀) →+*
          ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ₀))) :=
        ((f_ci.app (D μ₀)).hom).comp awaySec.hom
      let p : PrimeSpectrum ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ₀))) :=
        (C' μ₀).toSpecΓ.base ⟨z, hz⟩
      let p_away : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀)) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀)).base p
      have hfz_eq : f_ci.base z =
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one).base p_away :=
        (congrArg (fun g => g.base ⟨z, hz⟩) hStep2).symm
      by_contra hz_not
      have hj_mem : ∀ j : Fin (m + 1),
          π₀ (HomogeneousLocalization.Away.isLocalizationElem (hX μ₀) (hX (ν_even j))) ∈
            p.asIdeal := by
        intro j
        have hz_not_j : z ∉ C ⟨2 * j.1, by omega⟩ := fun hzj =>
          hz_not (TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨2 * j.1, by omega⟩, hzj⟩)
        have hfz_not_D : f_ci.base z ∉ D (ν_even j) := hz_not_j
        rw [hfz_eq] at hfz_not_D
        have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜
          (hX μ₀) zero_lt_one (hX (ν_even j)) zero_lt_one
        have hp_not_basic : p_away ∉
            PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.isLocalizationElem (hX μ₀) (hX (ν_even j))) := by
          intro hp_in
          apply hfz_not_D
          change p_away ∈ (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one).base).obj
            (D (ν_even j))
          dsimp [D]
          rw [hpre]
          exact hp_in
        rw [PrimeSpectrum.mem_basicOpen, not_not] at hp_not_basic
        exact hp_not_basic
      have hsum_mem :
          (∑ j : Fin (m + 1),
            π₀ (r j) *
              π₀ (HomogeneousLocalization.Away.isLocalizationElem (hX μ₀) (hX (ν_even j)))) ∈
            p.asIdeal :=
        p.asIdeal.sum_mem fun j _ => p.asIdeal.mul_mem_left (π₀ (r j)) (hj_mem j)
      have hπ_sF : π₀ (HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 2 F_amb hF) = 0 := by
        change HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 2 F_amb hF ∈ RingHom.ker π₀
        rw [hπ_ker]
        exact Ideal.subset_span (Set.mem_insert _ _)
      have hπ_sL : π₀ (HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 1 L_hyp hL) = 0 := by
        change HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 1 L_hyp hL ∈ RingHom.ker π₀
        rw [hπ_ker]
        exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
      have h1_eq := congrArg π₀ hSyz
      simp only [map_one, map_add, map_mul, map_sum, hπ_sF, hπ_sL, mul_zero, add_zero,
        zero_add] at h1_eq
      rw [← h1_eq] at hsum_mem
      exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr hsum_mem)

    
    have hC0_le : C' 0 ≤ ⨆ a : Fin (2 * m + 2), C a := by
      let q₁_0 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) :=
        HomogeneousLocalization.Away.mk 𝒜 (hX 0) 0 (MvPolynomial.C (-c_0)) (hC_smul0 (-c_0))
      let q₂_0 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) := 1
      let r_0 : Fin (m + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) :=
        fun j => HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1
          (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) (hCX_smul1 c_0 (ν_odd j))
      refine hSubcovElim 0 q₁_0 q₂_0 r_0 ?_
      let L₀ := Localization (Submonoid.powers (MvPolynomial.X 0 : A_amb))
      let val₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) →+* L₀ := algebraMap _ _
      let u₀ : L₀ := algebraMap A_amb L₀ (MvPolynomial.X 0)
      have hu₀ : IsUnit (u₀ ^ 2) :=
        (IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X 0 : A_amb)).pow 2
      apply HomogeneousLocalization.val_injective
      simp only [← HomogeneousLocalization.algebraMap_apply]
      change val₀ 1 = val₀ _
      apply hu₀.mul_left_cancel
      have h_q1 : val₀ q₁_0 = algebraMap A_amb L₀ (MvPolynomial.C (-c_0)) := by
        have h := hmk_mul 0 0 (MvPolynomial.C (-c_0)) (hC_smul0 (-c_0))
        rwa [pow_zero, one_mul] at h
      have h_sF : u₀ ^ 2 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 2 F_amb hF) =
          algebraMap A_amb L₀ F_amb :=
        hmk_mul 0 2 F_amb hF
      have h_sL : u₀ * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1 L_hyp hL) =
          algebraMap A_amb L₀ L_hyp := by
        have h := hmk_mul 0 1 L_hyp hL
        rwa [pow_one] at h
      have h_term1 :
          u₀ ^ 2 * (val₀ q₁_0 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 2 F_amb hF)) =
          algebraMap A_amb L₀ (MvPolynomial.C (-c_0) * F_amb) := by
        calc
          u₀ ^ 2 * (val₀ q₁_0 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 2 F_amb hF))
            = val₀ q₁_0 *
                (u₀ ^ 2 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 2 F_amb hF)) := by ring
          _ = algebraMap A_amb L₀ (MvPolynomial.C (-c_0)) * algebraMap A_amb L₀ F_amb := by
              rw [h_q1, h_sF]
          _ = algebraMap A_amb L₀ (MvPolynomial.C (-c_0) * F_amb) := (map_mul _ _ _).symm
      have h_term2 :
          u₀ ^ 2 * (1 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1 L_hyp hL)) =
          algebraMap A_amb L₀ (MvPolynomial.X 0 * L_hyp) := by
        calc
          u₀ ^ 2 * (1 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1 L_hyp hL))
            = u₀ * (u₀ * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1 L_hyp hL)) := by ring
          _ = u₀ * algebraMap A_amb L₀ L_hyp := by rw [h_sL]
          _ = algebraMap A_amb L₀ (MvPolynomial.X 0 * L_hyp) := (map_mul _ _ _).symm
      have h_sum :
          u₀ ^ 2 * (∑ j : Fin (m + 1),
            val₀ (r_0 j) *
              val₀ (HomogeneousLocalization.Away.isLocalizationElem (hX 0) (hX (ν_even j)))) =
          algebraMap A_amb L₀
            (∑ j : Fin (m + 1),
              (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) * MvPolynomial.X (ν_even j)) := by
        rw [Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [helem_eq 0 (ν_even j)]
        have hr_j : u₀ * val₀ (r_0 j) =
            algebraMap A_amb L₀ (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) := by
          have h := hmk_mul 0 1
            (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) (hCX_smul1 c_0 (ν_odd j))
          rwa [pow_one] at h
        have hx_j : u₀ * val₀
            (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1
              (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j))) =
            algebraMap A_amb L₀ (MvPolynomial.X (ν_even j)) := by
          have h := hmk_mul 0 1 (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j))
          rwa [pow_one] at h
        calc
          u₀ ^ 2 * (val₀ (r_0 j) *
              val₀
                (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1
                  (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j))))
            = (u₀ * val₀ (r_0 j)) *
                (u₀ * val₀
                  (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1
                    (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j)))) := by ring
          _ = algebraMap A_amb L₀ (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) *
                algebraMap A_amb L₀ (MvPolynomial.X (ν_even j)) := by rw [hr_j, hx_j]
          _ = algebraMap A_amb L₀
                ((MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) *
                  MvPolynomial.X (ν_even j)) := (map_mul _ _ _).symm
      have hpoly0 :
          (MvPolynomial.X 0 : A_amb) ^ 2 =
            MvPolynomial.C (-c_0) * F_amb + MvPolynomial.X 0 * L_hyp +
              ∑ j : Fin (m + 1),
                (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) *
                  MvPolynomial.X (ν_even j) := by
        dsimp only [L_hyp]
        have hc_dist :
            (MvPolynomial.C c_0 : A_amb) *
              ((∑ j : Fin (m + 1),
                  (MvPolynomial.X (ν_even j) : A_amb) * MvPolynomial.X (ν_odd j)) +
                MvPolynomial.X 0 * MvPolynomial.X 1) =
            (∑ j : Fin (m + 1),
              (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j) : A_amb) *
                MvPolynomial.X (ν_even j)) +
              MvPolynomial.C c_0 * (MvPolynomial.X 0 * MvPolynomial.X 1) := by
          refine (mul_add _ _ _).trans ?_
          congr 1
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun _ _ => by ring
        rw [hF_amb_eq, map_neg, neg_mul, hc_dist]
        ring
      calc
        u₀ ^ 2 * val₀ 1 = algebraMap A_amb L₀ ((MvPolynomial.X 0 : A_amb) ^ 2) := by
          rw [val₀.map_one, mul_one, map_pow]
        _ = algebraMap A_amb L₀ (MvPolynomial.C (-c_0) * F_amb) +
              algebraMap A_amb L₀ (MvPolynomial.X 0 * L_hyp) +
              algebraMap A_amb L₀
                (∑ j : Fin (m + 1),
                  (MvPolynomial.C c_0 * MvPolynomial.X (ν_odd j)) *
                    MvPolynomial.X (ν_even j)) := by
          rw [hpoly0, map_add, map_add]
        _ = u₀ ^ 2 * (val₀ q₁_0 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 2 F_amb hF)) +
              u₀ ^ 2 * (1 * val₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1 L_hyp hL)) +
              u₀ ^ 2 * (∑ j : Fin (m + 1),
                val₀ (r_0 j) *
                  val₀ (HomogeneousLocalization.Away.isLocalizationElem (hX 0) (hX (ν_even j)))) := by
          rw [← h_term1, ← h_term2, ← h_sum]
        _ = _ := by
          simp only [q₂_0, val₀.map_add, val₀.map_mul, val₀.map_one, map_sum]
          ring

    
    have hC1_le : C' 1 ≤ ⨆ a : Fin (2 * m + 2), C a := by
      let q₁_1 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) :=
        HomogeneousLocalization.Away.mk 𝒜 (hX 1) 0 (MvPolynomial.C (-c_0⁻¹)) (hC_smul0 (-c_0⁻¹))
      let q₂_1 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) :=
        HomogeneousLocalization.Away.mk 𝒜 (hX 1) 0 (MvPolynomial.C (c_0⁻¹)) (hC_smul0 (c_0⁻¹))
      let r_1 : Fin (m + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) :=
        fun j => HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1
          (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) (hCX_smul1 (c_0⁻¹) (ν_odd j))
      refine hSubcovElim 1 q₁_1 q₂_1 r_1 ?_
      let L₁ := Localization (Submonoid.powers (MvPolynomial.X 1 : A_amb))
      let val₁ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) →+* L₁ := algebraMap _ _
      let u₁ : L₁ := algebraMap A_amb L₁ (MvPolynomial.X 1)
      have hu₁ : IsUnit (u₁ ^ 2) :=
        (IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X 1 : A_amb)).pow 2
      apply HomogeneousLocalization.val_injective
      simp only [← HomogeneousLocalization.algebraMap_apply]
      change val₁ 1 = val₁ _
      apply hu₁.mul_left_cancel
      have h_q1 : val₁ q₁_1 = algebraMap A_amb L₁ (MvPolynomial.C (-c_0⁻¹)) := by
        have h := hmk_mul 1 0 (MvPolynomial.C (-c_0⁻¹)) (hC_smul0 (-c_0⁻¹))
        rwa [pow_zero, one_mul] at h
      have h_q2 : val₁ q₂_1 = algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹)) := by
        have h := hmk_mul 1 0 (MvPolynomial.C (c_0⁻¹)) (hC_smul0 (c_0⁻¹))
        rwa [pow_zero, one_mul] at h
      have h_sF : u₁ ^ 2 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 2 F_amb hF) =
          algebraMap A_amb L₁ F_amb :=
        hmk_mul 1 2 F_amb hF
      have h_sL : u₁ * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1 L_hyp hL) =
          algebraMap A_amb L₁ L_hyp := by
        have h := hmk_mul 1 1 L_hyp hL
        rwa [pow_one] at h
      have h_term1 :
          u₁ ^ 2 * (val₁ q₁_1 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 2 F_amb hF)) =
          algebraMap A_amb L₁ (MvPolynomial.C (-c_0⁻¹) * F_amb) := by
        calc
          u₁ ^ 2 * (val₁ q₁_1 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 2 F_amb hF))
            = val₁ q₁_1 *
                (u₁ ^ 2 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 2 F_amb hF)) := by ring
          _ = algebraMap A_amb L₁ (MvPolynomial.C (-c_0⁻¹)) * algebraMap A_amb L₁ F_amb := by
              rw [h_q1, h_sF]
          _ = algebraMap A_amb L₁ (MvPolynomial.C (-c_0⁻¹) * F_amb) := (map_mul _ _ _).symm
      have h_term2 :
          u₁ ^ 2 * (val₁ q₂_1 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1 L_hyp hL)) =
          algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X 1 * L_hyp) := by
        calc
          u₁ ^ 2 * (val₁ q₂_1 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1 L_hyp hL))
            = val₁ q₂_1 * u₁ *
                (u₁ * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1 L_hyp hL)) := by ring
          _ = algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹)) * u₁ * algebraMap A_amb L₁ L_hyp := by
              rw [h_q2, h_sL]
          _ = algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X 1 * L_hyp) := by
              simp [u₁, map_mul]
      have h_sum :
          u₁ ^ 2 * (∑ j : Fin (m + 1),
            val₁ (r_1 j) *
              val₁ (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX (ν_even j)))) =
          algebraMap A_amb L₁
            (∑ j : Fin (m + 1),
              (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) * MvPolynomial.X (ν_even j)) := by
        rw [Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [helem_eq 1 (ν_even j)]
        have hr_j : u₁ * val₁ (r_1 j) =
            algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) := by
          have h := hmk_mul 1 1
            (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) (hCX_smul1 (c_0⁻¹) (ν_odd j))
          rwa [pow_one] at h
        have hx_j : u₁ * val₁
            (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1
              (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j))) =
            algebraMap A_amb L₁ (MvPolynomial.X (ν_even j)) := by
          have h := hmk_mul 1 1 (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j))
          rwa [pow_one] at h
        calc
          u₁ ^ 2 * (val₁ (r_1 j) *
              val₁
                (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1
                  (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j))))
            = (u₁ * val₁ (r_1 j)) *
                (u₁ * val₁
                  (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1
                    (MvPolynomial.X (ν_even j)) (hX_smul1 (ν_even j)))) := by ring
          _ = algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) *
                algebraMap A_amb L₁ (MvPolynomial.X (ν_even j)) := by rw [hr_j, hx_j]
          _ = algebraMap A_amb L₁
                ((MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) *
                  MvPolynomial.X (ν_even j)) := (map_mul _ _ _).symm
      have hpoly1 :
          (MvPolynomial.X 1 : A_amb) ^ 2 =
            MvPolynomial.C (-c_0⁻¹) * F_amb +
              MvPolynomial.C (c_0⁻¹) * MvPolynomial.X 1 * L_hyp +
              ∑ j : Fin (m + 1),
                (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) *
                  MvPolynomial.X (ν_even j) := by
        dsimp only [L_hyp]
        have hC_inv : (MvPolynomial.C (c_0⁻¹) : A_amb) * MvPolynomial.C c_0 = 1 := by
          rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hc_0, map_one]
        have hL_prod :
            (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X 1 : A_amb) *
              (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1) =
            MvPolynomial.C (c_0⁻¹) * (MvPolynomial.X 0 * MvPolynomial.X 1) +
              MvPolynomial.X 1 ^ 2 := by
          calc
            (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X 1 : A_amb) *
                (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1)
              = MvPolynomial.C (c_0⁻¹) * (MvPolynomial.X 0 * MvPolynomial.X 1) +
                  ((MvPolynomial.C (c_0⁻¹) : A_amb) * MvPolynomial.C c_0) *
                    MvPolynomial.X 1 ^ 2 := by ring
            _ = MvPolynomial.C (c_0⁻¹) * (MvPolynomial.X 0 * MvPolynomial.X 1) +
                  MvPolynomial.X 1 ^ 2 := by rw [hC_inv, one_mul]
        have hc_dist :
            (MvPolynomial.C (c_0⁻¹) : A_amb) *
              ((∑ j : Fin (m + 1),
                  (MvPolynomial.X (ν_even j) : A_amb) * MvPolynomial.X (ν_odd j)) +
                MvPolynomial.X 0 * MvPolynomial.X 1) =
            (∑ j : Fin (m + 1),
              (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j) : A_amb) *
                MvPolynomial.X (ν_even j)) +
              MvPolynomial.C (c_0⁻¹) * (MvPolynomial.X 0 * MvPolynomial.X 1) := by
          refine (mul_add _ _ _).trans ?_
          congr 1
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun _ _ => by ring
        rw [hL_prod, hF_amb_eq, map_neg, neg_mul, hc_dist]
        ring
      calc
        u₁ ^ 2 * val₁ 1 = algebraMap A_amb L₁ ((MvPolynomial.X 1 : A_amb) ^ 2) := by
          rw [val₁.map_one, mul_one, map_pow]
        _ = algebraMap A_amb L₁ (MvPolynomial.C (-c_0⁻¹) * F_amb) +
              algebraMap A_amb L₁ (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X 1 * L_hyp) +
              algebraMap A_amb L₁
                (∑ j : Fin (m + 1),
                  (MvPolynomial.C (c_0⁻¹) * MvPolynomial.X (ν_odd j)) *
                    MvPolynomial.X (ν_even j)) := by
          rw [hpoly1, map_add, map_add]
        _ = u₁ ^ 2 * (val₁ q₁_1 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 2 F_amb hF)) +
              u₁ ^ 2 * (val₁ q₂_1 * val₁ (HomogeneousLocalization.Away.mk 𝒜 (hX 1) 1 L_hyp hL)) +
              u₁ ^ 2 * (∑ j : Fin (m + 1),
                val₁ (r_1 j) *
                  val₁ (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX (ν_even j)))) := by
          rw [← h_term1, ← h_term2, ← h_sum]
        _ = _ := by
          simp only [val₁.map_add, val₁.map_mul, map_sum]
          ring

    
    rw [eq_top_iff]
    intro z _
    have hfz : f_ci.base z ∈ (⨆ μ : Fin (2 * (m + 1) + 1 + 1), D μ) := by rw [hSupD]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hfz
    obtain ⟨μ, hz_μ⟩ := hfz
    have hsucc0_eq_1 :
        (0 : Fin ((2 * m + 2) + 1)).succ = (1 : Fin (2 * (m + 1) + 1 + 1)) :=
      Fin.ext h1_val.symm
    exact Fin.cases
      (motive := fun ν : Fin ((2 * m + 2) + 2) => z ∈ C' ν → z ∈ ⨆ a : Fin (2 * m + 2), C a)
      (fun h0 => hC0_le h0)
      (fun ν => Fin.cases
