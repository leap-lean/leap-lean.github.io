            (algebraMap (Polynomial k) (RatFunc k) P_c) ^ n } →
    MvPolynomial.eval p h_c = 0 →
    MvPolynomial.eval p (MvPolynomial.pderiv 0 h_c) ≠ 0 ∨
    MvPolynomial.eval p (MvPolynomial.pderiv 1 h_c) ≠ 0 :=
