    refine ⟨V_a_et, f_tot, z_a, ?_, hEt_ftot, hftot_pt⟩
    refine ⟨η_Y.app (Opposite.op V_a_et) (ULift.up (c a : ZMod ℓ)), ?_⟩
    change (ψ_0.hom.app (Opposite.op V_a_et))
