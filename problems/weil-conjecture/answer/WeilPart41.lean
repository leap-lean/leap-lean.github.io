              MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ := by
    intro R _ c_R t_R v_R ψ_R
    dsimp [F_amb_k]
    rw [Finset.sum_range_succ', map_add, map_sum, add_comm (∑ _ ∈ _, _)]
    congr 1
    · have h0 : 2 * 0 + 1 < 2 * (m + 1) + 1 + 1 := by omega
      simp only [h0, ↓reduceDIte, map_mul]
      have hx0 : (⟨2 * 0, Nat.lt_of_succ_lt h0⟩ : Fin (M + 1 + 1)) = 0 := Fin.ext rfl
      have hx1 : (⟨2 * 0 + 1, h0⟩ : Fin (M + 1 + 1)) = (0 : Fin (M + 1)).succ := Fin.ext rfl
      rw [hx0, hx1]
      dsimp only [ψ_R]
      rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      dsimp only [v_R, Fin.cases_zero, Fin.cases_succ]
    · rw [← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hj : 2 * (j.1 + 1) + 1 < 2 * (m + 1) + 1 + 1 := by omega
      simp only [hj, ↓reduceDIte, map_mul]
      have ha0 : (⟨2 * (j.1 + 1), Nat.lt_of_succ_lt hj⟩ : Fin (M + 1 + 1)) =
          (⟨2 * j.1, by omega⟩ : Fin M).succ.succ := Fin.ext (by dsimp; omega)
      have ha1 : (⟨2 * (j.1 + 1) + 1, hj⟩ : Fin (M + 1 + 1)) =
          (⟨2 * j.1 + 1, by omega⟩ : Fin M).succ.succ := Fin.ext (by dsimp; omega)
      rw [ha0, ha1]
      dsimp only [ψ_R]
      rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      dsimp only [v_R, Fin.cases_succ]
      rfl

