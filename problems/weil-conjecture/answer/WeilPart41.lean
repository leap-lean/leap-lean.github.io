            rcases idx with i | ⟨j₀, b⟩
            · have hi : i = 0 := Subsingleton.elim i 0
              subst hi
              rw [show s_pre (MvPolynomial.X (Sum.inl 0)) =
                mk_u (Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inl 0))) by
