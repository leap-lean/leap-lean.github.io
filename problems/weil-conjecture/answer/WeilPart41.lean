        rfl
      exact hAwayBridge ψ_K_grad h_irrel_ψK
        (MvPolynomial.X 1) hX1_K (MvPolynomial.X 0) hy0_K_eq hY0_K
    · intro a
      have hXa_K : (MvPolynomial.X a.succ.succ : MvPolynomial (Fin (M + 1 + 1)) K) ∈ 𝒜_K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a.succ.succ)
      have hYa_K : (MvPolynomial.X a.succ : MvPolynomial (Fin (M + 1)) K) ∈ ℬ_K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a.succ)
      have hya_K_eq : (MvPolynomial.X a.succ : MvPolynomial (Fin (M + 1)) K) =
          ψ_K_grad (MvPolynomial.X a.succ.succ) := by
        change MvPolynomial.X a.succ =
          MvPolynomial.eval₂Hom MvPolynomial.C v_K (MvPolynomial.X a.succ.succ)
        rw [MvPolynomial.eval₂Hom_X']
        rfl
      exact hAwayBridge ψ_K_grad h_irrel_ψK
        (MvPolynomial.X a.succ.succ) hXa_K (MvPolynomial.X a.succ) hya_K_eq hYa_K

theorem weil_odp_qdeg_hypersurface_slice_iso_and_proj_chart_quotients (M : ℕ) :
    (∀ (k K : Type u) [Field k] [Field K] (c_K : k →+* K) (d₀ : ℕ), 1 ≤ d₀ →
      let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) k
      let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K
      letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
      ∀ (F_k : MvPolynomial (Fin (M + 1 + 1)) k)
        (Q_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_k : Q_k.left ⟶ (weilProjectiveSpaceOver k (M + 1)).left)
        (Q_K : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
        (ι_K : Q_K.left ⟶ (weilProjectiveSpaceOver K (M + 1)).left)
        (π_amb : (weilProjectiveSpaceOver K (M + 1)).left ⟶
          (weilProjectiveSpaceOver k (M + 1)).left),
        IsHomogeneousHypersurfacePullbackOver k (M + 1) d₀
          (𝟙 (weilProjectiveSpaceOver k (M + 1))) F_k ι_k →
        IsHomogeneousHypersurfacePullbackOver K (M + 1) d₀
          (𝟙 (weilProjectiveSpaceOver K (M + 1))) (MvPolynomial.map c_K F_k) ι_K →
        (∀ μ : Fin (M + 1 + 1),
          (TopologicalSpace.Opens.map π_amb.base).obj (weilProjBasicOpen k (M + 1) μ) =
            weilProjBasicOpen K (M + 1) μ ∧
          ∃ ψ_μ : HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X μ) →+*
              HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X μ),
            AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X μ)
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
              zero_lt_one ≫ π_amb =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_μ) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X μ)
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X k μ)) zero_lt_one ∧
            ∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) k)
              (hx : x ∈ 𝒜_k (n • 1)) (hmx : MvPolynomial.map c_K x ∈ 𝒜_K (n • 1)),
              ψ_μ (HomogeneousLocalization.Away.mk 𝒜_k
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k μ))
                n x hx) =
              HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
                n (MvPolynomial.map c_K x) hmx) →
        ∃ e_BC : Q_K.left ≅ CategoryTheory.Limits.pullback ι_k π_amb,
          e_BC.hom ≫ CategoryTheory.Limits.pullback.snd ι_k π_amb = ι_K) ∧
    (∀ (K : Type u) [Field K] (t_K : K),
      let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K
      let ℬ_K := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K
      letI : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra ℬ_K := MvPolynomial.gradedAlgebra
      let v_K : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) K :=
        Fin.cases (-MvPolynomial.C t_K * MvPolynomial.X 0)
