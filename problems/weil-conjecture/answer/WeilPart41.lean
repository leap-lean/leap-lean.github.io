              ext r
              simp [Polynomial.C_add, add_mul, Finset.sum_add_distrib]
            map_smul' := fun a c => by
              ext r
              simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
              have hsmul : ∑ x : IdxBox, Polynomial.C (a * c x) * R_box x =
