  have hZModAdd : ∀ {M₀ : Type u} [AddCommGroup M₀] (x : M₀),
      ℓ • x = 0 → ∀ a b : ZMod ℓ, (a + b).val • x = a.val • x + b.val • x := by
    intro M₀ _ x hℓx a b
