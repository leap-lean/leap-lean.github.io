            dsimp [M, N]
            have hid : (2 * d_Sigma + 1 + 1) * (2 * d_Sigma + 1 + 1) =
                (2 * (2 * d_Sigma + 1) * d_Sigma + 1) + (6 * d_Sigma + 3) := by ring
            omega
          omega
        have hex_c : ∃ c : IdxBox → k, c ≠ 0 ∧ L_map c = 0 := by
          obtain ⟨c₁, h1⟩ := Classical.not_forall.mp hNotInj
          obtain ⟨c₂, h2⟩ := Classical.not_forall.mp h1
          rw [not_imp] at h2
          refine ⟨c₁ - c₂, sub_ne_zero.mpr h2.2, ?_⟩
          rw [map_sub, h2.1, sub_self]
        obtain ⟨c, hc_ne, hc_ker⟩ := hex_c
        have hSumR0 : ∑ α : IdxBox, Polynomial.C (c α) * R_box α = 0 := by
          ext r
          rw [Polynomial.coeff_zero]
          by_cases hr : r < M
          · exact congrFun hc_ker ⟨r, hr⟩
          · rw [Polynomial.finsetSum_coeff]
            apply Finset.sum_eq_zero
            intro α _
            apply Polynomial.coeff_eq_zero_of_natDegree_lt
            have h1 : (Polynomial.C (c α) * R_box α).natDegree ≤ (R_box α).natDegree :=
