        · rw [show q_pre (MvPolynomial.C c) =
            Polynomial.C (Ideal.Quotient.mk (I_k n) (MvPolynomial.C c)) by simp [q_pre, c_q]]
          rw [show s_bar (Polynomial.C (Ideal.Quotient.mk (I_k n) (MvPolynomial.C c))) =
            s_pre (MvPolynomial.C c) by simp [s_bar]; rfl]
          simp [s_pre, c_Ju]
        · simp only [map_add] at hf hg ⊢
          exact congrArg₂ (· + ·) hf hg
        · simp only [map_mul] at hf ⊢
          refine congrArg₂ (· * ·) hf ?_
          rcases idx with i | ⟨j, b⟩
          · have hi : i = 0 := Subsingleton.elim i 0
