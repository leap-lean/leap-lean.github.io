    let I_eva : Ideal P_N := Ideal.span {ev_a G_R}
    let J_Qa : Ideal (HomogeneousLocalization.Away ℬ_R (MvPolynomial.X a.succ)) :=
      Ideal.span {HomogeneousLocalization.Away.mk ℬ_R hXa 2 G_R hG}
    have hIJa : J_Qa = Ideal.map δ_a.toRingHom I_eva := by
      dsimp only [I_eva, J_Qa]
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun x => Ideal.span {x}) (hδa_mk 2 G_R hG).symm
    let q_a : (P_N ⧸ I_eva) ≃+* Q_ring_a := Ideal.quotientEquiv I_eva J_Qa δ_a hIJa
    let θ_a : MvPolynomial (Fin (2 * m + 1)) R ≃+* Q_ring_a := β_a.trans q_a
    refine ⟨θ_a, ?_⟩
    apply RingHom.ext
    intro r
    change q_a (β_a (MvPolynomial.C r)) =
      Ideal.Quotient.mk J_Qa
        ((HomogeneousLocalization.fromZeroRingHom ℬ_R
          (Submonoid.powers (MvPolynomial.X a.succ))) (algebraMap R ↥(ℬ_R 0) r))
    have hβr := RingHom.congr_fun hβa_C r
    change β_a (MvPolynomial.C r) = Ideal.Quotient.mk I_eva (MvPolynomial.C r) at hβr
    rw [hβr]
    dsimp only [q_a]
    rw [hquotEquiv_mk]
    exact congrArg (Ideal.Quotient.mk J_Qa) (RingHom.congr_fun hδa_C r)

theorem weil_odp_qdeg_affine_pullback_and_atlas_upgrade (k : Type u) [Field k] (m : ℕ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (hSpec2 : ∀ q : Ideal R_bar, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal R_bar)
    (p_R : Polynomial k →+* R_bar)
    (π_cl : R_bar →+* k)
    (hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar)
    (hπ_pR : π_cl.comp p_R = Polynomial.evalRingHom 0)
    (Ω : Type u) [Field Ω]
    (φ_R_Ω : R_bar →+* Ω) (hφ_inj : Function.Injective φ_R_Ω)
    (h_R : R_bar)
    (hh_max : h_R ∈ IsLocalRing.maximalIdeal R_bar) (hh_ne : h_R ≠ 0) :
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    (∀ (R : Type u) [CommRing R] (c_R : k →+* R) (d : ℕ),
      ∃ e_aff : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d) R)) ≅
          CategoryTheory.Limits.pullback (weilAffineSpaceOver k d).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_R)),
        e_aff.hom ≫
          CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver k d).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_R)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
    (∀ (Q_R : AlgebraicGeometry.Scheme.{u})
      (pr₂_Q : Q_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
      [AlgebraicGeometry.IsSeparated pr₂_Q]
      (U_0 : Q_R.Opens) (V_R : Fin (2 * (m + 1)) → Q_R.Opens)
      (e_M : weilOdpModelSpec m (CommRingCat.of R_bar) h_R ≅ U_0.toScheme),
      U_0 ⊔ (⨆ a : Fin (2 * (m + 1)), V_R a) = ⊤ →
      e_M.hom ≫ U_0.ι ≫ pr₂_Q =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
      (∀ (j : Fin (m + 1)) (b : Fin 2),
        (TopologicalSpace.Opens.map (e_M.hom ≫ U_0.ι).base).obj
          (V_R ⟨2 * j.1 + b.1, by omega⟩) =
          PrimeSpectrum.basicOpen (Ideal.Quotient.mk _ (MvPolynomial.X (j, b)))) →
      let ι_aff_Q := e_M.hom ≫ U_0.ι
      AlgebraicGeometry.IsOpenImmersion ι_aff_Q ∧
      ∃ (zero_Q : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_R)
        (U_Q : Q_R.Opens),
        AlgebraicGeometry.IsClosedImmersion zero_Q ∧
        zero_Q ≫ pr₂_Q = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ∧
        (∀ zero_M : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            weilOdpModelSpec m (CommRingCat.of R_bar) h_R,
          (∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of k)) (idx : Fin (m + 1) × Fin 2),
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (zero_M.base pt).asIdeal) →
          zero_M ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) →
          zero_M ≫ ι_aff_Q = zero_Q) ∧
        (U_Q : Set ↥Q_R) = (Set.range zero_Q.base)ᶜ ∧
        (∀ a : Fin (2 * (m + 1)), V_R a ≤ U_Q) ∧
        (⨆ a : Fin (2 * (m + 1)), V_R a : Q_R.Opens) = U_Q ∧
        ∀ (X_Ω : AlgebraicGeometry.Scheme.{u})
          (q_Ω : X_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
          (j_tot : X_Ω ⟶ Q_R),
          CategoryTheory.IsPullback q_Ω j_tot j_R pr₂_Q →
          ∃ j_open : X_Ω ⟶ U_Q.toScheme,
            j_open ≫ U_Q.ι = j_tot ∧
            CategoryTheory.IsPullback q_Ω j_open j_R (U_Q.ι ≫ pr₂_Q)) ∧
    (∀ (d : ℕ) (X X_Ω : AlgebraicGeometry.Scheme.{u})
      (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
      (q_X : X_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (j_X : X_Ω ⟶ X),
      CategoryTheory.IsPullback q_X j_X j_R p_X →
      let S_d := weilAffineSpaceOver k d
      let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
      let A_Ω := CategoryTheory.Limits.pullback j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
      let j_A : A_Ω ⟶ A_R :=
        CategoryTheory.Limits.pullback.snd j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
      ∀ (V : X.Opens) (φ : V.toScheme ⟶ A_R),
        φ ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R = V.ι ≫ p_X →
        ∃ (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ X_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_X V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A φ) :=
by
  intro g_k_R j_R
  have hFieldIdeal : ∀ {K : Type u} [Field K] (pt : PrimeSpectrum K),
      pt.asIdeal = ⊥ := by
    intro K _ pt
    ext x
    simp only [Ideal.mem_bot]
    constructor
    · intro hx
      by_contra hne
      have h1 : (1 : K) ∈ pt.asIdeal := by
        rw [← mul_inv_cancel₀ hne]
        exact pt.asIdeal.mul_mem_right x⁻¹ hx
      exact pt.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    · rintro rfl
      exact pt.asIdeal.zero_mem
  refine ⟨?_, ?_, ?_⟩
  · intro R _ c_R d
    let f_k : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d) k) :=
      CommRingCat.ofHom MvPolynomial.C
    let g_k : CommRingCat.of k ⟶ CommRingCat.of R :=
      CommRingCat.ofHom c_R
    let inl_k : CommRingCat.of (MvPolynomial (Fin d) k) ⟶
        CommRingCat.of (MvPolynomial (Fin d) R) :=
      CommRingCat.ofHom (MvPolynomial.map c_R)
    let inr_k : CommRingCat.of R ⟶ CommRingCat.of (MvPolynomial (Fin d) R) :=
      CommRingCat.ofHom MvPolynomial.C
    have hcomm : f_k ≫ inl_k = g_k ≫ inr_k := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact MvPolynomial.map_C c_R a
    have hPush : CategoryTheory.IsPushout f_k g_k inl_k inr_k :=
      CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
          (fun sc => CommRingCat.ofHom
            (MvPolynomial.eval₂Hom sc.inr.hom
              (fun i : Fin d => sc.inl.hom (MvPolynomial.X i))))
          (fun sc => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro a
              change (MvPolynomial.eval₂Hom sc.inr.hom
                (fun i : Fin d => sc.inl.hom (MvPolynomial.X i)))
                ((MvPolynomial.map c_R) (MvPolynomial.C a)) =
                sc.inl.hom (MvPolynomial.C a)
              rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
              exact (congrArg (fun φ => φ.hom a) sc.condition).symm
            · intro i
              change (MvPolynomial.eval₂Hom sc.inr.hom
                (fun j : Fin d => sc.inl.hom (MvPolynomial.X j)))
                ((MvPolynomial.map c_R) (MvPolynomial.X i)) =
                sc.inl.hom (MvPolynomial.X i)
              rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X'])
          (fun sc => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro r
            exact MvPolynomial.eval₂Hom_C sc.inr.hom
              (fun i : Fin d => sc.inl.hom (MvPolynomial.X i)) r)
          (fun sc m_hom hm1 hm2 => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro r
              have hr := congrArg (fun φ => φ.hom r) hm2
              exact hr.trans (MvPolynomial.eval₂Hom_C sc.inr.hom
                (fun i : Fin d => sc.inl.hom (MvPolynomial.X i)) r).symm
            · intro i
              have hi := congrArg (fun φ => φ.hom (MvPolynomial.X i)) hm1
              change m_hom.hom ((MvPolynomial.map c_R) (MvPolynomial.X i)) =
                sc.inl.hom (MvPolynomial.X i) at hi
              rw [MvPolynomial.map_X] at hi
              exact hi.trans (MvPolynomial.eval₂Hom_X' sc.inr.hom
                (fun j : Fin d => sc.inl.hom (MvPolynomial.X j)) i).symm))
    have hPb : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_k)
        (AlgebraicGeometry.Spec.map inr_k)
        (weilAffineSpaceOver k d).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_R)) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_k g_k inl_k inr_k hPush
    exact ⟨hPb.isoPullback, hPb.isoPullback_hom_snd⟩
  · intro Q_R pr₂_Q _ U_0 V_R e_M hCov he_M_pr2 he_M_basic ι_aff_Q
    have hι_open : AlgebraicGeometry.IsOpenImmersion ι_aff_Q := by
      dsimp [ι_aff_Q]
      infer_instance
    refine ⟨hι_open, ?_⟩
    have hπ_surj : Function.Surjective π_cl := by
      intro c
      refine ⟨p_R (Polynomial.C c), ?_⟩
      change (π_cl.comp p_R) (Polynomial.C c) = c
      rw [hπ_pR, Polynomial.coe_evalRingHom, Polynomial.eval_C]
    have hSpec_π_cl : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom π_cl) hπ_surj
    let pt_k : PrimeSpectrum k := ⟨⊥, inferInstance⟩
    let Idx := Fin (m + 1) × Fin 2
    let G_rel : MvPolynomial Idx R_bar :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C h_R
    let I_R : Ideal (MvPolynomial Idx R_bar) := Ideal.span {G_rel}
    have hπ_hR : π_cl h_R = 0 := by
      rw [← RingHom.mem_ker, hπ_ker]
      exact hh_max
    let ε_pre : MvPolynomial Idx R_bar →+* k :=
      MvPolynomial.eval₂Hom π_cl (fun _ => 0)
    have hε_ker : ∀ a ∈ I_R, ε_pre a = 0 := by
      change I_R ≤ RingHom.ker ε_pre
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      simp [G_rel, ε_pre, hπ_hR]
    let ε_M : (MvPolynomial Idx R_bar ⧸ I_R) →+* k :=
      Ideal.Quotient.lift I_R ε_pre hε_ker
    let zero_M₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        weilOdpModelSpec m (CommRingCat.of R_bar) h_R :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_M)
    let zero_Q : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_R :=
      zero_M₀ ≫ ι_aff_Q
    have hzero_Q_pr2 : zero_Q ≫ pr₂_Q =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) := by
      dsimp only [zero_Q, ι_aff_Q]
      rw [Category.assoc, Category.assoc, he_M_pr2]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_M) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      change ε_M (Ideal.Quotient.mk I_R (MvPolynomial.C r)) = π_cl r
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.eval₂Hom_C _ _ r
    have hzero_Q_comp_cl : AlgebraicGeometry.IsClosedImmersion (zero_Q ≫ pr₂_Q) := by
      rw [hzero_Q_pr2]
      exact hSpec_π_cl
    have hzero_Q_cl : AlgebraicGeometry.IsClosedImmersion zero_Q :=
      AlgebraicGeometry.IsClosedImmersion.of_comp zero_Q pr₂_Q
    let U_Q : Q_R.Opens :=
      ⟨(Set.range zero_Q.base)ᶜ, zero_Q.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have hVR_le_UQ : ∀ a : Fin (2 * (m + 1)), V_R a ≤ U_Q := by
      intro a x hxa
      rintro ⟨pt, hpt_eq⟩
      let j : Fin (m + 1) := ⟨a.1 / 2, by omega⟩
      let b : Fin 2 := ⟨a.1 % 2, by omega⟩
      have ha_eq : (⟨2 * j.1 + b.1, by omega⟩ : Fin (2 * (m + 1))) = a :=
        Fin.ext (by dsimp [j, b]; omega)
      have hnot_in :
          Ideal.Quotient.mk I_R (MvPolynomial.X (j, b)) ∉ (zero_M₀.base pt).asIdeal := by
        change zero_M₀.base pt ∈
          PrimeSpectrum.basicOpen (Ideal.Quotient.mk I_R (MvPolynomial.X (j, b)))
        rw [← he_M_basic j b]
        change ι_aff_Q.base (zero_M₀.base pt) ∈ V_R ⟨2 * j.1 + b.1, by omega⟩
        rw [ha_eq]
        change zero_Q.base pt ∈ V_R a
        rwa [hpt_eq]
      have hin :
          Ideal.Quotient.mk I_R (MvPolynomial.X (j, b)) ∈ (zero_M₀.base pt).asIdeal := by
        change ε_M (Ideal.Quotient.mk I_R (MvPolynomial.X (j, b))) ∈ pt.asIdeal
        rw [Ideal.Quotient.lift_mk]
        change ε_pre (MvPolynomial.X (j, b)) ∈ pt.asIdeal
        rw [MvPolynomial.eval₂Hom_X']
        exact pt.asIdeal.zero_mem
      exact hnot_in hin
    refine ⟨zero_Q, U_Q, hzero_Q_cl, hzero_Q_pr2, ?_, rfl, hVR_le_UQ, ?_, ?_⟩
    · intro zero_M hzero_X hzero_C
      let ψ_hom : CommRingCat.of (MvPolynomial Idx R_bar ⧸ I_R) ⟶ CommRingCat.of k :=
        AlgebraicGeometry.Spec.preimage zero_M
      have hψ_spec : AlgebraicGeometry.Spec.map ψ_hom = zero_M :=
        AlgebraicGeometry.Spec.map_preimage zero_M
      have hψ_eq : ψ_hom = CommRingCat.ofHom ε_M := by
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          have hC_eq :
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C) ≫ ψ_hom) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) := by
            rw [AlgebraicGeometry.Spec.map_comp, hψ_spec]
            exact hzero_C
          have hhom_eq := AlgebraicGeometry.Spec.map_injective hC_eq
          have hr := congrArg (fun φ => φ.hom r) hhom_eq
          change ψ_hom.hom (Ideal.Quotient.mk I_R (MvPolynomial.C r)) = π_cl r at hr
          change ψ_hom.hom (Ideal.Quotient.mk I_R (MvPolynomial.C r)) =
            ε_M (Ideal.Quotient.mk I_R (MvPolynomial.C r))
          rw [hr, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        · intro idx
          have hX := hzero_X pt_k idx
          rw [← hψ_spec] at hX
          change ψ_hom.hom (Ideal.Quotient.mk I_R (MvPolynomial.X idx)) ∈ pt_k.asIdeal at hX
          have hX0 : ψ_hom.hom (Ideal.Quotient.mk I_R (MvPolynomial.X idx)) = 0 :=
            Ideal.mem_bot.mp hX
          change ψ_hom.hom (Ideal.Quotient.mk I_R (MvPolynomial.X idx)) =
            ε_M (Ideal.Quotient.mk I_R (MvPolynomial.X idx))
          rw [hX0, Ideal.Quotient.lift_mk]
          exact (MvPolynomial.eval₂Hom_X' π_cl (fun _ => 0) idx).symm
      dsimp only [zero_Q, zero_M₀]
      rw [← hψ_spec, hψ_eq]
    · apply le_antisymm (iSup_le hVR_le_UQ)
      intro x hx_UQ
      by_contra hx_not_sup
      have hx_top : x ∈ (U_0 ⊔ (⨆ a : Fin (2 * (m + 1)), V_R a) : Q_R.Opens) := by
        rw [hCov]
        trivial
      have hx_U0 : x ∈ U_0 := by
        rcases TopologicalSpace.Opens.mem_sup.mp hx_top with h0 | hsup
        · exact h0
        · exact False.elim (hx_not_sup hsup)
      let z : weilOdpModelSpec m (CommRingCat.of R_bar) h_R :=
        e_M.inv.base ⟨x, hx_U0⟩
      have hz_x : ι_aff_Q.base z = x := by
        dsimp only [ι_aff_Q, z]
        have hid : (e_M.inv ≫ e_M.hom).base ⟨x, hx_U0⟩ = ⟨x, hx_U0⟩ := by
          rw [e_M.inv_hom_id]
          rfl
        change U_0.ι.base ((e_M.inv ≫ e_M.hom).base ⟨x, hx_U0⟩) = x
        rw [hid]
        rfl
      have hz_X : ∀ idx : Idx,
          Ideal.Quotient.mk I_R (MvPolynomial.X idx) ∈ z.asIdeal := by
        rintro ⟨j, b⟩
        let a : Fin (2 * (m + 1)) := ⟨2 * j.1 + b.1, by omega⟩
        have hx_not_a : x ∉ V_R a :=
          fun hxa => hx_not_sup (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxa⟩)
        have hz_not_basic :
            z ∉ PrimeSpectrum.basicOpen (Ideal.Quotient.mk I_R (MvPolynomial.X (j, b))) := by
          rw [← he_M_basic j b]
          intro hmem
          apply hx_not_a
          change x ∈ V_R ⟨2 * j.1 + b.1, by omega⟩
          rwa [← hz_x]
        exact Classical.not_not.mp hz_not_basic
      have hS_X :
          (∑ j : Fin (m + 1),
            Ideal.Quotient.mk I_R (MvPolynomial.X (j, 0)) *
              Ideal.Quotient.mk I_R (MvPolynomial.X (j, 1))) ∈ z.asIdeal :=
        z.asIdeal.sum_mem fun j _ => z.asIdeal.mul_mem_right _ (hz_X (j, 0))
      have hrel_zero :
          (∑ j : Fin (m + 1),
            Ideal.Quotient.mk I_R (MvPolynomial.X (j, 0)) *
              Ideal.Quotient.mk I_R (MvPolynomial.X (j, 1))) -
            Ideal.Quotient.mk I_R (MvPolynomial.C h_R) = 0 := by
        have hmk0 : Ideal.Quotient.mk I_R G_rel = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self G_rel)
        simpa only [G_rel, map_sub, map_sum, map_mul] using hmk0
      have hh_in_z : Ideal.Quotient.mk I_R (MvPolynomial.C h_R) ∈ z.asIdeal := by
        rw [← sub_eq_zero.mp hrel_zero]
        exact hS_X
      let q : Ideal R_bar :=
        Ideal.comap ((Ideal.Quotient.mk I_R).comp MvPolynomial.C) z.asIdeal
      have hq_prime : q.IsPrime := z.isPrime.comap ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)
      have hh_in_q : h_R ∈ q := hh_in_z
      have hq_ne_bot : q ≠ ⊥ := by
        intro hbot
        rw [hbot] at hh_in_q
        exact hh_ne (Ideal.mem_bot.mp hh_in_q)
      have hq_ker : q = RingHom.ker π_cl := by
        rcases hSpec2 q hq_prime with hbot | hmax
        · exact False.elim (hq_ne_bot hbot)
        · exact hmax.trans hπ_ker.symm
      let c_0 : MvPolynomial Idx R_bar →+* R_bar :=
        MvPolynomial.eval₂Hom (RingHom.id R_bar) (fun _ => 0)
      have hπ_c0 : π_cl.comp c_0 = ε_pre := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp [c_0, ε_pre]
        · intro idx
          simp [c_0, ε_pre]
      have h_diff : ∀ P : MvPolynomial Idx R_bar,
          Ideal.Quotient.mk I_R P -
            Ideal.Quotient.mk I_R (MvPolynomial.C (c_0 P)) ∈ z.asIdeal := by
        intro P
        refine MvPolynomial.induction_on
          (motive := fun P =>
            Ideal.Quotient.mk I_R P -
              Ideal.Quotient.mk I_R (MvPolynomial.C (c_0 P)) ∈ z.asIdeal) P ?_ ?_ ?_
        · intro r
          dsimp only [c_0]
          rw [MvPolynomial.eval₂Hom_C, RingHom.id_apply, sub_self]
          exact z.asIdeal.zero_mem
        · intro p₁ p₂ hp₁ hp₂
          have hadd :
              Ideal.Quotient.mk I_R (p₁ + p₂) -
                Ideal.Quotient.mk I_R (MvPolynomial.C (c_0 (p₁ + p₂))) =
              (Ideal.Quotient.mk I_R p₁ -
                Ideal.Quotient.mk I_R (MvPolynomial.C (c_0 p₁))) +
              (Ideal.Quotient.mk I_R p₂ -
                Ideal.Quotient.mk I_R (MvPolynomial.C (c_0 p₂))) := by
            simp only [map_add]
            abel
          rw [hadd]
          exact z.asIdeal.add_mem hp₁ hp₂
        · intro p idx _
          have hc0_mul : c_0 (p * MvPolynomial.X idx) = 0 := by
            dsimp only [c_0]
            rw [map_mul, MvPolynomial.eval₂Hom_X', mul_zero]
          rw [hc0_mul, map_zero, map_zero, sub_zero, map_mul]
          exact z.asIdeal.mul_mem_left _ (hz_X idx)
      have hz_eq_zero : z = zero_M₀.base pt_k := by
        apply PrimeSpectrum.ext
        ext u
        rcases Ideal.Quotient.mk_surjective u with ⟨P, rfl⟩
        have hP_iff :
            Ideal.Quotient.mk I_R P ∈ z.asIdeal ↔
              Ideal.Quotient.mk I_R (MvPolynomial.C (c_0 P)) ∈ z.asIdeal := by
          constructor
          · intro hP
            have hsub := z.asIdeal.sub_mem hP (h_diff P)
            rwa [sub_sub_cancel] at hsub
          · intro hC
            have hadd := z.asIdeal.add_mem (h_diff P) hC
            rwa [sub_add_cancel] at hadd
        rw [hP_iff]
        change c_0 P ∈ q ↔ ε_M (Ideal.Quotient.mk I_R P) ∈ pt_k.asIdeal
        rw [hq_ker, RingHom.mem_ker, Ideal.mem_bot, Ideal.Quotient.lift_mk, ← hπ_c0]
        rfl
      have hx_in_zero : x ∈ Set.range zero_Q.base := by
        refine ⟨pt_k, ?_⟩
        dsimp only [zero_Q]
        change ι_aff_Q.base (zero_M₀.base pt_k) = x
        rwa [← hz_eq_zero]
      exact hx_UQ hx_in_zero
    · intro X_Ω q_Ω j_tot hPb_tot
      have hRange : Set.range j_tot.base ⊆ Set.range U_Q.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨w, rfl⟩ ⟨pt, hpt_eq⟩
        have hbase_eq :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)).base pt =
              j_R.base (q_Ω.base w) := by
          rw [← hzero_Q_pr2]
          change pr₂_Q.base (zero_Q.base pt) = (q_Ω ≫ j_R).base w
          rw [hpt_eq, hPb_tot.w]
          rfl
        have hh_lhs :
            h_R ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)).base pt).asIdeal := by
          change π_cl h_R ∈ pt.asIdeal
          rw [hπ_hR]
          exact pt.asIdeal.zero_mem
        rw [hbase_eq] at hh_lhs
        have hh_rhs : φ_R_Ω h_R ∈ (q_Ω.base w).asIdeal := hh_lhs
        rw [hFieldIdeal (q_Ω.base w)] at hh_rhs
        have hφ_zero : φ_R_Ω h_R = 0 := Ideal.mem_bot.mp hh_rhs
        exact hh_ne (hφ_inj (hφ_zero.trans (map_zero φ_R_Ω).symm))
      let j_open : X_Ω ⟶ U_Q.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_Q.ι j_tot hRange
      have hj_fac : j_open ≫ U_Q.ι = j_tot :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_Q.ι j_tot hRange
      have hcomm_open : q_Ω ≫ j_R = j_open ≫ (U_Q.ι ≫ pr₂_Q) := by
        rw [← Category.assoc, hj_fac]
        exact hPb_tot.w
      have hPb_open : CategoryTheory.IsPullback q_Ω j_open j_R (U_Q.ι ≫ pr₂_Q) :=
        CategoryTheory.IsPullback.of_isLimit
          (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm_open
            (fun s => hPb_tot.lift s.fst (s.snd ≫ U_Q.ι)
              (by rw [Category.assoc]; exact s.condition))
            (fun s => hPb_tot.lift_fst _ _ _)
            (fun s => by
              rw [← CategoryTheory.cancel_mono U_Q.ι, Category.assoc, hj_fac]
              exact hPb_tot.lift_snd _ _ _)
            (fun s m_hom hm1 hm2 =>
              hPb_tot.hom_ext
                (hm1.trans (hPb_tot.lift_fst _ _ _).symm)
                (by rw [hPb_tot.lift_snd, ← hj_fac, ← Category.assoc, hm2])))
      exact ⟨j_open, hj_fac, hPb_open⟩
  · intro d X X_Ω p_X q_X j_X hPb_X S_d A_R A_Ω j_A V φ hφ_base
    let snd_AR := CategoryTheory.Limits.pullback.snd S_d.hom g_k_R
    let V_U := CategoryTheory.Limits.pullback j_X V.ι
    let ι_VU := CategoryTheory.Limits.pullback.fst j_X V.ι
    let j_V := CategoryTheory.Limits.pullback.snd j_X V.ι
    have hPb1 : CategoryTheory.IsPullback ι_VU j_V j_X V.ι :=
      CategoryTheory.IsPullback.of_hasPullback j_X V.ι
    have hPb_outer : CategoryTheory.IsPullback (ι_VU ≫ q_X) j_V j_R (φ ≫ snd_AR) := by
      have hp := hPb1.paste_horiz hPb_X
      rwa [← hφ_base] at hp
    let φ_U : V_U ⟶ A_Ω :=
      CategoryTheory.Limits.pullback.lift (ι_VU ≫ q_X) (j_V ≫ φ)
        (by rw [Category.assoc]; exact hPb_outer.w)
    have hPb2 : CategoryTheory.IsPullback φ_U j_V j_A φ :=
      CategoryTheory.IsPullback.of_right
        (by
          dsimp only [φ_U]
          rw [CategoryTheory.Limits.pullback.lift_fst]
          exact hPb_outer)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback j_R snd_AR)
    exact ⟨V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩

theorem weil_odp_coker_proj_quadric_degeneration_and_charts (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (hSpec2 : ∀ q : Ideal R_bar, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal R_bar)
    (p_R : Polynomial k →+* R_bar)
    (π_cl : R_bar →+* k)
    (hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar)
    (hπ_pR : π_cl.comp p_R = Polynomial.evalRingHom 0)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (φ_R_Ω : R_bar →+* Ω) (hφ_inj : Function.Injective φ_R_Ω)
    (h_R : R_bar)
    (hh_max : h_R ∈ IsLocalRing.maximalIdeal R_bar) (hh_ne : h_R ≠ 0) :
    let F_amb_k : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) k :=
      ∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) k) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    let F_amb_Ω : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω :=
      ∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let S_d1 := weilAffineSpaceOver k (2 * m + 1)
    let A1_R := CategoryTheory.Limits.pullback S_d1.hom g_k_R
    let A1_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d1.hom g_k_R)
    let j_A1 : A1_Ω ⟶ A1_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d1.hom g_k_R)
    let S_d2 := weilAffineSpaceOver k (2 * (m + 1))
    let A2_R := CategoryTheory.Limits.pullback S_d2.hom g_k_R
    let A2_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d2.hom g_k_R)
    let j_A2 : A2_Ω ⟶ A2_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d2.hom g_k_R)
    ∃ (Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π_Qfam : Q_fam ⟶ weilPolyLineSpecOver k)
      (_ : AlgebraicGeometry.IsProper π_Qfam.left)
      (g_hR : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ (weilPolyLineSpecOver k).left)
      (Q_succ Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (_ : AlgebraicGeometry.IsProper Q_succ.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_succ.hom)
      (_ : AlgebraicGeometry.IsProper Z_cone.hom)
      (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver k (2 * (m + 1) + 1)).left)
      (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver k (2 * (m + 1) + 1)).hom = Q_succ.hom)
      (i_Z : Z_cone ⟶ Q_succ)
      (Q_amb_Ω Q_sm_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (_ : AlgebraicGeometry.IsProper Q_amb_Ω.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_amb_Ω.hom)
      (_ : AlgebraicGeometry.IsProper Q_sm_Ω.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Q_sm_Ω.hom)
      (ι_amb_Ω : Q_amb_Ω.left ⟶ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left)
      (hι_amb_Ω : ι_amb_Ω ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb_Ω.hom)
      (i_sm_Ω : Q_sm_Ω ⟶ Q_amb_Ω)
      (i_hyp_R : CategoryTheory.Limits.pullback π_Qfam.left g_hR ⟶
        CategoryTheory.Limits.pullback Q_succ.hom g_k_R)
      (e_Qk : CategoryTheory.Limits.pullback π_Qfam.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_hR) ≅ Z_cone.left)
      (zero_Q : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        CategoryTheory.Limits.pullback π_Qfam.left g_hR)
      (ι_aff_Q : weilOdpModelSpec m (CommRingCat.of R_bar) h_R ⟶
        CategoryTheory.Limits.pullback π_Qfam.left g_hR)
      (U_Q : (CategoryTheory.Limits.pullback π_Qfam.left g_hR).Opens)
      (j_Q_open : Q_sm_Ω.left ⟶ U_Q.toScheme)
      (j_amb_open : Q_amb_Ω.left ⟶ CategoryTheory.Limits.pullback Q_succ.hom g_k_R),
      (g_hR ≫ (weilPolyLineSpecOver k).hom = g_k_R ∧
        IsHomogeneousHypersurfacePullbackOver k (2 * (m + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver k (2 * (m + 1) + 1))) F_amb_k ι_succ ∧
        IsHomogeneousHypersurfacePullbackOver k (2 * (m + 1) + 1) 1
          (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) i_Z.left ∧
        IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))) F_amb_Ω ι_amb_Ω ∧
        IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 1
          (CategoryTheory.Over.homMk ι_amb_Ω hι_amb_Ω)
          (MvPolynomial.X 0 + MvPolynomial.C (φ_R_Ω h_R) * MvPolynomial.X 1) i_sm_Ω.left) ∧
      (AlgebraicGeometry.IsClosedImmersion zero_Q ∧
        AlgebraicGeometry.IsOpenImmersion ι_aff_Q ∧
        (∀ zero_M : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            weilOdpModelSpec m (CommRingCat.of R_bar) h_R,
          (∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of k)) (idx : Fin (m + 1) × Fin 2),
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (zero_M.base pt).asIdeal) →
          zero_M ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) →
          zero_M ≫ ι_aff_Q = zero_Q) ∧
        (U_Q : Set ↥(CategoryTheory.Limits.pullback π_Qfam.left g_hR)) =
          (Set.range zero_Q.base)ᶜ ∧
        j_Q_open ≫ U_Q.ι ≫ i_hyp_R = i_sm_Ω.left ≫ j_amb_open) ∧
      (∀ x : ↥U_Q.toScheme,
        ∃ (V : U_Q.toScheme.Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A1_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Q_sm_Ω.left) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A1_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_Q_open V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A1 φ) ∧
      (∀ x : ↥(CategoryTheory.Limits.pullback Q_succ.hom g_k_R),
        ∃ (V : (CategoryTheory.Limits.pullback Q_succ.hom g_k_R).Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A2_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Q_amb_Ω.left) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A2_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_amb_open V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A2 φ) :=
by
  intro F_amb_k F_amb_Ω g_k_R j_R S_d1 A1_R A1_Ω j_A1 S_d2 A2_R A2_Ω j_A2
  let M : ℕ := 2 * (m + 1)

  
  have hF_amb_hom : ∀ (K : Type u) [Field K],
      (∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0) ∈
      MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) K ((2 : ℕ) • 1) := by
    intro K _
    rw [MvPolynomial.mem_homogeneousSubmodule]
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ => ?_
    split_ifs with h
    · change MvPolynomial.IsHomogeneous _ (1 + 1)
      exact MvPolynomial.IsHomogeneous.mul
        (MvPolynomial.isHomogeneous_X K (⟨2 * j, Nat.lt_of_succ_lt h⟩ : Fin (2 * (m + 1) + 1 + 1)))
        (MvPolynomial.isHomogeneous_X K (⟨2 * j + 1, h⟩ : Fin (2 * (m + 1) + 1 + 1)))
    · exact MvPolynomial.isHomogeneous_zero (Fin (2 * (m + 1) + 1 + 1)) K _

  have hX0_hom_k :
      (MvPolynomial.X 0 : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) k ((1 : ℕ) • 1) := by
    rw [one_smul, MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.isHomogeneous_X k (0 : Fin (2 * (m + 1) + 1 + 1))

  have hLin_hom_Ω :
      (MvPolynomial.X 0 + MvPolynomial.C (φ_R_Ω h_R) * MvPolynomial.X 1 :
        MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) Ω ((1 : ℕ) • 1) := by
    rw [one_smul, MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.IsHomogeneous.add
      (MvPolynomial.isHomogeneous_X Ω (0 : Fin (2 * (m + 1) + 1 + 1)))
      (MvPolynomial.IsHomogeneous.C_mul
        (MvPolynomial.isHomogeneous_X Ω (1 : Fin (2 * (m + 1) + 1 + 1))) (φ_R_Ω h_R))

  obtain ⟨Q_succ, ι_succ_ov, hSplit_succ⟩ :=
    (weil_split_quad_hypersurface_pullback_and_cone_vertex k).1
      (2 * (m + 1) + 1) 2 (by decide)
      (weilProjectiveSpaceOver k (2 * (m + 1) + 1))
      (𝟙 (weilProjectiveSpaceOver k (2 * (m + 1) + 1)))
      F_amb_k (hF_amb_hom k)
  let ι_succ := ι_succ_ov.left
  have hι_succ : ι_succ ≫ (weilProjectiveSpaceOver k (2 * (m + 1) + 1)).hom = Q_succ.hom :=
    ι_succ_ov.w

  obtain ⟨Z_cone, i_Z, hSplit_Z⟩ :=
    (weil_split_quad_hypersurface_pullback_and_cone_vertex k).1
      (2 * (m + 1) + 1) 1 (by decide)
      Q_succ (CategoryTheory.Over.homMk ι_succ hι_succ)
      (MvPolynomial.X 0) hX0_hom_k

  obtain ⟨Q_amb_Ω, ι_amb_ov, hSplit_amb⟩ :=
    (weil_split_quad_hypersurface_pullback_and_cone_vertex Ω).1
      (2 * (m + 1) + 1) 2 (by decide)
      (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))
      (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)))
      F_amb_Ω (hF_amb_hom Ω)
  let ι_amb_Ω := ι_amb_ov.left
  have hι_amb_Ω : ι_amb_Ω ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb_Ω.hom :=
    ι_amb_ov.w

  obtain ⟨Q_sm_Ω, i_sm_Ω, hSplit_sm⟩ :=
    (weil_split_quad_hypersurface_pullback_and_cone_vertex Ω).1
      (2 * (m + 1) + 1) 1 (by decide)
      Q_amb_Ω (CategoryTheory.Over.homMk ι_amb_Ω hι_amb_Ω)
      (MvPolynomial.X 0 + MvPolynomial.C (φ_R_Ω h_R) * MvPolynomial.X 1) hLin_hom_Ω

  have _ : AlgebraicGeometry.IsClosedImmersion ι_succ_ov.left := hSplit_succ.1
  have _ : AlgebraicGeometry.IsClosedImmersion i_Z.left := hSplit_Z.1
  have _ : AlgebraicGeometry.IsClosedImmersion ι_amb_ov.left := hSplit_amb.1
  have _ : AlgebraicGeometry.IsClosedImmersion i_sm_Ω.left := hSplit_sm.1

  have hProp_Qsucc : AlgebraicGeometry.IsProper Q_succ.hom :=
    weil_canonical_and_projective_baseChange_models.{u}.1 k Q_succ
      ⟨2 * (m + 1) + 1, ι_succ_ov, hSplit_succ.1⟩
  have hProp_Zcone : AlgebraicGeometry.IsProper Z_cone.hom :=
    weil_canonical_and_projective_baseChange_models.{u}.1 k Z_cone
      ⟨2 * (m + 1) + 1, i_Z ≫ ι_succ_ov, by
        change AlgebraicGeometry.IsClosedImmersion (i_Z.left ≫ ι_succ_ov.left)
        infer_instance⟩
  have hProp_Qamb : AlgebraicGeometry.IsProper Q_amb_Ω.hom :=
    weil_canonical_and_projective_baseChange_models.{u}.1 Ω Q_amb_Ω
      ⟨2 * (m + 1) + 1, ι_amb_ov, hSplit_amb.1⟩
  have hProp_Qsm : AlgebraicGeometry.IsProper Q_sm_Ω.hom :=
    weil_canonical_and_projective_baseChange_models.{u}.1 Ω Q_sm_Ω
      ⟨2 * (m + 1) + 1, i_sm_Ω ≫ ι_amb_ov, by
        change AlgebraicGeometry.IsClosedImmersion (i_sm_Ω.left ≫ ι_amb_ov.left)
        infer_instance⟩

  obtain ⟨hW_succ_cov, hW_succ_iso, -, -⟩ :=
    (weil_split_quad_chart_partner_elim_and_irred_cover k).2 (m + 1) Q_succ ι_succ hι_succ hSplit_succ
  have hSm_Qsucc : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_succ.hom :=
    ((weil_split_quad_chart_partner_elim_and_irred_cover k).1
      (2 * (m + 1)) (2 * (m + 1) + 2) (by omega) Q_succ _ hW_succ_cov hW_succ_iso).1

  obtain ⟨hW_amb_cov, hW_amb_iso, -, -⟩ :=
    (weil_split_quad_chart_partner_elim_and_irred_cover Ω).2 (m + 1) Q_amb_Ω ι_amb_Ω hι_amb_Ω hSplit_amb
  have hSm_Qamb : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_amb_Ω.hom :=
    ((weil_split_quad_chart_partner_elim_and_irred_cover Ω).1
      (2 * (m + 1)) (2 * (m + 1) + 2) (by omega) Q_amb_Ω _ hW_amb_cov hW_amb_iso).1

  
  obtain ⟨hProjProp, Ψ_fam, hΨ_hom, hΨ_commRing, hΨ_field⟩ :=
