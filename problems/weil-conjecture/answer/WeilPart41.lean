      B_δ.left.topIso.hom ≫ j_δ ≫ e_Yδ.hom
    have hEt_ψδ : AlgebraicGeometry.Etale ψ_δ :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ inferInstance
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          j_δ e_Yδ.hom hEt_jδ inferInstance)
    have hψδ_hom : ψ_δ ≫ S_succ.hom = (⊤ : B_δ.left.Opens).ι ≫ B_δ.hom := by
      dsimp [ψ_δ]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_Yδ_hom,
        AlgebraicGeometry.Scheme.topIso_hom, hBδ_hom, CategoryTheory.Category.assoc]
    let pr_B := CategoryTheory.Limits.pullback.fst B_δ.hom S_1.hom
    let pr_1 := CategoryTheory.Limits.pullback.snd B_δ.hom S_1.hom
    have h_comm_W : (pr_B ≫ (j_δ ≫ fst_Yδ)) ≫ S_δ.hom = pr_1 ≫ S_1.hom := by
      rw [CategoryTheory.Category.assoc, ← hBδ_hom, CategoryTheory.Limits.pullback.condition]
    let q_P : CategoryTheory.Limits.pullback B_δ.hom S_1.hom ⟶
        CategoryTheory.Limits.pullback S_δ.hom S_1.hom :=
      CategoryTheory.Limits.pullback.lift (pr_B ≫ (j_δ ≫ fst_Yδ)) pr_1 h_comm_W
    have hOuter_W : CategoryTheory.IsPullback pr_B
        (q_P ≫ CategoryTheory.Limits.pullback.snd S_δ.hom S_1.hom)
        ((j_δ ≫ fst_Yδ) ≫ S_δ.hom) S_1.hom := by
      rw [CategoryTheory.Limits.pullback.lift_snd, ← hBδ_hom]
      exact CategoryTheory.IsPullback.of_hasPullback B_δ.hom S_1.hom
    have hSq_W : CategoryTheory.IsPullback pr_B q_P (j_δ ≫ fst_Yδ)
        (CategoryTheory.Limits.pullback.fst S_δ.hom S_1.hom) :=
      CategoryTheory.IsPullback.of_bot hOuter_W
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback S_δ.hom S_1.hom)
    have hPasteH : CategoryTheory.IsPullback (pr_B ≫ fst_Uδ) q_P (j_Gm ≫ p_A1)
        (CategoryTheory.Limits.pullback.fst S_δ.hom S_1.hom ≫ S_δ.hom) :=
      hSq_W.paste_horiz (hPb_U δ)
    have hBot_iso : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst S_δ.hom S_1.hom ≫ S_δ.hom) e_succ.hom
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) S_succ.hom :=
      CategoryTheory.IsPullback.of_vert_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, he_succ_hom]⟩
    have hPb_W_tot : CategoryTheory.IsPullback (pr_B ≫ fst_Uδ) (q_P ≫ e_succ.hom)
        (j_Gm ≫ p_A1) S_succ.hom := by
      have hp := hPasteH.paste_vert hBot_iso
      rwa [CategoryTheory.Category.comp_id] at hp
    exact ⟨B_δ, ψ_δ, hEt_ψδ, hψδ_hom, ⟨CategoryTheory.Iso.refl _⟩,
      ⟨hPb_W_tot.isoPullback ≪≫ (hPb_U (δ + 1)).isoPullback.symm⟩⟩

  
  
  
  have hA1Equiv : ∀ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (d M : ℕ) (W : Fin M → B.left.Opens)
      (ψ : ∀ α : Fin M, (W α).toScheme ⟶ (weilAffineSpaceOver Ω d).left)
      [∀ α : Fin M, AlgebraicGeometry.Etale (ψ α)],
      (⨆ α : Fin M, W α) = ⊤ →
      (∀ α : Fin M, ψ α ≫ (weilAffineSpaceOver Ω d).hom = (W α).ι ≫ B.hom) →
      ∀ q : ℕ,
        Nonempty (weilEtaleTorsionH B.left ℓ q ≃+
          weilEtaleTorsionH
            (CategoryTheory.Limits.pullback B.hom (weilAffineSpaceOver Ω 1).hom) ℓ q) := by
    intro B d M W ψ _ hSup hψ_hom q
    let S_d := weilAffineSpaceOver Ω d
    let S_1 := weilAffineSpaceOver Ω 1
    let V := CategoryTheory.Limits.pullback B.hom S_1.hom
    let π := CategoryTheory.Limits.pullback.fst B.hom S_1.hom
    obtain ⟨p_π, hp_π⟩ := hPullEx π ℓ q
    rcases hp_π with ⟨hCont, hRightAdj, hAdd, hLim, hColim, T_V, hT_V, T_B, hT_B, ιℤ, hι₁, hι₂, hp_π_eq⟩
    let _ := hCont
    let _ := hRightAdj
    let _ := hAdd
    let _ := hLim
    let _ := hColim
    let B_π := weilEtaleSitePullback π
    let J_V := V.smallEtaleTopology
    let J_B := B.left.smallEtaleTopology
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let F_V := weilEtaleTorsionSheaf V ℓ
    let F_B := weilEtaleTorsionSheaf B.left ℓ
    let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u} J_B J_V
    let adj_V := CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT_V
    let adj_B := CategoryTheory.constantSheafAdj J_B AddCommGrpCat.{u} hT_B
    let τ_π := hT_V.from (B_π.obj T_B)
    let η_π : F_B ⟶ pf_π.obj F_V :=
      (adj_B.homEquiv A_ℓ (pf_π.obj F_V)).symm
        (CategoryTheory.CategoryStruct.comp (adj_V.unit.app A_ℓ) (F_V.obj.map τ_π.op))
    have hIso_η : CategoryTheory.IsIso η_π :=
      hConstUnitIso π hT_V hT_B A_ℓ (hBasis B d M W ψ hSup)
    have hHDIZero : ∀ b : ℕ, 1 ≤ b →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π b F_V) := by
      intro b hb
      let R_B := weilEtaleHigherDirectImage π b F_V
      let P_d := CategoryTheory.Limits.pullback S_d.hom S_1.hom
      let pr₁ := CategoryTheory.Limits.pullback.fst S_d.hom S_1.hom
      let F_Pd := weilEtaleTorsionSheaf P_d ℓ
      let R_model := weilEtaleHigherDirectImage pr₁ b F_Pd
      have hZero_model : CategoryTheory.Limits.IsZero R_model := hA1Zero d b hb
      obtain ⟨hPB_ex, _, hPB_comp, hPB_const, _, _⟩ := weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
      refine weil_etale_geometric_point_stalk_conservativity B.left R_B ?_
      intro Ω' _ _ x_bar
      obtain ⟨pt₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω')) := inferInstance
      have hx_top : x_bar.base pt₀ ∈ (⨆ α : Fin M, W α) := by
        rw [hSup]; trivial
      obtain ⟨α, hxα⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_top
      have hrange_x : Set.range x_bar.base ⊆ Set.range (W α).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
        rwa [hpt]
      let x_W : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ (W α).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (W α).ι x_bar hrange_x
      have hx_W : x_W ≫ (W α).ι = x_bar :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W α).ι x_bar hrange_x
      obtain ⟨V_α, π_α, ι_Vα, hEt_ι, g_α, hEt_g, hPb₁, hPb₂⟩ := hSquares B d M W ψ hψ_hom α
      let _ : AlgebraicGeometry.Etale ι_Vα := hEt_ι
      let _ : AlgebraicGeometry.Etale g_α := hEt_g
      let F_Vα := weilEtaleTorsionSheaf V_α ℓ
      let R_Wα := weilEtaleHigherDirectImage π_α b F_Vα
      have hPB_Wα : WeilIsEtaleSheafPullback (W α).ι R_B R_Wα :=
        weil_leray_sec_etale_baseChange_higherDirectImage B.left V (W α).toScheme V_α
          π (W α).ι π_α ι_Vα hPb₁ F_V F_Vα (hPB_const ι_Vα A_ℓ) b
      have hPB_ψ : WeilIsEtaleSheafPullback (ψ α) R_model R_Wα :=
        weil_leray_sec_etale_baseChange_higherDirectImage S_d.left P_d (W α).toScheme V_α
          pr₁ (ψ α) π_α g_α hPb₂ F_Pd F_Vα (hPB_const g_α A_ℓ) b
      obtain ⟨F_pull, hPB_Fpull, _, hZero_Fpull_imp⟩ := hPB_ex (ψ α) R_model
      have hZero_Fpull : CategoryTheory.Limits.IsZero F_pull := hZero_Fpull_imp hZero_model
      have hZero_RWα : CategoryTheory.Limits.IsZero R_Wα := by
        rcases hPB_ψ with ⟨hc₁, hr₁, ⟨iso₁⟩⟩
        rcases hPB_Fpull with ⟨hc₂, hr₂, ⟨iso₂⟩⟩
        have h_c : hc₁ = hc₂ := Subsingleton.elim _ _
        subst h_c
        have h_r : hr₁ = hr₂ := Subsingleton.elim _ _
        subst h_r
        exact hZero_Fpull.of_iso (iso₁.symm ≪≫ iso₂)
      obtain ⟨G₀, hPB_xW, _, hZero_G₀_imp⟩ := hPB_ex x_W R_Wα
      have hZero_G₀ : CategoryTheory.Limits.IsZero G₀ := hZero_G₀_imp hZero_RWα
      have hPB_comp_x : WeilIsEtaleSheafPullback (x_W ≫ (W α).ι) R_B G₀ :=
        (hPB_comp x_W (W α).ι R_B R_Wα G₀).1 hPB_Wα hPB_xW
      rw [hx_W] at hPB_comp_x
      exact ⟨G₀, hPB_comp_x, hZero_G₀⟩
    have hBij_can := ((weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}).2.2.1
      π hT_V hT_B ιℤ hι₁ hι₂).1 F_B F_V η_π hIso_η hHDIZero q
    have hp_π_fun : (⇑p_π : weilEtaleTorsionH B.left ℓ q → weilEtaleTorsionH V ℓ q) = _ :=
      funext hp_π_eq
    have hBij_pπ : Function.Bijective p_π := by
      rw [hp_π_fun]
      exact hBij_can
    exact ⟨AddEquiv.ofBijective p_π hBij_pπ⟩

  have hGmVanish :
      let A1_Ω : AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))
      let Gm_Ω : AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial Ω)))
      let j_Gm : Gm_Ω ⟶ A1_Ω :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω))))
      let p_A1 : A1_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))
      ∀ (δ q : ℕ), 2 ≤ q →
        Subsingleton (weilEtaleTorsionH
          (CategoryTheory.Limits.pullback j_Gm
            (CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver Ω δ).hom p_A1)) ℓ q) := by
    intro A1_Ω Gm_Ω j_Gm p_A1 δ q hq
    obtain ⟨⟨hLFT_Gm, hDim_Gm⟩, ⟨e_U0⟩, hStep⟩ := hGmModel
    induction δ with
    | zero =>
      let U_Gm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
        CategoryTheory.Over.mk (j_Gm ≫ p_A1)
      have _ : AlgebraicGeometry.IsAffine U_Gm.left := by
        change AlgebraicGeometry.IsAffine Gm_Ω
        infer_instance
      have _ : AlgebraicGeometry.LocallyOfFiniteType U_Gm.hom := hLFT_Gm
      have hSub_Gm : Subsingleton (weilEtaleTorsionH U_Gm.left ℓ q) :=
        weil_affine_etale_cohomological_dimension Ω 1 ℓ q hℓ_ge1 (IsUnit.mk0 (ℓ : Ω) hℓ)
          U_Gm hDim_Gm (by omega)
      obtain ⟨eq_0⟩ := hPullIsoEquiv e_U0 q
      exact eq_0.symm.toEquiv.subsingleton
    | succ δ ih =>
      obtain ⟨B_δ, ψ_δ, hEt_ψ, hψ_hom, ⟨e_Bδ⟩, ⟨e_Wδ⟩⟩ := hStep δ
      have hEt_fam : ∀ _ : Fin 1, AlgebraicGeometry.Etale ψ_δ := fun _ => hEt_ψ
      obtain ⟨e_A1_step⟩ := @hA1Equiv B_δ (δ + 1) 1 (fun _ => ⊤) (fun _ => ψ_δ)
        hEt_fam iSup_const (fun _ => hψ_hom) q
      obtain ⟨eq_B⟩ := hPullIsoEquiv e_Bδ q
      obtain ⟨eq_W⟩ := hPullIsoEquiv e_Wδ q
      exact ((eq_B.trans e_A1_step).trans eq_W.symm).symm.toEquiv.subsingleton

  have hClopenH0 : ∀ (S : AlgebraicGeometry.Scheme.{u}) (O₀ O₁ : S.Opens),
      O₀ ⊓ O₁ = ⊥ →
      O₀ ⊔ O₁ = ⊤ →
      Nonempty (O₀.toScheme ≅ (weilAffineSpaceOver Ω 1).left) →
      Nonempty (O₁.toScheme ≅ (weilAffineSpaceOver Ω 1).left) →
      Finite (weilEtaleTorsionH S ℓ 0) ∧
      ∃ Φ : weilEtaleTorsionH S ℓ 0 →+ ZMod ℓ × ZMod ℓ, Function.Injective Φ := by
    have hInt_A1 : AlgebraicGeometry.IsIntegral (weilAffineSpaceOver Ω 1).left := by
      change AlgebraicGeometry.IsIntegral
        (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) Ω)))
      infer_instance
    have hIrr_A1 : IrreducibleSpace ↥(weilAffineSpaceOver Ω 1).left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral (weilAffineSpaceOver Ω 1).left hInt_A1
    have hConn_A1 : ConnectedSpace ↥(weilAffineSpaceOver Ω 1).left :=
      @IrreducibleSpace.connectedSpace _ _ hIrr_A1
    obtain ⟨e_A1_0⟩ := @hConnH0 (weilAffineSpaceOver Ω 1).left hConn_A1 ℓ
    rintro S O₀ O₁ hInf hSup ⟨iso₀⟩ ⟨iso₁⟩
    obtain ⟨p₀, hp₀⟩ := hPullEx O₀.ι ℓ 0
    obtain ⟨p₁, hp₁⟩ := hPullEx O₁.ι ℓ 0
    obtain ⟨eq₀⟩ := hPullIsoEquiv iso₀ 0
    obtain ⟨eq₁⟩ := hPullIsoEquiv iso₁ 0
    let φ₀ : weilEtaleTorsionH S ℓ 0 →+ ZMod ℓ :=
      e_A1_0.toAddMonoidHom.comp (eq₀.symm.toAddMonoidHom.comp p₀)
    let φ₁ : weilEtaleTorsionH S ℓ 0 →+ ZMod ℓ :=
      e_A1_0.toAddMonoidHom.comp (eq₁.symm.toAddMonoidHom.comp p₁)
    let Φ : weilEtaleTorsionH S ℓ 0 →+ ZMod ℓ × ZMod ℓ := AddMonoidHom.prod φ₀ φ₁
    have hΦ_inj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      have h0 : φ₀ x = 0 := congrArg Prod.fst hx
      have h1 : φ₁ x = 0 := congrArg Prod.snd hx
      have hp₀x : p₀ x = 0 := eq₀.symm.injective (e_A1_0.injective (by simpa [φ₀] using h0))
      have hp₁x : p₁ x = 0 := eq₁.symm.injective (e_A1_0.injective (by simpa [φ₁] using h1))
      exact weil_split_quad_retracted_point_modif_and_clopen_counit.1 S O₀ O₁ hInf hSup
        ℓ 0 p₀ p₁ hp₀ hp₁ x hp₀x hp₁x
    exact ⟨Finite.of_injective Φ hΦ_inj, ⟨Φ, hΦ_inj⟩⟩

  exact ⟨hA1Equiv, hGmVanish, hClopenH0⟩

theorem weil_aff_quad_codim1_purity_sheaf_iso (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : Ω) ≠ 0)
