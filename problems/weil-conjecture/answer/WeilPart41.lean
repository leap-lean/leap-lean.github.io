    have hPostβ_bij : Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀ β_h).postcomp one_U (Nat.add_zero q)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨(CategoryTheory.Abelian.Ext.mk₀ α_h).postcomp one_U (Nat.add_zero q), ?_, ?_⟩
      · intro x
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀ β_h) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ α_h) (Nat.add_zero q) = x
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβα_h,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
