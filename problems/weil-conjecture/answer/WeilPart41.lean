    have : Subsingleton ↥κ_star.ker := Finite.card_le_one_iff_subsingleton.mp hCard_kker
    let δ_ker : Q₀ → ↥κ_star.ker := fun y => ⟨δ y, hδ_ker y⟩
    have hδ_ker_inj : Function.Injective δ_ker := fun y₁ y₂ h =>
      hδ_inj (congrArg Subtype.val h)
    exact hδ_ker_inj.subsingleton

  
  
  
