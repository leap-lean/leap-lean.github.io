  have s5_sig : ∀ (F k : Type u) [Field F] [Field k] [Algebra F k] [Algebra.IsAlgebraic F k]
      (C₀ C_M L M : Type u) [CommRing C₀] [IsDomain C₀] [Algebra F C₀]
      [CommRing C_M] [IsDomain C_M] [Algebra k C_M] [Field L] [Field M]
      (i₀ : C₀ →+* L), Function.Injective i₀ →
      ∀ (i_M : C_M →+* M), Function.Injective i_M →
      ∀ (ψ_M : L →+* M) (ι_C : C₀ →+* C_M), Function.Injective ι_C →
      i_M.comp ι_C = ψ_M.comp i₀ →
      ι_C.comp (algebraMap F C₀) = (algebraMap k C_M).comp (algebraMap F k) →
      Algebra.adjoin k (Set.range ι_C) = ⊤ →
      ∀ (Q₀ : Ideal C₀), Q₀.IsPrime →
      ∃ Q_M : Ideal C_M,
        Q_M.IsPrime ∧
        Ideal.comap ι_C Q_M = Q₀ ∧
        ∀ (σ_L : L →+* L) (γ_M : M →+* M),
          (∀ y : L, γ_M (ψ_M y) = ψ_M (σ_L y)) →
          (∀ c : k, γ_M (i_M (algebraMap k C_M c)) = i_M (algebraMap k C_M c)) →
          (∀ y : C₀, σ_L (i₀ y) ∈ Set.range i₀) →
          (∀ z : C_M, γ_M (i_M z) ∈ Set.range i_M) →
          ((∀ z : C_M, γ_M (i_M z) - i_M z ∈ i_M '' (Q_M : Set C_M)) ↔
            (∀ y : C₀, σ_L (i₀ y) - i₀ y ∈ i₀ '' (Q₀ : Set C₀))) := by
    clear * -
    intro F k _ _ _ _ C₀ C_M L M _ _ _ _ _ _ _ _ i₀ hi₀ i_M hi_M ψ_M ι_C hι_inj
      h_comm_L h_comm_F h_adjoin Q₀ hQ₀
    let _ : Algebra C₀ C_M := ι_C.toAlgebra
    let _ : Algebra F C_M := ((algebraMap k C_M).comp (algebraMap F k)).toAlgebra
    have : IsScalarTower F k C_M := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : IsScalarTower F C₀ C_M :=
      IsScalarTower.of_algebraMap_eq fun c => (RingHom.congr_fun h_comm_F c).symm
    have : Algebra.IsIntegral C₀ C_M := by
      constructor
      intro z
      have hz_top : z ∈ (⊤ : Subalgebra k C_M) := Algebra.mem_top
      rw [← h_adjoin] at hz_top
      change z ∈ integralClosure C₀ C_M
      induction hz_top using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with ⟨y, rfl⟩
        exact isIntegral_algebraMap
      | algebraMap c =>
        have hc_F : IsIntegral F c := isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic c)
        have hc_CM : IsIntegral F (algebraMap k C_M c) :=
          IsIntegral.map (IsScalarTower.toAlgHom F k C_M) hc_F
        exact IsIntegral.tower_top hc_CM
      | add x y _ _ ihx ihy => exact Subalgebra.add_mem _ ihx ihy
      | mul x y _ _ ihx ihy => exact Subalgebra.mul_mem _ ihx ihy
    have hker : RingHom.ker (algebraMap C₀ C_M) ≤ Q₀ := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      have hx0 : x = 0 := hι_inj (hx.trans (map_zero ι_C).symm)
      rw [hx0]
      exact Q₀.zero_mem
    obtain ⟨Q_M, hQM_prime, hQM_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain Q₀ hker
    refine ⟨Q_M, hQM_prime, hQM_under, ?_⟩
    intro σ_L γ_M hγ_ψ hγ_k hσ_rng hγ_rng
    choose f₀ hf₀ using hσ_rng
    choose f_M hf_M using hγ_rng
    have hfM_add : ∀ z₁ z₂ : C_M, f_M (z₁ + z₂) = f_M z₁ + f_M z₂ := fun z₁ z₂ =>
      hi_M (by rw [map_add, hf_M, hf_M, hf_M, map_add, map_add])
    have hfM_mul : ∀ z₁ z₂ : C_M, f_M (z₁ * z₂) = f_M z₁ * f_M z₂ := fun z₁ z₂ =>
      hi_M (by rw [map_mul, hf_M, hf_M, hf_M, map_mul, map_mul])
    have hfM_k : ∀ c : k, f_M (algebraMap k C_M c) = algebraMap k C_M c := fun c =>
      hi_M ((hf_M _).trans (hγ_k c))
    have hfM_ι : ∀ y : C₀, f_M (ι_C y) = ι_C (f₀ y) := fun y =>
      hi_M <| calc
        i_M (f_M (ι_C y)) = γ_M (i_M (ι_C y)) := hf_M (ι_C y)
        _ = γ_M (ψ_M (i₀ y)) := congrArg γ_M (RingHom.congr_fun h_comm_L y)
        _ = ψ_M (σ_L (i₀ y)) := hγ_ψ (i₀ y)
        _ = ψ_M (i₀ (f₀ y)) := by rw [← hf₀ y]
        _ = i_M (ι_C (f₀ y)) := (RingHom.congr_fun h_comm_L (f₀ y)).symm
    have hiff_M : ∀ z : C_M,
        γ_M (i_M z) - i_M z ∈ i_M '' (Q_M : Set C_M) ↔ f_M z - z ∈ Q_M := by
      intro z
      rw [← hf_M z, ← map_sub]
      constructor
      · rintro ⟨w, hw, hw_eq⟩
        rwa [← hi_M hw_eq]
      · intro hz
        exact ⟨f_M z - z, hz, rfl⟩
    have hiff_0 : ∀ y : C₀,
        σ_L (i₀ y) - i₀ y ∈ i₀ '' (Q₀ : Set C₀) ↔ f₀ y - y ∈ Q₀ := by
      intro y
      rw [← hf₀ y, ← map_sub]
      constructor
      · rintro ⟨w, hw, hw_eq⟩
        rwa [← hi₀ hw_eq]
      · intro hy
        exact ⟨f₀ y - y, hy, rfl⟩
    simp_rw [hiff_M, hiff_0]
    constructor
    · intro hM y
      rw [← hQM_under, Ideal.mem_comap, map_sub]
      change ι_C (f₀ y) - ι_C y ∈ Q_M
      rw [← hfM_ι y]
      exact hM (ι_C y)
    · intro h0 z
      have hz_top : z ∈ (⊤ : Subalgebra k C_M) := Algebra.mem_top
      rw [← h_adjoin] at hz_top
      induction hz_top using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with ⟨y, rfl⟩
        rw [hfM_ι y, ← map_sub]
        have hy0 : f₀ y - y ∈ Q₀ := h0 y
        rw [← hQM_under, Ideal.mem_comap] at hy0
        exact hy0
      | algebraMap c =>
        rw [hfM_k c, sub_self]
        exact Q_M.zero_mem
      | add z₁ z₂ _ _ ih₁ ih₂ =>
        have hsub : f_M (z₁ + z₂) - (z₁ + z₂) = (f_M z₁ - z₁) + (f_M z₂ - z₂) := by
          rw [hfM_add]
          ring
        rw [hsub]
        exact Q_M.add_mem ih₁ ih₂
      | mul z₁ z₂ _ _ ih₁ ih₂ =>
        have hsub : f_M (z₁ * z₂) - z₁ * z₂ =
            f_M z₁ * (f_M z₂ - z₂) + (f_M z₁ - z₁) * z₂ := by
          rw [hfM_mul]
          ring
        rw [hsub]
        exact Q_M.add_mem (Q_M.mul_mem_left _ ih₂) (Q_M.mul_mem_right _ ih₁)

  
  intro ha_k hΔ_F hΔ_k _hj_R₀k_inj hj_R₀k_comp _hA_inf_r_inj ht_inf_r_eq hA_inf_r_top
