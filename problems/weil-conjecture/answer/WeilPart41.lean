      (CategoryTheory.Limits.pullback.fst f₀.left (i_Vs ≫ g_V))
      (CategoryTheory.Limits.pullback.snd f₀.left (i_Vs ≫ g_V) ≫ i_Vs)
      (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)

  have hιk_τV : ι_k_V ≫ τ_V = ι_k_V := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hπ_Vs_γV]

  
  let g_Fk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let D_bar := weilBaseChangeOver F k D₀
  let Z_bar := weilBaseChangeOver F k Z_tilde
  let pr_D : D_bar.left ⟶ D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom g_Fk
  let pr_Z : Z_bar.left ⟶ Z_tilde.left := CategoryTheory.Limits.pullback.fst Z_tilde.hom g_Fk
  have hLFT_D₀ : AlgebraicGeometry.LocallyOfFiniteType D₀.hom := by
    dsimp [D₀, weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) F
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap F ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule F (MvPolynomial (Fin 2) F)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap F ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have _ : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have _ : IsScalarTower F ↥(𝒜 0) (MvPolynomial (Fin 2) F) :=
      @IsScalarTower.of_algebraMap_eq F ↥(𝒜 0) (MvPolynomial (Fin 2) F) _ _ _ _ _ _
        (fun _ => rfl)
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) F) :=
      Algebra.FiniteType.of_restrictScalars_finiteType F ↥(𝒜 0) (MvPolynomial (Fin 2) F)
    have _ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    exact inferInstance
  have hPb_Dbar : CategoryTheory.IsPullback pr_D D_bar.hom D₀.hom g_Fk :=
    CategoryTheory.IsPullback.of_hasPullback D₀.hom g_Fk
  have _ : AlgebraicGeometry.LocallyOfFiniteType D_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Dbar hLFT_D₀

  let f_bar_left : Z_bar.left ⟶ D_bar.left :=
    CategoryTheory.Limits.pullback.lift (pr_Z ≫ f₀.left) Z_bar.hom (by
      rw [Category.assoc, f₀.w]
      exact CategoryTheory.Limits.pullback.condition)
  let f_bar : Z_bar ⟶ D_bar :=
    CategoryTheory.Over.homMk f_bar_left
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have hPb_fbar : CategoryTheory.IsPullback pr_Z f_bar.left f₀.left pr_D := by
    refine CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm hPb_Dbar
    have hw : f_bar.left ≫ D_bar.hom = Z_bar.hom := f_bar.w
    rw [hw, f₀.w]
    exact CategoryTheory.IsPullback.of_hasPullback Z_tilde.hom g_Fk
  have _ : AlgebraicGeometry.IsProper f_bar.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_fbar inferInstance

  let c_Vs : k →+* ↥V_s := j_val.comp (p_R.comp Polynomial.C)
  have hπVs_cVs : π_Vs.comp c_Vs = RingHom.id k := by
    dsimp [c_Vs]
    rw [← RingHom.comp_assoc, hπ_Vs_cl]
    exact hπ_cR
  have hgV_Fk : g_V ≫ D₀.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Vs) ≫ g_Fk := by
    rw [hgV_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
  let g_V_bar : AlgebraicGeometry.Spec (CommRingCat.of ↥V_s) ⟶ D_bar.left :=
    CategoryTheory.Limits.pullback.lift g_V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Vs)) hgV_Fk
  have hgV_bar_pr : g_V_bar ≫ pr_D = g_V :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hgV_bar_hom : g_V_bar ≫ D_bar.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_Vs) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let Z_V_bar := CategoryTheory.Limits.pullback f_bar.left g_V_bar
  let Z_k_bar := CategoryTheory.Limits.pullback f_bar.left (i_Vs ≫ g_V_bar)
  have hPb_ZV_bar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst f_bar.left g_V_bar ≫ pr_Z)
      (CategoryTheory.Limits.pullback.snd f_bar.left g_V_bar)
      f₀.left g_V := by
    rw [← hgV_bar_pr]
    exact (CategoryTheory.IsPullback.of_hasPullback f_bar.left g_V_bar).paste_horiz hPb_fbar
  have hPb_Zk_bar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst f_bar.left (i_Vs ≫ g_V_bar) ≫ pr_Z)
      (CategoryTheory.Limits.pullback.snd f_bar.left (i_Vs ≫ g_V_bar))
      f₀.left (i_Vs ≫ g_V) := by
    have hi_pr : (i_Vs ≫ g_V_bar) ≫ pr_D = i_Vs ≫ g_V := by
      rw [Category.assoc, hgV_bar_pr]
    rw [← hi_pr]
    exact (CategoryTheory.IsPullback.of_hasPullback f_bar.left (i_Vs ≫ g_V_bar)).paste_horiz
      hPb_fbar

  let e_ZV : Z_V_bar ≅ Z_V := hPb_ZV_bar.isoPullback
  let e_Zk : Z_k_bar ≅ Z_k := hPb_Zk_bar.isoPullback
  let ι_kV_bar : Z_k_bar ⟶ Z_V_bar :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst f_bar.left (i_Vs ≫ g_V_bar))
      (CategoryTheory.Limits.pullback.snd f_bar.left (i_Vs ≫ g_V_bar) ≫ i_Vs)
      (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)

  have hSq_kV : e_Zk.hom ≫ ι_k_V = ι_kV_bar ≫ e_ZV.hom := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        hPb_Zk_bar.isoPullback_hom_fst,
        Category.assoc, hPb_ZV_bar.isoPullback_hom_fst,
        ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← Category.assoc, hPb_Zk_bar.isoPullback_hom_snd,
        Category.assoc, hPb_ZV_bar.isoPullback_hom_snd,
        CategoryTheory.Limits.pullback.lift_snd]

  obtain ⟨p_k_V, hp_k_V⟩ := hPullEx ι_k_V m₀ (2 * m + 1)
  have hBij_kV : Function.Bijective p_k_V := by
    obtain ⟨p_kV_bar, hp_kV_bar⟩ := hPullEx ι_kV_bar m₀ (2 * m + 1)
    have hBij_bar : Function.Bijective p_kV_bar :=
      weil_odp_coker_strictly_henselian_proper_pullback_bijective
        k ℓ r hℓ_k hPBC ↥V_s c_Vs π_Vs hπVs_cVs hπ_Vs_ker
        Z_bar D_bar f_bar g_V_bar hgV_bar_hom ι_kV_bar
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (2 * m + 1) p_kV_bar hp_kV_bar
    obtain ⟨p_eZV, hp_eZV⟩ := hPullEx e_ZV.hom m₀ (2 * m + 1)
    obtain ⟨p_eZk_inv, hp_eZk_inv⟩ := hPullEx e_Zk.inv m₀ (2 * m + 1)
    obtain ⟨p_comp, hp_comp⟩ := hPullEx (e_Zk.hom ≫ ι_k_V) m₀ (2 * m + 1)
    have hBij_eZV : Function.Bijective p_eZV := hPullIsoBij e_ZV m₀ (2 * m + 1) p_eZV hp_eZV
    have hBij_eZk_inv : Function.Bijective p_eZk_inv :=
      hPullIsoBij e_Zk.symm m₀ (2 * m + 1) p_eZk_inv hp_eZk_inv
    have h_eq : p_k_V = p_eZk_inv.comp (p_kV_bar.comp p_eZV) := by
      ext z
      have h1 := hPullTri e_Zk.inv (e_Zk.hom ≫ ι_k_V) ι_k_V m₀ (2 * m + 1)
        p_eZk_inv p_comp p_k_V (by rw [← Category.assoc, e_Zk.inv_hom_id, Category.id_comp])
        hp_eZk_inv hp_comp hp_k_V z
      have h2 := hPullTri ι_kV_bar e_ZV.hom (e_Zk.hom ≫ ι_k_V) m₀ (2 * m + 1)
        p_kV_bar p_eZV p_comp hSq_kV.symm hp_kV_bar hp_eZV hp_comp z
      rw [h1, h2]
      rfl
    rw [h_eq, AddMonoidHom.coe_comp, AddMonoidHom.coe_comp]
    exact hBij_eZk_inv.comp (hBij_bar.comp hBij_eZV)

  obtain ⟨p_τV, hp_τV⟩ := hPullEx τ_V m₀ (2 * m + 1)
  have hp_τV_fix : p_τV ξ_V = ξ_V := by
    apply hBij_kV.1
    exact (hPullTri ι_k_V τ_V ι_k_V m₀ (2 * m + 1) p_k_V p_τV p_k_V
      hιk_τV hp_k_V hp_τV hp_k_V ξ_V).symm

  obtain ⟨p_sq_τ, hp_sq_τ⟩ := hPullEx (τ_Z ≫ ι_Ω_V) m₀ (2 * m + 1)
  have hsq1 := hPullTri τ_Z ι_Ω_V (τ_Z ≫ ι_Ω_V) m₀ (2 * m + 1)
    p_τ p_Ω_V p_sq_τ rfl hp_τ hp_Ω_V hp_sq_τ ξ_V
  have hsq2 := hPullTri ι_Ω_V τ_V (τ_Z ≫ ι_Ω_V) m₀ (2 * m + 1)
    p_Ω_V p_τV p_sq_τ hτ_Z_V.symm hp_Ω_V hp_τV hp_sq_τ ξ_V
  rw [← hξ_V_Ω, ← hsq1, hsq2, hp_τV_fix]

theorem weil_mid_dev_odp_witness_tower_picard_lefschetz (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (hProj_Zu₀ : IsProjectiveOverField F Z_u₀)
    (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
    (hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 1))
    (D : WeilMidDevSmoothMonodromyPackage.{u} F m Z_tilde f₀ u₀ Z_u₀ j_aff S_aff U₀ ℓ
      M_Zu_mid)
    (hG_closed : ∀ g : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ,
      (∀ r : ℕ,
        letI := D.hCR r; letI := D.hAF_B r; letI := D.hAR_B r
        ∃ σ : D.B_V r ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] D.B_V r,
          (∀ x : D.B_V r, IsIntegral F x → σ x = x) ∧
          (D.ρ_V r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) →
      g ∈ D.G_V)
    (hDN : 1 ≤ D.N) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (w_inf : Fin D.N → Padic ℓ)
      (w_aff : F → (Fin D.N → Padic ℓ))
      (ψ_inf : (Fin D.N → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ)
      (ψ_aff : F → ((Fin D.N → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ))
      (Q_inf_star : ∀ r : ℕ,
        letI := D.hFld r; letI := D.hAF_L r; letI := D.hARF_L r
        Ideal ↥(integralClosure
          ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r)))
          (D.L_V r)))
      (Q_aff_star : ∀ a : F, ∀ r : ℕ,
        letI := D.hFld r; letI := D.hAP_L r
        Ideal ↥(integralClosure (Polynomial F) (D.L_V r))),
      ((w_inf ≠ 0 ↔ ψ_inf ≠ 0) ∧ (∀ a ∈ S_aff, w_aff a ≠ 0 ↔ ψ_aff a ≠ 0)) ∧
      (∀ r : ℕ,
        letI := D.hCR r; letI := D.hCR (r + 1)
        letI := D.hFld r; letI := D.hFld (r + 1)
        letI := D.hAF_L r; letI := D.hAF_L (r + 1)
        letI := D.hARF_L r; letI := D.hARF_L (r + 1)
        letI := D.hABL r; letI := D.hABL (r + 1)
        letI := D.hAR_B r; letI := D.hAR_B (r + 1)
        let A_inf_r := Algebra.adjoin F
          ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
        let t_inf_r : ↥A_inf_r :=
          ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹,
            Algebra.self_mem_adjoin_singleton F _⟩
        let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
        let A_inf_succ := Algebra.adjoin F
          ({algebraMap (RatFunc F) (D.L_V (r + 1)) (RatFunc.X)⁻¹} : Set (D.L_V (r + 1)))
        let C_inf_succ := integralClosure ↥A_inf_succ (D.L_V (r + 1))
        (Q_inf_star r).IsPrime ∧
        Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) (Q_inf_star r) = Ideal.span {t_inf_r} ∧
        (∀ σ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
          (∃ σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r,
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C_inf_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_inf_star r : Set ↥C_inf_r))) ↔
          (∃ (τ_L : D.L_V (r + 1) ≃ₐ[RatFunc F] D.L_V (r + 1))
             (τ_B : D.B_V (r + 1) ≃ₐ[R₀] D.B_V (r + 1)),
            (∀ x : D.L_V (r + 1), IsIntegral F x → τ_L x = x) ∧
            (∀ b : D.B_V (r + 1), τ_L (algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) b) =
              algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) (τ_B b)) ∧
            (∀ y : ↥C_inf_succ,
              τ_L (y : D.L_V (r + 1)) - (y : D.L_V (r + 1)) ∈
                Subtype.val '' (Q_inf_star (r + 1) : Set ↥C_inf_succ)) ∧
            (∀ b : D.B_V r, τ_B (D.ι_BV r b) = D.ι_BV r (σ_B b)))) ∧
        (∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
          (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
          (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
          (∀ y : ↥C_inf_r,
            σ_L (y : D.L_V r) - (y : D.L_V r) ∈
              Subtype.val '' (Q_inf_star r : Set ↥C_inf_r)) →
          ∃ u ∈ D.G_V,
            (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
            ∃ φ : (Fin D.N → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ,
              ∀ x : Fin D.N → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (φ x) • w_inf)) ∧
      (∀ a ∈ S_aff, ∀ r : ℕ,
        letI := D.hCR r; letI := D.hCR (r + 1)
        letI := D.hFld r; letI := D.hFld (r + 1)
        letI := D.hAF_L r; letI := D.hAF_L (r + 1)
        letI := D.hAP_L r; letI := D.hAP_L (r + 1)
        letI := D.hARF_L r; letI := D.hARF_L (r + 1)
        letI := D.hABL r; letI := D.hABL (r + 1)
        letI := D.hAR_B r; letI := D.hAR_B (r + 1)
        let C₀_r := integralClosure (Polynomial F) (D.L_V r)
        let C₀_succ := integralClosure (Polynomial F) (D.L_V (r + 1))
        (Q_aff_star a r).IsPrime ∧
        Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) (Q_aff_star a r) =
          Ideal.span {Polynomial.X - Polynomial.C a} ∧
        (∀ σ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
          (∃ σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r,
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C₀_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_aff_star a r : Set ↥C₀_r))) ↔
          (∃ (τ_L : D.L_V (r + 1) ≃ₐ[RatFunc F] D.L_V (r + 1))
             (τ_B : D.B_V (r + 1) ≃ₐ[R₀] D.B_V (r + 1)),
            (∀ x : D.L_V (r + 1), IsIntegral F x → τ_L x = x) ∧
            (∀ b : D.B_V (r + 1), τ_L (algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) b) =
              algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) (τ_B b)) ∧
            (∀ y : ↥C₀_succ,
              τ_L (y : D.L_V (r + 1)) - (y : D.L_V (r + 1)) ∈
                Subtype.val '' (Q_aff_star a (r + 1) : Set ↥C₀_succ)) ∧
            (∀ b : D.B_V r, τ_B (D.ι_BV r b) = D.ι_BV r (σ_B b)))) ∧
        (∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
          (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
          (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
          (∀ y : ↥C₀_r,
            σ_L (y : D.L_V r) - (y : D.L_V r) ∈
              Subtype.val '' (Q_aff_star a r : Set ↥C₀_r)) →
          ∃ u ∈ D.G_V,
            (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
            ∃ φ : (Fin D.N → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ,
              ∀ x : Fin D.N → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (φ x) • w_aff a)) ∧
      (∀ t : PadicInt ℓ, ∃ g ∈ D.G_V, ∀ x : Fin D.N → Padic ℓ,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
          x + ((t : Padic ℓ) * ψ_inf x) • w_inf) ∧
      (∃ u_inf ∈ D.G_V,
        (∀ x : Fin D.N → Padic ℓ,
          ((u_inf.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + (ψ_inf x) • w_inf) ∧
        ∀ r : ℕ,
          letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hARF_L r
          letI := D.hABL r; letI := D.hAR_B r
          let A_inf_r := Algebra.adjoin F
            ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
          let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
          ∃ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C_inf_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_inf_star r : Set ↥C_inf_r)) ∧
            (D.ρ_V r σ_B).val = (u_inf.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ a ∈ S_aff,
        ∃ u_a ∈ D.G_V,
          (∀ x : Fin D.N → Padic ℓ,
            ((u_a.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + (ψ_aff a x) • w_aff a) ∧
          ∀ r : ℕ,
            letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
            letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
            let C₀_r := integralClosure (Polynomial F) (D.L_V r)
            ∃ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
              (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
              (∀ y : ↥C₀_r,
                σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                  Subtype.val '' (Q_aff_star a r : Set ↥C₀_r)) ∧
              (D.ρ_V r σ_B).val = (u_a.val).map (PadicInt.toZModPow (r + 1))) :=
by
  classical
  intro R₀
  let K := Padic ℓ
  let ι := algebraMap (PadicInt ℓ) K
  let k := AlgebraicClosure F
  let P := Polynomial k
  let Ω := AlgebraicClosure (FractionRing P)
  let D₀ := weilProjectiveSpaceOver F 1

  obtain ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, _, hSm_U₀,
    ⟨x_inf, hx_inf, hSm_away_inf, hOdp_inf⟩, hOdp_aff⟩ := h1d
  obtain ⟨triv_V, hTriv_V⟩ := D.hTriv

  let _ : ∀ r, CommRing (D.B_V r) := D.hCR
  let _ : ∀ r, IsDomain (D.B_V r) := D.hDom
  let _ : ∀ r, Field (D.L_V r) := D.hFld
  let _ : ∀ r, Algebra F (D.B_V r) := D.hAF_B
  let _ : ∀ r, Algebra (Polynomial F) (D.B_V r) := D.hAP_B
  let _ : ∀ r, Algebra R₀ (D.B_V r) := D.hAR_B
  let _ : ∀ r, Algebra F (D.L_V r) := D.hAF_L
  let _ : ∀ r, Algebra (Polynomial F) (D.L_V r) := D.hAP_L
  let _ : ∀ r, Algebra (RatFunc F) (D.L_V r) := D.hARF_L
  let _ : ∀ r, Algebra (D.B_V r) (D.L_V r) := D.hABL
  let _ : ∀ r, Algebra R₀ (D.L_V r) := D.hARL
  let _ : ∀ r, IsScalarTower F (Polynomial F) (D.B_V r) := D.hST1
  let _ : ∀ r, IsScalarTower (Polynomial F) R₀ (D.B_V r) := D.hST2
  let _ : ∀ r, IsScalarTower F (RatFunc F) (D.L_V r) := D.hST3
  let _ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (D.L_V r) := D.hST4
  let _ : ∀ r, IsScalarTower (Polynomial F) (D.B_V r) (D.L_V r) := D.hST5
  let _ : ∀ r, IsScalarTower R₀ (D.B_V r) (D.L_V r) := D.hST6
  let _ : ∀ r, Module.Finite R₀ (D.B_V r) := D.hFin_B
  let _ : ∀ r, Algebra.Etale R₀ (D.B_V r) := D.hEt_B
  let _ : ∀ r, IsFractionRing (D.B_V r) (D.L_V r) := D.hFrac
  let _ : ∀ r, IsIntegralClosure (D.B_V r) R₀ (D.L_V r) := D.hIntCl
  let _ : ∀ r, FiniteDimensional (RatFunc F) (D.L_V r) := D.hFD_L
  let _ : ∀ r, IsGalois (RatFunc F) (D.L_V r) := D.hGal_L

  have hInt_BL : ∀ (r : ℕ) (x : D.B_V r),
      IsIntegral F x → IsIntegral F (algebraMap (D.B_V r) (D.L_V r) x) := by
    intro r x hx
    let f_BL : D.B_V r →ₐ[F] D.L_V r :=
      { algebraMap (D.B_V r) (D.L_V r) with
        commutes' := fun c => by
          change algebraMap (D.B_V r) (D.L_V r) (algebraMap F (D.B_V r) c) =
            algebraMap F (D.L_V r) c
          rw [IsScalarTower.algebraMap_apply F (Polynomial F) (D.B_V r),
            ← IsScalarTower.algebraMap_apply (Polynomial F) (D.B_V r) (D.L_V r),
            IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (D.L_V r)]
          have h1 : algebraMap (Polynomial F) (RatFunc F) (algebraMap F (Polynomial F) c) =
              algebraMap F (RatFunc F) c := rfl
          rw [h1, ← IsScalarTower.algebraMap_apply F (RatFunc F) (D.L_V r)] }
    exact hx.map f_BL

  
  obtain ⟨R_bar, hCR_R, hDom_R, hLocRing_R, p_R, t_bar, π_cl, φ_R_Ω,
    ℐ, hCat_I, hFilt_I, D_col, α_col, c_col, hc_col, e_pt,
    hR_props, hColim_props, hLiftTrait⟩ :=
    weil_odp_punct_sm_val_ring_colimit_and_pointed_etale_lift k ℓ
  let _ : CommRing R_bar := hCR_R
  let _ : IsDomain R_bar := hDom_R
  let _ : IsLocalRing R_bar := hLocRing_R
  let _ : CategoryTheory.SmallCategory ℐ := hCat_I
  let _ : CategoryTheory.IsFiltered ℐ := hFilt_I
  obtain ⟨ht_eq, hπ_pR, hφ_pR, hφ_inj, hLoc_R⟩ := hR_props

  have hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar := by
    have hπ_surj : Function.Surjective π_cl := fun c =>
      ⟨p_R (Polynomial.C c), by
        have h := RingHom.congr_fun hπ_pR (Polynomial.C c)
        simpa using h⟩
    have hker_max : (RingHom.ker π_cl).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective π_cl hπ_surj
    exact IsLocalRing.eq_maximalIdeal hker_max

  
  have hPadicExt : ∀ z₁ z₂ : PadicInt ℓ,
      (∀ r : ℕ, PadicInt.toZModPow (r + 1) z₁ = PadicInt.toZModPow (r + 1) z₂) →
      z₁ = z₂ := by
    intro z₁ z₂ h
    refine (PadicInt.ext_of_toZModPow (p := ℓ)).mp fun n => ?_
    cases n with
    | zero =>
      have : Subsingleton (ZMod (ℓ ^ 0)) := by change Subsingleton (ZMod 1); infer_instance
      exact Subsingleton.elim _ _
    | succ r => exact h r

  have hPadicLiftElem : ∀ (a : ∀ r : ℕ, ZMod (ℓ ^ (r + 1))),
      (∀ r : ℕ,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (a (r + 1)) =
          a r) →
      ∃ z : PadicInt ℓ, ∀ r : ℕ, PadicInt.toZModPow (r + 1) z = a r := by
    intro a ha
    let b : ∀ n : ℕ, ZMod (ℓ ^ n) := fun n =>
      match n with
      | 0 => 0
      | r + 1 => a r
    have hb_step : ∀ n : ℕ,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n)) (b (n + 1)) = b n := by
      intro n
      cases n with
      | zero =>
        have : Subsingleton (ZMod (ℓ ^ 0)) := by change Subsingleton (ZMod 1); infer_instance
        exact Subsingleton.elim _ _
      | succ r => exact ha r
    have hb_le : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) (b k₂) = b k₁ := by
      intro k₁
      refine Nat.le_induction (by simp) (fun k₂ hk₁ ih => ?_)
      have h2 : k₂ ≤ k₂ + 1 := Nat.le_succ k₂
      have hk' : k₁ ≤ k₂ + 1 := Nat.le_succ_of_le hk₁
      have hcomp : (ZMod.castHom (pow_dvd_pow ℓ hk₁) (ZMod (ℓ ^ k₁))).comp
          (ZMod.castHom (pow_dvd_pow ℓ h2) (ZMod (ℓ ^ k₂))) =
          ZMod.castHom (pow_dvd_pow ℓ hk') (ZMod (ℓ ^ k₁)) := by
        ext x
        simp
      have happ := RingHom.congr_fun hcomp (b (k₂ + 1))
      simp only [RingHom.comp_apply] at happ
      rw [← happ, hb_step k₂, ih]
    let f : ∀ n : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ n) :=
      fun n => (Polynomial.aeval (b n)).toRingHom
    have hf_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f k₂) = f k₁ := by
      intro k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · ext n; simp [f]
      · simp [f, hb_le k₁ k₂ hk]
    refine ⟨PadicInt.lift hf_compat Polynomial.X, fun r => ?_⟩
    have hspec := RingHom.congr_fun (PadicInt.lift_spec hf_compat (r + 1)) Polynomial.X
    simpa [f, b] using hspec

  have hMapMul : ∀ {R₁ R₂ : Type} [Semiring R₁] [Semiring R₂] (φ : R₁ →+* R₂)
      (X Y : Matrix (Fin D.N) (Fin D.N) R₁),
      (X * Y).map φ = X.map φ * Y.map φ := by
    intro R₁ R₂ _ _ φ X Y
    ext i j
    simp [Matrix.mul_apply]

  have hMapOne : ∀ {R₁ R₂ : Type} [Semiring R₁] [Semiring R₂] (φ : R₁ →+* R₂),
      (1 : Matrix (Fin D.N) (Fin D.N) R₁).map φ = 1 := by
    intro R₁ R₂ _ _ φ
    ext i j
    by_cases hij : i = j
    · subst hij; simp
    · simp [Matrix.one_apply_ne hij]

  have hPadicMatrixLift : ∀ (A_seq : ∀ r : ℕ, (Matrix (Fin D.N) (Fin D.N) (ZMod (ℓ ^ (r + 1))))ˣ),
      (∀ r : ℕ,
        ((A_seq (r + 1)).val).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          (A_seq r).val) →
      ∃! g : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ,
        ∀ r : ℕ, (g.val).map (PadicInt.toZModPow (r + 1)) = (A_seq r).val := by
    intro A_seq hCompat
    have hCompat_inv : ∀ r : ℕ,
        (((A_seq (r + 1))⁻¹).val).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          ((A_seq r)⁻¹).val := by
      intro r
      let φ := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
      have hprod : (((A_seq (r + 1))⁻¹).val).map φ * (A_seq r).val = 1 := by
        have h1 : (A_seq r).val = ((A_seq (r + 1)).val).map φ := (hCompat r).symm
        rw [h1, ← hMapMul φ, Units.inv_mul, hMapOne φ]
      calc (((A_seq (r + 1))⁻¹).val).map φ
          = (((A_seq (r + 1))⁻¹).val).map φ * ((A_seq r).val * ((A_seq r)⁻¹).val) := by
            rw [Units.mul_inv, Matrix.mul_one]
        _ = ((((A_seq (r + 1))⁻¹).val).map φ * (A_seq r).val) * ((A_seq r)⁻¹).val := by
            rw [Matrix.mul_assoc]
        _ = ((A_seq r)⁻¹).val := by rw [hprod, Matrix.one_mul]
    choose M hM using fun (i j : Fin D.N) =>
      hPadicLiftElem (fun r => (A_seq r).val i j)
        (fun r => by simpa [Matrix.map_apply] using congrArg (fun X => X i j) (hCompat r))
    choose M_inv hM_inv using fun (i j : Fin D.N) =>
      hPadicLiftElem (fun r => ((A_seq r)⁻¹).val i j)
        (fun r => by simpa [Matrix.map_apply] using congrArg (fun X => X i j) (hCompat_inv r))
    let G : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ) := Matrix.of M
    let G_inv : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ) := Matrix.of M_inv
    have hG_mod : ∀ r : ℕ, G.map (PadicInt.toZModPow (r + 1)) = (A_seq r).val := by
      intro r; ext i j; exact hM i j r
    have hGinv_mod : ∀ r : ℕ, G_inv.map (PadicInt.toZModPow (r + 1)) = ((A_seq r)⁻¹).val := by
      intro r; ext i j; exact hM_inv i j r
    have hmul1 : G * G_inv = 1 := by
      ext i j
      apply hPadicExt
      intro r
      have hmat : (G * G_inv).map (PadicInt.toZModPow (r + 1)) =
          (1 : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ)).map (PadicInt.toZModPow (r + 1)) := by
        rw [hMapMul (PadicInt.toZModPow (r + 1)), hG_mod r, hGinv_mod r, Units.mul_inv,
          hMapOne (PadicInt.toZModPow (r + 1))]
      simpa [Matrix.map_apply] using congrArg (fun X => X i j) hmat
    have hmul2 : G_inv * G = 1 := by
      ext i j
      apply hPadicExt
      intro r
      have hmat : (G_inv * G).map (PadicInt.toZModPow (r + 1)) =
          (1 : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ)).map (PadicInt.toZModPow (r + 1)) := by
        rw [hMapMul (PadicInt.toZModPow (r + 1)), hG_mod r, hGinv_mod r, Units.inv_mul,
          hMapOne (PadicInt.toZModPow (r + 1))]
      simpa [Matrix.map_apply] using congrArg (fun X => X i j) hmat
    refine ⟨⟨G, G_inv, hmul1, hmul2⟩, hG_mod, ?_⟩
    intro g' hg'
    apply Units.ext
    ext i j
    apply hPadicExt
    intro r
    have h1 := congrArg (fun X => X i j) (hg' r)
    have h2 := congrArg (fun X => X i j) (hG_mod r)
    simpa [Matrix.map_apply] using h1.trans h2.symm

  
  have hRatFuncSetup :
      (∃ ι_Fk : RatFunc F →+* FractionRing P,
        ι_Fk.comp (algebraMap F (RatFunc F)) =
          (algebraMap P (FractionRing P)).comp (Polynomial.C.comp (algebraMap F k)) ∧
        ι_Fk RatFunc.X = algebraMap P (FractionRing P) Polynomial.X) ∧
      (∃ α_inf : RatFunc F ≃ₐ[F] RatFunc F,
        α_inf RatFunc.X = (RatFunc.X : RatFunc F)⁻¹) ∧
      (∀ a : F, ∃ α_a : RatFunc F ≃ₐ[F] RatFunc F,
        α_a RatFunc.X = RatFunc.X - algebraMap F (RatFunc F) a) := by
    refine ⟨?_, ?_, ?_⟩
    · let f_Fk : Polynomial F →+* FractionRing P :=
        (algebraMap P (FractionRing P)).comp (Polynomial.mapRingHom (algebraMap F k))
      have hf_units : ∀ y : nonZeroDivisors (Polynomial F), IsUnit (f_Fk y) := by
        rintro ⟨q, hq⟩
        have hq_ne : q ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hq
        have hmap_ne : Polynomial.map (algebraMap F k) q ≠ 0 :=
          Polynomial.map_ne_zero hq_ne
        have hfrac_ne : f_Fk q ≠ 0 := fun h0 =>
          hmap_ne ((IsFractionRing.injective P (FractionRing P)) (h0.trans (map_zero _).symm))
        exact IsUnit.mk0 _ hfrac_ne
      let ι_Fk : RatFunc F →+* FractionRing P := IsLocalization.lift hf_units
      refine ⟨ι_Fk, ?_, ?_⟩
      · ext c
        have h1 : algebraMap F (RatFunc F) c =
            algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) := rfl
        rw [RingHom.comp_apply, h1, IsLocalization.lift_eq]
        dsimp only [f_Fk]
        rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
        rfl
      · rw [← RatFunc.algebraMap_X, IsLocalization.lift_eq]
        dsimp only [f_Fk]
        rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
    · let g_alg : Polynomial F →ₐ[F] RatFunc F := Polynomial.aeval ((RatFunc.X : RatFunc F)⁻¹)
      have hX_ne : (RatFunc.X : RatFunc F) ≠ 0 := RatFunc.X_ne_zero
      have hg_units : ∀ y : nonZeroDivisors (Polynomial F), IsUnit (g_alg.toRingHom y) := by
        rintro ⟨q, hq⟩
        have hq_ne : q ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hq
        let d := q.natDegree
        let q_rev : Polynomial F :=
          ∑ i ∈ Finset.range (d + 1), Polynomial.C (q.coeff i) * Polynomial.X ^ (d - i)
        have hq_rev_eval0 : Polynomial.eval 0 q_rev = q.leadingCoeff := by
          simp only [q_rev, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
            Polynomial.eval_pow, Polynomial.eval_X]
          rw [Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one]
          have hsum0 : ∑ x ∈ Finset.range d, q.coeff x * (0 : F) ^ (d - x) = 0 := by
            refine Finset.sum_eq_zero fun x hx => ?_
            rw [Finset.mem_range] at hx
            rw [zero_pow (by omega), mul_zero]
          rw [hsum0, zero_add, Polynomial.leadingCoeff]
        have hq_rev_ne : q_rev ≠ 0 := by
          intro h0
          rw [h0, Polynomial.eval_zero] at hq_rev_eval0
          exact Polynomial.leadingCoeff_ne_zero.mpr hq_ne hq_rev_eval0.symm
        have hident : (RatFunc.X : RatFunc F) ^ d * g_alg q =
            algebraMap (Polynomial F) (RatFunc F) q_rev := by
          dsimp only [g_alg, q_rev]
          rw [Polynomial.aeval_eq_sum_range, Finset.mul_sum, map_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          rw [Finset.mem_range] at hi
          rw [Algebra.smul_def, map_mul, map_pow, RatFunc.algebraMap_X]
          have hexp : d = (d - i) + i := (Nat.sub_add_cancel (Nat.lt_succ_iff.mp hi)).symm
          have hC_eq : algebraMap F (RatFunc F) (q.coeff i) =
              algebraMap (Polynomial F) (RatFunc F) (Polynomial.C (q.coeff i)) := rfl
          calc (RatFunc.X : RatFunc F) ^ d *
                (algebraMap F (RatFunc F) (q.coeff i) * ((RatFunc.X : RatFunc F)⁻¹) ^ i)
              = algebraMap F (RatFunc F) (q.coeff i) *
                  ((RatFunc.X : RatFunc F) ^ (d - i) *
                    ((RatFunc.X : RatFunc F) ^ i * ((RatFunc.X : RatFunc F)⁻¹) ^ i)) := by
                  conv_lhs => rw [hexp, pow_add]
                  ring
            _ = algebraMap (Polynomial F) (RatFunc F) (Polynomial.C (q.coeff i)) *
                  (RatFunc.X : RatFunc F) ^ (d - i) := by
                  rw [← mul_pow, mul_inv_cancel₀ hX_ne, one_pow, mul_one, hC_eq]
        have hg_ne : g_alg q ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hident
          exact hq_rev_ne
            ((IsFractionRing.injective (Polynomial F) (RatFunc F))
              (hident.symm.trans (map_zero _).symm))
        exact IsUnit.mk0 _ hg_ne
      let φ_ring : RatFunc F →+* RatFunc F := IsLocalization.lift hg_units
      have hφ_comm : ∀ c : F, φ_ring (algebraMap F (RatFunc F) c) = algebraMap F (RatFunc F) c := by
        intro c
        have h1 : algebraMap F (RatFunc F) c =
            algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) := rfl
        rw [h1, IsLocalization.lift_eq]
        exact Polynomial.aeval_C _ c
      let φ_alg : RatFunc F →ₐ[F] RatFunc F := { φ_ring with commutes' := hφ_comm }
      have hφ_X : φ_alg RatFunc.X = (RatFunc.X : RatFunc F)⁻¹ := by
        change φ_ring RatFunc.X = _
        rw [← RatFunc.algebraMap_X, IsLocalization.lift_eq]
        exact Polynomial.aeval_X _
      have hφ_inv : φ_alg.comp φ_alg = AlgHom.id F (RatFunc F) := by
        apply AlgHom.coe_ringHom_injective
        refine IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F)) ?_
        apply Polynomial.ringHom_ext'
        · ext c
          change φ_alg (φ_alg (algebraMap F (RatFunc F) c)) = algebraMap F (RatFunc F) c
          rw [φ_alg.commutes, φ_alg.commutes]
        · change φ_alg (φ_alg (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)) =
            algebraMap (Polynomial F) (RatFunc F) Polynomial.X
          rw [RatFunc.algebraMap_X, hφ_X, map_inv₀, hφ_X, inv_inv]
      exact ⟨AlgEquiv.ofAlgHom φ_alg φ_alg hφ_inv hφ_inv, hφ_X⟩
    · intro a
      have hShiftEx : ∀ c₀ : F,
          ∃ φ_c : RatFunc F →ₐ[F] RatFunc F,
            φ_c RatFunc.X = RatFunc.X + algebraMap F (RatFunc F) c₀ := by
        intro c₀
        let e_c : Polynomial F ≃ₐ[F] Polynomial F :=
          AlgEquiv.ofAlgHom
            (Polynomial.aeval (Polynomial.X + Polynomial.C c₀))
            (Polynomial.aeval (Polynomial.X - Polynomial.C c₀))
            (by ext; simp)
            (by ext; simp)
        let f_c : Polynomial F →+* RatFunc F :=
          (algebraMap (Polynomial F) (RatFunc F)).comp e_c.toAlgHom.toRingHom
        have hf_units : ∀ y : nonZeroDivisors (Polynomial F), IsUnit (f_c y) := by
          rintro ⟨q, hq⟩
          have hq_ne : q ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hq
          have he_ne : e_c q ≠ 0 := fun h0 => hq_ne (e_c.injective (h0.trans (map_zero _).symm))
          have hrf_ne : f_c q ≠ 0 := fun h0 =>
            he_ne ((IsFractionRing.injective (Polynomial F) (RatFunc F))
              (h0.trans (map_zero _).symm))
          exact IsUnit.mk0 _ hrf_ne
        let g_c : RatFunc F →+* RatFunc F := IsLocalization.lift hf_units
        have hg_comm : ∀ c : F, g_c (algebraMap F (RatFunc F) c) = algebraMap F (RatFunc F) c := by
          intro c
          have h1 : algebraMap F (RatFunc F) c =
              algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) := rfl
          rw [h1]
          dsimp only [g_c]
          rw [IsLocalization.lift_eq]
          change algebraMap (Polynomial F) (RatFunc F)
            (Polynomial.aeval (Polynomial.X + Polynomial.C c₀) (Polynomial.C c)) = _
          rw [Polynomial.aeval_C]
          rfl
        refine ⟨{ g_c with commutes' := hg_comm }, ?_⟩
        change g_c RatFunc.X = _
        rw [← RatFunc.algebraMap_X]
        dsimp only [g_c]
        rw [IsLocalization.lift_eq]
        change algebraMap (Polynomial F) (RatFunc F)
          (Polynomial.aeval (Polynomial.X + Polynomial.C c₀) Polynomial.X) = _
        rw [Polynomial.aeval_X, map_add, RatFunc.algebraMap_X]
        rfl
      obtain ⟨φ_neg, hX_neg⟩ := hShiftEx (-a)
      obtain ⟨φ_pos, hX_pos⟩ := hShiftEx a
      have h1 : φ_neg.comp φ_pos = AlgHom.id F (RatFunc F) := by
        apply AlgHom.coe_ringHom_injective
        refine IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F)) ?_
        apply Polynomial.ringHom_ext'
        · ext c
          change φ_neg (φ_pos (algebraMap F (RatFunc F) c)) = algebraMap F (RatFunc F) c
          rw [φ_pos.commutes, φ_neg.commutes]
        · change φ_neg (φ_pos (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)) =
            algebraMap (Polynomial F) (RatFunc F) Polynomial.X
          rw [RatFunc.algebraMap_X, hX_pos, map_add, φ_neg.commutes, hX_neg, map_neg]
          abel
      have h2 : φ_pos.comp φ_neg = AlgHom.id F (RatFunc F) := by
        apply AlgHom.coe_ringHom_injective
        refine IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F)) ?_
        apply Polynomial.ringHom_ext'
        · ext c
          change φ_pos (φ_neg (algebraMap F (RatFunc F) c)) = algebraMap F (RatFunc F) c
          rw [φ_neg.commutes, φ_pos.commutes]
        · change φ_pos (φ_neg (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)) =
            algebraMap (Polynomial F) (RatFunc F) Polynomial.X
          rw [RatFunc.algebraMap_X, hX_neg, map_add, φ_pos.commutes, hX_pos, map_neg]
          abel
      refine ⟨AlgEquiv.ofAlgHom φ_neg φ_pos h1 h2, ?_⟩
      change φ_neg RatFunc.X = _
      rw [hX_neg, map_neg, sub_eq_add_neg]

  obtain ⟨⟨ι_Fk, hι_Fk_F, hι_Fk_X⟩, ⟨α_inf, hα_inf_X⟩, hα_aff⟩ := hRatFuncSetup

  
  have hPigeonholeHyperplane : ∀ {I : Type u}
      (g_hom : I → (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
      (∀ r : ℕ,
        ∃ μ_r : (Fin D.N → ZMod (ℓ ^ (r + 1))) →+ ZMod (ℓ ^ (r + 1)),
          ∀ v : Fin D.N → ZMod (ℓ ^ (r + 1)),
            μ_r v = 0 →
            ∀ γ : I,
              (ℓ ^ D.c_iso) •
                ((((g_hom γ).val).map (PadicInt.toZModPow (r + 1))).mulVec v - v) = 0) →
      ∃ lam_0 : (Fin D.N → K) →ₗ[K] K,
        lam_0 ≠ 0 ∧
        ∀ y : Fin D.N → K,
          lam_0 y = 0 →
          ∀ γ : I, (((g_hom γ).val).map ι).mulVec y = y := by
    intro I g_hom h_coker
    have hinj_ι : Function.Injective ι := fun _ _ h => Subtype.ext h
    let A_lin : I → ((Fin D.N → K) →ₗ[K] (Fin D.N → K)) :=
      fun γ => (((g_hom γ).val).map ι - 1).mulVecLin
    let W_s : Submodule K (Fin D.N → K) := ⨅ γ : I, LinearMap.ker (A_lin γ)
    have hmem_W : ∀ y : Fin D.N → K, y ∈ W_s ↔ ∀ γ : I, A_lin γ y = 0 := by
      intro y; simp [W_s]
    have hℓ_prime : Nat.Prime ℓ := Fact.out
    have hℓ_gt1_nat : 1 < ℓ := hℓ_prime.one_lt
    have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ_gt1_nat
    have hℓ_ne_padicInt : (ℓ : PadicInt ℓ) ≠ 0 := by
      intro h0
      have h1 : ((ℓ : PadicInt ℓ) : K) = 0 := by rw [h0]; rfl
      exact (Nat.cast_ne_zero.mpr hℓ_prime.ne_zero) h1

    have hScaleElem : ∀ x : K, ∃ n : ℕ, ∃ z : PadicInt ℓ, (ℓ : K) ^ n * x = ι z := by
      intro x
      by_cases hx : x = 0
      · exact ⟨0, 0, by simp [hx]⟩
      · obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt ‖x‖ hℓ_gt1
        have hnorm : ‖(ℓ : K) ^ n * x‖ ≤ 1 := by
          rw [norm_mul, norm_pow, Padic.norm_p]
          calc ((ℓ : ℝ)⁻¹) ^ n * ‖x‖
              ≤ ((ℓ : ℝ)⁻¹) ^ n * (ℓ : ℝ) ^ n :=
                mul_le_mul_of_nonneg_left hn.le (by positivity)
            _ = ((ℓ : ℝ)⁻¹ * (ℓ : ℝ)) ^ n := by ring
            _ = 1 := by rw [inv_mul_cancel₀ (by positivity), one_pow]
        exact ⟨n, ⟨(ℓ : K) ^ n * x, hnorm⟩, rfl⟩

    have hScaleVec : ∀ {M : Type} [Fintype M] (v : M → K),
        ∃ n : ℕ, ∃ z : M → PadicInt ℓ, ∀ m : M, (ℓ : K) ^ n * v m = ι (z m) := by
      intro M _ v
      choose n_fn z_fn hz_fn using fun m => hScaleElem (v m)
      let n_max : ℕ := Finset.univ.sup n_fn
      refine ⟨n_max, fun m => (ℓ : PadicInt ℓ) ^ (n_max - n_fn m) * z_fn m, fun m => ?_⟩
      have hle : n_fn m ≤ n_max := Finset.le_sup (Finset.mem_univ m)
      have hexp : n_max = (n_max - n_fn m) + n_fn m := (Nat.sub_add_cancel hle).symm
      calc (ℓ : K) ^ n_max * v m
          = (ℓ : K) ^ (n_max - n_fn m) * ((ℓ : K) ^ (n_fn m) * v m) := by
            conv_lhs => rw [hexp, pow_add]
            ring
        _ = (ℓ : K) ^ (n_max - n_fn m) * ι (z_fn m) := by rw [hz_fn m]
        _ = ι ((ℓ : PadicInt ℓ) ^ (n_max - n_fn m) * z_fn m) := by
            rw [map_mul, map_pow, map_natCast]

    have hCut : ∀ (d : ℕ) (U : Submodule K (Fin D.N → K)),
        Module.finrank K ↥U = d → W_s ≤ U →
        ∃ (k_0 : ℕ) (γs : Fin k_0 → I),
          U ⊓ (⨅ j : Fin k_0, LinearMap.ker (A_lin (γs j))) = W_s := by
      intro d
      induction d using Nat.strong_induction_on with
      | h d ih =>
        intro U hd hWU
        by_cases hUW : U ≤ W_s
        · refine ⟨0, Fin.elim0, ?_⟩
          rw [iInf_of_empty, inf_top_eq]
          exact le_antisymm hUW hWU
        · have hex : ∃ x ∈ U, x ∉ W_s := Set.not_subset.mp hUW
          obtain ⟨x, hxU, hxW⟩ := hex
          rw [hmem_W, not_forall] at hxW
          obtain ⟨γ₀, hγ₀⟩ := hxW
          let U' : Submodule K (Fin D.N → K) := U ⊓ LinearMap.ker (A_lin γ₀)
          have hWU' : W_s ≤ U' := le_inf hWU (iInf_le _ γ₀)
          let S : Submodule K ↥U := U'.comap U.subtype
          have hS_ne_top : S ≠ ⊤ := by
            intro htop
            have hmem_S : (⟨x, hxU⟩ : ↥U) ∈ S := htop ▸ Submodule.mem_top
            exact hγ₀ hmem_S.2
          let e_SU' : ↥S ≃ₗ[K] ↥U' :=
            { toFun := fun z => ⟨z.1.1, z.2⟩
              invFun := fun z => ⟨⟨z.1, z.2.1⟩, z.2⟩
              left_inv := fun _ => rfl
              right_inv := fun _ => rfl
              map_add' := fun _ _ => rfl
              map_smul' := fun _ _ => rfl }
          have hfin_lt : Module.finrank K ↥U' < d := by
            rw [← hd, ← e_SU'.finrank_eq]
            exact Submodule.finrank_lt hS_ne_top
          obtain ⟨k₁, γs₁, hEq₁⟩ := ih (Module.finrank K ↥U') hfin_lt U' rfl hWU'
          refine ⟨k₁ + 1, Fin.cons γ₀ γs₁, ?_⟩
          rw [← hEq₁]
          apply le_antisymm
          · intro z ⟨hzU, hz_all⟩
            rw [SetLike.mem_coe, Submodule.mem_iInf] at hz_all
            refine ⟨⟨hzU, hz_all 0⟩, ?_⟩
            rw [SetLike.mem_coe, Submodule.mem_iInf]
            intro j
            exact hz_all j.succ
          · intro z ⟨⟨hzU, hz0⟩, hz_rest⟩
            rw [SetLike.mem_coe, Submodule.mem_iInf] at hz_rest
            refine ⟨hzU, ?_⟩
            rw [SetLike.mem_coe, Submodule.mem_iInf]
            intro j
            exact Fin.cases hz0 (fun j' => hz_rest j') j

    have hCodim : D.N ≤ Module.finrank K ↥W_s + 1 := by
      by_contra h_not
      have h2 : Module.finrank K ↥W_s + 2 ≤ D.N := by omega
      have hfin_top : Module.finrank K ↥(⊤ : Submodule K (Fin D.N → K)) = D.N := by
        rw [finrank_top, Module.finrank_pi, Fintype.card_fin]
      obtain ⟨k_0, γs, hγs_eq⟩ := hCut D.N ⊤ hfin_top le_top
      rw [top_inf_eq] at hγs_eq

      have hW_ne_top : W_s ≠ ⊤ := by
        intro htop; rw [htop, hfin_top] at h2; omega
      obtain ⟨v₁, hv₁⟩ : ∃ v₁ : Fin D.N → K, v₁ ∉ W_s := by
        by_contra hall
        exact hW_ne_top (eq_top_iff.mpr fun x _ => Classical.not_not.mp fun hx => hall ⟨x, hx⟩)
      obtain ⟨n₁, z₁, hz₁⟩ := hScaleVec v₁
      let w₁ : Fin D.N → K := fun i => ι (z₁ i)
      have hw₁_eq : w₁ = ((ℓ : K) ^ n₁) • v₁ := by ext i; exact (hz₁ i).symm
      have hℓ_pow_ne : ∀ s : ℕ, (ℓ : K) ^ s ≠ 0 :=
        fun s => pow_ne_zero s (Nat.cast_ne_zero.mpr hℓ_prime.ne_zero)
      have hw₁_not : w₁ ∉ W_s := by
        intro hmem
        have hv₁_mem : v₁ = ((ℓ : K) ^ n₁)⁻¹ • w₁ := by
          rw [hw₁_eq, inv_smul_smul₀ (hℓ_pow_ne n₁)]
        rw [hv₁_mem] at hv₁
        exact hv₁ (W_s.smul_mem _ hmem)

      let W₁ : Submodule K (Fin D.N → K) := W_s ⊔ Submodule.span K {w₁}
      have hspan_le : Module.finrank K ↥(Submodule.span K {w₁}) ≤ 1 := by
        let f_sp : K →ₗ[K] ↥(Submodule.span K {w₁}) :=
          { toFun := fun c => ⟨c • w₁, Submodule.mem_span_singleton.mpr ⟨c, rfl⟩⟩
            map_add' := fun a b => Subtype.ext (add_smul a b w₁)
            map_smul' := fun a b => Subtype.ext (mul_smul a b w₁) }
        have hsurj : LinearMap.range f_sp = ⊤ := by
          rw [eq_top_iff]
          rintro ⟨_, hmem⟩ _
          obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hmem
          exact ⟨c, rfl⟩
        have hrk := LinearMap.finrank_range_add_finrank_ker f_sp
        rw [hsurj, finrank_top, Module.finrank_self] at hrk
        omega
      have hfin_W₁ : Module.finrank K ↥W₁ ≤ Module.finrank K ↥W_s + 1 := by
        have hsup := Submodule.finrank_sup_add_finrank_inf_eq W_s (Submodule.span K {w₁})
        dsimp only [W₁]
        omega
      have hW₁_ne_top : W₁ ≠ ⊤ := by
        intro htop; rw [htop, hfin_top] at hfin_W₁; omega
      obtain ⟨v₂, hv₂⟩ : ∃ v₂ : Fin D.N → K, v₂ ∉ W₁ := by
        by_contra hall
        exact hW₁_ne_top (eq_top_iff.mpr fun x _ => Classical.not_not.mp fun hx => hall ⟨x, hx⟩)
      obtain ⟨n₂, z₂, hz₂⟩ := hScaleVec v₂
      let w₂ : Fin D.N → K := fun i => ι (z₂ i)
      have hw₂_eq : w₂ = ((ℓ : K) ^ n₂) • v₂ := by ext i; exact (hz₂ i).symm
      have hw₂_not : w₂ ∉ W₁ := by
        intro hmem
        have hv₂_mem : v₂ = ((ℓ : K) ^ n₂)⁻¹ • w₂ := by
          rw [hw₂_eq, inv_smul_smul₀ (hℓ_pow_ne n₂)]
        rw [hv₂_mem] at hv₂
        exact hv₂ (W₁.smul_mem _ hmem)

      have hIndep : ∀ a₁ a₂ : K, a₁ • w₁ + a₂ • w₂ ∈ W_s → a₁ = 0 ∧ a₂ = 0 := by
        intro a₁ a₂ hmem
        have ha₂ : a₂ = 0 := by
          by_contra ha₂_ne
          have hw₂_in : w₂ = a₂⁻¹ • (a₁ • w₁ + a₂ • w₂) - (a₂⁻¹ * a₁) • w₁ := by
            ext i
            simp only [Pi.sub_apply, Pi.smul_apply, Pi.add_apply, smul_eq_mul]
            calc w₂ i
                = (a₂⁻¹ * a₂) * w₂ i := by rw [inv_mul_cancel₀ ha₂_ne, one_mul]
              _ = a₂⁻¹ * (a₁ * w₁ i + a₂ * w₂ i) - a₂⁻¹ * a₁ * w₁ i := by ring
          have hmem_W₁ : w₂ ∈ W₁ := by
            rw [hw₂_in]
            exact W₁.sub_mem
              (Submodule.mem_sup_left (W_s.smul_mem _ hmem))
              (Submodule.mem_sup_right (Submodule.mem_span_singleton.mpr ⟨_, rfl⟩))
          exact hw₂_not hmem_W₁
        subst ha₂
        rw [zero_smul, add_zero] at hmem
        refine ⟨?_, rfl⟩
        by_contra ha₁_ne
        have hw₁_in : w₁ = a₁⁻¹ • (a₁ • w₁) := by rw [inv_smul_smul₀ ha₁_ne]
        exact hw₁_not (hw₁_in ▸ W_s.smul_mem _ hmem)

      let T : (Fin 2 → K) →ₗ[K] (Fin k_0 → Fin D.N → K) :=
        LinearMap.pi fun j =>
          (A_lin (γs j)).comp
            ((LinearMap.proj (0 : Fin 2)).smulRight w₁ + (LinearMap.proj (1 : Fin 2)).smulRight w₂)
      have hT_ker : LinearMap.ker T = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro c hc
        have hmem_inter : c 0 • w₁ + c 1 • w₂ ∈ ⨅ j : Fin k_0, LinearMap.ker (A_lin (γs j)) := by
          rw [Submodule.mem_iInf]
          intro j
          exact congrFun hc j
        rw [hγs_eq] at hmem_inter
        obtain ⟨hc0, hc1⟩ := hIndep (c 0) (c 1) hmem_inter
        ext s
        fin_cases s
        · exact hc0
        · exact hc1
      obtain ⟨L_inv, hL_inv⟩ := LinearMap.exists_leftInverse_of_injective T hT_ker

      let coeff_K : (Fin k_0 × Fin D.N × Fin 2) → K :=
        fun ⟨j, i, s⟩ => L_inv (Pi.single j (Pi.single i 1)) s
      obtain ⟨B, c_int, hc_int⟩ := hScaleVec coeff_K

      have hIntLeftInv : ∀ (a₀ a₁ : PadicInt ℓ),
          let y : Fin k_0 → Fin D.N → PadicInt ℓ := fun j =>
            ((g_hom (γs j)).val - 1).mulVec (a₀ • z₁ + a₁ • z₂)
          (ℓ : PadicInt ℓ) ^ B * a₀ = ∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, 0) * y j i ∧
          (ℓ : PadicInt ℓ) ^ B * a₁ = ∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, 1) * y j i := by
        intro a₀ a₁ y
        let c_vec : Fin 2 → K := ![ι a₀, ι a₁]
        have hTc : T c_vec = fun j i => ι (y j i) := by
          ext j i
          have hlin : c_vec 0 • w₁ + c_vec 1 • w₂ = fun s => ι ((a₀ • z₁ + a₁ • z₂) s) := by
            ext s
            simp [c_vec, w₁, w₂, map_add, map_mul]
          change ((((g_hom (γs j)).val).map ι - 1).mulVec (c_vec 0 • w₁ + c_vec 1 • w₂)) i =
            ι (y j i)
          rw [hlin]
          simp only [y, Matrix.mulVec, dotProduct, Matrix.sub_apply, Matrix.map_apply,
            Matrix.one_apply, map_sum, map_mul, map_sub]
          refine Finset.sum_congr rfl fun s _ => ?_
          split_ifs <;> simp
        have hLc : ∀ s : Fin 2,
            (ℓ : K) ^ B * c_vec s =
              ∑ j : Fin k_0, ∑ i : Fin D.N, ι (c_int (j, i, s)) * ι (y j i) := by
          intro s
          have hid : L_inv (T c_vec) s = c_vec s :=
            congrFun (LinearMap.congr_fun hL_inv c_vec) s
          have hdecomp : T c_vec =
              ∑ j : Fin k_0, ∑ i : Fin D.N, (T c_vec j i) • Pi.single j (Pi.single i (1 : K)) := by
            ext j₀ i₀
            simp only [Finset.sum_apply, Pi.smul_apply, Pi.single_apply]
            rw [Finset.sum_eq_single j₀]
            · simp only [↓reduceIte, Pi.single_apply]
              rw [Finset.sum_eq_single i₀]
              · simp
              · intro i₁ _ hi₁; simp [Ne.symm hi₁]
              · intro hi₀; exact absurd (Finset.mem_univ i₀) hi₀
            · intro j₁ _ hj₁; simp [Ne.symm hj₁]
            · intro hj₀; exact absurd (Finset.mem_univ j₀) hj₀
          rw [← hid, hdecomp, map_sum, Finset.sum_apply, Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_sum, Finset.sum_apply, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_smul, Pi.smul_apply, smul_eq_mul, ← mul_assoc, mul_comm ((ℓ : K) ^ B), mul_assoc]
          change T c_vec j i * ((ℓ : K) ^ B * coeff_K (j, i, s)) = _
          rw [hc_int (j, i, s), hTc, mul_comm]
        refine ⟨hinj_ι ?_, hinj_ι ?_⟩
        · simpa [c_vec, map_mul, map_pow, map_natCast, map_sum] using hLc 0
        · simpa [c_vec, map_mul, map_pow, map_natCast, map_sum] using hLc 1

      let r₀ : ℕ := 2 * D.c_iso + 2 * B + 1
      obtain ⟨μ_r, hμ_r⟩ := h_coker r₀
      let mod_r : PadicInt ℓ →+* ZMod (ℓ ^ (r₀ + 1)) := PadicInt.toZModPow (r₀ + 1)
      let z₁_mod : Fin D.N → ZMod (ℓ ^ (r₀ + 1)) := fun i => mod_r (z₁ i)
      let z₂_mod : Fin D.N → ZMod (ℓ ^ (r₀ + 1)) := fun i => mod_r (z₂ i)
      let ψ_r : (ZMod (ℓ ^ (r₀ + 1)) × ZMod (ℓ ^ (r₀ + 1))) →+ (Fin D.N → ZMod (ℓ ^ (r₀ + 1))) :=
        { toFun := fun u => u.1 • z₁_mod + u.2 • z₂_mod
          map_zero' := by simp
          map_add' := fun u v => by ext i; simp; ring }
      let Φ : (ZMod (ℓ ^ (r₀ + 1)) × ZMod (ℓ ^ (r₀ + 1))) →+ ZMod (ℓ ^ (r₀ + 1)) :=
        μ_r.comp ψ_r

      have : NeZero (ℓ ^ (r₀ + 1)) := ⟨pow_ne_zero _ hℓ_prime.ne_zero⟩
      have hcard_zmod : Nat.card (ZMod (ℓ ^ (r₀ + 1))) = ℓ ^ (r₀ + 1) := Nat.card_zmod _
      have hcard_prod :
          Nat.card (ZMod (ℓ ^ (r₀ + 1)) × ZMod (ℓ ^ (r₀ + 1))) =
            (ℓ ^ (r₀ + 1)) * (ℓ ^ (r₀ + 1)) := by
        rw [Nat.card_prod, hcard_zmod]
      have hcard_range_le : Nat.card ↥Φ.range ≤ ℓ ^ (r₀ + 1) := by
        calc Nat.card ↥Φ.range
            ≤ Nat.card (ZMod (ℓ ^ (r₀ + 1))) :=
              Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
          _ = ℓ ^ (r₀ + 1) := hcard_zmod
      have hcard_ker_lower : ℓ ^ (r₀ + 1) ≤ Nat.card ↥Φ.ker := by
        have hmul := AddSubgroup.card_mul_index Φ.ker
        rw [AddSubgroup.index_ker, hcard_prod] at hmul
        have hpos : 0 < ℓ ^ (r₀ + 1) := pow_pos hℓ_prime.pos _
        have hle : Nat.card ↥Φ.ker * Nat.card ↥Φ.range ≤ Nat.card ↥Φ.ker * ℓ ^ (r₀ + 1) :=
          Nat.mul_le_mul_left _ hcard_range_le
        rw [hmul] at hle
        exact Nat.le_of_mul_le_mul_right hle hpos

      let E_exp : ℕ := D.c_iso + B + 2
      let Q_exp : ℕ := D.c_iso + B
      have hexp_sum : E_exp + Q_exp = r₀ + 1 := by omega
      have hPow_pos : 0 < ℓ ^ Q_exp := pow_pos hℓ_prime.pos _

      have hKerFactor : ∀ u : ↥Φ.ker,
          ∃ q₀ q₁ : Fin (ℓ ^ Q_exp),
            u.1.1 = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * (q₀.1 : ZMod (ℓ ^ (r₀ + 1))) ∧
            u.1.2 = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * (q₁.1 : ZMod (ℓ ^ (r₀ + 1))) := by
        rintro ⟨⟨u₀, u₁⟩, hu_ker⟩
        have hkill := hμ_r (ψ_r (u₀, u₁)) hu_ker
        let a₀ : PadicInt ℓ := u₀.val
        let a₁ : PadicInt ℓ := u₁.val
        have ha₀_mod : mod_r a₀ = u₀ := by
          change PadicInt.toZModPow (r₀ + 1) (u₀.val : PadicInt ℓ) = u₀
          rw [map_natCast, ZMod.natCast_zmod_val]
        have ha₁_mod : mod_r a₁ = u₁ := by
          change PadicInt.toZModPow (r₀ + 1) (u₁.val : PadicInt ℓ) = u₁
          rw [map_natCast, ZMod.natCast_zmod_val]
        let y : Fin k_0 → Fin D.N → PadicInt ℓ := fun j =>
          ((g_hom (γs j)).val - 1).mulVec (a₀ • z₁ + a₁ • z₂)
        have hy_dvd : ∀ (j : Fin k_0) (i : Fin D.N),
            ∃ w_ji : PadicInt ℓ, y j i = (ℓ : PadicInt ℓ) ^ (B + E_exp) * w_ji := by
          intro j i
          have hmod_zero : mod_r ((ℓ : PadicInt ℓ) ^ D.c_iso * y j i) = 0 := by
            have hj := congrFun (hkill (γs j)) i
            have hψ_eq : ψ_r (u₀, u₁) = fun s => mod_r ((a₀ • z₁ + a₁ • z₂) s) := by
              ext s
              simp [ψ_r, z₁_mod, z₂_mod, ha₀_mod, ha₁_mod, smul_eq_mul]
            have hy_mod : mod_r (y j i) =
                ((((g_hom (γs j)).val).map mod_r).mulVec (ψ_r (u₀, u₁)) - ψ_r (u₀, u₁)) i := by
              rw [hψ_eq]
              simp only [y, Matrix.mulVec, dotProduct, Matrix.sub_apply, Matrix.one_apply,
                Matrix.map_apply, Pi.sub_apply, map_sum, map_mul, map_sub]
              have hterm_i : mod_r ((a₀ • z₁ + a₁ • z₂) i) =
                  ∑ s : Fin D.N,
                    (if i = s then (1 : ZMod (ℓ ^ (r₀ + 1))) else 0) *
                      mod_r ((a₀ • z₁ + a₁ • z₂) s) := by
                simp
              conv_rhs => rw [hterm_i, ← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl fun s _ => ?_
              split_ifs with hsi
              · subst hsi; simp [sub_mul]
              · simp [sub_zero]
            rw [map_mul, map_pow, map_natCast, hy_mod]
            simpa [nsmul_eq_mul] using hj
          have hker : (ℓ : PadicInt ℓ) ^ D.c_iso * y j i ∈ RingHom.ker mod_r := hmod_zero
          rw [PadicInt.ker_toZModPow (r₀ + 1), Ideal.mem_span_singleton] at hker
          obtain ⟨w, hw⟩ := hker
          have hexp_r : r₀ + 1 = D.c_iso + (B + E_exp) := by omega
          have hcancel : (ℓ : PadicInt ℓ) ^ D.c_iso * y j i =
              (ℓ : PadicInt ℓ) ^ D.c_iso * ((ℓ : PadicInt ℓ) ^ (B + E_exp) * w) := by
            rw [hw, hexp_r, pow_add, mul_assoc]
          exact ⟨w, mul_left_cancel₀ (pow_ne_zero D.c_iso hℓ_ne_padicInt) hcancel⟩

        obtain ⟨ha₀_eq, ha₁_eq⟩ := hIntLeftInv a₀ a₁
        choose w_fn hw_fn using hy_dvd
        have hdiv_coord : ∀ a_m : PadicInt ℓ,
            (∃ s : Fin 2,
              (ℓ : PadicInt ℓ) ^ B * a_m =
                ∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, s) * y j i) →
            ∃ q : Fin (ℓ ^ Q_exp),
              mod_r a_m = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * (q.1 : ZMod (ℓ ^ (r₀ + 1))) := by
          rintro a_m ⟨s, hm_eq⟩
          have hrhs : (∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, s) * y j i) =
              (ℓ : PadicInt ℓ) ^ B *
                ((ℓ : PadicInt ℓ) ^ E_exp *
                  ∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, s) * w_fn j i) := by
            calc ∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, s) * y j i
                = ∑ j : Fin k_0, ∑ i : Fin D.N,
                    ((ℓ : PadicInt ℓ) ^ B * (ℓ : PadicInt ℓ) ^ E_exp) *
                      (c_int (j, i, s) * w_fn j i) := by
                  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
                  rw [hw_fn j i, pow_add]
                  ring
              _ = _ := by
                  simp only [Finset.mul_sum, mul_assoc]
          rw [hrhs] at hm_eq
          have ha_m_div : a_m =
              (ℓ : PadicInt ℓ) ^ E_exp *
                ∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, s) * w_fn j i :=
            mul_left_cancel₀ (pow_ne_zero B hℓ_ne_padicInt) hm_eq
          let t_mod : ZMod (ℓ ^ (r₀ + 1)) :=
            mod_r (∑ j : Fin k_0, ∑ i : Fin D.N, c_int (j, i, s) * w_fn j i)
          let rem : ℕ := t_mod.val % (ℓ ^ Q_exp)
          let quot : ℕ := t_mod.val / (ℓ ^ Q_exp)
          refine ⟨⟨rem, Nat.mod_lt _ hPow_pos⟩, ?_⟩
          have ht_nat : (t_mod.val : ZMod (ℓ ^ (r₀ + 1))) = t_mod := ZMod.natCast_zmod_val t_mod
          have hdiv_mod : t_mod.val = ℓ ^ Q_exp * quot + rem := (Nat.div_add_mod _ _).symm
          calc mod_r a_m
              = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * t_mod := by
                rw [ha_m_div, map_mul, map_pow, map_natCast]
            _ = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * (t_mod.val : ZMod (ℓ ^ (r₀ + 1))) := by
                rw [ht_nat]
            _ = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp *
                  (((ℓ ^ Q_exp : ℕ) : ZMod (ℓ ^ (r₀ + 1))) * (quot : ZMod (ℓ ^ (r₀ + 1))) +
                    (rem : ZMod (ℓ ^ (r₀ + 1)))) := by
                rw [hdiv_mod, Nat.cast_add, Nat.cast_mul]
            _ = ((ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ (E_exp + Q_exp)) * (quot : ZMod (ℓ ^ (r₀ + 1))) +
                  (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * (rem : ZMod (ℓ ^ (r₀ + 1))) := by
                rw [Nat.cast_pow, pow_add]
                ring
            _ = (ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ E_exp * (rem : ZMod (ℓ ^ (r₀ + 1))) := by
                have hzero : ((ℓ : ZMod (ℓ ^ (r₀ + 1))) ^ (r₀ + 1)) = 0 := by
                  rw [← Nat.cast_pow, ZMod.natCast_self]
                rw [hexp_sum, hzero, zero_mul, zero_add]

        obtain ⟨q₀, hq₀⟩ := hdiv_coord a₀ ⟨0, ha₀_eq⟩
        obtain ⟨q₁, hq₁⟩ := hdiv_coord a₁ ⟨1, ha₁_eq⟩
        rw [ha₀_mod] at hq₀
        rw [ha₁_mod] at hq₁
        exact ⟨q₀, q₁, hq₀, hq₁⟩

      choose q₀_fn q₁_fn hq_fn using hKerFactor
      let f_inj : ↥Φ.ker → Fin (ℓ ^ Q_exp) × Fin (ℓ ^ Q_exp) :=
        fun u => (q₀_fn u, q₁_fn u)
      have hf_inj : Function.Injective f_inj := by
        intro u v huv
        have h1 : q₀_fn u = q₀_fn v := congrArg Prod.fst huv
        have h2 : q₁_fn u = q₁_fn v := congrArg Prod.snd huv
        apply Subtype.ext
        apply Prod.ext
        · rw [(hq_fn u).1, (hq_fn v).1, h1]
        · rw [(hq_fn u).2, (hq_fn v).2, h2]

      have hcard_ker_upper : Nat.card ↥Φ.ker ≤ (ℓ ^ Q_exp) * (ℓ ^ Q_exp) := by
        calc Nat.card ↥Φ.ker
            ≤ Nat.card (Fin (ℓ ^ Q_exp) × Fin (ℓ ^ Q_exp)) :=
              Nat.card_le_card_of_injective f_inj hf_inj
          _ = (ℓ ^ Q_exp) * (ℓ ^ Q_exp) := by rw [Nat.card_prod, Nat.card_fin]
      have hpow_lt : (ℓ ^ Q_exp) * (ℓ ^ Q_exp) < ℓ ^ (r₀ + 1) := by
        rw [← pow_add]
        exact Nat.pow_lt_pow_right hℓ_gt1_nat (by omega)
      omega

    by_cases hW_top : W_s = ⊤
    · let i₀ : Fin D.N := ⟨0, hDN⟩
      let lam_0 : (Fin D.N → K) →ₗ[K] K := LinearMap.proj i₀
      have hlam_ne : lam_0 ≠ 0 := by
        intro h0
        have h1 : lam_0 (Pi.single i₀ 1) = 0 := by rw [h0]; rfl
        simp [lam_0] at h1
      refine ⟨lam_0, hlam_ne, fun y _ γ => ?_⟩
      have hyW : y ∈ W_s := hW_top ▸ Submodule.mem_top
      have h0 := (hmem_W y).mp hyW γ
      simpa [A_lin, Matrix.sub_mulVec, Matrix.one_mulVec, sub_eq_zero] using h0
    · obtain ⟨v₀, hv₀⟩ : ∃ v₀ : Fin D.N → K, v₀ ∉ W_s := by
        by_contra hall
        exact hW_top (eq_top_iff.mpr fun x _ => Classical.not_not.mp fun hx => hall ⟨x, hx⟩)
      obtain ⟨lam_0, hlam_v₀, hlam_W⟩ :=
        Submodule.exists_dual_map_eq_bot_of_notMem hv₀ (Module.Projective.of_free)
      have hlam_ne : lam_0 ≠ 0 := fun h0 => hlam_v₀ (by rw [h0]; rfl)
      have hW_le_ker : W_s ≤ LinearMap.ker lam_0 := by
        intro z hz
        have hm : lam_0 z ∈ Submodule.map lam_0 W_s := ⟨z, hz, rfl⟩
        rwa [hlam_W, Submodule.mem_bot] at hm
      have hfin_V : Module.finrank K (Fin D.N → K) = D.N := by
        rw [Module.finrank_pi, Fintype.card_fin]
      have hfin_W_lt : Module.finrank K ↥W_s < D.N := by
        have hlt := Submodule.finrank_lt hW_top
        rwa [hfin_V] at hlt
      have hfin_W_eq : Module.finrank K ↥W_s = D.N - 1 := by omega
      have hrange_top : LinearMap.range lam_0 = ⊤ := by
        rw [eq_top_iff]
        intro c _
        exact ⟨(c * (lam_0 v₀)⁻¹) • v₀, by simp [smul_eq_mul, mul_assoc, inv_mul_cancel₀ hlam_v₀]⟩
      have hfin_ker : Module.finrank K ↥(LinearMap.ker lam_0) = D.N - 1 := by
        have hrk := LinearMap.finrank_range_add_finrank_ker lam_0
        rw [hfin_V, hrange_top, finrank_top, Module.finrank_self] at hrk
        omega
      have hker_eq : W_s = LinearMap.ker lam_0 :=
        Submodule.eq_of_le_of_finrank_eq hW_le_ker (hfin_W_eq.trans hfin_ker.symm)
      refine ⟨lam_0, hlam_ne, fun y hy γ => ?_⟩
      have hyW : y ∈ W_s := hker_eq.symm ▸ hy
      have h0 := (hmem_W y).mp hyW γ
      simpa [A_lin, Matrix.sub_mulVec, Matrix.one_mulVec, sub_eq_zero] using h0

  
  have hSymplecticKummerPin : ∀ {Γ : Type u} [Group Γ]
      (g_hom : Γ →* (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ)
      (_hg_mem : ∀ γ : Γ, g_hom γ ∈ D.G_V)
      (t_ℓ : Γ → PadicInt ℓ)
      (_ht_one : t_ℓ 1 = 0)
      (_ht_mul : ∀ γ₁ γ₂ : Γ, t_ℓ (γ₁ * γ₂) = t_ℓ γ₁ + t_ℓ γ₂)
      (_ht_surj : Function.Surjective t_ℓ)
      (_hAbh : ∀ r : ℕ,
        (∀ γ : Γ, (((g_hom γ).val).map (PadicInt.toZModPow (r + 1)) - 1) ^ 2 = 0) →
        ∀ δ : Γ, PadicInt.toZModPow (r + 1) (t_ℓ δ) = 0 →
          ((g_hom δ).val).map (PadicInt.toZModPow (r + 1)) = 1)
      (lam_0 : (Fin D.N → K) →ₗ[K] K)
      (_hlam_ne : lam_0 ≠ 0)
      (_hlam_fix : ∀ y : Fin D.N → K, lam_0 y = 0 →
        ∀ γ : Γ, (((g_hom γ).val).map ι).mulVec y = y),
      ∃ (w_s : Fin D.N → K) (ψ_s : (Fin D.N → K) →ₗ[K] K) (γ_s : Γ),
        (w_s ≠ 0 ↔ ψ_s ≠ 0) ∧
        (∀ γ : Γ, ∀ x : Fin D.N → K,
          (((g_hom γ).val).map ι).mulVec x = x + ((t_ℓ γ : K) * ψ_s x) • w_s) ∧
        (∀ x : Fin D.N → K,
          (((g_hom γ_s).val).map ι).mulVec x = x + (ψ_s x) • w_s) := by
    intro Γ _ g_hom hg_mem t_ℓ ht_one ht_mul ht_surj hAbh lam_0 hlam_ne hlam_fix
    have hinj_ι : Function.Injective ι := fun _ _ h => Subtype.ext h
    by_cases hTriv : ∀ γ : Γ, g_hom γ = 1
    · refine ⟨0, 0, 1, by simp, ?_, ?_⟩
      · intro γ x
        have h1 : ((g_hom γ).val).map ι = 1 := by
          rw [hTriv γ]
          change (1 : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ)).map ι = 1
          rw [← RingHom.mapMatrix_apply, map_one]
        rw [h1, Matrix.one_mulVec]
        simp
      · intro x
        have h1 : ((g_hom 1).val).map ι = 1 := by
          rw [map_one]
          change (1 : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ)).map ι = 1
          rw [← RingHom.mapMatrix_apply, map_one]
        rw [h1, Matrix.one_mulVec]
        simp
    · have hex_γ₁ : ∃ γ₁ : Γ, g_hom γ₁ ≠ 1 := by
        by_contra hall
        exact hTriv fun γ => Classical.not_not.mp fun hne => hall ⟨γ, hne⟩
      obtain ⟨γ₁, hγ₁_ne⟩ := hex_γ₁
      have hSkew_pair : ∀ x y : Fin D.N → K,
          dotProduct x (D.J_V.mulVec y) = - dotProduct y (D.J_V.mulVec x) := by
        intro x y
        calc dotProduct x (D.J_V.mulVec y)
            = dotProduct (Matrix.vecMul x D.J_V) y := Matrix.dotProduct_mulVec x D.J_V y
          _ = dotProduct (D.J_V.transpose.mulVec x) y := by rw [Matrix.mulVec_transpose]
          _ = dotProduct ((-D.J_V).mulVec x) y := by rw [D.hJV_skew]
          _ = dotProduct (-(D.J_V.mulVec x)) y := by rw [Matrix.neg_mulVec]
          _ = - dotProduct (D.J_V.mulVec x) y := neg_dotProduct _ _
          _ = - dotProduct y (D.J_V.mulVec x) := by rw [dotProduct_comm]
      have hSelf_zero : ∀ x : Fin D.N → K, dotProduct x (D.J_V.mulVec x) = 0 := by
        intro x
        have h := hSkew_pair x x
        have h2 : (2 : K) * dotProduct x (D.J_V.mulVec x) = 0 := by linear_combination h
        exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
      have hGV_pair : ∀ g ∈ D.G_V, ∀ x y : Fin D.N → K,
          dotProduct (((g.val).map ι).mulVec x) (D.J_V.mulVec (((g.val).map ι).mulVec y)) =
            dotProduct x (D.J_V.mulVec y) := by
        intro g hg x y
        let U := (g.val).map ι
        calc dotProduct (U.mulVec x) (D.J_V.mulVec (U.mulVec y))
            = dotProduct (Matrix.vecMul x U.transpose) ((D.J_V * U).mulVec y) := by
                rw [← Matrix.mulVec_transpose, Matrix.transpose_transpose, Matrix.mulVec_mulVec]
          _ = dotProduct x (U.transpose.mulVec ((D.J_V * U).mulVec y)) := by
                rw [← Matrix.dotProduct_mulVec]
          _ = dotProduct x ((U.transpose * D.J_V * U).mulVec y) := by
                rw [Matrix.mulVec_mulVec, Matrix.mul_assoc]
          _ = dotProduct x (D.J_V.mulVec y) := by rw [D.hGV_sp g hg]

      obtain ⟨uJ, huJ⟩ := (Matrix.isUnit_iff_isUnit_det D.J_V).mpr (IsUnit.mk0 _ D.hJV_det)
      let v_lam : Fin D.N → K := fun i => lam_0 (Pi.single i 1)
      have hlam_dot : ∀ x : Fin D.N → K, lam_0 x = dotProduct x v_lam := by
        intro x
        have hx : x = ∑ i : Fin D.N, x i • Pi.single i (1 : K) := by
          ext i; simp [Pi.single_apply]
        conv_lhs => rw [hx, map_sum]
        simp [dotProduct, v_lam, smul_eq_mul]
      let w_s : Fin D.N → K := (uJ⁻¹.val).mulVec v_lam
      have hJw : D.J_V.mulVec w_s = v_lam := by
        dsimp only [w_s]
        rw [← huJ, Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec]
      have hlam_Jw : ∀ x : Fin D.N → K, lam_0 x = dotProduct x (D.J_V.mulVec w_s) := by
        intro x; rw [hJw, hlam_dot x]
      have hw_ne : w_s ≠ 0 := by
        intro h0
        apply hlam_ne
        apply LinearMap.ext
        intro x
        rw [hlam_Jw x, h0, Matrix.mulVec_zero, dotProduct_zero, LinearMap.zero_apply]
      have hlam_w : lam_0 w_s = 0 := by
        rw [hlam_Jw w_s]
        exact hSelf_zero w_s
      have hw_fix : ∀ γ : Γ, (((g_hom γ).val).map ι).mulVec w_s = w_s :=
        hlam_fix w_s hlam_w

      obtain ⟨x_raw, hx_raw⟩ : ∃ x_raw : Fin D.N → K, lam_0 x_raw ≠ 0 := by
        by_contra hall
        exact hlam_ne (LinearMap.ext fun x => Classical.not_not.mp fun hx => hall ⟨x, hx⟩)
      let x₀ : Fin D.N → K := (lam_0 x_raw)⁻¹ • x_raw
      have hlam_x₀ : lam_0 x₀ = 1 := by
        simp [x₀, inv_mul_cancel₀ hx_raw]

      let c_s : Γ → K := fun γ =>
        dotProduct x₀ (D.J_V.mulVec ((((g_hom γ).val).map ι).mulVec x₀ - x₀))
      have hAct : ∀ (γ : Γ) (x : Fin D.N → K),
          (((g_hom γ).val).map ι).mulVec x = x + (c_s γ * lam_0 x) • w_s := by
        intro γ x
        let G := ((g_hom γ).val).map ι
        let d_γ := G.mulVec x₀ - x₀
        have hd_eq : d_γ = c_s γ • w_s := by
          have hdot_zero : ∀ z : Fin D.N → K,
              dotProduct z (D.J_V.mulVec (d_γ - c_s γ • w_s)) = 0 := by
            intro z
            let y := z - (lam_0 z) • x₀
            have hlam_y : lam_0 y = 0 := by simp [y, hlam_x₀]
            have hGy : G.mulVec y = y := hlam_fix y hlam_y γ
            have hsp := hGV_pair (g_hom γ) (hg_mem γ) y x₀
            rw [hGy] at hsp
            have hyd : dotProduct y (D.J_V.mulVec d_γ) = 0 := by
              dsimp only [d_γ, G]
              rw [Matrix.mulVec_sub, dotProduct_sub, hsp, sub_self]
            simp only [y, sub_dotProduct, smul_dotProduct, smul_eq_mul] at hyd
            rw [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, dotProduct_smul,
              ← hlam_Jw z, smul_eq_mul]
            dsimp only [c_s, G, d_γ] at hyd ⊢
            linear_combination hyd
          have hJ_zero : D.J_V.mulVec (d_γ - c_s γ • w_s) = 0 := by
            ext i
            simpa using hdot_zero (Pi.single i 1)
          have hdiff_zero : d_γ - c_s γ • w_s = 0 := by
            calc d_γ - c_s γ • w_s
                = (uJ⁻¹.val * uJ.val).mulVec (d_γ - c_s γ • w_s) := by
                  rw [Units.inv_mul, Matrix.one_mulVec]
              _ = uJ⁻¹.val.mulVec (D.J_V.mulVec (d_γ - c_s γ • w_s)) := by
                  rw [huJ, Matrix.mulVec_mulVec]
              _ = 0 := by rw [hJ_zero, Matrix.mulVec_zero]
          exact sub_eq_zero.mp hdiff_zero
        let y := x - (lam_0 x) • x₀
        have hlam_y : lam_0 y = 0 := by simp [y, hlam_x₀]
        have hGy : G.mulVec y = y := hlam_fix y hlam_y γ
        have hx_decomp : x = y + (lam_0 x) • x₀ := by simp [y]
        calc G.mulVec x
            = G.mulVec y + (lam_0 x) • G.mulVec x₀ := by
              conv_lhs => rw [hx_decomp]
              rw [Matrix.mulVec_add, Matrix.mulVec_smul]
          _ = y + (lam_0 x) • (x₀ + d_γ) := by rw [hGy]; simp [d_γ]
          _ = (y + (lam_0 x) • x₀) + (lam_0 x) • (c_s γ • w_s) := by
              rw [hd_eq, smul_add, add_assoc]
          _ = x + (c_s γ * lam_0 x) • w_s := by rw [← hx_decomp, smul_smul, mul_comm]

      have hc_mul : ∀ γ_a γ_b : Γ, c_s (γ_a * γ_b) = c_s γ_a + c_s γ_b := by
        intro γ_a γ_b
        have hmap_mul : ((g_hom (γ_a * γ_b)).val).map ι =
            (((g_hom γ_a).val).map ι) * (((g_hom γ_b).val).map ι) := by
          rw [map_mul, Units.val_mul, ← RingHom.mapMatrix_apply, map_mul]
          rfl
        have h1 := hAct (γ_a * γ_b) x₀
        rw [hmap_mul, ← Matrix.mulVec_mulVec, hAct γ_b x₀, Matrix.mulVec_add,
          hAct γ_a x₀, Matrix.mulVec_smul, hw_fix γ_a, hlam_x₀, mul_one] at h1
        have hdiff : (c_s (γ_a * γ_b) - (c_s γ_a + c_s γ_b)) • w_s = 0 := by
          ext i
          have hi := congrFun h1 i
          simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hi ⊢
          linear_combination -hi
        obtain ⟨i_w, hi_w⟩ := Function.ne_iff.mp hw_ne
        have hi := congrFun hdiff i_w
        simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hi
        exact sub_eq_zero.mp ((mul_eq_zero.mp hi).resolve_right hi_w)

      have hc_one : c_s 1 = 0 := by
        have h := hc_mul 1 1; rw [mul_one] at h; linear_combination -h
      have hc_inv : ∀ γ : Γ, c_s (γ⁻¹) = - c_s γ := by
        intro γ; have h := hc_mul γ (γ⁻¹); rw [mul_inv_cancel, hc_one] at h; linear_combination -h
      have hc_pow : ∀ (γ : Γ) (n : ℕ), c_s (γ ^ n) = (n : K) * c_s γ := by
        intro γ n
        induction n with
        | zero => simp [hc_one]
        | succ n ih => rw [pow_succ, hc_mul, ih, Nat.cast_add, Nat.cast_one]; ring

      have hSqZero : ∀ (r : ℕ) (γ : Γ),
          (((g_hom γ).val).map (PadicInt.toZModPow (r + 1)) - 1) ^ 2 = 0 := by
        intro r γ
        have hK_sq : (((g_hom γ).val).map ι - 1) ^ 2 = 0 := by
          rw [sq]
          ext i j
          have hinner : ((((g_hom γ).val).map ι - 1).mulVec (Pi.single j 1)) =
              (c_s γ * lam_0 (Pi.single j 1)) • w_s := by
            rw [Matrix.sub_mulVec, Matrix.one_mulVec, hAct γ (Pi.single j 1), add_sub_cancel_left]
          have hcol := congrFun
            (by
              calc ((((g_hom γ).val).map ι - 1) * (((g_hom γ).val).map ι - 1)).mulVec
                    (Pi.single j 1)
                  = (((g_hom γ).val).map ι - 1).mulVec
                      ((((g_hom γ).val).map ι - 1).mulVec (Pi.single j 1)) :=
                    (Matrix.mulVec_mulVec _ _ _).symm
                _ = (((g_hom γ).val).map ι - 1).mulVec
                      ((c_s γ * lam_0 (Pi.single j 1)) • w_s) := by rw [hinner]
                _ = (c_s γ * lam_0 (Pi.single j 1)) •
                      ((((g_hom γ).val).map ι).mulVec w_s - w_s) := by
                    rw [Matrix.mulVec_smul, Matrix.sub_mulVec, Matrix.one_mulVec]
                _ = 0 := by rw [hw_fix γ, sub_self, smul_zero]) i
          simpa [Matrix.mulVec_single_one] using hcol
        have hInt_sq : ((g_hom γ).val - 1) ^ 2 = 0 := by
          have hmap_sq : (((g_hom γ).val - 1) ^ 2).map ι = (((g_hom γ).val).map ι - 1) ^ 2 := by
            rw [sq, sq]
            ext a b
            simp only [Matrix.map_apply, Matrix.mul_apply, Matrix.sub_apply, Matrix.one_apply,
              map_sum, map_mul, map_sub]
            refine Finset.sum_congr rfl fun s _ => ?_
            split_ifs <;> simp
          ext i j
          apply hinj_ι
          have hij := congrArg (fun M => M i j) (hmap_sq.trans hK_sq)
          simpa [Matrix.map_apply] using hij
        have hmod : ((((g_hom γ).val - 1) ^ 2).map (PadicInt.toZModPow (r + 1))) = 0 := by
          rw [hInt_sq]; ext i j; simp
        simpa only [← RingHom.mapMatrix_apply, map_pow, map_sub, map_one] using hmod

      obtain ⟨σ₀, hσ₀⟩ := ht_surj 1
      have ht_inv : ∀ γ : Γ, t_ℓ (γ⁻¹) = - t_ℓ γ := by
        intro γ
        have h := ht_mul γ (γ⁻¹)
        rw [mul_inv_cancel, ht_one] at h
        exact eq_neg_of_add_eq_zero_right h.symm
      have ht_pow_σ₀ : ∀ n : ℕ, t_ℓ (σ₀ ^ n) = (n : PadicInt ℓ) := by
        intro n
        induction n with
        | zero => simp [ht_one]
        | succ n ih => rw [pow_succ, ht_mul, ih, hσ₀, Nat.cast_add, Nat.cast_one]

      obtain ⟨i_w, hi_w⟩ := Function.ne_iff.mp hw_ne
      have hc_pin : ∀ γ : Γ, c_s γ = (t_ℓ γ : K) * c_s σ₀ := by
        intro γ
        by_contra hne
        have hdiff_ne : (c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w ≠ 0 :=
          mul_ne_zero (sub_ne_zero.mpr hne) hi_w
        let C_bound : ℝ := (∑ j : Fin D.N, ‖x₀ j‖) + ‖c_s σ₀ * w_s i_w‖
        have hBound : ∀ r : ℕ,
            ‖(c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w‖ ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) * C_bound := by
          intro r
          let n_r : ℕ := (PadicInt.toZModPow (r + 1) (t_ℓ γ)).val
          let δ_r : Γ := γ * (σ₀ ^ n_r)⁻¹
          have hδ_t : t_ℓ δ_r = t_ℓ γ - (n_r : PadicInt ℓ) := by
            dsimp only [δ_r]; rw [ht_mul, ht_inv, ht_pow_σ₀, sub_eq_add_neg]
          have hδ_ker : PadicInt.toZModPow (r + 1) (t_ℓ δ_r) = 0 := by
            rw [hδ_t, map_sub, map_natCast, ZMod.natCast_zmod_val, sub_self]
          have hδ_mat1 : ((g_hom δ_r).val).map (PadicInt.toZModPow (r + 1)) = 1 :=
            hAbh r (hSqZero r) δ_r hδ_ker
          have hδ_c : c_s δ_r = c_s γ - (n_r : K) * c_s σ₀ := by
            dsimp only [δ_r]; rw [hc_mul, hc_inv, hc_pow, sub_eq_add_neg]

          have hEntry_norm : ∀ j : Fin D.N,
              ‖ι (((g_hom δ_r).val - 1) i_w j)‖ ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) := by
            intro j
            have hker : ((g_hom δ_r).val - 1) i_w j ∈
                RingHom.ker (PadicInt.toZModPow (r + 1)) := by
              have hj := congrArg (fun M => M i_w j) hδ_mat1
              simp only [RingHom.mem_ker, Matrix.sub_apply, Matrix.map_apply, map_sub] at hj ⊢
              rw [hj]
              by_cases hij : i_w = j
              · subst hij; simp
              · simp [Matrix.one_apply_ne hij]
            rw [PadicInt.ker_toZModPow (r + 1), Ideal.mem_span_singleton] at hker
            obtain ⟨z_j, hz_j⟩ := hker
            rw [hz_j, map_mul, map_pow, map_natCast, norm_mul, norm_pow, Padic.norm_p]
            calc ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖ι z_j‖
                ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) * 1 :=
                  mul_le_mul_of_nonneg_left z_j.2 (by positivity)
              _ = ((ℓ : ℝ)⁻¹) ^ (r + 1) := mul_one _

          have ht_norm : ‖((n_r : K) - (t_ℓ γ : K)) * (c_s σ₀ * w_s i_w)‖ ≤
              ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖c_s σ₀ * w_s i_w‖ := by
            have hker_t : t_ℓ γ - (n_r : PadicInt ℓ) ∈
                RingHom.ker (PadicInt.toZModPow (r + 1)) := by
              rw [RingHom.mem_ker, ← hδ_t, hδ_ker]
            rw [PadicInt.ker_toZModPow (r + 1), Ideal.mem_span_singleton] at hker_t
            obtain ⟨z_t, hz_t⟩ := hker_t
            have hsub_eq : (n_r : K) - (t_ℓ γ : K) = - ((ℓ : K) ^ (r + 1) * ι z_t) := by
              have h1 := congrArg ι hz_t
              simp only [map_sub, map_natCast, map_mul, map_pow] at h1
              change (n_r : K) - ι (t_ℓ γ) = _
              linear_combination -h1
            rw [hsub_eq, norm_mul, norm_neg, norm_mul, norm_pow, Padic.norm_p]
            calc (((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖ι z_t‖) * ‖c_s σ₀ * w_s i_w‖
                ≤ (((ℓ : ℝ)⁻¹) ^ (r + 1) * 1) * ‖c_s σ₀ * w_s i_w‖ :=
                  mul_le_mul_of_nonneg_right
                    (mul_le_mul_of_nonneg_left z_t.2 (by positivity))
                    (norm_nonneg _)
              _ = ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖c_s σ₀ * w_s i_w‖ := by ring

          have hAct_δ : (c_s γ - (n_r : K) * c_s σ₀) * w_s i_w =
              ∑ j : Fin D.N, ι (((g_hom δ_r).val - 1) i_w j) * x₀ j := by
            have h1 := congrFun (hAct δ_r x₀) i_w
            rw [hlam_x₀, mul_one, hδ_c] at h1
            have h2 : ((((g_hom δ_r).val).map ι).mulVec x₀ - x₀) i_w =
                (c_s γ - (n_r : K) * c_s σ₀) * w_s i_w := by
              simp only [Pi.sub_apply, h1, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
                add_sub_cancel_left]
            rw [← h2]
            simp only [Matrix.mulVec, dotProduct, Matrix.sub_apply, Matrix.map_apply,
              Matrix.one_apply, Pi.sub_apply, map_sub]
            have hx₀_sum : x₀ i_w = ∑ j : Fin D.N, (if i_w = j then (1 : K) else 0) * x₀ j := by
              simp
            conv_lhs => rw [hx₀_sum, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun j _ => ?_
            split_ifs <;> simp [sub_mul]

          have hSplit : (c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w =
              (c_s γ - (n_r : K) * c_s σ₀) * w_s i_w +
                ((n_r : K) - (t_ℓ γ : K)) * (c_s σ₀ * w_s i_w) := by ring
          rw [hSplit]
          calc ‖(c_s γ - (n_r : K) * c_s σ₀) * w_s i_w +
                  ((n_r : K) - (t_ℓ γ : K)) * (c_s σ₀ * w_s i_w)‖
              ≤ ‖(c_s γ - (n_r : K) * c_s σ₀) * w_s i_w‖ +
                  ‖((n_r : K) - (t_ℓ γ : K)) * (c_s σ₀ * w_s i_w)‖ := norm_add_le _ _
            _ ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) * (∑ j : Fin D.N, ‖x₀ j‖) +
                  ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖c_s σ₀ * w_s i_w‖ := by
                refine add_le_add ?_ ht_norm
                rw [hAct_δ]
                calc ‖∑ j : Fin D.N, ι (((g_hom δ_r).val - 1) i_w j) * x₀ j‖
                    ≤ ∑ j : Fin D.N, ‖ι (((g_hom δ_r).val - 1) i_w j) * x₀ j‖ := norm_sum_le _ _
                  _ = ∑ j : Fin D.N, ‖ι (((g_hom δ_r).val - 1) i_w j)‖ * ‖x₀ j‖ :=
                      Finset.sum_congr rfl fun j _ => norm_mul _ _
                  _ ≤ ∑ j : Fin D.N, ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖x₀ j‖ :=
                      Finset.sum_le_sum fun j _ =>
                        mul_le_mul_of_nonneg_right (hEntry_norm j) (norm_nonneg _)
                  _ = ((ℓ : ℝ)⁻¹) ^ (r + 1) * (∑ j : Fin D.N, ‖x₀ j‖) :=
                      (Finset.mul_sum _ _ _).symm
            _ = ((ℓ : ℝ)⁻¹) ^ (r + 1) * C_bound := by dsimp only [C_bound]; ring

        have hpos : 0 < ‖(c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w‖ :=
          norm_pos_iff.mpr hdiff_ne
        have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
        have hℓ_pos : (0 : ℝ) < (ℓ : ℝ) := by linarith
        obtain ⟨r, hr⟩ := pow_unbounded_of_one_lt
          (C_bound / ‖(c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w‖) hℓ_gt1
        have hr1 : C_bound / ‖(c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w‖ < (ℓ : ℝ) ^ (r + 1) :=
          hr.trans_le (pow_le_pow_right₀ hℓ_gt1.le (Nat.le_succ r))
        rw [div_lt_iff₀ hpos] at hr1
        have hb := hBound r
        have hmul : ‖(c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w‖ * (ℓ : ℝ) ^ (r + 1) ≤ C_bound := by
          calc ‖(c_s γ - (t_ℓ γ : K) * c_s σ₀) * w_s i_w‖ * (ℓ : ℝ) ^ (r + 1)
              ≤ (((ℓ : ℝ)⁻¹) ^ (r + 1) * C_bound) * (ℓ : ℝ) ^ (r + 1) :=
                mul_le_mul_of_nonneg_right hb (by positivity)
            _ = (((ℓ : ℝ)⁻¹ * (ℓ : ℝ)) ^ (r + 1)) * C_bound := by ring
            _ = C_bound := by rw [inv_mul_cancel₀ hℓ_pos.ne', one_pow, one_mul]
        linarith

      have hc_γ₁_ne : c_s γ₁ ≠ 0 := by
        intro h0
        apply hγ₁_ne
        apply Units.ext
        ext i j
        apply hinj_ι
        have hcol := congrFun (hAct γ₁ (Pi.single j 1)) i
        rw [h0, zero_mul, zero_smul, add_zero, Matrix.mulVec_single_one] at hcol
        by_cases hij : i = j
        · subst hij; simpa using hcol
        · simpa [Pi.single_eq_of_ne hij, Matrix.one_apply_ne hij] using hcol
      have hc_σ₀_ne : c_s σ₀ ≠ 0 := by
        intro h0
        have h1 := hc_pin γ₁
        rw [h0, mul_zero] at h1
        exact hc_γ₁_ne h1

      let ψ_s : (Fin D.N → K) →ₗ[K] K := c_s σ₀ • lam_0
      have hψ_ne : ψ_s ≠ 0 := smul_ne_zero hc_σ₀_ne hlam_ne
      refine ⟨w_s, ψ_s, σ₀, ⟨fun _ => hψ_ne, fun _ => hw_ne⟩, ?_, ?_⟩
      · intro γ x
        rw [hAct γ x, hc_pin γ]
        simp [ψ_s, mul_assoc]
      · intro x
        rw [hAct σ₀ x, hc_pin σ₀, hσ₀]
        simp [ψ_s]

  
  have hSinglePoint : ∀ (s_pt : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D₀.left)
      (_hs_sec : s_pt ≫ D₀.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (x_pt : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left)
      (_hx_pt : x_pt ≫ f₀.left = s_pt)
      (_hSm_away_pt : ∀ z : Z_tilde.left,
        f₀.left.base z ∈ Set.range s_pt.base → z ∉ Set.range x_pt.base →
        ∃ V : Z_tilde.left.Opens, z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
      (_hOdp_pt : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
        IsEtaleSplitOdpPointOver m f₀ (x_pt.base pt) (s_pt.base pt))
      (α_pt : RatFunc F ≃ₐ[F] RatFunc F)
      (t_pt : RatFunc F)
      (_hα_pt : α_pt RatFunc.X = t_pt)
      (g_s : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ D₀.left)
      (_hg_hom : g_s ≫ D₀.hom =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (p_R.comp (Polynomial.C.comp (algebraMap F k)))))
      (_hg_cl : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_s =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)) ≫ s_pt)
      (_hg_gen : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (((algebraMap (FractionRing P) Ω).comp (ι_Fk.comp α_pt.symm.toRingHom)).comp
              (algebraMap (Polynomial F) (RatFunc F)))) ≫ j_aff),
      ∃ (w_s : Fin D.N → K)
        (ψ_s : (Fin D.N → K) →ₗ[K] K)
        (Q_pt : ∀ r : ℕ,
          Ideal ↥(integralClosure
            ↥(Algebra.adjoin F ({algebraMap (RatFunc F) (D.L_V r) t_pt} : Set (D.L_V r)))
            (D.L_V r)))
        (u_s : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
        (w_s ≠ 0 ↔ ψ_s ≠ 0) ∧
        u_s ∈ D.G_V ∧
        (∀ x : Fin D.N → K, ((u_s.val).map ι).mulVec x = x + (ψ_s x) • w_s) ∧
        (∀ t : PadicInt ℓ, ∃ g ∈ D.G_V, ∀ x : Fin D.N → K,
          ((g.val).map ι).mulVec x = x + ((t : K) * ψ_s x) • w_s) ∧
        (∀ r : ℕ,
          let A_pt_r := Algebra.adjoin F ({algebraMap (RatFunc F) (D.L_V r) t_pt} : Set (D.L_V r))
          let gen_pt_r : ↥A_pt_r :=
            ⟨algebraMap (RatFunc F) (D.L_V r) t_pt, Algebra.self_mem_adjoin_singleton F _⟩
          let C_pt_r := integralClosure ↥A_pt_r (D.L_V r)
          let A_pt_succ :=
            Algebra.adjoin F
              ({algebraMap (RatFunc F) (D.L_V (r + 1)) t_pt} : Set (D.L_V (r + 1)))
          let C_pt_succ := integralClosure ↥A_pt_succ (D.L_V (r + 1))
          (Q_pt r).IsPrime ∧
          Ideal.comap (algebraMap ↥A_pt_r ↥C_pt_r) (Q_pt r) = Ideal.span {gen_pt_r} ∧
          (∀ σ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
            (∃ σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r,
              (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
              (∀ y : ↥C_pt_r,
                σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                  Subtype.val '' (Q_pt r : Set ↥C_pt_r))) ↔
            (∃ (τ_L : D.L_V (r + 1) ≃ₐ[RatFunc F] D.L_V (r + 1))
               (τ_B : D.B_V (r + 1) ≃ₐ[R₀] D.B_V (r + 1)),
              (∀ x : D.L_V (r + 1), IsIntegral F x → τ_L x = x) ∧
              (∀ b : D.B_V (r + 1), τ_L (algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) b) =
                algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) (τ_B b)) ∧
              (∀ y : ↥C_pt_succ,
                τ_L (y : D.L_V (r + 1)) - (y : D.L_V (r + 1)) ∈
                  Subtype.val '' (Q_pt (r + 1) : Set ↥C_pt_succ)) ∧
              (∀ b : D.B_V r, τ_B (D.ι_BV r b) = D.ι_BV r (σ_B b)))) ∧
          (∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
            (∀ y : ↥C_pt_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_pt r : Set ↥C_pt_r)) →
            ∃ u ∈ D.G_V,
              (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
              ∃ φ : (Fin D.N → K) →ₗ[K] K,
                ∀ x : Fin D.N → K,
                  ((u.val).map ι).mulVec x = x + (φ x) • w_s) ∧
          (∃ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C_pt_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_pt r : Set ↥C_pt_r)) ∧
            (D.ρ_V r σ_B).val = (u_s.val).map (PadicInt.toZModPow (r + 1)))) := by
    intro s_pt hs_sec x_pt hx_pt hSm_away_pt hOdp_pt α_pt t_pt hα_pt g_s hg_hom hg_cl hg_gen
    let ψ_k : RatFunc F →+* FractionRing P := ι_Fk.comp α_pt.symm.toRingHom
    let ψ_pt : RatFunc F →+* Ω := (algebraMap (FractionRing P) Ω).comp ψ_k
    let ψ_gen : Polynomial F →+* Ω := ψ_pt.comp (algebraMap (Polynomial F) (RatFunc F))

    have hψ_k_F : ψ_k.comp (algebraMap F (RatFunc F)) =
        (algebraMap P (FractionRing P)).comp (Polynomial.C.comp (algebraMap F k)) := by
      ext c
      change ι_Fk (α_pt.symm (algebraMap F (RatFunc F) c)) = _
      rw [α_pt.symm.commutes c]
      exact RingHom.congr_fun hι_Fk_F c
    have hψ_k_t : ψ_k t_pt = algebraMap P (FractionRing P) Polynomial.X := by
      change ι_Fk (α_pt.symm t_pt) = _
      rw [← hα_pt, α_pt.symm_apply_apply, hι_Fk_X]

    obtain ⟨V_s, j_val, π_Vs, ι_L, Q_pt, I_Vs, res_L, res_B, t_ℓ,
      ⟨hj_val_loc, hj_val_Ω, hπ_Vs_ker, hπ_Vs_cl⟩,
      ⟨hI_Vs_mem, ht_one, ht_mul, ht_surj⟩,
      hTower_pt⟩ :=
      weil_odp_wit_val_prime_tower_and_kummer_inertia F S_aff ℓ D.N hℓ
        D.B_V D.L_V D.ρ_V D.hρ_inj D.ι_BV
        (fun r => (D.hι_compat r).1)
        (fun r τ => let ⟨σ, hσ, _⟩ := (D.hι_compat r).2 τ; ⟨σ, hσ⟩)
        R_bar p_R t_bar π_cl φ_R_Ω ht_eq hπ_pR hφ_pR hφ_inj hLoc_R
        α_pt t_pt hα_pt ψ_k ψ_pt rfl hψ_k_F hψ_k_t

    
    have hResCompat : ∀ (γ : ↥I_Vs) (r : ℕ),
        ((D.ρ_V (r + 1) (res_B (r + 1) γ)).val).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          (D.ρ_V r (res_B r γ)).val := by
      intro γ r
      obtain ⟨σ', hσ'_comm, hσ'_mod⟩ := (D.hι_compat r).2 (res_B (r + 1) γ)
      have hres_comm := (hTower_pt r).2.2.2.2.1 γ |>.2.2.2.1
      have hσ'_eq : σ' = res_B r γ := by
        ext b
        apply (D.hι_compat r).1
        rw [← hσ'_comm b, hres_comm b]
      rwa [hσ'_eq] at hσ'_mod

    have hg_ex_uniq : ∀ γ : ↥I_Vs,
        ∃! g : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ,
          ∀ r : ℕ, (g.val).map (PadicInt.toZModPow (r + 1)) = (D.ρ_V r (res_B r γ)).val :=
      fun γ => hPadicMatrixLift (fun r => D.ρ_V r (res_B r γ)) (hResCompat γ)

    let g_fn : ↥I_Vs → (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ :=
      fun γ => Classical.choose (hg_ex_uniq γ)
    have hg_fn_mod : ∀ (γ : ↥I_Vs) (r : ℕ),
        ((g_fn γ).val).map (PadicInt.toZModPow (r + 1)) = (D.ρ_V r (res_B r γ)).val :=
      fun γ => (Classical.choose_spec (hg_ex_uniq γ)).1
    have hg_fn_uniq : ∀ (γ : ↥I_Vs) (g' : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
        (∀ r : ℕ, (g'.val).map (PadicInt.toZModPow (r + 1)) = (D.ρ_V r (res_B r γ)).val) →
        g' = g_fn γ :=
      fun γ g' hg' => (Classical.choose_spec (hg_ex_uniq γ)).2 g' hg'

    let g_hom : ↥I_Vs →* (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ :=
      { toFun := g_fn
        map_one' := (hg_fn_uniq 1 1 fun r => by
          rw [map_one, map_one, Units.val_one, Units.val_one]
          exact hMapOne (PadicInt.toZModPow (r + 1))).symm
        map_mul' := fun γ₁ γ₂ => (hg_fn_uniq (γ₁ * γ₂) (g_fn γ₁ * g_fn γ₂) fun r => by
          rw [Units.val_mul, hMapMul (PadicInt.toZModPow (r + 1)), hg_fn_mod γ₁ r, hg_fn_mod γ₂ r,
            map_mul, map_mul, Units.val_mul]).symm }

    have hg_mem : ∀ γ : ↥I_Vs, g_hom γ ∈ D.G_V := by
      intro γ
      apply hG_closed (g_hom γ)
      intro r
      refine ⟨res_B r γ, ?_, (hg_fn_mod γ r).symm⟩
      intro x hx
      have hfixL := (hTower_pt r).2.2.2.2.1 γ |>.2.1 _ (hInt_BL r x hx)
      have hcommB := (hTower_pt r).2.2.2.2.1 γ |>.2.2.1 x
      rw [hcommB] at hfixL
      exact IsFractionRing.injective (D.B_V r) (D.L_V r) hfixL

    
    let η_D : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ D₀.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s
    have hψ_gen_inj : Function.Injective ψ_gen :=
      (RingHom.injective ψ_pt).comp (IsFractionRing.injective (Polynomial F) (RatFunc F))
    have hg_range : Set.range η_D.base ⊆ (U₀ : Set D₀.left) := by
      rw [hU₀_eq]
      rintro _ ⟨pt_Ω, rfl⟩
      have hpt_eq : η_D.base pt_Ω =
          j_aff.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen)).base pt_Ω) := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s).base pt_Ω = _
        rw [hg_gen]
        rfl
      rw [hpt_eq]
      refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen)).base pt_Ω, ?_, rfl⟩
      intro b _ hmem
      have hmem' : ψ_gen (Polynomial.X - Polynomial.C b) ∈ pt_Ω.asIdeal := hmem
      have hne : ψ_gen (Polynomial.X - Polynomial.C b) ≠ 0 := fun h0 =>
        (Polynomial.monic_X_sub_C b).ne_zero (hψ_gen_inj (h0.trans (map_zero _).symm))
      have hunit : IsUnit (ψ_gen (Polynomial.X - Polynomial.C b)) := IsUnit.mk0 _ hne
      exact pt_Ω.isPrime.ne_top (pt_Ω.asIdeal.eq_top_of_isUnit_mem hmem' hunit)

    have hg_γ_inv : ∀ γ : Ω ≃ₐ[FractionRing P] Ω,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ η_D = η_D := by
      intro γ
      dsimp only [η_D]
      rw [hg_gen, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hcomp_eq : γ.toRingHom.comp ψ_gen = ψ_gen := by
        apply RingHom.ext
        intro p
        exact γ.commutes (ψ_k (algebraMap (Polynomial F) (RatFunc F) p))
      rw [hcomp_eq]

    
    have hCoker_all : ∀ r : ℕ,
        ∃ μ_r : (Fin D.N → ZMod (ℓ ^ (r + 1))) →+ ZMod (ℓ ^ (r + 1)),
          ∀ v : Fin D.N → ZMod (ℓ ^ (r + 1)),
            μ_r v = 0 →
            ∀ γ : ↥I_Vs,
              (ℓ ^ D.c_iso) •
                ((((g_hom γ).val).map (PadicInt.toZModPow (r + 1))).mulVec v - v) = 0 := by
      intro r
      let ι_B_r : D.B_V r →+* Ω := (ι_L r).comp (algebraMap (D.B_V r) (D.L_V r))
      have hη_D_r : η_D =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B_r) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (D.B_V r))) ≫
            D.e_U.hom ≫ U₀.ι := by
        dsimp only [η_D]
        rw [hg_gen, D.heU_eq]
        have hring_eq :
            (ι_B_r.comp (algebraMap R₀ (D.B_V r))).comp (algebraMap (Polynomial F) R₀) = ψ_gen := by
          apply RingHom.ext
          intro p
          simp only [RingHom.comp_apply, ι_B_r]
          rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (D.B_V r),
            ← IsScalarTower.algebraMap_apply (Polynomial F) (D.B_V r) (D.L_V r),
            IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (D.L_V r)]
          have hιL := RingHom.congr_fun (hTower_pt r).1 (algebraMap (Polynomial F) (RatFunc F) p)
          simpa [ψ_gen] using hιL
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hring_eq]

      obtain ⟨hPB_r, hNat_r, hRest_r⟩ := hTriv_V r
      obtain ⟨α_Ω, β_Ω, hβα_Ω, hEquiv_Ω⟩ :=
        weil_odp_wit_geom_generic_stalk_equivariance F (2 * m + 1) ℓ D.N r D.c_iso hℓ
          Z_tilde hProj_Ztilde f₀ j_aff hj_open hj_hom S_aff U₀ hU₀_eq
          D.e_U D.heU_eq (D.B_V r) (D.L_V r) (D.ρ_V r) (D.𝒱₀ r) (triv_V r)
          ⟨hPB_r, hNat_r, fun W => ⟨(hRest_r W).1, (hRest_r W).2.1⟩⟩
          (D.α_U₀ r) (D.β_U₀ r) (D.hβα_id r) Ω ι_B_r η_D hη_D_r

      obtain ⟨ν_r, hν_r⟩ :=
        weil_odp_wit_local_odp_spec_coker_cyclic F m ℓ r hℓ Z_tilde hProj_Ztilde f₀ hFibIrred
          j_aff hj_open hj_hom U₀ hSm_U₀ s_pt hs_sec x_pt hx_pt hSm_away_pt hOdp_pt
          R_bar p_R t_bar π_cl φ_R_Ω ℐ D_col α_col c_col hc_col e_pt
          ⟨ht_eq, hπ_pR, hφ_pR, hφ_inj, hLoc_R⟩ hColim_props hLiftTrait
          V_s j_val π_Vs hj_val_loc hj_val_Ω hπ_Vs_ker hπ_Vs_cl
          g_s hg_hom hg_cl hg_range ⟨ψ_gen, hψ_gen_inj, hg_gen⟩ hg_γ_inv

      refine ⟨ν_r.comp α_Ω, fun v hμ0 γ => ?_⟩
      let Z_Ω := CategoryTheory.Limits.pullback f₀.left η_D
      let fst_Z := CategoryTheory.Limits.pullback.fst f₀.left η_D
      let snd_Z := CategoryTheory.Limits.pullback.snd f₀.left η_D
      have hcomm_τ : fst_Z ≫ f₀.left =
          (snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.1.toRingHom)) ≫ η_D := by
        rw [CategoryTheory.Category.assoc, hg_γ_inv γ.1]
        exact CategoryTheory.Limits.pullback.condition
      let τ_Z : Z_Ω ⟶ Z_Ω :=
        CategoryTheory.Limits.pullback.lift fst_Z
          (snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.1.toRingHom)) hcomm_τ
      have hτ_fst : τ_Z ≫ fst_Z = fst_Z :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hτ_snd : τ_Z ≫ snd_Z =
          snd_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.1.toRingHom) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hγ_compat_B : ∀ b : D.B_V r, γ.1.toRingEquiv (ι_B_r b) = ι_B_r (res_B r γ b) := by
        intro b
        dsimp only [ι_B_r, RingHom.comp_apply]
        have h1 := (hTower_pt r).2.2.2.2.1 γ |>.1 (algebraMap (D.B_V r) (D.L_V r) b)
        have h2 := (hTower_pt r).2.2.2.2.1 γ |>.2.2.1 b
        exact h1.trans (congrArg (ι_L r) h2)

      obtain ⟨p_τ, hp_τ, hp_act⟩ :=
        hEquiv_Ω γ.1.toRingEquiv (res_B r γ) hγ_compat_B τ_Z hτ_fst hτ_snd
      have hp_fix := hν_r (α_Ω v) hμ0 γ.1 ((hI_Vs_mem γ.1).mp γ.2) τ_Z hτ_fst hτ_snd p_τ hp_τ
      have hα_eq : α_Ω (((D.ρ_V r (res_B r γ)).val).mulVec v) = α_Ω v :=
        (hp_act v).symm.trans hp_fix
      have hβ_eq := congrArg β_Ω hα_eq
      rw [hβα_Ω, hβα_Ω, ← hg_fn_mod γ r] at hβ_eq
      change (ℓ ^ D.c_iso) • (((g_hom γ).val).map (PadicInt.toZModPow (r + 1))).mulVec v =
        (ℓ ^ D.c_iso) • v at hβ_eq
      rw [smul_sub, hβ_eq, sub_self]

    obtain ⟨lam_0, hlam_ne, hlam_fix⟩ := hPigeonholeHyperplane g_hom hCoker_all

    have hAbh_mat : ∀ r : ℕ,
        (∀ γ : ↥I_Vs, (((g_hom γ).val).map (PadicInt.toZModPow (r + 1)) - 1) ^ 2 = 0) →
        ∀ δ : ↥I_Vs, PadicInt.toZModPow (r + 1) (t_ℓ δ) = 0 →
          ((g_hom δ).val).map (PadicInt.toZModPow (r + 1)) = 1 := by
      intro r hSq δ hδ0
      have hSq' : ∀ γ : ↥I_Vs, ((D.ρ_V r (res_B r γ)).val - 1) ^ 2 = 0 := by
        intro γ
        rw [← hg_fn_mod γ r]
        exact hSq γ
      have hres1 : res_B r δ = 1 := (hTower_pt r).2.2.2.2.2.2.2 hSq' δ hδ0
      change ((g_fn δ).val).map (PadicInt.toZModPow (r + 1)) = 1
      rw [hg_fn_mod δ r, hres1, map_one, Units.val_one]

    obtain ⟨w_s, ψ_s, γ_s, hIff_s, hAct_all, hAct_γs⟩ :=
      hSymplecticKummerPin g_hom hg_mem t_ℓ ht_one ht_mul ht_surj hAbh_mat lam_0 hlam_ne hlam_fix

    refine ⟨w_s, ψ_s, Q_pt, g_hom γ_s, hIff_s, hg_mem γ_s, hAct_γs, ?_, ?_⟩
    · intro t
      obtain ⟨γ_t, rfl⟩ := ht_surj t
      exact ⟨g_hom γ_t, hg_mem γ_t, hAct_all γ_t⟩
    · intro r
      obtain ⟨_, _, hQp_r, hQcomap_r, hγ_props_r, hTrans_r, hLift_r, _⟩ := hTower_pt r
      refine ⟨hQp_r, hQcomap_r, hTrans_r, ?_, ?_⟩
      · intro σ_L σ_B hInt hCompat hInertQ
        obtain ⟨γ, rfl, rfl⟩ := hLift_r σ_L σ_B hInt hCompat hInertQ
        exact ⟨g_hom γ, hg_mem γ, (hg_fn_mod γ r).symm, (t_ℓ γ : K) • ψ_s, fun x => by
          rw [hAct_all γ x]
          simp [smul_eq_mul]⟩
      · obtain ⟨_, hInt_s, hCompat_s, _, hInert_s⟩ := hγ_props_r γ_s
        exact ⟨res_L r γ_s, res_B r γ_s, hInt_s, hCompat_s, hInert_s, (hg_fn_mod γ_s r).symm⟩

  
  obtain ⟨V_inf, hCR_V, j_V, π_0, ι_inv, g_inf_0,
    _, hjV_univ, hπ0_jV, hι_C, hι_X, hginf_hom, hginf_cl, hginf_gen⟩ :=
    weil_odp_wit_p1_inf_dvr_chart_bridge F j_aff hj_open hj_hom s_inf hsinf_sec hsinf_compl
  let _ : CommRing V_inf := hCR_V

  have heval_map_Fk : (Polynomial.evalRingHom (0 : k)).comp
      (Polynomial.mapRingHom (algebraMap F k)) =
      (algebraMap F k).comp (Polynomial.evalRingHom 0) := by
    apply Polynomial.ringHom_ext'
    · ext c; simp
    · simp

  let f_inf_R : Polynomial F →+* R_bar := p_R.comp (Polynomial.mapRingHom (algebraMap F k))
  have hf_inf_units : ∀ p : Polynomial F, Polynomial.eval 0 p ≠ 0 → IsUnit (f_inf_R p) := by
    intro p hp0
    have hπ_ne : π_cl (f_inf_R p) ≠ 0 := by
      have h1 : (π_cl.comp f_inf_R) p = ((algebraMap F k).comp (Polynomial.evalRingHom 0)) p := by
        have hc : π_cl.comp f_inf_R =
            (π_cl.comp p_R).comp (Polynomial.mapRingHom (algebraMap F k)) := rfl
        rw [hc, hπ_pR, heval_map_Fk]
      rw [RingHom.comp_apply] at h1
      rw [h1]
      exact fun h0 => hp0 ((RingHom.injective (algebraMap F k)) (h0.trans (map_zero _).symm))
    have hnot_max : f_inf_R p ∉ IsLocalRing.maximalIdeal R_bar := by
      rw [← hπ_ker, RingHom.mem_ker]
      exact hπ_ne
    exact IsLocalRing.notMem_maximalIdeal.mp hnot_max

  obtain ⟨φ_V_R, hφVR_jV, _⟩ := hjV_univ f_inf_R hf_inf_units
  let g_inf : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ D₀.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_V_R) ≫ g_inf_0

  have hg_inf_hom : g_inf ≫ D₀.hom =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (p_R.comp (Polynomial.C.comp (algebraMap F k)))) := by
    dsimp only [g_inf]
    rw [CategoryTheory.Category.assoc, hginf_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomp_C : φ_V_R.comp (j_V.comp Polynomial.C) =
        p_R.comp (Polynomial.C.comp (algebraMap F k)) := by
      rw [← RingHom.comp_assoc, hφVR_jV]
      ext c
      simp [f_inf_R]
    rw [hcomp_C]

  have hg_inf_cl : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_inf =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)) ≫ s_inf := by
    have hf_k_units : ∀ p : Polynomial F,
        Polynomial.eval 0 p ≠ 0 → IsUnit (((algebraMap F k).comp (Polynomial.evalRingHom 0)) p) :=
      fun p hp0 => IsUnit.mk0 _ fun h0 =>
        hp0 ((RingHom.injective (algebraMap F k)) (h0.trans (map_zero _).symm))
    obtain ⟨_, _, huniq_k⟩ := hjV_univ ((algebraMap F k).comp (Polynomial.evalRingHom 0)) hf_k_units
    have h1 : (π_cl.comp φ_V_R).comp j_V = (algebraMap F k).comp (Polynomial.evalRingHom 0) := by
      rw [RingHom.comp_assoc, hφVR_jV]
      change (π_cl.comp p_R).comp (Polynomial.mapRingHom (algebraMap F k)) = _
      rw [hπ_pR, heval_map_Fk]
    have h2 : (((algebraMap F k).comp π_0).comp j_V) =
        (algebraMap F k).comp (Polynomial.evalRingHom 0) := by
      rw [RingHom.comp_assoc, hπ0_jV]
    have hπ_eq : π_cl.comp φ_V_R = (algebraMap F k).comp π_0 :=
      (huniq_k _ h1).trans (huniq_k _ h2).symm
    dsimp only [g_inf]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hπ_eq, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc, hginf_cl]

  have hg_inf_gen : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_inf =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (((algebraMap (FractionRing P) Ω).comp (ι_Fk.comp α_inf.symm.toRingHom)).comp
            (algebraMap (Polynomial F) (RatFunc F)))) ≫ j_aff := by
    let ψ_inf_pt : RatFunc F →+* Ω :=
      (algebraMap (FractionRing P) Ω).comp (ι_Fk.comp α_inf.symm.toRingHom)
    have hf_Ω_units : ∀ p : Polynomial F,
        Polynomial.eval 0 p ≠ 0 → IsUnit ((φ_R_Ω.comp f_inf_R) p) :=
      fun p hp0 => (hf_inf_units p hp0).map φ_R_Ω
    obtain ⟨_, _, huniq_Ω⟩ := hjV_univ (φ_R_Ω.comp f_inf_R) hf_Ω_units
    have h1 : (φ_R_Ω.comp φ_V_R).comp j_V = φ_R_Ω.comp f_inf_R := by
      rw [RingHom.comp_assoc, hφVR_jV]
    have h2 : (ψ_inf_pt.comp ι_inv).comp j_V = φ_R_Ω.comp f_inf_R := by
      apply Polynomial.ringHom_ext'
      · ext c
        change ψ_inf_pt ((ι_inv.comp (j_V.comp Polynomial.C)) c) =
          (φ_R_Ω.comp p_R) ((Polynomial.mapRingHom (algebraMap F k)) (Polynomial.C c))
        rw [hι_C]
        change algebraMap (FractionRing P) Ω (ι_Fk (α_inf.symm (algebraMap F (RatFunc F) c))) =
          (φ_R_Ω.comp p_R) ((Polynomial.mapRingHom (algebraMap F k)) (Polynomial.C c))
        rw [α_inf.symm.commutes c, hφ_pR, Polynomial.coe_mapRingHom, Polynomial.map_C]
        have hF := RingHom.congr_fun hι_Fk_F c
        simp only [RingHom.comp_apply] at hF
        rw [hF, IsScalarTower.algebraMap_apply P (FractionRing P) Ω]
      · simp only [RingHom.comp_apply, hι_X]
        dsimp only [ψ_inf_pt, f_inf_R]
        simp only [RingHom.comp_apply]
        have hsymm_X : α_inf.symm ((RatFunc.X : RatFunc F)⁻¹) = RatFunc.X := by
          rw [← hα_inf_X, α_inf.symm_apply_apply]
        change algebraMap (FractionRing P) Ω (ι_Fk (α_inf.symm ((RatFunc.X : RatFunc F)⁻¹))) =
          (φ_R_Ω.comp p_R) ((Polynomial.mapRingHom (algebraMap F k)) Polynomial.X)
        rw [hsymm_X, hι_Fk_X, ← IsScalarTower.algebraMap_apply P (FractionRing P) Ω,
          hφ_pR, Polynomial.coe_mapRingHom, Polynomial.map_X]
    have hΩ_eq : φ_R_Ω.comp φ_V_R = ψ_inf_pt.comp ι_inv :=
      (huniq_Ω _ h1).trans (huniq_Ω _ h2).symm
    dsimp only [g_inf]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hΩ_eq, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc, hginf_gen, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  obtain ⟨w_inf, ψ_inf, Q_inf_star, u_inf,
    hIff_inf, hu_inf_G, hu_inf_act, hTransv_inf, hTower_inf⟩ :=
    hSinglePoint s_inf hsinf_sec x_inf hx_inf hSm_away_inf hOdp_inf
      α_inf ((RatFunc.X : RatFunc F)⁻¹) hα_inf_X g_inf hg_inf_hom hg_inf_cl hg_inf_gen

  
  have hAffIdealTransport : ∀ (r : ℕ) (a : F)
      (Q_pt : Ideal ↥(integralClosure
        ↥(Algebra.adjoin F
          ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a)} :
            Set (D.L_V r))) (D.L_V r))),
      Q_pt.IsPrime →
      (let A_pt := Algebra.adjoin F
         ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a)} :
           Set (D.L_V r))
       let gen_pt : ↥A_pt :=
         ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a),
           Algebra.self_mem_adjoin_singleton F _⟩
       Ideal.comap (algebraMap ↥A_pt ↥(integralClosure ↥A_pt (D.L_V r))) Q_pt =
         Ideal.span {gen_pt}) →
      let A_pt := Algebra.adjoin F
        ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a)} :
          Set (D.L_V r))
      let C_pt := integralClosure ↥A_pt (D.L_V r)
      let C₀ := integralClosure (Polynomial F) (D.L_V r)
      ∃ Q_aff : Ideal ↥C₀,
        Q_aff.IsPrime ∧
        Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q_aff =
          Ideal.span {Polynomial.X - Polynomial.C a} ∧
        Subtype.val '' (Q_aff : Set ↥C₀) = Subtype.val '' (Q_pt : Set ↥C_pt) := by
    intro r a Q_pt hQp hQcomap A_pt C_pt C₀
    let L_r := D.L_V r
    have hPL_F : ∀ c : F, algebraMap (Polynomial F) L_r (Polynomial.C c) = algebraMap F L_r c := by
      intro c
      rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
      have h1 : algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) =
          algebraMap F (RatFunc F) c := rfl
      rw [h1, ← IsScalarTower.algebraMap_apply F (RatFunc F) L_r]
    have hgen_eq :
        algebraMap (RatFunc F) L_r (RatFunc.X - algebraMap F (RatFunc F) a) =
          algebraMap (Polynomial F) L_r (Polynomial.X - Polynomial.C a) := by
      rw [map_sub, map_sub, hPL_F a, ← IsScalarTower.algebraMap_apply F (RatFunc F) L_r a,
        IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r Polynomial.X,
        RatFunc.algebraMap_X]
    let gen_pt : ↥A_pt :=
      ⟨algebraMap (RatFunc F) L_r (RatFunc.X - algebraMap F (RatFunc F) a),
        Algebra.self_mem_adjoin_singleton F _⟩
    have hgen_coe : (gen_pt : L_r) = algebraMap (Polynomial F) L_r (Polynomial.X - Polynomial.C a) :=
      hgen_eq

    have hApt_in_P : ∀ u : L_r, u ∈ A_pt →
        ∃ p : Polynomial F, u = algebraMap (Polynomial F) L_r p := by
      intro u hu
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hu
      · intro x hx
        rw [Set.mem_singleton_iff] at hx
        exact ⟨Polynomial.X - Polynomial.C a, hx.trans hgen_eq⟩
      · intro c
        exact ⟨Polynomial.C c, (hPL_F c).symm⟩
      · rintro x y _ _ ⟨px, hpx⟩ ⟨py, hpy⟩
        exact ⟨px + py, by rw [map_add, hpx, hpy]⟩
      · rintro x y _ _ ⟨px, hpx⟩ ⟨py, hpy⟩
        exact ⟨px * py, by rw [map_mul, hpx, hpy]⟩

    let ψ_PA : Polynomial F →ₐ[F] ↥A_pt :=
      Polynomial.aeval (gen_pt + algebraMap F ↥A_pt a)
    have hψ_val : ∀ p : Polynomial F, (ψ_PA p : L_r) = algebraMap (Polynomial F) L_r p := by
      intro p
      refine Polynomial.induction_on' p ?_ ?_
      · intro p₁ p₂ h₁ h₂
        rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, Subalgebra.coe_mul,
          Subalgebra.coe_pow]
        have hC : (ψ_PA (Polynomial.C c) : L_r) = algebraMap (Polynomial F) L_r (Polynomial.C c) := by
          dsimp only [ψ_PA]; rw [Polynomial.aeval_C, hPL_F c]; rfl
        have hX : (ψ_PA Polynomial.X : L_r) = algebraMap (Polynomial F) L_r Polynomial.X := by
          dsimp only [ψ_PA]
          rw [Polynomial.aeval_X, Subalgebra.coe_add]
          change (gen_pt : L_r) + algebraMap F L_r a = _
          rw [hgen_coe, map_sub, hPL_F a, sub_add_cancel]
        rw [hC, hX, ← map_pow, ← map_mul]

    have hMem : ∀ z : L_r, z ∈ C_pt ↔ z ∈ C₀ := by
      intro z
      let alg_PA : Algebra (Polynomial F) ↥A_pt := (ψ_PA.toRingHom).toAlgebra
      let _ : Algebra (Polynomial F) ↥A_pt := alg_PA
      have hST_PA : IsScalarTower (Polynomial F) ↥A_pt L_r :=
        IsScalarTower.of_algebraMap_eq fun p => (hψ_val p).symm
      let _ : IsScalarTower (Polynomial F) ↥A_pt L_r := hST_PA
      constructor
      · intro hz
        have hInt_PA : Algebra.IsIntegral (Polynomial F) ↥A_pt := ⟨fun u => by
          obtain ⟨p, hp⟩ := hApt_in_P u.1 u.2
          refine ⟨Polynomial.X - Polynomial.C p, Polynomial.monic_X_sub_C p, ?_⟩
          apply Subtype.ext
          simp only [Subalgebra.coe_zero, Polynomial.eval₂_sub, Polynomial.eval₂_X,
            Polynomial.eval₂_C]
          change (u : L_r) - (ψ_PA p : L_r) = 0
          rw [hp, hψ_val p, sub_self]⟩
        let _ : Algebra.IsIntegral (Polynomial F) ↥A_pt := hInt_PA
        exact isIntegral_trans (R := Polynomial F) (A := ↥A_pt) z hz
      · intro hz
        exact IsIntegral.tower_top (R := Polynomial F) (A := ↥A_pt) hz

    let e_cl : ↥C_pt ≃+* ↥C₀ :=
      { toFun := fun x => ⟨x.1, (hMem x.1).mp x.2⟩
        invFun := fun y => ⟨y.1, (hMem y.1).mpr y.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl
        map_mul' := fun _ _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl }

    let Q_aff : Ideal ↥C₀ := Ideal.comap e_cl.symm.toRingHom Q_pt
    have hQaff_prime : Q_aff.IsPrime := Ideal.IsPrime.comap e_cl.symm.toRingHom
    refine ⟨Q_aff, hQaff_prime, ?_, ?_⟩
    · have hMax : (Ideal.span {Polynomial.X - Polynomial.C a} : Ideal (Polynomial F)).IsMaximal := by
        have hker : RingHom.ker (Polynomial.evalRingHom a) =
            Ideal.span {Polynomial.X - Polynomial.C a} := by
          ext p
          rw [RingHom.mem_ker, Polynomial.coe_evalRingHom, ← Polynomial.IsRoot.def,
            ← Polynomial.dvd_iff_isRoot, Ideal.mem_span_singleton]
        rw [← hker]
        exact RingHom.ker_isMaximal_of_surjective (Polynomial.evalRingHom a)
          fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
      have hle : Ideal.span {Polynomial.X - Polynomial.C a} ≤
          Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q_aff := by
        rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
        change e_cl.symm (algebraMap (Polynomial F) ↥C₀ (Polynomial.X - Polynomial.C a)) ∈ Q_pt
        have heq : e_cl.symm (algebraMap (Polynomial F) ↥C₀ (Polynomial.X - Polynomial.C a)) =
            algebraMap ↥A_pt ↥C_pt gen_pt := by
          apply Subtype.ext
          exact hgen_eq.symm
        rw [heq, ← Ideal.mem_comap, hQcomap]
        exact Ideal.subset_span rfl
      have hComap_prime : (Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q_aff).IsPrime :=
        hQaff_prime.comap (algebraMap (Polynomial F) ↥C₀)
      exact (hMax.eq_of_le (Ideal.IsPrime.ne_top hComap_prime) hle).symm
    · ext z
      simp only [Set.mem_image, SetLike.mem_coe]
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact ⟨e_cl.symm y, hy, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact ⟨e_cl x, by change e_cl.symm (e_cl x) ∈ Q_pt; rwa [e_cl.symm_apply_apply], rfl⟩

  have hAffPoint : ∀ a : F, a ∈ S_aff →
      ∃ (w_a : Fin D.N → K)
        (ψ_a : (Fin D.N → K) →ₗ[K] K)
        (Q_a : ∀ r : ℕ, Ideal ↥(integralClosure (Polynomial F) (D.L_V r)))
        (u_a : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
        (w_a ≠ 0 ↔ ψ_a ≠ 0) ∧
        u_a ∈ D.G_V ∧
        (∀ x : Fin D.N → K, ((u_a.val).map ι).mulVec x = x + (ψ_a x) • w_a) ∧
        (∀ r : ℕ,
          let C₀_r := integralClosure (Polynomial F) (D.L_V r)
          let C₀_succ := integralClosure (Polynomial F) (D.L_V (r + 1))
          (Q_a r).IsPrime ∧
          Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) (Q_a r) =
            Ideal.span {Polynomial.X - Polynomial.C a} ∧
          (∀ σ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
            (∃ σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r,
              (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
              (∀ y : ↥C₀_r,
                σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                  Subtype.val '' (Q_a r : Set ↥C₀_r))) ↔
            (∃ (τ_L : D.L_V (r + 1) ≃ₐ[RatFunc F] D.L_V (r + 1))
               (τ_B : D.B_V (r + 1) ≃ₐ[R₀] D.B_V (r + 1)),
              (∀ x : D.L_V (r + 1), IsIntegral F x → τ_L x = x) ∧
              (∀ b : D.B_V (r + 1), τ_L (algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) b) =
                algebraMap (D.B_V (r + 1)) (D.L_V (r + 1)) (τ_B b)) ∧
              (∀ y : ↥C₀_succ,
                τ_L (y : D.L_V (r + 1)) - (y : D.L_V (r + 1)) ∈
                  Subtype.val '' (Q_a (r + 1) : Set ↥C₀_succ)) ∧
              (∀ b : D.B_V r, τ_B (D.ι_BV r b) = D.ι_BV r (σ_B b)))) ∧
          (∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
            (∀ y : ↥C₀_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_a r : Set ↥C₀_r)) →
            ∃ u ∈ D.G_V,
              (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
              ∃ φ : (Fin D.N → K) →ₗ[K] K,
                ∀ x : Fin D.N → K,
                  ((u.val).map ι).mulVec x = x + (φ x) • w_a) ∧
          (∃ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C₀_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈
                Subtype.val '' (Q_a r : Set ↥C₀_r)) ∧
            (D.ρ_V r σ_B).val = (u_a.val).map (PadicInt.toZModPow (r + 1)))) := by
    intro a ha
    let s_a : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D₀.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff
    have hs_a_sec : s_a ≫ D₀.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
      dsimp only [s_a]
      rw [CategoryTheory.Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hid : (Polynomial.evalRingHom a).comp Polynomial.C = RingHom.id F := by
        ext c; simp
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    obtain ⟨x_a, hx_a, hSm_away_a, hOdp_a⟩ := hOdp_aff a ha
    obtain ⟨α_a, hα_a_X⟩ := hα_aff a

    let φ_a_R : Polynomial F →+* R_bar :=
      Polynomial.eval₂RingHom (p_R.comp (Polynomial.C.comp (algebraMap F k)))
        (t_bar + p_R (Polynomial.C (algebraMap F k a)))
    let g_a : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ D₀.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a_R) ≫ j_aff

    have hg_a_hom : g_a ≫ D₀.hom =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (p_R.comp (Polynomial.C.comp (algebraMap F k)))) := by
      dsimp only [g_a]
      rw [CategoryTheory.Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hcomp_C : φ_a_R.comp Polynomial.C = p_R.comp (Polynomial.C.comp (algebraMap F k)) := by
        ext c; simp [φ_a_R]
      rw [hcomp_C]

    have hg_a_cl : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_a =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)) ≫ s_a := by
      dsimp only [g_a, s_a]
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hπ_eq : π_cl.comp φ_a_R = (algebraMap F k).comp (Polynomial.evalRingHom a) := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, φ_a_R, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
            Polynomial.coe_evalRingHom, Polynomial.eval_C]
          have h := RingHom.congr_fun hπ_pR (Polynomial.C (algebraMap F k c))
          simpa using h
        · simp only [RingHom.comp_apply, φ_a_R, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
            Polynomial.coe_evalRingHom, Polynomial.eval_X, map_add]
          have ht0 : π_cl t_bar = 0 := by
            rw [← ht_eq]
            have h := RingHom.congr_fun hπ_pR Polynomial.X
            simpa using h
          have ha_k : π_cl (p_R (Polynomial.C (algebraMap F k a))) = algebraMap F k a := by
            have h := RingHom.congr_fun hπ_pR (Polynomial.C (algebraMap F k a))
            simpa using h
          rw [ht0, zero_add, ha_k]
      rw [hπ_eq]

    have hg_a_gen : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_a =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (((algebraMap (FractionRing P) Ω).comp (ι_Fk.comp α_a.symm.toRingHom)).comp
              (algebraMap (Polynomial F) (RatFunc F)))) ≫ j_aff := by
      dsimp only [g_a]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hsymm_X : α_a.symm RatFunc.X = RatFunc.X + algebraMap F (RatFunc F) a := by
        apply α_a.injective
        rw [α_a.apply_symm_apply, map_add, hα_a_X, α_a.commutes a, sub_add_cancel]
      have hΩ_eq : φ_R_Ω.comp φ_a_R =
          (((algebraMap (FractionRing P) Ω).comp (ι_Fk.comp α_a.symm.toRingHom)).comp
            (algebraMap (Polynomial F) (RatFunc F))) := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, φ_a_R, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          change φ_R_Ω (p_R (Polynomial.C (algebraMap F k c))) =
            algebraMap (FractionRing P) Ω (ι_Fk (α_a.symm (algebraMap F (RatFunc F) c)))
          rw [α_a.symm.commutes c]
          have hF := RingHom.congr_fun hι_Fk_F c
          simp only [RingHom.comp_apply] at hF
          have hR := RingHom.congr_fun hφ_pR (Polynomial.C (algebraMap F k c))
          simp only [RingHom.comp_apply] at hR
          rw [hF, ← IsScalarTower.algebraMap_apply P (FractionRing P) Ω, hR]
        · simp only [RingHom.comp_apply, φ_a_R, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
            map_add, RatFunc.algebraMap_X]
          change φ_R_Ω t_bar + φ_R_Ω (p_R (Polynomial.C (algebraMap F k a))) =
            algebraMap (FractionRing P) Ω (ι_Fk (α_a.symm RatFunc.X))
          have hF := RingHom.congr_fun hι_Fk_F a
          simp only [RingHom.comp_apply] at hF
          have hRX := RingHom.congr_fun hφ_pR Polynomial.X
          simp only [RingHom.comp_apply, ht_eq] at hRX
          have hRC := RingHom.congr_fun hφ_pR (Polynomial.C (algebraMap F k a))
          simp only [RingHom.comp_apply] at hRC
          rw [hsymm_X, map_add, map_add, hι_Fk_X, hF,
            ← IsScalarTower.algebraMap_apply P (FractionRing P) Ω,
            ← IsScalarTower.algebraMap_apply P (FractionRing P) Ω, hRX, hRC]
      rw [hΩ_eq]

    obtain ⟨w_a, ψ_a, Q_pt, u_a, hIff_a, hu_a_G, hu_a_act, _, hTower_a⟩ :=
      hSinglePoint s_a hs_a_sec x_a hx_a hSm_away_a hOdp_a
        α_a (RatFunc.X - algebraMap F (RatFunc F) a) hα_a_X g_a hg_a_hom hg_a_cl hg_a_gen

    choose Q_a hQ_a using fun r =>
      hAffIdealTransport r a (Q_pt r) (hTower_a r).1 (hTower_a r).2.1

    have hInertEquiv : ∀ (r : ℕ) (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r),
        let A_pt_r := Algebra.adjoin F
          ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a)} :
            Set (D.L_V r))
        let C_pt_r := integralClosure ↥A_pt_r (D.L_V r)
        let C₀_r := integralClosure (Polynomial F) (D.L_V r)
        (∀ y : ↥C₀_r, σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_a r : Set ↥C₀_r)) ↔
        (∀ y : ↥C_pt_r,
          σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_pt r : Set ↥C_pt_r)) := by
      intro r σ_L A_pt_r C_pt_r C₀_r
      have hImg := (hQ_a r).2.2
      have hMemC : ∀ z : D.L_V r, z ∈ C_pt_r ↔ z ∈ C₀_r := by
        intro z
        have hPL_F : ∀ c : F,
            algebraMap (Polynomial F) (D.L_V r) (Polynomial.C c) = algebraMap F (D.L_V r) c := by
          intro c
          rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (D.L_V r)]
          have h1 : algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c) =
              algebraMap F (RatFunc F) c := rfl
          rw [h1, ← IsScalarTower.algebraMap_apply F (RatFunc F) (D.L_V r)]
        have hgen_eq :
            algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a) =
              algebraMap (Polynomial F) (D.L_V r) (Polynomial.X - Polynomial.C a) := by
          rw [map_sub, map_sub, hPL_F a,
            ← IsScalarTower.algebraMap_apply F (RatFunc F) (D.L_V r) a,
            IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (D.L_V r) Polynomial.X,
            RatFunc.algebraMap_X]
        let gen_pt : ↥A_pt_r :=
          ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X - algebraMap F (RatFunc F) a),
            Algebra.self_mem_adjoin_singleton F _⟩
        let ψ_PA : Polynomial F →ₐ[F] ↥A_pt_r :=
          Polynomial.aeval (gen_pt + algebraMap F ↥A_pt_r a)
        have hψ_val : ∀ p : Polynomial F,
            (ψ_PA p : D.L_V r) = algebraMap (Polynomial F) (D.L_V r) p := by
          intro p
          refine Polynomial.induction_on' p ?_ ?_
          · intro p₁ p₂ h₁ h₂; rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]
          · intro n c
            rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, Subalgebra.coe_mul,
              Subalgebra.coe_pow]
            have hC : (ψ_PA (Polynomial.C c) : D.L_V r) =
                algebraMap (Polynomial F) (D.L_V r) (Polynomial.C c) := by
              dsimp only [ψ_PA]; rw [Polynomial.aeval_C, hPL_F c]; rfl
            have hX : (ψ_PA Polynomial.X : D.L_V r) =
                algebraMap (Polynomial F) (D.L_V r) Polynomial.X := by
              dsimp only [ψ_PA]
              rw [Polynomial.aeval_X, Subalgebra.coe_add]
              change gen_pt.1 + algebraMap F (D.L_V r) a = _
              rw [show gen_pt.1 = algebraMap (Polynomial F) (D.L_V r)
                    (Polynomial.X - Polynomial.C a) from hgen_eq,
                map_sub, hPL_F a, sub_add_cancel]
            rw [hC, hX, ← map_pow, ← map_mul]
        let alg_PA : Algebra (Polynomial F) ↥A_pt_r := (ψ_PA.toRingHom).toAlgebra
        let _ : Algebra (Polynomial F) ↥A_pt_r := alg_PA
        have hST_PA : IsScalarTower (Polynomial F) ↥A_pt_r (D.L_V r) :=
          IsScalarTower.of_algebraMap_eq fun p => (hψ_val p).symm
        let _ : IsScalarTower (Polynomial F) ↥A_pt_r (D.L_V r) := hST_PA
        constructor
        · intro hz
          have hInt_PA : Algebra.IsIntegral (Polynomial F) ↥A_pt_r := ⟨fun u => by
            have hu_ex : ∃ p : Polynomial F, u.1 = algebraMap (Polynomial F) (D.L_V r) p := by
              refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ u.2
              · intro x hx
                rw [Set.mem_singleton_iff] at hx
                exact ⟨Polynomial.X - Polynomial.C a, hx.trans hgen_eq⟩
              · intro c; exact ⟨Polynomial.C c, (hPL_F c).symm⟩
              · rintro x y _ _ ⟨px, hpx⟩ ⟨py, hpy⟩; exact ⟨px + py, by rw [map_add, hpx, hpy]⟩
              · rintro x y _ _ ⟨px, hpx⟩ ⟨py, hpy⟩; exact ⟨px * py, by rw [map_mul, hpx, hpy]⟩
            obtain ⟨p, hp⟩ := hu_ex
            refine ⟨Polynomial.X - Polynomial.C p, Polynomial.monic_X_sub_C p, ?_⟩
            apply Subtype.ext
            simp only [Subalgebra.coe_zero, Polynomial.eval₂_sub, Polynomial.eval₂_X,
              Polynomial.eval₂_C]
            change u.1 - (ψ_PA p : D.L_V r) = 0
            rw [hp, hψ_val p, sub_self]⟩
          let _ : Algebra.IsIntegral (Polynomial F) ↥A_pt_r := hInt_PA
          exact isIntegral_trans (R := Polynomial F) (A := ↥A_pt_r) z hz
        · intro hz
          exact IsIntegral.tower_top (R := Polynomial F) (A := ↥A_pt_r) hz
      rw [hImg]
      constructor
      · intro h y; exact h ⟨y.1, (hMemC y.1).mp y.2⟩
      · intro h y; exact h ⟨y.1, (hMemC y.1).mpr y.2⟩

    refine ⟨w_a, ψ_a, Q_a, u_a, hIff_a, hu_a_G, hu_a_act, fun r => ?_⟩
    obtain ⟨_, _, hTrans_r, hLift_r, hu_wit_r⟩ := hTower_a r
    refine ⟨(hQ_a r).1, (hQ_a r).2.1, ?_, ?_, ?_⟩
    · intro σ_B
      constructor
      · rintro ⟨σ_L, hInt, hCompat, hInert⟩
        obtain ⟨τ_L, τ_B, hInt', hCompat', hInert', hExt⟩ :=
          (hTrans_r σ_B).mp ⟨σ_L, hInt, hCompat, (hInertEquiv r σ_L).mp hInert⟩
        exact ⟨τ_L, τ_B, hInt', hCompat', (hInertEquiv (r + 1) τ_L).mpr hInert', hExt⟩
      · rintro ⟨τ_L, τ_B, hInt', hCompat', hInert', hExt⟩
        obtain ⟨σ_L, hInt, hCompat, hInert⟩ :=
          (hTrans_r σ_B).mpr ⟨τ_L, τ_B, hInt', hCompat', (hInertEquiv (r + 1) τ_L).mp hInert', hExt⟩
        exact ⟨σ_L, hInt, hCompat, (hInertEquiv r σ_L).mpr hInert⟩
    · intro σ_L σ_B hInt hCompat hInert
      exact hLift_r σ_L σ_B hInt hCompat ((hInertEquiv r σ_L).mp hInert)
    · obtain ⟨σ_L, σ_B, hInt, hCompat, hInert, hMod⟩ := hu_wit_r
      exact ⟨σ_L, σ_B, hInt, hCompat, (hInertEquiv r σ_L).mpr hInert, hMod⟩

  
  let w_aff : F → (Fin D.N → K) :=
    fun a => if ha : a ∈ S_aff then Classical.choose (hAffPoint a ha) else 0
  let ψ_aff : F → ((Fin D.N → K) →ₗ[K] K) :=
    fun a => if ha : a ∈ S_aff then
