theorem weil_odp_slice_chart_baseChange_and_closed_point_roof (F : Type u) [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (P : WeilRationalLefschetzPencil F m Z₁)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k]
    (π_P2 : (weilProjectiveSpaceOver k 2).left ⟶ (weilProjectiveSpaceOver F 2).left)
    (hπ_P2 : IsFieldPullbackModel F k (weilProjectiveSpaceOver F 2) (weilProjectiveSpaceOver k 2) π_P2)
    (j_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
      (weilProjectiveSpaceOver k 2).left)
    [AlgebraicGeometry.IsOpenImmersion j_0]
    (hj_0_hom : j_0 ≫ (weilProjectiveSpaceOver k 2).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (h₀ f₀ : MvPolynomial (Fin 2) k)
    (hPb_Sigma_0 : ∃ f_Sigma_0 : AlgebraicGeometry.Spec
        (CommRingCat.of (MvPolynomial (Fin 2) k ⧸ Ideal.span {h₀})) ⟶
        (weilProjectiveSpaceOver F 1).left,
      CategoryTheory.IsPullback f_Sigma_0
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {h₀}))))
        P.ι_line.left (j_0 ≫ π_P2))
    (hj_0_disc : j_0.base ⁻¹' (π_P2.base ⁻¹' (Set.range ι_disc.left.base)) =
      { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) | f₀ ∈ p.asIdeal }) :
    (∀ (R' : CommRingCat.{u})
        (e_B : AlgebraicGeometry.Spec R' ⟶ (weilProjectiveSpaceOver F 2).left)
        (h : R')
        (ψ_BF : MvPolynomial (Fin 2) F →+* R')
        (u_pt : AlgebraicGeometry.Spec R')
        (q_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k))),
      AlgebraicGeometry.Etale e_B →
      ψ_BF (MvPolynomial.X 0) = h →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BF)) →
      e_B ≫ (weilProjectiveSpaceOver F 2).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BF) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) →
      e_B.base ⁻¹' (Set.range ι_disc.left.base) =
        { u : AlgebraicGeometry.Spec R' | h ∈ u.asIdeal } →
      e_B.base u_pt = (j_0 ≫ π_P2).base q_0 →
      ∃ (R : CommRingCat.{u})
