        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
      let δ_U : one_U ⟶ R_sh.obj L_mod :=
        (adj_U.homEquiv R_mod (R_sh.obj L_mod)).symm
          (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_mod) ≫
            L_mod.obj.map τ_hom.op)
