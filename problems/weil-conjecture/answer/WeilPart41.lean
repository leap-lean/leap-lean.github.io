          map_mul' := fun x y => by simp
          map_zero' := by simp
          map_add' := fun x y => by simp }
      let s_pre :
          MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω →+*
            ((MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)) ⧸ J_u) :=
        MvPolynomial.eval₂Hom c_Ju
          (Sum.elim
            (fun _ => mk_u (Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inl 0))))
            (fun jb =>
              mk_u (Ideal.Quotient.mk (I_k (n + 1))
                (MvPolynomial.X (Sum.inr (jb.1.castSucc, jb.2))))))
      have hs_ker : I_k n ≤ RingHom.ker s_pre := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        have hgen_succ : Ideal.Quotient.mk (I_k (n + 1))
            (((1 - MvPolynomial.C c_0 *
              (MvPolynomial.X (Sum.inl 0) :
                MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)) *
                MvPolynomial.X (Sum.inl 0) +
              ∑ j : Fin (n + 1),
                (MvPolynomial.X (Sum.inr (j, 0)) :
                  MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω) *
