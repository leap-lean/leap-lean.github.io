    have hev_Xμ : ev_μ (MvPolynomial.X μ) = 1 := by
      dsimp [ev_μ]
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
    have hev_succ : ∀ i : Fin (2 * m + 3),
        ev_μ (MvPolynomial.X (μ.succAbove i)) = MvPolynomial.X i := by
      intro i
      dsimp [ev_μ]
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
