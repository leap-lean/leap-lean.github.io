      have h_comp_res : (Φ ∣_ W a) ≫ (p₁ ∣_ U₀ a) = e_V.hom ≫ (π ∣_ U₀ a) := by
        rw [← CategoryTheory.cancel_mono (U₀ a).ι, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc (Φ ∣_ W a), AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, hΦ_p₁,
          AlgebraicGeometry.morphismRestrict_ι π (U₀ a),
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
      have hPB_V : CategoryTheory.IsPullback
          ((Φ ∣_ W a) ≫ (p₁ ∣_ U₀ a))
          ((Φ ⁻¹ᵁ W a).ι ≫ p₁_hom)
          ((U₀ a).ι ≫ p₀_hom)
          s := by
        refine CategoryTheory.IsPullback.of_iso (hChartPB a)
          e_V.symm (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ?_ ?_ ?_ ?_
        · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            h_comp_res, CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.inv_hom_id_assoc]
        · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.eq_inv_comp,
            ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
        · simp
        · simp
      have hPB_W : CategoryTheory.IsPullback
          (p₁ ∣_ U₀ a)
          ((W a).ι ≫ p₂)
          ((U₀ a).ι ≫ p₀_hom)
          s :=
        CategoryTheory.IsPullback.paste_vert
          (AlgebraicGeometry.isPullback_morphismRestrict p₁ (U₀ a))
          (CategoryTheory.IsPullback.of_hasPullback p₀_hom s)
      let e_cone := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_V hPB_W
      have hΦ_eq : Φ ∣_ W a = e_cone.hom := by
        apply hPB_W.hom_ext
        · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_V hPB_W).symm
        · rw [CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_V hPB_W,
            ← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            CategoryTheory.Category.assoc]
          congr 1
          exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [hΦ_eq]
      infer_instance
    have : CategoryTheory.IsIso Φ := hIsoΦ
    exact CategoryTheory.IsPullback.of_iso_pullback ⟨hComm⟩ (CategoryTheory.asIso Φ)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)

  have hAwayBridge : ∀ {N₀ N₁ : ℕ} {R₀ R₁ : Type u} [CommRing R₀] [CommRing R₁],
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) R₀
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) R₁
      letI : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
      ∀ (f : 𝒜₀ →+*ᵍ 𝒜₁)
        (hf : HomogeneousIdeal.irrelevant 𝒜₁ ≤
          HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜₀))
        (x₀ : MvPolynomial (Fin (N₀ + 1)) R₀) (hx₀ : x₀ ∈ 𝒜₀ 1)
        (y₀ : MvPolynomial (Fin (N₁ + 1)) R₁),
        y₀ = f x₀ →
        ∀ (hy₀ : y₀ ∈ 𝒜₁ 1),
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.map f hf).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜₀ x₀) =
            AlgebraicGeometry.Proj.basicOpen 𝒜₁ y₀ ∧
          ∃ φ : HomogeneousLocalization.Away 𝒜₀ x₀ →+*
              HomogeneousLocalization.Away 𝒜₁ y₀,
            AlgebraicGeometry.Proj.awayι 𝒜₁ y₀ hy₀ zero_lt_one ≫
              AlgebraicGeometry.Proj.map f hf =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
                AlgebraicGeometry.Proj.awayι 𝒜₀ x₀ hx₀ zero_lt_one ∧
            ∀ (n : ℕ) (x : MvPolynomial (Fin (N₀ + 1)) R₀)
              (hx : x ∈ 𝒜₀ (n • 1)) (hfx : f x ∈ 𝒜₁ (n • 1)),
              φ (HomogeneousLocalization.Away.mk 𝒜₀ hx₀ n x hx) =
                HomogeneousLocalization.Away.mk 𝒜₁ hy₀ n (f x) hfx := by
    intro N₀ N₁ R₀ R₁ _ _ 𝒜₀ 𝒜₁ f hf x₀ hx₀ y₀ hy_eq
    let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
    subst hy_eq
    intro hy₀
    refine ⟨AlgebraicGeometry.Proj.map_preimage_basicOpen f hf x₀,
      HomogeneousLocalization.Away.map f x₀,
      AlgebraicGeometry.Proj.awayι_comp_map f hf zero_lt_one x₀ hx₀,
      fun n x hx _ => HomogeneousLocalization.Away.map_mk f x₀ hx₀ n x hx⟩

  let sliceVec : ∀ {B : Type u} [CommRing B] (t : B),
      Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) B :=
    fun {B} _ t =>
      Fin.cases (-MvPolynomial.C t * MvPolynomial.X 0)
        (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))

  have hSliceVecHom : ∀ {B : Type u} [CommRing B] (t : B) (μ : Fin (M + 1 + 1)),
      (sliceVec t μ).IsHomogeneous 1 := by
    intro B _ t μ
    refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun a => ?_) j) μ
    · dsimp only [sliceVec, Fin.cases_zero]
      rw [← map_neg]
      exact (MvPolynomial.isHomogeneous_X B 0).C_mul (-t)
    · dsimp only [sliceVec, Fin.cases_succ, Fin.cases_zero]
      exact MvPolynomial.isHomogeneous_X B 0
    · dsimp only [sliceVec, Fin.cases_succ]
      exact MvPolynomial.isHomogeneous_X B a.succ

  let sliceGraded : ∀ {A B : Type u} [CommRing A] [CommRing B] (c : A →+* B) (t : B),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B) :=
        MvPolynomial.gradedAlgebra
      MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B :=
    fun {A B} _ _ c t =>
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B) :=
        MvPolynomial.gradedAlgebra
      { toRingHom := MvPolynomial.eval₂Hom (MvPolynomial.C.comp c) (sliceVec t)
        map_mem := fun {i p} hp => by
          rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
          change (MvPolynomial.eval₂ (MvPolynomial.C.comp c) (sliceVec t) p).IsHomogeneous i
          have h1 := MvPolynomial.IsHomogeneous.eval₂ hp (MvPolynomial.C.comp c) (sliceVec t)
            (fun r => MvPolynomial.isHomogeneous_C _ (c r))
            (hSliceVecHom t)
          rwa [one_mul] at h1 }

  have h_irrel_slice : ∀ {A B : Type u} [CommRing A] [CommRing B] (c : A →+* B) (t : B),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B) :=
        MvPolynomial.gradedAlgebra
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B) ≤
        HomogeneousIdeal.map (sliceGraded c t)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A)) := by
    intro A B _ _ c t
    let 𝒜_A := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A
    let ℬ_B := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B
    let _ : GradedAlgebra 𝒜_A := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra ℬ_B := MvPolynomial.gradedAlgebra
    change (HomogeneousIdeal.irrelevant ℬ_B).toIdeal ≤
      (HomogeneousIdeal.map (sliceGraded c t) (HomogeneousIdeal.irrelevant 𝒜_A)).toIdeal
    rw [HomogeneousIdeal.toIdeal_map]
    refine (hIrrel B M).trans (Ideal.span_le.mpr ?_)
    rintro _ ⟨ν, rfl⟩
    refine Fin.cases ?_ (fun a => ?_) ν
    · have h1 : (sliceGraded c t).toRingHom (MvPolynomial.X 1) = MvPolynomial.X 0 := by
        change MvPolynomial.eval₂Hom (MvPolynomial.C.comp c) (sliceVec t)
          (MvPolynomial.X (0 : Fin (M + 1)).succ) = MvPolynomial.X 0
        rw [MvPolynomial.eval₂Hom_X']
        dsimp only [sliceVec, Fin.cases_succ, Fin.cases_zero]
      rw [← h1]
      exact Ideal.mem_map_of_mem _ (hX_mem_irrel A (M + 1) 1)
    · have ha : (sliceGraded c t).toRingHom (MvPolynomial.X a.succ.succ) = MvPolynomial.X a.succ := by
        change MvPolynomial.eval₂Hom (MvPolynomial.C.comp c) (sliceVec t)
          (MvPolynomial.X a.succ.succ) = MvPolynomial.X a.succ
        rw [MvPolynomial.eval₂Hom_X']
        dsimp only [sliceVec, Fin.cases_succ]
      rw [← ha]
      exact Ideal.mem_map_of_mem _ (hX_mem_irrel A (M + 1) a.succ.succ)

  have hSliceCompMap : ∀ {A B B' : Type u} [CommRing A] [CommRing B] [CommRing B']
      (c : A →+* B) (t : B) (γ : B →+* B'),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B') :=
        MvPolynomial.gradedAlgebra
      (mapGraded γ M).comp (sliceGraded c t) = sliceGraded (γ.comp c) (γ t) := by
    intro A B B' _ _ _ c t γ
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) A) :=
      MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B) :=
      MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B') :=
      MvPolynomial.gradedAlgebra
    apply GradedRingHom.ext
    intro p
    change ((MvPolynomial.map γ).comp
      (MvPolynomial.eval₂Hom (MvPolynomial.C.comp c) (sliceVec t))) p =
      (MvPolynomial.eval₂Hom (MvPolynomial.C.comp (γ.comp c)) (sliceVec (γ t))) p
    refine RingHom.congr_fun ?_ p
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro r
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, MvPolynomial.map_C]
    · intro μ
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun a => ?_) j) μ
      · dsimp only [sliceVec, Fin.cases_zero]
        rw [map_mul, map_neg, MvPolynomial.map_C, MvPolynomial.map_X]
      · dsimp only [sliceVec, Fin.cases_succ, Fin.cases_zero]
        exact MvPolynomial.map_X γ 0
      · dsimp only [sliceVec, Fin.cases_succ]
        exact MvPolynomial.map_X γ a.succ

  let ψ_fam_grad := sliceGraded (Polynomial.C : k →+* Polynomial k) Polynomial.X
  let h_irrel_fam := h_irrel_slice (Polynomial.C : k →+* Polynomial k) Polynomial.X
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) (Polynomial k)) :=
    MvPolynomial.gradedAlgebra
  let Ψ_fam : (weilProjectiveSpaceOver (Polynomial k) M).left ⟶
      (weilProjectiveSpaceOver k (M + 1)).left :=
    AlgebraicGeometry.Proj.map ψ_fam_grad h_irrel_fam

  refine ⟨hProjProper, Ψ_fam, ?_, ?_, ?_⟩
  · exact hProjOverHom k (Polynomial k) Polynomial.C (M + 1) M ψ_fam_grad h_irrel_fam
      (fun c => MvPolynomial.eval₂Hom_C _ _ c)
  · intro R _ γ c_R t_R ℬ_R v_R ψ_R
    let _ : GradedAlgebra ℬ_R := MvPolynomial.gradedAlgebra
    let π_PR : (weilProjectiveSpaceOver R M).left ⟶
        (weilProjectiveSpaceOver (Polynomial k) M).left :=
      AlgebraicGeometry.Proj.map (mapGraded γ M) (h_irrel_map γ M)
    let ψ_R_grad : 𝒜_k →+*ᵍ ℬ_R := sliceGraded c_R t_R
    let h_irrel_ψR := h_irrel_slice c_R t_R
    have hcomp_R : π_PR ≫ Ψ_fam = AlgebraicGeometry.Proj.map ψ_R_grad h_irrel_ψR := by
      change AlgebraicGeometry.Proj.map (mapGraded γ M) (h_irrel_map γ M) ≫
          AlgebraicGeometry.Proj.map ψ_fam_grad h_irrel_fam =
        AlgebraicGeometry.Proj.map ψ_R_grad h_irrel_ψR
      rw [← AlgebraicGeometry.Proj.map_comp ψ_fam_grad (mapGraded γ M) h_irrel_fam (h_irrel_map γ M)]
      exact hProjMapCongr (hSliceCompMap Polynomial.C Polynomial.X γ) _ h_irrel_ψR
    have hX1_k : (MvPolynomial.X 1 : MvPolynomial (Fin (M + 1 + 1)) k) ∈ 𝒜_k 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k 1)
    have hY0_R : (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) R) ∈ ℬ_R 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 0)
    have hy0_eq : (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) R) = ψ_R_grad (MvPolynomial.X 1) := by
      change MvPolynomial.X 0 =
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp c_R) (sliceVec t_R)
          (MvPolynomial.X (0 : Fin (M + 1)).succ)
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    obtain ⟨hOpen0, φ₀, hAway0, hMk0⟩ :=
      hAwayBridge ψ_R_grad h_irrel_ψR (MvPolynomial.X 1) hX1_k (MvPolynomial.X 0) hy0_eq hY0_R
    refine ⟨π_PR, hBasePB γ M, ?_, ?_, ?_, ?_⟩
    · rw [hcomp_R]
      exact hOpen0
    · intro a
      have hXa_k : (MvPolynomial.X a.succ.succ : MvPolynomial (Fin (M + 1 + 1)) k) ∈ 𝒜_k 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a.succ.succ)
      have hYa_R : (MvPolynomial.X a.succ : MvPolynomial (Fin (M + 1)) R) ∈ ℬ_R 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R a.succ)
      have hya_eq : (MvPolynomial.X a.succ : MvPolynomial (Fin (M + 1)) R) =
          ψ_R_grad (MvPolynomial.X a.succ.succ) := by
        change MvPolynomial.X a.succ =
          MvPolynomial.eval₂Hom (MvPolynomial.C.comp c_R) (sliceVec t_R)
            (MvPolynomial.X a.succ.succ)
        rw [MvPolynomial.eval₂Hom_X']
        rfl
      rw [hcomp_R]
      exact (hAwayBridge ψ_R_grad h_irrel_ψR
        (MvPolynomial.X a.succ.succ) hXa_k (MvPolynomial.X a.succ) hya_eq hYa_R).1
    · refine ⟨φ₀, (congrArg (AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X 0) hY0_R zero_lt_one ≫ ·)
        hcomp_R).trans hAway0, hMk0⟩
    · intro a
      have hXa_k : (MvPolynomial.X a.succ.succ : MvPolynomial (Fin (M + 1 + 1)) k) ∈ 𝒜_k 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a.succ.succ)
      have hYa_R : (MvPolynomial.X a.succ : MvPolynomial (Fin (M + 1)) R) ∈ ℬ_R 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R a.succ)
      have hya_eq : (MvPolynomial.X a.succ : MvPolynomial (Fin (M + 1)) R) =
          ψ_R_grad (MvPolynomial.X a.succ.succ) := by
        change MvPolynomial.X a.succ =
          MvPolynomial.eval₂Hom (MvPolynomial.C.comp c_R) (sliceVec t_R)
            (MvPolynomial.X a.succ.succ)
        rw [MvPolynomial.eval₂Hom_X']
        rfl
      obtain ⟨_, φ_a, hAway_a, hMk_a⟩ :=
        hAwayBridge ψ_R_grad h_irrel_ψR
          (MvPolynomial.X a.succ.succ) hXa_k (MvPolynomial.X a.succ) hya_eq hYa_R
      exact ⟨φ_a, (congrArg (AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X a.succ) hYa_R zero_lt_one ≫ ·)
        hcomp_R).trans hAway_a, hMk_a⟩
  · intro K _ γ_K c_K t_K 𝒜_K ℬ_K v_K ψ_K
    let _ : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra ℬ_K := MvPolynomial.gradedAlgebra
    let π_PK : (weilProjectiveSpaceOver K M).left ⟶
        (weilProjectiveSpaceOver (Polynomial k) M).left :=
      AlgebraicGeometry.Proj.map (mapGraded γ_K M) (h_irrel_map γ_K M)
    let π_amb : (weilProjectiveSpaceOver K (M + 1)).left ⟶
        (weilProjectiveSpaceOver k (M + 1)).left :=
      AlgebraicGeometry.Proj.map (mapGraded c_K (M + 1)) (h_irrel_map c_K (M + 1))
    let ψ_K_grad : 𝒜_K →+*ᵍ ℬ_K :=
      { toRingHom := ψ_K
        map_mem := fun {i p} hp => by
          rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
          change (MvPolynomial.eval₂ MvPolynomial.C (sliceVec t_K) p).IsHomogeneous i
          have h1 := MvPolynomial.IsHomogeneous.eval₂ hp MvPolynomial.C (sliceVec t_K)
            (fun r => MvPolynomial.isHomogeneous_C _ r)
            (hSliceVecHom t_K)
          rwa [one_mul] at h1 }
    have hψ_K_eq : ψ_K_grad = sliceGraded (RingHom.id K) t_K := by
      apply GradedRingHom.ext
      intro p
      change ψ_K p = MvPolynomial.eval₂Hom (MvPolynomial.C.comp (RingHom.id K)) (sliceVec t_K) p
      rw [RingHom.comp_id]
    have h_irrel_ψK : HomogeneousIdeal.irrelevant ℬ_K ≤
        HomogeneousIdeal.map ψ_K_grad (HomogeneousIdeal.irrelevant 𝒜_K) := by
      rw [hψ_K_eq]
      exact h_irrel_slice (RingHom.id K) t_K
    let Λ_K : (weilProjectiveSpaceOver K M).left ⟶ (weilProjectiveSpaceOver K (M + 1)).left :=
      AlgebraicGeometry.Proj.map ψ_K_grad h_irrel_ψK
    have hfac_grad :
        (mapGraded γ_K M).comp ψ_fam_grad = ψ_K_grad.comp (mapGraded c_K (M + 1)) := by
      rw [hSliceCompMap Polynomial.C Polynomial.X γ_K]
      apply GradedRingHom.ext
      intro p
      symm
      exact MvPolynomial.eval₂Hom_map_hom c_K v_K MvPolynomial.C p
    have hfac_K : π_PK ≫ Ψ_fam = Λ_K ≫ π_amb := by
      change AlgebraicGeometry.Proj.map (mapGraded γ_K M) (h_irrel_map γ_K M) ≫
          AlgebraicGeometry.Proj.map ψ_fam_grad h_irrel_fam =
        AlgebraicGeometry.Proj.map ψ_K_grad h_irrel_ψK ≫
          AlgebraicGeometry.Proj.map (mapGraded c_K (M + 1)) (h_irrel_map c_K (M + 1))
      rw [← AlgebraicGeometry.Proj.map_comp ψ_fam_grad (mapGraded γ_K M)
            h_irrel_fam (h_irrel_map γ_K M),
          ← AlgebraicGeometry.Proj.map_comp (mapGraded c_K (M + 1)) ψ_K_grad
            (h_irrel_map c_K (M + 1)) h_irrel_ψK]
      exact hProjMapCongr hfac_grad _ _
    have hΛ_K_hom :
        Λ_K ≫ (weilProjectiveSpaceOver K (M + 1)).hom = (weilProjectiveSpaceOver K M).hom := by
      have h1 := hProjOverHom K K (RingHom.id K) (M + 1) M ψ_K_grad h_irrel_ψK
        (fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C v_K c)
      rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
        CategoryTheory.Category.comp_id] at h1
      exact h1
    refine ⟨π_PK, π_amb, Λ_K, hBasePB γ_K M, hBasePB c_K (M + 1), hfac_K, hΛ_K_hom,
      ?_, ?_, ?_, ?_, ?_⟩
    · intro μ
      have hXμ_k : (MvPolynomial.X μ : MvPolynomial (Fin (M + 1 + 1)) k) ∈ 𝒜_k 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k μ)
      have hXμ_K : (MvPolynomial.X μ : MvPolynomial (Fin (M + 1 + 1)) K) ∈ 𝒜_K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ)
      exact hAwayBridge (mapGraded c_K (M + 1)) (h_irrel_map c_K (M + 1))
        (MvPolynomial.X μ) hXμ_k (MvPolynomial.X μ) (MvPolynomial.map_X c_K μ).symm hXμ_K
    · intro ht0
      have h0 : ψ_K_grad (MvPolynomial.X 0) = 0 := by
        change MvPolynomial.eval₂Hom MvPolynomial.C v_K (MvPolynomial.X 0) = 0
        rw [MvPolynomial.eval₂Hom_X']
        dsimp only [v_K, Fin.cases_zero]
        rw [ht0, map_zero, neg_zero, zero_mul]
      dsimp only [weilProjBasicOpen]
      exact (AlgebraicGeometry.Proj.map_preimage_basicOpen ψ_K_grad h_irrel_ψK
        (MvPolynomial.X 0)).trans
        ((congrArg (AlgebraicGeometry.Proj.basicOpen ℬ_K) h0).trans
          (AlgebraicGeometry.Proj.basicOpen_zero ℬ_K))
    · intro _ht f₀
      have hf₀ : f₀ ∈ ℬ_K 1 := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        dsimp only [f₀]
        rw [← map_neg]
        exact (MvPolynomial.isHomogeneous_X K 0).C_mul (-t_K)
      have hX0_K : (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1 + 1)) K) ∈ 𝒜_K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0)
      have hf₀_eq : f₀ = ψ_K_grad (MvPolynomial.X 0) := by
        change f₀ = MvPolynomial.eval₂Hom MvPolynomial.C v_K (MvPolynomial.X 0)
        rw [MvPolynomial.eval₂Hom_X']
        rfl
      obtain ⟨hOpen_f₀, χ₀, hAway_f₀, hMk_f₀⟩ :=
        hAwayBridge ψ_K_grad h_irrel_ψK (MvPolynomial.X 0) hX0_K f₀ hf₀_eq hf₀
