    let f_x : T_K ⟶ U_K := CategoryTheory.MorphismProperty.Over.homMk σ_x hσ_hom
    refine ⟨f_x, hσ_et, ?_⟩
    have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base (⊥ : PrimeSpectrum K) =
