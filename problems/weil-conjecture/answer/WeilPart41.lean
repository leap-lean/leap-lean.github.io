        · intro b
          apply HomogeneousLocalization.val_injective
          change (e₁ (MvPolynomial.map ρ (MvPolynomial.X b))).val =
            (HomogeneousLocalization.Away.map g (MvPolynomial.X a) (e₀ (MvPolynomial.X b))).val
          rw [MvPolynomial.map_X, he₁_X b]
          symm
          have he₀_mk : e₀ (MvPolynomial.X b) = HomogeneousLocalization.mk
