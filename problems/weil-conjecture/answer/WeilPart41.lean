        exact (congrArg (fun f => f.hom x) s.condition).symm
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        rfl
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        exact congrArg CommRingCat.Hom.hom hm_inr
    let q_φS0 : AlgebraicGeometry.Spec S_0 ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k ⧸ Ideal.span {h₀})) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_S0)
    have hq_φS0_et : AlgebraicGeometry.Etale q_φS0 := by
      have hPb_S0 := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_S0
      have hSpec_φloc_et :
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_loc_et
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_S0.flip hSpec_φloc_et

    
    let β_R' : R' →+* R_loc := (algebraMap R R_loc).comp α_R'.hom
    have hβ_h : β_R' h = h_loc := by
      dsimp [β_R', h_loc]
      rw [hψ_X0]
    let Q_loc : MvPolynomial (Fin (m + 1) × Fin 2) R_loc :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h_loc
    have hmap_β_Q : MvPolynomial.map β_R' Q_R' = Q_loc := by
      dsimp [Q_R', Q_loc]
      simp only [map_sub, map_sum, map_mul, MvPolynomial.map_X, MvPolynomial.map_C, hβ_h]
    have hπ_M_ker :
        I_R' ≤ RingHom.ker ((Ideal.Quotient.mk I_odp).comp (MvPolynomial.map β_R')) := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply, hmap_β_Q]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    let π_M : M_R' ⟶ M_odp :=
      CommRingCat.ofHom
        (Ideal.Quotient.lift I_R' ((Ideal.Quotient.mk I_odp).comp (MvPolynomial.map β_R')) hπ_M_ker)
    have hc_S0_ker :
        Ideal.span {g₀} ≤ RingHom.ker ((Ideal.Quotient.mk I_odp).comp MvPolynomial.C) := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
    let c_S0 : S_0 ⟶ M_odp :=
      CommRingCat.ofHom
        (Ideal.Quotient.lift (Ideal.span {g₀})
          ((Ideal.Quotient.mk I_odp).comp MvPolynomial.C) hc_S0_ker)
    have hε_M_ker :
        I_odp ≤ RingHom.ker (MvPolynomial.eval₂Hom ε_loc (fun _ : Fin (m + 1) × Fin 2 => (0 : k))) := by
      rw [Ideal.span_le]
      rintro x (rfl | hx)
      · rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.eval₂Hom_C]
        exact hε_loc_g0
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_sum]
        simp only [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, mul_zero,
          Finset.sum_const_zero, hε_loc_hloc, sub_zero]
    let ε_M : M_odp ⟶ CommRingCat.of k :=
      CommRingCat.ofHom
        (Ideal.Quotient.lift I_odp
          (MvPolynomial.eval₂Hom ε_loc (fun _ : Fin (m + 1) × Fin 2 => (0 : k))) hε_M_ker)

    have hComm_M :
        CommRingCat.ofHom ((Ideal.Quotient.mk I_R').comp MvPolynomial.C) ≫ π_M =
          CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span {g₀})).comp β_R') ≫ c_S0 := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r'
      change Ideal.Quotient.mk I_odp (MvPolynomial.map β_R' (MvPolynomial.C r')) =
        Ideal.Quotient.mk I_odp (MvPolynomial.C (β_R' r'))
      rw [MvPolynomial.map_C]
    have hPush_M :
        CategoryTheory.IsPushout
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_R').comp MvPolynomial.C))
          (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span {g₀})).comp β_R'))
          π_M c_S0 := by
      refine CategoryTheory.IsPushout.mk ⟨hComm_M⟩ ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk
        hComm_M
        (fun s =>
          let v₀ : R_loc →+* s.pt := s.inr.hom.comp (Ideal.Quotient.mk (Ideal.span {g₀}))
          let x_vec : Fin (m + 1) × Fin 2 → s.pt :=
            fun idx => s.inl.hom (Ideal.Quotient.mk I_R' (MvPolynomial.X idx))
          CommRingCat.ofHom (Ideal.Quotient.lift I_odp (MvPolynomial.eval₂Hom v₀ x_vec) (by
            change I_odp ≤ RingHom.ker (MvPolynomial.eval₂Hom v₀ x_vec)
            rw [Ideal.span_le]
            rintro f (rfl | hf)
            · rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.eval₂Hom_C]
              change s.inr.hom (Ideal.Quotient.mk (Ideal.span {g₀}) g₀) = 0
              rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g₀), map_zero]
            · rw [Set.mem_singleton_iff] at hf
              subst hf
              rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_sum]
              simp only [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
              have hv_h : v₀ h_loc = s.inl.hom (Ideal.Quotient.mk I_R' (MvPolynomial.C h)) := by
                rw [← hβ_h]
                exact (congrArg (fun φ => φ.hom h) s.condition).symm
              have hQ0 : Ideal.Quotient.mk I_R' Q_R' = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self Q_R')
              have hinl_Q : s.inl.hom (Ideal.Quotient.mk I_R' Q_R') = 0 := by
                rw [hQ0, map_zero]
              dsimp [Q_R'] at hinl_Q
              rw [map_sub, map_sub, map_sum, map_sum] at hinl_Q
              simp only [map_mul] at hinl_Q
              rwa [hv_h]
          )))
        (fun s => ?_) (fun s => ?_) (fun s m hm_inl hm_inr => ?_)⟩
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r'
          have hr' := (congrArg (fun φ => φ.hom r') s.condition).symm
          change MvPolynomial.eval₂Hom _ _ (MvPolynomial.map β_R' (MvPolynomial.C r')) =
            s.inl.hom (Ideal.Quotient.mk I_R' (MvPolynomial.C r'))
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact hr'
        · intro idx
          change MvPolynomial.eval₂Hom _ _ (MvPolynomial.map β_R' (MvPolynomial.X idx)) =
            s.inl.hom (Ideal.Quotient.mk I_R' (MvPolynomial.X idx))
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro r
        exact MvPolynomial.eval₂Hom_C _ _ r
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          have hr := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (Ideal.span {g₀}) r)) hm_inr
          change m.hom (Ideal.Quotient.mk I_odp (MvPolynomial.C r)) =
            s.inr.hom (Ideal.Quotient.mk (Ideal.span {g₀}) r) at hr
          change m.hom (Ideal.Quotient.mk I_odp (MvPolynomial.C r)) =
            MvPolynomial.eval₂Hom _ _ (MvPolynomial.C r)
          rw [MvPolynomial.eval₂Hom_C]
          exact hr
        · intro idx
          have hidx := congrArg (fun φ => φ.hom (Ideal.Quotient.mk I_R' (MvPolynomial.X idx))) hm_inl
          change m.hom (Ideal.Quotient.mk I_odp (MvPolynomial.map β_R' (MvPolynomial.X idx))) =
            s.inl.hom (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)) at hidx
          rw [MvPolynomial.map_X] at hidx
          change m.hom (Ideal.Quotient.mk I_odp (MvPolynomial.X idx)) =
            MvPolynomial.eval₂Hom _ _ (MvPolynomial.X idx)
          rw [MvPolynomial.eval₂Hom_X']
          exact hidx
    let g_S0 : AlgebraicGeometry.Spec S_0 ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span {g₀})).comp β_R'))
    have hPb_M :
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map π_M)
          (AlgebraicGeometry.Spec.map c_S0)
          π_mod g_S0 :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_M

    
    let g_bc : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of F) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let P1_k := weilBaseChangeOver F k (weilProjectiveSpaceOver F 1)
    let π_P1 : P1_k.left ⟶ (weilProjectiveSpaceOver F 1).left :=
      CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom g_bc
    let Z_tilde_k := weilBaseChangeOver F k P.Z_tilde
    let π_Ztilde : Z_tilde_k.left ⟶ P.Z_tilde.left :=
