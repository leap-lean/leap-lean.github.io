        map_add' := fun x y => hInj_BL (by simp [IsIntegralClosure.algebraMap_mk']) }
    let instAlg_kr_Br : Algebra k_r B_r := ι_kr_B.toAlgebra
    have hST_kr_B_L : IsScalarTower k_r B_r L_r :=
      IsScalarTower.of_algebraMap_eq fun c =>
        (IsIntegralClosure.algebraMap_mk' B_r (algebraMap k_r L_r c) (hkr_R₀ c)).symm
    have hST_F_kr_B : IsScalarTower F k_r B_r := by
      refine IsScalarTower.of_algebraMap_eq fun c => hInj_BL ?_
      rw [← IsScalarTower.algebraMap_apply F B_r L_r,
        IsScalarTower.algebraMap_apply F k_r L_r,
        IsScalarTower.algebraMap_apply k_r B_r L_r]

    let x₀ : L_r := algebraMap (RatFunc F) L_r RatFunc.X
    let φ₀ : Polynomial k_r →ₐ[k_r] L_r := Polynomial.aeval x₀
    have hφ₀_inj : Function.Injective φ₀ := by
      rw [injective_iff_map_eq_zero]
      intro Q hQ
      by_contra hQ_ne
      have hx₀_alg : IsAlgebraic k_r x₀ := ⟨Q, hQ_ne, hQ⟩
      have hx₀_int_kr : IsIntegral k_r x₀ := isAlgebraic_iff_isIntegral.mp hx₀_alg
      have hx₀_int_F : IsIntegral F x₀ := isIntegral_trans (R := F) x₀ hx₀_int_kr
      have hX_int_F : IsIntegral F (RatFunc.X : RatFunc F) :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (RatFunc F) L_r)
          (RingHom.injective _)).mp hx₀_int_F
      obtain ⟨P, hP_ne, hP_eval⟩ := isAlgebraic_iff_isIntegral.mpr hX_int_F
      have hP_map : algebraMap (Polynomial F) (RatFunc F) P = 0 := by
        have h1 : ∀ Q_F : Polynomial F,
            Polynomial.aeval (RatFunc.X : RatFunc F) Q_F =
              algebraMap (Polynomial F) (RatFunc F) Q_F := by
          intro Q_F
          induction Q_F using Polynomial.induction_on' with
          | add p q hp hq => rw [map_add, map_add, hp, hq]
          | monomial n a =>
            rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, Polynomial.aeval_C,
              map_pow, Polynomial.aeval_X, map_mul, map_pow, RatFunc.algebraMap_X,
              RatFunc.algebraMap_C]
            rfl
        rwa [← h1 P]
      exact hP_ne (IsFractionRing.injective (Polynomial F) (RatFunc F) (hP_map.trans (map_zero _).symm))

    have hFin_kr : Finite k_r := by
      let b := Module.Basis.ofVectorSpace F k_r
      have hLI : LinearIndependent (RatFunc F) (fun i => algebraMap k_r L_r (b i)) := by
        rw [linearIndependent_iff']
        intro s g hsum i hi
        obtain ⟨d, hd⟩ :=
          IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial F)) s g
        choose p hp using fun j : s => hd j.1 j.2
        have hd_ne : (d : Polynomial F) ≠ 0 := nonZeroDivisors.ne_zero d.2
        have hsum_mul : ∑ j : s,
            algebraMap (Polynomial F) L_r (p j) * algebraMap k_r L_r (b j.1) = 0 := by
          calc ∑ j : s, algebraMap (Polynomial F) L_r (p j) * algebraMap k_r L_r (b j.1)
              = ∑ j : s, (algebraMap (RatFunc F) L_r ((d : Polynomial F) • g j.1)) *
                  algebraMap k_r L_r (b j.1) := by
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r, hp j]
            _ = algebraMap (Polynomial F) L_r (d : Polynomial F) *
                  (∑ j ∈ s, g j • algebraMap k_r L_r (b j)) := by
                rw [← Finset.sum_attach s (fun j => g j • algebraMap k_r L_r (b j)), Finset.mul_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc,
                  IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
            _ = 0 := by rw [hsum, mul_zero]
        have hφ_p : ∀ q : Polynomial F,
            algebraMap (Polynomial F) L_r q = φ₀ (q.map (algebraMap F k_r)) := by
          intro q
          induction q using Polynomial.induction_on' with
          | add q₁ q₂ h₁ h₂ => simp [Polynomial.map_add, map_add, h₁, h₂]
          | monomial n c =>
            rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.map_mul, Polynomial.map_C,
              Polynomial.map_pow, Polynomial.map_X, map_mul, map_pow, map_mul, map_pow]
            have hC : algebraMap (Polynomial F) L_r (Polynomial.C c) =
                algebraMap k_r L_r (algebraMap F k_r c) := by
              rw [← IsScalarTower.algebraMap_apply F k_r L_r]
              exact (IsScalarTower.algebraMap_apply F (Polynomial F) L_r c).symm
            have hX : algebraMap (Polynomial F) L_r Polynomial.X = x₀ := by
              rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r, RatFunc.algebraMap_X]
            rw [hC, hX]
            change _ = Polynomial.aeval x₀ (Polynomial.C (algebraMap F k_r c)) *
              (Polynomial.aeval x₀ Polynomial.X) ^ n
            rw [Polynomial.aeval_C, Polynomial.aeval_X]
        let Q : Polynomial k_r :=
          ∑ j : s, (p j).map (algebraMap F k_r) * Polynomial.C (b j.1)
        have hQ0 : φ₀ Q = 0 := by
          dsimp [Q]
          rw [map_sum]
          convert hsum_mul using 1
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, ← hφ_p (p j)]
          exact congrArg _ (Polynomial.aeval_C x₀ (b j.1))
        have hQ_eq0 : Q = 0 := hφ₀_inj (hQ0.trans (map_zero φ₀).symm)
        have hLI_s : LinearIndependent F (fun j : s => b j.1) :=
          b.linearIndependent.comp Subtype.val Subtype.val_injective
        have hp_zero : p ⟨i, hi⟩ = 0 := by
          ext n
          have hcoeff : Q.coeff n = 0 := by rw [hQ_eq0, Polynomial.coeff_zero]
          dsimp [Q] at hcoeff
          rw [Polynomial.finsetSum_coeff] at hcoeff
          have hsum_b : ∑ j : s, ((p j).coeff n) • b j.1 = 0 := by
            convert hcoeff using 1
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [Polynomial.coeff_mul_C, Polynomial.coeff_map, Algebra.smul_def]
          exact Fintype.linearIndependent_iff.mp hLI_s (fun j => (p j).coeff n) hsum_b ⟨i, hi⟩
        have hdg0 : (d : Polynomial F) • g i = 0 := by
          rw [← hp ⟨i, hi⟩, hp_zero, map_zero]
        have hd_RF_ne : algebraMap (Polynomial F) (RatFunc F) (d : Polynomial F) ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial F) (RatFunc F))).mpr hd_ne
        rw [Algebra.smul_def] at hdg0
        exact (mul_eq_zero.mp hdg0).resolve_left hd_RF_ne
      have : Finite (Module.Basis.ofVectorSpaceIndex F k_r) := hLI.finite
      have : Module.Finite F k_r := Module.Finite.of_basis b
      exact Module.finite_of_finite F

    let ψ_kr : RatFunc k_r →ₐ[k_r] L_r :=
      IsFractionRing.liftAlgHom (K := RatFunc k_r) hφ₀_inj
    let instAlg_Pkr_Lr : Algebra (Polynomial k_r) L_r := φ₀.toRingHom.toAlgebra
    let instAlg_RFkr_Lr : Algebra (RatFunc k_r) L_r := ψ_kr.toRingHom.toAlgebra
    have hST_kr_Pkr_L : IsScalarTower k_r (Polynomial k_r) L_r :=
      IsScalarTower.of_algebraMap_eq fun c => (φ₀.commutes c).symm
    have hST_kr_RFkr_L : IsScalarTower k_r (RatFunc k_r) L_r :=
      IsScalarTower.of_algebraMap_eq fun c => (ψ_kr.commutes c).symm
    have hST_Pkr_RFkr_L : IsScalarTower (Polynomial k_r) (RatFunc k_r) L_r :=
      IsScalarTower.of_algebraMap_eq fun p => by
        change φ₀ p = IsFractionRing.liftAlgHom (K := RatFunc k_r) hφ₀_inj
          (algebraMap (Polynomial k_r) (RatFunc k_r) p)
        exact (IsFractionRing.lift_algebraMap hφ₀_inj p).symm
    have hX_kr : algebraMap (RatFunc k_r) L_r RatFunc.X = algebraMap (RatFunc F) L_r RatFunc.X := by
      rw [← RatFunc.algebraMap_X, ← IsScalarTower.algebraMap_apply (Polynomial k_r) (RatFunc k_r) L_r]
      exact Polynomial.aeval_X x₀

    let g_F_kr : Polynomial F →+* RatFunc k_r :=
      (algebraMap (Polynomial k_r) (RatFunc k_r)).comp (Polynomial.mapRingHom (algebraMap F k_r))
    have hg_F_kr_inj : Function.Injective g_F_kr :=
      (IsFractionRing.injective (Polynomial k_r) (RatFunc k_r)).comp
        (Polynomial.map_injective _ (RingHom.injective _))
    let j_RF_kr : RatFunc F →+* RatFunc k_r := IsFractionRing.lift hg_F_kr_inj
    let _ : Algebra (RatFunc F) (RatFunc k_r) := j_RF_kr.toAlgebra
    have : IsScalarTower (RatFunc F) (RatFunc k_r) L_r := by
      refine IsScalarTower.of_algebraMap_eq' ?_
      apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F))
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply]
        have hL : algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c)) =
            algebraMap F L_r c := by
          rw [← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
          exact (IsScalarTower.algebraMap_apply F (Polynomial F) L_r c).symm
        rw [hL]
        change _ = algebraMap (RatFunc k_r) L_r (j_RF_kr (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c)))
        rw [IsFractionRing.lift_algebraMap]
        simp only [g_F_kr, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          ← IsScalarTower.algebraMap_apply (Polynomial k_r) (RatFunc k_r) L_r]
        change algebraMap F L_r c = φ₀ (Polynomial.C (algebraMap F k_r c))
        rw [Polynomial.aeval_C, ← IsScalarTower.algebraMap_apply F k_r L_r]
      · simp only [RingHom.comp_apply]
        change algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F) Polynomial.X) =
          algebraMap (RatFunc k_r) L_r (j_RF_kr (algebraMap (Polynomial F) (RatFunc F) Polynomial.X))
        rw [IsFractionRing.lift_algebraMap]
        simp only [g_F_kr, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          RatFunc.algebraMap_X, hX_kr]

    have hFD_kr : FiniteDimensional (RatFunc k_r) L_r :=
      Module.Finite.of_restrictScalars_finite (RatFunc F) (RatFunc k_r) L_r
    have hGal_kr : IsGalois (RatFunc k_r) L_r :=
      IsGalois.tower_top_of_isGalois (RatFunc F) (RatFunc k_r) L_r
    let Ψ_L : (L_r ≃ₐ[RatFunc k_r] L_r) →* (L_r ≃ₐ[RatFunc F] L_r) :=
      AlgEquiv.restrictScalarsHom (RatFunc F)
    let Ψ_B : (L_r ≃ₐ[RatFunc k_r] L_r) →* (B_r ≃ₐ[R₀] B_r) :=
      res_B.toMonoidHom.comp Ψ_L
    have hΨB_inj : Function.Injective Ψ_B :=
      res_B.injective.comp (AlgEquiv.restrictScalars_injective (RatFunc F))

    have hΨB_act : ∀ σ_K : L_r ≃ₐ[RatFunc k_r] L_r,
        (∃ σ_L : L_r ≃ₐ[RatFunc F] L_r, ∀ y : L_r, σ_L y = σ_K y) ∧
        (∀ x : L_r, IsIntegral F x → σ_K x = x) ∧
        (∀ b : B_r, σ_K (algebraMap B_r L_r b) = algebraMap B_r L_r (Ψ_B σ_K b)) := by
      intro σ_K
      refine ⟨⟨Ψ_L σ_K, fun _ => rfl⟩, ?_, ?_⟩
      · intro x hx
        let c : k_r := ⟨x, mem_algebraicClosure_iff'.mpr hx⟩
        have hc : σ_K (algebraMap k_r L_r c) = algebraMap k_r L_r c := by
          rw [IsScalarTower.algebraMap_apply k_r (RatFunc k_r) L_r, σ_K.commutes]
        exact hc
      · intro b
        exact (algebraMap_galRestrict_apply R₀ (Ψ_L σ_K) b).symm

    have hLift_core : ∀ σ_B : B_r ≃ₐ[R₀] B_r,
        (∀ x : B_r, IsIntegral F x → σ_B x = x) →
        ∃ σ_K : L_r ≃ₐ[RatFunc k_r] L_r,
          Ψ_B σ_K = σ_B ∧ ∀ y : L_r, σ_K y = (res_B.symm σ_B) y := by
      intro σ_B hFix_B
      let σ_L : L_r ≃ₐ[RatFunc F] L_r := res_B.symm σ_B
      have hσL_B : ∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b) := by
        intro b
        have h1 := algebraMap_galRestrict_apply R₀ σ_L b
        rw [res_B.apply_symm_apply] at h1
        exact h1.symm
      have hσL_kr : ∀ c : k_r, σ_L (algebraMap k_r L_r c) = algebraMap k_r L_r c := by
        intro c
        have hcB_int : IsIntegral F (algebraMap k_r B_r c) :=
          (isIntegral_algHom_iff (IsScalarTower.toAlgHom F B_r L_r) hInj_BL).mp
            (by rw [IsScalarTower.toAlgHom_apply, ← IsScalarTower.algebraMap_apply k_r B_r L_r]; exact hkr_int c)
        rw [IsScalarTower.algebraMap_apply k_r B_r L_r, hσL_B, hFix_B _ hcB_int]
      have hσL_comm : σ_L.toRingHom.comp (algebraMap (RatFunc k_r) L_r) =
          algebraMap (RatFunc k_r) L_r := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial k_r))
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply,
            ← IsScalarTower.algebraMap_apply (Polynomial k_r) (RatFunc k_r) L_r]
          have hC_kr : algebraMap (Polynomial k_r) L_r (Polynomial.C c) = algebraMap k_r L_r c :=
            (IsScalarTower.algebraMap_apply k_r (Polynomial k_r) L_r c).symm
          rw [hC_kr]
          exact hσL_kr c
        · simp only [RingHom.comp_apply, RatFunc.algebraMap_X, hX_kr]
          exact σ_L.commutes RatFunc.X
      let σ_K : L_r ≃ₐ[RatFunc k_r] L_r :=
        AlgEquiv.ofRingEquiv (f := σ_L.toRingEquiv) fun q => RingHom.congr_fun hσL_comm q
      have hΨL_eq : Ψ_L σ_K = σ_L := by
        ext y
        rfl
      refine ⟨σ_K, ?_, fun _ => rfl⟩
      change res_B (Ψ_L σ_K) = σ_B
      rw [hΨL_eq, res_B.apply_symm_apply]

    refine ⟨k_r, hFin_kr, inferInstance, inferInstance, instAlg_kr_Br, inferInstance,
      instAlg_Pkr_Lr, instAlg_RFkr_Lr, hST_F_kr_B, inferInstance, hST_kr_B_L,
      hST_kr_Pkr_L, hST_kr_RFkr_L, hST_Pkr_RFkr_L, hFD_kr, hGal_kr, Ψ_B,
      hX_kr, hkr_int, hkr_closed, hΨB_inj, ?_, hΨB_act, ?_⟩
    · intro σ_B
      constructor
      · rintro ⟨σ_K, rfl⟩ x hx
        apply hInj_BL
        rw [← (hΨB_act σ_K).2.2 x]
        exact (hΨB_act σ_K).2.1 _ (IsIntegral.map (IsScalarTower.toAlgHom F B_r L_r) hx)
      · intro hFix_B
        obtain ⟨σ_K, hEq, _⟩ := hLift_core σ_B hFix_B
        exact ⟨σ_K, hEq⟩
    · intro σ_B σ_L hFix_L hExt_L
      have hFix_B : ∀ x : B_r, IsIntegral F x → σ_B x = x := by
        intro x hx
        apply hInj_BL
        rw [← hExt_L x]
        exact hFix_L _ (IsIntegral.map (IsScalarTower.toAlgHom F B_r L_r) hx)
      have hres_eq : res_B σ_L = σ_B := by
        ext b
        apply hInj_BL
        rw [algebraMap_galRestrict_apply R₀ σ_L b, hExt_L b]
      have hσL_symm : res_B.symm σ_B = σ_L := by
        rw [← hres_eq, res_B.symm_apply_apply]
      obtain ⟨σ_K, hΨB_eq, hVal⟩ := hLift_core σ_B hFix_B
      refine ⟨σ_K, hΨB_eq, fun y => ?_⟩
      rw [hVal y, hσL_symm]

  
  have s3_sig : ∀ (k₀ : Type u) [Finite k₀] [Field k₀]
      (k : Type u) [Field k] [IsAlgClosed k] [Algebra k₀ k] [Algebra.IsAlgebraic k₀ k]
      (L : Type u) [Field L]
      [Algebra k₀ L] [Algebra (Polynomial k₀) L] [Algebra (RatFunc k₀) L]
      [IsScalarTower k₀ (Polynomial k₀) L] [IsScalarTower k₀ (RatFunc k₀) L]
      [IsScalarTower (Polynomial k₀) (RatFunc k₀) L]
      [FiniteDimensional (RatFunc k₀) L] [IsGalois (RatFunc k₀) L],
      (∀ z : L, IsIntegral k₀ z → z ∈ Set.range (algebraMap k₀ L)) →
      ∃ (M : Type u) (_ : Field M)
        (_ : Algebra k M) (_ : Algebra (Polynomial k) M) (_ : Algebra (RatFunc k) M)
        (_ : IsScalarTower k (Polynomial k) M) (_ : IsScalarTower k (RatFunc k) M)
        (_ : IsScalarTower (Polynomial k) (RatFunc k) M)
        (_ : FiniteDimensional (RatFunc k) M) (_ : IsGalois (RatFunc k) M)
        (ψ_M : L →+* M)
        (res_M : (M ≃ₐ[RatFunc k] M) ≃* (L ≃ₐ[RatFunc k₀] L)),
        Function.Injective ψ_M ∧
        ψ_M.comp (algebraMap k₀ L) = (algebraMap k M).comp (algebraMap k₀ k) ∧
        ψ_M (algebraMap (RatFunc k₀) L RatFunc.X) = algebraMap (RatFunc k) M RatFunc.X ∧
        (∀ (γ : M ≃ₐ[RatFunc k] M) (y : L), γ (ψ_M y) = ψ_M (res_M γ y)) ∧
        (∀ {ι : Type u} (v : ι → L),
          LinearIndependent (RatFunc k₀) v → LinearIndependent (RatFunc k) (ψ_M ∘ v)) ∧
        (∀ R_sub : Subalgebra k₀ L,
          (integralClosure ↥(Algebra.adjoin k (ψ_M '' (R_sub : Set L))) M : Set M) ⊆
            (Algebra.adjoin k (ψ_M '' (integralClosure ↥R_sub L : Set L)) : Set M)) := by
    clear * -
    intro k₀ _ _ k _ _ _ _ L _ _ _ _ _ _ _ _ _ hk₀_closed
    let _ : DecidableEq k := Classical.typeDecidableEq k
    let g_poly : Polynomial k₀ →+* RatFunc k :=
      (algebraMap (Polynomial k) (RatFunc k)).comp (Polynomial.mapRingHom (algebraMap k₀ k))
    have hg_poly_inj : Function.Injective g_poly :=
      (IsFractionRing.injective (Polynomial k) (RatFunc k)).comp
        (Polynomial.map_injective _ (RingHom.injective _))
    let j_K : RatFunc k₀ →+* RatFunc k := IsFractionRing.lift hg_poly_inj
    have hj_K_k₀ : ∀ c : k₀,
        j_K (algebraMap k₀ (RatFunc k₀) c) = algebraMap k (RatFunc k) (algebraMap k₀ k c) := by
      intro c
      rw [IsScalarTower.algebraMap_apply k₀ (Polynomial k₀) (RatFunc k₀),
        IsFractionRing.lift_algebraMap]
      change algebraMap (Polynomial k) (RatFunc k) ((Polynomial.C c).map (algebraMap k₀ k)) = _
      rw [Polynomial.map_C, RatFunc.algebraMap_C]
      rfl
    have hj_K_X : j_K RatFunc.X = RatFunc.X := by
      rw [← RatFunc.algebraMap_X, IsFractionRing.lift_algebraMap]
      simp only [g_poly, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
        RatFunc.algebraMap_X]

    let n_L := Module.finrank (RatFunc k₀) L
    let bL : Module.Basis (Fin n_L) (RatFunc k₀) L := Module.finBasis (RatFunc k₀) L

    have hSubalgInv : ∀ {K E : Type u} [Field K] [Field E] [Algebra K E]
        (A : Subalgebra K E) [Module.Finite K ↥A] {u : E}, u ∈ A → u ≠ 0 → u⁻¹ ∈ A := by
      intro K E _ _ _ A _ u hu hu_ne
      have : Algebra.IsIntegral K ↥A := Algebra.IsIntegral.of_finite K ↥A
      let uA : ↥A := ⟨u, hu⟩
      have huA_int : IsIntegral K uA := Algebra.IsIntegral.isIntegral uA
      have huA_ne : uA ≠ 0 := fun h => hu_ne (congrArg Subtype.val h)
      let q : Polynomial K := minpoly K uA
      have hq_irr : Irreducible q := minpoly.irreducible huA_int
      have hq_eval : Polynomial.aeval uA q = 0 := minpoly.aeval K uA
      have hq0_ne : q.coeff 0 ≠ 0 := by
        intro hq0
        have hdvd : Polynomial.X ∣ q := Polynomial.X_dvd_iff.mpr hq0
        rcases hdvd with ⟨r, hr⟩
        have hX_not_unit : ¬ IsUnit (Polynomial.X : Polynomial K) :=
          Polynomial.not_isUnit_X
        have hr_unit : IsUnit r := (hq_irr.isUnit_or_isUnit hr).resolve_left hX_not_unit
        have hdeg0 : r.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hr_unit
        have hr_mon : r.Monic :=
          Polynomial.Monic.of_mul_monic_left Polynomial.monic_X (hr ▸ minpoly.monic huA_int)
        have hr1 : r = 1 := Polynomial.eq_one_of_monic_natDegree_zero hr_mon hdeg0
        rw [hr1, mul_one] at hr
        rw [hr, Polynomial.aeval_X] at hq_eval
        exact huA_ne hq_eval
      have hdiv := Polynomial.X_mul_divX_add q
      have heval_div : u * (Polynomial.aeval uA q.divX : E) + algebraMap K E (q.coeff 0) = 0 := by
        have h1 := congrArg (fun p => (Polynomial.aeval uA p : E)) hdiv
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hq_eval,
          ZeroMemClass.coe_zero, Subalgebra.coe_add, Subalgebra.coe_mul] at h1
        exact h1
      have hinv_eq : u⁻¹ = -((algebraMap K E (q.coeff 0))⁻¹ * (Polynomial.aeval uA q.divX : E)) := by
        have h2 : u * (-((algebraMap K E (q.coeff 0))⁻¹ * (Polynomial.aeval uA q.divX : E))) = 1 := by
          have hu_mul : u * (Polynomial.aeval uA q.divX : E) = -algebraMap K E (q.coeff 0) :=
            eq_neg_of_add_eq_zero_left heval_div
          have hc0_ne_E : algebraMap K E (q.coeff 0) ≠ 0 := by
            intro h0
            apply hq0_ne
            have h1 : algebraMap K E (q.coeff 0 * (q.coeff 0)⁻¹) = 0 := by
              rw [map_mul, h0, zero_mul]
            rw [mul_inv_cancel₀ hq0_ne, map_one] at h1
            exact absurd h1.symm zero_ne_one
          calc u * (-((algebraMap K E (q.coeff 0))⁻¹ * (Polynomial.aeval uA q.divX : E)))
              = -((algebraMap K E (q.coeff 0))⁻¹ * (u * (Polynomial.aeval uA q.divX : E))) := by ring
            _ = -((algebraMap K E (q.coeff 0))⁻¹ * (-algebraMap K E (q.coeff 0))) := by rw [hu_mul]
            _ = (algebraMap K E (q.coeff 0))⁻¹ * algebraMap K E (q.coeff 0) := by ring
            _ = 1 := inv_mul_cancel₀ hc0_ne_E
        exact inv_eq_of_mul_eq_one_right h2
      rw [hinv_eq, ← map_inv₀ (algebraMap K E)]
      exact A.neg_mem (A.mul_mem (A.algebraMap_mem _) (Polynomial.aeval uA q.divX).2)

    have hStep3_1 : ∃ (M : Type u) (_ : Field M)
        (_ : Algebra k M) (_ : Algebra (Polynomial k) M) (_ : Algebra (RatFunc k) M)
        (_ : IsScalarTower k (Polynomial k) M) (_ : IsScalarTower k (RatFunc k) M)
        (_ : IsScalarTower (Polynomial k) (RatFunc k) M)
        (_ : FiniteDimensional (RatFunc k) M) (_ : IsGalois (RatFunc k) M)
        (ψ_M : L →+* M),
        Function.Injective ψ_M ∧
        (∀ q : RatFunc k₀, ψ_M (algebraMap (RatFunc k₀) L q) = algebraMap (RatFunc k) M (j_K q)) ∧
        ψ_M.comp (algebraMap k₀ L) = (algebraMap k M).comp (algebraMap k₀ k) ∧
        ψ_M (algebraMap (RatFunc k₀) L RatFunc.X) = algebraMap (RatFunc k) M RatFunc.X ∧
        Submodule.span (RatFunc k) (Set.range (ψ_M ∘ bL)) = ⊤ := by
      let Ω : Type u := AlgebraicClosure (RatFunc k)
      let _ : DecidableEq Ω := Classical.typeDecidableEq Ω
      let _ : Algebra (RatFunc k₀) Ω := ((algebraMap (RatFunc k) Ω).comp j_K).toAlgebra
      have : Algebra.IsAlgebraic (RatFunc k₀) L := Algebra.IsAlgebraic.of_finite (RatFunc k₀) L
      let ψ_Ω : L →ₐ[RatFunc k₀] Ω := IsAlgClosed.lift
      let M_int : IntermediateField (RatFunc k) Ω :=
        IntermediateField.adjoin (RatFunc k) (Set.range ψ_Ω)
      let M : Type u := ↥M_int
      let instAlg_Pk_M : Algebra (Polynomial k) M :=
        ((algebraMap (RatFunc k) M).comp (algebraMap (Polynomial k) (RatFunc k))).toAlgebra
      let instAlg_k_M : Algebra k M :=
        ((algebraMap (RatFunc k) M).comp (algebraMap k (RatFunc k))).toAlgebra
      have hST_k_RFk_M : IsScalarTower k (RatFunc k) M := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hST_Pk_RFk_M : IsScalarTower (Polynomial k) (RatFunc k) M :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hST_k_Pk_M : IsScalarTower k (Polynomial k) M := by
        refine IsScalarTower.of_algebraMap_eq fun c => ?_
        change algebraMap (RatFunc k) M (algebraMap k (RatFunc k) c) =
          algebraMap (RatFunc k) M (algebraMap (Polynomial k) (RatFunc k) (algebraMap k (Polynomial k) c))
        rw [← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]

      let ψ_M : L →+* M :=
        { toFun := fun y => ⟨ψ_Ω y, IntermediateField.subset_adjoin (RatFunc k) (Set.range ψ_Ω) ⟨y, rfl⟩⟩
          map_one' := Subtype.ext (map_one ψ_Ω)
          map_mul' := fun x y => Subtype.ext (map_mul ψ_Ω x y)
          map_zero' := Subtype.ext (map_zero ψ_Ω)
          map_add' := fun x y => Subtype.ext (map_add ψ_Ω x y) }
      have hψ_inj : Function.Injective ψ_M := RingHom.injective ψ_M
      have hψ_RF : ∀ q : RatFunc k₀,
          ψ_M (algebraMap (RatFunc k₀) L q) = algebraMap (RatFunc k) M (j_K q) := by
        intro q
        apply Subtype.ext
        exact ψ_Ω.commutes q
      have hψ_k₀ : ψ_M.comp (algebraMap k₀ L) = (algebraMap k M).comp (algebraMap k₀ k) := by
        ext c
        simp only [RingHom.comp_apply, IsScalarTower.algebraMap_apply k₀ (RatFunc k₀) L,
          hψ_RF, hj_K_k₀, ← IsScalarTower.algebraMap_apply k (RatFunc k) M]
      have hψ_X : ψ_M (algebraMap (RatFunc k₀) L RatFunc.X) = algebraMap (RatFunc k) M RatFunc.X := by
        rw [hψ_RF, hj_K_X]

      have hMint_eq_fin : M_int =
          IntermediateField.adjoin (RatFunc k) (Set.range (ψ_Ω ∘ bL)) := by
        apply le_antisymm
        · rw [IntermediateField.adjoin_le_iff]
          rintro _ ⟨y, rfl⟩
          have hy : y = ∑ i : Fin n_L, bL.repr y i • bL i := (bL.sum_repr y).symm
          rw [hy, map_sum]
          refine Subring.sum_mem _ fun i _ => ?_
          rw [Algebra.smul_def, map_mul]
          have h1 : ψ_Ω (algebraMap (RatFunc k₀) L (bL.repr y i)) =
              algebraMap (RatFunc k) Ω (j_K (bL.repr y i)) := ψ_Ω.commutes _
          rw [h1]
          exact Subring.mul_mem _
            (Subfield.subset_closure (Or.inl ⟨_, rfl⟩))
            (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩)
        · rw [IntermediateField.adjoin_le_iff]
          rintro _ ⟨i, rfl⟩
          exact IntermediateField.subset_adjoin _ _ ⟨bL i, rfl⟩

      have hΩ_int : ∀ y : L, IsIntegral (RatFunc k) (ψ_Ω y) := by
        intro y
        have hy : IsIntegral (RatFunc k₀) y := Algebra.IsIntegral.isIntegral y
        exact hy.map_of_comp_eq j_K ψ_Ω.toRingHom (RingHom.ext fun q => (ψ_Ω.commutes q).symm)
      have hFD_M : FiniteDimensional (RatFunc k) M := by
        have : Finite (Set.range (ψ_Ω ∘ bL)) := Set.finite_range _
        have hFD_S : FiniteDimensional (RatFunc k)
            ↥(IntermediateField.adjoin (RatFunc k) (Set.range (ψ_Ω ∘ bL))) :=
          IntermediateField.finiteDimensional_adjoin fun x hx => by
            rcases hx with ⟨i, rfl⟩
            exact hΩ_int (bL i)
        exact (IntermediateField.equivOfEq hMint_eq_fin.symm).toLinearEquiv.finiteDimensional

      have hSpan_bL : Submodule.span (RatFunc k) (Set.range (ψ_M ∘ bL)) = ⊤ := by
        let V : Submodule (RatFunc k) M := Submodule.span (RatFunc k) (Set.range (ψ_M ∘ bL))
        have hψ_mem_V : ∀ y : L, ψ_M y ∈ V := by
          intro y
          have hy : y = ∑ i : Fin n_L, bL.repr y i • bL i := (bL.sum_repr y).symm
          rw [hy, map_sum]
          refine Submodule.sum_mem V fun i _ => ?_
          rw [Algebra.smul_def, map_mul, hψ_RF, ← Algebra.smul_def]
          exact V.smul_mem _ (Submodule.subset_span ⟨i, rfl⟩)
        have h1_V : (1 : M) ∈ V := by
          rw [← map_one ψ_M]
          exact hψ_mem_V 1
        have hmul_V : ∀ x ∈ V, ∀ y ∈ V, x * y ∈ V := by
          intro x hx
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
          · rintro _ ⟨i, rfl⟩ y hy
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
            · rintro _ ⟨j, rfl⟩
              simp only [Function.comp_apply, ← map_mul]
              exact hψ_mem_V _
            · rw [mul_zero]; exact V.zero_mem
            · intro u v _ _ hu hv; rw [mul_add]; exact V.add_mem hu hv
            · intro c u _ hu; rw [mul_smul_comm]; exact V.smul_mem c hu
          · intro y _; rw [zero_mul]; exact V.zero_mem
          · intro u v _ _ hu hv y hy; rw [add_mul]; exact V.add_mem (hu y hy) (hv y hy)
          · intro c u _ hu y hy; rw [smul_mul_assoc]; exact V.smul_mem c (hu y hy)
        let A_V : Subalgebra (RatFunc k) M :=
          { V with
            one_mem' := h1_V
            mul_mem' := fun {x y} hx hy => hmul_V x hx y hy
            algebraMap_mem' := fun r => by
              rw [← mul_one (algebraMap (RatFunc k) M r), ← Algebra.smul_def]
              exact V.smul_mem r h1_V }
        let F_Ω : IntermediateField (RatFunc k) Ω :=
          { A_V.map M_int.val with
            inv_mem' := by
              rintro _ ⟨x, hx, rfl⟩
              by_cases hx0 : x = 0
              · subst hx0
                simp only [map_zero, inv_zero]
                exact ⟨0, A_V.zero_mem, map_zero _⟩
              · exact ⟨x⁻¹, hSubalgInv A_V hx hx0, map_inv₀ M_int.val x⟩ }
        have hle : M_int ≤ F_Ω := by
          rw [IntermediateField.adjoin_le_iff]
          rintro _ ⟨y, rfl⟩
          exact ⟨ψ_M y, hψ_mem_V y, rfl⟩
        rw [eq_top_iff]
        intro z _
        rcases hle z.2 with ⟨w, hw, hw_eq⟩
        rwa [← Subtype.val_injective hw_eq]

      have hGal_M : IsGalois (RatFunc k) M := by
        have hSep_M : Algebra.IsSeparable (RatFunc k) M := by
          rw [IntermediateField.isSeparable_adjoin_iff_isSeparable]
          rintro _ ⟨y, rfl⟩
          let p : Polynomial (RatFunc k₀) := minpoly (RatFunc k₀) y
          have hp_sep : p.Separable := Algebra.IsSeparable.isSeparable (RatFunc k₀) y
          have hp_map_sep : (p.map j_K).Separable := hp_sep.map
          have hp_eval : Polynomial.aeval (ψ_Ω y) (p.map j_K) = 0 := by
            rw [Polynomial.aeval_def, Polynomial.eval₂_map]
            change Polynomial.aeval (ψ_Ω y) p = 0
            rw [Polynomial.aeval_algHom_apply ψ_Ω y p, minpoly.aeval, map_zero]
          exact hp_map_sep.of_dvd (minpoly.dvd (RatFunc k) (ψ_Ω y) hp_eval)
        have hSplits_gen : ∀ x ∈ Set.range ψ_Ω,
            IsIntegral (RatFunc k) x ∧
              (Polynomial.map (algebraMap (RatFunc k) M) (minpoly (RatFunc k) x)).Splits := by
          rintro _ ⟨y, rfl⟩
          refine ⟨hΩ_int y, ?_⟩
          let p : Polynomial (RatFunc k₀) := minpoly (RatFunc k₀) y
          have hp_mon : p.Monic := minpoly.monic (Algebra.IsIntegral.isIntegral y)
          have hp_sp_L : (p.map (algebraMap (RatFunc k₀) L)).Splits :=
            Normal.splits inferInstance y
          have hp_sp_M : ((p.map j_K).map (algebraMap (RatFunc k) M)).Splits := by
            have hmap_eq : (p.map j_K).map (algebraMap (RatFunc k) M) =
                (p.map (algebraMap (RatFunc k₀) L)).map ψ_M := by
              rw [Polynomial.map_map, Polynomial.map_map]
              congr 1
              refine RingHom.ext fun q => ?_
              exact (hψ_RF q).symm
            rw [hmap_eq]
            exact hp_sp_L.map ψ_M
          have hp_eval : Polynomial.aeval (ψ_Ω y) (p.map j_K) = 0 := by
            rw [Polynomial.aeval_def, Polynomial.eval₂_map]
            change Polynomial.aeval (ψ_Ω y) p = 0
            rw [Polynomial.aeval_algHom_apply ψ_Ω y p, minpoly.aeval, map_zero]
          have hdvd_M : (minpoly (RatFunc k) (ψ_Ω y)).map (algebraMap (RatFunc k) M) ∣
              (p.map j_K).map (algebraMap (RatFunc k) M) :=
            Polynomial.map_dvd (algebraMap (RatFunc k) M) (minpoly.dvd (RatFunc k) (ψ_Ω y) hp_eval)
          have hne_M : (p.map j_K).map (algebraMap (RatFunc k) M) ≠ 0 := by
            have hmon_M : ((p.map j_K).map (algebraMap (RatFunc k) M)).Monic :=
              (hp_mon.map j_K).map (algebraMap (RatFunc k) M)
            exact hmon_M.ne_zero
          exact hp_sp_M.of_dvd hne_M hdvd_M
        have hNorm_M : Normal (RatFunc k) M := ⟨fun z => by
          have hmin_eq : minpoly (RatFunc k) (z : Ω) = minpoly (RatFunc k) z :=
            minpoly.algebraMap_eq Subtype.val_injective z
          rw [← hmin_eq]
          exact IntermediateField.splits_of_mem_adjoin (RatFunc k) Ω hSplits_gen z.2⟩
        exact IsGalois.mk

      exact ⟨M, inferInstance, instAlg_k_M, instAlg_Pk_M, inferInstance,
        hST_k_Pk_M, hST_k_RFk_M, hST_Pk_RFk_M, hFD_M, hGal_M,
        ψ_M, hψ_inj, hψ_RF, hψ_k₀, hψ_X, hSpan_bL⟩

    obtain ⟨M, hFld_M, instAlg_k_M, instAlg_Pk_M, hARF_M,
        hST_k_Pk_M, hST_k_RFk_M, hST_Pk_RFk_M, hFD_M, hGal_M,
        ψ_M, hψ_inj, hψ_RF, hψ_k₀, hψ_X, hSpan_bL⟩ := hStep3_1
    let _ := hFld_M; let _ := instAlg_k_M; let _ := instAlg_Pk_M; let _ := hARF_M
    let _ := hST_k_Pk_M; let _ := hST_k_RFk_M; let _ := hST_Pk_RFk_M
    let _ := hFD_M; let _ := hGal_M

    have hLinFactorPull : ∀ (R : Multiset k) (F_M : Polynomial M),
        F_M.Monic →
        F_M ∣ (R.map fun α => Polynomial.X - Polynomial.C (algebraMap k M α)).prod →
        ∃ F_k : Polynomial k, F_k.map (algebraMap k M) = F_M := by
      intro R
      induction R using Multiset.induction_on with
      | empty =>
        intro F_M hFM_mon hdvd
        simp only [Multiset.map_zero, Multiset.prod_zero] at hdvd
        have hunit : IsUnit F_M := isUnit_of_dvd_one hdvd
        have hdeg0 : F_M.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hunit
        have hFM1 : F_M = 1 := Polynomial.eq_one_of_monic_natDegree_zero hFM_mon hdeg0
        exact ⟨1, by rw [hFM1, Polynomial.map_one]⟩
      | cons α R ih =>
        intro F_M hFM_mon hdvd
        simp only [Multiset.map_cons, Multiset.prod_cons] at hdvd
        let lin_M : Polynomial M := Polynomial.X - Polynomial.C (algebraMap k M α)
        have hlin_irr : Irreducible lin_M := Polynomial.irreducible_X_sub_C _
        have hlin_mon : lin_M.Monic := Polynomial.monic_X_sub_C _
        by_cases h_div : lin_M ∣ F_M
        · rcases h_div with ⟨Q_M, rfl⟩
          have hQM_mon : Q_M.Monic := Polynomial.Monic.of_mul_monic_left hlin_mon hFM_mon
          have hQM_dvd : Q_M ∣ (R.map fun β => Polynomial.X - Polynomial.C (algebraMap k M β)).prod :=
            (mul_dvd_mul_iff_left hlin_mon.ne_zero).mp hdvd
          obtain ⟨Q_k, hQk⟩ := ih Q_M hQM_mon hQM_dvd
          refine ⟨(Polynomial.X - Polynomial.C α) * Q_k, ?_⟩
          rw [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hQk]
        · have hcop : IsCoprime lin_M F_M := (Irreducible.coprime_iff_not_dvd hlin_irr).mpr h_div
          exact ih F_M hFM_mon (IsCoprime.dvd_of_dvd_mul_left hcop.symm hdvd)

    have hMinpolyIrrOverL : ∀ (k' : IntermediateField k₀ k) [FiniteDimensional k₀ k'] (θ : k'),
        Irreducible ((minpoly k₀ θ).map (algebraMap k₀ L)) := by
      intro k' _ θ
      let m_θ : Polynomial k₀ := minpoly k₀ θ
      have hm_int : IsIntegral k₀ θ := Algebra.IsIntegral.isIntegral θ
      have hm_mon : m_θ.Monic := minpoly.monic hm_int
      have hm_irr : Irreducible m_θ := minpoly.irreducible hm_int
      have hm_deg_pos : 0 < m_θ.natDegree := minpoly.natDegree_pos hm_int
      let P_L : Polynomial L := m_θ.map (algebraMap k₀ L)
      have hPL_mon : P_L.Monic := hm_mon.map (algebraMap k₀ L)
      have hPL_deg : P_L.natDegree = m_θ.natDegree := hm_mon.natDegree_map (algebraMap k₀ L)
      have hPL_not_unit : ¬ IsUnit P_L := by
        intro hu
        have h0 := Polynomial.natDegree_eq_zero_of_isUnit hu
        omega
      refine ⟨hPL_not_unit, ?_⟩
      intro f g hfg
      have hf_ne : f ≠ 0 := fun h => by rw [h, zero_mul] at hfg; exact hPL_mon.ne_zero hfg
      have hg_ne : g ≠ 0 := fun h => by rw [h, mul_zero] at hfg; exact hPL_mon.ne_zero hfg
      let cf : L := f.leadingCoeff
      have hcf_ne : cf ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hf_ne
      let f₁ : Polynomial L := Polynomial.C cf⁻¹ * f
      let g₁ : Polynomial L := Polynomial.C cf * g
      have hf₁_mon : f₁.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
          inv_mul_cancel₀ hcf_ne]
      have hf₁g₁ : f₁ * g₁ = P_L := by
        dsimp [f₁, g₁]
        calc (Polynomial.C cf⁻¹ * f) * (Polynomial.C cf * g)
            = (Polynomial.C cf⁻¹ * Polynomial.C cf) * (f * g) := by ring
          _ = Polynomial.C (cf⁻¹ * cf) * P_L := by rw [← Polynomial.C_mul, ← hfg]
          _ = P_L := by rw [inv_mul_cancel₀ hcf_ne, Polynomial.C_1, one_mul]
      have hg₁_mon : g₁.Monic :=
        Polynomial.Monic.of_mul_monic_left hf₁_mon (hf₁g₁ ▸ hPL_mon)

      let m_k : Polynomial k := m_θ.map (algebraMap k₀ k)
      have hmk_mon : m_k.Monic := hm_mon.map (algebraMap k₀ k)
      have hmk_prod : m_k = (m_k.roots.map fun α => Polynomial.X - Polynomial.C α).prod :=
        (IsAlgClosed.splits m_k).eq_prod_roots_of_monic hmk_mon
      have hPL_map_M : P_L.map ψ_M =
          (m_k.roots.map fun α => Polynomial.X - Polynomial.C (algebraMap k M α)).prod := by
        have h1 : P_L.map ψ_M = m_k.map (algebraMap k M) := by
          dsimp [P_L, m_k]
          rw [Polynomial.map_map, Polynomial.map_map, hψ_k₀]
        conv_lhs => rw [h1, hmk_prod]
        rw [Polynomial.map_multiset_prod, Multiset.map_map]
        congr 1
        refine Multiset.map_congr rfl fun α _ => ?_
        simp only [Function.comp_apply, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]

      have hPull_to_k₀ : ∀ q : Polynomial L, q.Monic → q ∣ P_L →
          ∃ q₀ : Polynomial k₀, q₀.map (algebraMap k₀ L) = q := by
        intro q hq_mon hq_dvd
        have hqM_dvd : q.map ψ_M ∣
            (m_k.roots.map fun α => Polynomial.X - Polynomial.C (algebraMap k M α)).prod := by
          rw [← hPL_map_M]
          exact Polynomial.map_dvd ψ_M hq_dvd
        obtain ⟨q_k, hqk⟩ := hLinFactorPull m_k.roots (q.map ψ_M) (hq_mon.map ψ_M) hqM_dvd
        have hcoeff_k₀ : ∀ n : ℕ, ∃ c₀ : k₀, algebraMap k₀ L c₀ = q.coeff n := by
          intro n
          have hce : ψ_M (q.coeff n) = algebraMap k M (q_k.coeff n) := by
            have h1 := congrArg (fun p => p.coeff n) hqk
            simpa only [Polynomial.coeff_map] using h1.symm
          let _ : Algebra k₀ M := ((algebraMap k M).comp (algebraMap k₀ k)).toAlgebra
          have : IsScalarTower k₀ k M := IsScalarTower.of_algebraMap_eq fun _ => rfl
          let ψ_alg : L →ₐ[k₀] M :=
            { toRingHom := ψ_M
              commutes' := fun c => RingHom.congr_fun hψ_k₀ c }
          have hc_int_k : IsIntegral k₀ (q_k.coeff n) :=
            isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic (q_k.coeff n))
          have hc_int_M : IsIntegral k₀ (ψ_alg (q.coeff n)) := by
            change IsIntegral k₀ (ψ_M (q.coeff n))
            rw [hce]
            exact IsIntegral.map (IsScalarTower.toAlgHom k₀ k M) hc_int_k
          have hc_int_L : IsIntegral k₀ (q.coeff n) :=
            (isIntegral_algHom_iff ψ_alg hψ_inj).mp hc_int_M
          exact hk₀_closed (q.coeff n) hc_int_L
        choose c₀ hc₀ using hcoeff_k₀
        refine ⟨∑ n ∈ q.support, Polynomial.monomial n (c₀ n), ?_⟩
        ext n
        rw [Polynomial.coeff_map, Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_monomial]
        by_cases hn : n ∈ q.support
        · rw [Finset.sum_eq_single n
            (fun m _ hmn => by simp [hmn])
            (fun hnot => absurd hn hnot)]
          simp [hc₀ n]
        · rw [Finset.sum_eq_zero fun m hm => by
            have hmn : m ≠ n := fun h => hn (h ▸ hm)
            simp [hmn]]
          rw [map_zero]
          exact (Polynomial.notMem_support_iff.mp hn).symm

      obtain ⟨f₀, hf₀⟩ := hPull_to_k₀ f₁ hf₁_mon ⟨g₁, hf₁g₁.symm⟩
      obtain ⟨g₀, hg₀⟩ := hPull_to_k₀ g₁ hg₁_mon ⟨f₁, by rw [mul_comm, hf₁g₁]⟩
      have hf₀g₀ : m_θ = f₀ * g₀ := by
        apply Polynomial.map_injective (algebraMap k₀ L) (RingHom.injective _)
        rw [Polynomial.map_mul, hf₀, hg₀, hf₁g₁]
      rcases hm_irr.isUnit_or_isUnit hf₀g₀ with hu_f₀ | hu_g₀
      · left
        have hu_f₁ : IsUnit f₁ := hf₀ ▸ hu_f₀.map (Polynomial.mapRingHom (algebraMap k₀ L))
        have hf_eq : f = Polynomial.C cf * f₁ := by
          dsimp [f₁]
          rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hcf_ne, Polynomial.C_1, one_mul]
        rw [hf_eq]
        exact (IsUnit.mk0 cf hcf_ne).map Polynomial.C |>.mul hu_f₁
      · right
        have hu_g₁ : IsUnit g₁ := hg₀ ▸ hu_g₀.map (Polynomial.mapRingHom (algebraMap k₀ L))
        have hg_eq : g = Polynomial.C cf⁻¹ * g₁ := by
          dsimp [g₁]
          rw [← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hcf_ne, Polynomial.C_1, one_mul]
        rw [hg_eq]
        exact (IsUnit.mk0 cf⁻¹ (inv_ne_zero hcf_ne)).map Polynomial.C |>.mul hu_g₁

    have hPowThetaLI : ∀ (k' : IntermediateField k₀ k) [FiniteDimensional k₀ k'] (θ : k')
        (d : ℕ) (hd : d = (minpoly k₀ θ).natDegree) (c : Fin d → L),
        (∑ j : Fin d, ψ_M (c j) * (algebraMap k M (θ : k)) ^ (j : ℕ)) = 0 →
        ∀ j : Fin d, c j = 0 := by
      intro k' _ θ d hd c hsum
      let _ : Algebra L M := ψ_M.toAlgebra
      let θ_M : M := algebraMap k M (θ : k)
      let m_θ : Polynomial k₀ := minpoly k₀ θ
      have hm_int : IsIntegral k₀ θ := Algebra.IsIntegral.isIntegral θ
      have hm_mon : m_θ.Monic := minpoly.monic hm_int
      let P_L : Polynomial L := m_θ.map (algebraMap k₀ L)
      have hPL_mon : P_L.Monic := hm_mon.map (algebraMap k₀ L)
      have hPL_irr : Irreducible P_L := hMinpolyIrrOverL k' θ
      have hPL_eval : Polynomial.aeval θ_M P_L = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        change Polynomial.eval₂ (ψ_M.comp (algebraMap k₀ L)) θ_M m_θ = 0
        rw [hψ_k₀]
        have h1 : Polynomial.eval₂ ((algebraMap k M).comp (algebraMap k₀ k)) θ_M m_θ =
            algebraMap k M (algebraMap k' k (Polynomial.aeval θ m_θ)) := by
          induction m_θ using Polynomial.induction_on' with
          | add p q hp hq => rw [Polynomial.eval₂_add, map_add, map_add, map_add, hp, hq]
          | monomial n a =>
            rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.eval₂_mul, Polynomial.eval₂_C,
              Polynomial.eval₂_pow, Polynomial.eval₂_X, map_mul, Polynomial.aeval_C, map_pow,
              Polynomial.aeval_X, map_mul, map_mul, map_pow, map_pow]
            rfl
        rw [h1, minpoly.aeval, map_zero, map_zero]
      have hmin_L : P_L = minpoly L θ_M :=
        minpoly.eq_of_irreducible_of_monic hPL_irr hPL_eval hPL_mon
      let Q : Polynomial L := ∑ j : Fin d, Polynomial.monomial (j : ℕ) (c j)
      have hQ_eval : Polynomial.aeval θ_M Q = 0 := by
        dsimp [Q]
        rw [map_sum]
        convert hsum using 1
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, Polynomial.aeval_C,
          map_pow, Polynomial.aeval_X]
        rfl
      have hQ_zero : Q = 0 := by
        by_contra hQ_ne
        have hdvd : minpoly L θ_M ∣ Q := minpoly.dvd L θ_M hQ_eval
        rw [← hmin_L] at hdvd
        have hdeg_le : P_L.natDegree ≤ Q.natDegree := Polynomial.natDegree_le_of_dvd hdvd hQ_ne
        have hPL_deg : P_L.natDegree = d := by
          rw [hm_mon.natDegree_map (algebraMap k₀ L), hd]
        have hd_pos : 0 < d := by rw [hd]; exact minpoly.natDegree_pos hm_int
        have hQ_deg_lt : Q.natDegree < d := by
          refine (Polynomial.natDegree_lt_iff_degree_lt hQ_ne).mpr ?_
          rw [Polynomial.degree_lt_iff_coeff_zero]
          intro m hm
          dsimp [Q]
          rw [Polynomial.finsetSum_coeff]
          refine Finset.sum_eq_zero fun j _ => ?_
          rw [Polynomial.coeff_monomial]
          have hjm : (j : ℕ) ≠ m := by omega
          simp [hjm]
        omega
      intro j
      have hcj : Q.coeff (j : ℕ) = 0 := by rw [hQ_zero, Polynomial.coeff_zero]
      dsimp [Q] at hcj
      rw [Polynomial.finsetSum_coeff] at hcj
      rw [Finset.sum_eq_single j
        (fun j' _ hjj' => by
          rw [Polynomial.coeff_monomial]
          have hne : (j' : ℕ) ≠ (j : ℕ) := fun h => hjj' (Fin.ext h)
          simp [hne])
        (fun hnot => absurd (Finset.mem_univ j) hnot)] at hcj
      simpa [Polynomial.coeff_monomial] using hcj

    have hLinIndep : ∀ {ι : Type u} (v : ι → L),
        LinearIndependent (RatFunc k₀) v → LinearIndependent (RatFunc k) (ψ_M ∘ v) := by
      intro ι v hv
      rw [linearIndependent_iff']
      intro s g hsum i hi
      obtain ⟨d_den, hd_den⟩ :=
        IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial k)) s g
      choose p hp using fun u : s => hd_den u.1 u.2
      have hd_den_ne : (d_den : Polynomial k) ≠ 0 := nonZeroDivisors.ne_zero d_den.2
      have hsum_poly : ∑ u : s, algebraMap (Polynomial k) M (p u) * ψ_M (v u.1) = 0 := by
        calc ∑ u : s, algebraMap (Polynomial k) M (p u) * ψ_M (v u.1)
            = ∑ u : s, algebraMap (RatFunc k) M ((d_den : Polynomial k) • g u.1) * ψ_M (v u.1) := by
              refine Finset.sum_congr rfl fun u _ => ?_
              rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M, hp u]
          _ = algebraMap (Polynomial k) M (d_den : Polynomial k) *
                (∑ u ∈ s, g u • ψ_M (v u)) := by
              rw [← Finset.sum_attach s (fun u => g u • ψ_M (v u)), Finset.mul_sum]
              refine Finset.sum_congr rfl fun u _ => ?_
              rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc,
                IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M]
          _ = 0 := by
              change _ * (∑ u ∈ s, g u • (ψ_M ∘ v) u) = 0
              rw [hsum, mul_zero]

      let C_fin : Finset k :=
        s.attach.biUnion fun u => (p u).support.image fun n => (p u).coeff n
      let k' : IntermediateField k₀ k := IntermediateField.adjoin k₀ (C_fin : Set k)
      have : Finite (C_fin : Set k) := Finset.finite_toSet C_fin
      have : FiniteDimensional k₀ k' :=
        IntermediateField.finiteDimensional_adjoin fun c _ =>
          isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic c)
      obtain ⟨θ, hθ_top⟩ := Field.exists_primitive_element_of_finite_bot k₀ k'
      let pb₀ := IntermediateField.adjoin.powerBasis (K := k₀) (Algebra.IsIntegral.isIntegral (R := k₀) θ)
      let pb : PowerBasis k₀ k' :=
        pb₀.map ((IntermediateField.equivOfEq hθ_top).trans IntermediateField.topEquiv)
      have hpb_gen : pb.gen = θ := rfl
      let d := pb.dim
      have hd_deg : d = (minpoly k₀ θ).natDegree := by
        dsimp [d, pb, pb₀]
        rw [PowerBasis.map_dim, IntermediateField.adjoin.powerBasis_dim]

      have hp_coeff_mem : ∀ (u : s) (n : ℕ), (p u).coeff n ∈ k' := by
        intro u n
        by_cases hn : n ∈ (p u).support
        · apply IntermediateField.subset_adjoin
          simp only [C_fin, Finset.mem_coe, Finset.mem_biUnion, Finset.mem_attach, true_and,
            Finset.mem_image]
          exact ⟨u, n, hn, rfl⟩
        · rw [Polynomial.notMem_support_iff.mp hn]
          exact k'.zero_mem

      let coeff_k' : s → ℕ → k' := fun u n => ⟨(p u).coeff n, hp_coeff_mem u n⟩
      let q : s → Fin d → Polynomial k₀ := fun u j =>
        ∑ n ∈ (p u).support, Polynomial.monomial n (pb.basis.repr (coeff_k' u n) j)
      have hp_expand : ∀ u : s,
          algebraMap (Polynomial k) M (p u) =
            ∑ j : Fin d, ψ_M (algebraMap (Polynomial k₀) L (q u j)) *
              (algebraMap k M (θ : k)) ^ (j : ℕ) := by
        intro u
        have hpu_sum : p u = ∑ n ∈ (p u).support, Polynomial.monomial n ((p u).coeff n) :=
          Polynomial.as_sum_support (p u)
        calc algebraMap (Polynomial k) M (p u)
            = ∑ n ∈ (p u).support,
                algebraMap k M ((p u).coeff n) *
                  (algebraMap (Polynomial k) M Polynomial.X) ^ n := by
              conv_lhs => rw [hpu_sum]
              rw [map_sum]
              refine Finset.sum_congr rfl fun n _ => ?_
              rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
              congr 1
              exact (IsScalarTower.algebraMap_apply k (Polynomial k) M ((p u).coeff n)).symm
          _ = ∑ n ∈ (p u).support,
                (∑ j : Fin d,
                  ψ_M (algebraMap k₀ L (pb.basis.repr (coeff_k' u n) j)) *
                    (algebraMap k M (θ : k)) ^ (j : ℕ)) *
                  (ψ_M (algebraMap (Polynomial k₀) L Polynomial.X)) ^ n := by
              refine Finset.sum_congr rfl fun n _ => ?_
              congr 1
              · have hrepr : coeff_k' u n =
                    ∑ j : Fin d, pb.basis.repr (coeff_k' u n) j • pb.basis j :=
                  (pb.basis.sum_repr (coeff_k' u n)).symm
                have hval_k : ((p u).coeff n : k) =
                    ∑ j : Fin d, algebraMap k₀ k (pb.basis.repr (coeff_k' u n) j) * (θ : k) ^ (j : ℕ) := by
                  change ((coeff_k' u n : k') : k) = _
                  conv_lhs => rw [hrepr]
                  push_cast
                  refine Finset.sum_congr rfl fun j _ => ?_
                  rw [pb.basis_eq_pow j, hpb_gen, Algebra.smul_def]
                  push_cast
                  rfl
                rw [hval_k, map_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [map_mul, map_pow]
                congr 1
                exact (RingHom.congr_fun hψ_k₀ _).symm
              · rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M,
                  IsScalarTower.algebraMap_apply (Polynomial k₀) (RatFunc k₀) L,
                  RatFunc.algebraMap_X, RatFunc.algebraMap_X, hψ_X]
          _ = ∑ j : Fin d,
                ψ_M (algebraMap (Polynomial k₀) L (q u j)) *
                  (algebraMap k M (θ : k)) ^ (j : ℕ) := by
              have hdist : (∑ n ∈ (p u).support,
                    (∑ j : Fin d,
                      ψ_M (algebraMap k₀ L (pb.basis.repr (coeff_k' u n) j)) *
                        (algebraMap k M (θ : k)) ^ (j : ℕ)) *
                      (ψ_M (algebraMap (Polynomial k₀) L Polynomial.X)) ^ n) =
                  ∑ n ∈ (p u).support, ∑ j : Fin d,
                    (ψ_M (algebraMap k₀ L (pb.basis.repr (coeff_k' u n) j)) *
                      (algebraMap k M (θ : k)) ^ (j : ℕ)) *
                      (ψ_M (algebraMap (Polynomial k₀) L Polynomial.X)) ^ n :=
                Finset.sum_congr rfl fun n _ => Finset.sum_mul _ _ _
              rw [hdist, Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => ?_
              dsimp [q]
              rw [map_sum, map_sum, Finset.sum_mul]
              refine Finset.sum_congr rfl fun n _ => ?_
              rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
              have hC0 : algebraMap (Polynomial k₀) L (Polynomial.C (pb.basis.repr (coeff_k' u n) j)) =
                  algebraMap k₀ L (pb.basis.repr (coeff_k' u n) j) :=
                (IsScalarTower.algebraMap_apply k₀ (Polynomial k₀) L _).symm
              rw [hC0]
              ring

      have hsum_theta : ∑ j : Fin d,
          ψ_M (∑ u : s, algebraMap (Polynomial k₀) L (q u j) * v u.1) *
            (algebraMap k M (θ : k)) ^ (j : ℕ) = 0 := by
        calc ∑ j : Fin d,
              ψ_M (∑ u : s, algebraMap (Polynomial k₀) L (q u j) * v u.1) *
                (algebraMap k M (θ : k)) ^ (j : ℕ)
            = ∑ u : s, algebraMap (Polynomial k) M (p u) * ψ_M (v u.1) := by
              have hdist : (∑ u : s, algebraMap (Polynomial k) M (p u) * ψ_M (v u.1)) =
                  ∑ u : s, ∑ j : Fin d,
                    (ψ_M (algebraMap (Polynomial k₀) L (q u j)) *
                      (algebraMap k M (θ : k)) ^ (j : ℕ)) * ψ_M (v u.1) := by
                refine Finset.sum_congr rfl fun u _ => ?_
                rw [hp_expand u, Finset.sum_mul]
              rw [hdist, Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [map_sum, Finset.sum_mul]
              refine Finset.sum_congr rfl fun u _ => ?_
              rw [map_mul]
              ring
          _ = 0 := hsum_poly

      have hq_sum_zero := hPowThetaLI k' θ d hd_deg
        (fun j => ∑ u : s, algebraMap (Polynomial k₀) L (q u j) * v u.1) hsum_theta
      have hv_s : LinearIndependent (RatFunc k₀) (fun u : s => v u.1) :=
        hv.comp Subtype.val Subtype.val_injective
      have hq_zero : ∀ j : Fin d, q ⟨i, hi⟩ j = 0 := by
        intro j
        have hj0 := hq_sum_zero j
        have hj0' : ∑ u : s, (algebraMap (Polynomial k₀) (RatFunc k₀) (q u j)) • v u.1 = 0 := by
          convert hj0 using 1
          refine Finset.sum_congr rfl fun u _ => ?_
          rw [Algebra.smul_def, IsScalarTower.algebraMap_apply (Polynomial k₀) (RatFunc k₀) L]
        have hRF0 : algebraMap (Polynomial k₀) (RatFunc k₀) (q ⟨i, hi⟩ j) = 0 :=
          Fintype.linearIndependent_iff.mp hv_s
            (fun u => algebraMap (Polynomial k₀) (RatFunc k₀) (q u j)) hj0' ⟨i, hi⟩
        exact IsFractionRing.injective (Polynomial k₀) (RatFunc k₀) (hRF0.trans (map_zero _).symm)

      have hpi_zero : p ⟨i, hi⟩ = 0 := by
        have hM0 : algebraMap (Polynomial k) M (p ⟨i, hi⟩) = 0 := by
          rw [hp_expand ⟨i, hi⟩]
          refine Finset.sum_eq_zero fun j _ => ?_
          rw [hq_zero j, map_zero, map_zero, zero_mul]
        have hInj_Pk_M : Function.Injective (algebraMap (Polynomial k) M) := by
          have hcomp : algebraMap (Polynomial k) M =
              (algebraMap (RatFunc k) M).comp (algebraMap (Polynomial k) (RatFunc k)) :=
            RingHom.ext fun q => IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M q
          rw [hcomp]
          exact (RingHom.injective (algebraMap (RatFunc k) M)).comp
            (IsFractionRing.injective (Polynomial k) (RatFunc k))
        exact hInj_Pk_M (hM0.trans (map_zero _).symm)
      have hdg0 : (d_den : Polynomial k) • g i = 0 := by
        rw [← hp ⟨i, hi⟩, hpi_zero, map_zero]
      rw [Algebra.smul_def] at hdg0
      exact (mul_eq_zero.mp hdg0).resolve_left
        ((map_ne_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr hd_den_ne)

    let bL_u : Module.Basis (ULift.{u} (Fin n_L)) (RatFunc k₀) L := bL.reindex Equiv.ulift.symm
    have hSpan_bLu : Submodule.span (RatFunc k) (Set.range (ψ_M ∘ bL_u)) = ⊤ := by
      have hrng : Set.range (ψ_M ∘ bL_u) = Set.range (ψ_M ∘ bL) := by
        ext x
        constructor
        · rintro ⟨⟨i⟩, rfl⟩
          exact ⟨i, by simp [bL_u]⟩
        · rintro ⟨i, rfl⟩
          exact ⟨ULift.up i, by simp [bL_u]⟩
      rw [hrng, hSpan_bL]
    let bM_u : Module.Basis (ULift.{u} (Fin n_L)) (RatFunc k) M :=
      Module.Basis.mk (hLinIndep bL_u bL_u.linearIndependent) (by rw [hSpan_bLu])
    let bM : Module.Basis (Fin n_L) (RatFunc k) M := bM_u.reindex Equiv.ulift
    have hbM_apply : ∀ i : Fin n_L, bM i = ψ_M (bL i) := by
      intro i
      simp [bM, bM_u, bL_u]
    have hfinrank_eq : Module.finrank (RatFunc k) M = Module.finrank (RatFunc k₀) L := by
      rw [Module.finrank_eq_card_basis bM, Fintype.card_fin]
    have hGal_pres_L : ∀ (γ : M →ₐ[RatFunc k] M) (y : L), ∃ x : L, ψ_M x = γ (ψ_M y) := by
      intro γ y
      let p : Polynomial (RatFunc k₀) := minpoly (RatFunc k₀) y
      have hp_mon : p.Monic := minpoly.monic (Algebra.IsIntegral.isIntegral y)
      have hp_sp_L : (p.map (algebraMap (RatFunc k₀) L)).Splits :=
        Normal.splits inferInstance y
      let p_M : Polynomial M := (p.map j_K).map (algebraMap (RatFunc k) M)
      have hpM_eq : p_M = (p.map (algebraMap (RatFunc k₀) L)).map ψ_M := by
        dsimp [p_M]
        rw [Polynomial.map_map, Polynomial.map_map]
        congr 1
        refine RingHom.ext fun q => (hψ_RF q).symm
      have hpL_prod : p.map (algebraMap (RatFunc k₀) L) =
          ((p.map (algebraMap (RatFunc k₀) L)).roots.map fun r =>
            Polynomial.X - Polynomial.C r).prod :=
        hp_sp_L.eq_prod_roots_of_monic (hp_mon.map _)
      have hγ_eval : Polynomial.eval (γ (ψ_M y)) p_M = 0 := by
        have hy_eval : Polynomial.eval (ψ_M y) p_M = 0 := by
          rw [hpM_eq, Polynomial.eval_map, Polynomial.eval₂_map]
          have hhom := Polynomial.hom_eval₂ p (algebraMap (RatFunc k₀) L) ψ_M y
          rw [← hhom, ← Polynomial.aeval_def, minpoly.aeval, map_zero]
        have h1 : Polynomial.eval (γ (ψ_M y)) p_M = γ (Polynomial.eval (ψ_M y) p_M) := by
          dsimp [p_M]
          rw [Polynomial.eval_map, Polynomial.eval_map, ← Polynomial.aeval_def,
            ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply]
        rw [h1, hy_eval, map_zero]
      rw [hpM_eq, hpL_prod, Polynomial.map_multiset_prod, Multiset.map_map,
        Polynomial.eval_multiset_prod] at hγ_eval
      have h0_mem := Multiset.prod_eq_zero_iff.mp hγ_eval
      rw [Multiset.mem_map] at h0_mem
      rcases h0_mem with ⟨z, hz_mem, hz0⟩
      simp only [Multiset.mem_map, Function.comp_apply] at hz_mem
      rcases hz_mem with ⟨r, _, rfl⟩
      simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at hz0
      exact ⟨r, (sub_eq_zero.mp hz0).symm⟩
    let f_pull : (M →ₐ[RatFunc k] M) → L → L := fun γ y => Classical.choose (hGal_pres_L γ y)
    have hf_pull : ∀ (γ : M →ₐ[RatFunc k] M) (y : L), ψ_M (f_pull γ y) = γ (ψ_M y) := fun γ y =>
      Classical.choose_spec (hGal_pres_L γ y)
    let pullAlg : (M →ₐ[RatFunc k] M) → (L →ₐ[RatFunc k₀] L) := fun γ =>
      { toFun := f_pull γ
        map_one' := hψ_inj (by rw [hf_pull, map_one, map_one])
        map_mul' := fun x y => hψ_inj (by rw [map_mul, hf_pull, hf_pull, hf_pull, map_mul, map_mul])
        map_zero' := hψ_inj (by rw [hf_pull, map_zero, map_zero])
        map_add' := fun x y => hψ_inj (by rw [map_add, hf_pull, hf_pull, hf_pull, map_add, map_add])
        commutes' := fun q => hψ_inj (by rw [hf_pull, hψ_RF q, γ.commutes (j_K q)]) }
    have hpullAlg_spec : ∀ (γ : M →ₐ[RatFunc k] M) (y : L),
        ψ_M (pullAlg γ y) = γ (ψ_M y) := hf_pull

    let res_M_hom : (M ≃ₐ[RatFunc k] M) →* (L ≃ₐ[RatFunc k₀] L) :=
      { toFun := fun γ => AlgEquiv.ofAlgHom (pullAlg γ.toAlgHom) (pullAlg γ.symm.toAlgHom)
          (AlgHom.ext fun y => hψ_inj (by simp [hpullAlg_spec]))
          (AlgHom.ext fun y => hψ_inj (by simp [hpullAlg_spec]))
        map_one' := AlgEquiv.ext fun y => hψ_inj (by
          change ψ_M (pullAlg (1 : M ≃ₐ[RatFunc k] M).toAlgHom y) = ψ_M y
          rw [hpullAlg_spec]
          rfl)
        map_mul' := fun γ₁ γ₂ => AlgEquiv.ext fun y => hψ_inj (by
          change ψ_M (pullAlg (γ₁ * γ₂).toAlgHom y) =
            ψ_M (pullAlg γ₁.toAlgHom (pullAlg γ₂.toAlgHom y))
          rw [hpullAlg_spec, hpullAlg_spec, hpullAlg_spec]
          rfl) }
    have hres_M_apply : ∀ (γ : M ≃ₐ[RatFunc k] M) (y : L),
        γ (ψ_M y) = ψ_M (res_M_hom γ y) := fun γ y =>
      (hpullAlg_spec γ.toAlgHom y).symm
    have hres_M_inj : Function.Injective res_M_hom := by
      intro γ₁ γ₂ h12
      refine AlgEquiv.ext fun z => ?_
      have hz : z = ∑ i : Fin n_L, bM.repr z i • bM i := (bM.sum_repr z).symm
      rw [hz, map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hbM_apply, Algebra.smul_def, map_mul, map_mul, γ₁.commutes, γ₂.commutes]
      congr 1
      rw [hres_M_apply, hres_M_apply, h12]
    have hcard_gal_eq : Nat.card (M ≃ₐ[RatFunc k] M) = Nat.card (L ≃ₐ[RatFunc k₀] L) := by
      rw [IsGalois.card_aut_eq_finrank, IsGalois.card_aut_eq_finrank, hfinrank_eq]
    have hres_M_bij : Function.Bijective res_M_hom :=
      (Nat.bijective_iff_injective_and_card res_M_hom).mpr ⟨hres_M_inj, hcard_gal_eq⟩
    let res_M : (M ≃ₐ[RatFunc k] M) ≃* (L ≃ₐ[RatFunc k₀] L) :=
      MulEquiv.ofBijective res_M_hom hres_M_bij

    have hIntCl : ∀ R_sub : Subalgebra k₀ L,
        (integralClosure ↥(Algebra.adjoin k (ψ_M '' (R_sub : Set L))) M : Set M) ⊆
          (Algebra.adjoin k (ψ_M '' (integralClosure ↥R_sub L : Set L)) : Set M) := by
      intro R_sub z hz
      let U : Set M := ψ_M '' (R_sub : Set L)
      let A_U : Subalgebra k M := Algebra.adjoin k U
      let f : Fin n_L → RatFunc k := fun r => bM.repr z r
      have hz_bM : z = ∑ r : Fin n_L, f r • ψ_M (bL r) := by
        conv_lhs => rw [← bM.sum_repr z]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [hbM_apply]
      obtain ⟨d_z, hd_z⟩ :=
        IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial k)) Finset.univ f
      choose p_z hp_z using fun r : Fin n_L => hd_z r (Finset.mem_univ r)
      have hd_z_ne : (d_z : Polynomial k) ≠ 0 := nonZeroDivisors.ne_zero d_z.2
      let S₁ : Finset k :=
        ((d_z : Polynomial k).support.image fun n => (d_z : Polynomial k).coeff n) ∪
          (Finset.univ.biUnion fun r : Fin n_L => (p_z r).support.image fun n => (p_z r).coeff n)

      have hFinGen_AU : ∀ a : M, a ∈ A_U →
          ∃ C_a : Finset k, a ∈ Subring.closure ((algebraMap k M '' (C_a : Set k)) ∪ U) := by
        intro a ha
        induction ha using Algebra.adjoin_induction with
        | mem x hx =>
          exact ⟨∅, Subring.subset_closure (Or.inr hx)⟩
        | algebraMap c =>
          exact ⟨{c}, Subring.subset_closure (Or.inl ⟨c, by simp, rfl⟩)⟩
        | add x y _ _ ihx ihy =>
          rcases ihx with ⟨Cx, hx'⟩
          rcases ihy with ⟨Cy, hy'⟩
          refine ⟨Cx ∪ Cy, Subring.add_mem _ (Subring.closure_mono ?_ hx') (Subring.closure_mono ?_ hy')⟩
          · exact Set.union_subset_union_left U (Set.image_mono (by simp))
          · exact Set.union_subset_union_left U (Set.image_mono (by simp))
        | mul x y _ _ ihx ihy =>
          rcases ihx with ⟨Cx, hx'⟩
          rcases ihy with ⟨Cy, hy'⟩
          refine ⟨Cx ∪ Cy, Subring.mul_mem _ (Subring.closure_mono ?_ hx') (Subring.closure_mono ?_ hy')⟩
          · exact Set.union_subset_union_left U (Set.image_mono (by simp))
          · exact Set.union_subset_union_left U (Set.image_mono (by simp))
      obtain ⟨P_int, hPint_mon, hPint_eval⟩ := hz
      choose C_coeff hC_coeff using fun t : ℕ => hFinGen_AU (P_int.coeff t).1 (P_int.coeff t).2
      let S₂ : Finset k := P_int.support.biUnion C_coeff

      let S_all : Finset k := S₁ ∪ S₂
      let k' : IntermediateField k₀ k := IntermediateField.adjoin k₀ (S_all : Set k)
      have : Finite (S_all : Set k) := Finset.finite_toSet S_all
      have : FiniteDimensional k₀ k' :=
        IntermediateField.finiteDimensional_adjoin fun c _ =>
          isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic c)
      have : Finite k' := Module.finite_of_finite k₀
      obtain ⟨θ, hθ_top⟩ := Field.exists_primitive_element_of_finite_bot k₀ k'
      let pb₀ := IntermediateField.adjoin.powerBasis (K := k₀) (Algebra.IsIntegral.isIntegral (R := k₀) θ)
      let pb : PowerBasis k₀ k' :=
        pb₀.map ((IntermediateField.equivOfEq hθ_top).trans IntermediateField.topEquiv)
      have hpb_gen : pb.gen = θ := rfl
      let d := pb.dim
      have hd_pos : 0 < d := pb.dim_pos
      have hd_finrank : d = Module.finrank k₀ k' := pb.finrank.symm

      let _ : Algebra (RatFunc k₀) (RatFunc k) := j_K.toAlgebra
      let θ_K : RatFunc k := algebraMap k (RatFunc k) (θ : k)
      let V_K : Submodule (RatFunc k₀) (RatFunc k) :=
        Submodule.span (RatFunc k₀) (Set.range fun j : Fin d => θ_K ^ (j : ℕ))
      have h_k'_mem_VK : ∀ c : k', algebraMap k (RatFunc k) (c : k) ∈ V_K := by
        intro c
        have hc : c = ∑ j : Fin d, pb.basis.repr c j • pb.basis j := (pb.basis.sum_repr c).symm
        have hval : (c : k) = ∑ j : Fin d, algebraMap k₀ k (pb.basis.repr c j) * (θ : k) ^ (j : ℕ) := by
          conv_lhs => rw [hc]
          push_cast
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [pb.basis_eq_pow j, hpb_gen, Algebra.smul_def]
          push_cast
          rfl
        rw [hval, map_sum]
        refine Submodule.sum_mem V_K fun j _ => ?_
        rw [map_mul, map_pow, ← hj_K_k₀]
        exact V_K.smul_mem (algebraMap k₀ (RatFunc k₀) (pb.basis.repr c j))
          (Submodule.subset_span ⟨j, rfl⟩)
      have h1_VK : (1 : RatFunc k) ∈ V_K := by
        simpa using h_k'_mem_VK 1
      have hmul_VK : ∀ x ∈ V_K, ∀ y ∈ V_K, x * y ∈ V_K := by
        intro x hx
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
        · rintro _ ⟨j₁, rfl⟩ y hy
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
          · rintro _ ⟨j₂, rfl⟩
            have hpow : θ_K ^ (j₁ : ℕ) * θ_K ^ (j₂ : ℕ) =
                algebraMap k (RatFunc k) (((θ ^ (j₁ : ℕ) * θ ^ (j₂ : ℕ) : k') : k)) := by
              dsimp only [θ_K]
              rw [← map_pow, ← map_pow, ← map_mul]
              rfl
            rw [hpow]
            exact h_k'_mem_VK _
          · rw [mul_zero]; exact V_K.zero_mem
          · intro u v _ _ hu hv; rw [mul_add]; exact V_K.add_mem hu hv
          · intro c u _ hu; rw [mul_smul_comm]; exact V_K.smul_mem c hu
        · intro y _; rw [zero_mul]; exact V_K.zero_mem
        · intro u v _ _ hu hv y hy; rw [add_mul]; exact V_K.add_mem (hu y hy) (hv y hy)
        · intro c u _ hu y hy; rw [smul_mul_assoc]; exact V_K.smul_mem c (hu y hy)
      let A_K : Subalgebra (RatFunc k₀) (RatFunc k) :=
        { V_K with
          one_mem' := h1_VK
          mul_mem' := fun {x y} hx hy => hmul_VK x hx y hy
          algebraMap_mem' := fun q => by
            rw [← mul_one (algebraMap (RatFunc k₀) (RatFunc k) q), ← Algebra.smul_def]
            exact V_K.smul_mem q h1_VK }
      have : Module.Finite (RatFunc k₀) ↥A_K := by
        have htop : Submodule.span (RatFunc k₀)
            (Set.range fun j : Fin d => (⟨θ_K ^ (j : ℕ), Submodule.subset_span ⟨j, rfl⟩⟩ : ↥A_K)) = ⊤ := by
          rw [eq_top_iff]
          rintro ⟨x, hx⟩ _
          change x ∈ V_K at hx
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
          · rintro _ ⟨j, rfl⟩
            exact Submodule.subset_span ⟨j, rfl⟩
          · exact Submodule.zero_mem _
          · intro u v hu hv ihu ihv
            exact Submodule.add_mem _ ihu ihv
          · intro c u hu ihu
            exact Submodule.smul_mem _ c ihu
        exact Module.Finite.of_surjective
          (Finsupp.linearCombination (RatFunc k₀)
            (fun j : Fin d => (⟨θ_K ^ (j : ℕ), Submodule.subset_span ⟨j, rfl⟩⟩ : ↥A_K)))
          (LinearMap.range_eq_top.mp (by rw [Finsupp.range_linearCombination, htop]))

      have hPoly_mem_AK : ∀ Q : Polynomial k,
          (∀ n ∈ Q.support, Q.coeff n ∈ k') →
          algebraMap (Polynomial k) (RatFunc k) Q ∈ A_K := by
        intro Q hQ
        have hQ_sum : Q = ∑ n ∈ Q.support, Polynomial.monomial n (Q.coeff n) :=
          Polynomial.as_sum_support Q
        rw [hQ_sum, map_sum]
        refine A_K.sum_mem fun n hn => ?_
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
          RatFunc.algebraMap_C, RatFunc.algebraMap_X, ← hj_K_X]
        exact A_K.mul_mem (h_k'_mem_VK ⟨Q.coeff n, hQ n hn⟩)
          (A_K.pow_mem (A_K.algebraMap_mem RatFunc.X) n)

      have hdz_AK : algebraMap (Polynomial k) (RatFunc k) (d_z : Polynomial k) ∈ A_K := by
        refine hPoly_mem_AK _ fun n hn => IntermediateField.subset_adjoin k₀ (S_all : Set k) ?_
        simp only [S_all, S₁, Finset.mem_coe, Finset.mem_union, Finset.mem_image]
        exact Or.inl (Or.inl ⟨n, hn, rfl⟩)
      have hpz_AK : ∀ r : Fin n_L, algebraMap (Polynomial k) (RatFunc k) (p_z r) ∈ A_K := by
        intro r
        refine hPoly_mem_AK _ fun n hn => IntermediateField.subset_adjoin k₀ (S_all : Set k) ?_
        simp only [S_all, S₁, Finset.mem_coe, Finset.mem_union, Finset.mem_biUnion,
          Finset.mem_univ, true_and, Finset.mem_image]
        exact Or.inl (Or.inr ⟨r, n, hn, rfl⟩)
      have hfr_VK : ∀ r : Fin n_L, f r ∈ V_K := by
        intro r
        have hdz_RF_ne : algebraMap (Polynomial k) (RatFunc k) (d_z : Polynomial k) ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr hd_z_ne
        have hfr_eq : f r = (algebraMap (Polynomial k) (RatFunc k) (d_z : Polynomial k))⁻¹ *
            algebraMap (Polynomial k) (RatFunc k) (p_z r) := by
          have h1 := hp_z r
          rw [Algebra.smul_def] at h1
          rw [h1, inv_mul_cancel_left₀ hdz_RF_ne]
        rw [hfr_eq]
        exact A_K.mul_mem (hSubalgInv A_K hdz_AK hdz_RF_ne) (hpz_AK r)

      have hfr_coord : ∀ r : Fin n_L, ∃ c_r : Fin d → RatFunc k₀,
          f r = ∑ j : Fin d, j_K (c_r j) * θ_K ^ (j : ℕ) := by
        intro r
        obtain ⟨c_fn, hc_fn⟩ := Submodule.mem_span_range_iff_exists_fun (RatFunc k₀) |>.mp (hfr_VK r)
        exact ⟨c_fn, hc_fn.symm⟩
      choose c_coord hc_coord using hfr_coord
      let y : Fin d → L := fun j => ∑ r : Fin n_L, c_coord r j • bL r
      have hz_expand : z = ∑ j : Fin d, algebraMap k M ((pb.basis j : k') : k) * ψ_M (y j) := by
        calc z = ∑ r : Fin n_L, f r • ψ_M (bL r) := hz_bM
          _ = ∑ r : Fin n_L,
                (∑ j : Fin d, algebraMap (RatFunc k) M (j_K (c_coord r j)) *
                  (algebraMap k M (θ : k)) ^ (j : ℕ)) * ψ_M (bL r) := by
              refine Finset.sum_congr rfl fun r _ => ?_
              rw [Algebra.smul_def, hc_coord r, map_sum]
              congr 1
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [map_mul, map_pow]
              congr 2
              exact (IsScalarTower.algebraMap_apply k (RatFunc k) M (θ : k)).symm
          _ = ∑ j : Fin d, algebraMap k M ((pb.basis j : k') : k) * ψ_M (y j) := by
              have hdist : (∑ r : Fin n_L,
                    (∑ j : Fin d, algebraMap (RatFunc k) M (j_K (c_coord r j)) *
                      (algebraMap k M (θ : k)) ^ (j : ℕ)) * ψ_M (bL r)) =
                  ∑ r : Fin n_L, ∑ j : Fin d,
                    (algebraMap (RatFunc k) M (j_K (c_coord r j)) *
                      (algebraMap k M (θ : k)) ^ (j : ℕ)) * ψ_M (bL r) :=
                Finset.sum_congr rfl fun r _ => Finset.sum_mul _ _ _
              rw [hdist, Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => ?_
              dsimp [y]
              have hbj : ((pb.basis j : k') : k) = (θ : k) ^ (j : ℕ) := by
                rw [pb.basis_eq_pow j, hpb_gen]
                rfl
              rw [hbj, map_pow, map_sum, Finset.mul_sum]
              refine Finset.sum_congr rfl fun r _ => ?_
              rw [Algebra.smul_def, map_mul, hψ_RF]
              ring

      let _ : Algebra L M := ψ_M.toAlgebra
      have : Module.IsTorsionFree L M := Module.isTorsionFree_iff_algebraMap_injective.mpr hψ_inj
      let θ_M : M := algebraMap k M (θ : k)
      let m_θ : Polynomial k₀ := minpoly k₀ θ
      have hm_int : IsIntegral k₀ θ := Algebra.IsIntegral.isIntegral θ
      have hm_mon : m_θ.Monic := minpoly.monic hm_int
      let P_L : Polynomial L := m_θ.map (algebraMap k₀ L)
      have hPL_mon : P_L.Monic := hm_mon.map (algebraMap k₀ L)
      have hPL_irr : Irreducible P_L := hMinpolyIrrOverL k' θ
      have hEval_k'_mθ : ∀ α : k', Polynomial.aeval α m_θ = 0 →
          Polynomial.aeval (algebraMap k M (α : k)) P_L = 0 := by
        intro α hα
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        change Polynomial.eval₂ (ψ_M.comp (algebraMap k₀ L)) (algebraMap k M (α : k)) m_θ = 0
        rw [hψ_k₀]
        have h1 : Polynomial.eval₂ ((algebraMap k M).comp (algebraMap k₀ k))
              (algebraMap k M (α : k)) m_θ =
            algebraMap k M (algebraMap k' k (Polynomial.aeval α m_θ)) := by
          induction m_θ using Polynomial.induction_on' with
          | add p q hp hq => rw [Polynomial.eval₂_add, map_add, map_add, map_add, hp, hq]
          | monomial n a =>
            rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.eval₂_mul, Polynomial.eval₂_C,
              Polynomial.eval₂_pow, Polynomial.eval₂_X, map_mul, Polynomial.aeval_C, map_pow,
              Polynomial.aeval_X, map_mul, map_mul, map_pow, map_pow]
            rfl
        rw [h1, hα, map_zero, map_zero]

      have hPL_eval : Polynomial.aeval θ_M P_L = 0 := hEval_k'_mθ θ (minpoly.aeval k₀ θ)
      have hθ_M_int : IsIntegral L θ_M := ⟨P_L, hPL_mon, hPL_eval⟩
      let M_θ : Subalgebra L M := Algebra.adjoin L ({θ_M} : Set M)
      let pb_L : PowerBasis L ↥M_θ := Algebra.adjoin.powerBasis' hθ_M_int
      have hpbL_gen_val : (pb_L.gen : M) = algebraMap k M (θ : k) :=
        congrArg Subtype.val (Algebra.adjoin.powerBasis'_gen hθ_M_int)
      have hmin_pbL : minpoly L pb_L.gen = P_L := by
        have h1 : minpoly L (algebraMap ↥M_θ M pb_L.gen) = minpoly L pb_L.gen :=
          minpoly.algebraMap_eq Subtype.val_injective pb_L.gen
        change minpoly L (pb_L.gen : M) = minpoly L pb_L.gen at h1
        rw [← h1, hpbL_gen_val]
        exact (minpoly.eq_of_irreducible_of_monic hPL_irr hPL_eval hPL_mon).symm

      have hk'_aeval : ∀ c : k', ∃ Q_c : Polynomial k₀, Polynomial.aeval θ Q_c = c := by
        intro c
        have hc : c = ∑ j : Fin d, pb.basis.repr c j • pb.basis j := (pb.basis.sum_repr c).symm
        refine ⟨∑ j : Fin d, Polynomial.monomial (j : ℕ) (pb.basis.repr c j), ?_⟩
        rw [map_sum]
        conv_rhs => rw [hc]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, Polynomial.aeval_C, map_pow,
          Polynomial.aeval_X, pb.basis_eq_pow j, hpb_gen, Algebra.smul_def]
      have hk'_aeval_M : ∀ (Q_c : Polynomial k₀) (α : k'),
          Polynomial.aeval (algebraMap k M (α : k)) (Q_c.map (algebraMap k₀ L)) =
            algebraMap k M ((Polynomial.aeval α Q_c : k') : k) := by
        intro Q_c α
        induction Q_c using Polynomial.induction_on' with
        | add p q hp hq =>
          rw [Polynomial.map_add, map_add, map_add, hp, hq]
          change _ = algebraMap k M (((Polynomial.aeval α p : k') : k) +
            ((Polynomial.aeval α q : k') : k))
          rw [map_add]
        | monomial n a =>
          rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.map_mul, Polynomial.map_C,
            Polynomial.map_pow, Polynomial.map_X, map_mul, Polynomial.aeval_C, map_pow,
            Polynomial.aeval_X, map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
          change ψ_M (algebraMap k₀ L a) * (algebraMap k M (α : k)) ^ n =
            algebraMap k M (algebraMap k₀ k a * (α : k) ^ n)
          rw [map_mul, map_pow]
          congr 1
          exact RingHom.congr_fun hψ_k₀ a
      have hk'_mem_Mθ : ∀ c : k', algebraMap k M (c : k) ∈ M_θ := by
        intro c
        obtain ⟨Q_c, hQc⟩ := hk'_aeval c
        have h_sub_aeval :
            ((Polynomial.aeval pb_L.gen (Q_c.map (algebraMap k₀ L)) : ↥M_θ) : M) =
              Polynomial.aeval (pb_L.gen : M) (Q_c.map (algebraMap k₀ L)) :=
          (Polynomial.aeval_algHom_apply M_θ.val pb_L.gen (Q_c.map (algebraMap k₀ L))).symm
        rw [← hQc, ← hk'_aeval_M Q_c θ, ← hpbL_gen_val, ← h_sub_aeval]
        exact (Polynomial.aeval pb_L.gen (Q_c.map (algebraMap k₀ L))).2
      let ι_Mθ : k' →+* ↥M_θ :=
        { toFun := fun c => ⟨algebraMap k M (c : k), hk'_mem_Mθ c⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by
            change algebraMap k M ((x : k) * (y : k)) =
              algebraMap k M (x : k) * algebraMap k M (y : k)
            rw [map_mul])
          map_zero' := Subtype.ext (by simp)
          map_add' := fun x y => Subtype.ext (by
            change algebraMap k M ((x : k) + (y : k)) =
              algebraMap k M (x : k) + algebraMap k M (y : k)
            rw [map_add]) }

      let _ : Fintype k₀ := Fintype.ofFinite k₀
      let frob₀ : k' →ₐ[k₀] k' := FiniteField.frobeniusAlgHom k₀ k'
      let frobIter : ℕ → (k' →ₐ[k₀] k') := fun s => Nat.rec (AlgHom.id k₀ k') (fun _ g => frob₀.comp g) s
      have hfrobIter_pow : ∀ (s : ℕ) (c : k'), frobIter s c = c ^ (Nat.card k₀ ^ s) := by
        intro s
        induction s with
        | zero =>
          intro c
          simp [frobIter]
        | succ s ih =>
          intro c
          change frob₀ (frobIter s c) = c ^ (Nat.card k₀ ^ (s + 1))
          rw [ih c]
          have hcoe : frob₀ (c ^ (Nat.card k₀ ^ s)) =
              (c ^ (Nat.card k₀ ^ s)) ^ Fintype.card k₀ :=
            congrFun (FiniteField.coe_frobeniusAlgHom k₀ k') _
          have hcard : Fintype.card k₀ = Nat.card k₀ := Nat.card_eq_fintype_card.symm
          rw [hcoe, hcard, ← pow_mul, pow_succ]

      have hfrob_θ_eval : ∀ s : ℕ,
          Polynomial.aeval (algebraMap k M ((frobIter s θ : k') : k)) (minpoly L pb_L.gen) = 0 := by
        intro s
        rw [hmin_pbL]
        apply hEval_k'_mθ (frobIter s θ)
        rw [Polynomial.aeval_algHom_apply (frobIter s) θ m_θ, minpoly.aeval, map_zero]
      let φ_frob : ℕ → (↥M_θ →ₐ[L] M) := fun s =>
        pb_L.lift (algebraMap k M ((frobIter s θ : k') : k)) (hfrob_θ_eval s)
      have hφ_frob_ι : ∀ (s : ℕ) (c : k'),
          φ_frob s (ι_Mθ c) = algebraMap k M ((frobIter s c : k') : k) := by
        intro s c
        obtain ⟨Q_c, hQc⟩ := hk'_aeval c
        have hι_eq : ι_Mθ c = Polynomial.aeval pb_L.gen (Q_c.map (algebraMap k₀ L)) := by
          apply Subtype.ext
          have h_sub_aeval :
              ((Polynomial.aeval pb_L.gen (Q_c.map (algebraMap k₀ L)) : ↥M_θ) : M) =
                Polynomial.aeval (pb_L.gen : M) (Q_c.map (algebraMap k₀ L)) :=
            (Polynomial.aeval_algHom_apply M_θ.val pb_L.gen (Q_c.map (algebraMap k₀ L))).symm
          change algebraMap k M (c : k) =
            ((Polynomial.aeval pb_L.gen (Q_c.map (algebraMap k₀ L)) : ↥M_θ) : M)
          rw [h_sub_aeval, hpbL_gen_val, hk'_aeval_M Q_c θ, hQc]
        rw [hι_eq, PowerBasis.lift_aeval, hk'_aeval_M Q_c (frobIter s θ),
          Polynomial.aeval_algHom_apply (frobIter s) θ Q_c, hQc]

      let R_M_k' : Subring M :=
        Subring.closure ((Set.range fun c : k' => algebraMap k M (c : k)) ∪ U)
      let _ : Algebra ↥R_M_k' M := R_M_k'.subtype.toAlgebra
      let R'_k' : Subring ↥M_θ :=
        Subring.closure ((Set.range ι_Mθ) ∪ (Set.range fun u : R_sub => algebraMap L ↥M_θ u.1))
      let _ : Algebra ↥R'_k' ↥M_θ := R'_k'.subtype.toAlgebra
      have hφ_maps_R : ∀ (s : ℕ) (w : ↥M_θ), w ∈ R'_k' → φ_frob s w ∈ R_M_k' := by
        intro s
        have hle : R'_k' ≤ R_M_k'.comap (φ_frob s).toRingHom := by
          rw [Subring.closure_le]
          rintro w (⟨c, rfl⟩ | ⟨u, rfl⟩)
          · change φ_frob s (ι_Mθ c) ∈ R_M_k'
            rw [hφ_frob_ι]
            exact Subring.subset_closure (Or.inl ⟨frobIter s c, rfl⟩)
          · change φ_frob s (algebraMap L ↥M_θ u.1) ∈ R_M_k'
            rw [(φ_frob s).commutes u.1]
            exact Subring.subset_closure (Or.inr ⟨u.1, u.2, rfl⟩)
        exact fun w hw => hle hw
      have hRM_le_map : R_M_k' ≤ R'_k'.map M_θ.val.toRingHom := by
        rw [Subring.closure_le]
        rintro x (⟨c, rfl⟩ | ⟨u, hu, rfl⟩)
        · exact ⟨ι_Mθ c, Subring.subset_closure (Or.inl ⟨c, rfl⟩), rfl⟩
        · exact ⟨algebraMap L ↥M_θ u, Subring.subset_closure (Or.inr ⟨⟨u, hu⟩, rfl⟩), rfl⟩

      let z' : ↥M_θ :=
        ∑ j : Fin d, ι_Mθ (pb.basis j) * algebraMap L ↥M_θ (y j)
      have hz'_val : (z' : M) = z := by
        rw [hz_expand]
        dsimp [z']
        push_cast
        rfl
      have hz'_int : IsIntegral ↥R'_k' z' := by
        have hcoeff_RM : ∀ t : ℕ, (P_int.coeff t : M) ∈ R_M_k' := by
          intro t
          by_cases ht : t ∈ P_int.support
          · refine Subring.closure_mono ?_ (hC_coeff t)
            refine Set.union_subset_union_left U ?_
            rintro _ ⟨c, hc, rfl⟩
            refine ⟨⟨c, IntermediateField.subset_adjoin k₀ (S_all : Set k) ?_⟩, rfl⟩
            simp only [S_all, S₂, Finset.mem_coe, Finset.mem_union, Finset.mem_biUnion]
            exact Or.inr ⟨t, ht, hc⟩
          · have h0 : P_int.coeff t = 0 := Polynomial.notMem_support_iff.mp ht
            rw [h0, ZeroMemClass.coe_zero]
            exact R_M_k'.zero_mem
        have hcoeff_R' : ∀ t : ℕ, ∃ c' : ↥R'_k', ((c' : ↥M_θ) : M) = (P_int.coeff t : M) := by
          intro t
          rcases hRM_le_map (hcoeff_RM t) with ⟨w, hw, hw_eq⟩
          exact ⟨⟨w, hw⟩, hw_eq⟩
        choose coeff_R' hcoeff_R' using hcoeff_R'
        let Q_int : Polynomial ↥R'_k' :=
          ∑ t ∈ P_int.support, Polynomial.monomial t (coeff_R' t)
        have hQ_coeff : ∀ t : ℕ, ((Q_int.coeff t : ↥R'_k') : M) = (P_int.coeff t : M) := by
          intro t
          dsimp [Q_int]
          rw [Polynomial.finsetSum_coeff]
          by_cases ht : t ∈ P_int.support
          · rw [Finset.sum_eq_single t
              (fun m _ hmt => by simp [Polynomial.coeff_monomial, hmt])
              (fun hnot => absurd ht hnot)]
            simp only [Polynomial.coeff_monomial, ↓reduceIte, hcoeff_R' t]
          · rw [Finset.sum_eq_zero fun m hm => by
              have hmt : m ≠ t := fun h => ht (h ▸ hm)
              simp [Polynomial.coeff_monomial, hmt]]
            have h0 : P_int.coeff t = 0 := Polynomial.notMem_support_iff.mp ht
            rw [h0]
            rfl
        have hInj_R'_M : Function.Injective ((M_θ.val.toRingHom).comp R'_k'.subtype) :=
          Subtype.val_injective.comp Subtype.val_injective
        have hQ_map_M' : Q_int.map ((M_θ.val.toRingHom).comp R'_k'.subtype) =
            P_int.map A_U.val.toRingHom := by
          refine Polynomial.ext fun t => ?_
          rw [Polynomial.coeff_map, Polynomial.coeff_map]
          exact hQ_coeff t
        have hQ_mon : Q_int.Monic := by
          have hmonM : (Q_int.map ((M_θ.val.toRingHom).comp R'_k'.subtype)).Monic := by
            rw [hQ_map_M']
            exact hPint_mon.map A_U.val.toRingHom
          exact Polynomial.monic_of_injective hInj_R'_M hmonM
        have hQ_eval : Polynomial.aeval z' Q_int = 0 := by
          apply Subtype.val_injective
          have h1 : (Polynomial.aeval z' Q_int : M) =
              Polynomial.eval z (Q_int.map ((M_θ.val.toRingHom).comp R'_k'.subtype)) := by
            rw [← hz'_val, Polynomial.eval_map]
            induction Q_int using Polynomial.induction_on' with
            | add p q hp hq =>
              rw [map_add, Polynomial.eval₂_add, Subalgebra.coe_add, hp, hq]
            | monomial n a =>
              rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, Polynomial.aeval_C,
                map_pow, Polynomial.aeval_X, Polynomial.eval₂_mul, Polynomial.eval₂_C,
                Polynomial.eval₂_pow, Polynomial.eval₂_X]
              rfl
          have hAU_alg : A_U.val.toRingHom = algebraMap ↥A_U M := rfl
          rw [h1, hQ_map_M', Polynomial.eval_map, hAU_alg, hPint_eval]
          rfl
        exact ⟨Q_int, hQ_mon, hQ_eval⟩

      let S_tr : Fin d → M := fun i =>
        ∑ s ∈ Finset.range d, φ_frob s (z' * ι_Mθ (pb.basis i))
      have hStr_int : ∀ i : Fin d, S_tr i ∈ integralClosure ↥R_M_k' M := by
        intro i
        refine Subalgebra.sum_mem _ fun s _ => ?_
        have hbi_mem : ι_Mθ (pb.basis i) ∈ R'_k' :=
          Subring.subset_closure (Or.inl ⟨pb.basis i, rfl⟩)
        have hbi_int : IsIntegral ↥R'_k' (ι_Mθ (pb.basis i)) :=
          isIntegral_algebraMap (A := ↥M_θ) (x := (⟨ι_Mθ (pb.basis i), hbi_mem⟩ : ↥R'_k'))
        have hzbi_int : IsIntegral ↥R'_k' (z' * ι_Mθ (pb.basis i)) :=
          hz'_int.mul hbi_int
        let φ_R_s : ↥R'_k' →+* ↥R_M_k' :=
          { toFun := fun w => ⟨φ_frob s w.1, hφ_maps_R s w.1 w.2⟩
            map_one' := Subtype.ext (map_one _)
            map_mul' := fun a b => Subtype.ext (by
              change φ_frob s (a.1 * b.1) = φ_frob s a.1 * φ_frob s b.1
              rw [map_mul])
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun a b => Subtype.ext (by
              change φ_frob s (a.1 + b.1) = φ_frob s a.1 + φ_frob s b.1
              rw [map_add]) }
        exact hzbi_int.map_of_comp_eq φ_R_s (φ_frob s).toRingHom (RingHom.ext fun _ => rfl)

      let T : Matrix (Fin d) (Fin d) k₀ := Algebra.traceMatrix k₀ pb.basis
      have hStr_eq : ∀ i : Fin d,
          S_tr i = ∑ j : Fin d, ψ_M (algebraMap k₀ L (T i j) * y j) := by
        intro i
        dsimp [S_tr, z']
        simp_rw [Finset.sum_mul, map_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun j _ => ?_
        have hterm : ∀ s : ℕ,
            φ_frob s (ι_Mθ (pb.basis j) * algebraMap L ↥M_θ (y j) * ι_Mθ (pb.basis i)) =
              algebraMap k M ((((pb.basis i * pb.basis j) ^ (Nat.card k₀ ^ s) : k') : k)) *
                ψ_M (y j) := by
          intro s
          have hmul_eq : ι_Mθ (pb.basis j) * algebraMap L ↥M_θ (y j) * ι_Mθ (pb.basis i) =
              ι_Mθ (pb.basis i * pb.basis j) * algebraMap L ↥M_θ (y j) := by
            rw [mul_comm (pb.basis i), map_mul]
            ring
          rw [hmul_eq, map_mul, hφ_frob_ι, hfrobIter_pow, (φ_frob s).commutes (y j)]
          rfl
        simp_rw [hterm, ← Finset.sum_mul]
        rw [map_mul]
        congr 1
        have htr := FiniteField.algebraMap_trace_eq_sum_pow k₀ k' (pb.basis i * pb.basis j)
        rw [← hd_finrank] at htr
        have hTij : T i j = Algebra.trace k₀ k' (pb.basis i * pb.basis j) := rfl
        have hsum_k : (∑ s ∈ Finset.range d,
              algebraMap k M ((((pb.basis i * pb.basis j) ^ (Nat.card k₀ ^ s) : k') : k))) =
            algebraMap k M ((algebraMap k₀ k' (T i j) : k') : k) := by
          rw [hTij, htr]
          push_cast
          rfl
        rw [hsum_k]
        exact (RingHom.congr_fun hψ_k₀ (T i j)).symm

      have hT_unit : IsUnit T := by
        rw [Matrix.isUnit_iff_isUnit_det]
        exact IsUnit.mk0 T.det (det_traceMatrix_ne_zero' pb)
      let uT : (Matrix (Fin d) (Fin d) k₀)ˣ := hT_unit.unit
      let T_inv : Matrix (Fin d) (Fin d) k₀ := (uT⁻¹).val
      have hT_inv_mul : T_inv * T = 1 := by
        dsimp [T_inv]
        rw [← hT_unit.unit_spec, ← Units.val_mul, inv_mul_cancel, Units.val_one]

      have hy_int_Rsub : ∀ j₀ : Fin d, y j₀ ∈ integralClosure ↥R_sub L := by
        intro j₀
        have hψy_eq : ψ_M (y j₀) =
            ∑ i : Fin d, ψ_M (algebraMap k₀ L (T_inv j₀ i)) * S_tr i := by
          have hdist : (∑ i : Fin d, ψ_M (algebraMap k₀ L (T_inv j₀ i)) * S_tr i) =
              ∑ i : Fin d, ∑ j : Fin d,
                ψ_M (algebraMap k₀ L (T_inv j₀ i) * (algebraMap k₀ L (T i j) * y j)) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hStr_eq i, Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => (map_mul ψ_M _ _).symm
          have hswap : (∑ i : Fin d, ∑ j : Fin d,
                ψ_M (algebraMap k₀ L (T_inv j₀ i) * (algebraMap k₀ L (T i j) * y j))) =
              ψ_M (∑ j : Fin d, ∑ i : Fin d,
                algebraMap k₀ L (T_inv j₀ i) * (algebraMap k₀ L (T i j) * y j)) := by
            rw [Finset.sum_comm, map_sum]
            refine Finset.sum_congr rfl fun j _ => (map_sum ψ_M _ _).symm
          rw [hdist, hswap]
          congr 1
          calc y j₀ = ∑ j : Fin d, algebraMap k₀ L ((T_inv * T) j₀ j) * y j := by
                rw [hT_inv_mul]
                simp [Matrix.one_apply]
            _ = ∑ j : Fin d, ∑ i : Fin d,
                  algebraMap k₀ L (T_inv j₀ i) * (algebraMap k₀ L (T i j) * y j) := by
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [map_mul, mul_assoc]
        have hψy_RMk' : ψ_M (y j₀) ∈ integralClosure ↥R_M_k' M := by
          rw [hψy_eq]
          refine Subalgebra.sum_mem _ fun i _ => ?_
          have hcoeff_mem : ψ_M (algebraMap k₀ L (T_inv j₀ i)) ∈ R_M_k' :=
            Subring.subset_closure (Or.inr ⟨algebraMap k₀ L (T_inv j₀ i), R_sub.algebraMap_mem _, rfl⟩)
          have hcoeff_int : IsIntegral ↥R_M_k' (ψ_M (algebraMap k₀ L (T_inv j₀ i))) :=
            isIntegral_algebraMap (A := M) (x := (⟨_, hcoeff_mem⟩ : ↥R_M_k'))
          exact Subalgebra.mul_mem _ hcoeff_int (hStr_int i)
        let U_ring : Subring M := R_sub.toSubring.map ψ_M
        let _ : Algebra ↥U_ring M := U_ring.subtype.toAlgebra
        have hRMk'_int_U : ∀ w ∈ R_M_k', w ∈ integralClosure ↥U_ring M := by
          intro w hw
          refine Subring.closure_induction ?_ ?_ ?_ ?_ ?_ ?_ hw
          · rintro x (⟨c, rfl⟩ | hxU)
            · have hc_k₀ : IsIntegral k₀ c := Algebra.IsIntegral.isIntegral c
              let ι_k₀_U : k₀ →+* ↥U_ring :=
                { toFun := fun a => ⟨ψ_M (algebraMap k₀ L a),
                    ⟨algebraMap k₀ L a, R_sub.algebraMap_mem a, rfl⟩⟩
                  map_one' := Subtype.ext (by simp)
                  map_mul' := fun a b => Subtype.ext (by simp [map_mul])
                  map_zero' := Subtype.ext (by simp)
                  map_add' := fun a b => Subtype.ext (by simp [map_add]) }
              have hcomp : (algebraMap ↥U_ring M).comp ι_k₀_U =
                  ((algebraMap k M).comp (algebraMap k' k)).comp (algebraMap k₀ k') :=
                RingHom.ext fun a => RingHom.congr_fun hψ_k₀ a
              exact hc_k₀.map_of_comp_eq ι_k₀_U
                ((algebraMap k M).comp (algebraMap k' k)) hcomp
            · exact isIntegral_algebraMap (A := M) (x := (⟨x, hxU⟩ : ↥U_ring))
          · exact Subalgebra.zero_mem _
          · exact Subalgebra.one_mem _
          · intro x y _ _ ihx ihy; exact Subalgebra.add_mem _ ihx ihy
          · intro x _ ihx; exact Subalgebra.neg_mem _ ihx
          · intro x y _ _ ihx ihy; exact Subalgebra.mul_mem _ ihx ihy
        have hU_le_RM : U_ring ≤ R_M_k' := by
          rintro x ⟨u, hu, rfl⟩
          exact Subring.subset_closure (Or.inr ⟨u, hu, rfl⟩)
        have hψy_U : IsIntegral ↥U_ring (ψ_M (y j₀)) := by
          let inc_U : ↥U_ring →+* ↥R_M_k' := Subring.inclusion hU_le_RM
          let _ : Algebra ↥U_ring ↥R_M_k' := inc_U.toAlgebra
          have : IsScalarTower ↥U_ring ↥R_M_k' M := IsScalarTower.of_algebraMap_eq fun _ => rfl
          have : Algebra.IsIntegral ↥U_ring ↥R_M_k' :=
            ⟨fun w => (isIntegral_algHom_iff (IsScalarTower.toAlgHom ↥U_ring ↥R_M_k' M)
              Subtype.val_injective).mp (hRMk'_int_U w.1 w.2)⟩
          exact isIntegral_trans (R := ↥U_ring) (ψ_M (y j₀)) hψy_RMk'
        let f_RU : ↥R_sub →+* ↥U_ring :=
          { toFun := fun u => ⟨ψ_M u.1, ⟨u.1, u.2, rfl⟩⟩
            map_one' := Subtype.ext (map_one ψ_M)
            map_mul' := fun a b => Subtype.ext (map_mul ψ_M a.1 b.1)
            map_zero' := Subtype.ext (map_zero ψ_M)
            map_add' := fun a b => Subtype.ext (map_add ψ_M a.1 b.1) }
        have hf_RU_bij : Function.Bijective f_RU := by
          refine ⟨fun a b hab => Subtype.ext (hψ_inj (congrArg Subtype.val hab)), ?_⟩
          rintro ⟨_, u, hu, rfl⟩
          exact ⟨⟨u, hu⟩, rfl⟩
        let e_RU : ↥R_sub ≃+* ↥U_ring := RingEquiv.ofBijective f_RU hf_RU_bij
        obtain ⟨P_U, hPU_mon, hPU_eval⟩ := hψy_U
        let Q_R : Polynomial ↥R_sub := P_U.map (e_RU.symm : ↥U_ring →+* ↥R_sub)
        have hQR_mon : Q_R.Monic := hPU_mon.map (e_RU.symm : ↥U_ring →+* ↥R_sub)
        have hQR_map : Q_R.map f_RU = P_U := by
          dsimp [Q_R]
          rw [Polynomial.map_map]
          have hcomp : f_RU.comp (e_RU.symm : ↥U_ring →+* ↥R_sub) = RingHom.id ↥U_ring :=
            RingHom.ext fun w => e_RU.apply_symm_apply w
          rw [hcomp, Polynomial.map_id]
        have hQR_eval : Polynomial.aeval (y j₀) Q_R = 0 := by
          apply hψ_inj
          rw [map_zero]
          have h1 : ψ_M (Polynomial.aeval (y j₀) Q_R) =
              Polynomial.aeval (ψ_M (y j₀)) (Q_R.map f_RU) := by
            induction Q_R using Polynomial.induction_on' with
            | add p q hp hq =>
              rw [map_add, map_add, Polynomial.map_add, map_add, hp, hq]
            | monomial n a =>
              rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.map_mul, Polynomial.map_C,
                Polynomial.map_pow, Polynomial.map_X, map_mul, Polynomial.aeval_C, map_pow,
                Polynomial.aeval_X, map_mul, map_pow, map_mul, Polynomial.aeval_C, map_pow,
                Polynomial.aeval_X]
              rfl
          rw [h1, hQR_map, Polynomial.aeval_def, hPU_eval]
        exact ⟨Q_R, hQR_mon, hQR_eval⟩

      rw [hz_expand]
      refine Subalgebra.sum_mem _ fun j _ => ?_
      exact Subalgebra.mul_mem _
        (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin ⟨y j, hy_int_Rsub j, rfl⟩)

    exact ⟨M, hFld_M, instAlg_k_M, instAlg_Pk_M, hARF_M,
      hST_k_Pk_M, hST_k_RFk_M, hST_Pk_RFk_M, hFD_M, hGal_M,
      ψ_M, res_M, hψ_inj, hψ_k₀, hψ_X, hres_M_apply, fun v hv => hLinIndep v hv, hIntCl⟩

  
  have s4_sig : ∀ (F k₀ k : Type u) [Finite F] [Field F] [Finite k₀] [Field k₀] [Field k]
      [Algebra F k₀] [Algebra F k] [Algebra k₀ k] [IsScalarTower F k₀ k]
      (Δ_F : Polynomial F), Δ_F.Monic →
      ∀ (Δ_k : Polynomial k), Δ_k = Δ_F.map (algebraMap F k) →
      ∀ (R₀ R₀_k : Type u) [CommRing R₀] [Algebra (Polynomial F) R₀] [IsLocalization.Away Δ_F R₀]
      [CommRing R₀_k] [Algebra k R₀_k] [Algebra (Polynomial k) R₀_k]
      [IsScalarTower k (Polynomial k) R₀_k] [IsLocalization.Away Δ_k R₀_k]
      (j_R₀k : R₀ →+* R₀_k),
      j_R₀k.comp (algebraMap (Polynomial F) R₀) =
        (algebraMap (Polynomial k) R₀_k).comp (Polynomial.mapRingHom (algebraMap F k)) →
      ∀ (B_r L M : Type u) [CommRing B_r] [IsDomain B_r] [Field L] [Field M]
      [Algebra F B_r] [Algebra k₀ B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L] [Algebra k₀ L] [Algebra (Polynomial F) L] [Algebra (RatFunc F) L]
      [Algebra (Polynomial k₀) L] [Algebra (RatFunc k₀) L] [Algebra B_r L] [Algebra R₀ L]
      [IsScalarTower F k₀ B_r] [IsScalarTower F (Polynomial F) B_r]
      [IsScalarTower (Polynomial F) R₀ B_r] [IsScalarTower F k₀ L] [IsScalarTower k₀ B_r L]
      [IsScalarTower k₀ (Polynomial k₀) L] [IsScalarTower k₀ (RatFunc k₀) L]
      [IsScalarTower (Polynomial k₀) (RatFunc k₀) L] [IsScalarTower F (RatFunc F) L]
      [IsScalarTower (Polynomial F) (RatFunc F) L] [IsScalarTower (Polynomial F) B_r L]
      [IsScalarTower R₀ B_r L]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L] [IsIntegralClosure B_r R₀ L]
      [Algebra k M] [Algebra (Polynomial k) M] [Algebra (RatFunc k) M]
      [IsScalarTower k (Polynomial k) M] [IsScalarTower k (RatFunc k) M]
      [IsScalarTower (Polynomial k) (RatFunc k) M]
      [FiniteDimensional (RatFunc k) M] [IsGalois (RatFunc k) M],
      algebraMap (RatFunc k₀) L RatFunc.X = algebraMap (RatFunc F) L RatFunc.X →
      ∀ (ψ_M : L →+* M), Function.Injective ψ_M →
      ψ_M.comp (algebraMap k₀ L) = (algebraMap k M).comp (algebraMap k₀ k) →
      ψ_M (algebraMap (RatFunc k₀) L RatFunc.X) = algebraMap (RatFunc k) M RatFunc.X →
      (∀ {ι : Type u} (v : ι → L),
        LinearIndependent (RatFunc k₀) v → LinearIndependent (RatFunc k) (ψ_M ∘ v)) →
      (∀ R_sub : Subalgebra k₀ L,
        (integralClosure ↥(Algebra.adjoin k (ψ_M '' (R_sub : Set L))) M : Set M) ⊆
          (Algebra.adjoin k (ψ_M '' (integralClosure ↥R_sub L : Set L)) : Set M)) →
      ∃ (B_k : Type u)
        (_ : CommRing B_k) (_ : IsDomain B_k)
        (_ : Algebra k B_k) (_ : Algebra (Polynomial k) B_k) (_ : Algebra R₀_k B_k)
        (_ : Algebra B_k M) (_ : Algebra R₀_k M)
        (_ : IsScalarTower k (Polynomial k) B_k) (_ : IsScalarTower (Polynomial k) R₀_k B_k)
        (_ : IsScalarTower (Polynomial k) B_k M) (_ : IsScalarTower R₀_k B_k M)
        (_ : Module.Finite R₀_k B_k) (_ : Algebra.Etale R₀_k B_k)
        (_ : IsFractionRing B_k M) (_ : IsIntegralClosure B_k R₀_k M)
        (j_Bk : B_r →+* B_k),
        Function.Injective j_Bk ∧
        j_Bk.comp (algebraMap R₀ B_r) = (algebraMap R₀_k B_k).comp j_R₀k ∧
        Algebra.adjoin R₀_k (Set.range j_Bk) = ⊤ := by
    clear * -
    intro F k₀ k _ _ _ _ _ _ _ _ _ Δ_F hΔ_F_mon Δ_k hΔ_k R₀ R₀_k _ _ _ _ _ _ _ _ j_R₀k hj_R₀k_comp
      B_r L M _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      hX_k₀ ψ_M hψ_inj hψ_k₀ hψ_X hLinIndep hIntCl
    have hMonNeZero : ∀ {K : Type u} [Field K] {P : Polynomial K}, P.Monic → P ≠ 0 := by
      intro K _ P hP h0
      have h1 := congrArg Polynomial.leadingCoeff h0
      rw [hP.leadingCoeff, Polynomial.leadingCoeff_zero] at h1
      exact one_ne_zero h1
    have hPID_poly_loc : ∀ (K S : Type u) [Field K]
        (W : Submonoid (Polynomial K)) [CommRing S] [Algebra (Polynomial K) S] [IsLocalization W S],
        IsPrincipalIdealRing S := by
      intro K S _ W _ _ _
      rw [isPrincipalIdealRing_iff]
      intro J
      have hPID_PK : IsPrincipalIdealRing (Polynomial K) := inferInstance
      have _ : Submodule.IsPrincipal (Ideal.under (Polynomial K) J) :=
        (isPrincipalIdealRing_iff (Polynomial K)).mp hPID_PK (Ideal.under (Polynomial K) J)
      let g : Polynomial K := Submodule.IsPrincipal.generator (Ideal.under (Polynomial K) J)
      have hg : Ideal.under (Polynomial K) J = Ideal.span {g} :=
        (Ideal.span_singleton_generator (Ideal.under (Polynomial K) J)).symm
      refine ⟨⟨algebraMap (Polynomial K) S g, ?_⟩⟩
      change J = Ideal.span {algebraMap (Polynomial K) S g}
      rw [← IsLocalization.map_under W S J, hg, Ideal.map_span, Set.image_singleton]

    have hΔ_F_ne : Δ_F ≠ 0 := hMonNeZero hΔ_F_mon
    have hΔ_k_mon : Δ_k.Monic := hΔ_k ▸ hΔ_F_mon.map (algebraMap F k)
    have hΔ_k_ne : Δ_k ≠ 0 := hMonNeZero hΔ_k_mon
    have : IsDomain R₀ :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R₀
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_F_ne))
    have : IsDomain R₀_k :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R₀_k
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_k_ne))
    have : IsPrincipalIdealRing R₀_k := hPID_poly_loc k R₀_k (Submonoid.powers Δ_k)
    have : IsDedekindDomain R₀_k := IsPrincipalIdealRing.isDedekindDomain R₀_k

    have hΔ_k_unit : IsUnit (algebraMap (Polynomial k) (RatFunc k) Δ_k) :=
      IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr hΔ_k_ne)
    let _ : Algebra R₀_k (RatFunc k) := (IsLocalization.Away.lift Δ_k hΔ_k_unit).toAlgebra
    have : IsScalarTower (Polynomial k) R₀_k (RatFunc k) :=
      IsScalarTower.of_algebraMap_eq fun p => (IsLocalization.Away.lift_eq Δ_k hΔ_k_unit p).symm
    have : IsFractionRing R₀_k (RatFunc k) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers Δ_k) R₀_k (RatFunc k)

    let instAlg_R₀k_M : Algebra R₀_k M :=
      ((algebraMap (RatFunc k) M).comp (algebraMap R₀_k (RatFunc k))).toAlgebra
    have : IsScalarTower R₀_k (RatFunc k) M := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hST_Pk_R₀k_M : IsScalarTower (Polynomial k) R₀_k M := by
      refine IsScalarTower.of_algebraMap_eq fun p => ?_
      rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M,
        IsScalarTower.algebraMap_apply (Polynomial k) R₀_k (RatFunc k),
        IsScalarTower.algebraMap_apply R₀_k (RatFunc k) M]
    have : IsScalarTower k R₀_k M := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      rw [IsScalarTower.algebraMap_apply k (Polynomial k) M,
        IsScalarTower.algebraMap_apply k (Polynomial k) R₀_k,
        IsScalarTower.algebraMap_apply (Polynomial k) R₀_k M]

    let B_k : Type u := ↥(integralClosure R₀_k M)
    have hFrac_Bk : IsFractionRing B_k M :=
      integralClosure.isFractionRing_of_finite_extension (RatFunc k) M
    have hFin_Bk : Module.Finite R₀_k B_k :=
      IsIntegralClosure.finite R₀_k (RatFunc k) M B_k

    have hST_F_P_L : IsScalarTower F (Polynomial F) L := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      rw [IsScalarTower.algebraMap_apply F (RatFunc F) L,
        IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
        ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L]
    have hψ_R₀ : (algebraMap R₀_k M).comp j_R₀k = ψ_M.comp (algebraMap R₀ L) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ_F)
      have h1 : ((algebraMap R₀_k M).comp j_R₀k).comp (algebraMap (Polynomial F) R₀) =
          (algebraMap (Polynomial k) M).comp (Polynomial.mapRingHom (algebraMap F k)) := by
        rw [RingHom.comp_assoc, hj_R₀k_comp, ← RingHom.comp_assoc]
        refine RingHom.ext fun p => ?_
        exact (IsScalarTower.algebraMap_apply (Polynomial k) R₀_k M _).symm
      have h2 : (ψ_M.comp (algebraMap R₀ L)).comp (algebraMap (Polynomial F) R₀) =
          ψ_M.comp (algebraMap (Polynomial F) L) := by
        refine RingHom.ext fun p => ?_
        simp only [RingHom.comp_apply, IsScalarTower.algebraMap_apply R₀ B_r L,
          ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
          ← IsScalarTower.algebraMap_apply (Polynomial F) B_r L]
      rw [h1, h2]
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
        have hL : algebraMap (Polynomial k) M (Polynomial.C (algebraMap F k c)) =
            algebraMap k M (algebraMap F k c) :=
          (IsScalarTower.algebraMap_apply k (Polynomial k) M (algebraMap F k c)).symm
        have hR : algebraMap (Polynomial F) L (Polynomial.C c) = algebraMap F L c :=
          (IsScalarTower.algebraMap_apply F (Polynomial F) L c).symm
        rw [hL, hR, IsScalarTower.algebraMap_apply F k₀ k, IsScalarTower.algebraMap_apply F k₀ L]
        exact (RingHom.congr_fun hψ_k₀ (algebraMap F k₀ c)).symm
      · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M,
          IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L,
          RatFunc.algebraMap_X, ← hX_k₀, hψ_X]

    have hBr_mem_Bk : ∀ b : B_r, ψ_M (algebraMap B_r L b) ∈ integralClosure R₀_k M := by
      intro b
      have hb_int : IsIntegral R₀ (algebraMap B_r L b) :=
        IsIntegral.map (IsScalarTower.toAlgHom R₀ B_r L) (IsIntegralClosure.isIntegral R₀ L b)
      exact hb_int.map_of_comp_eq j_R₀k ψ_M hψ_R₀
    let j_Bk : B_r →+* B_k :=
      { toFun := fun b => ⟨ψ_M (algebraMap B_r L b), hBr_mem_Bk b⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun x y => Subtype.ext (by
          change ψ_M (algebraMap B_r L (x * y)) =
            ψ_M (algebraMap B_r L x) * ψ_M (algebraMap B_r L y)
          rw [map_mul, map_mul])
        map_zero' := Subtype.ext (by simp)
        map_add' := fun x y => Subtype.ext (by
          change ψ_M (algebraMap B_r L (x + y)) =
            ψ_M (algebraMap B_r L x) + ψ_M (algebraMap B_r L y)
          rw [map_add, map_add]) }
    have hj_Bk_inj : Function.Injective j_Bk := fun x y hxy =>
      IsFractionRing.injective B_r L (hψ_inj (congrArg Subtype.val hxy))
    have hj_Bk_comp : j_Bk.comp (algebraMap R₀ B_r) = (algebraMap R₀_k B_k).comp j_R₀k := by
      ext r
      change ψ_M (algebraMap B_r L (algebraMap R₀ B_r r)) = algebraMap R₀_k M (j_R₀k r)
      rw [← IsScalarTower.algebraMap_apply R₀ B_r L]
      exact (RingHom.congr_fun hψ_R₀ r).symm

    have hj_Bk_adjoin : Algebra.adjoin R₀_k (Set.range j_Bk) = ⊤ := by
      let R_sub : Subalgebra k₀ L := (IsScalarTower.toAlgHom k₀ B_r L).range
      have hRsub_closed : (integralClosure ↥R_sub L : Set L) ⊆ (R_sub : Set L) := by
        intro y hy
        have hBr_Rsub : ∀ u : R_sub, IsIntegral R₀ (u : L) := by
          rintro ⟨_, b, rfl⟩
          exact IsIntegral.map (IsScalarTower.toAlgHom R₀ B_r L) (IsIntegralClosure.isIntegral R₀ L b)
        have hy_R₀ : IsIntegral R₀ y := by
          let φ_R₀_Rsub : R₀ →+* ↥R_sub :=
            { toFun := fun r => ⟨algebraMap R₀ L r, algebraMap R₀ B_r r,
                (IsScalarTower.algebraMap_apply R₀ B_r L r).symm⟩
              map_one' := Subtype.ext (map_one _)
              map_mul' := fun a b => Subtype.ext (map_mul _ a b)
              map_zero' := Subtype.ext (map_zero _)
              map_add' := fun a b => Subtype.ext (map_add _ a b) }
          let _ : Algebra R₀ ↥R_sub := φ_R₀_Rsub.toAlgebra
          have : IsScalarTower R₀ ↥R_sub L := IsScalarTower.of_algebraMap_eq fun _ => rfl
          have : Algebra.IsIntegral R₀ ↥R_sub :=
            ⟨fun u => (isIntegral_algHom_iff (IsScalarTower.toAlgHom R₀ ↥R_sub L)
              Subtype.val_injective).mp (hBr_Rsub u)⟩
          exact isIntegral_trans (R := R₀) y hy
        obtain ⟨b, hb⟩ := (IsIntegralClosure.isIntegral_iff (A := B_r) (R := R₀) (B := L)).mp hy_R₀
        exact ⟨b, hb⟩
      let A_M : Subalgebra k M := Algebra.adjoin k (ψ_M '' (R_sub : Set L))
      have hX_AM : algebraMap (Polynomial k) M Polynomial.X ∈ A_M := by
        rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M,
          RatFunc.algebraMap_X, ← hψ_X, hX_k₀, ← RatFunc.algebraMap_X,
          ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L]
        refine Algebra.subset_adjoin ⟨algebraMap (Polynomial F) L Polynomial.X, ?_, rfl⟩
        exact ⟨algebraMap (Polynomial F) B_r Polynomial.X,
          (IsScalarTower.algebraMap_apply (Polynomial F) B_r L Polynomial.X).symm⟩
      have hPoly_AM : ∀ Q : Polynomial k, algebraMap (Polynomial k) M Q ∈ A_M := by
        intro Q
        induction Q using Polynomial.induction_on' with
        | add p q hp hq =>
          rw [map_add]
          exact A_M.add_mem hp hq
        | monomial n c =>
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
          have hCk : algebraMap (Polynomial k) M (Polynomial.C c) = algebraMap k M c :=
            (IsScalarTower.algebraMap_apply k (Polynomial k) M c).symm
          rw [hCk]
          exact A_M.mul_mem (A_M.algebraMap_mem c) (A_M.pow_mem hX_AM n)
      have hR₀k_mem_AM : ∀ r_k : R₀_k, algebraMap R₀_k M r_k ∈ A_M := by
        intro r_k
        obtain ⟨⟨P, ⟨_, m, rfl⟩⟩, hPr⟩ := IsLocalization.surj (Submonoid.powers Δ_k) r_k
        have hPr_M : algebraMap R₀_k M r_k * (algebraMap R₀_k M (algebraMap (Polynomial k) R₀_k Δ_k)) ^ m =
            algebraMap (Polynomial k) M P := by
          have h1 := congrArg (algebraMap R₀_k M) hPr
          simpa only [map_mul, map_pow, ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k M] using h1
        let invΔ_F : R₀ := IsLocalization.Away.invSelf Δ_F
        have hΔ_inv_R₀ : algebraMap (Polynomial F) R₀ Δ_F * invΔ_F = 1 :=
          IsLocalization.Away.mul_invSelf Δ_F
        have hΔk_eq : algebraMap R₀_k M (algebraMap (Polynomial k) R₀_k Δ_k) =
            ψ_M (algebraMap R₀ L (algebraMap (Polynomial F) R₀ Δ_F)) := by
          have hmap : j_R₀k (algebraMap (Polynomial F) R₀ Δ_F) = algebraMap (Polynomial k) R₀_k Δ_k := by
            have h1 := RingHom.congr_fun hj_R₀k_comp Δ_F
            simpa only [RingHom.comp_apply, Polynomial.coe_mapRingHom, ← hΔ_k] using h1
          rw [← hmap]
          exact RingHom.congr_fun hψ_R₀ _
        have hmul1 : algebraMap R₀_k M (algebraMap (Polynomial k) R₀_k Δ_k) *
            ψ_M (algebraMap R₀ L invΔ_F) = 1 := by
          rw [hΔk_eq, ← map_mul, ← map_mul, hΔ_inv_R₀, map_one, map_one]
        have hmul_pow : (algebraMap R₀_k M (algebraMap (Polynomial k) R₀_k Δ_k)) ^ m *
            (ψ_M (algebraMap R₀ L invΔ_F)) ^ m = 1 := by
          rw [← mul_pow, hmul1, one_pow]
        have hrk_eq : algebraMap R₀_k M r_k =
            algebraMap (Polynomial k) M P * (ψ_M (algebraMap R₀ L invΔ_F)) ^ m := by
          calc algebraMap R₀_k M r_k
              = algebraMap R₀_k M r_k *
                  ((algebraMap R₀_k M (algebraMap (Polynomial k) R₀_k Δ_k)) ^ m *
                    (ψ_M (algebraMap R₀ L invΔ_F)) ^ m) := by rw [hmul_pow, mul_one]
            _ = (algebraMap R₀_k M r_k *
                  (algebraMap R₀_k M (algebraMap (Polynomial k) R₀_k Δ_k)) ^ m) *
                  (ψ_M (algebraMap R₀ L invΔ_F)) ^ m := by ring
            _ = algebraMap (Polynomial k) M P * (ψ_M (algebraMap R₀ L invΔ_F)) ^ m := by rw [hPr_M]
        have hinv_AM : ψ_M (algebraMap R₀ L invΔ_F) ∈ A_M := by
          refine Algebra.subset_adjoin ⟨algebraMap R₀ L invΔ_F, ?_, rfl⟩
          exact ⟨algebraMap R₀ B_r invΔ_F, (IsScalarTower.algebraMap_apply R₀ B_r L invΔ_F).symm⟩
        rw [hrk_eq]
        exact A_M.mul_mem (hPoly_AM P) (A_M.pow_mem hinv_AM m)

      rw [eq_top_iff]
      intro z _
      have hz_AM : (z : M) ∈ integralClosure ↥A_M M := by
        let φ_R_AM : R₀_k →+* ↥A_M :=
          { toFun := fun r => ⟨algebraMap R₀_k M r, hR₀k_mem_AM r⟩
            map_one' := Subtype.ext (map_one _)
            map_mul' := fun a b => Subtype.ext (map_mul _ a b)
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun a b => Subtype.ext (map_add _ a b) }
        exact z.2.map_of_comp_eq φ_R_AM (RingHom.id M) (RingHom.ext fun _ => rfl)
      have hz_cl : (z : M) ∈ Algebra.adjoin k (ψ_M '' (R_sub : Set L)) :=
        (Algebra.adjoin_mono (Set.image_mono hRsub_closed)) (hIntCl R_sub hz_AM)
      change z ∈ Algebra.adjoin R₀_k (Set.range j_Bk)
      have hSub_eq : ψ_M '' (R_sub : Set L) = Subtype.val '' (Set.range j_Bk) := by
        ext w
        constructor
        · rintro ⟨_, ⟨b, rfl⟩, rfl⟩
          exact ⟨j_Bk b, ⟨b, rfl⟩, rfl⟩
        · rintro ⟨_, ⟨b, rfl⟩, rfl⟩
          exact ⟨algebraMap B_r L b, ⟨b, rfl⟩, rfl⟩
      rw [hSub_eq] at hz_cl
      have hle_Bk : Algebra.adjoin k (Subtype.val '' (Set.range j_Bk)) ≤
          (integralClosure R₀_k M).restrictScalars k := by
        rw [Algebra.adjoin_le_iff]
        rintro _ ⟨u, _, rfl⟩
        exact u.2
      have hz_pull : ∀ w : M, w ∈ Algebra.adjoin k (Subtype.val '' (Set.range j_Bk)) →
          ∀ hwm : w ∈ integralClosure R₀_k M,
            (⟨w, hwm⟩ : B_k) ∈ Algebra.adjoin R₀_k (Set.range j_Bk) := by
        intro w hw
        induction hw using Algebra.adjoin_induction with
        | mem x hx =>
          rintro hxm
          rcases hx with ⟨u, hu, rfl⟩
          exact Algebra.subset_adjoin hu
        | algebraMap c =>
          intro hcm
          have hce : (⟨algebraMap k M c, hcm⟩ : B_k) = algebraMap R₀_k B_k (algebraMap k R₀_k c) := by
            apply Subtype.ext
            change algebraMap k M c = algebraMap R₀_k M (algebraMap k R₀_k c)
            exact IsScalarTower.algebraMap_apply k R₀_k M c
          rw [hce]
          exact Subalgebra.algebraMap_mem _ _
        | add x y hx hy ihx ihy =>
          intro _
          exact Subalgebra.add_mem _ (ihx (hle_Bk hx)) (ihy (hle_Bk hy))
        | mul x y hx hy ihx ihy =>
          intro _
          exact Subalgebra.mul_mem _ (ihx (hle_Bk hx)) (ihy (hle_Bk hy))
      exact hz_pull z.1 hz_cl z.2

    let Δ_k₀ : Polynomial k₀ := Δ_F.map (algebraMap F k₀)
    have hΔ_k₀_mon : Δ_k₀.Monic := hΔ_F_mon.map (algebraMap F k₀)
    have hΔ_k₀_ne : Δ_k₀ ≠ 0 := hMonNeZero hΔ_k₀_mon
    let R₀_k₀ : Type u := Localization.Away Δ_k₀
    have : IsDomain R₀_k₀ :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R₀_k₀
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_k₀_ne))
    have : IsPrincipalIdealRing R₀_k₀ := hPID_poly_loc k₀ R₀_k₀ (Submonoid.powers Δ_k₀)

    let _ : Algebra (Polynomial F) (Polynomial k₀) :=
      (Polynomial.mapRingHom (algebraMap F k₀)).toAlgebra
    have hΔF_eq_k₀ : algebraMap (Polynomial F) R₀_k₀ Δ_F = algebraMap (Polynomial k₀) R₀_k₀ Δ_k₀ :=
      IsScalarTower.algebraMap_apply (Polynomial F) (Polynomial k₀) R₀_k₀ Δ_F
    have hΔF_unit_k₀ : IsUnit (algebraMap (Polynomial F) R₀_k₀ Δ_F) := by
      rw [hΔF_eq_k₀]
      exact IsLocalization.Away.algebraMap_isUnit (S := R₀_k₀) Δ_k₀
    let j_R₀_k₀ : R₀ →+* R₀_k₀ := IsLocalization.Away.lift Δ_F hΔF_unit_k₀
    let _ : Algebra R₀ R₀_k₀ := j_R₀_k₀.toAlgebra
    have : IsScalarTower (Polynomial F) R₀ R₀_k₀ :=
      IsScalarTower.of_algebraMap_eq fun p =>
        (IsLocalization.Away.lift_eq Δ_F hΔF_unit_k₀ p).symm

    let φ_Pk₀_Br : Polynomial k₀ →ₐ[k₀] B_r :=
      Polynomial.aeval (algebraMap (Polynomial F) B_r Polynomial.X)
    have hφ_Pk₀_PF : φ_Pk₀_Br.toRingHom.comp (Polynomial.mapRingHom (algebraMap F k₀)) =
        algebraMap (Polynomial F) B_r := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, φ_Pk₀_Br, Polynomial.aeval_C,
          ← IsScalarTower.algebraMap_apply F k₀ B_r]
        exact IsScalarTower.algebraMap_apply F (Polynomial F) B_r c
      · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, φ_Pk₀_Br, Polynomial.aeval_X]
    have hΔk₀_unit_Br : IsUnit (φ_Pk₀_Br Δ_k₀) := by
      have h1 : φ_Pk₀_Br Δ_k₀ = algebraMap R₀ B_r (algebraMap (Polynomial F) R₀ Δ_F) := by
        rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r]
        exact RingHom.congr_fun hφ_Pk₀_PF Δ_F
      rw [h1]
      exact (IsLocalization.Away.algebraMap_isUnit (S := R₀) Δ_F).map (algebraMap R₀ B_r)
    let _ : Algebra (Polynomial k₀) B_r := φ_Pk₀_Br.toRingHom.toAlgebra
    let j_k₀_Br : R₀_k₀ →+* B_r := IsLocalization.Away.lift (S := R₀_k₀) Δ_k₀ hΔk₀_unit_Br
    let _ : Algebra R₀_k₀ B_r := j_k₀_Br.toAlgebra
    have : IsScalarTower (Polynomial k₀) R₀_k₀ B_r :=
      IsScalarTower.of_algebraMap_eq fun p =>
        (IsLocalization.Away.lift_eq (S := R₀_k₀) Δ_k₀ hΔk₀_unit_Br p).symm
    have : IsScalarTower R₀ R₀_k₀ B_r := by
      refine IsScalarTower.of_algebraMap_eq' ?_
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ_F)
      refine RingHom.ext fun p => ?_
      simp only [RingHom.comp_apply,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ R₀_k₀,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
        IsScalarTower.algebraMap_apply (Polynomial F) (Polynomial k₀) R₀_k₀,
        ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ B_r]
      exact (RingHom.congr_fun hφ_Pk₀_PF p).symm

    have hEt_F_k₀ : Algebra.Etale F k₀ := by
      let _ : Fintype k₀ := Fintype.ofFinite k₀
      have hNoeth_F : IsNoetherianRing F := by
        rw [isNoetherianRing_iff_ideal_fg]
        intro I
        by_cases hI : I = ⊥
        · exact hI ▸ Submodule.fg_bot
        · obtain ⟨x, hxI, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
          have htop : I = ⊤ := Ideal.eq_top_of_isUnit_mem I hxI (IsUnit.mk0 x hx0)
          rw [htop]
          exact ⟨{1}, by rw [Finset.coe_singleton, Ideal.span_singleton_one]⟩
      have hFT : Algebra.FiniteType F k₀ :=
        ⟨⟨Finset.univ, by rw [Finset.coe_univ, Algebra.adjoin_univ]⟩⟩
      have : Algebra.FinitePresentation F k₀ :=
        (@Algebra.FinitePresentation.of_finiteType F k₀ _ _ _ hNoeth_F).mp hFT
      have : Algebra.FormallyEtale F k₀ := Algebra.FormallyEtale.of_isSeparable F k₀
      exact Algebra.Etale.mk
    have hEt_PF_Pk₀ : Algebra.Etale (Polynomial F) (Polynomial k₀) := by
      have : Algebra.Etale (Polynomial F) (TensorProduct F (Polynomial F) k₀) :=
        Algebra.Etale.baseChange F k₀ (Polynomial F)
      let cAlg : k₀ →ₐ[F] Polynomial k₀ :=
        { toRingHom := Polynomial.C
          commutes' := fun _ => rfl }
      let fwd : TensorProduct F (Polynomial F) k₀ →ₐ[Polynomial F] Polynomial k₀ :=
        Algebra.TensorProduct.lift (Algebra.ofId (Polynomial F) (Polynomial k₀)) cAlg
          (fun _ _ => Commute.all _ _)
      let bwd : Polynomial k₀ →+* TensorProduct F (Polynomial F) k₀ :=
        Polynomial.eval₂RingHom Algebra.TensorProduct.includeRight.toRingHom
          (TensorProduct.tmul F Polynomial.X 1)
      have h_fb : fwd.toRingHom.comp bwd = RingHom.id (Polynomial k₀) := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          change fwd (Polynomial.eval₂ Algebra.TensorProduct.includeRight.toRingHom
            (TensorProduct.tmul F Polynomial.X 1) (Polynomial.C c)) = Polynomial.C c
          rw [Polynomial.eval₂_C]
          change (Algebra.TensorProduct.lift (Algebra.ofId (Polynomial F) (Polynomial k₀)) cAlg
            (fun _ _ => Commute.all _ _)) (TensorProduct.tmul F 1 c) = Polynomial.C c
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        · change (Algebra.TensorProduct.lift (Algebra.ofId (Polynomial F) (Polynomial k₀)) cAlg
            (fun _ _ => Commute.all _ _))
            (Polynomial.eval₂ Algebra.TensorProduct.includeRight.toRingHom
              (TensorProduct.tmul F Polynomial.X 1) Polynomial.X) = Polynomial.X
          rw [Polynomial.eval₂_X, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
          exact Polynomial.map_X (algebraMap F k₀)
      have h_bf : ∀ z : TensorProduct F (Polynomial F) k₀, bwd (fwd z) = z := by
        intro z
        let S_eq : AddSubmonoid (TensorProduct F (Polynomial F) k₀) :=
          { carrier := {w | bwd (fwd w) = w}
            zero_mem' := by change bwd (fwd 0) = 0; rw [map_zero, map_zero]
            add_mem' := fun {x y} hx hy => by
              change bwd (fwd (x + y)) = x + y
              rw [map_add, map_add]
              exact congrArg₂ (· + ·) hx hy }
        have h_mem : ∀ w ∈ (⊤ : Submodule F (TensorProduct F (Polynomial F) k₀)), w ∈ S_eq := by
          rw [← TensorProduct.span_tmul_eq_top]
          intro w hw
          refine Submodule.span_induction ?_ S_eq.zero_mem (fun _ _ _ _ => S_eq.add_mem) ?_ hw
          · rintro _ ⟨p, c, rfl⟩
            change bwd (fwd (TensorProduct.tmul F p c)) = TensorProduct.tmul F p c
            dsimp only [fwd]
            rw [Algebra.TensorProduct.lift_tmul, map_mul]
            have hp_eq : bwd (Algebra.ofId (Polynomial F) (Polynomial k₀) p) =
                TensorProduct.tmul F p (1 : k₀) := by
              induction p using Polynomial.induction_on' with
              | add p₁ p₂ h₁ h₂ =>
                rw [map_add, map_add, h₁, h₂, TensorProduct.add_tmul]
              | monomial n a =>
                rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
                have hCa_map : Algebra.ofId (Polynomial F) (Polynomial k₀) (Polynomial.C a) =
                    Polynomial.C (algebraMap F k₀ a) := Polynomial.map_C (algebraMap F k₀)
                have hX_map : Algebra.ofId (Polynomial F) (Polynomial k₀) Polynomial.X = Polynomial.X :=
                  Polynomial.map_X (algebraMap F k₀)
                rw [hCa_map, hX_map]
                change Polynomial.eval₂ Algebra.TensorProduct.includeRight.toRingHom
                    (TensorProduct.tmul F Polynomial.X 1) (Polynomial.C (algebraMap F k₀ a)) *
                  (Polynomial.eval₂ Algebra.TensorProduct.includeRight.toRingHom
                    (TensorProduct.tmul F Polynomial.X 1) Polynomial.X) ^ n = _
                rw [Polynomial.eval₂_C, Polynomial.eval₂_X]
                have hCa : TensorProduct.tmul F (1 : Polynomial F) (algebraMap F k₀ a) =
                    TensorProduct.tmul F (Polynomial.C a) (1 : k₀) := by
                  have h1 : (algebraMap F k₀ a : k₀) = a • (1 : k₀) := by
                    rw [Algebra.smul_def, mul_one]
                  have h2 : a • (1 : Polynomial F) = Polynomial.C a := by
                    rw [Algebra.smul_def, mul_one]
                    rfl
                  rw [h1, ← TensorProduct.smul_tmul, h2]
                change TensorProduct.tmul F 1 (algebraMap F k₀ a) *
                  (TensorProduct.tmul F Polynomial.X 1) ^ n = _
                have hX_pow : (TensorProduct.tmul F (Polynomial.X : Polynomial F) (1 : k₀)) ^ n =
                    TensorProduct.tmul F (Polynomial.X ^ n) 1 := by
                  rw [Algebra.TensorProduct.tmul_pow, one_pow]
                rw [hCa, hX_pow, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
            have hc_eq : bwd (cAlg c) = TensorProduct.tmul F (1 : Polynomial F) c := by
              change Polynomial.eval₂ Algebra.TensorProduct.includeRight.toRingHom
                (TensorProduct.tmul F Polynomial.X 1) (Polynomial.C c) = _
              rw [Polynomial.eval₂_C]
              rfl
            rw [hp_eq, hc_eq, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          · intro a w _ ihw
            change bwd (fwd (a • w)) = a • w
            have h1 : fwd (a • w) = Polynomial.C (algebraMap F k₀ a) * fwd w := by
              have ha : a • w = (Polynomial.C a) • w :=
                (IsScalarTower.algebraMap_smul (Polynomial F) a w).symm
              rw [ha, map_smul fwd, Algebra.smul_def]
              congr 1
              exact Polynomial.map_C (algebraMap F k₀)
            have h2 : bwd (Polynomial.C (algebraMap F k₀ a)) =
                a • (1 : TensorProduct F (Polynomial F) k₀) := by
              change Polynomial.eval₂ Algebra.TensorProduct.includeRight.toRingHom
                (TensorProduct.tmul F Polynomial.X 1) (Polynomial.C (algebraMap F k₀ a)) = _
              rw [Polynomial.eval₂_C]
              change TensorProduct.tmul F 1 (algebraMap F k₀ a) =
                a • (TensorProduct.tmul F (1 : Polynomial F) (1 : k₀))
              rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
            have h_ih : bwd (fwd w) = w := ihw
            rw [h1, map_mul, h2, h_ih, smul_mul_assoc, one_mul]
        exact h_mem z Submodule.mem_top
      have hbij : Function.Bijective fwd :=
        ⟨Function.HasLeftInverse.injective ⟨bwd, h_bf⟩,
         Function.HasRightInverse.surjective ⟨bwd, fun y => RingHom.congr_fun h_fb y⟩⟩
      exact Algebra.Etale.of_equiv (AlgEquiv.ofBijective fwd hbij)
    have : Algebra.Etale (Polynomial k₀) R₀_k₀ := by
      have : Algebra.FormallyEtale (Polynomial k₀) R₀_k₀ :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers Δ_k₀)
      have : Algebra.FinitePresentation (Polynomial k₀) R₀_k₀ :=
        IsLocalization.Away.finitePresentation Δ_k₀
      exact Algebra.Etale.mk
    have : Algebra.Etale (Polynomial F) R₀_k₀ :=
      Algebra.Etale.comp (Polynomial F) (Polynomial k₀) R₀_k₀
    have : Algebra.Etale (Polynomial F) R₀ := by
      have : Algebra.FormallyEtale (Polynomial F) R₀ :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers Δ_F)
      have : Algebra.FinitePresentation (Polynomial F) R₀ :=
        IsLocalization.Away.finitePresentation Δ_F
      exact Algebra.Etale.mk
    have : Algebra.Etale R₀ R₀_k₀ :=
      Algebra.Etale.of_restrictScalars (Polynomial F) R₀ R₀_k₀
    have : Algebra.Etale R₀_k₀ B_r :=
      Algebra.Etale.of_restrictScalars R₀ R₀_k₀ B_r

    have hΔ_k₀_unit_RF : IsUnit (algebraMap (Polynomial k₀) (RatFunc k₀) Δ_k₀) :=
      IsUnit.mk0 _ ((map_ne_zero_iff _
        (IsFractionRing.injective (Polynomial k₀) (RatFunc k₀))).mpr hΔ_k₀_ne)
    let _ : Algebra R₀_k₀ (RatFunc k₀) :=
      (IsLocalization.Away.lift (S := R₀_k₀) Δ_k₀ hΔ_k₀_unit_RF).toAlgebra
    have : IsScalarTower (Polynomial k₀) R₀_k₀ (RatFunc k₀) :=
      IsScalarTower.of_algebraMap_eq fun p =>
        (IsLocalization.Away.lift_eq (S := R₀_k₀) Δ_k₀ hΔ_k₀_unit_RF p).symm
    have : IsFractionRing R₀_k₀ (RatFunc k₀) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
        (Submonoid.powers Δ_k₀) R₀_k₀ (RatFunc k₀)
    have hj_k₀_Br_L : (algebraMap B_r L).comp (algebraMap R₀_k₀ B_r) =
        (algebraMap (RatFunc k₀) L).comp (algebraMap R₀_k₀ (RatFunc k₀)) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ_k₀)
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply,
          ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ B_r,
          ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ (RatFunc k₀)]
        have hC_RF : algebraMap (Polynomial k₀) (RatFunc k₀) (Polynomial.C c) =
            algebraMap k₀ (RatFunc k₀) c :=
          (IsScalarTower.algebraMap_apply k₀ (Polynomial k₀) (RatFunc k₀) c).symm
        rw [hC_RF, ← IsScalarTower.algebraMap_apply k₀ (RatFunc k₀) L]
        change algebraMap B_r L (φ_Pk₀_Br (Polynomial.C c)) = _
        rw [Polynomial.aeval_C, ← IsScalarTower.algebraMap_apply k₀ B_r L]
      · simp only [RingHom.comp_apply,
          ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ B_r,
          ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ (RatFunc k₀),
          RatFunc.algebraMap_X, hX_k₀]
        change algebraMap B_r L (φ_Pk₀_Br Polynomial.X) = _
        rw [Polynomial.aeval_X, ← IsScalarTower.algebraMap_apply (Polynomial F) B_r L,
          IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L, RatFunc.algebraMap_X]
    have hj_k₀_Br_inj : Function.Injective (algebraMap R₀_k₀ B_r) := by
      have hcomp_inj : Function.Injective ((algebraMap B_r L).comp (algebraMap R₀_k₀ B_r)) := by
        rw [hj_k₀_Br_L]
        have hinj_RF_L : Function.Injective (algebraMap (RatFunc k₀) L) := by
          intro x y hxy
          by_contra hne
          have h1 : algebraMap (RatFunc k₀) L ((x - y) * (x - y)⁻¹) = 0 := by
            rw [map_mul, map_sub, hxy, sub_self, zero_mul]
          rw [mul_inv_cancel₀ (sub_ne_zero.mpr hne), map_one] at h1
          rcases (inferInstance : Field L).toDivisionRing.toNontrivial with ⟨u₁, u₂, hu12⟩
          exact hu12 (calc
            u₁ = u₁ * 1 := (mul_one u₁).symm
            _ = u₁ * 0 := by rw [h1]
            _ = u₂ * 0 := by rw [mul_zero, mul_zero]
            _ = u₂ * 1 := by rw [← h1]
            _ = u₂ := mul_one u₂)
        exact hinj_RF_L.comp (IsFractionRing.injective R₀_k₀ (RatFunc k₀))
      exact Function.Injective.of_comp hcomp_inj
    have : Module.Finite R₀_k₀ B_r := Module.Finite.of_restrictScalars_finite R₀ R₀_k₀ B_r
    have : Module.IsTorsionFree R₀_k₀ B_r :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr hj_k₀_Br_inj
    have : Module.Free R₀_k₀ B_r := Module.free_of_finite_type_torsion_free'
    let b_Br := Module.Free.chooseBasis R₀_k₀ B_r

    have hLI_L : LinearIndependent (RatFunc k₀) (fun i => algebraMap B_r L (b_Br i)) := by
      rw [linearIndependent_iff']
      intro s g hsum i hi
      obtain ⟨d₀, hd₀⟩ :=
        IsLocalization.exist_integer_multiples (nonZeroDivisors R₀_k₀) s g
      choose r₀ hr₀ using fun j : s => hd₀ j.1 j.2
      have hd₀_ne : (d₀ : R₀_k₀) ≠ 0 := nonZeroDivisors.ne_zero d₀.2
      have hsum_Br : algebraMap B_r L (∑ j : s, r₀ j • b_Br j.1) = 0 := by
        rw [map_sum]
        calc ∑ j : s, algebraMap B_r L (r₀ j • b_Br j.1)
            = ∑ j : s, algebraMap (RatFunc k₀) L ((d₀ : R₀_k₀) • g j.1) *
                algebraMap B_r L (b_Br j.1) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              have h1 := RingHom.congr_fun hj_k₀_Br_L (r₀ j)
              simp only [RingHom.comp_apply] at h1
              rw [Algebra.smul_def, map_mul, h1, hr₀ j]
          _ = algebraMap (RatFunc k₀) L (algebraMap R₀_k₀ (RatFunc k₀) (d₀ : R₀_k₀)) *
                (∑ j ∈ s, g j • algebraMap B_r L (b_Br j)) := by
              rw [← Finset.sum_attach s (fun j => g j • algebraMap B_r L (b_Br j)), Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc]
          _ = 0 := by rw [hsum, mul_zero]
      have hsum_0 : ∑ j : s, r₀ j • b_Br j.1 = 0 :=
        IsFractionRing.injective B_r L (hsum_Br.trans (map_zero _).symm)
      have hLI_s : LinearIndependent R₀_k₀ (fun j : s => b_Br j.1) :=
        b_Br.linearIndependent.comp Subtype.val Subtype.val_injective
      have hr₀_0 : r₀ ⟨i, hi⟩ = 0 :=
        Fintype.linearIndependent_iff.mp hLI_s r₀ hsum_0 ⟨i, hi⟩
      have hdg0 : (d₀ : R₀_k₀) • g i = 0 := by
        rw [← hr₀ ⟨i, hi⟩, hr₀_0, map_zero]
      rw [Algebra.smul_def] at hdg0
      exact (mul_eq_zero.mp hdg0).resolve_left
        ((map_ne_zero_iff _ (IsFractionRing.injective R₀_k₀ (RatFunc k₀))).mpr hd₀_ne)

    have hLI_M : LinearIndependent (RatFunc k) (fun i => ψ_M (algebraMap B_r L (b_Br i))) :=
      hLinIndep _ hLI_L
    have hLI_Bk : LinearIndependent R₀_k (fun i => j_Bk (b_Br i)) := by
      rw [linearIndependent_iff']
      intro s c hsum i hi
      have hsum_M : ∑ j ∈ s, (algebraMap R₀_k (RatFunc k) (c j)) •
          ψ_M (algebraMap B_r L (b_Br j)) = 0 := by
        have h1 := congrArg (integralClosure R₀_k M).subtype hsum
        rw [map_zero, map_sum] at h1
        rw [← h1]
        refine Finset.sum_congr rfl fun j _ => ?_
        change (algebraMap R₀_k (RatFunc k) (c j)) • ψ_M (algebraMap B_r L (b_Br j)) =
          ((c j • j_Bk (b_Br j) : B_k) : M)
        rw [Subalgebra.coe_smul, Algebra.smul_def, Algebra.smul_def,
          IsScalarTower.algebraMap_apply R₀_k (RatFunc k) M]
        rfl
      have hc_RF : algebraMap R₀_k (RatFunc k) (c i) = 0 :=
        linearIndependent_iff'.mp hLI_M s (fun j => algebraMap R₀_k (RatFunc k) (c j)) hsum_M i hi
      exact IsFractionRing.injective R₀_k (RatFunc k) (hc_RF.trans (map_zero _).symm)

    have hΔk₀_map : Δ_k₀.map (algebraMap k₀ k) = Δ_k := by
      rw [hΔ_k, Polynomial.map_map]
      congr 1
      ext c
      exact (IsScalarTower.algebraMap_apply F k₀ k c).symm
    have hΔk₀_unit_R₀k :
        IsUnit (((algebraMap (Polynomial k) R₀_k).comp
          (Polynomial.mapRingHom (algebraMap k₀ k))) Δ_k₀) := by
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, hΔk₀_map]
      exact IsLocalization.Away.algebraMap_isUnit (S := R₀_k) Δ_k
    let j_k₀_k : R₀_k₀ →+* R₀_k := IsLocalization.Away.lift (S := R₀_k₀) Δ_k₀ hΔk₀_unit_R₀k
    let _ : Algebra R₀_k₀ R₀_k := j_k₀_k.toAlgebra
    let _ : Algebra R₀_k₀ B_k := ((algebraMap R₀_k B_k).comp j_k₀_k).toAlgebra
    have : IsScalarTower R₀_k₀ R₀_k B_k := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hj_Bk_k₀ : j_Bk.comp (algebraMap R₀_k₀ B_r) = algebraMap R₀_k₀ B_k := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ_k₀)
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply,
          ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ B_r]
        change ψ_M (algebraMap B_r L (φ_Pk₀_Br (Polynomial.C c))) =
          algebraMap R₀_k M (j_k₀_k (algebraMap (Polynomial k₀) R₀_k₀ (Polynomial.C c)))
        rw [Polynomial.aeval_C, ← IsScalarTower.algebraMap_apply k₀ B_r L,
          IsLocalization.Away.lift_eq (S := R₀_k₀) Δ_k₀ hΔk₀_unit_R₀k]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k M]
        have hC_M : algebraMap (Polynomial k) M (Polynomial.C (algebraMap k₀ k c)) =
            algebraMap k M (algebraMap k₀ k c) :=
          (IsScalarTower.algebraMap_apply k (Polynomial k) M (algebraMap k₀ k c)).symm
        rw [hC_M]
        exact RingHom.congr_fun hψ_k₀ c
      · ext
        simp only [RingHom.comp_apply,
          ← IsScalarTower.algebraMap_apply (Polynomial k₀) R₀_k₀ B_r]
        change ψ_M (algebraMap B_r L (φ_Pk₀_Br Polynomial.X)) =
          algebraMap R₀_k M (j_k₀_k (algebraMap (Polynomial k₀) R₀_k₀ Polynomial.X))
        rw [Polynomial.aeval_X, ← IsScalarTower.algebraMap_apply (Polynomial F) B_r L,
          IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L,
          RatFunc.algebraMap_X, ← hX_k₀, hψ_X,
          IsLocalization.Away.lift_eq (S := R₀_k₀) Δ_k₀ hΔk₀_unit_R₀k]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k M,
          IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) M, RatFunc.algebraMap_X]
    let j_Bk_alg : B_r →ₐ[R₀_k₀] B_k :=
      { toRingHom := j_Bk
        commutes' := fun r => RingHom.congr_fun hj_Bk_k₀ r }
    let Φ : TensorProduct R₀_k₀ R₀_k B_r →ₐ[R₀_k] B_k :=
      Algebra.TensorProduct.lift (Algebra.ofId R₀_k B_k) j_Bk_alg (fun _ _ => Commute.all _ _)
    let b_tens : Module.Basis _ R₀_k (TensorProduct R₀_k₀ R₀_k B_r) :=
      Algebra.TensorProduct.basis R₀_k b_Br
    have hΦ_basis : ∀ i, Φ (b_tens i) = j_Bk (b_Br i) := by
      intro i
      dsimp only [b_tens, Φ]
      rw [Algebra.TensorProduct.basis_apply, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have hΦ_inj : Function.Injective Φ := by
      let _ : Fintype (Module.Free.ChooseBasisIndex R₀_k₀ B_r) :=
        Fintype.ofFinite (Module.Free.ChooseBasisIndex R₀_k₀ B_r)
      change Function.Injective Φ.toLinearMap
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      rw [LinearMap.mem_ker] at hx
      have hx_eq : x = ∑ i, b_tens.repr x i • b_tens i := (b_tens.sum_repr x).symm
      have hsum0 : ∑ i, b_tens.repr x i • j_Bk (b_Br i) = 0 := by
        calc ∑ i, b_tens.repr x i • j_Bk (b_Br i)
            = ∑ i, Φ.toLinearMap (b_tens.repr x i • b_tens i) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Φ.toLinearMap.map_smul, AlgHom.toLinearMap_apply, hΦ_basis i]
          _ = Φ.toLinearMap (∑ i, b_tens.repr x i • b_tens i) := (map_sum Φ.toLinearMap _ _).symm
          _ = Φ.toLinearMap x := by rw [← hx_eq]
          _ = 0 := hx
      have hrepr0 : ∀ i, b_tens.repr x i = 0 :=
        Fintype.linearIndependent_iff.mp hLI_Bk (fun i => b_tens.repr x i) hsum0
      rw [hx_eq]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [hrepr0 i, zero_smul]
    have hΦ_surj : Function.Surjective Φ := by
      intro z
      have hz_top : z ∈ (⊤ : Subalgebra R₀_k B_k) := Algebra.mem_top
      rw [← hj_Bk_adjoin] at hz_top
      have hle : Algebra.adjoin R₀_k (Set.range j_Bk) ≤ Φ.range := by
        rw [Algebra.adjoin_le_iff]
        rintro _ ⟨b, rfl⟩
        refine ⟨TensorProduct.tmul R₀_k₀ 1 b, ?_⟩
        change Φ (TensorProduct.tmul R₀_k₀ 1 b) = j_Bk b
        dsimp only [Φ]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      exact hle hz_top
    have hEt_Bk : Algebra.Etale R₀_k B_k := by
      have : Algebra.Etale R₀_k (TensorProduct R₀_k₀ R₀_k B_r) :=
