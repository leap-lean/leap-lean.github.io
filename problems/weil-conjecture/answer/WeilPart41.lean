      exact ⟨Finite.of_equiv _ e_tot.symm.toEquiv,
        le_of_eq ((Nat.card_congr e_tot.toEquiv).trans hCard2_P1Ω')⟩

    have hBC_W : ∀ (α : Fin M) (b : ℕ),
