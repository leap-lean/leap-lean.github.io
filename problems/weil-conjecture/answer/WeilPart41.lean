          Limits.IsZero A₃ →
          Limits.IsZero B₃ →
          ∀ (φ₀ : A₀ ⟶ B₀) (φ₁ : A₁ ⟶ B₁) (φ₂ : A₂ ⟶ B₂) (φ₃ : A₃ ⟶ B₃),
          a₀ ≫ φ₁ = φ₀ ≫ b₀ →
          a₁ ≫ φ₂ = φ₁ ≫ b₁ →
          a₂ ≫ φ₃ = φ₂ ≫ b₂ →
          Epi φ₀ → IsIso φ₁ →
          IsIso φ₂) ∧
      (∀ {X₁ X₂ X₃ X₄ : 𝒜_S'}
          (f₁ : X₁ ⟶ X₂) (d : X₂ ⟶ X₃) (g₁ : X₃ ⟶ X₄)
          (h₁ : f₁ ≫ d = 0) (h₂ : d ≫ g₁ = 0),
          (ShortComplex.mk f₁ d h₁).Exact →
          (ShortComplex.mk d g₁ h₂).Exact →
          Limits.IsZero X₁ →
          Limits.IsZero X₄ →
          IsIso d) := by
    clear * -
    have h5 : ∀ {A₀ A₁ A₂ A₃ A₄ B₀ B₁ B₂ B₃ B₄ : 𝒜_S'}
        (a₀ : A₀ ⟶ A₁) (a₁ : A₁ ⟶ A₂) (a₂ : A₂ ⟶ A₃) (a₃ : A₃ ⟶ A₄)
        (b₀ : B₀ ⟶ B₁) (b₁ : B₁ ⟶ B₂) (b₂ : B₂ ⟶ B₃) (b₃ : B₃ ⟶ B₄)
        (ha₀₁ : a₀ ≫ a₁ = 0) (ha₁₂ : a₁ ≫ a₂ = 0) (ha₂₃ : a₂ ≫ a₃ = 0)
        (hb₀₁ : b₀ ≫ b₁ = 0) (hb₁₂ : b₁ ≫ b₂ = 0) (hb₂₃ : b₂ ≫ b₃ = 0),
        (ShortComplex.mk a₀ a₁ ha₀₁).Exact →
        (ShortComplex.mk a₁ a₂ ha₁₂).Exact →
        (ShortComplex.mk a₂ a₃ ha₂₃).Exact →
        (ShortComplex.mk b₀ b₁ hb₀₁).Exact →
        (ShortComplex.mk b₁ b₂ hb₁₂).Exact →
        (ShortComplex.mk b₂ b₃ hb₂₃).Exact →
        ∀ (φ₀ : A₀ ⟶ B₀) (φ₁ : A₁ ⟶ B₁) (φ₂ : A₂ ⟶ B₂) (φ₃ : A₃ ⟶ B₃) (φ₄ : A₄ ⟶ B₄),
        a₀ ≫ φ₁ = φ₀ ≫ b₀ →
        a₁ ≫ φ₂ = φ₁ ≫ b₁ →
        a₂ ≫ φ₃ = φ₂ ≫ b₂ →
        a₃ ≫ φ₄ = φ₃ ≫ b₃ →
        Epi φ₀ → IsIso φ₁ → IsIso φ₃ → Mono φ₄ →
        IsIso φ₂ := by
      intro A₀ A₁ A₂ A₃ A₄ B₀ B₁ B₂ B₃ B₄ a₀ a₁ a₂ a₃ b₀ b₁ b₂ b₃
        ha₀₁ ha₁₂ ha₂₃ hb₀₁ hb₁₂ hb₂₃ hA₀ hA₁ hA₂ hB₀ hB₁ hB₂
        φ₀ φ₁ φ₂ φ₃ φ₄ hc₀ hc₁ hc₂ hc₃ hφ₀ hφ₁ hφ₃ hφ₄
      let R₁ := ComposableArrows.mk₄ a₀ a₁ a₂ a₃
      let R₂ := ComposableArrows.mk₄ b₀ b₁ b₂ b₃
      have hR₁ : R₁.Exact :=
        ComposableArrows.exact_of_δ₀ hA₀.exact_toComposableArrows
          (ComposableArrows.exact_of_δ₀ hA₁.exact_toComposableArrows hA₂.exact_toComposableArrows)
      have hR₂ : R₂.Exact :=
        ComposableArrows.exact_of_δ₀ hB₀.exact_toComposableArrows
          (ComposableArrows.exact_of_δ₀ hB₁.exact_toComposableArrows hB₂.exact_toComposableArrows)
      let Φ : R₁ ⟶ R₂ := ComposableArrows.homMk₄ φ₀ φ₁ φ₂ φ₃ φ₄ hc₀ hc₁ hc₂ hc₃
      exact Abelian.isIso_of_epi_of_isIso_of_isIso_of_mono hR₁ hR₂ Φ hφ₀ hφ₁ hφ₃ hφ₄
    refine ⟨h5, ?_, ?_, ?_⟩
    · intro A₁ A₂ A₃ A₄ B₁ B₂ B₃ B₄ a₁ a₂ a₃ b₁ b₂ b₃ _ _ ha₁₂ ha₂₃ hb₁₂ hb₂₃
        hA₁ hA₂ hB₁ hB₂ φ₁ φ₂ φ₃ φ₄ hc₁ hc₂ hc₃ hφ₁ hφ₃ hφ₄
      let Z : 𝒜_S' := ⊤_ 𝒜_S'
      have hZ : Limits.IsZero Z :=
        (Limits.IsZero.iff_id_eq_zero Z).mpr (Limits.terminal.hom_ext _ _)
      have hA₀ : (ShortComplex.mk (0 : Z ⟶ A₁) a₁ Limits.zero_comp).Exact :=
        (ShortComplex.exact_iff_mono _ rfl).mpr inferInstance
      have hB₀ : (ShortComplex.mk (0 : Z ⟶ B₁) b₁ Limits.zero_comp).Exact :=
        (ShortComplex.exact_iff_mono _ rfl).mpr inferInstance
      have hEpi0 : Epi (0 : Z ⟶ Z) := ⟨fun g₁ g₂ _ => hZ.eq_of_src g₁ g₂⟩
      exact h5 (0 : Z ⟶ A₁) a₁ a₂ a₃ (0 : Z ⟶ B₁) b₁ b₂ b₃
        Limits.zero_comp ha₁₂ ha₂₃ Limits.zero_comp hb₁₂ hb₂₃
        hA₀ hA₁ hA₂ hB₀ hB₁ hB₂ (0 : Z ⟶ Z) φ₁ φ₂ φ₃ φ₄
        (by simp) hc₁ hc₂ hc₃ hEpi0 hφ₁ hφ₃ (@IsIso.mono_of_iso _ _ _ _ φ₄ hφ₄)
    · intro A₀ A₁ A₂ A₃ B₀ B₁ B₂ B₃ a₀ a₁ a₂ b₀ b₁ b₂ ha₀₁ ha₁₂ hb₀₁ hb₁₂
        hA₀ hA₁ hB₀ hB₁ hZA₃ hZB₃ φ₀ φ₁ φ₂ φ₃ hc₀ hc₁ hc₂ hφ₀ hφ₁
      have hEpi_a₂ : Epi a₂ := ⟨fun g₁ g₂ _ => hZA₃.eq_of_src g₁ g₂⟩
      have hEpi_b₂ : Epi b₂ := ⟨fun g₁ g₂ _ => hZB₃.eq_of_src g₁ g₂⟩
      have hA₂ : (ShortComplex.mk a₂ (0 : A₃ ⟶ A₃) Limits.comp_zero).Exact :=
        (ShortComplex.exact_iff_epi _ rfl).mpr hEpi_a₂
      have hB₂ : (ShortComplex.mk b₂ (0 : B₃ ⟶ B₃) Limits.comp_zero).Exact :=
        (ShortComplex.exact_iff_epi _ rfl).mpr hEpi_b₂
      have hφ₃ : IsIso φ₃ := ⟨⟨0, hZA₃.eq_of_src _ _, hZB₃.eq_of_src _ _⟩⟩
      exact h5 a₀ a₁ a₂ (0 : A₃ ⟶ A₃) b₀ b₁ b₂ (0 : B₃ ⟶ B₃)
        ha₀₁ ha₁₂ Limits.comp_zero hb₀₁ hb₁₂ Limits.comp_zero
        hA₀ hA₁ hA₂ hB₀ hB₁ hB₂ φ₀ φ₁ φ₂ φ₃ φ₃
        hc₀ hc₁ hc₂ (by simp) hφ₀ hφ₁ hφ₃ (@IsIso.mono_of_iso _ _ _ _ φ₃ hφ₃)
    · intro X₁ X₂ X₃ X₄ f₁ d g₁ h₁ h₂ hEx₁ hEx₂ hZX₁ hZX₄
      have hf₀ : f₁ = 0 := hZX₁.eq_of_src f₁ 0
      have hg₀ : g₁ = 0 := hZX₄.eq_of_tgt g₁ 0
      have : Mono d := hEx₁.mono_g hf₀
      have : Epi d := hEx₂.epi_f hg₀
      exact isIso_of_mono_of_epi d

  have hModPrimeBC : ∀ (p : ℕ)
      (F : CategoryTheory.Sheaf X_k.left.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      CategoryTheory.IsIso (bc F p) := by
    intro p
    induction p with
    | zero =>
      intro F hF
      let e_fun := weilOuterBCFunIso g_k.left η_k f'_k g'_k hpb.w
      have := CategoryTheory.Functor.isContinuous_comp
        (weilEtaleSitePullback g_k.left) (weilEtaleSitePullback g'_k)
        U_k.left.smallEtaleTopology X_k.left.smallEtaleTopology X'.smallEtaleTopology
      have := CategoryTheory.Functor.isContinuous_comp
        (weilEtaleSitePullback η_k) (weilEtaleSitePullback f'_k)
        U_k.left.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
      let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun
        AddCommGrpCat.{u} U_k.left.smallEtaleTopology X'.smallEtaleTopology
      let m₀ := (adj_η.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm
        (pf_f.map (adj_g'.unit.app F) ≫ e_pf.hom.app (pb_g'.obj F))
      obtain ⟨e_S, e_S', hcomm0⟩ :=
        weil_outer_bc_deg_zero_mate_comparison g_k.left η_k f'_k g'_k hpb.w F (hβ_push F 0)
      have hIso_eS : CategoryTheory.IsIso (pb_η.map e_S.hom) := (pb_η.mapIso e_S).isIso_hom
      have hIso_m0 : CategoryTheory.IsIso m₀ := hMateIso F hF
      have hbc0_eq : bc F 0 = (pb_η.map e_S.hom ≫ m₀) ≫ e_S'.inv := by
        dsimp only [bc]
        rw [hcomm0, Category.assoc, e_S'.hom_inv_id, Category.comp_id]
      rw [hbc0_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
        (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_eS hIso_m0) e_S'.isIso_inv
    | succ p ih =>
      intro F hF
      obtain ⟨I, hInjI, Q, u, v, huv, hTorQ, hSE⟩ := hModPrimeEmbed_all X_k.left F hF
      have : CategoryTheory.Injective I := hInjI
      let SC := CategoryTheory.ShortComplex.mk u v huv
      let hSE' : (SC.map pb_g').ShortExact := hSE.map_of_exact pb_g'
      cases p with
      | zero =>
        obtain ⟨_, h0_left_S, h0_right_S, _, hex_left_S, hex_right_S⟩ := hLES g_k.left hSE 0
        obtain ⟨_, h0_left_S', h0_right_S', _, hex_left_S', hex_right_S'⟩ := hLES f'_k hSE' 0
        let a₀ := pb_η.map (weilEtaleHigherDirectImageMap g_k.left 0 v)
        let a₁ := pb_η.map (δ_conn g_k.left hSE 0)
        let a₂ := pb_η.map (weilEtaleHigherDirectImageMap g_k.left 1 u)
        let b₀ := weilEtaleHigherDirectImageMap f'_k 0 (pb_g'.map v)
        let b₁ := δ_conn f'_k hSE' 0
        let b₂ := weilEtaleHigherDirectImageMap f'_k 1 (pb_g'.map u)
        have ha₀₁ : a₀ ≫ a₁ = 0 := by
          dsimp only [a₀, a₁]
          rw [← pb_η.map_comp, h0_left_S, pb_η.map_zero]
        have ha₁₂ : a₁ ≫ a₂ = 0 := by
          dsimp only [a₁, a₂]
          rw [← pb_η.map_comp, h0_right_S, pb_η.map_zero]
        have hZA₃ : CategoryTheory.Limits.IsZero
            (pb_η.obj (weilEtaleHigherDirectImage g_k.left 1 (U_sh_X.obj I))) :=
          pb_η.map_isZero
            (weil_etale_mod_prime_injective_higherDirectImage_isZero ℓ g_k.left I 1 (le_refl 1))
        have hZB₃ : CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage f'_k 1 (pb_g'.obj (U_sh_X.obj I))) :=
          hPBC_inj_S' I 1 (le_refl 1)
        have hIso_I0 : CategoryTheory.IsIso (bc (U_sh_X.obj I) 0) :=
          ih (U_sh_X.obj I) (hTorU_all X_k.left I)
        have hIso_Q0 : CategoryTheory.IsIso (bc Q 0) := ih Q hTorQ
        exact hCokFive a₀ a₁ a₂ b₀ b₁ b₂ ha₀₁ ha₁₂ h0_left_S' h0_right_S'
          (hex_left_S.map pb_η) (hex_right_S.map pb_η) hex_left_S' hex_right_S'
          hZA₃ hZB₃
          (bc (U_sh_X.obj I) 0) (bc Q 0) (bc F 1) (bc (U_sh_X.obj I) 1)
          (hbc_mor v 0) (hbc_conn hSE 0) (hbc_mor u 1)
          (@CategoryTheory.IsIso.epi_of_iso _ _ _ _ _ hIso_I0) hIso_Q0
      | succ p' =>
        obtain ⟨_, h0_left_S, h0_right_S, _, hex_left_S, hex_right_S⟩ :=
          hLES g_k.left hSE (p' + 1)
        obtain ⟨_, h0_left_S', h0_right_S', _, hex_left_S', hex_right_S'⟩ :=
          hLES f'_k hSE' (p' + 1)
        let f₁_S := pb_η.map (weilEtaleHigherDirectImageMap g_k.left (p' + 1) v)
        let d_S := pb_η.map (δ_conn g_k.left hSE (p' + 1))
        let g₁_S := pb_η.map (weilEtaleHigherDirectImageMap g_k.left (p' + 2) u)
        have h₁_S : f₁_S ≫ d_S = 0 := by
          dsimp only [f₁_S, d_S]
          rw [← pb_η.map_comp, h0_left_S, pb_η.map_zero]
        have h₂_S : d_S ≫ g₁_S = 0 := by
          dsimp only [d_S, g₁_S]
          rw [← pb_η.map_comp, h0_right_S, pb_η.map_zero]
        have hIso_dS : CategoryTheory.IsIso d_S :=
          hConnZeroIso f₁_S d_S g₁_S h₁_S h₂_S (hex_left_S.map pb_η) (hex_right_S.map pb_η)
            (pb_η.map_isZero
              (weil_etale_mod_prime_injective_higherDirectImage_isZero ℓ g_k.left I (p' + 1)
                (by omega)))
            (pb_η.map_isZero
              (weil_etale_mod_prime_injective_higherDirectImage_isZero ℓ g_k.left I (p' + 2)
                (by omega)))
        have hIso_dS' : CategoryTheory.IsIso (δ_conn f'_k hSE' (p' + 1)) :=
          hConnZeroIso _ (δ_conn f'_k hSE' (p' + 1)) _ h0_left_S' h0_right_S'
            hex_left_S' hex_right_S'
            (hPBC_inj_S' I (p' + 1) (by omega))
            (hPBC_inj_S' I (p' + 2) (by omega))
        have hIso_Qp : CategoryTheory.IsIso (bc Q (p' + 1)) := ih Q hTorQ
        have hcomm := hbc_conn hSE (p' + 1)
        have h_eq : bc F (p' + 2) =
            CategoryTheory.inv d_S ≫ (bc Q (p' + 1) ≫ δ_conn f'_k hSE' (p' + 1)) := by
          change bc F (p' + 2) =
            CategoryTheory.inv d_S ≫ (bc SC.X₃ (p' + 1) ≫ δ_conn f'_k hSE' (p' + 1))
          rw [← hcomm]
          change _ = CategoryTheory.inv d_S ≫ (d_S ≫ bc F (p' + 2))
          rw [CategoryTheory.IsIso.inv_hom_id_assoc]
        rw [h_eq]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
          (@CategoryTheory.IsIso.inv_isIso _ _ _ _ d_S hIso_dS)
          (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_Qp hIso_dS')

  
  let AM_fn : ℕ → AddCommGrpCat.{u} :=
    fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  obtain ⟨_, hConstProps, hZeroAnn, hBockZMod_all⟩ :=
    weil_outer_bc_const_pullback_and_bockstein_ses.{u}
  obtain ⟨hConstIso_g', _, hNatCoeff_g'⟩ := hConstProps g'_k
  let π_m : ∀ m : ℕ,
      pb_g'.obj (weilEtaleTorsionSheaf X_k.left m) ⟶ weilEtaleTorsionSheaf X' m :=
    fun m => weilEtaleConstPullbackHom g'_k hT_X' hT_Xk (AM_fn m)
  have hHDI_iso : ∀ {Y Z : AlgebraicGeometry.Scheme.{u}} (h : Y ⟶ Z)
      {F₁ F₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : F₁ ⟶ F₂) [CategoryTheory.IsIso φ] (p : ℕ),
      CategoryTheory.IsIso (weilEtaleHigherDirectImageMap h p φ) := by
    intro Y Z h F₁ F₂ φ _ p
    refine ⟨⟨weilEtaleHigherDirectImageMap h p (CategoryTheory.inv φ), ?_, ?_⟩⟩
    · rw [← (hConnPkg h).2.1 φ (CategoryTheory.inv φ) p, CategoryTheory.IsIso.hom_inv_id,
        (hConnPkg h).1 F₁ p]
    · rw [← (hConnPkg h).2.1 (CategoryTheory.inv φ) φ p, CategoryTheory.IsIso.inv_hom_id,
        (hConnPkg h).1 F₂ p]
  have hπ_m_iso : ∀ (m : ℕ), CategoryTheory.IsIso (π_m m) :=
    fun m => hConstIso_g' hT_X' hT_Xk (AM_fn m)
  let bcTor : ∀ (m p : ℕ),
      pb_η.obj (weilEtaleHigherDirectImage g_k.left p (weilEtaleTorsionSheaf X_k.left m)) ⟶
        weilEtaleHigherDirectImage f'_k p (weilEtaleTorsionSheaf X' m) :=
    fun m p => bc (weilEtaleTorsionSheaf X_k.left m) p ≫ weilEtaleHigherDirectImageMap f'_k p (π_m m)
  have hbcTor_prime : ∀ (p : ℕ), CategoryTheory.IsIso (bcTor ℓ p) := by
    intro p
    have hIso_bc : CategoryTheory.IsIso (bc (weilEtaleTorsionSheaf X_k.left ℓ) p) :=
      hModPrimeBC p (weilEtaleTorsionSheaf X_k.left ℓ) (hZeroAnn g_k.left 0 ℓ).2
    have : CategoryTheory.IsIso (π_m ℓ) := hπ_m_iso ℓ
    have hIso_map : CategoryTheory.IsIso (weilEtaleHigherDirectImageMap f'_k p (π_m ℓ)) :=
      hHDI_iso f'_k (π_m ℓ) p
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_bc hIso_map
  let C_X := CategoryTheory.constantSheaf X_k.left.smallEtaleTopology AddCommGrpCat.{u}
  let C_X' := CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}
  have : C_X.Additive := by dsimp [C_X, CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_X := by
    dsimp [C_X, CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteColimits C_X := by
    dsimp [C_X, CategoryTheory.constantSheaf]; infer_instance
  have : C_X'.Additive := by dsimp [C_X', CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_X' := by
    dsimp [C_X', CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteColimits C_X' := by
    dsimp [C_X', CategoryTheory.constantSheaf]; infer_instance
  have hbcTor_mor : ∀ {m₁ m₂ : ℕ} (φ : AM_fn m₁ ⟶ AM_fn m₂) (p : ℕ),
      pb_η.map (weilEtaleHigherDirectImageMap g_k.left p (C_X.map φ)) ≫ bcTor m₂ p =
        bcTor m₁ p ≫ weilEtaleHigherDirectImageMap f'_k p (C_X'.map φ) := by
    intro m₁ m₂ φ p
    dsimp only [bcTor]
    rw [← Category.assoc, hbc_mor (C_X.map φ) p, Category.assoc,
      ← (hConnPkg f'_k).2.1 (pb_g'.map (C_X.map φ)) (π_m m₂) p,
      hNatCoeff_g' hT_X' hT_Xk φ,
      (hConnPkg f'_k).2.1 (π_m m₁) (C_X'.map φ) p, ← Category.assoc]
  have hTorPowBC : ∀ (s₀ p : ℕ), CategoryTheory.IsIso (bcTor (ℓ ^ s₀) p) := by
    intro s₀
    induction s₀ with
    | zero =>
      intro p
      have hZ_L : CategoryTheory.Limits.IsZero
          (pb_η.obj (weilEtaleHigherDirectImage g_k.left p (weilEtaleTorsionSheaf X_k.left 1))) :=
        pb_η.map_isZero (hZeroAnn g_k.left p 1).1
      have hZ_R : CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage f'_k p (weilEtaleTorsionSheaf X' 1)) :=
        (hZeroAnn f'_k p 1).1
      exact ⟨⟨0, hZ_L.eq_of_src _ _, hZ_R.eq_of_src _ _⟩⟩
    | succ s₀ ih =>
      obtain ⟨u_s, v_s, huv_s, hSE₀⟩ := hBockZMod_all ℓ s₀
      have huv_X : (C_X.map u_s : weilEtaleTorsionSheaf X_k.left ℓ ⟶
            weilEtaleTorsionSheaf X_k.left (ℓ ^ (s₀ + 1))) ≫
          (C_X.map v_s : weilEtaleTorsionSheaf X_k.left (ℓ ^ (s₀ + 1)) ⟶
            weilEtaleTorsionSheaf X_k.left (ℓ ^ s₀)) = 0 := by
        change C_X.map u_s ≫ C_X.map v_s = 0
        rw [← C_X.map_comp, huv_s, C_X.map_zero]
      have huv_X' : (C_X'.map u_s : weilEtaleTorsionSheaf X' ℓ ⟶
            weilEtaleTorsionSheaf X' (ℓ ^ (s₀ + 1))) ≫
          (C_X'.map v_s : weilEtaleTorsionSheaf X' (ℓ ^ (s₀ + 1)) ⟶
            weilEtaleTorsionSheaf X' (ℓ ^ s₀)) = 0 := by
        change C_X'.map u_s ≫ C_X'.map v_s = 0
        rw [← C_X'.map_comp, huv_s, C_X'.map_zero]
      let SC_X := CategoryTheory.ShortComplex.mk
        (C_X.map u_s : weilEtaleTorsionSheaf X_k.left ℓ ⟶
          weilEtaleTorsionSheaf X_k.left (ℓ ^ (s₀ + 1)))
        (C_X.map v_s : weilEtaleTorsionSheaf X_k.left (ℓ ^ (s₀ + 1)) ⟶
          weilEtaleTorsionSheaf X_k.left (ℓ ^ s₀))
        huv_X
      let SC_X' := CategoryTheory.ShortComplex.mk
        (C_X'.map u_s : weilEtaleTorsionSheaf X' ℓ ⟶ weilEtaleTorsionSheaf X' (ℓ ^ (s₀ + 1)))
        (C_X'.map v_s : weilEtaleTorsionSheaf X' (ℓ ^ (s₀ + 1)) ⟶ weilEtaleTorsionSheaf X' (ℓ ^ s₀))
        huv_X'
      have hSE_X : SC_X.ShortExact := hSE₀.map_of_exact C_X
      have hSE_X' : SC_X'.ShortExact := hSE₀.map_of_exact C_X'
      let Φ_s : SC_X.map pb_g' ⟶ SC_X' :=
        { τ₁ := π_m ℓ
          τ₂ := π_m (ℓ ^ (s₀ + 1))
          τ₃ := π_m (ℓ ^ s₀)
          comm₁₂ := (hNatCoeff_g' hT_X' hT_Xk u_s).symm
          comm₂₃ := (hNatCoeff_g' hT_X' hT_Xk v_s).symm }
      have hbcTor_conn : ∀ (p : ℕ),
          pb_η.map (δ_conn g_k.left hSE_X p) ≫ bcTor ℓ (p + 1) =
            bcTor (ℓ ^ s₀) p ≫ δ_conn f'_k hSE_X' p := by
        intro p
        dsimp only [bcTor]
        have hc1 : pb_η.map (δ_conn g_k.left hSE_X p) ≫
            bc (weilEtaleTorsionSheaf X_k.left ℓ) (p + 1) =
            bc (weilEtaleTorsionSheaf X_k.left (ℓ ^ s₀)) p ≫
              δ_conn f'_k (hSE_X.map_of_exact pb_g') p :=
          hbc_conn hSE_X p
        have hc2 : weilEtaleHigherDirectImageMap f'_k p (π_m (ℓ ^ s₀)) ≫ δ_conn f'_k hSE_X' p =
            δ_conn f'_k (hSE_X.map_of_exact pb_g') p ≫
              weilEtaleHigherDirectImageMap f'_k (p + 1) (π_m ℓ) :=
          (hConnPkg f'_k).2.2.2.2 (hSE_X.map_of_exact pb_g') hSE_X' Φ_s p
            (hδ_conn f'_k (hSE_X.map_of_exact pb_g') p) (hδ_conn f'_k hSE_X' p)
        rw [← Category.assoc, hc1, Category.assoc, ← hc2, ← Category.assoc]
