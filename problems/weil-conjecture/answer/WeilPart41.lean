    let Δ := CategoryTheory.Limits.pullback.diagonal p_X
    have hΔ_closed : AlgebraicGeometry.IsClosedImmersion Δ := inferInstance
    let L_pb := CategoryTheory.Limits.pullback.lift f₁ f₂ hf_over
