      have hb_T : b_T () = e_KT ((1 : T) ⊗ₜ[R_line] b_R ()) := by
        dsimp [b_T]
        rw [Module.Basis.baseChange_apply]
      rw [hb_T]
    letI : Algebra P T := φ_target.toAlgebra
    haveI : IsScalarTower κ₁ P T := ⟨fun c q t => by
      change φ_target (c • q) * t = c • (φ_target q * t)
      rw [Algebra.smul_def, map_mul, mul_assoc]
      have hc_eq : φ_target (algebraMap κ₁ P c) = algebraMap R_line T (algebraMap κ₁ R_line c) := by
        change Polynomial.eval₂ ((algebraMap R_line T).comp (α_1.comp Polynomial.C))
          (algebraMap R_line T (α_2 h)) (Polynomial.C c) = _
        rw [Polynomial.eval₂_C]
        rfl
      rw [hc_eq, ← IsScalarTower.algebraMap_apply κ₁ R_line T c, ← Algebra.smul_def]⟩
    haveI : Algebra.FinitePresentation P T :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation κ₁ P T
    let b_PT : Module.Basis Unit T (TensorProduct P T Ω[P⁄κ₁]) := b_P.baseChange T
    have hmbc_unit : KaehlerDifferential.mapBaseChange κ₁ P T (b_PT ()) =
        (algebraMap R_line T g_et) • b_T () := by
      dsimp [b_PT]
      rw [Module.Basis.baseChange_apply, hb_P, KaehlerDifferential.mapBaseChange_tmul,
        one_smul, KaehlerDifferential.map_D]
      change KaehlerDifferential.D κ₁ T (φ_target Polynomial.X) = _
      have hX_eq : φ_target Polynomial.X = algebraMap R_line T (α_2 h) := by
        change Polynomial.eval₂ ((algebraMap R_line T).comp (α_1.comp Polynomial.C))
          (algebraMap R_line T (α_2 h)) Polynomial.X = _
        exact Polynomial.eval₂_X _ _
      rw [hX_eq]
      exact hD_T_h
    have hmbc_eq : ∀ x : TensorProduct P T Ω[P⁄κ₁],
        KaehlerDifferential.mapBaseChange κ₁ P T x =
          (b_PT.repr x () * algebraMap R_line T g_et) • b_T () := by
      intro x
      have hx : x = (b_PT.repr x ()) • b_PT () := by
        have hrepr := (b_PT.sum_repr x).symm
        rw [Fintype.sum_unique] at hrepr
        exact hrepr
      conv_lhs => rw [hx]
      rw [map_smul, hmbc_unit, smul_smul]
    let u_g : Tˣ := (IsLocalization.Away.algebraMap_isUnit (S := T) g_et).unit
    have hu_g : (↑u_g : T) = algebraMap R_line T g_et := rfl
    have hmbc_inj : Function.Injective (KaehlerDifferential.mapBaseChange κ₁ P T) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      rw [hmbc_eq x] at hx
      have hc0 : b_PT.repr x () * (↑u_g : T) = 0 := by
        have hrep := congrArg (fun ω => b_T.repr ω ()) hx
        simpa [b_T.repr_self, hu_g] using hrep
      have hrepr0 : b_PT.repr x () = 0 := by
        calc b_PT.repr x ()
            = (b_PT.repr x () * (↑u_g : T)) * (↑u_g⁻¹ : T) := by
                rw [mul_assoc, Units.mul_inv, mul_one]
          _ = 0 := by rw [hc0, zero_mul]
      have hx_eq : x = (b_PT.repr x ()) • b_PT () := by
        have hrepr := (b_PT.sum_repr x).symm
        rw [Fintype.sum_unique] at hrepr
        exact hrepr
      rw [hx_eq, hrepr0, zero_smul]
    have hmbc_surj : Function.Surjective (KaehlerDifferential.mapBaseChange κ₁ P T) := by
      intro ω
      let c := b_T.repr ω ()
      refine ⟨(c * (↑u_g⁻¹ : T)) • b_PT (), ?_⟩
      rw [map_smul, hmbc_unit, smul_smul, ← hu_g, mul_assoc, Units.inv_mul, mul_one]
      have hω : ω = c • b_T () := by
        have hrepr := (b_T.sum_repr ω).symm
        rw [Fintype.sum_unique] at hrepr
        exact hrepr
      exact hω.symm
    have hSub_Ω : _root_.Subsingleton Ω[T⁄P] := by
      refine _root_.Subsingleton.intro fun a b => ?_
      have h0 : ∀ ω : Ω[T⁄P], ω = 0 := by
        intro ω
        obtain ⟨x, rfl⟩ := KaehlerDifferential.map_surjective κ₁ P T ω
        obtain ⟨y, rfl⟩ := hmbc_surj x
        exact (KaehlerDifferential.exact_mapBaseChange_map κ₁ P T _).mpr ⟨y, rfl⟩
      exact (h0 a).trans (h0 b).symm
    have hSub_H1 : _root_.Subsingleton (Algebra.H1Cotangent P T) := by
      haveI : _root_.Subsingleton (Algebra.H1Cotangent κ₁ T) :=
        Algebra.FormallySmooth.subsingleton_h1Cotangent
      refine _root_.Subsingleton.intro fun z₁ z₂ => ?_
      have h0 : ∀ z : Algebra.H1Cotangent P T, z = 0 := by
        intro z
        have hmb0 : KaehlerDifferential.mapBaseChange κ₁ P T (Algebra.H1Cotangent.δ κ₁ P T z) = 0 :=
          (Algebra.H1Cotangent.exact_δ_mapBaseChange κ₁ P T _).mpr ⟨z, rfl⟩
        have hδ0 : Algebra.H1Cotangent.δ κ₁ P T z = 0 :=
          hmbc_inj (hmb0.trans (map_zero _).symm)
        obtain ⟨w₀, hw₀⟩ := (Algebra.H1Cotangent.exact_map_δ κ₁ P T z).mp hδ0
        rw [← hw₀, _root_.Subsingleton.elim w₀ 0, map_zero]
      exact (h0 z₁).trans (h0 z₂).symm
    haveI : Algebra.FormallyEtale P T := Algebra.FormallyEtale.mk hSub_Ω hSub_H1
    haveI : Algebra.Etale P T := Algebra.Etale.mk
    exact RingHom.etale_algebraMap.mpr inferInstance

theorem weil_odp_slice_net_baseChange_and_closed_point_locus (F : Type u) [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (U_disc_reg : C_disc.left.Opens)
    (hSing : WeilTransvTriIsSingularDatum F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg)
    (a : F) (ha : a ∈ S_aff)
    (k : Type u) [Field k] [Algebra F k]
    (π_P2 : (weilProjectiveSpaceOver k 2).left ⟶ (weilProjectiveSpaceOver F 2).left)
    (hπ_P2 : IsFieldPullbackModel F k (weilProjectiveSpaceOver F 2) (weilProjectiveSpaceOver k 2) π_P2)
    (j_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
      (weilProjectiveSpaceOver k 2).left)
    [AlgebraicGeometry.IsOpenImmersion j_0]
    (hj_0_hom : j_0 ≫ (weilProjectiveSpaceOver k 2).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (h₀ f₀ : MvPolynomial (Fin 2) k)
    (hf₀_irr : Irreducible f₀)
    (hj_0_Sigma : j_0.base ⁻¹' (π_P2.base ⁻¹' (Set.range P.ι_line.left.base)) =
      { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) | h₀ ∈ p.asIdeal })
    (hj_0_disc : j_0.base ⁻¹' (π_P2.base ⁻¹' (Set.range ι_disc.left.base)) =
      { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) | f₀ ∈ p.asIdeal }) :
    let η_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) :=
      ⟨Ideal.span {f₀}, (Ideal.span_singleton_prime hf₀_irr.ne_zero).mpr hf₀_irr.prime⟩
    (AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 2).hom ∧
      AlgebraicGeometry.Surjective P.g₂.left) ∧
    (∀ p : Fin 2 → k,
      MvPolynomial.eval p h₀ = 0 →
      MvPolynomial.eval p f₀ = 0 →
      ∃ (c_p : C_disc.left)
        (s_x : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
        (x_pt : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P.Z_tilde.left),
        c_p ∈ U_disc_reg ∧
        s_x ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) ∧
        x_pt ≫ P.f₀.left = s_x ∧
        (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
          IsEtaleSplitOdpPointOver m P.f₀ (x_pt.base pt) (s_x.base pt)) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval p)) ≫ j_0 ≫ π_P2 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)) ≫
            s_x ≫ P.ι_line.left ∧
        ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
          (s_x ≫ P.ι_line.left).base pt = ι_disc.left.base c_p) ∧
    (∃ (c_η c_a : C_disc.left),
      c_η ∈ U_disc_reg ∧
      c_a ∈ U_disc_reg ∧
      IsGenericPoint c_η Set.univ ∧
      (j_0 ≫ π_P2).base η_0 = ι_disc.left.base c_η ∧
      c_a ≠ c_η ∧
      ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a)) ≫ j_aff) ≫
          P.ι_line.left).base pt = ι_disc.left.base c_a) :=
by
  intro η_0
  rcases hSing with
    ⟨hj_aff_open, hj_aff_hom, hs_inf_hom, hs_inf_compl, hU₀_eq, _, _,
      hGeom_Cdisc, _, hCl_disc, hU_reg_ne, _, _, hLine_pre, hLine_img,
      ⟨x_inf, hx_inf_f₀, _, hx_inf_odp⟩, hOdp_aff, _⟩
  letI : AlgebraicGeometry.IsOpenImmersion j_aff := hj_aff_open
  letI : AlgebraicGeometry.GeometricallyIrreducible C_disc.hom := hGeom_Cdisc
  letI : AlgebraicGeometry.IsClosedImmersion ι_disc.left := hCl_disc
  letI : AlgebraicGeometry.IsClosedImmersion P.ι_line.left := P.hCl_line
  letI : AlgebraicGeometry.Flat P.g₂.left := P.hFlat_g₂
  letI : AlgebraicGeometry.IsProper P.g₂.left := P.hProp_g₂
  have hSpecBot : ∀ {E : Type u} [Field E]
      (q : AlgebraicGeometry.Spec (CommRingCat.of E)), q.asIdeal = ⊥ := by
    intro E _ q
    rw [eq_bot_iff]
    intro x hx
    by_contra hx0
    exact q.isPrime.ne_top
      (Ideal.eq_top_of_isUnit_mem q.asIdeal hx (isUnit_iff_ne_zero.mpr hx0))
  have hSpecEq : ∀ {E : Type u} [Field E]
      (q₁ q₂ : AlgebraicGeometry.Spec (CommRingCat.of E)), q₁ = q₂ := by
    intro E _ q₁ q₂
    exact PrimeSpectrum.ext ((hSpecBot q₁).trans (hSpecBot q₂).symm)
  let pt_F : AlgebraicGeometry.Spec (CommRingCat.of F) := ⟨⊥, Ideal.isPrime_bot⟩
  let pt_k : AlgebraicGeometry.Spec (CommRingCat.of k) := ⟨⊥, Ideal.isPrime_bot⟩
  have hPropP2 : ∀ (E : Type u) [Field E],
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver E 2).hom := by
    intro E _
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 3) E
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    letI : IsScalarTower E ↥(𝒜 0) (MvPolynomial (Fin 3) E) :=
      @IsScalarTower.of_algebraMap_eq E ↥(𝒜 0) (MvPolynomial (Fin 3) E) _ _ _ _ _ _
        (fun _ => rfl)
    letI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 3) E) :=
      Algebra.FiniteType.of_restrictScalars_finiteType E ↥(𝒜 0) (MvPolynomial (Fin 3) E)
    have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    have hBij : Function.Bijective (algebraMap E ↥(𝒜 0)) := by
      refine ⟨?_, ?_⟩
      · intro c₁ c₂ hc
        have hc' : MvPolynomial.C c₁ = (MvPolynomial.C c₂ : MvPolynomial (Fin 3) E) :=
          congrArg Subtype.val hc
        simpa only [MvPolynomial.eval_C] using
          congrArg (MvPolynomial.eval (0 : Fin 3 → E)) hc'
      · intro y
        have hy : y.1 ∈ (1 : Submodule E (MvPolynomial (Fin 3) E)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero (Fin 3)]
          exact y.2
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hy
        exact ⟨c, Subtype.ext hc⟩
    let e₀ : E ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap E ↥(𝒜 0)) hBij
    have he₀ : CommRingCat.ofHom (algebraMap E ↥(𝒜 0)) = e₀.toCommRingCatIso.hom := by
      rw [RingEquiv.toCommRingCatIso_hom]
      rfl
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E ↥(𝒜 0)))) := by
      rw [he₀]
      infer_instance
    have _ : AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E ↥(𝒜 0)))) :=
      inferInstance
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E ↥(𝒜 0))))
    infer_instance
  have hSurj_g₂ : AlgebraicGeometry.Surjective P.g₂.left := by
    let 𝒜_F := MvPolynomial.homogeneousSubmodule (Fin 3) F
    letI : GradedAlgebra 𝒜_F := MvPolynomial.gradedAlgebra
    have h_bot_prime : (⊥ : HomogeneousIdeal 𝒜_F).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have h_not_irrel : ¬ HomogeneousIdeal.irrelevant 𝒜_F ≤ (⊥ : HomogeneousIdeal 𝒜_F) := by
      intro hle
      have hX_mem : MvPolynomial.X (0 : Fin 3) ∈ HomogeneousIdeal.irrelevant 𝒜_F :=
        HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_F zero_lt_one
          (MvPolynomial.isHomogeneous_X F (0 : Fin 3))
      have hX_bot : MvPolynomial.X (0 : Fin 3) ∈ (⊥ : Ideal (MvPolynomial (Fin 3) F)) := by
        rw [← HomogeneousIdeal.toIdeal_bot (𝒜 := 𝒜_F)]
        exact HomogeneousIdeal.mem_iff.mpr (hle hX_mem)
      exact MvPolynomial.X_ne_zero (0 : Fin 3) (Ideal.mem_bot.mp hX_bot)
    let η_P2 : ProjectiveSpectrum 𝒜_F := ⟨⊥, h_bot_prime, h_not_irrel⟩
    have h_spec : ∀ b : ProjectiveSpectrum 𝒜_F, η_P2 ⤳ b := by
      intro b
      rw [specializes_iff_forall_closed]
      intro Z hZ hηZ
      obtain ⟨s, rfl⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus 𝒜_F Z).mp hZ
      rw [ProjectiveSpectrum.mem_zeroLocus] at hηZ ⊢
      intro z hz
      have hz_bot : z ∈ (⊥ : Ideal (MvPolynomial (Fin 3) F)) := by
        rw [← HomogeneousIdeal.toIdeal_bot (𝒜 := 𝒜_F)]
        exact HomogeneousIdeal.mem_iff.mpr (hηZ hz)
      rw [Ideal.mem_bot.mp hz_bot]
      exact zero_mem b.asHomogeneousIdeal
    let y₀ : P.Y₂.left := (x_inf ≫ P.ι_Ytilde.left).base pt_F
    have hη_mem : (η_P2 : ↥(weilProjectiveSpaceOver F 2).left) ∈ Set.range ⇑P.g₂.left :=
      (AlgebraicGeometry.Flat.generalizingMap P.g₂.left).stableUnderGeneralization_range
        (h_spec (P.g₂.left y₀)) ⟨y₀, rfl⟩
    have hRange_cl : IsClosed (Set.range ⇑P.g₂.left) :=
      (AlgebraicGeometry.Scheme.Hom.isClosedMap P.g₂.left).isClosed_range
    exact ⟨fun b =>
      specializes_iff_forall_closed.mp (h_spec b) (Set.range ⇑P.g₂.left) hRange_cl hη_mem⟩
  have hs_aff_hom : ∀ b : F,
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom b)) ≫ j_aff) ≫
        (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
    intro b
    rw [CategoryTheory.Category.assoc, hj_aff_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomp : (Polynomial.evalRingHom b).comp Polynomial.C = RingHom.id F := by
      ext c
      simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C,
        RingHom.id_apply]
    have hid : CommRingCat.ofHom (RingHom.id F) = 𝟙 (CommRingCat.of F) := rfl
    rw [hcomp, hid, AlgebraicGeometry.Spec.map_id]
  have hResFac : ∀ (K : Type u) [Field K]
      (pt_K : AlgebraicGeometry.Spec (CommRingCat.of K))
      (X : AlgebraicGeometry.Scheme.{u}) (x_F : ↥X)
      (h : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
      h.base pt_K = x_F →
      ∃ φ : X.residueField x_F ⟶ CommRingCat.of K,
        h = AlgebraicGeometry.Spec.map φ ≫ X.fromSpecResidueField x_F := by
    intro K _ pt_K X x_F h hh
    obtain ⟨⟨x₁, φ⟩, rfl⟩ :=
      (AlgebraicGeometry.Scheme.SpecToEquivOfField K X).symm.surjective h
    rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply] at hh ⊢
    dsimp only at hh ⊢
    have hx₁ : x₁ = x_F := by
      change (X.fromSpecResidueField x₁) ((AlgebraicGeometry.Spec.map φ).base pt_K) = x_F at hh
      rwa [AlgebraicGeometry.Scheme.fromSpecResidueField_apply] at hh
    subst hx₁
    exact ⟨φ, rfl⟩
  let g_Fk : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of F) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  refine ⟨⟨hPropP2 k, hSurj_g₂⟩, ?_, ?_⟩
  · intro p hp_h₀ hp_f₀
    let s_p : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval p))
    let q_p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) :=
      s_p.base pt_k
    have hqp_h₀ : h₀ ∈ q_p.asIdeal := by
      change MvPolynomial.eval p h₀ ∈ pt_k.asIdeal
      rw [hp_h₀]
      exact pt_k.asIdeal.zero_mem
    have hqp_f₀ : f₀ ∈ q_p.asIdeal := by
      change MvPolynomial.eval p f₀ ∈ pt_k.asIdeal
      rw [hp_f₀]
      exact pt_k.asIdeal.zero_mem
    let x_F : ↥(weilProjectiveSpaceOver F 2).left := (j_0 ≫ π_P2).base q_p
    have hx_F_Sigma : x_F ∈ Set.range P.ι_line.left.base := by
      have hmem : q_p ∈ j_0.base ⁻¹' (π_P2.base ⁻¹' (Set.range P.ι_line.left.base)) := by
        rw [hj_0_Sigma]
        exact hqp_h₀
      exact hmem
    have hx_F_disc : x_F ∈ Set.range ι_disc.left.base := by
      have hmem : q_p ∈ j_0.base ⁻¹' (π_P2.base ⁻¹' (Set.range ι_disc.left.base)) := by
        rw [hj_0_disc]
        exact hqp_f₀
      exact hmem
    obtain ⟨z_F, hz_F_eq⟩ := hx_F_Sigma
    have hz_F_not_U₀ : z_F ∈ (U₀ : Set (weilProjectiveSpaceOver F 1).left)ᶜ := by
      rw [← hLine_pre]
      change P.ι_line.left.base z_F ∈ Set.range ι_disc.left.base
      rwa [hz_F_eq]
    obtain ⟨c_p, hc_p_reg, hc_p_eq⟩ :=
      hLine_img ⟨z_F, hz_F_not_U₀, hz_F_eq⟩
    have hSec : ∃ (s_x : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
          (weilProjectiveSpaceOver F 1).left)
        (x_pt : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P.Z_tilde.left),
        s_x ≫ (weilProjectiveSpaceOver F 1).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) ∧
        x_pt ≫ P.f₀.left = s_x ∧
        (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
          IsEtaleSplitOdpPointOver m P.f₀ (x_pt.base pt) (s_x.base pt)) ∧
        (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F), s_x.base pt = z_F) := by
      by_cases hz_aff : z_F ∈ Set.range j_aff.base
      · obtain ⟨q_F, hq_F_eq⟩ := hz_aff
        have hex_b : ∃ b ∈ S_aff, Polynomial.X - Polynomial.C b ∈ q_F.asIdeal := by
          by_contra hnone
          push_neg at hnone
          exact hz_F_not_U₀ (hU₀_eq ▸ ⟨q_F, hnone, hq_F_eq⟩)
        obtain ⟨b, hb_mem, hb_ideal⟩ := hex_b
        let ev_b : Polynomial F →+* F := Polynomial.evalRingHom b
        have hev_surj : Function.Surjective ev_b := fun c =>
          ⟨Polynomial.C c, by simp only [ev_b, Polynomial.coe_evalRingHom, Polynomial.eval_C]⟩
        have hker_max : (RingHom.ker ev_b).IsMaximal :=
          RingHom.ker_isMaximal_of_surjective ev_b hev_surj
        have hker_le : RingHom.ker ev_b ≤ q_F.asIdeal := by
          intro g hg
          have hroot : g.IsRoot b := by
            rw [Polynomial.IsRoot.def]
            simpa only [RingHom.mem_ker, ev_b, Polynomial.coe_evalRingHom] using hg
          obtain ⟨r, rfl⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
          exact Ideal.mul_mem_right r q_F.asIdeal hb_ideal
