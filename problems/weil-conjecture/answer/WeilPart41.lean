      obtain ⟨e₀, he₀_C, he₀_X⟩ := hEquiv N a R₀ (MvPolynomial.X a) rfl
      obtain ⟨e₁, he₁_C, he₁_X⟩ := hEquiv N a R₁ (g (MvPolynomial.X a)) hg_Xa
      refine CategoryTheory.IsPushout.of_iso hPush_p
        (CategoryTheory.Iso.refl _) e₀.toCommRingCatIso
        (CategoryTheory.Iso.refl _) e₁.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact he₀_C c
      · simp [g_p]
      · apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          apply HomogeneousLocalization.val_injective
          change (e₁ (MvPolynomial.map ρ (MvPolynomial.C c))).val =
            (HomogeneousLocalization.Away.map g (MvPolynomial.X a) (e₀ (MvPolynomial.C c))).val
          rw [MvPolynomial.map_C, he₀_C c, he₁_C (ρ c), hFromZero_mk, hFromZero_mk]
          symm
          change (HomogeneousLocalization.map g _ (HomogeneousLocalization.mk _)).val = _
          rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.val_mk]
          have hg_c : g (algebraMap R₀ ↥(𝒜₀ 0) c : MvPolynomial (Fin (N + 1)) R₀) =
