    have hQ1_eq : (Q₁.map u_a.op).hom ξ₁ =
        ((c a : ZMod ℓ).val) • ((Q₁.map (hT_Y.from V_a_et).op).hom ξ_tilde0) := by
      rw [ZMod.val_natCast, hModNsmul _ (hTors_Q1 V_a_et)]
