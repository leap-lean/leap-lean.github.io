    let y'_pt : ↥W' := ⟨y₀, hy₀_O0⟩
    have hy'_mem : y'_pt ∈ ⋃ a : I, Set.range (g' a).base := by
      rw [hCov_g']; trivial
    rw [Set.mem_iUnion] at hy'_mem
