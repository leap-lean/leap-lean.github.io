import WeilPart40
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_odp_wit_stalk_proj_proetale_algClosure_bc_isIso (F : Type u) [Finite F] [Field F]
    (R₀ : Type u) [CommRing R₀] [Algebra F R₀]
    (U₀ : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀)
    (u_hom : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of F))
    (hu_eq : e_U.hom ≫ u_hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R₀)))
    (X₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : X₀ ⟶ U₀)
    (N_proj : ℕ)
    (ι_X : X₀ ⟶ CategoryTheory.Limits.pullback u_hom (weilProjectiveSpaceOver F N_proj).hom)
    [AlgebraicGeometry.IsClosedImmersion ι_X]
    (hι_fst : ι_X ≫ CategoryTheory.Limits.pullback.fst u_hom (weilProjectiveSpaceOver F N_proj).hom = g₀)
    (U_k X_k : AlgebraicGeometry.Scheme.{u})
    (p_k : U_k ⟶ U₀)
    (s_Uk : U_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)))
    (g_k : X_k ⟶ U_k)
    (p_Xk : X_k ⟶ X₀)
    (hpb_U : CategoryTheory.IsPullback p_k s_Uk u_hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    (hpb_X : CategoryTheory.IsPullback p_Xk g_k g₀ p_k)
    [hc_p : (weilEtaleSitePullback p_k).IsContinuous U₀.smallEtaleTopology U_k.smallEtaleTopology]
    [hr_p : ((weilEtaleSitePullback p_k).sheafPushforwardContinuous AddCommGrpCat.{u}
      U₀.smallEtaleTopology U_k.smallEtaleTopology).IsRightAdjoint]
    [hc_pX : (weilEtaleSitePullback p_Xk).IsContinuous X₀.smallEtaleTopology X_k.smallEtaleTopology]
    [hr_pX : ((weilEtaleSitePullback p_Xk).sheafPushforwardContinuous AddCommGrpCat.{u}
      X₀.smallEtaleTopology X_k.smallEtaleTopology).IsRightAdjoint]
    [hAdd_pX : ((weilEtaleSitePullback p_Xk).sheafPullback AddCommGrpCat.{u}
      X₀.smallEtaleTopology X_k.smallEtaleTopology).Additive]
    [hLim_pX : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback p_Xk).sheafPullback AddCommGrpCat.{u}
        X₀.smallEtaleTopology X_k.smallEtaleTopology)]
    [hColim_pX : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback p_Xk).sheafPullback AddCommGrpCat.{u}
        X₀.smallEtaleTopology X_k.smallEtaleTopology)]
    (T_X₀ : X₀.Etale) (hT_X₀ : CategoryTheory.Limits.IsTerminal T_X₀)
    (T_Xk : X_k.Etale) (hT_Xk : CategoryTheory.Limits.IsTerminal T_Xk)
    (m q : ℕ)
    {β₁ : weilEtaleHigherDirectImage g₀ q (weilEtaleTorsionSheaf X₀ m) ⟶
      ((weilEtaleSitePullback p_k).sheafPushforwardContinuous AddCommGrpCat.{u}
        U₀.smallEtaleTopology U_k.smallEtaleTopology).obj
          (weilEtaleHigherDirectImage g_k q
            (((weilEtaleSitePullback p_Xk).sheafPullback AddCommGrpCat.{u}
              X₀.smallEtaleTopology X_k.smallEtaleTopology).obj (weilEtaleTorsionSheaf X₀ m)))}
    (hβ₁ : WeilIsOuterBCPush g₀ p_k g_k p_Xk hpb_X.w (weilEtaleTorsionSheaf X₀ m) q β₁) :
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let R_0 := weilEtaleHigherDirectImage g₀ q (weilEtaleTorsionSheaf X₀ m)
    let R_k := weilEtaleHigherDirectImage g_k q (weilEtaleTorsionSheaf X_k m)
    let pf_p := (weilEtaleSitePullback p_k).sheafPushforwardContinuous AddCommGrpCat.{u}
      U₀.smallEtaleTopology U_k.smallEtaleTopology
    let adj_p := (weilEtaleSitePullback p_k).sheafAdjunctionContinuous AddCommGrpCat.{u}
      U₀.smallEtaleTopology U_k.smallEtaleTopology
    CategoryTheory.IsIso ((adj_p.homEquiv R_0 R_k).symm
      (β₁ ≫ pf_p.map (weilEtaleHigherDirectImageMap g_k q
        (weilEtaleConstPullbackHom p_Xk hT_Xk hT_X₀ AM)))) :=
by
  intro AM R_0 R_k pf_p adj_p
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  
  obtain ⟨hc_all, hr_all, hSite⟩ := weil_etale_site_pullback_rightAdjoint_and_exact_package
  have hEtDesc : WeilFilteredColimitEtaleDescentHolds.{u} :=
    weil_filtered_colimit_etale_presentation_and_cover_descent
  have hAff0 : WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) 0 :=
    weil_affine_filtered_ring_colimit_degree_zero (@hc_all) (@hr_all) hSite hEtDesc
  have hAffAll : ∀ r : ℕ, WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) r :=
    fun r => weil_affine_filtered_ring_colimit_all_degrees_of_deg_zero
      (@hc_all) (@hr_all) hSite hEtDesc hAff0 r
  have hFunc : WeilEtaleBasePullExtFunctorialityHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_basePullExt_functoriality_and_rebase (@hc_all) (@hr_all) hSite
  have hFY : WeilFreeYonedaPullbackAndPushoutHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_freeYoneda_pullback_resolution_and_pushout_effacement (@hc_all) (@hr_all) hSite hFunc
  have hSliceIso : WeilEtaleSliceCohomologyIsoHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_slice_cohomology_bijective (@hc_all) (@hr_all) hSite
  have hConst : WeilSliceColimConstAndTerminalHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_const_pullback_cocycle_and_terminal_colimit (@hc_all) (@hr_all) hSite hFunc hFY.1
  have hComp : WeilSliceColimBaseSliceComparisonHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_base_slice_ext_to_cohomology_iso_and_naturality
      (@hc_all) (@hr_all) hSite hFunc hFY.1 hSliceIso hConst
  obtain ⟨hTriIff, _, _, _⟩ := id hConst

  
  let F_X₀ := weilEtaleTorsionSheaf X₀ m
  let pb_p := (weilEtaleSitePullback p_k).sheafPullback AddCommGrpCat.{u}
    U₀.smallEtaleTopology U_k.smallEtaleTopology
  let pb_pX := (weilEtaleSitePullback p_Xk).sheafPullback AddCommGrpCat.{u}
    X₀.smallEtaleTopology X_k.smallEtaleTopology
  let F_Xk_pb := pb_pX.obj F_X₀
  let R_k_pb := weilEtaleHigherDirectImage g_k q F_Xk_pb
  let c_hom := weilEtaleConstPullbackHom p_Xk hT_Xk hT_X₀ AM
  have _ : CategoryTheory.IsIso c_hom :=
    (weil_outer_bc_const_pullback_and_bockstein_ses.2.1 p_Xk).1 hT_Xk hT_X₀ AM
  let R_c : R_k_pb ⟶ R_k := weilEtaleHigherDirectImageMap g_k q c_hom
  let R_cinv : R_k ⟶ R_k_pb := weilEtaleHigherDirectImageMap g_k q (CategoryTheory.inv c_hom)
  have _ : CategoryTheory.IsIso R_c := by
    obtain ⟨hMap_id, hMap_comp, -⟩ := weil_outer_bc_push_and_conn_calculus.1 g_k
    refine ⟨⟨R_cinv, ?_, ?_⟩⟩
    · dsimp only [R_c, R_cinv]
      rw [← hMap_comp, CategoryTheory.IsIso.hom_inv_id, hMap_id]
    · dsimp only [R_c, R_cinv]
      rw [← hMap_comp, CategoryTheory.IsIso.inv_hom_id, hMap_id]
  let ψ_k : pb_p.obj R_0 ⟶ R_k_pb := (adj_p.homEquiv R_0 R_k_pb).symm β₁
  have h_adj_symm : (adj_p.homEquiv R_0 R_k).symm (β₁ ≫ pf_p.map R_c) = ψ_k ≫ R_c :=
    CategoryTheory.Adjunction.homEquiv_naturality_right_symm adj_p β₁ R_c
  suffices CategoryTheory.IsIso ψ_k by
    rw [h_adj_symm]
    infer_instance

  
  have hClosed_X₀ : AlgebraicGeometry.IsClosedImmersion ι_X := inferInstance
  have hProjAff : ∀ (B₀ : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec B₀ ⟶ U₀),
      let Y₀_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback w₀ g₀
      ∃ (O : Fin (N_proj + 1) → Y₀_sch.Opens),
        (⨆ a : Fin (N_proj + 1), O a) = ⊤ ∧
        ∀ (S : Finset (Fin (N_proj + 1))) (hS : S.Nonempty),
          AlgebraicGeometry.IsAffineOpen (S.inf' hS O) := by
    intro B₀ w₀ Y₀_sch
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N_proj + 1)) F
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let hom_PN : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of F) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥(𝒜 0)))
    let ι_X' : X₀ ⟶ CategoryTheory.Limits.pullback u_hom hom_PN := ι_X
    have hClosed_X' : AlgebraicGeometry.IsClosedImmersion ι_X' := hClosed_X₀
    have hι_fst' : ι_X' ≫ CategoryTheory.Limits.pullback.fst u_hom hom_PN = g₀ := hι_fst
    let V : Fin (N_proj + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    have hV_top : (⨆ a : Fin (N_proj + 1), V a) = ⊤ := by
      have : IsScalarTower F ↥(𝒜 0) (MvPolynomial (Fin (N_proj + 1)) F) :=
        @IsScalarTower.of_algebraMap_eq F ↥(𝒜 0) (MvPolynomial (Fin (N_proj + 1)) F) _ _ _ _ _ _
          (fun _ => rfl)
      have hadj : Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin (N_proj + 1) → MvPolynomial (Fin (N_proj + 1)) F)) = ⊤ := by
        rw [eq_top_iff]
        intro p _
        have hp_F : p ∈ Algebra.adjoin F
            (Set.range (MvPolynomial.X : Fin (N_proj + 1) → MvPolynomial (Fin (N_proj + 1)) F)) := by
          rw [MvPolynomial.adjoin_range_X]
          trivial
        refine Algebra.adjoin_induction (fun y hy => Algebra.subset_adjoin hy) (fun r => ?_)
          (fun _ _ _ _ ha hb => add_mem ha hb) (fun _ _ _ _ ha hb => mul_mem ha hb) hp_F
        rw [IsScalarTower.algebraMap_apply F ↥(𝒜 0) (MvPolynomial (Fin (N_proj + 1)) F)]
        exact Subalgebra.algebraMap_mem _ _
      exact AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜
        (MvPolynomial.X : Fin (N_proj + 1) → MvPolynomial (Fin (N_proj + 1)) F)
        (fun i => ⟨1, MvPolynomial.isHomogeneous_X F i⟩) hadj
    have hV_prod : ∀ (S : Finset (Fin (N_proj + 1))) (hS : S.Nonempty),
        S.inf' hS V = AlgebraicGeometry.Proj.basicOpen 𝒜 (∏ a ∈ S, MvPolynomial.X a) ∧
        (∏ a ∈ S, (MvPolynomial.X a : MvPolynomial (Fin (N_proj + 1)) F)) ∈ 𝒜 S.card := by
      intro S hS
      refine Finset.Nonempty.cons_induction ?_ ?_ hS
      · intro a
        simp only [Finset.inf'_singleton, Finset.prod_singleton, Finset.card_singleton]
        exact ⟨rfl, MvPolynomial.isHomogeneous_X F a⟩
      · intro a T ha hT ⟨hEq, hHom⟩
        rw [Finset.inf'_cons hT, hEq, Finset.prod_cons, Finset.card_cons,
          AlgebraicGeometry.Proj.basicOpen_mul]
        refine ⟨rfl, ?_⟩
        have h1 : (MvPolynomial.X a : MvPolynomial (Fin (N_proj + 1)) F) ∈ 𝒜 1 :=
          MvPolynomial.isHomogeneous_X F a
        have hmul : (MvPolynomial.X a * ∏ b ∈ T, MvPolynomial.X b) ∈ 𝒜 (1 + T.card) :=
          MvPolynomial.IsHomogeneous.mul h1 hHom
        rwa [Nat.add_comm 1 T.card] at hmul
    have hV_aff : ∀ (S : Finset (Fin (N_proj + 1))) (hS : S.Nonempty),
        AlgebraicGeometry.IsAffineOpen (S.inf' hS V) := by
      intro S hS
      obtain ⟨hEq, hHom⟩ := hV_prod S hS
      let iso_S : ((S.inf' hS V : (AlgebraicGeometry.Proj 𝒜).Opens) : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of
            (HomogeneousLocalization.Away 𝒜 (∏ a ∈ S, MvPolynomial.X a))) :=
        ((AlgebraicGeometry.Proj 𝒜).isoOfEq hEq).trans
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (∏ a ∈ S, MvPolynomial.X a) hHom hS.card_pos)
      exact AlgebraicGeometry.IsAffine.of_isIso iso_S.hom
    let f_Y₀ : Y₀_sch ⟶ AlgebraicGeometry.Spec B₀ := CategoryTheory.Limits.pullback.fst w₀ g₀
    let π_Y₀ : Y₀_sch ⟶ X₀ := CategoryTheory.Limits.pullback.snd w₀ g₀
    let Q_U₀ := CategoryTheory.Limits.pullback u_hom hom_PN
    let Q_B₀ := CategoryTheory.Limits.pullback (w₀ ≫ u_hom) hom_PN
    let q_B₀ : Q_B₀ ⟶ Q_U₀ := CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (w₀ ≫ u_hom) hom_PN ≫ w₀)
      (CategoryTheory.Limits.pullback.snd (w₀ ≫ u_hom) hom_PN)
      (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
    have hq_B₀_fst : q_B₀ ≫ CategoryTheory.Limits.pullback.fst u_hom hom_PN =
        CategoryTheory.Limits.pullback.fst (w₀ ≫ u_hom) hom_PN ≫ w₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq_B₀_snd : q_B₀ ≫ CategoryTheory.Limits.pullback.snd u_hom hom_PN =
        CategoryTheory.Limits.pullback.snd (w₀ ≫ u_hom) hom_PN :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_Q : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (w₀ ≫ u_hom) hom_PN) q_B₀
        w₀ (CategoryTheory.Limits.pullback.fst u_hom hom_PN) := by
      refine (CategoryTheory.IsPullback.of_right ?_ hq_B₀_fst
        (CategoryTheory.IsPullback.of_hasPullback u_hom hom_PN).flip).flip
      rw [hq_B₀_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (w₀ ≫ u_hom) hom_PN).flip
    let q_Y₀ : Y₀_sch ⟶ AlgebraicGeometry.Proj 𝒜 :=
      π_Y₀ ≫ ι_X' ≫ CategoryTheory.Limits.pullback.snd u_hom hom_PN
    have hcomm_Y₀ : f_Y₀ ≫ (w₀ ≫ u_hom) = q_Y₀ ≫ hom_PN := by
      dsimp only [f_Y₀, π_Y₀, q_Y₀]
      rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst w₀ g₀) w₀ u_hom,
        CategoryTheory.Limits.pullback.condition (f := w₀) (g := g₀),
        CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.snd w₀ g₀) _ hom_PN,
        CategoryTheory.Category.assoc ι_X' _ hom_PN,
        ← CategoryTheory.Limits.pullback.condition (f := u_hom) (g := hom_PN),
        ← CategoryTheory.Category.assoc ι_X' _ u_hom, hι_fst']
      exact CategoryTheory.Category.assoc _ _ _
    let ι_Y₀ : Y₀_sch ⟶ Q_B₀ := CategoryTheory.Limits.pullback.lift f_Y₀ q_Y₀ hcomm_Y₀
    have h_sq_ι : ι_Y₀ ≫ q_B₀ = π_Y₀ ≫ ι_X' := by
      dsimp only [ι_Y₀, q_B₀, f_Y₀, π_Y₀, q_Y₀]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, hι_fst']
        exact CategoryTheory.Limits.pullback.condition (f := w₀) (g := g₀)
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd]
        exact (CategoryTheory.Category.assoc _ _ _).symm
    have hpb_ι : CategoryTheory.IsPullback ι_Y₀ π_Y₀ q_B₀ ι_X' := by
      refine CategoryTheory.IsPullback.of_right ?_ h_sq_ι hpb_Q
      dsimp only [ι_Y₀, f_Y₀, π_Y₀]
      rw [CategoryTheory.Limits.pullback.lift_fst, hι_fst']
      exact CategoryTheory.IsPullback.of_hasPullback w₀ g₀
    have _ : AlgebraicGeometry.IsClosedImmersion ι_Y₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_ι.flip hClosed_X'
    have _ : AlgebraicGeometry.IsAffineHom ι_Y₀ := inferInstance
    have _ : AlgebraicGeometry.IsAffineHom (w₀ ≫ u_hom) :=
      AlgebraicGeometry.isAffineHom_of_isAffine (w₀ ≫ u_hom)
    let snd_QB₀ : Q_B₀ ⟶ AlgebraicGeometry.Proj 𝒜 :=
      CategoryTheory.Limits.pullback.snd (w₀ ≫ u_hom) hom_PN
    have _ : AlgebraicGeometry.IsAffineHom snd_QB₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (w₀ ≫ u_hom) hom_PN)
        (inferInstance : AlgebraicGeometry.IsAffineHom (w₀ ≫ u_hom))
    have hq_fac : q_Y₀ = ι_Y₀ ≫ snd_QB₀ := by
      dsimp only [ι_Y₀, snd_QB₀]
      exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    let O : Fin (N_proj + 1) → Y₀_sch.Opens :=
      fun a => (TopologicalSpace.Opens.map q_Y₀.base).obj (V a)
    refine ⟨O, ?_, ?_⟩
    · apply TopologicalSpace.Opens.ext
      ext y
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, TopologicalSpace.Opens.coe_top,
        Set.mem_univ, iff_true]
      have hy : q_Y₀.base y ∈
          ((⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := trivial
      rw [← hV_top, TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hy
      exact hy
    · intro S hS
      have hInf_eq : S.inf' hS O =
          (TopologicalSpace.Opens.map ι_Y₀.base).obj
            ((TopologicalSpace.Opens.map snd_QB₀.base).obj (S.inf' hS V)) := by
        have h1 : S.inf' hS O = (TopologicalSpace.Opens.map q_Y₀.base).obj (S.inf' hS V) := by
          refine Finset.Nonempty.cons_induction (fun a => ?_) ?_ hS
          · rw [Finset.inf'_singleton, Finset.inf'_singleton]
          · intro a T ha hT ih
            rw [Finset.inf'_cons hT, Finset.inf'_cons hT, ih]
            rfl
        rw [h1, hq_fac]
        rfl
      rw [hInf_eq]
      exact AlgebraicGeometry.IsAffineHom.isAffine_preimage (f := ι_Y₀) _
        (AlgebraicGeometry.IsAffineHom.isAffine_preimage (f := snd_QB₀) (S.inf' hS V) (hV_aff S hS))

  
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have hpb_map_fst : ∀ {A B : U₀.Etale} (g : A ⟶ B),
      ((weilEtaleSitePullback p_k).map g).left ≫ CategoryTheory.Limits.pullback.fst B.hom p_k =
        CategoryTheory.Limits.pullback.fst A.hom p_k ≫ g.left :=
    fun {_ B} g =>
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst B.hom p_k)
        (CategoryTheory.MorphismProperty.Over.pullback_map_left _ _ p_k g)).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
  have hpb_map_snd : ∀ {A B : U₀.Etale} (g : A ⟶ B),
      ((weilEtaleSitePullback p_k).map g).left ≫ CategoryTheory.Limits.pullback.snd B.hom p_k =
        CategoryTheory.Limits.pullback.snd A.hom p_k :=
    fun g => CategoryTheory.MorphismProperty.Over.w ((weilEtaleSitePullback p_k).map g)
  have hAlgDesc : ∀ (Y₀ : U₀.Etale) (Y_k : U_k.Etale)
      (μ₀ : Y_k ⟶ (weilEtaleSitePullback p_k).obj Y₀) (pt : ↥Y_k.left),
      ∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
        (B₀ : CommRingCat.{u})
        (D : CategoryTheory.Functor ℐ CommRingCat.{u})
        (α : (CategoryTheory.Functor.const ℐ).obj B₀ ⟶ D)
        (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
        (f_inf : B₀ ⟶ c.pt) (_ : ∀ i : ℐ, α.app i ≫ c.ι.app i = f_inf)
        (w₀ : AlgebraicGeometry.Spec B₀ ⟶ U₀) (hw₀_et : AlgebraicGeometry.Etale w₀)
        (hα_et : ∀ i : ℐ, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (α.app i) ≫ w₀))
        (z_k : AlgebraicGeometry.Spec c.pt ⟶ U_k) (hz_et : AlgebraicGeometry.Etale z_k),
        let W₀_et : U₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w₀ hw₀_et
        let W_lvl_et : ℐ → U₀.Etale := fun i =>
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (AlgebraicGeometry.Spec.map (α.app i) ≫ w₀) (hα_et i)
        let Z_et : U_k.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ z_k hz_et
        ∃ (w_Y₀ : W₀_et ⟶ Y₀)
          (u_lvl : ∀ i : ℐ, W_lvl_et i ⟶ W₀_et)
          (u_θ : ∀ {i j : ℐ}, (i ⟶ j) → (W_lvl_et j ⟶ W_lvl_et i))
          (v_Z : Z_et ⟶ Y_k)
          (pt_Z : ↥(AlgebraicGeometry.Spec c.pt))
          (ι₀ : Z_et ⟶ (weilEtaleSitePullback p_k).obj W₀_et)
          (ι_lvl : ∀ i : ℐ, Z_et ⟶ (weilEtaleSitePullback p_k).obj (W_lvl_et i)),
          (∀ i : ℐ, (u_lvl i).left = AlgebraicGeometry.Spec.map (α.app i)) ∧
          (∀ {i j : ℐ} (θ : i ⟶ j), (u_θ θ).left = AlgebraicGeometry.Spec.map (D.map θ)) ∧
          (∀ {i j : ℐ} (θ : i ⟶ j), u_θ θ ≫ u_lvl i = u_lvl j) ∧
          AlgebraicGeometry.Etale v_Z.left ∧
          v_Z.left.base pt_Z = pt ∧
          ι₀.left ≫ CategoryTheory.Limits.pullback.fst w₀ p_k = AlgebraicGeometry.Spec.map f_inf ∧
          (∀ i : ℐ, (ι_lvl i).left ≫
            CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map (α.app i) ≫ w₀) p_k =
              AlgebraicGeometry.Spec.map (c.ι.app i)) ∧
          (∀ i : ℐ, ι_lvl i ≫ (weilEtaleSitePullback p_k).map (u_lvl i) = ι₀) ∧
          (∀ {i j : ℐ} (θ : i ⟶ j), ι_lvl j ≫ (weilEtaleSitePullback p_k).map (u_θ θ) = ι_lvl i) ∧
          ι₀ ≫ (weilEtaleSitePullback p_k).map w_Y₀ = v_Z ≫ μ₀ := by
    intro Y₀ Y_k μ₀ pt
    obtain ⟨m_μ, hm_μ_eq⟩ :
        ∃ m : Y_k.left ⟶ CategoryTheory.Limits.pullback Y₀.hom p_k, m = μ₀.left := ⟨μ₀.left, rfl⟩
    have hm_μ_snd : m_μ ≫ CategoryTheory.Limits.pullback.snd Y₀.hom p_k = Y_k.hom := by
      subst hm_μ_eq
      exact CategoryTheory.MorphismProperty.Over.w μ₀
    let q_μ : Y_k.left ⟶ Y₀.left := m_μ ≫ CategoryTheory.Limits.pullback.fst Y₀.hom p_k
    let pt_Y₀ : ↥Y₀.left := q_μ.base pt
    obtain ⟨O_Y₀, hAff_Y₀, hpt_Y₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (show pt_Y₀ ∈ (⊤ : Y₀.left.Opens) from trivial)
    let A₀ : CommRingCat.{u} := Y₀.left.presheaf.obj (Opposite.op O_Y₀)
    let j_A₀ : AlgebraicGeometry.Spec A₀ ⟶ Y₀.left := hAff_Y₀.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion j_A₀ := inferInstance
    have _ : AlgebraicGeometry.Etale j_A₀ := inferInstance
    have _ : AlgebraicGeometry.Etale Y₀.hom := Y₀.prop
    have _ : AlgebraicGeometry.Etale Y_k.hom := Y_k.prop
    have hpt_pre : pt ∈ ((TopologicalSpace.Opens.map q_μ.base).obj O_Y₀ : Set ↥Y_k.left) := hpt_Y₀
    obtain ⟨O_Yk, hAff_Yk, hpt_Yk, hsub_Yk⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hpt_pre
    let C_k : CommRingCat.{u} := Y_k.left.presheaf.obj (Opposite.op O_Yk)
    let j_Ck : AlgebraicGeometry.Spec C_k ⟶ Y_k.left := hAff_Yk.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion j_Ck := inferInstance
    have _ : AlgebraicGeometry.Etale j_Ck := inferInstance
    let pt_Z : ↥(AlgebraicGeometry.Spec C_k) := hAff_Yk.isoSpec.hom.base ⟨pt, hpt_Yk⟩
    have hj_Ck_pt : j_Ck.base pt_Z = pt := by
      dsimp [j_Ck, pt_Z]
      rw [← hAff_Yk.isoSpec_inv_ι]
      change O_Yk.ι.base ((hAff_Yk.isoSpec.hom ≫ hAff_Yk.isoSpec.inv).base ⟨pt, hpt_Yk⟩) = pt
      rw [hAff_Yk.isoSpec.hom_inv_id]
      rfl
    have hrange_CA : Set.range (j_Ck ≫ q_μ).base ⊆ Set.range j_A₀.base := by
      rw [hAff_Y₀.range_fromSpec]
      rintro _ ⟨w, rfl⟩
      have hw : j_Ck.base w ∈ (O_Yk : Set ↥Y_k.left) := by
        rw [← hAff_Yk.range_fromSpec]
        exact ⟨w, rfl⟩
      exact hsub_Yk hw
    let g_CA : AlgebraicGeometry.Spec C_k ⟶ AlgebraicGeometry.Spec A₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift j_A₀ (j_Ck ≫ q_μ) hrange_CA
    have hg_CA_fac : g_CA ≫ j_A₀ = j_Ck ≫ q_μ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_A₀ (j_Ck ≫ q_μ) hrange_CA

    let k := AlgebraicClosure F
    let φ_RA : CommRingCat.of R₀ ⟶ A₀ :=
      AlgebraicGeometry.Spec.preimage (j_A₀ ≫ Y₀.hom ≫ e_U.inv)
    let φ_FA : CommRingCat.of F ⟶ A₀ := CommRingCat.ofHom (algebraMap F R₀) ≫ φ_RA
    have hSpec_φFA : AlgebraicGeometry.Spec.map φ_FA = j_A₀ ≫ Y₀.hom ≫ u_hom := by
      dsimp [φ_FA, φ_RA]
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, ← hu_eq,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_U.inv e_U.hom u_hom, e_U.inv_hom_id,
        CategoryTheory.Category.id_comp]
    let ℐ₀ := { E : IntermediateField F k // FiniteDimensional F ↥E }
    let _ : PartialOrder ℐ₀ := Subtype.partialOrder _
    have _ : CategoryTheory.IsFilteredOrEmpty ℐ₀ :=
      CategoryTheory.IsFilteredOrEmpty.mk
        (fun E₁ E₂ =>
          haveI : FiniteDimensional F ↥E₁.1 := E₁.2
          haveI : FiniteDimensional F ↥E₂.1 := E₂.2
          ⟨⟨E₁.1 ⊔ E₂.1, IntermediateField.finiteDimensional_sup E₁.1 E₂.1⟩,
            CategoryTheory.homOfLE (le_sup_left : E₁.1 ≤ _),
            CategoryTheory.homOfLE (le_sup_right : E₂.1 ≤ _), trivial⟩)
        (fun ⦃E₁ E₂⦄ _ _ => ⟨E₂, 𝟙 E₂, Subsingleton.elim _ _⟩)
    have _ : CategoryTheory.IsFiltered ℐ₀ :=
      { toIsFilteredOrEmpty := inferInstance, nonempty := ⟨⟨⊥, inferInstance⟩⟩ }
    let D_F : CategoryTheory.Functor ℐ₀ CommRingCat.{u} :=
      { obj := fun E => CommRingCat.of ↥E.1
        map := fun {E₁ E₂} h =>
          CommRingCat.ofHom (IntermediateField.inclusion (CategoryTheory.leOfHom h)).toRingHom
        map_id := fun _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
        map_comp := fun _ _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl) }
    let c_F : CategoryTheory.Limits.Cocone D_F :=
      { pt := CommRingCat.of k
        ι :=
          { app := fun E => CommRingCat.ofHom E.1.val.toRingHom
            naturality := fun _ _ _ =>
              (CommRingCat.hom_ext (RingHom.ext fun _ => rfl)).trans
                (CategoryTheory.Category.comp_id _).symm } }
    let E_of : k → ℐ₀ := fun x =>
      ⟨IntermediateField.adjoin F ({x} : Set k),
        IntermediateField.adjoin.finiteDimensional
          (Algebra.IsIntegral.isIntegral (R := F) x)⟩
    let mem_E_of : ∀ x : k, x ∈ (E_of x).1 := fun x => IntermediateField.mem_adjoin_simple_self F x
    have hF_agree : ∀ (s : CategoryTheory.Limits.Cocone D_F) (E : ℐ₀) (y : ↥E.1),
        (s.ι.app E).hom y = (s.ι.app (E_of y.1)).hom ⟨y.1, mem_E_of y.1⟩ := by
      intro s E y
      haveI : FiniteDimensional F ↥E.1 := E.2
      haveI : FiniteDimensional F ↥(E_of y.1).1 := (E_of y.1).2
      let E_sup : ℐ₀ := ⟨E.1 ⊔ (E_of y.1).1, IntermediateField.finiteDimensional_sup E.1 (E_of y.1).1⟩
      have hle₁ : E ≤ E_sup := (le_sup_left : E.1 ≤ E_sup.1)
      have hle₂ : E_of y.1 ≤ E_sup := (le_sup_right : (E_of y.1).1 ≤ E_sup.1)
      have h₁ := congrArg (fun m => m.hom y) (s.w (CategoryTheory.homOfLE hle₁))
      have h₂ := congrArg (fun m => m.hom ⟨y.1, mem_E_of y.1⟩) (s.w (CategoryTheory.homOfLE hle₂))
      exact h₁.symm.trans h₂
    obtain ⟨hc_F⟩ : Nonempty (CategoryTheory.Limits.IsColimit c_F) :=
      ⟨{ desc := fun s => CommRingCat.ofHom
          { toFun := fun x => (s.ι.app (E_of x)).hom ⟨x, mem_E_of x⟩
            map_one' := by
              let E_bot : ℐ₀ := ⟨⊥, inferInstance⟩
              exact (hF_agree s E_bot 1).symm.trans (map_one (s.ι.app E_bot).hom)
            map_mul' := fun x y => by
              haveI : FiniteDimensional F ↥(E_of x).1 := (E_of x).2
              haveI : FiniteDimensional F ↥(E_of y).1 := (E_of y).2
              let E_xy : ℐ₀ :=
                ⟨(E_of x).1 ⊔ (E_of y).1, IntermediateField.finiteDimensional_sup _ _⟩
              let x' : ↥E_xy.1 := ⟨x, (le_sup_left : (E_of x).1 ≤ E_xy.1) (mem_E_of x)⟩
              let y' : ↥E_xy.1 := ⟨y, (le_sup_right : (E_of y).1 ≤ E_xy.1) (mem_E_of y)⟩
              calc
                (s.ι.app (E_of (x * y))).hom ⟨x * y, mem_E_of (x * y)⟩
                  = (s.ι.app E_xy).hom (x' * y') := (hF_agree s E_xy (x' * y')).symm
                _ = (s.ι.app E_xy).hom x' * (s.ι.app E_xy).hom y' := map_mul _ _ _
                _ = _ := congrArg₂ (· * ·) (hF_agree s E_xy x') (hF_agree s E_xy y')
            map_zero' := by
              let E_bot : ℐ₀ := ⟨⊥, inferInstance⟩
              exact (hF_agree s E_bot 0).symm.trans (map_zero (s.ι.app E_bot).hom)
            map_add' := fun x y => by
              haveI : FiniteDimensional F ↥(E_of x).1 := (E_of x).2
              haveI : FiniteDimensional F ↥(E_of y).1 := (E_of y).2
              let E_xy : ℐ₀ :=
                ⟨(E_of x).1 ⊔ (E_of y).1, IntermediateField.finiteDimensional_sup _ _⟩
              let x' : ↥E_xy.1 := ⟨x, (le_sup_left : (E_of x).1 ≤ E_xy.1) (mem_E_of x)⟩
              let y' : ↥E_xy.1 := ⟨y, (le_sup_right : (E_of y).1 ≤ E_xy.1) (mem_E_of y)⟩
              calc
                (s.ι.app (E_of (x + y))).hom ⟨x + y, mem_E_of (x + y)⟩
                  = (s.ι.app E_xy).hom (x' + y') := (hF_agree s E_xy (x' + y')).symm
                _ = (s.ι.app E_xy).hom x' + (s.ι.app E_xy).hom y' := map_add _ _ _
                _ = _ := congrArg₂ (· + ·) (hF_agree s E_xy x') (hF_agree s E_xy y') }
         fac := fun s E => CommRingCat.hom_ext (RingHom.ext fun y => (hF_agree s E y).symm)
         uniq := fun s m hm => CommRingCat.hom_ext (RingHom.ext fun x =>
           congrArg (fun f => f.hom ⟨x, mem_E_of x⟩) (hm (E_of x))) }⟩

    let j_FE : ∀ E : ℐ₀, CommRingCat.of F ⟶ D_F.obj E :=
      fun E => CommRingCat.ofHom (algebraMap F ↥E.1)
    let j_Fk : CommRingCat.of F ⟶ CommRingCat.of k :=
      CommRingCat.ofHom (algebraMap F k)
    have hj_FE_nat : ∀ {E₁ E₂ : ℐ₀} (θ : E₁ ⟶ E₂), j_FE E₁ ≫ D_F.map θ = j_FE E₂ :=
      fun θ => CommRingCat.hom_ext (RingHom.ext fun r =>
        (IntermediateField.inclusion (CategoryTheory.leOfHom θ)).commutes r)
    have hj_Fk : ∀ E : ℐ₀, j_FE E ≫ c_F.ι.app E = j_Fk :=
      fun E => CommRingCat.hom_ext (RingHom.ext fun r => E.1.val.commutes r)
    let push_FA : ∀ {R₁ R₂ : CommRingCat.{u}} (g₁ : CommRingCat.of F ⟶ R₁)
        (g₂ : CommRingCat.of F ⟶ R₂) (β : R₂ ⟶ R₁), g₂ ≫ β = g₁ →
        (CategoryTheory.Limits.pushout φ_FA g₂ ⟶ CategoryTheory.Limits.pushout φ_FA g₁) :=
      fun g₁ g₂ β hβ => CategoryTheory.Limits.pushout.desc
        (CategoryTheory.Limits.pushout.inl φ_FA g₁)
        (β ≫ CategoryTheory.Limits.pushout.inr φ_FA g₁)
        (by rw [CategoryTheory.Limits.pushout.condition, ← CategoryTheory.Category.assoc, hβ])
    have hpush_FA_inl : ∀ {R₁ R₂ : CommRingCat.{u}} {g₁ : CommRingCat.of F ⟶ R₁}
        {g₂ : CommRingCat.of F ⟶ R₂} {β : R₂ ⟶ R₁} {hβ : g₂ ≫ β = g₁},
        CategoryTheory.Limits.pushout.inl φ_FA g₂ ≫ push_FA g₁ g₂ β hβ =
          CategoryTheory.Limits.pushout.inl φ_FA g₁ :=
      CategoryTheory.Limits.pushout.inl_desc _ _ _
    have hpush_FA_inr : ∀ {R₁ R₂ : CommRingCat.{u}} {g₁ : CommRingCat.of F ⟶ R₁}
        {g₂ : CommRingCat.of F ⟶ R₂} {β : R₂ ⟶ R₁} {hβ : g₂ ≫ β = g₁},
        CategoryTheory.Limits.pushout.inr φ_FA g₂ ≫ push_FA g₁ g₂ β hβ =
          β ≫ CategoryTheory.Limits.pushout.inr φ_FA g₁ :=
      CategoryTheory.Limits.pushout.inr_desc _ _ _
    let D_A : CategoryTheory.Functor ℐ₀ CommRingCat.{u} :=
      { obj := fun E => CategoryTheory.Limits.pushout φ_FA (j_FE E)
        map := fun {E₁ E₂} θ => push_FA (j_FE E₂) (j_FE E₁) (D_F.map θ) (hj_FE_nat θ)
        map_id := fun E => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Limits.pushout.inr_desc, D_F.map_id, CategoryTheory.Category.id_comp,
              CategoryTheory.Category.comp_id]
        map_comp := fun {E₁ E₂ E₃} θ₁ θ₂ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Limits.pushout.inl_desc]
          · rw [CategoryTheory.Limits.pushout.inr_desc, D_F.map_comp, CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc (CategoryTheory.Limits.pushout.inr φ_FA (j_FE E₁)),
              CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inr_desc] }
    have hDA_inl : ∀ {E₁ E₂ : ℐ₀} (θ : E₁ ⟶ E₂),
        CategoryTheory.Limits.pushout.inl φ_FA (j_FE E₁) ≫ D_A.map θ =
          CategoryTheory.Limits.pushout.inl φ_FA (j_FE E₂) :=
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _
    have hDA_inr : ∀ {E₁ E₂ : ℐ₀} (θ : E₁ ⟶ E₂),
        CategoryTheory.Limits.pushout.inr φ_FA (j_FE E₁) ≫ D_A.map θ =
          D_F.map θ ≫ CategoryTheory.Limits.pushout.inr φ_FA (j_FE E₂) :=
      fun _ => CategoryTheory.Limits.pushout.inr_desc _ _ _
    let cA_app : ∀ E : ℐ₀, D_A.obj E ⟶ CategoryTheory.Limits.pushout φ_FA j_Fk :=
      fun E => push_FA j_Fk (j_FE E) (c_F.ι.app E) (hj_Fk E)
    have hcA_app_inl : ∀ E : ℐ₀,
        CategoryTheory.Limits.pushout.inl φ_FA (j_FE E) ≫ cA_app E =
          CategoryTheory.Limits.pushout.inl φ_FA j_Fk :=
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _
    have hcA_app_inr : ∀ E : ℐ₀,
        CategoryTheory.Limits.pushout.inr φ_FA (j_FE E) ≫ cA_app E =
          c_F.ι.app E ≫ CategoryTheory.Limits.pushout.inr φ_FA j_Fk :=
      fun _ => CategoryTheory.Limits.pushout.inr_desc _ _ _
    let c_A : CategoryTheory.Limits.Cocone D_A :=
      { pt := CategoryTheory.Limits.pushout φ_FA j_Fk
        ι :=
          { app := cA_app
            naturality := fun {E₁ E₂} θ => by
              refine Eq.trans ?_ (CategoryTheory.Category.comp_id _).symm
              apply CategoryTheory.Limits.pushout.hom_ext
              · rw [← CategoryTheory.Category.assoc, hDA_inl, hcA_app_inl, hcA_app_inl]
              · rw [← CategoryTheory.Category.assoc, hDA_inr, CategoryTheory.Category.assoc,
                  hcA_app_inr, ← CategoryTheory.Category.assoc, c_F.w θ, hcA_app_inr] } }
    have hcA_inl_app : ∀ E : ℐ₀,
        CategoryTheory.Limits.pushout.inl φ_FA (j_FE E) ≫ c_A.ι.app E =
          CategoryTheory.Limits.pushout.inl φ_FA j_Fk := hcA_app_inl
    have hcA_inr_app : ∀ E : ℐ₀,
        CategoryTheory.Limits.pushout.inr φ_FA (j_FE E) ≫ c_A.ι.app E =
          c_F.ι.app E ≫ CategoryTheory.Limits.pushout.inr φ_FA j_Fk := hcA_app_inr
    let E_bot₀ : ℐ₀ := ⟨⊥, inferInstance⟩
    have hA_indep : ∀ (s : CategoryTheory.Limits.Cocone D_A) (E : ℐ₀),
        CategoryTheory.Limits.pushout.inl φ_FA (j_FE E) ≫ s.ι.app E =
          CategoryTheory.Limits.pushout.inl φ_FA (j_FE E_bot₀) ≫ s.ι.app E_bot₀ := by
      intro s E
      have hle : E_bot₀ ≤ E := (bot_le : (⊥ : IntermediateField F k) ≤ E.1)
      rw [← s.w (CategoryTheory.homOfLE hle), ← CategoryTheory.Category.assoc, hDA_inl]
    let cocone_DF : CategoryTheory.Limits.Cocone D_A → CategoryTheory.Limits.Cocone D_F := fun s =>
      { pt := s.pt
        ι :=
          { app := fun E => CategoryTheory.Limits.pushout.inr φ_FA (j_FE E) ≫ s.ι.app E
            naturality := fun {E₁ E₂} θ =>
              (((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ s.ι.app E₂) (hDA_inr θ).symm).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (CategoryTheory.Limits.pushout.inr φ_FA (j_FE E₁) ≫ ·) (s.w θ))))).trans
                (CategoryTheory.Category.comp_id _).symm) } }
    obtain ⟨hc_A⟩ : Nonempty (CategoryTheory.Limits.IsColimit c_A) :=
      ⟨{ desc := fun s => CategoryTheory.Limits.pushout.desc
          (CategoryTheory.Limits.pushout.inl φ_FA (j_FE E_bot₀) ≫ s.ι.app E_bot₀)
          (hc_F.desc (cocone_DF s))
          (by
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.condition,
              CategoryTheory.Category.assoc]
            change j_FE E_bot₀ ≫ (cocone_DF s).ι.app E_bot₀ = _
            rw [← hc_F.fac (cocone_DF s) E_bot₀, ← CategoryTheory.Category.assoc, hj_Fk E_bot₀])
         fac := fun s E => by
           apply CategoryTheory.Limits.pushout.hom_ext
           · rw [← CategoryTheory.Category.assoc, hcA_inl_app,
               CategoryTheory.Limits.pushout.inl_desc, hA_indep s E]
           · rw [← CategoryTheory.Category.assoc, hcA_inr_app,
               CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc]
             exact hc_F.fac (cocone_DF s) E
         uniq := fun s m hm => by
           apply CategoryTheory.Limits.pushout.hom_ext
           · rw [CategoryTheory.Limits.pushout.inl_desc, ← hm E_bot₀,
               ← CategoryTheory.Category.assoc, hcA_inl_app]
           · rw [CategoryTheory.Limits.pushout.inr_desc]
             apply hc_F.hom_ext
             intro E
             have hmE := congrArg (CategoryTheory.Limits.pushout.inr φ_FA (j_FE E) ≫ ·) (hm E)
             rw [← CategoryTheory.Category.assoc, hcA_inr_app,
               CategoryTheory.Category.assoc] at hmE
             exact hmE.trans (hc_F.fac (cocone_DF s) E).symm }⟩

    have hpb_Ak : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (j_A₀ ≫ Y₀.hom) p_k)
        (CategoryTheory.Limits.pullback.snd (j_A₀ ≫ Y₀.hom) p_k ≫ s_Uk)
        (AlgebraicGeometry.Spec.map φ_FA)
        (AlgebraicGeometry.Spec.map j_Fk) := by
      have hp := (CategoryTheory.IsPullback.of_hasPullback (j_A₀ ≫ Y₀.hom) p_k).paste_vert hpb_U
      rwa [CategoryTheory.Category.assoc j_A₀ Y₀.hom u_hom, ← hSpec_φFA] at hp
    let e_Ak : AlgebraicGeometry.Spec c_A.pt ≅
        CategoryTheory.Limits.pullback (j_A₀ ≫ Y₀.hom) p_k :=
      CategoryTheory.IsPullback.isoIsPullback _ _
        (AlgebraicGeometry.isPullback_SpecMap_pushout φ_FA j_Fk) hpb_Ak
    have hg_CA_pb : g_CA ≫ (j_A₀ ≫ Y₀.hom) = (j_Ck ≫ Y_k.hom) ≫ p_k := by
      rw [← CategoryTheory.Category.assoc g_CA j_A₀ Y₀.hom, hg_CA_fac]
      dsimp only [q_μ]
