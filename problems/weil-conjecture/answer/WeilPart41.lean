      have hp₀_inf : p₀ ∈ Set.range ι_inf_δ.base := by
        refine ⟨g_U.base u₀_pt, ?_⟩
        change (g_U ≫ ι_inf_δ).base u₀_pt = (j_δ ≫ ι₀_δ).base u₀_pt
        rw [hPb_charts.w]
      have hPre0 : IsPreirreducible (Set.range ι₀_δ.base) := by
        rw [← Set.image_univ]
        exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥Y_δ)).image
          ι₀_δ.base ι₀_δ.continuous.continuousOn
      have hPreInf : IsPreirreducible (Set.range ι_inf_δ.base) := by
        rw [← Set.image_univ]
        exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥Y_δ)).image
          ι_inf_δ.base ι_inf_δ.continuous.continuousOn
      have hOpen0 : IsOpen (Set.range ι₀_δ.base) := ι₀_δ.isOpenEmbedding.isOpen_range
      have hMeet0 : ∀ V_set : Set ↥P_δ, IsOpen V_set → (Set.univ ∩ V_set).Nonempty →
          (Set.range ι₀_δ.base ∩ V_set).Nonempty := by
        rintro V_set hV ⟨z, _, hzV⟩
        have hz : z ∈ Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base := by
          rw [hCov_P]; trivial
        rcases hz with hz0 | hz_inf
        · exact ⟨z, hz0, hzV⟩
        · obtain ⟨z', _, hz'V, hz'0⟩ :=
            hPreInf V_set (Set.range ι₀_δ.base) hV hOpen0 ⟨z, hz_inf, hzV⟩ ⟨p₀, hp₀_inf, hp₀_0⟩
          exact ⟨z', hz'0, hz'V⟩
      have hPreP : PreirreducibleSpace ↥P_δ := by
        rw [preirreducibleSpace_iff]
        intro V₁ V₂ hV₁ hV₂ hNe₁ hNe₂
        obtain ⟨z'', _, hz''⟩ :=
          hPre0 V₁ V₂ hV₁ hV₂ (hMeet0 V₁ hV₁ hNe₁) (hMeet0 V₂ hV₂ hNe₂)
        exact ⟨z'', trivial, hz''⟩
      exact { toPreirreducibleSpace := hPreP, toNonempty := ⟨p₀⟩ }
    have _ : IrreducibleSpace ↥P_δ := hIrred_P

    have hConn_P :
        ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
          (w₀ : W₀ ⟶ P_δ) [AlgebraicGeometry.Etale w₀],
          ConnectedSpace ↥W₀ → Nonempty ↥W₀ →
          ConnectedSpace ↥(CategoryTheory.Limits.pullback ι_inf_δ w₀) ∧
          Nonempty ↥(CategoryTheory.Limits.pullback ι_inf_δ w₀) := by
      intro W₀ _ w₀ _ hConnW₀ hNeW₀
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 w₀ := inferInstance
      have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (w₀ ≫ π_δ) := inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (w₀ ≫ π_δ) := by simpa using hSm01
      have _ : IrreducibleSpace ↥W₀ :=
        (hSmoothIrred.2 δ 1 S_δ.left W₀ (𝟙 _) (w₀ ≫ π_δ) hConnW₀).1
      obtain ⟨x₀⟩ := hNeW₀
      have hOpen_inf : IsOpen (Set.range ι_inf_δ.base) := ι_inf_δ.isOpenEmbedding.isOpen_range
      have hOpen_w : IsOpen (Set.range w₀.base) := by
        rw [← Set.image_univ]
        exact w₀.isOpenMap Set.univ isOpen_univ
      obtain ⟨_, -, ⟨u₁, hu₁⟩, ⟨x₁, hx₁⟩⟩ :=
        PreirreducibleSpace.isPreirreducible_univ (X := ↥P_δ)
          (Set.range ι_inf_δ.base) (Set.range w₀.base) hOpen_inf hOpen_w
          ⟨ι_inf_δ.base (j_δ.base u₀_pt), trivial, ⟨j_δ.base u₀_pt, rfl⟩⟩
          ⟨w₀.base x₀, trivial, ⟨x₀, rfl⟩⟩
      obtain ⟨z₀, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₁ x₁ (hu₁.trans hx₁.symm)
      have hNePb : Nonempty ↥(CategoryTheory.Limits.pullback ι_inf_δ w₀) := ⟨z₀⟩
      let snd_pb := CategoryTheory.Limits.pullback.snd ι_inf_δ w₀
      have _ : AlgebraicGeometry.IsOpenImmersion snd_pb := inferInstance
      have hPrePb : PreirreducibleSpace ↥(CategoryTheory.Limits.pullback ι_inf_δ w₀) := by
        rw [preirreducibleSpace_iff]
        intro V₁ V₂ hV₁ hV₂ hNe₁ hNe₂
        let z₁ := hNe₁.choose
        have hz₁ : z₁ ∈ V₁ := hNe₁.choose_spec.2
        let z₂ := hNe₂.choose
        have hz₂ : z₂ ∈ V₂ := hNe₂.choose_spec.2
        have hImg₁ : IsOpen (snd_pb.base '' V₁) := snd_pb.isOpenEmbedding.isOpenMap V₁ hV₁
        have hImg₂ : IsOpen (snd_pb.base '' V₂) := snd_pb.isOpenEmbedding.isOpenMap V₂ hV₂
        obtain ⟨_, -, ⟨q₁, hq₁, hsq₁⟩, ⟨q₂, hq₂, hsq₂⟩⟩ :=
          PreirreducibleSpace.isPreirreducible_univ (X := ↥W₀)
            (snd_pb.base '' V₁) (snd_pb.base '' V₂) hImg₁ hImg₂
            ⟨snd_pb.base z₁, trivial, ⟨z₁, hz₁, rfl⟩⟩
            ⟨snd_pb.base z₂, trivial, ⟨z₂, hz₂, rfl⟩⟩
        have hq_eq : q₁ = q₂ := snd_pb.isOpenEmbedding.injective (hsq₁.trans hsq₂.symm)
        subst hq_eq
        exact ⟨q₁, trivial, hq₁, hq₂⟩
      have _ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback ι_inf_δ w₀) :=
        { toPreirreducibleSpace := hPrePb, toNonempty := hNePb }
      exact ⟨inferInstance, hNePb⟩

    have hConnBasis_P :
        ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
          (w₀ : W₀ ⟶ P_δ) [AlgebraicGeometry.Etale w₀] (x : ↥W₀),
          ∃ (O : W₀.Opens),
            AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme := by
      intro W₀ _ w₀ _ x
      have hShrinkOnChart :
          ∀ (ι_ch : Y_δ ⟶ P_δ) [AlgebraicGeometry.IsOpenImmersion ι_ch],
            w₀.base x ∈ Set.range ι_ch.base →
            ∃ (O : W₀.Opens),
              AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme := by
        intro ι_ch _ hx_ch
        let U_ch : W₀.Opens := (TopologicalSpace.Opens.map w₀.base).obj ι_ch.opensRange
        have hx_Uch : x ∈ U_ch := hx_ch
        obtain ⟨O₀, hAffO₀, hxO₀, hO₀_le⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_Uch
        have hRange_O₀ : Set.range (O₀.ι ≫ w₀).base ⊆ Set.range ι_ch.base := by
          rintro _ ⟨y, rfl⟩
          exact hO₀_le y.2
        let u₀ : O₀.toScheme ⟶ Y_δ :=
          AlgebraicGeometry.IsOpenImmersion.lift ι_ch (O₀.ι ≫ w₀) hRange_O₀
        have hu₀_fac : u₀ ≫ ι_ch = O₀.ι ≫ w₀ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac ι_ch (O₀.ι ≫ w₀) hRange_O₀
        have _ : AlgebraicGeometry.Etale u₀ :=
          CategoryTheory.MorphismProperty.of_postcomp P_et u₀ ι_ch
            (inferInstance : AlgebraicGeometry.Etale ι_ch) (by rw [hu₀_fac]; infer_instance)
        have _ : AlgebraicGeometry.Etale e_Y.hom := inferInstance
        let u₁ : O₀.toScheme ⟶ (weilAffineSpaceOver Ω (δ + 1)).left := u₀ ≫ e_Y.hom
        have _ : AlgebraicGeometry.Etale u₁ := inferInstance
        have _ : AlgebraicGeometry.IsAffine O₀.toScheme := hAffO₀
        let R₀ : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op O₀)
        let x₀ : ↥O₀.toScheme := ⟨x, hxO₀⟩
        let p_x : PrimeSpectrum R₀ := hAffO₀.isoSpec.hom.base x₀
        obtain ⟨m_id, hm_max, hp_le_m⟩ :=
          Ideal.exists_le_maximal p_x.asIdeal p_x.isPrime.ne_top
        let p_m : PrimeSpectrum R₀ := ⟨m_id, hm_max.isPrime⟩
        have hCl_pm : IsClosed ({p_m} : Set (PrimeSpectrum R₀)) :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_m).mpr hm_max
        have hSpec_pm : p_x ⤳ p_m :=
          (PrimeSpectrum.le_iff_specializes p_x p_m).mp hp_le_m
        let x_m : ↥O₀.toScheme := hAffO₀.isoSpec.inv.base p_m
        have hx₀_inv : hAffO₀.isoSpec.inv.base p_x = x₀ := by
          change (hAffO₀.isoSpec.hom ≫ hAffO₀.isoSpec.inv).base x₀ = x₀
          rw [hAffO₀.isoSpec.hom_inv_id]
          rfl
        have hSpec_xm : x₀ ⤳ x_m := by
          rw [← hx₀_inv]
          exact hSpec_pm.map hAffO₀.isoSpec.inv.continuous
        have hCl_xm : IsClosed ({x_m} : Set ↥O₀.toScheme) := by
          have hSet : ({x_m} : Set ↥O₀.toScheme) =
              hAffO₀.isoSpec.hom.base ⁻¹' ({p_m} : Set (PrimeSpectrum R₀)) := by
            ext z
            simp only [Set.mem_singleton_iff]
            constructor
            · rintro rfl
              change (hAffO₀.isoSpec.inv ≫ hAffO₀.isoSpec.hom).base p_m = p_m
              rw [hAffO₀.isoSpec.inv_hom_id]
              rfl
            · intro hz
              have h1 := congrArg hAffO₀.isoSpec.inv.base hz
              change (hAffO₀.isoSpec.hom ≫ hAffO₀.isoSpec.inv).base z = x_m at h1
              rwa [hAffO₀.isoSpec.hom_inv_id] at h1
          rw [hSet]
          exact hCl_pm.preimage hAffO₀.isoSpec.hom.continuous
        obtain ⟨U₁, hAffU₁, hxm_U₁, hIntU₁⟩ :=
          hSmoothIrred.1 (δ + 1) O₀.toScheme u₁ x_m hCl_xm
        have hx₀_U₁ : x₀ ∈ U₁ := hSpec_xm.mem_open U₁.isOpen hxm_U₁
        have _ : AlgebraicGeometry.IsAffine U₁.toScheme := hAffU₁
        have _ : AlgebraicGeometry.IsIntegral U₁.toScheme := hIntU₁
        have _ : IrreducibleSpace ↥U₁.toScheme :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral U₁.toScheme
        have _ : ConnectedSpace ↥U₁.toScheme := inferInstance
        let f_open : U₁.toScheme ⟶ W₀ := U₁.ι ≫ O₀.ι
        have _ : AlgebraicGeometry.IsOpenImmersion f_open := inferInstance
        let O : W₀.Opens := f_open.opensRange
        have hAffO : AlgebraicGeometry.IsAffineOpen O :=
          AlgebraicGeometry.isAffineOpen_opensRange f_open
        have hxO : x ∈ O := ⟨⟨x₀, hx₀_U₁⟩, rfl⟩
        have hConnO : ConnectedSpace ↥O.toScheme :=
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange f_open).hom.homeomorph.surjective.connectedSpace
            (AlgebraicGeometry.Scheme.Hom.isoOpensRange f_open).hom.continuous
        exact ⟨O, hAffO, hxO, hConnO⟩
      have hwx : w₀.base x ∈ Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base := by
        rw [hCov_P]; trivial
      rcases hwx with hx0 | hx_inf
      · exact hShrinkOnChart ι₀_δ hx0
      · exact hShrinkOnChart ι_inf_δ hx_inf

    have hAcyc_P :
        ∀ (m : ℕ), 1 ≤ m →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage (ι_inf_δ ≫ π_ov.left) m (weilEtaleTorsionSheaf Y_δ ℓ)) := by
      intro m hm
      change CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage (ι_inf_δ ≫ π_δ) m (weilEtaleTorsionSheaf Y_δ ℓ))
      rw [hιinf_π, ← he_A1_fst]
      exact hZeroIso e_A1
        (CategoryTheory.Limits.pullback.fst S_δ.hom (weilAffineSpaceOver Ω 1).hom)
        m (hA1Zero δ m hm)

    have hPB_s0 : WeilIsEtaleSheafPullback s₀_δ
        (weilEtaleHigherDirectImage j_δ 1 (weilEtaleTorsionSheaf U_δ ℓ))
        (weilEtaleHigherDirectImage π_δ 2 (weilEtaleTorsionSheaf P_δ ℓ)) := by
      have hPB_ι0 := hEtaleBC P_δ Y_δ Y_δ U_δ ι_inf_δ ι₀_δ j_δ g_U hPb_charts 1
      have hi0 := hSectionLeray P_ov S_δ π_ov i₀_δ hi₀_π Y_δ ι_inf_δ hDisj_i0
        (fun Ω' _ _ x_bar hx => hFact_P Ω' x_bar hx) hConn_P hConnBasis_P hAcyc_P 1 (le_refl 1)
      rw [hi₀_eq] at hi0
      exact (hCompPB s₀_δ ι₀_δ _ _ _).2 hPB_ι0 hi0

    have hUniquePB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (G₁ G₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F G₁ →
        WeilIsEtaleSheafPullback h F G₂ →
        Nonempty (G₁ ≅ G₂) := by
      rintro X₁ X₂ h F G₁ G₂ ⟨_, _, ⟨e₁⟩⟩ ⟨_, _, ⟨e₂⟩⟩
      exact ⟨e₁.symm ≪≫ e₂⟩

    have hIsoH0 : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}}
        {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}},
        (H₁ ≅ H₂) → Nonempty (H₁.H 0 ≃+ H₂.H 0) := by
      intro S₀ H₁ H₂ e
      let T_S := weilEtaleIdTerminal.{u} S₀
      let hT_S := weilEtaleIdTerminalIsTerminal.{u} S₀
      let e₁ : H₁.H 0 ≃+ ↥(H₁.obj.obj (Opposite.op T_S)) := CategoryTheory.Sheaf.H.equiv₀ H₁ hT_S
      let e₂ : H₂.H 0 ≃+ ↥(H₂.obj.obj (Opposite.op T_S)) := CategoryTheory.Sheaf.H.equiv₀ H₂ hT_S
      let e_mid : ↥(H₁.obj.obj (Opposite.op T_S)) ≃+ ↥(H₂.obj.obj (Opposite.op T_S)) :=
        { toFun := e.hom.hom.app (Opposite.op T_S)
          invFun := e.inv.hom.app (Opposite.op T_S)
          left_inv := fun s =>
            congrArg (fun ν : H₁ ⟶ H₁ => (ν.hom.app (Opposite.op T_S)) s) e.hom_inv_id
          right_inv := fun t =>
            congrArg (fun ν : H₂ ⟶ H₂ => (ν.hom.app (Opposite.op T_S)) t) e.inv_hom_id
          map_add' := map_add (e.hom.hom.app (Opposite.op T_S)).hom }
      exact ⟨e₁.trans (e_mid.trans e₂.symm)⟩

    have hSepRes : ∀ (K : Type u) [Field K] [IsAlgClosed K],
        IsSepClosed (IsLocalRing.ResidueField K) := by
      intro K _ _
      have hbij : Function.Bijective (IsLocalRing.residue K) :=
        ⟨RingHom.injective (IsLocalRing.residue K), Ideal.Quotient.mk_surjective⟩
      let e : K ≃+* IsLocalRing.ResidueField K := RingEquiv.ofBijective (IsLocalRing.residue K) hbij
      have _ : IsAlgClosed (IsLocalRing.ResidueField K) :=
        IsAlgClosed.of_exists_root _ fun p _ hirr => by
          let p₀ : Polynomial K := p.map e.symm.toRingHom
          have hp₀_deg : p₀.degree ≠ 0 := by
            rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
            exact ne_of_gt (Irreducible.degree_pos hirr)
          obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p₀ hp₀_deg
          refine ⟨e c, ?_⟩
          have hev : Polynomial.eval c p₀ = e.symm (Polynomial.eval (e c) p) := by
            dsimp [p₀]
            rw [Polynomial.eval_map]
            conv_lhs => rw [← e.symm_apply_apply c]
            exact (Polynomial.hom_eval₂ p (RingHom.id _) e.symm.toRingHom (e c)).symm
          have hc0 : e.symm (Polynomial.eval (e c) p) = 0 := hev.symm.trans hc
          simpa using congrArg e hc0
      infer_instance

    have hIsZeroOfSubsingletonH0 :
        ∀ (K : Type u) [Field K] [IsAlgClosed K]
          (H_K : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
          Subsingleton (H_K.H 0) → CategoryTheory.Limits.IsZero H_K := by
      intro K _ _ H_K hSub
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := weilEtaleIdTerminal.{u} S_K
      let hT_K := weilEtaleIdTerminalIsTerminal.{u} S_K
      let e₀ : H_K.H 0 ≃+ ↥(H_K.obj.obj (Opposite.op T_K)) := CategoryTheory.Sheaf.H.equiv₀ H_K hT_K
      have hSubTK : Subsingleton ↥(H_K.obj.obj (Opposite.op T_K)) := e₀.symm.toEquiv.subsingleton
      have hsZero : ∀ (U_K : S_K.Etale) (s : ↥(H_K.obj.obj (Opposite.op U_K))), s = 0 := by
        intro U_K s
        let R : CategoryTheory.Sieve U_K :=
          { arrows := fun Y₁ f => ∃ (f₀ : T_K ⟶ U_K) (g₀ : Y₁ ⟶ T_K), g₀ ≫ f₀ = f
            downward_closed := by
              rintro Y₁ Z₁ f ⟨f₀, g₀, rfl⟩ h
              exact ⟨f₀, h ≫ g₀, Category.assoc h g₀ f₀⟩ }
        have hR_mem : R ∈ S_K.smallEtaleTopology U_K := by
          rw [hMemEtale]
          intro x
          obtain ⟨f_x, hf_et, hf_pt⟩ := hCoverByTK K U_K x
          exact ⟨T_K, f_x, (⊥ : PrimeSpectrum K), ⟨f_x, 𝟙 T_K, Category.id_comp f_x⟩, hf_et, hf_pt⟩
        exact H_K.isSeparated U_K R hR_mem s 0 (fun Y₁ f hf => by
          rcases hf with ⟨f₀, g₀, rfl⟩
          change (H_K.obj.map (g₀ ≫ f₀).op) s = (H_K.obj.map (g₀ ≫ f₀).op) 0
          rw [map_zero, op_comp, H_K.obj.map_comp]
          change (H_K.obj.map g₀.op) ((H_K.obj.map f₀.op) s) = 0
          rw [hSubTK.elim ((H_K.obj.map f₀.op) s) 0, map_zero])
      exact
        { unique_to := fun Y₁ =>
            ⟨{ default := 0
               uniq := fun f =>
                 CategoryTheory.Sheaf.hom_ext
                   (CategoryTheory.NatTrans.ext
                     (funext fun W_op => AddCommGrpCat.ext fun s =>
                       ((congrArg (f.hom.app W_op) (hsZero W_op.unop s)).trans
                         (map_zero (f.hom.app W_op).hom)).trans
                         ((map_zero ((0 : H_K ⟶ Y₁).hom.app W_op).hom).symm.trans
                           (congrArg ((0 : H_K ⟶ Y₁).hom.app W_op) (hsZero W_op.unop s).symm)))) }⟩
          unique_from := fun Y₁ =>
            ⟨{ default := 0
               uniq := fun f =>
                 CategoryTheory.Sheaf.hom_ext
                   (CategoryTheory.NatTrans.ext
                     (funext fun W_op => AddCommGrpCat.ext fun y =>
                       (hsZero W_op.unop ((f.hom.app W_op) y)).trans
                         (hsZero W_op.unop (((0 : Y₁ ⟶ H_K).hom.app W_op) y)).symm)) }⟩ }

    have hBdryCard_δ :
        ∀ (Ω' : Type u) [Field Ω'] [IsAlgClosed Ω']
          (z_0 : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ Y_δ),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω')),
            z_0.base pt ∉ Set.range j_δ.base) →
          ∀ (H_z : CategoryTheory.Sheaf
              (AlgebraicGeometry.Spec (CommRingCat.of Ω')).smallEtaleTopology AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback z_0
              (weilEtaleHigherDirectImage j_δ 1 (weilEtaleTorsionSheaf U_δ ℓ)) H_z →
            Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ ℓ := by
      intro Ω' _ _ z_0 hz_not H_z hPB_Hz
      let s_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ S_δ.left :=
        z_0 ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1
      have hz_fac : z_0 = s_bar ≫ s₀_δ := hFact_Y Ω' z_0 hz_not
      obtain ⟨H_s, hPB_Hs, -⟩ :=
        hExPB s_bar (weilEtaleHigherDirectImage π_δ 2 (weilEtaleTorsionSheaf P_δ ℓ))
      have hPB_Hs_z : WeilIsEtaleSheafPullback z_0
          (weilEtaleHigherDirectImage j_δ 1 (weilEtaleTorsionSheaf U_δ ℓ)) H_s := by
        rw [hz_fac]
        exact (hCompPB s_bar s₀_δ _ _ H_s).1 hPB_s0 hPB_Hs
      obtain ⟨e_Hzs⟩ := hUniquePB z_0 _ H_z H_s hPB_Hz hPB_Hs_z
      obtain ⟨e_H0⟩ := hIsoH0 e_Hzs
      let φ_ΩΩ' : CommRingCat.of Ω ⟶ CommRingCat.of Ω' :=
        AlgebraicGeometry.Spec.preimage (s_bar ≫ S_δ.hom)
      have hSpec_ΩΩ' : AlgebraicGeometry.Spec.map φ_ΩΩ' = s_bar ≫ S_δ.hom :=
        AlgebraicGeometry.Spec.map_preimage (s_bar ≫ S_δ.hom)
      let _ : Algebra Ω Ω' := φ_ΩΩ'.hom.toAlgebra
      have hφ_alg : CommRingCat.ofHom (algebraMap Ω Ω') = φ_ΩΩ' := CommRingCat.hom_ext rfl
      have hℓ_Ω' : (ℓ : Ω') ≠ 0 := by
        intro h0
        have hk0 : (ℓ : Ω) = 0 :=
          RingHom.injective φ_ΩΩ'.hom ((map_natCast φ_ΩΩ'.hom ℓ).trans (h0.trans (map_zero _).symm))
        exact hℓ hk0
      let P1_Ω' := weilProjectiveSpaceOver Ω' 1
      obtain ⟨_, _, _, hInt_P1Ω', hProj_P1Ω', hSm_P1Ω', _, _, _, _, _⟩ :=
        weil_polyP1_coord_compactification_and_properness Ω'
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1_Ω'.hom := hSm_P1Ω'
      have hPBM_Ω' : CategoryTheory.IsPullback (π_P Ω Ω') P1_Ω'.hom P1_Ω.hom
