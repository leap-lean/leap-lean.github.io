          (adj_U.homEquiv R_mod (R_sh.obj 𝒢)) (δ_U ≫ R_sh.map f) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv f ≫ 𝒢.obj.map τ_hom.op := by
        intro 𝒢 f
        have hfy : CategoryTheory.Sheaf.freeYonedaHomEquiv f =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_mod) ≫
