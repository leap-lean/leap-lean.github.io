      let e_symm_a := CategoryTheory.Limits.pullbackSymmetry (g' a ≫ w') j
      obtain ⟨p_hom_a, hp_hom_a⟩ := hPullEx e_symm_a.hom ℓ 1
      let h_a : CategoryTheory.Limits.pullback j (g' a ≫ w') ⟶
