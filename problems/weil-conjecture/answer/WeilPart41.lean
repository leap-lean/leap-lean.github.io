  have hv_qW : v_W ≫ q_W = zero_Q := by
    dsimp [q_W]
    rw [← Category.assoc, hv_qM, hzero_MQ]
  have hpre_qW : q_W.base ⁻¹' (Set.range zero_Q.base) = Set.range v_W.base := by
    rw [← hpre_qM, ← hzero_MQ]
    ext w
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · rintro ⟨pt, hpt⟩
      exact ⟨pt, ι_aff_Q.isOpenEmbedding.injective hpt⟩
    · rintro ⟨pt, hpt⟩
      exact ⟨pt, congrArg ι_aff_Q.base hpt⟩

  
  have hBij_jZ : ∀ (q : ℕ)
      (p : weilEtaleTorsionH U_Z.toScheme m₀ q →+ weilEtaleTorsionH Z_Ω m₀ q),
      WeilIsTorsionEtalePullback j_Z_open m₀ q p → Function.Bijective p :=
    fun q p hp =>
      weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective ℓ j_Z_open
        (fun q' p₁ hp₁ =>
          weil_odp_punct_sm_etale_atlas_mod_prime_pullback_bijective ℓ _ j_Z_open
            hBij0_A1 hZero_A1 hAtlas_Z q' p₁ hp₁)
        r q p hp

  have hBij_jQ : ∀ (q : ℕ)
      (p : weilEtaleTorsionH U_Q.toScheme m₀ q →+ weilEtaleTorsionH Q_sm_Ω.left m₀ q),
      WeilIsTorsionEtalePullback j_Q_open m₀ q p → Function.Bijective p :=
    fun q p hp =>
      weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective ℓ j_Q_open
        (fun q' p₁ hp₁ =>
          weil_odp_punct_sm_etale_atlas_mod_prime_pullback_bijective ℓ _ j_Q_open
            hBij0_A1 hZero_A1 hAtlas_UQ q' p₁ hp₁)
        r q p hp

  have hBij_jAmb : ∀ (q : ℕ)
      (p : weilEtaleTorsionH Q_amb_R m₀ q →+ weilEtaleTorsionH Q_amb_Ω.left m₀ q),
      WeilIsTorsionEtalePullback j_amb_open m₀ q p → Function.Bijective p :=
    fun q p hp =>
      weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective ℓ j_amb_open
        (fun q' p₁ hp₁ =>
          weil_odp_punct_sm_etale_atlas_mod_prime_pullback_bijective ℓ _ j_amb_open
            hBij0_A2 hZero_A2 hAtlas_Qamb q' p₁ hp₁)
        r q p hp

  
  have _ : AlgebraicGeometry.LocallyOfFiniteType (weilPolyLineSpecOver k).hom := by
    dsimp only [weilPolyLineSpecOver, CategoryTheory.Over.mk_hom]
    rw [← Polynomial.algebraMap_eq]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
      ((RingHom.finiteType_algebraMap (A := k) (B := Polynomial k)).mpr inferInstance)

  let i_cl : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)
  let Q_k := CategoryTheory.Limits.pullback π_Qfam.left (i_cl ≫ g_hR)
  let ι_Qk : Q_k ⟶ Q_R :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst π_Qfam.left (i_cl ≫ g_hR))
      (CategoryTheory.Limits.pullback.snd π_Qfam.left (i_cl ≫ g_hR) ≫ i_cl)
      (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)

  have hQR_Zcone_equiv : ∀ q : ℕ,
      Nonempty (weilEtaleTorsionH Q_R m₀ q ≃+ weilEtaleTorsionH Z_cone.left m₀ q) := by
    intro q
    obtain ⟨p_Qk, hp_Qk⟩ := hPullEx ι_Qk m₀ q
    have hBij_Qk : Function.Bijective p_Qk :=
      weil_odp_coker_strictly_henselian_proper_pullback_bijective
        k ℓ r hℓ_k hPBC R_bar (p_R.comp Polynomial.C) π_cl hπ_cR hπ_ker
        Q_fam (weilPolyLineSpecOver k) π_Qfam g_hR hg_hR_hom ι_Qk
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) q p_Qk hp_Qk
    obtain ⟨p_eQk, hp_eQk⟩ := hPullEx e_Qk.inv m₀ q
    have hBij_eQk : Function.Bijective p_eQk := hPullIsoBij e_Qk.symm m₀ q p_eQk hp_eQk
    exact ⟨(AddEquiv.ofBijective p_Qk hBij_Qk).trans (AddEquiv.ofBijective p_eQk hBij_eQk)⟩

  have hUQ_Qsm_equiv : ∀ q : ℕ,
      Nonempty (weilEtaleTorsionH U_Q.toScheme m₀ q ≃+ weilEtaleTorsionH Q_sm_Ω.left m₀ q) := by
    intro q
    obtain ⟨p_jQ, hp_jQ⟩ := hPullEx j_Q_open m₀ q
    exact ⟨AddEquiv.ofBijective p_jQ (hBij_jQ q p_jQ hp_jQ)⟩

  have hc0_ne : φ_R_Ω h_R ≠ 0 :=
    fun h0 => hh_ne (hφ_inj (h0.trans (map_zero φ_R_Ω).symm))
  obtain ⟨hConeCoh, hSmCoh⟩ := weil_odp_coker_quadric_cone_vs_smooth_cohomology.{u} m ℓ r
  obtain ⟨hCone_odd, hCone_even, ⟨Φ_cone, hΦ_cone_inj⟩⟩ :=
    hConeCoh k hℓ_k Q_succ Z_cone ι_succ hι_succ i_Z hSplit_succ hSplit_Z
  obtain ⟨hSm_odd, hSm_even, ⟨⟨e_Qsm_top⟩, hSm_top_surj⟩⟩ :=
    hSmCoh Ω hℓ_Ω (φ_R_Ω h_R) hc0_ne Q_amb_Ω Q_sm_Ω ι_amb_Ω hι_amb_Ω i_sm_Ω
      hSplit_amb hSplit_sm

  have hSurj_pu_of_ism : ∀ (q : ℕ)
      (p_u : weilEtaleTorsionH Q_R m₀ q →+ weilEtaleTorsionH U_Q.toScheme m₀ q),
      WeilIsTorsionEtalePullback U_Q.ι m₀ q p_u →
      (∀ p_sm : weilEtaleTorsionH Q_amb_Ω.left m₀ q →+ weilEtaleTorsionH Q_sm_Ω.left m₀ q,
        WeilIsTorsionEtalePullback i_sm_Ω.left m₀ q p_sm → Function.Surjective p_sm) →
      Function.Surjective p_u := by
    intro q p_u hp_u hSurj_ism
    obtain ⟨p_jQ, hp_jQ⟩ := hPullEx j_Q_open m₀ q
    obtain ⟨p_hypR, hp_hypR⟩ := hPullEx i_hyp_R m₀ q
    obtain ⟨p_jAmb, hp_jAmb⟩ := hPullEx j_amb_open m₀ q
    obtain ⟨p_ism, hp_ism⟩ := hPullEx i_sm_Ω.left m₀ q
    obtain ⟨p_u_hyp, hp_u_hyp⟩ := hPullEx (U_Q.ι ≫ i_hyp_R) m₀ q
    obtain ⟨p_tot, hp_tot⟩ := hPullEx (j_Q_open ≫ U_Q.ι ≫ i_hyp_R) m₀ q
    have hBij_Q : Function.Bijective p_jQ := hBij_jQ q p_jQ hp_jQ
    have hBij_Amb : Function.Bijective p_jAmb := hBij_jAmb q p_jAmb hp_jAmb
    have hSurj_sm : Function.Surjective p_ism := hSurj_ism p_ism hp_ism
    intro y
    obtain ⟨w_amb, hw_amb⟩ := hSurj_sm (p_jQ y)
    obtain ⟨z_amb, hz_amb⟩ := hBij_Amb.2 w_amb
    refine ⟨p_hypR z_amb, ?_⟩
    apply hBij_Q.1
    have h1 := hPullTri j_Q_open (U_Q.ι ≫ i_hyp_R) (j_Q_open ≫ U_Q.ι ≫ i_hyp_R) m₀ q
      p_jQ p_u_hyp p_tot rfl hp_jQ hp_u_hyp hp_tot z_amb
    have h2 := hPullTri U_Q.ι i_hyp_R (U_Q.ι ≫ i_hyp_R) m₀ q
      p_u p_hypR p_u_hyp rfl hp_u hp_hypR hp_u_hyp z_amb
    have h3 := hPullTri i_sm_Ω.left j_amb_open (j_Q_open ≫ U_Q.ι ≫ i_hyp_R) m₀ q
      p_ism p_jAmb p_tot hjQ_comm.symm hp_ism hp_jAmb hp_tot z_amb
    rw [← h2, ← h1, h3, hz_amb, hw_amb]

  have hBij_UQ_low : ∀ (q : ℕ), q ≤ 2 * m + 1 →
      ∀ (p_u : weilEtaleTorsionH Q_R m₀ q →+ weilEtaleTorsionH U_Q.toScheme m₀ q),
        WeilIsTorsionEtalePullback U_Q.ι m₀ q p_u → Function.Bijective p_u := by
    intro q hq p_u hp_u
    obtain ⟨e_QR⟩ := hQR_Zcone_equiv q
    obtain ⟨e_UQ⟩ := hUQ_Qsm_equiv q
    rcases Nat.even_or_odd' q with ⟨c, rfl | rfl⟩
    · have hc_le : c ≤ m := by omega
      have ⟨hFin_cone, hCard_cone⟩ := hCone_even c hc_le
      have ⟨hFin_sm, hCard_sm, hSurj_sm⟩ := hSm_even c hc_le
      have hSurj_u : Function.Surjective p_u := hSurj_pu_of_ism (2 * c) p_u hp_u hSurj_sm
      have _ : Finite (weilEtaleTorsionH Z_cone.left m₀ (2 * c)) := hFin_cone
      have _ : Finite (weilEtaleTorsionH Q_sm_Ω.left m₀ (2 * c)) := hFin_sm
      have _ : Finite (weilEtaleTorsionH Q_R m₀ (2 * c)) :=
        Finite.of_equiv _ e_QR.symm.toEquiv
      have _ : Finite (weilEtaleTorsionH U_Q.toScheme m₀ (2 * c)) :=
        Finite.of_equiv _ e_UQ.symm.toEquiv
      have hCard_QR : Nat.card (weilEtaleTorsionH Q_R m₀ (2 * c)) = m₀ :=
        (Nat.card_congr e_QR.toEquiv).trans hCard_cone
      have hCard_UQ : Nat.card (weilEtaleTorsionH U_Q.toScheme m₀ (2 * c)) = m₀ :=
        (Nat.card_congr e_UQ.toEquiv).trans hCard_sm
      let e_fin : weilEtaleTorsionH U_Q.toScheme m₀ (2 * c) ≃
          weilEtaleTorsionH Q_R m₀ (2 * c) :=
        (Finite.equivFinOfCardEq hCard_UQ).trans (Finite.equivFinOfCardEq hCard_QR).symm
      have hSurj_end : Function.Surjective (e_fin ∘ p_u) := e_fin.surjective.comp hSurj_u
      have hInj_end : Function.Injective (e_fin ∘ p_u) := by
        by_contra hnot_inj
        obtain ⟨g_sec, hg_sec⟩ : ∃ g_sec, Function.RightInverse g_sec (e_fin ∘ p_u) :=
          Function.surjective_iff_hasRightInverse.mp hSurj_end
        have hinj_sec : Function.Injective g_sec := hg_sec.injective
        have hsurj_sec : Function.Surjective g_sec := Finite.surjective_of_injective hinj_sec
        refine hnot_inj fun a b hab => ?_
        obtain ⟨x_a, rfl⟩ := hsurj_sec a
        obtain ⟨x_b, rfl⟩ := hsurj_sec b
        have h_eq : x_a = x_b := (hg_sec x_a).symm.trans (hab.trans (hg_sec x_b))
        rw [h_eq]
      exact ⟨fun a b hab => hInj_end (congrArg e_fin hab), hSurj_u⟩
    · have _ : Subsingleton (weilEtaleTorsionH Z_cone.left m₀ (2 * c + 1)) := hCone_odd c hq
      have _ : Subsingleton (weilEtaleTorsionH Q_sm_Ω.left m₀ (2 * c + 1)) := hSm_odd c hq
      have hSub_QR : Subsingleton (weilEtaleTorsionH Q_R m₀ (2 * c + 1)) :=
        e_QR.toEquiv.subsingleton
      have hSub_UQ : Subsingleton (weilEtaleTorsionH U_Q.toScheme m₀ (2 * c + 1)) :=
        e_UQ.toEquiv.subsingleton
      exact ⟨fun _ _ _ => hSub_QR.elim _ _, fun y => ⟨0, hSub_UQ.elim (p_u 0) y⟩⟩

  have hKer_UQ_top : ∃ (p_top : weilEtaleTorsionH Q_R m₀ (2 * m + 2) →+
        weilEtaleTorsionH U_Q.toScheme m₀ (2 * m + 2)),
      WeilIsTorsionEtalePullback U_Q.ι m₀ (2 * m + 2) p_top ∧
      ∃ (θ_ker : ↥p_top.ker →+ ZMod m₀), Function.Injective θ_ker := by
    obtain ⟨p_top, hp_top⟩ := hPullEx U_Q.ι m₀ (2 * m + 2)
    refine ⟨p_top, hp_top, ?_⟩
    obtain ⟨e_QR_top⟩ := hQR_Zcone_equiv (2 * m + 2)
    obtain ⟨e_UQ_top⟩ := hUQ_Qsm_equiv (2 * m + 2)
    let Φ_G : weilEtaleTorsionH Q_R m₀ (2 * m + 2) →+ ZMod m₀ × ZMod m₀ :=
      Φ_cone.comp e_QR_top.toAddMonoidHom
    have hΦ_G_inj : Function.Injective Φ_G := hΦ_cone_inj.comp e_QR_top.injective
    let e_tgt : weilEtaleTorsionH U_Q.toScheme m₀ (2 * m + 2) ≃+ ZMod m₀ :=
      e_UQ_top.trans e_Qsm_top
    let π_G : weilEtaleTorsionH Q_R m₀ (2 * m + 2) →+ ZMod m₀ :=
      e_tgt.toAddMonoidHom.comp p_top
    have hSurj_ptop : Function.Surjective p_top :=
      hSurj_pu_of_ism (2 * m + 2) p_top hp_top hSm_top_surj
    have hπ_G_surj : Function.Surjective π_G := e_tgt.surjective.comp hSurj_ptop
    have hker_eq : ∀ z, z ∈ p_top.ker ↔ z ∈ π_G.ker := by
      intro z
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker]
      exact ⟨fun h0 => by dsimp [π_G]; rw [h0, map_zero],
        fun h0 => e_tgt.injective (h0.trans (map_zero e_tgt).symm)⟩
    let G := weilEtaleTorsionH Q_R m₀ (2 * m + 2)
    have _ : Finite G := Finite.of_injective Φ_G hΦ_G_inj
    have hAnn_G : ∀ g : G, m₀ • g = 0 := by
      intro g
      apply hΦ_G_inj
      rw [map_nsmul, map_zero, Prod.smul_mk, nsmul_eq_mul, nsmul_eq_mul,
        ZMod.natCast_self m₀, zero_mul, zero_mul]
      rfl
    obtain ⟨g₀, hg₀⟩ := hπ_G_surj 1
    let K := ↥p_top.ker
    let K_ℓ := { k_el : K // ℓ • k_el = 0 }
    let T_ℓ := { w : ZMod m₀ × ZMod m₀ // ℓ • w = 0 }
    have hCard_ZMod_ℓ : Nat.card { u : ZMod m₀ // ℓ • u = 0 } = ℓ := by
      let e_u : Fin ℓ ≃ { u : ZMod m₀ // ℓ • u = 0 } :=
        { toFun := fun a => ⟨((a.1 * ℓ ^ r : ℕ) : ZMod m₀), by
            rw [nsmul_eq_mul]
            have hnat : ℓ * (a.1 * ℓ ^ r) = a.1 * m₀ := by dsimp [m₀]; rw [pow_succ]; ring
            rw [← Nat.cast_mul, hnat, Nat.cast_mul, ZMod.natCast_self, mul_zero]⟩
          invFun := fun u => ⟨u.1.val / ℓ ^ r, by
            have hlt : u.1.val < ℓ ^ r * ℓ := by
              have hlt0 : u.1.val < m₀ := u.1.val_lt
              simpa only [m₀, pow_succ] using hlt0
            exact Nat.div_lt_of_lt_mul hlt⟩
          left_inv := fun a => by
            ext
            dsimp
            have hlt : a.1 * ℓ ^ r < m₀ := by
              have hlt0 : a.1 * ℓ ^ r < ℓ * ℓ ^ r :=
                Nat.mul_lt_mul_of_pos_right a.2 (pow_pos hℓ_pos r)
              simpa only [m₀, pow_succ'] using hlt0
            rw [ZMod.val_natCast_of_lt hlt, Nat.mul_div_cancel _ (pow_pos hℓ_pos r)]
          right_inv := fun u => by
            ext
            dsimp
            have hu0 : ((ℓ * u.1.val : ℕ) : ZMod m₀) = 0 := by
              simpa [nsmul_eq_mul] using u.2
            have hdvd : m₀ ∣ ℓ * u.1.val := (ZMod.natCast_eq_zero_iff _ _).mp hu0
            have hdvd' : ℓ * ℓ ^ r ∣ ℓ * u.1.val := by
              simpa only [m₀, pow_succ'] using hdvd
            have hdvd_r : ℓ ^ r ∣ u.1.val := (Nat.mul_dvd_mul_iff_left hℓ_pos).mp hdvd'
            rw [Nat.div_mul_cancel hdvd_r, ZMod.natCast_zmod_val] }
      exact (Nat.card_congr e_u.symm).trans (Nat.card_fin ℓ)
    have hCard_T_ℓ : Nat.card T_ℓ = ℓ * ℓ := by
      let e_prod : T_ℓ ≃ { u : ZMod m₀ // ℓ • u = 0 } × { u : ZMod m₀ // ℓ • u = 0 } :=
        { toFun := fun w => (⟨w.1.1, congrArg Prod.fst w.2⟩, ⟨w.1.2, congrArg Prod.snd w.2⟩)
          invFun := fun p => ⟨(p.1.1, p.2.1), Prod.ext p.1.2 p.2.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl }
      rw [Nat.card_congr e_prod, Nat.card_prod, hCard_ZMod_ℓ]
    let ψ_inj : K_ℓ × Fin ℓ → T_ℓ := fun ⟨k_el, c⟩ =>
      ⟨Φ_G (k_el.1.1 + (c.1 * ℓ ^ r) • g₀), by
        rw [← map_nsmul, smul_add]
        have hk0 : ℓ • k_el.1.1 = 0 := congrArg Subtype.val k_el.2
        have hg0 : ℓ • ((c.1 * ℓ ^ r) • g₀) = 0 := by
          rw [← mul_smul]
          have hm : ℓ * (c.1 * ℓ ^ r) = c.1 * m₀ := by dsimp [m₀]; rw [pow_succ]; ring
          rw [hm, mul_smul, hAnn_G g₀, smul_zero]
        rw [hk0, hg0, add_zero, map_zero]⟩
    have hψ_inj : Function.Injective ψ_inj := by
      rintro ⟨k₁, c₁⟩ ⟨k₂, c₂⟩ h_eq
      have hG_eq : k₁.1.1 + (c₁.1 * ℓ ^ r) • g₀ = k₂.1.1 + (c₂.1 * ℓ ^ r) • g₀ :=
        hΦ_G_inj (congrArg Subtype.val h_eq)
      have hπ_eq := congrArg π_G hG_eq
      have hk₁0 : π_G k₁.1.1 = 0 := (hker_eq k₁.1.1).mp k₁.1.2
      have hk₂0 : π_G k₂.1.1 = 0 := (hker_eq k₂.1.1).mp k₂.1.2
      rw [map_add, map_add, hk₁0, hk₂0, zero_add, zero_add, map_nsmul, map_nsmul, hg₀,
        nsmul_one, nsmul_one] at hπ_eq
      have hc1_lt : c₁.1 * ℓ ^ r < m₀ := by
        have h0 : c₁.1 * ℓ ^ r < ℓ * ℓ ^ r := Nat.mul_lt_mul_of_pos_right c₁.2 (pow_pos hℓ_pos r)
        simpa only [m₀, pow_succ'] using h0
      have hc2_lt : c₂.1 * ℓ ^ r < m₀ := by
        have h0 : c₂.1 * ℓ ^ r < ℓ * ℓ ^ r := Nat.mul_lt_mul_of_pos_right c₂.2 (pow_pos hℓ_pos r)
        simpa only [m₀, pow_succ'] using h0
      have hval_eq : c₁.1 * ℓ ^ r = c₂.1 * ℓ ^ r := by
        have hv := congrArg ZMod.val hπ_eq
        rwa [ZMod.val_natCast_of_lt hc1_lt, ZMod.val_natCast_of_lt hc2_lt] at hv
      have hc_eq : c₁ = c₂ := Fin.ext (Nat.eq_of_mul_eq_mul_right (pow_pos hℓ_pos r) hval_eq)
      subst hc_eq
      have hk_val : k₁.1.1 = k₂.1.1 := add_right_cancel hG_eq
      exact Prod.ext (Subtype.ext (Subtype.ext hk_val)) rfl
    have hCard_K_ℓ : Nat.card K_ℓ ≤ ℓ := by
      have hle := Nat.card_le_card_of_injective ψ_inj hψ_inj
      rw [Nat.card_prod, Nat.card_fin, hCard_T_ℓ] at hle
      exact Nat.le_of_mul_le_mul_right hle hℓ_pos
    have hex_exp : ∃ s_exp : ℕ, ∀ k_el : K, (ℓ ^ s_exp) • k_el = 0 :=
      ⟨r + 1, fun k_el => Subtype.ext (hAnn_G k_el.1)⟩
    let decP : DecidablePred (fun s_exp : ℕ => ∀ k_el : K, (ℓ ^ s_exp) • k_el = 0) :=
      Classical.decPred _
    let s_exp := @Nat.find _ decP hex_exp
    have hs_spec : ∀ k_el : K, (ℓ ^ s_exp) • k_el = 0 := @Nat.find_spec _ decP hex_exp
    have hs_le : s_exp ≤ r + 1 :=
      @Nat.find_min' _ decP hex_exp (r + 1) (fun k_el => Subtype.ext (hAnn_G k_el.1))
    cases hs_eq : s_exp with
    | zero =>
      refine ⟨0, fun k₁ k₂ _ => ?_⟩
      have h1 : ∀ k_el : K, k_el = 0 := by
        intro k_el
        have hk := hs_spec k_el
        rwa [hs_eq, pow_zero, one_smul] at hk
      exact (h1 k₁).trans (h1 k₂).symm
    | succ s' =>
      have hs'_not : ¬ ∀ k_el : K, (ℓ ^ s') • k_el = 0 :=
        @Nat.find_min _ decP hex_exp s' (by omega)
      have hex_k₀ : ∃ k₀ : K, (ℓ ^ s') • k₀ ≠ 0 := by
        by_contra hall
        exact hs'_not fun k_el => Classical.not_not.mp fun hk => hall ⟨k_el, hk⟩
      obtain ⟨k₀, hk₀_ne⟩ := hex_k₀
      have hk₀_ann : (ℓ ^ (s' + 1)) • k₀ = 0 := hs_eq ▸ hs_spec k₀
      let _ : NeZero (ℓ ^ (s' + 1)) := ⟨pow_ne_zero _ hℓ_pos.ne'⟩
      let α : ZMod (ℓ ^ (s' + 1)) →+ K :=
        { toFun := fun c => c.val • k₀
          map_zero' := by simp
          map_add' := fun a b => by
            rw [ZMod.val_add]
            have hdiv' : a.val + b.val =
                ((a.val + b.val) / ℓ ^ (s' + 1)) * ℓ ^ (s' + 1) +
                  (a.val + b.val) % ℓ ^ (s' + 1) := by
              rw [mul_comm]
              exact (Nat.div_add_mod (a.val + b.val) (ℓ ^ (s' + 1))).symm
            have h1 : (a.val + b.val) • k₀ = ((a.val + b.val) % ℓ ^ (s' + 1)) • k₀ := by
              calc (a.val + b.val) • k₀
                  = (((a.val + b.val) / ℓ ^ (s' + 1)) * ℓ ^ (s' + 1) +
                      (a.val + b.val) % ℓ ^ (s' + 1)) • k₀ :=
                      congrArg (· • k₀) hdiv'
                _ = ((a.val + b.val) % ℓ ^ (s' + 1)) • k₀ := by
                      rw [add_smul, mul_smul, hk₀_ann, smul_zero, zero_add]
            rw [← h1, add_smul] }
      have hα_inj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro c hc
        by_contra hc_ne
        have hc_val_pos : 0 < c.val :=
          Nat.pos_of_ne_zero fun h0 => hc_ne ((ZMod.val_eq_zero c).mp h0)
        set g_cd := Nat.gcd c.val (ℓ ^ (s' + 1))
        have hdvd_pow : g_cd ∣ ℓ ^ (s' + 1) := Nat.gcd_dvd_right _ _
        obtain ⟨t, _, hg_eq⟩ := (Nat.dvd_prime_pow hℓ_prime).mp hdvd_pow
        have ht_lt : t < s' + 1 := by
          by_contra h_ge
          have ht_eq : t = s' + 1 := by omega
          have hdvd_c : g_cd ∣ c.val := Nat.gcd_dvd_left c.val (ℓ ^ (s' + 1))
          rw [hg_eq, ht_eq] at hdvd_c
          exact Nat.not_le_of_gt c.val_lt (Nat.le_of_dvd hc_val_pos hdvd_c)
        have hbez := Nat.gcd_eq_gcd_ab c.val (ℓ ^ (s' + 1))
        have h_zsmul : (g_cd : ℤ) • k₀ = 0 := by
          rw [hbez, add_zsmul, mul_comm (c.val : ℤ), mul_zsmul,
            mul_comm ((ℓ ^ (s' + 1) : ℕ) : ℤ), mul_zsmul, natCast_zsmul, natCast_zsmul]
          have hc' : c.val • k₀ = 0 := hc
          rw [hc', hk₀_ann, smul_zero, smul_zero, add_zero]
        have h_nsmul : (ℓ ^ t) • k₀ = 0 := by
          rw [← hg_eq]
          simpa only [natCast_zsmul] using h_zsmul
        have hs'_kill : (ℓ ^ s') • k₀ = 0 := by
          have hpow_eq : ℓ ^ s' = ℓ ^ (s' - t) * ℓ ^ t := by
            rw [← pow_add, Nat.sub_add_cancel (by omega)]
          rw [hpow_eq, mul_smul, h_nsmul, smul_zero]
        exact hk₀_ne hs'_kill
      let ι_Kℓ : Fin ℓ → K_ℓ := fun a =>
        ⟨α ((a.1 * ℓ ^ s' : ℕ) : ZMod (ℓ ^ (s' + 1))), by
          rw [← map_nsmul, nsmul_eq_mul]
          have hm : (ℓ : ZMod (ℓ ^ (s' + 1))) * ((a.1 * ℓ ^ s' : ℕ) : ZMod (ℓ ^ (s' + 1))) =
              ((a.1 * ℓ ^ (s' + 1) : ℕ) : ZMod (ℓ ^ (s' + 1))) := by
            have hnat : ℓ * (a.1 * ℓ ^ s') = a.1 * ℓ ^ (s' + 1) := by rw [pow_succ]; ring
            rw [← Nat.cast_mul, hnat]
          rw [hm, Nat.cast_mul, ZMod.natCast_self, mul_zero, map_zero]⟩
      have hι_Kℓ_inj : Function.Injective ι_Kℓ := by
        intro a₁ a₂ h_eq
        have hc_eq := hα_inj (congrArg Subtype.val h_eq)
        have h1 : a₁.1 * ℓ ^ s' < ℓ ^ (s' + 1) := by
          have h0 : a₁.1 * ℓ ^ s' < ℓ * ℓ ^ s' :=
            Nat.mul_lt_mul_of_pos_right a₁.2 (pow_pos hℓ_pos s')
          simpa only [pow_succ'] using h0
        have h2 : a₂.1 * ℓ ^ s' < ℓ ^ (s' + 1) := by
          have h0 : a₂.1 * ℓ ^ s' < ℓ * ℓ ^ s' :=
            Nat.mul_lt_mul_of_pos_right a₂.2 (pow_pos hℓ_pos s')
          simpa only [pow_succ'] using h0
        have hv := congrArg ZMod.val hc_eq
        rw [ZMod.val_natCast_of_lt h1, ZMod.val_natCast_of_lt h2] at hv
        exact Fin.ext (Nat.eq_of_mul_eq_mul_right (pow_pos hℓ_pos s') hv)
      have hCard_Kℓ_eq : Nat.card K_ℓ = ℓ :=
        le_antisymm hCard_K_ℓ
          ((Nat.card_fin ℓ).symm ▸ Nat.card_le_card_of_injective ι_Kℓ hι_Kℓ_inj)
      have _ : Finite K_ℓ := Subtype.finite
      let e_card : Fin ℓ ≃ K_ℓ :=
        (Finite.equivFinOfCardEq hCard_Kℓ_eq).symm
      have hι_Kℓ_surj : Function.Surjective ι_Kℓ := by
        have hinj_comp : Function.Injective (e_card.symm ∘ ι_Kℓ) :=
          e_card.symm.injective.comp hι_Kℓ_inj
        have hsurj_comp : Function.Surjective (e_card.symm ∘ ι_Kℓ) :=
          Finite.surjective_of_injective hinj_comp
        intro y
        obtain ⟨a, ha⟩ := hsurj_comp (e_card.symm y)
        exact ⟨a, e_card.symm.injective ha⟩
      have hInd : ∀ t : ℕ, t ≤ s' + 1 → ∀ k_el : K, (ℓ ^ t) • k_el = 0 → ∃ c, α c = k_el := by
        intro t
        induction t with
        | zero =>
          intro _ k_el hk
          rw [pow_zero, one_smul] at hk
          exact ⟨0, (map_zero α).trans hk.symm⟩
        | succ t ih =>
          intro ht_le k_el hk
          have hk_ℓ : ℓ • ((ℓ ^ t) • k_el) = 0 := by rwa [← mul_smul, ← pow_succ']
          obtain ⟨a, ha⟩ := hι_Kℓ_surj ⟨(ℓ ^ t) • k_el, hk_ℓ⟩
          have ha_val : α ((a.1 * ℓ ^ s' : ℕ) : ZMod (ℓ ^ (s' + 1))) = (ℓ ^ t) • k_el :=
            congrArg Subtype.val ha
          let c₁ : ZMod (ℓ ^ (s' + 1)) := ((a.1 * ℓ ^ (s' - t) : ℕ) : ZMod (ℓ ^ (s' + 1)))
          have hc₁_pow : (ℓ ^ t) • α c₁ = (ℓ ^ t) • k_el := by
            rw [← map_nsmul]
            have hnat : ℓ ^ t * (a.1 * ℓ ^ (s' - t)) = a.1 * ℓ ^ s' := by
              calc ℓ ^ t * (a.1 * ℓ ^ (s' - t))
                  = a.1 * (ℓ ^ (s' - t) * ℓ ^ t) := by ring
                _ = a.1 * ℓ ^ s' := by rw [← pow_add, Nat.sub_add_cancel (by omega)]
            have hc_eq : (ℓ ^ t) • c₁ = ((a.1 * ℓ ^ s' : ℕ) : ZMod (ℓ ^ (s' + 1))) := by
              dsimp [c₁]
              rw [nsmul_eq_mul, ← Nat.cast_mul, hnat]
            rw [hc_eq, ha_val]
          have hdiff : (ℓ ^ t) • (k_el - α c₁) = 0 := by
            rw [smul_sub, hc₁_pow, sub_self]
          obtain ⟨c₀, hc₀⟩ := ih (by omega) (k_el - α c₁) hdiff
          refine ⟨c₀ + c₁, ?_⟩
          rw [map_add, hc₀, sub_add_cancel]
      have hα_surj : Function.Surjective α :=
        fun k_el => hInd (s' + 1) (le_refl _) k_el (hs_eq ▸ hs_spec k_el)
      let e_α : ZMod (ℓ ^ (s' + 1)) ≃+ K := AddEquiv.ofBijective α ⟨hα_inj, hα_surj⟩
      let d_exp := (r + 1) - (s' + 1)
      have hd_pow : ℓ ^ (s' + 1) * ℓ ^ d_exp = m₀ := by
        dsimp [m₀]
        rw [← pow_add, Nat.add_sub_of_le (hs_eq ▸ hs_le)]
      let emb : ZMod (ℓ ^ (s' + 1)) →+ ZMod m₀ :=
        { toFun := fun c => ((c.val * ℓ ^ d_exp : ℕ) : ZMod m₀)
          map_zero' := by simp
          map_add' := fun a b => by
            rw [ZMod.val_add]
            have hdiv := Nat.div_add_mod (a.val + b.val) (ℓ ^ (s' + 1))
            have hmul : ((a.val + b.val) % ℓ ^ (s' + 1)) * ℓ ^ d_exp +
                ((a.val + b.val) / ℓ ^ (s' + 1)) * m₀ =
                (a.val + b.val) * ℓ ^ d_exp := by
              calc ((a.val + b.val) % ℓ ^ (s' + 1)) * ℓ ^ d_exp +
                      ((a.val + b.val) / ℓ ^ (s' + 1)) * m₀
                  = ((a.val + b.val) / ℓ ^ (s' + 1)) * (ℓ ^ (s' + 1) * ℓ ^ d_exp) +
                      ((a.val + b.val) % ℓ ^ (s' + 1)) * ℓ ^ d_exp := by
                        rw [hd_pow]; ring
                _ = (ℓ ^ (s' + 1) * ((a.val + b.val) / ℓ ^ (s' + 1)) +
                      (a.val + b.val) % ℓ ^ (s' + 1)) * ℓ ^ d_exp := by ring
                _ = (a.val + b.val) * ℓ ^ d_exp := by rw [hdiv]
            have hcast :
                (((a.val + b.val) % ℓ ^ (s' + 1) * ℓ ^ d_exp +
                    (a.val + b.val) / ℓ ^ (s' + 1) * m₀ : ℕ) : ZMod m₀) =
                (((a.val + b.val) * ℓ ^ d_exp : ℕ) : ZMod m₀) :=
              congrArg (fun n : ℕ => (n : ZMod m₀)) hmul
            rw [Nat.cast_add, Nat.cast_mul ((a.val + b.val) / ℓ ^ (s' + 1)), ZMod.natCast_self,
              mul_zero, add_zero, add_mul, Nat.cast_add] at hcast
            exact hcast }
      have hemb_inj : Function.Injective emb := by
        rw [injective_iff_map_eq_zero]
        intro c hc
        have hdvd : m₀ ∣ c.val * ℓ ^ d_exp := (ZMod.natCast_eq_zero_iff _ _).mp hc
        rw [← hd_pow] at hdvd
        have hdvd_c : ℓ ^ (s' + 1) ∣ c.val :=
          (Nat.mul_dvd_mul_iff_right (pow_pos hℓ_pos d_exp)).mp hdvd
        exact (ZMod.val_eq_zero c).mp (Nat.eq_zero_of_dvd_of_lt hdvd_c c.val_lt)
      exact ⟨emb.comp e_α.symm.toAddMonoidHom, hemb_inj.comp e_α.symm.injective⟩

  
