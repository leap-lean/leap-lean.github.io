          pb_η.map_mono _
        have : CategoryTheory.Mono (weilEtaleHigherDirectImageMap f'_k 0 (C_X'.map u_s)) :=
          (hConnPkg f'_k).2.2.1 (C_X'.map u_s)
        let a₁ := pb_η.map (weilEtaleHigherDirectImageMap g_k.left 0 (C_X.map u_s))
        let a₂ := pb_η.map (weilEtaleHigherDirectImageMap g_k.left 0 (C_X.map v_s))
        let a₃ := pb_η.map (δ_conn g_k.left hSE_X 0)
