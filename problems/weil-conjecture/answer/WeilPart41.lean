    let C_mod : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
      { obj := fun A => @ModuleCat.of R _ ↥(tmSubgroup A) _ (instModTm A)
        map := fun {A B} φ =>
          letI : Module R ↥(tmSubgroup A) := instModTm A
          letI : Module R ↥(tmSubgroup B) := instModTm B
