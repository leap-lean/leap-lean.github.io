        have hstep2 : (adj_U.homEquiv R_mod (R_sh.obj L_mod)) δ_U =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_mod) ≫
              L_mod.obj.map τ_hom.op :=
          (adj_U.homEquiv R_mod (R_sh.obj L_mod)).apply_symm_apply _
        exact hstep1.trans
          ((congrArg (· ≫ f.hom.app (Opposite.op (Sigma_h.obj T_U))) hstep2).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg _ hnat).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ 𝒢.obj.map τ_hom.op) hfy.symm)))))
      refine ⟨δ_U, fun 𝒢 => ?_⟩
      let postIso : (R_mod ⟶ 𝒢.obj.obj (Opposite.op U_et)) ≃
          (R_mod ⟶ 𝒢.obj.obj (Opposite.op (Sigma_h.obj T_U))) :=
        { toFun := fun ψ => ψ ≫ 𝒢.obj.map τ_hom.op
          invFun := fun ψ => ψ ≫ 𝒢.obj.map τ_inv.op
          left_inv := fun ψ => by
            dsimp only
            rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
