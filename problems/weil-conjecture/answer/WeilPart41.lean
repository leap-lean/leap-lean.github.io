      exact congrArg (fun x => Ideal.span {x}) (hδ₀_mk 2 G_R hG).symm
    let q₀ : (P_N ⧸ I_ev0) ≃+* Q_ring_0 := Ideal.quotientEquiv I_ev0 J_Q0 δ₀ hIJ₀
    let θ₀ : M_R ≃+* Q_ring_0 := α₀.trans q₀
    refine ⟨θ₀, ?_, ?_⟩
    · apply RingHom.ext
      intro r
      change q₀ (α₀ (Ideal.Quotient.mk _ (MvPolynomial.C r))) =
