          j_chart 0 =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away P₀))) ≫
          f_aff := (hCharts_all 0).2
      have hχ_units : ∀ y : Submonoid.powers P₀, IsUnit (χ_poly y) := by
        rintro ⟨_, n, rfl⟩
        dsimp
        rw [map_pow]
        exact (pow_ne_zero n hχ).isUnit
      let lift_χ : Localization.Away P₀ →+* Ω := IsLocalization.lift hχ_units
      have hlift_eq : ∀ r : Polynomial k,
          lift_χ (algebraMap (Polynomial k) (Localization.Away P₀) r) = χ_poly r :=
        fun r => IsLocalization.lift_eq hχ_units r
      have hlift_comp : lift_χ.comp (algebraMap (Polynomial k) (Localization.Away P₀)) = χ_poly :=
        RingHom.ext hlift_eq
      have hinv_χ : lift_χ (IsLocalization.Away.invSelf P₀) = (χ_poly P₀)⁻¹ := by
        have h1 := congrArg lift_χ (IsLocalization.Away.mul_invSelf P₀)
        rw [map_mul, map_one, hlift_eq] at h1
        calc
          lift_χ (IsLocalization.Away.invSelf P₀)
            = (χ_poly P₀)⁻¹ * (χ_poly P₀ * lift_χ (IsLocalization.Away.invSelf P₀)) := by
              rw [← mul_assoc, inv_mul_cancel₀ hχ, one_mul]
          _ = (χ_poly P₀)⁻¹ := by rw [h1, mul_one]
      have heval_χ : lift_χ.comp (MvPolynomial.eval₂Hom
          ((algebraMap (Polynomial k) (Localization.Away P₀)).comp Polynomial.C)
          (fun j : Fin 2 =>
            algebraMap (Polynomial k) (Localization.Away P₀) (P_vec ((0 : Fin 3).succAbove j)) *
            IsLocalization.Away.invSelf P₀)) =
          MvPolynomial.eval₂Hom (χ_poly.comp Polynomial.C)
            ![χ_poly P₁ / χ_poly P₀, χ_poly P₂ / χ_poly P₀] := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          simp [hlift_eq]
        · intro j
          fin_cases j <;>
            simp [hlift_eq, hinv_χ, div_eq_mul_inv, P_vec]
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_poly) ≫ f_aff
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom lift_χ) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away P₀))) ≫
              f_aff := by
              rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp, hlift_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom lift_χ) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.eval₂Hom
                  ((algebraMap (Polynomial k) (Localization.Away P₀)).comp Polynomial.C)
                  (fun j : Fin 2 =>
                    algebraMap (Polynomial k) (Localization.Away P₀)
                      (P_vec ((0 : Fin 3).succAbove j)) *
                    IsLocalization.Away.invSelf P₀))) ≫
              j_chart 0 := by
              congr 1
              exact h0.symm
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.eval₂Hom (χ_poly.comp Polynomial.C)
                ![χ_poly P₁ / χ_poly P₀, χ_poly P₂ / χ_poly P₀])) ≫
              j_chart 0 := by
              rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp, heval_χ]
  
  have h_part3 :
      ∀ (B R₁ R₂ R₁₂ : Type u) [CommRing B] [CommRing R₁] [CommRing R₂] [CommRing R₁₂]
        (X Y : AlgebraicGeometry.Scheme.{u})
        (ι : X ⟶ Y) [AlgebraicGeometry.IsClosedImmersion ι]
        (j : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Y) [AlgebraicGeometry.IsOpenImmersion j]
        (w₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ X) [AlgebraicGeometry.IsOpenImmersion w₁]
        (w₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶ X) [AlgebraicGeometry.IsOpenImmersion w₂]
        (Φ₁ : B →+* R₁) (Φ₂ : B →+* R₂) (β₁ : R₁ →+* R₁₂) (β₂ : R₂ →+* R₁₂),
        (∀ x : X, ι.base x ∈ Set.range j.base →
          x ∈ Set.range w₁.base ∨ x ∈ Set.range w₂.base) →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₁) ≫ j = w₁ ≫ ι →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₂) ≫ j = w₂ ≫ ι →
        AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ w₂) →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁) ≫ w₁ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ w₂ →
        Set.range w₁.base ∩ Set.range w₂.base ⊆
          Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ w₂).base →
        Function.Injective β₂ →
        (∃ g_Sigma : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ RingHom.ker Φ₁)) ⟶ X,
          CategoryTheory.IsPullback g_Sigma
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker Φ₁))))
            ι j) ∧
        (∀ (s₁ : R₁) (s₂ : R₂), β₁ s₁ = β₂ s₂ → ∃ G : B, Φ₁ G = s₁) := by
    intro B R₁ R₂ R₁₂ _ _ _ _ X Y ι _ j _ w₁ _ w₂ _ Φ₁ Φ₂ β₁ β₂
      hw_cov hΦ₁ hΦ₂ hw₁₂_open hw₁₂_comm hw₁₂_inter hβ₂_inj
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ w₂) := hw₁₂_open
    let Z := CategoryTheory.Limits.pullback ι j
    let g₀ : Z ⟶ X := CategoryTheory.Limits.pullback.fst ι j
    let q₀ : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) := CategoryTheory.Limits.pullback.snd ι j
    have hPb₀ : CategoryTheory.IsPullback g₀ q₀ ι j :=
      CategoryTheory.IsPullback.of_hasPullback ι j
    have : AlgebraicGeometry.IsOpenImmersion g₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₀.flip inferInstance
    have hq₀_closed : AlgebraicGeometry.IsClosedImmersion q₀ := inferInstance
    obtain ⟨I, e_Z, hq₀_eq⟩ := AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp hq₀_closed
    let A := B ⧸ I
    let π : B →+* A := Ideal.Quotient.mk I
    let S := AlgebraicGeometry.Spec (CommRingCat.of A)
    let g_A : S ⟶ X := e_Z.inv ≫ g₀
    have : AlgebraicGeometry.IsOpenImmersion g_A := inferInstance
    have hPb_A : CategoryTheory.IsPullback g_A
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π)) ι j := by
      refine CategoryTheory.IsPullback.of_iso hPb₀ e_Z
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        ?_ ?_ ?_ ?_
      · simp [g_A]
      · simp [hq₀_eq, π]
      · simp
      · simp
    let v₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ S :=
      hPb_A.lift w₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₁)) hΦ₁.symm
    have hv₁_g : v₁ ≫ g_A = w₁ := hPb_A.lift_fst _ _ _
    have hv₁_π : v₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom π) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₁) := hPb_A.lift_snd _ _ _
    let v₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶ S :=
      hPb_A.lift w₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₂)) hΦ₂.symm
    have hv₂_g : v₂ ≫ g_A = w₂ := hPb_A.lift_fst _ _ _
    have hv₂_π : v₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom π) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₂) := hPb_A.lift_snd _ _ _
    have : AlgebraicGeometry.IsOpenImmersion (v₁ ≫ g_A) := by
      rw [hv₁_g]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion v₁ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp v₁ g_A
    have : AlgebraicGeometry.IsOpenImmersion (v₂ ≫ g_A) := by
      rw [hv₂_g]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion v₂ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp v₂ g_A
    let α₁ : A →+* R₁ := (AlgebraicGeometry.Spec.preimage v₁).hom
    let α₂ : A →+* R₂ := (AlgebraicGeometry.Spec.preimage v₂).hom
    have hv₁_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁) = v₁ :=
      AlgebraicGeometry.Spec.map_preimage v₁
    have hv₂_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₂) = v₂ :=
      AlgebraicGeometry.Spec.map_preimage v₂
    have hα₁_π : α₁.comp π = Φ₁ := by
      have h : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α₁.comp π)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ₁) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hv₁_map, hv₁_π]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h)
    let v₁₂ : AlgebraicGeometry.Spec (CommRingCat.of R₁₂) ⟶ S :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ v₂
    have hv₁₂_g : v₁₂ ≫ g_A = AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ w₂ := by
      dsimp [v₁₂]
      rw [CategoryTheory.Category.assoc, hv₂_g]
    have : AlgebraicGeometry.IsOpenImmersion (v₁₂ ≫ g_A) := by
      rw [hv₁₂_g]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion v₁₂ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp v₁₂ g_A
    have hv₁₂_comm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁) ≫ v₁ = v₁₂ := by
      apply (cancel_mono g_A).mp
      rw [CategoryTheory.Category.assoc, hv₁_g, hv₁₂_g, hw₁₂_comm]
    have hβ_α : β₁.comp α₁ = β₂.comp α₂ := by
      have h : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β₁.comp α₁)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β₂.comp α₂)) := by
        rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          hv₁_map, hv₂_map, hv₁₂_comm]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h)
    have hv_cov_univ : (⋃ idx : ULift.{u} Bool,
        (Bool.rec (Set.range v₁.base) (Set.range v₂.base) idx.down : Set S)) = Set.univ := by
      ext s
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hx_in_j : ι.base (g_A.base s) ∈ Set.range j.base :=
        ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom π)).base s,
          congrArg (fun m : S ⟶ Y => m.base s) hPb_A.w.symm⟩
      rcases hw_cov (g_A.base s) hx_in_j with ⟨p₁, hp₁⟩ | ⟨p₂, hp₂⟩
      · refine ⟨⟨false⟩, p₁, g_A.isOpenEmbedding.injective ?_⟩
        exact (congrArg (fun m => m.base p₁) hv₁_g).trans hp₁
      · refine ⟨⟨true⟩, p₂, g_A.isOpenEmbedding.injective ?_⟩
        exact (congrArg (fun m => m.base p₂) hv₂_g).trans hp₂
    have hv_inter : Set.range v₁.base ∩ Set.range v₂.base ⊆ Set.range v₁₂.base := by
      rintro s ⟨⟨p₁, rfl⟩, ⟨p₂, hp₂⟩⟩
      have hx_inter : g_A.base (v₁.base p₁) ∈ Set.range w₁.base ∩ Set.range w₂.base := by
        refine ⟨⟨p₁, ?_⟩, ⟨p₂, ?_⟩⟩
        · exact congrArg (fun m => m.base p₁) hv₁_g.symm
        · exact (congrArg (fun m => m.base p₂) hv₂_g.symm).trans (congrArg g_A.base hp₂)
      obtain ⟨p₁₂, hp₁₂⟩ := hw₁₂_inter hx_inter
      refine ⟨p₁₂, g_A.isOpenEmbedding.injective ?_⟩
      exact (congrArg (fun m => m.base p₁₂) hv₁₂_g).trans hp₁₂
    let h_open_idx : ∀ idx : ULift.{u} Bool,
        IsOpen (Bool.rec (Set.range v₁.base) (Set.range v₂.base) idx.down : Set S) :=
      fun idx => Bool.rec v₁.isOpenEmbedding.isOpen_range v₂.isOpenEmbedding.isOpen_range idx.down
    let U_cov : ULift.{u} Bool → S.Opens :=
      fun idx => { carrier := Bool.rec (Set.range v₁.base) (Set.range v₂.base) idx.down
                   is_open' := h_open_idx idx }
    have hU_isCov : TopologicalSpace.IsOpenCover U_cov :=
      TopologicalSpace.IsOpenCover.of_sets h_open_idx hv_cov_univ
    let 𝒰 : S.OpenCover := S.openCoverOfIsOpenCover U_cov hU_isCov
    let i₀ : 𝒰.I₀ := (⟨false⟩ : ULift.{u} Bool)
    let i₁ : 𝒰.I₀ := (⟨true⟩ : ULift.{u} Bool)
    let e₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ≅ 𝒰.X i₀ := v₁.isoOpensRange
    let e₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ≅ 𝒰.X i₁ := v₂.isoOpensRange
    have he₁_f : e₁.hom ≫ 𝒰.f i₀ = v₁ := v₁.isoOpensRange_hom_ι
    have he₂_f : e₂.hom ≫ 𝒰.f i₁ = v₂ := v₂.isoOpensRange_hom_ι
    have he₁_inv_v₁ : e₁.inv ≫ v₁ = 𝒰.f i₀ := by
      rw [← he₁_f, ← CategoryTheory.Category.assoc, e₁.inv_hom_id, CategoryTheory.Category.id_comp]
    have he₂_inv_v₂ : e₂.inv ≫ v₂ = 𝒰.f i₁ := by
      rw [← he₂_f, ← CategoryTheory.Category.assoc, e₂.inv_hom_id, CategoryTheory.Category.id_comp]
    have h_mono_f : ∀ x : 𝒰.I₀, Mono (𝒰.f x) := by
      rintro ⟨b⟩
      cases b
      · change Mono (𝒰.f i₀)
        rw [← he₁_inv_v₁]
        infer_instance
      · change Mono (𝒰.f i₁)
        rw [← he₂_inv_v₂]
        infer_instance
    let P_Z := Polynomial (ULift.{u} ℤ)
    let Y_Z : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of P_Z)
    let uZ_to_Z : ULift.{u} ℤ →+* ℤ :=
      { toFun := ULift.down
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let Z_to_uZ : ℤ →+* ULift.{u} ℤ :=
      { toFun := ULift.up
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let evZ : ∀ {R : Type u} [CommRing R], R → (P_Z →+* R) := fun {R} _ r =>
      Polynomial.eval₂RingHom ((Int.castRingHom R).comp uZ_to_Z) r
    have hevZ_X : ∀ {R : Type u} [CommRing R] (r : R), evZ r Polynomial.X = r := by
      intro R _ r
      change Polynomial.eval₂ ((Int.castRingHom R).comp uZ_to_Z) r Polynomial.X = r
      exact Polynomial.eval₂_X _ r
    have hevZ_comp : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (φ : R →+* R') (r : R),
        φ.comp (evZ r) = evZ (φ r) := by
      intro R R' _ _ φ r
      apply Polynomial.ringHom_ext'
      · ext ⟨n⟩
        change φ (Polynomial.eval₂ ((Int.castRingHom R).comp uZ_to_Z) r
            (Polynomial.C ⟨n⟩)) =
          Polynomial.eval₂ ((Int.castRingHom R').comp uZ_to_Z) (φ r)
            (Polynomial.C ⟨n⟩)
        rw [Polynomial.eval₂_C, Polynomial.eval₂_C]
        change φ (Int.castRingHom R n) = Int.castRingHom R' n
        simp
      · change φ (evZ r Polynomial.X) = evZ (φ r) Polynomial.X
        rw [hevZ_X, hevZ_X]
    have hevZ_uniq : ∀ {R : Type u} [CommRing R] (ψ : P_Z →+* R),
        ψ = evZ (ψ Polynomial.X) := by
      intro R _ ψ
      apply Polynomial.ringHom_ext'
      · ext ⟨n⟩
        change ψ (Polynomial.C (Z_to_uZ n)) =
          Polynomial.eval₂ ((Int.castRingHom R).comp uZ_to_Z) (ψ Polynomial.X)
            (Polynomial.C (Z_to_uZ n))
        rw [Polynomial.eval₂_C]
        let g₁ : ℤ →+* R := ψ.comp (Polynomial.C.comp Z_to_uZ)
        let g₂ : ℤ →+* R := ((Int.castRingHom R).comp uZ_to_Z).comp Z_to_uZ
        change g₁ n = g₂ n
        exact (map_intCast g₁ n).trans (map_intCast g₂ n).symm
      · exact (hevZ_X (ψ Polynomial.X)).symm
    have hα₁_inj : Function.Injective α₁ := by
      rw [injective_iff_map_eq_zero]
      intro a ha₁
      have ha₂ : α₂ a = 0 := by
        apply hβ₂_inj
        have h := congrArg (fun f : A →+* R₁₂ => f a) hβ_α
        dsimp at h
        rw [ha₁, map_zero] at h
        exact h.symm.trans (map_zero _).symm
      let m_a : S ⟶ Y_Z := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (evZ a))
      let m_0 : S ⟶ Y_Z := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (evZ (0 : A)))
      have hm_eq : m_a = m_0 := by
        apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
        rintro ⟨b_idx⟩
        cases b_idx
        · change 𝒰.f i₀ ≫ m_a = 𝒰.f i₀ ≫ m_0
          rw [← he₁_inv_v₁, ← hv₁_map, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          congr 1
          dsimp [m_a, m_0]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
            hevZ_comp α₁ a, hevZ_comp α₁ 0, ha₁, map_zero]
        · change 𝒰.f i₁ ≫ m_a = 𝒰.f i₁ ≫ m_0
          rw [← he₂_inv_v₂, ← hv₂_map, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          congr 1
          dsimp [m_a, m_0]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
            hevZ_comp α₂ a, hevZ_comp α₂ 0, ha₂, map_zero]
      have hhom_eq := congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hm_eq)
      have hX := congrArg (fun f : P_Z →+* A => f Polynomial.X) hhom_eq
      change evZ a Polynomial.X = evZ (0 : A) Polynomial.X at hX
      rwa [hevZ_X a, hevZ_X 0] at hX
    have hI_eq : I = RingHom.ker Φ₁ := by
      ext x
      rw [← hα₁_π, RingHom.mem_ker, RingHom.coe_comp, Function.comp_apply]
      change x ∈ I ↔ α₁ (Ideal.Quotient.mk I x) = 0
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact ⟨fun h => h ▸ map_zero α₁, fun h => hα₁_inj (h.trans (map_zero α₁).symm)⟩
    refine ⟨?_, ?_⟩
    · let eqv := Ideal.quotEquivOfEq hI_eq
      let iso_ring : CommRingCat.of A ≅ CommRingCat.of (B ⧸ RingHom.ker Φ₁) :=
        { hom := CommRingCat.ofHom eqv.toRingHom
          inv := CommRingCat.ofHom eqv.symm.toRingHom
          hom_inv_id := by ext x; exact eqv.symm_apply_apply x
          inv_hom_id := by ext x; exact eqv.apply_symm_apply x }
      let iso_spec : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ RingHom.ker Φ₁)) ≅ S :=
        { hom := AlgebraicGeometry.Spec.map iso_ring.hom
          inv := AlgebraicGeometry.Spec.map iso_ring.inv
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, iso_ring.inv_hom_id,
              AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, iso_ring.hom_inv_id,
              AlgebraicGeometry.Spec.map_id] }
      refine ⟨iso_spec.hom ≫ g_A, ?_⟩
      refine CategoryTheory.IsPullback.of_iso hPb_A iso_spec.symm
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        ?_ ?_ ?_ ?_
      · simp only [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.refl_hom,
          CategoryTheory.Category.comp_id]
        exact iso_spec.inv_hom_id_assoc g_A |>.symm
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
        dsimp [iso_spec, iso_ring, π]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rfl
      · simp
      · simp
    · intro s₁ s₂ hs_compat
      let f_loc : (idx : 𝒰.I₀) → (𝒰.X idx ⟶ Y_Z) := fun idx =>
        Bool.rec
          (motive := fun b => 𝒰.X (⟨b⟩ : ULift.{u} Bool) ⟶ Y_Z)
          (e₁.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (evZ s₁)))
          (e₂.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (evZ s₂)))
          idx.down
      have h_overlap_12 :
          CategoryTheory.Limits.pullback.fst (𝒰.f i₀) (𝒰.f i₁) ≫ f_loc i₀ =
          CategoryTheory.Limits.pullback.snd (𝒰.f i₀) (𝒰.f i₁) ≫ f_loc i₁ := by
        let π₁ := CategoryTheory.Limits.pullback.fst (𝒰.f i₀) (𝒰.f i₁)
        let π₂ := CategoryTheory.Limits.pullback.snd (𝒰.f i₀) (𝒰.f i₁)
        have hcond : π₁ ≫ 𝒰.f i₀ = π₂ ≫ 𝒰.f i₁ :=
          CategoryTheory.Limits.pullback.condition
        have hsub_12 : Set.range (π₁ ≫ 𝒰.f i₀).base ⊆ Set.range v₁₂.base := by
          rintro _ ⟨w, rfl⟩
          apply hv_inter
          refine ⟨?_, ?_⟩
          · refine ⟨e₁.inv.base (π₁.base w), ?_⟩
            exact congrArg (fun m => m.base (π₁.base w)) he₁_inv_v₁
          · refine ⟨e₂.inv.base (π₂.base w), ?_⟩
            exact (congrArg (fun m => m.base (π₂.base w)) he₂_inv_v₂).trans
              (congrArg (fun m => m.base w) hcond.symm)
        let ℓ := AlgebraicGeometry.IsOpenImmersion.lift v₁₂ (π₁ ≫ 𝒰.f i₀) hsub_12
        have hℓ_fac : ℓ ≫ v₁₂ = π₁ ≫ 𝒰.f i₀ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac v₁₂ (π₁ ≫ 𝒰.f i₀) hsub_12
        have : Mono (𝒰.f i₀) := h_mono_f i₀
        have : Mono (𝒰.f i₁) := h_mono_f i₁
        have hπ₁_eq : π₁ = ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁) ≫ e₁.hom := by
          apply (cancel_mono (𝒰.f i₀)).mp
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he₁_f, hv₁₂_comm,
            hℓ_fac]
        have hπ₂_eq : π₂ = ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂) ≫ e₂.hom := by
          apply (cancel_mono (𝒰.f i₁)).mp
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he₂_f, ← hcond,
            ← hℓ_fac]
        change π₁ ≫ (e₁.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (evZ s₁))) =
          π₂ ≫ (e₂.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (evZ s₂)))
        rw [hπ₁_eq, hπ₂_eq]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
        congr 1
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
          hevZ_comp β₁ s₁, hevZ_comp β₂ s₂, hs_compat]
      have hf_glue : ∀ (x y : 𝒰.I₀),
          CategoryTheory.Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ f_loc x =
          CategoryTheory.Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ f_loc y := by
        rintro ⟨bx⟩ ⟨by_⟩
        cases bx <;> cases by_
        · have : Mono (𝒰.f i₀) := h_mono_f i₀
          have hfst_snd : CategoryTheory.Limits.pullback.fst (𝒰.f i₀) (𝒰.f i₀) =
              CategoryTheory.Limits.pullback.snd (𝒰.f i₀) (𝒰.f i₀) :=
