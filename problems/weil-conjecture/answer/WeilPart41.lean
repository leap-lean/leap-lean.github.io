    have hEt_gaw : AlgebraicGeometry.Etale (g' a ≫ w') := inferInstance
    let V_a_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g' a ≫ w') hEt_gaw
    let u_a : V_a_et ⟶ W'_et := CategoryTheory.MorphismProperty.Over.homMk (g' a) rfl trivial
