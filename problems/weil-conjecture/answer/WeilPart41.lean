          ∀ a : Fin M,
            (TopologicalSpace.Opens.map (e₀.hom ≫ U'_0.ι).base).obj (V'_R a) =
              PrimeSpectrum.basicOpen (Ideal.Quotient.mk _
                (HomogeneousLocalization.Away.isLocalizationElem
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X R 0))
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X R a.succ))))) ∧
        (∀ a : Fin M,
          ∃ e_a : AlgebraicGeometry.Spec (CommRingCat.of (Q_ring_a a)) ≅ (V'_R a).toScheme,
            e_a.hom ≫ (V'_R a).ι ≫ p'_R =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((Ideal.Quotient.mk _).comp
                  ((HomogeneousLocalization.fromZeroRingHom ℬ_R
                    (Submonoid.powers (MvPolynomial.X a.succ))).comp
                    (algebraMap R ↥(ℬ_R 0))))))) :=
by
  classical
  
  let specRingEquivIso : ∀ {A B : Type u} [CommRing A] [CommRing B] (θ : A ≃+* B),
      AlgebraicGeometry.Spec (CommRingCat.of B) ≅ AlgebraicGeometry.Spec (CommRingCat.of A) :=
    fun θ =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : θ.toRingHom.comp θ.symm.toRingHom = RingHom.id _ :=
            RingHom.ext θ.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : θ.symm.toRingHom.comp θ.toRingHom = RingHom.id _ :=
            RingHom.ext θ.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }

  
  
  
  have hS2_pullback : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (φ : A →+* B) (s : A) (t : B),
      φ s = t →
      ∃ g_top : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ Ideal.span {t})) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (A ⧸ Ideal.span {s})),
        CategoryTheory.IsPullback g_top
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t}))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s}))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro A B _ _ φ s t hst
    have hkill : ∀ a ∈ Ideal.span ({s} : Set A),
        ((Ideal.Quotient.mk (Ideal.span ({t} : Set B))).comp φ) a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      rcases ha with ⟨q, rfl⟩
      simp only [RingHom.comp_apply, map_mul, hst]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨φ q, rfl⟩)
    let φ_bar : A ⧸ Ideal.span {s} →+* B ⧸ Ideal.span {t} :=
      Ideal.Quotient.lift (Ideal.span {s})
        ((Ideal.Quotient.mk (Ideal.span {t})).comp φ) hkill
    let f : CommRingCat.of A ⟶ CommRingCat.of (A ⧸ Ideal.span {s}) :=
      CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s}))
    let g : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom φ
    let inl : CommRingCat.of (A ⧸ Ideal.span {s}) ⟶ CommRingCat.of (B ⧸ Ideal.span {t}) :=
      CommRingCat.ofHom φ_bar
    let inr : CommRingCat.of B ⟶ CommRingCat.of (B ⧸ Ideal.span {t}) :=
      CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t}))
    have hw : f ≫ inl = g ≫ inr := by
      apply CommRingCat.hom_ext
      ext a
      rfl
    have hc : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl inr hw) :=
      CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw
        (fun c => CommRingCat.ofHom (Ideal.Quotient.lift (Ideal.span {t}) c.inr.hom (by
          intro b hb
          rw [Ideal.mem_span_singleton] at hb
          rcases hb with ⟨q, rfl⟩
          rw [map_mul]
          have ht0 : c.inr.hom t = 0 := by
            rw [← hst]
            change (g ≫ c.inr).hom s = 0
            rw [← c.condition]
            change c.inl.hom (Ideal.Quotient.mk (Ideal.span {s}) s) = 0
            have hs0 : Ideal.Quotient.mk (Ideal.span ({s} : Set A)) s = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton s))
            rw [hs0, map_zero]
          rw [ht0, zero_mul])))
        (fun c => by
          apply CommRingCat.hom_ext
          apply Ideal.Quotient.ringHom_ext
          ext a
          change c.inr.hom (φ a) = c.inl.hom (Ideal.Quotient.mk (Ideal.span {s}) a)
          exact ConcreteCategory.congr_hom c.condition.symm a)
        (fun c => by
          apply CommRingCat.hom_ext
          ext b
          rfl)
        (fun c m _ hm_r => by
          apply CommRingCat.hom_ext
          apply Ideal.Quotient.ringHom_ext
          ext b
          exact ConcreteCategory.congr_hom hm_r b)
    have hPush : CategoryTheory.IsPushout f g inl inr :=
      { w := hw, isColimit' := ⟨hc⟩ }
    exact ⟨AlgebraicGeometry.Spec.map inl,
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout f g inl inr hPush⟩

  
  
  
  have hS2_ker : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (f : Z ⟶ Y)
      [AlgebraicGeometry.IsAffineHom f]
      (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (B : Type u) [CommRing B]
      (β : CommRingCat.of B ⟶ Y.presheaf.obj (Opposite.op U))
      (hβ : Function.Bijective β.hom)
      (away_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Y)
      (s_B : B)
      (g_top : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ Ideal.span {s_B})) ⟶ Z),
      U.toSpecΓ ≫ AlgebraicGeometry.Spec.map β ≫ away_B = U.ι →
      CategoryTheory.IsPullback g_top
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))))
        f away_B →
      RingHom.ker (f.app U).hom = Ideal.span {β.hom s_B} := by
    intro Z Y f _ U hU B _ β hβ away_B s_B g_top hU_ι hPb
    let e_B : B ≃+* ↑(Y.presheaf.obj (Opposite.op U)) := RingEquiv.ofBijective β.hom hβ
    let spec_β : AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      specRingEquivIso e_B
    let iso_BU : U.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of B) :=
      hU.isoSpec ≪≫ spec_β
    have hiso_BU_hom : iso_BU.hom = U.toSpecΓ ≫ AlgebraicGeometry.Spec.map β := by
      dsimp [iso_BU, spec_β, specRingEquivIso]
      rw [hU.isoSpec_hom]
      rfl
    let W : Z.Opens := f ⁻¹ᵁ U
    have hW : AlgebraicGeometry.IsAffineOpen W := hU.preimage f
    have hPb_res : CategoryTheory.IsPullback W.ι (f ∣_ U) f U.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict f U).flip
    have hPb_W : CategoryTheory.IsPullback W.ι ((f ∣_ U) ≫ iso_BU.hom) f away_B :=
      CategoryTheory.IsPullback.of_iso hPb_res
        (CategoryTheory.Iso.refl W.toScheme)
        (CategoryTheory.Iso.refl Z)
        iso_BU
        (CategoryTheory.Iso.refl Y)
        (by simp) (by simp) (by simp)
        (by rw [CategoryTheory.Iso.refl_hom, Category.comp_id, hiso_BU_hom, Category.assoc, hU_ι])
    let e_ZW : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ Ideal.span {s_B})) ≅ W.toScheme :=
      CategoryTheory.IsPullback.isoIsPullback Z (AlgebraicGeometry.Spec (CommRingCat.of B))
        hPb hPb_W
    have he_ZW_snd : e_ZW.hom ≫ ((f ∣_ U) ≫ iso_BU.hom) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))) :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd Z
        (AlgebraicGeometry.Spec (CommRingCat.of B)) hPb hPb_W
    have hf_toSpec : (f ∣_ U) ≫ U.toSpecΓ = W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (f.app U) := by
      rw [← AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict,
        ← AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE f U W le_rfl,
        ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
    let u_iso : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ Ideal.span {s_B})) ≅
        AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op W)) :=
      e_ZW ≪≫ hW.isoSpec
    have hu_eq : u_iso.hom ≫
        AlgebraicGeometry.Spec.map (β ≫ f.app U) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))) := by
      dsimp only [u_iso, Iso.trans_hom]
      rw [hW.isoSpec_hom, AlgebraicGeometry.Spec.map_comp,
        Category.assoc e_ZW.hom W.toSpecΓ, ← Category.assoc W.toSpecΓ, ← hf_toSpec,
        Category.assoc (f ∣_ U), ← hiso_BU_hom, he_ZW_snd]
    let θ := AlgebraicGeometry.Spec.preimage u_iso.hom
    let θ_inv := AlgebraicGeometry.Spec.preimage u_iso.inv
    have hθ_left : θ ≫ θ_inv = 𝟙 _ := by
      dsimp only [θ, θ_inv]
      rw [← AlgebraicGeometry.Spec.preimage_comp, u_iso.inv_hom_id,
        AlgebraicGeometry.Spec.preimage_id]
    have hθ_fac : (β ≫ f.app U) ≫ θ =
        CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B})) := by
      have hp := congrArg AlgebraicGeometry.Spec.preimage hu_eq
      rwa [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map,
        AlgebraicGeometry.Spec.preimage_map] at hp
    apply le_antisymm
    · intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨b, rfl⟩ := hβ.2 x
      have hmk0 : Ideal.Quotient.mk (Ideal.span {s_B}) b = 0 := by
        have hc := ConcreteCategory.congr_hom hθ_fac.symm b
        change Ideal.Quotient.mk (Ideal.span {s_B}) b = θ.hom ((f.app U).hom (β.hom b)) at hc
        rw [hc, hx, map_zero]
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hmk0
      rcases hmk0 with ⟨q, rfl⟩
      rw [map_mul]
      exact Ideal.mem_span_singleton.mpr ⟨β.hom q, rfl⟩
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      have hθ0 : θ.hom ((f.app U).hom (β.hom s_B)) = 0 := by
        have hc := ConcreteCategory.congr_hom hθ_fac s_B
        change θ.hom ((f.app U).hom (β.hom s_B)) = Ideal.Quotient.mk (Ideal.span {s_B}) s_B at hc
        rw [hc]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton s_B))
      have hinv := ConcreteCategory.congr_hom hθ_left ((f.app U).hom (β.hom s_B))
      change θ_inv.hom (θ.hom ((f.app U).hom (β.hom s_B))) = (f.app U).hom (β.hom s_B) at hinv
      rw [hθ0, map_zero] at hinv
      exact hinv.symm

  
  
  
  have hS2_closed_iso : ∀ {Z₁ Z₂ Y : AlgebraicGeometry.Scheme.{u}}
      (i₁ : Z₁ ⟶ Y) (i₂ : Z₂ ⟶ Y)
      [AlgebraicGeometry.IsClosedImmersion i₁] [AlgebraicGeometry.IsClosedImmersion i₂]
      {ι : Type} (U : ι → Y.Opens),
      (⨆ c : ι, U c) = ⊤ →
      (∀ c : ι, AlgebraicGeometry.IsAffineOpen (U c)) →
      (∀ c : ι, RingHom.ker (i₁.app (U c)).hom = RingHom.ker (i₂.app (U c)).hom) →
      ∃ e : Z₂ ≅ Z₁, e.hom ≫ i₁ = i₂ := by
    intro Z₁ Z₂ Y i₁ i₂ _ _ ι U hTop hAff hKer
    let U_aff : ι → Y.affineOpens := fun c => ⟨U c, hAff c⟩
    have hTop_aff : (⨆ c : ι, (U_aff c : Y.Opens)) = ⊤ := hTop
    have hideal_eq : ∀ c : ι, i₁.ker.ideal (U_aff c) = i₂.ker.ideal (U_aff c) := by
      intro c
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply]
      exact hKer c
    have hker_eq : i₁.ker = i₂.ker :=
      le_antisymm
        (AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top U_aff hTop_aff
          (fun c => (hideal_eq c).le))
        (AlgebraicGeometry.Scheme.IdealSheafData.le_of_iSup_eq_top U_aff hTop_aff
          (fun c => (hideal_eq c).ge))
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.IsClosedImmersion.lift i₁ i₂ hker_eq.le) :=
      AlgebraicGeometry.IsClosedImmersion.isIso_lift i₁ i₂ hker_eq
    exact ⟨CategoryTheory.asIso (AlgebraicGeometry.IsClosedImmersion.lift i₁ i₂ hker_eq.le),
      AlgebraicGeometry.IsClosedImmersion.lift_fac i₁ i₂ hker_eq.le⟩

  
  
  
  have hS2_chart_pb : ∀ {Q_amb P_amb P_sub : AlgebraicGeometry.Scheme.{u}}
      (ι_amb : Q_amb ⟶ P_amb) (Ψ : P_sub ⟶ P_amb)
      (D_sub : P_sub.Opens)
      (A B : Type u) [CommRing A] [CommRing B]
      (e_sub : D_sub.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of B))
      (away_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ P_amb)
      (φ : A →+* B) (s_A : A) (s_B : B)
      (j_A : AlgebraicGeometry.Spec (CommRingCat.of (A ⧸ Ideal.span {s_A})) ⟶ Q_amb),
      φ s_A = s_B →
      (e_sub.inv ≫ D_sub.ι) ≫ Ψ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ away_A →
      CategoryTheory.IsPullback j_A
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_A}))))
        ι_amb away_A →
      let p_sub := CategoryTheory.Limits.pullback.snd ι_amb Ψ
      let W_sub : (CategoryTheory.Limits.pullback ι_amb Ψ).Opens :=
        (TopologicalSpace.Opens.map p_sub.base).obj D_sub
      ∃ e_W : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ Ideal.span {s_B})) ≅ W_sub.toScheme,
        e_W.hom ≫ W_sub.ι ≫ p_sub =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))) ≫
            (e_sub.inv ≫ D_sub.ι) := by
    intro Q_amb P_amb P_sub ι_amb Ψ D_sub A B _ _ e_sub away_A φ s_A s_B j_A hφs hSq hPb_A
      p_sub W_sub
    let away_B := e_sub.inv ≫ D_sub.ι
    have hPb_res : CategoryTheory.IsPullback W_sub.ι (p_sub ∣_ D_sub) p_sub D_sub.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict p_sub D_sub).flip
    have hPb_W1 : CategoryTheory.IsPullback W_sub.ι ((p_sub ∣_ D_sub) ≫ e_sub.hom)
        p_sub away_B :=
      CategoryTheory.IsPullback.of_iso hPb_res
        (CategoryTheory.Iso.refl W_sub.toScheme)
        (CategoryTheory.Iso.refl _)
        e_sub
        (CategoryTheory.Iso.refl P_sub)
        (by simp) (by simp) (by simp)
        (by
          dsimp [away_B]
          rw [Category.comp_id, ← Category.assoc, e_sub.hom_inv_id, Category.id_comp])
    have hPb_W2 : CategoryTheory.IsPullback
        (W_sub.ι ≫ CategoryTheory.Limits.pullback.fst ι_amb Ψ)
        ((p_sub ∣_ D_sub) ≫ e_sub.hom)
        ι_amb (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ away_A) := by
      have hp := hPb_W1.paste_horiz (CategoryTheory.IsPullback.of_hasPullback ι_amb Ψ)
      rwa [hSq] at hp
    obtain ⟨g_top, hPb_quot⟩ := hS2_pullback A B φ s_A s_B hφs
    have hPb_Q2 : CategoryTheory.IsPullback (g_top ≫ j_A)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))))
        ι_amb (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ away_A) :=
      hPb_quot.paste_horiz hPb_A
    let e_W : AlgebraicGeometry.Spec (CommRingCat.of (B ⧸ Ideal.span {s_B})) ≅ W_sub.toScheme :=
      CategoryTheory.IsPullback.isoIsPullback Q_amb (AlgebraicGeometry.Spec (CommRingCat.of B))
        hPb_Q2 hPb_W2
    have he_snd : e_W.hom ≫ ((p_sub ∣_ D_sub) ≫ e_sub.hom) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))) :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd Q_amb
        (AlgebraicGeometry.Spec (CommRingCat.of B)) hPb_Q2 hPb_W2
    refine ⟨e_W, ?_⟩
    have hpost : (e_W.hom ≫ ((p_sub ∣_ D_sub) ≫ e_sub.hom)) ≫ (e_sub.inv ≫ D_sub.ι) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_B}))) ≫
          (e_sub.inv ≫ D_sub.ι) :=
      congrArg (· ≫ (e_sub.inv ≫ D_sub.ι)) he_snd
    rw [Category.assoc e_W.hom, Category.assoc (p_sub ∣_ D_sub),
      ← Category.assoc e_sub.hom, e_sub.hom_inv_id, Category.id_comp,
      AlgebraicGeometry.morphismRestrict_ι] at hpost
    exact hpost

  
  
  
  have hS3_crux : ∀ (K : Type u) [Field K] (t_K : K),
      let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) K
      let ℬ_K := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K
      letI : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra ℬ_K := MvPolynomial.gradedAlgebra
      let v_K : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) K :=
        Fin.cases (-MvPolynomial.C t_K * MvPolynomial.X 0)
          (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))
      let ψ_K : MvPolynomial (Fin (M + 1 + 1)) K →+* MvPolynomial (Fin (M + 1)) K :=
        MvPolynomial.eval₂Hom MvPolynomial.C v_K
      let L_lin : MvPolynomial (Fin (M + 1 + 1)) K :=
        MvPolynomial.X 0 + MvPolynomial.C t_K * MvPolynomial.X 1
      ∃ hL : L_lin ∈ 𝒜_K ((1 : ℕ) • 1),
        (t_K = 0 →
          Subsingleton (HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X 0) ⧸
            Ideal.span {HomogeneousLocalization.Away.mk 𝒜_K
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
              1 L_lin hL})) ∧
        (∀ _ht : t_K ≠ 0,
          let f₀ : MvPolynomial (Fin (M + 1)) K := -MvPolynomial.C t_K * MvPolynomial.X 0
          ∀ (hf₀ : f₀ ∈ ℬ_K 1)
            (χ₀ : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X 0) →+*
              HomogeneousLocalization.Away ℬ_K f₀),
            (∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) K)
              (hx : x ∈ 𝒜_K (n • 1)) (hψx : ψ_K x ∈ ℬ_K (n • 1)),
              χ₀ (HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
                n x hx) =
              HomogeneousLocalization.Away.mk ℬ_K hf₀ n (ψ_K x) hψx) →
            Function.Surjective χ₀ ∧
            RingHom.ker χ₀ =
              Ideal.span {HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
                1 L_lin hL}) ∧
        (∀ (μ : Fin (M + 1 + 1)) (ν : Fin (M + 1)),
          (μ = 1 ∧ ν = 0 ∨ ∃ a : Fin M, μ = a.succ.succ ∧ ν = a.succ) →
          ∀ (χ : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X μ) →+*
              HomogeneousLocalization.Away ℬ_K (MvPolynomial.X ν)),
            (∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) K)
              (hx : x ∈ 𝒜_K (n • 1)) (hψx : ψ_K x ∈ ℬ_K (n • 1)),
              χ (HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
                n x hx) =
              HomogeneousLocalization.Away.mk ℬ_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K ν))
                n (ψ_K x) hψx) →
            Function.Surjective χ ∧
            RingHom.ker χ =
              Ideal.span {HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
                1 L_lin hL}) := by
    intro K _ t_K 𝒜_K ℬ_K v_K ψ_K L_lin
    let _ : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra ℬ_K := MvPolynomial.gradedAlgebra
    have hL : L_lin ∈ 𝒜_K ((1 : ℕ) • 1) := by
      rw [one_smul, MvPolynomial.mem_homogeneousSubmodule]
      exact (MvPolynomial.isHomogeneous_X K 0).add
        ((MvPolynomial.isHomogeneous_X K 1).C_mul t_K)
    have hv_hom : ∀ μ : Fin (M + 1 + 1), (v_K μ).IsHomogeneous 1 := by
      refine Fin.cases ?_ (Fin.cases ?_ (fun a => ?_))
      · dsimp only [v_K, Fin.cases_zero]
        have hneg : -MvPolynomial.C t_K * (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) K) =
            MvPolynomial.C (-t_K) * MvPolynomial.X 0 := by rw [map_neg, neg_mul]
        rw [hneg]
        exact (MvPolynomial.isHomogeneous_X K 0).C_mul (-t_K)
      · dsimp only [v_K, Fin.cases_succ, Fin.cases_zero]
        exact MvPolynomial.isHomogeneous_X K 0
      · dsimp only [v_K, Fin.cases_succ]
        exact MvPolynomial.isHomogeneous_X K a.succ
    have hψ_hom : ∀ (n : ℕ) {x : MvPolynomial (Fin (M + 1 + 1)) K},
        x ∈ 𝒜_K (n • 1) → ψ_K x ∈ ℬ_K (n • 1) := by
      intro n x hx
      rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      have hev := hx.eval₂ MvPolynomial.C v_K (fun c => MvPolynomial.isHomogeneous_C _ c) hv_hom
      rwa [one_mul] at hev
    have h1_succ : (1 : Fin (M + 1 + 1)) = (0 : Fin (M + 1)).succ := Fin.ext rfl
    have hψ_L : ψ_K L_lin = 0 := by
      change (MvPolynomial.eval₂Hom MvPolynomial.C v_K)
        (MvPolynomial.X 0 + MvPolynomial.C t_K * MvPolynomial.X 1) = 0
      rw [map_add, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_X', h1_succ]
      dsimp only [v_K, Fin.cases_zero, Fin.cases_succ]
      ring

    
    let u_pos : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1 + 1)) K :=
      Fin.cases L_lin (fun ν => MvPolynomial.X ν.succ)
    let u_neg : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1 + 1)) K :=
      Fin.cases (MvPolynomial.X 0 - MvPolynomial.C t_K * MvPolynomial.X 1)
        (fun ν => MvPolynomial.X ν.succ)
    let β_pos : MvPolynomial (Fin (M + 1 + 1)) K →+* MvPolynomial (Fin (M + 1 + 1)) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C u_pos
    let β_neg : MvPolynomial (Fin (M + 1 + 1)) K →+* MvPolynomial (Fin (M + 1 + 1)) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C u_neg
    let ψ_0 : MvPolynomial (Fin (M + 1 + 1)) K →+* MvPolynomial (Fin (M + 1)) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C (Fin.cases 0 MvPolynomial.X)

    have hu_pos_hom : ∀ μ : Fin (M + 1 + 1), (u_pos μ).IsHomogeneous 1 := by
      refine Fin.cases ?_ (fun ν => ?_)
      · dsimp only [u_pos, Fin.cases_zero]
        have hL1 : L_lin ∈ 𝒜_K 1 := by simpa only [one_smul] using hL
        exact (MvPolynomial.mem_homogeneousSubmodule 1 L_lin).mp hL1
      · dsimp only [u_pos, Fin.cases_succ]
        exact MvPolynomial.isHomogeneous_X K ν.succ
    have hu_neg_hom : ∀ μ : Fin (M + 1 + 1), (u_neg μ).IsHomogeneous 1 := by
      refine Fin.cases ?_ (fun ν => ?_)
      · dsimp only [u_neg, Fin.cases_zero]
        exact (MvPolynomial.isHomogeneous_X K 0).sub
          ((MvPolynomial.isHomogeneous_X K 1).C_mul t_K)
      · dsimp only [u_neg, Fin.cases_succ]
        exact MvPolynomial.isHomogeneous_X K ν.succ

    have hβ_id : β_pos.comp β_neg = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply, RingHom.id_apply]
        dsimp only [β_pos, β_neg]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      · refine Fin.cases ?_ (fun ν => ?_)
        · rw [RingHom.comp_apply, RingHom.id_apply]
          dsimp only [β_pos, β_neg]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [u_neg, Fin.cases_zero]
          rw [map_sub, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_X', h1_succ]
          dsimp only [u_pos, Fin.cases_zero, Fin.cases_succ, L_lin]
          rw [← h1_succ]
          ring
        · rw [RingHom.comp_apply, RingHom.id_apply]
          dsimp only [β_pos, β_neg]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [u_neg, Fin.cases_succ]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [u_pos, Fin.cases_succ]
    have hψ0_β : ψ_0.comp β_neg = ψ_K := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        dsimp only [ψ_0, β_neg, ψ_K]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      · refine Fin.cases ?_ (Fin.cases ?_ (fun a => ?_))
        · rw [RingHom.comp_apply]
          dsimp only [ψ_0, β_neg, ψ_K]
          rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          dsimp only [u_neg, v_K, Fin.cases_zero]
          rw [map_sub, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_X', h1_succ]
          dsimp only [Fin.cases_zero, Fin.cases_succ]
          ring
        · rw [RingHom.comp_apply]
          dsimp only [ψ_0, β_neg, ψ_K]
          rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          dsimp only [u_neg, v_K, Fin.cases_succ, Fin.cases_zero]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [Fin.cases_succ]
        · rw [RingHom.comp_apply]
          dsimp only [ψ_0, β_neg, ψ_K]
          rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          dsimp only [u_neg, v_K, Fin.cases_succ]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [Fin.cases_succ]
    have hfinSucc_ψ0 :
        (Polynomial.evalRingHom 0).comp
          (MvPolynomial.finSuccEquiv K (M + 1)).toRingHom = ψ_0 := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        change Polynomial.eval 0 (MvPolynomial.finSuccEquiv K (M + 1) (MvPolynomial.C c)) =
          ψ_0 (MvPolynomial.C c)
        rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
          Polynomial.eval_C]
        dsimp only [ψ_0]
        rw [MvPolynomial.eval₂Hom_C]
      · refine Fin.cases ?_ (fun ν => ?_)
        · change Polynomial.eval 0 (MvPolynomial.finSuccEquiv K (M + 1) (MvPolynomial.X 0)) =
            ψ_0 (MvPolynomial.X 0)
          rw [MvPolynomial.finSuccEquiv_X_zero, Polynomial.eval_X]
          dsimp only [ψ_0]
          rw [MvPolynomial.eval₂Hom_X', Fin.cases_zero]
        · change Polynomial.eval 0
            (MvPolynomial.finSuccEquiv K (M + 1) (MvPolynomial.X ν.succ)) =
            ψ_0 (MvPolynomial.X ν.succ)
          rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C]
          dsimp only [ψ_0]
          rw [MvPolynomial.eval₂Hom_X', Fin.cases_succ]

    have hDiv : ∀ (n : ℕ) (p : MvPolynomial (Fin (M + 1 + 1)) K),
        p ∈ 𝒜_K (n • 1) → ψ_K p = 0 →
        p = 0 ∨ (1 ≤ n ∧ ∃ Q ∈ 𝒜_K ((n - 1) • 1), p = L_lin * Q) := by
      intro n p hp hψp
      let q := β_neg p
      have hq_hom : q.IsHomogeneous n := by
        have hp' : p.IsHomogeneous n := by
          rwa [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp
        have hev := hp'.eval₂ MvPolynomial.C u_neg
          (fun c => MvPolynomial.isHomogeneous_C _ c) hu_neg_hom
        rwa [one_mul] at hev
      have hψ0_q : ψ_0 q = 0 := by
        change (ψ_0.comp β_neg) p = 0
        rw [hψ0_β, hψp]
      have heval_q : Polynomial.eval 0 (MvPolynomial.finSuccEquiv K (M + 1) q) = 0 := by
        change ((Polynomial.evalRingHom 0).comp
          (MvPolynomial.finSuccEquiv K (M + 1)).toRingHom) q = 0
        rw [hfinSucc_ψ0, hψ0_q]
      have hdvd : Polynomial.X ∣ MvPolynomial.finSuccEquiv K (M + 1) q := by
        rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]
        exact heval_q
      rcases hdvd with ⟨P₁, hP₁⟩
      let q₁ := (MvPolynomial.finSuccEquiv K (M + 1)).symm P₁
      have hq_eq : q = MvPolynomial.X 0 * q₁ := by
        apply (MvPolynomial.finSuccEquiv K (M + 1)).injective
        rw [hP₁, map_mul, MvPolynomial.finSuccEquiv_X_zero]
        dsimp [q₁]
        rw [AlgEquiv.apply_symm_apply]
      by_cases hq₁0 : q₁ = 0
      · left
        have hq0 : q = 0 := by rw [hq_eq, hq₁0, mul_zero]
        have hp_eq : β_pos q = p := RingHom.congr_fun hβ_id p
        rw [← hp_eq, hq0, map_zero]
      · right
        obtain ⟨m₀, hm₀⟩ : ∃ m₀, q₁.coeff m₀ ≠ 0 := by
          by_contra hall
          exact hq₁0 (MvPolynomial.ext _ _ fun m =>
            Classical.not_not.mp fun h => hall ⟨m, h⟩)
        have hdeg_step : ∀ m, q₁.coeff m ≠ 0 →
            1 + (Finsupp.weight 1) m = n := by
          intro m hm
          have hcm : q.coeff (Finsupp.single 0 1 + m) ≠ 0 := by
            rw [hq_eq, MvPolynomial.coeff_X_mul]
            exact hm
          have hw := hq_hom hcm
          simpa only [map_add, Finsupp.weight_single, Pi.one_apply, smul_eq_mul, mul_one] using hw
        have hn1 : 1 ≤ n := by
          have h0 := hdeg_step m₀ hm₀
          omega
        have hq₁_hom : q₁.IsHomogeneous (n - 1) := by
          intro m hm
          have hm_eq := hdeg_step m hm
          omega
        let Q := β_pos q₁
        have hQ_mem : Q ∈ 𝒜_K ((n - 1) • 1) := by
          rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
          have hev := hq₁_hom.eval₂ MvPolynomial.C u_pos
            (fun c => MvPolynomial.isHomogeneous_C _ c) hu_pos_hom
          rwa [one_mul] at hev
        have hp_fac : p = L_lin * Q := by
          have hp_eq : β_pos q = p := RingHom.congr_fun hβ_id p
          rw [← hp_eq, hq_eq, map_mul]
          have hβX0 : β_pos (MvPolynomial.X 0) = L_lin :=
            MvPolynomial.eval₂Hom_X' MvPolynomial.C u_pos 0
          rw [hβX0]
        exact ⟨hn1, Q, hQ_mem, hp_fac⟩

    
    have hAwayZero : ∀ (f : MvPolynomial (Fin (M + 1)) K) (hf : f ∈ ℬ_K 1),
        f ≠ 0 → ∀ (n : ℕ) (y : MvPolynomial (Fin (M + 1)) K) (hy : y ∈ ℬ_K (n • 1)),
        HomogeneousLocalization.Away.mk ℬ_K hf n y hy = 0 → y = 0 := by
      intro f hf hf_ne n y hy hmk0
      have hval : (HomogeneousLocalization.Away.mk ℬ_K hf n y hy).val =
          (0 : HomogeneousLocalization.Away ℬ_K f).val := congrArg _ hmk0
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
        ← Localization.mk_zero 1, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hval
      rcases hval with ⟨⟨c, hc⟩, hc_eq⟩
      simp only [Submonoid.coe_one, one_mul, mul_zero] at hc_eq
      rcases hc with ⟨k, rfl⟩
      exact (mul_eq_zero.mp hc_eq).resolve_left (pow_ne_zero k hf_ne)

    
    have hSharedKer : ∀ (μ : Fin (M + 1 + 1))
        (f : MvPolynomial (Fin (M + 1)) K) (hf : f ∈ ℬ_K 1),
        f ≠ 0 →
        ∀ (χ : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X μ) →+*
            HomogeneousLocalization.Away ℬ_K f),
          (∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) K)
            (hx : x ∈ 𝒜_K (n • 1)) (hψx : ψ_K x ∈ ℬ_K (n • 1)),
            χ (HomogeneousLocalization.Away.mk 𝒜_K
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
              n x hx) =
            HomogeneousLocalization.Away.mk ℬ_K hf n (ψ_K x) hψx) →
          RingHom.ker χ =
            Ideal.span {HomogeneousLocalization.Away.mk 𝒜_K
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
              1 L_lin hL} := by
      intro μ f hf hf_ne χ hχ
      let hXμ := (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ)
      let s_μ := HomogeneousLocalization.Away.mk 𝒜_K hXμ 1 L_lin hL
      apply le_antisymm
      · intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_K hXμ z
        have hψp_mem : ψ_K p ∈ ℬ_K (n • 1) := hψ_hom n hp
        rw [hχ n p hp hψp_mem] at hz
        have hψp0 : ψ_K p = 0 := hAwayZero f hf hf_ne n (ψ_K p) hψp_mem hz
        rcases hDiv n p hp hψp0 with rfl | ⟨hn1, Q, hQ, rfl⟩
        · have hz0 : HomogeneousLocalization.Away.mk 𝒜_K hXμ n 0 hp = 0 := by
            rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk,
              HomogeneousLocalization.val_zero, Localization.mk_zero]
          rw [hz0]
          exact Ideal.zero_mem _
        · let w := HomogeneousLocalization.Away.mk 𝒜_K hXμ (n - 1) Q hQ
          have hmul : HomogeneousLocalization.Away.mk 𝒜_K hXμ n (L_lin * Q) hp = s_μ * w := by
            rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
              HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
              HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
            congr 1
            apply Subtype.ext
            dsimp
            rw [← pow_add, Nat.add_sub_of_le hn1]
          rw [hmul]
          exact Ideal.mem_span_singleton.mpr ⟨w, rfl⟩
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        have hψL_mem : ψ_K L_lin ∈ ℬ_K ((1 : ℕ) • 1) := hψ_hom 1 hL
        rw [hχ 1 L_lin hL hψL_mem, HomogeneousLocalization.ext_iff_val,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
          hψ_L, Localization.mk_zero]

    refine ⟨hL, ?_, ?_, ?_⟩
    · 
      intro ht0
      let hX0 := (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K (0 : Fin (M + 1 + 1)))
      let s_0 := HomogeneousLocalization.Away.mk 𝒜_K hX0 1 L_lin hL
      have hs0_one : s_0 = 1 := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.val_one]
        have hL0 : L_lin = MvPolynomial.X 0 := by
          dsimp [L_lin]
          rw [ht0, map_zero, zero_mul, add_zero]
        simp only [hL0, pow_one]
        exact Localization.mk_self (⟨MvPolynomial.X 0, Submonoid.mem_powers _⟩ :
          Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1 + 1)) K))
      rw [Ideal.Quotient.subsingleton_iff]
      change Ideal.span {s_0} = ⊤
      rw [hs0_one, Ideal.span_singleton_one]
    · 
      intro ht_ne f₀ hf₀ χ₀ hχ₀
      have hf₀_ne : f₀ ≠ 0 := by
        dsimp [f₀]
        have hC_ne : (-MvPolynomial.C t_K : MvPolynomial (Fin (M + 1)) K) ≠ 0 := by
          rw [← map_neg]
          intro h0
          have ht0 : -t_K = 0 :=
            (MvPolynomial.C_injective (Fin (M + 1)) K) (h0.trans (map_zero _).symm)
          exact ht_ne (neg_eq_zero.mp ht0)
        exact mul_ne_zero hC_ne (MvPolynomial.X_ne_zero 0)
      refine ⟨?_, hSharedKer 0 f₀ hf₀ hf₀_ne χ₀ hχ₀⟩
      let w₀ : Fin (M + 1) → MvPolynomial (Fin (M + 1 + 1)) K :=
        Fin.cases (-MvPolynomial.C t_K⁻¹ * MvPolynomial.X 0)
          (fun a => MvPolynomial.X a.succ.succ)
      let ρ₀ : MvPolynomial (Fin (M + 1)) K →+* MvPolynomial (Fin (M + 1 + 1)) K :=
        MvPolynomial.eval₂Hom MvPolynomial.C w₀
      have hw₀_hom : ∀ ν : Fin (M + 1), (w₀ ν).IsHomogeneous 1 := by
        refine Fin.cases ?_ (fun a => ?_)
        · dsimp only [w₀, Fin.cases_zero]
          have hneg : -MvPolynomial.C t_K⁻¹ *
              (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1 + 1)) K) =
              MvPolynomial.C (-t_K⁻¹) * MvPolynomial.X 0 := by rw [map_neg, neg_mul]
          rw [hneg]
          exact (MvPolynomial.isHomogeneous_X K 0).C_mul (-t_K⁻¹)
        · dsimp only [w₀, Fin.cases_succ]
          exact MvPolynomial.isHomogeneous_X K a.succ.succ
      have hψ_ρ₀ : ψ_K.comp ρ₀ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, RingHom.id_apply]
          dsimp only [ψ_K, ρ₀]
          rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        · refine Fin.cases ?_ (fun a => ?_)
          · rw [RingHom.comp_apply, RingHom.id_apply]
            dsimp only [ψ_K, ρ₀]
            rw [MvPolynomial.eval₂Hom_X']
            dsimp only [w₀, Fin.cases_zero]
            rw [map_mul, map_neg, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
            dsimp only [v_K, Fin.cases_zero]
            have hmul : -MvPolynomial.C t_K⁻¹ * (-MvPolynomial.C t_K *
                (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) K)) =
                MvPolynomial.C (t_K⁻¹ * t_K) * MvPolynomial.X 0 := by
              rw [MvPolynomial.C_mul]
              ring
            rw [hmul, inv_mul_cancel₀ ht_ne, map_one, one_mul]
          · rw [RingHom.comp_apply, RingHom.id_apply]
            dsimp only [ψ_K, ρ₀]
            rw [MvPolynomial.eval₂Hom_X']
            dsimp only [w₀, Fin.cases_succ]
            rw [MvPolynomial.eval₂Hom_X']
            dsimp only [v_K, Fin.cases_succ]
      intro z
      obtain ⟨n, y, hy, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ_K hf₀ z
      have hx : ρ₀ y ∈ 𝒜_K (n • 1) := by
        rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hy ⊢
        have hev := hy.eval₂ MvPolynomial.C w₀
          (fun c => MvPolynomial.isHomogeneous_C _ c) hw₀_hom
        rwa [one_mul] at hev
      have hψx_eq : ψ_K (ρ₀ y) = y := RingHom.congr_fun hψ_ρ₀ y
      have hψx : ψ_K (ρ₀ y) ∈ ℬ_K (n • 1) := hψx_eq.symm ▸ hy
      refine ⟨HomogeneousLocalization.Away.mk 𝒜_K
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
        n (ρ₀ y) hx, ?_⟩
      rw [hχ₀ n (ρ₀ y) hx hψx]
      congr 1
    · 
      intro μ ν _ χ hχ
      have hXν_ne : (MvPolynomial.X ν : MvPolynomial (Fin (M + 1)) K) ≠ 0 :=
        MvPolynomial.X_ne_zero ν
      have hXν_deg := (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K ν)
      refine ⟨?_, hSharedKer μ (MvPolynomial.X ν) hXν_deg hXν_ne χ hχ⟩
      let ρ₁ : MvPolynomial (Fin (M + 1)) K →+* MvPolynomial (Fin (M + 1 + 1)) K :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i.succ)
      have hψ_ρ₁ : ψ_K.comp ρ₁ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, RingHom.id_apply]
          dsimp only [ψ_K, ρ₁]
          rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        · refine Fin.cases ?_ (fun a => ?_)
          · rw [RingHom.comp_apply, RingHom.id_apply]
            dsimp only [ψ_K, ρ₁]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            dsimp only [v_K, Fin.cases_succ, Fin.cases_zero]
          · rw [RingHom.comp_apply, RingHom.id_apply]
            dsimp only [ψ_K, ρ₁]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            dsimp only [v_K, Fin.cases_succ]
      intro z
      obtain ⟨n, y, hy, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ_K hXν_deg z
      have hx : ρ₁ y ∈ 𝒜_K (n • 1) := by
        rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hy ⊢
        have hev := hy.eval₂ MvPolynomial.C (fun i => MvPolynomial.X i.succ)
          (fun c => MvPolynomial.isHomogeneous_C _ c)
          (fun i => MvPolynomial.isHomogeneous_X K i.succ)
        rwa [one_mul] at hev
      have hψx_eq : ψ_K (ρ₁ y) = y := RingHom.congr_fun hψ_ρ₁ y
      have hψx : ψ_K (ρ₁ y) ∈ ℬ_K (n • 1) := hψx_eq.symm ▸ hy
      refine ⟨HomogeneousLocalization.Away.mk 𝒜_K
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K μ))
        n (ρ₁ y) hx, ?_⟩
      rw [hχ n (ρ₁ y) hx hψx]
      congr 1

  
  
  
  have hS4_cover : ∀ (R : Type u) [CommRing R] (N : ℕ),
      (⨆ ν : Fin (N + 1), weilProjBasicOpen R N ν) = ⊤ := by
    intro R _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    change (⨆ ν : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X ν)) = ⊤
    refine AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
      (fun ν => ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X R ν)⟩) ?_
    rw [eq_top_iff]
    intro p hp_top
    clear hp_top
    induction p using MvPolynomial.induction_on with
    | C r =>
      have hc : (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
        rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
          MvPolynomial.smul_eq_C_mul, mul_one]
      rw [← hc]
      exact Subalgebra.algebraMap_mem _ (algebraMap R ↥(𝒜 0) r)
    | add p₁ p₂ hp₁ hp₂ => exact Subalgebra.add_mem _ hp₁ hp₂
    | mul_X p₁ ν hp₁ =>
      exact Subalgebra.mul_mem _ hp₁ (Algebra.subset_adjoin ⟨ν, rfl⟩)

  
  
  
  have hS4_amb_chart : ∀ (k : Type u) [Field k] (d₀ : ℕ), 1 ≤ d₀ →
      let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) k
      letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
      ∀ (F_k : MvPolynomial (Fin (M + 1 + 1)) k)
        (Q_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_k : Q_k.left ⟶ (weilProjectiveSpaceOver k (M + 1)).left),
        IsHomogeneousHypersurfacePullbackOver k (M + 1) d₀
          (𝟙 (weilProjectiveSpaceOver k (M + 1))) F_k ι_k →
        ∃ hF_k : F_k ∈ 𝒜_k (d₀ • 1),
          ∀ μ : Fin (M + 1 + 1),
            let hXμ :=
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k μ)
            let s_μ := HomogeneousLocalization.Away.mk 𝒜_k hXμ d₀ F_k hF_k
            RingHom.ker (ι_k.app (weilProjBasicOpen k (M + 1) μ)).hom =
              Ideal.span
                {(AlgebraicGeometry.Proj.awayToSection 𝒜_k (MvPolynomial.X μ)).hom s_μ} ∧
            ∃ j_μ : AlgebraicGeometry.Spec
                (CommRingCat.of
                  (HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X μ) ⧸ Ideal.span {s_μ})) ⟶
                Q_k.left,
              CategoryTheory.IsPullback j_μ
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_μ}))))
                ι_k
                (AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X μ) hXμ zero_lt_one) := by
    intro k _ d₀ _ 𝒜_k F_k Q_k ι_k hHyp
    let _ : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
    rcases hHyp with ⟨hCl, hF_k, _, hKer⟩
    refine ⟨hF_k, fun μ => ?_⟩
    intro hXμ s_μ
    let P_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_k
    let f_Q : Q_k.left ⟶ P_k := ι_k
    have _ : AlgebraicGeometry.IsClosedImmersion f_Q := hCl
