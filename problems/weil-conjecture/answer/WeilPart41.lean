      have hL_eval : Θ (B_j.obj V_a_et) ((Q₁.map u_a.op) ξ₁) = p_hom_a (q_a ξ) := by
        have hnat := hΘ_nat (B_j.map u_a) p_bj_ua hp_bj_ua ξ₁
