    have h_units_RT : ∀ u : R_Tˣ,
        ∃ (μ : k) (_ : μ ≠ 0) (m : ℤ),
          (u : R_T) = ι_T_hom (Polynomial.C μ) * (↑(u_T ^ m) : R_T) := by
      intro u
      obtain ⟨⟨A, _, a, rfl⟩, huA⟩ :=
