  have h_s6 : ∀ (Q₀ A H_X H_Z : Type u) [AddCommGroup Q₀] [AddCommGroup A]
      [AddCommGroup H_X] [AddCommGroup H_Z]
      (ℓ₀ : ℕ) (_ : 0 < ℓ₀)
      (δ : Q₀ →+ A) (κ_star : A →+ H_X) (p_top : H_X →+ H_Z),
      Function.Injective δ →
      (∀ y : Q₀, δ y ∈ κ_star.ker) →
      κ_star.range = p_top.ker →
      Function.Surjective p_top →
      Finite H_Z →
      Nat.card H_X = ℓ₀ * Nat.card H_Z →
      Finite A →
      Nat.card A ≤ ℓ₀ →
      Subsingleton Q₀ := by
    intro Q₀ A H_X H_Z _ _ _ _ ℓ₀ hℓ_pos δ κ_star p_top
      hδ_inj hδ_ker hRange_eq hSurj hFin_Z hCard_XZ hFin_A hCard_A
    let e_rng : ↥p_top.range ≃+ H_Z :=
      (QuotientAddGroup.quotientKerEquivRange p_top).symm.trans
        (QuotientAddGroup.quotientKerEquivOfSurjective p_top hSurj)
    have hCard_prng : Nat.card ↥p_top.range = Nat.card H_Z :=
      Nat.card_congr e_rng.toEquiv
    have hcZ_pos : 0 < Nat.card H_Z := @Nat.card_pos H_Z ⟨0⟩ hFin_Z
    have hProd_X : Nat.card ↥p_top.ker * Nat.card H_Z = ℓ₀ * Nat.card H_Z := by
      calc
        Nat.card ↥p_top.ker * Nat.card H_Z
          = Nat.card ↥p_top.ker * Nat.card ↥p_top.range := by rw [← hCard_prng]
        _ = Nat.card ↥p_top.ker * p_top.ker.index := by rw [← AddSubgroup.index_ker p_top]
        _ = Nat.card H_X := AddSubgroup.card_mul_index p_top.ker
        _ = ℓ₀ * Nat.card H_Z := hCard_XZ
    have hCard_pker : Nat.card ↥p_top.ker = ℓ₀ := Nat.mul_right_cancel hcZ_pos hProd_X
    have hCard_krng : Nat.card ↥κ_star.range = ℓ₀ := by rw [hRange_eq, hCard_pker]
    have hProd_A : Nat.card ↥κ_star.ker * ℓ₀ ≤ 1 * ℓ₀ := by
      calc
        Nat.card ↥κ_star.ker * ℓ₀
          = Nat.card ↥κ_star.ker * Nat.card ↥κ_star.range := by rw [← hCard_krng]
        _ = Nat.card ↥κ_star.ker * κ_star.ker.index := by rw [← AddSubgroup.index_ker κ_star]
        _ = Nat.card A := AddSubgroup.card_mul_index κ_star.ker
        _ ≤ ℓ₀ := hCard_A
        _ = 1 * ℓ₀ := (Nat.one_mul ℓ₀).symm
    have hCard_kker : Nat.card ↥κ_star.ker ≤ 1 := Nat.le_of_mul_le_mul_right hProd_A hℓ_pos
