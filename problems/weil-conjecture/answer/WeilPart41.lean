        have hsum_eq := hSum_mk nd.num.1.support hsupp_deg
        rw [← MvPolynomial.as_sum nd.num.1] at hsum_eq
        have hs_eq : s₁ ^ n = ⟨nd.den.1, nd.den_mem⟩ := Subtype.ext hn
        rwa [hs_eq] at hsum_eq
    refine ⟨{ toFun := α_R
              invFun := β_R
              left_inv := h_left
              right_inv := h_right
              map_mul' := map_mul α_R
              map_add' := map_add α_R }, ?_, ?_⟩
    · intro c
      exact MvPolynomial.eval₂Hom_C ι_R u_R c
    · intro b
      change (α_R (MvPolynomial.X b)).val = _
      rw [MvPolynomial.eval₂Hom_X']
