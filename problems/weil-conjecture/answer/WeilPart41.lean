          _ = k • LinearMap.lsmul R R c (e₀ : R) := map_nsmul _ _ _
          _ = k • g e₀ := by rw [hge₀]
          _ = g (k • e₀) := (map_nsmul g k e₀).symm
          _ = g ⟨x, hx⟩ := by rw [← hx_gen]

  have hCogSub : ∀ (m : ℕ), 1 ≤ m → ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, m • x = 0) →
      Subsingleton (A →+ ZMod m) →
      Subsingleton A := by
    intro m hm A _ hTors hSubDual
    let R := ULift.{u, 0} (ZMod m)
    have hZero : ∀ a : A, a = 0 := by
      intro a
      have hrem : ∀ (n : ℕ) (x : A), n • x = (n % m) • x := by
        intro n x
        conv_lhs => rw [← Nat.div_add_mod n m]
        rw [add_nsmul, mul_comm m (n / m), mul_smul, hTors x, smul_zero, zero_add]
      by_cases hm1 : m = 1
      · subst hm1
        simpa using hTors a
      · have : NeZero m := ⟨by omega⟩
        have : Fact (1 < m) := ⟨by omega⟩
        by_contra ha_ne
        let instSMulRA : SMul R A := ⟨fun r x => r.down.val • x⟩
        let _ := instSMulRA
        have hsmul_def : ∀ (r : R) (x : A), r • x = r.down.val • x := fun _ _ => rfl
        let instModRA : Module R A :=
          { one_smul := fun x => by
              rw [hsmul_def]
              change (1 : ZMod m).val • x = x
              rw [ZMod.val_one m, one_nsmul]
            mul_smul := fun r s x => by
              rw [hsmul_def, hsmul_def, hsmul_def]
              change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
              rw [ZMod.val_mul, ← hrem, mul_smul]
            smul_zero := fun r => by rw [hsmul_def, nsmul_zero]
            smul_add := fun r x y => by rw [hsmul_def, hsmul_def, hsmul_def, nsmul_add]
            add_smul := fun r s x => by
              rw [hsmul_def, hsmul_def, hsmul_def]
              change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
              rw [ZMod.val_add, ← hrem, add_nsmul]
            zero_smul := fun x => by
              rw [hsmul_def]
              change (0 : ZMod m).val • x = 0
              rw [ZMod.val_zero, zero_nsmul] }
        let _ := instModRA
        let P : ℕ → Prop := fun k => 0 < k ∧ k • a = 0
        have hex : ∃ k, P k := ⟨m, by omega, hTors a⟩
        let d₀ : ℕ := Nat.find hex
        have hd₀_spec : P d₀ := Nat.find_spec hex
        have hd₀_pos : 0 < d₀ := hd₀_spec.1
        have hd₀_ann : d₀ • a = 0 := hd₀_spec.2
        have hd₀_ge2 : 2 ≤ d₀ := by
          by_contra hlt
          have hd1 : d₀ = 1 := by omega
          rw [hd1, one_nsmul] at hd₀_ann
          exact ha_ne hd₀_ann
        have hd₀_dvd : ∀ n : ℕ, n • a = 0 → d₀ ∣ n := by
          intro n hn
          let rem := n % d₀
          have hrem_lt : rem < d₀ := Nat.mod_lt n hd₀_pos
          have hrem_ann : rem • a = 0 := by
            have hdiv : d₀ * (n / d₀) + rem = n := Nat.div_add_mod n d₀
            have h1 : (d₀ * (n / d₀)) • a + rem • a = 0 := by
              rw [← add_nsmul, hdiv, hn]
            rw [mul_comm d₀ (n / d₀), mul_smul, hd₀_ann, smul_zero, zero_add] at h1
            exact h1
          by_cases hr0 : rem = 0
          · exact Nat.dvd_of_mod_eq_zero hr0
          · exfalso
            exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hr0, hrem_ann⟩
        have hd₀_dvd_m : d₀ ∣ m := hd₀_dvd m (hTors a)
        let q : ℕ := m / d₀
        have hqd₀ : q * d₀ = m := Nat.div_mul_cancel hd₀_dvd_m
        have hq_pos : 0 < q := by
          by_contra hq0
          have hq_eq : q = 0 := Nat.eq_zero_of_not_pos hq0
          rw [hq_eq, zero_mul] at hqd₀
          omega
        have hq_lt_m : q < m := by nlinarith
        have hq_cast_ne : (q : ZMod m) ≠ 0 := by
          intro hq0
          have hv := congrArg ZMod.val hq0
          rw [ZMod.val_natCast_of_lt hq_lt_m, ZMod.val_zero] at hv
          omega
        let μ : R →ₗ[R] A := LinearMap.toSpanSingleton R A a
        let g_tilde : R →ₗ[R] R := LinearMap.lsmul R R (ULift.up (q : ZMod m))
        have hker : LinearMap.ker μ ≤ LinearMap.ker g_tilde := by
          intro r hr
          rw [LinearMap.mem_ker] at hr ⊢
          change r.down.val • a = 0 at hr
          obtain ⟨k, hk⟩ := hd₀_dvd r.down.val hr
          apply ULift.ext
          change (q : ZMod m) * r.down = 0
          rw [← ZMod.natCast_zmod_val r.down, hk]
          have hqm0 : ((q * d₀ : ℕ) : ZMod m) = 0 := by rw [hqd₀, ZMod.natCast_self]
          push_cast at hqm0 ⊢
          linear_combination (k : ZMod m) * hqm0
        let g₀ : LinearMap.range μ →ₗ[R] R :=
          (Submodule.liftQ (LinearMap.ker μ) g_tilde hker).comp
            (LinearMap.quotKerEquivRange μ).symm.toLinearMap
        obtain ⟨lam, hlam⟩ := (hInjR m hm).out (LinearMap.range μ).subtype Subtype.val_injective g₀
        let φ : A →+ ZMod m :=
          { toFun := fun x => (lam x).down
            map_zero' := by rw [map_zero]; rfl
            map_add' := fun x y => by rw [map_add]; rfl }
        have hφa : φ a = (q : ZMod m) := by
          have ha_mu : μ (1 : R) = a := one_smul R a
          have hmem : a ∈ LinearMap.range μ := ⟨1, ha_mu⟩
          have h1 : lam a = g₀ ⟨a, hmem⟩ := hlam ⟨a, hmem⟩
          have h2 : (LinearMap.quotKerEquivRange μ) (Submodule.Quotient.mk (1 : R)) = ⟨a, hmem⟩ :=
            Subtype.ext ha_mu
          have h3 : (LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩ =
              Submodule.Quotient.mk (1 : R) := by
            rw [← h2, LinearEquiv.symm_apply_apply]
          have h4 : g₀ ⟨a, hmem⟩ = g_tilde (1 : R) := by
            change Submodule.liftQ (LinearMap.ker μ) g_tilde hker
              ((LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩) = g_tilde 1
            rw [h3, Submodule.liftQ_apply]
          change (lam a).down = (q : ZMod m)
          rw [h1, h4]
          change ((q : ZMod m) * (1 : ZMod m)) = (q : ZMod m)
          exact mul_one _
        have hφ0 : φ = 0 := @Subsingleton.elim _ hSubDual φ 0
        have hφa0 : φ a = 0 := by rw [hφ0, AddMonoidHom.zero_apply]
        exact hq_cast_ne (hφa.symm.trans hφa0)
    exact ⟨fun x y => (hZero x).trans (hZero y).symm⟩

  have hDualCardLe : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
      (A : Type u) [AddCommGroup A],
      (∀ x : A, ℓ • x = 0) →
      Finite (A →+ ZMod ℓ) →
      Nat.card (A →+ ZMod ℓ) ≤ ℓ →
      Finite A ∧ Nat.card A ≤ ℓ := by
    intro ℓ _ A _ hTors hFinDual hCardDual
    have hPrime : Nat.Prime ℓ := Fact.out
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % ℓ) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n ℓ]
      rw [add_nsmul, mul_comm ℓ (n / ℓ), mul_smul, hTors x, smul_zero, zero_add]
    let instSMul : SMul (ZMod ℓ) A := ⟨fun c x => c.val • x⟩
    let _ : SMul (ZMod ℓ) A := instSMul
    have hsmul_def : ∀ (c : ZMod ℓ) (x : A), c • x = c.val • x := fun _ _ => rfl
    have _ : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
    let instMod : Module (ZMod ℓ) A :=
      { one_smul := fun x => by rw [hsmul_def, ZMod.val_one ℓ, one_nsmul]
        mul_smul := fun r s x => by
          rw [hsmul_def, hsmul_def, hsmul_def, ZMod.val_mul, ← hrem, mul_smul]
        smul_zero := fun r => by rw [hsmul_def, nsmul_zero]
        smul_add := fun r x y => by rw [hsmul_def, hsmul_def, hsmul_def, nsmul_add]
        add_smul := fun r s x => by
          rw [hsmul_def, hsmul_def, hsmul_def, ZMod.val_add, ← hrem, add_nsmul]
        zero_smul := fun x => by rw [hsmul_def, ZMod.val_zero, zero_nsmul] }
    let _ : Module (ZMod ℓ) A := instMod
    by_cases hAllZero : ∀ x : A, x = 0
    · have _ : Subsingleton A := ⟨fun x y => (hAllZero x).trans (hAllZero y).symm⟩
      let _ : Unique A := ⟨⟨0⟩, fun x => hAllZero x⟩
      refine ⟨inferInstance, ?_⟩
      rw [Nat.card_unique]
      exact hPrime.pos
    · obtain ⟨a₁, ha₁_ne⟩ := not_forall.mp hAllZero
      let botSub : Submodule (ZMod ℓ) A := ⊥
      have ha₁_not_bot : a₁ ∉ botSub := by
        dsimp [botSub]
        rw [Submodule.mem_bot]
        exact ha₁_ne
      let S₁ : Submodule (ZMod ℓ) A := Submodule.span (ZMod ℓ) {a₁}
      have hSpanAll : ∀ x : A, x ∈ S₁ := by
        by_contra hNotSpan
        obtain ⟨a₂, ha₂_not⟩ := not_forall.mp hNotSpan
        have hex_pair : ∀ p : ZMod ℓ × ZMod ℓ,
            ∃ g : A →+ ZMod ℓ, g a₁ = p.1 ∧ g a₂ = p.2 := by
          intro ⟨c₁, c₂⟩
          obtain ⟨f₁, _, hf₁_a₁⟩ := LinearMap.exists_extend_of_notMem
            (0 : ↥botSub →ₗ[ZMod ℓ] ZMod ℓ) ha₁_not_bot c₁
          obtain ⟨f₂, hf₂_sub, hf₂_a₂⟩ := LinearMap.exists_extend_of_notMem
            (f₁.comp S₁.subtype) ha₂_not c₂
          have ha₁_mem : a₁ ∈ S₁ := Submodule.subset_span (Set.mem_singleton a₁)
          have hf₂_a₁ : f₂ a₁ = c₁ := by
            have hsub := LinearMap.congr_fun hf₂_sub ⟨a₁, ha₁_mem⟩
            simpa using hsub.trans hf₁_a₁
          exact ⟨f₂.toAddMonoidHom, hf₂_a₁, hf₂_a₂⟩
        let emb : ZMod ℓ × ZMod ℓ → (A →+ ZMod ℓ) := fun p => Classical.choose (hex_pair p)
        have hemb_inj : Function.Injective emb := by
          rintro ⟨c₁, c₂⟩ ⟨d₁, d₂⟩ h_eq
          obtain ⟨h1a, h1b⟩ := Classical.choose_spec (hex_pair (c₁, c₂))
          obtain ⟨h2a, h2b⟩ := Classical.choose_spec (hex_pair (d₁, d₂))
          have e1 : emb (c₁, c₂) a₁ = emb (d₁, d₂) a₁ := DFunLike.congr_fun h_eq a₁
          have e2 : emb (c₁, c₂) a₂ = emb (d₁, d₂) a₂ := DFunLike.congr_fun h_eq a₂
          exact Prod.ext (h1a.symm.trans (e1.trans h2a)) (h1b.symm.trans (e2.trans h2b))
        have hle := @Nat.card_le_card_of_injective _ _ hFinDual emb hemb_inj
        rw [Nat.card_prod, Nat.card_zmod] at hle
        have hlt : ℓ < ℓ * ℓ := by
          have h2 : 2 ≤ ℓ := hPrime.two_le
          nlinarith
        omega
      let surjMap : ZMod ℓ → A := fun c => c • a₁
      have hSurj : Function.Surjective surjMap := by
        intro x
        obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hSpanAll x)
        exact ⟨c, hc⟩
      have _ : Finite A := Finite.of_surjective surjMap hSurj
      refine ⟨inferInstance, ?_⟩
      calc Nat.card A ≤ Nat.card (ZMod ℓ) := Nat.card_le_card_of_surjective surjMap hSurj
        _ = ℓ := Nat.card_zmod ℓ

  
