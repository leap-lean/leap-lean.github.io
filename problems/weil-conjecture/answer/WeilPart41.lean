        · have hdvdA : (Polynomial.X : Polynomial k) ∣ A := by
            rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]
            exact hA0
          obtain ⟨A', rfl⟩ := hdvdA
          have hA'B : A' * B = Polynomial.X ^ N := by
            apply mul_left_cancel₀ (Polynomial.X_ne_zero (R := k))
            calc
              Polynomial.X * (A' * B) = (Polynomial.X * A') * B := (mul_assoc _ _ _).symm
              _ = Polynomial.X ^ (N + 1) := hAB
              _ = Polynomial.X * Polynomial.X ^ N := by rw [pow_succ']
          obtain ⟨μ, hμ, d, rfl⟩ := ih A' B hA'B
