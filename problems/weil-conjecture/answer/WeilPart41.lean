              j_0 ≫ π_P2 := by
            rw [← hφ_S0_comm]
        _ = q_φS0 ≫ q_h0 ≫ j_0 ≫ π_P2 := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    have hh_S0_line : h_S0 ≫ π_P1 ≫ P.ι_line.left = g_S0 ≫ e_B := by
      calc h_S0 ≫ π_P1 ≫ P.ι_line.left
          = q_φS0 ≫ (j_Sig0 ≫ π_P1) ≫ P.ι_line.left := by
            simp only [h_S0, CategoryTheory.Category.assoc]
        _ = q_φS0 ≫ f_Sigma_0 ≫ P.ι_line.left := by rw [hj_Sig0_fst]
        _ = q_φS0 ≫ q_h0 ≫ (j_0 ≫ π_P2) := by
            rw [hPb_Sig.w]
        _ = g_S0 ≫ e_B := hg_S0_eB.symm
    let c_k_S0 : k →+* S_0 :=
      (Ideal.Quotient.mk (Ideal.span {g₀})).comp (φ_loc.comp MvPolynomial.C)
    have hh_S0_hom :
        h_S0 ≫ P1_k.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_k_S0) := by
      calc h_S0 ≫ P1_k.hom
          = q_φS0 ≫ (j_Sig0 ≫ ι_line_k) ≫ (weilProjectiveSpaceOver k 2).hom := by
