      rw [hαr]
      dsimp only [q₀]
      rw [hquotEquiv_mk]
      exact congrArg (Ideal.Quotient.mk J_Q0) (RingHom.congr_fun hδ₀_C r)
    · intro j b
      let i_jb : Fin (2 * (m + 1)) := ⟨2 * j.1 + b.1, by omega⟩
      change q₀ (α₀ (Ideal.Quotient.mk _ (MvPolynomial.X (j, b)))) = _
      rw [hα₀_X j b]
      dsimp only [q₀]
      change Ideal.quotientEquiv I_ev0 J_Q0 δ₀ hIJ₀ (Ideal.Quotient.mk I_ev0 (MvPolynomial.X i_jb)) = _
      rw [hquotEquiv_mk]
      apply congrArg (Ideal.Quotient.mk J_Q0)
      rw [hδ₀_X i_jb]
      have hsucc : (0 : Fin (2 * (m + 1) + 1)).succAbove i_jb =
