            rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]
            exact hB0
          obtain ⟨B', rfl⟩ := hdvdB
          have hAB' : A * B' = Polynomial.X ^ N := by
            apply mul_left_cancel₀ (Polynomial.X_ne_zero (R := k))
            calc
              Polynomial.X * (A * B') = A * (Polynomial.X * B') := by ring
              _ = Polynomial.X ^ (N + 1) := hAB
