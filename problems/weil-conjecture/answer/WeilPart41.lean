          ext x
          rfl }
    let eModR : ∀ (M : ModuleCat.{u, u} R) (A : AddCommGrpCat.{u}),
        (FgtMod.obj M ⟶ A) ≃ (M ⟶ C_mod.obj A) := fun M A =>
      { toFun := fun g =>
          let g_add : M →+ ↥(C_mod.obj A) :=
            { toFun := fun x => ⟨g.hom x, by
                change m • (g.hom x) = 0
                rw [← map_nsmul, hm_mod M x, map_zero]⟩
              map_zero' := Subtype.ext (map_zero g.hom)
              map_add' := fun x y => Subtype.ext (map_add g.hom x y) }
          ModuleCat.ofHom
            { toAddHom := g_add.toAddHom
              map_smul' := fun r x => hR_smul_addHom g_add r x }
        invFun := fun f =>
          AddCommGrpCat.ofHom
            { toFun := fun x => (f.hom x).1
              map_zero' := congrArg Subtype.val (map_zero f.hom)
              map_add' := fun x y => congrArg Subtype.val (map_add f.hom x y) }
        left_inv := fun _ => by ext x; rfl
        right_inv := fun _ => by
          apply ModuleCat.hom_ext
          ext x
          rfl }
    let C_sh : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_S AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R)) :=
      { obj := fun G_sh => ⟨G_sh.obj ⋙ C_mod, fun E =>
          CategoryTheory.Presieve.isSheaf_iso J_S
            (CategoryTheory.NatIso.ofComponents
              (fun V => (eModR E (G_sh.obj.obj V)).toIso)
              (fun _ => by
                ext g
                apply ModuleCat.hom_ext
                apply LinearMap.ext
                intro y
                rfl))
            (G_sh.property (FgtMod.obj E))⟩
        map := fun v => ⟨CategoryTheory.Functor.whiskerRight v.hom C_mod⟩
        map_id := fun _ => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V : 2
          apply ModuleCat.hom_ext
          ext x
          rfl
        map_comp := fun _ _ => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V : 2
          apply ModuleCat.hom_ext
          ext x
          rfl }
    let eShR : ∀ (F_sh : CategoryTheory.Sheaf J_S (ModuleCat.{u, u} R))
        (G_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}),
        (U_of.obj F_sh ⟶ G_sh) ≃ (F_sh ⟶ C_sh.obj G_sh) := fun F_sh G_sh =>
      { toFun := fun φ =>
          ⟨{ app := fun V => eModR (F_sh.obj.obj V) (G_sh.obj.obj V) (φ.hom.app V)
             naturality := fun _ _ u => by
               apply ModuleCat.hom_ext
               ext x
               exact Subtype.ext (ConcreteCategory.congr_hom (φ.hom.naturality u) x) }⟩
        invFun := fun ψ =>
          ⟨{ app := fun V => (eModR (F_sh.obj.obj V) (G_sh.obj.obj V)).symm (ψ.hom.app V)
             naturality := fun _ _ u => by
               ext x
               exact congrArg Subtype.val (ConcreteCategory.congr_hom (ψ.hom.naturality u) x) }⟩
        left_inv := fun _ => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V x
          rfl
        right_inv := fun _ => by
          apply CategoryTheory.Sheaf.hom_ext
          ext V : 2
          apply ModuleCat.hom_ext
          ext x
          rfl }
    have hFreeYonedaComp : ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
        [CategoryTheory.Limits.HasCoproducts D]
        [CategoryTheory.HasWeakSheafify J_S D]
        {M : D} {F G : CategoryTheory.Sheaf J_S D}
        (α : CategoryTheory.Sheaf.freeYoneda J_S U_et M ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) := by
      intro D _ _ _ M F G α g
      let α' : (CategoryTheory.presheafToSheaf J_S D).obj
          (CategoryTheory.Presheaf.freeYoneda U_et M) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J_S D).homEquiv _ G)
              (α' ≫ g))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction J_S D).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf J_S D).map g) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
    let ιM : AM ⟶ FgtMod.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    let ιM_equiv : ∀ X : AddCommGrpCat.{u}, (FgtMod.obj R_mod ⟶ X) ≃ (AM ⟶ X) := fun X =>
      { toFun := fun g => ιM ≫ g
        invFun := fun h => (AddCommGrpCat.ofHom (AddMonoidHom.id R) : FgtMod.obj R_mod ⟶ AM) ≫ h
        left_inv := fun _ => by ext x; rfl
        right_inv := fun _ => by ext x; rfl }
    let η_mod : R_mod ⟶ L_mod.obj.obj (Opposite.op U_et) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_mod)
    let α_loc : L_tors ⟶ U_of.obj L_mod :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (ιM ≫ FgtMod.map η_mod)
    let eLoc : ∀ G_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u},
        (U_of.obj L_mod ⟶ G_sh) ≃ (L_tors ⟶ G_sh) := fun G_sh =>
      (eShR L_mod G_sh).trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
          ((eModR R_mod (G_sh.obj.obj (Opposite.op U_et))).symm.trans
            ((ιM_equiv (G_sh.obj.obj (Opposite.op U_et))).trans
              CategoryTheory.Sheaf.freeYonedaHomEquiv.symm)))
    have heLoc_eq : ∀ (G_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u})
        (φ : U_of.obj L_mod ⟶ G_sh),
        eLoc G_sh φ = α_loc ≫ φ := by
      intro G_sh φ
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeYonedaComp α_loc φ]
      have hα : CategoryTheory.Sheaf.freeYonedaHomEquiv α_loc = ιM ≫ FgtMod.map η_mod :=
        Equiv.apply_symm_apply _ _
      rw [hα]
      dsimp [eLoc]
      rw [Equiv.apply_symm_apply]
      have hFY : CategoryTheory.Sheaf.freeYonedaHomEquiv (eShR L_mod G_sh φ) =
          η_mod ≫ (eShR L_mod G_sh φ).hom.app (Opposite.op U_et) := by
        have hcomp := hFreeYonedaComp
          (CategoryTheory.CategoryStruct.id L_mod) (eShR L_mod G_sh φ)
        rwa [CategoryTheory.Category.id_comp] at hcomp
      rw [hFY]
      ext r
      rfl
    let β_loc : U_of.obj L_mod ⟶ L_tors :=
      (eLoc L_tors).symm (CategoryTheory.CategoryStruct.id L_tors)
    have h1 : α_loc ≫ β_loc = CategoryTheory.CategoryStruct.id L_tors := by
      rw [← heLoc_eq _ β_loc]
      exact Equiv.apply_symm_apply _ _
    have h2 : β_loc ≫ α_loc = CategoryTheory.CategoryStruct.id (U_of.obj L_mod) := by
      apply (eLoc (U_of.obj L_mod)).injective
      rw [heLoc_eq, heLoc_eq, ← CategoryTheory.Category.assoc, h1,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    let iso_loc : L_tors ≅ U_of.obj L_mod :=
      { hom := α_loc
        inv := β_loc
        hom_inv_id := h1
        inv_hom_id := h2 }
    let iso_sh : U_of.obj L_mod ≅ U_m.obj L_mod :=
      CategoryTheory.sheafificationIso (U_of.obj L_mod)
    let iso_tot : U_m.obj L_mod ≅ L_tors := iso_sh.symm.trans iso_loc.symm
    let Fℤ := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let fwd : ((U_m.obj L_mod).H q) →+ weilEtaleLocalTorsionH S m U_et q :=
      (CategoryTheory.Abelian.Ext.mk₀ iso_tot.hom).postcomp Fℤ (Nat.add_zero q)
    let bwd : weilEtaleLocalTorsionH S m U_et q →+ ((U_m.obj L_mod).H q) :=
      (CategoryTheory.Abelian.Ext.mk₀ iso_tot.inv).postcomp Fℤ (Nat.add_zero q)
    let e_H : ((U_m.obj L_mod).H q) ≃+ weilEtaleLocalTorsionH S m U_et q :=
      { toFun := fwd
        invFun := bwd
        left_inv := fun z => by
          change (z.comp (CategoryTheory.Abelian.Ext.mk₀ iso_tot.hom) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ iso_tot.inv) (Nat.add_zero q) = z
          rw [CategoryTheory.Abelian.Ext.comp_assoc z
            (CategoryTheory.Abelian.Ext.mk₀ iso_tot.hom)
            (CategoryTheory.Abelian.Ext.mk₀ iso_tot.inv)
            (Nat.add_zero q) (Nat.add_zero 0) (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, iso_tot.hom_inv_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        right_inv := fun z => by
          change (z.comp (CategoryTheory.Abelian.Ext.mk₀ iso_tot.inv) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ iso_tot.hom) (Nat.add_zero q) = z
          rw [CategoryTheory.Abelian.Ext.comp_assoc z
            (CategoryTheory.Abelian.Ext.mk₀ iso_tot.inv)
            (CategoryTheory.Abelian.Ext.mk₀ iso_tot.hom)
            (Nat.add_zero q) (Nat.add_zero 0) (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, iso_tot.inv_hom_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        map_add' := fwd.map_add }
    exact ⟨e_god.trans e_H⟩

theorem weil_qcvs_ve_closed_open_localTorsion_exact_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom] [AlgebraicGeometry.IsProper Z.hom]
    (i : Z ⟶ X) (hi_cl : AlgebraicGeometry.IsClosedImmersion i.left)
    (U : X.left.Opens) (hU : (U : Set X.left) = (Set.range i.left.base)ᶜ) :
    let U_et : X.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
      (inferInstance : AlgebraicGeometry.Etale U.ι)
    (∀ (s p : ℕ)
      (p_i : weilEtaleTorsionH X.left (ℓ ^ (s + 1)) p →+
        weilEtaleTorsionH Z.left (ℓ ^ (s + 1)) p),
      WeilIsTorsionEtalePullback i.left (ℓ ^ (s + 1)) p p_i →
      (Subsingleton (weilEtaleLocalTorsionH X.left (ℓ ^ (s + 1)) U_et p) →
        Function.Injective p_i) ∧
      (Subsingleton (weilEtaleLocalTorsionH X.left (ℓ ^ (s + 1)) U_et p) →
        Subsingleton (weilEtaleLocalTorsionH X.left (ℓ ^ (s + 1)) U_et (p + 1)) →
        Function.Bijective p_i)) ∧
    (∀ (p : ℕ),
      Subsingleton (weilEtaleTorsionH X.left ℓ p) →
      Finite (weilEtaleTorsionH X.left ℓ (p + 1)) →
      Finite (weilEtaleTorsionH Z.left ℓ (p + 1)) →
      Nat.card (weilEtaleTorsionH X.left ℓ (p + 1)) =
        ℓ * Nat.card (weilEtaleTorsionH Z.left ℓ (p + 1)) →
      (∃ p_top : weilEtaleTorsionH X.left ℓ (p + 1) →+
          weilEtaleTorsionH Z.left ℓ (p + 1),
        WeilIsTorsionEtalePullback i.left ℓ (p + 1) p_top ∧
        Function.Surjective p_top) →
      Finite (weilEtaleLocalTorsionH X.left ℓ U_et (p + 1)) →
      Nat.card (weilEtaleLocalTorsionH X.left ℓ U_et (p + 1)) ≤ ℓ →
      Subsingleton (weilEtaleTorsionH Z.left ℓ p)) :=
by
  intro U_et
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf X.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ

  
  
  
  have h_s4 : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      (m q : ℕ) (p_h : weilEtaleTorsionH S₂ m q →+ weilEtaleTorsionH S₁ m q)
      [_hc : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
      [_hr : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint],
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let Fℤ₁ := (CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₂ := (CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Λ₁ := weilEtaleTorsionSheaf S₁ m
      let Λ₂ := weilEtaleTorsionSheaf S₂ m
      ∀ [_hAdd : pb_h.Additive]
        [_hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_h]
        [_hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_h]
        {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (ιℤ : Quiver.Hom Fℤ₁ (pb_h.obj Fℤ₂)),
        (∀ v : weilEtaleTorsionH S₂ m q,
          p_h v =
            (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleConstPullbackHom h hT₁ hT₂ AM)).postcomp
              Fℤ₁ (Nat.add_zero q)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_h _ _ _ _ _ Fℤ₂ Λ₂ q) v)
                (Nat.zero_add q))) →
        let u_h : Quiver.Hom Λ₂ (pf_h.obj Λ₁) :=
          (adj_h.homEquiv Λ₂ Λ₁) (weilEtaleConstPullbackHom h hT₁ hT₂ AM)
        let edge_h : ∀ d : ℕ, (pf_h.obj Λ₁).H d → weilEtaleTorsionH S₁ m d :=
          fun d z =>
            (CategoryTheory.Abelian.Ext.mk₀
              ((adj_h.homEquiv (pf_h.obj Λ₁) Λ₁).symm
                (CategoryTheory.CategoryStruct.id (pf_h.obj Λ₁)))).postcomp
              Fℤ₁ (Nat.add_zero d)
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_h _ _ _ _ _
                  Fℤ₂ (pf_h.obj Λ₁) d) z)
                (Nat.zero_add d))
        (∀ d : ℕ, edge_h d 0 = 0) ∧
        (∀ v : weilEtaleTorsionH S₂ m q,
          p_h v =
            edge_h q (((CategoryTheory.Abelian.Ext.mk₀ u_h).postcomp Fℤ₂ (Nat.add_zero q)) v)) := by
    intro S₁ S₂ h m q p_h _hc _hr B_h pf_h pb_h adj_h AM Fℤ₁ Fℤ₂ Λ₁ Λ₂
      _hAdd _hLim _hColim T₁ hT₁ T₂ hT₂ ιℤ hp_eq u_h edge_h
    refine ⟨?_, ?_⟩
    · intro d
      let c_h : pb_h.obj (pf_h.obj Λ₁) ⟶ Λ₁ :=
        (adj_h.homEquiv (pf_h.obj Λ₁) Λ₁).symm (𝟙 (pf_h.obj Λ₁))
      let post_c := (CategoryTheory.Abelian.Ext.mk₀ c_h).postcomp Fℤ₁ (Nat.add_zero d)
      let map_pb := @CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_h _ _ _ _ _
        Fℤ₂ (pf_h.obj Λ₁) d
      change post_c ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp (map_pb 0) (Nat.zero_add d)) = 0
      rw [map_zero map_pb,
        CategoryTheory.Abelian.Ext.comp_zero (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
          (pb_h.obj (pf_h.obj Λ₁)) d d (Nat.zero_add d),
        map_zero post_c]
    · intro v
      let πM : pb_h.obj Λ₂ ⟶ Λ₁ := weilEtaleConstPullbackHom h hT₁ hT₂ AM
      let c_h : pb_h.obj (pf_h.obj Λ₁) ⟶ Λ₁ :=
        (adj_h.homEquiv (pf_h.obj Λ₁) Λ₁).symm (𝟙 (pf_h.obj Λ₁))
      have hc_eq : c_h = adj_h.counit.app Λ₁ :=
        (adj_h.homEquiv_counit (pf_h.obj Λ₁) Λ₁ (𝟙 (pf_h.obj Λ₁))).trans
          ((congrArg (· ≫ adj_h.counit.app Λ₁) (pb_h.map_id (pf_h.obj Λ₁))).trans
            (CategoryTheory.Category.id_comp (adj_h.counit.app Λ₁)))
      have hπM_fac : πM = pb_h.map u_h ≫ c_h :=
        ((adj_h.homEquiv Λ₂ Λ₁).symm_apply_apply πM).symm.trans
          ((adj_h.homEquiv_counit Λ₂ Λ₁ u_h).trans
            (congrArg (pb_h.map u_h ≫ ·) hc_eq.symm))
      rw [hp_eq v]
      change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_h.mapExtAddHom Fℤ₂ Λ₂ q) v) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_h.mapExtAddHom Fℤ₂ (pf_h.obj Λ₁) q)
            (v.comp (CategoryTheory.Abelian.Ext.mk₀ u_h) (Nat.add_zero q)))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ c_h) (Nat.add_zero q)
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        hπM_fac, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
      exact congrArg
        (fun t => t.comp (CategoryTheory.Abelian.Ext.mk₀ c_h) (Nat.add_zero q))
        (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_h v)
          (CategoryTheory.Abelian.Ext.mk₀ (pb_h.map u_h))
          (Nat.zero_add q))

  
  
  
  have h_s5 : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      (F : 𝒜) {S : CategoryTheory.ShortComplex 𝒜} (hS : S.ShortExact) (p : ℕ),
      ((Subsingleton (CategoryTheory.Abelian.Ext.{u} F S.X₁ p) →
          Function.Injective ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp F (Nat.add_zero p))) ∧
        (Subsingleton (CategoryTheory.Abelian.Ext.{u} F S.X₁ p) →
          Subsingleton (CategoryTheory.Abelian.Ext.{u} F S.X₁ (p + 1)) →
          Function.Bijective ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp F (Nat.add_zero p)))) ∧
      (Subsingleton (CategoryTheory.Abelian.Ext.{u} F S.X₂ p) →
        ∃ δ : CategoryTheory.Abelian.Ext.{u} F S.X₃ p →+
            CategoryTheory.Abelian.Ext.{u} F S.X₁ (p + 1),
          Function.Injective δ ∧
          (∀ y : CategoryTheory.Abelian.Ext.{u} F S.X₃ p,
            δ y ∈ ((CategoryTheory.Abelian.Ext.mk₀ S.f).postcomp F (Nat.add_zero (p + 1))).ker) ∧
          ((CategoryTheory.Abelian.Ext.mk₀ S.f).postcomp F (Nat.add_zero (p + 1))).range =
            ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp F (Nat.add_zero (p + 1))).ker) := by
    intro 𝒜 _ _ _ F S hS p
    have hInj : Subsingleton (CategoryTheory.Abelian.Ext.{u} F S.X₁ p) →
        Function.Injective ((CategoryTheory.Abelian.Ext.mk₀ S.g).postcomp F (Nat.add_zero p)) := by
      intro hSub_p
      rw [injective_iff_map_eq_zero]
      intro v hv
      change v.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero p) = 0 at hv
      obtain ⟨w, hw⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ F hS v hv
      have hw0 : w = 0 := @Subsingleton.elim _ hSub_p w 0
      rw [← hw, hw0]
      exact CategoryTheory.Abelian.Ext.zero_comp F p _ p (Nat.add_zero p)
    refine ⟨⟨hInj, ?_⟩, ?_⟩
    · intro hSub_p hSub_p1
      refine ⟨hInj hSub_p, ?_⟩
      intro y
      have hy : y.comp hS.extClass (rfl : p + 1 = p + 1) = 0 :=
        @Subsingleton.elim _ hSub_p1 _ 0
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ F hS y (rfl : p + 1 = p + 1) hy
    · intro hSub_X₂
      let δ : CategoryTheory.Abelian.Ext.{u} F S.X₃ p →+
          CategoryTheory.Abelian.Ext.{u} F S.X₁ (p + 1) :=
        hS.extClass.postcomp F (rfl : p + 1 = p + 1)
      refine ⟨δ, ?_, ?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro y hy
        change y.comp hS.extClass (rfl : p + 1 = p + 1) = 0 at hy
        obtain ⟨v, hv⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ F hS y (rfl : p + 1 = p + 1) hy
        have hv0 : v = 0 := @Subsingleton.elim _ hSub_X₂ v 0
        rw [← hv, hv0]
        exact CategoryTheory.Abelian.Ext.zero_comp F p _ p (Nat.add_zero p)
      · intro y
        rw [AddMonoidHom.mem_ker]
        change (y.comp hS.extClass (rfl : p + 1 = p + 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (p + 1)) = 0
