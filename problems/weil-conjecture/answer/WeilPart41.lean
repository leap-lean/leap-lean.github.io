    obtain ⟨f_Sigma_0, hPb_Sig⟩ := hPb_Sigma_0
    let q_h0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k ⧸ Ideal.span {h₀})) ⟶
