      dsimp only [s_tilde, w₀]
      rw [CategoryTheory.Category.comp_id, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hψ_comp]
    obtain ⟨g_tilde, hg_w₀, hg_cl⟩ := hLiftTrait w₀ (𝟙 _) s_tilde hs_comm
    let σ : E →+* R_bar := (AlgebraicGeometry.Spec.preimage g_tilde).hom
    have hSpec_σ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) = g_tilde :=
      AlgebraicGeometry.Spec.map_preimage g_tilde
    have hσ_alg : σ.comp (algebraMap R_bar E) = RingHom.id R_bar := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ.comp (algebraMap R_bar E))) =
          AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of R_bar)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_σ, hg_w₀,
          AlgebraicGeometry.Spec.map_id]
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective h1)
    have hπ_σ : π_cl.comp σ = ψ_cl := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp σ)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_cl) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_σ, hg_cl]
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective h1)
    let a : R_bar := σ P_et.X
    refine ⟨a, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def]
      have hX_root : Polynomial.eval₂ (algebraMap R_bar E) P_et.X f = 0 := P_et.hasMap_X.1
      have hev := congrArg σ hX_root
      rw [Polynomial.hom_eval₂, hσ_alg, Polynomial.eval₂_id, map_zero] at hev
      exact hev
    · rw [← hπ_ker, RingHom.mem_ker, map_sub, sub_eq_zero]
