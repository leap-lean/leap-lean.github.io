        (ι_k : Q_k.left ⟶ (weilProjectiveSpaceOver k (M + 1)).left)
        (Ψ_R : (weilProjectiveSpaceOver R M).left ⟶ (weilProjectiveSpaceOver k (M + 1)).left),
        IsHomogeneousHypersurfacePullbackOver k (M + 1) d₀
          (𝟙 (weilProjectiveSpaceOver k (M + 1))) F_k ι_k →
        (TopologicalSpace.Opens.map Ψ_R.base).obj (weilProjBasicOpen k (M + 1) 1) =
