      rwa [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.diagonal_fst] at h1
    have hf₂_eq : f₂.base q₀ = y := by
      have h1 : (L_pb ≫ CategoryTheory.Limits.pullback.snd p_X p_X).base q₀ =
          (Δ ≫ CategoryTheory.Limits.pullback.snd p_X p_X).base y :=
        congrArg (CategoryTheory.Limits.pullback.snd p_X p_X).base hy.symm
      dsimp only [L_pb, Δ] at h1
      rwa [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.diagonal_snd] at h1
    have h_same : f₁.base q₀ = j_inf.base q₀ := hf₁_eq.trans hf₂_eq.symm
    have h_in_jaff : f₁.base q₀ ∈ Set.range j_aff_k.base :=
      ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ)).base q₀, rfl⟩
    rw [h_same, hRange_jaff] at h_in_jaff
    exact h_in_jaff rfl

  obtain ⟨hj_inf_pre, hNoExtend⟩ := hPillar2

  
  
  
  have hPillar3 : ∃ (Q : Polynomial k) (_ : Q ≠ 0)
      (σ₀ : Localization.Away Q ≃+* Localization.Away (Polynomial.X : Polynomial k)),
      (j_aff_k.base ⁻¹' Set.range j_inf.base =
        { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) | Q ∉ p.asIdeal }) ∧
      (∀ c : k, σ₀ (algebraMap (Polynomial k) (Localization.Away Q) (Polynomial.C c)) =
