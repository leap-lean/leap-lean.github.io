    rw [hsymm_C, hquotEquiv_mk]
    apply congrArg (Ideal.Quotient.mk J_a)
    change Φ_a.symm (Polynomial.C (MvPolynomial.C r)) = MvPolynomial.C r
    have halg_r : Polynomial.C (MvPolynomial.C r : S₀) = algebraMap R (Polynomial S₀) r := by
      rw [IsScalarTower.algebraMap_apply R S₀ (Polynomial S₀),
        MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
    rw [halg_r, Φ_a.symm.commutes r, MvPolynomial.algebraMap_eq]

  
  refine ⟨?_, ?_⟩
  · obtain ⟨δ₀, hδ₀_C, hδ₀_X, hδ₀_mk⟩ := hDehom (2 * (m + 1)) 0
