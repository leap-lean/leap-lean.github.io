        have hG_ker : G ∈ RingHom.ker θ₀.toRingHom := by
          change θ₀ G = 0
          have hMul0 : θ₀ G * P0_rf ^ (2 * N) = 0 := by
            dsimp [G]
            rw [map_sum, Finset.sum_mul]
            have hRewrite :
                ∑ x : IdxBox, θ₀ (MvPolynomial.monomial (μ_box x) (c x)) * P0_rf ^ (2 * N) =
                  algebraMap (Polynomial k) (RatFunc k)
                    (∑ x : IdxBox, Polynomial.C (c x) * R_box x) := by
              rw [map_sum]
              apply Finset.sum_congr rfl
              intro α _
              have hα1 : α.1.val ≤ N := Nat.le_of_lt_succ α.1.isLt
              have hα2 : α.2.val ≤ N := Nat.le_of_lt_succ α.2.isLt
              have hle : (μ_box α) 0 + (μ_box α) 1 ≤ 2 * N := by
                rw [hμ_box_0, hμ_box_1]
