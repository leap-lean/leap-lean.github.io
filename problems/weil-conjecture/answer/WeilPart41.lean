        have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen ℬ_R hY0 zero_lt_one
          hYa zero_lt_one
        change ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_R0})))) ⁻¹ᵁ
          ((AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X (0 : Fin (M + 1))) hY0 zero_lt_one) ⁻¹ᵁ
            AlgebraicGeometry.Proj.basicOpen ℬ_R (MvPolynomial.X a.succ))) = _
        rw [hpre]
        ext p
        exact Iff.rfl
    · 
      intro a
      let P_R : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj ℬ_R
      let f_Ψ : P_R ⟶ (weilProjectiveSpaceOver k (M + 1)).left := Ψ_R
      let D_Ra : P_R.Opens := AlgebraicGeometry.Proj.basicOpen ℬ_R (MvPolynomial.X a.succ)
      let hYa := (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X R a.succ)
      let hXa2 := (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X k a.succ.succ)
      let s_ka2 := HomogeneousLocalization.Away.mk 𝒜_k hXa2 d₀ F_k hF_k
      let s_Ra := HomogeneousLocalization.Away.mk ℬ_R hYa d₀ (ψ_R F_k) hF_R
      obtain ⟨φ_a, hSq_a, hMk_a⟩ := hφa a
      obtain ⟨_, j_ka2, hPb_ka2⟩ := hChart_k a.succ.succ
      let e_suba := AlgebraicGeometry.Proj.basicOpenIsoSpec ℬ_R (MvPolynomial.X a.succ)
        hYa zero_lt_one
      have hawaya : e_suba.inv ≫ D_Ra.ι =
          AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X a.succ) hYa zero_lt_one :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι ℬ_R (MvPolynomial.X a.succ) hYa zero_lt_one
      obtain ⟨e_a_raw, he_a_raw⟩ := hS2_chart_pb ι_k f_Ψ D_Ra
        (HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X a.succ.succ))
        (HomogeneousLocalization.Away ℬ_R (MvPolynomial.X a.succ))
        e_suba
        (AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X a.succ.succ) hXa2 zero_lt_one)
        φ_a s_ka2 s_Ra j_ka2
        (hMk_a d₀ F_k hF_k hF_R)
        (by rw [hawaya]; exact hSq_a)
        hPb_ka2
      rw [hawaya] at he_a_raw
      let e_a : AlgebraicGeometry.Spec (CommRingCat.of (Q_ring_a a)) ≅ (V'_R a).toScheme := e_a_raw
      have he_a_sub : e_a.hom ≫ (V'_R a).ι ≫ p_sub =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_Ra}))) ≫
            AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X a.succ) hYa zero_lt_one :=
        he_a_raw
      refine ⟨e_a, ?_⟩
      have hpost : (e_a.hom ≫ (V'_R a).ι ≫ p_sub) ≫ (weilProjectiveSpaceOver R M).hom =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_Ra}))) ≫
            AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X a.succ) hYa zero_lt_one) ≫
          (weilProjectiveSpaceOver R M).hom :=
        congrArg (· ≫ (weilProjectiveSpaceOver R M).hom) he_a_sub
      rw [Category.assoc e_a.hom, Category.assoc (V'_R a).ι] at hpost
      change e_a.hom ≫ (V'_R a).ι ≫ p'_R =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s_Ra}))) ≫
          AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X a.succ) hYa zero_lt_one) ≫
        (AlgebraicGeometry.Proj.toSpecZero ℬ_R ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R ↥(ℬ_R 0)))) at hpost
      rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι ℬ_R _ _ _),
        AlgebraicGeometry.Proj.awayι_toSpecZero ℬ_R (MvPolynomial.X a.succ) hYa zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp] at hpost
      exact hpost

theorem weil_odp_qdeg_dehom_chart_ring_equivalences (R : Type u) [CommRing R] (m : ℕ) (t_R : R) :
    let ℬ_R := MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1)) R
    letI : GradedAlgebra ℬ_R := MvPolynomial.gradedAlgebra
    ∀ (G_R : MvPolynomial (Fin (2 * (m + 1) + 1)) R),
      G_R = -MvPolynomial.C t_R * MvPolynomial.X 0 * MvPolynomial.X 0 +
        ∑ j : Fin (m + 1),
          (MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1)) R) *
            MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ →
      ∀ (hG : G_R ∈ ℬ_R (2 • 1)),
        let Q_ring_0 := HomogeneousLocalization.Away ℬ_R (MvPolynomial.X 0) ⧸
          Ideal.span {HomogeneousLocalization.Away.mk ℬ_R
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 0))
            2 G_R hG}
        let M_R := MvPolynomial (Fin (m + 1) × Fin 2) R ⧸
          Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C t_R}
        (∃ θ₀ : M_R ≃+* Q_ring_0,
          θ₀.toRingHom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            (Ideal.Quotient.mk _).comp
              ((HomogeneousLocalization.fromZeroRingHom ℬ_R
                (Submonoid.powers (MvPolynomial.X 0))).comp
                (algebraMap R ↥(ℬ_R 0))) ∧
          ∀ (j : Fin (m + 1)) (b : Fin 2),
            θ₀ (Ideal.Quotient.mk _ (MvPolynomial.X (j, b))) =
              Ideal.Quotient.mk _
                (HomogeneousLocalization.Away.isLocalizationElem
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X R 0))
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X R ⟨2 * j.1 + b.1 + 1, by omega⟩)))) ∧
        (∀ a : Fin (2 * (m + 1)),
          let Q_ring_a := HomogeneousLocalization.Away ℬ_R (MvPolynomial.X a.succ) ⧸
            Ideal.span {HomogeneousLocalization.Away.mk ℬ_R
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                (MvPolynomial.isHomogeneous_X R a.succ)) 2 G_R hG}
          ∃ θ_a : MvPolynomial (Fin (2 * m + 1)) R ≃+* Q_ring_a,
            θ_a.toRingHom.comp MvPolynomial.C =
              (Ideal.Quotient.mk _).comp
                ((HomogeneousLocalization.fromZeroRingHom ℬ_R
                  (Submonoid.powers (MvPolynomial.X a.succ))).comp
                  (algebraMap R ↥(ℬ_R 0)))) :=
by
  intro ℬ_R G_R hG_eq hG Q_ring_0 M_R
  let _ : GradedAlgebra ℬ_R := MvPolynomial.gradedAlgebra
  
  have hDehom : ∀ (K_idx : ℕ) (ν : Fin (K_idx + 1)),
      let ℬ := MvPolynomial.homogeneousSubmodule (Fin (K_idx + 1)) R
      let _ : GradedAlgebra ℬ := MvPolynomial.gradedAlgebra
      let ev_ν : MvPolynomial (Fin (K_idx + 1)) R →+* MvPolynomial (Fin K_idx) R :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin K_idx) R) ν 1 MvPolynomial.X)
      ∃ δ_ν : MvPolynomial (Fin K_idx) R ≃+* HomogeneousLocalization.Away ℬ (MvPolynomial.X ν),
        δ_ν.toRingHom.comp MvPolynomial.C =
          (HomogeneousLocalization.fromZeroRingHom ℬ
            (Submonoid.powers (MvPolynomial.X ν))).comp
            (algebraMap R ↥(ℬ 0)) ∧
        (∀ i : Fin K_idx,
          δ_ν (MvPolynomial.X i) =
            HomogeneousLocalization.Away.isLocalizationElem
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R ν))
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                (MvPolynomial.isHomogeneous_X R (ν.succAbove i)))) ∧
        (∀ (n : ℕ) (p : MvPolynomial (Fin (K_idx + 1)) R) (hp : p ∈ ℬ (n • 1)),
          δ_ν (ev_ν p) =
            HomogeneousLocalization.Away.mk ℬ
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R ν))
              n p hp) := by
    intro K_idx ν ℬ _ ev_ν
    let A := MvPolynomial (Fin (K_idx + 1)) R
    let P_K := MvPolynomial (Fin K_idx) R
    let S_ν := Submonoid.powers (MvPolynomial.X ν : A)
    let L_ν := Localization S_ν
    have hX : ∀ μ : Fin (K_idx + 1), (MvPolynomial.X μ : A) ∈ ℬ 1 :=
      fun μ => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R μ)
    have hX_smul : ∀ μ : Fin (K_idx + 1), (MvPolynomial.X μ : A) ∈ ℬ ((1 : ℕ) • 1) :=
      fun μ => (one_smul ℕ (1 : ℕ)).symm ▸ hX μ
    have hev_C : ∀ r : R, ev_ν (MvPolynomial.C r) = MvPolynomial.C r :=
      fun r => MvPolynomial.eval₂Hom_C _ _ r
    have hev_Xν : ev_ν (MvPolynomial.X ν) = 1 := by
      change MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => P_K) ν 1 MvPolynomial.X) (MvPolynomial.X ν) = 1
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
    have hev_succ : ∀ i : Fin K_idx, ev_ν (MvPolynomial.X (ν.succAbove i)) = MvPolynomial.X i := by
      intro i
      change MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => P_K) ν 1 MvPolynomial.X)
        (MvPolynomial.X (ν.succAbove i)) = MvPolynomial.X i
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
    have hu_ev : IsUnit (ev_ν (MvPolynomial.X ν)) := hev_Xν.symm ▸ isUnit_one
    let lift_ν : L_ν →+* P_K := IsLocalization.Away.lift (MvPolynomial.X ν : A) hu_ev
    let valHom : HomogeneousLocalization.Away ℬ (MvPolynomial.X ν) →+* L_ν :=
      algebraMap (HomogeneousLocalization.Away ℬ (MvPolynomial.X ν)) L_ν
    let φ_ν : HomogeneousLocalization.Away ℬ (MvPolynomial.X ν) →+* P_K :=
      lift_ν.comp valHom
    let c_ν : R →+* HomogeneousLocalization.Away ℬ (MvPolynomial.X ν) :=
      (HomogeneousLocalization.fromZeroRingHom ℬ S_ν).comp (algebraMap R ↥(ℬ 0))
    let t_ν : Fin K_idx → HomogeneousLocalization.Away ℬ (MvPolynomial.X ν) :=
      fun i => HomogeneousLocalization.Away.mk ℬ (hX ν) 1
        (MvPolynomial.X (ν.succAbove i)) (hX_smul (ν.succAbove i))
    let ψ_ν : P_K →+* HomogeneousLocalization.Away ℬ (MvPolynomial.X ν) :=
      MvPolynomial.eval₂Hom c_ν t_ν
    have halg0_coe : ∀ r : R, (algebraMap R ↥(ℬ 0) r).1 = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul_of_tower,
        SetLike.GradeZero.coe_one, Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hc_val : ∀ r : R, valHom (c_ν r) = algebraMap A L_ν (MvPolynomial.C r) := by
      intro r
      change Localization.mk ((algebraMap R ↥(ℬ 0) r).1) 1 = algebraMap A L_ν (MvPolynomial.C r)
      rw [halg0_coe r, Localization.mk_eq_mk']
      have hspec := IsLocalization.mk'_spec' L_ν (MvPolynomial.C r) (1 : S_ν)
      simpa only [Submonoid.coe_one, map_one, one_mul] using hspec
    let u_ν : L_ν := algebraMap A L_ν (MvPolynomial.X ν)
    have hmk_mul : ∀ (n : ℕ) (a : A) (ha : a ∈ ℬ (n • 1)),
        u_ν ^ n * valHom (HomogeneousLocalization.Away.mk ℬ (hX ν) n a ha) =
          algebraMap A L_ν a := by
      intro n a ha
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk']
      have hu_pow : u_ν ^ n = algebraMap A L_ν ((MvPolynomial.X ν : A) ^ n) :=
        (map_pow (algebraMap A L_ν) (MvPolynomial.X ν) n).symm
      rw [hu_pow]
      exact IsLocalization.mk'_spec' L_ν a (⟨(MvPolynomial.X ν : A) ^ n, ⟨n, rfl⟩⟩ : S_ν)
    have ht_mul : ∀ i : Fin K_idx,
        u_ν * valHom (t_ν i) = algebraMap A L_ν (MvPolynomial.X (ν.succAbove i)) := by
      intro i
      simpa [t_ν, pow_one] using hmk_mul 1 (MvPolynomial.X (ν.succAbove i)) (hX_smul (ν.succAbove i))
    have hφ_mk : ∀ (n : ℕ) (a : A) (ha : a ∈ ℬ (n • 1)),
        φ_ν (HomogeneousLocalization.Away.mk ℬ (hX ν) n a ha) = ev_ν a := by
      intro n a ha
      have h1 := congrArg lift_ν (hmk_mul n a ha)
      rw [map_mul, map_pow] at h1
      have hlift_u : lift_ν u_ν = 1 := by
        dsimp [u_ν, lift_ν]
        rw [IsLocalization.Away.lift_eq, hev_Xν]
      have hlift_a : lift_ν (algebraMap A L_ν a) = ev_ν a := by
        dsimp [lift_ν]
        exact IsLocalization.Away.lift_eq (MvPolynomial.X ν : A) hu_ev a
      rw [hlift_u, one_pow, one_mul, hlift_a] at h1
      exact h1
    have hφψ : ∀ p : P_K, φ_ν (ψ_ν p) = p := by
      suffices hcomp : φ_ν.comp ψ_ν = RingHom.id P_K from fun p => RingHom.congr_fun hcomp p
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro r
        change lift_ν (valHom (ψ_ν (MvPolynomial.C r))) = MvPolynomial.C r
        have hψC : ψ_ν (MvPolynomial.C r) = c_ν r := MvPolynomial.eval₂Hom_C c_ν t_ν r
        rw [hψC, hc_val r]
        dsimp [lift_ν]
        rw [IsLocalization.Away.lift_eq, hev_C]
      · intro i
        change φ_ν (ψ_ν (MvPolynomial.X i)) = MvPolynomial.X i
        have hψX : ψ_ν (MvPolynomial.X i) = t_ν i := MvPolynomial.eval₂Hom_X' c_ν t_ν i
        rw [hψX]
        exact (hφ_mk 1 (MvPolynomial.X (ν.succAbove i)) (hX_smul (ν.succAbove i))).trans (hev_succ i)
    have hψ_ev : ∀ (n : ℕ) (a : A) (ha : a ∈ ℬ (n • 1)),
        ψ_ν (ev_ν a) = HomogeneousLocalization.Away.mk ℬ (hX ν) n a ha := by
      intro n a ha
      rw [HomogeneousLocalization.ext_iff_val]
      change valHom (ψ_ν (ev_ν a)) = valHom (HomogeneousLocalization.Away.mk ℬ (hX ν) n a ha)
      have hu_n : IsUnit (u_ν ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit (S := L_ν) (MvPolynomial.X ν : A)).pow n
      apply hu_n.mul_left_cancel
      rw [hmk_mul n a ha]
      conv_lhs => rw [MvPolynomial.as_sum a]
      conv_rhs => rw [MvPolynomial.as_sum a]
      rw [map_sum ev_ν, map_sum ψ_ν, map_sum valHom, Finset.mul_sum, map_sum (algebraMap A L_ν)]
      apply Finset.sum_congr rfl
      intro v hv
      have ha_hom : MvPolynomial.IsHomogeneous a n := by
        have hnsmul : n • (1 : ℕ) = n := (smul_eq_mul n 1).trans (mul_one n)
        exact (MvPolynomial.mem_homogeneousSubmodule n a).mp (hnsmul ▸ ha)
      have hv_ne : a.coeff v ≠ 0 := MvPolynomial.mem_support_iff.mp hv
      have hdeg_tot : ∑ μ : Fin (K_idx + 1), v μ = n := by
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using ha_hom hv_ne
      have hdeg_split : v ν + ∑ i : Fin K_idx, v (ν.succAbove i) = n := by
        rw [← Fin.sum_univ_succAbove v ν]
        exact hdeg_tot
      have hmon : MvPolynomial.monomial v (a.coeff v) =
          MvPolynomial.C (a.coeff v) *
            ((MvPolynomial.X ν : A) ^ (v ν) *
              ∏ i : Fin K_idx, (MvPolynomial.X (ν.succAbove i) : A) ^ (v (ν.succAbove i))) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_succAbove _ ν]
      rw [hmon]
      simp only [map_mul, map_pow, map_prod, hev_C, hev_Xν, hev_succ, one_pow, one_mul]
      have hψC : ψ_ν (MvPolynomial.C (a.coeff v)) = c_ν (a.coeff v) :=
        MvPolynomial.eval₂Hom_C c_ν t_ν (a.coeff v)
      have hψX : ∀ i : Fin K_idx, ψ_ν (MvPolynomial.X i) = t_ν i :=
        fun i => MvPolynomial.eval₂Hom_X' c_ν t_ν i
      simp only [hψC, hψX, hc_val]
      have hun_eq : u_ν ^ n = u_ν ^ (v ν) * ∏ i : Fin K_idx, u_ν ^ (v (ν.succAbove i)) := by
        rw [← hdeg_split, pow_add, ← Finset.prod_pow_eq_pow_sum]
      rw [hun_eq]
      have hprod_eq :
          (∏ i : Fin K_idx, u_ν ^ (v (ν.succAbove i))) *
            (∏ i : Fin K_idx, (valHom (t_ν i)) ^ (v (ν.succAbove i))) =
          ∏ i : Fin K_idx,
            (algebraMap A L_ν (MvPolynomial.X (ν.succAbove i))) ^ (v (ν.succAbove i)) := by
        rw [← Finset.prod_mul_distrib]
        apply Finset.prod_congr rfl
        intro i _
        rw [← mul_pow, ht_mul i]
      calc
        (u_ν ^ v ν * ∏ i : Fin K_idx, u_ν ^ v (ν.succAbove i)) *
            ((algebraMap A L_ν) (MvPolynomial.C (a.coeff v)) *
              ∏ i : Fin K_idx, valHom (t_ν i) ^ v (ν.succAbove i))
          = (algebraMap A L_ν) (MvPolynomial.C (a.coeff v)) *
              (u_ν ^ v ν *
                ((∏ i : Fin K_idx, u_ν ^ v (ν.succAbove i)) *
                  ∏ i : Fin K_idx, valHom (t_ν i) ^ v (ν.succAbove i))) := by ring
        _ = (algebraMap A L_ν) (MvPolynomial.C (a.coeff v)) *
              (u_ν ^ v ν *
                ∏ i : Fin K_idx,
                  (algebraMap A L_ν (MvPolynomial.X (ν.succAbove i))) ^ v (ν.succAbove i)) := by
              rw [hprod_eq]
    have hψφ : ∀ z : HomogeneousLocalization.Away ℬ (MvPolynomial.X ν), ψ_ν (φ_ν z) = z := by
      intro z
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (hX ν) z
      rw [hφ_mk n a ha]
      exact hψ_ev n a ha
    let δ_ν : P_K ≃+* HomogeneousLocalization.Away ℬ (MvPolynomial.X ν) :=
      { toFun := ψ_ν
        invFun := φ_ν
        left_inv := hφψ
        right_inv := hψφ
        map_mul' := ψ_ν.map_mul'
        map_add' := ψ_ν.map_add' }
    refine ⟨δ_ν, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro r
      exact MvPolynomial.eval₂Hom_C c_ν t_ν r
    · intro i
      let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (K_idx + 1)) R) :=
        MvPolynomial.gradedAlgebra
      change ψ_ν (MvPolynomial.X i) = _
      rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.ext_iff_val]
      dsimp only [t_ν, ℬ, HomogeneousLocalization.Away.isLocalizationElem]
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
      simp only [pow_one]
    · intro n p hp
      exact hψ_ev n p hp

  have hquotEquiv_mk : ∀ {A₁ A₂ : Type u} [CommRing A₁] [CommRing A₂]
      (I₁ : Ideal A₁) (I₂ : Ideal A₂) (e : A₁ ≃+* A₂)
      (hI : I₂ = Ideal.map e.toRingHom I₁) (x : A₁),
      Ideal.quotientEquiv I₁ I₂ e hI (Ideal.Quotient.mk I₁ x) =
        Ideal.Quotient.mk I₂ (e x) := by
    intro A₁ A₂ _ _ I₁ I₂ e hI x
    simp [Ideal.quotientEquiv, Ideal.quotientMap_mk]

  
  let P_N := MvPolynomial (Fin (2 * (m + 1))) R
  let ev_0 : MvPolynomial (Fin (2 * (m + 1) + 1)) R →+* P_N :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (Fin.insertNth (α := fun _ => P_N) 0 1 MvPolynomial.X)
  have hChart0 :
      ∃ α₀ : M_R ≃+* (P_N ⧸ Ideal.span {ev_0 G_R}),
        α₀.toRingHom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
        ∀ (j : Fin (m + 1)) (b : Fin 2),
          α₀ (Ideal.Quotient.mk _ (MvPolynomial.X (j, b))) =
            Ideal.Quotient.mk _
              (MvPolynomial.X (⟨2 * j.1 + b.1, by omega⟩ : Fin (2 * (m + 1)))) := by
    let e_pair : Fin (m + 1) × Fin 2 ≃ Fin (2 * (m + 1)) :=
      { toFun := fun p => ⟨2 * p.1.1 + p.2.1, by omega⟩
        invFun := fun c => (⟨c.1 / 2, by omega⟩, ⟨c.1 % 2, by omega⟩)
        left_inv := fun ⟨j, b⟩ =>
          Prod.ext (Fin.ext (by dsimp only; omega)) (Fin.ext (by dsimp only; omega))
        right_inv := fun c => Fin.ext (by dsimp only; omega) }
    let ρ_pair : MvPolynomial (Fin (m + 1) × Fin 2) R ≃+* P_N :=
      (MvPolynomial.renameEquiv R e_pair).toRingEquiv
    let rel_M : MvPolynomial (Fin (m + 1) × Fin 2) R :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C t_R
    have hρ_rel : ρ_pair rel_M =
        (∑ j : Fin (m + 1),
          (MvPolynomial.X ⟨2 * j.1, by omega⟩ : P_N) *
            MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩) - MvPolynomial.C t_R := by
      change (MvPolynomial.renameEquiv R e_pair) rel_M = _
      rw [MvPolynomial.renameEquiv_apply]
      dsimp only [rel_M]
      rw [map_sub, map_sum, MvPolynomial.rename_C]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      rw [map_mul, MvPolynomial.rename_X, MvPolynomial.rename_X]
      have h0 : e_pair (j, 0) = ⟨2 * j.1, by omega⟩ := by
        apply Fin.ext
        change 2 * j.1 + 0 = 2 * j.1
        omega
      have h1 : e_pair (j, 1) = ⟨2 * j.1 + 1, by omega⟩ := by
        apply Fin.ext
        change 2 * j.1 + 1 = 2 * j.1 + 1
        rfl
      rw [h0, h1]
    have hev0_G : ev_0 G_R = ρ_pair rel_M := by
      rw [hG_eq, hρ_rel, map_add, map_mul, map_mul, map_neg, map_sum]
      have hev0_C : ev_0 (MvPolynomial.C t_R) = MvPolynomial.C t_R :=
        MvPolynomial.eval₂Hom_C _ _ t_R
      have hev0_X0 : ev_0 (MvPolynomial.X 0) = 1 := by
        change MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => P_N) 0 1 MvPolynomial.X) (MvPolynomial.X 0) = 1
        rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
      have hsum_eq :
          (∑ j : Fin (m + 1),
            ev_0 ((MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ :
                MvPolynomial (Fin (2 * (m + 1) + 1)) R) *
              MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩)) =
          ∑ j : Fin (m + 1),
            (MvPolynomial.X ⟨2 * j.1, by omega⟩ : P_N) *
              MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ := by
        apply Finset.sum_congr rfl
        intro j _
        rw [map_mul]
        have hidx1 : (⟨2 * j.1 + 1, by omega⟩ : Fin (2 * (m + 1) + 1)) =
            (0 : Fin (2 * (m + 1) + 1)).succAbove ⟨2 * j.1, by omega⟩ := by
          rw [Fin.zero_succAbove]
          exact Fin.ext rfl
        have hidx2 : (⟨2 * j.1 + 2, by omega⟩ : Fin (2 * (m + 1) + 1)) =
            (0 : Fin (2 * (m + 1) + 1)).succAbove ⟨2 * j.1 + 1, by omega⟩ := by
          rw [Fin.zero_succAbove]
          exact Fin.ext rfl
        rw [hidx1, hidx2]
        change (MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth (α := fun _ => P_N) 0 1 MvPolynomial.X)
            (MvPolynomial.X ((0 : Fin (2 * (m + 1) + 1)).succAbove ⟨2 * j.1, by omega⟩))) *
          (MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth (α := fun _ => P_N) 0 1 MvPolynomial.X)
            (MvPolynomial.X ((0 : Fin (2 * (m + 1) + 1)).succAbove ⟨2 * j.1 + 1, by omega⟩))) = _
        rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove,
          MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
      rw [hev0_C, hev0_X0, hsum_eq]
      ring
    have hIJ : Ideal.span {ev_0 G_R} = Ideal.map ρ_pair.toRingHom (Ideal.span {rel_M}) := by
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun x => Ideal.span {x}) hev0_G
    let α₀ : M_R ≃+* (P_N ⧸ Ideal.span {ev_0 G_R}) :=
      Ideal.quotientEquiv (Ideal.span {rel_M}) (Ideal.span {ev_0 G_R}) ρ_pair hIJ
    refine ⟨α₀, ?_, ?_⟩
    · apply RingHom.ext
      intro r
      dsimp only [α₀]
      change Ideal.quotientEquiv (Ideal.span {rel_M}) (Ideal.span {ev_0 G_R}) ρ_pair hIJ
          (Ideal.Quotient.mk (Ideal.span {rel_M}) (MvPolynomial.C r)) =
        Ideal.Quotient.mk (Ideal.span {ev_0 G_R}) (MvPolynomial.C r)
      rw [hquotEquiv_mk]
      exact congrArg (Ideal.Quotient.mk _) (MvPolynomial.rename_C e_pair r)
    · intro j b
      dsimp only [α₀]
      change Ideal.quotientEquiv (Ideal.span {rel_M}) (Ideal.span {ev_0 G_R}) ρ_pair hIJ
          (Ideal.Quotient.mk (Ideal.span {rel_M}) (MvPolynomial.X (j, b))) = _
      rw [hquotEquiv_mk]
      exact congrArg (Ideal.Quotient.mk _) (MvPolynomial.rename_X e_pair (j, b))

  
  have hCharta : ∀ a : Fin (2 * (m + 1)),
      let ev_a : MvPolynomial (Fin (2 * (m + 1) + 1)) R →+* P_N :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => P_N) a.succ 1 MvPolynomial.X)
      ∃ β_a : MvPolynomial (Fin (2 * m + 1)) R ≃+* (P_N ⧸ Ideal.span {ev_a G_R}),
        β_a.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk _).comp MvPolynomial.C := by
    intro a ev_a
    let S₀ := MvPolynomial (Fin (2 * m + 1)) R
    let j₀ : Fin (m + 1) := ⟨a.1 / 2, by omega⟩
    let a_hat : Fin (2 * (m + 1)) := ⟨2 * j₀.1 + 1, by omega⟩
    let idx₀ : Fin (2 * (m + 1)) := ⟨0, by omega⟩
    let σ_a : Equiv.Perm (Fin (2 * (m + 1))) := Equiv.swap idx₀ a_hat
    let Φ_a : P_N ≃ₐ[R] Polynomial S₀ :=
      (MvPolynomial.renameEquiv R σ_a).trans (MvPolynomial.finSuccEquiv R (2 * m + 1))
    have hΦ_ahat : Φ_a (MvPolynomial.X a_hat) = Polynomial.X := by
      change MvPolynomial.finSuccEquiv R (2 * m + 1)
        (MvPolynomial.renameEquiv R σ_a (MvPolynomial.X a_hat)) = Polynomial.X
      rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, Equiv.swap_apply_right]
      have hidx0_eq : idx₀ = (0 : Fin (2 * m + 1 + 1)) := rfl
      rw [hidx0_eq, MvPolynomial.finSuccEquiv_X_zero]
    have hΦ_ne : ∀ i : Fin (2 * (m + 1)), i ≠ a_hat →
        ∃ p : S₀, Φ_a (MvPolynomial.X i) = Polynomial.C p := by
      intro i hi
      have hσ_ne : σ_a i ≠ (0 : Fin (2 * m + 1 + 1)) := by
        intro h0
        have hswap : σ_a a_hat = (0 : Fin (2 * m + 1 + 1)) := Equiv.swap_apply_right idx₀ a_hat
        exact hi (σ_a.injective (h0.trans hswap.symm))
      let k_pred : Fin (2 * m + 1) := (σ_a i).pred hσ_ne
      refine ⟨MvPolynomial.X k_pred, ?_⟩
      change MvPolynomial.finSuccEquiv R (2 * m + 1)
        (MvPolynomial.renameEquiv R σ_a (MvPolynomial.X i)) = _
      rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
      have hk : σ_a i = k_pred.succ := (Fin.succ_pred (σ_a i) hσ_ne).symm
      rw [hk, MvPolynomial.finSuccEquiv_X_succ]
    have heva_same : ev_a (MvPolynomial.X a.succ) = 1 := by
      change MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => P_N) a.succ 1 MvPolynomial.X) (MvPolynomial.X a.succ) = 1
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
    have heva_succ : ∀ i : Fin (2 * (m + 1)),
        ev_a (MvPolynomial.X ((a.succ).succAbove i)) = MvPolynomial.X i := by
      intro i
      change MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => P_N) a.succ 1 MvPolynomial.X)
        (MvPolynomial.X ((a.succ).succAbove i)) = MvPolynomial.X i
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
    have h0_succAbove : (a.succ).succAbove idx₀ = (0 : Fin (2 * (m + 1) + 1)) := by
      have hlt : idx₀.castSucc < a.succ := by
        change (0 : ℕ) < a.1 + 1
        omega
      rw [Fin.succAbove_of_castSucc_lt a.succ idx₀ hlt]
      exact Fin.ext rfl
    have hidx0_ne_ahat : idx₀ ≠ a_hat := by
      intro heq
      have hv := congrArg Fin.val heq
      dsimp only [idx₀, a_hat] at hv
      omega
    obtain ⟨z₀, hz₀⟩ := hΦ_ne idx₀ hidx0_ne_ahat
    have hΦ_term0 : Φ_a (ev_a (-MvPolynomial.C t_R * MvPolynomial.X 0 * MvPolynomial.X 0)) =
        -Polynomial.C (MvPolynomial.C t_R * z₀ * z₀) := by
      have heva_C : ev_a (MvPolynomial.C t_R) = algebraMap R P_N t_R := by
        change MvPolynomial.eval₂Hom MvPolynomial.C _ (MvPolynomial.C t_R) = _
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.algebraMap_eq]
