    let hom_hom : M_v.obj T_V ⟶ V_et :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 V)
        (by change 𝟙 V ≫ v = 𝟙 V ≫ v; rfl) trivial
    let hom_inv : V_et ⟶ M_v.obj T_V :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 V)
        (by change 𝟙 V ≫ (𝟙 V ≫ v) = v; rw [Category.id_comp, Category.id_comp]) trivial
