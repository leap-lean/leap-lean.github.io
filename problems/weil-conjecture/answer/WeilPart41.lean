    have hQ_unique_root : ∀ r : k, Q.IsRoot r → r = c₀ := by
      intro c₁ hc₁_root
      by_contra h_ne
      obtain ⟨μ₀, _, m₀, hm₀_ne, h_c₀⟩ := h_root_laurent c₀ hc₀_root
      obtain ⟨μ₁, _, m₁, hm₁_ne, h_c₁⟩ := h_root_laurent c₁ hc₁_root
      have h_diff : ι_T_hom (Polynomial.C μ₀) * (↑(u_T ^ m₀) : R_T) -
          ι_T_hom (Polynomial.C μ₁) * (↑(u_T ^ m₁) : R_T) =
          ι_T_hom (Polynomial.C (c₁ - c₀)) := by
        rw [← h_c₀, ← h_c₁, ← map_sub, ← map_sub]
        have h_sub_poly : (Polynomial.X - Polynomial.C c₀) - (Polynomial.X - Polynomial.C c₁) =
            Polynomial.C (c₁ - c₀) := by rw [map_sub]; ring
        rw [h_sub_poly, hσ₀_C]
      let N : ℕ := (-m₀).toNat + (-m₁).toNat
      have hm₀N : 0 ≤ m₀ + (N : ℤ) := by dsimp [N]; omega
      have hm₁N : 0 ≤ m₁ + (N : ℤ) := by dsimp [N]; omega
      let n₀ : ℕ := (m₀ + (N : ℤ)).toNat
      let n₁ : ℕ := (m₁ + (N : ℤ)).toNat
      have hn₀_ne : n₀ ≠ N := by dsimp [n₀]; omega
      have hn₁_ne : n₁ ≠ N := by dsimp [n₁]; omega
      have h_mul := congrArg (· * (↑(u_T ^ (N : ℤ)) : R_T)) h_diff
      rw [sub_mul, mul_assoc, mul_assoc, ← Units.val_mul, ← Units.val_mul,
        ← zpow_add, ← zpow_add] at h_mul
      have hz₀ : m₀ + (N : ℤ) = (n₀ : ℤ) := (Int.toNat_of_nonneg hm₀N).symm
      have hz₁ : m₁ + (N : ℤ) = (n₁ : ℤ) := (Int.toNat_of_nonneg hm₁N).symm
      rw [hz₀, hz₁, hu_T_zpow_nat, hu_T_zpow_nat, hu_T_zpow_nat,
        ← map_mul, ← map_mul, ← map_mul, ← map_sub] at h_mul
      have h_poly := hι_T_inj h_mul
      have h_coeff := congrArg (fun P => P.coeff N) h_poly
      simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X_pow] at h_coeff
      simp only [hn₀_ne.symm, hn₁_ne.symm, ↓reduceIte, sub_zero] at h_coeff
      exact h_ne (sub_eq_zero.mp h_coeff.symm)
    have h_factor_single_root : ∀ (n : ℕ) (H : Polynomial k),
        H.natDegree = n → H ≠ 0 → (∀ r : k, H.IsRoot r → r = c₀) →
        ∃ (a : k) (_ : a ≠ 0) (e : ℕ), H = Polynomial.C a * (Polynomial.X - Polynomial.C c₀) ^ e := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro H hdeg hH_ne hH_roots
        rcases Nat.eq_zero_or_pos n with rfl | hn_pos
        · have hH_C : H = Polynomial.C (H.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hdeg
          have ha_ne : H.coeff 0 ≠ 0 := by intro h0; apply hH_ne; rw [hH_C, h0, map_zero]
          exact ⟨H.coeff 0, ha_ne, 0, by rw [pow_zero, mul_one]; exact hH_C⟩
        · have hH_deg_ne : H.degree ≠ 0 := by
            intro hd0
            have : H.natDegree = 0 :=
              Polynomial.natDegree_eq_zero_iff_degree_le_zero.mpr (le_of_eq hd0)
            omega
          obtain ⟨r, hr⟩ := IsAlgClosed.exists_root H hH_deg_ne
          rw [hH_roots r hr] at hr
          obtain ⟨H', hH'⟩ := Polynomial.dvd_iff_isRoot.mpr hr
          have hH'_ne : H' ≠ 0 := by intro h0; apply hH_ne; rw [hH', h0, mul_zero]
          have hdeg_H' : H'.natDegree < n := by
            have hmul_deg : H.natDegree = (Polynomial.X - Polynomial.C c₀).natDegree + H'.natDegree := by
              rw [hH', Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero c₀) hH'_ne]
            rw [Polynomial.natDegree_X_sub_C] at hmul_deg
            omega
          have hH'_roots : ∀ r' : k, H'.IsRoot r' → r' = c₀ := by
            intro r' hr'
            apply hH_roots r'
            rw [Polynomial.IsRoot.def, hH', Polynomial.eval_mul, hr'.eq_zero, mul_zero]
          obtain ⟨a, ha_ne, e', hH'_eq⟩ := ih H'.natDegree hdeg_H' H' rfl hH'_ne hH'_roots
          exact ⟨a, ha_ne, e' + 1, by rw [hH', hH'_eq, pow_succ]; ring⟩
    obtain ⟨a_Q, ha_Q_ne, e_Q, hQ_eq⟩ :=
      h_factor_single_root Q.natDegree Q rfl hQ_ne hQ_unique_root
    have he_Q_pos : 1 ≤ e_Q := by
      rcases Nat.eq_zero_or_pos e_Q with rfl | hpos
      · rw [pow_zero, mul_one] at hQ_eq
        rw [hQ_eq, Polynomial.natDegree_C] at hQ_deg_pos
        omega
      · exact hpos
    let R_c₀ := Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)
    let ι_c₀_hom : Polynomial k →+* R_c₀ := algebraMap (Polynomial k) R_c₀
    have h_unit_in_RQ : IsUnit (ι_Q_hom (Polynomial.X - Polynomial.C c₀)) := by
      have hQ_u : IsUnit (ι_Q_hom Q) := IsLocalization.Away.algebraMap_isUnit Q
      obtain ⟨e', rfl⟩ : ∃ e' : ℕ, e_Q = e' + 1 := ⟨e_Q - 1, (Nat.sub_add_cancel he_Q_pos).symm⟩
      have hQ_map : ι_Q_hom Q =
          ι_Q_hom (Polynomial.X - Polynomial.C c₀) *
            ι_Q_hom (Polynomial.C a_Q * (Polynomial.X - Polynomial.C c₀) ^ e') := by
        rw [← map_mul]
        congr 1
        rw [hQ_eq, pow_succ']
        ring
      rw [hQ_map] at hQ_u
      exact isUnit_of_mul_isUnit_left hQ_u
    have h_unit_in_Rc₀ : IsUnit (ι_c₀_hom Q) := by
      rw [hQ_eq, map_mul, map_pow]
      exact (((Ne.isUnit ha_Q_ne).map Polynomial.C).map ι_c₀_hom).mul
        ((IsLocalization.Away.algebraMap_isUnit (Polynomial.X - Polynomial.C c₀ : Polynomial k)).pow e_Q)
    let φ_c₀_to_Q : R_c₀ →+* R_Q :=
      IsLocalization.Away.lift (Polynomial.X - Polynomial.C c₀ : Polynomial k) h_unit_in_RQ
    let φ_Q_to_c₀ : R_Q →+* R_c₀ :=
      IsLocalization.Away.lift Q h_unit_in_Rc₀
    have h_loc_id1 : φ_Q_to_c₀.comp φ_c₀_to_Q = RingHom.id R_c₀ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X - Polynomial.C c₀ : Polynomial k))
      apply RingHom.ext
      intro P
      dsimp only [RingHom.comp_apply, RingHom.id_apply, φ_c₀_to_Q, φ_Q_to_c₀]
      rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
    have h_loc_id2 : φ_c₀_to_Q.comp φ_Q_to_c₀ = RingHom.id R_Q := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Q)
      apply RingHom.ext
      intro P
      dsimp only [RingHom.comp_apply, RingHom.id_apply, φ_c₀_to_Q, φ_Q_to_c₀]
      rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
    let e_loc : R_c₀ ≃+* R_Q :=
      { φ_c₀_to_Q with
        invFun := φ_Q_to_c₀
        left_inv := fun x => congrArg (fun f => f x) h_loc_id1
        right_inv := fun x => congrArg (fun f => f x) h_loc_id2 }
    let σ_glue : R_c₀ ≃+* R_T := e_loc.trans σ₀
    have hσ_glue_alg : ∀ P : Polynomial k, σ_glue (ι_c₀_hom P) = σ₀ (ι_Q_hom P) := by
      intro P
      change σ₀ (φ_c₀_to_Q (ι_c₀_hom P)) = σ₀ (ι_Q_hom P)
      rw [IsLocalization.Away.lift_eq]
    have hσ_glue_C : ∀ c : k, σ_glue (ι_c₀_hom (Polynomial.C c)) = ι_T_hom (Polynomial.C c) := by
      intro c; rw [hσ_glue_alg, hσ₀_C]
    let u_xc₀ : R_Tˣ :=
      Units.map σ_glue.toRingHom.toMonoidHom
        (IsLocalization.Away.algebraMap_isUnit (Polynomial.X - Polynomial.C c₀ : Polynomial k)).unit
    obtain ⟨lam₀, hlam₀, m_exp, hm_exp_eq⟩ := h_units_RT u_xc₀
    have hσ_xc₀ : σ_glue (ι_c₀_hom (Polynomial.X - Polynomial.C c₀)) =
        ι_T_hom (Polynomial.C lam₀) * (↑(u_T ^ m_exp) : R_T) := hm_exp_eq
    obtain ⟨⟨P_inv, _, d_inv, rfl⟩, hP_inv_surj⟩ :=
      IsLocalization.surj (Submonoid.powers (Polynomial.X - Polynomial.C c₀ : Polynomial k))
        (σ_glue.symm (u_T : R_T))
    have hP_inv_eq : σ_glue.symm (u_T : R_T) *
        ι_c₀_hom ((Polynomial.X - Polynomial.C c₀) ^ d_inv) = ι_c₀_hom P_inv :=
      hP_inv_surj
    let P_sh : Polynomial k := P_inv.comp (Polynomial.X + Polynomial.C c₀)
    have hP_sh_comp : P_sh.comp (Polynomial.X - Polynomial.C c₀) = P_inv := by
      dsimp [P_sh]
      rw [Polynomial.comp_assoc]
      have h1 : (Polynomial.X + Polynomial.C c₀ : Polynomial k).comp (Polynomial.X - Polynomial.C c₀) =
          Polynomial.X := by
        rw [Polynomial.add_comp, Polynomial.X_comp, Polynomial.C_comp, sub_add_cancel]
      rw [h1, Polynomial.comp_X]
    have h_sum_RT : ι_T_hom (Polynomial.C (lam₀ ^ d_inv)) *
        (↑(u_T ^ (1 + (d_inv : ℤ) * m_exp)) : R_T) =
        ∑ i ∈ P_sh.support,
          ι_T_hom (Polynomial.C (P_sh.coeff i * lam₀ ^ i)) *
            (↑(u_T ^ ((i : ℤ) * m_exp)) : R_T) := by
      have h_app := congrArg σ_glue hP_inv_eq
      rw [map_mul, map_pow, map_pow, σ_glue.apply_symm_apply, hσ_xc₀] at h_app
      have h_lhs : (u_T : R_T) * (ι_T_hom (Polynomial.C lam₀) * (↑(u_T ^ m_exp) : R_T)) ^ d_inv =
          ι_T_hom (Polynomial.C (lam₀ ^ d_inv)) * (↑(u_T ^ (1 + (d_inv : ℤ) * m_exp)) : R_T) := by
        rw [mul_pow, ← map_pow, ← map_pow]
        have h_upow : ((↑(u_T ^ m_exp) : R_T)) ^ d_inv = (↑(u_T ^ ((d_inv : ℤ) * m_exp)) : R_T) := by
          rw [← Units.val_pow_eq_pow_val, ← zpow_natCast, ← zpow_mul, mul_comm]
        rw [h_upow]
        calc
          (u_T : R_T) * (ι_T_hom (Polynomial.C (lam₀ ^ d_inv)) * (↑(u_T ^ ((d_inv : ℤ) * m_exp)) : R_T))
            = ι_T_hom (Polynomial.C (lam₀ ^ d_inv)) *
                ((↑(u_T ^ (1 : ℤ)) : R_T) * (↑(u_T ^ ((d_inv : ℤ) * m_exp)) : R_T)) := by
                rw [zpow_one]; ring
          _ = ι_T_hom (Polynomial.C (lam₀ ^ d_inv)) * (↑(u_T ^ (1 + (d_inv : ℤ) * m_exp)) : R_T) := by
                rw [← Units.val_mul, ← zpow_add]
      rw [h_lhs] at h_app
      rw [h_app, ← hP_sh_comp]
      conv_lhs => rw [Polynomial.as_sum_support_C_mul_X_pow P_sh]
      rw [Polynomial.sum_comp, map_sum, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.pow_comp, Polynomial.X_comp,
        map_mul, map_pow, map_mul, map_pow, hσ_glue_C, hσ_xc₀, mul_pow]
      have h_upow : ((↑(u_T ^ m_exp) : R_T)) ^ i = (↑(u_T ^ ((i : ℤ) * m_exp)) : R_T) := by
        rw [← Units.val_pow_eq_pow_val, ← zpow_natCast, ← zpow_mul, mul_comm]
      rw [h_upow, ← mul_assoc, ← map_pow, ← map_mul, ← Polynomial.C_pow, ← Polynomial.C_mul]
    let B_deg : ℕ := P_sh.natDegree + 1
    let N_sh : ℕ := (-(1 + (d_inv : ℤ) * m_exp)).toNat + B_deg * (-m_exp).toNat
    have h_lhs_nonneg : 0 ≤ 1 + (d_inv : ℤ) * m_exp + (N_sh : ℤ) := by
      dsimp [N_sh]
      have : 0 ≤ (B_deg : ℤ) * ((-m_exp).toNat : ℤ) := by positivity
      omega
    have h_rhs_nonneg : ∀ i ∈ P_sh.support, 0 ≤ (i : ℤ) * m_exp + (N_sh : ℤ) := by
      intro i hi
      have hi_le : i ≤ B_deg := Nat.le_succ_of_le (Polynomial.le_natDegree_of_mem_supp i hi)
      have h1 : 0 ≤ (i : ℤ) * (m_exp + ((-m_exp).toNat : ℤ)) :=
        mul_nonneg (Nat.cast_nonneg i) (by omega)
      have h2 : (i : ℤ) * ((-m_exp).toNat : ℤ) ≤ (B_deg : ℤ) * ((-m_exp).toNat : ℤ) :=
        mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hi_le) (Nat.cast_nonneg _)
      dsimp [N_sh]
      have h3 : (0 : ℤ) ≤ ((-(1 + (d_inv : ℤ) * m_exp)).toNat : ℤ) :=
        Nat.cast_nonneg _
      linarith
    let k_lhs : ℕ := (1 + (d_inv : ℤ) * m_exp + (N_sh : ℤ)).toNat
    have h_poly_sum : Polynomial.C (lam₀ ^ d_inv) * (Polynomial.X : Polynomial k) ^ k_lhs =
        ∑ i ∈ P_sh.support,
          Polynomial.C (P_sh.coeff i * lam₀ ^ i) *
            (Polynomial.X : Polynomial k) ^ ((i : ℤ) * m_exp + (N_sh : ℤ)).toNat := by
      apply hι_T_inj
      have h_mul := congrArg (· * (↑(u_T ^ (N_sh : ℤ)) : R_T)) h_sum_RT
      rw [Finset.sum_mul, mul_assoc, ← Units.val_mul, ← zpow_add] at h_mul
      have hz_lhs : 1 + (d_inv : ℤ) * m_exp + (N_sh : ℤ) = (k_lhs : ℤ) :=
        (Int.toNat_of_nonneg h_lhs_nonneg).symm
      rw [hz_lhs, hu_T_zpow_nat, ← map_mul] at h_mul
      rw [h_mul, map_sum]
      apply Finset.sum_congr rfl
      intro i hi
      let k_i : ℕ := ((i : ℤ) * m_exp + (N_sh : ℤ)).toNat
      have hz_i : (i : ℤ) * m_exp + (N_sh : ℤ) = (k_i : ℤ) :=
        (Int.toNat_of_nonneg (h_rhs_nonneg i hi)).symm
      change ι_T_hom (Polynomial.C (P_sh.coeff i * lam₀ ^ i)) *
          (↑(u_T ^ ((i : ℤ) * m_exp)) : R_T) * (↑(u_T ^ (N_sh : ℤ)) : R_T) =
        ι_T_hom (Polynomial.C (P_sh.coeff i * lam₀ ^ i) * (Polynomial.X : Polynomial k) ^ k_i)
      rw [mul_assoc, ← Units.val_mul, ← zpow_add, hz_i, hu_T_zpow_nat, ← map_mul]
    have hm_pm1 : m_exp = 1 ∨ m_exp = -1 := by
      have h_coeff := congrArg (fun P => P.coeff k_lhs) h_poly_sum
      rw [Polynomial.coeff_C_mul_X_pow, Polynomial.finsetSum_coeff] at h_coeff
      simp only [↓reduceIte] at h_coeff
      have h_ne0 : lam₀ ^ d_inv ≠ 0 := pow_ne_zero d_inv hlam₀
      rw [h_coeff] at h_ne0
      obtain ⟨i, hi_supp, hi_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_ne0
      rw [Polynomial.coeff_C_mul_X_pow] at hi_ne
      by_cases h_idx_eq : k_lhs = ((i : ℤ) * m_exp + (N_sh : ℤ)).toNat
      · have h_int_eq : (i : ℤ) * m_exp + (N_sh : ℤ) = 1 + (d_inv : ℤ) * m_exp + (N_sh : ℤ) := by
          have h1 : (((i : ℤ) * m_exp + (N_sh : ℤ)).toNat : ℤ) = (k_lhs : ℤ) :=
            congrArg Nat.cast h_idx_eq.symm
          rwa [Int.toNat_of_nonneg (h_rhs_nonneg i hi_supp),
            Int.toNat_of_nonneg h_lhs_nonneg] at h1
        have h_prod_one : ((i : ℤ) - (d_inv : ℤ)) * m_exp = 1 := by linarith
        rcases Int.eq_one_or_neg_one_of_mul_eq_one' h_prod_one with ⟨_, h1⟩ | ⟨_, h2⟩
        · exact Or.inl h1
        · exact Or.inr h2
      · simp only [h_idx_eq, ↓reduceIte] at hi_ne
        exact absurd rfl hi_ne
    refine ⟨c₀, lam₀, hlam₀, σ_glue, ⟨a_Q, ha_Q_ne, e_Q, he_Q_pos, hQ_eq⟩,
      hσ_glue_C, RingHom.ext hσ_glue_alg, ?_⟩
    rcases hm_pm1 with hm1 | hm_neg1
    · left
      apply Polynomial.ringHom_ext
      · intro c
        change ι_T_hom
            (Polynomial.aeval (Polynomial.C c₀ + Polynomial.C lam₀ * Polynomial.X : Polynomial k)
              (Polynomial.C c)) =
          σ_glue (ι_c₀_hom (Polynomial.C c))
        rw [Polynomial.aeval_C]
        exact (hσ_glue_C c).symm
      · change ι_T_hom
            (Polynomial.aeval (Polynomial.C c₀ + Polynomial.C lam₀ * Polynomial.X : Polynomial k)
              Polynomial.X) =
          σ_glue (ι_c₀_hom Polynomial.X)
        rw [Polynomial.aeval_X, map_add, map_mul]
        have h_X : ι_c₀_hom Polynomial.X =
            ι_c₀_hom (Polynomial.C c₀) + ι_c₀_hom (Polynomial.X - Polynomial.C c₀) := by
          rw [← map_add, add_sub_cancel]
        rw [h_X, map_add, hσ_glue_C, hσ_xc₀, hm1, zpow_one, hu_T_val]
    · right
      have h_X : ι_c₀_hom Polynomial.X =
          ι_c₀_hom (Polynomial.C c₀) + ι_c₀_hom (Polynomial.X - Polynomial.C c₀) := by
        rw [← map_add, add_sub_cancel]
      rw [h_X, map_add, hσ_glue_C, hσ_xc₀, hm_neg1, zpow_neg_one, hu_T_inv]

  
  
  
  obtain ⟨c₀, lam₀, hlam₀, σ_glue, ⟨a_Q, ha_Q_ne, e_Q, he_Q_pos, hQ_eq⟩,
    hσ_glue_C, hσ_fac, hBranches⟩ := hPillar4
  have hj_aff_pre : j_aff_k.base ⁻¹' Set.range j_inf.base =
      { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
        Polynomial.X - Polynomial.C c₀ ∉ p.asIdeal } := by
    rw [hj_aff_pre_Q]
    ext p
    change Q ∉ p.asIdeal ↔ Polynomial.X - Polynomial.C c₀ ∉ p.asIdeal
    apply not_congr
    rw [hQ_eq, p.isPrime.mul_mem_iff_mem_or_mem]
    have hCa_not_mem : Polynomial.C a_Q ∉ p.asIdeal := by
      intro hmem
      have hunit : IsUnit (Polynomial.C a_Q) := (Ne.isUnit ha_Q_ne).map Polynomial.C
      exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hmem hunit)
    simp only [hCa_not_mem, false_or]
    exact ⟨p.isPrime.mem_of_pow_mem e_Q, fun hm => Ideal.pow_mem_of_mem p.asIdeal hm e_Q he_Q_pos⟩
  have hσ_glue_comm :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_glue.toRingHom) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial k)
            (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)))) ≫
        j_aff_k =
      AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial k)
            (Localization.Away (Polynomial.X : Polynomial k)))) ≫
        j_inf := by
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hσ_fac, CommRingCat.ofHom_comp,
      AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    exact hσ₀_comm
  rcases hBranches with hBranch_pos1 | hσ_glue_X
  · exfalso
    let τ_bad : Polynomial k →+* Polynomial k :=
      (Polynomial.aeval (Polynomial.C c₀ + Polynomial.C lam₀ * Polynomial.X : Polynomial k)).toRingHom
    have hτ_bad_C : τ_bad.comp Polynomial.C = Polynomial.C := by
      ext c; simp [τ_bad]
    apply hNoExtend τ_bad hτ_bad_C
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hBranch_pos1, CommRingCat.ofHom_comp,
      AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    exact hσ_glue_comm
  · exact ⟨c₀, lam₀, hlam₀, j_inf, hj_inf_open, σ_glue,
      ⟨hj_inf_hom, hj_inf_zero⟩,
      ⟨hj_inf_pre, hj_aff_pre⟩,
      ⟨hσ_glue_C, hσ_glue_X, hσ_glue_comm⟩⟩

theorem weil_p2_closed_imm_line_coprime_polys_and_chart_rings (k : Type u) [Field k] [IsAlgClosed k]
    (P1_sch P2_sch : AlgebraicGeometry.Scheme.{u})
    (p_P1 : P1_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
