        exact ⟨z, fun hz_eq => hy_ne (hz_eq ▸ hz_star), rfl⟩
    rw [← hImg_eq]
    exact ι_F.isClosedEmbedding.isClosedMap _ hClosed_compl
  have he_aff_v : v_aff ≫ e_aff = x_bar_R := by
    dsimp [e_aff]
    rw [← Category.assoc, hv_aff_fac, hv_eW₀]
  have hq_aff_v : v_aff ≫ q_aff = zero_M := by
    dsimp [q_aff]
    rw [← Category.assoc, hv_aff_fac, hv_qM₀]
  have hC_e : IsClosed ((e_aff.base ⁻¹' Set.range x_bar_R.base) \ {w_star}) :=
    hSpurClosed Z_R x_bar_R e_aff he_aff_v
  have hC_q : IsClosed ((q_aff.base ⁻¹' Set.range zero_M.base) \ {w_star}) :=
    hSpurClosed _ zero_M q_aff hq_aff_v
  let C_bad : Set ↥V_aff.toScheme :=
    ((e_aff.base ⁻¹' Set.range x_bar_R.base) \ {w_star}) ∪
      ((q_aff.base ⁻¹' Set.range zero_M.base) \ {w_star})
  let U_good : V_aff.toScheme.Opens := ⟨C_badᶜ, (hC_e.union hC_q).isOpen_compl⟩
  have hw_good : w_star ∈ U_good := by
    change w_star ∉ C_bad
    simp [C_bad]
  have hRange_vaff : Set.range v_aff.base ⊆ Set.range U_good.ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    rw [hFieldPt pt]
    exact hw_good
  let W_R := U_good.toScheme
  let v_W : Spec (CommRingCat.of k) ⟶ W_R := IsOpenImmersion.lift U_good.ι v_aff hRange_vaff
  have hv_W_fac : v_W ≫ U_good.ι = v_aff := IsOpenImmersion.lift_fac U_good.ι v_aff hRange_vaff
  let e_W : W_R ⟶ Z_R := U_good.ι ≫ e_aff
  let q_M : W_R ⟶ weilOdpModelSpec m (CommRingCat.of R_bar) h_R := U_good.ι ≫ q_aff
  have hvW_eW : v_W ≫ e_W = x_bar_R := by
    dsimp [e_W]
    rw [← Category.assoc, hv_W_fac, he_aff_v]
  have hvW_qM : v_W ≫ q_M = zero_M := by
    dsimp [q_M]
    rw [← Category.assoc, hv_W_fac, hq_aff_v]
  have hPre_e : e_W.base ⁻¹' (Set.range x_bar_R.base) = Set.range v_W.base := by
    ext u
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · intro hu
      have hu_good : U_good.ι.base u ∈ U_good := u.2
      change U_good.ι.base u ∉ C_bad at hu_good
      have hu_eq : U_good.ι.base u = w_star := by
        by_contra hne
        exact hu_good (Or.inl ⟨hu, hne⟩)
      refine ⟨pt_k, U_good.ι.isOpenEmbedding.injective ?_⟩
      change (v_W ≫ U_good.ι).base pt_k = U_good.ι.base u
      rw [hv_W_fac, hu_eq]
    · rintro ⟨pt, rfl⟩
      exact ⟨pt, congrArg (fun φ => φ.base pt) hvW_eW.symm⟩
  have hPre_q : q_M.base ⁻¹' (Set.range zero_M.base) = Set.range v_W.base := by
    ext u
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · intro hu
      have hu_good : U_good.ι.base u ∈ U_good := u.2
      change U_good.ι.base u ∉ C_bad at hu_good
      have hu_eq : U_good.ι.base u = w_star := by
        by_contra hne
        exact hu_good (Or.inr ⟨hu, hne⟩)
      refine ⟨pt_k, U_good.ι.isOpenEmbedding.injective ?_⟩
      change (v_W ≫ U_good.ι).base pt_k = U_good.ι.base u
      rw [hv_W_fac, hu_eq]
    · rintro ⟨pt, rfl⟩
      exact ⟨pt, congrArg (fun φ => φ.base pt) hvW_qM.symm⟩

  refine ⟨h_R, x_bar_R, U_Z, j_Z_open, zero_M, W_R, v_W, e_W, q_M,
    ⟨hh_max, hh_ne⟩,
    ⟨hx_Z_cl, rfl, ?_, ?_⟩,
    hAtlas,
    ⟨inferInstance, inferInstance, hvW_eW, hvW_qM, hzero_X, hzero_C, hPre_e, hPre_q⟩⟩
  · rw [hj_Z_fac]
    exact Limits.pullback.lift_fst _ _ _
  · rw [hj_Z_fac]
    exact Limits.pullback.lift_snd _ _ _

theorem weil_odp_qdeg_commRing_proj_proper_and_linear_slice_pullback (k : Type u) [Field k] (M : ℕ) :
    let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) k
    letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
    (∀ (R : Type u) [CommRing R] (N : ℕ),
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom) ∧
    ∃ Ψ_fam : (weilProjectiveSpaceOver (Polynomial k) M).left ⟶
        (weilProjectiveSpaceOver k (M + 1)).left,
      Ψ_fam ≫ (weilProjectiveSpaceOver k (M + 1)).hom =
        (weilProjectiveSpaceOver (Polynomial k) M).hom ≫ (weilPolyLineSpecOver k).hom ∧
      (∀ (R : Type u) [CommRing R] (γ : Polynomial k →+* R),
        let c_R : k →+* R := γ.comp Polynomial.C
        let t_R : R := γ Polynomial.X
        let ℬ_R := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R
        letI : GradedAlgebra ℬ_R := MvPolynomial.gradedAlgebra
        let v_R : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) R :=
          Fin.cases (-MvPolynomial.C t_R * MvPolynomial.X 0)
            (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))
        let ψ_R : MvPolynomial (Fin (M + 1 + 1)) k →+* MvPolynomial (Fin (M + 1)) R :=
          MvPolynomial.eval₂Hom (MvPolynomial.C.comp c_R) v_R
        ∃ π_PR : (weilProjectiveSpaceOver R M).left ⟶
            (weilProjectiveSpaceOver (Polynomial k) M).left,
          CategoryTheory.IsPullback π_PR (weilProjectiveSpaceOver R M).hom
            (weilProjectiveSpaceOver (Polynomial k) M).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)) ∧
          (TopologicalSpace.Opens.map (π_PR ≫ Ψ_fam).base).obj
            (weilProjBasicOpen k (M + 1) 1) = weilProjBasicOpen R M 0 ∧
          (∀ a : Fin M,
            (TopologicalSpace.Opens.map (π_PR ≫ Ψ_fam).base).obj
              (weilProjBasicOpen k (M + 1) a.succ.succ) = weilProjBasicOpen R M a.succ) ∧
          (∃ φ₀ : HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X 1) →+*
              HomogeneousLocalization.Away ℬ_R (MvPolynomial.X 0),
            AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X 0)
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 0))
              zero_lt_one ≫ (π_PR ≫ Ψ_fam) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X 1)
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k 1))
                  zero_lt_one ∧
            ∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) k)
              (hx : x ∈ 𝒜_k (n • 1)) (hgx : ψ_R x ∈ ℬ_R (n • 1)),
              φ₀ (HomogeneousLocalization.Away.mk 𝒜_k
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k 1))
                n x hx) =
              HomogeneousLocalization.Away.mk ℬ_R
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 0))
                n (ψ_R x) hgx) ∧
          (∀ a : Fin M,
            ∃ φ_a : HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X a.succ.succ) →+*
                HomogeneousLocalization.Away ℬ_R (MvPolynomial.X a.succ),
              AlgebraicGeometry.Proj.awayι ℬ_R (MvPolynomial.X a.succ)
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                  (MvPolynomial.isHomogeneous_X R a.succ)) zero_lt_one ≫ (π_PR ≫ Ψ_fam) =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a) ≫
                  AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X a.succ.succ)
                    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                      (MvPolynomial.isHomogeneous_X k a.succ.succ)) zero_lt_one ∧
              ∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) k)
                (hx : x ∈ 𝒜_k (n • 1)) (hgx : ψ_R x ∈ ℬ_R (n • 1)),
                φ_a (HomogeneousLocalization.Away.mk 𝒜_k
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
