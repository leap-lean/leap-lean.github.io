      apply RingHom.ext
      intro z
      rw [RingHom.comp_apply, RingHom.id_apply]
      obtain ⟨n, G, hG, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX μ) z
      rw [hφ_mk n G hG, HomogeneousLocalization.ext_iff_val]
      let L_μ := Localization (Submonoid.powers (MvPolynomial.X μ : A_amb))
      let u_μ : L_μ := algebraMap A_amb L_μ (MvPolynomial.X μ)
      have hu_μ : IsUnit (u_μ ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X μ : A_amb)).pow n
      apply hu_μ.mul_left_cancel
      have hrhs : u_μ ^ n * (HomogeneousLocalization.Away.mk 𝒜 (hX μ) n G hG).val =
