        have hnat : L_mod.obj.map τ_hom.op ≫ f.hom.app (Opposite.op (Sigma_h.obj T_U)) =
            f.hom.app (Opposite.op U_et) ≫ 𝒢.obj.map τ_hom.op :=
          f.hom.naturality τ_hom.op
