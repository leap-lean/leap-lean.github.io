        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst j (g' a ≫ w'))
          (CategoryTheory.Limits.pullback.snd j (g' a ≫ w') ≫ g' a)
          (by rw [CategoryTheory.Limits.pullback.condition, Category.assoc])
      obtain ⟨q_a, hq_a⟩ := hPullEx h_a ℓ 1
      obtain ⟨r_a, hr_a⟩ := hPullEx (CategoryTheory.Limits.pullback.fst j (g' a ≫ w')) ℓ 1
      let f_ua : CategoryTheory.Limits.pullback (g' a ≫ w') j ⟶
