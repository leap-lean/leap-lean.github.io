        have h_left_id : CommRingCat.ofHom (algebraMap K (R_b b)) ≫ r_inv_cat = 𝟙 _ := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, hr_map, ← hg_iso_hom, g_iso.inv_hom_id,
