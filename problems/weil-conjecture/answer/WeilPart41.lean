  have hAbelianImageSES : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] {A B : 𝒞} (f : Quiver.Hom A B),
      ∃ h0₁ : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) = 0,
        (CategoryTheory.ShortComplex.mk
          (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) h0₁).ShortExact := by
    intro 𝒞 _ _ A B f
    have h0₁ : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) = 0 := by
      rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι f),
        CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
        CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    refine ⟨h0₁, ?_⟩
    let SC₁ := CategoryTheory.ShortComplex.mk
      (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) h0₁
    let e := CategoryTheory.Abelian.coimageIsoImage' f
    have hfac : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.factorThruImage f) e.inv =
        CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι f) :=
      CategoryTheory.Abelian.factorThruImage_comp_coimageIsoImage'_inv f
    let cf₁ := CategoryTheory.Limits.CokernelCofork.ofπ
      (CategoryTheory.Limits.factorThruImage f) h0₁
    have hColim₁ : CategoryTheory.Limits.IsColimit cf₁ :=
      CategoryTheory.Limits.Cofork.IsColimit.mk cf₁
        (fun c => CategoryTheory.CategoryStruct.comp e.inv
          (CategoryTheory.Limits.cokernel.desc (CategoryTheory.Limits.kernel.ι f) c.π
            (c.condition.trans CategoryTheory.Limits.zero_comp)))
        (fun c => by
          change CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.factorThruImage f)
            (CategoryTheory.CategoryStruct.comp e.inv _) = c.π
          rw [← CategoryTheory.Category.assoc, hfac, CategoryTheory.Limits.cokernel.π_desc])
        (fun c m hm => by
          apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage f)).mp
          refine hm.trans ?_
          symm
          change CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.factorThruImage f)
            (CategoryTheory.CategoryStruct.comp e.inv _) = c.π
          rw [← CategoryTheory.Category.assoc, hfac, CategoryTheory.Limits.cokernel.π_desc])
    exact CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₁ hColim₁)
      inferInstance inferInstance

  have hKerImgTors : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] {A : 𝒞} {t : ℕ}
      (ht : (ℓ ^ (t + 1)) • CategoryTheory.CategoryStruct.id A = 0),
      let φ : Quiver.Hom A A := ℓ • CategoryTheory.CategoryStruct.id A
      ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel φ) = 0 ∧
      (ℓ ^ t) • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.image φ) = 0 := by
    intro 𝒞 _ _ A t ht φ
    refine ⟨?_, ?_⟩
    · apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
      calc (ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel φ)) ≫
            CategoryTheory.Limits.kernel.ι φ
          = ℓ • (CategoryTheory.CategoryStruct.id _ ≫ CategoryTheory.Limits.kernel.ι φ) :=
            CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = ℓ • (CategoryTheory.Limits.kernel.ι φ ≫ CategoryTheory.CategoryStruct.id A) := by
            rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
        _ = CategoryTheory.Limits.kernel.ι φ ≫ φ :=
            (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = 0 ≫ CategoryTheory.Limits.kernel.ι φ := by
            rw [CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    · apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage φ)).mp
      apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
      calc (CategoryTheory.Limits.factorThruImage φ ≫
            ((ℓ ^ t) • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.image φ))) ≫
            CategoryTheory.Limits.image.ι φ
          = ((ℓ ^ t) • (CategoryTheory.Limits.factorThruImage φ ≫
              CategoryTheory.CategoryStruct.id _)) ≫ CategoryTheory.Limits.image.ι φ := by
            rw [CategoryTheory.Preadditive.comp_nsmul]
        _ = (ℓ ^ t) • (CategoryTheory.Limits.factorThruImage φ ≫
              CategoryTheory.Limits.image.ι φ) := by
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Preadditive.nsmul_comp]
        _ = (ℓ ^ t) • φ := by rw [CategoryTheory.Limits.image.fac]
        _ = (ℓ * (ℓ ^ t)) • CategoryTheory.CategoryStruct.id A :=
            (mul_nsmul (CategoryTheory.CategoryStruct.id A) ℓ (ℓ ^ t)).symm
        _ = (ℓ ^ (t + 1)) • CategoryTheory.CategoryStruct.id A := by rw [← pow_succ']
        _ = (CategoryTheory.Limits.factorThruImage φ ≫ 0) ≫
              CategoryTheory.Limits.image.ι φ := by
            rw [ht, CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]

  have hEmptyHDI : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} [hEmp : IsEmpty ↥W₁]
      (h : W₁ ⟶ W₂)
      (F₀ : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h q F₀) := by
    intro W₁ W₂ hEmp h F₀ q
    have hIdF₀ : CategoryTheory.CategoryStruct.id F₀ = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opE
      apply AddCommGrpCat.ext
      intro sec
      let E : W₁.Etale := opE.unop
      have hEmpE : IsEmpty ↥E.left := ⟨fun y => hEmp.elim (E.hom.base y)⟩
      have hBot : (⊥ : CategoryTheory.Sieve E) ∈ W₁.smallEtaleTopology E :=
        (hMemEt E ⊥).mpr (fun y => hEmpE.elim y)
      exact F₀.isSeparated E ⊥ hBot sec 0 (fun _ _ hg => False.elim hg)
    let B_h : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let P_pre : CategoryTheory.Functor (Opposite W₂.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B_h.op (CategoryTheory.Sheaf.cohomologyPresheaf F₀ q)
    have hZ_pre : CategoryTheory.Limits.IsZero P_pre := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.NatTrans.ext
      funext opV
      apply AddCommGrpCat.ext
      intro α
      let α' : CategoryTheory.Abelian.Ext _ F₀ q := α
      change α' = 0
      calc α' = α'.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F₀))
              (Nat.add_zero q) := (CategoryTheory.Abelian.Ext.comp_mk₀_id α').symm
        _ = α'.comp (CategoryTheory.Abelian.Ext.mk₀ 0) (Nat.add_zero q) := by rw [hIdF₀]
        _ = 0 := by
            rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    exact (CategoryTheory.presheafToSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
      hZ_pre

  have hCohSandwich : ∀ (p : ℕ)
      {SC_M : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u})}
      (_ : SC_M.ShortExact),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage x₀ p SC_M.X₁) →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage x₀ p SC_M.X₃) →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage x₀ p SC_M.X₂) := by
    intro p SC_M hSE_M hZ₁ hZ₃
    let B : CategoryTheory.Functor X.Etale S_k.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ x₀
    let L_X := CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let F_coh := CategoryTheory.Sheaf.cohomologyPresheafFunctor S_k.smallEtaleTopology p
    let P₁ := B.op ⋙ SC_M.X₁.cohomologyPresheaf p
    let P := B.op ⋙ SC_M.X₂.cohomologyPresheaf p
    let P₂ := B.op ⋙ SC_M.X₃.cohomologyPresheaf p
    let f_P : P₁ ⟶ P := CategoryTheory.Functor.whiskerLeft B.op (F_coh.map SC_M.f)
    let g_P : P ⟶ P₂ := CategoryTheory.Functor.whiskerLeft B.op (F_coh.map SC_M.g)
    have hfg : f_P ≫ g_P = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.ext
      intro x
      let x' : CategoryTheory.Abelian.Ext _ SC_M.X₁ p := x
      change (x'.comp (CategoryTheory.Abelian.Ext.mk₀ SC_M.f) (Nat.add_zero p)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC_M.g) (Nat.add_zero p) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero p) (Nat.add_zero 0)
          (Nat.add_zero p),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, SC_M.zero,
        CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    have hExObj : ∀ (W : (X.Etale)ᵒᵖ) (y : P.obj W),
        (g_P.app W) y = 0 → ∃ x : P₁.obj W, (f_P.app W) x = y := by
      intro W y hy0
      let y' : CategoryTheory.Abelian.Ext _ SC_M.X₂ p := y
      have hy' : y'.comp (CategoryTheory.Abelian.Ext.mk₀ SC_M.g) (Nat.add_zero p) = 0 := hy0
      obtain ⟨x', hx'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ _ hSE_M y' hy'
      exact ⟨x', hx'⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}
    let _ : CategoryTheory.Limits.PreservesFiniteColimits L_X :=
      (CategoryTheory.Adjunction.leftAdjoint_preservesColimits.{0, 0} adj_sh).preservesFiniteColimits
    let _ : L_X.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products L_X
    let SC_P := CategoryTheory.ShortComplex.mk f_P g_P hfg
    have hEx_P : SC_P.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_of_forks SC_P
        (CategoryTheory.Limits.kernelIsKernel g_P)
        (CategoryTheory.Limits.cokernelIsCokernel f_P)]
      apply CategoryTheory.NatTrans.ext
      funext W
      change (CategoryTheory.Limits.kernel.ι g_P).app W ≫
          (CategoryTheory.Limits.cokernel.π f_P).app W = 0
      let evW := (CategoryTheory.evaluation (X.Etale)ᵒᵖ AddCommGrpCat.{u}).obj W
      let e_ker : evW.obj (CategoryTheory.Limits.kernel g_P) ≅
          CategoryTheory.Limits.kernel (g_P.app W) :=
        CategoryTheory.Limits.PreservesKernel.iso evW g_P
      let e_cok : evW.obj (CategoryTheory.Limits.cokernel f_P) ≅
          CategoryTheory.Limits.cokernel (f_P.app W) :=
        CategoryTheory.Limits.PreservesCokernel.iso evW f_P
      have h_ker_comp : e_ker.inv ≫ (CategoryTheory.Limits.kernel.ι g_P).app W =
          CategoryTheory.Limits.kernel.ι (g_P.app W) :=
        CategoryTheory.Limits.PreservesKernel.iso_inv_ι evW g_P
      have h_cok_comp : (CategoryTheory.Limits.cokernel.π f_P).app W ≫ e_cok.hom =
          CategoryTheory.Limits.cokernel.π (f_P.app W) :=
        CategoryTheory.Limits.PreservesCokernel.π_iso_hom evW f_P
      suffices hmid : CategoryTheory.Limits.kernel.ι (g_P.app W) ≫
          CategoryTheory.Limits.cokernel.π (f_P.app W) = 0 by
        have h1 := congrArg (fun m => e_ker.hom ≫ m ≫ e_cok.inv) hmid
        rw [← h_ker_comp, ← h_cok_comp] at h1
        simpa only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
          CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp] using h1
      apply AddCommGrpCat.ext
      intro ker_el
      have hk0 : (g_P.app W) ((CategoryTheory.Limits.kernel.ι (g_P.app W)) ker_el) = 0 := by
        change (CategoryTheory.Limits.kernel.ι (g_P.app W) ≫ g_P.app W) ker_el = 0
        rw [CategoryTheory.Limits.kernel.condition]
        rfl
      obtain ⟨x, hx⟩ := hExObj W ((CategoryTheory.Limits.kernel.ι (g_P.app W)) ker_el) hk0
      change (CategoryTheory.Limits.cokernel.π (f_P.app W))
          ((CategoryTheory.Limits.kernel.ι (g_P.app W)) ker_el) = 0
      rw [← hx]
      change (f_P.app W ≫ CategoryTheory.Limits.cokernel.π (f_P.app W)) x = 0
      rw [CategoryTheory.Limits.cokernel.condition]
      rfl
    have hEx_L : (SC_P.map L_X).Exact := hEx_P.map L_X
    let SC' := SC_P.map L_X
    have hf'0 : SC'.f = 0 := hZ₁.eq_of_src _ _
    have hg'0 : SC'.g = 0 := hZ₃.eq_of_tgt _ _
    let cg' : CategoryTheory.Limits.KernelFork SC'.g :=
      CategoryTheory.Limits.KernelFork.ofι (𝟙 SC'.X₂)
        (by rw [hg'0, CategoryTheory.Limits.comp_zero])
    have hLim_cg' : CategoryTheory.Limits.IsLimit cg' :=
      CategoryTheory.Limits.Fork.IsLimit.mk cg'
        (fun c => c.ι)
        (fun c => CategoryTheory.Category.comp_id c.ι)
        (fun c m hm => (CategoryTheory.Category.comp_id m).symm.trans hm)
    let cf' : CategoryTheory.Limits.CokernelCofork SC'.f :=
      CategoryTheory.Limits.CokernelCofork.ofπ (𝟙 SC'.X₂)
        (by rw [hf'0, CategoryTheory.Limits.zero_comp])
    have hColim_cf' : CategoryTheory.Limits.IsColimit cf' :=
      CategoryTheory.Limits.Cofork.IsColimit.mk cf'
        (fun c => c.π)
        (fun c => CategoryTheory.Category.id_comp c.π)
        (fun c m hm => (CategoryTheory.Category.id_comp m).symm.trans hm)
    have hId0 : CategoryTheory.Limits.Fork.ι cg' ≫ CategoryTheory.Limits.Cofork.π cf' = 0 :=
      (CategoryTheory.ShortComplex.exact_iff_of_forks SC' hLim_cg' hColim_cf').mp hEx_L
    change 𝟙 (weilEtaleHigherDirectImage x₀ p SC_M.X₂) ≫
        𝟙 (weilEtaleHigherDirectImage x₀ p SC_M.X₂) = 0 at hId0
    rw [CategoryTheory.Category.id_comp] at hId0
    exact (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mpr hId0

  have hR_prime : ∀ (M : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id M = 0 →
      ∀ (p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage x₀ p M) := by
    intro M hℓM p hp
    apply weil_etale_geometric_point_stalk_conservativity X
      (weilEtaleHigherDirectImage x₀ p M)
    intro Ω _ _ y
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    rcases hDichot Ω y with ⟨_, _, hEmp⟩ | ⟨u, _, hpb_u⟩
    · have _ : IsEmpty ↥(CategoryTheory.Limits.pullback x₀ y) := hEmp
      let g' := CategoryTheory.Limits.pullback.fst x₀ y
      let f' := CategoryTheory.Limits.pullback.snd x₀ y
      obtain ⟨M', hPB_M', _, _⟩ := hExPB g' M
      have hPB_p : WeilIsEtaleSheafPullback y
          (weilEtaleHigherDirectImage x₀ p M) (weilEtaleHigherDirectImage f' p M') :=
        hExtract x₀ y f' g' hPBC_x0 (CategoryTheory.IsPullback.of_hasPullback x₀ y)
          M M' hℓM hPB_M' p
      exact ⟨weilEtaleHigherDirectImage f' p M', hPB_p, hEmptyHDI f' M' p⟩
    · obtain ⟨M_u, hPB_Mu, _, _⟩ := hExPB u M
      have hPB_p : WeilIsEtaleSheafPullback y
          (weilEtaleHigherDirectImage x₀ p M)
          (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id S_Ω) p M_u) :=
        hExtract x₀ y (CategoryTheory.CategoryStruct.id S_Ω) u hPBC_x0 hpb_u
          M M_u hℓM hPB_Mu p
      exact ⟨weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id S_Ω) p M_u,
        hPB_p, hIdHDI0 S_Ω M_u p hp⟩

  have hR_tors : ∀ (t : ℕ) (M : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      (ℓ ^ t) • CategoryTheory.CategoryStruct.id M = 0 →
      ∀ (p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage x₀ p M) := by
    intro t
    induction t with
    | zero =>
      intro M hM0 p hp
      rw [pow_zero, one_nsmul] at hM0
      have hℓM : ℓ • CategoryTheory.CategoryStruct.id M = 0 := by rw [hM0, nsmul_zero]
      exact hR_prime M hℓM p hp
    | succ t ih =>
      intro M hMt p hp
      let φ : Quiver.Hom M M := ℓ • CategoryTheory.CategoryStruct.id M
      obtain ⟨h0_M, hSE_M⟩ := hAbelianImageSES φ
      obtain ⟨hℓM₁, htM₂⟩ := hKerImgTors hMt
      exact hCohSandwich p hSE_M
        (hR_prime (CategoryTheory.Limits.kernel φ) hℓM₁ p hp)
        (ih (CategoryTheory.Limits.image φ) htM₂ p hp)

  have hCounitIso : ∀ (M : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id M = 0 →
      CategoryTheory.IsIso (adj_x0.counit.app M) := by
    intro M hℓM
    obtain ⟨hc_f', hc_g', hc_id', hc_id'', hr_g', hr_id'', hBC0, _⟩ :=
      hPBC_x0 S_k S_k x₀ (CategoryTheory.CategoryStruct.id S_k)
        (CategoryTheory.CategoryStruct.id S_k) hpb_self
    obtain rfl : hc_f' = @hc_all S_k X x₀ := Subsingleton.elim _ _
    obtain rfl : hc_g' = @hc_all S_k X x₀ := Subsingleton.elim _ _
    obtain rfl : hc_id' = @hc_all S_k S_k (CategoryTheory.CategoryStruct.id S_k) :=
      Subsingleton.elim _ _
    obtain rfl : hc_id'' = @hc_all S_k S_k (CategoryTheory.CategoryStruct.id S_k) :=
      Subsingleton.elim _ _
    obtain rfl : hr_g' = @hr_all S_k X x₀ := Subsingleton.elim _ _
    obtain rfl : hr_id'' = @hr_all S_k S_k (CategoryTheory.CategoryStruct.id S_k) :=
      Subsingleton.elim _ _
    let B_id : CategoryTheory.Functor S_k.Etale S_k.Etale :=
      weilEtaleSitePullback (CategoryTheory.CategoryStruct.id S_k)
    let pf_id := B_id.sheafPushforwardContinuous AddCommGrpCat.{u}
      S_k.smallEtaleTopology S_k.smallEtaleTopology
    let pb_id := B_id.sheafPullback AddCommGrpCat.{u}
      S_k.smallEtaleTopology S_k.smallEtaleTopology
    let adj_id := B_id.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S_k.smallEtaleTopology S_k.smallEtaleTopology
    let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_x0 B_id)
        (CategoryTheory.Functor.comp B_x0 B_id) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.Iso.symm
          (CategoryTheory.MorphismProperty.Over.pullbackComp
            (CategoryTheory.CategoryStruct.id S_k) x₀))
        (CategoryTheory.Iso.trans
          (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb_self.w)
          (CategoryTheory.MorphismProperty.Over.pullbackComp
            (CategoryTheory.CategoryStruct.id S_k) x₀))
