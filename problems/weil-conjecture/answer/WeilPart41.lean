  have hHens_Vs : HenselianLocalRing ↥V_s := by
    refine HenselianLocalRing.mk fun f hf_monic a₀ hf_a₀ _ => ?_
    let f_Ω : Polynomial Ω := f.map V_s.subtype
    have hfΩ_monic : f_Ω.Monic := hf_monic.map V_s.subtype
    have hfΩ_splits : f_Ω.Splits := IsAlgClosed.splits f_Ω
    have hfΩ_prod : f_Ω = (f_Ω.roots.map (fun r₀ => Polynomial.X - Polynomial.C r₀)).prod :=
      hfΩ_splits.eq_prod_roots_of_monic hfΩ_monic
    have hroot_mem : ∀ r₀ ∈ f_Ω.roots, r₀ ∈ V_s := by
      intro r₀ hr₀
      have h0 : Polynomial.eval r₀ f_Ω = 0 := (Polynomial.mem_roots hfΩ_monic.ne_zero).mp hr₀
      rcases V_s.mem_or_inv_mem r₀ with hr_in | hrinv_in
      · exact hr_in
      · by_cases hr0 : r₀ = 0
        · rw [hr0]; exact V_s.zero_mem
        · set d := f.natDegree
          have hd_eq : f_Ω.natDegree = d := hf_monic.natDegree_map V_s.subtype
          have hd_pos : 1 ≤ d := by
            by_contra h_le
            have hd0 : f_Ω.natDegree = 0 := by omega
            rw [Polynomial.eq_one_of_monic_natDegree_zero hfΩ_monic hd0, Polynomial.eval_one] at h0
            exact one_ne_zero h0
          have hsum : ∑ i ∈ Finset.range (d + 1), V_s.subtype (f.coeff i) * r₀ ^ i = 0 := by
            rw [← Polynomial.eval₂_eq_sum_range, ← Polynomial.eval_map]
            exact h0
          have hcd : f.coeff d = 1 := hf_monic.coeff_natDegree
          rw [Finset.sum_range_succ, hcd, map_one, one_mul] at hsum
          have hr_pow : r₀ ^ d * (r₀⁻¹) ^ (d - 1) = r₀ := by
            have hexp : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
            conv_lhs => rw [hexp, pow_succ]
            calc r₀ ^ (d - 1) * r₀ * (r₀⁻¹) ^ (d - 1)
                = (r₀ * r₀⁻¹) ^ (d - 1) * r₀ := by rw [mul_pow]; ring
              _ = r₀ := by rw [mul_inv_cancel₀ hr0, one_pow, one_mul]
          have hr_eq : r₀ = - ∑ i ∈ Finset.range d,
              V_s.subtype (f.coeff i) * (r₀⁻¹) ^ (d - 1 - i) := by
            have hmul : (r₀ ^ d) * (r₀⁻¹) ^ (d - 1) =
                (-(∑ i ∈ Finset.range d, V_s.subtype (f.coeff i) * r₀ ^ i)) * (r₀⁻¹) ^ (d - 1) :=
              congrArg (· * (r₀⁻¹) ^ (d - 1)) (eq_neg_of_add_eq_zero_right hsum)
            rw [hr_pow, neg_mul, Finset.sum_mul] at hmul
            conv_lhs => rw [hmul]
            congr 1
            refine Finset.sum_congr rfl fun i hi => ?_
            rw [Finset.mem_range] at hi
            have hexp : d - 1 = i + (d - 1 - i) := (Nat.add_sub_of_le (by omega)).symm
            calc V_s.subtype (f.coeff i) * r₀ ^ i * (r₀⁻¹) ^ (d - 1)
                = V_s.subtype (f.coeff i) * (r₀ ^ i * ((r₀⁻¹) ^ i * (r₀⁻¹) ^ (d - 1 - i))) := by
                    conv_lhs => rw [hexp, pow_add]
                    ring
              _ = V_s.subtype (f.coeff i) * ((r₀ * r₀⁻¹) ^ i * (r₀⁻¹) ^ (d - 1 - i)) := by
                    rw [mul_pow, ← mul_assoc (r₀ ^ i)]
              _ = V_s.subtype (f.coeff i) * (r₀⁻¹) ^ (d - 1 - i) := by
                    rw [mul_inv_cancel₀ hr0, one_pow, one_mul]
          rw [hr_eq]
          exact V_s.toSubring.neg_mem (V_s.toSubring.sum_mem fun i _ =>
            V_s.toSubring.mul_mem (f.coeff i).2 (V_s.toSubring.pow_mem hrinv_in _))
    let M_V : Multiset ↥V_s := f_Ω.roots.pmap (fun r₀ hr₀ => ⟨r₀, hr₀⟩) hroot_mem
    have hpmap_lin : ∀ (S : Multiset Ω) (hS : ∀ r₀ ∈ S, r₀ ∈ V_s),
        ((S.pmap (fun r₀ hr₀ => (⟨r₀, hr₀⟩ : ↥V_s)) hS).map
          (fun r₀ : ↥V_s => (Polynomial.X - Polynomial.C r₀).map V_s.subtype)) =
        S.map (fun r₀ => Polynomial.X - Polynomial.C r₀) := by
      intro S
      induction S using Multiset.induction_on with
      | empty => intro _; rfl
      | cons a S ih =>
        intro hS
        rw [Multiset.pmap_cons, Multiset.map_cons, Multiset.map_cons]
        congr 1
        · simp [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
        · exact ih fun r₀ hr₀ => hS r₀ (Multiset.mem_cons_of_mem hr₀)
    have hf_eq : f = (M_V.map (fun r₀ => Polynomial.X - Polynomial.C r₀)).prod := by
      apply Polynomial.map_injective V_s.subtype V_s.subtype_injective
      change f_Ω = _
      rw [hfΩ_prod, Polynomial.map_multiset_prod, Multiset.map_map]
      exact congrArg Multiset.prod (hpmap_lin f_Ω.roots hroot_mem).symm
    have hprod_mem : (M_V.map (fun r₀ => a₀ - r₀)).prod ∈ IsLocalRing.maximalIdeal ↥V_s := by
      have hev : Polynomial.eval a₀ f = (M_V.map (fun r₀ => a₀ - r₀)).prod := by
        conv_lhs => rw [hf_eq]
        rw [Polynomial.eval_multiset_prod, Multiset.map_map]
        simp
      rwa [← hev]
    rcases ((IsLocalRing.maximalIdeal.isMaximal ↥V_s).isPrime.multiset_prod_mem_iff_exists_mem _).mp
        hprod_mem with ⟨x_m, hx_m, hx_mem⟩
    obtain ⟨r₀, hr₀_M, rfl⟩ := Multiset.mem_map.mp hx_m
    refine ⟨r₀, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def, hf_eq, Polynomial.eval_multiset_prod]
      apply Multiset.prod_eq_zero
      rw [Multiset.mem_map]
      refine ⟨Polynomial.X - Polynomial.C r₀, Multiset.mem_map.mpr ⟨r₀, hr₀_M, rfl⟩, by simp⟩
    · have hneg : r₀ - a₀ = -(a₀ - r₀) := by ring
      rw [hneg]
      exact (IsLocalRing.maximalIdeal ↥V_s).neg_mem hx_mem

