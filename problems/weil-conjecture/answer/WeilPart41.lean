theorem weil_odp_wit_geom_generic_stalk_equivariance (F : Type u) [Finite F] [Field F]
    (q_deg ℓ N r c_iso : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal }) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (heU_eq : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff)
      (B_r L_r : Type u)
      [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r]
      [Algebra (RatFunc F) L_r] [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      (ρ_r : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
      (𝒱_r : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (triv_r : ∀ W : U₀.toScheme.Etale,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑(𝒱_r.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_r (Fin N → ZMod (ℓ ^ (r + 1))))
      (_htriv_r :
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        let A_r : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (Fin N → ZMod (ℓ ^ (r + 1))))
        WeilIsEtaleSheafPullback π_r 𝒱_r
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑(𝒱_r.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv_r W₁ ((𝒱_r.obj.map (Opposite.op u)) s) y₁ =
                triv_r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          Function.Injective (triv_r W) ∧
          Set.range (triv_r W) =
            { f | ∀ (σ : B_r ≃ₐ[R₀] B_r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_r σ).val).mulVec (f y) })
      (α_r : Quiver.Hom 𝒱_r (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q_deg r))
      (β_r : Quiver.Hom (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q_deg r) 𝒱_r)
      (hβα_r : CategoryTheory.CategoryStruct.comp α_r β_r =
        (ℓ ^ c_iso) • CategoryTheory.CategoryStruct.id 𝒱_r)
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (ι_B : B_r →+* Ω)
      (η_D : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left)
      (hη_D : η_D =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r)) ≫
          e_U.hom ≫ U₀.ι),
      let Z_Ω := CategoryTheory.Limits.pullback f₀.left η_D
      ∃ (α_Ω : (Fin N → ZMod (ℓ ^ (r + 1))) →+ weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) q_deg)
        (β_Ω : weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) q_deg →+ (Fin N → ZMod (ℓ ^ (r + 1)))),
        (∀ v : Fin N → ZMod (ℓ ^ (r + 1)), β_Ω (α_Ω v) = (ℓ ^ c_iso) • v) ∧
        ∀ (γ : Ω ≃+* Ω) (σ_B : B_r ≃ₐ[R₀] B_r),
          (∀ b : B_r, γ (ι_B b) = ι_B (σ_B b)) →
          ∀ (τ_Z : Z_Ω ⟶ Z_Ω),
            τ_Z ≫ CategoryTheory.Limits.pullback.fst f₀.left η_D =
              CategoryTheory.Limits.pullback.fst f₀.left η_D →
            τ_Z ≫ CategoryTheory.Limits.pullback.snd f₀.left η_D =
              CategoryTheory.Limits.pullback.snd f₀.left η_D ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) →
            ∃ p_τ : weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) q_deg →+
                weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) q_deg,
              WeilIsTorsionEtalePullback τ_Z (ℓ ^ (r + 1)) q_deg p_τ ∧
              ∀ v : Fin N → ZMod (ℓ ^ (r + 1)),
                p_τ (α_Ω v) = α_Ω (((ρ_r σ_B).val).mulVec v) :=
by
  intro R₀ e_U heU_eq B_r L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    ρ_r 𝒱_r triv_r _htriv_r α_r β_r hβα_r Ω _ _ ι_B η_D hη_D Z_Ω
  
  have hTermStd : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) trivial) ?_
    intro W m
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hw : m.left ≫ 𝟙 S = W.hom := CategoryTheory.MorphismProperty.Over.w m
    exact (CategoryTheory.Category.comp_id m.left).symm.trans hw

  
  let m_mod : ℕ := ℓ ^ (r + 1)
  let D₀ := weilProjectiveSpaceOver F 1
  let X₀_open : Z_tilde.left.Opens := f₀.left ⁻¹ᵁ U₀
  let X₀ : AlgebraicGeometry.Scheme.{u} := X₀_open.toScheme
  let j_X : X₀ ⟶ Z_tilde.left := X₀_open.ι
  let g₀ : X₀ ⟶ U₀.toScheme := f₀.left ∣_ U₀
  let V_r : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B_r)
  let π_r : V_r ⟶ U₀.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r)) ≫ e_U.hom
  let S_Ω : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let η_V : S_Ω ⟶ V_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
  let η_U : S_Ω ⟶ U₀.toScheme := η_V ≫ π_r
  have hη_D_fac : η_D = η_U ≫ U₀.ι := by
    dsimp only [η_U, η_V, π_r]
    rw [hη_D]
    simp only [CategoryTheory.Category.assoc]

  let p_Z1 : Z_Ω ⟶ Z_tilde.left := CategoryTheory.Limits.pullback.fst f₀.left η_D
  let f'_Ω : Z_Ω ⟶ S_Ω := CategoryTheory.Limits.pullback.snd f₀.left η_D
  have hpb_res : CategoryTheory.IsPullback g₀ j_X U₀.ι f₀.left :=
    AlgebraicGeometry.isPullback_morphismRestrict f₀.left U₀
  have hpb_res_flip : CategoryTheory.IsPullback j_X g₀ f₀.left U₀.ι := hpb_res.flip
  have hg'_comm : p_Z1 ≫ f₀.left = (f'_Ω ≫ η_U) ≫ U₀.ι := by
    rw [CategoryTheory.Category.assoc, ← hη_D_fac]
    exact CategoryTheory.Limits.pullback.condition
  let g'_Ω : Z_Ω ⟶ X₀ := hpb_res_flip.lift p_Z1 (f'_Ω ≫ η_U) hg'_comm
  have hg'_jX : g'_Ω ≫ j_X = p_Z1 := hpb_res_flip.lift_fst p_Z1 (f'_Ω ≫ η_U) hg'_comm
  have hgf_Ω : g'_Ω ≫ g₀ = f'_Ω ≫ η_U := hpb_res_flip.lift_snd p_Z1 (f'_Ω ≫ η_U) hg'_comm
  have hpb_Ω : CategoryTheory.IsPullback g'_Ω f'_Ω g₀ η_U := by
    have hpb_outer : CategoryTheory.IsPullback (g'_Ω ≫ j_X) f'_Ω f₀.left (η_U ≫ U₀.ι) := by
      rw [hg'_jX, ← hη_D_fac]
      exact CategoryTheory.IsPullback.of_hasPullback f₀.left η_D
    exact CategoryTheory.IsPullback.of_right hpb_outer hgf_Ω hpb_res_flip

  let u_hom : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of F) := U₀.ι ≫ D₀.hom
  have hu_eq : e_U.hom ≫ u_hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R₀)) := by
    dsimp only [u_hom]
    rw [← CategoryTheory.Category.assoc, show e_U.hom ≫ U₀.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫ j_aff from
        heU_eq,
      CategoryTheory.Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]

  obtain ⟨N_proj, ι_Z, hCl_Z⟩ := hProj_Ztilde
  let _ : AlgebraicGeometry.IsClosedImmersion ι_Z.left := hCl_Z
  let P_N := weilProjectiveSpaceOver F N_proj
  have hγ_w : f₀.left ≫ D₀.hom = ι_Z.left ≫ P_N.hom := f₀.w.trans ι_Z.w.symm
  let γ_Z : Z_tilde.left ⟶ CategoryTheory.Limits.pullback D₀.hom P_N.hom :=
    CategoryTheory.Limits.pullback.lift f₀.left ι_Z.left hγ_w
  have hCl_γZ : AlgebraicGeometry.IsClosedImmersion γ_Z := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F) :=
      MvPolynomial.gradedAlgebra
    have _ : AlgebraicGeometry.IsSeparated D₀.hom := by
      dsimp [D₀, weilProjectiveSpaceOver]
