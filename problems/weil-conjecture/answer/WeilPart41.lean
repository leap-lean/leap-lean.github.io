      · have hμ_bound : 2 * j₀.1 + 3 ≤ μ.1 := by omega
        let i : Fin (2 * (m + 1)) := ⟨μ.1 - 1, by omega⟩
        have hile : a.succ ≤ i.castSucc := by
          change a.1 + 1 ≤ μ.1 - 1
          dsimp only [j₀] at hμ_bound
          omega
        have hμ_eq : μ = (a.succ).succAbove i := by
          rw [Fin.succAbove_of_le_castSucc a.succ i hile]
          exact Fin.ext (by dsimp only [Fin.val_succ, i]; omega)
        have hi_ne : i ≠ a_hat := by
