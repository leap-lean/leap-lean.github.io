    have hj_aff_pre_Q : j_aff_k.base ⁻¹' Set.range j_inf.base =
        { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) | Q ∉ p.asIdeal } := by
      ext p
      exact Set.ext_iff.mp hV_eq_Q p
    let ι_Q_sch := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away Q)))
    let ι_T_sch := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))))
    have hOpen_ιQ : AlgebraicGeometry.IsOpenImmersion ι_Q_sch :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization Q
    have hOpen_ιT : AlgebraicGeometry.IsOpenImmersion ι_T_sch :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial k)
    let g₁_ov := ι_Q_sch ≫ j_aff_k
    let g₂_ov := ι_T_sch ≫ j_inf
    have hOpen_g₁ : AlgebraicGeometry.IsOpenImmersion g₁_ov := inferInstance
    have hOpen_g₂ : AlgebraicGeometry.IsOpenImmersion g₂_ov := inferInstance
    have hRange_g₂_g₁ : Set.range g₂_ov.base = Set.range g₁_ov.base := by
      have hrQ : Set.range ι_Q_sch.base = j_aff_k.base ⁻¹' Set.range j_inf.base := by
