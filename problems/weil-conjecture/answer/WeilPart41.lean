        let Q'_R := CategoryTheory.Limits.pullback ι_k Ψ_R
        let p_sub := CategoryTheory.Limits.pullback.snd ι_k Ψ_R
        let p'_R := p_sub ≫ (weilProjectiveSpaceOver R M).hom
        let U'_0 : Q'_R.Opens :=
          (TopologicalSpace.Opens.map p_sub.base).obj (weilProjBasicOpen R M 0)
        let V'_R : Fin M → Q'_R.Opens :=
          fun a => (TopologicalSpace.Opens.map p_sub.base).obj (weilProjBasicOpen R M a.succ)
        let Q_ring_0 := HomogeneousLocalization.Away ℬ_R (MvPolynomial.X 0) ⧸
          Ideal.span {HomogeneousLocalization.Away.mk ℬ_R
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 0))
            d₀ (ψ_R F_k) hF_R}
