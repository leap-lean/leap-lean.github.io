    obtain ⟨s_x, x_pt, hs_x_hom, hx_pt_f₀, hx_pt_odp, hs_x_pt⟩ := hSec
    refine ⟨c_p, s_x, x_pt, hc_p_reg, hs_x_hom, hx_pt_f₀, hx_pt_odp, ?_, fun pt => ?_⟩
    · let X := (weilProjectiveSpaceOver F 2).left
