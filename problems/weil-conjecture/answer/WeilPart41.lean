            · intro j₀
              rw [show q_pre (MvPolynomial.X (Sum.inr (j₀.castSucc, b))) =
                Polynomial.C (Ideal.Quotient.mk (I_k n) (MvPolynomial.X (Sum.inr (j₀, b)))) by
                  simp [q_pre, q_var, Fin.lastCases_castSucc]]
              rw [show s_bar (Polynomial.C
                  (Ideal.Quotient.mk (I_k n) (MvPolynomial.X (Sum.inr (j₀, b))))) =
                s_pre (MvPolynomial.X (Sum.inr (j₀, b))) by simp [s_bar]; rfl]
              simp [s_pre]
      have hq_surj : Function.Surjective q_n := by
        intro y
        obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (s_bar y)
        refine ⟨x, ?_⟩
        calc
          q_n x = q_bar (mk_u x) := rfl
          _ = q_bar (s_bar y) := by rw [hx]
          _ = (q_bar.comp s_bar) y := rfl
          _ = y := RingHom.congr_fun hq_s y
      have hq_ker_eq : RingHom.ker q_n = J_u := by
        apply le_antisymm
        · intro x hx
          rw [RingHom.mem_ker] at hx
          have hx_bar : q_bar (mk_u x) = 0 := hx
          have hs0 : s_bar (q_bar (mk_u x)) = 0 := by rw [hx_bar, map_zero]
          have hmk0 : mk_u x = 0 := by
            have h := RingHom.congr_fun hs_q (mk_u x)
            simpa [RingHom.comp_apply, hs0] using h.symm
          exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
        · exact hJu_le
      let i_spec :
          AlgebraicGeometry.Spec
            (CommRingCat.of
              (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n))) ⟶
            (A_over (n + 1)).left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_n)
      haveI : AlgebraicGeometry.IsClosedImmersion i_spec :=
        @AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.of
            (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)))
          (CommRingCat.of
            (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n)))
          (CommRingCat.ofHom q_n) hq_surj
      let i_n : V_n ⟶ (A_over (n + 1)).left := (e_V n).inv ≫ i_spec
      have hi_cl : AlgebraicGeometry.IsClosedImmersion i_n :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsClosedImmersion) _ _
          (CategoryTheory.MorphismProperty.of_isIso (@AlgebraicGeometry.IsClosedImmersion)
            (e_V n).inv)
          inferInstance
      have hRange_i : Set.range i_n.base = (Set.range j_n.base)ᶜ := by
        have hRange_eV_surj : Function.Surjective (e_V n).inv.base := by
          intro x
          refine ⟨(e_V n).hom x, ?_⟩
          calc
            (e_V n).inv ((e_V n).hom x)
                = ((e_V n).hom ≫ (e_V n).inv) x :=
                  (AlgebraicGeometry.Scheme.Hom.comp_apply (e_V n).hom (e_V n).inv x).symm
            _ = (𝟙 _ :
                  AlgebraicGeometry.Spec
                    (CommRingCat.of
                      (Polynomial
                        (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n))) ⟶ _) x := by
                  rw [(e_V n).hom_inv_id]
            _ = x := rfl
        have hRange_in_eq : Set.range i_n.base = Set.range i_spec.base := by
          ext p
          constructor
          · rintro ⟨v, rfl⟩
            exact ⟨(e_V n).inv v,
              (AlgebraicGeometry.Scheme.Hom.comp_apply (e_V n).inv i_spec v).symm⟩
          · rintro ⟨x, rfl⟩
            obtain ⟨v, hv⟩ := hRange_eV_surj x
            refine ⟨v, ?_⟩
            calc
              i_n v = i_spec ((e_V n).inv v) :=
                AlgebraicGeometry.Scheme.Hom.comp_apply (e_V n).inv i_spec v
              _ = i_spec x := by rw [hv]
        have hRange_ispec : Set.range i_spec.base =
            PrimeSpectrum.zeroLocus
              ({u_bar_last} :
                Set (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1))) := by
          let q_hom :=
            (@CommRingCat.ofHom
              (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1))
              (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n)) _ _ q_n).hom
          change Set.range (PrimeSpectrum.comap q_hom) = _
          rw [range_comap_of_surjective _ q_hom hq_surj,
            show RingHom.ker q_hom = J_u from hq_ker_eq,
            PrimeSpectrum.zeroLocus_span]
        have hRange_jn : Set.range j_n.base =
            (PrimeSpectrum.basicOpen u_bar_last :
              Set (PrimeSpectrum
                (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)))) :=
          PrimeSpectrum.localization_away_comap_range (Localization.Away u_bar_last) u_bar_last
        have hZ_eq :
            (PrimeSpectrum.zeroLocus
              ({u_bar_last} :
                Set (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1))) :
              Set (PrimeSpectrum
                (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)))) =
            ((PrimeSpectrum.basicOpen u_bar_last :
              Set (PrimeSpectrum
                (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)))))ᶜ := by
          rw [PrimeSpectrum.basicOpen_eq_zeroLocus_compl, compl_compl]
        exact hRange_in_eq.trans
          (hRange_ispec.trans (hZ_eq.trans (congrArg compl hRange_jn.symm)))
      let ev_orig_pre : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω →+* Ω :=
        MvPolynomial.eval 0
      have hev_orig_ker : I_k (n + 1) ≤ RingHom.ker ev_orig_pre := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        simp [ev_orig_pre]
      let ev_orig :
          (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)) →+* Ω :=
        Ideal.Quotient.lift (I_k (n + 1)) ev_orig_pre (fun _ hx => hev_orig_ker hx)
      let y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (A_over (n + 1)).left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_orig)
      have hy₀_out : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          y₀.base pt ∉ Set.range j_n.base := by
        rintro pt ⟨z, hz⟩
        have hcomap : PrimeSpectrum.comap
            (algebraMap
              (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1))
              (Localization.Away u_bar_last)) z =
            PrimeSpectrum.comap ev_orig pt := hz
        have hu_mem : u_bar_last ∈ (PrimeSpectrum.comap ev_orig pt).asIdeal := by
          change ev_orig u_bar_last ∈ pt.asIdeal
          have hz0 : ev_orig u_bar_last = 0 := by
            simp [ev_orig, u_bar_last, ev_orig_pre]
          rw [hz0]
          exact pt.asIdeal.zero_mem
        rw [← hcomap] at hu_mem
        have hunit_mem :
            algebraMap
              (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1))
              (Localization.Away u_bar_last) u_bar_last ∈
            z.asIdeal := hu_mem
        exact z.isPrime.ne_top
          (z.asIdeal.eq_top_of_isUnit_mem hunit_mem
            (IsLocalization.Away.algebraMap_isUnit u_bar_last))
      exact ⟨i_n, hi_cl, y₀, hRange_i, hy₀_out⟩

  
  have hRings : ∀ n : ℕ,
      let R_succ := MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)
      let f_R : Ω →+* R_succ :=
        (Ideal.Quotient.mk (I_k (n + 1))).comp
          (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)
      let u_bar_last : R_succ :=
        Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inr (Fin.last n, 0)))
      let B_δ := MvPolynomial (Fin (2 * n + 1)) Ω
      ∃ (g_el c_bez : Fin (n + 2) → R_succ)
        (Φ : ∀ α : Fin (n + 2), Polynomial B_δ →+* Localization.Away (g_el α))
        (θ₀ : Localization.Away (Polynomial.X : Polynomial B_δ) ≃+*
          Localization.Away u_bar_last)
        (Φ₀_u : Polynomial B_δ →+* Localization.Away u_bar_last),
        (∀ p : Polynomial B_δ,
          θ₀ (algebraMap (Polynomial B_δ)
            (Localization.Away (Polynomial.X : Polynomial B_δ)) p) = Φ₀_u p) ∧
        ((Φ₀_u).comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
          (algebraMap R_succ (Localization.Away u_bar_last)).comp f_R) ∧
        (Φ₀_u Polynomial.X = algebraMap R_succ (Localization.Away u_bar_last) u_bar_last) ∧
        (∑ α : Fin (n + 2), c_bez α * g_el α = 1) ∧
        (∀ α : Fin (n + 2), RingHom.Etale (Φ α)) ∧
        (∀ α : Fin (n + 2),
          (Φ α).comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
            (algebraMap R_succ (Localization.Away (g_el α))).comp f_R) ∧
        (∀ α : Fin (n + 2),
          Φ α Polynomial.X = algebraMap R_succ (Localization.Away (g_el α)) u_bar_last) := by
    intro n R_succ f_R u_bar_last B_δ
    let P_succ := MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω
    let t_bar : R_succ := Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inl 0))
    let u_bar : Fin (n + 1) → R_succ :=
      fun j => Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inr (j, 0)))
    let v_bar : Fin (n + 1) → R_succ :=
      fun j => Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inr (j, 1)))
    let v_bar_last : R_succ := v_bar (Fin.last n)

    have hRel_succ : (1 - f_R c_0 * t_bar) * t_bar +
        (∑ j : Fin n, u_bar j.castSucc * v_bar j.castSucc) + u_bar_last * v_bar_last = 0 := by
      have hmk : Ideal.Quotient.mk (I_k (n + 1))
          (((1 - MvPolynomial.C c_0 * (MvPolynomial.X (Sum.inl 0) : P_succ)) *
            MvPolynomial.X (Sum.inl 0) +
            ∑ j : Fin (n + 1),
              (MvPolynomial.X (Sum.inr (j, 0)) : P_succ) * MvPolynomial.X (Sum.inr (j, 1)))) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [Fin.sum_univ_castSucc] at hmk
      simpa only [map_add, map_mul, map_sub, map_one, map_sum, RingHom.comp_apply,
        f_R, t_bar, u_bar, v_bar, u_bar_last, v_bar_last, add_assoc] using hmk

    let g_el : Fin (n + 2) → R_succ :=
      Fin.cases u_bar_last
        (Fin.cases (1 - 2 * f_R c_0 * t_bar) (fun j => u_bar j.castSucc))
    let c_bez : Fin (n + 2) → R_succ :=
      Fin.cases (-(4 * f_R c_0 * v_bar_last))
        (Fin.cases (1 - 2 * f_R c_0 * t_bar) (fun j => -(4 * f_R c_0 * v_bar j.castSucc)))
    have hBez : ∑ α : Fin (n + 2), c_bez α * g_el α = 1 := by
      rw [Fin.sum_univ_succ, Fin.sum_univ_succ]
      simp only [g_el, c_bez, Fin.cases_zero, Fin.cases_succ]
      have hsum_mid : (∑ j : Fin n, -(4 * f_R c_0 * v_bar j.castSucc) * u_bar j.castSucc) =
          -(4 * f_R c_0) * (∑ j : Fin n, u_bar j.castSucc * v_bar j.castSucc) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => by ring
      rw [hsum_mid]
      have hS_eq : ∑ j : Fin n, u_bar j.castSucc * v_bar j.castSucc =
          -((1 - f_R c_0 * t_bar) * t_bar + u_bar_last * v_bar_last) := by
        calc
          ∑ j : Fin n, u_bar j.castSucc * v_bar j.castSucc
              = ((1 - f_R c_0 * t_bar) * t_bar +
                  (∑ j : Fin n, u_bar j.castSucc * v_bar j.castSucc) +
                  u_bar_last * v_bar_last) -
                ((1 - f_R c_0 * t_bar) * t_bar + u_bar_last * v_bar_last) := by ring
          _ = 0 - ((1 - f_R c_0 * t_bar) * t_bar + u_bar_last * v_bar_last) := by rw [hRel_succ]
          _ = -((1 - f_R c_0 * t_bar) * t_bar + u_bar_last * v_bar_last) := zero_sub _
      rw [hS_eq]
      ring

    obtain ⟨θ₀, Φ₀_u, Φ_low, hθ₀_comm, hEt_Φ0u, hΦ₀u_Ω, hΦ₀u_X, hEt_low, hΩ_low, hX_low⟩ :=
      weil_aff_quad_open_stratum_and_partner_elim_rings Ω c_0 n
    obtain ⟨Φ₁, hEt_Φ1, hΦ1_Ω, hΦ1_X⟩ :=
      weil_aff_quad_monic_standard_etale_chart_ring Ω c_0 hc_0 n

    have hTransChart : ∀ {r s : R_succ} (h : r = s)
        (φ : Polynomial B_δ →+* Localization.Away r),
        RingHom.Etale φ →
        (φ.comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
          (algebraMap R_succ (Localization.Away r)).comp f_R) →
        (φ Polynomial.X = algebraMap R_succ (Localization.Away r) u_bar_last) →
        ∃ ψ : Polynomial B_δ →+* Localization.Away s,
          RingHom.Etale ψ ∧
          (ψ.comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
            (algebraMap R_succ (Localization.Away s)).comp f_R) ∧
          (ψ Polynomial.X = algebraMap R_succ (Localization.Away s) u_bar_last) := by
      intro r s h φ hEt hΩ hX
      subst h
      exact ⟨φ, hEt, hΩ, hX⟩

    have hExChart : ∀ α : Fin (n + 2),
        ∃ ψ : Polynomial B_δ →+* Localization.Away (g_el α),
          RingHom.Etale ψ ∧
          (ψ.comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
            (algebraMap R_succ (Localization.Away (g_el α))).comp f_R) ∧
          (ψ Polynomial.X = algebraMap R_succ (Localization.Away (g_el α)) u_bar_last) := by
      refine Fin.cases ?_ (Fin.cases ?_ ?_)
      · exact hTransChart (by simp only [g_el, Fin.cases_zero]; rfl) Φ₀_u hEt_Φ0u hΦ₀u_Ω hΦ₀u_X
      · exact hTransChart (by simp only [g_el, Fin.cases_zero, Fin.cases_succ]; rfl)
          Φ₁ hEt_Φ1 hΦ1_Ω hΦ1_X
      · intro j
        exact hTransChart (by simp only [g_el, Fin.cases_succ]; rfl)
          (Φ_low j) (hEt_low j) (hΩ_low j) (hX_low j)

    let Φ : ∀ α : Fin (n + 2), Polynomial B_δ →+* Localization.Away (g_el α) :=
      fun α => Classical.choose (hExChart α)
    exact ⟨g_el, c_bez, Φ, θ₀, Φ₀_u, hθ₀_comm, hΦ₀u_Ω, hΦ₀u_X, hBez,
      fun α => (Classical.choose_spec (hExChart α)).1,
      fun α => (Classical.choose_spec (hExChart α)).2.1,
      fun α => (Classical.choose_spec (hExChart α)).2.2⟩

  
  obtain ⟨hBaseV0, hLFT, hStratN⟩ := hStrata
  refine ⟨hBaseV0, ?_⟩
  intro n S_δ Y_δ U_δ j_δ V_n
  refine ⟨⟨hLFT n, hLFT (n + 1)⟩, ?_⟩
  let R_succ := MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)
  let f_R : Ω →+* R_succ :=
    (Ideal.Quotient.mk (I_k (n + 1))).comp
      (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)
  let u_bar_last : R_succ :=
    Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inr (Fin.last n, 0)))
  let D_n : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away u_bar_last))
  let j_n : D_n ⟶ (A_over (n + 1)).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_succ (Localization.Away u_bar_last)))
  obtain ⟨hj_open, i_n, hi_cl, y₀, hCompl, hy₀_out⟩ := hStratN n
  haveI : AlgebraicGeometry.IsOpenImmersion j_n := hj_open

  
  let B_δ := MvPolynomial (Fin (2 * n + 1)) Ω
  let Y_aff : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B_δ))
  have hPb_Y : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B_δ →+* Polynomial B_δ)))
      (AlgebraicGeometry.Spec.map
        (@CommRingCat.ofHom (Polynomial Ω) (Polynomial B_δ) _ _
          (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ))))
      S_δ.hom p_A1 := by
    letI : Algebra (Polynomial Ω) (Polynomial B_δ) := Polynomial.algebra Ω B_δ
    haveI : IsScalarTower Ω (Polynomial Ω) (Polynomial B_δ) :=
      instIsScalarTowerPolynomial Ω Ω B_δ
    haveI : IsScalarTower Ω B_δ (Polynomial B_δ) := Polynomial.isScalarTower
    haveI : Algebra.IsPushout Ω B_δ (Polynomial Ω) (Polynomial B_δ) :=
      instIsPushoutPolynomial Ω
    have hPush_Y₀ := CommRingCat.isPushout_of_isPushout Ω B_δ (Polynomial Ω) (Polynomial B_δ)
    have halg_map : (algebraMap (Polynomial Ω) (Polynomial B_δ) : Polynomial Ω →+* Polynomial B_δ) =
        Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ) := by
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun c => ?_
        simp only [RingHom.comp_apply, ← Polynomial.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply Ω (Polynomial Ω) (Polynomial B_δ),
          IsScalarTower.algebraMap_apply Ω B_δ (Polynomial B_δ)]
        rw [Polynomial.algebraMap_eq, Polynomial.algebraMap_eq, Polynomial.coe_mapRingHom,
          Polynomial.map_C]
        rfl
      · change (Polynomial.aeval (Polynomial.X : Polynomial B_δ)) Polynomial.X =
          (Polynomial.mapRingHom MvPolynomial.C) Polynomial.X
        rw [Polynomial.aeval_X, Polynomial.coe_mapRingHom, Polynomial.map_X]
    rw [Polynomial.algebraMap_eq, Polynomial.algebraMap_eq, halg_map] at hPush_Y₀
    exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Y₀
  let e_Y_aff : Y_aff ≅ Y_δ := hPb_Y.isoPullback
  have he_Yaff_fst : e_Y_aff.hom ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B_δ →+* Polynomial B_δ)) :=
    hPb_Y.isoPullback_hom_fst
  have he_Yaff_snd : e_Y_aff.hom ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 =
      AlgebraicGeometry.Spec.map
        (@CommRingCat.ofHom (Polynomial Ω) (Polynomial B_δ) _ _
          (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ))) :=
    hPb_Y.isoPullback_hom_snd
  let eq_succ : MvPolynomial (Fin (2 * n + 2)) Ω ≃+* Polynomial B_δ :=
    (MvPolynomial.finSuccEquiv Ω (2 * n + 1)).toRingEquiv
  let e_succ : Y_aff ≅ (weilAffineSpaceOver Ω (2 * n + 2)).left :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.symm.toRingHom)
      hom_inv_id := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.symm.toRingHom) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B_δ)))
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          show eq_succ.toRingHom.comp eq_succ.symm.toRingHom = RingHom.id _ from
            RingHom.ext eq_succ.apply_symm_apply,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.toRingHom) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (2 * n + 2)) Ω)))
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          show eq_succ.symm.toRingHom.comp eq_succ.toRingHom = RingHom.id _ from
            RingHom.ext eq_succ.symm_apply_apply,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let e_Y : Y_δ ≅ (weilAffineSpaceOver Ω (2 * n + 2)).left := e_Y_aff.symm.trans e_succ
  have he_Y_hom : e_Y.hom ≫ (weilAffineSpaceOver Ω (2 * n + 2)).hom =
      CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ≫ S_δ.hom := by
    rw [← CategoryTheory.Iso.cancel_iso_hom_left e_Y_aff]
    calc
      e_Y_aff.hom ≫ e_Y.hom ≫ (weilAffineSpaceOver Ω (2 * n + 2)).hom
          = (e_Y_aff.hom ≫ e_Y_aff.inv) ≫ e_succ.hom ≫
              (weilAffineSpaceOver Ω (2 * n + 2)).hom := by
            dsimp [e_Y]
            simp only [CategoryTheory.Category.assoc]
      _ = e_succ.hom ≫ (weilAffineSpaceOver Ω (2 * n + 2)).hom := by
            rw [e_Y_aff.hom_inv_id, CategoryTheory.Category.id_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_succ.toRingHom) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.C : Ω →+* MvPolynomial (Fin (2 * n + 2)) Ω)) := rfl
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B_δ →+* Polynomial B_δ)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : Ω →+* B_δ)) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 2
            exact RingHom.ext fun c => (MvPolynomial.finSuccEquiv Ω (2 * n + 1)).commutes c
      _ = (e_Y_aff.hom ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1) ≫ S_δ.hom := by
            rw [he_Yaff_fst]
            rfl
      _ = e_Y_aff.hom ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ≫ S_δ.hom := by
            rw [CategoryTheory.Category.assoc]

  
  obtain ⟨g_el, c_bez, Φ, θ₀, Φ₀_u, hθ₀_comm, hΦ₀u_Ω, hΦ₀u_X, hBez, hEt_Φ, hΩ_Φ, hX_Φ⟩ :=
    hRings n

  
  let snd_Y := CategoryTheory.Limits.pullback.snd S_δ.hom p_A1
  haveI : AlgebraicGeometry.IsOpenImmersion j_Gm :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial Ω)
  haveI : CategoryTheory.Mono j_Gm := AlgebraicGeometry.IsOpenImmersion.mono j_Gm
  have hRange_jGm : Set.range ⇑j_Gm =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial Ω) : Set (PrimeSpectrum (Polynomial Ω))) :=
    PrimeSpectrum.localization_away_comap_range
      (Localization.Away (Polynomial.X : Polynomial Ω)) (Polynomial.X : Polynomial Ω)
  haveI : AlgebraicGeometry.IsOpenImmersion j_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback j_Gm snd_Y) inferInstance
  have hRange_jδ : Set.range ⇑j_δ = ⇑snd_Y ⁻¹' Set.range ⇑j_Gm :=
    AlgebraicGeometry.Scheme.Pullback.range_snd j_Gm snd_Y

  have he_D_exists : Nonempty (D_n ≅ U_δ) := by
    letI : Algebra (Polynomial B_δ) (Localization.Away u_bar_last) := Φ₀_u.toAlgebra
    let θ₀_alg : Localization.Away (Polynomial.X : Polynomial B_δ) ≃ₐ[Polynomial B_δ]
        Localization.Away u_bar_last :=
      { θ₀ with commutes' := hθ₀_comm }
    haveI : IsLocalization.Away (Polynomial.X : Polynomial B_δ) (Localization.Away u_bar_last) :=
      IsLocalization.isLocalization_of_algEquiv
        (Submonoid.powers (Polynomial.X : Polynomial B_δ)) θ₀_alg
    let ι_D_aff : D_n ⟶ Y_aff :=
      AlgebraicGeometry.Spec.map
        (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away u_bar_last) _ _
          (algebraMap (Polynomial B_δ) (Localization.Away u_bar_last)))
    haveI : AlgebraicGeometry.IsOpenImmersion ι_D_aff :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial B_δ)
    let ι_D : D_n ⟶ Y_δ := ι_D_aff ≫ e_Y_aff.hom
    haveI : AlgebraicGeometry.IsOpenImmersion ι_D :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion) _ _
        inferInstance
        (CategoryTheory.MorphismProperty.of_isIso (@AlgebraicGeometry.IsOpenImmersion) e_Y_aff.hom)
    have hRange_aff : Set.range ⇑ι_D_aff =
        (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial B_δ) :
          Set (PrimeSpectrum (Polynomial B_δ))) :=
      PrimeSpectrum.localization_away_comap_range
        (Localization.Away u_bar_last) (Polynomial.X : Polynomial B_δ)
    have hRange_ιD : Set.range ⇑ι_D = Set.range ⇑j_δ := by
      rw [hRange_jδ, hRange_jGm]
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        have hz_aff : ι_D_aff z ∈
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial B_δ) :
              Set (PrimeSpectrum (Polynomial B_δ))) := by
          rw [← hRange_aff]
          exact ⟨z, rfl⟩
        have hz_aff' : (Polynomial.X : Polynomial B_δ) ∉ (ι_D_aff z).asIdeal :=
          (PrimeSpectrum.mem_basicOpen _ _).mp hz_aff
        let p_map_hom :=
          (@CommRingCat.ofHom (Polynomial Ω) (Polynomial B_δ) _ _
            (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ))).hom
        have hsnd1 : snd_Y (ι_D z) = snd_Y (e_Y_aff.hom (ι_D_aff z)) :=
          congrArg snd_Y (AlgebraicGeometry.Scheme.Hom.comp_apply ι_D_aff e_Y_aff.hom z)
        have hsnd2 : snd_Y (e_Y_aff.hom (ι_D_aff z)) =
            PrimeSpectrum.comap p_map_hom (ι_D_aff z) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply e_Y_aff.hom snd_Y, he_Yaff_snd]
          rfl
        have hsnd : snd_Y (ι_D z) = PrimeSpectrum.comap p_map_hom (ι_D_aff z) :=
          hsnd1.trans hsnd2
        change snd_Y (ι_D z) ∈
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial Ω) :
            Set (PrimeSpectrum (Polynomial Ω)))
        refine (PrimeSpectrum.mem_basicOpen _ _).mpr ?_
        rw [hsnd]
        intro hmem
        apply hz_aff'
        have hX_map : (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ)) Polynomial.X =
            (Polynomial.X : Polynomial B_δ) := by simp
        change (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ)) Polynomial.X ∈
          (ι_D_aff z).asIdeal at hmem
        rwa [hX_map] at hmem
      · intro hy
        let q : Y_aff := e_Y_aff.inv y
        have hqy : e_Y_aff.hom q = y := by
          calc
            e_Y_aff.hom (e_Y_aff.inv y) = (e_Y_aff.inv ≫ e_Y_aff.hom) y :=
              (AlgebraicGeometry.Scheme.Hom.comp_apply e_Y_aff.inv e_Y_aff.hom y).symm
            _ = (𝟙 Y_δ : Y_δ ⟶ Y_δ) y := by rw [e_Y_aff.inv_hom_id]
            _ = y := rfl
        have hq_mem : q ∈
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial B_δ) :
              Set (PrimeSpectrum (Polynomial B_δ))) := by
          refine (PrimeSpectrum.mem_basicOpen _ _).mpr fun hX_in_q => ?_
          have hy_in : snd_Y (e_Y_aff.hom q) ∈
              (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial Ω) :
                Set (PrimeSpectrum (Polynomial Ω))) := by
            change e_Y_aff.hom q ∈ ⇑snd_Y ⁻¹'
              (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial Ω) :
                Set (PrimeSpectrum (Polynomial Ω)))
            rwa [hqy]
          have hy_j : (Polynomial.X : Polynomial Ω) ∉ (snd_Y (e_Y_aff.hom q)).asIdeal :=
            (PrimeSpectrum.mem_basicOpen _ _).mp hy_in
          let p_map_hom :=
            (@CommRingCat.ofHom (Polynomial Ω) (Polynomial B_δ) _ _
              (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ))).hom
          have hsnd_q : snd_Y (e_Y_aff.hom q) = PrimeSpectrum.comap p_map_hom q := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply e_Y_aff.hom snd_Y, he_Yaff_snd]
            rfl
          rw [hsnd_q] at hy_j
          apply hy_j
          change (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ)) Polynomial.X ∈ q.asIdeal
          simpa using hX_in_q
        rw [← hRange_aff] at hq_mem
        rcases hq_mem with ⟨z, hz⟩
        refine ⟨z, ?_⟩
        calc
          ι_D z = e_Y_aff.hom (ι_D_aff z) :=
            AlgebraicGeometry.Scheme.Hom.comp_apply ι_D_aff e_Y_aff.hom z
          _ = e_Y_aff.hom q := by rw [hz]
          _ = y := hqy
    exact ⟨AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ι_D j_δ hRange_ιD⟩
  obtain ⟨e_D⟩ := he_D_exists

  
  let μ_bar_ring : Polynomial Ω →+* R_succ := Polynomial.eval₂RingHom f_R u_bar_last
  let μ_bar : (A_over (n + 1)).left ⟶ A1_Ω :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_bar_ring)
  have hRange_jn : Set.range ⇑j_n =
      (PrimeSpectrum.basicOpen u_bar_last : Set (PrimeSpectrum R_succ)) :=
    PrimeSpectrum.localization_away_comap_range (Localization.Away u_bar_last) u_bar_last
  have hPre_μbar : ⇑μ_bar ⁻¹' Set.range ⇑j_Gm = Set.range ⇑j_n := by
    rw [hRange_jGm, hRange_jn]
    ext p
    simp only [Set.mem_preimage, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    change μ_bar_ring Polynomial.X ∉ p.asIdeal ↔ u_bar_last ∉ p.asIdeal
    have hX_eval : μ_bar_ring Polynomial.X = u_bar_last := by simp [μ_bar_ring]
    rw [hX_eval]
  have hSub_μ : Set.range ⇑(j_n ≫ μ_bar) ⊆ Set.range ⇑j_Gm := by
    rintro _ ⟨z, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    have hz : j_n z ∈ Set.range ⇑j_n := ⟨z, rfl⟩
    rw [← hPre_μbar] at hz
    exact hz
  let μ_n : D_n ⟶ Gm_Ω := AlgebraicGeometry.IsOpenImmersion.lift j_Gm (j_n ≫ μ_bar) hSub_μ
  have hμ_fac : μ_n ≫ j_Gm = j_n ≫ μ_bar :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac j_Gm (j_n ≫ μ_bar) hSub_μ

  
  let W : Fin (n + 2) → (A_over (n + 1)).left.Opens :=
    fun α => PrimeSpectrum.basicOpen (g_el α)
  have hAffW : ∀ α : Fin (n + 2), AlgebraicGeometry.IsAffineOpen (W α) :=
    fun α => @AlgebraicGeometry.IsAffineOpen.Spec_basicOpen (CommRingCat.of R_succ) (g_el α)
  have hSupW : (⨆ α : Fin (n + 2), W α) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    by_contra hall
    push_neg at hall
    have hx_mem : ∀ α : Fin (n + 2), g_el α ∈ x.asIdeal := by
      intro α
      have hnot : x ∉ PrimeSpectrum.basicOpen (g_el α) := hall α
      exact Classical.not_not.mp (mt (PrimeSpectrum.mem_basicOpen _ _).mpr hnot)
    have hsum_mem : (∑ α : Fin (n + 2), c_bez α * g_el α) ∈ x.asIdeal :=
      Ideal.sum_mem x.asIdeal fun α _ => Ideal.mul_mem_left x.asIdeal (c_bez α) (hx_mem α)
    rw [hBez] at hsum_mem
    exact x.isPrime.ne_top (x.asIdeal.eq_top_of_isUnit_mem hsum_mem isUnit_one)
  let j_chart : ∀ α : Fin (n + 2),
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (g_el α))) ⟶
        (A_over (n + 1)).left :=
    fun α => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap R_succ (Localization.Away (g_el α))))
  have hj_chart_open : ∀ α : Fin (n + 2), AlgebraicGeometry.IsOpenImmersion (j_chart α) :=
    fun α => AlgebraicGeometry.IsOpenImmersion.of_isLocalization (g_el α)
  have hRange_W : ∀ α : Fin (n + 2), Set.range ⇑(W α).ι = Set.range ⇑(j_chart α) := by
    intro α
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    symm
    exact PrimeSpectrum.localization_away_comap_range (Localization.Away (g_el α)) (g_el α)
  let e_W : ∀ α : Fin (n + 2),
      (W α).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (g_el α))) :=
    fun α => @AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq _ _ _ (W α).ι (j_chart α)
      inferInstance (hj_chart_open α) (hRange_W α)
  have he_W_hom : ∀ α : Fin (n + 2), (e_W α).hom ≫ j_chart α = (W α).ι :=
    fun α => @AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _ (W α).ι (j_chart α)
      inferInstance (hj_chart_open α) (hRange_W α)
  let ϕ : ∀ α : Fin (n + 2), (W α).toScheme ⟶ Y_δ :=
    fun α =>
      (e_W α).hom ≫
        AlgebraicGeometry.Spec.map
          (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away (g_el α)) _ _ (Φ α)) ≫
        e_Y_aff.hom
  have hEt_ϕ : ∀ α : Fin (n + 2), AlgebraicGeometry.Etale (ϕ α) := by
    intro α
    have hSpecEt : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map
          (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away (g_el α)) _ _ (Φ α))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr (hEt_Φ α)
    exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
      (CategoryTheory.MorphismProperty.of_isIso (@AlgebraicGeometry.Etale) (e_W α).hom)
      (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
        hSpecEt
        (CategoryTheory.MorphismProperty.of_isIso (@AlgebraicGeometry.Etale) e_Y_aff.hom))
  have hϕ_hom : ∀ α : Fin (n + 2),
      ϕ α ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ≫ S_δ.hom =
        (W α).ι ≫ (A_over (n + 1)).hom := by
    intro α
    calc
      ϕ α ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ≫ S_δ.hom
          = (e_W α).hom ≫
              AlgebraicGeometry.Spec.map
                (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away (g_el α)) _ _ (Φ α)) ≫
              (e_Y_aff.hom ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1) ≫ S_δ.hom := by
            dsimp [ϕ]
            simp only [CategoryTheory.Category.assoc]
      _ = (e_W α).hom ≫
            AlgebraicGeometry.Spec.map
              (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away (g_el α)) _ _ (Φ α)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B_δ →+* Polynomial B_δ)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : Ω →+* B_δ)) := by
            rw [he_Yaff_fst]
            rfl
      _ = (e_W α).hom ≫ j_chart α ≫ (A_over (n + 1)).hom := by
            change _ = (e_W α).hom ≫ j_chart α ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_R)
            dsimp [j_chart]
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hΩ_Φ α,
              CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      _ = (W α).ι ≫ (A_over (n + 1)).hom := by
            rw [← CategoryTheory.Category.assoc, he_W_hom α]
  have hϕ_snd : ∀ α : Fin (n + 2), ϕ α ≫ snd_Y = (W α).ι ≫ μ_bar := by
    intro α
    calc
      ϕ α ≫ snd_Y
          = (e_W α).hom ≫
              AlgebraicGeometry.Spec.map
                (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away (g_el α)) _ _ (Φ α)) ≫
              (e_Y_aff.hom ≫ snd_Y) := by
            dsimp [ϕ]
            simp only [CategoryTheory.Category.assoc]
      _ = (e_W α).hom ≫
            AlgebraicGeometry.Spec.map
              (@CommRingCat.ofHom (Polynomial B_δ) (Localization.Away (g_el α)) _ _ (Φ α)) ≫
            AlgebraicGeometry.Spec.map
              (@CommRingCat.ofHom (Polynomial Ω) (Polynomial B_δ) _ _
                (Polynomial.mapRingHom (MvPolynomial.C : Ω →+* B_δ))) := by
            rw [he_Yaff_snd]
      _ = (e_W α).hom ≫ j_chart α ≫ μ_bar := by
            dsimp [j_chart, μ_bar]
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 3
            apply Polynomial.ringHom_ext'
            · refine RingHom.ext fun c => ?_
              have hc := RingHom.congr_fun (hΩ_Φ α) c
              simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
                μ_bar_ring, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
              exact hc
            · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
                μ_bar_ring, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
              exact hX_Φ α
      _ = (W α).ι ≫ μ_bar := by
            rw [← CategoryTheory.Category.assoc, he_W_hom α]

  have hSnd_open : ∀ α : Fin (n + 2),
      AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.snd j_n (W α).ι) :=
    fun α => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback j_n (W α).ι) inferInstance
  have hRange_snd : ∀ α : Fin (n + 2),
      Set.range ⇑(CategoryTheory.Limits.pullback.snd j_n (W α).ι) =
        ⇑(ϕ α) ⁻¹' Set.range ⇑j_δ := by
    intro α
    rw [AlgebraicGeometry.Scheme.Pullback.range_snd j_n (W α).ι, hRange_jδ]
    ext w
    simp only [Set.mem_preimage]
    have hcomp_apply : snd_Y (ϕ α w) = μ_bar ((W α).ι w) := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply (ϕ α) snd_Y w, hϕ_snd α,
        AlgebraicGeometry.Scheme.Hom.comp_apply]
    rw [hcomp_apply]
    change (W α).ι w ∈ Set.range ⇑j_n ↔ (W α).ι w ∈ ⇑μ_bar ⁻¹' Set.range ⇑j_Gm
    rw [hPre_μbar]
  have hSub_g : ∀ α : Fin (n + 2),
      Set.range ⇑(CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ ϕ α) ⊆ Set.range ⇑j_δ := by
    rintro α _ ⟨z, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    have hz : CategoryTheory.Limits.pullback.snd j_n (W α).ι z ∈
        Set.range ⇑(CategoryTheory.Limits.pullback.snd j_n (W α).ι) := ⟨z, rfl⟩
    rw [hRange_snd α] at hz
    exact hz
  let g : ∀ α : Fin (n + 2), CategoryTheory.Limits.pullback j_n (W α).ι ⟶ U_δ :=
    fun α => AlgebraicGeometry.IsOpenImmersion.lift j_δ
      (CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ ϕ α) (hSub_g α)
  have hg_fac : ∀ α : Fin (n + 2),
      g α ≫ j_δ = CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ ϕ α :=
    fun α => AlgebraicGeometry.IsOpenImmersion.lift_fac j_δ
      (CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ ϕ α) (hSub_g α)
  have hPb : ∀ α : Fin (n + 2),
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd j_n (W α).ι) (g α) (ϕ α) j_δ := by
    intro α
    haveI := hSnd_open α
    exact hPb_open (CategoryTheory.Limits.pullback.snd j_n (W α).ι) (g α) (ϕ α) j_δ
      (hg_fac α).symm (hRange_snd α)
  have hEt_g : ∀ α : Fin (n + 2), AlgebraicGeometry.Etale (g α) :=
    fun α => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb α) (hEt_ϕ α)
  have hμ_comm : ∀ α : Fin (n + 2),
      g α ≫ CategoryTheory.Limits.pullback.fst j_Gm snd_Y =
        CategoryTheory.Limits.pullback.fst j_n (W α).ι ≫ μ_n := by
    intro α
    apply (cancel_mono j_Gm).mp
    calc
      (g α ≫ CategoryTheory.Limits.pullback.fst j_Gm snd_Y) ≫ j_Gm
          = g α ≫ (CategoryTheory.Limits.pullback.fst j_Gm snd_Y ≫ j_Gm) := by
            rw [CategoryTheory.Category.assoc]
      _ = g α ≫ (j_δ ≫ snd_Y) := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = (g α ≫ j_δ) ≫ snd_Y := by
            rw [← CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ ϕ α) ≫ snd_Y := by
            rw [hg_fac α]
      _ = CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ (ϕ α ≫ snd_Y) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ ((W α).ι ≫ μ_bar) := by
            rw [hϕ_snd α]
      _ = (CategoryTheory.Limits.pullback.snd j_n (W α).ι ≫ (W α).ι) ≫ μ_bar := by
            rw [← CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Limits.pullback.fst j_n (W α).ι ≫ j_n) ≫ μ_bar := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = CategoryTheory.Limits.pullback.fst j_n (W α).ι ≫ (j_n ≫ μ_bar) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Limits.pullback.fst j_n (W α).ι ≫ (μ_n ≫ j_Gm) := by
            rw [← hμ_fac]
      _ = (CategoryTheory.Limits.pullback.fst j_n (W α).ι ≫ μ_n) ≫ j_Gm := by
            rw [← CategoryTheory.Category.assoc]

  exact ⟨D_n, inferInstance, j_n, hj_open, i_n, hi_cl, y₀, e_D, μ_n, e_Y,
    W, ϕ, hEt_ϕ, g, hEt_g, hCompl, hy₀_out, he_Y_hom, hAffW, hSupW, hϕ_hom, hPb, hμ_comm⟩

theorem weil_aff_quad_a1_product_and_gm_vanishing (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : Ω) ≠ 0)
    (hA1Zero : ∀ (δ b : ℕ), 1 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver Ω δ).hom
            (weilAffineSpaceOver Ω 1).hom)
          b
          (weilEtaleTorsionSheaf
            (CategoryTheory.Limits.pullback (weilAffineSpaceOver Ω δ).hom
              (weilAffineSpaceOver Ω 1).hom) ℓ))) :
    (∀ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        (d M : ℕ) (W : Fin M → B.left.Opens)
        (ψ : ∀ α : Fin M, (W α).toScheme ⟶ (weilAffineSpaceOver Ω d).left)
        [∀ α : Fin M, AlgebraicGeometry.Etale (ψ α)],
      (⨆ α : Fin M, W α) = ⊤ →
      (∀ α : Fin M, ψ α ≫ (weilAffineSpaceOver Ω d).hom = (W α).ι ≫ B.hom) →
      ∀ q : ℕ,
        Nonempty (weilEtaleTorsionH B.left ℓ q ≃+
          weilEtaleTorsionH
            (CategoryTheory.Limits.pullback B.hom (weilAffineSpaceOver Ω 1).hom) ℓ q)) ∧
    (let A1_Ω : AlgebraicGeometry.Scheme.{u} :=
       AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))
     let Gm_Ω : AlgebraicGeometry.Scheme.{u} :=
       AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial Ω)))
     let j_Gm : Gm_Ω ⟶ A1_Ω :=
       AlgebraicGeometry.Spec.map (CommRingCat.ofHom
         (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω))))
     let p_A1 : A1_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
       AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))
     ∀ (δ q : ℕ), 2 ≤ q →
       Subsingleton (weilEtaleTorsionH
         (CategoryTheory.Limits.pullback j_Gm
           (CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver Ω δ).hom p_A1)) ℓ q)) ∧
    (∀ (S : AlgebraicGeometry.Scheme.{u}) (O₀ O₁ : S.Opens),
      O₀ ⊓ O₁ = ⊥ →
      O₀ ⊔ O₁ = ⊤ →
      Nonempty (O₀.toScheme ≅ (weilAffineSpaceOver Ω 1).left) →
      Nonempty (O₁.toScheme ≅ (weilAffineSpaceOver Ω 1).left) →
      Finite (weilEtaleTorsionH S ℓ 0) ∧
      ∃ Φ : weilEtaleTorsionH S ℓ 0 →+ ZMod ℓ × ZMod ℓ, Function.Injective Φ) :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : CategoryTheory.MorphismProperty.ContainsIdentities
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toContainsIdentities
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
  have hℓ_ge1 : 1 ≤ ℓ := hℓ_prime.one_lt.le
  have _ : NeZero ℓ := ⟨hℓ_pos.ne'⟩

  
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hPullIsoEquiv : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (q : ℕ),
      Nonempty (weilEtaleTorsionH S₂ ℓ q ≃+ weilEtaleTorsionH S₁ ℓ q) := by
    intro S₁ S₂ e q
    obtain ⟨p_hom, hp_hom⟩ := hPullEx e.hom ℓ q
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv ℓ q
    obtain ⟨p_id₁, hp_id₁⟩ := hPullEx (CategoryTheory.CategoryStruct.id S₁) ℓ q
    obtain ⟨p_id₂, hp_id₂⟩ := hPullEx (CategoryTheory.CategoryStruct.id S₂) ℓ q
    have hid₁_eq : p_id₁ = AddMonoidHom.id _ := hPullId ℓ q p_id₁ hp_id₁
    have hid₂_eq : p_id₂ = AddMonoidHom.id _ := hPullId ℓ q p_id₂ hp_id₂
    have hcomp₁ : p_hom.comp p_inv = AddMonoidHom.id _ := by
      have hp_c₁ : WeilIsTorsionEtalePullback (e.hom ≫ e.inv) ℓ q p_id₁ := by
        rwa [e.hom_inv_id]
      exact (hPullComp e.hom e.inv ℓ q p_hom p_inv p_id₁ hp_hom hp_inv hp_c₁).symm.trans hid₁_eq
    have hcomp₂ : p_inv.comp p_hom = AddMonoidHom.id _ := by
      have hp_c₂ : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) ℓ q p_id₂ := by
        rwa [e.inv_hom_id]
      exact (hPullComp e.inv e.hom ℓ q p_inv p_hom p_id₂ hp_inv hp_hom hp_c₂).symm.trans hid₂_eq
    exact ⟨{
      toFun := p_hom
      invFun := p_inv
      left_inv := fun y => DFunLike.congr_fun hcomp₂ y
      right_inv := fun x => DFunLike.congr_fun hcomp₁ x
      map_add' := p_hom.map_add
    }⟩

  
  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (g : Y ⟶ W) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_mor_etale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    intro S Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  
  
  
  have h_unit_iso_conn : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u})
      (E₀ : Z.Etale) [ConnectedSpace ↥E₀.left],
      CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).app (Opposite.op E₀)) := by
    intro Z A E₀ _
    let P_A : CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {_ _} g =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A) g.unop.left.base.hom)
        map_id := fun _ => by
          apply AddCommGrpCat.ext; intro g; ext x; rfl
        map_comp := fun _ _ => by
          apply AddCommGrpCat.ext; intro h; ext x; rfl }
    let P_const := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj A
    let θ_A : P_const ⟶ P_A :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext; intro a; ext x; rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale Z E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m_pt => (c.π.app (Opposite.op w)).hom m_pt
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m_pt : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m_pt y₁ = eval_c c w₂ m_pt y₂ := by
        intro c w₁ w₂ m_pt y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget Z).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m_pt (p₁.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m_pt (p₂.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m_pt x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m_pt y_x
          have hg_eq : ∀ (m_pt : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m_pt (w.obj.hom.left.base y) = eval_c c w m_pt y := by
            intro m_pt w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m_pt y_x y hy_x
          have hg_lc : ∀ m_pt : ↥c.pt, IsLocallyConstant (g_fn m_pt) := by
            intro m_pt
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m_pt
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m_pt (w_x.obj.hom.left.base y') = a
              rw [hg_eq m_pt w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m_pt x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m_pt => ⟨g_fn m_pt, hg_lc m_pt⟩
              map_zero' := by
                apply LocallyConstant.ext; intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have h0 : eval_c c w_x 0 = 0 := map_zero (c.π.app (Opposite.op w_x)).hom
                exact congrArg (fun g : LocallyConstant ↥w_x.obj.left.left ↥A => g y_x) h0
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext; intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have hadd : eval_c c w_x (m₁ + m₂) = eval_c c w_x m₁ + eval_c c w_x m₂ :=
                  map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂
                exact congrArg (fun g : LocallyConstant ↥w_x.obj.left.left ↥A => g y_x) hadd }
        fac := fun c j_idx => by
          apply AddCommGrpCat.ext; intro m_pt
          change _ = eval_c c j_idx.unop m_pt
          ext y
          let x := j_idx.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j_idx.unop m_pt y_x y hy_x
        uniq := fun c k_mor hk => by
          apply AddCommGrpCat.ext; intro m_pt
          let km : LocallyConstant ↥E.left ↥A := k_mor.hom m_pt
          change km = _
          apply LocallyConstant.ext; intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m_pt : LocallyConstant ↥w_x.obj.left.left ↥A) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m_pt y_x at hkx
          rw [hy_x] at hkx
          exact hkx
      }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ Z.smallEtaleTopology E.unop := by
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : P.Over ⊤ Z := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget P ⊤ Z).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology P Z)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact Z.smallEtaleTopology.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun g : LocallyConstant ↥E.unop.left ↥A => g x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := P_const) (X := E) a₁ a₁ = ⊤ :=
          CategoryTheory.Sieve.id_mem_iff_eq_top.mp rfl
        rw [htop]
        exact Z.smallEtaleTopology.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E g_sec
      refine (h_mem_etale Z E (CategoryTheory.Presheaf.imageSieve θ_A g_sec)).mpr ?_
      intro x
      let f_lc : LocallyConstant ↥E.left ↥A := g_sec
      let a : ↥A := f_lc x
      let O_a : E.left.Opens := ⟨f_lc ⁻¹' {a}, f_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, inferInstance, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW_θ : Z.smallEtaleTopology.W θ_A :=
      (Z.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (Z.smallEtaleTopology.W_iff θ_A).mp hW_θ
    let ℒ_A : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let Υ_A : (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
      (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A :=
      CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_A) := inferInstance
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    let Γ_E₀ := (CategoryTheory.sheafSections Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op E₀)
    have hIso_ΥE₀ : CategoryTheory.IsIso (Υ_A.hom.app (Opposite.op E₀)) := by
      change CategoryTheory.IsIso (Γ_E₀.map Υ_A)
      infer_instance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_A.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have h_comp_E₀ :
        (adj_sh.unit.app P_const).app (Opposite.op E₀) ≫ Υ_A.hom.app (Opposite.op E₀) =
          θ_A.app (Opposite.op E₀) :=
      congrArg (fun η => η.app (Opposite.op E₀)) h_unit_Υ
    have h_bij : Function.Bijective ⇑(θ_A.app (Opposite.op E₀)).hom := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        obtain ⟨v₀⟩ : Nonempty ↥E₀.left := ConnectedSpace.toNonempty
        exact congrArg (fun g : LocallyConstant ↥E₀.left ↥A => g v₀) ha
      · intro g
        have : PreconnectedSpace ↥E₀.left := ConnectedSpace.toPreconnectedSpace
        have : Nonempty ↥A := ⟨0⟩
        obtain ⟨a, rfl⟩ := LocallyConstant.exists_eq_const g
        exact ⟨a, rfl⟩
    have hIso_θ : CategoryTheory.IsIso (θ_A.app (Opposite.op E₀)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (θ_A.app (Opposite.op E₀))).mpr h_bij
    rw [← h_comp_E₀] at hIso_θ
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
      ((adj_sh.unit.app P_const).app (Opposite.op E₀)) (Υ_A.hom.app (Opposite.op E₀))
      hIso_ΥE₀ hIso_θ

  have hConstUnitIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom X Y)
      [_hc : (weilEtaleSitePullback g).IsContinuous Y.smallEtaleTopology X.smallEtaleTopology]
      {T_X : X.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X)
      {T_Y : Y.Etale} (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (A : AddCommGrpCat.{u}),
      (∀ (D : Y.Etale) (y : ↥D.left),
        ∃ (E : Y.Etale) (u : Quiver.Hom E D) (z : ↥E.left),
          u.left.base z = y ∧
          ConnectedSpace ↥E.left ∧
          ConnectedSpace ↥((weilEtaleSitePullback g).obj E).left) →
      let B_g := weilEtaleSitePullback g
      let J_X := X.smallEtaleTopology
      let J_Y := Y.smallEtaleTopology
      let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
      let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
      let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_X
      let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
      let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
      let τ := hT_X.from (B_g.obj T_Y)
      CategoryTheory.IsIso
        ((adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).symm
          (CategoryTheory.CategoryStruct.comp (adj_X.unit.app A)
            ((C_X.obj A).obj.map τ.op))) := by
    intro X Y g _hc T_X hT_X T_Y hT_Y A hBasis B_g J_X J_Y C_X C_Y pf_g adj_X adj_Y τ
    set η_g : C_Y.obj A ⟶ pf_g.obj (C_X.obj A) :=
      (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).symm
        (CategoryTheory.CategoryStruct.comp (adj_X.unit.app A) ((C_X.obj A).obj.map τ.op))
    let constX := (CategoryTheory.Functor.const (Opposite X.Etale)).obj A
    let constY := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj A
    let adj_shX := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
    let adj_shY := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let η_X : constX ⟶ (C_X.obj A).obj := adj_shX.unit.app constX
    let η_Y : constY ⟶ (C_Y.obj A).obj := adj_shY.unit.app constY
    let u_pre : constY ⟶ (pf_g.obj (C_X.obj A)).obj :=
      CategoryTheory.Functor.whiskerLeft B_g.op η_X
    let u_sh : C_Y.obj A ⟶ pf_g.obj (C_X.obj A) :=
      (adj_shY.homEquiv constY (pf_g.obj (C_X.obj A))).symm u_pre
    have hu_fac : η_Y ≫ u_sh.hom = u_pre := by
      have h1 := (adj_shY.homEquiv constY (pf_g.obj (C_X.obj A))).apply_symm_apply u_pre
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have hη_eq_ush : η_g = u_sh := by
      apply (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).injective
      have hlhs : (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))) η_g =
          η_X.app (Opposite.op T_X) ≫ (C_X.obj A).obj.map τ.op :=
        (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))).apply_symm_apply _
      have hrhs : (adj_Y.homEquiv A (pf_g.obj (C_X.obj A))) u_sh =
          η_X.app (Opposite.op (B_g.obj T_Y)) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y A (pf_g.obj (C_X.obj A)) u_sh).trans
          (congrArg (fun ν : constY ⟶ (pf_g.obj (C_X.obj A)).obj => ν.app (Opposite.op T_Y)) hu_fac)
      have hnat : η_X.app (Opposite.op T_X) ≫ (C_X.obj A).obj.map τ.op =
          η_X.app (Opposite.op (B_g.obj T_Y)) :=
        (η_X.naturality τ.op).symm.trans (CategoryTheory.Category.id_comp _)
      exact hlhs.trans (hnat.trans hrhs.symm)
    rw [hη_eq_ush]
    have hu_iso_on_conn : ∀ (E : Y.Etale),
        ConnectedSpace ↥E.left →
        ConnectedSpace ↥(B_g.obj E).left →
        CategoryTheory.IsIso (u_sh.hom.app (Opposite.op E)) := by
      intro E hC1 hC2
      have : ConnectedSpace ↥E.left := hC1
      have : ConnectedSpace ↥(B_g.obj E).left := hC2
      have : CategoryTheory.IsIso (η_Y.app (Opposite.op E)) := h_unit_iso_conn Y A E
      have : CategoryTheory.IsIso (u_pre.app (Opposite.op E)) := h_unit_iso_conn X A (B_g.obj E)
      have hfac_E : η_Y.app (Opposite.op E) ≫ u_sh.hom.app (Opposite.op E) =
          u_pre.app (Opposite.op E) :=
        congrArg (fun ν => ν.app (Opposite.op E)) hu_fac
      exact CategoryTheory.IsIso.of_isIso_fac_left hfac_E
    have hMono_ush : CategoryTheory.Mono u_sh := by
      have hMono_hom : CategoryTheory.Mono u_sh.hom := by
        rw [CategoryTheory.NatTrans.mono_iff_mono_app]
        intro W_op
        obtain ⟨D⟩ := W_op
        rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
        intro s hs
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        have hSheaf_ℤ : CategoryTheory.Presieve.IsSheaf J_Y
            ((C_Y.obj A).obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Aℤ))) :=
          (C_Y.obj A).property Aℤ
        let homOfSec : ↥((C_Y.obj A).obj.obj (Opposite.op D)) →
            (Aℤ ⟶ (C_Y.obj A).obj.obj (Opposite.op D)) :=
          fun z => AddCommGrpCat.ofHom
            { toFun := fun n => n.down • z
              map_zero' := zero_zsmul z
              map_add' := fun a b => add_zsmul z a.down b.down }
        let R_D : CategoryTheory.Sieve D :=
          { arrows := fun {_} u => ((C_Y.obj A).obj.map u.op).hom s = 0
            downward_closed := fun {_ _} u hu v => by
              change ((C_Y.obj A).obj.map (u.op ≫ v.op)).hom s = 0
              rw [(C_Y.obj A).obj.map_comp]
              change ((C_Y.obj A).obj.map v.op).hom (((C_Y.obj A).obj.map u.op).hom s) = 0
              rw [hu, map_zero] }
        have hRD_mem : R_D ∈ J_Y D := by
          refine (h_mem_etale Y D R_D).mpr (fun y => ?_)
          obtain ⟨E, u, z, hy, hC1, hC2⟩ := hBasis D y
          have hIso_E : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op E)) :=
            hu_iso_on_conn E hC1 hC2
          have hInj_E : Function.Injective ⇑(u_sh.hom.app (Opposite.op E)).hom :=
            ((CategoryTheory.ConcreteCategory.isIso_iff_bijective
              (u_sh.hom.app (Opposite.op E))).mp hIso_E).1
          refine ⟨E, u, z, ?_, h_mor_etale u, hy⟩
          apply hInj_E
          rw [map_zero]
          have hnat := congrArg (fun φ => φ.hom s) (u_sh.hom.naturality u.op)
          change (u_sh.hom.app (Opposite.op E)).hom (((C_Y.obj A).obj.map u.op).hom s) =
            ((pf_g.obj (C_X.obj A)).obj.map u.op).hom ((u_sh.hom.app (Opposite.op D)).hom s) at hnat
          rw [hnat, hs, map_zero]
        have hSep := (hSheaf_ℤ R_D hRD_mem).isSeparatedFor
        have heq_hom : homOfSec s = (0 : Aℤ ⟶ (C_Y.obj A).obj.obj (Opposite.op D)) := by
          refine hSep.ext (fun V u hu => ?_)
          apply AddCommGrpCat.ext; intro ⟨n⟩
          change ((C_Y.obj A).obj.map u.op).hom (n • s) = ((C_Y.obj A).obj.map u.op).hom 0
          rw [map_zero, map_zsmul, hu, zsmul_zero]
        have h1 := CategoryTheory.ConcreteCategory.congr_hom heq_hom (ULift.up (1 : ℤ))
        simpa [homOfSec] using h1
      exact (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).mono_of_mono_map hMono_hom
    have hEpi_ush : CategoryTheory.Epi u_sh := by
      refine (CategoryTheory.Sheaf.isLocallySurjective_iff_epi'
        (A := AddCommGrpCat.{u}) u_sh).mp ?_
      rw [← CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro D t
      refine (h_mem_etale Y D (CategoryTheory.Presheaf.imageSieve u_sh.hom t)).mpr ?_
      intro y
      obtain ⟨E, u, z, hy, hC1, hC2⟩ := hBasis D y
      have hIso_E : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op E)) :=
        hu_iso_on_conn E hC1 hC2
      refine ⟨E, u, z, ?_, h_mor_etale u, hy⟩
      refine ⟨(CategoryTheory.inv (u_sh.hom.app (Opposite.op E))).hom
          (((pf_g.obj (C_X.obj A)).obj.map u.op).hom t), ?_⟩
      change (CategoryTheory.inv (u_sh.hom.app (Opposite.op E)) ≫
          u_sh.hom.app (Opposite.op E)).hom
          (((pf_g.obj (C_X.obj A)).obj.map u.op).hom t) =
        ((pf_g.obj (C_X.obj A)).obj.map u.op).hom t
      rw [CategoryTheory.IsIso.inv_hom_id]
      rfl
    exact CategoryTheory.isIso_of_mono_of_epi u_sh

  have hConnH0 : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥Z] (m : ℕ),
      Nonempty (weilEtaleTorsionH Z m 0 ≃+ ZMod m) := by
    intro Z hConnZ m
    let T_Z : Z.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Z) (inferInstance : AlgebraicGeometry.Etale (𝟙 Z))
    let hT_Z : CategoryTheory.Limits.IsTerminal T_Z :=
      CategoryTheory.MorphismProperty.Over.mkIdTerminal
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) Z
    let J_Z := Z.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let Fℤ_Z := (CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}).obj Aℤ
    let FM_Z := weilEtaleTorsionSheaf Z m
    let adj_Z := CategoryTheory.constantSheafAdj J_Z AddCommGrpCat.{u} hT_Z
    have h_unit_iso : CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction J_Z AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A_m)).app (Opposite.op T_Z)) :=
      @h_unit_iso_conn Z A_m T_Z hConnZ
    let e₁ : weilEtaleTorsionH Z m 0 ≃+ (Fℤ_Z ⟶ FM_Z) := CategoryTheory.Abelian.Ext.addEquiv₀
    let e₂ : (Fℤ_Z ⟶ FM_Z) ≃+ (Aℤ ⟶ FM_Z.obj.obj (Opposite.op T_Z)) :=
      { toEquiv := adj_Z.homEquiv Aℤ FM_Z
        map_add' := fun f₁ f₂ => by
          change (adj_Z.homEquiv Aℤ FM_Z) (f₁ + f₂) =
            (adj_Z.homEquiv Aℤ FM_Z) f₁ + (adj_Z.homEquiv Aℤ FM_Z) f₂
          rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Adjunction.homEquiv_unit]
          change adj_Z.unit.app Aℤ ≫ (f₁.hom.app (Opposite.op T_Z) + f₂.hom.app (Opposite.op T_Z)) = _
          exact CategoryTheory.Preadditive.comp_add _ _ _ _ _ _ }
    let e₃ : (Aℤ ⟶ FM_Z.obj.obj (Opposite.op T_Z)) ≃+ ↥(FM_Z.obj.obj (Opposite.op T_Z)) :=
      { toFun := fun φ => φ.hom (ULift.up (1 : ℤ))
        invFun := fun g => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • g
            map_zero' := zero_zsmul g
            map_add' := fun a b => add_zsmul g a.down b.down }
        left_inv := fun φ => by
          apply AddCommGrpCat.ext; intro ⟨n⟩
          change n • φ.hom (ULift.up (1 : ℤ)) = φ.hom ⟨n⟩
          have hn : (⟨n⟩ : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) := by
            ext; simp
          rw [hn, map_zsmul]
        right_inv := fun g => one_zsmul g
        map_add' := fun _ _ => rfl }
    let u_TZ : A_m ⟶ FM_Z.obj.obj (Opposite.op T_Z) :=
      ((CategoryTheory.sheafificationAdjunction J_Z AddCommGrpCat.{u}).unit.app
        ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A_m)).app (Opposite.op T_Z)
    let iso_TZ : A_m ≅ FM_Z.obj.obj (Opposite.op T_Z) := @CategoryTheory.asIso _ _ _ _ u_TZ h_unit_iso
    let e₄ : ↥(FM_Z.obj.obj (Opposite.op T_Z)) ≃+ ZMod m :=
      { toFun := fun x => (iso_TZ.inv.hom x).down
        invFun := fun c => iso_TZ.hom.hom (ULift.up c)
        left_inv := fun x => by
          change (iso_TZ.inv ≫ iso_TZ.hom).hom x = x
          rw [iso_TZ.inv_hom_id]; rfl
        right_inv := fun c => by
          have h : (iso_TZ.hom ≫ iso_TZ.inv).hom (ULift.up c) = ULift.up c := by
            rw [iso_TZ.hom_inv_id]; rfl
          exact congrArg ULift.down h
        map_add' := fun x y => by
          rw [map_add]; rfl }
    exact ⟨e₁.trans (e₂.trans (e₃.trans e₄))⟩

  
  
  
  have hPullbackIsoLeft : ∀ {X₁ X₂ Y S : AlgebraicGeometry.Scheme.{u}}
      (e : X₁ ≅ X₂) (g₁ : X₁ ⟶ S) (g₂ : X₂ ⟶ S) (h : Y ⟶ S),
      e.hom ≫ g₂ = g₁ →
      Nonempty (CategoryTheory.Limits.pullback g₁ h ≅ CategoryTheory.Limits.pullback g₂ h) := by
    intro X₁ X₂ Y S e g₁ g₂ h he
    refine ⟨{
      hom := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₁ h ≫ e.hom)
        (CategoryTheory.Limits.pullback.snd g₁ h)
        (by rw [CategoryTheory.Category.assoc, he, CategoryTheory.Limits.pullback.condition])
      inv := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₂ h ≫ e.inv)
        (CategoryTheory.Limits.pullback.snd g₂ h)
        (by rw [CategoryTheory.Category.assoc, ← he, ← CategoryTheory.Category.assoc e.inv,
            e.inv_hom_id, CategoryTheory.Category.id_comp, CategoryTheory.Limits.pullback.condition])
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Category.assoc,
            e.hom_inv_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Category.assoc,
            e.inv_hom_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] }⟩

  have hSquares : ∀ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (d M : ℕ) (W : Fin M → B.left.Opens)
      (ψ : ∀ α : Fin M, (W α).toScheme ⟶ (weilAffineSpaceOver Ω d).left)
      [∀ α : Fin M, AlgebraicGeometry.Etale (ψ α)],
      (∀ α : Fin M, ψ α ≫ (weilAffineSpaceOver Ω d).hom = (W α).ι ≫ B.hom) →
      let S_d := weilAffineSpaceOver Ω d
      let S_1 := weilAffineSpaceOver Ω 1
      let V := CategoryTheory.Limits.pullback B.hom S_1.hom
      let π := CategoryTheory.Limits.pullback.fst B.hom S_1.hom
      let P_d := CategoryTheory.Limits.pullback S_d.hom S_1.hom
      let pr₁ := CategoryTheory.Limits.pullback.fst S_d.hom S_1.hom
      ∀ α : Fin M,
        ∃ (V_α : AlgebraicGeometry.Scheme.{u})
          (π_α : V_α ⟶ (W α).toScheme)
          (ι_Vα : V_α ⟶ V) (_ : AlgebraicGeometry.Etale ι_Vα)
          (g_α : V_α ⟶ P_d) (_ : AlgebraicGeometry.Etale g_α),
          CategoryTheory.IsPullback π_α ι_Vα (W α).ι π ∧
          CategoryTheory.IsPullback π_α g_α (ψ α) pr₁ := by
    intro B d M W ψ _ hψ_hom S_d S_1 V π P_d pr₁ α
    let V_α := CategoryTheory.Limits.pullback (W α).ι π
    let π_α := CategoryTheory.Limits.pullback.fst (W α).ι π
    let ι_Vα := CategoryTheory.Limits.pullback.snd (W α).ι π
    have hPb₁ : CategoryTheory.IsPullback π_α ι_Vα (W α).ι π :=
      CategoryTheory.IsPullback.of_hasPullback (W α).ι π
    have hEt_ι : AlgebraicGeometry.Etale ι_Vα :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₁ inferInstance
    let snd_V := CategoryTheory.Limits.pullback.snd B.hom S_1.hom
    have hPbV : CategoryTheory.IsPullback π snd_V B.hom S_1.hom :=
      CategoryTheory.IsPullback.of_hasPullback B.hom S_1.hom
    have h_comm : (π_α ≫ ψ α) ≫ S_d.hom = (ι_Vα ≫ snd_V) ≫ S_1.hom := by
      rw [CategoryTheory.Category.assoc, hψ_hom α, ← CategoryTheory.Category.assoc, hPb₁.w,
        CategoryTheory.Category.assoc, hPbV.w, ← CategoryTheory.Category.assoc]
    let g_α : V_α ⟶ P_d := CategoryTheory.Limits.pullback.lift (π_α ≫ ψ α) (ι_Vα ≫ snd_V) h_comm
    have hOuter : CategoryTheory.IsPullback π_α
        (g_α ≫ CategoryTheory.Limits.pullback.snd S_d.hom S_1.hom)
        (ψ α ≫ S_d.hom) S_1.hom := by
      rw [CategoryTheory.Limits.pullback.lift_snd, hψ_hom α]
      exact hPb₁.paste_vert hPbV
    have hBot : CategoryTheory.IsPullback pr₁
        (CategoryTheory.Limits.pullback.snd S_d.hom S_1.hom) S_d.hom S_1.hom :=
      CategoryTheory.IsPullback.of_hasPullback S_d.hom S_1.hom
    have hPb₂ : CategoryTheory.IsPullback π_α g_α (ψ α) pr₁ :=
      CategoryTheory.IsPullback.of_bot hOuter
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm hBot
    have hEt_g : AlgebraicGeometry.Etale g_α :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₂ inferInstance
    exact ⟨V_α, π_α, ι_Vα, hEt_ι, g_α, hEt_g, hPb₁, hPb₂⟩

  have hBasis : ∀ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (d M : ℕ) (W : Fin M → B.left.Opens)
      (ψ : ∀ α : Fin M, (W α).toScheme ⟶ (weilAffineSpaceOver Ω d).left)
      [∀ α : Fin M, AlgebraicGeometry.Etale (ψ α)],
      (⨆ α : Fin M, W α) = ⊤ →
      let π := CategoryTheory.Limits.pullback.fst B.hom (weilAffineSpaceOver Ω 1).hom
      ∀ (D : B.left.Etale) (y : ↥D.left),
        ∃ (E : B.left.Etale) (u : Quiver.Hom E D) (z : ↥E.left),
          u.left.base z = y ∧
          ConnectedSpace ↥E.left ∧
          ConnectedSpace ↥((weilEtaleSitePullback π).obj E).left := by
    intro B d M W ψ _ hSup π D y
    have hy_top : D.hom.base y ∈ (⨆ α : Fin M, W α) := by
      rw [hSup]; trivial
    obtain ⟨α, hy_Wα⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_top
    let O₁ : D.left.Opens := (TopologicalSpace.Opens.map D.hom.base).obj (W α)
    have hy_O₁ : y ∈ O₁ := hy_Wα
    obtain ⟨O₂, hAff2, hy_O₂, hO₂_le⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := O₁) hy_O₁
    have : AlgebraicGeometry.IsAffine O₂.toScheme := hAff2
    have hrange_O₂ : Set.range (O₂.ι ≫ D.hom).base ⊆ Set.range (W α).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      exact hO₂_le w.2
    let v_W : O₂.toScheme ⟶ (W α).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (W α).ι (O₂.ι ≫ D.hom) hrange_O₂
    have hv_W : v_W ≫ (W α).ι = O₂.ι ≫ D.hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (W α).ι (O₂.ι ≫ D.hom) hrange_O₂
    have hEt_O₂D : AlgebraicGeometry.Etale (O₂.ι ≫ D.hom) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        O₂.ι D.hom inferInstance D.prop
    have hEt_vW : AlgebraicGeometry.Etale v_W :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        v_W (W α).ι (inferInstance : AlgebraicGeometry.Etale (W α).ι) (hv_W.symm ▸ hEt_O₂D)
    let u_X : O₂.toScheme ⟶ (weilAffineSpaceOver Ω d).left := v_W ≫ ψ α
    have : AlgebraicGeometry.Etale u_X :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        v_W (ψ α) hEt_vW inferInstance
    let y₂ : ↥O₂.toScheme := ⟨y, hy_O₂⟩
