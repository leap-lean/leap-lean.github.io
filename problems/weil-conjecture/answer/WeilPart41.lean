        · rw [Category.assoc, CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd,
            Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          calc
            f_ua ≫ CategoryTheory.Limits.pullback.fst w' j
