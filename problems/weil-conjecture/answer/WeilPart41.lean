          (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k))) =
        σ₀.toRingHom.comp (algebraMap (Polynomial k) (Localization.Away Q))) ∧
      (((algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))).comp
          (Polynomial.aeval (Polynomial.C c₀ + Polynomial.C lam₀ * Polynomial.X : Polynomial k)).toRingHom =
        σ_glue.toRingHom.comp (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)))) ∨
       (σ_glue (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)) Polynomial.X) =
        algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)) (Polynomial.C c₀) +
        algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)) (Polynomial.C lam₀) *
          IsLocalization.Away.invSelf (Polynomial.X : Polynomial k))) := by
    let R_T := Localization.Away (Polynomial.X : Polynomial k)
    let R_Q := Localization.Away Q
    let ι_T_hom : Polynomial k →+* R_T := algebraMap (Polynomial k) R_T
    let ι_Q_hom : Polynomial k →+* R_Q := algebraMap (Polynomial k) R_Q
    have hι_T_inj : Function.Injective ι_T_hom :=
      IsLocalization.injective R_T
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero))
    have hι_Q_inj : Function.Injective ι_Q_hom :=
      IsLocalization.injective R_Q
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hQ_ne))
    let u_T : R_Tˣ :=
      Units.mkOfMulEqOne (ι_T_hom Polynomial.X)
        (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k))
        (IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial k))
    have hu_T_val : (u_T : R_T) = ι_T_hom Polynomial.X := rfl
    have hu_T_inv : (↑u_T⁻¹ : R_T) = IsLocalization.Away.invSelf (Polynomial.X : Polynomial k) := rfl
    have hu_T_zpow_nat : ∀ n : ℕ, (↑(u_T ^ (n : ℤ)) : R_T) = ι_T_hom (Polynomial.X ^ n) := by
      intro n
      rw [zpow_natCast, Units.val_pow_eq_pow_val, hu_T_val, map_pow]
    have h_dvd_X_pow : ∀ (N : ℕ) (A B : Polynomial k),
        A * B = (Polynomial.X : Polynomial k) ^ N →
        ∃ (μ : k) (_ : μ ≠ 0) (d : ℕ), A = Polynomial.C μ * Polynomial.X ^ d := by
      intro N
      induction N with
      | zero =>
        intro A B hAB
        rw [pow_zero] at hAB
        have hUnitA : IsUnit A := ⟨⟨A, B, hAB, mul_comm A B ▸ hAB⟩, rfl⟩
        rw [Polynomial.isUnit_iff] at hUnitA
        obtain ⟨μ, hμ_unit, hA_eq⟩ := hUnitA
        exact ⟨μ, hμ_unit.ne_zero, 0, by rw [pow_zero, mul_one, hA_eq]⟩
      | succ N ih =>
        intro A B hAB
        have hev0 : A.eval 0 * B.eval 0 = 0 := by
          have h1 := congrArg (Polynomial.eval 0) hAB
