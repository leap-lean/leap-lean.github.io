        inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (Category.id_comp (𝟙 V)) (Subsingleton.elim _ _) }
    have hZero_Vet : CategoryTheory.Limits.IsZero (R₁.obj.obj (Opposite.op V_et)) :=
      hZero_sec.of_iso (R₁.obj.mapIso e_obj.op).symm
    exact ⟨fun a b =>
      (congrArg (fun φ : R₁.obj.obj (Opposite.op V_et) ⟶ R₁.obj.obj (Opposite.op V_et) => φ.hom a)
          (hZero_Vet.eq_of_src (𝟙 _) 0)).trans
        (congrArg (fun φ : R₁.obj.obj (Opposite.op V_et) ⟶ R₁.obj.obj (Opposite.op V_et) => φ.hom b)
          (hZero_Vet.eq_of_src (𝟙 _) 0)).symm⟩

  
  have hLocalIff : ∀ (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
      (v : V ⟶ Y.left) [hv : AlgebraicGeometry.Etale v] (c : ZMod ℓ),
      let V_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ v hv
      (u_i.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up c)) = 0 ↔
        (ψ_0.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up c)) = 0 := by
    intro V _ v hv c V_et
    by_cases hc : c = 0
    · subst hc
      have h_η0 : η_Y.app (Opposite.op V_et) (ULift.up (0 : ZMod ℓ)) = 0 :=
        (η_Y.app (Opposite.op V_et)).hom.map_zero
      have hL0 : (u_i.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up 0)) = 0 := by
        rw [h_η0]; exact (u_i.hom.app (Opposite.op V_et)).hom.map_zero
      have hR0 : (ψ_0.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up 0)) = 0 := by
        rw [h_η0]; exact (ψ_0.hom.app (Opposite.op V_et)).hom.map_zero
      exact ⟨fun _ => hR0, fun _ => hL0⟩
    · by_cases hEmp : IsEmpty ↥(B_i.obj V_et).left
      · have hL0 : (u_i.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up c)) = 0 :=
          (hEmptySub Z (B_i.obj V_et) hEmp F_Z).elim _ _
        have hRange_v : Set.range v.base ⊆ Set.range j.base := by
          rintro _ ⟨y, rfl⟩
          have h_not_i : v.base y ∉ Set.range i.base := by
            rintro ⟨z, hz⟩
            obtain ⟨q, -, -⟩ :=
              AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y z hz.symm
            exact hEmp.false q
          rw [hCompl, Set.mem_compl_iff, not_not] at h_not_i
          exact h_not_i
        let v_U : V ⟶ U := AlgebraicGeometry.IsOpenImmersion.lift j v hRange_v
        have hv_U_fac : v_U ≫ j = v := AlgebraicGeometry.IsOpenImmersion.lift_fac j v hRange_v
        obtain ⟨G₀, hPB_j, hZero_G₀⟩ := hOpenZero_j
        obtain ⟨H_V, hPB_vU, _, hZero_imp⟩ := hExPB v_U G₀
        have hPB_v : WeilIsEtaleSheafPullback v R₁ H_V := by
          rw [← hv_U_fac]
          exact (hCompPB v_U j R₁ G₀ H_V).1 hPB_j hPB_vU
        have hSub_R1 : Subsingleton ↥(R₁.obj.obj (Opposite.op V_et)) :=
          hEtaleSliceZero V v ⟨H_V, hPB_v, hZero_imp hZero_G₀⟩
        have hR0 : (ψ_0.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up c)) = 0 :=
          hSub_R1.elim _ _
        exact ⟨fun _ => hR0, fun _ => hL0⟩
      · obtain ⟨q₀⟩ := not_isEmpty_iff.mp hEmp
        have hL_ne : (u_i.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up c)) ≠ 0 := by
          rw [hu_app V_et (ULift.up c)]
          intro h0
          have h0' : (CategoryTheory.toSheafify J_Z constZ).app (Opposite.op (B_i.obj V_et))
              (ULift.up c : ↥(constZ.obj (Opposite.op (B_i.obj V_et)))) =
            (CategoryTheory.toSheafify J_Z constZ).app (Opposite.op (B_i.obj V_et))
              (0 : ↥(constZ.obj (Opposite.op (B_i.obj V_et)))) :=
            h0.trans ((η_Z.app (Opposite.op (B_i.obj V_et))).hom.map_zero).symm
          have hEqSieve :=
            CategoryTheory.Presheaf.equalizerSieve_mem J_Z
              (CategoryTheory.toSheafify J_Z constZ) _ _ h0'
          obtain ⟨W₀, g₀, _, hg₀_eq, _, _⟩ := (hMemEtale Z (B_i.obj V_et) _).mp hEqSieve q₀
          have hc_eq : (constZ.map g₀.op) (ULift.up c) = (constZ.map g₀.op) (0 : ↥A_ℓ) := hg₀_eq
          exact hc (congrArg ULift.down hc_eq)
        have hR_ne : (ψ_0.hom.app (Opposite.op V_et)) (η_Y.app (Opposite.op V_et) (ULift.up c)) ≠ 0 := by
          rw [hψ_app V_et c]
          intro h0
          let x₀ : ↥V := (CategoryTheory.Limits.pullback.fst v i).base q₀
          let z₀ : ↥Z := (CategoryTheory.Limits.pullback.snd v i).base q₀
          have hx₀_out : v.base x₀ ∉ Set.range j.base := by
            have hx₀_in_i : v.base x₀ ∈ Set.range i.base :=
              ⟨z₀, (congrArg (fun m => m.base q₀)
                (CategoryTheory.Limits.pullback.condition (f := v) (g := i))).symm⟩
            rw [hCompl] at hx₀_in_i
            exact hx₀_in_i
          let κ₀ : Type u := ↥(V.residueField x₀)
          let Ω₀ : Type u := AlgebraicClosure κ₀
          let z_tilde : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ V :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ₀ Ω₀)) ≫
              V.fromSpecResidueField x₀
          let z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Y.left := z_tilde ≫ v
          have hzt_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω₀)),
              z_tilde.base pt = x₀ := by
            intro pt
            change (V.fromSpecResidueField x₀).base _ = x₀
            exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply x₀ _
          have hzb_out : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω₀)),
              z_bar.base pt ∉ Set.range j.base := by
            intro pt
            change v.base (z_tilde.base pt) ∉ Set.range j.base
            rw [hzt_pt pt]
            exact hx₀_out
          let q_sec : ↥(Q₁.obj (Opposite.op V_et)) :=
            c.val • ((Q₁.map (hT_Y.from V_et).op).hom ξ_tilde0)
          have h0' : (CategoryTheory.toSheafify J_Y Q₁).app (Opposite.op V_et) q_sec =
              (CategoryTheory.toSheafify J_Y Q₁).app (Opposite.op V_et)
                (0 : ↥(Q₁.obj (Opposite.op V_et))) :=
            h0.trans ((η_Q1.app (Opposite.op V_et)).hom.map_zero).symm
          have hEqSieve :=
            CategoryTheory.Presheaf.equalizerSieve_mem J_Y (CategoryTheory.toSheafify J_Y Q₁)
              q_sec _ h0'
          obtain ⟨W₁, u₁, y₁, hu₁_eq, hEt_u1, hy₁⟩ := (hMemEtale Y.left V_et _).mp hEqSieve x₀
          obtain ⟨O₁, hAff_O1, hy₁_O1, -⟩ :=
            AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
              (x := y₁) (U := (⊤ : W₁.left.Opens)) trivial
          let V' := O₁.toScheme
          have _ : AlgebraicGeometry.IsAffine V' := hAff_O1
          let u₁_left : W₁.left ⟶ V := u₁.left
          have _ : AlgebraicGeometry.Etale u₁_left := hEt_u1
          let g₁ : V' ⟶ V := O₁.ι ≫ u₁_left
          have _ : AlgebraicGeometry.Etale g₁ := inferInstance
          let v' : V' ⟶ Y.left := g₁ ≫ v
          have hEt_v' : AlgebraicGeometry.Etale v' := inferInstance
          have _ : AlgebraicGeometry.Etale v' := hEt_v'
          let V'_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ v' hEt_v'
          have hi_O1_w : O₁.ι ≫ W₁.hom = v' := by
            have hw1 : u₁_left ≫ v = W₁.hom := CategoryTheory.MorphismProperty.Over.w u₁
            calc
              O₁.ι ≫ W₁.hom = O₁.ι ≫ (u₁_left ≫ v) := by rw [hw1]
              _ = (O₁.ι ≫ u₁_left) ≫ v := (Category.assoc _ _ _).symm
          let i_O1 : V'_et ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk O₁.ι hi_O1_w trivial
          have hc_Q1_zero : c.val • ((Q₁.map (hT_Y.from V'_et).op).hom ξ_tilde0) = 0 := by
            have h_u1_zero : (Q₁.map u₁.op).hom q_sec = 0 := by
              have h1 : (Q₁.map u₁.op) q_sec = (Q₁.map u₁.op) (0 : ↥(Q₁.obj (Opposite.op V_et))) := hu₁_eq
              exact h1.trans ((Q₁.map u₁.op).hom.map_zero)
            have h_from : (i_O1 ≫ u₁) ≫ hT_Y.from V_et = hT_Y.from V'_et := hT_Y.hom_ext _ _
            have h_op : (hT_Y.from V'_et).op = (hT_Y.from V_et).op ≫ u₁.op ≫ i_O1.op := by
              rw [← h_from]; rfl
            rw [h_op, Q₁.map_comp, Q₁.map_comp]
            change c.val • ((Q₁.map i_O1.op).hom ((Q₁.map u₁.op).hom ((Q₁.map (hT_Y.from V_et).op).hom ξ_tilde0))) = 0
            rw [← map_nsmul (Q₁.map i_O1.op).hom, ← map_nsmul (Q₁.map u₁.op).hom]
            change (Q₁.map i_O1.op).hom ((Q₁.map u₁.op).hom q_sec) = 0
            rw [h_u1_zero, map_zero]
          have hQ1_zero : (Q₁.map (hT_Y.from V'_et).op).hom ξ_tilde0 = 0 :=
            hZModCancel _ (hTors_Q1 V'_et) c hc hc_Q1_zero
          
          let P_z := CategoryTheory.Limits.pullback g₁ z_tilde
          let snd_z : P_z ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₀) :=
            CategoryTheory.Limits.pullback.snd g₁ z_tilde
          have _ : AlgebraicGeometry.Etale snd_z := inferInstance
          let U_z : (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)).Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ snd_z inferInstance
          let y'_1 : ↥V' := ⟨y₁, hy₁_O1⟩
          let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) := (⊥ : PrimeSpectrum Ω₀)
          have hg₁_y : g₁.base y'_1 = z_tilde.base pt₀ := by
            rw [hzt_pt pt₀]
            exact hy₁
          obtain ⟨p_z, -, -⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y'_1 pt₀ hg₁_y
          obtain ⟨f_z, -, -⟩ := hCoverByTK Ω₀ U_z p_z
          let σ_z_hom : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ P_z := f_z.left
          have hσ_z_snd : σ_z_hom ≫ snd_z = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) :=
            CategoryTheory.MorphismProperty.Over.w f_z
          let z_tilde' : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ V' :=
            σ_z_hom ≫ CategoryTheory.Limits.pullback.fst g₁ z_tilde
          have hzt'_v' : z_tilde' ≫ v' = z_bar := by
            calc
              (σ_z_hom ≫ CategoryTheory.Limits.pullback.fst g₁ z_tilde) ≫ (g₁ ≫ v)
                = σ_z_hom ≫ (CategoryTheory.Limits.pullback.fst g₁ z_tilde ≫ g₁) ≫ v := by
                    simp only [Category.assoc]
              _ = σ_z_hom ≫ (snd_z ≫ z_tilde) ≫ v := by
                    dsimp [snd_z]
                    rw [CategoryTheory.Limits.pullback.condition]
              _ = (σ_z_hom ≫ snd_z) ≫ z_bar := by
                    dsimp [z_bar]
                    simp only [Category.assoc]
              _ = z_bar := by rw [hσ_z_snd, Category.id_comp]
          obtain ⟨p_V', hp_V'⟩ := hPullEx (CategoryTheory.Limits.pullback.fst j v') ℓ 1
          let e_symm' := CategoryTheory.Limits.pullbackSymmetry v' j
          obtain ⟨p_shom, hp_shom⟩ := hPullEx e_symm'.hom ℓ 1
          obtain ⟨p_sinv, hp_sinv⟩ := hPullEx e_symm'.inv ℓ 1
          have hp_sinv_hom : p_sinv.comp p_shom = AddMonoidHom.id _ := by
            obtain ⟨p_id, hp_id⟩ := hPullEx (e_symm'.inv ≫ e_symm'.hom) ℓ 1
            have h1 := hPullComp e_symm'.inv e_symm'.hom ℓ 1 p_sinv p_shom p_id hp_sinv hp_shom hp_id
            rw [e_symm'.inv_hom_id] at hp_id
            exact h1.symm.trans (hPullId ℓ 1 p_id hp_id)
          let ev'_sch : AlgebraicGeometry.Scheme.{u} := (B_j.obj V'_et).left
          let ev'_hom : ev'_sch ⟶ U := (B_j.obj V'_et).hom
          obtain ⟨p_EV', hp_EV'⟩ := hPullEx ev'_hom ℓ 1
          have hp_EV'_eq : p_EV' = p_shom.comp p_V' := by
            have h_hom_eq : e_symm'.hom ≫ CategoryTheory.Limits.pullback.fst j v' = ev'_hom :=
              CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst v' j
            exact hPullComp e_symm'.hom (CategoryTheory.Limits.pullback.fst j v') ℓ 1
              p_shom p_V' p_EV' hp_shom hp_V' (by rwa [h_hom_eq])
          have hp_shom_zero : p_shom (p_V' ξ₀) = 0 := by
            have h_ev0 : p_EV' ξ₀ = 0 :=
              (hEval_ξ0 V'_et p_EV' hp_EV').symm.trans
                ((congrArg (Θ (B_j.obj V'_et)) hQ1_zero).trans (Θ (B_j.obj V'_et)).map_zero)
            exact (congrArg (fun f : _ →+ _ => f ξ₀) hp_EV'_eq.symm).trans h_ev0
          have hpV'_zero : p_V' ξ₀ = 0 := by
            have h1 := congrArg p_sinv hp_shom_zero
            rw [map_zero] at h1
            exact (congrArg (fun f : _ →+ _ => f (p_V' ξ₀)) hp_sinv_hom).symm.trans h1
          exact hBdryNeZero Ω₀ z_bar hzb_out V' v' z_tilde' hzt'_v' p_V' hp_V' hpV'_zero
        exact ⟨fun h => False.elim (hL_ne h), fun h => False.elim (hR_ne h)⟩

  
  have hSecZeroIff : ∀ (E : Y.left.Etale) (s : ↥(F_Y.obj.obj (Opposite.op E))),
      (u_i.hom.app (Opposite.op E)) s = 0 ↔ (ψ_0.hom.app (Opposite.op E)) s = 0 := by
    intro E s
    let R_cov : CategoryTheory.Sieve E :=
      { arrows := fun W_c g_arr =>
          ∃ (V_et : Y.left.Etale) (_ : AlgebraicGeometry.IsAffine V_et.left)
            (h_W : W_c ⟶ V_et) (g_V : V_et ⟶ E) (c : ZMod ℓ),
            h_W ≫ g_V = g_arr ∧
            (F_Y.obj.map g_V.op) s = η_Y.app (Opposite.op V_et) (ULift.up c)
        downward_closed := by
          rintro W₁ W₂ g_arr ⟨V_et, hAffV, h_W, g_V, c, rfl, hs_V⟩ k
          exact ⟨V_et, hAffV, k ≫ h_W, g_V, c, Category.assoc k h_W g_V, hs_V⟩ }
    have hRcov_mem : R_cov ∈ J_Y E := by
      rw [hMemEtale]
      intro x
      let s_sh : ↥((CategoryTheory.sheafify J_Y constY).obj (Opposite.op E)) := s
      have hImg : CategoryTheory.Presheaf.imageSieve
          (CategoryTheory.toSheafify J_Y constY) s_sh ∈ J_Y E :=
        CategoryTheory.Presheaf.imageSieve_mem J_Y (CategoryTheory.toSheafify J_Y constY) s_sh
      obtain ⟨W₀, u₀, y₀, hu₀_img, hEt_u0, hy₀⟩ := (hMemEtale Y.left E _).mp hImg x
      obtain ⟨c₀_raw, hc₀⟩ := hu₀_img
      let c₀ : ↥A_ℓ := c₀_raw
      obtain ⟨O₀, hAff_O0, hy₀_O0, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := y₀) (U := (⊤ : W₀.left.Opens)) trivial
      let V := O₀.toScheme
      let v : V ⟶ Y.left := O₀.ι ≫ W₀.hom
      have hv : AlgebraicGeometry.Etale v :=
        CategoryTheory.MorphismProperty.comp_mem P_et O₀.ι W₀.hom inferInstance W₀.prop
      let V_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ v hv
      let i_O : V_et ⟶ W₀ := CategoryTheory.MorphismProperty.Over.homMk O₀.ι rfl trivial
      let g_V : V_et ⟶ E := i_O ≫ u₀
      have hEt_gV : AlgebraicGeometry.Etale g_V.left :=
        CategoryTheory.MorphismProperty.comp_mem P_et O₀.ι u₀.left inferInstance hEt_u0
      refine ⟨V_et, g_V, ⟨y₀, hy₀_O0⟩, ?_, hEt_gV, hy₀⟩
      refine ⟨V_et, hAff_O0, 𝟙 V_et, g_V, c₀.down, Category.id_comp g_V, ?_⟩
      have h_op : g_V.op = u₀.op ≫ i_O.op := rfl
      rw [h_op, F_Y.obj.map_comp]
      have hnat_iO := (congrArg (fun τ => τ c₀) (η_Y.naturality i_O.op)).symm
      exact (congrArg (F_Y.obj.map i_O.op) hc₀.symm).trans hnat_iO
    constructor
    · intro hu0
      refine R₁.isSeparated E R_cov hRcov_mem _ 0 (fun W_c g_arr h_mem => ?_)
      rcases h_mem with ⟨V_et, hAffV, h_W, g_V, c, hg, hs_V⟩
      subst hg
      let _ : AlgebraicGeometry.IsAffine V_et.left := hAffV
      let _ : AlgebraicGeometry.Etale (V_et.hom : V_et.left ⟶ Y.left) := V_et.prop
      have hVet_eq : (CategoryTheory.MorphismProperty.Over.mk ⊤ (V_et.hom : V_et.left ⟶ Y.left) V_et.prop :
          Y.left.Etale) = V_et := by
        cases V_et
        rfl
      rw [map_zero, op_comp, R₁.obj.map_comp]
      have h_gV_ψ : (R₁.obj.map g_V.op) ((ψ_0.hom.app (Opposite.op E)) s) = 0 := by
        have hnat_ψ := congrArg (fun τ => τ s) (ψ_0.hom.naturality g_V.op)
        have hiff := hLocalIff V_et.left (V_et.hom : V_et.left ⟶ Y.left) c
        dsimp only at hiff
        rw [hVet_eq] at hiff
        have hnat_u := congrArg (fun τ => τ s) (u_i.hom.naturality g_V.op)
        have hu_Vet : (u_i.hom.app (Opposite.op V_et))
            (η_Y.app (Opposite.op V_et) (ULift.up c)) = 0 := by
          rw [← hs_V]
          exact hnat_u.trans (by
            change ((pf_i.obj F_Z).obj.map g_V.op) ((u_i.hom.app (Opposite.op E)) s) = 0
            rw [hu0, map_zero])
        have hψ_Vet : (ψ_0.hom.app (Opposite.op V_et)) ((F_Y.obj.map g_V.op) s) = 0 := by
          rw [hs_V]
          exact hiff.mp hu_Vet
        exact hnat_ψ.symm.trans hψ_Vet
      change (R₁.obj.map h_W.op) ((R₁.obj.map g_V.op) ((ψ_0.hom.app (Opposite.op E)) s)) = 0
      rw [h_gV_ψ, map_zero]
    · intro hψ0
      refine (pf_i.obj F_Z).isSeparated E R_cov hRcov_mem _ 0 (fun W_c g_arr h_mem => ?_)
      rcases h_mem with ⟨V_et, hAffV, h_W, g_V, c, hg, hs_V⟩
      subst hg
      let _ : AlgebraicGeometry.IsAffine V_et.left := hAffV
      let _ : AlgebraicGeometry.Etale (V_et.hom : V_et.left ⟶ Y.left) := V_et.prop
      have hVet_eq : (CategoryTheory.MorphismProperty.Over.mk ⊤ (V_et.hom : V_et.left ⟶ Y.left) V_et.prop :
          Y.left.Etale) = V_et := by
        cases V_et
        rfl
      rw [map_zero, op_comp, (pf_i.obj F_Z).obj.map_comp]
      have h_gV_u : ((pf_i.obj F_Z).obj.map g_V.op) ((u_i.hom.app (Opposite.op E)) s) = 0 := by
        have hnat_u := congrArg (fun τ => τ s) (u_i.hom.naturality g_V.op)
        have hiff := hLocalIff V_et.left (V_et.hom : V_et.left ⟶ Y.left) c
        dsimp only at hiff
        rw [hVet_eq] at hiff
        have hnat_ψ := congrArg (fun τ => τ s) (ψ_0.hom.naturality g_V.op)
        have hψ_Vet : (ψ_0.hom.app (Opposite.op V_et))
            (η_Y.app (Opposite.op V_et) (ULift.up c)) = 0 := by
          rw [← hs_V]
          exact hnat_ψ.trans (by
            change (R₁.obj.map g_V.op) ((ψ_0.hom.app (Opposite.op E)) s) = 0
            rw [hψ0, map_zero])
        have hu_Vet : (u_i.hom.app (Opposite.op V_et)) ((F_Y.obj.map g_V.op) s) = 0 := by
          rw [hs_V]
          exact hiff.mpr hψ_Vet
        exact hnat_u.symm.trans hu_Vet
      change ((pf_i.obj F_Z).obj.map h_W.op)
          (((pf_i.obj F_Z).obj.map g_V.op) ((u_i.hom.app (Opposite.op E)) s)) = 0
      rw [h_gV_u, map_zero]

  have hKer1 : CategoryTheory.Limits.kernel.ι u_i ≫ ψ_0 = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext E_op
    apply AddCommGrpCat.ext
    intro s
    have hcond : ((CategoryTheory.Limits.kernel.ι u_i ≫ u_i).hom.app E_op) s = 0 := by
      rw [CategoryTheory.Limits.kernel.condition]; rfl
    exact (hSecZeroIff E_op.unop (((CategoryTheory.Limits.kernel.ι u_i).hom.app E_op) s)).mp hcond

  have hKer2 : CategoryTheory.Limits.kernel.ι ψ_0 ≫ u_i = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext E_op
    apply AddCommGrpCat.ext
    intro s
    have hcond : ((CategoryTheory.Limits.kernel.ι ψ_0 ≫ ψ_0).hom.app E_op) s = 0 := by
      rw [CategoryTheory.Limits.kernel.condition]; rfl
    exact (hSecZeroIff E_op.unop (((CategoryTheory.Limits.kernel.ι ψ_0).hom.app E_op) s)).mpr hcond

  have _ : CategoryTheory.Epi u_i := hEpi_ui
