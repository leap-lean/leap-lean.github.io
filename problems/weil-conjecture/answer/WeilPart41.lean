  obtain ⟨hClosedOpenOrth, hBocksteinSub, hVerdierExc⟩ :=
    weil_quad_cvs_smooth_proper_closed_open_verdier_excision.{u}
  obtain ⟨hPullCup, hClopenProd, hPointModif⟩ :=
    weil_quad_cvs_pullback_cup_clopen_and_point_modif_split.{u}
  obtain ⟨hProjStepCharts, hConeBlowupCharts, hSmSliceCharts⟩ :=
    weil_quad_cvs_given_cone_blowup_and_smooth_slice_charts.{u}

  have hPullTri : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : S₁ ⟶ S₂) (h₂ : S₂ ⟶ S₃) (h₁₂ : S₁ ⟶ S₃) (n_mod q : ℕ)
      (p₁ : weilEtaleTorsionH S₂ n_mod q →+ weilEtaleTorsionH S₁ n_mod q)
      (p₂ : weilEtaleTorsionH S₃ n_mod q →+ weilEtaleTorsionH S₂ n_mod q)
      (p₁₂ : weilEtaleTorsionH S₃ n_mod q →+ weilEtaleTorsionH S₁ n_mod q),
      h₁ ≫ h₂ = h₁₂ →
      WeilIsTorsionEtalePullback h₁ n_mod q p₁ →
      WeilIsTorsionEtalePullback h₂ n_mod q p₂ →
      WeilIsTorsionEtalePullback h₁₂ n_mod q p₁₂ →
      ∀ z : weilEtaleTorsionH S₃ n_mod q, p₁₂ z = p₁ (p₂ z) := by
    intro S₁ S₂ S₃ h₁ h₂ h₁₂ n_mod q p₁ p₂ p₁₂ h_eq hp₁ hp₂ hp₁₂ z
    subst h_eq
    exact DFunLike.congr_fun (hPullComp h₁ h₂ n_mod q p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂) z

  have hPullIsoBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (n_mod q : ℕ)
      (p_hom : weilEtaleTorsionH S₂ n_mod q →+ weilEtaleTorsionH S₁ n_mod q),
      WeilIsTorsionEtalePullback e.hom n_mod q p_hom →
      Function.Bijective p_hom := by
    intro S₁ S₂ e n_mod q p_hom hp_hom
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv n_mod q
    obtain ⟨p_id₁, hp_id₁⟩ := hPullEx (𝟙 S₁) n_mod q
    obtain ⟨p_id₂, hp_id₂⟩ := hPullEx (𝟙 S₂) n_mod q
    have hid₁ := hPullId n_mod q p_id₁ hp_id₁
    have hid₂ := hPullId n_mod q p_id₂ hp_id₂
    refine Function.bijective_iff_has_inverse.mpr ⟨p_inv, fun y => ?_, fun x => ?_⟩
    · have h := hPullTri e.inv e.hom (𝟙 S₂) n_mod q p_inv p_hom p_id₂
        e.inv_hom_id hp_inv hp_hom hp_id₂ y
      rw [hid₂, AddMonoidHom.id_apply] at h
      exact h.symm
    · have h := hPullTri e.hom e.inv (𝟙 S₁) n_mod q p_hom p_inv p_id₁
        e.hom_inv_id hp_hom hp_inv hp_id₁ x
      rw [hid₁, AddMonoidHom.id_apply] at h
      exact h.symm

  have hPullIsoEquiv : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (n_mod q : ℕ),
      Nonempty (weilEtaleTorsionH S₂ n_mod q ≃+ weilEtaleTorsionH S₁ n_mod q) := by
    intro S₁ S₂ e n_mod q
    obtain ⟨p_hom, hp_hom⟩ := hPullEx e.hom n_mod q
    exact ⟨AddEquiv.ofBijective p_hom (hPullIsoBij e n_mod q p_hom hp_hom)⟩

  have hPullRetr : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (i : S₁ ⟶ S₂) (g : S₂ ⟶ S₁),
      i ≫ g = 𝟙 S₁ →
      ∀ (n_mod q : ℕ)
        (p_i : weilEtaleTorsionH S₂ n_mod q →+ weilEtaleTorsionH S₁ n_mod q)
        (p_g : weilEtaleTorsionH S₁ n_mod q →+ weilEtaleTorsionH S₂ n_mod q),
        WeilIsTorsionEtalePullback i n_mod q p_i →
        WeilIsTorsionEtalePullback g n_mod q p_g →
        ∀ x : weilEtaleTorsionH S₁ n_mod q, p_i (p_g x) = x := by
    intro S₁ S₂ i g hig n_mod q p_i p_g hp_i hp_g x
    obtain ⟨p_id, hp_id⟩ := hPullEx (𝟙 S₁) n_mod q
    have hid := hPullId n_mod q p_id hp_id
    have h := hPullTri i g (𝟙 S₁) n_mod q p_i p_g p_id hig hp_i hp_g hp_id x
    rw [hid, AddMonoidHom.id_apply] at h
    exact h.symm

  have hCharAndUnit : ∀ (F₀ : Type u) [Field F₀], (ℓ : F₀) ≠ 0 →
      ℓ ≠ ringChar F₀ ∧ ∀ s : ℕ, IsUnit (((ℓ ^ (s + 1) : ℕ) : F₀)) := by
    intro F₀ _ hℓ_F₀
    refine ⟨?_, fun s => ?_⟩
    · intro h_eq
      apply hℓ_F₀
      rw [h_eq]
      exact ringChar.Nat.cast_ringChar
    · rw [Nat.cast_pow]
      exact (IsUnit.mk0 (ℓ : F₀) hℓ_F₀).pow (s + 1)

  have hZModPowNe : ∀ s : ℕ, ((ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) ≠ 0 := by
    intro s h0
    let _ : NeZero (ℓ ^ (s + 1)) := ⟨(pow_pos hℓ_pos (s + 1)).ne'⟩
    have hlt : ℓ ^ s < ℓ ^ (s + 1) := Nat.pow_lt_pow_right hℓ_prime.one_lt (Nat.lt_succ_self s)
    have hval := congrArg ZMod.val h0
    rw [ZMod.val_natCast_of_lt hlt, ZMod.val_zero] at hval
    exact (pow_pos hℓ_pos s).ne' hval

  have hZModNonunitAnn : ∀ (s : ℕ) (x : ZMod (ℓ ^ (s + 1))),
      ¬ IsUnit x → ((ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) * x = 0 := by
    intro s x hnu
    let n_mod := ℓ ^ (s + 1)
    let _ : NeZero n_mod := ⟨(pow_pos hℓ_pos (s + 1)).ne'⟩
    have hnu' : ¬ IsUnit ((x.val : ℕ) : ZMod n_mod) := by
      rwa [ZMod.natCast_zmod_val]
    rw [ZMod.isUnit_iff_coprime, Nat.coprime_pow_right_iff (Nat.succ_pos s),
      Nat.coprime_comm, hℓ_prime.coprime_iff_not_dvd, not_not] at hnu'
    obtain ⟨t, ht⟩ := hnu'
    conv_lhs => rw [← ZMod.natCast_zmod_val x, ← Nat.cast_mul, ht]
    have hmul : ℓ ^ s * (ℓ * t) = n_mod * t := by
      dsimp [n_mod]
      rw [pow_succ]
      ring
    rw [hmul, Nat.cast_mul, ZMod.natCast_self, zero_mul]

  have hPairEquiv : ∀ (s : ℕ) {A B : Type u} [AddCommGroup A] [AddCommGroup B]
      (P : A →+ B →+ ZMod (ℓ ^ (s + 1))),
      (∀ a : A, P a = 0 → a = 0) →
      (∀ b : B, (∀ a : A, P a b = 0) → b = 0) →
      (Subsingleton B → Subsingleton A) ∧
      (Nonempty (B ≃+ ZMod (ℓ ^ (s + 1))) → Nonempty (A ≃+ ZMod (ℓ ^ (s + 1)))) ∧
      (Nonempty (B ≃+ ZMod (ℓ ^ (s + 1)) × ZMod (ℓ ^ (s + 1))) →
        Nonempty (A ≃+ ZMod (ℓ ^ (s + 1)) × ZMod (ℓ ^ (s + 1)))) := by
    intro s A B _ _ P hLeft hRight
    let n_mod := ℓ ^ (s + 1)
    let _ : NeZero n_mod := ⟨(pow_pos hℓ_pos (s + 1)).ne'⟩
    refine ⟨?_, ?_, ?_⟩
    · intro hSub
      refine ⟨fun a₁ a₂ => ?_⟩
      apply sub_eq_zero.mp
      apply hLeft
      ext b
      rw [AddMonoidHom.zero_apply, Subsingleton.elim b 0, map_zero]
    · rintro ⟨e_B⟩
      let b₀ : B := e_B.symm 1
      let φ : A →+ ZMod n_mod :=
        { toFun := fun a => P a b₀
          map_zero' := by simp
          map_add' := fun a₁ a₂ => by simp }
      have hφ_inj : Function.Injective φ := by
        intro a₁ a₂ h_eq
        apply sub_eq_zero.mp
        apply hLeft
        ext b
        have hb : b = (e_B b).val • b₀ := by
          apply e_B.injective
          rw [map_nsmul, e_B.apply_symm_apply, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
        rw [hb, map_nsmul, AddMonoidHom.zero_apply]
        change (e_B b).val • φ (a₁ - a₂) = 0
        rw [map_sub, sub_eq_zero.mpr h_eq, smul_zero]
      have hφ_unit : ∃ a₀ : A, IsUnit (φ a₀) := by
        by_contra hall
        have hall' : ∀ a : A, ¬ IsUnit (φ a) := not_exists.mp hall
        have hb_ann : ∀ a : A, P a ((ℓ ^ s) • b₀) = 0 := by
          intro a
          rw [map_nsmul, nsmul_eq_mul]
          exact hZModNonunitAnn s (φ a) (hall' a)
        have hb0 : (ℓ ^ s) • b₀ = 0 := hRight _ hb_ann
        have h_cast0 : ((ℓ ^ s : ℕ) : ZMod n_mod) = 0 := by
          have h1 := congrArg e_B hb0
          rw [map_nsmul, map_zero, e_B.apply_symm_apply, nsmul_eq_mul, mul_one] at h1
          exact h1
        exact hZModPowNe s h_cast0
      obtain ⟨a₀, hu⟩ := hφ_unit
      have hφ_surj : Function.Surjective φ := by
        intro z
        let c : ZMod n_mod := z * ↑(hu.unit⁻¹)
        refine ⟨c.val • a₀, ?_⟩
        rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
        dsimp [c]
        rw [mul_assoc, hu.val_inv_mul, mul_one]
      exact ⟨AddEquiv.ofBijective φ ⟨hφ_inj, hφ_surj⟩⟩
    · rintro ⟨e_B⟩
      let b₁ : B := e_B.symm (1, 0)
      let b₂ : B := e_B.symm (0, 1)
      let Φ : A →+ ZMod n_mod × ZMod n_mod :=
        { toFun := fun a => (P a b₁, P a b₂)
          map_zero' := by simp
          map_add' := fun x y => by simp }
      have h_decomp : ∀ b : B, b = (e_B b).1.val • b₁ + (e_B b).2.val • b₂ := by
        intro b
        apply e_B.injective
        rw [map_add, map_nsmul, map_nsmul, e_B.apply_symm_apply, e_B.apply_symm_apply]
        ext <;> simp [nsmul_eq_mul]
      have hΦ_inj : Function.Injective Φ := by
        intro x y hxy
        apply sub_eq_zero.mp
        apply hLeft
        ext b
        have h1 : P (x - y) b₁ = 0 := by
          simpa [Φ, sub_eq_zero] using congrArg Prod.fst hxy
        have h2 : P (x - y) b₂ = 0 := by
          simpa [Φ, sub_eq_zero] using congrArg Prod.snd hxy
        rw [h_decomp b, map_add, map_nsmul, map_nsmul, h1, h2, smul_zero, smul_zero, add_zero,
          AddMonoidHom.zero_apply]
      have h_orth : ∀ c₁ c₂ : ZMod n_mod,
          (∀ a : A, c₁ * (Φ a).1 + c₂ * (Φ a).2 = 0) → c₁ = 0 ∧ c₂ = 0 := by
        intro c₁ c₂ h0
        let b : B := c₁.val • b₁ + c₂.val • b₂
        have hb0 : b = 0 := by
          apply hRight
          intro a
          dsimp [b]
          rw [map_add, map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul,
            ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
          exact h0 a
        have heb : e_B b = (c₁, c₂) := by
          dsimp [b]
          rw [map_add, map_nsmul, map_nsmul, e_B.apply_symm_apply, e_B.apply_symm_apply]
          ext <;> simp [nsmul_eq_mul]
        rw [hb0, map_zero] at heb
        exact ⟨(congrArg Prod.fst heb).symm, (congrArg Prod.snd heb).symm⟩
      have h_u1 : ∃ a₁ : A, IsUnit (Φ a₁).1 := by
        by_contra hall
        have hall' : ∀ a : A, ¬ IsUnit (Φ a).1 := not_exists.mp hall
        have h0 := h_orth ((ℓ ^ s : ℕ) : ZMod n_mod) 0 (fun a => by
          rw [zero_mul, add_zero]
          exact hZModNonunitAnn s (Φ a).1 (hall' a))
        exact hZModPowNe s h0.1
      obtain ⟨a₁, hu₁⟩ := h_u1
      let inv₁ : ZMod n_mod := ↑(hu₁.unit⁻¹)
      let e₁ : A := inv₁.val • a₁
      let d : ZMod n_mod := (Φ e₁).2
      have hΦ_e1_fst : (Φ e₁).1 = 1 := by
        change (Φ (inv₁.val • a₁)).1 = 1
        rw [map_nsmul, Prod.smul_fst, nsmul_eq_mul, ZMod.natCast_zmod_val]
        exact hu₁.val_inv_mul
      have h_u2 : ∃ a₂ : A, IsUnit ((Φ a₂).2 - d * (Φ a₂).1) := by
        by_contra hall
        have hall' : ∀ a : A, ¬ IsUnit ((Φ a).2 - d * (Φ a).1) := not_exists.mp hall
        let k_s : ZMod n_mod := ((ℓ ^ s : ℕ) : ZMod n_mod)
        have h0 := h_orth (-(k_s * d)) k_s (fun a => by
          have hann := hZModNonunitAnn s ((Φ a).2 - d * (Φ a).1) (hall' a)
          calc -(k_s * d) * (Φ a).1 + k_s * (Φ a).2
              = k_s * ((Φ a).2 - d * (Φ a).1) := by ring
            _ = 0 := hann)
        exact hZModPowNe s h0.2
      obtain ⟨a₂, hu₂⟩ := h_u2
      let y₁ : ZMod n_mod := (Φ a₂).1
      let a₂' : A := a₂ - y₁.val • e₁
      have hΦ_a2'_fst : (Φ a₂').1 = 0 := by
        change (Φ (a₂ - y₁.val • e₁)).1 = 0
        rw [map_sub, map_nsmul, Prod.fst_sub, Prod.smul_fst, hΦ_e1_fst,
          nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
        exact sub_self y₁
      have hΦ_a2'_snd : (Φ a₂').2 = (Φ a₂).2 - d * (Φ a₂).1 := by
        change (Φ (a₂ - y₁.val • e₁)).2 = _
        rw [map_sub, map_nsmul, Prod.snd_sub, Prod.smul_snd, nsmul_eq_mul,
          ZMod.natCast_zmod_val, mul_comm y₁ d]
      let inv₂ : ZMod n_mod := ↑(hu₂.unit⁻¹)
      let e₂_el : A := inv₂.val • a₂'
      have hΦ_e2 : Φ e₂_el = (0, 1) := by
        change Φ (inv₂.val • a₂') = (0, 1)
        rw [map_nsmul]
        ext
        · rw [Prod.smul_fst, hΦ_a2'_fst, smul_zero]
        · rw [Prod.smul_snd, hΦ_a2'_snd, nsmul_eq_mul, ZMod.natCast_zmod_val]
          exact hu₂.val_inv_mul
      let e₁_el : A := e₁ - d.val • e₂_el
      have hΦ_e1 : Φ e₁_el = (1, 0) := by
        have hsub : Φ e₁_el = Φ e₁ - d.val • Φ e₂_el :=
          (map_sub Φ e₁ (d.val • e₂_el)).trans (congrArg (Φ e₁ - ·) (map_nsmul Φ d.val e₂_el))
        rw [hsub, hΦ_e2]
        ext
        · simp [hΦ_e1_fst]
        · simp [d, nsmul_eq_mul]
      have hΦ_surj : Function.Surjective Φ := by
        rintro ⟨r₁, r₂⟩
        refine ⟨r₁.val • e₁_el + r₂.val • e₂_el, ?_⟩
        rw [map_add, map_nsmul, map_nsmul, hΦ_e1, hΦ_e2]
        ext <;> simp [nsmul_eq_mul]
      exact ⟨AddEquiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩⟩

  have hProjCoh : ∀ (F₀ : Type u) [Field F₀] [IsAlgClosed F₀] (_ : (ℓ : F₀) ≠ 0)
      (s N : ℕ),
      (∀ c : ℕ,
        Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver F₀ N).left
          (ℓ ^ (s + 1)) (2 * c + 1))) ∧
      (∀ q : ℕ, 2 * N < q →
        Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver F₀ N).left
          (ℓ ^ (s + 1)) q)) ∧
      (∀ c : ℕ, c ≤ N →
        Nonempty (weilEtaleTorsionH (weilProjectiveSpaceOver F₀ N).left
          (ℓ ^ (s + 1)) (2 * c) ≃+ ZMod (ℓ ^ (s + 1)))) := by
    intro F₀ _ _ hℓ_F₀ s N
    have hℓ_char : ℓ ≠ ringChar F₀ := (hCharAndUnit F₀ hℓ_F₀).1
    have hPBC : WeilProperModPrimeBaseChangeHolds F₀ ℓ :=
      weil_etale_proper_base_change_mod_prime F₀ ℓ hℓ_F₀
    have hA1Zero := fun δ b hb =>
      weil_smooth_pencil_locConst_affine_a1_higherDirectImage_isZero F₀ ℓ hℓ_F₀ hPBC δ b hb
    have hAffSub :=
      (weil_split_quad_affine_bundle_cohomology_pullback_bijective F₀ ℓ s hℓ_F₀ hA1Zero).1
    induction N with
    | zero =>
      let P₀ := weilProjectiveSpaceOver F₀ 0
      obtain ⟨hInt₀, hProj₀, -, -⟩ := weil_projectiveSpace_integral_krullDim_and_dim_zero_iso F₀ 0
      let _ : AlgebraicGeometry.IsProper P₀.hom := hProperOfProj F₀ P₀ hProj₀
      let _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 P₀.hom := (hProjStepCharts F₀ 0).1
      obtain ⟨hAbove₀, -, -⟩ := hVerdierExc F₀ ℓ s hℓ_F₀ P₀ hInt₀ 0
      obtain ⟨tr₀, hTrBij₀, -, -⟩ :=
        weil_etale_smooth_proper_torsion_poincare_duality F₀ P₀ hInt₀ 0 ℓ hℓ_char
      refine ⟨fun c => hAbove₀ (2 * c + 1) (by omega), hAbove₀, fun c hc => ?_⟩
      have hc0 : c = 0 := by omega
      subst hc0
      exact ⟨AddEquiv.ofBijective (tr₀ (s + 1)) (hTrBij₀ (s + 1))⟩
    | succ N ih =>
      obtain ⟨ih_odd, ih_above, ih_even⟩ := ih
      let P_N := weilProjectiveSpaceOver F₀ N
      let P_succ := weilProjectiveSpaceOver F₀ (N + 1)
      obtain ⟨-, hProj_N, -, -⟩ := weil_projectiveSpace_integral_krullDim_and_dim_zero_iso F₀ N
      obtain ⟨hInt_succ, hProj_succ, -, -⟩ :=
        weil_projectiveSpace_integral_krullDim_and_dim_zero_iso F₀ (N + 1)
      let _ : AlgebraicGeometry.IsProper P_N.hom := hProperOfProj F₀ P_N hProj_N
      let _ : AlgebraicGeometry.IsProper P_succ.hom := hProperOfProj F₀ P_succ hProj_succ
      obtain ⟨_, i_hyp, U_P, e_UP, hi_cl, hU_P, _⟩ := hProjStepCharts F₀ N
      let _ : AlgebraicGeometry.SmoothOfRelativeDimension (N + 1) P_succ.hom :=
        (hProjStepCharts F₀ (N + 1)).1
      obtain ⟨hAbove_succ, hExc_succ, -⟩ := hVerdierExc F₀ ℓ s hℓ_F₀ P_succ hInt_succ (N + 1)
      obtain ⟨hInj_hyp, hBij_hyp⟩ := hExc_succ P_N i_hyp hi_cl U_P hU_P
      have hUP_sub : ∀ q : ℕ, 1 ≤ q →
          Subsingleton (weilEtaleTorsionH U_P.toScheme (ℓ ^ (s + 1)) q) := by
        intro q hq
        obtain ⟨e_q⟩ := hPullIsoEquiv e_UP (ℓ ^ (s + 1)) q
        have _ : Subsingleton
            (weilEtaleTorsionH (weilAffineSpaceOver F₀ (N + 1)).left (ℓ ^ (s + 1)) q) :=
          hAffSub (N + 1) q hq
        exact e_q.symm.toEquiv.subsingleton
      have hLowEquiv : ∀ p : ℕ, p ≤ 2 * N →
          Nonempty (weilEtaleTorsionH P_succ.left (ℓ ^ (s + 1)) p ≃+
            weilEtaleTorsionH P_N.left (ℓ ^ (s + 1)) p) := by
        intro p hp
        obtain ⟨p_i, hp_i⟩ := hPullEx i_hyp.left (ℓ ^ (s + 1)) p
        have hBij := hBij_hyp p (by omega)
          (hUP_sub _ (by omega)) (hUP_sub _ (by omega)) p_i hp_i
        exact ⟨AddEquiv.ofBijective p_i hBij⟩
      obtain ⟨tr_succ, hTrBij_succ, -, -⟩ :=
        weil_etale_smooth_proper_torsion_poincare_duality F₀ P_succ hInt_succ (N + 1) ℓ hℓ_char
      refine ⟨?_, hAbove_succ, ?_⟩
      · intro c
        by_cases hc_lt : c < N
        · obtain ⟨e_p⟩ := hLowEquiv (2 * c + 1) (by omega)
          have _ := ih_odd c
          exact e_p.toEquiv.subsingleton
        · by_cases hc_eq : c = N
          · subst hc_eq
            obtain ⟨p_i, hp_i⟩ := hPullEx i_hyp.left (ℓ ^ (s + 1)) (2 * c + 1)
            have hInj := hInj_hyp (2 * c + 1) (by omega) (hUP_sub _ (by omega)) p_i hp_i
            have hSub_N := ih_above (2 * c + 1) (by omega)
            exact ⟨fun x y => hInj (hSub_N.elim _ _)⟩
          · exact hAbove_succ (2 * c + 1) (by omega)
      · intro c hc
        by_cases hc_top : c = N + 1
        · subst hc_top
          exact ⟨AddEquiv.ofBijective (tr_succ (s + 1)) (hTrBij_succ (s + 1))⟩
        · obtain ⟨e_p⟩ := hLowEquiv (2 * c) (by omega)
          obtain ⟨e_N⟩ := ih_even c (by omega)
          exact ⟨e_p.trans e_N⟩

  have hSpecCoh : ∀ (F₀ : Type u) [Field F₀] [IsAlgClosed F₀] (_ : (ℓ : F₀) ≠ 0) (s : ℕ),
      Nonempty (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of F₀))
        (ℓ ^ (s + 1)) 0 ≃+ ZMod (ℓ ^ (s + 1))) ∧
      (∀ q : ℕ, 1 ≤ q →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of F₀))
          (ℓ ^ (s + 1)) q)) := by
    intro F₀ _ _ hℓ_F₀ s
    obtain ⟨-, -, -, hIso0⟩ := weil_projectiveSpace_integral_krullDim_and_dim_zero_iso F₀ 0
    let _ : CategoryTheory.IsIso (weilProjectiveSpaceOver F₀ 0).hom := hIso0 rfl
    let e_P0 : (weilProjectiveSpaceOver F₀ 0).left ≅ AlgebraicGeometry.Spec (CommRingCat.of F₀) :=
      CategoryTheory.asIso (weilProjectiveSpaceOver F₀ 0).hom
    obtain ⟨-, hAbove0, hEven0⟩ := hProjCoh F₀ hℓ_F₀ s 0
    refine ⟨?_, ?_⟩
    · obtain ⟨e_iso⟩ := hPullIsoEquiv e_P0 (ℓ ^ (s + 1)) 0
      obtain ⟨e_0⟩ := hEven0 0 (le_refl 0)
      exact ⟨e_iso.trans e_0⟩
    · intro q hq
      obtain ⟨e_iso⟩ := hPullIsoEquiv e_P0 (ℓ ^ (s + 1)) q
      have _ := hAbove0 q (by omega)
      exact e_iso.toEquiv.subsingleton

  let F_split_poly : ∀ (F₀ : Type u) [Field F₀] (d₀ : ℕ), MvPolynomial (Fin (2 * d₀ + 1 + 1)) F₀ :=
    fun F₀ _ d₀ =>
      ∑ j ∈ Finset.range (d₀ + 1),
        if h : 2 * j + 1 < 2 * d₀ + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * d₀ + 1 + 1)) F₀) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0

  let SplitQuadPkg : ∀ (F₀ : Type u) [Field F₀] (s n : ℕ)
      (Q_n : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀))), Prop :=
    fun F₀ _ s n Q_n =>
      (∀ c : ℕ, Subsingleton (weilEtaleTorsionH Q_n.left (ℓ ^ (s + 1)) (2 * c + 1))) ∧
      (∀ q : ℕ, 4 * n < q → Subsingleton (weilEtaleTorsionH Q_n.left (ℓ ^ (s + 1)) q)) ∧
      (∀ c : ℕ, c ≤ 2 * n → c ≠ n →
        Nonempty (weilEtaleTorsionH Q_n.left (ℓ ^ (s + 1)) (2 * c) ≃+ ZMod (ℓ ^ (s + 1)))) ∧
      Nonempty (weilEtaleTorsionH Q_n.left (ℓ ^ (s + 1)) (2 * n) ≃+
        ZMod (ℓ ^ (s + 1)) × ZMod (ℓ ^ (s + 1)))

  let ConePkg : ∀ (F₀ : Type u) [Field F₀] (s n : ℕ)
      (Z_c : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀))), Prop :=
    fun F₀ _ s n Z_c =>
      (∀ c : ℕ, Subsingleton (weilEtaleTorsionH Z_c.left (ℓ ^ (s + 1)) (2 * c + 1))) ∧
      (∀ q : ℕ, 4 * n + 2 < q → Subsingleton (weilEtaleTorsionH Z_c.left (ℓ ^ (s + 1)) q)) ∧
      (∀ c : ℕ, c ≤ 2 * n + 1 → c ≠ n + 1 →
        Nonempty (weilEtaleTorsionH Z_c.left (ℓ ^ (s + 1)) (2 * c) ≃+ ZMod (ℓ ^ (s + 1)))) ∧
      Nonempty (weilEtaleTorsionH Z_c.left (ℓ ^ (s + 1)) (2 * n + 2) ≃+
        ZMod (ℓ ^ (s + 1)) × ZMod (ℓ ^ (s + 1)))

  have hConeStep : ∀ (F₀ : Type u) [Field F₀] [IsAlgClosed F₀] (hℓ_F₀ : (ℓ : F₀) ≠ 0)
      (s n : ℕ),
      (∀ (Q_n : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
        [AlgebraicGeometry.IsProper Q_n.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension (2 * n) Q_n.hom]
        (ι_n : Q_n.left ⟶ (weilProjectiveSpaceOver F₀ (2 * n + 1)).left),
        ι_n ≫ (weilProjectiveSpaceOver F₀ (2 * n + 1)).hom = Q_n.hom →
        IsHomogeneousHypersurfacePullbackOver F₀ (2 * n + 1) 2
          (𝟙 (weilProjectiveSpaceOver F₀ (2 * n + 1))) (F_split_poly F₀ n) ι_n →
        SplitQuadPkg F₀ s n Q_n) →
      ∀ (Q_succ Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
        [AlgebraicGeometry.IsProper Q_succ.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension (2 * (n + 1)) Q_succ.hom]
        [AlgebraicGeometry.IsProper Z_cone.hom]
        (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver F₀ (2 * (n + 1) + 1)).left)
        (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver F₀ (2 * (n + 1) + 1)).hom = Q_succ.hom)
        (i_Z : Z_cone ⟶ Q_succ),
        IsHomogeneousHypersurfacePullbackOver F₀ (2 * (n + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver F₀ (2 * (n + 1) + 1))) (F_split_poly F₀ (n + 1)) ι_succ →
        IsHomogeneousHypersurfacePullbackOver F₀ (2 * (n + 1) + 1) 1
          (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) i_Z.left →
        ConePkg F₀ s n Z_cone ∧ SplitQuadPkg F₀ s (n + 1) Q_succ := by
    intro F₀ _ _ hℓ_F₀ s n hIH Q_succ Z_cone _ _ _ ι_succ hι_succ i_Z hSplit_succ hSplit_Z
    let n_mod := ℓ ^ (s + 1)
    have hn_mod_ge1 : 1 ≤ n_mod := Nat.one_le_pow (s + 1) ℓ hℓ_pos
    have hℓ_char : ℓ ≠ ringChar F₀ := (hCharAndUnit F₀ hℓ_F₀).1
    have hPBC : WeilProperModPrimeBaseChangeHolds F₀ ℓ :=
      weil_etale_proper_base_change_mod_prime F₀ ℓ hℓ_F₀
    have hA1Zero := fun δ b hb =>
      weil_smooth_pencil_locConst_affine_a1_higherDirectImage_isZero F₀ ℓ hℓ_F₀ hPBC δ b hb
    obtain ⟨hAffSub, hAffBunBij⟩ :=
      weil_split_quad_affine_bundle_cohomology_pullback_bijective F₀ ℓ s hℓ_F₀ hA1Zero
    obtain ⟨hInt_Qsucc, hi_Z_cl, O_succ, e_O, Q_n, hProp_Qn, hSm_Qn, _, ι_n,
      p₀, U_Z, Z_tilde, hProp_Zt, hSm_Zt, hInt_Zt_ge1, π_Z, hProp_πZ, hSurj_πZ,
      p_Q, _, i₀, _, V_plus, _, W,
      ⟨_, hO_compl⟩, ⟨hι_n, hSplit_n⟩, ⟨hp₀_hom, hU_Z_compl, hIso_UZ⟩,
      ⟨hi₀_pQ, _, hi₀_cl, hV_plus_compl, hPb_i₀, _⟩, ⟨hW_sup, hW_triv⟩, hZero_P1⟩ :=
      (hConeBlowupCharts F₀ n).2 Q_succ Z_cone ι_succ hι_succ i_Z hSplit_succ hSplit_Z
    let _ : AlgebraicGeometry.IsProper Q_n.hom := hProp_Qn
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * n) Q_n.hom := hSm_Qn
    let _ : AlgebraicGeometry.IsProper Z_tilde.hom := hProp_Zt
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * n + 1) Z_tilde.hom := hSm_Zt
    let _ : AlgebraicGeometry.IsProper π_Z.left := hProp_πZ
    let _ : AlgebraicGeometry.Surjective π_Z.left := hSurj_πZ
    have hi₀_pQ_left : i₀.left ≫ p_Q.left = 𝟙 Q_n.left := congrArg CategoryTheory.CommaMorphism.left hi₀_pQ
    obtain ⟨hOdd_Qn, hAbove_Qn, hEven_Qn, hMid_Qn⟩ := hIH Q_n ι_n hι_n hSplit_n
    obtain ⟨hModif0, hModifPos⟩ :=
      hPointModif F₀ ℓ s hℓ_F₀ hPBC Z_tilde Z_cone Q_n π_Z p₀ hp₀_hom U_Z hU_Z_compl hIso_UZ
        i₀.left hi₀_cl hPb_i₀ p_Q.left hi₀_pQ_left
    obtain ⟨⟨e_Spec0⟩, _⟩ := hSpecCoh F₀ hℓ_F₀ s

    have hCone : ConePkg F₀ s n Z_cone := by
      rcases Nat.eq_zero_or_pos n with rfl | hn_pos
      · obtain ⟨hWt_inf, hWt_sup, hWt_P1⟩ := hZero_P1 rfl
        set W_tilde : Fin (2 * 0 + 2) → Z_tilde.left.Opens :=
          fun b => (TopologicalSpace.Opens.map p_Q.left.base).obj (W b)
        obtain ⟨e_P1_0, _⟩ := hWt_P1 ⟨0, by omega⟩
        obtain ⟨e_P1_1, _⟩ := hWt_P1 ⟨1, by omega⟩
        obtain ⟨hOdd_P1, hAbove_P1, hEven_P1⟩ := hProjCoh F₀ hℓ_F₀ s 1
        have hZt_prod : ∀ q : ℕ,
            Nonempty (weilEtaleTorsionH Z_tilde.left n_mod q ≃+
              weilEtaleTorsionH (weilProjectiveSpaceOver F₀ 1).left n_mod q ×
                weilEtaleTorsionH (weilProjectiveSpaceOver F₀ 1).left n_mod q) := by
          intro q
          obtain ⟨pw₀, hpw₀⟩ := hPullEx (W_tilde ⟨0, by omega⟩).ι n_mod q
          obtain ⟨pw₁, hpw₁⟩ := hPullEx (W_tilde ⟨1, by omega⟩).ι n_mod q
          have hBij_pr := hClopenProd Z_tilde.left _ _ hWt_inf hWt_sup n_mod q pw₀ pw₁ hpw₀ hpw₁
          obtain ⟨e₀⟩ := hPullIsoEquiv e_P1_0 n_mod q
          obtain ⟨e₁⟩ := hPullIsoEquiv e_P1_1 n_mod q
          exact ⟨(AddEquiv.ofBijective _ hBij_pr).trans (AddEquiv.prodCongr e₀.symm e₁.symm)⟩
        have hInj_i0_0 : ∀ p_i0 : weilEtaleTorsionH Z_tilde.left n_mod 0 →+
              weilEtaleTorsionH Q_n.left n_mod 0,
            WeilIsTorsionEtalePullback i₀.left n_mod 0 p_i0 → Function.Injective p_i0 := by
          intro p_i0 hp_i0
          obtain ⟨p_pQ0, hp_pQ0⟩ := hPullEx p_Q.left n_mod 0
          have hSurj_i0 : Function.Surjective p_i0 :=
            fun y => ⟨p_pQ0 y, hPullRetr i₀.left p_Q.left hi₀_pQ_left n_mod 0 p_i0 p_pQ0 hp_i0 hp_pQ0 y⟩
          obtain ⟨e_Zt0⟩ := hZt_prod 0
          obtain ⟨e_P1_c0⟩ := hEven_P1 0 (by omega)
          let e_Zt0' : weilEtaleTorsionH Z_tilde.left n_mod 0 ≃+ ZMod n_mod × ZMod n_mod :=
            e_Zt0.trans (AddEquiv.prodCongr e_P1_c0 e_P1_c0)
          obtain ⟨e_Q0⟩ := hMid_Qn
          let _ : NeZero n_mod := ⟨(pow_pos hℓ_pos (s + 1)).ne'⟩
          let e_end : weilEtaleTorsionH Q_n.left n_mod 0 ≃ weilEtaleTorsionH Z_tilde.left n_mod 0 :=
            e_Q0.toEquiv.trans e_Zt0'.symm.toEquiv
          have _ : Finite (weilEtaleTorsionH Z_tilde.left n_mod 0) :=
            Finite.of_equiv _ e_Zt0'.symm.toEquiv
          have hSurj_end : Function.Surjective (e_end ∘ p_i0) := e_end.surjective.comp hSurj_i0
          obtain ⟨g_sec, hg_sec⟩ := Function.surjective_iff_hasRightInverse.mp hSurj_end
          have hSurj_sec : Function.Surjective g_sec :=
            Finite.surjective_of_injective hg_sec.injective
          intro x y hxy
          obtain ⟨u, rfl⟩ := hSurj_sec x
          obtain ⟨v, rfl⟩ := hSurj_sec y
          have huv : u = v := (hg_sec u).symm.trans ((congrArg e_end hxy).trans (hg_sec v))
          rw [huv]
        have hZc_0 : Nonempty (weilEtaleTorsionH Z_cone.left n_mod 0 ≃+ ZMod n_mod) := by
          obtain ⟨p_p0, hp_p0⟩ := hPullEx p₀ n_mod 0
          have hBij_p0 := hModif0 hInj_i0_0 p_p0 hp_p0
          exact ⟨(AddEquiv.ofBijective p_p0 hBij_p0).trans e_Spec0⟩
        have hZc_pos : ∀ b : ℕ,
            Nonempty (weilEtaleTorsionH Z_cone.left n_mod (b + 1) ≃+
              weilEtaleTorsionH Z_tilde.left n_mod (b + 1)) := by
          intro b
          obtain ⟨p_π, hp_π⟩ := hPullEx π_Z.left n_mod (b + 1)
          obtain ⟨p_iE, hp_iE⟩ := hPullEx i₀.left n_mod (b + 1)
          obtain ⟨hInj_π, hRange_π⟩ := hModifPos b p_π p_iE hp_π hp_iE
          have hSub_Q0 := hAbove_Qn (b + 1) (by omega)
          have hSurj_π : Function.Surjective p_π := by
            intro y
            have hy_ker : y ∈ p_iE.ker := hSub_Q0.elim (p_iE y) 0
            rw [← hRange_π] at hy_ker
            exact hy_ker
          exact ⟨AddEquiv.ofBijective p_π ⟨hInj_π, hSurj_π⟩⟩
        have hZc_above : ∀ q : ℕ, 2 < q →
            Subsingleton (weilEtaleTorsionH Z_cone.left n_mod q) := by
          intro q hq
          obtain ⟨b, rfl⟩ : ∃ b : ℕ, q = b + 1 := ⟨q - 1, (Nat.sub_add_cancel (by omega)).symm⟩
          obtain ⟨e_pos⟩ := hZc_pos b
          obtain ⟨e_prod⟩ := hZt_prod (b + 1)
          have _ := hAbove_P1 (b + 1) (by omega)
          exact (e_pos.trans e_prod).toEquiv.subsingleton
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro c
          rcases Nat.eq_zero_or_pos c with rfl | hc_pos
          · obtain ⟨e_pos⟩ := hZc_pos 0
            obtain ⟨e_prod⟩ := hZt_prod 1
            have _ := hOdd_P1 0
            exact (e_pos.trans e_prod).toEquiv.subsingleton
          · exact hZc_above (2 * c + 1) (by omega)
        · intro q hq
          exact hZc_above q (by omega)
        · intro c hc_le hc_ne
          have hc0 : c = 0 := by omega
          subst hc0
          exact hZc_0
        · obtain ⟨e_pos⟩ := hZc_pos 1
          obtain ⟨e_prod⟩ := hZt_prod 2
          obtain ⟨e_P1_2⟩ := hEven_P1 1 (le_refl 1)
          exact ⟨(e_pos.trans e_prod).trans (AddEquiv.prodCongr e_P1_2 e_P1_2)⟩
      · have hInt_Zt : AlgebraicGeometry.IsIntegral Z_tilde.left := hInt_Zt_ge1 hn_pos
        let V_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀)) :=
          CategoryTheory.Over.mk (V_plus.ι ≫ Z_tilde.hom)
        let f_VQ : V_over ⟶ Q_n :=
          CategoryTheory.Over.homMk (V_plus.ι ≫ p_Q.left)
            (by dsimp [V_over]; rw [Category.assoc, p_Q.w])
        have hBij_VQ : ∀ d : ℕ,
            ∀ p_f : weilEtaleTorsionH Q_n.left n_mod d →+ weilEtaleTorsionH V_plus.toScheme n_mod d,
              WeilIsTorsionEtalePullback (V_plus.ι ≫ p_Q.left) n_mod d p_f →
              Function.Bijective p_f :=
          fun d p_f hp_f =>
            hAffBunBij Q_n V_over f_VQ (2 * n) (2 * n + 2) W hW_sup hW_triv d p_f hp_f
        obtain ⟨hAbove_Zt, -, -⟩ := hVerdierExc F₀ ℓ s hℓ_F₀ Z_tilde hInt_Zt (2 * n + 1)
        obtain ⟨tr_Zt, _, _, hNondeg_Zt⟩ :=
          weil_etale_smooth_proper_torsion_poincare_duality F₀ Z_tilde hInt_Zt (2 * n + 1) ℓ hℓ_char
        have hSplit_V : ∀ d : ℕ,
            ∀ (p_pQ : weilEtaleTorsionH Q_n.left n_mod d →+ weilEtaleTorsionH Z_tilde.left n_mod d)
              (p_V : weilEtaleTorsionH Z_tilde.left n_mod d →+
                weilEtaleTorsionH V_plus.toScheme n_mod d),
              WeilIsTorsionEtalePullback p_Q.left n_mod d p_pQ →
              WeilIsTorsionEtalePullback V_plus.ι n_mod d p_V →
              Function.Injective p_pQ ∧
              ∀ y : weilEtaleTorsionH Z_tilde.left n_mod d,
                ∃ (v : weilEtaleTorsionH Q_n.left n_mod d)
                  (y₁ : weilEtaleTorsionH Z_tilde.left n_mod d),
                  y = p_pQ v + y₁ ∧ p_V y₁ = 0 := by
          intro d p_pQ p_V hp_pQ hp_V
          obtain ⟨p_VQ, hp_VQ⟩ := hPullEx (V_plus.ι ≫ p_Q.left) n_mod d
          have h_comp : p_VQ = p_V.comp p_pQ :=
            hPullComp V_plus.ι p_Q.left n_mod d p_V p_pQ p_VQ hp_V hp_pQ hp_VQ
          have hBij := hBij_VQ d p_VQ hp_VQ
          refine ⟨?_, ?_⟩
          · intro u₁ u₂ hu
            apply hBij.1
            rw [h_comp, AddMonoidHom.coe_comp, Function.comp_apply, Function.comp_apply, hu]
          · intro y
            obtain ⟨v, hv⟩ := hBij.2 (p_V y)
            refine ⟨v, y - p_pQ v, (add_sub_cancel (p_pQ v) y).symm, ?_⟩
            rw [map_sub, ← AddMonoidHom.comp_apply, ← h_comp, hv, sub_self]

        have hInj_i0_0 : ∀ p_i0 : weilEtaleTorsionH Z_tilde.left n_mod 0 →+
              weilEtaleTorsionH Q_n.left n_mod 0,
            WeilIsTorsionEtalePullback i₀.left n_mod 0 p_i0 → Function.Injective p_i0 := by
          intro p_i0 hp_i0
          obtain ⟨p_pQ0, hp_pQ0⟩ := hPullEx p_Q.left n_mod 0
          obtain ⟨p_V0, hp_V0⟩ := hPullEx V_plus.ι n_mod 0
          let q₀ := 2 * (2 * n + 1) - 2 * (2 * n + 1)
          have hq₀ : q₀ = 0 := Nat.sub_self _
          have hKer_Vq₀ : ∀ (p_Vq : weilEtaleTorsionH Z_tilde.left n_mod q₀ →+
                weilEtaleTorsionH V_plus.toScheme n_mod q₀),
              WeilIsTorsionEtalePullback V_plus.ι n_mod q₀ p_Vq →
              ∀ y : weilEtaleTorsionH Z_tilde.left n_mod q₀, p_Vq y = 0 → y = 0 := by
            intro p_Vq hp_Vq y hy0
            obtain ⟨p_i0_top, hp_i0_top⟩ := hPullEx i₀.left n_mod (2 * (2 * n + 1))
            obtain ⟨⟨θ_q0, hθ_q0, hBij_θq0⟩, _⟩ := hModComp Z_tilde.left n_mod q₀
            obtain ⟨⟨θ_top, hθ_top, _⟩, _⟩ := hModComp Z_tilde.left n_mod (2 * (2 * n + 1))
            let e_θq0 := AddEquiv.ofBijective θ_q0 hBij_θq0
            have hSub_Qn_top := hAbove_Qn (2 * (2 * n + 1)) (by omega)
            let b_m := e_θq0.symm y
            have hb_m : b_m = 0 := by
              apply (hNondeg_Zt (s + 1) (2 * (2 * n + 1)) (le_refl _) θ_top hθ_top).2
              intro a_m
              have ha_zero : p_i0_top (θ_top a_m) = 0 := hSub_Qn_top.elim _ 0
              have hb_zero : p_Vq (θ_q0 b_m) = 0 := by
                change p_Vq (e_θq0 (e_θq0.symm y)) = 0
                rwa [e_θq0.apply_symm_apply]
              have hcomp0 := hClosedOpenOrth Z_tilde.left Q_n.left i₀.left hi₀_cl V_plus
                hV_plus_compl n_mod (2 * (2 * n + 1)) q₀ (2 * (2 * n + 1)) hn_mod_ge1
                (Nat.add_sub_of_le (le_refl _)) p_i0_top p_Vq θ_top θ_q0
                hp_i0_top hp_Vq hθ_top hθ_q0 a_m b_m ha_zero hb_zero
              rw [hcomp0, map_zero, map_zero]
            have hy_eq : y = e_θq0 b_m := (e_θq0.apply_symm_apply y).symm
            rw [hy_eq, hb_m, map_zero]
          have hKer_V0 : ∀ y : weilEtaleTorsionH Z_tilde.left n_mod 0, p_V0 y = 0 → y = 0 := by
            rw [hq₀] at hKer_Vq₀
            exact hKer_Vq₀ p_V0 hp_V0
          obtain ⟨_, hSplit0⟩ := hSplit_V 0 p_pQ0 p_V0 hp_pQ0 hp_V0
          have hSurj_pQ0 : Function.Surjective p_pQ0 := by
            intro y
            obtain ⟨v, y₁, rfl, hy₁⟩ := hSplit0 y
            rw [hKer_V0 y₁ hy₁, add_zero]
            exact ⟨v, rfl⟩
          intro x y hxy
          obtain ⟨u, rfl⟩ := hSurj_pQ0 x
          obtain ⟨v, rfl⟩ := hSurj_pQ0 y
          have hu := hPullRetr i₀.left p_Q.left hi₀_pQ_left n_mod 0 p_i0 p_pQ0 hp_i0 hp_pQ0 u
          have hv := hPullRetr i₀.left p_Q.left hi₀_pQ_left n_mod 0 p_i0 p_pQ0 hp_i0 hp_pQ0 v
          rw [← hu, hxy, hv]

        have hZc_0 : Nonempty (weilEtaleTorsionH Z_cone.left n_mod 0 ≃+ ZMod n_mod) := by
          obtain ⟨p_p0, hp_p0⟩ := hPullEx p₀ n_mod 0
          have hBij_p0 := hModif0 hInj_i0_0 p_p0 hp_p0
          exact ⟨(AddEquiv.ofBijective p_p0 hBij_p0).trans e_Spec0⟩

        have hZc_above : ∀ q : ℕ, 4 * n + 2 < q →
            Subsingleton (weilEtaleTorsionH Z_cone.left n_mod q) := by
          intro q hq
          obtain ⟨b, rfl⟩ : ∃ b : ℕ, q = b + 1 := ⟨q - 1, (Nat.sub_add_cancel (by omega)).symm⟩
          obtain ⟨p_π, hp_π⟩ := hPullEx π_Z.left n_mod (b + 1)
          obtain ⟨p_iE, hp_iE⟩ := hPullEx i₀.left n_mod (b + 1)
          obtain ⟨hInj_π, _⟩ := hModifPos b p_π p_iE hp_π hp_iE
          have hSub_Zt := hAbove_Zt (b + 1) (by omega)
          exact ⟨fun x y => hInj_π (hSub_Zt.elim _ _)⟩

        have hZc_pair : ∀ (q : ℕ), 1 ≤ q → q ≤ 4 * n + 2 →
            let q' := 2 * (2 * n + 1) - q
            (Subsingleton (weilEtaleTorsionH Q_n.left n_mod q') →
              Subsingleton (weilEtaleTorsionH Z_cone.left n_mod q)) ∧
            (Nonempty (weilEtaleTorsionH Q_n.left n_mod q' ≃+ ZMod n_mod) →
              Nonempty (weilEtaleTorsionH Z_cone.left n_mod q ≃+ ZMod n_mod)) ∧
            (Nonempty (weilEtaleTorsionH Q_n.left n_mod q' ≃+ ZMod n_mod × ZMod n_mod) →
              Nonempty (weilEtaleTorsionH Z_cone.left n_mod q ≃+ ZMod n_mod × ZMod n_mod)) := by
          intro q hq1 hq_le q'
          have hq_le' : q ≤ 2 * (2 * n + 1) := by omega
          obtain ⟨b_idx, hq_eq⟩ : ∃ b_idx : ℕ, q = b_idx + 1 :=
            ⟨q - 1, (Nat.sub_add_cancel hq1).symm⟩
          obtain ⟨p_π, hp_π⟩ := hPullEx π_Z.left n_mod q
          obtain ⟨p_i0, hp_i0⟩ := hPullEx i₀.left n_mod q
          obtain ⟨p_pQ_q, hp_pQ_q⟩ := hPullEx p_Q.left n_mod q
          obtain ⟨p_pQ_q', hp_pQ_q'⟩ := hPullEx p_Q.left n_mod q'
          obtain ⟨p_pQ_top, hp_pQ_top⟩ := hPullEx p_Q.left n_mod (2 * (2 * n + 1))
          obtain ⟨p_V_q', hp_V_q'⟩ := hPullEx V_plus.ι n_mod q'
          have hModif_q : Function.Injective p_π ∧ p_π.range = p_i0.ker := by
            subst hq_eq
            exact hModifPos b_idx p_π p_i0 hp_π hp_i0
          obtain ⟨hInj_π, hRange_π⟩ := hModif_q
          let φ_ker : weilEtaleTorsionH Z_cone.left n_mod q →+ ↥p_i0.ker :=
            p_π.codRestrict p_i0.ker (fun x => hRange_π ▸ ⟨x, rfl⟩)
          have hBij_ker : Function.Bijective φ_ker :=
            ⟨fun x y hxy => hInj_π (congrArg Subtype.val hxy),
              fun k_el => by
                have hk_mem : k_el.1 ∈ p_π.range := hRange_π.symm ▸ k_el.2
                obtain ⟨x, hx⟩ := hk_mem
                exact ⟨x, Subtype.ext hx⟩⟩
          let e_Zc_ker : weilEtaleTorsionH Z_cone.left n_mod q ≃+ ↥p_i0.ker :=
            AddEquiv.ofBijective φ_ker hBij_ker

          obtain ⟨⟨θ_Zt_q, hθ_Zt_q, hBij_Zt_q⟩, _⟩ := hModComp Z_tilde.left n_mod q
          obtain ⟨⟨θ_Zt_q', hθ_Zt_q', hBij_Zt_q'⟩, _⟩ := hModComp Z_tilde.left n_mod q'
          obtain ⟨⟨θ_Zt_top, hθ_Zt_top, _⟩, _⟩ := hModComp Z_tilde.left n_mod (2 * (2 * n + 1))
          obtain ⟨⟨θ_Qn_q, hθ_Qn_q, hBij_Qn_q⟩, _⟩ := hModComp Q_n.left n_mod q
          obtain ⟨⟨θ_Qn_q', hθ_Qn_q', hBij_Qn_q'⟩, _⟩ := hModComp Q_n.left n_mod q'
          obtain ⟨⟨θ_Qn_top, hθ_Qn_top, _⟩, _⟩ := hModComp Q_n.left n_mod (2 * (2 * n + 1))

          let e_Zt_q := AddEquiv.ofBijective θ_Zt_q hBij_Zt_q
          let e_Zt_q' := AddEquiv.ofBijective θ_Zt_q' hBij_Zt_q'
          let e_Qn_q := AddEquiv.ofBijective θ_Qn_q hBij_Qn_q
          let e_Qn_q' := AddEquiv.ofBijective θ_Qn_q' hBij_Qn_q'

          let B_bilin := CategoryTheory.Abelian.Ext.bilinearComp
            (weilEtaleModuleUnit Z_tilde.left n_mod)
            (weilEtaleModuleUnit Z_tilde.left n_mod)
            (weilEtaleModuleUnit Z_tilde.left n_mod)
            q q' (2 * (2 * n + 1)) (Nat.add_sub_of_le hq_le')
          let α_left : ↥p_i0.ker →+ weilEtaleModuleH Z_tilde.left n_mod q :=
            e_Zt_q.symm.toAddMonoidHom.comp p_i0.ker.subtype
          let β_right : weilEtaleTorsionH Q_n.left n_mod q' →+
              weilEtaleModuleH Z_tilde.left n_mod q' :=
            e_Zt_q'.symm.toAddMonoidHom.comp p_pQ_q'
          let tr_hom : weilEtaleModuleH Z_tilde.left n_mod (2 * (2 * n + 1)) →+ ZMod n_mod :=
            (tr_Zt (s + 1)).comp θ_Zt_top
          let P_pair : ↥p_i0.ker →+ weilEtaleTorsionH Q_n.left n_mod q' →+ ZMod n_mod :=
            { toFun := fun k_el => (tr_hom.comp (B_bilin (α_left k_el))).comp β_right
              map_zero' := by ext v; simp
              map_add' := fun k₁ k₂ => by ext v; simp }
          have hP_eval : ∀ (k_el : ↥p_i0.ker) (v : weilEtaleTorsionH Q_n.left n_mod q'),
              P_pair k_el v = tr_Zt (s + 1) (θ_Zt_top
                (CategoryTheory.Abelian.Ext.comp (e_Zt_q.symm k_el.1)
                  (e_Zt_q'.symm (p_pQ_q' v)) (Nat.add_sub_of_le hq_le'))) := by
            intro k_el v
            rfl

          obtain ⟨hInj_pQ_q', hSplit_q'⟩ := hSplit_V q' p_pQ_q' p_V_q' hp_pQ_q' hp_V_q'
          obtain ⟨hLeft_PD, hRight_PD⟩ := hNondeg_Zt (s + 1) q hq_le' θ_Zt_top hθ_Zt_top

          have hP_left : ∀ k_el : ↥p_i0.ker, P_pair k_el = 0 → k_el = 0 := by
            intro k_el hk0
            let a := e_Zt_q.symm k_el.1
            have ha_i0 : p_i0 (θ_Zt_q a) = 0 := by
              change p_i0 (e_Zt_q (e_Zt_q.symm k_el.1)) = 0
              rw [e_Zt_q.apply_symm_apply]
              exact k_el.2
            have ha_zero : a = 0 := by
              apply hLeft_PD
              intro b
              obtain ⟨v, y₁, hy_eq, hy₁_V⟩ := hSplit_q' (θ_Zt_q' b)
              let b₀ := e_Zt_q'.symm (p_pQ_q' v)
              let b₁ := e_Zt_q'.symm y₁
              have hb_sum : b = b₀ + b₁ := by
                apply e_Zt_q'.injective
                rw [map_add, e_Zt_q'.apply_symm_apply, e_Zt_q'.apply_symm_apply]
                exact hy_eq
              have hb₁_V : p_V_q' (θ_Zt_q' b₁) = 0 := by
                change p_V_q' (e_Zt_q' (e_Zt_q'.symm y₁)) = 0
                rwa [e_Zt_q'.apply_symm_apply]
              have hcomp1 := hClosedOpenOrth Z_tilde.left Q_n.left i₀.left hi₀_cl V_plus
                hV_plus_compl n_mod q q' (2 * (2 * n + 1)) hn_mod_ge1 (Nat.add_sub_of_le hq_le')
                p_i0 p_V_q' θ_Zt_q θ_Zt_q' hp_i0 hp_V_q' hθ_Zt_q hθ_Zt_q' a b₁ ha_i0 hb₁_V
              have hcomp0 : tr_Zt (s + 1) (θ_Zt_top
                  (CategoryTheory.Abelian.Ext.comp a b₀ (Nat.add_sub_of_le hq_le'))) = 0 := by
                rw [← hP_eval k_el v, hk0, AddMonoidHom.zero_apply]
              rw [hb_sum, CategoryTheory.Abelian.Ext.comp_add, map_add, map_add,
                hcomp0, hcomp1, map_zero, map_zero, add_zero]
            apply Subtype.ext
            have hk_eq : k_el.1 = e_Zt_q a := (e_Zt_q.apply_symm_apply k_el.1).symm
            rw [hk_eq, ha_zero, map_zero]
            rfl

          have hP_right : ∀ v : weilEtaleTorsionH Q_n.left n_mod q',
              (∀ k_el : ↥p_i0.ker, P_pair k_el v = 0) → v = 0 := by
            intro v hv0
            let b₀ := e_Zt_q'.symm (p_pQ_q' v)
            have hb₀_zero : b₀ = 0 := by
              apply hRight_PD
              intro a
              let x := θ_Zt_q a
              let u := p_i0 x
              let x_ker := x - p_pQ_q u
              have hx_ker_mem : x_ker ∈ p_i0.ker := by
                rw [AddMonoidHom.mem_ker, map_sub,
                  hPullRetr i₀.left p_Q.left hi₀_pQ_left n_mod q p_i0 p_pQ_q hp_i0 hp_pQ_q u]
                exact sub_self u
              let a_pull := e_Zt_q.symm (p_pQ_q u)
              let a_ker := e_Zt_q.symm x_ker
              have ha_sum : a = a_pull + a_ker := by
                apply e_Zt_q.injective
                rw [map_add, e_Zt_q.apply_symm_apply, e_Zt_q.apply_symm_apply]
                exact (add_sub_cancel (p_pQ_q u) x).symm
              have h_ker_zero : tr_Zt (s + 1) (θ_Zt_top
                  (CategoryTheory.Abelian.Ext.comp a_ker b₀ (Nat.add_sub_of_le hq_le'))) = 0 := by
                rw [← hP_eval ⟨x_ker, hx_ker_mem⟩ v]
                exact hv0 ⟨x_ker, hx_ker_mem⟩
              have h_pull_zero : θ_Zt_top
                  (CategoryTheory.Abelian.Ext.comp a_pull b₀ (Nat.add_sub_of_le hq_le')) = 0 := by
                let u_m := e_Qn_q.symm u
                let v_m := e_Qn_q'.symm v
                have hu_eq : p_pQ_q (θ_Qn_q u_m) = θ_Zt_q a_pull := by
                  change p_pQ_q (e_Qn_q (e_Qn_q.symm u)) = e_Zt_q (e_Zt_q.symm (p_pQ_q u))
                  rw [e_Qn_q.apply_symm_apply, e_Zt_q.apply_symm_apply]
                have hv_eq : p_pQ_q' (θ_Qn_q' v_m) = θ_Zt_q' b₀ := by
                  change p_pQ_q' (e_Qn_q' (e_Qn_q'.symm v)) = e_Zt_q' (e_Zt_q'.symm (p_pQ_q' v))
                  rw [e_Qn_q'.apply_symm_apply, e_Zt_q'.apply_symm_apply]
                have hcup := hPullCup p_Q.left n_mod q q' (2 * (2 * n + 1))
                  (Nat.add_sub_of_le hq_le')
                  p_pQ_q p_pQ_q' p_pQ_top
                  θ_Zt_q θ_Qn_q θ_Zt_q' θ_Qn_q' θ_Zt_top θ_Qn_top
                  hp_pQ_q hp_pQ_q' hp_pQ_top
                  hθ_Zt_q hθ_Qn_q hθ_Zt_q' hθ_Qn_q' hθ_Zt_top hθ_Qn_top
                  u_m v_m a_pull b₀ hu_eq hv_eq
                have hSub_Qn_top := hAbove_Qn (2 * (2 * n + 1)) (by omega)
                rw [← hcup, hSub_Qn_top.elim (θ_Qn_top _) 0, map_zero]
              rw [ha_sum, CategoryTheory.Abelian.Ext.add_comp, map_add, map_add,
                h_pull_zero, map_zero, zero_add, h_ker_zero]
            apply hInj_pQ_q'
            rw [map_zero]
            have hpv_eq : p_pQ_q' v = e_Zt_q' b₀ := (e_Zt_q'.apply_symm_apply (p_pQ_q' v)).symm
            rw [hpv_eq, hb₀_zero, map_zero]

          obtain ⟨hSub_K, hOne_K, hTwo_K⟩ := hPairEquiv s P_pair hP_left hP_right
          refine ⟨?_, ?_, ?_⟩
          · intro hSub
            have _ := hSub_K hSub
            exact e_Zc_ker.toEquiv.subsingleton
          · intro hOne
            obtain ⟨e_K⟩ := hOne_K hOne
            exact ⟨e_Zc_ker.trans e_K⟩
          · intro hTwo
            obtain ⟨e_K⟩ := hTwo_K hTwo
            exact ⟨e_Zc_ker.trans e_K⟩

        refine ⟨?_, hZc_above, ?_, ?_⟩
        · intro c
          by_cases hc_le : 2 * c + 1 ≤ 4 * n + 2
          · obtain ⟨h1, -, -⟩ := hZc_pair (2 * c + 1) (by omega) hc_le
            apply h1
            have hq'_odd : 2 * (2 * n + 1) - (2 * c + 1) = 2 * (2 * n - c) + 1 := by omega
            rw [hq'_odd]
            exact hOdd_Qn (2 * n - c)
          · exact hZc_above (2 * c + 1) (by omega)
        · intro c hc_le hc_ne
          rcases Nat.eq_zero_or_pos c with rfl | hc_pos
          · exact hZc_0
          · obtain ⟨-, h2, -⟩ := hZc_pair (2 * c) (by omega) (by omega)
            apply h2
            have hq'_even : 2 * (2 * n + 1) - 2 * c = 2 * (2 * n + 1 - c) := by omega
            rw [hq'_even]
            exact hEven_Qn (2 * n + 1 - c) (by omega) (by omega)
        · obtain ⟨-, -, h3⟩ := hZc_pair (2 * n + 2) (by omega) (by omega)
          apply h3
          have hq'_mid : 2 * (2 * n + 1) - (2 * n + 2) = 2 * n := by omega
          rw [hq'_mid]
          exact hMid_Qn

    have ⟨hCone_odd, hCone_above, hCone_even, hCone_mid⟩ := hCone
    refine ⟨hCone, ?_⟩
    obtain ⟨hAbove_Qsucc, hExc_Qsucc, -⟩ :=
      hVerdierExc F₀ ℓ s hℓ_F₀ Q_succ hInt_Qsucc (2 * (n + 1))
    obtain ⟨hInj_iZ, hBij_iZ⟩ := hExc_Qsucc Z_cone i_Z hi_Z_cl O_succ hO_compl
    have hO_sub : ∀ q : ℕ, 1 ≤ q →
        Subsingleton (weilEtaleTorsionH O_succ.toScheme n_mod q) := by
      intro q hq
      obtain ⟨e_q⟩ := hPullIsoEquiv e_O n_mod q
      have _ := hAffSub (2 * n + 2) q hq
      exact e_q.symm.toEquiv.subsingleton
    have hLowEquiv_Q : ∀ p : ℕ, p ≤ 4 * n + 2 →
        Nonempty (weilEtaleTorsionH Q_succ.left n_mod p ≃+
          weilEtaleTorsionH Z_cone.left n_mod p) := by
      intro p hp
      obtain ⟨p_iZ, hp_iZ⟩ := hPullEx i_Z.left n_mod p
      have hBij := hBij_iZ p (by omega)
        (hO_sub _ (by omega)) (hO_sub _ (by omega)) p_iZ hp_iZ
      exact ⟨AddEquiv.ofBijective p_iZ hBij⟩
    obtain ⟨tr_Qsucc, hTrBij_Qsucc, -, -⟩ :=
      weil_etale_smooth_proper_torsion_poincare_duality F₀ Q_succ hInt_Qsucc (2 * (n + 1))
        ℓ hℓ_char
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro c
      by_cases hc_le : 2 * c + 1 ≤ 4 * n + 2
      · obtain ⟨e_p⟩ := hLowEquiv_Q (2 * c + 1) hc_le
        have _ := hCone_odd c
        exact e_p.toEquiv.subsingleton
      · by_cases hc_eq : 2 * c + 1 = 4 * n + 3
        · obtain ⟨p_iZ, hp_iZ⟩ := hPullEx i_Z.left n_mod (2 * c + 1)
          have hInj := hInj_iZ (2 * c + 1) (by omega) (hO_sub _ (by omega)) p_iZ hp_iZ
          have hSub_Zc := hCone_odd c
          exact ⟨fun x y => hInj (hSub_Zc.elim _ _)⟩
        · exact hAbove_Qsucc (2 * c + 1) (by omega)
    · intro q hq
      exact hAbove_Qsucc q (by omega)
    · intro c hc_le hc_ne
      by_cases hc_top : c = 2 * (n + 1)
      · subst hc_top
        exact ⟨AddEquiv.ofBijective (tr_Qsucc (s + 1)) (hTrBij_Qsucc (s + 1))⟩
      · obtain ⟨e_p⟩ := hLowEquiv_Q (2 * c) (by omega)
        obtain ⟨e_Zc⟩ := hCone_even c (by omega) hc_ne
        exact ⟨e_p.trans e_Zc⟩
    · obtain ⟨e_p⟩ := hLowEquiv_Q (2 * (n + 1)) (by omega)
      exact ⟨e_p.trans hCone_mid.some⟩

  have hSplitQuadAll : ∀ (F₀ : Type u) [Field F₀] [IsAlgClosed F₀] (_ : (ℓ : F₀) ≠ 0)
      (s n : ℕ)
      (Q_n : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀)))
      [AlgebraicGeometry.IsProper Q_n.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * n) Q_n.hom]
      (ι_n : Q_n.left ⟶ (weilProjectiveSpaceOver F₀ (2 * n + 1)).left),
      ι_n ≫ (weilProjectiveSpaceOver F₀ (2 * n + 1)).hom = Q_n.hom →
      IsHomogeneousHypersurfacePullbackOver F₀ (2 * n + 1) 2
        (𝟙 (weilProjectiveSpaceOver F₀ (2 * n + 1))) (F_split_poly F₀ n) ι_n →
      SplitQuadPkg F₀ s n Q_n := by
    intro F₀ _ _ hℓ_F₀ s n
    induction n with
    | zero =>
      intro Q₀ _ _ ι₀ hι₀ hSplit₀
      obtain ⟨U₀, U₁, hInf, hSup, hIso₀, hIso₁⟩ :=
        (weil_split_quad_dim_zero_and_p1_chart_decomp F₀).1 Q₀ ι₀ hι₀ hSplit₀
      let _ : CategoryTheory.IsIso (U₀.ι ≫ Q₀.hom) := hIso₀
      let _ : CategoryTheory.IsIso (U₁.ι ≫ Q₀.hom) := hIso₁
      let e₀_spec : U₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of F₀) :=
        CategoryTheory.asIso (U₀.ι ≫ Q₀.hom)
      let e₁_spec : U₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of F₀) :=
        CategoryTheory.asIso (U₁.ι ≫ Q₀.hom)
      obtain ⟨⟨e_Spec0⟩, hSpecAbove⟩ := hSpecCoh F₀ hℓ_F₀ s
      have hQ0_prod : ∀ q : ℕ,
          Nonempty (weilEtaleTorsionH Q₀.left (ℓ ^ (s + 1)) q ≃+
            weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of F₀)) (ℓ ^ (s + 1)) q ×
              weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of F₀)) (ℓ ^ (s + 1)) q) := by
        intro q
        obtain ⟨p₀, hp₀⟩ := hPullEx U₀.ι (ℓ ^ (s + 1)) q
        obtain ⟨p₁, hp₁⟩ := hPullEx U₁.ι (ℓ ^ (s + 1)) q
        have hBij := hClopenProd Q₀.left U₀ U₁ hInf hSup (ℓ ^ (s + 1)) q p₀ p₁ hp₀ hp₁
        obtain ⟨eq₀⟩ := hPullIsoEquiv e₀_spec (ℓ ^ (s + 1)) q
        obtain ⟨eq₁⟩ := hPullIsoEquiv e₁_spec (ℓ ^ (s + 1)) q
        exact ⟨(AddEquiv.ofBijective _ hBij).trans (AddEquiv.prodCongr eq₀.symm eq₁.symm)⟩
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro c
        obtain ⟨e_q⟩ := hQ0_prod (2 * c + 1)
        have _ := hSpecAbove (2 * c + 1) (by omega)
        exact e_q.toEquiv.subsingleton
      · intro q hq
        obtain ⟨e_q⟩ := hQ0_prod q
        have _ := hSpecAbove q (by omega)
        exact e_q.toEquiv.subsingleton
      · intro c hc_le hc_ne
        omega
      · obtain ⟨e_0⟩ := hQ0_prod 0
        exact ⟨e_0.trans (AddEquiv.prodCongr e_Spec0 e_Spec0)⟩
    | succ n ih =>
      intro Q_succ _ _ ι_succ hι_succ hSplit_succ
      obtain ⟨Z_cone, hProp_Zc, i_Z, hSplit_Z⟩ :=
        (hConeBlowupCharts F₀ n).1 Q_succ ι_succ hι_succ hSplit_succ
      let _ : AlgebraicGeometry.IsProper Z_cone.hom := hProp_Zc
      exact (hConeStep F₀ hℓ_F₀ s n ih Q_succ Z_cone ι_succ hι_succ i_Z hSplit_succ hSplit_Z).2

  refine ⟨?_, ?_⟩
  · intro k _ _ hℓ_k Q_succ Z_cone _ _ _ ι_succ hι_succ i_Z F_amb_k hSplit_succ hSplit_Z
    obtain ⟨⟨hCone_odd, _, hCone_even, ⟨e_mid⟩⟩, _⟩ :=
      hConeStep k hℓ_k r m (hSplitQuadAll k hℓ_k r m) Q_succ Z_cone ι_succ hι_succ i_Z
        hSplit_succ hSplit_Z
    let _ : NeZero (ℓ ^ (r + 1)) := ⟨(pow_pos hℓ_pos (r + 1)).ne'⟩
    refine ⟨?_, ?_, ?_⟩
    · intro c _
      exact hCone_odd c
    · intro c hc
      obtain ⟨e_c⟩ := hCone_even c (by omega) (by omega)
      refine ⟨Finite.of_equiv _ e_c.symm.toEquiv, ?_⟩
      exact (Nat.card_congr e_c.toEquiv).trans (Nat.card_zmod (ℓ ^ (r + 1)))
    · exact ⟨e_mid.toAddMonoidHom, e_mid.injective⟩

  · intro Ω _ _ hℓ_Ω c_0 hc_0 Q_amb Q_sm _ _ _ _ ι_amb hι_amb i_sm F_amb_Ω hSplit_amb hSplit_sm
    obtain ⟨hℓ_char_Ω, hUnit_Ω⟩ := hCharAndUnit Ω hℓ_Ω
    have hPBC_Ω : WeilProperModPrimeBaseChangeHolds Ω ℓ :=
      weil_etale_proper_base_change_mod_prime Ω ℓ hℓ_Ω
    have hA1Zero_Ω := fun δ b hb =>
      weil_smooth_pencil_locConst_affine_a1_higherDirectImage_isZero Ω ℓ hℓ_Ω hPBC_Ω δ b hb
    obtain ⟨hInt_Qamb, hInt_Qsm, hi_sm_cl, W_aff, H_aff, e_H, U_sm, j_UH, e_Usm,
      hAff_W, hW_compl, hU_sm_compl, hAff_Usm, hDim_Usm, _, hj_UH_comm, _⟩ :=
      hSmSliceCharts Ω m c_0 hc_0 Q_amb Q_sm ι_amb hι_amb i_sm hSplit_amb hSplit_sm

    let P_amb := weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)
    obtain ⟨hInt_Pamb, hProj_Pamb, hDim_Pamb, -⟩ :=
      weil_projectiveSpace_integral_krullDim_and_dim_zero_iso Ω (2 * (m + 1) + 1)
    let _ : AlgebraicGeometry.IsProper P_amb.hom := hProperOfProj Ω P_amb hProj_Pamb
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1) + 1) P_amb.hom :=
      (hProjStepCharts Ω (2 * (m + 1) + 1)).1
    have hDim_Waff : topologicalKrullDim W_aff.toScheme ≤
        (((2 * (m + 1) + 1 : ℕ) : WithBot ℕ∞)) := by
      calc topologicalKrullDim W_aff.toScheme
          ≤ topologicalKrullDim P_amb.left :=
            topologicalKrullDim_subspace_le P_amb.left (W_aff : Set P_amb.left)
        _ = (((2 * (m + 1) + 1 : ℕ) : WithBot ℕ∞)) := hDim_Pamb

    let U_W_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      CategoryTheory.Over.mk (W_aff.ι ≫ P_amb.hom)
    let _ : AlgebraicGeometry.IsAffine U_W_over.left := hAff_W
    let _ : AlgebraicGeometry.LocallyOfFiniteType U_W_over.hom := by
      change AlgebraicGeometry.LocallyOfFiniteType (W_aff.ι ≫ P_amb.hom)
      infer_instance

    let U_sm_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      CategoryTheory.Over.mk (U_sm.ι ≫ Q_amb.hom)
    let _ : AlgebraicGeometry.IsAffine U_sm_over.left := hAff_Usm
    let _ : AlgebraicGeometry.LocallyOfFiniteType U_sm_over.hom := by
      change AlgebraicGeometry.LocallyOfFiniteType (U_sm.ι ≫ Q_amb.hom)
      infer_instance

    have hSmPkg : ∀ s : ℕ,
        let n_mod := ℓ ^ (s + 1)
        (∀ p : ℕ, p ≤ 2 * m →
          ∀ p_sm : weilEtaleTorsionH Q_amb.left n_mod p →+ weilEtaleTorsionH Q_sm.left n_mod p,
            WeilIsTorsionEtalePullback i_sm.left n_mod p p_sm →
            Function.Bijective p_sm) ∧
        Nonempty (weilEtaleTorsionH Q_sm.left n_mod (2 * m + 2) ≃+ ZMod n_mod) ∧
        (∀ p_top : weilEtaleTorsionH Q_amb.left n_mod (2 * m + 2) →+
            weilEtaleTorsionH Q_sm.left n_mod (2 * m + 2),
          WeilIsTorsionEtalePullback i_sm.left n_mod (2 * m + 2) p_top →
          Function.Surjective p_top) := by
      intro s n_mod
      have hn_ge1 : 1 ≤ n_mod := Nat.one_le_pow (s + 1) ℓ hℓ_pos
      have _ : NeZero n_mod := ⟨(pow_pos hℓ_pos (s + 1)).ne'⟩
      have hAffSub_s :=
        (weil_split_quad_affine_bundle_cohomology_pullback_bijective Ω ℓ s hℓ_Ω hA1Zero_Ω).1
      obtain ⟨_, _, hEven_Qamb, _⟩ :=
        hSplitQuadAll Ω hℓ_Ω s (m + 1) Q_amb ι_amb hι_amb hSplit_amb
      obtain ⟨_, hExc_Qamb, -⟩ := hVerdierExc Ω ℓ s hℓ_Ω Q_amb hInt_Qamb (2 * (m + 1))
      obtain ⟨_, hBij_ism⟩ := hExc_Qamb Q_sm i_sm hi_sm_cl U_sm hU_sm_compl
      have hUsm_sub : ∀ q : ℕ, 2 * (m + 1) < q →
          Subsingleton (weilEtaleTorsionH U_sm.toScheme n_mod q) :=
        fun q hq =>
          weil_affine_etale_cohomological_dimension Ω (2 * (m + 1)) n_mod q hn_ge1 (hUnit_Ω s)
            U_sm_over hDim_Usm hq
      have hLowBij : ∀ p : ℕ, p ≤ 2 * m →
          ∀ p_sm : weilEtaleTorsionH Q_amb.left n_mod p →+ weilEtaleTorsionH Q_sm.left n_mod p,
            WeilIsTorsionEtalePullback i_sm.left n_mod p p_sm →
            Function.Bijective p_sm := by
        intro p hp p_sm hp_sm
        exact hBij_ism p (by omega)
          (hUsm_sub _ (by omega)) (hUsm_sub _ (by omega)) p_sm hp_sm

      have hQsm_2m : Nonempty (weilEtaleTorsionH Q_sm.left n_mod (2 * m) ≃+ ZMod n_mod) := by
        obtain ⟨p_2m, hp_2m⟩ := hPullEx i_sm.left n_mod (2 * m)
        have hBij_2m := hLowBij (2 * m) (le_refl _) p_2m hp_2m
        obtain ⟨e_amb_2m⟩ := hEven_Qamb m (by omega) (by omega)
        exact ⟨(AddEquiv.ofBijective p_2m hBij_2m).symm.trans e_amb_2m⟩

      obtain ⟨tr_Qsm, _, _, hNondeg_Qsm⟩ :=
        weil_etale_smooth_proper_torsion_poincare_duality Ω Q_sm hInt_Qsm (2 * m + 1)
          ℓ hℓ_char_Ω
      have hQsm_top : Nonempty (weilEtaleTorsionH Q_sm.left n_mod (2 * m + 2) ≃+ ZMod n_mod) := by
        have h_sub_2m : 2 * (2 * m + 1) - (2 * m + 2) = 2 * m := by omega
        obtain ⟨⟨θ_sm_a, hθ_sm_a, hBij_sm_a⟩, _⟩ := hModComp Q_sm.left n_mod (2 * m + 2)
        obtain ⟨⟨θ_sm_b, hθ_sm_b, hBij_sm_b⟩, _⟩ :=
          hModComp Q_sm.left n_mod (2 * (2 * m + 1) - (2 * m + 2))
        obtain ⟨⟨θ_sm_top, hθ_sm_top, _⟩, _⟩ := hModComp Q_sm.left n_mod (2 * (2 * m + 1))
        let e_sm_a := AddEquiv.ofBijective θ_sm_a hBij_sm_a
        let e_sm_b := AddEquiv.ofBijective θ_sm_b hBij_sm_b
        let B_sm := CategoryTheory.Abelian.Ext.bilinearComp
          (weilEtaleModuleUnit Q_sm.left n_mod)
          (weilEtaleModuleUnit Q_sm.left n_mod)
          (weilEtaleModuleUnit Q_sm.left n_mod)
          (2 * m + 2) (2 * (2 * m + 1) - (2 * m + 2)) (2 * (2 * m + 1))
          (Nat.add_sub_of_le (by omega))
        let tr_sm_hom := (tr_Qsm (s + 1)).comp θ_sm_top
        let P_sm : weilEtaleTorsionH Q_sm.left n_mod (2 * m + 2) →+
            weilEtaleTorsionH Q_sm.left n_mod (2 * (2 * m + 1) - (2 * m + 2)) →+ ZMod n_mod :=
          { toFun := fun x => (tr_sm_hom.comp (B_sm (e_sm_a.symm x))).comp e_sm_b.symm.toAddMonoidHom
            map_zero' := by ext y; simp
            map_add' := fun x₁ x₂ => by ext y; simp }
        obtain ⟨hL_sm, hR_sm⟩ := hNondeg_Qsm (s + 1) (2 * m + 2) (by omega) θ_sm_top hθ_sm_top
        have hP_sm_L : ∀ x, P_sm x = 0 → x = 0 := by
          intro x hx0
          have ha0 : e_sm_a.symm x = 0 := by
            apply hL_sm
            intro b
            have h1 := DFunLike.congr_fun hx0 (e_sm_b b)
            simpa [P_sm, tr_sm_hom, B_sm] using h1
          have hx_eq : x = e_sm_a (e_sm_a.symm x) := (e_sm_a.apply_symm_apply x).symm
          rw [hx_eq, ha0, map_zero]
        have hP_sm_R : ∀ y, (∀ x, P_sm x y = 0) → y = 0 := by
          intro y hy0
          have hb0 : e_sm_b.symm y = 0 := by
            apply hR_sm
            intro a
            have h1 := hy0 (e_sm_a a)
            simpa [P_sm, tr_sm_hom, B_sm] using h1
          have hy_eq : y = e_sm_b (e_sm_b.symm y) := (e_sm_b.apply_symm_apply y).symm
          rw [hy_eq, hb0, map_zero]
        have hQsm_2m' : Nonempty
            (weilEtaleTorsionH Q_sm.left n_mod (2 * (2 * m + 1) - (2 * m + 2)) ≃+ ZMod n_mod) := by
          rwa [h_sub_2m]
        exact (hPairEquiv s P_sm hP_sm_L hP_sm_R).2.1 hQsm_2m'

      obtain ⟨e_Qsm⟩ := hQsm_top
      refine ⟨hLowBij, ⟨e_Qsm⟩, ?_⟩
      intro p_top hp_top
      obtain ⟨_, hExc_Pamb, -⟩ := hVerdierExc Ω ℓ s hℓ_Ω P_amb hInt_Pamb (2 * (m + 1) + 1)
      let i_amb_over : Q_amb ⟶ P_amb := CategoryTheory.Over.homMk ι_amb hι_amb
      obtain ⟨hInj_ιamb, _⟩ := hExc_Pamb Q_amb i_amb_over hSplit_amb.1 W_aff hW_compl
      let d_mid := 2 * (2 * (m + 1)) - (2 * m + 2)
      have hd_mid : d_mid = 2 * (m + 1) := by omega
      have hSub_Waff : Subsingleton
          (weilEtaleTorsionH W_aff.toScheme n_mod (2 * (2 * (m + 1) + 1) - d_mid)) :=
        weil_affine_etale_cohomological_dimension Ω (2 * (m + 1) + 1) n_mod
          (2 * (2 * (m + 1) + 1) - d_mid) hn_ge1 (hUnit_Ω s) U_W_over hDim_Waff (by omega)
      obtain ⟨p_ιamb, hp_ιamb⟩ := hPullEx ι_amb n_mod d_mid
      have hInj_pι : Function.Injective p_ιamb :=
        hInj_ιamb d_mid (by omega) hSub_Waff p_ιamb hp_ιamb
      have hPamb_dmid : Nonempty (weilEtaleTorsionH P_amb.left n_mod d_mid ≃+ ZMod n_mod) := by
        rw [hd_mid]
        exact (hProjCoh Ω hℓ_Ω s (2 * (m + 1) + 1)).2.2 (m + 1) (by omega)
      obtain ⟨e_Pamb_dmid⟩ := hPamb_dmid
      let η : weilEtaleTorsionH P_amb.left n_mod d_mid := e_Pamb_dmid.symm 1
      let ξ_hyp : weilEtaleTorsionH Q_amb.left n_mod d_mid := p_ιamb η
      have hξ_pow_ne : (ℓ ^ s) • ξ_hyp ≠ 0 := by
        intro h0
        have hη0 : (ℓ ^ s) • η = 0 := by
          apply hInj_pι
          rw [map_nsmul, map_zero]
          exact h0
        have h1 := congrArg e_Pamb_dmid hη0
        rw [map_nsmul, map_zero, e_Pamb_dmid.apply_symm_apply, nsmul_eq_mul, mul_one] at h1
        exact hZModPowNe s h1

      obtain ⟨p_Usm', hp_Usm'⟩ := hPullEx U_sm.ι n_mod d_mid
      obtain ⟨p_Haff, hp_Haff⟩ := hPullEx H_aff.ι n_mod d_mid
      obtain ⟨p_jUH, hp_jUH⟩ := hPullEx j_UH n_mod d_mid
      obtain ⟨p_comp_UH, hp_comp_UH⟩ := hPullEx (U_sm.ι ≫ ι_amb) n_mod d_mid
      have hSub_Haff : Subsingleton (weilEtaleTorsionH H_aff.toScheme n_mod d_mid) := by
        obtain ⟨e_Hq⟩ := hPullIsoEquiv e_H n_mod d_mid
        have _ := hAffSub_s (2 * (m + 1) + 1) d_mid (by omega)
        exact e_Hq.symm.toEquiv.subsingleton
      have hξ_Usm_zero : p_Usm' ξ_hyp = 0 := by
        have h1 := hPullTri U_sm.ι ι_amb (U_sm.ι ≫ ι_amb) n_mod d_mid
          p_Usm' p_ιamb p_comp_UH rfl hp_Usm' hp_ιamb hp_comp_UH η
        have h2 := hPullTri j_UH H_aff.ι (U_sm.ι ≫ ι_amb) n_mod d_mid
          p_jUH p_Haff p_comp_UH hj_UH_comm hp_jUH hp_Haff hp_comp_UH η
        change p_Usm' (p_ιamb η) = 0
        rw [← h1, h2, hSub_Haff.elim (p_Haff η) 0, map_zero]

      obtain ⟨tr_Qamb, _, _, hNondeg_Qamb⟩ :=
        weil_etale_smooth_proper_torsion_poincare_duality Ω Q_amb hInt_Qamb (2 * (m + 1))
          ℓ hℓ_char_Ω
      obtain ⟨⟨θ_amb_mid, hθ_amb_mid, _⟩, _⟩ :=
        hModComp Q_amb.left n_mod (2 * m + 2)
      obtain ⟨⟨θ_amb_mid', hθ_amb_mid', hBij_amb_mid'⟩, _⟩ :=
        hModComp Q_amb.left n_mod d_mid
      obtain ⟨⟨θ_amb_top, hθ_amb_top, _⟩, _⟩ :=
        hModComp Q_amb.left n_mod (2 * (2 * (m + 1)))
      let e_amb_mid' := AddEquiv.ofBijective θ_amb_mid' hBij_amb_mid'
      let b_hyp : weilEtaleModuleH Q_amb.left n_mod d_mid := e_amb_mid'.symm ξ_hyp
      have hb_hyp_Usm : p_Usm' (θ_amb_mid' b_hyp) = 0 := by
        change p_Usm' (e_amb_mid' (e_amb_mid'.symm ξ_hyp)) = 0
        rwa [e_amb_mid'.apply_symm_apply]
      have hb_hyp_pow_ne : (ℓ ^ s) • b_hyp ≠ 0 := by
        intro hb0
        apply hξ_pow_ne
        have h2 := congrArg e_amb_mid' hb0
        rw [map_nsmul, map_zero, e_amb_mid'.apply_symm_apply] at h2
        exact h2

      obtain ⟨_, hR_Qamb⟩ := hNondeg_Qamb (s + 1) (2 * m + 2) (by omega) θ_amb_top hθ_amb_top
      have hex_a : ∃ a_m : weilEtaleModuleH Q_amb.left n_mod (2 * m + 2),
          tr_Qamb (s + 1) (θ_amb_top (CategoryTheory.Abelian.Ext.comp a_m ((ℓ ^ s) • b_hyp)
            (Nat.add_sub_of_le (by omega)))) ≠ 0 := by
        by_contra hall
        exact hb_hyp_pow_ne (hR_Qamb ((ℓ ^ s) • b_hyp)
          (fun a => Classical.not_not.mp ((not_exists.mp hall) a)))
      obtain ⟨a_m, ha_m_ne⟩ := hex_a
      let B_amb := CategoryTheory.Abelian.Ext.bilinearComp
        (weilEtaleModuleUnit Q_amb.left n_mod)
        (weilEtaleModuleUnit Q_amb.left n_mod)
        (weilEtaleModuleUnit Q_amb.left n_mod)
        (2 * m + 2) d_mid (2 * (2 * (m + 1)))
        (Nat.add_sub_of_le (by omega))
      have hcomp_smul_eq :
          CategoryTheory.Abelian.Ext.comp ((ℓ ^ s) • a_m) b_hyp (Nat.add_sub_of_le (by omega)) =
          CategoryTheory.Abelian.Ext.comp a_m ((ℓ ^ s) • b_hyp) (Nat.add_sub_of_le (by omega)) := by
        change B_amb ((ℓ ^ s) • a_m) b_hyp = B_amb a_m ((ℓ ^ s) • b_hyp)
        rw [map_nsmul, AddMonoidHom.nsmul_apply, map_nsmul]
      let a₀ : weilEtaleTorsionH Q_amb.left n_mod (2 * m + 2) := θ_amb_mid a_m
      let w : ZMod n_mod := e_Qsm (p_top a₀)
      have hw_unit : IsUnit w := by
        by_contra hnu
        have hw_ann : (ℓ ^ s) • w = 0 := by
          rw [nsmul_eq_mul]
          exact hZModNonunitAnn s w hnu
        have hptop_zero : p_top (θ_amb_mid ((ℓ ^ s) • a_m)) = 0 := by
          apply e_Qsm.injective
          rw [map_nsmul, map_nsmul, map_nsmul, map_zero]
          exact hw_ann
        have hcomp0 := hClosedOpenOrth Q_amb.left Q_sm.left i_sm.left hi_sm_cl U_sm hU_sm_compl
          n_mod (2 * m + 2) d_mid (2 * (2 * (m + 1)))
          hn_ge1 (Nat.add_sub_of_le (by omega))
          p_top p_Usm' θ_amb_mid θ_amb_mid' hp_top hp_Usm' hθ_amb_mid hθ_amb_mid'
          ((ℓ ^ s) • a_m) b_hyp hptop_zero hb_hyp_Usm
        rw [hcomp_smul_eq] at hcomp0
        rw [hcomp0, map_zero, map_zero] at ha_m_ne
        exact ha_m_ne rfl
      intro y
      let z : ZMod n_mod := e_Qsm y * ↑(hw_unit.unit⁻¹)
      refine ⟨z.val • a₀, ?_⟩
      apply e_Qsm.injective
      rw [map_nsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
      change (e_Qsm y * ↑(hw_unit.unit⁻¹)) * w = e_Qsm y
      rw [mul_assoc, hw_unit.val_inv_mul, mul_one]

    obtain ⟨hLowBij_r, ⟨e_Qsm_r⟩, hTopSurj_r⟩ := hSmPkg r
    obtain ⟨hOdd_Qamb_r, _, hEven_Qamb_r, _⟩ :=
      hSplitQuadAll Ω hℓ_Ω r (m + 1) Q_amb ι_amb hι_amb hSplit_amb
    let _ : NeZero (ℓ ^ (r + 1)) := ⟨(pow_pos hℓ_pos (r + 1)).ne'⟩

    have hSm_mid_odd : Subsingleton (weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * m + 1)) := by
      apply hBocksteinSub Q_sm.left ℓ r (2 * m + 1)
      obtain ⟨_, ⟨e_Qsm_0⟩, hTopSurj_0⟩ := hSmPkg 0
      obtain ⟨hOdd_Qamb_0, _, _, ⟨e_Qamb_mid_0⟩⟩ :=
        hSplitQuadAll Ω hℓ_Ω 0 (m + 1) Q_amb ι_amb hι_amb hSplit_amb
      rw [pow_one] at e_Qsm_0 hTopSurj_0 hOdd_Qamb_0 e_Qamb_mid_0
      obtain ⟨_, _, hMidVanish⟩ := hVerdierExc Ω ℓ 0 hℓ_Ω Q_amb hInt_Qamb (2 * (m + 1))
      let _ : NeZero ℓ := ⟨hℓ_pos.ne'⟩
      have hFin_Qamb : Finite (weilEtaleTorsionH Q_amb.left ℓ (2 * m + 2)) :=
        Finite.of_equiv _ e_Qamb_mid_0.symm.toEquiv
      have hFin_Qsm : Finite (weilEtaleTorsionH Q_sm.left ℓ (2 * m + 2)) :=
        Finite.of_equiv _ e_Qsm_0.symm.toEquiv
      have hCard_Qamb : Nat.card (weilEtaleTorsionH Q_amb.left ℓ (2 * m + 2)) = ℓ * ℓ := by
        rw [show 2 * m + 2 = 2 * (m + 1) from rfl,
          Nat.card_congr e_Qamb_mid_0.toEquiv, Nat.card_prod, Nat.card_zmod]
      have hCard_Qsm : Nat.card (weilEtaleTorsionH Q_sm.left ℓ (2 * m + 2)) = ℓ :=
        (Nat.card_congr e_Qsm_0.toEquiv).trans (Nat.card_zmod ℓ)
      obtain ⟨p_top_0, hp_top_0⟩ := hPullEx i_sm.left ℓ (2 * m + 2)
      have hSurj_top_0 : Function.Surjective p_top_0 := hTopSurj_0 p_top_0 hp_top_0
      obtain ⟨hFin_Aaff, hCard_Aaff⟩ :=
        weil_quad_cvs_affine_quadric_mod_prime_top_card Ω ℓ hℓ_Ω c_0 hc_0 m
      obtain ⟨e_U_A⟩ := hPullIsoEquiv e_Usm ℓ (2 * m + 2)
      have h_sub_2m2 : 2 * (2 * (m + 1)) - (2 * m + 1 + 1) = 2 * m + 2 := by omega
      have hFin_Usm : Finite
          (weilEtaleTorsionH U_sm.toScheme ℓ (2 * (2 * (m + 1)) - (2 * m + 1 + 1))) := by
        rw [h_sub_2m2]
        exact Finite.of_equiv _ e_U_A.toEquiv
      have hCard_Usm : Nat.card
          (weilEtaleTorsionH U_sm.toScheme ℓ (2 * (2 * (m + 1)) - (2 * m + 1 + 1))) ≤ ℓ := by
        rw [h_sub_2m2, Nat.card_congr e_U_A.symm.toEquiv]
        exact hCard_Aaff
      exact hMidVanish Q_sm i_sm hi_sm_cl U_sm hU_sm_compl (2 * m + 1) (by omega)
        (hOdd_Qamb_0 m) hFin_Qamb hFin_Qsm
        (by rw [hCard_Qamb, hCard_Qsm])
        ⟨p_top_0, hp_top_0, hSurj_top_0⟩
        hFin_Usm hCard_Usm

    refine ⟨?_, ?_, ⟨⟨e_Qsm_r⟩, hTopSurj_r⟩⟩
    · intro c hc
      by_cases hc_eq : c = m
      · subst hc_eq
        exact hSm_mid_odd
      · obtain ⟨p_sm, hp_sm⟩ := hPullEx i_sm.left (ℓ ^ (r + 1)) (2 * c + 1)
        have hBij := hLowBij_r (2 * c + 1) (by omega) p_sm hp_sm
        have _ := hOdd_Qamb_r c
        exact (AddEquiv.ofBijective p_sm hBij).symm.toEquiv.subsingleton
    · intro c hc
      obtain ⟨p_sm₀, hp_sm₀⟩ := hPullEx i_sm.left (ℓ ^ (r + 1)) (2 * c)
      have hBij₀ := hLowBij_r (2 * c) (by omega) p_sm₀ hp_sm₀
      obtain ⟨e_amb_c⟩ := hEven_Qamb_r c (by omega) (by omega)
      let e_sm_c := (AddEquiv.ofBijective p_sm₀ hBij₀).symm.trans e_amb_c
      refine ⟨Finite.of_equiv _ e_sm_c.symm.toEquiv,
        (Nat.card_congr e_sm_c.toEquiv).trans (Nat.card_zmod (ℓ ^ (r + 1))), ?_⟩
      intro p_sm hp_sm
      exact (hLowBij_r (2 * c) (by omega) p_sm hp_sm).2

theorem weil_odp_wit_local_odp_spec_coker_cyclic (F : Type u) [Finite F] [Field F]
    (m ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
      (s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s₀))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hSm_U₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀))
    (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hs_sec : s ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (x_s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left)
    (hx_s : x_s ≫ f₀.left = s)
    (hSm_away : ∀ z : Z_tilde.left,
      f₀.left.base z ∈ Set.range s.base → z ∉ Set.range x_s.base →
      ∃ V : Z_tilde.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
    (hOdp_s : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_s.base pt) (s.base pt)) :
    let k := AlgebraicClosure F
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    ∀ (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
      (p_R : P →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k) (φ_R_Ω : R_bar →+* Ω)
      (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
      (D_col : ℐ ⥤ CommRingCat.{u})
      (α_col : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D_col)
      (c_col : CategoryTheory.Limits.Cocone D_col)
      (_hc_col : CategoryTheory.Limits.IsColimit c_col)
      (e_pt : c_col.pt ≅ CommRingCat.of R_bar),
      (p_R Polynomial.X = t_bar ∧
        π_cl.comp p_R = Polynomial.evalRingHom 0 ∧
        φ_R_Ω.comp p_R = algebraMap P Ω ∧
        Function.Injective φ_R_Ω ∧
        @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra) →
      ((∀ i : ℐ,
          (α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
          Function.Injective ((c_col.ι.app i) ≫ e_pt.hom).hom) ∧
        (∀ i : ℐ,
          ∃ (ϖ : ↑(D_col.obj i)) (u : (↑(D_col.obj i))ˣ) (e : ℕ)
            (ψ_i : Polynomial k →+* ↑(D_col.obj i)),
            1 ≤ e ∧
            ((c_col.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
            (α_col.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
            ψ_i.comp Polynomial.C = (α_col.app i).hom.comp Polynomial.C ∧
            ψ_i Polynomial.X = ϖ ∧
            ψ_i.Etale ∧
            ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D_col.obj i₁))
              (ψ₁ : Polynomial k →+* ↑(D_col.obj i₁)),
              (D_col.map θ).hom ϖ = β ^ ℓ ∧
              ψ₁.comp Polynomial.C = (α_col.app i₁).hom.comp Polynomial.C ∧
              ψ₁ Polynomial.X = β ∧
              ψ₁.Etale)) →
      (∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S) [AlgebraicGeometry.Etale w₀]
          (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
          (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀),
        s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
        ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
          g_tilde ≫ w₀ = g_S ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde) →
      ∀ (V_s : ValuationSubring Ω) (j_val : R_bar →+* ↥V_s) (π_Vs : ↥V_s →+* k),
        IsLocalHom j_val →
        V_s.subtype.comp j_val = φ_R_Ω →
        RingHom.ker π_Vs = IsLocalRing.maximalIdeal ↥V_s →
        π_Vs.comp j_val = π_cl →
        ∀ (g_s : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
            (weilProjectiveSpaceOver F 1).left),
          g_s ≫ (weilProjectiveSpaceOver F 1).hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (p_R.comp (Polynomial.C.comp (algebraMap F k)))) →
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_s =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)) ≫ s →
          Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s).base ⊆
            (U₀ : Set (weilProjectiveSpaceOver F 1).left) →
          (∃ ψ_gen : Polynomial F →+* Ω,
            Function.Injective ψ_gen ∧
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen) ≫ j_aff) →
          (∀ γ : Ω ≃ₐ[FractionRing P] Ω,
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s) →
          let η_D := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s
          let Z_Ω := CategoryTheory.Limits.pullback f₀.left η_D
          ∃ ν_r : weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) (2 * m + 1) →+ ZMod (ℓ ^ (r + 1)),
            ∀ x : weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) (2 * m + 1),
              ν_r x = 0 →
              ∀ γ : Ω ≃ₐ[FractionRing P] Ω,
                (∀ z : Ω, z ∈ V_s ↔ γ z ∈ V_s) →
                ∀ (τ_Z : Z_Ω ⟶ Z_Ω),
                  τ_Z ≫ CategoryTheory.Limits.pullback.fst f₀.left η_D =
                    CategoryTheory.Limits.pullback.fst f₀.left η_D →
                  τ_Z ≫ CategoryTheory.Limits.pullback.snd f₀.left η_D =
                    CategoryTheory.Limits.pullback.snd f₀.left η_D ≫
                      AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) →
                  ∀ (p_τ : weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) (2 * m + 1) →+
                      weilEtaleTorsionH Z_Ω (ℓ ^ (r + 1)) (2 * m + 1)),
                    WeilIsTorsionEtalePullback τ_Z (ℓ ^ (r + 1)) (2 * m + 1) p_τ →
                    p_τ x = x :=
by
  classical
  intro k P Ω
  intro R_bar _ _ _ p_R t_bar π_cl φ_R_Ω ℐ _ _ D_col α_col c_col hc_col e_pt
  rintro ⟨ht_eq, hπ_pR, hφ_pR, hφ_inj, hLoc_R⟩ ⟨hCocone, hStage⟩ hLiftTrait
  intro V_s j_val π_Vs hj_val_loc hj_val_Ω hπ_Vs_ker hπ_Vs_cl
  intro g_s hg_hom hg_cl hg_range hg_gen hg_γ_inv
  intro η_D Z_Ω
  let _ := And.intro hProj_Ztilde (And.intro hFibIrred hj_hom)
  let m₀ := ℓ ^ (r + 1)
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
  have hm₀_pos : 0 < m₀ := pow_pos hℓ_pos (r + 1)
  let _ : NeZero m₀ := ⟨hm₀_pos.ne'⟩

  
  have hℓ_F : (ℓ : F) ≠ 0 := by
    intro h0
    have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0
    rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hp0
    · exact hℓ ((Nat.Prime.dvd_iff_eq hℓ_prime hp.ne_one).mp hdvd)
    · rw [hp0, zero_dvd_iff] at hdvd
      exact hℓ_prime.ne_zero hdvd
  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
    have hF0 : (ℓ : F) = 0 :=
      (RingHom.injective (algebraMap F k))
        ((map_natCast (algebraMap F k) ℓ).trans (h0.trans (map_zero _).symm))
    exact hℓ_F hF0
  have hℓ_Ω : (ℓ : Ω) ≠ 0 := by
    intro h0
    let ι_kΩ : k →+* Ω := φ_R_Ω.comp (p_R.comp Polynomial.C)
    have hk0 : (ℓ : k) = 0 :=
      (RingHom.injective ι_kΩ)
        ((map_natCast ι_kΩ ℓ).trans (h0.trans (map_zero _).symm))
    exact hℓ_k hk0

  have hπ_cR : π_cl.comp (p_R.comp Polynomial.C) = RingHom.id k := by
    ext c
    change (π_cl.comp p_R) (Polynomial.C c) = c
    rw [hπ_pR, Polynomial.coe_evalRingHom, Polynomial.eval_C]
  have hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar := by
    ext x
    rw [RingHom.mem_ker, ← hπ_Vs_cl, RingHom.comp_apply, ← RingHom.mem_ker, hπ_Vs_ker,
      IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact not_congr (isUnit_map_iff j_val x)

  have hSpec2 : ∀ q : Ideal R_bar, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal R_bar := by
    intro q hq
    rw [or_iff_not_imp_left]
    intro hq_ne_bot
    apply le_antisymm (IsLocalRing.le_maximalIdeal hq.ne_top)
    have ht_mem : t_bar ∈ q := by
      obtain ⟨x, hx_q, hx_ne⟩ : ∃ x ∈ q, x ≠ 0 := by
        by_contra hall
        apply hq_ne_bot
        rw [eq_bot_iff]
        intro x hx
        exact Classical.not_not.mp fun hne => hall ⟨x, hx, hne⟩
      have hφx_ne : φ_R_Ω x ≠ 0 := fun h0 => hx_ne (hφ_inj (h0.trans (map_zero φ_R_Ω).symm))
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      have _ : IsLocalization.Away t_bar Ω := hLoc_R
      obtain ⟨n, r_num, hrn⟩ := IsLocalization.Away.surj t_bar ((φ_R_Ω x)⁻¹)
      have hmul_eq : φ_R_Ω (t_bar ^ n) = φ_R_Ω (x * r_num) := by
        have hrn' : (φ_R_Ω x)⁻¹ * φ_R_Ω (t_bar ^ n) = φ_R_Ω r_num := by
          rw [map_pow]
          exact hrn
        calc φ_R_Ω (t_bar ^ n)
            = (φ_R_Ω x * (φ_R_Ω x)⁻¹) * φ_R_Ω (t_bar ^ n) := by
                rw [mul_inv_cancel₀ hφx_ne, one_mul]
          _ = φ_R_Ω x * ((φ_R_Ω x)⁻¹ * φ_R_Ω (t_bar ^ n)) := mul_assoc _ _ _
          _ = φ_R_Ω x * φ_R_Ω r_num := by rw [hrn']
          _ = φ_R_Ω (x * r_num) := (map_mul φ_R_Ω x r_num).symm
      have htn_q : t_bar ^ n ∈ q := by
        rw [hφ_inj hmul_eq]
        exact q.mul_mem_right r_num hx_q
      cases n with
      | zero =>
        rw [pow_zero] at htn_q
        exact False.elim (hq.ne_top ((Ideal.eq_top_iff_one q).mpr htn_q))
      | succ n' =>
        exact hq.mem_of_pow_mem (n' + 1) htn_q
    let S_img : Subring R_bar :=
      { carrier := { z : R_bar | ∃ (i : ℐ) (z_i : ↑(D_col.obj i)),
          ((c_col.ι.app i) ≫ e_pt.hom).hom z_i = z }
        zero_mem' := ⟨IsFiltered.nonempty.some, 0, map_zero _⟩
        one_mem' := ⟨IsFiltered.nonempty.some, 1, map_one _⟩
        add_mem' := by
          rintro _ _ ⟨i₁, z₁, rfl⟩ ⟨i₂, z₂, rfl⟩
          let j := IsFiltered.max i₁ i₂
          refine ⟨j, (D_col.map (IsFiltered.leftToMax i₁ i₂)).hom z₁ +
            (D_col.map (IsFiltered.rightToMax i₁ i₂)).hom z₂, ?_⟩
          rw [map_add]
          have h1 : D_col.map (IsFiltered.leftToMax i₁ i₂) ≫ c_col.ι.app j ≫ e_pt.hom =
              c_col.ι.app i₁ ≫ e_pt.hom := by
            rw [← Category.assoc, c_col.w]
          have h2 : D_col.map (IsFiltered.rightToMax i₁ i₂) ≫ c_col.ι.app j ≫ e_pt.hom =
              c_col.ι.app i₂ ≫ e_pt.hom := by
            rw [← Category.assoc, c_col.w]
          exact congrArg₂ (· + ·) (ConcreteCategory.congr_hom h1 z₁)
            (ConcreteCategory.congr_hom h2 z₂)
        neg_mem' := by
          rintro _ ⟨i, z_i, rfl⟩
          exact ⟨i, -z_i, map_neg _ z_i⟩
        mul_mem' := by
          rintro _ _ ⟨i₁, z₁, rfl⟩ ⟨i₂, z₂, rfl⟩
          let j := IsFiltered.max i₁ i₂
          refine ⟨j, (D_col.map (IsFiltered.leftToMax i₁ i₂)).hom z₁ *
            (D_col.map (IsFiltered.rightToMax i₁ i₂)).hom z₂, ?_⟩
          rw [map_mul]
          have h1 : D_col.map (IsFiltered.leftToMax i₁ i₂) ≫ c_col.ι.app j ≫ e_pt.hom =
              c_col.ι.app i₁ ≫ e_pt.hom := by
            rw [← Category.assoc, c_col.w]
          have h2 : D_col.map (IsFiltered.rightToMax i₁ i₂) ≫ c_col.ι.app j ≫ e_pt.hom =
              c_col.ι.app i₂ ≫ e_pt.hom := by
            rw [← Category.assoc, c_col.w]
          exact congrArg₂ (· * ·) (ConcreteCategory.congr_hom h1 z₁)
            (ConcreteCategory.congr_hom h2 z₂) }
    let c_sub : CategoryTheory.Limits.Cocone D_col :=
      { pt := CommRingCat.of ↥S_img
        ι :=
          { app := fun i => CommRingCat.ofHom
              { toFun := fun z => ⟨((c_col.ι.app i) ≫ e_pt.hom).hom z, ⟨i, z, rfl⟩⟩
                map_one' := Subtype.ext (map_one _)
                map_mul' := fun a b => Subtype.ext (map_mul _ a b)
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun a b => Subtype.ext (map_add _ a b) }
            naturality := fun {i₁ i₂} θ => by
              apply CommRingCat.hom_ext
              ext z
              simp only [Functor.const_obj_map]
              apply Subtype.ext
              have hw : D_col.map θ ≫ c_col.ι.app i₂ ≫ e_pt.hom = c_col.ι.app i₁ ≫ e_pt.hom := by
                rw [← Category.assoc, c_col.w]
              exact ConcreteCategory.congr_hom hw z } }
    have hdesc_eq : hc_col.desc c_sub ≫ CommRingCat.ofHom S_img.subtype = e_pt.hom := by
      apply hc_col.hom_ext
      intro i
      rw [← Category.assoc, hc_col.fac]
      rfl
    intro y hy_max
    have hy_img : y ∈ S_img := by
      let w_sub : ↥S_img := (e_pt.inv ≫ hc_col.desc c_sub).hom y
      have hw_val : w_sub.1 = y := by
        change (e_pt.inv ≫ hc_col.desc c_sub ≫ CommRingCat.ofHom S_img.subtype).hom y = y
        rw [hdesc_eq, e_pt.inv_hom_id]
        rfl
      exact hw_val ▸ w_sub.2
    obtain ⟨i, y_i, rfl⟩ := hy_img
    let ι_i : ↑(D_col.obj i) →+* R_bar := ((c_col.ι.app i) ≫ e_pt.hom).hom
    obtain ⟨ϖ, u, e, ψ_i, _, hϖ_max, hX_eq, _, hψ_X, hψ_et, _⟩ := hStage i
    have hϖ_q : ι_i ϖ ∈ q := by
      have ht_i : ι_i ((α_col.app i).hom Polynomial.X) = t_bar := by
        have hc := ConcreteCategory.congr_hom (hCocone i).1 Polynomial.X
        exact hc.trans ht_eq
      rw [hX_eq, map_mul, map_pow] at ht_i
      have hmul_q : ι_i ↑u * (ι_i ϖ) ^ e ∈ q := ht_i.symm ▸ ht_mem
      have hu_not_q : ι_i ↑u ∉ q := fun hu_q =>
        hq.ne_top (Ideal.eq_top_of_isUnit_mem q hu_q (u.isUnit.map ι_i))
      exact hq.mem_of_pow_mem e ((hq.mem_or_mem hmul_q).resolve_left hu_not_q)
    let R_i := ↑(D_col.obj i)
    let I_ϖ := Ideal.span ({ϖ} : Set R_i)
    let Q_i := R_i ⧸ I_ϖ
    let mk_i : R_i →+* Q_i := Ideal.Quotient.mk I_ϖ
    let alg_P_k : Algebra P k := (Polynomial.evalRingHom (0 : k)).toAlgebra
    let alg_P_Ri : Algebra P R_i := ψ_i.toAlgebra
    let _ : Algebra P k := alg_P_k
    let _ : Algebra P R_i := alg_P_Ri
    have _ : Algebra.Etale P R_i := RingHom.etale_algebraMap.mp hψ_et
    have _ : Algebra.Etale k (TensorProduct P k R_i) := Algebra.Etale.baseChange P R_i k
    let c_Qi : k →+* Q_i := mk_i.comp (ψ_i.comp Polynomial.C)
    let alg_P_Qi : Algebra P Q_i := (mk_i.comp ψ_i).toAlgebra
    let _ : Algebra P Q_i := alg_P_Qi
    have hc_Qi_P : ∀ p : P, c_Qi (algebraMap P k p) = algebraMap P Q_i p := by
      intro p
      change mk_i (ψ_i (Polynomial.C (p.eval 0))) = mk_i (ψ_i p)
      have hroot : (p - Polynomial.C (p.eval 0)).IsRoot 0 := by
        rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, sub_self]
      obtain ⟨g_p, hg_p⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
      rw [map_zero, sub_zero] at hg_p
      have hdiff : ψ_i p - ψ_i (Polynomial.C (p.eval 0)) ∈ I_ϖ := by
        rw [← map_sub, hg_p, map_mul, hψ_X]
        exact Ideal.mem_span_singleton.mpr ⟨ψ_i g_p, rfl⟩
      exact (Ideal.Quotient.eq.mpr hdiff).symm
    let α_lin : TensorProduct P k R_i →ₗ[P] Q_i :=
      TensorProduct.lift
        (LinearMap.mk₂ P (fun (c : k) (r_el : R_i) => c_Qi c * mk_i r_el)
          (fun c₁ c₂ r_el => by rw [map_add, add_mul])
          (fun p c r_el => by
            change c_Qi (algebraMap P k p * c) * mk_i r_el =
              algebraMap P Q_i p * (c_Qi c * mk_i r_el)
            rw [map_mul, hc_Qi_P p, mul_assoc])
          (fun c r₁ r₂ => by rw [map_add, mul_add])
          (fun p c r_el => by
            change c_Qi c * mk_i (ψ_i p * r_el) = mk_i (ψ_i p) * (c_Qi c * mk_i r_el)
            rw [map_mul, mul_left_comm]))
    have hϖ_tens_zero :
        ((Algebra.TensorProduct.includeRight : R_i →ₐ[P] TensorProduct P k R_i).toRingHom) ϖ =
          0 := by
      have hϖ_smul : ϖ = (Polynomial.X : P) • (1 : R_i) := by
        change ϖ = ψ_i Polynomial.X * 1
        rw [hψ_X, mul_one]
      rw [hϖ_smul]
      change (1 : k) ⊗ₜ[P] ((Polynomial.X : P) • (1 : R_i)) = 0
      rw [← TensorProduct.smul_tmul]
      have hX_k : (Polynomial.X : P) • (1 : k) = 0 := by
        change Polynomial.eval (0 : k) Polynomial.X * 1 = 0
        simp
      rw [hX_k, TensorProduct.zero_tmul]
    let β_tens : Q_i →+* TensorProduct P k R_i :=
      Ideal.Quotient.lift I_ϖ
        (Algebra.TensorProduct.includeRight : R_i →ₐ[P] TensorProduct P k R_i).toRingHom
        (fun r_el hr => by
          obtain ⟨m_r, rfl⟩ := Ideal.mem_span_singleton.mp hr
          rw [map_mul, hϖ_tens_zero, zero_mul])
    have hαβ : ∀ q_el : Q_i, α_lin (β_tens q_el) = q_el := by
      intro q_el
      obtain ⟨r_el, rfl⟩ := Ideal.Quotient.mk_surjective q_el
      change α_lin ((1 : k) ⊗ₜ[P] r_el) = mk_i r_el
      simp [α_lin]
    have hβα : ∀ z : TensorProduct P k R_i, β_tens (α_lin z) = z := by
      intro z
      induction z using TensorProduct.inductionOn
      · rename_i c r_el
        have hc_eq : c ⊗ₜ[P] r_el = (1 : k) ⊗ₜ[P] (ψ_i (Polynomial.C c) * r_el) := by
          have hc_smul : c = (Polynomial.C c : P) • (1 : k) := by
            change c = Polynomial.eval (0 : k) (Polynomial.C c) * 1
            simp
          conv_lhs => rw [hc_smul, TensorProduct.smul_tmul]
          rfl
        rw [hc_eq]
        change β_tens (c_Qi 1 * mk_i (ψ_i (Polynomial.C c) * r_el)) =
          (1 : k) ⊗ₜ[P] (ψ_i (Polynomial.C c) * r_el)
        rw [map_one, one_mul]
        rfl
      · rename_i x y ihx ihy
        rw [map_add, map_add, ihx, ihy]
    let e_tens_symm : Q_i ≃+* TensorProduct P k R_i :=
      { β_tens with
        invFun := α_lin
        left_inv := hαβ
        right_inv := hβα }
    obtain ⟨I_idx, _, L_fld, hFld_L, _, Θ_et, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k (TensorProduct P k R_i)).mp inferInstance
    let _ : ∀ c, Field (L_fld c) := hFld_L
    let Φ_prod : Q_i ≃+* ∀ c : I_idx, L_fld c := e_tens_symm.trans Θ_et.toRingEquiv
    let z_bar : ∀ c : I_idx, L_fld c := Φ_prod (mk_i y_i)
    let s_bar : ∀ c : I_idx, L_fld c := fun c => if z_bar c = 0 then 1 else 0
    let w_bar : ∀ c : I_idx, L_fld c := fun c => if z_bar c = 0 then 0 else (z_bar c)⁻¹
    have hzs_zero : z_bar * s_bar = 0 := by
      ext c; dsimp [s_bar]; split_ifs with hc <;> simp [hc]
    have hzw_one : z_bar * w_bar + s_bar = 1 := by
      ext c; dsimp [s_bar, w_bar]
      split_ifs with hc
      · simp [hc]
      · simp [mul_inv_cancel₀ hc]
    obtain ⟨s_i, hs_i⟩ := Ideal.Quotient.mk_surjective (Φ_prod.symm s_bar)
    obtain ⟨w_i, hw_i⟩ := Ideal.Quotient.mk_surjective (Φ_prod.symm w_bar)
    have hys_mem : y_i * s_i ∈ I_ϖ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      apply Φ_prod.injective
      change Φ_prod (mk_i (y_i * s_i)) = Φ_prod 0
      rw [map_zero, map_mul, map_mul, hs_i, Φ_prod.apply_symm_apply]
      exact hzs_zero
    have hyw_mem : y_i * w_i + s_i - 1 ∈ I_ϖ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      apply Φ_prod.injective
      change Φ_prod (mk_i (y_i * w_i + s_i - 1)) = Φ_prod 0
      rw [map_zero, map_sub, map_add, map_mul, map_one, map_sub, map_add, map_mul, map_one,
        hs_i, hw_i, Φ_prod.apply_symm_apply, Φ_prod.apply_symm_apply]
      exact sub_eq_zero.mpr hzw_one
    obtain ⟨q_i, hq_i⟩ := Ideal.mem_span_singleton.mp hys_mem
    obtain ⟨m_i, hm_i⟩ := Ideal.mem_span_singleton.mp hyw_mem
    have hmul_in_q : ι_i y_i * ι_i s_i ∈ q := by
      rw [← map_mul, hq_i, map_mul]
      exact q.mul_mem_right _ hϖ_q
    have hs_not_max : ι_i s_i ∉ IsLocalRing.maximalIdeal R_bar := by
      intro hs_max
      have h1_eq : (1 : R_bar) = ι_i y_i * ι_i w_i + ι_i s_i - ι_i ϖ * ι_i m_i := by
        have hm_map := congrArg ι_i hm_i
        simp only [map_sub, map_add, map_mul, map_one] at hm_map
        linear_combination -hm_map
      have h1_max : (1 : R_bar) ∈ IsLocalRing.maximalIdeal R_bar := by
        rw [h1_eq]
        exact (IsLocalRing.maximalIdeal R_bar).sub_mem
          ((IsLocalRing.maximalIdeal R_bar).add_mem
            ((IsLocalRing.maximalIdeal R_bar).mul_mem_right _ hy_max) hs_max)
          ((IsLocalRing.maximalIdeal R_bar).mul_mem_right _ hϖ_max)
      exact (IsLocalRing.maximalIdeal.isMaximal R_bar).ne_top
        ((Ideal.eq_top_iff_one _).mpr h1_max)
    have hs_not_q : ι_i s_i ∉ q :=
      fun hs_q => hs_not_max (IsLocalRing.le_maximalIdeal hq.ne_top hs_q)
    exact (hq.mem_or_mem hmul_in_q).resolve_right hs_not_q

  have hHens_Rbar : HenselianLocalRing R_bar := by
