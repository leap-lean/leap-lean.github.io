                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.symm.toRingHom)
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_comp]
              change AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom e_P.symm.toRingHom ≫
                    CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) = _
              rw [AlgebraicGeometry.Spec.map_comp]
            rw [← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)), hSpec_alg]
            change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
                ((Spec_P.inv ≫ (j_0 b).inv ≫ γ₀.inv) ≫ U₀.ι) ≫ (W_tilde b).ι = _
            simp only [CategoryTheory.Category.assoc, hγ₀_inv]
          have hrhs_eq :
              (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom
                    (Polynomial.eval₂RingHom ((algebraMap (Polynomial K) L_K).comp Polynomial.C)
                      (IsLocalization.Away.invSelf (S := L_K) X_K))) ≫
                i₁_loc.inv ≫ U₁.ι) ≫ (W_tilde b).ι =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom
                    (Polynomial.eval₂RingHom
                      ((algebraMap (Polynomial (R_b b)) L_R).comp Polynomial.C)
                      (IsLocalization.Away.invSelf (S := L_R) X_R))) ≫
                (j_1 b).inv ≫ (U_chart1 b).ι := by
            have hSpec_ev : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom
                    (Polynomial.eval₂RingHom
                      ((algebraMap (Polynomial (R_b b)) L_R).comp Polynomial.C)
                      (IsLocalization.Away.invSelf (S := L_R) X_R))) =
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom
                    (Polynomial.eval₂RingHom ((algebraMap (Polynomial K) L_K).comp Polynomial.C)
                      (IsLocalization.Away.invSelf (S := L_K) X_K))) ≫
                  Spec_P.inv := by
              change _ = _ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_P.symm.toRingHom)
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_eval,
                CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
            rw [← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc)), hSpec_ev]
            change _ ≫ ((Spec_P.inv ≫ (j_1 b).inv ≫ γ₁.inv) ≫ U₁.ι) ≫ (W_tilde b).ι = _
            simp only [CategoryTheory.Category.assoc, hγ₁_inv]
          rw [hlhs_eq, hrhs_eq, hGlue_R]
        exact hP1Glue T_b U₀ U₁ hU01_top i₀_loc i₁_loc hi₀_loc hi₁_loc hOv₀_loc hOv₁_loc hGlue_loc

      exact ⟨hInt_Qsucc, hiZ_cl, O_succ, e_O,
        Q_n, hProp_Qn, hSm_Qn, hInt_Qn, ι_n, p₀, U_Z,
        Z_tilde, hProp_Ztilde, hSm_Ztilde, hInt_Ztilde,
        π_Z, hProp_πZ, hSurj_πZ, p_Q, hProp_pQ,
        i₀, i_inf, V_plus, s_inf_V, W,
        ⟨he_O, hO_compl⟩,
        ⟨hι_n, hSplit_n⟩,
        ⟨hp₀_hom, hUZ_compl, hIso_πZ_UZ⟩,
        ⟨hi₀_pQ, hi_inf_pQ, hi₀_cl, hVplus_compl, hPb_i₀, hs_inf_V⟩,
        ⟨hW_cov, fun b => (hChartBridges b).2.2⟩,
        hClauseF⟩

  · 
    intro Ω _ _ m c_0 hc_0 Q_amb Q_sm _ _ _ _ ι_amb hι_amb i_sm
      F_amb_Ω I_aff A_aff hSplit_amb hSplit_sm
    obtain ⟨hAffChartCrit_Ω, hQuadChart_Ω⟩ :=
      weil_split_quad_chart_partner_elim_and_irred_cover Ω
    obtain ⟨hW_amb_cov, he_W_amb, -, hW_amb_ov⟩ :=
      hQuadChart_Ω (m + 1) Q_amb ι_amb hι_amb hSplit_amb
    have hInt_Qamb : AlgebraicGeometry.IsIntegral Q_amb.left :=
      hIntOfAlgClosed Ω Q_amb
        ((hAffChartCrit_Ω (2 * (m + 1)) (2 * (m + 1) + 2) (by omega) Q_amb
          (fun b => (TopologicalSpace.Opens.map ι_amb.base).obj
            (weilProjBasicOpen Ω (2 * (m + 1) + 1) b))
          hW_amb_cov he_W_amb).2 (hW_amb_ov (Nat.le_add_left 1 m)))
    obtain ⟨hCov_sm, hCharts_sm, hOv_sm⟩ :=
      weil_quad_cvs_smooth_slice_partner_elim_and_overlaps Ω m c_0 hc_0 Q_amb Q_sm
        ι_amb hι_amb i_sm hSplit_amb hSplit_sm
    have hInt_Qsm : AlgebraicGeometry.IsIntegral Q_sm.left :=
      hIntOfAlgClosed Ω Q_sm
        ((hAffChartCrit_Ω (2 * m + 1) (2 * m + 2) (by omega) Q_sm
          (fun a => (TopologicalSpace.Opens.map (i_sm.left ≫ ι_amb).base).obj
            (weilProjBasicOpen Ω (2 * (m + 1) + 1) a.succ.succ))
          hCov_sm hCharts_sm).2 hOv_sm)
    have hCl_sm : AlgebraicGeometry.IsClosedImmersion i_sm.left := hSplit_sm.1
    let H_aff : (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left.Opens :=
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) Ω) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) Ω)
        (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1)
    let U_sm : Q_amb.left.Opens := (TopologicalSpace.Opens.map ι_amb.base).obj H_aff
    obtain ⟨W_aff, e_H, j_UH, e_Usm, ⟨hAff_W, hCompl_W⟩, hAff_Usm, he_H, hj_UH, he_Usm⟩ :=
      weil_quad_cvs_non_tangent_hyp_complement_iso_aff_quadric Ω m c_0 Q_amb ι_amb hι_amb
        hSplit_amb
    have hCompl_Usm : (U_sm : Set Q_amb.left) = (Set.range i_sm.left.base)ᶜ := by
      obtain ⟨_, hRange_sm, _⟩ := hSplit_sm.2
      rw [hRange_sm, compl_compl]
      rfl
    have hDim_Qamb : topologicalKrullDim Q_amb.left = (((2 * (m + 1) : ℕ) : WithBot ℕ∞)) :=
      weil_smooth_integral_krullDim_over_field Ω (2 * (m + 1)) Q_amb hInt_Qamb
    have hDim_Usm : topologicalKrullDim U_sm.toScheme ≤ (((2 * (m + 1) : ℕ) : WithBot ℕ∞)) := by
      rw [← hDim_Qamb]
      exact topologicalKrullDim_subspace_le Q_amb.left (U_sm : Set Q_amb.left)
    exact ⟨hInt_Qamb, hInt_Qsm, hCl_sm, W_aff, H_aff, e_H, U_sm, j_UH, e_Usm,
      hAff_W, hCompl_W, hCompl_Usm, hAff_Usm, hDim_Usm, he_H, hj_UH, he_Usm⟩

theorem weil_aff_quad_open_stratum_and_partner_elim_rings (Ω : Type u) [Field Ω]
    (c_0 : Ω) (n : ℕ) :
    let I_succ : Ideal (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω) :=
      Ideal.span {((1 - MvPolynomial.C c_0 *
        (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)) *
        MvPolynomial.X (Sum.inl 0) +
        ∑ j : Fin (n + 1),
          (MvPolynomial.X (Sum.inr (j, 0)) : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω) *
            MvPolynomial.X (Sum.inr (j, 1)))}
    let R_succ := MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_succ
    let f_R : Ω →+* R_succ :=
      (Ideal.Quotient.mk I_succ).comp
        (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)
    let u_bar : Fin (n + 1) → R_succ :=
      fun j => Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (j, 0)))
    let u_bar_last : R_succ := u_bar (Fin.last n)
    let B_δ := MvPolynomial (Fin (2 * n + 1)) Ω
    ∃ (θ₀ : Localization.Away (Polynomial.X : Polynomial B_δ) ≃+*
        Localization.Away u_bar_last)
      (Φ₀_u : Polynomial B_δ →+* Localization.Away u_bar_last)
      (Φ_low : ∀ j : Fin n, Polynomial B_δ →+* Localization.Away (u_bar j.castSucc)),
      (∀ p : Polynomial B_δ,
        θ₀ (algebraMap (Polynomial B_δ)
          (Localization.Away (Polynomial.X : Polynomial B_δ)) p) = Φ₀_u p) ∧
      RingHom.Etale Φ₀_u ∧
      (Φ₀_u.comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
        (algebraMap R_succ (Localization.Away u_bar_last)).comp f_R) ∧
      (Φ₀_u Polynomial.X = algebraMap R_succ (Localization.Away u_bar_last) u_bar_last) ∧
      (∀ j : Fin n, RingHom.Etale (Φ_low j)) ∧
      (∀ j : Fin n,
        (Φ_low j).comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
          (algebraMap R_succ (Localization.Away (u_bar j.castSucc))).comp f_R) ∧
      (∀ j : Fin n,
        Φ_low j Polynomial.X =
          algebraMap R_succ (Localization.Away (u_bar j.castSucc)) u_bar_last) :=
by
  intro I_succ R_succ f_R u_bar u_bar_last B_δ
  let e_idx : (Fin 1 ⊕ (Fin n × Fin 2)) ≃ Fin (2 * n + 1) :=
    ((Equiv.refl (Fin 1)).sumCongr finProdFinEquiv).trans
      (finSumFinEquiv.trans (finCongr (by omega)))
  let ρ_mv : MvPolynomial (Fin (2 * n + 1)) Ω ≃+*
      MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω :=
    (MvPolynomial.renameEquiv Ω e_idx.symm).toRingEquiv
  let ρ_poly : Polynomial B_δ ≃+*
      Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) :=
    Polynomial.mapEquiv ρ_mv
  have hρ_X : ρ_poly Polynomial.X = Polynomial.X := by
    simp [ρ_poly]
  have hρ_symm_X : ρ_poly.symm Polynomial.X = Polynomial.X := by
    apply ρ_poly.injective
    simp [hρ_X]
  have hρ_Ω : ∀ c : Ω,
      ρ_poly (Polynomial.C (MvPolynomial.C c)) = Polynomial.C (MvPolynomial.C c) := by
    intro c
    simp only [ρ_poly, Polynomial.mapEquiv_apply, Polynomial.map_C]
    exact congrArg Polynomial.C ((MvPolynomial.renameEquiv Ω e_idx.symm).commutes c)
  have hEt_ρ : RingHom.Etale ρ_poly.toRingHom := RingHom.Etale.of_bijective ρ_poly.bijective

  let mk_R : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω →+* R_succ :=
    Ideal.Quotient.mk I_succ
  let t_bar : R_succ := mk_R (MvPolynomial.X (Sum.inl 0))
  let v_bar : Fin (n + 1) → R_succ :=
    fun k => mk_R (MvPolynomial.X (Sum.inr (k, 1)))
  let v_bar_last : R_succ := v_bar (Fin.last n)
  have hRel : (1 - f_R c_0 * t_bar) * t_bar +
      (∑ m : Fin n, u_bar m.castSucc * v_bar m.castSucc) + u_bar_last * v_bar_last = 0 := by
    have hmk : mk_R
        (((1 - MvPolynomial.C c_0 *
          (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)) *
          MvPolynomial.X (Sum.inl 0) +
          ∑ j : Fin (n + 1),
            (MvPolynomial.X (Sum.inr (j, 0)) :
              MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω) *
              MvPolynomial.X (Sum.inr (j, 1)))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [Fin.sum_univ_castSucc] at hmk
    simpa only [map_add, map_mul, map_sub, map_one, map_sum, RingHom.comp_apply,
      mk_R, f_R, t_bar, u_bar, v_bar, u_bar_last, v_bar_last, add_assoc] using hmk

  
  let ι₀ : R_succ →+* Localization.Away u_bar_last :=
    algebraMap R_succ (Localization.Away u_bar_last)
  let L_δ := Localization.Away (Polynomial.X : Polynomial B_δ)
  let η_δ : Polynomial B_δ →+* L_δ := algebraMap (Polynomial B_δ) L_δ
  let η_base : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) →+* L_δ :=
    η_δ.comp ρ_poly.symm.toRingHom
  have hη_base_X : η_base Polynomial.X = η_δ Polynomial.X := by
    simp [η_base, hρ_symm_X]
  let X_inv : L_δ := IsLocalization.Away.invSelf (Polynomial.X : Polynomial B_δ)
  have hX_mul : η_δ Polynomial.X * X_inv = 1 :=
    IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial B_δ)

  let φ₀_var : Fin 1 ⊕ (Fin n × Fin 2) → Localization.Away u_bar_last :=
    Sum.elim (fun _ => ι₀ t_bar)
      (fun mb => if mb.2 = 0 then ι₀ (u_bar mb.1.castSucc) else ι₀ (v_bar mb.1.castSucc))
  let φ₀_coeff : MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω →+* Localization.Away u_bar_last :=
    MvPolynomial.eval₂Hom (ι₀.comp f_R) φ₀_var
  let Φ₀_base :
      Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) →+* Localization.Away u_bar_last :=
    Polynomial.eval₂RingHom φ₀_coeff (ι₀ u_bar_last)

  have hΦ₀_base_C_Ω : ∀ c : Ω, Φ₀_base (Polynomial.C (MvPolynomial.C c)) = ι₀ (f_R c) := by
    intro c
    simp only [Φ₀_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact MvPolynomial.eval₂Hom_C (ι₀.comp f_R) φ₀_var c
  have hΦ₀_base_inl :
      Φ₀_base (Polynomial.C (MvPolynomial.X (Sum.inl 0))) = ι₀ t_bar := by
    simp only [Φ₀_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact MvPolynomial.eval₂Hom_X' (ι₀.comp f_R) φ₀_var (Sum.inl 0)
  have hΦ₀_base_inr0 : ∀ m : Fin n,
      Φ₀_base (Polynomial.C (MvPolynomial.X (Sum.inr (m, 0)))) = ι₀ (u_bar m.castSucc) := by
    intro m
    simp only [Φ₀_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact MvPolynomial.eval₂Hom_X' (ι₀.comp f_R) φ₀_var (Sum.inr (m, 0))
  have hΦ₀_base_inr1 : ∀ m : Fin n,
      Φ₀_base (Polynomial.C (MvPolynomial.X (Sum.inr (m, 1)))) = ι₀ (v_bar m.castSucc) := by
    intro m
    simp only [Φ₀_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact (MvPolynomial.eval₂Hom_X' (ι₀.comp f_R) φ₀_var (Sum.inr (m, 1))).trans
      (by simp [φ₀_var])
  have hΦ₀_base_X : Φ₀_base Polynomial.X = ι₀ u_bar_last := by
    simp [Φ₀_base]

  let Φ₀_u : Polynomial B_δ →+* Localization.Away u_bar_last := Φ₀_base.comp ρ_poly.toRingHom
  have hΦ₀_X : Φ₀_u Polynomial.X = ι₀ u_bar_last := by
    simp only [Φ₀_u, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      hρ_X, hΦ₀_base_X]
  have hΦ₀_Ω :
      Φ₀_u.comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
        ι₀.comp f_R := by
    refine RingHom.ext fun c => ?_
    simp only [Φ₀_u, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      hρ_Ω, hΦ₀_base_C_Ω]

  have hu₀_unit : IsUnit (Φ₀_u (Polynomial.X : Polynomial B_δ)) := by
    rw [hΦ₀_X]
    exact IsLocalization.Away.algebraMap_isUnit u_bar_last
  let θ₀_fwd : L_δ →+* Localization.Away u_bar_last :=
    IsLocalization.Away.lift (Polynomial.X : Polynomial B_δ) hu₀_unit
  have hθ₀_fwd_eq : ∀ p : Polynomial B_δ,
      θ₀_fwd (algebraMap (Polynomial B_δ) L_δ p) = Φ₀_u p :=
    IsLocalization.Away.lift_eq (Polynomial.X : Polynomial B_δ) hu₀_unit
  have hθ₀_η_base : ∀ q : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω),
      θ₀_fwd (η_base q) = Φ₀_base q := by
    intro q
    change θ₀_fwd (algebraMap (Polynomial B_δ) L_δ (ρ_poly.symm q)) = Φ₀_base q
    rw [hθ₀_fwd_eq]
    simp [Φ₀_u]

  let Q₀ : MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω :=
    (1 - MvPolynomial.C c_0 *
      (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω)) *
      MvPolynomial.X (Sum.inl 0) +
      ∑ m : Fin n,
        (MvPolynomial.X (Sum.inr (m, 0)) : MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) *
          MvPolynomial.X (Sum.inr (m, 1))
  let ψ₀_var : Fin 1 ⊕ (Fin (n + 1) × Fin 2) → L_δ :=
    Sum.elim
      (fun _ => η_base (Polynomial.C (MvPolynomial.X (Sum.inl 0))))
      (fun kb =>
        Fin.lastCases
          (fun b => if b = 0 then η_δ Polynomial.X else -X_inv * η_base (Polynomial.C Q₀))
          (fun m b => η_base (Polynomial.C (MvPolynomial.X (Sum.inr (m, b)))))
          kb.1 kb.2)
  let ψ₀_pre : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω →+* L_δ :=
    MvPolynomial.eval₂Hom ((η_base.comp Polynomial.C).comp MvPolynomial.C) ψ₀_var
  have hψ₀_C : ∀ c : Ω, ψ₀_pre (MvPolynomial.C c) = η_base (Polynomial.C (MvPolynomial.C c)) :=
    fun c => MvPolynomial.eval₂Hom_C _ _ c
  have hψ₀_X_var : ∀ idx : Fin 1 ⊕ (Fin (n + 1) × Fin 2),
      ψ₀_pre (MvPolynomial.X idx) = ψ₀_var idx :=
    fun idx => MvPolynomial.eval₂Hom_X' _ _ idx

  have hψ₀_ker : I_succ ≤ RingHom.ker ψ₀_pre := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
      Fin.sum_univ_castSucc]
    simp only [map_add, map_mul, map_sub, map_one, map_sum, hψ₀_C, hψ₀_X_var,
      ψ₀_var, Sum.elim_inl, Sum.elim_inr, Fin.lastCases_castSucc, Fin.lastCases_last,
      ↓reduceIte, one_ne_zero]
    have hQ₀_map : η_base (Polynomial.C Q₀) =
        (1 - η_base (Polynomial.C (MvPolynomial.C c_0)) *
          η_base (Polynomial.C (MvPolynomial.X (Sum.inl 0)))) *
          η_base (Polynomial.C (MvPolynomial.X (Sum.inl 0))) +
        ∑ x : Fin n,
          η_base (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
            η_base (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1)))) := by
      simp only [Q₀, map_add, map_mul, map_sub, map_one, map_sum]
    set T1 := (1 - η_base (Polynomial.C (MvPolynomial.C c_0)) *
        η_base (Polynomial.C (MvPolynomial.X (Sum.inl 0)))) *
        η_base (Polynomial.C (MvPolynomial.X (Sum.inl 0)))
    set T2 := ∑ x : Fin n,
        η_base (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
          η_base (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1))))
    calc
      T1 + (T2 + η_δ Polynomial.X * (-X_inv * η_base (Polynomial.C Q₀)))
          = (T1 + T2) - (η_δ Polynomial.X * X_inv) * η_base (Polynomial.C Q₀) := by ring
      _ = η_base (Polynomial.C Q₀) - 1 * η_base (Polynomial.C Q₀) := by rw [← hQ₀_map, hX_mul]
      _ = 0 := by ring

  let ψ₀_R : R_succ →+* L_δ := Ideal.Quotient.lift I_succ ψ₀_pre (fun _ hx => hψ₀_ker hx)
  have hψ₀_mk : ∀ x : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω,
      ψ₀_R (Ideal.Quotient.mk I_succ x) = ψ₀_pre x :=
    fun _ => rfl
  have hψ₀_u_last : ψ₀_R u_bar_last = η_δ Polynomial.X := by
    change ψ₀_pre (MvPolynomial.X (Sum.inr (Fin.last n, 0))) = _
    rw [hψ₀_X_var]
    simp [ψ₀_var]
  have hψ₀_unit : IsUnit (ψ₀_R u_bar_last) := by
    rw [hψ₀_u_last]
    exact IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial B_δ)
  let θ₀_inv : Localization.Away u_bar_last →+* L_δ :=
    IsLocalization.Away.lift u_bar_last hψ₀_unit
  have hθ₀_inv_eq : ∀ r : R_succ,
      θ₀_inv (algebraMap R_succ (Localization.Away u_bar_last) r) = ψ₀_R r :=
    IsLocalization.Away.lift_eq u_bar_last hψ₀_unit

  have hθ₀_base_left : θ₀_inv.comp Φ₀_base = η_base := by
    apply Polynomial.ringHom_ext'
    · apply MvPolynomial.ringHom_ext'
      · refine RingHom.ext fun c => ?_
        simp only [RingHom.comp_apply, hΦ₀_base_C_Ω, ι₀, hθ₀_inv_eq, f_R, hψ₀_mk, hψ₀_C]
      · rintro (i | ⟨m, b⟩)
        · fin_cases i
          simp only [Fin.zero_eta, RingHom.comp_apply, hΦ₀_base_inl, ι₀, hθ₀_inv_eq, t_bar, mk_R,
            hψ₀_mk, hψ₀_X_var, ψ₀_var, Sum.elim_inl]
        · fin_cases b
          · simp only [Fin.zero_eta, RingHom.comp_apply, hΦ₀_base_inr0, ι₀, hθ₀_inv_eq,
              u_bar, hψ₀_mk, hψ₀_X_var, ψ₀_var, Sum.elim_inr, Fin.lastCases_castSucc]
          · simp only [Fin.mk_one, RingHom.comp_apply, hΦ₀_base_inr1, ι₀, hθ₀_inv_eq,
              v_bar, mk_R, hψ₀_mk, hψ₀_X_var, ψ₀_var, Sum.elim_inr, Fin.lastCases_castSucc]
    · simp only [RingHom.comp_apply, hΦ₀_base_X, ι₀, hθ₀_inv_eq, hψ₀_u_last, hη_base_X]

  have hθ₀_left : θ₀_inv.comp θ₀_fwd = RingHom.id L_δ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial B_δ))
    refine RingHom.ext fun p => ?_
    simp only [RingHom.comp_apply, RingHom.id_apply, hθ₀_fwd_eq]
    have hp := RingHom.congr_fun hθ₀_base_left (ρ_poly p)
    simpa only [RingHom.comp_apply, Φ₀_u, η_base, RingEquiv.toRingHom_eq_coe,
      RingHom.coe_coe, RingEquiv.symm_apply_apply] using hp

  have hθ₀_right : θ₀_fwd.comp θ₀_inv = RingHom.id (Localization.Away u_bar_last) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers u_bar_last)
    have hcomp_ι : (θ₀_fwd.comp θ₀_inv).comp ι₀ = θ₀_fwd.comp ψ₀_R :=
      RingHom.ext fun r => by simp only [RingHom.comp_apply, ι₀, hθ₀_inv_eq]
    change (θ₀_fwd.comp θ₀_inv).comp ι₀ = (RingHom.id _).comp ι₀
    rw [hcomp_ι, RingHom.id_comp]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext'
    · refine RingHom.ext fun c => ?_
      simp only [RingHom.comp_apply, hψ₀_mk, hψ₀_C, hθ₀_η_base, hΦ₀_base_C_Ω, f_R]
    · rintro (i | ⟨k, b⟩)
      · fin_cases i
        simp only [Fin.zero_eta, RingHom.comp_apply, hψ₀_mk, hψ₀_X_var, ψ₀_var,
          Sum.elim_inl, hθ₀_η_base, hΦ₀_base_inl, t_bar, mk_R]
      · refine Fin.lastCases ?_ ?_ k
        · fin_cases b
          · simp only [Fin.zero_eta, RingHom.comp_apply, hψ₀_mk, hψ₀_X_var, ψ₀_var,
              Sum.elim_inr, Fin.lastCases_last, ↓reduceIte]
            exact (hθ₀_fwd_eq Polynomial.X).trans hΦ₀_X
          · simp only [Fin.mk_one, RingHom.comp_apply, hψ₀_mk, hψ₀_X_var, ψ₀_var,
              Sum.elim_inr, Fin.lastCases_last, one_ne_zero, ↓reduceIte,
              map_mul, map_neg, hθ₀_η_base]
            have hQ₀_eval : Φ₀_base (Polynomial.C Q₀) = -(ι₀ u_bar_last * ι₀ v_bar_last) := by
              have h1 : Φ₀_base (Polynomial.C Q₀) =
                  ι₀ ((1 - f_R c_0 * t_bar) * t_bar +
                    ∑ m : Fin n, u_bar m.castSucc * v_bar m.castSucc) := by
                simp only [Q₀, map_add, map_mul, map_sub, map_one, map_sum,
                  hΦ₀_base_C_Ω, hΦ₀_base_inl, hΦ₀_base_inr0, hΦ₀_base_inr1]
              have h2 : (1 - f_R c_0 * t_bar) * t_bar +
                  (∑ m : Fin n, u_bar m.castSucc * v_bar m.castSucc) =
                  -(u_bar_last * v_bar_last) :=
                eq_neg_of_add_eq_zero_left hRel
              rw [h1, h2, map_neg, map_mul]
            have hX_inv_eval : ι₀ u_bar_last * θ₀_fwd X_inv = 1 := by
              have h := congrArg θ₀_fwd hX_mul
              rw [map_mul, map_one] at h
              have hX0 : θ₀_fwd (η_δ Polynomial.X) = ι₀ u_bar_last :=
                (hθ₀_fwd_eq Polynomial.X).trans hΦ₀_X
              rwa [hX0] at h
            rw [hQ₀_eval]
            calc
              -θ₀_fwd X_inv * -(ι₀ u_bar_last * ι₀ v_bar_last)
                  = (ι₀ u_bar_last * θ₀_fwd X_inv) * ι₀ v_bar_last := by ring
              _ = 1 * ι₀ v_bar_last := by rw [hX_inv_eval]
              _ = ι₀ v_bar_last := one_mul _
        · intro m
          fin_cases b
          · simp only [Fin.zero_eta, RingHom.comp_apply, hψ₀_mk, hψ₀_X_var, ψ₀_var,
              Sum.elim_inr, Fin.lastCases_castSucc, hθ₀_η_base, hΦ₀_base_inr0, u_bar]
          · simp only [Fin.mk_one, RingHom.comp_apply, hψ₀_mk, hψ₀_X_var, ψ₀_var,
              Sum.elim_inr, Fin.lastCases_castSucc, hθ₀_η_base, hΦ₀_base_inr1, v_bar, mk_R]

  let θ₀ : L_δ ≃+* Localization.Away u_bar_last :=
    { θ₀_fwd with
      invFun := θ₀_inv
      left_inv := fun x => RingHom.congr_fun hθ₀_left x
      right_inv := fun y => RingHom.congr_fun hθ₀_right y }
  have hθ₀_comm : ∀ p : Polynomial B_δ,
      θ₀ (algebraMap (Polynomial B_δ) L_δ p) = Φ₀_u p := hθ₀_fwd_eq
  have hEt_Φ₀ : RingHom.Etale Φ₀_u := by
    have hfac : Φ₀_u = θ₀.toRingHom.comp η_δ :=
      RingHom.ext fun p => (hθ₀_comm p).symm
    rw [hfac]
    have hEt_η : RingHom.Etale η_δ :=
      RingHom.etale_algebraMap.mpr
        (Algebra.Etale.of_isLocalizationAway (Polynomial.X : Polynomial B_δ))
    have hEt_θ : RingHom.Etale θ₀.toRingHom := RingHom.Etale.of_bijective θ₀.bijective
    exact RingHom.Etale.stableUnderComposition η_δ θ₀.toRingHom hEt_η hEt_θ

  
  let φ_low_var : ∀ j : Fin n,
      Fin 1 ⊕ (Fin n × Fin 2) → Localization.Away (u_bar j.castSucc) :=
    fun j =>
      let ι_j := algebraMap R_succ (Localization.Away (u_bar j.castSucc))
      Sum.elim (fun _ => ι_j t_bar)
        (fun mb =>
          if mb.2 = 0 then ι_j (u_bar mb.1.castSucc)
          else if mb.1 = j then ι_j v_bar_last
          else ι_j (v_bar mb.1.castSucc))
  let φ_low_coeff : ∀ j : Fin n,
      MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω →+* Localization.Away (u_bar j.castSucc) :=
    fun j =>
      MvPolynomial.eval₂Hom
        ((algebraMap R_succ (Localization.Away (u_bar j.castSucc))).comp f_R)
        (φ_low_var j)
  let Φ_low_base : ∀ j : Fin n,
      Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) →+*
        Localization.Away (u_bar j.castSucc) :=
    fun j =>
      Polynomial.eval₂RingHom (φ_low_coeff j)
        (algebraMap R_succ (Localization.Away (u_bar j.castSucc)) u_bar_last)

  have hΦ_low_C_Ω : ∀ (j : Fin n) (c : Ω),
      Φ_low_base j (Polynomial.C (MvPolynomial.C c)) =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) (f_R c) := by
    intro j c
    simp only [Φ_low_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact MvPolynomial.eval₂Hom_C _ (φ_low_var j) c
  have hΦ_low_inl : ∀ j : Fin n,
      Φ_low_base j (Polynomial.C (MvPolynomial.X (Sum.inl 0))) =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) t_bar := by
    intro j
    simp only [Φ_low_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact MvPolynomial.eval₂Hom_X' _ (φ_low_var j) (Sum.inl 0)
  have hΦ_low_inr0 : ∀ (j m : Fin n),
      Φ_low_base j (Polynomial.C (MvPolynomial.X (Sum.inr (m, 0)))) =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) (u_bar m.castSucc) := by
    intro j m
    simp only [Φ_low_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact MvPolynomial.eval₂Hom_X' _ (φ_low_var j) (Sum.inr (m, 0))
  have hΦ_low_inr1_eq : ∀ j : Fin n,
      Φ_low_base j (Polynomial.C (MvPolynomial.X (Sum.inr (j, 1)))) =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) v_bar_last := by
    intro j
    simp only [Φ_low_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact (MvPolynomial.eval₂Hom_X' _ (φ_low_var j) (Sum.inr (j, 1))).trans
      (by simp [φ_low_var])
  have hΦ_low_inr1_ne : ∀ {j m : Fin n}, m ≠ j →
      Φ_low_base j (Polynomial.C (MvPolynomial.X (Sum.inr (m, 1)))) =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) (v_bar m.castSucc) := by
    intro j m hmj
    simp only [Φ_low_base, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    exact (MvPolynomial.eval₂Hom_X' _ (φ_low_var j) (Sum.inr (m, 1))).trans
      (by simp [φ_low_var, hmj])
  have hΦ_low_base_X : ∀ j : Fin n,
      Φ_low_base j Polynomial.X =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) u_bar_last := by
    intro j
    simp [Φ_low_base]

  let Φ_low : ∀ j : Fin n, Polynomial B_δ →+* Localization.Away (u_bar j.castSucc) :=
    fun j => (Φ_low_base j).comp ρ_poly.toRingHom

  have hΩ_low : ∀ j : Fin n,
      (Φ_low j).comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
        (algebraMap R_succ (Localization.Away (u_bar j.castSucc))).comp f_R := by
    intro j
    refine RingHom.ext fun c => ?_
    simp only [Φ_low, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      hρ_Ω, hΦ_low_C_Ω]

  have hX_low : ∀ j : Fin n,
      Φ_low j Polynomial.X =
        algebraMap R_succ (Localization.Away (u_bar j.castSucc)) u_bar_last := by
    intro j
    simp only [Φ_low, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      hρ_X, hΦ_low_base_X]

  have hEt_low : ∀ j : Fin n, RingHom.Etale (Φ_low j) := by
    intro j
    let ι_j : R_succ →+* Localization.Away (u_bar j.castSucc) :=
      algebraMap R_succ (Localization.Away (u_bar j.castSucc))
    let g_base_j : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) :=
      Polynomial.C (MvPolynomial.X (Sum.inr (j, 0)))
    let L_j := Localization.Away g_base_j
    let η_j : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) →+* L_j :=
      algebraMap (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω)) L_j
    let U_j_inv : L_j := IsLocalization.Away.invSelf g_base_j
    have hU_j_mul : η_j g_base_j * U_j_inv = 1 := IsLocalization.Away.mul_invSelf g_base_j

    have hΦ_j_g : Φ_low_base j g_base_j = ι_j (u_bar j.castSucc) :=
      hΦ_low_inr0 j j
    have hu_j_unit : IsUnit (Φ_low_base j g_base_j) := by
      rw [hΦ_j_g]
      exact IsLocalization.Away.algebraMap_isUnit (u_bar j.castSucc)
    let θ_j_fwd : L_j →+* Localization.Away (u_bar j.castSucc) :=
      IsLocalization.Away.lift g_base_j hu_j_unit
    have hθ_j_fwd_eq : ∀ q : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω),
        θ_j_fwd (algebraMap (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω)) L_j q) =
          Φ_low_base j q :=
      IsLocalization.Away.lift_eq g_base_j hu_j_unit

    let Q_j : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) :=
      Polynomial.C
        ((1 - MvPolynomial.C c_0 *
          (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω)) *
          MvPolynomial.X (Sum.inl 0) +
          ∑ m ∈ Finset.univ.erase j,
            (MvPolynomial.X (Sum.inr (m, 0)) : MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) *
              MvPolynomial.X (Sum.inr (m, 1))) +
        Polynomial.X * Polynomial.C (MvPolynomial.X (Sum.inr (j, 1)))
    let ψ_j_var : Fin 1 ⊕ (Fin (n + 1) × Fin 2) → L_j :=
      Sum.elim
        (fun _ => η_j (Polynomial.C (MvPolynomial.X (Sum.inl 0))))
        (fun kb =>
          Fin.lastCases
            (fun b =>
              if b = 0 then η_j Polynomial.X
              else η_j (Polynomial.C (MvPolynomial.X (Sum.inr (j, 1)))))
            (fun m b =>
              if b = 0 then η_j (Polynomial.C (MvPolynomial.X (Sum.inr (m, 0))))
              else if m = j then -U_j_inv * η_j Q_j
              else η_j (Polynomial.C (MvPolynomial.X (Sum.inr (m, 1)))))
            kb.1 kb.2)
    let ψ_j_pre : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω →+* L_j :=
      MvPolynomial.eval₂Hom ((η_j.comp Polynomial.C).comp MvPolynomial.C) ψ_j_var
    have hψ_j_C : ∀ c : Ω, ψ_j_pre (MvPolynomial.C c) = η_j (Polynomial.C (MvPolynomial.C c)) :=
      fun c => MvPolynomial.eval₂Hom_C _ _ c
    have hψ_j_X_var : ∀ idx : Fin 1 ⊕ (Fin (n + 1) × Fin 2),
        ψ_j_pre (MvPolynomial.X idx) = ψ_j_var idx :=
      fun idx => MvPolynomial.eval₂Hom_X' _ _ idx

    have hψ_j_ker : I_succ ≤ RingHom.ker ψ_j_pre := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        Fin.sum_univ_castSucc, ← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ j)]
      simp only [map_add, map_mul, map_sub, map_one, map_sum, hψ_j_C, hψ_j_X_var,
        ψ_j_var, Sum.elim_inl, Sum.elim_inr, Fin.lastCases_castSucc, Fin.lastCases_last,
        ↓reduceIte, one_ne_zero]
      have herase :
          (∑ x ∈ Finset.univ.erase j,
            η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
              (if x = j then -U_j_inv * η_j Q_j
               else η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1)))))) =
          ∑ x ∈ Finset.univ.erase j,
            η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
              η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1)))) := by
        refine Finset.sum_congr rfl fun x hx => ?_
        simp [Finset.ne_of_mem_erase hx]
      rw [herase]
      have hQj_map : η_j Q_j =
          ((1 - η_j (Polynomial.C (MvPolynomial.C c_0)) *
            η_j (Polynomial.C (MvPolynomial.X (Sum.inl 0)))) *
            η_j (Polynomial.C (MvPolynomial.X (Sum.inl 0))) +
            ∑ x ∈ Finset.univ.erase j,
              η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
                η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1))))) +
          η_j Polynomial.X * η_j (Polynomial.C (MvPolynomial.X (Sum.inr (j, 1)))) := by
        simp only [Q_j, map_add, map_mul, map_sub, map_one, map_sum]
      have hg_eq : η_j (Polynomial.C (MvPolynomial.X (Sum.inr (j, 0)))) = η_j g_base_j := rfl
      rw [hg_eq]
      set T1 := (1 - η_j (Polynomial.C (MvPolynomial.C c_0)) *
          η_j (Polynomial.C (MvPolynomial.X (Sum.inl 0)))) *
          η_j (Polynomial.C (MvPolynomial.X (Sum.inl 0)))
      set T2 := ∑ x ∈ Finset.univ.erase j,
          η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
            η_j (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1))))
      set T3 := η_j Polynomial.X * η_j (Polynomial.C (MvPolynomial.X (Sum.inr (j, 1))))
      calc
        T1 + (η_j g_base_j * (-U_j_inv * η_j Q_j) + T2 + T3)
            = ((T1 + T2) + T3) - (η_j g_base_j * U_j_inv) * η_j Q_j := by ring
        _ = η_j Q_j - 1 * η_j Q_j := by rw [← hQj_map, hU_j_mul]
        _ = 0 := by ring

    let ψ_j_R : R_succ →+* L_j := Ideal.Quotient.lift I_succ ψ_j_pre (fun _ hx => hψ_j_ker hx)
    have hψ_j_mk : ∀ x : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω,
        ψ_j_R (Ideal.Quotient.mk I_succ x) = ψ_j_pre x :=
      fun _ => rfl
    have hψ_j_uj : ψ_j_R (u_bar j.castSucc) = η_j g_base_j := by
      change ψ_j_pre (MvPolynomial.X (Sum.inr (j.castSucc, 0))) = _
      rw [hψ_j_X_var]
      simp [ψ_j_var, Fin.lastCases_castSucc, g_base_j]
    have hψ_j_unit : IsUnit (ψ_j_R (u_bar j.castSucc)) := by
      rw [hψ_j_uj]
      exact IsLocalization.Away.algebraMap_isUnit g_base_j
    let θ_j_inv : Localization.Away (u_bar j.castSucc) →+* L_j :=
      IsLocalization.Away.lift (u_bar j.castSucc) hψ_j_unit
    have hθ_j_inv_eq : ∀ r : R_succ,
        θ_j_inv (algebraMap R_succ (Localization.Away (u_bar j.castSucc)) r) = ψ_j_R r :=
      IsLocalization.Away.lift_eq (u_bar j.castSucc) hψ_j_unit

    have hθ_j_left : θ_j_inv.comp θ_j_fwd = RingHom.id L_j := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_base_j)
      have hcomp_η : (θ_j_inv.comp θ_j_fwd).comp η_j = θ_j_inv.comp (Φ_low_base j) :=
        RingHom.ext fun q => by simp only [RingHom.comp_apply, η_j, hθ_j_fwd_eq]
      change (θ_j_inv.comp θ_j_fwd).comp η_j = (RingHom.id L_j).comp η_j
      rw [hcomp_η, RingHom.id_comp]
      apply Polynomial.ringHom_ext'
      · apply MvPolynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          simp only [RingHom.comp_apply, hΦ_low_C_Ω, hθ_j_inv_eq, f_R, hψ_j_mk, hψ_j_C, η_j]
        · rintro (i | ⟨m, b⟩)
          · fin_cases i
            simp only [Fin.zero_eta, RingHom.comp_apply, hΦ_low_inl, hθ_j_inv_eq,
              t_bar, mk_R, hψ_j_mk, hψ_j_X_var, ψ_j_var, Sum.elim_inl, η_j]
          · fin_cases b
            · simp only [Fin.zero_eta, RingHom.comp_apply, hΦ_low_inr0, hθ_j_inv_eq,
                u_bar, hψ_j_mk, hψ_j_X_var, ψ_j_var, Sum.elim_inr,
                Fin.lastCases_castSucc, ↓reduceIte, η_j]
            · by_cases hmj : m = j
              · subst hmj
                simp only [Fin.mk_one, RingHom.comp_apply, hΦ_low_inr1_eq, hθ_j_inv_eq,
                  v_bar_last, v_bar, mk_R, hψ_j_mk, hψ_j_X_var, ψ_j_var, Sum.elim_inr,
                  Fin.lastCases_last, one_ne_zero, ↓reduceIte, η_j]
              · simp only [Fin.mk_one, RingHom.comp_apply, hΦ_low_inr1_ne hmj, hθ_j_inv_eq,
                  v_bar, mk_R, hψ_j_mk, hψ_j_X_var, ψ_j_var, Sum.elim_inr,
                  Fin.lastCases_castSucc, one_ne_zero, hmj, ↓reduceIte, η_j]
      · simp only [RingHom.comp_apply, hΦ_low_base_X, hθ_j_inv_eq, u_bar_last, u_bar,
          hψ_j_mk, hψ_j_X_var, ψ_j_var, Sum.elim_inr, Fin.lastCases_last, ↓reduceIte, η_j]

    have hθ_j_right : θ_j_fwd.comp θ_j_inv = RingHom.id (Localization.Away (u_bar j.castSucc)) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (u_bar j.castSucc))
      have hcomp_ι : (θ_j_fwd.comp θ_j_inv).comp ι_j = θ_j_fwd.comp ψ_j_R :=
        RingHom.ext fun r => by simp only [RingHom.comp_apply, ι_j, hθ_j_inv_eq]
      change (θ_j_fwd.comp θ_j_inv).comp ι_j = (RingHom.id _).comp ι_j
      rw [hcomp_ι, RingHom.id_comp]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · refine RingHom.ext fun c => ?_
        simp only [RingHom.comp_apply, hψ_j_mk, hψ_j_C, η_j, hθ_j_fwd_eq, hΦ_low_C_Ω, f_R, ι_j]
      · rintro (i | ⟨k, b⟩)
        · fin_cases i
          simp only [Fin.zero_eta, RingHom.comp_apply, hψ_j_mk, hψ_j_X_var, ψ_j_var,
            Sum.elim_inl, η_j, hθ_j_fwd_eq, hΦ_low_inl, t_bar, mk_R, ι_j]
        · refine Fin.lastCases ?_ ?_ k
          · fin_cases b
            · simp only [Fin.zero_eta, RingHom.comp_apply, hψ_j_mk, hψ_j_X_var, ψ_j_var,
                Sum.elim_inr, Fin.lastCases_last, ↓reduceIte, η_j, hθ_j_fwd_eq,
                hΦ_low_base_X, u_bar_last, u_bar, ι_j]
            · simp only [Fin.mk_one, RingHom.comp_apply, hψ_j_mk, hψ_j_X_var, ψ_j_var,
                Sum.elim_inr, Fin.lastCases_last, one_ne_zero, ↓reduceIte, η_j,
                hθ_j_fwd_eq, hΦ_low_inr1_eq, v_bar_last, v_bar, mk_R, ι_j]
          · intro m
            fin_cases b
            · simp only [Fin.zero_eta, RingHom.comp_apply, hψ_j_mk, hψ_j_X_var, ψ_j_var,
                Sum.elim_inr, Fin.lastCases_castSucc, ↓reduceIte, η_j, hθ_j_fwd_eq,
                hΦ_low_inr0, u_bar, ι_j]
            · by_cases hmj : m = j
              · subst hmj
                simp only [Fin.mk_one, RingHom.comp_apply, hψ_j_mk, hψ_j_X_var, ψ_j_var,
                  Sum.elim_inr, Fin.lastCases_castSucc, one_ne_zero, ↓reduceIte,
                  map_mul, map_neg, η_j, hθ_j_fwd_eq]
                have hQj_eval :
                    Φ_low_base m Q_j = -(ι_j (u_bar m.castSucc) * ι_j (v_bar m.castSucc)) := by
                  have h1 : Φ_low_base m Q_j =
                      ι_j (((1 - f_R c_0 * t_bar) * t_bar +
                        ∑ x ∈ Finset.univ.erase m, u_bar x.castSucc * v_bar x.castSucc) +
                        u_bar_last * v_bar_last) := by
                    simp only [Q_j, map_add, map_mul, map_sub, map_one, map_sum,
                      hΦ_low_C_Ω, hΦ_low_inl, hΦ_low_base_X, hΦ_low_inr1_eq, ι_j]
                    have herase_eval :
                        (∑ x ∈ Finset.univ.erase m,
                          (Φ_low_base m) (Polynomial.C (MvPolynomial.X (Sum.inr (x, 0)))) *
                            (Φ_low_base m) (Polynomial.C (MvPolynomial.X (Sum.inr (x, 1))))) =
                        ∑ x ∈ Finset.univ.erase m,
                          (algebraMap R_succ (Localization.Away (u_bar m.castSucc)))
                            (u_bar x.castSucc) *
                            (algebraMap R_succ (Localization.Away (u_bar m.castSucc)))
                              (v_bar x.castSucc) := by
                      refine Finset.sum_congr rfl fun x hx => ?_
                      rw [hΦ_low_inr0, hΦ_low_inr1_ne (Finset.ne_of_mem_erase hx)]
                    rw [herase_eval]
                  have hRel_m : u_bar m.castSucc * v_bar m.castSucc +
                      (((1 - f_R c_0 * t_bar) * t_bar +
                        ∑ x ∈ Finset.univ.erase m, u_bar x.castSucc * v_bar x.castSucc) +
                        u_bar_last * v_bar_last) = 0 := by
                    have hsplit := hRel
                    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ m)] at hsplit
                    linear_combination hsplit
                  have h2 := eq_neg_of_add_eq_zero_right hRel_m
                  rw [h1, h2, map_neg, map_mul]
                have hUj_inv_eval : ι_j (u_bar m.castSucc) * θ_j_fwd U_j_inv = 1 := by
                  have h := congrArg θ_j_fwd hU_j_mul
                  rw [map_mul, map_one] at h
                  have hg0 : θ_j_fwd (η_j g_base_j) = ι_j (u_bar m.castSucc) :=
                    (hθ_j_fwd_eq g_base_j).trans hΦ_j_g
                  rwa [hg0] at h
                rw [hQj_eval]
                calc
                  -θ_j_fwd U_j_inv * -(ι_j (u_bar m.castSucc) * ι_j (v_bar m.castSucc))
                      = (ι_j (u_bar m.castSucc) * θ_j_fwd U_j_inv) * ι_j (v_bar m.castSucc) := by
                          ring
                  _ = 1 * ι_j (v_bar m.castSucc) := by rw [hUj_inv_eval]
                  _ = ι_j (v_bar m.castSucc) := one_mul _
              · simp only [Fin.mk_one, RingHom.comp_apply, hψ_j_mk, hψ_j_X_var, ψ_j_var,
                  Sum.elim_inr, Fin.lastCases_castSucc, one_ne_zero, hmj, ↓reduceIte,
                  η_j, hθ_j_fwd_eq, hΦ_low_inr1_ne hmj, v_bar, mk_R, ι_j]

    let θ_low_j : L_j ≃+* Localization.Away (u_bar j.castSucc) :=
      { θ_j_fwd with
        invFun := θ_j_inv
        left_inv := fun x => RingHom.congr_fun hθ_j_left x
        right_inv := fun y => RingHom.congr_fun hθ_j_right y }
    have hfac_base : Φ_low_base j = θ_low_j.toRingHom.comp η_j :=
      RingHom.ext fun q => (hθ_j_fwd_eq q).symm
    have hEt_η_j : RingHom.Etale η_j :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway g_base_j)
    have hEt_θ_j : RingHom.Etale θ_low_j.toRingHom := RingHom.Etale.of_bijective θ_low_j.bijective
    have hEt_base : RingHom.Etale (Φ_low_base j) := by
      rw [hfac_base]
      exact RingHom.Etale.stableUnderComposition η_j θ_low_j.toRingHom hEt_η_j hEt_θ_j
    exact RingHom.Etale.stableUnderComposition ρ_poly.toRingHom (Φ_low_base j) hEt_ρ hEt_base

  exact ⟨θ₀, Φ₀_u, Φ_low, hθ₀_comm, hEt_Φ₀, hΦ₀_Ω, hΦ₀_X, hEt_low, hΩ_low, hX_low⟩

theorem weil_aff_quad_monic_standard_etale_chart_ring (Ω : Type u) [Field Ω]
    (c_0 : Ω) (hc_0 : c_0 ≠ 0) (n : ℕ) :
    let I_succ : Ideal (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω) :=
      Ideal.span {((1 - MvPolynomial.C c_0 *
        (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)) *
        MvPolynomial.X (Sum.inl 0) +
        ∑ j : Fin (n + 1),
          (MvPolynomial.X (Sum.inr (j, 0)) : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω) *
            MvPolynomial.X (Sum.inr (j, 1)))}
    let R_succ := MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_succ
    let f_R : Ω →+* R_succ :=
      (Ideal.Quotient.mk I_succ).comp
        (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω)
    let t_bar : R_succ := Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inl 0))
    let u_bar_last : R_succ :=
      Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (Fin.last n, 0)))
    let B_δ := MvPolynomial (Fin (2 * n + 1)) Ω
    ∃ Φ₁ : Polynomial B_δ →+* Localization.Away (1 - 2 * f_R c_0 * t_bar),
      RingHom.Etale Φ₁ ∧
      (Φ₁.comp ((Polynomial.C : B_δ →+* Polynomial B_δ).comp (MvPolynomial.C : Ω →+* B_δ)) =
        (algebraMap R_succ (Localization.Away (1 - 2 * f_R c_0 * t_bar))).comp f_R) ∧
      (Φ₁ Polynomial.X =
        algebraMap R_succ (Localization.Away (1 - 2 * f_R c_0 * t_bar)) u_bar_last) :=
by
  intro I_succ R_succ f_R t_bar u_bar_last B_δ
  let P_succ := MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω
  let P_base := MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω
  let u_bar : Fin (n + 1) → R_succ :=
    fun j => Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (j, 0)))
  let v_bar : Fin (n + 1) → R_succ :=
    fun j => Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (j, 1)))
  let v_bar_last : R_succ := v_bar (Fin.last n)
  let g_1 : R_succ := 1 - 2 * f_R c_0 * t_bar
  let A_1 := Localization.Away g_1

  have hRel_succ :
      (1 - f_R c_0 * t_bar) * t_bar +
        (∑ k : Fin n, u_bar k.castSucc * v_bar k.castSucc) +
        u_bar_last * v_bar_last = 0 := by
    have h0 : Ideal.Quotient.mk I_succ
        ((1 - MvPolynomial.C c_0 *
          (MvPolynomial.X (Sum.inl 0) : P_succ)) *
          MvPolynomial.X (Sum.inl 0) +
          ∑ j : Fin (n + 1),
            (MvPolynomial.X (Sum.inr (j, 0)) : P_succ) *
              MvPolynomial.X (Sum.inr (j, 1))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [Fin.sum_univ_castSucc] at h0
    simp only [map_add, map_mul, map_sub, map_one, map_sum, ← add_assoc] at h0
    exact h0

  let e_idx : (Fin 1 ⊕ (Fin n × Fin 2)) ≃ Fin (2 * n + 1) :=
    ((Equiv.refl (Fin 1)).sumCongr finProdFinEquiv).trans
      (finSumFinEquiv.trans (finCongr (by omega)))
  let eq_base : B_δ ≃ₐ[Ω] P_base := MvPolynomial.renameEquiv Ω e_idx.symm
  let R_m := Polynomial P_base
  let ρ_poly : Polynomial B_δ ≃+* R_m := Polynomial.mapEquiv eq_base.toRingEquiv
  have hρ_X : ρ_poly Polynomial.X = Polynomial.X := by
    change Polynomial.map eq_base.toRingEquiv.toRingHom Polynomial.X = Polynomial.X
    exact Polynomial.map_X _
  have hρ_Ω : ∀ c : Ω,
      ρ_poly (Polynomial.C (MvPolynomial.C c)) = Polynomial.C (MvPolynomial.C c) := by
    intro c
    change Polynomial.map eq_base.toRingEquiv.toRingHom (Polynomial.C (MvPolynomial.C c)) =
      Polynomial.C (MvPolynomial.C c)
    rw [Polynomial.map_C]
    exact congrArg Polynomial.C (eq_base.commutes c)
  have hρ_et : RingHom.Etale ρ_poly.toRingHom :=
    RingHom.Etale.of_bijective ρ_poly.bijective

  let ψ1_mv : P_base →+* R_succ :=
    MvPolynomial.eval₂Hom f_R
      (Sum.elim
        (fun _ => v_bar_last)
        (fun jb => Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (jb.1.castSucc, jb.2)))))
  let Ψ_1 : R_m →+* A_1 :=
    Polynomial.eval₂RingHom ((algebraMap R_succ A_1).comp ψ1_mv)
      (algebraMap R_succ A_1 u_bar_last)
  have hΨ1_C : ∀ p : P_base, Ψ_1 (Polynomial.C p) = algebraMap R_succ A_1 (ψ1_mv p) := by
    intro p
    dsimp [Ψ_1]
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.comp_apply]
  have hΨ1_X : Ψ_1 Polynomial.X = algebraMap R_succ A_1 u_bar_last := by
    dsimp [Ψ_1]
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
  have hψ1_C : ∀ c : Ω, ψ1_mv (MvPolynomial.C c) = f_R c :=
    fun c => MvPolynomial.eval₂Hom_C _ _ c
  have hψ1_X_inl : ψ1_mv (MvPolynomial.X (Sum.inl 0)) = v_bar_last :=
    MvPolynomial.eval₂Hom_X' _ _ (Sum.inl 0)
  have hψ1_X_inr : ∀ (j₀ : Fin n) (b : Fin 2),
      ψ1_mv (MvPolynomial.X (Sum.inr (j₀, b))) =
        Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (j₀.castSucc, b))) :=
    fun j₀ b => MvPolynomial.eval₂Hom_X' _ _ (Sum.inr (j₀, b))

  have hEt_Ψ1 : RingHom.Etale Ψ_1 := by
    letI : Algebra R_m A_1 := Ψ_1.toAlgebra
    let Q_m : R_m :=
      Polynomial.C
        (∑ k : Fin n,
          (MvPolynomial.X (Sum.inr (k, 0)) : P_base) *
            MvPolynomial.X (Sum.inr (k, 1))) +
      Polynomial.X * Polynomial.C (MvPolynomial.X (Sum.inl 0) : P_base)
    let c_inv_m : R_m := Polynomial.C (MvPolynomial.C c_0⁻¹)
    let c_val_m : R_m := Polynomial.C (MvPolynomial.C c_0)
    have hc_inv_val : c_inv_m * c_val_m = 1 := by
      dsimp [c_inv_m, c_val_m]
      rw [← Polynomial.C_mul, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc_0,
        MvPolynomial.C_1, Polynomial.C_1]
    let p_lin : Polynomial R_m :=
      Polynomial.C c_inv_m * Polynomial.X + Polynomial.C (c_inv_m * Q_m)
    let f_poly : Polynomial R_m := Polynomial.X ^ 2 - p_lin
    let g_poly : Polynomial R_m := 1 - 2 * Polynomial.C c_val_m * Polynomial.X
    have hf_monic : f_poly.Monic := by
      apply Polynomial.monic_X_pow_sub
      refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ ?_)
      · exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le c_inv_m) (by decide)
      · exact lt_of_le_of_lt Polynomial.degree_C_le (by decide)
    have hderiv : Polynomial.derivative f_poly = 2 * Polynomial.X - Polynomial.C c_inv_m := by
      dsimp [f_poly, p_lin]
      rw [sq, Polynomial.derivative_sub, Polynomial.derivative_mul, Polynomial.derivative_X,
        Polynomial.derivative_add, Polynomial.derivative_C_mul_X, Polynomial.derivative_C]
      ring
    have hBez_et :
        Polynomial.derivative f_poly * (-Polynomial.C c_val_m) + f_poly * 0 = g_poly ^ 1 := by
      rw [hderiv, mul_zero, add_zero, pow_one]
      have hmul : Polynomial.C c_inv_m * Polynomial.C c_val_m = (1 : Polynomial R_m) := by
        rw [← Polynomial.C_mul, hc_inv_val, Polynomial.C_1]
      calc
        (2 * (Polynomial.X : Polynomial R_m) - Polynomial.C c_inv_m) * (-Polynomial.C c_val_m)
            = Polynomial.C c_inv_m * Polynomial.C c_val_m -
                2 * Polynomial.C c_val_m * Polynomial.X := by ring
        _ = 1 - 2 * Polynomial.C c_val_m * Polynomial.X := by rw [hmul]
        _ = g_poly := rfl
    let P_et : StandardEtalePair R_m :=
      StandardEtalePair.mk f_poly hf_monic g_poly ⟨-Polynomial.C c_val_m, 0, 1, hBez_et⟩

    let x_t : A_1 := algebraMap R_succ A_1 t_bar
    have hΨ_Q : Ψ_1 Q_m =
        algebraMap R_succ A_1
          ((∑ k : Fin n, u_bar k.castSucc * v_bar k.castSucc) + u_bar_last * v_bar_last) := by
      dsimp [Q_m]
      rw [map_add, map_mul, hΨ1_C, hΨ1_X, hΨ1_C, hψ1_X_inl]
      simp only [map_sum, map_mul, map_add, hψ1_X_inr]
      rfl
    have hΨ_cinv : Ψ_1 c_inv_m = algebraMap R_succ A_1 (f_R c_0⁻¹) := by
      dsimp [c_inv_m]
      rw [hΨ1_C, hψ1_C]
    have hΨ_cval : Ψ_1 c_val_m = algebraMap R_succ A_1 (f_R c_0) := by
      dsimp [c_val_m]
      rw [hΨ1_C, hψ1_C]
    have hc_R : f_R c_0⁻¹ * f_R c_0 = 1 := by
      rw [← map_mul, inv_mul_cancel₀ hc_0, map_one]
    have h_quad_R :
        t_bar ^ 2 - (f_R c_0⁻¹ * t_bar + f_R c_0⁻¹ *
          ((∑ k : Fin n, u_bar k.castSucc * v_bar k.castSucc) + u_bar_last * v_bar_last)) = 0 := by
      calc
        t_bar ^ 2 - (f_R c_0⁻¹ * t_bar + f_R c_0⁻¹ *
            ((∑ k : Fin n, u_bar k.castSucc * v_bar k.castSucc) + u_bar_last * v_bar_last))
            = (1 - f_R c_0⁻¹ * f_R c_0) * t_bar ^ 2 -
                f_R c_0⁻¹ * ((1 - f_R c_0 * t_bar) * t_bar +
                  (∑ k : Fin n, u_bar k.castSucc * v_bar k.castSucc) +
                  u_bar_last * v_bar_last) := by ring
        _ = (1 - 1) * t_bar ^ 2 - f_R c_0⁻¹ * 0 := by rw [hc_R, hRel_succ]
        _ = 0 := by ring
    have hx_f : Polynomial.aeval x_t P_et.f = 0 := by
      change Polynomial.aeval x_t f_poly = 0
      dsimp [f_poly, p_lin]
      simp only [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
      change x_t ^ 2 - (Ψ_1 c_inv_m * x_t + Ψ_1 (c_inv_m * Q_m)) = 0
      rw [map_mul Ψ_1, hΨ_cinv, hΨ_Q]
      simpa only [map_sub, map_pow, map_add, map_mul, map_zero] using
        congrArg (algebraMap R_succ A_1) h_quad_R
    have hx_g : IsUnit (Polynomial.aeval x_t P_et.g) := by
      change IsUnit (Polynomial.aeval x_t g_poly)
      have hg_eval : Polynomial.aeval x_t g_poly = algebraMap R_succ A_1 g_1 := by
        dsimp [g_poly, g_1, x_t]
        simp only [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_one,
          Polynomial.eval₂_mul, Polynomial.eval₂_ofNat, Polynomial.eval₂_C, Polynomial.eval₂_X]
        change 1 - 2 * Ψ_1 c_val_m * algebraMap R_succ A_1 t_bar =
          algebraMap R_succ A_1 (1 - 2 * f_R c_0 * t_bar)
        rw [hΨ_cval]
        simp only [map_sub, map_mul, map_one, map_ofNat]
      rw [hg_eval]
      exact IsLocalization.Away.algebraMap_isUnit g_1
    have hx_map : P_et.HasMap x_t := ⟨hx_f, hx_g⟩
    let Θ_1 : P_et.Ring →ₐ[R_m] A_1 := P_et.lift x_t hx_map
    have hΘ1_X : Θ_1 P_et.X = x_t := P_et.lift_X x_t hx_map

    let ξ1_var : (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) → P_et.Ring :=
      Sum.elim
        (fun _ => P_et.X)
        (fun jb =>
          Fin.lastCases
            (Fin.cases
              (algebraMap R_m P_et.Ring Polynomial.X)
              (fun _ =>
                algebraMap R_m P_et.Ring
                  (Polynomial.C (MvPolynomial.X (Sum.inl 0) : P_base)))
              jb.2)
            (fun j₀ =>
              algebraMap R_m P_et.Ring
                (Polynomial.C (MvPolynomial.X (Sum.inr (j₀, jb.2)) : P_base)))
            jb.1)
    let ξ1_pre : P_succ →+* P_et.Ring :=
      MvPolynomial.eval₂Hom
        ((algebraMap R_m P_et.Ring).comp
          ((Polynomial.C : P_base →+* R_m).comp (MvPolynomial.C : Ω →+* P_base)))
        ξ1_var
    have hξ1_C : ∀ c : Ω,
        ξ1_pre (MvPolynomial.C c) =
          algebraMap R_m P_et.Ring (Polynomial.C (MvPolynomial.C c)) :=
      fun c => MvPolynomial.eval₂Hom_C _ _ c
    have hξ1_inl : ξ1_pre (MvPolynomial.X (Sum.inl 0)) = P_et.X :=
      MvPolynomial.eval₂Hom_X' _ _ (Sum.inl 0)
    have hξ1_last0 :
        ξ1_pre (MvPolynomial.X (Sum.inr (Fin.last n, 0))) =
          algebraMap R_m P_et.Ring Polynomial.X := by
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [ξ1_var]
      rw [Fin.lastCases_last]
    have hξ1_last1 :
        ξ1_pre (MvPolynomial.X (Sum.inr (Fin.last n, 1))) =
          algebraMap R_m P_et.Ring (Polynomial.C (MvPolynomial.X (Sum.inl 0) : P_base)) := by
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [ξ1_var]
      rw [Fin.lastCases_last]
      rfl
    have hξ1_cast : ∀ (j₀ : Fin n) (b : Fin 2),
        ξ1_pre (MvPolynomial.X (Sum.inr (j₀.castSucc, b))) =
          algebraMap R_m P_et.Ring (Polynomial.C (MvPolynomial.X (Sum.inr (j₀, b)) : P_base)) := by
      intro j₀ b
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [ξ1_var]
      rw [Fin.lastCases_castSucc]
    have hξ1_ker : I_succ ≤ RingHom.ker ξ1_pre := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      rw [Fin.sum_univ_castSucc]
      simp only [map_add, map_mul, map_sub, map_one, map_sum]
      have h_sum :
          (∑ x : Fin n,
            ξ1_pre (MvPolynomial.X (Sum.inr (x.castSucc, 0))) *
              ξ1_pre (MvPolynomial.X (Sum.inr (x.castSucc, 1)))) +
            ξ1_pre (MvPolynomial.X (Sum.inr (Fin.last n, 0))) *
              ξ1_pre (MvPolynomial.X (Sum.inr (Fin.last n, 1))) =
          algebraMap R_m P_et.Ring Q_m := by
        simp only [hξ1_cast, hξ1_last0, hξ1_last1]
        dsimp [Q_m]
        simp only [map_add, map_mul, map_sum]
      rw [hξ1_inl, hξ1_C c_0, h_sum]
      change (1 - algebraMap R_m P_et.Ring c_val_m * P_et.X) * P_et.X +
        algebraMap R_m P_et.Ring Q_m = 0
      have hX_f : Polynomial.aeval P_et.X P_et.f = 0 := P_et.hasMap_X.1
      change Polynomial.aeval P_et.X f_poly = 0 at hX_f
      dsimp [f_poly, p_lin] at hX_f
      simp only [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C,
        map_mul] at hX_f
      have hc_et :
          algebraMap R_m P_et.Ring c_inv_m * algebraMap R_m P_et.Ring c_val_m = 1 := by
        rw [← map_mul, hc_inv_val, map_one]
      calc
        (1 - algebraMap R_m P_et.Ring c_val_m * P_et.X) * P_et.X +
            algebraMap R_m P_et.Ring Q_m
            = -algebraMap R_m P_et.Ring c_val_m *
                (P_et.X ^ 2 - (algebraMap R_m P_et.Ring c_inv_m * P_et.X +
                  algebraMap R_m P_et.Ring c_inv_m * algebraMap R_m P_et.Ring Q_m)) +
              (1 - algebraMap R_m P_et.Ring c_inv_m * algebraMap R_m P_et.Ring c_val_m) *
                (P_et.X + algebraMap R_m P_et.Ring Q_m) := by ring
        _ = -algebraMap R_m P_et.Ring c_val_m * 0 +
              (1 - 1) * (P_et.X + algebraMap R_m P_et.Ring Q_m) := by rw [hX_f, hc_et]
        _ = 0 := by ring

    let ξ1_R : R_succ →+* P_et.Ring :=
      Ideal.Quotient.lift I_succ ξ1_pre (fun _ hx => hξ1_ker hx)
    have hξ1_R_mk : ∀ p : P_succ, ξ1_R (Ideal.Quotient.mk I_succ p) = ξ1_pre p :=
      fun _ => Ideal.Quotient.lift_mk I_succ ξ1_pre _
    have hUnit_ξ1 : IsUnit (ξ1_R g_1) := by
      have hg1_eq : ξ1_R g_1 = Polynomial.aeval P_et.X P_et.g := by
        have hX_g : Polynomial.aeval P_et.X P_et.g =
            1 - 2 * algebraMap R_m P_et.Ring c_val_m * P_et.X := by
          change Polynomial.aeval P_et.X g_poly = _
          dsimp [g_poly]
          simp only [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_one,
            Polynomial.eval₂_mul, Polynomial.eval₂_ofNat, Polynomial.eval₂_C, Polynomial.eval₂_X]
        rw [hX_g]
        dsimp [g_1, f_R, t_bar]
        simp only [map_sub, map_mul, map_one, map_ofNat, hξ1_R_mk, hξ1_C, hξ1_inl]
        rfl
      rw [hg1_eq]
      exact P_et.hasMap_X.2
    let Ξ_1 : A_1 →+* P_et.Ring := IsLocalization.Away.lift g_1 hUnit_ξ1
    have hΞ1_eq : ∀ r : R_succ, Ξ_1 (algebraMap R_succ A_1 r) = ξ1_R r :=
      fun r => IsLocalization.Away.lift_eq g_1 hUnit_ξ1 r

    have hΞ1_comm : Ξ_1.comp Ψ_1 = algebraMap R_m P_et.Ring := by
      apply Polynomial.ringHom_ext'
      · apply MvPolynomial.ringHom_ext'
        · ext c
          change Ξ_1 (Ψ_1 (Polynomial.C (MvPolynomial.C c))) =
            algebraMap R_m P_et.Ring (Polynomial.C (MvPolynomial.C c))
          rw [hΨ1_C, hψ1_C, hΞ1_eq]
          dsimp [f_R]
          rw [hξ1_R_mk, hξ1_C]
        · rintro (i | ⟨j₀, b⟩)
          · rw [Subsingleton.elim i 0]
            change Ξ_1 (Ψ_1 (Polynomial.C (MvPolynomial.X (Sum.inl 0)))) =
              algebraMap R_m P_et.Ring (Polynomial.C (MvPolynomial.X (Sum.inl 0)))
            rw [hΨ1_C, hψ1_X_inl, hΞ1_eq]
            dsimp [v_bar_last, v_bar]
            rw [hξ1_R_mk, hξ1_last1]
          · change Ξ_1 (Ψ_1 (Polynomial.C (MvPolynomial.X (Sum.inr (j₀, b))))) =
              algebraMap R_m P_et.Ring (Polynomial.C (MvPolynomial.X (Sum.inr (j₀, b))))
            rw [hΨ1_C, hψ1_X_inr, hΞ1_eq, hξ1_R_mk, hξ1_cast]
      · change Ξ_1 (Ψ_1 Polynomial.X) = algebraMap R_m P_et.Ring Polynomial.X
        rw [hΨ1_X, hΞ1_eq]
        dsimp [u_bar_last]
        rw [hξ1_R_mk, hξ1_last0]

    let Ξ_1_alg : A_1 →ₐ[R_m] P_et.Ring :=
      { Ξ_1 with commutes' := fun r => RingHom.congr_fun hΞ1_comm r }
    have hΞ1_Θ1 : Ξ_1_alg.comp Θ_1 = AlgHom.id R_m P_et.Ring := by
      rw [StandardEtalePair.hom_ext_iff]
      change Ξ_1 (Θ_1 P_et.X) = P_et.X
      rw [hΘ1_X, hΞ1_eq]
      dsimp [t_bar]
      rw [hξ1_R_mk, hξ1_inl]

    have hΘ1_Ξ1_ring : Θ_1.toRingHom.comp Ξ_1 = RingHom.id A_1 := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_1)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · ext c
        change Θ_1 (Ξ_1 (algebraMap R_succ A_1 (f_R c))) = algebraMap R_succ A_1 (f_R c)
        rw [hΞ1_eq]
        dsimp [f_R]
        rw [hξ1_R_mk, hξ1_C, Θ_1.commutes]
        change Ψ_1 (Polynomial.C (MvPolynomial.C c)) = algebraMap R_succ A_1 (f_R c)
        rw [hΨ1_C, hψ1_C]
      · rintro (i | ⟨j, b⟩)
        · rw [Subsingleton.elim i 0]
          change Θ_1 (Ξ_1 x_t) = x_t
          have hx_eq : Ξ_1 x_t = P_et.X := by
            dsimp [x_t, t_bar]
            rw [hΞ1_eq, hξ1_R_mk, hξ1_inl]
          rw [hx_eq, hΘ1_X]
        · refine Fin.lastCases ?_ ?_ j
          · refine Fin.cases ?_ ?_ b
            · change Θ_1 (Ξ_1 (algebraMap R_succ A_1 u_bar_last)) =
                algebraMap R_succ A_1 u_bar_last
              rw [hΞ1_eq]
              dsimp [u_bar_last]
              rw [hξ1_R_mk, hξ1_last0, Θ_1.commutes]
              exact hΨ1_X
            · intro i₀
              rw [Subsingleton.elim i₀ 0]
              have h1 : Fin.succ (0 : Fin 1) = (1 : Fin 2) := rfl
              rw [h1]
              change Θ_1 (Ξ_1 (algebraMap R_succ A_1 v_bar_last)) =
                algebraMap R_succ A_1 v_bar_last
              rw [hΞ1_eq]
              dsimp [v_bar_last, v_bar]
              rw [hξ1_R_mk, hξ1_last1, Θ_1.commutes]
              change Ψ_1 (Polynomial.C (MvPolynomial.X (Sum.inl 0))) =
                algebraMap R_succ A_1 v_bar_last
              rw [hΨ1_C, hψ1_X_inl]
          · intro j₀
            change Θ_1 (Ξ_1 (algebraMap R_succ A_1
                (Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (j₀.castSucc, b)))))) =
              algebraMap R_succ A_1
                (Ideal.Quotient.mk I_succ (MvPolynomial.X (Sum.inr (j₀.castSucc, b))))
            rw [hΞ1_eq, hξ1_R_mk, hξ1_cast j₀ b, Θ_1.commutes]
            change Ψ_1 (Polynomial.C (MvPolynomial.X (Sum.inr (j₀, b)))) = _
            rw [hΨ1_C, hψ1_X_inr]

    have hΘ1_Ξ1 : Θ_1.comp Ξ_1_alg = AlgHom.id R_m A_1 :=
      AlgHom.ext fun z => RingHom.congr_fun hΘ1_Ξ1_ring z
    let e_alg1 : P_et.Ring ≃ₐ[R_m] A_1 := AlgEquiv.ofAlgHom Θ_1 Ξ_1_alg hΘ1_Ξ1 hΞ1_Θ1
    exact RingHom.etale_algebraMap.mpr (Algebra.Etale.of_equiv e_alg1)

  let Φ₁ : Polynomial B_δ →+* A_1 := Ψ_1.comp ρ_poly.toRingHom
  refine ⟨Φ₁, ?_, ?_, ?_⟩
  · exact RingHom.Etale.stableUnderComposition _ _ hρ_et hEt_Ψ1
  · refine RingHom.ext fun c => ?_
    change Ψ_1 (ρ_poly (Polynomial.C (MvPolynomial.C c))) = algebraMap R_succ A_1 (f_R c)
    rw [hρ_Ω c, hΨ1_C, hψ1_C]
  · change Ψ_1 (ρ_poly Polynomial.X) = algebraMap R_succ A_1 u_bar_last
    rw [hρ_X, hΨ1_X]

theorem weil_aff_quad_purity_chart_atlas_and_strata (Ω : Type u) [Field Ω]
    (c_0 : Ω) (hc_0 : c_0 ≠ 0) :
    let I_k : ∀ k : ℕ, Ideal (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω) := fun k =>
      Ideal.span {((1 - MvPolynomial.C c_0 *
        (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω)) *
        MvPolynomial.X (Sum.inl 0) +
        ∑ j : Fin k,
          (MvPolynomial.X (Sum.inr (j, 0)) : MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω) *
            MvPolynomial.X (Sum.inr (j, 1)))}
    let A_over : ∀ k : ℕ, CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      fun k => CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (I_k k)).comp
          (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω))))
    let A1_Ω : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))
    let Gm_Ω : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial Ω)))
    let j_Gm : Gm_Ω ⟶ A1_Ω :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω))))
    let p_A1 : A1_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))
    (let V_0 := CategoryTheory.Limits.pullback (A_over 0).hom (weilAffineSpaceOver Ω 1).hom
     ∃ (O₀ O₁ : V_0.Opens)
       (e_O0 : O₀.toScheme ≅ (weilAffineSpaceOver Ω 1).left)
       (e_O1 : O₁.toScheme ≅ (weilAffineSpaceOver Ω 1).left),
       O₀ ⊓ O₁ = ⊥ ∧ O₀ ⊔ O₁ = ⊤) ∧
    (∀ n : ℕ,
      let S_δ := weilAffineSpaceOver Ω (2 * n + 1)
      let Y_δ := CategoryTheory.Limits.pullback S_δ.hom p_A1
      let U_δ := CategoryTheory.Limits.pullback j_Gm
        (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
      let j_δ : U_δ ⟶ Y_δ :=
        CategoryTheory.Limits.pullback.snd j_Gm
          (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
      let V_n := CategoryTheory.Limits.pullback (A_over n).hom (weilAffineSpaceOver Ω 1).hom
      (AlgebraicGeometry.LocallyOfFiniteType (A_over n).hom ∧
        AlgebraicGeometry.LocallyOfFiniteType (A_over (n + 1)).hom) ∧
      ∃ (D_n : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine D_n)
        (j_n : D_n ⟶ (A_over (n + 1)).left) (_ : AlgebraicGeometry.IsOpenImmersion j_n)
        (i_n : V_n ⟶ (A_over (n + 1)).left) (_ : AlgebraicGeometry.IsClosedImmersion i_n)
        (y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (A_over (n + 1)).left)
        (e_D : D_n ≅ U_δ)
        (μ_n : D_n ⟶ Gm_Ω)
        (e_Y : Y_δ ≅ (weilAffineSpaceOver Ω (2 * n + 2)).left)
        (W : Fin (n + 2) → (A_over (n + 1)).left.Opens)
        (ϕ : ∀ α : Fin (n + 2), (W α).toScheme ⟶ Y_δ)
        (_ : ∀ α : Fin (n + 2), AlgebraicGeometry.Etale (ϕ α))
        (g : ∀ α : Fin (n + 2), CategoryTheory.Limits.pullback j_n (W α).ι ⟶ U_δ)
        (_ : ∀ α : Fin (n + 2), AlgebraicGeometry.Etale (g α)),
        Set.range i_n.base = (Set.range j_n.base)ᶜ ∧
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          y₀.base pt ∉ Set.range j_n.base) ∧
        e_Y.hom ≫ (weilAffineSpaceOver Ω (2 * n + 2)).hom =
          CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ≫ S_δ.hom ∧
        (∀ α : Fin (n + 2), AlgebraicGeometry.IsAffineOpen (W α)) ∧
        (⨆ α : Fin (n + 2), W α) = ⊤ ∧
        (∀ α : Fin (n + 2),
          ϕ α ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ≫ S_δ.hom =
            (W α).ι ≫ (A_over (n + 1)).hom) ∧
        (∀ α : Fin (n + 2),
          CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.snd j_n (W α).ι) (g α) (ϕ α) j_δ) ∧
        (∀ α : Fin (n + 2),
          g α ≫ CategoryTheory.Limits.pullback.fst j_Gm
              (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1) =
            CategoryTheory.Limits.pullback.fst j_n (W α).ι ≫ μ_n)) :=
by
  intro I_k A_over A1_Ω Gm_Ω j_Gm p_A1
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.IsOpenImmersion :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  haveI : CategoryTheory.MorphismProperty.ContainsIdentities
      (@AlgebraicGeometry.IsOpenImmersion :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toContainsIdentities
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.IsClosedImmersion :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  haveI : CategoryTheory.MorphismProperty.ContainsIdentities
      (@AlgebraicGeometry.IsClosedImmersion :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toContainsIdentities
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  haveI : CategoryTheory.MorphismProperty.ContainsIdentities
      (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toContainsIdentities
  have hZt_Etale : AlgebraicGeometry.IsZariskiLocalAtTarget
      (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtTarget
      (@AlgebraicGeometry.Etale)
      (Q := fun {R S} [CommRing R] [CommRing S] => RingHom.Etale)
  haveI : CategoryTheory.MorphismProperty.RespectsIso
      (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsLocalAtTarget.toRespects _ (self := hZt_Etale)

  
  have hPb_open : ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
      (fst : P ⟶ X) (snd : P ⟶ Y) (f : X ⟶ Z) (g : Y ⟶ Z)
      [AlgebraicGeometry.IsOpenImmersion fst] [AlgebraicGeometry.IsOpenImmersion g],
      fst ≫ f = snd ≫ g →
      Set.range ⇑fst = ⇑f ⁻¹' Set.range ⇑g →
      CategoryTheory.IsPullback fst snd f g := by
    intro P X Y Z fst snd f g _ _ hw hrange
    have hpb₀ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f g)
        (CategoryTheory.Limits.pullback.snd f g) f g :=
      CategoryTheory.IsPullback.of_hasPullback f g
    haveI : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.fst f g) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb₀.flip inferInstance
    have hrange_eq : Set.range ⇑fst = Set.range ⇑(CategoryTheory.Limits.pullback.fst f g) :=
      hrange.trans (AlgebraicGeometry.Scheme.Pullback.range_fst f g).symm
    let e : P ≅ CategoryTheory.Limits.pullback f g :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq fst
        (CategoryTheory.Limits.pullback.fst f g) hrange_eq
    have he_fst : e.hom ≫ CategoryTheory.Limits.pullback.fst f g = fst :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac fst
        (CategoryTheory.Limits.pullback.fst f g) hrange_eq
    haveI : CategoryTheory.Mono g := AlgebraicGeometry.IsOpenImmersion.mono g
    have he_snd : e.hom ≫ CategoryTheory.Limits.pullback.snd f g = snd := by
      apply (cancel_mono g).mp
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, he_fst, hw]
    have he_inv_fst : e.inv ≫ fst = CategoryTheory.Limits.pullback.fst f g := by
      rw [← he_fst, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    have he_inv_snd : e.inv ≫ snd = CategoryTheory.Limits.pullback.snd f g := by
      rw [← he_snd, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    exact hpb₀.of_iso e.symm (CategoryTheory.Iso.refl X) (CategoryTheory.Iso.refl Y)
      (CategoryTheory.Iso.refl Z)
      ((CategoryTheory.Category.comp_id _).trans he_inv_fst.symm)
      ((CategoryTheory.Category.comp_id _).trans he_inv_snd.symm)
      ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
      ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)

  
  have hStrata :
      (let V_0 := CategoryTheory.Limits.pullback (A_over 0).hom (weilAffineSpaceOver Ω 1).hom
       ∃ (O₀ O₁ : V_0.Opens)
         (e_O0 : O₀.toScheme ≅ (weilAffineSpaceOver Ω 1).left)
         (e_O1 : O₁.toScheme ≅ (weilAffineSpaceOver Ω 1).left),
         O₀ ⊓ O₁ = ⊥ ∧ O₀ ⊔ O₁ = ⊤) ∧
      (∀ k : ℕ, AlgebraicGeometry.LocallyOfFiniteType (A_over k).hom) ∧
      (∀ n : ℕ,
        let u_bar_last : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1) :=
          Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inr (Fin.last n, 0)))
        let D_n : AlgebraicGeometry.Scheme.{u} :=
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away u_bar_last))
        let j_n : D_n ⟶ (A_over (n + 1)).left :=
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away u_bar_last)))
        let V_n := CategoryTheory.Limits.pullback (A_over n).hom (weilAffineSpaceOver Ω 1).hom
        AlgebraicGeometry.IsOpenImmersion j_n ∧
        ∃ (i_n : V_n ⟶ (A_over (n + 1)).left) (_ : AlgebraicGeometry.IsClosedImmersion i_n)
          (y₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (A_over (n + 1)).left),
          Set.range i_n.base = (Set.range j_n.base)ᶜ ∧
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
            y₀.base pt ∉ Set.range j_n.base)) := by
    let eq_A1 : MvPolynomial (Fin 1) Ω ≃+* Polynomial Ω :=
      (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).toRingEquiv
    let e_A1 : A1_Ω ≅ (weilAffineSpaceOver Ω 1).left :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.symm.toRingHom)
        hom_inv_id := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.symm.toRingHom) =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)))
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            show eq_A1.toRingHom.comp eq_A1.symm.toRingHom = RingHom.id _ from
              RingHom.ext eq_A1.apply_symm_apply,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.toRingHom) =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) Ω)))
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            show eq_A1.symm.toRingHom.comp eq_A1.toRingHom = RingHom.id _ from
              RingHom.ext eq_A1.symm_apply_apply,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    have he_A1_hom : e_A1.hom ≫ (weilAffineSpaceOver Ω 1).hom = p_A1 := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_A1.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact RingHom.ext fun c => (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).commutes c
    have hPb_Vk : ∀ k : ℕ,
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Polynomial.C :
                (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k) →+*
                  Polynomial (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k))))
          ((AlgebraicGeometry.Spec.map
            (@CommRingCat.ofHom (Polynomial Ω)
              (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k)) _ _
              (Polynomial.mapRingHom
                (algebraMap Ω (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k)))) :
              AlgebraicGeometry.Spec
                (CommRingCat.of
                  (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k))) ⟶
                A1_Ω) ≫
            e_A1.hom)
          (A_over k).hom (weilAffineSpaceOver Ω 1).hom := by
      intro k
      letI : Algebra (Polynomial Ω)
          (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k)) :=
        Polynomial.algebra Ω (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k)
      haveI : IsScalarTower Ω (Polynomial Ω)
          (Polynomial (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k)) :=
        instIsScalarTowerPolynomial Ω Ω (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k)
