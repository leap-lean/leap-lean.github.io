        let T_b : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
          CategoryTheory.Over.mk ((W_tilde b).ι ≫ Z_tilde.hom)
        let U₀ : (W_tilde b).toScheme.Opens :=
          (TopologicalSpace.Opens.map (W_tilde b).ι.base).obj (U_chart0 b)
        let U₁ : (W_tilde b).toScheme.Opens :=
          (TopologicalSpace.Opens.map (W_tilde b).ι.base).obj (U_chart1 b)
