          (@CategoryTheory.IsIso.mono_of_iso _ _ _ _ _ (hbcTor_prime (p' + 2)))

  have hβ₂_mate :
      (adj_η.homEquiv R_Uk
        (weilEtaleHigherDirectImage f'_k q
          (pb_g'.obj (weilEtaleTorsionSheaf X_k.left (ℓ ^ s))))).symm β₂ =
