                MvPolynomial.X (μ.succAbove i) ^ v (μ.succAbove i) := by
          intro c
          rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype]
          · rw [Fin.prod_univ_succAbove _ μ, ← mul_assoc]
