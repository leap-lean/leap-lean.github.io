    let i_s : Fin S_aff.card := e_S.symm ⟨s, hs⟩
    have he_S : (e_S i_s).1 = s := congrArg Subtype.val (e_S.apply_symm_apply ⟨s, hs⟩)
    have hP₀_ne : P₀.eval (algebraMap F k s) ≠ 0 := by
      apply hP₀_eval_ne_of_chart0 (algebraMap F k s)
      intro pt
      have hEq : (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.evalRingHom (algebraMap F k s))) ≫
          j_aff_k ≫ ι_Sigma).base pt =
          (s_pt (Fin.succ i_s) ≫ Φ.inv).base pt := by
        dsimp [s_pt, s_aff_k, ι_Sigma]
        rw [he_S]
      rw [hEq]
      exact hs_pt_in_0 (Fin.succ i_s) pt
    refine ⟨hP₀_ne, ?_⟩
    let p_s : Fin 2 → k :=
      ![P₁.eval (algebraMap F k s) / P₀.eval (algebraMap F k s),
        P₂.eval (algebraMap F k s) / P₀.eval (algebraMap F k s)]
    let q_s : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval p_s))).base
        (default : S_k)
    rw [← hSpecFieldIdeal (MvPolynomial.eval p_s) default]
    change P_disc_0 ≤ q_s.asIdeal
    rw [← hp_Z_disc_0]
    change π_P2.base ((j_chart 0).base q_s) ∈ Set.range ι_disc.left.base
    have halign_s := hDP0_align k (Polynomial.evalRingHom (algebraMap F k s)) hP₀_ne
    rw [hEval2Id (algebraMap F k s)] at halign_s
    have hrh_s : (Polynomial.evalRingHom (algebraMap F k s)).comp
        (Polynomial.mapRingHom (algebraMap F k)) =
        (algebraMap F k).comp (Polynomial.evalRingHom s) := by
      apply Polynomial.ringHom_ext'
      · ext r
        simp
      · simp
    rw [hrh_s, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp] at halign_s
    have hbase_s : π_P2.base ((j_chart 0).base q_s) =
        ι_line.left.base (j_aff.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom s))).base
            (g_Fk.base default))) :=
      (congrArg (fun m : S_k ⟶ (weilProjectiveSpaceOver F 2).left => m.base default)
        halign_s).symm
    rw [hbase_s]
    change j_aff.base _ ∈ ι_line.left.base ⁻¹' (Set.range ι_disc.left.base)
    rw [hLine_disc]
    intro hmem_U0
    rw [hU₀_eq] at hmem_U0
    obtain ⟨p', hp'_all, hp'_eq⟩ := hmem_U0
    have hp'_same := j_aff.isOpenEmbedding.injective hp'_eq
    have hmem_ker : Polynomial.X - Polynomial.C s ∈ p'.asIdeal := by
      rw [hp'_same, hSpecFieldIdeal (Polynomial.evalRingHom s) (g_Fk.base default),
        RingHom.mem_ker]
      simp
    exact hp'_all s hs hmem_ker
  have hP_disc_two_pts : ∃ p₁ p₂ : Fin 2 → k,
      p₁ ≠ p₂ ∧
      P_disc_0 ≤ RingHom.ker (MvPolynomial.eval p₁) ∧
      P_disc_0 ≤ RingHom.ker (MvPolynomial.eval p₂) := by
    have ha_k : algebraMap F k a ∈ S_aff_k := (hS_aff_k _).mpr ⟨a, ha, rfl⟩
    obtain ⟨hP₀_a, hP_disc_a⟩ := hS_aff_in (algebraMap F k a) ha_k
    let p_a : Fin 2 → k :=
      ![P₁.eval (algebraMap F k a) / P₀.eval (algebraMap F k a),
        P₂.eval (algebraMap F k a) / P₀.eval (algebraMap F k a)]
    refine ⟨p_inf, p_a, ?_, hP_disc_inf, hP_disc_a⟩
    intro heq
    have halign_a := hDP0_align k (Polynomial.evalRingHom (algebraMap F k a)) hP₀_a
    rw [hEval2Id (algebraMap F k a)] at halign_a
    have heq' :
        ![(Polynomial.evalRingHom (algebraMap F k a)) P₁ /
            (Polynomial.evalRingHom (algebraMap F k a)) P₀,
          (Polynomial.evalRingHom (algebraMap F k a)) P₂ /
            (Polynomial.evalRingHom (algebraMap F k a)) P₀] = p_inf :=
      heq.symm
    rw [heq'] at halign_a
    have hrh_a : (Polynomial.evalRingHom (algebraMap F k a)).comp
        (Polynomial.mapRingHom (algebraMap F k)) =
        (algebraMap F k).comp (Polynomial.evalRingHom a) := by
      apply Polynomial.ringHom_ext'
      · ext r
        simp
      · simp
    rw [hrh_a, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp] at halign_a
    have h_lhs : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval p_inf)) ≫
        j_chart 0 ≫ π_P2).base (default : S_k) =
        ι_line.left.base (s_inf.base (g_Fk.base default)) := by
      rw [← CategoryTheory.Category.assoc, hp_inf_eq, CategoryTheory.Category.assoc,
        hι_Sigma_π, ← CategoryTheory.Category.assoc, hs_inf_k_fst]
      rfl
    have h_rhs : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval p_inf)) ≫
        j_chart 0 ≫ π_P2).base (default : S_k) =
        ι_line.left.base (j_aff.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))).base
            (g_Fk.base default))) :=
      (congrArg (fun m : S_k ⟶ (weilProjectiveSpaceOver F 2).left => m.base default)
        halign_a).symm
    have hinj := ι_line.left.isClosedEmbedding.injective (h_lhs.symm.trans h_rhs)
    have hnot_aff : s_inf.base (g_Fk.base default) ∈ (Set.range j_aff.base)ᶜ := by
      rw [hs_inf_compl]
      exact ⟨g_Fk.base default, rfl⟩
    exact hnot_aff ⟨_, hinj.symm⟩
  have hS_aff_of : ∀ b : k,
      P₀.eval b ≠ 0 →
      P_disc_0 ≤
        RingHom.ker (MvPolynomial.eval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]) →
      b ∈ S_aff_k := by
    intro b hb_ne hb_le
    let p_b : Fin 2 → k := ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]
    let q_b_pt : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval p_b))).base
        (default : S_k)
    have hq_b_C : (j_chart 0).base q_b_pt ∈ C_disc_k := by
      rw [hp_Z_disc_0, hSpecFieldIdeal (MvPolynomial.eval p_b) default]
      exact hb_le
    let ψ_b : Polynomial F →+* k :=
      (Polynomial.evalRingHom b).comp (Polynomial.mapRingHom (algebraMap F k))
    let q_aff_b : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_b)).base (default : S_k)
    have halign_b := hDP0_align k (Polynomial.evalRingHom b) hb_ne
    rw [hEval2Id b] at halign_b
    have hbase_b : ι_line.left.base (j_aff.base q_aff_b) =
        π_P2.base ((j_chart 0).base q_b_pt) :=
      congrArg (fun m : S_k ⟶ (weilProjectiveSpaceOver F 2).left => m.base default) halign_b
    have hnot_U0 : j_aff.base q_aff_b ∈ (U₀ : Set (weilProjectiveSpaceOver F 1).left)ᶜ := by
      rw [← hLine_disc]
      change ι_line.left.base (j_aff.base q_aff_b) ∈ Set.range ι_disc.left.base
      rw [hbase_b]
      exact hq_b_C
    have hnot_all : ¬ ∀ s ∈ S_aff, Polynomial.X - Polynomial.C s ∉ q_aff_b.asIdeal := by
      intro hall
      apply hnot_U0
      rw [hU₀_eq]
      exact ⟨q_aff_b, hall, rfl⟩
    push Not at hnot_all
    obtain ⟨s, hs, hmem_q⟩ := hnot_all
    rw [hSpecFieldIdeal ψ_b default, RingHom.mem_ker] at hmem_q
    have hbs : b - algebraMap F k s = 0 := by
      simpa [ψ_b] using hmem_q
    exact (hS_aff_k b).mpr ⟨s, hs, (sub_eq_zero.mp hbs).symm⟩
  refine ⟨π_P2, j_chart, P₀, P₁, P₂, P_disc_0, hP_disc_prime, hPb_P2_tw, ?_, ?_, ?_⟩
  · intro c
    exact ⟨(hj_chart_std c).1, (hj_chart_std c).2.1,
      (hj_chart_std c).2.2.1 0, (hj_chart_std c).2.2.2⟩
  · exact ⟨hP₀_monic, hd_pos, hP₁_ne, hP₂_ne, hP₁_deg, hP₂_deg, hP_coprime,
      hRange_θ, hDP0_align, ⟨g_Sigma_0 ≫ π_std_P1, hPb_g0.paste_horiz hPb_Sigma⟩,
      hInter_sub, hSigma_pre_gen⟩
  · exact ⟨hP_disc_ne_bot, hC_pre_gen, hP_disc_two_pts, hP_disc_inf, hKer_inf,
      hS_aff_in, hS_aff_of⟩

theorem weil_p2_ring_odp_radical_and_dualNumber_transv : (∀ (k : Type u) [Field k] (f₀ : MvPolynomial (Fin 2) k),
      Irreducible f₀ →
      ∀ (R : Type u) [CommRing R]
        (φ_B ψ_B : MvPolynomial (Fin 2) k →+* R),
        φ_B.Etale →
        ψ_B.Etale →
        ψ_B.comp MvPolynomial.C = φ_B.comp MvPolynomial.C →
        (∀ u : PrimeSpectrum R, ψ_B (MvPolynomial.X 0) ∈ u.asIdeal ↔ φ_B f₀ ∈ u.asIdeal) →
        ∀ (q₀ : Ideal R) [q₀.IsPrime],
          ∃ (s₀ : R) (_ : s₀ ∉ q₀) (u_unit : (Localization.Away s₀)ˣ),
            algebraMap R (Localization.Away s₀) (ψ_B (MvPolynomial.X 0)) =
              ↑u_unit * algebraMap R (Localization.Away s₀) (φ_B f₀)) ∧
    (∀ (k : Type u) [Field k] (m : ℕ)
      (h₀ f₀ : MvPolynomial (Fin 2) k) (p : Fin 2 → k),
      MvPolynomial.eval p h₀ = 0 →
      MvPolynomial.eval p f₀ = 0 →
      (MvPolynomial.eval p (MvPolynomial.pderiv 0 h₀) ≠ 0 ∨
        MvPolynomial.eval p (MvPolynomial.pderiv 1 h₀) ≠ 0) →
      ∀ (R : Type u) [CommRing R]
        (φ_B : MvPolynomial (Fin 2) k →+* R)
        (ε_R : R →+* k)
        (h u_div : R),
        φ_B.Etale →
        ε_R.comp φ_B = MvPolynomial.eval p →
        h = u_div * φ_B f₀ →
        ∀ (B_Z : CommRingCat.{u})
          (ε_Z : B_Z →+* k)
          (ψ_sm : MvPolynomial (Fin (2 * m + 2)) k →+* B_Z),
          let I_odp : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R) :=
            Ideal.span
              {MvPolynomial.C (φ_B h₀),
                (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                  MvPolynomial.C h}
          let M_odp : CommRingCat.{u} :=
            CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R ⧸ I_odp)
          ∀ (q_mod : M_odp ⟶ B_Z),
            ψ_sm.Etale →
            (ε_Z.comp ψ_sm).comp MvPolynomial.C = RingHom.id k →
            q_mod.hom.Etale →
            (∀ idx : Fin (m + 1) × Fin 2,
              ε_Z (q_mod.hom (Ideal.Quotient.mk I_odp (MvPolynomial.X idx))) = 0) →
            (∀ r : R,
              ε_Z (q_mod.hom (Ideal.Quotient.mk I_odp (MvPolynomial.C r))) = ε_R r) →
            MvPolynomial.eval p (MvPolynomial.pderiv 0 f₀) *
              MvPolynomial.eval p (MvPolynomial.pderiv 1 h₀) -
            MvPolynomial.eval p (MvPolynomial.pderiv 1 f₀) *
              MvPolynomial.eval p (MvPolynomial.pderiv 0 h₀) ≠ 0) ∧
    (∀ (k κ₁ : Type u) [Field k] [Field κ₁] [Algebra k κ₁]
      (f₀ : MvPolynomial (Fin 2) k)
      (ι_slice : MvPolynomial (Fin 2) k →+* Polynomial κ₁)
      (δ_loc : Polynomial κ₁),
      ι_slice.comp MvPolynomial.C = Polynomial.C.comp (algebraMap k κ₁) →
      δ_loc.eval 0 ≠ 0 →
      ι_slice f₀ = (Polynomial.X : Polynomial κ₁) * δ_loc →
      ∀ (R : Type u) [CommRing R]
        (φ_B : MvPolynomial (Fin 2) k →+* R)
        (h : R) (u_unit : Rˣ)
        (R_line : Type u) [CommRing R_line]
        (α_1 : Polynomial κ₁ →+* R_line)
        (α_2 : R →+* R_line)
        (ε_line : R_line →+* κ₁),
        φ_B.Etale →
        h = ↑u_unit * φ_B f₀ →
        α_1.Etale →
        α_1.comp ι_slice = α_2.comp φ_B →
        ε_line.comp α_1 = Polynomial.evalRingHom 0 →
        ∃ g_et : R_line,
          ε_line g_et ≠ 0 ∧
          (Polynomial.eval₂RingHom
            ((algebraMap R_line (Localization.Away g_et)).comp (α_1.comp Polynomial.C))
            (algebraMap R_line (Localization.Away g_et) (α_2 h))).Etale) :=
by
  refine ⟨?_, ?_, ?_⟩
  
  
  
  · have hEtaleDomainRad : ∀ (P : Type u) [CommRing P] (g : P),
        _root_.IsDomain (P ⧸ Ideal.span ({g} : Set P)) →
        ∀ (R : Type u) [CommRing R] (φ : P →+* R),
          φ.Etale → (Ideal.span ({φ g} : Set R)).IsRadical := by
      intro P _ g hDomD R _ φ hφ_et
      let I_P : Ideal P := Ideal.span ({g} : Set P)
      let D := P ⧸ I_P
      letI : _root_.IsDomain D := hDomD
      let I_R : Ideal R := Ideal.span ({φ g} : Set R)
      let A := R ⧸ I_R
      rw [Ideal.isRadical_iff_quotient_reduced]
      letI : Algebra P R := φ.toAlgebra
      haveI : Algebra.Etale P R := RingHom.etale_algebraMap.mp hφ_et
      have h_ker_sub : ∀ x ∈ I_P, ((Ideal.Quotient.mk I_R).comp φ) x = 0 := by
        intro x hx
        rw [Ideal.mem_span_singleton] at hx
        rcases hx with ⟨p, rfl⟩
        rw [RingHom.comp_apply, map_mul, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mul_mem_right _ I_R (Ideal.mem_span_singleton_self (φ g))
      let φ_bar : D →+* A := Ideal.Quotient.lift I_P ((Ideal.Quotient.mk I_R).comp φ) h_ker_sub
      letI : Algebra D A := φ_bar.toAlgebra
      haveI : IsScalarTower P D A := ⟨fun p d a =>
        Submodule.Quotient.induction_on I_P d fun q =>
          Submodule.Quotient.induction_on I_R a fun r => by
            change φ_bar (p • Ideal.Quotient.mk I_P q) * Ideal.Quotient.mk I_R r =
              p • (φ_bar (Ideal.Quotient.mk I_P q) * Ideal.Quotient.mk I_R r)
            have hpq : p • (Ideal.Quotient.mk I_P q : D) = Ideal.Quotient.mk I_P (p * q) := by
              rw [Algebra.smul_def]
              exact (map_mul (Ideal.Quotient.mk I_P) p q).symm
            rw [hpq]
            change Ideal.Quotient.mk I_R (φ (p * q)) * Ideal.Quotient.mk I_R r =
              p • (Ideal.Quotient.mk I_R (φ q) * Ideal.Quotient.mk I_R r)
            rw [Algebra.smul_def]
            change Ideal.Quotient.mk I_R (φ (p * q)) * Ideal.Quotient.mk I_R r =
              Ideal.Quotient.mk I_R (φ p) * (Ideal.Quotient.mk I_R (φ q) * Ideal.Quotient.mk I_R r)
            rw [map_mul, map_mul, mul_assoc]⟩
      let f_fwd : TensorProduct P D R →ₐ[D] A :=
        Algebra.TensorProduct.lift (Algebra.ofId D A) (IsScalarTower.toAlgHom P R A)
          (fun _ _ => _root_.Commute.all _ _)
      have h_inv_ker : ∀ x ∈ I_R,
          (Algebra.TensorProduct.includeRight (R := P) (A := D) (B := R)).toRingHom x = 0 := by
        intro x hx
        rw [Ideal.mem_span_singleton] at hx
        rcases hx with ⟨r, rfl⟩
        change (1 : D) ⊗ₜ[P] (φ g * r) = 0
        have hsmul : φ g * r = g • r := rfl
        rw [hsmul, ← TensorProduct.smul_tmul]
        have hg0 : g • (1 : D) = 0 := by
          change Ideal.Quotient.mk I_P g * 1 = 0
          rw [mul_one, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self g
        rw [hg0, TensorProduct.zero_tmul]
      let f_inv : A →+* TensorProduct P D R :=
        Ideal.Quotient.lift I_R
          (Algebra.TensorProduct.includeRight (R := P) (A := D) (B := R)).toRingHom h_inv_ker
      have h_left : ∀ z : TensorProduct P D R, f_inv (f_fwd z) = z := by
        intro z
        refine TensorProduct.inductionOn z
          (fun d r => ?_) (fun x y ihx ihy => by rw [map_add, map_add, ihx, ihy])
        refine Submodule.Quotient.induction_on I_P d fun p => ?_
        have hd_eq : (Ideal.Quotient.mk I_P p : D) ⊗ₜ[P] r = (1 : D) ⊗ₜ[P] (φ p * r) := by
          have hp_smul : (Ideal.Quotient.mk I_P p : D) = p • (1 : D) := by
            change _ = Ideal.Quotient.mk I_P p * 1
            rw [mul_one]
          rw [hp_smul, TensorProduct.smul_tmul]
          rfl
        change f_inv (f_fwd ((Ideal.Quotient.mk I_P p : D) ⊗ₜ[P] r)) =
          (Ideal.Quotient.mk I_P p : D) ⊗ₜ[P] r
        rw [hd_eq]
        have hfwd_1 : f_fwd ((1 : D) ⊗ₜ[P] (φ p * r)) = Ideal.Quotient.mk I_R (φ p * r) := by
          dsimp [f_fwd]
          rw [map_one, one_mul]
          rfl
        rw [hfwd_1]
        rfl
      have h_right : ∀ a : A, f_fwd (f_inv a) = a :=
        fun a => Submodule.Quotient.induction_on I_R a fun r => by
          change f_fwd ((1 : D) ⊗ₜ[P] r) = Ideal.Quotient.mk I_R r
          dsimp [f_fwd]
          rw [map_one, one_mul]
          rfl
      let e_ring : TensorProduct P D R ≃+* A :=
        { toFun := f_fwd
          invFun := f_inv
          left_inv := h_left
          right_inv := h_right
          map_mul' := map_mul f_fwd
          map_add' := map_add f_fwd }
      let e_quot : TensorProduct P D R ≃ₐ[D] A :=
        AlgEquiv.ofRingEquiv (f := e_ring) (fun d => by
          change f_fwd (d ⊗ₜ[P] (1 : R)) = algebraMap D A d
          dsimp [f_fwd]
          rw [map_one, mul_one])
      haveI : Algebra.Etale D (TensorProduct P D R) := Algebra.Etale.baseChange P R D
      haveI : Algebra.Etale D A := Algebra.Etale.of_equiv e_quot
      let K := FractionRing D
      haveI : Algebra.Etale K (TensorProduct D K A) := Algebra.Etale.baseChange D A K
      obtain ⟨ι, _, B, _, _, e_prod, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K (TensorProduct D K A)).mp inferInstance
      haveI : _root_.IsReduced (TensorProduct D K A) :=
        _root_.isReduced_of_injective e_prod.toRingHom e_prod.injective
      have h_rtens_inj : Function.Injective (LinearMap.rTensor A (Algebra.linearMap D K)) :=
        Module.Flat.rTensor_preserves_injective_linearMap (M := A) (Algebra.linearMap D K)
          (IsFractionRing.injective D K)
      have h_inc_inj : Function.Injective
          (Algebra.TensorProduct.includeRight (R := D) (A := K) (B := A)).toRingHom := by
        intro a₁ a₂ h
        have h1 : LinearMap.rTensor A (Algebra.linearMap D K) ((1 : D) ⊗ₜ[D] a₁) =
            LinearMap.rTensor A (Algebra.linearMap D K) ((1 : D) ⊗ₜ[D] a₂) := by
          simpa using h
        have h2 := h_rtens_inj h1
        simpa using congrArg (TensorProduct.lid D A) h2
      exact _root_.isReduced_of_injective
        (Algebra.TensorProduct.includeRight (R := D) (A := K) (B := A)).toRingHom h_inc_inj
    intro k _ f₀ hf₀_irr R _ φ_B ψ_B hφ_et hψ_et _hC hZero q₀ hq₀_prime
    let P₂ := MvPolynomial (Fin 2) k
    have hp_f₀ : _root_.Prime f₀ := _root_.irreducible_iff_prime.mp hf₀_irr
    haveI : (Ideal.span ({f₀} : Set P₂)).IsPrime :=
      (Ideal.span_singleton_prime hf₀_irr.ne_zero).mpr hp_f₀
    have hDom_f₀ : _root_.IsDomain (P₂ ⧸ Ideal.span ({f₀} : Set P₂)) := Ideal.Quotient.isDomain _
    have hDom_X0 : _root_.IsDomain (P₂ ⧸ Ideal.span ({MvPolynomial.X 0} : Set P₂)) := by
      let I_X0 : Ideal P₂ := Ideal.span ({MvPolynomial.X 0} : Set P₂)
      let ev₁ : P₂ →+* Polynomial k := MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
      have h_ev₁_X0 : ev₁ (MvPolynomial.X 0) = 0 := by
        dsimp [ev₁]
        rw [MvPolynomial.eval₂Hom_X']
        rfl
      have h_ev₁_X1 : ev₁ (MvPolynomial.X 1) = Polynomial.X := by
        dsimp [ev₁]
        rw [MvPolynomial.eval₂Hom_X']
        rfl
      have h_ker_X0 : ∀ x ∈ I_X0, ev₁ x = 0 := by
        intro x hx
        rw [Ideal.mem_span_singleton] at hx
        rcases hx with ⟨q, rfl⟩
        rw [map_mul, h_ev₁_X0, zero_mul]
      let α_q : (P₂ ⧸ I_X0) →+* Polynomial k := Ideal.Quotient.lift I_X0 ev₁ h_ker_X0
      let β_q : Polynomial k →+* (P₂ ⧸ I_X0) :=
        (Ideal.Quotient.mk I_X0).comp (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1))
