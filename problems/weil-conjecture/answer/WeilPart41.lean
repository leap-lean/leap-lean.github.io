            { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
              ![P₀, P₁, P₂] c ∉ p.asIdeal } ∧
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.eval₂Hom
                ((algebraMap (Polynomial k) (Localization.Away (![P₀, P₁, P₂] c))).comp
                  Polynomial.C)
                (fun j : Fin 2 =>
                  algebraMap (Polynomial k) (Localization.Away (![P₀, P₁, P₂] c))
                    (![P₀, P₁, P₂] (c.succAbove j)) *
                  IsLocalization.Away.invSelf (![P₀, P₁, P₂] c)))) ≫
            j_chart c =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (algebraMap (Polynomial k) (Localization.Away (![P₀, P₁, P₂] c)))) ≫
            f_aff) ∧
        (∀ (Ω : Type u) [Field Ω] (χ_poly : Polynomial k →+* Ω),
          χ_poly P₀ ≠ 0 →
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_poly) ≫ f_aff =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.eval₂Hom (χ_poly.comp Polynomial.C)
                ![χ_poly P₁ / χ_poly P₀, χ_poly P₂ / χ_poly P₀])) ≫
            j_chart 0)) := by
    have hSpecFieldIdeal : ∀ {R E : Type u} [CommRing R] [Field E] (φ : R →+* E)
        (pt : AlgebraicGeometry.Spec (CommRingCat.of E)),
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base pt).asIdeal = RingHom.ker φ := by
      intro R E _ _ φ pt
      change Ideal.comap φ pt.asIdeal = RingHom.ker φ
      have hbot : pt.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
      rw [hbot]
      rfl
    have hLiftChart : ∀ {R : Type u} [CommRing R] (c : Fin 3) (φ_k : k →+* R)
        (g : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ P2_sch),
        g ≫ p_P2 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_k) →
        Set.range g.base ⊆ Set.range (j_chart c).base →
        ∃ ψ : MvPolynomial (Fin 2) k →+* R,
          ψ.comp MvPolynomial.C = φ_k ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ j_chart c = g := by
      intro R _ c φ_k g hg_hom hg_sub
      let m := AlgebraicGeometry.IsOpenImmersion.lift (j_chart c) g hg_sub
      have hm_fac : m ≫ j_chart c = g :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (j_chart c) g hg_sub
      let ψ_cat := AlgebraicGeometry.Spec.preimage m
      have hm_eq : AlgebraicGeometry.Spec.map ψ_cat = m :=
        AlgebraicGeometry.Spec.map_preimage m
      let ψ : MvPolynomial (Fin 2) k →+* R := ψ_cat.hom
      have hψ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = m := hm_eq
      have hcomp_spec :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp MvPolynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_k) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hψ_map,
          ← hj_chart_hom c, ← CategoryTheory.Category.assoc, hm_fac, hg_hom]
      have hcomp_cat := AlgebraicGeometry.Spec.map_injective hcomp_spec
      exact ⟨ψ, congrArg CommRingCat.Hom.hom hcomp_cat, by rw [hψ_map, hm_fac]⟩
    constructor
    · intro f_line hf_hom hs0_all
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      let pt₀ : S_k := default
      let ev0 : Polynomial k →+* k := Polynomial.evalRingHom (0 : k)
      let q₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0)).base pt₀
      have hq₀_ideal : q₀.asIdeal = RingHom.ker ev0 := hSpecFieldIdeal ev0 pt₀
      let U₀ : Set (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        f_line.base ⁻¹' Set.range (j_chart 0).base
      have hU₀_open : IsOpen U₀ :=
        (j_chart 0).isOpenEmbedding.isOpen_range.preimage f_line.continuous
      have hq₀_in_U₀ : q₀ ∈ U₀ := hs0_all 0 pt₀
      obtain ⟨_, ⟨R_inf0_raw, rfl⟩, hq₀_mem_R, hR_sub_U₀⟩ :=
        (TopologicalSpace.IsTopologicalBasis.mem_nhds_iff
          PrimeSpectrum.isTopologicalBasis_basic_opens).mp (hU₀_open.mem_nhds hq₀_in_U₀)
      let R_inf0 : Polynomial k := R_inf0_raw
      have hR_ev0 : R_inf0.eval 0 ≠ 0 := by
        change R_inf0 ∉ q₀.asIdeal at hq₀_mem_R
        rwa [hq₀_ideal, RingHom.mem_ker] at hq₀_mem_R
      have hR_ne : R_inf0 ≠ 0 := fun h0 => hR_ev0 (by rw [h0, Polynomial.eval_zero])
      have hGen_in_0 : ∀ pt_K : AlgebraicGeometry.Spec (CommRingCat.of (RatFunc k)),
          (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial k) (RatFunc k))) ≫
            f_line).base pt_K ∈ Set.range (j_chart 0).base := by
        intro pt_K
        apply hR_sub_U₀
        change R_inf0 ∉ ((AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial k) (RatFunc k)))).base pt_K).asIdeal
        rw [hSpecFieldIdeal (algebraMap (Polynomial k) (RatFunc k)) pt_K, RingHom.mem_ker]
        exact hAlg_ne hR_ne
      let R_loc := Localization.Away R_inf0
      let ι_R : AlgebraicGeometry.Spec (CommRingCat.of R_loc) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) R_loc))
      have hιR_range : Set.range (ι_R ≫ f_line).base ⊆ Set.range (j_chart 0).base := by
        rintro _ ⟨z, rfl⟩
        apply hR_sub_U₀
        have hz_range : ι_R.base z ∈
            Set.range (PrimeSpectrum.comap (algebraMap (Polynomial k) R_loc)) := ⟨z, rfl⟩
        rwa [PrimeSpectrum.localization_away_comap_range R_loc R_inf0] at hz_range
      have hιR_hom : (ι_R ≫ f_line) ≫ p_P2 =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap (Polynomial k) R_loc).comp Polynomial.C)) := by
        rw [CategoryTheory.Category.assoc, hf_hom, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      obtain ⟨ψ₀, hψ₀_C, hψ₀_fac⟩ := hLiftChart 0 _ (ι_R ≫ f_line) hιR_hom hιR_range
      let sec₀ := IsLocalization.Away.sec R_inf0 (ψ₀ (MvPolynomial.X 0))
      let sec₁ := IsLocalization.Away.sec R_inf0 (ψ₀ (MvPolynomial.X 1))
      let N₁ : Polynomial k := sec₀.1
      let m₁ : ℕ := sec₀.2
      let N₂ : Polynomial k := sec₁.1
      let m₂ : ℕ := sec₁.2
      have hsec₀ : ψ₀ (MvPolynomial.X 0) * algebraMap (Polynomial k) R_loc (R_inf0 ^ m₁) =
          algebraMap (Polynomial k) R_loc N₁ := IsLocalization.Away.sec_spec R_inf0 _
      have hsec₁ : ψ₀ (MvPolynomial.X 1) * algebraMap (Polynomial k) R_loc (R_inf0 ^ m₂) =
          algebraMap (Polynomial k) R_loc N₂ := IsLocalization.Away.sec_spec R_inf0 _
      have hev0_units : ∀ y : Submonoid.powers R_inf0, IsUnit (ev0 y) := by
        rintro ⟨_, n, rfl⟩
        dsimp
        rw [map_pow]
        exact (pow_ne_zero n hR_ev0).isUnit
      let ev0_loc : R_loc →+* k := IsLocalization.lift hev0_units
      have hev0_eq : ∀ p : Polynomial k, ev0_loc (algebraMap (Polynomial k) R_loc p) = ev0 p :=
        fun p => IsLocalization.lift_eq hev0_units p
      have hev0_comp : ev0_loc.comp (algebraMap (Polynomial k) R_loc) = ev0 :=
        RingHom.ext hev0_eq
      let μ₁ : k := ev0_loc (ψ₀ (MvPolynomial.X 0))
      let μ₂ : k := ev0_loc (ψ₀ (MvPolynomial.X 1))
      have hN₁_ev : N₁.eval 0 = μ₁ * (R_inf0.eval 0) ^ m₁ := by
        have h := congrArg ev0_loc hsec₀
        rw [map_mul, hev0_eq, hev0_eq, map_pow] at h
        exact h.symm
      have hN₂_ev : N₂.eval 0 = μ₂ * (R_inf0.eval 0) ^ m₂ := by
        have h := congrArg ev0_loc hsec₁
        rw [map_mul, hev0_eq, hev0_eq, map_pow] at h
        exact h.symm
      have hev0_ψ₀ : ev0_loc.comp ψ₀ = MvPolynomial.eval ![μ₁, μ₂] := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval_C]
          have hC := congrArg (fun f : k →+* R_loc => f a) hψ₀_C
          dsimp at hC
          rw [hC, hev0_eq]
          simp [ev0]
        · intro j
          fin_cases j <;> simp [μ₁, μ₂]
      have hEval_inf0 :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂])) ≫
            j_chart 0 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0) ≫ f_line := by
        rw [← hev0_ψ₀, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, hψ₀_fac, ← CategoryTheory.Category.assoc]
        dsimp [ι_R]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hev0_comp]
      have hμ₁_ne : μ₁ ≠ 0 := by
        have hpt : (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂]))).base pt₀ ∈
            (j_chart 0).base ⁻¹' Set.range (j_chart 1).base := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂])) ≫
            j_chart 0).base pt₀ ∈ Set.range (j_chart 1).base
          rw [hEval_inf0]
          exact hs0_all 1 pt₀
        rw [hj_chart_pre 0 1] at hpt
        change (MvPolynomial.aeval (Fin.succAboveCases (0 : Fin 3) 1 MvPolynomial.X))
          (MvPolynomial.X 1) ∉
          ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂]))).base pt₀).asIdeal at hpt
        rw [hSpecFieldIdeal (MvPolynomial.eval ![μ₁, μ₂]) pt₀, RingHom.mem_ker,
          MvPolynomial.aeval_X] at hpt
        change MvPolynomial.eval ![μ₁, μ₂] (MvPolynomial.X 0) ≠ 0 at hpt
        rwa [MvPolynomial.eval_X] at hpt
      have hμ₂_ne : μ₂ ≠ 0 := by
        have hpt : (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂]))).base pt₀ ∈
            (j_chart 0).base ⁻¹' Set.range (j_chart 2).base := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂])) ≫
            j_chart 0).base pt₀ ∈ Set.range (j_chart 2).base
          rw [hEval_inf0]
          exact hs0_all 2 pt₀
        rw [hj_chart_pre 0 2] at hpt
        change (MvPolynomial.aeval (Fin.succAboveCases (0 : Fin 3) 1 MvPolynomial.X))
          (MvPolynomial.X 2) ∉
          ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.eval ![μ₁, μ₂]))).base pt₀).asIdeal at hpt
        rw [hSpecFieldIdeal (MvPolynomial.eval ![μ₁, μ₂]) pt₀, RingHom.mem_ker,
          MvPolynomial.aeval_X] at hpt
        change MvPolynomial.eval ![μ₁, μ₂] (MvPolynomial.X 1) ≠ 0 at hpt
        rwa [MvPolynomial.eval_X] at hpt
      let rat_loc : R_loc →+* RatFunc k := IsLocalization.Away.lift R_inf0 (hAlg_ne hR_ne).isUnit
      have hrat_eq : ∀ p : Polynomial k,
          rat_loc (algebraMap (Polynomial k) R_loc p) = algebraMap (Polynomial k) (RatFunc k) p :=
        fun p => IsLocalization.Away.lift_eq R_inf0 (hAlg_ne hR_ne).isUnit p
      have hrat_comp : rat_loc.comp (algebraMap (Polynomial k) R_loc) =
          algebraMap (Polynomial k) (RatFunc k) :=
        RingHom.ext hrat_eq
      have hrat_ψ₀ : rat_loc.comp ψ₀ =
          (MvPolynomial.aeval
            ![algebraMap (Polynomial k) (RatFunc k) N₁ /
                (algebraMap (Polynomial k) (RatFunc k) R_inf0) ^ m₁,
              algebraMap (Polynomial k) (RatFunc k) N₂ /
                (algebraMap (Polynomial k) (RatFunc k) R_inf0) ^ m₂]).toRingHom := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, MvPolynomial.aeval_C]
          have hC := congrArg (fun f : k →+* R_loc => f a) hψ₀_C
          dsimp at hC
          rw [hC, hrat_eq]
          exact (IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k) a).symm
        · intro j
          fin_cases j
          · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
              RingHom.coe_coe, MvPolynomial.aeval_X]
            have h := congrArg rat_loc hsec₀
            rw [map_mul, hrat_eq, hrat_eq, map_pow] at h
            exact (eq_div_iff (pow_ne_zero m₁ (hAlg_ne hR_ne))).mpr h
          · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
              RingHom.coe_coe, MvPolynomial.aeval_X]
            have h := congrArg rat_loc hsec₁
            rw [map_mul, hrat_eq, hrat_eq, map_pow] at h
            exact (eq_div_iff (pow_ne_zero m₂ (hAlg_ne hR_ne))).mpr h
      have hGen_inf0 :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.aeval
                ![algebraMap (Polynomial k) (RatFunc k) N₁ /
                    (algebraMap (Polynomial k) (RatFunc k) R_inf0) ^ m₁,
                  algebraMap (Polynomial k) (RatFunc k) N₂ /
                    (algebraMap (Polynomial k) (RatFunc k) R_inf0) ^ m₂]).toRingHom) ≫
            j_chart 0 =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial k) (RatFunc k))) ≫
            f_line := by
        rw [← hrat_ψ₀, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, hψ₀_fac, ← CategoryTheory.Category.assoc]
        dsimp [ι_R]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hrat_comp]
      exact ⟨hGen_in_0, R_inf0, N₁, N₂, m₁, m₂, μ₁, μ₂, hR_ev0, hμ₁_ne, hμ₂_ne,
        hN₁_ev, hN₂_ev, hEval_inf0, hGen_inf0⟩
    · intro f_aff P₀ P₁ P₂ hf_hom hP₀_ne hP₁_ne hP₂_ne hcop hGen_0
      let P_vec : Fin 3 → Polynomial k := ![P₀, P₁, P₂]
      have hP_vec_ne : ∀ i : Fin 3, P_vec i ≠ 0 := by
        intro i
        fin_cases i
        · exact hP₀_ne
        · exact hP₁_ne
        · exact hP₂_ne
      let θ_c : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] RatFunc k := fun c =>
        MvPolynomial.aeval (fun j : Fin 2 =>
          algebraMap (Polynomial k) (RatFunc k) (P_vec (c.succAbove j)) /
          algebraMap (Polynomial k) (RatFunc k) (P_vec c))
      have hGen_c : ∀ c : Fin 3,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_c c).toRingHom) ≫ j_chart c =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) (RatFunc k))) ≫
            f_aff := by
        intro c
        let ψ := (θ_c 0).toRingHom
        let hom_ψ : Fin 3 → RatFunc k := ![1, ψ (MvPolynomial.X 0), ψ (MvPolynomial.X 1)]
        have hhom_eq : ∀ i : Fin 3,
            hom_ψ i = algebraMap (Polynomial k) (RatFunc k) (P_vec i) /
              algebraMap (Polynomial k) (RatFunc k) (P_vec 0) := by
          intro i
          fin_cases i
          · dsimp [hom_ψ, P_vec]
            exact (div_self (hAlg_ne hP₀_ne)).symm
          · simp [hom_ψ, ψ, θ_c, P_vec]
          · simp [hom_ψ, ψ, θ_c, P_vec]
        have hhom_ne : hom_ψ c ≠ 0 := by
          rw [hhom_eq c]
          exact div_ne_zero (hAlg_ne (hP_vec_ne c)) (hAlg_ne (hP_vec_ne 0))
        have htrans := hj_chart_trans c (RatFunc k) ψ hhom_ne
        have heval_eq : MvPolynomial.eval₂Hom (ψ.comp MvPolynomial.C)
            (fun j : Fin 2 => hom_ψ (c.succAbove j) / hom_ψ c) = (θ_c c).toRingHom := by
          apply MvPolynomial.ringHom_ext'
          · ext a
            simp [ψ, θ_c]
          · intro j
            simp only [MvPolynomial.eval₂Hom_X', AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              θ_c, MvPolynomial.aeval_X, hhom_eq]
            exact div_div_div_cancel_right₀ (hAlg_ne (hP_vec_ne 0)) _ _
        rw [← heval_eq, htrans, ← hGen_0]
      have hClosedPt : ∀ p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)),
          p.asIdeal ≠ ⊥ → ∃ b : k, p.asIdeal = RingHom.ker (Polynomial.evalRingHom b) := by
        intro p hp_ne
        obtain ⟨f₀, hf₀_mem, hf₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp_ne
        have hex_lin : ∀ n : ℕ, ∀ f : Polynomial k,
            f.natDegree = n → f ∈ p.asIdeal → f ≠ 0 →
            ∃ b : k, Polynomial.X - Polynomial.C b ∈ p.asIdeal := by
          intro n
          induction n using Nat.strong_induction_on with
          | h n ih =>
            intro f hdeg hf_mem hf_ne
            by_cases hn0 : f.degree = 0
            · exfalso
              have hc_eq : f = Polynomial.C (f.coeff 0) := Polynomial.eq_C_of_degree_eq_zero hn0
              have hc_ne : f.coeff 0 ≠ 0 := fun h0 => hf_ne (by rw [hc_eq, h0, map_zero])
              have hunit : IsUnit f := by
                rw [hc_eq]
                exact (Ne.isUnit hc_ne).map Polynomial.C
              exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hf_mem hunit)
            · obtain ⟨b, hb_root⟩ := IsAlgClosed.exists_root f hn0
              obtain ⟨g, hg_eq⟩ := Polynomial.dvd_iff_isRoot.mpr hb_root
              rw [hg_eq] at hf_mem
              rcases p.isPrime.mem_or_mem hf_mem with hlin | hg_mem
              · exact ⟨b, hlin⟩
              · have hg_ne : g ≠ 0 := fun h0 => hf_ne (by rw [hg_eq, h0, mul_zero])
                have hlt : g.natDegree < n := by
                  rw [← hdeg, hg_eq,
                    Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero b) hg_ne,
                    Polynomial.natDegree_X_sub_C]
                  omega
                exact ih g.natDegree hlt g rfl hg_mem hg_ne
        obtain ⟨b, hb_mem⟩ := hex_lin f₀.natDegree f₀ rfl hf₀_mem hf₀_ne
        refine ⟨b, ?_⟩
        ext h
        rw [RingHom.mem_ker]
        change h ∈ p.asIdeal ↔ h.eval b = 0
        have hdvd : Polynomial.X - Polynomial.C b ∣ h - Polynomial.C (h.eval b) := by
          rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def, Polynomial.eval_sub,
            Polynomial.eval_C, sub_self]
        obtain ⟨q, hq⟩ := hdvd
        have hsub_mem : h - Polynomial.C (h.eval b) ∈ p.asIdeal := by
          rw [hq]
          exact p.asIdeal.mul_mem_right q hb_mem
        constructor
        · intro hh
          by_contra hne
          have hC_mem : Polynomial.C (h.eval b) ∈ p.asIdeal := by
            have := p.asIdeal.sub_mem hh hsub_mem
            simpa using this
          exact p.isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem p.asIdeal hC_mem ((Ne.isUnit hne).map Polynomial.C))
        · intro hev
          rw [hev, map_zero, sub_zero] at hsub_mem
          exact hsub_mem
      have hPoint_in_Wc : ∀ (c : Fin 3) (b : k)
          (p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))),
          p.asIdeal = RingHom.ker (Polynomial.evalRingHom b) →
          p ∈ f_aff.base ⁻¹' Set.range (j_chart c).base →
          (P_vec c).eval b ≠ 0 ∧
          ∃ q_b : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)),
            q_b.asIdeal = RingHom.ker (MvPolynomial.eval
              (fun j : Fin 2 => (P_vec (c.succAbove j)).eval b / (P_vec c).eval b)) ∧
            (j_chart c).base q_b = f_aff.base p := by
        intro c b p hp_ker hp_mem
        have hWc_open : IsOpen (f_aff.base ⁻¹' Set.range (j_chart c).base) :=
          (j_chart c).isOpenEmbedding.isOpen_range.preimage f_aff.continuous
        obtain ⟨_, ⟨Q_raw, rfl⟩, hp_Q, hQ_sub⟩ :=
          (TopologicalSpace.IsTopologicalBasis.mem_nhds_iff
            PrimeSpectrum.isTopologicalBasis_basic_opens).mp (hWc_open.mem_nhds hp_mem)
        let Q : Polynomial k := Q_raw
        have hQ_ev : Q.eval b ≠ 0 := by
          change Q ∉ p.asIdeal at hp_Q
          rwa [hp_ker, RingHom.mem_ker] at hp_Q
        have hQ_ne : Q ≠ 0 := fun h0 => hQ_ev (by rw [h0, Polynomial.eval_zero])
        let R_Q := Localization.Away Q
        let ι_Q : AlgebraicGeometry.Spec (CommRingCat.of R_Q) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) R_Q))
        have hιQ_range : Set.range (ι_Q ≫ f_aff).base ⊆ Set.range (j_chart c).base := by
          rintro _ ⟨z, rfl⟩
          apply hQ_sub
          have hz : ι_Q.base z ∈ Set.range (PrimeSpectrum.comap (algebraMap (Polynomial k) R_Q)) :=
            ⟨z, rfl⟩
          rwa [PrimeSpectrum.localization_away_comap_range R_Q Q] at hz
        have hιQ_hom : (ι_Q ≫ f_aff) ≫ p_P2 =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap (Polynomial k) R_Q).comp Polynomial.C)) := by
          rw [CategoryTheory.Category.assoc, hf_hom, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp]
        obtain ⟨ψ_Q, hψQ_C, hψQ_fac⟩ := hLiftChart c _ (ι_Q ≫ f_aff) hιQ_hom hιQ_range
        let rat_Q : R_Q →+* RatFunc k := IsLocalization.Away.lift Q (hAlg_ne hQ_ne).isUnit
        have hratQ_eq : ∀ r : Polynomial k,
            rat_Q (algebraMap (Polynomial k) R_Q r) = algebraMap (Polynomial k) (RatFunc k) r :=
          fun r => IsLocalization.Away.lift_eq Q (hAlg_ne hQ_ne).isUnit r
        have hratQ_comp : rat_Q.comp (algebraMap (Polynomial k) R_Q) =
            algebraMap (Polynomial k) (RatFunc k) :=
          RingHom.ext hratQ_eq
        have hratQ_ψ : rat_Q.comp ψ_Q = (θ_c c).toRingHom := by
          have hspec :
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (rat_Q.comp ψ_Q)) ≫ j_chart c =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_c c).toRingHom) ≫ j_chart c := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc, hψQ_fac, ← CategoryTheory.Category.assoc]
            dsimp [ι_Q]
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hratQ_comp,
              ← hGen_c c]
            rfl
          have hm := (cancel_mono (j_chart c)).mp hspec
          exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hm)
        have hcross_j : ∀ j : Fin 2,
            ∃ (N_j : Polynomial k) (m_j : ℕ),
              ψ_Q (MvPolynomial.X j) * algebraMap (Polynomial k) R_Q (Q ^ m_j) =
                algebraMap (Polynomial k) R_Q N_j ∧
              N_j * P_vec c = Q ^ m_j * P_vec (c.succAbove j) := by
          intro j
          let s_j := IsLocalization.Away.sec Q (ψ_Q (MvPolynomial.X j))
          have hs_j : ψ_Q (MvPolynomial.X j) * algebraMap (Polynomial k) R_Q (Q ^ s_j.2) =
              algebraMap (Polynomial k) R_Q s_j.1 := IsLocalization.Away.sec_spec Q _
          have hrat_j : rat_Q (ψ_Q (MvPolynomial.X j)) =
              algebraMap (Polynomial k) (RatFunc k) (P_vec (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (P_vec c) := by
            have := congrArg (fun f : MvPolynomial (Fin 2) k →+* RatFunc k => f (MvPolynomial.X j))
              hratQ_ψ
            simpa [θ_c] using this
          have hrat_sec := congrArg rat_Q hs_j
          rw [map_mul, hratQ_eq, hratQ_eq, map_pow, hrat_j] at hrat_sec
          have hdiv : algebraMap (Polynomial k) (RatFunc k) s_j.1 /
              algebraMap (Polynomial k) (RatFunc k) (Q ^ s_j.2) =
              algebraMap (Polynomial k) (RatFunc k) (P_vec (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (P_vec c) := by
            rw [map_pow, div_eq_iff (pow_ne_zero s_j.2 (hAlg_ne hQ_ne))]
            exact hrat_sec.symm
          have hmul_rat : algebraMap (Polynomial k) (RatFunc k) (s_j.1 * P_vec c) =
              algebraMap (Polynomial k) (RatFunc k) (Q ^ s_j.2 * P_vec (c.succAbove j)) := by
            rw [map_mul, map_mul, mul_comm _ (algebraMap _ _ (P_vec (c.succAbove j)))]
            exact (div_eq_div_iff (hAlg_ne (pow_ne_zero s_j.2 hQ_ne))
              (hAlg_ne (hP_vec_ne c))).mp hdiv
          exact ⟨s_j.1, s_j.2, hs_j, hAlg_inj hmul_rat⟩
        have hPc_ev : (P_vec c).eval b ≠ 0 := by
          intro hPc0
          have hex_i : ∃ i : Fin 3, (P_vec i).eval b ≠ 0 := by
            by_cases h0 : P₀.eval b = 0
            · rcases hcop b h0 with h1 | h2
              · exact ⟨1, h1⟩
              · exact ⟨2, h2⟩
            · exact ⟨0, h0⟩
          obtain ⟨i, hi_ne⟩ := hex_i
          have hic : i ≠ c := fun heq => hi_ne (heq ▸ hPc0)
          obtain ⟨j, hj_eq⟩ := Fin.exists_succAbove_eq hic
          obtain ⟨N_j, m_j, -, hpoly_eq⟩ := hcross_j j
          rw [hj_eq] at hpoly_eq
          have hev := congrArg (Polynomial.eval b) hpoly_eq
          rw [Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_pow, hPc0, mul_zero] at hev
          exact mul_ne_zero (pow_ne_zero m_j hQ_ev) hi_ne hev.symm
        have hevb_units : ∀ y : Submonoid.powers Q, IsUnit ((Polynomial.evalRingHom b) y) := by
          rintro ⟨_, n, rfl⟩
          dsimp
          rw [Polynomial.eval_pow]
          exact (pow_ne_zero n hQ_ev).isUnit
        let evb_Q : R_Q →+* k := IsLocalization.lift hevb_units
        have hevb_eq : ∀ r : Polynomial k,
            evb_Q (algebraMap (Polynomial k) R_Q r) = (Polynomial.evalRingHom b) r :=
          fun r => IsLocalization.lift_eq hevb_units r
        have hevb_comp : evb_Q.comp (algebraMap (Polynomial k) R_Q) = Polynomial.evalRingHom b :=
          RingHom.ext hevb_eq
        have hevb_ψ : evb_Q.comp ψ_Q =
            MvPolynomial.eval (fun j : Fin 2 =>
              (P_vec (c.succAbove j)).eval b / (P_vec c).eval b) := by
          apply MvPolynomial.ringHom_ext'
          · ext a
            simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval_C]
            have hC := congrArg (fun f : k →+* R_Q => f a) hψQ_C
            dsimp at hC
            rw [hC, hevb_eq]
            simp
          · intro j
            obtain ⟨N_j, m_j, hs_j, hpoly_eq⟩ := hcross_j j
            simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval_X]
            have h1 := congrArg evb_Q hs_j
            rw [map_mul, hevb_eq, hevb_eq, map_pow] at h1
            have h2 := congrArg (Polynomial.eval b) hpoly_eq
            rw [Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_pow] at h2
            change evb_Q (ψ_Q (MvPolynomial.X j)) * (Q.eval b) ^ m_j = N_j.eval b at h1
            rw [← h1] at h2
            apply mul_right_cancel₀ (pow_ne_zero m_j hQ_ev)
            apply mul_right_cancel₀ hPc_ev
            calc
              evb_Q (ψ_Q (MvPolynomial.X j)) * (Q.eval b) ^ m_j * (P_vec c).eval b
                = (Q.eval b) ^ m_j * (P_vec (c.succAbove j)).eval b := h2
              _ = ((P_vec (c.succAbove j)).eval b / (P_vec c).eval b * (P_vec c).eval b) *
                    (Q.eval b) ^ m_j := by
                  rw [div_mul_cancel₀ _ hPc_ev, mul_comm]
              _ = (P_vec (c.succAbove j)).eval b / (P_vec c).eval b * (Q.eval b) ^ m_j *
                    (P_vec c).eval b := by ring
        let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k) := default
        let q_b := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval
          (fun j : Fin 2 => (P_vec (c.succAbove j)).eval b / (P_vec c).eval b)))).base pt₀
        have hqb_ideal : q_b.asIdeal = RingHom.ker (MvPolynomial.eval
            (fun j : Fin 2 => (P_vec (c.succAbove j)).eval b / (P_vec c).eval b)) :=
          hSpecFieldIdeal _ pt₀
        have hp_eq_pt : (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.evalRingHom b))).base pt₀ = p := by
          apply PrimeSpectrum.ext
          rw [hSpecFieldIdeal (Polynomial.evalRingHom b) pt₀, hp_ker]
        have hcomm_b :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.eval
              (fun j : Fin 2 => (P_vec (c.succAbove j)).eval b / (P_vec c).eval b))) ≫
              j_chart c =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom b)) ≫ f_aff := by
          rw [← hevb_ψ, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc, hψQ_fac, ← CategoryTheory.Category.assoc]
          dsimp [ι_Q]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hevb_comp]
        have hbase_eq := congrArg
          (fun m : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P2_sch => m.base pt₀) hcomm_b
        change (j_chart c).base q_b =
          f_aff.base ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.evalRingHom b))).base pt₀) at hbase_eq
        rw [hp_eq_pt] at hbase_eq
        exact ⟨hPc_ev, q_b, hqb_ideal, hbase_eq⟩
      have hCharts_all : ∀ c : Fin 3,
          f_aff.base ⁻¹' Set.range (j_chart c).base =
            { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
              P_vec c ∉ p.asIdeal } ∧
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.eval₂Hom
                ((algebraMap (Polynomial k) (Localization.Away (P_vec c))).comp Polynomial.C)
                (fun j : Fin 2 =>
                  algebraMap (Polynomial k) (Localization.Away (P_vec c))
                    (P_vec (c.succAbove j)) *
                  IsLocalization.Away.invSelf (P_vec c)))) ≫
            j_chart c =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away (P_vec c)))) ≫
            f_aff := by
        intro c
        have hWc_eq : f_aff.base ⁻¹' Set.range (j_chart c).base =
            { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
              P_vec c ∉ p.asIdeal } := by
          ext p
          change f_aff.base p ∈ Set.range (j_chart c).base ↔ P_vec c ∉ p.asIdeal
          by_cases hp_bot : p.asIdeal = ⊥
          · have hp_gen : p = (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial k) (RatFunc k)))).base default := by
              apply PrimeSpectrum.ext
              rw [hp_bot, hSpecFieldIdeal (algebraMap (Polynomial k) (RatFunc k)) default]
              ext r
              simp only [Submodule.mem_bot, RingHom.mem_ker]
              exact ⟨fun hr => hr ▸ map_zero _, fun hr => hAlg_inj (hr.trans (map_zero _).symm)⟩
            constructor
            · intro _
              rw [hp_bot, Submodule.mem_bot]
              exact hP_vec_ne c
            · intro _
              rw [hp_gen]
              change (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial k) (RatFunc k))) ≫ f_aff).base default ∈
                Set.range (j_chart c).base
              rw [← hGen_c c]
              exact ⟨_, rfl⟩
          · obtain ⟨b, hb_ker⟩ := hClosedPt p hp_bot
            constructor
            · intro hp_in
              obtain ⟨hPc_ev, -⟩ := hPoint_in_Wc c b p hb_ker hp_in
              rwa [hb_ker, RingHom.mem_ker]
            · intro hp_not_mem
              have hPc_ev : (P_vec c).eval b ≠ 0 := by
                rwa [hb_ker, RingHom.mem_ker] at hp_not_mem
              have hcov_pt : f_aff.base p ∈ ⋃ c' : Fin 3, Set.range (j_chart c').base := by
                rw [hj_chart_cov]
                exact Set.mem_univ _
              obtain ⟨c', hc'_mem⟩ := Set.mem_iUnion.mp hcov_pt
              obtain ⟨hPc'_ev, q_b, hqb_ideal, hqb_eq⟩ := hPoint_in_Wc c' b p hb_ker hc'_mem
              rw [← hqb_eq]
              change q_b ∈ (j_chart c').base ⁻¹' Set.range (j_chart c).base
              rw [hj_chart_pre c' c]
              change (MvPolynomial.aeval (Fin.succAboveCases c' 1 MvPolynomial.X))
                (MvPolynomial.X c) ∉ q_b.asIdeal
              rw [hqb_ideal, RingHom.mem_ker, MvPolynomial.aeval_X]
              fin_cases c' <;> fin_cases c <;> dsimp only at hPc_ev hPc'_ev ⊢
              · change MvPolynomial.eval _ (1 : MvPolynomial (Fin 2) k) ≠ 0
                rw [map_one]; exact one_ne_zero
              · change MvPolynomial.eval _ (MvPolynomial.X 0) ≠ 0
                rw [MvPolynomial.eval_X]; exact div_ne_zero hPc_ev hPc'_ev
              · change MvPolynomial.eval _ (MvPolynomial.X 1) ≠ 0
                rw [MvPolynomial.eval_X]; exact div_ne_zero hPc_ev hPc'_ev
              · change MvPolynomial.eval _ (MvPolynomial.X 0) ≠ 0
                rw [MvPolynomial.eval_X]; exact div_ne_zero hPc_ev hPc'_ev
              · change MvPolynomial.eval _ (1 : MvPolynomial (Fin 2) k) ≠ 0
                rw [map_one]; exact one_ne_zero
              · change MvPolynomial.eval _ (MvPolynomial.X 1) ≠ 0
                rw [MvPolynomial.eval_X]; exact div_ne_zero hPc_ev hPc'_ev
              · change MvPolynomial.eval _ (MvPolynomial.X 0) ≠ 0
                rw [MvPolynomial.eval_X]; exact div_ne_zero hPc_ev hPc'_ev
              · change MvPolynomial.eval _ (MvPolynomial.X 1) ≠ 0
                rw [MvPolynomial.eval_X]; exact div_ne_zero hPc_ev hPc'_ev
              · change MvPolynomial.eval _ (1 : MvPolynomial (Fin 2) k) ≠ 0
                rw [map_one]; exact one_ne_zero
        refine ⟨hWc_eq, ?_⟩
        let R_c := Localization.Away (P_vec c)
        let ι_c : AlgebraicGeometry.Spec (CommRingCat.of R_c) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) R_c))
        have hιc_range : Set.range (ι_c ≫ f_aff).base ⊆ Set.range (j_chart c).base := by
          rintro _ ⟨z, rfl⟩
          change ι_c.base z ∈ f_aff.base ⁻¹' Set.range (j_chart c).base
          rw [hWc_eq]
          have hz : ι_c.base z ∈ Set.range (PrimeSpectrum.comap (algebraMap (Polynomial k) R_c)) :=
            ⟨z, rfl⟩
          rwa [PrimeSpectrum.localization_away_comap_range R_c (P_vec c)] at hz
        have hιc_hom : (ι_c ≫ f_aff) ≫ p_P2 =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap (Polynomial k) R_c).comp Polynomial.C)) := by
          rw [CategoryTheory.Category.assoc, hf_hom, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp]
        obtain ⟨Φ_c, hΦc_C, hΦc_fac⟩ := hLiftChart c _ (ι_c ≫ f_aff) hιc_hom hιc_range
        let rat_c : R_c →+* RatFunc k :=
          IsLocalization.Away.lift (P_vec c) (hAlg_ne (hP_vec_ne c)).isUnit
        have hratc_eq : ∀ r : Polynomial k,
            rat_c (algebraMap (Polynomial k) R_c r) = algebraMap (Polynomial k) (RatFunc k) r :=
          fun r => IsLocalization.Away.lift_eq (P_vec c) (hAlg_ne (hP_vec_ne c)).isUnit r
        have hratc_inj : Function.Injective rat_c := hLocInj (P_vec c) (hP_vec_ne c)
        have hratc_comp : rat_c.comp (algebraMap (Polynomial k) R_c) =
            algebraMap (Polynomial k) (RatFunc k) :=
          RingHom.ext hratc_eq
        have hratc_Φ : rat_c.comp Φ_c = (θ_c c).toRingHom := by
          have hspec :
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (rat_c.comp Φ_c)) ≫ j_chart c =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_c c).toRingHom) ≫ j_chart c := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc, hΦc_fac, ← CategoryTheory.Category.assoc]
            dsimp [ι_c]
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hratc_comp,
              ← hGen_c c]
            rfl
          have hm := (cancel_mono (j_chart c)).mp hspec
          exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hm)
        have hΦc_eq : MvPolynomial.eval₂Hom
            ((algebraMap (Polynomial k) R_c).comp Polynomial.C)
            (fun j : Fin 2 =>
              algebraMap (Polynomial k) R_c (P_vec (c.succAbove j)) *
              IsLocalization.Away.invSelf (P_vec c)) = Φ_c := by
          apply MvPolynomial.ringHom_ext'
          · ext a
            have hC := congrArg (fun f : k →+* R_c => f a) hΦc_C
            simpa using hC.symm
          · intro j
            simp only [MvPolynomial.eval₂Hom_X']
            apply hratc_inj
            have h := congrArg (fun f : MvPolynomial (Fin 2) k →+* RatFunc k => f (MvPolynomial.X j))
              hratc_Φ
            dsimp [θ_c] at h
            rw [MvPolynomial.aeval_X] at h
            rw [h, map_mul, hratc_eq]
            have hinv_rat : rat_c (IsLocalization.Away.invSelf (P_vec c)) =
                (algebraMap (Polynomial k) (RatFunc k) (P_vec c))⁻¹ := by
              have h1 := congrArg rat_c (IsLocalization.Away.mul_invSelf (P_vec c))
              rw [map_mul, map_one, hratc_eq] at h1
              calc
                rat_c (IsLocalization.Away.invSelf (P_vec c))
                  = (algebraMap (Polynomial k) (RatFunc k) (P_vec c))⁻¹ *
                      (algebraMap (Polynomial k) (RatFunc k) (P_vec c) *
                        rat_c (IsLocalization.Away.invSelf (P_vec c))) := by
                    rw [← mul_assoc, inv_mul_cancel₀ (hAlg_ne (hP_vec_ne c)), one_mul]
                _ = (algebraMap (Polynomial k) (RatFunc k) (P_vec c))⁻¹ := by rw [h1, mul_one]
            rw [hinv_rat, div_eq_mul_inv]
        rw [hΦc_eq, hΦc_fac]
      refine ⟨hCharts_all, ?_⟩
      intro Ω _ χ_poly hχ
      have h0 : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.eval₂Hom
            ((algebraMap (Polynomial k) (Localization.Away P₀)).comp Polynomial.C)
            (fun j : Fin 2 =>
              algebraMap (Polynomial k) (Localization.Away P₀) (P_vec ((0 : Fin 3).succAbove j)) *
