    · have hX1_K : (MvPolynomial.X 1 : MvPolynomial (Fin (M + 1 + 1)) K) ∈ 𝒜_K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 1)
      have hY0_K : (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) K) ∈ ℬ_K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0)
      have hy0_K_eq : (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) K) =
          ψ_K_grad (MvPolynomial.X 1) := by
        change MvPolynomial.X 0 =
          MvPolynomial.eval₂Hom MvPolynomial.C v_K (MvPolynomial.X (0 : Fin (M + 1)).succ)
