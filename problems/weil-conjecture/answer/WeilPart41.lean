      (Classical.choose_spec (hAffPoint a ha))))).1
  · intro r
    obtain ⟨hQp, hQcomap, hTrans, hLift, _⟩ := hTower_inf r
    exact ⟨hQp, hQcomap, hTrans, hLift⟩
  · intro a ha r
    simp only [w_aff, Q_aff_star, ha, ↓reduceDIte]
    have hspec := (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
      (Classical.choose_spec (hAffPoint a ha))))).2.2.2 r
    exact ⟨hspec.1, hspec.2.1, hspec.2.2.1, hspec.2.2.2.1⟩
  · intro r
    exact (hTower_inf r).2.2.2.2
  · intro a ha
    simp only [w_aff, ψ_aff, Q_aff_star, ha, ↓reduceDIte]
    let u_a := Classical.choose (Classical.choose_spec (Classical.choose_spec
      (Classical.choose_spec (hAffPoint a ha))))
    have hspec := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
      (Classical.choose_spec (hAffPoint a ha))))
    exact ⟨u_a, hspec.2.1, hspec.2.2.1, fun r => (hspec.2.2.2 r).2.2.2.2⟩

