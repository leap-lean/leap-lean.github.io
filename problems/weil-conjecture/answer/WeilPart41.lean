        _ = q_φS0 ≫ q_h0 ≫ (j_0 ≫ (weilProjectiveSpaceOver k 2).hom) := by
            rw [hj_Sig0_snd, CategoryTheory.Category.assoc]
        _ = (q_φS0 ≫ q_h0) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
            rw [hj_0_hom, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom MvPolynomial.C ≫
                (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {h₀})) ≫
                  CommRingCat.ofHom φ_S0)) := by
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom MvPolynomial.C ≫
                (CommRingCat.ofHom φ_loc ≫
                  CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {g₀})))) := by
            rw [hφ_S0_comm]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_k_S0) := rfl

    have hComm_f0k :
        (π_Ztilde ≫ P.f₀.left) ≫ (weilProjectiveSpaceOver F 1).hom = Z_tilde_k.hom ≫ g_bc := by
      rw [CategoryTheory.Category.assoc, P.f₀.w]
      exact CategoryTheory.Limits.pullback.condition
    let f₀_k : Z_tilde_k.left ⟶ P1_k.left :=
      CategoryTheory.Limits.pullback.lift (π_Ztilde ≫ P.f₀.left) Z_tilde_k.hom hComm_f0k
    have hf₀_k_fst : f₀_k ≫ π_P1 = π_Ztilde ≫ P.f₀.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hf₀_k_snd : f₀_k ≫ P1_k.hom = Z_tilde_k.hom :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_f0k : CategoryTheory.IsPullback π_Ztilde f₀_k P.f₀.left π_P1 := by
      refine CategoryTheory.IsPullback.of_bot ?_ hf₀_k_fst.symm
        (CategoryTheory.IsPullback.of_hasPullback (weilProjectiveSpaceOver F 1).hom g_bc)
      change CategoryTheory.IsPullback π_Ztilde (f₀_k ≫ P1_k.hom)
        (P.f₀.left ≫ (weilProjectiveSpaceOver F 1).hom) g_bc
      rw [hf₀_k_snd, P.f₀.w]
      exact CategoryTheory.IsPullback.of_hasPullback P.Z_tilde.hom g_bc

    let Z_S0 := CategoryTheory.Limits.pullback f₀_k h_S0
    let p_Ztilde_k := CategoryTheory.Limits.pullback.fst f₀_k h_S0
    let p_S0 := CategoryTheory.Limits.pullback.snd f₀_k h_S0
    have hp_Ztilde_k_et : AlgebraicGeometry.Etale p_Ztilde_k :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f₀_k h_S0).flip hh_S0_et
    have hPb_ZS0_big :
        CategoryTheory.IsPullback
          ((p_Ztilde_k ≫ π_Ztilde) ≫ P.ι_Ytilde.left)
          p_S0 P.g₂.left (g_S0 ≫ e_B) := by
      have h1 := ((CategoryTheory.IsPullback.of_hasPullback f₀_k h_S0).paste_horiz hPb_f0k).paste_horiz
        P.hPb_line
      rwa [CategoryTheory.Category.assoc h_S0 π_P1 P.ι_line.left, hh_S0_line] at h1
    let Y2_R' := CategoryTheory.Limits.pullback P.g₂.left e_B
    let fst_Y2R' := CategoryTheory.Limits.pullback.fst P.g₂.left e_B
    let snd_Y2R' := CategoryTheory.Limits.pullback.snd P.g₂.left e_B
    have hComm_uZS0 :
        ((p_Ztilde_k ≫ π_Ztilde) ≫ P.ι_Ytilde.left) ≫ P.g₂.left = (p_S0 ≫ g_S0) ≫ e_B := by
      rw [CategoryTheory.Category.assoc p_S0 g_S0 e_B]
      exact hPb_ZS0_big.w
    let u_ZS0 : Z_S0 ⟶ Y2_R' :=
      CategoryTheory.Limits.pullback.lift ((p_Ztilde_k ≫ π_Ztilde) ≫ P.ι_Ytilde.left)
        (p_S0 ≫ g_S0) hComm_uZS0
    have hu_ZS0_fst : u_ZS0 ≫ fst_Y2R' = (p_Ztilde_k ≫ π_Ztilde) ≫ P.ι_Ytilde.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hu_ZS0_snd : u_ZS0 ≫ snd_Y2R' = p_S0 ≫ g_S0 :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_ZS0_R' : CategoryTheory.IsPullback u_ZS0 p_S0 snd_Y2R' g_S0 := by
      refine CategoryTheory.IsPullback.of_right ?_ hu_ZS0_snd
        (CategoryTheory.IsPullback.of_hasPullback P.g₂.left e_B)
      rw [hu_ZS0_fst]
      exact hPb_ZS0_big

    have hComm_e'Y : e_Y ≫ P.g₂.left = (q_roof ≫ π_mod) ≫ e_B := by
      rw [CategoryTheory.Category.assoc]
      exact hComm_roof
    let e'_Y : V' ⟶ Y2_R' :=
      CategoryTheory.Limits.pullback.lift e_Y (q_roof ≫ π_mod) hComm_e'Y
    have he'_Y_fst : e'_Y ≫ fst_Y2R' = e_Y :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have he'_Y_snd : e'_Y ≫ snd_Y2R' = q_roof ≫ π_mod :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hfst_Y2R'_et : AlgebraicGeometry.Etale fst_Y2R' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback P.g₂.left e_B).flip he_B_et
    have he'_Y_et : AlgebraicGeometry.Etale e'_Y :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) e'_Y fst_Y2R'
        hfst_Y2R'_et (by rwa [he'_Y_fst])

    let W_Z := CategoryTheory.Limits.pullback q_roof (AlgebraicGeometry.Spec.map π_M)
    let p_V' := CategoryTheory.Limits.pullback.fst q_roof (AlgebraicGeometry.Spec.map π_M)
    let p_Modp := CategoryTheory.Limits.pullback.snd q_roof (AlgebraicGeometry.Spec.map π_M)
    have hp_Modp_et : AlgebraicGeometry.Etale p_Modp :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback q_roof (AlgebraicGeometry.Spec.map π_M))
        hq_roof_et
    have hPb_WZ_R' :
        CategoryTheory.IsPullback p_V' (p_Modp ≫ AlgebraicGeometry.Spec.map c_S0)
          (q_roof ≫ π_mod) g_S0 :=
      (CategoryTheory.IsPullback.of_hasPullback q_roof (AlgebraicGeometry.Spec.map π_M)).paste_vert
        hPb_M
    have hComm_eWZ :
        (p_V' ≫ e'_Y) ≫ snd_Y2R' = (p_Modp ≫ AlgebraicGeometry.Spec.map c_S0) ≫ g_S0 := by
      rw [CategoryTheory.Category.assoc, he'_Y_snd]
      exact hPb_WZ_R'.w
    let e_WZ : W_Z ⟶ Z_S0 :=
      hPb_ZS0_R'.lift (p_V' ≫ e'_Y) (p_Modp ≫ AlgebraicGeometry.Spec.map c_S0) hComm_eWZ
    have he_WZ_fst : e_WZ ≫ u_ZS0 = p_V' ≫ e'_Y :=
      hPb_ZS0_R'.lift_fst _ _ hComm_eWZ
    have he_WZ_snd : e_WZ ≫ p_S0 = p_Modp ≫ AlgebraicGeometry.Spec.map c_S0 :=
      hPb_ZS0_R'.lift_snd _ _ hComm_eWZ
    have hPb_eWZ : CategoryTheory.IsPullback p_V' e_WZ e'_Y u_ZS0 := by
      refine CategoryTheory.IsPullback.of_bot ?_ he_WZ_fst.symm hPb_ZS0_R'
      rw [he_WZ_snd, he'_Y_snd]
      exact hPb_WZ_R'
    have he_WZ_et : AlgebraicGeometry.Etale e_WZ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eWZ he'_Y_et
    let f_WZ : W_Z ⟶ Z_tilde_k.left := e_WZ ≫ p_Ztilde_k
    have hf_WZ_et : AlgebraicGeometry.Etale f_WZ := inferInstance
    have hf_WZ_hom :
        f_WZ ≫ Z_tilde_k.hom =
          p_Modp ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_S0.hom.comp c_k_S0)) := by
      calc f_WZ ≫ Z_tilde_k.hom
          = e_WZ ≫ p_Ztilde_k ≫ (f₀_k ≫ P1_k.hom) := by
            rw [hf₀_k_snd]
            simp only [f_WZ, CategoryTheory.Category.assoc]
        _ = e_WZ ≫ (p_Ztilde_k ≫ f₀_k) ≫ P1_k.hom := by
            simp only [CategoryTheory.Category.assoc]
        _ = (e_WZ ≫ p_S0) ≫ (h_S0 ≫ P1_k.hom) := by
            rw [CategoryTheory.Limits.pullback.condition]
            simp only [p_S0, CategoryTheory.Category.assoc]
        _ = p_Modp ≫ (AlgebraicGeometry.Spec.map c_S0 ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_k_S0)) := by
            rw [he_WZ_snd, hh_S0_hom, CategoryTheory.Category.assoc]
        _ = p_Modp ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_S0.hom.comp c_k_S0)) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            rfl

    
    let χ_mor : M_R' ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s_v ≫ q_roof)
    have hχ_map : AlgebraicGeometry.Spec.map χ_mor = s_v ≫ q_roof :=
      AlgebraicGeometry.Spec.map_preimage (s_v ≫ q_roof)
    have hχ_C :
        χ_mor.hom.comp ((Ideal.Quotient.mk I_R').comp MvPolynomial.C) = ε_R.comp α_R'.hom := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (χ_mor.hom.comp ((Ideal.Quotient.mk I_R').comp MvPolynomial.C))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ε_R.comp α_R'.hom)) := by
        calc AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (χ_mor.hom.comp ((Ideal.Quotient.mk I_R').comp MvPolynomial.C)))
            = AlgebraicGeometry.Spec.map χ_mor ≫ π_mod := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              rfl
          _ = s_v ≫ q_roof ≫ π_mod := by
              rw [hχ_map, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ε_R.comp α_R'.hom)) :=
              hε_α_map.symm
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)
    have hχ_eq_πM_εM : χ_mor = π_M ≫ ε_M := by
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r'
        have hr' := congrArg (fun φ => φ r') hχ_C
        change χ_mor.hom (Ideal.Quotient.mk I_R' (MvPolynomial.C r')) = ε_R (α_R'.hom r') at hr'
        change χ_mor.hom (Ideal.Quotient.mk I_R' (MvPolynomial.C r')) =
          ε_M.hom (Ideal.Quotient.mk I_odp (MvPolynomial.map β_R' (MvPolynomial.C r')))
        rw [hr', MvPolynomial.map_C]
        change ε_R (α_R'.hom r') =
          MvPolynomial.eval₂Hom ε_loc _ (MvPolynomial.C (algebraMap R R_loc (α_R'.hom r')))
        rw [MvPolynomial.eval₂Hom_C]
        exact (congrArg (fun φ => φ (α_R'.hom r')) hε_loc).symm
      · intro idx
        have hmem : Ideal.Quotient.mk I_R' (MvPolynomial.X idx) ∈
            ((AlgebraicGeometry.Spec.map χ_mor).base pt_k).asIdeal := by
          rw [hχ_map]
          change Ideal.Quotient.mk I_R' (MvPolynomial.X idx) ∈
            (q_roof.base (s_v.base pt_k)).asIdeal
          rw [hs_v_pt pt_k]
          exact hv_pt_X idx
        change Ideal.Quotient.mk I_R' (MvPolynomial.X idx) ∈
          Ideal.comap χ_mor.hom pt_k.asIdeal at hmem
        rw [hFieldPrimeBot pt_k, Ideal.mem_comap, Submodule.mem_bot] at hmem
        change χ_mor.hom (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)) =
          ε_M.hom (Ideal.Quotient.mk I_odp (MvPolynomial.map β_R' (MvPolynomial.X idx)))
        rw [hmem, MvPolynomial.map_X]
        change 0 = MvPolynomial.eval₂Hom ε_loc (fun _ : Fin (m + 1) × Fin 2 => (0 : k))
          (MvPolynomial.X idx)
        rw [MvPolynomial.eval₂Hom_X']
    have hComm_sWZ :
        s_v ≫ q_roof = AlgebraicGeometry.Spec.map ε_M ≫ AlgebraicGeometry.Spec.map π_M := by
      rw [← hχ_map, hχ_eq_πM_εM, AlgebraicGeometry.Spec.map_comp]
    let s_WZ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_Z :=
      CategoryTheory.Limits.pullback.lift s_v (AlgebraicGeometry.Spec.map ε_M) hComm_sWZ
    have hs_WZ_Modp : s_WZ ≫ p_Modp = AlgebraicGeometry.Spec.map ε_M :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hs_WZ_Zhom :
        (s_WZ ≫ f_WZ) ≫ Z_tilde_k.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      have hId_k : (ε_M.hom.comp c_S0.hom).comp c_k_S0 = RingHom.id k := by
        apply RingHom.ext
        intro c
        change ε_M.hom (c_S0.hom (Ideal.Quotient.mk (Ideal.span {g₀}) (φ_loc (MvPolynomial.C c)))) = c
        change ε_M.hom (Ideal.Quotient.mk I_odp (MvPolynomial.C (φ_loc (MvPolynomial.C c)))) = c
        change MvPolynomial.eval₂Hom ε_loc _ (MvPolynomial.C (φ_loc (MvPolynomial.C c))) = c
        rw [MvPolynomial.eval₂Hom_C]
        change (ε_loc.comp (algebraMap R R_loc)) (φ_B (MvPolynomial.C c)) = c
        rw [hε_loc]
        change (ε_R.comp φ_B) (MvPolynomial.C c) = c
        rw [hε_φ]
        exact MvPolynomial.eval_C c
      calc (s_WZ ≫ f_WZ) ≫ Z_tilde_k.hom
          = s_WZ ≫ (f_WZ ≫ Z_tilde_k.hom) := by rw [CategoryTheory.Category.assoc]
        _ = (s_WZ ≫ p_Modp) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_S0.hom.comp c_k_S0)) := by
            rw [hf_WZ_hom, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map ε_M ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_S0.hom.comp c_k_S0)) := by
            rw [hs_WZ_Modp]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((ε_M.hom.comp c_S0.hom).comp c_k_S0)) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            rfl
        _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
            rw [hId_k]
            rfl
        _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
            AlgebraicGeometry.Spec.map_id _

    
    let w_Z := s_WZ.base pt_k
    let z_k := f_WZ.base w_Z
    obtain ⟨U, hU, V, hV, hz_k, e_UV, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff (2 * m + 2) Z_tilde_k.hom).mp
        inferInstance z_k
    let R_U := (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)
    let R_V := Z_tilde_k.left.presheaf.obj (Opposite.op V)
    obtain ⟨g_UV, hg_UV_C, hg_UV_et⟩ := hStd.exists_etale_mvPolynomial
    have hz_k_U : Z_tilde_k.hom.base z_k ∈ U := e_UV hz_k
    have hId_range_U :
        Set.range ⇑(𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) ⊆
          Set.range ⇑hU.fromSpec := by
      rw [hU.range_fromSpec]
      rintro y ⟨pt, rfl⟩
      change pt ∈ U
      rwa [hFieldPrimeEq pt (Z_tilde_k.hom.base z_k)]
    let f_inv : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec R_U :=
      AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) hId_range_U
    have hf_inv_right : f_inv ≫ hU.fromSpec = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec _ hId_range_U
    have hf_inv_left : hU.fromSpec ≫ f_inv = 𝟙 (AlgebraicGeometry.Spec R_U) := by
      apply (cancel_mono hU.fromSpec).mp
      rw [CategoryTheory.Category.assoc, hf_inv_right, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    let α_kU : CommRingCat.of k ⟶ R_U := AlgebraicGeometry.Spec.preimage hU.fromSpec
    let β_Uk : R_U ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage f_inv
    have hα_kU_map : AlgebraicGeometry.Spec.map α_kU = hU.fromSpec :=
      AlgebraicGeometry.Spec.map_preimage hU.fromSpec
    have hβ_Uk_map : AlgebraicGeometry.Spec.map β_Uk = f_inv :=
      AlgebraicGeometry.Spec.map_preimage f_inv
    have hαβ_id : α_kU ≫ β_Uk = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hα_kU_map, hβ_Uk_map, hf_inv_right,
        AlgebraicGeometry.Spec.map_id]
    have hβα_id : β_Uk ≫ α_kU = 𝟙 R_U := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hα_kU_map, hβ_Uk_map, hf_inv_left,
        AlgebraicGeometry.Spec.map_id]
    have hmap_α_bij :
        Function.Bijective (MvPolynomial.map (σ := Fin (2 * m + 2)) α_kU.hom) := by
      refine ⟨fun p₁ p₂ hp => ?_, fun q => ⟨MvPolynomial.map β_Uk.hom q, ?_⟩⟩
      · have hp' := congrArg (MvPolynomial.map (σ := Fin (2 * m + 2)) β_Uk.hom) hp
        rw [MvPolynomial.map_map, MvPolynomial.map_map] at hp'
        have hcomp : β_Uk.hom.comp α_kU.hom = RingHom.id k :=
          congrArg CommRingCat.Hom.hom hαβ_id
        simpa [hcomp, MvPolynomial.map_id] using hp'
      · rw [MvPolynomial.map_map]
        have hcomp : α_kU.hom.comp β_Uk.hom = RingHom.id R_U :=
          congrArg CommRingCat.Hom.hom hβα_id
        simp [hcomp, MvPolynomial.map_id]
    have hmap_α_et : (MvPolynomial.map (σ := Fin (2 * m + 2)) α_kU.hom).Etale :=
      RingHom.Etale.of_bijective hmap_α_bij
    let φ_sm_V : MvPolynomial (Fin (2 * m + 2)) k →+* R_V :=
      g_UV.comp (MvPolynomial.map α_kU.hom)
    have hφ_sm_V_et : φ_sm_V.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hmap_α_et hg_UV_et
    have hφ_sm_V_C_hom :
        CommRingCat.ofHom (φ_sm_V.comp MvPolynomial.C) =
          α_kU ≫ Z_tilde_k.hom.appLE U V e_UV := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change g_UV (MvPolynomial.map α_kU.hom (MvPolynomial.C c)) =
        (Z_tilde_k.hom.appLE U V e_UV).hom (α_kU.hom c)
      rw [MvPolynomial.map_C]
      exact congrArg (fun φ => φ (α_kU.hom c)) hg_UV_C
    have hSpec_φ_sm_V_C :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_sm_V.comp MvPolynomial.C)) =
          hV.fromSpec ≫ Z_tilde_k.hom := by
      rw [hφ_sm_V_C_hom, AlgebraicGeometry.Spec.map_comp, hα_kU_map]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Z_tilde_k.hom hU hV e_UV

    have hw_Z_preV : w_Z ∈ (TopologicalSpace.Opens.map f_WZ.base).obj V := hz_k
    obtain ⟨B_Z, j_BZ, hj_BZ_open, ⟨q_BZ, hq_BZ_eq⟩, hj_BZ_sub⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (X := W_Z) (U := (TopologicalSpace.Opens.map f_WZ.base).obj V) (x := w_Z) hw_Z_preV
    have : AlgebraicGeometry.IsOpenImmersion j_BZ := hj_BZ_open
    have hj_BZ_f_range : Set.range (j_BZ ≫ f_WZ).base ⊆ Set.range hV.fromSpec.base := by
      rw [hV.range_fromSpec]
      rintro _ ⟨u, rfl⟩
      exact hj_BZ_sub ⟨u, rfl⟩
    let h_BZV : AlgebraicGeometry.Spec B_Z ⟶ AlgebraicGeometry.Spec R_V :=
      AlgebraicGeometry.IsOpenImmersion.lift hV.fromSpec (j_BZ ≫ f_WZ) hj_BZ_f_range
    have hh_BZV_fac : h_BZV ≫ hV.fromSpec = j_BZ ≫ f_WZ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hV.fromSpec (j_BZ ≫ f_WZ) hj_BZ_f_range
    have hj_BZ_f_et : AlgebraicGeometry.Etale (j_BZ ≫ f_WZ) := inferInstance
    have hh_BZV_et : AlgebraicGeometry.Etale h_BZV :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) h_BZV hV.fromSpec
        inferInstance (by rwa [hh_BZV_fac])
    let α_VB : R_V ⟶ B_Z := AlgebraicGeometry.Spec.preimage h_BZV
    have hα_VB_map : AlgebraicGeometry.Spec.map α_VB = h_BZV :=
      AlgebraicGeometry.Spec.map_preimage h_BZV
    have hα_VB_et : α_VB.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (by rwa [hα_VB_map])

    let ψ_sm : MvPolynomial (Fin (2 * m + 2)) k →+* B_Z := α_VB.hom.comp φ_sm_V
    have hψ_sm_et : ψ_sm.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hφ_sm_V_et hα_VB_et
    have hs_WZ_range : Set.range s_WZ.base ⊆ Set.range j_BZ.base := by
      rintro _ ⟨pt, rfl⟩
      rw [hFieldPrimeEq pt pt_k]
      exact ⟨q_BZ, hq_BZ_eq⟩
    let s_BZ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec B_Z :=
      AlgebraicGeometry.IsOpenImmersion.lift j_BZ s_WZ hs_WZ_range
    have hs_BZ_fac : s_BZ ≫ j_BZ = s_WZ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_BZ s_WZ hs_WZ_range
    let ε_Z_mor : B_Z ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage s_BZ
    let ε_Z : B_Z →+* k := ε_Z_mor.hom
    have hε_Z_map : AlgebraicGeometry.Spec.map ε_Z_mor = s_BZ :=
      AlgebraicGeometry.Spec.map_preimage s_BZ
    let q_mod : M_odp ⟶ B_Z := AlgebraicGeometry.Spec.preimage (j_BZ ≫ p_Modp)
    have hq_mod_map : AlgebraicGeometry.Spec.map q_mod = j_BZ ≫ p_Modp :=
      AlgebraicGeometry.Spec.map_preimage (j_BZ ≫ p_Modp)
    have hSpec_qmod_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map q_mod) := by
      rw [hq_mod_map]
      infer_instance
    have hq_mod_et : q_mod.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hSpec_qmod_et

    have hε_Z_ψ_C : (ε_Z.comp ψ_sm).comp MvPolynomial.C = RingHom.id k := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((ε_Z.comp ψ_sm).comp MvPolynomial.C)) =
            AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
        calc AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((ε_Z.comp ψ_sm).comp MvPolynomial.C))
            = AlgebraicGeometry.Spec.map
                ((CommRingCat.ofHom (φ_sm_V.comp MvPolynomial.C) ≫ α_VB) ≫ ε_Z_mor) :=
              rfl
          _ = AlgebraicGeometry.Spec.map ε_Z_mor ≫ AlgebraicGeometry.Spec.map α_VB ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_sm_V.comp MvPolynomial.C)) := by
              rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
          _ = s_BZ ≫ (h_BZV ≫ hV.fromSpec) ≫ Z_tilde_k.hom := by
              simp only [hε_Z_map, hα_VB_map, hSpec_φ_sm_V_C, CategoryTheory.Category.assoc]
          _ = ((s_BZ ≫ j_BZ) ≫ f_WZ) ≫ Z_tilde_k.hom := by
              rw [hh_BZV_fac]
              simp only [CategoryTheory.Category.assoc]
          _ = (s_WZ ≫ f_WZ) ≫ Z_tilde_k.hom := by rw [hs_BZ_fac]
          _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := hs_WZ_Zhom
          _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) :=
              (AlgebraicGeometry.Spec.map_id _).symm
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)

    have hε_Z_qmod : ε_Z.comp q_mod.hom = ε_M.hom := by
      have hmor_eq : q_mod ≫ ε_Z_mor = ε_M := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, hε_Z_map, hq_mod_map, ← CategoryTheory.Category.assoc,
          hs_BZ_fac, hs_WZ_Modp]
      exact congrArg CommRingCat.Hom.hom hmor_eq

    refine ⟨B_Z, ε_Z, ψ_sm, q_mod, hψ_sm_et, hε_Z_ψ_C, hq_mod_et, ?_, ?_⟩
    · intro idx
      change (ε_Z.comp q_mod.hom) (Ideal.Quotient.mk I_odp (MvPolynomial.X idx)) = 0
      rw [hε_Z_qmod]
      exact MvPolynomial.eval₂Hom_X' ε_loc _ idx
    · intro r
      change (ε_Z.comp q_mod.hom) (Ideal.Quotient.mk I_odp (MvPolynomial.C r)) = ε_loc r
      rw [hε_Z_qmod]
      exact MvPolynomial.eval₂Hom_C ε_loc _ r

