        (∀ q : ℕ, 2 * d < q → Subsingleton (weilEtaleTorsionH X.left m₀ q)) ∧
        (∀ (U : X.left.Opens) (q : ℕ), q ≤ 2 * d →
          let U_et : X.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
            (inferInstance : AlgebraicGeometry.Etale U.ι)
          (∀ x : weilEtaleLocalTorsionH X.left m₀ U_et q, m₀ • x = 0) ∧
          Nonempty (weilEtaleTorsionH U.toScheme m₀ (2 * d - q) ≃+
            (weilEtaleLocalTorsionH X.left m₀ U_et q →+ ZMod m₀))) := by
      rintro m₀ ⟨s, rfl⟩
      let m := ℓ ^ (s + 1)
      let R := ULift.{u, 0} (ZMod m)
      have hm : 1 ≤ m := Nat.one_le_pow (s + 1) ℓ hPrime.pos
      have hGod : WeilHasTruncatedGodementComplex X.left d m :=
        weil_etale_truncated_godement_acyclic_complex k X d m hm (hUnit (s + 1)) hDim
      obtain ⟨⟨θ_top, hθ_top, _⟩, _⟩ := weil_etale_module_ext_comparison.1 X.left m (2 * d)
      let τ : weilEtaleModuleH X.left m (2 * d) →+ ZMod m := (tr (s + 1)).comp θ_top
      have hEff_m : WeilHasLocalEffacement X.left d m τ := hEff (s + 1) θ_top hθ_top
      obtain ⟨hEnd, hGeomLift, hLocConst⟩ :=
        weil_etale_connected_unit_end_and_geom_point_lift X.left m hm
      have hDualRep : WeilHasVerdierDualSheafRep X.left m :=
        weil_etale_colimit_preserving_dual_injective_sheaf X.left m hm (hInjR m hm)
      have hDualExt : WeilHasVerdierDualExtPackage X.left d m τ :=
        weil_etale_verdier_dual_injective_resolution_of_effacement X.left d m hm τ hGod hEff_m
          (hInjR m hm) hGeomLift hLocConst hDualRep
      have hτ_bij : Function.Bijective τ :=
        (weil_etale_verdier_duality_of_local_effacement X.left d m hm τ hGod hEff_m).1
      obtain ⟨hAboveMod, hSheafDual⟩ :=
        weil_qcvs_ve_godement_above_top_and_sheaf_verdier_duality X.left d m hm hGod
      refine ⟨?_, ?_⟩
      · intro q hq
        have _ := hAboveMod (weilEtaleModuleUnit X.left m) q hq
        obtain ⟨⟨θ_q, _, hθ_q_bij⟩, _⟩ := weil_etale_module_ext_comparison.1 X.left m q
        exact (AddEquiv.ofBijective θ_q hθ_q_bij).symm.toEquiv.subsingleton
      · intro U q hq U_et
        let L_mod := weilEtaleLocalFreeSheaf X.left m U_et
        obtain ⟨e_sheaf⟩ :=
          hSheafDual τ hDualExt hτ_bij hEnd L_mod q (2 * d - q) (Nat.add_sub_of_le hq)
        obtain ⟨⟨e_open⟩, _⟩ :=
          weil_qcvs_ve_open_localFree_dual_and_torsion_equiv X.left U m (2 * d - q) hm
        obtain ⟨_, ⟨e_loc⟩⟩ :=
          weil_qcvs_ve_open_localFree_dual_and_torsion_equiv X.left U m q hm
        have hm_id_L : m • CategoryTheory.CategoryStruct.id L_mod = 0 := by
          ext V y
          change m • y = 0
          have hmR : ((m : ℕ) : R) = 0 := ULift.ext _ _ (ZMod.natCast_self m)
          rw [← Nat.cast_smul_eq_nsmul R m y, hmR, zero_smul]
        have hTorsMod : ∀ y : weilEtaleLocalModuleH X.left m U_et q, m • y = 0 := by
          intro y
          have hmk_nsmul : ∀ (n_val : ℕ) (f : Quiver.Hom L_mod L_mod),
              CategoryTheory.Abelian.Ext.mk₀ (n_val • f) =
                n_val • CategoryTheory.Abelian.Ext.mk₀ f := by
            intro n_val f
            induction n_val with
            | zero => rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero]
            | succ n_val ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
          let pre_y : CategoryTheory.Abelian.Ext.{u} L_mod L_mod 0 →+
              weilEtaleLocalModuleH X.left m U_et q :=
            AddMonoidHom.mk' (fun u => y.comp u (Nat.add_zero q))
              (fun u₁ u₂ => CategoryTheory.Abelian.Ext.comp_add y u₁ u₂ (Nat.add_zero q))
          calc
            m • y = m • pre_y (CategoryTheory.Abelian.Ext.mk₀
                (CategoryTheory.CategoryStruct.id L_mod)) := by
              rw [AddMonoidHom.mk'_apply, CategoryTheory.Abelian.Ext.comp_mk₀_id]
            _ = pre_y (m • CategoryTheory.Abelian.Ext.mk₀
                (CategoryTheory.CategoryStruct.id L_mod)) :=
              (map_nsmul pre_y m _).symm
            _ = pre_y (CategoryTheory.Abelian.Ext.mk₀
                (m • CategoryTheory.CategoryStruct.id L_mod)) := by
              rw [← hmk_nsmul]
            _ = pre_y 0 := by rw [hm_id_L, CategoryTheory.Abelian.Ext.mk₀_zero]
            _ = 0 := map_zero pre_y
        have hTorsLoc : ∀ x : weilEtaleLocalTorsionH X.left m U_et q, m • x = 0 := by
          intro x
          calc m • x = m • e_loc (e_loc.symm x) := by rw [e_loc.apply_symm_apply]
            _ = e_loc (m • e_loc.symm x) := (map_nsmul e_loc m _).symm
            _ = e_loc 0 := by rw [hTorsMod (e_loc.symm x)]
            _ = 0 := map_zero e_loc
        let e_dual_hom : (CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit X.left m) L_mod q →+
            ZMod m) ≃+ (weilEtaleLocalTorsionH X.left m U_et q →+ ZMod m) :=
          { toFun := fun φ => φ.comp e_loc.symm.toAddMonoidHom
            invFun := fun ψ => ψ.comp e_loc.toAddMonoidHom
            left_inv := fun φ => by ext y; simp
            right_inv := fun ψ => by ext y; simp
            map_add' := fun φ₁ φ₂ => by ext y; rfl }
        exact ⟨hTorsLoc, ⟨(e_open.symm.trans e_sheaf).trans e_dual_hom⟩⟩

    obtain ⟨hAbove_r, hDual_r⟩ := hOpenDual (ℓ ^ (r + 1)) ⟨r, rfl⟩
    refine ⟨hAbove_r, ?_, ?_⟩
    · 
      intro Z _ i hi_cl U hU
      let m₀ := ℓ ^ (r + 1)
      have hm₀ : 1 ≤ m₀ := Nat.one_le_pow (r + 1) ℓ hPrime.pos
      let U_et : X.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
        (inferInstance : AlgebraicGeometry.Etale U.ι)
      obtain ⟨hExcPow, _⟩ :=
        weil_qcvs_ve_closed_open_localTorsion_exact_pullback k ℓ hℓ hPBC X Z i hi_cl U hU
      have hLocSub_r : ∀ (q : ℕ), q ≤ 2 * d →
          Subsingleton (weilEtaleTorsionH U.toScheme m₀ (2 * d - q)) →
          Subsingleton (weilEtaleLocalTorsionH X.left m₀ U_et q) := by
        intro q hq hSubU
        obtain ⟨hTorsLoc, ⟨e_dual⟩⟩ := hDual_r U q hq
        have hSubHom : Subsingleton (weilEtaleLocalTorsionH X.left m₀ U_et q →+ ZMod m₀) :=
          e_dual.symm.toEquiv.subsingleton
        exact hCogSub m₀ hm₀ _ hTorsLoc hSubHom
      refine ⟨?_, ?_⟩
      · intro p hp hSubU_p p_i hp_i
        exact (hExcPow r p p_i hp_i).1 (hLocSub_r p hp hSubU_p)
      · intro p hp1 hSubU_p hSubU_p1 p_i hp_i
        exact (hExcPow r p p_i hp_i).2
          (hLocSub_r p (by omega) hSubU_p)
          (hLocSub_r (p + 1) hp1 hSubU_p1)

    · 
      intro Z _ i hi_cl U hU p hp1 hSub_Xp hFin_X hFin_Z hCard_XZ hex_top hFin_U hCard_U
      let U_et : X.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
        (inferInstance : AlgebraicGeometry.Etale U.ι)
      let A := weilEtaleLocalTorsionH X.left ℓ U_et (p + 1)
      obtain ⟨_, hExcPrime⟩ :=
        weil_qcvs_ve_closed_open_localTorsion_exact_pullback k ℓ hℓ hPBC X Z i hi_cl U hU
      obtain ⟨_, hDual_0⟩ := hOpenDual ℓ ⟨0, (pow_one ℓ).symm⟩
      obtain ⟨hTors_A, ⟨e_dual⟩⟩ := hDual_0 U (p + 1) hp1
      have hFin_dual : Finite (A →+ ZMod ℓ) := Finite.of_equiv _ e_dual.toEquiv
      have hCard_dual : Nat.card (A →+ ZMod ℓ) ≤ ℓ := by
        rw [Nat.card_congr e_dual.symm.toEquiv]
        exact hCard_U
      obtain ⟨hFin_A, hCard_A⟩ := hDualCardLe ℓ A hTors_A hFin_dual hCard_dual
      exact hExcPrime p hSub_Xp hFin_X hFin_Z hCard_XZ hex_top hFin_A hCard_A

theorem weil_qcp_clopen_freeYoneda_retraction (S : AlgebraicGeometry.Scheme.{u}) (U₀ U₁ : S.Opens)
    (hInf : U₀ ⊓ U₁ = ⊥) (hSup : U₀ ⊔ U₁ = ⊤) :
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let J_S := S.smallEtaleTopology
    let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
    let Pℤ_S := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ
    let U₀_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₀.ι
      (inferInstance : AlgebraicGeometry.Etale U₀.ι)
    let Z₀ := CategoryTheory.Sheaf.freeYoneda J_S U₀_et Aℤ
    let κ₀ : Z₀ ⟶ Fℤ_S := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S).app
        (Opposite.op U₀_et))
    ∃ (σ₀ : Fℤ_S ⟶ Z₀), κ₀ ≫ σ₀ = 𝟙 Z₀ :=
by
  intro Aℤ J_S Fℤ_S Pℤ_S U₀_et Z₀ κ₀
  let U₁_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₁.ι
    (inferInstance : AlgebraicGeometry.Etale U₁.ι)
  let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S)
    (inferInstance : AlgebraicGeometry.Etale (𝟙 S))
  let toTS : ∀ W : S.Etale, W ⟶ T_S := fun W =>
    CategoryTheory.MorphismProperty.Over.homMk W.hom (CategoryTheory.Category.comp_id W.hom)
  have hT_S : CategoryTheory.Limits.IsTerminal T_S :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom toTS (fun W g => by
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · have hg : g.left ≫ 𝟙 S = W.hom := CategoryTheory.MorphismProperty.Over.w g
        exact (CategoryTheory.Category.comp_id g.left).symm.trans hg
      · exact Subsingleton.elim _ _)
  let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hJ_eq :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
      (le_refl (@AlgebraicGeometry.Etale))
  have hBot_of_empty : ∀ (W : S.Etale), IsEmpty ↥W.left → (⊥ : CategoryTheory.Sieve W) ∈ J_S W := by
    intro W hEmpty
    let R_bot : CategoryTheory.Sieve W := ⊥
    exact Eq.mpr (congrArg (fun J => R_bot ∈ J W) hJ_eq)
      ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) W R_bot).mpr
        (fun w => hEmpty.elim w))
  let X_fam : Bool → S.Etale := fun i => match i with | false => U₀_et | true => U₁_et
  let u_fam : ∀ i : Bool, X_fam i ⟶ T_S := fun i => toTS (X_fam i)
  have hf_cov : CategoryTheory.Sieve.ofArrows X_fam u_fam ∈ J_S T_S := by
    let R_cov : CategoryTheory.Sieve T_S := CategoryTheory.Sieve.ofArrows X_fam u_fam
    refine Eq.mpr (congrArg (fun J => R_cov ∈ J T_S) hJ_eq)
      ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) T_S R_cov).mpr ?_)
    intro x
    let x' : ↥S := x
    have hx_top : x' ∈ (⊤ : S.Opens) := trivial
    rw [← hSup, TopologicalSpace.Opens.mem_sup] at hx_top
    rcases hx_top with hx₀ | hx₁
    · change x' ∈ (U₀ : Set ↥S) at hx₀
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₀] at hx₀
      rcases hx₀ with ⟨y, hy⟩
      exact ⟨X_fam false, u_fam false, y,
        CategoryTheory.Sieve.ofArrows_mk X_fam u_fam false,
        (inferInstance : AlgebraicGeometry.Etale U₀.ι), hy⟩
    · change x' ∈ (U₁ : Set ↥S) at hx₁
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₁] at hx₁
      rcases hx₁ with ⟨y, hy⟩
      exact ⟨X_fam true, u_fam true, y,
        CategoryTheory.Sieve.ofArrows_mk X_fam u_fam true,
        (inferInstance : AlgebraicGeometry.Etale U₁.ι), hy⟩
  have hDisjEmpty : ∀ (W : S.Etale) (g₀ : W ⟶ U₀_et) (g₁ : W ⟶ U₁_et), IsEmpty ↥W.left := by
    intro W g₀ g₁
    refine ⟨fun w => ?_⟩
    have hw₀ : W.hom.base w ∈ U₀ := by
      change W.hom.base w ∈ (U₀ : Set ↥S)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₀]
      refine ⟨g₀.left.base w, ?_⟩
      have hcomp := congrArg (fun h : W.left ⟶ S => h.base w)
        (CategoryTheory.MorphismProperty.Over.w g₀)
      exact (AlgebraicGeometry.Scheme.Hom.comp_apply g₀.left U₀.ι w).symm.trans hcomp
    have hw₁ : W.hom.base w ∈ U₁ := by
      change W.hom.base w ∈ (U₁ : Set ↥S)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₁]
      refine ⟨g₁.left.base w, ?_⟩
      have hcomp := congrArg (fun h : W.left ⟶ S => h.base w)
        (CategoryTheory.MorphismProperty.Over.w g₁)
      exact (AlgebraicGeometry.Scheme.Hom.comp_apply g₁.left U₁.ι w).symm.trans hcomp
    have hw_inf : W.hom.base w ∈ (U₀ ⊓ U₁ : S.Opens) :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hw₀, hw₁⟩
    rw [hInf] at hw_inf
    change W.hom.base w ∈ ((⊥ : S.Opens) : Set ↥S) at hw_inf
    rw [TopologicalSpace.Opens.coe_bot] at hw_inf
    exact hw_inf
  let s_fam : ∀ i : Bool, Aℤ ⟶ Z₀.obj.obj (Opposite.op (X_fam i)) := fun i =>
    match i with
    | false => CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 Z₀)
    | true => 0
  have hx : ∀ ⦃W : S.Etale⦄ ⦃i j : Bool⦄ (a : W ⟶ X_fam i) (b : W ⟶ X_fam j),
      a ≫ u_fam i = b ≫ u_fam j →
      s_fam i ≫ Z₀.obj.map a.op = s_fam j ≫ Z₀.obj.map b.op := by
    intro W i j a b _hab
    cases i <;> cases j
    · have ha_w : a.left ≫ U₀.ι = W.hom := CategoryTheory.MorphismProperty.Over.w a
      have hb_w : b.left ≫ U₀.ι = W.hom := CategoryTheory.MorphismProperty.Over.w b
      have hab_left : a.left = b.left := (CategoryTheory.cancel_mono U₀.ι).mp (ha_w.trans hb_w.symm)
      have hab_eq : a = b :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hab_left (Subsingleton.elim _ _)
      rw [hab_eq]
    · exact (CategoryTheory.Sheaf.isTerminalOfBotCover Z₀ W
        (hBot_of_empty W (hDisjEmpty W a b))).hom_ext _ _
    · exact (CategoryTheory.Sheaf.isTerminalOfBotCover Z₀ W
        (hBot_of_empty W (hDisjEmpty W b a))).hom_ext _ _
    · change (0 : Aℤ ⟶ Z₀.obj.obj (Opposite.op U₁_et)) ≫ Z₀.obj.map a.op =
        (0 : Aℤ ⟶ Z₀.obj.obj (Opposite.op U₁_et)) ≫ Z₀.obj.map b.op
      exact (CategoryTheory.Limits.zero_comp).trans (CategoryTheory.Limits.zero_comp).symm
  let s : Aℤ ⟶ Z₀.obj.obj (Opposite.op T_S) :=
    Z₀.property.amalgamateOfArrows u_fam hf_cov s_fam hx
  have hs_false : s ≫ Z₀.obj.map (u_fam false).op = s_fam false :=
    Z₀.property.amalgamateOfArrows_map u_fam hf_cov s_fam hx false
  let σ₀ : Fℤ_S ⟶ Z₀ := (adj_S.homEquiv Aℤ Z₀).symm s
  let η_const : Pℤ_S ⟶ Fℤ_S.obj :=
    (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S
  have hFreeEquiv_comp :
      CategoryTheory.Sheaf.freeYonedaHomEquiv (κ₀ ≫ σ₀) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv κ₀ ≫ σ₀.hom.app (Opposite.op U₀_et) :=
    (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
      ((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).homEquiv_naturality_right
        κ₀ σ₀)).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ σ₀.hom)
  have hUnit_TS : adj_S.unit.app Aℤ = η_const.app (Opposite.op T_S) := by
    have h1 := CategoryTheory.Adjunction.comp_unit_app
      (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_S)
      (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}) Aℤ
    have h2 : (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_S).unit.app Aℤ = 𝟙 Aℤ :=
      CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT_S Aℤ
    exact h1.trans ((congrArg (· ≫ η_const.app (Opposite.op T_S)) h2).trans
      (CategoryTheory.Category.id_comp (η_const.app (Opposite.op T_S))))
  have hEval_TS : η_const.app (Opposite.op T_S) ≫ σ₀.hom.app (Opposite.op T_S) = s :=
    (congrArg (· ≫ σ₀.hom.app (Opposite.op T_S)) hUnit_TS.symm).trans
      (((adj_S.homEquiv_unit Aℤ Z₀ σ₀).symm).trans
        ((adj_S.homEquiv Aℤ Z₀).apply_symm_apply s))
  refine ⟨σ₀, CategoryTheory.Sheaf.freeYonedaHomEquiv.injective ?_⟩
  have hκ₀_equiv : CategoryTheory.Sheaf.freeYonedaHomEquiv κ₀ = η_const.app (Opposite.op U₀_et) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (η_const.app (Opposite.op U₀_et))
  have hNat_η : Pℤ_S.map (u_fam false).op ≫ η_const.app (Opposite.op U₀_et) =
      η_const.app (Opposite.op T_S) ≫ Fℤ_S.obj.map (u_fam false).op :=
    η_const.naturality (u_fam false).op
  have hNat_σ : Fℤ_S.obj.map (u_fam false).op ≫ σ₀.hom.app (Opposite.op U₀_et) =
      σ₀.hom.app (Opposite.op T_S) ≫ Z₀.obj.map (u_fam false).op :=
    σ₀.hom.naturality (u_fam false).op
  exact hFreeEquiv_comp.trans
    ((congrArg (· ≫ σ₀.hom.app (Opposite.op U₀_et)) hκ₀_equiv).trans
      ((congrArg (· ≫ σ₀.hom.app (Opposite.op U₀_et))
          ((CategoryTheory.Category.id_comp (η_const.app (Opposite.op U₀_et))).symm.trans hNat_η)).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (η_const.app (Opposite.op T_S) ≫ ·) hNat_σ).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ Z₀.obj.map (u_fam false).op) hEval_TS).trans hs_false))))))

theorem weil_qcp_open_freeYoneda_ext_surj_and_disjoint_zero (S : AlgebraicGeometry.Scheme.{u}) (U₀ : S.Opens) (n q : ℕ) :
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let J_S := S.smallEtaleTopology
    let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
    let Pℤ_S := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ
    let FM_S := weilEtaleTorsionSheaf S n
    let U₀_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₀.ι
      (inferInstance : AlgebraicGeometry.Etale U₀.ι)
    let Z₀ := CategoryTheory.Sheaf.freeYoneda J_S U₀_et Aℤ
    let κ₀ : Z₀ ⟶ Fℤ_S := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S).app
        (Opposite.op U₀_et))
    (∀ (p₀ : weilEtaleTorsionH S n q →+ weilEtaleTorsionH U₀.toScheme n q),
      WeilIsTorsionEtalePullback U₀.ι n q p₀ →
      ∀ (y₀ : weilEtaleTorsionH U₀.toScheme n q),
        ∃ z₀ : CategoryTheory.Abelian.Ext.{u} Z₀ FM_S q,
          ∀ x : weilEtaleTorsionH S n q,
            (CategoryTheory.Abelian.Ext.mk₀ κ₀).comp x (Nat.zero_add q) = z₀ →
            p₀ x = y₀) ∧
    (∀ (U₁ : S.Opens),
      U₀ ⊓ U₁ = ⊥ →
      ∀ (p₁ : weilEtaleTorsionH S n q →+ weilEtaleTorsionH U₁.toScheme n q),
        WeilIsTorsionEtalePullback U₁.ι n q p₁ →
        ∀ (σ : Fℤ_S ⟶ Z₀) (z₀ : CategoryTheory.Abelian.Ext.{u} Z₀ FM_S q),
          p₁ ((CategoryTheory.Abelian.Ext.mk₀ σ).comp z₀ (Nat.zero_add q)) = 0) :=
by
  have : CategoryTheory.EnoughInjectives
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    inferInstance
