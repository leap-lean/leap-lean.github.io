  have hP4 : ∃ ξ_tilde : weilEtaleTorsionH U ℓ 1,
      ∀ (Ω' : Type u) [Field Ω'] [IsAlgClosed Ω']
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ Y.left),
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω')),
          z_bar.base pt ∉ Set.range j.base) →
        ∀ (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
          (v : V ⟶ Y.left) [AlgebraicGeometry.Etale v]
          (z_tilde : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ V),
          z_tilde ≫ v = z_bar →
          ∀ (p_V : weilEtaleTorsionH U ℓ 1 →+
              weilEtaleTorsionH (CategoryTheory.Limits.pullback j v) ℓ 1),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst j v) ℓ 1 p_V →
            p_V ξ_tilde ≠ 0 := by
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let S_0 := weilAffineSpaceOver Ω 0
    let S_δ := weilAffineSpaceOver Ω δ
    let A1_Ω := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))
    let Gm_Ω := AlgebraicGeometry.Spec (CommRingCat.of
      (Localization.Away (Polynomial.X : Polynomial Ω)))
    let j_Gm : Gm_Ω ⟶ A1_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω))))
    let p_A1 : A1_Ω ⟶ S_Ω :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))
    let Y_δ := CategoryTheory.Limits.pullback S_δ.hom p_A1
    let U_δ := CategoryTheory.Limits.pullback j_Gm (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
    let j_δ : U_δ ⟶ Y_δ :=
