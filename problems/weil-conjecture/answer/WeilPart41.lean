        MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul,
        map_add (MvPolynomial.eval p), map_add (MvPolynomial.eval p),
        map_mul (MvPolynomial.eval p), map_mul (MvPolynomial.eval p),
        map_mul (MvPolynomial.eval p), map_mul (MvPolynomial.eval p),
        MvPolynomial.eval_X]
      fin_cases j
      · have h01 : (MvPolynomial.pderiv (1 : Fin 2))
            (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) k) = 0 :=
          MvPolynomial.pderiv_X_of_ne (by decide : (0 : Fin 2) ≠ 1)
        simp only [Fin.zero_eta, Φ, MvPolynomial.aeval_X, Matrix.cons_val_zero,
          TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero,
          TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_add,
          MvPolynomial.pderiv_X_self, h01, map_one, map_zero]
        ring
      · have h10 : (MvPolynomial.pderiv (0 : Fin 2))
            (MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) k) = 0 :=
          MvPolynomial.pderiv_X_of_ne (by decide : (1 : Fin 2) ≠ 0)
        simp only [Fin.mk_one, Φ, MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero,
          TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero,
          TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_add,
          MvPolynomial.pderiv_X_self, h10, map_one, map_zero]
        ring
  have hΦ_hc : ∀ v₀ v₁ : k, Φ v₀ v₁ h_c = 0 := by
    intro v₀ v₁
    apply TrivSqZeroExt.ext
    · rw [hΦ_fst, hp, TrivSqZeroExt.fst_zero]
    · rw [hΦ_snd, hp0, hp1, mul_zero, mul_zero, add_zero, TrivSqZeroExt.snd_zero]
  have hΦ_congr : ∀ (v₀ v₁ : k) {F₁ F₂ : MvPolynomial (Fin 2) k},
      θ F₁ = θ F₂ → Φ v₀ v₁ F₁ = Φ v₀ v₁ F₂ := by
    intro v₀ v₁ F₁ F₂ hθ
    have hmem : F₁ - F₂ ∈ RingHom.ker θ.toRingHom := by
      rw [RingHom.mem_ker]
      change θ (F₁ - F₂) = 0
      rw [map_sub, sub_eq_zero]
      exact hθ
    rw [hKer, Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨K, hK⟩
    have hsub : Φ v₀ v₁ (F₁ - F₂) = 0 := by
      rw [hK, map_mul, hΦ_hc, zero_mul]
    rw [map_sub] at hsub
    exact sub_eq_zero.mp hsub
  have heval_congr : ∀ {F₁ F₂ : MvPolynomial (Fin 2) k},
      θ F₁ = θ F₂ → MvPolynomial.eval p F₁ = MvPolynomial.eval p F₂ := by
    intro F₁ F₂ hθ
    rw [← hΦ_fst 0 0 F₁, ← hΦ_fst 0 0 F₂, hΦ_congr 0 0 hθ]
  let ι := algebraMap (Polynomial k) (RatFunc k)
  have hPc_rf : ι P_c ≠ 0 := RatFunc.algebraMap_ne_zero hPc_ne
  have hS_ex : ∀ i : ℕ, i ≤ d → ∃ G : MvPolynomial (Fin 2) k,
      θ G = ι (Polynomial.X ^ i) / ι P_c := by
    intro i hi
    have hmem : ι (Polynomial.X ^ i) / ι P_c ∈ Set.range θ := by
      rw [hRange]
      refine ⟨1, Polynomial.X ^ i, ?_, ?_⟩
      · rw [Polynomial.natDegree_X_pow, one_mul]
        exact hi
      · rw [pow_one]
    rcases hmem with ⟨G, hG⟩
    exact ⟨G, hG⟩
  let S : ℕ → MvPolynomial (Fin 2) k :=
    fun i => if hi : i ≤ d then Classical.choose (hS_ex i hi) else 0
  have hS : ∀ i : ℕ, i ≤ d → θ (S i) = ι (Polynomial.X ^ i) / ι P_c := by
    intro i hi
    dsimp [S]
    simp only [hi, ↓reduceDIte]
    exact Classical.choose_spec (hS_ex i hi)
  let M : Polynomial k → MvPolynomial (Fin 2) k :=
    fun R => ∑ i ∈ Finset.range (d + 1), MvPolynomial.C (R.coeff i) * S i
  have hθ_M : ∀ R : Polynomial k, R.natDegree ≤ d → θ (M R) = ι R / ι P_c := by
    intro R hR
    have hR_sum : R = ∑ i ∈ Finset.range (d + 1), Polynomial.C (R.coeff i) * Polynomial.X ^ i :=
      Polynomial.as_sum_range_C_mul_X_pow' R (Nat.lt_succ_of_le hR)
    dsimp [M]
    rw [map_sum]
    conv_rhs => rw [hR_sum, map_sum, Finset.sum_div]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi_le : i ≤ d := Nat.le_of_lt_succ (Finset.mem_range.mp hi)
    rw [map_mul, MvPolynomial.aeval_C, hS i hi_le, map_mul,
      IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k),
      Polynomial.algebraMap_eq, ← mul_div_assoc]
  have hθ_MPc : θ (M P_c) = θ 1 := by
    rw [hθ_M P_c hPc_deg, div_self hPc_rf, map_one]
  have hBezout : ∑ i ∈ Finset.range (d + 1), P_c.coeff i * MvPolynomial.eval p (S i) = 1 := by
    have h1 := heval_congr hθ_MPc
    rw [map_one] at h1
    dsimp [M] at h1
    rw [map_sum] at h1
    rw [← h1]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, MvPolynomial.eval_C]
  have hPure : ∀ i ≤ d,
      (MvPolynomial.eval p (S i)) ^ d =
        (MvPolynomial.eval p (S 0)) ^ (d - i) * (MvPolynomial.eval p (S d)) ^ i := by
    intro i hi
    have hθ_eq : θ (S i ^ d) = θ (S 0 ^ (d - i) * S d ^ i) := by
      rw [map_pow, map_mul, map_pow, map_pow,
        hS i hi, hS 0 (Nat.zero_le d), hS d le_rfl,
        pow_zero, map_one, map_pow, map_pow,
        div_pow, div_pow, div_pow, one_pow, div_mul_div_comm, one_mul,
        ← pow_mul, ← pow_mul, ← pow_add, Nat.sub_add_cancel hi, Nat.mul_comm i d]
    have hev := heval_congr hθ_eq
    simpa only [map_pow, map_mul] using hev
  have hDich : MvPolynomial.eval p (S 0) ≠ 0 ∨ MvPolynomial.eval p (S d) ≠ 0 := by
    by_contra hboth
    have hs0 : MvPolynomial.eval p (S 0) = 0 :=
      Classical.not_not.mp fun h0 => hboth (Or.inl h0)
    have hsd : MvPolynomial.eval p (S d) = 0 :=
      Classical.not_not.mp fun hd' => hboth (Or.inr hd')
    have hall : ∀ i ≤ d, MvPolynomial.eval p (S i) = 0 := by
      intro i hi
      have hp_i := hPure i hi
      rw [hs0, hsd] at hp_i
      have hpow0 : (MvPolynomial.eval p (S i)) ^ d = 0 := by
        rcases Nat.eq_zero_or_pos i with rfl | hi_pos
        · rw [Nat.sub_zero, zero_pow (by omega : d ≠ 0), zero_mul] at hp_i
          exact hp_i
        · rw [zero_pow (by omega : i ≠ 0), mul_zero] at hp_i
          exact hp_i
      exact (pow_eq_zero_iff (by omega : d ≠ 0)).mp hpow0
    have hsum0 : ∑ i ∈ Finset.range (d + 1), P_c.coeff i * MvPolynomial.eval p (S i) = 0 := by
      refine Finset.sum_eq_zero fun i hi => ?_
      rw [hall i (Nat.le_of_lt_succ (Finset.mem_range.mp hi)), mul_zero]
    rw [hBezout] at hsum0
    exact one_ne_zero hsum0
  have hLocal : ∃ (G_A G_B : MvPolynomial (Fin 2) k) (e : ℕ → ℕ),
      MvPolynomial.eval p G_A ≠ 0 ∧
      ∀ i ≤ d, θ (G_A ^ e i * S i) = θ (G_A * G_B ^ e i) := by
    rcases hDich with hs0_ne | hsd_ne
    · refine ⟨S 0, S 1, fun i => i, hs0_ne, fun i hi => ?_⟩
      dsimp only []
      rw [map_mul, map_pow, map_mul, map_pow,
        hS 0 (Nat.zero_le d), hS 1 hd, hS i hi,
        pow_zero, pow_one, map_one, map_pow,
        div_pow, div_pow, one_pow,
        div_mul_div_comm, div_mul_div_comm, one_mul,
        ← pow_succ, ← pow_succ']
    · refine ⟨S d, S (d - 1), fun i => d - i, hsd_ne, fun i hi => ?_⟩
      have hexp1 : d * (d - i) + i = d + (d - 1) * (d - i) := by
        have hd1 : (d - 1) + 1 = d := Nat.sub_add_cancel hd
        calc d * (d - i) + i = ((d - 1) + 1) * (d - i) + i := by rw [hd1]
          _ = (d - 1) * (d - i) + 1 * (d - i) + i := by rw [add_mul]
          _ = d + (d - 1) * (d - i) := by omega
      rw [map_mul, map_pow, map_mul, map_pow,
        hS d le_rfl, hS (d - 1) (Nat.sub_le d 1), hS i hi,
        map_pow, map_pow, map_pow,
        div_pow, div_pow, div_mul_div_comm, div_mul_div_comm,
        ← pow_mul, ← pow_mul, ← pow_add, ← pow_add,
        ← pow_succ, ← pow_succ', hexp1]
  rcases hLocal with ⟨G_A, G_B, e, ha₀, hRel⟩
  set a₀ : k := MvPolynomial.eval p G_A
  have ha₀_inv : a₀ * a₀⁻¹ = 1 := mul_inv_cancel₀ ha₀
  let z : k → k → DualNumber k := fun v₀ v₁ => Φ v₀ v₁ G_A
  let z_inv : k → k → DualNumber k := fun v₀ v₁ =>
    TrivSqZeroExt.inl a₀⁻¹ - TrivSqZeroExt.inr (a₀⁻¹ * a₀⁻¹ * (z v₀ v₁).snd)
  have hz_fst : ∀ v₀ v₁ : k, (z v₀ v₁).fst = a₀ := fun v₀ v₁ => hΦ_fst v₀ v₁ G_A
  have hz_mul_inv : ∀ v₀ v₁ : k, z v₀ v₁ * z_inv v₀ v₁ = 1 := by
    intro v₀ v₁
    apply TrivSqZeroExt.ext
    · simp only [z_inv, TrivSqZeroExt.fst_mul, hz_fst, TrivSqZeroExt.fst_sub,
        TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, sub_zero, ha₀_inv, TrivSqZeroExt.fst_one]
    · simp only [z_inv, DualNumber.snd_mul, hz_fst, TrivSqZeroExt.snd_sub,
        TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_sub,
        TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, sub_zero,
        TrivSqZeroExt.snd_one]
      calc a₀ * -(a₀⁻¹ * a₀⁻¹ * (z v₀ v₁).snd) + (z v₀ v₁).snd * a₀⁻¹
          = -(a₀ * a₀⁻¹) * (a₀⁻¹ * (z v₀ v₁).snd) + (z v₀ v₁).snd * a₀⁻¹ := by ring
        _ = -1 * (a₀⁻¹ * (z v₀ v₁).snd) + (z v₀ v₁).snd * a₀⁻¹ := by rw [ha₀_inv]
        _ = 0 := by ring
  let t_tilde : k → k → DualNumber k := fun v₀ v₁ => Φ v₀ v₁ G_B * z_inv v₀ v₁
  have hΦ_S : ∀ (v₀ v₁ : k) (i : ℕ), i ≤ d →
      Φ v₀ v₁ (S i) = z v₀ v₁ * (t_tilde v₀ v₁) ^ e i := by
    intro v₀ v₁ i hi
    have hcongr := hΦ_congr v₀ v₁ (hRel i hi)
    rw [map_mul, map_pow, map_mul, map_pow] at hcongr
    change (z v₀ v₁) ^ e i * Φ v₀ v₁ (S i) = z v₀ v₁ * (Φ v₀ v₁ G_B) ^ e i at hcongr
    calc Φ v₀ v₁ (S i)
        = 1 * Φ v₀ v₁ (S i) := (one_mul _).symm
      _ = (z v₀ v₁ * z_inv v₀ v₁) ^ e i * Φ v₀ v₁ (S i) := by rw [hz_mul_inv, one_pow]
      _ = (z_inv v₀ v₁) ^ e i * ((z v₀ v₁) ^ e i * Φ v₀ v₁ (S i)) := by ring
      _ = (z_inv v₀ v₁) ^ e i * (z v₀ v₁ * (Φ v₀ v₁ G_B) ^ e i) := by rw [hcongr]
      _ = z v₀ v₁ * (Φ v₀ v₁ G_B * z_inv v₀ v₁) ^ e i := by ring
      _ = z v₀ v₁ * (t_tilde v₀ v₁) ^ e i := rfl
  let W : Polynomial k → DualNumber k → DualNumber k :=
    fun R u => ∑ i ∈ Finset.range (d + 1), algebraMap k (DualNumber k) (R.coeff i) * u ^ e i
  have hΦ_M : ∀ (v₀ v₁ : k) (R : Polynomial k),
      Φ v₀ v₁ (M R) = z v₀ v₁ * W R (t_tilde v₀ v₁) := by
    intro v₀ v₁ R
    dsimp [M, W]
    rw [map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi_le : i ≤ d := Nat.le_of_lt_succ (Finset.mem_range.mp hi)
    rw [map_mul, MvPolynomial.aeval_C, hΦ_S v₀ v₁ i hi_le]
    ring
  have hθ_MQ₀ : θ (M Q₀) = θ (MvPolynomial.X 0) := by
    rw [hθ_M Q₀ hQ₀_deg]
    simp [θ, ι]
  have hθ_MQ₁ : θ (M Q₁) = θ (MvPolynomial.X 1) := by
    rw [hθ_M Q₁ hQ₁_deg]
    simp [θ, ι]
  have hEq_Pc : ∀ v₀ v₁ : k, z v₀ v₁ * W P_c (t_tilde v₀ v₁) = 1 := by
    intro v₀ v₁
    rw [← hΦ_M, hΦ_congr v₀ v₁ hθ_MPc, map_one]
  have hEq_Q₀ : ∀ v₀ v₁ : k,
      z v₀ v₁ * W Q₀ (t_tilde v₀ v₁) = TrivSqZeroExt.inl (p 0) + TrivSqZeroExt.inr v₀ := by
    intro v₀ v₁
    rw [← hΦ_M, hΦ_congr v₀ v₁ hθ_MQ₀]
    simp [Φ]
  have hEq_Q₁ : ∀ v₀ v₁ : k,
      z v₀ v₁ * W Q₁ (t_tilde v₀ v₁) = TrivSqZeroExt.inl (p 1) + TrivSqZeroExt.inr v₁ := by
    intro v₀ v₁
    rw [← hΦ_M, hΦ_congr v₀ v₁ hθ_MQ₁]
    simp [Φ]
  have ht_inj : ∀ v₀ v₁ : k, t_tilde v₀ v₁ = t_tilde 0 0 → v₀ = 0 ∧ v₁ = 0 := by
    intro v₀ v₁ ht_eq
    have hz_eq : z v₀ v₁ = z 0 0 := by
      have h1 := hEq_Pc v₀ v₁
      rw [ht_eq] at h1
      have h0 := hEq_Pc 0 0
      calc z v₀ v₁ = z v₀ v₁ * 1 := (mul_one _).symm
        _ = z v₀ v₁ * (z 0 0 * W P_c (t_tilde 0 0)) := by rw [h0]
        _ = z 0 0 * (z v₀ v₁ * W P_c (t_tilde 0 0)) := by ring
        _ = z 0 0 * 1 := by rw [h1]
        _ = z 0 0 := mul_one _
    have hq0 : TrivSqZeroExt.inl (p 0) + TrivSqZeroExt.inr v₀ =
        TrivSqZeroExt.inl (p 0) + (TrivSqZeroExt.inr 0 : DualNumber k) := by
      rw [← hEq_Q₀ v₀ v₁, hz_eq, ht_eq, hEq_Q₀ 0 0]
    have hq1 : TrivSqZeroExt.inl (p 1) + TrivSqZeroExt.inr v₁ =
        TrivSqZeroExt.inl (p 1) + (TrivSqZeroExt.inr 0 : DualNumber k) := by
      rw [← hEq_Q₁ v₀ v₁, hz_eq, ht_eq, hEq_Q₁ 0 0]
    have hv0 : v₀ = 0 := by
      have hs := congrArg TrivSqZeroExt.snd hq0
      simpa using hs
    have hv1 : v₁ = 0 := by
      have hs := congrArg TrivSqZeroExt.snd hq1
      simpa using hs
    exact ⟨hv0, hv1⟩
  let b₀ : k := MvPolynomial.eval p G_B
  let gA0 : k := MvPolynomial.eval p (MvPolynomial.pderiv 0 G_A)
  let gA1 : k := MvPolynomial.eval p (MvPolynomial.pderiv 1 G_A)
  let gB0 : k := MvPolynomial.eval p (MvPolynomial.pderiv 0 G_B)
  let gB1 : k := MvPolynomial.eval p (MvPolynomial.pderiv 1 G_B)
  let c₀ : k := gB0 * a₀⁻¹ - b₀ * (a₀⁻¹ * a₀⁻¹ * gA0)
  let c₁ : k := gB1 * a₀⁻¹ - b₀ * (a₀⁻¹ * a₀⁻¹ * gA1)
  have ht_fst : ∀ v₀ v₁ : k, (t_tilde v₀ v₁).fst = b₀ * a₀⁻¹ := by
    intro v₀ v₁
    simp [t_tilde, z_inv, hΦ_fst, b₀]
  have ht_snd : ∀ v₀ v₁ : k, (t_tilde v₀ v₁).snd = v₀ * c₀ + v₁ * c₁ := by
    intro v₀ v₁
    simp only [t_tilde, z_inv, z, DualNumber.snd_mul, hΦ_fst, hΦ_snd,
      TrivSqZeroExt.snd_sub, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_sub,
      TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, sub_zero,
      b₀, gA0, gA1, gB0, gB1, c₀, c₁]
    ring
  by_cases hc : c₀ = 0 ∧ c₁ = 0
  · have ht10 : t_tilde 1 0 = t_tilde 0 0 := by
      apply TrivSqZeroExt.ext
      · rw [ht_fst, ht_fst]
      · rw [ht_snd, ht_snd, hc.1, hc.2]
        ring
    exact one_ne_zero (ht_inj 1 0 ht10).1
  · have htc : t_tilde c₁ (-c₀) = t_tilde 0 0 := by
      apply TrivSqZeroExt.ext
      · rw [ht_fst, ht_fst]
      · rw [ht_snd, ht_snd]
        ring
    rcases ht_inj c₁ (-c₀) htc with ⟨hc₁_zero, hnc₀_zero⟩
    exact hc ⟨neg_eq_zero.mp hnc₀_zero, hc₁_zero⟩

theorem weil_p2_ratfunc_closed_imm_and_gauss_homog (k : Type u) [Field k] [IsAlgClosed k] :
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    (∀ (P_ideal : Ideal (MvPolynomial (Fin 2) k)) [P_ideal.IsPrime],
      P_ideal ≠ ⊥ →
      (∃ p₁ p₂ : Fin 2 → k,
        p₁ ≠ p₂ ∧
        P_ideal ≤ RingHom.ker (MvPolynomial.eval p₁) ∧
        P_ideal ≤ RingHom.ker (MvPolynomial.eval p₂)) →
      ∃ (d : ℕ) (G_hom : MvPolynomial (Fin 3) k),
        1 ≤ d ∧
        G_hom.IsHomogeneous d ∧
        Irreducible G_hom ∧
        Irreducible (eval_c 0 G_hom) ∧
        P_ideal = Ideal.span {eval_c 0 G_hom} ∧
        MvPolynomial.X 0 ∉ Ideal.span {G_hom}) ∧
    (∀ (P₀ P₁ P₂ : Polynomial k),
      P₀.Monic →
      1 ≤ P₀.natDegree →
      P₁.natDegree ≤ P₀.natDegree →
      P₂.natDegree ≤ P₀.natDegree →
      (∀ b : k, P₀.eval b = 0 → P₁.eval b ≠ 0 ∨ P₂.eval b ≠ 0) →
      (∀ c : Fin 3,
        ![P₀, P₁, P₂] c ≠ 0 →
        let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
          MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
        Set.range θ_c =
          { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
              Q.natDegree ≤ n * P₀.natDegree ∧
              f = algebraMap (Polynomial k) (RatFunc k) Q /
                (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n }) →
      let d_Sigma := P₀.natDegree
      ∃ H_Sigma : MvPolynomial (Fin 3) k,
        H_Sigma.IsHomogeneous d_Sigma ∧
        Irreducible H_Sigma ∧
        Irreducible (eval_c 0 H_Sigma) ∧
        MvPolynomial.X 0 ∉ Ideal.span {H_Sigma} ∧
        MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] H_Sigma = 0 ∧
        (∀ (c : Fin 3) (p : Fin 2 → k),
          MvPolynomial.eval p (eval_c c H_Sigma) = 0 →
          MvPolynomial.eval p (MvPolynomial.pderiv 0 (eval_c c H_Sigma)) ≠ 0 ∨
          MvPolynomial.eval p (MvPolynomial.pderiv 1 (eval_c c H_Sigma)) ≠ 0) ∧
        (∀ c : Fin 3,
          (![P₀, P₁, P₂] c = 0 ∧ IsUnit (eval_c c H_Sigma)) ∨
          (![P₀, P₁, P₂] c ≠ 0 ∧
            let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
              MvPolynomial.aeval (fun j : Fin 2 =>
                algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
                algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
            RingHom.ker θ_c.toRingHom = Ideal.span {eval_c c H_Sigma} ∧
            Set.range θ_c =
              { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                  Q.natDegree ≤ n * d_Sigma ∧
                  f = algebraMap (Polynomial k) (RatFunc k) Q /
                    (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n }))) :=
by
  intro eval_c
  refine ⟨?_, ?_⟩
  · intro P_ideal hP_prime hP_ne_bot hPts
    obtain ⟨f₀, hf₀_irr, hP_eq⟩ :=
      (weil_p2_rf_biv_prime_principal k P_ideal hP_ne_bot).2 hPts
    obtain ⟨hd_pos, G_hom, hG_hom, hG_irr, heval0, hX0_not⟩ :=
      (weil_p2_rf_homog_chart_bijection k).1 f₀ hf₀_irr
    change eval_c 0 G_hom = f₀ at heval0
    refine ⟨f₀.totalDegree, G_hom, hd_pos, hG_hom, hG_irr, ?_, ?_, hX0_not⟩
    · rwa [heval0]
    · rwa [heval0]
  · intro P₀ P₁ P₂ hP₀_monic hd_pos hP₁_deg hP₂_deg hCoprime hRange d_Sigma
    let θ_all : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 =>
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
    have hP₀_ne0 : ![P₀, P₁, P₂] 0 ≠ 0 := hP₀_monic.ne_zero
    have hRange0 : Set.range (θ_all 0) =
        { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
            Q.natDegree ≤ n * d_Sigma ∧
            f = algebraMap (Polynomial k) (RatFunc k) Q /
              (algebraMap (Polynomial k) (RatFunc k) P₀) ^ n } :=
      hRange 0 hP₀_ne0
    obtain ⟨hS4_0, hS4_pole, hS4_tr⟩ :=
      weil_p2_rf_kernel_and_gauss_degree_eq k P₀ P₁ P₂ hP₀_monic hd_pos hP₁_deg hP₂_deg hCoprime
    obtain ⟨⟨hker0_ne, hPts0⟩, hGaussDeg⟩ := hS4_0 hRange0
    have : (RingHom.ker (θ_all 0).toRingHom).IsPrime := RingHom.ker_isPrime _
    obtain ⟨h₀, hh₀_irr, hker0_eq⟩ :=
      (weil_p2_rf_biv_prime_principal k (RingHom.ker (θ_all 0).toRingHom) hker0_ne).2 hPts0
    have hh₀_deg : h₀.totalDegree = d_Sigma := hGaussDeg h₀ hh₀_irr hker0_eq
    obtain ⟨_, H_Sigma, hH_hom_raw, hH_irr, heval0_H, hX0_not_H⟩ :=
      (weil_p2_rf_homog_chart_bijection k).1 h₀ hh₀_irr
    change eval_c 0 H_Sigma = h₀ at heval0_H
    have hH_hom : H_Sigma.IsHomogeneous d_Sigma := hh₀_deg ▸ hH_hom_raw
    obtain ⟨hHomDich, hHomClear⟩ :=
      (weil_p2_rf_homog_chart_bijection k).2 d_Sigma H_Sigma hd_pos hH_hom hH_irr
    have hθ0_H : (θ_all 0) (eval_c 0 H_Sigma) = 0 := by
      rw [heval0_H]
      change h₀ ∈ RingHom.ker (θ_all 0).toRingHom
      rw [hker0_eq]
      exact Ideal.mem_span_singleton_self h₀
    have hEvalP : MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] H_Sigma = 0 := by
      have hClear0 : (θ_all 0) (eval_c 0 H_Sigma) *
          (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] 0)) ^ d_Sigma =
        algebraMap (Polynomial k) (RatFunc k)
          (MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] H_Sigma) :=
        hHomClear P₀ P₁ P₂ 0 hP₀_ne0
      rw [hθ0_H, zero_mul] at hClear0
      exact IsFractionRing.injective (Polynomial k) (RatFunc k)
        (hClear0.symm.trans (map_zero _).symm)
    have hC7 : ∀ c : Fin 3,
        (![P₀, P₁, P₂] c = 0 ∧ IsUnit (eval_c c H_Sigma)) ∨
        (![P₀, P₁, P₂] c ≠ 0 ∧
          RingHom.ker (θ_all c).toRingHom = Ideal.span {eval_c c H_Sigma} ∧
          Set.range (θ_all c) =
            { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                Q.natDegree ≤ n * d_Sigma ∧
                f = algebraMap (Polynomial k) (RatFunc k) Q /
                  (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n }) := by
      intro c
      by_cases hPc : ![P₀, P₁, P₂] c = 0
      · left
        refine ⟨hPc, ?_⟩
        have hXc_dvd : MvPolynomial.X c ∣ H_Sigma :=
          hS4_pole d_Sigma H_Sigma c hd_pos hH_hom hEvalP hPc
        obtain ⟨μ, hμ_ne, _, heval_c_eq⟩ := (hHomDich c).1 hXc_dvd
        change eval_c c H_Sigma = MvPolynomial.C μ at heval_c_eq
        rw [heval_c_eq]
        exact (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k).isUnit_map
          (isUnit_iff_ne_zero.mpr hμ_ne)
      · right
        refine ⟨hPc, ?_, hRange c hPc⟩
        have hXc_ndvd : ¬ MvPolynomial.X c ∣ H_Sigma := by
          intro hdvd
          obtain ⟨μ, hμ_ne, hH_lin, _⟩ := (hHomDich c).1 hdvd
          have h0 : MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] H_Sigma =
              Polynomial.C μ * (![P₀, P₁, P₂] c) := by
            rw [hH_lin, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
          rw [hEvalP] at h0
          exact mul_ne_zero (Polynomial.C_ne_zero.mpr hμ_ne) hPc h0.symm
        have hhc_irr : Irreducible (eval_c c H_Sigma) := (hHomDich c).2 hXc_ndvd
        have hhc_ker : eval_c c H_Sigma ∈ RingHom.ker (θ_all c).toRingHom := by
          change (θ_all c) (eval_c c H_Sigma) = 0
          have hClear_c : (θ_all c) (eval_c c H_Sigma) *
              (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ d_Sigma =
            algebraMap (Polynomial k) (RatFunc k)
              (MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] H_Sigma) :=
            hHomClear P₀ P₁ P₂ c hPc
          rw [hEvalP, map_zero] at hClear_c
          have hPc_rf_ne : (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ d_Sigma ≠ 0 :=
            pow_ne_zero d_Sigma (RatFunc.algebraMap_ne_zero hPc)
          exact (mul_eq_zero.mp hClear_c).resolve_right hPc_rf_ne
        have hker_c_ne : RingHom.ker (θ_all c).toRingHom ≠ ⊥ := by
          intro hbot
          rw [hbot, Ideal.mem_bot] at hhc_ker
          exact hhc_irr.ne_zero hhc_ker
        have : (RingHom.ker (θ_all c).toRingHom).IsPrime := RingHom.ker_isPrime _
        obtain ⟨f_c, hf_c_irr, hker_c_eq⟩ :=
          (weil_p2_rf_biv_prime_principal k (RingHom.ker (θ_all c).toRingHom) hker_c_ne).1
            (hS4_tr c hPc (hRange c hPc))
        have hhc_span : eval_c c H_Sigma ∈ Ideal.span {f_c} := by
          rwa [← hker_c_eq]
        obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hhc_span
        have hu_unit : IsUnit u :=
          (hhc_irr.isUnit_or_isUnit hu_eq).resolve_left hf_c_irr.not_isUnit
        rw [hker_c_eq, hu_eq, Ideal.span_singleton_mul_right_unit hu_unit]
    have hDegAll : ∀ i : Fin 3, (![P₀, P₁, P₂] i).natDegree ≤ d_Sigma := by
      intro i
      fin_cases i
      · exact le_rfl
      · exact hP₁_deg
      · exact hP₂_deg
    have hC6 : ∀ (c : Fin 3) (p : Fin 2 → k),
        MvPolynomial.eval p (eval_c c H_Sigma) = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 (eval_c c H_Sigma)) ≠ 0 ∨
        MvPolynomial.eval p (MvPolynomial.pderiv 1 (eval_c c H_Sigma)) ≠ 0 := by
      intro c p hp0
      rcases hC7 c with ⟨_, hUnit⟩ | ⟨hPc, hker_c, hRange_c⟩
      · exfalso
        have h0_unit : IsUnit (MvPolynomial.eval p (eval_c c H_Sigma)) :=
          (MvPolynomial.eval p).isUnit_map hUnit
        rw [hp0] at h0_unit
        exact not_isUnit_zero h0_unit
      · let θ_mat : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
          MvPolynomial.aeval
            ![algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove 0)) /
                algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c),
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove 1)) /
                algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)]
        have hθ_eq : θ_all c = θ_mat := by
          apply MvPolynomial.algHom_ext
          intro j
          fin_cases j <;> simp [θ_all, θ_mat]
        rw [hθ_eq] at hker_c hRange_c
        exact weil_p2_rf_bezout_dualNumber_smoothness k d_Sigma hd_pos
          (![P₀, P₁, P₂] c) (![P₀, P₁, P₂] (c.succAbove 0)) (![P₀, P₁, P₂] (c.succAbove 1))
          hPc (hDegAll c) (hDegAll (c.succAbove 0)) (hDegAll (c.succAbove 1))
          (eval_c c H_Sigma) p hker_c hRange_c hp0
    exact ⟨H_Sigma, hH_hom, hH_irr, heval0_H.symm ▸ hh₀_irr, hX0_not_H, hEvalP, hC6, hC7⟩

theorem weil_p2_std_charts_gl3_aut_and_hypersurface_closure (k : Type u) [Field k] [IsAlgClosed k] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∃ j_chart : Fin 3 →
        (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
          (weilProjectiveSpaceOver k 2).left),
      (∀ c : Fin 3,
        AlgebraicGeometry.IsOpenImmersion (j_chart c) ∧
        j_chart c ≫ (weilProjectiveSpaceOver k 2).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
        (∀ c' : Fin 3,
          (j_chart c).base ⁻¹' Set.range (j_chart c').base =
            { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
              eval_c c (MvPolynomial.X c') ∉ p.asIdeal }) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K₂ c).toRingHom) ≫ j_chart c =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K₂ 0).toRingHom) ≫ j_chart 0) ∧
      ((⋃ c : Fin 3, Set.range (j_chart c).base) = Set.univ ∧
        ∀ (c : Fin 3) (Ω : Type u) [Field Ω] (ψ : MvPolynomial (Fin 2) k →+* Ω),
          let hom_ψ : Fin 3 → Ω := ![1, ψ (MvPolynomial.X 0), ψ (MvPolynomial.X 1)]
          hom_ψ c ≠ 0 →
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.eval₂Hom (ψ.comp MvPolynomial.C)
                (fun j : Fin 2 => hom_ψ (c.succAbove j) / hom_ψ c))) ≫
            j_chart c =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ j_chart 0) ∧
      (∀ (n_pts : ℕ)
          (s_pt : Fin n_pts →
            (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 2).left))
          (s_dist : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 2).left),
        (∀ i : Fin n_pts, s_pt i ≫ (weilProjectiveSpaceOver k 2).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) →
        s_dist ≫ (weilProjectiveSpaceOver k 2).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        ∃ Φ : (weilProjectiveSpaceOver k 2).left ≅ (weilProjectiveSpaceOver k 2).left,
          Φ.hom ≫ (weilProjectiveSpaceOver k 2).hom = (weilProjectiveSpaceOver k 2).hom ∧
          Φ.inv ≫ (weilProjectiveSpaceOver k 2).hom = (weilProjectiveSpaceOver k 2).hom ∧
          (∀ (i : Fin n_pts) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
            (s_pt i ≫ Φ.inv).base pt ∈ Set.range (j_chart 0).base) ∧
          (∀ (c : Fin 3) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
            (s_dist ≫ Φ.inv).base pt ∈ Set.range (j_chart c).base)) ∧
      (∀ (Z : Set (weilProjectiveSpaceOver k 2).left) (d : ℕ) (G : MvPolynomial (Fin 3) k),
        IsClosed Z → IsIrreducible Z → 1 ≤ d → G.IsHomogeneous d → Irreducible G →
        MvPolynomial.X 0 ∉ Ideal.span {G} →
        (j_chart 0).base ⁻¹' Z =
          { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
            eval_c 0 G ∈ p.asIdeal } →
        ∀ c : Fin 3,
          (j_chart c).base ⁻¹' Z =
            { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
              eval_c c G ∈ p.asIdeal }) :=
by
  classical
  intro K₂ x₁ x₂ homCoord eval_c φ_K₂
  let P := MvPolynomial (Fin 3) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let π_proj : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
  have hX : ∀ r : Fin 3, (MvPolynomial.X r : P) ∈ 𝒜 1 :=
    fun r => MvPolynomial.isHomogeneous_X k r
  let valHom : ∀ M : Submonoid P, HomogeneousLocalization 𝒜 M →+* Localization M :=
    fun M =>
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
  have h_val_fromZero : ∀ (M : Submonoid P) (a : k),
      ((HomogeneousLocalization.fromZeroRingHom 𝒜 M) (algebraMap k ↥(𝒜 0) a)).val =
        Localization.mk (MvPolynomial.C a) 1 := by
    intro M a
    rfl
  have h_val_isLocElem : ∀ {d : ℕ} (c : Fin 3) {G : P} (hG : G ∈ 𝒜 d),
      (HomogeneousLocalization.Away.isLocalizationElem (hX c) hG).val =
        Localization.mk (G ^ 1) ⟨(MvPolynomial.X c : P) ^ d, pow_mem (Submonoid.mem_powers _) d⟩ := by
    intro d c G hG
    rfl

  
  
  
  let α_c : ∀ c : Fin 3, MvPolynomial (Fin 2) k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c) :=
    fun c => MvPolynomial.eval₂Hom
      ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X c))).comp
        (algebraMap k ↥(𝒜 0)))
      (fun j : Fin 2 =>
        HomogeneousLocalization.Away.mk 𝒜 (hX c) 1 (MvPolynomial.X (c.succAbove j))
          (by simpa [one_smul] using hX (c.succAbove j)))
  let ev_rh : Fin 3 → (P →+* MvPolynomial (Fin 2) k) :=
    fun c => MvPolynomial.eval₂Hom MvPolynomial.C (Fin.succAboveCases c 1 MvPolynomial.X)
  have hev_rh_eq : ∀ (c : Fin 3) (p : P), ev_rh c p = eval_c c p := by
    intro c p
    rfl
  have hEval_self : ∀ c : Fin 3, eval_c c (MvPolynomial.X c) = 1 := by
    intro c
    simp [eval_c, Fin.succAboveCases]
  have hEval_succAbove : ∀ (c : Fin 3) (j : Fin 2),
      eval_c c (MvPolynomial.X (c.succAbove j)) = MvPolynomial.X j := by
    intro c j
    fin_cases c <;> fin_cases j <;> simp [eval_c, Fin.succAboveCases] <;> congr 1
  have hEval_powers_eq_one : ∀ (c : Fin 3) (m : Submonoid.powers (MvPolynomial.X c : P)),
      ev_rh c m.1 = 1 := by
    intro c ⟨_, n, rfl⟩
    rw [map_pow, hev_rh_eq, hEval_self, one_pow]
  have hUnit_c : ∀ (c : Fin 3) (m : Submonoid.powers (MvPolynomial.X c : P)),
      IsUnit (ev_rh c m.1) := by
    intro c m
    rw [hEval_powers_eq_one c m]
    exact isUnit_one
  let β_loc : ∀ c : Fin 3, Localization (Submonoid.powers (MvPolynomial.X c : P)) →+* MvPolynomial (Fin 2) k :=
    fun c => IsLocalization.lift (M := Submonoid.powers (MvPolynomial.X c : P)) (hUnit_c c)
  have hβ_loc_mk : ∀ (c : Fin 3) (p : P) (m : Submonoid.powers (MvPolynomial.X c : P)),
      β_loc c (Localization.mk p m) = eval_c c p := by
    intro c p m
    dsimp [β_loc]
    rw [Localization.mk_eq_mk']
    refine (IsLocalization.lift_mk'_spec (S := Localization (Submonoid.powers (MvPolynomial.X c : P)))
      (hUnit_c c) p (eval_c c p) m).mpr ?_
    rw [hEval_powers_eq_one c m, one_mul, hev_rh_eq]
  let β_c : ∀ c : Fin 3, HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c) →+* MvPolynomial (Fin 2) k :=
    fun c => (β_loc c).comp (valHom (Submonoid.powers (MvPolynomial.X c : P)))

  have h_left_inv : ∀ (c : Fin 3) (q : MvPolynomial (Fin 2) k), β_c c (α_c c q) = q := by
    intro c q
    have hcomp : (β_c c).comp (α_c c) = RingHom.id (MvPolynomial (Fin 2) k) := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        simp only [RingHom.comp_apply, RingHom.id_apply, α_c, MvPolynomial.eval₂Hom_C]
        change β_loc c (((HomogeneousLocalization.fromZeroRingHom 𝒜 _) (algebraMap k ↥(𝒜 0) a)).val) =
          MvPolynomial.C a
        rw [h_val_fromZero, hβ_loc_mk]
        simp [eval_c]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply, α_c, MvPolynomial.eval₂Hom_X']
        change β_loc c (HomogeneousLocalization.Away.mk 𝒜 (hX c) 1 (MvPolynomial.X (c.succAbove j)) _).val =
          MvPolynomial.X j
        rw [HomogeneousLocalization.Away.val_mk, hβ_loc_mk, hEval_succAbove]
    exact RingHom.congr_fun hcomp q

  have h_homog_reconstruct : ∀ (c : Fin 3) (n : ℕ) (Q : P),
      Q ∈ 𝒜 n →
      (α_c c (eval_c c Q)).val =
        Localization.mk Q ⟨(MvPolynomial.X c : P) ^ n, pow_mem (Submonoid.mem_powers _) n⟩ := by
    intro c
    let φ : P →+* Localization (Submonoid.powers (MvPolynomial.X c : P)) :=
      ((valHom (Submonoid.powers (MvPolynomial.X c : P))).comp (α_c c)).comp (ev_rh c)
    have hφ_C : ∀ a : k, φ (MvPolynomial.C a) = Localization.mk (MvPolynomial.C a) 1 := by
      intro a
      dsimp only [φ, RingHom.comp_apply, ev_rh, α_c]
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      exact h_val_fromZero _ a
    have hφ_X : ∀ i : Fin 3, φ (MvPolynomial.X i) =
        Localization.mk (MvPolynomial.X i) ⟨MvPolynomial.X c, Submonoid.mem_powers _⟩ := by
      intro i
      dsimp only [φ, RingHom.comp_apply]
      rw [hev_rh_eq]
      rcases Fin.eq_self_or_eq_succAbove c i with hci | ⟨j, rfl⟩
      · rw [hci, hEval_self c, map_one, map_one]
        exact (Localization.mk_self (⟨MvPolynomial.X c, Submonoid.mem_powers _⟩ :
          Submonoid.powers (MvPolynomial.X c : P))).symm
      · rw [hEval_succAbove c j]
        dsimp only [α_c]
        rw [MvPolynomial.eval₂Hom_X']
        change (HomogeneousLocalization.Away.mk 𝒜 (hX c) 1 (MvPolynomial.X (c.succAbove j)) _).val = _
        rw [HomogeneousLocalization.Away.val_mk]
        congr 1
        apply Subtype.ext
        exact pow_one _
    have hφ_X_pow : ∀ (i : Fin 3) (e : ℕ), φ (MvPolynomial.X i ^ e) =
        Localization.mk (MvPolynomial.X i ^ e)
          ⟨(MvPolynomial.X c : P) ^ e, pow_mem (Submonoid.mem_powers _) e⟩ := by
      intro i e
      induction e with
      | zero =>
        simp only [pow_zero, map_one]
        rw [← Localization.mk_one]
        congr 1
      | succ e ihe =>
        rw [pow_succ, map_mul, ihe, hφ_X, Localization.mk_mul]
        congr 1
    have hφ_prod : ∀ (S : Finset (Fin 3)) (s : Fin 3 →₀ ℕ),
        φ (∏ i ∈ S, (MvPolynomial.X i : P) ^ s i) =
          Localization.mk (∏ i ∈ S, (MvPolynomial.X i : P) ^ s i)
            ⟨(MvPolynomial.X c : P) ^ (∑ i ∈ S, s i),
              pow_mem (Submonoid.mem_powers _) (∑ i ∈ S, s i)⟩ := by
      intro S s
      induction S using Finset.induction_on with
      | empty =>
        simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
        rw [← Localization.mk_one]
        congr 1
      | @insert i S hi ihS =>
        rw [Finset.prod_insert hi, Finset.sum_insert hi, map_mul, hφ_X_pow, ihS, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        exact (pow_add (MvPolynomial.X c : P) (s i) (∑ j ∈ S, s j)).symm
    have h_sum_mk : ∀ (T : Finset (Fin 3 →₀ ℕ)) (f : (Fin 3 →₀ ℕ) → P)
        (d_sub : Submonoid.powers (MvPolynomial.X c : P)),
        (∑ s ∈ T, Localization.mk (f s) d_sub) = Localization.mk (∑ s ∈ T, f s) d_sub := by
      intro T f d_sub
      induction T using Finset.induction_on with
      | empty => simp [Localization.mk_zero]
      | @insert s T hs ihT =>
        rw [Finset.sum_insert hs, Finset.sum_insert hs, ihT, Localization.add_mk_self]
    intro n Q hQ
    change φ Q = _
    conv_lhs => rw [MvPolynomial.as_sum Q]
    rw [map_sum]
    have h_terms : ∀ s ∈ Q.support,
        φ (MvPolynomial.monomial s (Q.coeff s)) =
          Localization.mk (MvPolynomial.monomial s (Q.coeff s))
            ⟨(MvPolynomial.X c : P) ^ n, pow_mem (Submonoid.mem_powers _) n⟩ := by
      intro s hs
      have hdeg_s : (∑ i ∈ s.support, s i) = n := by
        have hw := hQ (MvPolynomial.mem_support_iff.mp hs)
        simpa [Finsupp.weight_apply, Finsupp.sum] using hw
      rw [MvPolynomial.monomial_eq, map_mul, hφ_C]
      change Localization.mk (MvPolynomial.C (Q.coeff s)) 1 *
        φ (∏ i ∈ s.support, (MvPolynomial.X i : P) ^ s i) = _
      rw [hφ_prod, Localization.mk_mul]
      congr 1
      apply Subtype.ext
      change (1 : P) * (MvPolynomial.X c : P) ^ (∑ i ∈ s.support, s i) = (MvPolynomial.X c : P) ^ n
      rw [one_mul, hdeg_s]
    rw [Finset.sum_congr rfl h_terms, h_sum_mk, ← MvPolynomial.as_sum Q]

  have h_right_inv : ∀ (c : Fin 3) (z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c)),
      α_c c (β_c c z) = z := by
    intro c z
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX c) z
    have ha' : a ∈ 𝒜 n := by simpa [Nat.smul_one_eq_cast] using ha
    apply HomogeneousLocalization.val_injective
    have hz_val : (HomogeneousLocalization.Away.mk 𝒜 (hX c) n a ha).val =
        Localization.mk a ⟨(MvPolynomial.X c : P) ^ n, pow_mem (Submonoid.mem_powers _) n⟩ := by
      rw [HomogeneousLocalization.Away.val_mk]
    have hβ_z : β_c c (HomogeneousLocalization.Away.mk 𝒜 (hX c) n a ha) = eval_c c a := by
      change β_loc c (HomogeneousLocalization.Away.mk 𝒜 (hX c) n a ha).val = eval_c c a
      rw [hz_val, hβ_loc_mk]
    rw [hβ_z, h_homog_reconstruct c n a ha', hz_val]

  let iso_Spec : ∀ c : Fin 3,
      AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c))) :=
    fun c =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_c c))
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_c c))
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : (β_c c).comp (α_c c) = RingHom.id _ := RingHom.ext (h_left_inv c)
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id (CommRingCat.of (MvPolynomial (Fin 2) k))
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : (α_c c).comp (β_c c) = RingHom.id _ := RingHom.ext (h_right_inv c)
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c))) }

  let j_proj : Fin 3 →
      (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶ AlgebraicGeometry.Proj 𝒜) :=
    fun c =>
      (iso_Spec c).hom ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X c) (hX c) Nat.zero_lt_one

  have hj_open : ∀ c : Fin 3, AlgebraicGeometry.IsOpenImmersion (j_proj c) := by
    intro c
    have _ : CategoryTheory.IsIso (iso_Spec c).hom :=
      ⟨⟨(iso_Spec c).inv, (iso_Spec c).hom_inv_id, (iso_Spec c).inv_hom_id⟩⟩
    exact AlgebraicGeometry.IsOpenImmersion.comp (iso_Spec c).hom
      (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X c) (hX c) Nat.zero_lt_one)

  have hj_hom : ∀ c : Fin 3,
      j_proj c ≫ π_proj = AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
    intro c
    dsimp [j_proj, iso_Spec, π_proj]
    rw [Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro a
    simp only [RingHom.comp_apply]
    change β_loc c (((HomogeneousLocalization.fromZeroRingHom 𝒜 _) (algebraMap k ↥(𝒜 0) a)).val) =
      MvPolynomial.C a
    rw [h_val_fromZero, hβ_loc_mk]
    simp [eval_c]

  have hj_range : ∀ c : Fin 3,
      Set.range (j_proj c).base =
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X c) : Set (AlgebraicGeometry.Proj 𝒜)) := by
    intro c
    dsimp [j_proj]
    have hsurj : Function.Surjective (iso_Spec c).hom.base := by
      intro x
      refine ⟨(iso_Spec c).inv.base x, ?_⟩
      change (((iso_Spec c).inv ≫ (iso_Spec c).hom).base) x = x
      rw [(iso_Spec c).inv_hom_id]
      rfl
    change Set.range ((AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X c) (hX c) Nat.zero_lt_one).base ∘
      (iso_Spec c).hom.base) = _
    rw [Set.range_comp, hsurj.range_eq, Set.image_univ]
    change ((AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X c) (hX c) Nat.zero_lt_one).opensRange :
      Set (AlgebraicGeometry.Proj 𝒜)) = _
    rw [AlgebraicGeometry.Proj.opensRange_awayι]

  have hj_pre_basicOpen : ∀ (c : Fin 3) (d : ℕ) (G : P),
      1 ≤ d → G.IsHomogeneous d →
      (j_proj c).base ⁻¹'
        (AlgebraicGeometry.Proj.basicOpen 𝒜 G : Set (AlgebraicGeometry.Proj 𝒜)) =
        { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
          eval_c c G ∉ p.asIdeal } := by
    intro c d G hd hG
    have hd_pos : 0 < d := hd
    have hG' : G ∈ 𝒜 d := hG
    have h_open_eq :
        (TopologicalSpace.Opens.map (j_proj c).base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 G) =
          PrimeSpectrum.basicOpen (eval_c c G) := by
      dsimp [j_proj, iso_Spec]
      have h1 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX c) Nat.zero_lt_one hG' hd_pos
      have h2 := AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom (β_c c))
        (HomogeneousLocalization.Away.isLocalizationElem (hX c) hG')
      have helem : (CommRingCat.ofHom (β_c c)).hom
          (HomogeneousLocalization.Away.isLocalizationElem (hX c) hG') = eval_c c G := by
        change β_loc c (HomogeneousLocalization.Away.isLocalizationElem (hX c) hG').val = eval_c c G
        rw [h_val_isLocElem, hβ_loc_mk, pow_one]
      rw [helem] at h2
      change (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_c c))).base).obj
        ((TopologicalSpace.Opens.map
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X c) (hX c) Nat.zero_lt_one).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 G)) = _
      rw [h1, h2]
    exact congrArg SetLike.coe h_open_eq

  have h_cov_basicOpen :
      (⨆ c : Fin 3, AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X c)) = ⊤ := by
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X
    intro f hf
    have hproj0 : GradedRing.proj 𝒜 0 f = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff 𝒜 f).mp hf
    have hf_coeff0 : f.coeff 0 = 0 := by
      have hsum : f = ∑ i ∈ (DirectSum.decompose 𝒜 f).support, ((DirectSum.decompose 𝒜 f) i : P) :=
        (DirectSum.sum_support_decompose 𝒜 f).symm
      have h0 : f.coeff 0 =
          ∑ i ∈ (DirectSum.decompose 𝒜 f).support, ((DirectSum.decompose 𝒜 f) i : P).coeff 0 := by
        conv_lhs => rw [hsum]
        exact map_sum (MvPolynomial.coeffAddMonoidHom 0) _ _
      rw [h0]
      apply Finset.sum_eq_zero
      intro i _
      rcases Nat.eq_zero_or_pos i with rfl | hi_pos
      · change (GradedRing.proj 𝒜 0 f).coeff 0 = 0
        rw [hproj0]
        rfl
      · have hhom : ((DirectSum.decompose 𝒜 f) i : P).IsHomogeneous i := ((DirectSum.decompose 𝒜 f) i).2
        by_contra hne
        have hw := hhom hne
        simp [Finsupp.weight_apply] at hw
        omega
    rw [MvPolynomial.as_sum f]
    apply Ideal.sum_mem
    intro s hs
    have hs_ne : s ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hs) hf_coeff0
    have hex_c : ∃ c : Fin 3, s c ≠ 0 := by
      by_contra hall
      exact hs_ne (Finsupp.ext fun c => Classical.not_not.mp fun hc => hall ⟨c, hc⟩)
    obtain ⟨c, hc_ne⟩ := hex_c
    have hc_mem : c ∈ s.support := Finsupp.mem_support_iff.mpr hc_ne
    have hdvd1 : (MvPolynomial.X c : P) ∣ (MvPolynomial.X c : P) ^ s c := dvd_pow_self _ hc_ne
    have hdvd2 : (MvPolynomial.X c : P) ^ s c ∣ ∏ i ∈ s.support, (MvPolynomial.X i : P) ^ s i :=
      Finset.dvd_prod_of_mem (fun i => (MvPolynomial.X i : P) ^ s i) hc_mem
    obtain ⟨q, hq⟩ := dvd_trans hdvd1 hdvd2
    rw [MvPolynomial.monomial_eq]
    change MvPolynomial.C (f.coeff s) * (∏ i ∈ s.support, (MvPolynomial.X i : P) ^ s i) ∈ _
    rw [hq, ← mul_assoc]
    exact Ideal.mul_mem_right q _ (Ideal.mul_mem_left _ (MvPolynomial.C (f.coeff s))
      (Ideal.subset_span ⟨c, rfl⟩))

  have hj_cov : (⋃ c : Fin 3, Set.range (j_proj c).base) = Set.univ := by
    have h1 : (⋃ c : Fin 3, Set.range (j_proj c).base) =
        ⋃ c : Fin 3, (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X c) :
          Set (AlgebraicGeometry.Proj 𝒜)) :=
      Set.iUnion_congr hj_range
    rw [h1]
    exact (TopologicalSpace.IsOpenCover.mk h_cov_basicOpen).iSup_set_eq_univ

  
  
  
  have hTrans : ∀ (c : Fin 3) (Ω : Type u) [Field Ω] (ψ : MvPolynomial (Fin 2) k →+* Ω),
      let hom_ψ : Fin 3 → Ω := ![1, ψ (MvPolynomial.X 0), ψ (MvPolynomial.X 1)]
      hom_ψ c ≠ 0 →
      AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.eval₂Hom (ψ.comp MvPolynomial.C)
            (fun j : Fin 2 => hom_ψ (c.succAbove j) / hom_ψ c))) ≫
        j_proj c =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ j_proj 0 := by
    intro c Ω _ ψ hom_ψ hc_ne
    let f₀c : P := MvPolynomial.X 0 * MvPolynomial.X c
    let ν : P →+* Ω := MvPolynomial.eval₂Hom (ψ.comp MvPolynomial.C) hom_ψ
    have hν_f₀c : ν f₀c = hom_ψ c := by
      dsimp only [ν, f₀c]
      rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      have h0 : hom_ψ 0 = 1 := rfl
      rw [h0, one_mul]
    have hUnit_ν : ∀ m : Submonoid.powers f₀c, IsUnit (ν m.1) := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow, hν_f₀c]
      exact IsUnit.mk0 _ (pow_ne_zero n hc_ne)
    let ρ_loc : Localization (Submonoid.powers f₀c) →+* Ω :=
      IsLocalization.lift (M := Submonoid.powers f₀c) hUnit_ν
    let ρ₀c : HomogeneousLocalization.Away 𝒜 f₀c →+* Ω :=
      ρ_loc.comp (valHom (Submonoid.powers f₀c))
    let away₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) →+*
        HomogeneousLocalization.Away 𝒜 f₀c :=
      HomogeneousLocalization.awayMap 𝒜 (hX c) (rfl : f₀c = MvPolynomial.X 0 * MvPolynomial.X c)
    let away_c : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c) →+*
        HomogeneousLocalization.Away 𝒜 f₀c :=
      HomogeneousLocalization.awayMap 𝒜 (hX 0)
        (mul_comm (MvPolynomial.X 0) (MvPolynomial.X c) : f₀c = MvPolynomial.X c * MvPolynomial.X 0)
    let ψ_trans : MvPolynomial (Fin 2) k →+* Ω :=
      MvPolynomial.eval₂Hom (ψ.comp MvPolynomial.C) (fun j : Fin 2 => hom_ψ (c.succAbove j) / hom_ψ c)
    have h_eq0_fwd : ρ₀c.comp (away₀.comp (α_c 0)) = ψ := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        simp only [RingHom.comp_apply, α_c, MvPolynomial.eval₂Hom_C]
        change ρ_loc ((away₀ ((HomogeneousLocalization.fromZeroRingHom 𝒜 _) (algebraMap k ↥(𝒜 0) a))).val) =
          ψ (MvPolynomial.C a)
        rw [HomogeneousLocalization.awayMap_fromZeroRingHom, h_val_fromZero]
        dsimp only [ρ_loc]
        rw [Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec (S := Localization (Submonoid.powers f₀c))
          hUnit_ν (MvPolynomial.C a) (ψ (MvPolynomial.C a)) 1).mpr ?_
        simp only [Submonoid.coe_one, map_one, one_mul]
        dsimp only [ν]
        rw [MvPolynomial.eval₂Hom_C]
        rfl
      · intro j
        simp only [RingHom.comp_apply, α_c, MvPolynomial.eval₂Hom_X']
        change ρ_loc ((away₀ (HomogeneousLocalization.Away.mk 𝒜 (hX 0) 1
          (MvPolynomial.X ((0 : Fin 3).succAbove j)) _)).val) = ψ (MvPolynomial.X j)
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
        dsimp only [ρ_loc]
        rw [Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec (S := Localization (Submonoid.powers f₀c))
          hUnit_ν _ (ψ (MvPolynomial.X j)) _).mpr ?_
        change ν (MvPolynomial.X ((0 : Fin 3).succAbove j) * MvPolynomial.X c ^ 1) =
          ν (f₀c ^ 1) * ψ (MvPolynomial.X j)
        rw [pow_one, pow_one, map_mul, hν_f₀c]
        dsimp only [ν]
        rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
        fin_cases j <;> simp [hom_ψ, mul_comm]
    have h_eqc_fwd : ρ₀c.comp (away_c.comp (α_c c)) = ψ_trans := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        simp only [RingHom.comp_apply, α_c, MvPolynomial.eval₂Hom_C]
        change ρ_loc ((away_c ((HomogeneousLocalization.fromZeroRingHom 𝒜 _) (algebraMap k ↥(𝒜 0) a))).val) =
          ψ_trans (MvPolynomial.C a)
        rw [HomogeneousLocalization.awayMap_fromZeroRingHom, h_val_fromZero]
        dsimp only [ρ_loc]
        rw [Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec (S := Localization (Submonoid.powers f₀c))
          hUnit_ν (MvPolynomial.C a) (ψ_trans (MvPolynomial.C a)) 1).mpr ?_
        simp only [Submonoid.coe_one, map_one, one_mul]
        dsimp only [ν, ψ_trans]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      · intro j
        simp only [RingHom.comp_apply, α_c, MvPolynomial.eval₂Hom_X']
        change ρ_loc ((away_c (HomogeneousLocalization.Away.mk 𝒜 (hX c) 1
          (MvPolynomial.X (c.succAbove j)) _)).val) = ψ_trans (MvPolynomial.X j)
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
        dsimp only [ρ_loc]
        rw [Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec (S := Localization (Submonoid.powers f₀c))
          hUnit_ν _ (ψ_trans (MvPolynomial.X j)) _).mpr ?_
        change ν (MvPolynomial.X (c.succAbove j) * MvPolynomial.X 0 ^ 1) =
          ν (f₀c ^ 1) * ψ_trans (MvPolynomial.X j)
        rw [pow_one, pow_one, map_mul, hν_f₀c]
        dsimp only [ν, ψ_trans]
        rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
        have h0 : hom_ψ 0 = 1 := rfl
        rw [h0, mul_one, mul_div_cancel₀ _ hc_ne]
    have h_comm0 : CommRingCat.ofHom (β_c 0) ≫ CommRingCat.ofHom ψ =
        CommRingCat.ofHom away₀ ≫ CommRingCat.ofHom ρ₀c := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      apply congrArg CommRingCat.ofHom
      apply RingHom.ext
      intro z
      change ψ (β_c 0 z) = ρ₀c (away₀ z)
      rw [← h_eq0_fwd]
      change ρ₀c (away₀ (α_c 0 (β_c 0 z))) = ρ₀c (away₀ z)
      rw [h_right_inv 0 z]
    have h_commc : CommRingCat.ofHom (β_c c) ≫ CommRingCat.ofHom ψ_trans =
        CommRingCat.ofHom away_c ≫ CommRingCat.ofHom ρ₀c := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      apply congrArg CommRingCat.ofHom
      apply RingHom.ext
      intro z
      change ψ_trans (β_c c z) = ρ₀c (away_c z)
      rw [← h_eqc_fwd]
      change ρ₀c (away_c (α_c c (β_c c z))) = ρ₀c (away_c z)
      rw [h_right_inv c z]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_trans) ≫ j_proj c =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ j_proj 0
    dsimp only [j_proj, iso_Spec]
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, h_commc,
      AlgebraicGeometry.Spec.map_comp, Category.assoc,
      ← Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)),
      ← AlgebraicGeometry.Spec.map_comp, h_comm0, AlgebraicGeometry.Spec.map_comp, Category.assoc]
    congr 1
    have hA_c := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX c) Nat.zero_lt_one (hX 0)
      (mul_comm (MvPolynomial.X 0) (MvPolynomial.X c) : f₀c = MvPolynomial.X c * MvPolynomial.X 0)
    have hA_0 := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX 0) Nat.zero_lt_one (hX c)
      (rfl : f₀c = MvPolynomial.X 0 * MvPolynomial.X c)
    exact hA_c.trans hA_0.symm

  
  
  
  have hGL3 : ∀ (n_pts : ℕ)
      (s_pt : Fin n_pts →
        (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Proj 𝒜))
      (s_dist : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Proj 𝒜),
      (∀ i : Fin n_pts, s_pt i ≫ π_proj = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) →
      s_dist ≫ π_proj = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      ∃ Φ : AlgebraicGeometry.Proj 𝒜 ≅ AlgebraicGeometry.Proj 𝒜,
        Φ.hom ≫ π_proj = π_proj ∧
        Φ.inv ≫ π_proj = π_proj ∧
        (∀ (i : Fin n_pts) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
          (s_pt i ≫ Φ.inv).base pt ∈ Set.range (j_proj 0).base) ∧
        (∀ (c : Fin 3) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
          (s_dist ≫ Φ.inv).base pt ∈ Set.range (j_proj c).base) := by
    intro n_pts s_pt s_dist hs_pt hs_dist
    have hLin_hom : ∀ a : Fin 3 → k,
        (∑ r : Fin 3, MvPolynomial.C (a r) * (MvPolynomial.X r : P)).IsHomogeneous 1 := by
      intro a
      change (∑ r : Fin 3, MvPolynomial.C (a r) * (MvPolynomial.X r : P)) ∈ 𝒜 1
      apply Submodule.sum_mem
      intro r _
      change (MvPolynomial.C (a r) * (MvPolynomial.X r : P)).IsHomogeneous 1
      have hc : (MvPolynomial.C (a r) : P).IsHomogeneous 0 := MvPolynomial.isHomogeneous_C _ _
      have hx : (MvPolynomial.X r : P).IsHomogeneous 1 := hX r
      simpa using hc.mul hx

    
    have hCoord : ∀ (s : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Proj 𝒜),
        s ≫ π_proj = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        ∃ (c_s : Fin 3) (w : Fin 3 → k),
          w c_s = 1 ∧
          ∀ (a : Fin 3 → k) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
            s.base pt ∈ AlgebraicGeometry.Proj.basicOpen 𝒜
              (∑ r : Fin 3, MvPolynomial.C (a r) * (MvPolynomial.X r : P)) ↔
              (∑ r : Fin 3, a r * w r) ≠ 0 := by
      intro s hs
      let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k) := default
      have h_mem_univ : s.base pt₀ ∈ (⋃ c : Fin 3, Set.range (j_proj c).base) := by
        rw [hj_cov]
        exact Set.mem_univ _
      obtain ⟨c_s, hc_s⟩ := Set.mem_iUnion.mp h_mem_univ
      rw [hj_range c_s] at hc_s
      let ι_cs := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X c_s) (hX c_s) Nat.zero_lt_one
      have hRange_s : Set.range s.base ⊆ Set.range ι_cs.base := by
        rintro _ ⟨pt, rfl⟩
        have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
        rw [hpt]
        change s.base pt₀ ∈ (ι_cs.opensRange : Set (AlgebraicGeometry.Proj 𝒜))
        rw [AlgebraicGeometry.Proj.opensRange_awayι]
        exact hc_s
      let s_lift := AlgebraicGeometry.IsOpenImmersion.lift ι_cs s hRange_s
      have hs_fac : s_lift ≫ ι_cs = s := AlgebraicGeometry.IsOpenImmersion.lift_fac ι_cs s hRange_s
      let χ_s : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c_s) →+* k :=
        (AlgebraicGeometry.Spec.preimage s_lift).hom
      have hSpec_χ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_s) = s_lift := by
        rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
      have hs_χ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_s) ≫ ι_cs = s := by
        rw [hSpec_χ, hs_fac]
      have hχ_const : ∀ b : k,
          χ_s ((HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X c_s))) (algebraMap k ↥(𝒜 0) b)) = b := by
        have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_s) ≫ ι_cs) ≫ π_proj =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
          rw [hs_χ, hs]
        dsimp only [π_proj, ι_cs] at h1
        rw [Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_id (CommRingCat.of k)] at h1
        have hinj := AlgebraicGeometry.Spec.map_injective h1
        intro b
        exact congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom b) hinj
      let w : Fin 3 → k := fun r =>
        χ_s (HomogeneousLocalization.Away.isLocalizationElem (hX c_s) (hX r))
      have hw_cs : w c_s = 1 := by
        dsimp only [w]
        have h1_elem : HomogeneousLocalization.Away.isLocalizationElem (hX c_s) (hX c_s) = 1 := by
          apply HomogeneousLocalization.val_injective
          rw [h_val_isLocElem, HomogeneousLocalization.val_one]
          simp
        rw [h1_elem, map_one]
      refine ⟨c_s, w, hw_cs, fun a pt => ?_⟩
      let L_a : P := ∑ r : Fin 3, MvPolynomial.C (a r) * MvPolynomial.X r
      have hLa : L_a ∈ 𝒜 1 := hLin_hom a
      have hElem_La : HomogeneousLocalization.Away.isLocalizationElem (hX c_s) hLa =
          ∑ r : Fin 3,
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X c_s)))
              (algebraMap k ↥(𝒜 0) (a r)) *
              HomogeneousLocalization.Away.isLocalizationElem (hX c_s) (hX r) := by
        apply HomogeneousLocalization.val_injective
        have h_rhs_val : ∀ z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X c_s),
            z.val = valHom (Submonoid.powers (MvPolynomial.X c_s)) z := fun _ => rfl
        rw [h_val_isLocElem, pow_one, h_rhs_val, map_sum]
        have h_term : ∀ r : Fin 3,
            (valHom (Submonoid.powers (MvPolynomial.X c_s)))
              ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X c_s)))
                (algebraMap k ↥(𝒜 0) (a r)) *
                HomogeneousLocalization.Away.isLocalizationElem (hX c_s) (hX r)) =
              Localization.mk (MvPolynomial.C (a r) * MvPolynomial.X r)
                ⟨(MvPolynomial.X c_s : P) ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩ := by
          intro r
          rw [map_mul]
          change (((HomogeneousLocalization.fromZeroRingHom 𝒜 _) (algebraMap k ↥(𝒜 0) (a r))).val) *
            (HomogeneousLocalization.Away.isLocalizationElem (hX c_s) (hX r)).val = _
          rw [h_val_fromZero, h_val_isLocElem, pow_one, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact one_mul _
        simp only [h_term, L_a, Fin.sum_univ_three, Localization.add_mk_self]
      have hχ_La : χ_s (HomogeneousLocalization.Away.isLocalizationElem (hX c_s) hLa) =
          ∑ r : Fin 3, a r * w r := by
        rw [hElem_La, map_sum]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [map_mul, hχ_const (a r)]
      have hpre := congrArg SetLike.coe
        (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX c_s) Nat.zero_lt_one hLa Nat.zero_lt_one)
      change s.base pt ∈ (AlgebraicGeometry.Proj.basicOpen 𝒜 L_a : Set (AlgebraicGeometry.Proj 𝒜)) ↔ _
      rw [← hs_χ]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_s)).base pt ∈
        ((TopologicalSpace.Opens.map ι_cs.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 L_a) : Set _) ↔ _
      dsimp only [ι_cs]
      rw [hpre]
      change HomogeneousLocalization.Away.isLocalizationElem (hX c_s) hLa ∉
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_s)).base pt).asIdeal ↔ _
      have hpt_bot : pt.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
      have hasIdeal_eq : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_s)).base pt).asIdeal =
          RingHom.ker χ_s := by
        change Ideal.comap χ_s pt.asIdeal = RingHom.ker χ_s
        rw [hpt_bot]
        rfl
      rw [hasIdeal_eq, RingHom.mem_ker, hχ_La]

    
    let ψ_ring : Matrix (Fin 3) (Fin 3) k → (P →+* P) := fun A =>
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun c : Fin 3 => ∑ r : Fin 3, MvPolynomial.C (A c r) * MvPolynomial.X r)
    let ψ_mat : Matrix (Fin 3) (Fin 3) k → (𝒜 →+*ᵍ 𝒜) := fun A =>
      { toRingHom := ψ_ring A
        map_mem := by
          intro n p hp
          have h1 : (ψ_ring A p).IsHomogeneous (1 * n) :=
            hp.eval₂ MvPolynomial.C
              (fun c : Fin 3 => ∑ r : Fin 3, MvPolynomial.C (A c r) * MvPolynomial.X r)
              (fun a => MvPolynomial.isHomogeneous_C _ a)
              (fun c => hLin_hom (A c))
          rwa [one_mul] at h1 }
    have hψ_comp : ∀ A B : Matrix (Fin 3) (Fin 3) k,
        (ψ_mat B).comp (ψ_mat A) = ψ_mat (A * B) := by
      intro A B
      apply GradedRingHom.ext
      intro p
      have hrh : (ψ_ring B).comp (ψ_ring A) = ψ_ring (A * B) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro a
          dsimp only [ψ_ring, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        · intro c
          dsimp only [ψ_ring, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', map_sum]
          have h_lhs : (∑ x : Fin 3, (MvPolynomial.eval₂Hom MvPolynomial.C
              (fun b : Fin 3 => ∑ r : Fin 3, MvPolynomial.C (B b r) * MvPolynomial.X r))
                (MvPolynomial.C (A c x) * MvPolynomial.X x)) =
              ∑ x : Fin 3, ∑ r : Fin 3,
                (MvPolynomial.C (A c x) * MvPolynomial.C (B x r)) * MvPolynomial.X r := by
            refine Finset.sum_congr rfl fun x _ => ?_
            rw [map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', Finset.mul_sum]
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [mul_assoc]
          rw [h_lhs, Finset.sum_comm]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [Matrix.mul_apply, map_sum MvPolynomial.C, Finset.sum_mul]
          refine Finset.sum_congr rfl fun x _ => ?_
          rw [MvPolynomial.C_mul]
      exact RingHom.congr_fun hrh p
    have hψ_one : ψ_mat 1 = GradedRingHom.id 𝒜 := by
      apply GradedRingHom.ext
      intro p
      have hrh : ψ_ring 1 = RingHom.id P := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro a
          dsimp only [ψ_ring, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_C]
          rfl
        · intro c
          dsimp only [ψ_ring]
          rw [MvPolynomial.eval₂Hom_X']
          simp [Matrix.one_apply]
          rfl
      exact RingHom.congr_fun hrh p
    have h_irrel_of_right_inv : ∀ (u v : 𝒜 →+*ᵍ 𝒜),
        u.comp v = GradedRingHom.id 𝒜 →
        HomogeneousIdeal.irrelevant 𝒜 ≤ HomogeneousIdeal.map u (HomogeneousIdeal.irrelevant 𝒜) := by
      intro u v huv x hx
      have hproj0 : GradedRing.proj 𝒜 0 x = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 x).mp hx
      have hvx_irrel : v x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
        have hsum : x = ∑ i ∈ (DirectSum.decompose 𝒜 x).support, ((DirectSum.decompose 𝒜 x) i : P) :=
          (DirectSum.sum_support_decompose 𝒜 x).symm
        have hvsum : v x =
            ∑ i ∈ (DirectSum.decompose 𝒜 x).support, v ((DirectSum.decompose 𝒜 x) i : P) := by
          conv_lhs => rw [hsum]
          exact map_sum v.toRingHom _ _
        rw [hvsum]
        apply Ideal.sum_mem
        intro i _
        rcases Nat.eq_zero_or_pos i with rfl | hi_pos
        · change v (GradedRing.proj 𝒜 0 x) ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal
          rw [hproj0, map_zero]
          exact Ideal.zero_mem _
        · exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hi_pos
            (v.map_mem ((DirectSum.decompose 𝒜 x) i).2)
      have huvx : u.toRingHom (v x) = x := by
        change (u.comp v) x = x
        rw [huv]
        rfl
      change x ∈ Ideal.map u.toRingHom (HomogeneousIdeal.irrelevant 𝒜).toIdeal
      rw [← huvx]
      exact Ideal.mem_map_of_mem u.toRingHom hvx_irrel
    have hProj_map_eq_id : ∀ (h : 𝒜 →+*ᵍ 𝒜)
        (hh : HomogeneousIdeal.irrelevant 𝒜 ≤ HomogeneousIdeal.map h (HomogeneousIdeal.irrelevant 𝒜)),
        h = GradedRingHom.id 𝒜 → AlgebraicGeometry.Proj.map h hh = 𝟙 (AlgebraicGeometry.Proj 𝒜) := by
      rintro _ hh rfl
      exact AlgebraicGeometry.Proj.map_id

    have hProj_aut_of_mul_eq_one : ∀ (A B : Matrix (Fin 3) (Fin 3) k),
        A * B = 1 → B * A = 1 →
        ∃ (hf_B : HomogeneousIdeal.irrelevant 𝒜 ≤
            HomogeneousIdeal.map (ψ_mat B) (HomogeneousIdeal.irrelevant 𝒜))
          (Φ : AlgebraicGeometry.Proj 𝒜 ≅ AlgebraicGeometry.Proj 𝒜),
          Φ.inv = AlgebraicGeometry.Proj.map (ψ_mat B) hf_B ∧
          Φ.hom ≫ π_proj = π_proj ∧
          Φ.inv ≫ π_proj = π_proj := by
      intro A B hAB hBA
      have hψ_AB : (ψ_mat B).comp (ψ_mat A) = GradedRingHom.id 𝒜 := by
        rw [hψ_comp, hAB, hψ_one]
      have hψ_BA : (ψ_mat A).comp (ψ_mat B) = GradedRingHom.id 𝒜 := by
        rw [hψ_comp, hBA, hψ_one]
      have hf_B : HomogeneousIdeal.irrelevant 𝒜 ≤
          HomogeneousIdeal.map (ψ_mat B) (HomogeneousIdeal.irrelevant 𝒜) :=
        h_irrel_of_right_inv (ψ_mat B) (ψ_mat A) hψ_AB
      have hf_A : HomogeneousIdeal.irrelevant 𝒜 ≤
          HomogeneousIdeal.map (ψ_mat A) (HomogeneousIdeal.irrelevant 𝒜) :=
        h_irrel_of_right_inv (ψ_mat A) (ψ_mat B) hψ_BA
      let Φ : AlgebraicGeometry.Proj 𝒜 ≅ AlgebraicGeometry.Proj 𝒜 :=
        { hom := AlgebraicGeometry.Proj.map (ψ_mat A) hf_A
          inv := AlgebraicGeometry.Proj.map (ψ_mat B) hf_B
          hom_inv_id := by
            rw [← AlgebraicGeometry.Proj.map_comp]
            exact hProj_map_eq_id _ _ hψ_BA
          inv_hom_id := by
            rw [← AlgebraicGeometry.Proj.map_comp]
            exact hProj_map_eq_id _ _ hψ_AB }
      have hΦ_inv_hom : Φ.inv ≫ π_proj = π_proj := by
        let f := ψ_mat B
        let V : Fin 3 → (AlgebraicGeometry.Proj 𝒜).Opens :=
          fun c => AlgebraicGeometry.Proj.basicOpen 𝒜 (f (MvPolynomial.X c))
        have hV_cov : TopologicalSpace.IsOpenCover V := by
          apply TopologicalSpace.IsOpenCover.mk
          change (⨆ c : Fin 3, V c) = ⊤
          ext x
          change x ∈ (⨆ c : Fin 3, V c) ↔ True
          simp only [TopologicalSpace.Opens.mem_iSup, iff_true, V]
          have hx_univ : (AlgebraicGeometry.Proj.map f hf_B).base x ∈
              (⨆ c : Fin 3, AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X c)) := by
            rw [h_cov_basicOpen]
            trivial
          rw [TopologicalSpace.Opens.mem_iSup] at hx_univ
          obtain ⟨c, hc⟩ := hx_univ
          refine ⟨c, ?_⟩
          have hpre := AlgebraicGeometry.Proj.map_preimage_basicOpen f hf_B (MvPolynomial.X c)
          rw [← hpre]
          exact hc
        have h_local : ∀ c : Fin 3, (V c).ι ≫ (AlgebraicGeometry.Proj.map f hf_B ≫ π_proj) =
            (V c).ι ≫ π_proj := by
          intro c
          have hfc : f (MvPolynomial.X c) ∈ 𝒜 1 := f.map_mem (hX c)
          dsimp only [V]
          rw [← cancel_epi (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f (MvPolynomial.X c)) hfc
            Nat.zero_lt_one).inv]
          rw [← Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
            ← Category.assoc (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f (MvPolynomial.X c)) hfc
              Nat.zero_lt_one).inv,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          dsimp only [π_proj]
          rw [← Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 (f (MvPolynomial.X c)) hfc Nat.zero_lt_one)
              (AlgebraicGeometry.Proj.map f hf_B),
            AlgebraicGeometry.Proj.awayι_comp_map f hf_B Nat.zero_lt_one (MvPolynomial.X c) (hX c),
            Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
            AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          congr 1
          apply congrArg CommRingCat.ofHom
          apply RingHom.ext
          intro a
          simp only [RingHom.comp_apply]
          apply HomogeneousLocalization.val_injective
          have h_lhs : (((HomogeneousLocalization.Away.map f (MvPolynomial.X c))
              ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X c)))
                (algebraMap k ↥(𝒜 0) a)))).val = Localization.mk (MvPolynomial.C a) 1 := by
            have h1_mem0 : (1 : P) ∈ 𝒜 0 := (1 : ↥(𝒜 0)).2
            change ((HomogeneousLocalization.Away.map f (MvPolynomial.X c))
              (HomogeneousLocalization.mk
                { deg := 0, num := algebraMap k ↥(𝒜 0) a, den := ⟨1, h1_mem0⟩,
                  den_mem := Submonoid.one_mem _ })).val = _
            dsimp only [HomogeneousLocalization.Away.map]
            rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
            dsimp
            have hfa : f (MvPolynomial.C a) = MvPolynomial.C a := by
              change ψ_ring B (MvPolynomial.C a) = MvPolynomial.C a
              dsimp only [ψ_ring]
              rw [MvPolynomial.eval₂Hom_C]
            have hf1 : f 1 = 1 := map_one f
            change Localization.mk (f (MvPolynomial.C a)) ⟨f 1, _⟩ = _
            rw [hfa]
            congr 1
            apply Subtype.ext
            exact hf1
          rw [h_lhs, h_val_fromZero]
        exact AlgebraicGeometry.Scheme.Cover.hom_ext
          (AlgebraicGeometry.Scheme.openCoverOfIsOpenCover (AlgebraicGeometry.Proj 𝒜) V hV_cov)
          (AlgebraicGeometry.Proj.map f hf_B ≫ π_proj) π_proj h_local
      have hΦ_hom_hom : Φ.hom ≫ π_proj = π_proj := by
        calc
          Φ.hom ≫ π_proj = Φ.hom ≫ (Φ.inv ≫ π_proj) := by rw [hΦ_inv_hom]
          _ = (Φ.hom ≫ Φ.inv) ≫ π_proj := (Category.assoc _ _ _).symm
          _ = 𝟙 _ ≫ π_proj := by rw [Φ.hom_inv_id]
          _ = π_proj := Category.id_comp π_proj
      exact ⟨hf_B, Φ, rfl, hΦ_hom_hom, hΦ_inv_hom⟩

    
    obtain ⟨i₀, w_dist, hw_dist, hmem_dist⟩ := hCoord s_dist hs_dist
    choose c_pt w_pt hw_pt hmem_pt using fun i => hCoord (s_pt i) (hs_pt i)
    let Q_poly : (Fin 3 → k) → Polynomial k := fun w =>
      Polynomial.C (w 0) + Polynomial.C (w 1) * Polynomial.X + Polynomial.C (w 2) * Polynomial.X ^ 2
    have hQ_ne_zero : ∀ (w : Fin 3 → k) (c : Fin 3), w c = 1 → Q_poly w ≠ 0 := by
      intro w c hwc hzero
      have h0 : (Q_poly w).coeff c.1 = 0 := by rw [hzero, Polynomial.coeff_zero]
      have h1 : (Q_poly w).coeff c.1 = 1 := by
        fin_cases c <;> simp [Q_poly] <;> exact hwc
      exact one_ne_zero (h1.symm.trans h0)
    have hQ_eval : ∀ (w : Fin 3 → k) (t : k),
        (Q_poly w).eval t = 1 * w 0 + t * w 1 + t ^ 2 * w 2 := by
      intro w t
      simp [Q_poly]
      ring
    let B_roots : Finset k :=
      (Q_poly w_dist).roots.toFinset ∪
        Finset.univ.biUnion (fun i : Fin n_pts => (Q_poly (w_pt i)).roots.toFinset)
    obtain ⟨t₀, ht₀⟩ := Infinite.exists_notMem_finset B_roots
    let ℓ₀ : Fin 3 → k := ![1, t₀, t₀ ^ 2]
    have h_dot_eval : ∀ w : Fin 3 → k, (∑ r : Fin 3, ℓ₀ r * w r) = (Q_poly w).eval t₀ := by
      intro w
      rw [Fin.sum_univ_three, hQ_eval]
      rfl
    have hμ_ne : (∑ r : Fin 3, ℓ₀ r * w_dist r) ≠ 0 := by
      rw [h_dot_eval]
      intro hev0
      apply ht₀
      apply Finset.mem_union_left
      rw [Multiset.mem_toFinset, Polynomial.mem_roots (hQ_ne_zero w_dist i₀ hw_dist)]
      exact hev0
    have hpt_ne : ∀ i : Fin n_pts, (∑ r : Fin 3, ℓ₀ r * w_pt i r) ≠ 0 := by
      intro i
      rw [h_dot_eval]
      intro hev0
      apply ht₀
      apply Finset.mem_union_right
      rw [Finset.mem_biUnion]
      refine ⟨i, Finset.mem_univ i, ?_⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots (hQ_ne_zero (w_pt i) (c_pt i) (hw_pt i))]
      exact hev0
    let u : Fin 2 → Fin 3 → k := fun j r =>
      (if r = i₀.succAbove j then (1 : k) else 0) -
        w_dist (i₀.succAbove j) * (if r = i₀ then (1 : k) else 0)
    let N : Matrix (Fin 3) (Fin 3) k := ![ℓ₀, fun r => ℓ₀ r + u 0 r, fun r => ℓ₀ r + u 1 r]
    have hu_orth : ∀ j : Fin 2, (∑ r : Fin 3, u j r * w_dist r) = 0 := by
      intro j
      have h_expand : ∀ r : Fin 3, u j r * w_dist r =
          (if r = i₀.succAbove j then w_dist r else 0) -
            w_dist (i₀.succAbove j) * (if r = i₀ then w_dist r else 0) := by
        intro r
        dsimp only [u]
        split_ifs <;> ring
      simp only [h_expand, Finset.sum_sub_distrib, ← Finset.mul_sum, Finset.sum_ite_eq',
        Finset.mem_univ, ↓reduceIte, hw_dist, mul_one, sub_self]
    have hN_dist : ∀ c : Fin 3, (∑ r : Fin 3, N c r * w_dist r) ≠ 0 := by
      intro c
      fin_cases c
      · exact hμ_ne
      · have hsum : (∑ r : Fin 3, (ℓ₀ r + u 0 r) * w_dist r) =
            (∑ r : Fin 3, ℓ₀ r * w_dist r) + (∑ r : Fin 3, u 0 r * w_dist r) := by
          simp only [add_mul, Finset.sum_add_distrib]
        change (∑ r : Fin 3, (ℓ₀ r + u 0 r) * w_dist r) ≠ 0
        rw [hsum, hu_orth 0, add_zero]
        exact hμ_ne
      · have hsum : (∑ r : Fin 3, (ℓ₀ r + u 1 r) * w_dist r) =
            (∑ r : Fin 3, ℓ₀ r * w_dist r) + (∑ r : Fin 3, u 1 r * w_dist r) := by
          simp only [add_mul, Finset.sum_add_distrib]
        change (∑ r : Fin 3, (ℓ₀ r + u 1 r) * w_dist r) ≠ 0
        rw [hsum, hu_orth 1, add_zero]
        exact hμ_ne
    have hN_det_eq : N.det = (-1 : k) ^ (i₀ : ℕ) * (∑ r : Fin 3, ℓ₀ r * w_dist r) := by
      rw [Matrix.det_fin_three]
      dsimp only [N, u, ℓ₀]
      rcases i₀ with ⟨_ | _ | _ | n, hi₀⟩
      · change w_dist 0 = 1 at hw_dist
        simp [Fin.sum_univ_three, Fin.succAbove, hw_dist]
        ring
      · change w_dist 1 = 1 at hw_dist
        simp [Fin.sum_univ_three, Fin.succAbove, hw_dist]
        ring
      · change w_dist 2 = 1 at hw_dist
        simp [Fin.sum_univ_three, Fin.succAbove, Fin.lt_def, hw_dist]
        ring
      · omega
    have hN_det_ne : N.det ≠ 0 := by
      rw [hN_det_eq]
      exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hμ_ne
    have hN_unit : IsUnit N.det := isUnit_iff_ne_zero.mpr hN_det_ne
    have hN_mul_inv : N * N⁻¹ = 1 := Matrix.mul_nonsing_inv N hN_unit
    have hN_inv_mul : N⁻¹ * N = 1 := Matrix.nonsing_inv_mul N hN_unit

    obtain ⟨hf_N, Φ, hΦ_inv_def, hΦ_hom_hom, hΦ_inv_hom⟩ :=
      hProj_aut_of_mul_eq_one N⁻¹ N hN_inv_mul hN_mul_inv
    refine ⟨Φ, hΦ_hom_hom, hΦ_inv_hom, ?_, ?_⟩
    · intro i pt
      rw [hj_range 0, hΦ_inv_def]
      change (s_pt i).base pt ∈
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.map (ψ_mat N) hf_N).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0))
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen (ψ_mat N) hf_N (MvPolynomial.X 0)]
      have hfX0 : (ψ_mat N) (MvPolynomial.X 0) =
          ∑ r : Fin 3, MvPolynomial.C (N 0 r) * MvPolynomial.X r := by
        change ψ_ring N (MvPolynomial.X 0) = _
        dsimp only [ψ_ring]
        rw [MvPolynomial.eval₂Hom_X']
      rw [hfX0]
      exact (hmem_pt i (N 0) pt).mpr (hpt_ne i)
    · intro c pt
      rw [hj_range c, hΦ_inv_def]
      change s_dist.base pt ∈
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.map (ψ_mat N) hf_N).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X c))
      rw [AlgebraicGeometry.Proj.map_preimage_basicOpen (ψ_mat N) hf_N (MvPolynomial.X c)]
      have hfXc : (ψ_mat N) (MvPolynomial.X c) =
          ∑ r : Fin 3, MvPolynomial.C (N c r) * MvPolynomial.X r := by
        change ψ_ring N (MvPolynomial.X c) = _
        dsimp only [ψ_ring]
        rw [MvPolynomial.eval₂Hom_X']
      rw [hfXc]
      exact (hmem_dist (N c) pt).mpr (hN_dist c)

  
  
  
  have hHyp : ∀ (Z : Set (AlgebraicGeometry.Proj 𝒜)) (d : ℕ) (G : P),
      IsClosed Z → IsIrreducible Z → 1 ≤ d → G.IsHomogeneous d → Irreducible G →
      MvPolynomial.X 0 ∉ Ideal.span {G} →
      (j_proj 0).base ⁻¹' Z =
        { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
          eval_c 0 G ∈ p.asIdeal } →
      ∀ c : Fin 3,
        (j_proj c).base ⁻¹' Z =
          { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
            eval_c c G ∈ p.asIdeal } := by
    intro Z d G hZ_cl hZ_irr hd hG_hom hG_irr hX0_not_mem hPre0
    have hPrime_G : Prime G := UniqueFactorizationMonoid.irreducible_iff_prime.mp hG_irr
    let I_G : Ideal P := Ideal.span {G}
    have hPrime_IG : I_G.IsPrime := (Ideal.span_singleton_prime hG_irr.ne_zero).mpr hPrime_G
    have hHom_IG : I_G.IsHomogeneous 𝒜 := by
      apply Ideal.homogeneous_span 𝒜 {G}
      rintro x rfl
      exact ⟨d, hG_hom⟩
    have hNotIrrel : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⟨I_G, hHom_IG⟩ := by
      intro hle
      have hX0_irrel : (MvPolynomial.X 0 : P) ∈ HomogeneousIdeal.irrelevant 𝒜 :=
        HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 Nat.zero_lt_one (hX 0)
      exact hX0_not_mem (hle hX0_irrel)
    let η_PS : ProjectiveSpectrum 𝒜 :=
      { asHomogeneousIdeal := ⟨I_G, hHom_IG⟩
        isPrime := hPrime_IG
        not_irrelevant_le := hNotIrrel }
    let η_G : AlgebraicGeometry.Proj 𝒜 := η_PS
    let V_G : Set (AlgebraicGeometry.Proj 𝒜) :=
      (AlgebraicGeometry.Proj.basicOpen 𝒜 G : Set (AlgebraicGeometry.Proj 𝒜))ᶜ
    have hVG_eq_closure : V_G = closure ({η_G} : Set (AlgebraicGeometry.Proj 𝒜)) := by
      ext y
      let y_PS : ProjectiveSpectrum 𝒜 := y
      have h1 : y ∈ V_G ↔ G ∈ y_PS.asHomogeneousIdeal := by
        change y ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 G ↔ _
        rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
      have h2 : G ∈ y_PS.asHomogeneousIdeal ↔ η_PS ≤ y_PS :=
        (Ideal.span_singleton_le_iff_mem y_PS.asHomogeneousIdeal.toIdeal).symm
      have h3 : (η_PS ≤ y_PS) ↔ y ∈ closure ({η_G} : Set (AlgebraicGeometry.Proj 𝒜)) :=
        ProjectiveSpectrum.le_iff_mem_closure 𝒜 η_PS y_PS
      exact h1.trans (h2.trans h3)
    have hVG_cl : IsClosed V_G := by
      rw [hVG_eq_closure]
      exact isClosed_closure
    have hVG_irr : IsIrreducible V_G := by
      rw [hVG_eq_closure]
      exact isIrreducible_singleton.closure
    let U₀ : Set (AlgebraicGeometry.Proj 𝒜) :=
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set (AlgebraicGeometry.Proj 𝒜))
    have hU₀_open : IsOpen U₀ := (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)).isOpen
    have hPre0_VG : (j_proj 0).base ⁻¹' V_G = (j_proj 0).base ⁻¹' Z := by
      dsimp only [V_G]
      rw [Set.preimage_compl, hj_pre_basicOpen 0 d G hd hG_hom, hPre0]
      ext p
      simp
    have hInter_eq : Z ∩ U₀ = V_G ∩ U₀ := by
      have himg := congrArg (Set.image (j_proj 0).base) hPre0_VG.symm
      rw [Set.image_preimage_eq_inter_range, Set.image_preimage_eq_inter_range, hj_range 0] at himg
      exact himg
    have hη_in_VG : η_G ∈ V_G := by
      change ¬ (η_G ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 G)
      rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not]
      exact Ideal.subset_span (Set.mem_singleton G)
    have hη_in_U₀ : η_G ∈ U₀ := by
      change η_G ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)
      rw [AlgebraicGeometry.Proj.mem_basicOpen]
      exact hX0_not_mem
    have hVG_U₀_ne : (V_G ∩ U₀).Nonempty := ⟨η_G, hη_in_VG, hη_in_U₀⟩
    have hZ_U₀_ne : (Z ∩ U₀).Nonempty := by
      rwa [hInter_eq]
    have h_cl_open_dense : ∀ (W : Set (AlgebraicGeometry.Proj 𝒜)),
        IsClosed W → IsIrreducible W → (W ∩ U₀).Nonempty → W = closure (W ∩ U₀) := by
      intro W hW_cl hW_irr hW_ne
      apply Set.Subset.antisymm
      · have h_sub : W ⊆ U₀ᶜ ∪ closure (W ∩ U₀) := by
          intro w hw
          by_cases hwU : w ∈ U₀
          · exact Or.inr (subset_closure ⟨hw, hwU⟩)
          · exact Or.inl hwU
        rcases isPreirreducible_iff_isClosed_union_isClosed.mp hW_irr.isPreirreducible
            U₀ᶜ (closure (W ∩ U₀)) hU₀_open.isClosed_compl isClosed_closure h_sub with hW_compl | hW_cl'
        · obtain ⟨x, hxW, hxU⟩ := hW_ne
          exact False.elim ((hW_compl hxW) hxU)
        · exact hW_cl'
      · exact hW_cl.closure_subset_iff.mpr Set.inter_subset_left
    have hZ_eq_VG : Z = V_G := by
      rw [h_cl_open_dense Z hZ_cl hZ_irr hZ_U₀_ne, hInter_eq,
        ← h_cl_open_dense V_G hVG_cl hVG_irr hVG_U₀_ne]
    intro c
    rw [hZ_eq_VG]
    dsimp only [V_G]
    rw [Set.preimage_compl, hj_pre_basicOpen c d G hd hG_hom]
    ext p
    simp

  
  
  
  let j_chart : Fin 3 →
      (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
        (weilProjectiveSpaceOver k 2).left) := j_proj
  refine ⟨j_chart, ?_, ⟨hj_cov, hTrans⟩, hGL3, hHyp⟩
  intro c
  refine ⟨hj_open c, hj_hom c, ?_, ?_⟩
  · intro c'
    change (j_proj c).base ⁻¹' Set.range (j_proj c').base = _
    rw [hj_range c']
    exact hj_pre_basicOpen c 1 (MvPolynomial.X c') (le_refl 1) (MvPolynomial.isHomogeneous_X k c')
  · let hom_ψ₀ : Fin 3 → K₂ :=
      ![1, (φ_K₂ 0).toRingHom (MvPolynomial.X 0), (φ_K₂ 0).toRingHom (MvPolynomial.X 1)]
    have h_hom_eq : hom_ψ₀ = homCoord := by
      ext r
      fin_cases r
      · rfl
      · change (φ_K₂ 0) (MvPolynomial.X 0) = x₁
        simp [φ_K₂, homCoord]
      · change (φ_K₂ 0) (MvPolynomial.X 1) = x₂
        simp [φ_K₂, homCoord]
    have h_hom_ne : hom_ψ₀ c ≠ 0 := by
      rw [h_hom_eq]
      have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 2) k) K₂) :=
        IsFractionRing.injective (MvPolynomial (Fin 2) k) K₂
      fin_cases c
      · exact one_ne_zero
      · change x₁ ≠ 0
        intro h0
        rw [← map_zero (algebraMap (MvPolynomial (Fin 2) k) K₂)] at h0
        exact MvPolynomial.X_ne_zero 0 (hinj h0)
      · change x₂ ≠ 0
        intro h0
        rw [← map_zero (algebraMap (MvPolynomial (Fin 2) k) K₂)] at h0
        exact MvPolynomial.X_ne_zero 1 (hinj h0)
    have h_eval_eq : MvPolynomial.eval₂Hom (((φ_K₂ 0).toRingHom).comp MvPolynomial.C)
        (fun j : Fin 2 => hom_ψ₀ (c.succAbove j) / hom_ψ₀ c) = (φ_K₂ c).toRingHom := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        change (φ_K₂ 0) (MvPolynomial.C a) = (φ_K₂ c) (MvPolynomial.C a)
        simp [φ_K₂]
      · intro j
        rw [MvPolynomial.eval₂Hom_X', h_hom_eq]
        change homCoord (c.succAbove j) / homCoord c = (φ_K₂ c) (MvPolynomial.X j)
        simp [φ_K₂]
    have h_inst := hTrans c K₂ (φ_K₂ 0).toRingHom h_hom_ne
    rwa [h_eval_eq] at h_inst

theorem weil_p1_nonstd_chart_infinity_gluing_and_sections (k : Type u) [Field k] [IsAlgClosed k]
    (j_aff_k : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    [AlgebraicGeometry.IsOpenImmersion j_aff_k]
    (hj_aff_k_hom : j_aff_k ≫ (weilProjectiveSpaceOver k 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf_k : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (hs_inf_k_hom : s_inf_k ≫ (weilProjectiveSpaceOver k 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_inf_k_compl : (Set.range j_aff_k.base)ᶜ = Set.range s_inf_k.base) :
    ∃ (c₀ lam₀ : k) (_ : lam₀ ≠ 0)
      (j_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left)
      (_ : AlgebraicGeometry.IsOpenImmersion j_inf)
      (σ_glue : Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k) ≃+*
        Localization.Away (Polynomial.X : Polynomial k)),
      (j_inf ≫ (weilProjectiveSpaceOver k 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))) ≫ j_inf =
          s_inf_k) ∧
      (j_inf.base ⁻¹' Set.range j_aff_k.base =
        { q : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
          (Polynomial.X : Polynomial k) ∉ q.asIdeal } ∧
        j_aff_k.base ⁻¹' Set.range j_inf.base =
          { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
            Polynomial.X - Polynomial.C c₀ ∉ p.asIdeal }) ∧
      ((∀ c : k,
          σ_glue (algebraMap (Polynomial k)
            (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)) (Polynomial.C c)) =
          algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
            (Polynomial.C c)) ∧
        σ_glue (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)) Polynomial.X) =
          algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
            (Polynomial.C c₀) +
          algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
            (Polynomial.C lam₀) *
            IsLocalization.Away.invSelf (Polynomial.X : Polynomial k) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_glue.toRingHom) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Polynomial k)
              (Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k)))) ≫
          j_aff_k =
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Polynomial k)
              (Localization.Away (Polynomial.X : Polynomial k)))) ≫
          j_inf) :=
by
  classical
  
  
  
  have hPillar1 : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k 1).hom ∧
      ∃ (j_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
          (weilProjectiveSpaceOver k 1).left)
        (_ : AlgebraicGeometry.IsOpenImmersion j_inf),
        j_inf ≫ (weilProjectiveSpaceOver k 1).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))) ≫ j_inf =
          s_inf_k := by
    let P_mv := MvPolynomial (Fin (1 + 1)) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    refine ⟨by dsimp [weilProjectiveSpaceOver]; infer_instance, ?_⟩
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
    let x_inf : ProjectiveSpectrum 𝒜 := s_inf_k.base pt₀
    have hex_i₀ : ∃ i₀ : Fin (1 + 1), MvPolynomial.X i₀ ∉ x_inf.asHomogeneousIdeal := by
      by_contra h_all
      push Not at h_all
      apply x_inf.not_irrelevant_le
      intro f hf
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hf
      rw [← DirectSum.sum_support_decompose 𝒜 f]
      apply Ideal.sum_mem
      intro n _
      by_cases hn0 : n = 0
      · subst hn0
        have h0 : (DirectSum.decompose 𝒜 f 0 : P_mv) = 0 := by
          rwa [GradedRing.proj_apply] at hf
        rw [h0]
        exact Ideal.zero_mem _
      · have hg_mem : (DirectSum.decompose 𝒜 f n : P_mv) ∈ 𝒜 n :=
          (DirectSum.decompose 𝒜 f n).2
        have hg_hom : (DirectSum.decompose 𝒜 f n : P_mv).IsHomogeneous n :=
          (MvPolynomial.mem_homogeneousSubmodule n _).mp hg_mem
        have h_in_span : (DirectSum.decompose 𝒜 f n : P_mv) ∈
            Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (1 + 1)))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          have hm_deg : (∑ i : Fin (1 + 1), m i) = n := by
            have h1 := hg_hom (MvPolynomial.mem_support_iff.mp hm)
            simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
          by_contra h_zero
          push Not at h_zero
          have : (∑ i : Fin (1 + 1), m i) = 0 :=
            Finset.sum_eq_zero (fun i _ => h_zero i (Set.mem_univ i))
          exact hn0 (hm_deg.symm.trans this)
        have h_span_le : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (1 + 1)))) ≤
            x_inf.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨i, _, rfl⟩
          exact h_all i
        exact h_span_le h_in_span
    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    let i₁ : Fin (1 + 1) := if i₀ = 0 then 1 else 0
    have hi₁_ne : i₁ ≠ i₀ := by fin_cases i₀ <;> decide
    let X₀ : P_mv := MvPolynomial.X i₀
    let X₁ : P_mv := MvPolynomial.X i₁
    have hX₀_deg : X₀ ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 X₀).mpr (MvPolynomial.isHomogeneous_X k i₀)
    have hX₁_deg : X₁ ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 X₁).mpr (MvPolynomial.isHomogeneous_X k i₁)
    let H₀ := HomogeneousLocalization.Away 𝒜 X₀
    let M₀ : Submonoid P_mv := Submonoid.powers X₀
    have hpow_mem : ∀ n : ℕ, X₀ ^ n ∈ M₀ := fun n => pow_mem (Submonoid.mem_powers X₀) n
    let ι₀_hom : k →+* H₀ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 M₀).comp (algebraMap k ↥(𝒜 0))
    have hι₀_val : ∀ c : k, (ι₀_hom c).val = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
      intro c
      change (HomogeneousLocalization.mk _).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
      rw [HomogeneousLocalization.val_mk]
      rfl
    let ξ_hom : H₀ :=
      HomogeneousLocalization.mk
        { deg := 1
          num := ⟨X₁, hX₁_deg⟩
          den := ⟨X₀, hX₀_deg⟩
          den_mem := Submonoid.mem_powers X₀ }
    have hξ_val : ξ_hom.val = Localization.mk X₁ (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀) := rfl
    let α_proj : Polynomial k →+* H₀ := Polynomial.eval₂RingHom ι₀_hom ξ_hom
    let δ_mv : P_mv →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i₀ then 1 else Polynomial.X)
    have hδ_X₀ : δ_mv X₀ = 1 := by
      dsimp [δ_mv, X₀]
      rw [MvPolynomial.eval₂Hom_X']
      simp
    have hδ_X₁ : δ_mv X₁ = Polynomial.X := by
      dsimp [δ_mv, X₁]
      rw [MvPolynomial.eval₂Hom_X']
      simp [hi₁_ne]
    have hδ_mem : ∀ y : M₀, δ_mv y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      simp [map_pow, hδ_X₀]
    have hUnit_M₀ : ∀ y : M₀, IsUnit (δ_mv y.1) := by
      intro y
      rw [hδ_mem y]
      exact isUnit_one
    let δ_loc : Localization M₀ →+* Polynomial k := IsLocalization.lift hUnit_M₀
    have hδ_loc_mk : ∀ (p : P_mv) (y : M₀), δ_loc (Localization.mk p y) = δ_mv p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit_M₀ p (δ_mv p) y).mpr
        (by rw [hδ_mem y, one_mul])
    let valHom : H₀ →+* Localization M₀ :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun x y => HomogeneousLocalization.val_mul x y
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun x y => HomogeneousLocalization.val_add x y }
    let β_proj : H₀ →+* Polynomial k := δ_loc.comp valHom
    have h_left : ∀ q : Polynomial k, β_proj (α_proj q) = q := by
      have hcomp : β_proj.comp α_proj = RingHom.id (Polynomial k) := by
        apply Polynomial.ringHom_ext
        · intro c
          change δ_loc (Polynomial.eval₂ ι₀_hom ξ_hom (Polynomial.C c)).val = Polynomial.C c
          rw [Polynomial.eval₂_C, hι₀_val c, hδ_loc_mk]
          dsimp [δ_mv]
          rw [MvPolynomial.eval₂Hom_C]
        · change δ_loc (Polynomial.eval₂ ι₀_hom ξ_hom Polynomial.X).val = Polynomial.X
          rw [Polynomial.eval₂_X, hξ_val, hδ_loc_mk, hδ_X₁]
      intro q
      exact RingHom.congr_fun hcomp q
    let φ_homog : P_mv →+* Localization M₀ := valHom.comp (α_proj.comp δ_mv)
    have hφ_C : ∀ c : k, φ_homog (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
      intro c
      change (α_proj (δ_mv (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
      have hc1 : δ_mv (MvPolynomial.C c) = Polynomial.C c := by
        dsimp [δ_mv]
        rw [MvPolynomial.eval₂Hom_C]
      have hc2 : α_proj (Polynomial.C c) = ι₀_hom c := by simp [α_proj]
      rw [hc1, hc2, hι₀_val c]
    have hφ_X₀ : φ_homog X₀ = Localization.mk X₀ (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀) := by
      change (α_proj (δ_mv X₀)).val = _
      rw [hδ_X₀, map_one, HomogeneousLocalization.val_one]
      exact (Localization.mk_self (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀)).symm
    have hφ_X₁ : φ_homog X₁ = Localization.mk X₁ (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀) := by
      change (α_proj (δ_mv X₁)).val = _
      have hx : α_proj Polynomial.X = ξ_hom := by simp [α_proj]
      rw [hδ_X₁, hx, hξ_val]
    have h_monomial_fin2 : ∀ (m : Fin (1 + 1) →₀ ℕ) (c : k),
        MvPolynomial.monomial m c = MvPolynomial.C c * X₀ ^ (m i₀) * X₁ ^ (m i₁) ∧
        m i₀ + m i₁ = m 0 + m 1 := by
      intro m c
      have hm_split : m = Finsupp.single i₀ (m i₀) + Finsupp.single i₁ (m i₁) := by
        ext j
        fin_cases i₀ <;> fin_cases j <;> simp [i₁]
      refine ⟨?_, ?_⟩
      · conv_lhs => rw [hm_split]
        have hc : MvPolynomial.monomial (Finsupp.single i₀ (m i₀) + Finsupp.single i₁ (m i₁)) c =
            MvPolynomial.C c * MvPolynomial.monomial (Finsupp.single i₀ (m i₀)) 1 *
              MvPolynomial.monomial (Finsupp.single i₁ (m i₁)) 1 := by
          rw [MvPolynomial.C_mul_monomial, mul_one, MvPolynomial.monomial_mul_monomial, mul_one]
        rw [hc, ← MvPolynomial.X_pow_eq_monomial, ← MvPolynomial.X_pow_eq_monomial]
      · fin_cases i₀ <;> simp [i₁, add_comm]
    have hφ_monomial : ∀ (m : Fin (1 + 1) →₀ ℕ) (c : k) (n : ℕ),
        (Finsupp.weight 1) m = n →
        φ_homog (MvPolynomial.monomial m c) =
          Localization.mk (MvPolynomial.monomial m c) ⟨X₀ ^ n, hpow_mem n⟩ := by
      intro m c n hmn
      obtain ⟨hm_eq, hm_sum⟩ := h_monomial_fin2 m c
      have hm_deg : m i₀ + m i₁ = n := by
        have h2 : m 0 + m 1 = n := by
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hmn
        exact hm_sum.trans h2
      conv_lhs => rw [hm_eq]
      rw [map_mul, map_mul, map_pow, map_pow, hφ_C c, hφ_X₀, hφ_X₁,
        Localization.mk_pow, Localization.mk_pow, Localization.mk_mul, Localization.mk_mul]
      rw [← hm_eq]
      congr 1
      apply Subtype.ext
      change (1 : P_mv) * X₀ ^ m i₀ * X₀ ^ m i₁ = X₀ ^ n
      rw [one_mul, ← pow_add, hm_deg]
    have hφ_homog_deg : ∀ (n : ℕ) (p : P_mv), p.IsHomogeneous n →
        φ_homog p = Localization.mk p ⟨X₀ ^ n, hpow_mem n⟩ := by
      intro n p hp
      have h_sum_aux : ∀ (S_fin : Finset (Fin (1 + 1) →₀ ℕ)),
          (∀ m ∈ S_fin, (Finsupp.weight 1) m = n) →
          φ_homog (∑ m ∈ S_fin, MvPolynomial.monomial m (p.coeff m)) =
            Localization.mk (∑ m ∈ S_fin, MvPolynomial.monomial m (p.coeff m))
              ⟨X₀ ^ n, hpow_mem n⟩ := by
        intro S_fin hS
        induction S_fin using Finset.induction_on with
        | empty => simp [Localization.mk_zero]
        | @insert m S_fin hm ih =>
          rw [Finset.sum_insert hm, map_add,
            hφ_monomial m (p.coeff m) n (hS m (Finset.mem_insert_self m S_fin)),
            ih (fun m' hm' => hS m' (Finset.mem_insert_of_mem hm')),
            Localization.add_mk_self]
      conv_lhs => rw [MvPolynomial.as_sum p]
      conv_rhs => rw [MvPolynomial.as_sum p]
      exact h_sum_aux p.support (fun m hm => hp (MvPolynomial.mem_support_iff.mp hm))
    have h_right : ∀ z : H₀, α_proj (β_proj z) = z := by
      intro z
      refine Quotient.inductionOn' z fun nd => ?_
      apply HomogeneousLocalization.val_injective
      obtain ⟨n, hn⟩ := nd.den_mem
      dsimp only at hn
      have hX₀n_ne : (X₀ ^ n : P_mv) ≠ 0 := by
        intro hzero
        have hev := congrArg (MvPolynomial.eval (fun _ : Fin (1 + 1) => (1 : k))) hzero
        simp [X₀] at hev
      have hex_d₀ : ∃ d₀ : Fin (1 + 1) →₀ ℕ, ((X₀ ^ n : P_mv)).coeff d₀ ≠ 0 := by
        by_contra! hall0
        apply hX₀n_ne
        ext d₀
        simpa using hall0 d₀
      obtain ⟨d₀, hd₀⟩ := hex_d₀
      have hpow_homog : (X₀ ^ n : P_mv).IsHomogeneous n := by
        simpa using (MvPolynomial.isHomogeneous_X k i₀).pow n
      have hden_homog : (X₀ ^ n : P_mv).IsHomogeneous nd.deg := by
        rw [hn]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
      have hdeg_eq : nd.deg = n := (hden_homog hd₀).symm.trans (hpow_homog hd₀)
      have hnum_homog : nd.num.1.IsHomogeneous n := by
        rw [← hdeg_eq]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
      change valHom (α_proj (β_proj (HomogeneousLocalization.mk nd))) =
        (HomogeneousLocalization.mk nd).val
      simp only [β_proj, RingHom.comp_apply, valHom, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
      rw [HomogeneousLocalization.val_mk, hδ_loc_mk]
      change φ_homog nd.num.1 = _
      rw [hφ_homog_deg n nd.num.1 hnum_homog]
      congr 1
      exact Subtype.ext hn
    let e_proj : Polynomial k ≃+* H₀ :=
      { α_proj with
        invFun := β_proj
        left_inv := h_left
        right_inv := h_right }
    let φ_iso : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of H₀) :=
      AlgebraicGeometry.Spec.map e_proj.toCommRingCatIso.inv
    let j_away : AlgebraicGeometry.Spec (CommRingCat.of H₀) ⟶ AlgebraicGeometry.Proj 𝒜 :=
      AlgebraicGeometry.Proj.awayι 𝒜 X₀ hX₀_deg Nat.zero_lt_one
    let ι_chart : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left :=
      φ_iso ≫ j_away
    have hOpen_chart : AlgebraicGeometry.IsOpenImmersion ι_chart := by
      dsimp [ι_chart, φ_iso, j_away, weilProjectiveSpaceOver]
      infer_instance
    have hι_chart_hom : ι_chart ≫ (weilProjectiveSpaceOver k 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp [ι_chart, φ_iso, j_away, weilProjectiveSpaceOver]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        RingEquiv.toCommRingCatIso_inv, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      apply congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
      apply RingHom.ext
      intro c
      change e_proj.symm (ι₀_hom c) = Polynomial.C c
      have hc : e_proj (Polynomial.C c) = ι₀_hom c := by
        change α_proj (Polynomial.C c) = ι₀_hom c
        simp [α_proj]
      rw [← hc, e_proj.symm_apply_apply]
    have hx_mem : x_inf ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 X₀ :=
      (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 X₀ x_inf).mpr hi₀_not_mem
    have hx_range_j : x_inf ∈ j_away.opensRange := by
      dsimp [j_away]
      rwa [AlgebraicGeometry.Proj.opensRange_awayι]
    obtain ⟨z₀, hz₀⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hx_range_j
    let w_pt := AlgebraicGeometry.Spec.map e_proj.toCommRingCatIso.hom z₀
    have hw_pt : φ_iso w_pt = z₀ := by
      dsimp [φ_iso, w_pt]
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
      rfl
    have hs_pt₀ : ι_chart w_pt = s_inf_k pt₀ := by
      change j_away (φ_iso w_pt) = x_inf
      rw [hw_pt]
      exact hz₀
    have hs_in_chart : Set.range ⇑s_inf_k ⊆ Set.range ⇑ι_chart := by
      rintro _ ⟨pt, rfl⟩
      have hpt : pt = pt₀ := (Unique.eq_default pt).trans (Unique.eq_default pt₀).symm
      rw [hpt, ← hs_pt₀]
      exact ⟨w_pt, rfl⟩
    let s_lift := AlgebraicGeometry.IsOpenImmersion.lift ι_chart s_inf_k hs_in_chart
    have hs_lift_fac : s_lift ≫ ι_chart = s_inf_k :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_chart s_inf_k hs_in_chart
    let ψ_s : Polynomial k →+* k := (AlgebraicGeometry.Spec.preimage s_lift).hom
    have hψ_s_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) = s_lift := by
      dsimp [ψ_s]
      exact AlgebraicGeometry.Spec.map_preimage s_lift
    have hψ_s_C : ψ_s.comp Polynomial.C = RingHom.id k := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫
          ι_chart ≫ (weilProjectiveSpaceOver k 1).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        rw [← CategoryTheory.Category.assoc, hψ_s_map, hs_lift_fac, hs_inf_k_hom]
      rw [hι_chart_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_id] at h1
      have h2 := AlgebraicGeometry.Spec.map_injective h1
      ext c
      exact congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom c) h2
    let a_inf : k := ψ_s Polynomial.X
    let φ_sh_fwd : Polynomial k →+* Polynomial k :=
      (Polynomial.aeval (Polynomial.X + Polynomial.C a_inf : Polynomial k)).toRingHom
    let φ_sh_inv : Polynomial k →+* Polynomial k :=
      (Polynomial.aeval (Polynomial.X - Polynomial.C a_inf : Polynomial k)).toRingHom
    have hφ_sh_id1 : φ_sh_inv.comp φ_sh_fwd = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext
      · intro c; simp [φ_sh_fwd, φ_sh_inv]
      · simp [φ_sh_fwd, φ_sh_inv]
    have hφ_sh_id2 : φ_sh_fwd.comp φ_sh_inv = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext
      · intro c; simp [φ_sh_fwd, φ_sh_inv]
      · simp [φ_sh_fwd, φ_sh_inv]
    let e_sh : Polynomial k ≃+* Polynomial k :=
      { φ_sh_fwd with
        invFun := φ_sh_inv
        left_inv := fun q => RingHom.congr_fun hφ_sh_id1 q
        right_inv := fun q => RingHom.congr_fun hφ_sh_id2 q }
    let j_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left :=
      AlgebraicGeometry.Spec.map e_sh.toCommRingCatIso.hom ≫ ι_chart
    have hj_inf_open : AlgebraicGeometry.IsOpenImmersion j_inf := by
      dsimp [j_inf]
      infer_instance
    have he_sh_hom : e_sh.toCommRingCatIso.hom = CommRingCat.ofHom φ_sh_fwd := rfl
    refine ⟨j_inf, hj_inf_open, ?_, ?_⟩
    · dsimp [j_inf]
      rw [he_sh_hom, CategoryTheory.Category.assoc, hι_chart_hom,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      apply congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
      ext c
      simp [φ_sh_fwd]
    · dsimp [j_inf]
      rw [he_sh_hom, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have h_ev_eq : (Polynomial.evalRingHom (0 : k)).comp φ_sh_fwd = ψ_s := by
        apply Polynomial.ringHom_ext
        · intro c
          have hc := congrArg (fun f => f c) hψ_s_C
          simpa [φ_sh_fwd] using hc.symm
        · simp [φ_sh_fwd, a_inf]
      rw [h_ev_eq, hψ_s_map, hs_lift_fac]

  obtain ⟨hSep, j_inf, hj_inf_open, hj_inf_hom, hj_inf_zero⟩ := hPillar1
  have _ : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k 1).hom := hSep
  have _ : AlgebraicGeometry.IsOpenImmersion j_inf := hj_inf_open

  
  
  
  have hPillar2 :
      (j_inf.base ⁻¹' Set.range j_aff_k.base =
        { q : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) |
          (Polynomial.X : Polynomial k) ∉ q.asIdeal }) ∧
      (∀ (τ : Polynomial k →+* Polynomial k),
        τ.comp Polynomial.C = Polynomial.C →
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Polynomial k)
              (Localization.Away (Polynomial.X : Polynomial k)))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ) ≫ j_aff_k ≠
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Polynomial k)
              (Localization.Away (Polynomial.X : Polynomial k)))) ≫
          j_inf) := by
    let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k) := default
    have hSpecK_bot : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k), pt.asIdeal = ⊥ := by
      intro pt
      exact (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
    have hSpecK_eq : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k), pt = pt₀ := by
      intro pt
      exact PrimeSpectrum.ext ((hSpecK_bot pt).trans (hSpecK_bot pt₀).symm)
    let q₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))).base pt₀
    have hq₀_ideal : q₀.asIdeal = RingHom.ker (Polynomial.evalRingHom (0 : k)) := by
      change Ideal.comap (Polynomial.evalRingHom (0 : k)) pt₀.asIdeal = _
      rw [hSpecK_bot pt₀]
      rfl
    have hq₀_max : q₀.asIdeal.IsMaximal := by
      rw [hq₀_ideal]
      apply RingHom.ker_isMaximal_of_surjective
      intro c
      exact ⟨Polynomial.C c, Polynomial.eval_C⟩
    have hq_eq_q₀ : ∀ q : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)),
        q = q₀ ↔ (Polynomial.X : Polynomial k) ∈ q.asIdeal := by
      intro q
      constructor
      · rintro rfl
        rw [hq₀_ideal, RingHom.mem_ker]
        simp
      · intro hX_mem
        have h_le : q₀.asIdeal ≤ q.asIdeal := by
          intro P hP
          rw [hq₀_ideal, RingHom.mem_ker] at hP
          have hdvd : (Polynomial.X : Polynomial k) ∣ P := by
            rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]
            exact hP
          obtain ⟨R_div, rfl⟩ := hdvd
          exact q.asIdeal.mul_mem_right R_div hX_mem
        exact PrimeSpectrum.ext (hq₀_max.eq_of_le q.isPrime.ne_top h_le).symm
    have hj_inf_q₀ : j_inf.base q₀ = s_inf_k.base pt₀ := by
      rw [← hj_inf_zero]
      rfl
    have hRange_sinf : Set.range s_inf_k.base = {j_inf.base q₀} := by
      ext y
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨pt, rfl⟩
        rw [hSpecK_eq pt, hj_inf_q₀]
      · rintro rfl
        exact ⟨pt₀, hj_inf_q₀.symm⟩
    have hRange_jaff : Set.range j_aff_k.base = ({j_inf.base q₀} : Set _)ᶜ := by
      rw [← hRange_sinf, ← hs_inf_k_compl, compl_compl]
    have hj_inf_pre : j_inf.base ⁻¹' Set.range j_aff_k.base =
