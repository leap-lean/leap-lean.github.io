          right_inv := fun ψ => by
            dsimp only
            rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
              hτ_hi, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id] }
      let totEquiv : (L_mod ⟶ 𝒢) ≃ (one_U ⟶ R_sh.obj 𝒢) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
          (postIso.trans (adj_U.homEquiv R_mod (R_sh.obj 𝒢)).symm)
      have hEq : (fun f : L_mod ⟶ 𝒢 => δ_U ≫ R_sh.map f) = totEquiv := by
        funext f
        apply (adj_U.homEquiv R_mod (R_sh.obj 𝒢)).injective
        exact (hδ_eval f).trans ((adj_U.homEquiv R_mod (R_sh.obj 𝒢)).apply_symm_apply _).symm
      rw [hEq]
      exact totEquiv.bijective
    obtain ⟨δ_U, hδ_U_bij⟩ := hδ_U
    let Γ_U : CategoryTheory.Abelian.Ext.{u} L_mod one_S q →+
        CategoryTheory.Abelian.Ext.{u} one_U (R_sh.obj one_S) q :=
      ((CategoryTheory.Abelian.Ext.mk₀ δ_U).precomp (R_sh.obj one_S) (Nat.zero_add q)).comp
        (R_sh.mapExtAddHom L_mod one_S q)
    have hΓ_U_bij : Function.Bijective Γ_U :=
      weil_etale_abstract_exact_functor_ext_package.1 R_sh L_mod one_U δ_U hδ_U_bij
        (fun ℐ _ k ω => by
          have : CategoryTheory.Injective (R_sh.obj ℐ) := hInj_R ℐ
