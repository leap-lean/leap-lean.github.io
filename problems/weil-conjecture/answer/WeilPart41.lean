            (MvPolynomial.eval₂Hom sc.inr.hom (fun b => sc.inl.hom (MvPolynomial.X b))))
          (fun sc => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro r
              have hcond := congrArg (fun k => k.hom r) sc.condition
              simpa [f_p, g_p, inl_p] using hcond.symm
            · intro b
              simp [inl_p])
          (fun sc => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro r
            simp [inr_p])
          (fun sc m hm_inl hm_inr => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro r
              have hr := congrArg (fun k => k.hom r) hm_inr
              simpa [inr_p] using hr
            · intro b
              have hb := congrArg (fun k => k.hom (MvPolynomial.X b)) hm_inl
              simpa [inl_p] using hb)
      have hPush_p : CategoryTheory.IsPushout f_p g_p inl_p inr_p :=
        CategoryTheory.IsPushout.of_isColimit hColim_p
      have hg_Xa : g (MvPolynomial.X a) = MvPolynomial.X a :=
