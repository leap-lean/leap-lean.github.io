  have hNonempty_eY : Nonempty
      (CategoryTheory.Limits.pullback (weilAffineSpaceOver Ω δ).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))) ≅
      (weilAffineSpaceOver Ω (δ + 1)).left) := by
    let snoc_fn : Fin (δ + 1) → TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω) :=
      Fin.snoc (α := fun _ => TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω))
        (fun m : Fin δ => TensorProduct.tmul Ω (MvPolynomial.X m) (1 : Polynomial Ω))
        (TensorProduct.tmul Ω (1 : MvPolynomial (Fin δ) Ω) Polynomial.X)
    let Φ_sp : MvPolynomial (Fin (δ + 1)) Ω →ₐ[Ω]
        TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω) :=
      MvPolynomial.aeval snoc_fn
    let Ψ_sp : TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω) →ₐ[Ω]
        MvPolynomial (Fin (δ + 1)) Ω :=
      Algebra.TensorProduct.lift (R := Ω) (S := Ω)
        (MvPolynomial.rename Fin.castSucc)
        (Polynomial.aeval (MvPolynomial.X (Fin.last δ)))
        (fun _ _ => Commute.all _ _)
    have hΨΦ : Ψ_sp.comp Φ_sp = AlgHom.id Ω (MvPolynomial (Fin (δ + 1)) Ω) := by
      apply MvPolynomial.algHom_ext
      intro idx
      simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply, Φ_sp, MvPolynomial.aeval_X]
      refine Fin.lastCases ?_ (fun m => ?_) idx
      · dsimp only [snoc_fn, Ψ_sp]
        rw [Fin.snoc_last, Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X]
      · dsimp only [snoc_fn, Ψ_sp]
        rw [Fin.snoc_castSucc, Algebra.TensorProduct.lift_tmul, map_one, mul_one,
          MvPolynomial.rename_X]
    have hΦΨ : Φ_sp.comp Ψ_sp =
        AlgHom.id Ω (TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω)) := by
      apply Algebra.TensorProduct.ext
      · apply MvPolynomial.algHom_ext
        intro m
        simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply,
          Algebra.TensorProduct.includeLeft_apply]
        dsimp only [Ψ_sp, Φ_sp, snoc_fn]
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, MvPolynomial.rename_X,
          MvPolynomial.aeval_X, Fin.snoc_castSucc]
      · apply Polynomial.algHom_ext
        simp only [AlgHom.restrictScalars_apply, AlgHom.coe_comp, Function.comp_apply,
          AlgHom.id_apply, Algebra.TensorProduct.includeRight_apply]
        dsimp only [Ψ_sp, Φ_sp, snoc_fn]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X,
          MvPolynomial.aeval_X, Fin.snoc_last]
    let e_sp : MvPolynomial (Fin (δ + 1)) Ω ≃ₐ[Ω]
        TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω) :=
      AlgEquiv.ofAlgHom Φ_sp Ψ_sp hΦΨ hΨΦ
    let e_spec_sp :
        AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω))) ≅
        (weilAffineSpaceOver Ω (δ + 1)).left :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom)
        hom_inv_id := by
          change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ =
            𝟙 (AlgebraicGeometry.Spec _)
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : e_sp.toRingHom.comp e_sp.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_sp.apply_symm_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ =
            𝟙 (AlgebraicGeometry.Spec _)
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : e_sp.symm.toRingHom.comp e_sp.toRingHom = RingHom.id _ :=
            RingHom.ext e_sp.symm_apply_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    exact ⟨AlgebraicGeometry.pullbackSpecIso Ω (MvPolynomial (Fin δ) Ω) (Polynomial Ω) ≪≫ e_spec_sp⟩

  
  
  
  have hP0 : Nonempty (weilEtaleTorsionSheaf Y.left ℓ ≅
      weilEtaleHigherDirectImage j 0 (weilEtaleTorsionSheaf U ℓ)) := by
    obtain ⟨e_Y⟩ := hNonempty_eY
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let S_δ := weilAffineSpaceOver Ω δ
    let A1_Ω := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))
    let Gm_Ω := AlgebraicGeometry.Spec (CommRingCat.of
      (Localization.Away (Polynomial.X : Polynomial Ω)))
    let j_Gm : Gm_Ω ⟶ A1_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω))))
    let p_A1 : A1_Ω ⟶ S_Ω :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))
    let Y_δ := CategoryTheory.Limits.pullback S_δ.hom p_A1
    let j_δ := CategoryTheory.Limits.pullback.snd j_Gm (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
    have hBasis_int : ∀ (W' : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W']
        (w : W' ⟶ Y.left) [AlgebraicGeometry.Etale w] (x : ↥W'),
        ∃ (O : W'.Opens) (α : Fin M) (u_O : O.toScheme ⟶ (W α).toScheme),
          AlgebraicGeometry.IsAffineOpen O ∧
          x ∈ O ∧
          IsPreirreducible (O : Set ↥W') ∧
          ConnectedSpace ↥O.toScheme ∧
          AlgebraicGeometry.Etale u_O ∧
          u_O ≫ (W α).ι = O.ι ≫ w := by
      intro W' _ w _ x
      have hwx_top : w.base x ∈ (⊤ : Y.left.Opens) := trivial
      rw [← hSupW] at hwx_top
      obtain ⟨α, hwx_α⟩ := TopologicalSpace.Opens.mem_iSup.mp hwx_top
      let U_α : W'.Opens := (TopologicalSpace.Opens.map w.base).obj (W α)
      have hx_Uα : x ∈ U_α := hwx_α
      obtain ⟨O₀, hAffO₀, hxO₀, hO₀_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_Uα
      have hRange_O₀ : Set.range (O₀.ι ≫ w).base ⊆ Set.range (W α).ι.base := by
        rintro _ ⟨y, rfl⟩
        exact ⟨⟨w.base y.1, hO₀_le y.2⟩, rfl⟩
      let u₀ : O₀.toScheme ⟶ (W α).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (W α).ι (O₀.ι ≫ w) hRange_O₀
      have hu₀_fac : u₀ ≫ (W α).ι = O₀.ι ≫ w :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W α).ι (O₀.ι ≫ w) hRange_O₀
      have _ : AlgebraicGeometry.Etale u₀ :=
        CategoryTheory.MorphismProperty.of_postcomp P_et u₀ (W α).ι
          (inferInstance : AlgebraicGeometry.Etale (W α).ι) (by rw [hu₀_fac]; infer_instance)
      have _ : AlgebraicGeometry.Etale e_Y.hom := inferInstance
      let u₁ : O₀.toScheme ⟶ (weilAffineSpaceOver Ω (δ + 1)).left := u₀ ≫ ϕ α ≫ e_Y.hom
      have _ : AlgebraicGeometry.Etale u₁ := inferInstance
      have _ : AlgebraicGeometry.IsAffine O₀.toScheme := hAffO₀
      let R₀ : CommRingCat.{u} := W'.presheaf.obj (Opposite.op O₀)
      let x₀ : ↥O₀.toScheme := ⟨x, hxO₀⟩
      let p_x : PrimeSpectrum R₀ := hAffO₀.isoSpec.hom.base x₀
      obtain ⟨m_id, hm_max, hp_le_m⟩ :=
        Ideal.exists_le_maximal p_x.asIdeal p_x.isPrime.ne_top
      let p_m : PrimeSpectrum R₀ := ⟨m_id, hm_max.isPrime⟩
      have hCl_pm : IsClosed ({p_m} : Set (PrimeSpectrum R₀)) :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_m).mpr hm_max
      have hSpec_pm : p_x ⤳ p_m :=
        (PrimeSpectrum.le_iff_specializes p_x p_m).mp hp_le_m
      let x_m : ↥O₀.toScheme := hAffO₀.isoSpec.inv.base p_m
      have hx₀_inv : hAffO₀.isoSpec.inv.base p_x = x₀ := by
        change (hAffO₀.isoSpec.hom ≫ hAffO₀.isoSpec.inv).base x₀ = x₀
        rw [hAffO₀.isoSpec.hom_inv_id]
        rfl
      have hSpec_xm : x₀ ⤳ x_m := by
        rw [← hx₀_inv]
        exact hSpec_pm.map hAffO₀.isoSpec.inv.continuous
      have hCl_xm : IsClosed ({x_m} : Set ↥O₀.toScheme) := by
        have hSet : ({x_m} : Set ↥O₀.toScheme) =
            hAffO₀.isoSpec.hom.base ⁻¹' ({p_m} : Set (PrimeSpectrum R₀)) := by
          ext z
          simp only [Set.mem_singleton_iff]
          constructor
          · rintro rfl
            change (hAffO₀.isoSpec.inv ≫ hAffO₀.isoSpec.hom).base p_m = p_m
            rw [hAffO₀.isoSpec.inv_hom_id]
            rfl
          · intro hz
            have h1 := congrArg hAffO₀.isoSpec.inv.base hz
            change (hAffO₀.isoSpec.hom ≫ hAffO₀.isoSpec.inv).base z = x_m at h1
            rwa [hAffO₀.isoSpec.hom_inv_id] at h1
        rw [hSet]
        exact hCl_pm.preimage hAffO₀.isoSpec.hom.continuous
      obtain ⟨U₁, hAffU₁, hxm_U₁, hIntU₁⟩ :=
        hSmoothIrred.1 (δ + 1) O₀.toScheme u₁ x_m hCl_xm
      have hx₀_U₁ : x₀ ∈ U₁ := hSpec_xm.mem_open U₁.isOpen hxm_U₁
      have _ : AlgebraicGeometry.IsAffine U₁.toScheme := hAffU₁
      have _ : AlgebraicGeometry.IsIntegral U₁.toScheme := hIntU₁
      have _ : IrreducibleSpace ↥U₁.toScheme :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral U₁.toScheme
      have _ : ConnectedSpace ↥U₁.toScheme := inferInstance
      let f_open : U₁.toScheme ⟶ W' := U₁.ι ≫ O₀.ι
      have _ : AlgebraicGeometry.IsOpenImmersion f_open := inferInstance
      let O : W'.Opens := f_open.opensRange
      have hAffO : AlgebraicGeometry.IsAffineOpen O :=
        AlgebraicGeometry.isAffineOpen_opensRange f_open
      have hxO : x ∈ O := ⟨⟨x₀, hx₀_U₁⟩, rfl⟩
      let e_O := AlgebraicGeometry.Scheme.Hom.isoOpensRange f_open
      have hPreO : IsPreirreducible (O : Set ↥W') := by
        have hEq : (O : Set ↥W') = f_open.base '' Set.univ := Set.image_univ.symm
        rw [hEq]
        exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥U₁.toScheme)).image
          f_open.base f_open.continuous.continuousOn
      have hConnO : ConnectedSpace ↥O.toScheme :=
        e_O.hom.homeomorph.surjective.connectedSpace e_O.hom.continuous
      let u_O : O.toScheme ⟶ (W α).toScheme := e_O.inv ≫ U₁.ι ≫ u₀
      have _ : AlgebraicGeometry.Etale e_O.inv := inferInstance
      have hEt_uO : AlgebraicGeometry.Etale u_O := inferInstance
      have hu_O_fac : u_O ≫ (W α).ι = O.ι ≫ w := by
        calc
          (e_O.inv ≫ U₁.ι ≫ u₀) ≫ (W α).ι
            = e_O.inv ≫ U₁.ι ≫ (u₀ ≫ (W α).ι) := by simp only [Category.assoc]
          _ = e_O.inv ≫ (U₁.ι ≫ O₀.ι) ≫ w := by rw [hu₀_fac]; simp only [Category.assoc]
          _ = (e_O.inv ≫ e_O.hom ≫ O.ι) ≫ w := by
                have hf : e_O.hom ≫ O.ι = f_open :=
                  AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι f_open
                rw [hf]; simp only [f_open, Category.assoc]
          _ = O.ι ≫ w := by
                rw [← Category.assoc e_O.inv e_O.hom, e_O.inv_hom_id, Category.id_comp]
      exact ⟨O, α, u_O, hAffO, hxO, hPreO, hConnO, hEt_uO, hu_O_fac⟩

    have hConnBasis : ∀ (W' : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W']
        (w : W' ⟶ Y.left) [AlgebraicGeometry.Etale w] (x : ↥W'),
        ∃ (O : W'.Opens),
          AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme := by
      intro W' _ w _ x
      obtain ⟨O, _, _, hAffO, hxO, _, hConnO, _, _⟩ := hBasis_int W' w x
      exact ⟨O, hAffO, hxO, hConnO⟩

    have hConn : ∀ (W' : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W']
        (w : W' ⟶ Y.left) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W' → Nonempty ↥W' →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j w) := by
      intro W' _ w _ hConnW' hNeW'
      have hPreW' : PreirreducibleSpace ↥W' := by
        rw [preirreducibleSpace_iff]
        intro A B hOpenA hOpenB ⟨a₀, _, ha₀⟩ ⟨b₀, _, hb₀⟩
        let C : Set ↥W' := closure A
        have hCl_C : IsClosed C := isClosed_closure
        have hNe_C : C.Nonempty := ⟨a₀, subset_closure ha₀⟩
        have hOpen_C : IsOpen C := by
          rw [isOpen_iff_forall_mem_open]
          intro x hxC
          obtain ⟨O, _, _, _, hxO, hPreO, _, _, _⟩ := hBasis_int W' w x
          refine ⟨(O : Set ↥W'), ?_, O.isOpen, hxO⟩
          intro z hzO
          rw [mem_closure_iff]
          intro N hOpenN hzN
          obtain ⟨y₁, hy₁O, hy₁A⟩ := (mem_closure_iff.mp hxC) (O : Set ↥W') O.isOpen hxO
          obtain ⟨y₂, _, hy₂A, hy₂N⟩ :=
            hPreO A N hOpenA hOpenN ⟨y₁, hy₁O, hy₁A⟩ ⟨z, hzO, hzN⟩
          exact ⟨y₂, hy₂N, hy₂A⟩
        have hC_univ : C = Set.univ := IsClopen.eq_univ ⟨hCl_C, hOpen_C⟩ hNe_C
        have hb_in_C : b₀ ∈ closure A := by
          change b₀ ∈ C
          rw [hC_univ]; trivial
        obtain ⟨y, hyB, hyA⟩ := (mem_closure_iff.mp hb_in_C) B hOpenB hb₀
        exact ⟨y, trivial, hyA, hyB⟩
      have _ : IrreducibleSpace ↥W' := { toPreirreducibleSpace := hPreW', toNonempty := hNeW' }
      obtain ⟨x₀⟩ := hNeW'
      obtain ⟨O₀, α₀, u₀, hAffO₀, hxO₀, _, hConnO₀, hEt_u₀, hu₀_fac⟩ := hBasis_int W' w x₀
      have _ : AlgebraicGeometry.IsAffine O₀.toScheme := hAffO₀
      have _ : AlgebraicGeometry.Etale u₀ := hEt_u₀
      let v₀ : O₀.toScheme ⟶ Y_δ := u₀ ≫ ϕ α₀
      have _ : AlgebraicGeometry.Etale v₀ := inferInstance
      obtain ⟨_, ⟨p₀⟩⟩ := hConn_δ O₀.toScheme v₀ hConnO₀ ⟨⟨x₀, hxO₀⟩⟩
      let l₀ : CategoryTheory.Limits.pullback j_δ v₀ ⟶
          CategoryTheory.Limits.pullback j (W α₀).ι :=
        (hPb α₀).lift (CategoryTheory.Limits.pullback.snd j_δ v₀ ≫ u₀)
          (CategoryTheory.Limits.pullback.fst j_δ v₀)
          (by dsimp [v₀]; rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition])
      let m₀ : CategoryTheory.Limits.pullback j_δ v₀ ⟶ CategoryTheory.Limits.pullback j w :=
        CategoryTheory.Limits.pullback.lift
          (l₀ ≫ CategoryTheory.Limits.pullback.fst j (W α₀).ι)
          (CategoryTheory.Limits.pullback.snd j_δ v₀ ≫ O₀.ι)
          (calc
            (l₀ ≫ CategoryTheory.Limits.pullback.fst j (W α₀).ι) ≫ j
              = l₀ ≫ (CategoryTheory.Limits.pullback.fst j (W α₀).ι ≫ j) := Category.assoc _ _ _
            _ = (l₀ ≫ CategoryTheory.Limits.pullback.snd j (W α₀).ι) ≫ (W α₀).ι := by
                  rw [CategoryTheory.Limits.pullback.condition, Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd j_δ v₀ ≫ (u₀ ≫ (W α₀).ι) := by
                  rw [(hPb α₀).lift_fst, Category.assoc]
            _ = (CategoryTheory.Limits.pullback.snd j_δ v₀ ≫ O₀.ι) ≫ w := by
                  rw [hu₀_fac, Category.assoc])
      have hNePb : Nonempty ↥(CategoryTheory.Limits.pullback j w) := ⟨m₀.base p₀⟩
      let snd_jw := CategoryTheory.Limits.pullback.snd j w
      have _ : AlgebraicGeometry.IsOpenImmersion snd_jw := inferInstance
      have hPrePb : PreirreducibleSpace ↥(CategoryTheory.Limits.pullback j w) := by
        rw [preirreducibleSpace_iff]
        intro V₁ V₂ hV₁ hV₂ ⟨z₁, _, hz₁⟩ ⟨z₂, _, hz₂⟩
        have hImg₁ : IsOpen (snd_jw.base '' V₁) := snd_jw.isOpenEmbedding.isOpenMap V₁ hV₁
        have hImg₂ : IsOpen (snd_jw.base '' V₂) := snd_jw.isOpenEmbedding.isOpenMap V₂ hV₂
        obtain ⟨_, -, ⟨q₁, hq₁, hsq₁⟩, ⟨q₂, hq₂, hsq₂⟩⟩ :=
          PreirreducibleSpace.isPreirreducible_univ (X := ↥W')
            (snd_jw.base '' V₁) (snd_jw.base '' V₂) hImg₁ hImg₂
            ⟨snd_jw.base z₁, trivial, ⟨z₁, hz₁, rfl⟩⟩
            ⟨snd_jw.base z₂, trivial, ⟨z₂, hz₂, rfl⟩⟩
        have hq_eq : q₁ = q₂ := snd_jw.isOpenEmbedding.injective (hsq₁.trans hsq₂.symm)
        subst hq_eq
        exact ⟨q₁, trivial, hq₁, hq₂⟩
      have _ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback j w) :=
        { toPreirreducibleSpace := hPrePb, toNonempty := hNePb }
      exact ⟨inferInstance, hNePb⟩

    exact weil_leray_sec_open_conn_torsion_pushforward_iso Y.left U j hConn hConnBasis ℓ

  
