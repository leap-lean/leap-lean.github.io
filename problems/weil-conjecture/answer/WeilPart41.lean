    obtain ⟨p_hom, hp_hom⟩ := hPullEx e_symm.hom ℓ 1
    have hp_hom_inv : p_hom.comp p_inv = AddMonoidHom.id _ := by
      obtain ⟨p_id, hp_id⟩ := hPullEx (e_symm.hom ≫ e_symm.inv) ℓ 1
      have h1 := hPullComp e_symm.hom e_symm.inv ℓ 1 p_hom p_inv p_id hp_hom hp_inv hp_id
      rw [e_symm.hom_inv_id] at hp_id
