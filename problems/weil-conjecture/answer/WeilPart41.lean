        exact hmk_succ
      let s_R := Ideal.Quotient.lift (I_k n) s_pre (fun _ hx => hs_ker hx)
      let s_bar := Polynomial.eval₂RingHom s_R (mk_u v_bar_last)
      have hq_s :
