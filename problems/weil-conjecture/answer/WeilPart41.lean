          (δ_conn f'_k hSE_X' p')
          (weilEtaleHigherDirectImageMap f'_k (p' + 1) (C_X'.map u_s))
          (weilEtaleHigherDirectImageMap f'_k (p' + 1) (C_X'.map v_s))
          (δ_conn f'_k hSE_X' (p' + 1))
          ha₀₁ ha₁₂ ha₂₃ h0_right_S'0 h0_mid_S'1 h0_left_S'1
          (hex_right_S0.map pb_η) (hex_mid_S1.map pb_η) (hex_left_S1.map pb_η)
          hex_right_S'0 hex_mid_S'1 hex_left_S'1
          (bcTor (ℓ ^ s₀) p') (bcTor ℓ (p' + 1)) (bcTor (ℓ ^ (s₀ + 1)) (p' + 1))
