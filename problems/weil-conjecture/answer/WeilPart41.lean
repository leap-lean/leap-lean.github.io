        exact hFive4 a₁ a₂ a₃
          (weilEtaleHigherDirectImageMap f'_k 0 (C_X'.map u_s))
          (weilEtaleHigherDirectImageMap f'_k 0 (C_X'.map v_s))
          (δ_conn f'_k hSE_X' 0)
