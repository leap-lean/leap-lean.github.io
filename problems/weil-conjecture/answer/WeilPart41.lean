  obtain ⟨Q, hQ_ne, σ₀, hj_aff_pre_Q, hσ₀_C, hσ₀_comm⟩ := hPillar3

  
  
  
  have hPillar4 : ∃ (c₀ lam₀ : k) (_ : lam₀ ≠ 0)
      (σ_glue : Localization.Away (Polynomial.X - Polynomial.C c₀ : Polynomial k) ≃+*
        Localization.Away (Polynomial.X : Polynomial k)),
      (∃ (a : k) (_ : a ≠ 0) (e : ℕ),
        1 ≤ e ∧ Q = Polynomial.C a * (Polynomial.X - Polynomial.C c₀) ^ e) ∧
