        refine Polynomial.ringHom_ext (fun a => ?_) ?_
        · obtain ⟨m, rfl⟩ := Ideal.Quotient.mk_surjective a
          change q_bar (s_bar (Polynomial.C (Ideal.Quotient.mk (I_k n) m))) =
            Polynomial.C (Ideal.Quotient.mk (I_k n) m)
          rw [show s_bar (Polynomial.C (Ideal.Quotient.mk (I_k n) m)) = s_pre m by
