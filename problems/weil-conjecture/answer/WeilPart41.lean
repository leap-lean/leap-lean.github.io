      have h_eq_WU : (g₁.comap π_W.base.hom).comap p_W.base.hom =
          (g₂.comap π_W.base.hom).comap p_W.base.hom := by
        have h_comm : ∀ g : LocallyConstant ↥E (ULift.{u} (ZMod m₀)),
            (g.comap π_W.base.hom).comap p_W.base.hom =
              (g.comap π_U.base.hom).comap q_WU.base.hom := by
          intro g
          apply LocallyConstant.ext
          intro z
          change g (π_W.base (p_W.base z)) = g (π_U.base (q_WU.base z))
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            ← AlgebraicGeometry.Scheme.Hom.comp_apply, hPb_EWU.w]
        rw [h_comm g₁, h_comm g₂, h_eq]
      have h_eq_W : g₁.comap π_W.base.hom = g₂.comap π_W.base.hom :=
        (hBij_W E_W g_W).1 h_eq_WU
      apply LocallyConstant.ext
      intro y
      rcases hCov y with ⟨u, rfl⟩ | ⟨w, rfl⟩
      · exact congrArg (fun f : LocallyConstant ↥E_U _ => f u) h_eq
      · exact congrArg (fun f : LocallyConstant ↥E_W _ => f w) h_eq_W
    · 
      intro f_U
      obtain ⟨f_W, hf_W⟩ := (hBij_W E_W g_W).2 (f_U.comap q_WU.base.hom)
      have hInj_πU : Function.Injective π_U.base := π_U.isOpenEmbedding.injective
      have hCross : ∀ (u : ↥E_U) (w : ↥E_W), π_U.base u = π_W.base w → f_U u = f_W w := by
        intro u w huw
        obtain ⟨z, hzW, hzU⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_EWU w u huw.symm
        have hz_eq := congrArg (fun h : LocallyConstant ↥E_WU _ => h z) hf_W
        change f_W (p_W.base z) = f_U (q_WU.base z) at hz_eq
        rw [hzW, hzU] at hz_eq
        exact hz_eq.symm
      have hSelf : ∀ w₁ w₂ : ↥E_W, π_W.base w₁ = π_W.base w₂ → f_W w₁ = f_W w₂ := by
        let E_WW := CategoryTheory.Limits.pullback π_W π_W
        let pr₁ : E_WW ⟶ E_W := CategoryTheory.Limits.pullback.fst π_W π_W
        let pr₂ : E_WW ⟶ E_W := CategoryTheory.Limits.pullback.snd π_W π_W
        let g_WW : E_WW ⟶ W_R := pr₁ ≫ g_W
        let E_WWU := CategoryTheory.Limits.pullback g_WW W_open.ι
        let fst_WWU : E_WWU ⟶ E_WW := CategoryTheory.Limits.pullback.fst g_WW W_open.ι
        let snd_WWU : E_WWU ⟶ W_open.toScheme := CategoryTheory.Limits.pullback.snd g_WW W_open.ι
        let ℓ₁ : E_WWU ⟶ E_WU :=
          CategoryTheory.Limits.pullback.lift (fst_WWU ≫ pr₁) snd_WWU
            (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
        have h_pr2_comm : (fst_WWU ≫ pr₂ ≫ g_W) ≫ e_W = (snd_WWU ≫ (e_W ∣_ U_Z)) ≫ U_Z.ι := by
          have hgW_e : g_W ≫ e_W = π_W ≫ h_E := CategoryTheory.Limits.pullback.condition.symm
          have hpr_π : pr₂ ≫ π_W = pr₁ ≫ π_W := CategoryTheory.Limits.pullback.condition.symm
          calc (fst_WWU ≫ pr₂ ≫ g_W) ≫ e_W
              = fst_WWU ≫ pr₂ ≫ (g_W ≫ e_W) := by simp only [CategoryTheory.Category.assoc]
            _ = fst_WWU ≫ (pr₂ ≫ π_W) ≫ h_E := by rw [hgW_e, CategoryTheory.Category.assoc]
            _ = fst_WWU ≫ pr₁ ≫ (π_W ≫ h_E) := by rw [hpr_π, CategoryTheory.Category.assoc]
            _ = (fst_WWU ≫ g_WW) ≫ e_W := by
                  rw [← hgW_e]
                  simp only [g_WW, CategoryTheory.Category.assoc]
            _ = snd_WWU ≫ (W_open.ι ≫ e_W) := by
                  rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
            _ = (snd_WWU ≫ (e_W ∣_ U_Z)) ≫ U_Z.ι := by
                  rw [← AlgebraicGeometry.morphismRestrict_ι e_W U_Z,
                    CategoryTheory.Category.assoc]
        let w₂_open : E_WWU ⟶ W_open.toScheme :=
          hPb_eW.lift (fst_WWU ≫ pr₂ ≫ g_W) (snd_WWU ≫ (e_W ∣_ U_Z)) h_pr2_comm
        let ℓ₂ : E_WWU ⟶ E_WU :=
          CategoryTheory.Limits.pullback.lift (fst_WWU ≫ pr₂) w₂_open
            (by
              rw [CategoryTheory.Category.assoc]
              exact (hPb_eW.lift_fst _ _ _).symm)
        have hℓ_q : ℓ₁ ≫ q_WU = ℓ₂ ≫ q_WU := by
          rw [← cancel_mono π_U, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            ← hPb_EWU.w, ← CategoryTheory.Category.assoc ℓ₁, ← CategoryTheory.Category.assoc ℓ₂,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition]
        have h_comap_WWU : (f_W.comap pr₁.base.hom).comap fst_WWU.base.hom =
            (f_W.comap pr₂.base.hom).comap fst_WWU.base.hom := by
          apply LocallyConstant.ext
          intro z
          have h1 : f_W (pr₁.base (fst_WWU.base z)) = f_U ((ℓ₁ ≫ q_WU).base z) := by
            have hℓ1_fst : ℓ₁ ≫ p_W = fst_WWU ≫ pr₁ :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hz1 : p_W.base (ℓ₁.base z) = pr₁.base (fst_WWU.base z) := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                ← AlgebraicGeometry.Scheme.Hom.comp_apply, hℓ1_fst]
            have hz_fW := congrArg (fun h : LocallyConstant ↥E_WU _ => h (ℓ₁.base z)) hf_W
            change f_W (p_W.base (ℓ₁.base z)) = f_U (q_WU.base (ℓ₁.base z)) at hz_fW
            rw [← hz1, hz_fW, AlgebraicGeometry.Scheme.Hom.comp_apply]
          have h2 : f_W (pr₂.base (fst_WWU.base z)) = f_U ((ℓ₂ ≫ q_WU).base z) := by
            have hℓ2_fst : ℓ₂ ≫ p_W = fst_WWU ≫ pr₂ :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hz2 : p_W.base (ℓ₂.base z) = pr₂.base (fst_WWU.base z) := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                ← AlgebraicGeometry.Scheme.Hom.comp_apply, hℓ2_fst]
            have hz_fW := congrArg (fun h : LocallyConstant ↥E_WU _ => h (ℓ₂.base z)) hf_W
            change f_W (p_W.base (ℓ₂.base z)) = f_U (q_WU.base (ℓ₂.base z)) at hz_fW
            rw [← hz2, hz_fW, AlgebraicGeometry.Scheme.Hom.comp_apply]
          change f_W (pr₁.base (fst_WWU.base z)) = f_W (pr₂.base (fst_WWU.base z))
          rw [h1, h2, hℓ_q]
        have h_comap_WW : f_W.comap pr₁.base.hom = f_W.comap pr₂.base.hom :=
          (hBij_W E_WW g_WW).1 h_comap_WWU
        intro w₁ w₂ hw
        obtain ⟨z, hz1, hz2⟩ :=
          @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            E_W E_W E π_W π_W w₁ w₂ hw
        have hz_eq := congrArg (fun h : LocallyConstant ↥E_WW _ => h z) h_comap_WW
        change f_W (pr₁.base z) = f_W (pr₂.base z) at hz_eq
        rwa [hz1, hz2] at hz_eq
      
      let _ : DecidablePred (fun y : ↥E => y ∈ Set.range π_U.base) := Classical.decPred _
      have hCov_else : ∀ (y : ↥E), y ∉ Set.range π_U.base → y ∈ Set.range π_W.base := by
        intro y hy
        rcases hCov y with h1 | h2
        · exact absurd h1 hy
        · exact h2
      let g₀ : ↥E → ULift.{u} (ZMod m₀) := fun y =>
        if hy : y ∈ Set.range π_U.base then f_U (Classical.choose hy)
        else f_W (Classical.choose (hCov_else y hy))
      have hg₀_U : ∀ u : ↥E_U, g₀ (π_U.base u) = f_U u := by
        intro u
        have hu : π_U.base u ∈ Set.range π_U.base := ⟨u, rfl⟩
        dsimp [g₀]
        simp only [hu, ↓reduceDIte]
        exact congrArg f_U (hInj_πU (Classical.choose_spec hu))
      have hg₀_W : ∀ w : ↥E_W, g₀ (π_W.base w) = f_W w := by
        intro w
        dsimp [g₀]
        by_cases hw : π_W.base w ∈ Set.range π_U.base
        · simp only [hw, ↓reduceDIte]
          exact hCross (Classical.choose hw) w (Classical.choose_spec hw)
        · simp only [hw, ↓reduceDIte]
          exact hSelf (Classical.choose (hCov_else (π_W.base w) hw)) w
            (Classical.choose_spec (hCov_else (π_W.base w) hw))
      have hg₀_lc : IsLocallyConstant g₀ := by
        intro s
        have hpre_eq : g₀ ⁻¹' s = π_U.base '' (f_U ⁻¹' s) ∪ π_W.base '' (f_W ⁻¹' s) := by
          ext y
          simp only [Set.mem_preimage, Set.mem_union, Set.mem_image]
          constructor
          · intro hy
            rcases hCov y with ⟨u, rfl⟩ | ⟨w, rfl⟩
            · left
              exact ⟨u, by rwa [← hg₀_U u], rfl⟩
            · right
              exact ⟨w, by rwa [← hg₀_W w], rfl⟩
          · rintro (⟨u, hu, rfl⟩ | ⟨w, hw, rfl⟩)
            · rwa [hg₀_U u]
            · rwa [hg₀_W w]
        rw [hpre_eq]
        exact IsOpen.union
          ((AlgebraicGeometry.Scheme.Hom.isOpenMap π_U) _ (f_U.isLocallyConstant s))
          ((AlgebraicGeometry.Scheme.Hom.isOpenMap π_W) _ (f_W.isLocallyConstant s))
      refine ⟨⟨g₀, hg₀_lc⟩, LocallyConstant.ext fun u => hg₀_U u⟩

  
  refine ⟨?_, ?_⟩
  · intro hc_Q hr_Q T_UQ hT_UQ T_QR hT_QR
    exact hOpenUnitIso U_Q.ι hSkyZero_Q p_Q0 hp_Q0 hBij_Q0 p_Q1 hp_Q1 hInj_Q1 hT_UQ hT_QR
  · have hp_Q0_copy := hp_Q0
    rcases hp_Q0_copy with ⟨hc_Q0, hr_Q0, _, _, _, T_UQ0, hT_UQ0, T_QR0, hT_QR0, _⟩
    have := hc_Q0
    have := hr_Q0
    have hIso_Q0 :=
      hOpenUnitIso U_Q.ι hSkyZero_Q p_Q0 hp_Q0 hBij_Q0 p_Q1 hp_Q1 hInj_Q1 hT_UQ0 hT_QR0
    have hBij_Q := (hConstIsoIffComap U_Q.ι hT_UQ0 hT_QR0).mp hIso_Q0
    have hBij_Z := hRoofTransfer hBij_Q
    intro hc_Z hr_Z T_UZ hT_UZ T_ZR hT_ZR
    exact (hConstIsoIffComap U_Z.ι hT_UZ hT_ZR).mpr hBij_Z

theorem weil_iso_roof_coker_open_pushforward_syzygy_shift (X U : AlgebraicGeometry.Scheme.{u}) (u : U ⟶ X) (m₀ n : ℕ)
    [hc_u : (weilEtaleSitePullback u).IsContinuous X.smallEtaleTopology U.smallEtaleTopology]
    [hr_u : ((weilEtaleSitePullback u).sheafPushforwardContinuous
      AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology).IsRightAdjoint]
    {T_U : U.Etale} (hT_U : CategoryTheory.Limits.IsTerminal T_U)
    {T_X : X.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X)
    (hIso_η :
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
      let adj_u := (weilEtaleSitePullback u).sheafAdjunctionContinuous
        AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology
      CategoryTheory.IsIso
        ((adj_u.homEquiv (weilEtaleTorsionSheaf X m₀) (weilEtaleTorsionSheaf U m₀))
          (weilEtaleConstPullbackHom u hT_U hT_X AM))) :
    (((∀ (q : ℕ), q ≤ n + 1 →
         ∀ (p_q : weilEtaleTorsionH X m₀ q →+ weilEtaleTorsionH U m₀ q),
           WeilIsTorsionEtalePullback u m₀ q p_q → Function.Bijective p_q) →
       (∀ (a : ℕ), 1 ≤ a →
         Subsingleton ((weilEtaleHigherDirectImage u a (weilEtaleTorsionSheaf U m₀)).H 0) →
         CategoryTheory.Limits.IsZero
           (weilEtaleHigherDirectImage u a (weilEtaleTorsionSheaf U m₀))) →
       (∀ (a : ℕ), 1 ≤ a → a ≤ n →
         CategoryTheory.Limits.IsZero
           (weilEtaleHigherDirectImage u a (weilEtaleTorsionSheaf U m₀))) ∧
       (∀ (p_top : weilEtaleTorsionH X m₀ (n + 2) →+ weilEtaleTorsionH U m₀ (n + 2)),
         WeilIsTorsionEtalePullback u m₀ (n + 2) p_top →
         ∃ (ι_edge : (weilEtaleHigherDirectImage u (n + 1)
             (weilEtaleTorsionSheaf U m₀)).H 0 →+ ↥p_top.ker),
           Function.Injective ι_edge)) ∧
     ((∀ (a : ℕ), 1 ≤ a → a ≤ n →
         CategoryTheory.Limits.IsZero
           (weilEtaleHigherDirectImage u a (weilEtaleTorsionSheaf U m₀))) →
       ∀ (p_Z : weilEtaleTorsionH X m₀ (n + 1) →+ weilEtaleTorsionH U m₀ (n + 1)),
         WeilIsTorsionEtalePullback u m₀ (n + 1) p_Z →
         ∃ (bdry_u : weilEtaleTorsionH U m₀ (n + 1) →+
             (weilEtaleHigherDirectImage u (n + 1) (weilEtaleTorsionSheaf U m₀)).H 0),
           ∀ y : weilEtaleTorsionH U m₀ (n + 1),
             bdry_u y = 0 → ∃ ξ : weilEtaleTorsionH X m₀ (n + 1), p_Z ξ = y)) :=
by
  
  have hSplitSES : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] {X₁ X₂ X₃ R₁ : 𝒜}
      (f : X₁ ⟶ X₂) [CategoryTheory.Mono f]
      (g : X₂ ⟶ X₃) (hfg : f ≫ g = 0)
      (hEx₁ : (CategoryTheory.ShortComplex.mk f g hfg).Exact)
      (δ : X₃ ⟶ R₁) [CategoryTheory.Epi δ] (hgδ : g ≫ δ = 0)
      (hEx₂ : (CategoryTheory.ShortComplex.mk g δ hgδ).Exact),
      ∃ (hfq : f ≫ CategoryTheory.Limits.factorThruImage g = 0)
        (hmδ : CategoryTheory.Limits.image.ι g ≫ δ = 0),
        (CategoryTheory.ShortComplex.mk f (CategoryTheory.Limits.factorThruImage g) hfq).ShortExact ∧
        (CategoryTheory.ShortComplex.mk (CategoryTheory.Limits.image.ι g) δ hmδ).ShortExact := by
    intro 𝒜 _ _ X₁ X₂ X₃ R₁ f _ g hfg hEx₁ δ _ hgδ hEx₂
    let q := CategoryTheory.Limits.factorThruImage g
    let m := CategoryTheory.Limits.image.ι g
    have hqm : q ≫ m = g := CategoryTheory.Limits.image.fac g
    have hfq : f ≫ q = 0 := by
      apply (cancel_mono m).mp
      rw [CategoryTheory.Category.assoc, hqm, hfg, CategoryTheory.Limits.zero_comp]
    have hmδ : m ≫ δ = 0 := by
      apply (cancel_epi q).mp
      rw [← CategoryTheory.Category.assoc, hqm, hgδ, CategoryTheory.Limits.comp_zero]
    have kf := hEx₁.fIsKernel
    let SC₁ := CategoryTheory.ShortComplex.mk f q hfq
    let lift₁ : ∀ s : CategoryTheory.Limits.Fork SC₁.g 0, s.pt ⟶ X₁ :=
      fun s => kf.lift (CategoryTheory.Limits.KernelFork.ofι s.ι (by
        change s.ι ≫ g = 0
        have hs : s.ι ≫ q = 0 := CategoryTheory.Limits.KernelFork.condition s
        rw [← hqm, ← CategoryTheory.Category.assoc, hs, CategoryTheory.Limits.zero_comp]))
    have hfac₁ : ∀ s : CategoryTheory.Limits.Fork SC₁.g 0, lift₁ s ≫ SC₁.f = s.ι :=
      fun s => kf.fac _ CategoryTheory.Limits.WalkingParallelPair.zero
    have hKer₁ : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι SC₁.f SC₁.zero) :=
      CategoryTheory.Limits.Fork.IsLimit.mk _ lift₁ hfac₁
        (fun s l hl => (cancel_mono f).mp (hl.trans (hfac₁ s).symm))
    have hSE₁ : SC₁.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel SC₁ hKer₁) inferInstance inferInstance
    have cf := hEx₂.gIsCokernel
    let SC₂ := CategoryTheory.ShortComplex.mk m δ hmδ
    let desc₂ : ∀ s : CategoryTheory.Limits.Cofork SC₂.f 0, R₁ ⟶ s.pt :=
      fun s => cf.desc (CategoryTheory.Limits.CokernelCofork.ofπ s.π (by
        change g ≫ s.π = 0
        have hs : m ≫ s.π = 0 := CategoryTheory.Limits.CokernelCofork.condition s
        rw [← hqm, CategoryTheory.Category.assoc, hs, CategoryTheory.Limits.comp_zero]))
    have hfac₂ : ∀ s : CategoryTheory.Limits.Cofork SC₂.f 0, SC₂.g ≫ desc₂ s = s.π :=
      fun s => cf.fac _ CategoryTheory.Limits.WalkingParallelPair.one
    have hCoker₂ : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ SC₂.g SC₂.zero) :=
      CategoryTheory.Limits.Cofork.IsColimit.mk _ desc₂ hfac₂
        (fun s l hl => (cancel_epi δ).mp (hl.trans (hfac₂ s).symm))
    have hSE₂ : SC₂.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₂ hCoker₂) inferInstance inferInstance
    exact ⟨hfq, hmδ, hSE₁, hSE₂⟩

  
  have hConnSurj : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      (Z₀ : 𝒜) {S : CategoryTheory.ShortComplex 𝒜} (hS : S.ShortExact)
      [CategoryTheory.Injective S.X₂] (k : ℕ),
      Function.Surjective (hS.extClass.postcomp Z₀ (rfl : k + 1 = k + 1)) := by
    intro 𝒜 _ _ _ Z₀ S hS _ k z
    have hz : z.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z₀ hS z hz rfl

  have hConnInj : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      (Z₀ : 𝒜) {S : CategoryTheory.ShortComplex 𝒜} (hS : S.ShortExact)
      [CategoryTheory.Injective S.X₂] (k : ℕ), 1 ≤ k →
      Function.Injective (hS.extClass.postcomp Z₀ (rfl : k + 1 = k + 1)) := by
    intro 𝒜 _ _ _ Z₀ S hS _ k hk
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, k = m + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
    obtain ⟨y, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z₀ hS x rfl hx
    have hy : y = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective y
    rw [hy, CategoryTheory.Abelian.Ext.zero_comp]

  let hIsoPostcomp : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      (Z₀ : 𝒜) {A B : 𝒜} (f : A ⟶ B) (g : B ⟶ A)
      (_ : f ≫ g = CategoryTheory.CategoryStruct.id A)
      (_ : g ≫ f = CategoryTheory.CategoryStruct.id B) (q : ℕ),
      CategoryTheory.Abelian.Ext Z₀ A q ≃+ CategoryTheory.Abelian.Ext Z₀ B q :=
    fun {_} _ _ _ Z₀ {_ _} f g hfg hgf q =>
      { toFun := (CategoryTheory.Abelian.Ext.mk₀ f).postcomp Z₀ (Nat.add_zero q)
        invFun := (CategoryTheory.Abelian.Ext.mk₀ g).postcomp Z₀ (Nat.add_zero q)
        left_inv := fun x => by
          change (x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q) = x
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hfg,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          change (y.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q) = y
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hgf,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        map_add' := map_add _ }

  
  let B_u := weilEtaleSitePullback u
  let pf_u := B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology U.smallEtaleTopology
  let pb_u := B_u.sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology U.smallEtaleTopology
  let adj_u := B_u.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology U.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
  let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_U := (CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ

  
  have hConstUnit : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {T T' : S.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (α : T' ⟶ T)
      (A : AddCommGrpCat.{u}),
      let J := S.smallEtaleTopology
      let C_S := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A ≫
        (C_S.obj A).obj.map α.op =
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A := by
    intro S T T' hT hT' α A J C_S
    dsimp [CategoryTheory.constantSheafAdj, CategoryTheory.constantPresheafAdj, C_S,
      CategoryTheory.constantSheaf]
    have hnat := ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const S.Etaleᵒᵖ).obj A)).naturality α.op
    dsimp at hnat ⊢
    simp only [CategoryTheory.Category.id_comp] at hnat ⊢
    exact hnat.symm

  have hConstSymm : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {T T' : S.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (α : T' ⟶ T)
      (A : AddCommGrpCat.{u})
      (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (g : A ⟶ 𝒢.obj.obj (Opposite.op T)),
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv A 𝒢).symm g =
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT').homEquiv A 𝒢).symm
        (g ≫ 𝒢.obj.map α.op) := by
    intro S T T' hT hT' α A 𝒢 g
    let J := S.smallEtaleTopology
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let adj' := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT'
    apply (adj'.homEquiv A 𝒢).injective
    rw [Equiv.apply_symm_apply]
    generalize hk_def : (adj.homEquiv A 𝒢).symm g = k
    have hk : g = (adj.homEquiv A 𝒢) k := by
      rw [← hk_def, Equiv.apply_symm_apply]
    rw [hk, CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change adj'.unit.app A ≫ k.hom.app (Opposite.op T') =
      (adj.unit.app A ≫ k.hom.app (Opposite.op T)) ≫ 𝒢.obj.map α.op
    rw [CategoryTheory.Category.assoc, ← k.hom.naturality α.op,
      ← CategoryTheory.Category.assoc, hConstUnit hT hT' α A]

  have hConstIndep : ∀ {T₁ T'₁ : U.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT'₁ : CategoryTheory.Limits.IsTerminal T'₁)
      {T₂ T'₂ : X.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (hT'₂ : CategoryTheory.Limits.IsTerminal T'₂)
      (A : AddCommGrpCat.{u}),
      weilEtaleConstPullbackHom u hT₁ hT₂ A = weilEtaleConstPullbackHom u hT'₁ hT'₂ A := by
    intro T₁ T'₁ hT₁ hT'₁ T₂ T'₂ hT₂ hT'₂ A
    dsimp only [weilEtaleConstPullbackHom]
    congr 1
    let α₁ : T'₁ ⟶ T₁ := hT₁.from T'₁
    let α₂ : T'₂ ⟶ T₂ := hT₂.from T'₂
    rw [hConstSymm hT₂ hT'₂ α₂ A]
    congr 1
    change ((CategoryTheory.constantSheafAdj U.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app A ≫
        ((CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
          (hT₁.from (B_u.obj T₂)).op) ≫
        ((CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
          (B_u.map α₂).op = _
    rw [CategoryTheory.Category.assoc,
      ← ((CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map_comp,
      ← op_comp]
    have hterm_eq : B_u.map α₂ ≫ hT₁.from (B_u.obj T₂) = hT'₁.from (B_u.obj T'₂) ≫ α₁ :=
      hT₁.hom_ext _ _
    rw [hterm_eq, op_comp,
      ((CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map_comp,
      ← CategoryTheory.Category.assoc, hConstUnit hT₁ hT'₁ α₁ A]
    rfl

  
  let πℤ : pb_u.obj Fℤ_X ⟶ Fℤ_U := weilEtaleConstPullbackHom u hT_U hT_X Aℤ
  have hUnpack₀ : ∃ (hAdd : pb_u.Additive)
      (hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_u)
      (hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_u)
      (ιℤ : Fℤ_U ⟶ pb_u.obj Fℤ_X),
      ιℤ ≫ πℤ = CategoryTheory.CategoryStruct.id Fℤ_U ∧
      πℤ ≫ ιℤ = CategoryTheory.CategoryStruct.id (pb_u.obj Fℤ_X) := by
    obtain ⟨p₀_dummy, hp₀_dummy⟩ := weil_etale_torsion_pullback_functoriality.{u}.1 u m₀ 0
    rcases hp₀_dummy with ⟨hc₀, hr₀, hAdd, hLim, hColim, T₁_₀, hT₁_₀, T₂_₀, hT₂_₀, ιℤ, hι1₀, hι2₀, _⟩
    cases Subsingleton.elim hc₀ hc_u
    cases Subsingleton.elim hr₀ hr_u
    have hπℤ_eq₀ : weilEtaleConstPullbackHom u hT₁_₀ hT₂_₀ Aℤ = πℤ :=
      hConstIndep hT₁_₀ hT_U hT₂_₀ hT_X Aℤ
    have hι1 : ιℤ ≫ πℤ = CategoryTheory.CategoryStruct.id Fℤ_U := by
      have hι1_fold : ιℤ ≫ weilEtaleConstPullbackHom u hT₁_₀ hT₂_₀ Aℤ =
          CategoryTheory.CategoryStruct.id Fℤ_U := hι1₀
      rwa [hπℤ_eq₀] at hι1_fold
    have hι2 : πℤ ≫ ιℤ = CategoryTheory.CategoryStruct.id (pb_u.obj Fℤ_X) := by
      have hι2_fold : weilEtaleConstPullbackHom u hT₁_₀ hT₂_₀ Aℤ ≫ ιℤ =
          CategoryTheory.CategoryStruct.id (pb_u.obj Fℤ_X) := hι2₀
      rwa [hπℤ_eq₀] at hι2_fold
    exact ⟨hAdd, hLim, hColim, ιℤ, hι1, hι2⟩
  obtain ⟨hAdd, hLim, hColim, ιℤ, hι1, hι2⟩ := hUnpack₀
  have _ : pb_u.Additive := hAdd
  have _ : CategoryTheory.Limits.PreservesFiniteLimits pb_u := hLim
  have _ : CategoryTheory.Limits.PreservesFiniteColimits pb_u := hColim

  
  let leray_u : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      (pf_u.obj G).H q →+ G.H q :=
    fun G q =>
      ((CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app G)).postcomp Fℤ_U (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_u.obj (pf_u.obj G)) (Nat.zero_add q)).comp
          (pb_u.mapExtAddHom Fℤ_X (pf_u.obj G) q))
  have hleray_def : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ) (w : (pf_u.obj G).H q),
      leray_u G q w =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u w) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app G)) (Nat.add_zero q) :=
    fun _ _ _ => rfl

  
  let πM : pb_u.obj (weilEtaleTorsionSheaf X m₀) ⟶ weilEtaleTorsionSheaf U m₀ :=
    weilEtaleConstPullbackHom u hT_U hT_X AM
  let η_u : weilEtaleTorsionSheaf X m₀ ⟶ pf_u.obj (weilEtaleTorsionSheaf U m₀) :=
    (adj_u.homEquiv (weilEtaleTorsionSheaf X m₀) (weilEtaleTorsionSheaf U m₀)) πM
  have _ : CategoryTheory.IsIso η_u := hIso_η
  let e_η : ∀ q : ℕ, weilEtaleTorsionH X m₀ q ≃+ (pf_u.obj (weilEtaleTorsionSheaf U m₀)).H q :=
    fun q => hIsoPostcomp Fℤ_X η_u (CategoryTheory.inv η_u)
      (CategoryTheory.IsIso.hom_inv_id η_u) (CategoryTheory.IsIso.inv_hom_id η_u) q
  have he_η_apply : ∀ (q : ℕ) (x : weilEtaleTorsionH X m₀ q),
      e_η q x = x.comp (CategoryTheory.Abelian.Ext.mk₀ η_u) (Nat.add_zero q) :=
    fun _ _ => rfl

  have hFactor : ∀ (q : ℕ) (p_q : weilEtaleTorsionH X m₀ q →+ weilEtaleTorsionH U m₀ q),
      WeilIsTorsionEtalePullback u m₀ q p_q →
      ∀ x : weilEtaleTorsionH X m₀ q,
        p_q x = leray_u (weilEtaleTorsionSheaf U m₀) q (e_η q x) := by
    intro q p_q hp_q x
    rcases hp_q with ⟨hc', hr', hAdd', hLim', hColim', T'₁, hT'₁, T'₂, hT'₂, ι'ℤ, hι'1, _, hp_eq⟩
    cases Subsingleton.elim hc' hc_u
    cases Subsingleton.elim hr' hr_u
    cases Subsingleton.elim hAdd' hAdd
    cases Subsingleton.elim hLim' hLim
    cases Subsingleton.elim hColim' hColim
    have hπ'ℤ : weilEtaleConstPullbackHom u hT'₁ hT'₂ Aℤ = πℤ :=
      hConstIndep hT'₁ hT_U hT'₂ hT_X Aℤ
    have hπ'M : weilEtaleConstPullbackHom u hT'₁ hT'₂ AM = πM :=
      hConstIndep hT'₁ hT_U hT'₂ hT_X AM
    have hι'1_fold : ι'ℤ ≫ weilEtaleConstPullbackHom u hT'₁ hT'₂ Aℤ =
        CategoryTheory.CategoryStruct.id Fℤ_U := hι'1
    have hι'_eq : ι'ℤ = ιℤ := by
      calc ι'ℤ = ι'ℤ ≫ CategoryTheory.CategoryStruct.id (pb_u.obj Fℤ_X) :=
            (CategoryTheory.Category.comp_id _).symm
        _ = ι'ℤ ≫ (πℤ ≫ ιℤ) := by rw [hι2]
        _ = (ι'ℤ ≫ weilEtaleConstPullbackHom u hT'₁ hT'₂ Aℤ) ≫ ιℤ := by
            rw [hπ'ℤ, CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.id Fℤ_U ≫ ιℤ := by rw [hι'1_fold]
        _ = ιℤ := CategoryTheory.Category.id_comp _
    have hπM_counit : πM = pb_u.map η_u ≫ adj_u.counit.app (weilEtaleTorsionSheaf U m₀) := by
      have hsymm : (adj_u.homEquiv (weilEtaleTorsionSheaf X m₀)
          (weilEtaleTorsionSheaf U m₀)).symm η_u = πM :=
        Equiv.symm_apply_apply _ πM
      rw [← hsymm, CategoryTheory.Adjunction.homEquiv_counit]
    have hp_fold : p_q x =
        ((CategoryTheory.Abelian.Ext.mk₀ ι'ℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleConstPullbackHom u hT'₁ hT'₂ AM))
          (Nat.add_zero q) := hp_eq x
    rw [hp_fold, hπ'M, hι'_eq, hπM_counit, hleray_def, he_η_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _ (CategoryTheory.Abelian.Ext.mk₀ (pb_u.map η_u))
        (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_u.map η_u))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app (weilEtaleTorsionSheaf U m₀)))
        (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  
  have hLerayNat : ∀ {F₁ F₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : F₁ ⟶ F₂) (q : ℕ) (w : (pf_u.obj F₁).H q),
      leray_u F₂ q (w.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_u.map ψ)) (Nat.add_zero q)) =
      (leray_u F₁ q w).comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero q) := by
    intro F₁ F₂ ψ q w
    rw [hleray_def, hleray_def,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_u.map (pf_u.map ψ))) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_u.map (pf_u.map ψ)))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app F₂)) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hnat : pb_u.map (pf_u.map ψ) ≫ adj_u.counit.app F₂ = adj_u.counit.app F₁ ≫ ψ :=
      adj_u.counit.naturality ψ
    rw [hnat, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app F₁))
        (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero q)]

  let e_0 : ∀ (F : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
      (pf_u.obj F).H 0 ≃+ F.H 0 := fun F =>
    { toFun := leray_u F 0
      invFun := fun u₀ => CategoryTheory.Abelian.Ext.mk₀
        ((adj_u.homEquiv Fℤ_X F) (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u₀))
      left_inv := fun w => by
        dsimp only
        have hw : CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ w) = w :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w
        have hleray : leray_u F 0 w = CategoryTheory.Abelian.Ext.mk₀
            (ιℤ ≫ (adj_u.homEquiv Fℤ_X F).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w)) := by
          conv_lhs => rw [← hw]
          rw [hleray_def, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Adjunction.homEquiv_counit, CategoryTheory.Category.assoc]
        rw [hleray]
        have haddev : CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀
              (ιℤ ≫ (adj_u.homEquiv Fℤ_X F).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w))) =
            ιℤ ≫ (adj_u.homEquiv Fℤ_X F).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w) := by
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
          exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply _
        rw [haddev, ← CategoryTheory.Category.assoc, hι2, CategoryTheory.Category.id_comp,
          Equiv.apply_symm_apply, hw]
      right_inv := fun u₀ => by
        dsimp only
        have hu₀ : CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ u₀) = u₀ :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply u₀
        rw [hleray_def, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        have hcounit : pb_u.map ((adj_u.homEquiv Fℤ_X F)
              (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u₀)) ≫ adj_u.counit.app F =
            πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u₀ := by
          have hsymm : (adj_u.homEquiv Fℤ_X F).symm ((adj_u.homEquiv Fℤ_X F)
              (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u₀)) =
              πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u₀ :=
            Equiv.symm_apply_apply _ _
          rw [CategoryTheory.Adjunction.homEquiv_counit] at hsymm
          exact hsymm
        rw [CategoryTheory.Category.assoc, hcounit, ← CategoryTheory.Category.assoc, hι1,
          CategoryTheory.Category.id_comp, hu₀]
      map_add' := map_add _ }

  
  have hInjAcyc : ∀ (J_sh : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective J_sh] (p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u p J_sh) := by
    intro J_sh _ p hp
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, p = m + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
    let Q_pre := CategoryTheory.Functor.comp B_u.op
      (CategoryTheory.Sheaf.cohomologyPresheaf J_sh (m + 1))
    have hQ_zero : CategoryTheory.Limits.IsZero Q_pre := by
      rw [CategoryTheory.Functor.isZero_iff]
      intro W
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro α
      change α = 0
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective α
    let L_X := CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    have _ : L_X.IsLeftAdjoint :=
      (CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}).isLeftAdjoint
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts L_X :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts L_X
    have _ : L_X.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts L_X
    exact L_X.map_isZero hQ_zero

  have hStepShiftAndConj : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
      let Q := CategoryTheory.Limits.cokernel (CategoryTheory.Injective.ι G)
      (∀ (q : ℕ), 1 ≤ q →
        Nonempty (weilEtaleHigherDirectImage u (q + 1) G ≅ weilEtaleHigherDirectImage u q Q)) ∧
      (CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u 1 G) →
        ∀ (k : ℕ), 1 ≤ k →
          ∃ (e_X : (pf_u.obj Q).H k ≃+ (pf_u.obj G).H (k + 1))
            (e_U : Q.H k ≃+ G.H (k + 1)),
            ∀ w : (pf_u.obj Q).H k,
              e_U (leray_u Q k w) = leray_u G (k + 1) (e_X w)) := by
    intro G Q
    let I := CategoryTheory.Injective.under G
    let ι_G := CategoryTheory.Injective.ι G
    let π_G := CategoryTheory.Limits.cokernel.π ι_G
    let SC_U := CategoryTheory.ShortComplex.mk ι_G π_G (CategoryTheory.Limits.cokernel.condition ι_G)
    have hSE_U : SC_U.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel ι_G) inferInstance inferInstance
    have hAcyc_I : ∀ p : ℕ, 1 ≤ p →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u p SC_U.X₂) :=
      fun p hp => hInjAcyc I p hp
    have hCalc := (weil_etale_higherDirectImage_shortExact_calculus u).2.2 SC_U hSE_U hAcyc_I
    refine ⟨hCalc.2.1, fun hZ₁ k hk => ?_⟩
    have hSE_pf : (SC_U.map pf_u).ShortExact := (hCalc.1).2 hZ₁
    have _ : CategoryTheory.Injective SC_U.X₂ := CategoryTheory.Injective.injective_under G
    have _ : CategoryTheory.Injective (SC_U.map pf_u).X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_u I
    let e_X : (pf_u.obj Q).H k ≃+ (pf_u.obj G).H (k + 1) :=
      AddEquiv.ofBijective (hSE_pf.extClass.postcomp Fℤ_X (rfl : k + 1 = k + 1))
        ⟨hConnInj Fℤ_X hSE_pf k hk, hConnSurj Fℤ_X hSE_pf k⟩
    let e_U : Q.H k ≃+ G.H (k + 1) :=
      AddEquiv.ofBijective (hSE_U.extClass.postcomp Fℤ_U (rfl : k + 1 = k + 1))
        ⟨hConnInj Fℤ_U hSE_U k hk, hConnSurj Fℤ_U hSE_U k⟩
    refine ⟨e_X, e_U, fun w => ?_⟩
    let hSE_pb_pf : ((SC_U.map pf_u).map pb_u).ShortExact := hSE_pf.map_of_exact pb_u
    let Φ_c : (SC_U.map pf_u).map pb_u ⟶ SC_U :=
      CategoryTheory.ShortComplex.Hom.mk
        (adj_u.counit.app G) (adj_u.counit.app I) (adj_u.counit.app Q)
        (adj_u.counit.naturality ι_G).symm
        (adj_u.counit.naturality π_G).symm
    have hExtNat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb_pf hSE_U Φ_c
    have hMapExt : CategoryTheory.Abelian.Ext.mapExactFunctor pb_u hSE_pf.extClass =
        hSE_pb_pf.extClass :=
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_u hSE_pf
    change (leray_u Q k w).comp hSE_U.extClass (rfl : k + 1 = k + 1) =
      leray_u G (k + 1) (w.comp hSE_pf.extClass (rfl : k + 1 = k + 1))
    rw [hleray_def, hleray_def,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp, hMapExt,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        hSE_pb_pf.extClass (Nat.zero_add k) rfl (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc _ hSE_pb_pf.extClass
        (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app G)) rfl (Nat.add_zero 1) (by omega),
      hExtNat,
      ← CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app Q)) hSE_U.extClass
        (Nat.add_zero k) (Nat.zero_add 1) (by omega)]

  
  have hEdgeSeq : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (δ_edge : G.H 1 →+ (weilEtaleHigherDirectImage u 1 G).H 0)
        (β_edge : (weilEtaleHigherDirectImage u 1 G).H 0 →+ (pf_u.obj G).H 2),
        (∀ x : (pf_u.obj G).H 1, δ_edge (leray_u G 1 x) = 0) ∧
        (∀ y : G.H 1, δ_edge y = 0 → ∃ x : (pf_u.obj G).H 1, leray_u G 1 x = y) ∧
        (∀ r : (weilEtaleHigherDirectImage u 1 G).H 0, β_edge r = 0 → ∃ y : G.H 1, δ_edge y = r) ∧
        (∀ r : (weilEtaleHigherDirectImage u 1 G).H 0, leray_u G 2 (β_edge r) = 0) := by
    intro G
    let I := CategoryTheory.Injective.under G
    let ι_G := CategoryTheory.Injective.ι G
    let Q := CategoryTheory.Limits.cokernel ι_G
    let π_G := CategoryTheory.Limits.cokernel.π ι_G
    let SC_U := CategoryTheory.ShortComplex.mk ι_G π_G (CategoryTheory.Limits.cokernel.condition ι_G)
    have hSE_U : SC_U.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel ι_G) inferInstance inferInstance
    have hAcyc_I : ∀ p : ℕ, 1 ≤ p →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u p SC_U.X₂) :=
      fun p hp => hInjAcyc I p hp
    obtain ⟨δ₀_raw, hcomp_raw, hEpi_δ₀_raw, hEx_δ₀_raw⟩ :=
      ((weil_etale_higherDirectImage_shortExact_calculus u).2.2 SC_U hSE_U hAcyc_I).1.1
    let δ₀ : pf_u.obj Q ⟶ weilEtaleHigherDirectImage u 1 G := δ₀_raw
    have hcomp : pf_u.map π_G ≫ δ₀ = 0 := hcomp_raw
    have _ : CategoryTheory.Epi δ₀ := hEpi_δ₀_raw
    have hEx_δ₀ : (CategoryTheory.ShortComplex.mk (pf_u.map π_G) δ₀ hcomp).Exact := hEx_δ₀_raw
    have _ : pf_u.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products pf_u
    have _ : CategoryTheory.Limits.PreservesFiniteLimits pf_u := ⟨fun _ _ _ => inferInstance⟩
    obtain ⟨hEx_pf, hMono_pf_ι⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_u).mp
        inferInstance SC_U hSE_U
    have _ : CategoryTheory.Mono (pf_u.map ι_G) := hMono_pf_ι
    obtain ⟨hfq, hmδ, hSE₁, hSE₂⟩ :=
      hSplitSES (pf_u.map ι_G) (pf_u.map π_G) (SC_U.map pf_u).zero hEx_pf δ₀ hcomp hEx_δ₀
    let M := CategoryTheory.Limits.image (pf_u.map π_G)
    let q_π : pf_u.obj I ⟶ M := CategoryTheory.Limits.factorThruImage (pf_u.map π_G)
    let m_π : M ⟶ pf_u.obj Q := CategoryTheory.Limits.image.ι (pf_u.map π_G)
    let SC₁ := CategoryTheory.ShortComplex.mk (pf_u.map ι_G) q_π hfq
    let SC₂ := CategoryTheory.ShortComplex.mk m_π δ₀ hmδ
    have _ : CategoryTheory.Injective SC_U.X₂ := CategoryTheory.Injective.injective_under G
    have _ : CategoryTheory.Injective SC₁.X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_u I

    
    have hMaster : ∀ (k : ℕ) (w : M.H k),
        leray_u G (k + 1) (w.comp hSE₁.extClass (rfl : k + 1 = k + 1)) =
        (leray_u Q k (w.comp (CategoryTheory.Abelian.Ext.mk₀ m_π) (Nat.add_zero k))).comp
          hSE_U.extClass (rfl : k + 1 = k + 1) := by
      intro k w
      let hSE₁_pb : (SC₁.map pb_u).ShortExact := hSE₁.map_of_exact pb_u
      let Φ_G : SC₁.map pb_u ⟶ SC_U :=
        CategoryTheory.ShortComplex.Hom.mk
          (adj_u.counit.app G)
          (adj_u.counit.app I)
          (pb_u.map m_π ≫ adj_u.counit.app Q)
          (adj_u.counit.naturality ι_G).symm
          (by
            change adj_u.counit.app I ≫ π_G = pb_u.map q_π ≫ (pb_u.map m_π ≫ adj_u.counit.app Q)
            rw [← CategoryTheory.Category.assoc, ← pb_u.map_comp,
              CategoryTheory.Limits.image.fac (pf_u.map π_G)]
            exact (adj_u.counit.naturality π_G).symm)
      have hExtNat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₁_pb hSE_U Φ_G
      have hMapExt : CategoryTheory.Abelian.Ext.mapExactFunctor pb_u hSE₁.extClass =
          hSE₁_pb.extClass :=
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_u hSE₁
      rw [hleray_def, hleray_def,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp, hMapExt,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
          hSE₁_pb.extClass (Nat.zero_add k) rfl (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc _ hSE₁_pb.extClass
          (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app G)) rfl (Nat.add_zero 1) (by omega),
        hExtNat]
      have hτ₃ : CategoryTheory.Abelian.Ext.mk₀ Φ_G.τ₃ =
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u (CategoryTheory.Abelian.Ext.mk₀ m_π)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app Q)) (Nat.add_zero 0) := by
        change CategoryTheory.Abelian.Ext.mk₀ (pb_u.map m_π ≫ adj_u.counit.app Q) = _
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      rw [← CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ Φ_G.τ₃) hSE_U.extClass
          (Nat.add_zero k) (Nat.zero_add 1) (by omega),
        hτ₃,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u (CategoryTheory.Abelian.Ext.mk₀ m_π))
          (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app Q)) (Nat.add_zero k),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u (CategoryTheory.Abelian.Ext.mk₀ m_π))
          (Nat.zero_add k),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]

    
    let dU₀ : Q.H 0 →+ G.H 1 := hSE_U.extClass.postcomp Fℤ_U (rfl : 0 + 1 = 1)
    have hdU₀_surj : Function.Surjective dU₀ := hConnSurj Fℤ_U hSE_U 0
    let ψ_G : Q.H 0 →+ (weilEtaleHigherDirectImage u 1 G).H 0 :=
      ((CategoryTheory.Abelian.Ext.mk₀ δ₀).postcomp Fℤ_X (Nat.add_zero 0)).comp
        (e_0 Q).symm.toAddMonoidHom
    have hψ_G_apply : ∀ q₀ : Q.H 0,
        ψ_G q₀ = ((e_0 Q).symm q₀).comp (CategoryTheory.Abelian.Ext.mk₀ δ₀) (Nat.add_zero 0) :=
      fun _ => rfl
    have hψ_well : ∀ q₁ q₂ : Q.H 0, dU₀ q₁ = dU₀ q₂ → ψ_G q₁ = ψ_G q₂ := by
      intro q₁ q₂ hq
      have hdiff0 : (q₁ - q₂).comp hSE_U.extClass (rfl : 0 + 1 = 1) = 0 := by
        change dU₀ (q₁ - q₂) = 0
        rw [map_sub, hq, sub_self]
      obtain ⟨i₀, hi₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_U hSE_U (q₁ - q₂) rfl hdiff0
      let i_tilde : (pf_u.obj I).H 0 := (e_0 I).symm i₀
      have hi_tilde : leray_u I 0 i_tilde = i₀ := (e_0 I).apply_symm_apply i₀
      have hnat_i : (e_0 Q) (i_tilde.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_u.map π_G))
          (Nat.add_zero 0)) = q₁ - q₂ := by
        change leray_u Q 0 (i_tilde.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_u.map π_G))
          (Nat.add_zero 0)) = q₁ - q₂
        rw [hLerayNat π_G 0 i_tilde, hi_tilde, hi₀]
      have hsymm_diff : (e_0 Q).symm (q₁ - q₂) =
          i_tilde.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_u.map π_G)) (Nat.add_zero 0) := by
        rw [← hnat_i, (e_0 Q).symm_apply_apply]
      have hψ_sub : ψ_G (q₁ - q₂) = 0 := by
        rw [hψ_G_apply, hsymm_diff, CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcomp,
          CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      rw [map_sub] at hψ_sub
      exact sub_eq_zero.mp hψ_sub

    let liftQ : G.H 1 → Q.H 0 := fun y => Classical.choose (hdU₀_surj y)
    have hliftQ : ∀ y : G.H 1, dU₀ (liftQ y) = y := fun y => Classical.choose_spec (hdU₀_surj y)
    have hδ_spec_raw : ∀ (q₀ : Q.H 0) (y : G.H 1), dU₀ q₀ = y → ψ_G (liftQ y) = ψ_G q₀ :=
      fun q₀ y hy => hψ_well (liftQ y) q₀ ((hliftQ y).trans hy.symm)
    let δ_edge : G.H 1 →+ (weilEtaleHigherDirectImage u 1 G).H 0 :=
      { toFun := fun y => ψ_G (liftQ y)
        map_zero' := (hδ_spec_raw 0 0 (map_zero dU₀)).trans (map_zero ψ_G)
        map_add' := fun y₁ y₂ => by
          rw [hδ_spec_raw (liftQ y₁ + liftQ y₂) (y₁ + y₂)
            ((map_add dU₀ _ _).trans (congrArg₂ (· + ·) (hliftQ y₁) (hliftQ y₂)))]
          exact map_add ψ_G _ _ }
    have hδ_spec : ∀ q₀ : Q.H 0, δ_edge (dU₀ q₀) = ψ_G q₀ :=
      fun q₀ => hδ_spec_raw q₀ (dU₀ q₀) rfl

    
    let dSC₂_0 : (weilEtaleHigherDirectImage u 1 G).H 0 →+ M.H 1 :=
      hSE₂.extClass.postcomp Fℤ_X (rfl : 0 + 1 = 1)
    let dSC₁_1 : M.H 1 →+ (pf_u.obj G).H 2 :=
      hSE₁.extClass.postcomp Fℤ_X (rfl : 1 + 1 = 2)
    have hdSC₁_1_inj : Function.Injective dSC₁_1 := hConnInj Fℤ_X hSE₁ 1 (le_refl 1)
    let β_edge : (weilEtaleHigherDirectImage u 1 G).H 0 →+ (pf_u.obj G).H 2 :=
      dSC₁_1.comp dSC₂_0

    refine ⟨δ_edge, β_edge, ?_, ?_, ?_, ?_⟩
    · 
      intro x
      obtain ⟨w₀_raw, rfl⟩ := hConnSurj Fℤ_X hSE₁ 0 x
      let w₀ : M.H 0 := w₀_raw
      change δ_edge (leray_u G 1 (w₀.comp hSE₁.extClass (rfl : 0 + 1 = 1))) = 0
      rw [hMaster 0 w₀]
      change δ_edge (dU₀ ((e_0 Q) (w₀.comp (CategoryTheory.Abelian.Ext.mk₀ m_π) (Nat.add_zero 0)))) = 0
      rw [hδ_spec, hψ_G_apply, (e_0 Q).symm_apply_apply,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hmδ,
        CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    · 
      intro y hy
      let q₀ := liftQ y
      have hq₀_y : dU₀ q₀ = y := hliftQ y
      have hψ0 : ((e_0 Q).symm q₀).comp (CategoryTheory.Abelian.Ext.mk₀ SC₂.g) (Nat.add_zero 0) = 0 := by
        rw [← hψ_G_apply, ← hδ_spec q₀, hq₀_y, hy]
      obtain ⟨w₀_raw, hw₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_X hSE₂ ((e_0 Q).symm q₀) hψ0
      let w₀ : M.H 0 := w₀_raw
      refine ⟨w₀.comp hSE₁.extClass (rfl : 0 + 1 = 1), ?_⟩
      rw [hMaster 0 w₀]
      change dU₀ ((e_0 Q) (w₀.comp (CategoryTheory.Abelian.Ext.mk₀ SC₂.f) (Nat.add_zero 0))) = y
      rw [hw₀, (e_0 Q).apply_symm_apply]
      exact hq₀_y
    · 
      intro r hr
      have hr' : dSC₂_0 r = 0 := hdSC₁_1_inj (hr.trans (map_zero dSC₁_1).symm)
      obtain ⟨q_tilde_raw, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_X hSE₂ r rfl hr'
      let q_tilde : (pf_u.obj Q).H 0 := q_tilde_raw
      refine ⟨dU₀ ((e_0 Q) q_tilde), ?_⟩
      rw [hδ_spec, hψ_G_apply, (e_0 Q).symm_apply_apply]
    · 
      intro r
      let w₁ : M.H 1 := dSC₂_0 r
      change leray_u G 2 (w₁.comp hSE₁.extClass (rfl : 1 + 1 = 2)) = 0
      rw [hMaster 1 w₁]
      have hw₁_m : w₁.comp (CategoryTheory.Abelian.Ext.mk₀ m_π) (Nat.add_zero 1) = 0 := by
        change (r.comp hSE₂.extClass (rfl : 0 + 1 = 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC₂.f) (Nat.add_zero 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          hSE₂.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero]
      rw [hw₁_m, map_zero, CategoryTheory.Abelian.Ext.zero_comp]

  
  let Λ_U := weilEtaleTorsionSheaf U m₀
  let Z : ℕ → CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u} :=
    Nat.rec Λ_U
      (fun _ G => CategoryTheory.Limits.cokernel (CategoryTheory.Injective.ι G))

  have hHDI_shift : ∀ (b q d : ℕ), 1 ≤ q → q + b = d →
      Nonempty (weilEtaleHigherDirectImage u q (Z b) ≅ weilEtaleHigherDirectImage u d Λ_U) := by
    intro b
    induction b with
    | zero =>
      intro q d _ hd
      rw [Nat.add_zero] at hd
      subst hd
      exact ⟨CategoryTheory.Iso.refl _⟩
    | succ b ih =>
      intro q d hq hd
      obtain ⟨e_step⟩ := (hStepShiftAndConj (Z b)).1 q hq
      obtain ⟨e_ih⟩ := ih (q + 1) d (by omega) (by omega)
      exact ⟨e_step.symm.trans e_ih⟩

  have hΘ_H0 : ∀ b : ℕ,
      Nonempty ((weilEtaleHigherDirectImage u 1 (Z b)).H 0 ≃+
        (weilEtaleHigherDirectImage u (b + 1) Λ_U).H 0) := by
    intro b
    obtain ⟨Θ_b⟩ := hHDI_shift b 1 (b + 1) (le_refl 1) (Nat.add_comm 1 b)
    exact ⟨hIsoPostcomp Fℤ_X Θ_b.hom Θ_b.inv Θ_b.hom_inv_id Θ_b.inv_hom_id 0⟩

  let _ : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      AddCommGroup (G.H q) := fun _ _ => inferInstance
  let _ : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      AddCommGroup (G.H q) := fun _ _ => inferInstance
  let _ : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      AddZeroClass (G.H q) := fun _ _ => inferInstance
  let _ : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      AddZeroClass (G.H q) := fun _ _ => inferInstance
  let _ : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Add (G.H q) := fun _ _ => inferInstance
  let _ : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Add (G.H q) := fun _ _ => inferInstance
  let _ : ∀ (G : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Zero (G.H q) := fun _ _ => inferInstance

  have hAcyc_conj : ∀ (b : ℕ),
      (∀ a : ℕ, 1 ≤ a → a ≤ b →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u a Λ_U)) →
      ∀ (k m : ℕ), 1 ≤ k → k + b = m →
        ∃ (EX : (pf_u.obj (Z b)).H k ≃+ (pf_u.obj Λ_U).H m)
          (EU : (Z b).H k ≃+ Λ_U.H m),
          ∀ w : (pf_u.obj (Z b)).H k,
            EU (leray_u (Z b) k w) = leray_u Λ_U m (EX w) := by
    intro b
    induction b with
    | zero =>
      intro _ k m _ hm
      rw [Nat.add_zero] at hm
      subst hm
      exact ⟨AddEquiv.refl _, AddEquiv.refl _, fun _ => rfl⟩
    | succ b ih =>
      intro hZero k m hk hm
      obtain ⟨Θ_b⟩ := hHDI_shift b 1 (b + 1) (le_refl 1) (Nat.add_comm 1 b)
      have hZ1_b : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u 1 (Z b)) :=
        CategoryTheory.Limits.IsZero.of_iso (hZero (b + 1) (by omega) (le_refl _)) Θ_b
      have hStep_b :
          ∃ (e_X : (pf_u.obj (Z (b + 1))).H k ≃+ (pf_u.obj (Z b)).H (k + 1))
            (e_U : (Z (b + 1)).H k ≃+ (Z b).H (k + 1)),
            ∀ w : (pf_u.obj (Z (b + 1))).H k,
              e_U (leray_u (Z (b + 1)) k w) = leray_u (Z b) (k + 1) (e_X w) :=
        (hStepShiftAndConj (Z b)).2 hZ1_b k hk
      obtain ⟨e_X, e_U, h_step⟩ := hStep_b
      obtain ⟨EX_ih, EU_ih, h_ih⟩ :=
        ih (fun a ha hab => hZero a ha (by omega)) (k + 1) m (by omega) (by omega)
      refine ⟨e_X.trans EX_ih, e_U.trans EU_ih, fun w => ?_⟩
      change EU_ih (e_U (leray_u (Z (b + 1)) k w)) = leray_u Λ_U m (EX_ih (e_X w))
      rw [h_step w, h_ih (e_X w)]

  
  refine ⟨?_, ?_⟩
  · 
    intro hBij hZeroOfSub
    have hBij_leray0 : ∀ q : ℕ, q ≤ n + 1 → Function.Bijective (leray_u Λ_U q) := by
      intro q hq
      obtain ⟨p_q, hp_q⟩ := weil_etale_torsion_pullback_functoriality.{u}.1 u m₀ q
      have hp_bij : Function.Bijective p_q := hBij q hq p_q hp_q
      have hleray_eq : (leray_u Λ_U q : (pf_u.obj Λ_U).H q → Λ_U.H q) =
          (p_q : weilEtaleTorsionH X m₀ q → weilEtaleTorsionH U m₀ q) ∘ (e_η q).symm := by
        ext w
        dsimp
        rw [hFactor q p_q hp_q, (e_η q).apply_symm_apply]
      rw [hleray_eq]
      exact hp_bij.comp (e_η q).symm.bijective

    have hZero_ind : ∀ b : ℕ, b ≤ n → ∀ a : ℕ, 1 ≤ a → a ≤ b →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u a Λ_U) := by
      intro b
      induction b with
      | zero =>
        intro _ a ha hab
        omega
      | succ b ih =>
        intro hb1 a ha hab1
        have hZero_b := ih (by omega)
        rcases Nat.lt_or_eq_of_le hab1 with hlt | rfl
        · exact hZero_b a ha (by omega)
        · obtain ⟨EX₁, EU₁, hConj₁⟩ := hAcyc_conj b hZero_b 1 (b + 1) (le_refl 1) (Nat.add_comm 1 b)
          obtain ⟨EX₂, EU₂, hConj₂⟩ := hAcyc_conj b hZero_b 2 (b + 2) (by omega) (Nat.add_comm 2 b)
          have hSurj_b1 : Function.Surjective (leray_u (Z b) 1) := by
            intro y
            obtain ⟨x₀, hx₀⟩ := (hBij_leray0 (b + 1) (by omega)).2 (EU₁ y)
            refine ⟨EX₁.symm x₀, EU₁.injective ?_⟩
            rw [hConj₁, EX₁.apply_symm_apply, hx₀]
          have hInj_b2 : Function.Injective (leray_u (Z b) 2) := by
            intro z₁ z₂ hz
            apply EX₂.injective
            apply (hBij_leray0 (b + 2) (by omega)).1
            rw [← hConj₂, ← hConj₂, hz]
          obtain ⟨δ_b, β_b, hLawA, _, hLawC, hLawD⟩ := hEdgeSeq (Z b)
          have _ : Subsingleton ((weilEtaleHigherDirectImage u 1 (Z b)).H 0) := by
            refine ⟨fun r₁ r₂ => ?_⟩
            have hr0 : ∀ r : (weilEtaleHigherDirectImage u 1 (Z b)).H 0, r = 0 := by
              intro r
              have hβ0 : β_b r = 0 :=
                hInj_b2 ((hLawD r).trans (map_zero (leray_u (Z b) 2)).symm)
              obtain ⟨y, rfl⟩ := hLawC r hβ0
              obtain ⟨x, rfl⟩ := hSurj_b1 y
              exact hLawA x
            exact (hr0 r₁).trans (hr0 r₂).symm
          obtain ⟨θ_b⟩ := hΘ_H0 b
          have hSub_b1 : Subsingleton ((weilEtaleHigherDirectImage u (b + 1) Λ_U).H 0) :=
            θ_b.symm.toEquiv.subsingleton
          exact hZeroOfSub (b + 1) (by omega) hSub_b1

    have hZero_n := hZero_ind n (le_refl n)
    refine ⟨hZero_n, fun p_top hp_top => ?_⟩
    obtain ⟨EX₁, EU₁, hConj₁⟩ := hAcyc_conj n hZero_n 1 (n + 1) (le_refl 1) (Nat.add_comm 1 n)
    obtain ⟨EX₂, EU₂, hConj₂⟩ := hAcyc_conj n hZero_n 2 (n + 2) (by omega) (Nat.add_comm 2 n)
    have hSurj_n1 : Function.Surjective (leray_u (Z n) 1) := by
      intro y
      obtain ⟨x₀, hx₀⟩ := (hBij_leray0 (n + 1) (le_refl _)).2 (EU₁ y)
      refine ⟨EX₁.symm x₀, EU₁.injective ?_⟩
      rw [hConj₁, EX₁.apply_symm_apply, hx₀]
    obtain ⟨δ_n, β_n, hLawA_n, _, hLawC_n, hLawD_n⟩ := hEdgeSeq (Z n)
    have hβ_n_inj : Function.Injective β_n := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨y, rfl⟩ := hLawC_n r hr
      obtain ⟨x, rfl⟩ := hSurj_n1 y
      exact hLawA_n x
    obtain ⟨θ_n⟩ := hΘ_H0 n
    let raw_edge : (weilEtaleHigherDirectImage u (n + 1) Λ_U).H 0 →+
        weilEtaleTorsionH X m₀ (n + 2) :=
      (e_η (n + 2)).symm.toAddMonoidHom.comp
        (EX₂.toAddMonoidHom.comp (β_n.comp θ_n.symm.toAddMonoidHom))
    have hraw_mem : ∀ r : (weilEtaleHigherDirectImage u (n + 1) Λ_U).H 0,
        raw_edge r ∈ p_top.ker := by
      intro r
      rw [AddMonoidHom.mem_ker, hFactor (n + 2) p_top hp_top (raw_edge r)]
      dsimp [raw_edge]
      rw [(e_η (n + 2)).apply_symm_apply]
      change leray_u Λ_U (n + 2) (EX₂ (β_n (θ_n.symm r))) = 0
      rw [← hConj₂, hLawD_n, EU₂.map_zero]
    let ι_edge : (weilEtaleHigherDirectImage u (n + 1) Λ_U).H 0 →+ ↥p_top.ker :=
      raw_edge.codRestrict p_top.ker hraw_mem
    refine ⟨ι_edge, ?_⟩
    intro r₁ r₂ hr
    have hval : raw_edge r₁ = raw_edge r₂ := congrArg Subtype.val hr
    exact θ_n.symm.injective (hβ_n_inj (EX₂.injective ((e_η (n + 2)).symm.injective hval)))
  · 
    intro hZeroLow p_Z hp_Z
    obtain ⟨EX₁, EU₁, hConj₁⟩ := hAcyc_conj n hZeroLow 1 (n + 1) (le_refl 1) (Nat.add_comm 1 n)
    obtain ⟨δ_n, _, _, hLawB_n, _, _⟩ := hEdgeSeq (Z n)
    obtain ⟨θ_n⟩ := hΘ_H0 n
    let bdry_u : weilEtaleTorsionH U m₀ (n + 1) →+
        (weilEtaleHigherDirectImage u (n + 1) Λ_U).H 0 :=
      θ_n.toAddMonoidHom.comp (δ_n.comp EU₁.symm.toAddMonoidHom)
    refine ⟨bdry_u, fun y hy => ?_⟩
    have hδ0 : δ_n (EU₁.symm y) = 0 :=
      θ_n.injective (hy.trans (map_zero θ_n).symm)
    obtain ⟨w, hw⟩ := hLawB_n (EU₁.symm y) hδ0
    refine ⟨(e_η (n + 1)).symm (EX₁ w), ?_⟩
    rw [hFactor (n + 1) p_Z hp_Z, (e_η (n + 1)).apply_symm_apply, ← hConj₁, hw,
      EU₁.apply_symm_apply]

theorem weil_odp_coker_isolated_point_roof_specialization_coker (k : Type u) [Field k] [IsAlgClosed k]
    (N_deg ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (hN : 1 ≤ N_deg)
    (Z_R Q_R W_R : AlgebraicGeometry.Scheme.{u})
    (x_Z : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_R)
    (hx_Z : AlgebraicGeometry.IsClosedImmersion x_Z)
    (U_Z : Z_R.Opens) (hU_Z : (U_Z : Set Z_R) = (Set.range x_Z.base)ᶜ)
    (x_Q : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_R)
    (hx_Q : AlgebraicGeometry.IsClosedImmersion x_Q)
    (U_Q : Q_R.Opens) (hU_Q : (U_Q : Set Q_R) = (Set.range x_Q.base)ᶜ)
    (v_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_R)
    (e_W : W_R ⟶ Z_R) [AlgebraicGeometry.Etale e_W]
    (q_W : W_R ⟶ Q_R) [AlgebraicGeometry.Etale q_W]
    (hv_e : v_W ≫ e_W = x_Z)
    (hv_q : v_W ≫ q_W = x_Q)
    (hpre_e : e_W.base ⁻¹' (Set.range x_Z.base) = Set.range v_W.base)
    (hpre_q : q_W.base ⁻¹' (Set.range x_Q.base) = Set.range v_W.base)
    (hBij_low : ∀ (q : ℕ), q ≤ N_deg →
      ∀ (p_u : weilEtaleTorsionH Q_R (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH U_Q.toScheme (ℓ ^ (r + 1)) q),
        WeilIsTorsionEtalePullback U_Q.ι (ℓ ^ (r + 1)) q p_u →
        Function.Bijective p_u)
    (hKer_top : ∃ (p_top : weilEtaleTorsionH Q_R (ℓ ^ (r + 1)) (N_deg + 1) →+
          weilEtaleTorsionH U_Q.toScheme (ℓ ^ (r + 1)) (N_deg + 1)),
      WeilIsTorsionEtalePullback U_Q.ι (ℓ ^ (r + 1)) (N_deg + 1) p_top ∧
      ∃ (θ_ker : ↥p_top.ker →+ ZMod (ℓ ^ (r + 1))), Function.Injective θ_ker)
    (p_Z : weilEtaleTorsionH Z_R (ℓ ^ (r + 1)) N_deg →+
      weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) N_deg)
    (hp_Z : WeilIsTorsionEtalePullback U_Z.ι (ℓ ^ (r + 1)) N_deg p_Z) :
    ∃ δ_r : weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) N_deg →+ ZMod (ℓ ^ (r + 1)),
      ∀ y : weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) N_deg,
        δ_r y = 0 →
        ∃ ξ : weilEtaleTorsionH Z_R (ℓ ^ (r + 1)) N_deg, p_Z ξ = y :=
by
  let _ := hℓ
  obtain ⟨n, rfl⟩ : ∃ n : ℕ, N_deg = n + 1 := ⟨N_deg - 1, (Nat.sub_add_cancel hN).symm⟩
  have hHDI_tors : ∀ (m₀ : ℕ) {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (b : ℕ),
      m₀ • CategoryTheory.CategoryStruct.id
        (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf X m₀)) = 0 := by
    intro m₀ X S f b
    let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    have hhom_nsmul : ∀ {A : AddCommGrpCat.{u}} (k : ℕ) (φ : A ⟶ A) (z : A),
        (k • φ).hom z = k • (φ.hom z) := by
      intro A k φ z
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, ← ih]
        rfl
    have hAM_tors : m₀ • CategoryTheory.CategoryStruct.id AM = 0 := by
      apply AddCommGrpCat.ext
      intro x
      change (m₀ • CategoryTheory.CategoryStruct.id AM).hom x = 0
      rw [hhom_nsmul]
      rcases x with ⟨z⟩
      apply ULift.ext
      change m₀ • z = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    let hTerm : CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
          (CategoryTheory.Category.comp_id E.hom))
        (fun E m => by
          apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
          exact CategoryTheory.Over.OverMorphism.ext
            ((CategoryTheory.Category.comp_id m.left).symm.trans
              (CategoryTheory.MorphismProperty.Over.w m)))
    let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    have _ : C_X.IsLeftAdjoint :=
      (CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hTerm).isLeftAdjoint
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts C_X :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts C_X
    have _ : C_X.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts C_X
    let F := weilEtaleTorsionSheaf X m₀
    have hF_tors : m₀ • CategoryTheory.CategoryStruct.id F = 0 := by
      change m₀ • CategoryTheory.CategoryStruct.id (C_X.obj AM) = 0
      rw [← C_X.map_id, ← C_X.map_nsmul, hAM_tors, C_X.map_zero]
    have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf F b
    let Q : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op P
    have hQ_tors : m₀ • CategoryTheory.CategoryStruct.id Q = 0 := by
      ext W x
      have happ : ∀ (k : ℕ) (τ : Q ⟶ Q), (k • τ).app W = k • (τ.app W) := by
        intro k τ
        induction k with
        | zero => simp
        | succ k ih => rw [succ_nsmul, CategoryTheory.NatTrans.app_add, ih, succ_nsmul]
      change ((m₀ • CategoryTheory.CategoryStruct.id Q).app W).hom x = 0
      rw [happ, CategoryTheory.NatTrans.id_app, hhom_nsmul]
      change m₀ • x = 0
      have hExt_tors : ∀ {Z₀ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (α : CategoryTheory.Abelian.Ext Z₀ F b), m₀ • α = 0 := by
        intro Z₀ α
        have hcomp_nsmul : ∀ (k : ℕ),
            (k • α).comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
              (Nat.add_zero b) =
            α.comp (CategoryTheory.Abelian.Ext.mk₀ (k • CategoryTheory.CategoryStruct.id F))
              (Nat.add_zero b) := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            rw [succ_nsmul, CategoryTheory.Abelian.Ext.add_comp, ih,
              CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul,
              CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
        calc m₀ • α
            = (m₀ • α).comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
                (Nat.add_zero b) := (CategoryTheory.Abelian.Ext.comp_mk₀_id (m₀ • α)).symm
          _ = α.comp (CategoryTheory.Abelian.Ext.mk₀ (m₀ • CategoryTheory.CategoryStruct.id F))
                (Nat.add_zero b) := hcomp_nsmul m₀
          _ = 0 := by
              rw [hF_tors, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      exact hExt_tors x
    let L_S := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts L_S :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts L_S
    have _ : L_S.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts L_S
    change m₀ • CategoryTheory.CategoryStruct.id (L_S.obj Q) = 0
    rw [← L_S.map_id, ← L_S.map_nsmul, hQ_tors, L_S.map_zero]
  obtain ⟨p_top, hp_top, θ_ker, hθ_ker_inj⟩ := hKer_top
  obtain ⟨hPullEx, _, _, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨p_Q0, hp_Q0⟩ := hPullEx U_Q.ι (ℓ ^ (r + 1)) 0
  obtain ⟨p_Q1, hp_Q1⟩ := hPullEx U_Q.ι (ℓ ^ (r + 1)) 1
  have hBij_Q0 : Function.Bijective p_Q0 :=
    hBij_low 0 (Nat.zero_le (n + 1)) p_Q0 hp_Q0
  have hInj_Q1 : Function.Injective p_Q1 :=
    (hBij_low 1 (Nat.succ_le_succ (Nat.zero_le n)) p_Q1 hp_Q1).1
  have hp_top' := hp_top
  rcases hp_top' with ⟨hc_Q, hr_Q, _, _, _, T_UQ, hT_UQ, T_QR, hT_QR, _⟩
  have hp_Z' := hp_Z
  rcases hp_Z' with ⟨hc_Z, hr_Z, _, _, _, T_UZ, hT_UZ, T_ZR, hT_ZR, _⟩
  have hSkyZero_Q : ∀ 𝒢 : CategoryTheory.Sheaf Q_R.smallEtaleTopology AddCommGrpCat.{u},
      (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
      (∃ 𝒢_U : CategoryTheory.Sheaf U_Q.toScheme.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback U_Q.ι 𝒢 𝒢_U ∧ CategoryTheory.Limits.IsZero 𝒢_U) →
      Subsingleton (𝒢.H 0) → CategoryTheory.Limits.IsZero 𝒢 :=
    fun 𝒢 hTors hZeroU =>
      (weil_iso_roof_coker_closed_point_skyscraper_eval k ℓ (r + 1)
        Q_R x_Q hx_Q U_Q hU_Q 𝒢 hTors hZeroU).1
  obtain ⟨hIso_ηQ_all, hIso_ηZ_all⟩ :=
    weil_iso_roof_coker_deg0_unit_iso_and_roof_transfer k (ℓ ^ (r + 1)) Z_R Q_R W_R
      x_Z U_Z hU_Z x_Q U_Q hU_Q v_W e_W q_W
      hv_e hpre_e hpre_q hSkyZero_Q p_Q0 hp_Q0 hBij_Q0 p_Q1 hp_Q1 hInj_Q1
  have hIso_ηQ := @hIso_ηQ_all hc_Q hr_Q T_UQ hT_UQ T_QR hT_QR
  have hIso_ηZ := @hIso_ηZ_all hc_Z hr_Z T_UZ hT_UZ T_ZR hT_ZR
  obtain ⟨hIdZero, hEtBC⟩ := weil_punctual_roof_hdi_id_isZero_and_etale_pullback.{u} (ℓ ^ (r + 1))
  have hOpenZero : ∀ {X₀ U₀ : AlgebraicGeometry.Scheme.{u}} (j₀ : U₀ ⟶ X₀)
      [AlgebraicGeometry.IsOpenImmersion j₀] (b : ℕ),
      1 ≤ b →
      ∃ G₀ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback j₀
          (weilEtaleHigherDirectImage j₀ b (weilEtaleTorsionSheaf U₀ (ℓ ^ (r + 1)))) G₀ ∧
        CategoryTheory.Limits.IsZero G₀ := by
    intro X₀ U₀ j₀ _ b hb
    have hPb_self : CategoryTheory.IsPullback (CategoryTheory.CategoryStruct.id U₀)
        (CategoryTheory.CategoryStruct.id U₀) j₀ j₀ :=
      { w := rfl
        isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
          (fun c => c.fst)
          (fun c => CategoryTheory.Category.comp_id c.fst)
          (fun c => (CategoryTheory.Category.comp_id c.fst).trans ((cancel_mono j₀).mp c.condition))
          (fun c l hl₁ _ => (hl₁.symm.trans (CategoryTheory.Category.comp_id l)).symm)⟩ }
    exact ⟨weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id U₀) b
        (weilEtaleTorsionSheaf U₀ (ℓ ^ (r + 1))),
      hEtBC (CategoryTheory.CategoryStruct.id U₀) (CategoryTheory.CategoryStruct.id U₀)
        j₀ j₀ b hPb_self,
      hIdZero U₀ (weilEtaleTorsionSheaf U₀ (ℓ ^ (r + 1))) b hb⟩
  let ℛ_Q : ℕ → CategoryTheory.Sheaf Q_R.smallEtaleTopology AddCommGrpCat.{u} :=
    fun b => weilEtaleHigherDirectImage U_Q.ι b (weilEtaleTorsionSheaf U_Q.toScheme (ℓ ^ (r + 1)))
  let ℛ_Z : ℕ → CategoryTheory.Sheaf Z_R.smallEtaleTopology AddCommGrpCat.{u} :=
    fun b => weilEtaleHigherDirectImage U_Z.ι b (weilEtaleTorsionSheaf U_Z.toScheme (ℓ ^ (r + 1)))
  have hRQ_zero_of_sub : ∀ (a : ℕ), 1 ≤ a →
      Subsingleton ((ℛ_Q a).H 0) → CategoryTheory.Limits.IsZero (ℛ_Q a) :=
    fun a ha => (weil_iso_roof_coker_closed_point_skyscraper_eval k ℓ (r + 1)
      Q_R x_Q hx_Q U_Q hU_Q (ℛ_Q a) (hHDI_tors (ℓ ^ (r + 1)) U_Q.ι a) (hOpenZero U_Q.ι a ha)).1
  obtain ⟨hZero_RQ, hEdge_Q⟩ :=
    (@weil_iso_roof_coker_open_pushforward_syzygy_shift
      Q_R U_Q.toScheme U_Q.ι (ℓ ^ (r + 1)) n hc_Q hr_Q T_UQ hT_UQ T_QR hT_QR hIso_ηQ).1
      hBij_low hRQ_zero_of_sub
  obtain ⟨ι_edge, hι_edge_inj⟩ := hEdge_Q p_top hp_top
  let W_open_e : W_R.Opens := (TopologicalSpace.Opens.map e_W.base).obj U_Z
  let W_open_q : W_R.Opens := (TopologicalSpace.Opens.map q_W.base).obj U_Q
  have hW_eq : W_open_e = W_open_q := by
    apply TopologicalSpace.Opens.ext
    change e_W.base ⁻¹' (U_Z : Set Z_R) = q_W.base ⁻¹' (U_Q : Set Q_R)
    rw [hU_Z, hU_Q, Set.preimage_compl, Set.preimage_compl, hpre_e, hpre_q]
  obtain ⟨hPB_ex, _, hPB_comp, _, _, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} (ℓ ^ (r + 1))
  have hStalkEquiv : ∀ (b : ℕ), 1 ≤ b → Nonempty ((ℛ_Z b).H 0 ≃+ (ℛ_Q b).H 0) := by
    intro b hb
    let ℛ_W := weilEtaleHigherDirectImage W_open_e.ι b
      (weilEtaleTorsionSheaf W_open_e.toScheme (ℓ ^ (r + 1)))
    have hPB_eW : WeilIsEtaleSheafPullback e_W (ℛ_Z b) ℛ_W :=
      hEtBC (e_W ∣_ U_Z) W_open_e.ι U_Z.ι e_W b
        (AlgebraicGeometry.isPullback_morphismRestrict e_W U_Z)
    have hPB_qW_aux : ∀ (O : W_R.Opens), O = W_open_q →
        WeilIsEtaleSheafPullback q_W (ℛ_Q b)
          (weilEtaleHigherDirectImage O.ι b (weilEtaleTorsionSheaf O.toScheme (ℓ ^ (r + 1)))) := by
      rintro _ rfl
      exact hEtBC (q_W ∣_ U_Q) W_open_q.ι U_Q.ι q_W b
        (AlgebraicGeometry.isPullback_morphismRestrict q_W U_Q)
    have hPB_qW : WeilIsEtaleSheafPullback q_W (ℛ_Q b) ℛ_W := hPB_qW_aux W_open_e hW_eq
    obtain ⟨H_b, hPB_vW, _, _⟩ := hPB_ex v_W ℛ_W
    have hPB_xZ : WeilIsEtaleSheafPullback x_Z (ℛ_Z b) H_b := by
      rw [← hv_e]
      exact (hPB_comp v_W e_W (ℛ_Z b) ℛ_W H_b).1 hPB_eW hPB_vW
    have hPB_xQ : WeilIsEtaleSheafPullback x_Q (ℛ_Q b) H_b := by
      rw [← hv_q]
      exact (hPB_comp v_W q_W (ℛ_Q b) ℛ_W H_b).1 hPB_qW hPB_vW
    obtain ⟨e_Z⟩ := (weil_iso_roof_coker_closed_point_skyscraper_eval k ℓ (r + 1)
      Z_R x_Z hx_Z U_Z hU_Z (ℛ_Z b)
      (hHDI_tors (ℓ ^ (r + 1)) U_Z.ι b) (hOpenZero U_Z.ι b hb)).2 H_b hPB_xZ
    obtain ⟨e_Q⟩ := (weil_iso_roof_coker_closed_point_skyscraper_eval k ℓ (r + 1)
      Q_R x_Q hx_Q U_Q hU_Q (ℛ_Q b)
      (hHDI_tors (ℓ ^ (r + 1)) U_Q.ι b) (hOpenZero U_Q.ι b hb)).2 H_b hPB_xQ
    exact ⟨e_Z.trans e_Q.symm⟩
  have hZero_RZ : ∀ (a : ℕ), 1 ≤ a → a ≤ n → CategoryTheory.Limits.IsZero (ℛ_Z a) := by
    intro a ha han
    have hZQ : CategoryTheory.Limits.IsZero (ℛ_Q a) := hZero_RQ a ha han
    let Fℤ_Q := (CategoryTheory.constantSheaf Q_R.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have _ : Subsingleton (Fℤ_Q ⟶ ℛ_Q a) := ⟨fun f g => hZQ.eq_of_tgt f g⟩
    have _ : Subsingleton ((ℛ_Q a).H 0) :=
      (CategoryTheory.Abelian.Ext.addEquiv₀ (X := Fℤ_Q) (Y := ℛ_Q a)).toEquiv.subsingleton
    obtain ⟨e_a⟩ := hStalkEquiv a ha
    have hSub_Z : Subsingleton ((ℛ_Z a).H 0) := e_a.toEquiv.subsingleton
    exact (weil_iso_roof_coker_closed_point_skyscraper_eval k ℓ (r + 1)
      Z_R x_Z hx_Z U_Z hU_Z (ℛ_Z a)
      (hHDI_tors (ℓ ^ (r + 1)) U_Z.ι a) (hOpenZero U_Z.ι a ha)).1 hSub_Z
  obtain ⟨bdry_Z, hbdry_Z⟩ :=
    (@weil_iso_roof_coker_open_pushforward_syzygy_shift
      Z_R U_Z.toScheme U_Z.ι (ℓ ^ (r + 1)) n hc_Z hr_Z T_UZ hT_UZ T_ZR hT_ZR hIso_ηZ).2
      hZero_RZ p_Z hp_Z
  obtain ⟨e_top⟩ := hStalkEquiv (n + 1) (Nat.succ_pos n)
  let δ_r : weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) (n + 1) →+ ZMod (ℓ ^ (r + 1)) :=
    θ_ker.comp (ι_edge.comp (e_top.toAddMonoidHom.comp bdry_Z))
  refine ⟨δ_r, fun y hδ => ?_⟩
  have h1 : ι_edge (e_top (bdry_Z y)) = 0 :=
    hθ_ker_inj (hδ.trans (map_zero θ_ker).symm)
  have h2 : e_top (bdry_Z y) = 0 :=
    hι_edge_inj (h1.trans (map_zero ι_edge).symm)
  have h3 : bdry_Z y = 0 :=
    e_top.injective (h2.trans (map_zero e_top).symm)
  exact hbdry_Z y h3

theorem weil_qcvs_ve_godement_above_top_and_sheaf_verdier_duality (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ) (hm : 1 ≤ m)
    (hGod : WeilHasTruncatedGodementComplex S d m) :
    let R := ULift.{u, 0} (ZMod m)
    let 𝒞 := CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)
    let oneR := weilEtaleModuleUnit S m
    (∀ (F : 𝒞) (q : ℕ), 2 * d < q →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR F q)) ∧
    (∀ (τ : weilEtaleModuleH S m (2 * d) →+ ZMod m),
      WeilHasVerdierDualExtPackage S d m τ →
      Function.Bijective τ →
      Function.Bijective (fun c : ZMod m =>
        c.val • CategoryTheory.CategoryStruct.id oneR) →
      ∀ (G : 𝒞) (p q : ℕ), p + q = 2 * d →
        Nonempty (CategoryTheory.Abelian.Ext.{u} G oneR q ≃+
          (CategoryTheory.Abelian.Ext.{u} oneR G p →+ ZMod m))) :=
by
  dsimp only
  let R := ULift.{u, 0} (ZMod m)
  let 𝒞 := CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)
  let oneR := weilEtaleModuleUnit S m
  obtain ⟨𝒯, η, diff, _, hZeroAbove, hMonoη, hEx0, hExSucc, hAcyc, _⟩ := hGod
  have hCokerStep : ∀ {X Y Z : 𝒞} (u : Quiver.Hom X Y) (v : Quiver.Hom Y Z)
      (huv : CategoryTheory.CategoryStruct.comp u v = 0),
      (CategoryTheory.ShortComplex.mk u v huv).Exact →
      ∃ (SC : CategoryTheory.ShortComplex 𝒞),
        SC.ShortExact ∧
        SC.X₁ = CategoryTheory.Limits.cokernel u ∧
        SC.X₂ = Z ∧
        SC.X₃ = CategoryTheory.Limits.cokernel v := by
    intro X Y Z u v huv hEx
    let π_u : Quiver.Hom Y (CategoryTheory.Limits.cokernel u) := CategoryTheory.Limits.cokernel.π u
    let π_v : Quiver.Hom Z (CategoryTheory.Limits.cokernel v) := CategoryTheory.Limits.cokernel.π v
    have : CategoryTheory.Epi π_u := CategoryTheory.Limits.coequalizer.π_epi
    have : CategoryTheory.Epi π_v := CategoryTheory.Limits.coequalizer.π_epi
    let μ : Quiver.Hom (CategoryTheory.Limits.cokernel u) Z :=
      CategoryTheory.Limits.cokernel.desc u v huv
    have hMono_μ : CategoryTheory.Mono μ :=
      CategoryTheory.ShortComplex.Exact.mono_cokernelDesc hEx
    have hπμ : CategoryTheory.CategoryStruct.comp π_u μ = v :=
      CategoryTheory.Limits.cokernel.π_desc u v huv
    have hμπ : CategoryTheory.CategoryStruct.comp μ π_v = 0 := by
      apply (CategoryTheory.cancel_epi π_u).mp
      rw [← CategoryTheory.Category.assoc, hπμ, CategoryTheory.Limits.cokernel.condition v,
        CategoryTheory.Limits.comp_zero]
    let SC_step : CategoryTheory.ShortComplex 𝒞 := CategoryTheory.ShortComplex.mk μ π_v hμπ
    let cf := CategoryTheory.Limits.CokernelCofork.ofπ π_v hμπ
    have hColim : CategoryTheory.Limits.IsColimit cf :=
      CategoryTheory.Limits.Cofork.IsColimit.mk cf
        (fun s => CategoryTheory.Limits.cokernel.desc v s.π (by
          have hs0 : CategoryTheory.CategoryStruct.comp μ s.π = 0 :=
            s.condition.trans CategoryTheory.Limits.zero_comp
          rw [← hπμ, CategoryTheory.Category.assoc, hs0, CategoryTheory.Limits.comp_zero]))
        (fun s => CategoryTheory.Limits.cokernel.π_desc v s.π _)
        (fun s m_hom hm_fac => by
          apply (CategoryTheory.cancel_epi π_v).mp
          exact hm_fac.trans (CategoryTheory.Limits.cokernel.π_desc v s.π _).symm)
    have hEx_step : SC_step.Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC_step hColim
    exact ⟨SC_step,
      { exact := hEx_step
        mono_f := hMono_μ
        epi_g := CategoryTheory.Limits.coequalizer.π_epi },
      rfl, rfl, rfl⟩
  have hZeroExt : ∀ (Z : 𝒞), CategoryTheory.Limits.IsZero Z →
      ∀ k : ℕ, Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR Z k) := by
    intro Z hZeroZ k
    have hid0 : CategoryTheory.CategoryStruct.id Z = 0 :=
      hZeroZ.eq_of_src (CategoryTheory.CategoryStruct.id Z) 0
    refine ⟨fun x y => ?_⟩
    have hx0 : ∀ z : CategoryTheory.Abelian.Ext.{u} oneR Z k, z = 0 := by
      intro z
      calc
        z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id Z))
              (Nat.add_zero k) :=
          (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ 0) (Nat.add_zero k) := by
          rw [hid0]
        _ = z.comp 0 (Nat.add_zero k) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_zero]
        _ = 0 := by
          rw [CategoryTheory.Abelian.Ext.comp_zero]
    exact (hx0 x).trans (hx0 y).symm
  have hShiftSES : ∀ (SC : CategoryTheory.ShortComplex 𝒞), SC.ShortExact →
      ∀ (k' k : ℕ) (_ : k' + 1 = k),
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR SC.X₂ k) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR SC.X₃ k') →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR SC.X₁ k) := by
    intro SC hSE k' k hk_eq hSub₂ hSub₃
    refine ⟨fun x y => ?_⟩
    have hZero_x : ∀ z : CategoryTheory.Abelian.Ext.{u} oneR SC.X₁ k, z = 0 := by
      intro z
      have hz_f : z.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero k) = 0 :=
        @Subsingleton.elim _ hSub₂ _ 0
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSE z hz_f hk_eq
      have hx₃_0 : x₃ = 0 := @Subsingleton.elim _ hSub₃ x₃ 0
      rw [← hx₃, hx₃_0, CategoryTheory.Abelian.Ext.zero_comp]
    exact (hZero_x x).trans (hZero_x y).symm
  refine ⟨?_, ?_⟩
  · intro F q hq
    let C : ℕ → 𝒞 := fun n =>
      Nat.casesOn n
        (CategoryTheory.Limits.cokernel (η.app F))
        (fun s => CategoryTheory.Limits.cokernel ((diff s).app F))
    let SC₀ : CategoryTheory.ShortComplex 𝒞 :=
      CategoryTheory.ShortComplex.mk (η.app F)
        (CategoryTheory.Limits.cokernel.π (η.app F))
        (CategoryTheory.Limits.cokernel.condition (η.app F))
    have hSE₀ : SC₀.ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_cokernel (η.app F)
        mono_f := hMonoη F
        epi_g := CategoryTheory.Limits.coequalizer.π_epi }
    have hSES_step : ∀ s : ℕ,
        ∃ (SC : CategoryTheory.ShortComplex 𝒞),
          SC.ShortExact ∧
          SC.X₁ = C s ∧
          SC.X₂ = (𝒯 (s + 1)).obj F ∧
          SC.X₃ = C (s + 1) := by
      intro s
      cases s with
      | zero =>
        obtain ⟨h₀, hEx₀⟩ := hEx0 F
        exact hCokerStep (η.app F) ((diff 0).app F) h₀ hEx₀
      | succ s' =>
        obtain ⟨hs', hExs'⟩ := hExSucc s' F
        exact hCokerStep ((diff s').app F) ((diff (s' + 1)).app F) hs' hExs'
    have hBase_van : ∀ k : ℕ,
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (C (2 * d)) k) := by
      obtain ⟨SC_top, hSE_top, hX₁, hX₂, _⟩ := hSES_step (2 * d)
      have : CategoryTheory.Mono SC_top.f := hSE_top.mono_f
      have hZero_X₂ : CategoryTheory.Limits.IsZero SC_top.X₂ := by
        rw [hX₂]
        exact hZeroAbove (2 * d + 1) (Nat.lt_succ_self (2 * d)) F
      have hZero_X₁ : CategoryTheory.Limits.IsZero SC_top.X₁ :=
        CategoryTheory.Limits.IsZero.of_mono SC_top.f hZero_X₂
      have hZero_C : CategoryTheory.Limits.IsZero (C (2 * d)) := by
        rwa [← hX₁]
      exact hZeroExt (C (2 * d)) hZero_C
    have hC_van : ∀ t : ℕ, t ≤ 2 * d → ∀ k : ℕ, t ≤ k →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (C (2 * d - t)) k) := by
      intro t
      induction t with
      | zero =>
        intro _ k _
        rw [Nat.sub_zero]
        exact hBase_van k
      | succ t' ih =>
        intro ht k hk
        let s : ℕ := 2 * d - (t' + 1)
        let k' : ℕ := k - 1
        have hs1 : 2 * d - t' = s + 1 := by omega
        have hk_eq : k' + 1 = k := by omega
        have ht' : t' ≤ 2 * d := by omega
        have hk' : t' ≤ k' := by omega
        have hk_pos : 1 ≤ k := by omega
        obtain ⟨SC_s, hSE_s, hX₁, hX₂, hX₃⟩ := hSES_step s
        have hSub₂ : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR SC_s.X₂ k) := by
          rw [hX₂]
          exact hAcyc (s + 1) k hk_pos F
        have hSub₃ : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR SC_s.X₃ k') := by
          rw [hX₃, ← hs1]
          exact ih ht' k' hk'
        have hSub₁ := hShiftSES SC_s hSE_s k' k hk_eq hSub₂ hSub₃
        rwa [hX₁] at hSub₁
    have hC0_van : ∀ k : ℕ, 2 * d ≤ k →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (C 0) k) := by
      intro k hk
      have h := hC_van (2 * d) (le_refl (2 * d)) k hk
      rwa [Nat.sub_self] at h
    let k' : ℕ := q - 1
    have hk'_eq : k' + 1 = q := by omega
    have hk'_ge : 2 * d ≤ k' := by omega
    have hq_pos : 1 ≤ q := by omega
    exact hShiftSES SC₀ hSE₀ k' q hk'_eq (hAcyc 0 q hq_pos F) (hC0_van k' hk'_ge)
  · intro τ hDualExt hτ_bij hEnd
    obtain ⟨_, hVan, ⟨E_top, hE_nat⟩⟩ := hDualExt
    have hm_id : ∀ Y : 𝒞, m • CategoryTheory.CategoryStruct.id Y = 0 := by
      intro Y
      ext U y
      change m • y = 0
      have hmR : ((m : ℕ) : R) = 0 := ULift.ext _ _ (ZMod.natCast_self m)
      rw [← Nat.cast_smul_eq_nsmul R m y, hmR, zero_smul]
    have hExt_tors : ∀ (X Y : 𝒞) (k : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y k),
        m • x = 0 := by
      intro X Y k x
      have hmk_nsmul : ∀ (n : ℕ) (f : Quiver.Hom Y Y),
          CategoryTheory.Abelian.Ext.mk₀ (n • f) = n • CategoryTheory.Abelian.Ext.mk₀ f := by
        intro n f
        induction n with
        | zero => rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero]
        | succ n ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
      let pre_x : CategoryTheory.Abelian.Ext.{u} Y Y 0 →+ CategoryTheory.Abelian.Ext.{u} X Y k :=
        AddMonoidHom.mk' (fun u => x.comp u (Nat.add_zero k))
          (fun u₁ u₂ => CategoryTheory.Abelian.Ext.comp_add x u₁ u₂ (Nat.add_zero k))
      calc
        m • x = m • pre_x (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id Y)) := by
          rw [AddMonoidHom.mk'_apply, CategoryTheory.Abelian.Ext.comp_mk₀_id]
        _ = pre_x (m • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id Y)) :=
          (map_nsmul pre_x m _).symm
        _ = pre_x (CategoryTheory.Abelian.Ext.mk₀ (m • CategoryTheory.CategoryStruct.id Y)) := by
          rw [← hmk_nsmul]
        _ = pre_x 0 := by rw [hm_id Y, CategoryTheory.Abelian.Ext.mk₀_zero]
        _ = 0 := map_zero pre_x
    have hExt_rem : ∀ (X Y : 𝒞) (k n : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y k),
        n • x = (n % m) • x := by
      intro X Y k n x
      conv_lhs => rw [← Nat.div_add_mod n m]
      rw [add_nsmul, mul_comm m (n / m), mul_smul, hExt_tors X Y k x, smul_zero, zero_add]
    have hval_cast : ∀ c : ZMod m, (c.val : ZMod m) = c := by
      intro c
      by_cases hm1 : m = 1
      · subst hm1
        exact Subsingleton.elim _ _
      · have : NeZero m := ⟨by omega⟩
        exact ZMod.natCast_zmod_val c
    let id_ext0 : CategoryTheory.Abelian.Ext.{u} oneR oneR 0 :=
      CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id oneR)
    have he₀_bij : Function.Bijective (fun c : ZMod m => c.val • id_ext0) := by
      have hEq : (fun c : ZMod m => c.val • id_ext0) =
          (⇑CategoryTheory.Abelian.Ext.addEquiv₀.symm) ∘
            (fun c : ZMod m => c.val • CategoryTheory.CategoryStruct.id oneR) := by
        ext c
        simp only [Function.comp_apply, map_nsmul]
        rfl
      rw [hEq]
      exact CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective.comp hEnd
    let e₀_hom : ZMod m →+ CategoryTheory.Abelian.Ext.{u} oneR oneR 0 :=
      { toFun := fun c => c.val • id_ext0
        map_zero' := by rw [ZMod.val_zero, zero_nsmul]
        map_add' := fun c₁ c₂ => by
          by_cases hm1 : m = 1
          · subst hm1
            have h0 : ∀ x : CategoryTheory.Abelian.Ext.{u} oneR oneR 0, x = 0 := by
              intro x
              calc
                x = 1 • x := (one_nsmul x).symm
                _ = 0 := hExt_tors oneR oneR 0 x
            rw [h0 ((c₁ + c₂).val • id_ext0), h0 (c₁.val • id_ext0), h0 (c₂.val • id_ext0),
              add_zero]
          · have : NeZero m := ⟨by omega⟩
            rw [ZMod.val_add, ← hExt_rem oneR oneR 0, add_nsmul] }
    let e₀ : ZMod m ≃+ CategoryTheory.Abelian.Ext.{u} oneR oneR 0 :=
      AddEquiv.ofBijective e₀_hom he₀_bij
    have he₀_comp : ∀ {Y : 𝒞} {k : ℕ} (c : ZMod m) (α : CategoryTheory.Abelian.Ext.{u} oneR Y k),
        (e₀ c).comp α (Nat.zero_add k) = c.val • α := by
      intro Y k c α
      change (α.postcomp oneR (Nat.zero_add k)) (c.val • id_ext0) = c.val • α
      rw [map_nsmul]
      change c.val • (id_ext0.comp α (Nat.zero_add k)) = c.val • α
      rw [CategoryTheory.Abelian.Ext.mk₀_id_comp]
    let Φ : ∀ (G₀ : 𝒞) (p₀ q₀ : ℕ) (_ : p₀ + q₀ = 2 * d),
        CategoryTheory.Abelian.Ext.{u} G₀ oneR q₀ →+
          (CategoryTheory.Abelian.Ext.{u} oneR G₀ p₀ →+ ZMod m) :=
      fun G₀ p₀ q₀ hpq₀ =>
        AddMonoidHom.mk'
          (fun β => AddMonoidHom.mk'
            (fun α => τ (α.comp β hpq₀))
            (fun α₁ α₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add]))
          (fun β₁ β₂ => by
            ext α
            simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply,
              CategoryTheory.Abelian.Ext.comp_add, map_add])
    let ψ₁ : CategoryTheory.Abelian.Ext.{u} oneR oneR 0 →+ ZMod m := e₀.symm.toAddMonoidHom
    let u₀ : ZMod m := τ (E_top oneR ψ₁)
    have hΦ_top_eval : ∀ (G₀ : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR G₀ 0 →+ ZMod m)
        (α : CategoryTheory.Abelian.Ext.{u} oneR G₀ 0),
        Φ G₀ 0 (2 * d) (Nat.zero_add (2 * d)) (E_top G₀ φ) α = φ α * u₀ := by
      intro G₀ φ α
      have hpull : φ.comp (α.postcomp oneR (Nat.add_zero 0)) = (φ α).val • ψ₁ := by
        ext u
        have hu : u = e₀ (ψ₁ u) := (e₀.apply_symm_apply u).symm
        conv_lhs => rw [hu]
        change φ ((e₀ (ψ₁ u)).comp α (Nat.add_zero 0)) = (φ α).val • ψ₁ u
        rw [he₀_comp (ψ₁ u) α, map_nsmul, nsmul_eq_mul, nsmul_eq_mul,
          hval_cast, hval_cast, mul_comm]
      change τ (α.comp (E_top G₀ φ) (Nat.zero_add (2 * d))) = φ α * u₀
      rw [hE_nat G₀ φ α, hpull, map_nsmul, map_nsmul, nsmul_eq_mul, hval_cast]
    obtain ⟨w₁, hw₁⟩ := hτ_bij.2 1
    let φ₁ := (E_top oneR).symm w₁
    have hv₀_mul : φ₁ id_ext0 * u₀ = 1 := by
      have h1 := hΦ_top_eval oneR φ₁ id_ext0
      change τ (id_ext0.comp (E_top oneR φ₁) (Nat.zero_add (2 * d))) = φ₁ id_ext0 * u₀ at h1
      rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, (E_top oneR).apply_symm_apply w₁, hw₁] at h1
      exact h1.symm
    let v₀ : ZMod m := φ₁ id_ext0
    have hu₀_mul : u₀ * v₀ = 1 := by rw [mul_comm]; exact hv₀_mul
    have hΦ_base : ∀ (q₀ : ℕ) (hq₀ : 0 + q₀ = 2 * d) (G₀ : 𝒞),
        Function.Bijective (Φ G₀ 0 q₀ hq₀) := by
      intro q₀ hq₀ G₀
      have hq_eq : q₀ = 2 * d := by omega
      subst hq_eq
      rw [Subsingleton.elim hq₀ (Nat.zero_add (2 * d))]
      have hscale_bij : Function.Bijective
          (fun φ : CategoryTheory.Abelian.Ext.{u} oneR G₀ 0 →+ ZMod m =>
            Φ G₀ 0 (2 * d) (Nat.zero_add (2 * d)) (E_top G₀ φ)) := by
        refine ⟨?_, ?_⟩
        · intro ψ_a ψ_b h_eq
          ext α
          have h_ap := DFunLike.congr_fun h_eq α
          rw [hΦ_top_eval G₀ ψ_a α, hΦ_top_eval G₀ ψ_b α] at h_ap
          calc
            ψ_a α = ψ_a α * (u₀ * v₀) := by rw [hu₀_mul, mul_one]
            _ = (ψ_a α * u₀) * v₀ := (mul_assoc _ _ _).symm
            _ = (ψ_b α * u₀) * v₀ := by rw [h_ap]
            _ = ψ_b α * (u₀ * v₀) := mul_assoc _ _ _
            _ = ψ_b α := by rw [hu₀_mul, mul_one]
        · intro χ
          let φ_pre : CategoryTheory.Abelian.Ext.{u} oneR G₀ 0 →+ ZMod m :=
            AddMonoidHom.mk' (fun α => χ α * v₀) (fun α₁ α₂ => by rw [map_add, add_mul])
          refine ⟨φ_pre, ?_⟩
          ext α
          rw [hΦ_top_eval G₀ φ_pre α]
          change (χ α * v₀) * u₀ = χ α
          rw [mul_assoc, hv₀_mul, mul_one]
      exact (Function.Bijective.of_comp_iff (Φ G₀ 0 (2 * d) (Nat.zero_add (2 * d)))
        (E_top G₀).bijective).mp hscale_bij
    have hΦ_bij : ∀ (p₀ q₀ : ℕ) (hpq₀ : p₀ + q₀ = 2 * d) (G₀ : 𝒞),
        Function.Bijective (Φ G₀ p₀ q₀ hpq₀) := by
      intro p₀
      induction p₀ with
      | zero => exact hΦ_base
      | succ p₀ ih =>
        intro q₀ hpq₀ G₀
        have hq_lt : q₀ < 2 * d := by omega
        have hpq' : p₀ + (q₀ + 1) = 2 * d := by omega
        have h1q : 1 + q₀ = q₀ + 1 := Nat.one_add q₀
        let f_G : Quiver.Hom G₀ ((𝒯 0).obj G₀) := η.app G₀
        let Q : 𝒞 := CategoryTheory.Limits.cokernel f_G
        let π₀ : Quiver.Hom ((𝒯 0).obj G₀) Q := CategoryTheory.Limits.cokernel.π f_G
        let S_G : CategoryTheory.ShortComplex 𝒞 :=
          CategoryTheory.ShortComplex.mk f_G π₀ (CategoryTheory.Limits.cokernel.condition f_G)
        have hSG : S_G.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_cokernel f_G
            mono_f := hMonoη G₀
            epi_g := CategoryTheory.Limits.coequalizer.π_epi }
        let δ : CategoryTheory.Abelian.Ext.{u} Q G₀ 1 := hSG.extClass
        have hSub_T0_q : Subsingleton (CategoryTheory.Abelian.Ext.{u} ((𝒯 0).obj G₀) oneR q₀) :=
          hVan ((𝒯 0).obj G₀) (fun k hk => hAcyc 0 k hk G₀) q₀ hq_lt
        have hSub_T0_p1 :
            Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((𝒯 0).obj G₀) (p₀ + 1)) :=
          hAcyc 0 (p₀ + 1) (by omega) G₀
        have hQ_bij := ih (q₀ + 1) hpq' Q
        have hT_bij := ih (q₀ + 1) hpq' ((𝒯 0).obj G₀)
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro β hβ0
          have hδβ_zero : Φ Q p₀ (q₀ + 1) hpq' (δ.comp β h1q) = 0 := by
            ext ξ
            change τ (ξ.comp (δ.comp β h1q) hpq') = 0
            have hassoc : (ξ.comp δ rfl).comp β hpq₀ = ξ.comp (δ.comp β h1q) hpq' :=
              CategoryTheory.Abelian.Ext.comp_assoc ξ δ β rfl h1q (by omega)
            rw [← hassoc]
            exact DFunLike.congr_fun hβ0 (ξ.comp δ rfl)
          have hδβ : δ.comp β h1q = 0 :=
            (injective_iff_map_eq_zero _).mp hQ_bij.1 (δ.comp β h1q) hδβ_zero
          obtain ⟨γ, hγ⟩ :=
            CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hSG oneR β h1q hδβ
          have hγ0 : γ = 0 := @Subsingleton.elim _ hSub_T0_q γ 0
          rw [← hγ, hγ0, CategoryTheory.Abelian.Ext.comp_zero]
        · intro ψ
          let ψ_Q : CategoryTheory.Abelian.Ext.{u} oneR Q p₀ →+ ZMod m :=
            AddMonoidHom.mk' (fun ξ => ψ (ξ.comp δ rfl))
              (fun ξ₁ ξ₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add])
          obtain ⟨x₃, hx₃⟩ := hQ_bij.2 ψ_Q
          have hπ_x₃_zero : Φ ((𝒯 0).obj G₀) p₀ (q₀ + 1) hpq'
              ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q₀ + 1))) = 0 := by
            ext ζ
            change τ (ζ.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q₀ + 1)))
              hpq') = 0
            have hassoc : (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p₀)).comp x₃
                hpq' =
                ζ.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q₀ + 1)))
                  hpq' :=
              CategoryTheory.Abelian.Ext.comp_assoc ζ (CategoryTheory.Abelian.Ext.mk₀ π₀) x₃
                (Nat.add_zero p₀) (Nat.zero_add (q₀ + 1)) (by omega)
            rw [← hassoc]
            have h1 := DFunLike.congr_fun hx₃
              (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p₀))
            change τ ((ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p₀)).comp x₃
              hpq') =
              ψ ((ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p₀)).comp δ rfl) at h1
            have hπδ : (CategoryTheory.Abelian.Ext.mk₀ π₀).comp δ (Nat.zero_add 1) = 0 :=
              hSG.comp_extClass
            have hassoc2 :
                (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π₀) (Nat.add_zero p₀)).comp δ rfl =
                ζ.comp ((CategoryTheory.Abelian.Ext.mk₀ π₀).comp δ (Nat.zero_add 1)) rfl :=
              CategoryTheory.Abelian.Ext.comp_assoc ζ (CategoryTheory.Abelian.Ext.mk₀ π₀) δ
                (Nat.add_zero p₀) (Nat.zero_add 1) (by omega)
            rw [h1, hassoc2, hπδ, CategoryTheory.Abelian.Ext.comp_zero, map_zero]
          have hπ_x₃ : (CategoryTheory.Abelian.Ext.mk₀ π₀).comp x₃ (Nat.zero_add (q₀ + 1)) = 0 :=
            (injective_iff_map_eq_zero _).mp hT_bij.1 _ hπ_x₃_zero
          obtain ⟨β, hβ⟩ :=
            CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSG oneR x₃ hπ_x₃ h1q
          refine ⟨β, ?_⟩
          ext α
          have hα_f : α.comp (CategoryTheory.Abelian.Ext.mk₀ f_G) (Nat.add_zero (p₀ + 1)) = 0 :=
            @Subsingleton.elim _ hSub_T0_p1 _ 0
          obtain ⟨ξ, hξ⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSG α hα_f rfl
          change τ (α.comp β hpq₀) = ψ α
          have hassoc3 : (ξ.comp δ rfl).comp β hpq₀ = ξ.comp (δ.comp β h1q) hpq' :=
            CategoryTheory.Abelian.Ext.comp_assoc ξ δ β rfl h1q (by omega)
          rw [← hξ, hassoc3, hβ]
          exact DFunLike.congr_fun hx₃ ξ
    intro G p q hpq
    exact ⟨AddEquiv.ofBijective (Φ G p q hpq) (hΦ_bij p q hpq G)⟩

theorem weil_qcvs_ve_open_localFree_dual_and_torsion_equiv (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (m q : ℕ) (hm : 1 ≤ m) :
