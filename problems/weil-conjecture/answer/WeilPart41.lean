        have heTΩ_fst : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map e_TΩ.inv).left ≫
            CategoryTheory.Limits.pullback.fst T_Ω.hom g_γ = g_γ := by
          have hcond : CategoryTheory.Limits.pullback.fst T_Ω.hom g_γ =
              CategoryTheory.Limits.pullback.snd T_Ω.hom g_γ ≫ g_γ :=
            (CategoryTheory.Category.comp_id
              (CategoryTheory.Limits.pullback.fst (𝟙 S_Ω) g_γ)).symm.trans
              CategoryTheory.Limits.pullback.condition
          have hw_eT : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map e_TΩ.inv).left ≫
              CategoryTheory.Limits.pullback.snd T_Ω.hom g_γ = 𝟙 S_Ω :=
            CategoryTheory.MorphismProperty.Over.w e_TΩ.inv
          exact (congrArg (((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map e_TΩ.inv).left ≫ ·)
            hcond).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ g_γ) hw_eT).trans (CategoryTheory.Category.id_comp g_γ)))
        have hLHS_fst : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
            (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V)).left ≫
            CategoryTheory.Limits.pullback.fst π_r η_U = g_γ ≫ η_V := by
          have hmap_comp : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
              (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V)).left =
              ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map e_TΩ.inv).left ≫
                ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map (B_gγ.map σ_ηV)).left ≫
                ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map (e_B.inv.app E_V)).left := rfl
          exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst π_r η_U) hmap_comp).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·)
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (_ ≫ ·) heB_fst).trans
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst π_r η_U)
                        hBgγ_map_fst).trans
                        ((CategoryTheory.Category.assoc _ _ _).trans
                          (congrArg (_ ≫ ·) hσ_fst))))))).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ η_V) heTΩ_fst))))
        have hBηU_map_fst : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
            (B_ηU.map s_σ)).left ≫
            CategoryTheory.Limits.pullback.fst π_r η_U =
            CategoryTheory.Limits.pullback.fst π_r η_U ≫ m_σ_sch :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst π_r η_U)
            (CategoryTheory.MorphismProperty.Over.pullback_map_left
              (@AlgebraicGeometry.Etale) ⊤ η_U s_σ)).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have hRHS_fst : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
            (σ_ηV ≫ B_ηU.map s_σ)).left ≫
            CategoryTheory.Limits.pullback.fst π_r η_U = η_V ≫ m_σ_sch := by
          have hmap_comp : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
              (σ_ηV ≫ B_ηU.map s_σ)).left =
              ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map σ_ηV).left ≫
                ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map (B_ηU.map s_σ)).left := rfl
          exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst π_r η_U) hmap_comp).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·) hBηU_map_fst).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ m_σ_sch) hσ_fst))))
        exact hLHS_fst.trans (hgγ_ηV.trans hRHS_fst.symm)
      · 
        have hLHS_snd : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
            (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V)).left ≫
            CategoryTheory.Limits.pullback.snd π_r η_U = 𝟙 S_Ω :=
          CategoryTheory.Over.w
            ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
              (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V))
        have hRHS_snd : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map
            (σ_ηV ≫ B_ηU.map s_σ)).left ≫
            CategoryTheory.Limits.pullback.snd π_r η_U = 𝟙 S_Ω :=
          CategoryTheory.Over.w
            ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map (σ_ηV ≫ B_ηU.map s_σ))
        exact hLHS_snd.trans hRHS_snd.symm

    
    have hRHS_eval :
        (ℛ_Ω.obj.map e_TΩ.inv.op).hom
          ((ℛ_Ω.obj.map (B_gγ.map σ_ηV).op).hom
            ((β_Tor_gγ.hom.app (Opposite.op (B_ηU.obj E_V))).hom
              ((β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v))) =
          edge_Ω (p_τ (α_Ω v)) := by
      have hnat_gγ : (ℛ_Ω.obj.map (B_gγ.map σ_ηV).op).hom
          ((β_Tor_gγ.hom.app (Opposite.op (B_ηU.obj E_V))).hom
            ((β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v)) =
          (β_Tor_gγ.hom.app (Opposite.op T_Ω)).hom
            ((ℛ_Ω.obj.map (Opposite.op σ_ηV)).hom
              ((β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v)) :=
        congrArg (fun m => m.hom ((β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v))
          (β_Tor_gγ.hom.naturality (Opposite.op σ_ηV)).symm
      have hα_edge : (ℛ_Ω.obj.map (Opposite.op σ_ηV)).hom
          ((β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v) = edge_Ω (α_Ω v) :=
        (hbc_eval t_v).symm.trans (e_edge.apply_symm_apply _).symm
      rw [hnat_gγ, hα_edge]
      exact hEdge_τ (α_Ω v)

    have hLHS_eval :
        (ℛ_Ω.obj.map e_TΩ.inv.op).hom
          ((ℛ_Ω.obj.map (B_gγ.map σ_ηV).op).hom
            ((ℛ_Ω.obj.map (Opposite.op (e_B.inv.app E_V))).hom
              ((β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v))) =
          edge_Ω (α_Ω (((ρ_r σ_B).val).mulVec v)) := by
      let x₀ := (β_Tor_ηU.hom.app (Opposite.op E_V)).hom t_v
      have hcomp_op :
          (ℛ_Ω.obj.map e_TΩ.inv.op).hom
            ((ℛ_Ω.obj.map (B_gγ.map σ_ηV).op).hom
              ((ℛ_Ω.obj.map (Opposite.op (e_B.inv.app E_V))).hom x₀)) =
          (ℛ_Ω.obj.map (Opposite.op (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V))).hom x₀ := by
        have h_m1 : ℛ_Ω.obj.map (Opposite.op (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V)) =
            ℛ_Ω.obj.map (Opposite.op (e_B.inv.app E_V)) ≫
              ℛ_Ω.obj.map (B_gγ.map σ_ηV).op ≫
              ℛ_Ω.obj.map e_TΩ.inv.op := by
          change ℛ_Ω.obj.map (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V).op = _
          rw [CategoryTheory.op_comp, CategoryTheory.op_comp,
            ℛ_Ω.obj.map_comp, ℛ_Ω.obj.map_comp]
          exact CategoryTheory.Category.assoc _ _ _
        exact (congrArg (fun m => m.hom x₀) h_m1).symm
      have hmor_step :
          (ℛ_Ω.obj.map (Opposite.op (e_TΩ.inv ≫ B_gγ.map σ_ηV ≫ e_B.inv.app E_V))).hom x₀ =
          (ℛ_Ω.obj.map (Opposite.op (σ_ηV ≫ B_ηU.map s_σ))).hom x₀ :=
        congrArg (fun f => (ℛ_Ω.obj.map (Opposite.op f)).hom x₀) hMor_eq
      have hcomp_sσ :
          (ℛ_Ω.obj.map (Opposite.op (σ_ηV ≫ B_ηU.map s_σ))).hom x₀ =
          (ℛ_Ω.obj.map (Opposite.op σ_ηV)).hom
            ((ℛ_Ω.obj.map (Opposite.op (B_ηU.map s_σ))).hom x₀) := by
        have h_m2 : ℛ_Ω.obj.map (Opposite.op (σ_ηV ≫ B_ηU.map s_σ)) =
            ℛ_Ω.obj.map (Opposite.op (B_ηU.map s_σ)) ≫ ℛ_Ω.obj.map (Opposite.op σ_ηV) := by
          change ℛ_Ω.obj.map (σ_ηV ≫ B_ηU.map s_σ).op = _
          rw [CategoryTheory.op_comp, ℛ_Ω.obj.map_comp]
          rfl
        exact congrArg (fun m => m.hom x₀) h_m2
      have hnat_ηU :
          (ℛ_Ω.obj.map (Opposite.op (B_ηU.map s_σ))).hom x₀ =
          (β_Tor_ηU.hom.app (Opposite.op E_V)).hom
            ((ℛ_r.obj.map (Opposite.op s_σ)).hom t_v) :=
        congrArg (fun m => m.hom t_v) (β_Tor_ηU.hom.naturality (Opposite.op s_σ)).symm
      have hnat_α :
          (ℛ_r.obj.map (Opposite.op s_σ)).hom t_v =
          (α_r.hom.app (Opposite.op E_V)).hom
            ((𝒱_r.obj.map (Opposite.op s_σ)).hom (ev_V.symm v)) :=
        congrArg (fun m => m.hom (ev_V.symm v)) (α_r.hom.naturality (Opposite.op s_σ)).symm
      have hev_deck :
          (𝒱_r.obj.map (Opposite.op s_σ)).hom (ev_V.symm v) =
          ev_V.symm (((ρ_r σ_B).val).mulVec v) := by
        apply ev_V.injective
        rw [hev_V_equiv σ_B s_σ hs_σ_left (ev_V.symm v), ev_V.apply_symm_apply,
          ev_V.apply_symm_apply]
      have h_s1 : (ℛ_Ω.obj.map (Opposite.op σ_ηV)).hom
          ((ℛ_Ω.obj.map (Opposite.op (B_ηU.map s_σ))).hom x₀) =
          e_bc (ev_sec ℛ_r ((ℛ_r.obj.map (Opposite.op s_σ)).hom t_v)) :=
        (congrArg (ℛ_Ω.obj.map (Opposite.op σ_ηV)).hom hnat_ηU).trans
          (hbc_eval ((ℛ_r.obj.map (Opposite.op s_σ)).hom t_v)).symm
      have h_s2 : e_bc (ev_sec ℛ_r ((ℛ_r.obj.map (Opposite.op s_σ)).hom t_v)) =
          edge_Ω (α_Ω (((ρ_r σ_B).val).mulVec v)) :=
        (congrArg (fun z => e_bc (ev_sec ℛ_r z))
          (hnat_α.trans (congrArg (α_r.hom.app (Opposite.op E_V)).hom hev_deck))).trans
          (e_edge.apply_symm_apply _).symm
      exact hcomp_op.trans (hmor_step.trans (hcomp_sσ.trans (h_s1.trans h_s2)))

    apply e_edge.injective
    have hBoth := congrArg (fun x =>
      (ℛ_Ω.obj.map e_TΩ.inv.op).hom ((ℛ_Ω.obj.map (B_gγ.map σ_ηV).op).hom x)) hPaste
    exact (hRHS_eval.symm.trans hBoth.symm).trans hLHS_eval

theorem weil_odp_coker_strictly_henselian_proper_pullback_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (A : Type u) [CommRing A] [HenselianLocalRing A]
    (c_A : k →+* A) (π_A : A →+* k)
    (hπ_c : π_A.comp c_A = RingHom.id k)
    (hπ_ker : RingHom.ker π_A = IsLocalRing.maximalIdeal A)
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    (f : X ⟶ S) [AlgebraicGeometry.IsProper f.left]
    (g_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ S.left)
    (hg_A : g_A ≫ S.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_A)) :
    let i_A : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A)
    ∀ (ι_k : CategoryTheory.Limits.pullback f.left (i_A ≫ g_A) ⟶
        CategoryTheory.Limits.pullback f.left g_A),
      ι_k ≫ CategoryTheory.Limits.pullback.fst f.left g_A =
        CategoryTheory.Limits.pullback.fst f.left (i_A ≫ g_A) →
      ι_k ≫ CategoryTheory.Limits.pullback.snd f.left g_A =
        CategoryTheory.Limits.pullback.snd f.left (i_A ≫ g_A) ≫ i_A →
      ∀ (q : ℕ)
        (p_k : weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left g_A)
            (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left (i_A ≫ g_A))
            (ℓ ^ (r + 1)) q),
        WeilIsTorsionEtalePullback ι_k (ℓ ^ (r + 1)) q p_k →
        Function.Bijective p_k :=
by
  let _ := hPBC
  let _ := hg_A
  intro i_A ι_k hι_fst hι_snd q p_k hp_k
  let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let X_A := CategoryTheory.Limits.pullback f.left g_A
  let X_k := CategoryTheory.Limits.pullback f.left (i_A ≫ g_A)
  let g'_A := CategoryTheory.Limits.pullback.fst f.left g_A
  let f_A := CategoryTheory.Limits.pullback.snd f.left g_A
  let g'_k := CategoryTheory.Limits.pullback.fst f.left (i_A ≫ g_A)
  let f_k := CategoryTheory.Limits.pullback.snd f.left (i_A ≫ g_A)
  apply weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective ℓ ι_k ?_ r q p_k hp_k
  clear r q p_k hp_k
  intro q p₁ hp₁
  obtain ⟨hc_all, hr_all, hEx_all, hConstIndep, hConstIso, -⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  have sys : WeilEtaleSitePullbackSys.{u} := fun {Z₁ Z₂} h =>
    { hCont := hc_all h
      hAdj := hr_all h
      hAdd_pb := (hEx_all h).1
      hAdd_pf := (hEx_all h).2.1
      hLim_pb := (hEx_all h).2.2.1
      hColim_pb := (hEx_all h).2.2.2
      hConstIso := fun {_} hT₁ {_} hT₂ M => hConstIso h hT₁ hT₂ M }
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    fun h => (sys h).hCont
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint :=
    fun h => (sys h).hAdj
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive :=
    fun h => (sys h).hAdd_pb
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
    fun h => (sys h).hLim_pb
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
    fun h => (sys h).hColim_pb
  
  have hStep8 :
      IsSepClosed (IsLocalRing.ResidueField A) ∧
      ∀ (W : S_A.Etale)
        (τ₀ : S_k ⟶ ((AlgebraicGeometry.Scheme.Etale.forget S_A).obj W).left),
        τ₀ ≫ ((AlgebraicGeometry.Scheme.Etale.forget S_A).obj W).hom = i_A →
        ∃ (σ₀ : S_A ⟶ ((AlgebraicGeometry.Scheme.Etale.forget S_A).obj W).left),
          σ₀ ≫ ((AlgebraicGeometry.Scheme.Etale.forget S_A).obj W).hom = 𝟙 S_A ∧
          i_A ≫ σ₀ = τ₀ := by
    refine ⟨?_, ?_⟩
    · let res_A : A →+* IsLocalRing.ResidueField A := IsLocalRing.residue A
      let α : k →+* IsLocalRing.ResidueField A := res_A.comp c_A
      have hSurj_α : Function.Surjective α := by
        intro q_res
        obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective q_res
        refine ⟨π_A a, ?_⟩
        have hker_diff : c_A (π_A a) - a ∈ IsLocalRing.maximalIdeal A := by
          rw [← hπ_ker, RingHom.mem_ker, map_sub]
          have h1 : π_A (c_A (π_A a)) = π_A a := RingHom.congr_fun hπ_c (π_A a)
          rw [h1, sub_self]
        have hres_diff : res_A (c_A (π_A a) - a) = 0 := by
          rwa [← RingHom.mem_ker, IsLocalRing.ker_residue]
        rw [map_sub, sub_eq_zero] at hres_diff
        exact hres_diff
      let e_κ : k ≃+* IsLocalRing.ResidueField A :=
        RingEquiv.ofBijective α ⟨RingHom.injective α, hSurj_α⟩
      refine ⟨fun p hp => ?_⟩
      have hp' : (p.map e_κ.symm.toRingHom).Separable := hp.map
      have hsp' : (p.map e_κ.symm.toRingHom).Splits :=
        IsSepClosed.splits_of_separable (p.map e_κ.symm.toRingHom) hp'
      have hmap : (p.map e_κ.symm.toRingHom).map e_κ.toRingHom = p := by
        rw [Polynomial.map_map, RingEquiv.toRingHom_comp_symm_toRingHom, Polynomial.map_id]
      rw [← hmap]
      exact hsp'.map e_κ.toRingHom
    · intro W τ₀ hτ₀_hom
      let Fgt_A := AlgebraicGeometry.Scheme.Etale.forget S_A
      let W₀ := (Fgt_A.obj W).left
      let w : W₀ ⟶ S_A := (Fgt_A.obj W).hom
      have : AlgebraicGeometry.Etale w := W.prop
      let pt_k : ↥S_k := (⊥ : PrimeSpectrum k)
      have hSub_k : Subsingleton ↥S_k := by
        change Subsingleton (PrimeSpectrum k)
        infer_instance
      obtain ⟨U, hU, hpt_U, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (X := W₀) (x := τ₀.base pt_k) (U := (⊤ : W₀.Opens)) trivial
      have hr_τ : Set.range τ₀.base ⊆ Set.range hU.fromSpec.base := by
        rw [hU.range_fromSpec]
        rintro _ ⟨z, rfl⟩
        rw [hSub_k.elim z pt_k]
        exact hpt_U
      let B : Type u := ↑(W₀.presheaf.obj (Opposite.op U))
      let τ_U : S_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
        AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec τ₀ hr_τ
      have hfac_τ : τ_U ≫ hU.fromSpec = τ₀ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec τ₀ hr_τ
      let w_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ S_A := hU.fromSpec ≫ w
      have hw_B_et : AlgebraicGeometry.Etale w_B := inferInstance
      let f_AB : A →+* B := (AlgebraicGeometry.Spec.preimage w_B).hom
      have hf_AB_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_AB) = w_B :=
        AlgebraicGeometry.Spec.map_preimage w_B
      letI : Algebra A B := f_AB.toAlgebra
      have : Algebra.Etale A B := by
        rw [← RingHom.etale_algebraMap]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hf_AB_map.symm ▸ hw_B_et)
      let φ : B →+* k := (AlgebraicGeometry.Spec.preimage τ_U).hom
      have hφ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = τ_U :=
        AlgebraicGeometry.Spec.map_preimage τ_U
      have hφ_comp : φ.comp (algebraMap A B) = π_A := by
        have hspec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp f_AB)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hφ_map, hf_AB_map]
          change τ_U ≫ (hU.fromSpec ≫ w) = i_A
          rw [← CategoryTheory.Category.assoc, hfac_τ]
          exact hτ₀_hom
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hspec)
      let Q : Ideal B := RingHom.ker φ
      have : Q.IsPrime := RingHom.ker_isPrime φ
