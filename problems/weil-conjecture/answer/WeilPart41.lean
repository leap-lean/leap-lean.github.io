      change j_inf.base q ≠ j_inf.base q₀ ↔ (Polynomial.X : Polynomial k) ∉ q.asIdeal
      rw [← hq_eq_q₀]
      exact ⟨fun hne hq => hne (congrArg j_inf.base hq),
        fun hne hjeq => hne (j_inf.isOpenEmbedding.injective hjeq)⟩
    refine ⟨hj_inf_pre, ?_⟩
    intro τ hτ_C h_eq_ov
    let p_X := (weilProjectiveSpaceOver k 1).hom
    let ι_T_sch := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))))
    let f₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ) ≫ j_aff_k
    let f₂ := j_inf
