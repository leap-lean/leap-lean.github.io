theorem weil_odp_coker_quadric_cone_vs_smooth_cohomology (m ℓ r : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (k : Type u) [Field k] [IsAlgClosed k] (_ : (ℓ : k) ≠ 0)
        (Q_succ Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Q_succ.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_succ.hom]
        [AlgebraicGeometry.IsProper Z_cone.hom]
        (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver k (2 * (m + 1) + 1)).left)
        (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver k (2 * (m + 1) + 1)).hom = Q_succ.hom)
        (i_Z : Z_cone ⟶ Q_succ),
      let F_amb_k : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) k :=
        ∑ j ∈ Finset.range (m + 1 + 1),
          if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) k) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0
      IsHomogeneousHypersurfacePullbackOver k (2 * (m + 1) + 1) 2
        (𝟙 (weilProjectiveSpaceOver k (2 * (m + 1) + 1))) F_amb_k ι_succ →
      IsHomogeneousHypersurfacePullbackOver k (2 * (m + 1) + 1) 1
        (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) i_Z.left →
      (∀ c : ℕ, 2 * c + 1 ≤ 2 * m + 1 →
        Subsingleton (weilEtaleTorsionH Z_cone.left (ℓ ^ (r + 1)) (2 * c + 1))) ∧
      (∀ c : ℕ, c ≤ m →
        Finite (weilEtaleTorsionH Z_cone.left (ℓ ^ (r + 1)) (2 * c)) ∧
        Nat.card (weilEtaleTorsionH Z_cone.left (ℓ ^ (r + 1)) (2 * c)) = ℓ ^ (r + 1)) ∧
      (∃ Φ_2 : weilEtaleTorsionH Z_cone.left (ℓ ^ (r + 1)) (2 * m + 2) →+
          ZMod (ℓ ^ (r + 1)) × ZMod (ℓ ^ (r + 1)),
        Function.Injective Φ_2)) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (_ : (ℓ : Ω) ≠ 0)
        (c_0 : Ω) (_ : c_0 ≠ 0)
        (Q_amb Q_sm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Q_amb.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_amb.hom]
        [AlgebraicGeometry.IsProper Q_sm.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Q_sm.hom]
        (ι_amb : Q_amb.left ⟶ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left)
        (hι_amb : ι_amb ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb.hom)
        (i_sm : Q_sm ⟶ Q_amb),
      let F_amb_Ω : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω :=
        ∑ j ∈ Finset.range (m + 1 + 1),
          if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0
      IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 2
        (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))) F_amb_Ω ι_amb →
      IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 1
        (CategoryTheory.Over.homMk ι_amb hι_amb)
        (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1) i_sm.left →
      (∀ c : ℕ, 2 * c + 1 ≤ 2 * m + 1 →
        Subsingleton (weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * c + 1))) ∧
      (∀ c : ℕ, c ≤ m →
        Finite (weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * c)) ∧
        Nat.card (weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * c)) = ℓ ^ (r + 1) ∧
        ∀ p_sm : weilEtaleTorsionH Q_amb.left (ℓ ^ (r + 1)) (2 * c) →+
            weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * c),
          WeilIsTorsionEtalePullback i_sm.left (ℓ ^ (r + 1)) (2 * c) p_sm →
          Function.Surjective p_sm) ∧
      (Nonempty (weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * m + 2) ≃+
          ZMod (ℓ ^ (r + 1))) ∧
        ∀ p_top : weilEtaleTorsionH Q_amb.left (ℓ ^ (r + 1)) (2 * m + 2) →+
            weilEtaleTorsionH Q_sm.left (ℓ ^ (r + 1)) (2 * m + 2),
          WeilIsTorsionEtalePullback i_sm.left (ℓ ^ (r + 1)) (2 * m + 2) p_top →
          Function.Surjective p_top)) :=
by
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
