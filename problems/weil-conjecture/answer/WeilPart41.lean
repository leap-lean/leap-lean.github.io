          MvPolynomial.X ⟨2 * j₀.1 + 2, by omega⟩)) = Polynomial.X := by
      have hpar : a.1 = 2 * j₀.1 ∨ a.1 = 2 * j₀.1 + 1 := by
        dsimp only [j₀]
