          rw [← CategoryTheory.cancel_mono (W_tilde b).ι]
          have hlhs_eq :
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
                i₀_loc.inv ≫ U₀.ι) ≫ (W_tilde b).ι =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap (Polynomial (R_b b)) L_R)) ≫
                (j_0 b).inv ≫ (U_chart0 b).ι := by
            have hSpec_alg : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap (Polynomial (R_b b)) L_R)) =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) L_K)) ≫
                  Spec_P.inv := by
