            (weilAffineSpaceOver Ω 1).hom)
          b
          (weilEtaleTorsionSheaf
            (CategoryTheory.Limits.pullback (weilAffineSpaceOver Ω δ).hom
              (weilAffineSpaceOver Ω 1).hom) ℓ)))
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsAffine Y.left]
    [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
    (U Z : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine U]
    (j : U ⟶ Y.left) [AlgebraicGeometry.IsOpenImmersion j]
    (i : Z ⟶ Y.left) [AlgebraicGeometry.IsClosedImmersion i]
    (hCompl : Set.range i.base = (Set.range j.base)ᶜ)
    (δ M : ℕ)
    (μ : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (Localization.Away (Polynomial.X : Polynomial Ω))))
    (W : Fin M → Y.left.Opens)
    (ϕ : ∀ α : Fin M, (W α).toScheme ⟶
      CategoryTheory.Limits.pullback (weilAffineSpaceOver Ω δ).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))))
    [∀ α : Fin M, AlgebraicGeometry.Etale (ϕ α)]
    (g : ∀ α : Fin M, CategoryTheory.Limits.pullback j (W α).ι ⟶
      CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω)))))
        (CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver Ω δ).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω)))))
    [∀ α : Fin M, AlgebraicGeometry.Etale (g α)]
    (hAffW : ∀ α : Fin M, AlgebraicGeometry.IsAffineOpen (W α))
    (hSupW : (⨆ α : Fin M, W α) = ⊤)
    (hϕ_hom : ∀ α : Fin M,
      ϕ α ≫ CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver Ω δ).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))) ≫
        (weilAffineSpaceOver Ω δ).hom = (W α).ι ≫ Y.hom)
    (hPb : ∀ α : Fin M,
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd j (W α).ι) (g α) (ϕ α)
        (CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω)))))
          (CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver Ω δ).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω))))))
    (hμ_comm : ∀ α : Fin M,
      g α ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial Ω) (Localization.Away (Polynomial.X : Polynomial Ω)))))
          (CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver Ω δ).hom
