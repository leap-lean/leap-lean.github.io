          (hex_mid_S.map pb_η) (hex_left_S.map pb_η) hex_mid_S' hex_left_S'
          (bcTor ℓ 0) (bcTor (ℓ ^ (s₀ + 1)) 0) (bcTor (ℓ ^ s₀) 0) (bcTor ℓ 1)
