    have hEtaleDerEquiv : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra k A] [Algebra k S]
        (ψ : A →+* S),
        ψ.comp (algebraMap k A) = algebraMap k S →
        ψ.Etale →
        ∀ [Algebra S k] [IsScalarTower k S k] [Algebra A k] [IsScalarTower k A k],
        (algebraMap S k).comp ψ = algebraMap A k →
        ∃ e : _root_.Derivation k S k ≃ₗ[k] _root_.Derivation k A k,
          ∀ (D : _root_.Derivation k S k) (a : A), e D a = D (ψ a) := by
      intro A S _ _ _ _ ψ hψ_alg hψ_et _ _ _ _ hε_alg
      letI : Algebra A S := ψ.toAlgebra
      haveI : IsScalarTower k A S := ⟨fun c a s => by
        rw [Algebra.smul_def (c • a) s, Algebra.smul_def c a,
          Algebra.smul_def a s, Algebra.smul_def c _, map_mul, mul_assoc]
        exact congrArg (· * (algebraMap A S a * s)) (RingHom.congr_fun hψ_alg c)⟩
      haveI : IsScalarTower A S k := ⟨fun a s x => by
        rw [Algebra.smul_def (a • s) x, Algebra.smul_def a s,
          Algebra.smul_def s x, Algebra.smul_def a _, map_mul, mul_assoc]
        exact congrArg (· * (algebraMap S k s * x)) (RingHom.congr_fun hε_alg a)⟩
      haveI : Algebra.Etale A S := RingHom.etale_algebraMap.mp hψ_et
      let e_K : TensorProduct A S Ω[A⁄k] ≃ₗ[S] Ω[S⁄k] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k A S
      let e₁ : _root_.Derivation k S k ≃ₗ[k] (Ω[S⁄k] →ₗ[S] k) :=
        (KaehlerDifferential.linearMapEquivDerivation k S).symm.restrictScalars k
      let e₂ : (Ω[S⁄k] →ₗ[S] k) ≃ₗ[k] (TensorProduct A S Ω[A⁄k] →ₗ[S] k) :=
        { toFun := fun f => f.comp e_K.toLinearMap
          invFun := fun g => g.comp e_K.symm.toLinearMap
          left_inv := fun f => LinearMap.ext fun x => by simp
          right_inv := fun g => LinearMap.ext fun x => by simp
          map_add' := fun f₁ f₂ => LinearMap.ext fun x => rfl
          map_smul' := fun c f => LinearMap.ext fun x => rfl }
      let e₃ : (TensorProduct A S Ω[A⁄k] →ₗ[S] k) ≃ₗ[k] (Ω[A⁄k] →ₗ[A] k) :=
        (LinearMap.liftBaseChangeEquiv S).symm.restrictScalars k
      let e₄ : (Ω[A⁄k] →ₗ[A] k) ≃ₗ[k] _root_.Derivation k A k :=
        (KaehlerDifferential.linearMapEquivDerivation k A).restrictScalars k
      refine ⟨e₁.trans (e₂.trans (e₃.trans e₄)), fun D a => ?_⟩
      have hK_a : e_K (1 ⊗ₜ[A] KaehlerDifferential.D k A a) = KaehlerDifferential.D k S (ψ a) := by
        apply e_K.symm.injective
        rw [e_K.symm_apply_apply]
        exact (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap k A S a).symm
      change (LinearMap.liftBaseChangeEquiv S).symm
          (((KaehlerDifferential.linearMapEquivDerivation k S).symm D).comp e_K.toLinearMap)
          (KaehlerDifferential.D k A a) = D (ψ a)
      have h_lbc : ∀ (g : TensorProduct A S Ω[A⁄k] →ₗ[S] k) (ω : Ω[A⁄k]),
          (LinearMap.liftBaseChangeEquiv S).symm g ω = g (1 ⊗ₜ[A] ω) := by
        intro g ω
        simp
      rw [h_lbc]
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, hK_a,
        KaehlerDifferential.linearMapEquivDerivation_symm_apply]
      exact DFunLike.congr_fun (_root_.Derivation.liftKaehlerDifferential_comp D) (ψ a)
    
    let TanSpace : ∀ (B : Type u) [CommRing B] (ε_B : B →+* k),
        Submodule k ({ x : B // ε_B x = 0 } → k) :=
      fun B _ ε_B =>
        { carrier := { φ |
            (∀ x y : { x : B // ε_B x = 0 },
              φ ⟨x.1 + y.1, by rw [map_add, x.2, y.2, add_zero]⟩ = φ x + φ y) ∧
            (∀ (b : B) (x : { x : B // ε_B x = 0 }),
              φ ⟨b * x.1, by rw [map_mul, x.2, mul_zero]⟩ = ε_B b * φ x) }
          zero_mem' := ⟨fun _ _ => by simp, fun _ _ => by simp⟩
          add_mem' := fun {φ₁ φ₂} h₁ h₂ =>
            ⟨fun x y => by simp only [Pi.add_apply, h₁.1 x y, h₂.1 x y]; ring,
             fun b x => by simp only [Pi.add_apply, h₁.2 b x, h₂.2 b x]; ring⟩
          smul_mem' := fun c {φ} h =>
            ⟨fun x y => by simp only [Pi.smul_apply, smul_eq_mul, h.1 x y]; ring,
             fun b x => by simp only [Pi.smul_apply, smul_eq_mul, h.2 b x]; ring⟩ }
    have hDerEquivTan : ∀ (B : Type u) [CommRing B] (ε_B : B →+* k) [Algebra B k],
        algebraMap B k = ε_B →
        ∀ (ι : k →+* B),
          ε_B.comp ι = RingHom.id k →
          letI : Algebra k B := ι.toAlgebra
          Nonempty (_root_.Derivation k B k ≃ₗ[k] ↥(TanSpace B ε_B)) := by
      intro B _ ε_B _ hAlgB ι hι_sec
      letI : Algebra k B := ι.toAlgebra
      have hι_app : ∀ c : k, ε_B (ι c) = c := fun c => RingHom.congr_fun hι_sec c
      have hsmul_B : ∀ (b : B) (c : k), b • c = ε_B b * c := by
        intro b c
        rw [Algebra.smul_def, hAlgB]
      haveI : IsScalarTower k B k := ⟨fun c b x => by
        rw [hsmul_B, hsmul_B, Algebra.smul_def]
        change ε_B (ι c * b) * x = c * (ε_B b * x)
        rw [map_mul, hι_app c, mul_assoc]⟩
      let toTan : _root_.Derivation k B k →ₗ[k] ↥(TanSpace B ε_B) :=
        { toFun := fun D => ⟨fun x => D x.1,
            ⟨fun x y => D.map_add x.1 y.1,
             fun b x => by
               dsimp only
               rw [D.leibniz b x.1, hsmul_B, hsmul_B, x.2, zero_mul, add_zero]⟩⟩
          map_add' := fun D₁ D₂ => Subtype.ext (funext fun x => rfl)
          map_smul' := fun c D => Subtype.ext (funext fun x => rfl) }
      let fromTan : ↥(TanSpace B ε_B) → _root_.Derivation k B k := fun φ =>
        { toFun := fun b => φ.1 ⟨b - ι (ε_B b), by rw [map_sub, hι_app, sub_self]⟩
          map_add' := fun b₁ b₂ => by
            have hsub : (⟨b₁ + b₂ - ι (ε_B (b₁ + b₂)),
                by rw [map_sub, hι_app, sub_self]⟩ : { x : B // ε_B x = 0 }) =
              ⟨(b₁ - ι (ε_B b₁)) + (b₂ - ι (ε_B b₂)),
                by rw [map_add, map_sub, map_sub, hι_app, hι_app, sub_self, sub_self, add_zero]⟩ := by
              apply Subtype.ext
              simp only [map_add]
              ring
            rw [hsub]
            exact φ.2.1 ⟨b₁ - ι (ε_B b₁), by rw [map_sub, hι_app, sub_self]⟩
              ⟨b₂ - ι (ε_B b₂), by rw [map_sub, hι_app, sub_self]⟩
          map_smul' := fun c b => by
            dsimp only [RingHom.id_apply]
            have hcb : (⟨c • b - ι (ε_B (c • b)),
                by rw [map_sub, hι_app, sub_self]⟩ : { x : B // ε_B x = 0 }) =
              ⟨ι c * (b - ι (ε_B b)),
                by rw [map_mul, map_sub, hι_app (ε_B b), sub_self, mul_zero]⟩ := by
              apply Subtype.ext
              change ι c * b - ι (ε_B (ι c * b)) = ι c * (b - ι (ε_B b))
              rw [map_mul, hι_app c, map_mul]
              ring
            rw [hcb, φ.2.2 (ι c) ⟨b - ι (ε_B b), by rw [map_sub, hι_app (ε_B b), sub_self]⟩,
              hι_app c]
            rfl
          map_one_eq_zero' := by
            change φ.1 ⟨(1 : B) - ι (ε_B 1), by rw [map_sub, hι_app, sub_self]⟩ = 0
            have h0 : (⟨(1 : B) - ι (ε_B 1),
                by rw [map_sub, hι_app, sub_self]⟩ : { x : B // ε_B x = 0 }) =
              ⟨(0 : B) * (0 : B), by simp⟩ := by
              apply Subtype.ext
              simp
            rw [h0, φ.2.2 0 ⟨0, map_zero ε_B⟩, map_zero, zero_mul]
          leibniz' := fun b₁ b₂ => by
            let x₁ : { x : B // ε_B x = 0 } := ⟨b₁ - ι (ε_B b₁), by rw [map_sub, hι_app, sub_self]⟩
            let x₂ : { x : B // ε_B x = 0 } := ⟨b₂ - ι (ε_B b₂), by rw [map_sub, hι_app, sub_self]⟩
            change φ.1 ⟨b₁ * b₂ - ι (ε_B (b₁ * b₂)), by rw [map_sub, hι_app, sub_self]⟩ =
              b₁ • φ.1 x₂ + b₂ • φ.1 x₁
            have hprod : (⟨b₁ * b₂ - ι (ε_B (b₁ * b₂)),
                by rw [map_sub, hι_app, sub_self]⟩ : { x : B // ε_B x = 0 }) =
              ⟨b₁ * x₂.1 + ι (ε_B b₂) * x₁.1,
                by rw [map_add, map_mul, map_mul, x₁.2, x₂.2, mul_zero, mul_zero, add_zero]⟩ := by
              apply Subtype.ext
              dsimp only [x₁, x₂]
              rw [map_mul, map_mul]
              ring
            rw [hprod,
              φ.2.1 ⟨b₁ * x₂.1, by rw [map_mul, x₂.2, mul_zero]⟩
                ⟨ι (ε_B b₂) * x₁.1, by rw [map_mul, x₁.2, mul_zero]⟩,
              φ.2.2 b₁ x₂, φ.2.2 (ι (ε_B b₂)) x₁, hι_app (ε_B b₂), hsmul_B, hsmul_B] }
      refine ⟨{ toTan with
        invFun := fromTan
        left_inv := fun D => _root_.Derivation.ext fun b => by
          change D (b - algebraMap k B (ε_B b)) = D b
          rw [map_sub, D.map_algebraMap, sub_zero]
        right_inv := fun φ => Subtype.ext (funext fun x => by
          have hx_eq : (⟨x.1 - ι (ε_B x.1), by rw [map_sub, hι_app, sub_self]⟩ :
              { x : B // ε_B x = 0 }) = x := by
            apply Subtype.ext
            dsimp only
            rw [x.2, map_zero, sub_zero]
          exact congrArg φ.1 hx_eq) }⟩
    
