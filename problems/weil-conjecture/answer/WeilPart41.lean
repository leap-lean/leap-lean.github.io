          CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          he₀_ι, ← CategoryTheory.Category.assoc, he₁_ι,
          AlgebraicGeometry.Proj.awayι_comp_map g hg_irr zero_lt_one (MvPolynomial.X a) hXa₀]
      · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          ← CategoryTheory.Category.assoc, he₁_ι, hAway_p₁ a hXa₁]
      · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          ← CategoryTheory.Category.assoc, he₀_ι, hAway_p₀ a hXa₀]
      · simp
    let p₁ := CategoryTheory.Limits.pullback.fst p₀_hom s
    let p₂ := CategoryTheory.Limits.pullback.snd p₀_hom s
    let Φ : AlgebraicGeometry.Proj 𝒜₁ ⟶ CategoryTheory.Limits.pullback p₀_hom s :=
