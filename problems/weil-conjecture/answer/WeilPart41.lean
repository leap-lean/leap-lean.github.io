    (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hs_sec : s ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (x_s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z_tilde.left)
    (hx_s : x_s ≫ f₀.left = s)
    (hSm_away : ∀ z : Z_tilde.left,
      f₀.left.base z ∈ Set.range s.base → z ∉ Set.range x_s.base →
      ∃ V : Z_tilde.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f₀.left))
    (hOdp_s : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
      IsEtaleSplitOdpPointOver m f₀ (x_s.base pt) (s.base pt))
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (hSpec2 : ∀ q : Ideal R_bar, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal R_bar)
    (p_R : Polynomial (AlgebraicClosure F) →+* R_bar)
    (π_cl : R_bar →+* AlgebraicClosure F)
    (hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar)
    (hπ_pR : π_cl.comp p_R = Polynomial.evalRingHom 0)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F))))
    (hφ_inj : Function.Injective φ_R_Ω)
    (hφ_pR : φ_R_Ω.comp p_R =
      algebraMap (Polynomial (AlgebraicClosure F))
        (AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F)))))
    (hLiftTrait : ∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S)
        [AlgebraicGeometry.Etale w₀]
        (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
        (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ W₀),
      s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
      ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
        g_tilde ≫ w₀ = g_S ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde)
    (g_s : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hg_hom : g_s ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (p_R.comp (Polynomial.C.comp (algebraMap F (AlgebraicClosure F))))))
    (hg_cl : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_s =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) ≫ s)
    (hg_range : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s).base ⊆
      (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (hg_gen : ∃ ψ_gen : Polynomial F →+*
        AlgebraicClosure (FractionRing (Polynomial (AlgebraicClosure F))),
      Function.Injective ψ_gen ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_gen) ≫ j_aff) :
    let k := AlgebraicClosure F
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    let η_D := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) ≫ g_s
    let Z_R := CategoryTheory.Limits.pullback f₀.left g_s
    let Z_Ω := CategoryTheory.Limits.pullback f₀.left η_D
    let S_d := weilAffineSpaceOver k (2 * m + 1)
    let g_k_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let A_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let j_A : A_Ω ⟶ A_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    ∃ (h_R : R_bar)
      (x_bar_R : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_R)
      (U_Z : Z_R.Opens)
      (j_Z_open : Z_Ω ⟶ U_Z.toScheme)
      (zero_M : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        weilOdpModelSpec m (CommRingCat.of R_bar) h_R)
      (W_R : AlgebraicGeometry.Scheme.{u})
      (v_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_R)
      (e_W : W_R ⟶ Z_R)
      (q_M : W_R ⟶ weilOdpModelSpec m (CommRingCat.of R_bar) h_R),
      (h_R ∈ IsLocalRing.maximalIdeal R_bar ∧ h_R ≠ 0) ∧
      (AlgebraicGeometry.IsClosedImmersion x_bar_R ∧
        (U_Z : Set Z_R) = (Set.range x_bar_R.base)ᶜ ∧
        (j_Z_open ≫ U_Z.ι) ≫ CategoryTheory.Limits.pullback.fst f₀.left g_s =
          CategoryTheory.Limits.pullback.fst f₀.left η_D ∧
        (j_Z_open ≫ U_Z.ι) ≫ CategoryTheory.Limits.pullback.snd f₀.left g_s =
          CategoryTheory.Limits.pullback.snd f₀.left η_D ≫ j_R) ∧
      (∀ x : ↥U_Z.toScheme,
        ∃ (V : U_Z.toScheme.Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Z_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_Z_open V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A φ) ∧
      (AlgebraicGeometry.Etale e_W ∧
        AlgebraicGeometry.Etale q_M ∧
        v_W ≫ e_W = x_bar_R ∧
        v_W ≫ q_M = zero_M ∧
        (∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of k)) (idx : Fin (m + 1) × Fin 2),
          Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (zero_M.base pt).asIdeal) ∧
        zero_M ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ∧
        e_W.base ⁻¹' (Set.range x_bar_R.base) = Set.range v_W.base ∧
        q_M.base ⁻¹' (Set.range zero_M.base) = Set.range v_W.base) :=
by
  intro k P Ω η_D Z_R Z_Ω S_d g_k_R j_R A_R A_Ω j_A
  let _ := hg_hom
  
  have hFieldPt : ∀ {K : Type u} [Field K] (pt : PrimeSpectrum K),
      pt = ⟨⊥, inferInstance⟩ := by
    intro K _ pt
    apply PrimeSpectrum.ext
    ext x
    change x ∈ pt.asIdeal ↔ x = 0
    constructor
    · intro hx
      by_contra hne
      have h1 : (1 : K) ∈ pt.asIdeal := by
        rw [← mul_inv_cancel₀ hne]
        exact pt.asIdeal.mul_mem_right x⁻¹ hx
      exact pt.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
    · rintro rfl
      exact pt.asIdeal.zero_mem
  have hSpecPush : ∀ {A B C P_r : CommRingCat.{u}} (f : A ⟶ B) (g : A ⟶ C)
      (inl : B ⟶ P_r) (inr : C ⟶ P_r),
      CategoryTheory.IsPushout f g inl inr →
      CategoryTheory.IsPullback (Spec.map inl) (Spec.map inr) (Spec.map f) (Spec.map g) := by
    intro A B C P_r f g inl inr h
    have h0 := AlgebraicGeometry.isPullback_SpecMap_pushout f g
    let e_iso : Spec P_r ≅ Spec (Limits.pushout f g) :=
      { hom := Spec.map h.isoPushout.inv
        inv := Spec.map h.isoPushout.hom
        hom_inv_id := by rw [← Spec.map_comp, h.isoPushout.hom_inv_id, Spec.map_id]
        inv_hom_id := by rw [← Spec.map_comp, h.isoPushout.inv_hom_id, Spec.map_id] }
    refine h0.of_iso e_iso.symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ (by simp) (by simp)
    · dsimp [e_iso]
      rw [Category.comp_id, ← Spec.map_comp, IsPushout.inl_isoPushout_hom]
    · dsimp [e_iso]
      rw [Category.comp_id, ← Spec.map_comp, IsPushout.inr_isoPushout_hom]

  
  let pt_F : PrimeSpectrum F := ⟨⊥, inferInstance⟩
  let pt_k : PrimeSpectrum k := ⟨⊥, inferInstance⟩
  let pt_Ω : PrimeSpectrum Ω := ⟨⊥, inferInstance⟩
  have hπ_surj : Function.Surjective π_cl := by
    intro c
    refine ⟨p_R (Polynomial.C c), ?_⟩
    have hc := congrArg (fun f => f (Polynomial.C c)) hπ_pR
    simpa using hc
  let i_cl : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of R_bar) :=
    Spec.map (CommRingCat.ofHom π_cl)
  have _ : IsClosedImmersion i_cl := IsClosedImmersion.spec_of_surjective _ hπ_surj
  let g_Fk : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of F) :=
    Spec.map (CommRingCat.ofHom (algebraMap F k))
  let fst_R : Z_R ⟶ Z_tilde.left := Limits.pullback.fst f₀.left g_s
  let snd_R : Z_R ⟶ Spec (CommRingCat.of R_bar) := Limits.pullback.snd f₀.left g_s
  let x_bar_R : Spec (CommRingCat.of k) ⟶ Z_R :=
    Limits.pullback.lift (g_Fk ≫ x_s) i_cl (by rw [Category.assoc, hx_s, hg_cl])
  have hx_fst : x_bar_R ≫ fst_R = g_Fk ≫ x_s := Limits.pullback.lift_fst _ _ _
  have hx_snd : x_bar_R ≫ snd_R = i_cl := Limits.pullback.lift_snd _ _ _
  have hx_Z_cl : IsClosedImmersion x_bar_R := by
    have _ : IsClosedImmersion (x_bar_R ≫ snd_R) := by rw [hx_snd]; infer_instance
    exact IsClosedImmersion.of_comp x_bar_R snd_R
  let U_Z : Z_R.Opens := ⟨(Set.range x_bar_R.base)ᶜ, x_bar_R.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let fst_η : Z_Ω ⟶ Z_tilde.left := Limits.pullback.fst f₀.left η_D
  let snd_η : Z_Ω ⟶ Spec (CommRingCat.of Ω) := Limits.pullback.snd f₀.left η_D
  let ι_Z_Ω : Z_Ω ⟶ Z_R :=
    Limits.pullback.lift fst_η (snd_η ≫ j_R) (by rw [Category.assoc]; exact Limits.pullback.condition)
  have hPb_ιZ : CategoryTheory.IsPullback ι_Z_Ω snd_η snd_R j_R := by
    have hBot : CategoryTheory.IsPullback snd_η ι_Z_Ω j_R snd_R := by
      refine CategoryTheory.IsPullback.of_bot ?_ (Limits.pullback.lift_snd _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback f₀.left g_s).flip
      rw [Limits.pullback.lift_fst]
      exact (CategoryTheory.IsPullback.of_hasPullback f₀.left η_D).flip
    exact hBot.flip
  have hRange_ιZ : Set.range ι_Z_Ω.base ⊆ Set.range U_Z.ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    change ι_Z_Ω.base z ∉ Set.range x_bar_R.base
    rintro ⟨pt, h_eq⟩
    have hsnd_eq : (x_bar_R ≫ snd_R).base pt = (ι_Z_Ω ≫ snd_R).base z :=
      congrArg snd_R.base h_eq
    rw [hx_snd, Limits.pullback.lift_snd] at hsnd_eq
    let t_0 : R_bar := p_R Polynomial.X
    have ht_cl : t_0 ∈ (i_cl.base pt).asIdeal := by
      rw [hFieldPt pt]
      change π_cl (p_R Polynomial.X) = 0
      have hX := congrArg (fun f => f Polynomial.X) hπ_pR
      simpa using hX
    rw [hsnd_eq] at ht_cl
    have ht_Ω : φ_R_Ω t_0 = 0 := by
      have hq : snd_η.base z = pt_Ω := hFieldPt (snd_η.base z)
      change t_0 ∈ (j_R.base (snd_η.base z)).asIdeal at ht_cl
      rw [hq] at ht_cl
      exact ht_cl
    have hX_map : φ_R_Ω t_0 = algebraMap P Ω Polynomial.X :=
      congrArg (fun f => f Polynomial.X) hφ_pR
    rw [ht_Ω] at hX_map
    have hX_tow : algebraMap P Ω Polynomial.X =
        algebraMap (FractionRing P) Ω (algebraMap P (FractionRing P) Polynomial.X) :=
      IsScalarTower.algebraMap_apply P (FractionRing P) Ω Polynomial.X
    rw [hX_tow] at hX_map
    have hX_frac : algebraMap P (FractionRing P) Polynomial.X = 0 :=
      (RingHom.injective (algebraMap (FractionRing P) Ω)) (hX_map.symm.trans (map_zero _).symm)
    have hX_zero : (Polynomial.X : P) = 0 :=
      (IsFractionRing.injective P (FractionRing P)) (hX_frac.trans (map_zero _).symm)
    exact Polynomial.X_ne_zero hX_zero
  let j_Z_open : Z_Ω ⟶ U_Z.toScheme := IsOpenImmersion.lift U_Z.ι ι_Z_Ω hRange_ιZ
  have hj_Z_fac : j_Z_open ≫ U_Z.ι = ι_Z_Ω := IsOpenImmersion.lift_fac U_Z.ι ι_Z_Ω hRange_ιZ
  let π_UZ : U_Z.toScheme ⟶ Spec (CommRingCat.of R_bar) := U_Z.ι ≫ snd_R
  have hPb_jZ : CategoryTheory.IsPullback j_Z_open snd_η π_UZ j_R := by
    have hcomm_jZ : j_Z_open ≫ π_UZ = snd_η ≫ j_R := by
      dsimp [π_UZ]
      rw [← Category.assoc, hj_Z_fac]
      exact hPb_ιZ.w
    refine CategoryTheory.IsPullback.of_isLimit
      (Limits.PullbackCone.IsLimit.mk hcomm_jZ
        (fun c => hPb_ιZ.lift (c.fst ≫ U_Z.ι) c.snd (by rw [Category.assoc]; exact c.condition))
        (fun c => ?_) (fun c => hPb_ιZ.lift_snd _ _ _) (fun c m hm1 hm2 => ?_))
    · rw [← cancel_mono U_Z.ι, Category.assoc, hj_Z_fac]
      exact hPb_ιZ.lift_fst _ _ _
    · refine hPb_ιZ.hom_ext ?_ (hm2.trans (hPb_ιZ.lift_snd _ _ _).symm)
      rw [hPb_ιZ.lift_fst, ← hj_Z_fac, ← Category.assoc, hm1]

  
  have hSm_UZ : ∀ x : ↥U_Z.toScheme, ∃ W : U_Z.toScheme.Opens,
      x ∈ W ∧ AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W.ι ≫ π_UZ) := by
    let D₀ := weilProjectiveSpaceOver F 1
    have _ : IsSeparated D₀.hom := by
      dsimp [D₀, weilProjectiveSpaceOver]
      infer_instance
    have _ : IsClosedImmersion (s ≫ D₀.hom) := by
      rw [hs_sec]
      infer_instance
    have _ : IsClosedImmersion s := IsClosedImmersion.of_comp s D₀.hom
    have hPb_xs : CategoryTheory.IsPullback (Limits.pullback.fst fst_R x_s ≫ snd_R)
        (Limits.pullback.snd fst_R x_s) g_s s := by
      have hPaste := (CategoryTheory.IsPullback.of_hasPullback fst_R x_s).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f₀.left g_s).flip
      rwa [hx_s] at hPaste
    have _ : IsClosedImmersion (Limits.pullback.fst fst_R x_s ≫ snd_R) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_xs.flip inferInstance
    intro x
    let z_R : ↥Z_R := U_Z.ι.base x
    have hz_notin : z_R ∉ Set.range x_bar_R.base := x.2
    let q_R : PrimeSpectrum R_bar := snd_R.base z_R
    have hW₀_ex : ∃ W₀ : Z_tilde.left.Opens, fst_R.base z_R ∈ W₀ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W₀.ι ≫ f₀.left) := by
      rcases hSpec2 q_R.asIdeal q_R.isPrime with hq_bot | hq_max
      · have hq_eq : q_R = j_R.base pt_Ω := by
          apply PrimeSpectrum.ext
          rw [hq_bot]
          ext r
          change r ∈ (⊥ : Ideal R_bar) ↔ φ_R_Ω r = 0
          rw [Ideal.mem_bot, map_eq_zero_iff φ_R_Ω hφ_inj]
        have hf_in_U₀ : f₀.left.base (fst_R.base z_R) ∈ U₀ := by
          have h1 : f₀.left.base (fst_R.base z_R) = g_s.base q_R :=
            congrArg (fun φ => φ.base z_R) (Limits.pullback.condition (f := f₀.left) (g := g_s))
          rw [h1, hq_eq]
          exact hg_range ⟨pt_Ω, rfl⟩
        let W₀ : Z_tilde.left.Opens := (TopologicalSpace.Opens.map f₀.left.base).obj U₀
        refine ⟨W₀, hf_in_U₀, ?_⟩
        rw [← AlgebraicGeometry.morphismRestrict_ι f₀.left U₀]
        have hcomp_sm : AlgebraicGeometry.SmoothOfRelativeDimension ((2 * m + 1) + 0)
            ((f₀.left ∣_ U₀) ≫ U₀.ι) := inferInstance
        simpa using hcomp_sm
      · have hq_eq : q_R = i_cl.base pt_k := by
          apply PrimeSpectrum.ext
          rw [hq_max, ← hπ_ker]
          rfl
        have hf_in_s : f₀.left.base (fst_R.base z_R) ∈ Set.range s.base := by
          have h1 : f₀.left.base (fst_R.base z_R) = g_s.base q_R :=
            congrArg (fun φ => φ.base z_R) (Limits.pullback.condition (f := f₀.left) (g := g_s))
          rw [h1, hq_eq]
          change (i_cl ≫ g_s).base pt_k ∈ Set.range s.base
          rw [hg_cl]
          exact ⟨g_Fk.base pt_k, rfl⟩
        have h_not_xs : fst_R.base z_R ∉ Set.range x_s.base := by
          rintro ⟨pt_u, hxs_eq⟩
          obtain ⟨w, hw_1, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z_R pt_u hxs_eq.symm
          let σ_k : Spec (CommRingCat.of k) ⟶ Limits.pullback fst_R x_s :=
            Limits.pullback.lift x_bar_R g_Fk hx_fst
          have hw_eq : w = σ_k.base pt_k := by
            apply (Limits.pullback.fst fst_R x_s ≫ snd_R).isClosedEmbedding.injective
            have hL : (Limits.pullback.fst fst_R x_s ≫ snd_R).base w = i_cl.base pt_k := by
              change snd_R.base ((Limits.pullback.fst fst_R x_s).base w) = i_cl.base pt_k
              rw [hw_1]
              exact hq_eq
            have hR : (Limits.pullback.fst fst_R x_s ≫ snd_R).base (σ_k.base pt_k) =
                i_cl.base pt_k := by
              change (σ_k ≫ Limits.pullback.fst fst_R x_s ≫ snd_R).base pt_k = i_cl.base pt_k
              rw [← Category.assoc, Limits.pullback.lift_fst, hx_snd]
            exact hL.trans hR.symm
          apply hz_notin
          refine ⟨pt_k, ?_⟩
          have h1 : x_bar_R.base pt_k = (Limits.pullback.fst fst_R x_s).base (σ_k.base pt_k) :=
            congrArg (fun φ => φ.base pt_k) (Limits.pullback.lift_fst x_bar_R g_Fk hx_fst).symm
          rw [h1, ← hw_eq, hw_1]
        exact hSm_away (fst_R.base z_R) hf_in_s h_not_xs
    obtain ⟨W₀, hz_W₀, hSm_W₀⟩ := hW₀_ex
    let W_Z : Z_R.Opens := (TopologicalSpace.Opens.map fst_R.base).obj W₀
    have hPb_WZ : CategoryTheory.IsPullback (fst_R ∣_ W₀) (W_Z.ι ≫ snd_R) (W₀.ι ≫ f₀.left) g_s :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst_R W₀).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback f₀.left g_s)
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_Z.ι ≫ snd_R) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_WZ hSm_W₀
    let W : U_Z.toScheme.Opens := (TopologicalSpace.Opens.map U_Z.ι.base).obj W_Z
    have hx_W : x ∈ W := hz_W₀
    refine ⟨W, hx_W, ?_⟩
    dsimp [π_UZ]
    rw [← Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι U_Z.ι W_Z, Category.assoc]
    have hcomp_sm : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (2 * m + 1))
        ((U_Z.ι ∣_ W_Z) ≫ (W_Z.ι ≫ snd_R)) := inferInstance
    simpa using hcomp_sm

  
  have hAtlas : ∀ x : ↥U_Z.toScheme,
      ∃ (V : U_Z.toScheme.Opens) (_ : x ∈ V)
        (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
        (V_U : AlgebraicGeometry.Scheme.{u})
        (ι_VU : V_U ⟶ Z_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
        CategoryTheory.IsPullback ι_VU j_V j_Z_open V.ι ∧
        CategoryTheory.IsPullback φ_U j_V j_A φ := by
    let d_rel := 2 * m + 1
    have hMvPb : ∀ (R₀ : Type u) [CommRing R₀] (c₀ : k →+* R₀),
        CategoryTheory.IsPullback
          (Spec.map (CommRingCat.ofHom (MvPolynomial.map c₀ :
            MvPolynomial (Fin d_rel) k →+* MvPolynomial (Fin d_rel) R₀)) :
            Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R₀)) ⟶ S_d.left)
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀)))
          S_d.hom
          (Spec.map (CommRingCat.ofHom c₀)) := by
      intro R₀ _ c₀
      let f_k : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
        CommRingCat.ofHom MvPolynomial.C
      let g_k : CommRingCat.of k ⟶ CommRingCat.of R₀ := CommRingCat.ofHom c₀
      let inl_k : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶
