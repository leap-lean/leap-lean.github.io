          have h1 := congrArg (fun x => x 1) h
          simp only [hμ_box_0, hμ_box_1] at h0 h1
          exact Prod.ext (Fin.ext h0) (Fin.ext h1)
        let G : MvPolynomial (Fin 2) k :=
          ∑ α : IdxBox, MvPolynomial.monomial (μ_box α) (c α)
        have hG_ne : G ≠ 0 := by
          obtain ⟨α₀, hα₀⟩ := Function.ne_iff.mp hc_ne
          intro hG0
          have hc0 : G.coeff (μ_box α₀) = 0 := by simp [hG0]
          have hc_eq : G.coeff (μ_box α₀) = c α₀ := by
            dsimp [G]
            rw [MvPolynomial.coeff_sum, Finset.sum_eq_single α₀]
            · simp [MvPolynomial.coeff_monomial]
            · intro α _ hne
              rw [MvPolynomial.coeff_monomial]
              have : μ_box α ≠ μ_box α₀ := fun heq => hne (hμ_box_inj heq)
              simp [this]
