        letI : CommRing (R_b b) := hCR b
        letI : Algebra K (R_b b) := hAlg b
        obtain ⟨e_Wb, he_Wb_hom⟩ := he_Wb b
        obtain ⟨hi_Wb_hom, hWtilde_eq, _, ⟨q_0, q_1, hq0_ι, hq1_ι, hq0_i, hq1_i⟩,
            hOv0_R, hOv1_R, hGlue_R⟩ := hCharts b
        let g_iso : AlgebraicGeometry.Spec (CommRingCat.of (R_b b)) ≅
            AlgebraicGeometry.Spec (CommRingCat.of K) :=
          (i_Wb b).symm ≪≫ e_Wb ≪≫ e_A0
        have hg_iso_hom : g_iso.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (R_b b))) := by
