      obtain ⟨Q_inf, hQ_inf⟩ := hLaurent_match n Q hQ_deg
      let s₁ : R₁ := algebraMap (Polynomial k) R₁ Q * (IsLocalization.Away.invSelf (P_vec c)) ^ n
      let s₂ : R₂ := algebraMap (Polynomial k) R₂ Q_inf *
        (IsLocalization.Away.invSelf (P_inf' c)) ^ n
      have hlam₁_s₁ : lam₁ s₁ = algebraMap (Polynomial k) (RatFunc k) Q /
          (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ n := by
        dsimp [s₁]
        rw [map_mul, map_pow, hlam₁_eq, hlam₁_inv, inv_pow, div_eq_mul_inv]
      have hlam₂_s₂ : lam₂ s₂ = algebraMap (Polynomial k) (RatFunc k) Q_inf /
          (algebraMap (Polynomial k) (RatFunc k) (P_inf c)) ^ n := by
        dsimp [s₂]
        rw [map_mul, map_pow, hlam₂_eq, hlam₂_inv, hPinf'_eq c,
          inv_pow, div_eq_mul_inv]
      have hβ_eq : β₁ s₁ = β₂ s₂ := by
        apply hlam₁₂_inj
        have h1 := congrArg (fun g : R₁ →+* RatFunc k => g s₁) hlam₁₂_β₁
        have h2 := congrArg (fun g : R₂ →+* RatFunc k => g s₂) hlam₁₂_β₂
        dsimp at h1 h2
        rw [h1, h2, hlam₁_s₁, hlam₂_s₂, hQ_inf]
      obtain ⟨G, hG⟩ := hGlue_sec s₁ s₂ hβ_eq
      refine ⟨G, ?_⟩
      change θ_c.toRingHom G = _
      rw [← hlam₁_Φ₁, RingHom.coe_comp, Function.comp_apply, hG, hlam₁_s₁]
  refine ⟨P₀, P₁, P₂,
    ⟨hP₀_monic, hd_pos, hP₁_ne, hP₂_ne, hP₁_deg, hP₂_deg, hP_coprime⟩,
    fun c => (hChartGluing c).2,
    ⟨hConj3_1, hDP0_univ⟩,
    ⟨(hChartGluing 0).1, hConj4_2⟩⟩

theorem weil_p2_gl3_charts_and_closed_imm_sections (F : Type u) [Field F]
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    [AlgebraicGeometry.IsOpenImmersion j_aff]
    (hj_aff_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hs_inf_hom : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hs_inf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (hu₀_hom : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ s ∈ S_aff, Polynomial.X - Polynomial.C s ∉ p.asIdeal })
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (a : F) (ha : a ∈ S_aff)
    (S_aff_k : Finset k)
    (hS_aff_k : ∀ x : k, x ∈ S_aff_k ↔ ∃ s ∈ S_aff, algebraMap F k s = x)
    (ι_line : weilProjectiveSpaceOver F 1 ⟶ weilProjectiveSpaceOver F 2)
    [AlgebraicGeometry.IsClosedImmersion ι_line.left]
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible C_disc.hom]
    [AlgebraicGeometry.IsProper C_disc.hom]
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    [AlgebraicGeometry.IsClosedImmersion ι_disc.left]
    (hLine_disc : ι_line.left.base ⁻¹' (Set.range ι_disc.left.base) =
      (U₀ : Set (weilProjectiveSpaceOver F 1).left)ᶜ) :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∃ (π_P2 : (weilProjectiveSpaceOver k 2).left ⟶ (weilProjectiveSpaceOver F 2).left)
      (j_chart : Fin 3 →
        (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
          (weilProjectiveSpaceOver k 2).left))
      (P₀ P₁ P₂ : Polynomial k)
      (P_disc_0 : Ideal (MvPolynomial (Fin 2) k))
      (_ : P_disc_0.IsPrime),
      let Sigma_k : Set (weilProjectiveSpaceOver k 2).left :=
        π_P2.base ⁻¹' (Set.range ι_line.left.base)
      let C_disc_k : Set (weilProjectiveSpaceOver k 2).left :=
        π_P2.base ⁻¹' (Set.range ι_disc.left.base)
      let θ_0 : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
        MvPolynomial.aeval (fun j : Fin 2 =>
          algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] ((0 : Fin 3).succAbove j)) /
          algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] 0))
      IsFieldPullbackModel F k (weilProjectiveSpaceOver F 2) (weilProjectiveSpaceOver k 2) π_P2 ∧
      (∀ c : Fin 3,
        AlgebraicGeometry.IsOpenImmersion (j_chart c) ∧
        j_chart c ≫ (weilProjectiveSpaceOver k 2).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
        (j_chart c).base ⁻¹' Set.range (j_chart 0).base =
          { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
            eval_c c (MvPolynomial.X 0) ∉ p.asIdeal } ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K₂ c).toRingHom) ≫ j_chart c =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K₂ 0).toRingHom) ≫ j_chart 0) ∧
      (P₀.Monic ∧ 1 ≤ P₀.natDegree ∧ P₁ ≠ 0 ∧ P₂ ≠ 0 ∧
        P₁.natDegree ≤ P₀.natDegree ∧ P₂.natDegree ≤ P₀.natDegree ∧
        (∀ b : k, P₀.eval b = 0 → P₁.eval b ≠ 0 ∨ P₂.eval b ≠ 0) ∧
        (∀ c : Fin 3,
          let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
            MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
          Set.range θ_c =
            { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                Q.natDegree ≤ n * P₀.natDegree ∧
                f = algebraMap (Polynomial k) (RatFunc k) Q /
                  (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n }) ∧
        (∀ (Ω : Type u) [Field Ω] (χ_poly : Polynomial k →+* Ω),
          χ_poly P₀ ≠ 0 →
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (χ_poly.comp (Polynomial.mapRingHom (algebraMap F k)))) ≫
            j_aff ≫ ι_line.left =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.eval₂Hom (χ_poly.comp Polynomial.C)
                ![χ_poly P₁ / χ_poly P₀, χ_poly P₂ / χ_poly P₀])) ≫
            j_chart 0 ≫ π_P2) ∧
        (∃ f_Sigma_0 : AlgebraicGeometry.Spec
            (CommRingCat.of (MvPolynomial (Fin 2) k ⧸ RingHom.ker θ_0.toRingHom)) ⟶
            (weilProjectiveSpaceOver F 1).left,
          CategoryTheory.IsPullback f_Sigma_0
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Ideal.Quotient.mk (RingHom.ker θ_0.toRingHom))))
            ι_line.left (j_chart 0 ≫ π_P2)) ∧
        Sigma_k ∩ C_disc_k ⊆ Set.range (j_chart 0).base ∧
        (∀ (d_Sigma : ℕ) (H_Sigma : MvPolynomial (Fin 3) k),
          1 ≤ d_Sigma → H_Sigma.IsHomogeneous d_Sigma → Irreducible H_Sigma →
          MvPolynomial.X 0 ∉ Ideal.span {H_Sigma} →
          RingHom.ker θ_0.toRingHom = Ideal.span {eval_c 0 H_Sigma} →
          ∀ c : Fin 3,
            (j_chart c).base ⁻¹' Sigma_k =
              { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
                eval_c c H_Sigma ∈ p.asIdeal })) ∧
      (P_disc_0 ≠ ⊥ ∧
        (∀ (d_disc : ℕ) (F_disc_hom : MvPolynomial (Fin 3) k),
          1 ≤ d_disc → F_disc_hom.IsHomogeneous d_disc → Irreducible F_disc_hom →
          MvPolynomial.X 0 ∉ Ideal.span {F_disc_hom} →
          P_disc_0 = Ideal.span {eval_c 0 F_disc_hom} →
          ∀ c : Fin 3,
            (j_chart c).base ⁻¹' C_disc_k =
              { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
                eval_c c F_disc_hom ∈ p.asIdeal }) ∧
        (∃ p₁ p₂ : Fin 2 → k,
          p₁ ≠ p₂ ∧
          P_disc_0 ≤ RingHom.ker (MvPolynomial.eval p₁) ∧
          P_disc_0 ≤ RingHom.ker (MvPolynomial.eval p₂)) ∧
        P_disc_0 ≤ RingHom.ker (MvPolynomial.eval ![P₁.coeff P₀.natDegree, P₂.coeff P₀.natDegree]) ∧
        RingHom.ker θ_0.toRingHom ≤
          RingHom.ker (MvPolynomial.eval ![P₁.coeff P₀.natDegree, P₂.coeff P₀.natDegree]) ∧
        (∀ s_k ∈ S_aff_k,
          P₀.eval s_k ≠ 0 ∧
          P_disc_0 ≤
            RingHom.ker (MvPolynomial.eval ![P₁.eval s_k / P₀.eval s_k, P₂.eval s_k / P₀.eval s_k])) ∧
        (∀ b : k,
          P₀.eval b ≠ 0 →
          P_disc_0 ≤
            RingHom.ker (MvPolynomial.eval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]) →
          b ∈ S_aff_k)) :=
by
  classical
  intro K₂ x₁ x₂ homCoord eval_c φ_K₂
  have hRange_of_isPullback : ∀ {X Y Z W : AlgebraicGeometry.Scheme.{u}}
      {fst : X ⟶ Y} {snd : X ⟶ Z} {f : Y ⟶ W} {g : Z ⟶ W},
      CategoryTheory.IsPullback fst snd f g →
      g.base ⁻¹' (Set.range f.base) = Set.range snd.base := by
    intro X Y Z W fst snd f g h
    ext z
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · rintro ⟨y, hy⟩
      obtain ⟨x, -, hx₂⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback h y z hy
      exact ⟨x, hx₂⟩
    · rintro ⟨x, rfl⟩
      exact ⟨fst.base x, congrArg (fun m : X ⟶ W => m.base x) h.w⟩
  have hSpecFieldIdeal : ∀ {R E : Type u} [CommRing R] [Field E] (φ : R →+* E)
      (pt : AlgebraicGeometry.Spec (CommRingCat.of E)),
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base pt).asIdeal = RingHom.ker φ := by
    intro R E _ _ φ pt
    change Ideal.comap φ pt.asIdeal = RingHom.ker φ
    have hbot : pt.asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
    rw [hbot]
    rfl
  have hEval2Id : ∀ (b : k) (v : Fin 2 → k),
      MvPolynomial.eval₂Hom ((Polynomial.evalRingHom b).comp Polynomial.C) v =
        MvPolynomial.eval v := by
    intro b v
    apply MvPolynomial.ringHom_ext'
    · ext r
      simp
    · intro i
      simp
  let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let g_Fk : S_k ⟶ S_F := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let π_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap F k)))
  let p_aff_F : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ S_F :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : F →+* Polynomial F))
  let p_aff_k : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ S_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
  obtain ⟨-, -, hPolyBC, hProjBC⟩ := weil_canonical_and_projective_baseChange_models
  have hPb_aff : CategoryTheory.IsPullback π_aff p_aff_k p_aff_F g_Fk := hPolyBC F k
  obtain ⟨π_P1_fam, -, hP1BC, -⟩ := hProjBC 1
  obtain ⟨π_P2_fam, -, hP2BC, -⟩ := hProjBC 2
  let π_std_P1 : (weilProjectiveSpaceOver k 1).left ⟶ (weilProjectiveSpaceOver F 1).left :=
    π_P1_fam F k
  let π_std_P2 : (weilProjectiveSpaceOver k 2).left ⟶ (weilProjectiveSpaceOver F 2).left :=
    π_P2_fam F k
  have hPb_P1 : CategoryTheory.IsPullback π_std_P1
      (weilProjectiveSpaceOver k 1).hom (weilProjectiveSpaceOver F 1).hom g_Fk :=
    hP1BC F k
  have hPb_P2 : CategoryTheory.IsPullback π_std_P2
      (weilProjectiveSpaceOver k 2).hom (weilProjectiveSpaceOver F 2).hom g_Fk :=
    hP2BC F k
  have hSecP1 : ∀ (s : S_F ⟶ (weilProjectiveSpaceOver F 1).left)
      (hs : s ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 S_F)
      (s_k : S_k ⟶ (weilProjectiveSpaceOver k 1).left),
      s_k ≫ π_std_P1 = g_Fk ≫ s →
      s_k ≫ (weilProjectiveSpaceOver k 1).hom = 𝟙 S_k →
      π_std_P1.base ⁻¹' (Set.range s.base) = Set.range s_k.base := by
    intro s hs s_k h_fst h_snd
    have h_outer : CategoryTheory.IsPullback g_Fk
        (s_k ≫ (weilProjectiveSpaceOver k 1).hom)
        (s ≫ (weilProjectiveSpaceOver F 1).hom) g_Fk := by
      rw [h_snd, hs]
      exact CategoryTheory.IsPullback.of_vert_isIso ⟨by simp⟩
    have h_top : CategoryTheory.IsPullback g_Fk s_k s π_std_P1 :=
      CategoryTheory.IsPullback.of_bot h_outer h_fst.symm hPb_P1
    exact hRange_of_isPullback h_top
  have hj_aff_comm : (π_aff ≫ j_aff) ≫ (weilProjectiveSpaceOver F 1).hom = p_aff_k ≫ g_Fk := by
    rw [CategoryTheory.Category.assoc, hj_aff_hom]
    exact hPb_aff.w
  let j_aff_k : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left :=
    hPb_P1.lift (π_aff ≫ j_aff) p_aff_k hj_aff_comm
  have hj_aff_k_fst : j_aff_k ≫ π_std_P1 = π_aff ≫ j_aff := hPb_P1.lift_fst _ _ _
  have hj_aff_k_hom : j_aff_k ≫ (weilProjectiveSpaceOver k 1).hom = p_aff_k :=
    hPb_P1.lift_snd _ _ _
  have hPb_jaff : CategoryTheory.IsPullback π_aff j_aff_k j_aff π_std_P1 := by
    have h_outer : CategoryTheory.IsPullback π_aff
        (j_aff_k ≫ (weilProjectiveSpaceOver k 1).hom)
        (j_aff ≫ (weilProjectiveSpaceOver F 1).hom) g_Fk := by
      rw [hj_aff_k_hom, hj_aff_hom]
      exact hPb_aff
    exact CategoryTheory.IsPullback.of_bot h_outer hj_aff_k_fst.symm hPb_P1
  have : AlgebraicGeometry.IsOpenImmersion j_aff_k :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_jaff inferInstance
  let s_inf_k : S_k ⟶ (weilProjectiveSpaceOver k 1).left :=
    hPb_P1.lift (g_Fk ≫ s_inf) (𝟙 S_k) (by
      rw [CategoryTheory.Category.assoc, hs_inf_hom,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hs_inf_k_fst : s_inf_k ≫ π_std_P1 = g_Fk ≫ s_inf := hPb_P1.lift_fst _ _ _
  have hs_inf_k_hom : s_inf_k ≫ (weilProjectiveSpaceOver k 1).hom = 𝟙 S_k :=
    hPb_P1.lift_snd _ _ _
  let u₀_k : S_k ⟶ (weilProjectiveSpaceOver k 1).left :=
    hPb_P1.lift (g_Fk ≫ u₀) (𝟙 S_k) (by
      rw [CategoryTheory.Category.assoc, hu₀_hom,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hu₀_k_fst : u₀_k ≫ π_std_P1 = g_Fk ≫ u₀ := hPb_P1.lift_fst _ _ _
  have hu₀_k_hom : u₀_k ≫ (weilProjectiveSpaceOver k 1).hom = 𝟙 S_k :=
    hPb_P1.lift_snd _ _ _
  have hs_inf_k_compl : (Set.range j_aff_k.base)ᶜ = Set.range s_inf_k.base := by
    rw [← hRange_of_isPullback hPb_jaff, ← Set.preimage_compl, hs_inf_compl]
    exact hSecP1 s_inf hs_inf_hom s_inf_k hs_inf_k_fst hs_inf_k_hom
  let ι_line_std : (weilProjectiveSpaceOver k 1).left ⟶ (weilProjectiveSpaceOver k 2).left :=
    hPb_P2.lift (π_std_P1 ≫ ι_line.left) (weilProjectiveSpaceOver k 1).hom (by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_line, hPb_P1.w])
  have hι_line_std_fst : ι_line_std ≫ π_std_P2 = π_std_P1 ≫ ι_line.left :=
    hPb_P2.lift_fst _ _ _
  have hι_line_std_hom :
      ι_line_std ≫ (weilProjectiveSpaceOver k 2).hom = (weilProjectiveSpaceOver k 1).hom :=
    hPb_P2.lift_snd _ _ _
  have hPb_line_std : CategoryTheory.IsPullback π_std_P1 ι_line_std ι_line.left π_std_P2 := by
    have h_outer : CategoryTheory.IsPullback π_std_P1
        (ι_line_std ≫ (weilProjectiveSpaceOver k 2).hom)
        (ι_line.left ≫ (weilProjectiveSpaceOver F 2).hom) g_Fk := by
      rw [hι_line_std_hom, CategoryTheory.Over.w ι_line]
      exact hPb_P1
    exact CategoryTheory.IsPullback.of_bot h_outer hι_line_std_fst.symm hPb_P2
  have : AlgebraicGeometry.IsClosedImmersion ι_line_std :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_line_std inferInstance
  obtain ⟨j_chart, hj_chart_std, ⟨hj_chart_cov, hj_chart_trans⟩, hGL3_frame, hHyp_closure⟩ :=
    weil_p2_std_charts_gl3_aut_and_hypersurface_closure k
  have : ∀ c : Fin 3, AlgebraicGeometry.IsOpenImmersion (j_chart c) :=
    fun c => (hj_chart_std c).1
  let e_S : Fin S_aff.card ≃ ↥S_aff := S_aff.equivFin.symm
  let s_aff_F : F → (S_F ⟶ (weilProjectiveSpaceOver F 1).left) :=
    fun s => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom s)) ≫ j_aff
  let s_aff_k : k → (S_k ⟶ (weilProjectiveSpaceOver k 1).left) :=
    fun b => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom b)) ≫ j_aff_k
  have hs_aff_F_hom : ∀ s : F, s_aff_F s ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 S_F := by
    intro s
    dsimp [s_aff_F]
    rw [CategoryTheory.Category.assoc, hj_aff_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomp : (Polynomial.evalRingHom s).comp Polynomial.C = RingHom.id F := by
      ext r
      simp
    rw [hcomp]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of F)
  have hs_aff_k_hom : ∀ b : k, s_aff_k b ≫ (weilProjectiveSpaceOver k 1).hom = 𝟙 S_k := by
    intro b
    dsimp [s_aff_k]
    rw [CategoryTheory.Category.assoc, hj_aff_k_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomp : (Polynomial.evalRingHom b).comp Polynomial.C = RingHom.id k := by
      ext r
      simp
    rw [hcomp]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k)
  have hs_aff_k_fst : ∀ s : F, s_aff_k (algebraMap F k s) ≫ π_std_P1 = g_Fk ≫ s_aff_F s := by
    intro s
    dsimp [s_aff_k, s_aff_F]
    rw [CategoryTheory.Category.assoc, hj_aff_k_fst, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hrh : (Polynomial.evalRingHom (algebraMap F k s)).comp
        (Polynomial.mapRingHom (algebraMap F k)) =
        (algebraMap F k).comp (Polynomial.evalRingHom s) := by
      apply Polynomial.ringHom_ext'
      · ext r
        simp
      · simp
    rw [hrh, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc]
  let s_dist : S_k ⟶ (weilProjectiveSpaceOver k 2).left := s_inf_k ≫ ι_line_std
  have hs_dist_hom : s_dist ≫ (weilProjectiveSpaceOver k 2).hom = 𝟙 S_k := by
    dsimp [s_dist]
