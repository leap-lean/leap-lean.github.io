    obtain ⟨hLim_R, hInj_R⟩ :=
      weil_etale_postcomp_left_adjoint_ab4_preserves_limits_and_injectives U.ι hh m hc
    have : CategoryTheory.Limits.PreservesFiniteLimits R_sh := hLim_R
    let T_U := weilEtaleIdTerminal.{u} U.toScheme
    let hT_U := weilEtaleIdTerminalIsTerminal.{u} U.toScheme
    let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
