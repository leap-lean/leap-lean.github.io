      | succ p' =>
        obtain ⟨_, _, h0_right_S0, _, _, hex_right_S0⟩ := hLES g_k.left hSE_X p'
        obtain ⟨h0_mid_S1, h0_left_S1, _, hex_mid_S1, hex_left_S1, _⟩ :=
