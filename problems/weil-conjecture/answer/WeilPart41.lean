          exact @zero_mul
            ((MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)) ⧸ J_u) _ _
        rw [hlast_prod, add_zero] at hmk_succ
        simp only [s_pre, map_add, map_mul, map_sub, map_one, map_sum,
