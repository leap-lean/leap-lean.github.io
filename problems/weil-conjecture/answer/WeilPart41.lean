            omega
        let μ_box : IdxBox → (Fin 2 →₀ ℕ) := fun α =>
          Finsupp.single 0 α.1.val + Finsupp.single 1 α.2.val
        have hμ_box_0 : ∀ α : IdxBox, (μ_box α) 0 = α.1.val := by
          intro α
          simp [μ_box]
        have hμ_box_1 : ∀ α : IdxBox, (μ_box α) 1 = α.2.val := by
          intro α
          simp [μ_box]
        have hμ_box_inj : Function.Injective μ_box := by
          intro α β h
