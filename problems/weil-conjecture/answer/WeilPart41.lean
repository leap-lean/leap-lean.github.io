            alg_1 (Polynomial.C (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c)))
          map_one' := by simp only [map_one, Polynomial.C_1]
          map_mul' := fun x y => by simp only [map_mul, Polynomial.C_mul]
          map_zero' := by simp only [map_zero, Polynomial.C_0]
          map_add' := fun x y => by simp only [map_add, Polynomial.C_add] }
      let φ1 : MvPolynomial (Fin 1) Ω →+* Localization.Away r_1 :=
        MvPolynomial.eval₂Hom c_loc1 (fun _ => alg_1 Polynomial.X)
      have hψ1_φ1 : ψ1.comp φ1 = RingHom.id (MvPolynomial (Fin 1) Ω) := by
        apply MvPolynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          change ψ1 (φ1 (MvPolynomial.C c)) = MvPolynomial.C c
          rw [show φ1 (MvPolynomial.C c) =
            alg_1 (Polynomial.C (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c))) by
              simp [φ1, c_loc1]]
          dsimp only [alg_1]
          rw [IsLocalization.Away.lift_eq (g := ψ1_pre) r_1 hUnit_r1]
          rw [show ψ1_pre (Polynomial.C (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c))) =
            MvPolynomial.C (ev1 (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c))) by
              simp [ψ1_pre]]
          change MvPolynomial.C (ev1_pre (MvPolynomial.C c)) = MvPolynomial.C c
          simp [ev1_pre]
        · intro i
          have hi : i = 0 := Subsingleton.elim i 0
          subst hi
          simp [φ1, alg_1, ψ1, ψ1_pre]
      have hr1_eq_inv_in_loc1 :
          alg_1 r_1 =
          alg_1
            (Polynomial.C
              (algebraMap Ω (MvPolynomial (Fin 1 ⊕ (Fin 0 × Fin 2)) Ω ⧸ I_k 0) c_0⁻¹)) := by
        have hr0_zero : alg_1 r_0 = 0 := by
          have h0 : alg_1 r_0 * alg_1 r_1 = 0 := by
            rw [← map_mul, hr_mul, map_zero]
          rcases (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away r_1) r_1) with
            ⟨u1, hu1⟩
          dsimp only [alg_1] at h0
          rw [← hu1] at h0
          have h1 := congrArg (· * (↑u1⁻¹ : Localization.Away r_1)) h0
          simpa [mul_assoc] using h1
        have hcr1 : alg_1 (Polynomial.C c_R0) * alg_1 r_1 = 1 := by
          have hsum := congrArg alg_1 hr_add
          rw [map_add, map_mul, map_one, hr0_zero, zero_add] at hsum
          exact hsum
        have hcinv_c :
            Polynomial.C
              (algebraMap Ω (MvPolynomial (Fin 1 ⊕ (Fin 0 × Fin 2)) Ω ⧸ I_k 0) c_0⁻¹) *
            Polynomial.C c_R0 =
            (1 : Polynomial (MvPolynomial (Fin 1 ⊕ (Fin 0 × Fin 2)) Ω ⧸ I_k 0)) := by
          dsimp [c_R0]
          rw [← Polynomial.C_mul, ← map_mul, inv_mul_cancel₀ hc_0, map_one, Polynomial.C_1]
        calc
          alg_1 r_1 = 1 * alg_1 r_1 := (one_mul _).symm
          _ = alg_1
                (Polynomial.C
                  (algebraMap Ω
                    (MvPolynomial (Fin 1 ⊕ (Fin 0 × Fin 2)) Ω ⧸ I_k 0) c_0⁻¹) *
                  Polynomial.C c_R0) *
              alg_1 r_1 := by
                rw [hcinv_c, map_one]
          _ = alg_1
                (Polynomial.C
                  (algebraMap Ω
                    (MvPolynomial (Fin 1 ⊕ (Fin 0 × Fin 2)) Ω ⧸ I_k 0) c_0⁻¹)) *
              (alg_1 (Polynomial.C c_R0) * alg_1 r_1) := by
                rw [map_mul, mul_assoc]
          _ = alg_1
                (Polynomial.C
                  (algebraMap Ω
                    (MvPolynomial (Fin 1 ⊕ (Fin 0 × Fin 2)) Ω ⧸ I_k 0) c_0⁻¹)) := by
                rw [hcr1, mul_one]
      have hφ1_ψ1 : φ1.comp ψ1 = RingHom.id (Localization.Away r_1) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers r_1)
        refine Polynomial.ringHom_ext (fun a => ?_) ?_
        · obtain ⟨m, rfl⟩ := Ideal.Quotient.mk_surjective a
          change φ1 (ψ1 (alg_1 (Polynomial.C (Ideal.Quotient.mk (I_k 0) m)))) =
            alg_1 (Polynomial.C (Ideal.Quotient.mk (I_k 0) m))
          refine MvPolynomial.induction_on
            (motive := fun m =>
              φ1 (ψ1 (alg_1 (Polynomial.C (Ideal.Quotient.mk (I_k 0) m)))) =
                alg_1 (Polynomial.C (Ideal.Quotient.mk (I_k 0) m))) m
            (fun c => ?_) (fun f g hf hg => ?_) (fun f idx hf => ?_)
          · dsimp only [alg_1]
            rw [IsLocalization.Away.lift_eq (g := ψ1_pre) r_1 hUnit_r1]
            rw [show ψ1_pre (Polynomial.C (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c))) =
              MvPolynomial.C (ev1 (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c))) by
                simp [ψ1_pre]]
            rw [show ev1 (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c)) = c by
              change ev1_pre (MvPolynomial.C c) = c; simp [ev1_pre]]
            simp [φ1, c_loc1, alg_1]
          · simp only [map_add] at hf hg ⊢
            exact congrArg₂ (· + ·) hf hg
          · rcases idx with i | ⟨j, b⟩
            · have hi : i = 0 := Subsingleton.elim i 0
              subst hi
              simp only [map_mul] at hf ⊢
              refine congrArg₂ (· * ·) hf ?_
              change φ1 (ψ1 (alg_1 r_1)) = alg_1 r_1
              have hlhs : φ1 (ψ1 (alg_1 r_1)) =
                  alg_1
                    (Polynomial.C
                      (Ideal.Quotient.mk (I_k 0) (MvPolynomial.C c_0⁻¹))) := by
                dsimp only [alg_1]
                rw [IsLocalization.Away.lift_eq (g := ψ1_pre) r_1 hUnit_r1]
                rw [hval_r1]
                simp [φ1, c_loc1, alg_1]
              exact hlhs.trans hr1_eq_inv_in_loc1.symm
            · exact Fin.elim0 j
        · change φ1 (ψ1 (alg_1 Polynomial.X)) = alg_1 Polynomial.X
          dsimp only [alg_1]
          rw [IsLocalization.Away.lift_eq (g := ψ1_pre) r_1 hUnit_r1]
          simp [φ1, alg_1, ψ1_pre]
      let eq_1 : MvPolynomial (Fin 1) Ω ≃+* Localization.Away r_1 :=
        { φ1 with
          invFun := ψ1
          left_inv := fun x => RingHom.congr_fun hψ1_φ1 x
          right_inv := fun x => RingHom.congr_fun hφ1_ψ1 x }
      let e_O1 : O₁.toScheme ≅ (weilAffineSpaceOver Ω 1).left :=
        e_O1_loc.trans
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_1.toRingHom)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_1.symm.toRingHom)
            hom_inv_id := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_1.toRingHom) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_1.symm.toRingHom) =
                𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away r_1)))
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
                show eq_1.toRingHom.comp eq_1.symm.toRingHom = RingHom.id _ from
                  RingHom.ext eq_1.apply_symm_apply,
                CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
            inv_hom_id := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_1.symm.toRingHom) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_1.toRingHom) =
                𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) Ω)))
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
                show eq_1.symm.toRingHom.comp eq_1.toRingHom = RingHom.id _ from
                  RingHom.ext eq_1.symm_apply_apply,
                CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
      exact ⟨O₀, O₁, e_O0, e_O1, hO_inf, hO_sup⟩

    · 
      intro k
      haveI : Algebra.FiniteType Ω (MvPolynomial (Fin 1 ⊕ (Fin k × Fin 2)) Ω ⧸ I_k k) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω (I_k k))
