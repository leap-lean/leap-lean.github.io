    have h1 : (c * c⁻¹).val = 1 := by
      rw [mul_inv_cancel₀ hc, ZMod.val_one]
    have h2 : (c.val * (c⁻¹).val) • x = 0 := by
      rw [mul_nsmul, hcx, smul_zero]
    rw [← hModNsmul x hℓx, ← ZMod.val_mul, h1, one_nsmul] at h2
    exact h2

  have hEmptySub : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (E_emp : S₀.Etale),
      IsEmpty ↥E_emp.left →
      ∀ (ℋ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton ↥(ℋ.obj.obj (Opposite.op E_emp)) := by
    intro S₀ E_emp hEmp ℋ
    have hBot : (⊥ : CategoryTheory.Sieve E_emp) ∈ S₀.smallEtaleTopology E_emp :=
      (hMemEtale S₀ E_emp ⊥).mpr (fun x => IsEmpty.elim hEmp x)
    exact ⟨fun s₁ s₂ => ℋ.isSeparated E_emp ⊥ hBot s₁ s₂ (fun _ _ hf => False.elim hf)⟩

  let _ : (weilEtaleSitePullback i).IsContinuous Y.left.smallEtaleTopology Z.smallEtaleTopology := hc_i
  let J_Y := Y.left.smallEtaleTopology
  let J_Z := Z.smallEtaleTopology
  let B_i : CategoryTheory.Functor Y.left.Etale Z.Etale := weilEtaleSitePullback i
  let B_j : CategoryTheory.Functor Y.left.Etale U.Etale := weilEtaleSitePullback j
  let pf_i := B_i.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_Z
  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let F_Y := weilEtaleTorsionSheaf Y.left ℓ
  let F_Z := weilEtaleTorsionSheaf Z ℓ
  let F_U := weilEtaleTorsionSheaf U ℓ
  let Q₁ : CategoryTheory.Functor (Opposite Y.left.Etale) AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp B_j.op (F_U.cohomologyPresheaf 1)
  let R₁ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := weilEtaleHigherDirectImage j 1 F_U
  let constY := (CategoryTheory.Functor.const (Opposite Y.left.Etale)).obj A_ℓ
  let constZ := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj A_ℓ
  let η_Y : constY ⟶ F_Y.obj := CategoryTheory.toSheafify J_Y constY
  let η_Z : constZ ⟶ F_Z.obj := CategoryTheory.toSheafify J_Z constZ
  let η_Q1 : Q₁ ⟶ R₁.obj := CategoryTheory.toSheafify J_Y Q₁

  obtain ⟨u_i, hu_app⟩ : ∃ u_i : F_Y ⟶ pf_i.obj F_Z,
      ∀ (E : Y.left.Etale) (c : ↥A_ℓ),
        (u_i.hom.app (Opposite.op E)) (η_Y.app (Opposite.op E) c) =
          η_Z.app (Opposite.op (B_i.obj E)) c := by
    let adj_sh_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let u_pre : constY ⟶ (pf_i.obj F_Z).obj := CategoryTheory.Functor.whiskerLeft B_i.op η_Z
    let u_i : F_Y ⟶ pf_i.obj F_Z := (adj_sh_Y.homEquiv constY (pf_i.obj F_Z)).symm u_pre
    have hu_fac : η_Y ≫ u_i.hom = u_pre := by
      have h1 := (adj_sh_Y.homEquiv constY (pf_i.obj F_Z)).apply_symm_apply u_pre
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    exact ⟨u_i, fun E c =>
      congrArg (fun τ : constY ⟶ (pf_i.obj F_Z).obj => (τ.app (Opposite.op E)) c) hu_fac⟩

  let T_Y : Y.left.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 Y.left)
  obtain ⟨hT_Y⟩ : Nonempty (CategoryTheory.Limits.IsTerminal T_Y) :=
    ⟨CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom (CategoryTheory.Category.comp_id E.hom))
      (fun E m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))⟩

  obtain ⟨ξ_tilde0, hTors_Q1, hEval_ξ0⟩ :
      ∃ ξ_tilde0 : ↥(Q₁.obj (Opposite.op T_Y)),
        (∀ (E : Y.left.Etale), ℓ • ((Q₁.map (hT_Y.from E).op).hom ξ_tilde0) = 0) ∧
        (∀ (E : Y.left.Etale)
          (p_E : weilEtaleTorsionH U ℓ 1 →+ weilEtaleTorsionH (B_j.obj E).left ℓ 1),
          WeilIsTorsionEtalePullback (B_j.obj E).hom ℓ 1 p_E →
          Θ (B_j.obj E) ((Q₁.map (hT_Y.from E).op).hom ξ_tilde0) = p_E ξ₀) := by
    let top_U_sch : AlgebraicGeometry.Scheme.{u} := (B_j.obj T_Y).left
    let top_U_hom : top_U_sch ⟶ U := (B_j.obj T_Y).hom
    obtain ⟨p_top, hp_top⟩ := hPullEx top_U_hom ℓ 1
    let ξ_tilde0 : ↥(Q₁.obj (Opposite.op T_Y)) := (Θ (B_j.obj T_Y)).symm (p_top ξ₀)
    have hTors_ξtilde0 : ℓ • ξ_tilde0 = 0 := by
      apply (Θ (B_j.obj T_Y)).injective
      have h1 : Θ (B_j.obj T_Y) ξ_tilde0 = p_top ξ₀ :=
        (Θ (B_j.obj T_Y)).apply_symm_apply (p_top ξ₀)
      have h2 : ℓ • p_top ξ₀ = 0 := by
        rw [← map_nsmul p_top, hTors_ξ₀, map_zero]
      rw [map_nsmul, map_zero, h1]
      exact h2
    have hTors_Q1 : ∀ (E : Y.left.Etale), ℓ • ((Q₁.map (hT_Y.from E).op).hom ξ_tilde0) = 0 := by
      intro E
      rw [← map_nsmul (Q₁.map (hT_Y.from E).op).hom, hTors_ξtilde0, map_zero]
    have hEval_ξ0 : ∀ (E : Y.left.Etale)
        (p_E : weilEtaleTorsionH U ℓ 1 →+ weilEtaleTorsionH (B_j.obj E).left ℓ 1),
        WeilIsTorsionEtalePullback (B_j.obj E).hom ℓ 1 p_E →
        Θ (B_j.obj E) ((Q₁.map (hT_Y.from E).op).hom ξ_tilde0) = p_E ξ₀ := by
      intro E p_E hp_E
      let g_E : B_j.obj E ⟶ B_j.obj T_Y := B_j.map (hT_Y.from E)
      obtain ⟨p_gE, hp_gE⟩ := hPullEx (g_E.left : (B_j.obj E).left ⟶ (B_j.obj T_Y).left) ℓ 1
      have hnat := hΘ_nat g_E p_gE hp_gE ξ_tilde0
      have hΘ_top : Θ (B_j.obj T_Y) ξ_tilde0 = p_top ξ₀ :=
        (Θ (B_j.obj T_Y)).apply_symm_apply (p_top ξ₀)
      have hgE_w : g_E.left ≫ (B_j.obj T_Y).hom = (B_j.obj E).hom :=
        CategoryTheory.MorphismProperty.Over.w g_E
      have hp_comp : p_E = p_gE.comp p_top :=
        hPullComp g_E.left (B_j.obj T_Y).hom ℓ 1 p_gE p_top p_E hp_gE hp_top (by rwa [hgE_w])
      change Θ (B_j.obj E) ((((F_U.cohomologyPresheaf 1).map g_E.op).hom) ξ_tilde0) = p_E ξ₀
      rw [hnat, hΘ_top, hp_comp]
      rfl
    exact ⟨ξ_tilde0, hTors_Q1, hEval_ξ0⟩

  obtain ⟨ψ_0, hψ_app⟩ : ∃ ψ_0 : F_Y ⟶ R₁,
      ∀ (E : Y.left.Etale) (c : ZMod ℓ),
        (ψ_0.hom.app (Opposite.op E)) (η_Y.app (Opposite.op E) (ULift.up c)) =
          η_Q1.app (Opposite.op E) (c.val • ((Q₁.map (hT_Y.from E).op).hom ξ_tilde0)) := by
    let adj_sh_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let ψ_pre : constY ⟶ Q₁ :=
      { app := fun E_op =>
          AddCommGrpCat.ofHom
            { toFun := fun c => c.down.val • ((Q₁.map (hT_Y.from E_op.unop).op).hom ξ_tilde0)
              map_zero' := by
                change (0 : ZMod ℓ).val • ((Q₁.map (hT_Y.from E_op.unop).op).hom ξ_tilde0) = 0
                rw [ZMod.val_zero]
                exact zero_nsmul ((Q₁.map (hT_Y.from E_op.unop).op).hom ξ_tilde0)
              map_add' := fun a b =>
                hZModAdd ((Q₁.map (hT_Y.from E_op.unop).op).hom ξ_tilde0)
                  (hTors_Q1 E_op.unop) a.down b.down }
        naturality := fun {E₁ E₂} f => by
          apply AddCommGrpCat.ext
          intro c
          change c.down.val • ((Q₁.map (hT_Y.from E₂.unop).op).hom ξ_tilde0) =
            (Q₁.map f).hom (c.down.val • ((Q₁.map (hT_Y.from E₁.unop).op).hom ξ_tilde0))
          rw [map_nsmul (Q₁.map f).hom]
          have h_from : f.unop ≫ hT_Y.from E₁.unop = hT_Y.from E₂.unop := hT_Y.hom_ext _ _
          have h_op : (hT_Y.from E₂.unop).op = (hT_Y.from E₁.unop).op ≫ f := by
            rw [← h_from]; rfl
          rw [h_op, Q₁.map_comp]
          rfl }
    let ψ_0 : F_Y ⟶ R₁ := (adj_sh_Y.homEquiv constY R₁).symm (ψ_pre ≫ η_Q1)
    have hψ_fac : η_Y ≫ ψ_0.hom = ψ_pre ≫ η_Q1 := by
      have h1 := (adj_sh_Y.homEquiv constY R₁).apply_symm_apply (ψ_pre ≫ η_Q1)
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    exact ⟨ψ_0, fun E c =>
      congrArg (fun τ : constY ⟶ R₁.obj => (τ.app (Opposite.op E)) (ULift.up c)) hψ_fac⟩

  
  have hEpi_ui : CategoryTheory.Epi u_i := by
    refine (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (A := AddCommGrpCat.{u}) u_i).mp ?_
    rw [← CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
    intro E s
    refine (hMemEtale Y.left E (CategoryTheory.Presheaf.imageSieve u_i.hom s)).mpr ?_
    intro x
    let E_Z : Z.Etale := B_i.obj E
    let e_hom : E.left ⟶ Y.left := E.hom
    let i_E : E_Z.left ⟶ E.left := CategoryTheory.Limits.pullback.fst e_hom i
    have _ : AlgebraicGeometry.IsClosedImmersion i_E :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback e_hom i).flip inferInstance
    by_cases hx : x ∈ Set.range i_E.base
    · obtain ⟨z₀, hz₀⟩ := hx
      let s_sh : ↥((CategoryTheory.sheafify J_Z constZ).obj (Opposite.op E_Z)) := s
      have hImg : CategoryTheory.Presheaf.imageSieve
          (CategoryTheory.toSheafify J_Z constZ) s_sh ∈ J_Z E_Z :=
        CategoryTheory.Presheaf.imageSieve_mem J_Z (CategoryTheory.toSheafify J_Z constZ) s_sh
      obtain ⟨W₀, w₀, y₀, hw₀_img, hEt_w0, hy₀⟩ := (hMemEtale Z E_Z _).mp hImg z₀
      let e_Z_hom : E_Z.left ⟶ Z := E_Z.hom
      let w₀_left : W₀.left ⟶ E_Z.left := w₀.left
      let w₀_hom : W₀.left ⟶ Z := W₀.hom
      have _ : AlgebraicGeometry.Etale w₀_left := hEt_w0
      obtain ⟨c₀, hc₀⟩ := hw₀_img
      have hOpen_range : IsOpen (Set.range w₀_left.base) := by
        rw [← Set.image_univ]
        exact w₀_left.isOpenMap Set.univ isOpen_univ
      obtain ⟨O_set, hOpen_Oset, hPre_Oset⟩ :=
        i_E.isClosedEmbedding.isInducing.isOpen_iff.mp hOpen_range
      let O_x : E.left.Opens := ⟨O_set, hOpen_Oset⟩
      have hx_Ox : x ∈ O_x := by
        change x ∈ O_set
        rw [← hz₀]
        change z₀ ∈ i_E.base ⁻¹' O_set
        rw [hPre_Oset]
        exact ⟨y₀, hy₀⟩
      have hEt_Ox : P_et (O_x.ι ≫ e_hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et O_x.ι e_hom inferInstance E.prop
      let O_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ e_hom) hEt_Ox
      let f_O : O_et ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl trivial
      have hRange_w : Set.range (w₀_left ≫ i_E).base ⊆ Set.range O_x.ι.base := by
        rintro _ ⟨y', rfl⟩
        refine ⟨⟨(w₀_left ≫ i_E).base y', ?_⟩, rfl⟩
        change w₀_left.base y' ∈ i_E.base ⁻¹' O_set
        rw [hPre_Oset]
        exact ⟨y', rfl⟩
      let l_W : W₀.left ⟶ O_x.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift O_x.ι (w₀_left ≫ i_E) hRange_w
      have hl_W_fac : l_W ≫ O_x.ι = w₀_left ≫ i_E :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac O_x.ι (w₀_left ≫ i_E) hRange_w
      let o_et_left : AlgebraicGeometry.Scheme.{u} := (B_i.obj O_et).left
      let o_et_hom : o_et_left ⟶ Z := (B_i.obj O_et).hom
      have hcond_eZ : i_E ≫ e_hom = e_Z_hom ≫ i := CategoryTheory.Limits.pullback.condition
      let w_tilde_left : W₀.left ⟶ o_et_left :=
        CategoryTheory.Limits.pullback.lift l_W w₀_hom
          (calc
            l_W ≫ (O_x.ι ≫ e_hom)
              = (l_W ≫ O_x.ι) ≫ e_hom := (Category.assoc _ _ _).symm
            _ = w₀_left ≫ (i_E ≫ e_hom) := by rw [hl_W_fac, Category.assoc]
            _ = (w₀_left ≫ e_Z_hom) ≫ i :=
                  (congrArg (w₀_left ≫ ·) hcond_eZ).trans (Category.assoc _ _ _).symm
            _ = w₀_hom ≫ i := by
                  have hw₀_w : w₀_left ≫ e_Z_hom = w₀_hom :=
                    CategoryTheory.MorphismProperty.Over.w w₀
                  rw [hw₀_w])
      have hwt_hom : w_tilde_left ≫ o_et_hom = w₀_hom :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h_wt_fst : w_tilde_left ≫ CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i = l_W :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hEt_wt : AlgebraicGeometry.Etale w_tilde_left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et w_tilde_left o_et_hom
          (B_i.obj O_et).prop (hwt_hom.symm ▸ W₀.prop)
      let w_tilde : W₀ ⟶ B_i.obj O_et :=
        CategoryTheory.MorphismProperty.Over.homMk w_tilde_left hwt_hom trivial
      let p_O : o_et_left ⟶ E_Z.left := (B_i.map f_O).left
      have hpO_fst : p_O ≫ i_E =
          CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i ≫ O_x.ι :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hpO_snd : p_O ≫ e_Z_hom =
          CategoryTheory.Limits.pullback.snd (O_x.ι ≫ e_hom) i :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hwt_pO : w_tilde_left ≫ p_O = w₀_left := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (Category.assoc w_tilde_left p_O i_E).trans
            ((congrArg (w_tilde_left ≫ ·) hpO_fst).trans
              ((Category.assoc w_tilde_left
                  (CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i) O_x.ι).symm.trans
                ((congrArg (· ≫ O_x.ι) h_wt_fst).trans hl_W_fac)))
        · exact (Category.assoc w_tilde_left p_O e_Z_hom).trans
            ((congrArg (w_tilde_left ≫ ·) hpO_snd).trans
              (hwt_hom.trans (CategoryTheory.MorphismProperty.Over.w w₀).symm))
      have hwt_comp : w_tilde ≫ B_i.map f_O = w₀ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hwt_pO (Subsingleton.elim _ _)
      have hPb_pO : CategoryTheory.IsPullback
          p_O (CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i) i_E O_x.ι := by
        have h_outer : CategoryTheory.IsPullback
            (p_O ≫ e_Z_hom) (CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i)
            i (O_x.ι ≫ e_hom) := by
          rw [hpO_snd]
          exact (CategoryTheory.IsPullback.of_hasPullback (O_x.ι ≫ e_hom) i).flip
        have h_right : CategoryTheory.IsPullback e_Z_hom i_E i e_hom :=
          (CategoryTheory.IsPullback.of_hasPullback e_hom i).flip
        exact CategoryTheory.IsPullback.of_right h_outer hpO_fst h_right
      have _ : AlgebraicGeometry.IsOpenImmersion p_O :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_pO.flip inferInstance
      let R_wt : CategoryTheory.Sieve (B_i.obj O_et) :=
        { arrows := fun _ g_arr => ∃ h : _ ⟶ W₀, h ≫ w_tilde = g_arr
          downward_closed := by
            rintro _ _ g_arr ⟨h, rfl⟩ k
            exact ⟨k ≫ h, Category.assoc k h w_tilde⟩ }
      have hRwt_mem : R_wt ∈ J_Z (B_i.obj O_et) := by
        rw [hMemEtale]
        intro q
        have hq_in : p_O.base q ∈ Set.range w₀_left.base := by
          rw [← hPre_Oset]
          change i_E.base (p_O.base q) ∈ O_set
          have h1 : i_E.base (p_O.base q) =
              O_x.ι.base ((CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i).base q) :=
            congrArg (fun m => m.base q) hpO_fst
          rw [h1]
          exact ((CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i).base q).2
        obtain ⟨y_q, hy_q⟩ := hq_in
        have h_eq_q : w_tilde_left.base y_q = q := by
          apply p_O.isOpenEmbedding.injective
          change (w_tilde_left ≫ p_O).base y_q = p_O.base q
          rw [hwt_pO, hy_q]
        exact ⟨W₀, w_tilde, y_q, ⟨𝟙 W₀, Category.id_comp w_tilde⟩, hEt_wt, h_eq_q⟩
      have hs_eq : ((pf_i.obj F_Z).obj.map f_O.op) s =
          η_Z.app (Opposite.op (B_i.obj O_et)) c₀ := by
        refine F_Z.isSeparated (B_i.obj O_et) R_wt hRwt_mem _ _ (fun Y_z g_arr ⟨h, hg⟩ => ?_)
        subst hg
        change (F_Z.obj.map (h ≫ w_tilde).op) ((F_Z.obj.map (B_i.map f_O).op) s) =
          (F_Z.obj.map (h ≫ w_tilde).op) (η_Z.app (Opposite.op (B_i.obj O_et)) c₀)
        rw [op_comp, F_Z.obj.map_comp]
        have hL : (F_Z.obj.map w_tilde.op) ((F_Z.obj.map (B_i.map f_O).op) s) =
            (F_Z.obj.map w₀.op) s := by
          change ((F_Z.obj.map (B_i.map f_O).op ≫ F_Z.obj.map w_tilde.op) s) = _
          rw [← F_Z.obj.map_comp, ← op_comp, hwt_comp]
        have hR : (F_Z.obj.map w_tilde.op) (η_Z.app (Opposite.op (B_i.obj O_et)) c₀) =
            η_Z.app (Opposite.op W₀) c₀ :=
          (congrArg (fun τ => τ c₀) (η_Z.naturality w_tilde.op)).symm
        exact congrArg (F_Z.obj.map h.op) (hL.trans (hc₀.symm.trans hR.symm))
      refine ⟨O_et, f_O, ⟨x, hx_Ox⟩, ?_, inferInstance, rfl⟩
      refine ⟨η_Y.app (Opposite.op O_et) c₀, ?_⟩
      change (u_i.hom.app (Opposite.op O_et)) (η_Y.app (Opposite.op O_et) c₀) =
        ((pf_i.obj F_Z).obj.map f_O.op) s
      rw [hu_app O_et c₀, hs_eq]
    · let O_x : E.left.Opens :=
        ⟨(Set.range i_E.base)ᶜ, i_E.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      have hEt_Ox : P_et (O_x.ι ≫ e_hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et O_x.ι e_hom inferInstance E.prop
      let O_et : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ e_hom) hEt_Ox
      let f_O : O_et ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl trivial
      have hEmp_O : IsEmpty ↥(B_i.obj O_et).left :=
        ⟨fun q => by
          let y' := (CategoryTheory.Limits.pullback.fst (O_x.ι ≫ e_hom) i).base q
          let z' := (CategoryTheory.Limits.pullback.snd (O_x.ι ≫ e_hom) i).base q
          have heq_yz : e_hom.base (O_x.ι.base y') = i.base z' :=
            congrArg (fun m => m.base q)
              (CategoryTheory.Limits.pullback.condition (f := O_x.ι ≫ e_hom) (g := i))
          obtain ⟨q_E, hq_E, -⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (O_x.ι.base y') z' heq_yz
          exact y'.2 ⟨q_E, hq_E⟩⟩
      have hSub_O := hEmptySub Z (B_i.obj O_et) hEmp_O F_Z
      refine ⟨O_et, f_O, ⟨x, hx⟩, ?_, inferInstance, rfl⟩
      exact ⟨0, hSub_O.elim _ _⟩

  
  have hEpi_ψ0 : CategoryTheory.Epi ψ_0 := by
    refine (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (A := AddCommGrpCat.{u}) ψ_0).mp ?_
    rw [← CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
    intro E t
    refine (hMemEtale Y.left E (CategoryTheory.Presheaf.imageSieve ψ_0.hom t)).mpr ?_
