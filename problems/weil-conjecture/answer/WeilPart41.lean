        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X : Polynomial k)))) ≫ j_inf) := by
    let η_T : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) := ⟨⊥, inferInstance⟩
