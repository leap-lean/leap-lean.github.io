      let Q_type : Type u := A ⧸ mSub
      have hQ_tors : ∀ q₀ : Q_type, m • q₀ = 0 := by
        intro q₀
        obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective q₀
        rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
        exact ⟨a, rfl⟩
      let instModR : Module R Q_type :=
        letI : Module (ZMod m) Q_type := AddCommGroup.zmodModule hQ_tors
        Module.compHom Q_type (ULift.ringEquiv : R ≃+* ZMod m).toRingHom
      let Q_obj : ModuleCat.{u, u} R := @ModuleCat.of R _ Q_type _ instModR
      let e_adj : ∀ M : ModuleCat.{u, u} R, (A ⟶ FgtMod.obj M) ≃ (Q_obj ⟶ M) := fun M =>
        { toFun := fun g =>
