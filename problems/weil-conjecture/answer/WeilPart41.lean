            MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩))) = Polynomial.C Q_pairs := by
      dsimp only [Q_pairs]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro j hj
      dsimp only [q_fn]
      simp only [hj, ↓reduceDIte]
