            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_n0.toRingHom)
            hom_inv_id := by
              change AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (2 * n)) K))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_n0.toRingHom) = 𝟙 _
              rw [← hsymm_n0, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              have hid : eq_n0.symm.toRingHom.comp eq_n0.toRingHom = RingHom.id _ :=
                RingHom.ext eq_n0.symm_apply_apply
              rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
            inv_hom_id := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom eq_n0.toRingHom) ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (2 * n)) K))) = 𝟙 _
              rw [← hsymm_n0, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              have hid : eq_n0.toRingHom.comp eq_n0.symm.toRingHom = RingHom.id _ :=
                RingHom.ext eq_n0.apply_symm_apply
