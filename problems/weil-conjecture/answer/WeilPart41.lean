  have hBasePB : ∀ {R₀ R₁ : Type u} [CommRing R₀] [CommRing R₁] (ρ : R₀ →+* R₁) (N : ℕ),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁) :=
        MvPolynomial.gradedAlgebra
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Proj.map (mapGraded ρ N) (h_irrel_map ρ N))
        (weilProjectiveSpaceOver R₁ N).hom
        (weilProjectiveSpaceOver R₀ N).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) := by
    intro R₀ R₁ _ _ ρ N
    let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀
    let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₁
    let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
    let g := mapGraded ρ N
    let hg_irr := h_irrel_map ρ N
    let π : AlgebraicGeometry.Proj 𝒜₁ ⟶ AlgebraicGeometry.Proj 𝒜₀ :=
      AlgebraicGeometry.Proj.map g hg_irr
    let p₀_hom : AlgebraicGeometry.Proj 𝒜₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜₀ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ ↥(𝒜₀ 0)))
    let p₁_hom : AlgebraicGeometry.Proj 𝒜₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ ↥(𝒜₁ 0)))
    let s : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
    have hComm : π ≫ p₀_hom = p₁_hom ≫ s :=
      hProjOverHom R₀ R₁ ρ N N g hg_irr (MvPolynomial.map_C ρ)
    change CategoryTheory.IsPullback π p₁_hom p₀_hom s
    have hPush : ∀ a : Fin (N + 1),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₀
                (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap R₀ ↥(𝒜₀ 0))))
          (CommRingCat.ofHom ρ)
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map g (MvPolynomial.X a)))
          (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
                (Submonoid.powers (g (MvPolynomial.X a)))).comp
              (algebraMap R₁ ↥(𝒜₁ 0)))) := by
      intro a
      let τ_a := {b : Fin (N + 1) // b ≠ a}
      let f_p : CommRingCat.of R₀ ⟶ CommRingCat.of (MvPolynomial τ_a R₀) :=
        CommRingCat.ofHom MvPolynomial.C
      let g_p : CommRingCat.of R₀ ⟶ CommRingCat.of R₁ :=
        CommRingCat.ofHom ρ
      let inl_p : CommRingCat.of (MvPolynomial τ_a R₀) ⟶ CommRingCat.of (MvPolynomial τ_a R₁) :=
        CommRingCat.ofHom (MvPolynomial.map ρ)
      let inr_p : CommRingCat.of R₁ ⟶ CommRingCat.of (MvPolynomial τ_a R₁) :=
        CommRingCat.ofHom MvPolynomial.C
      have hcomm_p : f_p ≫ inl_p = g_p ≫ inr_p := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        simp [f_p, g_p, inl_p, inr_p]
      let cocone_p : CategoryTheory.Limits.PushoutCocone f_p g_p :=
        CategoryTheory.Limits.PushoutCocone.mk inl_p inr_p hcomm_p
      have hColim_p : CategoryTheory.Limits.IsColimit cocone_p :=
