          τ₃ := adj_x0.unit.app 𝒢₂
          comm₁₂ := (adj_x0.unit.naturality SC_X.f).symm
          comm₂₃ := (adj_x0.unit.naturality SC_X.g).symm }
      have _ : CategoryTheory.IsIso τ.τ₁ := hIso₁
      have _ : CategoryTheory.IsIso τ.τ₃ := hIso₂
      have _ : CategoryTheory.Mono τ.τ₂ :=
        CategoryTheory.ShortComplex.mono_of_mono_of_mono_of_mono τ hSE_X.exact hSE_pf.mono_f
          inferInstance inferInstance
      have _ : CategoryTheory.Epi τ.τ₂ :=
        CategoryTheory.ShortComplex.epi_of_epi_of_epi_of_epi τ hSE_pf.exact hSE_X.epi_g
          inferInstance inferInstance
      exact CategoryTheory.isIso_of_mono_of_epi τ.τ₂

  obtain ⟨𝒢_U, ⟨hc_U', hr_U', ⟨e_GU⟩⟩, hZero_GU⟩ := hZeroU
  obtain rfl : hc_U' = @hc_all _ _ U.ι := Subsingleton.elim _ _
  obtain rfl : hr_U' = @hr_all _ _ U.ι := Subsingleton.elim _ _
  have hZero_pbU_𝒢 : CategoryTheory.Limits.IsZero (pb_U.obj 𝒢) := hZero_GU.of_iso e_GU
  have _ : CategoryTheory.IsIso (adj_x0.unit.app 𝒢) :=
    hUnitIso_tors s 𝒢 hTors hZero_pbU_𝒢

  
  
  
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_k := (CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Pℤ_X := (CategoryTheory.Functor.const (Opposite X.Etale)).obj Aℤ
  let Pℤ_k := (CategoryTheory.Functor.const (Opposite S_k.Etale)).obj Aℤ
  let η_sh_k := CategoryTheory.Functor.whiskerLeft B_x0.op
    ((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_k)
  let uℤ := ((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
    Pℤ_X (pf_x0.obj Fℤ_k)).symm η_sh_k
  let cℤ : pb_x0.obj Fℤ_X ⟶ Fℤ_k := (adj_x0.homEquiv Fℤ_X Fℤ_k).symm uℤ
  have _ : CategoryTheory.IsIso cℤ := hcℤ_iso
  let e_cℤ : pb_x0.obj Fℤ_X ≅ Fℤ_k := CategoryTheory.asIso cℤ
  let e_u : 𝒢 ≅ pf_x0.obj (pb_x0.obj 𝒢) := CategoryTheory.asIso (adj_x0.unit.app 𝒢)

  have hHomEquiv : ∀ (G_k : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u})
      (e_k : pb_x0.obj 𝒢 ≅ G_k),
      Nonempty (𝒢.H 0 ≃+ (Fℤ_k ⟶ G_k)) := by
    intro G_k e_k
    let E₁ : 𝒢.H 0 ≃+ (Fℤ_X ⟶ 𝒢) := CategoryTheory.Abelian.Ext.addEquiv₀
    let E₂ : (Fℤ_X ⟶ 𝒢) ≃+ (Fℤ_X ⟶ pf_x0.obj (pb_x0.obj 𝒢)) :=
      { toFun := fun f => f ≫ e_u.hom
        invFun := fun g => g ≫ e_u.inv
        left_inv := fun f => by simp only [CategoryTheory.Category.assoc, e_u.hom_inv_id,
          CategoryTheory.Category.comp_id]
        right_inv := fun g => by simp only [CategoryTheory.Category.assoc, e_u.inv_hom_id,
          CategoryTheory.Category.comp_id]
        map_add' := fun f₁ f₂ => CategoryTheory.Preadditive.add_comp _ _ _ _ _ _ }
    let E₃ : (Fℤ_X ⟶ pf_x0.obj (pb_x0.obj 𝒢)) ≃+ (pb_x0.obj Fℤ_X ⟶ pb_x0.obj 𝒢) :=
      { toFun := (adj_x0.homEquiv Fℤ_X (pb_x0.obj 𝒢)).symm
        invFun := adj_x0.homEquiv Fℤ_X (pb_x0.obj 𝒢)
        left_inv := (adj_x0.homEquiv Fℤ_X (pb_x0.obj 𝒢)).right_inv
        right_inv := (adj_x0.homEquiv Fℤ_X (pb_x0.obj 𝒢)).left_inv
        map_add' := fun g₁ g₂ => by
          rw [CategoryTheory.Adjunction.homEquiv_counit,
            CategoryTheory.Adjunction.homEquiv_counit,
            CategoryTheory.Adjunction.homEquiv_counit]
          change pb_x0.map (g₁ + g₂) ≫ adj_x0.counit.app (pb_x0.obj 𝒢) =
            pb_x0.map g₁ ≫ adj_x0.counit.app (pb_x0.obj 𝒢) +
              pb_x0.map g₂ ≫ adj_x0.counit.app (pb_x0.obj 𝒢)
          rw [pb_x0.map_add, CategoryTheory.Preadditive.add_comp] }
    let E₄ : (pb_x0.obj Fℤ_X ⟶ pb_x0.obj 𝒢) ≃+ (Fℤ_k ⟶ G_k) :=
      { toFun := fun h => e_cℤ.inv ≫ h ≫ e_k.hom
        invFun := fun m => e_cℤ.hom ≫ m ≫ e_k.inv
        left_inv := fun h => by
          simp only [CategoryTheory.Category.assoc, e_k.hom_inv_id,
            CategoryTheory.Category.comp_id, e_cℤ.hom_inv_id_assoc]
        right_inv := fun m => by
          simp only [CategoryTheory.Category.assoc, e_k.inv_hom_id,
            CategoryTheory.Category.comp_id, e_cℤ.inv_hom_id_assoc]
        map_add' := fun h₁ h₂ => by
          rw [CategoryTheory.Preadditive.add_comp, CategoryTheory.Preadditive.comp_add] }
    exact ⟨E₁.trans (E₂.trans (E₃.trans E₄))⟩

  refine ⟨?_, ?_⟩
  · intro _
    let G_k := pb_x0.obj 𝒢
    obtain ⟨e_hom⟩ := hHomEquiv G_k (CategoryTheory.Iso.refl G_k)
    have _ : Subsingleton (Fℤ_k ⟶ G_k) := e_hom.symm.toEquiv.subsingleton
    let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
    have hT_k : CategoryTheory.Limits.IsTerminal T_k := weilEtaleIdTerminalIsTerminal.{u} S_k
    let adj_const := CategoryTheory.constantSheafAdj S_k.smallEtaleTopology AddCommGrpCat.{u} hT_k
    have _ : Subsingleton (Aℤ ⟶ G_k.obj.obj (Opposite.op T_k)) :=
      (adj_const.homEquiv Aℤ G_k).symm.subsingleton
    have hApp0 : (CategoryTheory.CategoryStruct.id G_k).hom.app (Opposite.op T_k) = 0 := by
      apply AddCommGrpCat.ext
      intro m
      let φ_m : Aℤ ⟶ G_k.obj.obj (Opposite.op T_k) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
      have hφ0 : φ_m = 0 := Subsingleton.elim φ_m 0
      have hm1 : φ_m.hom (ULift.up (1 : ℤ)) = 0 := by
        rw [hφ0]
        rfl
      change m = 0
      exact (one_zsmul m).symm.trans hm1
    have hId_Gk : CategoryTheory.CategoryStruct.id G_k = 0 :=
      (weil_etale_algClosed_spec_unit_iso_and_stalk_colimit.{u} k).2.1
        (CategoryTheory.CategoryStruct.id G_k) hApp0
    have hId_pf : CategoryTheory.CategoryStruct.id (pf_x0.obj G_k) = 0 := by
      rw [← pf_x0.map_id, hId_Gk, pf_x0.map_zero]
    have hId_𝒢 : CategoryTheory.CategoryStruct.id 𝒢 = 0 := by
      calc CategoryTheory.CategoryStruct.id 𝒢
          = e_u.hom ≫ e_u.inv := e_u.hom_inv_id.symm
        _ = e_u.hom ≫ CategoryTheory.CategoryStruct.id (pf_x0.obj G_k) ≫ e_u.inv := by
            rw [CategoryTheory.Category.id_comp]
        _ = 0 := by
            rw [hId_pf, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    exact (CategoryTheory.Limits.IsZero.iff_id_eq_zero 𝒢).mpr hId_𝒢
  · intro G_k ⟨hc_k', hr_k', ⟨e_k⟩⟩
    obtain rfl : hc_k' = @hc_all _ _ x₀ := Subsingleton.elim _ _
    obtain rfl : hr_k' = @hr_all _ _ x₀ := Subsingleton.elim _ _
    obtain ⟨e_hom⟩ := hHomEquiv G_k e_k
    exact ⟨e_hom.trans (CategoryTheory.Abelian.Ext.addEquiv₀).symm⟩

theorem weil_iso_roof_coker_deg0_unit_iso_and_roof_transfer (k : Type u) [Field k]
    (m₀ : ℕ)
    (Z_R Q_R W_R : AlgebraicGeometry.Scheme.{u})
    (x_Z : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Z_R)
    (U_Z : Z_R.Opens) (hU_Z : (U_Z : Set Z_R) = (Set.range x_Z.base)ᶜ)
    (x_Q : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_R)
    (U_Q : Q_R.Opens) (hU_Q : (U_Q : Set Q_R) = (Set.range x_Q.base)ᶜ)
    (v_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_R)
    (e_W : W_R ⟶ Z_R) [AlgebraicGeometry.Etale e_W]
    (q_W : W_R ⟶ Q_R) [AlgebraicGeometry.Etale q_W]
    (hv_e : v_W ≫ e_W = x_Z)
    (hpre_e : e_W.base ⁻¹' (Set.range x_Z.base) = Set.range v_W.base)
    (hpre_q : q_W.base ⁻¹' (Set.range x_Q.base) = Set.range v_W.base)
    (hSkyZero_Q : ∀ 𝒢 : CategoryTheory.Sheaf Q_R.smallEtaleTopology AddCommGrpCat.{u},
      m₀ • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
      (∃ 𝒢_U : CategoryTheory.Sheaf U_Q.toScheme.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback U_Q.ι 𝒢 𝒢_U ∧ CategoryTheory.Limits.IsZero 𝒢_U) →
      Subsingleton (𝒢.H 0) → CategoryTheory.Limits.IsZero 𝒢)
    (p_Q0 : weilEtaleTorsionH Q_R m₀ 0 →+ weilEtaleTorsionH U_Q.toScheme m₀ 0)
    (hp_Q0 : WeilIsTorsionEtalePullback U_Q.ι m₀ 0 p_Q0)
    (hBij_Q0 : Function.Bijective p_Q0)
    (p_Q1 : weilEtaleTorsionH Q_R m₀ 1 →+ weilEtaleTorsionH U_Q.toScheme m₀ 1)
    (hp_Q1 : WeilIsTorsionEtalePullback U_Q.ι m₀ 1 p_Q1)
    (hInj_Q1 : Function.Injective p_Q1) :
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    (∀ [hc_Q : (weilEtaleSitePullback U_Q.ι).IsContinuous
          Q_R.smallEtaleTopology U_Q.toScheme.smallEtaleTopology]
       [hr_Q : ((weilEtaleSitePullback U_Q.ι).sheafPushforwardContinuous
          AddCommGrpCat.{u} Q_R.smallEtaleTopology U_Q.toScheme.smallEtaleTopology).IsRightAdjoint]
       {T_UQ : U_Q.toScheme.Etale} (hT_UQ : CategoryTheory.Limits.IsTerminal T_UQ)
       {T_QR : Q_R.Etale} (hT_QR : CategoryTheory.Limits.IsTerminal T_QR),
      let adj_Q := (weilEtaleSitePullback U_Q.ι).sheafAdjunctionContinuous
        AddCommGrpCat.{u} Q_R.smallEtaleTopology U_Q.toScheme.smallEtaleTopology
      CategoryTheory.IsIso
        ((adj_Q.homEquiv (weilEtaleTorsionSheaf Q_R m₀)
          (weilEtaleTorsionSheaf U_Q.toScheme m₀))
          (weilEtaleConstPullbackHom U_Q.ι hT_UQ hT_QR AM))) ∧
    (∀ [hc_Z : (weilEtaleSitePullback U_Z.ι).IsContinuous
          Z_R.smallEtaleTopology U_Z.toScheme.smallEtaleTopology]
       [hr_Z : ((weilEtaleSitePullback U_Z.ι).sheafPushforwardContinuous
          AddCommGrpCat.{u} Z_R.smallEtaleTopology U_Z.toScheme.smallEtaleTopology).IsRightAdjoint]
       {T_UZ : U_Z.toScheme.Etale} (hT_UZ : CategoryTheory.Limits.IsTerminal T_UZ)
       {T_ZR : Z_R.Etale} (hT_ZR : CategoryTheory.Limits.IsTerminal T_ZR),
      let adj_Z := (weilEtaleSitePullback U_Z.ι).sheafAdjunctionContinuous
        AddCommGrpCat.{u} Z_R.smallEtaleTopology U_Z.toScheme.smallEtaleTopology
      CategoryTheory.IsIso
        ((adj_Z.homEquiv (weilEtaleTorsionSheaf Z_R m₀)
          (weilEtaleTorsionSheaf U_Z.toScheme m₀))
          (weilEtaleConstPullbackHom U_Z.ι hT_UZ hT_ZR AM))) :=
by
  intro AM
  
  have hUnitCanonical : ∀ {U₀ X₀ : AlgebraicGeometry.Scheme.{u}} (f : U₀ ⟶ X₀)
      [hc : (weilEtaleSitePullback f).IsContinuous X₀.smallEtaleTopology U₀.smallEtaleTopology]
      [hr : ((weilEtaleSitePullback f).sheafPushforwardContinuous
        AddCommGrpCat.{u} X₀.smallEtaleTopology U₀.smallEtaleTopology).IsRightAdjoint]
      {T₁ : U₀.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : X₀.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      let B_f := weilEtaleSitePullback f
      let J_X := X₀.smallEtaleTopology
      let J_U := U₀.smallEtaleTopology
      let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
      let C_U := CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_U
      let adj_f := B_f.sheafAdjunctionContinuous AddCommGrpCat.{u} J_X J_U
      let P_X := (CategoryTheory.Functor.const (Opposite X₀.Etale)).obj A
      let P_U := (CategoryTheory.Functor.const (Opposite U₀.Etale)).obj A
      ((adj_f.homEquiv (C_X.obj A) (C_U.obj A)) (weilEtaleConstPullbackHom f hT₁ hT₂ A)) =
        ((CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).homEquiv
          P_X (pf_f.obj (C_U.obj A))).symm
          (CategoryTheory.Functor.whiskerLeft B_f.op
            ((CategoryTheory.sheafificationAdjunction J_U AddCommGrpCat.{u}).unit.app P_U)) := by
    intro U₀ X₀ f hc hr T₁ hT₁ T₂ hT₂ A B_f J_X J_U C_X C_U pf_f adj_f P_X P_U
    let adj₁ := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT₂
    let τ : B_f.obj T₂ ⟶ T₁ := hT₁.from (B_f.obj T₂)
    have hCancel : (adj_f.homEquiv (C_X.obj A) (C_U.obj A))
        (weilEtaleConstPullbackHom f hT₁ hT₂ A) =
        (adj₂.homEquiv A (pf_f.obj (C_U.obj A))).symm
          (adj₁.unit.app A ≫ (C_U.obj A).obj.map τ.op) := by
      dsimp [weilEtaleConstPullbackHom]
      exact (adj_f.homEquiv (C_X.obj A) (C_U.obj A)).apply_symm_apply _
    rw [hCancel]
    apply (adj₂.homEquiv A (pf_f.obj (C_U.obj A))).injective
    rw [(adj₂.homEquiv A (pf_f.obj (C_U.obj A))).apply_symm_apply]
    have hUnitV : ∀ {V : AlgebraicGeometry.Scheme.{u}} {T : V.Etale}
        (hT : CategoryTheory.Limits.IsTerminal T),
        (CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT).unit.app A =
          (((CategoryTheory.sheafificationAdjunction V.smallEtaleTopology
            AddCommGrpCat.{u}).unit.app
            ((CategoryTheory.Functor.const (Opposite V.Etale)).obj A)).app (Opposite.op T)) := by
      intro V T hT
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT).comp
        (CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u})).unit.app A = _
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT A,
        CategoryTheory.Category.id_comp]
      rfl
    let sh_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
    let sh_U := CategoryTheory.sheafificationAdjunction J_U AddCommGrpCat.{u}
    let u_A := (sh_X.homEquiv P_X (pf_f.obj (C_U.obj A))).symm
      (CategoryTheory.Functor.whiskerLeft B_f.op (sh_U.unit.app P_U))
    have hu_A : sh_X.unit.app P_X ≫ (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}).map u_A =
        CategoryTheory.Functor.whiskerLeft B_f.op (sh_U.unit.app P_U) :=
      (sh_X.homEquiv_unit P_X (pf_f.obj (C_U.obj A)) u_A).symm.trans
        ((sh_X.homEquiv P_X (pf_f.obj (C_U.obj A))).apply_symm_apply _)
    have hu_app : (sh_X.unit.app P_X).app (Opposite.op T₂) ≫ u_A.hom.app (Opposite.op T₂) =
        (sh_U.unit.app P_U).app (Opposite.op (B_f.obj T₂)) :=
      congrArg (fun α => α.app (Opposite.op T₂)) hu_A
    refine Eq.trans ?_ (adj₂.homEquiv_unit A (pf_f.obj (C_U.obj A)) u_A).symm
    have hLHS : adj₁.unit.app A ≫ (C_U.obj A).obj.map τ.op =
        (sh_U.unit.app P_U).app (Opposite.op T₁) ≫ (C_U.obj A).obj.map τ.op :=
      congrArg (· ≫ (C_U.obj A).obj.map τ.op) (hUnitV hT₁)
    have hRHS : (sh_X.unit.app P_X).app (Opposite.op T₂) ≫ u_A.hom.app (Opposite.op T₂) =
        adj₂.unit.app A ≫ ((CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj
          (Opposite.op T₂)).map u_A :=
      congrArg (· ≫ u_A.hom.app (Opposite.op T₂)) (hUnitV hT₂).symm
    have hNat := ((sh_U.unit.app P_U).naturality τ.op).symm
    dsimp [P_U] at hNat
    rw [CategoryTheory.Category.id_comp] at hNat
    exact hLHS.trans (hNat.trans (hu_app.symm.trans hRHS))

  
  have hOpenUnitIso : ∀ {U₀ X₀ : AlgebraicGeometry.Scheme.{u}} (u : U₀ ⟶ X₀)
      [AlgebraicGeometry.IsOpenImmersion u]
      (hSkyZero : ∀ 𝒢 : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u},
        m₀ • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
        (∃ 𝒢_U : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u},
          WeilIsEtaleSheafPullback u 𝒢 𝒢_U ∧ CategoryTheory.Limits.IsZero 𝒢_U) →
        Subsingleton (𝒢.H 0) → CategoryTheory.Limits.IsZero 𝒢)
      (p₀ : weilEtaleTorsionH X₀ m₀ 0 →+ weilEtaleTorsionH U₀ m₀ 0)
      (hp₀ : WeilIsTorsionEtalePullback u m₀ 0 p₀)
      (hBij₀ : Function.Bijective p₀)
      (p₁ : weilEtaleTorsionH X₀ m₀ 1 →+ weilEtaleTorsionH U₀ m₀ 1)
      (hp₁ : WeilIsTorsionEtalePullback u m₀ 1 p₁)
      (hInj₁ : Function.Injective p₁)
      [hc : (weilEtaleSitePullback u).IsContinuous X₀.smallEtaleTopology U₀.smallEtaleTopology]
      [hr : ((weilEtaleSitePullback u).sheafPushforwardContinuous
        AddCommGrpCat.{u} X₀.smallEtaleTopology U₀.smallEtaleTopology).IsRightAdjoint]
      {T_U : U₀.Etale} (hT_U : CategoryTheory.Limits.IsTerminal T_U)
      {T_X : X₀.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X),
      let adj_u := (weilEtaleSitePullback u).sheafAdjunctionContinuous
        AddCommGrpCat.{u} X₀.smallEtaleTopology U₀.smallEtaleTopology
      CategoryTheory.IsIso
        ((adj_u.homEquiv (weilEtaleTorsionSheaf X₀ m₀) (weilEtaleTorsionSheaf U₀ m₀))
          (weilEtaleConstPullbackHom u hT_U hT_X AM)) := by
    intro U₀ X₀ u _ hSkyZero p₀ hp₀ hBij₀ p₁ hp₁ hInj₁ hc hr T_U hT_U T_X hT_X adj_u
    let B_u : CategoryTheory.Functor X₀.Etale U₀.Etale := weilEtaleSitePullback u
    let FgtU := AlgebraicGeometry.Scheme.Etale.forget U₀
    let FgtX := AlgebraicGeometry.Scheme.Etale.forget X₀
    let J_X := X₀.smallEtaleTopology
    let J_U := U₀.smallEtaleTopology
    let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
    let C_U := CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}
    let pf_u := B_u.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_U
    let pb_u := B_u.sheafPullback AddCommGrpCat.{u} J_X J_U
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let η_u : C_X.obj AM ⟶ pf_u.obj (C_U.obj AM) :=
      (adj_u.homEquiv (C_X.obj AM) (C_U.obj AM)) (weilEtaleConstPullbackHom u hT_U hT_X AM)
    let M_obj : U₀.Etale → X₀.Etale := fun W =>
      letI : AlgebraicGeometry.Etale (FgtU.obj W).hom := W.prop
      CategoryTheory.MorphismProperty.Over.mk ⊤ ((FgtU.obj W).hom ≫ u) inferInstance
    let M_map : ∀ {W₁ W₂ : U₀.Etale}, (W₁ ⟶ W₂) → (M_obj W₁ ⟶ M_obj W₂) := fun f =>
      CategoryTheory.MorphismProperty.Over.homMk (FgtU.map f).left
        ((CategoryTheory.Category.assoc (FgtU.map f).left _ u).symm.trans
          (congrArg (· ≫ u) (FgtU.map f).w))
    
    have hTerm_BT : CategoryTheory.Limits.IsTerminal (B_u.obj T_X) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W =>
          let g : M_obj W ⟶ T_X := hT_X.from (M_obj W)
          CategoryTheory.MorphismProperty.Over.homMk
