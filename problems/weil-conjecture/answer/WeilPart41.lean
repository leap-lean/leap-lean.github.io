        CategoryTheory.Limits.pullback.fst j (W α).ι ≫ μ) :
    ∃ (hc_i : (weilEtaleSitePullback i).IsContinuous
        Y.left.smallEtaleTopology Z.smallEtaleTopology),
      letI := hc_i
      let pf_i := (weilEtaleSitePullback i).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.left.smallEtaleTopology Z.smallEtaleTopology
      Nonempty (weilEtaleTorsionSheaf Y.left ℓ ≅
        weilEtaleHigherDirectImage j 0 (weilEtaleTorsionSheaf U ℓ)) ∧
      Nonempty (pf_i.obj (weilEtaleTorsionSheaf Z ℓ) ≅
        weilEtaleHigherDirectImage j 1 (weilEtaleTorsionSheaf U ℓ)) ∧
      (∀ b : ℕ, 2 ≤ b →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ))) ∧
      (∀ (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G = 0 →
        ∀ b : ℕ, 1 ≤ b →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage i b G)) ∧
      (∃ ξ_tilde : weilEtaleTorsionH U ℓ 1,
        ∀ (Ω' : Type u) [Field Ω'] [IsAlgClosed Ω']
          (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ Y.left),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω')),
            z_bar.base pt ∉ Set.range j.base) →
          ∀ (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
