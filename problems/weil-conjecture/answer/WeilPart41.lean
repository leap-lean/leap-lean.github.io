              dsimp [R_box]
              ring_nf
            rw [hRewrite, hSumR0, map_zero]
          exact (mul_eq_zero.mp hMul0).resolve_right (pow_ne_zero _ hP0_rf_ne)
        intro hbot
        rw [hbot, Ideal.mem_bot] at hG_ker
        exact hG_ne hG_ker
      · obtain ⟨b₁, hb₁_not⟩ := Infinite.exists_notMem_finset P₀.roots.toFinset
        obtain ⟨b₂, hb₂_not⟩ := Infinite.exists_notMem_finset (insert b₁ P₀.roots.toFinset)
        have hb₁_eval : P₀.eval b₁ ≠ 0 := by
          intro h0
          apply hb₁_not
          rw [Multiset.mem_toFinset, Polynomial.mem_roots hP₀_ne]
          exact h0
        have hb₂_ne_b₁ : b₂ ≠ b₁ := by
          intro heq
          exact hb₂_not (Finset.mem_insert.mpr (Or.inl heq))
        have hb₂_eval : P₀.eval b₂ ≠ 0 := by
          intro h0
          apply hb₂_not
          rw [Finset.mem_insert]
          right
          rw [Multiset.mem_toFinset, Polynomial.mem_roots hP₀_ne]
          exact h0
        let p₁ : Fin 2 → k := ![P₁.eval b₁ / P₀.eval b₁, P₂.eval b₁ / P₀.eval b₁]
        let p₂ : Fin 2 → k := ![P₁.eval b₂ / P₀.eval b₂, P₂.eval b₂ / P₀.eval b₂]
        have hKerSub : ∀ (b : k), P₀.eval b ≠ 0 →
            RingHom.ker θ₀.toRingHom ≤
