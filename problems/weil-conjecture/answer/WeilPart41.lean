              HomogeneousLocalization.Away.mk ℬ_K hf₀ n (ψ_K x) hψx) →
        ((TopologicalSpace.Opens.map Λ_K.base).obj (weilProjBasicOpen K (M + 1) 1) =
          weilProjBasicOpen K M 0 ∧
          ∃ χ₁ : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X 1) →+*
              HomogeneousLocalization.Away ℬ_K (MvPolynomial.X 0),
            AlgebraicGeometry.Proj.awayι ℬ_K (MvPolynomial.X 0)
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
              zero_lt_one ≫ Λ_K =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ₁) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X 1)
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X K 1)) zero_lt_one ∧
            ∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) K)
              (hx : x ∈ 𝒜_K (n • 1)) (hψx : ψ_K x ∈ ℬ_K (n • 1)),
              χ₁ (HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 1))
                n x hx) =
              HomogeneousLocalization.Away.mk ℬ_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
                n (ψ_K x) hψx) →
        (∀ a : Fin M,
          (TopologicalSpace.Opens.map Λ_K.base).obj (weilProjBasicOpen K (M + 1) a.succ.succ) =
            weilProjBasicOpen K M a.succ ∧
          ∃ χ_a : HomogeneousLocalization.Away 𝒜_K (MvPolynomial.X a.succ.succ) →+*
              HomogeneousLocalization.Away ℬ_K (MvPolynomial.X a.succ),
            AlgebraicGeometry.Proj.awayι ℬ_K (MvPolynomial.X a.succ)
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                (MvPolynomial.isHomogeneous_X K a.succ)) zero_lt_one ≫ Λ_K =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_a) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_K (MvPolynomial.X a.succ.succ)
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X K a.succ.succ)) zero_lt_one ∧
            ∀ (n : ℕ) (x : MvPolynomial (Fin (M + 1 + 1)) K)
              (hx : x ∈ 𝒜_K (n • 1)) (hψx : ψ_K x ∈ ℬ_K (n • 1)),
              χ_a (HomogeneousLocalization.Away.mk 𝒜_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                  (MvPolynomial.isHomogeneous_X K a.succ.succ)) n x hx) =
              HomogeneousLocalization.Away.mk ℬ_K
                ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                  (MvPolynomial.isHomogeneous_X K a.succ)) n (ψ_K x) hψx) →
        ∃ e_slice : H_K.left ≅ CategoryTheory.Limits.pullback ι_K Λ_K,
          e_slice.hom ≫ CategoryTheory.Limits.pullback.fst ι_K Λ_K = i_H.left) ∧
    (∀ (k R : Type u) [Field k] [CommRing R] (c_R : k →+* R) (d₀ : ℕ) (t_R : R), 1 ≤ d₀ →
      let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (M + 1 + 1)) k
      let ℬ_R := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R
      letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra ℬ_R := MvPolynomial.gradedAlgebra
      let v_R : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) R :=
        Fin.cases (-MvPolynomial.C t_R * MvPolynomial.X 0)
