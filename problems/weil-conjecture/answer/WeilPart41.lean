      obtain ⟨φ₁, hφ₁_eq⟩ := hResFac k pt_k X (g_sec.base pt_F) f₁ hf₁_pt
      obtain ⟨φ₂, hφ₂_eq⟩ := hResFac k pt_k X (g_sec.base pt_F) f₂ hf₂_pt
      let i_hom : CommRingCat.of F ⟶ X.residueField (g_sec.base pt_F) :=
