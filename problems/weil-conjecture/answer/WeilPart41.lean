      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT

    · 
      intro n u_bar_last D_n j_n V_n
      have hj_open : AlgebraicGeometry.IsOpenImmersion j_n :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization u_bar_last
      refine ⟨hj_open, ?_⟩
      let v_bar_last : MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1) :=
        Ideal.Quotient.mk (I_k (n + 1)) (MvPolynomial.X (Sum.inr (Fin.last n, 1)))
      let q_var :
          Fin 1 ⊕ (Fin (n + 1) × Fin 2) →
            Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n) :=
        Sum.elim
          (fun _ => Polynomial.C (Ideal.Quotient.mk (I_k n) (MvPolynomial.X (Sum.inl 0))))
          (fun jb =>
            Fin.lastCases
              (fun b => Fin.cases 0 (fun _ => Polynomial.X) b)
              (fun j₀ b =>
                Polynomial.C (Ideal.Quotient.mk (I_k n) (MvPolynomial.X (Sum.inr (j₀, b)))))
              jb.1 jb.2)
      let c_q : Ω →+* Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n) :=
        { toFun := fun c => Polynomial.C (Ideal.Quotient.mk (I_k n) (MvPolynomial.C c))
          map_one' := by simp
          map_mul' := fun x y => by simp
          map_zero' := by simp
          map_add' := fun x y => by simp }
      let q_pre :
          MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω →+*
            Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n) :=
        MvPolynomial.eval₂Hom c_q q_var
      have hq_ker : I_k (n + 1) ≤ RingHom.ker q_pre := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        have hgen_n : Ideal.Quotient.mk (I_k n)
            (((1 - MvPolynomial.C c_0 *
              (MvPolynomial.X (Sum.inl 0) :
                MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω)) *
                MvPolynomial.X (Sum.inl 0) +
              ∑ j : Fin n,
                (MvPolynomial.X (Sum.inr (j, 0)) :
                  MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω) *
                  MvPolynomial.X (Sum.inr (j, 1)))) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [Fin.sum_univ_castSucc]
        simp only [q_pre, c_q, q_var, map_add, map_mul, map_sub, map_one, map_sum,
          MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', Sum.elim_inl, Sum.elim_inr,
          Fin.lastCases_castSucc, Fin.lastCases_last, Fin.cases_zero, zero_mul, add_zero]
        have hC := congrArg
          (Polynomial.C :
            (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n) →+*
              Polynomial (MvPolynomial (Fin 1 ⊕ (Fin n × Fin 2)) Ω ⧸ I_k n)) hgen_n
        simp only [map_add, map_mul, map_sub, map_one, map_sum, Polynomial.C_0] at hC
        exact hC
      let q_n := Ideal.Quotient.lift (I_k (n + 1)) q_pre (fun _ hx => hq_ker hx)
      let J_u : Ideal (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)) :=
        Ideal.span {u_bar_last}
      have hJu_le : J_u ≤ RingHom.ker q_n := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        change q_pre (MvPolynomial.X (Sum.inr (Fin.last n, 0))) = 0
        simp [q_pre, q_var]
      let q_bar := Ideal.Quotient.lift J_u q_n (fun _ hx => hJu_le hx)
      let mk_u :
          (MvPolynomial (Fin 1 ⊕ (Fin (n + 1) × Fin 2)) Ω ⧸ I_k (n + 1)) →+*
