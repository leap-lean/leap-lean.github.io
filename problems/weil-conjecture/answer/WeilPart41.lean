          trivial
      let τ_inv : U₀_et ⟶ Sigma_U₀.obj T_U :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 U₀.toScheme)
          ((CategoryTheory.Category.id_comp _).trans
            (CategoryTheory.Category.id_comp U₀.ι).symm)
          trivial
      have hτ_hi : τ_hom ≫ τ_inv = 𝟙 (Sigma_U₀.obj T_U) :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
      have hτ_ih : τ_inv ≫ τ_hom = 𝟙 U₀_et :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
      let δ_U₀ : Fℤ_U₀ ⟶ R_sh.obj Z₀ :=
        (adj_U.homEquiv Aℤ (R_sh.obj Z₀)).symm
          (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 Z₀) ≫ Z₀.obj.map τ_hom.op)
      have hδ_eval : ∀ {𝒢 : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}} (f : Z₀ ⟶ 𝒢),
          (adj_U.homEquiv Aℤ (R_sh.obj 𝒢)) (δ_U₀ ≫ R_sh.map f) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv f ≫ 𝒢.obj.map τ_hom.op := by
        intro 𝒢 f
        have hfy : CategoryTheory.Sheaf.freeYonedaHomEquiv f =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 Z₀) ≫ f.hom.app (Opposite.op U₀_et) :=
          (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.Category.id_comp f).symm).trans
            ((congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
              ((CategoryTheory.sheafificationAdjunction J_S
                AddCommGrpCat.{u}).homEquiv_naturality_right (𝟙 Z₀) f)).trans
              (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _))
        have hnat : Z₀.obj.map τ_hom.op ≫ f.hom.app (Opposite.op (Sigma_U₀.obj T_U)) =
            f.hom.app (Opposite.op U₀_et) ≫ 𝒢.obj.map τ_hom.op :=
          f.hom.naturality τ_hom.op
        have hstep1 : (adj_U.homEquiv Aℤ (R_sh.obj 𝒢)) (δ_U₀ ≫ R_sh.map f) =
            (adj_U.homEquiv Aℤ (R_sh.obj Z₀)) δ_U₀ ≫
              f.hom.app (Opposite.op (Sigma_U₀.obj T_U)) :=
          adj_U.homEquiv_naturality_right δ_U₀ (R_sh.map f)
        have hstep2 : (adj_U.homEquiv Aℤ (R_sh.obj Z₀)) δ_U₀ =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 Z₀) ≫ Z₀.obj.map τ_hom.op :=
          (adj_U.homEquiv Aℤ (R_sh.obj Z₀)).apply_symm_apply _
        exact hstep1.trans
          ((congrArg (· ≫ f.hom.app (Opposite.op (Sigma_U₀.obj T_U))) hstep2).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg _ hnat).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ 𝒢.obj.map τ_hom.op) hfy.symm)))))
      refine ⟨δ_U₀, ?_, ?_⟩
      · intro 𝒢
        let postIso : (Aℤ ⟶ 𝒢.obj.obj (Opposite.op U₀_et)) ≃
            (Aℤ ⟶ 𝒢.obj.obj (Opposite.op (Sigma_U₀.obj T_U))) :=
          { toFun := fun ψ => ψ ≫ 𝒢.obj.map τ_hom.op
            invFun := fun ψ => ψ ≫ 𝒢.obj.map τ_inv.op
            left_inv := fun ψ => by
              dsimp only
              rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
                hτ_ih, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id]
            right_inv := fun ψ => by
              dsimp only
              rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
                hτ_hi, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id] }
        let totEquiv : (Z₀ ⟶ 𝒢) ≃ (Fℤ_U₀ ⟶ R_sh.obj 𝒢) :=
          CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
            (postIso.trans (adj_U.homEquiv Aℤ (R_sh.obj 𝒢)).symm)
        have hEq : (fun f : Z₀ ⟶ 𝒢 => δ_U₀ ≫ R_sh.map f) = totEquiv := by
          funext f
          apply (adj_U.homEquiv Aℤ (R_sh.obj 𝒢)).injective
          exact (hδ_eval f).trans ((adj_U.homEquiv Aℤ (R_sh.obj 𝒢)).apply_symm_apply _).symm
        rw [hEq]
        exact totEquiv.bijective
      · apply (adj_U.homEquiv Aℤ (R_sh.obj Fℤ_S)).injective
        let η_const := (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S
        have hκ_eval : CategoryTheory.Sheaf.freeYonedaHomEquiv κ₀ = η_const.app (Opposite.op U₀_et) :=
          CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
        have hα_eval : (adj_U.homEquiv Aℤ (R_sh.obj Fℤ_S)) αℤ =
            adj_S.unit.app Aℤ ≫ Fℤ_S.obj.map (hT_S.from (Sigma_U₀.obj T_U)).op :=
          (adj_U.homEquiv Aℤ (R_sh.obj Fℤ_S)).apply_symm_apply _
        have hL : η_const.app (Opposite.op U₀_et) ≫ Fℤ_S.obj.map τ_hom.op =
            η_const.app (Opposite.op (Sigma_U₀.obj T_U)) := by
          have hn := η_const.naturality τ_hom.op
          dsimp [Pℤ_S] at hn
          rw [CategoryTheory.Category.id_comp] at hn
          exact hn.symm
        have hunit₂ : adj_S.unit.app Aℤ = η_const.app (Opposite.op T_S) := by
          dsimp [adj_S, CategoryTheory.constantSheafAdj]
          rw [CategoryTheory.Adjunction.comp_unit_app,
            CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
          rfl
        have hR : adj_S.unit.app Aℤ ≫ Fℤ_S.obj.map (hT_S.from (Sigma_U₀.obj T_U)).op =
            η_const.app (Opposite.op (Sigma_U₀.obj T_U)) := by
          have hn := η_const.naturality (hT_S.from (Sigma_U₀.obj T_U)).op
          dsimp [Pℤ_S] at hn
          rw [CategoryTheory.Category.id_comp] at hn
          exact (congrArg (· ≫ Fℤ_S.obj.map (hT_S.from (Sigma_U₀.obj T_U)).op) hunit₂).trans hn.symm
        exact (hδ_eval κ₀).trans
          ((congrArg (· ≫ Fℤ_S.obj.map τ_hom.op) hκ_eval).trans
            (hL.trans (hR.symm.trans hα_eval.symm)))

    let adj'_U := CategoryTheory.constantSheafAdj J_U₀ AddCommGrpCat.{u} hT'_U
    let adj'_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT'_S
    let πℤ : P_pull₀.obj Fℤ_S ⟶ Fℤ_U₀ :=
      (adj_pull₀.homEquiv Fℤ_S Fℤ_U₀).symm
        ((adj'_S.homEquiv Aℤ (P_push₀.obj Fℤ_U₀)).symm
          (adj'_U.unit.app Aℤ ≫ Fℤ_U₀.obj.map (hT'_U.from (B₀.obj T'_S)).op))
    let πM : P_pull₀.obj FM_S ⟶ FM_U₀ :=
      (adj_pull₀.homEquiv FM_S FM_U₀).symm
        ((adj'_S.homEquiv AM (P_push₀.obj FM_U₀)).symm
          (adj'_U.unit.app AM ≫ FM_U₀.obj.map (hT'_U.from (B₀.obj T'_S)).op))
    let ψM : R_sh.obj FM_S ⟶ FM_U₀ := e_RP.inv.app FM_S ≫ πM

    have hαℤ_inv : αℤ ≫ e_RP.inv.app Fℤ_S = ιℤ := by
      have h1 : αℤ ≫ (e_RP.inv.app Fℤ_S ≫ πℤ) = 𝟙 Fℤ_U₀ := hLeftInv hT'_U hT'_S Aℤ
      have h2 : πℤ ≫ ιℤ = 𝟙 (P_pull₀.obj Fℤ_S) := hπι
      calc
        αℤ ≫ e_RP.inv.app Fℤ_S
            = αℤ ≫ e_RP.inv.app Fℤ_S ≫ 𝟙 (P_pull₀.obj Fℤ_S) :=
              (CategoryTheory.Category.comp_id _).symm
        _ = αℤ ≫ e_RP.inv.app Fℤ_S ≫ (πℤ ≫ ιℤ) := by rw [h2]
        _ = (αℤ ≫ (e_RP.inv.app Fℤ_S ≫ πℤ)) ≫ ιℤ := by
              simp only [CategoryTheory.Category.assoc]
        _ = 𝟙 Fℤ_U₀ ≫ ιℤ := by rw [h1]
        _ = ιℤ := CategoryTheory.Category.id_comp _

    have hαM_ψM : αM ≫ ψM = 𝟙 FM_U₀ := hLeftInv hT'_U hT'_S AM

    obtain ⟨δ_U₀, hδ_bij0, hδ_κ⟩ := hFreeYonedaUnit
    obtain ⟨hExtIso, hExtBij⟩ := hExtEngine
    let Γ_U₀ : CategoryTheory.Abelian.Ext.{u} Z₀ FM_S q →+
        CategoryTheory.Abelian.Ext.{u} Fℤ_U₀ (R_sh.obj FM_S) q :=
      ((CategoryTheory.Abelian.Ext.mk₀ δ_U₀).precomp (R_sh.obj FM_S) (Nat.zero_add q)).comp
        (R_sh.mapExtAddHom Z₀ FM_S q)
    have hΓ_bij : Function.Bijective Γ_U₀ :=
      hExtBij R_sh Z₀ Fℤ_U₀ δ_U₀ hδ_bij0
        (fun ℐ _ m ω => by
          have : CategoryTheory.Injective (R_sh.obj ℐ) := hInj_R ℐ
          exact CategoryTheory.Abelian.Ext.eq_zero_of_injective ω)
        FM_S q

    let w₀ : CategoryTheory.Abelian.Ext.{u} Fℤ_U₀ (R_sh.obj FM_S) q :=
      y₀.comp (CategoryTheory.Abelian.Ext.mk₀ αM) (Nat.add_zero q)
    obtain ⟨z₀, hz₀⟩ := hΓ_bij.2 w₀
    refine ⟨z₀, fun x hx => ?_⟩
    have hΓx : Γ_U₀ ((CategoryTheory.Abelian.Ext.mk₀ κ₀).comp x (Nat.zero_add q)) = w₀ :=
      (congrArg Γ_U₀ hx).trans hz₀
    change (CategoryTheory.Abelian.Ext.mk₀ δ_U₀).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor R_sh
          ((CategoryTheory.Abelian.Ext.mk₀ κ₀).comp x (Nat.zero_add q)))
        (Nat.zero_add q) = w₀ at hΓx
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hδ_κ] at hΓx
    have hpost := congrArg
      (fun t => t.comp (CategoryTheory.Abelian.Ext.mk₀ ψM) (Nat.add_zero q)) hΓx
    have hRHS : w₀.comp (CategoryTheory.Abelian.Ext.mk₀ ψM) (Nat.add_zero q) = y₀ := by
      dsimp only [w₀]
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαM_ψM,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have hLHS :
        ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor R_sh x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ψM) (Nat.add_zero q) = p₀ x := by
      let px := CategoryTheory.Abelian.Ext.mapExactFunctor P_pull₀ x
      have hiso := hExtIso e_RP q x
      change _ = CategoryTheory.Abelian.Ext.mapExactFunctor R_sh x at hiso
      dsimp only [ψM]
      rw [← hiso,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ αℤ)
          (CategoryTheory.Abelian.Ext.mk₀ (e_RP.inv.app Fℤ_S))
          (px.comp (CategoryTheory.Abelian.Ext.mk₀ (e_RP.hom.app FM_S)) (Nat.add_zero q))
          (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαℤ_inv,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ) px
          (CategoryTheory.Abelian.Ext.mk₀ (e_RP.hom.app FM_S)) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp px (Nat.zero_add q))
          (CategoryTheory.Abelian.Ext.mk₀ (e_RP.hom.app FM_S))
          (CategoryTheory.Abelian.Ext.mk₀ (e_RP.inv.app FM_S ≫ πM)) (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Category.assoc, e_RP.hom_inv_id_app FM_S,
        CategoryTheory.Category.id_comp]
      exact (hp₀_eq x).symm
    exact hLHS.symm.trans (hpost.trans hRHS)

  · 
    intro U₁ hInf p₁ hp₁ σ z₀
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) U₁.ι :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) U₁.ι :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B₁ : S.Etale ⥤ U₁.toScheme.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ U₁.ι
    let J₁ := U₁.toScheme.smallEtaleTopology
    rcases hp₁ with ⟨hc₁, hr₁, hAdd₁, hLim₁, hColim₁, _T'₁, _hT'₁, _T'_S, _hT'_S,
      _ιℤ₁, _hιπ₁, _hπι₁, hp₁_eq⟩
    letI : B₁.IsContinuous J_S J₁ := hc₁
    let P_push₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J₁
    letI : P_push₁.IsRightAdjoint := hr₁
    let P_pull₁ := B₁.sheafPullback AddCommGrpCat.{u} J_S J₁
    let adj_pull₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} J_S J₁
    letI : P_pull₁.Additive := hAdd₁
    letI : CategoryTheory.Limits.PreservesFiniteLimits P_pull₁ := hLim₁
    letI : CategoryTheory.Limits.PreservesFiniteColimits P_pull₁ := hColim₁

    have hZero_Z₀ : CategoryTheory.Limits.IsZero (P_pull₁.obj Z₀) := by
      let W : U₁.toScheme.Etale := B₁.obj U₀_et
      let hh₁ : AlgebraicGeometry.Etale U₁.ι := inferInstance
      have hEmpty : IsEmpty ↥W.left := by
        have : CategoryTheory.MorphismProperty.IsStableUnderComposition
            (@AlgebraicGeometry.Etale) :=
          ⟨fun _ _ _ _ => inferInstance⟩
        letI : CategoryTheory.Category.{u, u + 1}
            (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale) ⊤ U₁.toScheme) :=
          (inferInstance : CategoryTheory.Category U₁.toScheme.Etale)
        letI : CategoryTheory.Category.{u, u + 1}
            (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale) ⊤ S) :=
          (inferInstance : CategoryTheory.Category S.Etale)
        let ε := (CategoryTheory.MorphismProperty.Over.mapPullbackAdj
          (@AlgebraicGeometry.Etale) ⊤ U₁.ι hh₁ trivial).counit.app U₀_et
        have hε_w : ε.left ≫ U₀.ι = W.hom ≫ U₁.ι :=
          CategoryTheory.MorphismProperty.Over.w ε
        refine ⟨fun w => ?_⟩
        let s : ↥S := (W.hom ≫ U₁.ι).base w
        have hs₁ : s ∈ (U₁ : Set ↥S) := by
          have h1 : s = U₁.ι.base (W.hom.base w) :=
            AlgebraicGeometry.Scheme.Hom.comp_apply W.hom U₁.ι w
          rw [h1, ← AlgebraicGeometry.Scheme.Opens.range_ι U₁]
          exact ⟨W.hom.base w, rfl⟩
        have hs₀ : s ∈ (U₀ : Set ↥S) := by
          have h0 : s = (ε.left ≫ U₀.ι).base w := congrArg (fun g => g.base w) hε_w.symm
          have h0' : (ε.left ≫ U₀.ι).base w = U₀.ι.base (ε.left.base w) :=
            AlgebraicGeometry.Scheme.Hom.comp_apply ε.left U₀.ι w
          rw [h0, h0', ← AlgebraicGeometry.Scheme.Opens.range_ι U₀]
          exact ⟨ε.left.base w, rfl⟩
        have hs_inf : s ∈ ((U₀ ⊓ U₁ : S.Opens) : Set ↥S) := ⟨hs₀, hs₁⟩
        rw [hInf] at hs_inf
        exact hs_inf
      have hbot : (⊥ : CategoryTheory.Sieve W) ∈ J₁ W := by
        let botW : CategoryTheory.Sieve W := ⊥
        change botW ∈ J₁ W
        have : CategoryTheory.MorphismProperty.IsStableUnderComposition
            (@AlgebraicGeometry.Etale) :=
          ⟨fun _ _ _ _ => inferInstance⟩
        letI : CategoryTheory.Category.{u, u + 1}
            (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale) ⊤ U₁.toScheme) :=
          (inferInstance : CategoryTheory.Category U₁.toScheme.Etale)
        have htop :=
          AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            U₁.toScheme (le_refl (@AlgebraicGeometry.Etale))
        refine Eq.mpr (congrArg (fun J => botW ∈ J W) htop) ?_
        exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) W botW).mpr
          (fun x => IsEmpty.elim hEmpty x)
      let ℋ₀ := P_pull₁.obj Z₀
      have hTerm : CategoryTheory.Limits.IsTerminal (ℋ₀.obj.obj (Opposite.op W)) :=
        CategoryTheory.Sheaf.isTerminalOfBotCover ℋ₀ W hbot
      refine (CategoryTheory.Limits.IsZero.iff_id_eq_zero ℋ₀).mpr ?_
      apply (adj_pull₁.homEquiv Z₀ ℋ₀).injective
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      exact hTerm.hom_ext _ _

    have hσ_zero : P_pull₁.map σ = 0 := hZero_Z₀.eq_of_tgt (P_pull₁.map σ) 0
    have hmap_zero :
        (P_pull₁.mapExtAddHom Fℤ_S FM_S q)
          ((CategoryTheory.Abelian.Ext.mk₀ σ).comp z₀ (Nat.zero_add q)) = 0 := by
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        hσ_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.zero_comp]
    rw [hp₁_eq ((CategoryTheory.Abelian.Ext.mk₀ σ).comp z₀ (Nat.zero_add q)),
      hmap_zero, CategoryTheory.Abelian.Ext.comp_zero, map_zero]

theorem weil_quad_cvs_pullback_cup_clopen_and_point_modif_split : (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (n i j c : ℕ) (hc : i + j = c)
      (p_i : weilEtaleTorsionH S₂ n i →+ weilEtaleTorsionH S₁ n i)
      (p_j : weilEtaleTorsionH S₂ n j →+ weilEtaleTorsionH S₁ n j)
      (p_c : weilEtaleTorsionH S₂ n c →+ weilEtaleTorsionH S₁ n c)
      (θ_i1 : weilEtaleModuleH S₁ n i →+ weilEtaleTorsionH S₁ n i)
      (θ_i2 : weilEtaleModuleH S₂ n i →+ weilEtaleTorsionH S₂ n i)
      (θ_j1 : weilEtaleModuleH S₁ n j →+ weilEtaleTorsionH S₁ n j)
      (θ_j2 : weilEtaleModuleH S₂ n j →+ weilEtaleTorsionH S₂ n j)
      (θ_c1 : weilEtaleModuleH S₁ n c →+ weilEtaleTorsionH S₁ n c)
      (θ_c2 : weilEtaleModuleH S₂ n c →+ weilEtaleTorsionH S₂ n c),
      WeilIsTorsionEtalePullback h n i p_i →
      WeilIsTorsionEtalePullback h n j p_j →
      WeilIsTorsionEtalePullback h n c p_c →
      WeilIsModuleToTorsionComparison S₁ n i θ_i1 →
      WeilIsModuleToTorsionComparison S₂ n i θ_i2 →
      WeilIsModuleToTorsionComparison S₁ n j θ_j1 →
      WeilIsModuleToTorsionComparison S₂ n j θ_j2 →
      WeilIsModuleToTorsionComparison S₁ n c θ_c1 →
      WeilIsModuleToTorsionComparison S₂ n c θ_c2 →
      ∀ (a : weilEtaleModuleH S₂ n i) (b : weilEtaleModuleH S₂ n j)
        (a' : weilEtaleModuleH S₁ n i) (b' : weilEtaleModuleH S₁ n j),
        p_i (θ_i2 a) = θ_i1 a' →
        p_j (θ_j2 b) = θ_j1 b' →
        p_c (θ_c2 (CategoryTheory.Abelian.Ext.comp a b hc)) =
          θ_c1 (CategoryTheory.Abelian.Ext.comp a' b' hc)) ∧
    (∀ (S : AlgebraicGeometry.Scheme.{u}) (U₀ U₁ : S.Opens),
      U₀ ⊓ U₁ = ⊥ →
      U₀ ⊔ U₁ = ⊤ →
      ∀ (n q : ℕ)
        (p₀ : weilEtaleTorsionH S n q →+ weilEtaleTorsionH U₀.toScheme n q)
        (p₁ : weilEtaleTorsionH S n q →+ weilEtaleTorsionH U₁.toScheme n q),
        WeilIsTorsionEtalePullback U₀.ι n q p₀ →
        WeilIsTorsionEtalePullback U₁.ι n q p₁ →
        Function.Bijective (AddMonoidHom.prod p₀ p₁)) ∧
    (∀ (k : Type u) [Field k] [IsAlgClosed k]
      (ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (_ : (ℓ : k) ≠ 0),
      WeilProperModPrimeBaseChangeHolds k ℓ →
      ∀ (Y_tilde Y E : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper Y_tilde.hom]
        [AlgebraicGeometry.IsProper Y.hom]
        [AlgebraicGeometry.IsProper E.hom]
        (π : Y_tilde ⟶ Y)
        [AlgebraicGeometry.IsProper π.left]
