              (∏ i : Fin (2 * m + 3), val_μ (t_μ i ^ v (μ.succAbove i))) =
            ∏ i : Fin (2 * m + 3),
              algebraMap A_amb L_μ (MvPolynomial.X (μ.succAbove i)) ^ v (μ.succAbove i) := by
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [map_pow, ← mul_pow, ht_mul i]
        calc
          (u_μ ^ v μ * ∏ i : Fin (2 * m + 3), u_μ ^ v (μ.succAbove i)) *
              ((algebraMap A_amb L_μ) (MvPolynomial.C (G.coeff v)) *
                ∏ i : Fin (2 * m + 3), val_μ (t_μ i ^ v (μ.succAbove i)))
            = (algebraMap A_amb L_μ) (MvPolynomial.C (G.coeff v)) * u_μ ^ v μ *
                ((∏ i : Fin (2 * m + 3), u_μ ^ v (μ.succAbove i)) *
                  ∏ i : Fin (2 * m + 3), val_μ (t_μ i ^ v (μ.succAbove i))) := by ring
          _ = (algebraMap A_amb L_μ) (MvPolynomial.C (G.coeff v)) *
                (algebraMap A_amb L_μ) (MvPolynomial.X μ) ^ v μ *
                ∏ i : Fin (2 * m + 3),
                  (algebraMap A_amb L_μ) (MvPolynomial.X (μ.succAbove i)) ^
                    v (μ.succAbove i) := by
              rw [hprod_mul]
          _ = (algebraMap A_amb L_μ)
                (MvPolynomial.C (G.coeff v) * MvPolynomial.X μ ^ v μ *
                  ∏ i : Fin (2 * m + 3),
                    MvPolynomial.X (μ.succAbove i) ^ v (μ.succAbove i)) := by
              simp [map_mul, map_pow, map_prod]
      rw [hlhs, hrhs]

    let θ_μ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) ≃+* P3 :=
      { φ_μ with
        invFun := ψ_μ
        left_inv := fun z => congrArg (fun f => f z) hψφ
        right_inv := fun p => congrArg (fun f => f p) hφψ }

    
    let α₁ : P3 ≃ₐ[Ω] Polynomial P2 := MvPolynomial.finSuccEquiv Ω (2 * m + 2)
    let idx0_P2 : Fin (2 * m + 2) := 0
    let a₁ : P2 := -(MvPolynomial.C c_0 * MvPolynomial.X idx0_P2)
    let ψ₁ : P3 →+* P2 := (Polynomial.evalRingHom a₁).comp α₁.toRingHom

    have hα₁_C : ∀ c : Ω, α₁ (MvPolynomial.C c) = Polynomial.C (MvPolynomial.C c) := by
      intro c
      have h1 : (MvPolynomial.C c : P3) = algebraMap Ω P3 c := rfl
      have h2 : Polynomial.C (MvPolynomial.C c : P2) = algebraMap Ω (Polynomial P2) c := by
        rw [IsScalarTower.algebraMap_apply Ω P2 (Polynomial P2),
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      rw [h1, h2, α₁.commutes]

    have hev_X0 : ev_μ (MvPolynomial.X 0) = MvPolynomial.X (0 : Fin (2 * m + 3)) := by
      let i0 : Fin (2 * m + 3) := 0
      have hi0_lt : i0.castSucc < μ := by
        change 0 < a.1 + 2
        omega
      have h0_eq : (0 : Fin (2 * (m + 1) + 1 + 1)) = μ.succAbove i0 := by
        rw [Fin.succAbove_of_castSucc_lt μ i0 hi0_lt]
        rfl
      rw [h0_eq, hev_succ i0]

    have hev_X1 : ev_μ (MvPolynomial.X 1) = MvPolynomial.X idx0_P2.succ := by
      have hi1_lt : (idx0_P2.succ).castSucc < μ := by
        change 1 < a.1 + 2
        omega
      have h1_eq : (1 : Fin (2 * (m + 1) + 1 + 1)) = μ.succAbove idx0_P2.succ := by
        rw [Fin.succAbove_of_castSucc_lt μ idx0_P2.succ hi1_lt]
        exact Fin.ext h1_val
      rw [h1_eq, hev_succ idx0_P2.succ]

    have hev_tail : ∀ k : Fin (2 * m + 1),
        ev_μ (MvPolynomial.X ((a.succAbove k).succ.succ)) = MvPolynomial.X k.succ.succ := by
      intro k
      have hsucc_eq : (a.succAbove k).succ.succ = μ.succAbove k.succ.succ := by
        by_cases hlt : k.1 < a.1
        · have hk_lt : k.castSucc < a := hlt
          have hk2_lt : (k.succ.succ).castSucc < μ := by
            change k.1 + 2 < a.1 + 2
            omega
          rw [Fin.succAbove_of_castSucc_lt a k hk_lt,
            Fin.succAbove_of_castSucc_lt μ k.succ.succ hk2_lt]
          rfl
        · have hk_ge : a ≤ k.castSucc := by
            change a.1 ≤ k.1
            omega
          have hk2_ge : μ ≤ (k.succ.succ).castSucc := by
            change a.1 + 2 ≤ k.1 + 2
            omega
          rw [Fin.succAbove_of_le_castSucc a k hk_ge,
            Fin.succAbove_of_le_castSucc μ k.succ.succ hk2_ge]
      rw [hsucc_eq, hev_succ k.succ.succ]

    have hα₁_L : α₁ (ev_μ L_hyp) = Polynomial.X - Polynomial.C a₁ := by
      dsimp only [L_hyp, a₁]
      rw [ev_μ.map_add, ev_μ.map_mul, hev_X0, hev_X1]
      have hev_c0 : ev_μ (MvPolynomial.C c_0) = MvPolynomial.C c_0 :=
        MvPolynomial.eval₂Hom_C _ _ _
      rw [hev_c0, map_add, map_mul, hα₁_C c_0]
      change α₁ (MvPolynomial.X 0) +
        Polynomial.C (MvPolynomial.C c_0) * α₁ (MvPolynomial.X idx0_P2.succ) = _
      rw [MvPolynomial.finSuccEquiv_X_zero, MvPolynomial.finSuccEquiv_X_succ,
        ← Polynomial.C_mul, Polynomial.C_neg, sub_neg_eq_add]

    have hψ₁_X0 : ψ₁ (ev_μ (MvPolynomial.X 0)) = a₁ := by
      dsimp [ψ₁]
      rw [hev_X0]
      change Polynomial.eval a₁ (α₁ (MvPolynomial.X 0)) = a₁
      rw [MvPolynomial.finSuccEquiv_X_zero, Polynomial.eval_X]

    have hψ₁_X1 : ψ₁ (ev_μ (MvPolynomial.X 1)) = MvPolynomial.X idx0_P2 := by
      dsimp [ψ₁]
      rw [hev_X1]
      change Polynomial.eval a₁ (α₁ (MvPolynomial.X idx0_P2.succ)) = MvPolynomial.X idx0_P2
      rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C]

    have hψ₁_tail : ∀ k : Fin (2 * m + 1),
        ψ₁ (ev_μ (MvPolynomial.X ((a.succAbove k).succ.succ))) = MvPolynomial.X k.succ := by
      intro k
      dsimp [ψ₁]
      rw [hev_tail k]
      change Polynomial.eval a₁ (α₁ (MvPolynomial.X k.succ.succ)) = MvPolynomial.X k.succ
      rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C]

    
    let j₀ : Fin (m + 1) := ⟨a.1 / 2, by omega⟩
    let a_hat : Fin (2 * m + 1) := ⟨2 * j₀.1, by omega⟩
    let σ₂ : Fin (2 * m + 2) ≃ Fin (2 * m + 2) := Equiv.swap idx0_P2 a_hat.succ
    let α₂ : P2 ≃ₐ[Ω] Polynomial P1 :=
      (MvPolynomial.renameEquiv Ω σ₂).trans (MvPolynomial.finSuccEquiv Ω (2 * m + 1))

    have hα₂_C : ∀ c : Ω, α₂ (MvPolynomial.C c) = Polynomial.C (MvPolynomial.C c) := by
      intro c
      have h1 : (MvPolynomial.C c : P2) = algebraMap Ω P2 c := rfl
      have h2 : Polynomial.C (MvPolynomial.C c : P1) = algebraMap Ω (Polynomial P1) c := by
        rw [IsScalarTower.algebraMap_apply Ω P1 (Polynomial P1),
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      rw [h1, h2, α₂.commutes]

    have hα₂_idx0 : α₂ (MvPolynomial.X idx0_P2) = Polynomial.C (MvPolynomial.X a_hat) := by
      dsimp [α₂]
      change (MvPolynomial.finSuccEquiv Ω (2 * m + 1))
        ((MvPolynomial.rename σ₂) (MvPolynomial.X idx0_P2)) = _
      rw [MvPolynomial.rename_X, Equiv.swap_apply_left, MvPolynomial.finSuccEquiv_X_succ]

    have hα₂_ahat : α₂ (MvPolynomial.X a_hat.succ) = Polynomial.X := by
      dsimp [α₂]
      change (MvPolynomial.finSuccEquiv Ω (2 * m + 1))
        ((MvPolynomial.rename σ₂) (MvPolynomial.X a_hat.succ)) = Polynomial.X
      rw [MvPolynomial.rename_X, Equiv.swap_apply_right, MvPolynomial.finSuccEquiv_X_zero]

    have hα₂_ne : ∀ k : Fin (2 * m + 1), k ≠ a_hat →
        ∃ p : P1, α₂ (MvPolynomial.X k.succ) = Polynomial.C p := by
      intro k hk
      have hσ_ne0 : σ₂ k.succ ≠ 0 := by
        intro h0
        apply hk
        apply Fin.succ_inj.mp
        apply σ₂.injective
        have ha0 : σ₂ a_hat.succ = 0 := Equiv.swap_apply_right idx0_P2 a_hat.succ
        exact h0.trans ha0.symm
      let w : Fin (2 * m + 1) := (σ₂ k.succ).pred hσ_ne0
      have hw : w.succ = σ₂ k.succ := Fin.succ_pred (σ₂ k.succ) hσ_ne0
      refine ⟨MvPolynomial.X w, ?_⟩
      dsimp [α₂]
      change (MvPolynomial.finSuccEquiv Ω (2 * m + 1))
        ((MvPolynomial.rename σ₂) (MvPolynomial.X k.succ)) = _
      rw [MvPolynomial.rename_X, ← hw, MvPolynomial.finSuccEquiv_X_succ]

    have hα₂_other_var : ∀ b : Fin (2 * m + 2), b.1 / 2 ≠ j₀.1 →
        ∃ p : P1, α₂ (ψ₁ (ev_μ (MvPolynomial.X b.succ.succ))) = Polynomial.C p := by
      intro b hb
      by_cases hlt : b.1 < a.1
      · have hb_lt : b.1 < 2 * j₀.1 := by
          dsimp [j₀] at hb ⊢
          omega
        let k : Fin (2 * m + 1) := ⟨b.1, by omega⟩
        have hk_lt : k.castSucc < a := hlt
        have hb_eq : b = a.succAbove k := by
          rw [Fin.succAbove_of_castSucc_lt a k hk_lt]
          ext; rfl
        have hk_ne : k ≠ a_hat := by
          intro heq
          have hval : k.1 = a_hat.1 := congrArg Fin.val heq
          dsimp [k, a_hat] at hval
          omega
        rw [hb_eq, hψ₁_tail k]
        exact hα₂_ne k hk_ne
      · have hb_ge : 2 * j₀.1 + 2 ≤ b.1 := by
          dsimp [j₀] at hb ⊢
          omega
        have hab_ne : a.1 ≠ b.1 := by
          intro heq
          apply hb
          dsimp [j₀]
          omega
        let k : Fin (2 * m + 1) := ⟨b.1 - 1, by omega⟩
        have hk_ge : a ≤ k.castSucc := by
          change a.1 ≤ b.1 - 1
          omega
        have hb_eq : b = a.succAbove k := by
          rw [Fin.succAbove_of_le_castSucc a k hk_ge]
          apply Fin.ext
          change b.1 = (b.1 - 1) + 1
          omega
        have hk_ne : k ≠ a_hat := by
          intro heq
          have hval : k.1 = a_hat.1 := congrArg Fin.val heq
          have hk_val : k.1 = b.1 - 1 := rfl
          have hahat_val : a_hat.1 = 2 * j₀.1 := rfl
          rw [hk_val, hahat_val] at hval
          omega
        rw [hb_eq, hψ₁_tail k]
        exact hα₂_ne k hk_ne

    have hterm_head :
        α₂ (ψ₁ (ev_μ (MvPolynomial.X 0 * MvPolynomial.X 1))) =
          Polynomial.C
            (-(MvPolynomial.C c_0 * MvPolynomial.X a_hat * MvPolynomial.X a_hat)) := by
      rw [map_mul, map_mul, hψ₁_X0, hψ₁_X1]
      dsimp only [a₁]
      rw [map_mul, map_neg, map_mul, hα₂_C c_0, hα₂_idx0]
      simp only [← Polynomial.C_neg, ← Polynomial.C_mul]
      congr 1
      ring

    have hterm_j0 :
        α₂ (ψ₁ (ev_μ (MvPolynomial.X (ν_even j₀) * MvPolynomial.X (ν_odd j₀)))) =
          Polynomial.X := by
      rw [map_mul, map_mul]
      have hpar : a.1 = 2 * j₀.1 ∨ a.1 = 2 * j₀.1 + 1 := by
        dsimp [j₀]
        omega
      rcases hpar with ha_even | ha_odd
      · have h0_eq : (⟨2 * j₀.1, by omega⟩ : Fin (2 * m + 2)) = a :=
          Fin.ext ha_even.symm
        have hle : a ≤ a_hat.castSucc := by
          change a.1 ≤ 2 * j₀.1
          omega
        have h1_eq : (⟨2 * j₀.1 + 1, by omega⟩ : Fin (2 * m + 2)) = a.succAbove a_hat := by
          rw [Fin.succAbove_of_le_castSucc a a_hat hle]
          rfl
        have hν0 : ν_even j₀ = μ := congrArg (fun x : Fin (2 * m + 2) => x.succ.succ) h0_eq
        have hν1 : ν_odd j₀ = (a.succAbove a_hat).succ.succ :=
          congrArg (fun x : Fin (2 * m + 2) => x.succ.succ) h1_eq
        rw [hν0, hν1, hev_Xμ, hψ₁_tail a_hat, map_one, map_mul, map_one, one_mul, hα₂_ahat]
      · have hlt : a_hat.castSucc < a := by
          change 2 * j₀.1 < a.1
          omega
        have h0_eq : (⟨2 * j₀.1, by omega⟩ : Fin (2 * m + 2)) = a.succAbove a_hat := by
          rw [Fin.succAbove_of_castSucc_lt a a_hat hlt]
          rfl
        have h1_eq : (⟨2 * j₀.1 + 1, by omega⟩ : Fin (2 * m + 2)) = a :=
          Fin.ext ha_odd.symm
        have hν0 : ν_even j₀ = (a.succAbove a_hat).succ.succ :=
          congrArg (fun x : Fin (2 * m + 2) => x.succ.succ) h0_eq
        have hν1 : ν_odd j₀ = μ := congrArg (fun x : Fin (2 * m + 2) => x.succ.succ) h1_eq
        rw [hν0, hν1, hψ₁_tail a_hat, hev_Xμ, map_one, map_mul, map_one, mul_one, hα₂_ahat]

    have hrest_C : ∃ Q_rest : P1,
        (∑ j ∈ (Finset.univ : Finset (Fin (m + 1))).erase j₀,
          α₂ (ψ₁ (ev_μ (MvPolynomial.X (ν_even j) * MvPolynomial.X (ν_odd j))))) =
          Polynomial.C Q_rest := by
      have hex : ∀ j : Fin (m + 1), ∃ q_j : P1,
          j ∈ (Finset.univ : Finset (Fin (m + 1))).erase j₀ →
            α₂ (ψ₁ (ev_μ (MvPolynomial.X (ν_even j) * MvPolynomial.X (ν_odd j)))) =
              Polynomial.C q_j := by
        intro j
        by_cases hj : j ∈ (Finset.univ : Finset (Fin (m + 1))).erase j₀
        · have hj_ne : j.1 ≠ j₀.1 := fun heq => (Finset.mem_erase.mp hj).1 (Fin.ext heq)
          obtain ⟨p₁, hp₁⟩ := hα₂_other_var ⟨2 * j.1, by omega⟩ (by dsimp; omega)
          obtain ⟨p₂, hp₂⟩ := hα₂_other_var ⟨2 * j.1 + 1, by omega⟩ (by dsimp; omega)
          refine ⟨p₁ * p₂, fun _ => ?_⟩
          rw [map_mul, map_mul, map_mul]
          dsimp only [ν_even, ν_odd]
          rw [hp₁, hp₂, ← Polynomial.C_mul]
        · exact ⟨0, fun hmem => False.elim (hj hmem)⟩
      choose q_fn hq_fn using hex
      refine ⟨∑ j ∈ (Finset.univ : Finset (Fin (m + 1))).erase j₀, q_fn j, ?_⟩
      rw [map_sum]
      exact Finset.sum_congr rfl fun j hj => hq_fn j hj

    obtain ⟨Q_rest, hQ_rest⟩ := hrest_C
    let a₂ : P1 := MvPolynomial.C c_0 * MvPolynomial.X a_hat * MvPolynomial.X a_hat - Q_rest
    let g₁ : Polynomial P2 := α₁ (ev_μ L_hyp)
    let g₂ : Polynomial P2 := α₁ (ev_μ F_amb)

    have hα₂_F : α₂ (Polynomial.eval a₁ g₂) = Polynomial.X - Polynomial.C a₂ := by
      have hg2_eval : Polynomial.eval a₁ g₂ = ψ₁ (ev_μ F_amb) := rfl
      rw [hg2_eval, hF_amb_eq, map_add, map_add, map_add, hterm_head,
        map_sum, map_sum, map_sum, ← Finset.add_sum_erase _ _ (Finset.mem_univ j₀),
        hterm_j0, hQ_rest]
      dsimp only [a₂]
      rw [map_sub, map_neg]
      ring

    
    let s_F : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
      HomogeneousLocalization.Away.mk 𝒜 (hX μ) 2 F_amb hF
    let s_L : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
      HomogeneousLocalization.Away.mk 𝒜 (hX μ) 1 L_hyp hL
    let ι_a : P1 →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
      θ_μ.symm.toRingHom.comp
        (α₁.symm.toRingHom.comp
          ((Polynomial.C : P2 →+* Polynomial P2).comp
            (α₂.symm.toRingHom.comp (Polynomial.C : P1 →+* Polynomial P1))))
    let ρ_a : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) →+* P1 :=
      (Polynomial.evalRingHom a₂).comp
        (α₂.toRingHom.comp
          ((Polynomial.evalRingHom a₁).comp (α₁.toRingHom.comp θ_μ.toRingHom)))

    have hρ_ι : ∀ s : P1, ρ_a (ι_a s) = s := by
      intro s
      change Polynomial.eval a₂
        (α₂ (Polynomial.eval a₁
          (α₁ (θ_μ (θ_μ.symm (α₁.symm (Polynomial.C (α₂.symm (Polynomial.C s))))))))) = s
      rw [θ_μ.apply_symm_apply, α₁.apply_symm_apply, Polynomial.eval_C,
        α₂.apply_symm_apply, Polynomial.eval_C]

    have hρ_sL : ρ_a s_L = 0 := by
      have hθL : θ_μ s_L = ev_μ L_hyp := hφ_mk 1 L_hyp hL
      change Polynomial.eval a₂ (α₂ (Polynomial.eval a₁ (α₁ (θ_μ s_L)))) = 0
      rw [hθL, hα₁_L, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
        sub_self, map_zero, Polynomial.eval_zero]

    have hρ_sF : ρ_a s_F = 0 := by
      have hθF : θ_μ s_F = ev_μ F_amb := hφ_mk 2 F_amb hF
      change Polynomial.eval a₂ (α₂ (Polynomial.eval a₁ (α₁ (θ_μ s_F)))) = 0
      rw [hθF]
      change Polynomial.eval a₂ (α₂ (Polynomial.eval a₁ g₂)) = 0
      rw [hα₂_F, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]

    have hDiv_two : ∀ z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ),
        z - ι_a (ρ_a z) ∈ RingHom.ker π_μ := by
      intro z
      let P : Polynomial P2 := α₁ (θ_μ z)
      let r : P2 := Polynomial.eval a₁ P
      let s : P1 := Polynomial.eval a₂ (α₂ r)
      have hs_eq : s = ρ_a z := rfl
      obtain ⟨Q₁, hQ₁⟩ : g₁ ∣ P - Polynomial.C r := by
        change α₁ (ev_μ L_hyp) ∣ P - Polynomial.C (Polynomial.eval a₁ P)
        rw [hα₁_L]
        exact Polynomial.X_sub_C_dvd_sub_C_eval
      obtain ⟨Q₀, hQ₀⟩ : g₁ ∣ g₂ - Polynomial.C (Polynomial.eval a₁ g₂) := by
        change α₁ (ev_μ L_hyp) ∣ g₂ - Polynomial.C (Polynomial.eval a₁ g₂)
        rw [hα₁_L]
        exact Polynomial.X_sub_C_dvd_sub_C_eval
      obtain ⟨Q₂, hQ₂⟩ : α₂ (Polynomial.eval a₁ g₂) ∣ α₂ r - Polynomial.C s := by
        rw [hα₂_F]
        exact Polynomial.X_sub_C_dvd_sub_C_eval
      have hr_sub :
          Polynomial.C r - Polynomial.C (α₂.symm (Polynomial.C s)) =
            Polynomial.C (Polynomial.eval a₁ g₂) * Polynomial.C (α₂.symm Q₂) := by
        have hsymm := congrArg α₂.symm hQ₂
        rw [map_sub, map_mul, α₂.symm_apply_apply, α₂.symm_apply_apply] at hsymm
        have hC := congrArg (Polynomial.C : P2 →+* Polynomial P2) hsymm
        rwa [map_sub, map_mul] at hC
      have hP_comb :
          P - Polynomial.C (α₂.symm (Polynomial.C s)) =
            Polynomial.C (α₂.symm Q₂) * g₂ +
              (Q₁ - Q₀ * Polynomial.C (α₂.symm Q₂)) * g₁ := by
        linear_combination hQ₁ + hr_sub - Polynomial.C (α₂.symm Q₂) * hQ₀
      have h_app := congrArg (fun W : Polynomial P2 => θ_μ.symm (α₁.symm W)) hP_comb
      simp only [map_sub, map_add, map_mul] at h_app
      have hlhs_z : θ_μ.symm (α₁.symm P) = z := by
        dsimp [P]
        rw [α₁.symm_apply_apply, θ_μ.symm_apply_apply]
      have hlhs_ι : θ_μ.symm (α₁.symm (Polynomial.C (α₂.symm (Polynomial.C s)))) =
          ι_a (ρ_a z) := by
        rw [hs_eq]
        rfl
      have hg₂_map : θ_μ.symm (α₁.symm g₂) = s_F := by
        dsimp [g₂]
        rw [α₁.symm_apply_apply]
        have hθF : θ_μ s_F = ev_μ F_amb := hφ_mk 2 F_amb hF
        rw [← hθF, θ_μ.symm_apply_apply]
      have hg₁_map : θ_μ.symm (α₁.symm g₁) = s_L := by
        dsimp [g₁]
        rw [α₁.symm_apply_apply]
        have hθL : θ_μ s_L = ev_μ L_hyp := hφ_mk 1 L_hyp hL
        rw [← hθL, θ_μ.symm_apply_apply]
      rw [hlhs_z, hlhs_ι, hg₂_map, hg₁_map] at h_app
      rw [hπ_ker, Ideal.mem_span_pair]
      exact ⟨_, _, h_app.symm⟩

    let Φ_a : P1 →+* ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ))) := π_μ.comp ι_a
    have hΦ_bij : Function.Bijective Φ_a := by
      refine ⟨?_, ?_⟩
      · intro s₁ s₂ hs
        have hmem : ι_a (s₁ - s₂) ∈ RingHom.ker π_μ := by
          change π_μ (ι_a (s₁ - s₂)) = 0
          rw [map_sub, map_sub]
          exact sub_eq_zero.mpr hs
        rw [hπ_ker, Ideal.mem_span_pair] at hmem
        rcases hmem with ⟨u₁, u₂, hu⟩
        have hρ_eq := congrArg ρ_a hu
        rw [map_add, map_mul, map_mul, hρ_sF, hρ_sL, mul_zero, mul_zero, add_zero,
          hρ_ι (s₁ - s₂)] at hρ_eq
        exact sub_eq_zero.mp hρ_eq.symm
      · intro w
        obtain ⟨z, rfl⟩ := hπ_surj w
        refine ⟨ρ_a z, ?_⟩
        have hmem : π_μ (z - ι_a (ρ_a z)) = 0 := hDiv_two z
        rw [map_sub] at hmem
        exact (sub_eq_zero.mp hmem).symm

    let e_ring : P1 ≃+* ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ))) :=
      RingEquiv.ofBijective Φ_a hΦ_bij
    let e_cat : CommRingCat.of P1 ≅ Q_sm.left.presheaf.obj (Opposite.op (C' μ)) :=
      { hom := CommRingCat.ofHom e_ring.toRingHom
        inv := CommRingCat.ofHom e_ring.symm.toRingHom
        hom_inv_id := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro x
          exact e_ring.symm_apply_apply x
        inv_hom_id := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro x
          exact e_ring.apply_symm_apply x }
    have hΦ_scalar : ∀ c : Ω, Φ_a (MvPolynomial.C c) = π_μ (c_μ c) := by
      intro c
      change π_μ (θ_μ.symm (α₁.symm (Polynomial.C (α₂.symm (Polynomial.C (MvPolynomial.C c)))))) =
        π_μ (c_μ c)
      have halg1 : Polynomial.C (MvPolynomial.C c : P1) = algebraMap Ω (Polynomial P1) c := by
        rw [IsScalarTower.algebraMap_apply Ω P1 (Polynomial P1),
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      have halg2 : Polynomial.C (MvPolynomial.C c : P2) = algebraMap Ω (Polynomial P2) c := by
        rw [IsScalarTower.algebraMap_apply Ω P2 (Polynomial P2),
          MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      rw [halg1, α₂.symm.commutes, MvPolynomial.algebraMap_eq,
        halg2, α₁.symm.commutes, MvPolynomial.algebraMap_eq]
      have hψ_C : θ_μ.symm (MvPolynomial.C c) = c_μ c := MvPolynomial.eval₂Hom_C _ _ _
      rw [hψ_C]

    let spec_Ca : AlgebraicGeometry.Spec (Q_sm.left.presheaf.obj (Opposite.op (C' μ))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of P1) :=
      { hom := AlgebraicGeometry.Spec.map e_cat.hom
        inv := AlgebraicGeometry.Spec.map e_cat.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, e_cat.inv_hom_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, e_cat.hom_inv_id,
            AlgebraicGeometry.Spec.map_id] }
    refine ⟨hAff_Ca.isoSpec ≪≫ spec_Ca, ?_⟩
    have hcomp := congrArg (fun g => g ≫ P_hom) hStep2
    have hrhs : ((C' μ).ι ≫ f_ci) ≫ P_hom = (C' μ).ι ≫ Q_sm.hom := by
      rw [CategoryTheory.Category.assoc, hf_ci_hom]
    rw [hrhs] at hcomp
    rw [← hcomp]
    dsimp only [spec_Ca, P_hom]
    rw [CategoryTheory.Iso.trans_hom, hAff_Ca.isoSpec_hom, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact hΦ_scalar c

  · 
    
    
    intro a
    let a₀ : Fin (2 * m + 2) := ⟨0, by omega⟩
    let μ₀ : Fin (2 * (m + 1) + 1 + 1) := a₀.succ.succ
    let μ_a : Fin (2 * (m + 1) + 1 + 1) := a.succ.succ
    change Nonempty ↥(C' μ₀ ⊓ C' μ_a)
    obtain ⟨hAff_C0, hπ0_surj, hπ0_ker, hStep2_0⟩ := hChartCI μ₀
    let awaySec0 := AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ₀)
    let π₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀) →+*
        ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ₀))) :=
      ((f_ci.app (D μ₀)).hom).comp awaySec0.hom

    
    let v_nat : ℕ → Ω := fun k =>
      if a.1 < 2 then
        if k = 0 then -c_0
        else if k = 1 then 1
        else if k = 2 then 1
        else if k = 3 then c_0
        else 0
      else
        if k = 2 then 1
        else if k = a.1 + 2 then 1
        else 0
    let v_a : Fin (2 * (m + 1) + 1 + 1) → Ω := fun ν => v_nat ν.1

    have hv_μ0 : v_a μ₀ = 1 := by
      change v_nat 2 = 1
      dsimp only [v_nat]
      by_cases ha2 : a.1 < 2
      · simp only [ha2, ↓reduceIte]
        norm_num
      · simp only [ha2, ↓reduceIte]

    have hv_μa : v_a μ_a ≠ 0 := by
      change v_nat (a.1 + 2) ≠ 0
      dsimp only [v_nat]
      by_cases ha2 : a.1 < 2
      · simp only [ha2, ↓reduceIte]
        have ha01 : a.1 = 0 ∨ a.1 = 1 := by omega
        rcases ha01 with ha0 | ha1
        · rw [ha0]
          norm_num
        · rw [ha1]
          norm_num
          exact hc_0
      · simp only [ha2, ↓reduceIte]
        split_ifs
        · exact one_ne_zero
        · exact one_ne_zero

    have hv_L : MvPolynomial.eval v_a L_hyp = 0 := by
      dsimp only [L_hyp]
      rw [map_add, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C, MvPolynomial.eval_X]
      have hv1_eq : v_a 1 = v_nat 1 := by
        change v_nat (1 : Fin (2 * (m + 1) + 1 + 1)).1 = v_nat 1
        rw [h1_val]
      by_cases ha2 : a.1 < 2
      · have hv0 : v_a 0 = -c_0 := by
          change v_nat 0 = -c_0
          dsimp only [v_nat]
          simp only [ha2, ↓reduceIte]
        have hv1 : v_a 1 = 1 := by
          rw [hv1_eq]
          dsimp only [v_nat]
          simp only [ha2, ↓reduceIte]
          norm_num
        rw [hv0, hv1]
        ring
      · have ha_ne0 : 0 ≠ a.1 + 2 := by omega
        have ha_ne1 : 1 ≠ a.1 + 2 := by omega
        have hv0 : v_a 0 = 0 := by
          change v_nat 0 = 0
          dsimp only [v_nat]
          simp only [ha2, ha_ne0, ↓reduceIte]
          norm_num
        have hv1 : v_a 1 = 0 := by
          rw [hv1_eq]
          dsimp only [v_nat]
          simp only [ha2, ha_ne1, ↓reduceIte]
          norm_num
        rw [hv0, hv1]
        ring

    have hv_F : MvPolynomial.eval v_a F_amb = 0 := by
      rw [hF_amb_eq, map_add, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, map_sum]
      have hv1_eq : v_a 1 = v_nat 1 := by
        change v_nat (1 : Fin (2 * (m + 1) + 1 + 1)).1 = v_nat 1
        rw [h1_val]
      by_cases ha2 : a.1 < 2
      · have hv0 : v_a 0 = -c_0 := by
          change v_nat 0 = -c_0
          dsimp only [v_nat]
          simp only [ha2, ↓reduceIte]
        have hv1 : v_a 1 = 1 := by
          rw [hv1_eq]
          dsimp only [v_nat]
          simp only [ha2, ↓reduceIte]
          norm_num
        let j0 : Fin (m + 1) := ⟨0, by omega⟩
        rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j0), hv0, hv1]
        have hj0_ev :
            MvPolynomial.eval v_a (MvPolynomial.X (ν_even j0) * MvPolynomial.X (ν_odd j0)) =
              c_0 := by
          rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
          have hv2 : v_a (ν_even j0) = 1 := by
            change v_nat 2 = 1
            dsimp only [v_nat]
            simp only [ha2, ↓reduceIte]
            norm_num
          have hv3 : v_a (ν_odd j0) = c_0 := by
            change v_nat 3 = c_0
            dsimp only [v_nat]
            simp only [ha2, ↓reduceIte]
            norm_num
          rw [hv2, hv3, one_mul]
        have hrest_ev :
            (∑ j ∈ (Finset.univ : Finset (Fin (m + 1))).erase j0,
              MvPolynomial.eval v_a (MvPolynomial.X (ν_even j) * MvPolynomial.X (ν_odd j))) = 0 := by
          refine Finset.sum_eq_zero fun j hj => ?_
          have hj_ne : j.1 ≠ 0 := fun h0 => (Finset.mem_erase.mp hj).1 (Fin.ext h0)
          have hne0 : 2 * j.1 + 2 ≠ 0 := by omega
          have hne1 : 2 * j.1 + 2 ≠ 1 := by omega
          have hne2 : 2 * j.1 + 2 ≠ 2 := by omega
          have hne3 : 2 * j.1 + 2 ≠ 3 := by omega
          rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
          have hve0 : v_a (ν_even j) = 0 := by
            change v_nat (2 * j.1 + 2) = 0
            dsimp only [v_nat]
            simp only [ha2, hne0, hne1, hne2, hne3, ↓reduceIte]
          rw [hve0, zero_mul]
        rw [hj0_ev, hrest_ev]
        ring
      · have ha_ne0 : 0 ≠ a.1 + 2 := by omega
        have hv0 : v_a 0 = 0 := by
          change v_nat 0 = 0
          dsimp only [v_nat]
          simp only [ha2, ha_ne0, ↓reduceIte]
          norm_num
        have hsum0 :
            (∑ j : Fin (m + 1),
              MvPolynomial.eval v_a (MvPolynomial.X (ν_even j) * MvPolynomial.X (ν_odd j))) = 0 := by
          refine Finset.sum_eq_zero fun j _ => ?_
          rw [map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X]
          rcases Nat.eq_zero_or_pos j.1 with hj0 | hj_pos
          · have h3_ne : 3 ≠ a.1 + 2 := by omega
            have hvo0 : v_a (ν_odd j) = 0 := by
              change v_nat (2 * j.1 + 3) = 0
              rw [hj0]
              dsimp only [v_nat]
              simp only [ha2, h3_ne, ↓reduceIte]
              norm_num
            rw [hvo0, mul_zero]
          · by_cases heq : 2 * j.1 + 2 = a.1 + 2
            · have ho2 : 2 * j.1 + 3 ≠ 2 := by omega
              have hoa : 2 * j.1 + 3 ≠ a.1 + 2 := by omega
              have hvo0 : v_a (ν_odd j) = 0 := by
                change v_nat (2 * j.1 + 3) = 0
                dsimp only [v_nat]
                simp only [ha2, ho2, hoa, ↓reduceIte]
              rw [hvo0, mul_zero]
            · have he2 : 2 * j.1 + 2 ≠ 2 := by omega
              have hve0 : v_a (ν_even j) = 0 := by
                change v_nat (2 * j.1 + 2) = 0
                dsimp only [v_nat]
                simp only [ha2, he2, heq, ↓reduceIte]
              rw [hve0, zero_mul]
        rw [hsum0, hv0, zero_mul, add_zero]

    
    have hu_v0 : IsUnit ((MvPolynomial.eval v_a) (MvPolynomial.X μ₀)) := by
      rw [MvPolynomial.eval_X, hv_μ0]
      exact isUnit_one
    let lift_v : Localization (Submonoid.powers (MvPolynomial.X μ₀ : A_amb)) →+* Ω :=
      IsLocalization.Away.lift (MvPolynomial.X μ₀) hu_v0
    let ε_a : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀) →+* Ω :=
      lift_v.comp (algebraMap _ _)
    have hε_mk : ∀ (n : ℕ) (G : A_amb) (hG : G ∈ 𝒜 (n • 1)),
        ε_a (HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) n G hG) = MvPolynomial.eval v_a G := by
      intro n G hG
      change lift_v (HomogeneousLocalization.val
        (HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) n G hG)) = MvPolynomial.eval v_a G
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      dsimp [lift_v, IsLocalization.Away.lift]
      rw [IsLocalization.lift_mk'_spec]
      change MvPolynomial.eval v_a G =
        (MvPolynomial.eval v_a) (MvPolynomial.X μ₀ ^ n) * MvPolynomial.eval v_a G
      rw [map_pow, MvPolynomial.eval_X, hv_μ0, one_pow, one_mul]
    have hε_F : ε_a (HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 2 F_amb hF) = 0 := by
      rw [hε_mk 2 F_amb hF, hv_F]
    have hε_L : ε_a (HomogeneousLocalization.Away.mk 𝒜 (hX μ₀) 1 L_hyp hL) = 0 := by
      rw [hε_mk 1 L_hyp hL, hv_L]
    have hε_Xa : ε_a (HomogeneousLocalization.Away.isLocalizationElem (hX μ₀) (hX μ_a)) ≠ 0 := by
      rw [helem_eq μ₀ μ_a, hε_mk 1 (MvPolynomial.X μ_a) (hX_smul1 μ_a), MvPolynomial.eval_X]
      exact hv_μa

    have hker_le : ∀ w ∈ RingHom.ker π₀, ε_a w = 0 := by
      intro w hw
      rw [hπ0_ker, Ideal.mem_span_pair] at hw
      rcases hw with ⟨u₁, u₂, rfl⟩
      rw [map_add, map_mul, map_mul, hε_F, hε_L, mul_zero, mul_zero, add_zero]
    let g_inv := Function.surjInv hπ0_surj
    have hg_inv_eq : ∀ y, π₀ (g_inv y) = y := Function.surjInv_eq hπ0_surj
    have heq_g : ∀ z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀),
        ε_a (g_inv (π₀ z)) = ε_a z := by
      intro z
      have hsub : g_inv (π₀ z) - z ∈ RingHom.ker π₀ := by
        change π₀ (g_inv (π₀ z) - z) = 0
        rw [map_sub, hg_inv_eq, sub_self]
      have h0 := hker_le _ hsub
      rw [map_sub] at h0
      exact sub_eq_zero.mp h0
    let ε_Q : ↑(Q_sm.left.presheaf.obj (Opposite.op (C' μ₀))) →+* Ω :=
      { toFun := fun y => ε_a (g_inv y)
        map_one' := by
          rw [← map_one π₀, heq_g, map_one]
        map_mul' := fun x y => by
          conv_lhs => rw [← hg_inv_eq x, ← hg_inv_eq y, ← map_mul]
          rw [heq_g, map_mul]
        map_zero' := by
          rw [← map_zero π₀, heq_g, map_zero]
        map_add' := fun x y => by
          conv_lhs => rw [← hg_inv_eq x, ← hg_inv_eq y, ← map_add]
          rw [heq_g, map_add] }
    have hεQ_comp : ε_Q.comp π₀ = ε_a := RingHom.ext heq_g

    let g_pt : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Q_sm.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_Q) ≫ hAff_C0.fromSpec
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := (⊥ : PrimeSpectrum Ω)
    let q_pt : ↥Q_sm.left := g_pt.base pt_Ω
    have hq_C0 : q_pt ∈ C' μ₀ := by
      change q_pt ∈ (C' μ₀ : Set Q_sm.left)
      rw [← hAff_C0.range_fromSpec]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_Q)).base pt_Ω, rfl⟩
    have hfrom_ι : hAff_C0.fromSpec ≫ f_ci =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one := by
      rw [← hAff_C0.isoSpec_inv_ι, CategoryTheory.Category.assoc, ← hStep2_0,
        ← hAff_C0.isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc]
    have hg_ι : g_pt ≫ f_ci =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_a) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one := by
      dsimp [g_pt]
      rw [CategoryTheory.Category.assoc, hfrom_ι, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hεQ_comp]
    have hq_Ca : q_pt ∈ C' μ_a := by
      change (g_pt ≫ f_ci).base pt_Ω ∈ D μ_a
      rw [hg_ι]
      have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜
        (hX μ₀) zero_lt_one (hX μ_a) zero_lt_one
      let p_away : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ₀)) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_a)).base pt_Ω
      change (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one).base
        p_away ∈ D μ_a
      have hmem_iff :
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one).base
            p_away ∈ D μ_a ↔
          p_away ∈ (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ₀) (hX μ₀) zero_lt_one).base).obj
            (D μ_a) := Iff.rfl
      rw [hmem_iff]
      dsimp [D]
      rw [hpre]
      change HomogeneousLocalization.Away.isLocalizationElem (hX μ₀) (hX μ_a) ∉ p_away.asIdeal
      intro hmem
      exact hε_Xa hmem
    exact ⟨⟨q_pt, hq_C0, hq_Ca⟩⟩

theorem weil_quad_cvs_non_tangent_hyp_complement_iso_aff_quadric (Ω : Type u) [Field Ω]
    (m : ℕ) (c_0 : Ω)
    (Q_amb : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (ι_amb : Q_amb.left ⟶ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left)
    (hι_amb : ι_amb ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb.hom) :
    let F_amb_Ω : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω :=
      ∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    let I_aff : Ideal (MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω) :=
      Ideal.span {((1 - MvPolynomial.C c_0 *
        (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω)) *
        MvPolynomial.X (Sum.inl 0) +
        ∑ j : Fin (m + 1),
          (MvPolynomial.X (Sum.inr (j, 0)) : MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω) *
            MvPolynomial.X (Sum.inr (j, 1)))}
    let A_aff : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω ⧸ I_aff))
    let H_aff : (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left.Opens :=
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) Ω) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 1 + 1)) Ω)
        (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1)
    let U_sm : Q_amb.left.Opens := (TopologicalSpace.Opens.map ι_amb.base).obj H_aff
    IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 2
      (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))) F_amb_Ω ι_amb →
    ∃ (W_aff : (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left.Opens)
      (e_H : H_aff.toScheme ≅ (weilAffineSpaceOver Ω (2 * (m + 1) + 1)).left)
      (j_UH : U_sm.toScheme ⟶ H_aff.toScheme)
      (e_Usm : U_sm.toScheme ≅ A_aff),
      (AlgebraicGeometry.IsAffineOpen W_aff ∧
        (W_aff : Set (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left) =
          (Set.range ι_amb.base)ᶜ) ∧
      AlgebraicGeometry.IsAffineOpen U_sm ∧
      e_H.hom ≫ (weilAffineSpaceOver Ω (2 * (m + 1) + 1)).hom =
        H_aff.ι ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom ∧
      j_UH ≫ H_aff.ι = U_sm.ι ≫ ι_amb ∧
      e_Usm.hom ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_aff).comp
          (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω))) =
        U_sm.ι ≫ Q_amb.hom :=
by
  intro F_amb_Ω I_aff A_aff H_aff U_sm hSplit_amb
  classical
  let N : ℕ := 2 * (m + 1) + 1
  let A := MvPolynomial (Fin (N + 1)) Ω
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let σ_aff := Fin 1 ⊕ (Fin (m + 1) × Fin 2)
  let P_aff := MvPolynomial σ_aff Ω
  let q_aff : P_aff :=
    (1 - MvPolynomial.C c_0 * (MvPolynomial.X (Sum.inl 0) : P_aff)) *
      MvPolynomial.X (Sum.inl 0) +
    ∑ j : Fin (m + 1),
      (MvPolynomial.X (Sum.inr (j, 0)) : P_aff) * MvPolynomial.X (Sum.inr (j, 1))
  suffices hMain : ∀ (L : A),
      L = MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1 →
      let H_L : (weilProjectiveSpaceOver Ω N).left.Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜 L
      let U_L : Q_amb.left.Opens := (TopologicalSpace.Opens.map ι_amb.base).obj H_L
      ∃ (W_aff : (weilProjectiveSpaceOver Ω N).left.Opens)
        (e_H : H_L.toScheme ≅ (weilAffineSpaceOver Ω N).left)
        (j_UH : U_L.toScheme ⟶ H_L.toScheme)
        (e_Usm : U_L.toScheme ≅ A_aff),
        (AlgebraicGeometry.IsAffineOpen W_aff ∧
          (W_aff : Set (weilProjectiveSpaceOver Ω N).left) =
            (Set.range ι_amb.base)ᶜ) ∧
        AlgebraicGeometry.IsAffineOpen U_L ∧
        e_H.hom ≫ (weilAffineSpaceOver Ω N).hom =
          H_L.ι ≫ (weilProjectiveSpaceOver Ω N).hom ∧
        j_UH ≫ H_L.ι = U_L.ι ≫ ι_amb ∧
        e_Usm.hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_aff).comp
            (MvPolynomial.C : Ω →+* P_aff))) =
          U_L.ι ≫ Q_amb.hom by
    exact hMain (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1) rfl
  intro L hL_eq H_L U_L

  
  rcases hSplit_amb with ⟨hCl, hF, hRange, hKer⟩
  let P_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let P_hom : P_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)))
  let f_Q : Q_amb.left ⟶ P_sch := ι_amb
  haveI : AlgebraicGeometry.IsClosedImmersion f_Q := hCl

  let W_aff : P_sch.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 F_amb_Ω
  have hF_deg2 : F_amb_Ω ∈ 𝒜 2 := hF
  have hAff_W : AlgebraicGeometry.IsAffineOpen W_aff :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 F_amb_Ω hF_deg2 (by decide : 0 < 2)
  have hCompl_W : (W_aff : Set P_sch) = (Set.range f_Q.base)ᶜ :=
    (compl_compl (W_aff : Set P_sch)).symm.trans
      (congrArg compl (hRange : Set.range f_Q.base = (W_aff : Set P_sch)ᶜ).symm)

  have hval0 : (0 : Fin (N + 1)).1 = 0 := rfl
  have hval1 : (1 : Fin (N + 1)).1 = 1 :=
    Nat.mod_eq_of_lt (by dsimp [N]; omega)
  have hX : ∀ ν : Fin (N + 1), (MvPolynomial.X ν : A) ∈ 𝒜 1 :=
    fun ν => (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X ν)).mpr
      (MvPolynomial.isHomogeneous_X Ω ν)
  have hX_smul1 : ∀ ν : Fin (N + 1), (MvPolynomial.X ν : A) ∈ 𝒜 ((1 : ℕ) • 1) := by
    intro ν
    simpa using hX ν
  have hL : L ∈ 𝒜 1 := by
    rw [hL_eq, MvPolynomial.mem_homogeneousSubmodule]
    have hC_hom : (MvPolynomial.C c_0 : A).IsHomogeneous 0 :=
      MvPolynomial.isHomogeneous_C (Fin (N + 1)) c_0
    have hX1_hom : (MvPolynomial.X 1 : A).IsHomogeneous 1 :=
      MvPolynomial.isHomogeneous_X Ω (1 : Fin (N + 1))
    have hmul_hom : (MvPolynomial.C c_0 * MvPolynomial.X 1 : A).IsHomogeneous 1 := by
      simpa using hC_hom.mul hX1_hom
    exact (MvPolynomial.isHomogeneous_X Ω (0 : Fin (N + 1))).add hmul_hom
  have halg0_val : ∀ c : Ω, (algebraMap Ω ↥(𝒜 0) c).1 = MvPolynomial.C c := by
    intro c
    rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
      Algebra.smul_def, mul_one]
    rfl

  let H_L' : P_sch.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 L
  let U_L' : Q_amb.left.Opens := (TopologicalSpace.Opens.map f_Q.base).obj H_L'
  have hAff_HL : AlgebraicGeometry.IsAffineOpen H_L' :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 L hL zero_lt_one
  have hAff_UL : AlgebraicGeometry.IsAffineOpen U_L' := hAff_HL.preimage f_Q
  let j_UH : U_L.toScheme ⟶ H_L.toScheme := f_Q ∣_ H_L'
  have hj_UH : j_UH ≫ H_L.ι = U_L.ι ≫ ι_amb :=
    AlgebraicGeometry.morphismRestrict_ι f_Q H_L'

  
  let awaySec_L := AlgebraicGeometry.Proj.awayToSection 𝒜 L
  let β_L : HomogeneousLocalization.Away 𝒜 L →+*
      ↑(Q_amb.left.presheaf.obj (Opposite.op U_L')) :=
    ((f_Q.app H_L').hom).comp awaySec_L.hom
  let s_L : HomogeneousLocalization.Away 𝒜 L :=
    HomogeneousLocalization.Away.mk 𝒜 hL 2 F_amb_Ω hF
  let c_L : Ω →+* HomogeneousLocalization.Away 𝒜 L :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L)).comp
      (algebraMap Ω ↥(𝒜 0))
  let Loc_L := Localization (Submonoid.powers L)
  let val_L : HomogeneousLocalization.Away 𝒜 L →+* Loc_L := algebraMap _ _
  let u_L : Loc_L := algebraMap A Loc_L L

  have hval_c : ∀ c : Ω, val_L (c_L c) = algebraMap A Loc_L (MvPolynomial.C c) := by
    intro c
    rw [HomogeneousLocalization.algebraMap_apply]
    dsimp [c_L]
    change algebraMap A Loc_L (algebraMap Ω ↥(𝒜 0) c).1 = _
    rw [halg0_val]

  let μ : Fin 2 → Fin (N + 1) := fun k => if k = 0 then 0 else 1
  let D_k : Fin 2 → P_sch.Opens :=
    fun k => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X (μ k))
  let x_k : Fin 2 → A := fun k => L * MvPolynomial.X (μ k)
  have hx_k : ∀ k : Fin 2, x_k k ∈ 𝒜 2 := by
    intro k
    rw [MvPolynomial.mem_homogeneousSubmodule]
    have hL_hom : L.IsHomogeneous 1 := (MvPolynomial.mem_homogeneousSubmodule 1 L).mp hL
    exact hL_hom.mul (MvPolynomial.isHomogeneous_X Ω (μ k))
  let V_k : Fin 2 → P_sch.Opens :=
    fun k => AlgebraicGeometry.Proj.basicOpen 𝒜 (x_k k)
  have hVk_eq : ∀ k : Fin 2, V_k k = H_L' ⊓ D_k k :=
    fun k => AlgebraicGeometry.Proj.basicOpen_mul 𝒜 L (MvPolynomial.X (μ k))
  have hVk_le_HL : ∀ k : Fin 2, V_k k ≤ H_L' :=
    fun k => (hVk_eq k).trans_le inf_le_left
  have hVk_le_Dk : ∀ k : Fin 2, V_k k ≤ D_k k :=
    fun k => (hVk_eq k).trans_le inf_le_right
  have hAff_Vk : ∀ k : Fin 2, AlgebraicGeometry.IsAffineOpen (V_k k) :=
    fun k => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (x_k k) (hx_k k) (by decide : 0 < 2)
  let W_k : Fin 2 → Q_amb.left.Opens :=
    fun k => (TopologicalSpace.Opens.map f_Q.base).obj (V_k k)
  have hWk_le_UL : ∀ k : Fin 2, W_k k ≤ U_L' :=
    fun k => (TopologicalSpace.Opens.map f_Q.base).monotone (hVk_le_HL k)

  have hV_sup : V_k 0 ⊔ V_k 1 = H_L' := by
    apply le_antisymm (sup_le (hVk_le_HL 0) (hVk_le_HL 1))
    intro p hp
    have hpL : L ∉ p.asHomogeneousIdeal :=
      (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 L p).mp hp
    by_contra hnot
    have hp0 : p ∉ D_k 0 := by
      intro hd0
      apply hnot
      left
      rw [hVk_eq 0]
      exact ⟨hp, hd0⟩
    have hp1 : p ∉ D_k 1 := by
      intro hd1
      apply hnot
      right
      rw [hVk_eq 1]
      exact ⟨hp, hd1⟩
    have hX0_in : (MvPolynomial.X 0 : A) ∈ p.asHomogeneousIdeal.toIdeal := by
      have hnot0 : p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) := hp0
      rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not] at hnot0
      exact hnot0
    have hX1_in : (MvPolynomial.X 1 : A) ∈ p.asHomogeneousIdeal.toIdeal := by
      have hnot1 : p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) := hp1
      rw [AlgebraicGeometry.Proj.mem_basicOpen, not_not] at hnot1
      exact hnot1
    have hL_in : L ∈ p.asHomogeneousIdeal.toIdeal := by
      rw [hL_eq]
      exact p.asHomogeneousIdeal.toIdeal.add_mem hX0_in
        (p.asHomogeneousIdeal.toIdeal.mul_mem_left (MvPolynomial.C c_0) hX1_in)
    exact hpL hL_in

  have hW_sup : W_k 0 ⊔ W_k 1 = U_L' := by
    ext q
    change f_Q.base q ∈ V_k 0 ⊔ V_k 1 ↔ f_Q.base q ∈ H_L'
    rw [hV_sup]

  let g_k : Fin 2 → HomogeneousLocalization.Away 𝒜 L :=
    fun k => HomogeneousLocalization.Away.isLocalizationElem hL (hX (μ k))
  have hg_mul : ∀ k : Fin 2,
      u_L * (g_k k).val = algebraMap A Loc_L (MvPolynomial.X (μ k)) := by
    intro k
    dsimp only [g_k, HomogeneousLocalization.Away.isLocalizationElem]
    rw [mul_comm, HomogeneousLocalization.Away.val_mk, pow_one, Localization.mk_eq_mk']
    let s1 : Submonoid.powers L := ⟨L ^ 1, Submonoid.pow_mem _ (Submonoid.mem_powers L) 1⟩
    have hu1 : u_L = algebraMap A Loc_L s1.1 := by
      dsimp [u_L, s1]
      rw [pow_one]
    rw [hu1]
    exact IsLocalization.mk'_spec Loc_L (MvPolynomial.X (μ k)) s1

  have hg_unit : g_k 0 + c_L c_0 * g_k 1 = 1 := by
    rw [HomogeneousLocalization.ext_iff_val]
    apply (IsLocalization.Away.algebraMap_isUnit L).mul_left_cancel
    simp only [← HomogeneousLocalization.algebraMap_apply, map_add, map_mul, map_one, mul_one]
    have hc0 : (c_L c_0).val = algebraMap A Loc_L (MvPolynomial.C c_0) := hval_c c_0
    simp only [HomogeneousLocalization.algebraMap_apply]
    calc
      u_L * ((g_k 0).val + (c_L c_0).val * (g_k 1).val)
        = u_L * (g_k 0).val + (c_L c_0).val * (u_L * (g_k 1).val) := by ring
      _ = algebraMap A Loc_L (MvPolynomial.X 0) +
            algebraMap A Loc_L (MvPolynomial.C c_0) *
              algebraMap A Loc_L (MvPolynomial.X 1) := by
          rw [hg_mul 0, hg_mul 1, hc0]
          rfl
      _ = u_L := by
          dsimp only [u_L]
          rw [← map_mul, ← map_add]
          exact congrArg (algebraMap A Loc_L) hL_eq.symm

  have hg_pow_part : ∀ n₀ n₁ : ℕ, ∃ a₀ a₁ : HomogeneousLocalization.Away 𝒜 L,
      a₀ * (g_k 0) ^ n₀ + a₁ * (g_k 1) ^ n₁ = 1 := by
    intro n₀
    have hstep0 : ∃ a₀ b₀ : HomogeneousLocalization.Away 𝒜 L,
        a₀ * (g_k 0) ^ n₀ + b₀ * g_k 1 = 1 := by
      induction n₀ with
      | zero => exact ⟨1, 0, by ring⟩
      | succ n₀ ih =>
        rcases ih with ⟨a₀, b₀, hab⟩
        refine ⟨a₀, a₀ * (g_k 0) ^ n₀ * c_L c_0 + b₀ * (g_k 0 + c_L c_0 * g_k 1), ?_⟩
        calc
          a₀ * (g_k 0) ^ (n₀ + 1) +
              (a₀ * (g_k 0) ^ n₀ * c_L c_0 + b₀ * (g_k 0 + c_L c_0 * g_k 1)) * g_k 1
            = (a₀ * (g_k 0) ^ n₀ + b₀ * g_k 1) * (g_k 0 + c_L c_0 * g_k 1) := by ring
          _ = 1 := by rw [hab, hg_unit, mul_one]
    rcases hstep0 with ⟨a₀', b₀', hab'⟩
    intro n₁
    induction n₁ with
    | zero => exact ⟨0, 1, by ring⟩
    | succ n₁ ih =>
      rcases ih with ⟨A₀, A₁, hA⟩
      refine ⟨A₀ * (a₀' * (g_k 0) ^ n₀ + b₀' * g_k 1) + A₁ * (g_k 1) ^ n₁ * a₀',
        A₁ * b₀', ?_⟩
      calc
        (A₀ * (a₀' * (g_k 0) ^ n₀ + b₀' * g_k 1) + A₁ * (g_k 1) ^ n₁ * a₀') * (g_k 0) ^ n₀ +
            (A₁ * b₀') * (g_k 1) ^ (n₁ + 1)
          = (A₀ * (g_k 0) ^ n₀ + A₁ * (g_k 1) ^ n₁) *
              (a₀' * (g_k 0) ^ n₀ + b₀' * g_k 1) := by ring
        _ = 1 := by rw [hA, hab', mul_one]

  have hLocal : ∀ k : Fin 2,
      let m₁ := HomogeneousLocalization.awayMap 𝒜 (hX (μ k))
        (rfl : x_k k = L * MvPolynomial.X (μ k))
      let awaySec_k := AlgebraicGeometry.Proj.awayToSection 𝒜 (x_k k)
      let β_k : HomogeneousLocalization.Away 𝒜 (x_k k) →+*
          ↑(Q_amb.left.presheaf.obj (Opposite.op (W_k k))) :=
        ((f_Q.app (V_k k)).hom).comp awaySec_k.hom
      (∀ z : HomogeneousLocalization.Away 𝒜 L,
        (Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL k)).op).hom (β_L z) =
          β_k (m₁ z)) ∧
      RingHom.ker β_k = Ideal.map m₁ (Ideal.span {s_L}) ∧
      (letI : Algebra (HomogeneousLocalization.Away 𝒜 L)
          (HomogeneousLocalization.Away 𝒜 (x_k k)) := m₁.toAlgebra
       IsLocalization.Away (g_k k) (HomogeneousLocalization.Away 𝒜 (x_k k))) := by
    intro k m₁ awaySec_k β_k
    let m₂ := HomogeneousLocalization.awayMap 𝒜 hL
      (mul_comm L (MvPolynomial.X (μ k)) : x_k k = MvPolynomial.X (μ k) * L)
    let s_μk := HomogeneousLocalization.Away.mk 𝒜 (hX (μ k)) 2 F_amb_Ω hF
    have hres_eq : ∀ z : HomogeneousLocalization.Away 𝒜 L,
        (Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL k)).op).hom (β_L z) =
          β_k (m₁ z) := by
      intro z
      have ha := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX (μ k))
        (rfl : x_k k = L * MvPolynomial.X (μ k))
      have hb := AlgebraicGeometry.Scheme.Hom.map_appLE f_Q (le_rfl : W_k k ≤ W_k k)
        (CategoryTheory.homOfLE (hVk_le_HL k)).op
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_map f_Q (le_rfl : U_L' ≤ U_L')
        (CategoryTheory.homOfLE (hWk_le_UL k)).op
      have hd : (CommRingCat.ofHom m₁ ≫ awaySec_k) ≫ f_Q.appLE (V_k k) (W_k k) le_rfl =
          awaySec_L ≫ (f_Q.appLE H_L' U_L' le_rfl ≫
            Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL k)).op) := by
        rw [ha, CategoryTheory.Category.assoc, hb, ← hc]
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f_Q,
        ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f_Q] at hd
      exact (congrArg (fun φ => φ.hom z) hd).symm
    have hAwayBij : Function.Bijective awaySec_k.hom := by
      let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (x_k k) (hx_k k) (by decide : 0 < 2)
      have hIsoHom : awaySec_k = isoA.hom :=
        (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 (x_k k) (hx_k k) (by decide : 0 < 2)).symm
      rw [hIsoHom]
      exact isoA.commRingCatIsoToRingEquiv.bijective
    have hker_raw := hKer (μ k) (hX (μ k)) (V_k k) (hAff_Vk k) (hVk_le_Dk k)
    let D_id_k : P_sch.Opens :=
      (TopologicalSpace.Opens.map (𝟙 P_sch : P_sch ⟶ P_sch).base).obj (D_k k)
    have hVk_le_Did : V_k k ≤ D_id_k := hVk_le_Dk k
    have hid_appLE' : ((𝟙 P_sch : P_sch ⟶ P_sch).appLE (D_k k) (V_k k) hVk_le_Did) =
        P_sch.presheaf.map (CategoryTheory.homOfLE hVk_le_Did).op := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_map (𝟙 P_sch) (le_rfl : D_id_k ≤ D_id_k)
        (CategoryTheory.homOfLE hVk_le_Did).op,
        ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE (𝟙 P_sch),
        AlgebraicGeometry.Scheme.Hom.id_app]
      exact CategoryTheory.Category.id_comp
        (P_sch.presheaf.map (CategoryTheory.homOfLE (hVk_le_Dk k)).op)
    have hid_appLE : ((𝟙 P_sch : P_sch ⟶ P_sch).appLE (D_k k) (V_k k) (hVk_le_Dk k)) =
        P_sch.presheaf.map (CategoryTheory.homOfLE (hVk_le_Dk k)).op :=
      hid_appLE'
    have ha2 := AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 hL
      (mul_comm L (MvPolynomial.X (μ k)) : x_k k = MvPolynomial.X (μ k) * L)
    have hgen_eq : ((𝟙 P_sch : P_sch ⟶ P_sch).appLE (D_k k) (V_k k) (hVk_le_Dk k)).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X (μ k))).hom s_μk) =
        awaySec_k.hom (m₂ s_μk) := by
      rw [hid_appLE]
      exact (congrArg (fun φ => φ.hom s_μk) ha2).symm
    change RingHom.ker (f_Q.app (V_k k)).hom =
      Ideal.span {((𝟙 P_sch : P_sch ⟶ P_sch).appLE (D_k k) (V_k k) (hVk_le_Dk k)).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X (μ k))).hom s_μk)} at hker_raw
    rw [hgen_eq] at hker_raw
    have hβk_ker_m2 : RingHom.ker β_k = Ideal.span {m₂ s_μk} := by
      apply le_antisymm
      · intro z hz
        have hmem : awaySec_k.hom z ∈ RingHom.ker (f_Q.app (V_k k)).hom := hz
        rw [hker_raw, Ideal.mem_span_singleton] at hmem
        rcases hmem with ⟨s, hs⟩
        obtain ⟨a, rfl⟩ := hAwayBij.2 s
        rw [← map_mul] at hs
        rw [Ideal.mem_span_singleton]
        exact ⟨a, hAwayBij.1 hs⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        change (f_Q.app (V_k k)).hom (awaySec_k.hom (m₂ s_μk)) = 0
        have hmem : awaySec_k.hom (m₂ s_μk) ∈ RingHom.ker (f_Q.app (V_k k)).hom := by
          rw [hker_raw]
          exact Ideal.subset_span rfl
        exact hmem
    have hcocycle : m₁ s_L = (m₁ (g_k k) * m₁ (g_k k)) * m₂ s_μk := by
      apply HomogeneousLocalization.val_injective
      simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
      simp only [HomogeneousLocalization.algebraMap_apply]
      dsimp only [m₁, m₂, s_L, s_μk, g_k, HomogeneousLocalization.Away.isLocalizationElem, x_k]
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
      simp only [Localization.mk_eq_mk', ← IsLocalization.mk'_mul, IsLocalization.eq]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul, pow_one]
      ring
    letI : Algebra (HomogeneousLocalization.Away 𝒜 L)
        (HomogeneousLocalization.Away 𝒜 (x_k k)) := m₁.toAlgebra
    have hLoc_k : IsLocalization.Away (g_k k) (HomogeneousLocalization.Away 𝒜 (x_k k)) :=
      HomogeneousLocalization.Away.isLocalization_mul hL (hX (μ k)) rfl one_ne_zero
    haveI : IsLocalization.Away (g_k k) (HomogeneousLocalization.Away 𝒜 (x_k k)) := hLoc_k
    have hu_g : IsUnit (m₁ (g_k k) * m₁ (g_k k)) := by
      have hu1 : IsUnit (m₁ (g_k k)) := IsLocalization.Away.algebraMap_isUnit (g_k k)
      exact hu1.mul hu1
    have hspan_eq : Ideal.span {m₂ s_μk} = Ideal.map m₁ (Ideal.span {s_L}) := by
      rw [Ideal.map_span, Set.image_singleton]
      apply le_antisymm
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        have hcancel : m₁ s_L * ↑(hu_g.unit⁻¹) = m₂ s_μk := by
          calc
            m₁ s_L * ↑(hu_g.unit⁻¹)
              = (↑(hu_g.unit⁻¹) * (m₁ (g_k k) * m₁ (g_k k))) * m₂ s_μk := by
                  rw [hcocycle]
                  ring
            _ = 1 * m₂ s_μk := by rw [hu_g.val_inv_mul]
            _ = m₂ s_μk := one_mul _
        exact ⟨↑(hu_g.unit⁻¹), hcancel.symm⟩
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        exact ⟨m₁ (g_k k) * m₁ (g_k k), by rw [hcocycle, mul_comm]⟩
    exact ⟨hres_eq, hβk_ker_m2.trans hspan_eq, hLoc_k⟩

  have hβL_ker : RingHom.ker β_L = Ideal.span {s_L} := by
    apply le_antisymm
    · intro z hz
      have hmem_k : ∀ k : Fin 2, ∃ n : ℕ, (g_k k) ^ n * z ∈ Ideal.span {s_L} := by
        intro k
        obtain ⟨hres_k, hker_k, hLoc_k⟩ := hLocal k
        let m₁ := HomogeneousLocalization.awayMap 𝒜 (hX (μ k))
          (rfl : x_k k = L * MvPolynomial.X (μ k))
        let awaySec_k := AlgebraicGeometry.Proj.awayToSection 𝒜 (x_k k)
        let β_k : HomogeneousLocalization.Away 𝒜 (x_k k) →+*
            ↑(Q_amb.left.presheaf.obj (Opposite.op (W_k k))) :=
          ((f_Q.app (V_k k)).hom).comp awaySec_k.hom
        have hz_k : m₁ z ∈ RingHom.ker β_k := by
          change β_k (m₁ z) = 0
          rw [← hres_k z]
          have hz0 : β_L z = 0 := hz
          rw [hz0, map_zero]
        rw [hker_k] at hz_k
        letI : Algebra (HomogeneousLocalization.Away 𝒜 L)
            (HomogeneousLocalization.Away 𝒜 (x_k k)) := m₁.toAlgebra
        haveI : IsLocalization.Away (g_k k) (HomogeneousLocalization.Away 𝒜 (x_k k)) := hLoc_k
        have hz_alg : (algebraMap (HomogeneousLocalization.Away 𝒜 L)
            (HomogeneousLocalization.Away 𝒜 (x_k k))) z ∈
            Ideal.map (algebraMap (HomogeneousLocalization.Away 𝒜 L)
              (HomogeneousLocalization.Away 𝒜 (x_k k))) (Ideal.span {s_L}) := hz_k
        rw [IsLocalization.algebraMap_mem_map_algebraMap_iff
          (Submonoid.powers (g_k k)) (HomogeneousLocalization.Away 𝒜 (x_k k))] at hz_alg
        rcases hz_alg with ⟨_, ⟨n, rfl⟩, hn_mem⟩
        exact ⟨n, hn_mem⟩
      obtain ⟨n₀, hn₀⟩ := hmem_k 0
      obtain ⟨n₁, hn₁⟩ := hmem_k 1
      obtain ⟨a₀, a₁, ha01⟩ := hg_pow_part n₀ n₁
      have hz_eq : z = a₀ * ((g_k 0) ^ n₀ * z) + a₁ * ((g_k 1) ^ n₁ * z) := by
        calc
          z = (a₀ * (g_k 0) ^ n₀ + a₁ * (g_k 1) ^ n₁) * z := by rw [ha01, one_mul]
          _ = a₀ * ((g_k 0) ^ n₀ * z) + a₁ * ((g_k 1) ^ n₁ * z) := by ring
      rw [hz_eq]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ a₀ hn₀) (Ideal.mul_mem_left _ a₁ hn₁)
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      change β_L s_L = 0
      apply TopCat.Presheaf.IsSheaf.section_ext Q_amb.left.sheaf.2
      intro q hq
      have hq_sup : q ∈ W_k 0 ⊔ W_k 1 := by
        change q ∈ U_L' at hq
        rwa [← hW_sup] at hq
      rcases hq_sup with hq0 | hq1
      · obtain ⟨hres0, hker0, _⟩ := hLocal 0
        refine ⟨W_k 0, hWk_le_UL 0, hq0, ?_⟩
        change (Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL 0)).op).hom (β_L s_L) =
          (Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL 0)).op).hom 0
        rw [map_zero, hres0 s_L]
        have hm1_mem : HomogeneousLocalization.awayMap 𝒜 (hX (μ 0))
            (rfl : x_k 0 = L * MvPolynomial.X (μ 0)) s_L ∈
            Ideal.map (HomogeneousLocalization.awayMap 𝒜 (hX (μ 0))
              (rfl : x_k 0 = L * MvPolynomial.X (μ 0))) (Ideal.span {s_L}) :=
          Ideal.mem_map_of_mem _ (Ideal.subset_span rfl)
        rw [← hker0] at hm1_mem
        exact hm1_mem
      · obtain ⟨hres1, hker1, _⟩ := hLocal 1
        refine ⟨W_k 1, hWk_le_UL 1, hq1, ?_⟩
        change (Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL 1)).op).hom (β_L s_L) =
          (Q_amb.left.presheaf.map (CategoryTheory.homOfLE (hWk_le_UL 1)).op).hom 0
        rw [map_zero, hres1 s_L]
        have hm1_mem : HomogeneousLocalization.awayMap 𝒜 (hX (μ 1))
            (rfl : x_k 1 = L * MvPolynomial.X (μ 1)) s_L ∈
            Ideal.map (HomogeneousLocalization.awayMap 𝒜 (hX (μ 1))
              (rfl : x_k 1 = L * MvPolynomial.X (μ 1))) (Ideal.span {s_L}) :=
          Ideal.mem_map_of_mem _ (Ideal.subset_span rfl)
        rw [← hker1] at hm1_mem
        exact hm1_mem

  
  let var_map : Fin (N + 1) → P_aff := fun ν =>
    if ν.1 = 0 then
      1 - MvPolynomial.C c_0 * MvPolynomial.X (Sum.inl 0)
    else if ν.1 = 1 then
      MvPolynomial.X (Sum.inl 0)
    else
      MvPolynomial.X (Sum.inr (⟨(ν.1 - 2) / 2, by dsimp [N] at ν; omega⟩,
        ⟨(ν.1 - 2) % 2, by omega⟩))
  let ev_L : A →+* P_aff := MvPolynomial.eval₂Hom MvPolynomial.C var_map

  have hev_X0 : ev_L (MvPolynomial.X 0) =
      1 - MvPolynomial.C c_0 * MvPolynomial.X (Sum.inl 0) := by
    dsimp [ev_L, var_map]
    rw [MvPolynomial.eval₂Hom_X', if_pos hval0]
  have hev_X1 : ev_L (MvPolynomial.X 1) = MvPolynomial.X (Sum.inl 0) := by
    dsimp [ev_L, var_map]
    rw [MvPolynomial.eval₂Hom_X', if_neg (by rw [hval1]; decide), if_pos hval1]
  have hev_L : ev_L L = 1 := by
    rw [hL_eq, map_add, map_mul, MvPolynomial.eval₂Hom_C, hev_X0, hev_X1]
    ring
  have hu_ev : IsUnit (ev_L L) := by
    rw [hev_L]
    exact isUnit_one

  let lift_L : Loc_L →+* P_aff := IsLocalization.Away.lift L hu_ev
  let φ_L : HomogeneousLocalization.Away 𝒜 L →+* P_aff := lift_L.comp val_L
  let t_tilde : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 L :=
    fun ν => HomogeneousLocalization.Away.mk 𝒜 hL 1 (MvPolynomial.X ν) (hX_smul1 ν)
  let back_idx : σ_aff → Fin (N + 1)
    | Sum.inl _ => 1
    | Sum.inr (j, p) => ⟨2 * (j.1 + 1) + p.1, by dsimp [N]; omega⟩
  let ψ_L : P_aff →+* HomogeneousLocalization.Away 𝒜 L :=
    MvPolynomial.eval₂Hom c_L (fun s => t_tilde (back_idx s))

  have hφ_mk : ∀ (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • 1)),
      φ_L (HomogeneousLocalization.Away.mk 𝒜 hL n a ha) = ev_L a := by
    intro n a ha
    change lift_L (HomogeneousLocalization.val
      (HomogeneousLocalization.Away.mk 𝒜 hL n a ha)) = ev_L a
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
    dsimp [lift_L, IsLocalization.Away.lift]
    rw [IsLocalization.lift_mk'_spec]
    change ev_L a = ev_L (L ^ n) * ev_L a
    rw [map_pow, hev_L, one_pow, one_mul]

  have ht_mul : ∀ ν : Fin (N + 1),
      u_L * val_L (t_tilde ν) = algebraMap A Loc_L (MvPolynomial.X ν) := by
    intro ν
    rw [mul_comm, HomogeneousLocalization.algebraMap_apply]
    dsimp only [t_tilde]
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
    let s1 : Submonoid.powers L := ⟨L ^ 1, Submonoid.pow_mem _ (Submonoid.mem_powers L) 1⟩
    have hu1 : u_L = algebraMap A Loc_L s1.1 := by
      dsimp [u_L, s1]
      rw [pow_one]
    rw [hu1]
    exact IsLocalization.mk'_spec Loc_L (MvPolynomial.X ν) s1

  have ht01 : 1 - c_L c_0 * t_tilde 1 = t_tilde 0 := by
    rw [sub_eq_iff_eq_add]
    symm
    rw [HomogeneousLocalization.ext_iff_val]
    apply (IsLocalization.Away.algebraMap_isUnit L).mul_left_cancel
    simp only [← HomogeneousLocalization.algebraMap_apply, map_add, map_mul, map_one, mul_one]
    calc
      u_L * (val_L (t_tilde 0) + val_L (c_L c_0) * val_L (t_tilde 1))
        = u_L * val_L (t_tilde 0) + val_L (c_L c_0) * (u_L * val_L (t_tilde 1)) := by ring
      _ = algebraMap A Loc_L (MvPolynomial.X 0) +
            algebraMap A Loc_L (MvPolynomial.C c_0) *
              algebraMap A Loc_L (MvPolynomial.X 1) := by
          rw [ht_mul 0, ht_mul 1, hval_c c_0]
      _ = u_L := by
          dsimp only [u_L]
          rw [← map_mul, ← map_add]
          exact congrArg (algebraMap A Loc_L) hL_eq.symm

  have hψε_X : ∀ ν : Fin (N + 1), ψ_L (ev_L (MvPolynomial.X ν)) = t_tilde ν := by
    intro ν
    by_cases h0 : ν.1 = 0
    · have hν0 : ν = 0 := Fin.ext h0
      rw [hν0, hev_X0, map_sub, map_one, map_mul]
      dsimp [ψ_L, back_idx]
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', ht01]
    · by_cases h1 : ν.1 = 1
      · have hν1 : ν = 1 := Fin.ext (h1.trans hval1.symm)
        rw [hν1, hev_X1]
        dsimp [ψ_L, back_idx]
        rw [MvPolynomial.eval₂Hom_X']
      · dsimp [ev_L, var_map]
        rw [MvPolynomial.eval₂Hom_X', if_neg h0, if_neg h1]
        dsimp [ψ_L]
        rw [MvPolynomial.eval₂Hom_X']
        dsimp [back_idx]
        congr 1
        ext
        dsimp
        omega

  have hφψ : φ_L.comp ψ_L = RingHom.id P_aff := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      simp only [RingHom.comp_apply, RingHom.id_apply, ψ_L, MvPolynomial.eval₂Hom_C]
      change lift_L (val_L (c_L c)) = MvPolynomial.C c
      rw [hval_c, IsLocalization.Away.lift_eq]
      dsimp [ev_L]
      exact MvPolynomial.eval₂Hom_C _ _ _
    · rintro (u | ⟨j, p⟩)
      · have hu0 : u = 0 := Subsingleton.elim u 0
        subst hu0
        simp only [RingHom.comp_apply, RingHom.id_apply, ψ_L, MvPolynomial.eval₂Hom_X', back_idx]
        rw [hφ_mk 1 (MvPolynomial.X 1) (hX_smul1 1), hev_X1]
        rfl
      · simp only [RingHom.comp_apply, RingHom.id_apply, ψ_L, MvPolynomial.eval₂Hom_X', back_idx]
        let ν : Fin (N + 1) := ⟨2 * (j.1 + 1) + p.1, by dsimp [N]; omega⟩
        have hν_val : ν.1 = 2 * (j.1 + 1) + p.1 := rfl
        change φ_L (t_tilde ν) = MvPolynomial.X (Sum.inr (j, p))
        rw [hφ_mk 1 (MvPolynomial.X ν) (hX_smul1 ν)]
        dsimp [ev_L, var_map]
        rw [MvPolynomial.eval₂Hom_X', if_neg (by rw [hν_val]; omega),
          if_neg (by rw [hν_val]; omega)]
        congr 2
        exact Prod.ext
          (Fin.ext (by change (ν.1 - 2) / 2 = j.1; rw [hν_val]; omega))
          (Fin.ext (by change (ν.1 - 2) % 2 = p.1; rw [hν_val]; omega))

  have hψφ : ψ_L.comp φ_L = RingHom.id (HomogeneousLocalization.Away 𝒜 L) := by
    apply RingHom.ext
    intro z
    rw [RingHom.comp_apply, RingHom.id_apply]
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hL z
    rw [hφ_mk n a ha, HomogeneousLocalization.ext_iff_val]
    have hu_n : IsUnit (u_L ^ n) := (IsLocalization.Away.algebraMap_isUnit L).pow n
    apply hu_n.mul_left_cancel
    have hrhs : u_L ^ n * (HomogeneousLocalization.Away.mk 𝒜 hL n a ha).val =
        algebraMap A Loc_L a := by
      rw [mul_comm, HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      let sn : Submonoid.powers L := ⟨L ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers L) n⟩
      have hpow : u_L ^ n = algebraMap A Loc_L sn.1 := (map_pow _ _ n).symm
      rw [hpow]
      exact IsLocalization.mk'_spec Loc_L a sn
    have hlhs : u_L ^ n * (ψ_L (ev_L a)).val = algebraMap A Loc_L a := by
      rw [← HomogeneousLocalization.algebraMap_apply]
      have ha_hom : MvPolynomial.IsHomogeneous a n := by
        have ha' : a ∈ 𝒜 n := by simpa using ha
        exact (MvPolynomial.mem_homogeneousSubmodule n a).mp ha'
      conv_lhs => rw [MvPolynomial.as_sum a]
      conv_rhs => rw [MvPolynomial.as_sum a]
      rw [map_sum, map_sum, map_sum, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl fun v hv => ?_
      have hv_ne := MvPolynomial.mem_support_iff.mp hv
      have hv_deg : (∑ ν : Fin (N + 1), v ν) = n := by
        have hdeg := ha_hom hv_ne
        dsimp [Finsupp.weight, LinearMap.toAddMonoidHom] at hdeg
        rw [Finsupp.linearCombination_apply,
          Finsupp.sum_fintype _ _ (fun _ => by simp)] at hdeg
        simpa using hdeg
      have hmon : MvPolynomial.monomial v (a.coeff v) =
          MvPolynomial.C (a.coeff v) * ∏ ν : Fin (N + 1), MvPolynomial.X ν ^ v ν := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
      rw [hmon, map_mul, map_prod, map_mul, map_prod]
      have hC_map : val_L (ψ_L (ev_L (MvPolynomial.C (a.coeff v)))) =
          algebraMap A Loc_L (MvPolynomial.C (a.coeff v)) := by
        have heC : ev_L (MvPolynomial.C (a.coeff v)) = MvPolynomial.C (a.coeff v) :=
          MvPolynomial.eval₂Hom_C _ _ _
        have hψC : ψ_L (MvPolynomial.C (a.coeff v)) = c_L (a.coeff v) :=
          MvPolynomial.eval₂Hom_C _ _ _
        rw [heC, hψC, hval_c]
      have hprod_map :
          (∏ ν : Fin (N + 1), u_L ^ v ν) *
            (∏ ν : Fin (N + 1), val_L (ψ_L (ev_L (MvPolynomial.X ν ^ v ν)))) =
          ∏ ν : Fin (N + 1), algebraMap A Loc_L (MvPolynomial.X ν) ^ v ν := by
        rw [← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun ν _ => ?_
        rw [map_pow, map_pow, hψε_X ν, map_pow, ← mul_pow, ht_mul ν]
      rw [map_mul, map_prod, hC_map, ← hv_deg, ← Finset.prod_pow_eq_pow_sum]
      calc
        (∏ ν : Fin (N + 1), u_L ^ v ν) *
            (algebraMap A Loc_L (MvPolynomial.C (a.coeff v)) *
              ∏ ν : Fin (N + 1), val_L (ψ_L (ev_L (MvPolynomial.X ν ^ v ν))))
          = algebraMap A Loc_L (MvPolynomial.C (a.coeff v)) *
              ((∏ ν : Fin (N + 1), u_L ^ v ν) *
                ∏ ν : Fin (N + 1), val_L (ψ_L (ev_L (MvPolynomial.X ν ^ v ν)))) := by ring
        _ = algebraMap A Loc_L (MvPolynomial.C (a.coeff v)) *
              ∏ ν : Fin (N + 1), algebraMap A Loc_L (MvPolynomial.X ν) ^ v ν := by
            rw [hprod_map]
        _ = algebraMap A Loc_L
              (MvPolynomial.C (a.coeff v) * ∏ ν : Fin (N + 1), MvPolynomial.X ν ^ v ν) := by
            simp [map_mul, map_pow, map_prod]
    rw [hlhs, hrhs]

  let Θ_L : HomogeneousLocalization.Away 𝒜 L ≃+* P_aff :=
    { φ_L with
      invFun := ψ_L
      left_inv := fun z => congrArg (fun f => f z) hψφ
      right_inv := fun p => congrArg (fun f => f p) hφψ }

  have hΘ_sL : Θ_L s_L = q_aff := by
    change φ_L (HomogeneousLocalization.Away.mk 𝒜 hL 2 F_amb_Ω hF) = q_aff
    rw [hφ_mk 2 F_amb_Ω hF]
    let term : ℕ → A := fun j =>
      if h : 2 * j + 1 < N + 1 then
        (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ : A) * MvPolynomial.X ⟨2 * j + 1, h⟩
      else 0
    change ev_L (∑ j ∈ Finset.range (m + 1 + 1), term j) = q_aff
    rw [Finset.sum_range_succ' term (m + 1), add_comm _ (term 0), map_add, map_sum,
      ← Fin.sum_univ_eq_sum_range (fun j => ev_L (term (j + 1))) (m + 1)]
    have ht0 : ev_L (term 0) =
        (1 - MvPolynomial.C c_0 * (MvPolynomial.X (Sum.inl 0) : P_aff)) *
          MvPolynomial.X (Sum.inl 0) := by
      have h0_lt : 2 * 0 + 1 < N + 1 := by dsimp [N]; omega
      dsimp only [term]
      rw [dif_pos h0_lt, map_mul]
      have hidx0 : (⟨2 * 0, Nat.lt_of_succ_lt h0_lt⟩ : Fin (N + 1)) = 0 := Fin.ext rfl
      have hidx1 : (⟨2 * 0 + 1, h0_lt⟩ : Fin (N + 1)) = 1 := Fin.ext hval1.symm
      rw [hidx0, hidx1, hev_X0, hev_X1]
    have htsucc : ∀ j : Fin (m + 1), ev_L (term (j.1 + 1)) =
        (MvPolynomial.X (Sum.inr (j, 0)) : P_aff) * MvPolynomial.X (Sum.inr (j, 1)) := by
      intro j
      have hj_lt : 2 * (j.1 + 1) + 1 < N + 1 := by dsimp [N]; omega
      dsimp only [term]
      rw [dif_pos hj_lt, map_mul]
      let ν₀ : Fin (N + 1) := ⟨2 * (j.1 + 1), Nat.lt_of_succ_lt hj_lt⟩
      let ν₁ : Fin (N + 1) := ⟨2 * (j.1 + 1) + 1, hj_lt⟩
      have hν₀_val : ν₀.1 = 2 * (j.1 + 1) := rfl
      have hν₁_val : ν₁.1 = 2 * (j.1 + 1) + 1 := rfl
      have hev0 : ev_L (MvPolynomial.X ν₀) = MvPolynomial.X (Sum.inr (j, 0)) := by
        dsimp [ev_L, var_map]
        rw [MvPolynomial.eval₂Hom_X', if_neg (by rw [hν₀_val]; omega),
          if_neg (by rw [hν₀_val]; omega)]
        congr 2
        exact Prod.ext
          (Fin.ext (by change (ν₀.1 - 2) / 2 = j.1; rw [hν₀_val]; omega))
          (Fin.ext (by change (ν₀.1 - 2) % 2 = 0; rw [hν₀_val]; omega))
      have hev1 : ev_L (MvPolynomial.X ν₁) = MvPolynomial.X (Sum.inr (j, 1)) := by
        dsimp [ev_L, var_map]
        rw [MvPolynomial.eval₂Hom_X', if_neg (by rw [hν₁_val]; omega),
          if_neg (by rw [hν₁_val]; omega)]
        congr 2
        exact Prod.ext
          (Fin.ext (by change (ν₁.1 - 2) / 2 = j.1; rw [hν₁_val]; omega))
          (Fin.ext (by change (ν₁.1 - 2) % 2 = 1; rw [hν₁_val]; omega))
      exact congrArg₂ (· * ·) hev0 hev1
    rw [ht0, Finset.sum_congr rfl (fun j _ => htsucc j)]

  
  let κ : Fin N ≃ σ_aff :=
    { toFun := fun k =>
        if k.1 = 0 then Sum.inl 0
        else Sum.inr (⟨(k.1 - 1) / 2, by dsimp [N] at k; omega⟩,
          ⟨(k.1 - 1) % 2, by omega⟩)
      invFun := fun s => match s with
        | Sum.inl _ => ⟨0, by dsimp [N]; omega⟩
        | Sum.inr (j, p) => ⟨2 * j.1 + 1 + p.1, by dsimp [N]; omega⟩
      left_inv := fun k => by
        by_cases hk0 : k.1 = 0
        · simp only [hk0, ↓reduceIte]
          exact Fin.ext hk0.symm
        · simp only [hk0, ↓reduceIte]
          exact Fin.ext (by dsimp; omega)
      right_inv := fun s => by
        rcases s with u | ⟨j, p⟩
        · have hu0 : u = 0 := Subsingleton.elim u 0
          subst hu0
          rfl
        · dsimp
          rw [if_neg (by omega)]
          congr 1
          exact Prod.ext (Fin.ext (by dsimp; omega)) (Fin.ext (by dsimp; omega)) }

  let Ξ_H : MvPolynomial (Fin N) Ω ≃+* HomogeneousLocalization.Away 𝒜 L :=
    (MvPolynomial.renameEquiv Ω κ).toRingEquiv.trans Θ_L.symm
  have hΞ_H_scalar : ∀ c : Ω, Ξ_H (MvPolynomial.C c) = c_L c := by
    intro c
    change ψ_L ((MvPolynomial.rename κ) (MvPolynomial.C c)) = c_L c
    rw [MvPolynomial.rename_C]
    exact MvPolynomial.eval₂Hom_C _ _ _

  let iso_HL : H_L'.toScheme ≅
      AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 L)) :=
    AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 L hL zero_lt_one
  let e_cat_H : CommRingCat.of (MvPolynomial (Fin N) Ω) ≅
      CommRingCat.of (HomogeneousLocalization.Away 𝒜 L) :=
    { hom := CommRingCat.ofHom Ξ_H.toRingHom
      inv := CommRingCat.ofHom Ξ_H.symm.toRingHom
      hom_inv_id := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        exact Ξ_H.symm_apply_apply
      inv_hom_id := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        exact Ξ_H.apply_symm_apply }
  let spec_H : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 L)) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin N) Ω)) :=
    { hom := AlgebraicGeometry.Spec.map e_cat_H.hom
      inv := AlgebraicGeometry.Spec.map e_cat_H.inv
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, e_cat_H.inv_hom_id,
          AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, e_cat_H.hom_inv_id,
          AlgebraicGeometry.Spec.map_id] }
  let e_H : H_L.toScheme ≅ (weilAffineSpaceOver Ω N).left := iso_HL ≪≫ spec_H

  have he_H : e_H.hom ≫ (weilAffineSpaceOver Ω N).hom =
      H_L.ι ≫ (weilProjectiveSpaceOver Ω N).hom := by
    change (iso_HL ≪≫ spec_H).hom ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : Ω →+* MvPolynomial (Fin N) Ω)) =
      H_L'.ι ≫ P_hom
    rw [← CategoryTheory.Iso.cancel_iso_inv_left iso_HL]
    have hlhs : iso_HL.inv ≫ ((iso_HL ≪≫ spec_H).hom ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : Ω →+* MvPolynomial (Fin N) Ω))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : Ω →+* MvPolynomial (Fin N) Ω) ≫
            CommRingCat.ofHom Ξ_H.toRingHom) := by
      dsimp only [spec_H, e_cat_H]
      rw [CategoryTheory.Iso.trans_hom, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc, iso_HL.inv_hom_id, CategoryTheory.Category.id_comp,
        ← AlgebraicGeometry.Spec.map_comp]
    have hrhs : iso_HL.inv ≫ (H_L'.ι ≫ P_hom) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L))) := by
      dsimp only [iso_HL, P_hom]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 L hL zero_lt_one,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜 L hL zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp]
    rw [hlhs, hrhs]
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact hΞ_H_scalar c

  
  have hAwayL_bij : Function.Bijective awaySec_L.hom := by
    let isoA := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 L hL zero_lt_one
    have hIsoHom : awaySec_L = isoA.hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 L hL zero_lt_one).symm
    rw [hIsoHom]
    exact isoA.commRingCatIsoToRingEquiv.bijective
  have hβL_surj : Function.Surjective β_L :=
    (AlgebraicGeometry.Scheme.Hom.app_surjective f_Q H_L' hAff_HL).comp hAwayL_bij.2

  let Υ_L : P_aff →+* ↑(Q_amb.left.presheaf.obj (Opposite.op U_L')) :=
    β_L.comp Θ_L.symm.toRingHom
  have hΥ_surj : Function.Surjective Υ_L := hβL_surj.comp Θ_L.symm.surjective
  have hGen_symm : Θ_L.symm q_aff = s_L := by
    rw [← hΘ_sL, Θ_L.symm_apply_apply]
  have hΥ_ker : RingHom.ker Υ_L = I_aff := by
    change RingHom.ker Υ_L = Ideal.span {q_aff}
    apply le_antisymm
    · intro p hp
      have hmem : Θ_L.symm p ∈ RingHom.ker β_L := hp
      rw [hβL_ker, Ideal.mem_span_singleton] at hmem
      rcases hmem with ⟨r, hr⟩
      rw [← hGen_symm] at hr
      obtain ⟨q, rfl⟩ : ∃ q : P_aff, Θ_L.symm q = r := ⟨Θ_L r, Θ_L.symm_apply_apply r⟩
      rw [← map_mul] at hr
      rw [Ideal.mem_span_singleton]
      exact ⟨q, Θ_L.symm.injective hr⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      change β_L (Θ_L.symm q_aff) = 0
      rw [hGen_symm]
      have hmem : s_L ∈ RingHom.ker β_L := by
        rw [hβL_ker]
        exact Ideal.subset_span rfl
      exact hmem

  let e_quot : (P_aff ⧸ I_aff) ≃+* (P_aff ⧸ RingHom.ker Υ_L) :=
    Ideal.quotientEquiv I_aff (RingHom.ker Υ_L) (RingEquiv.refl P_aff)
      (by
        apply le_antisymm
        · rw [hΥ_ker]
          intro x hx
          exact Ideal.mem_map_of_mem _ hx
        · rw [Ideal.map_le_iff_le_comap, hΥ_ker]
          intro x hx
          exact hx)
  let Ψ_U : (P_aff ⧸ I_aff) ≃+* ↑(Q_amb.left.presheaf.obj (Opposite.op U_L')) :=
    e_quot.trans (RingHom.quotientKerEquivOfSurjective hΥ_surj)
  have hΨ_scalar : ∀ c : Ω,
      Ψ_U (((Ideal.Quotient.mk I_aff).comp (MvPolynomial.C : Ω →+* P_aff)) c) =
        β_L (c_L c) := by
    intro c
    change β_L (ψ_L (MvPolynomial.C c)) = β_L (c_L c)
    rw [MvPolynomial.eval₂Hom_C]

  let e_cat_U : CommRingCat.of (P_aff ⧸ I_aff) ≅
      Q_amb.left.presheaf.obj (Opposite.op U_L') :=
    { hom := CommRingCat.ofHom Ψ_U.toRingHom
      inv := CommRingCat.ofHom Ψ_U.symm.toRingHom
      hom_inv_id := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        exact Ψ_U.symm_apply_apply
      inv_hom_id := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        exact Ψ_U.apply_symm_apply }
  let spec_U : AlgebraicGeometry.Spec (Q_amb.left.presheaf.obj (Opposite.op U_L')) ≅ A_aff :=
    { hom := AlgebraicGeometry.Spec.map e_cat_U.hom
      inv := AlgebraicGeometry.Spec.map e_cat_U.inv
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, e_cat_U.inv_hom_id,
          AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, e_cat_U.hom_inv_id,
          AlgebraicGeometry.Spec.map_id] }
  let e_Usm' : U_L'.toScheme ≅ A_aff := hAff_UL.isoSpec ≪≫ spec_U

  have hStep1 : U_L'.toSpecΓ ≫
      AlgebraicGeometry.Spec.map (awaySec_L ≫ f_Q.appLE H_L' U_L' le_rfl) =
      (f_Q ∣_ H_L') ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 L hL zero_lt_one).hom := by
    rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE f_Q H_L' U_L' le_rfl,
      AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict,
      CategoryTheory.Category.assoc]
    congr 1
  have hStep2 : U_L'.toSpecΓ ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_L) ≫
      AlgebraicGeometry.Proj.awayι 𝒜 L hL zero_lt_one =
      U_L'.ι ≫ f_Q := by
    have hEqMor : awaySec_L ≫ f_Q.appLE H_L' U_L' le_rfl = CommRingCat.ofHom β_L := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE f_Q]
      rfl
    rw [← hEqMor, ← CategoryTheory.Category.assoc, hStep1, CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 L hL zero_lt_one,
      CategoryTheory.Iso.hom_inv_id_assoc,
      AlgebraicGeometry.morphismRestrict_ι]

  have he_Usm : e_Usm'.hom ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk I_aff).comp (MvPolynomial.C : Ω →+* P_aff))) =
      U_L'.ι ≫ Q_amb.hom := by
    have hcomp := congrArg (fun g => g ≫ P_hom) hStep2
    have hrhs : (U_L'.ι ≫ f_Q) ≫ P_hom = U_L'.ι ≫ Q_amb.hom := by
      rw [CategoryTheory.Category.assoc]
      exact congrArg (U_L'.ι ≫ ·) hι_amb
    rw [hrhs] at hcomp
    rw [← hcomp]
    dsimp only [e_Usm', spec_U, e_cat_U, P_hom]
    rw [CategoryTheory.Iso.trans_hom, hAff_UL.isoSpec_hom, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact hΨ_scalar c

  exact ⟨W_aff, e_H, j_UH, e_Usm', ⟨hAff_W, hCompl_W⟩, hAff_UL, he_H, hj_UH, he_Usm⟩

theorem weil_quad_cvs_given_cone_blowup_and_smooth_slice_charts : (∀ (K : Type u) [Field K] (N : ℕ),
      AlgebraicGeometry.SmoothOfRelativeDimension N (weilProjectiveSpaceOver K N).hom ∧
      ∃ (i_hyp : weilProjectiveSpaceOver K N ⟶ weilProjectiveSpaceOver K (N + 1))
        (U_P : (weilProjectiveSpaceOver K (N + 1)).left.Opens)
        (e_UP : U_P.toScheme ≅ (weilAffineSpaceOver K (N + 1)).left),
        AlgebraicGeometry.IsClosedImmersion i_hyp.left ∧
        (U_P : Set (weilProjectiveSpaceOver K (N + 1)).left) = (Set.range i_hyp.left.base)ᶜ ∧
        e_UP.hom ≫ (weilAffineSpaceOver K (N + 1)).hom =
          U_P.ι ≫ (weilProjectiveSpaceOver K (N + 1)).hom) ∧
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (n : ℕ),
      let F_split : ∀ d₀ : ℕ, MvPolynomial (Fin (2 * d₀ + 1 + 1)) K :=
        fun d₀ =>
          ∑ j ∈ Finset.range (d₀ + 1),
            if h : 2 * j + 1 < 2 * d₀ + 1 + 1 then
              (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
                MvPolynomial (Fin (2 * d₀ + 1 + 1)) K) *
                MvPolynomial.X ⟨2 * j + 1, h⟩
            else 0
      (∀ (Q_succ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
        [AlgebraicGeometry.IsProper Q_succ.hom]
        (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver K (2 * (n + 1) + 1)).left)
        (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver K (2 * (n + 1) + 1)).hom = Q_succ.hom),
        IsHomogeneousHypersurfacePullbackOver K (2 * (n + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver K (2 * (n + 1) + 1))) (F_split (n + 1)) ι_succ →
        ∃ (Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
          (_ : AlgebraicGeometry.IsProper Z_cone.hom)
          (i_Z : Z_cone ⟶ Q_succ),
          IsHomogeneousHypersurfacePullbackOver K (2 * (n + 1) + 1) 1
            (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) i_Z.left) ∧
      (∀ (Q_succ Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
        [AlgebraicGeometry.IsProper Q_succ.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension (2 * (n + 1)) Q_succ.hom]
        [AlgebraicGeometry.IsProper Z_cone.hom]
        (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver K (2 * (n + 1) + 1)).left)
        (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver K (2 * (n + 1) + 1)).hom = Q_succ.hom)
        (i_Z : Z_cone ⟶ Q_succ),
        IsHomogeneousHypersurfacePullbackOver K (2 * (n + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver K (2 * (n + 1) + 1))) (F_split (n + 1)) ι_succ →
        IsHomogeneousHypersurfacePullbackOver K (2 * (n + 1) + 1) 1
          (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) i_Z.left →
        AlgebraicGeometry.IsIntegral Q_succ.left ∧
        AlgebraicGeometry.IsClosedImmersion i_Z.left ∧
        ∃ (O_succ : Q_succ.left.Opens)
          (e_O : O_succ.toScheme ≅ (weilAffineSpaceOver K (2 * n + 2)).left)
          (Q_n : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
          (_ : AlgebraicGeometry.IsProper Q_n.hom)
          (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * n) Q_n.hom)
          (_ : 1 ≤ n → AlgebraicGeometry.IsIntegral Q_n.left)
          (ι_n : Q_n.left ⟶ (weilProjectiveSpaceOver K (2 * n + 1)).left)
          (p₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Z_cone.left)
          (U_Z : Z_cone.left.Opens)
          (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
          (_ : AlgebraicGeometry.IsProper Z_tilde.hom)
          (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * n + 1) Z_tilde.hom)
          (_ : 1 ≤ n → AlgebraicGeometry.IsIntegral Z_tilde.left)
          (π_Z : Z_tilde ⟶ Z_cone)
          (_ : AlgebraicGeometry.IsProper π_Z.left)
          (_ : AlgebraicGeometry.Surjective π_Z.left)
          (p_Q : Z_tilde ⟶ Q_n)
          (_ : AlgebraicGeometry.IsProper p_Q.left)
          (i₀ i_inf : Q_n ⟶ Z_tilde)
          (V_plus : Z_tilde.left.Opens)
          (s_inf_V : Q_n.left ⟶ V_plus.toScheme)
          (W : Fin (2 * n + 2) → Q_n.left.Opens),
          (e_O.hom ≫ (weilAffineSpaceOver K (2 * n + 2)).hom = O_succ.ι ≫ Q_succ.hom ∧
            (O_succ : Set Q_succ.left) = (Set.range i_Z.left.base)ᶜ) ∧
          (ι_n ≫ (weilProjectiveSpaceOver K (2 * n + 1)).hom = Q_n.hom ∧
            IsHomogeneousHypersurfacePullbackOver K (2 * n + 1) 2
              (𝟙 (weilProjectiveSpaceOver K (2 * n + 1))) (F_split n) ι_n) ∧
          (p₀ ≫ Z_cone.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
            (U_Z : Set Z_cone.left) = (Set.range p₀.base)ᶜ ∧
            CategoryTheory.IsIso (π_Z.left ∣_ U_Z)) ∧
          (i₀ ≫ p_Q = 𝟙 Q_n ∧
            i_inf ≫ p_Q = 𝟙 Q_n ∧
            AlgebraicGeometry.IsClosedImmersion i₀.left ∧
            (V_plus : Set Z_tilde.left) = (Set.range i₀.left.base)ᶜ ∧
            CategoryTheory.IsPullback i₀.left Q_n.hom π_Z.left p₀ ∧
            s_inf_V ≫ V_plus.ι = i_inf.left) ∧
          ((⨆ b : Fin (2 * n + 2), W b) = ⊤ ∧
            ∀ b : Fin (2 * n + 2),
              let V_b : V_plus.toScheme.Opens :=
                (TopologicalSpace.Opens.map (V_plus.ι ≫ p_Q.left).base).obj (W b)
              ∃ (e_Wb : (W b).toScheme ≅ (weilAffineSpaceOver K (2 * n)).left)
                (e_Vb : V_b.toScheme ≅
                  CategoryTheory.Limits.pullback (weilAffineSpaceOver K (2 * n)).hom
                    (weilAffineSpaceOver K 1).hom),
                e_Wb.hom ≫ (weilAffineSpaceOver K (2 * n)).hom = (W b).ι ≫ Q_n.hom ∧
                e_Vb.hom ≫
                    CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K (2 * n)).hom
                      (weilAffineSpaceOver K 1).hom =
                  ((V_plus.ι ≫ p_Q.left) ∣_ (W b)) ≫ e_Wb.hom) ∧
          (n = 0 →
            let W_tilde : Fin (2 * n + 2) → Z_tilde.left.Opens :=
              fun b => (TopologicalSpace.Opens.map p_Q.left.base).obj (W b)
            W_tilde ⟨0, by omega⟩ ⊓ W_tilde ⟨1, by omega⟩ = ⊥ ∧
            W_tilde ⟨0, by omega⟩ ⊔ W_tilde ⟨1, by omega⟩ = ⊤ ∧
            ∀ b : Fin (2 * n + 2),
              ∃ e_P1 : (W_tilde b).toScheme ≅ (weilProjectiveSpaceOver K 1).left,
                e_P1.hom ≫ (weilProjectiveSpaceOver K 1).hom =
                  (W_tilde b).ι ≫ Z_tilde.hom))) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m : ℕ) (c_0 : Ω) (_ : c_0 ≠ 0)
      (Q_amb Q_sm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      [AlgebraicGeometry.IsProper Q_amb.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_amb.hom]
      [AlgebraicGeometry.IsProper Q_sm.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Q_sm.hom]
      (ι_amb : Q_amb.left ⟶ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left)
      (hι_amb : ι_amb ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb.hom)
      (i_sm : Q_sm ⟶ Q_amb),
      let F_amb_Ω : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω :=
        ∑ j ∈ Finset.range (m + 1 + 1),
          if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0
      let I_aff : Ideal (MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω) :=
        Ideal.span {((1 - MvPolynomial.C c_0 *
          (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω)) *
          MvPolynomial.X (Sum.inl 0) +
          ∑ j : Fin (m + 1),
            (MvPolynomial.X (Sum.inr (j, 0)) : MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω) *
              MvPolynomial.X (Sum.inr (j, 1)))}
      let A_aff : AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω ⧸ I_aff))
      IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 2
        (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))) F_amb_Ω ι_amb →
      IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 1
        (CategoryTheory.Over.homMk ι_amb hι_amb)
        (MvPolynomial.X 0 + MvPolynomial.C c_0 * MvPolynomial.X 1) i_sm.left →
      AlgebraicGeometry.IsIntegral Q_amb.left ∧
      AlgebraicGeometry.IsIntegral Q_sm.left ∧
      AlgebraicGeometry.IsClosedImmersion i_sm.left ∧
      ∃ (W_aff H_aff : (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left.Opens)
        (e_H : H_aff.toScheme ≅ (weilAffineSpaceOver Ω (2 * (m + 1) + 1)).left)
        (U_sm : Q_amb.left.Opens)
        (j_UH : U_sm.toScheme ⟶ H_aff.toScheme)
        (e_Usm : U_sm.toScheme ≅ A_aff),
        AlgebraicGeometry.IsAffineOpen W_aff ∧
        (W_aff : Set (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left) =
          (Set.range ι_amb.base)ᶜ ∧
        (U_sm : Set Q_amb.left) = (Set.range i_sm.left.base)ᶜ ∧
        AlgebraicGeometry.IsAffineOpen U_sm ∧
        topologicalKrullDim U_sm.toScheme ≤ (((2 * (m + 1) : ℕ) : WithBot ℕ∞)) ∧
        e_H.hom ≫ (weilAffineSpaceOver Ω (2 * (m + 1) + 1)).hom =
          H_aff.ι ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom ∧
        j_UH ≫ H_aff.ι = U_sm.ι ≫ ι_amb ∧
        e_Usm.hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_aff).comp
            (MvPolynomial.C : Ω →+* MvPolynomial (Fin 1 ⊕ (Fin (m + 1) × Fin 2)) Ω))) =
          U_sm.ι ≫ Q_amb.hom) :=
by
  classical
  have hIntOfAlgClosed : ∀ (F₀ : Type u) [Field F₀] [IsAlgClosed F₀]
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₀))),
      AlgebraicGeometry.IsIntegral (weilBaseChangeOver F₀ (AlgebraicClosure F₀) Y).left →
      AlgebraicGeometry.IsIntegral Y.left := by
    intro F₀ _ _ Y hInt_bar
    have hBij : Function.Bijective (algebraMap F₀ (AlgebraicClosure F₀)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_k : F₀ ≃+* AlgebraicClosure F₀ :=
      RingEquiv.ofBijective (algebraMap F₀ (AlgebraicClosure F₀)) hBij
    let g_bc : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F₀)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of F₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀)))
    have hg_iso : CategoryTheory.IsIso g_bc :=
      ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_k.symm.toRingHom),
        by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : (algebraMap F₀ (AlgebraicClosure F₀)).comp e_k.symm.toRingHom =
              RingHom.id (AlgebraicClosure F₀) :=
            RingHom.ext e_k.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
        by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_k.symm.toRingHom.comp (algebraMap F₀ (AlgebraicClosure F₀)) =
              RingHom.id F₀ :=
            RingHom.ext e_k.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    let pr_Y : (weilBaseChangeOver F₀ (AlgebraicClosure F₀) Y).left ⟶ Y.left :=
