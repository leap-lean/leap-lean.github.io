        CategoryTheory.IsPullback.isoPullback_hom_snd]
    let Q'_Ω := CategoryTheory.Limits.pullback ι_succ (π_PR_Ω ≫ Ψ_fam)
    let p_sub_Ω := CategoryTheory.Limits.pullback.snd ι_succ (π_PR_Ω ≫ Ψ_fam)
    let p'_Ω := p_sub_Ω ≫ (weilProjectiveSpaceOver Ω M).hom
    let β_Ω : CategoryTheory.Limits.pullback ι_succ (π_PΩ ≫ Ψ_fam) ≅ Q'_Ω :=
      { hom := CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst ι_succ (π_PΩ ≫ Ψ_fam))
          (CategoryTheory.Limits.pullback.snd ι_succ (π_PΩ ≫ Ψ_fam) ≫ α_Ω.hom)
          (by rw [Category.assoc, ← Category.assoc α_Ω.hom, hα_π]
              exact CategoryTheory.Limits.pullback.condition)
        inv := CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst ι_succ (π_PR_Ω ≫ Ψ_fam))
          (CategoryTheory.Limits.pullback.snd ι_succ (π_PR_Ω ≫ Ψ_fam) ≫ α_Ω.inv)
          (by
            have hinv : α_Ω.inv ≫ π_PΩ = π_PR_Ω := by
              rw [← hα_π, ← Category.assoc, α_Ω.inv_hom_id, Category.id_comp]
            rw [Category.assoc, ← Category.assoc α_Ω.inv, hinv]
            exact CategoryTheory.Limits.pullback.condition)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              Category.assoc, α_Ω.hom_inv_id, Category.comp_id, Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              Category.assoc, α_Ω.inv_hom_id, Category.comp_id, Category.id_comp] }
    let e_Qsm_CR : Q_sm_Ω.left ≅ Q'_Ω := hSq_LRΩ.isoPullback ≪≫ β_Ω
    have he_Qsm_p' : e_Qsm_CR.hom ≫ p'_Ω = Q_sm_Ω.hom := by
      dsimp [e_Qsm_CR, β_Ω, p'_Ω, p_sub_Ω]
      rw [Category.assoc, ← Category.assoc (CategoryTheory.Limits.pullback.lift _ _ _),
        CategoryTheory.Limits.pullback.lift_snd, Category.assoc, hα_hom,
        ← Category.assoc, CategoryTheory.IsPullback.isoPullback_hom_snd, hv_Ω_hom]

    let v_Ω_fn : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) Ω :=
      Fin.cases (-MvPolynomial.C (γ_Ω Polynomial.X) * MvPolynomial.X 0)
        (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))
    let ψ_Ω_fn : MvPolynomial (Fin (M + 1 + 1)) k →+* MvPolynomial (Fin (M + 1)) Ω :=
      MvPolynomial.eval₂Hom (MvPolynomial.C.comp (γ_Ω.comp Polynomial.C)) v_Ω_fn
    have hψ_G_Ω : ψ_Ω_fn F_amb_k =
        -MvPolynomial.C (φ_R_Ω h_R) * MvPolynomial.X 0 * MvPolynomial.X 0 +
          ∑ j : Fin (m + 1),
            (MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ : MvPolynomial (Fin (M + 1)) Ω) *
              MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ := by
      change MvPolynomial.eval₂Hom _ _ F_amb_k = _
      rw [hψF_eq Ω (γ_Ω.comp Polynomial.C) (γ_Ω Polynomial.X), hγ_Ω_X]
    have hF_Ω_hom : ψ_Ω_fn F_amb_k ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω ((2 : ℕ) • 1) := by
      rw [hψ_G_Ω]
      exact hG_hom Ω (φ_R_Ω h_R)

    obtain ⟨hCov_Q'Ω, ⟨e₀_Ω, _, hOpen0_Ω⟩, he_a_Ω⟩ :=
      hS6_chart k Ω (γ_Ω.comp Polynomial.C) 2 (γ_Ω Polynomial.X) (by decide)
        F_amb_k hF_Ω_hom Q_succ ι_succ (π_PR_Ω ≫ Ψ_fam)
        hSplit_succ hD1_Ω hDa_Ω hφ0_Ω hφa_Ω
    obtain ⟨⟨θ₀_Ω, _, hθ₀_Ω_X⟩, hθ_a_Ω⟩ :=
      weil_odp_qdeg_dehom_chart_ring_equivalences Ω m (φ_R_Ω h_R)
        (ψ_Ω_fn F_amb_k) hψ_G_Ω hF_Ω_hom

    let ℬ_Ω := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω
    let _ : GradedAlgebra ℬ_Ω := MvPolynomial.gradedAlgebra
    let U'_0_Ω : Q'_Ω.Opens :=
      (TopologicalSpace.Opens.map p_sub_Ω.base).obj (weilProjBasicOpen Ω M 0)
    let V'_Ω : Fin M → Q'_Ω.Opens :=
      fun a => (TopologicalSpace.Opens.map p_sub_Ω.base).obj (weilProjBasicOpen Ω M a.succ)

    have hV'_Ω_top : (⨆ a : Fin M, V'_Ω a) = ⊤ := by
      have hle : U'_0_Ω ≤ ⨆ a : Fin M, V'_Ω a := by
        intro y hy
        by_contra hnot
        let f₀_M := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_Ω.symm.toRingHom) ≫ e₀_Ω.hom
        have hf₀_surj : Function.Surjective f₀_M.base :=
          ((specEquivIso θ₀_Ω).symm ≪≫ e₀_Ω).hom.homeomorph.surjective
        obtain ⟨z, hz⟩ := hf₀_surj ⟨y, hy⟩
        have hz_val : (f₀_M ≫ U'_0_Ω.ι).base z = y := congrArg Subtype.val hz
        have hX_mem : ∀ (j : Fin (m + 1)) (b : Fin 2),
            Ideal.Quotient.mk _ (MvPolynomial.X (j, b)) ∈ z.asIdeal := by
          intro j b
          let a : Fin M := ⟨2 * j.1 + b.1, by omega⟩
          have hy_not_a : y ∉ V'_Ω a := fun hya => hnot (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hya⟩)
          have hz_not : z ∉ (TopologicalSpace.Opens.map (f₀_M ≫ U'_0_Ω.ι).base).obj (V'_Ω a) := by
            intro hmem
            exact hy_not_a (hz_val ▸ hmem)
          have hpre_eq :
              (TopologicalSpace.Opens.map (f₀_M ≫ U'_0_Ω.ι).base).obj (V'_Ω a) =
                PrimeSpectrum.basicOpen (θ₀_Ω.symm (Ideal.Quotient.mk _
                  (HomogeneousLocalization.Away.isLocalizationElem
                    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                      (MvPolynomial.isHomogeneous_X Ω 0))
                    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                      (MvPolynomial.isHomogeneous_X Ω a.succ))))) := by
            change (TopologicalSpace.Opens.map
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_Ω.symm.toRingHom)).base).obj
              ((TopologicalSpace.Opens.map (e₀_Ω.hom ≫ U'_0_Ω.ι).base).obj (V'_Ω a)) = _
            rw [hOpen0_Ω a]
            ext p
            exact Iff.rfl
          have hθ_symm :
              θ₀_Ω.symm (Ideal.Quotient.mk _
                (HomogeneousLocalization.Away.isLocalizationElem
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X Ω 0))
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X Ω a.succ)))) =
              Ideal.Quotient.mk _ (MvPolynomial.X (j, b)) := by
            apply θ₀_Ω.injective
            rw [θ₀_Ω.apply_symm_apply, hθ₀_Ω_X j b]
            rfl
          rw [hpre_eq, hθ_symm] at hz_not
          exact Classical.not_not.mp hz_not
        let I_odp : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) Ω) :=
          Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C (φ_R_Ω h_R)}
        have hsum_mem :
            Ideal.Quotient.mk I_odp
              (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) ∈ z.asIdeal := by
          rw [map_sum]
          refine Ideal.sum_mem _ fun j _ => ?_
          rw [map_mul]
          exact Ideal.mul_mem_right _ _ (hX_mem j 0)
        have hrel_zero :
            Ideal.Quotient.mk I_odp
              ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                MvPolynomial.C (φ_R_Ω h_R)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have hc0_mem :
            Ideal.Quotient.mk I_odp (MvPolynomial.C (φ_R_Ω h_R)) ∈ z.asIdeal := by
          rw [map_sub, sub_eq_zero] at hrel_zero
          exact Eq.mp (congrArg (fun u => u ∈ z.asIdeal) hrel_zero) hsum_mem
        have h1_mem : (1 : _) ∈ z.asIdeal := by
          have hmul := z.asIdeal.mul_mem_right
            (Ideal.Quotient.mk _ (MvPolynomial.C (φ_R_Ω h_R)⁻¹)) hc0_mem
          rwa [← map_mul, ← map_mul, mul_inv_cancel₀ hc0_ne, map_one, map_one] at hmul
        exact z.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
      rw [← hCov_Q'Ω]
      exact (sup_eq_right.mpr hle).symm

    let C_Ω : Fin M → Q_sm_Ω.left.Opens :=
      fun a => (TopologicalSpace.Opens.map e_Qsm_CR.hom.base).obj (V'_Ω a)
    have hC_Ω_cov : (⨆ a : Fin M, C_Ω a) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : e_Qsm_CR.hom.base x ∈ (⨆ a : Fin M, V'_Ω a) := by
        rw [hV'_Ω_top]
        trivial
      obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxa⟩
    have hC_Ω_iso : ∀ a : Fin M,
        ∃ e_i : (C_Ω a).toScheme ≅ (weilAffineSpaceOver Ω (2 * m + 1)).left,
          e_i.hom ≫ (weilAffineSpaceOver Ω (2 * m + 1)).hom = (C_Ω a).ι ≫ Q_sm_Ω.hom := by
      intro a
      obtain ⟨e_a, he_a⟩ := he_a_Ω a
      obtain ⟨θ_a, hθ_a⟩ := hθ_a_Ω a
      have hrange_Ca :
          Set.range ((C_Ω a).ι ≫ e_Qsm_CR.hom).base = Set.range (V'_Ω a).ι.base := by
        ext y
        constructor
        · rintro ⟨⟨x, hx⟩, rfl⟩
          exact ⟨⟨e_Qsm_CR.hom.base x, hx⟩, rfl⟩
        · rintro ⟨⟨y', hy'⟩, rfl⟩
          refine ⟨⟨e_Qsm_CR.inv.base y', ?_⟩, ?_⟩
          · change e_Qsm_CR.hom.base (e_Qsm_CR.inv.base y') ∈ V'_Ω a
            have hid : (e_Qsm_CR.inv ≫ e_Qsm_CR.hom).base y' = y' := by
              rw [e_Qsm_CR.inv_hom_id]
              rfl
            exact hid.symm ▸ hy'
          · change (e_Qsm_CR.inv ≫ e_Qsm_CR.hom).base y' = y'
            rw [e_Qsm_CR.inv_hom_id]
            rfl
      let iso_Ca : (C_Ω a).toScheme ≅ (V'_Ω a).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
          ((C_Ω a).ι ≫ e_Qsm_CR.hom) (V'_Ω a).ι hrange_Ca
      let iso_aff_a : AlgebraicGeometry.Spec (CommRingCat.of _) ≅
          (weilAffineSpaceOver Ω (2 * m + 1)).left :=
        specEquivIso θ_a
      refine ⟨iso_Ca ≪≫ e_a.symm ≪≫ iso_aff_a, ?_⟩
      have hspec_C :
          iso_aff_a.hom ≫ (weilAffineSpaceOver Ω (2 * m + 1)).hom =
            e_a.hom ≫ (V'_Ω a).ι ≫ p'_Ω := by
        rw [he_a]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ_a]
      dsimp only [Iso.trans_hom, Iso.symm_hom]
      rw [Category.assoc, Category.assoc, hspec_C, ← Category.assoc e_a.inv,
        e_a.inv_hom_id, Category.id_comp, ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac,
        Category.assoc, he_Qsm_p']
    exact ((weil_split_quad_chart_partner_elim_and_irred_cover Ω).1
      (2 * m + 1) M (by omega) Q_sm_Ω C_Ω hC_Ω_cov hC_Ω_iso).1

  
  obtain ⟨π_PR, hPb_PR, hD1_R, hDa_R, hφ0_R, hφa_R⟩ := hΨ_commRing R_bar γ_hR
  let pr₂_Q : Q_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
    CategoryTheory.Limits.pullback.snd π_Qfam.left g_hR
  let p_sub_QR : Q_R ⟶ (weilProjectiveSpaceOver R_bar M).left :=
    hPb_PR.lift
      (CategoryTheory.Limits.pullback.fst π_Qfam.left g_hR ≫
        CategoryTheory.Limits.pullback.snd ι_succ Ψ_fam)
      pr₂_Q
      (by
        rw [Category.assoc]
        exact CategoryTheory.Limits.pullback.condition)
  have hSq_QR_mid : CategoryTheory.IsPullback p_sub_QR
      (CategoryTheory.Limits.pullback.fst π_Qfam.left g_hR) π_PR
      (CategoryTheory.Limits.pullback.snd ι_succ Ψ_fam) :=
    CategoryTheory.IsPullback.of_right
      (by
        rw [CategoryTheory.IsPullback.lift_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback π_Qfam.left g_hR).flip)
      (CategoryTheory.IsPullback.lift_fst _ _ _ _)
      hPb_PR.flip
  have hPb_QR_Q' : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst π_Qfam.left g_hR ≫
        CategoryTheory.Limits.pullback.fst ι_succ Ψ_fam)
      p_sub_QR ι_succ (π_PR ≫ Ψ_fam) :=
    hSq_QR_mid.flip.paste_horiz (CategoryTheory.IsPullback.of_hasPullback ι_succ Ψ_fam)

  let Q'_R := CategoryTheory.Limits.pullback ι_succ (π_PR ≫ Ψ_fam)
  let p_sub_R := CategoryTheory.Limits.pullback.snd ι_succ (π_PR ≫ Ψ_fam)
  let p'_R := p_sub_R ≫ (weilProjectiveSpaceOver R_bar M).hom
  let e_QR : Q_R ≅ Q'_R := hPb_QR_Q'.isoPullback
  have he_QR_p' : e_QR.hom ≫ p'_R = pr₂_Q := by
    dsimp [e_QR, p'_R, p_sub_R]
    rw [← Category.assoc, CategoryTheory.IsPullback.isoPullback_hom_snd,
      CategoryTheory.IsPullback.lift_snd]

  let v_R_fn : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) R_bar :=
    Fin.cases (-MvPolynomial.C (γ_hR Polynomial.X) * MvPolynomial.X 0)
      (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))
  let ψ_R_fn : MvPolynomial (Fin (M + 1 + 1)) k →+* MvPolynomial (Fin (M + 1)) R_bar :=
    MvPolynomial.eval₂Hom (MvPolynomial.C.comp (γ_hR.comp Polynomial.C)) v_R_fn
  have hψ_G_R : ψ_R_fn F_amb_k =
      -MvPolynomial.C h_R * MvPolynomial.X 0 * MvPolynomial.X 0 +
        ∑ j : Fin (m + 1),
          (MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ : MvPolynomial (Fin (M + 1)) R_bar) *
            MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ := by
    change MvPolynomial.eval₂Hom _ _ F_amb_k = _
    rw [hψF_eq R_bar (γ_hR.comp Polynomial.C) (γ_hR Polynomial.X), hg_hR_X]
  have hF_R_hom : ψ_R_fn F_amb_k ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R_bar ((2 : ℕ) • 1) := by
    rw [hψ_G_R]
    exact hG_hom R_bar h_R

  obtain ⟨hCov_Q'R, ⟨e₀_R, he₀_R, hOpen0_R⟩, he_a_R⟩ :=
    hS6_chart k R_bar (γ_hR.comp Polynomial.C) 2 (γ_hR Polynomial.X) (by decide)
      F_amb_k hF_R_hom Q_succ ι_succ (π_PR ≫ Ψ_fam)
      hSplit_succ hD1_R hDa_R hφ0_R hφa_R
  obtain ⟨⟨θ₀_R, hθ₀_R_C, hθ₀_R_X⟩, hθ_a_R⟩ :=
    weil_odp_qdeg_dehom_chart_ring_equivalences R_bar m h_R
      (ψ_R_fn F_amb_k) hψ_G_R hF_R_hom

  let ℬ_R := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R_bar
  let _ : GradedAlgebra ℬ_R := MvPolynomial.gradedAlgebra
  let U'_0_R : Q'_R.Opens :=
    (TopologicalSpace.Opens.map p_sub_R.base).obj (weilProjBasicOpen R_bar M 0)
  let V'_R : Fin M → Q'_R.Opens :=
    fun a => (TopologicalSpace.Opens.map p_sub_R.base).obj (weilProjBasicOpen R_bar M a.succ)
  let U_0 : Q_R.Opens := (TopologicalSpace.Opens.map e_QR.hom.base).obj U'_0_R
  let V_R : Fin M → Q_R.Opens :=
    fun a => (TopologicalSpace.Opens.map e_QR.hom.base).obj (V'_R a)

  have hCov_QR : U_0 ⊔ (⨆ a : Fin M, V_R a) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : e_QR.hom.base x ∈ U'_0_R ⊔ (⨆ a : Fin M, V'_R a) := by
      rw [hCov_Q'R]
      trivial
    rcases hx with h0 | ha
    · exact Or.inl h0
    · obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp ha
      exact Or.inr (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxa⟩)

  have hrange_U0 :
      Set.range (U_0.ι ≫ e_QR.hom).base = Set.range U'_0_R.ι.base := by
    ext y
    constructor
    · rintro ⟨⟨x, hx⟩, rfl⟩
      exact ⟨⟨e_QR.hom.base x, hx⟩, rfl⟩
    · rintro ⟨⟨y', hy'⟩, rfl⟩
      refine ⟨⟨e_QR.inv.base y', ?_⟩, ?_⟩
      · change e_QR.hom.base (e_QR.inv.base y') ∈ U'_0_R
        have hid : (e_QR.inv ≫ e_QR.hom).base y' = y' := by
          rw [e_QR.inv_hom_id]
          rfl
        exact hid.symm ▸ hy'
      · change (e_QR.inv ≫ e_QR.hom).base y' = y'
        rw [e_QR.inv_hom_id]
        rfl
  let iso_U0 : U_0.toScheme ≅ U'_0_R.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
      (U_0.ι ≫ e_QR.hom) U'_0_R.ι hrange_U0

  let e_M : weilOdpModelSpec m (CommRingCat.of R_bar) h_R ≅ U_0.toScheme :=
    (specEquivIso θ₀_R).symm ≪≫ e₀_R ≪≫ iso_U0.symm
  have he_M_ι : e_M.hom ≫ U_0.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
        e₀_R.hom ≫ U'_0_R.ι ≫ e_QR.inv := by
    have hfac : iso_U0.inv ≫ U_0.ι = U'_0_R.ι ≫ e_QR.inv := by
      have h1 := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac
        (U_0.ι ≫ e_QR.hom) U'_0_R.ι hrange_U0
      have h2 := congrArg (· ≫ e_QR.inv) h1
      rwa [Category.assoc, Category.assoc, e_QR.hom_inv_id, Category.comp_id] at h2
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
      (e₀_R.hom ≫ iso_U0.inv)) ≫ U_0.ι = _
    rw [Category.assoc, Category.assoc, hfac]

  have he_M_pr2 : e_M.hom ≫ U_0.ι ≫ pr₂_Q =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
    have hinv_p' : e_QR.inv ≫ pr₂_Q = p'_R := by
      rw [← he_QR_p', ← Category.assoc, e_QR.inv_hom_id, Category.id_comp]
    have hθ₀_C_symm :
        θ₀_R.symm.toRingHom.comp
          ((Ideal.Quotient.mk _).comp
            ((HomogeneousLocalization.fromZeroRingHom ℬ_R
              (Submonoid.powers (MvPolynomial.X 0))).comp
              (algebraMap R_bar ↥(ℬ_R 0)))) =
        (Ideal.Quotient.mk _).comp MvPolynomial.C :=
      RingHom.ext fun r => θ₀_R.injective
        ((θ₀_R.apply_symm_apply _).trans (RingHom.congr_fun hθ₀_R_C r).symm)
    have h_rhs :
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
          e₀_R.hom ≫ U'_0_R.ι ≫ e_QR.inv) ≫ pr₂_Q =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
      calc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
            e₀_R.hom ≫ U'_0_R.ι ≫ e_QR.inv) ≫ pr₂_Q
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
              ((e₀_R.hom ≫ U'_0_R.ι ≫ e_QR.inv) ≫ pr₂_Q) := Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
              (e₀_R.hom ≫ U'_0_R.ι ≫ (e_QR.inv ≫ pr₂_Q)) := by
              rw [Category.assoc, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
              (e₀_R.hom ≫ U'_0_R.ι ≫ p'_R) := by
              rw [hinv_p']
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((Ideal.Quotient.mk _).comp
                  ((HomogeneousLocalization.fromZeroRingHom ℬ_R
                    (Submonoid.powers (MvPolynomial.X 0))).comp
                    (algebraMap R_bar ↥(ℬ_R 0))))) := by
              rw [he₀_R]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ₀_C_symm]
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ pr₂_Q) he_M_ι).trans h_rhs)

  have he_M_basicOpen : ∀ (j : Fin (m + 1)) (b : Fin 2),
      (TopologicalSpace.Opens.map (e_M.hom ≫ U_0.ι).base).obj
        (V_R ⟨2 * j.1 + b.1, by omega⟩) =
        PrimeSpectrum.basicOpen (Ideal.Quotient.mk _ (MvPolynomial.X (j, b))) := by
    intro j b
    let a : Fin M := ⟨2 * j.1 + b.1, by omega⟩
    have hVR_eq : (TopologicalSpace.Opens.map e_QR.inv.base).obj (V_R a) = V'_R a := by
      ext y
      change e_QR.hom.base (e_QR.inv.base y) ∈ V'_R a ↔ y ∈ V'_R a
      have hid : (e_QR.inv ≫ e_QR.hom).base y = y := by
        rw [e_QR.inv_hom_id]
        rfl
      exact hid.symm ▸ Iff.rfl
    change (TopologicalSpace.Opens.map (e_M.hom ≫ U_0.ι).base).obj (V_R a) = _
    rw [he_M_ι]
    change (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom)).base).obj
      ((TopologicalSpace.Opens.map (e₀_R.hom ≫ U'_0_R.ι).base).obj
        ((TopologicalSpace.Opens.map e_QR.inv.base).obj (V_R a))) = _
    rw [hVR_eq, hOpen0_R a]
    have hθ_symm :
        θ₀_R.symm (Ideal.Quotient.mk _
          (HomogeneousLocalization.Away.isLocalizationElem
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
              (MvPolynomial.isHomogeneous_X R_bar 0))
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
              (MvPolynomial.isHomogeneous_X R_bar a.succ)))) =
        Ideal.Quotient.mk _ (MvPolynomial.X (j, b)) := by
      apply θ₀_R.injective
      rw [θ₀_R.apply_symm_apply, hθ₀_R_X j b]
      rfl
    have hcomap :
        (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_R.symm.toRingHom)).base).obj
          (PrimeSpectrum.basicOpen (Ideal.Quotient.mk _
            (HomogeneousLocalization.Away.isLocalizationElem
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                (MvPolynomial.isHomogeneous_X R_bar 0))
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                (MvPolynomial.isHomogeneous_X R_bar a.succ))))) =
        PrimeSpectrum.basicOpen (θ₀_R.symm (Ideal.Quotient.mk _
          (HomogeneousLocalization.Away.isLocalizationElem
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
              (MvPolynomial.isHomogeneous_X R_bar 0))
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
              (MvPolynomial.isHomogeneous_X R_bar a.succ))))) := by
      ext p
      exact Iff.rfl
    rw [hcomap, hθ_symm]

  have _ : AlgebraicGeometry.IsProper π_Qfam.left := hProp_Qfam
  have _ : AlgebraicGeometry.IsSeparated pr₂_Q := by dsimp [pr₂_Q]; infer_instance

  obtain ⟨hS8_aff, hS8_odp, hS8_atlas⟩ :=
    weil_odp_qdeg_affine_pullback_and_atlas_upgrade k m R_bar hSpec2 p_R π_cl hπ_ker hπ_pR
      Ω φ_R_Ω hφ_inj h_R hh_max hh_ne

  obtain ⟨hι_aff_open, zero_Q, U_Q, hzero_Q_cl, _, hzero_M_Q, hU_Q_compl,
    hVR_le_UQ, hVR_sup_UQ, hLift_UQ⟩ :=
    hS8_odp Q_R pr₂_Q U_0 V_R e_M hCov_QR he_M_pr2 he_M_basicOpen
  let ι_aff_Q := e_M.hom ≫ U_0.ι

  obtain ⟨j_Q_open, hj_Q_fac, hPb_j_Q_open⟩ :=
    hLift_UQ Q_sm_Ω.left Q_sm_Ω.hom j_Q_tot hPb_j_Q_tot
  have hjQ_comm : j_Q_open ≫ U_Q.ι ≫ i_hyp_R = i_sm_Ω.left ≫ j_amb_open := by
    rw [← Category.assoc, hj_Q_fac, hjQ_tot_comm]

  
  refine ⟨Q_fam, π_Qfam, hProp_Qfam, g_hR,
    Q_succ, Z_cone, hProp_Qsucc, hSm_Qsucc, hProp_Zcone, ι_succ, hι_succ, i_Z,
    Q_amb_Ω, Q_sm_Ω, hProp_Qamb, hSm_Qamb, hProp_Qsm, hSm_Qsm, ι_amb_Ω, hι_amb_Ω, i_sm_Ω,
    i_hyp_R, e_Qk, zero_Q, ι_aff_Q, U_Q, j_Q_open, j_amb_open,
    ⟨hg_hR_hom, hSplit_succ, hSplit_Z, hSplit_amb, hSplit_sm⟩,
    ⟨hzero_Q_cl, hι_aff_open, hzero_M_Q, hU_Q_compl, hjQ_comm⟩, ?_, ?_⟩

  
  · intro x
    have hx_sup : x.1 ∈ (⨆ a : Fin M, V_R a : Q_R.Opens) := by
      rw [hVR_sup_UQ]
      exact x.2
    obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_sup
    let V : U_Q.toScheme.Opens := (TopologicalSpace.Opens.map U_Q.ι.base).obj (V_R a)
    have hxV : x ∈ V := hxa
    have hrange_V : Set.range (V.ι ≫ U_Q.ι).base = Set.range (V_R a).ι.base := by
      ext y
      constructor
      · rintro ⟨⟨⟨z, hz⟩, hza⟩, rfl⟩
        exact ⟨⟨z, hza⟩, rfl⟩
      · rintro ⟨⟨z, hza⟩, rfl⟩
        exact ⟨⟨⟨z, hVR_le_UQ a hza⟩, hza⟩, rfl⟩
    let iso_V : V.toScheme ≅ (V_R a).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (V.ι ≫ U_Q.ι) (V_R a).ι hrange_V
    have hrange_VR : Set.range ((V_R a).ι ≫ e_QR.hom).base = Set.range (V'_R a).ι.base := by
      ext y
      constructor
      · rintro ⟨⟨z, hz⟩, rfl⟩
        exact ⟨⟨e_QR.hom.base z, hz⟩, rfl⟩
      · rintro ⟨⟨y', hy'⟩, rfl⟩
        refine ⟨⟨e_QR.inv.base y', ?_⟩, ?_⟩
        · change e_QR.hom.base (e_QR.inv.base y') ∈ V'_R a
          have hid : (e_QR.inv ≫ e_QR.hom).base y' = y' := by
            rw [e_QR.inv_hom_id]
            rfl
          exact hid.symm ▸ hy'
        · change (e_QR.inv ≫ e_QR.hom).base y' = y'
          rw [e_QR.inv_hom_id]
          rfl
    let iso_VR : (V_R a).toScheme ≅ (V'_R a).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ((V_R a).ι ≫ e_QR.hom) (V'_R a).ι hrange_VR
    obtain ⟨e_a, he_a⟩ := he_a_R a
    obtain ⟨θ_a, hθ_a⟩ := hθ_a_R a
    obtain ⟨e_aff_1, he_aff_1⟩ := hS8_aff R_bar (p_R.comp Polynomial.C) (2 * m + 1)
    let iso_tot : V.toScheme ≅ A1_R :=
      iso_V ≪≫ iso_VR ≪≫ e_a.symm ≪≫ specEquivIso θ_a ≪≫ e_aff_1
    let φ : V.toScheme ⟶ A1_R := iso_tot.hom
    have hφ_et : AlgebraicGeometry.Etale φ := by
      dsimp [φ]
      infer_instance
    have hφ_base : φ ≫ CategoryTheory.Limits.pullback.snd S_d1.hom g_k_R =
        V.ι ≫ (U_Q.ι ≫ pr₂_Q) := by
      dsimp only [φ, iso_tot, Iso.trans_hom, Iso.symm_hom]
      rw [Category.assoc, Category.assoc, Category.assoc, Category.assoc, he_aff_1]
      have hspec_C :
          (specEquivIso θ_a).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
          e_a.hom ≫ (V'_R a).ι ≫ p'_R := by
        rw [he_a]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ_a]
      change iso_V.hom ≫ iso_VR.hom ≫ e_a.inv ≫
        ((specEquivIso θ_a).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) = _
      rw [hspec_C, ← Category.assoc e_a.inv, e_a.inv_hom_id, Category.id_comp,
        ← Category.assoc iso_VR.hom,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac,
        Category.assoc, he_QR_p', ← Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac, Category.assoc]
    obtain ⟨V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩ :=
      hS8_atlas (2 * m + 1) U_Q.toScheme Q_sm_Ω.left (U_Q.ι ≫ pr₂_Q) Q_sm_Ω.hom j_Q_open
        hPb_j_Q_open V φ hφ_base
    exact ⟨V, hxV, φ, hφ_et, V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩

  
  · intro x
    let fst_amb := CategoryTheory.Limits.pullback.fst Q_succ.hom g_k_R
    let snd_amb := CategoryTheory.Limits.pullback.snd Q_succ.hom g_k_R
    have hx_cov : fst_amb.base x ∈
        (⨆ b : Fin (2 * (m + 1) + 2),
          (TopologicalSpace.Opens.map ι_succ.base).obj
            (weilProjBasicOpen k (2 * (m + 1) + 1) b)) := by
      rw [hW_succ_cov]
      trivial
    obtain ⟨b, hxb⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_cov
    let W_b : Q_succ.left.Opens :=
      (TopologicalSpace.Opens.map ι_succ.base).obj (weilProjBasicOpen k (2 * (m + 1) + 1) b)
    let V : Q_amb_R.Opens := (TopologicalSpace.Opens.map fst_amb.base).obj W_b
    have hxV : x ∈ V := hxb
    obtain ⟨e_Wb, he_Wb⟩ := hW_succ_iso b
    have hPb_res : CategoryTheory.IsPullback (fst_amb ∣_ W_b) V.ι W_b.ι fst_amb :=
      AlgebraicGeometry.isPullback_morphismRestrict fst_amb W_b
    have hPb_V_Wb : CategoryTheory.IsPullback (fst_amb ∣_ W_b) (V.ι ≫ snd_amb)
        (W_b.ι ≫ Q_succ.hom) g_k_R :=
      hPb_res.paste_vert (CategoryTheory.IsPullback.of_hasPullback Q_succ.hom g_k_R)
    have hPb_V_Sd2 : CategoryTheory.IsPullback ((fst_amb ∣_ W_b) ≫ e_Wb.hom) (V.ι ≫ snd_amb)
        S_d2.hom g_k_R := by
      have he_iso : CategoryTheory.IsPullback e_Wb.hom (W_b.ι ≫ Q_succ.hom)
          S_d2.hom (𝟙 _) :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [he_Wb, Category.comp_id]⟩
      have hp := hPb_V_Wb.paste_horiz he_iso
      rwa [Category.comp_id] at hp
    let iso_V_A2 : V.toScheme ≅ A2_R := hPb_V_Sd2.isoPullback
    let φ : V.toScheme ⟶ A2_R := iso_V_A2.hom
    have hφ_et : AlgebraicGeometry.Etale φ := by
      dsimp [φ]
      infer_instance
    have hφ_base : φ ≫ CategoryTheory.Limits.pullback.snd S_d2.hom g_k_R =
        V.ι ≫ snd_amb :=
      CategoryTheory.IsPullback.isoPullback_hom_snd hPb_V_Sd2
    obtain ⟨V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩ :=
      hS8_atlas (2 * (m + 1)) Q_amb_R Q_amb_Ω.left snd_amb Q_amb_Ω.hom j_amb_open
        hPb_j_amb V φ hφ_base
    exact ⟨V, hxV, φ, hφ_et, V_U, ι_VU, j_V, φ_U, hPb1, hPb2⟩

theorem weil_iso_roof_coker_closed_point_skyscraper_eval (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ s : ℕ) [Fact (Nat.Prime ℓ)]
    (X : AlgebraicGeometry.Scheme.{u})
    (x₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X)
    (hx₀ : AlgebraicGeometry.IsClosedImmersion x₀)
    (U : X.Opens) (hU : (U : Set X) = (Set.range x₀.base)ᶜ)
    (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
    (hTors : (ℓ ^ s) • CategoryTheory.CategoryStruct.id 𝒢 = 0)
    (hZeroU : ∃ 𝒢_U : CategoryTheory.Sheaf U.toScheme.smallEtaleTopology AddCommGrpCat.{u},
      WeilIsEtaleSheafPullback U.ι 𝒢 𝒢_U ∧ CategoryTheory.Limits.IsZero 𝒢_U) :
    (Subsingleton (𝒢.H 0) → CategoryTheory.Limits.IsZero 𝒢) ∧
    ∀ (G_k : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback x₀ 𝒢 G_k →
      Nonempty (𝒢.H 0 ≃+ G_k.H 0) :=
by
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  have _ : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hMemEt : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (E : Z.Etale) (R : CategoryTheory.Sieve E),
      R ∈ Z.smallEtaleTopology E ↔
        ∀ (x : ↥E.left), ∃ (Y : Z.Etale) (f : Y ⟶ E) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro Z E R
    exact (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology Z.Etale =>
      R ∈ J E) (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl P_et)))).trans
      (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        P_et P_et Z inferInstance
        inferInstance inferInstance inferInstance inferInstance E R)

  
  
  
  have _ : AlgebraicGeometry.IsClosedImmersion x₀ := hx₀
  let _ : AlgebraicGeometry.IsFinite x₀ :=
    AlgebraicGeometry.IsFinite.instOfIsClosedImmersion x₀
  have _ : CategoryTheory.Mono x₀ :=
    ((AlgebraicGeometry.IsClosedImmersion.iff_isFinite_and_mono x₀).mp hx₀).2
  have hPbMono : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (u : Z ⟶ S_k) (g : Z ⟶ X)
      (hw : u ≫ x₀ = CategoryTheory.CategoryStruct.id Z ≫ g),
      CategoryTheory.IsPullback u (CategoryTheory.CategoryStruct.id Z) x₀ g := by
    intro Z u g hw
    refine { w := hw, isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
      (fun c => c.snd)
      (fun c => (CategoryTheory.cancel_mono x₀).mp
        ((CategoryTheory.Category.assoc c.snd u x₀).trans
          ((congrArg (c.snd ≫ ·) hw).trans
            ((congrArg (c.snd ≫ ·) (CategoryTheory.Category.id_comp g)).trans c.condition.symm))))
      (fun c => CategoryTheory.Category.comp_id c.snd)
      (fun c m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂)⟩ }
  have hpb_self : CategoryTheory.IsPullback
      (CategoryTheory.CategoryStruct.id S_k)
      (CategoryTheory.CategoryStruct.id S_k) x₀ x₀ :=
    hPbMono (CategoryTheory.CategoryStruct.id S_k) x₀ rfl
  have hDichot : ∀ (Ω : Type u) [Field Ω]
      (y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      (∃ y_U : S_Ω ⟶ U.toScheme,
        y_U ≫ U.ι = y ∧
        IsEmpty ↥(CategoryTheory.Limits.pullback x₀ y)) ∨
      (∃ u : S_Ω ⟶ S_k,
        u ≫ x₀ = y ∧
        CategoryTheory.IsPullback u (CategoryTheory.CategoryStruct.id S_Ω) x₀ y) := by
    intro Ω _ y S_Ω
    let pt_Ω : ↥S_Ω := (⊥ : PrimeSpectrum Ω)
    have _ : Subsingleton ↥S_Ω := inferInstanceAs (Subsingleton (PrimeSpectrum Ω))
    have _ : Finite ↥S_Ω := Finite.of_subsingleton
    have _ : Subsingleton ↥S_k := inferInstanceAs (Subsingleton (PrimeSpectrum k))
    have _ : Finite ↥S_k := Finite.of_subsingleton
    by_cases hy_in : y.base pt_Ω ∈ (U : Set X)
    · left
      have hRange : Set.range y.base ⊆ Set.range U.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨p, rfl⟩
        rw [Subsingleton.elim p pt_Ω]
        exact hy_in
      let y_U : S_Ω ⟶ U.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U.ι y hRange
      have hy_fac : y_U ≫ U.ι = y := AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι y hRange
      refine ⟨y_U, hy_fac, ⟨fun p => ?_⟩⟩
      have hcond : x₀.base ((CategoryTheory.Limits.pullback.fst x₀ y).base p) =
          y.base ((CategoryTheory.Limits.pullback.snd x₀ y).base p) :=
        congrArg (fun m : CategoryTheory.Limits.pullback x₀ y ⟶ X => m.base p)
          (CategoryTheory.Limits.pullback.condition (f := x₀) (g := y))
      rw [Subsingleton.elim ((CategoryTheory.Limits.pullback.snd x₀ y).base p) pt_Ω] at hcond
      have hmem_x0 : y.base pt_Ω ∈ Set.range x₀.base :=
        ⟨(CategoryTheory.Limits.pullback.fst x₀ y).base p, hcond⟩
      have hnot_x0 : y.base pt_Ω ∈ (Set.range x₀.base)ᶜ := hU ▸ hy_in
      exact hnot_x0 hmem_x0
    · right
      have hy_x0 : y.base pt_Ω ∈ Set.range x₀.base := by
        by_contra hnot
        exact hy_in (hU.symm ▸ hnot)
      have hRange_le : Set.range y.base ⊆ Set.range x₀.base := by
        rintro _ ⟨p, rfl⟩
        rw [Subsingleton.elim p pt_Ω]
        exact hy_x0
      have _ : AlgebraicGeometry.QuasiCompact y :=
        ⟨fun _ _ _ => (Set.toFinite _).isCompact⟩
      have _ : AlgebraicGeometry.QuasiCompact x₀ :=
        ⟨fun _ _ _ => (Set.toFinite _).isCompact⟩
      have hSupp_le : y.ker.support ≤ x₀.ker.support := by
        change (y.ker.support : Set X) ⊆ (x₀.ker.support : Set X)
        rw [AlgebraicGeometry.Scheme.Hom.support_ker, AlgebraicGeometry.Scheme.Hom.support_ker]
        exact closure_mono hRange_le
      have hRad_le : x₀.ker ≤ y.ker.radical := by
        calc x₀.ker ≤ x₀.ker.radical := AlgebraicGeometry.Scheme.IdealSheafData.le_radical x₀.ker
          _ = AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal x₀.ker.support :=
              (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support (I := x₀.ker)).symm
          _ ≤ AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal y.ker.support :=
              AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_antimono hSupp_le
          _ = y.ker.radical :=
              AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support (I := y.ker)
      have _ : IsReduced Ω := inferInstance
      have _ : AlgebraicGeometry.IsReduced S_Ω :=
        AlgebraicGeometry.instIsReducedSpecOfIsReducedCarrier
      have hRad_y : y.ker.radical ≤ y.ker := by
        intro V r hr
        rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal] at hr
        rcases hr with ⟨n, hn⟩
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hn ⊢
        rw [RingHom.mem_ker] at hn ⊢
        rw [map_pow] at hn
        have _ : IsReduced ↑(S_Ω.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map y.base).obj V.1))) :=
          AlgebraicGeometry.IsReduced.component_reduced ((TopologicalSpace.Opens.map y.base).obj V.1)
        exact IsNilpotent.eq_zero ⟨n, hn⟩
      have hker_le : x₀.ker ≤ y.ker := le_trans hRad_le hRad_y
      let u : S_Ω ⟶ S_k := AlgebraicGeometry.IsClosedImmersion.lift x₀ y hker_le
      have hu_fac : u ≫ x₀ = y := AlgebraicGeometry.IsClosedImmersion.lift_fac x₀ y hker_le
      exact ⟨u, hu_fac, hPbMono u y (hu_fac.trans (CategoryTheory.Category.id_comp y).symm)⟩

  
  
  
  have hPBC_x0 : WeilCanonicalModPrimePBC ℓ x₀ := weil_pbc_finite_morphism ℓ x₀
  obtain ⟨hc_all, hr_all, hSite⟩ := weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}
  obtain ⟨hExtract, _, _, _, _⟩ := weil_pbc_canonical_calculus_and_extraction.{u} ℓ
  obtain ⟨hIdHDI0, _⟩ := weil_punctual_roof_hdi_id_isZero_and_etale_pullback.{u} 0
  obtain ⟨hExPB, hIsoPB, hCompPB, _, hKerCokerPB, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  let B_x0 := weilEtaleSitePullback x₀
  let pf_x0 := B_x0.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology S_k.smallEtaleTopology
  let pb_x0 := B_x0.sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology S_k.smallEtaleTopology
  let adj_x0 := B_x0.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology S_k.smallEtaleTopology
  obtain ⟨hAdd_pbx0, hLim_pbx0, hColim_pbx0, hcℤ_iso⟩ := hSite.1 x₀
  have _ : pb_x0.Additive := hAdd_pbx0
  let _ : CategoryTheory.Limits.PreservesFiniteLimits pb_x0 := hLim_pbx0
  let _ : CategoryTheory.Limits.PreservesFiniteColimits pb_x0 := hColim_pbx0
  have _ : pf_x0.Additive :=
    ⟨by
      intro _ _ _ _
      apply CategoryTheory.Sheaf.hom_ext
