    fun a => if ha : a ∈ S_aff then
      Classical.choose (Classical.choose_spec (Classical.choose_spec (hAffPoint a ha)))
    else fun _ => ⊥

  refine ⟨w_inf, w_aff, ψ_inf, ψ_aff, Q_inf_star, Q_aff_star,
