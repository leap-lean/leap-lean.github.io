            rw [hg_S0_decomp, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {g₀}))) ≫
