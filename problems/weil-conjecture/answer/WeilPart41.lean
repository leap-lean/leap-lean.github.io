    let h_S0 : AlgebraicGeometry.Spec S_0 ⟶ P1_k.left := q_φS0 ≫ j_Sig0
    have hh_S0_et : AlgebraicGeometry.Etale h_S0 := inferInstance
    have hg_S0_decomp :
        g_S0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {g₀}))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R R_loc)) ≫
