    have hEt_w' : AlgebraicGeometry.Etale w' :=
      CategoryTheory.MorphismProperty.comp_mem P_et O₀.ι W₀.hom inferInstance W₀.prop
    have _ : AlgebraicGeometry.Etale w' := hEt_w'
